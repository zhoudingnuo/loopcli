a.adState) {\n      this.dm.data.adState = {\n        dailyRewarded: 0,\n        dailyInterstitial: 0,\n        lastShowTime: {},\n        lastInterstitialLevel: 0,\n        date: this._todayStr(),\n        consecutiveFails: 0,\n      };\n      this.dm.save();\n                                                                        第2页/共60页\n消消消大作战 V1.0 源代码\n    }\n    this.adState = this.dm.data.adState;\n    this._resetDaily();","numLines":55,"startLine":1,"totalLines":3001}}}
