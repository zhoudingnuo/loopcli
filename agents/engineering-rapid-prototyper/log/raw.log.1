on callback\n    this.sceneExplorer.setActionCallback((hs) => {\n      if (hs.action === 'talk' && hs.dialogueId) {\n        this.dialogueEngine.start(hs.dialogueId);\n      }\n    });\n  }","originalFile":"import { Renderer } from '../Renderer';\nimport { SceneManager } from '../../game/SceneManager';\nimport { DialogueEngine } from '../../game/DialogueEngine';\nimport { GameState } from '../../game/GameState';\nimport { InputManager } from '../../game/InputManager';\nimport { SceneExplorer, Hotspot, ExploreScene } from '../../game/SceneExplorer';\nimport { EvidenceCollector, EvidenceItem } from '../../game/EvidenceCollector';\nimport { InterrogationSystem, InterrogationNPC, InterrogationTopic } from '../../game/InterrogationSystem';\nimport { EvidenceCombiner, CombinationRecipe } from '../../game/EvidenceCombiner';\n\nexport type UIScreen = 'main_menu' | 'game' | 'settings' | 'save_load' | 'dialogue' | 'explore' | 'interrogation' | 'evidence' | 'combine';\n\nexport class UIManager {\n  private currentScreen: UIScreen = 'main_menu';\n  private screenAlpha = 1;\n  private hoverIndex = -1;\n  private sceneExplorer: SceneExplorer;\n  private evidenceCollector: EvidenceCollector;\n  private interrogationSystem: InterrogationSystem;\n  private evidenceCombiner: EvidenceCombiner;\n\n  constructor(\n    private renderer: Renderer,\n    private sceneManager: SceneManager,\n    private dialogueEngine: DialogueEngine,\n    private state: GameState,\n    private input: InputManager\n  ) {\n    this.sceneExplorer = new SceneExplorer(renderer, state, input);\n    this.evidenceCollector = new EvidenceCollector(renderer, state, input);\n    this.interrogationSystem = new InterrogationSystem(renderer, state, dialogueEngine, input);\n    this.evidenceCombiner = new EvidenceCombiner(renderer, state, input, this.evidenceCollector);\n\n    this.setupInput();\n    this.loadDemoDialogue();\n    this.loadDemoM2Data();\n  }\n\n  private loadDemoDialogue() {\n    this.dialogueEngine.loadDialogue([\n      { id: 'intro_1', speaker: '旁白', text: '天宝元年，长安。', next: 'intro_2' },\n      { id: 'intro_2', speaker: '旁白', text: '你是新任万年县推官沈鹤年，今日初到衙门赴任。', next: 'intro_3' },\n      { id: 'intro_3', speaker: '裴如意', text: '你就是新来的推官？看起来很年轻嘛。', portrait: 'pei_ruyi', next: 'intro_4' },\n      {\n        id: 'intro_4', speaker: '沈鹤年', text: '',\n        choices: [\n          { text: '下官沈鹤年，参见县令大人。', next: 'intro_5a' },\n          { text: '年龄不代表能力，大人。', next: 'intro_5b' },\n        ],\n      },\n      { id: 'intro_5a', speaker: '裴如意', text: '嗯，懂规矩。正好，东市出了个案子，你跟我去看看。', portrait: 'pei_ruyi',\n        effects: { relationship: { npc: 'pei_ruyi', delta: 5 } } },\n      { id: 'intro_5b', speaker: '裴如意', text: '哈，有点意思。不过在这里，规矩比能力重要。跟我来吧。', portrait: 'pei_ruyi',\n        effects: { relationship: { npc: 'pei_ruyi', delta: -3 } } },\n    ]);\n  }\n\n  private setupInput() {\n    this.input.onClick((e) => {\n      if (e.type !== 'up') return;\n      this.handleClick(e.x, e.y);\n    });\n  }\n\n  private handleClick(x: number, y: number) {\n    switch (this.currentScreen) {\n      case 'main_menu': this.handleMenuClick(x, y); break;\n      case 'dialogue': this.handleDialogueClick(x, y); break;\n      case 'settings': this.handleSettingsClick(x, y); break;\n      case 'save_load': this.handleSaveLoadClick(x, y); break;\n    }\n  }\n\n  resize(w: number, h: number) {}\n\n  update(dt: number) {\n    this.state.playTime += dt;\n  }\n\n  render() {\n    switch (this.currentScreen) {\n      case 'main_menu': this.renderMainMenu(); break;\n      case 'game': this.renderGameHUD(); break;\n      case 'dialogue': this.renderDialogueUI(); break;\n      case 'settings': this.renderSettings(); break;\n      case 'save_load': this.renderSaveLoad(); break;\n    }\n  }\n\n  // ── Main Menu ──\n\n  private menuItems = [\n    { label: '开始游戏', action: () => this.startGame() },\n    { label: '继续游戏', action: () => this.showScreen('save_load') },\n    { label: '设置', action: () => this.showScreen('settings') },\n  ];\n\n  private renderMainMenu() {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0, '#0d0808');\n    grad.addColorStop(0.5, '#1a0a0a');\n    grad.addColorStop(1, '#0d0808');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n\n    ctx.save();\n    ctx.globalAlpha = 0.05;\n    for (let i = 0; i < 5; i++) {\n      const cx = w * 0.3 + Math.sin(i * 1.7) * w * 0.2;\n      const cy = h * 0.4 + Math.cos(i * 2.3) * h * 0.15;\n      const r = 80 + i * 30;\n      const g2 = ctx.createRadialGradient(cx, cy, 0, cx, cy, r);\n      g2.addColorStop(0, '#8b0000');\n      g2.addColorStop(1, 'transparent');\n      ctx.fillStyle = g2;\n      ctx.fillRect(0, 0, w, h);\n    }\n    ctx.restore();\n\n    this.renderer.drawText('长 安 诡 案 录', w / 2, h * 0.22, {\n      font: 'bold 64px \"SimSun\", \"Noto Serif SC\", serif',\n      color: '#c8a882',\n      align: 'center',\n    });\n    this.renderer.drawText('Records of Chang\\'an Anomalies', w / 2, h * 0.32, {\n      font: '20px \"Georgia\", serif',\n      color: '#8a7a6a',\n      align: 'center',\n    });\n\n    ctx.strokeStyle = '#4a3020';\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    ctx.moveTo(w * 0.3, h * 0.40);\n    ctx.lineTo(w * 0.7, h * 0.40);\n    ctx.stroke();\n\n    this.menuItems.forEach((item, i) => {\n      const y = h * 0.50 + i * 60;\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, w * 0.35, y - 20, w * 0.3, 45);\n      const color = isHover ? '#e8c8a2' : '#a08870';\n\n      if (isHover) {\n        ctx.save();\n        ctx.globalAlpha = 0.15;\n        ctx.fillStyle = '#4a3020';\n        ctx.fillRect(w * 0.35, y - 20, w * 0.3, 45);\n        ctx.restore();\n      }\n\n      this.renderer.drawText(item.label, w / 2, y, {\n        font: '28px \"SimSun\", \"Noto Serif SC\", serif',\n        color,\n        align: 'center',\n      });\n    });\n\n    this.renderer.drawText('v0.1.0 - M1 基础框架', w / 2, h * 0.92, {\n      font: '14px sans-serif', color: '#4a3a2a', align: 'center',\n    });\n  }\n\n  private handleMenuClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    this.menuItems.forEach((item, i) => {\n      const iy = h * 0.50 + i * 60;\n      if (this.isInRect(x, y, w * 0.35, iy - 20, w * 0.3, 45)) {\n        item.action();\n      }\n    });\n  }\n\n  // ── Dialogue UI ──\n\n  private startGame() {\n    this.showScreen('dialogue');\n    this.sceneManager.switchTo('county_office', true);\n    this.dialogueEngine.start('intro_1', () => {\n      this.showScreen('game');\n    });\n  }\n\n  private renderDialogueUI() {\n    this.renderGameHUD();\n    if (!this.dialogueEngine.getIsActive()) return;\n\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    const boxH = 200;\n    const boxY = h - boxH - 20;\n    const boxX = 40;\n    const boxW = w - 80;\n\n    ctx.save();\n    ctx.globalAlpha = 0.92;\n    this.renderer.drawRoundRect(boxX, boxY, boxW, boxH, 8, '#1a140e', '#3a2a1a');\n    ctx.restore();\n\n    ctx.strokeStyle = '#5a4030';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    const m = 6;\n    ctx.roundRect(boxX + m, boxY + m, boxW - m * 2, boxH - m * 2, 4);\n    ctx.stroke();\n\n    const speaker = this.dialogueEngine.getSpeaker();\n    if (speaker) {\n      const spW = ctx.measureText(speaker).width || speaker.length * 28;\n      this.renderer.drawRoundRect(boxX + 20, boxY - 18, spW + 40, 36, 6, '#2a1a0e', '#5a4030');\n      this.renderer.drawText(speaker, boxX + 40, boxY - 10, {\n        font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2',\n      });\n    }\n\n    const text = this.dialogueEngine.getDisplayText();\n    this.renderWrappedText(text, boxX + 30, boxY + 30, boxW - 60, boxH - 60, {\n      font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0',\n    });\n\n    if (!this.dialogueEngine.getIsTyping()) {\n      const choices = this.dialogueEngine.getChoices();\n      if (choices.length > 0) {\n        choices.forEach((c, i) => {\n          const cy = boxY + boxH + 15 + i * 48;\n          const cx = boxX + 30;\n          const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, cx, cy - 5, boxW - 60, 38);\n\n          if (isHover) {\n            ctx.save();\n            ctx.globalAlpha = 0.3;\n            this.renderer.drawRoundRect(cx, cy - 5, boxW - 60, 38, 4, '#3a2a1a');\n            ctx.restore();\n          }\n\n          this.renderer.drawText(`▸ ${c.text}`, cx + 10, cy + 3, {\n            font: '20px \"SimSun\", \"Noto Serif SC\", serif',\n            color: isHover ? '#f0d8b0' : '#b8a890',\n          });\n        });\n      } else {\n        const blinkAlpha = 0.4 + Math.sin(Date.now() * 0.005) * 0.3;\n        this.renderer.drawText('▼', boxX + boxW - 40, boxY + boxH - 40, {\n          font: '18px sans-serif', color: '#8a7a6a', alpha: blinkAlpha,\n        });\n      }\n    }\n  }\n\n  private handleDialogueClick(x: number, y: number) {\n    if (!this.dialogueEngine.getIsActive()) return;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    const boxH = 200;\n    const boxY = h - boxH - 20;\n    const boxX = 40;\n    const boxW = w - 80;\n\n    if (this.dialogueEngine.getIsTyping()) {\n      this.dialogueEngine.advance();\n      return;\n    }\n\n    const choices = this.dialogueEngine.getChoices();\n    if (choices.length > 0) {\n      choices.forEach((c, i) => {\n        const cy = boxY + boxH + 15 + i * 48;\n        if (this.isInRect(x, y, boxX + 30, cy - 5, boxW - 60, 38)) {\n          this.dialogueEngine.selectChoice(i);\n        }\n      });\n    } else {\n      if (this.isInRect(x, y, boxX, boxY, boxW, boxH)) {\n        this.dialogueEngine.advance();\n      }\n    }\n  }\n\n  // ── Settings ──\n\n  private settingsItems = [\n    { label: '文字速度', key: 'textSpeed', min: 10, max: 80 },\n    { label: '主音量', key: 'master', min: 0, max: 100 },\n    { label: '音乐音量', key: 'bgm', min: 0, max: 100 },\n    { label: '音效音量', key: 'sfx', min: 0, max: 100 },\n  ];\n\n  private renderSettings() {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.fillStyle = 'rgba(10, 8, 6, 0.95)';\n    ctx.fillRect(0, 0, w, h);\n\n    this.renderer.drawText('设  置', w / 2, h * 0.12, {\n      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif',\n      color: '#c8a882', align: 'center',\n    });\n\n    this.settingsItems.forEach((item, i) => {\n      const y = h * 0.30 + i * 70;\n      this.renderer.drawText(item.label, w * 0.25, y, {\n        font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870',\n      });\n\n      const barX = w * 0.45;\n      const barW = w * 0.30;\n      const barH = 8;\n      ctx.fillStyle = '#2a1a0e';\n      ctx.fillRect(barX, y + 8, barW, barH);\n\n      const val = item.key === 'textSpeed'\n        ? (this.state.settings.textSpeed - item.min) / (item.max - item.min)\n        : (this.state.settings.volume[item.key as keyof typeof this.state.settings.volume] ?? 0.8);\n      ctx.fillStyle = '#8b4513';\n      ctx.fillRect(barX, y + 8, barW * val, barH);\n\n      const knobX = barX + barW * val;\n      ctx.fillStyle = '#c8a882';\n      ctx.beginPath();\n      ctx.arc(knobX, y + 12, 8, 0, Math.PI * 2);\n      ctx.fill();\n    });\n\n    this.renderBackButton(w, h);\n  }\n\n  private handleSettingsClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    if (this.isInRect(x, y, w * 0.35, h * 0.85, w * 0.3, 45)) {\n      this.showScreen('main_menu');\n    }\n  }\n\n  // ── Save/Load ──\n\n  private renderSaveLoad() {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.fillStyle = 'rgba(10, 8, 6, 0.95)';\n    ctx.fillRect(0, 0, w, h);\n\n    this.renderer.drawText('存  档', w / 2, h * 0.08, {\n      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif',\n      color: '#c8a882', align: 'center',\n    });\n\n    for (let i = 0; i < 6; i++) {\n      const col = i % 3;\n      const row = Math.floor(i / 3);\n      const sx = w * 0.12 + col * (w * 0.28);\n      const sy = h * 0.18 + row * (h * 0.32);\n      const sw = w * 0.25;\n      const sh = h * 0.26;\n\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, sx, sy, sw, sh);\n\n      ctx.save();\n      ctx.globalAlpha = isHover ? 0.9 : 0.7;\n      this.renderer.drawRoundRect(sx, sy, sw, sh, 6, '#1a140e', isHover ? '#6a5040' : '#3a2a1a');\n      ctx.restore();\n\n      this.renderer.drawText(`存档 ${i + 1}`, sx + 15, sy + 15, {\n        font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870',\n      });\n      this.renderer.drawText('空', sx + sw / 2, sy + sh / 2 - 10, {\n        font: '24px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n      });\n    }\n\n    this.renderBackButton(w, h);\n  }\n\n  private handleSaveLoadClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    if (this.isInRect(x, y, w * 0.35, h * 0.85, w * 0.3, 45)) {\n      this.showScreen('main_menu');\n    }\n  }\n\n  // ── Game HUD ──\n\n  private renderGameHUD() {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.save();\n    ctx.globalAlpha = 0.5;\n    ctx.fillStyle = '#c8a882';\n    ctx.font = '14px sans-serif';\n    ctx.fillText(`第${this.state.chapter}章 | ${this.state.scene}`, 15, 20);\n    ctx.restore();\n  }\n\n  // ── Helpers ──\n\n  private renderWrappedText(text: string, x: number, y: number, maxW: number, maxH: number,\n    opts: { font?: string; color?: string }) {\n    const ctx = this.renderer.context;\n    ctx.save();\n    ctx.font = opts.font ?? '20px \"SimSun\", \"Noto Serif SC\", serif';\n    ctx.fillStyle = opts.color ?? '#d8c8b0';\n\n    let lineY = y;\n    let line = '';\n    for (const ch of text) {\n      const test = line + ch;\n      if (ctx.measureText(test).width > maxW) {\n        ctx.fillText(line, x, lineY);\n        line = ch;\n        lineY += 28;\n        if (lineY - y > maxH) break;\n      } else {\n        line = test;\n      }\n    }\n    if (line) ctx.fillText(line, x, lineY);\n    ctx.restore();\n  }\n\n  private renderBackButton(w: number, h: number) {\n    const bx = w * 0.35;\n    const by = h * 0.85;\n    const bw = w * 0.3;\n    const bh = 45;\n    const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, bx, by, bw, bh);\n\n    ctx: this.renderer.drawRoundRect(bx, by, bw, bh, 6,\n      isHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('返回', w / 2, by + 12, {\n      font: '24px \"SimSun\", \"Noto Serif SC\", serif',\n      color: isHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n  }\n\n  private showScreen(screen: UIScreen) { this.currentScreen = screen; }\n\n  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n  }\n}\n","structuredPatch":[{"oldStart":52,"oldLines":9,"newStart":52,"newLines":68,"lines":["         effects: { relationship: { npc: 'pei_ruyi', delta: 5 } } },","       { id: 'intro_5b', speaker: '裴如意', text: '哈，有点意思。不过在这里，规矩比能力重要。跟我来吧。', portrait: 'pei_ruyi',","         effects: { relationship: { npc: 'pei_ruyi', delta: -3 } } },","+      // M2 interrogation dialogue","+      { id: 'interrog_liu_1', speaker: '刘七娘', text: '你问我那天晚上在哪？我...我在坊里待着呢。' },","+      { id: 'interrog_liu_2', speaker: '刘七娘', text: '好吧...我确实去了东市，但什么也没看到！' },","+      { id: 'interrog_liu_3', speaker: '刘七娘', text: '你、你怎么会有这个...好吧，我说实话。那天晚上...' },","+      { id: 'interrog_zhang_1', speaker: '张铁手', text: '哼，推官大人有什么事？' },","+      { id: 'interrog_zhang_2', speaker: '张铁手', text: '这件事...我知道一些，但不一定跟你说。' },","     ]);","   }"," ","+  private loadDemoM2Data() {","+    // Evidence items","+    this.evidenceCollector.registerEvidence([","+      { id: 'broken_jade', name: '碎玉佩', description: '在东市废墟中发现的一块碎玉佩，上面刻有\"裴\"字。', category: 'key', discoveredAt: 'east_market_ruins', discoveredTime: Date.now(), combinable: ['blood_cloth'] },","+      { id: 'blood_cloth', name: '血衣碎片', description: '沾有暗色血迹的布料，质地似官服。', category: 'key', discoveredAt: 'east_market_ruins', discoveredTime: Date.now(), combinable: ['broken_jade'] },","+      { id: 'night_watch_log', name: '巡夜记录', description: '当夜的巡夜记录，记载了可疑人影的出没时间。', category: 'normal', discoveredAt: 'county_office', discoveredTime: Date.now() },","+      { id: 'fake_seal', name: '伪造印信', description: '一枚做工粗糙的伪造官印。', category: 'misleading', discoveredAt: 'west_market', discoveredTime: Date.now() },","+    ]);","+","+    // Scene explorer hotspots","+    this.sceneExplorer.registerScene({","+      sceneId: 'east_market_ruins',","+      hotspots: [","+        { id: 'hs_jade', x: 200, y: 150, w: 80, h: 60, label: '碎玉佩', examined: false, action: 'pickup', giveEvidence: 'broken_jade' },","+        { id: 'hs_cloth', x: 500, y: 300, w: 100, h: 70, label: '血衣碎片', examined: false, action: 'pickup', giveEvidence: 'blood_cloth' },","+        { id: 'hs_door', x: 800, y: 200, w: 60, h: 120, label: '破旧的门', examined: false, action: 'examine' },","+        { id: 'hs_wall', x: 100, y: 400, w: 200, h: 80, label: '残墙上的字迹', examined: false, action: 'examine' },","+      ],","+    });","+","+    this.sceneExplorer.registerScene({","+      sceneId: 'county_office',","+      hotspots: [","+        { id: 'hs_desk', x: 400, y: 200, w: 150, h: 100, label: '县令书案', examined: false, action: 'examine' },","+        { id: 'hs_log', x: 600, y: 350, w: 80, h: 50, label: '巡夜记录', examined: false, action: 'pickup', giveEvidence: 'night_watch_log' },","+      ],","+    });","+","+    // Interrogation NPCs","+    this.interrogationSystem.registerNPC({ id: 'liu_qiniang', name: '刘七娘', defaultPressure: 20, maxPressure: 100 });","+    this.interrogationSystem.registerNPC({ id: 'zhang_tieshou', name: '张铁手', defaultPressure: 35, maxPressure: 100 });","+","+    this.interrogationSystem.registerTopics([","+      { id: 't_liu_1', npcId: 'liu_qiniang', label: '案发当晚行踪', dialogueId: 'interrog_liu_1', repeatable: false },","+      { id: 't_liu_2', npcId: 'liu_qiniang', label: '东市见闻', dialogueId: 'interrog_liu_2', repeatable: false, pressureRange: { min: 30, max: 100 } },","+      { id: 't_liu_3', npcId: 'liu_qiniang', label: '关于碎玉佩', dialogueId: 'interrog_liu_3', repeatable: false, requiresEvidence: ['broken_jade'] },","+      { id: 't_zhang_1', npcId: 'zhang_tieshou', label: '当晚巡逻情况', dialogueId: 'interrog_zhang_1', repeatable: false },","+      { id: 't_zhang_2', npcId: 'zhang_tieshou', label: '可疑人物', dialogueId: 'interrog_zhang_2', repeatable: false, requiresEvidence: ['night_watch_log'] },","+    ]);","+","+    // Combination recipes","+    this.evidenceCombiner.registerRecipes([","+      { id: 'recipe_1', inputs: ['broken_jade', 'blood_cloth'], output: 'jade_cloth_bundle', outputName: '玉佩与血衣', outputDescription: '碎玉佩与血衣碎片放在一起，血迹的位置恰好对应玉佩上的裂纹——这是案发现场的关键关联。', outputCategory: 'key' },","+    ]);","+","+    // Hotspot action callback","+    this.sceneExplorer.setActionCallback((hs) => {","+      if (hs.action === 'talk' && hs.dialogueId) {","+        this.dialogueEngine.start(hs.dialogueId);","+      }","+    });","+  }","+","   private setupInput() {","     this.input.onClick((e) => {","       if (e.type !== 'up') return;"]}],"userModified":false,"replaceAll":false}}
