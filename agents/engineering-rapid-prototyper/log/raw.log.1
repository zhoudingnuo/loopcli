lse },\n    { \"id\": \"t_qiniang_2\", \"npcId\": \"liu_qiniang\", \"label\": \"康居的醉话\", \"dialogueId\": \"ch1_interrog_qiniang_2\", \"repeatable\": false, \"pressureRange\": { \"min\": 20, \"max\": 100 } },\n    { \"id\": \"t_qiniang_3\", \"npcId\": \"liu_qiniang\", \"label\": \"关于康居的为人\", \"dialogueId\": \"ch1_interrog_qiniang_3\", \"repeatable\": false, \"requiresEvidence\": [\"kangju_boast\"] },\n    { \"id\": \"t_tieshou_1\", \"npcId\": \"zhang_tieshou\", \"label\": \"争吵调查结果\", \"dialogueId\": \"ch1_interrog_tieshou_1\", \"repeatable\": false },\n    { \"id\": \"t_tieshou_2\", \"npcId\": \"zhang_tieshou\", \"label\": \"巡夜目击情报\", \"dialogueId\": \"ch1_interrog_tieshou_2\", \"repeatable\": false },\n    { \"id\": \"t_tieshou_3\", \"npcId\": \"zhang_tieshou\", \"label\": \"脚印分析\", \"dialogueId\": \"ch1_interrog_tieshou_3\", \"repeatable\": false, \"requiresEvidence\": [\"mud_footprints\"] }\n  ],\n  \"recipes\": [\n    { \"id\": \"ch1_recipe_1\", \"inputs\": [\"bronze_talisman\", \"torn_note\"], \"output\": \"talisman_note_bundle\", \"outputName\": \"铜符与碎布关联\", \"outputDescription\": \"碎布笔迹与铜符上的符号有相似之处。阿史那在临死前试图留下关于铜符来源的线索。\", \"outputCategory\": \"key\" },\n    { \"id\": \"ch1_recipe_2\", \"inputs\": [\"broken_rope\", \"mud_footprints\"], \"output\": \"rope_print_bundle\", \"outputName\": \"麻绳与脚印关联\", \"outputDescription\": \"麻绳上的泥土与脚印处泥土完全一致。使用绳子的人就是留下脚印的人。\", \"outputCategory\": \"key\" }\n  ],\n  \"reasoningNodes\": [\n    { \"id\": \"rn_corpse\", \"label\": \"验尸报告\", \"type\": \"evidence\", \"x\": 150, \"y\": 120, \"unlocked\": true, \"description\": \"钝器击打致死，非溺亡，死亡时间约子时\" },\n    { \"id\": \"rn_talisman\", \"label\": \"神秘铜符\", \"type\": \"evidence\", \"x\": 300, \"y\": 80, \"unlocked\": true, \"description\": \"死者手中紧握的非大唐铜符，古老符号\" },\n    { \"id\": \"rn_footprints\", \"label\": \"泥地脚印\", \"type\": \"evidence\", \"x\": 450, \"y\": 120, \"unlocked\": true, \"description\": \"西域皮靴纹路，案发后留下的新鲜脚印\" },\n    { \"id\": \"rn_rope\", \"label\": \"断裂麻绳\", \"type\": \"evidence\", \"x\": 150, \"y\": 250, \"unlocked\": true, \"description\": \"西市商贩用绳，康居店中也有同款\" },\n    { \"id\": \"rn_note\", \"label\": \"胡文碎布\", \"type\": \"document\", \"x\": 300, \"y\": 220, \"unlocked\": true, \"description\": \"粟特文'康居不可信'，阿史那所写\" },\n    { \"id\": \"rn_kangju_boast\", \"label\": \"康居醉话\", \"type\": \"testimony\", \"x\": 500, \"y\": 250, \"unlocked\": true, \"description\": \"柳七娘证词：康居称商路将归他所有\" },\n    { \"id\": \"rn_night_watch\", \"label\": \"巡夜目击\", \"type\": \"testimony\", \"x\": 450, \"y\": 350, \"unlocked\": true, \"description\": \"子时三刻穿商贩衣服的人影\" },\n    { \"id\": \"rn_ghost_rumor\", \"label\": \"鬼市传闻\", \"type\": \"environment\", \"x\": 200, \"y\": 380, \"unlocked\": true, \"description\": \"百姓恐惧鬼市，实际被凶手利用\" },\n    { \"id\": \"rn_kangju_motive\", \"label\": \"康居动机\", \"type\": \"inference\", \"x\": 350, \"y\": 320, \"unlocked\": false, \"description\": \"独占商路 + 分成纠纷 = 谋杀动机\" },\n    { \"id\": \"rn_kangju_method\", \"label\": \"作案手法\", \"type\": \"inference\", \"x\": 250, \"y\": 180, \"unlocked\": false, \"description\": \"利用鬼市传闻伪装，背后钝器杀人\" },\n    { \"id\": \"rn_dark_line\", \"label\": \"铜符之谜\", \"type\": \"supernatural\", \"x\": 550, \"y\": 80, \"unlocked\": false, \"description\": \"铜符上的符号暗示更大的秘密...\" }\n  ],\n  \"reasoningLinks\": [\n    { \"from\": \"rn_corpse\", \"to\": \"rn_rope\", \"label\": \"凶器关联\", \"valid\": true },\n    { \"from\": \"rn_footprints\", \"to\": \"rn_rope\", \"label\": \"同一人\", \"valid\": true },\n    { \"from\": \"rn_note\", \"to\": \"rn_kangju_boast\", \"label\": \"印证\", \"valid\": true },\n    { \"from\": \"rn_kangju_boast\", \"to\": \"rn_kangju_motive\", \"label\": \"动机成立\", \"valid\": true },\n    { \"from\": \"rn_night_watch\", \"to\": \"rn_footprints\", \"label\": \"目击吻合\", \"valid\": true },\n    { \"from\": \"rn_ghost_rumor\", \"to\": \"rn_kangju_method\", \"label\": \"伪装利用\", \"valid\": true },\n    { \"from\": \"rn_talisman\", \"to\": \"rn_dark_line\", \"label\": \"暗线\", \"valid\": true, \"requiresEvidence\": [\"bronze_talisman_secret\"] }\n  ],\n  \"hypotheses\": [\n    { \"id\": \"ch1_hyp_1\", \"text\": \"康居为独占商路杀害了阿史那\", \"requiredLinks\": [\"rn_kangju_motive\", \"rn_kangju_method\"], \"validated\": false },\n    { \"id\": \"ch1_hyp_2\", \"text\": \"康居利用鬼市传闻伪装谋杀\", \"requiredLinks\": [\"rn_ghost_rumor\", \"rn_kangju_method\"], \"validated\": false }\n  ],\n  \"trial\": {\n    \"id\": \"ch1_trial\",\n    \"chapter\": 1,\n    \"caseTitle\": \"鬼市浮尸案 —— 阿史那之死\",\n    \"plaintiffName\": \"万年县衙\",\n    \"defendantName\": \"康居（西域胡商）\",\n    \"judgeName\": \"裴如意\",\n    \"correctVerdict\": \"guilty\",\n    \"witnesses\": [\n      {\n        \"id\": \"w_kangju\",\n        \"name\": \"康居（被告）\",\n        \"testimonyLines\": [\n          { \"id\": \"tl_kangju_1\", \"speaker\": \"康居\", \"text\": \"案发当晚我一直在家中，从未出过门。\", \"isLie\": true, \"contradictEvidence\": \"mud_footprints\" },\n          { \"id\": \"tl_kangju_2\", \"speaker\": \"康居\", \"text\": \"阿史那是我的朋友和生意伙伴，我没有理由害他。\", \"isLie\": true, \"contradictEvidence\": \"kangju_boast\" },\n          { \"id\": \"tl_kangju_3\", \"speaker\": \"康居\", \"text\": \"那截麻绳任何人都可以有，不能证明是我的。\", \"isLie\": false },\n          { \"id\": \"tl_kangju_4\", \"speaker\": \"康居\", \"text\": \"这铜符是阿史那的东西，跟我的案子毫无关系。\", \"isLie\": false },\n          { \"id\": \"tl_kangju_5\", \"speaker\": \"康居\", \"text\": \"东市废墟子时有鬼怪出没，百姓都知道。一定是鬼怪杀了他！\", \"isLie\": true, \"contradictEvidence\": \"corpse_examination\", \"revealFlag\": \"ch1_ghost_lie_exposed\" }\n        ]\n      },\n      {\n        \"id\": \"w_qiniang\",\n        \"name\": \"柳七娘\",\n        \"testimonyLines\": [\n          { \"id\": \"tl_qiniang_1\", \"speaker\": \"柳七娘\", \"text\": \"康居来过我茶楼喝酒，喝醉后说过'阿史那的商路快是他的了'。\", \"isLie\": false },\n          { \"id\": \"tl_qiniang_2\", \"speaker\": \"柳七娘\", \"text\": \"东市废墟确实闹鬼，我听好几个人说见过。\", \"isLie\": false },\n          { \"id\": \"tl_qiniang_3\", \"speaker\": \"柳七娘\", \"text\": \"阿史那出事前几天，我见他心事重重，好像在查什么东西。\", \"isLie\": false },\n          { \"id\": \"tl_qiniang_4\", \"speaker\": \"柳七娘\", \"text\": \"我听说康居和阿史那因为银子的事吵了一架。\", \"isLie\": true, \"contradictEvidence\": \"fight_testimony\" }\n        ]\n      },\n      {\n        \"id\": \"w_tieshou\",\n        \"name\": \"张铁手\",\n        \"testimonyLines\": [\n          { \"id\": \"tl_tieshou_1\", \"speaker\": \"张铁手\", \"text\": \"验尸结果显示死者是被钝器击打后脑致死，并非溺亡。\", \"isLie\": false },\n          { \"id\": \"tl_tieshou_2\", \"speaker\": \"张铁手\", \"text\": \"现场发现西域皮靴脚印，经比对与康居的靴子一致。\", \"isLie\": false },\n          { \"id\": \"tl_tieshou_3\", \"speaker\": \"张铁手\", \"text\": \"巡夜的弟兄没看到任何人影，当晚一切正常。\", \"isLie\": true, \"contradictEvidence\": \"night_watch_sighting\" },\n          { \"id\": \"tl_tieshou_4\", \"speaker\": \"张铁手\", \"text\": \"死者临死前写了胡文碎布，内容指向康居。\", \"isLie\": false }\n        ]\n      }\n    ]\n  },\n  \"ambientConfig\": {\n    \"baseTrack\": \"ch1_investigation\",\n    \"layers\": [\n      { \"id\": \"wind_low\", \"volume\": 0.3, \"loop\": true },\n      { \"id\": \"water_drip\", \"volume\": 0.2, \"loop\": true }\n    ]\n  },\n  \"sfxTriggers\": [\n    { \"id\": \"sfx_examine\", \"trigger\": \"examine\", \"sound\": \"examine\" },\n    { \"id\": \"sfx_pickup\", \"trigger\": \"pickup\", \"sound\": \"pickup\" },\n    { \"id\": \"sfx_talk\", \"trigger\": \"talk\", \"sound\": \"talk\" },\n    { \"id\": \"sfx_objection\", \"trigger\": \"objection\", \"sound\": \"objection\" },\n    { \"id\": \"sfx_correct\", \"trigger\": \"correct\", \"sound\": \"correct\" },\n    { \"id\": \"sfx_wrong\", \"trigger\": \"wrong\", \"sound\": \"wrong\" }\n  ]\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
