uction').inputValue();\n  if (!intro) {\n    console.log('3. Filling description...');\n    await page.locator('#introduction').fill('消消消大作战是一款经典的三消益智小游戏。游戏玩法简单：交换相邻的宝石，将三个或更多相同颜色的宝石连成一线即可消除。消除越多，得分越高！游戏包含多种彩色宝石和钻石形状，画面精美，操作流畅，适合所有年龄段的玩家。通过消除获得高分，挑战自我极限，享受三消带来的无穷乐趣。');\n  }\n\n  // Step 3: Upload icon if needed\n  const hasIcon = await page.evaluate(() => !!document.querySelector('[class*=\"upload\"] img'));\n  if (!hasIcon) {\n    console.log('4. Uploading icon...');\n    const addBtn = page.locator('[class*=\"upload-add\"], [class*=\"upload-picture-add\"]').first();\n    try {\n      const [fc] = await Promise.all([\n        page.waitForEvent('filechooser', { timeout: 5000 }),\n        addBtn.click(),\n      ]);\n      await fc.setFiles('D:/game-projects/douyin-match3/icon-600.png');\n      await page.waitForTimeout(3000);\n      const confirmCropper = await page.$('.semi-dy-open-modal-confirm button:has-text(\"确定\")');\n      if (confirmCropper) { await confirmCropper.click(); await page.waitForTimeout(3000); }\n    } catch (e) {\n      console.log('   Upload failed:', e.message);\n    }\n  }\n\n  // Step 4: Select theme tag\n  console.log('5. Selecting theme tag...');\n  const currentTheme = await page.evaluate(() => {\n    const selects = document.querySelectorAll('.semi-dy-open-select');\n    for (const sel of selects) {\n      const ph = sel.querySelector('.semi-dy-open-select-selection-placeholder');\n      const text = sel.querySelector('.semi-dy-open-select-selection-text');\n      if (ph?.textContent?.includes('题材标签')) return ph.textContent.trim();\n      if (text?.textContent?.includes('解压')) return text.textContent.trim();\n    }\n    return null;\n  });\n  console.log('   Current theme:', currentTheme);\n\n  if (!currentTheme || currentTheme.includes('请选择')) {\n    await page.evaluate(() => {\n      const selects = document.querySelectorAll('.semi-dy-open-select');\n      for (const sel of selects) {\n        const ph = sel.querySelector('.semi-dy-open