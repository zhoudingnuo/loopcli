 boolean) { this.flags[key] = value; }\n  getFlag(key: string): boolean { return this.flags[key] ?? false; }\n\n  addEvidence(id: string) {\n    if (!this.evidence.includes(id)) this.evidence.push(id);\n  }\n  hasEvidence(id: string): boolean { return this.evidence.includes(id); }\n\n  setChoice(key: string, value: string) { this.choices[key] = value; }\n  getChoice(key: string): string | undefined { return this.choices[key]; }\n\n  setRelationship(npc: string, delta: number) {\n    this.relationships[npc] = Math.max(0, Math.min(100, (this.relationships[npc] ?? 50) + delta));\n  }\n\n  toSaveSlot(id: number): SaveSlot {\n    return {\n      id,\n      chapter: this.chapter,\n      scene: this.scene,\n      timestamp: Date.now(),\n      playTime: this.playTime,\n      flags: { ...this.flags },\n      evidence: [...this.evidence],\n      choices: { ...this.choices },\n      relationships: { ...this.relationships },\n    };\n  }\n\n  loadFromSlot(slot: SaveSlot) {\n    this.chapter = slot.chapter;\n    this.scene = slot.scene;\n    this.flags = { ...slot.flags };\n    this.evidence = [...slot.evidence];\n    this.choices = { ...slot.choices };\n    this.relationships = { ...slot.relationships };\n    this.playTime = slot.playTime;\n  }\n}\n","structuredPatch":[{"oldStart":8,"oldLines":6,"newStart":8,"newLines":8,"lines":["   evidence: string[];","   choices: Record<string, string>;","   relationships: Record<string, number>;","+  completedChapters: number[];","+  chapterProgress: Record<number, { phase: string; evidenceFound: string[] }>;"," }"," "," export class GameState {"]}],"userModified":false,"replaceAll":false}}
