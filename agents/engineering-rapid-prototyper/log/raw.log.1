{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_e0320d81c4cf413b902ee92b","type":"tool_result","content":"1\timport { Renderer } from '../renderer/Renderer';\n2\timport { GameState } from './GameState';\n3\timport { InputManager } from './InputManager';\n4\t\n5\texport interface ReasoningNode {\n6\t  id: string;\n7\t  label: string;\n8\t  type: 'evidence' | 'testimony' | 'document' | 'inference' | 'environment' | 'supernatural';\n9\t  x: number;\n10\t  y: number;\n11\t  unlocked: boolean;\n12\t  description: string;\n13\t}\n14\t\n15\texport interface ReasoningLink {\n16\t  from: string;\n17\t  to: string;\n18\t  label: string;\n19\t  valid: boolean;\n20\t  requiresEvidence?: string[];\n21\t}\n22\t\n23\texport interface ReasoningHypothesis {\n24\t  id: string;\n25\t  text: string;\n26\t  requiredLinks: string[];\n27\t  validated: boolean;\n28\t}\n29\t\n30\tinterface DragState {\n31\t  nodeId: string;\n32\t  offsetX: number;\n33\t  offsetY: number;\n34\t}\n35\t\n36\tinterface LinkDraft {\n37\t  fromId: string;\n38\t  mouseX: number;\n39\t  mouseY: number;\n40\t}\n41\t\n42\texport class ReasoningBoard {\n43\t  private nodes: Map<string, ReasoningNode> = new Map();\n44\t  private links: ReasoningLink[] = [];\n45\t  private hypotheses: ReasoningHypothesis[] = [];\n46\t  private isOpen = false;\n47\t  private animAlpha = 0;\n48\t\n49\t  private dragNode: DragState | null = null;\n50\t  private linkDraft: LinkDraft | null = null;\n51\t  private selectedNodeId: string | null = null;\n52\t  private selectedHypothesis: number = -1;\n53\t\n54\t  private scrollX = 0;\n55\t  private scrollY = 0;\n56\t  private isPanning = false;\n57\t  private panStartX = 0;\n58\t  private panStartY = 0;\n59\t  private panScrollStartX = 0;\n60\t  private panScrollStartY = 0;\n61\t\n62\t  private nodeRadius = 30;\n63\t  private flashLink = -1;\n64\t  private flashTimer = 0;\n65\t  private completeness = 0;\n66\t\n67\t  private onHypothesisValidated?: (h: ReasoningHypothesis) => void;\n68\t\n69\t  constructor(\n70\t    private renderer: Renderer,\n71\t    private state: GameState,\n72\t    private input: InputManager\n73\t  ) {\n74\t    this.setupInput();\n75\t  }\n76\t\n77\t  registerNode(node: ReasoningNode) {\n78\t    this.nodes.set(node.id, node);\n79\t  }\n80\t\n81\t  registerNodes(nodes: ReasoningNode[]) {\n82\t    nodes.forEach((n) => this.registerNode(n));\n83\t  }\n84\t\n85\t  registerLink(link: ReasoningLink) {\n86\t    this.links.push(link);\n87\t  }\n88\t\n89\t  registerLinks(links: ReasoningLink[]) {\n90\t    links.forEach((l) => this.registerLink(l));\n91\t  }\n92\t\n93\t  registerHypothesis(h: ReasoningHypothesis) {\n94\t    this.hypotheses.push(h);\n95\t  }\n96\t\n97\t  setHypothesisCallback(cb: (h: ReasoningHypothesis) => void) {\n98\t    this.onHypothesisValidated = cb;\n99\t  }\n100\t\n101\t  unlockNode(nodeId: string) {\n102\t    const node = this.nodes.get(nodeId);\n103\t    if (node) node.unlocked = true;\n104\t  }\n105\t\n106\t  connectNodes(fromId: string, toId: string): boolean {\n107\t    const from = this.nodes.get(fromId);\n108\t    const to = this.nodes.get(toId);\n109\t    if (!from || !to || !from.unlocked || !to.unlocked) return false;\n110\t\n111\t    const existing = this.links.find(\n112\t      (l) => (l.from === fromId && l.to === toId) || (l.from === toId && l.to === fromId)\n113\t    );\n114\t    if (existing) return false;\n115\t\n116\t    const template = this.links.find(\n117\t      (l) =>\n118\t        !this.isLinkConnected(l) &&\n119\t        ((l.from === fromId && l.to === toId) || (l.from === toId && l.to === fromId))\n120\t    );\n121\t\n122\t    const valid = template ? template.valid : false;\n123\t    const label = template?.label ?? '';\n124\t\n125\t    const newLink: ReasoningLink = { from: fromId, to: toId, label, valid };\n126\t    if (!template) {\n127\t      if (this.hasContradiction(fromId, toId)) {\n128\t        newLink.label = '矛盾';\n129\t        newLink.valid = false;\n130\t      }\n131\t    }\n132\t\n133\t    this.links.push(newLink);\n134\t    this.flashLink = this.links.length - 1;\n135\t    this.flashTimer = 2;\n136\t\n137\t    this.recalcCompleteness();\n138\t    this.checkHypotheses();\n139\t\n140\t    return true;\n141\t  }\n142\t\n143\t  open() {\n144\t    this.isOpen = true;\n145\t    this.animAlpha = 0;\n146\t    this.selectedNodeId = null;\n147\t    this.linkDraft = null;\n148\t  }\n149\t\n150\t  close() {\n151\t    this.isOpen = false;\n152\t    this.selectedNodeId = null;\n153\t    this.linkDraft = null;\n154\t    this.dragNode = null;\n155\t  }\n156\t\n157\t  toggle() {\n158\t    if (this.isOpen) this.close();\n159\t    else this.open();\n160\t  }\n161\t\n162\t  getIsOpen(): boolean { return this.isOpen; }\n163\t\n164\t  getCompleteness(): number { return this.completeness; }\n165\t\n166\t  getValidLinks(): ReasoningLink[] {\n167\t    return this.links.filter((l) => l.valid);\n168\t  }\n169\t\n170\t  private isLinkConnected(l: ReasoningLink): boolean {\n171\t    return this.links.some(\n172\t      (existing) =>\n173\t        existing !== l &&\n174\t        ((existing.from === l.from && existing.to === l.to) ||\n175\t          (existing.from === l.to && existing.to === l.from))\n176\t    );\n177\t  }\n178\t\n179\t  private hasContradiction(id1: string, id2: string): boolean {\n180\t    const node1 = this.nodes.get(id1);\n181\t    const node2 = this.nodes.get(id2);\n182\t    if (!node1 || !node2) return false;\n183\t\n184\t    if (node1.type === 'testimony' && node2.type === 'testimony') return true;\n185\t    if (\n186\t      (node1.type === 'evidence' && node2.type === 'supernatural') ||\n187\t      (node1.type === 'supernatural' && node2.type === 'evidence')\n188\t    )\n189\t      return true;\n190\t    return false;\n191\t  }\n192\t\n193\t  private recalcCompleteness() {\n194\t    const totalPossible = this.links.filter((l) => l.valid).length;\n195\t    if (totalPossible === 0) { this.completeness = 0; return; }\n196\t    const connected = this.links.filter((l) => l.valid).length;\n197\t    this.completeness = Math.min(100, Math.round((connected / Math.max(totalPossible, connected)) * 100));\n198\t  }\n199\t\n200\t  private checkHypotheses() {\n201\t    for (const h of this.hypotheses) {\n202\t      if (h.validated) continue;\n203\t      const allMet = h.requiredLinks.every((req) =>\n204\t        this.links.some((l) => l.from === req && l.valid) ||\n205\t        this.links.some((l) => l.to === req && l.valid)\n206\t      );\n207\t      if (allMet) {\n208\t        h.validated = true;\n209\t        this.onHypothesisValidated?.(h);\n210\t      }\n211\t    }\n212\t  }\n213\t\n214\t  private setupInput() {\n215\t    this.input.onClick((e) => {\n216\t      if (e.type !== 'up') return;\n217\t      if (!this.isOpen) return;\n218\t\n219\t      if (this.linkDraft) {\n220\t        this.handleLinkDrop(e.x, e.y);\n221\t        return;\n222\t      }\n223\t\n224\t      if (this.dragNode) {\n225\t        this.dragNode = null;\n226\t        return;\n227\t      }\n228\t\n229\t      this.handleClick(e.x, e.y);\n230\t    });\n231\t\n232\t    this.input.onClick((e) => {\n233\t      if (!this.isOpen) return;\n234\t      if (e.type === 'down') {\n235\t        this.handleMouseDown(e.x, e.y);\n236\t      } else if (e.type === 'move') {\n237\t        this.handleMouseMove(e.x, e.y);\n238\t      }\n239\t    });\n240\t  }\n241\t\n242\t  private handleMouseDown(x: number, y: number) {\n243\t    for (const [, node] of this.nodes) {\n244\t      if (!node.unlocked) continue;\n245\t      const nx = node.x + this.scrollX;\n246\t      const ny = node.y + this.scrollY;\n247\t      const dist = Math.sqrt((x - nx) ** 2 + (y - ny) ** 2);\n248\t      if (dist <= this.nodeRadius) {\n249\t        this.dragNode = { nodeId: node.id, offsetX: x - nx, offsetY: y - ny };\n250\t        return;\n251\t      }\n252\t    }\n253\t\n254\t    const w = this.renderer.w;\n255\t    const panelX = w * 0.72;\n256\t    if (x > panelX) return;\n257\t    this.isPanning = true;\n258\t    this.panStartX = x;\n259\t    this.panStartY = y;\n260\t    this.panScrollStartX = this.scrollX;\n261\t    this.panScrollStartY = this.scrollY;\n262\t  }\n263\t\n264\t  private handleMouseMove(x: number, y: number) {\n265\t    if (this.dragNode) {\n266\t      const node = this.nodes.get(this.dragNode.nodeId);\n267\t      if (node) {\n268\t        node.x = x - this.dragNode.offsetX - this.scrollX;\n269\t        node.y = y - this.dragNode.offsetY - this.scrollY;\n270\t      }\n271\t      return;\n272\t    }\n273\t\n274\t    if (this.isPanning) {\n275\t      this.scrollX = this.panScrollStartX + (x - this.panStartX);\n276\t      this.scrollY = this.panScrollStartY + (y - this.panStartY);\n277\t    }\n278\t\n279\t    if (this.linkDraft) {\n280\t      this.linkDraft.mouseX = x;\n281\t      this.linkDraft.mouseY = y;\n282\t    }\n283\t  }\n284\t\n285\t  private handleClick(x: number, y: number) {\n286\t    const w = this.renderer.w;\n287\t    const h = this.renderer.h;\n288\t\n289\t    const closeBtnX = w * 0.72 + 30;\n290\t    const closeBtnY = 20;\n291\t    if (this.isInRect(x, y, closeBtnX, closeBtnY, 80, 36)) {\n292\t      this.close();\n293\t      return;\n294\t    }\n295\t\n296\t    for (const [id, node] of this.nodes) {\n297\t      if (!node.unlocked) continue;\n298\t      const nx = node.x + this.scrollX;\n299\t      const ny = node.y + this.scrollY;\n300\t      const dist = Math.sqrt((x - nx) ** 2 + (y - ny) ** 2);\n301\t      if (dist <= this.nodeRadius) {\n302\t        if (this.selectedNodeId === id) {\n303\t          this.linkDraft = { fromId: id, mouseX: x, mouseY: y };\n304\t        } else {\n305\t          this.selectedNodeId = id;\n306\t        }\n307\t        return;\n308\t      }\n309\t    }\n310\t\n311\t    this.selectedNodeId = null;\n312\t\n313\t    const hypY = h * 0.6;\n314\t    for (let i = 0; i < this.hypotheses.length; i++) {\n315\t      const hy = hypY + i * 40;\n316\t      if (this.isInRect(x, y, w * 0.74, hy, w * 0.22, 34)) {\n317\t        this.selectedHypothesis = i;\n318\t        return;\n319\t      }\n320\t    }\n321\t  }\n322\t\n323\t  private handleLinkDrop(x: number, y: number) {\n324\t    if (!this.linkDraft) return;\n325\t\n326\t    for (const [id, node] of this.nodes) {\n327\t      if (!node.unlocked || id === this.linkDraft.fromId) continue;\n328\t      const nx = node.x + this.scrollX;\n329\t      const ny = node.y + this.scrollY;\n330\t      const dist = Math.sqrt((x - nx) ** 2 + (y - ny) ** 2);\n331\t      if (dist <= this.nodeRadius) {\n332\t        this.connectNodes(this.linkDraft.fromId, id);\n333\t        break;\n334\t      }\n335\t    }\n336\t\n337\t    this.linkDraft = null;\n338\t  }\n339\t\n340\t  update(dt: number) {\n341\t    if (!this.isOpen) return;\n342\t    this.animAlpha = Math.min(1, this.animAlpha + dt * 5);\n343\t    if (this.flashTimer > 0) this.flashTimer -= dt;\n344\t    if (this.flashTimer <= 0) this.flashLink = -1;\n345\t  }\n346\t\n347\t  render() {\n348\t    if (!this.isOpen) return;\n349\t    const ctx = this.renderer.context;\n350\t    const w = this.renderer.w;\n351\t    const h = this.renderer.h;\n352\t\n353\t    ctx.save();\n354\t    ctx.globalAlpha = this.animAlpha * 0.5;\n355\t    ctx.fillStyle = '#0a0806';\n356\t    ctx.fillRect(0, 0, w, h);\n357\t    ctx.restore();\n358\t\n359\t    ctx.save();\n360\t    ctx.globalAlpha = this.animAlpha;\n361\t\n362\t    const boardW = w * 0.72;\n363\t    const boardH = h;\n364\t\n365\t    ctx.fillStyle = '#0e0c0a';\n366\t    ctx.fillRect(0, 0, boardW, boardH);\n367\t\n368\t    this.renderGrid(ctx, boardW, h);\n369\t\n370\t    for (const link of this.links) {\n371\t      this.renderLink(ctx, link);\n372\t    }\n373\t\n374\t    if (this.linkDraft) {\n375\t      const fromNode = this.nodes.get(this.linkDraft.fromId);\n376\t      if (fromNode) {\n377\t        ctx.save();\n378\t        ctx.strokeStyle = '#c8a040';\n379\t        ctx.lineWidth = 2;\n380\t        ctx.setLineDash([6, 4]);\n381\t        ctx.beginPath();\n382\t        ctx.moveTo(fromNode.x + this.scrollX, fromNode.y + this.scrollY);\n383\t        ctx.lineTo(this.linkDraft.mouseX, this.linkDraft.mouseY);\n384\t        ctx.stroke();\n385\t        ctx.restore();\n386\t      }\n387\t    }\n388\t\n389\t    for (const [, node] of this.nodes) {\n390\t      if (!node.unlocked) continue;\n391\t      this.renderNode(ctx, node);\n392\t    }\n393\t\n394\t    this.renderSidebar(ctx, w, h);\n395\t\n396\t    ctx.restore();\n397\t  }\n398\t\n399\t  private renderGrid(ctx: CanvasRenderingContext2D, bw: number, bh: number) {\n400\t    ctx.save();\n401\t    ctx.strokeStyle = '#1a1610';\n402\t    ctx.lineWidth = 0.5;\n403\t    const step = 60;\n404\t    for (let x = (this.scrollX % step); x < bw; x += step) {\n405\t      ctx.beginPath();\n406\t      ctx.moveTo(x, 0);\n407\t      ctx.lineTo(x, bh);\n408\t      ctx.stroke();\n409\t    }\n410\t    for (let y = (this.scrollY % step); y < bh; y += step) {\n411\t      ctx.beginPath();\n412\t      ctx.moveTo(0, y);\n413\t      ctx.lineTo(bw, y);\n414\t      ctx.stroke();\n415\t    }\n416\t    ctx.restore();\n417\t  }\n418\t\n419\t  private renderNode(ctx: CanvasRenderingContext2D, node: ReasoningNode) {\n420\t    const nx = node.x + this.scrollX;\n421\t    const ny = node.y + this.scrollY;\n422\t    const r = this.nodeRadius;\n423\t\n424\t    const isSelected = this.selectedNodeId === node.id;\n425\t    const isHover =\n426\t      Math.sqrt((this.input.mouseX - nx) ** 2 + (this.input.mouseY - ny) ** 2) <= r;\n427\t\n428\t    const typeColors: Record<string, string> = {\n429\t      evidence: '#c8a040',\n430\t      testimony: '#6a8ac8',\n431\t      document: '#8a6ac8',\n432\t      inference: '#c8c840',\n433\t      environment: '#6ac888',\n434\t      supernatural: '#8a4a8a',\n435\t    };\n436\t    const typeLabels: Record<string, string> = {\n437\t      evidence: '物证',\n438\t      testimony: '证词',\n439\t      document: '文献',\n440\t      inference: '推断',\n441\t      environment: '观察',\n442\t      supernatural: '异象',\n443\t    };\n444\t\n445\t    const color = typeColors[node.type] ?? '#a0a0a0';\n446\t\n447\t    if (isSelected || isHover) {\n448\t      ctx.save();\n449\t      ctx.globalAlpha = 0.15;\n450\t      const glow = ctx.createRadialGradient(nx, ny, 0, nx, ny, r * 2.5);\n451\t      glow.addColorStop(0, color);\n452\t      glow.addColorStop(1, 'transparent');\n453\t      ctx.fillStyle = glow;\n454\t      ctx.beginPath();\n455\t      ctx.arc(nx, ny, r * 2.5, 0, Math.PI * 2);\n456\t      ctx.fill();\n457\t      ctx.restore();\n458\t    }\n459\t\n460\t    ctx.beginPath();\n461\t    ctx.arc(nx, ny, r, 0, Math.PI * 2);\n462\t    ctx.fillStyle = isSelected ? '#1e1810' : '#0e0c08';\n463\t    ctx.fill();\n464\t    ctx.strokeStyle = isSelected ? color : isHover ? color : '#4a3a2a';\n465\t    ctx.lineWidth = isSelected ? 3 : 2;\n466\t    ctx.stroke();\n467\t\n468\t    this.renderer.drawText(typeLabels[node.type] ?? '', nx, ny - 4, {\n469\t      font: '12px sans-serif', color, align: 'center',\n470\t    });\n471\t\n472\t    this.renderer.drawText(node.label, nx, ny + r + 6, {\n473\t      font: '14px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n474\t    });\n475\t\n476\t    if (isSelected) {\n477\t      const tipW = 200;\n478\t      const tipH = 50;\n479\t      const tipX = nx + r + 10;\n480\t      const tipY = ny - tipH / 2;\n481\t\n482\t      this.renderer.drawRoundRect(tipX, tipY, tipW, tipH, 4, '#1a140e', '#5a4030');\n483\t      this.renderWrappedText(node.description, tipX + 8, tipY + 8, tipW - 16, 36, {\n484\t        font: '13px \"SimSun\", \"Noto Serif SC\", serif', color: '#a09080',\n485\t      });\n486\t    }\n487\t  }\n488\t\n489\t  private renderLink(ctx: CanvasRenderingContext2D, link: ReasoningLink) {\n490\t    const from = this.nodes.get(link.from);\n491\t    const to = this.nodes.get(link.to);\n492\t    if (!from || !to) return;\n493\t\n494\t    const fx = from.x + this.scrollX;\n495\t    const fy = from.y + this.scrollY;\n496\t    const tx = to.x + this.scrollX;\n497\t    const ty = to.y + this.scrollY;\n498\t\n499\t    const isFlash = this.links.indexOf(link) === this.flashLink && this.flashTimer > 0;\n500\t\n501\t    ctx.save();\n502\t    ctx.strokeStyle = link.valid\n503\t      ? (isFlash ? '#f0d8a0' : '#6a8a4a')\n504\t      : (isFlash ? '#f0a0a0' : '#8a4a4a');\n505\t    ctx.lineWidth = isFlash ? 3 : 2;\n506\t    if (!link.valid) ctx.setLineDash([5, 3]);\n507\t\n508\t    const mx = (fx + tx) / 2;\n509\t    const my = (fy + ty) / 2 - 20;\n510\t\n511\t    ctx.beginPath();\n512\t    ctx.moveTo(fx, fy);\n513\t    ctx.quadraticCurveTo(mx, my, tx, ty);\n514\t    ctx.stroke();\n515\t\n516\t    if (link.label) {\n517\t      this.renderer.drawText(link.label, mx, my - 8, {\n518\t        font: '13px \"SimSun\", \"Noto Serif SC\", serif',\n519\t        color: link.valid ? '#8ac86a' : '#c86a6a',\n520\t        align: 'center',\n521\t      });\n522\t    }\n523\t    ctx.restore();\n524\t  }\n525\t\n526\t  private renderSidebar(ctx: CanvasRenderingContext2D, w: number, h: number) {\n527\t    const sideX = w * 0.72;\n528\t    const sideW = w - sideX;\n529\t\n530\t    ctx.fillStyle = '#0e0a08';\n531\t    ctx.fillRect(sideX, 0, sideW, h);\n532\t    ctx.strokeStyle = '#3a2a1a';\n533\t    ctx.lineWidth = 1;\n534\t    ctx.beginPath();\n535\t    ctx.moveTo(sideX, 0);\n536\t    ctx.lineTo(sideX, h);\n537\t    ctx.stroke();\n538\t\n539\t    this.renderer.drawText('推 理 板', sideX + sideW / 2, 18, {\n540\t      font: 'bold 22px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n541\t    });\n542\t\n543\t    const unlockedCount = [...this.nodes.values()].filter((n) => n.unlocked).length;\n544\t    this.renderer.drawText(`线索: ${unlockedCount} | 完整度: ${this.completeness}%`, sideX + 10, 50, {\n545\t      font: '14px sans-serif', color: '#8a7a6a',\n546\t    });\n547\t\n548\t    const barX = sideX + 10;\n549\t    const barW = sideW - 20;\n550\t    ctx.fillStyle = '#1a140e';\n551\t    ctx.fillRect(barX, 72, barW, 8);\n552\t    ctx.fillStyle = '#6a8a4a';\n553\t    ctx.fillRect(barX, 72, barW * (this.completeness / 100), 8);\n554\t\n555\t    this.renderer.drawText('提示: 点击节点选中，再点击同一节点开始连线', sideX + 10, 92, {\n556\t      font: '12px sans-serif', color: '#4a3a2a',\n557\t    });\n558\t\n559\t    this.renderer.drawText('假设结论', sideX + sideW / 2, h * 0.55, {\n560\t      font: 'bold 18px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n561\t    });\n562\t\n563\t    const hypY = h * 0.6;\n564\t    this.hypotheses.forEach((hyp, i) => {\n565\t      const hy = hypY + i * 40;\n566\t      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, sideX + 10, hy, sideW - 20, 34);\n567\t\n568\t      this.renderer.drawRoundRect(sideX + 10, hy, sideW - 20, 34, 4,\n569\t        hyp.validated ? '#1a2a10' : isHover ? '#1a140e' : '#0e0a08',\n570\t        hyp.validated ? '#4a8a4a' : '#3a2a1a'\n571\t      );\n572\t\n573\t      this.renderer.drawText(\n574\t        `${hyp.validated ? '✓' : '○'} ${hyp.text}`,\n575\t        sideX + 20, hy + 8,\n576\t        {\n577\t          font: '15px \"SimSun\", \"Noto Serif SC\", serif',\n578\t          color: hyp.validated ? '#8ac86a' : '#a09080',\n579\t        }\n580\t      );\n581\t    });\n582\t\n583\t    if (this.hypotheses.length === 0) {\n584\t      this.renderer.drawText('尚无假设', sideX + sideW / 2, hypY + 20, {\n585\t        font: '15px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n586\t      });\n587\t    }\n588\t\n589\t    const closeBtnX = sideX + 30;\n590\t    const closeBtnY = 20;\n591\t    const closeHover = this.isInRect(this.input.mouseX, this.input.mouseY, closeBtnX, closeBtnY, 80, 36);\n592\t    this.renderer.drawRoundRect(closeBtnX, closeBtnY, 80, 36, 4,\n593\t      closeHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n594\t    this.renderer.drawText('关闭', closeBtnX + 40, closeBtnY + 8, {\n595\t      font: '16px \"SimSun\", \"Noto Serif SC\", serif',\n596\t      color: closeHover ? '#e8c8a2' : '#a08870', align: 'center',\n597\t    });\n598\t  }\n599\t\n600\t  private renderWrappedText(text: string, x: number, y: number, maxW: number, maxH: number,\n601\t    opts: { font?: string; color?: string }) {\n602\t    const ctx = this.renderer.context;\n603\t    ctx.save();\n604\t    ctx.font = opts.font ?? '14px \"SimSun\", \"Noto Serif SC\", serif';\n605\t    ctx.fillStyle = opts.color ?? '#d8c8b0';\n606\t\n607\t    let lineY = y;\n608\t    let line = '';\n609\t    for (const ch of text) {\n610\t      const test = line + ch;\n611\t      if (ctx.measureText(test).width > maxW) {\n612\t        ctx.fillText(line, x, lineY);\n613\t        line = ch;\n614\t        lineY += 18;\n615\t        if (lineY - y > maxH) break;\n616\t      } else {\n617\t        line = test;\n618\t      }\n619\t    }\n620\t    if (line) ctx.fillText(line, x, lineY);\n621\t    ctx.restore();\n622\t  }\n623\t\n624\t  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n625\t    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n626\t  }\n627\t}\n628\t"}]},"parent_tool_use_id":null,"session_id":"60e8bd2a-b118-4ebb-8072-7fe7ed523870","uuid":"1523fa5b-eed5-4a58-badf-58c56e89a24b","timestamp":"2026-05-23T17:49:36.508Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-ancient-mystery\\src\\game\\ReasoningBoard.ts","content":"import { Renderer } from '../renderer/Renderer';\nimport { GameState } from './GameState';\nimport { InputManager } from './InputManager';\n\nexport interface ReasoningNode {\n  id: string;\n  label: string;\n  type: 'evidence' | 'testimony' | 'document' | 'inference' | 'environment' | 'supernatural';\n  x: number;\n  y: number;\n  unlocked: boolean;\n  description: string;\n}\n\nexport interface ReasoningLink {\n  from: string;\n  to: string;\n  label: string;\n  valid: boolean;\n  requiresEvidence?: string[];\n}\n\nexport interface ReasoningHypothesis {\n  id: string;\n  text: string;\n  requiredLinks: string[];\n  validated: boolean;\n}\n\ninterface DragState {\n  nodeId: string;\n  offsetX: number;\n  offsetY: number;\n}\n\ninterface LinkDraft {\n  fromId: string;\n  mouseX: number;\n  mouseY: number;\n}\n\nexport class ReasoningBoard {\n  private nodes: Map<string, ReasoningNode> = new Map();\n  private links: ReasoningLink[] = [];\n  private hypotheses: ReasoningHypothesis[] = [];\n  private isOpen = false;\n  private animAlpha = 0;\n\n  private dragNode: DragState | null = null;\n  private linkDraft: LinkDraft | null = null;\n  private selectedNodeId: string | null = null;\n  private selectedHypothesis: number = -1;\n\n  private scrollX = 0;\n  private scrollY = 0;\n  private isPanning = false;\n  private panStartX = 0;\n  private panStartY = 0;\n  private panScrollStartX = 0;\n  private panScrollStartY = 0;\n\n  private nodeRadius = 30;\n  private flashLink = -1;\n  private flashTimer = 0;\n  private completeness = 0;\n\n  private onHypothesisValidated?: (h: ReasoningHypothesis) => void;\n\n  constructor(\n    private renderer: Renderer,\n    private state: GameState,\n    private input: InputManager\n  ) {\n    this.setupInput();\n  }\n\n  registerNode(node: ReasoningNode) {\n    this.nodes.set(node.id, node);\n  }\n\n  registerNodes(nodes: ReasoningNode[]) {\n    nodes.forEach((n) => this.registerNode(n));\n  }\n\n  registerLink(link: ReasoningLink) {\n    this.links.push(link);\n  }\n\n  registerLinks(links: ReasoningLink[]) {\n    links.forEach((l) => this.registerLink(l));\n  }\n\n  registerHypothesis(h: ReasoningHypothesis) {\n    this.hypotheses.push(h);\n  }\n\n  setHypothesisCallback(cb: (h: ReasoningHypothesis) => void) {\n    this.onHypothesisValidated = cb;\n  }\n\n  unlockNode(nodeId: string) {\n    const node = this.nodes.get(nodeId);\n    if (node) node.unlocked = true;\n  }\n\n  connectNodes(fromId: string, toId: string): boolean {\n    const from = this.nodes.get(fromId);\n    const to = this.nodes.get(toId);\n    if (!from || !to || !from.unlocked || !to.unlocked) return false;\n\n    const existing = this.links.find(\n      (l) => (l.from === fromId && l.to === toId) || (l.from === toId && l.to === fromId)\n    );\n    if (existing) return false;\n\n    const template = this.links.find(\n      (l) =>\n        !this.isLinkConnected(l) &&\n        ((l.from === fromId && l.to === toId) || (l.from === toId && l.to === fromId))\n    );\n\n    const valid = template ? template.valid : false;\n    const label = template?.label ?? '';\n\n    const newLink: ReasoningLink = { from: fromId, to: toId, label, valid };\n    if (!template) {\n      if (this.hasContradiction(fromId, toId)) {\n        newLink.label = '矛盾';\n        newLink.valid = false;\n      }\n    }\n\n    this.links.push(newLink);\n    this.flashLink = this.links.length - 1;\n    this.flashTimer = 2;\n\n    this.recalcCompleteness();\n    this.checkHypotheses();\n\n    return true;\n  }\n\n  open() {\n    this.isOpen = true;\n    this.animAlpha = 0;\n    this.selectedNodeId = null;\n    this.linkDraft = null;\n  }\n\n  close() {\n    this.isOpen = false;\n    this.selectedNodeId = null;\n    this.linkDraft = null;\n    this.dragNode = null;\n  }\n\n  toggle() {\n    if (this.isOpen) this.close();\n    else this.open();\n  }\n\n  getIsOpen(): boolean { return this.isOpen; }\n\n  getCompleteness(): number { return this.completeness; }\n\n  getValidLinks(): ReasoningLink[] {\n    return this.links.filter((l) => l.valid);\n  }\n\n  private isLinkConnected(l: ReasoningLink): boolean {\n    return this.links.some(\n      (existing) =>\n        existing !== l &&\n        ((existing.from === l.from && existing.to === l.to) ||\n          (existing.from === l.to && existing.to === l.from))\n    );\n  }\n\n  private hasContradiction(id1: string, id2: string): boolean {\n    const node1 = this.nodes.get(id1);\n    const node2 = this.nodes.get(id2);\n    if (!node1 || !node2) return false;\n\n    if (node1.type === 'testimony' && node2.type === 'testimony') return true;\n    if (\n      (node1.type === 'evidence' && node2.type === 'supernatural') ||\n      (node1.type === 'supernatural' && node2.type === 'evidence')\n    )\n      return true;\n    return false;\n  }\n\n  private recalcCompleteness() {\n    const totalPossible = this.links.filter((l) => l.valid).length;\n    if (totalPossible === 0) { this.completeness = 0; return; }\n    const connected = this.links.filter((l) => l.valid).length;\n    this.completeness = Math.min(100, Math.round((connected / Math.max(totalPossible, connected)) * 100));\n  }\n\n  private checkHypotheses() {\n    for (const h of this.hypotheses) {\n      if (h.validated) continue;\n      const allMet = h.requiredLinks.every((req) =>\n        this.links.some((l) => l.from === req && l.valid) ||\n        this.links.some((l) => l.to === req && l.valid)\n      );\n      if (allMet) {\n        h.validated = true;\n        this.onHypothesisValidated?.(h);\n      }\n    }\n  }\n\n  private setupInput() {\n    this.input.onClick((e) => {\n      if (e.type !== 'up') return;\n      if (!this.isOpen) return;\n\n      if (this.linkDraft) {\n        this.handleLinkDrop(e.x, e.y);\n        return;\n      }\n\n      if (this.dragNode) {\n        this.dragNode = null;\n        return;\n      }\n\n      this.handleClick(e.x, e.y);\n    });\n\n    this.input.onClick((e) => {\n      if (!this.isOpen) return;\n      if (e.type === 'down') {\n        this.handleMouseDown(e.x, e.y);\n      } else if (e.type === 'move') {\n        this.handleMouseMove(e.x, e.y);\n      }\n    });\n  }\n\n  private handleMouseDown(x: number, y: number) {\n    for (const [, node] of this.nodes) {\n      if (!node.unlocked) continue;\n      const nx = node.x + this.scrollX;\n      const ny = node.y + this.scrollY;\n      const dist = Math.sqrt((x - nx) ** 2 + (y - ny) ** 2);\n      if (dist <= this.nodeRadius) {\n        this.dragNode = { nodeId: node.id, offsetX: x - nx, offsetY: y - ny };\n        return;\n      }\n    }\n\n    const w = this.renderer.w;\n    const panelX = w * 0.72;\n    if (x > panelX) return;\n    this.isPanning = true;\n    this.panStartX = x;\n    this.panStartY = y;\n    this.panScrollStartX = this.scrollX;\n    this.panScrollStartY = this.scrollY;\n  }\n\n  private handleMouseMove(x: number, y: number) {\n    if (this.dragNode) {\n      const node = this.nodes.get(this.dragNode.nodeId);\n      if (node) {\n        node.x = x - this.dragNode.offsetX - this.scrollX;\n        node.y = y - this.dragNode.offsetY - this.scrollY;\n      }\n      return;\n    }\n\n    if (this.isPanning) {\n      this.scrollX = this.panScrollStartX + (x - this.panStartX);\n      this.scrollY = this.panScrollStartY + (y - this.panStartY);\n    }\n\n    if (this.linkDraft) {\n      this.linkDraft.mouseX = x;\n      this.linkDraft.mouseY = y;\n    }\n  }\n\n  private handleClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    const closeBtnX = w * 0.72 + 30;\n    const closeBtnY = 20;\n    if (this.isInRect(x, y, closeBtnX, closeBtnY, 80, 36)) {\n      this.close();\n      return;\n    }\n\n    for (const [id, node] of this.nodes) {\n      if (!node.unlocked) continue;\n      const nx = node.x + this.scrollX;\n      const ny = node.y + this.scrollY;\n      const dist = Math.sqrt((x - nx) ** 2 + (y - ny) ** 2);\n      if (dist <= this.nodeRadius) {\n        if (this.selectedNodeId === id) {\n          this.linkDraft = { fromId: id, mouseX: x, mouseY: y };\n        } else {\n          this.selectedNodeId = id;\n        }\n        return;\n      }\n    }\n\n    this.selectedNodeId = null;\n\n    const hypY = h * 0.6;\n    for (let i = 0; i < this.hypotheses.length; i++) {\n      const hy = hypY + i * 40;\n      if (this.isInRect(x, y, w * 0.74, hy, w * 0.22, 34)) {\n        this.selectedHypothesis = i;\n        return;\n      }\n    }\n  }\n\n  private handleLinkDrop(x: number, y: number) {\n    if (!this.linkDraft) return;\n\n    for (const [id, node] of this.nodes) {\n      if (!node.unlocked || id === this.linkDraft.fromId) continue;\n      const nx = node.x + this.scrollX;\n      const ny = node.y + this.scrollY;\n      const dist = Math.sqrt((x - nx) ** 2 + (y - ny) ** 2);\n      if (dist <= this.nodeRadius) {\n        this.connectNodes(this.linkDraft.fromId, id);\n        break;\n      }\n    }\n\n    this.linkDraft = null;\n  }\n\n  update(dt: number) {\n    if (!this.isOpen) return;\n    this.animAlpha = Math.min(1, this.animAlpha + dt * 5);\n    if (this.flashTimer > 0) this.flashTimer -= dt;\n    if (this.flashTimer <= 0) this.flashLink = -1;\n  }\n\n  render() {\n    if (!this.isOpen) return;\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.save();\n    ctx.globalAlpha = this.animAlpha * 0.5;\n    ctx.fillStyle = '#0a0806';\n    ctx.fillRect(0, 0, w, h);\n    ctx.restore();\n\n    ctx.save();\n    ctx.globalAlpha = this.animAlpha;\n\n    const boardW = w * 0.72;\n    const boardH = h;\n\n    ctx.fillStyle = '#0e0c0a';\n    ctx.fillRect(0, 0, boardW, boardH);\n\n    this.renderGrid(ctx, boardW, h);\n\n    for (const link of this.links) {\n      this.renderLink(ctx, link);\n    }\n\n    if (this.linkDraft) {\n      const fromNode = this.nodes.get(this.linkDraft.fromId);\n      if (fromNode) {\n        ctx.save();\n        ctx.strokeStyle = '#c8a040';\n        ctx.lineWidth = 2;\n        ctx.setLineDash([6, 4]);\n        ctx.beginPath();\n        ctx.moveTo(fromNode.x + this.scrollX, fromNode.y + this.scrollY);\n        ctx.lineTo(this.linkDraft.mouseX, this.linkDraft.mouseY);\n        ctx.stroke();\n        ctx.restore();\n      }\n    }\n\n    for (const [, node] of this.nodes) {\n      if (!node.unlocked) continue;\n      this.renderNode(ctx, node);\n    }\n\n    this.renderSidebar(ctx, w, h);\n\n    ctx.restore();\n  }\n\n  private renderGrid(ctx: CanvasRenderingContext2D, bw: number, bh: number) {\n    ctx.save();\n    ctx.strokeStyle = '#1a1610';\n    ctx.lineWidth = 0.5;\n    const step = 60;\n    for (let x = (this.scrollX % step); x < bw; x += step) {\n      ctx.beginPath();\n      ctx.moveTo(x, 0);\n      ctx.lineTo(x, bh);\n      ctx.stroke();\n    }\n    for (let y = (this.scrollY % step); y < bh; y += step) {\n      ctx.beginPath();\n      ctx.moveTo(0, y);\n      ctx.lineTo(bw, y);\n      ctx.stroke();\n    }\n    ctx.restore();\n  }\n\n  private renderNode(ctx: CanvasRenderingContext2D, node: ReasoningNode) {\n    const nx = node.x + this.scrollX;\n    const ny = node.y + this.scrollY;\n    const r = this.nodeRadius;\n\n    const isSelected = this.selectedNodeId === node.id;\n    const isHover =\n      Math.sqrt((this.input.mouseX - nx) ** 2 + (this.input.mouseY - ny) ** 2) <= r;\n\n    const typeColors: Record<string, string> = {\n      evidence: '#c8a040',\n      testimony: '#6a8ac8',\n      document: '#8a6ac8',\n      inference: '#c8c840',\n      environment: '#6ac888',\n      supernatural: '#8a4a8a',\n    };\n    const typeLabels: Record<string, string> = {\n      evidence: '物证',\n      testimony: '证词',\n      document: '文献',\n      inference: '推断',\n      environment: '观察',\n      supernatural: '异象',\n    };\n\n    const color = typeColors[node.type] ?? '#a0a0a0';\n\n    if (isSelected || isHover) {\n      ctx.save();\n      ctx.globalAlpha = 0.15;\n      const glow = ctx.createRadialGradient(nx, ny, 0, nx, ny, r * 2.5);\n      glow.addColorStop(0, color);\n      glow.addColorStop(1, 'transparent');\n      ctx.fillStyle = glow;\n      ctx.beginPath();\n      ctx.arc(nx, ny, r * 2.5, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.restore();\n    }\n\n    ctx.beginPath();\n    ctx.arc(nx, ny, r, 0, Math.PI * 2);\n    ctx.fillStyle = isSelected ? '#1e1810' : '#0e0c08';\n    ctx.fill();\n    ctx.strokeStyle = isSelected ? color : isHover ? color : '#4a3a2a';\n    ctx.lineWidth = isSelected ? 3 : 2;\n    ctx.stroke();\n\n    this.renderer.drawText(typeLabels[node.type] ?? '', nx, ny - 4, {\n      font: '12px sans-serif', color, align: 'center',\n    });\n\n    this.renderer.drawText(node.label, nx, ny + r + 6, {\n      font: '14px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n    });\n\n    if (isSelected) {\n      const tipW = 200;\n      const tipH = 50;\n      const tipX = nx + r + 10;\n      const tipY = ny - tipH / 2;\n\n      this.renderer.drawRoundRect(tipX, tipY, tipW, tipH, 4, '#1a140e', '#5a4030');\n      this.renderWrappedText(node.description, tipX + 8, tipY + 8, tipW - 16, 36, {\n        font: '13px \"SimSun\", \"Noto Serif SC\", serif', color: '#a09080',\n      });\n    }\n  }\n\n  private renderLink(ctx: CanvasRenderingContext2D, link: ReasoningLink) {\n    const from = this.nodes.get(link.from);\n    const to = this.nodes.get(link.to);\n    if (!from || !to) return;\n\n    const fx = from.x + this.scrollX;\n    const fy = from.y + this.scrollY;\n    const tx = to.x + this.scrollX;\n    const ty = to.y + this.scrollY;\n\n    const isFlash = this.links.indexOf(link) === this.flashLink && this.flashTimer > 0;\n\n    ctx.save();\n    ctx.strokeStyle = link.valid\n      ? (isFlash ? '#f0d8a0' : '#6a8a4a')\n      : (isFlash ? '#f0a0a0' : '#8a4a4a');\n    ctx.lineWidth = isFlash ? 3 : 2;\n    if (!link.valid) ctx.setLineDash([5, 3]);\n\n    const mx = (fx + tx) / 2;\n    const my = (fy + ty) / 2 - 20;\n\n    ctx.beginPath();\n    ctx.moveTo(fx, fy);\n    ctx.quadraticCurveTo(mx, my, tx, ty);\n    ctx.stroke();\n\n    if (link.label) {\n      this.renderer.drawText(link.label, mx, my - 8, {\n        font: '13px \"SimSun\", \"Noto Serif SC\", serif',\n        color: link.valid ? '#8ac86a' : '#c86a6a',\n        align: 'center',\n      });\n    }\n    ctx.restore();\n  }\n\n  private renderSidebar(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    const sideX = w * 0.72;\n    const sideW = w - sideX;\n\n    ctx.fillStyle = '#0e0a08';\n    ctx.fillRect(sideX, 0, sideW, h);\n    ctx.strokeStyle = '#3a2a1a';\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    ctx.moveTo(sideX, 0);\n    ctx.lineTo(sideX, h);\n    ctx.stroke();\n\n    this.renderer.drawText('推 理 板', sideX + sideW / 2, 18, {\n      font: 'bold 22px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    const unlockedCount = [...this.nodes.values()].filter((n) => n.unlocked).length;\n    this.renderer.drawText(`线索: ${unlockedCount} | 完整度: ${this.completeness}%`, sideX + 10, 50, {\n      font: '14px sans-serif', color: '#8a7a6a',\n    });\n\n    const barX = sideX + 10;\n    const barW = sideW - 20;\n    ctx.fillStyle = '#1a140e';\n    ctx.fillRect(barX, 72, barW, 8);\n    ctx.fillStyle = '#6a8a4a';\n    ctx.fillRect(barX, 72, barW * (this.completeness / 100), 8);\n\n    this.renderer.drawText('提示: 点击节点选中，再点击同一节点开始连线', sideX + 10, 92, {\n      font: '12px sans-serif', color: '#4a3a2a',\n    });\n\n    this.renderer.drawText('假设结论', sideX + sideW / 2, h * 0.55, {\n      font: 'bold 18px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    const hypY = h * 0.6;\n    this.hypotheses.forEach((hyp, i) => {\n      const hy = hypY + i * 40;\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, sideX + 10, hy, sideW - 20, 34);\n\n      this.renderer.drawRoundRect(sideX + 10, hy, sideW - 20, 34, 4,\n        hyp.validated ? '#1a2a10' : isHover ? '#1a140e' : '#0e0a08',\n        hyp.validated ? '#4a8a4a' : '#3a2a1a'\n      );\n\n      this.renderer.drawText(\n        `${hyp.validated ? '✓' : '○'} ${hyp.text}`,\n        sideX + 20, hy + 8,\n        {\n          font: '15px \"SimSun\", \"Noto Serif SC\", serif',\n          color: hyp.validated ? '#8ac86a' : '#a09080',\n        }\n      );\n    });\n\n    if (this.hypotheses.length === 0) {\n      this.renderer.drawText('尚无假设', sideX + sideW / 2, hypY + 20, {\n        font: '15px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n      });\n    }\n\n    const closeBtnX = sideX + 30;\n    const closeBtnY = 20;\n    const closeHover = this.isInRect(this.input.mouseX, this.input.mouseY, closeBtnX, closeBtnY, 80, 36);\n    this.renderer.drawRoundRect(closeBtnX, closeBtnY, 80, 36, 4,\n      closeHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('关闭', closeBtnX + 40, closeBtnY + 8, {\n      font: '16px \"SimSun\", \"Noto Serif SC\", serif',\n      color: closeHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n  }\n\n  private renderWrappedText(text: string, x: number, y: number, maxW: number, maxH: number,\n    opts: { font?: string; color?: string }) {\n    const ctx = this.renderer.context;\n    ctx.save();\n    ctx.font = opts.font ?? '14px \"SimSun\", \"Noto Serif SC\", serif';\n    ctx.fillStyle = opts.color ?? '#d8c8b0';\n\n    let lineY = y;\n    let line = '';\n    for (const ch of text) {\n      const test = line + ch;\n      if (ctx.measureText(test).width > maxW) {\n        ctx.fillText(line, x, lineY);\n        line = ch;\n        lineY += 18;\n        if (lineY - y > maxH) break;\n      } else {\n        line = test;\n      }\n    }\n    if (line) ctx.fillText(line, x, lineY);\n    ctx.restore();\n  }\n\n  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n  }\n}\n","numLines":628,"startLine":1,"totalLines":628}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_15b79188627540bb9b0694c8","type":"tool_result","content":"1\timport { Renderer } from '../renderer/Renderer';\n2\timport { GameState } from './GameState';\n3\timport { InputManager } from './InputManager';\n4\timport { CredibilityScore } from './CredibilityScore';\n5\t\n6\texport interface TestimonyLine {\n7\t  id: string;\n8\t  speaker: string;\n9\t  text: string;\n10\t  isLie: boolean;\n11\t  contradictEvidence?: string;\n12\t  revealFlag?: string;\n13\t}\n14\t\n15\texport interface ObjectionResult {\n16\t  success: boolean;\n17\t  evidenceUsed: string;\n18\t  lineId: string;\n19\t}\n20\t\n21\texport class ObjectionSystem {\n22\t  private currentTestimony: TestimonyLine | null = null;\n23\t  private isActive = false;\n24\t  private objectionMode = false;\n25\t  private evidenceSelectMode = false;\n26\t  private animAlpha = 0;\n27\t  private objectionFlash = 0;\n28\t  private resultMessage = '';\n29\t  private resultTimer = 0;\n30\t  private resultSuccess = false;\n31\t  private pressureGain = 0;\n32\t\n33\t  private onObjectionResult?: (result: ObjectionResult) => void;\n34\t\n35\t  constructor(\n36\t    private renderer: Renderer,\n37\t    private state: GameState,\n38\t    private input: InputManager,\n39\t    private credibility: CredibilityScore\n40\t  ) {\n41\t    this.setupInput();\n42\t  }\n43\t\n44\t  setResultCallback(cb: (result: ObjectionResult) => void) {\n45\t    this.onObjectionResult = cb;\n46\t  }\n47\t\n48\t  showTestimony(line: TestimonyLine) {\n49\t    this.currentTestimony = line;\n50\t    this.isActive = true;\n51\t    this.objectionMode = true;\n52\t    this.evidenceSelectMode = false;\n53\t    this.animAlpha = 0;\n54\t  }\n55\t\n56\t  hideTestimony() {\n57\t    this.isActive = false;\n58\t    this.objectionMode = false;\n59\t    this.evidenceSelectMode = false;\n60\t    this.currentTestimony = null;\n61\t  }\n62\t\n63\t  isTestimonyActive(): boolean { return this.isActive; }\n64\t\n65\t  private setupInput() {\n66\t    this.input.onClick((e) => {\n67\t      if (e.type !== 'up') return;\n68\t      if (!this.isActive) return;\n69\t      this.handleClick(e.x, e.y);\n70\t    });\n71\t  }\n72\t\n73\t  private handleClick(x: number, y: number) {\n74\t    const w = this.renderer.w;\n75\t    const h = this.renderer.h;\n76\t\n77\t    if (this.resultTimer > 0) {\n78\t      this.resultTimer = 0;\n79\t      this.resultMessage = '';\n80\t      return;\n81\t    }\n82\t\n83\t    if (this.evidenceSelectMode) {\n84\t      this.handleEvidenceClick(x, y);\n85\t      return;\n86\t    }\n87\t\n88\t    const boxX = w * 0.1;\n89\t    const boxW = w * 0.8;\n90\t    const boxY = h * 0.55;\n91\t    const boxH = h * 0.35;\n92\t\n93\t    const objectionBtnX = boxX + boxW * 0.15;\n94\t    const objectionBtnY = boxY + boxH - 55;\n95\t    if (this.isInRect(x, y, objectionBtnX, objectionBtnY, 120, 40)) {\n96\t      this.evidenceSelectMode = true;\n97\t      return;\n98\t    }\n99\t\n100\t    const noObjectionBtnX = boxX + boxW * 0.55;\n101\t    if (this.isInRect(x, y, noObjectionBtnX, objectionBtnY, 140, 40)) {\n102\t      this.handleNoObjection();\n103\t    }\n104\t  }\n105\t\n106\t  private handleEvidenceClick(x: number, y: number) {\n107\t    const w = this.renderer.w;\n108\t    const h = this.renderer.h;\n109\t\n110\t    const panelX = w * 0.2;\n111\t    const panelW = w * 0.6;\n112\t    const listY = h * 0.2;\n113\t\n114\t    const evidence = this.state.evidence;\n115\t    for (let i = 0; i < evidence.length; i++) {\n116\t      const iy = listY + i * 44;\n117\t      if (this.isInRect(x, y, panelX + 10, iy, panelW - 20, 38)) {\n118\t        this.submitObjection(evidence[i]);\n119\t        return;\n120\t      }\n121\t    }\n122\t\n123\t    if (this.isInRect(x, y, w * 0.4, h * 0.85, w * 0.2, 40)) {\n124\t      this.evidenceSelectMode = false;\n125\t    }\n126\t  }\n127\t\n128\t  submitObjection(evidenceId: string) {\n129\t    if (!this.currentTestimony) return;\n130\t\n131\t    this.evidenceSelectMode = false;\n132\t    this.objectionFlash = 1.5;\n133\t\n134\t    if (!this.currentTestimony.isLie) {\n135\t      this.credibility.onWrongAction('对真实证词提出异议');\n136\t      this.resultMessage = '异议不成立！这条证词是真实的。';\n137\t      this.resultTimer = 3;\n138\t      this.resultSuccess = false;\n139\t      this.onObjectionResult?.({\n140\t        success: false,\n141\t        evidenceUsed: evidenceId,\n142\t        lineId: this.currentTestimony.id,\n143\t      });\n144\t      return;\n145\t    }\n146\t\n147\t    if (this.currentTestimony.contradictEvidence &&\n148\t      evidenceId !== this.currentTestimony.contradictEvidence) {\n149\t      this.credibility.onWrongAction('出示了不相关的证据');\n150\t      this.resultMessage = '这份证据与此证词并无矛盾...';\n151\t      this.resultTimer = 3;\n152\t      this.resultSuccess = false;\n153\t      this.onObjectionResult?.({\n154\t        success: false,\n155\t        evidenceUsed: evidenceId,\n156\t        lineId: this.currentTestimony.id,\n157\t      });\n158\t      return;\n159\t    }\n160\t\n161\t    this.credibility.onCorrectAction('成功找到证词矛盾');\n162\t    this.pressureGain += 15;\n163\t    this.resultMessage = '异议成立！证词与证据存在矛盾！';\n164\t    this.resultTimer = 3;\n165\t    this.resultSuccess = true;\n166\t\n167\t    if (this.currentTestimony.revealFlag) {\n168\t      this.state.setFlag(this.currentTestimony.revealFlag, true);\n169\t    }\n170\t\n171\t    this.onObjectionResult?.({\n172\t      success: true,\n173\t      evidenceUsed: evidenceId,\n174\t      lineId: this.currentTestimony.id,\n175\t    });\n176\t  }\n177\t\n178\t  private handleNoObjection() {\n179\t    if (!this.currentTestimony) return;\n180\t\n181\t    if (this.currentTestimony.isLie) {\n182\t      this.credibility.onWrongAction('错过了虚假证词');\n183\t      this.resultMessage = '你错过了矛盾...证词中有谎言。';\n184\t      this.resultTimer = 3;\n185\t      this.resultSuccess = false;\n186\t    } else {\n187\t      this.credibility.onCorrectAction('正确判断证词为真');\n188\t      this.resultMessage = '无疑。证词属实。';\n189\t      this.resultTimer = 2;\n190\t      this.resultSuccess = true;\n191\t    }\n192\t  }\n193\t\n194\t  getPressureGain(): number { return this.pressureGain; }\n195\t\n196\t  resetPressure() { this.pressureGain = 0; }\n197\t\n198\t  update(dt: number) {\n199\t    if (!this.isActive) return;\n200\t    this.animAlpha = Math.min(1, this.animAlpha + dt * 5);\n201\t    if (this.objectionFlash > 0) this.objectionFlash -= dt;\n202\t    if (this.resultTimer > 0) this.resultTimer -= dt;\n203\t  }\n204\t\n205\t  render() {\n206\t    if (!this.isActive) return;\n207\t\n208\t    const ctx = this.renderer.context;\n209\t    const w = this.renderer.w;\n210\t    const h = this.renderer.h;\n211\t\n212\t    if (this.evidenceSelectMode) {\n213\t      this.renderEvidenceSelect(ctx, w, h);\n214\t      return;\n215\t    }\n216\t\n217\t    ctx.save();\n218\t    ctx.globalAlpha = this.animAlpha;\n219\t\n220\t    const boxX = w * 0.1;\n221\t    const boxW = w * 0.8;\n222\t    const boxY = h * 0.55;\n223\t    const boxH = h * 0.35;\n224\t\n225\t    this.renderer.drawRoundRect(boxX, boxY, boxW, boxH, 8, '#1a140e', '#3a2a1a');\n226\t    ctx.strokeStyle = '#5a4030';\n227\t    ctx.lineWidth = 1;\n228\t    ctx.strokeRect(boxX + 3, boxY + 3, boxW - 6, boxH - 6);\n229\t\n230\t    if (this.currentTestimony) {\n231\t      this.renderer.drawText(`证人：${this.currentTestimony.speaker}`, boxX + 20, boxY + 15, {\n232\t        font: 'bold 18px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882',\n233\t      });\n234\t\n235\t      this.renderWrappedText(this.currentTestimony.text, boxX + 20, boxY + 45, boxW - 40, 80, {\n236\t        font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0',\n237\t      });\n238\t    }\n239\t\n240\t    this.credibility.render(boxX + 20, boxY + boxH - 50, boxW * 0.4);\n241\t\n242\t    if (this.resultTimer > 0) {\n243\t      ctx.save();\n244\t      ctx.globalAlpha = Math.min(1, this.resultTimer);\n245\t      const msgColor = this.resultSuccess ? '#6a8a4a' : '#8a4a4a';\n246\t      this.renderer.drawText(this.resultMessage, boxX + boxW / 2, boxY + boxH / 2 - 20, {\n247\t        font: 'bold 22px \"SimSun\", \"Noto Serif SC\", serif', color: msgColor, align: 'center',\n248\t      });\n249\t      ctx.restore();\n250\t    }\n251\t\n252\t    if (this.objectionFlash > 0) {\n253\t      ctx.save();\n254\t      ctx.globalAlpha = Math.min(1, this.objectionFlash) * 0.3;\n255\t      ctx.fillStyle = this.resultSuccess ? '#4a8a4a' : '#8a3a3a';\n256\t      ctx.fillRect(0, 0, w, h);\n257\t      ctx.restore();\n258\t    }\n259\t\n260\t    if (this.resultTimer <= 0 && this.objectionMode) {\n261\t      const btnY = boxY + boxH - 55;\n262\t      const objectionBtnX = boxX + boxW * 0.15;\n263\t      const objHover = this.isInRect(this.input.mouseX, this.input.mouseY, objectionBtnX, btnY, 120, 40);\n264\t      this.renderer.drawRoundRect(objectionBtnX, btnY, 120, 40, 4,\n265\t        objHover ? '#3a1a0a' : '#1a140e', '#8b4513');\n266\t      this.renderer.drawText('异议！', objectionBtnX + 60, btnY + 10, {\n267\t        font: 'bold 20px \"SimSun\", \"Noto Serif SC\", serif',\n268\t        color: objHover ? '#f0d8a0' : '#c8a040', align: 'center',\n269\t      });\n270\t\n271\t      const noObjBtnX = boxX + boxW * 0.55;\n272\t      const noObjHover = this.isInRect(this.input.mouseX, this.input.mouseY, noObjBtnX, btnY, 140, 40);\n273\t      this.renderer.drawRoundRect(noObjBtnX, btnY, 140, 40, 4,\n274\t        noObjHover ? '#2a1a0e' : '#1a140e', '#5a4030');\n275\t      this.renderer.drawText('无疑，继续', noObjBtnX + 70, btnY + 10, {\n276\t        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n277\t        color: noObjHover ? '#e8c8a2' : '#a08870', align: 'center',\n278\t      });\n279\t    }\n280\t\n281\t    ctx.restore();\n282\t  }\n283\t\n284\t  private renderEvidenceSelect(ctx: CanvasRenderingContext2D, w: number, h: number) {\n285\t    ctx.save();\n286\t    ctx.globalAlpha = 0.9;\n287\t    ctx.fillStyle = '#0a0806';\n288\t    ctx.fillRect(0, 0, w, h);\n289\t    ctx.restore();\n290\t\n291\t    const panelX = w * 0.2;\n292\t    const panelW = w * 0.6;\n293\t    const panelY = h * 0.1;\n294\t    const panelH = h * 0.75;\n295\t\n296\t    this.renderer.drawRoundRect(panelX, panelY, panelW, panelH, 8, '#1a140e', '#5a4030');\n297\t    this.renderer.drawText('出示反驳证据', panelX + panelW / 2, panelY + 18, {\n298\t      font: 'bold 22px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n299\t    });\n300\t\n301\t    if (this.currentTestimony) {\n302\t      this.renderer.drawText(`反驳证词：\"${this.currentTestimony.text.substring(0, 20)}...\"`,\n303\t        panelX + panelW / 2, panelY + 50, {\n304\t          font: '14px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center',\n305\t        });\n306\t    }\n307\t\n308\t    const items = this.state.evidence;\n309\t    const listY = h * 0.2;\n310\t\n311\t    items.forEach((evId, i) => {\n312\t      const iy = listY + i * 44;\n313\t      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + 10, iy, panelW - 20, 38);\n314\t\n315\t      if (isHover) {\n316\t        ctx.fillStyle = 'rgba(200, 168, 130, 0.12)';\n317\t        ctx.fillRect(panelX + 10, iy, panelW - 20, 38);\n318\t      }\n319\t\n320\t      this.renderer.drawText(`▪ ${evId}`, panelX + 25, iy + 8, {\n321\t        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n322\t        color: isHover ? '#f0d8b0' : '#d8c8b0',\n323\t      });\n324\t    });\n325\t\n326\t    if (items.length === 0) {\n327\t      this.renderer.drawText('没有可出示的证据', panelX + panelW / 2, listY + 30, {\n328\t        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n329\t      });\n330\t    }\n331\t\n332\t    const cancelHover = this.isInRect(this.input.mouseX, this.input.mouseY, w * 0.4, h * 0.85, w * 0.2, 40);\n333\t    this.renderer.drawRoundRect(w * 0.4, h * 0.85, w * 0.2, 40, 4,\n334\t      cancelHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n335\t    this.renderer.drawText('取消', w / 2, h * 0.85 + 10, {\n336\t      font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n337\t      color: cancelHover ? '#e8c8a2' : '#a08870', align: 'center',\n338\t    });\n339\t  }\n340\t\n341\t  private renderWrappedText(text: string, x: number, y: number, maxW: number, maxH: number,\n342\t    opts: { font?: string; color?: string }) {\n343\t    const ctx = this.renderer.context;\n344\t    ctx.save();\n345\t    ctx.font = opts.font ?? '20px \"SimSun\", \"Noto Serif SC\", serif';\n346\t    ctx.fillStyle = opts.color ?? '#d8c8b0';\n347\t\n348\t    let lineY = y;\n349\t    let line = '';\n350\t    for (const ch of text) {\n351\t      const test = line + ch;\n352\t      if (ctx.measureText(test).width > maxW) {\n353\t        ctx.fillText(line, x, lineY);\n354\t        line = ch;\n355\t        lineY += 28;\n356\t        if (lineY - y > maxH) break;\n357\t      } else {\n358\t        line = test;\n359\t      }\n360\t    }\n361\t    if (line) ctx.fillText(line, x, lineY);\n362\t    ctx.restore();\n363\t  }\n364\t\n365\t  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n366\t    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n367\t  }\n368\t}\n369\t"}]},"parent_tool_use_id":null,"session_id":"60e8bd2a-b118-4ebb-8072-7fe7ed523870","uuid":"a9ea40b5-558f-4896-a385-6a757eb84f11","timestamp":"2026-05-23T17:49:36.513Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-ancient-mystery\\src\\game\\ObjectionSystem.ts","content":"import { Renderer } from '../renderer/Renderer';\nimport { GameState } from './GameState';\nimport { InputManager } from './InputManager';\nimport { CredibilityScore } from './CredibilityScore';\n\nexport interface TestimonyLine {\n  id: string;\n  speaker: string;\n  text: string;\n  isLie: boolean;\n  contradictEvidence?: string;\n  revealFlag?: string;\n}\n\nexport interface ObjectionResult {\n  success: boolean;\n  evidenceUsed: string;\n  lineId: string;\n}\n\nexport class ObjectionSystem {\n  private currentTestimony: TestimonyLine | null = null;\n  private isActive = false;\n  private objectionMode = false;\n  private evidenceSelectMode = false;\n  private animAlpha = 0;\n  private objectionFlash = 0;\n  private resultMessage = '';\n  private resultTimer = 0;\n  private resultSuccess = false;\n  private pressureGain = 0;\n\n  private onObjectionResult?: (result: ObjectionResult) => void;\n\n  constructor(\n    private renderer: Renderer,\n    private state: GameState,\n    private input: InputManager,\n    private credibility: CredibilityScore\n  ) {\n    this.setupInput();\n  }\n\n  setResultCallback(cb: (result: ObjectionResult) => void) {\n    this.onObjectionResult = cb;\n  }\n\n  showTestimony(line: TestimonyLine) {\n    this.currentTestimony = line;\n    this.isActive = true;\n    this.objectionMode = true;\n    this.evidenceSelectMode = false;\n    this.animAlpha = 0;\n  }\n\n  hideTestimony() {\n    this.isActive = false;\n    this.objectionMode = false;\n    this.evidenceSelectMode = false;\n    this.currentTestimony = null;\n  }\n\n  isTestimonyActive(): boolean { return this.isActive; }\n\n  private setupInput() {\n    this.input.onClick((e) => {\n      if (e.type !== 'up') return;\n      if (!this.isActive) return;\n      this.handleClick(e.x, e.y);\n    });\n  }\n\n  private handleClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    if (this.resultTimer > 0) {\n      this.resultTimer = 0;\n      this.resultMessage = '';\n      return;\n    }\n\n    if (this.evidenceSelectMode) {\n      this.handleEvidenceClick(x, y);\n      return;\n    }\n\n    const boxX = w * 0.1;\n    const boxW = w * 0.8;\n    const boxY = h * 0.55;\n    const boxH = h * 0.35;\n\n    const objectionBtnX = boxX + boxW * 0.15;\n    const objectionBtnY = boxY + boxH - 55;\n    if (this.isInRect(x, y, objectionBtnX, objectionBtnY, 120, 40)) {\n      this.evidenceSelectMode = true;\n      return;\n    }\n\n    const noObjectionBtnX = boxX + boxW * 0.55;\n    if (this.isInRect(x, y, noObjectionBtnX, objectionBtnY, 140, 40)) {\n      this.handleNoObjection();\n    }\n  }\n\n  private handleEvidenceClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    const panelX = w * 0.2;\n    const panelW = w * 0.6;\n    const listY = h * 0.2;\n\n    const evidence = this.state.evidence;\n    for (let i = 0; i < evidence.length; i++) {\n      const iy = listY + i * 44;\n      if (this.isInRect(x, y, panelX + 10, iy, panelW - 20, 38)) {\n        this.submitObjection(evidence[i]);\n        return;\n      }\n    }\n\n    if (this.isInRect(x, y, w * 0.4, h * 0.85, w * 0.2, 40)) {\n      this.evidenceSelectMode = false;\n    }\n  }\n\n  submitObjection(evidenceId: string) {\n    if (!this.currentTestimony) return;\n\n    this.evidenceSelectMode = false;\n    this.objectionFlash = 1.5;\n\n    if (!this.currentTestimony.isLie) {\n      this.credibility.onWrongAction('对真实证词提出异议');\n      this.resultMessage = '异议不成立！这条证词是真实的。';\n      this.resultTimer = 3;\n      this.resultSuccess = false;\n      this.onObjectionResult?.({\n        success: false,\n        evidenceUsed: evidenceId,\n        lineId: this.currentTestimony.id,\n      });\n      return;\n    }\n\n    if (this.currentTestimony.contradictEvidence &&\n      evidenceId !== this.currentTestimony.contradictEvidence) {\n      this.credibility.onWrongAction('出示了不相关的证据');\n      this.resultMessage = '这份证据与此证词并无矛盾...';\n      this.resultTimer = 3;\n      this.resultSuccess = false;\n      this.onObjectionResult?.({\n        success: false,\n        evidenceUsed: evidenceId,\n        lineId: this.currentTestimony.id,\n      });\n      return;\n    }\n\n    this.credibility.onCorrectAction('成功找到证词矛盾');\n    this.pressureGain += 15;\n    this.resultMessage = '异议成立！证词与证据存在矛盾！';\n    this.resultTimer = 3;\n    this.resultSuccess = true;\n\n    if (this.currentTestimony.revealFlag) {\n      this.state.setFlag(this.currentTestimony.revealFlag, true);\n    }\n\n    this.onObjectionResult?.({\n      success: true,\n      evidenceUsed: evidenceId,\n      lineId: this.currentTestimony.id,\n    });\n  }\n\n  private handleNoObjection() {\n    if (!this.currentTestimony) return;\n\n    if (this.currentTestimony.isLie) {\n      this.credibility.onWrongAction('错过了虚假证词');\n      this.resultMessage = '你错过了矛盾...证词中有谎言。';\n      this.resultTimer = 3;\n      this.resultSuccess = false;\n    } else {\n      this.credibility.onCorrectAction('正确判断证词为真');\n      this.resultMessage = '无疑。证词属实。';\n      this.resultTimer = 2;\n      this.resultSuccess = true;\n    }\n  }\n\n  getPressureGain(): number { return this.pressureGain; }\n\n  resetPressure() { this.pressureGain = 0; }\n\n  update(dt: number) {\n    if (!this.isActive) return;\n    this.animAlpha = Math.min(1, this.animAlpha + dt * 5);\n    if (this.objectionFlash > 0) this.objectionFlash -= dt;\n    if (this.resultTimer > 0) this.resultTimer -= dt;\n  }\n\n  render() {\n    if (!this.isActive) return;\n\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    if (this.evidenceSelectMode) {\n      this.renderEvidenceSelect(ctx, w, h);\n      return;\n    }\n\n    ctx.save();\n    ctx.globalAlpha = this.animAlpha;\n\n    const boxX = w * 0.1;\n    const boxW = w * 0.8;\n    const boxY = h * 0.55;\n    const boxH = h * 0.35;\n\n    this.renderer.drawRoundRect(boxX, boxY, boxW, boxH, 8, '#1a140e', '#3a2a1a');\n    ctx.strokeStyle = '#5a4030';\n    ctx.lineWidth = 1;\n    ctx.strokeRect(boxX + 3, boxY + 3, boxW - 6, boxH - 6);\n\n    if (this.currentTestimony) {\n      this.renderer.drawText(`证人：${this.currentTestimony.speaker}`, boxX + 20, boxY + 15, {\n        font: 'bold 18px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882',\n      });\n\n      this.renderWrappedText(this.currentTestimony.text, boxX + 20, boxY + 45, boxW - 40, 80, {\n        font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0',\n      });\n    }\n\n    this.credibility.render(boxX + 20, boxY + boxH - 50, boxW * 0.4);\n\n    if (this.resultTimer > 0) {\n      ctx.save();\n      ctx.globalAlpha = Math.min(1, this.resultTimer);\n      const msgColor = this.resultSuccess ? '#6a8a4a' : '#8a4a4a';\n      this.renderer.drawText(this.resultMessage, boxX + boxW / 2, boxY + boxH / 2 - 20, {\n        font: 'bold 22px \"SimSun\", \"Noto Serif SC\", serif', color: msgColor, align: 'center',\n      });\n      ctx.restore();\n    }\n\n    if (this.objectionFlash > 0) {\n      ctx.save();\n      ctx.globalAlpha = Math.min(1, this.objectionFlash) * 0.3;\n      ctx.fillStyle = this.resultSuccess ? '#4a8a4a' : '#8a3a3a';\n      ctx.fillRect(0, 0, w, h);\n      ctx.restore();\n    }\n\n    if (this.resultTimer <= 0 && this.objectionMode) {\n      const btnY = boxY + boxH - 55;\n      const objectionBtnX = boxX + boxW * 0.15;\n      const objHover = this.isInRect(this.input.mouseX, this.input.mouseY, objectionBtnX, btnY, 120, 40);\n      this.renderer.drawRoundRect(objectionBtnX, btnY, 120, 40, 4,\n        objHover ? '#3a1a0a' : '#1a140e', '#8b4513');\n      this.renderer.drawText('异议！', objectionBtnX + 60, btnY + 10, {\n        font: 'bold 20px \"SimSun\", \"Noto Serif SC\", serif',\n        color: objHover ? '#f0d8a0' : '#c8a040', align: 'center',\n      });\n\n      const noObjBtnX = boxX + boxW * 0.55;\n      const noObjHover = this.isInRect(this.input.mouseX, this.input.mouseY, noObjBtnX, btnY, 140, 40);\n      this.renderer.drawRoundRect(noObjBtnX, btnY, 140, 40, 4,\n        noObjHover ? '#2a1a0e' : '#1a140e', '#5a4030');\n      this.renderer.drawText('无疑，继续', noObjBtnX + 70, btnY + 10, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n        color: noObjHover ? '#e8c8a2' : '#a08870', align: 'center',\n      });\n    }\n\n    ctx.restore();\n  }\n\n  private renderEvidenceSelect(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    ctx.save();\n    ctx.globalAlpha = 0.9;\n    ctx.fillStyle = '#0a0806';\n    ctx.fillRect(0, 0, w, h);\n    ctx.restore();\n\n    const panelX = w * 0.2;\n    const panelW = w * 0.6;\n    const panelY = h * 0.1;\n    const panelH = h * 0.75;\n\n    this.renderer.drawRoundRect(panelX, panelY, panelW, panelH, 8, '#1a140e', '#5a4030');\n    this.renderer.drawText('出示反驳证据', panelX + panelW / 2, panelY + 18, {\n      font: 'bold 22px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    if (this.currentTestimony) {\n      this.renderer.drawText(`反驳证词：\"${this.currentTestimony.text.substring(0, 20)}...\"`,\n        panelX + panelW / 2, panelY + 50, {\n          font: '14px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center',\n        });\n    }\n\n    const items = this.state.evidence;\n    const listY = h * 0.2;\n\n    items.forEach((evId, i) => {\n      const iy = listY + i * 44;\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + 10, iy, panelW - 20, 38);\n\n      if (isHover) {\n        ctx.fillStyle = 'rgba(200, 168, 130, 0.12)';\n        ctx.fillRect(panelX + 10, iy, panelW - 20, 38);\n      }\n\n      this.renderer.drawText(`▪ ${evId}`, panelX + 25, iy + 8, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n        color: isHover ? '#f0d8b0' : '#d8c8b0',\n      });\n    });\n\n    if (items.length === 0) {\n      this.renderer.drawText('没有可出示的证据', panelX + panelW / 2, listY + 30, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n      });\n    }\n\n    const cancelHover = this.isInRect(this.input.mouseX, this.input.mouseY, w * 0.4, h * 0.85, w * 0.2, 40);\n    this.renderer.drawRoundRect(w * 0.4, h * 0.85, w * 0.2, 40, 4,\n      cancelHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('取消', w / 2, h * 0.85 + 10, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n      color: cancelHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n  }\n\n  private renderWrappedText(text: string, x: number, y: number, maxW: number, maxH: number,\n    opts: { font?: string; color?: string }) {\n    const ctx = this.renderer.context;\n    ctx.save();\n    ctx.font = opts.font ?? '20px \"SimSun\", \"Noto Serif SC\", serif';\n    ctx.fillStyle = opts.color ?? '#d8c8b0';\n\n    let lineY = y;\n    let line = '';\n    for (const ch of text) {\n      const test = line + ch;\n      if (ctx.measureText(test).width > maxW) {\n        ctx.fillText(line, x, lineY);\n        line = ch;\n        lineY += 28;\n        if (lineY - y > maxH) break;\n      } else {\n        line = test;\n      }\n    }\n    if (line) ctx.fillText(line, x, lineY);\n    ctx.restore();\n  }\n\n  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n  }\n}\n","numLines":369,"startLine":1,"totalLines":369}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_fea77ebb76b448aba94f6bd5","type":"tool_result","content":"1\timport { Renderer } from '../Renderer';\n2\timport { SceneManager } from '../../game/SceneManager';\n3\timport { DialogueEngine } from '../../game/DialogueEngine';\n4\timport { GameState } from '../../game/GameState';\n5\timport { InputManager } from '../../game/InputManager';\n6\timport { SceneExplorer, Hotspot, ExploreScene } from '../../game/SceneExplorer';\n7\timport { EvidenceCollector, EvidenceItem } from '../../game/EvidenceCollector';\n8\timport { InterrogationSystem, InterrogationNPC, InterrogationTopic } from '../../game/InterrogationSystem';\n9\timport { EvidenceCombiner, CombinationRecipe } from '../../game/EvidenceCombiner';\n10\timport { ReasoningBoard, ReasoningNode, ReasoningLink, ReasoningHypothesis } from '../../game/ReasoningBoard';\n11\timport { TrialLoop, TrialConfig } from '../../game/TrialLoop';\n12\t\n13\texport type UIScreen = 'main_menu' | 'game' | 'settings' | 'save_load' | 'dialogue' | 'explore' | 'interrogation' | 'evidence' | 'combine' | 'reasoning' | 'trial';\n14\t\n15\texport class UIManager {\n16\t  private currentScreen: UIScreen = 'main_menu';\n17\t  private screenAlpha = 1;\n18\t  private hoverIndex = -1;\n19\t  private sceneExplorer: SceneExplorer;\n20\t  private evidenceCollector: EvidenceCollector;\n21\t  private interrogationSystem: InterrogationSystem;\n22\t  private evidenceCombiner: EvidenceCombiner;\n23\t  private reasoningBoard: ReasoningBoard;\n24\t  private trialLoop: TrialLoop;\n25\t\n26\t  constructor(\n27\t    private renderer: Renderer,\n28\t    private sceneManager: SceneManager,\n29\t    private dialogueEngine: DialogueEngine,\n30\t    private state: GameState,\n31\t    private input: InputManager\n32\t  ) {\n33\t    this.sceneExplorer = new SceneExplorer(renderer, state, input);\n34\t    this.evidenceCollector = new EvidenceCollector(renderer, state, input);\n35\t    this.interrogationSystem = new InterrogationSystem(renderer, state, dialogueEngine, input);\n36\t    this.evidenceCombiner = new EvidenceCombiner(renderer, state, input, this.evidenceCollector);\n37\t    this.reasoningBoard = new ReasoningBoard(renderer, state, input);\n38\t    this.trialLoop = new TrialLoop(renderer, state, input);\n39\t\n40\t    this.setupInput();\n41\t    this.loadDemoDialogue();\n42\t    this.loadDemoM2Data();\n43\t    this.loadDemoM3Data();\n44\t  }\n45\t\n46\t  private loadDemoDialogue() {\n47\t    this.dialogueEngine.loadDialogue([\n48\t      { id: 'intro_1', speaker: '旁白', text: '天宝元年，长安。', next: 'intro_2' },\n49\t      { id: 'intro_2', speaker: '旁白', text: '你是新任万年县推官沈鹤年，今日初到衙门赴任。', next: 'intro_3' },\n50\t      { id: 'intro_3', speaker: '裴如意', text: '你就是新来的推官？看起来很年轻嘛。', portrait: 'pei_ruyi', next: 'intro_4' },\n51\t      {\n52\t        id: 'intro_4', speaker: '沈鹤年', text: '',\n53\t        choices: [\n54\t          { text: '下官沈鹤年，参见县令大人。', next: 'intro_5a' },\n55\t          { text: '年龄不代表能力，大人。', next: 'intro_5b' },\n56\t        ],\n57\t      },\n58\t      { id: 'intro_5a', speaker: '裴如意', text: '嗯，懂规矩。正好，东市出了个案子，你跟我去看看。', portrait: 'pei_ruyi',\n59\t        effects: { relationship: { npc: 'pei_ruyi', delta: 5 } } },\n60\t      { id: 'intro_5b', speaker: '裴如意', text: '哈，有点意思。不过在这里，规矩比能力重要。跟我来吧。', portrait: 'pei_ruyi',\n61\t        effects: { relationship: { npc: 'pei_ruyi', delta: -3 } } },\n62\t      // M2 interrogation dialogue\n63\t      { id: 'interrog_liu_1', speaker: '刘七娘', text: '你问我那天晚上在哪？我...我在坊里待着呢。' },\n64\t      { id: 'interrog_liu_2', speaker: '刘七娘', text: '好吧...我确实去了东市，但什么也没看到！' },\n65\t      { id: 'interrog_liu_3', speaker: '刘七娘', text: '你、你怎么会有这个...好吧，我说实话。那天晚上...' },\n66\t      { id: 'interrog_zhang_1', speaker: '张铁手', text: '哼，推官大人有什么事？' },\n67\t      { id: 'interrog_zhang_2', speaker: '张铁手', text: '这件事...我知道一些，但不一定跟你说。' },\n68\t    ]);\n69\t  }\n70\t\n71\t  private loadDemoM2Data() {\n72\t    // Evidence items\n73\t    this.evidenceCollector.registerEvidence([\n74\t      { id: 'broken_jade', name: '碎玉佩', description: '在东市废墟中发现的一块碎玉佩，上面刻有\"裴\"字。', category: 'key', discoveredAt: 'east_market_ruins', discoveredTime: Date.now(), combinable: ['blood_cloth'] },\n75\t      { id: 'blood_cloth', name: '血衣碎片', description: '沾有暗色血迹的布料，质地似官服。', category: 'key', discoveredAt: 'east_market_ruins', discoveredTime: Date.now(), combinable: ['broken_jade'] },\n76\t      { id: 'night_watch_log', name: '巡夜记录', description: '当夜的巡夜记录，记载了可疑人影的出没时间。', category: 'normal', discoveredAt: 'county_office', discoveredTime: Date.now() },\n77\t      { id: 'fake_seal', name: '伪造印信', description: '一枚做工粗糙的伪造官印。', category: 'misleading', discoveredAt: 'west_market', discoveredTime: Date.now() },\n78\t    ]);\n79\t\n80\t    // Scene explorer hotspots\n81\t    this.sceneExplorer.registerScene({\n82\t      sceneId: 'east_market_ruins',\n83\t      hotspots: [\n84\t        { id: 'hs_jade', x: 200, y: 150, w: 80, h: 60, label: '碎玉佩', examined: false, action: 'pickup', giveEvidence: 'broken_jade' },\n85\t        { id: 'hs_cloth', x: 500, y: 300, w: 100, h: 70, label: '血衣碎片', examined: false, action: 'pickup', giveEvidence: 'blood_cloth' },\n86\t        { id: 'hs_door', x: 800, y: 200, w: 60, h: 120, label: '破旧的门', examined: false, action: 'examine' },\n87\t        { id: 'hs_wall', x: 100, y: 400, w: 200, h: 80, label: '残墙上的字迹', examined: false, action: 'examine' },\n88\t      ],\n89\t    });\n90\t\n91\t    this.sceneExplorer.registerScene({\n92\t      sceneId: 'county_office',\n93\t      hotspots: [\n94\t        { id: 'hs_desk', x: 400, y: 200, w: 150, h: 100, label: '县令书案', examined: false, action: 'examine' },\n95\t        { id: 'hs_log', x: 600, y: 350, w: 80, h: 50, label: '巡夜记录', examined: false, action: 'pickup', giveEvidence: 'night_watch_log' },\n96\t      ],\n97\t    });\n98\t\n99\t    // Interrogation NPCs\n100\t    this.interrogationSystem.registerNPC({ id: 'liu_qiniang', name: '刘七娘', defaultPressure: 20, maxPressure: 100 });\n101\t    this.interrogationSystem.registerNPC({ id: 'zhang_tieshou', name: '张铁手', defaultPressure: 35, maxPressure: 100 });\n102\t\n103\t    this.interrogationSystem.registerTopics([\n104\t      { id: 't_liu_1', npcId: 'liu_qiniang', label: '案发当晚行踪', dialogueId: 'interrog_liu_1', repeatable: false },\n105\t      { id: 't_liu_2', npcId: 'liu_qiniang', label: '东市见闻', dialogueId: 'interrog_liu_2', repeatable: false, pressureRange: { min: 30, max: 100 } },\n106\t      { id: 't_liu_3', npcId: 'liu_qiniang', label: '关于碎玉佩', dialogueId: 'interrog_liu_3', repeatable: false, requiresEvidence: ['broken_jade'] },\n107\t      { id: 't_zhang_1', npcId: 'zhang_tieshou', label: '当晚巡逻情况', dialogueId: 'interrog_zhang_1', repeatable: false },\n108\t      { id: 't_zhang_2', npcId: 'zhang_tieshou', label: '可疑人物', dialogueId: 'interrog_zhang_2', repeatable: false, requiresEvidence: ['night_watch_log'] },\n109\t    ]);\n110\t\n111\t    // Combination recipes\n112\t    this.evidenceCombiner.registerRecipes([\n113\t      { id: 'recipe_1', inputs: ['broken_jade', 'blood_cloth'], output: 'jade_cloth_bundle', outputName: '玉佩与血衣', outputDescription: '碎玉佩与血衣碎片放在一起，血迹的位置恰好对应玉佩上的裂纹——这是案发现场的关键关联。', outputCategory: 'key' },\n114\t    ]);\n115\t\n116\t    // Hotspot action callback\n117\t    this.sceneExplorer.setActionCallback((hs) => {\n118\t      if (hs.action === 'talk' && hs.dialogueId) {\n119\t        this.dialogueEngine.start(hs.dialogueId);\n120\t      }\n121\t    });\n122\t  }\n123\t\n124\t  private loadDemoM3Data() {\n125\t    // Reasoning board nodes\n126\t    this.reasoningBoard.registerNodes([\n127\t      { id: 'rn_broken_jade', label: '碎玉佩', type: 'evidence', x: 200, y: 150, unlocked: true, description: '东市废墟中发现的碎玉佩，刻有\"裴\"字' },\n128\t      { id: 'rn_blood_cloth', label: '血衣碎片', type: 'evidence', x: 400, y: 120, unlocked: true, description: '沾有血迹的官服布料' },\n129\t      { id: 'rn_night_watch', label: '巡夜记录', type: 'document', x: 300, y: 300, unlocked: true, description: '当夜巡夜记录，记载了可疑人影' },\n130\t      { id: 'rn_liu_testimony', label: '刘七娘证词', type: 'testimony', x: 500, y: 280, unlocked: true, description: '刘七娘声称当晚在坊内，但实去了东市' },\n131\t      { id: 'rn_fake_seal', label: '伪造印信', type: 'evidence', x: 150, y: 350, unlocked: true, description: '做工粗糙的伪造官印' },\n132\t      { id: 'rn_jade_cloth', label: '玉佩与血衣', type: 'inference', x: 350, y: 200, unlocked: false, description: '血迹对应玉佩裂纹——关键关联' },\n133\t    ]);\n134\t\n135\t    this.reasoningBoard.registerLinks([\n136\t      { from: 'rn_broken_jade', to: 'rn_blood_cloth', label: '关联', valid: true },\n137\t      { from: 'rn_blood_cloth', to: 'rn_night_watch', label: '时间关联', valid: true },\n138\t      { from: 'rn_liu_testimony', to: 'rn_night_watch', label: '矛盾', valid: true },\n139\t      { from: 'rn_broken_jade', to: 'rn_jade_cloth', label: '组合', valid: true, requiresEvidence: ['jade_cloth_bundle'] },\n140\t    ]);\n141\t\n142\t    this.reasoningBoard.registerHypothesis({\n143\t      id: 'hyp_1',\n144\t      text: '碎玉佩与血衣是同一案件的关键物证',\n145\t      requiredLinks: ['rn_broken_jade', 'rn_blood_cloth'],\n146\t      validated: false,\n147\t    });\n148\t\n149\t    // Trial demo config\n150\t    this.reasoningBoard.setHypothesisCallback((h) => {\n151\t      this.state.setFlag(`hypothesis_${h.id}`, true);\n152\t    });\n153\t  }\n154\t\n155\t  private setupInput() {\n156\t    this.input.onClick((e) => {\n157\t      if (e.type !== 'up') return;\n158\t      this.handleClick(e.x, e.y);\n159\t    });\n160\t  }\n161\t\n162\t  private handleClick(x: number, y: number) {\n163\t    switch (this.currentScreen) {\n164\t      case 'main_menu': this.handleMenuClick(x, y); break;\n165\t      case 'dialogue': this.handleDialogueClick(x, y); break;\n166\t      case 'settings': this.handleSettingsClick(x, y); break;\n167\t      case 'save_load': this.handleSaveLoadClick(x, y); break;\n168\t      case 'explore': this.handleExploreClick(x, y); break;\n169\t      case 'interrogation': break;\n170\t      case 'evidence': break;\n171\t      case 'combine': break;\n172\t      case 'reasoning': break;\n173\t      case 'trial': break;\n174\t    }\n175\t  }\n176\t\n177\t  resize(w: number, h: number) {}\n178\t\n179\t  update(dt: number) {\n180\t    this.state.playTime += dt;\n181\t    this.sceneExplorer.update(dt);\n182\t    this.evidenceCollector.update(dt);\n183\t    this.interrogationSystem.update(dt);\n184\t    this.evidenceCombiner.update(dt);\n185\t    this.reasoningBoard.update(dt);\n186\t    this.trialLoop.update(dt);\n187\t  }\n188\t\n189\t  render() {\n190\t    switch (this.currentScreen) {\n191\t      case 'main_menu': this.renderMainMenu(); break;\n192\t      case 'game': this.renderGameHUD(); break;\n193\t      case 'dialogue': this.renderDialogueUI(); break;\n194\t      case 'settings': this.renderSettings(); break;\n195\t      case 'save_load': this.renderSaveLoad(); break;\n196\t      case 'explore': this.renderExploreScreen(); break;\n197\t      case 'interrogation': this.renderInterrogationScreen(); break;\n198\t      case 'evidence': this.renderEvidenceScreen(); break;\n199\t      case 'combine': this.renderCombineScreen(); break;\n200\t      case 'reasoning': this.renderReasoningScreen(); break;\n201\t      case 'trial': this.renderTrialScreen(); break;\n202\t    }\n203\t  }\n204\t\n205\t  // ── Main Menu ──\n206\t\n207\t  private menuItems = [\n208\t    { label: '开始游戏', action: () => this.startGame() },\n209\t    { label: '继续游戏', action: () => this.showScreen('save_load') },\n210\t    { label: '设置', action: () => this.showScreen('settings') },\n211\t  ];\n212\t\n213\t  private renderMainMenu() {\n214\t    const ctx = this.renderer.context;\n215\t    const w = this.renderer.w;\n216\t    const h = this.renderer.h;\n217\t\n218\t    const grad = ctx.createLinearGradient(0, 0, 0, h);\n219\t    grad.addColorStop(0, '#0d0808');\n220\t    grad.addColorStop(0.5, '#1a0a0a');\n221\t    grad.addColorStop(1, '#0d0808');\n222\t    ctx.fillStyle = grad;\n223\t    ctx.fillRect(0, 0, w, h);\n224\t\n225\t    ctx.save();\n226\t    ctx.globalAlpha = 0.05;\n227\t    for (let i = 0; i < 5; i++) {\n228\t      const cx = w * 0.3 + Math.sin(i * 1.7) * w * 0.2;\n229\t      const cy = h * 0.4 + Math.cos(i * 2.3) * h * 0.15;\n230\t      const r = 80 + i * 30;\n231\t      const g2 = ctx.createRadialGradient(cx, cy, 0, cx, cy, r);\n232\t      g2.addColorStop(0, '#8b0000');\n233\t      g2.addColorStop(1, 'transparent');\n234\t      ctx.fillStyle = g2;\n235\t      ctx.fillRect(0, 0, w, h);\n236\t    }\n237\t    ctx.restore();\n238\t\n239\t    this.renderer.drawText('长 安 诡 案 录', w / 2, h * 0.22, {\n240\t      font: 'bold 64px \"SimSun\", \"Noto Serif SC\", serif',\n241\t      color: '#c8a882',\n242\t      align: 'center',\n243\t    });\n244\t    this.renderer.drawText('Records of Chang\\'an Anomalies', w / 2, h * 0.32, {\n245\t      font: '20px \"Georgia\", serif',\n246\t      color: '#8a7a6a',\n247\t      align: 'center',\n248\t    });\n249\t\n250\t    ctx.strokeStyle = '#4a3020';\n251\t    ctx.lineWidth = 1;\n252\t    ctx.beginPath();\n253\t    ctx.moveTo(w * 0.3, h * 0.40);\n254\t    ctx.lineTo(w * 0.7, h * 0.40);\n255\t    ctx.stroke();\n256\t\n257\t    this.menuItems.forEach((item, i) => {\n258\t      const y = h * 0.50 + i * 60;\n259\t      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, w * 0.35, y - 20, w * 0.3, 45);\n260\t      const color = isHover ? '#e8c8a2' : '#a08870';\n261\t\n262\t      if (isHover) {\n263\t        ctx.save();\n264\t        ctx.globalAlpha = 0.15;\n265\t        ctx.fillStyle = '#4a3020';\n266\t        ctx.fillRect(w * 0.35, y - 20, w * 0.3, 45);\n267\t        ctx.restore();\n268\t      }\n269\t\n270\t      this.renderer.drawText(item.label, w / 2, y, {\n271\t        font: '28px \"SimSun\", \"Noto Serif SC\", serif',\n272\t        color,\n273\t        align: 'center',\n274\t      });\n275\t    });\n276\t\n277\t    this.renderer.drawText('v0.3.0 - M3 推理+庭审系统', w / 2, h * 0.92, {\n278\t      font: '14px sans-serif', color: '#4a3a2a', align: 'center',\n279\t    });\n280\t  }\n281\t\n282\t  private handleMenuClick(x: number, y: number) {\n283\t    const w = this.renderer.w;\n284\t    const h = this.renderer.h;\n285\t    this.menuItems.forEach((item, i) => {\n286\t      const iy = h * 0.50 + i * 60;\n287\t      if (this.isInRect(x, y, w * 0.35, iy - 20, w * 0.3, 45)) {\n288\t        item.action();\n289\t      }\n290\t    });\n291\t  }\n292\t\n293\t  // ── Dialogue UI ──\n294\t\n295\t  private startGame() {\n296\t    this.showScreen('dialogue');\n297\t    this.sceneManager.switchTo('county_office', true);\n298\t    this.dialogueEngine.start('intro_1', () => {\n299\t      this.showScreen('game');\n300\t    });\n301\t  }\n302\t\n303\t  private renderDialogueUI() {\n304\t    this.renderGameHUD();\n305\t    if (!this.dialogueEngine.getIsActive()) return;\n306\t\n307\t    const ctx = this.renderer.context;\n308\t    const w = this.renderer.w;\n309\t    const h = this.renderer.h;\n310\t    const boxH = 200;\n311\t    const boxY = h - boxH - 20;\n312\t    const boxX = 40;\n313\t    const boxW = w - 80;\n314\t\n315\t    ctx.save();\n316\t    ctx.globalAlpha = 0.92;\n317\t    this.renderer.drawRoundRect(boxX, boxY, boxW, boxH, 8, '#1a140e', '#3a2a1a');\n318\t    ctx.restore();\n319\t\n320\t    ctx.strokeStyle = '#5a4030';\n321\t    ctx.lineWidth = 2;\n322\t    ctx.beginPath();\n323\t    const m = 6;\n324\t    ctx.roundRect(boxX + m, boxY + m, boxW - m * 2, boxH - m * 2, 4);\n325\t    ctx.stroke();\n326\t\n327\t    const speaker = this.dialogueEngine.getSpeaker();\n328\t    if (speaker) {\n329\t      const spW = ctx.measureText(speaker).width || speaker.length * 28;\n330\t      this.renderer.drawRoundRect(boxX + 20, boxY - 18, spW + 40, 36, 6, '#2a1a0e', '#5a4030');\n331\t      this.renderer.drawText(speaker, boxX + 40, boxY - 10, {\n332\t        font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2',\n333\t      });\n334\t    }\n335\t\n336\t    const text = this.dialogueEngine.getDisplayText();\n337\t    this.renderWrappedText(text, boxX + 30, boxY + 30, boxW - 60, boxH - 60, {\n338\t      font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0',\n339\t    });\n340\t\n341\t    if (!this.dialogueEngine.getIsTyping()) {\n342\t      const choices = this.dialogueEngine.getChoices();\n343\t      if (choices.length > 0) {\n344\t        choices.forEach((c, i) => {\n345\t          const cy = boxY + boxH + 15 + i * 48;\n346\t          const cx = boxX + 30;\n347\t          const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, cx, cy - 5, boxW - 60, 38);\n348\t\n349\t          if (isHover) {\n350\t            ctx.save();\n351\t            ctx.globalAlpha = 0.3;\n352\t            this.renderer.drawRoundRect(cx, cy - 5, boxW - 60, 38, 4, '#3a2a1a');\n353\t            ctx.restore();\n354\t          }\n355\t\n356\t          this.renderer.drawText(`▸ ${c.text}`, cx + 10, cy + 3, {\n357\t            font: '20px \"SimSun\", \"Noto Serif SC\", serif',\n358\t            color: isHover ? '#f0d8b0' : '#b8a890',\n359\t          });\n360\t        });\n361\t      } else {\n362\t        const blinkAlpha = 0.4 + Math.sin(Date.now() * 0.005) * 0.3;\n363\t        this.renderer.drawText('▼', boxX + boxW - 40, boxY + boxH - 40, {\n364\t          font: '18px sans-serif', color: '#8a7a6a', alpha: blinkAlpha,\n365\t        });\n366\t      }\n367\t    }\n368\t  }\n369\t\n370\t  private handleDialogueClick(x: number, y: number) {\n371\t    if (!this.dialogueEngine.getIsActive()) return;\n372\t    const w = this.renderer.w;\n373\t    const h = this.renderer.h;\n374\t    const boxH = 200;\n375\t    const boxY = h - boxH - 20;\n376\t    const boxX = 40;\n377\t    const boxW = w - 80;\n378\t\n379\t    if (this.dialogueEngine.getIsTyping()) {\n380\t      this.dialogueEngine.advance();\n381\t      return;\n382\t    }\n383\t\n384\t    const choices = this.dialogueEngine.getChoices();\n385\t    if (choices.length > 0) {\n386\t      choices.forEach((c, i) => {\n387\t        const cy = boxY + boxH + 15 + i * 48;\n388\t        if (this.isInRect(x, y, boxX + 30, cy - 5, boxW - 60, 38)) {\n389\t          this.dialogueEngine.selectChoice(i);\n390\t        }\n391\t      });\n392\t    } else {\n393\t      if (this.isInRect(x, y, boxX, boxY, boxW, boxH)) {\n394\t        this.dialogueEngine.advance();\n395\t      }\n396\t    }\n397\t  }\n398\t\n399\t  // ── Settings ──\n400\t\n401\t  private settingsItems = [\n402\t    { label: '文字速度', key: 'textSpeed', min: 10, max: 80 },\n403\t    { label: '主音量', key: 'master', min: 0, max: 100 },\n404\t    { label: '音乐音量', key: 'bgm', min: 0, max: 100 },\n405\t    { label: '音效音量', key: 'sfx', min: 0, max: 100 },\n406\t  ];\n407\t\n408\t  private renderSettings() {\n409\t    const ctx = this.renderer.context;\n410\t    const w = this.renderer.w;\n411\t    const h = this.renderer.h;\n412\t\n413\t    ctx.fillStyle = 'rgba(10, 8, 6, 0.95)';\n414\t    ctx.fillRect(0, 0, w, h);\n415\t\n416\t    this.renderer.drawText('设  置', w / 2, h * 0.12, {\n417\t      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif',\n418\t      color: '#c8a882', align: 'center',\n419\t    });\n420\t\n421\t    this.settingsItems.forEach((item, i) => {\n422\t      const y = h * 0.30 + i * 70;\n423\t      this.renderer.drawText(item.label, w * 0.25, y, {\n424\t        font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870',\n425\t      });\n426\t\n427\t      const barX = w * 0.45;\n428\t      const barW = w * 0.30;\n429\t      const barH = 8;\n430\t      ctx.fillStyle = '#2a1a0e';\n431\t      ctx.fillRect(barX, y + 8, barW, barH);\n432\t\n433\t      const val = item.key === 'textSpeed'\n434\t        ? (this.state.settings.textSpeed - item.min) / (item.max - item.min)\n435\t        : (this.state.settings.volume[item.key as keyof typeof this.state.settings.volume] ?? 0.8);\n436\t      ctx.fillStyle = '#8b4513';\n437\t      ctx.fillRect(barX, y + 8, barW * val, barH);\n438\t\n439\t      const knobX = barX + barW * val;\n440\t      ctx.fillStyle = '#c8a882';\n441\t      ctx.beginPath();\n442\t      ctx.arc(knobX, y + 12, 8, 0, Math.PI * 2);\n443\t      ctx.fill();\n444\t    });\n445\t\n446\t    this.renderBackButton(w, h);\n447\t  }\n448\t\n449\t  private handleSettingsClick(x: number, y: number) {\n450\t    const w = this.renderer.w;\n451\t    const h = this.renderer.h;\n452\t    if (this.isInRect(x, y, w * 0.35, h * 0.85, w * 0.3, 45)) {\n453\t      this.showScreen('main_menu');\n454\t    }\n455\t  }\n456\t\n457\t  // ── Save/Load ──\n458\t\n459\t  private renderSaveLoad() {\n460\t    const ctx = this.renderer.context;\n461\t    const w = this.renderer.w;\n462\t    const h = this.renderer.h;\n463\t\n464\t    ctx.fillStyle = 'rgba(10, 8, 6, 0.95)';\n465\t    ctx.fillRect(0, 0, w, h);\n466\t\n467\t    this.renderer.drawText('存  档', w / 2, h * 0.08, {\n468\t      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif',\n469\t      color: '#c8a882', align: 'center',\n470\t    });\n471\t\n472\t    for (let i = 0; i < 6; i++) {\n473\t      const col = i % 3;\n474\t      const row = Math.floor(i / 3);\n475\t      const sx = w * 0.12 + col * (w * 0.28);\n476\t      const sy = h * 0.18 + row * (h * 0.32);\n477\t      const sw = w * 0.25;\n478\t      const sh = h * 0.26;\n479\t\n480\t      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, sx, sy, sw, sh);\n481\t\n482\t      ctx.save();\n483\t      ctx.globalAlpha = isHover ? 0.9 : 0.7;\n484\t      this.renderer.drawRoundRect(sx, sy, sw, sh, 6, '#1a140e', isHover ? '#6a5040' : '#3a2a1a');\n485\t      ctx.restore();\n486\t\n487\t      this.renderer.drawText(`存档 ${i + 1}`, sx + 15, sy + 15, {\n488\t        font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870',\n489\t      });\n490\t      this.renderer.drawText('空', sx + sw / 2, sy + sh / 2 - 10, {\n491\t        font: '24px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n492\t      });\n493\t    }\n494\t\n495\t    this.renderBackButton(w, h);\n496\t  }\n497\t\n498\t  private handleSaveLoadClick(x: number, y: number) {\n499\t    const w = this.renderer.w;\n500\t    const h = this.renderer.h;\n501\t    if (this.isInRect(x, y, w * 0.35, h * 0.85, w * 0.3, 45)) {\n502\t      this.showScreen('main_menu');\n503\t    }\n504\t  }\n505\t\n506\t  // ── M2 Screens ──\n507\t\n508\t  private renderExploreScreen() {\n509\t    this.sceneExplorer.render();\n510\t    this.renderM2Toolbar();\n511\t  }\n512\t\n513\t  private handleExploreClick(x: number, y: number) {\n514\t    const w = this.renderer.w;\n515\t    const h = this.renderer.h;\n516\t    this.handleM2ToolbarClick(x, y);\n517\t  }\n518\t\n519\t  private renderInterrogationScreen() {\n520\t    this.interrogationSystem.render();\n521\t    this.renderM2Toolbar();\n522\t  }\n523\t\n524\t  private renderEvidenceScreen() {\n525\t    this.evidenceCollector.render();\n526\t  }\n527\t\n528\t  private renderCombineScreen() {\n529\t    this.evidenceCombiner.render();\n530\t  }\n531\t\n532\t  private renderReasoningScreen() {\n533\t    this.reasoningBoard.render();\n534\t    this.renderM3Toolbar();\n535\t  }\n536\t\n537\t  private renderTrialScreen() {\n538\t    this.trialLoop.render();\n539\t  }\n540\t\n541\t  private renderM2Toolbar() {\n542\t    const ctx = this.renderer.context;\n543\t    const w = this.renderer.w;\n544\t    const h = this.renderer.h;\n545\t\n546\t    const toolbarY = h - 60;\n547\t    ctx.save();\n548\t    ctx.globalAlpha = 0.85;\n549\t    ctx.fillStyle = '#0e0a08';\n550\t    ctx.fillRect(0, toolbarY, w, 60);\n551\t    ctx.strokeStyle = '#3a2a1a';\n552\t    ctx.lineWidth = 1;\n553\t    ctx.beginPath();\n554\t    ctx.moveTo(0, toolbarY);\n555\t    ctx.lineTo(w, toolbarY);\n556\t    ctx.stroke();\n557\t    ctx.restore();\n558\t\n559\t    const buttons = [\n560\t      { label: '探索', screen: 'explore' as UIScreen, x: w * 0.07 },\n561\t      { label: '审问', screen: 'interrogation' as UIScreen, x: w * 0.19 },\n562\t      { label: '物证', screen: 'evidence' as UIScreen, x: w * 0.31 },\n563\t      { label: '组合', screen: 'combine' as UIScreen, x: w * 0.43 },\n564\t      { label: '推理', screen: 'reasoning' as UIScreen, x: w * 0.57 },\n565\t      { label: '庭审', screen: 'trial' as UIScreen, x: w * 0.71 },\n566\t      { label: '返回', screen: 'game' as UIScreen, x: w * 0.89 },\n567\t    ];\n568\t\n569\t    buttons.forEach((btn) => {\n570\t      const isActive = this.currentScreen === btn.screen;\n571\t      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, btn.x - 35, toolbarY + 10, 70, 40);\n572\t\n573\t      if (isActive) {\n574\t        ctx.fillStyle = 'rgba(200, 168, 130, 0.15)';\n575\t        ctx.fillRect(btn.x - 35, toolbarY + 10, 70, 40);\n576\t      } else if (isHover) {\n577\t        ctx.fillStyle = 'rgba(200, 168, 130, 0.07)';\n578\t        ctx.fillRect(btn.x - 35, toolbarY + 10, 70, 40);\n579\t      }\n580\t\n581\t      const isM3 = btn.screen === 'reasoning' || btn.screen === 'trial';\n582\t      this.renderer.drawText(btn.label, btn.x, toolbarY + 20, {\n583\t        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n584\t        color: isActive ? '#e8c8a2' : isHover ? '#c8a882' : isM3 ? '#6a8ac8' : '#8a7a6a',\n585\t        align: 'center',\n586\t      });\n587\t    });\n588\t  }\n589\t\n590\t  private handleM2ToolbarClick(x: number, y: number) {\n591\t    const w = this.renderer.w;\n592\t    const h = this.renderer.h;\n593\t    const toolbarY = h - 60;\n594\t    if (y < toolbarY) return;\n595\t\n596\t    const buttons: { screen: UIScreen; x: number }[] = [\n597\t      { screen: 'explore', x: w * 0.07 },\n598\t      { screen: 'interrogation', x: w * 0.19 },\n599\t      { screen: 'evidence', x: w * 0.31 },\n600\t      { screen: 'combine', x: w * 0.43 },\n601\t      { screen: 'reasoning', x: w * 0.57 },\n602\t      { screen: 'trial', x: w * 0.71 },\n603\t      { screen: 'game', x: w * 0.89 },\n604\t    ];\n605\t\n606\t    for (const btn of buttons) {\n607\t      if (this.isInRect(x, y, btn.x - 35, toolbarY + 10, 70, 40)) {\n608\t        if (btn.screen === 'explore') {\n609\t          this.sceneExplorer.activate(this.state.scene);\n610\t        }\n611\t        if (btn.screen === 'interrogation') {\n612\t          const firstNPC = 'liu_qiniang';\n613\t          this.interrogationSystem.startInterrogation(firstNPC);\n614\t        }\n615\t        if (btn.screen === 'evidence') {\n616\t          this.evidenceCollector.open();\n617\t        }\n618\t        if (btn.screen === 'combine') {\n619\t          this.evidenceCombiner.open();\n620\t        }\n621\t        if (btn.screen === 'reasoning') {\n622\t          this.reasoningBoard.open();\n623\t        }\n624\t        if (btn.screen === 'trial') {\n625\t          this.startDemoTrial();\n626\t        }\n627\t        this.showScreen(btn.screen);\n628\t        return;\n629\t      }\n630\t    }\n631\t  }\n632\t\n633\t  private renderM3Toolbar() {\n634\t    this.renderM2Toolbar();\n635\t  }\n636\t\n637\t  // ── Game HUD ──\n638\t\n639\t  private renderGameHUD() {\n640\t    const ctx = this.renderer.context;\n641\t    const w = this.renderer.w;\n642\t    const h = this.renderer.h;\n643\t\n644\t    ctx.save();\n645\t    ctx.globalAlpha = 0.5;\n646\t    ctx.fillStyle = '#c8a882';\n647\t    ctx.font = '14px sans-serif';\n648\t    ctx.fillText(`第${this.state.chapter}章 | ${this.state.scene}`, 15, 20);\n649\t    ctx.restore();\n650\t\n651\t    this.renderM2Toolbar();\n652\t  }\n653\t\n654\t  // ── Helpers ──\n655\t\n656\t  private renderWrappedText(text: string, x: number, y: number, maxW: number, maxH: number,\n657\t    opts: { font?: string; color?: string }) {\n658\t    const ctx = this.renderer.context;\n659\t    ctx.save();\n660\t    ctx.font = opts.font ?? '20px \"SimSun\", \"Noto Serif SC\", serif';\n661\t    ctx.fillStyle = opts.color ?? '#d8c8b0';\n662\t\n663\t    let lineY = y;\n664\t    let line = '';\n665\t    for (const ch of text) {\n666\t      const test = line + ch;\n667\t      if (ctx.measureText(test).width > maxW) {\n668\t        ctx.fillText(line, x, lineY);\n669\t        line = ch;\n670\t        lineY += 28;\n671\t        if (lineY - y > maxH) break;\n672\t      } else {\n673\t        line = test;\n674\t      }\n675\t    }\n676\t    if (line) ctx.fillText(line, x, lineY);\n677\t    ctx.restore();\n678\t  }\n679\t\n680\t  private renderBackButton(w: number, h: number) {\n681\t    const bx = w * 0.35;\n682\t    const by = h * 0.85;\n683\t    const bw = w * 0.3;\n684\t    const bh = 45;\n685\t    const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, bx, by, bw, bh);\n686\t\n687\t    ctx: this.renderer.drawRoundRect(bx, by, bw, bh, 6,\n688\t      isHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n689\t    this.renderer.drawText('返回', w / 2, by + 12, {\n690\t      font: '24px \"SimSun\", \"Noto Serif SC\", serif',\n691\t      color: isHover ? '#e8c8a2' : '#a08870', align: 'center',\n692\t    });\n693\t  }\n694\t\n695\t  private showScreen(screen: UIScreen) { this.currentScreen = screen; }\n696\t\n697\t  private startDemoTrial() {\n698\t    this.trialLoop.startTrial({\n699\t      id: 'ch1_trial',\n700\t      chapter: 1,\n701\t      caseTitle: '鬼市浮尸案',\n702\t      plaintiffName: '万年县衙',\n703\t      defendantName: '马大通（西域胡商）',\n704\t      judgeName: '裴如意',\n705\t      correctVerdict: 'guilty',\n706\t      witnesses: [\n707\t        {\n708\t          id: 'w_liu',\n709\t          name: '刘七娘',\n710\t          testimonyLines: [\n711\t            { id: 'tl_liu_1', speaker: '刘七娘', text: '那天晚上我在坊里睡觉，什么也不知道。', isLie: true, contradictEvidence: 'night_watch_log' },\n712\t            { id: 'tl_liu_2', speaker: '刘七娘', text: '我听到了一些奇怪的响动，像是有人在搬东西。', isLie: false },\n713\t            { id: 'tl_liu_3', speaker: '刘七娘', text: '我在地上看到了一枚碎玉佩，就捡了起来。', isLie: false },\n714\t          ],\n715\t        },\n716\t        {\n717\t          id: 'w_zhang',\n718\t          name: '张铁手',\n719\t          testimonyLines: [\n720\t            { id: 'tl_zhang_1', speaker: '张铁手', text: '当夜我在东市巡逻，未发现异常。', isLie: false },\n721\t            { id: 'tl_zhang_2', speaker: '张铁手', text: '巡夜记录上记载子时三刻有人影出没。', isLie: false },\n722\t            { id: 'tl_zhang_3', speaker: '张铁手', text: '那个可疑人影穿的是普通百姓衣服。', isLie: true, contradictEvidence: 'blood_cloth' },\n723\t          ],\n724\t        },\n725\t      ],\n726\t    });\n727\t  }\n728\t\n729\t  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n730\t    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n731\t  }\n732\t}\n733\t"}]},"parent_tool_use_id":null,"session_id":"60e8bd2a-b118-4ebb-8072-7fe7ed523870","uuid":"5a3ee824-1749-44cc-91f3-50387aabdaee","timestamp":"2026-05-23T17:49:36.532Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-ancient-mystery\\src\\renderer\\UI\\UIManager.ts","content":"import { Renderer } from '../Renderer';\nimport { SceneManager } from '../../game/SceneManager';\nimport { DialogueEngine } from '../../game/DialogueEngine';\nimport { GameState } from '../../game/GameState';\nimport { InputManager } from '../../game/InputManager';\nimport { SceneExplorer, Hotspot, ExploreScene } from '../../game/SceneExplorer';\nimport { EvidenceCollector, EvidenceItem } from '../../game/EvidenceCollector';\nimport { InterrogationSystem, InterrogationNPC, InterrogationTopic } from '../../game/InterrogationSystem';\nimport { EvidenceCombiner, CombinationRecipe } from '../../game/EvidenceCombiner';\nimport { ReasoningBoard, ReasoningNode, ReasoningLink, ReasoningHypothesis } from '../../game/ReasoningBoard';\nimport { TrialLoop, TrialConfig } from '../../game/TrialLoop';\n\nexport type UIScreen = 'main_menu' | 'game' | 'settings' | 'save_load' | 'dialogue' | 'explore' | 'interrogation' | 'evidence' | 'combine' | 'reasoning' | 'trial';\n\nexport class UIManager {\n  private currentScreen: UIScreen = 'main_menu';\n  private screenAlpha = 1;\n  private hoverIndex = -1;\n  private sceneExplorer: SceneExplorer;\n  private evidenceCollector: EvidenceCollector;\n  private interrogationSystem: InterrogationSystem;\n  private evidenceCombiner: EvidenceCombiner;\n  private reasoningBoard: ReasoningBoard;\n  private trialLoop: TrialLoop;\n\n  constructor(\n    private renderer: Renderer,\n    private sceneManager: SceneManager,\n    private dialogueEngine: DialogueEngine,\n    private state: GameState,\n    private input: InputManager\n  ) {\n    this.sceneExplorer = new SceneExplorer(renderer, state, input);\n    this.evidenceCollector = new EvidenceCollector(renderer, state, input);\n    this.interrogationSystem = new InterrogationSystem(renderer, state, dialogueEngine, input);\n    this.evidenceCombiner = new EvidenceCombiner(renderer, state, input, this.evidenceCollector);\n    this.reasoningBoard = new ReasoningBoard(renderer, state, input);\n    this.trialLoop = new TrialLoop(renderer, state, input);\n\n    this.setupInput();\n    this.loadDemoDialogue();\n    this.loadDemoM2Data();\n    this.loadDemoM3Data();\n  }\n\n  private loadDemoDialogue() {\n    this.dialogueEngine.loadDialogue([\n      { id: 'intro_1', speaker: '旁白', text: '天宝元年，长安。', next: 'intro_2' },\n      { id: 'intro_2', speaker: '旁白', text: '你是新任万年县推官沈鹤年，今日初到衙门赴任。', next: 'intro_3' },\n      { id: 'intro_3', speaker: '裴如意', text: '你就是新来的推官？看起来很年轻嘛。', portrait: 'pei_ruyi', next: 'intro_4' },\n      {\n        id: 'intro_4', speaker: '沈鹤年', text: '',\n        choices: [\n          { text: '下官沈鹤年，参见县令大人。', next: 'intro_5a' },\n          { text: '年龄不代表能力，大人。', next: 'intro_5b' },\n        ],\n      },\n      { id: 'intro_5a', speaker: '裴如意', text: '嗯，懂规矩。正好，东市出了个案子，你跟我去看看。', portrait: 'pei_ruyi',\n        effects: { relationship: { npc: 'pei_ruyi', delta: 5 } } },\n      { id: 'intro_5b', speaker: '裴如意', text: '哈，有点意思。不过在这里，规矩比能力重要。跟我来吧。', portrait: 'pei_ruyi',\n        effects: { relationship: { npc: 'pei_ruyi', delta: -3 } } },\n      // M2 interrogation dialogue\n      { id: 'interrog_liu_1', speaker: '刘七娘', text: '你问我那天晚上在哪？我...我在坊里待着呢。' },\n      { id: 'interrog_liu_2', speaker: '刘七娘', text: '好吧...我确实去了东市，但什么也没看到！' },\n      { id: 'interrog_liu_3', speaker: '刘七娘', text: '你、你怎么会有这个...好吧，我说实话。那天晚上...' },\n      { id: 'interrog_zhang_1', speaker: '张铁手', text: '哼，推官大人有什么事？' },\n      { id: 'interrog_zhang_2', speaker: '张铁手', text: '这件事...我知道一些，但不一定跟你说。' },\n    ]);\n  }\n\n  private loadDemoM2Data() {\n    // Evidence items\n    this.evidenceCollector.registerEvidence([\n      { id: 'broken_jade', name: '碎玉佩', description: '在东市废墟中发现的一块碎玉佩，上面刻有\"裴\"字。', category: 'key', discoveredAt: 'east_market_ruins', discoveredTime: Date.now(), combinable: ['blood_cloth'] },\n      { id: 'blood_cloth', name: '血衣碎片', description: '沾有暗色血迹的布料，质地似官服。', category: 'key', discoveredAt: 'east_market_ruins', discoveredTime: Date.now(), combinable: ['broken_jade'] },\n      { id: 'night_watch_log', name: '巡夜记录', description: '当夜的巡夜记录，记载了可疑人影的出没时间。', category: 'normal', discoveredAt: 'county_office', discoveredTime: Date.now() },\n      { id: 'fake_seal', name: '伪造印信', description: '一枚做工粗糙的伪造官印。', category: 'misleading', discoveredAt: 'west_market', discoveredTime: Date.now() },\n    ]);\n\n    // Scene explorer hotspots\n    this.sceneExplorer.registerScene({\n      sceneId: 'east_market_ruins',\n      hotspots: [\n        { id: 'hs_jade', x: 200, y: 150, w: 80, h: 60, label: '碎玉佩', examined: false, action: 'pickup', giveEvidence: 'broken_jade' },\n        { id: 'hs_cloth', x: 500, y: 300, w: 100, h: 70, label: '血衣碎片', examined: false, action: 'pickup', giveEvidence: 'blood_cloth' },\n        { id: 'hs_door', x: 800, y: 200, w: 60, h: 120, label: '破旧的门', examined: false, action: 'examine' },\n        { id: 'hs_wall', x: 100, y: 400, w: 200, h: 80, label: '残墙上的字迹', examined: false, action: 'examine' },\n      ],\n    });\n\n    this.sceneExplorer.registerScene({\n      sceneId: 'county_office',\n      hotspots: [\n        { id: 'hs_desk', x: 400, y: 200, w: 150, h: 100, label: '县令书案', examined: false, action: 'examine' },\n        { id: 'hs_log', x: 600, y: 350, w: 80, h: 50, label: '巡夜记录', examined: false, action: 'pickup', giveEvidence: 'night_watch_log' },\n      ],\n    });\n\n    // Interrogation NPCs\n    this.interrogationSystem.registerNPC({ id: 'liu_qiniang', name: '刘七娘', defaultPressure: 20, maxPressure: 100 });\n    this.interrogationSystem.registerNPC({ id: 'zhang_tieshou', name: '张铁手', defaultPressure: 35, maxPressure: 100 });\n\n    this.interrogationSystem.registerTopics([\n      { id: 't_liu_1', npcId: 'liu_qiniang', label: '案发当晚行踪', dialogueId: 'interrog_liu_1', repeatable: false },\n      { id: 't_liu_2', npcId: 'liu_qiniang', label: '东市见闻', dialogueId: 'interrog_liu_2', repeatable: false, pressureRange: { min: 30, max: 100 } },\n      { id: 't_liu_3', npcId: 'liu_qiniang', label: '关于碎玉佩', dialogueId: 'interrog_liu_3', repeatable: false, requiresEvidence: ['broken_jade'] },\n      { id: 't_zhang_1', npcId: 'zhang_tieshou', label: '当晚巡逻情况', dialogueId: 'interrog_zhang_1', repeatable: false },\n      { id: 't_zhang_2', npcId: 'zhang_tieshou', label: '可疑人物', dialogueId: 'interrog_zhang_2', repeatable: false, requiresEvidence: ['night_watch_log'] },\n    ]);\n\n    // Combination recipes\n    this.evidenceCombiner.registerRecipes([\n      { id: 'recipe_1', inputs: ['broken_jade', 'blood_cloth'], output: 'jade_cloth_bundle', outputName: '玉佩与血衣', outputDescription: '碎玉佩与血衣碎片放在一起，血迹的位置恰好对应玉佩上的裂纹——这是案发现场的关键关联。', outputCategory: 'key' },\n    ]);\n\n    // Hotspot action callback\n    this.sceneExplorer.setActionCallback((hs) => {\n      if (hs.action === 'talk' && hs.dialogueId) {\n        this.dialogueEngine.start(hs.dialogueId);\n      }\n    });\n  }\n\n  private loadDemoM3Data() {\n    // Reasoning board nodes\n    this.reasoningBoard.registerNodes([\n      { id: 'rn_broken_jade', label: '碎玉佩', type: 'evidence', x: 200, y: 150, unlocked: true, description: '东市废墟中发现的碎玉佩，刻有\"裴\"字' },\n      { id: 'rn_blood_cloth', label: '血衣碎片', type: 'evidence', x: 400, y: 120, unlocked: true, description: '沾有血迹的官服布料' },\n      { id: 'rn_night_watch', label: '巡夜记录', type: 'document', x: 300, y: 300, unlocked: true, description: '当夜巡夜记录，记载了可疑人影' },\n      { id: 'rn_liu_testimony', label: '刘七娘证词', type: 'testimony', x: 500, y: 280, unlocked: true, description: '刘七娘声称当晚在坊内，但实去了东市' },\n      { id: 'rn_fake_seal', label: '伪造印信', type: 'evidence', x: 150, y: 350, unlocked: true, description: '做工粗糙的伪造官印' },\n      { id: 'rn_jade_cloth', label: '玉佩与血衣', type: 'inference', x: 350, y: 200, unlocked: false, description: '血迹对应玉佩裂纹——关键关联' },\n    ]);\n\n    this.reasoningBoard.registerLinks([\n      { from: 'rn_broken_jade', to: 'rn_blood_cloth', label: '关联', valid: true },\n      { from: 'rn_blood_cloth', to: 'rn_night_watch', label: '时间关联', valid: true },\n      { from: 'rn_liu_testimony', to: 'rn_night_watch', label: '矛盾', valid: true },\n      { from: 'rn_broken_jade', to: 'rn_jade_cloth', label: '组合', valid: true, requiresEvidence: ['jade_cloth_bundle'] },\n    ]);\n\n    this.reasoningBoard.registerHypothesis({\n      id: 'hyp_1',\n      text: '碎玉佩与血衣是同一案件的关键物证',\n      requiredLinks: ['rn_broken_jade', 'rn_blood_cloth'],\n      validated: false,\n    });\n\n    // Trial demo config\n    this.reasoningBoard.setHypothesisCallback((h) => {\n      this.state.setFlag(`hypothesis_${h.id}`, true);\n    });\n  }\n\n  private setupInput() {\n    this.input.onClick((e) => {\n      if (e.type !== 'up') return;\n      this.handleClick(e.x, e.y);\n    });\n  }\n\n  private handleClick(x: number, y: number) {\n    switch (this.currentScreen) {\n      case 'main_menu': this.handleMenuClick(x, y); break;\n      case 'dialogue': this.handleDialogueClick(x, y); break;\n      case 'settings': this.handleSettingsClick(x, y); break;\n      case 'save_load': this.handleSaveLoadClick(x, y); break;\n      case 'explore': this.handleExploreClick(x, y); break;\n      case 'interrogation': break;\n      case 'evidence': break;\n      case 'combine': break;\n      case 'reasoning': break;\n      case 'trial': break;\n    }\n  }\n\n  resize(w: number, h: number) {}\n\n  update(dt: number) {\n    this.state.playTime += dt;\n    this.sceneExplorer.update(dt);\n    this.evidenceCollector.update(dt);\n    this.interrogationSystem.update(dt);\n    this.evidenceCombiner.update(dt);\n    this.reasoningBoard.update(dt);\n    this.trialLoop.update(dt);\n  }\n\n  render() {\n    switch (this.currentScreen) {\n      case 'main_menu': this.renderMainMenu(); break;\n      case 'game': this.renderGameHUD(); break;\n      case 'dialogue': this.renderDialogueUI(); break;\n      case 'settings': this.renderSettings(); break;\n      case 'save_load': this.renderSaveLoad(); break;\n      case 'explore': this.renderExploreScreen(); break;\n      case 'interrogation': this.renderInterrogationScreen(); break;\n      case 'evidence': this.renderEvidenceScreen(); break;\n      case 'combine': this.renderCombineScreen(); break;\n      case 'reasoning': this.renderReasoningScreen(); break;\n      case 'trial': this.renderTrialScreen(); break;\n    }\n  }\n\n  // ── Main Menu ──\n\n  private menuItems = [\n    { label: '开始游戏', action: () => this.startGame() },\n    { label: '继续游戏', action: () => this.showScreen('save_load') },\n    { label: '设置', action: () => this.showScreen('settings') },\n  ];\n\n  private renderMainMenu() {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0, '#0d0808');\n    grad.addColorStop(0.5, '#1a0a0a');\n    grad.addColorStop(1, '#0d0808');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n\n    ctx.save();\n    ctx.globalAlpha = 0.05;\n    for (let i = 0; i < 5; i++) {\n      const cx = w * 0.3 + Math.sin(i * 1.7) * w * 0.2;\n      const cy = h * 0.4 + Math.cos(i * 2.3) * h * 0.15;\n      const r = 80 + i * 30;\n      const g2 = ctx.createRadialGradient(cx, cy, 0, cx, cy, r);\n      g2.addColorStop(0, '#8b0000');\n      g2.addColorStop(1, 'transparent');\n      ctx.fillStyle = g2;\n      ctx.fillRect(0, 0, w, h);\n    }\n    ctx.restore();\n\n    this.renderer.drawText('长 安 诡 案 录', w / 2, h * 0.22, {\n      font: 'bold 64px \"SimSun\", \"Noto Serif SC\", serif',\n      color: '#c8a882',\n      align: 'center',\n    });\n    this.renderer.drawText('Records of Chang\\'an Anomalies', w / 2, h * 0.32, {\n      font: '20px \"Georgia\", serif',\n      color: '#8a7a6a',\n      align: 'center',\n    });\n\n    ctx.strokeStyle = '#4a3020';\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    ctx.moveTo(w * 0.3, h * 0.40);\n    ctx.lineTo(w * 0.7, h * 0.40);\n    ctx.stroke();\n\n    this.menuItems.forEach((item, i) => {\n      const y = h * 0.50 + i * 60;\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, w * 0.35, y - 20, w * 0.3, 45);\n      const color = isHover ? '#e8c8a2' : '#a08870';\n\n      if (isHover) {\n        ctx.save();\n        ctx.globalAlpha = 0.15;\n        ctx.fillStyle = '#4a3020';\n        ctx.fillRect(w * 0.35, y - 20, w * 0.3, 45);\n        ctx.restore();\n      }\n\n      this.renderer.drawText(item.label, w / 2, y, {\n        font: '28px \"SimSun\", \"Noto Serif SC\", serif',\n        color,\n        align: 'center',\n      });\n    });\n\n    this.renderer.drawText('v0.3.0 - M3 推理+庭审系统', w / 2, h * 0.92, {\n      font: '14px sans-serif', color: '#4a3a2a', align: 'center',\n    });\n  }\n\n  private handleMenuClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    this.menuItems.forEach((item, i) => {\n      const iy = h * 0.50 + i * 60;\n      if (this.isInRect(x, y, w * 0.35, iy - 20, w * 0.3, 45)) {\n        item.action();\n      }\n    });\n  }\n\n  // ── Dialogue UI ──\n\n  private startGame() {\n    this.showScreen('dialogue');\n    this.sceneManager.switchTo('county_office', true);\n    this.dialogueEngine.start('intro_1', () => {\n      this.showScreen('game');\n    });\n  }\n\n  private renderDialogueUI() {\n    this.renderGameHUD();\n    if (!this.dialogueEngine.getIsActive()) return;\n\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    const boxH = 200;\n    const boxY = h - boxH - 20;\n    const boxX = 40;\n    const boxW = w - 80;\n\n    ctx.save();\n    ctx.globalAlpha = 0.92;\n    this.renderer.drawRoundRect(boxX, boxY, boxW, boxH, 8, '#1a140e', '#3a2a1a');\n    ctx.restore();\n\n    ctx.strokeStyle = '#5a4030';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    const m = 6;\n    ctx.roundRect(boxX + m, boxY + m, boxW - m * 2, boxH - m * 2, 4);\n    ctx.stroke();\n\n    const speaker = this.dialogueEngine.getSpeaker();\n    if (speaker) {\n      const spW = ctx.measureText(speaker).width || speaker.length * 28;\n      this.renderer.drawRoundRect(boxX + 20, boxY - 18, spW + 40, 36, 6, '#2a1a0e', '#5a4030');\n      this.renderer.drawText(speaker, boxX + 40, boxY - 10, {\n        font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2',\n      });\n    }\n\n    const text = this.dialogueEngine.getDisplayText();\n    this.renderWrappedText(text, boxX + 30, boxY + 30, boxW - 60, boxH - 60, {\n      font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0',\n    });\n\n    if (!this.dialogueEngine.getIsTyping()) {\n      const choices = this.dialogueEngine.getChoices();\n      if (choices.length > 0) {\n        choices.forEach((c, i) => {\n          const cy = boxY + boxH + 15 + i * 48;\n          const cx = boxX + 30;\n          const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, cx, cy - 5, boxW - 60, 38);\n\n          if (isHover) {\n            ctx.save();\n            ctx.globalAlpha = 0.3;\n            this.renderer.drawRoundRect(cx, cy - 5, boxW - 60, 38, 4, '#3a2a1a');\n            ctx.restore();\n          }\n\n          this.renderer.drawText(`▸ ${c.text}`, cx + 10, cy + 3, {\n            font: '20px \"SimSun\", \"Noto Serif SC\", serif',\n            color: isHover ? '#f0d8b0' : '#b8a890',\n          });\n        });\n      } else {\n        const blinkAlpha = 0.4 + Math.sin(Date.now() * 0.005) * 0.3;\n        this.renderer.drawText('▼', boxX + boxW - 40, boxY + boxH - 40, {\n          font: '18px sans-serif', color: '#8a7a6a', alpha: blinkAlpha,\n        });\n      }\n    }\n  }\n\n  private handleDialogueClick(x: number, y: number) {\n    if (!this.dialogueEngine.getIsActive()) return;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    const boxH = 200;\n    const boxY = h - boxH - 20;\n    const boxX = 40;\n    const boxW = w - 80;\n\n    if (this.dialogueEngine.getIsTyping()) {\n      this.dialogueEngine.advance();\n      return;\n    }\n\n    const choices = this.dialogueEngine.getChoices();\n    if (choices.length > 0) {\n      choices.forEach((c, i) => {\n        const cy = boxY + boxH + 15 + i * 48;\n        if (this.isInRect(x, y, boxX + 30, cy - 5, boxW - 60, 38)) {\n          this.dialogueEngine.selectChoice(i);\n        }\n      });\n    } else {\n      if (this.isInRect(x, y, boxX, boxY, boxW, boxH)) {\n        this.dialogueEngine.advance();\n      }\n    }\n  }\n\n  // ── Settings ──\n\n  private settingsItems = [\n    { label: '文字速度', key: 'textSpeed', min: 10, max: 80 },\n    { label: '主音量', key: 'master', min: 0, max: 100 },\n    { label: '音乐音量', key: 'bgm', min: 0, max: 100 },\n    { label: '音效音量', key: 'sfx', min: 0, max: 100 },\n  ];\n\n  private renderSettings() {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.fillStyle = 'rgba(10, 8, 6, 0.95)';\n    ctx.fillRect(0, 0, w, h);\n\n    this.renderer.drawText('设  置', w / 2, h * 0.12, {\n      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif',\n      color: '#c8a882', align: 'center',\n    });\n\n    this.settingsItems.forEach((item, i) => {\n      const y = h * 0.30 + i * 70;\n      this.renderer.drawText(item.label, w * 0.25, y, {\n        font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870',\n      });\n\n      const barX = w * 0.45;\n      const barW = w * 0.30;\n      const barH = 8;\n      ctx.fillStyle = '#2a1a0e';\n      ctx.fillRect(barX, y + 8, barW, barH);\n\n      const val = item.key === 'textSpeed'\n        ? (this.state.settings.textSpeed - item.min) / (item.max - item.min)\n        : (this.state.settings.volume[item.key as keyof typeof this.state.settings.volume] ?? 0.8);\n      ctx.fillStyle = '#8b4513';\n      ctx.fillRect(barX, y + 8, barW * val, barH);\n\n      const knobX = barX + barW * val;\n      ctx.fillStyle = '#c8a882';\n      ctx.beginPath();\n      ctx.arc(knobX, y + 12, 8, 0, Math.PI * 2);\n      ctx.fill();\n    });\n\n    this.renderBackButton(w, h);\n  }\n\n  private handleSettingsClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    if (this.isInRect(x, y, w * 0.35, h * 0.85, w * 0.3, 45)) {\n      this.showScreen('main_menu');\n    }\n  }\n\n  // ── Save/Load ──\n\n  private renderSaveLoad() {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.fillStyle = 'rgba(10, 8, 6, 0.95)';\n    ctx.fillRect(0, 0, w, h);\n\n    this.renderer.drawText('存  档', w / 2, h * 0.08, {\n      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif',\n      color: '#c8a882', align: 'center',\n    });\n\n    for (let i = 0; i < 6; i++) {\n      const col = i % 3;\n      const row = Math.floor(i / 3);\n      const sx = w * 0.12 + col * (w * 0.28);\n      const sy = h * 0.18 + row * (h * 0.32);\n      const sw = w * 0.25;\n      const sh = h * 0.26;\n\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, sx, sy, sw, sh);\n\n      ctx.save();\n      ctx.globalAlpha = isHover ? 0.9 : 0.7;\n      this.renderer.drawRoundRect(sx, sy, sw, sh, 6, '#1a140e', isHover ? '#6a5040' : '#3a2a1a');\n      ctx.restore();\n\n      this.renderer.drawText(`存档 ${i + 1}`, sx + 15, sy + 15, {\n        font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870',\n      });\n      this.renderer.drawText('空', sx + sw / 2, sy + sh / 2 - 10, {\n        font: '24px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n      });\n    }\n\n    this.renderBackButton(w, h);\n  }\n\n  private handleSaveLoadClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    if (this.isInRect(x, y, w * 0.35, h * 0.85, w * 0.3, 45)) {\n      this.showScreen('main_menu');\n    }\n  }\n\n  // ── M2 Screens ──\n\n  private renderExploreScreen() {\n    this.sceneExplorer.render();\n    this.renderM2Toolbar();\n  }\n\n  private handleExploreClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    this.handleM2ToolbarClick(x, y);\n  }\n\n  private renderInterrogationScreen() {\n    this.interrogationSystem.render();\n    this.renderM2Toolbar();\n  }\n\n  private renderEvidenceScreen() {\n    this.evidenceCollector.render();\n  }\n\n  private renderCombineScreen() {\n    this.evidenceCombiner.render();\n  }\n\n  private renderReasoningScreen() {\n    this.reasoningBoard.render();\n    this.renderM3Toolbar();\n  }\n\n  private renderTrialScreen() {\n    this.trialLoop.render();\n  }\n\n  private renderM2Toolbar() {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    const toolbarY = h - 60;\n    ctx.save();\n    ctx.globalAlpha = 0.85;\n    ctx.fillStyle = '#0e0a08';\n    ctx.fillRect(0, toolbarY, w, 60);\n    ctx.strokeStyle = '#3a2a1a';\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    ctx.moveTo(0, toolbarY);\n    ctx.lineTo(w, toolbarY);\n    ctx.stroke();\n    ctx.restore();\n\n    const buttons = [\n      { label: '探索', screen: 'explore' as UIScreen, x: w * 0.07 },\n      { label: '审问', screen: 'interrogation' as UIScreen, x: w * 0.19 },\n      { label: '物证', screen: 'evidence' as UIScreen, x: w * 0.31 },\n      { label: '组合', screen: 'combine' as UIScreen, x: w * 0.43 },\n      { label: '推理', screen: 'reasoning' as UIScreen, x: w * 0.57 },\n      { label: '庭审', screen: 'trial' as UIScreen, x: w * 0.71 },\n      { label: '返回', screen: 'game' as UIScreen, x: w * 0.89 },\n    ];\n\n    buttons.forEach((btn) => {\n      const isActive = this.currentScreen === btn.screen;\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, btn.x - 35, toolbarY + 10, 70, 40);\n\n      if (isActive) {\n        ctx.fillStyle = 'rgba(200, 168, 130, 0.15)';\n        ctx.fillRect(btn.x - 35, toolbarY + 10, 70, 40);\n      } else if (isHover) {\n        ctx.fillStyle = 'rgba(200, 168, 130, 0.07)';\n        ctx.fillRect(btn.x - 35, toolbarY + 10, 70, 40);\n      }\n\n      const isM3 = btn.screen === 'reasoning' || btn.screen === 'trial';\n      this.renderer.drawText(btn.label, btn.x, toolbarY + 20, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n        color: isActive ? '#e8c8a2' : isHover ? '#c8a882' : isM3 ? '#6a8ac8' : '#8a7a6a',\n        align: 'center',\n      });\n    });\n  }\n\n  private handleM2ToolbarClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    const toolbarY = h - 60;\n    if (y < toolbarY) return;\n\n    const buttons: { screen: UIScreen; x: number }[] = [\n      { screen: 'explore', x: w * 0.07 },\n      { screen: 'interrogation', x: w * 0.19 },\n      { screen: 'evidence', x: w * 0.31 },\n      { screen: 'combine', x: w * 0.43 },\n      { screen: 'reasoning', x: w * 0.57 },\n      { screen: 'trial', x: w * 0.71 },\n      { screen: 'game', x: w * 0.89 },\n    ];\n\n    for (const btn of buttons) {\n      if (this.isInRect(x, y, btn.x - 35, toolbarY + 10, 70, 40)) {\n        if (btn.screen === 'explore') {\n          this.sceneExplorer.activate(this.state.scene);\n        }\n        if (btn.screen === 'interrogation') {\n          const firstNPC = 'liu_qiniang';\n          this.interrogationSystem.startInterrogation(firstNPC);\n        }\n        if (btn.screen === 'evidence') {\n          this.evidenceCollector.open();\n        }\n        if (btn.screen === 'combine') {\n          this.evidenceCombiner.open();\n        }\n        if (btn.screen === 'reasoning') {\n          this.reasoningBoard.open();\n        }\n        if (btn.screen === 'trial') {\n          this.startDemoTrial();\n        }\n        this.showScreen(btn.screen);\n        return;\n      }\n    }\n  }\n\n  private renderM3Toolbar() {\n    this.renderM2Toolbar();\n  }\n\n  // ── Game HUD ──\n\n  private renderGameHUD() {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.save();\n    ctx.globalAlpha = 0.5;\n    ctx.fillStyle = '#c8a882';\n    ctx.font = '14px sans-serif';\n    ctx.fillText(`第${this.state.chapter}章 | ${this.state.scene}`, 15, 20);\n    ctx.restore();\n\n    this.renderM2Toolbar();\n  }\n\n  // ── Helpers ──\n\n  private renderWrappedText(text: string, x: number, y: number, maxW: number, maxH: number,\n    opts: { font?: string; color?: string }) {\n    const ctx = this.renderer.context;\n    ctx.save();\n    ctx.font = opts.font ?? '20px \"SimSun\", \"Noto Serif SC\", serif';\n    ctx.fillStyle = opts.color ?? '#d8c8b0';\n\n    let lineY = y;\n    let line = '';\n    for (const ch of text) {\n      const test = line + ch;\n      if (ctx.measureText(test).width > maxW) {\n        ctx.fillText(line, x, lineY);\n        line = ch;\n        lineY += 28;\n        if (lineY - y > maxH) break;\n      } else {\n        line = test;\n      }\n    }\n    if (line) ctx.fillText(line, x, lineY);\n    ctx.restore();\n  }\n\n  private renderBackButton(w: number, h: number) {\n    const bx = w * 0.35;\n    const by = h * 0.85;\n    const bw = w * 0.3;\n    const bh = 45;\n    const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, bx, by, bw, bh);\n\n    ctx: this.renderer.drawRoundRect(bx, by, bw, bh, 6,\n      isHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('返回', w / 2, by + 12, {\n      font: '24px \"SimSun\", \"Noto Serif SC\", serif',\n      color: isHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n  }\n\n  private showScreen(screen: UIScreen) { this.currentScreen = screen; }\n\n  private startDemoTrial() {\n    this.trialLoop.startTrial({\n      id: 'ch1_trial',\n      chapter: 1,\n      caseTitle: '鬼市浮尸案',\n      plaintiffName: '万年县衙',\n      defendantName: '马大通（西域胡商）',\n      judgeName: '裴如意',\n      correctVerdict: 'guilty',\n      witnesses: [\n        {\n          id: 'w_liu',\n          name: '刘七娘',\n          testimonyLines: [\n            { id: 'tl_liu_1', speaker: '刘七娘', text: '那天晚上我在坊里睡觉，什么也不知道。', isLie: true, contradictEvidence: 'night_watch_log' },\n            { id: 'tl_liu_2', speaker: '刘七娘', text: '我听到了一些奇怪的响动，像是有人在搬东西。', isLie: false },\n            { id: 'tl_liu_3', speaker: '刘七娘', text: '我在地上看到了一枚碎玉佩，就捡了起来。', isLie: false },\n          ],\n        },\n        {\n          id: 'w_zhang',\n          name: '张铁手',\n          testimonyLines: [\n            { id: 'tl_zhang_1', speaker: '张铁手', text: '当夜我在东市巡逻，未发现异常。', isLie: false },\n            { id: 'tl_zhang_2', speaker: '张铁手', text: '巡夜记录上记载子时三刻有人影出没。', isLie: false },\n            { id: 'tl_zhang_3', speaker: '张铁手', text: '那个可疑人影穿的是普通百姓衣服。', isLie: true, contradictEvidence: 'blood_cloth' },\n          ],\n        },\n      ],\n    });\n  }\n\n  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n  }\n}\n","numLines":733,"startLine":1,"totalLines":733}}}
