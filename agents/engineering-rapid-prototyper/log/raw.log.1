 '服务生态', '控制台'].includes(t));\n  });\n  console.log('All visible text:', JSON.stringify(allVisibleText, null, 2));\n\n  await context.close();\n  console.log('Done');\n})();\n","structuredPatch":[],"originalFile":null,"userModified":false}}
