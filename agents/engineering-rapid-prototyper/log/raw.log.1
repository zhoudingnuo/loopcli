{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_d48e46c08b23462c8157d891","type":"tool_result","content":"1\timport { Renderer } from '../renderer/Renderer';\n2\t\n3\tinterface InkParticle {\n4\t  x: number;\n5\t  y: number;\n6\t  radius: number;\n7\t  alpha: number;\n8\t  vx: number;\n9\t  vy: number;\n10\t  life: number;\n11\t  maxLife: number;\n12\t}\n13\t\n14\texport class InkRenderer {\n15\t  private particles: InkParticle[] = [];\n16\t  private offscreen: HTMLCanvasElement;\n17\t  private offCtx: CanvasRenderingContext2D;\n18\t\n19\t  constructor(private renderer: Renderer) {\n20\t    this.offscreen = document.createElement('canvas');\n21\t    this.offscreen.width = 256;\n22\t    this.offscreen.height = 256;\n23\t    this.offCtx = this.offscreen.getContext('2d')!;\n24\t  }\n25\t\n26\t  update(dt: number) {\n27\t    this.particles.forEach((p) => {\n28\t      p.x += p.vx * dt;\n29\t      p.y += p.vy * dt;\n30\t      p.radius += dt * 15;\n31\t      p.life -= dt;\n32\t      p.alpha = Math.max(0, (p.life / p.maxLife) * 0.3);\n33\t    });\n34\t    this.particles = this.particles.filter((p) => p.life > 0);\n35\t  }\n36\t\n37\t  spawnBurst(cx: number, cy: number, count = 12) {\n38\t    for (let i = 0; i < count; i++) {\n39\t      const angle = Math.random() * Math.PI * 2;\n40\t      const speed = 20 + Math.random() * 60;\n41\t      this.particles.push({\n42\t        x: cx, y: cy,\n43\t        radius: 5 + Math.random() * 15,\n44\t        alpha: 0.2 + Math.random() * 0.15,\n45\t        vx: Math.cos(angle) * speed,\n46\t        vy: Math.sin(angle) * speed,\n47\t        life: 1 + Math.random() * 2,\n48\t        maxLife: 1 + Math.random() * 2,\n49\t      });\n50\t    }\n51\t  }\n52\t\n53\t  renderTransition(progress: number) {\n54\t    const ctx = this.renderer.context;\n55\t    const w = this.renderer.w;\n56\t    const h = this.renderer.h;\n57\t\n58\t    if (progress < 0.5) {\n59\t      const p = progress * 2;\n60\t      ctx.save();\n61\t      ctx.globalAlpha = p;\n62\t      ctx.fillStyle = '#050508';\n63\t      ctx.fillRect(0, 0, w, h);\n64\t\n65\t      this.renderInkSpread(ctx, w / 2, h / 2, p * Math.max(w, h) * 0.6);\n66\t      ctx.restore();\n67\t    } else {\n68\t      const p = (progress - 0.5) * 2;\n69\t      ctx.save();\n70\t      ctx.globalAlpha = 1 - p;\n71\t      ctx.fillStyle = '#050508';\n72\t      ctx.fillRect(0, 0, w, h);\n73\t      ctx.restore();\n74\t    }\n75\t\n76\t    this.renderParticles(ctx);\n77\t  }\n78\t\n79\t  renderInkFilter(alpha: number) {\n80\t    const ctx = this.renderer.context;\n81\t    const w = this.renderer.w;\n82\t    const h = this.renderer.h;\n83\t    ctx.save();\n84\t    ctx.globalAlpha = alpha;\n85\t\n86\t    const imageData = ctx.getImageData(0, 0, w, h);\n87\t    const data = imageData.data;\n88\t    for (let i = 0; i < data.length; i += 16) {\n89\t      const avg = (data[i] + data[i + 1] + data[i + 2]) / 3;\n90\t      const ink = avg > 128 ? 255 : avg * 1.5;\n91\t      data[i] = ink * 0.9;\n92\t      data[i + 1] = ink * 0.85;\n93\t      data[i + 2] = ink * 0.8;\n94\t    }\n95\t    ctx.putImageData(imageData, 0, 0);\n96\t    ctx.restore();\n97\t  }\n98\t\n99\t  private renderInkSpread(ctx: CanvasRenderingContext2D, cx: number, cy: number, radius: number) {\n100\t    const r = Math.max(1, radius);\n101\t    const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, r);\n102\t    grad.addColorStop(0, 'rgba(5, 5, 8, 0)');\n103\t    grad.addColorStop(0.3, 'rgba(5, 5, 8, 0.3)');\n104\t    grad.addColorStop(0.7, 'rgba(5, 5, 8, 0.7)');\n105\t    grad.addColorStop(1, 'rgba(5, 5, 8, 0.95)');\n106\t    ctx.fillStyle = grad;\n107\t\n108\t    ctx.beginPath();\n109\t    const points = 24;\n110\t    for (let i = 0; i <= points; i++) {\n111\t      const a = (i / points) * Math.PI * 2;\n112\t      const wobble = r * (0.8 + 0.3 * Math.sin(a * 3 + radius * 0.01));\n113\t      const px = cx + Math.cos(a) * wobble;\n114\t      const py = cy + Math.sin(a) * wobble;\n115\t      if (i === 0) ctx.moveTo(px, py);\n116\t      else ctx.lineTo(px, py);\n117\t    }\n118\t    ctx.closePath();\n119\t    ctx.fill();\n120\t  }\n121\t\n122\t  private renderParticles(ctx: CanvasRenderingContext2D) {\n123\t    this.particles.forEach((p) => {\n124\t      ctx.save();\n125\t      ctx.globalAlpha = p.alpha;\n126\t      ctx.fillStyle = '#1a1520';\n127\t      ctx.beginPath();\n128\t      const r = Math.max(0.5, p.radius);\n129\t      ctx.arc(p.x, p.y, r, 0, Math.PI * 2);\n130\t      ctx.fill();\n131\t      ctx.restore();\n132\t    });\n133\t  }\n134\t}\n135\t"}]},"parent_tool_use_id":null,"session_id":"60e8bd2a-b118-4ebb-8072-7fe7ed523870","uuid":"3d8d66f0-6bde-4699-9347-8026af8ab054","timestamp":"2026-05-23T17:56:23.288Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-ancient-mystery\\src\\utils\\ink.ts","content":"import { Renderer } from '../renderer/Renderer';\n\ninterface InkParticle {\n  x: number;\n  y: number;\n  radius: number;\n  alpha: number;\n  vx: number;\n  vy: number;\n  life: number;\n  maxLife: number;\n}\n\nexport class InkRenderer {\n  private particles: InkParticle[] = [];\n  private offscreen: HTMLCanvasElement;\n  private offCtx: CanvasRenderingContext2D;\n\n  constructor(private renderer: Renderer) {\n    this.offscreen = document.createElement('canvas');\n    this.offscreen.width = 256;\n    this.offscreen.height = 256;\n    this.offCtx = this.offscreen.getContext('2d')!;\n  }\n\n  update(dt: number) {\n    this.particles.forEach((p) => {\n      p.x += p.vx * dt;\n      p.y += p.vy * dt;\n      p.radius += dt * 15;\n      p.life -= dt;\n      p.alpha = Math.max(0, (p.life / p.maxLife) * 0.3);\n    });\n    this.particles = this.particles.filter((p) => p.life > 0);\n  }\n\n  spawnBurst(cx: number, cy: number, count = 12) {\n    for (let i = 0; i < count; i++) {\n      const angle = Math.random() * Math.PI * 2;\n      const speed = 20 + Math.random() * 60;\n      this.particles.push({\n        x: cx, y: cy,\n        radius: 5 + Math.random() * 15,\n        alpha: 0.2 + Math.random() * 0.15,\n        vx: Math.cos(angle) * speed,\n        vy: Math.sin(angle) * speed,\n        life: 1 + Math.random() * 2,\n        maxLife: 1 + Math.random() * 2,\n      });\n    }\n  }\n\n  renderTransition(progress: number) {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    if (progress < 0.5) {\n      const p = progress * 2;\n      ctx.save();\n      ctx.globalAlpha = p;\n      ctx.fillStyle = '#050508';\n      ctx.fillRect(0, 0, w, h);\n\n      this.renderInkSpread(ctx, w / 2, h / 2, p * Math.max(w, h) * 0.6);\n      ctx.restore();\n    } else {\n      const p = (progress - 0.5) * 2;\n      ctx.save();\n      ctx.globalAlpha = 1 - p;\n      ctx.fillStyle = '#050508';\n      ctx.fillRect(0, 0, w, h);\n      ctx.restore();\n    }\n\n    this.renderParticles(ctx);\n  }\n\n  renderInkFilter(alpha: number) {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    ctx.save();\n    ctx.globalAlpha = alpha;\n\n    const imageData = ctx.getImageData(0, 0, w, h);\n    const data = imageData.data;\n    for (let i = 0; i < data.length; i += 16) {\n      const avg = (data[i] + data[i + 1] + data[i + 2]) / 3;\n      const ink = avg > 128 ? 255 : avg * 1.5;\n      data[i] = ink * 0.9;\n      data[i + 1] = ink * 0.85;\n      data[i + 2] = ink * 0.8;\n    }\n    ctx.putImageData(imageData, 0, 0);\n    ctx.restore();\n  }\n\n  private renderInkSpread(ctx: CanvasRenderingContext2D, cx: number, cy: number, radius: number) {\n    const r = Math.max(1, radius);\n    const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, r);\n    grad.addColorStop(0, 'rgba(5, 5, 8, 0)');\n    grad.addColorStop(0.3, 'rgba(5, 5, 8, 0.3)');\n    grad.addColorStop(0.7, 'rgba(5, 5, 8, 0.7)');\n    grad.addColorStop(1, 'rgba(5, 5, 8, 0.95)');\n    ctx.fillStyle = grad;\n\n    ctx.beginPath();\n    const points = 24;\n    for (let i = 0; i <= points; i++) {\n      const a = (i / points) * Math.PI * 2;\n      const wobble = r * (0.8 + 0.3 * Math.sin(a * 3 + radius * 0.01));\n      const px = cx + Math.cos(a) * wobble;\n      const py = cy + Math.sin(a) * wobble;\n      if (i === 0) ctx.moveTo(px, py);\n      else ctx.lineTo(px, py);\n    }\n    ctx.closePath();\n    ctx.fill();\n  }\n\n  private renderParticles(ctx: CanvasRenderingContext2D) {\n    this.particles.forEach((p) => {\n      ctx.save();\n      ctx.globalAlpha = p.alpha;\n      ctx.fillStyle = '#1a1520';\n      ctx.beginPath();\n      const r = Math.max(0.5, p.radius);\n      ctx.arc(p.x, p.y, r, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.restore();\n    });\n  }\n}\n","numLines":135,"startLine":1,"totalLines":135}}}
