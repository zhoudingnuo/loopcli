{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_8497f8d3f7914da3a552716a","type":"tool_result","content":"1\timport { Renderer } from '../renderer/Renderer';\n2\timport { GameState } from './GameState';\n3\timport { InputManager } from './InputManager';\n4\t\n5\texport interface Hotspot {\n6\t  id: string;\n7\t  x: number;\n8\t  y: number;\n9\t  w: number;\n10\t  h: number;\n11\t  label: string;\n12\t  examined: boolean;\n13\t  action: 'examine' | 'pickup' | 'talk' | 'enter';\n14\t  requiresEvidence?: string;\n15\t  requiresFlag?: string;\n16\t  giveEvidence?: string;\n17\t  giveFlag?: string;\n18\t  dialogueId?: string;\n19\t}\n20\t\n21\texport interface ExploreScene {\n22\t  sceneId: string;\n23\t  hotspots: Hotspot[];\n24\t}\n25\t\n26\texport class SceneExplorer {\n27\t  private scenes: Map<string, ExploreScene> = new Map();\n28\t  private currentScene: ExploreScene | null = null;\n29\t  private cameraX = 0;\n30\t  private cameraY = 0;\n31\t  private targetCameraX = 0;\n32\t  private targetCameraY = 0;\n33\t  private zoom = 1;\n34\t  private targetZoom = 1;\n35\t  private hoveredHotspot: Hotspot | null = null;\n36\t  private activeHotspot: Hotspot | null = null;\n37\t  private showingDetail = false;\n38\t  private detailText = '';\n39\t  private detailAlpha = 0;\n40\t  private highlightPulse = 0;\n41\t\n42\t  private onHotspotAction?: (hotspot: Hotspot) => void;\n43\t\n44\t  constructor(\n45\t    private renderer: Renderer,\n46\t    private state: GameState,\n47\t    private input: InputManager\n48\t  ) {\n49\t    this.setupInput();\n50\t  }\n51\t\n52\t  setActionCallback(cb: (hotspot: Hotspot) => void) {\n53\t    this.onHotspotAction = cb;\n54\t  }\n55\t\n56\t  registerScene(scene: ExploreScene) {\n57\t    this.scenes.set(scene.sceneId, scene);\n58\t  }\n59\t\n60\t  activate(sceneId: string) {\n61\t    const scene = this.scenes.get(sceneId);\n62\t    if (!scene) return;\n63\t    this.currentScene = scene;\n64\t    this.cameraX = 0;\n65\t    this.cameraY = 0;\n66\t    this.targetCameraX = 0;\n67\t    this.targetCameraY = 0;\n68\t    this.zoom = 1;\n69\t    this.targetZoom = 1;\n70\t    this.showingDetail = false;\n71\t    this.activeHotspot = null;\n72\t  }\n73\t\n74\t  deactivate() {\n75\t    this.currentScene = null;\n76\t    this.showingDetail = false;\n77\t    this.activeHotspot = null;\n78\t  }\n79\t\n80\t  isActive(): boolean {\n81\t    return this.currentScene !== null && !this.showingDetail;\n82\t  }\n83\t\n84\t  private setupInput() {\n85\t    this.input.onClick((e) => {\n86\t      if (e.type !== 'up') return;\n87\t      if (!this.currentScene) return;\n88\t\n89\t      if (this.showingDetail) {\n90\t        this.showingDetail = false;\n91\t        this.activeHotspot = null;\n92\t        return;\n93\t      }\n94\t\n95\t      const wx = (e.x - this.cameraX) / this.zoom;\n96\t      const wy = (e.y - this.cameraY) / this.zoom;\n97\t\n98\t      for (const hs of this.currentScene.hotspots) {\n99\t        if (this.hitTest(wx, wy, hs)) {\n100\t          if (hs.requiresEvidence && !this.state.hasEvidence(hs.requiresEvidence)) continue;\n101\t          if (hs.requiresFlag && !this.state.getFlag(hs.requiresFlag)) continue;\n102\t\n103\t          hs.examined = true;\n104\t          if (hs.giveEvidence) this.state.addEvidence(hs.giveEvidence);\n105\t          if (hs.giveFlag) this.state.setFlag(hs.giveFlag, true);\n106\t\n107\t          this.activeHotspot = hs;\n108\t          this.showingDetail = true;\n109\t          this.detailAlpha = 0;\n110\t\n111\t          if (hs.action === 'examine' || hs.action === 'pickup') {\n112\t            this.detailText = hs.label + (hs.examined ? ' (已调查)' : '');\n113\t          }\n114\t\n115\t          this.onHotspotAction?.(hs);\n116\t          return;\n117\t        }\n118\t      }\n119\t    });\n120\t  }\n121\t\n122\t  private hitTest(wx: number, wy: number, hs: Hotspot): boolean {\n123\t    return wx >= hs.x && wx <= hs.x + hs.w && wy >= hs.y && wy <= hs.y + hs.h;\n124\t  }\n125\t\n126\t  panTo(x: number, y: number) {\n127\t    this.targetCameraX = -x;\n128\t    this.targetCameraY = -y;\n129\t  }\n130\t\n131\t  zoomTo(level: number) {\n132\t    this.targetZoom = Math.max(0.5, Math.min(2.5, level));\n133\t  }\n134\t\n135\t  update(dt: number) {\n136\t    if (!this.currentScene) return;\n137\t\n138\t    this.highlightPulse += dt * 3;\n139\t\n140\t    const camSpeed = 5;\n141\t    this.cameraX += (this.targetCameraX - this.cameraX) * dt * camSpeed;\n142\t    this.cameraY += (this.targetCameraY - this.cameraY) * dt * camSpeed;\n143\t    this.zoom += (this.targetZoom - this.zoom) * dt * camSpeed;\n144\t\n145\t    if (this.showingDetail) {\n146\t      this.detailAlpha = Math.min(1, this.detailAlpha + dt * 4);\n147\t    }\n148\t\n149\t    const mx = (this.input.mouseX - this.cameraX) / this.zoom;\n150\t    const my = (this.input.mouseY - this.cameraY) / this.zoom;\n151\t    this.hoveredHotspot = null;\n152\t    for (const hs of this.currentScene.hotspots) {\n153\t      if (this.hitTest(mx, my, hs)) {\n154\t        this.hoveredHotspot = hs;\n155\t        break;\n156\t      }\n157\t    }\n158\t  }\n159\t\n160\t  render() {\n161\t    if (!this.currentScene) return;\n162\t    const ctx = this.renderer.context;\n163\t\n164\t    ctx.save();\n165\t    ctx.translate(this.cameraX, this.cameraY);\n166\t    ctx.scale(this.zoom, this.zoom);\n167\t\n168\t    this.renderHotspots(ctx);\n169\t\n170\t    ctx.restore();\n171\t\n172\t    if (this.hoveredHotspot && !this.showingDetail) {\n173\t      this.renderTooltip(ctx, this.hoveredHotspot);\n174\t    }\n175\t\n176\t    if (this.showingDetail && this.activeHotspot) {\n177\t      this.renderDetailPanel(ctx);\n178\t    }\n179\t  }\n180\t\n181\t  private renderHotspots(ctx: CanvasRenderingContext2D) {\n182\t    if (!this.currentScene) return;\n183\t    const pulse = Math.sin(this.highlightPulse) * 0.5 + 0.5;\n184\t\n185\t    for (const hs of this.currentScene.hotspots) {\n186\t      const accessible = this.canAccess(hs);\n187\t      const isHover = this.hoveredHotspot === hs;\n188\t\n189\t      ctx.save();\n190\t\n191\t      if (!hs.examined && accessible) {\n192\t        const alpha = 0.08 + pulse * 0.12 + (isHover ? 0.15 : 0);\n193\t        ctx.fillStyle = `rgba(200, 168, 130, ${alpha})`;\n194\t        ctx.fillRect(hs.x, hs.y, hs.w, hs.h);\n195\t\n196\t        ctx.strokeStyle = `rgba(200, 168, 130, ${0.3 + pulse * 0.3})`;\n197\t        ctx.lineWidth = 1;\n198\t        ctx.setLineDash([4, 4]);\n199\t        ctx.strokeRect(hs.x, hs.y, hs.w, hs.h);\n200\t        ctx.setLineDash([]);\n201\t      } else if (hs.examined) {\n202\t        ctx.fillStyle = 'rgba(100, 80, 60, 0.05)';\n203\t        ctx.fillRect(hs.x, hs.y, hs.w, hs.h);\n204\t      }\n205\t\n206\t      if (isHover && accessible) {\n207\t        ctx.strokeStyle = 'rgba(232, 200, 162, 0.6)';\n208\t        ctx.lineWidth = 2;\n209\t        ctx.strokeRect(hs.x, hs.y, hs.w, hs.h);\n210\t      }\n211\t\n212\t      ctx.restore();\n213\t    }\n214\t  }\n215\t\n216\t  private canAccess(hs: Hotspot): boolean {\n217\t    if (hs.requiresEvidence && !this.state.hasEvidence(hs.requiresEvidence)) return false;\n218\t    if (hs.requiresFlag && !this.state.getFlag(hs.requiresFlag)) return false;\n219\t    return true;\n220\t  }\n221\t\n222\t  private renderTooltip(ctx: CanvasRenderingContext2D, hs: Hotspot) {\n223\t    const w = this.renderer.w;\n224\t    const mx = this.input.mouseX;\n225\t    const my = this.input.mouseY;\n226\t\n227\t    const actionLabels: Record<string, string> = {\n228\t      examine: '🔍 调查',\n229\t      pickup: '✋ 拾取',\n230\t      talk: '💬 对话',\n231\t      enter: '🚪 进入',\n232\t    };\n233\t\n234\t    const text = `${actionLabels[hs.action] || '互动'} ${hs.label}`;\n235\t    ctx.save();\n236\t    ctx.font = '16px \"SimSun\", \"Noto Serif SC\", serif';\n237\t    const tw = ctx.measureText(text).width + 20;\n238\t    const tx = Math.min(mx + 15, w - tw - 10);\n239\t    const ty = my - 35;\n240\t\n241\t    ctx.globalAlpha = 0.9;\n242\t    this.renderer.drawRoundRect(tx, ty, tw, 28, 4, '#1a140e', '#5a4030');\n243\t    ctx.globalAlpha = 1;\n244\t    this.renderer.drawText(text, tx + 10, ty + 5, {\n245\t      font: '16px \"SimSun\", \"Noto Serif SC\", serif',\n246\t      color: '#e8c8a2',\n247\t    });\n248\t    ctx.restore();\n249\t  }\n250\t\n251\t  private renderDetailPanel(ctx: CanvasRenderingContext2D) {\n252\t    const w = this.renderer.w;\n253\t    const h = this.renderer.h;\n254\t\n255\t    ctx.save();\n256\t    ctx.globalAlpha = this.detailAlpha * 0.85;\n257\t    ctx.fillStyle = '#0a0806';\n258\t    ctx.fillRect(0, 0, w, h);\n259\t    ctx.restore();\n260\t\n261\t    ctx.save();\n262\t    ctx.globalAlpha = this.detailAlpha;\n263\t\n264\t    const pw = Math.min(500, w * 0.45);\n265\t    const ph = Math.min(300, h * 0.4);\n266\t    const px = (w - pw) / 2;\n267\t    const py = (h - ph) / 2;\n268\t\n269\t    this.renderer.drawRoundRect(px, py, pw, ph, 8, '#1a140e', '#5a4030');\n270\t    ctx.strokeStyle = '#6a5040';\n271\t    ctx.lineWidth = 1;\n272\t    ctx.strokeRect(px + 4, py + 4, pw - 8, ph - 8);\n273\t\n274\t    if (this.activeHotspot) {\n275\t      this.renderer.drawText(this.activeHotspot.label, px + 24, py + 20, {\n276\t        font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n277\t        color: '#e8c8a2',\n278\t      });\n279\t\n280\t      const actionText: Record<string, string> = {\n281\t        examine: '你仔细查看了周围...',\n282\t        pickup: '你发现了什么！',\n283\t        talk: '你走上前去...',\n284\t        enter: '一道门出现在眼前。',\n285\t      };\n286\t      this.renderer.drawText(\n287\t        actionText[this.activeHotspot.action] ?? '',\n288\t        px + 24, py + 60,\n289\t        { font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870' }\n290\t      );\n291\t\n292\t      if (this.activeHotspot.examined) {\n293\t        this.renderer.drawText('(已调查)', px + 24, py + 90, {\n294\t          font: '16px \"SimSun\", \"Noto Serif SC\", serif', color: '#5a4a3a',\n295\t        });\n296\t      }\n297\t\n298\t      this.renderer.drawText('点击任意处关闭', px + pw / 2, py + ph - 35, {\n299\t        font: '14px sans-serif', color: '#5a4a3a', align: 'center',\n300\t      });\n301\t    }\n302\t\n303\t    ctx.restore();\n304\t  }\n305\t\n306\t  getActiveHotspot(): Hotspot | null { return this.activeHotspot; }\n307\t  isShowingDetail(): boolean { return this.showingDetail; }\n308\t}\n309\t"}]},"parent_tool_use_id":null,"session_id":"60e8bd2a-b118-4ebb-8072-7fe7ed523870","uuid":"296fea93-2df8-4d5b-874d-0e28162aaff4","timestamp":"2026-05-23T17:49:47.208Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-ancient-mystery\\src\\game\\SceneExplorer.ts","content":"import { Renderer } from '../renderer/Renderer';\nimport { GameState } from './GameState';\nimport { InputManager } from './InputManager';\n\nexport interface Hotspot {\n  id: string;\n  x: number;\n  y: number;\n  w: number;\n  h: number;\n  label: string;\n  examined: boolean;\n  action: 'examine' | 'pickup' | 'talk' | 'enter';\n  requiresEvidence?: string;\n  requiresFlag?: string;\n  giveEvidence?: string;\n  giveFlag?: string;\n  dialogueId?: string;\n}\n\nexport interface ExploreScene {\n  sceneId: string;\n  hotspots: Hotspot[];\n}\n\nexport class SceneExplorer {\n  private scenes: Map<string, ExploreScene> = new Map();\n  private currentScene: ExploreScene | null = null;\n  private cameraX = 0;\n  private cameraY = 0;\n  private targetCameraX = 0;\n  private targetCameraY = 0;\n  private zoom = 1;\n  private targetZoom = 1;\n  private hoveredHotspot: Hotspot | null = null;\n  private activeHotspot: Hotspot | null = null;\n  private showingDetail = false;\n  private detailText = '';\n  private detailAlpha = 0;\n  private highlightPulse = 0;\n\n  private onHotspotAction?: (hotspot: Hotspot) => void;\n\n  constructor(\n    private renderer: Renderer,\n    private state: GameState,\n    private input: InputManager\n  ) {\n    this.setupInput();\n  }\n\n  setActionCallback(cb: (hotspot: Hotspot) => void) {\n    this.onHotspotAction = cb;\n  }\n\n  registerScene(scene: ExploreScene) {\n    this.scenes.set(scene.sceneId, scene);\n  }\n\n  activate(sceneId: string) {\n    const scene = this.scenes.get(sceneId);\n    if (!scene) return;\n    this.currentScene = scene;\n    this.cameraX = 0;\n    this.cameraY = 0;\n    this.targetCameraX = 0;\n    this.targetCameraY = 0;\n    this.zoom = 1;\n    this.targetZoom = 1;\n    this.showingDetail = false;\n    this.activeHotspot = null;\n  }\n\n  deactivate() {\n    this.currentScene = null;\n    this.showingDetail = false;\n    this.activeHotspot = null;\n  }\n\n  isActive(): boolean {\n    return this.currentScene !== null && !this.showingDetail;\n  }\n\n  private setupInput() {\n    this.input.onClick((e) => {\n      if (e.type !== 'up') return;\n      if (!this.currentScene) return;\n\n      if (this.showingDetail) {\n        this.showingDetail = false;\n        this.activeHotspot = null;\n        return;\n      }\n\n      const wx = (e.x - this.cameraX) / this.zoom;\n      const wy = (e.y - this.cameraY) / this.zoom;\n\n      for (const hs of this.currentScene.hotspots) {\n        if (this.hitTest(wx, wy, hs)) {\n          if (hs.requiresEvidence && !this.state.hasEvidence(hs.requiresEvidence)) continue;\n          if (hs.requiresFlag && !this.state.getFlag(hs.requiresFlag)) continue;\n\n          hs.examined = true;\n          if (hs.giveEvidence) this.state.addEvidence(hs.giveEvidence);\n          if (hs.giveFlag) this.state.setFlag(hs.giveFlag, true);\n\n          this.activeHotspot = hs;\n          this.showingDetail = true;\n          this.detailAlpha = 0;\n\n          if (hs.action === 'examine' || hs.action === 'pickup') {\n            this.detailText = hs.label + (hs.examined ? ' (已调查)' : '');\n          }\n\n          this.onHotspotAction?.(hs);\n          return;\n        }\n      }\n    });\n  }\n\n  private hitTest(wx: number, wy: number, hs: Hotspot): boolean {\n    return wx >= hs.x && wx <= hs.x + hs.w && wy >= hs.y && wy <= hs.y + hs.h;\n  }\n\n  panTo(x: number, y: number) {\n    this.targetCameraX = -x;\n    this.targetCameraY = -y;\n  }\n\n  zoomTo(level: number) {\n    this.targetZoom = Math.max(0.5, Math.min(2.5, level));\n  }\n\n  update(dt: number) {\n    if (!this.currentScene) return;\n\n    this.highlightPulse += dt * 3;\n\n    const camSpeed = 5;\n    this.cameraX += (this.targetCameraX - this.cameraX) * dt * camSpeed;\n    this.cameraY += (this.targetCameraY - this.cameraY) * dt * camSpeed;\n    this.zoom += (this.targetZoom - this.zoom) * dt * camSpeed;\n\n    if (this.showingDetail) {\n      this.detailAlpha = Math.min(1, this.detailAlpha + dt * 4);\n    }\n\n    const mx = (this.input.mouseX - this.cameraX) / this.zoom;\n    const my = (this.input.mouseY - this.cameraY) / this.zoom;\n    this.hoveredHotspot = null;\n    for (const hs of this.currentScene.hotspots) {\n      if (this.hitTest(mx, my, hs)) {\n        this.hoveredHotspot = hs;\n        break;\n      }\n    }\n  }\n\n  render() {\n    if (!this.currentScene) return;\n    const ctx = this.renderer.context;\n\n    ctx.save();\n    ctx.translate(this.cameraX, this.cameraY);\n    ctx.scale(this.zoom, this.zoom);\n\n    this.renderHotspots(ctx);\n\n    ctx.restore();\n\n    if (this.hoveredHotspot && !this.showingDetail) {\n      this.renderTooltip(ctx, this.hoveredHotspot);\n    }\n\n    if (this.showingDetail && this.activeHotspot) {\n      this.renderDetailPanel(ctx);\n    }\n  }\n\n  private renderHotspots(ctx: CanvasRenderingContext2D) {\n    if (!this.currentScene) return;\n    const pulse = Math.sin(this.highlightPulse) * 0.5 + 0.5;\n\n    for (const hs of this.currentScene.hotspots) {\n      const accessible = this.canAccess(hs);\n      const isHover = this.hoveredHotspot === hs;\n\n      ctx.save();\n\n      if (!hs.examined && accessible) {\n        const alpha = 0.08 + pulse * 0.12 + (isHover ? 0.15 : 0);\n        ctx.fillStyle = `rgba(200, 168, 130, ${alpha})`;\n        ctx.fillRect(hs.x, hs.y, hs.w, hs.h);\n\n        ctx.strokeStyle = `rgba(200, 168, 130, ${0.3 + pulse * 0.3})`;\n        ctx.lineWidth = 1;\n        ctx.setLineDash([4, 4]);\n        ctx.strokeRect(hs.x, hs.y, hs.w, hs.h);\n        ctx.setLineDash([]);\n      } else if (hs.examined) {\n        ctx.fillStyle = 'rgba(100, 80, 60, 0.05)';\n        ctx.fillRect(hs.x, hs.y, hs.w, hs.h);\n      }\n\n      if (isHover && accessible) {\n        ctx.strokeStyle = 'rgba(232, 200, 162, 0.6)';\n        ctx.lineWidth = 2;\n        ctx.strokeRect(hs.x, hs.y, hs.w, hs.h);\n      }\n\n      ctx.restore();\n    }\n  }\n\n  private canAccess(hs: Hotspot): boolean {\n    if (hs.requiresEvidence && !this.state.hasEvidence(hs.requiresEvidence)) return false;\n    if (hs.requiresFlag && !this.state.getFlag(hs.requiresFlag)) return false;\n    return true;\n  }\n\n  private renderTooltip(ctx: CanvasRenderingContext2D, hs: Hotspot) {\n    const w = this.renderer.w;\n    const mx = this.input.mouseX;\n    const my = this.input.mouseY;\n\n    const actionLabels: Record<string, string> = {\n      examine: '🔍 调查',\n      pickup: '✋ 拾取',\n      talk: '💬 对话',\n      enter: '🚪 进入',\n    };\n\n    const text = `${actionLabels[hs.action] || '互动'} ${hs.label}`;\n    ctx.save();\n    ctx.font = '16px \"SimSun\", \"Noto Serif SC\", serif';\n    const tw = ctx.measureText(text).width + 20;\n    const tx = Math.min(mx + 15, w - tw - 10);\n    const ty = my - 35;\n\n    ctx.globalAlpha = 0.9;\n    this.renderer.drawRoundRect(tx, ty, tw, 28, 4, '#1a140e', '#5a4030');\n    ctx.globalAlpha = 1;\n    this.renderer.drawText(text, tx + 10, ty + 5, {\n      font: '16px \"SimSun\", \"Noto Serif SC\", serif',\n      color: '#e8c8a2',\n    });\n    ctx.restore();\n  }\n\n  private renderDetailPanel(ctx: CanvasRenderingContext2D) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.save();\n    ctx.globalAlpha = this.detailAlpha * 0.85;\n    ctx.fillStyle = '#0a0806';\n    ctx.fillRect(0, 0, w, h);\n    ctx.restore();\n\n    ctx.save();\n    ctx.globalAlpha = this.detailAlpha;\n\n    const pw = Math.min(500, w * 0.45);\n    const ph = Math.min(300, h * 0.4);\n    const px = (w - pw) / 2;\n    const py = (h - ph) / 2;\n\n    this.renderer.drawRoundRect(px, py, pw, ph, 8, '#1a140e', '#5a4030');\n    ctx.strokeStyle = '#6a5040';\n    ctx.lineWidth = 1;\n    ctx.strokeRect(px + 4, py + 4, pw - 8, ph - 8);\n\n    if (this.activeHotspot) {\n      this.renderer.drawText(this.activeHotspot.label, px + 24, py + 20, {\n        font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n        color: '#e8c8a2',\n      });\n\n      const actionText: Record<string, string> = {\n        examine: '你仔细查看了周围...',\n        pickup: '你发现了什么！',\n        talk: '你走上前去...',\n        enter: '一道门出现在眼前。',\n      };\n      this.renderer.drawText(\n        actionText[this.activeHotspot.action] ?? '',\n        px + 24, py + 60,\n        { font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870' }\n      );\n\n      if (this.activeHotspot.examined) {\n        this.renderer.drawText('(已调查)', px + 24, py + 90, {\n          font: '16px \"SimSun\", \"Noto Serif SC\", serif', color: '#5a4a3a',\n        });\n      }\n\n      this.renderer.drawText('点击任意处关闭', px + pw / 2, py + ph - 35, {\n        font: '14px sans-serif', color: '#5a4a3a', align: 'center',\n      });\n    }\n\n    ctx.restore();\n  }\n\n  getActiveHotspot(): Hotspot | null { return this.activeHotspot; }\n  isShowingDetail(): boolean { return this.showingDetail; }\n}\n","numLines":309,"startLine":1,"totalLines":309}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_60a975fe20344adcb3eb99da","type":"tool_result","content":"1\timport { Renderer } from '../renderer/Renderer';\n2\timport { GameState } from './GameState';\n3\t\n4\texport class CredibilityScore {\n5\t  private score = 100;\n6\t  private maxScore = 100;\n7\t  private penalty = 20;\n8\t  private reward = 15;\n9\t  private streak = 0;\n10\t  private history: { delta: number; reason: string; timestamp: number }[] = [];\n11\t\n12\t  private displayScore = 100;\n13\t  private flashTimer = 0;\n14\t  private flashPositive = false;\n15\t  private warningLevel: 'safe' | 'caution' | 'danger' | 'critical' = 'safe';\n16\t\n17\t  constructor(\n18\t    private renderer: Renderer,\n19\t    private state: GameState\n20\t  ) {}\n21\t\n22\t  getScore(): number { return this.score; }\n23\t  getStreak(): number { return this.streak; }\n24\t  getWarningLevel(): string { return this.warningLevel; }\n25\t\n26\t  isAlive(): boolean { return this.score > 0; }\n27\t\n28\t  onCorrectAction(reason: string) {\n29\t    const bonus = this.reward + this.streak * 2;\n30\t    this.score = Math.min(this.maxScore, this.score + bonus);\n31\t    this.streak++;\n32\t    this.history.push({ delta: bonus, reason, timestamp: Date.now() });\n33\t    this.flashTimer = 1.5;\n34\t    this.flashPositive = true;\n35\t    this.updateWarningLevel();\n36\t  }\n37\t\n38\t  onWrongAction(reason: string) {\n39\t    this.score = Math.max(0, this.score - this.penalty);\n40\t    this.streak = 0;\n41\t    this.history.push({ delta: -this.penalty, reason, timestamp: Date.now() });\n42\t    this.flashTimer = 1.5;\n43\t    this.flashPositive = false;\n44\t    this.updateWarningLevel();\n45\t  }\n46\t\n47\t  modifyScore(delta: number, reason: string) {\n48\t    this.score = Math.max(0, Math.min(this.maxScore, this.score + delta));\n49\t    this.history.push({ delta, reason, timestamp: Date.now() });\n50\t    this.flashTimer = 1;\n51\t    this.flashPositive = delta > 0;\n52\t    this.updateWarningLevel();\n53\t  }\n54\t\n55\t  reset() {\n56\t    this.score = this.maxScore;\n57\t    this.displayScore = this.maxScore;\n58\t    this.streak = 0;\n59\t    this.history = [];\n60\t    this.warningLevel = 'safe';\n61\t  }\n62\t\n63\t  private updateWarningLevel() {\n64\t    if (this.score >= 70) this.warningLevel = 'safe';\n65\t    else if (this.score >= 40) this.warningLevel = 'caution';\n66\t    else if (this.score > 0) this.warningLevel = 'danger';\n67\t    else this.warningLevel = 'critical';\n68\t  }\n69\t\n70\t  update(dt: number) {\n71\t    if (this.flashTimer > 0) this.flashTimer -= dt;\n72\t    this.displayScore += (this.score - this.displayScore) * Math.min(1, dt * 8);\n73\t  }\n74\t\n75\t  render(x: number, y: number, w: number) {\n76\t    const ctx = this.renderer.context;\n77\t    const barH = 14;\n78\t    const labelH = 20;\n79\t\n80\t    this.renderer.drawText('信誉值', x, y, {\n81\t      font: '14px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870',\n82\t    });\n83\t\n84\t    const scoreText = `${Math.round(this.displayScore)}`;\n85\t    this.renderer.drawText(scoreText, x + w - 5, y, {\n86\t      font: 'bold 16px sans-serif', color: this.getBarColor(), align: 'right',\n87\t    });\n88\t\n89\t    const barY = y + labelH;\n90\t\n91\t    ctx.fillStyle = '#1a140e';\n92\t    ctx.fillRect(x, barY, w, barH);\n93\t\n94\t    const ratio = this.displayScore / this.maxScore;\n95\t    ctx.fillStyle = this.getBarColor();\n96\t    ctx.fillRect(x, barY, w * ratio, barH);\n97\t\n98\t    ctx.strokeStyle = '#3a2a1a';\n99\t    ctx.lineWidth = 1;\n100\t    ctx.strokeRect(x, barY, w, barH);\n101\t\n102\t    if (this.streak >= 3) {\n103\t      this.renderer.drawText(`连击 x${this.streak}`, x + w + 8, y, {\n104\t        font: '13px sans-serif', color: '#c8a040',\n105\t      });\n106\t    }\n107\t\n108\t    if (this.flashTimer > 0) {\n109\t      const fa = Math.min(1, this.flashTimer);\n110\t      ctx.save();\n111\t      ctx.globalAlpha = fa * 0.3;\n112\t      ctx.fillStyle = this.flashPositive ? '#4a8a4a' : '#8a3a3a';\n113\t      ctx.fillRect(x, barY - 2, w, barH + 4);\n114\t      ctx.restore();\n115\t    }\n116\t  }\n117\t\n118\t  renderWarningOverlay() {\n119\t    if (this.warningLevel === 'safe') return;\n120\t\n121\t    const ctx = this.renderer.context;\n122\t    const w = this.renderer.w;\n123\t    const h = this.renderer.h;\n124\t\n125\t    const alpha = this.warningLevel === 'danger'\n126\t      ? 0.04 + Math.sin(Date.now() * 0.003) * 0.02\n127\t      : this.warningLevel === 'critical'\n128\t        ? 0.08 + Math.sin(Date.now() * 0.005) * 0.04\n129\t        : 0.02;\n130\t\n131\t    ctx.save();\n132\t    ctx.globalAlpha = alpha;\n133\t    ctx.fillStyle = '#8a0000';\n134\t    ctx.fillRect(0, 0, w, h);\n135\t    ctx.restore();\n136\t  }\n137\t\n138\t  private getBarColor(): string {\n139\t    switch (this.warningLevel) {\n140\t      case 'safe': return '#6a8a4a';\n141\t      case 'caution': return '#c8a040';\n142\t      case 'danger': return '#c86a3a';\n143\t      case 'critical': return '#c83a3a';\n144\t    }\n145\t  }\n146\t}\n147\t"}]},"parent_tool_use_id":null,"session_id":"60e8bd2a-b118-4ebb-8072-7fe7ed523870","uuid":"3a4618bf-ec60-489b-813f-61e1a25edd12","timestamp":"2026-05-23T17:49:47.212Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-ancient-mystery\\src\\game\\CredibilityScore.ts","content":"import { Renderer } from '../renderer/Renderer';\nimport { GameState } from './GameState';\n\nexport class CredibilityScore {\n  private score = 100;\n  private maxScore = 100;\n  private penalty = 20;\n  private reward = 15;\n  private streak = 0;\n  private history: { delta: number; reason: string; timestamp: number }[] = [];\n\n  private displayScore = 100;\n  private flashTimer = 0;\n  private flashPositive = false;\n  private warningLevel: 'safe' | 'caution' | 'danger' | 'critical' = 'safe';\n\n  constructor(\n    private renderer: Renderer,\n    private state: GameState\n  ) {}\n\n  getScore(): number { return this.score; }\n  getStreak(): number { return this.streak; }\n  getWarningLevel(): string { return this.warningLevel; }\n\n  isAlive(): boolean { return this.score > 0; }\n\n  onCorrectAction(reason: string) {\n    const bonus = this.reward + this.streak * 2;\n    this.score = Math.min(this.maxScore, this.score + bonus);\n    this.streak++;\n    this.history.push({ delta: bonus, reason, timestamp: Date.now() });\n    this.flashTimer = 1.5;\n    this.flashPositive = true;\n    this.updateWarningLevel();\n  }\n\n  onWrongAction(reason: string) {\n    this.score = Math.max(0, this.score - this.penalty);\n    this.streak = 0;\n    this.history.push({ delta: -this.penalty, reason, timestamp: Date.now() });\n    this.flashTimer = 1.5;\n    this.flashPositive = false;\n    this.updateWarningLevel();\n  }\n\n  modifyScore(delta: number, reason: string) {\n    this.score = Math.max(0, Math.min(this.maxScore, this.score + delta));\n    this.history.push({ delta, reason, timestamp: Date.now() });\n    this.flashTimer = 1;\n    this.flashPositive = delta > 0;\n    this.updateWarningLevel();\n  }\n\n  reset() {\n    this.score = this.maxScore;\n    this.displayScore = this.maxScore;\n    this.streak = 0;\n    this.history = [];\n    this.warningLevel = 'safe';\n  }\n\n  private updateWarningLevel() {\n    if (this.score >= 70) this.warningLevel = 'safe';\n    else if (this.score >= 40) this.warningLevel = 'caution';\n    else if (this.score > 0) this.warningLevel = 'danger';\n    else this.warningLevel = 'critical';\n  }\n\n  update(dt: number) {\n    if (this.flashTimer > 0) this.flashTimer -= dt;\n    this.displayScore += (this.score - this.displayScore) * Math.min(1, dt * 8);\n  }\n\n  render(x: number, y: number, w: number) {\n    const ctx = this.renderer.context;\n    const barH = 14;\n    const labelH = 20;\n\n    this.renderer.drawText('信誉值', x, y, {\n      font: '14px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870',\n    });\n\n    const scoreText = `${Math.round(this.displayScore)}`;\n    this.renderer.drawText(scoreText, x + w - 5, y, {\n      font: 'bold 16px sans-serif', color: this.getBarColor(), align: 'right',\n    });\n\n    const barY = y + labelH;\n\n    ctx.fillStyle = '#1a140e';\n    ctx.fillRect(x, barY, w, barH);\n\n    const ratio = this.displayScore / this.maxScore;\n    ctx.fillStyle = this.getBarColor();\n    ctx.fillRect(x, barY, w * ratio, barH);\n\n    ctx.strokeStyle = '#3a2a1a';\n    ctx.lineWidth = 1;\n    ctx.strokeRect(x, barY, w, barH);\n\n    if (this.streak >= 3) {\n      this.renderer.drawText(`连击 x${this.streak}`, x + w + 8, y, {\n        font: '13px sans-serif', color: '#c8a040',\n      });\n    }\n\n    if (this.flashTimer > 0) {\n      const fa = Math.min(1, this.flashTimer);\n      ctx.save();\n      ctx.globalAlpha = fa * 0.3;\n      ctx.fillStyle = this.flashPositive ? '#4a8a4a' : '#8a3a3a';\n      ctx.fillRect(x, barY - 2, w, barH + 4);\n      ctx.restore();\n    }\n  }\n\n  renderWarningOverlay() {\n    if (this.warningLevel === 'safe') return;\n\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    const alpha = this.warningLevel === 'danger'\n      ? 0.04 + Math.sin(Date.now() * 0.003) * 0.02\n      : this.warningLevel === 'critical'\n        ? 0.08 + Math.sin(Date.now() * 0.005) * 0.04\n        : 0.02;\n\n    ctx.save();\n    ctx.globalAlpha = alpha;\n    ctx.fillStyle = '#8a0000';\n    ctx.fillRect(0, 0, w, h);\n    ctx.restore();\n  }\n\n  private getBarColor(): string {\n    switch (this.warningLevel) {\n      case 'safe': return '#6a8a4a';\n      case 'caution': return '#c8a040';\n      case 'danger': return '#c86a3a';\n      case 'critical': return '#c83a3a';\n    }\n  }\n}\n","numLines":147,"startLine":1,"totalLines":147}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a702f8430d9b4de3b5fb3427","type":"tool_result","content":"1\timport { Renderer } from '../renderer/Renderer';\n2\timport { GameState } from './GameState';\n3\timport { DialogueEngine, DialogueNode, DialogueChoice } from './DialogueEngine';\n4\timport { InputManager } from './InputManager';\n5\t\n6\texport interface InterrogationNPC {\n7\t  id: string;\n8\t  name: string;\n9\t  portrait?: string;\n10\t  defaultPressure: number;\n11\t  maxPressure: number;\n12\t}\n13\t\n14\texport interface InterrogationTopic {\n15\t  id: string;\n16\t  npcId: string;\n17\t  label: string;\n18\t  dialogueId: string;\n19\t  requiresEvidence?: string[];\n20\t  requiresFlag?: string[];\n21\t  pressureRange?: { min: number; max: number };\n22\t  repeatable: boolean;\n23\t}\n24\t\n25\texport class InterrogationSystem {\n26\t  private npcs: Map<string, InterrogationNPC> = new Map();\n27\t  private topics: Map<string, InterrogationTopic[]> = new Map();\n28\t  private currentNPC: InterrogationNPC | null = null;\n29\t  private pressure = 0;\n30\t  private isInterrogating = false;\n31\t  private selectedTopicIndex = -1;\n32\t  private animAlpha = 0;\n33\t  private askedTopics: Set<string> = new Set();\n34\t  private showingEvidenceSelect = false;\n35\t  private evidenceSelectFor: string | null = null;\n36\t\n37\t  constructor(\n38\t    private renderer: Renderer,\n39\t    private state: GameState,\n40\t    private dialogueEngine: DialogueEngine,\n41\t    private input: InputManager\n42\t  ) {\n43\t    this.setupInput();\n44\t  }\n45\t\n46\t  registerNPC(npc: InterrogationNPC) {\n47\t    this.npcs.set(npc.id, npc);\n48\t  }\n49\t\n50\t  registerTopic(topic: InterrogationTopic) {\n51\t    const list = this.topics.get(topic.npcId) ?? [];\n52\t    list.push(topic);\n53\t    this.topics.set(topic.npcId, list);\n54\t  }\n55\t\n56\t  registerTopics(topics: InterrogationTopic[]) {\n57\t    topics.forEach((t) => this.registerTopic(t));\n58\t  }\n59\t\n60\t  startInterrogation(npcId: string): boolean {\n61\t    const npc = this.npcs.get(npcId);\n62\t    if (!npc) return false;\n63\t\n64\t    this.currentNPC = npc;\n65\t    this.pressure = npc.defaultPressure;\n66\t    this.isInterrogating = true;\n67\t    this.selectedTopicIndex = -1;\n68\t    this.animAlpha = 0;\n69\t    this.showingEvidenceSelect = false;\n70\t    return true;\n71\t  }\n72\t\n73\t  endInterrogation() {\n74\t    this.isInterrogating = false;\n75\t    this.currentNPC = null;\n76\t    this.showingEvidenceSelect = false;\n77\t    this.evidenceSelectFor = null;\n78\t  }\n79\t\n80\t  isRunning(): boolean { return this.isInterrogating; }\n81\t\n82\t  getPressure(): number { return this.pressure; }\n83\t\n84\t  addPressure(delta: number) {\n85\t    if (!this.currentNPC) return;\n86\t    this.pressure = Math.max(0, Math.min(this.currentNPC.maxPressure, this.pressure + delta));\n87\t  }\n88\t\n89\t  getAvailableTopics(): InterrogationTopic[] {\n90\t    if (!this.currentNPC) return [];\n91\t    const allTopics = this.topics.get(this.currentNPC.id) ?? [];\n92\t    return allTopics.filter((t) => this.canAskTopic(t));\n93\t  }\n94\t\n95\t  private canAskTopic(topic: InterrogationTopic): boolean {\n96\t    if (topic.requiresEvidence) {\n97\t      for (const ev of topic.requiresEvidence) {\n98\t        if (!this.state.hasEvidence(ev)) return false;\n99\t      }\n100\t    }\n101\t    if (topic.requiresFlag) {\n102\t      for (const f of topic.requiresFlag) {\n103\t        if (!this.state.getFlag(f)) return false;\n104\t      }\n105\t    }\n106\t    if (!topic.repeatable && this.askedTopics.has(topic.id)) return false;\n107\t    if (topic.pressureRange) {\n108\t      if (this.pressure < topic.pressureRange.min || this.pressure > topic.pressureRange.max) return false;\n109\t    }\n110\t    return true;\n111\t  }\n112\t\n113\t  askTopic(topicId: string): boolean {\n114\t    const topic = this.getAvailableTopics().find((t) => t.id === topicId);\n115\t    if (!topic || !this.currentNPC) return false;\n116\t\n117\t    this.askedTopics.add(topicId);\n118\t    this.addPressure(5);\n119\t\n120\t    return this.dialogueEngine.start(topic.dialogueId, () => {\n121\t      this.selectedTopicIndex = -1;\n122\t    });\n123\t  }\n124\t\n125\t  presentEvidence(evidenceId: string): boolean {\n126\t    if (!this.currentNPC) return false;\n127\t    this.addPressure(8);\n128\t\n129\t    const topic = this.getAvailableTopics().find(\n130\t      (t) => t.requiresEvidence?.includes(evidenceId)\n131\t    );\n132\t    if (topic) {\n133\t      return this.askTopic(topic.id);\n134\t    }\n135\t    return false;\n136\t  }\n137\t\n138\t  private setupInput() {\n139\t    this.input.onClick((e) => {\n140\t      if (e.type !== 'up') return;\n141\t      if (!this.isInterrogating) return;\n142\t      if (this.dialogueEngine.getIsActive()) return;\n143\t      if (this.showingEvidenceSelect) {\n144\t        this.handleEvidenceClick(e.x, e.y);\n145\t        return;\n146\t      }\n147\t      this.handleTopicClick(e.x, e.y);\n148\t    });\n149\t  }\n150\t\n151\t  private handleTopicClick(x: number, y: number) {\n152\t    const w = this.renderer.w;\n153\t    const h = this.renderer.h;\n154\t\n155\t    const panelX = w * 0.1;\n156\t    const panelW = w * 0.8;\n157\t    const topicY = h * 0.35;\n158\t\n159\t    const topics = this.getAvailableTopics();\n160\t    for (let i = 0; i < topics.length; i++) {\n161\t      const ty = topicY + i * 48;\n162\t      if (this.isInRect(x, y, panelX + 20, ty, panelW - 40, 40)) {\n163\t        this.askTopic(topics[i].id);\n164\t        return;\n165\t      }\n166\t    }\n167\t\n168\t    const presentY = h * 0.78;\n169\t    if (this.isInRect(x, y, panelX + 20, presentY, (panelW - 60) / 2, 40)) {\n170\t      this.showingEvidenceSelect = true;\n171\t      this.evidenceSelectFor = 'present';\n172\t      return;\n173\t    }\n174\t\n175\t    const endY = h * 0.78;\n176\t    const endX = panelX + 20 + (panelW - 60) / 2 + 20;\n177\t    if (this.isInRect(x, y, endX, endY, (panelW - 60) / 2, 40)) {\n178\t      this.endInterrogation();\n179\t    }\n180\t  }\n181\t\n182\t  private handleEvidenceClick(x: number, y: number) {\n183\t    const w = this.renderer.w;\n184\t    const h = this.renderer.h;\n185\t\n186\t    const items = this.state.evidence;\n187\t    const panelX = w * 0.2;\n188\t    const panelW = w * 0.6;\n189\t    const listY = h * 0.2;\n190\t\n191\t    for (let i = 0; i < items.length; i++) {\n192\t      const iy = listY + i * 44;\n193\t      if (this.isInRect(x, y, panelX + 10, iy, panelW - 20, 38)) {\n194\t        this.showingEvidenceSelect = false;\n195\t        this.presentEvidence(items[i]);\n196\t        return;\n197\t      }\n198\t    }\n199\t\n200\t    if (this.isInRect(x, y, w * 0.4, h * 0.85, w * 0.2, 40)) {\n201\t      this.showingEvidenceSelect = false;\n202\t    }\n203\t  }\n204\t\n205\t  update(dt: number) {\n206\t    if (!this.isInterrogating) return;\n207\t    this.animAlpha = Math.min(1, this.animAlpha + dt * 5);\n208\t  }\n209\t\n210\t  render() {\n211\t    if (!this.isInterrogating) return;\n212\t    if (this.dialogueEngine.getIsActive()) return;\n213\t\n214\t    const ctx = this.renderer.context;\n215\t    const w = this.renderer.w;\n216\t    const h = this.renderer.h;\n217\t\n218\t    ctx.save();\n219\t    ctx.globalAlpha = this.animAlpha * 0.7;\n220\t    ctx.fillStyle = '#0a0806';\n221\t    ctx.fillRect(0, 0, w, h);\n222\t    ctx.restore();\n223\t\n224\t    ctx.save();\n225\t    ctx.globalAlpha = this.animAlpha;\n226\t\n227\t    const panelX = w * 0.1;\n228\t    const panelW = w * 0.8;\n229\t    const panelY = h * 0.08;\n230\t    const panelH = h * 0.84;\n231\t\n232\t    this.renderer.drawRoundRect(panelX, panelY, panelW, panelH, 8, '#1a140e', '#3a2a1a');\n233\t    ctx.strokeStyle = '#5a4030';\n234\t    ctx.lineWidth = 1;\n235\t    ctx.strokeRect(panelX + 3, panelY + 3, panelW - 6, panelH - 6);\n236\t\n237\t    if (this.currentNPC) {\n238\t      this.renderer.drawText(`审问：${this.currentNPC.name}`, panelX + panelW / 2, panelY + 18, {\n239\t        font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n240\t        color: '#c8a882', align: 'center',\n241\t      });\n242\t\n243\t      this.renderPressureBar(ctx, panelX + 30, panelY + 55, panelW - 60);\n244\t\n245\t      this.renderer.drawText('选择话题：', panelX + 30, h * 0.32, {\n246\t        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870',\n247\t      });\n248\t\n249\t      const topics = this.getAvailableTopics();\n250\t      topics.forEach((topic, i) => {\n251\t        const ty = h * 0.35 + i * 48;\n252\t        const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + 20, ty, panelW - 40, 40);\n253\t\n254\t        if (isHover) {\n255\t          ctx.fillStyle = 'rgba(200, 168, 130, 0.1)';\n256\t          ctx.fillRect(panelX + 20, ty, panelW - 40, 40);\n257\t        }\n258\t\n259\t        ctx.strokeStyle = '#3a2a1a';\n260\t        ctx.lineWidth = 1;\n261\t        ctx.strokeRect(panelX + 20, ty, panelW - 40, 40);\n262\t\n263\t        const asked = this.askedTopics.has(topic.id);\n264\t        this.renderer.drawText(\n265\t          `${asked ? '✓ ' : '  '}${topic.label}`,\n266\t          panelX + 35, ty + 10,\n267\t          {\n268\t            font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n269\t            color: asked ? '#5a4a3a' : isHover ? '#f0d8b0' : '#d8c8b0',\n270\t          }\n271\t        );\n272\t      });\n273\t\n274\t      if (topics.length === 0) {\n275\t        this.renderer.drawText('没有可问的话题', panelX + panelW / 2, h * 0.45, {\n276\t          font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n277\t        });\n278\t      }\n279\t\n280\t      const btnW = (panelW - 60) / 2;\n281\t      const btnY = h * 0.78;\n282\t\n283\t      const presentHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + 20, btnY, btnW, 40);\n284\t      this.renderer.drawRoundRect(panelX + 20, btnY, btnW, 40, 4,\n285\t        presentHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n286\t      this.renderer.drawText('出示物证', panelX + 20 + btnW / 2, btnY + 10, {\n287\t        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n288\t        color: presentHover ? '#e8c8a2' : '#a08870', align: 'center',\n289\t      });\n290\t\n291\t      const endX = panelX + 20 + btnW + 20;\n292\t      const endHover = this.isInRect(this.input.mouseX, this.input.mouseY, endX, btnY, btnW, 40);\n293\t      this.renderer.drawRoundRect(endX, btnY, btnW, 40, 4,\n294\t        endHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n295\t      this.renderer.drawText('结束审问', endX + btnW / 2, btnY + 10, {\n296\t        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n297\t        color: endHover ? '#e8c8a2' : '#a08870', align: 'center',\n298\t      });\n299\t    }\n300\t\n301\t    ctx.restore();\n302\t\n303\t    if (this.showingEvidenceSelect) {\n304\t      this.renderEvidenceSelect(ctx, w, h);\n305\t    }\n306\t  }\n307\t\n308\t  private renderPressureBar(ctx: CanvasRenderingContext2D, x: number, y: number, w: number) {\n309\t    if (!this.currentNPC) return;\n310\t\n311\t    this.renderer.drawText('压力：', x, y, {\n312\t      font: '15px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a',\n313\t    });\n314\t\n315\t    const barX = x + 50;\n316\t    const barW = w - 50;\n317\t    const barH = 12;\n318\t\n319\t    ctx.fillStyle = '#2a1a0e';\n320\t    ctx.fillRect(barX, y + 2, barW, barH);\n321\t\n322\t    const ratio = this.pressure / this.currentNPC.maxPressure;\n323\t    const pressureColor = ratio < 0.4 ? '#4a8a4a' : ratio < 0.7 ? '#c8a040' : '#8a3a3a';\n324\t    ctx.fillStyle = pressureColor;\n325\t    ctx.fillRect(barX, y + 2, barW * ratio, barH);\n326\t\n327\t    ctx.strokeStyle = '#3a2a1a';\n328\t    ctx.lineWidth = 1;\n329\t    ctx.strokeRect(barX, y + 2, barW, barH);\n330\t\n331\t    const relKey = Object.keys(this.state.relationships).find((k) =>\n332\t      this.currentNPC && k === this.currentNPC.id.replace('_', '')\n333\t    );\n334\t    if (relKey) {\n335\t      this.renderer.drawText(`好感: ${this.state.relationships[relKey]}`, barX + barW + 10, y, {\n336\t        font: '14px sans-serif', color: '#8a7a6a',\n337\t      });\n338\t    }\n339\t  }\n340\t\n341\t  private renderEvidenceSelect(ctx: CanvasRenderingContext2D, w: number, h: number) {\n342\t    ctx.save();\n343\t    ctx.globalAlpha = 0.9;\n344\t    ctx.fillStyle = '#0a0806';\n345\t    ctx.fillRect(0, 0, w, h);\n346\t    ctx.restore();\n347\t\n348\t    const panelX = w * 0.2;\n349\t    const panelW = w * 0.6;\n350\t    const panelY = h * 0.1;\n351\t    const panelH = h * 0.75;\n352\t\n353\t    this.renderer.drawRoundRect(panelX, panelY, panelW, panelH, 8, '#1a140e', '#5a4030');\n354\t    this.renderer.drawText('选择要出示的物证', panelX + panelW / 2, panelY + 18, {\n355\t      font: 'bold 22px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n356\t    });\n357\t\n358\t    const items = this.state.evidence;\n359\t    const listY = h * 0.2;\n360\t\n361\t    items.forEach((evId, i) => {\n362\t      const iy = listY + i * 44;\n363\t      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + 10, iy, panelW - 20, 38);\n364\t\n365\t      if (isHover) {\n366\t        ctx.fillStyle = 'rgba(200, 168, 130, 0.12)';\n367\t        ctx.fillRect(panelX + 10, iy, panelW - 20, 38);\n368\t      }\n369\t\n370\t      this.renderer.drawText(`▪ ${evId}`, panelX + 25, iy + 8, {\n371\t        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n372\t        color: isHover ? '#f0d8b0' : '#d8c8b0',\n373\t      });\n374\t    });\n375\t\n376\t    if (items.length === 0) {\n377\t      this.renderer.drawText('没有可出示的物证', panelX + panelW / 2, listY + 30, {\n378\t        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n379\t      });\n380\t    }\n381\t\n382\t    const cancelHover = this.isInRect(this.input.mouseX, this.input.mouseY, w * 0.4, h * 0.85, w * 0.2, 40);\n383\t    this.renderer.drawRoundRect(w * 0.4, h * 0.85, w * 0.2, 40, 4,\n384\t      cancelHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n385\t    this.renderer.drawText('取消', w / 2, h * 0.85 + 10, {\n386\t      font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n387\t      color: cancelHover ? '#e8c8a2' : '#a08870', align: 'center',\n388\t    });\n389\t  }\n390\t\n391\t  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n392\t    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n393\t  }\n394\t}\n395\t"}]},"parent_tool_use_id":null,"session_id":"60e8bd2a-b118-4ebb-8072-7fe7ed523870","uuid":"7286c58d-45e8-46c2-bc4a-fed79db22d17","timestamp":"2026-05-23T17:49:47.221Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-ancient-mystery\\src\\game\\InterrogationSystem.ts","content":"import { Renderer } from '../renderer/Renderer';\nimport { GameState } from './GameState';\nimport { DialogueEngine, DialogueNode, DialogueChoice } from './DialogueEngine';\nimport { InputManager } from './InputManager';\n\nexport interface InterrogationNPC {\n  id: string;\n  name: string;\n  portrait?: string;\n  defaultPressure: number;\n  maxPressure: number;\n}\n\nexport interface InterrogationTopic {\n  id: string;\n  npcId: string;\n  label: string;\n  dialogueId: string;\n  requiresEvidence?: string[];\n  requiresFlag?: string[];\n  pressureRange?: { min: number; max: number };\n  repeatable: boolean;\n}\n\nexport class InterrogationSystem {\n  private npcs: Map<string, InterrogationNPC> = new Map();\n  private topics: Map<string, InterrogationTopic[]> = new Map();\n  private currentNPC: InterrogationNPC | null = null;\n  private pressure = 0;\n  private isInterrogating = false;\n  private selectedTopicIndex = -1;\n  private animAlpha = 0;\n  private askedTopics: Set<string> = new Set();\n  private showingEvidenceSelect = false;\n  private evidenceSelectFor: string | null = null;\n\n  constructor(\n    private renderer: Renderer,\n    private state: GameState,\n    private dialogueEngine: DialogueEngine,\n    private input: InputManager\n  ) {\n    this.setupInput();\n  }\n\n  registerNPC(npc: InterrogationNPC) {\n    this.npcs.set(npc.id, npc);\n  }\n\n  registerTopic(topic: InterrogationTopic) {\n    const list = this.topics.get(topic.npcId) ?? [];\n    list.push(topic);\n    this.topics.set(topic.npcId, list);\n  }\n\n  registerTopics(topics: InterrogationTopic[]) {\n    topics.forEach((t) => this.registerTopic(t));\n  }\n\n  startInterrogation(npcId: string): boolean {\n    const npc = this.npcs.get(npcId);\n    if (!npc) return false;\n\n    this.currentNPC = npc;\n    this.pressure = npc.defaultPressure;\n    this.isInterrogating = true;\n    this.selectedTopicIndex = -1;\n    this.animAlpha = 0;\n    this.showingEvidenceSelect = false;\n    return true;\n  }\n\n  endInterrogation() {\n    this.isInterrogating = false;\n    this.currentNPC = null;\n    this.showingEvidenceSelect = false;\n    this.evidenceSelectFor = null;\n  }\n\n  isRunning(): boolean { return this.isInterrogating; }\n\n  getPressure(): number { return this.pressure; }\n\n  addPressure(delta: number) {\n    if (!this.currentNPC) return;\n    this.pressure = Math.max(0, Math.min(this.currentNPC.maxPressure, this.pressure + delta));\n  }\n\n  getAvailableTopics(): InterrogationTopic[] {\n    if (!this.currentNPC) return [];\n    const allTopics = this.topics.get(this.currentNPC.id) ?? [];\n    return allTopics.filter((t) => this.canAskTopic(t));\n  }\n\n  private canAskTopic(topic: InterrogationTopic): boolean {\n    if (topic.requiresEvidence) {\n      for (const ev of topic.requiresEvidence) {\n        if (!this.state.hasEvidence(ev)) return false;\n      }\n    }\n    if (topic.requiresFlag) {\n      for (const f of topic.requiresFlag) {\n        if (!this.state.getFlag(f)) return false;\n      }\n    }\n    if (!topic.repeatable && this.askedTopics.has(topic.id)) return false;\n    if (topic.pressureRange) {\n      if (this.pressure < topic.pressureRange.min || this.pressure > topic.pressureRange.max) return false;\n    }\n    return true;\n  }\n\n  askTopic(topicId: string): boolean {\n    const topic = this.getAvailableTopics().find((t) => t.id === topicId);\n    if (!topic || !this.currentNPC) return false;\n\n    this.askedTopics.add(topicId);\n    this.addPressure(5);\n\n    return this.dialogueEngine.start(topic.dialogueId, () => {\n      this.selectedTopicIndex = -1;\n    });\n  }\n\n  presentEvidence(evidenceId: string): boolean {\n    if (!this.currentNPC) return false;\n    this.addPressure(8);\n\n    const topic = this.getAvailableTopics().find(\n      (t) => t.requiresEvidence?.includes(evidenceId)\n    );\n    if (topic) {\n      return this.askTopic(topic.id);\n    }\n    return false;\n  }\n\n  private setupInput() {\n    this.input.onClick((e) => {\n      if (e.type !== 'up') return;\n      if (!this.isInterrogating) return;\n      if (this.dialogueEngine.getIsActive()) return;\n      if (this.showingEvidenceSelect) {\n        this.handleEvidenceClick(e.x, e.y);\n        return;\n      }\n      this.handleTopicClick(e.x, e.y);\n    });\n  }\n\n  private handleTopicClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    const panelX = w * 0.1;\n    const panelW = w * 0.8;\n    const topicY = h * 0.35;\n\n    const topics = this.getAvailableTopics();\n    for (let i = 0; i < topics.length; i++) {\n      const ty = topicY + i * 48;\n      if (this.isInRect(x, y, panelX + 20, ty, panelW - 40, 40)) {\n        this.askTopic(topics[i].id);\n        return;\n      }\n    }\n\n    const presentY = h * 0.78;\n    if (this.isInRect(x, y, panelX + 20, presentY, (panelW - 60) / 2, 40)) {\n      this.showingEvidenceSelect = true;\n      this.evidenceSelectFor = 'present';\n      return;\n    }\n\n    const endY = h * 0.78;\n    const endX = panelX + 20 + (panelW - 60) / 2 + 20;\n    if (this.isInRect(x, y, endX, endY, (panelW - 60) / 2, 40)) {\n      this.endInterrogation();\n    }\n  }\n\n  private handleEvidenceClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    const items = this.state.evidence;\n    const panelX = w * 0.2;\n    const panelW = w * 0.6;\n    const listY = h * 0.2;\n\n    for (let i = 0; i < items.length; i++) {\n      const iy = listY + i * 44;\n      if (this.isInRect(x, y, panelX + 10, iy, panelW - 20, 38)) {\n        this.showingEvidenceSelect = false;\n        this.presentEvidence(items[i]);\n        return;\n      }\n    }\n\n    if (this.isInRect(x, y, w * 0.4, h * 0.85, w * 0.2, 40)) {\n      this.showingEvidenceSelect = false;\n    }\n  }\n\n  update(dt: number) {\n    if (!this.isInterrogating) return;\n    this.animAlpha = Math.min(1, this.animAlpha + dt * 5);\n  }\n\n  render() {\n    if (!this.isInterrogating) return;\n    if (this.dialogueEngine.getIsActive()) return;\n\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.save();\n    ctx.globalAlpha = this.animAlpha * 0.7;\n    ctx.fillStyle = '#0a0806';\n    ctx.fillRect(0, 0, w, h);\n    ctx.restore();\n\n    ctx.save();\n    ctx.globalAlpha = this.animAlpha;\n\n    const panelX = w * 0.1;\n    const panelW = w * 0.8;\n    const panelY = h * 0.08;\n    const panelH = h * 0.84;\n\n    this.renderer.drawRoundRect(panelX, panelY, panelW, panelH, 8, '#1a140e', '#3a2a1a');\n    ctx.strokeStyle = '#5a4030';\n    ctx.lineWidth = 1;\n    ctx.strokeRect(panelX + 3, panelY + 3, panelW - 6, panelH - 6);\n\n    if (this.currentNPC) {\n      this.renderer.drawText(`审问：${this.currentNPC.name}`, panelX + panelW / 2, panelY + 18, {\n        font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n        color: '#c8a882', align: 'center',\n      });\n\n      this.renderPressureBar(ctx, panelX + 30, panelY + 55, panelW - 60);\n\n      this.renderer.drawText('选择话题：', panelX + 30, h * 0.32, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870',\n      });\n\n      const topics = this.getAvailableTopics();\n      topics.forEach((topic, i) => {\n        const ty = h * 0.35 + i * 48;\n        const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + 20, ty, panelW - 40, 40);\n\n        if (isHover) {\n          ctx.fillStyle = 'rgba(200, 168, 130, 0.1)';\n          ctx.fillRect(panelX + 20, ty, panelW - 40, 40);\n        }\n\n        ctx.strokeStyle = '#3a2a1a';\n        ctx.lineWidth = 1;\n        ctx.strokeRect(panelX + 20, ty, panelW - 40, 40);\n\n        const asked = this.askedTopics.has(topic.id);\n        this.renderer.drawText(\n          `${asked ? '✓ ' : '  '}${topic.label}`,\n          panelX + 35, ty + 10,\n          {\n            font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n            color: asked ? '#5a4a3a' : isHover ? '#f0d8b0' : '#d8c8b0',\n          }\n        );\n      });\n\n      if (topics.length === 0) {\n        this.renderer.drawText('没有可问的话题', panelX + panelW / 2, h * 0.45, {\n          font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n        });\n      }\n\n      const btnW = (panelW - 60) / 2;\n      const btnY = h * 0.78;\n\n      const presentHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + 20, btnY, btnW, 40);\n      this.renderer.drawRoundRect(panelX + 20, btnY, btnW, 40, 4,\n        presentHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n      this.renderer.drawText('出示物证', panelX + 20 + btnW / 2, btnY + 10, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n        color: presentHover ? '#e8c8a2' : '#a08870', align: 'center',\n      });\n\n      const endX = panelX + 20 + btnW + 20;\n      const endHover = this.isInRect(this.input.mouseX, this.input.mouseY, endX, btnY, btnW, 40);\n      this.renderer.drawRoundRect(endX, btnY, btnW, 40, 4,\n        endHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n      this.renderer.drawText('结束审问', endX + btnW / 2, btnY + 10, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n        color: endHover ? '#e8c8a2' : '#a08870', align: 'center',\n      });\n    }\n\n    ctx.restore();\n\n    if (this.showingEvidenceSelect) {\n      this.renderEvidenceSelect(ctx, w, h);\n    }\n  }\n\n  private renderPressureBar(ctx: CanvasRenderingContext2D, x: number, y: number, w: number) {\n    if (!this.currentNPC) return;\n\n    this.renderer.drawText('压力：', x, y, {\n      font: '15px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a',\n    });\n\n    const barX = x + 50;\n    const barW = w - 50;\n    const barH = 12;\n\n    ctx.fillStyle = '#2a1a0e';\n    ctx.fillRect(barX, y + 2, barW, barH);\n\n    const ratio = this.pressure / this.currentNPC.maxPressure;\n    const pressureColor = ratio < 0.4 ? '#4a8a4a' : ratio < 0.7 ? '#c8a040' : '#8a3a3a';\n    ctx.fillStyle = pressureColor;\n    ctx.fillRect(barX, y + 2, barW * ratio, barH);\n\n    ctx.strokeStyle = '#3a2a1a';\n    ctx.lineWidth = 1;\n    ctx.strokeRect(barX, y + 2, barW, barH);\n\n    const relKey = Object.keys(this.state.relationships).find((k) =>\n      this.currentNPC && k === this.currentNPC.id.replace('_', '')\n    );\n    if (relKey) {\n      this.renderer.drawText(`好感: ${this.state.relationships[relKey]}`, barX + barW + 10, y, {\n        font: '14px sans-serif', color: '#8a7a6a',\n      });\n    }\n  }\n\n  private renderEvidenceSelect(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    ctx.save();\n    ctx.globalAlpha = 0.9;\n    ctx.fillStyle = '#0a0806';\n    ctx.fillRect(0, 0, w, h);\n    ctx.restore();\n\n    const panelX = w * 0.2;\n    const panelW = w * 0.6;\n    const panelY = h * 0.1;\n    const panelH = h * 0.75;\n\n    this.renderer.drawRoundRect(panelX, panelY, panelW, panelH, 8, '#1a140e', '#5a4030');\n    this.renderer.drawText('选择要出示的物证', panelX + panelW / 2, panelY + 18, {\n      font: 'bold 22px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    const items = this.state.evidence;\n    const listY = h * 0.2;\n\n    items.forEach((evId, i) => {\n      const iy = listY + i * 44;\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + 10, iy, panelW - 20, 38);\n\n      if (isHover) {\n        ctx.fillStyle = 'rgba(200, 168, 130, 0.12)';\n        ctx.fillRect(panelX + 10, iy, panelW - 20, 38);\n      }\n\n      this.renderer.drawText(`▪ ${evId}`, panelX + 25, iy + 8, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n        color: isHover ? '#f0d8b0' : '#d8c8b0',\n      });\n    });\n\n    if (items.length === 0) {\n      this.renderer.drawText('没有可出示的物证', panelX + panelW / 2, listY + 30, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n      });\n    }\n\n    const cancelHover = this.isInRect(this.input.mouseX, this.input.mouseY, w * 0.4, h * 0.85, w * 0.2, 40);\n    this.renderer.drawRoundRect(w * 0.4, h * 0.85, w * 0.2, 40, 4,\n      cancelHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('取消', w / 2, h * 0.85 + 10, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n      color: cancelHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n  }\n\n  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n  }\n}\n","numLines":395,"startLine":1,"totalLines":395}}}
