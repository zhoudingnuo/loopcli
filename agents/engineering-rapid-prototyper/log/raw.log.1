);\n\n  // Step 3: Upload icon via file chooser\n  console.log('Step 3: Upload icon...');\n  const uploadAddBtn = page.locator('[class*=\"upload-add\"], [class*=\"upload-picture-add\"]').first();\n  const [fileChooser] = await Promise.all([\n    page.waitForEvent('filechooser', { timeout: 10000 }),\n    uploadAddBtn.click(),\n  ]);\n  await fileChooser.setFiles(ICON_PATH);\n  console.log('Icon selected, waiting for upload...');\n  await page.waitForTimeout(8000);\n\n  // Close any upload result modal\n  await page.keyboard.press('Escape');\n  await page.waitForTimeout(500);\n  if (await knowBtn.isVisible().catch(() => false)) {\n    await knowBtn.click();\n    await page.waitForTimeout(500);\n  }\n\n  // Step 4: Fill detailed description\n  console.log('Step 4: Fill detailed description...');\n  await page.locator('#introduction').fill(GAME_INTRO);\n\n  // Step 5: Select game category\n  console.log('Step 5: Select game category...');\n  const treeSelect = await page.$('.semi-dy-open-tree-select');\n  if (treeSelect) {\n    await treeSelect.click();\n    await page.waitForTimeout(1000);\n\n    const clicked = await page.evaluate(() => {\n      const nodes = document.querySelectorAll('.semi-dy-open-tree-option');\n      for (const node of nodes) {\n        const text = node.textContent?.trim();\n        if (text === '休闲益智') {\n          node.dispatchEvent(new MouseEvent('click', { bubbles: true }));\n          return text;\n        }\n      }\n      return null;\n    });\n    console.log('Category selected:', clicked);\n    await page.waitForTimeout(1000);\n  }\n\n  // Step 6: Select theme tags\n  console.log('Step 6: Select theme tags...');\n  // Theme tags use a regular select, find the one in the theme section\n  const themeSelected = await page.evaluate(() => {\n    // Find the theme tag section's select\n    const selects = document.querySelectorAll('.semi-dy-open-select');\n    for (const sel of selects) {\n      const placeholder = sel.querySelector('.semi-dy-open-select-selection-placeholder');\n      if (placeholder?.textContent?.includes('题材标签')) {\n        sel.dispatchEvent(new MouseEvent('click', { bubbles: true }));\n        return 'clicked theme select';\n      }\n    }\n    return null;\n  });\n  console.log('Theme select:', themeSelected);\n\n  if (themeSelected) {\n    await page.waitForTimeout(1500);\n    // The theme dropdown should now be open, select \"休闲益智\"\n    const themeClicked = await page.evaluate(() => {\n      const options = document.querySelectorAll('.semi-dy-open-select-option');\n      for (const opt of options) {\n        const text = opt.textContent?.trim();\n        if (text === '休闲益智') {\n          opt.dispatchEvent(new MouseEvent('click', { bubbles: true }));\n          return text;\n        }\n      }\n      return null;\n    });\n    console.log('Theme selected:', themeClicked);\n    await page.waitForTimeout(1000);\n  }\n\n  // Close any dropdown\n  await page.keyboard.press('Escape');\n  await page.waitForTimeout(500);\n\n  // Step 7: Select special mechanism tags (optional)\n  console.log('Step 7: Check special mechanism tags...');\n  const specialTags = await page.evaluate(() => {\n    const selects = document.querySelectorAll('.semi-dy-open-select');\n    for (const sel of selects) {\n      const placeholder = sel.querySelector('.semi-dy-open-select-selection-placeholder');\n      if (placeholder?.textContent?.includes('特殊机制标签')) {\n        sel.dispatchEvent(new MouseEvent('click', { bubbles: true }));\n        return 'clicked';\n      }\n    }\n    return null;\n  });\n  if (specialTags) {\n    await page.waitForTimeout(1000);\n    // Just close it - it's optional\n    await page.keyboard.press('Escape');\n    await page.waitForTimeout(500);\n  }\n\n  await page.screenshot({ path: 'D:/game-projects/douyin-match3/screenshots/30-form-complete.png', fullPage: true });\n\n  // Check for validation errors\n  const errors = await page.$$eval('[class*=\"error-message\"]', els =>\n    els.map(e => e.textContent?.trim()).filter(t => t)\n  );\n  console.log('Validation errors:', errors);\n\n  // Check upload status\n  const uploadOk = await page.evaluate(() => {\n    const uploadSuccess = document.querySelector('[class*=\"upload\"] [class*=\"success\"]');\n    const uploadError = document.querySelector('[class*=\"upload\"] [class*=\"error\"]');\n    const iconPreview = document.querySelector('[class*=\"upload\"] img, [class*=\"upload\"] [class*=\"preview\"]');\n    return {\n      hasSuccess: !!uploadSuccess,\n      hasError: !!uploadError,\n      hasPreview: !!iconPreview,\n      errorText: uploadError?.textContent?.trim(),\n    };\n  });\n  console.log('Upload status:', JSON.stringify(uploadOk));\n\n  // Step 8: Save as draft first\n  console.log('Step 8: Save as draft...');\n  const draftBtn = page.locator('button:has-text(\"存为草稿\")');\n  await draftBtn.scrollIntoViewIfNeeded();\n  await page.waitForTimeout(500);\n\n  // Check if submit is possible\n  const submitEnabled = await page.locator('button:has-text(\"提交审核\")').isEnabled().catch(() => false);\n  console.log('Submit enabled:', submitEnabled);\n\n  await draftBtn.click({ force: true });\n  await page.waitForTimeout(8000);\n\n  await page.screenshot({ path: 'D:/game-projects/douyin-match3/screenshots/31-after-draft.png', fullPage: true });\n\n  // Check result\n  const resultErrors = await page.$$eval('[class*=\"error-message\"]', els =>\n    els.map(e => e.textContent?.trim()).filter(t => t)\n  );\n  console.log('Errors after save:', resultErrors);\n\n  // Check for success toast or redirect\n  const currentUrl = page.url();\n  console.log('Current URL:', currentUrl);\n\n  // Check the page text for any success/error indication\n  const bodySnippet = await page.evaluate(() => document.body.innerText.substring(0, 500));\n  if (bodySnippet.includes('成功') || bodySnippet.includes('success')) {\n    console.log('SUCCESS detected in page');\n  }\n  if (bodySnippet.includes('失败') || bodySnippet.includes('error')) {\n    console.log('ERROR detected in page');\n  }\n\n  // Try to submit for review if draft saved successfully\n  if (resultErrors.length === 0) {\n    console.log('Step 9: Try submitting for review...');\n    const submitBtn = page.locator('button:has-text(\"提交审核\")');\n    if (await submitBtn.isVisible().catch(() => false)) {\n      await submitBtn.scrollIntoViewIfNeeded();\n      await page.waitForTimeout(500);\n      await submitBtn.click({ force: true });\n      await page.waitForTimeout(5000);\n      console.log('After submit URL:', page.url());\n      await page.screenshot({ path: 'D:/game-projects/douyin-match3/screenshots/32-after-submit.png', fullPage: true });\n    }\n  }\n\n  await context.close();\n  console.log('=== Done ===');\n})();\n","structuredPatch":[],"originalFile":null,"userModified":false}}
