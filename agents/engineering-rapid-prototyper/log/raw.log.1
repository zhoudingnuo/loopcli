{"type":"assistant","message":{"id":"msg_20260524015749c2b0508436b74c56","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_4ed122b6d30746049d81754e","name":"Write","input":{"file_path":"D:\\game-projects\\steam-ancient-mystery\\src\\renderer\\App.ts","content":"import { Renderer } from './Renderer';\nimport { SceneManager } from '../game/SceneManager';\nimport { GameState } from '../game/GameState';\nimport { DialogueEngine } from '../game/DialogueEngine';\nimport { UIManager } from './UI/UIManager';\nimport { InputManager } from '../game/InputManager';\nimport { AudioManager } from '../audio/AudioManager';\n\nexport class App {\n  private renderer: Renderer;\n  private sceneManager: SceneManager;\n  private gameState: GameState;\n  private dialogueEngine: DialogueEngine;\n  private ui: UIManager;\n  private input: InputManager;\n  private audio: AudioManager;\n  private lastTime = 0;\n  private running = false;\n\n  constructor(private canvas: HTMLCanvasElement) {\n    const ctx = canvas.getContext('2d')!;\n    this.renderer = new Renderer(ctx, canvas);\n    this.gameState = new GameState();\n    this.sceneManager = new SceneManager(this.renderer, this.gameState);\n    this.dialogueEngine = new DialogueEngine(this.gameState);\n    this.input = new InputManager(canvas);\n    this.audio = new AudioManager();\n\n    this.ui = new UIManager(\n      this.renderer,\n      this.sceneManager,\n      this.dialogueEngine,\n      this.gameState,\n      this.input,\n      this.audio,\n    );\n\n    this.resize();\n    window.addEventListener('resize', () => this.resize());\n  }\n\n  private resize() {\n    const dpr = window.devicePixelRatio || 1;\n    const w = window.innerWidth;\n    const h = window.innerHeight;\n    this.canvas.width = w * dpr;\n    this.canvas.height = h * dpr;\n    this.canvas.style.width = w + 'px';\n    this.canvas.style.height = h + 'px';\n    this.renderer.setSize(w, h, dpr);\n    this.ui.resize(w, h);\n  }\n\n  start() {\n    this.running = true;\n    this.lastTime = performance.now();\n    requestAnimationFrame((t) => this.loop(t));\n  }\n\n  private loop(now: number) {\n    if (!this.running) return;\n    const dt = Math.min((now - this.lastTime) / 1000, 0.05);\n    this.lastTime = now;\n\n    this.update(dt);\n    this.render();\n\n    requestAnimationFrame((t) => this.loop(t));\n  }\n\n  private update(dt: number) {\n    this.sceneManager.update(dt);\n    this.dialogueEngine.update(dt);\n    this.audio.update(dt);\n    this.ui.update(dt);\n  }\n\n  private render() {\n    this.renderer.clear();\n    this.sceneManager.render();\n    this.ui.render();\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"60e8bd2a-b118-4ebb-8072-7fe7ed523870","uuid":"01d5fed4-b5da-41ef-8c70-fd8f611222a6"}
