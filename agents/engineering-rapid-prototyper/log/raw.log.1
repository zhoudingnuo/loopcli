ps };\n    this.playTime = slot.playTime;\n    this.completedChapters = slot.completedChapters ? [...slot.completedChapters] : [];\n    this.chapterProgress = slot.chapterProgress ? JSON.parse(JSON.stringify(slot.chapterProgress)) : {};\n  }","originalFile":"export interface SaveSlot {\n  id: number;\n  chapter: number;\n  scene: string;\n  timestamp: number;\n  playTime: number;\n  flags: Record<string, boolean>;\n  evidence: string[];\n  choices: Record<string, string>;\n  relationships: Record<string, number>;\n  completedChapters: number[];\n  chapterProgress: Record<number, { phase: string; evidenceFound: string[] }>;\n}\n\nexport class GameState {\n  chapter = 1;\n  scene = 'main_menu';\n  flags: Record<string, boolean> = {};\n  evidence: string[] = [];\n  choices: Record<string, string> = {};\n  relationships: Record<string, number> = {\n    pei_ruyi: 50,\n    liu_qiniang: 50,\n    zhang_tieshou: 50,\n    facheng: 50,\n  };\n  playTime = 0;\n  completedChapters: number[] = [];\n  chapterProgress: Record<number, { phase: string; evidenceFound: string[] }> = {};\n  settings = {\n    textSpeed: 40,\n    autoPlay: false,\n    volume: { master: 0.8, bgm: 0.7, sfx: 0.8, ambient: 0.6 },\n  };\n\n  setFlag(key: string, value: boolean) { this.flags[key] = value; }\n  getFlag(key: string): boolean { return this.flags[key] ?? false; }\n\n  addEvidence(id: string) {\n    if (!this.evidence.includes(id)) this.evidence.push(id);\n  }\n  hasEvidence(id: string): boolean { return this.evidence.includes(id); }\n\n  setChoice(key: string, value: string) { this.choices[key] = value; }\n  getChoice(key: string): string | undefined { return this.choices[key]; }\n\n  setRelationship(npc: string, delta: number) {\n    this.relationships[npc] = Math.max(0, Math.min(100, (this.relationships[npc] ?? 50) + delta));\n  }\n\n  completeChapter(chapter: number) {\n    if (!this.completedChapters.includes(chapter)) {\n      this.completedChapters.push(chapter);\n    }\n    this.setFlag(`chapter_${chapter}_complete`, true);\n    this.setChoice('completed_chapters', this.completedChapters.join(','));\n  }\n\n  isChapterComplete(chapter: number): boolean {\n    return this.completedChapters.includes(chapter);\n  }\n\n  setChapterProgress(chapter: number, phase: string) {\n    if (!this.chapterProgress[chapter]) {\n      this.chapterProgress[chapter] = { phase: 'start', evidenceFound: [] };\n    }\n    this.chapterProgress[chapter].phase = phase;\n  }\n\n  getChapterProgress(chapter: number): { phase: string; evidenceFound: string[] } | undefined {\n    return this.chapterProgress[chapter];\n  }\n\n  toSaveSlot(id: number): SaveSlot {\n    return {\n      id,\n      chapter: this.chapter,\n      scene: this.scene,\n      timestamp: Date.now(),\n      playTime: this.playTime,\n      flags: { ...this.flags },\n      evidence: [...this.evidence],\n      choices: { ...this.choices },\n      relationships: { ...this.relationships },\n    };\n  }\n\n  loadFromSlot(slot: SaveSlot) {\n    this.chapter = slot.chapter;\n    this.scene = slot.scene;\n    this.flags = { ...slot.flags };\n    this.evidence = [...slot.evidence];\n    this.choices = { ...slot.choices };\n    this.relationships = { ...slot.relationships };\n    this.playTime = slot.playTime;\n  }\n}\n","structuredPatch":[{"oldStart":82,"oldLines":6,"newStart":82,"newLines":8,"lines":["       evidence: [...this.evidence],","       choices: { ...this.choices },","       relationships: { ...this.relationships },","+      completedChapters: [...this.completedChapters],","+      chapterProgress: JSON.parse(JSON.stringify(this.chapterProgress)),","     };","   }"," "]},{"oldStart":93,"oldLines":5,"newStart":95,"newLines":7,"lines":["     this.choices = { ...slot.choices };","     this.relationships = { ...slot.relationships };","     this.playTime = slot.playTime;","+    this.completedChapters = slot.completedChapters ? [...slot.completedChapters] : [];","+    this.chapterProgress = slot.chapterProgress ? JSON.parse(JSON.stringify(slot.chapterProgress)) : {};","   }"," }"]}],"userModified":false,"replaceAll":false}}
