g; volume: number; loop: boolean }[];\n}\n\nexport interface SFXTrigger {\n  id: string;\n  trigger: string;\n  sound: string;\n}\n\nexport class ChapterManager {\n  private chapters: Map<number, ChapterData> = new Map();\n  private currentChapter: ChapterData | null = null;\n  private chapterFlags: Record<number, Record<string, boolean>> = {};\n  private completedChapters: Set<number> = new Set();\n\n  constructor(private state: GameState) {\n    const saved = state.getChoice('completed_chapters');\n    if (saved) {\n      saved.split(',').forEach((c) => {\n        const n = parseInt(c);\n        if (!isNaN(n)) this.completedChapters.add(n);\n      });\n    }\n  }\n\n  registerChapter(data: ChapterData) {\n    this.chapters.set(data.chapter, data);\n  }\n\n  loadChapter(chapterNum: number): ChapterData | null {\n    const data = this.chapters.get(chapterNum);\n    if (!data) return null;\n\n    this.currentChapter = data;\n    this.state.chapter = chapterNum;\n\n    if (!this.chapterFlags[chapterNum]) {\n      this.chapterFlags[chapterNum] = {};\n    }\n\n    return data;\n  }\n\n  injectIntoSystems(\n    data: ChapterData,\n    dialogueEngine: DialogueEngine,\n    sceneExplorer: SceneExplorer,\n    evidenceCollector: EvidenceCollector,\n    interrogation: InterrogationSystem,\n    combiner: EvidenceCombiner,\n    reasoning: ReasoningBoard,\n  ) {\n    dialogueEngine.loadDialogue(data.dialogue);\n    evidenceCollector.registerEvidence(data.evidence);\n\n    data.exploreScenes.forEach((s) => sceneExplorer.registerScene(s));\n\n    data.npcs.forEach((n) => interrogation.registerNPC(n));\n    interrogation.registerTopics(data.topics);\n\n    combiner.registerRecipes(data.recipes);\n\n    reasoning.registerNodes(data.reasoningNodes);\n    reasoning.registerLinks(data.reasoningLinks);\n    data.hypotheses.forEach((h) => reasoning.registerHypothesis(h));\n  }\n\n  completeChapter(chapterNum: number) {\n    this.completedChapters.add(chapterNum);\n    this.state.setChoice('completed_chapters', [...this.completedChapters].join(','));\n    this.state.setFlag(`chapter_${chapterNum}_complete`, true);\n  }\n\n  isChapterComplete(chapterNum: number): boolean {\n    return this.completedChapters.has(chapterNum);\n  }\n\n  getCurrentChapter(): ChapterData | null {\n    return this.currentChapter;\n  }\n\n  getCompletedChapters(): number[] {\n    return [...this.completedChapters].sort();\n  }\n\n  getNextChapter(): number {\n    for (let i = 1; i <= 5; i++) {\n      if (!this.completedChapters.has(i)) return i;\n    }\n    return -1;\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
