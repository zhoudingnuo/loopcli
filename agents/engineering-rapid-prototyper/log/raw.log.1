{"type":"assistant","message":{"id":"msg_202605240149540a774a74f28a4b39","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_3e00447171a94bff8ebaea71","name":"Write","input":{"file_path":"D:\\game-projects\\steam-ancient-mystery\\src\\game\\ChapterManager.ts","content":"import { GameState } from './GameState';\nimport { DialogueEngine, DialogueNode } from './DialogueEngine';\nimport { SceneExplorer, ExploreScene } from './SceneExplorer';\nimport { EvidenceCollector, EvidenceItem } from './EvidenceCollector';\nimport { InterrogationSystem, InterrogationNPC, InterrogationTopic } from './InterrogationSystem';\nimport { EvidenceCombiner, CombinationRecipe } from './EvidenceCombiner';\nimport { ReasoningBoard, ReasoningNode, ReasoningLink, ReasoningHypothesis } from './ReasoningBoard';\nimport { TrialLoop, TrialConfig } from './TrialLoop';\n\nexport interface ChapterSceneDef {\n  id: string;\n  background: string;\n  ambientColor?: string;\n  lighting?: { x: number; y: number; radius: number; intensity: number };\n}\n\nexport interface ChapterData {\n  id: string;\n  chapter: number;\n  title: string;\n  subtitle: string;\n  version: string;\n  scenes: ChapterSceneDef[];\n  dialogue: DialogueNode[];\n  evidence: EvidenceItem[];\n  exploreScenes: ExploreScene[];\n  npcs: InterrogationNPC[];\n  topics: InterrogationTopic[];\n  recipes: CombinationRecipe[];\n  reasoningNodes: ReasoningNode[];\n  reasoningLinks: ReasoningLink[];\n  hypotheses: ReasoningHypothesis[];\n  trial: TrialConfig;\n  introDialogue: string;\n  ambientConfig: AmbientConfig;\n  sfxTriggers: SFXTrigger[];\n}\n\nexport interface AmbientConfig {\n  baseTrack: string;\n  layers: { id: string; volume: number; loop: boolean }[];\n}\n\nexport interface SFXTrigger {\n  id: string;\n  trigger: string;\n  sound: string;\n}\n\nexport class ChapterManager {\n  private chapters: Map<number, ChapterData> = new Map();\n  private currentChapter: ChapterData | null = null;\n  private chapterFlags: Record<number, Record<string, boolean>> = {};\n  private completedChapters: Set<number> = new Set();\n\n  constructor(private state: GameState) {\n    const saved = state.getChoice('completed_chapters');\n    if (saved) {\n      saved.split(',').forEach((c) => {\n        const n = parseInt(c);\n        if (!isNaN(n)) this.completedChapters.add(n);\n      });\n    }\n  }\n\n  registerChapter(data: ChapterData) {\n    this.chapters.set(data.chapter, data);\n  }\n\n  loadChapter(chapterNum: number): ChapterData | null {\n    const data = this.chapters.get(chapterNum);\n    if (!data) return null;\n\n    this.currentChapter = data;\n    this.state.chapter = chapterNum;\n\n    if (!this.chapterFlags[chapterNum]) {\n      this.chapterFlags[chapterNum] = {};\n    }\n\n    return data;\n  }\n\n  injectIntoSystems(\n    data: ChapterData,\n    dialogueEngine: DialogueEngine,\n    sceneExplorer: SceneExplorer,\n    evidenceCollector: EvidenceCollector,\n    interrogation: InterrogationSystem,\n    combiner: EvidenceCombiner,\n    reasoning: ReasoningBoard,\n  ) {\n    dialogueEngine.loadDialogue(data.dialogue);\n    evidenceCollector.registerEvidence(data.evidence);\n\n    data.exploreScenes.forEach((s) => sceneExplorer.registerScene(s));\n\n    data.npcs.forEach((n) => interrogation.registerNPC(n));\n    interrogation.registerTopics(data.topics);\n\n    combiner.registerRecipes(data.recipes);\n\n    reasoning.registerNodes(data.reasoningNodes);\n    reasoning.registerLinks(data.reasoningLinks);\n    data.hypotheses.forEach((h) => reasoning.registerHypothesis(h));\n  }\n\n  completeChapter(chapterNum: number) {\n    this.completedChapters.add(chapterNum);\n    this.state.setChoice('completed_chapters', [...this.completedChapters].join(','));\n    this.state.setFlag(`chapter_${chapterNum}_complete`, true);\n  }\n\n  isChapterComplete(chapterNum: number): boolean {\n    return this.completedChapters.has(chapterNum);\n  }\n\n  getCurrentChapter(): ChapterData | null {\n    return this.currentChapter;\n  }\n\n  getCompletedChapters(): number[] {\n    return [...this.completedChapters].sort();\n  }\n\n  getNextChapter(): number {\n    for (let i = 1; i <= 5; i++) {\n      if (!this.completedChapters.has(i)) return i;\n    }\n    return -1;\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"60e8bd2a-b118-4ebb-8072-7fe7ed523870","uuid":"f8ef1771-9e57-4341-91f5-9bce01e19ce2"}
