{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_b996b7f41a5d45a2b9dd236f","type":"tool_result","content":"1\timport { GameState } from './GameState';\n2\t\n3\texport interface DialogueNode {\n4\t  id: string;\n5\t  speaker?: string;\n6\t  text: string;\n7\t  portrait?: string;\n8\t  next?: string;\n9\t  choices?: DialogueChoice[];\n10\t  condition?: { flag?: string; evidence?: string; choice?: string };\n11\t  setFlags?: string[];\n12\t  addEvidence?: string[];\n13\t  setChoice?: { key: string; value: string };\n14\t  effects?: { relationship?: { npc: string; delta: number } };\n15\t}\n16\t\n17\texport interface DialogueChoice {\n18\t  text: string;\n19\t  next: string;\n20\t  condition?: { flag?: string; evidence?: string };\n21\t}\n22\t\n23\texport class DialogueEngine {\n24\t  private nodes: Map<string, DialogueNode> = new Map();\n25\t  private currentNode: DialogueNode | null = null;\n26\t  private displayText = '';\n27\t  private charIndex = 0;\n28\t  private charsPerSecond = 40;\n29\t  private isTyping = false;\n30\t  private isActive = false;\n31\t  private onEndCallback: (() => void) | null = null;\n32\t\n33\t  constructor(private state: GameState) {\n34\t    this.charsPerSecond = state.settings.textSpeed;\n35\t  }\n36\t\n37\t  loadDialogue(nodes: DialogueNode[]) {\n38\t    this.nodes.clear();\n39\t    nodes.forEach((n) => this.nodes.set(n.id, n));\n40\t  }\n41\t\n42\t  start(nodeId: string, onEnd?: () => void): boolean {\n43\t    const node = this.nodes.get(nodeId);\n44\t    if (!node) return false;\n45\t    this.currentNode = node;\n46\t    this.isActive = true;\n47\t    this.onEndCallback = onEnd ?? null;\n48\t\n49\t    if (node.condition) {\n50\t      if (node.condition.flag && !this.state.getFlag(node.condition.flag)) return this.advance();\n51\t      if (node.condition.evidence && !this.state.hasEvidence(node.condition.evidence)) return this.advance();\n52\t      if (node.condition.choice && !this.state.getChoice(node.condition.choice)) return this.advance();\n53\t    }\n54\t\n55\t    this.applyEffects(node);\n56\t    this.displayText = node.text;\n57\t    this.charIndex = 0;\n58\t    this.isTyping = true;\n59\t    return true;\n60\t  }\n61\t\n62\t  private applyEffects(node: DialogueNode) {\n63\t    node.setFlags?.forEach((f) => this.state.setFlag(f, true));\n64\t    node.addEvidence?.forEach((e) => this.state.addEvidence(e));\n65\t    if (node.setChoice) this.state.setChoice(node.setChoice.key, node.setChoice.value);\n66\t    if (node.effects?.relationship) {\n67\t      const r = node.effects.relationship;\n68\t      this.state.setRelationship(r.npc, r.delta);\n69\t    }\n70\t  }\n71\t\n72\t  advance(): boolean {\n73\t    if (!this.currentNode) return false;\n74\t    if (this.isTyping) {\n75\t      this.charIndex = this.displayText.length;\n76\t      this.isTyping = false;\n77\t      return true;\n78\t    }\n79\t    if (this.currentNode.choices && this.currentNode.choices.length > 0) return false;\n80\t    if (this.currentNode.next) return this.start(this.currentNode.next, this.onEndCallback ?? undefined);\n81\t    this.isActive = false;\n82\t    this.currentNode = null;\n83\t    this.onEndCallback?.();\n84\t    return false;\n85\t  }\n86\t\n87\t  selectChoice(index: number): boolean {\n88\t    if (!this.currentNode?.choices) return false;\n89\t    const choice = this.currentNode.choices[index];\n90\t    if (!choice) return false;\n91\t    if (choice.condition) {\n92\t      if (choice.condition.flag && !this.state.getFlag(choice.condition.flag)) return false;\n93\t      if (choice.condition.evidence && !this.state.hasEvidence(choice.condition.evidence)) return false;\n94\t    }\n95\t    return this.start(choice.next, this.onEndCallback ?? undefined);\n96\t  }\n97\t\n98\t  update(dt: number) {\n99\t    if (!this.isTyping || !this.currentNode) return;\n100\t    this.charIndex += this.charsPerSecond * dt;\n101\t    if (this.charIndex >= this.displayText.length) {\n102\t      this.charIndex = this.displayText.length;\n103\t      this.isTyping = false;\n104\t    }\n105\t  }\n106\t\n107\t  getDisplayText(): string { return this.displayText.substring(0, Math.floor(this.charIndex)); }\n108\t  getSpeaker(): string | undefined { return this.currentNode?.speaker; }\n109\t  getPortrait(): string | undefined { return this.currentNode?.portrait; }\n110\t  getChoices(): DialogueChoice[] {\n111\t    return this.currentNode?.choices?.filter((c) => {\n112\t      if (!c.condition) return true;\n113\t      if (c.condition.flag && !this.state.getFlag(c.condition.flag)) return false;\n114\t      if (c.condition.evidence && !this.state.hasEvidence(c.condition.evidence)) return false;\n115\t      return true;\n116\t    }) ?? [];\n117\t  }\n118\t  getIsActive(): boolean { return this.isActive; }\n119\t  getIsTyping(): boolean { return this.isTyping; }\n120\t\n121\t  setSpeed(charsPerSec: number) { this.charsPerSecond = charsPerSec; }\n122\t}\n123\t"}]},"parent_tool_use_id":null,"session_id":"60e8bd2a-b118-4ebb-8072-7fe7ed523870","uuid":"f1e4d58e-23d5-44d1-ab2f-b38191ec9cf8","timestamp":"2026-05-23T17:48:42.134Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-ancient-mystery\\src\\game\\DialogueEngine.ts","content":"import { GameState } from './GameState';\n\nexport interface DialogueNode {\n  id: string;\n  speaker?: string;\n  text: string;\n  portrait?: string;\n  next?: string;\n  choices?: DialogueChoice[];\n  condition?: { flag?: string; evidence?: string; choice?: string };\n  setFlags?: string[];\n  addEvidence?: string[];\n  setChoice?: { key: string; value: string };\n  effects?: { relationship?: { npc: string; delta: number } };\n}\n\nexport interface DialogueChoice {\n  text: string;\n  next: string;\n  condition?: { flag?: string; evidence?: string };\n}\n\nexport class DialogueEngine {\n  private nodes: Map<string, DialogueNode> = new Map();\n  private currentNode: DialogueNode | null = null;\n  private displayText = '';\n  private charIndex = 0;\n  private charsPerSecond = 40;\n  private isTyping = false;\n  private isActive = false;\n  private onEndCallback: (() => void) | null = null;\n\n  constructor(private state: GameState) {\n    this.charsPerSecond = state.settings.textSpeed;\n  }\n\n  loadDialogue(nodes: DialogueNode[]) {\n    this.nodes.clear();\n    nodes.forEach((n) => this.nodes.set(n.id, n));\n  }\n\n  start(nodeId: string, onEnd?: () => void): boolean {\n    const node = this.nodes.get(nodeId);\n    if (!node) return false;\n    this.currentNode = node;\n    this.isActive = true;\n    this.onEndCallback = onEnd ?? null;\n\n    if (node.condition) {\n      if (node.condition.flag && !this.state.getFlag(node.condition.flag)) return this.advance();\n      if (node.condition.evidence && !this.state.hasEvidence(node.condition.evidence)) return this.advance();\n      if (node.condition.choice && !this.state.getChoice(node.condition.choice)) return this.advance();\n    }\n\n    this.applyEffects(node);\n    this.displayText = node.text;\n    this.charIndex = 0;\n    this.isTyping = true;\n    return true;\n  }\n\n  private applyEffects(node: DialogueNode) {\n    node.setFlags?.forEach((f) => this.state.setFlag(f, true));\n    node.addEvidence?.forEach((e) => this.state.addEvidence(e));\n    if (node.setChoice) this.state.setChoice(node.setChoice.key, node.setChoice.value);\n    if (node.effects?.relationship) {\n      const r = node.effects.relationship;\n      this.state.setRelationship(r.npc, r.delta);\n    }\n  }\n\n  advance(): boolean {\n    if (!this.currentNode) return false;\n    if (this.isTyping) {\n      this.charIndex = this.displayText.length;\n      this.isTyping = false;\n      return true;\n    }\n    if (this.currentNode.choices && this.currentNode.choices.length > 0) return false;\n    if (this.currentNode.next) return this.start(this.currentNode.next, this.onEndCallback ?? undefined);\n    this.isActive = false;\n    this.currentNode = null;\n    this.onEndCallback?.();\n    return false;\n  }\n\n  selectChoice(index: number): boolean {\n    if (!this.currentNode?.choices) return false;\n    const choice = this.currentNode.choices[index];\n    if (!choice) return false;\n    if (choice.condition) {\n      if (choice.condition.flag && !this.state.getFlag(choice.condition.flag)) return false;\n      if (choice.condition.evidence && !this.state.hasEvidence(choice.condition.evidence)) return false;\n    }\n    return this.start(choice.next, this.onEndCallback ?? undefined);\n  }\n\n  update(dt: number) {\n    if (!this.isTyping || !this.currentNode) return;\n    this.charIndex += this.charsPerSecond * dt;\n    if (this.charIndex >= this.displayText.length) {\n      this.charIndex = this.displayText.length;\n      this.isTyping = false;\n    }\n  }\n\n  getDisplayText(): string { return this.displayText.substring(0, Math.floor(this.charIndex)); }\n  getSpeaker(): string | undefined { return this.currentNode?.speaker; }\n  getPortrait(): string | undefined { return this.currentNode?.portrait; }\n  getChoices(): DialogueChoice[] {\n    return this.currentNode?.choices?.filter((c) => {\n      if (!c.condition) return true;\n      if (c.condition.flag && !this.state.getFlag(c.condition.flag)) return false;\n      if (c.condition.evidence && !this.state.hasEvidence(c.condition.evidence)) return false;\n      return true;\n    }) ?? [];\n  }\n  getIsActive(): boolean { return this.isActive; }\n  getIsTyping(): boolean { return this.isTyping; }\n\n  setSpeed(charsPerSec: number) { this.charsPerSecond = charsPerSec; }\n}\n","numLines":123,"startLine":1,"totalLines":123}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_cd7e3e0f1c774eed8cae1f04","type":"tool_result","content":"1\timport { Renderer } from '../renderer/Renderer';\n2\timport { GameState } from './GameState';\n3\timport { InputManager } from './InputManager';\n4\timport { CredibilityScore } from './CredibilityScore';\n5\timport { ObjectionSystem, TestimonyLine, ObjectionResult } from './ObjectionSystem';\n6\t\n7\texport type TrialPhase =\n8\t  | 'opening' | 'witness_intro' | 'testimony' | 'cross_examine'\n9\t  | 'rebuttal' | 'closing' | 'verdict' | 'complete' | 'failed';\n10\t\n11\texport interface TrialWitness {\n12\t  id: string;\n13\t  name: string;\n14\t  portrait?: string;\n15\t  testimonyLines: TestimonyLine[];\n16\t}\n17\t\n18\texport interface TrialConfig {\n19\t  id: string;\n20\t  chapter: number;\n21\t  caseTitle: string;\n22\t  plaintiffName: string;\n23\t  defendantName: string;\n24\t  judgeName: string;\n25\t  witnesses: TrialWitness[];\n26\t  correctVerdict: 'guilty' | 'innocent';\n27\t  onVerdict?: (verdict: string, score: number) => void;\n28\t}\n29\t\n30\texport class TrialLoop {\n31\t  private config: TrialConfig | null = null;\n32\t  private phase: TrialPhase = 'opening';\n33\t  private currentWitnessIndex = 0;\n34\t  private currentLineIndex = 0;\n35\t  private verdict: 'guilty' | 'innocent' | null = null;\n36\t  private animAlpha = 0;\n37\t  private phaseText = '';\n38\t  private phaseTextTimer = 0;\n39\t  private showingPhaseIntro = false;\n40\t  private totalObjections = 0;\n41\t  private correctObjections = 0;\n42\t\n43\t  private isOpen = false;\n44\t\n45\t  private objectionSystem: ObjectionSystem;\n46\t  private credibility: CredibilityScore;\n47\t\n48\t  private onTrialEnd?: (verdict: string, score: number) => void;\n49\t\n50\t  constructor(\n51\t    private renderer: Renderer,\n52\t    private state: GameState,\n53\t    private input: InputManager\n54\t  ) {\n55\t    this.credibility = new CredibilityScore(renderer, state);\n56\t    this.objectionSystem = new ObjectionSystem(renderer, state, input, this.credibility);\n57\t\n58\t    this.objectionSystem.setResultCallback((result) => {\n59\t      this.handleObjectionResult(result);\n60\t    });\n61\t\n62\t    this.setupInput();\n63\t  }\n64\t\n65\t  getCredibility(): CredibilityScore { return this.credibility; }\n66\t  getObjectionSystem(): ObjectionSystem { return this.objectionSystem; }\n67\t  getPhase(): TrialPhase { return this.phase; }\n68\t  getIsOpen(): boolean { return this.isOpen; }\n69\t\n70\t  startTrial(config: TrialConfig) {\n71\t    this.config = config;\n72\t    this.phase = 'opening';\n73\t    this.currentWitnessIndex = 0;\n74\t    this.currentLineIndex = 0;\n75\t    this.verdict = null;\n76\t    this.totalObjections = 0;\n77\t    this.correctObjections = 0;\n78\t    this.isOpen = true;\n79\t    this.animAlpha = 0;\n80\t\n81\t    this.credibility.reset();\n82\t    this.objectionSystem.resetPressure();\n83\t\n84\t    this.showPhaseText('开堂');\n85\t    this.showingPhaseIntro = true;\n86\t    this.phaseTextTimer = 2;\n87\t  }\n88\t\n89\t  endTrial() {\n90\t    this.isOpen = false;\n91\t    this.phase = 'complete';\n92\t    this.objectionSystem.hideTestimony();\n93\t  }\n94\t\n95\t  private showPhaseText(text: string) {\n96\t    this.phaseText = text;\n97\t    this.showingPhaseIntro = true;\n98\t    this.phaseTextTimer = 2;\n99\t  }\n100\t\n101\t  private advancePhase() {\n102\t    if (!this.config) return;\n103\t\n104\t    switch (this.phase) {\n105\t      case 'opening':\n106\t        this.phase = 'witness_intro';\n107\t        this.currentWitnessIndex = 0;\n108\t        this.showPhaseText(`证人：${this.config.witnesses[0]?.name ?? ''}`);\n109\t        break;\n110\t\n111\t      case 'witness_intro':\n112\t        this.phase = 'testimony';\n113\t        this.currentLineIndex = 0;\n114\t        this.startCurrentTestimony();\n115\t        break;\n116\t\n117\t      case 'testimony':\n118\t        this.phase = 'cross_examine';\n119\t        this.startCrossExamine();\n120\t        break;\n121\t\n122\t      case 'cross_examine':\n123\t        if (this.currentWitnessIndex < this.config.witnesses.length - 1) {\n124\t          this.currentWitnessIndex++;\n125\t          this.phase = 'witness_intro';\n126\t          this.showPhaseText(`证人：${this.config.witnesses[this.currentWitnessIndex].name}`);\n127\t        } else {\n128\t          this.phase = 'rebuttal';\n129\t          this.showPhaseText('最终辩论');\n130\t        }\n131\t        break;\n132\t\n133\t      case 'rebuttal':\n134\t        this.phase = 'verdict';\n135\t        this.showPhaseText('判决');\n136\t        break;\n137\t\n138\t      case 'verdict':\n139\t        this.phase = 'complete';\n140\t        this.onTrialEnd?.(this.verdict ?? 'innocent', this.credibility.getScore());\n141\t        if (this.config.onVerdict) {\n142\t          this.config.onVerdict(this.verdict ?? 'innocent', this.credibility.getScore());\n143\t        }\n144\t        break;\n145\t    }\n146\t  }\n147\t\n148\t  private startCurrentTestimony() {\n149\t    if (!this.config) return;\n150\t    const witness = this.config.witnesses[this.currentWitnessIndex];\n151\t    if (!witness || this.currentLineIndex >= witness.testimonyLines.length) {\n152\t      this.advancePhase();\n153\t      return;\n154\t    }\n155\t    const line = witness.testimonyLines[this.currentLineIndex];\n156\t    this.objectionSystem.showTestimony(line);\n157\t  }\n158\t\n159\t  private startCrossExamine() {\n160\t    if (!this.config) return;\n161\t    const witness = this.config.witnesses[this.currentWitnessIndex];\n162\t    this.currentLineIndex = 0;\n163\t    if (!witness || witness.testimonyLines.length === 0) {\n164\t      this.advancePhase();\n165\t      return;\n166\t    }\n167\t    const line = witness.testimonyLines[this.currentLineIndex];\n168\t    this.objectionSystem.showTestimony(line);\n169\t  }\n170\t\n171\t  private handleObjectionResult(result: ObjectionResult) {\n172\t    this.totalObjections++;\n173\t    if (result.success) {\n174\t      this.correctObjections++;\n175\t    }\n176\t    this.advanceToNextLine();\n177\t  }\n178\t\n179\t  private advanceToNextLine() {\n180\t    if (!this.config) return;\n181\t    const witness = this.config.witnesses[this.currentWitnessIndex];\n182\t    if (!witness) return;\n183\t\n184\t    this.currentLineIndex++;\n185\t    if (this.currentLineIndex < witness.testimonyLines.length) {\n186\t      const line = witness.testimonyLines[this.currentLineIndex];\n187\t      this.objectionSystem.showTestimony(line);\n188\t    } else {\n189\t      this.objectionSystem.hideTestimony();\n190\t      if (this.phase === 'testimony') {\n191\t        this.advancePhase();\n192\t      } else if (this.phase === 'cross_examine') {\n193\t        this.advancePhase();\n194\t      }\n195\t    }\n196\t  }\n197\t\n198\t  private setupInput() {\n199\t    this.input.onClick((e) => {\n200\t      if (e.type !== 'up') return;\n201\t      if (!this.isOpen) return;\n202\t      if (this.objectionSystem.isTestimonyActive()) return;\n203\t      this.handleClick(e.x, e.y);\n204\t    });\n205\t  }\n206\t\n207\t  private handleClick(x: number, y: number) {\n208\t    if (!this.config) return;\n209\t    const w = this.renderer.w;\n210\t    const h = this.renderer.h;\n211\t\n212\t    if (this.showingPhaseIntro && this.phaseTextTimer <= 0) {\n213\t      this.showingPhaseIntro = false;\n214\t      this.advancePhase();\n215\t      return;\n216\t    }\n217\t\n218\t    if (this.phase === 'verdict') {\n219\t      const centerX = w / 2;\n220\t      const guiltyY = h * 0.45;\n221\t      const innocentY = h * 0.55;\n222\t      const btnW = 200;\n223\t      const btnH = 50;\n224\t\n225\t      if (this.isInRect(x, y, centerX - btnW / 2, guiltyY, btnW, btnH)) {\n226\t        this.verdict = 'guilty';\n227\t        this.showPhaseText(this.verdict === this.config.correctVerdict ? '判决正确！' : '判决有误...');\n228\t        this.advancePhase();\n229\t        return;\n230\t      }\n231\t\n232\t      if (this.isInRect(x, y, centerX - btnW / 2, innocentY, btnW, btnH)) {\n233\t        this.verdict = 'innocent';\n234\t        this.showPhaseText(this.verdict === this.config.correctVerdict ? '判决正确！' : '判决有误...');\n235\t        this.advancePhase();\n236\t        return;\n237\t      }\n238\t    }\n239\t\n240\t    if (this.phase === 'complete') {\n241\t      if (this.isInRect(x, y, w / 2 - 80, h * 0.85, 160, 45)) {\n242\t        this.endTrial();\n243\t      }\n244\t    }\n245\t\n246\t    if (this.phase === 'failed') {\n247\t      this.endTrial();\n248\t    }\n249\t  }\n250\t\n251\t  update(dt: number) {\n252\t    if (!this.isOpen) return;\n253\t    this.animAlpha = Math.min(1, this.animAlpha + dt * 3);\n254\t    if (this.phaseTextTimer > 0) this.phaseTextTimer -= dt;\n255\t    this.credibility.update(dt);\n256\t    this.objectionSystem.update(dt);\n257\t\n258\t    if (!this.credibility.isAlive() && this.phase !== 'complete' && this.phase !== 'failed') {\n259\t      this.phase = 'failed';\n260\t      this.showPhaseText('庭审失败...');\n261\t    }\n262\t  }\n263\t\n264\t  render() {\n265\t    if (!this.isOpen) return;\n266\t\n267\t    const ctx = this.renderer.context;\n268\t    const w = this.renderer.w;\n269\t    const h = this.renderer.h;\n270\t\n271\t    this.renderCourtroom(ctx, w, h);\n272\t\n273\t    this.credibility.renderWarningOverlay();\n274\t\n275\t    if (this.showingPhaseIntro) {\n276\t      this.renderPhaseIntro(ctx, w, h);\n277\t      return;\n278\t    }\n279\t\n280\t    if (this.objectionSystem.isTestimonyActive()) {\n281\t      this.renderWitnessPanel(ctx, w, h);\n282\t      this.objectionSystem.render();\n283\t      return;\n284\t    }\n285\t\n286\t    switch (this.phase) {\n287\t      case 'opening':\n288\t        this.renderOpening(ctx, w, h);\n289\t        break;\n290\t      case 'witness_intro':\n291\t        this.renderWitnessIntro(ctx, w, h);\n292\t        break;\n293\t      case 'testimony':\n294\t        break;\n295\t      case 'cross_examine':\n296\t        break;\n297\t      case 'rebuttal':\n298\t        this.renderRebuttal(ctx, w, h);\n299\t        break;\n300\t      case 'verdict':\n301\t        this.renderVerdict(ctx, w, h);\n302\t        break;\n303\t      case 'complete':\n304\t        this.renderComplete(ctx, w, h);\n305\t        break;\n306\t      case 'failed':\n307\t        this.renderFailed(ctx, w, h);\n308\t        break;\n309\t    }\n310\t  }\n311\t\n312\t  private renderCourtroom(ctx: CanvasRenderingContext2D, w: number, h: number) {\n313\t    const grad = ctx.createLinearGradient(0, 0, 0, h);\n314\t    grad.addColorStop(0, '#1a0a0a');\n315\t    grad.addColorStop(0.5, '#2a1410');\n316\t    grad.addColorStop(1, '#0d0606');\n317\t    ctx.fillStyle = grad;\n318\t    ctx.fillRect(0, 0, w, h);\n319\t\n320\t    ctx.save();\n321\t    ctx.strokeStyle = '#5a3020';\n322\t    ctx.lineWidth = 2;\n323\t    ctx.beginPath();\n324\t    ctx.moveTo(w * 0.1, h * 0.35);\n325\t    ctx.lineTo(w * 0.9, h * 0.35);\n326\t    ctx.stroke();\n327\t    ctx.beginPath();\n328\t    ctx.moveTo(w * 0.1, h * 0.50);\n329\t    ctx.lineTo(w * 0.9, h * 0.50);\n330\t    ctx.stroke();\n331\t    ctx.restore();\n332\t\n333\t    if (this.config) {\n334\t      this.renderer.drawText(this.config.caseTitle, w / 2, h * 0.03, {\n335\t        font: 'bold 20px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n336\t      });\n337\t    }\n338\t\n339\t    this.credibility.render(w - 200, 10, 180);\n340\t  }\n341\t\n342\t  private renderPhaseIntro(ctx: CanvasRenderingContext2D, w: number, h: number) {\n343\t    ctx.save();\n344\t    ctx.globalAlpha = 0.7;\n345\t    ctx.fillStyle = '#0a0806';\n346\t    ctx.fillRect(0, 0, w, h);\n347\t    ctx.restore();\n348\t\n349\t    this.renderer.drawText(this.phaseText, w / 2, h * 0.4, {\n350\t      font: 'bold 42px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n351\t    });\n352\t\n353\t    if (this.phaseTextTimer <= 0) {\n354\t      const blinkAlpha = 0.3 + Math.sin(Date.now() * 0.004) * 0.2;\n355\t      this.renderer.drawText('点击继续', w / 2, h * 0.55, {\n356\t        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center', alpha: blinkAlpha,\n357\t      });\n358\t    }\n359\t  }\n360\t\n361\t  private renderWitnessPanel(ctx: CanvasRenderingContext2D, w: number, h: number) {\n362\t    if (!this.config) return;\n363\t    const witness = this.config.witnesses[this.currentWitnessIndex];\n364\t    if (!witness) return;\n365\t\n366\t    const panelX = w * 0.1;\n367\t    const panelW = w * 0.8;\n368\t    const panelY = h * 0.36;\n369\t\n370\t    ctx.save();\n371\t    ctx.globalAlpha = 0.8;\n372\t    this.renderer.drawRoundRect(panelX, panelY, panelW, 60, 6, '#1a140e', '#3a2a1a');\n373\t    ctx.restore();\n374\t\n375\t    this.renderer.drawText(`证人 ${this.currentWitnessIndex + 1}/${this.config.witnesses.length}：${witness.name}`,\n376\t      panelX + panelW / 2, panelY + 20, {\n377\t        font: 'bold 20px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2', align: 'center',\n378\t      });\n379\t  }\n380\t\n381\t  private renderOpening(ctx: CanvasRenderingContext2D, w: number, h: number) {\n382\t    if (!this.config) return;\n383\t\n384\t    this.renderer.drawText('开堂陈词', w / 2, h * 0.2, {\n385\t      font: 'bold 28px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n386\t    });\n387\t\n388\t    const lines = [\n389\t      `原告：${this.config.plaintiffName}`,\n390\t      `被告：${this.config.defendantName}`,\n391\t      `主审：${this.config.judgeName}`,\n392\t      `证人：${this.config.witnesses.length}人`,\n393\t    ];\n394\t\n395\t    lines.forEach((line, i) => {\n396\t      this.renderer.drawText(line, w / 2, h * 0.32 + i * 36, {\n397\t        font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n398\t      });\n399\t    });\n400\t\n401\t    const blinkAlpha = 0.3 + Math.sin(Date.now() * 0.004) * 0.2;\n402\t    this.renderer.drawText('点击开始', w / 2, h * 0.7, {\n403\t      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center', alpha: blinkAlpha,\n404\t    });\n405\t  }\n406\t\n407\t  private renderWitnessIntro(ctx: CanvasRenderingContext2D, w: number, h: number) {\n408\t    if (!this.config) return;\n409\t    const witness = this.config.witnesses[this.currentWitnessIndex];\n410\t    if (!witness) return;\n411\t\n412\t    this.renderer.drawText(`${witness.name}上堂作证`, w / 2, h * 0.35, {\n413\t      font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2', align: 'center',\n414\t    });\n415\t\n416\t    this.renderer.drawText(`共有 ${witness.testimonyLines.length} 条证词待听取`, w / 2, h * 0.45, {\n417\t      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870', align: 'center',\n418\t    });\n419\t  }\n420\t\n421\t  private renderRebuttal(ctx: CanvasRenderingContext2D, w: number, h: number) {\n422\t    this.renderer.drawText('最终辩论', w / 2, h * 0.2, {\n423\t      font: 'bold 28px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n424\t    });\n425\t\n426\t    this.renderer.drawText('所有证人已作证完毕。', w / 2, h * 0.35, {\n427\t      font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n428\t    });\n429\t\n430\t    this.renderer.drawText(`异议成功率：${this.totalObjections > 0 ? Math.round(this.correctObjections / this.totalObjections * 100) : 0}%`, w / 2, h * 0.45, {\n431\t      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center',\n432\t    });\n433\t\n434\t    const blinkAlpha = 0.3 + Math.sin(Date.now() * 0.004) * 0.2;\n435\t    this.renderer.drawText('进入判决', w / 2, h * 0.6, {\n436\t      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center', alpha: blinkAlpha,\n437\t    });\n438\t  }\n439\t\n440\t  private renderVerdict(ctx: CanvasRenderingContext2D, w: number, h: number) {\n441\t    if (!this.config) return;\n442\t\n443\t    this.renderer.drawText('宣 判', w / 2, h * 0.2, {\n444\t      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n445\t    });\n446\t\n447\t    this.renderer.drawText('根据庭审证据和辩论，你做出判决：', w / 2, h * 0.32, {\n448\t      font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n449\t    });\n450\t\n451\t    const centerX = w / 2;\n452\t    const btnW = 200;\n453\t    const btnH = 50;\n454\t\n455\t    const guiltyY = h * 0.45;\n456\t    const guiltyHover = this.isInRect(this.input.mouseX, this.input.mouseY, centerX - btnW / 2, guiltyY, btnW, btnH);\n457\t    this.renderer.drawRoundRect(centerX - btnW / 2, guiltyY, btnW, btnH, 6,\n458\t      guiltyHover ? '#3a1a1a' : '#1a140e', '#8b4513');\n459\t    this.renderer.drawText('有罪', centerX, guiltyY + 14, {\n460\t      font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n461\t      color: guiltyHover ? '#f0d8a0' : '#c8a040', align: 'center',\n462\t    });\n463\t\n464\t    const innocentY = h * 0.55;\n465\t    const innocentHover = this.isInRect(this.input.mouseX, this.input.mouseY, centerX - btnW / 2, innocentY, btnW, btnH);\n466\t    this.renderer.drawRoundRect(centerX - btnW / 2, innocentY, btnW, btnH, 6,\n467\t      innocentHover ? '#1a2a1a' : '#1a140e', '#5a4030');\n468\t    this.renderer.drawText('无罪', centerX, innocentY + 14, {\n469\t      font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n470\t      color: innocentHover ? '#e8c8a2' : '#a08870', align: 'center',\n471\t    });\n472\t  }\n473\t\n474\t  private renderComplete(ctx: CanvasRenderingContext2D, w: number, h: number) {\n475\t    const isCorrect = this.verdict === this.config?.correctVerdict;\n476\t\n477\t    this.renderer.drawText(isCorrect ? '判决正确' : '判决有误', w / 2, h * 0.25, {\n478\t      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif',\n479\t      color: isCorrect ? '#6a8a4a' : '#8a4a4a', align: 'center',\n480\t    });\n481\t\n482\t    this.renderer.drawText(`最终信誉值：${this.credibility.getScore()}`, w / 2, h * 0.4, {\n483\t      font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n484\t    });\n485\t\n486\t    this.renderer.drawText(`异议成功率：${this.totalObjections > 0 ? Math.round(this.correctObjections / this.totalObjections * 100) : 0}%`, w / 2, h * 0.48, {\n487\t      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870', align: 'center',\n488\t    });\n489\t\n490\t    const closeHover = this.isInRect(this.input.mouseX, this.input.mouseY, w / 2 - 80, h * 0.85, 160, 45);\n491\t    this.renderer.drawRoundRect(w / 2 - 80, h * 0.85, 160, 45, 6,\n492\t      closeHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n493\t    this.renderer.drawText('结束庭审', w / 2, h * 0.85 + 12, {\n494\t      font: '20px \"SimSun\", \"Noto Serif SC\", serif',\n495\t      color: closeHover ? '#e8c8a2' : '#a08870', align: 'center',\n496\t    });\n497\t  }\n498\t\n499\t  private renderFailed(ctx: CanvasRenderingContext2D, w: number, h: number) {\n500\t    this.renderer.drawText('庭审失败', w / 2, h * 0.3, {\n501\t      font: 'bold 40px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a3a3a', align: 'center',\n502\t    });\n503\t\n504\t    this.renderer.drawText('信誉值归零，无法继续庭审。', w / 2, h * 0.45, {\n505\t      font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n506\t    });\n507\t\n508\t    this.renderer.drawText('需要重新调查收集更多证据。', w / 2, h * 0.55, {\n509\t      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870', align: 'center',\n510\t    });\n511\t  }\n512\t\n513\t  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n514\t    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n515\t  }\n516\t}\n517\t"}]},"parent_tool_use_id":null,"session_id":"60e8bd2a-b118-4ebb-8072-7fe7ed523870","uuid":"803eb659-b78b-4b4e-a666-8de23476ca5d","timestamp":"2026-05-23T17:48:42.137Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-ancient-mystery\\src\\game\\TrialLoop.ts","content":"import { Renderer } from '../renderer/Renderer';\nimport { GameState } from './GameState';\nimport { InputManager } from './InputManager';\nimport { CredibilityScore } from './CredibilityScore';\nimport { ObjectionSystem, TestimonyLine, ObjectionResult } from './ObjectionSystem';\n\nexport type TrialPhase =\n  | 'opening' | 'witness_intro' | 'testimony' | 'cross_examine'\n  | 'rebuttal' | 'closing' | 'verdict' | 'complete' | 'failed';\n\nexport interface TrialWitness {\n  id: string;\n  name: string;\n  portrait?: string;\n  testimonyLines: TestimonyLine[];\n}\n\nexport interface TrialConfig {\n  id: string;\n  chapter: number;\n  caseTitle: string;\n  plaintiffName: string;\n  defendantName: string;\n  judgeName: string;\n  witnesses: TrialWitness[];\n  correctVerdict: 'guilty' | 'innocent';\n  onVerdict?: (verdict: string, score: number) => void;\n}\n\nexport class TrialLoop {\n  private config: TrialConfig | null = null;\n  private phase: TrialPhase = 'opening';\n  private currentWitnessIndex = 0;\n  private currentLineIndex = 0;\n  private verdict: 'guilty' | 'innocent' | null = null;\n  private animAlpha = 0;\n  private phaseText = '';\n  private phaseTextTimer = 0;\n  private showingPhaseIntro = false;\n  private totalObjections = 0;\n  private correctObjections = 0;\n\n  private isOpen = false;\n\n  private objectionSystem: ObjectionSystem;\n  private credibility: CredibilityScore;\n\n  private onTrialEnd?: (verdict: string, score: number) => void;\n\n  constructor(\n    private renderer: Renderer,\n    private state: GameState,\n    private input: InputManager\n  ) {\n    this.credibility = new CredibilityScore(renderer, state);\n    this.objectionSystem = new ObjectionSystem(renderer, state, input, this.credibility);\n\n    this.objectionSystem.setResultCallback((result) => {\n      this.handleObjectionResult(result);\n    });\n\n    this.setupInput();\n  }\n\n  getCredibility(): CredibilityScore { return this.credibility; }\n  getObjectionSystem(): ObjectionSystem { return this.objectionSystem; }\n  getPhase(): TrialPhase { return this.phase; }\n  getIsOpen(): boolean { return this.isOpen; }\n\n  startTrial(config: TrialConfig) {\n    this.config = config;\n    this.phase = 'opening';\n    this.currentWitnessIndex = 0;\n    this.currentLineIndex = 0;\n    this.verdict = null;\n    this.totalObjections = 0;\n    this.correctObjections = 0;\n    this.isOpen = true;\n    this.animAlpha = 0;\n\n    this.credibility.reset();\n    this.objectionSystem.resetPressure();\n\n    this.showPhaseText('开堂');\n    this.showingPhaseIntro = true;\n    this.phaseTextTimer = 2;\n  }\n\n  endTrial() {\n    this.isOpen = false;\n    this.phase = 'complete';\n    this.objectionSystem.hideTestimony();\n  }\n\n  private showPhaseText(text: string) {\n    this.phaseText = text;\n    this.showingPhaseIntro = true;\n    this.phaseTextTimer = 2;\n  }\n\n  private advancePhase() {\n    if (!this.config) return;\n\n    switch (this.phase) {\n      case 'opening':\n        this.phase = 'witness_intro';\n        this.currentWitnessIndex = 0;\n        this.showPhaseText(`证人：${this.config.witnesses[0]?.name ?? ''}`);\n        break;\n\n      case 'witness_intro':\n        this.phase = 'testimony';\n        this.currentLineIndex = 0;\n        this.startCurrentTestimony();\n        break;\n\n      case 'testimony':\n        this.phase = 'cross_examine';\n        this.startCrossExamine();\n        break;\n\n      case 'cross_examine':\n        if (this.currentWitnessIndex < this.config.witnesses.length - 1) {\n          this.currentWitnessIndex++;\n          this.phase = 'witness_intro';\n          this.showPhaseText(`证人：${this.config.witnesses[this.currentWitnessIndex].name}`);\n        } else {\n          this.phase = 'rebuttal';\n          this.showPhaseText('最终辩论');\n        }\n        break;\n\n      case 'rebuttal':\n        this.phase = 'verdict';\n        this.showPhaseText('判决');\n        break;\n\n      case 'verdict':\n        this.phase = 'complete';\n        this.onTrialEnd?.(this.verdict ?? 'innocent', this.credibility.getScore());\n        if (this.config.onVerdict) {\n          this.config.onVerdict(this.verdict ?? 'innocent', this.credibility.getScore());\n        }\n        break;\n    }\n  }\n\n  private startCurrentTestimony() {\n    if (!this.config) return;\n    const witness = this.config.witnesses[this.currentWitnessIndex];\n    if (!witness || this.currentLineIndex >= witness.testimonyLines.length) {\n      this.advancePhase();\n      return;\n    }\n    const line = witness.testimonyLines[this.currentLineIndex];\n    this.objectionSystem.showTestimony(line);\n  }\n\n  private startCrossExamine() {\n    if (!this.config) return;\n    const witness = this.config.witnesses[this.currentWitnessIndex];\n    this.currentLineIndex = 0;\n    if (!witness || witness.testimonyLines.length === 0) {\n      this.advancePhase();\n      return;\n    }\n    const line = witness.testimonyLines[this.currentLineIndex];\n    this.objectionSystem.showTestimony(line);\n  }\n\n  private handleObjectionResult(result: ObjectionResult) {\n    this.totalObjections++;\n    if (result.success) {\n      this.correctObjections++;\n    }\n    this.advanceToNextLine();\n  }\n\n  private advanceToNextLine() {\n    if (!this.config) return;\n    const witness = this.config.witnesses[this.currentWitnessIndex];\n    if (!witness) return;\n\n    this.currentLineIndex++;\n    if (this.currentLineIndex < witness.testimonyLines.length) {\n      const line = witness.testimonyLines[this.currentLineIndex];\n      this.objectionSystem.showTestimony(line);\n    } else {\n      this.objectionSystem.hideTestimony();\n      if (this.phase === 'testimony') {\n        this.advancePhase();\n      } else if (this.phase === 'cross_examine') {\n        this.advancePhase();\n      }\n    }\n  }\n\n  private setupInput() {\n    this.input.onClick((e) => {\n      if (e.type !== 'up') return;\n      if (!this.isOpen) return;\n      if (this.objectionSystem.isTestimonyActive()) return;\n      this.handleClick(e.x, e.y);\n    });\n  }\n\n  private handleClick(x: number, y: number) {\n    if (!this.config) return;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    if (this.showingPhaseIntro && this.phaseTextTimer <= 0) {\n      this.showingPhaseIntro = false;\n      this.advancePhase();\n      return;\n    }\n\n    if (this.phase === 'verdict') {\n      const centerX = w / 2;\n      const guiltyY = h * 0.45;\n      const innocentY = h * 0.55;\n      const btnW = 200;\n      const btnH = 50;\n\n      if (this.isInRect(x, y, centerX - btnW / 2, guiltyY, btnW, btnH)) {\n        this.verdict = 'guilty';\n        this.showPhaseText(this.verdict === this.config.correctVerdict ? '判决正确！' : '判决有误...');\n        this.advancePhase();\n        return;\n      }\n\n      if (this.isInRect(x, y, centerX - btnW / 2, innocentY, btnW, btnH)) {\n        this.verdict = 'innocent';\n        this.showPhaseText(this.verdict === this.config.correctVerdict ? '判决正确！' : '判决有误...');\n        this.advancePhase();\n        return;\n      }\n    }\n\n    if (this.phase === 'complete') {\n      if (this.isInRect(x, y, w / 2 - 80, h * 0.85, 160, 45)) {\n        this.endTrial();\n      }\n    }\n\n    if (this.phase === 'failed') {\n      this.endTrial();\n    }\n  }\n\n  update(dt: number) {\n    if (!this.isOpen) return;\n    this.animAlpha = Math.min(1, this.animAlpha + dt * 3);\n    if (this.phaseTextTimer > 0) this.phaseTextTimer -= dt;\n    this.credibility.update(dt);\n    this.objectionSystem.update(dt);\n\n    if (!this.credibility.isAlive() && this.phase !== 'complete' && this.phase !== 'failed') {\n      this.phase = 'failed';\n      this.showPhaseText('庭审失败...');\n    }\n  }\n\n  render() {\n    if (!this.isOpen) return;\n\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    this.renderCourtroom(ctx, w, h);\n\n    this.credibility.renderWarningOverlay();\n\n    if (this.showingPhaseIntro) {\n      this.renderPhaseIntro(ctx, w, h);\n      return;\n    }\n\n    if (this.objectionSystem.isTestimonyActive()) {\n      this.renderWitnessPanel(ctx, w, h);\n      this.objectionSystem.render();\n      return;\n    }\n\n    switch (this.phase) {\n      case 'opening':\n        this.renderOpening(ctx, w, h);\n        break;\n      case 'witness_intro':\n        this.renderWitnessIntro(ctx, w, h);\n        break;\n      case 'testimony':\n        break;\n      case 'cross_examine':\n        break;\n      case 'rebuttal':\n        this.renderRebuttal(ctx, w, h);\n        break;\n      case 'verdict':\n        this.renderVerdict(ctx, w, h);\n        break;\n      case 'complete':\n        this.renderComplete(ctx, w, h);\n        break;\n      case 'failed':\n        this.renderFailed(ctx, w, h);\n        break;\n    }\n  }\n\n  private renderCourtroom(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0, '#1a0a0a');\n    grad.addColorStop(0.5, '#2a1410');\n    grad.addColorStop(1, '#0d0606');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n\n    ctx.save();\n    ctx.strokeStyle = '#5a3020';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.moveTo(w * 0.1, h * 0.35);\n    ctx.lineTo(w * 0.9, h * 0.35);\n    ctx.stroke();\n    ctx.beginPath();\n    ctx.moveTo(w * 0.1, h * 0.50);\n    ctx.lineTo(w * 0.9, h * 0.50);\n    ctx.stroke();\n    ctx.restore();\n\n    if (this.config) {\n      this.renderer.drawText(this.config.caseTitle, w / 2, h * 0.03, {\n        font: 'bold 20px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n      });\n    }\n\n    this.credibility.render(w - 200, 10, 180);\n  }\n\n  private renderPhaseIntro(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    ctx.save();\n    ctx.globalAlpha = 0.7;\n    ctx.fillStyle = '#0a0806';\n    ctx.fillRect(0, 0, w, h);\n    ctx.restore();\n\n    this.renderer.drawText(this.phaseText, w / 2, h * 0.4, {\n      font: 'bold 42px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    if (this.phaseTextTimer <= 0) {\n      const blinkAlpha = 0.3 + Math.sin(Date.now() * 0.004) * 0.2;\n      this.renderer.drawText('点击继续', w / 2, h * 0.55, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center', alpha: blinkAlpha,\n      });\n    }\n  }\n\n  private renderWitnessPanel(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    if (!this.config) return;\n    const witness = this.config.witnesses[this.currentWitnessIndex];\n    if (!witness) return;\n\n    const panelX = w * 0.1;\n    const panelW = w * 0.8;\n    const panelY = h * 0.36;\n\n    ctx.save();\n    ctx.globalAlpha = 0.8;\n    this.renderer.drawRoundRect(panelX, panelY, panelW, 60, 6, '#1a140e', '#3a2a1a');\n    ctx.restore();\n\n    this.renderer.drawText(`证人 ${this.currentWitnessIndex + 1}/${this.config.witnesses.length}：${witness.name}`,\n      panelX + panelW / 2, panelY + 20, {\n        font: 'bold 20px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2', align: 'center',\n      });\n  }\n\n  private renderOpening(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    if (!this.config) return;\n\n    this.renderer.drawText('开堂陈词', w / 2, h * 0.2, {\n      font: 'bold 28px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    const lines = [\n      `原告：${this.config.plaintiffName}`,\n      `被告：${this.config.defendantName}`,\n      `主审：${this.config.judgeName}`,\n      `证人：${this.config.witnesses.length}人`,\n    ];\n\n    lines.forEach((line, i) => {\n      this.renderer.drawText(line, w / 2, h * 0.32 + i * 36, {\n        font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n      });\n    });\n\n    const blinkAlpha = 0.3 + Math.sin(Date.now() * 0.004) * 0.2;\n    this.renderer.drawText('点击开始', w / 2, h * 0.7, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center', alpha: blinkAlpha,\n    });\n  }\n\n  private renderWitnessIntro(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    if (!this.config) return;\n    const witness = this.config.witnesses[this.currentWitnessIndex];\n    if (!witness) return;\n\n    this.renderer.drawText(`${witness.name}上堂作证`, w / 2, h * 0.35, {\n      font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2', align: 'center',\n    });\n\n    this.renderer.drawText(`共有 ${witness.testimonyLines.length} 条证词待听取`, w / 2, h * 0.45, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870', align: 'center',\n    });\n  }\n\n  private renderRebuttal(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    this.renderer.drawText('最终辩论', w / 2, h * 0.2, {\n      font: 'bold 28px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    this.renderer.drawText('所有证人已作证完毕。', w / 2, h * 0.35, {\n      font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n    });\n\n    this.renderer.drawText(`异议成功率：${this.totalObjections > 0 ? Math.round(this.correctObjections / this.totalObjections * 100) : 0}%`, w / 2, h * 0.45, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center',\n    });\n\n    const blinkAlpha = 0.3 + Math.sin(Date.now() * 0.004) * 0.2;\n    this.renderer.drawText('进入判决', w / 2, h * 0.6, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center', alpha: blinkAlpha,\n    });\n  }\n\n  private renderVerdict(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    if (!this.config) return;\n\n    this.renderer.drawText('宣 判', w / 2, h * 0.2, {\n      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    this.renderer.drawText('根据庭审证据和辩论，你做出判决：', w / 2, h * 0.32, {\n      font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n    });\n\n    const centerX = w / 2;\n    const btnW = 200;\n    const btnH = 50;\n\n    const guiltyY = h * 0.45;\n    const guiltyHover = this.isInRect(this.input.mouseX, this.input.mouseY, centerX - btnW / 2, guiltyY, btnW, btnH);\n    this.renderer.drawRoundRect(centerX - btnW / 2, guiltyY, btnW, btnH, 6,\n      guiltyHover ? '#3a1a1a' : '#1a140e', '#8b4513');\n    this.renderer.drawText('有罪', centerX, guiltyY + 14, {\n      font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n      color: guiltyHover ? '#f0d8a0' : '#c8a040', align: 'center',\n    });\n\n    const innocentY = h * 0.55;\n    const innocentHover = this.isInRect(this.input.mouseX, this.input.mouseY, centerX - btnW / 2, innocentY, btnW, btnH);\n    this.renderer.drawRoundRect(centerX - btnW / 2, innocentY, btnW, btnH, 6,\n      innocentHover ? '#1a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('无罪', centerX, innocentY + 14, {\n      font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n      color: innocentHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n  }\n\n  private renderComplete(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    const isCorrect = this.verdict === this.config?.correctVerdict;\n\n    this.renderer.drawText(isCorrect ? '判决正确' : '判决有误', w / 2, h * 0.25, {\n      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif',\n      color: isCorrect ? '#6a8a4a' : '#8a4a4a', align: 'center',\n    });\n\n    this.renderer.drawText(`最终信誉值：${this.credibility.getScore()}`, w / 2, h * 0.4, {\n      font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n    });\n\n    this.renderer.drawText(`异议成功率：${this.totalObjections > 0 ? Math.round(this.correctObjections / this.totalObjections * 100) : 0}%`, w / 2, h * 0.48, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870', align: 'center',\n    });\n\n    const closeHover = this.isInRect(this.input.mouseX, this.input.mouseY, w / 2 - 80, h * 0.85, 160, 45);\n    this.renderer.drawRoundRect(w / 2 - 80, h * 0.85, 160, 45, 6,\n      closeHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('结束庭审', w / 2, h * 0.85 + 12, {\n      font: '20px \"SimSun\", \"Noto Serif SC\", serif',\n      color: closeHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n  }\n\n  private renderFailed(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    this.renderer.drawText('庭审失败', w / 2, h * 0.3, {\n      font: 'bold 40px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a3a3a', align: 'center',\n    });\n\n    this.renderer.drawText('信誉值归零，无法继续庭审。', w / 2, h * 0.45, {\n      font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n    });\n\n    this.renderer.drawText('需要重新调查收集更多证据。', w / 2, h * 0.55, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870', align: 'center',\n    });\n  }\n\n  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n  }\n}\n","numLines":517,"startLine":1,"totalLines":517}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_17cd2f6dc5b74521a6c6d214","type":"tool_result","content":"1\timport { Renderer } from '../renderer/Renderer';\n2\timport { GameState } from './GameState';\n3\timport { InputManager } from './InputManager';\n4\t\n5\texport type EvidenceCategory = 'key' | 'normal' | 'misleading';\n6\t\n7\texport interface EvidenceItem {\n8\t  id: string;\n9\t  name: string;\n10\t  description: string;\n11\t  category: EvidenceCategory;\n12\t  icon?: string;\n13\t  discoveredAt: string;\n14\t  discoveredTime: number;\n15\t  combinable?: string[];\n16\t}\n17\t\n18\texport class EvidenceCollector {\n19\t  private evidenceDB: Map<string, EvidenceItem> = new Map();\n20\t  private isOpen = false;\n21\t  private selectedIndex = -1;\n22\t  private scrollOffset = 0;\n23\t  private animAlpha = 0;\n24\t  private flashId: string | null = null;\n25\t  private flashTimer = 0;\n26\t  private onEvidenceUsed?: (evidence: EvidenceItem) => void;\n27\t\n28\t  constructor(\n29\t    private renderer: Renderer,\n30\t    private state: GameState,\n31\t    private input: InputManager\n32\t  ) {\n33\t    this.setupInput();\n34\t  }\n35\t\n36\t  registerEvidence(items: EvidenceItem[]) {\n37\t    items.forEach((item) => this.evidenceDB.set(item.id, item));\n38\t  }\n39\t\n40\t  setUsedCallback(cb: (evidence: EvidenceItem) => void) {\n41\t    this.onEvidenceUsed = cb;\n42\t  }\n43\t\n44\t  collect(evidenceId: string): boolean {\n45\t    if (this.state.hasEvidence(evidenceId)) return false;\n46\t    this.state.addEvidence(evidenceId);\n47\t    this.flashId = evidenceId;\n48\t    this.flashTimer = 2;\n49\t    return true;\n50\t  }\n51\t\n52\t  open() {\n53\t    this.isOpen = true;\n54\t    this.selectedIndex = -1;\n55\t    this.scrollOffset = 0;\n56\t    this.animAlpha = 0;\n57\t  }\n58\t\n59\t  close() {\n60\t    this.isOpen = false;\n61\t    this.selectedIndex = -1;\n62\t  }\n63\t\n64\t  toggle() {\n65\t    if (this.isOpen) this.close();\n66\t    else this.open();\n67\t  }\n68\t\n69\t  getIsOpen(): boolean { return this.isOpen; }\n70\t\n71\t  getCollectedEvidence(): EvidenceItem[] {\n72\t    return this.state.evidence\n73\t      .map((id) => this.evidenceDB.get(id))\n74\t      .filter((e): e is EvidenceItem => e !== undefined);\n75\t  }\n76\t\n77\t  getEvidenceById(id: string): EvidenceItem | undefined {\n78\t    return this.evidenceDB.get(id);\n79\t  }\n80\t\n81\t  private setupInput() {\n82\t    this.input.onClick((e) => {\n83\t      if (e.type !== 'up') return;\n84\t      if (!this.isOpen) return;\n85\t      this.handleClick(e.x, e.y);\n86\t    });\n87\t  }\n88\t\n89\t  private handleClick(x: number, y: number) {\n90\t    const w = this.renderer.w;\n91\t    const h = this.renderer.h;\n92\t\n93\t    const panelW = Math.min(420, w * 0.35);\n94\t    const panelH = h - 80;\n95\t    const panelX = w - panelW - 20;\n96\t    const panelY = 40;\n97\t\n98\t    if (!this.isInRect(x, y, panelX, panelY, panelW, panelH)) {\n99\t      this.close();\n100\t      return;\n101\t    }\n102\t\n103\t    const listX = panelX + 16;\n104\t    const listY = panelY + 60;\n105\t    const itemH = 52;\n106\t    const listH = panelH - 140;\n107\t\n108\t    const items = this.getCollectedEvidence();\n109\t    for (let i = 0; i < items.length; i++) {\n110\t      const iy = listY + i * itemH - this.scrollOffset;\n111\t      if (iy < listY - itemH || iy > listY + listH) continue;\n112\t      if (this.isInRect(x, y, listX, iy, panelW - 32, itemH - 4)) {\n113\t        this.selectedIndex = this.selectedIndex === i ? -1 : i;\n114\t        return;\n115\t      }\n116\t    }\n117\t\n118\t    const closeBtnY = panelY + panelH - 50;\n119\t    if (this.isInRect(x, y, panelX + panelW / 2 - 60, closeBtnY, 120, 36)) {\n120\t      this.close();\n121\t    }\n122\t  }\n123\t\n124\t  update(dt: number) {\n125\t    if (!this.isOpen) return;\n126\t    this.animAlpha = Math.min(1, this.animAlpha + dt * 5);\n127\t    if (this.flashTimer > 0) this.flashTimer -= dt;\n128\t    if (this.flashTimer <= 0) this.flashId = null;\n129\t  }\n130\t\n131\t  render() {\n132\t    if (!this.isOpen) return;\n133\t    const ctx = this.renderer.context;\n134\t    const w = this.renderer.w;\n135\t    const h = this.renderer.h;\n136\t\n137\t    ctx.save();\n138\t    ctx.globalAlpha = this.animAlpha * 0.4;\n139\t    ctx.fillStyle = '#0a0806';\n140\t    ctx.fillRect(0, 0, w, h);\n141\t    ctx.restore();\n142\t\n143\t    ctx.save();\n144\t    ctx.globalAlpha = this.animAlpha;\n145\t\n146\t    const panelW = Math.min(420, w * 0.35);\n147\t    const panelH = h - 80;\n148\t    const panelX = w - panelW - 20;\n149\t    const panelY = 40;\n150\t\n151\t    this.renderer.drawRoundRect(panelX, panelY, panelW, panelH, 8, '#1a140e', '#3a2a1a');\n152\t    ctx.strokeStyle = '#5a4030';\n153\t    ctx.lineWidth = 1;\n154\t    ctx.strokeRect(panelX + 3, panelY + 3, panelW - 6, panelH - 6);\n155\t\n156\t    this.renderer.drawText('物 证', panelX + panelW / 2, panelY + 18, {\n157\t      font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n158\t      color: '#c8a882', align: 'center',\n159\t    });\n160\t\n161\t    const items = this.getCollectedEvidence();\n162\t    const listX = panelX + 16;\n163\t    const listY = panelY + 60;\n164\t    const itemH = 52;\n165\t    const listH = panelH - 140;\n166\t\n167\t    ctx.save();\n168\t    ctx.beginPath();\n169\t    ctx.rect(panelX + 4, listY - 4, panelW - 8, listH + 8);\n170\t    ctx.clip();\n171\t\n172\t    const categoryColors: Record<EvidenceCategory, string> = {\n173\t      key: '#c8a040',\n174\t      normal: '#a08870',\n175\t      misleading: '#8a4a4a',\n176\t    };\n177\t\n178\t    items.forEach((item, i) => {\n179\t      const iy = listY + i * itemH - this.scrollOffset;\n180\t      if (iy < listY - itemH || iy > listY + listH) return;\n181\t\n182\t      const isSelected = this.selectedIndex === i;\n183\t      const isFlash = this.flashId === item.id;\n184\t      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, listX, iy, panelW - 32, itemH - 4);\n185\t\n186\t      if (isSelected) {\n187\t        ctx.fillStyle = 'rgba(200, 168, 130, 0.15)';\n188\t        ctx.fillRect(listX, iy, panelW - 32, itemH - 4);\n189\t      } else if (isHover) {\n190\t        ctx.fillStyle = 'rgba(200, 168, 130, 0.07)';\n191\t        ctx.fillRect(listX, iy, panelW - 32, itemH - 4);\n192\t      }\n193\t\n194\t      const catColor = categoryColors[item.category];\n195\t      ctx.fillStyle = catColor;\n196\t      ctx.beginPath();\n197\t      ctx.arc(listX + 14, iy + itemH / 2 - 2, 5, 0, Math.PI * 2);\n198\t      ctx.fill();\n199\t\n200\t      this.renderer.drawText(item.name, listX + 28, iy + 6, {\n201\t        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n202\t        color: isFlash ? '#f0d8a0' : '#d8c8b0',\n203\t      });\n204\t\n205\t      const catLabel: Record<EvidenceCategory, string> = { key: '关键', normal: '普通', misleading: '存疑' };\n206\t      this.renderer.drawText(catLabel[item.category], listX + 28, iy + 28, {\n207\t        font: '13px sans-serif', color: catColor,\n208\t      });\n209\t\n210\t      if (isFlash) {\n211\t        ctx.save();\n212\t        ctx.globalAlpha = Math.min(1, this.flashTimer) * 0.2;\n213\t        ctx.fillStyle = '#f0d8a0';\n214\t        ctx.fillRect(listX, iy, panelW - 32, itemH - 4);\n215\t        ctx.restore();\n216\t      }\n217\t    });\n218\t\n219\t    ctx.restore();\n220\t\n221\t    if (this.selectedIndex >= 0 && this.selectedIndex < items.length) {\n222\t      const item = items[this.selectedIndex];\n223\t      const detailY = listY + listH + 10;\n224\t\n225\t      this.renderer.drawRoundRect(listX, detailY, panelW - 32, 70, 4, '#14100a', '#3a2a1a');\n226\t\n227\t      this.renderer.drawText(item.name, listX + 12, detailY + 8, {\n228\t        font: 'bold 18px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2',\n229\t      });\n230\t      this.renderWrappedText(item.description, listX + 12, detailY + 34, panelW - 56, 30, {\n23