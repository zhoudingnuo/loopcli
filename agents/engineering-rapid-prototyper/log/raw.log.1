form elements\n  const formElements = await page.$$eval('input, textarea, select, button, [role=\"button\"], [class*=\"upload\"], [class*=\"Upload\"]', els =>\n    els.map(e => ({\n      tag: e.tagName,\n      type: e.getAttribute('type'),\n      placeholder: e.getAttribute('placeholder'),\n      value: (e.value || '').substring(0, 50),\n      text: e.textContent?.trim()?.substring(0, 40),\n      cls: e.className?.substring(0, 80),\n      name: e.getAttribute('name'),\n      id: e.id,\n      accept: e.getAttribute('accept'),\n    })).filter(e => e.text || e.placeholder || e.value || e.type || e.accept)\n  );\n  console.log('Form elements:', JSON.stringify(formElements, null, 2));\n\n  // Look for labels/section titles\n  const labels = await page.$$eval('label, [class*=\"label\"], [class*=\"form-label\"], [class*=\"required\"], [class*=\"field\"]', els =>\n    els.map(e => ({ text: e.textContent?.trim()?.substring(0, 50), cls: e.className?.substring(0, 60) }))\n      .filter(e => e.text && e.text.length > 1 && e.text.length < 40)\n  );\n  console.log('Labels:', JSON.stringify(labels, null, 2));\n\n  // Check for category selector\n  const selectElements = await page.$$eval('select, [class*=\"select\"], [class*=\"Select\"], [class*=\"cascader\"], [class*=\"Cascader\"]', els =>\n    els.map(e => ({\n      tag: e.tagName,\n      text: e.textContent?.trim()?.substring(0, 80),\n      cls: e.className?.substring(0, 60),\n    }))\n  );\n  console.log('Select elements:', JSON.stringify(selectElements, null, 2));\n\n  await context.close();\n  console.log('Done');\n})();\n","structuredPatch":[],"originalFile":null,"userModified":false}}
