{"type":"assistant","message":{"id":"msg_20260524015025ada9cc1dc6274a0f","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_5bf8511679ce4d99a2926a4f","name":"Write","input":{"file_path":"D:\\game-projects\\steam-ancient-mystery\\src\\audio\\AudioManager.ts","content":"export interface AudioLayerConfig {\n  id: string;\n  src: string;\n  volume: number;\n  loop: boolean;\n  fadeIn?: number;\n}\n\nexport interface AudioSceneConfig {\n  ambient: AudioLayerConfig[];\n  music?: AudioLayerConfig;\n  sfx?: Record<string, string>;\n}\n\nexport class AudioManager {\n  private ctx: AudioContext | null = null;\n  private masterGain: GainNode | null = null;\n  private layers: Map<string, { source: AudioBufferSourceNode | null; gain: GainNode }> = new Map();\n  private sfxBuffers: Map<string, AudioBuffer> = new Map();\n  private volume = { master: 0.8, bgm: 0.7, sfx: 0.8, ambient: 0.6 };\n  private muted = false;\n  private sceneConfig: AudioSceneConfig | null = null;\n\n  init() {\n    if (this.ctx) return;\n    this.ctx = new AudioContext();\n    this.masterGain = this.ctx.createGain();\n    this.masterGain.gain.value = this.volume.master;\n    this.masterGain.connect(this.ctx.destination);\n  }\n\n  setVolume(channel: 'master' | 'bgm' | 'sfx' | 'ambient', value: number) {\n    this.volume[channel] = Math.max(0, Math.min(1, value));\n    if (channel === 'master' && this.masterGain) {\n      this.masterGain.gain.value = this.muted ? 0 : this.volume.master;\n    }\n  }\n\n  toggleMute() {\n    this.muted = !this.muted;\n    if (this.masterGain) {\n      this.masterGain.gain.value = this.muted ? 0 : this.volume.master;\n    }\n  }\n\n  isMuted(): boolean { return this.muted; }\n\n  setSceneConfig(config: AudioSceneConfig) {\n    this.sceneConfig = config;\n    this.stopAllLayers();\n\n    config.ambient.forEach((layer) => {\n      this.startAmbientLoop(layer);\n    });\n\n    if (config.music) {\n      this.startMusic(config.music);\n    }\n  }\n\n  private startAmbientLoop(config: AudioLayerConfig) {\n    if (!this.ctx || !this.masterGain) return;\n\n    const gain = this.ctx.createGain();\n    gain.gain.value = 0;\n    gain.connect(this.masterGain);\n\n    this.layers.set(config.id, { source: null, gain });\n\n    // Generate a simple ambient tone since we don't have audio files\n    this.generateAmbientTone(config.id, gain, config.volume * this.volume.ambient);\n\n    if (config.fadeIn) {\n      gain.gain.linearRampToValueAtTime(\n        config.volume * this.volume.ambient,\n        this.ctx.currentTime + config.fadeIn,\n      );\n    } else {\n      gain.gain.value = config.volume * this.volume.ambient;\n    }\n  }\n\n  private generateAmbientTone(id: string, gainNode: GainNode, targetVol: number) {\n    if (!this.ctx) return;\n    const osc = this.ctx.createOscillator();\n    const oscGain = this.ctx.createGain();\n\n    osc.type = 'sine';\n    osc.frequency.value = id.includes('low') ? 60 : id.includes('wind') ? 200 : 120;\n    oscGain.gain.value = targetVol * 0.03;\n\n    osc.connect(oscGain);\n    oscGain.connect(gainNode);\n    osc.start();\n\n    const entry = this.layers.get(id);\n    if (entry) entry.source = osc as any;\n  }\n\n  private startMusic(config: AudioLayerConfig) {\n    if (!this.ctx || !this.masterGain) return;\n\n    const gain = this.ctx.createGain();\n    gain.gain.value = 0;\n    gain.connect(this.masterGain);\n\n    this.layers.set('music', { source: null, gain });\n\n    // Generate a simple music tone\n    if (this.ctx) {\n      const osc = this.ctx.createOscillator();\n      const oscGain = this.ctx.createGain();\n      osc.type = 'triangle';\n      osc.frequency.value = 220;\n      oscGain.gain.value = config.volume * this.volume.bgm * 0.02;\n      osc.connect(oscGain);\n      oscGain.connect(gain);\n      osc.start();\n\n      const entry = this.layers.get('music');\n      if (entry) entry.source = osc as any;\n    }\n\n    if (config.fadeIn) {\n      gain.gain.linearRampToValueAtTime(\n        config.volume * this.volume.bgm * 0.05,\n        this.ctx.currentTime + config.fadeIn,\n      );\n    } else {\n      gain.gain.value = config.volume * this.volume.bgm * 0.05;\n    }\n  }\n\n  playSFX(sfxId: string) {\n    if (!this.ctx || !this.masterGain) return;\n\n    const osc = this.ctx.createOscillator();\n    const gain = this.ctx.createGain();\n\n    const freqMap: Record<string, number> = {\n      pickup: 800,\n      examine: 440,\n      talk: 350,\n      objection: 600,\n      correct: 520,\n      wrong: 200,\n      page: 500,\n      door: 150,\n      gavel: 100,\n    };\n\n    osc.type = 'sine';\n    osc.frequency.value = freqMap[sfxId] ?? 400;\n    gain.gain.value = this.volume.sfx * 0.15;\n    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.3);\n\n    osc.connect(gain);\n    gain.connect(this.masterGain);\n    osc.start();\n    osc.stop(this.ctx.currentTime + 0.3);\n  }\n\n  stopAllLayers() {\n    this.layers.forEach((entry) => {\n      try { (entry.source as any)?.stop?.(); } catch {}\n      entry.gain.disconnect();\n    });\n    this.layers.clear();\n  }\n\n  fadeOut(duration = 1) {\n    if (!this.ctx) return;\n    this.layers.forEach((entry) => {\n      entry.gain.gain.linearRampToValueAtTime(0, this.ctx!.currentTime + duration);\n    });\n  }\n\n  transitionToScene(config: AudioSceneConfig, fadeTime = 1.5) {\n    this.fadeOut(fadeTime * 0.6);\n    setTimeout(() => {\n      this.setSceneConfig(config);\n    }, fadeTime * 600);\n  }\n\n  update(_dt: number) {\n    // future: dynamic music intensity, ambient crossfade\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"60e8bd2a-b118-4ebb-8072-7fe7ed523870","uuid":"20b8060e-760d-448f-b5a4-f11b849a303c"}
