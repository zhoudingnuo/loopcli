{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f43db44b2c814223b390adad","type":"tool_result","content":"1\timport { Renderer } from '../renderer/Renderer';\n2\timport { GameState } from './GameState';\n3\timport { InkRenderer } from '../utils/ink';\n4\t\n5\texport interface SceneLayer {\n6\t  id: string;\n7\t  image?: HTMLCanvasElement;\n8\t  color?: string;\n9\t  alpha: number;\n10\t  targetAlpha: number;\n11\t  x: number;\n12\t  y: number;\n13\t}\n14\t\n15\texport interface GameScene {\n16\t  id: string;\n17\t  background: string;\n18\t  foreground?: string[];\n19\t  ambientColor?: string;\n20\t  lighting?: { x: number; y: number; radius: number; intensity: number };\n21\t}\n22\t\n23\texport class SceneManager {\n24\t  private scenes: Map<string, GameScene> = new Map();\n25\t  private currentScene: GameScene | null = null;\n26\t  private layers: SceneLayer[] = [];\n27\t  private transitioning = false;\n28\t  private transitionProgress = 0;\n29\t  private transitionDuration = 1.5;\n30\t  private pendingScene: GameScene | null = null;\n31\t  private ink: InkRenderer;\n32\t\n33\t  constructor(private renderer: Renderer, private state: GameState) {\n34\t    this.ink = new InkRenderer(renderer);\n35\t    this.registerDefaultScenes();\n36\t  }\n37\t\n38\t  private registerDefaultScenes() {\n39\t    const scenes: GameScene[] = [\n40\t      { id: 'main_menu', background: '#0d0d0d', ambientColor: '#1a0a00' },\n41\t      { id: 'county_office', background: '#1a1008', ambientColor: '#2a1a0a',\n42\t        lighting: { x: 0.5, y: 0.3, radius: 0.4, intensity: 0.6 } },\n43\t      { id: 'west_market', background: '#1a1508', ambientColor: '#2a200a',\n44\t        lighting: { x: 0.5, y: 0.5, radius: 0.5, intensity: 0.7 } },\n45\t      { id: 'east_market_ruins', background: '#0a0d10', ambientColor: '#0a1020',\n46\t        lighting: { x: 0.5, y: 0.6, radius: 0.3, intensity: 0.3 } },\n47\t      { id: 'daming_palace', background: '#100808', ambientColor: '#1a0a0a',\n48\t        lighting: { x: 0.5, y: 0.2, radius: 0.4, intensity: 0.5 } },\n49\t      { id: 'daciensi_temple', background: '#0d0a08', ambientColor: '#1a150a',\n50\t        lighting: { x: 0.5, y: 0.4, radius: 0.4, intensity: 0.5 } },\n51\t      { id: 'pingkang_ward', background: '#1a0a10', ambientColor: '#2a0a1a',\n52\t        lighting: { x: 0.5, y: 0.5, radius: 0.5, intensity: 0.7 } },\n53\t      { id: 'underground', background: '#050508', ambientColor: '#0a0a10',\n54\t        lighting: { x: 0.5, y: 0.5, radius: 0.15, intensity: 0.2 } },\n55\t      { id: 'judge_hall', background: '#08050a', ambientColor: '#100820',\n56\t        lighting: { x: 0.5, y: 0.3, radius: 0.3, intensity: 0.4 } },\n57\t    ];\n58\t    scenes.forEach((s) => this.scenes.set(s.id, s));\n59\t  }\n60\t\n61\t  registerScene(scene: GameScene) {\n62\t    this.scenes.set(scene.id, scene);\n63\t  }\n64\t\n65\t  switchTo(sceneId: string, transition = true) {\n66\t    const scene = this.scenes.get(sceneId);\n67\t    if (!scene) return;\n68\t    this.state.scene = sceneId;\n69\t    if (transition && this.currentScene) {\n70\t      this.pendingScene = scene;\n71\t      this.transitioning = true;\n72\t      this.transitionProgress = 0;\n73\t    } else {\n74\t      this.currentScene = scene;\n75\t      this.buildLayers();\n76\t    }\n77\t  }\n78\t\n79\t  private buildLayers() {\n80\t    this.layers = [];\n81\t    if (!this.currentScene) return;\n82\t    this.layers.push({\n83\t      id: 'bg', color: this.currentScene.background, alpha: 1, targetAlpha: 1,\n84\t      x: 0, y: 0,\n85\t    });\n86\t    if (this.currentScene.foreground) {\n87\t      this.currentScene.foreground.forEach((fg, i) => {\n88\t        this.layers.push({\n89\t          id: `fg_${i}`, color: fg, alpha: 1, targetAlpha: 1,\n90\t          x: 0, y: 0,\n91\t        });\n92\t      });\n93\t    }\n94\t  }\n95\t\n96\t  update(dt: number) {\n97\t    if (this.transitioning) {\n98\t      this.transitionProgress += dt / this.transitionDuration;\n99\t      if (this.transitionProgress >= 1) {\n100\t        this.transitioning = false;\n101\t        this.transitionProgress = 1;\n102\t        if (this.pendingScene) {\n103\t          this.currentScene = this.pendingScene;\n104\t          this.pendingScene = null;\n105\t          this.buildLayers();\n106\t        }\n107\t      }\n108\t    }\n109\t    this.layers.forEach((l) => {\n110\t      if (l.alpha !== l.targetAlpha) {\n111\t        const diff = l.targetAlpha - l.alpha;\n112\t        l.alpha += Math.sign(diff) * Math.min(Math.abs(diff), dt * 3);\n113\t      }\n114\t    });\n115\t    this.ink.update(dt);\n116\t  }\n117\t\n118\t  render() {\n119\t    const ctx = this.renderer.context;\n120\t    const w = this.renderer.w;\n121\t    const h = this.renderer.h;\n122\t\n123\t    if (this.transitioning && this.pendingScene) {\n124\t      const p = this.transitionProgress;\n125\t      ctx.save();\n126\t      ctx.globalAlpha = 1 - p;\n127\t      this.renderScene(this.currentScene);\n128\t      ctx.globalAlpha = p;\n129\t      this.renderScene(this.pendingScene);\n130\t      ctx.restore();\n131\t      this.ink.renderTransition(p);\n132\t    } else {\n133\t      this.renderScene(this.currentScene);\n134\t    }\n135\t  }\n136\t\n137\t  private renderScene(scene: GameScene | null) {\n138\t    if (!scene) return;\n139\t    const ctx = this.renderer.context;\n140\t    const w = this.renderer.w;\n141\t    const h = this.renderer.h;\n142\t\n143\t    ctx.fillStyle = scene.background;\n144\t    ctx.fillRect(0, 0, w, h);\n145\t\n146\t    if (scene.ambientColor) {\n147\t      const grad = ctx.createRadialGradient(w / 2, h / 2, 0, w / 2, h / 2, w * 0.7);\n148\t      grad.addColorStop(0, scene.ambientColor);\n149\t      grad.addColorStop(1, 'transparent');\n150\t      ctx.fillStyle = grad;\n151\t      ctx.fillRect(0, 0, w, h);\n152\t    }\n153\t\n154\t    if (scene.lighting) {\n155\t      const lx = w * scene.lighting.x;\n156\t      const ly = h * scene.lighting.y;\n157\t      const lr = Math.max(w, h) * scene.lighting.radius;\n158\t      const grad = ctx.createRadialGradient(lx, ly, 0, lx, ly, lr);\n159\t      grad.addColorStop(0, `rgba(255, 200, 100, ${scene.lighting.intensity * 0.15})`);\n160\t      grad.addColorStop(0.5, `rgba(255, 150, 50, ${scene.lighting.intensity * 0.05})`);\n161\t      grad.addColorStop(1, 'transparent');\n162\t      ctx.fillStyle = grad;\n163\t      ctx.fillRect(0, 0, w, h);\n164\t    }\n165\t\n166\t    this.layers.forEach((l) => {\n167\t      if (l.image) {\n168\t        this.renderer.drawImage(l.image, l.x, l.y, undefined, undefined, l.alpha);\n169\t      } else if (l.color && l.id !== 'bg') {\n170\t        ctx.save();\n171\t        ctx.globalAlpha = l.alpha;\n172\t        ctx.fillStyle = l.color;\n173\t        ctx.fillRect(l.x, l.y, w, h);\n174\t        ctx.restore();\n175\t      }\n176\t    });\n177\t  }\n178\t\n179\t  getCurrentScene(): GameScene | null { return this.currentScene; }\n180\t  isTransitioning(): boolean { return this.transitioning; }\n181\t}\n182\t"}]},"parent_tool_use_id":null,"session_id":"60e8bd2a-b118-4ebb-8072-7fe7ed523870","uuid":"88cdbce7-de3f-4f98-8cf7-0f362478c0d5","timestamp":"2026-05-23T17:48:27.476Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-ancient-mystery\\src\\game\\SceneManager.ts","content":"import { Renderer } from '../renderer/Renderer';\nimport { GameState } from './GameState';\nimport { InkRenderer } from '../utils/ink';\n\nexport interface SceneLayer {\n  id: string;\n  image?: HTMLCanvasElement;\n  color?: string;\n  alpha: number;\n  targetAlpha: number;\n  x: number;\n  y: number;\n}\n\nexport interface GameScene {\n  id: string;\n  background: string;\n  foreground?: string[];\n  ambientColor?: string;\n  lighting?: { x: number; y: number; radius: number; intensity: number };\n}\n\nexport class SceneManager {\n  private scenes: Map<string, GameScene> = new Map();\n  private currentScene: GameScene | null = null;\n  private layers: SceneLayer[] = [];\n  private transitioning = false;\n  private transitionProgress = 0;\n  private transitionDuration = 1.5;\n  private pendingScene: GameScene | null = null;\n  private ink: InkRenderer;\n\n  constructor(private renderer: Renderer, private state: GameState) {\n    this.ink = new InkRenderer(renderer);\n    this.registerDefaultScenes();\n  }\n\n  private registerDefaultScenes() {\n    const scenes: GameScene[] = [\n      { id: 'main_menu', background: '#0d0d0d', ambientColor: '#1a0a00' },\n      { id: 'county_office', background: '#1a1008', ambientColor: '#2a1a0a',\n        lighting: { x: 0.5, y: 0.3, radius: 0.4, intensity: 0.6 } },\n      { id: 'west_market', background: '#1a1508', ambientColor: '#2a200a',\n        lighting: { x: 0.5, y: 0.5, radius: 0.5, intensity: 0.7 } },\n      { id: 'east_market_ruins', background: '#0a0d10', ambientColor: '#0a1020',\n        lighting: { x: 0.5, y: 0.6, radius: 0.3, intensity: 0.3 } },\n      { id: 'daming_palace', background: '#100808', ambientColor: '#1a0a0a',\n        lighting: { x: 0.5, y: 0.2, radius: 0.4, intensity: 0.5 } },\n      { id: 'daciensi_temple', background: '#0d0a08', ambientColor: '#1a150a',\n        lighting: { x: 0.5, y: 0.4, radius: 0.4, intensity: 0.5 } },\n      { id: 'pingkang_ward', background: '#1a0a10', ambientColor: '#2a0a1a',\n        lighting: { x: 0.5, y: 0.5, radius: 0.5, intensity: 0.7 } },\n      { id: 'underground', background: '#050508', ambientColor: '#0a0a10',\n        lighting: { x: 0.5, y: 0.5, radius: 0.15, intensity: 0.2 } },\n      { id: 'judge_hall', background: '#08050a', ambientColor: '#100820',\n        lighting: { x: 0.5, y: 0.3, radius: 0.3, intensity: 0.4 } },\n    ];\n    scenes.forEach((s) => this.scenes.set(s.id, s));\n  }\n\n  registerScene(scene: GameScene) {\n    this.scenes.set(scene.id, scene);\n  }\n\n  switchTo(sceneId: string, transition = true) {\n    const scene = this.scenes.get(sceneId);\n    if (!scene) return;\n    this.state.scene = sceneId;\n    if (transition && this.currentScene) {\n      this.pendingScene = scene;\n      this.transitioning = true;\n      this.transitionProgress = 0;\n    } else {\n      this.currentScene = scene;\n      this.buildLayers();\n    }\n  }\n\n  private buildLayers() {\n    this.layers = [];\n    if (!this.currentScene) return;\n    this.layers.push({\n      id: 'bg', color: this.currentScene.background, alpha: 1, targetAlpha: 1,\n      x: 0, y: 0,\n    });\n    if (this.currentScene.foreground) {\n      this.currentScene.foreground.forEach((fg, i) => {\n        this.layers.push({\n          id: `fg_${i}`, color: fg, alpha: 1, targetAlpha: 1,\n          x: 0, y: 0,\n        });\n      });\n    }\n  }\n\n  update(dt: number) {\n    if (this.transitioning) {\n      this.transitionProgress += dt / this.transitionDuration;\n      if (this.transitionProgress >= 1) {\n        this.transitioning = false;\n        this.transitionProgress = 1;\n        if (this.pendingScene) {\n          this.currentScene = this.pendingScene;\n          this.pendingScene = null;\n          this.buildLayers();\n        }\n      }\n    }\n    this.layers.forEach((l) => {\n      if (l.alpha !== l.targetAlpha) {\n        const diff = l.targetAlpha - l.alpha;\n        l.alpha += Math.sign(diff) * Math.min(Math.abs(diff), dt * 3);\n      }\n    });\n    this.ink.update(dt);\n  }\n\n  render() {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    if (this.transitioning && this.pendingScene) {\n      const p = this.transitionProgress;\n      ctx.save();\n      ctx.globalAlpha = 1 - p;\n      this.renderScene(this.currentScene);\n      ctx.globalAlpha = p;\n      this.renderScene(this.pendingScene);\n      ctx.restore();\n      this.ink.renderTransition(p);\n    } else {\n      this.renderScene(this.currentScene);\n    }\n  }\n\n  private renderScene(scene: GameScene | null) {\n    if (!scene) return;\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.fillStyle = scene.background;\n    ctx.fillRect(0, 0, w, h);\n\n    if (scene.ambientColor) {\n      const grad = ctx.createRadialGradient(w / 2, h / 2, 0, w / 2, h / 2, w * 0.7);\n      grad.addColorStop(0, scene.ambientColor);\n      grad.addColorStop(1, 'transparent');\n      ctx.fillStyle = grad;\n      ctx.fillRect(0, 0, w, h);\n    }\n\n    if (scene.lighting) {\n      const lx = w * scene.lighting.x;\n      const ly = h * scene.lighting.y;\n      const lr = Math.max(w, h) * scene.lighting.radius;\n      const grad = ctx.createRadialGradient(lx, ly, 0, lx, ly, lr);\n      grad.addColorStop(0, `rgba(255, 200, 100, ${scene.lighting.intensity * 0.15})`);\n      grad.addColorStop(0.5, `rgba(255, 150, 50, ${scene.lighting.intensity * 0.05})`);\n      grad.addColorStop(1, 'transparent');\n      ctx.fillStyle = grad;\n      ctx.fillRect(0, 0, w, h);\n    }\n\n    this.layers.forEach((l) => {\n      if (l.image) {\n        this.renderer.drawImage(l.image, l.x, l.y, undefined, undefined, l.alpha);\n      } else if (l.color && l.id !== 'bg') {\n        ctx.save();\n        ctx.globalAlpha = l.alpha;\n        ctx.fillStyle = l.color;\n        ctx.fillRect(l.x, l.y, w, h);\n        ctx.restore();\n      }\n    });\n  }\n\n  getCurrentScene(): GameScene | null { return this.currentScene; }\n  isTransitioning(): boolean { return this.transitioning; }\n}\n","numLines":182,"startLine":1,"totalLines":182}}}
