TrialConfig } from '../../game/TrialLoop';\nimport { ChapterManager, ChapterData } from '../../game/ChapterManager';\nimport { AudioManager } from '../../audio/AudioManager';","originalFile":"import { Renderer } from '../renderer/Renderer';\nimport { SceneManager, GameScene } from '../game/SceneManager';\nimport { DialogueEngine } from '../game/DialogueEngine';\nimport { GameState } from '../game/GameState';\nimport { InputManager } from '../game/InputManager';\nimport { SceneExplorer } from '../game/SceneExplorer';\nimport { EvidenceCollector } from '../game/EvidenceCollector';\nimport { InterrogationSystem } from '../game/InterrogationSystem';\nimport { EvidenceCombiner } from '../game/EvidenceCombiner';\nimport { ReasoningBoard } from '../game/ReasoningBoard';\nimport { TrialLoop, TrialConfig } from '../game/TrialLoop';\nimport { ChapterManager, ChapterData } from '../game/ChapterManager';\nimport { AudioManager } from '../audio/AudioManager';\nimport ch1Data from '../../data/chapters/ch1.json';\nimport ch2Data from '../../data/chapters/ch2.json';\n\nexport type UIScreen = 'main_menu' | 'game' | 'settings' | 'save_load' | 'dialogue' | 'explore' | 'interrogation' | 'evidence' | 'combine' | 'reasoning' | 'trial' | 'chapter_select';\n\nexport class UIManager {\n  private currentScreen: UIScreen = 'main_menu';\n  private screenAlpha = 1;\n  private sceneExplorer: SceneExplorer;\n  private evidenceCollector: EvidenceCollector;\n  private interrogationSystem: InterrogationSystem;\n  private evidenceCombiner: EvidenceCombiner;\n  private reasoningBoard: ReasoningBoard;\n  private trialLoop: TrialLoop;\n  private chapterManager: ChapterManager;\n  private audio: AudioManager;\n  private currentChapterData: ChapterData | null = null;\n  private chapterSceneIndex = 0;\n\n  constructor(\n    private renderer: Renderer,\n    private sceneManager: SceneManager,\n    private dialogueEngine: DialogueEngine,\n    private state: GameState,\n    private input: InputManager,\n    audio: AudioManager,\n  ) {\n    this.sceneExplorer = new SceneExplorer(renderer, state, input);\n    this.evidenceCollector = new EvidenceCollector(renderer, state, input);\n    this.interrogationSystem = new InterrogationSystem(renderer, state, dialogueEngine, input);\n    this.evidenceCombiner = new EvidenceCombiner(renderer, state, input, this.evidenceCollector);\n    this.reasoningBoard = new ReasoningBoard(renderer, state, input);\n    this.trialLoop = new TrialLoop(renderer, state, input);\n    this.chapterManager = new ChapterManager(state);\n    this.audio = audio;\n\n    // Register chapters\n    this.chapterManager.registerChapter(ch1Data as unknown as ChapterData);\n    this.chapterManager.registerChapter(ch2Data as unknown as ChapterData);\n\n    this.setupInput();\n    this.setupHotspotCallback();\n  }\n\n  private setupHotspotCallback() {\n    this.sceneExplorer.setActionCallback((hs) => {\n      if (hs.action === 'talk' && hs.dialogueId) {\n        this.dialogueEngine.start(hs.dialogueId);\n        this.showScreen('dialogue');\n      }\n      if (hs.action === 'pickup' && hs.giveEvidence) {\n        this.audio.playSFX('pickup');\n      }\n      if (hs.action === 'examine') {\n        this.audio.playSFX('examine');\n      }\n    });\n\n    this.reasoningBoard.setHypothesisCallback((h) => {\n      this.state.setFlag(`hypothesis_${h.id}`, true);\n    });\n  }\n\n  private loadChapterIntoSystems(data: ChapterData) {\n    this.currentChapterData = data;\n    this.state.chapter = data.chapter;\n    this.state.evidence = [];\n    this.state.scene = data.scenes[0]?.id ?? 'county_office';\n\n    // Register scenes\n    data.scenes.forEach((s) => {\n      this.sceneManager.registerScene(s as GameScene);\n    });\n\n    // Inject into all game systems\n    this.chapterManager.injectIntoSystems(\n      data,\n      this.dialogueEngine,\n      this.sceneExplorer,\n      this.evidenceCollector,\n      this.interrogationSystem,\n      this.evidenceCombiner,\n      this.reasoningBoard,\n    );\n\n    this.chapterSceneIndex = 0;\n    this.sceneManager.switchTo(data.scenes[0]?.id ?? 'county_office', false);\n\n    // Set audio scene\n    this.audio.init();\n    this.audio.setSceneConfig({\n      ambient: data.ambientConfig.layers.map((l) => ({\n        id: l.id,\n        src: '',\n        volume: l.volume,\n        loop: l.loop,\n        fadeIn: 2,\n      })),\n    });\n  }\n\n  private startChapter(chapterNum: number) {\n    const data = this.chapterManager.loadChapter(chapterNum);\n    if (!data) return;\n\n    this.loadChapterIntoSystems(data);\n\n    // Start intro dialogue\n    this.showScreen('dialogue');\n    this.dialogueEngine.start(data.introDialogue, () => {\n      this.showScreen('explore');\n      this.sceneExplorer.activate(this.state.scene);\n    });\n  }\n\n  private setupInput() {\n    this.input.onClick((e) => {\n      if (e.type !== 'up') return;\n      this.handleClick(e.x, e.y);\n    });\n  }\n\n  private handleClick(x: number, y: number) {\n    switch (this.currentScreen) {\n      case 'main_menu': this.handleMenuClick(x, y); break;\n      case 'dialogue': this.handleDialogueClick(x, y); break;\n      case 'settings': this.handleSettingsClick(x, y); break;\n      case 'save_load': this.handleSaveLoadClick(x, y); break;\n      case 'explore': this.handleExploreClick(x, y); break;\n      case 'chapter_select': this.handleChapterSelectClick(x, y); break;\n      case 'interrogation': break;\n      case 'evidence': break;\n      case 'combine': break;\n      case 'reasoning': break;\n      case 'trial': break;\n      case 'game': break;\n    }\n  }\n\n  resize(w: number, h: number) {}\n\n  update(dt: number) {\n    this.state.playTime += dt;\n    this.sceneExplorer.update(dt);\n    this.evidenceCollector.update(dt);\n    this.interrogationSystem.update(dt);\n    this.evidenceCombiner.update(dt);\n    this.reasoningBoard.update(dt);\n    this.trialLoop.update(dt);\n  }\n\n  render() {\n    switch (this.currentScreen) {\n      case 'main_menu': this.renderMainMenu(); break;\n      case 'chapter_select': this.renderChapterSelect(); break;\n      case 'game': this.renderGameHUD(); break;\n      case 'dialogue': this.renderDialogueUI(); break;\n      case 'settings': this.renderSettings(); break;\n      case 'save_load': this.renderSaveLoad(); break;\n      case 'explore': this.renderExploreScreen(); break;\n      case 'interrogation': this.renderInterrogationScreen(); break;\n      case 'evidence': this.renderEvidenceScreen(); break;\n      case 'combine': this.renderCombineScreen(); break;\n      case 'reasoning': this.renderReasoningScreen(); break;\n      case 'trial': this.renderTrialScreen(); break;\n    }\n  }\n\n  // ── Main Menu ──\n\n  private menuItems = [\n    { label: '开始游戏', action: () => this.showScreen('chapter_select') },\n    { label: '继续游戏', action: () => this.showScreen('save_load') },\n    { label: '设置', action: () => this.showScreen('settings') },\n  ];\n\n  private renderMainMenu() {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0, '#0d0808');\n    grad.addColorStop(0.5, '#1a0a0a');\n    grad.addColorStop(1, '#0d0808');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n\n    ctx.save();\n    ctx.globalAlpha = 0.05;\n    for (let i = 0; i < 5; i++) {\n      const cx = w * 0.3 + Math.sin(i * 1.7) * w * 0.2;\n      const cy = h * 0.4 + Math.cos(i * 2.3) * h * 0.15;\n      const r = 80 + i * 30;\n      const g2 = ctx.createRadialGradient(cx, cy, 0, cx, cy, r);\n      g2.addColorStop(0, '#8b0000');\n      g2.addColorStop(1, 'transparent');\n      ctx.fillStyle = g2;\n      ctx.fillRect(0, 0, w, h);\n    }\n    ctx.restore();\n\n    this.renderer.drawText('长 安 诡 案 录', w / 2, h * 0.22, {\n      font: 'bold 64px \"SimSun\", \"Noto Serif SC\", serif',\n      color: '#c8a882',\n      align: 'center',\n    });\n    this.renderer.drawText('Records of Chang\\'an Anomalies', w / 2, h * 0.32, {\n      font: '20px \"Georgia\", serif',\n      color: '#8a7a6a',\n      align: 'center',\n    });\n\n    ctx.strokeStyle = '#4a3020';\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    ctx.moveTo(w * 0.3, h * 0.40);\n    ctx.lineTo(w * 0.7, h * 0.40);\n    ctx.stroke();\n\n    this.menuItems.forEach((item, i) => {\n      const y = h * 0.50 + i * 60;\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, w * 0.35, y - 20, w * 0.3, 45);\n      const color = isHover ? '#e8c8a2' : '#a08870';\n\n      if (isHover) {\n        ctx.save();\n        ctx.globalAlpha = 0.15;\n        ctx.fillStyle = '#4a3020';\n        ctx.fillRect(w * 0.35, y - 20, w * 0.3, 45);\n        ctx.restore();\n      }\n\n      this.renderer.drawText(item.label, w / 2, y, {\n        font: '28px \"SimSun\", \"Noto Serif SC\", serif',\n        color,\n        align: 'center',\n      });\n    });\n\n    this.renderer.drawText('v0.4.0 - M4 Ch1+Ch2 完整制作', w / 2, h * 0.92, {\n      font: '14px sans-serif', color: '#4a3a2a', align: 'center',\n    });\n  }\n\n  private handleMenuClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    this.menuItems.forEach((item, i) => {\n      const iy = h * 0.50 + i * 60;\n      if (this.isInRect(x, y, w * 0.35, iy - 20, w * 0.3, 45)) {\n        item.action();\n      }\n    });\n  }\n\n  // ── Chapter Select ──\n\n  private renderChapterSelect() {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.fillStyle = 'rgba(10, 8, 6, 0.97)';\n    ctx.fillRect(0, 0, w, h);\n\n    this.renderer.drawText('章 节 选 择', w / 2, h * 0.08, {\n      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif',\n      color: '#c8a882', align: 'center',\n    });\n\n    const chapters = [\n      { num: 1, title: '鬼市浮尸', subtitle: '东市废墟水渠中发现一具浮尸', color: '#6a8a4a' },\n      { num: 2, title: '牡丹杀局', subtitle: '平康坊花魁在牡丹宴上中毒身亡', color: '#8a4a6a' },\n      { num: 3, title: '大明宫闹鬼', subtitle: '（开发中）', color: '#4a4a4a' },\n      { num: 4, title: '地下迷城', subtitle: '（开发中）', color: '#4a4a4a' },\n      { num: 5, title: '判官殿', subtitle: '（开发中）', color: '#4a4a4a' },\n    ];\n\n    chapters.forEach((ch, i) => {\n      const col = i % 3;\n      const row = Math.floor(i / 3);\n      const cx = w * 0.18 + col * (w * 0.28);\n      const cy = h * 0.20 + row * (h * 0.32);\n      const cw = w * 0.25;\n      const ch2 = h * 0.26;\n      const isAvailable = ch.num <= 2;\n      const isComplete = this.state.isChapterComplete(ch.num);\n      const isHover = isAvailable && this.isInRect(this.input.mouseX, this.input.mouseY, cx, cy, cw, ch2);\n\n      ctx.save();\n      ctx.globalAlpha = isAvailable ? (isHover ? 0.95 : 0.75) : 0.35;\n      this.renderer.drawRoundRect(cx, cy, cw, ch2, 8, '#1a140e', isHover ? '#6a5040' : '#3a2a1a');\n      ctx.restore();\n\n      this.renderer.drawText(`第${ch.num}章`, cx + 15, cy + 15, {\n        font: '14px \"SimSun\", \"Noto Serif SC\", serif', color: ch.color,\n      });\n\n      this.renderer.drawText(ch.title, cx + cw / 2, cy + 50, {\n        font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif', color: isAvailable ? '#e8c8a2' : '#4a3a2a', align: 'center',\n      });\n\n      this.renderer.drawText(ch.subtitle, cx + cw / 2, cy + 85, {\n        font: '14px \"SimSun\", \"Noto Serif SC\", serif', color: isAvailable ? '#8a7a6a' : '#3a2a1a', align: 'center',\n      });\n\n      if (isComplete) {\n        this.renderer.drawText('✓ 已完成', cx + cw / 2, cy + ch2 - 30, {\n          font: '16px \"SimSun\", \"Noto Serif SC\", serif', color: '#6a8a4a', align: 'center',\n        });\n      }\n    });\n\n    this.renderBackButton(w, h);\n  }\n\n  private handleChapterSelectClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    if (this.isInRect(x, y, w * 0.35, h * 0.85, w * 0.3, 45)) {\n      this.showScreen('main_menu');\n      return;\n    }\n\n    const chapters = [\n      { num: 1, col: 0, row: 0 },\n      { num: 2, col: 1, row: 0 },\n    ];\n\n    for (const ch of chapters) {\n      const cx = w * 0.18 + ch.col * (w * 0.28);\n      const cy = h * 0.20 + ch.row * (h * 0.32);\n      const cw = w * 0.25;\n      const ch2 = h * 0.26;\n      if (this.isInRect(x, y, cx, cy, cw, ch2)) {\n        this.startChapter(ch.num);\n        return;\n      }\n    }\n  }\n\n  // ── Dialogue UI ──\n\n  private renderDialogueUI() {\n    this.renderGameHUD();\n    if (!this.dialogueEngine.getIsActive()) return;\n\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    const boxH = 200;\n    const boxY = h - boxH - 20;\n    const boxX = 40;\n    const boxW = w - 80;\n\n    ctx.save();\n    ctx.globalAlpha = 0.92;\n    this.renderer.drawRoundRect(boxX, boxY, boxW, boxH, 8, '#1a140e', '#3a2a1a');\n    ctx.restore();\n\n    ctx.strokeStyle = '#5a4030';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    const m = 6;\n    ctx.roundRect(boxX + m, boxY + m, boxW - m * 2, boxH - m * 2, 4);\n    ctx.stroke();\n\n    const speaker = this.dialogueEngine.getSpeaker();\n    if (speaker) {\n      const spW = ctx.measureText(speaker).width || speaker.length * 28;\n      this.renderer.drawRoundRect(boxX + 20, boxY - 18, spW + 40, 36, 6, '#2a1a0e', '#5a4030');\n      this.renderer.drawText(speaker, boxX + 40, boxY - 10, {\n        font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2',\n      });\n    }\n\n    const text = this.dialogueEngine.getDisplayText();\n    this.renderWrappedText(text, boxX + 30, boxY + 30, boxW - 60, boxH - 60, {\n      font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0',\n    });\n\n    if (!this.dialogueEngine.getIsTyping()) {\n      const choices = this.dialogueEngine.getChoices();\n      if (choices.length > 0) {\n        choices.forEach((c, i) => {\n          const cy = boxY + boxH + 15 + i * 48;\n          const cx = boxX + 30;\n          const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, cx, cy - 5, boxW - 60, 38);\n\n          if (isHover) {\n            ctx.save();\n            ctx.globalAlpha = 0.3;\n            this.renderer.drawRoundRect(cx, cy - 5, boxW - 60, 38, 4, '#3a2a1a');\n            ctx.restore();\n          }\n\n          this.renderer.drawText(`▸ ${c.text}`, cx + 10, cy + 3, {\n            font: '20px \"SimSun\", \"Noto Serif SC\", serif',\n            color: isHover ? '#f0d8b0' : '#b8a890',\n          });\n        });\n      } else {\n        const blinkAlpha = 0.4 + Math.sin(Date.now() * 0.005) * 0.3;\n        this.renderer.drawText('▼', boxX + boxW - 40, boxY + boxH - 40, {\n          font: '18px sans-serif', color: '#8a7a6a', alpha: blinkAlpha,\n        });\n      }\n    }\n  }\n\n  private handleDialogueClick(x: number, y: number) {\n    if (!this.dialogueEngine.getIsActive()) return;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    const boxH = 200;\n    const boxY = h - boxH - 20;\n    const boxX = 40;\n    const boxW = w - 80;\n\n    if (this.dialogueEngine.getIsTyping()) {\n      this.dialogueEngine.advance();\n      return;\n    }\n\n    const choices = this.dialogueEngine.getChoices();\n    if (choices.length > 0) {\n      choices.forEach((c, i) => {\n        const cy = boxY + boxH + 15 + i * 48;\n        if (this.isInRect(x, y, boxX + 30, cy - 5, boxW - 60, 38)) {\n          this.dialogueEngine.selectChoice(i);\n        }\n      });\n    } else {\n      if (this.isInRect(x, y, boxX, boxY, boxW, boxH)) {\n        const ended = !this.dialogueEngine.advance();\n        if (ended) {\n          this.showScreen('explore');\n          this.sceneExplorer.activate(this.state.scene);\n        }\n      }\n    }\n  }\n\n  // ── Settings ──\n\n  private settingsItems = [\n    { label: '文字速度', key: 'textSpeed', min: 10, max: 80 },\n    { label: '主音量', key: 'master', min: 0, max: 100 },\n    { label: '音乐音量', key: 'bgm', min: 0, max: 100 },\n    { label: '音效音量', key: 'sfx', min: 0, max: 100 },\n  ];\n\n  private renderSettings() {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.fillStyle = 'rgba(10, 8, 6, 0.95)';\n    ctx.fillRect(0, 0, w, h);\n\n    this.renderer.drawText('设  置', w / 2, h * 0.12, {\n      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif',\n      color: '#c8a882', align: 'center',\n    });\n\n    this.settingsItems.forEach((item, i) => {\n      const y = h * 0.30 + i * 70;\n      this.renderer.drawText(item.label, w * 0.25, y, {\n        font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870',\n      });\n\n      const barX = w * 0.45;\n      const barW = w * 0.30;\n      const barH = 8;\n      ctx.fillStyle = '#2a1a0e';\n      ctx.fillRect(barX, y + 8, barW, barH);\n\n      const val = item.key === 'textSpeed'\n        ? (this.state.settings.textSpeed - item.min) / (item.max - item.min)\n        : (this.state.settings.volume[item.key as keyof typeof this.state.settings.volume] ?? 0.8);\n      ctx.fillStyle = '#8b4513';\n      ctx.fillRect(barX, y + 8, barW * val, barH);\n\n      const knobX = barX + barW * val;\n      ctx.fillStyle = '#c8a882';\n      ctx.beginPath();\n      ctx.arc(knobX, y + 12, 8, 0, Math.PI * 2);\n      ctx.fill();\n    });\n\n    this.renderBackButton(w, h);\n  }\n\n  private handleSettingsClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    if (this.isInRect(x, y, w * 0.35, h * 0.85, w * 0.3, 45)) {\n      this.showScreen('main_menu');\n    }\n  }\n\n  // ── Save/Load ──\n\n  private renderSaveLoad() {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.fillStyle = 'rgba(10, 8, 6, 0.95)';\n    ctx.fillRect(0, 0, w, h);\n\n    this.renderer.drawText('存  档', w / 2, h * 0.08, {\n      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif',\n      color: '#c8a882', align: 'center',\n    });\n\n    for (let i = 0; i < 6; i++) {\n      const col = i % 3;\n      const row = Math.floor(i / 3);\n      const sx = w * 0.12 + col * (w * 0.28);\n      const sy = h * 0.18 + row * (h * 0.32);\n      const sw = w * 0.25;\n      const sh = h * 0.26;\n\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, sx, sy, sw, sh);\n\n      ctx.save();\n      ctx.globalAlpha = isHover ? 0.9 : 0.7;\n      this.renderer.drawRoundRect(sx, sy, sw, sh, 6, '#1a140e', isHover ? '#6a5040' : '#3a2a1a');\n      ctx.restore();\n\n      this.renderer.drawText(`存档 ${i + 1}`, sx + 15, sy + 15, {\n        font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870',\n      });\n      this.renderer.drawText('空', sx + sw / 2, sy + sh / 2 - 10, {\n        font: '24px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n      });\n    }\n\n    this.renderBackButton(w, h);\n  }\n\n  private handleSaveLoadClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    if (this.isInRect(x, y, w * 0.35, h * 0.85, w * 0.3, 45)) {\n      this.showScreen('main_menu');\n    }\n  }\n\n  // ── Explore / Toolbar ──\n\n  private renderExploreScreen() {\n    this.sceneExplorer.render();\n    this.renderToolbar();\n  }\n\n  private handleExploreClick(x: number, y: number) {\n    this.handleToolbarClick(x, y);\n  }\n\n  private renderInterrogationScreen() {\n    this.interrogationSystem.render();\n    this.renderToolbar();\n  }\n\n  private renderEvidenceScreen() {\n    this.evidenceCollector.render();\n  }\n\n  private renderCombineScreen() {\n    this.evidenceCombiner.render();\n  }\n\n  private renderReasoningScreen() {\n    this.reasoningBoard.render();\n    this.renderToolbar();\n  }\n\n  private renderTrialScreen() {\n    this.trialLoop.render();\n  }\n\n  private renderToolbar() {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    const toolbarY = h - 60;\n    ctx.save();\n    ctx.globalAlpha = 0.85;\n    ctx.fillStyle = '#0e0a08';\n    ctx.fillRect(0, toolbarY, w, 60);\n    ctx.strokeStyle = '#3a2a1a';\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    ctx.moveTo(0, toolbarY);\n    ctx.lineTo(w, toolbarY);\n    ctx.stroke();\n    ctx.restore();\n\n    const chapterTitle = this.currentChapterData ? `Ch${this.currentChapterData.chapter}: ${this.currentChapterData.title}` : '';\n\n    if (chapterTitle) {\n      ctx.save();\n      ctx.globalAlpha = 0.5;\n      this.renderer.drawText(chapterTitle, 15, toolbarY + 22, {\n        font: '12px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a',\n      });\n      ctx.restore();\n    }\n\n    const buttons = [\n      { label: '探索', screen: 'explore' as UIScreen, x: w * 0.18 },\n      { label: '审问', screen: 'interrogation' as UIScreen, x: w * 0.28 },\n      { label: '物证', screen: 'evidence' as UIScreen, x: w * 0.38 },\n      { label: '组合', screen: 'combine' as UIScreen, x: w * 0.48 },\n      { label: '推理', screen: 'reasoning' as UIScreen, x: w * 0.58 },\n      { label: '庭审', screen: 'trial' as UIScreen, x: w * 0.68 },\n      { label: '章节', screen: 'chapter_select' as UIScreen, x: w * 0.80 },\n      { label: '菜单', screen: 'main_menu' as UIScreen, x: w * 0.92 },\n    ];\n\n    buttons.forEach((btn) => {\n      const isActive = this.currentScreen === btn.screen;\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, btn.x - 35, toolbarY + 10, 70, 40);\n\n      if (isActive) {\n        ctx.fillStyle = 'rgba(200, 168, 130, 0.15)';\n        ctx.fillRect(btn.x - 35, toolbarY + 10, 70, 40);\n      } else if (isHover) {\n        ctx.fillStyle = 'rgba(200, 168, 130, 0.07)';\n        ctx.fillRect(btn.x - 35, toolbarY + 10, 70, 40);\n      }\n\n      this.renderer.drawText(btn.label, btn.x, toolbarY + 20, {\n        font: '16px \"SimSun\", \"Noto Serif SC\", serif',\n        color: isActive ? '#e8c8a2' : isHover ? '#c8a882' : '#8a7a6a',\n        align: 'center',\n      });\n    });\n  }\n\n  private handleToolbarClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    const toolbarY = h - 60;\n    if (y < toolbarY) return;\n\n    const buttons: { screen: UIScreen; x: number; action?: () => void }[] = [\n      { screen: 'explore', x: w * 0.18, action: () => this.sceneExplorer.activate(this.state.scene) },\n      { screen: 'interrogation', x: w * 0.28, action: () => { if (this.currentChapterData?.npcs?.[0]) this.interrogationSystem.startInterrogation(this.currentChapterData.npcs[0].id); } },\n      { screen: 'evidence', x: w * 0.38, action: () => this.evidenceCollector.open() },\n      { screen: 'combine', x: w * 0.48, action: () => this.evidenceCombiner.open() },\n      { screen: 'reasoning', x: w * 0.58, action: () => this.reasoningBoard.open() },\n      { screen: 'trial', x: w * 0.68, action: () => this.startChapterTrial() },\n      { screen: 'chapter_select', x: w * 0.80 },\n      { screen: 'main_menu', x: w * 0.92 },\n    ];\n\n    for (const btn of buttons) {\n      if (this.isInRect(x, y, btn.x - 35, toolbarY + 10, 70, 40)) {\n        btn.action?.();\n        this.showScreen(btn.screen);\n        return;\n      }\n    }\n  }\n\n  private startChapterTrial() {\n    if (!this.currentChapterData?.trial) return;\n    this.trialLoop.startTrial(this.currentChapterData.trial as any);\n  }\n\n  // ── Game HUD ──\n\n  private renderGameHUD() {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.save();\n    ctx.globalAlpha = 0.5;\n    ctx.fillStyle = '#c8a882';\n    ctx.font = '14px sans-serif';\n    ctx.fillText(`第${this.state.chapter}章 | ${this.state.scene} | 物证:${this.state.evidence.length}`, 15, 20);\n    ctx.restore();\n\n    this.renderToolbar();\n  }\n\n  // ── Helpers ──\n\n  private renderWrappedText(text: string, x: number, y: number, maxW: number, maxH: number,\n    opts: { font?: string; color?: string }) {\n    const ctx = this.renderer.context;\n    ctx.save();\n    ctx.font = opts.font ?? '20px \"SimSun\", \"Noto Serif SC\", serif';\n    ctx.fillStyle = opts.color ?? '#d8c8b0';\n\n    let lineY = y;\n    let line = '';\n    for (const ch of text) {\n      const test = line + ch;\n      if (ctx.measureText(test).width > maxW) {\n        ctx.fillText(line, x, lineY);\n        line = ch;\n        lineY += 28;\n        if (lineY - y > maxH) break;\n      } else {\n        line = test;\n      }\n    }\n    if (line) ctx.fillText(line, x, lineY);\n    ctx.restore();\n  }\n\n  private renderBackButton(w: number, h: number) {\n    const bx = w * 0.35;\n    const by = h * 0.85;\n    const bw = w * 0.3;\n    const bh = 45;\n    const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, bx, by, bw, bh);\n\n    this.renderer.drawRoundRect(bx, by, bw, bh, 6,\n      isHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('返回', w / 2, by + 12, {\n      font: '24px \"SimSun\", \"Noto Serif SC\", serif',\n      color: isHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n  }\n\n  private showScreen(screen: UIScreen) { this.currentScreen = screen; }\n\n  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n  }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":16,"newStart":1,"newLines":16,"lines":["-import { Renderer } from '../renderer/Renderer';","-import { SceneManager, GameScene } from '../game/SceneManager';","-import { DialogueEngine } from '../game/DialogueEngine';","-import { GameState } from '../game/GameState';","-import { InputManager } from '../game/InputManager';","-import { SceneExplorer } from '../game/SceneExplorer';","-import { EvidenceCollector } from '../game/EvidenceCollector';","-import { InterrogationSystem } from '../game/InterrogationSystem';","-import { EvidenceCombiner } from '../game/Evidence