笔', chars: ['画','龙','点','睛'] },\n  { idiom: '守株待兔', meaning: '比喻不劳而获', chars: ['守','株','待','兔'] },\n  { idiom: '叶公好龙', meaning: '比喻表里不一', chars: ['叶','公','好','龙'] },\n  { idiom: '杯弓蛇影', meaning: '比喻疑神疑鬼', chars: ['杯','弓','蛇','影'] },\n  { idiom: '鹤立鸡群', meaning: '比喻才能出众', chars: ['鹤','立','鸡','群'] },\n  { idiom: '画蛇添足', meaning: '比喻多此一举', chars: ['画','蛇','添','足'] },\n  { idiom: '亡羊补牢', meaning: '比喻出了问题及时补救', chars: ['亡','羊','补','牢'] },\n  { idiom: '对牛弹琴', meaning: '比喻对不懂的人讲道理', chars: ['对','牛','弹','琴'] },\n  { idiom: '井底之蛙', meaning: '比喻见识短浅', chars: ['井','底','之','蛙'] },\n  { idiom: '刻舟求剑', meaning: '比喻不知变通', chars: ['刻','舟','求','剑'] },\n  { idiom: '掩耳盗铃', meaning: '比喻自欺欺人', chars: ['掩','耳','盗','铃'] },\n  { idiom: '望梅止渴', meaning: '比喻用空想安慰自己', chars: ['望','梅','止','渴'] },\n  { idiom: '胸有成竹', meaning: '比喻做事有把握', chars: ['胸','有','成','竹'] },\n  { idiom: '闻鸡起舞', meaning: '比喻勤奋刻苦', chars: ['闻','鸡','起','舞'] },\n  { idiom: '指鹿为马', meaning: '比喻故意颠倒黑白', chars: ['指','鹿','为','马'] },\n  { idiom: '悬梁刺股', meaning: '比喻刻苦学习', chars: ['悬','梁','刺','股'] },\n  { idiom: '卧薪尝胆', meaning: '比喻忍辱负重', chars: ['卧','薪','尝','胆'] },\n  { idiom: '破釜沉舟', meaning: '比喻下定决心', chars: ['破','釜','沉','舟'] },\n  { idiom: '四面楚歌', meaning: '比喻陷入困境', chars: ['四','面','楚','歌'] },\n];\n\nlet currentIdiom = null;\nlet slots = [null, null, null, null];\nlet candidates = [];\nlet slotIndex = 0;\n\nfunction startGame() {\n  screen = 'game';\n  score = 0;\n  lives = 5;\n  combo = 0;\n  maxCombo = 0;\n  nextQuestion();\n}\n\nfunction nextQuestion() {\n  const idx = Math.floor(Math.random() * IDIOMS.length);\n  currentIdiom = IDIOMS[idx];\n  slots = [null, null, null, null];\n  slotIndex = 0;\n\n  // Create candidates: correct chars + distractors\n  const correct = [...currentIdiom.chars];\n  const distractorPool = '天地人和风云雨水火土金木日月星光春夏秋冬东南西北大小多少高低长短'.split('');\n  const distractors = [];\n  while (distractors.length < 4) {\n    const d = distractorPool[Math.floor(Math.random() * distractorPool.length)];\n    if (!correct.includes(d) && !distractors.includes(d)) distractors.push(d);\n  }\n  candidates = [...correct, ...distractors];\n  // Shuffle\n  for (let i = candidates.length - 1; i > 0; i--) {\n    const j = Math.floor(Math.random() * (i + 1));\n    [candidates[i], candidates[j]] = [candidates[j], candidates[i]];\n  }\n}\n\nfunction handleGameTouch(x, y) {\n  const W = windowWidth;\n  const candY = windowHeight * 0.6;\n  const cellSize = Math.min(W / 5, 60);\n  const gap = 8;\n  const totalW = 4 * cellSize + 3 * gap;\n  const startX = (W - totalW) / 2;\n\n  for (let i = 0; i < candidates.length; i++) {\n    const col = i % 4;\n    const row = Math.floor(i / 4);\n    const cx = startX + col * (cellSize + gap);\n    const cy = candY + row * (cellSize + gap);\n    if (x >= cx && x <= cx + cellSize && y >= cy && y <= cy + cellSize) {\n      if (slots.includes(i)) return;\n      if (slotIndex >= 4) return;\n      slots[slotIndex] = i;\n      slotIndex++;\n\n      if (slotIndex === 4) {\n        setTimeout(() => checkAnswer(), 300);\n      }\n      return;\n    }\n  }\n}\n\nfunction checkAnswer() {\n  const answer = slots.map(idx => candidates[idx]).join('');\n  if (answer === currentIdiom.idiom) {\n    score += 10 + combo * 2;\n    combo++;\n    if (combo > maxCombo) maxCombo = combo;\n    coins += 3;\n    nextQuestion();\n  } else {\n    lives--;\n    combo = 0;\n    if (lives <= 0) {\n      screen = 'result';\n    } else {\n      slots = [null, null, null, null];\n      slotIndex = 0;\n    }\n  }\n}\n\n// Render loop\nfunction draw() {\n  const W = windowWidth;\n  const H = windowHeight;\n  ctx.clearRect(0, 0, W, H);\n\n  if (screen === 'menu') drawMenu(W, H);\n  else if (screen === 'game') drawGame(W, H);\n  else if (screen === 'result') drawResult(W, H);\n  else if (screen === 'collection') drawCollection(W, H);\n\n  requestAnimationFrame(draw);\n}\n\nfunction drawMenu(W, H) {\n  ctx.fillStyle = BG;\n  ctx.fillRect(0, 0, W, H);\n\n  // Title\n  ctx.fillStyle = PRIMARY;\n  ctx.font = `bold ${Math.min(W * 0.08, 36)}px sans-serif`;\n  ctx.textAlign = 'center';\n  ctx.fillText('鼎诺成语闯关', W / 2, H * 0.25);\n\n  ctx.fillStyle = GRAY;\n  ctx.font = `${Math.min(W * 0.04, 18)}px sans-serif`;\n  ctx.fillText('Idiom Challenge', W / 2, H * 0.3);\n\n  // Stats\n  ctx.fillStyle = GOLD;\n  ctx.font = `${Math.min(W * 0.04, 16)}px sans-serif`;\n  ctx.fillText(`🪙 ${coins}  📖 ${score}`, W / 2, H * 0.4);\n\n  // Start button\n  const btnW = W * 0.6, btnH = 50;\n  const btnX = (W - btnW) / 2;\n  ctx.fillStyle = PRIMARY;\n  roundRect(ctx, btnX, H * 0.55, btnW, btnH, 12);\n  ctx.fill();\n  ctx.fillStyle = WHITE;\n  ctx.font = `bold ${Math.min(W * 0.05, 22)}px sans-serif`;\n  ctx.fillText('闯关模式', W / 2, H * 0.55 + 33);\n\n  // Collection button\n  ctx.fillStyle = ACCENT;\n  roundRect(ctx, btnX, H * 0.68, btnW, btnH, 12);\n  ctx.fill();\n  ctx.fillStyle = WHITE;\n  ctx.fillText('成语图鉴', W / 2, H * 0.68 + 33);\n}\n\nfunction drawGame(W, H) {\n  ctx.fillStyle = BG;\n  ctx.fillRect(0, 0, W, H);\n\n  // Header\n  ctx.fillStyle = WHITE;\n  ctx.font = `bold ${Math.min(W * 0.04, 16)}px sans-serif`;\n  ctx.textAlign = 'left';\n  ctx.fillText(`第${level}关`, 15, 35);\n  ctx.textAlign = 'center';\n  ctx.fillText(`❤️ ${'❤️'.repeat(lives)}`, W / 2, 35);\n  ctx.textAlign = 'right';\n  ctx.fillText(`得分: ${score}`, W - 15, 35);\n\n  // Combo display\n  if (combo > 1) {\n    ctx.fillStyle = GOLD;\n    ctx.font = `bold ${Math.min(W * 0.06, 24)}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.fillText(`连击 x${combo}`, W / 2, 65);\n  }\n\n  // Meaning\n  if (currentIdiom) {\n    ctx.fillStyle = ACCENT;\n    roundRect(ctx, W * 0.1, H * 0.12, W * 0.8, 50, 10);\n    ctx.fill();\n    ctx.fillStyle = WHITE;\n    ctx.font = `${Math.min(W * 0.04, 16)}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.fillText(`💡 ${currentIdiom.meaning}`, W / 2, H * 0.12 + 32);\n\n    // Slots\n    const cellSize = Math.min(W / 5, 55);\n    const gap = 8;\n    const totalW = 4 * cellSize + 3 * gap;\n    const sx = (W - totalW) / 2;\n    const sy = H * 0.25;\n\n    for (let i = 0; i < 4; i++) {\n      ctx.fillStyle = slots[i] !== null ? GREEN : '#2a2a4a';\n      roundRect(ctx, sx + i * (cellSize + gap), sy, cellSize, cellSize, 8);\n      ctx.fill();\n      if (slots[i] !== null) {\n        ctx.fillStyle = WHITE;\n        ctx.font = `bold ${Math.min(cellSize * 0.6, 28)}px sans-serif`;\n        ctx.textAlign = 'center';\n        ctx.fillText(candidates[slots[i]], sx + i * (cellSize + gap) + cellSize / 2, sy + cellSize * 0.65);\n      }\n    }\n\n    // Candidates\n    const candY = H * 0.6;\n    for (let i = 0; i < candidates.length; i++) {\n      const col = i % 4;\n      const row = Math.floor(i / 4);\n      const cx = sx + col * (cellSize + gap);\n      const cy = candY + row * (cellSize + gap);\n      const used = slots.includes(i);\n      ctx.fillStyle = used ? '#333' : '#3a3a5e';\n      roundRect(ctx, cx, cy, cellSize, cellSize, 8);\n      ctx.fill();\n      ctx.fillStyle = used ? '#666' : WHITE;\n      ctx.font = `bold ${Math.min(cellSize * 0.55, 26)}px sans-serif`;\n      ctx.textAlign = 'center';\n      ctx.fillText(candidates[i], cx + cellSize / 2, cy + cellSize * 0.65);\n    }\n  }\n}\n\nfunction drawResult(W, H) {\n  ctx.fillStyle = BG;\n  ctx.fillRect(0, 0, W, H);\n  ctx.fillStyle = PRIMARY;\n  ctx.font = `bold ${Math.min(W * 0.07, 32)}px sans-serif`;\n  ctx.textAlign = 'center';\n  ctx.fillText('挑战结束', W / 2, H * 0.2);\n\n  ctx.fillStyle = WHITE;\n  ctx.font = `${Math.min(W * 0.045, 20)}px sans-serif`;\n  ctx.fillText(`得分: ${score}`, W / 2, H * 0.35);\n  ctx.fillText(`最大连击: ${maxCombo}`, W / 2, H * 0.42);\n  ctx.fillStyle = GOLD;\n  ctx.fillText(`🪙 +${Math.floor(score / 5)}`, W / 2, H * 0.52);\n\n  const btnW = W * 0.6, btnH = 50;\n  ctx.fillStyle = PRIMARY;\n  roundRect(ctx, (W - btnW) / 2, H * 0.7, btnW, btnH, 12);\n  ctx.fill();\n  ctx.fillStyle = WHITE;\n  ctx.font = `bold ${Math.min(W * 0.05, 22)}px sans-serif`;\n  ctx.fillText('返回', W / 2, H * 0.7 + 33);\n}\n\nfunction drawCollection(W, H) {\n  ctx.fillStyle = BG;\n  ctx.fillRect(0, 0, W, H);\n  ctx.fillStyle = WHITE;\n  ctx.font = `bold ${Math.min(W * 0.04, 16)}px sans-serif`;\n  ctx.textAlign = 'left';\n  ctx.fillText('← 返回', 15, 35);\n  ctx.textAlign = 'center';\n  ctx.fillText(`成语图鉴 (${IDIOMS.length})`, W / 2, 35);\n\n  const startY = 60;\n  ctx.font = `${Math.min(W * 0.035, 14)}px sans-serif`;\n  for (let i = 0; i < IDIOMS.length; i++) {\n    const y = startY + i * 28;\n    if (y > H - 20) break;\n    ctx.fillStyle = i % 2 === 0 ? '#1e1e3a' : BG;\n    ctx.fillRect(0, y - 15, W, 28);\n    ctx.fillStyle = WHITE;\n    ctx.textAlign = 'left';\n    ctx.fillText(`${i + 1}. ${IDIOMS[i].idiom}`, 15, y);\n    ctx.fillStyle = GRAY;\n    ctx.textAlign = 'right';\n    ctx.fillText(IDIOMS[i].meaning, W - 15, y);\n  }\n}\n\nfunction roundRect(ctx, x, y, w, h, r) {\n  ctx.beginPath();\n  ctx.moveTo(x + r, y);\n  ctx.lineTo(x + w - r, y);\n  ctx.arcTo(x + w, y, x + w, y + r, r);\n  ctx.lineTo(x + w, y + h - r);\n  ctx.arcTo(x + w, y + h, x + w - r, y + h, r);\n  ctx.lineTo(x + r, y + h);\n  ctx.arcTo(x, y + h, x, y + h - r, r);\n  ctx.lineTo(x, y + r);\n  ctx.arcTo(x, y, x + r, y, r);\n  ctx.closePath();\n}\n\n// Start\ndraw();\n","structuredPatch":[],"originalFile":null,"userModified":false}}
