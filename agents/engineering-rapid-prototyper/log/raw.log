{"type":"assistant","message":{"id":"msg_20260523225213c35238cba898434b","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_02eb765c5cb544109ddc23bd","name":"Write","input":{"file_path":"D:\\game-projects\\steam-ancient-mystery\\src\\game\\SceneManager.ts","content":"import { Renderer } from '../renderer/Renderer';\nimport { GameState } from './GameState';\nimport { InkRenderer } from '../utils/ink';\n\nexport interface SceneLayer {\n  id: string;\n  image?: HTMLCanvasElement;\n  color?: string;\n  alpha: number;\n  targetAlpha: number;\n  x: number;\n  y: number;\n}\n\nexport interface GameScene {\n  id: string;\n  background: string;\n  foreground?: string[];\n  ambientColor?: string;\n  lighting?: { x: number; y: number; radius: number; intensity: number };\n}\n\nexport class SceneManager {\n  private scenes: Map<string, GameScene> = new Map();\n  private currentScene: GameScene | null = null;\n  private layers: SceneLayer[] = [];\n  private transitioning = false;\n  private transitionProgress = 0;\n  private transitionDuration = 1.5;\n  private pendingScene: GameScene | null = null;\n  private ink: InkRenderer;\n\n  constructor(private renderer: Renderer, private state: GameState) {\n    this.ink = new InkRenderer(renderer);\n    this.registerDefaultScenes();\n  }\n\n  private registerDefaultScenes() {\n    const scenes: GameScene[] = [\n      { id: 'main_menu', background: '#0d0d0d', ambientColor: '#1a0a00' },\n      { id: 'county_office', background: '#1a1008', ambientColor: '#2a1a0a',\n        lighting: { x: 0.5, y: 0.3, radius: 0.4, intensity: 0.6 } },\n      { id: 'west_market', background: '#1a1508', ambientColor: '#2a200a',\n        lighting: { x: 0.5, y: 0.5, radius: 0.5, intensity: 0.7 } },\n      { id: 'east_market_ruins', background: '#0a0d10', ambientColor: '#0a1020',\n        lighting: { x: 0.5, y: 0.6, radius: 0.3, intensity: 0.3 } },\n      { id: 'daming_palace', background: '#100808', ambientColor: '#1a0a0a',\n        lighting: { x: 0.5, y: 0.2, radius: 0.4, intensity: 0.5 } },\n      { id: 'daciensi_temple', background: '#0d0a08', ambientColor: '#1a150a',\n        lighting: { x: 0.5, y: 0.4, radius: 0.4, intensity: 0.5 } },\n      { id: 'pingkang_ward', background: '#1a0a10', ambientColor: '#2a0a1a',\n        lighting: { x: 0.5, y: 0.5, radius: 0.5, intensity: 0.7 } },\n      { id: 'underground', background: '#050508', ambientColor: '#0a0a10',\n        lighting: { x: 0.5, y: 0.5, radius: 0.15, intensity: 0.2 } },\n      { id: 'judge_hall', background: '#08050a', ambientColor: '#100820',\n        lighting: { x: 0.5, y: 0.3, radius: 0.3, intensity: 0.4 } },\n    ];\n    scenes.forEach((s) => this.scenes.set(s.id, s));\n  }\n\n  registerScene(scene: GameScene) {\n    this.scenes.set(scene.id, scene);\n  }\n\n  switchTo(sceneId: string, transition = true) {\n    const scene = this.scenes.get(sceneId);\n    if (!scene) return;\n    this.state.scene = sceneId;\n    if (transition && this.currentScene) {\n      this.pendingScene = scene;\n      this.transitioning = true;\n      this.transitionProgress = 0;\n    } else {\n      this.currentScene = scene;\n      this.buildLayers();\n    }\n  }\n\n  private buildLayers() {\n    this.layers = [];\n    if (!this.currentScene) return;\n    this.layers.push({\n      id: 'bg', color: this.currentScene.background, alpha: 1, targetAlpha: 1,\n      x: 0, y: 0,\n    });\n    if (this.currentScene.foreground) {\n      this.currentScene.foreground.forEach((fg, i) => {\n        this.layers.push({\n          id: `fg_${i}`, color: fg, alpha: 1, targetAlpha: 1,\n          x: 0, y: 0,\n        });\n      });\n    }\n  }\n\n  update(dt: number) {\n    if (this.transitioning) {\n      this.transitionProgress += dt / this.transitionDuration;\n      if (this.transitionProgress >= 1) {\n        this.transitioning = false;\n        this.transitionProgress = 1;\n        if (this.pendingScene) {\n          this.currentScene = this.pendingScene;\n          this.pendingScene = null;\n          this.buildLayers();\n        }\n      }\n    }\n    this.layers.forEach((l) => {\n      if (l.alpha !== l.targetAlpha) {\n        const diff = l.targetAlpha - l.alpha;\n        l.alpha += Math.sign(diff) * Math.min(Math.abs(diff), dt * 3);\n      }\n    });\n    this.ink.update(dt);\n  }\n\n  render() {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    if (this.transitioning && this.pendingScene) {\n      const p = this.transitionProgress;\n      ctx.save();\n      ctx.globalAlpha = 1 - p;\n      this.renderScene(this.currentScene);\n      ctx.globalAlpha = p;\n      this.renderScene(this.pendingScene);\n      ctx.restore();\n      this.ink.renderTransition(p);\n    } else {\n      this.renderScene(this.currentScene);\n    }\n  }\n\n  private renderScene(scene: GameScene | null) {\n    if (!scene) return;\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.fillStyle = scene.background;\n    ctx.fillRect(0, 0, w, h);\n\n    if (scene.ambientColor) {\n      const grad = ctx.createRadialGradient(w / 2, h / 2, 0, w / 2, h / 2, w * 0.7);\n      grad.addColorStop(0, scene.ambientColor);\n      grad.addColorStop(1, 'transparent');\n      ctx.fillStyle = grad;\n      ctx.fillRect(0, 0, w, h);\n    }\n\n    if (scene.lighting) {\n      const lx = w * scene.lighting.x;\n      const ly = h * scene.lighting.y;\n      const lr = Math.max(w, h) * scene.lighting.radius;\n      const grad = ctx.createRadialGradient(lx, ly, 0, lx, ly, lr);\n      grad.addColorStop(0, `rgba(255, 200, 100, ${scene.lighting.intensity * 0.15})`);\n      grad.addColorStop(0.5, `rgba(255, 150, 50, ${scene.lighting.intensity * 0.05})`);\n      grad.addColorStop(1, 'transparent');\n      ctx.fillStyle = grad;\n      ctx.fillRect(0, 0, w, h);\n    }\n\n    this.layers.forEach((l) => {\n      if (l.image) {\n        this.renderer.drawImage(l.image, l.x, l.y, undefined, undefined, l.alpha);\n      } else if (l.color && l.id !== 'bg') {\n        ctx.save();\n        ctx.globalAlpha = l.alpha;\n        ctx.fillStyle = l.color;\n        ctx.fillRect(l.x, l.y, w, h);\n        ctx.restore();\n      }\n    });\n  }\n\n  getCurrentScene(): GameScene | null { return this.currentScene; }\n  isTransitioning(): boolean { return this.transitioning; }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"f441f9ea-17f7-4616-a9e1-d3dddf54df7a","uuid":"d83df676-34a3-49ea-aca6-b6b80339c87a"}
