{"type":"assistant","message":{"id":"msg_20260523194310cc7496fb075140ef","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_0b11cabb7dd9449b8a4a03d8","name":"Write","input":{"file_path":"D:\\games\\match3-xiaoxiaoxiao\\js\\board.js","content":"/**\n * Board state management - grid, matching, gravity, refill.\n */\n\nconst config = require('./config');\nconst { randomInt } = require('./utils');\n\nclass Board {\n  constructor() {\n    this.grid = [];\n    this.animating = false;\n    this.animations = [];\n    this.init();\n  }\n\n  init() {\n    this.grid = [];\n    for (let r = 0; r < config.GRID_SIZE; r++) {\n      this.grid[r] = [];\n      for (let c = 0; c < config.GRID_SIZE; c++) {\n        this.grid[r][c] = this._randomPiece(r, c);\n      }\n    }\n    // Clear any initial matches\n    while (this._findMatches().length > 0) {\n      for (let r = 0; r < config.GRID_SIZE; r++) {\n        for (let c = 0; c < config.GRID_SIZE; c++) {\n          this.grid[r][c] = this._randomPiece(r, c);\n        }\n      }\n    }\n    this.animations = [];\n    this.animating = false;\n  }\n\n  _randomPiece(r, c) {\n    // Avoid creating matches during generation\n    const forbidden = new Set();\n    if (c >= 2 && this.grid[r][c - 1] === this.grid[r][c - 2]) {\n      forbidden.add(this.grid[r][c - 1]);\n    }\n    if (r >= 2 && this.grid[r - 1] && this.grid[r - 2] &&\n        this.grid[r - 1][c] === this.grid[r - 2][c]) {\n      forbidden.add(this.grid[r - 1][c]);\n    }\n    let type;\n    do {\n      type = randomInt(0, config.PIECE_TYPES - 1);\n    } while (forbidden.has(type));\n    return type;\n  }\n\n  getPiece(r, c) {\n    if (r < 0 || r >= config.GRID_SIZE || c < 0 || c >= config.GRID_SIZE) return -1;\n    return this.grid[r][c];\n  }\n\n  isAdjacent(r1, c1, r2, c2) {\n    return (Math.abs(r1 - r2) + Math.abs(c1 - c2)) === 1;\n  }\n\n  swap(r1, c1, r2, c2) {\n    const tmp = this.grid[r1][c1];\n    this.grid[r1][c1] = this.grid[r2][c2];\n    this.grid[r2][c2] = tmp;\n  }\n\n  _findMatches() {\n    const matches = new Set();\n\n    // Horizontal matches\n    for (let r = 0; r < config.GRID_SIZE; r++) {\n      for (let c = 0; c <= config.GRID_SIZE - 3; c++) {\n        const t = this.grid[r][c];\n        if (t < 0) continue;\n        if (this.grid[r][c + 1] === t && this.grid[r][c + 2] === t) {\n          let end = c + 2;\n          while (end + 1 < config.GRID_SIZE && this.grid[r][end + 1] === t) end++;\n          for (let i = c; i <= end; i++) matches.add(r * config.GRID_SIZE + i);\n        }\n      }\n    }\n\n    // Vertical matches\n    for (let c = 0; c < config.GRID_SIZE; c++) {\n      for (let r = 0; r <= config.GRID_SIZE - 3; r++) {\n        const t = this.grid[r][c];\n        if (t < 0) continue;\n        if (this.grid[r + 1][c] === t && this.grid[r + 2][c] === t) {\n          let end = r + 2;\n          while (end + 1 < config.GRID_SIZE && this.grid[end + 1][c] === t) end++;\n          for (let i = r; i <= end; i++) matches.add(i * config.GRID_SIZE + c);\n        }\n      }\n    }\n\n    return Array.from(matches).map(idx => ({\n      r: Math.floor(idx / config.GRID_SIZE),\n      c: idx % config.GRID_SIZE,\n    }));\n  }\n\n  findMatches() {\n    return this._findMatches();\n  }\n\n  removeMatches(matches) {\n    const removed = [];\n    for (const { r, c } of matches) {\n      removed.push({ r, c, type: this.grid[r][c] });\n      this.grid[r][c] = -1;\n    }\n    return removed;\n  }\n\n  applyGravity() {\n    const moves = [];\n    for (let c = 0; c < config.GRID_SIZE; c++) {\n      let writeRow = config.GRID_SIZE - 1;\n      for (let r = config.GRID_SIZE - 1; r >= 0; r--) {\n        if (this.grid[r][c] >= 0) {\n          if (writeRow !== r) {\n            moves.push({ fromR: r, fromC: c, toR: writeRow, toC: c });\n            this.grid[writeRow][c] = this.grid[r][c];\n            this.grid[r][c] = -1;\n          }\n          writeRow--;\n        }\n      }\n    }\n    return moves;\n  }\n\n  refill() {\n    const spawns = [];\n    for (let c = 0; c < config.GRID_SIZE; c++) {\n      let emptyCount = 0;\n      for (let r = 0; r < config.GRID_SIZE; r++) {\n        if (this.grid[r][c] < 0) emptyCount++;\n      }\n      for (let r = emptyCount - 1; r >= 0; r--) {\n        this.grid[r][c] = randomInt(0, config.PIECE_TYPES - 1);\n        spawns.push({ r, c, fromR: r - emptyCount });\n      }\n    }\n    return spawns;\n  }\n\n  hasValidMoves() {\n    for (let r = 0; r < config.GRID_SIZE; r++) {\n      for (let c = 0; c < config.GRID_SIZE; c++) {\n        // Try swap right\n        if (c + 1 < config.GRID_SIZE) {\n          this.swap(r, c, r, c + 1);\n          if (this._findMatches().length > 0) {\n            this.swap(r, c, r, c + 1);\n            return true;\n          }\n          this.swap(r, c, r, c + 1);\n        }\n        // Try swap down\n        if (r + 1 < config.GRID_SIZE) {\n          this.swap(r, c, r + 1, c);\n          if (this._findMatches().length > 0) {\n            this.swap(r, c, r + 1, c);\n            return true;\n          }\n          this.swap(r, c, r + 1, c);\n        }\n      }\n    }\n    return false;\n  }\n\n  shuffle() {\n    const pieces = [];\n    for (let r = 0; r < config.GRID_SIZE; r++) {\n      for (let c = 0; c < config.GRID_SIZE; c++) {\n        pieces.push(this.grid[r][c]);\n      }\n    }\n    for (let i = pieces.length - 1; i > 0; i--) {\n      const j = randomInt(0, i);\n      [pieces[i], pieces[j]] = [pieces[j], pieces[i]];\n    }\n    let idx = 0;\n    for (let r = 0; r < config.GRID_SIZE; r++) {\n      for (let c = 0; c < config.GRID_SIZE; c++) {\n        this.grid[r][c] = pieces[idx++];\n      }\n    }\n    // Clear accidental matches\n    while (this._findMatches().length > 0) {\n      const matches = this._findMatches();\n      for (const { r, c } of matches) {\n        this.grid[r][c] = randomInt(0, config.PIECE_TYPES - 1);\n      }\n    }\n    if (!this.hasValidMoves()) this.shuffle();\n  }\n}\n\nmodule.exports = Board;\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"5216bcb9-0926-4213-a537-65887a7ae3c9","uuid":"be2080a3-cd8e-4565-9402-e4f93d8564a1"}
{"type":"assistant","message":{"id":"msg_20260523194310cc7496fb075140ef","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_d355b6edebde4b73827eb1ef","name":"Write","input":{"file_path":"D:\\games\\match3-xiaoxiaoxiao\\js\\animation.js","content":"/**\n * Tween-based animation system.\n */\n\nclass Animation {\n  constructor(duration, updateFn, completeFn) {\n    this.duration = duration;\n    this.updateFn = updateFn;\n    this.completeFn = completeFn;\n    this.elapsed = 0;\n    this.done = false;\n  }\n\n  update(dt) {\n    if (this.done) return;\n    this.elapsed += dt;\n    const t = Math.min(this.elapsed / this.duration, 1);\n    this.updateFn(t);\n    if (t >= 1) {\n      this.done = true;\n      if (this.completeFn) this.completeFn();\n    }\n  }\n}\n\nclass AnimationManager {\n  constructor() {\n    this.anims = [];\n  }\n\n  add(duration, updateFn, completeFn) {\n    const anim = new Animation(duration, updateFn, completeFn);\n    this.anims.push(anim);\n    return anim;\n  }\n\n  update(dt) {\n    for (let i = this.anims.length - 1; i >= 0; i--) {\n      this.anims[i].update(dt);\n      if (this.anims[i].done) this.anims.splice(i, 1);\n    }\n  }\n\n  get busy() {\n    return this.anims.length > 0;\n  }\n\n  clear() {\n    this.anims = [];\n  }\n}\n\nmodule.exports = AnimationManager;\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"5216bcb9-0926-4213-a537-65887a7ae3c9","uuid":"8be2fd9d-7616-4dfe-a4fc-febd01e0c9dd"}
