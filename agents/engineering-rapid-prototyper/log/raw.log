{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_152f675d63f54834b6e8810a","type":"tool_result","content":"1\t/**\n2\t * 消消消大作战 - Match-3 Game for Douyin Mini-Game Platform\n3\t * Entry point and game state machine.\n4\t */\n5\t\n6\tconst adapter = require('./adapter/index');\n7\tconst config = require('./js/config');\n8\tconst { easeOutQuad, easeOutBounce } = require('./js/utils');\n9\tconst Board = require('./js/board');\n10\tconst Renderer = require('./js/renderer');\n11\tconst InputHandler = require('./js/input');\n12\tconst AnimationManager = require('./js/animation');\n13\tconst ScoreManager = require('./js/score-manager');\n14\t\n15\t// --- Layout calculation ---\n16\tfunction calcLayout(screenW, screenH) {\n17\t  const topBarH = config.TOP_BAR_HEIGHT;\n18\t  const bottomBarH = config.BOTTOM_BAR_HEIGHT;\n19\t  const availH = screenH - topBarH - bottomBarH;\n20\t  const availW = screenW - 32; // 16px margin each side\n21\t\n22\t  const cellGap = config.CELL_GAP;\n23\t  const maxCellW = (availW - cellGap * (config.GRID_SIZE - 1)) / config.GRID_SIZE;\n24\t  const maxCellH = (availH - cellGap * (config.GRID_SIZE - 1) - 20) / config.GRID_SIZE;\n25\t  const cellSize = Math.floor(Math.min(maxCellW, maxCellH));\n26\t\n27\t  const boardW = cellSize * config.GRID_SIZE + cellGap * (config.GRID_SIZE - 1);\n28\t  const boardH = boardW;\n29\t  const boardX = (screenW - boardW) / 2;\n30\t  const boardY = topBarH + (availH - boardH) / 2;\n31\t\n32\t  return {\n33\t    x: boardX,\n34\t    y: boardY,\n35\t    width: boardW,\n36\t    height: boardH,\n37\t    cellSize,\n38\t    topBarHeight: topBarH,\n39\t    bottomBarHeight: bottomBarH,\n40\t  };\n41\t}\n42\t\n43\t// --- Game ---\n44\tclass Game {\n45\t  constructor() {\n46\t    const sysInfo = adapter.getSystemInfo();\n47\t    const dpr = sysInfo.pixelRatio || 1;\n48\t    const screenW = sysInfo.windowWidth;\n49\t    const screenH = sysInfo.windowHeight;\n50\t\n51\t    this.canvas = adapter.createCanvas();\n52\t    this.canvas.width = screenW * dpr;\n53\t    this.canvas.height = screenH * dpr;\n54\t    const ctx = this.canvas.getContext('2d');\n55\t    ctx.scale(dpr, dpr);\n56\t    this.screenW = screenW;\n57\t    this.screenH = screenH;\n58\t\n59\t    this.layout = calcLayout(screenW, screenH);\n60\t    this.board = new Board();\n61\t    this.renderer = new Renderer(this.canvas, this.layout);\n62\t    this.input = new InputHandler(this.layout);\n63\t    this.anim = new AnimationManager();\n64\t    this.score = new ScoreManager();\n65\t    this.state = 'idle'; // idle, swapping, removing, falling, gameover, levelcomplete\n66\t\n67\t    this._bindEvents();\n68\t    this._lastTime = Date.now();\n69\t    this._loop();\n70\t  }\n71\t\n72\t  _bindEvents() {\n73\t    const dpr = (adapter.getSystemInfo().pixelRatio || 1);\n74\t\n75\t    adapter.onTouchStart((e) => {\n76\t      const touch = e.touches ? e.touches[0] : e;\n77\t      const x = touch.clientX || touch.pageX;\n78\t      const y = touch.clientY || touch.pageY;\n79\t      if (this.state === 'gameover' || this.state === 'levelcomplete') {\n80\t        this.input.handleClick(x, y);\n81\t        return;\n82\t      }\n83\t      if (this.state !== 'idle') return;\n84\t      this.input.handleTouchStart(x, y);\n85\t    });\n86\t\n87\t    adapter.onTouchMove((e) => {\n88\t      const touch = e.touches ? e.touches[0] : e;\n89\t      const x = touch.clientX || touch.pageX;\n90\t      const y = touch.clientY || touch.pageY;\n91\t      if (this.state !== 'idle') return;\n92\t      this.input.handleTouchMove(x, y);\n93\t    });\n94\t\n95\t    adapter.onTouchEnd(() => {\n96\t      this.input.handleTouchEnd();\n97\t    });\n98\t\n99\t    // Connect input callbacks\n100\t    this.input.onSelect = (cell) => {\n101\t      this.renderer.selectedCell = cell;\n102\t      if (cell) adapter.vibrateShort();\n103\t    };\n104\t\n105\t    this.input.onSwap = (r1, c1, r2, c2) => {\n106\t      this._trySwap(r1, c1, r2, c2);\n107\t    };\n108\t\n109\t    this.input.onBtnClick = (x, y) => {\n110\t      if (this.state === 'gameover') {\n111\t        const btn = this.renderer.retryBtn;\n112\t        if (btn && x >= btn.x && x <= btn.x + btn.w && y >= btn.y && y <= btn.y + btn.h) {\n113\t          this._restart();\n114\t        }\n115\t      }\n116\t      if (this.state === 'levelcomplete') {\n117\t        const btn = this.renderer.nextBtn;\n118\t        if (btn && x >= btn.x && x <= btn.x + btn.w && y >= btn.y && y <= btn.y + btn.h) {\n119\t          this._nextLevel();\n120\t        }\n121\t      }\n122\t      // Bottom bar restart\n123\t      const rbtn = this.renderer.restartBtn;\n124\t      if (rbtn && x >= rbtn.x && x <= rbtn.x + rbtn.w && y >= rbtn.y && y <= rbtn.y + rbtn.h) {\n125\t        this._restart();\n126\t      }\n127\t    };\n128\t  }\n129\t\n130\t  _trySwap(r1, c1, r2, c2) {\n131\t    adapter.vibrateShort();\n132\t    this.state = 'swapping';\n133\t    const { cellSize } = this.layout;\n134\t\n135\t    // Animate swap\n136\t    const dx = (c2 - c1) * (cellSize + config.CELL_GAP);\n137\t    const dy = (r2 - r1) * (cellSize + config.CELL_GAP);\n138\t\n139\t    this.anim.add(150, (t) => {\n140\t      const e = easeOutQuad(t);\n141\t      this.renderer.setPieceOffset(r1, c1, dx * e, dy * e);\n142\t      this.renderer.setPieceOffset(r2, c2, -dx * e, -dy * e);\n143\t    }, () => {\n144\t      this.renderer.clearPieceOffset(r1, c1);\n145\t      this.renderer.clearPieceOffset(r2, c2);\n146\t      this.board.swap(r1, c1, r2, c2);\n147\t\n148\t      const matches = this.board.findMatches();\n149\t      if (matches.length === 0) {\n150\t        // Swap back\n151\t        this.anim.add(150, (t) => {\n152\t          const e = easeOutQuad(t);\n153\t          this.renderer.setPieceOffset(r1, c1, -dx * e, -dy * e);\n154\t          this.renderer.setPieceOffset(r2, c2, dx * e, dy * e);\n155\t        }, () => {\n156\t          this.renderer.clearPieceOffset(r1, c1);\n157\t          this.renderer.clearPieceOffset(r2, c2);\n158\t          this.board.swap(r1, c1, r2, c2);\n159\t          this.state = 'idle';\n160\t        });\n161\t      } else {\n162\t        this.score.useMove();\n163\t        this.score.startCombo();\n164\t        this._processMatches();\n165\t      }\n166\t    });\n167\t  }\n168\t\n169\t  _processMatches() {\n170\t    const matches = this.board.findMatches();\n171\t    if (matches.length === 0) {\n172\t      // Check for more moves\n173\t      if (!this.board.hasValidMoves()) {\n174\t        this.board.shuffle();\n175\t      }\n176\t      if (this.score.isLevelComplete()) {\n177\t        this.state = 'levelcomplete';\n178\t        this.score.saveBest();\n179\t      } else if (this.score.isGameOver()) {\n180\t        this.state = 'gameover';\n181\t        this.score.saveBest();\n182\t      } else {\n183\t        this.state = 'idle';\n184\t      }\n185\t      return;\n186\t    }\n187\t\n188\t    const combo = this.score.incrementCombo();\n189\t    this.renderer.setComboText(combo);\n190\t    this.renderer.screenShake = 1.5;\n191\t\n192\t    // Calculate match lengths for scoring\n193\t    const matchGroups = this._groupMatches(matches);\n194\t    let totalScore = 0;\n195\t    for (const group of matchGroups) {\n196\t      const pts = this.score.addScore(group.length);\n197\t      totalScore += pts;\n198\t      // Show score popup at center of match group\n199\t      const avgR = group.reduce((s, m) => s + m.r, 0) / group.length;\n200\t      const avgC = group.reduce((s, m) => s + m.c, 0) / group.length;\n201\t      this.renderer.addScorePopup(avgR, avgC, pts);\n202\t    }\n203\t\n204\t    // Animate removal\n205\t    this.state = 'removing';\n206\t    const toRemove = this.board.removeMatches(matches);\n207\t\n208\t    for (const { r, c, type } of toRemove) {\n209\t      this.renderer.addParticles(r, c, type);\n210\t    }\n211\t\n212\t    this.anim.add(200, (t) => {\n213\t      for (const { r, c } of toRemove) {\n214\t        this.renderer.setPieceScale(r, c, 1 - easeOutQuad(t));\n215\t      }\n216\t    }, () => {\n217\t      for (const { r, c } of toRemove) {\n218\t        this.renderer.clearPieceScale(r, c);\n219\t      }\n220\t      this._applyGravity();\n221\t    });\n222\t  }\n223\t\n224\t  _groupMatches(matches) {\n225\t    // Simple: treat all matches in one pass as a single group per connected component\n226\t    const set = new Set(matches.map(m => m.r + ',' + m.c));\n227\t    const visited = new Set();\n228\t    const groups = [];\n229\t\n230\t    for (const m of matches) {\n231\t      const key = m.r + ',' + m.c;\n232\t      if (visited.has(key)) continue;\n233\t      const group = [];\n234\t      const queue = [m];\n235\t      while (queue.length > 0) {\n236\t        const cur = queue.pop();\n237\t        const ck = cur.r + ',' + cur.c;\n238\t        if (visited.has(ck)) continue;\n239\t        visited.add(ck);\n240\t        group.push(cur);\n241\t        for (const [dr, dc] of [[0,1],[0,-1],[1,0],[-1,0]]) {\n242\t          const nk = (cur.r + dr) + ',' + (cur.c + dc);\n243\t          if (set.has(nk) && !visited.has(nk)) {\n244\t            queue.push({ r: cur.r + dr, c: cur.c + dc });\n245\t          }\n246\t        }\n247\t      }\n248\t      groups.push(group);\n249\t    }\n250\t    return groups;\n251\t  }\n252\t\n253\t  _applyGravity() {\n254\t    this.state = 'falling';\n255\t    const moves = this.board.applyGravity();\n256\t    const spawns = this.board.refill();\n257\t    const { cellSize } = this.layout;\n258\t    const allMoves = [...moves];\n259\t\n260\t    if (allMoves.length === 0 && spawns.length === 0) {\n261\t      this._processMatches();\n262\t      return;\n263\t    }\n264\t\n265\t    // Combine gravity moves and spawns\n266\t    const allAnims = [];\n267\t    for (const m of moves) {\n268\t      allAnims.push({\n269\t        r: m.toR, c: m.toC,\n270\t        fromDy: (m.fromR - m.toR) * (cellSize + config.CELL_GAP),\n271\t      });\n272\t    }\n273\t    for (const s of spawns) {\n274\t      allAnims.push({\n275\t        r: s.r, c: s.c,\n276\t        fromDy: (s.fromR - s.r) * (cellSize + config.CELL_GAP),\n277\t      });\n278\t    }\n279\t\n280\t    this.anim.add(300, (t) => {\n281\t      const e = easeOutBounce(t);\n282\t      for (const a of allAnims) {\n283\t        this.renderer.setPieceOffset(a.r, a.c, 0, a.fromDy * (1 - e));\n284\t      }\n285\t    }, () => {\n286\t      for (const a of allAnims) {\n287\t        this.renderer.clearPieceOffset(a.r, a.c);\n288\t      }\n289\t      this._processMatches();\n290\t    });\n291\t  }\n292\t\n293\t  _restart() {\n294\t    this.board.init();\n295\t    this.score.reset();\n296\t    this.anim.clear();\n297\t    this.renderer.particles = [];\n298\t    this.renderer.scorePopups = [];\n299\t    this.renderer.comboText = null;\n300\t    this.renderer.screenShake = 0;\n301\t    this.renderer.pieceOffset = {};\n302\t    this.renderer.pieceScale = {};\n303\t    this.input.reset();\n304\t    this.state = 'idle';\n305\t  }\n306\t\n307\t  _nextLevel() {\n308\t    this.score.nextLevel();\n309\t    this.board.init();\n310\t    this.anim.clear();\n311\t    this.renderer.particles = [];\n312\t    this.renderer.scorePopups = [];\n313\t    this.renderer.comboText = null;\n314\t    this.renderer.screenShake = 0;\n315\t    this.renderer.pieceOffset = {};\n316\t    this.renderer.pieceScale = {};\n317\t    this.input.reset();\n318\t    this.state = 'idle';\n319\t  }\n320\t\n321\t  _loop() {\n322\t    const now = Date.now();\n323\t    const dt = Math.min((now - this._lastTime) / 1000, 0.1);\n324\t    this._lastTime = now;\n325\t\n326\t    this.anim.update(dt * 1000);\n327\t    this.renderer.updateEffects(dt);\n328\t\n329\t    // Draw\n330\t    const r = this.renderer;\n331\t    r.clear();\n332\t    r.drawBackground();\n333\t    r.drawTopBar(this.score.score, this.score.level, this.score.movesLeft, this.score.targetScore);\n334\t    r.drawBoard();\n335\t    r.drawPieces(this.board);\n336\t    r.drawEffects();\n337\t    r.drawBottomBar(() => this._restart());\n338\t\n339\t    if (this.state === 'gameover') {\n340\t      r.drawGameOver(this.score.score, this.score.level, this.score.bestScore);\n341\t    }\n342\t    if (this.state === 'levelcomplete') {\n343\t      r.drawLevelComplete(this.score.score, this.score.level, this.score.bestScore);\n344\t    }\n345\t\n346\t    requestAnimationFrame(() => this._loop());\n347\t  }\n348\t}\n349\t\n350\t// --- Bootstrap ---\n351\tnew Game();\n352\t"}]},"parent_tool_use_id":null,"session_id":"33adb7f4-913e-4960-83b6-3354bfda46a0","uuid":"63cb9719-4924-4342-a42c-4bae93c2fb67","timestamp":"2026-05-23T15:10:34.623Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\games\\match3-xiaoxiaoxiao\\game.js","content":"/**\n * 消消消大作战 - Match-3 Game for Douyin Mini-Game Platform\n * Entry point and game state machine.\n */\n\nconst adapter = require('./adapter/index');\nconst config = require('./js/config');\nconst { easeOutQuad, easeOutBounce } = require('./js/utils');\nconst Board = require('./js/board');\nconst Renderer = require('./js/renderer');\nconst InputHandler = require('./js/input');\nconst AnimationManager = require('./js/animation');\nconst ScoreManager = require('./js/score-manager');\n\n// --- Layout calculation ---\nfunction calcLayout(screenW, screenH) {\n  const topBarH = config.TOP_BAR_HEIGHT;\n  const bottomBarH = config.BOTTOM_BAR_HEIGHT;\n  const availH = screenH - topBarH - bottomBarH;\n  const availW = screenW - 32; // 16px margin each side\n\n  const cellGap = config.CELL_GAP;\n  const maxCellW = (availW - cellGap * (config.GRID_SIZE - 1)) / config.GRID_SIZE;\n  const maxCellH = (availH - cellGap * (config.GRID_SIZE - 1) - 20) / config.GRID_SIZE;\n  const cellSize = Math.floor(Math.min(maxCellW, maxCellH));\n\n  const boardW = cellSize * config.GRID_SIZE + cellGap * (config.GRID_SIZE - 1);\n  const boardH = boardW;\n  const boardX = (screenW - boardW) / 2;\n  const boardY = topBarH + (availH - boardH) / 2;\n\n  return {\n    x: boardX,\n    y: boardY,\n    width: boardW,\n    height: boardH,\n    cellSize,\n    topBarHeight: topBarH,\n    bottomBarHeight: bottomBarH,\n  };\n}\n\n// --- Game ---\nclass Game {\n  constructor() {\n    const sysInfo = adapter.getSystemInfo();\n    const dpr = sysInfo.pixelRatio || 1;\n    const screenW = sysInfo.windowWidth;\n    const screenH = sysInfo.windowHeight;\n\n    this.canvas = adapter.createCanvas();\n    this.canvas.width = screenW * dpr;\n    this.canvas.height = screenH * dpr;\n    const ctx = this.canvas.getContext('2d');\n    ctx.scale(dpr, dpr);\n    this.screenW = screenW;\n    this.screenH = screenH;\n\n    this.layout = calcLayout(screenW, screenH);\n    this.board = new Board();\n    this.renderer = new Renderer(this.canvas, this.layout);\n    this.input = new InputHandler(this.layout);\n    this.anim = new AnimationManager();\n    this.score = new ScoreManager();\n    this.state = 'idle'; // idle, swapping, removing, falling, gameover, levelcomplete\n\n    this._bindEvents();\n    this._lastTime = Date.now();\n    this._loop();\n  }\n\n  _bindEvents() {\n    const dpr = (adapter.getSystemInfo().pixelRatio || 1);\n\n    adapter.onTouchStart((e) => {\n      const touch = e.touches ? e.touches[0] : e;\n      const x = touch.clientX || touch.pageX;\n      const y = touch.clientY || touch.pageY;\n      if (this.state === 'gameover' || this.state === 'levelcomplete') {\n        this.input.handleClick(x, y);\n        return;\n      }\n      if (this.state !== 'idle') return;\n      this.input.handleTouchStart(x, y);\n    });\n\n    adapter.onTouchMove((e) => {\n      const touch = e.touches ? e.touches[0] : e;\n      const x = touch.clientX || touch.pageX;\n      const y = touch.clientY || touch.pageY;\n      if (this.state !== 'idle') return;\n      this.input.handleTouchMove(x, y);\n    });\n\n    adapter.onTouchEnd(() => {\n      this.input.handleTouchEnd();\n    });\n\n    // Connect input callbacks\n    this.input.onSelect = (cell) => {\n      this.renderer.selectedCell = cell;\n      if (cell) adapter.vibrateShort();\n    };\n\n    this.input.onSwap = (r1, c1, r2, c2) => {\n      this._trySwap(r1, c1, r2, c2);\n    };\n\n    this.input.onBtnClick = (x, y) => {\n      if (this.state === 'gameover') {\n        const btn = this.renderer.retryBtn;\n        if (btn && x >= btn.x && x <= btn.x + btn.w && y >= btn.y && y <= btn.y + btn.h) {\n          this._restart();\n        }\n      }\n      if (this.state === 'levelcomplete') {\n        const btn = this.renderer.nextBtn;\n        if (btn && x >= btn.x && x <= btn.x + btn.w && y >= btn.y && y <= btn.y + btn.h) {\n          this._nextLevel();\n        }\n      }\n      // Bottom bar restart\n      const rbtn = this.renderer.restartBtn;\n      if (rbtn && x >= rbtn.x && x <= rbtn.x + rbtn.w && y >= rbtn.y && y <= rbtn.y + rbtn.h) {\n        this._restart();\n      }\n    };\n  }\n\n  _trySwap(r1, c1, r2, c2) {\n    adapter.vibrateShort();\n    this.state = 'swapping';\n    const { cellSize } = this.layout;\n\n    // Animate swap\n    const dx = (c2 - c1) * (cellSize + config.CELL_GAP);\n    const dy = (r2 - r1) * (cellSize + config.CELL_GAP);\n\n    this.anim.add(150, (t) => {\n      const e = easeOutQuad(t);\n      this.renderer.setPieceOffset(r1, c1, dx * e, dy * e);\n      this.renderer.setPieceOffset(r2, c2, -dx * e, -dy * e);\n    }, () => {\n      this.renderer.clearPieceOffset(r1, c1);\n      this.renderer.clearPieceOffset(r2, c2);\n      this.board.swap(r1, c1, r2, c2);\n\n      const matches = this.board.findMatches();\n      if (matches.length === 0) {\n        // Swap back\n        this.anim.add(150, (t) => {\n          const e = easeOutQuad(t);\n          this.renderer.setPieceOffset(r1, c1, -dx * e, -dy * e);\n          this.renderer.setPieceOffset(r2, c2, dx * e, dy * e);\n        }, () => {\n          this.renderer.clearPieceOffset(r1, c1);\n          this.renderer.clearPieceOffset(r2, c2);\n          this.board.swap(r1, c1, r2, c2);\n          this.state = 'idle';\n        });\n      } else {\n        this.score.useMove();\n        this.score.startCombo();\n        this._processMatches();\n      }\n    });\n  }\n\n  _processMatches() {\n    const matches = this.board.findMatches();\n    if (matches.length === 0) {\n      // Check for more moves\n      if (!this.board.hasValidMoves()) {\n        this.board.shuffle();\n      }\n      if (this.score.isLevelComplete()) {\n        this.state = 'levelcomplete';\n        this.score.saveBest();\n      } else if (this.score.isGameOver()) {\n        this.state = 'gameover';\n        this.score.saveBest();\n      } else {\n        this.state = 'idle';\n      }\n      return;\n    }\n\n    const combo = this.score.incrementCombo();\n    this.renderer.setComboText(combo);\n    this.renderer.screenShake = 1.5;\n\n    // Calculate match lengths for scoring\n    const matchGroups = this._groupMatches(matches);\n    let totalScore = 0;\n    for (const group of matchGroups) {\n      const pts = this.score.addScore(group.length);\n      totalScore += pts;\n      // Show score popup at center of match group\n      const avgR = group.reduce((s, m) => s + m.r, 0) / group.length;\n      const avgC = group.reduce((s, m) => s + m.c, 0) / group.length;\n      this.renderer.addScorePopup(avgR, avgC, pts);\n    }\n\n    // Animate removal\n    this.state = 'removing';\n    const toRemove = this.board.removeMatches(matches);\n\n    for (const { r, c, type } of toRemove) {\n      this.renderer.addParticles(r, c, type);\n    }\n\n    this.anim.add(200, (t) => {\n      for (const { r, c } of toRemove) {\n        this.renderer.setPieceScale(r, c, 1 - easeOutQuad(t));\n      }\n    }, () => {\n      for (const { r, c } of toRemove) {\n        this.renderer.clearPieceScale(r, c);\n      }\n      this._applyGravity();\n    });\n  }\n\n  _groupMatches(matches) {\n    // Simple: treat all matches in one pass as a single group per connected component\n    const set = new Set(matches.map(m => m.r + ',' + m.c));\n    const visited = new Set();\n    const groups = [];\n\n    for (const m of matches) {\n      const key = m.r + ',' + m.c;\n      if (visited.has(key)) continue;\n      const group = [];\n      const queue = [m];\n      while (queue.length > 0) {\n        const cur = queue.pop();\n        const ck = cur.r + ',' + cur.c;\n        if (visited.has(ck)) continue;\n        visited.add(ck);\n        group.push(cur);\n        for (const [dr, dc] of [[0,1],[0,-1],[1,0],[-1,0]]) {\n          const nk = (cur.r + dr) + ',' + (cur.c + dc);\n          if (set.has(nk) && !visited.has(nk)) {\n            queue.push({ r: cur.r + dr, c: cur.c + dc });\n          }\n        }\n      }\n      groups.push(group);\n    }\n    return groups;\n  }\n\n  _applyGravity() {\n    this.state = 'falling';\n    const moves = this.board.applyGravity();\n    const spawns = this.board.refill();\n    const { cellSize } = this.layout;\n    const allMoves = [...moves];\n\n    if (allMoves.length === 0 && spawns.length === 0) {\n      this._processMatches();\n      return;\n    }\n\n    // Combine gravity moves and spawns\n    const allAnims = [];\n    for (const m of moves) {\n      allAnims.push({\n        r: m.toR, c: m.toC,\n        fromDy: (m.fromR - m.toR) * (cellSize + config.CELL_GAP),\n      });\n    }\n    for (const s of spawns) {\n      allAnims.push({\n        r: s.r, c: s.c,\n        fromDy: (s.fromR - s.r) * (cellSize + config.CELL_GAP),\n      });\n    }\n\n    this.anim.add(300, (t) => {\n      const e = easeOutBounce(t);\n      for (const a of allAnims) {\n        this.renderer.setPieceOffset(a.r, a.c, 0, a.fromDy * (1 - e));\n      }\n    }, () => {\n      for (const a of allAnims) {\n        this.renderer.clearPieceOffset(a.r, a.c);\n      }\n      this._processMatches();\n    });\n  }\n\n  _restart() {\n    this.board.init();\n    this.score.reset();\n    this.anim.clear();\n    this.renderer.particles = [];\n    this.renderer.scorePopups = [];\n    this.renderer.comboText = null;\n    this.renderer.screenShake = 0;\n    this.renderer.pieceOffset = {};\n    this.renderer.pieceScale = {};\n    this.input.reset();\n    this.state = 'idle';\n  }\n\n  _nextLevel() {\n    this.score.nextLevel();\n    this.board.init();\n    this.anim.clear();\n    this.renderer.particles = [];\n    this.renderer.scorePopups = [];\n    this.renderer.comboText = null;\n    this.renderer.screenShake = 0;\n    this.renderer.pieceOffset = {};\n    this.renderer.pieceScale = {};\n    this.input.reset();\n    this.state = 'idle';\n  }\n\n  _loop() {\n    const now = Date.now();\n    const dt = Math.min((now - this._lastTime) / 1000, 0.1);\n    this._lastTime = now;\n\n    this.anim.update(dt * 1000);\n    this.renderer.updateEffects(dt);\n\n    // Draw\n    const r = this.renderer;\n    r.clear();\n    r.drawBackground();\n    r.drawTopBar(this.score.score, this.score.level, this.score.movesLeft, this.score.targetScore);\n    r.drawBoard();\n    r.drawPieces(this.board);\n    r.drawEffects();\n    r.drawBottomBar(() => this._restart());\n\n    if (this.state === 'gameover') {\n      r.drawGameOver(this.score.score, this.score.level, this.score.bestScore);\n    }\n    if (this.state === 'levelcomplete') {\n      r.drawLevelComplete(this.score.score, this.score.level, this.score.bestScore);\n    }\n\n    requestAnimationFrame(() => this._loop());\n  }\n}\n\n// --- Bootstrap ---\nnew Game();\n","numLines":352,"startLine":1,"totalLines":352}}}
