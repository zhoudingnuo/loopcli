{"type":"assistant","message":{"id":"msg_20260524025810129b913aba4d4d24","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_1b8d394b7100400d81c45530","name":"Write","input":{"file_path":"D:\\game-projects\\steam-ancient-mystery\\src\\game\\EndingSystem.ts","content":"import { GameState } from './GameState';\nimport { Renderer } from '../renderer/Renderer';\nimport { InputManager } from './InputManager';\n\nexport type EndingId = 'justice' | 'compromise' | 'succession' | 'departure' | 'hidden_truth';\n\nexport interface Ending {\n  id: EndingId;\n  title: string;\n  subtitle: string;\n  description: string;\n  emotion: string;\n  condition: (state: GameState) => EndingCheckResult;\n}\n\nexport interface EndingCheckResult {\n  eligible: boolean;\n  score: number;\n  details: string[];\n}\n\nexport class EndingSystem {\n  private endings: Ending[] = [];\n  private selectedEnding: Ending | null = null;\n  private showingEnding = false;\n  private endingAlpha = 0;\n  private textPhase = 0;\n  private textTimer = 0;\n  private scrollY = 0;\n\n  constructor(\n    private renderer: Renderer,\n    private state: GameState,\n    private input: InputManager\n  ) {\n    this.registerEndings();\n    this.setupInput();\n  }\n\n  private registerEndings() {\n    this.endings = [\n      {\n        id: 'justice',\n        title: '秉公执法',\n        subtitle: '结局 A',\n        description: '沈鹤年揭露一切，虽代价惨重但正义得以伸张。陆无咎重获自由，千年前的真相传遍天下。朝野震动，但百姓传颂沈鹤年的名字。',\n        emotion: '正义但苦涩',\n        condition: (s) => this.checkJustice(s),\n      },\n      {\n        id: 'compromise',\n        title: '委曲求全',\n        subtitle: '结局 B',\n        description: '沈鹤年与权力体系达成交易，封印加固，真相被部分掩盖。他得到了升迁，成为长安最年轻的推官，但深夜总会想起那双燃烧着意志的眼睛。',\n        emotion: '现实的无奈',\n        condition: (s) => this.checkCompromise(s),\n      },\n      {\n        id: 'succession',\n        title: '超凡入圣',\n        subtitle: '结局 C',\n        description: '沈鹤年接受陆无咎的传承，成为新的\"判官\"——人间的真相守护者。他将活得比普通人更久，永远站在真相与权力之间。',\n        emotion: '超然+神秘',\n        condition: (s) => this.checkSuccession(s),\n      },\n      {\n        id: 'departure',\n        title: '归隐山林',\n        subtitle: '结局 D',\n        description: '沈鹤年放弃仕途，与柳七娘远走他乡。身后是繁华的帝都和未解的谜团，前方是未知的世界和温暖的阳光。',\n        emotion: '温暖但遗憾',\n        condition: (s) => this.checkDeparture(s),\n      },\n      {\n        id: 'hidden_truth',\n        title: '真相大白',\n        subtitle: '隐藏结局',\n        description: '沈鹤年不仅揭露了千年封印的真相，更发现了隐藏在更深层的秘密——陆无咎守护的不仅是皇族血脉，而是一套可以验证任何统治者合法性的古代制度。这套制度若被实施，将永远改变权力运行的规则。',\n        emotion: '最大震撼',\n        condition: (s) => this.checkHiddenTruth(s),\n      },\n    ];\n  }\n\n  private checkJustice(s: GameState): EndingCheckResult {\n    const details: string[] = [];\n    let score = 0;\n\n    const ch1to4Correct = this.getChapterAccuracy(s);\n    if (ch1to4Correct >= 0.8) { score += 40; details.push('前四章正确率高（≥80%）'); }\n    else { score += 20; details.push('前四章正确率一般'); }\n\n    if (s.getFlag('ch5_justice_path') || s.getFlag('ch5_ending_a')) { score += 40; details.push('选择了正义之路'); }\n    else if (s.getChoice('ch5_final_choice') === 'justice') { score += 30; details.push('倾向于正义'); }\n\n    if (s.getRelationship('pei_ruyi') <= 40) { score += 10; details.push('不受权力体系束缚'); }\n    if (s.evidence.length >= 30) { score += 10; details.push('收集了充分的证据'); }\n\n    return { eligible: score >= 60, score, details };\n  }\n\n  private checkCompromise(s: GameState): EndingCheckResult {\n    const details: string[] = [];\n    let score = 0;\n\n    if (s.getRelationship('pei_ruyi') >= 60) { score += 40; details.push('裴如意信任度高'); }\n    else { score += 15; details.push('裴如意信任度一般'); }\n\n    if (s.getFlag('ch5_seal_path') || s.getFlag('ch5_ending_b')) { score += 40; details.push('选择了妥协之路'); }\n\n    if (s.getRelationship('zhang_tieshou') >= 50) { score += 10; details.push('张铁手信任稳定'); }\n    if (s.evidence.length >= 20) { score += 10; details.push('收集了足够的证据'); }\n\n    return { eligible: score >= 60, score, details };\n  }\n\n  private checkSuccession(s: GameState): EndingCheckResult {\n    const details: string[] = [];\n    let score = 0;\n\n    const supernaturalEvidence = [\n      'ch4_bronze_mirror', 'ch4_lu_statue', 'ch5_glowing_runes',\n      'ch5_seal_structure', 'ch5_lu_imprisoned', 'ch5_lu_diary',\n    ].filter((e) => s.hasEvidence(e));\n\n    if (supernaturalEvidence.length >= 4) { score += 40; details.push(`收集了${supernaturalEvidence.length}件超自然线索`); }\n    else { score += 15; details.push(`超自然线索不足（${supernaturalEvidence.length}/4）`); }\n\n    if (s.getFlag('ch5_meet_lu_path') || s.getFlag('ch5_ending_c')) { score += 40; details.push('选择了传承之路'); }\n\n    if (s.getRelationship('facheng') >= 60) { score += 10; details.push('法澄信任度高'); }\n    if (s.getFlag('ch5_facheng_revealed')) { score += 10; details.push('了解守护者传承'); }\n\n    return { eligible: score >= 60, score, details };\n  }\n\n  private checkDeparture(s: GameState): EndingCheckResult {\n    const details: string[] = [];\n    let score = 0;\n\n    if (s.getRelationship('liu_qiniang') >= 70) { score += 50; details.push('柳七娘亲密度高'); }\n    else if (s.getRelationship('liu_qiniang') >= 50) { score += 25; details.push('柳七娘亲密度一般'); }\n\n    if (s.getFlag('ch5_ending_d')) { score += 40; details.push('选择了归隐之路'); }\n\n    if (s.getFlag('ch5_went_meeting')) { score += 5; details.push('曾召集众人商议'); }\n\n    return { eligible: score >= 60, score, details };\n  }\n\n  private checkHiddenTruth(s: GameState): EndingCheckResult {\n    const details: string[] = [];\n    let score = 0;\n\n    const totalChapters = [1, 2, 3, 4].filter((c) => s.isChapterComplete(c)).length;\n    if (totalChapters === 4) { score += 25; details.push('完成了全部前四章'); }\n    else { return { eligible: false, score: 0, details: ['未完成全部章节'] }; }\n\n    if (s.evidence.length >= 50) { score += 25; details.push(`收集了${s.evidence.length}件物证（≥50）`); }\n    else { details.push(`物证不足（${s.evidence.length}/50）`); }\n\n    const requiredEvidence = [\n      'ch5_blood_secret', 'ch5_seal_truth', 'ch5_lu_testimony',\n      'ch5_secret_scroll', 'ch5_lu_diary', 'ch5_guardian_diary',\n      'ch5_lu_evidence_link', 'ch5_trial_conclusion',\n    ];\n    const collected = requiredEvidence.filter((e) => s.hasEvidence(e));\n    if (collected.length >= 7) { score += 25; details.push('关键证据链完整'); }\n    else { details.push(`关键证据不足（${collected.length}/8）`); }\n\n    if (s.getFlag('ch5_met_lu') && s.getFlag('ch5_facheng_revealed')) { score += 25; details.push('与陆无咎和法澄的深度对话完成'); }\n\n    return { eligible: score >= 80, score, details };\n  }\n\n  private getChapterAccuracy(s: GameState): number {\n    let correct = 0;\n    let total = 0;\n    for (let i = 1; i <= 4; i++) {\n      if (s.getFlag(`chapter_${i}_complete`)) correct++;\n      total++;\n    }\n    return total > 0 ? correct / total : 0;\n  }\n\n  evaluateEnding(): EndingId {\n    const flagMap: Record<string, EndingId> = {\n      ch5_ending_a: 'justice',\n      ch5_ending_b: 'compromise',\n      ch5_ending_c: 'succession',\n      ch5_ending_d: 'departure',\n    };\n\n    for (const [flag, endingId] of Object.entries(flagMap)) {\n      if (this.state.getFlag(flag)) {\n        const hidden = this.endings.find((e) => e.id === 'hidden_truth');\n        if (hidden && hidden.condition(this.state).eligible) {\n          this.selectedEnding = hidden;\n          return 'hidden_truth';\n        }\n        this.selectedEnding = this.endings.find((e) => e.id === endingId) ?? null;\n        return endingId;\n      }\n    }\n\n    let bestScore = -1;\n    let bestEnding: Ending = this.endings[0];\n    for (const ending of this.endings) {\n      const result = ending.condition(this.state);\n      if (result.score > bestScore) {\n        bestScore = result.score;\n        bestEnding = ending;\n      }\n    }\n    this.selectedEnding = bestEnding;\n    return bestEnding.id;\n  }\n\n  showEnding(endingId?: EndingId) {\n    if (endingId) {\n      this.selectedEnding = this.endings.find((e) => e.id === endingId) ?? null;\n    } else {\n      this.evaluateEnding();\n    }\n    this.showingEnding = true;\n    this.endingAlpha = 0;\n    this.textPhase = 0;\n    this.textTimer = 0;\n    this.scrollY = 0;\n  }\n\n  hideEnding() {\n    this.showingEnding = false;\n    this.selectedEnding = null;\n  }\n\n  getSelectedEnding(): Ending | null { return this.selectedEnding; }\n  isShowing(): boolean { return this.showingEnding; }\n\n  getEndingSummary(): { id: EndingId; title: string; subtitle: string; emotion: string }[] {\n    return this.endings.map((e) => ({\n      id: e.id,\n      title: e.title,\n      subtitle: e.subtitle,\n      emotion: e.emotion,\n    }));\n  }\n\n  private setupInput() {\n    this.input.onClick((e) => {\n      if (e.type !== 'up' || !this.showingEnding) return;\n      if (this.textPhase < 3) {\n        this.textPhase++;\n        this.textTimer = 0;\n      } else {\n        this.hideEnding();\n      }\n    });\n  }\n\n  update(dt: number) {\n    if (!this.showingEnding) return;\n    this.endingAlpha = Math.min(1, this.endingAlpha + dt * 1.5);\n    this.textTimer += dt;\n    if (this.textPhase === 2) {\n      this.scrollY += dt * 20;\n    }\n  }\n\n  render() {\n    if (!this.showingEnding || !this.selectedEnding) return;\n\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.save();\n    ctx.globalAlpha = this.endingAlpha;\n\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0, '#0a0505');\n    grad.addColorStop(0.5, '#150a0a');\n    grad.addColorStop(1, '#0a0505');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n\n    const ending = this.selectedEnding;\n\n    if (this.textPhase >= 0) {\n      this.renderer.drawText(ending.subtitle, w / 2, h * 0.15, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n        color: '#6a5a4a', align: 'center',\n      });\n    }\n\n    if (this.textPhase >= 0) {\n      this.renderer.drawText(ending.title, w / 2, h * 0.28, {\n        font: 'bold 42px \"SimSun\", \"Noto Serif SC\", serif',\n        color: '#c8a882', align: 'center',\n      });\n    }\n\n    if (this.textPhase >= 1) {\n      this.renderer.drawText(`「${ending.emotion}」`, w / 2, h * 0.38, {\n        font: '20px \"SimSun\", \"Noto Serif SC\", serif',\n        color: '#8a6a5a', align: 'center',\n      });\n\n      const descLines = this.wrapText(ctx, ending.description, w * 0.7, '18px \"SimSun\", \"Noto Serif SC\", serif');\n      const startY = h * 0.48;\n      descLines.forEach((line, i) => {\n        this.renderer.drawText(line, w / 2, startY + i * 28, {\n          font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n          color: '#d8c8b0', align: 'center',\n        });\n      });\n    }\n\n    if (this.textPhase >= 2) {\n      const stats = [\n        `完成章节：${this.state.completedChapters.length}/5`,\n        `收集物证：${this.state.evidence.length}件`,\n        `结局编号：${ending.subtitle}`,\n      ];\n      const statsY = h * 0.7;\n      stats.forEach((line, i) => {\n        this.renderer.drawText(line, w / 2, statsY + i * 28, {\n          font: '16px \"SimSun\", \"Noto Serif SC\", serif',\n          color: '#8a7a6a', align: 'center',\n        });\n      });\n    }\n\n    if (this.textPhase >= 3) {\n      const blinkAlpha = 0.3 + Math.sin(Date.now() * 0.004) * 0.2;\n      this.renderer.drawText('点击结束', w / 2, h * 0.88, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n        color: '#6a5a4a', align: 'center', alpha: blinkAlpha,\n      });\n    }\n\n    ctx.restore();\n  }\n\n  private wrapText(ctx: CanvasRenderingContext2D, text: string, maxWidth: number, font: string): string[] {\n    ctx.font = font;\n    const lines: string[] = [];\n    let currentLine = '';\n    for (const char of text) {\n      const testLine = currentLine + char;\n      if (ctx.measureText(testLine).width > maxWidth && currentLine.length > 0) {\n        lines.push(currentLine);\n        currentLine = char;\n      } else {\n        currentLine = testLine;\n      }\n    }\n    if (currentLine) lines.push(currentLine);\n    return lines;\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"78611f4a-78a4-4c87-b3e8-1e3da9d4e994","uuid":"53c2647b-db12-4e37-91b6-1397e4dee2f6"}
