{"type":"assistant","message":{"id":"msg_20260523233426a23664b084e241f3","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_a40489c7702a4c3682098290","name":"Write","input":{"file_path":"D:\\game-projects\\steam-ancient-mystery\\src\\game\\SceneExplorer.ts","content":"import { Renderer } from '../renderer/Renderer';\nimport { GameState } from './GameState';\nimport { InputManager } from './InputManager';\n\nexport interface Hotspot {\n  id: string;\n  x: number;\n  y: number;\n  w: number;\n  h: number;\n  label: string;\n  examined: boolean;\n  action: 'examine' | 'pickup' | 'talk' | 'enter';\n  requiresEvidence?: string;\n  requiresFlag?: string;\n  giveEvidence?: string;\n  giveFlag?: string;\n  dialogueId?: string;\n}\n\nexport interface ExploreScene {\n  sceneId: string;\n  hotspots: Hotspot[];\n}\n\nexport class SceneExplorer {\n  private scenes: Map<string, ExploreScene> = new Map();\n  private currentScene: ExploreScene | null = null;\n  private cameraX = 0;\n  private cameraY = 0;\n  private targetCameraX = 0;\n  private targetCameraY = 0;\n  private zoom = 1;\n  private targetZoom = 1;\n  private hoveredHotspot: Hotspot | null = null;\n  private activeHotspot: Hotspot | null = null;\n  private showingDetail = false;\n  private detailText = '';\n  private detailAlpha = 0;\n  private highlightPulse = 0;\n\n  private onHotspotAction?: (hotspot: Hotspot) => void;\n\n  constructor(\n    private renderer: Renderer,\n    private state: GameState,\n    private input: InputManager\n  ) {\n    this.setupInput();\n  }\n\n  setActionCallback(cb: (hotspot: Hotspot) => void) {\n    this.onHotspotAction = cb;\n  }\n\n  registerScene(scene: ExploreScene) {\n    this.scenes.set(scene.sceneId, scene);\n  }\n\n  activate(sceneId: string) {\n    const scene = this.scenes.get(sceneId);\n    if (!scene) return;\n    this.currentScene = scene;\n    this.cameraX = 0;\n    this.cameraY = 0;\n    this.targetCameraX = 0;\n    this.targetCameraY = 0;\n    this.zoom = 1;\n    this.targetZoom = 1;\n    this.showingDetail = false;\n    this.activeHotspot = null;\n  }\n\n  deactivate() {\n    this.currentScene = null;\n    this.showingDetail = false;\n    this.activeHotspot = null;\n  }\n\n  isActive(): boolean {\n    return this.currentScene !== null && !this.showingDetail;\n  }\n\n  private setupInput() {\n    this.input.onClick((e) => {\n      if (e.type !== 'up') return;\n      if (!this.currentScene) return;\n\n      if (this.showingDetail) {\n        this.showingDetail = false;\n        this.activeHotspot = null;\n        return;\n      }\n\n      const wx = (e.x - this.cameraX) / this.zoom;\n      const wy = (e.y - this.cameraY) / this.zoom;\n\n      for (const hs of this.currentScene.hotspots) {\n        if (this.hitTest(wx, wy, hs)) {\n          if (hs.requiresEvidence && !this.state.hasEvidence(hs.requiresEvidence)) continue;\n          if (hs.requiresFlag && !this.state.getFlag(hs.requiresFlag)) continue;\n\n          hs.examined = true;\n          if (hs.giveEvidence) this.state.addEvidence(hs.giveEvidence);\n          if (hs.giveFlag) this.state.setFlag(hs.giveFlag, true);\n\n          this.activeHotspot = hs;\n          this.showingDetail = true;\n          this.detailAlpha = 0;\n\n          if (hs.action === 'examine' || hs.action === 'pickup') {\n            this.detailText = hs.label + (hs.examined ? ' (已调查)' : '');\n          }\n\n          this.onHotspotAction?.(hs);\n          return;\n        }\n      }\n    });\n  }\n\n  private hitTest(wx: number, wy: number, hs: Hotspot): boolean {\n    return wx >= hs.x && wx <= hs.x + hs.w && wy >= hs.y && wy <= hs.y + hs.h;\n  }\n\n  panTo(x: number, y: number) {\n    this.targetCameraX = -x;\n    this.targetCameraY = -y;\n  }\n\n  zoomTo(level: number) {\n    this.targetZoom = Math.max(0.5, Math.min(2.5, level));\n  }\n\n  update(dt: number) {\n    if (!this.currentScene) return;\n\n    this.highlightPulse += dt * 3;\n\n    const camSpeed = 5;\n    this.cameraX += (this.targetCameraX - this.cameraX) * dt * camSpeed;\n    this.cameraY += (this.targetCameraY - this.cameraY) * dt * camSpeed;\n    this.zoom += (this.targetZoom - this.zoom) * dt * camSpeed;\n\n    if (this.showingDetail) {\n      this.detailAlpha = Math.min(1, this.detailAlpha + dt * 4);\n    }\n\n    const mx = (this.input.mouseX - this.cameraX) / this.zoom;\n    const my = (this.input.mouseY - this.cameraY) / this.zoom;\n    this.hoveredHotspot = null;\n    for (const hs of this.currentScene.hotspots) {\n      if (this.hitTest(mx, my, hs)) {\n        this.hoveredHotspot = hs;\n        break;\n      }\n    }\n  }\n\n  render() {\n    if (!this.currentScene) return;\n    const ctx = this.renderer.context;\n\n    ctx.save();\n    ctx.translate(this.cameraX, this.cameraY);\n    ctx.scale(this.zoom, this.zoom);\n\n    this.renderHotspots(ctx);\n\n    ctx.restore();\n\n    if (this.hoveredHotspot && !this.showingDetail) {\n      this.renderTooltip(ctx, this.hoveredHotspot);\n    }\n\n    if (this.showingDetail && this.activeHotspot) {\n      this.renderDetailPanel(ctx);\n    }\n  }\n\n  private renderHotspots(ctx: CanvasRenderingContext2D) {\n    if (!this.currentScene) return;\n    const pulse = Math.sin(this.highlightPulse) * 0.5 + 0.5;\n\n    for (const hs of this.currentScene.hotspots) {\n      const accessible = this.canAccess(hs);\n      const isHover = this.hoveredHotspot === hs;\n\n      ctx.save();\n\n      if (!hs.examined && accessible) {\n        const alpha = 0.08 + pulse * 0.12 + (isHover ? 0.15 : 0);\n        ctx.fillStyle = `rgba(200, 168, 130, ${alpha})`;\n        ctx.fillRect(hs.x, hs.y, hs.w, hs.h);\n\n        ctx.strokeStyle = `rgba(200, 168, 130, ${0.3 + pulse * 0.3})`;\n        ctx.lineWidth = 1;\n        ctx.setLineDash([4, 4]);\n        ctx.strokeRect(hs.x, hs.y, hs.w, hs.h);\n        ctx.setLineDash([]);\n      } else if (hs.examined) {\n        ctx.fillStyle = 'rgba(100, 80, 60, 0.05)';\n        ctx.fillRect(hs.x, hs.y, hs.w, hs.h);\n      }\n\n      if (isHover && accessible) {\n        ctx.strokeStyle = 'rgba(232, 200, 162, 0.6)';\n        ctx.lineWidth = 2;\n        ctx.strokeRect(hs.x, hs.y, hs.w, hs.h);\n      }\n\n      ctx.restore();\n    }\n  }\n\n  private canAccess(hs: Hotspot): boolean {\n    if (hs.requiresEvidence && !this.state.hasEvidence(hs.requiresEvidence)) return false;\n    if (hs.requiresFlag && !this.state.getFlag(hs.requiresFlag)) return false;\n    return true;\n  }\n\n  private renderTooltip(ctx: CanvasRenderingContext2D, hs: Hotspot) {\n    const w = this.renderer.w;\n    const mx = this.input.mouseX;\n    const my = this.input.mouseY;\n\n    const actionLabels: Record<string, string> = {\n      examine: '🔍 调查',\n      pickup: '✋ 拾取',\n      talk: '💬 对话',\n      enter: '🚪 进入',\n    };\n\n    const text = `${actionLabels[hs.action] || '互动'} ${hs.label}`;\n    ctx.save();\n    ctx.font = '16px \"SimSun\", \"Noto Serif SC\", serif';\n    const tw = ctx.measureText(text).width + 20;\n    const tx = Math.min(mx + 15, w - tw - 10);\n    const ty = my - 35;\n\n    ctx.globalAlpha = 0.9;\n    this.renderer.drawRoundRect(tx, ty, tw, 28, 4, '#1a140e', '#5a4030');\n    ctx.globalAlpha = 1;\n    this.renderer.drawText(text, tx + 10, ty + 5, {\n      font: '16px \"SimSun\", \"Noto Serif SC\", serif',\n      color: '#e8c8a2',\n    });\n    ctx.restore();\n  }\n\n  private renderDetailPanel(ctx: CanvasRenderingContext2D) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.save();\n    ctx.globalAlpha = this.detailAlpha * 0.85;\n    ctx.fillStyle = '#0a0806';\n    ctx.fillRect(0, 0, w, h);\n    ctx.restore();\n\n    ctx.save();\n    ctx.globalAlpha = this.detailAlpha;\n\n    const pw = Math.min(500, w * 0.45);\n    const ph = Math.min(300, h * 0.4);\n    const px = (w - pw) / 2;\n    const py = (h - ph) / 2;\n\n    this.renderer.drawRoundRect(px, py, pw, ph, 8, '#1a140e', '#5a4030');\n    ctx.strokeStyle = '#6a5040';\n    ctx.lineWidth = 1;\n    ctx.strokeRect(px + 4, py + 4, pw - 8, ph - 8);\n\n    if (this.activeHotspot) {\n      this.renderer.drawText(this.activeHotspot.label, px + 24, py + 20, {\n        font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n        color: '#e8c8a2',\n      });\n\n      const actionText: Record<string, string> = {\n        examine: '你仔细查看了周围...',\n        pickup: '你发现了什么！',\n        talk: '你走上前去...',\n        enter: '一道门出现在眼前。',\n      };\n      this.renderer.drawText(\n        actionText[this.activeHotspot.action] ?? '',\n        px + 24, py + 60,\n        { font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870' }\n      );\n\n      if (this.activeHotspot.examined) {\n        this.renderer.drawText('(已调查)', px + 24, py + 90, {\n          font: '16px \"SimSun\", \"Noto Serif SC\", serif', color: '#5a4a3a',\n        });\n      }\n\n      this.renderer.drawText('点击任意处关闭', px + pw / 2, py + ph - 35, {\n        font: '14px sans-serif', color: '#5a4a3a', align: 'center',\n      });\n    }\n\n    ctx.restore();\n  }\n\n  getActiveHotspot(): Hotspot | null { return this.activeHotspot; }\n  isShowingDetail(): boolean { return this.showingDetail; }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"bb710ec1-068d-4a4a-9438-6a706a63a8a0","uuid":"1da0fb91-7e42-40e8-b49b-47da2daa4f3e"}
