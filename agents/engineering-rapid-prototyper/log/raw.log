{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_083042cc10ab44a3ae276ec5","type":"tool_result","content":"1\timport { Renderer } from '../renderer/Renderer';\n2\timport { GameState } from './GameState';\n3\timport { InputManager } from './InputManager';\n4\t\n5\texport type EvidenceCategory = 'key' | 'normal' | 'misleading';\n6\t\n7\texport interface EvidenceItem {\n8\t  id: string;\n9\t  name: string;\n10\t  description: string;\n11\t  category: EvidenceCategory;\n12\t  icon?: string;\n13\t  discoveredAt: string;\n14\t  discoveredTime: number;\n15\t  combinable?: string[];\n16\t}\n17\t\n18\texport class EvidenceCollector {\n19\t  private evidenceDB: Map<string, EvidenceItem> = new Map();\n20\t  private isOpen = false;\n21\t  private selectedIndex = -1;\n22\t  private scrollOffset = 0;\n23\t  private animAlpha = 0;\n24\t  private flashId: string | null = null;\n25\t  private flashTimer = 0;\n26\t  private onEvidenceUsed?: (evidence: EvidenceItem) => void;\n27\t\n28\t  constructor(\n29\t    private renderer: Renderer,\n30\t    private state: GameState,\n31\t    private input: InputManager\n32\t  ) {\n33\t    this.setupInput();\n34\t  }\n35\t\n36\t  registerEvidence(items: EvidenceItem[]) {\n37\t    items.forEach((item) => this.evidenceDB.set(item.id, item));\n38\t  }\n39\t\n40\t  setUsedCallback(cb: (evidence: EvidenceItem) => void) {\n41\t    this.onEvidenceUsed = cb;\n42\t  }\n43\t\n44\t  collect(evidenceId: string): boolean {\n45\t    if (this.state.hasEvidence(evidenceId)) return false;\n46\t    this.state.addEvidence(evidenceId);\n47\t    this.flashId = evidenceId;\n48\t    this.flashTimer = 2;\n49\t    return true;\n50\t  }\n51\t\n52\t  open() {\n53\t    this.isOpen = true;\n54\t    this.selectedIndex = -1;\n55\t    this.scrollOffset = 0;\n56\t    this.animAlpha = 0;\n57\t  }\n58\t\n59\t  close() {\n60\t    this.isOpen = false;\n61\t    this.selectedIndex = -1;\n62\t  }\n63\t\n64\t  toggle() {\n65\t    if (this.isOpen) this.close();\n66\t    else this.open();\n67\t  }\n68\t\n69\t  getIsOpen(): boolean { return this.isOpen; }\n70\t\n71\t  getCollectedEvidence(): EvidenceItem[] {\n72\t    return this.state.evidence\n73\t      .map((id) => this.evidenceDB.get(id))\n74\t      .filter((e): e is EvidenceItem => e !== undefined);\n75\t  }\n76\t\n77\t  getEvidenceById(id: string): EvidenceItem | undefined {\n78\t    return this.evidenceDB.get(id);\n79\t  }\n80\t\n81\t  private setupInput() {\n82\t    this.input.onClick((e) => {\n83\t      if (e.type !== 'up') return;\n84\t      if (!this.isOpen) return;\n85\t      this.handleClick(e.x, e.y);\n86\t    });\n87\t  }\n88\t\n89\t  private handleClick(x: number, y: number) {\n90\t    const w = this.renderer.w;\n91\t    const h = this.renderer.h;\n92\t\n93\t    const panelW = Math.min(420, w * 0.35);\n94\t    const panelH = h - 80;\n95\t    const panelX = w - panelW - 20;\n96\t    const panelY = 40;\n97\t\n98\t    if (!this.isInRect(x, y, panelX, panelY, panelW, panelH)) {\n99\t      this.close();\n100\t      return;\n101\t    }\n102\t\n103\t    const listX = panelX + 16;\n104\t    const listY = panelY + 60;\n105\t    const itemH = 52;\n106\t    const listH = panelH - 140;\n107\t\n108\t    const items = this.getCollectedEvidence();\n109\t    for (let i = 0; i < items.length; i++) {\n110\t      const iy = listY + i * itemH - this.scrollOffset;\n111\t      if (iy < listY - itemH || iy > listY + listH) continue;\n112\t      if (this.isInRect(x, y, listX, iy, panelW - 32, itemH - 4)) {\n113\t        this.selectedIndex = this.selectedIndex === i ? -1 : i;\n114\t        return;\n115\t      }\n116\t    }\n117\t\n118\t    const closeBtnY = panelY + panelH - 50;\n119\t    if (this.isInRect(x, y, panelX + panelW / 2 - 60, closeBtnY, 120, 36)) {\n120\t      this.close();\n121\t    }\n122\t  }\n123\t\n124\t  update(dt: number) {\n125\t    if (!this.isOpen) return;\n126\t    this.animAlpha = Math.min(1, this.animAlpha + dt * 5);\n127\t    if (this.flashTimer > 0) this.flashTimer -= dt;\n128\t    if (this.flashTimer <= 0) this.flashId = null;\n129\t  }\n130\t\n131\t  render() {\n132\t    if (!this.isOpen) return;\n133\t    const ctx = this.renderer.context;\n134\t    const w = this.renderer.w;\n135\t    const h = this.renderer.h;\n136\t\n137\t    ctx.save();\n138\t    ctx.globalAlpha = this.animAlpha * 0.4;\n139\t    ctx.fillStyle = '#0a0806';\n140\t    ctx.fillRect(0, 0, w, h);\n141\t    ctx.restore();\n142\t\n143\t    ctx.save();\n144\t    ctx.globalAlpha = this.animAlpha;\n145\t\n146\t    const panelW = Math.min(420, w * 0.35);\n147\t    const panelH = h - 80;\n148\t    const panelX = w - panelW - 20;\n149\t    const panelY = 40;\n150\t\n151\t    this.renderer.drawRoundRect(panelX, panelY, panelW, panelH, 8, '#1a140e', '#3a2a1a');\n152\t    ctx.strokeStyle = '#5a4030';\n153\t    ctx.lineWidth = 1;\n154\t    ctx.strokeRect(panelX + 3, panelY + 3, panelW - 6, panelH - 6);\n155\t\n156\t    this.renderer.drawText('物 证', panelX + panelW / 2, panelY + 18, {\n157\t      font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n158\t      color: '#c8a882', align: 'center',\n159\t    });\n160\t\n161\t    const items = this.getCollectedEvidence();\n162\t    const listX = panelX + 16;\n163\t    const listY = panelY + 60;\n164\t    const itemH = 52;\n165\t    const listH = panelH - 140;\n166\t\n167\t    ctx.save();\n168\t    ctx.beginPath();\n169\t    ctx.rect(panelX + 4, listY - 4, panelW - 8, listH + 8);\n170\t    ctx.clip();\n171\t\n172\t    const categoryColors: Record<EvidenceCategory, string> = {\n173\t      key: '#c8a040',\n174\t      normal: '#a08870',\n175\t      misleading: '#8a4a4a',\n176\t    };\n177\t\n178\t    items.forEach((item, i) => {\n179\t      const iy = listY + i * itemH - this.scrollOffset;\n180\t      if (iy < listY - itemH || iy > listY + listH) return;\n181\t\n182\t      const isSelected = this.selectedIndex === i;\n183\t      const isFlash = this.flashId === item.id;\n184\t      const isHover = this.isInRect(this.input.m