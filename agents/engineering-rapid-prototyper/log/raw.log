  }\n\n  onClick(fn: (e: PointerEvent) => void) { this.listeners.push(fn); }\n  onKeydown(fn: (e: KeyboardEvent) => void) { this.keyListeners.push(fn); }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
