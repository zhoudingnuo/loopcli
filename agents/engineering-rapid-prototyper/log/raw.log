 r2, c2) {\n63\t    const tmp = this.grid[r1][c1];\n64\t    this.grid[r1][c1] = this.grid[r2][c2];\n65\t    this.grid[r2][c2] = tmp;\n66\t  }\n67\t\n68\t  _findMatches() {\n69\t    const matches = new Set();\n70\t\n71\t    // Horizontal matches\n72\t    for (let r = 0; r < config.GRID_SIZE; r++) {\n73\t      for (let c = 0; c <= config.GRID_SIZE - 3; c++) {\n74\t        const t = this.grid[r][c];\n75\t        if (t < 0) continue;\n76\t        if (this.grid[r][c + 1] === t && this.grid[r][c + 2] === t) {\n77\t          let end = c + 2;\n78\t          while (end + 1 < config.GRID_SIZE && this.grid[r][end + 1] === t) end++;\n79\t          for (let i = c; i <= end; i++) matches.add(r * config.GRID_SIZE + i);\n80\t        }\n81\t      }\n82\t    }\n83\t\n84\t    // Vertical matches\n85\t    for (let c = 0; c < config.GRID_SIZE; c++) {\n86\t      for (let r = 0; r <= config.GRID_SIZE - 3; r++) {\n87\t        const t = this.grid[r][c];\n88\t        if (t < 0) continue;\n89\t        if (this.grid[r + 1][c] === t && this.grid[r + 2][c] === t) {\n90\t          let end = r + 2;\n91\t          while (end + 1 < config.GRID_SIZE && this.grid[end + 1][c] === t) end++;\n92\t          for (let i = r; i <= end; i++) matches.add(i * config.GRID_SIZE + c);\n93\t        }\n94\t      }\n95\t    }\n96\t\n97\t    return Array.from(matches).map(idx => ({\n98\t      r: Math.floor(idx / config.GRID_SIZE),\n99\t      c: idx % config.GRID_SIZE,\n100\t    }));\n101\t  }\n102\t\n103\t  findMatches() {\n104\t    return this._findMatches();\n105\t  }\n106\t\n107\t  removeMatches(matches) {\n108\t    const removed = [];\n109\t    for (const { r, c } of matches) {\n110\t      removed.push({ r, c, type: this.grid[r][c] });\n111\t      this.grid[r][c] = -1;\n112\t    }\n113\t    return removed;\n114\t  }\n115\t\n116\t  applyGravity() {\n117\t    const moves = [];\n118\t    for (let c = 0; c < config.GRID_SIZE; c++) {\n119\t      let writeRow = config.GRID_SIZE - 1;\n120\t      for (let r = config.GRID_