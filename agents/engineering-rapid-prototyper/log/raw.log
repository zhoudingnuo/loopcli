('Step 1: Trying SSO transfer to developer.toutiao.com...');\n  await page.goto('https://developer.toutiao.com/', {\n    waitUntil: 'load',\n    timeout: 20000,\n  });\n  await page.waitForTimeout(3000);\n\n  const url1 = page.url();\n  console.log('URL after navigation:', url1);\n\n  // Capture any cookies set by toutiao.com\n  const toutiaoDomainCookies = await context.cookies(['https://developer.toutiao.com']);\n  console.log('Cookies set for toutiao.com:', toutiaoDomainCookies.length);\n\n  // Check if we're logged in on toutiao.com\n  const cookiesStr = toutiaoDomainCookies.map(c => `${c.name}=${c.value}`).join('; ');\n\n  if (cookiesStr.length > 0) {\n    console.log('Cookie string length:', cookiesStr.length);\n    console.log('Cookie names:', toutiaoDomainCookies.map(c => c.name).join(', '));\n\n    // Save these cookies for tma CLI\n    const tmaDir = path.join(process.env.HOME || process.env.USERPROFILE, '.tma-cli');\n    fs.writeFileSync(path.join(tmaDir, '.cookies'), cookiesStr);\n    console.log('Saved toutiao.com cookies to ~/.tma-cli/.cookies');\n\n    // Also save to tmg\n    const tmgDir = path.join(process.env.HOME || process.env.USERPROFILE, '.tmg-cli');\n    if (!fs.existsSync(tmgDir)) fs.mkdirSync(tmgDir, { recursive: true });\n    fs.writeFileSync(path.join(tmgDir, '.cookies'), cookiesStr);\n    console.log('Saved toutiao.com cookies to ~/.tmg-cli/.cookies');\n  }\n\n  // Take screenshot\n  await page.screenshot({ path: 'D:/games/match3-xiaoxiaoxiao/toutiao_main.png' });\n\n  // Step 2: Try to call getUserInfo with the new cookies\n  if (cookiesStr.length > 0) {\n    console.log('\\nStep 2: Testing getUserInfo API...');\n    const page2 = await context.newPage();\n    const result = await page2.evaluate(async (cookieStr) => {\n      const resp = await fetch('https://microapp.bytedance.com/platform_api/v1/app/microappadmincomm/getUserInfo', {\n        headers: { 'Cookie': cookieStr },\n      });\n      return { status: resp.status, body: await resp.text() };\n    }, cookiesStr);\n    console.log('getUserInfo result:', result.body?.substring(0, 300));\n  }\n\n  await browser.close();\n}\n\nmain().catch(err => {\n  console.error('Error:', err.message);\n  process.exit(1);\n});\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"33adb7f4-913e-4960-83b6-3354bfda46a0","uuid":"c467d134-69eb-4095-a206-9ce8c04b6e13"}
