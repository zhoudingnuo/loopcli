n  ]\n}","originalFile":"{\n  \"scenes\": [\n    {\n      \"id\": \"county_office_day\",\n      \"name\": \"万年县衙·日\",\n      \"background\": \"#1a1008\",\n      \"ambientColor\": \"#2a1a0a\",\n      \"lighting\": { \"x\": 0.5, \"y\": 0.3, \"radius\": 0.4, \"intensity\": 0.6 },\n      \"description\": \"万年县衙正堂，阳光透过窗棂洒在案桌上。卷宗堆积如山，空气中弥漫着墨香。\"\n    },\n    {\n      \"id\": \"county_office_night\",\n      \"name\": \"万年县衙·夜\",\n      \"background\": \"#0d0808\",\n      \"ambientColor\": \"#1a0a00\",\n      \"lighting\": { \"x\": 0.4, \"y\": 0.5, \"radius\": 0.2, \"intensity\": 0.3 },\n      \"description\": \"入夜后的县衙，唯有烛火摇曳。更鼓声隐隐传来，窗外是一片漆黑。\"\n    },\n    {\n      \"id\": \"west_market\",\n      \"name\": \"西市\",\n      \"background\": \"#1a1508\",\n      \"ambientColor\": \"#2a200a\",\n      \"lighting\": { \"x\": 0.5, \"y\": 0.5, \"radius\": 0.5, \"intensity\": 0.7 },\n      \"description\": \"长安西市，万商云集。胡商叫卖声、驼铃声此起彼伏，空气中混杂着香料与烤肉的味道。\"\n    },\n    {\n      \"id\": \"east_market_ruins_night\",\n      \"name\": \"东市废墟·夜\",\n      \"background\": \"#0a0d10\",\n      \"ambientColor\": \"#0a1020\",\n      \"lighting\": { \"x\": 0.3, \"y\": 0.6, \"radius\": 0.15, \"intensity\": 0.2 },\n      \"description\": \"东市废墟，月色下的断壁残垣透着诡异。水渠边隐约传来流水声，似乎还有别的什么声音……\"\n    },\n    {\n      \"id\": \"daming_palace_outer\",\n      \"name\": \"大明宫外苑\",\n      \"background\": \"#0a0810\",\n      \"ambientColor\": \"#101028\",\n      \"lighting\": { \"x\": 0.5, \"y\": 0.3, \"radius\": 0.35, \"intensity\": 0.4 },\n      \"description\": \"大明宫外苑，宫墙高耸，殿宇巍峨。宫女们行色匆匆，空气中有一种说不出的压抑。\"\n    },\n    {\n      \"id\": \"palace_garden\",\n      \"name\": \"外苑花圃\",\n      \"background\": \"#080d10\",\n      \"ambientColor\": \"#0a1520\",\n      \"lighting\": { \"x\": 0.5, \"y\": 0.5, \"radius\": 0.4, \"intensity\": 0.45 },\n      \"description\": \"废弃的花圃，暗红泥土中矗立着一块古老的石碑。周围的植物似乎都在远离石碑生长。\"\n    },\n    {\n      \"id\": \"palace_maid_quarters\",\n      \"name\": \"宫女住处\",\n      \"background\": \"#0d0810\",\n      \"ambientColor\": \"#150a1a\",\n      \"lighting\": { \"x\": 0.4, \"y\": 0.4, \"radius\": 0.3, \"intensity\": 0.35 },\n      \"description\": \"宫女们的住处，简朴而整洁。秋棠的房间已经被封锁，门口有两名内侍看守。\"\n    },\n    {\n      \"id\": \"imperial_study\",\n      \"name\": \"御书房\",\n      \"background\": \"#1a100a\",\n      \"ambientColor\": \"#2a1a10\",\n      \"lighting\": { \"x\": 0.5, \"y\": 0.3, \"radius\": 0.5, \"intensity\": 0.6 },\n      \"description\": \"皇帝的御书房，烛火通明。案上堆满了奏折，空气中弥漫着龙涎香的气息。\"\n    },\n    {\n      \"id\": \"palace_underground\",\n      \"name\": \"宫中暗道\",\n      \"background\": \"#05050a\",\n      \"ambientColor\": \"#080818\",\n      \"lighting\": { \"x\": 0.5, \"y\": 0.5, \"radius\": 0.2, \"intensity\": 0.15 },\n      \"description\": \"宫中隐秘的地下通道，空气阴冷潮湿。墙壁上隐约可见古老的符文。\"\n    },\n    {\n      \"id\": \"chang_an_streets\",\n      \"name\": \"长安城街道\",\n      \"background\": \"#1a150a\",\n      \"ambientColor\": \"#2a2010\",\n      \"lighting\": { \"x\": 0.5, \"y\": 0.5, \"radius\": 0.5, \"intensity\": 0.65 },\n      \"description\": \"长安城繁华的街道，人来人往。但近来失踪案频发，百姓们脸上多了几分忧虑。\"\n    },\n    {\n      \"id\": \"underground_entrance\",\n      \"name\": \"暗渠入口\",\n      \"background\": \"#0a0805\",\n      \"ambientColor\": \"#100a05\",\n      \"lighting\": { \"x\": 0.5, \"y\": 0.6, \"radius\": 0.2, \"intensity\": 0.2 },\n      \"description\": \"平康坊废弃坊墙旁的暗渠入口。被石板遮盖的洞口向下延伸，散发着腐朽和恐惧的气息。\"\n    },\n    {\n      \"id\": \"underground_tunnel\",\n      \"name\": \"地下暗渠\",\n      \"background\": \"#05050a\",\n      \"ambientColor\": \"#080810\",\n      \"lighting\": { \"x\": 0.5, \"y\": 0.5, \"radius\": 0.15, \"intensity\": 0.15 },\n      \"description\": \"黑暗潮湿的地下暗渠，四通八达。壁画、铜镜、蛇形图腾...处处透着诡异的仪式痕迹。\"\n    },\n    {\n      \"id\": \"underground_chamber\",\n      \"name\": \"地下集会密室\",\n      \"background\": \"#080510\",\n      \"ambientColor\": \"#100818\",\n      \"lighting\": { \"x\": 0.5, \"y\": 0.4, \"radius\": 0.25, \"intensity\": 0.2 },\n      \"description\": \"蛇神会的秘密集会场所。祭坛上的铜符和血碗散发着不祥的光芒，黑旗上的蛇形图腾在火光中扭曲。\"\n    },\n    {\n      \"id\": \"underground_cells\",\n      \"name\": \"地下牢房\",\n      \"background\": \"#050808\",\n      \"ambientColor\": \"#081010\",\n      \"lighting\": { \"x\": 0.5, \"y\": 0.5, \"radius\": 0.2, \"intensity\": 0.15 },\n      \"description\": \"关押失踪者的牢房。墙壁上的抓痕和计数标记诉说着囚禁者的痛苦和绝望。\"\n    },\n    {\n      \"id\": \"underground_altar\",\n      \"name\": \"地下祭坛\",\n      \"background\": \"#0a0508\",\n      \"ambientColor\": \"#150810\",\n      \"lighting\": { \"x\": 0.5, \"y\": 0.3, \"radius\": 0.3, \"intensity\": 0.25 },\n      \"description\": \"最深处的大祭坛。人身蛇尾的陆判官石像矗立在中央，六道铜符凹槽环绕其周。空气中弥漫着古老的力量。\"\n    }\n  ]\n}\n","structuredPatch":[{"oldStart":119,"oldLines":6,"newStart":119,"newLines":78,"lines":["       \"ambientColor\": \"#150810\",","       \"lighting\": { \"x\": 0.5, \"y\": 0.3, \"radius\": 0.3, \"intensity\": 0.25 },","       \"description\": \"最深处的大祭坛。人身蛇尾的陆判官石像矗立在中央，六道铜符凹槽环绕其周。空气中弥漫着古老的力量。\"","+    },","+    {","+      \"id\": \"daciensi_temple\",","+      \"name\": \"大慈恩寺\",","+      \"background\": \"#0a0810\",","+      \"ambientColor\": \"#100a18\",","+      \"lighting\": { \"x\": 0.5, \"y\": 0.4, \"radius\": 0.35, \"intensity\": 0.4 },","+      \"description\": \"大慈恩寺，千年古刹。晨钟暮鼓间，隐藏着封印守护者的秘密。\"","+    },","+    {","+      \"id\": \"daciensi_library\",","+      \"name\": \"藏经阁·密室\",","+      \"background\": \"#0a0808\",","+      \"ambientColor\": \"#150a10\",","+      \"lighting\": { \"x\": 0.5, \"y\": 0.3, \"radius\": 0.3, \"intensity\": 0.35 },","+      \"description\": \"藏经阁深处的隐秘密室。古籍堆积，铜符沉睡。千年的真相在此等待被揭开。\"","+    },","+    {","+      \"id\": \"underground_deep\",","+      \"name\": \"暗道深处\",","+      \"background\": \"#03030a\",","+      \"ambientColor\": \"#050510\",","+      \"lighting\": { \"x\": 0.5, \"y\": 0.5, \"radius\": 0.1, \"intensity\": 0.1 },","+      \"description\": \"暗道最深处，符文发光如活物流动。前方出现从未见过的巨大石门——判官殿的入口。\"","+    },","+    {","+      \"id\": \"seal_chamber\",","+      \"name\": \"封印之间\",","