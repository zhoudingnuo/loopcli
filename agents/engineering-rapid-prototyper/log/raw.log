p(t));\n53\t  }\n54\t\n55\t  private loop(now: number) {\n56\t    if (!this.running) return;\n57\t    const dt = Math.min((now - this.lastTime) / 1000, 0.05);\n58\t    this.lastTime = now;\n59\t\n60\t    this.update(dt);\n61\t    this.render();\n62\t\n63\t    requestAnimationFrame((t) => this.loop(t));\n64\t  }\n65\t\n66\t  private update(dt: number) {\n67\t    this.sceneManager.update(dt);\n68\t    this.dialogueEngine.update(dt);\n69\t    this.ui.update(dt);\n70\t  }\n71\t\n72\t  private render() {\n73\t    this.renderer.clear();\n74\t    this.sceneManager.render();\n75\t    this.ui.render();\n76\t  }\n77\t}\n78\t"}]},"parent_tool_use_id":null,"session_id":"b5a5daaf-c8fd-4523-92be-b3ba2de361bf","uuid":"5a858d0d-df67-4009-9e04-89e6e4fef5fe","timestamp":"2026-05-23T17:34:31.309Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/steam-ancient-mystery/src/renderer/App.ts","content":"import { Renderer } from './Renderer';\nimport { SceneManager } from '../game/SceneManager';\nimport { GameState } from '../game/GameState';\nimport { DialogueEngine } from '../game/DialogueEngine';\nimport { UIManager } from './UI/UIManager';\nimport { InputManager } from '../game/InputManager';\n\nexport class App {\n  private renderer: Renderer;\n  private sceneManager: SceneManager;\n  private gameState: GameState;\n  private dialogueEngine: DialogueEngine;\n  private ui: UIManager;\n  private input: InputManager;\n  private lastTime = 0;\n  private running = false;\n\n  constructor(private canvas: HTMLCanvasElement) {\n    const ctx = canvas.getContext('2d')!;\n    this.renderer = new Renderer(ctx, canvas);\n    this.gameState = new GameState();\n    this.sceneManager = new SceneManager(this.renderer, this.gameState);\n    this.dialogueEngine = new DialogueEngine(this.gameState);\n    this.input = new InputManager(canvas);\n    this.ui = new UIManager(\n      this.renderer,\n      this.sceneManager,\n      this.dialogueEngine,\n      this.gameState,\n      this.input\n    );\n\n    this.resize();\n    window.addEventListener('resize', () => this.resize());\n  }\n\n  private resize() {\n    const dpr = window.devicePixelRatio || 1;\n    const w = window.innerWidth;\n    const h = window.innerHeight;\n    this.canvas.width = w * dpr;\n    this.canvas.height = h * dpr;\n    this.canvas.style.width = w + 'px';\n    this.canvas.style.height = h + 'px';\n    this.renderer.setSize(w, h, dpr);\n    this.ui.resize(w, h);\n  }\n\n  start() {\n    this.running = true;\n    this.lastTime = performance.now();\n    requestAnimationFrame((t) => this.loop(t));\n  }\n\n  private loop(now: number) {\n    if (!this.running) return;\n    const dt = Math.min((now - this.lastTime) / 1000, 0.05);\n    this.lastTime = now;\n\n    this.update(dt);\n    this.render();\n\n    requestAnimationFrame((t) => this.loop(t));\n  }\n\n  private update(dt: number) {\n    this.sceneManager.update(dt);\n    this.dialogueEngine.update(dt);\n    this.ui.update(dt);\n  }\n\n  private render() {\n    this.renderer.clear();\n    this.sceneManager.render();\n    this.ui.render();\n  }\n}\n","numLines":78,"startLine":1,"totalLines":78}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_50a4ef7a354644ddae3cd390","type":"tool_result","content":"1\timport { Renderer } from '../Renderer';\n2\timport { SceneManager } from '../../game/SceneManager';\n3\timport { DialogueEngine } from '../../game/DialogueEngine';\n4\timport { GameState } from '../../game/GameState';\n5\timport { InputManager } from '../../game/InputManager';\n6\timport { SceneExplorer, Hotspot, ExploreScene } from '../../game/SceneExplorer';\n7\timport { EvidenceCollector, EvidenceItem } from '../../game/EvidenceCollector';\n8\timport { InterrogationSystem, InterrogationNPC, InterrogationTopic } from '../../game/InterrogationSystem';\n9\timport { EvidenceCombiner, CombinationRecipe } from '../../game/EvidenceCombiner';\n10\t\n11\texport type UIScreen = 'main_menu' | 'game' | 'settings' | 'save_load' | 'dialogue' | 'explore' | 'interrogation' | 'evidence' | 'combine';\n12\t\n13\texport class UIManager {\n14\t  private currentScreen: UIScreen = 'main_menu';\n15\t  private screenAlpha = 1;\n16\t  private hoverIndex = -1;\n17\t  private sceneExplorer: SceneExplorer;\n18\t  private evidenceCollector: EvidenceCollector;\n19\t  private interrogationSystem: InterrogationSystem;\n20\t  private evidenceCombiner: EvidenceCombiner;\n21\t\n22\t  constructor(\n23\t    private renderer: Renderer,\n24\t    private sceneManager: SceneManager,\n25\t    private dialogueEngine: DialogueEngine,\n26\t    private state: GameState,\n27\t    private input: InputManager\n28\t  ) {\n29\t    this.sceneExplorer = new SceneExplorer(renderer, state, input);\n30\t    this.evidenceCollector = new EvidenceCollector(renderer, state, input);\n31\t    this.interrogationSystem = new InterrogationSystem(renderer, state, dialogueEngine, input);\n32\t    this.evidenceCombiner = new EvidenceCombiner(renderer, state, input, this.evidenceCollector);\n33\t\n34\t    this.setupInput();\n35\t    this.loadDemoDialogue();\n36\t    this.loadDemoM2Data();\n37\t  }\n38\t\n39\t  private loadDemoDialogue() {\n40\t    this.dialogueEngine.loadDialogue([\n41\t      { id: 'intro_1', speaker: '旁白', text: '天宝元年，长安。', next: 'intro_2' },\n42\t      { id: 'intro_2', speaker: '旁白', text: '你是新任万年县推官沈鹤年，今日初到衙门赴任。', next: 'intro_3' },\n43\t      { id: 'intro_3', speaker: '裴如意', text: '你就是新来的推官？看起来很年轻嘛。', portrait: 'pei_ruyi', next: 'intro_4' },\n44\t      {\n45\t        id: 'intro_4', speaker: '沈鹤年', text: '',\n46\t        choices: [\n47\t          { text: '下官沈鹤年，参见县令大人。', next: 'intro_5a' },\n48\t          { text: '年龄不代表能力，大人。', next: 'intro_5b' },\n49\t        ],\n50\t      },\n51\t      { id: 'intro_5a', speaker: '裴如意', text: '嗯，懂规矩。正好，东市出了个案子，你跟我去看看。', portrait: 'pei_ruyi',\n52\t        effects: { relationship: { npc: 'pei_ruyi', delta: 5 } } },\n53\t      { id: 'intro_5b', speaker: '裴如意', text: '哈，有点意思。不过在这里，规矩比能力重要。跟我来吧。', portrait: 'pei_ruyi',\n54\t        effects: { relationship: { npc: 'pei_ruyi', delta: -3 } } },\n55\t      // M2 interrogation dialogue\n56\t      { id: 'interrog_liu_1', speaker: '刘七娘', text: '你问我那天晚上在哪？我...我在坊里待着呢。' },\n57\t      { id: 'interrog_liu_2', speaker: '刘七娘', text: '好吧...我确实去了东市，但什么也没看到！' },\n58\t      { id: 'interrog_liu_3', speaker: '刘七娘', text: '你、你怎么会有这个...好吧，我说实话。那天晚上...' },\n59\t      { id: 'interrog_zhang_1', speaker: '张铁手', text: '哼，推官大人有什么事？' },\n60\t      { id: 'interrog_zhang_2', speaker: '张铁手', text: '这件事...我知道一些，但不一定跟你说。' },\n61\t    ]);\n62\t  }\n63\t\n64\t  private loadDemoM2Data() {\n65\t    // Evidence items\n66\t    this.evidenceCollector.registerEvidence([\n67\t      { id: 'broken_jade', name: '碎玉佩', description: '在东市废墟中发现的一块碎玉佩，上面刻有\"裴\"字。', category: 'key', discoveredAt: 'east_market_ruins', discoveredTime: Date.now(), combinable: ['blood_cloth'] },\n68\t      { id: 'blood_cloth', name: '血衣碎片', description: '沾有暗色血迹的布料，质地似官服。', category: 'key', discoveredAt: 'east_market_ruins', discoveredTime: Date.now(), combinable: ['broken_jade'] },\n69\t      { id: 'night_watch_log', name: '巡夜记录', description: '当夜的巡夜记录，记载了可疑人影的出没时间。', category: 'normal', discoveredAt: 'county_office', discoveredTime: Date.now() },\n70\t      { id: 'fake_seal', name: '伪造印信', description: '一枚做工粗糙的伪造官印。', category: 'misleading', discoveredAt: 'west_market', discoveredTime: Date.now() },\n71\t    ]);\n72\t\n73\t    // Scene explorer hotspots\n74\t    this.sceneExplorer.registerScene({\n75\t      sceneId: 'east_market_ruins',\n76\t      hotspots: [\n77\t        { id: 'hs_jade', x: 200, y: 150, w: 80, h: 60, label: '碎玉佩', examined: false, action: 'pickup', giveEvidence: 'broken_jade' },\n78\t        { id: 'hs_cloth', x: 500, y: 300, w: 100, h: 70, label: '血衣碎片', examined: false, action: 'pickup', giveEvidence: 'blood_cloth' },\n79\t        { id: 'hs_door', x: 800, y: 200, w: 60, h: 120, label: '破旧的门', examined: false, action: 'examine' },\n80\t        { id: 'hs_wall', x: 100, y: 400, w: 200, h: 80, label: '残墙上的字迹', examined: false, action: 'examine' },\n81\t      ],\n82\t    });\n83\t\n84\t    this.sceneExplorer.registerScene({\n85\t      sceneId: 'county_office',\n86\t      hotspots: [\n87\t        { id: 'hs_desk', x: 400, y: 200, w: 150, h: 100, label: '县令书案', examined: false, action: 'examine' },\n88\t        { id: 'hs_log', x: 600, y: 350, w: 80, h: 50, label: '巡夜记录', examined: false, action: 'pickup', giveEvidence: 'night_watch_log' },\n89\t      ],\n90\t    });\n91\t\n92\t    // Interrogation NPCs\n93\t    this.interrogationSystem.registerNPC({ id: 'liu_qiniang', name: '刘七娘', defaultPressure: 20, maxPressure: 100 });\n94\t    this.interrogationSystem.registerNPC({ id: 'zhang_tieshou', name: '张铁手', defaultPressure: 35, maxPressure: 100 });\n95\t\n96\t    this.interrogationSystem.registerTopics([\n97\t      { id: 't_liu_1', npcId: 'liu_qiniang', label: '案发当晚行踪', dialogueId: 'interrog_liu_1', repeatable: false },\n98\t      { id: 't_liu_2', npcId: 'liu_qiniang', label: '东市见闻', dialogueId: 'interrog_liu_2', repeatable: false, pressureRange: { min: 30, max: 100 } },\n99\t      { id: 't_liu_3', npcId: 'liu_qiniang', label: '关于碎玉佩', dialogueId: 'interrog_liu_3', repeatable: false, requiresEvidence: ['broken_jade'] },\n100\t      { id: 't_zhang_1', npcId: 'zhang_tieshou', label: '当晚巡逻情况', dialogueId: 'interrog_zhang_1', repeatable: false },\n101\t      { id: 't_zhang_2', npcId: 'zhang_tieshou', label: '可疑人物', dialogueId: 'interrog_zhang_2', repeatable: false, requiresEvidence: ['night_watch_log'] },\n102\t    ]);\n103\t\n104\t    // Combination recipes\n105\t    this.evidenceCombiner.registerRecipes([\n106\t      { id: 'recipe_1', inputs: ['broken_jade', 'blood_cloth'], output: 'jade_cloth_bundle', outputName: '玉佩与血衣', outputDescription: '碎玉佩与血衣碎片放在一起，血迹的位置恰好对应玉佩上的裂纹——这是案发现场的关键关联。', outputCategory: 'key' },\n107\t    ]);\n108\t\n109\t    // Hotspot action callback\n110\t    this.sceneExplorer.setActionCallback((hs) => {\n111\t      if (hs.action === 'talk' && hs.dialogueId) {\n112\t        this.dialogueEngine.start(hs.dialogueId);\n113\t      }\n114\t    });\n115\t  }\n116\t\n117\t  private setupInput() {\n118\t    this.input.onClick((e) => {\n119\t      if (e.type !== 'up') return;\n120\t      this.handleClick(e.x, e.y);\n121\t    });\n122\t  }\n123\t\n124\t  private handleClick(x: number, y: number) {\n125\t    switch (this.currentScreen) {\n126\t      case 'main_menu': this.handleMenuClick(x, y); break;\n127\t      case 'dialogue': this.handleDialogueClick(x, y); break;\n128\t      case 'settings': this.handleSettingsClick(x, y); break;\n129\t      case 'save_load': this.handleSaveLoadClick(x, y); break;\n130\t      case 'explore': this.handleExploreClick(x, y); break;\n131\t      case 'interrogation': break;\n132\t      case 'evidence': break;\n133\t      case 'combine': break;\n134\t    }\n135\t  }\n136\t\n137\t  resize(w: number, h: number) {}\n138\t\n139\t  update(dt: number) {\n140\t    this.state.playTime += dt;\n141\t    this.sceneExplorer.update(dt);\n142\t    this.evidenceCollector.update(dt);\n143\t    this.interrogationSystem.update(dt);\n144\t    this.evidenceCombiner.update(dt);\n145\t  }\n146\t\n147\t  render() {\n148\t    switch (this.currentScreen) {\n149\t      case 'main_menu': this.renderMainMenu(); break;\n150\t      case 'game': this.renderGameHUD(); break;\n151\t      case 'dialogue': this.renderDialogueUI(); break;\n152\t      case 'settings': this.renderSettings(); break;\n153\t      case 'save_load': this.renderSaveLoad(); break;\n154\t      case 'explore': this.renderExploreScreen(); break;\n155\t      case 'interrogation': this.renderInterrogationScreen(); break;\n156\t      case 'evidence': this.renderEvidenceScreen(); break;\n157\t      case 'combine': this.renderCombineScreen(); break;\n158\t    }\n159\t  }\n160\t\n161\t  // ── Main Menu ──\n162\t\n163\t  private menuItems = [\n164\t    { label: '开始游戏', action: () => this.startGame() },\n165\t    { label: '继续游戏', action: () => this.showScreen('save_load') },\n166\t    { label: '设置', action: () => this.showScreen('settings') },\n167\t  ];\n168\t\n169\t  private renderMainMenu() {\n170\t    const ctx = this.renderer.context;\n171\t    const w = this.renderer.w;\n172\t    const h = this.renderer.h;\n173\t\n174\t    const grad = ctx.createLinearGradient(0, 0, 0, h);\n175\t    grad.addColorStop(0, '#0d0808');\n176\t    grad.addColorStop(0.5, '#1a0a0a');\n177\t    grad.addColorStop(1, '#0d0808');\n178\t    ctx.fillStyle = grad;\n179\t    ctx.fillRect(0, 0, w, h);\n180\t\n181\t    ctx.save();\n182\t    ctx.globalAlpha = 0.05;\n183\t    for (let i = 0; i < 5; i++) {\n184\t      const cx = w * 0.3 + Math.sin(i * 1.7) * w * 0.2;\n185\t      const cy = h * 0.4 + Math.cos(i * 2.3) * h * 0.15;\n186\t      const r = 80 + i * 30;\n187\t      const g2 = ctx.createRadialGradient(cx, cy, 0, cx, cy, r);\n188\t      g2.addColorStop(0, '#8b0000');\n189\t      g2.addColorStop(1, 'transparent');\n190\t      ctx.fillStyle = g2;\n191\t      ctx.fillRect(0, 0, w, h);\n192\t    }\n193\t    ctx.restore();\n194\t\n195\t    this.renderer.drawText('长 安 诡 案 录', w / 2, h * 0.22, {\n196\t      font: 'bold 64px \"SimSun\", \"Noto Serif SC\", serif',\n197\t      color: '#c8a882',\n198\t      align: 'center',\n199\t    });\n200\t    this.renderer.drawText('Records of Chang\\'an Anomalies', w / 2, h * 0.32, {\n201\t      font: '20px \"Georgia\", serif',\n202\t      color: '#8a7a6a',\n203\t      align: 'center',\n204\t    });\n205\t\n206\t    ctx.strokeStyle = '#4a3020';\n207\t    ctx.lineWidth = 1;\n208\t    ctx.beginPath();\n209\t    ctx.moveTo(w * 0.3, h * 0.40);\n210\t    ctx.lineTo(w * 0.7, h * 0.40);\n211\t    ctx.stroke();\n212\t\n213\t    this.menuItems.forEach((item, i) => {\n214\t      const y = h * 0.50 + i * 60;\n215\t      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, w * 0.35, y - 20, w * 0.3, 45);\n216\t      const color = isHover ? '#e8c8a2' : '#a08870';\n217\t\n218\t      if (isHover) {\n219\t        ctx.save();\n220\t        ctx.globalAlpha = 0.15;\n221\t        ctx.fillStyle = '#4a3020';\n222\t        ctx.fillRect(w * 0.35, y - 20, w * 0.3, 45);\n223\t        ctx.restore();\n224\t      }\n225\t\n226\t      this.renderer.drawText(item.label, w / 2, y, {\n227\t        font: '28px \"SimSun\", \"Noto Serif SC\", serif',\n228\t        color,\n229\t        align: 'center',\n230\t      });\n231\t    });\n232\t\n233\t    this.renderer.drawText('v0.2.0 - M2 调查系统', w / 2, h * 0.92, {\n234\t      font: '14px sans-serif', color: '#4a3a2a', align: 'center',\n235\t    });\n236\t  }\n237\t\n238\t  private handleMenuClick(x: number, y: number) {\n239\t    const w = this.renderer.w;\n240\t    const h = this.renderer.h;\n241\t    this.menuItems.forEach((item, i) => {\n242\t      const iy = h * 0.50 + i * 60;\n243\t      if (this.isInRect(x, y, w * 0.35, iy - 20, w * 0.3, 45)) {\n244\t        item.action();\n245\t      }\n246\t    });\n247\t  }\n248\t\n249\t  // ── Dialogue UI ──\n250\t\n251\t  private startGame() {\n252\t    this.showScreen('dialogue');\n253\t    this.sceneManager.switchTo('county_office', true);\n254\t    this.dialogueEngine.start('intro_1', () => {\n255\t      this.showScreen('game');\n256\t    });\n257\t  }\n258\t\n259\t  private renderDialogueUI() {\n260\t    this.renderGameHUD();\n261\t    if (!this.dialogueEngine.getIsActive()) return;\n262\t\n263\t    const ctx = this.renderer.context;\n264\t    const w = this.renderer.w;\n265\t    const h = this.renderer.h;\n266\t    const boxH = 200;\n267\t    const boxY = h - boxH - 20;\n268\t    const boxX = 40;\n269\t    const boxW = w - 80;\n270\t\n271\t    ctx.save();\n272\t    ctx.globalAlpha = 0.92;\n273\t    this.renderer.drawRoundRect(boxX, boxY, boxW, boxH, 8, '#1a140e', '#3a2a1a');\n274\t    ctx.restore();\n275\t\n276\t    ctx.strokeStyle = '#5a4030';\n277\t    ctx.lineWidth = 2;\n278\t    ctx.beginPath();\n279\t    const m = 6;\n280\t    ctx.roundRect(boxX + m, boxY + m, boxW - m * 2, boxH - m * 2, 4);\n281\t    ctx.stroke();\n282\t\n283\t    const speaker = this.dialogueEngine.getSpeaker();\n284\t    if (speaker) {\n285\t      const spW = ctx.measureText(speaker).width || speaker.length * 28;\n286\t      this.renderer.drawRoundRect(boxX + 20, boxY - 18, spW + 40, 36, 6, '#2a1a0e', '#5a4030');\n287\t      this.renderer.drawText(speaker, boxX + 40, boxY - 10, {\n288\t        font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2',\n289\t      });\n290\t    }\n291\t\n292\t    const text = this.dialogueEngine.getDisplayText();\n293\t    this.renderWrappedText(text, boxX + 30, boxY + 30, boxW - 60, boxH - 60, {\n294\t      font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0',\n295\t    });\n296\t\n297\t    if (!this.dialogueEngine.getIsTyping()) {\n298\t      const choices = this.dialogueEngine.getChoices();\n299\t      if (choices.length > 0) {\n300\t        choices.forEach((c, i) => {\n301\t          const cy = boxY + boxH + 15 + i * 48;\n302\t          const cx = boxX + 30;\n303\t          const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, cx, cy - 5, boxW - 60, 38);\n304\t\n305\t          if (isHover) {\n306\t            ctx.save();\n307\t            ctx.globalAlpha = 0.3;\n308\t            this.renderer.drawRoundRect(cx, cy - 5, boxW - 60, 38, 4, '#3a2a1a');\n309\t            ctx.restore();\n310\t          }\n311\t\n312\t          this.renderer.drawText(`▸ ${c.text}`, cx + 10, cy + 3, {\n313\t            font: '20px \"SimSun\", \"Noto Serif SC\", serif',\n314\t            color: isHover ? '#f0d8b0' : '#b8a890',\n315\t          });\n316\t        });\n317\t      } else {\n318\t        const blinkAlpha = 0.4 + Math.sin(Date.now() * 0.005) * 0.3;\n319\t        this.renderer.drawText('▼', boxX + boxW - 40, boxY + boxH - 40, {\n320\t          font: '18px sans-serif', color: '#8a7a6a', alpha: blinkAlpha,\n321\t        });\n322\t      }\n323\t    }\n324\t  }\n325\t\n326\t  private handleDialogueClick(x: number, y: number) {\n327\t    if (!this.dialogueEngine.getIsActive()) return;\n328\t    const w = this.renderer.w;\n329\t    const h = this.renderer.h;\n330\t    const boxH = 200;\n331\t    const boxY = h - boxH - 20;\n332\t    const boxX = 40;\n333\t    const boxW = w - 80;\n334\t\n335\t    if (this.dialogueEngine.getIsTyping()) {\n336\t      this.dialogueEngine.advance();\n337\t      return;\n338\t    }\n339\t\n340\t    const choices = this.dialogueEngine.getChoices();\n341\t    if (choices.length > 0) {\n342\t      choices.forEach((c, i) => {\n343\t        const cy = boxY + boxH + 15 + i * 48;\n344\t        if (this.isInRect(x, y, boxX + 30, cy - 5, boxW - 60, 38)) {\n345\t          this.dialogueEngine.selectChoice(i);\n346\t        }\n347\t      });\n348\t    } else {\n349\t      if (this.isInRect(x, y, boxX, boxY, boxW, boxH)) {\n350\t        this.dialogueEngine.advance();\n351\t      }\n352\t    }\n353\t  }\n354\t\n355\t  // ── Settings ──\n356\t\n357\t  private settingsItems = [\n358\t    { label: '文字速度', key: 'textSpeed', min: 10, max: 80 },\n359\t    { label: '主音量', key: 'master', min: 0, max: 100 },\n360\t    { label: '音乐音量', key: 'bgm', min: 0, max: 100 },\n361\t    { label: '音效音量', key: 'sfx', min: 0, max: 100 },\n362\t  ];\n363\t\n364\t  private renderSettings() {\n365\t    const ctx = this.renderer.context;\n366\t    const w = this.renderer.w;\n367\t    const h = this.renderer.h;\n368\t\n369\t    ctx.fillStyle = 'rgba(10, 8, 6, 0.95)';\n370\t    ctx.fillRect(0, 0, w, h);\n371\t\n372\t    this.renderer.drawText('设  置', w / 2, h * 0.12, {\n373\t      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif',\n374\t      color: '#c8a882', align: 'center',\n375\t    });\n376\t\n377\t    this.settingsItems.forEach((item, i) => {\n378\t      const y = h * 0.30 + i * 70;\n379\t      this.renderer.drawText(item.label, w * 0.25, y, {\n380\t        font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870',\n381\t      });\n382\t\n383\t      const barX = w * 0.45;\n384\t      const barW = w * 0.30;\n385\t      const barH = 8;\n386\t      ctx.fillStyle = '#2a1a0e';\n387\t      ctx.fillRect(barX, y + 8, barW, barH);\n388\t\n389\t      const val = item.key === 'textSpeed'\n390\t        ? (this.state.settings.textSpeed - item.min) / (item.max - item.min)\n391\t        : (this.state.settings.volume[item.key as keyof typeof this.state.settings.volume] ?? 0.8);\n392\t      ctx.fillStyle = '#8b4513';\n393\t      ctx.fillRect(barX, y + 8, barW * val, barH);\n394\t\n395\t      const knobX = barX + barW * val;\n396\t      ctx.fillStyle = '#c8a882';\n397\t      ctx.beginPath();\n398\t      ctx.arc(knobX, y + 12, 8, 0, Math.PI * 2);\n399\t      ctx.fill();\n400\t    });\n401\t\n402\t    this.renderBackButton(w, h);\n403\t  }\n404\t\n405\t  private handleSettingsClick(x: number, y: number) {\n406\t    const w = this.renderer.w;\n407\t    const h = this.renderer.h;\n408\t    if (this.isInRect(x, y, w * 0.35, h * 0.85, w * 0.3, 45)) {\n409\t      this.showScreen('main_menu');\n410\t    }\n411\t  }\n412\t\n413\t  // ── Save/Load ──\n414\t\n415\t  private renderSaveLoad() {\n416\t    const ctx = this.renderer.context;\n417\t    const w = this.renderer.w;\n418\t    const h = this.renderer.h;\n419\t\n420\t    ctx.fillStyle = 'rgba(10, 8, 6, 0.95)';\n421\t    ctx.fillRect(0, 0, w, h);\n422\t\n423\t    this.renderer.drawText('存  档', w / 2, h * 0.08, {\n424\t      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif',\n425\t      color: '#c8a882', align: 'center',\n426\t    });\n427\t\n428\t    for (let i = 0; i < 6; i++) {\n429\t      const col = i % 3;\n430\t      const row = Math.floor(i / 3);\n431\t      const sx = w * 0.12 + col * (w * 0.28);\n432\t      const sy = h * 0.18 + row * (h * 0.32);\n433\t      const sw = w * 0.25;\n434\t      const sh = h * 0.26;\n435\t\n436\t      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, sx, sy, sw, sh);\n437\t\n438\t      ctx.save();\n439\t      ctx.globalAlpha = isHover ? 0.9 : 0.7;\n440\t      this.renderer.drawRoundRect(sx, sy, sw, sh, 6, '#1a140e', isHover ? '#6a5040' : '#3a2a1a');\n441\t      ctx.restore();\n442\t\n443\t      this.renderer.drawText(`存档 ${i + 1}`, sx + 15, sy + 15, {\n444\t        font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870',\n445\t      });\n446\t      this.renderer.drawText('空', sx + sw / 2, sy + sh / 2 - 10, {\n447\t        font: '24px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n448\t      });\n449\t    }\n450\t\n451\t    this.renderBackButton(w, h);\n452\t  }\n453\t\n454\t  private handleSaveLoadClick(x: number, y: number) {\n455\t    const w = this.renderer.w;\n456\t    const h = this.renderer.h;\n457\t    if (this.isInRect(x, y, w * 0.35, h * 0.85, w * 0.3, 45)) {\n458\t      this.showScreen('main_menu');\n459\t    }\n460\t  }\n461\t\n462\t  // ── M2 Screens ──\n463\t\n464\t  private renderExploreScreen() {\n465\t    this.sceneExplorer.render();\n466\t    this.renderM2Toolbar();\n467\t  }\n468\t\n469\t  private handleExploreClick(x: number, y: number) {\n470\t    const w = this.renderer.w;\n471\t    const h = this.renderer.h;\n472\t    this.handleM2ToolbarClick(x, y);\n473\t  }\n474\t\n475\t  private renderInterrogationScreen() {\n476\t    this.interrogationSystem.render();\n477\t    this.renderM2Toolbar();\n478\t  }\n479\t\n480\t  private renderEvidenceScreen() {\n481\t    this.evidenceCollector.render();\n482\t  }\n483\t\n484\t  private renderCombineScreen() {\n485\t    this.evidenceCombiner.render();\n486\t  }\n487\t\n488\t  private renderM2Toolbar() {\n489\t    const ctx = this.renderer.context;\n490\t    const w = this.renderer.w;\n491\t    const h = this.renderer.h;\n492\t\n493\t    const toolbarY = h - 60;\n494\t    ctx.save();\n495\t    ctx.globalAlpha = 0.85;\n496\t    ctx.fillStyle = '#0e0a08';\n497\t    ctx.fillRect(0, toolbarY, w, 60);\n498\t    ctx.strokeStyle = '#3a2a1a';\n499\t    ctx.lineWidth = 1;\n500\t    ctx.beginPath();\n501\t    ctx.moveTo(0, toolbarY);\n502\t    ctx.lineTo(w, toolbarY);\n503\t    ctx.stroke();\n504\t    ctx.restore();\n505\t\n506\t    const buttons = [\n507\t      { label: '探索', screen: 'explore' as UIScreen, x: w * 0.1 },\n508\t      { label: '审问', screen: 'interrogation' as UIScreen, x: w * 0.3 },\n509\t      { label: '物证', screen: 'evidence' as UIScreen, x: w * 0.5 },\n510\t      { label: '组合', screen: 'combine' as UIScreen, x: w * 0.7 },\n511\t      { label: '返回', screen: 'game' as UIScreen, x: w * 0.9 },\n512\t    ];\n513\t\n514\t    buttons.forEach((btn) => {\n515\t      const isActive = this.currentScreen === btn.screen;\n516\t      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, btn.x - 40, toolbarY + 10, 80, 40);\n517\t\n518\t      if (isActive) {\n519\t        ctx.fillStyle = 'rgba(200, 168, 130, 0.15)';\n520\t        ctx.fillRect(btn.x - 40, toolbarY + 10, 80, 40);\n521\t      } else if (isHover) {\n522\t        ctx.fillStyle = 'rgba(200, 168, 130, 0.07)';\n523\t        ctx.fillRect(btn.x - 40, toolbarY + 10, 80, 40);\n524\t      }\n525\t\n526\t      this.renderer.drawText(btn.label, btn.x, toolbarY + 20, {\n527\t        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n528\t        color: isActive ? '#e8c8a2' : isHover ? '#c8a882' : '#8a7a6a',\n529\t        align: 'center',\n530\t      });\n531\t    });\n532\t  }\n533\t\n534\t  private handleM2ToolbarClick(x: number, y: number) {\n535\t    const w = this.renderer.w;\n536\t    const h = this.renderer.h;\n537\t    const toolbarY = h - 60;\n538\t    if (y < toolbarY) return;\n539\t\n540\t    const buttons: { screen: UIScreen; x: number }[] = [\n541\t      { screen: 'explore', x: w * 0.1 },\n542\t      { screen: 'interrogation', x: w * 0.3 },\n543\t      { screen: 'evidence', x: w * 0.5 },\n544\t      { screen: 'combine', x: w * 0.7 },\n545\t      { screen: 'game', x: w * 0.9 },\n546\t    ];\n547\t\n548\t    for (const btn of buttons) {\n549\t      if (this.isInRect(x, y, btn.x - 40, toolbarY + 10, 80, 40)) {\n550\t        if (btn.screen === 'explore') {\n551\t          this.sceneExplorer.activate(this.state.scene);\n552\t        }\n553\t        if (btn.screen === 'interrogation') {\n554\t          const firstNPC = 'liu_qiniang';\n555\t          this.interrogationSystem.startInterrogation(firstNPC);\n556\t        }\n557\t        if (btn.screen === 'evidence') {\n558\t          this.evidenceCollector.open();\n559\t        }\n560\t        if (btn.screen === 'combine') {\n561\t          this.evidenceCombiner.open();\n562\t        }\n563\t        this.showScreen(btn.screen);\n564\t        return;\n565\t      }\n566\t    }\n567\t  }\n568\t\n569\t  // ── Game HUD ──\n570\t\n571\t  private renderGameHUD() {\n572\t    const ctx = this.renderer.context;\n573\t    const w = this.renderer.w;\n574\t    const h = this.renderer.h;\n575\t\n576\t    ctx.save();\n577\t    ctx.globalAlpha = 0.5;\n578\t    ctx.fillStyle = '#c8a882';\n579\t    ctx.font = '14px sans-serif';\n580\t    ctx.fillText(`第${this.state.chapter}章 | ${this.state.scene}`, 15, 20);\n581\t    ctx.restore();\n582\t\n583\t    this.renderM2Toolbar();\n584\t  }\n585\t\n586\t  // ── Helpers ──\n587\t\n588\t  private renderWrappedText(text: string, x: number, y: number, maxW: number, maxH: number,\n589\t    opts: { font?: string; color?: string }) {\n590\t    const ctx = this.renderer.context;\n591\t    ctx.save();\n592\t    ctx.font = opts.font ?? '20px \"SimSun\", \"Noto Serif SC\", serif';\n593\t    ctx.fillStyle = opts.color ?? '#d8c8b0';\n594\t\n595\t    let lineY = y;\n596\t    let line = '';\n597\t    for (const ch of text) {\n598\t      const test = line + ch;\n599\t      if (ctx.measureText(test).width > maxW) {\n600\t        ctx.fillText(line, x, lineY);\n601\t        line = ch;\n602\t        lineY += 28;\n603\t        if (lineY - y > maxH) break;\n604\t      } else {\n605\t        line = test;\n606\t      }\n607\t    }\n608\t    if (line) ctx.fillText(line, x, lineY);\n609\t    ctx.restore();\n610\t  }\n611\t\n612\t  private renderBackButton(w: number, h: number) {\n613\t    const bx = w * 0.35;\n614\t    const by = h * 0.85;\n615\t    const bw = w * 0.3;\n616\t    const bh = 45;\n617\t    const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, bx, by, bw, bh);\n618\t\n619\t    ctx: this.renderer.drawRoundRect(bx, by, bw, bh, 6,\n620\t      isHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n621\t    this.renderer.drawText('返回', w / 2, by + 12, {\n622\t      font: '24px \"SimSun\", \"Noto Serif SC\", serif',\n623\t      color: isHover ? '#e8c8a2' : '#a08870', align: 'center',\n624\t    });\n625\t  }\n626\t\n627\t  private showScreen(screen: UIScreen) { this.currentScreen = screen; }\n628\t\n629\t  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n630\t    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n631\t  }\n632\t}\n633\t"}]},"parent_tool_use_id":null,"session_id":"b5a5daaf-c8fd-4523-92be-b3ba2de361bf","uuid":"d383f724-9398-4e0f-928c-44cefb53584b","timestamp":"2026-05-23T17:34:31.373Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/steam-ancient-mystery/src/renderer/UI/UIManager.ts","content":"import { Renderer } from '../Renderer';\nimport { SceneManager } from '../../game/SceneManager';\nimport { DialogueEngine } from '../../game/DialogueEngine';\nimport { GameState } from '../../game/GameState';\nimport { InputManager } from '../../game/InputManager';\nimport { SceneExplorer, Hotspot, ExploreScene } from '../../game/SceneExplorer';\nimport { EvidenceCollector, EvidenceItem } from '../../game/EvidenceCollector';\nimport { InterrogationSystem, InterrogationNPC, InterrogationTopic } from '../../game/InterrogationSystem';\nimport { EvidenceCombiner, CombinationRecipe } from '../../game/EvidenceCombiner';\n\nexport type UIScreen = 'main_menu' | 'game' | 'settings' | 'save_load' | 'dialogue' | 'explore' | 'interrogation' | 'evidence' | 'combine';\n\nexport class UIManager {\n  private currentScreen: UIScreen = 'main_menu';\n  private screenAlpha = 1;\n  private hoverIndex = -1;\n  private sceneExplorer: SceneExplorer;\n  private evidenceCollector: EvidenceCollector;\n  private interrogationSystem: InterrogationSystem;\n  private evidenceCombiner: EvidenceCombiner;\n\n  constructor(\n    private renderer: Renderer,\n    private sceneManager: SceneManager,\n    private dialogueEngine: DialogueEngine,\n    private state: GameState,\n    private input: InputManager\n  ) {\n    this.sceneExplorer = new SceneExplorer(renderer, state, input);\n    this.evidenceCollector = new EvidenceCollector(renderer, state, input);\n    this.interrogationSystem = new InterrogationSystem(renderer, state, dialogueEngine, input);\n    this.evidenceCombiner = new EvidenceCombiner(renderer, state, input, this.evidenceCollector);\n\n    this.setupInput();\n    this.loadDemoDialogue();\n    this.loadDemoM2Data();\n  }\n\n  private loadDemoDialogue() {\n    this.dialogueEngine.loadDialogue([\n      { id: 'intro_1', speaker: '旁白', text: '天宝元年，长安。', next: 'intro_2' },\n      { id: 'intro_2', speaker: '旁白', text: '你是新任万年县推官沈鹤年，今日初到衙门赴任。', next: 'intro_3' },\n      { id: 'intro_3', speaker: '裴如意', text: '你就是新来的推官？看起来很年轻嘛。', portrait: 'pei_ruyi', next: 'intro_4' },\n      {\n        id: 'intro_4', speaker: '沈鹤年', text: '',\n        choices: [\n          { text: '下官沈鹤年，参见县令大人。', next: 'intro_5a' },\n          { text: '年龄不代表能力，大人。', next: 'intro_5b' },\n        ],\n      },\n      { id: 'intro_5a', speaker: '裴如意', text: '嗯，懂规矩。正好，东市出了个案子，你跟我去看看。', portrait: 'pei_ruyi',\n        effects: { relationship: { npc: 'pei_ruyi', delta: 5 } } },\n      { id: 'intro_5b', speaker: '裴如意', text: '哈，有点意思。不过在这里，规矩比能力重要。跟我来吧。', portrait: 'pei_ruyi',\n        effects: { relationship: { npc: 'pei_ruyi', delta: -3 } } },\n      // M2 interrogation dialogue\n      { id: 'interrog_liu_1', speaker: '刘七娘', text: '你问我那天晚上在哪？我...我在坊里待着呢。' },\n      { id: 'interrog_liu_2', speaker: '刘七娘', text: '好吧...我确实去了东市，但什么也没看到！' },\n      { id: 'interrog_liu_3', speaker: '刘七娘', text: '你、你怎么会有这个...好吧，我说实话。那天晚上...' },\n      { id: 'interrog_zhang_1', speaker: '张铁手', text: '哼，推官大人有什么事？' },\n      { id: 'interrog_zhang_2', speaker: '张铁手', text: '这件事...我知道一些，但不一定跟你说。' },\n    ]);\n  }\n\n  private loadDemoM2Data() {\n    // Evidence items\n    this.evidenceCollector.registerEvidence([\n      { id: 'broken_jade', name: '碎玉佩', description: '在东市废墟中发现的一块碎玉佩，上面刻有\"裴\"字。', category: 'key', discoveredAt: 'east_market_ruins', discoveredTime: Date.now(), combinable: ['blood_cloth'] },\n      { id: 'blood_cloth', name: '血衣碎片', description: '沾有暗色血迹的布料，质地似官服。', category: 'key', discoveredAt: 'east_market_ruins', discoveredTime: Date.now(), combinable: ['broken_jade'] },\n      { id: 'night_watch_log', name: '巡夜记录', description: '当夜的巡夜记录，记载了可疑人影的出没时间。', category: 'normal', discoveredAt: 'county_office', discoveredTime: Date.now() },\n      { id: 'fake_seal', name: '伪造印信', description: '一枚做工粗糙的伪造官印。', category: 'misleading', discoveredAt: 'west_market', discoveredTime: Date.now() },\n    ]);\n\n    // Scene explorer hotspots\n    this.sceneExplorer.registerScene({\n      sceneId: 'east_market_ruins',\n      hotspots: [\n        { id: 'hs_jade', x: 200, y: 150, w: 80, h: 60, label: '碎玉佩', examined: false, action: 'pickup', giveEvidence: 'broken_jade' },\n        { id: 'hs_cloth', x: 500, y: 300, w: 100, h: 70, label: '血衣碎片', examined: false, action: 'pickup', giveEvidence: 'blood_cloth' },\n        { id: 'hs_door', x: 800, y: 200, w: 60, h: 120, label: '破旧的门', examined: false, action: 'examine' },\n        { id: 'hs_wall', x: 100, y: 400, w: 200, h: 80, label: '残墙上的字迹', examined: false, action: 'examine' },\n      ],\n    });\n\n    this.sceneExplorer.registerScene({\n      sceneId: 'county_office',\n      hotspots: [\n        { id: 'hs_desk', x: 400, y: 200, w: 150, h: 100, label: '县令书案', examined: false, action: 'examine' },\n        { id: 'hs_log', x: 600, y: 350, w: 80, h: 50, label: '巡夜记录', examined: false, action: 'pickup', giveEvidence: 'night_watch_log' },\n      ],\n    });\n\n    // Interrogation NPCs\n    this.interrogationSystem.registerNPC({ id: 'liu_qiniang', name: '刘七娘', defaultPressure: 20, maxPressure: 100 });\n    this.interrogationSystem.registerNPC({ id: 'zhang_tieshou', name: '张铁手', defaultPressure: 35, maxPressure: 100 });\n\n    this.interrogationSystem.registerTopics([\n      { id: 't_liu_1', npcId: 'liu_qiniang', label: '案发当晚行踪', dialogueId: 'interrog_liu_1', repeatable: false },\n      { id: 't_liu_2', npcId: 'liu_qiniang', label: '东市见闻', dialogueId: 'interrog_liu_2', repeatable: false, pressureRange: { min: 30, max: 100 } },\n      { id: 't_liu_3', npcId: 'liu_qiniang', label: '关于碎玉佩', dialogueId: 'interrog_liu_3', repeatable: false, requiresEvidence: ['broken_jade'] },\n      { id: 't_zhang_1', npcId: 'zhang_tieshou', label: '当晚巡逻情况', dialogueId: 'interrog_zhang_1', repeatable: false },\n      { id: 't_zhang_2', npcId: 'zhang_tieshou', label: '可疑人物', dialogueId: 'interrog_zhang_2', repeatable: false, requiresEvidence: ['night_watch_log'] },\n    ]);\n\n    // Combination recipes\n    this.evidenceCombiner.registerRecipes([\n      { id: 'recipe_1', inputs: ['broken_jade', 'blood_cloth'], output: 'jade_cloth_bundle', outputName: '玉佩与血衣', outputDescription: '碎玉佩与血衣碎片放在一起，血迹的位置恰好对应玉佩上的裂纹——这是案发现场的关键关联。', outputCategory: 'key' },\n    ]);\n\n    // Hotspot action callback\n    this.sceneExplorer.setActionCallback((hs) => {\n      if (hs.action === 'talk' && hs.dialogueId) {\n        this.dialogueEngine.start(hs.dialogueId);\n      }\n    });\n  }\n\n  private setupInput() {\n    this.input.onClick((e) => {\n      if (e.type !== 'up') return;\n      this.handleClick(e.x, e.y);\n    });\n  }\n\n  private handleClick(x: number, y: number) {\n    switch (this.currentScreen) {\n      case 'main_menu': this.handleMenuClick(x, y); break;\n      case 'dialogue': this.handleDialogueClick(x, y); break;\n      case 'settings': this.handleSettingsClick(x, y); break;\n      case 'save_load': this.handleSaveLoadClick(x, y); break;\n      case 'explore': this.handleExploreClick(x, y); break;\n      case 'interrogation': break;\n      case 'evidence': break;\n      case 'combine': break;\n    }\n  }\n\n  resize(w: number, h: number) {}\n\n  update(dt: number) {\n    this.state.playTime += dt;\n    this.sceneExplorer.update(dt);\n    this.evidenceCollector.update(dt);\n    this.interrogationSystem.update(dt);\n    this.evidenceCombiner.update(dt);\n  }\n\n  render() {\n    switch (this.currentScreen) {\n      case 'main_menu': this.renderMainMenu(); break;\n      case 'game': this.renderGameHUD(); break;\n      case 'dialogue': this.renderDialogueUI(); break;\n      case 'settings': this.renderSettings(); break;\n      case 'save_load': this.renderSaveLoad(); break;\n      case 'explore': this.renderExploreScreen(); break;\n      case 'interrogation': this.renderInterrogationScreen(); break;\n      case 'evidence': this.renderEvidenceScreen(); break;\n      case 'combine': this.renderCombineScreen(); break;\n    }\n  }\n\n  // ── Main Menu ──\n\n  private menuItems = [\n    { label: '开始游戏', action: () => this.startGame() },\n    { label: '继续游戏', action: () => this.showScreen('save_load') },\n    { label: '设置', action: () => this.showScreen('settings') },\n  ];\n\n  private renderMainMenu() {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0, '#0d0808');\n    grad.addColorStop(0.5, '#1a0a0a');\n    grad.addColorStop(1, '#0d0808');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n\n    ctx.save();\n    ctx.globalAlpha = 0.05;\n    for (let i = 0; i < 5; i++) {\n      const cx = w * 0.3 + Math.sin(i * 1.7) * w * 0.2;\n      const cy = h * 0.4 + Math.cos(i * 2.3) * h * 0.15;\n      const r = 80 + i * 30;\n      const g2 = ctx.createRadialGradient(cx, cy, 0, cx, cy, r);\n      g2.addColorStop(0, '#8b0000');\n      g2.addColorStop(1, 'transparent');\n      ctx.fillStyle = g2;\n      ctx.fillRect(0, 0, w, h);\n    }\n    ctx.restore();\n\n    this.renderer.drawText('长 安 诡 案 录', w / 2, h * 0.22, {\n      font: 'bold 64px \"SimSun\", \"Noto Serif SC\", serif',\n      color: '#c8a882',\n      align: 'center',\n    });\n    this.renderer.drawText('Records of Chang\\'an Anomalies', w / 2, h * 0.32, {\n      font: '20px \"Georgia\", serif',\n      color: '#8a7a6a',\n      align: 'center',\n    });\n\n    ctx.strokeStyle = '#4a3020';\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    ctx.moveTo(w * 0.3, h * 0.40);\n    ctx.lineTo(w * 0.7, h * 0.40);\n    ctx.stroke();\n\n    this.menuItems.forEach((item, i) => {\n      const y = h * 0.50 + i * 60;\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, w * 0.35, y - 20, w * 0.3, 45);\n      const color = isHover ? '#e8c8a2' : '#a08870';\n\n      if (isHover) {\n        ctx.save();\n        ctx.globalAlpha = 0.15;\n        ctx.fillStyle = '#4a3020';\n        ctx.fillRect(w * 0.35, y - 20, w * 0.3, 45);\n        ctx.restore();\n      }\n\n      this.renderer.drawText(item.label, w / 2, y, {\n        font: '28px \"SimSun\", \"Noto Serif SC\", serif',\n        color,\n        align: 'center',\n      });\n    });\n\n    this.renderer.drawText('v0.2.0 - M2 调查系统', w / 2, h * 0.92, {\n      font: '14px sans-serif', color: '#4a3a2a', align: 'center',\n    });\n  }\n\n  private handleMenuClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    this.menuItems.forEach((item, i) => {\n      const iy = h * 0.50 + i * 60;\n      if (this.isInRect(x, y, w * 0.35, iy - 20, w * 0.3, 45)) {\n        item.action();\n      }\n    });\n  }\n\n  // ── Dialogue UI ──\n\n  private startGame() {\n    this.showScreen('dialogue');\n    this.sceneManager.switchTo('county_office', true);\n    this.dialogueEngine.start('intro_1', () => {\n      this.showScreen('game');\n    });\n  }\n\n  private renderDialogueUI() {\n    this.renderGameHUD();\n    if (!this.dialogueEngine.getIsActive()) return;\n\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    const boxH = 200;\n    const boxY = h - boxH - 20;\n    const boxX = 40;\n    const boxW = w - 80;\n\n    ctx.save();\n    ctx.globalAlpha = 0.92;\n    this.renderer.drawRoundRect(boxX, boxY, boxW, boxH, 8, '#1a140e', '#3a2a1a');\n    ctx.restore();\n\n    ctx.strokeStyle = '#5a4030';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    const m = 6;\n    ctx.roundRect(boxX + m, boxY + m, boxW - m * 2, boxH - m * 2, 4);\n    ctx.stroke();\n\n    const speaker = this.dialogueEngine.getSpeaker();\n    if (speaker) {\n      const spW = ctx.measureText(speaker).width || speaker.length * 28;\n      this.renderer.drawRoundRect(boxX + 20, boxY - 18, spW + 40, 36, 6, '#2a1a0e', '#5a4030');\n      this.renderer.drawText(speaker, boxX + 40, boxY - 10, {\n        font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2',\n      });\n    }\n\n    const text = this.dialogueEngine.getDisplayText();\n    this.renderWrappedText(text, boxX + 30, boxY + 30, boxW - 60, boxH - 60, {\n      font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0',\n    });\n\n    if (!this.dialogueEngine.getIsTyping()) {\n      const choices = this.dialogueEngine.getChoices();\n      if (choices.length > 0) {\n        choices.forEach((c, i) => {\n          const cy = boxY + boxH + 15 + i * 48;\n          const cx = boxX + 30;\n          const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, cx, cy - 5, boxW - 60, 38);\n\n          if (isHover) {\n            ctx.save();\n            ctx.globalAlpha = 0.3;\n            this.renderer.drawRoundRect(cx, cy - 5, boxW - 60, 38, 4, '#3a2a1a');\n            ctx.restore();\n          }\n\n          this.renderer.drawText(`▸ ${c.text}`, cx + 10, cy + 3, {\n            font: '20px \"SimSun\", \"Noto Serif SC\", serif',\n            color: isHover ? '#f0d8b0' : '#b8a890',\n          });\n        });\n      } else {\n        const blinkAlpha = 0.4 + Math.sin(Date.now() * 0.005) * 0.3;\n        this.renderer.drawText('▼', boxX + boxW - 40, boxY + boxH - 40, {\n          font: '18px sans-serif', color: '#8a7a6a', alpha: blinkAlpha,\n        });\n      }\n    }\n  }\n\n  private handleDialogueClick(x: number, y: number) {\n    if (!this.dialogueEngine.getIsActive()) return;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    const boxH = 200;\n    const boxY = h - boxH - 20;\n    const boxX = 40;\n    const boxW = w - 80;\n\n    if (this.dialogueEngine.getIsTyping()) {\n      this.dialogueEngine.advance();\n      return;\n    }\n\n    const choices = this.dialogueEngine.getChoices();\n    if (choices.length > 0) {\n      choices.forEach((c, i) => {\n        const cy = boxY + boxH + 15 + i * 48;\n        if (this.isInRect(x, y, boxX + 30, cy - 5, boxW - 60, 38)) {\n          this.dialogueEngine.selectChoice(i);\n        }\n      });\n    } else {\n      if (this.isInRect(x, y, boxX, boxY, boxW, boxH)) {\n        this.dialogueEngine.advance();\n      }\n    }\n  }\n\n  // ── Settings ──\n\n  private settingsItems = [\n    { label: '文字速度', key: 'textSpeed', min: 10, max: 80 },\n    { label: '主音量', key: 'master', min: 0, max: 100 },\n    { label: '音乐音量', key: 'bgm', min: 0, max: 100 },\n    { label: '音效音量', key: 'sfx', min: 0, max: 100 },\n  ];\n\n  private renderSettings() {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.fillStyle = 'rgba(10, 8, 6, 0.95)';\n    ctx.fillRect(0, 0, w, h);\n\n    this.renderer.drawText('设  置', w / 2, h * 0.12, {\n      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif',\n      color: '#c8a882', align: 'center',\n    });\n\n    this.settingsItems.forEach((item, i) => {\n      const y = h * 0.30 + i * 70;\n      this.renderer.drawText(item.label, w * 0.25, y, {\n        font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870',\n      });\n\n      const barX = w * 0.45;\n      const barW = w * 0.30;\n      const barH = 8;\n      ctx.fillStyle = '#2a1a0e';\n      ctx.fillRect(barX, y + 8, barW, barH);\n\n      const val = item.key === 'textSpeed'\n        ? (this.state.settings.textSpeed - item.min) / (item.max - item.min)\n        : (this.state.settings.volume[item.key as keyof typeof this.state.settings.volume] ?? 0.8);\n      ctx.fillStyle = '#8b4513';\n      ctx.fillRect(barX, y + 8, barW * val, barH);\n\n      const knobX = barX + barW * val;\n      ctx.fillStyle = '#c8a882';\n      ctx.beginPath();\n      ctx.arc(knobX, y + 12, 8, 0, Math.PI * 2);\n      ctx.fill();\n    });\n\n    this.renderBackButton(w, h);\n  }\n\n  private handleSettingsClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    if (this.isInRect(x, y, w * 0.35, h * 0.85, w * 0.3, 45)) {\n      this.showScreen('main_menu');\n    }\n  }\n\n  // ── Save/Load ──\n\n  private renderSaveLoad() {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.fillStyle = 'rgba(10, 8, 6, 0.95)';\n    ctx.fillRect(0, 0, w, h);\n\n    this.renderer.drawText('存  档', w / 2, h * 0.08, {\n      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif',\n      color: '#c8a882', align: 'center',\n    });\n\n    for (let i = 0; i < 6; i++) {\n      const col = i % 3;\n      const row = Math.floor(i / 3);\n      const sx = w * 0.12 + col * (w * 0.28);\n      const sy = h * 0.18 + row * (h * 0.32);\n      const sw = w * 0.25;\n      const sh = h * 0.26;\n\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, sx, sy, sw, sh);\n\n      ctx.save();\n      ctx.globalAlpha = isHover ? 0.9 : 0.7;\n      this.renderer.drawRoundRect(sx, sy, sw, sh, 6, '#1a140e', isHover ? '#6a5040' : '#3a2a1a');\n      ctx.restore();\n\n      this.renderer.drawText(`存档 ${i + 1}`, sx + 15, sy + 15, {\n        font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870',\n      });\n      this.renderer.drawText('空', sx + sw / 2, sy + sh / 2 - 10, {\n        font: '24px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n      });\n    }\n\n    this.renderBackButton(w, h);\n  }\n\n  private handleSaveLoadClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    if (this.isInRect(x, y, w * 0.35, h * 0.85, w * 0.3, 45)) {\n      this.showScreen('main_menu');\n    }\n  }\n\n  // ── M2 Screens ──\n\n  private renderExploreScreen() {\n    this.sceneExplorer.render();\n    this.renderM2Toolbar();\n  }\n\n  private handleExploreClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    this.handleM2ToolbarClick(x, y);\n  }\n\n  private renderInterrogationScreen() {\n    this.interrogationSystem.render();\n    this.renderM2Toolbar();\n  }\n\n  private renderEvidenceScreen() {\n    this.evidenceCollector.render();\n  }\n\n  private renderCombineScreen() {\n    this.evidenceCombiner.render();\n  }\n\n  private renderM2Toolbar() {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    const toolbarY = h - 60;\n    ctx.save();\n    ctx.globalAlpha = 0.85;\n    ctx.fillStyle = '#0e0a08';\n    ctx.fillRect(0, toolbarY, w, 60);\n    ctx.strokeStyle = '#3a2a1a';\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    ctx.moveTo(0, toolbarY);\n    ctx.lineTo(w, toolbarY);\n    ctx.stroke();\n    ctx.restore();\n\n    const buttons = [\n      { label: '探索', screen: 'explore' as UIScreen, x: w * 0.1 },\n      { label: '审问', screen: 'interrogation' as UIScreen, x: w * 0.3 },\n      { label: '物证', screen: 'evidence' as UIScreen, x: w * 0.5 },\n      { label: '组合', screen: 'combine' as UIScreen, x: w * 0.7 },\n      { label: '返回', screen: 'game' as UIScreen, x: w * 0.9 },\n    ];\n\n    buttons.forEach((btn) => {\n      const isActive = this.currentScreen === btn.screen;\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, btn.x - 40, toolbarY + 10, 80, 40);\n\n      if (isActive) {\n        ctx.fillStyle = 'rgba(200, 168, 130, 0.15)';\n        ctx.fillRect(btn.x - 40, toolbarY + 10, 80, 40);\n      } else if (isHover) {\n        ctx.fillStyle = 'rgba(200, 168, 130, 0.07)';\n        ctx.fillRect(btn.x - 40, toolbarY + 10, 80, 40);\n      }\n\n      this.renderer.drawText(btn.label, btn.x, toolbarY + 20, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n        color: isActive ? '#e8c8a2' : isHover ? '#c8a882' : '#8a7a6a',\n        align: 'center',\n      });\n    });\n  }\n\n  private handleM2ToolbarClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    const toolbarY = h - 60;\n    if (y < toolbarY) return;\n\n    const buttons: { screen: UIScreen; x: number }[] = [\n      { screen: 'explore', x: w * 0.1 },\n      { screen: 'interrogation', x: w * 0.3 },\n      { screen: 'evidence', x: w * 0.5 },\n      { screen: 'combine', x: w * 0.7 },\n      { screen: 'game', x: w * 0.9 },\n    ];\n\n    for (const btn of buttons) {\n      if (this.isInRect(x, y, btn.x - 40, toolbarY + 10, 80, 40)) {\n        if (btn.screen === 'explore') {\n          this.sceneExplorer.activate(this.state.scene);\n        }\n        if (btn.screen === 'interrogation') {\n          const firstNPC = 'liu_qiniang';\n          this.interrogationSystem.startInterrogation(firstNPC);\n        }\n        if (btn.screen === 'evidence') {\n          this.evidenceCollector.open();\n        }\n        if (btn.screen === 'combine') {\n          this.evidenceCombiner.open();\n        }\n        this.showScreen(btn.screen);\n        return;\n      }\n    }\n  }\n\n  // ── Game HUD ──\n\n  private renderGameHUD() {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.save();\n    ctx.globalAlpha = 0.5;\n    ctx.fillStyle = '#c8a882';\n    ctx.font = '14px sans-serif';\n    ctx.fillText(`第${this.state.chapter}章 | ${this.state.scene}`, 15, 20);\n    ctx.restore();\n\n    this.renderM2Toolbar();\n  }\n\n  // ── Helpers ──\n\n  private renderWrappedText(text: string, x: number, y: number, maxW: number, maxH: number,\n    opts: { font?: string; color?: string }) {\n    const ctx = this.renderer.context;\n    ctx.save();\n    ctx.font = opts.font ?? '20px \"SimSun\", \"Noto Serif SC\", serif';\n    ctx.fillStyle = opts.color ?? '#d8c8b0';\n\n    let lineY = y;\n    let line = '';\n    for (const ch of text) {\n      const test = line + ch;\n      if (ctx.measureText(test).width > maxW) {\n        ctx.fillText(line, x, lineY);\n        line = ch;\n        lineY += 28;\n        if (lineY - y > maxH) break;\n      } else {\n        line = test;\n      }\n    }\n    if (line) ctx.fillText(line, x, lineY);\n    ctx.restore();\n  }\n\n  private renderBackButton(w: number, h: number) {\n    const bx = w * 0.35;\n    const by = h * 0.85;\n    const bw = w * 0.3;\n    const bh = 45;\n    const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, bx, by, bw, bh);\n\n    ctx: this.renderer.drawRoundRect(bx, by, bw, bh, 6,\n      isHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('返回', w / 2, by + 12, {\n      font: '24px \"SimSun\", \"Noto Serif SC\", serif',\n      color: isHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n  }\n\n  private showScreen(screen: UIScreen) { this.currentScreen = screen; }\n\n  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n  }\n}\n","numLines":633,"startLine":1,"totalLines":633}}}
{"type":"assistant","message":{"id":"msg_2026052401343343081b50ac284d97","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"thinking","thinking":"Now I have a thorough understanding of the codebase. Let me plan and implement the 4 M3 modules:\n\n1. **ReasoningBoard** - Visual evidence connection, reasoning chains, contradiction marking\n2. **TrialLoop** - Complete trial flow: opening statement → evidence presentation → objection → verdict\n3. **ObjectionSystem** - Player objects to witness testimony and presents evidence to refute\n4. **CredibilityScore** - Reputation system\n\nLet me also check the SceneManager to understand how it works.\n\nKey patterns from existing code:\n- Classes take `Renderer`, `GameState`, `InputManager` as constructor dependencies\n- Canvas-based rendering with water-ink (水墨) style colors: dark backgrounds, gold/brown tones\n- Input handling via InputManager's onClick\n- UI uses drawRoundRect, drawText from Renderer\n- State tracked in class fields, animations with animAlpha + dt\n- UIManager in UIScreen type union manages screens\n\nLet me implement all 4 modules now, then update the UIManager, App, and package.json.\n\nFor the ReasoningBoard:\n- Visual board with evidence nodes\n- Draggable connections between nodes (bezier curves)\n- Contradiction detection\n- Completeness tracking\n\nFor the TrialLoop:\n- FSM: opening → testimony → cross_examine → rebuttal → verdict\n- Multiple witnesses per trial\n- Integration with ObjectionSystem and CredibilityScore\n\nFor the ObjectionSystem:\n- Listen to testimony lines\n- Player can raise \"异议!\" and select evidence\n- Correct/incorrect objection logic\n\nFor the CredibilityScore:\n- Start at 100, decrease on wrong objections, increase on correct ones\n- Affects NPC reactions and trial outcome\n- Visual indicator\n\nLet me implement them now.","signature":""}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"b5a5daaf-c8fd-4523-92be-b3ba2de361bf","uuid":"816b8317-f7e8-42e9-9faa-f542bfcb9670"}
