n page...');\n  await page.goto(`https://developer.open-douyin.com/console/miniapp/${APPID}`, {\n    waitUntil: 'load',\n    timeout: 30000,\n  });\n  await page.waitForTimeout(5000);\n\n  let url = page.url();\n  console.log('URL:', url);\n  await page.screenshot({ path: 'D:/games/match3-xiaoxiaoxiao/console_main.png', fullPage: true });\n\n  // Try to find links in the page\n  const links = await page.$$eval('a[href]', els =>\n    els.map(e => ({ text: e.textContent?.trim()?.substring(0, 40), href: e.href }))\n      .filter(l => l.href.includes('miniapp') || l.href.includes('version') || l.href.includes('upload'))\n  );\n  console.log('Relevant links:', JSON.stringify(links, null, 2));\n\n  // Try the old-format console URL\n  console.log('\\nTrying old-format miniapp page...');\n  await page.goto(`https://developer.open-douyin.com/console/miniapp/${APPID}/basic-config`, {\n    waitUntil: 'load',\n    timeout: 30000,\n  });\n  await page.waitForTimeout(3000);\n  url = page.url();\n  console.log('URL:', url);\n  await page.screenshot({ path: 'D:/games/match3-xiaoxiaoxiao/console_basic.png', fullPage: true });\n\n  // Check body text\n  const bodyText2 = await page.$eval('body', el => el.textContent?.substring(0, 500));\n  console.log('Body text:', bodyText2);\n\n  // Log captured API responses\n  console.log('\\n--- API Responses ---');\n  for (const r of apiResponses.slice(0, 10)) {\n    console.log(r.url, '->', r.status, r.body.substring(0, 200));\n  }\n\n  await browser.close();\n}\n\nmain().catch(err => {\n  console.error('Error:', err.message);\n  process.exit(1);\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
