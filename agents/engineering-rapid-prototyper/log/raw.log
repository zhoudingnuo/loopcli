{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_28b3f36248fa46c684943529","type":"tool_result","content":"1\t/**\n2\t * 消消消大作战 - Match-3 Game for Douyin Mini-Game Platform\n3\t * Entry point and game state machine.\n4\t */\n5\t\n6\tconst adapter = require('./adapter/index');\n7\tconst config = require('./js/config');\n8\tconst { easeOutQuad, easeOutBounce } = require('./js/utils');\n9\tconst Board = require('./js/board');\n10\tconst Renderer = require('./js/renderer');\n11\tconst InputHandler = require('./js/input');\n12\tconst AnimationManager = require('./js/animation');\n13\tconst ScoreManager = require('./js/score-manager');\n14\t\n15\t// --- Layout calculation ---\n16\tfunction calcLayout(screenW, screenH) {\n17\t  const topBarH = config.TOP_BAR_HEIGHT;\n18\t  const bottomBarH = config.BOTTOM_BAR_HEIGHT;\n19\t  const availH = screenH - topBarH - bottomBarH;\n20\t  const availW = screenW - 32; // 16px margin each side\n21\t\n22\t  const cellGap = config.CELL_GAP;\n23\t  const maxCellW = (availW - cellGap * (config.GRID_SIZE - 1)) / config.GRID_SIZE;\n24\t  const maxCellH = (availH - cellGap * (config.GRID_SIZE - 1) - 20) / config.GRID_SIZE;\n25\t  const cellSize = Math.floor(Math.min(maxCellW, maxCellH));\n26\t\n27\t  const boardW = cellSize * config.GRID_SIZE + cellGap * (config.GRID_SIZE - 1);\n28\t  const boardH = boardW;\n29\t  const boardX = (screenW - boardW) / 2;\n30\t  const boardY = topBarH + (availH - boardH) / 2;\n31\t\n32\t  return {\n33\t    x: boardX,\n34\t    y: boardY,\n35\t    width: boardW,\n36\t    height: boardH,\n37\t    cellSize,\n38\t    topBarHeight: topBarH,\n39\t    bottomBarHeight: bottomBarH,\n40\t  };\n41\t}\n42\t\n43\t// --- Game ---\n44\tclass Game {\n45\t  constructor() {\n46\t    const sysInfo = adapter.getSystemInfo();\n47\t    const dpr = sysInfo.pixelRatio || 1;\n48\t    const screenW = sysInfo.windowWidth;\n49\t    const screenH = sysInfo.windowHeight;\n50\t\n51\t    this.canvas = adapter.createCanvas();\n52\t    this.canvas.width = screenW * dpr;\n53\t    this.canvas.height = screenH * dpr;\n54\t    const ctx = this.canvas.getContext('2d');\n55\t    ctx.scale(dpr, dpr);\n56\t    this.screenW = screenW;\n57\t    this.screenH = screenH;\n58\t\n59\t    this.layout = calcLayout(screenW, screenH);\n60\t    this.board = new Board();\n61\t    this.renderer = new Renderer(this.canvas, this.layout);\n62\t    this.input = new InputHandler(this.layout);\n63\t    this.anim = new AnimationManager();\n64\t    this.score = new ScoreManager();\n65\t    this.state = 'idle'; // idle, swapping, removing, falling, gameover, levelcomplete\n66\t\n67\t    this._bindEvents();\n68\t    this._lastTime = Date.now();\n69\t    this._loop();\n70\t  }\n71\t\n72\t  _bindEvents() {\n73\t    const dpr = (adapter.getSystemInfo().pixelRatio || 1);\n74\t\n75\t    adapter.onTouchStart((e) => {\n76\t      const touch = e.touches ? e.touches[0] : e;\n77\t      const x = touch.clientX || touch.pageX;\n78\t      const y = touch.clientY || touch.pageY;\n79\t      if (this.state === 'gameover' || this.state === 'levelcomplete') {\n80\t        this.input.handleClick(x, y);\n81\t        return;\n82\t      }\n83\t      if (this.state !== 'idle') return;\n84\t      this.input.handleTouchStart(x, y);\n85\t    });\n86\t\n87\t    adapter.onTouchMove((e) => {\n88\t      const touch = e.touches ? e.touches[0] : e;\n89\t      const x = touch.clientX || touch.pageX;\n90\t      const y = touch.clientY || touch.pageY;\n91\t      if (this.state !== 'idle') return;\n92\t      this.input.handleTouchMove(x, y);\n93\t    });\n94\t\n95\t    adapter.onTouchEnd(() => {\n96\t      this.input.handleTouchEnd();\n97\t    });\n98\t\n99\t    // Connect input callbacks\n100\t    this.input.onSelect = (cell) => {\n101\t      this.renderer.selectedCell = cell;\n102\t      if (cell) adapter.vibrateShort();\n103\t    };\n104\t\n105\t    this.input.onSwap = (r1, c1, r2, c2) => {\n106\t      this._trySwap(r1, c1, r2, c2);\n107\t    };\n108\t\n109\t    this.input.onBtnClick = (x, y) => {\n110\t      if (this.state === 'gameover') {\n111\t        const btn = this.renderer.retryBtn;\n112\t        if (btn && x >= btn.x && x <= btn.x + btn.w && y >= btn.y && y <= btn.y + btn.h) {\n113\t          this._restart();\n114\t        }\n115\t      }\n116\t      if (this.state === 'levelcomplete') {\n117\t        const btn = this.renderer.nextBtn;\n118\t        if (btn && x >= btn.x && x <= btn.x + btn.w && y >= btn.y && y <= btn.y + btn.h) {\n119\t          this._nextLevel();\n120\t        }\n121\t      }\n122\t      // Bottom bar restart\n123\t      const rbtn = this.renderer.restartBtn;\n124\t      if (rbtn && x >= rbtn.x && x <= rbtn.x + rbtn.w && y >= rbtn.y && y <= rbtn.y + rbtn.h) {\n125\t        this._restart();\n126\t      }\n127\t    };\n128\t  }\n129\t\n130\t  _trySwap(r1, c1, r2, c2) {\n131\t    adapter.vibrateShort();\n132\t    this.state = 'swapping';\n133\t    const { cellSize } = this.layout;\n134\t\n135\t    // Animate swap\n136\t    const dx = (c2 - c1) * (cellSize + config.CELL_GAP);\n137\t    const dy = (r2 - r1) * (cellSize + config.CELL_GAP);\n138\t\n139\t    this.anim.add(150, (t) => {\n140\t      const e = easeOutQuad(t);\n141\t      this.renderer.setPieceOffset(r1, c1, dx * e, dy * e);\n142\t      this.renderer.setPieceOffset(r2, c2, -dx * e, -dy * e);\n143\t    }, () => {\n144\t      this.renderer.clearPieceOffset(r1, c1);\n145\t      this.renderer.clearPieceOffset(r2, c2);\n146\t      this.board.swap(r1, c1, r2, c2);\n147\t\n148\t      const matches = this.board.findMatches();\n149\t      if (matches.length === 0) {\n150\t        // Swap back\n151\t        this.anim.add(150, (t) => {\n152\t          const e = easeOutQuad(t);\n153\t          this.renderer.setPieceOffset(r1, c1, -dx * e, -dy * e);\n154\t          this.renderer.setPieceOffset(r2, c2, dx * e, dy * e);\n155\t        }, () => {\n156\t          this.renderer.clearPieceOffset(r1, c1);\n157\t          this.renderer.clearPieceOffset(r2, c2);\n158\t          this.board.swap(r1, c1, r2, c2);\n159\t          this.state = 'idle';\n160\t        });\n161\t      } else {\n162\t        this.score.useMove();\n163\t        this.score.startCombo();\n164\t        this._processMatches();\n165\t      }\n166\t    });\n167\t  }\n168\t\n169\t  _processMatches() {\n170\t    const matches = this.board.findMatches();\n171\t    if (matches.length === 0) {\n172\t      // Check for more moves\n173\t      if (!this.board.hasValidMoves()) {\n174\t        this.board.shuffle();\n175\t      }\n176\t      if (this.score.isLevelComplete()) {\n177\t        this.state = 'levelcomplete';\n178\t        this.score.saveBest();\n179\t      } else if (this.score.isGameOver()) {\n180\t        this.state = 'gameover';\n181\t        this.score.saveBest();\n182\t      } else {\n183\t        this.state = 'idle';\n184\t      }\n185\t      return;\n186\t    }\n187\t\n188\t    const combo = this.score.incrementCombo();\n189\t    this.renderer.setComboText(combo);\n190\t    this.renderer.screenShake = 1.5;\n191\t\n192\t    // Calculate match lengths for scoring\n193\t    const matchGroups = this._groupMatches(matches);\n194\t    let totalScore = 0;\n195\t    for (const group of matchGroups) {\n196\t      const pts = this.score.addScore(group.length);\n197\t      totalScore += pts;\n198\t      // Show score popup at center of match group\n199\t      const avgR = group.reduce((s, m) => s + m.r, 0) / group.length;\n200\t      const avgC = group.reduce((s, m) => s + m.c, 0) / group.length;\n201\t      this.renderer.addScorePopup(avgR, avgC, pts);\n202\t    }\n203\t\n204\t    // Animate removal\n205\t    this.state = 'removing';\n206\t    const toRemove = this.board.removeMatches(matches);\n207\t\n208\t    for (const { r, c, type } of toRemove) {\n209\t      this.renderer.addParticles(r, c, type);\n210\t    }\n211\t\n212\t    this.anim.add(200, (t) => {\n213\t      for (const { r, c } of toRemove) {\n214\t        this.renderer.setPieceScale(r, c, 1 - easeOutQuad(t));\n215\t      }\n216\t    }, () => {\n217\t      for (const { r, c } of toRemove) {\n218\t        this.renderer.clearPieceScale(r, c);\n219\t      }\n220\t      this._applyGravity();\n221\t    });\n222\t  }\n223\t\n224\t  _groupMatches(matches) {\n225\t    // Simple: treat all matches in one pass as a single group per connected component\n226\t    const set = new Set(matches.map(m => m.r + ',' + m.c));\n227\t    const visited = new Set();\n228\t    const groups = [];\n229\t\n230\t    for (const m of matches) {\n231\t      const key = m.r + ',' + m.c;\n232\t      if (visited.has(key)) continue;\n233\t      const group = [];\n234\t      const queue = [m];\n235\t      while (queue.length > 0) {\n236\t        const cur = queue.pop();\n237\t        const ck = cur.r + ',' + cur.c;\n238\t        if (visited.has(ck)) continue;\n239\t        visited.add(ck);\n240\t        group.push(cur);\n241\t        for (const [dr, dc] of [[0,1],[0,-1],[1,0],[-1,0]]) {\n242\t          const nk = (cur.r + dr) + ',' + (cur.c + dc);\n243\t          if (set.has(nk) && !visited.has(nk)) {\n244\t            queue.push({ r: cur.r + dr, c: cur.c + dc });\n245\t          }\n246\t        }\n247\t      }\n248\t      groups.push(group);\n249\t    }\n250\t    return groups;\n251\t  }\n252\t\n253\t  _applyGravity() {\n254\t    this.state = 'falling';\n255\t    const moves = this.board.applyGravity();\n256\t    const spawns = this.board.refill();\n257\t    const { cellSize } = this.layout;\n258\t    const allMoves = [...moves];\n259\t\n260\t    if (allMoves.length === 0 && spawns.length === 0) {\n261\t      this._processMatches();\n262\t      return;\n263\t    }\n264\t\n265\t    // Combine gravity moves and spawns\n266\t    const allAnims = [];\n267\t    for (const m of moves) {\n268\t      allAnims.push({\n269\t        r: m.toR, c: m.toC,\n270\t        fromDy: (m.fromR - m.toR) * (cellSize + config.CELL_GAP),\n271\t      });\n272\t    }\n273\t    for (const s of spawns) {\n274\t      allAnims.push({\n275\t        r: s.r, c: s.c,\n276\t        fromDy: (s.fromR - s.r) * (cellSize + config.CELL_GAP),\n277\t      });\n278\t    }\n279\t\n280\t    this.anim.add(300, (t) => {\n281\t      const e = easeOutBounce(t);\n282\t      for (const a of allAnims) {\n283\t        this.renderer.setPieceOffset(a.r, a.c, 0, a.fromDy * (1 - e));\n284\t      }\n285\t    }, () => {\n286\t      for (const a of allAnims) {\n287\t        this.renderer.clearPieceOffset(a.r, a.c);\n288\t      }\n289\t      this._processMatches();\n290\t    });\n291\t  }\n292\t\n293\t  _restart() {\n294\t    this.board.init();\n295\t    this.score.reset();\n296\t    this.anim.clear();\n297\t    this.renderer.particles = [];\n298\t    this.renderer.scorePopups = [];\n299\t    this.renderer.comboText = null;\n300\t    this.renderer.screenShake = 0;\n301\t    this.renderer.pieceOffset = {};\n302\t    this.renderer.pieceScale = {};\n303\t    this.input.reset();\n304\t    this.state = 'idle';\n305\t  }\n306\t\n307\t  _nextLevel() {\n308\t    this.score.nextLevel();\n309\t    this.board.init();\n310\t    this.anim.clear();\n311\t    this.renderer.particles = [];\n312\t    this.renderer.scorePopups = [];\n313\t    this.renderer.comboText = null;\n314\t    this.renderer.screenShake = 0;\n315\t    this.renderer.pieceOffset = {};\n316\t    this.renderer.pieceScale = {};\n317\t    this.input.reset();\n318\t    this.state = 'idle';\n319\t  }\n320\t\n321\t  _loop() {\n322\t    const now = Date.now();\n323\t    const dt = Math.min((now - this._lastTime) / 1000, 0.1);\n324\t    this._lastTime = now;\n325\t\n326\t    this.anim.update(dt * 1000);\n327\t    this.renderer.updateEffects(dt);\n328\t\n329\t    // Draw\n330\t    const r = this.renderer;\n331\t    r.clear();\n332\t    r.drawBackground();\n333\t    r.drawTopBar(this.score.score, this.score.level, this.score.movesLeft, this.score.targetScore);\n334\t    r.drawBoard();\n335\t    r.drawPieces(this.board);\n336\t    r.drawEffects();\n337\t    r.drawBottomBar(() => this._restart());\n338\t\n339\t    if (this.state === 'gameover') {\n340\t      r.drawGameOver(this.score.score, this.score.level, this.score.bestScore);\n341\t    }\n342\t    if (this.state === 'levelcomplete') {\n343\t      r.drawLevelComplete(this.score.score, this.score.level, this.score.bestScore);\n344\t    }\n345\t\n346\t    requestAnimationFrame(() => this._loop());\n347\t  }\n348\t}\n349\t\n350\t// --- Bootstrap ---\n351\tnew Game();\n352\t"}]},"parent_tool_use_id":null,"session_id":"b40e9963-6d9c-4ef1-96a5-70dd29359e7e","uuid":"a73abc7f-39c1-4898-b441-6d899b4bbac0","timestamp":"2026-05-23T18:21:37.758Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\games\\match3-xiaoxiaoxiao\\game.js","content":"/**\n * 消消消大作战 - Match-3 Game for Douyin Mini-Game Platform\n * Entry point and game state machine.\n */\n\nconst adapter = require('./adapter/index');\nconst config = require('./js/config');\nconst { easeOutQuad, easeOutBounce } = require('./js/utils');\nconst Board = require('./js/board');\nconst Renderer = require('./js/renderer');\nconst InputHandler = require('./js/input');\nconst AnimationManager = require('./js/animation');\nconst ScoreManager = require('./js/score-manager');\n\n// --- Layout calculation ---\nfunction calcLayout(screenW, screenH) {\n  const topBarH = config.TOP_BAR_HEIGHT;\n  const bottomBarH = config.BOTTOM_BAR_HEIGHT;\n  const availH = screenH - topBarH - bottomBarH;\n  const availW = screenW - 32; // 16px margin each side\n\n  const cellGap = config.CELL_GAP;\n  const maxCellW = (availW - cellGap * (config.GRID_SIZE - 1)) / config.GRID_SIZE;\n  const maxCellH = (availH - cellGap * (config.GRID_SIZE - 1) - 20) / config.GRID_SIZE;\n  const cellSize = Math.floor(Math.min(maxCellW, maxCellH));\n\n  const boardW = cellSize * config.GRID_SIZE + cellGap * (config.GRID_SIZE - 1);\n  const boardH = boardW;\n  const boardX = (screenW - boardW) / 2;\n  const boardY = topBarH + (availH - boardH) / 2;\n\n  return {\n    x: boardX,\n    y: boardY,\n    width: boardW,\n    height: boardH,\n    cellSize,\n    topBarHeight: topBarH,\n    bottomBarHeight: bottomBarH,\n  };\n}\n\n// --- Game ---\nclass Game {\n  constructor() {\n    const sysInfo = adapter.getSystemInfo();\n    const dpr = sysInfo.pixelRatio || 1;\n    const screenW = sysInfo.windowWidth;\n    const screenH = sysInfo.windowHeight;\n\n    this.canvas = adapter.createCanvas();\n    this.canvas.width = screenW * dpr;\n    this.canvas.height = screenH * dpr;\n    const ctx = this.canvas.getContext('2d');\n    ctx.scale(dpr, dpr);\n    this.screenW = screenW;\n    this.screenH = screenH;\n\n    this.layout = calcLayout(screenW, screenH);\n    this.board = new Board();\n    this.renderer = new Renderer(this.canvas, this.layout);\n    this.input = new InputHandler(this.layout);\n    this.anim = new AnimationManager();\n    this.score = new ScoreManager();\n    this.state = 'idle'; // idle, swapping, removing, falling, gameover, levelcomplete\n\n    this._bindEvents();\n    this._lastTime = Date.now();\n    this._loop();\n  }\n\n  _bindEvents() {\n    const dpr = (adapter.getSystemInfo().pixelRatio || 1);\n\n    adapter.onTouchStart((e) => {\n      const touch = e.touches ? e.touches[0] : e;\n      const x = touch.clientX || touch.pageX;\n      const y = touch.clientY || touch.pageY;\n      if (this.state === 'gameover' || this.state === 'levelcomplete') {\n        this.input.handleClick(x, y);\n        return;\n      }\n      if (this.state !== 'idle') return;\n      this.input.handleTouchStart(x, y);\n    });\n\n    adapter.onTouchMove((e) => {\n      const touch = e.touches ? e.touches[0] : e;\n      const x = touch.clientX || touch.pageX;\n      const y = touch.clientY || touch.pageY;\n      if (this.state !== 'idle') return;\n      this.input.handleTouchMove(x, y);\n    });\n\n    adapter.onTouchEnd(() => {\n      this.input.handleTouchEnd();\n    });\n\n    // Connect input callbacks\n    this.input.onSelect = (cell) => {\n      this.renderer.selectedCell = cell;\n      if (cell) adapter.vibrateShort();\n    };\n\n    this.input.onSwap = (r1, c1, r2, c2) => {\n      this._trySwap(r1, c1, r2, c2);\n    };\n\n    this.input.onBtnClick = (x, y) => {\n      if (this.state === 'gameover') {\n        const btn = this.renderer.retryBtn;\n        if (btn && x >= btn.x && x <= btn.x + btn.w && y >= btn.y && y <= btn.y + btn.h) {\n          this._restart();\n        }\n      }\n      if (this.state === 'levelcomplete') {\n        const btn = this.renderer.nextBtn;\n        if (btn && x >= btn.x && x <= btn.x + btn.w && y >= btn.y && y <= btn.y + btn.h) {\n          this._nextLevel();\n        }\n      }\n      // Bottom bar restart\n      const rbtn = this.renderer.restartBtn;\n      if (rbtn && x >= rbtn.x && x <= rbtn.x + rbtn.w && y >= rbtn.y && y <= rbtn.y + rbtn.h) {\n        this._restart();\n      }\n    };\n  }\n\n  _trySwap(r1, c1, r2, c2) {\n    adapter.vibrateShort();\n    this.state = 'swapping';\n    const { cellSize } = this.layout;\n\n    // Animate swap\n    const dx = (c2 - c1) * (cellSize + config.CELL_GAP);\n    const dy = (r2 - r1) * (cellSize + config.CELL_GAP);\n\n    this.anim.add(150, (t) => {\n      const e = easeOutQuad(t);\n      this.renderer.setPieceOffset(r1, c1, dx * e, dy * e);\n      this.renderer.setPieceOffset(r2, c2, -dx * e, -dy * e);\n    }, () => {\n      this.renderer.clearPieceOffset(r1, c1);\n      this.renderer.clearPieceOffset(r2, c2);\n      this.board.swap(r1, c1, r2, c2);\n\n      const matches = this.board.findMatches();\n      if (matches.length === 0) {\n        // Swap back\n        this.anim.add(150, (t) => {\n          const e = easeOutQuad(t);\n          this.renderer.setPieceOffset(r1, c1, -dx * e, -dy * e);\n          this.renderer.setPieceOffset(r2, c2, dx * e, dy * e);\n        }, () => {\n          this.renderer.clearPieceOffset(r1, c1);\n          this.renderer.clearPieceOffset(r2, c2);\n          this.board.swap(r1, c1, r2, c2);\n          this.state = 'idle';\n        });\n      } else {\n        this.score.useMove();\n        this.score.startCombo();\n        this._processMatches();\n      }\n    });\n  }\n\n  _processMatches() {\n    const matches = this.board.findMatches();\n    if (matches.length === 0) {\n      // Check for more moves\n      if (!this.board.hasValidMoves()) {\n        this.board.shuffle();\n      }\n      if (this.score.isLevelComplete()) {\n        this.state = 'levelcomplete';\n        this.score.saveBest();\n      } else if (this.score.isGameOver()) {\n        this.state = 'gameover';\n        this.score.saveBest();\n      } else {\n        this.state = 'idle';\n      }\n      return;\n    }\n\n    const combo = this.score.incrementCombo();\n    this.renderer.setComboText(combo);\n    this.renderer.screenShake = 1.5;\n\n    // Calculate match lengths for scoring\n    const matchGroups = this._groupMatches(matches);\n    let totalScore = 0;\n    for (const group of matchGroups) {\n      const pts = this.score.addScore(group.length);\n      totalScore += pts;\n      // Show score popup at center of match group\n      const avgR = group.reduce((s, m) => s + m.r, 0) / group.length;\n      const avgC = group.reduce((s, m) => s + m.c, 0) / group.length;\n      this.renderer.addScorePopup(avgR, avgC, pts);\n    }\n\n    // Animate removal\n    this.state = 'removing';\n    const toRemove = this.board.removeMatches(matches);\n\n    for (const { r, c, type } of toRemove) {\n      this.renderer.addParticles(r, c, type);\n    }\n\n    this.anim.add(200, (t) => {\n      for (const { r, c } of toRemove) {\n        this.renderer.setPieceScale(r, c, 1 - easeOutQuad(t));\n      }\n    }, () => {\n      for (const { r, c } of toRemove) {\n        this.renderer.clearPieceScale(r, c);\n      }\n      this._applyGravity();\n    });\n  }\n\n  _groupMatches(matches) {\n    // Simple: treat all matches in one pass as a single group per connected component\n    const set = new Set(matches.map(m => m.r + ',' + m.c));\n    const visited = new Set();\n    const groups = [];\n\n    for (const m of matches) {\n      const key = m.r + ',' + m.c;\n      if (visited.has(key)) continue;\n      const group = [];\n      const queue = [m];\n      while (queue.length > 0) {\n        const cur = queue.pop();\n        const ck = cur.r + ',' + cur.c;\n        if (visited.has(ck)) continue;\n        visited.add(ck);\n        group.push(cur);\n        for (const [dr, dc] of [[0,1],[0,-1],[1,0],[-1,0]]) {\n          const nk = (cur.r + dr) + ',' + (cur.c + dc);\n          if (set.has(nk) && !visited.has(nk)) {\n            queue.push({ r: cur.r + dr, c: cur.c + dc });\n          }\n        }\n      }\n      groups.push(group);\n    }\n    return groups;\n  }\n\n  _applyGravity() {\n    this.state = 'falling';\n    const moves = this.board.applyGravity();\n    const spawns = this.board.refill();\n    const { cellSize } = this.layout;\n    const allMoves = [...moves];\n\n    if (allMoves.length === 0 && spawns.length === 0) {\n      this._processMatches();\n      return;\n    }\n\n    // Combine gravity moves and spawns\n    const allAnims = [];\n    for (const m of moves) {\n      allAnims.push({\n        r: m.toR, c: m.toC,\n        fromDy: (m.fromR - m.toR) * (cellSize + config.CELL_GAP),\n      });\n    }\n    for (const s of spawns) {\n      allAnims.push({\n        r: s.r, c: s.c,\n        fromDy: (s.fromR - s.r) * (cellSize + config.CELL_GAP),\n      });\n    }\n\n    this.anim.add(300, (t) => {\n      const e = easeOutBounce(t);\n      for (const a of allAnims) {\n        this.renderer.setPieceOffset(a.r, a.c, 0, a.fromDy * (1 - e));\n      }\n    }, () => {\n      for (const a of allAnims) {\n        this.renderer.clearPieceOffset(a.r, a.c);\n      }\n      this._processMatches();\n    });\n  }\n\n  _restart() {\n    this.board.init();\n    this.score.reset();\n    this.anim.clear();\n    this.renderer.particles = [];\n    this.renderer.scorePopups = [];\n    this.renderer.comboText = null;\n    this.renderer.screenShake = 0;\n    this.renderer.pieceOffset = {};\n    this.renderer.pieceScale = {};\n    this.input.reset();\n    this.state = 'idle';\n  }\n\n  _nextLevel() {\n    this.score.nextLevel();\n    this.board.init();\n    this.anim.clear();\n    this.renderer.particles = [];\n    this.renderer.scorePopups = [];\n    this.renderer.comboText = null;\n    this.renderer.screenShake = 0;\n    this.renderer.pieceOffset = {};\n    this.renderer.pieceScale = {};\n    this.input.reset();\n    this.state = 'idle';\n  }\n\n  _loop() {\n    const now = Date.now();\n    const dt = Math.min((now - this._lastTime) / 1000, 0.1);\n    this._lastTime = now;\n\n    this.anim.update(dt * 1000);\n    this.renderer.updateEffects(dt);\n\n    // Draw\n    const r = this.renderer;\n    r.clear();\n    r.drawBackground();\n    r.drawTopBar(this.score.score, this.score.level, this.score.movesLeft, this.score.targetScore);\n    r.drawBoard();\n    r.drawPieces(this.board);\n    r.drawEffects();\n    r.drawBottomBar(() => this._restart());\n\n    if (this.state === 'gameover') {\n      r.drawGameOver(this.score.score, this.score.level, this.score.bestScore);\n    }\n    if (this.state === 'levelcomplete') {\n      r.drawLevelComplete(this.score.score, this.score.level, this.score.bestScore);\n    }\n\n    requestAnimationFrame(() => this._loop());\n  }\n}\n\n// --- Bootstrap ---\nnew Game();\n","numLines":352,"startLine":1,"totalLines":352}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a5f605843cd549c89519001e","type":"tool_result","content":"1\t/**\n2\t * Tween-based animation system.\n3\t */\n4\t\n5\tclass Animation {\n6\t  constructor(duration, updateFn, completeFn) {\n7\t    this.duration = duration;\n8\t    this.updateFn = updateFn;\n9\t    this.completeFn = completeFn;\n10\t    this.elapsed = 0;\n11\t    this.done = false;\n12\t  }\n13\t\n14\t  update(dt) {\n15\t    if (this.done) return;\n16\t    this.elapsed += dt;\n17\t    const t = Math.min(this.elapsed / this.duration, 1);\n18\t    this.updateFn(t);\n19\t    if (t >= 1) {\n20\t      this.done = true;\n21\t      if (this.completeFn) this.completeFn();\n22\t    }\n23\t  }\n24\t}\n25\t\n26\tclass AnimationManager {\n27\t  constructor() {\n28\t    this.anims = [];\n29\t  }\n30\t\n31\t  add(duration, updateFn, completeFn) {\n32\t    const anim = new Animation(duration, updateFn, completeFn);\n33\t    this.anims.push(anim);\n34\t    return anim;\n35\t  }\n36\t\n37\t  update(dt) {\n38\t    for (let i = this.anims.length - 1; i >= 0; i--) {\n39\t      this.anims[i].update(dt);\n40\t      if (this.anims[i].done) this.anims.splice(i, 1);\n41\t    }\n42\t  }\n43\t\n44\t  get busy() {\n45\t    return this.anims.length > 0;\n46\t  }\n47\t\n48\t  clear() {\n49\t    this.anims = [];\n50\t  }\n51\t}\n52\t\n53\tmodule.exports = AnimationManager;\n54\t"}]},"parent_tool_use_id":null,"session_id":"b40e9963-6d9c-4ef1-96a5-70dd29359e7e","uuid":"308a1a04-af84-4935-a9de-890368b074a7","timestamp":"2026-05-23T18:21:37.763Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\games\\match3-xiaoxiaoxiao\\js\\animation.js","content":"/**\n * Tween-based animation system.\n */\n\nclass Animation {\n  constructor(duration, updateFn, completeFn) {\n    this.duration = duration;\n    this.updateFn = updateFn;\n    this.completeFn = completeFn;\n    this.elapsed = 0;\n    this.done = false;\n  }\n\n  update(dt) {\n    if (this.done) return;\n    this.elapsed += dt;\n    const t = Math.min(this.elapsed / this.duration, 1);\n    this.updateFn(t);\n    if (t >= 1) {\n      this.done = true;\n      if (this.completeFn) this.completeFn();\n    }\n  }\n}\n\nclass AnimationManager {\n  constructor() {\n    this.anims = [];\n  }\n\n  add(duration, updateFn, completeFn) {\n    const anim = new Animation(duration, updateFn, completeFn);\n    this.anims.push(anim);\n    return anim;\n  }\n\n  update(dt) {\n    for (let i = this.anims.length - 1; i >= 0; i--) {\n      this.anims[i].update(dt);\n      if (this.anims[i].done) this.anims.splice(i, 1);\n    }\n  }\n\n  get busy() {\n    return this.anims.length > 0;\n  }\n\n  clear() {\n    this.anims = [];\n  }\n}\n\nmodule.exports = AnimationManager;\n","numLines":54,"startLine":1,"totalLines":54}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a640c4a0ff264313b6a4383d","type":"tool_result","content":"1\t/**\n2\t * Canvas renderer - draws board, pieces, UI, and animations.\n3\t */\n4\t\n5\tconst config = require('./config');\n6\tconst { easeOutBounce, easeOutQuad } = require('./utils');\n7\t\n8\tclass Renderer {\n9\t  constructor(canvas, boardLayout) {\n10\t    this.canvas = canvas;\n11\t    this.ctx = canvas.getContext('2d');\n12\t    this.layout = boardLayout;\n13\t    this.pieceScale = {};  // \"r,c\" -> scale (for animations)\n14\t    this.pieceOffset = {}; // \"r,c\" -> {dx, dy} (for swap/fall)\n15\t    this.selectedCell = null;\n16\t    this.particles = [];\n17\t    this.comboText = null;\n18\t    this.scorePopups = [];\n19\t    this.screenShake = 0;\n20\t  }\n21\t\n22\t  clear() {\n23\t    const { ctx, canvas } = this;\n24\t    ctx.clearRect(0, 0, canvas.width, canvas.height);\n25\t  }\n26\t\n27\t  drawBackground() {\n28\t    const { ctx, canvas } = this;\n29\t    ctx.fillStyle = config.BG_COLOR;\n30\t    ctx.fillRect(0, 0, canvas.width, canvas.height);\n31\t  }\n32\t\n33\t  drawBoard() {\n34\t    const { ctx } = this;\n35\t    const { x, y, width, height, cellSize } = this.layout;\n36\t\n37\t    // Board background with rounded corners\n38\t    ctx.fillStyle = config.BOARD_BG;\n39\t    this._roundRect(x - config.BOARD_PADDING, y - config.BOARD_PADDING,\n40\t      width + config.BOARD_PADDING * 2, height + config.BOARD_PADDING * 2,\n41\t      config.BOARD_BORDER_RADIUS);\n42\t    ctx.fill();\n43\t\n44\t    // Cell backgrounds\n45\t    for (let r = 0; r < config.GRID_SIZE; r++) {\n46\t      for (let c = 0; c < config.GRID_SIZE; c++) {\n47\t        const cx = x + c * (cellSize + config.CELL_GAP);\n48\t        const cy = y + r * (cellSize + config.CELL_GAP);\n49\t        ctx.fillStyle = config.CELL_BG;\n50\t        this._roundRect(cx, cy, cellSize, cellSize, 6);\n51\t        ctx.fill();\n52\t      }\n53\t    }\n54\t  }\n55\t\n56\t  drawPieces(board) {\n57\t    const { ctx } = this;\n58\t    const { x, y, cellSize } = this.layout;\n59\t\n60\t    for (let r = 0; r < config.GRID_SIZE; r++) {\n61\t      for (let c = 0; c < config.GRID_SIZE; c++) {\n62\t        const type = board.getPiece(r, c);\n63\t        if (type < 0) continue;\n64\t\n65\t        let px = x + c * (cellSize + config.CELL_GAP) + cellSize / 2;\n66\t        let py = y + r * (cellSize + config.CELL_GAP) + cellSize / 2;\n67\t\n68\t        const key = r + ',' + c;\n69\t        const offset = this.pieceOffset[key];\n70\t        if (offset) {\n71\t          px += offset.dx;\n72\t          py += offset.dy;\n73\t        }\n74\t\n75\t        const scale = this.pieceScale[key] || 1;\n76\t        const radius = (cellSize / 2 - 4) * scale;\n77\t\n78\t        if (radius <= 0) continue;\n79\t\n80\t        this._drawPiece(ctx, px, py, radius, type);\n81\t\n82\t        // Selected highlight\n83\t        if (this.selectedCell && this.selectedCell.r === r && this.selectedCell.c === c) {\n84\t          ctx.strokeStyle = config.SELECTED_COLOR;\n85\t          ctx.lineWidth = 3;\n86\t          ctx.beginPath();\n87\t          ctx.arc(px, py, radius + 2, 0, Math.PI * 2);\n88\t          ctx.stroke();\n89\t\n90\t          // Pulsing glow\n91\t          const pulse = 0.5 + 0.5 * Math.sin(Date.now() / 150);\n92\t          ctx.strokeStyle = `rgba(236, 204, 104, ${pulse * 0.5})`;\n93\t          ctx.lineWidth = 2;\n94\t          ctx.beginPath();\n95\t          ctx.arc(px, py, radius + 5, 0, Math.PI * 2);\n96\t          ctx.stroke();\n97\t        }\n98\t      }\n99\t    }\n100\t  }\n101\t\n102\t  _drawPiece(ctx, px, py, radius, type) {\n103\t    const color = config.PIECE_COLORS[type];\n104\t    const glow = config.PIECE_GLOW[type];\n105\t    const shape = config.PIECE_SHAPES[type];\n106\t\n107\t    // Shadow\n108\t    ctx.fillStyle = 'rgba(0,0,0,0.2)';\n109\t    ctx.beginPath();\n110\t    ctx.arc(px + 2, py + 2, radius, 0, Math.PI * 2);\n111\t    ctx.fill();\n112\t\n113\t    // Main body with gradient\n114\t    const grad = ctx.createRadialGradient(px - radius * 0.3, py - radius * 0.3, 0, px, py, radius);\n115\t    grad.addColorStop(0, glow);\n116\t    grad.addColorStop(0.7, color);\n117\t    grad.addColorStop(1, this._darken(color, 0.7));\n118\t    ctx.fillStyle = grad;\n119\t\n120\t    ctx.beginPath();\n121\t    switch (shape) {\n122\t      case 'circle':\n123\t        ctx.arc(px, py, radius, 0, Math.PI * 2);\n124\t        break;\n125\t      case 'diamond':\n126\t        ctx.moveTo(px, py - radius);\n127\t        ctx.lineTo(px + radius, py);\n128\t        ctx.lineTo(px, py + radius);\n129\t        ctx.lineTo(px - radius, py);\n130\t        break;\n131\t      case 'square':\n132\t        const s = radius * 0.8;\n133\t        this._roundRect(px - s, py - s, s * 2, s * 2, 4);\n134\t        break;\n135\t      case 'triangle':\n136\t        ctx.moveTo(px, py - radius);\n137\t        ctx.lineTo(px + radius * 0.87, py + radius * 0.5);\n138\t        ctx.lineTo(px - radius * 0.87, py + radius * 0.5);\n139\t        break;\n140\t      case 'star':\n141\t        this._drawStar(ctx, px, py, 5, radius, radius * 0.5);\n142\t        break;\n143\t      case 'hexagon':\n144\t        this._drawPolygon(ctx, px, py, radius, 6);\n145\t        break;\n146\t    }\n147\t    ctx.fill();\n148\t\n149\t    // Highlight shine\n150\t    ctx.fillStyle = 'rgba(255,255,255,0.3)';\n151\t    ctx.beginPath();\n152\t    ctx.ellipse(px - radius * 0.2, py - radius * 0.3, radius * 0.4, radius * 0.25, -0.3, 0, Math.PI * 2);\n153\t    ctx.fill();\n154\t  }\n155\t\n156\t  _drawStar(ctx, cx, cy, points, outerR, innerR) {\n157\t    ctx.beginPath();\n158\t    for (let i = 0; i < points * 2; i++) {\n159\t      const r = i % 2 === 0 ? outerR : innerR;\n160\t      const angle = (Math.PI / points) * i - Math.PI / 2;\n161\t      const x = cx + Math.cos(angle) * r;\n162\t      const y = cy + Math.sin(angle) * r;\n163\t      if (i === 0) ctx.moveTo(x, y);\n164\t      else ctx.lineTo(x, y);\n165\t    }\n166\t    ctx.closePath();\n167\t  }\n168\t\n169\t  _drawPolygon(ctx, cx, cy, r, sides) {\n170\t    ctx.beginPath();\n171\t    for (let i = 0; i < sides; i++) {\n172\t      const angle = (Math.PI * 2 / sides) * i - Math.PI / 2;\n173\t      const x = cx + Math.cos(angle) * r;\n174\t      const y = cy + Math.sin(angle) * r;\n175\t      if (i === 0) ctx.moveTo(x, y);\n176\t      else ctx.lineTo(x, y);\n177\t    }\n178\t    ctx.closePath();\n179\t  }\n180\t\n181\t  drawTopBar(score, level, movesLeft, targetScore) {\n182\t    const { ctx, canvas } = this;\n183\t    const barY = 0;\n184\t    const barH = this.layout.topBarHeight;\n185\t\n186\t    // Bar background\n187\t    ctx.fillStyle = 'rgba(22, 33, 62, 0.9)';\n188\t    ctx.fillRect(0, barY, canvas.width, barH);\n189\t\n190\t    // Score\n191\t    ctx.fillStyle = '#FFFFFF';\n192\t    ctx.font = 'bold 20px Arial';\n193\t    ctx.textAlign = 'left';\n194\t    ctx.fillText('分数', 16, barY + 30);\n195\t    ctx.font = 'bold 28px Arial';\n196\t    ctx.fillStyle = '#FFD700';\n197\t    ctx.fillText(score.toLocaleString(), 16, barY + 62);\n198\t\n199\t    // Level\n200\t    ctx.fillStyle = '#FFFFFF';\n201\t    ctx.font = 'bold 18px Arial';\n202\t    ctx.textAlign = 'center';\n203\t    ctx.fillText('第 ' + level + ' 关', canvas.width / 2, barY + 30);\n204\t\n205\t    // Target progress bar\n206\t    const progW = canvas.width * 0.5;\n207\t    const progH = 12;\n208\t    const progX = (canvas.width - progW) / 2;\n209\t    const progY = barY + 42;\n210\t    ctx.fillStyle = 'rgba(255,255,255,0.15)';\n211\t    this._roundRect(progX, progY, progW, progH, 6);\n212\t    ctx.fill();\n213\t    const prog = Math.min(score / targetScore, 1);\n214\t    if (prog > 0) {\n215\t      const progGrad = ctx.createLinearGradient(progX, 0, progX + progW, 0);\n216\t      progGrad.addColorStop(0, '#FFD700');\n217\t      progGrad.addColorStop(1, '#FF6348');\n218\t      ctx.fillStyle = progGrad;\n219\t      this._roundRect(progX, progY, progW * prog, progH, 6);\n220\t      ctx.fill();\n221\t    }\n222\t\n223\t    // Moves left\n224\t    ctx.fillStyle = '#FFFFFF';\n225\t    ctx.font = 'bold 18px Arial';\n226\t    ctx.textAlign = 'right';\n227\t    ctx.fillText('剩余步数', canvas.width - 16, barY + 30);\n228\t    ctx.font = 'bold 28px Arial';\n229\t    ctx.fillStyle = movesLeft <= 5 ? '#FF4757' : '#2ED573';\n230\t    ctx.fillText(movesLeft.toString(), canvas.width - 16, barY + 62);\n231\t  }\n232\t\n233\t  drawBottomBar(onRestart) {\n234\t    const { ctx, canvas } = this;\n235\t    const barY = canvas.height - this.layout.bottomBarHeight;\n236\t\n237\t    ctx.fillStyle = 'rgba(22, 33, 62, 0.9)';\n238\t    ctx.fillRect(0, barY, canvas.width, this.layout.bottomBarHeight);\n239\t\n240\t    // Restart button\n241\t    const btnW = 140;\n242\t    const btnH = 44;\n243\t    const btnX = (canvas.width - btnW) / 2;\n244\t    const btnY = barY + (this.layout.bottomBarHeight - btnH) / 2;\n245\t\n246\t    ctx.fillStyle = '#FF6348';\n247\t    this._roundRect(btnX, btnY, btnW, btnH, 22);\n248\t    ctx.fill();\n249\t\n250\t    ctx.fillStyle = '#FFFFFF';\n251\t    ctx.font = 'bold 18px Arial';\n252\t    ctx.textAlign = 'center';\n253\t    ctx.textBaseline = 'middle';\n254\t    ctx.fillText('重新开始', canvas.width / 2, btnY + btnH / 2);\n255\t    ctx.textBaseline = 'alphabetic';\n256\t\n257\t    this._restartBtn = { x: btnX, y: btnY, w: btnW, h: btnH, cb: onRestart };\n258\t  }\n259\t\n260\t  get restartBtn() { return this._restartBtn; }\n261\t\n262\t  drawGameOver(score, level, best) {\n263\t    const { ctx, canvas } = this;\n264\t\n265\t    // Overlay\n266\t    ctx.fillStyle = 'rgba(0,0,0,0.75)';\n267\t    ctx.fillRect(0, 0, canvas.width, canvas.height);\n268\t\n269\t    const cx = canvas.width / 2;\n270\t    const cy = canvas.height / 2;\n271\t\n272\t    // Panel\n273\t    const panelW = canvas.width * 0.8;\n274\t    const panelH = 320;\n275\t    const px = cx - panelW / 2;\n276\t    const py = cy - panelH / 2;\n277\t\n278\t    ctx.fillStyle = '#16213E';\n279\t    this._roundRect(px, py, panelW, panelH, 20);\n280\t    ctx.fill();\n281\t    ctx.strokeStyle = '#FFD700';\n282\t    ctx.lineWidth = 2;\n283\t    this._roundRect(px, py, panelW, panelH, 20);\n284\t    ctx.stroke();\n285\t\n286\t    ctx.textAlign = 'center';\n287\t\n288\t    ctx.fillStyle = '#FFD700';\n289\t    ctx.font = 'bold 30px Arial';\n290\t    ctx.fillText('游戏结束', cx, py + 50);\n291\t\n292\t    ctx.fillStyle = '#FFFFFF';\n293\t    ctx.font = '20px Arial';\n294\t    ctx.fillText('得分: ' + score.toLocaleString(), cx, py + 100);\n295\t\n296\t    ctx.fillStyle = '#AAAAAA';\n297\t    ctx.font = '18px Arial';\n298\t    ctx.fillText('第 ' + level + ' 关', cx, py + 135);\n299\t    ctx.fillText('最高分: ' + best.toLocaleString(), cx, py + 165);\n300\t\n301\t    // Retry button\n302\t    const btnW = 160;\n303\t    const btnH = 48;\n304\t    const btnX = cx - btnW / 2;\n305\t    const btnY = py + panelH - 80;\n306\t\n307\t    ctx.fillStyle = '#2ED573';\n308\t    this._roundRect(btnX, btnY, btnW, btnH, 24);\n309\t    ctx.fill();\n310\t\n311\t    ctx.fillStyle = '#FFFFFF';\n312\t    ctx.font = 'bold 20px Arial';\n313\t    ctx.textBaseline = 'middle';\n314\t    ctx.fillText('再来一局', cx, btnY + btnH / 2);\n315\t    ctx.textBaseline = 'alphabetic';\n316\t\n317\t    this._retryBtn = { x: btnX, y: btnY, w: btnW, h: btnH };\n318\t  }\n319\t\n320\t  get retryBtn() { return this._retryBtn; }\n321\t\n322\t  drawLevelComplete(score, level, best) {\n323\t    const { ctx, canvas } = this;\n324\t\n325\t    ctx.fillStyle = 'rgba(0,0,0,0.75)';\n326\t    ctx.fillRect(0, 0, canvas.width, canvas.height);\n327\t\n328\t    const cx = canvas.width / 2;\n329\t    const cy = canvas.height / 2;\n330\t    const panelW = canvas.width * 0.8;\n331\t    const panelH = 320;\n332\t    const px = cx - panelW / 2;\n333\t    const py = cy - panelH / 2;\n334\t\n335\t    ctx.fillStyle = '#16213E';\n336\t    this._roundRect(px, py, panelW, panelH, 20);\n337\t    ctx.fill();\n338\t    ctx.strokeStyle = '#2ED573';\n339\t    ctx.lineWidth = 2;\n340\t    this._roundRect(px, py, panelW, panelH, 20);\n341\t    ctx.stroke();\n342\t\n343\t    ctx.textAlign = 'center';\n344\t\n345\t    ctx.fillStyle = '#2ED573';\n346\t    ctx.font = 'bold 30px Arial';\n347\t    ctx.fillText('过关！', cx, py + 50);\n348\t\n349\t    ctx.fillStyle = '#FFFFFF';\n350\t    ctx.font = '20px Arial';\n351\t    ctx.fillText('得分: ' + score.toLocaleString(), cx, py + 100);\n352\t\n353\t    ctx.fillStyle = '#FFD700';\n354\t    ctx.font = 'bold 22px Arial';\n355\t    ctx.fillText('进入第 ' + (level + 1) + ' 关', cx, py + 145);\n356\t\n357\t    ctx.fillStyle = '#AAAAAA';\n358\t    ctx.font = '18px Arial';\n359\t    ctx.fillText('最高分: ' + best.toLocaleString(), cx, py + 180);\n360\t\n361\t    const btnW = 160;\n362\t    const btnH = 48;\n363\t    const btnX = cx - btnW / 2;\n364\t    const btnY = py + panelH - 80;\n365\t\n366\t    ctx.fillStyle = '#FFD700';\n367\t    this._roundRect(btnX, btnY, btnW, btnH, 24);\n368\t    ctx.fill();\n369\t\n370\t    ctx.fillStyle = '#1A1A2E';\n371\t    ctx.font = 'bold 20px Arial';\n372\t    ctx.textBaseline = 'middle';\n373\t    ctx.fillText('下一关', cx, btnY + btnH / 2);\n374\t    ctx.textBaseline = 'alphabetic';\n375\t\n376\t    this._nextBtn = { x: btnX, y: btnY, w: btnW, h: btnH };\n377\t  }\n378\t\n379\t  get nextBtn() { return this._nextBtn; }\n380\t\n381\t  addScorePopup(r, c, score) {\n382\t    const { x, y, cellSize } = this.layout;\n383\t    this.scorePopups.push({\n384\t      x: x + c * (cellSize + config.CELL_GAP) + cellSize / 2,\n385\t      y: y + r * (cellSize + config.CELL_GAP),\n386\t      text: '+' + score,\n387\t      life: 1,\n388\t    });\n389\t  }\n390\t\n391\t  setComboText(combo) {\n392\t    if (combo > 1) {\n393\t      this.comboText = { text: combo + 'x 连击！', life: 1 };\n394\t    }\n395\t  }\n396\t\n397\t  addParticles(r, c, type) {\n398\t    const { x, y, cellSize } = this.layout;\n399\t    const px = x + c * (cellSize + config.CELL_GAP) + cellSize / 2;\n400\t    const py = y + r * (cellSize + config.CELL_GAP) + cellSize / 2;\n401\t    const color = config.PIECE_COLORS[type] || '#FFF';\n402\t    for (let i = 0; i < 6; i++) {\n403\t      const angle = (Math.PI * 2 / 6) * i + Math.random() * 0.5;\n404\t      this.particles.push({\n405\t        x: px, y: py,\n406\t        vx: Math.cos(angle) * (2 + Math.random() * 3),\n407\t        vy: Math.sin(angle) * (2 + Math.random() * 3),\n408\t        life: 1,\n409\t        color,\n410\t        size: 3 + Math.random() * 3,\n411\t      });\n412\t    }\n413\t  }\n414\t\n415\t  updateEffects(dt) {\n416\t    // Particles\n417\t    for (let i = this.particles.length - 1; i >= 0; i--) {\n418\t      const p = this.particles[i];\n419\t      p.x += p.vx;\n420\t      p.y += p.vy;\n421\t      p.vy += 0.15;\n422\t      p.life -= dt * 2;\n423\t      if (p.life <= 0) this.particles.splice(i, 1);\n424\t    }\n425\t\n426\t    // Score popups\n427\t    for (let i = this.scorePopups.length - 1; i >= 0; i--) {\n428\t      const p = this.scorePopups[i];\n429\t      p.y -= 1.5;\n430\t      p.life -= dt * 1.5;\n431\t      if (p.life <= 0) this.scorePopups.splice(i, 1);\n432\t    }\n433\t\n434\t    // Combo text\n435\t    if (this.comboText) {\n436\t      this.comboText.life -= dt;\n437\t      if (this.comboText.life <= 0) this.comboText = null;\n438\t    }\n439\t\n440\t    // Screen shake\n441\t    if (this.screenShake > 0) this.screenShake -= dt * 10;\n442\t  }\n443\t\n444\t  drawEffects() {\n445\t    const { ctx } = this;\n446\t\n447\t    // Apply screen shake\n448\t    if (this.screenShake > 0) {\n449\t      const shake = this.screenShake * 2;\n450\t      ctx.save();\n451\t      ctx.translate(\n452\t        (Math.random() - 0.5) * shake,\n453\t        (Math.random() - 0.5) * shake\n454\t      );\n455\t    }\n456\t\n457\t    // Particles\n458\t    for (const p of this.particles) {\n459\t      ctx.globalAlpha = p.life;\n460\t      ctx.fillStyle = p.color;\n461\t      ctx.beginPath();\n462\t      ctx.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2);\n463\t      ctx.fill();\n464\t    }\n465\t    ctx.globalAlpha = 1;\n466\t\n467\t    // Score popups\n468\t    for (const p of this.scorePopups) {\n469\t      ctx.globalAlpha = p.life;\n470\t      ctx.fillStyle = '#FFD700';\n471\t      ctx.font = 'bold 18px Arial';\n472\t      ctx.textAlign = 'center';\n473\t      ctx.fillText(p.text, p.x, p.y);\n474\t    }\n475\t    ctx.globalAlpha = 1;\n476\t\n477\t    // Combo text\n478\t    if (this.comboText) {\n479\t      ctx.globalAlpha = this.comboText.life;\n480\t      ctx.fillStyle = '#FF6348';\n481\t      ctx.font = 'bold 32px Arial';\n482\t      ctx.textAlign = 'center';\n483\t      ctx.fillText(this.comboText.text, this.canvas.width / 2, this.layout.y - 20);\n484\t    }\n485\t    ctx.globalAlpha = 1;\n486\t\n487\t    if (this.screenShake > 0) ctx.restore();\n488\t  }\n489\t\n490\t  setPieceOffset(r, c, dx, dy) {\n491\t    this.pieceOffset[r + ',' + c] = { dx, dy };\n492\t  }\n493\t\n494\t  clearPieceOffset(r, c) {\n495\t    delete this.pieceOffset[r + ',' + c];\n496\t  }\n497\t\n498\t  setPieceScale(r, c, scale) {\n499\t    this.pieceScale[r + ',' + c] = scale;\n500\t  }\n501\t\n502\t  clearPieceScale(r, c) {\n503\t    delete this.pieceScale[r + ',' + c];\n504\t  }\n505\t\n506\t  _roundRect(x, y, w, h, r) {\n507\t    const ctx = this.ctx;\n508\t    ctx.beginPath();\n509\t    ctx.moveTo(x + r, y);\n510\t    ctx.lineTo(x + w - r, y);\n511\t    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n512\t    ctx.lineTo(x + w, y + h - r);\n513\t    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n514\t    ctx.lineTo(x + r, y + h);\n515\t    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n516\t    ctx.lineTo(x, y + r);\n517\t    ctx.quadraticCurveTo(x, y, x + r, y);\n518\t    ctx.closePath();\n519\t  }\n520\t\n521\t  _darken(hex, factor) {\n522\t    const num = parseInt(hex.slice(1), 16);\n523\t    const r = Math.floor(((num >> 16) & 0xFF) * factor);\n524\t    const g = Math.floor(((num >> 8) & 0xFF) * factor);\n525\t    const b = Math.floor((num & 0xFF) * factor);\n526\t    return '#' + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);\n527\t  }\n528\t}\n529\t\n530\tmodule.exports = Renderer;\n531\t"}]},"parent_tool_use_id":null,"session_id":"b40e9963-6d9c-4ef1-96a5-70dd29359e7e","uuid":"06b090ac-83a9-4b50-bdaf-7bda2e09933c","timestamp":"2026-05-23T18:21:37.818Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\games\\match3-xiaoxiaoxiao\\js\\renderer.js","content":"/**\n * Canvas renderer - draws board, pieces, UI, and animations.\n */\n\nconst config = require('./config');\nconst { easeOutBounce, easeOutQuad } = require('./utils');\n\nclass Renderer {\n  constructor(canvas, boardLayout) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d');\n    this.layout = boardLayout;\n    this.pieceScale = {};  // \"r,c\" -> scale (for animations)\n    this.pieceOffset = {}; // \"r,c\" -> {dx, dy} (for swap/fall)\n    this.selectedCell = null;\n    this.particles = [];\n    this.comboText = null;\n    this.scorePopups = [];\n    this.screenShake = 0;\n  }\n\n  clear() {\n    const { ctx, canvas } = this;\n    ctx.clearRect(0, 0, canvas.width, canvas.height);\n  }\n\n  drawBackground() {\n    const { ctx, canvas } = this;\n    ctx.fillStyle = config.BG_COLOR;\n    ctx.fillRect(0, 0, canvas.width, canvas.height);\n  }\n\n  drawBoard() {\n    const { ctx } = this;\n    const { x, y, width, height, cellSize } = this.layout;\n\n    // Board background with rounded corners\n    ctx.fillStyle = config.BOARD_BG;\n    this._roundRect(x - config.BOARD_PADDING, y - config.BOARD_PADDING,\n      width + config.BOARD_PADDING * 2, height + config.BOARD_PADDING * 2,\n      config.BOARD_BORDER_RADIUS);\n    ctx.fill();\n\n    // Cell backgrounds\n    for (let r = 0; r < config.GRID_SIZE; r++) {\n      for (let c = 0; c < config.GRID_SIZE; c++) {\n        const cx = x + c * (cellSize + config.CELL_GAP);\n        const cy = y + r * (cellSize + config.CELL_GAP);\n        ctx.fillStyle = config.CELL_BG;\n        this._roundRect(cx, cy, cellSize, cellSize, 6);\n        ctx.fill();\n      }\n    }\n  }\n\n  drawPieces(board) {\n    const { ctx } = this;\n    const { x, y, cellSize } = this.layout;\n\n    for (let r = 0; r < config.GRID_SIZE; r++) {\n      for (let c = 0; c < config.GRID_SIZE; c++) {\n        const type = board.getPiece(r, c);\n        if (type < 0) continue;\n\n        let px = x + c * (cellSize + config.CELL_GAP) + cellSize / 2;\n        let py = y + r * (cellSize + config.CELL_GAP) + cellSize / 2;\n\n        const key = r + ',' + c;\n        const offset = this.pieceOffset[key];\n        if (offset) {\n          px += offset.dx;\n          py += offset.dy;\n        }\n\n        const scale = this.pieceScale[key] || 1;\n        const radius = (cellSize / 2 - 4) * scale;\n\n        if (radius <= 0) continue;\n\n        this._drawPiece(ctx, px, py, radius, type);\n\n        // Selected highlight\n        if (this.selectedCell && this.selectedCell.r === r && this.selectedCell.c === c) {\n          ctx.strokeStyle = config.SELECTED_COLOR;\n          ctx.lineWidth = 3;\n          ctx.beginPath();\n          ctx.arc(px, py, radius + 2, 0, Math.PI * 2);\n          ctx.stroke();\n\n          // Pulsing glow\n          const pulse = 0.5 + 0.5 * Math.sin(Date.now() / 150);\n          ctx.strokeStyle = `rgba(236, 204, 104, ${pulse * 0.5})`;\n          ctx.lineWidth = 2;\n          ctx.beginPath();\n          ctx.arc(px, py, radius + 5, 0, Math.PI * 2);\n          ctx.stroke();\n        }\n      }\n    }\n  }\n\n  _drawPiece(ctx, px, py, radius, type) {\n    const color = config.PIECE_COLORS[type];\n    const glow = config.PIECE_GLOW[type];\n    const shape = config.PIECE_SHAPES[type];\n\n    // Shadow\n    ctx.fillStyle = 'rgba(0,0,0,0.2)';\n    ctx.beginPath();\n    ctx.arc(px + 2, py + 2, radius, 0, Math.PI * 2);\n    ctx.fill();\n\n    // Main body with gradient\n    const grad = ctx.createRadialGradient(px - radius * 0.3, py - radius * 0.3, 0, px, py, radius);\n    grad.addColorStop(0, glow);\n    grad.addColorStop(0.7, color);\n    grad.addColorStop(1, this._darken(color, 0.7));\n    ctx.fillStyle = grad;\n\n    ctx.beginPath();\n    switch (shape) {\n      case 'circle':\n        ctx.arc(px, py, radius, 0, Math.PI * 2);\n        break;\n      case 'diamond':\n        ctx.moveTo(px, py - radius);\n        ctx.lineTo(px + radius, py);\n        ctx.lineTo(px, py + radius);\n        ctx.lineTo(px - radius, py);\n        break;\n      case 'square':\n        const s = radius * 0.8;\n        this._roundRect(px - s, py - s, s * 2, s * 2, 4);\n        break;\n      case 'triangle':\n        ctx.moveTo(px, py - radius);\n        ctx.lineTo(px + radius * 0.87, py + radius * 0.5);\n        ctx.lineTo(px - radius * 0.87, py + radius * 0.5);\n        break;\n      case 'star':\n        this._drawStar(ctx, px, py, 5, radius, radius * 0.5);\n        break;\n      case 'hexagon':\n        this._drawPolygon(ctx, px, py, radius, 6);\n        break;\n    }\n    ctx.fill();\n\n    // Highlight shine\n    ctx.fillStyle = 'rgba(255,255,255,0.3)';\n    ctx.beginPath();\n    ctx.ellipse(px - radius * 0.2, py - radius * 0.3, radius * 0.4, radius * 0.25, -0.3, 0, Math.PI * 2);\n    ctx.fill();\n  }\n\n  _drawStar(ctx, cx, cy, points, outerR, innerR) {\n    ctx.beginPath();\n    for (let i = 0; i < points * 2; i++) {\n      const r = i % 2 === 0 ? outerR : innerR;\n      const angle = (Math.PI / points) * i - Math.PI / 2;\n      const x = cx + Math.cos(angle) * r;\n      const y = cy + Math.sin(angle) * r;\n      if (i === 0) ctx.moveTo(x, y);\n      else ctx.lineTo(x, y);\n    }\n    ctx.closePath();\n  }\n\n  _drawPolygon(ctx, cx, cy, r, sides) {\n    ctx.beginPath();\n    for (let i = 0; i < sides; i++) {\n      const angle = (Math.PI * 2 / sides) * i - Math.PI / 2;\n      const x = cx + Math.cos(angle) * r;\n      const y = cy + Math.sin(angle) * r;\n      if (i === 0) ctx.moveTo(x, y);\n      else ctx.lineTo(x, y);\n    }\n    ctx.closePath();\n  }\n\n  drawTopBar(score, level, movesLeft, targetScore) {\n    const { ctx, canvas } = this;\n    const barY = 0;\n    const barH = this.layout.topBarHeight;\n\n    // Bar background\n    ctx.fillStyle = 'rgba(22, 33, 62, 0.9)';\n    ctx.fillRect(0, barY, canvas.width, barH);\n\n    // Score\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = 'bold 20px Arial';\n    ctx.textAlign = 'left';\n    ctx.fillText('分数', 16, barY + 30);\n    ctx.font = 'bold 28px Arial';\n    ctx.fillStyle = '#FFD700';\n    ctx.fillText(score.toLocaleString(), 16, barY + 62);\n\n    // Level\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = 'bold 18px Arial';\n    ctx.textAlign = 'center';\n    ctx.fillText('第 ' + level + ' 关', canvas.width / 2, barY + 30);\n\n    // Target progress bar\n    const progW = canvas.width * 0.5;\n    const progH = 12;\n    const progX = (canvas.width - progW) / 2;\n    const progY = barY + 42;\n    ctx.fillStyle = 'rgba(255,255,255,0.15)';\n    this._roundRect(progX, progY, progW, progH, 6);\n    ctx.fill();\n    const prog = Math.min(score / targetScore, 1);\n    if (prog > 0) {\n      const progGrad = ctx.createLinearGradient(progX, 0, progX + progW, 0);\n      progGrad.addColorStop(0, '#FFD700');\n      progGrad.addColorStop(1, '#FF6348');\n      ctx.fillStyle = progGrad;\n      this._roundRect(progX, progY, progW * prog, progH, 6);\n      ctx.fill();\n    }\n\n    // Moves left\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = 'bold 18px Arial';\n    ctx.textAlign = 'right';\n    ctx.fillText('剩余步数', canvas.width - 16, barY + 30);\n    ctx.font = 'bold 28px Arial';\n    ctx.fillStyle = movesLeft <= 5 ? '#FF4757' : '#2ED573';\n    ctx.fillText(movesLeft.toString(), canvas.width - 16, barY + 62);\n  }\n\n  drawBottomBar(onRestart) {\n    const { ctx, canvas } = this;\n    const barY = canvas.height - this.layout.bottomBarHeight;\n\n    ctx.fillStyle = 'rgba(22, 33, 62, 0.9)';\n    ctx.fillRect(0, barY, canvas.width, this.layout.bottomBarHeight);\n\n    // Restart button\n    const btnW = 140;\n    const btnH = 44;\n    const btnX = (canvas.width - btnW) / 2;\n    const btnY = barY + (this.layout.bottomBarHeight - btnH) / 2;\n\n    ctx.fillStyle = '#FF6348';\n    this._roundRect(btnX, btnY, btnW, btnH, 22);\n    ctx.fill();\n\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = 'bold 18px Arial';\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText('重新开始', canvas.width / 2, btnY + btnH / 2);\n    ctx.textBaseline = 'alphabetic';\n\n    this._restartBtn = { x: btnX, y: btnY, w: btnW, h: btnH, cb: onRestart };\n  }\n\n  get restartBtn() { return this._restartBtn; }\n\n  drawGameOver(score, level, best) {\n    const { ctx, canvas } = this;\n\n    // Overlay\n    ctx.fillStyle = 'rgba(0,0,0,0.75)';\n    ctx.fillRect(0, 0, canvas.width, canvas.height);\n\n    const cx = canvas.width / 2;\n    const cy = canvas.height / 2;\n\n    // Panel\n    const panelW = canvas.width * 0.8;\n    const panelH = 320;\n    const px = cx - panelW / 2;\n    const py = cy - panelH / 2;\n\n    ctx.fillStyle = '#16213E';\n    this._roundRect(px, py, panelW, panelH, 20);\n    ctx.fill();\n    ctx.strokeStyle = '#FFD700';\n    ctx.lineWidth = 2;\n    this._roundRect(px, py, panelW, panelH, 20);\n    ctx.stroke();\n\n    ctx.textAlign = 'center';\n\n    ctx.fillStyle = '#FFD700';\n    ctx.font = 'bold 30px Arial';\n    ctx.fillText('游戏结束', cx, py + 50);\n\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = '20px Arial';\n    ctx.fillText('得分: ' + score.toLocaleString(), cx, py + 100);\n\n    ctx.fillStyle = '#AAAAAA';\n    ctx.font = '18px Arial';\n    ctx.fillText('第 ' + level + ' 关', cx, py + 135);\n    ctx.fillText('最高分: ' + best.toLocaleString(), cx, py + 165);\n\n    // Retry button\n    const btnW = 160;\n    const btnH = 48;\n    const btnX = cx - btnW / 2;\n    const btnY = py + panelH - 80;\n\n    ctx.fillStyle = '#2ED573';\n    this._roundRect(btnX, btnY, btnW, btnH, 24);\n    ctx.fill();\n\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = 'bold 20px Arial';\n    ctx.textBaseline = 'middle';\n    ctx.fillText('再来一局', cx, btnY + btnH / 2);\n    ctx.textBaseline = 'alphabetic';\n\n    this._retryBtn = { x: btnX, y: btnY, w: btnW, h: btnH };\n  }\n\n  get retryBtn() { return this._retryBtn; }\n\n  drawLevelComplete(score, level, best) {\n    const { ctx, canvas } = this;\n\n    ctx.fillStyle = 'rgba(0,0,0,0.75)';\n    ctx.fillRect(0, 0, canvas.width, canvas.height);\n\n    const cx = canvas.width / 2;\n    const cy = canvas.height / 2;\n    const panelW = canvas.width * 0.8;\n    const panelH = 320;\n    const px = cx - panelW / 2;\n    const py = cy - panelH / 2;\n\n    ctx.fillStyle = '#16213E';\n    this._roundRect(px, py, panelW, panelH, 20);\n    ctx.fill();\n    ctx.strokeStyle = '#2ED573';\n    ctx.lineWidth = 2;\n    this._roundRect(px, py, panelW, panelH, 20);\n    ctx.stroke();\n\n    ctx.textAlign = 'center';\n\n    ctx.fillStyle = '#2ED573';\n    ctx.font = 'bold 30px Arial';\n    ctx.fillText('过关！', cx, py + 50);\n\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = '20px Arial';\n    ctx.fillText('得分: ' + score.toLocaleString(), cx, py + 100);\n\n    ctx.fillStyle = '#FFD700';\n    ctx.font = 'bold 22px Arial';\n    ctx.fillText('进入第 ' + (level + 1) + ' 关', cx, py + 145);\n\n    ctx.fillStyle = '#AAAAAA';\n    ctx.font = '18px Arial';\n    ctx.fillText('最高分: ' + best.toLocaleString(), cx, py + 180);\n\n    const btnW = 160;\n    const btnH = 48;\n    const btnX = cx - btnW / 2;\n    const btnY = py + panelH - 80;\n\n    ctx.fillStyle = '#FFD700';\n    this._roundRect(btnX, btnY, btnW, btnH, 24);\n    ctx.fill();\n\n    ctx.fillStyle = '#1A1A2E';\n    ctx.font = 'bold 20px Arial';\n    ctx.textBaseline = 'middle';\n    ctx.fillText('下一关', cx, btnY + btnH / 2);\n    ctx.textBaseline = 'alphabetic';\n\n    this._nextBtn = { x: btnX, y: btnY, w: btnW, h: btnH };\n  }\n\n  get nextBtn() { return this._nextBtn; }\n\n  addScorePopup(r, c, score) {\n    const { x, y, cellSize } = this.layout;\n    this.scorePopups.push({\n      x: x + c * (cellSize + config.CELL_GAP) + cellSize / 2,\n      y: y + r * (cellSize + config.CELL_GAP),\n      text: '+' + score,\n      life: 1,\n    });\n  }\n\n  setComboText(combo) {\n    if (combo > 1) {\n      this.comboText = { text: combo + 'x 连击！', life: 1 };\n    }\n  }\n\n  addParticles(r, c, type) {\n    const { x, y, cellSize } = this.layout;\n    const px = x + c * (cellSize + config.CELL_GAP) + cellSize / 2;\n    const py = y + r * (cellSize + config.CELL_GAP) + cellSize / 2;\n    const color = config.PIECE_COLORS[type] || '#FFF';\n    for (let i = 0; i < 6; i++) {\n      const angle = (Math.PI * 2 / 6) * i + Math.random() * 0.5;\n      this.particles.push({\n        x: px, y: py,\n        vx: Math.cos(angle) * (2 + Math.random() * 3),\n        vy: Math.sin(angle) * (2 + Math.random() * 3),\n        life: 1,\n        color,\n        size: 3 + Math.random() * 3,\n      });\n    }\n  }\n\n  updateEffects(dt) {\n    // Particles\n    for (let i = this.particles.length - 1; i >= 0; i--) {\n      const p = this.particles[i];\n      p.x += p.vx;\n      p.y += p.vy;\n      p.vy += 0.15;\n      p.life -= dt * 2;\n      if (p.life <= 0) this.particles.splice(i, 1);\n    }\n\n    // Score popups\n    for (let i = this.scorePopups.length - 1; i >= 0; i--) {\n      const p = this.scorePopups[i];\n      p.y -= 1.5;\n      p.life -= dt * 1.5;\n      if (p.life <= 0) this.scorePopups.splice(i, 1);\n    }\n\n    // Combo text\n    if (this.comboText) {\n      this.comboText.life -= dt;\n      if (this.comboText.life <= 0) this.comboText = null;\n    }\n\n    // Screen shake\n    if (this.screenShake > 0) this.screenShake -= dt * 10;\n  }\n\n  drawEffects() {\n    const { ctx } = this;\n\n    // Apply screen shake\n    if (this.screenShake > 0) {\n      const shake = this.screenShake * 2;\n      ctx.save();\n      ctx.translate(\n        (Math.random() - 0.5) * shake,\n        (Math.random() - 0.5) * shake\n      );\n    }\n\n    // Particles\n    for (const p of this.particles) {\n      ctx.globalAlpha = p.life;\n      ctx.fillStyle = p.color;\n      ctx.beginPath();\n      ctx.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2);\n      ctx.fill();\n    }\n    ctx.globalAlpha = 1;\n\n    // Score popups\n    for (const p of this.scorePopups) {\n      ctx.globalAlpha = p.life;\n      ctx.fillStyle = '#FFD700';\n      ctx.font = 'bold 18px Arial';\n      ctx.textAlign = 'center';\n      ctx.fillText(p.text, p.x, p.y);\n    }\n    ctx.globalAlpha = 1;\n\n    // Combo text\n    if (this.comboText) {\n      ctx.globalAlpha = this.comboText.life;\n      ctx.fillStyle = '#FF6348';\n      ctx.font = 'bold 32px Arial';\n      ctx.textAlign = 'center';\n      ctx.fillText(this.comboText.text, this.canvas.width / 2, this.layout.y - 20);\n    }\n    ctx.globalAlpha = 1;\n\n    if (this.screenShake > 0) ctx.restore();\n  }\n\n  setPieceOffset(r, c, dx, dy) {\n    this.pieceOffset[r + ',' + c] = { dx, dy };\n  }\n\n  clearPieceOffset(r, c) {\n    delete this.pieceOffset[r + ',' + c];\n  }\n\n  setPieceScale(r, c, scale) {\n    this.pieceScale[r + ',' + c] = scale;\n  }\n\n  clearPieceScale(r, c) {\n    delete this.pieceScale[r + ',' + c];\n  }\n\n  _roundRect(x, y, w, h, r) {\n    const ctx = this.ctx;\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n\n  _darken(hex, factor) {\n    const num = parseInt(hex.slice(1), 16);\n    const r = Math.floor(((num >> 16) & 0xFF) * factor);\n    const g = Math.floor(((num >> 8) & 0xFF) * factor);\n    const b = Math.floor((num & 0xFF) * factor);\n    return '#' + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);\n  }\n}\n\nmodule.exports = Renderer;\n","numLines":531,"startLine":1,"totalLines":531}}}
