{"type":"assistant","message":{"id":"msg_20260523194512f5d9857edadf4912","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_c01372edcc4e41a18191517b","name":"Write","input":{"file_path":"D:\\games\\match3-xiaoxiaoxiao\\game.js","content":"/**\n * 消消消大作战 - Match-3 Game for Douyin Mini-Game Platform\n * Entry point and game state machine.\n */\n\nconst adapter = require('./adapter/index');\nconst config = require('./js/config');\nconst { easeOutQuad, easeOutBounce } = require('./js/utils');\nconst Board = require('./js/board');\nconst Renderer = require('./js/renderer');\nconst InputHandler = require('./js/input');\nconst AnimationManager = require('./js/animation');\nconst ScoreManager = require('./js/score-manager');\n\n// --- Layout calculation ---\nfunction calcLayout(screenW, screenH) {\n  const topBarH = config.TOP_BAR_HEIGHT;\n  const bottomBarH = config.BOTTOM_BAR_HEIGHT;\n  const availH = screenH - topBarH - bottomBarH;\n  const availW = screenW - 32; // 16px margin each side\n\n  const cellGap = config.CELL_GAP;\n  const maxCellW = (availW - cellGap * (config.GRID_SIZE - 1)) / config.GRID_SIZE;\n  const maxCellH = (availH - cellGap * (config.GRID_SIZE - 1) - 20) / config.GRID_SIZE;\n  const cellSize = Math.floor(Math.min(maxCellW, maxCellH));\n\n  const boardW = cellSize * config.GRID_SIZE + cellGap * (config.GRID_SIZE - 1);\n  const boardH = boardW;\n  const boardX = (screenW - boardW) / 2;\n  const boardY = topBarH + (availH - boardH) / 2;\n\n  return {\n    x: boardX,\n    y: boardY,\n    width: boardW,\n    height: boardH,\n    cellSize,\n    topBarHeight: topBarH,\n    bottomBarHeight: bottomBarH,\n  };\n}\n\n// --- Game ---\nclass Game {\n  constructor() {\n    const sysInfo = adapter.getSystemInfo();\n    const dpr = sysInfo.pixelRatio || 1;\n    const screenW = sysInfo.windowWidth;\n    const screenH = sysInfo.windowHeight;\n\n    this.canvas = adapter.createCanvas();\n    this.canvas.width = screenW * dpr;\n    this.canvas.height = screenH * dpr;\n    const ctx = this.canvas.getContext('2d');\n    ctx.scale(dpr, dpr);\n    this.screenW = screenW;\n    this.screenH = screenH;\n\n    this.layout = calcLayout(screenW, screenH);\n    this.board = new Board();\n    this.renderer = new Renderer(this.canvas, this.layout);\n    this.input = new InputHandler(this.layout);\n    this.anim = new AnimationManager();\n    this.score = new ScoreManager();\n    this.state = 'idle'; // idle, swapping, removing, falling, gameover, levelcomplete\n\n    this._bindEvents();\n    this._lastTime = Date.now();\n    this._loop();\n  }\n\n  _bindEvents() {\n    const dpr = (adapter.getSystemInfo().pixelRatio || 1);\n\n    adapter.onTouchStart((e) => {\n      const touch = e.touches ? e.touches[0] : e;\n      const x = touch.clientX || touch.pageX;\n      const y = touch.clientY || touch.pageY;\n      if (this.state === 'gameover' || this.state === 'levelcomplete') {\n        this.input.handleClick(x, y);\n        return;\n      }\n      if (this.state !== 'idle') return;\n      this.input.handleTouchStart(x, y);\n    });\n\n    adapter.onTouchMove((e) => {\n      const touch = e.touches ? e.touches[0] : e;\n      const x = touch.clientX || touch.pageX;\n      const y = touch.clientY || touch.pageY;\n      if (this.state !== 'idle') return;\n      this.input.handleTouchMove(x, y);\n    });\n\n    adapter.onTouchEnd(() => {\n      this.input.handleTouchEnd();\n    });\n\n    // Connect input callbacks\n    this.input.onSelect = (cell) => {\n      this.renderer.selectedCell = cell;\n      if (cell) adapter.vibrateShort();\n    };\n\n    this.input.onSwap = (r1, c1, r2, c2) => {\n      this._trySwap(r1, c1, r2, c2);\n    };\n\n    this.input.onBtnClick = (x, y) => {\n      if (this.state === 'gameover') {\n        const btn = this.renderer.retryBtn;\n        if (btn && x >= btn.x && x <= btn.x + btn.w && y >= btn.y && y <= btn.y + btn.h) {\n          this._restart();\n        }\n      }\n      if (this.state === 'levelcomplete') {\n        const btn = this.renderer.nextBtn;\n        if (btn && x >= btn.x && x <= btn.x + btn.w && y >= btn.y && y <= btn.y + btn.h) {\n          this._nextLevel();\n        }\n      }\n      // Bottom bar restart\n      const rbtn = this.renderer.restartBtn;\n      if (rbtn && x >= rbtn.x && x <= rbtn.x + rbtn.w && y >= rbtn.y && y <= rbtn.y + rbtn.h) {\n        this._restart();\n      }\n    };\n  }\n\n  _trySwap(r1, c1, r2, c2) {\n    adapter.vibrateShort();\n    this.state = 'swapping';\n    const { cellSize } = this.layout;\n\n    // Animate swap\n    const dx = (c2 - c1) * (cellSize + config.CELL_GAP);\n    const dy = (r2 - r1) * (cellSize + config.CELL_GAP);\n\n    this.anim.add(150, (t) => {\n      const e = easeOutQuad(t);\n      this.renderer.setPieceOffset(r1, c1, dx * e, dy * e);\n      this.renderer.setPieceOffset(r2, c2, -dx * e, -dy * e);\n    }, () => {\n      this.renderer.clearPieceOffset(r1, c1);\n      this.renderer.clearPieceOffset(r2, c2);\n      this.board.swap(r1, c1, r2, c2);\n\n      const matches = this.board.findMatches();\n      if (matches.length === 0) {\n        // Swap back\n        this.anim.add(150, (t) => {\n          const e = easeOutQuad(t);\n          this.renderer.setPieceOffset(r1, c1, -dx * e, -dy * e);\n          this.renderer.setPieceOffset(r2, c2, dx * e, dy * e);\n        }, () => {\n          this.renderer.clearPieceOffset(r1, c1);\n          this.renderer.clearPieceOffset(r2, c2);\n          this.board.swap(r1, c1, r2, c2);\n          this.state = 'idle';\n        });\n      } else {\n        this.score.useMove();\n        this.score.startCombo();\n        this._processMatches();\n      }\n    });\n  }\n\n  _processMatches() {\n    const matches = this.board.findMatches();\n    if (matches.length === 0) {\n      // Check for more moves\n      if (!this.board.hasValidMoves()) {\n        this.board.shuffle();\n      }\n      if (this.score.isLevelComplete()) {\n        this.state = 'levelcomplete';\n        this.score.saveBest();\n      } else if (this.score.isGameOver()) {\n        this.state = 'gameover';\n        this.score.saveBest();\n      } else {\n        this.state = 'idle';\n      }\n      return;\n    }\n\n    const combo = this.score.incrementCombo();\n    this.renderer.setComboText(combo);\n    this.renderer.screenShake = 1.5;\n\n    // Calculate match lengths for scoring\n    const matchGroups = this._groupMatches(matches);\n    let totalScore = 0;\n    for (const group of matchGroups) {\n      const pts = this.score.addScore(group.length);\n      totalScore += pts;\n      // Show score popup at center of match group\n      const avgR = group.reduce((s, m) => s + m.r, 0) / group.length;\n      const avgC = group.reduce((s, m) => s + m.c, 0) / group.length;\n      this.renderer.addScorePopup(avgR, avgC, pts);\n    }\n\n    // Animate removal\n    this.state = 'removing';\n    const toRemove = this.board.removeMatches(matches);\n\n    for (const { r, c, type } of toRemove) {\n      this.renderer.addParticles(r, c, type);\n    }\n\n    this.anim.add(200, (t) => {\n      for (const { r, c } of toRemove) {\n        this.renderer.setPieceScale(r, c, 1 - easeOutQuad(t));\n      }\n    }, () => {\n      for (const { r, c } of toRemove) {\n        this.renderer.clearPieceScale(r, c);\n      }\n      this._applyGravity();\n    });\n  }\n\n  _groupMatches(matches) {\n    // Simple: treat all matches in one pass as a single group per connected component\n    const set = new Set(matches.map(m => m.r + ',' + m.c));\n    const visited = new Set();\n    const groups = [];\n\n    for (const m of matches) {\n      const key = m.r + ',' + m.c;\n      if (visited.has(key)) continue;\n      const group = [];\n      const queue = [m];\n      while (queue.length > 0) {\n        const cur = queue.pop();\n        const ck = cur.r + ',' + cur.c;\n        if (visited.has(ck)) continue;\n        visited.add(ck);\n        group.push(cur);\n        for (const [dr, dc] of [[0,1],[0,-1],[1,0],[-1,0]]) {\n          const nk = (cur.r + dr) + ',' + (cur.c + dc);\n          if (set.has(nk) && !visited.has(nk)) {\n            queue.push({ r: cur.r + dr, c: cur.c + dc });\n          }\n        }\n      }\n      groups.push(group);\n    }\n    return groups;\n  }\n\n  _applyGravity() {\n    this.state = 'falling';\n    const moves = this.board.applyGravity();\n    const spawns = this.board.refill();\n    const { cellSize } = this.layout;\n    const allMoves = [...moves];\n\n    if (allMoves.length === 0 && spawns.length === 0) {\n      this._processMatches();\n      return;\n    }\n\n    // Combine gravity moves and spawns\n    const allAnims = [];\n    for (const m of moves) {\n      allAnims.push({\n        r: m.toR, c: m.toC,\n        fromDy: (m.fromR - m.toR) * (cellSize + config.CELL_GAP),\n      });\n    }\n    for (const s of spawns) {\n      allAnims.push({\n        r: s.r, c: s.c,\n        fromDy: (s.fromR - s.r) * (cellSize + config.CELL_GAP),\n      });\n    }\n\n    this.anim.add(300, (t) => {\n      const e = easeOutBounce(t);\n      for (const a of allAnims) {\n        this.renderer.setPieceOffset(a.r, a.c, 0, a.fromDy * (1 - e));\n      }\n    }, () => {\n      for (const a of allAnims) {\n        this.renderer.clearPieceOffset(a.r, a.c);\n      }\n      this._processMatches();\n    });\n  }\n\n  _restart() {\n    this.board.init();\n    this.score.reset();\n    this.anim.clear();\n    this.renderer.particles = [];\n    this.renderer.scorePopups = [];\n    this.renderer.comboText = null;\n    this.renderer.screenShake = 0;\n    this.renderer.pieceOffset = {};\n    this.renderer.pieceScale = {};\n    this.input.reset();\n    this.state = 'idle';\n  }\n\n  _nextLevel() {\n    this.score.nextLevel();\n    this.board.init();\n    this.anim.clear();\n    this.renderer.particles = [];\n    this.renderer.scorePopups = [];\n    this.renderer.comboText = null;\n    this.renderer.screenShake = 0;\n    this.renderer.pieceOffset = {};\n    this.renderer.pieceScale = {};\n    this.input.reset();\n    this.state = 'idle';\n  }\n\n  _loop() {\n    const now = Date.now();\n    const dt = Math.min((now - this._lastTime) / 1000, 0.1);\n    this._lastTime = now;\n\n    this.anim.update(dt * 1000);\n    this.renderer.updateEffects(dt);\n\n    // Draw\n    const r = this.renderer;\n    r.clear();\n    r.drawBackground();\n    r.drawTopBar(this.score.score, this.score.level, this.score.movesLeft, this.score.targetScore);\n    r.drawBoard();\n    r.drawPieces(this.board);\n    r.drawEffects();\n    r.drawBottomBar(() => this._restart());\n\n    if (this.state === 'gameover') {\n      r.drawGameOver(this.score.score, this.score.level, this.score.bestScore);\n    }\n    if (this.state === 'levelcomplete') {\n      r.drawLevelComplete(this.score.score, this.score.level, this.score.bestScore);\n    }\n\n    requestAnimationFrame(() => this._loop());\n  }\n}\n\n// --- Bootstrap ---\nnew Game();\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"5216bcb9-0926-4213-a537-65887a7ae3c9","uuid":"fb1a9c1a-d969-4258-b8c1-7291aab4a082"}
