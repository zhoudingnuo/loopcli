{"type":"assistant","message":{"id":"msg_20260523194554bfcc13a9ba774adb","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_7c39ed1bec2e4d58aed97b2c","name":"Write","input":{"file_path":"D:\\games\\match3-xiaoxiaoxiao\\index.html","content":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n  <title>消消消大作战</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    html, body {\n      width: 100%; height: 100%;\n      overflow: hidden;\n      background: #1A1A2E;\n      touch-action: none;\n      -webkit-touch-callout: none;\n      -webkit-user-select: none;\n      user-select: none;\n    }\n    canvas {\n      display: block;\n      width: 100%;\n      height: 100%;\n    }\n  </style>\n</head>\n<body>\n<script>\n// Browser polyfill for Douyin mini-game 'tt' API\nvar tt = {\n  createCanvas: function() { return document.querySelector('canvas') || document.createElement('canvas'); },\n  getSystemInfoSync: function() {\n    return {\n      windowWidth: window.innerWidth,\n      windowHeight: window.innerHeight,\n      pixelRatio: window.devicePixelRatio || 1,\n      platform: 'web'\n    };\n  },\n  onTouchStart: function(cb) { document.addEventListener('touchstart', function(e) { e.preventDefault(); cb(e); }, { passive: false }); },\n  onTouchMove: function(cb) { document.addEventListener('touchmove', function(e) { e.preventDefault(); cb(e); }, { passive: false }); },\n  onTouchEnd: function(cb) { document.addEventListener('touchend', function(e) { e.preventDefault(); cb(e); }); },\n  setStorageSync: function(k, v) { localStorage.setItem(k, JSON.stringify(v)); },\n  getStorageSync: function(k) { var v = localStorage.getItem(k); return v ? JSON.parse(v) : null; },\n  vibrateShort: function() { if (navigator.vibrate) navigator.vibrate(15); },\n  showModal: function(o) { var ok = confirm(o.content); if (o.success) o.success({ confirm: ok, cancel: !ok }); }\n};\n\n// Add canvas to DOM\nvar canvas = document.createElement('canvas');\ndocument.body.appendChild(canvas);\n</script>\n<script>\n// Module loader for browser (CommonJS -> browser shim)\nvar _modules = {};\nvar _cache = {};\nfunction defineModule(name, factory) { _modules[name] = factory; }\nfunction require(name) {\n  if (_cache[name]) return _cache[name];\n  if (!_modules[name]) throw new Error('Module not found: ' + name);\n  var module = { exports: {} };\n  _modules[name](module, module.exports, require);\n  _cache[name] = module.exports;\n  return module.exports;\n}\n</script>\n<script src=\"adapter/index.js\"></script>\n<script>\n// Wrap adapter module\n(function() {\n  var _orig = typeof module !== 'undefined' ? module : null;\n  if (typeof module === 'undefined') {\n    // Re-parse the adapter as a module\n    // Already loaded via script tag, tt is global\n  }\n})();\n</script>\n<!-- Re-define modules for browser -->\n<script>\n// adapter/index.js content (inlined for browser)\ndefineModule('./adapter/index', function(module, exports, require) {\n  var isTT = typeof tt !== 'undefined';\n  function createCanvas() { return document.querySelector('canvas:last-child') || document.createElement('canvas'); }\n  function createOffscreenCanvas() { return document.createElement('canvas'); }\n  function getSystemInfo() { return tt.getSystemInfoSync(); }\n  function onTouchStart(cb) { document.addEventListener('touchstart', function(e) { e.preventDefault(); cb(e); }, { passive: false }); }\n  function onTouchMove(cb) { document.addEventListener('touchmove', function(e) { e.preventDefault(); cb(e); }, { passive: false }); }\n  function onTouchEnd(cb) { document.addEventListener('touchend', function(e) { cb(e); }); }\n  function setStorage(k, v) { localStorage.setItem(k, JSON.stringify(v)); }\n  function getStorage(k) { var v = localStorage.getItem(k); return v ? JSON.parse(v) : null; }\n  function vibrateShort() { if (navigator.vibrate) navigator.vibrate(15); }\n  function showModal(o) { var ok = confirm(o.content); if (o.success) o.success({ confirm: ok, cancel: !ok }); }\n  module.exports = { isTT: isTT, createCanvas: createCanvas, createOffscreenCanvas: createOffscreenCanvas, getSystemInfo: getSystemInfo, onTouchStart: onTouchStart, onTouchMove: onTouchMove, onTouchEnd: onTouchEnd, setStorage: setStorage, getStorage: getStorage, vibrateShort: vibrateShort, showModal: showModal };\n});\n\ndefineModule('./js/config', function(module, exports, require) {\n  module.exports = {\n    GRID_SIZE: 8, PIECE_TYPES: 6,\n    PIECE_COLORS: ['#FF4757','#3742FA','#2ED573','#FFA502','#A55EEA','#FF6B81'],\n    PIECE_GLOW: ['#FF6B81','#5352ED','#7BED9F','#FFD32A','#D980FA','#FF9FF3'],\n    PIECE_SHAPES: ['circle','diamond','square','triangle','star','hexagon'],\n    BOARD_PADDING: 8, BOARD_BORDER_RADIUS: 12, CELL_GAP: 4,\n    BG_COLOR: '#1A1A2E', BOARD_BG: '#16213E', CELL_BG: '#0F3460',\n    SELECTED_COLOR: '#ECCC68', HINT_COLOR: 'rgba(255,255,255,0.3)',\n    TOP_BAR_HEIGHT: 100, BOTTOM_BAR_HEIGHT: 80,\n    ANIM_SWAP_SPEED: 6, ANIM_FALL_SPEED: 8, ANIM_REMOVE_SPEED: 4, ANIM_BOUNCE_DECAY: 0.6,\n    INITIAL_MOVES: 30,\n    LEVEL_TARGETS: [3000,5000,8000,12000,18000,25000,35000,50000],\n    SCORE_3_MATCH: 100, SCORE_4_MATCH: 250, SCORE_5_MATCH: 500, COMBO_MULTIPLIER: 0.5,\n    STORAGE_KEY_SCORE: 'x4_high_score', STORAGE_KEY_LEVEL: 'x4_max_level',\n    SWIPE_THRESHOLD: 20,\n  };\n});\n\ndefineModule('./js/utils', function(module, exports, require) {\n  function lerp(a,b,t){return a+(b-a)*t}\n  function easeOutBounce(t){if(t<1/2.75)return 7.5625*t*t;if(t<2/2.75)return 7.5625*(t-=1.5/2.75)*t+0.75;if(t<2.5/2.75)return 7.5625*(t-=2.25/2.75)*t+0.9375;return 7.5625*(t-=2.625/2.75)*t+0.984375}\n  function easeOutQuad(t){return 1-(1-t)*(1-t)}\n  function easeInOutCubic(t){return t<0.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2}\n  function randomInt(min,max){return Math.floor(Math.random()*(max-min+1))+min}\n  function clamp(val,min,max){return Math.max(min,Math.min(max,val))}\n  module.exports={lerp:lerp,easeOutBounce:easeOutBounce,easeOutQuad:easeOutQuad,easeInOutCubic:easeInOutCubic,randomInt:randomInt,clamp:clamp};\n});\n</script>\n<script src=\"js/board.js\"></script>\n<script src=\"js/animation.js\"></script>\n<script src=\"js/renderer.js\"></script>\n<script src=\"js/input.js\"></script>\n<script src=\"js/score-manager.js\"></script>\n<script>\n// Register the JS modules from their script-loaded globals\n// We need to re-wrap them since they use module.exports\n// These scripts already ran with `module` defined as {} in browser\n\n// Actually, let's use a simpler approach: load game.js directly\n// The browser module system will handle the require() calls\n</script>\n<script>\n// Board module\ndefineModule('./js/board', function(module, exports, require) {\n  var config = require('./js/config');\n  var utils = require('./js/utils');\n  var randomInt = utils.randomInt;\n\n  function Board() {\n    this.grid = [];\n    this.animating = false;\n    this.animations = [];\n    this.init();\n  }\n  Board.prototype.init = function() {\n    this.grid = [];\n    for (var r = 0; r < config.GRID_SIZE; r++) {\n      this.grid[r] = [];\n      for (var c = 0; c < config.GRID_SIZE; c++) {\n        this.grid[r][c] = this._randomPiece(r, c);\n      }\n    }\n    while (this._findMatches().length > 0) {\n      for (var r = 0; r < config.GRID_SIZE; r++) {\n        for (var c = 0; c < config.GRID_SIZE; c++) {\n          this.grid[r][c] = this._randomPiece(r, c);\n        }\n      }\n    }\n    this.animations = [];\n    this.animating = false;\n  };\n  Board.prototype._randomPiece = function(r, c) {\n    var forbidden = {};\n    if (c >= 2 && this.grid[r][c-1] === this.grid[r][c-2]) forbidden[this.grid[r][c-1]] = true;\n    if (r >= 2 && this.grid[r-1] && this.grid[r-2] && this.grid[r-1][c] === this.grid[r-2][c]) forbidden[this.grid[r-1][c]] = true;\n    var type;\n    do { type = randomInt(0, config.PIECE_TYPES - 1); } while (forbidden[type]);\n    return type;\n  };\n  Board.prototype.getPiece = function(r, c) {\n    if (r < 0 || r >= config.GRID_SIZE || c < 0 || c >= config.GRID_SIZE) return -1;\n    return this.grid[r][c];\n  };\n  Board.prototype.isAdjacent = function(r1,c1,r2,c2) { return (Math.abs(r1-r2)+Math.abs(c1-c2))===1; };\n  Board.prototype.swap = function(r1,c1,r2,c2) { var t=this.grid[r1][c1]; this.grid[r1][c1]=this.grid[r2][c2]; this.grid[r2][c2]=t; };\n  Board.prototype._findMatches = function() {\n    var matches = {};\n    for (var r = 0; r < config.GRID_SIZE; r++) {\n      for (var c = 0; c <= config.GRID_SIZE - 3; c++) {\n        var t = this.grid[r][c];\n        if (t < 0) continue;\n        if (this.grid[r][c+1]===t && this.grid[r][c+2]===t) {\n          var end = c+2;\n          while (end+1<config.GRID_SIZE && this.grid[r][end+1]===t) end++;\n          for (var i=c;i<=end;i++) matches[r+','+i]=true;\n        }\n      }\n    }\n    for (var c = 0; c < config.GRID_SIZE; c++) {\n      for (var r = 0; r <= config.GRID_SIZE - 3; r++) {\n        var t = this.grid[r][c];\n        if (t < 0) continue;\n        if (this.grid[r+1][c]===t && this.grid[r+2][c]===t) {\n          var end = r+2;\n          while (end+1<config.GRID_SIZE && this.grid[end+1][c]===t) end++;\n          for (var i=r;i<=end;i++) matches[i+','+c]=true;\n        }\n      }\n    }\n    var result = [];\n    for (var k in matches) {\n      var parts = k.split(',');\n      result.push({r:parseInt(parts[0]), c:parseInt(parts[1])});\n    }\n    return result;\n  };\n  Board.prototype.findMatches = function() { return this._findMatches(); };\n  Board.prototype.removeMatches = function(matches) {\n    var removed = [];\n    for (var i=0;i<matches.length;i++) {\n      var m = matches[i];\n      removed.push({r:m.r, c:m.c, type:this.grid[m.r][m.c]});\n      this.grid[m.r][m.c] = -1;\n    }\n    return removed;\n  };\n  Board.prototype.applyGravity = function() {\n    var moves = [];\n    for (var c=0;c<config.GRID_SIZE;c++) {\n      var wr = config.GRID_SIZE - 1;\n      for (var r=config.GRID_SIZE-1;r>=0;r--) {\n        if (this.grid[r][c]>=0) {\n          if (wr!==r) {\n            moves.push({fromR:r,fromC:c,toR:wr,toC:c});\n            this.grid[wr][c]=this.grid[r][c];\n            this.grid[r][c]=-1;\n          }\n          wr--;\n        }\n      }\n    }\n    return moves;\n  };\n  Board.prototype.refill = function() {\n    var spawns = [];\n    for (var c=0;c<config.GRID_SIZE;c++) {\n      var empty=0;\n      for (var r=0;r<config.GRID_SIZE;r++) if(this.grid[r][c]<0) empty++;\n      for (var r=empty-1;r>=0;r--) {\n        this.grid[r][c]=randomInt(0,config.PIECE_TYPES-1);\n        spawns.push({r:r,c:c,fromR:r-empty});\n      }\n    }\n    return spawns;\n  };\n  Board.prototype.hasValidMoves = function() {\n    for (var r=0;r<config.GRID_SIZE;r++) {\n      for (var c=0;c<config.GRID_SIZE;c++) {\n        if(c+1<config.GRID_SIZE){this.swap(r,c,r,c+1);if(this._findMatches().length>0){this.swap(r,c,r,c+1);return true}this.swap(r,c,r,c+1)}\n        if(r+1<config.GRID_SIZE){this.swap(r,c,r+1,c);if(this._findMatches().length>0){this.swap(r,c,r+1,c);return true}this.swap(r,c,r+1,c)}\n      }\n    }\n    return false;\n  };\n  Board.prototype.shuffle = function() {\n    var pieces=[];\n    for(var r=0;r<config.GRID_SIZE;r++)for(var c=0;c<config.GRID_SIZE;c++)pieces.push(this.grid[r][c]);\n    for(var i=pieces.length-1;i>0;i--){var j=randomInt(0,i);var t=pieces[i];pieces[i]=pieces[j];pieces[j]=t}\n    var idx=0;\n    for(var r=0;r<config.GRID_SIZE;r++)for(var c=0;c<config.GRID_SIZE;c++)this.grid[r][c]=pieces[idx++];\n    while(this._findMatches().length>0){var ms=this._findMatches();for(var i=0;i<ms.length;i++)this.grid[ms[i].r][ms[i].c]=randomInt(0,config.PIECE_TYPES-1)}\n    if(!this.hasValidMoves())this.shuffle();\n  };\n  module.exports = Board;\n});\n\n// Animation module\ndefineModule('./js/animation', function(module, exports, require) {\n  function Animation(duration, updateFn, completeFn) {\n    this.duration = duration; this.updateFn = updateFn; this.completeFn = completeFn;\n    this.elapsed = 0; this.done = false;\n  }\n  Animation.prototype.update = function(dt) {\n    if (this.done) return;\n    this.elapsed += dt;\n    var t = Math.min(this.elapsed / this.duration, 1);\n    this.updateFn(t);\n    if (t >= 1) { this.done = true; if (this.completeFn) this.completeFn(); }\n  };\n\n  function AnimationManager() { this.anims = []; }\n  AnimationManager.prototype.add = function(dur, update, complete) {\n    var a = new Animation(dur, update, complete); this.anims.push(a); return a;\n  };\n  AnimationManager.prototype.update = function(dt) {\n    for (var i=this.anims.length-1;i>=0;i--) { this.anims[i].update(dt); if(this.anims[i].done) this.anims.splice(i,1); }\n  };\n  AnimationManager.prototype.__defineGetter__('busy', function() { return this.anims.length > 0; });\n  AnimationManager.prototype.clear = function() { this.anims = []; };\n\n  module.exports = AnimationManager;\n});\n\n// Input module\ndefineModule('./js/input', function(module, exports, require) {\n  var config = require('./js/config');\n  function InputHandler(layout) {\n    this.layout = layout; this.onSelect = null; this.onSwap = null; this.onBtnClick = null;\n    this._touchStartPos = null; this._selectedCell = null;\n  }\n  InputHandler.prototype.handleTouchStart = function(x, y) {\n    this._touchStartPos = {x:x, y:y};\n    var cell = this._pixelToCell(x, y);\n    if (cell) {\n      if (this._selectedCell) {\n        var r1=this._selectedCell.r, c1=this._selectedCell.c, r2=cell.r, c2=cell.c;\n        if (r1===r2&&c1===c2) { this._selectedCell=null; if(this.onSelect)this.onSelect(null); }\n        else if ((Math.abs(r1-r2)+Math.abs(c1-c2))===1) { if(this.onSwap)this.onSwap(r1,c1,r2,c2); this._selectedCell=null; if(this.onSelect)this.onSelect(null); }\n        else { this._selectedCell=cell; if(this.onSelect)this.onSelect(cell); }\n      } else { this._selectedCell=cell; if(this.onSelect)this.onSelect(cell); }\n    }\n  };\n  InputHandler.prototype.handleTouchMove = function(x, y) {\n    if(!this._touchStartPos||!this._selectedCell)return;\n    var dx=x-this._touchStartPos.x, dy=y-this._touchStartPos.y, dist=Math.sqrt(dx*dx+dy*dy);\n    if(dist>=config.SWIPE_THRESHOLD){\n      var dr=0,dc=0;\n      if(Math.abs(dx)>Math.abs(dy)){dc=dx>0?1:-1}else{dr=dy>0?1:-1}\n      var r2=this._selectedCell.r+dr, c2=this._selectedCell.c+dc;\n      if(r2>=0&&r2<config.GRID_SIZE&&c2>=0&&c2<config.GRID_SIZE){\n        if(this.onSwap)this.onSwap(this._selectedCell.r,this._selectedCell.c,r2,c2);\n        this._selectedCell=null; this._touchStartPos=null; if(this.onSelect)this.onSelect(null);\n      }\n    }\n  };\n  InputHandler.prototype.handleTouchEnd = function() { this._touchStartPos=null; };\n  InputHandler.prototype.handleClick = function(x,y) { if(this.onBtnClick)this.onBtnClick(x,y); };\n  InputHandler.prototype._pixelToCell = function(px,py) {\n    var x=this.layout.x, y=this.layout.y, cs=this.layout.cellSize, gap=config.CELL_GAP;\n    var c=Math.floor((px-x)/(cs+gap)), r=Math.floor((py-y)/(cs+gap));\n    if(r<0||r>=config.GRID_SIZE||c<0||c>=config.GRID_SIZE)return null;\n    var cx2=x+c*(cs+gap), cy2=y+r*(cs+gap);\n    if(px>=cx2&&px<=cx2+cs&&py>=cy2&&py<=cy2+cs) return {r:r,c:c};\n    return null;\n  };\n  InputHandler.prototype.reset = function() { this._selectedCell=null; this._touchStartPos=null; };\n  module.exports = InputHandler;\n});\n\n// ScoreManager module\ndefineModule('./js/score-manager', function(module, exports, require) {\n  var config = require('./js/config');\n  var adapter = require('./adapter/index');\n  function ScoreManager() {\n    this.score=0; this.level=1; this.movesLeft=config.INITIAL_MOVES; this.combo=0;\n    this.bestScore=adapter.getStorage(config.STORAGE_KEY_SCORE)||0;\n    this.maxLevel=adapter.getStorage(config.STORAGE_KEY_LEVEL)||1;\n  }\n  ScoreManager.prototype.__defineGetter__('targetScore', function() {\n    var idx=Math.min(this.level-1,config.LEVEL_TARGETS.length-1); return config.LEVEL_TARGETS[idx];\n  });\n  ScoreManager.prototype.addScore = function(matchCount) {\n    var base; if(matchCount>=5)base=config.SCORE_5_MATCH;else if(matchCount>=4)base=config.SCORE_4_MATCH;else base=config.SCORE_3_MATCH;\n    var mult=1+this.combo*config.COMBO_MULTIPLIER, pts=Math.floor(base*mult); this.score+=pts; return pts;\n  };\n  ScoreManager.prototype.useMove = function() { this.movesLeft--; };\n  ScoreManager.prototype.startCombo = function() { this.combo=0; };\n  ScoreManager.prototype.incrementCombo = function() { this.combo++; return this.combo; };\n  ScoreManager.prototype.isLevelComplete = function() { return this.score>=this.targetScore; };\n  ScoreManager.prototype.isGameOver = function() { return this.movesLeft<=0&&!this.isLevelComplete(); };\n  ScoreManager.prototype.nextLevel = function() {\n    this.level++; this.movesLeft=config.INITIAL_MOVES; this.combo=0;\n    if(this.level>this.maxLevel){this.maxLevel=this.level;adapter.setStorage(config.STORAGE_KEY_LEVEL,this.maxLevel)}\n  };\n  ScoreManager.prototype.reset = function() { this.score=0; this.level=1; this.movesLeft=config.INITIAL_MOVES; this.combo=0; };\n  ScoreManager.prototype.saveBest = function() {\n    if(this.score>this.bestScore){this.bestScore=this.score;adapter.setStorage(config.STORAGE_KEY_SCORE,this.bestScore)}\n  };\n  module.exports = ScoreManager;\n});\n</script>\n<script>\n// Renderer module\ndefineModule('./js/renderer', function(module, exports, require) {\n  var config = require('./js/config');\n  var utils = require('./js/utils');\n  var easeOutBounce = utils.easeOutBounce;\n  var easeOutQuad = utils.easeOutQuad;\n\n  function Renderer(canvas, boardLayout) {\n    this.canvas = canvas; this.ctx = canvas.getContext('2d'); this.layout = boardLayout;\n    this.pieceScale = {}; this.pieceOffset = {}; this.selectedCell = null;\n    this.particles = []; this.comboText = null; this.scorePopups = [];\n    this.screenShake = 0; this._restartBtn = null; this._retryBtn = null; this._nextBtn = null;\n  }\n  Renderer.prototype.clear = function() { this.ctx.clearRect(0,0,this.canvas.width,this.canvas.height); };\n  Renderer.prototype.drawBackground = function() { this.ctx.fillStyle=config.BG_COLOR; this.ctx.fillRect(0,0,this.canvas.width,this.canvas.height); };\n\n  Renderer.prototype.drawBoard = function() {\n    var ctx=this.ctx, l=this.layout;\n    ctx.fillStyle=config.BOARD_BG;\n    this._roundRect(l.x-config.BOARD_PADDING,l.y-config.BOARD_PADDING,l.width+config.BOARD_PADDING*2,l.height+config.BOARD_PADDING*2,config.BOARD_BORDER_RADIUS);\n    ctx.fill();\n    for(var r=0;r<config.GRID_SIZE;r++){for(var c=0;c<config.GRID_SIZE;c++){\n      var cx=l.x+c*(l.cellSize+config.CELL_GAP), cy=l.y+r*(l.cellSize+config.CELL_GAP);\n      ctx.fillStyle=config.CELL_BG; this._roundRect(cx,cy,l.cellSize,l.cellSize,6); ctx.fill();\n    }}\n  };\n\n  Renderer.prototype.drawPieces = function(board) {\n    var ctx=this.ctx, l=this.layout;\n    for(var r=0;r<config.GRID_SIZE;r++){for(var c=0;c<config.GRID_SIZE;c++){\n      var type=board.getPiece(r,c); if(type<0)continue;\n      var px=l.x+c*(l.cellSize+config.CELL_GAP)+l.cellSize/2;\n      var py=l.y+r*(l.cellSize+config.CELL_GAP)+l.cellSize/2;\n      var key=r+','+c, off=this.pieceOffset[key];\n      if(off){px+=off.dx;py+=off.dy}\n      var scale=this.pieceScale[key]||1, radius=(l.cellSize/2-4)*scale;\n      if(radius<=0)continue;\n      this._drawPiece(ctx,px,py,radius,type);\n      if(this.selectedCell&&this.selectedCell.r===r&&this.selectedCell.c===c){\n        ctx.strokeStyle=config.SELECTED_COLOR;ctx.lineWidth=3;ctx.beginPath();ctx.arc(px,py,radius+2,0,Math.PI*2);ctx.stroke();\n        var pulse=0.5+0.5*Math.sin(Date.now()/150);\n        ctx.strokeStyle='rgba(236,204,104,'+(pulse*0.5)+')';ctx.lineWidth=2;ctx.beginPath();ctx.arc(px,py,radius+5,0,Math.PI*2);ctx.stroke();\n      }\n    }}\n  };\n\n  Renderer.prototype._drawPiece = function(ctx,px,py,radius,type) {\n    var color=config.PIECE_COLORS[type], glow=config.PIECE_GLOW[type], shape=config.PIECE_SHAPES[type];\n    ctx.fillStyle='rgba(0,0,0,0.2)';ctx.beginPath();ctx.arc(px+2,py+2,radius,0,Math.PI*2);ctx.fill();\n    var grad=ctx.createRadialGradient(px-radius*0.3,py-radius*0.3,0,px,py,radius);\n    grad.addColorStop(0,glow);grad.addColorStop(0.7,color);grad.addColorStop(1,this._darken(color,0.7));\n    ctx.fillStyle=grad;ctx.beginPath();\n    switch(shape){\n      case 'circle':ctx.arc(px,py,radius,0,Math.PI*2);break;\n      case 'diamond':ctx.moveTo(px,py-radius);ctx.lineTo(px+radius,py);ctx.lineTo(px,py+radius);ctx.lineTo(px-radius,py);break;\n      case 'square':var s=radius*0.8;this._roundRect(px-s,py-s,s*2,s*2,4);break;\n      case 'triangle':ctx.moveTo(px,py-radius);ctx.lineTo(px+radius*0.87,py+radius*0.5);ctx.lineTo(px-radius*0.87,py+radius*0.5);break;\n      case 'star':this._drawStar(ctx,px,py,5,radius,radius*0.5);break;\n      case 'hexagon':this._drawPolygon(ctx,px,py,radius,6);break;\n    }\n    ctx.fill();\n    ctx.fillStyle='rgba(255,255,255,0.3)';ctx.beginPath();ctx.ellipse(px-radius*0.2,py-radius*0.3,radius*0.4,radius*0.25,-0.3,0,Math.PI*2);ctx.fill();\n  };\n\n  Renderer.prototype._drawStar = function(ctx,cx,cy,pts,oR,iR){ctx.beginPath();for(var i=0;i<pts*2;i++){var r=i%2===0?oR:iR,a=(Math.PI/pts)*i-Math.PI/2,x=cx+Math.cos(a)*r,y=cy+Math.sin(a)*r;if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y)}ctx.closePath()};\n  Renderer.prototype._drawPolygon = function(ctx,cx,cy,r,sides){ctx.beginPath();for(var i=0;i<sides;i++){var a=(Math.PI*2/sides)*i-Math.PI/2,x=cx+Math.cos(a)*r,y=cy+Math.sin(a)*r;if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y)}ctx.closePath()};\n\n  Renderer.prototype.drawTopBar = function(score,level,movesLeft,target) {\n    var ctx=this.ctx, cw=this.canvas.width, by=0, bh=this.layout.topBarHeight;\n    var dpr=(adapter.getSystemInfo().pixelRatio||1);\n    var w=cw/dpr;\n    ctx.fillStyle='rgba(22,33,62,0.9)';ctx.fillRect(0,by,cw,bh);\n    ctx.save(); ctx.setTransform(1,0,0,1,0,0); ctx.scale(dpr,dpr);\n    ctx.fillStyle='#FFFFFF';ctx.font='bold 20px Arial';ctx.textAlign='left';ctx.fillText('分数',16,by/dpr+30);\n    ctx.font='bold 28px Arial';ctx.fillStyle='#FFD700';ctx.fillText(score.toLocaleString(),16,by/dpr+62);\n    ctx.fillStyle='#FFFFFF';ctx.font='bold 18px Arial';ctx.textAlign='center';ctx.fillText('第 '+level+' 关',w/2,by/dpr+30);\n    var progW=w*0.5,progH=12,progX=(w-progW)/2,progY=by/dpr+42;\n    ctx.fillStyle='rgba(255,255,255,0.15)';this._roundRect(progX,progY,progW,progH,6);ctx.fill();\n    var prog=Math.min(score/target,1);\n    if(prog>0){var pg=ctx.createLinearGradient(progX,0,progX+progW,0);pg.addColorStop(0,'#FFD700');pg.addColorStop(1,'#FF6348');ctx.fillStyle=pg;this._roundRect(progX,progY,progW*prog,progH,6);ctx.fill()}\n    ctx.fillStyle='#FFFFFF';ctx.font='bold 18px Arial';ctx.textAlign='right';ctx.fillText('剩余步数',w-16,by/dpr+30);\n    ctx.font='bold 28px Arial';ctx.fillStyle=movesLeft<=5?'#FF4757':'#2ED573';ctx.fillText(movesLeft.toString(),w-16,by/dpr+62);\n    ctx.restore();\n  };\n\n  Renderer.prototype.drawBottomBar = function() {\n    var ctx=this.ctx,cw=this.canvas.width,dpr=(adapter.getSystemInfo().pixelRatio||1),w=cw/dpr;\n    var barY=this.canvas.height/dpr-this.layout.bottomBarHeight;\n    ctx.save();ctx.setTransform(1,0,0,1,0,0);ctx.scale(dpr,dpr);\n    ctx.fillStyle='rgba(22,33,62,0.9)';ctx.fillRect(0,barY,w,this.layout.bottomBarHeight);\n    var btnW=140,btnH=44,btnX=(w-btnW)/2,btnY=barY+(this.layout.bottomBarHeight-btnH)/2;\n    ctx.fillStyle='#FF6348';this._roundRect(btnX,btnY,btnW,btnH,22);ctx.fill();\n    ctx.fillStyle='#FFFFFF';ctx.font='bold 18px Arial';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('重新开始',w/2,btnY+btnH/2);ctx.textBaseline='alphabetic';\n    ctx.restore();\n    this._restartBtn={x:btnX,y:btnY,w:btnW,h:btnH};\n  }