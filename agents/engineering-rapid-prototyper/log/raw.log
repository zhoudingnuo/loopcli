{"type":"assistant","message":{"id":"msg_202605232335183974e55449c741c2","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_6f1008e79e764e0dbb648504","name":"Write","input":{"file_path":"D:\\game-projects\\steam-ancient-mystery\\src\\game\\EvidenceCollector.ts","content":"import { Renderer } from '../renderer/Renderer';\nimport { GameState } from './GameState';\nimport { InputManager } from './InputManager';\n\nexport type EvidenceCategory = 'key' | 'normal' | 'misleading';\n\nexport interface EvidenceItem {\n  id: string;\n  name: string;\n  description: string;\n  category: EvidenceCategory;\n  icon?: string;\n  discoveredAt: string;\n  discoveredTime: number;\n  combinable?: string[];\n}\n\nexport class EvidenceCollector {\n  private evidenceDB: Map<string, EvidenceItem> = new Map();\n  private isOpen = false;\n  private selectedIndex = -1;\n  private scrollOffset = 0;\n  private animAlpha = 0;\n  private flashId: string | null = null;\n  private flashTimer = 0;\n  private onEvidenceUsed?: (evidence: EvidenceItem) => void;\n\n  constructor(\n    private renderer: Renderer,\n    private state: GameState,\n    private input: InputManager\n  ) {\n    this.setupInput();\n  }\n\n  registerEvidence(items: EvidenceItem[]) {\n    items.forEach((item) => this.evidenceDB.set(item.id, item));\n  }\n\n  setUsedCallback(cb: (evidence: EvidenceItem) => void) {\n    this.onEvidenceUsed = cb;\n  }\n\n  collect(evidenceId: string): boolean {\n    if (this.state.hasEvidence(evidenceId)) return false;\n    this.state.addEvidence(evidenceId);\n    this.flashId = evidenceId;\n    this.flashTimer = 2;\n    return true;\n  }\n\n  open() {\n    this.isOpen = true;\n    this.selectedIndex = -1;\n    this.scrollOffset = 0;\n    this.animAlpha = 0;\n  }\n\n  close() {\n    this.isOpen = false;\n    this.selectedIndex = -1;\n  }\n\n  toggle() {\n    if (this.isOpen) this.close();\n    else this.open();\n  }\n\n  getIsOpen(): boolean { return this.isOpen; }\n\n  getCollectedEvidence(): EvidenceItem[] {\n    return this.state.evidence\n      .map((id) => this.evidenceDB.get(id))\n      .filter((e): e is EvidenceItem => e !== undefined);\n  }\n\n  getEvidenceById(id: string): EvidenceItem | undefined {\n    return this.evidenceDB.get(id);\n  }\n\n  private setupInput() {\n    this.input.onClick((e) => {\n      if (e.type !== 'up') return;\n      if (!this.isOpen) return;\n      this.handleClick(e.x, e.y);\n    });\n  }\n\n  private handleClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    const panelW = Math.min(420, w * 0.35);\n    const panelH = h - 80;\n    const panelX = w - panelW - 20;\n    const panelY = 40;\n\n    if (!this.isInRect(x, y, panelX, panelY, panelW, panelH)) {\n      this.close();\n      return;\n    }\n\n    const listX = panelX + 16;\n    const listY = panelY + 60;\n    const itemH = 52;\n    const listH = panelH - 140;\n\n    const items = this.getCollectedEvidence();\n    for (let i = 0; i < items.length; i++) {\n      const iy = listY + i * itemH - this.scrollOffset;\n      if (iy < listY - itemH || iy > listY + listH) continue;\n      if (this.isInRect(x, y, listX, iy, panelW - 32, itemH - 4)) {\n        this.selectedIndex = this.selectedIndex === i ? -1 : i;\n        return;\n      }\n    }\n\n    const closeBtnY = panelY + panelH - 50;\n    if (this.isInRect(x, y, panelX + panelW / 2 - 60, closeBtnY, 120, 36)) {\n      this.close();\n    }\n  }\n\n  update(dt: number) {\n    if (!this.isOpen) return;\n    this.animAlpha = Math.min(1, this.animAlpha + dt * 5);\n    if (this.flashTimer > 0) this.flashTimer -= dt;\n    if (this.flashTimer <= 0) this.flashId = null;\n  }\n\n  render() {\n    if (!this.isOpen) return;\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.save();\n    ctx.globalAlpha = this.animAlpha * 0.4;\n    ctx.fillStyle = '#0a0806';\n    ctx.fillRect(0, 0, w, h);\n    ctx.restore();\n\n    ctx.save();\n    ctx.globalAlpha = this.animAlpha;\n\n    const panelW = Math.min(420, w * 0.35);\n    const panelH = h - 80;\n    const panelX = w - panelW - 20;\n    const panelY = 40;\n\n    this.renderer.drawRoundRect(panelX, panelY, panelW, panelH, 8, '#1a140e', '#3a2a1a');\n    ctx.strokeStyle = '#5a4030';\n    ctx.lineWidth = 1;\n    ctx.strokeRect(panelX + 3, panelY + 3, panelW - 6, panelH - 6);\n\n    this.renderer.drawText('物 证', panelX + panelW / 2, panelY + 18, {\n      font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n      color: '#c8a882', align: 'center',\n    });\n\n    const items = this.getCollectedEvidence();\n    const listX = panelX + 16;\n    const listY = panelY + 60;\n    const itemH = 52;\n    const listH = panelH - 140;\n\n    ctx.save();\n    ctx.beginPath();\n    ctx.rect(panelX + 4, listY - 4, panelW - 8, listH + 8);\n    ctx.clip();\n\n    const categoryColors: Record<EvidenceCategory, string> = {\n      key: '#c8a040',\n      normal: '#a08870',\n      misleading: '#8a4a4a',\n    };\n\n    items.forEach((item, i) => {\n      const iy = listY + i * itemH - this.scrollOffset;\n      if (iy < listY - itemH || iy > listY + listH) return;\n\n      const isSelected = this.selectedIndex === i;\n      const isFlash = this.flashId === item.id;\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, listX, iy, panelW - 32, itemH - 4);\n\n      if (isSelected) {\n        ctx.fillStyle = 'rgba(200, 168, 130, 0.15)';\n        ctx.fillRect(listX, iy, panelW - 32, itemH - 4);\n      } else if (isHover) {\n        ctx.fillStyle = 'rgba(200, 168, 130, 0.07)';\n        ctx.fillRect(listX, iy, panelW - 32, itemH - 4);\n      }\n\n      const catColor = categoryColors[item.category];\n      ctx.fillStyle = catColor;\n      ctx.beginPath();\n      ctx.arc(listX + 14, iy + itemH / 2 - 2, 5, 0, Math.PI * 2);\n      ctx.fill();\n\n      this.renderer.drawText(item.name, listX + 28, iy + 6, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n        color: isFlash ? '#f0d8a0' : '#d8c8b0',\n      });\n\n      const catLabel: Record<EvidenceCategory, string> = { key: '关键', normal: '普通', misleading: '存疑' };\n      this.renderer.drawText(catLabel[item.category], listX + 28, iy + 28, {\n        font: '13px sans-serif', color: catColor,\n      });\n\n      if (isFlash) {\n        ctx.save();\n        ctx.globalAlpha = Math.min(1, this.flashTimer) * 0.2;\n        ctx.fillStyle = '#f0d8a0';\n        ctx.fillRect(listX, iy, panelW - 32, itemH - 4);\n        ctx.restore();\n      }\n    });\n\n    ctx.restore();\n\n    if (this.selectedIndex >= 0 && this.selectedIndex < items.length) {\n      const item = items[this.selectedIndex];\n      const detailY = listY + listH + 10;\n\n      this.renderer.drawRoundRect(listX, detailY, panelW - 32, 70, 4, '#14100a', '#3a2a1a');\n\n      this.renderer.drawText(item.name, listX + 12, detailY + 8, {\n        font: 'bold 18px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2',\n      });\n      this.renderWrappedText(item.description, listX + 12, detailY + 34, panelW - 56, 30, {\n        font: '15px \"SimSun\", \"Noto Serif SC\", serif', color: '#a09080',\n      });\n    }\n\n    if (items.length === 0) {\n      this.renderer.drawText('尚未收集到物证', panelX + panelW / 2, listY + 40, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n      });\n    }\n\n    const closeBtnY = panelY + panelH - 50;\n    const closeHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + panelW / 2 - 60, closeBtnY, 120, 36);\n    this.renderer.drawRoundRect(panelX + panelW / 2 - 60, closeBtnY, 120, 36, 4,\n      closeHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('关闭', panelX + panelW / 2, closeBtnY + 8, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n      color: closeHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n\n    ctx.restore();\n\n    this.renderFlashNotification(ctx, w, h);\n  }\n\n  private renderFlashNotification(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    if (!this.flashId || this.flashTimer <= 0) return;\n    const item = this.evidenceDB.get(this.flashId);\n    if (!item) return;\n\n    const alpha = Math.min(1, this.flashTimer);\n    const ny = h - 80 - (2 - this.flashTimer) * 60;\n\n    ctx.save();\n    ctx.globalAlpha = alpha;\n    this.renderer.drawRoundRect(w / 2 - 160, ny, 320, 48, 6, '#2a1a0e', '#8b4513');\n    this.renderer.drawText(`获得物证: ${item.name}`, w / 2, ny + 14, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#f0d8a0', align: 'center',\n    });\n    ctx.restore();\n  }\n\n  private renderWrappedText(text: string, x: number, y: number, maxW: number, maxH: number,\n    opts: { font?: string; color?: string }) {\n    const ctx = this.renderer.context;\n    ctx.save();\n    ctx.font = opts.font ?? '18px \"SimSun\", \"Noto Serif SC\", serif';\n    ctx.fillStyle = opts.color ?? '#d8c8b0';\n\n    let lineY = y;\n    let line = '';\n    for (const ch of text) {\n      const test = line + ch;\n      if (ctx.measureText(test).width > maxW) {\n        ctx.fillText(line, x, lineY);\n        line = ch;\n        lineY += 22;\n        if (lineY - y > maxH) break;\n      } else {\n        line = test;\n      }\n    }\n    if (line) ctx.fillText(line, x, lineY);\n    ctx.restore();\n  }\n\n  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"bb710ec1-068d-4a4a-9438-6a706a63a8a0","uuid":"6be08919-f622-4a95-abc1-9ef49a979c48"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6f1008e79e764e0dbb648504","type":"tool_result","content":"File created successfully at: D:\\game-projects\\steam-ancient-mystery\\src\\game\\EvidenceCollector.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"bb710ec1-068d-4a4a-9438-6a706a63a8a0","uuid":"2dd8a1cd-d208-4bb7-aaf2-48165dd8b13e","timestamp":"2026-05-23T15:36:08.534Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\steam-ancient-mystery\\src\\game\\EvidenceCollector.ts","content":"import { Renderer } from '../renderer/Renderer';\nimport { GameState } from './GameState';\nimport { InputManager } from './InputManager';\n\nexport type EvidenceCategory = 'key' | 'normal' | 'misleading';\n\nexport interface EvidenceItem {\n  id: string;\n  name: string;\n  description: string;\n  category: EvidenceCategory;\n  icon?: string;\n  discoveredAt: string;\n  discoveredTime: number;\n  combinable?: string[];\n}\n\nexport class EvidenceCollector {\n  private evidenceDB: Map<string, EvidenceItem> = new Map();\n  private isOpen = false;\n  private selectedIndex = -1;\n  private scrollOffset = 0;\n  private animAlpha = 0;\n  private flashId: string | null = null;\n  private flashTimer = 0;\n  private onEvidenceUsed?: (evidence: EvidenceItem) => void;\n\n  constructor(\n    private renderer: Renderer,\n    private state: GameState,\n    private input: InputManager\n  ) {\n    this.setupInput();\n  }\n\n  registerEvidence(items: EvidenceItem[]) {\n    items.forEach((item) => this.evidenceDB.set(item.id, item));\n  }\n\n  setUsedCallback(cb: (evidence: EvidenceItem) => void) {\n    this.onEvidenceUsed = cb;\n  }\n\n  collect(evidenceId: string): boolean {\n    if (this.state.hasEvidence(evidenceId)) return false;\n    this.state.addEvidence(evidenceId);\n    this.flashId = evidenceId;\n    this.flashTimer = 2;\n    return true;\n  }\n\n  open() {\n    this.isOpen = true;\n    this.selectedIndex = -1;\n    this.scrollOffset = 0;\n    this.animAlpha = 0;\n  }\n\n  close() {\n    this.isOpen = false;\n    this.selectedIndex = -1;\n  }\n\n  toggle() {\n    if (this.isOpen) this.close();\n    else this.open();\n  }\n\n  getIsOpen(): boolean { return this.isOpen; }\n\n  getCollectedEvidence(): EvidenceItem[] {\n    return this.state.evidence\n      .map((id) => this.evidenceDB.get(id))\n      .filter((e): e is EvidenceItem => e !== undefined);\n  }\n\n  getEvidenceById(id: string): EvidenceItem | undefined {\n    return this.evidenceDB.get(id);\n  }\n\n  private setupInput() {\n    this.input.onClick((e) => {\n      if (e.type !== 'up') return;\n      if (!this.isOpen) return;\n      this.handleClick(e.x, e.y);\n    });\n  }\n\n  private handleClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    const panelW = Math.min(420, w * 0.35);\n    const panelH = h - 80;\n    const panelX = w - panelW - 20;\n    const panelY = 40;\n\n    if (!this.isInRect(x, y, panelX, panelY, panelW, panelH)) {\n      this.close();\n      return;\n    }\n\n    const listX = panelX + 16;\n    const listY = panelY + 60;\n    const itemH = 52;\n    const listH = panelH - 140;\n\n    const items = this.getCollectedEvidence();\n    for (let i = 0; i < items.length; i++) {\n      const iy = listY + i * itemH - this.scrollOffset;\n      if (iy < listY - itemH || iy > listY + listH) continue;\n      if (this.isInRect(x, y, listX, iy, panelW - 32, itemH - 4)) {\n        this.selectedIndex = this.selectedIndex === i ? -1 : i;\n        return;\n      }\n    }\n\n    const closeBtnY = panelY + panelH - 50;\n    if (this.isInRect(x, y, panelX + panelW / 2 - 60, closeBtnY, 120, 36)) {\n      this.close();\n    }\n  }\n\n  update(dt: number) {\n    if (!this.isOpen) return;\n    this.animAlpha = Math.min(1, this.animAlpha + dt * 5);\n    if (this.flashTimer > 0) this.flashTimer -= dt;\n    if (this.flashTimer <= 0) this.flashId = null;\n  }\n\n  render() {\n    if (!this.isOpen) return;\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.save();\n    ctx.globalAlpha = this.animAlpha * 0.4;\n    ctx.fillStyle = '#0a0806';\n    ctx.fillRect(0, 0, w, h);\n    ctx.restore();\n\n    ctx.save();\n    ctx.globalAlpha = this.animAlpha;\n\n    const panelW = Math.min(420, w * 0.35);\n    const panelH = h - 80;\n    const panelX = w - panelW - 20;\n    const panelY = 40;\n\n    this.renderer.drawRoundRect(panelX, panelY, panelW, panelH, 8, '#1a140e', '#3a2a1a');\n    ctx.strokeStyle = '#5a4030';\n    ctx.lineWidth = 1;\n    ctx.strokeRect(panelX + 3, panelY + 3, panelW - 6, panelH - 6);\n\n    this.renderer.drawText('物 证', panelX + panelW / 2, panelY + 18, {\n      font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n      color: '#c8a882', align: 'center',\n    });\n\n    const items = this.getCollectedEvidence();\n    const listX = panelX + 16;\n    const listY = panelY + 60;\n    const itemH = 52;\n    const listH = panelH - 140;\n\n    ctx.save();\n    ctx.beginPath();\n    ctx.rect(panelX + 4, listY - 4, panelW - 8, listH + 8);\n    ctx.clip();\n\n    const categoryColors: Record<EvidenceCategory, string> = {\n      key: '#c8a040',\n      normal: '#a08870',\n      misleading: '#8a4a4a',\n    };\n\n    items.forEach((item, i) => {\n      const iy = listY + i * itemH - this.scrollOffset;\n      if (iy < listY - itemH || iy > listY + listH) return;\n\n      const isSelected = this.selectedIndex === i;\n      const isFlash = this.flashId === item.id;\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, listX, iy, panelW - 32, itemH - 4);\n\n      if (isSelected) {\n        ctx.fillStyle = 'rgba(200, 168, 130, 0.15)';\n        ctx.fillRect(listX, iy, panelW - 32, itemH - 4);\n      } else if (isHover) {\n        ctx.fillStyle = 'rgba(200, 168, 130, 0.07)';\n        ctx.fillRect(listX, iy, panelW - 32, itemH - 4);\n      }\n\n      const catColor = categoryColors[item.category];\n      ctx.fillStyle = catColor;\n      ctx.beginPath();\n      ctx.arc(listX + 14, iy + itemH / 2 - 2, 5, 0, Math.PI * 2);\n      ctx.fill();\n\n      this.renderer.drawText(item.name, listX + 28, iy + 6, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n        color: isFlash ? '#f0d8a0' : '#d8c8b0',\n      });\n\n      const catLabel: Record<EvidenceCategory, string> = { key: '关键', normal: '普通', misleading: '存疑' };\n      this.renderer.drawText(catLabel[item.category], listX + 28, iy + 28, {\n        font: '13px sans-serif', color: catColor,\n      });\n\n      if (isFlash) {\n        ctx.save();\n        ctx.globalAlpha = Math.min(1, this.flashTimer) * 0.2;\n        ctx.fillStyle = '#f0d8a0';\n        ctx.fillRect(listX, iy, panelW - 32, itemH - 4);\n        ctx.restore();\n      }\n    });\n\n    ctx.restore();\n\n    if (this.selectedIndex >= 0 && this.selectedIndex < items.length) {\n      const item = items[this.selectedIndex];\n      const detailY = listY + listH + 10;\n\n      this.renderer.drawRoundRect(listX, detailY, panelW - 32, 70, 4, '#14100a', '#3a2a1a');\n\n      this.renderer.drawText(item.name, listX + 12, detailY + 8, {\n        font: 'bold 18px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2',\n      });\n      this.renderWrappedText(item.description, listX + 12, detailY + 34, panelW - 56, 30, {\n        font: '15px \"SimSun\", \"Noto Serif SC\", serif', color: '#a09080',\n      });\n    }\n\n    if (items.length === 0) {\n      this.renderer.drawText('尚未收集到物证', panelX + panelW / 2, listY + 40, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n      });\n    }\n\n    const closeBtnY = panelY + panelH - 50;\n    const closeHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + panelW / 2 - 60, closeBtnY, 120, 36);\n    this.renderer.drawRoundRect(panelX + panelW / 2 - 60, closeBtnY, 120, 36, 4,\n      closeHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('关闭', panelX + panelW / 2, closeBtnY + 8, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n      color: closeHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n\n    ctx.restore();\n\n    this.renderFlashNotification(ctx, w, h);\n  }\n\n  private renderFlashNotification(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    if (!this.flashId || this.flashTimer <= 0) return;\n    const item = this.evidenceDB.get(this.flashId);\n    if (!item) return;\n\n    const alpha = Math.min(1, this.flashTimer);\n    const ny = h - 80 - (2 - this.flashTimer) * 60;\n\n    ctx.save();\n    ctx.globalAlpha = alpha;\n    this.renderer.drawRoundRect(w / 2 - 160, ny, 320, 48, 6, '#2a1a0e', '#8b4513');\n    this.renderer.drawText(`获得物证: ${item.name}`, w / 2, ny + 14, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#f0d8a0', align: 'center',\n    });\n    ctx.restore();\n  }\n\n  private renderWrappedText(text: string, x: number, y: number, maxW: number, maxH: number,\n    opts: { font?: string; color?: string }) {\n    const ctx = this.renderer.context;\n    ctx.save();\n    ctx.font = opts.font ?? '18px \"SimSun\", \"Noto Serif SC\", serif';\n    ctx.fillStyle = opts.color ?? '#d8c8b0';\n\n    let lineY = y;\n    let line = '';\n    for (const ch of text) {\n      const test = line + ch;\n      if (ctx.measureText(test).width > maxW) {\n        ctx.fillText(line, x, lineY);\n        line = ch;\n        lineY += 22;\n        if (lineY - y > maxH) break;\n      } else {\n        line = test;\n      }\n    }\n    if (line) ctx.fillText(line, x, lineY);\n    ctx.restore();\n  }\n\n  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
