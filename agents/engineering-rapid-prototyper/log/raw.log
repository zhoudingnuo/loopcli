ry to get game list first to understand the API structure\n  const listResponse = await page.evaluate(async () => {\n    try {\n      const res = await fetch('/bff_api_game_console/v1/PlatBaseSettingService/QueryGameList?', {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n          'x-secsdk-csrf-token': 'DOWNGRADE',\n          'x-tt-groupid': '1065926',\n        },\n        body: JSON.stringify({ page: 1, count: 10 }),\n      });\n      return { status: res.status, body: await res.text() };\n    } catch (e) {\n      return { error: e.message };\n    }\n  });\n  \n  console.log('Game list response:', JSON.stringify(listResponse, null, 2));\n  \n  await browser.close();\n})();\nSCRIPT\nNODE_PATH=\"C:/Users/Administrator/AppData/Roaming/npm/node_modules\" node /tmp/create_game.cjs 2>&1","description":"Create game via API with adjusted timeout","timeout":90000}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"1f456d29-d84c-44e0-89e7-7ad362d1b1bb","uuid":"d27ce18c-caa1-487f-8d71-ffeee763a79d"}
