{"type":"assistant","message":{"id":"msg_202605232336163384c0bdaf4644d3","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_eb7c7e45d7bc46559b197198","name":"Write","input":{"file_path":"D:\\game-projects\\steam-ancient-mystery\\src\\game\\InterrogationSystem.ts","content":"import { Renderer } from '../renderer/Renderer';\nimport { GameState } from './GameState';\nimport { DialogueEngine, DialogueNode, DialogueChoice } from './DialogueEngine';\nimport { InputManager } from './InputManager';\n\nexport interface InterrogationNPC {\n  id: string;\n  name: string;\n  portrait?: string;\n  defaultPressure: number;\n  maxPressure: number;\n}\n\nexport interface InterrogationTopic {\n  id: string;\n  npcId: string;\n  label: string;\n  dialogueId: string;\n  requiresEvidence?: string[];\n  requiresFlag?: string[];\n  pressureRange?: { min: number; max: number };\n  repeatable: boolean;\n}\n\nexport class InterrogationSystem {\n  private npcs: Map<string, InterrogationNPC> = new Map();\n  private topics: Map<string, InterrogationTopic[]> = new Map();\n  private currentNPC: InterrogationNPC | null = null;\n  private pressure = 0;\n  private isInterrogating = false;\n  private selectedTopicIndex = -1;\n  private animAlpha = 0;\n  private askedTopics: Set<string> = new Set();\n  private showingEvidenceSelect = false;\n  private evidenceSelectFor: string | null = null;\n\n  constructor(\n    private renderer: Renderer,\n    private state: GameState,\n    private dialogueEngine: DialogueEngine,\n    private input: InputManager\n  ) {\n    this.setupInput();\n  }\n\n  registerNPC(npc: InterrogationNPC) {\n    this.npcs.set(npc.id, npc);\n  }\n\n  registerTopic(topic: InterrogationTopic) {\n    const list = this.topics.get(topic.npcId) ?? [];\n    list.push(topic);\n    this.topics.set(topic.npcId, list);\n  }\n\n  registerTopics(topics: InterrogationTopic[]) {\n    topics.forEach((t) => this.registerTopic(t));\n  }\n\n  startInterrogation(npcId: string): boolean {\n    const npc = this.npcs.get(npcId);\n    if (!npc) return false;\n\n    this.currentNPC = npc;\n    this.pressure = npc.defaultPressure;\n    this.isInterrogating = true;\n    this.selectedTopicIndex = -1;\n    this.animAlpha = 0;\n    this.showingEvidenceSelect = false;\n    return true;\n  }\n\n  endInterrogation() {\n    this.isInterrogating = false;\n    this.currentNPC = null;\n    this.showingEvidenceSelect = false;\n    this.evidenceSelectFor = null;\n  }\n\n  isRunning(): boolean { return this.isInterrogating; }\n\n  getPressure(): number { return this.pressure; }\n\n  addPressure(delta: number) {\n    if (!this.currentNPC) return;\n    this.pressure = Math.max(0, Math.min(this.currentNPC.maxPressure, this.pressure + delta));\n  }\n\n  getAvailableTopics(): InterrogationTopic[] {\n    if (!this.currentNPC) return [];\n    const allTopics = this.topics.get(this.currentNPC.id) ?? [];\n    return allTopics.filter((t) => this.canAskTopic(t));\n  }\n\n  private canAskTopic(topic: InterrogationTopic): boolean {\n    if (topic.requiresEvidence) {\n      for (const ev of topic.requiresEvidence) {\n        if (!this.state.hasEvidence(ev)) return false;\n      }\n    }\n    if (topic.requiresFlag) {\n      for (const f of topic.requiresFlag) {\n        if (!this.state.getFlag(f)) return false;\n      }\n    }\n    if (!topic.repeatable && this.askedTopics.has(topic.id)) return false;\n    if (topic.pressureRange) {\n      if (this.pressure < topic.pressureRange.min || this.pressure > topic.pressureRange.max) return false;\n    }\n    return true;\n  }\n\n  askTopic(topicId: string): boolean {\n    const topic = this.getAvailableTopics().find((t) => t.id === topicId);\n    if (!topic || !this.currentNPC) return false;\n\n    this.askedTopics.add(topicId);\n    this.addPressure(5);\n\n    return this.dialogueEngine.start(topic.dialogueId, () => {\n      this.selectedTopicIndex = -1;\n    });\n  }\n\n  presentEvidence(evidenceId: string): boolean {\n    if (!this.currentNPC) return false;\n    this.addPressure(8);\n\n    const topic = this.getAvailableTopics().find(\n      (t) => t.requiresEvidence?.includes(evidenceId)\n    );\n    if (topic) {\n      return this.askTopic(topic.id);\n    }\n    return false;\n  }\n\n  private setupInput() {\n    this.input.onClick((e) => {\n      if (e.type !== 'up') return;\n      if (!this.isInterrogating) return;\n      if (this.dialogueEngine.getIsActive()) return;\n      if (this.showingEvidenceSelect) {\n        this.handleEvidenceClick(e.x, e.y);\n        return;\n      }\n      this.handleTopicClick(e.x, e.y);\n    });\n  }\n\n  private handleTopicClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    const panelX = w * 0.1;\n    const panelW = w * 0.8;\n    const topicY = h * 0.35;\n\n    const topics = this.getAvailableTopics();\n    for (let i = 0; i < topics.length; i++) {\n      const ty = topicY + i * 48;\n      if (this.isInRect(x, y, panelX + 20, ty, panelW - 40, 40)) {\n        this.askTopic(topics[i].id);\n        return;\n      }\n    }\n\n    const presentY = h * 0.78;\n    if (this.isInRect(x, y, panelX + 20, presentY, (panelW - 60) / 2, 40)) {\n      this.showingEvidenceSelect = true;\n      this.evidenceSelectFor = 'present';\n      return;\n    }\n\n    const endY = h * 0.78;\n    const endX = panelX + 20 + (panelW - 60) / 2 + 20;\n    if (this.isInRect(x, y, endX, endY, (panelW - 60) / 2, 40)) {\n      this.endInterrogation();\n    }\n  }\n\n  private handleEvidenceClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    const items = this.state.evidence;\n    const panelX = w * 0.2;\n    const panelW = w * 0.6;\n    const listY = h * 0.2;\n\n    for (let i = 0; i < items.length; i++) {\n      const iy = listY + i * 44;\n      if (this.isInRect(x, y, panelX + 10, iy, panelW - 20, 38)) {\n        this.showingEvidenceSelect = false;\n        this.presentEvidence(items[i]);\n        return;\n      }\n    }\n\n    if (this.isInRect(x, y, w * 0.4, h * 0.85, w * 0.2, 40)) {\n      this.showingEvidenceSelect = false;\n    }\n  }\n\n  update(dt: number) {\n    if (!this.isInterrogating) return;\n    this.animAlpha = Math.min(1, this.animAlpha + dt * 5);\n  }\n\n  render() {\n    if (!this.isInterrogating) return;\n    if (this.dialogueEngine.getIsActive()) return;\n\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.save();\n    ctx.globalAlpha = this.animAlpha * 0.7;\n    ctx.fillStyle = '#0a0806';\n    ctx.fillRect(0, 0, w, h);\n    ctx.restore();\n\n    ctx.save();\n    ctx.globalAlpha = this.animAlpha;\n\n    const panelX = w * 0.1;\n    const panelW = w * 0.8;\n    const panelY = h * 0.08;\n    const panelH = h * 0.84;\n\n    this.renderer.drawRoundRect(panelX, panelY, panelW, panelH, 8, '#1a140e', '#3a2a1a');\n    ctx.strokeStyle = '#5a4030';\n    ctx.lineWidth = 1;\n    ctx.strokeRect(panelX + 3, panelY + 3, panelW - 6, panelH - 6);\n\n    if (this.currentNPC) {\n      this.renderer.drawText(`审问：${this.currentNPC.name}`, panelX + panelW / 2, panelY + 18, {\n        font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n        color: '#c8a882', align: 'center',\n      });\n\n      this.renderPressureBar(ctx, panelX + 30, panelY + 55, panelW - 60);\n\n      this.renderer.drawText('选择话题：', panelX + 30, h * 0.32, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870',\n      });\n\n      const topics = this.getAvailableTopics();\n      topics.forEach((topic, i) => {\n        const ty = h * 0.35 + i * 48;\n        const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + 20, ty, panelW - 40, 40);\n\n        if (isHover) {\n          ctx.fillStyle = 'rgba(200, 168, 130, 0.1)';\n          ctx.fillRect(panelX + 20, ty, panelW - 40, 40);\n        }\n\n        ctx.strokeStyle = '#3a2a1a';\n        ctx.lineWidth = 1;\n        ctx.strokeRect(panelX + 20, ty, panelW - 40, 40);\n\n        const asked = this.askedTopics.has(topic.id);\n        this.renderer.drawText(\n          `${asked ? '✓ ' : '  '}${topic.label}`,\n          panelX + 35, ty + 10,\n          {\n            font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n            color: asked ? '#5a4a3a' : isHover ? '#f0d8b0' : '#d8c8b0',\n          }\n        );\n      });\n\n      if (topics.length === 0) {\n        this.renderer.drawText('没有可问的话题', panelX + panelW / 2, h * 0.45, {\n          font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n        });\n      }\n\n      const btnW = (panelW - 60) / 2;\n      const btnY = h * 0.78;\n\n      const presentHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + 20, btnY, btnW, 40);\n      this.renderer.drawRoundRect(panelX + 20, btnY, btnW, 40, 4,\n        presentHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n      this.renderer.drawText('出示物证', panelX + 20 + btnW / 2, btnY + 10, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n        color: presentHover ? '#e8c8a2' : '#a08870', align: 'center',\n      });\n\n      const endX = panelX + 20 + btnW + 20;\n      const endHover = this.isInRect(this.input.mouseX, this.input.mouseY, endX, btnY, btnW, 40);\n      this.renderer.drawRoundRect(endX, btnY, btnW, 40, 4,\n        endHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n      this.renderer.drawText('结束审问', endX + btnW / 2, btnY + 10, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n        color: endHover ? '#e8c8a2' : '#a08870', align: 'center',\n      });\n    }\n\n    ctx.restore();\n\n    if (this.showingEvidenceSelect) {\n      this.renderEvidenceSelect(ctx, w, h);\n    }\n  }\n\n  private renderPressureBar(ctx: CanvasRenderingContext2D, x: number, y: number, w: number) {\n    if (!this.currentNPC) return;\n\n    this.renderer.drawText('压力：', x, y, {\n      font: '15px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a',\n    });\n\n    const barX = x + 50;\n    const barW = w - 50;\n    const barH = 12;\n\n    ctx.fillStyle = '#2a1a0e';\n    ctx.fillRect(barX, y + 2, barW, barH);\n\n    const ratio = this.pressure / this.currentNPC.maxPressure;\n    const pressureColor = ratio < 0.4 ? '#4a8a4a' : ratio < 0.7 ? '#c8a040' : '#8a3a3a';\n    ctx.fillStyle = pressureColor;\n    ctx.fillRect(barX, y + 2, barW * ratio, barH);\n\n    ctx.strokeStyle = '#3a2a1a';\n    ctx.lineWidth = 1;\n    ctx.strokeRect(barX, y + 2, barW, barH);\n\n    const relKey = Object.keys(this.state.relationships).find((k) =>\n      this.currentNPC && k === this.currentNPC.id.replace('_', '')\n    );\n    if (relKey) {\n      this.renderer.drawText(`好感: ${this.state.relationships[relKey]}`, barX + barW + 10, y, {\n        font: '14px sans-serif', color: '#8a7a6a',\n      });\n    }\n  }\n\n  private renderEvidenceSelect(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    ctx.save();\n    ctx.globalAlpha = 0.9;\n    ctx.fillStyle = '#0a0806';\n    ctx.fillRect(0, 0, w, h);\n    ctx.restore();\n\n    const panelX = w * 0.2;\n    const panelW = w * 0.6;\n    const panelY = h * 0.1;\n    const panelH = h * 0.75;\n\n    this.renderer.drawRoundRect(panelX, panelY, panelW, panelH, 8, '#1a140e', '#5a4030');\n    this.renderer.drawText('选择要出示的物证', panelX + panelW / 2, panelY + 18, {\n      font: 'bold 22px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    const items = this.state.evidence;\n    const listY = h * 0.2;\n\n    items.forEach((evId, i) => {\n      const iy = listY + i * 44;\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + 10, iy, panelW - 20, 38);\n\n      if (isHover) {\n        ctx.fillStyle = 'rgba(200, 168, 130, 0.12)';\n        ctx.fillRect(panelX + 10, iy, panelW - 20, 38);\n      }\n\n      this.renderer.drawText(`▪ ${evId}`, panelX + 25, iy + 8, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n        color: isHover ? '#f0d8b0' : '#d8c8b0',\n      });\n    });\n\n    if (items.length === 0) {\n      this.renderer.drawText('没有可出示的物证', panelX + panelW / 2, listY + 30, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n      });\n    }\n\n    const cancelHover = this.isInRect(this.input.mouseX, this.input.mouseY, w * 0.4, h * 0.85, w * 0.2, 40);\n    this.renderer.drawRoundRect(w * 0.4, h * 0.85, w * 0.2, 40, 4,\n      cancelHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('取消', w / 2, h * 0.85 + 10, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n      color: cancelHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n  }\n\n  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"bb710ec1-068d-4a4a-9438-6a706a63a8a0","uuid":"500ae57f-21dd-4d1c-94f0-19b73270bd0c"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_eb7c7e45d7bc46559b197198","type":"tool_result","content":"File created successfully at: D:\\game-projects\\steam-ancient-mystery\\src\\game\\InterrogationSystem.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"bb710ec1-068d-4a4a-9438-6a706a63a8a0","uuid":"960c6421-0bf8-4f77-9f5a-84aa9dc8428e","timestamp":"2026-05-23T15:37:18.225Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\steam-ancient-mystery\\src\\game\\InterrogationSystem.ts","content":"import { Renderer } from '../renderer/Renderer';\nimport { GameState } from './GameState';\nimport { DialogueEngine, DialogueNode, DialogueChoice } from './DialogueEngine';\nimport { InputManager } from './InputManager';\n\nexport interface InterrogationNPC {\n  id: string;\n  name: string;\n  portrait?: string;\n  defaultPressure: number;\n  maxPressure: number;\n}\n\nexport interface InterrogationTopic {\n  id: string;\n  npcId: string;\n  label: string;\n  dialogueId: string;\n  requiresEvidence?: string[];\n  requiresFlag?: string[];\n  pressureRange?: { min: number; max: number };\n  repeatable: boolean;\n}\n\nexport class InterrogationSystem {\n  private npcs: Map<string, InterrogationNPC> = new Map();\n  private topics: Map<string, InterrogationTopic[]> = new Map();\n  private currentNPC: InterrogationNPC | null = null;\n  private pressure = 0;\n  private isInterrogating = false;\n  private selectedTopicIndex = -1;\n  private animAlpha = 0;\n  private askedTopics: Set<string> = new Set();\n  private showingEvidenceSelect = false;\n  private evidenceSelectFor: string | null = null;\n\n  constructor(\n    private renderer: Renderer,\n    private state: GameState,\n    private dialogueEngine: DialogueEngine,\n    private input: InputManager\n  ) {\n    this.setupInput();\n  }\n\n  registerNPC(npc: InterrogationNPC) {\n    this.npcs.set(npc.id, npc);\n  }\n\n  registerTopic(topic: InterrogationTopic) {\n    const list = this.topics.get(topic.npcId) ?? [];\n    list.push(topic);\n    this.topics.set(topic.npcId, list);\n  }\n\n  registerTopics(topics: InterrogationTopic[]) {\n    topics.forEach((t) => this.registerTopic(t));\n  }\n\n  startInterrogation(npcId: string): boolean {\n    const npc = this.npcs.get(npcId);\n    if (!npc) return false;\n\n    this.currentNPC = npc;\n    this.pressure = npc.defaultPressure;\n    this.isInterrogating = true;\n    this.selectedTopicIndex = -1;\n    this.animAlpha = 0;\n    this.showingEvidenceSelect = false;\n    return true;\n  }\n\n  endInterrogation() {\n    this.isInterrogating = false;\n    this.currentNPC = null;\n    this.showingEvidenceSelect = false;\n    this.evidenceSelectFor = null;\n  }\n\n  isRunning(): boolean { return this.isInterrogating; }\n\n  getPressure(): number { return this.pressure; }\n\n  addPressure(delta: number) {\n    if (!this.currentNPC) return;\n    this.pressure = Math.max(0, Math.min(this.currentNPC.maxPressure, this.pressure + delta));\n  }\n\n  getAvailableTopics(): InterrogationTopic[] {\n    if (!this.currentNPC) return [];\n    const allTopics = this.topics.get(this.currentNPC.id) ?? [];\n    return allTopics.filter((t) => this.canAskTopic(t));\n  }\n\n  private canAskTopic(topic: InterrogationTopic): boolean {\n    if (topic.requiresEvidence) {\n      for (const ev of topic.requiresEvidence) {\n        if (!this.state.hasEvidence(ev)) return false;\n      }\n    }\n    if (topic.requiresFlag) {\n      for (const f of topic.requiresFlag) {\n        if (!this.state.getFlag(f)) return false;\n      }\n    }\n    if (!topic.repeatable && this.askedTopics.has(topic.id)) return false;\n    if (topic.pressureRange) {\n      if (this.pressure < topic.pressureRange.min || this.pressure > topic.pressureRange.max) return false;\n    }\n    return true;\n  }\n\n  askTopic(topicId: string): boolean {\n    const topic = this.getAvailableTopics().find((t) => t.id === topicId);\n    if (!topic || !this.currentNPC) return false;\n\n    this.askedTopics.add(topicId);\n    this.addPressure(5);\n\n    return this.dialogueEngine.start(topic.dialogueId, () => {\n      this.selectedTopicIndex = -1;\n    });\n  }\n\n  presentEvidence(evidenceId: string): boolean {\n    if (!this.currentNPC) return false;\n    this.addPressure(8);\n\n    const topic = this.getAvailableTopics().find(\n      (t) => t.requiresEvidence?.includes(evidenceId)\n    );\n    if (topic) {\n      return this.askTopic(topic.id);\n    }\n    return false;\n  }\n\n  private setupInput() {\n    this.input.onClick((e) => {\n      if (e.type !== 'up') return;\n      if (!this.isInterrogating) return;\n      if (this.dialogueEngine.getIsActive()) return;\n      if (this.showingEvidenceSelect) {\n        this.handleEvidenceClick(e.x, e.y);\n        return;\n      }\n      this.handleTopicClick(e.x, e.y);\n    });\n  }\n\n  private handleTopicClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    const panelX = w * 0.1;\n    const panelW = w * 0.8;\n    const topicY = h * 0.35;\n\n    const topics = this.getAvailableTopics();\n    for (let i = 0; i < topics.length; i++) {\n      const ty = topicY + i * 48;\n      if (this.isInRect(x, y, panelX + 20, ty, panelW - 40, 40)) {\n        this.askTopic(topics[i].id);\n        return;\n      }\n    }\n\n    const presentY = h * 0.78;\n    if (this.isInRect(x, y, panelX + 20, presentY, (panelW - 60) / 2, 40)) {\n      this.showingEvidenceSelect = true;\n      this.evidenceSelectFor = 'present';\n      return;\n    }\n\n    const endY = h * 0.78;\n    const endX = panelX + 20 + (panelW - 60) / 2 + 20;\n    if (this.isInRect(x, y, endX, endY, (panelW - 60) / 2, 40)) {\n      this.endInterrogation();\n    }\n  }\n\n  private handleEvidenceClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    const items = this.state.evidence;\n    const panelX = w * 0.2;\n    const panelW = w * 0.6;\n    const listY = h * 0.2;\n\n    for (let i = 0; i < items.length; i++) {\n      const iy = listY + i * 44;\n      if (this.isInRect(x, y, panelX + 10, iy, panelW - 20, 38)) {\n        this.showingEvidenceSelect = false;\n        this.presentEvidence(items[i]);\n        return;\n      }\n    }\n\n    if (this.isInRect(x, y, w * 0.4, h * 0.85, w * 0.2, 40)) {\n      this.showingEvidenceSelect = false;\n    }\n  }\n\n  update(dt: number) {\n    if (!this.isInterrogating) return;\n    this.animAlpha = Math.min(1, this.animAlpha + dt * 5);\n  }\n\n  render() {\n    if (!this.isInterrogating) return;\n    if (this.dialogueEngine.getIsActive()) return;\n\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.save();\n    ctx.globalAlpha = this.animAlpha * 0.7;\n    ctx.fillStyle = '#0a0806';\n    ctx.fillRect(0, 0, w, h);\n    ctx.restore();\n\n    ctx.save();\n    ctx.globalAlpha = this.animAlpha;\n\n    const panelX = w * 0.1;\n    const panelW = w * 0.8;\n    const panelY = h * 0.08;\n    const panelH = h * 0.84;\n\n    this.renderer.drawRoundRect(panelX, panelY, panelW, panelH, 8, '#1a140e', '#3a2a1a');\n    ctx.strokeStyle = '#5a4030';\n    ctx.lineWidth = 1;\n    ctx.strokeRect(panelX + 3, panelY + 3, panelW - 6, panelH - 6);\n\n    if (this.currentNPC) {\n      this.renderer.drawText(`审问：${this.currentNPC.name}`, panelX + panelW / 2, panelY + 18, {\n        font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n        color: '#c8a882', align: 'center',\n      });\n\n      this.renderPressureBar(ctx, panelX + 30, panelY + 55, panelW - 60);\n\n      this.renderer.drawText('选择话题：', panelX + 30, h * 0.32, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870',\n      });\n\n      const topics = this.getAvailableTopics();\n      topics.forEach((topic, i) => {\n        const ty = h * 0.35 + i * 48;\n        const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + 20, ty, panelW - 40, 40);\n\n        if (isHover) {\n          ctx.fillStyle = 'rgba(200, 168, 130, 0.1)';\n          ctx.fillRect(panelX + 20, ty, panelW - 40, 40);\n        }\n\n        ctx.strokeStyle = '#3a2a1a';\n        ctx.lineWidth = 1;\n        ctx.strokeRect(panelX + 20, ty, panelW - 40, 40);\n\n        const asked = this.askedTopics.has(topic.id);\n        this.renderer.drawText(\n          `${asked ? '✓ ' : '  '}${topic.label}`,\n          panelX + 35, ty + 10,\n          {\n            font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n            color: asked ? '#5a4a3a' : isHover ? '#f0d8b0' : '#d8c8b0',\n          }\n        );\n      });\n\n      if (topics.length === 0) {\n        this.renderer.drawText('没有可问的话题', panelX + panelW / 2, h * 0.45, {\n          font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n        });\n      }\n\n      const btnW = (panelW - 60) / 2;\n      const btnY = h * 0.78;\n\n      const presentHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + 20, btnY, btnW, 40);\n      this.renderer.drawRoundRect(panelX + 20, btnY, btnW, 40, 4,\n        presentHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n      this.renderer.drawText('出示物证', panelX + 20 + btnW / 2, btnY + 10, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n        color: presentHover ? '#e8c8a2' : '#a08870', align: 'center',\n      });\n\n      const endX = panelX + 20 + btnW + 20;\n      const endHover = this.isInRect(this.input.mouseX, this.input.mouseY, endX, btnY, btnW, 40);\n      this.renderer.drawRoundRect(endX, btnY, btnW, 40, 4,\n        endHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n      this.renderer.drawText('结束审问', endX + btnW / 2, btnY + 10, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n        color: endHover ? '#e8c8a2' : '#a08870', align: 'center',\n      });\n    }\n\n    ctx.restore();\n\n    if (this.showingEvidenceSelect) {\n      this.renderEvidenceSelect(ctx, w, h);\n    }\n  }\n\n  private renderPressureBar(ctx: CanvasRenderingContext2D, x: number, y: number, w: number) {\n    if (!this.currentNPC) return;\n\n    this.renderer.drawText('压力：', x, y, {\n      font: '15px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a',\n    });\n\n    const barX = x + 50;\n    const barW = w - 50;\n    const barH = 12;\n\n    ctx.fillStyle = '#2a1a0e';\n    ctx.fillRect(barX, y + 2, barW, barH);\n\n    const ratio = this.pressure / this.currentNPC.maxPressure;\n    const pressureColor = ratio < 0.4 ? '#4a8a4a' : ratio < 0.7 ? '#c8a040' : '#8a3a3a';\n    ctx.fillStyle = pressureColor;\n    ctx.fillRect(barX, y + 2, barW * ratio, barH);\n\n    ctx.strokeStyle = '#3a2a1a';\n    ctx.lineWidth = 1;\n    ctx.strokeRect(barX, y + 2, barW, barH);\n\n    const relKey = Object.keys(this.state.relationships).find((k) =>\n      this.currentNPC && k === this.currentNPC.id.replace('_', '')\n    );\n    if (relKey) {\n      this.renderer.drawText(`好感: ${this.state.relationships[relKey]}`, barX + barW + 10, y, {\n        font: '14px sans-serif', color: '#8a7a6a',\n      });\n    }\n  }\n\n  private renderEvidenceSelect(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    ctx.save();\n    ctx.globalAlpha = 0.9;\n    ctx.fillStyle = '#0a0806';\n    ctx.fillRect(0, 0, w, h);\n    ctx.restore();\n\n    const panelX = w * 0.2;\n    const panelW = w * 0.6;\n    const panelY = h * 0.1;\n    const panelH = h * 0.75;\n\n    this.renderer.drawRoundRect(panelX, panelY, panelW, panelH, 8, '#1a140e', '#5a4030');\n    this.renderer.drawText('选择要出示的物证', panelX + panelW / 2, panelY + 18, {\n      font: 'bold 22px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    const items = this.state.evidence;\n    const listY = h * 0.2;\n\n    items.forEach((evId, i) => {\n      const iy = listY + i * 44;\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + 10, iy, panelW - 20, 38);\n\n      if (isHover) {\n        ctx.fillStyle = 'rgba(200, 168, 130, 0.12)';\n        ctx.fillRect(panelX + 10, iy, panelW - 20, 38);\n      }\n\n      this.renderer.drawText(`▪ ${evId}`, panelX + 25, iy + 8, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n        color: isHover ? '#f0d8b0' : '#d8c8b0',\n      });\n    });\n\n    if (items.length === 0) {\n      this.renderer.drawText('没有可出示的物证', panelX + panelW / 2, listY + 30, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n      });\n    }\n\n    const cancelHover = this.isInRect(this.input.mouseX, this.input.mouseY, w * 0.4, h * 0.85, w * 0.2, 40);\n    this.renderer.drawRoundRect(w * 0.4, h * 0.85, w * 0.2, 40, 4,\n      cancelHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('取消', w / 2, h * 0.85 + 10, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n      color: cancelHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n  }\n\n  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
