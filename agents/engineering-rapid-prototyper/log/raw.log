{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_954de0fd5a49484d8cd48757","type":"tool_result","content":"1\timport { Renderer } from '../renderer/Renderer';\n2\timport { GameState } from './GameState';\n3\timport { DialogueEngine, DialogueNode, DialogueChoice } from './DialogueEngine';\n4\timport { InputManager } from './InputManager';\n5\t\n6\texport interface InterrogationNPC {\n7\t  id: string;\n8\t  name: string;\n9\t  portrait?: string;\n10\t  defaultPressure: number;\n11\t  maxPressure: number;\n12\t}\n13\t\n14\texport interface InterrogationTopic {\n15\t  id: string;\n16\t  npcId: string;\n17\t  label: string;\n18\t  dialogueId: string;\n19\t  requiresEvidence?: string[];\n20\t  requiresFlag?: string[];\n21\t  pressureRange?: { min: number; max: number };\n22\t  repeatable: boolean;\n23\t}\n24\t\n25\texport class InterrogationSystem {\n26\t  private npcs: Map<string, InterrogationNPC> = new Map();\n27\t  private topics: Map<string, InterrogationTopic[]> = new Map();\n28\t  private currentNPC: InterrogationNPC | null = null;\n29\t  private pressure = 0;\n30\t  private isInterrogating = false;\n31\t  private selectedTopicIndex = -1;\n32\t  private animAlpha = 0;\n33\t  private askedTopics: Set<string> = new Set();\n34\t  private showingEvidenceSelect = false;\n35\t  private evidenceSelectFor: string | null = null;\n36\t\n37\t  constructor(\n38\t    private renderer: Renderer,\n39\t    private state: GameState,\n40\t    private dialogueEngine: DialogueEngine,\n41\t    private input: InputManager\n42\t  ) {\n43\t    this.setupInput();\n44\t  }\n45\t\n46\t  registerNPC(npc: InterrogationNPC) {\n47\t    this.npcs.set(npc.id, npc);\n48\t  }\n49\t\n50\t  registerTopic(topic: InterrogationTopic) {\n51\t    const list = this.topics.get(topic.npcId) ?? [];\n52\t    list.push(topic);\n53\t    this.topics.set(topic.npcId, list);\n54\t  }\n55\t\n56\t  registerTopics(topics: InterrogationTopic[]) {\n57\t    topics.forEach((t) => this.registerTopic(t));\n58\t  }\n59\t\n60\t  startInterrogation(npcId: string): boolean {\n61\t    const npc = this.npcs.get(npcId);\n62\t    if (!npc) return false;\n63\t\n64\t    this.currentNPC = npc;\n65\t    this.pressure = npc.defaultPressure;\n66\t    this.isInterrogating = true;\n67\t    this.selectedTopicIndex = -1;\n68\t    this.animAlpha = 0;\n69\t    this.showingEvidenceSelect = false;\n70\t    return true;\n71\t  }\n72\t\n73\t  endInterrogation() {\n74\t    this.isInterrogating = false;\n75\t    this.currentNPC = null;\n76\t    this.showingEvidenceSelect = false;\n77\t    this.evidenceSelectFor = null;\n78\t  }\n79\t\n80\t  isRunning(): boolean { return this.isInterrogating; }\n81\t\n82\t  getPressure(): number { return this.pressure; }\n83\t\n84\t  addPressure(delta: number) {\n85\t    if (!this.currentNPC) return;\n86\t    this.pressure = Math.max(0, Math.min(this.currentNPC.maxPressure, this.pressure + delta));\n87\t  }\n88\t\n89\t  getAvailableTopics(): InterrogationTopic[] {\n90\t    if (!this.currentNPC) return [];\n91\t    const allTopics = this.topics.get(this.currentNPC.id) ?? [];\n92\t    return allTopics.filter((t) => this.canAskTopic(t));\n93\t  }\n94\t\n95\t  private canAskTopic(topic: InterrogationTopic): boolean {\n96\t    if (topic.requiresEvidence) {\n97\t      for (const ev of topic.requiresEvidence) {\n98\t        if (!this.state.hasEvidence(ev)) return false;\n99\t      }\n100\t    }\n101\t    if (topic.requiresFlag) {\n102\t      for (const f of topic.requiresFlag) {\n103\t        if (!this.state.getFlag(f)) return false;\n104\t      }\n105\t    }\n106\t    if (!topic.repeatable && this.askedTopics.has(topic.id)) return false;\n107\t    if (topic.pressureRange) {\n108\t      if (this.pressure < topic.pressureRange.min || this.pressure > topic.pressureRange.max) return false;\n109\t    }\n110\t    return true;\n111\t  }\n112\t\n113\t  askTopic(topicId: string): boolean {\n114\t    const topic = this.getAvailableTopics().find((t) => t.id === topicId);\n115\t    if (!topic || !this.currentNPC) return false;\n116\t\n117\t    this.askedTopics.add(topicId);\n118\t    this.addPressure(5);\n119\t\n120\t    return this.dialogueEngine.start(topic.dialogueId, () => {\n121\t      this.selectedTopicIndex = -1;\n122\t    });\n123\t  }\n124\t\n125\t  presentEvidence(evidenceId: string): boolean {\n126\t    if (!this.currentNPC) return false;\n127\t    this.addPressure(8);\n128\t\n129\t    const topic = this.getAvailableTopics().find(\n130\t      (t) => t.requiresEvidence?.includes(evidenceId)\n131\t    );\n132\t    if (topic) {\n133\t      return this.askTopic(topic.id);\n134\t    }\n135\t    return false;\n136\t  }\n137\t\n138\t  private setupInput() {\n139\t    this.input.onClick((e) => {\n140\t      if (e.type !== 'up') return;\n141\t      if (!this.isInterrogating) return;\n142\t      if (this.dialogueEngine.getIsActive()) return;\n143\t      if (this.showingEvidenceSelect) {\n144\t        this.handleEvidenceClick(e.x, e.y);\n145\t        return;\n146\t      }\n147\t      this.handleTopicClick(e.x, e.y);\n148\t    });\n149\t  }\n150\t\n151\t  private handleTopicClick(x: number, y: number) {\n152\t    const w = this.renderer.w;\n153\t    const h = this.renderer.h;\n154\t\n155\t    const panelX = w * 0.1;\n156\t    const panelW = w * 0.8;\n157\t    const topicY = h * 0.35;\n158\t\n159\t    const topics = this.getAvailableTopics();\n160\t    for (let i = 0; i < topics.length; i++) {\n161\t      const ty = topicY + i * 48;\n162\t      if (this.isInRect(x, y, panelX + 20, ty, panelW - 40, 40)) {\n163\t        this.askTopic(topics[i].id);\n164\t        return;\n165\t      }\n166\t    }\n167\t\n168\t    const presentY = h * 0.78;\n169\t    if (this.isInRect(x, y, panelX + 20, presentY, (panelW - 60) / 2, 40)) {\n170\t      this.showingEvidenceSelect = true;\n171\t      this.evidenceSelectFor = 'present';\n172\t      return;\n173\t    }\n174\t\n175\t    const endY = h * 0.78;\n176\t    const endX = panelX + 20 + (panelW - 60) / 2 + 20;\n177\t    if (this.isInRect(x, y, endX, endY, (panelW - 60) / 2, 40)) {\n178\t      this.endInterrogation();\n179\t    }\n180\t  }\n181\t\n182\t  private handleEvidenceClick(x: number, y: number) {\n183\t    const w = this.renderer.w;\n184\t    const h = this.renderer.h;\n185\t\n186\t    const items = this.state.evidence;\n187\t    const panelX = w * 0.2;\n188\t    const panelW = w * 0.6;\n189\t    const listY = h * 0.2;\n190\t\n191\t    for (let i = 0; i < items.length; i++) {\n192\t      const iy = listY + i * 44;\n193\t      if (this.isInRect(x, y, panelX + 10, iy, panelW - 20, 38)) {\n194\t        this.showingEvidenceSelect = false;\n195\t        this.presentEvidence(items[i]);\n196\t        return;\n197\t      }\n198\t    }\n199\t\n200\t    if (this.isInRect(x, y, w * 0.4, h * 0.85, w * 0.2, 40)) {\n201\t      this.showingEvidenceSelect = false;\n202\t    }\n203\t  }\n204\t\n205\t  update(dt: number) {\n206\t    if (!this.isInterrogating) return;\n207\t    this.animAlpha = Math.min(1, this.animAlpha + dt * 5);\n208\t  }\n209\t\n210\t  render() {\n211\t    if (!this.isInterrogating) return;\n212\t    if (this.dialogueEngine.getIsActive()) return;\n213\t\n214\t    const ctx = this.renderer.context;\n215\t    const w = this.renderer.w;\n216\t    const h = this.renderer.h;\n217\t\n218\t    ctx.save();\n219\t    ctx.globalAlpha = this.animAlpha * 0.7;\n220\t    ctx.fillStyle = '#0a0806';\n221\t    ctx.fillRect(0, 0, w, h);\n222\t    ctx.restore();\n223\t\n224\t    ctx.save();\n225\t    ctx.globalAlpha = this.animAlpha;\n226\t\n227\t    const panelX = w * 0.1;\n228\t    const panelW = w * 0.8;\n229\t    const panelY = h * 0.08;\n230\t    const panelH = h * 0.84;\n231\t\n232\t    this.renderer.drawRoundRect(panelX, panelY, panelW, panelH, 8, '#1a140e', '#3a2a1a');\n233\t    ctx.strokeStyle = '#5a4030';\n234\t    ctx.lineWidth = 1;\n235\t    ctx.strokeRect(panelX + 3, panelY + 3, panelW - 6, panelH - 6);\n236\t\n237\t    if (this.currentNPC) {\n238\t      this.renderer.drawText(`审问：${this.currentNPC.name}`, panelX + panelW / 2, panelY + 18, {\n239\t        font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n240\t        color: '#c8a882', align: 'center',\n241\t      });\n242\t\n243\t      this.renderPressureBar(ctx, panelX + 30, panelY + 55, panelW - 60);\n244\t\n245\t      this.renderer.drawText('选择话题：', panelX + 30, h * 0.32, {\n246\t        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870',\n247\t      });\n248\t\n249\t      const topics = this.getAvailableTopics();\n250\t      topics.forEach((topic, i) => {\n251\t        const ty = h * 0.35 + i * 48;\n252\t        const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + 20, ty, panelW - 40, 40);\n253\t\n254\t        if (isHover) {\n255\t          ctx.fillStyle = 'rgba(200, 168, 130, 0.1)';\n256\t          ctx.fillRect(panelX + 20, ty, panelW - 40, 40);\n257\t        }\n258\t\n259\t        ctx.strokeStyle = '#3a2a1a';\n260\t        ctx.lineWidth = 1;\n261\t        ctx.strokeRect(panelX + 20, ty, panelW - 40, 40);\n262\t\n263\t        const asked = this.askedTopics.has(topic.id);\n264\t        this.renderer.drawText(\n265\t          `${asked ? '✓ ' : '  '}${topic.label}`,\n266\t          panelX + 35, ty + 10,\n267\t          {\n268\t            font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n269\t            color: asked ? '#5a4a3a' : isHover ? '#f0d8b0' : '#d8c8b0',\n270\t          }\n271\t        );\n272\t      });\n273\t\n274\t      if (topics.length === 0) {\n275\t        this.renderer.drawText('没有可问的话题', panelX + panelW / 2, h * 0.45, {\n276\t          font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n277\t        });\n278\t      }\n279\t\n280\t      const btnW = (panelW - 60) / 2;\n281\t      const btnY = h * 0.78;\n282\t\n283\t      const presentHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + 20, btnY, btnW, 40);\n284\t      this.renderer.drawRoundRect(panelX + 20, btnY, btnW, 40, 4,\n285\t        presentHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n286\t      this.renderer.drawText('出示物证', panelX + 20 + btnW / 2, btnY + 10, {\n287\t        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n288\t        color: presentHover ? '#e8c8a2' : '#a08870', align: 'center',\n289\t      });\n290\t\n291\t      const endX = panelX + 20 + btnW + 20;\n292\t      const endHover = this.isInRect(this.input.mouseX, this.input.mouseY, endX, btnY, btnW, 40);\n293\t      this.renderer.drawRoundRect(endX, btnY, btnW, 40, 4,\n294\t        endHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n295\t      this.renderer.drawText('结束审问', endX + btnW / 2, btnY + 10, {\n296\t        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n297\t        color: endHover ? '#e8c8a2' : '#a08870', align: 'center',\n298\t      });\n299\t    }\n300\t\n301\t    ctx.restore();\n302\t\n303\t    if (this.showingEvidenceSelect) {\n304\t      this.renderEvidenceSelect(ctx, w, h);\n305\t    }\n306\t  }\n307\t\n308\t  private renderPressureBar(ctx: CanvasRenderingContext2D, x: number, y: number, w: number) {\n309\t    if (!this.currentNPC) return;\n310\t\n311\t    this.renderer.drawText('压力：', x, y, {\n312\t      font: '15px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a',\n313\t    });\n314\t\n315\t    const barX = x + 50;\n316\t    const barW = w - 50;\n317\t    const barH = 12;\n318\t\n319\t    ctx.fillStyle = '#2a1a0e';\n320\t    ctx.fillRect(barX, y + 2, barW, barH);\n321\t\n322\t    const ratio = this.pressure / this.currentNPC.maxPressure;\n323\t    const pressureColor = ratio < 0.4 ? '#4a8a4a' : ratio < 0.7 ? '#c8a040' : '#8a3a3a';\n324\t    ctx.fillStyle = pressureColor;\n325\t    ctx.fillRect(barX, y + 2, barW * ratio, barH);\n326\t\n327\t    ctx.strokeStyle = '#3a2a1a';\n328\t    ctx.lineWidth = 1;\n329\t    ctx.strokeRect(barX, y + 2, barW, barH);\n330\t\n331\t    const relKey = Object.keys(this.state.relationships).find((k) =>\n332\t      this.currentNPC && k === this.currentNPC.id.replace('_', '')\n333\t    );\n334\t    if (relKey) {\n335\t      this.renderer.drawText(`好感: ${this.state.relationships[relKey]}`, barX + barW + 10, y, {\n336\t        font: '14px sans-serif', color: '#8a7a6a',\n337\t      });\n338\t    }\n339\t  }\n340\t\n341\t  private renderEvidenceSelect(ctx: CanvasRenderingContext2D, w: number, h: number) {\n342\t    ctx.save();\n343\t    ctx.globalAlpha = 0.9;\n344\t    ctx.fillStyle = '#0a0806';\n345\t    ctx.fillRect(0, 0, w, h);\n346\t    ctx.restore();\n347\t\n348\t    const panelX = w * 0.2;\n349\t    const panelW = w * 0.6;\n350\t    const panelY = h * 0.1;\n351\t    const panelH = h * 0.75;\n352\t\n353\t    this.renderer.drawRoundRect(panelX, panelY, panelW, panelH, 8, '#1a140e', '#5a4030');\n354\t    this.renderer.drawText('选择要出示的物证', panelX + panelW / 2, panelY + 18, {\n355\t      font: 'bold 22px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n356\t    });\n357\t\n358\t    const items = this.state.evidence;\n359\t    const listY = h * 0.2;\n360\t\n361\t    items.forEach((evId, i) => {\n362\t      const iy = listY + i * 44;\n363\t      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + 10, iy, panelW - 20, 38);\n364\t\n365\t      if (isHover) {\n366\t        ctx.fillStyle = 'rgba(200, 168, 130, 0.12)';\n367\t        ctx.fillRect(panelX + 10, iy, panelW - 20, 38);\n368\t      }\n369\t\n370\t      this.renderer.drawText(`▪ ${evId}`, panelX + 25, iy + 8, {\n371\t        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n372\t        color: isHover ? '#f0d8b0' : '#d8c8b0',\n373\t      });\n374\t    });\n375\t\n376\t    if (items.length === 0) {\n377\t      this.renderer.drawText('没有可出示的物证', panelX + panelW / 2, listY + 30, {\n378\t        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n379\t      });\n380\t    }\n381\t\n382\t    const cancelHover = this.isInRect(this.input.mouseX, this.input.mouseY, w * 0.4, h * 0.85, w * 0.2, 40);\n383\t    this.renderer.drawRoundRect(w * 0.4, h * 0.85, w * 0.2, 40, 4,\n384\t      cancelHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n385\t    this.renderer.drawText('取消', w / 2, h * 0.85 + 10, {\n386\t      font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n387\t      color: cancelHover ? '#e8c8a2' : '#a08870', align: 'center',\n388\t    });\n389\t  }\n390\t\n391\t  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n392\t    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n393\t  }\n394\t}\n395\t"}]},"parent_tool_use_id":null,"session_id":"b5a5daaf-c8fd-4523-92be-b3ba2de361bf","uuid":"dbdf6589-b112-4077-8da4-8cd89713c0a2","timestamp":"2026-05-23T17:34:19.834Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/steam-ancient-mystery/src/game/InterrogationSystem.ts","content":"import { Renderer } from '../renderer/Renderer';\nimport { GameState } from './GameState';\nimport { DialogueEngine, DialogueNode, DialogueChoice } from './DialogueEngine';\nimport { InputManager } from './InputManager';\n\nexport interface InterrogationNPC {\n  id: string;\n  name: string;\n  portrait?: string;\n  defaultPressure: number;\n  maxPressure: number;\n}\n\nexport interface InterrogationTopic {\n  id: string;\n  npcId: string;\n  label: string;\n  dialogueId: string;\n  requiresEvidence?: string[];\n  requiresFlag?: string[];\n  pressureRange?: { min: number; max: number };\n  repeatable: boolean;\n}\n\nexport class InterrogationSystem {\n  private npcs: Map<string, InterrogationNPC> = new Map();\n  private topics: Map<string, InterrogationTopic[]> = new Map();\n  private currentNPC: InterrogationNPC | null = null;\n  private pressure = 0;\n  private isInterrogating = false;\n  private selectedTopicIndex = -1;\n  private animAlpha = 0;\n  private askedTopics: Set<string> = new Set();\n  private showingEvidenceSelect = false;\n  private evidenceSelectFor: string | null = null;\n\n  constructor(\n    private renderer: Renderer,\n    private state: GameState,\n    private dialogueEngine: DialogueEngine,\n    private input: InputManager\n  ) {\n    this.setupInput();\n  }\n\n  registerNPC(npc: InterrogationNPC) {\n    this.npcs.set(npc.id, npc);\n  }\n\n  registerTopic(topic: InterrogationTopic) {\n    const list = this.topics.get(topic.npcId) ?? [];\n    list.push(topic);\n    this.topics.set(topic.npcId, list);\n  }\n\n  registerTopics(topics: InterrogationTopic[]) {\n    topics.forEach((t) => this.registerTopic(t));\n  }\n\n  startInterrogation(npcId: string): boolean {\n    const npc = this.npcs.get(npcId);\n    if (!npc) return false;\n\n    this.currentNPC = npc;\n    this.pressure = npc.defaultPressure;\n    this.isInterrogating = true;\n    this.selectedTopicIndex = -1;\n    this.animAlpha = 0;\n    this.showingEvidenceSelect = false;\n    return true;\n  }\n\n  endInterrogation() {\n    this.isInterrogating = false;\n    this.currentNPC = null;\n    this.showingEvidenceSelect = false;\n    this.evidenceSelectFor = null;\n  }\n\n  isRunning(): boolean { return this.isInterrogating; }\n\n  getPressure(): number { return this.pressure; }\n\n  addPressure(delta: number) {\n    if (!this.currentNPC) return;\n    this.pressure = Math.max(0, Math.min(this.currentNPC.maxPressure, this.pressure + delta));\n  }\n\n  getAvailableTopics(): InterrogationTopic[] {\n    if (!this.currentNPC) return [];\n    const allTopics = this.topics.get(this.currentNPC.id) ?? [];\n    return allTopics.filter((t) => this.canAskTopic(t));\n  }\n\n  private canAskTopic(topic: InterrogationTopic): boolean {\n    if (topic.requiresEvidence) {\n      for (const ev of topic.requiresEvidence) {\n        if (!this.state.hasEvidence(ev)) return false;\n      }\n    }\n    if (topic.requiresFlag) {\n      for (const f of topic.requiresFlag) {\n        if (!this.state.getFlag(f)) return false;\n      }\n    }\n    if (!topic.repeatable && this.askedTopics.has(topic.id)) return false;\n    if (topic.pressureRange) {\n      if (this.pressure < topic.pressureRange.min || this.pressure > topic.pressureRange.max) return false;\n    }\n    return true;\n  }\n\n  askTopic(topicId: string): boolean {\n    const topic = this.getAvailableTopics().find((t) => t.id === topicId);\n    if (!topic || !this.currentNPC) return false;\n\n    this.askedTopics.add(topicId);\n    this.addPressure(5);\n\n    return this.dialogueEngine.start(topic.dialogueId, () => {\n      this.selectedTopicIndex = -1;\n    });\n  }\n\n  presentEvidence(evidenceId: string): boolean {\n    if (!this.currentNPC) return false;\n    this.addPressure(8);\n\n    const topic = this.getAvailableTopics().find(\n      (t) => t.requiresEvidence?.includes(evidenceId)\n    );\n    if (topic) {\n      return this.askTopic(topic.id);\n    }\n    return false;\n  }\n\n  private setupInput() {\n    this.input.onClick((e) => {\n      if (e.type !== 'up') return;\n      if (!this.isInterrogating) return;\n      if (this.dialogueEngine.getIsActive()) return;\n      if (this.showingEvidenceSelect) {\n        this.handleEvidenceClick(e.x, e.y);\n        return;\n      }\n      this.handleTopicClick(e.x, e.y);\n    });\n  }\n\n  private handleTopicClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    const panelX = w * 0.1;\n    const panelW = w * 0.8;\n    const topicY = h * 0.35;\n\n    const topics = this.getAvailableTopics();\n    for (let i = 0; i < topics.length; i++) {\n      const ty = topicY + i * 48;\n      if (this.isInRect(x, y, panelX + 20, ty, panelW - 40, 40)) {\n        this.askTopic(topics[i].id);\n        return;\n      }\n    }\n\n    const presentY = h * 0.78;\n    if (this.isInRect(x, y, panelX + 20, presentY, (panelW - 60) / 2, 40)) {\n      this.showingEvidenceSelect = true;\n      this.evidenceSelectFor = 'present';\n      return;\n    }\n\n    const endY = h * 0.78;\n    const endX = panelX + 20 + (panelW - 60) / 2 + 20;\n    if (this.isInRect(x, y, endX, endY, (panelW - 60) / 2, 40)) {\n      this.endInterrogation();\n    }\n  }\n\n  private handleEvidenceClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    const items = this.state.evidence;\n    const panelX = w * 0.2;\n    const panelW = w * 0.6;\n    const listY = h * 0.2;\n\n    for (let i = 0; i < items.length; i++) {\n      const iy = listY + i * 44;\n      if (this.isInRect(x, y, panelX + 10, iy, panelW - 20, 38)) {\n        this.showingEvidenceSelect = false;\n        this.presentEvidence(items[i]);\n        return;\n      }\n    }\n\n    if (this.isInRect(x, y, w * 0.4, h * 0.85, w * 0.2, 40)) {\n      this.showingEvidenceSelect = false;\n    }\n  }\n\n  update(dt: number) {\n    if (!this.isInterrogating) return;\n    this.animAlpha = Math.min(1, this.animAlpha + dt * 5);\n  }\n\n  render() {\n    if (!this.isInterrogating) return;\n    if (this.dialogueEngine.getIsActive()) return;\n\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.save();\n    ctx.globalAlpha = this.animAlpha * 0.7;\n    ctx.fillStyle = '#0a0806';\n    ctx.fillRect(0, 0, w, h);\n    ctx.restore();\n\n    ctx.save();\n    ctx.globalAlpha = this.animAlpha;\n\n    const panelX = w * 0.1;\n    const panelW = w * 0.8;\n    const panelY = h * 0.08;\n    const panelH = h * 0.84;\n\n    this.renderer.drawRoundRect(panelX, panelY, panelW, panelH, 8, '#1a140e', '#3a2a1a');\n    ctx.strokeStyle = '#5a4030';\n    ctx.lineWidth = 1;\n    ctx.strokeRect(panelX + 3, panelY + 3, panelW - 6, panelH - 6);\n\n    if (this.currentNPC) {\n      this.renderer.drawText(`审问：${this.currentNPC.name}`, panelX + panelW / 2, panelY + 18, {\n        font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n        color: '#c8a882', align: 'center',\n      });\n\n      this.renderPressureBar(ctx, panelX + 30, panelY + 55, panelW - 60);\n\n      this.renderer.drawText('选择话题：', panelX + 30, h * 0.32, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870',\n      });\n\n      const topics = this.getAvailableTopics();\n      topics.forEach((topic, i) => {\n        const ty = h * 0.35 + i * 48;\n        const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + 20, ty, panelW - 40, 40);\n\n        if (isHover) {\n          ctx.fillStyle = 'rgba(200, 168, 130, 0.1)';\n          ctx.fillRect(panelX + 20, ty, panelW - 40, 40);\n        }\n\n        ctx.strokeStyle = '#3a2a1a';\n        ctx.lineWidth = 1;\n        ctx.strokeRect(panelX + 20, ty, panelW - 40, 40);\n\n        const asked = this.askedTopics.has(topic.id);\n        this.renderer.drawText(\n          `${asked ? '✓ ' : '  '}${topic.label}`,\n          panelX + 35, ty + 10,\n          {\n            font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n            color: asked ? '#5a4a3a' : isHover ? '#f0d8b0' : '#d8c8b0',\n          }\n        );\n      });\n\n      if (topics.length === 0) {\n        this.renderer.drawText('没有可问的话题', panelX + panelW / 2, h * 0.45, {\n          font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n        });\n      }\n\n      const btnW = (panelW - 60) / 2;\n      const btnY = h * 0.78;\n\n      const presentHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + 20, btnY, btnW, 40);\n      this.renderer.drawRoundRect(panelX + 20, btnY, btnW, 40, 4,\n        presentHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n      this.renderer.drawText('出示物证', panelX + 20 + btnW / 2, btnY + 10, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n        color: presentHover ? '#e8c8a2' : '#a08870', align: 'center',\n      });\n\n      const endX = panelX + 20 + btnW + 20;\n      const endHover = this.isInRect(this.input.mouseX, this.input.mouseY, endX, btnY, btnW, 40);\n      this.renderer.drawRoundRect(endX, btnY, btnW, 40, 4,\n        endHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n      this.renderer.drawText('结束审问', endX + btnW / 2, btnY + 10, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n        color: endHover ? '#e8c8a2' : '#a08870', align: 'center',\n      });\n    }\n\n    ctx.restore();\n\n    if (this.showingEvidenceSelect) {\n      this.renderEvidenceSelect(ctx, w, h);\n    }\n  }\n\n  private renderPressureBar(ctx: CanvasRenderingContext2D, x: number, y: number, w: number) {\n    if (!this.currentNPC) return;\n\n    this.renderer.drawText('压力：', x, y, {\n      font: '15px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a',\n    });\n\n    const barX = x + 50;\n    const barW = w - 50;\n    const barH = 12;\n\n    ctx.fillStyle = '#2a1a0e';\n    ctx.fillRect(barX, y + 2, barW, barH);\n\n    const ratio = this.pressure / this.currentNPC.maxPressure;\n    const pressureColor = ratio < 0.4 ? '#4a8a4a' : ratio < 0.7 ? '#c8a040' : '#8a3a3a';\n    ctx.fillStyle = pressureColor;\n    ctx.fillRect(barX, y + 2, barW * ratio, barH);\n\n    ctx.strokeStyle = '#3a2a1a';\n    ctx.lineWidth = 1;\n    ctx.strokeRect(barX, y + 2, barW, barH);\n\n    const relKey = Object.keys(this.state.relationships).find((k) =>\n      this.currentNPC && k === this.currentNPC.id.replace('_', '')\n    );\n    if (relKey) {\n      this.renderer.drawText(`好感: ${this.state.relationships[relKey]}`, barX + barW + 10, y, {\n        font: '14px sans-serif', color: '#8a7a6a',\n      });\n    }\n  }\n\n  private renderEvidenceSelect(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    ctx.save();\n    ctx.globalAlpha = 0.9;\n    ctx.fillStyle = '#0a0806';\n    ctx.fillRect(0, 0, w, h);\n    ctx.restore();\n\n    const panelX = w * 0.2;\n    const panelW = w * 0.6;\n    const panelY = h * 0.1;\n    const panelH = h * 0.75;\n\n    this.renderer.drawRoundRect(panelX, panelY, panelW, panelH, 8, '#1a140e', '#5a4030');\n    this.renderer.drawText('选择要出示的物证', panelX + panelW / 2, panelY + 18, {\n      font: 'bold 22px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    const items = this.state.evidence;\n    const listY = h * 0.2;\n\n    items.forEach((evId, i) => {\n      const iy = listY + i * 44;\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + 10, iy, panelW - 20, 38);\n\n      if (isHover) {\n        ctx.fillStyle = 'rgba(200, 168, 130, 0.12)';\n        ctx.fillRect(panelX + 10, iy, panelW - 20, 38);\n      }\n\n      this.renderer.drawText(`▪ ${evId}`, panelX + 25, iy + 8, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n        color: isHover ? '#f0d8b0' : '#d8c8b0',\n      });\n    });\n\n    if (items.length === 0) {\n      this.renderer.drawText('没有可出示的物证', panelX + panelW / 2, listY + 30, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n      });\n    }\n\n    const cancelHover = this.isInRect(this.input.mouseX, this.input.mouseY, w * 0.4, h * 0.85, w * 0.2, 40);\n    this.renderer.drawRoundRect(w * 0.4, h * 0.85, w * 0.2, 40, 4,\n      cancelHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('取消', w / 2, h * 0.85 + 10, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n      color: cancelHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n  }\n\n  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n  }\n}\n","numLines":395,"startLine":1,"totalLines":395}}}
