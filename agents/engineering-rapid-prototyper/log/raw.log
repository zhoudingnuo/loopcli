 SaveSlot[] {\n    try {\n      const raw = localStorage.getItem(STORAGE_KEY);\n      return raw ? JSON.parse(raw) : [];\n    } catch {\n      return [];\n    }\n  }\n\n  static save(state: GameState, slotId: number): boolean {\n    try {\n      const saves = this.getSaveSlots();\n      const slot = state.toSaveSlot(slotId);\n      const idx = saves.findIndex((s) => s.id === slotId);\n      if (idx >= 0) saves[idx] = slot;\n      else saves.push(slot);\n      localStorage.setItem(STORAGE_KEY, JSON.stringify(saves));\n      return true;\n    } catch {\n      return false;\n    }\n  }\n\n  static load(state: GameState, slotId: number): boolean {\n    const saves = this.getSaveSlots();\n    const slot = saves.find((s) => s.id === slotId);\n    if (!slot) return false;\n    state.loadFromSlot(slot);\n    return true;\n  }\n\n  static deleteSave(slotId: number): boolean {\n    const saves = this.getSaveSlots();\n    const filtered = saves.filter((s) => s.id !== slotId);\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(filtered));\n    return filtered.length < saves.length;\n  }\n}\n","numLines":44,"startLine":1,"totalLines":44}}}
