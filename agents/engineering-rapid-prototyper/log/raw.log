charIndex >= this.displayText.length) {\n      this.charIndex = this.displayText.length;\n      this.isTyping = false;\n    }\n  }\n\n  getDisplayText(): string { return this.displayText.substring(0, Math.floor(this.charIndex)); }\n  getSpeaker(): string | undefined { return this.currentNode?.speaker; }\n  getPortrait(): string | undefined { return this.currentNode?.portrait; }\n  getChoices(): DialogueChoice[] {\n    return this.currentNode?.choices?.filter((c) => {\n      if (!c.condition) return true;\n      if (c.condition.flag && !this.state.getFlag(c.condition.flag)) return false;\n      if (c.condition.evidence && !this.state.hasEvidence(c.condition.evidence)) return false;\n      return true;\n    }) ?? [];\n  }\n  getIsActive(): boolean { return this.isActive; }\n  getIsTyping(): boolean { return this.isTyping; }\n\n  setSpeed(charsPerSec: number) { this.charsPerSecond = charsPerSec; }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
{"type":"assistant","message":{"id":"msg_2026052322530524f4d09a7c274b08","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_c53d0fb335d0441eb07debda","name":"Write","input":{"file_path":"D:\\game-projects\\steam-ancient-mystery\\src\\utils\\ink.ts","content":"import { Renderer } from '../renderer/Renderer';\n\ninterface InkParticle {\n  x: number;\n  y: number;\n  radius: number;\n  alpha: number;\n  vx: number;\n  vy: number;\n  life: number;\n  maxLife: number;\n}\n\nexport class InkRenderer {\n  private particles: InkParticle[] = [];\n  private offscreen: HTMLCanvasElement;\n  private offCtx: CanvasRenderingContext2D;\n\n  constructor(private renderer: Renderer) {\n    this.offscreen = document.createElement('canvas');\n    this.offscreen.width = 256;\n    this.offscreen.height = 256;\n    this.offCtx = this.offscreen.getContext('2d')!;\n  }\n\n  update(dt: number) {\n    this.particles.forEach((p) => {\n      p.x += p.vx * dt;\n      p.y += p.vy * dt;\n      p.radius += dt * 15;\n      p.life -= dt;\n      p.alpha = Math.max(0, (p.life / p.maxLife) * 0.3);\n    });\n    this.particles = this.particles.filter((p) => p.life > 0);\n  }\n\n  spawnBurst(cx: number, cy: number, count = 12) {\n    for (let i = 0; i < count; i++) {\n      const angle = Math.random() * Math.PI * 2;\n      const speed = 20 + Math.random() * 60;\n      this.particles.push({\n        x: cx, y: cy,\n        radius: 5 + Math.random() * 15,\n        alpha: 0.2 + Math.random() * 0.15,\n        vx: Math.cos(angle) * speed,\n        vy: Math.sin(angle) * speed,\n        life: 1 + Math.random() * 2,\n        maxLife: 1 + Math.random() * 2,\n      });\n    }\n  }\n\n  renderTransition(progress: number) {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    if (progress < 0.5) {\n      const p = progress * 2;\n      ctx.save();\n      ctx.globalAlpha = p;\n      ctx.fillStyle = '#050508';\n      ctx.fillRect(0, 0, w, h);\n\n      this.renderInkSpread(ctx, w / 2, h / 2, p * Math.max(w, h) * 0.6);\n      ctx.restore();\n    } else {\n      const p = (progress - 0.5) * 2;\n      ctx.save();\n      ctx.globalAlpha = 1 - p;\n      ctx.fillStyle = '#050508';\n      ctx.fillRect(0, 0, w, h);\n      ctx.restore();\n    }\n\n    this.renderParticles(ctx);\n  }\n\n  renderInkFilter(alpha: number) {\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n    ctx.save();\n    ctx.globalAlpha = alpha;\n\n    const imageData = ctx.getImageData(0, 0, w, h);\n    const data = imageData.data;\n    for (let i = 0; i < data.length; i += 16) {\n      const avg = (data[i] + data[i + 1] + data[i + 2]) / 3;\n      const ink = avg > 128 ? 255 : avg * 1.5;\n      data[i] = ink * 0.9;\n      data[i + 1] = ink * 0.85;\n      data[i + 2] = ink * 0.8;\n    }\n    ctx.putImageData(imageData, 0, 0);\n    ctx.restore();\n  }\n\n  private renderInkSpread(ctx: CanvasRenderingContext2D, cx: number, cy: number, radius: number) {\n    const r = Math.max(1, radius);\n    const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, r);\n    grad.addColorStop(0, 'rgba(5, 5, 8, 0)');\n    grad.addColorStop(0.3, 'rgba(5, 5, 8, 0.3)');\n    grad.addColorStop(0.7, 'rgba(5, 5, 8, 0.7)');\n    grad.addColorStop(1, 'rgba(5, 5, 8, 0.95)');\n    ctx.fillStyle = grad;\n\n    ctx.beginPath();\n    const points = 24;\n    for (let i = 0; i <= points; i++) {\n      const a = (i / points) * Math.PI * 2;\n      const wobble = r * (0.8 + 0.3 * Math.sin(a * 3 + radius * 0.01));\n      const px = cx + Math.cos(a) * wobble;\n      const py = cy + Math.sin(a) * wobble;\n      if (i === 0) ctx.moveTo(px, py);\n      else ctx.lineTo(px, py);\n    }\n    ctx.closePath();\n    ctx.fill();\n  }\n\n  private renderParticles(ctx: CanvasRenderingContext2D) {\n    this.particles.forEach((p) => {\n      ctx.save();\n      ctx.globalAlpha = p.alpha;\n      ctx.fillStyle = '#1a1520';\n      ctx.beginPath();\n      const r = Math.max(0.5, p.radius);\n      ctx.arc(p.x, p.y, r, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.restore();\n    });\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"f441f9ea-17f7-4616-a9e1-d3dddf54df7a","uuid":"da88c702-0ca6-4129-bc96-669a2c82fbca"}
