0';ctx.font='bold 30px Arial';ctx.fillText('游戏结束',cx,py+50);\n    ctx.fillStyle='#FFFFFF';ctx.font='20px Arial';ctx.fillText('得分: '+score.toLocaleString(),cx,py+100);\n    ctx.fillStyle='#AAAAAA';ctx.font='18px Arial';ctx.fillText('第 '+level+' 关',cx,py+135);ctx.fillText('最高分: '+best.toLocaleString(),cx,py+165);\n    var bw=160,bh=48,bx=cx-bw/2,by2=py+ph-80;\n    ctx.fillStyle='#2ED573';this._roundRect(bx,by2,bw,bh,24);ctx.fill();ctx.fillStyle='#FFFFFF';ctx.font='bold 20px Arial';ctx.textBaseline='middle';ctx.fillText('再来一局',cx,by2+bh/2);ctx.textBaseline='alphabetic';\n    ctx.restore();\n    this._retryBtn={x:bx,y:by2,w:bw,h:bh};\n  };\n\n  Renderer.prototype.drawLevelComplete = function(score,level,best) {\n    var ctx=this.ctx,dpr=(adapter.getSystemInfo().pixelRatio||1),w=this.canvas.width/dpr,h=this.canvas.height/dpr;\n    ctx.save();ctx.setTransform(1,0,0,1,0,0);ctx.scale(dpr,dpr);\n    ctx.fillStyle='rgba(0,0,0,0.75)';ctx.fillRect(0,0,w,h);\n    var cx=w/2,cy=h/2,pw=w*0.8,ph=320,px=cx-pw/2,py=cy-ph/2;\n    ctx.fillStyle='#16213E';this._roundRect(px,py,pw,ph,20);ctx.fill();ctx.strokeStyle='#2ED573';ctx.lineWidth=2;this._roundRect(px,py,pw,ph,20);ctx.stroke();\n    ctx.textAlign='center';ctx.fillStyle='#2ED573';ctx.font='bold 30px Arial';ctx.fillText('过关！',cx,py+50);\n    ctx.fillStyle='#FFFFFF';ctx.font='20px Arial';ctx.fillText('得分: '+score.toLocaleString(),cx,py+100);\n    ctx.fillStyle='#FFD700';ctx.font='bold 22px Arial';ctx.fillText('进入第 '+(level+1)+' 关',cx,py+145);\n    ctx.fillStyle='#AAAAAA';ctx.font='18px Arial';ctx.fillText('最高分: '+best.toLocaleString(),cx,py+180);\n    var bw=160,bh=48,bx=cx-bw/2,by2=py+ph-80;\n    ctx.fillStyle='#FFD700';this._roundRect(bx,by2,bw,bh,24);ctx.fill();ctx.fillStyle='#1A1A2E';ctx.font='bold 20px Arial';ctx.textBaseline='middle';ctx.fillText('下一关',cx,by2+bh/2);ctx.textBaseline='alphabetic';\n    ctx.restore();\n    this._nextBtn={x:bx,y:by2,w:bw,h:bh};\n  };\n\n  Renderer.prototype.addScorePopup = function(r,c,score) {\n    var l=this.layout;this.scorePopups.push({x:l.x+c*(l.cellSize+config.CELL_GAP)+l.cellSize/2,y:l.y+r*(l.cellSize+config.CELL_GAP),text:'+'+score,life:1});\n  };\n  Renderer.prototype.setComboText = function(combo) { if(combo>1) this.comboText={text:combo+'x 连击！',life:1}; };\n  Renderer.prototype.addParticles = function(r,c,type) {\n    var l=this.layout,px=l.x+c*(l.cellSize+config.CELL_GAP)+l.cellSize/2,py=l.y+r*(l.cellSize+config.CELL_GAP)+l.cellSize/2,color=config.PIECE_COLORS[type]||'#FFF';\n    for(var i=0;i<6;i++){var a=(Math.PI*2/6)*i+Math.random()*0.5;this.particles.push({x:px,y:py,vx:Math.cos(a)*(2+Math.random()*3),vy:Math.sin(a)*(2+Math.random()*3),life:1,color:color,size:3+Math.random()*3})}\n  };\n  Renderer.prototype.updateEffects = function(dt) {\n    for(var i=this.particles.length-1;i>=0;i--){var p=this.particles[i];p.x+=p.vx;p.y+=p.vy;p.vy+=0.15;p.life-=dt*2;if(p.life<=0)this.particles.splice(i,1)}\n    for(var i=this.scorePopups.length-1;i>=0;i--){var p=this.scorePopups[i];p.y-=1.5;p.life-=dt*1.5;if(p.life<=0)this.scorePopups.splice(i,1)}\n    if(this.comboText){this.comboText.life-=dt;if(this.comboText.life<=0)this.comboText=null}\n    if(this.screenShake>0)this.screenShake-=dt*10;\n  };\n  Renderer.prototype.drawEffects = function() {\n    var ctx=this.ctx;\n    if(this.screenShake>0){var s=this.screenShake*2;ctx.save();ctx.translate((Math.random()-0.5)*s,(Math.random()-0.5)*s)}\n    for(var i=0;i<this.particles.length;i++){var p=this.particles[i];ctx.globalAlpha=p.life;ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(p.x,p.y,p.size*p.life,0,Math.PI*2);ctx.fill()}\n    ctx.globalAlpha=1;\n    for(var i=0;i<this.scorePopups.length;i++){var p=this.scorePopups[i];ctx.globalAlpha=p.life;ctx.fillStyle='#FFD700';ctx.font='bold 18px Arial';ctx.textAlign='center';ctx.fillText(p.text,p.x,p.y)}\n    ctx.globalAlpha=1;\n    if(this.comboText){ctx.globalAlpha=this.comboText.life;ctx.fillStyle='#FF6348';ctx.font='bold 32px Arial';ctx.textAlign='center';\n    var dpr=(adapter.getSystemInfo().pixelRatio||1);\n    ctx.fillText(this.comboText.text,this.canvas.width/dpr/2,this.layout.y-20)}\n    ctx.globalAlpha=1;\n    if(this.screenShake>0)ctx.restore();\n  };\n  Renderer.prototype.setPieceOffset=function(r,c,dx,dy){this.pieceOffset[r+','+c]={dx:dx,dy:dy}};\n  Renderer.prototype.clearPieceOffset=function(r,c){delete this.pieceOffset[r+','+c]};\n  Renderer.prototype.setPieceScale=function(r,c,s){this.pieceScale[r+','+c]=s};\n  Renderer.prototype.clearPieceScale=function(r,c){delete this.pieceScale[r+','+c]};\n  Renderer.prototype._roundRect=function(x,y,w,h,r){var ctx=this.ctx;ctx.beginPath();ctx.moveTo(x+r,y);ctx.lineTo(x+w-r,y);ctx.quadraticCurveTo(x+w,y,x+w,y+r);ctx.lineTo(x+w,y+h-r);ctx.quadraticCurveTo(x+w,y+h,x+w-r,y+h);ctx.lineTo(x+r,y+h);ctx.quadraticCurveTo(x,y+h,x,y+h-r);ctx.lineTo(x,y+r);ctx.quadraticCurveTo(x,y,x+r,y);ctx.closePath()};\n  Renderer.prototype._darken=function(hex,f){var n=parseInt(hex.slice(1),16),r=Math.floor(((n>>16)&0xFF)*f),g=Math.floor(((n>>8)&0xFF)*f),b=Math.floor((n&0xFF)*f);return '#'+((1<<24)+(r<<16)+(g<<8)+b).toString(16).slice(1)};\n\n  module.exports = Renderer;\n});\n</script>\n<script>\n// === Main Game (inline, using the module system) ===\n(function() {\n  var adapter = require('./adapter/index');\n  var config = require('./js/config');\n  var utils = require('./js/utils');\n  var Board = require('./js/board');\n  var Renderer = require('./js/renderer');\n  var InputHandler = require('./js/input');\n  var AnimationManager = require('./js/animation');\n  var ScoreManager = require('./js/score-manager');\n\n  var easeOutQuad = utils.easeOutQuad;\n  var easeOutBounce = utils.easeOutBounce;\n\n  function calcLayout(sw, sh) {\n    var topH=config.TOP_BAR_HEIGHT, botH=config.BOTTOM_BAR_HEIGHT;\n    var availH=sh-topH-botH, availW=sw-32;\n    var gap=config.CELL_GAP;\n    var maxCW=(availW-gap*(config.GRID_SIZE-1))/config.GRID_SIZE;\n    var maxCH=(availH-gap*(config.GRID_SIZE-1)-20)/config.GRID_SIZE;\n    var cs=Math.floor(Math.min(maxCW,maxCH));\n    var bw=cs*config.GRID_SIZE+gap*(config.GRID_SIZE-1);\n    return {x:(sw-bw)/2, y:topH+(availH-bw)/2, width:bw, height:bw, cellSize:cs, topBarHeight:topH, bottomBarHeight:botH};\n  }\n\n  function Game() {\n    var si=adapter.getSystemInfo(), dpr=si.pixelRatio||1, sw=si.windowWidth, sh=si.windowHeight;\n    this.canvas=document.querySelector('canvas')||document.createElement('canvas');\n    this.canvas.width=sw*dpr; this.canvas.height=sh*dpr;\n    this.canvas.style.width=sw+'px'; this.canvas.style.height=sh+'px';\n    var ctx=this.canvas.getContext('2d'); ctx.scale(dpr,dpr);\n    this.screenW=sw; this.screenH=sh; this.dpr=dpr;\n    this.layout=calcLayout(sw,sh);\n    this.board=new Board();\n    this.renderer=new Renderer(this.canvas,this.layout);\n    this.input=new InputHandler(this.layout);\n    this.anim=new AnimationManager();\n    this.score=new ScoreManager();\n    this.state='idle';\n    this._bindEvents();\n    this._lastTime=Date.now();\n    this._loop();\n  }\n\n  Game.prototype._bindEvents = function() {\n    var self=this;\n    adapter.onTouchStart(function(e) {\n      var t=e.touches?e.touches[0]:e, x=t.clientX||t.pageX, y=t.clientY||t.pageY;\n      if(self.state==='gameover'||self.state==='levelcomplete'){self.input.handleClick(x,y);return}\n      if(self.state!=='idle')return;\n      self.input.handleTouchStart(x,y);\n    });\n    adapter.onTouchMove(function(e) {\n      var t=e.touches?e.touches[0]:e, x=t.clientX||t.pageX, y=t.clientY||t.pageY;\n      if(self.state!=='idle')return;\n      self.input.handleTouchMove(x,y);\n    });\n    adapter.onTouchEnd(function(){self.input.handleTouchEnd()});\n\n    this.input.onSelect=function(cell){self.renderer.selectedCell=cell;if(cell)adapter.vibrateShort()};\n    this.input.onSwap=function(r1,c1,r2,c2){self._trySwap(r1,c1,r2,c2)};\n    this.input.onBtnClick=function(x,y){\n      if(self.state==='gameover'){var b=self.renderer._retryBtn;if(b&&x>=b.x&&x<=b.x+b.w&&y>=b.y&&y<=b.y+b.h)self._restart()}\n      if(self.state==='levelcomplete'){var b=self.renderer._nextBtn;if(b&&x>=b.x&&x<=b.x+b.w&&y>=b.y&&y<=b.y+b.h)self._nextLevel()}\n      var rb=self.renderer._restartBtn;if(rb&&x>=rb.x&&x<=rb.x+rb.w&&y>=rb.y&&y<=rb.y+rb.h)self._restart();\n    };\n  };\n\n  Game.prototype._trySwap = function(r1,c1,r2,c2) {\n    var self=this; adapter.vibrateShort(); this.state='swapping';\n    var cs=this.layout.cellSize, dx=(c2-c1)*(cs+config.CELL_GAP), dy=(r2-r1)*(cs+config.CELL_GAP);\n    this.anim.add(150,function(t){var e=easeOutQuad(t);self.renderer.setPieceOffset(r1,c1,dx*e,dy*e);self.renderer.setPieceOffset(r2,c2,-dx*e,-dy*e)},function(){\n      self.renderer.clearPieceOffset(r1,c1);self.renderer.clearPieceOffset(r2,c2);self.board.swap(r1,c1,r2,c2);\n      var ms=self.board.findMatches();\n      if(ms.length===0){\n        self.anim.add(150,function(t){var e=easeOutQuad(t);self.renderer.setPieceOffset(r1,c1,-dx*e,-dy*e);self.renderer.setPieceOffset(r2,c2,dx*e,dy*e)},function(){\n          self.renderer.clearPieceOffset(r1,c1);self.renderer.clearPieceOffset(r2,c2);self.board.swap(r1,c1,r2,c2);self.state='idle';\n        });\n      } else { self.score.useMove(); self.score.startCombo(); self._processMatches(); }\n    });\n  };\n\n  Game.prototype._processMatches = function() {\n    var self=this, ms=this.board.findMatches();\n    if(ms.length===0){\n      if(!this.board.hasValidMoves())this.board.shuffle();\n      if(this.score.isLevelComplete()){this.state='levelcomplete';this.score.saveBest()}\n      else if(this.score.isGameOver()){this.state='gameover';this.score.saveBest()}\n      else this.state='idle';\n      return;\n    }\n    var combo=this.score.incrementCombo(); this.renderer.setComboText(combo); this.renderer.screenShake=1.5;\n    var groups=this._groupMatches(ms), totalScore=0;\n    for(var i=0;i<groups.length;i++){\n      var pts=this.score.addScore(groups[i].length); totalScore+=pts;\n      var avgR=0,avgC=0;for(var j=0;j<groups[i].length;j++){avgR+=groups[i][j].r;avgC+=groups[i][j].c}\n      avgR/=groups[i].length;avgC/=groups[i].length;\n      this.renderer.addScorePopup(avgR,avgC,pts);\n    }\n    this.state='removing';\n    var removed=this.board.removeMatches(ms);\n    for(var i=0;i<removed.length;i++)this.renderer.addParticles(removed[i].r,removed[i].c,removed[i].type);\n    this.anim.add(200,function(t){for(var i=0;i<removed.length;i++)self.renderer.setPieceScale(removed[i].r,removed[i].c,1-easeOutQuad(t))},function(){\n      for(var i=0;i<removed.length;i++)self.renderer.clearPieceScale(removed[i].r,removed[i].c);\n      self._applyGravity();\n    });\n  };\n\n  Game.prototype._groupMatches = function(ms) {\n    var set={},i;for(i=0;i<ms.length;i++)set[ms[i].r+','+ms[i].c]=ms[i];\n    var visited={},groups=[];\n    for(i=0;i<ms.length;i++){\n      var k=ms[i].r+','+ms[i].c;if(visited[k])continue;\n      var group=[],queue=[ms[i]];\n      while(queue.length>0){var cur=queue.pop(),ck=cur.r+','+cur.c;if(visited[ck])continue;visited[ck]=true;group.push(cur);\n        var dirs=[[0,1],[0,-1],[1,0],[-1,0]];for(var d=0;d<4;d++){var nk=(cur.r+dirs[d][0])+','+(cur.c+dirs[d][1]);if(set[nk]&&!visited[nk])queue.push(set[nk])}}\n      groups.push(group);\n    }\n    return groups;\n  };\n\n  Game.prototype._applyGravity = function() {\n    var self=this; this.state='falling';\n    var moves=this.board.applyGravity(), spawns=this.board.refill(), cs=this.layout.cellSize;\n    var all=[];\n    for(var i=0;i<moves.length;i++)all.push({r:moves[i].toR,c:moves[i].toC,fromDy:(moves[i].fromR-moves[i].toR)*(cs+config.CELL_GAP)});\n    for(var i=0;i<spawns.length;i++)all.push({r:spawns[i].r,c:spawns[i].c,fromDy:(spawns[i].fromR-spawns[i].r)*(cs+config.CELL_GAP)});\n    if(all.length===0){this._processMatches();return}\n    this.anim.add(300,function(t){var e=easeOutBounce(t);for(var i=0;i<all.length;i++)self.renderer.setPieceOffset(all[i].r,all[i].c,0,all[i].fromDy*(1-e))},function(){\n      for(var i=0;i<all.length;i++)self.renderer.clearPieceOffset(all[i].r,all[i].c);\n      self._processMatches();\n    });\n  };\n\n  Game.prototype._restart = function() {\n    this.board.init();this.score.reset();this.anim.clear();\n    this.renderer.particles=[];this.renderer.scorePopups=[];this.renderer.comboText=null;this.renderer.screenShake=0;\n    this.renderer.pieceOffset={};this.renderer.pieceScale={};this.input.reset();this.state='idle';\n  };\n\n  Game.prototype._nextLevel = function() {\n    this.score.nextLevel();this.board.init();this.anim.clear();\n    this.renderer.particles=[];this.renderer.scorePopups=[];this.renderer.comboText=null;this.renderer.screenShake=0;\n    this.renderer.pieceOffset={};this.renderer.pieceScale={};this.input.reset();this.state='idle';\n  };\n\n  Game.prototype._loop = function() {\n    var self=this, now=Date.now(), dt=Math.min((now-this._lastTime)/1000,0.1);\n    this._lastTime=now;\n    this.anim.update(dt*1000);this.renderer.updateEffects(dt);\n    var r=this.renderer;r.clear();r.drawBackground();\n    r.drawTopBar(this.score.score,this.score.level,this.score.movesLeft,this.score.targetScore);\n    r.drawBoard();r.drawPieces(this.board);r.drawEffects();r.drawBottomBar();\n    if(this.state==='gameover')r.drawGameOver(this.score.score,this.score.level,this.score.bestScore);\n    if(this.state==='levelcomplete')r.drawLevelComplete(this.score.score,this.score.level,this.score.bestScore);\n    requestAnimationFrame(function(){self._loop()});\n  };\n\n  new Game();\n})();\n</script>\n</body>\n</html>\n","numLines":707,"startLine":1,"totalLines":707}}}
