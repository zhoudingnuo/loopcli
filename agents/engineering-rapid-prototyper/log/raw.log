0, (this.relationships[npc] ?? 50) + delta));\n  }\n\n  toSaveSlot(id: number): SaveSlot {\n    return {\n      id,\n      chapter: this.chapter,\n      scene: this.scene,\n      timestamp: Date.now(),\n      playTime: this.playTime,\n      flags: { ...this.flags },\n      evidence: [...this.evidence],\n      choices: { ...this.choices },\n      relationships: { ...this.relationships },\n    };\n  }\n\n  loadFromSlot(slot: SaveSlot) {\n    this.chapter = slot.chapter;\n    this.scene = slot.scene;\n    this.flags = { ...slot.flags };\n    this.evidence = [...slot.evidence];\n    this.choices = { ...slot.choices };\n    this.relationships = { ...slot.relationships };\n    this.playTime = slot.playTime;\n  }\n}\n","numLines":71,"startLine":1,"totalLines":71}}}
