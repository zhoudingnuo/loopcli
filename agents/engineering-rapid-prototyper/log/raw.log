{"type":"assistant","message":{"id":"msg_20260523233724697bec55372a4340","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_38afe0bdbee34b9b8c33318a","name":"Write","input":{"file_path":"D:\\game-projects\\steam-ancient-mystery\\src\\game\\EvidenceCombiner.ts","content":"import { Renderer } from '../renderer/Renderer';\nimport { GameState } from './GameState';\nimport { InputManager } from './InputManager';\nimport { EvidenceCollector, EvidenceItem } from './EvidenceCollector';\n\nexport interface CombinationRecipe {\n  id: string;\n  inputs: string[];\n  output: string;\n  outputName: string;\n  outputDescription: string;\n  outputCategory: 'key' | 'normal' | 'misleading';\n}\n\ninterface DragItem {\n  evidenceId: string;\n  x: number;\n  y: number;\n  originX: number;\n  originY: number;\n  slotIndex: number;\n}\n\nexport class EvidenceCombiner {\n  private recipes: CombinationRecipe[] = [];\n  private isOpen = false;\n  private animAlpha = 0;\n\n  private slot1: string | null = null;\n  private slot2: string | null = null;\n  private dragging: DragItem | null = null;\n\n  private resultItem: EvidenceItem | null = null;\n  private resultAlpha = 0;\n  private resultTimer = 0;\n\n  private failMessage = '';\n  private failTimer = 0;\n\n  private slotPositions: { x: number; y: number; w: number; h: number }[] = [];\n\n  constructor(\n    private renderer: Renderer,\n    private state: GameState,\n    private input: InputManager,\n    private collector: EvidenceCollector\n  ) {\n    this.setupInput();\n  }\n\n  registerRecipe(recipe: CombinationRecipe) {\n    this.recipes.push(recipe);\n  }\n\n  registerRecipes(recipes: CombinationRecipe[]) {\n    recipes.forEach((r) => this.registerRecipe(r));\n  }\n\n  open() {\n    this.isOpen = true;\n    this.slot1 = null;\n    this.slot2 = null;\n    this.dragging = null;\n    this.resultItem = null;\n    this.resultAlpha = 0;\n    this.animAlpha = 0;\n    this.failMessage = '';\n    this.failTimer = 0;\n  }\n\n  close() {\n    this.isOpen = false;\n    this.slot1 = null;\n    this.slot2 = null;\n    this.dragging = null;\n  }\n\n  toggle() {\n    if (this.isOpen) this.close();\n    else this.open();\n  }\n\n  getIsOpen(): boolean { return this.isOpen; }\n\n  private setupInput() {\n    this.input.onClick((e) => {\n      if (e.type !== 'up') return;\n      if (!this.isOpen) return;\n\n      if (this.dragging) {\n        this.handleDrop(e.x, e.y);\n        this.dragging = null;\n        return;\n      }\n\n      this.handleClick(e.x, e.y);\n    });\n  }\n\n  private handleClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    if (this.resultItem && this.resultTimer > 0) {\n      this.resultItem = null;\n      this.resultTimer = 0;\n      return;\n    }\n\n    const closeBtnX = w / 2 - 60;\n    const closeBtnY = h * 0.85;\n    if (this.isInRect(x, y, closeBtnX, closeBtnY, 120, 40)) {\n      this.close();\n      return;\n    }\n\n    const clearBtnX = w * 0.55;\n    const clearBtnY = h * 0.55;\n    if (this.isInRect(x, y, clearBtnX, clearBtnY, 100, 36)) {\n      this.slot1 = null;\n      this.slot2 = null;\n      this.resultItem = null;\n      return;\n    }\n\n    for (let i = 0; i < this.slotPositions.length; i++) {\n      const sp = this.slotPositions[i];\n      if (this.isInRect(x, y, sp.x, sp.y, sp.w, sp.h)) {\n        const slotVal = i === 0 ? this.slot1 : this.slot2;\n        if (slotVal) {\n          this.dragging = {\n            evidenceId: slotVal,\n            x, y,\n            originX: sp.x + sp.w / 2,\n            originY: sp.y + sp.h / 2,\n            slotIndex: i,\n          };\n          if (i === 0) this.slot1 = null;\n          else this.slot2 = null;\n        }\n        return;\n      }\n    }\n\n    const listX = w * 0.08;\n    const listY = h * 0.18;\n    const listW = w * 0.28;\n    const itemH = 42;\n\n    const items = this.collector.getCollectedEvidence();\n    for (let i = 0; i < items.length; i++) {\n      const iy = listY + i * itemH;\n      if (this.isInRect(x, y, listX, iy, listW, itemH - 4)) {\n        if (!this.slot1) {\n          this.slot1 = items[i].id;\n        } else if (!this.slot2 && items[i].id !== this.slot1) {\n          this.slot2 = items[i].id;\n          this.tryCombine();\n        }\n        return;\n      }\n    }\n  }\n\n  private handleDrop(x: number, y: number) {\n    if (!this.dragging) return;\n\n    for (let i = 0; i < this.slotPositions.length; i++) {\n      const sp = this.slotPositions[i];\n      if (this.isInRect(x, y, sp.x, sp.y, sp.w, sp.h)) {\n        const slotVal = i === 0 ? this.slot1 : this.slot2;\n        if (!slotVal) {\n          if (i === 0) this.slot1 = this.dragging.evidenceId;\n          else {\n            this.slot2 = this.dragging.evidenceId;\n            this.tryCombine();\n          }\n          return;\n        }\n      }\n    }\n\n    if (this.dragging.slotIndex === 0) this.slot1 = this.dragging.evidenceId;\n    else this.slot2 = this.dragging.evidenceId;\n  }\n\n  private tryCombine() {\n    if (!this.slot1 || !this.slot2) return;\n\n    const recipe = this.recipes.find((r) => {\n      const inputs = [...r.inputs].sort();\n      const given = [this.slot1!, this.slot2!].sort();\n      return inputs.length === given.length && inputs.every((v, i) => v === given[i]);\n    });\n\n    if (recipe) {\n      this.state.addEvidence(recipe.output);\n      this.collector.registerEvidence([{\n        id: recipe.output,\n        name: recipe.outputName,\n        description: recipe.outputDescription,\n        category: recipe.outputCategory,\n        discoveredAt: '组合',\n        discoveredTime: Date.now(),\n      }]);\n\n      this.resultItem = {\n        id: recipe.output,\n        name: recipe.outputName,\n        description: recipe.outputDescription,\n        category: recipe.outputCategory,\n        discoveredAt: '组合',\n        discoveredTime: Date.now(),\n      };\n      this.resultAlpha = 0;\n      this.resultTimer = 5;\n\n      this.slot1 = null;\n      this.slot2 = null;\n    } else {\n      this.failMessage = '这两件物证无法组合...';\n      this.failTimer = 2;\n    }\n  }\n\n  update(dt: number) {\n    if (!this.isOpen) return;\n    this.animAlpha = Math.min(1, this.animAlpha + dt * 5);\n\n    if (this.resultItem) {\n      this.resultAlpha = Math.min(1, this.resultAlpha + dt * 3);\n      this.resultTimer -= dt;\n    }\n    if (this.failTimer > 0) this.failTimer -= dt;\n  }\n\n  render() {\n    if (!this.isOpen) return;\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.save();\n    ctx.globalAlpha = this.animAlpha * 0.6;\n    ctx.fillStyle = '#0a0806';\n    ctx.fillRect(0, 0, w, h);\n    ctx.restore();\n\n    ctx.save();\n    ctx.globalAlpha = this.animAlpha;\n\n    this.renderer.drawText('物证组合', w / 2, h * 0.06, {\n      font: 'bold 28px \"SimSun\", \"Noto Serif SC\", serif',\n      color: '#c8a882', align: 'center',\n    });\n\n    this.renderEvidenceList(ctx, w, h);\n\n    this.slotPositions = this.renderCombineSlots(ctx, w, h);\n\n    if (this.slot1 && this.slot2) {\n      this.renderer.drawText('⚡', w * 0.55, h * 0.38, {\n        font: '28px sans-serif', color: '#c8a040', align: 'center',\n      });\n    }\n\n    const clearHover = this.isInRect(this.input.mouseX, this.input.mouseY, w * 0.55, h * 0.55, 100, 36);\n    this.renderer.drawRoundRect(w * 0.55, h * 0.55, 100, 36, 4,\n      clearHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('清空', w * 0.55 + 50, h * 0.55 + 8, {\n      font: '16px \"SimSun\", \"Noto Serif SC\", serif',\n      color: clearHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n\n    if (this.failTimer > 0) {\n      const fa = Math.min(1, this.failTimer);\n      ctx.save();\n      ctx.globalAlpha = fa;\n      this.renderer.drawText(this.failMessage, w * 0.55, h * 0.62, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a4a4a', align: 'center',\n      });\n      ctx.restore();\n    }\n\n    if (this.resultItem) {\n      this.renderResult(ctx, w, h);\n    }\n\n    const closeBtnX = w / 2 - 60;\n    const closeBtnY = h * 0.85;\n    const closeHover = this.isInRect(this.input.mouseX, this.input.mouseY, closeBtnX, closeBtnY, 120, 40);\n    this.renderer.drawRoundRect(closeBtnX, closeBtnY, 120, 40, 4,\n      closeHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('关闭', w / 2, closeBtnY + 10, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n      color: closeHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n\n    ctx.restore();\n  }\n\n  private renderEvidenceList(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    const listX = w * 0.08;\n    const listY = h * 0.18;\n    const listW = w * 0.28;\n    const listH = h * 0.62;\n\n    this.renderer.drawRoundRect(listX, listY - 30, listW, listH + 30, 6, '#1a140e', '#3a2a1a');\n    this.renderer.drawText('物证列表', listX + listW / 2, listY - 24, {\n      font: '16px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870', align: 'center',\n    });\n\n    const items = this.collector.getCollectedEvidence();\n    const itemH = 42;\n\n    ctx.save();\n    ctx.beginPath();\n    ctx.rect(listX + 4, listY + 4, listW - 8, listH - 38);\n    ctx.clip();\n\n    items.forEach((item, i) => {\n      const iy = listY + i * itemH;\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, listX + 4, iy, listW - 8, itemH - 4);\n      const inSlot = item.id === this.slot1 || item.id === this.slot2;\n\n      if (isHover && !inSlot) {\n        ctx.fillStyle = 'rgba(200, 168, 130, 0.1)';\n        ctx.fillRect(listX + 4, iy, listW - 8, itemH - 4);\n      }\n\n      this.renderer.drawText(\n        `${inSlot ? '▸ ' : '  '}${item.name}`,\n        listX + 14, iy + 8,\n        {\n          font: '16px \"SimSun\", \"Noto Serif SC\", serif',\n          color: inSlot ? '#5a4a3a' : isHover ? '#f0d8b0' : '#d8c8b0',\n        }\n      );\n    });\n\n    ctx.restore();\n\n    this.renderer.drawText('点击物证添加到组合槽', listX + listW / 2, listY + listH - 28, {\n      font: '13px sans-serif', color: '#4a3a2a', align: 'center',\n    });\n  }\n\n  private renderCombineSlots(ctx: CanvasRenderingContext2D, w: number, h: number): { x: number; y: number; w: number; h: number }[] {\n    const centerX = w * 0.55;\n    const slotW = 120;\n    const slotH = 80;\n    const gap = 40;\n    const slotY = h * 0.28;\n\n    const s1x = centerX - slotW - gap / 2;\n    const s2x = centerX + gap / 2;\n\n    const slots = [\n      { x: s1x, y: slotY, w: slotW, h: slotH },\n      { x: s2x, y: slotY, w: slotW, h: slotH },\n    ];\n\n    slots.forEach((sp, i) => {\n      const val = i === 0 ? this.slot1 : this.slot2;\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, sp.x, sp.y, sp.w, sp.h);\n\n      this.renderer.drawRoundRect(sp.x, sp.y, sp.w, sp.h, 6,\n        val ? '#1e1810' : isHover ? '#1a140e' : '#0e0a08',\n        val ? '#6a5040' : isHover ? '#5a4030' : '#2a1a0e'\n      );\n\n      if (val) {\n        const item = this.collector.getEvidenceById(val);\n        this.renderer.drawText(item?.name ?? val, sp.x + sp.w / 2, sp.y + sp.h / 2 - 10, {\n          font: '16px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2', align: 'center',\n        });\n        this.renderer.drawText('拖拽移除', sp.x + sp.w / 2, sp.y + sp.h - 22, {\n          font: '12px sans-serif', color: '#5a4a3a', align: 'center',\n        });\n      } else {\n        this.renderer.drawText('+', sp.x + sp.w / 2, sp.y + sp.h / 2 - 12, {\n          font: '32px sans-serif', color: '#3a2a1a', align: 'center',\n        });\n        this.renderer.drawText(i === 0 ? '物证 A' : '物证 B', sp.x + sp.w / 2, sp.y + sp.h - 22, {\n          font: '13px sans-serif', color: '#3a2a1a', align: 'center',\n        });\n      }\n    });\n\n    this.renderer.drawText('+', centerX, slotY + slotH / 2 - 12, {\n      font: 'bold 28px sans-serif', color: '#5a4030', align: 'center',\n    });\n\n    return slots;\n  }\n\n  private renderResult(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    if (!this.resultItem) return;\n\n    const rx = w * 0.55 - 120;\n    const ry = h * 0.65;\n    const rw = 240;\n    const rh = 90;\n\n    ctx.save();\n    ctx.globalAlpha = this.resultAlpha;\n\n    const glow = ctx.createRadialGradient(rx + rw / 2, ry + rh / 2, 0, rx + rw / 2, ry + rh / 2, rw);\n    glow.addColorStop(0, 'rgba(200, 168, 80, 0.15)');\n    glow.addColorStop(1, 'transparent');\n    ctx.fillStyle = glow;\n    ctx.fillRect(rx - 60, ry - 30, rw + 120, rh + 60);\n\n    this.renderer.drawRoundRect(rx, ry, rw, rh, 8, '#2a1a0e', '#8b4513');\n    ctx.strokeStyle = '#c8a040';\n    ctx.lineWidth = 2;\n    ctx.strokeRect(rx + 3, ry + 3, rw - 6, rh - 6);\n\n    this.renderer.drawText('组合成功！', rx + rw / 2, ry + 12, {\n      font: 'bold 18px \"SimSun\", \"Noto Serif SC\", serif', color: '#f0d8a0', align: 'center',\n    });\n    this.renderer.drawText(this.resultItem.name, rx + rw / 2, ry + 38, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2', align: 'center',\n    });\n    this.renderer.drawText(this.resultItem.description, rx + rw / 2, ry + 62, {\n      font: '14px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870', align: 'center',\n    });\n\n    ctx.restore();\n  }\n\n  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"bb710ec1-068d-4a4a-9438-6a706a63a8a0","uuid":"f7706458-18c9-4ee4-a6e2-45783fcef0f4"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_38afe0bdbee34b9b8c33318a","type":"tool_result","content":"File created successfully at: D:\\game-projects\\steam-ancient-mystery\\src\\game\\EvidenceCombiner.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"bb710ec1-068d-4a4a-9438-6a706a63a8a0","uuid":"d9d343c9-5d4f-4fad-9073-159a907aae9b","timestamp":"2026-05-23T15:38:32.402Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\steam-ancient-mystery\\src\\game\\EvidenceCombiner.ts","content":"import { Renderer } from '../renderer/Renderer';\nimport { GameState } from './GameState';\nimport { InputManager } from './InputManager';\nimport { EvidenceCollector, EvidenceItem } from './EvidenceCollector';\n\nexport interface CombinationRecipe {\n  id: string;\n  inputs: string[];\n  output: string;\n  outputName: string;\n  outputDescription: string;\n  outputCategory: 'key' | 'normal' | 'misleading';\n}\n\ninterface DragItem {\n  evidenceId: string;\n  x: number;\n  y: number;\n  originX: number;\n  originY: number;\n  slotIndex: number;\n}\n\nexport class EvidenceCombiner {\n  private recipes: CombinationRecipe[] = [];\n  private isOpen = false;\n  private animAlpha = 0;\n\n  private slot1: string | null = null;\n  private slot2: string | null = null;\n  private dragging: DragItem | null = null;\n\n  private resultItem: EvidenceItem | null = null;\n  private resultAlpha = 0;\n  private resultTimer = 0;\n\n  private failMessage = '';\n  private failTimer = 0;\n\n  private slotPositions: { x: number; y: number; w: number; h: number }[] = [];\n\n  constructor(\n    private renderer: Renderer,\n    private state: GameState,\n    private input: InputManager,\n    private collector: EvidenceCollector\n  ) {\n    this.setupInput();\n  }\n\n  registerRecipe(recipe: CombinationRecipe) {\n    this.recipes.push(recipe);\n  }\n\n  registerRecipes(recipes: CombinationRecipe[]) {\n    recipes.forEach((r) => this.registerRecipe(r));\n  }\n\n  open() {\n    this.isOpen = true;\n    this.slot1 = null;\n    this.slot2 = null;\n    this.dragging = null;\n    this.resultItem = null;\n    this.resultAlpha = 0;\n    this.animAlpha = 0;\n    this.failMessage = '';\n    this.failTimer = 0;\n  }\n\n  close() {\n    this.isOpen = false;\n    this.slot1 = null;\n    this.slot2 = null;\n    this.dragging = null;\n  }\n\n  toggle() {\n    if (this.isOpen) this.close();\n    else this.open();\n  }\n\n  getIsOpen(): boolean { return this.isOpen; }\n\n  private setupInput() {\n    this.input.onClick((e) => {\n      if (e.type !== 'up') return;\n      if (!this.isOpen) return;\n\n      if (this.dragging) {\n        this.handleDrop(e.x, e.y);\n        this.dragging = null;\n        return;\n      }\n\n      this.handleClick(e.x, e.y);\n    });\n  }\n\n  private handleClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    if (this.resultItem && this.resultTimer > 0) {\n      this.resultItem = null;\n      this.resultTimer = 0;\n      return;\n    }\n\n    const closeBtnX = w / 2 - 60;\n    const closeBtnY = h * 0.85;\n    if (this.isInRect(x, y, closeBtnX, closeBtnY, 120, 40)) {\n      this.close();\n      return;\n    }\n\n    const clearBtnX = w * 0.55;\n    const clearBtnY = h * 0.55;\n    if (this.isInRect(x, y, clearBtnX, clearBtnY, 100, 36)) {\n      this.slot1 = null;\n      this.slot2 = null;\n      this.resultItem = null;\n      return;\n    }\n\n    for (let i = 0; i < this.slotPositions.length; i++) {\n      const sp = this.slotPositions[i];\n      if (this.isInRect(x, y, sp.x, sp.y, sp.w, sp.h)) {\n        const slotVal = i === 0 ? this.slot1 : this.slot2;\n        if (slotVal) {\n          this.dragging = {\n            evidenceId: slotVal,\n            x, y,\n            originX: sp.x + sp.w / 2,\n            originY: sp.y + sp.h / 2,\n            slotIndex: i,\n          };\n          if (i === 0) this.slot1 = null;\n          else this.slot2 = null;\n        }\n        return;\n      }\n    }\n\n    const listX = w * 0.08;\n    const listY = h * 0.18;\n    const listW = w * 0.28;\n    const itemH = 42;\n\n    const items = this.collector.getCollectedEvidence();\n    for (let i = 0; i < items.length; i++) {\n      const iy = listY + i * itemH;\n      if (this.isInRect(x, y, listX, iy, listW, itemH - 4)) {\n        if (!this.slot1) {\n          this.slot1 = items[i].id;\n        } else if (!this.slot2 && items[i].id !== this.slot1) {\n          this.slot2 = items[i].id;\n          this.tryCombine();\n        }\n        return;\n      }\n    }\n  }\n\n  private handleDrop(x: number, y: number) {\n    if (!this.dragging) return;\n\n    for (let i = 0; i < this.slotPositions.length; i++) {\n      const sp = this.slotPositions[i];\n      if (this.isInRect(x, y, sp.x, sp.y, sp.w, sp.h)) {\n        const slotVal = i === 0 ? this.slot1 : this.slot2;\n        if (!slotVal) {\n          if (i === 0) this.slot1 = this.dragging.evidenceId;\n          else {\n            this.slot2 = this.dragging.evidenceId;\n            this.tryCombine();\n          }\n          return;\n        }\n      }\n    }\n\n    if (this.dragging.slotIndex === 0) this.slot1 = this.dragging.evidenceId;\n    else this.slot2 = this.dragging.evidenceId;\n  }\n\n  private tryCombine() {\n    if (!this.slot1 || !this.slot2) return;\n\n    const recipe = this.recipes.find((r) => {\n      const inputs = [...r.inputs].sort();\n      const given = [this.slot1!, this.slot2!].sort();\n      return inputs.length === given.length && inputs.every((v, i) => v === given[i]);\n    });\n\n    if (recipe) {\n      this.state.addEvidence(recipe.output);\n      this.collector.registerEvidence([{\n        id: recipe.output,\n        name: recipe.outputName,\n        description: recipe.outputDescription,\n        category: recipe.outputCategory,\n        discoveredAt: '组合',\n        discoveredTime: Date.now(),\n      }]);\n\n      this.resultItem = {\n        id: recipe.output,\n        name: recipe.outputName,\n        description: recipe.outputDescription,\n        category: recipe.outputCategory,\n        discoveredAt: '组合',\n        discoveredTime: Date.now(),\n      };\n      this.resultAlpha = 0;\n      this.resultTimer = 5;\n\n      this.slot1 = null;\n      this.slot2 = null;\n    } else {\n      this.failMessage = '这两件物证无法组合...';\n      this.failTimer = 2;\n    }\n  }\n\n  update(dt: number) {\n    if (!this.isOpen) return;\n    this.animAlpha = Math.min(1, this.animAlpha + dt * 5);\n\n    if (this.resultItem) {\n      this.resultAlpha = Math.min(1, this.resultAlpha + dt * 3);\n      this.resultTimer -= dt;\n    }\n    if (this.failTimer > 0) this.failTimer -= dt;\n  }\n\n  render() {\n    if (!this.isOpen) return;\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    ctx.save();\n    ctx.globalAlpha = this.animAlpha * 0.6;\n    ctx.fillStyle = '#0a0806';\n    ctx.fillRect(0, 0, w, h);\n    ctx.restore();\n\n    ctx.save();\n    ctx.globalAlpha = this.animAlpha;\n\n    this.renderer.drawText('物证组合', w / 2, h * 0.06, {\n      font: 'bold 28px \"SimSun\", \"Noto Serif SC\", serif',\n      color: '#c8a882', align: 'center',\n    });\n\n    this.renderEvidenceList(ctx, w, h);\n\n    this.slotPositions = this.renderCombineSlots(ctx, w, h);\n\n    if (this.slot1 && this.slot2) {\n      this.renderer.drawText('⚡', w * 0.55, h * 0.38, {\n        font: '28px sans-serif', color: '#c8a040', align: 'center',\n      });\n    }\n\n    const clearHover = this.isInRect(this.input.mouseX, this.input.mouseY, w * 0.55, h * 0.55, 100, 36);\n    this.renderer.drawRoundRect(w * 0.55, h * 0.55, 100, 36, 4,\n      clearHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('清空', w * 0.55 + 50, h * 0.55 + 8, {\n      font: '16px \"SimSun\", \"Noto Serif SC\", serif',\n      color: clearHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n\n    if (this.failTimer > 0) {\n      const fa = Math.min(1, this.failTimer);\n      ctx.save();\n      ctx.globalAlpha = fa;\n      this.renderer.drawText(this.failMessage, w * 0.55, h * 0.62, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a4a4a', align: 'center',\n      });\n      ctx.restore();\n    }\n\n    if (this.resultItem) {\n      this.renderResult(ctx, w, h);\n    }\n\n    const closeBtnX = w / 2 - 60;\n    const closeBtnY = h * 0.85;\n    const closeHover = this.isInRect(this.input.mouseX, this.input.mouseY, closeBtnX, closeBtnY, 120, 40);\n    this.renderer.drawRoundRect(closeBtnX, closeBtnY, 120, 40, 4,\n      closeHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('关闭', w / 2, closeBtnY + 10, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n      color: closeHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n\n    ctx.restore();\n  }\n\n  private renderEvidenceList(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    const listX = w * 0.08;\n    const listY = h * 0.18;\n    const listW = w * 0.28;\n    const listH = h * 0.62;\n\n    this.renderer.drawRoundRect(listX, listY - 30, listW, listH + 30, 6, '#1a140e', '#3a2a1a');\n    this.renderer.drawText('物证列表', listX + listW / 2, listY - 24, {\n      font: '16px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870', align: 'center',\n    });\n\n    const items = this.collector.getCollectedEvidence();\n    const itemH = 42;\n\n    ctx.save();\n    ctx.beginPath();\n    ctx.rect(listX + 4, listY + 4, listW - 8, listH - 38);\n    ctx.clip();\n\n    items.forEach((item, i) => {\n      const iy = listY + i * itemH;\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, listX + 4, iy, listW - 8, itemH - 4);\n      const inSlot = item.id === this.slot1 || item.id === this.slot2;\n\n      if (isHover && !inSlot) {\n        ctx.fillStyle = 'rgba(200, 168, 130, 0.1)';\n        ctx.fillRect(listX + 4, iy, listW - 8, itemH - 4);\n      }\n\n      this.renderer.drawText(\n        `${inSlot ? '▸ ' : '  '}${item.name}`,\n        listX + 14, iy + 8,\n        {\n          font: '16px \"SimSun\", \"Noto Serif SC\", serif',\n          color: inSlot ? '#5a4a3a' : isHover ? '#f0d8b0' : '#d8c8b0',\n        }\n      );\n    });\n\n    ctx.restore();\n\n    this.renderer.drawText('点击物证添加到组合槽', listX + listW / 2, listY + listH - 28, {\n      font: '13px sans-serif', color: '#4a3a2a', align: 'center',\n    });\n  }\n\n  private renderCombineSlots(ctx: CanvasRenderingContext2D, w: number, h: number): { x: number; y: number; w: number; h: number }[] {\n    const centerX = w * 0.55;\n    const slotW = 120;\n    const slotH = 80;\n    const gap = 40;\n    const slotY = h * 0.28;\n\n    const s1x = centerX - slotW - gap / 2;\n    const s2x = centerX + gap / 2;\n\n    const slots = [\n      { x: s1x, y: slotY, w: slotW, h: slotH },\n      { x: s2x, y: slotY, w: slotW, h: slotH },\n    ];\n\n    slots.forEach((sp, i) => {\n      const val = i === 0 ? this.slot1 : this.slot2;\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, sp.x, sp.y, sp.w, sp.h);\n\n      this.renderer.drawRoundRect(sp.x, sp.y, sp.w, sp.h, 6,\n        val ? '#1e1810' : isHover ? '#1a140e' : '#0e0a08',\n        val ? '#6a5040' : isHover ? '#5a4030' : '#2a1a0e'\n      );\n\n      if (val) {\n        const item = this.collector.getEvidenceById(val);\n        this.renderer.drawText(item?.name ?? val, sp.x + sp.w / 2, sp.y + sp.h / 2 - 10, {\n          font: '16px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2', align: 'center',\n        });\n        this.renderer.drawText('拖拽移除', sp.x + sp.w / 2, sp.y + sp.h - 22, {\n          font: '12px sans-serif', color: '#5a4a3a', align: 'center',\n        });\n      } else {\n        this.renderer.drawText('+', sp.x + sp.w / 2, sp.y + sp.h / 2 - 12, {\n          font: '32px sans-serif', color: '#3a2a1a', align: 'center',\n        });\n        this.renderer.drawText(i === 0 ? '物证 A' : '物证 B', sp.x + sp.w / 2, sp.y + sp.h - 22, {\n          font: '13px sans-serif', color: '#3a2a1a', align: 'center',\n        });\n      }\n    });\n\n    this.renderer.drawText('+', centerX, slotY + slotH / 2 - 12, {\n      font: 'bold 28px sans-serif', color: '#5a4030', align: 'center',\n    });\n\n    return slots;\n  }\n\n  private renderResult(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    if (!this.resultItem) return;\n\n    const rx = w * 0.55 - 120;\n    const ry = h * 0.65;\n    const rw = 240;\n    const rh = 90;\n\n    ctx.save();\n    ctx.globalAlpha = this.resultAlpha;\n\n    const glow = ctx.createRadialGradient(rx + rw / 2, ry + rh / 2, 0, rx + rw / 2, ry + rh / 2, rw);\n    glow.addColorStop(0, 'rgba(200, 168, 80, 0.15)');\n    glow.addColorStop(1, 'transparent');\n    ctx.fillStyle = glow;\n    ctx.fillRect(rx - 60, ry - 30, rw + 120, rh + 60);\n\n    this.renderer.drawRoundRect(rx, ry, rw, rh, 8, '#2a1a0e', '#8b4513');\n    ctx.strokeStyle = '#c8a040';\n    ctx.lineWidth = 2;\n    ctx.strokeRect(rx + 3, ry + 3, rw - 6, rh - 6);\n\n    this.renderer.drawText('组合成功！', rx + rw / 2, ry + 12, {\n      font: 'bold 18px \"SimSun\", \"Noto Serif SC\", serif', color: '#f0d8a0', align: 'center',\n    });\n    this.renderer.drawText(this.resultItem.name, rx + rw / 2, ry + 38, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2', align: 'center',\n    });\n    this.renderer.drawText(this.resultItem.description, rx + rw / 2, ry + 62, {\n      font: '14px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870', align: 'center',\n    });\n\n    ctx.restore();\n  }\n\n  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
