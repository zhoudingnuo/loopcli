ao/console_screenshot.png');\n\n  // Check if we're logged in or redirected to login page\n  const pageContent = await page.content();\n  if (pageContent.includes('登录') && !url.includes('version')) {\n    console.log('ERROR: Not logged in, redirected to login page');\n    await browser.close();\n    return;\n  }\n\n  // Look for upload button or file input\n  console.log('Looking for upload elements...');\n\n  // Try to find any buttons or links related to upload\n  const buttons = await page.$$eval('button, [role=\"button\"], a', els =>\n    els.map(e => ({ text: e.textContent?.trim()?.substring(0, 50), tag: e.tagName, href: e.href || '' }))\n  );\n  console.log('Found buttons/links:', JSON.stringify(buttons.slice(0, 30), null, 2));\n\n  // Check page text content for clues\n  const bodyText = await page.$eval('body', el => el.textContent?.substring(0, 2000));\n  console.log('Page body text:', bodyText);\n\n  await browser.close();\n}\n\nmain().catch(err => {\n  console.error('Error:', err.message);\n  process.exit(1);\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
