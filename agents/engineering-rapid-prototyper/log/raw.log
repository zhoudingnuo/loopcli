choice)) return this.advance();\n53\t    }\n54\t\n55\t    this.applyEffects(node);\n56\t    this.displayText = node.text;\n57\t    this.charIndex = 0;\n58\t    this.isTyping = true;\n59\t    return true;\n60\t  }\n61\t\n62\t  private applyEffects(node: DialogueNode) {\n63\t    node.setFlags?.forEach((f) => this.state.setFlag(f, true));\n64\t    node.addEvidence?.forEach((e) => this.state.addEvidence(e));\n65\t    if (node.setChoice) this.state.setChoice(node.setChoice.key, node.setChoice.value);\n66\t    if (node.effects?.relationship) {\n67\t      const r = node.effects.relationship;\n68\t      this.state.setRelationship(r.npc, r.delta);\n69\t    }\n70\t  }\n71\t\n72\t  advance(): boolean {\n73\t    if (!this.currentNode) return false;\n74\t    if (this.isTyping) {\n75\t      this.charIndex = this.displayText.length;\n76\t      this.isTyping = false;\n77\t      return true;\n78\t    }\n79\t    if (this.currentNode.choices && this.currentNode.choices.length > 0) return false;\n80\t    if (this.currentNode.next) return this.start(this.currentNode.next, this.onEndCallback ?? undefined);\n81\t    this.isActive = false;\n82\t    this.currentNode = null;\n83\t    this.onEndCallback?.();\n84\t    return false;\n85\t  }\n86\t\n87\t  selectChoice(index: number): boolean {\n88\t    if (!this.currentNode?.choices) return false;\n89\t    const choice = this.currentNode.choices[index];\n90\t    if (!choice) return false;\n91\t    if (choice.condition) {\n92\t      if (choice.condition.flag && !this.state.getFlag(choice.condition.flag)) return false;\n93\t      if (choice.condition.evidence && !this.state.hasEvidence(choice.condition.evidence)) return false;\n94\t    }\n95\t    return this.start(choice.next, this.onEndCallback ?? undefined);\n96\t  }\n97\t\n98\t  update(dt: number) {\n99\t    if (!this.isTyping || !this.currentNode) return;\n100\t    this.charIndex += this.charsPerSecond * dt;\n101\t    if (this.charIndex >= this.displayText.length) {\n102\t      this.charIndex = this.displayText.length;\n103\t      this.isTyping = false;\n104\t    }\n105\t  }\n106\t\n107\t  getDisplayText(): string { return this.displayText.substring(0, Math.floor(this.charIndex)); }\n108\t  getSpeaker(): string | undefined { return this.currentNode?.speaker; }\n109\t  getPortrait(): string | undefined { return this.currentNode?.portrait; }\n110\t  getChoices(): DialogueChoice[] {\n111\t    return this.currentNode?.choices?.filter((c) => {\n112\t      if (!c.condition) return true;\n113\t      if (c.condition.flag && !this.state.getFlag(c.condition.flag)) return false;\n114\t      if (c.condition.evidence && !this.state.hasEvidence(c.condition.evidence)) return false;\n115\t      return true;\n116\t    }) ?? [];\n117\t  }\n118\t  getIsActive(): boolean { return this.isActive; }\n119\t  getIsTyping(): boolean { return this.isTyping; }\n120\t\n121\t  setSpeed(charsPerSec: number) { this.charsPerSecond = charsPerSec; }\n122\t}\n123\t"}]},"parent_tool_use_id":null,"session_id":"bb710ec1-068d-4a4a-9438-6a706a63a8a0","uuid":"ff907167-43be-4590-9658-ff3001bd8af4","timestamp":"2026-05-23T15:33:35.675Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-ancient-mystery\\src\\game\\DialogueEngine.ts","content":"import { GameState } from './GameState';\n\nexport interface DialogueNode {\n  id: string;\n  speaker?: string;\n  text: string;\n  portrait?: string;\n  next?: string;\n  choices?: DialogueChoice[];\n  condition?: { flag?: string; evidence?: string; choice?: string };\n  setFlags?: string[];\n  addEvidence?: string[];\n  setChoice?: { key: string; value: string };\n  effects?: { relationship?: { npc: string; delta: number } };\n}\n\nexport interface DialogueChoice {\n  text: string;\n  next: string;\n  condition?: { flag?: string; evidence?: string };\n}\n\nexport class DialogueEngine {\n  private nodes: Map<string, DialogueNode> = new Map();\n  private currentNode: DialogueNode | null = null;\n  private displayText = '';\n  private charIndex = 0;\n  private charsPerSecond = 40;\n  private isTyping = false;\n  private isActive = false;\n  private onEndCallback: (() => void) | null = null;\n\n  constructor(private state: GameState) {\n    this.charsPerSecond = state.settings.textSpeed;\n  }\n\n  loadDialogue(nodes: DialogueNode[]) {\n    this.nodes.clear();\n    nodes.forEach((n) => this.nodes.set(n.id, n));\n  }\n\n  start(nodeId: string, onEnd?: () => void): boolean {\n    const node = this.nodes.get(nodeId);\n    if (!node) return false;\n    this.currentNode = node;\n    this.isActive = true;\n    this.onEndCallback = onEnd ?? null;\n\n    if (node.condition) {\n      if (node.condition.flag && !this.state.getFlag(node.condition.flag)) return this.advance();\n      if (node.condition.evidence && !this.state.hasEvidence(node.condition.evidence)) return this.advance();\n      if (node.condition.choice && !this.state.getChoice(node.condition.choice)) return this.advance();\n    }\n\n    this.applyEffects(node);\n    this.displayText = node.text;\n    this.charIndex = 0;\n    this.isTyping = true;\n    return true;\n  }\n\n  private applyEffects(node: DialogueNode) {\n    node.setFlags?.forEach((f) => this.state.setFlag(f, true));\n    node.addEvidence?.forEach((e) => this.state.addEvidence(e));\n    if (node.setChoice) this.state.setChoice(node.setChoice.key, node.setChoice.value);\n    if (node.effects?.relationship) {\n      const r = node.effects.relationship;\n      this.state.setRelationship(r.npc, r.delta);\n    }\n  }\n\n  advance(): boolean {\n    if (!this.currentNode) return false;\n    if (this.isTyping) {\n      this.charIndex = this.displayText.length;\n      this.isTyping = false;\n      return true;\n    }\n    if (this.currentNode.choices && this.currentNode.choices.length > 0) return false;\n    if (this.currentNode.next) return this.start(this.currentNode.next, this.onEndCallback ?? undefined);\n    this.isActive = false;\n    this.currentNode = null;\n    this.onEndCallback?.();\n    return false;\n  }\n\n  selectChoice(index: number): boolean {\n    if (!this.currentNode?.choices) return false;\n    const choice = this.currentNode.choices[index];\n    if (!choice) return false;\n    if (choice.condition) {\n      if (choice.condition.flag && !this.state.getFlag(choice.condition.flag)) return false;\n      if (choice.condition.evidence && !this.state.hasEvidence(choice.condition.evidence)) return false;\n    }\n    return this.start(choice.next, this.onEndCallback ?? undefined);\n  }\n\n  update(dt: number) {\n    if (!this.isTyping || !this.currentNode) return;\n    this.charIndex += this.charsPerSecond * dt;\n    if (this.charIndex >= this.displayText.length) {\n      this.charIndex = this.displayText.length;\n      this.isTyping = false;\n    }\n  }\n\n  getDisplayText(): string { return this.displayText.substring(0, Math.floor(this.charIndex)); }\n  getSpeaker(): string | undefined { return this.currentNode?.speaker; }\n  getPortrait(): string | undefined { return this.currentNode?.portrait; }\n  getChoices(): DialogueChoice[] {\n    return this.currentNode?.choices?.filter((c) => {\n      if (!c.condition) return true;\n      if (c.condition.flag && !this.state.getFlag(c.condition.flag)) return false;\n      if (c.condition.evidence && !this.state.hasEvidence(c.condition.evidence)) return false;\n      return true;\n    }) ?? [];\n  }\n  getIsActive(): boolean { return this.isActive; }\n  getIsTyping(): boolean { return this.isTyping; }\n\n  setSpeed(charsPerSec: number) { this.charsPerSecond = charsPerSec; }\n}\n","numLines":123,"startLine":1,"totalLines":123}}}
