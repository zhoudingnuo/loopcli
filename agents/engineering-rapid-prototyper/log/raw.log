p(t));\n53\t  }\n54\t\n55\t  private loop(now: number) {\n56\t    if (!this.running) return;\n57\t    const dt = Math.min((now - this.lastTime) / 1000, 0.05);\n58\t    this.lastTime = now;\n59\t\n60\t    this.update(dt);\n61\t    this.render();\n62\t\n63\t    requestAnimationFrame((t) => this.loop(t));\n64\t  }\n65\t\n66\t  private update(dt: number) {\n67\t    this.sceneManager.update(dt);\n68\t    this.dialogueEngine.update(dt);\n69\t    this.ui.update(dt);\n70\t  }\n71\t\n72\t  private render() {\n73\t    this.renderer.clear();\n74\t    this.sceneManager.render();\n75\t    this.ui.render();\n76\t  }\n77\t}\n78\t"}]},"parent_tool_use_id":null,"session_id":"bb710ec1-068d-4a4a-9438-6a706a63a8a0","uuid":"2dae921b-5638-4e24-8f91-45a86430d5f9","timestamp":"2026-05-23T15:33:49.365Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-ancient-mystery\\src\\renderer\\App.ts","content":"import { Renderer } from './Renderer';\nimport { SceneManager } from '../game/SceneManager';\nimport { GameState } from '../game/GameState';\nimport { DialogueEngine } from '../game/DialogueEngine';\nimport { UIManager } from './UI/UIManager';\nimport { InputManager } from '../game/InputManager';\n\nexport class App {\n  private renderer: Renderer;\n  private sceneManager: SceneManager;\n  private gameState: GameState;\n  private dialogueEngine: DialogueEngine;\n  private ui: UIManager;\n  private input: InputManager;\n  private lastTime = 0;\n  private running = false;\n\n  constructor(private canvas: HTMLCanvasElement) {\n    const ctx = canvas.getContext('2d')!;\n    this.renderer = new Renderer(ctx, canvas);\n    this.gameState = new GameState();\n    this.sceneManager = new SceneManager(this.renderer, this.gameState);\n    this.dialogueEngine = new DialogueEngine(this.gameState);\n    this.input = new InputManager(canvas);\n    this.ui = new UIManager(\n      this.renderer,\n      this.sceneManager,\n      this.dialogueEngine,\n      this.gameState,\n      this.input\n    );\n\n    this.resize();\n    window.addEventListener('resize', () => this.resize());\n  }\n\n  private resize() {\n    const dpr = window.devicePixelRatio || 1;\n    const w = window.innerWidth;\n    const h = window.innerHeight;\n    this.canvas.width = w * dpr;\n    this.canvas.height = h * dpr;\n    this.canvas.style.width = w + 'px';\n    this.canvas.style.height = h + 'px';\n    this.renderer.setSize(w, h, dpr);\n    this.ui.resize(w, h);\n  }\n\n  start() {\n    this.running = true;\n    this.lastTime = performance.now();\n    requestAnimationFrame((t) => this.loop(t));\n  }\n\n  private loop(now: number) {\n    if (!this.running) return;\n    const dt = Math.min((now - this.lastTime) / 1000, 0.05);\n    this.lastTime = now;\n\n    this.update(dt);\n    this.render();\n\n    requestAnimationFrame((t) => this.loop(t));\n  }\n\n  private update(dt: number) {\n    this.sceneManager.update(dt);\n    this.dialogueEngine.update(dt);\n    this.ui.update(dt);\n  }\n\n  private render() {\n    this.renderer.clear();\n    this.sceneManager.render();\n    this.ui.render();\n  }\n}\n","numLines":78,"startLine":1,"totalLines":78}}}
