 Renderer.prototype.drawBackground = function() { this.ctx.fillStyle=config.BG_COLOR; this.ctx.fillRect(0,0,this.canvas.width,this.canvas.height); };\n393\t\n394\t  Renderer.prototype.drawBoard = function() {\n395\t    var ctx=this.ctx, l=this.layout;\n396\t    ctx.fillStyle=config.BOARD_BG;\n397\t    this._roundRect(l.x-config.BOARD_PADDING,l.y-config.BOARD_PADDING,l.width+config.BOARD_PADDING*2,l.height+config.BOARD_PADDING*2,config.BOARD_BORDER_RADIUS);\n398\t    ctx.fill();\n399\t    for(var r=0;r<config.GRID_SIZE;r++){for(var c=0;c<config.GRID_SIZE;c++){\n400\t      var cx=l.x+c*(l.cellSize+config.CELL_GAP), cy=l.y+r*(l.cellSize+config.CELL_GAP);\n401\t      ctx.fillStyle=config.CELL_BG; this._roundRect(cx,cy,l.cellSize,l.cellSize,6); ctx.fill();\n402\t    }}\n403\t  };\n404\t\n405\t  Renderer.prototype.drawPieces = function(board) {\n406\t    var ctx=this.ctx, l=this.layout;\n407\t    for(var r=0;r<config.GRID_SIZE;r++){for(var c=0;c<config.GRID_SIZE;c++){\n408\t      var type=board.getPiece(r,c); if(type<0)continue;\n409\t      var px=l.x+c*(l.cellSize+config.CELL_GAP)+l.cellSize/2;\n410\t      var py=l.y+r*(l.cellSize+config.CELL_GAP)+l.cellSize/2;\n411\t      var key=r+','+c, off=this.pieceOffset[key];\n412\t      if(off){px+=off.dx;py+=off.dy}\n413\t      var scale=this.pieceScale[key]||1, radius=(l.cellSize/2-4)*scale;\n414\t      if(radius<=0)continue;\n415\t      this._drawPiece(ctx,px,py,radius,type);\n416\t      if(this.selectedCell&&this.selectedCell.r===r&&this.selectedCell.c===c){\n417\t        ctx.strokeStyle=config.SELECTED_COLOR;ctx.lineWidth=3;ctx.beginPath();ctx.arc(px,py,radius+2,0,Math.PI*2);ctx.stroke();\n418\t        var pulse=0.5+0.5*Math.sin(Date.now()/150);\n419\t        ctx.strokeStyle='rgba(236,204,104,'+(pulse*0.5)+')';ctx.lineWidth=2;ctx.beginPath();ctx.arc(px,py,radius+5,0,Math.PI*2);ctx.stroke();\n420\t      }\n421\t    }}\n422\t  };\n423\t\n424\t  Renderer.prototype._drawPiece = function(ctx,px,py,radius,type) {\n425\t    var color=config.PIECE_COLORS[type], glow=config.PIECE_GLOW[type], shape=config.PIECE_SHAPES[type];\n426\t    ctx.fillStyle='rgba(0,0,0,0.2)';ctx.beginPath();ctx.arc(px+2,py+2,radius,0,Math.PI*2);ctx.fill();\n427\t    var grad=ctx.createRadialGradient(px-radius*0.3,py-radius*0.3,0,px,py,radius);\n428\t    grad.addColorStop(0,glow);grad.addColorStop(0.7,color);grad.addColorStop(1,this._darken(color,0.7));\n429\t    ctx.fillStyle=grad;ctx.beginPath();\n430\t    switch(shape){\n431\t      case 'circle':ctx.arc(px,py,radius,0,Math.PI*2);break;\n432\t      case 'diamond':ctx.moveTo(px,py-radius);ctx.lineTo(px+radius,py);ctx.lineTo(px,py+radius);ctx.lineTo(px-radius,py);break;\n433\t      case 'square':var s=radius*0.8;this._roundRect(px-s,py-s,s*2,s*2,4);break;\n434\t      case 'triangle':ctx.moveTo(px,py-radius);ctx.lineTo(px+radius*0.87,py+radius*0.5);ctx.lineTo(px-radius*0.87,py+radius*0.5);break;\n435\t      case 'star':this._drawStar(ctx,px,py,5,radius,radius*0.5);break;\n436\t      case 'hexagon':this._drawPolygon(ctx,px,py,radius,6);break;\n437\t    }\n438\t    ctx.fill();\n439\t    ctx.fillStyle='rgba(255,255,255,0.3)';ctx.beginPath();ctx.ellipse(px-radius*0.2,py-radius*0.3,radius*0.4,radius*0.25,-0.3,0,Math.PI*2);ctx.fill();\n440\t  };\n441\t\n442\t  Renderer.prototype._drawStar = function(ctx,cx,cy,pts,oR,iR){ctx.beginPath();for(var i=0;i<pts*2;i++){var r=i%2===0?oR:iR,a=(Math.PI/pts)*i-Math.PI/2,x=cx+Math.cos(a)*r,y=cy+Math.sin(a)*r;if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y)}ctx.closePath()};\n443\t  Renderer.prototype._drawPolygon = function(ctx,cx,cy,r,sides){ctx.beginPath();for(var i=0;i<sides;i++){var a=(Math.PI*2/sides)*i-Math.PI/2,x=cx+Math.cos(a)*r,y=cy+Math.sin(a)*r;if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y)}ctx.closePath()};\n444\t\n445\t  Renderer.prototype.drawTopBar = function(score,level,movesLeft,target) {\n446\t    var ctx=this.ctx, cw=this.canvas.width, by=0, bh=this.layout.topBarHeight;\n447\t    var dpr=(adapter.getSystemInfo().pixelRatio||1);\n448\t    var w=cw/dpr;\n449\t    ctx.fillStyle='rgba(22,33,62,0.9)';ctx.fillRect(0,by,cw,bh);\n450\t    ctx.save(); ctx.setTransform(1,0,0,1,0,0); ctx.scale(dpr,dpr);\n451\t    ctx.fillStyle='#FFFFFF';ctx.font='bold 20px Arial';ctx.textAlign='left';ctx.fillText('分数',16,by/dpr+30);\n452\t    ctx.font='bold 28px Arial';ctx.fillStyle='#FFD700';ctx.fillText(score.toLocaleString(),16,by/dpr+62);\n453\t    ctx.fillStyle='#FFFFFF';ctx.font='bold 18px Arial';ctx.textAlign='center';ctx.fillText('第 '+level+' 关',w/2,by/dpr+30);\n454\t    var progW=w*0.5,progH=12,progX=(w-progW)/2,progY=by/dpr+42;\n455\t    ctx.fillStyle='rgba(255,255,255,0.15)';this._roundRect(progX,progY,progW,progH,6);ctx.fill();\n456\t    var prog=Math.min(score/target,1);\n457\t    if(prog>0){var pg=ctx.createLinearGradient(progX,0,progX+progW,0);pg.addColorStop(0,'#FFD700');pg.addColorStop(1,'#FF6348');ctx.fillStyle=pg;this._roundRect(progX,progY,progW*prog,progH,6);ctx.fill()}\n458\t    ctx.fillStyle='#FFFFFF';ctx.font='bold 18px Arial';ctx.textAlign='right';ctx.fillText('剩余步数',w-16,by/dpr+30);\n459\t    ctx.font='bold 28px Arial';ctx.fillStyle=movesLeft<=5?'#FF4757':'#2ED573';ctx.fillText(movesLeft.toString(),w-16,by/dpr+62);\n460\t    ctx.restore();\n461\t  };\n462\t\n463\t  Renderer.prototype.drawBottomBar = function() {\n464\t    var ctx=this.ctx,cw=this.canvas.width,dpr=(adapter.getSystemInfo().pixelRatio||1),w=cw/dpr;\n465\t    var barY=this.canvas.height/dpr-this.layout.bottomBarHeight;\n466\t    ctx.save();ctx.setTransform(1,0,0,1,0,0);ctx.scale(dpr,dpr);\n467\t    ctx.fillStyle='rgba(22,33,62,0.9)';ctx.fillRect(0,barY,w,this.layout.bottomBarHeight);\n468\t    var btnW=140,btnH=44,btnX=(w-btnW)/2,btnY=barY+(this.layout.bottomBarHeight-btnH)/2;\n469\t    ctx.fillStyle='#FF6348';this._roundRect(btnX,btnY,btnW,btnH,22);ctx.fill();\n470\t    ctx.fillStyle='#FFFFFF';ctx.font='bold 18px Arial';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('重新开始',w/2,btnY+btnH/2);ctx.textBaseline='alphabetic';\n471\t    ctx.restore();\n472\t    this._restartBtn={x:btnX,y:btnY,w:btnW,h:btnH};\n473\t  };\n474\t\n475\t  Renderer.prototype.drawGameOver = function(score,level,best) {\n476\t    var ctx=this.ctx,dpr=(adapter.getSystemInfo().pixelRatio||1),w=this.canvas.width/dpr,h=this.canvas.height/dpr;\n477\t    ctx.save();ctx.setTransform(1,0,0,1,0,0);ctx.scale(dpr,dpr);\n478\t    ctx.fillStyle='rgba(0,0,0,0.75)';ctx.fillRect(0,0,w,h);\n479\t    var cx=w/2,cy=h/2,pw=w*0.8,ph=320,px=cx-pw/2,py=cy-ph/2;\n480\t    ctx.fillStyle='#16213E';this._roundRect(px,py,pw,ph,20);ctx.fill();ctx.strokeStyle='#FFD700';ctx.lineWidth=2;this._roundRect(px,py,pw,ph,20);ctx.stroke();\n481\t    ctx.textAlign='center';ctx.fillStyle='#FFD700';ctx.font='bold 30px Arial';ctx.fillText('游戏结束',cx,py+50);\n482\t    ctx.fillStyle='#FFFFFF';ctx.font='20px Arial';ctx.fillText('得分: '+score.toLocaleString(),cx,py+100);\n483\t    ctx.fillStyle='#AAAAAA';ctx.font='18px Arial';ctx.fillText('第 '+level+' 关',cx,py+135);ctx.fillText('最高分: '+best.toLocaleString(),cx,py+165);\n484\t    var bw=160,bh=48,bx=cx-bw/2,by2=py+ph-80;\n485\t    ctx.fillStyle='#2ED573';this._roundRect(bx,by2,bw,bh,24);ctx.fill();ctx.fillStyle='#FFFFFF';ctx.font='bold 20px Arial';ctx.textBaseline='middle';ctx.fillText('再来一局',cx,by2+bh/2);ctx.textBaseline='alphabetic';\n486\t    ctx.restore();\n487\t    this._retryBtn={x:bx,y:by2,w:bw,h:bh};\n488\t  };\n489\t\n490\t  Renderer.prototype.drawLevelComplete = function(score,level,best) {\n491\t    var ctx=this.ctx,dpr=(adapter.getSystemInfo().pixelRatio||1),w=this.canvas.width/dpr,h=this.canvas.height/dpr;\n492\t    ctx.save();ctx.setTransform(1,0,0,1,0,0);ctx.scale(dpr,dpr);\n493\t    ctx.fillStyle='rgba(0,0,0,0.75)';ctx.fillRect(0,0,w,h);\n494\t    var cx=w/2,cy=h/2,pw=w*0.8,ph=320,px=cx-pw/2,py=cy-ph/2;\n495\t    ctx.fillStyle='#16213E';this._roundRect(px,py,pw,ph,20);ctx.fill();ctx.strokeStyle='#2ED573';ctx.lineWidth=2;this._roundRect(px,py,pw,ph,20);ctx.stroke();\n496\t    ctx.textAlign='center';ctx.fillStyle='#2ED573';ctx.font='bold 30px Arial';ctx.fillText('过关！',cx,py+50);\n497\t    ctx.fillStyle='#FFFFFF';ctx.font='20px Arial';ctx.fillText('得分: '+score.toLocaleString(),cx,py+100);\n498\t    ctx.fillStyle='#FFD700';ctx.font='bold 22px Arial';ctx.fillText('进入第 '+(level+1)+' 关',cx,py+145);\n499\t    ctx.fillStyle='#AAAAAA';ctx.font='18px Arial';ctx.fillText('最高分: '+best.toLocaleString(),cx,py+180);\n500\t    var bw=160,bh=48,bx=cx-bw/2,by2=py+ph-80;\n501\t    ctx.fillStyle='#FFD700';this._roundRect(bx,by2,bw,bh,24);ctx.fill();ctx.fillStyle='#1A1A2E';ctx.font='bold 20px Arial';ctx.textBaseline='middle';ctx.fillText('下一关',cx,by2+bh/2);ctx.textBaseline='alphabetic';\n502\t    ctx.restore();\n503\t    this._nextBtn={x:bx,y:by2,w:bw,h:bh};\n504\t  };\n505\t\n506\t  Renderer.prototype.addScorePopup = function(r,c,score) {\n507\t    var l=this.layout;this.scorePopups.push({x:l.x+c*(l.cellSize+config.CELL_GAP)+l.cellSize/2,y:l.y+r*(l.cellSize+config.CELL_GAP),text:'+'+score,life:1});\n508\t  };\n509\t  Renderer.prototype.setComboText = function(combo) { if(combo>1) this.comboText={text:combo+'x 连击！',life:1}; };\n510\t  Renderer.prototype.addParticles = function(r,c,type) {\n511\t    var l=this.layout,px=l.x+c*(l.cellSize+config.CELL_GAP)+l.cellSize/2,py=l.y+r*(l.cellSize+config.CELL_GAP)+l.cellSize/2,color=config.PIECE_COLORS[type]||'#FFF';\n512\t    for(var i=0;i<6;i++){var a=(Math.PI*2/6)*i+Math.random()*0.5;this.particles.push({x:px,y:py,vx:Math.cos(a)*(2+Math.random()*3),vy:Math.sin(a)*(2+Math.random()*3),life:1,color:color,size:3+Math.random()*3})}\n513\t  };\n514\t  Renderer.prototype.updateEffects = function(dt) {\n515\t    for(var i=this.particles.length-1;i>=0;i--){var p=this.particles[i];p.x+=p.vx;p.y+=p.vy;p.vy+=0.15;p.life-=dt*2;if(p.life<=0)this.particles.splice(i,1)}\n516\t    for(var i=this.scorePopups.length-1;i>=0;i--){var p=this.scorePopups[i];p.y-=1.5;p.life-=dt*1.5;if(p.life<=0)this.scorePopups.splice(i,1)}\n517\t    if(this.comboText){this.comboText.life-=dt;if(this.comboText.life<=0)this.comboText=null}\n518\t    if(this.screenShake>0)this.screenShake-=dt*10;\n519\t  };\n520\t  Renderer.prototype.drawEffects = function() {\n521\t    var ctx=this.ctx;\n522\t    if(this.screenShake>0){var s=this.screenShake*2;ctx.save();ctx.translate((Math.random()-0.5)*s,(Math.random()-0.5)*s)}\n523\t    for(var i=0;i<this.particles.length;i++){var p=this.particles[i];ctx.globalAlpha=p.life;ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(p.x,p.y,p.size*p.life,0,Math.PI*2);ctx.fill()}\n524\t    ctx.globalAlpha=1;\n525\t    for(var i=0;i<this.scorePopups.length;i++){var p=this.scorePopups[i];ctx.globalAlpha=p.life;ctx.fillStyle='#FFD700';ctx.font='bold 18px Arial';ctx.textAlign='center';ctx.fillText(p.text,p.x,p.y)}\n526\t    ctx.globalAlpha=1;\n527\t    if(this.comboText){ctx.globalAlpha=this.comboText.life;ctx.fillStyle='#FF6348';ctx.font='bold 32px Arial';ctx.textAlign='center';\n528\t    var dpr=(adapter.getSystemInfo().pixelRatio||1);\n529\t    ctx.fillText(this.comboText.text,this.canvas.width/dpr/2,this.layout.y-20)}\n530\t    ctx.globalAlpha=1;\n531\t    if(this.screenShake>0)ctx.restore();\n532\t  };\n533\t  Renderer.prototype.setPieceOffset=function(r,c,dx,dy){this.pieceOffset[r+','+c]={dx:dx,dy:dy}};\n534\t  Renderer.prototype.clearPieceOffset=function(r,c){delete this.pieceOffset[r+','+c]};\n535\t  Renderer.prototype.setPieceScale=function(r,c,s){this.pieceScale[r+','+c]=s};\n536\t  Renderer.prototype.clearPieceScale=function(r,c){delete this.pieceScale[r+','+c]};\n537\t  Renderer.prototype._roundRect=function(x,y,w,h,r){var ctx=this.ctx;ctx.beginPath();ctx.moveTo(x+r,y);ctx.lineTo(x+w-r,y);ctx.quadraticCurveTo(x+w,y,x+w,y+r);ctx.lineTo(x+w,y+h-r);ctx.quadraticCurveTo(x+w,y+h,x+w-r,y+h);ctx.lineTo(x+r,y+h);ctx.quadraticCurveTo(x,y+h,x,y+h-r);ctx.lineTo(x,y+r);ctx.quadraticCurveTo(x,y,x+r,y);ctx.closePath()};\n538\t  Renderer.prototype._darken=function(hex,f){var n=parseInt(hex.slice(1),16),r=Math.floor(((n>>16)&0xFF)*f),g=Math.floor(((n>>8)&0xFF)*f),b=Math.floor((n&0xFF)*f);return '#'+((1<<24)+(r<<16)+(g<<8)+b).toString(16).slice(1)};\n539\t\n540\t  module.exports = Renderer;\n541\t});\n542\t</script>\n543\t<script>\n544\t// === Main Game (inline, using the module system) ===\n545\t(function() {\n546\t  var adapter = require('./adapter/index');\n547\t  var config = require('./js/config');\n548\t  var utils = require('./js/utils');\n549\t  var Board = require('./js/board');\n550\t  var Renderer = require('./js/renderer');\n551\t  var InputHandler = require('./js/input');\n552\t  var AnimationManager = require('./js/animation');\n553\t  var ScoreManager = require('./js/score-manager');\n554\t\n555\t  var easeOutQuad = utils.easeOutQuad;\n556\t  var easeOutBounce = utils.easeOutBounce;\n557\t\n558\t  function calcLayout(sw, sh) {\n559\t    var topH=config.TOP_BAR_HEIGHT, botH=config.BOTTOM_BAR_HEIGHT;\n560\t    var availH=sh-topH-botH, availW=sw-32;\n561\t    var gap=config.CELL_GAP;\n562\t    var maxCW=(availW-gap*(config.GRID_SIZE-1))/config.GRID_SIZE;\n563\t    var maxCH=(availH-gap*(config.GRID_SIZE-1)-20)/config.GRID_SIZE;\n564\t    var cs=Math.floor(Math.min(maxCW,maxCH));\n565\t    var bw=cs*config.GRID_SIZE+gap*(config.GRID_SIZE-1);\n566\t    return {x:(sw-bw)/2, y:topH+(availH-bw)/2, width:bw, height:bw, cellSize:cs, topBarHeight:topH, bottomBarHeight:botH};\n567\t  }\n568\t\n569\t  function Game() {\n570\t    var si=adapter.getSystemInfo(), dpr=si.pixelRatio||1, sw=si.windowWidth, sh=si.windowHeight;\n571\t    this.canvas=document.querySelector('canvas')||document.createElement('canvas');\n572\t    this.canvas.width=sw*dpr; this.canvas.height=sh*dpr;\n573\t    this.canvas.style.width=sw+'px'; this.canvas.style.height=sh+'px';\n574\t    var ctx=this.canvas.getContext('2d'); ctx.scale(dpr,dpr);\n575\t    this.screenW=sw; this.screenH=sh; this.dpr=dpr;\n576\t    this.layout=calcLayout(sw,sh);\n577\t    this.board=new Board();\n578\t    this.renderer=new Renderer(this.canvas,this.layout);\n579\t    this.input=new InputHandler(this.layout);\n580\t    this.anim=new AnimationManager();\n581\t    this.score=new ScoreManager();\n582\t    this.state='idle';\n583\t    this._bindEvents();\n584\t    this._lastTime=Date.now();\n585\t    this._loop();\n586\t  }\n587\t\n588\t  Game.prototype._bindEvents = function() {\n589\t    var self=this;\n590\t    adapter.onTouchStart(function(e) {\n591\t      var t=e.touches?e.touches[0]:e, x=t.clientX||t.pageX, y=t.clientY||t.pageY;\n592\t      if(self.state==='gameover'||self.state==='levelcomplete'){self.input.handleClick(x,y);return}\n593\t      if(self.state!=='idle')return;\n594\t      self.input.handleTouchStart(x,y);\n595\t    });\n596\t    adapter.onTouchMove(function(e) {\n597\t      var t=e.touches?e.touches[0]:e, x=t.clientX||t.pageX, y=t.clientY||t.pageY;\n598\t      if(self.state!=='idle')return;\n599\t      self.input.handleTouchMove(x,y);\n600\t    });\n601\t    adapter.onTouchEnd(function(){self.input.handleTouchEnd()});\n602\t\n603\t    this.input.onSelect=function(cell){self.renderer.selectedCell=cell;if(cell)adapter.vibrateShort()};\n604\t    this.input.onSwap=function(r1,c1,r2,c2){self._trySwap(r1,c1,r2,c2)};\n605\t    this.input.onBtnClick=function(x,y){\n606\t      if(self.state==='gameover'){var b=self.renderer._retryBtn;if(b&&x>=b.x&&x<=b.x+b.w&&y>=b.y&&y<=b.y+b.h)self._restart()}\n607\t      if(self.state==='levelcomplete'){var b=self.renderer._nextBtn;if(b&&x>=b.x&&x<=b.x+b.w&&y>=b.y&&y<=b.y+b.h)self._nextLevel()}\n608\t      var rb=self.renderer._restartBtn;if(rb&&x>=rb.x&&x<=rb.x+rb.w&&y>=rb.y&&y<=rb.y+rb.h)self._restart();\n609\t    };\n610\t  };\n611\t\n612\t  Game.prototype._trySwap = function(r1,c1,r2,c2) {\n613\t    var self=this; adapter.vibrateShort(); this.state='swapping';\n614\t    var cs=this.layout.cellSize, dx=(c2-c1)*(cs+config.CELL_GAP), dy=(r2-r1)*(cs+config.CELL_GAP);\n615\t    this.anim.add(150,function(t){var e=easeOutQuad(t);self.renderer.setPieceOffset(r1,c1,dx*e,dy*e);self.renderer.setPieceOffset(r2,c2,-dx*e,-dy*e)},function(){\n616\t      self.renderer.clearPieceOffset(r1,c1);self.renderer.clearPieceOffset(r2,c2);self.board.swap(r1,c1,r2,c2);\n617\t      var ms=self.board.findMatches();\n618\t      if(ms.length===0){\n619\t        self.anim.add(150,function(t){var e=easeOutQuad(t);self.renderer.setPieceOffset(r1,c1,-dx*e,-dy*e);self.renderer.setPieceOffset(r2,c2,dx*e,dy*e)},function(){\n620\t          self.renderer.clearPieceOffset(r1,c1);self.renderer.clearPieceOffset(r2,c2);self.board.swap(r1,c1,r2,c2);self.state='idle';\n621\t        });\n622\t      } else { self.score.useMove(); self.score.startCombo(); self._processMatches(); }\n623\t    });\n624\t  };\n625\t\n626\t  Game.prototype._processMatches = function() {\n627\t    var self=this, ms=this.board.findMatches();\n628\t    if(ms.length===0){\n629\t      if(!this.board.hasValidMoves())this.board.shuffle();\n630\t      if(this.score.isLevelComplete()){this.state='levelcomplete';this.score.saveBest()}\n631\t      else if(this.score.isGameOver()){this.state='gameover';this.score.saveBest()}\n632\t      else this.state='idle';\n633\t      return;\n634\t    }\n635\t    var combo=this.score.incrementCombo(); this.renderer.setComboText(combo); this.renderer.screenShake=1.5;\n636\t    var groups=this._groupMatches(ms), totalScore=0;\n637\t    for(var i=0;i<groups.length;i++){\n638\t      var pts=this.score.addScore(groups[i].length); totalScore+=pts;\n639\t      var avgR=0,avgC=0;for(var j=0;j<groups[i].length;j++){avgR+=groups[i][j].r;avgC+=groups[i][j].c}\n640\t      avgR/=groups[i].length;avgC/=groups[i].length;\n641\t      this.renderer.addScorePopup(avgR,avgC,pts);\n642\t    }\n643\t    this.state='removing';\n644\t    var removed=this.board.removeMatches(ms);\n645\t    for(var i=0;i<removed.length;i++)this.renderer.addParticles(removed[i].r,removed[i].c,removed[i].type);\n646\t    this.anim.add(200,function(t){for(var i=0;i<removed.length;i++)self.renderer.setPieceScale(removed[i].r,removed[i].c,1-easeOutQuad(t))},function(){\n647\t      for(var i=0;i<removed.length;i++)self.renderer.clearPieceScale(removed[i].r,removed[i].c);\n648\t      self._applyGravity();\n649\t    });\n650\t  };\n651\t\n652\t  Game.prototype._groupMatches = function(ms) {\n653\t    var set={},i;for(i=0;i<ms.length;i++)set[ms[i].r+','+ms[i].c]=ms[i];\n654\t    var visited={},groups=[];\n655\t    for(i=0;i<ms.length;i++){\n656\t      var k=ms[i].r+','+ms[i].c;if(visited[k])continue;\n657\t      var group=[],queue=[ms[i]];\n658\t      while(queue.length>0){var cur=queue.pop(),ck=cur.r+','+cur.c;if(visited[ck])continue;visited[ck]=true;group.push(cur);\n659\t        var dirs=[[0,1],[0,-1],[1,0],[-1,0]];for(var d=0;d<4;d++){var nk=(cur.r+dirs[d][0])+','+(cur.c+dirs[d][1]);if(set[nk]&&!visited[nk])queue.push(set[nk])}}\n660\t      groups.push(group);\n661\t    }\n662\t    return groups;\n663\t  };\n664\t\n665\t  Game.prototype._applyGravity = function() {\n666\t    var self=this; this.state='falling';\n667\t    var moves=this.board.applyGravity(), spawns=this.board.refill(), cs=this.layout.cellSize;\n668\t    var all=[];\n669\t    for(var i=0;i<moves.length;i++)all.push({r:moves[i].toR,c:moves[i].toC,fromDy:(moves[i].fromR-moves[i].toR)*(cs+config.CELL_GAP)});\n670\t    for(var i=0;i<spawns.length;i++)all.push({r:spawns[i].r,c:spawns[i].c,fromDy:(spawns[i].fromR-spawns[i].r)*(cs+config.CELL_GAP)});\n671\t    if(all.length===0){this._processMatches();return}\n672\t    this.anim.add(300,function(t){var e=easeOutBounce(t);for(var i=0;i<all.length;i++)self.renderer.setPieceOffset(all[i].r,all[i].c,0,all[i].fromDy*(1-e))},function(){\n673\t      for(var i=0;i<all.length;i++)self.renderer.clearPieceOffset(all[i].r,all[i].c);\n674\t      self._processMatches();\n675\t    });\n676\t  };\n677\t\n678\t  Game.prototype._restart = function() {\n679\t    this.board.init();this.score.reset();this.anim.clear();\n680\t    this.renderer.particles=[];this.renderer.scorePopups=[];this.renderer.comboText=null;this.renderer.screenShake=0;\n681\t    this.renderer.pieceOffset={};this.renderer.pieceScale={};this.input.reset();this.state='idle';\n682\t  };\n683\t\n684\t  Game.prototype._nextLevel = function() {\n685\t    this.score.nextLevel();this.board.init();this.anim.clear();\n686\t    this.renderer.particles=[];this.renderer.scorePopups=[];this.renderer.comboText=null;this.renderer.screenShake=0;\n687\t    this.renderer.pieceOffset={};this.renderer.pieceScale={};this.input.reset();this.state='idle';\n688\t  };\n689\t\n690\t  Game.prototype._loop = function() {\n691\t    var self=this, now=Date.now(), dt=Math.min((now-this._lastTime)/1000,0.1);\n692\t    this._lastTime=now;\n693\t    this.anim.update(dt*1000);this.renderer.updateEffects(dt);\n694\t    var r=this.renderer;r.clear();r.drawBackground();\n695\t    r.drawTopBar(this.score.score,this.score.level,this.score.movesLeft,this.score.targetScore);\n696\t    r.drawBoard();r.drawPieces(this.board);r.drawEffects();r.drawBottomBar();\n697\t    if(this.state==='gameover')r.drawGameOver(this.score.score,this.score.level,this.score.bestScore);\n698\t    if(this.state==='levelcomplete')r.drawLevelComplete(this.score.score,this.score.level,this.score.bestScore);\n699\t    requestAnimationFrame(function(){self._loop()});\n700\t  };\n701\t\n702\t  new Game();\n703\t})();\n704\t</script>\n705\t</body>\n706\t</html>\n707\t"}]},"parent_tool_use_id":null,"session_id":"b40e9963-6d9c-4ef1-96a5-70dd29359e7e","uuid":"0a429be8-32d9-4a31-84ff-52fb1eed9b78","timestamp":"2026-05-23T18:21:44.190Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\games\\match3-xiaoxiaoxiao\\index.html","content":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n  <title>消消消大作战</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    html, body {\n      width: 100%; height: 100%;\n      overflow: hidden;\n      background: #1A1A2E;\n      touch-action: none;\n      -webkit-touch-callout: none;\n      -webkit-user-select: none;\n      user-select: none;\n    }\n    canvas {\n      display: block;\n      width: 100%;\n      height: 100%;\n    }\n  </style>\n</head>\n<body>\n<script>\n// Browser polyfill for Douyin mini-game 'tt' API\nvar tt = {\n  createCanvas: function() { return document.querySelector('canvas') || document.createElement('canvas'); },\n  getSystemInfoSync: function() {\n    return {\n      windowWidth: window.innerWidth,\n      windowHeight: window.innerHeight,\n      pixelRatio: window.devicePixelRatio || 1,\n      platform: 'web'\n    };\n  },\n  onTouchStart: function(cb) { document.addEventListener('touchstart', function(e) { e.preventDefault(); cb(e); }, { passive: false }); },\n  onTouchMove: function(cb) { document.addEventListener('touchmove', function(e) { e.preventDefault(); cb(e); }, { passive: false }); },\n  onTouchEnd: function(cb) { document.addEventListener('touchend', function(e) { e.preventDefault(); cb(e); }); },\n  setStorageSync: function(k, v) { localStorage.setItem(k, JSON.stringify(v)); },\n  getStorageSync: function(k) { var v = localStorage.getItem(k); return v ? JSON.parse(v) : null; },\n  vibrateShort: function() { if (navigator.vibrate) navigator.vibrate(15); },\n  showModal: function(o) { var ok = confirm(o.content); if (o.success) o.success({ confirm: ok, cancel: !ok }); }\n};\n\n// Add canvas to DOM\nvar canvas = document.createElement('canvas');\ndocument.body.appendChild(canvas);\n</script>\n<script>\n// Module loader for browser (CommonJS -> browser shim)\nvar _modules = {};\nvar _cache = {};\nfunction defineModule(name, factory) { _modules[name] = factory; }\nfunction require(name) {\n  if (_cache[name]) return _cache[name];\n  if (!_modules[name]) throw new Error('Module not found: ' + name);\n  var module = { exports: {} };\n  _modules[name](module, module.exports, require);\n  _cache[name] = module.exports;\n  return module.exports;\n}\n</script>\n<script src=\"adapter/index.js\"></script>\n<script>\n// Wrap adapter module\n(function() {\n  var _orig = typeof module !== 'undefined' ? module : null;\n  if (typeof module === 'undefined') {\n    // Re-parse the adapter as a module\n    // Already loaded via script tag, tt is global\n  }\n})();\n</script>\n<!-- Re-define modules for browser -->\n<script>\n// adapter/index.js content (inlined for browser)\ndefineModule('./adapter/index', function(module, exports, require) {\n  var isTT = typeof tt !== 'undefined';\n  function createCanvas() { return document.querySelector('canvas:last-child') || document.createElement('canvas'); }\n  function createOffscreenCanvas() { return document.createElement('canvas'); }\n  function getSystemInfo() { return tt.getSystemInfoSync(); }\n  function onTouchStart(cb) { document.addEventListener('touchstart', function(e) { e.preventDefault(); cb(e); }, { passive: false }); }\n  function onTouchMove(cb) { document.addEventListener('touchmove', function(e) { e.preventDefault(); cb(e); }, { passive: false }); }\n  function onTouchEnd(cb) { document.addEventListener('touchend', function(e) { cb(e); }); }\n  function setStorage(k, v) { localStorage.setItem(k, JSON.stringify(v)); }\n  function getStorage(k) { var v = localStorage.getItem(k); return v ? JSON.parse(v) : null; }\n  function vibrateShort() { if (navigator.vibrate) navigator.vibrate(15); }\n  function showModal(o) { var ok = confirm(o.content); if (o.success) o.success({ confirm: ok, cancel: !ok }); }\n  module.exports = { isTT: isTT, createCanvas: createCanvas, createOffscreenCanvas: createOffscreenCanvas, getSystemInfo: getSystemInfo, onTouchStart: onTouchStart, onTouchMove: onTouchMove, onTouchEnd: onTouchEnd, setStorage: setStorage, getStorage: getStorage, vibrateShort: vibrateShort, showModal: showModal };\n});\n\ndefineModule('./js/config', function(module, exports, require) {\n  module.exports = {\n    GRID_SIZE: 8, PIECE_TYPES: 6,\n    PIECE_COLORS: ['#FF4757','#3742FA','#2ED573','#FFA502','#A55EEA','#FF6B81'],\n    PIECE_GLOW: ['#FF6B81','#5352ED','#7BED9F','#FFD32A','#D980FA','#FF9FF3'],\n    PIECE_SHAPES: ['circle','diamond','square','triangle','star','hexagon'],\n    BOARD_PADDING: 8, BOARD_BORDER_RADIUS: 12, CELL_GAP: 4,\n    BG_COLOR: '#1A1A2E', BOARD_BG: '#16213E', CELL_BG: '#0F3460',\n    SELECTED_COLOR: '#ECCC68', HINT_COLOR: 'rgba(255,255,255,0.3)',\n    TOP_BAR_HEIGHT: 100, BOTTOM_BAR_HEIGHT: 80,\n    ANIM_SWAP_SPEED: 6, ANIM_FALL_SPEED: 8, ANIM_REMOVE_SPEED: 4, ANIM_BOUNCE_DECAY: 0.6,\n    INITIAL_MOVES: 30,\n    LEVEL_TARGETS: [3000,5000,8000,12000,18000,25000,35000,50000],\n    SCORE_3_MATCH: 100, SCORE_4_MATCH: 250, SCORE_5_MATCH: 500, COMBO_MULTIPLIER: 0.5,\n    STORAGE_KEY_SCORE: 'x4_high_score', STORAGE_KEY_LEVEL: 'x4_max_level',\n    SWIPE_THRESHOLD: 20,\n  };\n});\n\ndefineModule('./js/utils', function(module, exports, require) {\n  function lerp(a,b,t){return a+(b-a)*t}\n  function easeOutBounce(t){if(t<1/2.75)return 7.5625*t*t;if(t<2/2.75)return 7.5625*(t-=1.5/2.75)*t+0.75;if(t<2.5/2.75)return 7.5625*(t-=2.25/2.75)*t+0.9375;return 7.5625*(t-=2.625/2.75)*t+0.984375}\n  function easeOutQuad(t){return 1-(1-t)*(1-t)}\n  function easeInOutCubic(t){return t<0.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2}\n  function randomInt(min,max){return Math.floor(Math.random()*(max-min+1))+min}\n  function clamp(val,min,max){return Math.max(min,Math.min(max,val))}\n  module.exports={lerp:lerp,easeOutBounce:easeOutBounce,easeOutQuad:easeOutQuad,easeInOutCubic:easeInOutCubic,randomInt:randomInt,clamp:clamp};\n});\n</script>\n<script src=\"js/board.js\"></script>\n<script src=\"js/animation.js\"></script>\n<script src=\"js/renderer.js\"></script>\n<script src=\"js/input.js\"></script>\n<script src=\"js/score-manager.js\"></script>\n<script>\n// Register the JS modules from their script-loaded globals\n// We need to re-wrap them since they use module.exports\n// These scripts already ran with `module` defined as {} in browser\n\n// Actually, let's use a simpler approach: load game.js directly\n// The browser module system will handle the require() calls\n</script>\n<script>\n// Board module\ndefineModule('./js/board', function(module, exports, require) {\n  var config = require('./js/config');\n  var utils = require('./js/utils');\n  var randomInt = utils.randomInt;\n\n  function Board() {\n    this.grid = [];\n    this.animating = false;\n    this.animations = [];\n    this.init();\n  }\n  Board.prototype.init = function() {\n    this.grid = [];\n    for (var r = 0; r < config.GRID_SIZE; r++) {\n      this.grid[r] = [];\n      for (var c = 0; c < config.GRID_SIZE; c++) {\n        this.grid[r][c] = this._randomPiece(r, c);\n      }\n    }\n    while (this._findMatches().length > 0) {\n      for (var r = 0; r < config.GRID_SIZE; r++) {\n        for (var c = 0; c < config.GRID_SIZE; c++) {\n          this.grid[r][c] = this._randomPiece(r, c);\n        }\n      }\n    }\n    this.animations = [];\n    this.animating = false;\n  };\n  Board.prototype._randomPiece = function(r, c) {\n    var forbidden = {};\n    if (c >= 2 && this.grid[r][c-1] === this.grid[r][c-2]) forbidden[this.grid[r][c-1]] = true;\n    if (r >= 2 && this.grid[r-1] && this.grid[r-2] && this.grid[r-1][c] === this.grid[r-2][c]) forbidden[this.grid[r-1][c]] = true;\n    var type;\n    do { type = randomInt(0, config.PIECE_TYPES - 1); } while (forbidden[type]);\n    return type;\n  };\n  Board.prototype.getPiece = function(r, c) {\n    if (r < 0 || r >= config.GRID_SIZE || c < 0 || c >= config.GRID_SIZE) return -1;\n    return this.grid[r][c];\n  };\n  Board.prototype.isAdjacent = function(r1,c1,r2,c2) { return (Math.abs(r1-r2)+Math.abs(c1-c2))===1; };\n  Board.prototype.swap = function(r1,c1,r2,c2) { var t=this.grid[r1][c1]; this.grid[r1][c1]=this.grid[r2][c2]; this.grid[r2][c2]=t; };\n  Board.prototype._findMatches = function() {\n    var matches = {};\n    for (var r = 0; r < config.GRID_SIZE; r++) {\n      for (var c = 0; c <= config.GRID_SIZE - 3; c++) {\n        var t = this.grid[r][c];\n        if (t < 0) continue;\n        if (this.grid[r][c+1]===t && this.grid[r][c+2]===t) {\n          var end = c+2;\n          while (end+1<config.GRID_SIZE && this.grid[r][end+1]===t) end++;\n          for (var i=c;i<=end;i++) matches[r+','+i]=true;\n        }\n      }\n    }\n    for (var c = 0; c < config.GRID_SIZE; c++) {\n      for (var r = 0; r <= config.GRID_SIZE - 3; r++) {\n        var t = this.grid[r][c];\n        if (t < 0) continue;\n        if (this.grid[r+1][c]===t && this.grid[r+2][c]===t) {\n          var end = r+2;\n          while (end+1<config.GRID_SIZE && this.grid[end+1][c]===t) end++;\n          for (var i=r;i<=end;i++) matches[i+','+c]=true;\n        }\n      }\n    }\n    var result = [];\n    for (var k in matches) {\n      var parts = k.split(',');\n      result.push({r:parseInt(parts[0]), c:parseInt(parts[1])});\n    }\n    return result;\n  };\n  Board.prototype.findMatches = function() { return this._findMatches(); };\n  Board.prototype.removeMatches = function(matches) {\n    var removed = [];\n    for (var i=0;i<matches.length;i++) {\n      var m = matches[i];\n      removed.push({r:m.r, c:m.c, type:this.grid[m.r][m.c]});\n      this.grid[m.r][m.c] = -1;\n    }\n    return removed;\n  };\n  Board.prototype.applyGravity = function() {\n    var moves = [];\n    for (var c=0;c<config.GRID_SIZE;c++) {\n      var wr = config.GRID_SIZE - 1;\n      for (var r=config.GRID_SIZE-1;r>=0;r--) {\n        if (this.grid[r][c]>=0) {\n          if (wr!==r) {\n            moves.push({fromR:r,fromC:c,toR:wr,toC:c});\n            this.grid[wr][c]=this.grid[r][c];\n            this.grid[r][c]=-1;\n          }\n          wr--;\n        }\n      }\n    }\n    return moves;\n  };\n  Board.prototype.refill = function() {\n    var spawns = [];\n    for (var c=0;c<config.GRID_SIZE;c++) {\n      var empty=0;\n      for (var r=0;r<config.GRID_SIZE;r++) if(this.grid[r][c]<0) empty++;\n      for (var r=empty-1;r>=0;r--) {\n        this.grid[r][c]=randomInt(0,config.PIECE_TYPES-1);\n        spawns.push({r:r,c:c,fromR:r-empty});\n      }\n    }\n    return spawns;\n  };\n  Board.prototype.hasValidMoves = function() {\n    for (var r=0;r<config.GRID_SIZE;r++) {\n      for (var c=0;c<config.GRID_SIZE;c++) {\n        if(c+1<config.GRID_SIZE){this.swap(r,c,r,c+1);if(this._findMatches().length>0){this.swap(r,c,r,c+1);return true}this.swap(r,c,r,c+1)}\n        if(r+1<config.GRID_SIZE){this.swap(r,c,r+1,c);if(this._findMatches().length>0){this.swap(r,c,r+1,c);return true}this.swap(r,c,r+1,c)}\n      }\n    }\n    return false;\n  };\n  Board.prototype.shuffle = function() {\n    var pieces=[];\n    for(var r=0;r<config.GRID_SIZE;r++)for(var c=0;c<config.GRID_SIZE;c++)pieces.push(this.grid[r][c]);\n    for(var i=pieces.length-1;i>0;i--){var j=randomInt(0,i);var t=pieces[i];pieces[i]=pieces[j];pieces[j]=t}\n    var idx=0;\n    for(var r=0;r<config.GRID_SIZE;r++)for(var c=0;c<config.GRID_SIZE;c++)this.grid[r][c]=pieces[idx++];\n    while(this._findMatches().length>0){var ms=this._findMatches();for(var i=0;i<ms.length;i++)this.grid[ms[i].r][ms[i].c]=randomInt(0,config.PIECE_TYPES-1)}\n    if(!this.hasValidMoves())this.shuffle();\n  };\n  module.exports = Board;\n});\n\n// Animation module\ndefineModule('./js/animation', function(module, exports, require) {\n  function Animation(duration, updateFn, completeFn) {\n    this.duration = duration; this.updateFn = updateFn; this.completeFn = completeFn;\n    this.elapsed = 0; this.done = false;\n  }\n  Animation.prototype.update = function(dt) {\n    if (this.done) return;\n    this.elapsed += dt;\n    var t = Math.min(this.elapsed / this.duration, 1);\n    this.updateFn(t);\n    if (t >= 1) { this.done = true; if (this.completeFn) this.completeFn(); }\n  };\n\n  function AnimationManager() { this.anims = []; }\n  AnimationManager.prototype