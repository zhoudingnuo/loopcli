type.init=function(){this.grid=[];for(var r=0;r<config.GRID_SIZE;r++){this.grid[r]=[];for(var c=0;c<config.GRID_SIZE;c++){this.grid[r][c]=this._rp(r,c)}}while(this._fm().length>0){for(var r=0;r<config.GRID_SIZE;r++)for(var c=0;c<config.GRID_SIZE;c++)this.grid[r][c]=this._rp(r,c)}};\nBoard.prototype._rp=function(r,c){var f={};if(c>=2&&this.grid[r][c-1]===this.grid[r][c-2])f[this.grid[r][c-1]]=true;if(r>=2&&this.grid[r-1]&&this.grid[r-2]&&this.grid[r-1][c]===this.grid[r-2][c])f[this.grid[r-1][c]]=true;var t;do{t=randomInt(0,config.PIECE_TYPES-1)}while(f[t]);return t};\nBoard.prototype.getPiece=function(r,c){if(r<0||r>=config.GRID_SIZE||c<0||c>=config.GRID_SIZE)return -1;return this.grid[r][c]};\nBoard.prototype.swap=function(r1,c1,r2,c2){var t=this.grid[r1][c1];this.grid[r1][c1]=this.grid[r2][c2];this.grid[r2][c2]=t};\n```\n\n## 第25页（文件：pages/index/index.js 第51-100行）\n\n```javascript\nBoard.prototype._fm=function(){var m={};for(var r=0;r<config.GRID_SIZE;r++)for(var c=0;c<=config.GRID_SIZE-3;c++){var t=this.grid[r][c];if(t<0)continue;if(this.grid[r][c+1]===t&&this.grid[r][c+2]===t){var e=c+2;while(e+1<config.GRID_SIZE&&this.grid[r][e+1]===t)e++;for(var i=c;i<=e;i++)m[r+','+i]=true}}for(var c=0;c<config.GRID_SIZE;c++)for(var r=0;r<=config.GRID_SIZE-3;r++){var t=this.grid[r][c];if(t<0)continue;if(this.grid[r+1][c]===t&&this.grid[r+2][c]===t){var e=r+2;while(e+1<config.GRID_SIZE&&this.grid[e+1][c]===t)e++;for(var i=r;i<=e;i++)m[i+','+c]=true}}var res=[];for(var k in m){var p=k.split(',');res.push({r:parseInt(p[0]),c:parseInt(p[1])})}return res};\nBoard.prototype.findMatches=function(){return this._fm()};\nBoard.prototype.removeMatches=function(ms){var rm=[];for(var i=0;i<ms.length;i++){rm.push({r:ms[i].r,c:ms[i].c,type:this.grid[ms[i].r][ms[i].c]});this.grid[ms[i].r][ms[i].c]=-1}return rm};\nBoard.prototype.applyGravity=function(){var mv=[];for(var c=0;c<config.GRID_SIZE;c++){var wr=config.GRID_SIZE-1;for(var r=config.GRID_SIZE-1;r>=0;r--){if(this.grid[r][c]>=0){if(wr!==