185\t    { \"id\": \"t_survivor2_2\", \"npcId\": \"survivor2\", \"label\": \"蛇使与朝服人的争吵\", \"dialogueId\": \"ch4_interrog_survivor2_2\", \"repeatable\": false, \"pressureRange\": { \"min\": 15, \"max\": 100 } },\n186\t    { \"id\": \"t_survivor2_3\", \"npcId\": \"survivor2\", \"label\": \"陆判官的传说\", \"dialogueId\": \"ch4_interrog_survivor2_3\", \"repeatable\": false, \"requiresEvidence\": [\"ch4_ritual_text\"] },\n187\t    { \"id\": \"t_snake_1\", \"npcId\": \"snake_agent\", \"label\": \"蛇神会的目的\", \"dialogueId\": \"ch4_interrog_snake_agent_1\", \"repeatable\": false },\n188\t    { \"id\": \"t_snake_2\", \"npcId\": \"snake_agent\", \"label\": \"关于铜符\", \"dialogueId\": \"ch4_interrog_snake_agent_2\", \"repeatable\": false, \"requiresEvidence\": [\"ch4_entrance_symbol\"] },\n189\t    { \"id\": \"t_snake_3\", \"npcId\": \"snake_agent\", \"label\": \"与杨国忠的关系\", \"dialogueId\": \"ch4_interrog_snake_agent_3\", \"repeatable\": false, \"pressureRange\": { \"min\": 40, \"max\": 100 } },\n190\t    { \"id\": \"t_snake_4\", \"npcId\": \"snake_agent\", \"label\": \"铜符的来源\", \"dialogueId\": \"ch4_interrog_snake_agent_4\", \"repeatable\": false, \"requiresEvidence\": [\"ch4_ritual_text\"], \"pressureRange\": { \"min\": 60, \"max\": 100 } },\n191\t    { \"id\": \"t_snake_5\", \"npcId\": \"snake_agent\", \"label\": \"施压：全部真相\", \"dialogueId\": \"ch4_interrog_snake_agent_5\", \"repeatable\": false, \"requiresEvidence\": [\"ch4_lu_statue\", \"ch4_six_slots\"], \"pressureRange\": { \"min\": 80, \"max\": 100 } },\n192\t    { \"id\": \"t_facheng_ch4_1\", \"npcId\": \"facheng\", \"label\": \"陆判官是谁\", \"dialogueId\": \"ch4_interrog_facheng_1\", \"repeatable\": false, \"requiresEvidence\": [\"ch4_ritual_text\"] },\n193\t    { \"id\": \"t_facheng_ch4_2\", \"npcId\": \"facheng\", \"label\": \"千年封印的来历\", \"dialogueId\": \"ch4_interrog_facheng_2\", \"repeatable\": false, \"requiresEvidence\": [\"ch4_lu_statue\"] },\n194\t    { \"id\": \"t_facheng_ch4_3\", \"npcId\": \"facheng\", \"label\": \"符号体系关联\", \"dialogueId\": \"ch4_interrog_facheng_3\", \"repeatable\": false, \"requiresEvidence\": [\"ch4_entrance_symbol\"] },\n195\t    { \"id\": \"t_facheng_ch4_4\", \"npcId\": \"facheng\", \"label\": \"如何阻止封印瓦解\", \"dialogueId\": \"ch4_interrog_facheng_4\", \"repeatable\": false, \"pressureRange\": { \"min\": 40, \"max\": 100 } },\n196\t    { \"id\": \"t_tieshou_ch4_1\", \"npcId\": \"zhang_tieshou\", \"label\": \"蛇神会背景调查\", \"dialogueId\": \"ch4_interrog_tieshou_1\", \"repeatable\": false },\n197\t    { \"id\": \"t_tieshou_ch4_2\", \"npcId\": \"zhang_tieshou\", \"label\": \"杨国忠与蛇神会\", \"dialogueId\": \"ch4_interrog_tieshou_2\", \"repeatable\": false, \"requiresEvidence\": [\"ch4_entrance_symbol\"] },\n198\t    { \"id\": \"t_tieshou_ch4_3\", \"npcId\": \"zhang_tieshou\", \"label\": \"血祭调查\", \"dialogueId\": \"ch4_interrog_tieshou_3\", \"repeatable\": false, \"requiresEvidence\": [\"ch4_blood_bowl\"] },\n199\t    { \"id\": \"t_qiniang_ch4_1\", \"npcId\": \"liu_qiniang\", \"label\": \"地下鬼城传说\", \"dialogueId\": \"ch4_interrog_qiniang_1\", \"repeatable\": false },"}]},"parent_tool_use_id":null,"session_id":"78611f4a-78a4-4c87-b3e8-1e3da9d4e994","uuid":"26953488-77d9-4a1b-b06e-3c3061a85c07","timestamp":"2026-05-23T18:52:38.380Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-ancient-mystery\\src\\data\\chapters\\ch4.json","content":"    { \"id\": \"ch4_pre_trial_2\", \"speaker\": \"沈鹤年\", \"text\": \"\", \"choices\": [\n      { \"text\": \"为了长安百姓，必须将他们绳之以法。\", \"next\": \"ch4_trial_start\" },\n      { \"text\": \"让我再调查一下地下暗道。\", \"next\": \"ch4_pre_trial_recheck\" }\n    ]},\n    { \"id\": \"ch4_pre_trial_recheck\", \"speaker\": \"裴如意\", \"text\": \"也好。这个组织盘根错节，多查一些不会错。\", \"next\": \"ch4_pre_trial_ready\" },\n    { \"id\": \"ch4_pre_trial_ready\", \"speaker\": \"旁白\", \"text\": \"继续调查或点击『庭审』开始审案。\" },\n    { \"id\": \"ch4_trial_start\", \"speaker\": \"旁白\", \"text\": \"公堂之上。此案涉及一个庞大地下组织——蛇神会、朝中势力、以及跨越千年的封印术。这是沈鹤年迄今面临的最大挑战。\" },\n\n    { \"id\": \"ch4_trial_end_success\", \"speaker\": \"裴如意\", \"text\": \"蛇神会祸害长安多年，今日终于曝光于天下。蛇使、相关官员一网打尽。沈推官居功至伟。\", \"next\": \"ch4_trial_end_2\" },\n    { \"id\": \"ch4_trial_end_2\", \"speaker\": \"沈鹤年\", \"text\": \"蛇神会利用长安地下网络进行人口贩卖和血祭仪式，与杨国忠势力勾结。但真正的危险不在人事——而在地下的封印正在松动。\", \"next\": \"ch4_trial_end_3\" },\n    { \"id\": \"ch4_trial_end_3\", \"speaker\": \"旁白\", \"text\": \"在地下祭坛的最深处，沈鹤年发现了一个名字——陆判官。千年前被封印的存在，正在缓缓苏醒。铜符、封印石、血祭...一切都是为了他的回归。\", \"addEvidence\": [\"ch4_lu_judge_revealed\"], \"next\": \"ch4_epilogue\" },\n    { \"id\": \"ch4_epilogue\", \"speaker\": \"旁白\", \"text\": \"第四章「地下迷城」——完结。沈鹤年发现了陆判官的存在，以及蛇神会的千年阴谋。暗线：组织的蛇形符号与Ch1铜符、Ch2封印术、Ch3封印石属于同一套体系。一切指向长安地下沉睡的远古存在...\" }\n  ],\n  \"evidence\": [\n    { \"id\": \"ch4_entrance_symbol\", \"name\": \"入口封印符号\", \"description\": \"暗渠入口石板上的封印符号，与铜符符文同源。\", \"category\": \"key\", \"discoveredAt\": \"underground_entrance\", \"discoveredTime\": 0 },\n    { \"id\": \"ch4_snake_keys\", \"name\": \"蛇形钥匙\", \"description\": \"暗渠入口旁发现的钥匙串，其中一把带有蛇形标记，用于开启地下密室。\", \"category\": \"key\", \"discoveredAt\": \"underground_entrance\", \"discoveredTime\": 0 },\n    { \"id\": \"ch4_tunnel_mural\", \"name\": \"暗渠壁画\", \"description\": \"壁画描绘仪式场景：铜符、封印石、蛇形图腾。暗示蛇神会的信仰体系。\", \"category\": \"key\", \"discoveredAt\": \"underground_tunnel\", \"discoveredTime\": 0 },\n    { \"id\": \"ch4_drag_marks\", \"name\": \"拖拽痕迹\", \"description\": \"暗渠地面大量拖拽痕迹和脚印。失踪者被绑架后拖入地下。\", \"category\": \"normal\", \"discoveredAt\": \"underground_tunnel\", \"discoveredTime\": 0 },\n    { \"id\": \"ch4_bronze_mirror\", \"name\": \"蛇形铜镜\", \"description\": \"暗渠岔路口的铜镜，背面刻有蛇形图腾。正面映像似有异常。\", \"category\": \"normal\", \"discoveredAt\": \"underground_tunnel\", \"discoveredTime\": 0 },\n    { \"id\": \"ch4_chamber_altar\", \"name\": \"集会密室祭坛\", \"description\": \"秘密集会场所的祭坛，黑旗绣有蛇形图腾。三枚铜符呈三角排列。\", \"category\": \"key\", \"discoveredAt\": \"underground_chamber\", \"discoveredTime\": 0 },\n    { \"id\": \"ch4_blood_bowl\", \"name\": \"血碗\", \"description\": \"祭坛中央石碗中干涸的暗红色液体，确认为人血。用于血祭仪式。\", \"category\": \"key\", \"discoveredAt\": \"underground_chamber\", \"discoveredTime\": 0 },\n    { \"id\": \"ch4_ritual_text\", \"name\": \"仪式铭文\", \"description\": \"祭坛墙壁上的仪式说明。关键文字：'当六枚铜符汇聚，封印将彻底瓦解，陆判官将重返人间'。\", \"category\": \"key\", \"discoveredAt\": \"underground_chamber\", \"discoveredTime\": 0 },\n    { \"id\": \"ch4_rescued_victims\", \"name\": \"获救失踪者证词\", \"description\": \"四名获救者的联合证词。证实蛇神会绑架、囚禁、定期抽取血液。\", \"category\": \"key\", \"discoveredAt\": \"underground_cells\", \"discoveredTime\": 0 },\n    { \"id\": \"ch4_blood_harvest\", \"name\": \"血祭证据\", \"description\": \"牢房墙壁上的抓痕和计数。被囚者被定期抽取血液，用于仪式。\", \"category\": \"key\", \"discoveredAt\": \"underground_cells\", \"discoveredTime\": 0 },\n    { \"id\": \"ch4_lu_statue\", \"name\": \"陆判官石像\", \"description\": \"地下祭坛最深处的人身蛇尾石像，底座刻'陆判官'。面目狰狞，散发不祥气息。\", \"category\": \"key\", \"discoveredAt\": \"underground_altar\", \"discoveredTime\": 0 },\n    { \"id\": \"ch4_six_slots\", \"name\": \"六道铜符凹槽\", \"description\": \"石像周围六道凹槽，三道已放入铜符。六枚铜符全部就位将完全瓦解封印。\", \"category\": \"key\", \"discoveredAt\": \"underground_altar\", \"discoveredTime\": 0 },\n    { \"id\": \"ch4_facheng_lu_history\", \"name\": \"法澄解读陆判官\", \"description\": \"陆无咎，大唐开国前的异人，掌握生死秘密，被开国皇帝联合佛门高僧封印于长安地下。\", \"category\": \"key\", \"discoveredAt\": \"daciensi_temple\", \"discoveredTime\": 0 },\n    { \"id\": \"ch4_survivor_yang_testimony\", \"name\": \"朝中势力证词\", \"description\": \"获救者证实蛇使和穿朝服的人有来往，提到'杨大人'和'一手遮天'。\", \"category\": \"normal\", \"discoveredAt\": \"underground_cells\", \"discoveredTime\": 0 },\n    { \"id\": \"ch4_symbol_connection\", \"name\": \"符号体系关联\", \"description\": \"蛇神会符号与Ch1铜符、Ch2封印术、Ch3封印石属于同一套封印体系。跨章节暗线确证。\", \"category\": \"key\", \"discoveredAt\": \"combine\", \"discoveredTime\": 0 },\n    { \"id\": \"ch4_blood_ritual_bundle\", \"name\": \"血祭仪式链\", \"description\": \"血碗+血祭证据+仪式铭文=完整血祭仪式链。失踪者的血液被用来'喂养'陆判官。\", \"category\": \"key\", \"discoveredAt\": \"combine\", \"discoveredTime\": 0 },\n    { \"id\": \"ch4_lu_judge_revealed\", \"name\": \"陆判官（暗线终章）\", \"description\": \"陆无咎——千年前被封印的远古存在，蛇神会一切行动的终极目标。当六枚铜符汇聚，他将重返人间。跨章节暗线。\", \"category\": \"key\", \"discoveredAt\": \"epilogue\", \"discoveredTime\": 0 }\n  ],\n  \"exploreScenes\": [\n    {\n      \"sceneId\": \"underground_entrance\",\n      \"hotspots\": [\n        { \"id\": \"hs_ch4_symbol\", \"x\": 350, \"y\": 200, \"w\": 80, \"h\": 80, \"label\": \"封印符号石板\", \"examined\": false, \"action\": \"examine\", \"giveEvidence\": \"ch4_entrance_symbol\" },\n        { \"id\": \"hs_ch4_keys\", \"x\": 450, \"y\": 280, \"w\": 60, \"h\": 40, \"label\": \"蛇形钥匙\", \"examined\": false, \"action\": \"pickup\", \"giveEvidence\": \"ch4_snake_keys\" },\n        { \"id\": \"hs_ch4_ladder\", \"x\": 400, \"y\": 350, \"w\": 80, \"h\": 100, \"label\": \"向下的梯子\", \"examined\": false, \"action\": \"enter\", \"giveFlag\": \"ch4_entered_underground\" }\n      ]\n    },\n    {\n      \"sceneId\": \"underground_tunnel\",\n      \"hotspots\": [\n        { \"id\": \"hs_ch4_mural\", \"x\": 300, \"y\": 150, \"w\": 120, \"h\": 80, \"label\": \"暗渠壁画\", \"examined\": false, \"action\": \"examine\", \"giveEvidence\": \"ch4_tunnel_mural\" },\n        { \"id\": \"hs_ch4_drag\", \"x\": 400, \"y\": 350, \"w\": 150, \"h\": 60, \"label\": \"拖拽痕迹\", \"examined\": false, \"action\": \"examine\", \"giveEvidence\": \"ch4_drag_marks\" },\n        { \"id\": \"hs_ch4_mirror\", \"x\": 600, \"y\": 200, \"w\": 60, \"h\": 80, \"label\": \"蛇形铜镜\", \"examined\": false, \"action\": \"pickup\", \"giveEvidence\": \"ch4_bronze_mirror\" },\n        { \"id\": \"hs_ch4_fork\", \"x\": 450, \"y\": 250, \"w\": 100, \"h\": 60, \"label\": \"岔路口\", \"examined\": false, \"action\": \"examine\" }\n      ]\n    },\n    {\n      \"sceneId\": \"underground_chamber\",\n      \"hotspots\": [\n        { \"id\": \"hs_ch4_altar\", \"x\": 350, \"y\": 200, \"w\": 120, \"h\": 80, \"label\": \"集会祭坛\", \"examined\": false, \"action\": \"examine\", \"giveEvidence\": \"ch4_chamber_altar\", \"giveFlag\": \"ch4_found_altar\" },\n        { \"id\": \"hs_ch4_bowl\", \"x\": 380, \"y\": 290, \"w\": 60, \"h\": 40, \"label\": \"血碗\", \"examined\": false, \"action\": \"examine\", \"giveEvidence\": \"ch4_blood_bowl\", \"requiresFlag\": \"ch4_found_altar\" },\n        { \"id\": \"hs_ch4_text\", \"x\": 500, \"y\": 200, \"w\": 100, \"h\": 80, \"label\": \"仪式铭文\", \"examined\": false, \"action\": \"examine\", \"giveEvidence\": \"ch4_ritual_text\", \"requiresFlag\": \"ch4_found_altar\" }\n      ]\n    },\n    {\n      \"sceneId\": \"underground_cells\",\n      \"hotspots\": [\n        { \"id\": \"hs_ch4_victims\", \"x\": 300, \"y\": 200, \"w\": 150, \"h\": 100, \"label\": \"获救失踪者\", \"examined\": false, \"action\": \"talk\", \"giveEvidence\": \"ch4_rescued_victims\", \"dialogueId\": \"ch4_interrog_survivor1_1\" },\n        { \"id\": \"hs_ch4_wall_marks\", \"x\": 500, \"y\": 250, \"w\": 80, \"h\": 60, \"label\": \"牢房墙壁\", \"examined\": false, \"action\": \"examine\", \"giveEvidence\": \"ch4_blood_harvest\" },\n        { \"id\": \"hs_ch4_survivor2\", \"x\": 400, \"y\": 350, \"w\": 80, \"h\": 80, \"label\": \"刘寡妇\", \"examined\": false, \"action\": \"talk\", \"dialogueId\": \"ch4_interrog_survivor2_1\" }\n      ]\n    },\n    {\n      \"sceneId\": \"underground_altar\",\n      \"hotspots\": [\n        { \"id\": \"hs_ch4_statue\", \"x\": 350, \"y\": 150, \"w\": 100, \"h\": 150, \"label\": \"陆判官石像\", \"examined\": false, \"action\": \"examine\", \"giveEvidence\": \"ch4_lu_statue\" },\n        { \"id\": \"hs_ch4_slots\", \"x\": 300, \"y\": 300, \"w\": 150, \"h\": 60, \"label\": \"六道铜符凹槽\", \"examined\": false, \"action\": \"examine\", \"giveEvidence\": \"ch4_six_slots\" },\n        { \"id\": \"hs_ch4_passage\", \"x\": 500, \"y\": 350, \"w\": 80, \"h\": 60, \"label\": \"深层暗道\", \"examined\": false, \"action\": \"examine\", \"requiresFlag\": \"ch4_found_lu_text\" }\n      ]\n    },\n    {\n      \"sceneId\": \"county_office\",\n      \"hotspots\": [\n        { \"id\": \"hs_ch4_tieshou\", \"x\": 300, \"y\": 250, \"w\": 100, \"h\": 80, \"label\": \"张铁手\", \"examined\": false, \"action\": \"talk\", \"dialogueId\": \"ch4_interrog_tieshou_1\" },\n        { \"id\": \"hs_ch4_qiniang\", \"x\": 500, \"y\": 250, \"w\": 80, \"h\": 80, \"label\": \"柳七娘\", \"examined\": false, \"action\": \"talk\", \"dialogueId\": \"ch4_interrog_qiniang_1\" },\n        { \"id\": \"hs_ch4_facheng\", \"x\": 650, \"y\": 200, \"w\": 80, \"h\": 80, \"label\": \"法澄和尚\", \"examined\": false, \"action\": \"talk\", \"dialogueId\": \"ch4_interrog_facheng_1\" },\n        { \"id\": \"hs_ch4_pei\", \"x\": 200, \"y\": 180, \"w\": 80, \"h\": 100, \"label\": \"裴如意\", \"examined\": false, \"action\": \"talk\", \"dialogueId\": \"ch4_pre_trial\" }\n      ]\n    },\n    {\n      \"sceneId\": \"chang_an_streets\",\n      \"hotspots\": [\n        { \"id\": \"hs_ch4_snake\", \"x\": 400, \"y\": 250, \"w\": 80, \"h\": 80, \"label\": \"蛇使（已抓获）\", \"examined\": false, \"action\": \"talk\", \"dialogueId\": \"ch4_interrog_snake_agent_1\" },\n        { \"id\": \"hs_ch4_crowd\", \"x\": 300, \"y\": 200, \"w\": 100, \"h\": 60, \"label\": \"围观百姓\", \"examined\": false, \"action\": \"examine\" }\n      ]\n    }\n  ],\n  \"npcs\": [\n    { \"id\": \"survivor1\", \"name\": \"赵大（获救者）\", \"defaultPressure\": 5, \"maxPressure\": 50 },\n    { \"id\": \"survivor2\", \"name\": \"刘寡妇（获救者）\", \"defaultPressure\": 5, \"maxPressure\": 50 },\n    { \"id\": \"snake_agent\", \"name\": \"蛇使（黑袍人）\", \"defaultPressure\": 50, \"maxPressure\": 100 },\n    { \"id\": \"facheng\", \"name\": \"法澄和尚\", \"defaultPressure\": 25, \"maxPressure\": 100 },\n    { \"id\": \"zhang_tieshou\", \"name\": \"张铁手\", \"defaultPressure\": 20, \"maxPressure\": 100 },\n    { \"id\": \"liu_qiniang\", \"name\": \"柳七娘\", \"defaultPressure\": 10, \"maxPressure\": 100 }\n  ],\n  \"topics\": [\n    { \"id\": \"t_survivor1_1\", \"npcId\": \"survivor1\", \"label\": \"被绑架经过\", \"dialogueId\": \"ch4_interrog_survivor1_1\", \"repeatable\": false },\n    { \"id\": \"t_survivor1_2\", \"npcId\": \"survivor1\", \"label\": \"蛇使的描述\", \"dialogueId\": \"ch4_interrog_survivor1_2\", \"repeatable\": false, \"pressureRange\": { \"min\": 10, \"max\": 100 } },\n    { \"id\": \"t_survivor1_3\", \"npcId\": \"survivor1\", \"label\": \"穿朝服的神秘人\", \"dialogueId\": \"ch4_interrog_survivor1_3\", \"repeatable\": false, \"requiresEvidence\": [\"ch4_chamber_altar\"] },\n    { \"id\": \"t_survivor1_4\", \"npcId\": \"survivor1\", \"label\": \"关于杨大人的谈话\", \"dialogueId\": \"ch4_interrog_survivor1_4\", \"repeatable\": false, \"pressureRange\": { \"min\": 30, \"max\": 100 } },\n    { \"id\": \"t_survivor2_1\", \"npcId\": \"survivor2\", \"label\": \"地下的声音\", \"dialogueId\": \"ch4_interrog_survivor2_1\", \"repeatable\": false },\n    { \"id\": \"t_survivor2_2\", \"npcId\": \"survivor2\", \"label\": \"蛇使与朝服人的争吵\", \"dialogueId\": \"ch4_interrog_survivor2_2\", \"repeatable\": false, \"pressureRange\": { \"min\": 15, \"max\": 100 } },\n    { \"id\": \"t_survivor2_3\", \"npcId\": \"survivor2\", \"label\": \"陆判官的传说\", \"dialogueId\": \"ch4_interrog_survivor2_3\", \"repeatable\": false, \"requiresEvidence\": [\"ch4_ritual_text\"] },\n    { \"id\": \"t_snake_1\", \"npcId\": \"snake_agent\", \"label\": \"蛇神会的目的\", \"dialogueId\": \"ch4_interrog_snake_agent_1\", \"repeatable\": false },\n    { \"id\": \"t_snake_2\", \"npcId\": \"snake_agent\", \"label\": \"关于铜符\", \"dialogueId\": \"ch4_interrog_snake_agent_2\", \"repeatable\": false, \"requiresEvidence\": [\"ch4_entrance_symbol\"] },\n    { \"id\": \"t_snake_3\", \"npcId\": \"snake_agent\", \"label\": \"与杨国忠的关系\", \"dialogueId\": \"ch4_interrog_snake_agent_3\", \"repeatable\": false, \"pressureRange\": { \"min\": 40, \"max\": 100 } },\n    { \"id\": \"t_snake_4\", \"npcId\": \"snake_agent\", \"label\": \"铜符的来源\", \"dialogueId\": \"ch4_interrog_snake_agent_4\", \"repeatable\": false, \"requiresEvidence\": [\"ch4_ritual_text\"], \"pressureRange\": { \"min\": 60, \"max\": 100 } },\n    { \"id\": \"t_snake_5\", \"npcId\": \"snake_agent\", \"label\": \"施压：全部真相\", \"dialogueId\": \"ch4_interrog_snake_agent_5\", \"repeatable\": false, \"requiresEvidence\": [\"ch4_lu_statue\", \"ch4_six_slots\"], \"pressureRange\": { \"min\": 80, \"max\": 100 } },\n    { \"id\": \"t_facheng_ch4_1\", \"npcId\": \"facheng\", \"label\": \"陆判官是谁\", \"dialogueId\": \"ch4_interrog_facheng_1\", \"repeatable\": false, \"requiresEvidence\": [\"ch4_ritual_text\"] },\n    { \"id\": \"t_facheng_ch4_2\", \"npcId\": \"facheng\", \"label\": \"千年封印的来历\", \"dialogueId\": \"ch4_interrog_facheng_2\", \"repeatable\": false, \"requiresEvidence\": [\"ch4_lu_statue\"] },\n    { \"id\": \"t_facheng_ch4_3\", \"npcId\": \"facheng\", \"label\": \"符号体系关联\", \"dialogueId\": \"ch4_interrog_facheng_3\", \"repeatable\": false, \"requiresEvidence\": [\"ch4_entrance_symbol\"] },\n    { \"id\": \"t_facheng_ch4_4\", \"npcId\": \"facheng\", \"label\": \"如何阻止封印瓦解\", \"dialogueId\": \"ch4_interrog_facheng_4\", \"repeatable\": false, \"pressureRange\": { \"min\": 40, \"max\": 100 } },\n    { \"id\": \"t_tieshou_ch4_1\", \"npcId\": \"zhang_tieshou\", \"label\": \"蛇神会背景调查\", \"dialogueId\": \"ch4_interrog_tieshou_1\", \"repeatable\": false },\n    { \"id\": \"t_tieshou_ch4_2\", \"npcId\": \"zhang_tieshou\", \"label\": \"杨国忠与蛇神会\", \"dialogueId\": \"ch4_interrog_tieshou_2\", \"repeatable\": false, \"requiresEvidence\": [\"ch4_entrance_symbol\"] },\n    { \"id\": \"t_tieshou_ch4_3\", \"npcId\": \"zhang_tieshou\", \"label\": \"血祭调查\", \"dialogueId\": \"ch4_interrog_tieshou_3\", \"repeatable\": false, \"requiresEvidence\": [\"ch4_blood_bowl\"] },\n    { \"id\": \"t_qiniang_ch4_1\", \"npcId\": \"liu_qiniang\", \"label\": \"地下鬼城传说\", \"dialogueId\": \"ch4_interrog_qiniang_1\", \"repeatable\": false },","numLines":120,"startLine":80,"totalLines":323}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_b18a8076f3cc49cb9dfde5ee","type":"tool_result","content":"1\timport { Renderer } from '../renderer/Renderer';\n2\timport { GameState } from './GameState';\n3\timport { InputManager } from './InputManager';\n4\timport { CredibilityScore } from './CredibilityScore';\n5\timport { ObjectionSystem, TestimonyLine, ObjectionResult } from './ObjectionSystem';\n6\t\n7\texport type TrialPhase =\n8\t  | 'opening' | 'witness_intro' | 'testimony' | 'cross_examine'\n9\t  | 'rebuttal' | 'closing' | 'verdict' | 'complete' | 'failed';\n10\t\n11\texport interface TrialWitness {\n12\t  id: string;\n13\t  name: string;\n14\t  portrait?: string;\n15\t  testimonyLines: TestimonyLine[];\n16\t}\n17\t\n18\texport interface TrialConfig {\n19\t  id: string;\n20\t  chapter: number;\n21\t  caseTitle: string;\n22\t  plaintiffName: string;\n23\t  defendantName: string;\n24\t  judgeName: string;\n25\t  witnesses: TrialWitness[];\n26\t  correctVerdict: 'guilty' | 'innocent';\n27\t  onVerdict?: (verdict: string, score: number) => void;\n28\t}\n29\t\n30\texport class TrialLoop {\n31\t  private config: TrialConfig | null = null;\n32\t  private phase: TrialPhase = 'opening';\n33\t  private currentWitnessIndex = 0;\n34\t  private currentLineIndex = 0;\n35\t  private verdict: 'guilty' | 'innocent' | null = null;\n36\t  private animAlpha = 0;\n37\t  private phaseText = '';\n38\t  private phaseTextTimer = 0;\n39\t  private showingPhaseIntro = false;\n40\t  private totalObjections = 0;\n41\t  private correctObjections = 0;\n42\t\n43\t  private isOpen = false;\n44\t\n45\t  private objectionSystem: ObjectionSystem;\n46\t  private credibility: CredibilityScore;\n47\t\n48\t  private onTrialEnd?: (verdict: string, score: number) => void;\n49\t\n50\t  constructor(\n51\t    private renderer: Renderer,\n52\t    private state: GameState,\n53\t    private input: InputManager\n54\t  ) {\n55\t    this.credibility = new CredibilityScore(renderer, state);\n56\t    this.objectionSystem = new ObjectionSystem(renderer, state, input, this.credibility);\n57\t\n58\t    this.objectionSystem.setResultCallback((result) => {\n59\t      this.handleObjectionResult(result);\n60\t    });\n61\t\n62\t    this.setupInput();\n63\t  }\n64\t\n65\t  getCredibility(): CredibilityScore { return this.credibility; }\n66\t  getObjectionSystem(): ObjectionSystem { return this.objectionSystem; }\n67\t  getPhase(): TrialPhase { return this.phase; }\n68\t  getIsOpen(): boolean { return this.isOpen; }\n69\t\n70\t  startTrial(config: TrialConfig) {\n71\t    this.config = config;\n72\t    this.phase = 'opening';\n73\t    this.currentWitnessIndex = 0;\n74\t    this.currentLineIndex = 0;\n75\t    this.verdict = null;\n76\t    this.totalObjections = 0;\n77\t    this.correctObjections = 0;\n78\t    this.isOpen = true;\n79\t    this.animAlpha = 0;\n80\t\n81\t    this.credibility.reset();\n82\t    this.objectionSystem.resetPressure();\n83\t\n84\t    this.showPhaseText('开堂');\n85\t    this.showingPhaseIntro = true;\n86\t    this.phaseTextTimer = 2;\n87\t  }\n88\t\n89\t  endTrial() {\n90\t    this.isOpen = false;\n91\t    this.phase = 'complete';\n92\t    this.objectionSystem.hideTestimony();\n93\t  }\n94\t\n95\t  private showPhaseText(text: string) {\n96\t    this.phaseText = text;\n97\t    this.showingPhaseIntro = true;\n98\t    this.phaseTextTimer = 2;\n99\t  }\n100\t\n101\t  private advancePhase() {\n102\t    if (!this.config) return;\n103\t\n104\t    switch (this.phase) {\n105\t      case 'opening':\n106\t        this.phase = 'witness_intro';\n107\t        this.currentWitnessIndex = 0;\n108\t        this.showPhaseText(`证人：${this.config.witnesses[0]?.name ?? ''}`);\n109\t        break;\n110\t\n111\t      case 'witness_intro':\n112\t        this.phase = 'testimony';\n113\t        this.currentLineIndex = 0;\n114\t        this.startCurrentTestimony();\n115\t        break;\n116\t\n117\t      case 'testimony':\n118\t        this.phase = 'cross_examine';\n119\t        this.startCrossExamine();\n120\t        break;\n121\t\n122\t      case 'cross_examine':\n123\t        if (this.currentWitnessIndex < this.config.witnesses.length - 1) {\n124\t          this.currentWitnessIndex++;\n125\t          this.phase = 'witness_intro';\n126\t          this.showPhaseText(`证人：${this.config.witnesses[this.currentWitnessIndex].name}`);\n127\t        } else {\n128\t          this.phase = 'rebuttal';\n129\t          this.showPhaseText('最终辩论');\n130\t        }\n131\t        break;\n132\t\n133\t      case 'rebuttal':\n134\t        this.phase = 'verdict';\n135\t        this.showPhaseText('判决');\n136\t        break;\n137\t\n138\t      case 'verdict':\n139\t        this.phase = 'complete';\n140\t        this.onTrialEnd?.(this.verdict ?? 'innocent', this.credibility.getScore());\n141\t        if (this.config.onVerdict) {\n142\t          this.config.onVerdict(this.verdict ?? 'innocent', this.credibility.getScore());\n143\t        }\n144\t        break;\n145\t    }\n146\t  }\n147\t\n148\t  private startCurrentTestimony() {\n149\t    if (!this.config) return;\n150\t    const witness = this.config.witnesses[this.currentWitnessIndex];\n151\t    if (!witness || this.currentLineIndex >= witness.testimonyLines.length) {\n152\t      this.advancePhase();\n153\t      return;\n154\t    }\n155\t    const line = witness.testimonyLines[this.currentLineIndex];\n156\t    this.objectionSystem.showTestimony(line);\n157\t  }\n158\t\n159\t  private startCrossExamine() {\n160\t    if (!this.config) return;\n161\t    const witness = this.config.witnesses[this.currentWitnessIndex];\n162\t    this.currentLineIndex = 0;\n163\t    if (!witness || witness.testimonyLines.length === 0) {\n164\t      this.advancePhase();\n165\t      return;\n166\t    }\n167\t    const line = witness.testimonyLines[this.currentLineIndex];\n168\t    this.objectionSystem.showTestimony(line);\n169\t  }\n170\t\n171\t  private handleObjectionResult(result: ObjectionResult) {\n172\t    this.totalObjections++;\n173\t    if (result.success) {\n174\t      this.correctObjections++;\n175\t    }\n176\t    this.advanceToNextLine();\n177\t  }\n178\t\n179\t  private advanceToNextLine() {\n180\t    if (!this.config) return;\n181\t    const witness = this.config.witnesses[this.currentWitnessIndex];\n182\t    if (!witness) return;\n183\t\n184\t    this.currentLineIndex++;\n185\t    if (this.currentLineIndex < witness.testimonyLines.length) {\n186\t      const line = witness.testimonyLines[this.currentLineIndex];\n187\t      this.objectionSystem.showTestimony(line);\n188\t    } else {\n189\t      this.objectionSystem.hideTestimony();\n190\t      if (this.phase === 'testimony') {\n191\t        this.advancePhase();\n192\t      } else if (this.phase === 'cross_examine') {\n193\t        this.advancePhase();\n194\t      }\n195\t    }\n196\t  }\n197\t\n198\t  private setupInput() {\n199\t    this.input.onClick((e) => {\n200\t      if (e.type !== 'up') return;\n201\t      if (!this.isOpen) return;\n202\t      if (this.objectionSystem.isTestimonyActive()) return;\n203\t      this.handleClick(e.x, e.y);\n204\t    });\n205\t  }\n206\t\n207\t  private handleClick(x: number, y: number) {\n208\t    if (!this.config) return;\n209\t    const w = this.renderer.w;\n210\t    const h = this.renderer.h;\n211\t\n212\t    if (this.showingPhaseIntro && this.phaseTextTimer <= 0) {\n213\t      this.showingPhaseIntro = false;\n214\t      this.advancePhase();\n215\t      return;\n216\t    }\n217\t\n218\t    if (this.phase === 'verdict') {\n219\t      const centerX = w / 2;\n220\t      const guiltyY = h * 0.45;\n221\t      const innocentY = h * 0.55;\n222\t      const btnW = 200;\n223\t      const btnH = 50;\n224\t\n225\t      if (this.isInRect(x, y, centerX - btnW / 2, guiltyY, btnW, btnH)) {\n226\t        this.verdict = 'guilty';\n227\t        this.showPhaseText(this.verdict === this.config.correctVerdict ? '判决正确！' : '判决有误...');\n228\t        this.advancePhase();\n229\t        return;\n230\t      }\n231\t\n232\t      if (this.isInRect(x, y, centerX - btnW / 2, innocentY, btnW, btnH)) {\n233\t        this.verdict = 'innocent';\n234\t        this.showPhaseText(this.verdict === this.config.correctVerdict ? '判决正确！' : '判决有误...');\n235\t        this.advancePhase();\n236\t        return;\n237\t      }\n238\t    }\n239\t\n240\t    if (this.phase === 'complete') {\n241\t      if (this.isInRect(x, y, w / 2 - 80, h * 0.85, 160, 45)) {\n242\t        this.endTrial();\n243\t      }\n244\t    }\n245\t\n246\t    if (this.phase === 'failed') {\n247\t      this.endTrial();\n248\t    }\n249\t  }\n250\t\n251\t  update(dt: number) {\n252\t    if (!this.isOpen) return;\n253\t    this.animAlpha = Math.min(1, this.animAlpha + dt * 3);\n254\t    if (this.phaseTextTimer > 0) this.phaseTextTimer -= dt;\n255\t    this.credibility.update(dt);\n256\t    this.objectionSystem.update(dt);\n257\t\n258\t    if (!this.credibility.isAlive() && this.phase !== 'complete' && this.phase !== 'failed') {\n259\t      this.phase = 'failed';\n260\t      this.showPhaseText('庭审失败...');\n261\t    }\n262\t  }\n263\t\n264\t  render() {\n265\t    if (!this.isOpen) return;\n266\t\n267\t    const ctx = this.renderer.context;\n268\t    const w = this.renderer.w;\n269\t    const h = this.renderer.h;\n270\t\n271\t    this.renderCourtroom(ctx, w, h);\n272\t\n273\t    this.credibility.renderWarningOverlay();\n274\t\n275\t    if (this.showingPhaseIntro) {\n276\t      this.renderPhaseIntro(ctx, w, h);\n277\t      return;\n278\t    }\n279\t\n280\t    if (this.objectionSystem.isTestimonyActive()) {\n281\t      this.renderWitnessPanel(ctx, w, h);\n282\t      this.objectionSystem.render();\n283\t      return;\n284\t    }\n285\t\n286\t    switch (this.phase) {\n287\t      case 'opening':\n288\t        this.renderOpening(ctx, w, h);\n289\t        break;\n290\t      case 'witness_intro':\n291\t        this.renderWitnessIntro(ctx, w, h);\n292\t        break;\n293\t      case 'testimony':\n294\t        break;\n295\t      case 'cross_examine':\n296\t        break;\n297\t      case 'rebuttal':\n298\t        this.renderRebuttal(ctx, w, h);\n299\t        break;\n300\t      case 'verdict':\n301\t        this.renderVerdict(ctx, w, h);\n302\t        break;\n303\t      case 'complete':\n304\t        this.renderComplete(ctx, w, h);\n305\t        break;\n306\t      case 'failed':\n307\t        this.renderFailed(ctx, w, h);\n308\t        break;\n309\t    }\n310\t  }\n311\t\n312\t  private renderCourtroom(ctx: CanvasRenderingContext2D, w: number, h: number) {\n313\t    const grad = ctx.createLinearGradient(0, 0, 0, h);\n314\t    grad.addColorStop(0, '#1a0a0a');\n315\t    grad.addColorStop(0.5, '#2a1410');\n316\t    grad.addColorStop(1, '#0d0606');\n317\t    ctx.fillStyle = grad;\n318\t    ctx.fillRect(0, 0, w, h);\n319\t\n320\t    ctx.save();\n321\t    ctx.strokeStyle = '#5a3020';\n322\t    ctx.lineWidth = 2;\n323\t    ctx.beginPath();\n324\t    ctx.moveTo(w * 0.1, h * 0.35);\n325\t    ctx.lineTo(w * 0.9, h * 0.35);\n326\t    ctx.stroke();\n327\t    ctx.beginPath();\n328\t    ctx.moveTo(w * 0.1, h * 0.50);\n329\t    ctx.lineTo(w * 0.9, h * 0.50);\n330\t    ctx.stroke();\n331\t    ctx.restore();\n332\t\n333\t    if (this.config) {\n334\t      this.renderer.drawText(this.config.caseTitle, w / 2, h * 0.03, {\n335\t        font: 'bold 20px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n336\t      });\n337\t    }\n338\t\n339\t    this.credibility.render(w - 200, 10, 180);\n340\t  }\n341\t\n342\t  private renderPhaseIntro(ctx: CanvasRenderingContext2D, w: number, h: number) {\n343\t    ctx.save();\n344\t    ctx.globalAlpha = 0.7;\n345\t    ctx.fillStyle = '#0a0806';\n346\t    ctx.fillRect(0, 0, w, h);\n347\t    ctx.restore();\n348\t\n349\t    this.renderer.drawText(this.phaseText, w / 2, h * 0.4, {\n350\t      font: 'bold 42px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n351\t    });\n352\t\n353\t    if (this.phaseTextTimer <= 0) {\n354\t      const blinkAlpha = 0.3 + Math.sin(Date.now() * 0.004) * 0.2;\n355\t      this.renderer.drawText('点击继续', w / 2, h * 0.55, {\n356\t        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center', alpha: blinkAlpha,\n357\t      });\n358\t    }\n359\t  }\n360\t\n361\t  private renderWitnessPanel(ctx: CanvasRenderingContext2D, w: number, h: number) {\n362\t    if (!this.config) return;\n363\t    const witness = this.config.witnesses[this.currentWitnessIndex];\n364\t    if (!witness) return;\n365\t\n366\t    const panelX = w * 0.1;\n367\t    const panelW = w * 0.8;\n368\t    const panelY = h * 0.36;\n369\t\n370\t    ctx.save();\n371\t    ctx.globalAlpha = 0.8;\n372\t    this.renderer.drawRoundRect(panelX, panelY, panelW, 60, 6, '#1a140e', '#3a2a1a');\n373\t    ctx.restore();\n374\t\n375\t    this.renderer.drawText(`证人 ${this.currentWitnessIndex + 1}/${this.config.witnesses.length}：${witness.name}`,\n376\t      panelX + panelW / 2, panelY + 20, {\n377\t        font: 'bold 20px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2', align: 'center',\n378\t      });\n379\t  }\n380\t\n381\t  private renderOpening(ctx: CanvasRenderingContext2D, w: number, h: number) {\n382\t    if (!this.config) return;\n383\t\n384\t    this.renderer.drawText('开堂陈词', w / 2, h * 0.2, {\n385\t      font: 'bold 28px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n386\t    });\n387\t\n388\t    const lines = [\n389\t      `原告：${this.config.plaintiffName}`,\n390\t      `被告：${this.config.defendantName}`,\n391\t      `主审：${this.config.judgeName}`,\n392\t      `证人：${this.config.witnesses.length}人`,\n393\t    ];\n394\t\n395\t    lines.forEach((line, i) => {\n396\t      this.renderer.drawText(line, w / 2, h * 0.32 + i * 36, {\n397\t        font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n398\t      });\n399\t    });\n400\t\n401\t    const blinkAlpha = 0.3 + Math.sin(Date.now() * 0.004) * 0.2;\n402\t    this.renderer.drawText('点击开始', w / 2, h * 0.7, {\n403\t      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center', alpha: blinkAlpha,\n404\t    });\n405\t  }\n406\t\n407\t  private renderWitnessIntro(ctx: CanvasRenderingContext2D, w: number, h: number) {\n408\t    if (!this.config) return;\n409\t    const witness = this.config.witnesses[this.currentWitnessIndex];\n410\t    if (!witness) return;\n411\t\n412\t    this.renderer.drawText(`${witness.name}上堂作证`, w / 2, h * 0.35, {\n413\t      font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2', align: 'center',\n414\t    });\n415\t\n416\t    this.renderer.drawText(`共有 ${witness.testimonyLines.length} 条证词待听取`, w / 2, h * 0.45, {\n417\t      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870', align: 'center',\n418\t    });\n419\t  }\n420\t\n421\t  private renderRebuttal(ctx: CanvasRenderingContext2D, w: number, h: number) {\n422\t    this.renderer.drawText('最终辩论', w / 2, h * 0.2, {\n423\t      font: 'bold 28px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n424\t    });\n425\t\n426\t    this.renderer.drawText('所有证人已作证完毕。', w / 2, h * 0.35, {\n427\t      font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n428\t    });\n429\t\n430\t    this.renderer.drawText(`异议成功率：${this.totalObjections > 0 ? Math.round(this.correctObjections / this.totalObjections * 100) : 0}%`, w / 2, h * 0.45, {\n431\t      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center',\n432\t    });\n433\t\n434\t    const blinkAlpha = 0.3 + Math.sin(Date.now() * 0.004) * 0.2;\n435\t    this.renderer.drawText('进入判决', w / 2, h * 0.6, {\n436\t      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center', alpha: blinkAlpha,\n437\t    });\n438\t  }\n439\t\n440\t  private renderVerdict(ctx: CanvasRenderingContext2D, w: number, h: number) {\n441\t    if (!this.config) return;\n442\t\n443\t    this.renderer.drawText('宣 判', w / 2, h * 0.2, {\n444\t      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n445\t    });\n446\t\n447\t    this.renderer.drawText('根据庭审证据和辩论，你做出判决：', w / 2, h * 0.32, {\n448\t      font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n449\t    });\n450\t\n451\t    const centerX = w / 2;\n452\t    const btnW = 200;\n453\t    const btnH = 50;\n454\t\n455\t    const guiltyY = h * 0.45;\n456\t    const guiltyHover = this.isInRect(this.input.mouseX, this.input.mouseY, centerX - btnW / 2, guiltyY, btnW, btnH);\n457\t    this.renderer.drawRoundRect(centerX - btnW / 2, guiltyY, btnW, btnH, 6,\n458\t      guiltyHover ? '#3a1a1a' : '#1a140e', '#8b4513');\n459\t    this.renderer.drawText('有罪', centerX, guiltyY + 14, {\n460\t      font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n461\t      color: guiltyHover ? '#f0d8a0' : '#c8a040', align: 'center',\n462\t    });\n463\t\n464\t    const innocentY = h * 0.55;\n465\t    const innocentHover = this.isInRect(this.input.mouseX, this.input.mouseY, centerX - btnW / 2, innocentY, btnW, btnH);\n466\t    this.renderer.drawRoundRect(centerX - btnW / 2, innocentY, btnW, btnH, 6,\n467\t      innocentHover ? '#1a2a1a' : '#1a140e', '#5a4030');\n468\t    this.renderer.drawText('无罪', centerX, innocentY + 14, {\n469\t      font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n470\t      color: innocentHover ? '#e8c8a2' : '#a08870', align: 'center',\n471\t    });\n472\t  }\n473\t\n474\t  private renderComplete(ctx: CanvasRenderingContext2D, w: number, h: number) {\n475\t    const isCorrect = this.verdict === this.config?.correctVerdict;\n476\t\n477\t    this.renderer.drawText(isCorrect ? '判决正确' : '判决有误', w / 2, h * 0.25, {\n478\t      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif',\n479\t      color: isCorrect ? '#6a8a4a' : '#8a4a4a', align: 'center',\n480\t    });\n481\t\n482\t    this.renderer.drawText(`最终信誉值：${this.credibility.getScore()}`, w / 2, h * 0.4, {\n483\t      font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n484\t    });\n485\t\n486\t    this.renderer.drawText(`异议成功率：${this.totalObjections > 0 ? Math.round(this.correctObjections / this.totalObjections * 100) : 0}%`, w / 2, h * 0.48, {\n487\t      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870', align: 'center',\n488\t    });\n489\t\n490\t    const closeHover = this.isInRect(this.input.mouseX, this.input.mouseY, w / 2 - 80, h * 0.85, 160, 45);\n491\t    this.renderer.drawRoundRect(w / 2 - 80, h * 0.85, 160, 45, 6,\n492\t      closeHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n493\t    this.renderer.drawText('结束庭审', w / 2, h * 0.85 + 12, {\n494\t      font: '20px \"SimSun\", \"Noto Serif SC\", serif',\n495\t      color: closeHover ? '#e8c8a2' : '#a08870', align: 'center',\n496\t    });\n497\t  }\n498\t\n499\t  private renderFailed(ctx: CanvasRenderingContext2D, w: number, h: number) {\n500\t    this.renderer.drawText('庭审失败', w / 2, h * 0.3, {\n501\t      font: 'bold 40px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a3a3a', align: 'center',\n502\t    });\n503\t\n504\t    this.renderer.drawText('信誉值归零，无法继续庭审。', w / 2, h * 0.45, {\n505\t      font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n506\t    });\n507\t\n508\t    this.renderer.drawText('需要重新调查收集更多证据。', w / 2, h * 0.55, {\n509\t      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870', align: 'center',\n510\t    });\n511\t  }\n512\t\n513\t  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n514\t    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n515\t  }\n516\t}\n517\t"}]},"parent_tool_use_id":null,"session_id":"78611f4a-78a4-4c87-b3e8-1e3da9d4e994","uuid":"8153b21a-97cf-4478-9b8a-886cbf1a54f9","timestamp":"2026-05-23T18:52:38.383Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-ancient-mystery\\src\\game\\TrialLoop.ts","content":"import { Renderer } from '../renderer/Renderer';\nimport { GameState } from './GameState';\nimport { InputManager } from './InputManager';\nimport { CredibilityScore } from './CredibilityScore';\nimport { ObjectionSystem, TestimonyLine, ObjectionResult } from './ObjectionSystem';\n\nexport type TrialPhase =\n  | 'opening' | 'witness_intro' | 'testimony' | 'cross_examine'\n  | 'rebuttal' | 'closing' | 'verdict' | 'complete' | 'failed';\n\nexport interface TrialWitness {\n  id: string;\n  name: string;\n  portrait?: string;\n  testimonyLines: TestimonyLine[];\n}\n\nexport interface TrialConfig {\n  id: string;\n  chapter: number;\n  caseTitle: string;\n  plaintiffName: string;\n  defendantName: string;\n  judgeName: string;\n  witnesses: TrialWitness[];\n  correctVerdict: 'guilty' | 'innocent';\n  onVerdict?: (verdict: string, score: number) => void;\n}\n\nexport class TrialLoop {\n  private config: TrialConfig | null = null;\n  private phase: TrialPhase = 'opening';\n  private currentWitnessIndex = 0;\n  private currentLineIndex = 0;\n  private verdict: 'guilty' | 'innocent' | null = null;\n  private animAlpha = 0;\n  private phaseText = '';\n  private phaseTextTimer = 0;\n  private showingPhaseIntro = false;\n  private totalObjections = 0;\n  private correctObjections = 0;\n\n  private isOpen = false;\n\n  private objectionSystem: ObjectionSystem;\n  private credibility: CredibilityScore;\n\n  private onTrialEnd?: (verdict: string, score: number) => void;\n\n  constructor(\n    private renderer: Renderer,\n    private state: GameState,\n    private input: InputManager\n  ) {\n    this.credibility = new CredibilityScore(renderer, state);\n    this.objectionSystem = new ObjectionSystem(renderer, state, input, this.credibility);\n\n    this.objectionSystem.setResultCallback((result) => {\n      this.handleObjectionResult(result);\n    });\n\n    this.setupInput();\n  }\n\n  getCredibility(): CredibilityScore { return this.credibility; }\n  getObjectionSystem(): ObjectionSystem { return this.objectionSystem; }\n  getPhase(): TrialPhase { return this.phase; }\n  getIsOpen(): boolean { return this.isOpen; }\n\n  startTrial(config: TrialConfig) {\n    this.config = config;\n    this.phase = 'opening';\n    this.currentWitnessIndex = 0;\n    this.currentLineIndex = 0;\n    this.verdict = null;\n    this.totalObjections = 0;\n    this.correctObjections = 0;\n    this.isOpen = true;\n    this.animAlpha = 0;\n\n    this.credibility.reset();\n    this.objectionSystem.resetPressure();\n\n    this.showPhaseText('开堂');\n    this.showingPhaseIntro = true;\n    this.phaseTextTimer = 2;\n  }\n\n  endTrial() {\n    this.isOpen = false;\n    this.phase = 'complete';\n    this.objectionSystem.hideTestimony();\n  }\n\n  private showPhaseText(text: string) {\n    this.phaseText = text;\n    this.showingPhaseIntro = true;\n    this.phaseTextTimer = 2;\n  }\n\n  private advancePhase() {\n    if (!this.config) return;\n\n    switch (this.phase) {\n      case 'opening':\n        this.phase = 'witness_intro';\n        this.currentWitnessIndex = 0;\n        this.showPhaseText(`证人：${this.config.witnesses[0]?.name ?? ''}`);\n        break;\n\n      case 'witness_intro':\n        this.phase = 'testimony';\n        this.currentLineIndex = 0;\n        this.startCurrentTestimony();\n        break;\n\n      case 'testimony':\n        this.phase = 'cross_examine';\n        this.startCrossExamine();\n        break;\n\n      case 'cross_examine':\n        if (this.currentWitnessIndex < this.config.witnesses.length - 1) {\n          this.currentWitnessIndex++;\n          this.phase = 'witness_intro';\n          this.showPhaseText(`证人：${this.config.witnesses[this.currentWitnessIndex].name}`);\n        } else {\n          this.phase = 'rebuttal';\n          this.showPhaseText('最终辩论');\n        }\n        break;\n\n      case 'rebuttal':\n        this.phase = 'verdict';\n        this.showPhaseText('判决');\n        break;\n\n      case 'verdict':\n        this.phase = 'complete';\n        this.onTrialEnd?.(this.verdict ?? 'innocent', this.credibility.getScore());\n        if (this.config.onVerdict) {\n          this.config.onVerdict(this.verdict ?? 'innocent', this.credibility.getScore());\n        }\n        break;\n    }\n  }\n\n  private startCurrentTestimony() {\n    if (!this.config) return;\n    const witness = this.config.witnesses[this.currentWitnessIndex];\n    if (!witness || this.currentLineIndex >= witness.testimonyLines.length) {\n      this.advancePhase();\n      return;\n    }\n    const line = witness.testimonyLines[this.currentLineIndex];\n    this.objectionSystem.showTestimony(line);\n  }\n\n  private startCrossExamine() {\n    if (!this.config) return;\n    const witness = this.config.witnesses[this.currentWitnessIndex];\n    this.currentLineIndex = 0;\n    if (!witness || witness.testimonyLines.length === 0) {\n      this.advancePhase();\n      return;\n    }\n    const line = witness.testimonyLines[this.currentLineIndex];\n    this.objectionSystem.showTestimony(line);\n  }\n\n  private handleObjectionResult(result: ObjectionResult) {\n    this.totalObjections++;\n    if (result.success) {\n      this.correctObjections++;\n    }\n    this.advanceToNextLine();\n  }\n\n  private advanceToNextLine() {\n    if (!this.config) return;\n    const witness = this.config.witnesses[this.currentWitnessIndex];\n    if (!witness) return;\n\n    this.currentLineIndex++;\n    if (this.currentLineIndex < witness.testimonyLines.length) {\n      const line = witness.testimonyLines[this.currentLineIndex];\n      this.objectionSystem.showTestimony(line);\n    } else {\n      this.objectionSystem.hideTestimony();\n      if (this.phase === 'testimony') {\n        this.advancePhase();\n      } else if (this.phase === 'cross_examine') {\n        this.advancePhase();\n      }\n    }\n  }\n\n  private setupInput() {\n    this.input.onClick((e) => {\n      if (e.type !== 'up') return;\n      if (!this.isOpen) return;\n      if (this.objectionSystem.isTestimonyActive()) return;\n      this.handleClick(e.x, e.y);\n    });\n  }\n\n  private handleClick(x: number, y: number) {\n    if (!this.config) return;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    if (this.showingPhaseIntro && this.phaseTextTimer <= 0) {\n      this.showingPhaseIntro = false;\n      this.advancePhase();\n      return;\n    }\n\n    if (this.phase === 'verdict') {\n      const centerX = w / 2;\n      const guiltyY = h * 0.45;\n      const innocentY = h * 0.55;\n      const btnW = 200;\n      const btnH = 50;\n\n      if (this.isInRect(x, y, centerX - btnW / 2, guiltyY, btnW, btnH)) {\n        this.verdict = 'guilty';\n        this.showPhaseText(this.verdict === this.config.correctVerdict ? '判决正确！' : '判决有误...');\n        this.advancePhase();\n        return;\n      }\n\n      if (this.isInRect(x, y, centerX - btnW / 2, innocentY, btnW, btnH)) {\n        this.verdict = 'innocent';\n        this.showPhaseText(this.verdict === this.config.correctVerdict ? '判决正确！' : '判决有误...');\n        this.advancePhase();\n        return;\n      }\n    }\n\n    if (this.phase === 'complete') {\n      if (this.isInRect(x, y, w / 2 - 80, h * 0.85, 160, 45)) {\n        this.endTrial();\n      }\n    }\n\n    if (this.phase === 'failed') {\n      this.endTrial();\n    }\n  }\n\n  update(dt: number) {\n    if (!this.isOpen) return;\n    this.animAlpha = Math.min(1, this.animAlpha + dt * 3);\n    if (this.phaseTextTimer > 0) this.phaseTextTimer -= dt;\n    this.credibility.update(dt);\n    this.objectionSystem.update(dt);\n\n    if (!this.credibility.isAlive() && this.phase !== 'complete' && this.phase !== 'failed') {\n      this.phase = 'failed';\n      this.showPhaseText('庭审失败...');\n    }\n  }\n\n  render() {\n    if (!this.isOpen) return;\n\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    this.renderCourtroom(ctx, w, h);\n\n    this.credibility.renderWarningOverlay();\n\n    if (this.showingPhaseIntro) {\n      this.renderPhaseIntro(ctx, w, h);\n      return;\n    }\n\n    if (this.objectionSystem.isTestimonyActive()) {\n      this.renderWitnessPanel(ctx, w, h);\n      this.objectionSystem.render();\n      return;\n    }\n\n    switch (this.phase) {\n      case 'opening':\n        this.renderOpening(ctx, w, h);\n        break;\n      case 'witness_intro':\n        this.renderWitnessIntro(ctx, w, h);\n        break;\n      case 'testimony':\n        break;\n      case 'cross_examine':\n        break;\n      case 'rebuttal':\n        this.renderRebuttal(ctx, w, h);\n        break;\n      case 'verdict':\n        this.renderVerdict(ctx, w, h);\n        break;\n      case 'complete':\n        this.renderComplete(ctx, w, h);\n        break;\n      case 'failed':\n        this.renderFailed(ctx, w, h);\n        break;\n    }\n  }\n\n  private renderCourtroom(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0, '#1a0a0a');\n    grad.addColorStop(0.5, '#2a1410');\n    grad.addColorStop(1, '#0d0606');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n\n    ctx.save();\n    ctx.strokeStyle = '#5a3020';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.moveTo(w * 0.1, h * 0.35);\n    ctx.lineTo(w * 0.9, h * 0.35);\n    ctx.stroke();\n    ctx.beginPath();\n    ctx.moveTo(w * 0.1, h * 0.50);\n    ctx.lineTo(w * 0.9, h * 0.50);\n    ctx.stroke();\n    ctx.restore();\n\n    if (this.config) {\n      this.renderer.drawText(this.config.caseTitle, w / 2, h * 0.03, {\n        font: 'bold 20px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n      });\n    }\n\n    this.credibility.render(w - 200, 10, 180);\n  }\n\n  private renderPhaseIntro(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    ctx.save();\n    ctx.globalAlpha = 0.7;\n    ctx.fillStyle = '#0a0806';\n    ctx.fillRect(0, 0, w, h);\n    ctx.restore();\n\n    this.renderer.drawText(this.phaseText, w / 2, h * 0.4, {\n      font: 'bold 42px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    if (this.phaseTextTimer <= 0) {\n      const blinkAlpha = 0.3 + Math.sin(Date.now() * 0.004) * 0.2;\n      this.renderer.drawText('点击继续', w / 2, h * 0.55, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center', alpha: blinkAlpha,\n      });\n    }\n  }\n\n  private renderWitnessPanel(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    if (!this.config) return;\n    const witness = this.config.witnesses[this.currentWitnessIndex];\n    if (!witness) return;\n\n    const panelX = w * 0.1;\n    const panelW = w * 0.8;\n    const panelY = h * 0.36;\n\n    ctx.save();\n    ctx.globalAlpha = 0.8;\n    this.renderer.drawRoundRect(panelX, panelY, panelW, 60, 6, '#1a140e', '#3a2a1a');\n    ctx.restore();\n\n    this.renderer.drawText(`证人 ${this.currentWitnessIndex + 1}/${this.config.witnesses.length}：${witness.name}`,\n      panelX + panelW / 2, panelY + 20, {\n        font: 'bold 20px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2', align: 'center',\n      });\n  }\n\n  private renderOpening(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    if (!this.config) return;\n\n    this.renderer.drawText('开堂陈词', w / 2, h * 0.2, {\n      font: 'bold 28px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    const lines = [\n      `原告：${this.config.plaintiffName}`,\n      `被告：${this.config.defendantName}`,\n      `主审：${this.config.judgeName}`,\n      `证人：${this.config.witnesses.length}人`,\n    ];\n\n    lines.forEach((line, i) => {\n      this.renderer.drawText(line, w / 2, h * 0.32 + i * 36, {\n        font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n      });\n    });\n\n    const blinkAlpha = 0.3 + Math.sin(Date.now() * 0.004) * 0.2;\n    this.renderer.drawText('点击开始', w / 2, h * 0.7, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center', alpha: blinkAlpha,\n    });\n  }\n\n  private renderWitnessIntro(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    if (!this.config) return;\n    const witness = this.config.witnesses[this.currentWitnessIndex];\n    if (!witness) return;\n\n    this.renderer.drawText(`${witness.name}上堂作证`, w / 2, h * 0.35, {\n      font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2', align: 'center',\n    });\n\n    this.renderer.drawText(`共有 ${witness.testimonyLines.length} 条证词待听取`, w / 2, h * 0.45, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870', align: 'center',\n    });\n  }\n\n  private renderRebuttal(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    this.renderer.drawText('最终辩论', w / 2, h * 0.2, {\n      font: 'bold 28px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    this.renderer.drawText('所有证人已作证完毕。', w / 2, h * 0.35, {\n      font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n    });\n\n    this.renderer.drawText(`异议成功率：${this.totalObjections > 0 ? Math.round(this.correctObjections / this.totalObjections * 100) : 0}%`, w / 2, h * 0.45, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center',\n    });\n\n    const blinkAlpha = 0.3 + Math.sin(Date.now() * 0.004) * 0.2;\n    this.renderer.drawText('进入判决', w / 2, h * 0.6, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center', alpha: blinkAlpha,\n    });\n  }\n\n  private renderVerdict(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    if (!this.config) return;\n\n    this.renderer.drawText('宣 判', w / 2, h * 0.2, {\n      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    this.renderer.drawText('根据庭审证据和辩论，你做出判决：', w / 2, h * 0.32, {\n      font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n    });\n\n    const centerX = w / 2;\n    const btnW = 200;\n    const btnH = 50;\n\n    const guiltyY = h * 0.45;\n    const guiltyHover = this.isInRect(this.input.mouseX, this.input.mouseY, centerX - btnW / 2, guiltyY, btnW, btnH);\n    this.renderer.drawRoundRect(centerX - btnW / 2, guiltyY, btnW, btnH, 6,\n      guiltyHover ? '#3a1a1a' : '#1a140e', '#8b4513');\n    this.renderer.drawText('有罪', centerX, guiltyY + 14, {\n      font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n      color: guiltyHover ? '#f0d8a0' : '#c8a040', align: 'center',\n    });\n\n    const innocentY = h * 0.55;\n    const innocentHover = this.isInRect(this.input.mouseX, this.input.mouseY, centerX - btnW / 2, innocentY, btnW, btnH);\n    this.renderer.drawRoundRect(centerX - btnW / 2, innocentY, btnW, btnH, 6,\n      innocentHover ? '#1a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('无罪', centerX, innocentY + 14, {\n      font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n      color: innocentHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n  }\n\n  private renderComplete(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    const isCorrect = this.verdict === this.config?.correctVerdict;\n\n    this.renderer.drawText(isCorrect ? '判决正确' : '判决有误', w / 2, h * 0.25, {\n      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif',\n      color: isCorrect ? '#6a8a4a' : '#8a4a4a', align: 'center',\n    });\n\n    this.renderer.drawText(`最终信誉值：${this.credibility.getScore()}`, w / 2, h * 0.4, {\n      font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n    });\n\n    this.renderer.drawText(`异议成功率：${this.totalObjections > 0 ? Math.round(this.correctObjections / this.totalObjections * 100) : 0}%`, w / 2, h * 0.48, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870', align: 'center',\n    });\n\n    const closeHover = this.isInRect(this.input.mouseX, this.input.mouseY, w / 2 - 80, h * 0.85, 160, 45);\n    this.renderer.drawRoundRect(w / 2 - 80, h * 0.85, 160, 45, 6,\n      closeHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('结束庭审', w / 2, h * 0.85 + 12, {\n      font: '20px \"SimSun\", \"Noto Serif SC\", serif',\n      color: closeHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n  }\n\n  private renderFailed(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    this.renderer.drawText('庭审失败', w / 2, h * 0.3, {\n      font: 'bold 40px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a3a3a', align: 'center',\n    });\n\n    this.renderer.drawText('信誉值归零，无法继续庭审。', w / 2, h * 0.45, {\n      font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n    });\n\n    this.renderer.drawText('需要重新调查收集更多证据。', w / 2, h * 0.55, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870', align: 'center',\n    });\n  }\n\n  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n  }\n}\n","numLines":517,"startLine":1,"totalLines":517}}}
