{ ...this.relationships },\n58\t    };\n59\t  }\n60\t\n61\t  loadFromSlot(slot: SaveSlot) {\n62\t    this.chapter = slot.chapter;\n63\t    this.scene = slot.scene;\n64\t    this.flags = { ...slot.flags };\n65\t    this.evidence = [...slot.evidence];\n66\t    this.choices = { ...slot.choices };\n67\t    this.relationships = { ...slot.relationships };\n68\t    this.playTime = slot.playTime;\n69\t  }\n70\t}\n71\t"}]},"parent_tool_use_id":null,"session_id":"b5a5daaf-c8fd-4523-92be-b3ba2de361bf","uuid":"fd75e178-ac33-46a7-bd1a-0ea5f1d10198","timestamp":"2026-05-23T17:34:10.844Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/steam-ancient-mystery/src/game/GameState.ts","content":"export interface SaveSlot {\n  id: number;\n  chapter: number;\n  scene: string;\n  timestamp: number;\n  playTime: number;\n  flags: Record<string, boolean>;\n  evidence: string[];\n  choices: Record<string, string>;\n  relationships: Record<string, number>;\n}\n\nexport class GameState {\n  chapter = 1;\n  scene = 'main_menu';\n  flags: Record<string, boolean> = {};\n  evidence: string[] = [];\n  choices: Record<string, string> = {};\n  relationships: Record<string, number> = {\n    pei_ruyi: 50,\n    liu_qiniang: 50,\n    zhang_tieshou: 50,\n    facheng: 50,\n  };\n  playTime = 0;\n  settings = {\n    textSpeed: 40,\n    autoPlay: false,\n    volume: { master: 0.8, bgm: 0.7, sfx: 0.8, ambient: 0.6 },\n  };\n\n  setFlag(key: string, value: boolean) { this.flags[key] = value; }\n  getFlag(key: string): boolean { return this.flags[key] ?? false; }\n\n  addEvidence(id: string) {\n    if (!this.evidence.includes(id)) this.evidence.push(id);\n  }\n  hasEvidence(id: string): boolean { return this.evidence.includes(id); }\n\n  setChoice(key: string, value: string) { this.choices[key] = value; }\n  getChoice(key: string): string | undefined { return this.choices[key]; }\n\n  setRelationship(npc: string, delta: number) {\n    this.relationships[npc] = Math.max(0, Math.min(100, (this.relationships[npc] ?? 50) + delta));\n  }\n\n  toSaveSlot(id: number): SaveSlot {\n    return {\n      id,\n      chapter: this.chapter,\n      scene: this.scene,\n      timestamp: Date.now(),\n      playTime: this.playTime,\n      flags: { ...this.flags },\n      evidence: [...this.evidence],\n      choices: { ...this.choices },\n      relationships: { ...this.relationships },\n    };\n  }\n\n  loadFromSlot(slot: SaveSlot) {\n    this.chapter = slot.chapter;\n    this.scene = slot.scene;\n    this.flags = { ...slot.flags };\n    this.evidence = [...slot.evidence];\n    this.choices = { ...slot.choices };\n    this.relationships = { ...slot.relationships };\n    this.playTime = slot.playTime;\n  }\n}\n","numLines":71,"startLine":1,"totalLines":71}}}
