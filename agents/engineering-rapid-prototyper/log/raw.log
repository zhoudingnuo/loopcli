olorStop(0.5, `rgba(255, 150, 50, ${scene.lighting.intensity * 0.05})`);\n      grad.addColorStop(1, 'transparent');\n      ctx.fillStyle = grad;\n      ctx.fillRect(0, 0, w, h);\n    }\n\n    this.layers.forEach((l) => {\n      if (l.image) {\n        this.renderer.drawImage(l.image, l.x, l.y, undefined, undefined, l.alpha);\n      } else if (l.color && l.id !== 'bg') {\n        ctx.save();\n        ctx.globalAlpha = l.alpha;\n        ctx.fillStyle = l.color;\n        ctx.fillRect(l.x, l.y, w, h);\n        ctx.restore();\n      }\n    });\n  }\n\n  getCurrentScene(): GameScene | null { return this.currentScene; }\n  isTransitioning(): boolean { return this.transitioning; }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
{"type":"assistant","message":{"id":"msg_20260523225244776994fafc5b4139","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_eb0fecf507834236ad10f5e7","name":"Write","input":{"file_path":"D:\\game-projects\\steam-ancient-mystery\\src\\game\\DialogueEngine.ts","content":"import { GameState } from './GameState';\n\nexport interface DialogueNode {\n  id: string;\n  speaker?: string;\n  text: string;\n  portrait?: string;\n  next?: string;\n  choices?: DialogueChoice[];\n  condition?: { flag?: string; evidence?: string; choice?: string };\n  setFlags?: string[];\n  addEvidence?: string[];\n  setChoice?: { key: string; value: string };\n  effects?: { relationship?: { npc: string; delta: number } };\n}\n\nexport interface DialogueChoice {\n  text: string;\n  next: string;\n  condition?: { flag?: string; evidence?: string };\n}\n\nexport class DialogueEngine {\n  private nodes: Map<string, DialogueNode> = new Map();\n  private currentNode: DialogueNode | null = null;\n  private displayText = '';\n  private charIndex = 0;\n  private charsPerSecond = 40;\n  private isTyping = false;\n  private isActive = false;\n  private onEndCallback: (() => void) | null = null;\n\n  constructor(private state: GameState) {\n    this.charsPerSecond = state.settings.textSpeed;\n  }\n\n  loadDialogue(nodes: DialogueNode[]) {\n    this.nodes.clear();\n    nodes.forEach((n) => this.nodes.set(n.id, n));\n  }\n\n  start(nodeId: string, onEnd?: () => void): boolean {\n    const node = this.nodes.get(nodeId);\n    if (!node) return false;\n    this.currentNode = node;\n    this.isActive = true;\n    this.onEndCallback = onEnd ?? null;\n\n    if (node.condition) {\n      if (node.condition.flag && !this.state.getFlag(node.condition.flag)) return this.advance();\n      if (node.condition.evidence && !this.state.hasEvidence(node.condition.evidence)) return this.advance();\n      if (node.condition.choice && !this.state.getChoice(node.condition.choice)) return this.advance();\n    }\n\n    this.applyEffects(node);\n    this.displayText = node.text;\n    this.charIndex = 0;\n    this.isTyping = true;\n    return true;\n  }\n\n  private applyEffects(node: DialogueNode) {\n    node.setFlags?.forEach((f) => this.state.setFlag(f, true));\n    node.addEvidence?.forEach((e) => this.state.addEvidence(e));\n    if (node.setChoice) this.state.setChoice(node.setChoice.key, node.setChoice.value);\n    if (node.effects?.relationship) {\n      const r = node.effects.relationship;\n      this.state.setRelationship(r.npc, r.delta);\n    }\n  }\n\n  advance(): boolean {\n    if (!this.currentNode) return false;\n    if (this.isTyping) {\n      this.charIndex = this.displayText.length;\n      this.isTyping = false;\n      return true;\n    }\n    if (this.currentNode.choices && this.currentNode.choices.length > 0) return false;\n    if (this.currentNode.next) return this.start(this.currentNode.next, this.onEndCallback ?? undefined);\n    this.isActive = false;\n    this.currentNode = null;\n    this.onEndCallback?.();\n    return false;\n  }\n\n  selectChoice(index: number): boolean {\n    if (!this.currentNode?.choices) return false;\n    const choice = this.currentNode.choices[index];\n    if (!choice) return false;\n    if (choice.condition) {\n      if (choice.condition.flag && !this.state.getFlag(choice.condition.flag)) return false;\n      if (choice.condition.evidence && !this.state.hasEvidence(choice.condition.evidence)) return false;\n    }\n    return this.start(choice.next, this.onEndCallback ?? undefined);\n  }\n\n  update(dt: number) {\n    if (!this.isTyping || !this.currentNode) return;\n    this.charIndex += this.charsPerSecond * dt;\n    if (this.charIndex >= this.displayText.length) {\n      this.charIndex = this.displayText.length;\n      this.isTyping = false;\n    }\n  }\n\n  getDisplayText(): string { return this.displayText.substring(0, Math.floor(this.charIndex)); }\n  getSpeaker(): string | undefined { return this.currentNode?.speaker; }\n  getPortrait(): string | undefined { return this.currentNode?.portrait; }\n  getChoices(): DialogueChoice[] {\n    return this.currentNode?.choices?.filter((c) => {\n      if (!c.condition) return true;\n      if (c.condition.flag && !this.state.getFlag(c.condition.flag)) return false;\n      if (c.condition.evidence && !this.state.hasEvidence(c.condition.evidence)) return false;\n      return true;\n    }) ?? [];\n  }\n  getIsActive(): boolean { return this.isActive; }\n  getIsTyping(): boolean { return this.isTyping; }\n\n  setSpeed(charsPerSec: number) { this.charsPerSecond = charsPerSec; }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"f441f9ea-17f7-4616-a9e1-d3dddf54df7a","uuid":"b3abb89d-4346-49b0-8362-4dd8b60bc96a"}
