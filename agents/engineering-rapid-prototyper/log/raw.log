'#FFD700';ctx.font='bold 22px Arial';ctx.fillText('进入第 '+(level+1)+' 关',cx,py+145);\n    ctx.fillStyle='#AAAAAA';ctx.font='18px Arial';ctx.fillText('最高分: '+best.toLocaleString(),cx,py+180);\n    var bw=160,bh=48,bx=cx-bw/2,by2=py+ph-80;\n    ctx.fillStyle='#FFD700';this._roundRect(bx,by2,bw,bh,24);ctx.fill();ctx.fillStyle='#1A1A2E';ctx.font='bold 20px Arial';ctx.textBaseline='middle';ctx.fillText('下一关',cx,by2+bh/2);ctx.textBaseline='alphabetic';\n    ctx.restore();\n    this._nextBtn={x:bx,y:by2,w:bw,h:bh};\n  };\n\n  Renderer.prototype.addScorePopup = function(r,c,score) {\n    var l=this.layout;this.scorePopups.push({x:l.x+c*(l.cellSize+config.CELL_GAP)+l.cellSize/2,y:l.y+r*(l.cellSize+config.CELL_GAP),text:'+'+score,life:1});\n  };\n  Renderer.prototype.setComboText = function(combo) { if(combo>1) this.comboText={text:combo+'x 连击！',life:1}; };\n  Renderer.prototype.addParticles = function(r,c,type) {\n    var l=this.layout,px=l.x+c*(l.cellSize+config.CELL_GAP)+l.cellSize/2,py=l.y+r*(l.cellSize+config.CELL_GAP)+l.cellSize/2,color=config.PIECE_COLORS[type]||'#FFF';\n    for(var i=0;i<6;i++){var a=(Math.PI*2/6)*i+Math.random()*0.5;this.particles.push({x:px,y:py,vx:Math.cos(a)*(2+Math.random()*3),vy:Math.sin(a)*(2+Math.random()*3),life:1,color:color,size:3+Math.random()*3})}\n  };\n  Renderer.prototype.updateEffects = function(dt) {\n    for(var i=this.particles.length-1;i>=0;i--){var p=this.particles[i];p.x+=p.vx;p.y+=p.vy;p.vy+=0.15;p.life-=dt*2;if(p.life<=0)this.particles.splice(i,1)}\n    for(var i=this.scorePopups.length-1;i>=0;i--){var p=this.scorePopups[i];p.y-=1.5;p.life-=dt*1.5;if(p.life<=0)this.scorePopups.splice(i,1)}\n    if(this.comboText){this.comboText.life-=dt;if(this.comboText.life<=0)this.comboText=null}\n    if(this.screenShake>0)this.screenShake-=dt*10;\n  };\n  Renderer.prototype.drawEffects = function() {\n    var ctx=this.ctx;\n    if(this.screenShake>0){var s=this.screenShake*2;ctx.save();ctx.translate((Math.random()-0.5)*s,(Math.random()-0.5)*s)}\n    for(var i=0;i<this.particles.length;i++){var p=this.particles[i];ctx.globalAlpha=p.life;ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(p.x,p.y,p.size*p.life,0,Math.PI*2);ctx.fill()}\n    ctx.globalAlpha=1;\n    for(var i=0;i<this.scorePopups.length;i++){var p=this.scorePopups[i];ctx.globalAlpha=p.life;ctx.fillStyle='#FFD700';ctx.font='bold 18px Arial';ctx.textAlign='center';ctx.fillText(p.text,p.x,p.y)}\n    ctx.globalAlpha=1;\n    if(this.comboText){ctx.globalAlpha=this.comboText.life;ctx.fillStyle='#FF6348';ctx.font='bold 32px Arial';ctx.textAlign='center';\n    var dpr=(adapter.getSystemInfo().pixelRatio||1);\n    ctx.fillText(this.comboText.text,this.canvas.width/dpr/2,this.layout.y-20)}\n    ctx.globalAlpha=1;\n    if(this.screenShake>0)ctx.restore();\n  };\n  Renderer.prototype.setPieceOffset=function(r,c,dx,dy){this.pieceOffset[r+','+c]={dx:dx,dy:dy}};\n  Renderer.prototype.clearPieceOffset=function(r,c){delete this.pieceOffset[r+','+c]};\n  Renderer.prototype.setPieceScale=function(r,c,s){this.pieceScale[r+','+c]=s};\n  Renderer.prototype.clearPieceScale=function(r,c){delete this.pieceScale[r+','+c]};\n  Renderer.prototype._roundRect=function(x,y,w,h,r){var ctx=this.ctx;ctx.beginPath();ctx.moveTo(x+r,y);ctx.lineTo(x+w-r,y);ctx.quadraticCurveTo(x+w,y,x+w,y+r);ctx.lineTo(x+w,y+h-r);ctx.quadraticCurveTo(x+w,y+h,x+w-r,y+h);ctx.lineTo(x+r,y+h);ctx.quadraticCurveTo(x,y+h,x,y+h-r);ctx.lineTo(x,y+r);ctx.quadraticCurveTo(x,y,x+r,y);ctx.closePath()};\n  Renderer.prototype._darken=function(hex,f){var n=parseInt(hex.slice(1),16),r=Math.floor(((n>>16)&0xFF)*f),g=Math.floor(((n>>8)&0xFF)*f),b=Math.floor((n&0xFF)*f);return '#'+((1<<24)+(r<<16)+(g<<8)+b).toString(16).slice(1)};\n\n  module.exports = Renderer;\n});\n</script>\n<script>\n// === Main Game (inline, using the module system) ===\n(function() {\n  var adapter = require('./adapter/index');\n  var config = require('./js/config');\n  var utils = require('./js/utils');\n  var Board = require('./js/board');\n  var Renderer = require('./js/renderer');\n  var InputHandler = require('./js/input');\n  var AnimationManager = require('./js/animation');\n  var ScoreManager = require('./js/score-manager');\n\n  var easeOutQuad = utils.easeOutQuad;\n  var easeOutBounce = utils.easeOutBounce;\n\n  function calcLayout(sw, sh) {\n    var topH=config.TOP_BAR_HEIGHT, botH=config.BOTTOM_BAR_HEIGHT;\n    var availH=sh-topH-botH, availW=sw-32;\n    var gap=config.CELL_GAP;\n    var maxCW=(availW-gap*(config.GRID_SIZE-1))/config.GRID_SIZE;\n    var maxCH=(availH-gap*(config.GRID_SIZE-1)-20)/config.GRID_SIZE;\n    var cs=Math.floor(Math.min(maxCW,maxCH));\n    var bw=cs*config.GRID_SIZE+gap*(config.GRID_SIZE-1);\n    return {x:(sw-bw)/2, y:topH+(availH-bw)/2, width:bw, height:bw, cellSize:cs, topBarHeight:topH, bottomBarHeight:botH};\n  }\n\n  function Game() {\n    var si=adapter.getSystemInfo(), dpr=si.pixelRatio||1, sw=si.windowWidth, sh=si.windowHeight;\n    this.canvas=document.querySelector('canvas')||document.createElement('canvas');\n    this.canvas.width=sw*dpr; this.canvas.height=sh*dpr;\n    this.canvas.style.width=sw+'px'; this.canvas.style.height=sh+'px';\n    var ctx=this.canvas.getContext('2d'); ctx.scale(dpr,dpr);\n    this.screenW=sw; this.screenH=sh; this.dpr=dpr;\n    this.layout=calcLayout(sw,sh);\n    this.board=new Board();\n    this.renderer=new Renderer(this.canvas,this.layout);\n    this.input=new InputHandler(this.layout);\n    this.anim=new AnimationManager();\n    this.score=new ScoreManager();\n    this.state='idle';\n    this._bindEvents();\n    this._lastTime=Date.now();\n    this._loop();\n  }\n\n  Game.prototype._bindEvents = function() {\n    var self=this;\n    adapter.onTouchStart(function(e) {\n      var t=e.touches?e.touches[0]:e, x=t.clientX||t.pageX, y=t.clientY||t.pageY;\n      if(self.state==='gameover'||self.state==='levelcomplete'){self.input.handleClick(x,y);return}\n      if(self.state!=='idle')return;\n      self.input.handleTouchStart(x,y);\n