{"type":"assistant","message":{"id":"msg_20260524011926a4cd65e4d0f84d8e","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_370a19c91be14eaf9965ce18","name":"Bash","input":{"command":"cat > /tmp/refresh_session.cjs << 'ENDSCRIPT'\nconst { chromium } = require('playwright');\nconst fs = require('fs');\n(async () => {\n  const browser = await chromium.connectOverCDP('http://127.0.0.1:9222');\n  const context = browser.contexts()[0];\n  const page = await context.newPage();\n  \n  // Get open-douyin.com cookies\n  const cookies = await context.cookies(['https://developer.open-douyin.com']);\n  console.log('open-douyin cookies:', cookies.length);\n  \n  // Set cookies for microapp.bytedance.com domain\n  const microappCookies = cookies.map(c => ({\n    ...c,\n    domain: '.bytedance.com',\n    path: '/',\n  }));\n  await context.clearCookies();\n  await context.addCookies(microappCookies);\n  \n  // Visit login-check URL to get microapp.bytedance.com session\n  console.log('Visiting login-check...');\n  await page.goto('https://developer.open-douyin.com/login-check?service=https://microapp.bytedance.com/', {\n    waitUntil: 'domcontentloaded', timeout: 30000\n  });\n  await page.waitForTimeout(5000);\n  \n  console.log('URL after login-check:', page.url());\n  \n  // Get the new microapp.bytedance.com cookies\n  const newCookies = await context.cookies(['https://microapp.bytedance.com']);\n  console.log('microapp.bytedance.com cookies:', newCookies.length);\n  \n  if (newCookies.length > 0) {\n    // Write cookies to tma cookie file\n    const cookieStr = newCookies.map(c => `${c.name}=${c.value}`).join('; ');\n    fs.writeFileSync('C:/Users/Administrator/.tma-cli/.cookies', cookieStr);\n    console.log('Cookies written to tma session');\n  }\n  \n  await browser.close();\n})();\nENDSCRIPT\nNODE_PATH=\"C:/Users/Administrator/AppData/Roaming/npm/node_modules\" node /tmp/refresh_session.cjs 2>&1","description":"Refresh tma session via SSO cookie conversion","timeout":60000}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"1f456d29-d84c-44e0-89e7-7ad362d1b1bb","uuid":"a5fd03a6-81cb-4b44-92f9-8544daf0971c"}
