c)}}while(this._fm().length>0){for(var r=0;r<config.GRID_SIZE;r++)for(var c=0;c<config.GRID_SIZE;c++)this.grid[r][c]=this._rp(r,c)}};\nBoard.prototype._rp=function(r,c){var f={};if(c>=2&&this.grid[r][c-1]===this.grid[r][c-2])f[this.grid[r][c-1]]=true;if(r>=2&&this.grid[r-1]&&this.grid[r-2]&&this.grid[r-1][c]===this.grid[r-2][c])f[this.grid[r-1][c]]=true;var t;do{t=randomInt(0,config.PIECE_TYPES-1)}while(f[t]);return t};\nBoard.prototype.getPiece=function(r,c){if(r<0||r>=config.GRID_SIZE||c<0||c>=config.GRID_SIZE)return -1;return this.grid[r][c]};\nBoard.prototype.swap=function(r1,c1,r2,c2){var t=this.grid[r1][c1];this.grid[r1][c1]=this.grid[r2][c2];this.grid[r2][c2]=t};\nBoard.prototype._fm=function(){var m={};for(var r=0;r<config.GRID_SIZE;r++)for(var c=0;c<=config.GRID_SIZE-3;c++){var t=this.grid[r][c];if(t<0)continue;if(this.grid[r][c+1]===t&&this.grid[r][c+2]===t){var e=c+2;while(e+1<config.GRID_SIZE&&this.grid[r][e+1]===t)e++;for(var i=c;i<=e;i++)m[r+','+i]=true}}for(var c=0;c<config.GRID_SIZE;c++)for(var r=0;r<=config.GRID_SIZE-3;r++){var t=this.grid[r][c];if(t<0)continue;if(this.grid[r+1][c]===t&&this.grid[r+2][c]===t){var e=r+2;while(e+1<config.GRID_SIZE&&this.grid[e+1][c]===t)e++;for(var i=r;i<=e;i++)m[i+','+c]=true}}var res=[];for(var k in m){var p=k.split(',');res.push({r:parseInt(p[0]),c:parseInt(p[1])})}return res};\nBoard.prototype.findMatches=function(){return this._fm()};\nBoard.prototype.removeMatches=function(ms){var rm=[];for(var i=0;i<ms.length;i++){rm.push({r:ms[i].r,c:ms[i].c,type:this.grid[ms[i].r][ms[i].c]});this.grid[ms[i].r][ms[i].c]=-1}return rm};\nBoard.prototype.applyGravity=function(){var mv=[];for(var c=0;c<config.GRID_SIZE;c++){var wr=config.GRID_SIZE-1;for(var r=config.GRID_SIZE-1;r>=0;r--){if(this.grid[r][c]>=0){if(wr!==r){mv.push({fromR:r,fromC:c,toR:wr,toC:c});this.grid[wr][c]=this.grid[r][c];this.grid[r][c]=-1}wr--}}}return mv};\nBoard.prototype.refill=function(){var sp=[];for(var c=0;c<config.GRID_SIZE;c++){var e=0;for(var r=0;r<config.GRID_SIZE;r++)if(this.grid[r][c]<0)e++;for(var r=e-1;r>=0;r--){this.grid[r][c]=randomInt(0,config.PIECE_TYPES-1);sp.push({r:r,c:c,fromR:r-e})}}return sp};\nBoard.prototype.hasValidMoves=function(){for(var r=0;r<config.GRID_SIZE;r++)for(var c=0;c<config.GRID_SIZE;c++){if(c+1<config.GRID_SIZE){this.swap(r,c,r,c+1);if(this._fm().length>0){this.swap(r,c,r,c+1);return true}this.swap(r,c,r,c+1)}if(r+1<config.GRID_SIZE){this.swap(r,c,r+1,c);if(this._fm().length>0){this.swap(r,c,r+1,c);return true}this.swap(r,c,r+1,c)}}return false};\nBoard.prototype.shuffle=function(){var p=[];for(var r=0;r<config.GRID_SIZE;r++)for(var c=0;c<config.GRID_SIZE;c++)p.push(this.grid[r][c]);for(var i=p.length-1;i>0;i--){var j=randomInt(0,i);var t=p[i];p[i]=p[j];p[j]=t}var idx=0;for(var r=0;r<config.GRID_SIZE;r++)for(var c=0;c<config.GRID_SIZE;c++)this.grid[r][c]=p[idx++];while(this._fm().length>0){var ms=this._fm();for(var i=0;i<ms.length;i++)this.grid[ms[i].r][ms[i].c]=randomInt(0,config.PIECE_TYPES-1)}if(!this.hasValidMoves())this.shuffle()};\n\n// ScoreManager\nfunction ScoreManager(){this.score=0;this.level=1;this.movesLeft=config.INITIAL_MOVES;this.combo=0;this.bestScore=tt.getStorageSync(config.STORAGE_KEY_SCORE)||0;this.maxLevel=tt.getStorageSync(config.STORAGE_KEY_LEVEL)||1}\nScoreManager.prototype.__defineGetter__('targetScore',function(){var i=Math.min(this.level-1,config.LEVEL_TARGETS.length-1);return config.LEVEL_TARGETS[i]});\nScoreManager.prototype.addScore=function(n){var b;if(n>=5)b=config.SCORE_5_MATCH;else if(n>=4)b=config.SCORE_4_MATCH;else b=config.SCORE_3_MATCH;var m=1+this.combo*config.COMBO_MULTIPLIER,pts=Math.floor(b*m);this.score+=pts;return pts};\nScoreManager.prototype.useMove=function(){this.movesLeft--};\nScoreManager.prototype.startCombo=function(){this.combo=0};\nScoreManager.prototype.incrementCombo=function(){this.combo++;return this.combo};\nScoreManager.prototype.isLevelComplete=function(){return this.score>=this.targetScore};\nScoreManager.prototype.i