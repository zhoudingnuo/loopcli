bidden = new Set();\n    if (c >= 2 && this.grid[r][c - 1] === this.grid[r][c - 2]) {\n      forbidden.add(this.grid[r][c - 1]);\n    }\n    if (r >= 2 && this.grid[r - 1] && this.grid[r - 2] &&\n        this.grid[r - 1][c] === this.grid[r - 2][c]) {\n      forbidden.add(this.grid[r - 1][c]);\n    }\n    let type;\n    do {\n      type = randomInt(0, config.PIECE_TYPES - 1);\n    } while (forbidden.has(type));\n    return type;\n  }\n\n  getPiece(r, c) {\n    if (r < 0 || r >= config.GRID_SIZE || c < 0 || c >= config.GRID_SIZE) return -1;\n    return this.grid[r][c];\n  }\n\n  isAdjacent(r1, c1, r2, c2) {\n    return (Math.abs(r1 - r2) + Math.abs(c1 - c2)) === 1;\n  }\n\n  swap(r1, c1, r2, c2) {\n    const tmp = this.grid[r1][c1];\n    this.grid[r1][c1] = this.grid[r2][c2];\n    this.grid[r2][c2] = tmp;\n  }\n\n  _findMatches() {\n    const matches = new Set();\n\n    // Horizontal matches\n    for (let r = 0; r < config.GRID_SIZE; r++) {\n      for (let c = 0; c <= config.GRID_SIZE - 3; c++) {\n        const t = this.grid[r][c];\n        if (t < 0) continue;\n        if (this.grid[r][c + 1] === t && this.grid[r][c + 2] === t) {\n          let end = c + 2;\n          while (end + 1 < config.GRID_SIZE && this.grid[r][end + 1] === t) end++;\n          for (let i = c; i <= end; i++) matches.add(r * config.GRID_SIZE + i);\n        }\n      }\n    }\n\n    // Vertical matches\n    for (let c = 0; c < config.GRID_SIZE; c++) {\n      for (let r = 0; r <= config.GRID_SIZE - 3; r++) {\n        const t = this.grid[r][c];\n        if (t < 0) continue;\n        if (this.grid[r + 1][c] === t && this.grid[r + 2][c] === t) {\n          let end = r + 2;\n          while (end + 1 < config.GRID_SIZE && this.grid[end + 1][c] === t) end++;\n          for (let i = r; i <= end; i++) matches.add(i * config.GRID_SIZE + c);\n        }\n      }\n    }\n\n    return Array.from(matches).map(idx => ({\n      r: Math.floor(idx / config.GRID_SIZE),\n      c: idx % config.GRID_SIZE,\n    }));\n  }\n\n  findMatches() {\n    return this._findMatches();\n  }\n\n  removeMatches(matches) {\n    const removed = [];\n    for (const { r, c } of matches) {\n      removed.push({ r, c, type: this.grid[r][c] });\n      this.grid[r][c] = -1;\n    }\n    return removed;\n  }\n\n  applyGravity() {\n    const moves = [];\n    for (let c = 0; c < config.GRID_SIZE; c++) {\n      let writeRow = config.GRID_SIZE - 1;\n      for (let r = config.GRID_SIZE - 1; r >= 0; r--) {\n        if (this.grid[r][c] >= 0) {\n          if (writeRow !== r) {\n            moves.push({ fromR: r, fromC: c, toR: writeRow, toC: c });\n            this.grid[writeRow][c] = this.grid[r][c];\n            this.grid[r][c] = -1;\n          }\n          writeRow--;\n        }\n      }\n    }\n    return moves;\n  }\n\n  refill() {\n    const spawns = [];\n    for (let c = 0; c < config.GRID_SIZE; c++) {\n      let emptyCount = 0;\n      for (let r = 0; r < config.GRID_SIZE; r++) {\n        if (this.grid[r][c] < 0) emptyCount++;\n      }\n      for (let r = emptyCount - 1; r >= 0; r--) {\n        this.grid[r][c] = randomInt(0, config.PIECE_TYPES - 1);\n        spawns.push({ r, c, fromR: r - emptyCount });\n      }\n    }\n    return spawns;\n  }\n\n  hasValidMoves() {\n    for (let r = 0; r < config.GRID_SIZE; r++) {\n      for (let c = 0; c < config.GRID_SIZE; c++) {\n        // Try swap right\n        if (c + 1 < config.GRID_SIZE) {\n          this.swap(r, c, r, c + 1);\n          if (this._findMatches().length > 0) {\n            this.swap(r, c, r, c + 1);\n            return true;\n          }\n          this.swap(r, c, r, c + 1);\n        }\n        // Try swap down\n        if (r + 1 < config.GRID_SIZE) {\n          this.swap(r, c, r + 1, c);\n          if (this._findMatches().length > 0) {\n            this.swap(r, c, r + 1, c);\n            return true;\n          }\n          this.swap(r, c, r + 1, c);\n        }\n      }\n    }\n    return false;\n  }\n\n  shuffle() {\n    const pieces = [];\n    for (let r = 0; r < config.GRID_SIZE; r++) {\n      for (let c = 0; c < config.GRID_SIZE; c++) {\n        pieces.push(this.grid[r][c]);\n      }\n    }\n    for (let i = pieces.length - 1; i > 0; i--) {\n      const j = randomInt(0, i);\n      [pieces[i], pieces[j]] = [pieces[j], pieces[i]];\n    }\n    let idx = 0;\n    for (let r = 0; r < config.GRID_SIZE; r++) {\n      for (let c = 0; c < config.GRID_SIZE; c++) {\n        this.grid[r][c] = pieces[idx++];\n      }\n    }\n    // Clear accidental matches\n    while (this._findMatches().length > 0) {\n      const matches = this._findMatches();\n      for (const { r, c } of matches) {\n        this.grid[r][c] = randomInt(0, config.PIECE_TYPES - 1);\n      }\n    }\n    if (!this.hasValidMoves()) this.shuffle();\n  }\n}\n\nmodule.exports = Board;\n","numLines":204,"startLine":1,"totalLines":204}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_7532aace975549a3abff5dd3","type":"tool_result","content":"1\t/**\n2\t * Touch/mouse input handler.\n3\t */\n4\t\n5\tconst config = require('./config');\n6\t\n7\tclass InputHandler {\n8\t  constructor(layout) {\n9\t    this.layout = layout;\n10\t    this.onSelect = null;\n11\t    this.onSwap = null;\n12\t    this.onBtnClick = null;\n13\t\n14\t    this._touchStartPos = null;\n15\t    this._selectedCell = null;\n16\t  }\n17\t\n18\t  handleTouchStart(x, y) {\n19\t    this._touchStartPos = { x, y };\n20\t    const cell = this._pixelToCell(x, y);\n21\t    if (cell) {\n22\t      if (this._selectedCell) {\n23\t        const { r: r1, c: c1 } = this._selectedCell;\n24\t        const { r: r2, c: c2 } = cell;\n25\t        if (r1 === r2 && c1 === c2) {\n26\t          // Deselect\n27\t          this._selectedCell = null;\n28\t          if (this.onSelect) this.onSelect(null);\n29\t        } else if (this._isAdjacent(r1, c1, r2, c2)) {\n30\t          // Swap\n31\t          if (this.onSwap) this.onSwap(r1, c1, r2, c2);\n32\t          this._selectedCell = null;\n33\t          if (this.onSelect) this.onSelect(null);\n34\t        } else {\n35\t          // Select new\n36\t          this._selectedCell = cell;\n37\t          if (this.onSelect) this.onSelect(cell);\n38\t        }\n39\t      } else {\n40\t        this._selectedCell = cell;\n41\t        if (this.onSelect) this.onSelect(cell);\n42\t      }\n43\t    }\n44\t  }\n45\t\n46\t  handleTouchMove(x, y) {\n47\t    if (!this._touchStartPos || !this._selectedCell) return;\n48\t    const dx = x - this._touchStartPos.x;\n49\t    const dy = y - this._touchStartPos.y;\n50\t    const dist = Math.sqrt(dx * dx + dy * dy);\n51\t    if (dist >= config.SWIPE_THRESHOLD) {\n52\t      let dr = 0, dc = 0;\n53\t      if (Math.abs(dx) > Math.abs(dy)) {\n54\t        dc = dx > 0 ? 1 : -1;\n55\t      } else {\n56\t        dr = dy > 0 ? 1 : -1;\n57\t      }\n58\t      const r2 = this._selectedCell.r + dr;\n59\t      const c2 = this._selectedCell.c + dc;\n60\t      if (r2 >= 0 && r2 < config.GRID_SIZE && c2 >= 0 && c2 < config.GRID_SIZE) {\n61\t        if (this.onSwap) this.onSwap(this._selectedCell.r, this._selectedCell.c, r2, c2);\n62\t        this._selectedCell = null;\n63\t        this._touchStartPos = null;\n64\t        if (this.onSelect) this.onSelect(null);\n65\t      }\n66\t    }\n67\t  }\n68\t\n69\t  handleTouchEnd() {\n70\t    this._touchStartPos = null;\n71\t  }\n72\t\n73\t  handleClick(x, y) {\n74\t    if (this.onBtnClick) this.onBtnClick(x, y);\n75\t  }\n76\t\n77\t  _pixelToCell(px, py) {\n78\t    const { x, y, cellSize } = this.layout;\n79\t    const c = Math.floor((px - x) / (cellSize + config.CELL_GAP));\n80\t    const r = Math.floor((py - y) / (cellSize + config.CELL_GAP));\n81\t    if (r < 0 || r >= config.GRID_SIZE || c < 0 || c >= config.GRID_SIZE) return null;\n82\t    // Check within cell bounds (not in the gap)\n83\t    const cellX = x + c * (cellSize + config.CELL_GAP);\n84\t    const cellY = y + r * (cellSize + config.CELL_GAP);\n85\t    if (px >= cellX && px <= cellX + cellSize && py >= cellY && py <= cellY + cellSize) {\n86\t      return { r, c };\n87\t    }\n88\t    return null;\n89\t  }\n90\t\n91\t  _isAdjacent(r1, c1, r2, c2) {\n92\t    return (Math.abs(r1 - r2) + Math.abs(c1 - c2)) === 1;\n93\t  }\n94\t\n95\t  reset() {\n96\t    this._selectedCell = null;\n97\t    this._touchStartPos = null;\n98\t  }\n99\t}\n100\t\n101\tmodule.exports = InputHandler;\n102\t"}]},"parent_tool_use_id":null,"session_id":"b40e9963-6d9c-4ef1-96a5-70dd29359e7e","uuid":"1e5bf4b0-9966-49ff-9546-df3f9dadf2d9","timestamp":"2026-05-23T18:21:39.558Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\games\\match3-xiaoxiaoxiao\\js\\input.js","content":"/**\n * Touch/mouse input handler.\n */\n\nconst config = require('./config');\n\nclass InputHandler {\n  constructor(layout) {\n    this.layout = layout;\n    this.onSelect = null;\n    this.onSwap = null;\n    this.onBtnClick = null;\n\n    this._touchStartPos = null;\n    this._selectedCell = null;\n  }\n\n  handleTouchStart(x, y) {\n    this._touchStartPos = { x, y };\n    const cell = this._pixelToCell(x, y);\n    if (cell) {\n      if (this._selectedCell) {\n        const { r: r1, c: c1 } = this._selectedCell;\n        const { r: r2, c: c2 } = cell;\n        if (r1 === r2 && c1 === c2) {\n          // Deselect\n          this._selectedCell = null;\n          if (this.onSelect) this.onSelect(null);\n        } else if (this._isAdjacent(r1, c1, r2, c2)) {\n          // Swap\n          if (this.onSwap) this.onSwap(r1, c1, r2, c2);\n          this._selectedCell = null;\n          if (this.onSelect) this.onSelect(null);\n        } else {\n          // Select new\n          this._selectedCell = cell;\n          if (this.onSelect) this.onSelect(cell);\n        }\n      } else {\n        this._selectedCell = cell;\n        if (this.onSelect) this.onSelect(cell);\n      }\n    }\n  }\n\n  handleTouchMove(x, y) {\n    if (!this._touchStartPos || !this._selectedCell) return;\n    const dx = x - this._touchStartPos.x;\n    const dy = y - this._touchStartPos.y;\n    const dist = Math.sqrt(dx * dx + dy * dy);\n    if (dist >= config.SWIPE_THRESHOLD) {\n      let dr = 0, dc = 0;\n      if (Math.abs(dx) > Math.abs(dy)) {\n        dc = dx > 0 ? 1 : -1;\n      } else {\n        dr = dy > 0 ? 1 : -1;\n      }\n      const r2 = this._selectedCell.r + dr;\n      const c2 = this._selectedCell.c + dc;\n      if (r2 >= 0 && r2 < config.GRID_SIZE && c2 >= 0 && c2 < config.GRID_SIZE) {\n        if (this.onSwap) this.onSwap(this._selectedCell.r, this._selectedCell.c, r2, c2);\n        this._selectedCell = null;\n        this._touchStartPos = null;\n        if (this.onSelect) this.onSelect(null);\n      }\n    }\n  }\n\n  handleTouchEnd() {\n    this._touchStartPos = null;\n  }\n\n  handleClick(x, y) {\n    if (this.onBtnClick) this.onBtnClick(x, y);\n  }\n\n  _pixelToCell(px, py) {\n    const { x, y, cellSize } = this.layout;\n    const c = Math.floor((px - x) / (cellSize + config.CELL_GAP));\n    const r = Math.floor((py - y) / (cellSize + config.CELL_GAP));\n    if (r < 0 || r >= config.GRID_SIZE || c < 0 || c >= config.GRID_SIZE) return null;\n    // Check within cell bounds (not in the gap)\n    const cellX = x + c * (cellSize + config.CELL_GAP);\n    const cellY = y + r * (cellSize + config.CELL_GAP);\n    if (px >= cellX && px <= cellX + cellSize && py >= cellY && py <= cellY + cellSize) {\n      return { r, c };\n    }\n    return null;\n  }\n\n  _isAdjacent(r1, c1, r2, c2) {\n    return (Math.abs(r1 - r2) + Math.abs(c1 - c2)) === 1;\n  }\n\n  reset() {\n    this._selectedCell = null;\n    this._touchStartPos = null;\n  }\n}\n\nmodule.exports = InputHandler;\n","numLines":102,"startLine":1,"totalLines":102}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_9c3864415cda4e09b6329380","type":"tool_result","content":"1\tvar config = {\n2\t  GRID_SIZE: 8, PIECE_TYPES: 6,\n3\t  PIECE_COLORS: ['#FF4757','#3742FA','#2ED573','#FFA502','#A55EEA','#FF6B81'],\n4\t  PIECE_GLOW: ['#FF6B81','#5352ED','#7BED9F','#FFD32A','#D980FA','#FF9FF3'],\n5\t  PIECE_SHAPES: ['circle','diamond','square','triangle','star','hexagon'],\n6\t  BOARD_PADDING: 8, BOARD_BORDER_RADIUS: 12, CELL_GAP: 4,\n7\t  BG_COLOR: '#1A1A2E', BOARD_BG: '#16213E', CELL_BG: '#0F3460',\n8\t  SELECTED_COLOR: '#ECCC68', HINT_COLOR: 'rgba(255,255,255,0.3)',\n9\t  TOP_BAR_HEIGHT: 100, BOTTOM_BAR_HEIGHT: 80,\n10\t  INITIAL_MOVES: 30,\n11\t  LEVEL_TARGETS: [3000,5000,8000,12000,18000,25000,35000,50000],\n12\t  SCORE_3_MATCH: 100, SCORE_4_MATCH: 250, SCORE_5_MATCH: 500, COMBO_MULTIPLIER: 0.5,\n13\t  STORAGE_KEY_SCORE: 'x4_high_score', STORAGE_KEY_LEVEL: 'x4_max_level',\n14\t  SWIPE_THRESHOLD: 20,\n15\t};\n16\t\n17\tfunction lerp(a,b,t){return a+(b-a)*t}\n18\tfunction easeOutBounce(t){if(t<1/2.75)return 7.5625*t*t;if(t<2/2.75)return 7.5625*(t-=1.5/2.75)*t+0.75;if(t<2.5/2.75)return 7.5625*(t-=2.25/2.75)*t+0.9375;return 7.5625*(t-=2.625/2.75)*t+0.984375}\n19\tfunction easeOutQuad(t){return 1-(1-t)*(1-t)}\n20\tfunction randomInt(min,max){return Math.floor(Math.random()*(max-min+1))+min}\n21\tfunction clamp(val,min,max){return Math.max(min,Math.min(max,val))}\n22\t\n23\t// Board\n24\tfunction Board(){this.grid=[];this.init()}\n25\tBoard.prototype.init=function(){this.grid=[];for(var r=0;r<config.GRID_SIZE;r++){this.grid[r]=[];for(var c=0;c<config.GRID_SIZE;c++){this.grid[r][c]=this._rp(r,c)}}while(this._fm().length>0){for(var r=0;r<config.GRID_SIZE;r++)for(var c=0;c<config.GRID_SIZE;c++)this.grid[r][c]=this._rp(r,c)}};\n26\tBoard.prototype._rp=function(r,c){var f={};if(c>=2&&this.grid[r][c-1]===this.grid[r][c-2])f[this.grid[r][c-1]]=true;if(r>=2&&this.grid[r-1]&&this.grid[r-2]&&this.grid[r-1][c]===this.grid[r-2][c])f[this.grid[r-1][c]]=true;var t;do{t=randomInt(0,config.PIECE_TYPES-1)}while(f[t]);return t};\n27\tBoard.prototype.getPiece=function(r,c){if(r<0||r>=config.GRID_SIZE||c<0||c>=config.GRID_SIZE)return -1;return this.grid[r][c]};\n28\tBoard.prototype.swap=function(r1,c1,r2,c2){var t=this.grid[r1][c1];this.grid[r1][c1]=this.grid[r2][c2];this.grid[r2][c2]=t};\n29\tBoard.prototype._fm=function(){var m={};for(var r=0;r<config.GRID_SIZE;r++)for(var c=0;c<=config.GRID_SIZE-3;c++){var t=this.grid[r][c];if(t<0)continue;if(this.grid[r][c+1]===t&&this.grid[r][c+2]===t){var e=c+2;while(e+1<config.GRID_SIZE&&this.grid[r][e+1]===t)e++;for(var i=c;i<=e;i++)m[r+','+i]=true}}for(var c=0;c<config.GRID_SIZE;c++)for(var r=0;r<=config.GRID_SIZE-3;r++){var t=this.grid[r][c];if(t<0)continue;if(this.grid[r+1][c]===t&&this.grid[r+2][c]===t){var e=r+2;while(e+1<config.GRID_SIZE&&this.grid[e+1][c]===t)e++;for(var i=r;i<=e;i++)m[i+','+c]=true}}var res=[];for(var k in m){var p=k.split(',');res.push({r:parseInt(p[0]),c:parseInt(p[1])})}return res};\n30\tBoard.prototype.findMatches=function(){return this._fm()};\n31\tBoard.prototype.removeMatches=function(ms){var rm=[];for(var i=0;i<ms.length;i++){rm.push({r:ms[i].r,c:ms[i].c,type:this.grid[ms[i].r][ms[i].c]});this.grid[ms[i].r][ms[i].c]=-1}return rm};\n32\tBoard.prototype.applyGravity=function(){var mv=[];for(var c=0;c<config.GRID_SIZE;c++){var wr=config.GRID_SIZE-1;for(var r=config.GRID_SIZE-1;r>=0;r--){if(this.grid[r][c]>=0){if(wr!==r){mv.push({fromR:r,fromC:c,toR:wr,toC:c});this.grid[wr][c]=this.grid[r][c];this.grid[r][c]=-1}wr--}}}return mv};\n33\tBoard.prototype.refill=function(){var sp=[];for(var c=0;c<config.GRID_SIZE;c++){var e=0;for(var r=0;r<config.GRID_SIZE;r++)if(this.grid[r][c]<0)e++;for(var r=e-1;r>=0;r--){this.grid[r][c]=randomInt(0,config.PIECE_TYPES-1);sp.push({r:r,c:c,fromR:r-e})}}return sp};\n34\tBoard.prototype.hasValidMoves=function(){for(var r=0;r<config.GRID_SIZE;r++)for(var c=0;c<config.GRID_SIZE;c++){if(c+1<config.GRID_SIZE){this.swap(r,c,r,c+1);if(this._fm().length>0){this.swap(r,c,r,c+1);return true}this.swap(r,c,r,c+1)}if(r+1<config.GRID_SIZE){this.swap(r,c,r+1,c);if(this._fm().length>0){this.swap(r,c,r+1,c);return true}this.swap(r,c,r+1,c)}}return false};\n35\tBoard.prototype.shuffle=function(){var p=[];for(var r=0;r<config.GRID_SIZE;r++)for(var c=0;c<config.GRID_SIZE;c++)p.push(this.grid[r][c]);for(var i=p.length-1;i>0;i--){var j=randomInt(0,i);var t=p[i];p[i]=p[j];p[j]=t}var idx=0;for(var r=0;r<config.GRID_SIZE;r++)for(var c=0;c<config.GRID_SIZE;c++)this.grid[r][c]=p[idx++];while(this._fm().length>0){var ms=this._fm();for(var i=0;i<ms.length;i++)this.grid[ms[i].r][ms[i].c]=randomInt(0,config.PIECE_TYPES-1)}if(!this.hasValidMoves())this.shuffle()};\n36\t\n37\t// ScoreManager\n38\tfunction ScoreManager(){this.score=0;this.level=1;this.movesLeft=config.INITIAL_MOVES;this.combo=0;this.bestScore=tt.getStorageSync(config.STORAGE_KEY_SCORE)||0;this.maxLevel=tt.getStorageSync(config.STORAGE_KEY_LEVEL)||1}\n39\tScoreManager.prototype.__defineGetter__('targetScore',function(){var i=Math.min(this.level-1,config.LEVEL_TARGETS.length-1);return config.LEVEL_TARGETS[i]});\n40\tScoreManager.prototype.addScore=function(n){var b;if(n>=5)b=config.SCORE_5_MATCH;else if(n>=4)b=config.SCORE_4_MATCH;else b=config.SCORE_3_MATCH;var m=1+this.combo*config.COMBO_MULTIPLIER,pts=Math.floor(b*m);this.score+=pts;return pts};\n41\tScoreManager.prototype.useMove=function(){this.movesLeft--};\n42\tScoreManager.prototype.startCombo=function(){this.combo=0};\n43\tScoreManager.prototype.incrementCombo=function(){this.combo++;return this.combo};\n44\tScoreManager.prototype.isLevelComplete=function(){return this.score>=this.targetScore};\n45\tScoreManager.prototype.isGameOver=function(){return this.movesLeft<=0&&!this.isLevelComplete()};\n46\tScoreManager.prototype.nextLevel=function(){this.level++;this.movesLeft=config.INITIAL_MOVES;this.combo=0;if(this.level>this.maxLevel){this.maxLevel=this.level;tt.setStorageSync(config.STORAGE_KEY_LEVEL,this.maxLevel)}};\n47\tScoreManager.prototype.reset=function(){this.score=0;this.level=1;this.movesLeft=config.INITIAL_MOVES;this.combo=0};\n48\tScoreManager.prototype.saveBest=function(){if(this.score>this.bestScore){this.bestScore=this.score;tt.setStorageSync(config.STORAGE_KEY_SCORE,this.bestScore)}};\n49\t\n50\t// Animation\n51\tfunction Animation(dur,fn,done){this.duration=dur;this.fn=fn;this.doneFn=done;this.elapsed=0;this.done=false}\n52\tAnimation.prototype.update=function(dt){if(this.done)return;this.elapsed+=dt;var t=Math.min(this.elapsed/this.duration,1);this.fn(t);if(t>=1){this.done=true;if(this.doneFn)this.doneFn()}};\n53\tfunction AnimMgr(){this.list=[]}\n54\tAnimMgr.prototype.add=function(d,u,c){var a=new Animation(d,u,c);this.list.push(a);return a};\n55\tAnimMgr.prototype.update=function(dt){for(var i=this.list.length-1;i>=0;i--){this.list[i].update(dt);if(this.list[i].done)this.list.splice(i,1)}};\n56\tAnimMgr.prototype.clear=function(){this.list=[]};\n57\t\n58\t// Input\n59\tfunction InputHandler(layout){this.layout=layout;this.onSelect=null;this.onSwap=null;this.onBtnClick=null;this._start=null;this._sel=null}\n60\tInputHandler.prototype.handleTouchStart=function(x,y){this._start={x:x,y:y};var cell=this._p2c(x,y);if(cell){if(this._sel){var r1=this._sel.r,c1=this._sel.c,r2=cell.r,c2=cell.c;if(r1===r2&&c1===c2){this._sel=null;if(this.onSelect)this.onSelect(null)}else if(Math.abs(r1-r2)+Math.abs(c1-c2)===1){if(this.onSwap)this.onSwap(r1,c1,r2,c2);this._sel=null;if(this.onSelect)this.onSelect(null)}else{this._sel=cell;if(this.onSelect)this.onSelect(cell)}}else{this._sel=cell;if(this.onSelect)this.onSelect(cell)}}};\n61\tInputHandler.prototype.handleTouchMove=function(x,y){if(!this._start||!this._sel)return;var dx=x-this._start.x,dy=y-this._start.y,d=Math.sqrt(dx*dx+dy*dy);if(d>=config.SWIPE_THRESHOLD){var dr=0,dc=0;if(Math.abs(dx)>Math.abs(dy))dc=dx>0?1:-1;else dr=dy>0?1:-1;var r2=this._sel.r+dr,c2=this._sel.c+dc;if(r2>=0&&r2<config.GRID_SIZE&&c2>=0&&c2<config.GRID_SIZE){if(this.onSwap)this.onSwap(this._sel.r,this._sel.c,r2,c2);this._sel=null;this._start=null;if(this.onSelect)this.onSelect(null)}}};\n62\tInputHandler.prototype.handleTouchEnd=function(){this._start=null};\n63\tInputHandler.prototype.handleClick=function(x,y){if(this.onBtnClick)this.onBtnClick(x,y)};\n64\tInputHandler.prototype._p2c=function(px,py){var x=this.layout.x,y=this.layout.y,cs=this.layout.cellSize,gap=config.CELL_GAP;var c=Math.floor((px-x)/(cs+gap)),r=Math.floor((py-y)/(cs+gap));if(r<0||r>=config.GRID_SIZE||c<0||c>=config.GRID_SIZE)return null;var cx2=x+c*(cs+gap),cy2=y+r*(cs+gap);if(px>=cx2&&px<=cx2+cs&&py>=cy2&&py<=cy2+cs)return{r:r,c:c};return null};\n65\tInputHandler.prototype.reset=function(){this._sel=null;this._start=null};\n66\t\n67\t// Renderer\n68\tfunction Renderer(ctx,layout){this.ctx=ctx;this.layout=layout;this.pieceScale={};this.pieceOffset={};this.selectedCell=null;this.particles=[];this.comboText=null;this.scorePopups=[];this.screenShake=0;this._restartBtn=null;this._retryBtn=null;this._nextBtn=null;this.sw=0;this.sh=0}\n69\tRenderer.prototype.clear=function(){this.ctx.clearRect(0,0,this.sw,this.sh)};\n70\tRenderer.prototype.drawBackground=function(){this.ctx.fillStyle=config.BG_COLOR;this.ctx.fillRect(0,0,this.sw,this.sh)};\n71\tRenderer.prototype.drawBoard=function(){var ctx=this.ctx,l=this.layout;ctx.fillStyle=config.BOARD_BG;this._rr(l.x-config.BOARD_PADDING,l.y-config.BOARD_PADDING,l.width+config.BOARD_PADDING*2,l.height+config.BOARD_PADDING*2,config.BOARD_BORDER_RADIUS);ctx.fill();for(var r=0;r<config.GRID_SIZE;r++)for(var c=0;c<config.GRID_SIZE;c++){var cx=l.x+c*(l.cellSize+config.CELL_GAP),cy=l.y+r*(l.cellSize+config.CELL_GAP);ctx.fillStyle=config.CELL_BG;this._rr(cx,cy,l.cellSize,l.cellSize,6);ctx.fill()}};\n72\tRenderer.prototype.drawPieces=function(board){var ctx=this.ctx,l=this.layout;for(var r=0;r<config.GRID_SIZE;r++)for(var c=0;c<config.GRID_SIZE;c++){var type=board.getPiece(r,c);if(type<0)continue;var px=l.x+c*(l.cellSize+config.CELL_GAP)+l.cellSize/2;var py=l.y+r*(l.cellSize+config.CELL_GAP)+l.cellSize/2;var key=r+','+c,off=this.pieceOffset[key];if(off){px+=off.dx;py+=off.dy}var scale=this.pieceScale[key]||1,radius=(l.cellSize/2-4)*scale;if(radius<=0)continue;this._drawPiece(ctx,px,py,radius,type);if(this.selectedCell&&this.selectedCell.r===r&&this.selectedCell.c===c){ctx.strokeStyle=config.SELECTED_COLOR;ctx.lineWidth=3;ctx.beginPath();ctx.arc(px,py,radius+2,0,Math.PI*2);ctx.stroke();var pulse=0.5+0.5*Math.sin(Date.now()/150);ctx.strokeStyle='rgba(236,204,104,'+(pulse*0.5)+')';ctx.lineWidth=2;ctx.beginPath();ctx.arc(px,py,radius+5,0,Math.PI*2);ctx.stroke()}}};\n73\tRenderer.prototype._drawPiece=function(ctx,px,py,radius,type){var color=config.PIECE_COLORS[type],glow=config.PIECE_GLOW[type],shape=config.PIECE_SHAPES[type];ctx.fillStyle='rgba(0,0,0,0.2)';ctx.beginPath();ctx.arc(px+2,py+2,radius,0,Math.PI*2);ctx.fill();var grad=ctx.createRadialGradient(px-radius*0.3,py-radius*0.3,0,px,py,radius);grad.addColorStop(0,glow);grad.addColorStop(0.7,color);grad.addColorStop(1,this._dk(color,0.7));ctx.fillStyle=grad;ctx.beginPath();switch(shape){case 'circle':ctx.arc(px,py,radius,0,Math.PI*2);break;case 'diamond':ctx.moveTo(px,py-radius);ctx.lineTo(px+radius,py);ctx.lineTo(px,py+radius);ctx.lineTo(px-radius,py);break;case 'square':var s=radius*0.8;this._rr(px-s,py-s,s*2,s*2,4);break;case 'triangle':ctx.moveTo(px,py-radius);ctx.lineTo(px+radius*0.87,py+radius*0.5);ctx.lineTo(px-radius*0.87,py+radius*0.5);break;case 'star':this._star(ctx,px,py,5,radius,radius*0.5);break;case 'hexagon':this._poly(ctx,px,py,radius,6);break}ctx.fill();ctx.fillStyle='rgba(255,255,255,0.3)';ctx.beginPath();ctx.ellipse(px-radius*0.2,py-radius*0.3,radius*0.4,radius*0.25,-0.3,0,Math.PI*2);ctx.fill()};\n74\tRenderer.prototype._star=function(ctx,cx,cy,pts,oR,iR){ctx.beginPath();for(var i=0;i<pts*2;i++){var r=i%2===0?oR:iR,a=(Math.PI/pts)*i-Math.PI/2,x=cx+Math.cos(a)*r,y=cy+Math.sin(a)*r;if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y)}ctx.closePath()};\n75\tRenderer.prototype._poly=function(ctx,cx,cy,r,sides){ctx.beginPath();for(var i=0;i<sides;i++){var a=(Math.PI*2/sides)*i-Math.PI/2,x=cx+Math.cos(a)*r,y=cy+Math.sin(a)*r;if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y)}ctx.closePath()};\n76\tRenderer.prototype.drawTopBar=function(score,level,movesLeft,target){var ctx=this.ctx,w=this.sw;ctx.fillStyle='rgba(22,33,62,0.9)';ctx.fillRect(0,0,w,this.layout.topBarHeight);ctx.fillStyle='#FFF';ctx.font='bold 20px Arial';ctx.textAlign='left';ctx.fillText('分数',16,30);ctx.font='bold 28px Arial';ctx.fillStyle='#FFD700';ctx.fillText(score.toLocaleString(),16,62);ctx.fillStyle='#FFF';ctx.font='bold 18px Arial';ctx.textAlign='center';ctx.fillText('第 '+level+' 关',w/2,30);var pw=w*0.5,ph=12,ppx=(w-pw)/2,ppy=42;ctx.fillStyle='rgba(255,255,255,0.15)';this._rr(ppx,ppy,pw,ph,6);ctx.fill();var prog=Math.min(score/target,1);if(prog>0){var pg=ctx.createLinearGradient(ppx,0,ppx+pw,0);pg.addColorStop(0,'#FFD700');pg.addColorStop(1,'#FF6348');ctx.fillStyle=pg;this._rr(ppx,ppy,pw*prog,ph,6);ctx.fill()}ctx.fillStyle='#FFF';ctx.font='bold 18px Arial';ctx.textAlign='right';ctx.fillText('剩余步数',w-16,30);ctx.font='bold 28px Arial';ctx.fillStyle=movesLeft<=5?'#FF4757':'#2ED573';ctx.fillText(movesLeft.toString(),w-16,62)};\n77\tRenderer.prototype.drawBottomBar=function(){var ctx=this.ctx,w=this.sw;var barY=this.sh-this.layout.bottomBarHeight;ctx.fillStyle='rgba(22,33,62,0.9)';ctx.fillRect(0,barY,w,this.layout.bottomBarHeight);var btnW=140,btnH=44,btnX=(w-btnW)/2,btnY=barY+(this.layout.bottomBarHeight-btnH)/2;ctx.fillStyle='#FF6348';this._rr(btnX,btnY,btnW,btnH,22);ctx.fill();ctx.fillStyle='#FFF';ctx.font='bold 18px Arial';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('重新开始',w/2,btnY+btnH/2);ctx.textBaseline='alphabetic';this._restartBtn={x:btnX,y:btnY,w:btnW,h:btnH}};\n78\tRenderer.prototype.drawGameOver=function(score,level,best){var ctx=this.ctx,w=this.sw,h=this.sh;ctx.fillStyle='rgba(0,0,0,0.75)';ctx.fillRect(0,0,w,h);var cx=w/2,cy=h/2,pw=w*0.8,ph=320,px=cx-pw/2,py=cy-ph/2;ctx.fillStyle='#16213E';this._rr(px,py,pw,ph,20);ctx.fill();ctx.strokeStyle='#FFD700';ctx.lineWidth=2;this._rr(px,py,pw,ph,20);ctx.stroke();ctx.textAlign='center';ctx.fillStyle='#FFD700';ctx.font='bold 30px Arial';ctx.fillText('游戏结束',cx,py+50);ctx.fillStyle='#FFF';ctx.font='20px Arial';ctx.fillText('得分: '+score.toLocaleString(),cx,py+100);ctx.fillStyle='#AAA';ctx.font='18px Arial';ctx.fillText('第 '+level+' 关',cx,py+135);ctx.fillText('最高分: '+best.toLocaleString(),cx,py+165);var bw=160,bh=48,bx=cx-bw/2,by2=py+ph-80;ctx.fillStyle='#2ED573';this._rr(bx,by2,bw,bh,24);ctx.fill();ctx.fillStyle='#FFF';ctx.font='bold 20px Arial';ctx.textBaseline='middle';ctx.fillText('再来一局',cx,by2+bh/2);ctx.textBaseline='alphabetic';this._retryBtn={x:bx,y:by2,w:bw,h:bh}};\n79\tRenderer.prototype.drawLevelComplete=function(score,level,best){var ctx=this.ctx,w=this.sw,h=this.sh;ctx.fillStyle='rgba(0,0,0,0.75)';ctx.fillRect(0,0,w,h);var cx=w/2,cy=h/2,pw=w*0.8,ph=320,px=cx-pw/2,py=cy-ph/2;ctx.fillStyle='#16213E';this._rr(px,py,pw,ph,20);ctx.fill();ctx.strokeStyle='#2ED573';ctx.lineWidth=2;this._rr(px,py,pw,ph,20);ctx.stroke();ctx.textAlign='center';ctx.fillStyle='#2ED573';ctx.font='bold 30px Arial';ctx.fillText('过关！',cx,py+50);ctx.fillStyle='#FFF';ctx.font='20px Arial';ctx.fillText('得分: '+score.toLocaleString(),cx,py+100);ctx.fillStyle='#FFD700';ctx.font='bold 22px Arial';ctx.fillText('进入第 '+(level+1)+' 关',cx,py+145);ctx.fillStyle='#AAA';ctx.font='18px Arial';ctx.fillText('最高分: '+best.toLocaleString(),cx,py+180);var bw=160,bh=48,bx=cx-bw/2,by2=py+ph-80;ctx.fillStyle='#FFD700';this._rr(bx,by2,bw,bh,24);ctx.fill();ctx.fillStyle='#1A1A2E';ctx.font='bold 20px Arial';ctx.textBaseline='middle';ctx.fillText('下一关',cx,by2+bh/2);ctx.textBaseline='alphabetic';this._nextBtn={x:bx,y:by2,w:bw,h:bh}};\n80\tRenderer.prototype.addScorePopup=function(r,c,sc){var l=this.layout;this.scorePopups.push({x:l.x+c*(l.cellSize+config.CELL_GAP)+l.cellSize/2,y:l.y+r*(l.cellSize+config.CELL_GAP),text:'+'+sc,life:1})};\n81\tRenderer.prototype.setComboText=function(combo){if(combo>1)this.comboText={text:combo+'x 连击！',life:1}};\n82\tRenderer.prototype.addParticles=function(r,c,type){var l=this.layout,px=l.x+c*(l.cellSize+config.CELL_GAP)+l.cellSize/2,py=l.y+r*(l.cellSize+config.CELL_GAP)+l.cellSize/2,color=config.PIECE_COLORS[type]||'#FFF';for(var i=0;i<6;i++){var a=(Math.PI*2/6)*i+Math.random()*0.5;this.particles.push({x:px,y:py,vx:Math.cos(a)*(2+Math.random()*3),vy:Math.sin(a)*(2+Math.random()*3),life:1,color:color,size:3+Math.random()*3})}};\n83\tRenderer.prototype.updateEffects=function(dt){for(var i=this.particles.length-1;i>=0;i--){var p=this.particles[i];p.x+=p.vx;p.y+=p.vy;p.vy+=0.15;p.life-=dt*2;if(p.life<=0)this.particles.splice(i,1)}for(var i=this.scorePopups.length-1;i>=0;i--){var p=this.scorePopups[i];p.y-=1.5;p.life-=dt*1.5;if(p.life<=0)this.scorePopups.splice(i,1)}if(this.comboText){this.comboText.life-=dt;if(this.comboText.life<=0)this.comboText=null}if(this.screenShake>0)this.screenShake-=dt*10};\n84\tRenderer.prototype.drawEffects=function(){var ctx=this.ctx;if(this.screenShake>0){var s=this.screenShake*2;ctx.save();ctx.translate((Math.random()-0.5)*s,(Math.random()-0.5)*s)}for(var i=0;i<this.particles.length;i++){var p=this.particles[i];ctx.globalAlpha=p.life;ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(p.x,p.y,p.size*p.life,0,Math.PI*2);ctx.fill()}ctx.globalAlpha=1;for(var i=0;i<this.scorePopups.length;i++){var p=this.scorePopups[i];ctx.globalAlpha=p.life;ctx.fillStyle='#FFD700';ctx.font='bold 18px Arial';ctx.textAlign='center';ctx.fillText(p.text,p.x,p.y)}ctx.globalAlpha=1;if(this.comboText){ctx.globalAlpha=this.comboText.life;ctx.fillStyle='#FF6348';ctx.font='bold 32px Arial';ctx.textAlign='center';ctx.fillText(this.comboText.text,this.sw/2,this.layout.y-20)}ctx.globalAlpha=1;if(this.screenShake>0)ctx.restore()};\n85\tRenderer.prototype.setPieceOffset=function(r,c,dx,dy){this.pieceOffset[r+','+c]={dx:dx,dy:dy}};\n86\tRenderer.prototype.clearPieceOffset=function(r,c){delete this.pieceOffset[r+','+c]};\n87\tRenderer.prototype.setPieceScale=function(r,c,s){this.pieceScale[r+','+c]=s};\n88\tRenderer.prototype.clearPieceScale=function(r,c){delete this.pieceScale[r+','+c]};\n89\tRenderer.prototype._rr=function(x,y,w,h,r){var ctx=this.ctx;ctx.beginPath();ctx.moveTo(x+r,y);ctx.lineTo(x+w-r,y);ctx.quadraticCurveTo(x+w,y,x+w,y+r);ctx.lineTo(x+w,y+h-r);ctx.quadraticCurveTo(x+w,y+h,x+w-r,y+h);ctx.lineTo(x+r,y+h);ctx.quadraticCurveTo(x,y+h,x,y+h-r);ctx.lineTo(x,y+r);ctx.quadraticCurveTo(x,y,x+r,y);ctx.closePath()};\n90\tRenderer.prototype._dk=function(hex,f){var n=parseInt(hex.slice(1),16),r=Math.floor(((n>>16)&0xFF)*f),g=Math.floor(((n>>8)&0xFF)*f),b=Math.floor((n&0xFF)*f);return '#'+((1<<24)+(r<<16)+(g<<8)+b).toString(16).slice(1)};\n91\t\n92\t// --- Page ---\n93\tfunction calcLayout(sw, sh) {\n94\t  var topH=config.TOP_BAR_HEIGHT, botH=config.BOTTOM_BAR_HEIGHT;\n95\t  var availH=sh-topH-botH, availW=sw-32;\n96\t  var gap=config.CELL_GAP;\n97\t  var maxCW=(availW-gap*(config.GRID_SIZE-1))/config.GRID_SIZE;\n98\t  var maxCH=(availH-gap*(config.GRID_SIZE-1)-20)/config.GRID_SIZE;\n99\t  var cs=Math.floor(Math.min(maxCW,maxCH));\n100\t  var bw=cs*config.GRID_SIZE+gap*(config.GRID_SIZE-1);\n101\t  return {x:(sw-bw)/2, y:topH+(availH-bw)/2, width:bw, height:bw, cellSize:cs, topBarHeight:topH, bottomBarHeight:botH};\n102\t}\n103\t\n104\tPage({\n105\t  data: {},\n106\t  onReady: function () {\n107\t    var self = this;\n108\t    var query = tt.createSelectorQuery();\n109\t    query.select('#gameCanvas').fields({ node: true, size: true }).exec(function (res) {\n110\t      if (!res || !res[0] || !res[0].node) return;\n111\t      var canvas = res[0].node;\n112\t      var ctx = canvas.getContext('2d');\n113\t      var sysInfo = tt.getSystemInfoSync();\n114\t      var dpr = sysInfo.pixelRatio || 1;\n115\t      var sw = sysInfo.windowWidth;\n116\t      var sh = sysInfo.windowHeight;\n117\t\n118\t      canvas.width = sw * dpr;\n119\t      canvas.height = sh * dpr;\n120\t      ctx.scale(dpr, dpr);\n121\t\n122\t      var layout = calcLayout(sw, sh);\n123\t      var board = new Board();\n124\t      var renderer = new Renderer(ctx, layout);\n125\t      renderer.sw = sw;\n126\t      renderer.sh = sh;\n127\t      var input = new InputHandler(layout);\n128\t      var anim = new AnimMgr();\n129\t      var score = new ScoreManager();\n130\t      var state = 'idle';\n131\t\n132\t      input.onSelect = function (cell) {\n133\t        renderer.selectedCell = cell;\n134\t        if (cell) tt.vibrateShort({ type: 'light' });\n135\t      };\n136\t      input.onSwap = function (r1, c1, r2, c2) {\n137\t        tt.vibrateShort({ type: 'light' });\n138\t        state = 'swapping';\n139\t        var cs = layout.cellSize;\n140\t        var dx = (c2 - c1) * (cs + config.CELL_GAP);\n141\t        var dy = (r2 - r1) * (cs + config.CELL_GAP);\n142\t        anim.add(150, function (t) {\n143\t          var e = easeOutQuad(t);\n144\t          renderer.setPieceOffset(r1, c1, dx * e, dy * e);\n145\t          renderer.setPieceOffset(r2, c2, -dx * e, -dy * e);\n146\t        }, function () {\n147\t          renderer.clearPieceOffset(r1, c1);\n148\t          renderer.clearPieceOffset(r2, c2);\n149\t          board.swap(r1, c1, r2, c2);\n150\t          var ms = board.findMatches();\n151\t          if (ms.length === 0) {\n152\t            anim.add(150, function (t) {\n153\t              var e = easeOutQuad(t);\n154\t              renderer.setPieceOffset(r1, c1, -dx * e, -dy * e);\n155\t              renderer.setPieceOffset(r2, c2, dx * e, dy * e);\n156\t            }, function () {\n157\t              renderer.clearPieceOffset(r1, c1);\n158\t              renderer.clearPieceOffset(r2, c2);\n159\t              board.swap(r1, c1, r2, c2);\n160\t              state = 'idle';\n161\t            });\n162\t          } else {\n163\t            score.useMove();\n164\t            score.startCombo();\n165\t            processMatches();\n166\t          }\n167\t        });\n168\t      };\n169\t      input.onBtnClick = function (x, y) {\n170\t        if (state === 'gameover') {\n171\t          var b = renderer._retryBtn;\n172\t          if (b && x >= b.x && x <= b.x + b.w && y >= b.y && y <= b.y + b.h) restart();\n173\t        }\n174\t        if (state === 'levelcomplete') {\n175\t          var b = renderer._nextBtn;\n176\t          if (b && x >= b.x && x <= b.x + b.w && y >= b.y && y <= b.y + b.h) nextLevel();\n177\t        }\n178\t        var rb = renderer._restartBtn;\n179\t        if (rb && x >= rb.x && x <= rb.x + rb.w && y >= rb.y && y <= rb.y + rb.h) restart();\n180\t      };\n181\t\n182\t      function groupMatches(ms) {\n183\t        var set = {}, i;\n184\t        for (i = 0; i < ms.length; i++) set[ms[i].r + ',' + ms[i].c] = ms[i];\n185\t        var visited = {}, groups = [];\n186\t        for (i = 0; i < ms.length; i++) {\n187\t          var k = ms[i].r + ',' + ms[i].c;\n188\t          if (visited[k]) continue;\n189\t          var group = [], queue = [ms[i]];\n190\t          while (queue.length > 0) {\n191\t            var cur = queue.pop(), ck = cur.r + ',' + cur.c;\n192\t            if (visited[ck]) continue;\n193\t            visited[ck] = true;\n194\t            group.push(cur);\n195\t            var dirs = [[0, 1], [0, -1], [1, 0], [-1, 0]];\n196\t            for (var d = 0; d < 4; d++) {\n197\t              var nk = (cur.r + dirs[d][0]) + ',' + (cur.c + dirs[d][1]);\n198\t              if (set[nk] && !visited[nk]) queue.push(set[nk]);\n199\t            }\n200\t          }\n201\t          groups.push(group);\n202\t        }\n203\t        return groups;\n204\t      }\n205\t\n206\t      function processMatches() {\n207\t        var ms = board.findMatches();\n208\t        if (ms.length === 0) {\n209\t          if (!board.hasValidMoves()) board.shuffle();\n210\t          if (score.isLevelComplet