 hideTestimony() {\n    this.isActive = false;\n    this.objectionMode = false;\n    this.evidenceSelectMode = false;\n    this.currentTestimony = null;\n  }\n\n  isTestimonyActive(): boolean { return this.isActive; }\n\n  private setupInput() {\n    this.input.onClick((e) => {\n      if (e.type !== 'up') return;\n      if (!this.isActive) return;\n      this.handleClick(e.x, e.y);\n    });\n  }\n\n  private handleClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    if (this.resultTimer > 0) {\n      this.resultTimer = 0;\n      this.resultMessage = '';\n      return;\n    }\n\n    if (this.evidenceSelectMode) {\n      this.handleEvidenceClick(x, y);\n      return;\n    }\n\n    const boxX = w * 0.1;\n    const boxW = w * 0.8;\n    const boxY = h * 0.55;\n    const boxH = h * 0.35;\n\n    const objectionBtnX = boxX + boxW * 0.15;\n    const objectionBtnY = boxY + boxH - 55;\n    if (this.isInRect(x, y, objectionBtnX, objectionBtnY, 120, 40)) {\n      this.evidenceSelectMode = true;\n      return;\n    }\n\n    const noObjectionBtnX = boxX + boxW * 0.55;\n    if (this.isInRect(x, y, noObjectionBtnX, objectionBtnY, 140, 40)) {\n      this.handleNoObjection();\n    }\n  }\n\n  private handleEvidenceClick(x: number, y: number) {\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    const panelX = w * 0.2;\n    const panelW = w * 0.6;\n    const listY = h * 0.2;\n\n    const evidence = this.state.evidence;\n    for (let i = 0; i < evidence.length; i++) {\n      const iy = listY + i * 44;\n      if (this.isInRect(x, y, panelX + 10, iy, panelW - 20, 38)) {\n        this.submitObjection(evidence[i]);\n        return;\n      }\n    }\n\n    if (this.isInRect(x, y, w * 0.4, h * 0.85, w * 0.2, 40)) {\n      this.evidenceSelectMode = false;\n    }\n  }\n\n  submitObjection(evidenceId: string) {\n    if (!this.currentTestimony) return;\n\n    this.evidenceSelectMode = false;\n    this.objectionFlash = 1.5;\n\n    if (!this.currentTestimony.isLie) {\n      this.credibility.onWrongAction('对真实证词提出异议');\n      this.resultMessage = '异议不成立！这条证词是真实的。';\n      this.resultTimer = 3;\n      this.resultSuccess = false;\n      this.onObjectionResult?.({\n        success: false,\n        evidenceUsed: evidenceId,\n        lineId: this.currentTestimony.id,\n      });\n      return;\n    }\n\n    if (this.currentTestimony.contradictEvidence &&\n      evidenceId !== this.currentTestimony.contradictEvidence) {\n      this.credibility.onWrongAction('出示了不相关的证据');\n      this.resultMessage = '这份证据与此证词并无矛盾...';\n      this.resultTimer = 3;\n      this.resultSuccess = false;\n      this.onObjectionResult?.({\n        success: false,\n        evidenceUsed: evidenceId,\n        lineId: this.currentTestimony.id,\n      });\n      return;\n    }\n\n    this.credibility.onCorrectAction('成功找到证词矛盾');\n    this.pressureGain += 15;\n    this.resultMessage = '异议成立！证词与证据存在矛盾！';\n    this.resultTimer = 3;\n    this.resultSuccess = true;\n\n    if (this.currentTestimony.revealFlag) {\n      this.state.setFlag(this.currentTestimony.revealFlag, true);\n    }\n\n    this.onObjectionResult?.({\n      success: true,\n      evidenceUsed: evidenceId,\n      lineId: this.currentTestimony.id,\n    });\n  }\n\n  private handleNoObjection() {\n    if (!this.currentTestimony) return;\n\n    if (this.currentTestimony.isLie) {\n      this.credibility.onWrongAction('错过了虚假证词');\n      this.resultMessage = '你错过了矛盾...证词中有谎言。';\n      this.resultTimer = 3;\n      this.resultSuccess = false;\n    } else {\n      this.credibility.onCorrectAction('正确判断证词为真');\n      this.resultMessage = '无疑。证词属实。';\n      this.resultTimer = 2;\n      this.resultSuccess = true;\n    }\n  }\n\n  getPressureGain(): number { return this.pressureGain; }\n\n  resetPressure() { this.pressureGain = 0; }\n\n  update(dt: number) {\n    if (!this.isActive) return;\n    this.animAlpha = Math.min(1, this.animAlpha + dt * 5);\n    if (this.objectionFlash > 0) this.objectionFlash -= dt;\n    if (this.resultTimer > 0) this.resultTimer -= dt;\n  }\n\n  render() {\n    if (!this.isActive) return;\n\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    if (this.evidenceSelectMode) {\n      this.renderEvidenceSelect(ctx, w, h);\n      return;\n    }\n\n    ctx.save();\n    ctx.globalAlpha = this.animAlpha;\n\n    const boxX = w * 0.1;\n    const boxW = w * 0.8;\n    const boxY = h * 0.55;\n    const boxH = h * 0.35;\n\n    this.renderer.drawRoundRect(boxX, boxY, boxW, boxH, 8, '#1a140e', '#3a2a1a');\n    ctx.strokeStyle = '#5a4030';\n    ctx.lineWidth = 1;\n    ctx.strokeRect(boxX + 3, boxY + 3, boxW - 6, boxH - 6);\n\n    if (this.currentTestimony) {\n      this.renderer.drawText(`证人：${this.currentTestimony.speaker}`, boxX + 20, boxY + 15, {\n        font: 'bold 18px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882',\n      });\n\n      this.renderWrappedText(this.currentTestimony.text, boxX + 20, boxY + 45, boxW - 40, 80, {\n        font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0',\n      });\n    }\n\n    this.credibility.render(boxX + 20, boxY + boxH - 50, boxW * 0.4);\n\n    if (this.resultTimer > 0) {\n      ctx.save();\n      ctx.globalAlpha = Math.min(1, this.resultTimer);\n      const msgColor = this.resultSuccess ? '#6a8a4a' : '#8a4a4a';\n      this.renderer.drawText(this.resultMessage, boxX + boxW / 2, boxY + boxH / 2 - 20, {\n        font: 'bold 22px \"SimSun\", \"Noto Serif SC\", serif', color: msgColor, align: 'center',\n      });\n      ctx.restore();\n    }\n\n    if (this.objectionFlash > 0) {\n      ctx.save();\n      ctx.globalAlpha = Math.min(1, this.objectionFlash) * 0.3;\n      ctx.fillStyle = this.resultSuccess ? '#4a8a4a' : '#8a3a3a';\n      ctx.fillRect(0, 0, w, h);\n      ctx.restore();\n    }\n\n    if (this.resultTimer <= 0 && this.objectionMode) {\n      const btnY = boxY + boxH - 55;\n      const objectionBtnX = boxX + boxW * 0.15;\n      const objHover = this.isInRect(this.input.mouseX, this.input.mouseY, objectionBtnX, btnY, 120, 40);\n      this.renderer.drawRoundRect(objectionBtnX, btnY, 120, 40, 4,\n        objHover ? '#3a1a0a' : '#1a140e', '#8b4513');\n      this.renderer.drawText('异议！', objectionBtnX + 60, btnY + 10, {\n        font: 'bold 20px \"SimSun\", \"Noto Serif SC\", serif',\n        color: objHover ? '#f0d8a0' : '#c8a040', align: 'center',\n      });\n\n      const noObjBtnX = boxX + boxW * 0.55;\n      const noObjHover = this.isInRect(this.input.mouseX, this.input.mouseY, noObjBtnX, btnY, 140, 40);\n      this.renderer.drawRoundRect(noObjBtnX, btnY, 140, 40, 4,\n        noObjHover ? '#2a1a0e' : '#1a140e', '#5a4030');\n      this.renderer.drawText('无疑，继续', noObjBtnX + 70, btnY + 10, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n        color: noObjHover ? '#e8c8a2' : '#a08870', align: 'center',\n      });\n    }\n\n    ctx.restore();\n  }\n\n  private renderEvidenceSelect(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    ctx.save();\n    ctx.globalAlpha = 0.9;\n    ctx.fillStyle = '#0a0806';\n    ctx.fillRect(0, 0, w, h);\n    ctx.restore();\n\n    const panelX = w * 0.2;\n    const panelW = w * 0.6;\n    const panelY = h * 0.1;\n    const panelH = h * 0.75;\n\n    this.renderer.drawRoundRect(panelX, panelY, panelW, panelH, 8, '#1a140e', '#5a4030');\n    this.renderer.drawText('出示反驳证据', panelX + panelW / 2, panelY + 18, {\n      font: 'bold 22px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    if (this.currentTestimony) {\n      this.renderer.drawText(`反驳证词：\"${this.currentTestimony.text.substring(0, 20)}...\"`,\n        panelX + panelW / 2, panelY + 50, {\n          font: '14px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center',\n        });\n    }\n\n    const items = this.state.evidence;\n    const listY = h * 0.2;\n\n    items.forEach((evId, i) => {\n      const iy = listY + i * 44;\n      const isHover = this.isInRect(this.input.mouseX, this.input.mouseY, panelX + 10, iy, panelW - 20, 38);\n\n      if (isHover) {\n        ctx.fillStyle = 'rgba(200, 168, 130, 0.12)';\n        ctx.fillRect(panelX + 10, iy, panelW - 20, 38);\n      }\n\n      this.renderer.drawText(`▪ ${evId}`, panelX + 25, iy + 8, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n        color: isHover ? '#f0d8b0' : '#d8c8b0',\n      });\n    });\n\n    if (items.length === 0) {\n      this.renderer.drawText('没有可出示的证据', panelX + panelW / 2, listY + 30, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#4a3a2a', align: 'center',\n      });\n    }\n\n    const cancelHover = this.isInRect(this.input.mouseX, this.input.mouseY, w * 0.4, h * 0.85, w * 0.2, 40);\n    this.renderer.drawRoundRect(w * 0.4, h * 0.85, w * 0.2, 40, 4,\n      cancelHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('取消', w / 2, h * 0.85 + 10, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif',\n      color: cancelHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n  }\n\n  private renderWrappedText(text: string, x: number, y: number, maxW: number, maxH: number,\n    opts: { font?: string; color?: string }) {\n    const ctx = this.renderer.context;\n    ctx.save();\n    ctx.font = opts.font ?? '20px \"SimSun\", \"Noto Serif SC\", serif';\n    ctx.fillStyle = opts.color ?? '#d8c8b0';\n\n    let lineY = y;\n    let line = '';\n    for (const ch of text) {\n      const test = line + ch;\n      if (ctx.measureText(test).width > maxW) {\n        ctx.fillText(line, x, lineY);\n        line = ch;\n        lineY += 28;\n        if (lineY - y > maxH) break;\n      } else {\n        line = test;\n      }\n    }\n    if (line) ctx.fillText(line, x, lineY);\n    ctx.restore();\n  }\n\n  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
{"type":"assistant","message":{"id":"msg_202605240136558d702658c66248e7","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"text","text":"正在编写 TrialLoop——核心审判状态机。"}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"b5a5daaf-c8fd-4523-92be-b3ba2de361bf","uuid":"15d91077-fd6f-4689-ad2a-1fb57983296d"}
{"type":"assistant","message":{"id":"msg_202605240136558d702658c66248e7","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_1b383a53d75443a5b61e4bfb","name":"Write","input":{"file_path":"D:/game-projects/steam-ancient-mystery/src/game/TrialLoop.ts","content":"import { Renderer } from '../renderer/Renderer';\nimport { GameState } from './GameState';\nimport { InputManager } from './InputManager';\nimport { CredibilityScore } from './CredibilityScore';\nimport { ObjectionSystem, TestimonyLine, ObjectionResult } from './ObjectionSystem';\n\nexport type TrialPhase =\n  | 'opening' | 'witness_intro' | 'testimony' | 'cross_examine'\n  | 'rebuttal' | 'closing' | 'verdict' | 'complete' | 'failed';\n\nexport interface TrialWitness {\n  id: string;\n  name: string;\n  portrait?: string;\n  testimonyLines: TestimonyLine[];\n}\n\nexport interface TrialConfig {\n  id: string;\n  chapter: number;\n  caseTitle: string;\n  plaintiffName: string;\n  defendantName: string;\n  judgeName: string;\n  witnesses: TrialWitness[];\n  correctVerdict: 'guilty' | 'innocent';\n  onVerdict?: (verdict: string, score: number) => void;\n}\n\nexport class TrialLoop {\n  private config: TrialConfig | null = null;\n  private phase: TrialPhase = 'opening';\n  private currentWitnessIndex = 0;\n  private currentLineIndex = 0;\n  private verdict: 'guilty' | 'innocent' | null = null;\n  private animAlpha = 0;\n  private phaseText = '';\n  private phaseTextTimer = 0;\n  private showingPhaseIntro = false;\n  private totalObjections = 0;\n  private correctObjections = 0;\n\n  private isOpen = false;\n\n  private objectionSystem: ObjectionSystem;\n  private credibility: CredibilityScore;\n\n  private onTrialEnd?: (verdict: string, score: number) => void;\n\n  constructor(\n    private renderer: Renderer,\n    private state: GameState,\n    private input: InputManager\n  ) {\n    this.credibility = new CredibilityScore(renderer, state);\n    this.objectionSystem = new ObjectionSystem(renderer, state, input, this.credibility);\n\n    this.objectionSystem.setResultCallback((result) => {\n      this.handleObjectionResult(result);\n    });\n\n    this.setupInput();\n  }\n\n  getCredibility(): CredibilityScore { return this.credibility; }\n  getObjectionSystem(): ObjectionSystem { return this.objectionSystem; }\n  getPhase(): TrialPhase { return this.phase; }\n  getIsOpen(): boolean { return this.isOpen; }\n\n  startTrial(config: TrialConfig) {\n    this.config = config;\n    this.phase = 'opening';\n    this.currentWitnessIndex = 0;\n    this.currentLineIndex = 0;\n    this.verdict = null;\n    this.totalObjections = 0;\n    this.correctObjections = 0;\n    this.isOpen = true;\n    this.animAlpha = 0;\n\n    this.credibility.reset();\n    this.objectionSystem.resetPressure();\n\n    this.showPhaseText('开堂');\n    this.showingPhaseIntro = true;\n    this.phaseTextTimer = 2;\n  }\n\n  endTrial() {\n    this.isOpen = false;\n    this.phase = 'complete';\n    this.objectionSystem.hideTestimony();\n  }\n\n  private showPhaseText(text: string) {\n    this.phaseText = text;\n    this.showingPhaseIntro = true;\n    this.phaseTextTimer = 2;\n  }\n\n  private advancePhase() {\n    if (!this.config) return;\n\n    switch (this.phase) {\n      case 'opening':\n        this.phase = 'witness_intro';\n        this.currentWitnessIndex = 0;\n        this.showPhaseText(`证人：${this.config.witnesses[0]?.name ?? ''}`);\n        break;\n\n      case 'witness_intro':\n        this.phase = 'testimony';\n        this.currentLineIndex = 0;\n        this.startCurrentTestimony();\n        break;\n\n      case 'testimony':\n        this.phase = 'cross_examine';\n        this.startCrossExamine();\n        break;\n\n      case 'cross_examine':\n        if (this.currentWitnessIndex < this.config.witnesses.length - 1) {\n          this.currentWitnessIndex++;\n          this.phase = 'witness_intro';\n          this.showPhaseText(`证人：${this.config.witnesses[this.currentWitnessIndex].name}`);\n        } else {\n          this.phase = 'rebuttal';\n          this.showPhaseText('最终辩论');\n        }\n        break;\n\n      case 'rebuttal':\n        this.phase = 'verdict';\n        this.showPhaseText('判决');\n        break;\n\n      case 'verdict':\n        this.phase = 'complete';\n        this.onTrialEnd?.(this.verdict ?? 'innocent', this.credibility.getScore());\n        if (this.config.onVerdict) {\n          this.config.onVerdict(this.verdict ?? 'innocent', this.credibility.getScore());\n        }\n        break;\n    }\n  }\n\n  private startCurrentTestimony() {\n    if (!this.config) return;\n    const witness = this.config.witnesses[this.currentWitnessIndex];\n    if (!witness || this.currentLineIndex >= witness.testimonyLines.length) {\n      this.advancePhase();\n      return;\n    }\n    const line = witness.testimonyLines[this.currentLineIndex];\n    this.objectionSystem.showTestimony(line);\n  }\n\n  private startCrossExamine() {\n    if (!this.config) return;\n    const witness = this.config.witnesses[this.currentWitnessIndex];\n    this.currentLineIndex = 0;\n    if (!witness || witness.testimonyLines.length === 0) {\n      this.advancePhase();\n      return;\n    }\n    const line = witness.testimonyLines[this.currentLineIndex];\n    this.objectionSystem.showTestimony(line);\n  }\n\n  private handleObjectionResult(result: ObjectionResult) {\n    this.totalObjections++;\n    if (result.success) {\n      this.correctObjections++;\n    }\n    this.advanceToNextLine();\n  }\n\n  private advanceToNextLine() {\n    if (!this.config) return;\n    const witness = this.config.witnesses[this.currentWitnessIndex];\n    if (!witness) return;\n\n    this.currentLineIndex++;\n    if (this.currentLineIndex < witness.testimonyLines.length) {\n      const line = witness.testimonyLines[this.currentLineIndex];\n      this.objectionSystem.showTestimony(line);\n    } else {\n      this.objectionSystem.hideTestimony();\n      if (this.phase === 'testimony') {\n        this.advancePhase();\n      } else if (this.phase === 'cross_examine') {\n        this.advancePhase();\n      }\n    }\n  }\n\n  private setupInput() {\n    this.input.onClick((e) => {\n      if (e.type !== 'up') return;\n      if (!this.isOpen) return;\n      if (this.objectionSystem.isTestimonyActive()) return;\n      this.handleClick(e.x, e.y);\n    });\n  }\n\n  private handleClick(x: number, y: number) {\n    if (!this.config) return;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    if (this.showingPhaseIntro && this.phaseTextTimer <= 0) {\n      this.showingPhaseIntro = false;\n      this.advancePhase();\n      return;\n    }\n\n    if (this.phase === 'verdict') {\n      const centerX = w / 2;\n      const guiltyY = h * 0.45;\n      const innocentY = h * 0.55;\n      const btnW = 200;\n      const btnH = 50;\n\n      if (this.isInRect(x, y, centerX - btnW / 2, guiltyY, btnW, btnH)) {\n        this.verdict = 'guilty';\n        this.showPhaseText(this.verdict === this.config.correctVerdict ? '判决正确！' : '判决有误...');\n        this.advancePhase();\n        return;\n      }\n\n      if (this.isInRect(x, y, centerX - btnW / 2, innocentY, btnW, btnH)) {\n        this.verdict = 'innocent';\n        this.showPhaseText(this.verdict === this.config.correctVerdict ? '判决正确！' : '判决有误...');\n        this.advancePhase();\n        return;\n      }\n    }\n\n    if (this.phase === 'complete') {\n      if (this.isInRect(x, y, w / 2 - 80, h * 0.85, 160, 45)) {\n        this.endTrial();\n      }\n    }\n\n    if (this.phase === 'failed') {\n      this.endTrial();\n    }\n  }\n\n  update(dt: number) {\n    if (!this.isOpen) return;\n    this.animAlpha = Math.min(1, this.animAlpha + dt * 3);\n    if (this.phaseTextTimer > 0) this.phaseTextTimer -= dt;\n    this.credibility.update(dt);\n    this.objectionSystem.update(dt);\n\n    if (!this.credibility.isAlive() && this.phase !== 'complete' && this.phase !== 'failed') {\n      this.phase = 'failed';\n      this.showPhaseText('庭审失败...');\n    }\n  }\n\n  render() {\n    if (!this.isOpen) return;\n\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    this.renderCourtroom(ctx, w, h);\n\n    this.credibility.renderWarningOverlay();\n\n    if (this.showingPhaseIntro) {\n      this.renderPhaseIntro(ctx, w, h);\n      return;\n    }\n\n    if (this.objectionSystem.isTestimonyActive()) {\n      this.renderWitnessPanel(ctx, w, h);\n      this.objectionSystem.render();\n      return;\n    }\n\n    switch (this.phase) {\n      case 'opening':\n        this.renderOpening(ctx, w, h);\n        break;\n      case 'witness_intro':\n        this.renderWitnessIntro(ctx, w, h);\n        break;\n      case 'testimony':\n        break;\n      case 'cross_examine':\n        break;\n      case 'rebuttal':\n        this.renderRebuttal(ctx, w, h);\n        break;\n      case 'verdict':\n        this.renderVerdict(ctx, w, h);\n        break;\n      case 'complete':\n        this.renderComplete(ctx, w, h);\n        break;\n      case 'failed':\n        this.renderFailed(ctx, w, h);\n        break;\n    }\n  }\n\n  private renderCourtroom(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0, '#1a0a0a');\n    grad.addColorStop(0.5, '#2a1410');\n    grad.addColorStop(1, '#0d0606');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n\n    ctx.save();\n    ctx.strokeStyle = '#5a3020';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.moveTo(w * 0.1, h * 0.35);\n    ctx.lineTo(w * 0.9, h * 0.35);\n    ctx.stroke();\n    ctx.beginPath();\n    ctx.moveTo(w * 0.1, h * 0.50);\n    ctx.lineTo(w * 0.9, h * 0.50);\n    ctx.stroke();\n    ctx.restore();\n\n    if (this.config) {\n      this.renderer.drawText(this.config.caseTitle, w / 2, h * 0.03, {\n        font: 'bold 20px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n      });\n    }\n\n    this.credibility.render(w - 200, 10, 180);\n  }\n\n  private renderPhaseIntro(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    ctx.save();\n    ctx.globalAlpha = 0.7;\n    ctx.fillStyle = '#0a0806';\n    ctx.fillRect(0, 0, w, h);\n    ctx.restore();\n\n    this.renderer.drawText(this.phaseText, w / 2, h * 0.4, {\n      font: 'bold 42px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    if (this.phaseTextTimer <= 0) {\n      const blinkAlpha = 0.3 + Math.sin(Date.now() * 0.004) * 0.2;\n      this.renderer.drawText('点击继续', w / 2, h * 0.55, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center', alpha: blinkAlpha,\n      });\n    }\n  }\n\n  private renderWitnessPanel(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    if (!this.config) return;\n    const witness = this.config.witnesses[this.currentWitnessIndex];\n    if (!witness) return;\n\n    const panelX = w * 0.1;\n    const panelW = w * 0.8;\n    const panelY = h * 0.36;\n\n    ctx.save();\n    ctx.globalAlpha = 0.8;\n    this.renderer.drawRoundRect(panelX, panelY, panelW, 60, 6, '#1a140e', '#3a2a1a');\n    ctx.restore();\n\n    this.renderer.drawText(`证人 ${this.currentWitnessIndex + 1}/${this.config.witnesses.length}：${witness.name}`,\n      panelX + panelW / 2, panelY + 20, {\n        font: 'bold 20px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2', align: 'center',\n      });\n  }\n\n  private renderOpening(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    if (!this.config) return;\n\n    this.renderer.drawText('开堂陈词', w / 2, h * 0.2, {\n      font: 'bold 28px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    const lines = [\n      `原告：${this.config.plaintiffName}`,\n      `被告：${this.config.defendantName}`,\n      `主审：${this.config.judgeName}`,\n      `证人：${this.config.witnesses.length}人`,\n    ];\n\n    lines.forEach((line, i) => {\n      this.renderer.drawText(line, w / 2, h * 0.32 + i * 36, {\n        font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n      });\n    });\n\n    const blinkAlpha = 0.3 + Math.sin(Date.now() * 0.004) * 0.2;\n    this.renderer.drawText('点击开始', w / 2, h * 0.7, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center', alpha: blinkAlpha,\n    });\n  }\n\n  private renderWitnessIntro(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    if (!this.config) return;\n    const witness = this.config.witnesses[this.currentWitnessIndex];\n    if (!witness) return;\n\n    this.renderer.drawText(`${witness.name}上堂作证`, w / 2, h * 0.35, {\n      font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2', align: 'center',\n    });\n\n    this.renderer.drawText(`共有 ${witness.testimonyLines.length} 条证词待听取`, w / 2, h * 0.45, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870', align: 'center',\n    });\n  }\n\n  private renderRebuttal(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    this.renderer.drawText('最终辩论', w / 2, h * 0.2, {\n      font: 'bold 28px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    this.renderer.drawText('所有证人已作证完毕。', w / 2, h * 0.35, {\n      font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n    });\n\n    this.renderer.drawText(`异议成功率：${this.totalObjections > 0 ? Math.round(this.correctObjections / this.totalObjections * 100) : 0}%`, w / 2, h * 0.45, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center',\n    });\n\n    const blinkAlpha = 0.3 + Math.sin(Date.now() * 0.004) * 0.2;\n    this.renderer.drawText('进入判决', w / 2, h * 0.6, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center', alpha: blinkAlpha,\n    });\n  }\n\n  private renderVerdict(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    if (!this.config) return;\n\n    this.renderer.drawText('宣 判', w / 2, h * 0.2, {\n      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    this.renderer.drawText('根据庭审证据和辩论，你做出判决：', w / 2, h * 0.32, {\n      font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n    });\n\n    const centerX = w / 2;\n    const btnW = 200;\n    const btnH = 50;\n\n    const guiltyY = h * 0.45;\n    const guiltyHover = this.isInRect(this.input.mouseX, this.input.mouseY, centerX - btnW / 2, guiltyY, btnW, btnH);\n    this.renderer.drawRoundRect(centerX - btnW / 2, guiltyY, btnW, btnH, 6,\n      guiltyHover ? '#3a1a1a' : '#1a140e', '#8b4513');\n    this.renderer.drawText('有罪', centerX, guiltyY + 14, {\n      font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n      color: guiltyHover ? '#f0d8a0' : '#c8a040', align: 'center',\n    });\n\n    const innocentY = h * 0.55;\n    const innocentHover = this.isInRect(this.input.mouseX, this.input.mouseY, centerX - btnW / 2, innocentY, btnW, btnH);\n    this.renderer.drawRoundRect(centerX - btnW / 2, innocentY, btnW, btnH, 6,\n      innocentHover ? '#1a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('无罪', centerX, innocentY + 14, {\n      font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n      color: innocentHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n  }\n\n  private renderComplete(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    const isCorrect = this.verdict === this.config?.correctVerdict;\n\n    this.renderer.drawText(isCorrect ? '判决正确' : '判决有误', w / 2, h * 0.25, {\n      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif',\n      color: isCorrect ? '#6a8a4a' : '#8a4a4a', align: 'center',\n    });\n\n    this.renderer.drawText(`最终信誉值：${this.credibility.getScore()}`, w / 2, h * 0.4, {\n      font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n    });\n\n    this.renderer.drawText(`异议成功率：${this.totalObjections > 0 ? Math.round(this.correctObjections / this.totalObjections * 100) : 0}%`, w / 2, h * 0.48, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870', align: 'center',\n    });\n\n    const closeHover = this.isInRect(this.input.mouseX, this.input.mouseY, w / 2 - 80, h * 0.85, 160, 45);\n    this.renderer.drawRoundRect(w / 2 - 80, h * 0.85, 160, 45, 6,\n      closeHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('结束庭审', w / 2, h * 0.85 + 12, {\n      font: '20px \"SimSun\", \"Noto Serif SC\", serif',\n      color: closeHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n  }\n\n  private renderFailed(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    this.renderer.drawText('庭审失败', w / 2, h * 0.3, {\n      font: 'bold 40px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a3a3a', align: 'center',\n    });\n\n    this.renderer.drawText('信誉值归零，无法继续庭审。', w / 2, h * 0.45, {\n      font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n    });\n\n    this.renderer.drawText('需要重新调查收集更多证据。', w / 2, h * 0.55, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870', align: 'center',\n    });\n  }\n\n  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"b5a5daaf-c8fd-4523-92be-b3ba2de361bf","uuid":"04cc6616-1a2b-4e12-a384-5137858e901e"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_1b383a53d75443a5b61e4bfb","type":"tool_result","content":"File created successfully at: D:/game-projects/steam-ancient-mystery/src/game/TrialLoop.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"b5a5daaf-c8fd-4523-92be-b3ba2de361bf","uuid":"ee6fba30-3e6f-4b08-8213-f120e7d0ea04","timestamp":"2026-05-23T17:37:57.400Z","tool_use_result":{"type":"create","filePath":"D:/game-projects/steam-ancient-mystery/src/game/TrialLoop.ts","content":"import { Renderer } from '../renderer/Renderer';\nimport { GameState } from './GameState';\nimport { InputManager } from './InputManager';\nimport { CredibilityScore } from './CredibilityScore';\nimport { ObjectionSystem, TestimonyLine, ObjectionResult } from './ObjectionSystem';\n\nexport type TrialPhase =\n  | 'opening' | 'witness_intro' | 'testimony' | 'cross_examine'\n  | 'rebuttal' | 'closing' | 'verdict' | 'complete' | 'failed';\n\nexport interface TrialWitness {\n  id: string;\n  name: string;\n  portrait?: string;\n  testimonyLines: TestimonyLine[];\n}\n\nexport interface TrialConfig {\n  id: string;\n  chapter: number;\n  caseTitle: string;\n  plaintiffName: string;\n  defendantName: string;\n  judgeName: string;\n  witnesses: TrialWitness[];\n  correctVerdict: 'guilty' | 'innocent';\n  onVerdict?: (verdict: string, score: number) => void;\n}\n\nexport class TrialLoop {\n  private config: TrialConfig | null = null;\n  private phase: TrialPhase = 'opening';\n  private currentWitnessIndex = 0;\n  private currentLineIndex = 0;\n  private verdict: 'guilty' | 'innocent' | null = null;\n  private animAlpha = 0;\n  private phaseText = '';\n  private phaseTextTimer = 0;\n  private showingPhaseIntro = false;\n  private totalObjections = 0;\n  private correctObjections = 0;\n\n  private isOpen = false;\n\n  private objectionSystem: ObjectionSystem;\n  private credibility: CredibilityScore;\n\n  private onTrialEnd?: (verdict: string, score: number) => void;\n\n  constructor(\n    private renderer: Renderer,\n    private state: GameState,\n    private input: InputManager\n  ) {\n    this.credibility = new CredibilityScore(renderer, state);\n    this.objectionSystem = new ObjectionSystem(renderer, state, input, this.credibility);\n\n    this.objectionSystem.setResultCallback((result) => {\n      this.handleObjectionResult(result);\n    });\n\n    this.setupInput();\n  }\n\n  getCredibility(): CredibilityScore { return this.credibility; }\n  getObjectionSystem(): ObjectionSystem { return this.objectionSystem; }\n  getPhase(): TrialPhase { return this.phase; }\n  getIsOpen(): boolean { return this.isOpen; }\n\n  startTrial(config: TrialConfig) {\n    this.config = config;\n    this.phase = 'opening';\n    this.currentWitnessIndex = 0;\n    this.currentLineIndex = 0;\n    this.verdict = null;\n    this.totalObjections = 0;\n    this.correctObjections = 0;\n    this.isOpen = true;\n    this.animAlpha = 0;\n\n    this.credibility.reset();\n    this.objectionSystem.resetPressure();\n\n    this.showPhaseText('开堂');\n    this.showingPhaseIntro = true;\n    this.phaseTextTimer = 2;\n  }\n\n  endTrial() {\n    this.isOpen = false;\n    this.phase = 'complete';\n    this.objectionSystem.hideTestimony();\n  }\n\n  private showPhaseText(text: string) {\n    this.phaseText = text;\n    this.showingPhaseIntro = true;\n    this.phaseTextTimer = 2;\n  }\n\n  private advancePhase() {\n    if (!this.config) return;\n\n    switch (this.phase) {\n      case 'opening':\n        this.phase = 'witness_intro';\n        this.currentWitnessIndex = 0;\n        this.showPhaseText(`证人：${this.config.witnesses[0]?.name ?? ''}`);\n        break;\n\n      case 'witness_intro':\n        this.phase = 'testimony';\n        this.currentLineIndex = 0;\n        this.startCurrentTestimony();\n        break;\n\n      case 'testimony':\n        this.phase = 'cross_examine';\n        this.startCrossExamine();\n        break;\n\n      case 'cross_examine':\n        if (this.currentWitnessIndex < this.config.witnesses.length - 1) {\n          this.currentWitnessIndex++;\n          this.phase = 'witness_intro';\n          this.showPhaseText(`证人：${this.config.witnesses[this.currentWitnessIndex].name}`);\n        } else {\n          this.phase = 'rebuttal';\n          this.showPhaseText('最终辩论');\n        }\n        break;\n\n      case 'rebuttal':\n        this.phase = 'verdict';\n        this.showPhaseText('判决');\n        break;\n\n      case 'verdict':\n        this.phase = 'complete';\n        this.onTrialEnd?.(this.verdict ?? 'innocent', this.credibility.getScore());\n        if (this.config.onVerdict) {\n          this.config.onVerdict(this.verdict ?? 'innocent', this.credibility.getScore());\n        }\n        break;\n    }\n  }\n\n  private startCurrentTestimony() {\n    if (!this.config) return;\n    const witness = this.config.witnesses[this.currentWitnessIndex];\n    if (!witness || this.currentLineIndex >= witness.testimonyLines.length) {\n      this.advancePhase();\n      return;\n    }\n    const line = witness.testimonyLines[this.currentLineIndex];\n    this.objectionSystem.showTestimony(line);\n  }\n\n  private startCrossExamine() {\n    if (!this.config) return;\n    const witness = this.config.witnesses[this.currentWitnessIndex];\n    this.currentLineIndex = 0;\n    if (!witness || witness.testimonyLines.length === 0) {\n      this.advancePhase();\n      return;\n    }\n    const line = witness.testimonyLines[this.currentLineIndex];\n    this.objectionSystem.showTestimony(line);\n  }\n\n  private handleObjectionResult(result: ObjectionResult) {\n    this.totalObjections++;\n    if (result.success) {\n      this.correctObjections++;\n    }\n    this.advanceToNextLine();\n  }\n\n  private advanceToNextLine() {\n    if (!this.config) return;\n    const witness = this.config.witnesses[this.currentWitnessIndex];\n    if (!witness) return;\n\n    this.currentLineIndex++;\n    if (this.currentLineIndex < witness.testimonyLines.length) {\n      const line = witness.testimonyLines[this.currentLineIndex];\n      this.objectionSystem.showTestimony(line);\n    } else {\n      this.objectionSystem.hideTestimony();\n      if (this.phase === 'testimony') {\n        this.advancePhase();\n      } else if (this.phase === 'cross_examine') {\n        this.advancePhase();\n      }\n    }\n  }\n\n  private setupInput() {\n    this.input.onClick((e) => {\n      if (e.type !== 'up') return;\n      if (!this.isOpen) return;\n      if (this.objectionSystem.isTestimonyActive()) return;\n      this.handleClick(e.x, e.y);\n    });\n  }\n\n  private handleClick(x: number, y: number) {\n    if (!this.config) return;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    if (this.showingPhaseIntro && this.phaseTextTimer <= 0) {\n      this.showingPhaseIntro = false;\n      this.advancePhase();\n      return;\n    }\n\n    if (this.phase === 'verdict') {\n      const centerX = w / 2;\n      const guiltyY = h * 0.45;\n      const innocentY = h * 0.55;\n      const btnW = 200;\n      const btnH = 50;\n\n      if (this.isInRect(x, y, centerX - btnW / 2, guiltyY, btnW, btnH)) {\n        this.verdict = 'guilty';\n        this.showPhaseText(this.verdict === this.config.correctVerdict ? '判决正确！' : '判决有误...');\n        this.advancePhase();\n        return;\n      }\n\n      if (this.isInRect(x, y, centerX - btnW / 2, innocentY, btnW, btnH)) {\n        this.verdict = 'innocent';\n        this.showPhaseText(this.verdict === this.config.correctVerdict ? '判决正确！' : '判决有误...');\n        this.advancePhase();\n        return;\n      }\n    }\n\n    if (this.phase === 'complete') {\n      if (this.isInRect(x, y, w / 2 - 80, h * 0.85, 160, 45)) {\n        this.endTrial();\n      }\n    }\n\n    if (this.phase === 'failed') {\n      this.endTrial();\n    }\n  }\n\n  update(dt: number) {\n    if (!this.isOpen) return;\n    this.animAlpha = Math.min(1, this.animAlpha + dt * 3);\n    if (this.phaseTextTimer > 0) this.phaseTextTimer -= dt;\n    this.credibility.update(dt);\n    this.objectionSystem.update(dt);\n\n    if (!this.credibility.isAlive() && this.phase !== 'complete' && this.phase !== 'failed') {\n      this.phase = 'failed';\n      this.showPhaseText('庭审失败...');\n    }\n  }\n\n  render() {\n    if (!this.isOpen) return;\n\n    const ctx = this.renderer.context;\n    const w = this.renderer.w;\n    const h = this.renderer.h;\n\n    this.renderCourtroom(ctx, w, h);\n\n    this.credibility.renderWarningOverlay();\n\n    if (this.showingPhaseIntro) {\n      this.renderPhaseIntro(ctx, w, h);\n      return;\n    }\n\n    if (this.objectionSystem.isTestimonyActive()) {\n      this.renderWitnessPanel(ctx, w, h);\n      this.objectionSystem.render();\n      return;\n    }\n\n    switch (this.phase) {\n      case 'opening':\n        this.renderOpening(ctx, w, h);\n        break;\n      case 'witness_intro':\n        this.renderWitnessIntro(ctx, w, h);\n        break;\n      case 'testimony':\n        break;\n      case 'cross_examine':\n        break;\n      case 'rebuttal':\n        this.renderRebuttal(ctx, w, h);\n        break;\n      case 'verdict':\n        this.renderVerdict(ctx, w, h);\n        break;\n      case 'complete':\n        this.renderComplete(ctx, w, h);\n        break;\n      case 'failed':\n        this.renderFailed(ctx, w, h);\n        break;\n    }\n  }\n\n  private renderCourtroom(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0, '#1a0a0a');\n    grad.addColorStop(0.5, '#2a1410');\n    grad.addColorStop(1, '#0d0606');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n\n    ctx.save();\n    ctx.strokeStyle = '#5a3020';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.moveTo(w * 0.1, h * 0.35);\n    ctx.lineTo(w * 0.9, h * 0.35);\n    ctx.stroke();\n    ctx.beginPath();\n    ctx.moveTo(w * 0.1, h * 0.50);\n    ctx.lineTo(w * 0.9, h * 0.50);\n    ctx.stroke();\n    ctx.restore();\n\n    if (this.config) {\n      this.renderer.drawText(this.config.caseTitle, w / 2, h * 0.03, {\n        font: 'bold 20px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n      });\n    }\n\n    this.credibility.render(w - 200, 10, 180);\n  }\n\n  private renderPhaseIntro(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    ctx.save();\n    ctx.globalAlpha = 0.7;\n    ctx.fillStyle = '#0a0806';\n    ctx.fillRect(0, 0, w, h);\n    ctx.restore();\n\n    this.renderer.drawText(this.phaseText, w / 2, h * 0.4, {\n      font: 'bold 42px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    if (this.phaseTextTimer <= 0) {\n      const blinkAlpha = 0.3 + Math.sin(Date.now() * 0.004) * 0.2;\n      this.renderer.drawText('点击继续', w / 2, h * 0.55, {\n        font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center', alpha: blinkAlpha,\n      });\n    }\n  }\n\n  private renderWitnessPanel(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    if (!this.config) return;\n    const witness = this.config.witnesses[this.currentWitnessIndex];\n    if (!witness) return;\n\n    const panelX = w * 0.1;\n    const panelW = w * 0.8;\n    const panelY = h * 0.36;\n\n    ctx.save();\n    ctx.globalAlpha = 0.8;\n    this.renderer.drawRoundRect(panelX, panelY, panelW, 60, 6, '#1a140e', '#3a2a1a');\n    ctx.restore();\n\n    this.renderer.drawText(`证人 ${this.currentWitnessIndex + 1}/${this.config.witnesses.length}：${witness.name}`,\n      panelX + panelW / 2, panelY + 20, {\n        font: 'bold 20px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2', align: 'center',\n      });\n  }\n\n  private renderOpening(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    if (!this.config) return;\n\n    this.renderer.drawText('开堂陈词', w / 2, h * 0.2, {\n      font: 'bold 28px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    const lines = [\n      `原告：${this.config.plaintiffName}`,\n      `被告：${this.config.defendantName}`,\n      `主审：${this.config.judgeName}`,\n      `证人：${this.config.witnesses.length}人`,\n    ];\n\n    lines.forEach((line, i) => {\n      this.renderer.drawText(line, w / 2, h * 0.32 + i * 36, {\n        font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n      });\n    });\n\n    const blinkAlpha = 0.3 + Math.sin(Date.now() * 0.004) * 0.2;\n    this.renderer.drawText('点击开始', w / 2, h * 0.7, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center', alpha: blinkAlpha,\n    });\n  }\n\n  private renderWitnessIntro(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    if (!this.config) return;\n    const witness = this.config.witnesses[this.currentWitnessIndex];\n    if (!witness) return;\n\n    this.renderer.drawText(`${witness.name}上堂作证`, w / 2, h * 0.35, {\n      font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif', color: '#e8c8a2', align: 'center',\n    });\n\n    this.renderer.drawText(`共有 ${witness.testimonyLines.length} 条证词待听取`, w / 2, h * 0.45, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870', align: 'center',\n    });\n  }\n\n  private renderRebuttal(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    this.renderer.drawText('最终辩论', w / 2, h * 0.2, {\n      font: 'bold 28px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    this.renderer.drawText('所有证人已作证完毕。', w / 2, h * 0.35, {\n      font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n    });\n\n    this.renderer.drawText(`异议成功率：${this.totalObjections > 0 ? Math.round(this.correctObjections / this.totalObjections * 100) : 0}%`, w / 2, h * 0.45, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center',\n    });\n\n    const blinkAlpha = 0.3 + Math.sin(Date.now() * 0.004) * 0.2;\n    this.renderer.drawText('进入判决', w / 2, h * 0.6, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a7a6a', align: 'center', alpha: blinkAlpha,\n    });\n  }\n\n  private renderVerdict(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    if (!this.config) return;\n\n    this.renderer.drawText('宣 判', w / 2, h * 0.2, {\n      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif', color: '#c8a882', align: 'center',\n    });\n\n    this.renderer.drawText('根据庭审证据和辩论，你做出判决：', w / 2, h * 0.32, {\n      font: '20px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n    });\n\n    const centerX = w / 2;\n    const btnW = 200;\n    const btnH = 50;\n\n    const guiltyY = h * 0.45;\n    const guiltyHover = this.isInRect(this.input.mouseX, this.input.mouseY, centerX - btnW / 2, guiltyY, btnW, btnH);\n    this.renderer.drawRoundRect(centerX - btnW / 2, guiltyY, btnW, btnH, 6,\n      guiltyHover ? '#3a1a1a' : '#1a140e', '#8b4513');\n    this.renderer.drawText('有罪', centerX, guiltyY + 14, {\n      font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n      color: guiltyHover ? '#f0d8a0' : '#c8a040', align: 'center',\n    });\n\n    const innocentY = h * 0.55;\n    const innocentHover = this.isInRect(this.input.mouseX, this.input.mouseY, centerX - btnW / 2, innocentY, btnW, btnH);\n    this.renderer.drawRoundRect(centerX - btnW / 2, innocentY, btnW, btnH, 6,\n      innocentHover ? '#1a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('无罪', centerX, innocentY + 14, {\n      font: 'bold 24px \"SimSun\", \"Noto Serif SC\", serif',\n      color: innocentHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n  }\n\n  private renderComplete(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    const isCorrect = this.verdict === this.config?.correctVerdict;\n\n    this.renderer.drawText(isCorrect ? '判决正确' : '判决有误', w / 2, h * 0.25, {\n      font: 'bold 36px \"SimSun\", \"Noto Serif SC\", serif',\n      color: isCorrect ? '#6a8a4a' : '#8a4a4a', align: 'center',\n    });\n\n    this.renderer.drawText(`最终信誉值：${this.credibility.getScore()}`, w / 2, h * 0.4, {\n      font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n    });\n\n    this.renderer.drawText(`异议成功率：${this.totalObjections > 0 ? Math.round(this.correctObjections / this.totalObjections * 100) : 0}%`, w / 2, h * 0.48, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870', align: 'center',\n    });\n\n    const closeHover = this.isInRect(this.input.mouseX, this.input.mouseY, w / 2 - 80, h * 0.85, 160, 45);\n    this.renderer.drawRoundRect(w / 2 - 80, h * 0.85, 160, 45, 6,\n      closeHover ? '#3a2a1a' : '#1a140e', '#5a4030');\n    this.renderer.drawText('结束庭审', w / 2, h * 0.85 + 12, {\n      font: '20px \"SimSun\", \"Noto Serif SC\", serif',\n      color: closeHover ? '#e8c8a2' : '#a08870', align: 'center',\n    });\n  }\n\n  private renderFailed(ctx: CanvasRenderingContext2D, w: number, h: number) {\n    this.renderer.drawText('庭审失败', w / 2, h * 0.3, {\n      font: 'bold 40px \"SimSun\", \"Noto Serif SC\", serif', color: '#8a3a3a', align: 'center',\n    });\n\n    this.renderer.drawText('信誉值归零，无法继续庭审。', w / 2, h * 0.45, {\n      font: '22px \"SimSun\", \"Noto Serif SC\", serif', color: '#d8c8b0', align: 'center',\n    });\n\n    this.renderer.drawText('需要重新调查收集更多证据。', w / 2, h * 0.55, {\n      font: '18px \"SimSun\", \"Noto Serif SC\", serif', color: '#a08870', align: 'center',\n    });\n  }\n\n  private isInRect(px: number, py: number, rx: number, ry: number, rw: number, rh: number): boolean {\n    return px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
