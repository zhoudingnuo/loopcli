;\nAnimMgr.prototype.update=function(dt){for(var i=this.list.length-1;i>=0;i--){this.list[i].update(dt);if(this.list[i].done)this.list.splice(i,1)}};\nAnimMgr.prototype.clear=function(){this.list=[]};\n\n// Input\nfunction InputHandler(layout){this.layout=layout;this.onSelect=null;this.onSwap=null;this.onBtnClick=null;this._start=null;this._sel=null}\nInputHandler.prototype.handleTouchStart=function(x,y){this._start={x:x,y:y};var cell=this._p2c(x,y);if(cell){if(this._sel){var r1=this._sel.r,c1=this._sel.c,r2=cell.r,c2=cell.c;if(r1===r2&&c1===c2){this._sel=null;if(this.onSelect)this.onSelect(null)}else if(Math.abs(r1-r2)+Math.abs(c1-c2)===1){if(this.onSwap)this.onSwap(r1,c1,r2,c2);this._sel=null;if(this.onSelect)this.onSelect(null)}else{this._sel=cell;if(this.onSelect)this.onSelect(cell)}}else{this._sel=cell;if(this.onSelect)this.onSelect(cell)}}};\nInputHandler.prototype.handleTouchMove=function(x,y){if(!this._start||!this._sel)return;var dx=x-this._start.x,dy=y-this._start.y,d=Math.sqrt(dx*dx+dy*dy);if(d>=config.SWIPE_THRESHOLD){var dr=0,dc=0;if(Math.abs(dx)>Math.abs(dy))dc=dx>0?1:-1;else dr=dy>0?1:-1;var r2=this._sel.r+dr,c2=this._sel.c+dc;if(r2>=0&&r2<config.GRID_SIZE&&c2>=0&&c2<config.GRID_SIZE){if(this.onSwap)this.onSwap(this._sel.r,this._sel.c,r2,c2);this._sel=null;this._start=null;if(this.onSelect)this.onSelect(null)}}};\nInputHandler.prototype.handleTouchEnd=function(){this._start=null};\nInputHandler.prototype.handleClick=function(x,y){if(this.onBtnClick)this.onBtnClick(x,y)};\nInputHandler.prototype._p2c=function(px,py){var x=this.layout.x,y=this.layout.y,cs=this.layout.cellSize,gap=config.CELL_GAP;var c=Math.floor((px-x)/(cs+gap)),r=Math.floor((py-y)/(cs+gap));if(r<0||r>=config.GRID_SIZE||c<0||c>=config.GRID_SIZE)return null;var cx2=x+c*(cs+gap),cy2=y+r*(cs+gap);if(px>=cx2&&px<=cx2+cs&&py>=cy2&&py<=cy2+cs)return{r:r,c:c};return null};\nInputHandler.prototype.reset=function(){this._sel=null;this._start=null};\n\n// Renderer\nfunction Renderer(ctx,layout){this.ctx=ctx;this.layout=layout;this.pieceScale={};this.pieceOffset={};this.selectedCell=null;this.particles=[];this.comboText=null;this.scorePopups=[];this.screenShake=0;this._restartBtn=null;this._retryBtn=null;this._nextBtn=null;this.sw=0;this.sh=0}\nRenderer.prototype.clear=function(){this.ctx.clearRect(0,0,this.sw,this.sh)};\nRenderer.prototype.drawBackground=function(){this.ctx.fillStyle=config.BG_COLOR;this.ctx.fillRect(0,0,this.sw,this.sh)};\nRenderer.prototype.drawBoard=function(){var ctx=this.ctx,l=this.layout;ctx.fillStyle=config.BOARD_BG;this._rr(l.x-config.BOARD_PADDING,l.y-config.BOARD_PADDING,l.width+config.BOARD_PADDING*2,l.height+config.BOARD_PADDING*2,config.BOARD_BORDER_RADIUS);ctx.fill();for(var r=0;r<config.GRID_SIZE;r++)for(var c=0;c<config.GRID_SIZE;c++){var cx=l.x+c*(l.cellSize+config.CELL_GAP),cy=l.y+r*(l.cellSize+config.CELL_GAP);ctx.fillStyle=config.CELL_BG;this._rr(cx,cy,l.cellSize,l.cellSize,6);ctx.fill()}};\nRenderer.prototype.drawPieces=function(board){var ctx=this.ctx,l=this.layout;for(var r=0;r<config.GRID_SIZE;r++)for(var c=0;c<config.GRID_SIZE;c++){var type=board.getPiece(r,c);if(type<0)continue;var px=l.x+c*(l.cellSize+config.CELL_GAP)+l.cellSize/2;var py=l.y+r*(l.cellSize+config.CELL_GAP)+l.cellSize/2;var key=r+','+c,off=this.pieceOffset[key];if(off){px+=off.dx;py+=off.dy}var scale=this.pieceScale[key]||1,radius=(l.cellSize/2-4)*scale;if(radius<=0)continue;this._drawPiece(ctx,px,py,radius,type);if(this.selectedCell&&this.selectedCell.r===r&&this.selectedCell.c===c){ctx.strokeStyle=config.SELECTED_COLOR;ctx.lineWidth=3;ctx.beginPath();ctx.arc(px,py,radius+2,0,Math.PI*2);ctx.stroke();var pulse=0.5+0.5*Math.sin(Date.now()/150);ctx.strokeStyle='rgba(236,204,104,'+(pulse*0.5)+')';ctx.lineWidth=2;ctx.beginPath();ctx.arc(px,py,radius+5,0,Math.PI*2);ctx.stroke()}}};\nRenderer.prototype._drawPiece=function(ctx,px,py,radius,type){var color=config.PIECE_COLORS[type],glow=config.PIECE_GLOW[type],shape=config.PIECE_SHAPES[type];ctx.fillStyle='rgba(0,0,0,0.2)';ctx.beginPath();ctx.arc(px+2,py+2,radius,0,Math.PI*2);ctx.fill();var grad=ctx.createRadialGradient(px-radius*0.3,py-radius*0.3,0,px,py,radius);grad.addColorStop(0,glow);grad.addColorStop(0.7,color);grad.addColorStop(1,this._dk(color,0.7));ctx.fillStyle=grad;ctx.beginPath();switch(shape){case 'circle':ctx.arc(px,py,radius,0,Math.PI*2);break;case 'diamond':ctx.moveTo(px,py-radius);ctx.lineTo(px+radius,py);ctx.lineTo(px,py+radius);ctx.lineTo(px-radius,py);break;case 'square':var s=radius*0.8;this._rr(px-s,py-s,s*2,s*2,4);break;case 'triangle':ctx.moveTo(px,py-radius);ctx.lineTo(px+radius*0.87,py+radius*0.5);ctx.lineTo(px-radius*0.87,py+radius*0.5);break;case 'star':this._star(ctx,px,py,5,radius,radius*0.5);break;case 'hexagon':this._poly(ctx,px,py,radius,6);break}ctx.fill();ctx.fillStyle='rgba(255,255,255,0.3)';ctx.beginPath();ctx.ellipse(px-radius*0.2,py-radius*0.3,radius*0.4,radius*0.25,-0.3,0,Math.PI*2);ctx.fill()};\nRenderer.prototype._star=function(ctx,cx,cy,pts,oR,iR){ctx.beginPath();for(var i=0;i<pts*2;i++){var r=i%2===0?oR:iR,a=(Math.PI/pts)*i-Math.PI/2,x=cx+Math.cos(a)*r,y=cy+Math.sin(a)*r;if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y)}ctx.closePath()};\nRenderer.prototype._poly=function(ctx,cx,cy,r,sides){ctx.beginPath();for(var i=0;i<sides;i++){var a=(Math.PI*2/sides)*i-Math.PI/2,x=cx+Math.cos(a)*r,y=cy+Math.sin(a)*r;if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y)}ctx.closePath()};\nRenderer.prototype.drawTopBar=function(score,level,movesLeft,target){var ctx=this.ctx,w=this.sw;ctx.fillStyle='rgba(22,33,62,0.9)';ctx.fillRect(0,0,w,this.layout.topBarHeight);ctx.fillStyle='#FFF';ctx.font='bold 20px Arial';ctx.textAlign='left';ctx.fillText('分数',16,30);ctx.font='bold 28px Arial';ctx.fillStyle='#FFD700';ctx.fillText(score.toLocaleString(),16,62);ctx.fillStyle='#FFF';ctx.font='bold 18px Arial';ctx.textAlign='center';ctx.fillText('第 '+level+' 关',w/2,30);var pw=w*0.5,ph=12,ppx=(w-pw)/2,ppy=42;ctx.fillStyle='rgba(255,255,255,0.15)';this._rr(ppx,ppy,pw,ph,6);ctx.fill();var prog=Math.min(score/target,1);if(prog>0){var pg=ctx.createLinearGradient(ppx,0,ppx+pw,0);pg.addColorStop(0,'#FFD700');pg.addColorStop(1,'#FF6348');ctx.fillStyle=pg;this._rr(ppx,ppy,pw*prog,ph,6);ctx.fill()}ctx.fillStyle='#FFF';ctx.font='bold 18px Arial';ctx.textAlign='right';ctx.fillText('剩余步数',w-16,30);ctx.font='bold 28px Arial';ctx.fillStyle=movesLeft<=5?'#FF4757':'#2ED573';ctx.fillText(movesLeft.toString(),w-16,62)};\nRenderer.prototype.drawBottomBar=function(){var ctx=this.ctx,w=this.sw;var barY=this.sh-this.layout.bottomBarHeight;ctx.fillStyle='rgba(22,33,62,0.9)';ctx.fillRect(0,barY,w,this.layout.bottomBarHeight);var btnW=140,btnH=44,btnX=(w-btnW)/2,btnY=barY+(this.layout.bottomBarHeight-btnH)/2;ctx.fillStyle='#FF6348';this._rr(btnX,btnY,btnW,btnH,22);ctx.fill();ctx.fillStyle='#FFF';ctx.font='bold 18px Arial';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('重新开始',w/2,btnY+btnH/2);ctx.textBaseline='alphabetic';this._restartBtn={x:btnX,y:btnY,w:btnW,h:btnH}};\nRenderer.prototype.drawGameOver=function(score,level,best){var ctx=this.ctx,w=this.sw,h=this.sh;ctx.fillStyle='rgba(0,0,0,0.75)';ctx.fillRect(0,0,w,h);var cx=w/2,cy=h/2,pw=w*0.8,ph=320,px=cx-pw/2,py=cy-ph/2;ctx.fillStyle='#16213E';this._rr(px,py,pw,ph,20);ctx.fill();ctx.strokeStyle='#FFD700';ctx.lineWidth=2;this._rr(px,py,pw,ph,20);ctx.stroke();ctx.textAlign='center';ctx.fillStyle='#FFD700';ctx.font='bold 30px Arial';ctx.fillText('游戏结束',cx,py+50);ctx.fillStyle='#FFF';ctx.font='20px Arial';ctx.fillText('得分: '+score.toLocaleString(),cx,py+100);ctx.fillStyle='#AAA';ctx.font='18px Arial';ctx.fillText('第 '+level+' 关',cx,py+135);ctx.fillText('最高分: '+best.toLocaleString(),cx,py+165);var bw=160,bh=48,bx=cx-bw/2,by2=py+ph-80;ctx.fillStyle='#2ED573';this._rr(bx,by2,bw,bh,24);ctx.fill();ctx.fillStyle='#FFF';ctx.font='bold 20px Arial';ctx.textBaseline='middle';ctx.fillText('再来一局',cx,by2+bh/2);ctx.textBaseline='alphabetic';this._retryBtn={x:bx,y:by2,w:bw,h:bh}};\nRenderer.prototype.drawLevelComplete=function(score,level,best){var ctx=this.ctx,w=this.sw,h=this.sh;ctx.fillStyle='rgba(0,0,0,0.75)';ctx.fillRect(0,0,w,h);var cx=w/2,cy=h/2,pw=w*0.8,ph=320,px=cx-pw/2,py=cy-ph/2;ctx.fillStyle='#16213E';this._rr(px,py,pw,ph,20);ctx.fill();ctx.strokeStyle='#2ED573';ctx.lineWidth=2;this._rr(px,py,pw,ph,20);ctx.stroke();ctx.textAlign='center';ctx.fillStyle='#2ED573';ctx.font='bold 30px Arial';ctx.fillText('过关！',cx,py+50);ctx.fillStyle='#FFF';ctx.font='20px Arial';ctx.fillText('得分: '+score.toLocaleString(),cx,py+100);ctx.fillStyle='#FFD700';ctx.font='bold 22px Arial';ctx.fillText('进入第 '+(level+1)+' 关',cx,py+145);ctx.fillStyle='#AAA';ctx.font='18px Arial';ctx.fillText('最高分: '+best.toLocaleString(),cx,py+180);var bw=160,bh=48,bx=cx-bw/2,by2=py+ph-80;ctx.fillStyle='#FFD700';this._rr(bx,by2,bw,bh,24);ctx.fill();ctx.fillStyle='#1A1A2E';ctx.font='bold 20px Arial';ctx.textBaseline='middle';ctx.fillText('下一关',cx,by2+bh/2);ctx.textBaseline='alphabetic';this._nextBtn={x:bx,y:by2,w:bw,h:bh}};\nRenderer.prototype.addScorePopup=function(r,c,sc){var l=this.layout;this.scorePopups.push({x:l.x+c*(l.cellSize+config.CELL_GAP)+l.cellSize/2,y:l.y+r*(l.cellSize+config.CELL_GAP),text:'+'+sc,life:1})};\nRenderer.prototype.setComboText=function(combo){if(combo>1)this.comboText={text:combo+'x 连击！',life:1}};\nRenderer.prototype.addParticles=function(r,c,type){var l=this.layout,px=l.x+c*(l.cellSize+config.CELL_GAP)+l.cellSize/2,py=l.y+r*(l.cellSize+config.CELL_GAP)+l.cellSize/2,color=config.PIECE_COLORS[type]||'#FFF';for(var i=0;i<6;i++){var a=(Math.PI*2/6)*i+Math.random()*0.5;this.particles.push({x:px,y:py,vx:Math.cos(a)*(2+Math.random()*3),vy:Math.sin(a)*(2+Math.random()*3),life:1,color:color,size:3+Math.random()*3})}};\nRenderer.prototype.updateEffects=function(dt){for(var i=this.particles.length-1;i>=0;i--){var p=this.particles[i];p.x+=p.vx;p.y+=p.vy;p.vy+=0.15;p.life-=dt*2;if(p.life<=0)this.particles.splice(i,1)}for(var i=this.scorePopups.length-1;i>=0;i--){var p=this.scorePopups[i];p.y-=1.5;p.life-=dt*1.5;if(p.life<=0)this.scorePopups.splice(i,1)}if(this.comboText){this.comboText.life-=dt;if(this.comboText.life<=0)this.comboText=null}if(this.screenShake>0)this.screenShake-=dt*10};\nRenderer.prototype.drawEffects=function(){var ctx=this.ctx;if(this.screenShake>0){var s=this.screenShake*2;ctx.save();ctx.translate((Math.random()-0.5)*s,(Math.random()-0.5)*s)}for(var i=0;i<this.particles.length;i++){var p=this.particles[i];ctx.globalAlpha=p.life;ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(p.x,p.y,p.size*p.life,0,Math.PI*2);ctx.fill()}ctx.globalAlpha=1;for(var i=0;i<this.scorePopups.length;i++){var p=this.scorePopups[i];ctx.globalAlpha=p.life;ctx.fillStyle='#FFD700';ctx.font='bold 18px Arial';ctx.textAlign='center';ctx.fillText(p.text,p.x,p.y)}ctx.globalAlpha=1;if(this.comboText){ctx.globalAlpha=this.comboText.life;ctx.fillStyle='#FF6348';ctx.font='bold 32px Arial';ctx.textAlign='center';ctx.fillText(this.comboText.text,this.sw/2,this.layout.y-20)}ctx.globalAlpha=1;if(this.screenShake>0)ctx.restore()};\nRenderer.prototype.setPieceOffset=function(r,c,dx,dy){this.pieceOffset[r+','+c]={dx:dx,dy:dy}};\nRenderer.prototype.clearPieceOffset=function(r,c){delete this.pieceOffset[r+','+c]};\nRenderer.prototype.setPieceScale=function(r,c,s){this.pieceScale[r+','+c]=s};\nRenderer.prototype.clearPieceScale=function(r,c){delete this.pieceScale[r+','+c]};\nRenderer.prototype._rr=function(x,y,w,h,r){var ctx=this.ctx;ctx.beginPath();ctx.moveTo(x+r,y);ctx.lineTo(x+w-r,y);ctx.quadraticCurveTo(x+w,y,x+w,y+r);ctx.lineTo(x+w,y+h-r);ctx.quadraticCurveTo(x+w,y+h,x+w-r,y+h);ctx.lineTo(x+r,y+h);ctx.quadraticCurveTo(x,y+h,x,y+h-r);ctx.lineTo(x,y+r);ctx.quadraticCurveTo(x,y,x+r,y);ctx.closePath()};\nRenderer.prototype._dk=function(hex,f){var n=parseInt(hex.slice(1),16),r=Math.floor(((n>>16)&0xFF)*f),g=Math.floor(((n>>8)&0xFF)*f),b=Math.floor((n&0xFF)*f);return '#'+((1<<24)+(r<<16)+(g<<8)+b).toString(16).slice(1)};\n\n// --- Page ---\nfunction calcLayout(sw, sh) {\n  var topH=config.TOP_BAR_HEIGHT, botH=config.BOTTOM_BAR_HEIGHT;\n  var availH=sh-topH-botH, availW=sw-32;\n  var gap=config.CELL_GAP;\n  var maxCW=(availW-gap*(config.GRID_SIZE-1))/config.GRID_SIZE;\n  var maxCH=(availH-gap*(config.GRID_SIZE-1)-20)/config.GRID_SIZE;\n  var cs=Math.floor(Math.min(maxCW,maxCH));\n  var bw=cs*config.GRID_SIZE+gap*(config.GRID_SIZE-1);\n  return {x:(sw-bw)/2, y:topH+(availH-bw)/2, width:bw, height:bw, cellSize:cs, topBarHeight:topH, bottomBarHeight:botH};\n}\n\nPage({\n  data: {},\n  onReady: function () {\n    var self = this;\n    var query = tt.createSelectorQuery();\n    query.select('#gameCanvas').fields({ node: true, size: true }).exec(function (res) {\n      if (!res || !res[0] || !res[0].node) return;\n      var canvas = res[0].node;\n      var ctx = canvas.getContext('2d');\n      var sysInfo = tt.getSystemInfoSync();\n      var dpr = sysInfo.pixelRatio || 1;\n      var sw = sysInfo.windowWidth;\n      var sh = sysInfo.windowHeight;\n\n      canvas.width = sw * dpr;\n      canvas.height = sh * dpr;\n      ctx.scale(dpr, dpr);\n\n      var layout = calcLayout(sw, sh);\n      var board = new Board();\n      var renderer = new Renderer(ctx, layout);\n      renderer.sw = sw;\n      renderer.sh = sh;\n      var input = new InputHandler(layout);\n      var anim = new AnimMgr();\n      var score = new ScoreManager();\n      var state = 'idle';\n\n      input.onSelect = function (cell) {\n        renderer.selectedCell = cell;\n        if (cell) tt.vibrateShort({ type: 'light' });\n      };\n      input.onSwap = function (r1, c1, r2, c2) {\n        tt.vibrateShort({ type: 'light' });\n        state = 'swapping';\n        var cs = layout.cellSize;\n        var dx = (c2 - c1) * (cs + config.CELL_GAP);\n        var dy = (r2 - r1) * (cs + config.CELL_GAP);\n        anim.add(150, function (t) {\n          var e = easeOutQuad(t);\n          renderer.setPieceOffset(r1, c1, dx * e, dy * e);\n          renderer.setPieceOffset(r2, c2, -dx * e, -dy * e);\n        }, function () {\n          renderer.clearPieceOffset(r1, c1);\n          renderer.clearPieceOffset(r2, c2);\n          board.swap(r1, c1, r2, c2);\n          var ms = board.findMatches();\n          if (ms.length === 0) {\n            anim.add(150, function (t) {\n              var e = easeOutQuad(t);\n              renderer.setPieceOffset(r1, c1, -dx * e, -dy * e);\n              renderer.setPieceOffset(r2, c2, dx * e, dy * e);\n            }, function () {\n              renderer.clearPieceOffset(r1, c1);\n              renderer.clearPieceOffset(r2, c2);\n              board.swap(r1, c1, r2, c2);\n              state = 'idle';\n            });\n          } else {\n            score.useMove();\n            score.startCombo();\n            processMatches();\n          }\n        });\n      };\n      input.onBtnClick = function (x, y) {\n        if (state === 'gameover') {\n          var b = renderer._retryBtn;\n          if (b && x >= b.x && x <= b.x + b.w && y >= b.y && y <= b.y + b.h) restart();\n        }\n        if (state === 'levelcomplete') {\n          var b = renderer._nextBtn;\n          if (b && x >= b.x && x <= b.x + b.w && y >= b.y && y <= b.y + b.h) nextLevel();\n        }\n        var rb = renderer._restartBtn;\n        if (rb && x >= rb.x && x <= rb.x + rb.w && y >= rb.y && y <= rb.y + rb.h) restart();\n      };\n\n      function groupMatches(ms) {\n        var set = {}, i;\n        for (i = 0; i < ms.length; i++) set[ms[i].r + ',' + ms[i].c] = ms[i];\n        var visited = {}, groups = [];\n        for (i = 0; i < ms.length; i++) {\n          var k = ms[i].r + ',' + ms[i].c;\n          if (visited[k]) continue;\n          var group = [], queue = [ms[i]];\n          while (queue.length > 0) {\n            var cur = queue.pop(), ck = cur.r + ',' + cur.c;\n            if (visited[ck]) continue;\n            visited[ck] = true;\n            group.push(cur);\n            var dirs = [[0, 1], [0, -1], [1, 0], [-1, 0]];\n            for (var d = 0; d < 4; d++) {\n              var nk = (cur.r + dirs[d][0]) + ',' + (cur.c + dirs[d][1]);\n              if (set[nk] && !visited[nk]) queue.push(set[nk]);\n            }\n          }\n          groups.push(group);\n        }\n        return groups;\n      }\n\n      function processMatches() {\n        var ms = board.findMatches();\n        if (ms.length === 0) {\n          if (!board.hasValidMoves()) board.shuffle();\n          if (score.isLevelComplete()) { state = 'levelcomplete'; score.saveBest(); }\n          else if (score.isGameOver()) { state = 'gameover'; score.saveBest(); }\n          else state = 'idle';\n          return;\n        }\n        var combo = score.incrementCombo();\n        renderer.setComboText(combo);\n        renderer.screenShake = 1.5;\n        var groups = groupMatches(ms);\n        for (var i = 0; i < groups.length; i++) {\n          var pts = score.addScore(groups[i].length);\n          var avgR = 0, avgC = 0;\n          for (var j = 0; j < groups[i].length; j++) { avgR += groups[i][j].r; avgC += groups[i][j].c; }\n          avgR /= groups[i].length;\n          avgC /= groups[i].length;\n          renderer.addScorePopup(avgR, avgC, pts);\n        }\n        state = 'removing';\n        var removed = board.removeMatches(ms);\n        for (var i = 0; i < removed.length; i++) renderer.addParticles(removed[i].r, removed[i].c, removed[i].type);\n        anim.add(200, function (t) {\n          for (var i = 0; i < removed.length; i++) renderer.setPieceScale(removed[i].r, removed[i].c, 1 - easeOutQuad(t));\n        }, function () {\n          for (var i = 0; i < removed.length; i++) renderer.clearPieceScale(removed[i].r, removed[i].c);\n          applyGravity();\n        });\n      }\n\n      function applyGravity() {\n        state = 'falling';\n        var moves = board.applyGravity();\n        var spawns = board.refill();\n        var cs = layout.cellSize;\n        var all = [];\n        for (var i = 0; i < moves.length; i++) all.push({ r: moves[i].toR, c: moves[i].toC, fromDy: (moves[i].fromR - moves[i].toR) * (cs + config.CELL_GAP) });\n        for (var i = 0; i < spawns.length; i++) all.push({ r: spawns[i].r, c: spawns[i].c, fromDy: (spawns[i].fromR - spawns[i].r) * (cs + config.CELL_GAP) });\n        if (all.length === 0) { processMatches(); return; }\n        anim.add(300, function (t) {\n          var e = easeOutBounce(t);\n          for (var i = 0; i < all.length; i++) renderer.setPieceOffset(all[i].r, all[i].c, 0, all[i].fromDy * (1 - e));\n        }, function () {\n          for (var i = 0; i < all.length; i++) renderer.clearPieceOffset(all[i].r, all[i].c);\n          processMatches();\n        });\n      }\n\n      function restart() {\n        board.init(); score.reset(); anim.clear();\n        renderer.particles = []; renderer.scorePopups = []; renderer.comboText = null;\n        renderer.screenShake = 0; renderer.pieceOffset = {}; renderer.pieceScale = {};\n        input.reset(); state = 'idle';\n      }\n\n      function nextLevel() {\n        score.nextLevel(); board.init(); anim.clear();\n        renderer.particles = []; renderer.scorePopups = []; renderer.comboText = null;\n        renderer.screenShake = 0; renderer.pieceOffset = {}; renderer.pieceScale = {};\n        input.reset(); state = 'idle';\n      }\n\n      var lastTime = Date.now();\n      function loop() {\n        var now = Date.now(), dt = Math.min((now - lastTime) / 1000, 0.1);\n        lastTime = now;\n        anim.update(dt * 1000);\n        renderer.updateEffects(dt);\n        renderer.clear();\n        renderer.drawBackground();\n        renderer.drawTopBar(score.score, score.level, score.movesLeft, score.targetScore);\n        renderer.drawBoard();\n        renderer.drawPieces(board);\n        renderer.drawEffects();\n        renderer.drawBottomBar();\n        if (state === 'gameover') renderer.drawGameOver(score.score, score.level, score.bestScore);\n        if (state === 'levelcomplete') renderer.drawLevelComplete(score.score, score.level, score.bestScore);\n        canvas.requestAnimationFrame(loop);\n      }\n\n      self._game = { board: board, renderer: renderer, input: input, anim: anim, score: score, state: state, restart: restart, nextLevel: nextLevel };\n      loop();\n    });\n  },\n  onTouchStart: function (e) {\n    if (!this._game) return;\n    var g = this._game;\n    var touch = e.touches[0];\n    var x = touch.x !== undefined ? touch.x : touch.clientX;\n    var y = touch.y !== undefined ? touch.y : touch.clientY;\n    if (g.state === 'gameover' || g.state === 'levelcomplete') {\n      g.input.handleClick(x, y);\n      return;\n    }\n    if (g.state !== 'idle') return;\n    g.input.handleTouchStart(x, y);\n  },\n  onTouchMove: function (e) {\n    if (!this._game) return;\n    var g = this._game;\n    var touch = e.touches[0];\n    var x = touch.x !== undefined ? touch.x : touch.clientX;\n    var y = touch.y !== undefined ? touch.y : touch.clientY;\n    if (g.state !== 'idle') return;\n    g.input.handleTouchMove(x, y);\n  },\n  onTouchEnd: function () {\n    if (!this._game) return;\n    this._game.input.handleTouchEnd();\n  }\n});\n","numLines":319,"startLine":1,"totalLines":319}}}
