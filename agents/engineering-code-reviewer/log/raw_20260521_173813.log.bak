{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6a95aca1af944c5aa8d0dc1d","type":"tool_result","content":"1\t\"\"\"\n2\tLoopCLI shared library — common functions used by server.py and run.py.\n3\t\"\"\"\n4\t\n5\timport json\n6\timport os\n7\timport threading\n8\tfrom pathlib import Path\n9\t\n10\tLOOPCLI_ROOT = Path(r\"D:\\loopcli\")\n11\tAGENT_MARKER = \"AGENT\"\n12\t\n13\t_json_lock = threading.Lock()\n14\t\n15\t\n16\t# ─── JSON I/O ───\n17\t\n18\tdef read_json(path, default=None):\n19\t    \"\"\"Read and parse a JSON file, returning default on failure.\"\"\"\n20\t    path = Path(path)\n21\t    if not path.exists():\n22\t        return default if default is not None else {}\n23\t    try:\n24\t        return json.loads(path.read_text(encoding=\"utf-8\"))\n25\t    except (json.JSONDecodeError, OSError):\n26\t        return default if default is not None else {}\n27\t\n28\t\n29\tdef write_json(path, data):\n30\t    \"\"\"Atomically write data as JSON with thread-safe locking.\"\"\"\n31\t    path = Path(path)\n32\t    with _json_lock:\n33\t        path.parent.mkdir(parents=True, exist_ok=True)\n34\t        path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n35\t\n36\t\n37\t# ─── Agent path safety ───\n38\t\n39\tdef safe_agent_path(agent_id: str) -> Path | None:\n40\t    \"\"\"Validate and resolve an agent directory path, preventing traversal attacks.\"\"\"\n41\t    if not agent_id or '/' in agent_id or '\\\\' in agent_id or '..' in agent_id or '\\x00' in agent_id:\n42\t        return None\n43\t    agent_dir = LOOPCLI_ROOT / agent_id\n44\t    try:\n45\t        agent_dir.resolve().relative_to(LOOPCLI_ROOT.resolve())\n46\t    except ValueError:\n47\t        return None\n48\t    return agent_dir\n49\t\n50\t\n51\t# ─── Agent discovery ───\n52\t\n53\tdef get_agent_marker(agent_dir) -> str | None:\n54\t    \"\"\"Read AGENT marker file content, or None if missing.\"\"\"\n55\t    marker = Path(agent_dir) / AGENT_MARKER\n56\t    if marker.is_file():\n57\t        return marker.read_text(encoding=\"utf-8\").strip()\n58\t    return None\n59\t\n60\t\n61\tdef is_agent_enabled(agent_dir) -> bool:\n62\t    \"\"\"Check if an agent directory has a valid, non-disabled AGENT marker.\"\"\"\n63\t    content = get_agent_marker(agent_dir)\n64\t    if content is None:\n65\t        return False\n66\t    return \"disabled\" not in content\n67\t\n68\t\n69\tdef discover_agents(include_disabled=False):\n70\t    \"\"\"Discover agent directories under LOOPCLI_ROOT.\n71\t\n72\t    Returns list of {\"name\": str, \"path\": str}.\n73\t    \"\"\"\n74\t    agents = []\n75\t    for child in LOOPCLI_ROOT.iterdir():\n76\t        if not child.is_dir():\n77\t            continue\n78\t        if not (child / AGENT_MARKER).exists():\n79\t            continue\n80\t        if include_disabled or is_agent_enabled(child):\n81\t            agents.append({\"name\": child.name, \"path\": str(child)})\n82\t    return agents\n83\t\n84\t\n85\tdef scan_agents():\n86\t    \"\"\"Full agent scan with metadata (state, soul, task counts).\"\"\"\n87\t    agents = []\n88\t    for child in LOOPCLI_ROOT.iterdir():\n89\t        if not child.is_dir():\n90\t            continue\n91\t        if not (child / AGENT_MARKER).exists():\n92\t            continue\n93\t        state = read_json(child / \"memory\" / \"state.json\", {})\n94\t        soul_path = child / \"SOUL.md\"\n95\t        desc = \"\"\n96\t        if soul_path.exists():\n97\t            for line in soul_path.read_text(encoding=\"utf-8\").strip().splitlines():\n98\t                stripped = line.strip()\n99\t                if stripped and not stripped.startswith(\"#\"):\n100\t                    desc = stripped\n101\t                    break\n102\t        tasks = read_json(child / \"memory\" / \"tasks.json\", [])\n103\t        done_count = sum(1 for t in tasks if t.get(\"status\") == \"done\")\n104\t        pending_count = sum(1 for t in tasks if t.get(\"status\") == \"pending\")\n105\t        agents.append({\n106\t            \"id\": child.name,\n107\t            \"name\": state.get(\"agent\", child.name),\n108\t            \"status\": state.get(\"status\", \"unknown\"),\n109\t            \"description\": desc,\n110\t            \"last_run\": state.get(\"last_run\"),\n111\t            \"run_count\": state.get(\"run_count\", 0),\n112\t            \"current_task\": state.get(\"current_task\"),\n113\t            \"task_count\": len(tasks),\n114\t            \"task_done\": done_count,\n115\t            \"task_pending\": pending_count,\n116\t        })\n117\t    return agents\n118\t\n119\t\n120\t# ─── Task management ───\n121\t\n122\tdef next_task_id(tasks):\n123\t    \"\"\"Get the next auto-increment task ID from a task list.\"\"\"\n124\t    return max((t.get(\"id\", 0) for t in tasks), default=0) + 1\n125\t\n126\t\n127\tdef create_task(agent_dir, title, description=\"\", assignee=None, created=None):\n128\t    \"\"\"Create a new task in an agent's tasks.json and return the task dict.\"\"\"\n129\t    from datetime import datetime, timezone\n130\t    agent_dir = Path(agent_dir)\n131\t    tasks_file = agent_dir / \"memory\" / \"tasks.json\"\n132\t    tasks = read_json(tasks_file, [])\n133\t    new_id = next_task_id(tasks)\n134\t    task = {\n135\t        \"id\": new_id,\n136\t        \"status\": \"pending\",\n137\t        \"title\": title,\n138\t        \"description\": description,\n139\t        \"created\": created or datetime.now(timezone.utc).strftime(\"%Y-%m-%d\"),\n140\t        \"assignee\": assignee or agent_dir.name,\n141\t    }\n142\t    tasks.append(task)\n143\t    write_json(tasks_file, tasks)\n144\t    return task\n145\t\n146\t\n147\tdef get_agent_tasks(agent_id):\n148\t    \"\"\"Get tasks for a specific agent by ID. Returns None if agent_id is invalid.\"\"\"\n149\t    agent_dir = safe_agent_path(agent_id)\n150\t    if not agent_dir:\n151\t        return None\n152\t    return read_json(agent_dir / \"memory\" / \"tasks.json\", [])\n153\t\n154\t\n155\tdef get_all_agent_tasks():\n156\t    \"\"\"Aggregate tasks from all agents, each tagged with _agent_id.\"\"\"\n157\t    all_tasks = []\n158\t    for child in LOOPCLI_ROOT.iterdir():\n159\t        if not child.is_dir() or not (child / AGENT_MARKER).exists():\n160\t            continue\n161\t        tasks = read_json(child / \"memory\" / \"tasks.json\", [])\n162\t        for t in tasks:\n163\t            t[\"_agent_id\"] = child.name\n164\t        all_tasks.extend(tasks)\n165\t    return all_tasks\n166\t\n167\t\n168\t# ─── Message / inbox ───\n169\t\n170\tdef write_inbox_message(agent_dir, sender, content, msg_type=\"指令\"):\n171\t    \"\"\"Write a message to an agent's inbox directory. Returns the message file path.\"\"\"\n172\t    import uuid\n173\t    from datetime import datetime\n174\t    agent_dir = Path(agent_dir)\n175\t    inbox_dir = agent_dir / \"inbox\"\n176\t    inbox_dir.mkdir(parents=True, exist_ok=True)\n177\t    now = datetime.now()\n178\t    ts = now.strftime(\"%Y%m%d_%H%M\")\n179\t    msg_file = inbox_dir / f\"{sender}_{ts}_{uuid.uuid4().hex[:8]}.md\"\n180\t    msg_file.write_text(\n181\t        f\"# 来自 {sender} 的消息\\n- 类型：{msg_type}\\n- 时间：{now.strftime('%Y-%m-%d %H:%M')}\\n\\n## 内容\\n{content}\\n\",\n182\t        encoding=\"utf-8\",\n183\t    )\n184\t    return msg_file\n185\t\n186\t\n187\t# ─── Agent enable/disable ───\n188\t\n189\tdef set_agent_enabled(agent_dir, enabled=True):\n190\t    \"\"\"Enable or disable an agent by writing its AGENT marker.\"\"\"\n191\t    agent_dir = Path(agent_dir)\n192\t    marker = agent_dir / AGENT_MARKER\n193\t    if enabled:\n194\t        marker.write_text(\"type: main\\n\", encoding=\"utf-8\")\n195\t    else:\n196\t        marker.write_text(\"type: main\\ndisabled: true\\n\", encoding=\"utf-8\")\n197\t\n198\t\n199\t# ─── File utilities ───\n200\t\n201\tdef get_recent_lines(filepath, n=100):\n202\t    \"\"\"Read the last N lines from a text file.\"\"\"\n203\t    filepath = Path(filepath)\n204\t    if not filepath.exists():\n205\t        return []\n206\t    try:\n207\t        with open(filepath, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n208\t            lines = f.readlines()\n209\t        return [l.rstrip(\"\\n\\r\") for l in lines[-n:]]\n210\t    except OSError:\n211\t        return []\n212\t\n213\t\n214\tdef read_file_tail_incremental(filepath, last_pos=0):\n215\t    \"\"\"Read only new content appended since last_pos.\n216\t\n217\t    Returns (new_lines, new_pos). Efficient for SSE/polling scenarios.\n218\t    \"\"\"\n219\t    filepath = Path(filepath)\n220\t    if not filepath.exists():\n221\t        return [], 0\n222\t    try:\n223\t        size = filepath.stat().st_size\n224\t        if size < last_pos:\n225\t            # File was truncated/rotated — read from start\n226\t            last_pos = 0\n227\t        if size == last_pos:\n228\t            return [], last_pos\n229\t        with open(filepath, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n230\t            f.seek(last_pos)\n231\t            new_content = f.read()\n232\t            new_pos = f.tell()\n233\t        lines = [l.rstrip(\"\\n\\r\") for l in new_content.splitlines()]\n234\t        return lines, new_pos\n235\t    except OSError:\n236\t        return [], last_pos\n237\t"}]},"parent_tool_use_id":null,"session_id":"53eb080d-5854-4f04-96ec-a843eb289f59","uuid":"61557896-f73c-4422-865c-9954088286de","timestamp":"2026-05-21T01:03:23.260Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\loopcli\\main\\webui\\loopcli_lib.py","content":"\"\"\"\nLoopCLI shared library — common functions used by server.py and run.py.\n\"\"\"\n\nimport json\nimport os\nimport threading\nfrom pathlib import Path\n\nLOOPCLI_ROOT = Path(r\"D:\\loopcli\")\nAGENT_MARKER = \"AGENT\"\n\n_json_lock = threading.Lock()\n\n\n# ─── JSON I/O ───\n\ndef read_json(path, default=None):\n    \"\"\"Read and parse a JSON file, returning default on failure.\"\"\"\n    path = Path(path)\n    if not path.exists():\n        return default if default is not None else {}\n    try:\n        return json.loads(path.read_text(encoding=\"utf-8\"))\n    except (json.JSONDecodeError, OSError):\n        return default if default is not None else {}\n\n\ndef write_json(path, data):\n    \"\"\"Atomically write data as JSON with thread-safe locking.\"\"\"\n    path = Path(path)\n    with _json_lock:\n        path.parent.mkdir(parents=True, exist_ok=True)\n        path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n\n\n# ─── Agent path safety ───\n\ndef safe_agent_path(agent_id: str) -> Path | None:\n    \"\"\"Validate and resolve an agent directory path, preventing traversal attacks.\"\"\"\n    if not agent_id or '/' in agent_id or '\\\\' in agent_id or '..' in agent_id or '\\x00' in agent_id:\n        return None\n    agent_dir = LOOPCLI_ROOT / agent_id\n    try:\n        agent_dir.resolve().relative_to(LOOPCLI_ROOT.resolve())\n    except ValueError:\n        return None\n    return agent_dir\n\n\n# ─── Agent discovery ───\n\ndef get_agent_marker(agent_dir) -> str | None:\n    \"\"\"Read AGENT marker file content, or None if missing.\"\"\"\n    marker = Path(agent_dir) / AGENT_MARKER\n    if marker.is_file():\n        return marker.read_text(encoding=\"utf-8\").strip()\n    return None\n\n\ndef is_agent_enabled(agent_dir) -> bool:\n    \"\"\"Check if an agent directory has a valid, non-disabled AGENT marker.\"\"\"\n    content = get_agent_marker(agent_dir)\n    if content is None:\n        return False\n    return \"disabled\" not in content\n\n\ndef discover_agents(include_disabled=False):\n    \"\"\"Discover agent directories under LOOPCLI_ROOT.\n\n    Returns list of {\"name\": str, \"path\": str}.\n    \"\"\"\n    agents = []\n    for child in LOOPCLI_ROOT.iterdir():\n        if not child.is_dir():\n            continue\n        if not (child / AGENT_MARKER).exists():\n            continue\n        if include_disabled or is_agent_enabled(child):\n            agents.append({\"name\": child.name, \"path\": str(child)})\n    return agents\n\n\ndef scan_agents():\n    \"\"\"Full agent scan with metadata (state, soul, task counts).\"\"\"\n    agents = []\n    for child in LOOPCLI_ROOT.iterdir():\n        if not child.is_dir():\n            continue\n        if not (child / AGENT_MARKER).exists():\n            continue\n        state = read_json(child / \"memory\" / \"state.json\", {})\n        soul_path = child / \"SOUL.md\"\n        desc = \"\"\n        if soul_path.exists():\n            for line in soul_path.read_text(encoding=\"utf-8\").strip().splitlines():\n                stripped = line.strip()\n                if stripped and not stripped.startswith(\"#\"):\n                    desc = stripped\n                    break\n        tasks = read_json(child / \"memory\" / \"tasks.json\", [])\n        done_count = sum(1 for t in tasks if t.get(\"status\") == \"done\")\n        pending_count = sum(1 for t in tasks if t.get(\"status\") == \"pending\")\n        agents.append({\n            \"id\": child.name,\n            \"name\": state.get(\"agent\", child.name),\n            \"status\": state.get(\"status\", \"unknown\"),\n            \"description\": desc,\n            \"last_run\": state.get(\"last_run\"),\n            \"run_count\": state.get(\"run_count\", 0),\n            \"current_task\": state.get(\"current_task\"),\n            \"task_count\": len(tasks),\n            \"task_done\": done_count,\n            \"task_pending\": pending_count,\n        })\n    return agents\n\n\n# ─── Task management ───\n\ndef next_task_id(tasks):\n    \"\"\"Get the next auto-increment task ID from a task list.\"\"\"\n    return max((t.get(\"id\", 0) for t in tasks), default=0) + 1\n\n\ndef create_task(agent_dir, title, description=\"\", assignee=None, created=None):\n    \"\"\"Create a new task in an agent's tasks.json and return the task dict.\"\"\"\n    from datetime import datetime, timezone\n    agent_dir = Path(agent_dir)\n    tasks_file = agent_dir / \"memory\" / \"tasks.json\"\n    tasks = read_json(tasks_file, [])\n    new_id = next_task_id(tasks)\n    task = {\n        \"id\": new_id,\n        \"status\": \"pending\",\n        \"title\": title,\n        \"description\": description,\n        \"created\": created or datetime.now(timezone.utc).strftime(\"%Y-%m-%d\"),\n        \"assignee\": assignee or agent_dir.name,\n    }\n    tasks.append(task)\n    write_json(tasks_file, tasks)\n    return task\n\n\ndef get_agent_tasks(agent_id):\n    \"\"\"Get tasks for a specific agent by ID. Returns None if agent_id is invalid.\"\"\"\n    agent_dir = safe_agent_path(agent_id)\n    if not agent_dir:\n        return None\n    return read_json(agent_dir / \"memory\" / \"tasks.json\", [])\n\n\ndef get_all_agent_tasks():\n    \"\"\"Aggregate tasks from all agents, each tagged with _agent_id.\"\"\"\n    all_tasks = []\n    for child in LOOPCLI_ROOT.iterdir():\n        if not child.is_dir() or not (child / AGENT_MARKER).exists():\n            continue\n        tasks = read_json(child / \"memory\" / \"tasks.json\", [])\n        for t in tasks:\n            t[\"_agent_id\"] = child.name\n        all_tasks.extend(tasks)\n    return all_tasks\n\n\n# ─── Message / inbox ───\n\ndef write_inbox_message(agent_dir, sender, content, msg_type=\"指令\"):\n    \"\"\"Write a message to an agent's inbox directory. Returns the message file path.\"\"\"\n    import uuid\n    from datetime import datetime\n    agent_dir = Path(agent_dir)\n    inbox_dir = agent_dir / \"inbox\"\n    inbox_dir.mkdir(parents=True, exist_ok=True)\n    now = datetime.now()\n    ts = now.strftime(\"%Y%m%d_%H%M\")\n    msg_file = inbox_dir / f\"{sender}_{ts}_{uuid.uuid4().hex[:8]}.md\"\n    msg_file.write_text(\n        f\"# 来自 {sender} 的消息\\n- 类型：{msg_type}\\n- 时间：{now.strftime('%Y-%m-%d %H:%M')}\\n\\n## 内容\\n{content}\\n\",\n        encoding=\"utf-8\",\n    )\n    return msg_file\n\n\n# ─── Agent enable/disable ───\n\ndef set_agent_enabled(agent_dir, enabled=True):\n    \"\"\"Enable or disable an agent by writing its AGENT marker.\"\"\"\n    agent_dir = Path(agent_dir)\n    marker = agent_dir / AGENT_MARKER\n    if enabled:\n        marker.write_text(\"type: main\\n\", encoding=\"utf-8\")\n    else:\n        marker.write_text(\"type: main\\ndisabled: true\\n\", encoding=\"utf-8\")\n\n\n# ─── File utilities ───\n\ndef get_recent_lines(filepath, n=100):\n    \"\"\"Read the last N lines from a text file.\"\"\"\n    filepath = Path(filepath)\n    if not filepath.exists():\n        return []\n    try:\n        with open(filepath, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n            lines = f.readlines()\n        return [l.rstrip(\"\\n\\r\") for l in lines[-n:]]\n    except OSError:\n        return []\n\n\ndef read_file_tail_incremental(filepath, last_pos=0):\n    \"\"\"Read only new content appended since last_pos.\n\n    Returns (new_lines, new_pos). Efficient for SSE/polling scenarios.\n    \"\"\"\n    filepath = Path(filepath)\n    if not filepath.exists():\n        return [], 0\n    try:\n        size = filepath.stat().st_size\n        if size < last_pos:\n            # File was truncated/rotated — read from start\n            last_pos = 0\n        if size == last_pos:\n            return [], last_pos\n        with open(filepath, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n            f.seek(last_pos)\n            new_content = f.read()\n            new_pos = f.tell()\n        lines = [l.rstrip(\"\\n\\r\") for l in new_content.splitlines()]\n        return lines, new_pos\n    except OSError:\n        return [], last_pos\n","numLines":237,"startLine":1,"totalLines":237}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f477eedbb74c4de1ba957d2f","type":"tool_result","content":"1\timport argparse\n2\timport json\n3\timport msvcrt\n4\timport os\n5\timport shutil\n6\timport subprocess\n7\timport sys\n8\timport threading\n9\timport time\n10\tfrom datetime import datetime\n11\tfrom pathlib import Path\n12\t\n13\tsys.path.insert(0, r\"D:\\loopcli\\main\\webui\")\n14\tfrom loopcli_lib import (\n15\t    LOOPCLI_ROOT,\n16\t    AGENT_MARKER,\n17\t    read_json,\n18\t    write_json,\n19\t    safe_agent_path,\n20\t    get_agent_marker,\n21\t    is_agent_enabled,\n22\t    discover_agents as _discover_agents,\n23\t    create_task,\n24\t    write_inbox_message,\n25\t    set_agent_enabled,\n26\t)\n27\t\n28\tLOOPCLI_DIR = str(LOOPCLI_ROOT)\n29\tSUBAGENT_DIR = os.path.join(LOOPCLI_DIR, \"subagent\")\n30\tCLAUDE = os.path.join(os.environ.get(\"APPDATA\", \"\"), \"npm\", \"claude.cmd\")\n31\t\n32\tLOGS_DIR = os.path.join(LOOPCLI_DIR, \"logs\")\n33\tGIT_TOKEN_FILE = os.path.join(LOOPCLI_DIR, \".gittoken\")\n34\tDEFAULT_PROMPT = \"\"\"读取 SOUL.md 作为你的身份。\n35\t读取 D:/loopcli/skill/ 下所有技能文件（全局技能）。\n36\t读取 memory/tasks.json 获取分配给你的任务。\n37\t\n38\t执行步骤：\n39\t1. 从 tasks.json 中找 status 为 \"pending\" 的第一个任务\n40\t2. 执行该任务\n41\t3. 将结果写入 memory/results/ 目录（以时间戳命名）\n42\t4. 将该任务 status 改为 \"done\"，写回 tasks.json\n43\t5. 更新 memory/state.json（标记完成、记录时间戳）\n44\t6. 将本次运行摘要追加到 log/run.md\n45\t7. 通过 inbox 通知 main：写入 D:/loopcli/main/inbox/<你的名字>_<时间>.md，简要报告任务结果\n46\t8. 如果没有 pending 任务，输出 \"IDLE\" 并结束本轮\n47\t\"\"\"\n48\t\n49\t\n50\t# ─── 工具函数 ───\n51\t\n52\tdef discover_agents(include_disabled=False):\n53\t    \"\"\"Wrapper that returns same format as before (name+path strings).\"\"\"\n54\t    return _discover_agents(include_disabled=include_disabled)\n55\t\n56\t\n57\tdef find_template(template_id):\n58\t    \"\"\"在 subagent 目录下搜索模板文件\"\"\"\n59\t    for dept in os.listdir(SUBAGENT_DIR):\n60\t        dept_dir = os.path.join(SUBAGENT_DIR, dept)\n61\t        if not os.path.isdir(dept_dir):\n62\t            continue\n63\t        candidate = os.path.join(dept_dir, f\"{template_id}.md\")\n64\t        if os.path.isfile(candidate):\n65\t            return candidate\n66\t    return None\n67\t\n68\t\n69\tdef load_agent_state(agent_path):\n70\t    state_file = os.path.join(agent_path, \"memory\", \"state.json\")\n71\t    if os.path.isfile(state_file):\n72\t        return read_json(state_file)\n73\t    return None\n74\t\n75\t\n76\tdef load_agent_tasks(agent_path):\n77\t    tasks_file = os.path.join(agent_path, \"memory\", \"tasks.json\")\n78\t    if os.path.isfile(tasks_file):\n79\t        return read_json(tasks_file, [])\n80\t    return []\n81\t\n82\t\n83\tdef rotate_log(log_path, max_size=1_000_000, max_backups=3):\n84\t    \"\"\"轮转日志文件：超过 max_size 时依次重命名为 .1 .2 .3，最多保留 max_backups 个归档\"\"\"\n85\t    if not os.path.isfile(log_path):\n86\t        return\n87\t    try:\n88\t        if os.path.getsize(log_path) < max_size:\n89\t            return\n90\t    except OSError:\n91\t        return\n92\t    oldest = f\"{log_path}.{max_backups}\"\n93\t    if os.path.isfile(oldest):\n94\t        os.remove(oldest)\n95\t    for i in range(max_backups, 1, -1):\n96\t        src = f\"{log_path}.{i - 1}\"\n97\t        dst = f\"{log_path}.{i}\"\n98\t        if os.path.isfile(src):\n99\t            os.rename(src, dst)\n100\t    os.rename(log_path, f\"{log_path}.1\")\n101\t\n102\t\n103\t# ─── 子命令: create ───\n104\t\n105\tdef cmd_create(args):\n106\t    template_id = args.template\n107\t    task_desc = args.task or \"\"\n108\t\n109\t    tpl_file = find_template(template_id)\n110\t    if not tpl_file:\n111\t        print(f\"[错误] 找不到模板: {template_id}\")\n112\t        print(\"用 loopcli templates 查看所有可用模板\")\n113\t        sys.exit(1)\n114\t\n115\t    with open(tpl_file, \"r\", encoding=\"utf-8\") as f:\n116\t        soul_content = f.read()\n117\t\n118\t    agent_dir = os.path.join(LOOPCLI_DIR, template_id)\n119\t    if os.path.exists(agent_dir):\n120\t        print(f\"[跳过] Agent 已存在: {agent_dir}\")\n121\t        if task_desc:\n122\t            cmd_task_inner(template_id, task_desc, \"\")\n123\t        return\n124\t\n125\t    os.makedirs(os.path.join(agent_dir, \"memory\", \"results\"), exist_ok=True)\n126\t    os.makedirs(os.path.join(agent_dir, \"log\"), exist_ok=True)\n127\t\n128\t    with open(os.path.join(agent_dir, AGENT_MARKER), \"w\", encoding=\"utf-8\") as f:\n129\t        f.write(\"type: main\\n\")\n130\t\n131\t    with open(os.path.join(agent_dir, \"SOUL.md\"), \"w\", encoding=\"utf-8\") as f:\n132\t        f.write(soul_content)\n133\t\n134\t    with open(os.path.join(agent_dir, \"PROMPT.md\"), \"w\", encoding=\"utf-8\") as f:\n135\t        f.write(DEFAULT_PROMPT)\n136\t\n137\t    state = {\"agent\": template_id, \"status\": \"idle\", \"current_task\": None, \"last_run\": None, \"run_count\": 0, \"created\": datetime.now().strftime(\"%Y-%m-%d\")}\n138\t    write_json(os.path.join(agent_dir, \"memory\", \"state.json\"), state)\n139\t\n140\t    tasks = []\n141\t    if task_desc:\n142\t        tasks.append({\"id\": 1, \"status\": \"pending\", \"title\": task_desc, \"description\": task_desc, \"created\": datetime.now().strftime(\"%Y-%m-%d\"), \"assignee\": template_id})\n143\t    write_json(os.path.join(agent_dir, \"memory\", \"tasks.json\"), tasks)\n144\t\n145\t    with open(os.path.join(agent_dir, \"log\", \"run.md\"), \"w\", encoding=\"utf-8\") as f:\n146\t        f.write(\"# 运行日志\\n\\n| 时间 | 状态 | 任务 | 摘要 |\\n|------|------|------|------|\\n\")\n147\t\n148\t    print(f\"[创建成功] {template_id}\")\n149\t    print(f\"  目录: {agent_dir}\")\n150\t    if task_desc:\n151\t        print(f\"  任务: {task_desc}\")\n152\t    print(f\"  下一轮 loopcli 将自动启动该 Agent\")\n153\t\n154\t\n155\t# ─── 子命令: task ───\n156\t\n157\tdef cmd_task_inner(agent_name, title, desc):\n158\t    agent_dir = os.path.join(LOOPCLI_DIR, agent_name)\n159\t    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n160\t        print(f\"[错误] 不是有效的 Agent: {agent_name}\")\n161\t        sys.exit(1)\n162\t\n163\t    task = create_task(\n164\t        agent_dir, title,\n165\t        description=desc or title,\n166\t        assignee=agent_name,\n167\t        created=datetime.now().strftime(\"%Y-%m-%d\"),\n168\t    )\n169\t    print(f\"[派发成功] {agent_name} <- #{task['id']} {title}\")\n170\t\n171\t\n172\tdef cmd_task(args):\n173\t    cmd_task_inner(args.agent, args.title, args.desc)\n174\t\n175\t\n176\t# ─── 子命令: list ───\n177\t\n178\tdef cmd_list(args):\n179\t    agents = discover_agents(include_disabled=True)\n180\t    if not agents:\n181\t        print(\"没有发现任何 Agent\")\n182\t        return\n183\t    print(f\"{'Agent':<45} {'启用':<6} {'状态':<10} {'任务数':<8} {'最后运行'}\")\n184\t    print(\"-\" * 95)\n185\t    for a in agents:\n186\t        enabled = \"是\" if is_agent_enabled(a[\"path\"]) else \"否\"\n187\t        state = load_agent_state(a[\"path\"]) or {}\n188\t        tasks = load_agent_tasks(a[\"path\"])\n189\t        pending = len([t for t in tasks if t.get(\"status\") == \"pending\"])\n190\t        status = state.get(\"status\", \"?\")\n191\t        last_run = state.get(\"last_run\", \"-\")\n192\t        print(f\"{a['name']:<45} {enabled:<6} {status:<10} {pending:<8} {last_run}\")\n193\t\n194\t\n195\t# ─── 子命令: templates ───\n196\t\n197\tdef cmd_templates(args):\n198\t    found = []\n199\t    for dept in sorted(os.listdir(SUBAGENT_DIR)):\n200\t        dept_dir = os.path.join(SUBAGENT_DIR, dept)\n201\t        if not os.path.isdir(dept_dir):\n202\t            continue\n203\t        for fname in sorted(os.listdir(dept_dir)):\n204\t            if fname.endswith(\".md\"):\n205\t                found.append(fname[:-3])\n206\t    if args.filter:\n207\t        found = [t for t in found if args.filter.lower() in t.lower()]\n208\t    print(f\"共 {len(found)} 个模板:\")\n209\t    for t in found:\n210\t        print(f\"  {t}\")\n211\t\n212\t\n213\t# ─── 子命令: run（主循环）───\n214\t\n215\tdef handle_event(agent_name, line):\n216\t    line = line.strip()\n217\t    if not line:\n218\t        return\n219\t    try:\n220\t        event = json.loads(line)\n221\t    except json.JSONDecodeError:\n222\t        print(f\"[{agent_name}] {line}\", flush=True)\n223\t        return\n224\t\n225\t    event_type = event.get(\"type\", \"\")\n226\t\n227\t    if event_type == \"assistant\":\n228\t        msg = event.get(\"message\", {})\n229\t        for block in msg.get(\"content\", []):\n230\t            if block.get(\"type\") == \"text\":\n231\t                text = block.get(\"text\", \"\")\n232\t                if text:\n233\t                    print(f\"[{agent_name}] {text}\", flush=True)\n234\t            elif block.get(\"type\") == \"tool_use\":\n235\t                name = block.get(\"name\", \"\")\n236\t                inp = block.get(\"input\", {})\n237\t                detail = \"\"\n238\t                for k in (\"file_path\", \"command\", \"pattern\"):\n239\t                    if k in inp:\n240\t                        detail = inp[k]\n241\t                        break\n242\t                print(f\"[{agent_name}] ● {name}({detail})\", flush=True)\n243\t\n244\t    elif event_type == \"tool_result\":\n245\t        content = event.get(\"content\", \"\")\n246\t        texts = []\n247\t        if isinstance(content, list):\n248\t            texts = [b.get(\"text\", \"\") for b in content if b.get(\"text\")]\n249\t        elif isinstance(content, str):\n250\t            texts = [content]\n251\t        for text in texts:\n252\t            print(f\"[{agent_name}]   ↳ {text[:200]}\", flush=True)\n253\t\n254\t    elif event_type == \"result\":\n255\t        text = event.get(\"result\", \"\")\n256\t        if text:\n257\t            print(f\"[{agent_name}] [结果] {text[:500]}\", flush=True)\n258\t        cost = event.get(\"cost_usd\", \"\")\n259\t        duration = event.get(\"duration_ms\", \"\")\n260\t        if cost or duration:\n261\t            print(f\"[{agent_name}] [统计] 耗时: {duration}ms, 费用: ${cost}\", flush=True)\n262\t\n263\t    elif event_type == \"error\":\n264\t        print(f\"[{agent_name}] [错误] {event.get('error', '')}\", flush=True)\n265\t\n266\t\n267\tdef run_agent(agent, iteration, run_log_dir):\n268\t    name = agent[\"name\"]\n269\t    path = agent[\"path\"]\n270\t    prompt_file = os.path.join(path, \"PROMPT.md\")\n271\t    log_file_path = os.path.join(path, \"log\", \"raw.log\")\n272\t    run_agent_log = os.path.join(run_log_dir, f\"{name}.log\")\n273\t    ts = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n274\t\n275\t    if not os.path.isfile(prompt_file):\n276\t        print(f\"[{name}] 没有 PROMPT.md，跳过\", flush=True)\n277\t        return\n278\t\n279\t    with open(prompt_file, \"r\", encoding=\"utf-8\") as f:\n280\t        prompt = f.read()\n281\t\n282\t    os.makedirs(os.path.join(path, \"log\"), exist_ok=True)\n283\t    rotate_log(log_file_path)\n284\t    log_file = open(log_file_path, \"a\", encoding=\"utf-8\")\n285\t    agent_log = open(run_agent_log, \"a\", encoding=\"utf-8\")\n286\t\n287\t    try:\n288\t        header = f\"\\n[{ts}] --- 开始 (第{iteration}轮) ---\\n\"\n289\t        log_file.write(header)\n290\t        agent_log.write(header)\n291\t        log_file.flush()\n292\t        agent_log.flush()\n293\t\n294\t        env = {**os.environ, \"IS_SANDBOX\": \"1\"}\n295\t\n296\t        proc = subprocess.Popen(\n297\t            [CLAUDE, \"--print\", \"--verbose\", \"--output-format\", \"stream-json\", \"--dangerously-skip-permissions\"],\n298\t            stdin=subprocess.PIPE,\n299\t            stdout=subprocess.PIPE,\n300\t            stderr=subprocess.PIPE,\n301\t            env=env,\n302\t            cwd=path,\n303\t        )\n304\t\n305\t        proc.stdin.write(prompt.encode(\"utf-8\"))\n306\t        proc.stdin.close()\n307\t\n308\t        for line in proc.stdout:\n309\t            decoded = line.decode(\"utf-8\", errors=\"replace\")\n310\t            log_file.write(decoded)\n311\t            agent_log.write(decoded)\n312\t            log_file.flush()\n313\t            agent_log.flush()\n314\t            handle_event(name, decoded)\n315\t\n316\t        stderr_output = proc.stderr.read().decode(\"utf-8\", errors=\"replace\")\n317\t        if stderr_output:\n318\t            print(f\"[{name}] [STDERR] {stderr_output}\", flush=True)\n319\t            log_file.write(stderr_output)\n320\t            agent_log.write(stderr_output)\n321\t\n322\t        proc.wait()\n323\t\n324\t        footer = f\"\\n[{ts}] --- 结束 (exit={proc.returncode}) ---\\n\"\n325\t        log_file.write(footer)\n326\t        agent_log.write(footer)\n327\t    finally:\n328\t        log_file.close()\n329\t        agent_log.close()\n330\t\n331\t    # 更新 state.json (with file lock)\n332\t    state_file = os.path.join(path, \"memory\", \"state.json\")\n333\t    with open(state_file, \"a+\") as f:\n334\t        msvcrt.locking(f.fileno(), msvcrt.LK_LOCK, 1)\n335\t        try:\n336\t            f.seek(0)\n337\t            try:\n338\t                state = json.load(f)\n339\t            except (json.JSONDecodeError, ValueError):\n340\t                state = {}\n341\t            state[\"status\"] = \"idle\"\n342\t            state[\"last_run\"] = ts\n343\t            state[\"run_count\"] = state.get(\"run_count\", 0) + 1\n344\t            f.seek(0)\n345\t            f.truncate()\n346\t            json.dump(state, f, indent=2, ensure_ascii=False)\n347\t        finally:\n348\t            msvcrt.locking(f.fileno(), msvcrt.LK_UNLCK, 1)\n349\t\n350\t    status = \"完成\" if proc.returncode == 0 else f\"异常(exit={proc.returncode})\"\n351\t    print(f\"[{name}] 本轮{status}\", flush=True)\n352\t\n353\t\n354\tdef git_push():\n355\t    \"\"\"自动 commit 和 push 到 GitHub\"\"\"\n356\t    token_file = GIT_TOKEN_FILE\n357\t    if not os.path.isfile(token_file):\n358\t        return\n359\t    with open(token_file, \"r\") as f:\n360\t        token = f.read().strip()\n361\t    if not token:\n362\t        return\n363\t    try:\n364\t        git = resolve_git()\n365\t        subprocess.run([git, \"add\", \"memory/\", \"log/\", \"inbox/\"], cwd=LOOPCLI_DIR, capture_output=True, timeout=30)\n366\t        subprocess.run(\n367\t            [git, \"commit\", \"-m\", f\"auto: loopcli sync {datetime.now().strftime('%Y-%m-%d %H:%M')}\"],\n368\t            cwd=LOOPCLI_DIR, capture_output=True, timeout=30\n369\t        )\n370\t        askpass_script = os.path.join(LOOPCLI_DIR, \".git_askpass.bat\")\n371\t        with open(askpass_script, \"w\") as f:\n372\t            f.write(\"@echo %GH_TOKEN%\\n\")\n373\t        push_env = {\n374\t            **os.environ,\n375\t            \"GH_TOKEN\": token,\n376\t            \"GIT_ASKPASS\": askpass_script,\n377\t            \"GIT_TERMINAL_PROMPT\": \"0\",\n378\t        }\n379\t        subprocess.run(\n380\t            [git, \"push\", \"https://x-access-token@github.com/zhoudingnuo/loopcli.git\", \"main\"],\n381\t            cwd=LOOPCLI_DIR, capture_output=True, timeout=60, env=push_env,\n382\t        )\n383\t        os.remove(askpass_script)\n384\t        print(\"[git] 已同步到 GitHub\", flush=True)\n385\t    except Exception as e:\n386\t        print(f\"[git] 同步失败: {e}\", flush=True)\n387\t\n388\t\n389\tdef resolve_git():\n390\t    \"\"\"找到 git.exe 的完整路径\"\"\"\n391\t    for p in os.environ.get(\"PATH\", \"\").split(\";\"):\n392\t        candidate = os.path.join(p, \"git.exe\")\n393\t        if os.path.isfile(candidate):\n394\t            return candidate\n395\t    for d in [r\"C:\\Program Files\\Git\\cmd\", r\"C:\\Program Files\\Git\\bin\"]:\n396\t        candidate = os.path.join(d, \"git.exe\")\n397\t        if os.path.isfile(candidate):\n398\t            return candidate\n399\t    return \"git\"\n400\t\n401\t\n402\tdef cmd_run(args):\n403\t    agents = discover_agents()\n404\t    if not agents:\n405\t        print(\"未发现任何 Agent（需要目录下有 AGENT 标记文件）\")\n406\t        sys.exit(1)\n407\t\n408\t    run_id = datetime.now().strftime(\"run_%Y%m%d_%H%M%S\")\n409\t    run_log_dir = os.path.join(LOGS_DIR, run_id)\n410\t    os.makedirs(run_log_dir, exist_ok=True)\n411\t\n412\t    meta = {\n413\t        \"run_id\": run_id,\n414\t        \"started\": datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"),\n415\t        \"iterations\": args.iterations or \"无限\",\n416\t        \"agents\": [a[\"name\"] for a in agents],\n417\t    }\n418\t    write_json(os.path.join(run_log_dir, \"meta.json\"), meta)\n419\t\n420\t    print(f\"运行 ID: {run_id}\")\n421\t    print(f\"日志目录: {run_log_dir}\")\n422\t    print(f\"发现 {len(agents)} 个 Agent: {', '.join(a['name'] for a in agents)}\")\n423\t\n424\t    count = 0\n425\t    while args.iterations == 0 or count < args.iterations:\n426\t        count += 1\n427\t        agents = discover_agents()\n428\t        ts = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n429\t        print(f\"\\n{'='*60}\")\n430\t        print(f\"[{ts}] 第 {count}{'/' + str(args.iterations) if args.iterations else ''} 轮 | {len(agents)} 个 Agent\")\n431\t        print(f\"{'='*60}\")\n432\t\n433\t        threads = []\n434\t        for agent in agents:\n435\t            print(f\"\\n--- 启动 [{agent['name']}] ---\", flush=True)\n436\t            t = threading.Thread(target=run_agent, args=(agent, count, run_log_dir))\n437\t            t.start()\n438\t            threads.append(t)\n439\t        for t in threads:\n440\t            t.join()\n441\t\n442\t        git_push()\n443\t\n444\t        if args.iterations == 0 or count < args.iterations:\n445\t            print(f\"\\n{'─'*60}\", flush=True)\n446\t            print(f\"输入消息发给 main（直接回车跳过，输入 exit 停止）:\", flush=True)\n447\t            try:\n448\t                user_input = input(f\"  > \").strip()\n449\t                if user_input.lower() == \"exit\":\n450\t                    print(\"用户终止运行\")\n451\t                    break\n452\t                if user_input:\n453\t                    msg_file = write_inbox_message(\n454\t                        os.path.join(LOOPCLI_DIR, \"main\"),\n455\t                        \"user\",\n456\t                        user_input,\n457\t                    )\n458\t                    print(f\"  [已发送] -> main/inbox/\", flush=True)\n459\t            except EOFError:\n460\t                pass\n461\t            print(f\"  等待 {args.wait} 秒后进入下一轮...\", flush=True)\n462\t            time.sleep(args.wait)\n463\t    meta[\"finished\"] = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n464\t    meta[\"total_iterations\"] = count\n465\t    write_json(os.path.join(run_log_dir, \"meta.json\"), meta)\n466\t\n467\t    print(f\"\\n运行结束，日志保存在: {run_log_dir}\")\n468\t\n469\t\n470\t# ─── CLI 入口 ───\n471\t\n472\tparser = argparse.ArgumentParser(description=\"LoopCLI — 多 Agent 自治系统\")\n473\tsub = parser.add_subparsers(dest=\"command\")\n474\t\n475\tp_run = sub.add_parser(\"run\", help=\"启动 Agent 循环（默认）\")\n476\tp_run.add_argument(\"-n\", \"--iterations\", type=int, default=0, help=\"迭代次数，0=无限\")\n477\tp_run.add_argument(\"-w\", \"--wait\", type=int, default=10, help=\"每轮间隔秒数（默认 10）\")\n478\t\n479\tp_create = sub.add_parser(\"create\", help=\"从模板创建新 Agent\")\n480\tp_create.add_argument(\"template\", help=\"模板 ID，如 engineering-frontend-developer\")\n481\tp_create.add_argument(\"--task\", \"-t\", help=\"初始任务描述\")\n482\t\n483\tp_task = sub.add_parser(\"task\", help=\"给 Agent 派发任务\")\n484\tp_task.add_argument(\"agent\", help=\"Agent 目录名\")\n485\tp_task.add_argument(\"title\", help=\"任务标题\")\n486\tp_task.add_argument(\"--desc\", \"-d\", default=\"\", help=\"任务描述\")\n487\t\n488\tsub.add_parser(\"list\", help=\"列出所有 Agent 及状态\")\n489\t\n490\tp_tpl = sub.add_parser(\"templates\", help=\"列出可用模板\")\n491\tp_tpl.add_argument(\"--filter\", \"-f\", default=\"\", help=\"按关键词筛选\")\n492\t\n493\tdef cmd_enable(args):\n494\t    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n495\t    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n496\t        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n497\t        sys.exit(1)\n498\t    set_agent_enabled(agent_dir, True)\n499\t    print(f\"[已启用] {args.agent}\")\n500\t\n501\t\n502\tdef cmd_disable(args):\n503\t    if args.agent == \"main\":\n504\t        print(\"[错误] 不能禁用 main Agent\")\n505\t        sys.exit(1)\n506\t    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n507\t    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n508\t        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n509\t        sys.exit(1)\n510\t    set_agent_enabled(agent_dir, False)\n511\t    print(f\"[已禁用] {args.agent}（loopcli run 将跳过此 Agent）\")\n512\t\n513\t\n514\tp_msg = sub.add_parser(\"msg\", help=\"给 Agent 发消息\")\n515\tp_msg.add_argument(\"content\", help=\"消息内容\")\n516\tp_msg.add_argument(\"--agent\", \"-a\", default=\"main\", help=\"目标 Agent（默认 main）\")\n517\t\n518\tp_enable = sub.add_parser(\"enable\", help=\"启用 Agent（可被 loopcli run 调度）\")\n519\tp_enable.add_argument(\"agent\", help=\"Agent 目录名\")\n520\t\n521\tp_disable = sub.add_parser(\"disable\", help=\"禁用 Agent（跳过调度，节省 token）\")\n522\tp_disable.add_argument(\"agent\", help=\"Agent 目录名\")\n523\t\n524\t\n525\tdef cmd_msg(args):\n526\t    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n527\t    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n528\t        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n529\t        sys.exit(1)\n530\t    msg_file = write_inbox_message(agent_dir, \"user\", args.content)\n531\t    print(f\"[已发送] -> {args.agent}/inbox/  {args.content}\")\n532\t\n533\t\n534\tif sys.argv[1:] and sys.argv[1] not in (\"run\", \"create\", \"task\", \"list\", \"templates\", \"msg\", \"enable\", \"disable\", \"-h\", \"--help\"):\n535\t    sys.argv.insert(1, \"run\")\n536\t\n537\targs = parser.parse_args()\n538\t\n539\tif args.command == \"create\":\n540\t    cmd_create(args)\n541\telif args.command == \"task\":\n542\t    cmd_task(args)\n543\telif args.command == \"list\":\n544\t    cmd_list(args)\n545\telif args.command == \"templates\":\n546\t    cmd_templates(args)\n547\telif args.command == \"msg\":\n548\t    cmd_msg(args)\n549\telif args.command == \"enable\":\n550\t    cmd_enable(args)\n551\telif args.command == \"disable\":\n552\t    cmd_disable(args)\n553\telse:\n554\t    if not hasattr(args, \"iterations\"):\n555\t        args.iterations = 0\n556\t    if not hasattr(args, \"wait\"):\n557\t        args.wait = 10\n558\t    cmd_run(args)\n559\t"}]},"parent_tool_use_id":null,"session_id":"53eb080d-5854-4f04-96ec-a843eb289f59","uuid":"d1852f75-85de-4ce1-bffd-9758d5848c72","timestamp":"2026-05-21T01:03:23.261Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\loopcli\\run.py","content":"import argparse\nimport json\nimport msvcrt\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport threading\nimport time\nfrom datetime import datetime\nfrom pathlib import Path\n\nsys.path.insert(0, r\"D:\\loopcli\\main\\webui\")\nfrom loopcli_lib import (\n    LOOPCLI_ROOT,\n    AGENT_MARKER,\n    read_json,\n    write_json,\n    safe_agent_path,\n    get_agent_marker,\n    is_agent_enabled,\n    discover_agents as _discover_agents,\n    create_task,\n    write_inbox_message,\n    set_agent_enabled,\n)\n\nLOOPCLI_DIR = str(LOOPCLI_ROOT)\nSUBAGENT_DIR = os.path.join(LOOPCLI_DIR, \"subagent\")\nCLAUDE = os.path.join(os.environ.get(\"APPDATA\", \"\"), \"npm\", \"claude.cmd\")\n\nLOGS_DIR = os.path.join(LOOPCLI_DIR, \"logs\")\nGIT_TOKEN_FILE = os.path.join(LOOPCLI_DIR, \".gittoken\")\nDEFAULT_PROMPT = \"\"\"读取 SOUL.md 作为你的身份。\n读取 D:/loopcli/skill/ 下所有技能文件（全局技能）。\n读取 memory/tasks.json 获取分配给你的任务。\n\n执行步骤：\n1. 从 tasks.json 中找 status 为 \"pending\" 的第一个任务\n2. 执行该任务\n3. 将结果写入 memory/results/ 目录（以时间戳命名）\n4. 将该任务 status 改为 \"done\"，写回 tasks.json\n5. 更新 memory/state.json（标记完成、记录时间戳）\n6. 将本次运行摘要追加到 log/run.md\n7. 通过 inbox 通知 main：写入 D:/loopcli/main/inbox/<你的名字>_<时间>.md，简要报告任务结果\n8. 如果没有 pending 任务，输出 \"IDLE\" 并结束本轮\n\"\"\"\n\n\n# ─── 工具函数 ───\n\ndef discover_agents(include_disabled=False):\n    \"\"\"Wrapper that returns same format as before (name+path strings).\"\"\"\n    return _discover_agents(include_disabled=include_disabled)\n\n\ndef find_template(template_id):\n    \"\"\"在 subagent 目录下搜索模板文件\"\"\"\n    for dept in os.listdir(SUBAGENT_DIR):\n        dept_dir = os.path.join(SUBAGENT_DIR, dept)\n        if not os.path.isdir(dept_dir):\n            continue\n        candidate = os.path.join(dept_dir, f\"{template_id}.md\")\n        if os.path.isfile(candidate):\n            return candidate\n    return None\n\n\ndef load_agent_state(agent_path):\n    state_file = os.path.join(agent_path, \"memory\", \"state.json\")\n    if os.path.isfile(state_file):\n        return read_json(state_file)\n    return None\n\n\ndef load_agent_tasks(agent_path):\n    tasks_file = os.path.join(agent_path, \"memory\", \"tasks.json\")\n    if os.path.isfile(tasks_file):\n        return read_json(tasks_file, [])\n    return []\n\n\ndef rotate_log(log_path, max_size=1_000_000, max_backups=3):\n    \"\"\"轮转日志文件：超过 max_size 时依次重命名为 .1 .2 .3，最多保留 max_backups 个归档\"\"\"\n    if not os.path.isfile(log_path):\n        return\n    try:\n        if os.path.getsize(log_path) < max_size:\n            return\n    except OSError:\n        return\n    oldest = f\"{log_path}.{max_backups}\"\n    if os.path.isfile(oldest):\n        os.remove(oldest)\n    for i in range(max_backups, 1, -1):\n        src = f\"{log_path}.{i - 1}\"\n        dst = f\"{log_path}.{i}\"\n        if os.path.isfile(src):\n            os.rename(src, dst)\n    os.rename(log_path, f\"{log_path}.1\")\n\n\n# ─── 子命令: create ───\n\ndef cmd_create(args):\n    template_id = args.template\n    task_desc = args.task or \"\"\n\n    tpl_file = find_template(template_id)\n    if not tpl_file:\n        print(f\"[错误] 找不到模板: {template_id}\")\n        print(\"用 loopcli templates 查看所有可用模板\")\n        sys.exit(1)\n\n    with open(tpl_file, \"r\", encoding=\"utf-8\") as f:\n        soul_content = f.read()\n\n    agent_dir = os.path.join(LOOPCLI_DIR, template_id)\n    if os.path.exists(agent_dir):\n        print(f\"[跳过] Agent 已存在: {agent_dir}\")\n        if task_desc:\n            cmd_task_inner(template_id, task_desc, \"\")\n        return\n\n    os.makedirs(os.path.join(agent_dir, \"memory\", \"results\"), exist_ok=True)\n    os.makedirs(os.path.join(agent_dir, \"log\"), exist_ok=True)\n\n    with open(os.path.join(agent_dir, AGENT_MARKER), \"w\", encoding=\"utf-8\") as f:\n        f.write(\"type: main\\n\")\n\n    with open(os.path.join(agent_dir, \"SOUL.md\"), \"w\", encoding=\"utf-8\") as f:\n        f.write(soul_content)\n\n    with open(os.path.join(agent_dir, \"PROMPT.md\"), \"w\", encoding=\"utf-8\") as f:\n        f.write(DEFAULT_PROMPT)\n\n    state = {\"agent\": template_id, \"status\": \"idle\", \"current_task\": None, \"last_run\": None, \"run_count\": 0, \"created\": datetime.now().strftime(\"%Y-%m-%d\")}\n    write_json(os.path.join(agent_dir, \"memory\", \"state.json\"), state)\n\n    tasks = []\n    if task_desc:\n        tasks.append({\"id\": 1, \"status\": \"pending\", \"title\": task_desc, \"description\": task_desc, \"created\": datetime.now().strftime(\"%Y-%m-%d\"), \"assignee\": template_id})\n    write_json(os.path.join(agent_dir, \"memory\", \"tasks.json\"), tasks)\n\n    with open(os.path.join(agent_dir, \"log\", \"run.md\"), \"w\", encoding=\"utf-8\") as f:\n        f.write(\"# 运行日志\\n\\n| 时间 | 状态 | 任务 | 摘要 |\\n|------|------|------|------|\\n\")\n\n    print(f\"[创建成功] {template_id}\")\n    print(f\"  目录: {agent_dir}\")\n    if task_desc:\n        print(f\"  任务: {task_desc}\")\n    print(f\"  下一轮 loopcli 将自动启动该 Agent\")\n\n\n# ─── 子命令: task ───\n\ndef cmd_task_inner(agent_name, title, desc):\n    agent_dir = os.path.join(LOOPCLI_DIR, agent_name)\n    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n        print(f\"[错误] 不是有效的 Agent: {agent_name}\")\n        sys.exit(1)\n\n    task = create_task(\n        agent_dir, title,\n        description=desc or title,\n        assignee=agent_name,\n        created=datetime.now().strftime(\"%Y-%m-%d\"),\n    )\n    print(f\"[派发成功] {agent_name} <- #{task['id']} {title}\")\n\n\ndef cmd_task(args):\n    cmd_task_inner(args.agent, args.title, args.desc)\n\n\n# ─── 子命令: list ───\n\ndef cmd_list(args):\n    agents = discover_agents(include_disabled=True)\n    if not agents:\n        print(\"没有发现任何 Agent\")\n        return\n    print(f\"{'Agent':<45} {'启用':<6} {'状态':<10} {'任务数':<8} {'最后运行'}\")\n    print(\"-\" * 95)\n    for a in agents:\n        enabled = \"是\" if is_agent_enabled(a[\"path\"]) else \"否\"\n        state = load_agent_state(a[\"path\"]) or {}\n        tasks = load_agent_tasks(a[\"path\"])\n        pending = len([t for t in tasks if t.get(\"status\") == \"pending\"])\n        status = state.get(\"status\", \"?\")\n        last_run = state.get(\"last_run\", \"-\")\n        print(f\"{a['name']:<45} {enabled:<6} {status:<10} {pending:<8} {last_run}\")\n\n\n# ─── 子命令: templates ───\n\ndef cmd_templates(args):\n    found = []\n    for dept in sorted(os.listdir(SUBAGENT_DIR)):\n        dept_dir = os.path.join(SUBAGENT_DIR, dept)\n        if not os.path.isdir(dept_dir):\n            continue\n        for fname in sorted(os.listdir(dept_dir)):\n            if fname.endswith(\".md\"):\n                found.append(fname[:-3])\n    if args.filter:\n        found = [t for t in found if args.filter.lower() in t.lower()]\n    print(f\"共 {len(found)} 个模板:\")\n    for t in found:\n        print(f\"  {t}\")\n\n\n# ─── 子命令: run（主循环）───\n\ndef handle_event(agent_name, line):\n    line = line.strip()\n    if not line:\n        return\n    try:\n        event = json.loads(line)\n    except json.JSONDecodeError:\n        print(f\"[{agent_name}] {line}\", flush=True)\n        return\n\n    event_type = event.get(\"type\", \"\")\n\n    if event_type == \"assistant\":\n        msg = event.get(\"message\", {})\n        for block in msg.get(\"content\", []):\n            if block.get(\"type\") == \"text\":\n                text = block.get(\"text\", \"\")\n                if text:\n                    print(f\"[{agent_name}] {text}\", flush=True)\n            elif block.get(\"type\") == \"tool_use\":\n                name = block.get(\"name\", \"\")\n                inp = block.get(\"input\", {})\n                detail = \"\"\n                for k in (\"file_path\", \"command\", \"pattern\"):\n                    if k in inp:\n                        detail = inp[k]\n                        break\n                print(f\"[{agent_name}] ● {name}({detail})\", flush=True)\n\n    elif event_type == \"tool_result\":\n        content = event.get(\"content\", \"\")\n        texts = []\n        if isinstance(content, list):\n            texts = [b.get(\"text\", \"\") for b in content if b.get(\"text\")]\n        elif isinstance(content, str):\n            texts = [content]\n        for text in texts:\n            print(f\"[{agent_name}]   ↳ {text[:200]}\", flush=True)\n\n    elif event_type == \"result\":\n        text = event.get(\"result\", \"\")\n        if text:\n            print(f\"[{agent_name}] [结果] {text[:500]}\", flush=True)\n        cost = event.get(\"cost_usd\", \"\")\n        duration = event.get(\"duration_ms\", \"\")\n        if cost or duration:\n            print(f\"[{agent_name}] [统计] 耗时: {duration}ms, 费用: ${cost}\", flush=True)\n\n    elif event_type == \"error\":\n        print(f\"[{agent_name}] [错误] {event.get('error', '')}\", flush=True)\n\n\ndef run_agent(agent, iteration, run_log_dir):\n    name = agent[\"name\"]\n    path = agent[\"path\"]\n    prompt_file = os.path.join(path, \"PROMPT.md\")\n    log_file_path = os.path.join(path, \"log\", \"raw.log\")\n    run_agent_log = os.path.join(run_log_dir, f\"{name}.log\")\n    ts = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n\n    if not os.path.isfile(prompt_file):\n        print(f\"[{name}] 没有 PROMPT.md，跳过\", flush=True)\n        return\n\n    with open(prompt_file, \"r\", encoding=\"utf-8\") as f:\n        prompt = f.read()\n\n    os.makedirs(os.path.join(path, \"log\"), exist_ok=True)\n    rotate_log(log_file_path)\n    log_file = open(log_file_path, \"a\", encoding=\"utf-8\")\n    agent_log = open(run_agent_log, \"a\", encoding=\"utf-8\")\n\n    try:\n        header = f\"\\n[{ts}] --- 开始 (第{iteration}轮) ---\\n\"\n        log_file.write(header)\n        agent_log.write(header)\n        log_file.flush()\n        agent_log.flush()\n\n        env = {**os.environ, \"IS_SANDBOX\": \"1\"}\n\n        proc = subprocess.Popen(\n            [CLAUDE, \"--print\", \"--verbose\", \"--output-format\", \"stream-json\", \"--dangerously-skip-permissions\"],\n            stdin=subprocess.PIPE,\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            env=env,\n            cwd=path,\n        )\n\n        proc.stdin.write(prompt.encode(\"utf-8\"))\n        proc.stdin.close()\n\n        for line in proc.stdout:\n            decoded = line.decode(\"utf-8\", errors=\"replace\")\n            log_file.write(decoded)\n            agent_log.write(decoded)\n            log_file.flush()\n            agent_log.flush()\n            handle_event(name, decoded)\n\n        stderr_output = proc.stderr.read().decode(\"utf-8\", errors=\"replace\")\n        if stderr_output:\n            print(f\"[{name}] [STDERR] {stderr_output}\", flush=True)\n            log_file.write(stderr_output)\n            agent_log.write(stderr_output)\n\n        proc.wait()\n\n        footer = f\"\\n[{ts}] --- 结束 (exit={proc.returncode}) ---\\n\"\n        log_file.write(footer)\n        agent_log.write(footer)\n    finally:\n        log_file.close()\n        agent_log.close()\n\n    # 更新 state.json (with file lock)\n    state_file = os.path.join(path, \"memory\", \"state.json\")\n    with open(state_file, \"a+\") as f:\n        msvcrt.locking(f.fileno(), msvcrt.LK_LOCK, 1)\n        try:\n            f.seek(0)\n            try:\n                state = json.load(f)\n            except (json.JSONDecodeError, ValueError):\n                state = {}\n            state[\"status\"] = \"idle\"\n            state[\"last_run\"] = ts\n            state[\"run_count\"] = state.get(\"run_count\", 0) + 1\n            f.seek(0)\n            f.truncate()\n            json.dump(state, f, indent=2, ensure_ascii=False)\n        finally:\n            msvcrt.locking(f.fileno(), msvcrt.LK_UNLCK, 1)\n\n    status = \"完成\" if proc.returncode == 0 else f\"异常(exit={proc.returncode})\"\n    print(f\"[{name}] 本轮{status}\", flush=True)\n\n\ndef git_push():\n    \"\"\"自动 commit 和 push 到 GitHub\"\"\"\n    token_file = GIT_TOKEN_FILE\n    if not os.path.isfile(token_file):\n        return\n    with open(token_file, \"r\") as f:\n        token = f.read().strip()\n    if not token:\n        return\n    try:\n        git = resolve_git()\n        subprocess.run([git, \"add\", \"memory/\", \"log/\", \"inbox/\"], cwd=LOOPCLI_DIR, capture_output=True, timeout=30)\n        subprocess.run(\n            [git, \"commit\", \"-m\", f\"auto: loopcli sync {datetime.now().strftime('%Y-%m-%d %H:%M')}\"],\n            cwd=LOOPCLI_DIR, capture_output=True, timeout=30\n        )\n        askpass_script = os.path.join(LOOPCLI_DIR, \".git_askpass.bat\")\n        with open(askpass_script, \"w\") as f:\n            f.write(\"@echo %GH_TOKEN%\\n\")\n        push_env = {\n            **os.environ,\n            \"GH_TOKEN\": token,\n            \"GIT_ASKPASS\": askpass_script,\n            \"GIT_TERMINAL_PROMPT\": \"0\",\n        }\n        subprocess.run(\n            [git, \"push\", \"https://x-access-token@github.com/zhoudingnuo/loopcli.git\", \"main\"],\n            cwd=LOOPCLI_DIR, capture_output=True, timeout=60, env=push_env,\n        )\n        os.remove(askpass_script)\n        print(\"[git] 已同步到 GitHub\", flush=True)\n    except Exception as e:\n        print(f\"[git] 同步失败: {e}\", flush=True)\n\n\ndef resolve_git():\n    \"\"\"找到 git.exe 的完整路径\"\"\"\n    for p in os.environ.get(\"PATH\", \"\").split(\";\"):\n        candidate = os.path.join(p, \"git.exe\")\n        if os.path.isfile(candidate):\n            return candidate\n    for d in [r\"C:\\Program Files\\Git\\cmd\", r\"C:\\Program Files\\Git\\bin\"]:\n        candidate = os.path.join(d, \"git.exe\")\n        if os.path.isfile(candidate):\n            return candidate\n    return \"git\"\n\n\ndef cmd_run(args):\n    agents = discover_agents()\n    if not agents:\n        print(\"未发现任何 Agent（需要目录下有 AGENT 标记文件）\")\n        sys.exit(1)\n\n    run_id = datetime.now().strftime(\"run_%Y%m%d_%H%M%S\")\n    run_log_dir = os.path.join(LOGS_DIR, run_id)\n    os.makedirs(run_log_dir, exist_ok=True)\n\n    meta = {\n        \"run_id\": run_id,\n        \"started\": datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"),\n        \"iterations\": args.iterations or \"无限\",\n        \"agents\": [a[\"name\"] for a in agents],\n    }\n    write_json(os.path.join(run_log_dir, \"meta.json\"), meta)\n\n    print(f\"运行 ID: {run_id}\")\n    print(f\"日志目录: {run_log_dir}\")\n    print(f\"发现 {len(agents)} 个 Agent: {', '.join(a['name'] for a in agents)}\")\n\n    count = 0\n    while args.iterations == 0 or count < args.iterations:\n        count += 1\n        agents = discover_agents()\n        ts = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n        print(f\"\\n{'='*60}\")\n        print(f\"[{ts}] 第 {count}{'/' + str(args.iterations) if args.iterations else ''} 轮 | {len(agents)} 个 Agent\")\n        print(f\"{'='*60}\")\n\n        threads = []\n        for agent in agents:\n            print(f\"\\n--- 启动 [{agent['name']}] ---\", flush=True)\n            t = threading.Thread(target=run_agent, args=(agent, count, run_log_dir))\n            t.start()\n            threads.append(t)\n        for t in threads:\n            t.join()\n\n        git_push()\n\n        if args.iterations == 0 or count < args.iterations:\n            print(f\"\\n{'─'*60}\", flush=True)\n            print(f\"输入消息发给 main（直接回车跳过，输入 exit 停止）:\", flush=True)\n            try:\n                user_input = input(f\"  > \").strip()\n                if user_input.lower() == \"exit\":\n                    print(\"用户终止运行\")\n                    break\n                if user_input:\n                    msg_file = write_inbox_message(\n                        os.path.join(LOOPCLI_DIR, \"main\"),\n                        \"user\",\n                        user_input,\n                    )\n                    print(f\"  [已发送] -> main/inbox/\", flush=True)\n            except EOFError:\n                pass\n            print(f\"  等待 {args.wait} 秒后进入下一轮...\", flush=True)\n            time.sleep(args.wait)\n    meta[\"finished\"] = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n    meta[\"total_iterations\"] = count\n    write_json(os.path.join(run_log_dir, \"meta.json\"), meta)\n\n    print(f\"\\n运行结束，日志保存在: {run_log_dir}\")\n\n\n# ─── CLI 入口 ───\n\nparser = argparse.ArgumentParser(description=\"LoopCLI — 多 Agent 自治系统\")\nsub = parser.add_subparsers(dest=\"command\")\n\np_run = sub.add_parser(\"run\", help=\"启动 Agent 循环（默认）\")\np_run.add_argument(\"-n\", \"--iterations\", type=int, default=0, help=\"迭代次数，0=无限\")\np_run.add_argument(\"-w\", \"--wait\", type=int, default=10, help=\"每轮间隔秒数（默认 10）\")\n\np_create = sub.add_parser(\"create\", help=\"从模板创建新 Agent\")\np_create.add_argument(\"template\", help=\"模板 ID，如 engineering-frontend-developer\")\np_create.add_argument(\"--task\", \"-t\", help=\"初始任务描述\")\n\np_task = sub.add_parser(\"task\", help=\"给 Agent 派发任务\")\np_task.add_argument(\"agent\", help=\"Agent 目录名\")\np_task.add_argument(\"title\", help=\"任务标题\")\np_task.add_argument(\"--desc\", \"-d\", default=\"\", help=\"任务描述\")\n\nsub.add_parser(\"list\", help=\"列出所有 Agent 及状态\")\n\np_tpl = sub.add_parser(\"templates\", help=\"列出可用模板\")\np_tpl.add_argument(\"--filter\", \"-f\", default=\"\", help=\"按关键词筛选\")\n\ndef cmd_enable(args):\n    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n        sys.exit(1)\n    set_agent_enabled(agent_dir, True)\n    print(f\"[已启用] {args.agent}\")\n\n\ndef cmd_disable(args):\n    if args.agent == \"main\":\n        print(\"[错误] 不能禁用 main Agent\")\n        sys.exit(1)\n    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n        sys.exit(1)\n    set_agent_enabled(agent_dir, False)\n    print(f\"[已禁用] {args.agent}（loopcli run 将跳过此 Agent）\")\n\n\np_msg = sub.add_parser(\"msg\", help=\"给 Agent 发消息\")\np_msg.add_argument(\"content\", help=\"消息内容\")\np_msg.add_argument(\"--agent\", \"-a\", default=\"main\", help=\"目标 Agent（默认 main）\")\n\np_enable = sub.add_parser(\"enable\", help=\"启用 Agent（可被 loopcli run 调度）\")\np_enable.add_argument(\"agent\", help=\"Agent 目录名\")\n\np_disable = sub.add_parser(\"disable\", help=\"禁用 Agent（跳过调度，节省 token）\")\np_disable.add_argument(\"agent\", help=\"Agent 目录名\")\n\n\ndef cmd_msg(args):\n    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n        sys.exit(1)\n    msg_file = write_inbox_message(agent_dir, \"user\", args.content)\n    print(f\"[已发送] -> {args.agent}/inbox/  {args.content}\")\n\n\nif sys.argv[1:] and sys.argv[1] not in (\"run\", \"create\", \"task\", \"list\", \"templates\", \"msg\", \"enable\", \"disable\", \"-h\", \"--help\"):\n    sys.argv.insert(1, \"run\")\n\nargs = parser.parse_args()\n\nif args.command == \"create\":\n    cmd_create(args)\nelif args.command == \"task\":\n    cmd_task(args)\nelif args.command == \"list\":\n    cmd_list(args)\nelif args.command == \"templates\":\n    cmd_templates(args)\nelif args.command == \"msg\":\n    cmd_msg(args)\nelif args.command == \"enable\":\n    cmd_enable(args)\nelif args.command == \"disable\":\n    cmd_disable(args)\nelse:\n    if not hasattr(args, \"iterations\"):\n        args.iterations = 0\n    if not hasattr(args, \"wait\"):\n        args.wait = 10\n    cmd_run(args)\n","numLines":559,"startLine":1,"totalLines":559}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ee1831fb6d4341f09f565234","type":"tool_result","content":"1\t\"\"\"\n2\tLoopCLI WebUI Backend Server\n3\tREST API + static file hosting for the Agent control console.\n4\t\"\"\"\n5\t\n6\timport hmac\n7\timport json\n8\timport os\n9\timport signal\n10\timport subprocess\n11\timport sys\n12\timport time\n13\timport threading\n14\timport uuid\n15\tfrom datetime import datetime, timezone\n16\tfrom http.server import HTTPServer, SimpleHTTPRequestHandler\n17\tfrom socketserver import ThreadingMixIn\n18\tfrom pathlib import Path\n19\tfrom urllib.parse import urlparse, parse_qs\n20\t\n21\tfrom loopcli_lib import (\n22\t    LOOPCLI_ROOT,\n23\t    read_json,\n24\t    write_json,\n25\t    safe_agent_path,\n26\t    scan_agents,\n27\t    create_task,\n28\t    get_agent_tasks,\n29\t    get_all_agent_tasks,\n30\t    write_inbox_message,\n31\t    set_agent_enabled,\n32\t    get_recent_lines,\n33\t    read_file_tail_incremental,\n34\t)\n35\t\n36\tWEBUI_DIR = Path(__file__).parent.resolve()\n37\tMAIN_DIR = LOOPCLI_ROOT / \"main\"\n38\tLOOP_STATE_FILE = WEBUI_DIR / \"loop_state.json\"\n39\t\n40\t_loop_proc = None\n41\t_loop_lock = threading.Lock()\n42\tAPI_KEY = os.environ.get(\"LOOPCLI_API_KEY\", \"\")\n43\tMAX_BODY_SIZE = 10 * 1024  # 10KB\n44\t\n45\t_raw_cors = os.environ.get(\"CORS_ORIGINS\", \"\").strip()\n46\tif _raw_cors:\n47\t    CORS_ORIGINS = [o.strip() for o in _raw_cors.split(\",\") if o.strip()]\n48\telse:\n49\t    CORS_ORIGINS = [\"http://localhost:3000\"]\n50\t\n51\t_write_semaphore = threading.Semaphore(10)\n52\t\n53\t_sse_connections = 0\n54\t_sse_lock = threading.Lock()\n55\tSSE_MAX_CONNECTIONS = 10\n56\tSSE_TIMEOUT_SECONDS = 300\n57\t\n58\t\n59\tdef get_main_tasks():\n60\t    return read_json(MAIN_DIR / \"memory\" / \"tasks.json\", [])\n61\t\n62\t\n63\t# --- Loop Process Management ---\n64\t\n65\tdef get_loop_state():\n66\t    return read_json(LOOP_STATE_FILE, {\n67\t        \"status\": \"stopped\", \"pid\": None,\n68\t        \"started_at\": None, \"iterations\": 0, \"total_iterations\": 0,\n69\t    })\n70\t\n71\t\n72\tdef set_loop_state(state):\n73\t    write_json(LOOP_STATE_FILE, state)\n74\t\n75\t\n76\tdef _is_pid_alive(pid):\n77\t    if not pid:\n78\t        return False\n79\t    try:\n80\t        os.kill(pid, 0)\n81\t        return True\n82\t    except (ProcessLookupError, PermissionError, OSError):\n83\t        return False\n84\t\n85\t\n86\tdef _monitor_loopcli(proc):\n87\t    proc.wait()\n88\t    with _loop_lock:\n89\t        state = get_loop_state()\n90\t        if state.get(\"pid\") == proc.pid:\n91\t            state[\"status\"] = \"stopped\"\n92\t            state[\"pid\"] = None\n93\t            state[\"ended_at\"] = datetime.now().isoformat()\n94\t            set_loop_state(state)\n95\t\n96\t\n97\tdef start_loopcli_process(iterations=0):\n98\t    global _loop_proc\n99\t    with _loop_lock:\n100\t        state = get_loop_state()\n101\t        if state.get(\"status\") == \"running\" and _is_pid_alive(state.get(\"pid\")):\n102\t            return {\"error\": \"Already running\"}, 409\n103\t\n104\t        cmd = [sys.executable, str(LOOPCLI_ROOT / \"run.py\"), \"run\"]\n105\t        if iterations > 0:\n106\t            cmd.extend([\"-n\", str(iterations)])\n107\t\n108\t        proc = subprocess.Popen(\n109\t            cmd,\n110\t            stdout=subprocess.DEVNULL,\n111\t            stderr=subprocess.DEVNULL,\n112\t            creationflags=getattr(subprocess, \"CREATE_NO_WINDOW\", 0),\n113\t        )\n114\t        _loop_proc = proc\n115\t\n116\t        state = {\n117\t            \"status\": \"running\",\n118\t            \"pid\": proc.pid,\n119\t            \"started_at\": datetime.now().isoformat(),\n120\t            \"iterations\": iterations,\n121\t            \"total_iterations\": 0,\n122\t        }\n123\t        set_loop_state(state)\n124\t\n125\t        t = threading.Thread(target=_monitor_loopcli, args=(proc,), daemon=True)\n126\t        t.start()\n127\t        return state, 200\n128\t\n129\t\n130\tdef stop_loopcli_process():\n131\t    global _loop_proc\n132\t    with _loop_lock:\n133\t        state = get_loop_state()\n134\t        pid = state.get(\"pid\")\n135\t        if not pid or not _is_pid_alive(pid):\n136\t            state[\"status\"] = \"stopped\"\n137\t            state[\"pid\"] = None\n138\t            set_loop_state(state)\n139\t            return {\"error\": \"Not running\"}, 409\n140\t\n141\t        try:\n142\t            os.kill(pid, signal.SIGTERM)\n143\t        except OSError:\n144\t            pass\n145\t        if _loop_proc and _loop_proc.pid == pid:\n146\t            try:\n147\t                _loop_proc.terminate()\n148\t            except OSError:\n149\t                pass\n150\t            _loop_proc = None\n151\t\n152\t        state[\"status\"] = \"stopped\"\n153\t        state[\"pid\"] = None\n154\t        state[\"ended_at\"] = datetime.now().isoformat()\n155\t        set_loop_state(state)\n156\t        return {\"status\": \"stopped\"}, 200\n157\t\n158\t\n159\tclass WebUIHandler(SimpleHTTPRequestHandler):\n160\t    def __init__(self, *args, **kwargs):\n161\t        super().__init__(*args, directory=str(WEBUI_DIR), **kwargs)\n162\t\n163\t    def log_message(self, format, *args):\n164\t        ts = datetime.now().strftime(\"%H:%M:%S\")\n165\t        sys.stdout.write(f\"[{ts}] {format % args}\\n\")\n166\t        sys.stdout.flush()\n167\t\n168\t    def _send_json(self, data, status=200):\n169\t        body = json.dumps(data, ensure_ascii=False, indent=2).encode(\"utf-8\")\n170\t        self.send_response(status)\n171\t        self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n172\t        self.send_header(\"Content-Length\", str(len(body)))\n173\t        self.end_headers()\n174\t        self.wfile.write(body)\n175\t\n176\t    def _read_body(self):\n177\t        length = int(self.headers.get(\"Content-Length\", 0))\n178\t        if length == 0:\n179\t            return {}\n180\t        if length > MAX_BODY_SIZE:\n181\t            self._send_json({\"error\": \"Request body too large\"}, status=413)\n182\t            return None\n183\t        raw = self.rfile.read(length)\n184\t        try:\n185\t            return json.loads(raw.decode(\"utf-8\"))\n186\t        except (json.JSONDecodeError, UnicodeDecodeError) as e:\n187\t            self._send_json({\"error\": f\"Invalid JSON: {e}\"}, status=400)\n188\t            return None\n189\t\n190\t    def _require_auth(self):\n191\t        if not API_KEY:\n192\t            return True\n193\t        key = self.headers.get(\"X-API-Key\", \"\") or parse_qs(urlparse(self.path).query).get(\"key\", [\"\"])[0]\n194\t        if not hmac.compare_digest(key, API_KEY):\n195\t            self._send_json({\"error\": \"Unauthorized\"}, status=401)\n196\t            return False\n197\t        return True\n198\t\n199\t    def _cors_headers(self):\n200\t        origin = self.headers.get(\"Origin\", \"\")\n201\t        if CORS_ORIGINS:\n202\t            if origin in CORS_ORIGINS:\n203\t                self.send_header(\"Access-Control-Allow-Origin\", origin)\n204\t                self.send_header(\"Vary\", \"Origin\")\n205\t        else:\n206\t            self.send_header(\"Access-Control-Allow-Origin\", \"*\")\n207\t        self.send_header(\"Access-Control-Allow-Methods\", \"GET, POST, OPTIONS\")\n208\t        self.send_header(\"Access-Control-Allow-Headers\", \"Content-Type\")\n209\t\n210\t    # ---------- SSE helpers ----------\n211\t\n212\t    def _send_sse_event(self, data):\n213\t        payload = f\"data: {json.dumps(data, ensure_ascii=False)}\\n\\n\"\n214\t        self.wfile.write(payload.encode(\"utf-8\"))\n215\t        self.wfile.flush()\n216\t\n217\t    def _handle_sse_logs(self):\n218\t        global _sse_connections\n219\t        with _sse_lock:\n220\t            if _sse_connections >= SSE_MAX_CONNECTIONS:\n221\t                return self._send_json({\"error\": \"Max SSE connections reached\"}, status=503)\n222\t            _sse_connections += 1\n223\t\n224\t        params = parse_qs(urlparse(self.path).query)\n225\t        agent_id = params.get(\"agent\", [None])[0]\n226\t        if agent_id:\n227\t            agent_dir = safe_agent_path(agent_id)\n228\t            if not agent_dir:\n229\t                with _sse_lock:\n230\t                    _sse_connections -= 1\n231\t                return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n232\t            log_path = agent_dir / \"log\" / \"run.md\"\n233\t        else:\n234\t            log_path = MAIN_DIR / \"log\" / \"run.md\"\n235\t\n236\t        self.send_response(200)\n237\t        self.send_header(\"Content-Type\", \"text/event-stream\")\n238\t        self.send_header(\"Cache-Control\", \"no-cache\")\n239\t        self.send_header(\"Connection\", \"keep-alive\")\n240\t        self.send_header(\"X-Accel-Buffering\", \"no\")\n241\t        self._cors_headers()\n242\t        self.end_headers()\n243\t\n244\t        last_pos = 0\n245\t        start_time = time.time()\n246\t        try:\n247\t            while True:\n248\t                if time.time() - start_time > SSE_TIMEOUT_SECONDS:\n249\t                    self._send_sse_event({\"event\": \"timeout\", \"ts\": datetime.now().isoformat()})\n250\t                    break\n251\t                if log_path.exists():\n252\t                    lines, last_pos = read_file_tail_incremental(log_path, last_pos)\n253\t                    if lines:\n254\t                        self._send_sse_event({\n255\t                            \"agent\": agent_id,\n256\t                            \"lines\": lines,\n257\t                            \"ts\": datetime.now().isoformat(),\n258\t                        })\n259\t                else:\n260\t                    if last_pos != -1:\n261\t                        self._send_sse_event({\"agent\": agent_id, \"lines\": [], \"ts\": datetime.now().isoformat()})\n262\t                        last_pos = -1\n263\t                time.sleep(1)\n264\t        except (BrokenPipeError, ConnectionResetError, OSError):\n265\t            pass\n266\t        finally:\n267\t            with _sse_lock:\n268\t                _sse_connections -= 1\n269\t\n270\t    # ---------- GET routes ----------\n271\t\n272\t    def do_GET(self):\n273\t        parsed = urlparse(self.path)\n274\t        path = parsed.path\n275\t\n276\t        if path == \"/api/agents\":\n277\t            return self._send_json(scan_agents())\n278\t\n279\t        if path == \"/api/tasks\":\n280\t            params = parse_qs(parsed.query)\n281\t            agent_id = params.get(\"agent\", [None])[0]\n282\t            if agent_id == \"__all__\":\n283\t                return self._send_json(get_all_agent_tasks())\n284\t            if agent_id:\n285\t                tasks = get_agent_tasks(agent_id)\n286\t                if tasks is None:\n287\t                    return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n288\t                return self._send_json(tasks)\n289\t            return self._send_json(get_main_tasks())\n290\t\n291\t        if path.startswith(\"/api/agents/\") and path.endswith(\"/tasks\"):\n292\t            agent_id = path[len(\"/api/agents/\"):-len(\"/tasks\")]\n293\t            tasks = get_agent_tasks(agent_id)\n294\t            if tasks is None:\n295\t                return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n296\t            return self._send_json(tasks)\n297\t\n298\t        if path == \"/api/logs\":\n299\t            params = parse_qs(parsed.query)\n300\t            n = int(params.get(\"n\", [\"100\"])[0])\n301\t            agent_id = params.get(\"agent\", [None])[0]\n302\t            if agent_id:\n303\t                agent_dir = safe_agent_path(agent_id)\n304\t                if not agent_dir:\n305\t                    return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n306\t                log_path = agent_dir / \"log\" / \"run.md\"\n307\t            else:\n308\t                log_path = MAIN_DIR / \"log\" / \"run.md\"\n309\t            lines = get_recent_lines(log_path, n)\n310\t            return self._send_json({\"agent\": agent_id, \"lines\": lines})\n311\t\n312\t        if path == \"/api/logs/stream\":\n313\t            return self._handle_sse_logs()\n314\t\n315\t        if path == \"/api/loopcli/status\":\n316\t            return self._handle_loopcli_status()\n317\t\n318\t        # Static files\n319\t        super().do_GET()\n320\t\n321\t    # ---------- POST routes ----------\n322\t\n323\t    def do_POST(self):\n324\t        if not _write_semaphore.acquire(timeout=5):\n325\t            return self._send_json({\"error\": \"Server busy, try again\"}, status=503)\n326\t        try:\n327\t            self._do_POST_impl()\n328\t        finally:\n329\t            _write_semaphore.release()\n330\t\n331\t    def _do_POST_impl(self):\n332\t        parsed = urlparse(self.path)\n333\t        path = parsed.path\n334\t\n335\t        if not self._require_auth():\n336\t            return\n337\t\n338\t        if path == \"/api/tasks\":\n339\t            return self._handle_create_task()\n340\t        if path == \"/api/agents/start\":\n341\t            return self._handle_agent_start()\n342\t        if path == \"/api/loopcli/start\":\n343\t            return self._handle_loopcli_start()\n344\t        if path == \"/api/loopcli/stop\":\n345\t            return self._handle_loopcli_stop()\n346\t        if path == \"/api/loopcli/restart\":\n347\t            return self._handle_loopcli_restart()\n348\t        if path == \"/api/loopcli/dispatch\":\n349\t            return self._handle_loopcli_dispatch()\n350\t        if path == \"/api/messages/send\":\n351\t            return self._handle_message_send()\n352\t        if path == \"/api/agents/enable\":\n353\t            return self._handle_agent_enable(\"enable\")\n354\t        if path == \"/api/agents/disable\":\n355\t            return self._handle_agent_enable(\"disable\")\n356\t\n357\t        self._send_json({\"error\": \"Not found\"}, status=404)\n358\t\n359\t    # ---------- OPTIONS (CORS preflight) ----------\n360\t\n361\t    def do_OPTIONS(self):\n362\t        self.send_response(204)\n363\t        self._cors_headers()\n364\t        self.end_headers()\n365\t\n366\t    # ---------- Handlers ----------\n367\t\n368\t    def _handle_create_task(self):\n369\t        body = self._read_body()\n370\t        if body is None:\n371\t            return\n372\t        title = body.get(\"title\", \"\").strip()\n373\t        if not title:\n374\t            return self._send_json({\"error\": \"title is required\"}, status=400)\n375\t\n376\t        assignee = body.get(\"assignee\") or \"main\"\n377\t        task = create_task(\n378\t            MAIN_DIR, title,\n379\t            description=body.get(\"description\", \"\"),\n380\t            assignee=assignee,\n381\t        )\n382\t        self._send_json(task, status=201)\n383\t\n384\t    def _handle_agent_start(self):\n385\t        body = self._read_body()\n386\t        if body is None:\n387\t            return\n388\t        agent_id = body.get(\"agent\", \"\").strip()\n389\t        if not agent_id:\n390\t            return self._send_json({\"error\": \"agent is required\"}, status=400)\n391\t\n392\t        agent_dir = safe_agent_path(agent_id)\n393\t        if not agent_dir:\n394\t            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n395\t\n396\t        prompt_file = agent_dir / \"PROMPT.md\"\n397\t        if not prompt_file.exists():\n398\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found or no PROMPT.md\"}, status=404)\n399\t\n400\t        prompt = prompt_file.read_text(encoding=\"utf-8\")\n401\t        proc = subprocess.Popen(\n402\t            [\"claude\", \"--print\"],\n403\t            stdin=subprocess.PIPE,\n404\t            stdout=subprocess.PIPE,\n405\t            stderr=subprocess.PIPE,\n406\t            cwd=str(agent_dir),\n407\t        )\n408\t        proc.stdin.write(prompt.encode(\"utf-8\"))\n409\t        proc.stdin.close()\n410\t\n411\t        self._send_json({\n412\t            \"agent\": agent_id,\n413\t            \"pid\": proc.pid,\n414\t            \"status\": \"started\",\n415\t        })\n416\t\n417\t    # --- Loop control handlers ---\n418\t\n419\t    def _handle_loopcli_status(self):\n420\t        state = get_loop_state()\n421\t        pid = state.get(\"pid\")\n422\t        if state.get(\"status\") == \"running\" and pid and not _is_pid_alive(pid):\n423\t            state[\"status\"] = \"stopped\"\n424\t            state[\"pid\"] = None\n425\t            state[\"ended_at\"] = datetime.now().isoformat()\n426\t            set_loop_state(state)\n427\t\n428\t        uptime = 0\n429\t        if state.get(\"started_at\"):\n430\t            try:\n431\t                started = datetime.fromisoformat(state[\"started_at\"])\n432\t                uptime = int((datetime.now() - started).total_seconds())\n433\t            except (ValueError, TypeError):\n434\t                pass\n435\t        state[\"uptime_seconds\"] = uptime\n436\t        self._send_json(state)\n437\t\n438\t    def _handle_loopcli_start(self):\n439\t        body = self._read_body()\n440\t        if body is None:\n441\t            return\n442\t        iterations = int(body.get(\"iterations\", 0))\n443\t        data, status = start_loopcli_process(iterations)\n444\t        self._send_json(data, status)\n445\t\n446\t    def _handle_loopcli_stop(self):\n447\t        data, status = stop_loopcli_process()\n448\t        self._send_json(data, status)\n449\t\n450\t    def _handle_loopcli_restart(self):\n451\t        body = self._read_body()\n452\t        if body is None:\n453\t            return\n454\t        stop_loopcli_process()\n455\t        time.sleep(0.5)\n456\t        iterations = int(body.get(\"iterations\", 0))\n457\t        data, status = start_loopcli_process(iterations)\n458\t        self._send_json(data, status)\n459\t\n460\t    def _handle_loopcli_dispatch(self):\n461\t        body = self._read_body()\n462\t        if body is None:\n463\t            return\n464\t        agent_id = body.get(\"agent\", \"\").strip()\n465\t        title = body.get(\"title\", \"\").strip()\n466\t        if not agent_id or not title:\n467\t            return self._send_json({\"error\": \"agent and title are required\"}, status=400)\n468\t\n469\t        agent_dir = safe_agent_path(agent_id)\n470\t        if not agent_dir or not (agent_dir / \"AGENT\").exists():\n471\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n472\t\n473\t        task = create_task(\n474\t            agent_dir, title,\n475\t            description=body.get(\"description\", \"\"),\n476\t            assignee=agent_id,\n477\t        )\n478\t\n479\t        # Start claude process for this agent\n480\t        prompt_file = agent_dir / \"PROMPT.md\"\n481\t        prompt = \"\"\n482\t        if prompt_file.exists():\n483\t            prompt = prompt_file.read_text(encoding=\"utf-8\")\n484\t\n485\t        proc = subprocess.Popen(\n486\t            [\"claude\", \"--print\", \"--dangerously-skip-permissions\"],\n487\t            stdin=subprocess.PIPE,\n488\t            stdout=subprocess.DEVNULL,\n489\t            stderr=subprocess.DEVNULL,\n490\t            cwd=str(agent_dir),\n491\t        )\n492\t        if prompt:\n493\t            proc.stdin.write(prompt.encode(\"utf-8\"))\n494\t            proc.stdin.close()\n495\t\n496\t        self._send_json({\n497\t            \"task\": task,\n498\t            \"pid\": proc.pid,\n499\t            \"status\": \"dispatched\",\n500\t        }, status=201)\n501\t\n502\t    def _handle_message_send(self):\n503\t        body = self._read_body()\n504\t        if body is None:\n505\t            return\n506\t        content = body.get(\"content\", \"\").strip()\n507\t        if not content:\n508\t            return self._send_json({\"error\": \"content is required\"}, status=400)\n509\t\n510\t        agent_id = body.get(\"agent\", \"main\").strip() or \"main\"\n511\t        agent_dir = safe_agent_path(agent_id)\n512\t        if not agent_dir:\n513\t            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n514\t        if not (agent_dir / \"AGENT\").exists():\n515\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n516\t\n517\t        msg_file = write_inbox_message(agent_dir, \"webui\", content)\n518\t        self._send_json({\"status\": \"sent\", \"agent\": agent_id, \"file\": msg_file.name}, status=201)\n519\t\n520\t    def _handle_agent_enable(self, action):\n521\t        body = self._read_body()\n522\t        if body is None:\n523\t            return\n524\t        agent_id = body.get(\"agent\", \"\").strip()\n525\t        if not agent_id:\n526\t            return self._send_json({\"error\": \"agent is required\"}, status=400)\n527\t        if agent_id == \"main\":\n528\t            return self._send_json({\"error\": \"cannot disable main agent\"}, status=400)\n529\t\n530\t        agent_dir = safe_agent_path(agent_id)\n531\t        if not agent_dir:\n532\t            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n533\t        if not (agent_dir / \"AGENT\").exists():\n534\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n535\t\n536\t        set_agent_enabled(agent_dir, action == \"enable\")\n537\t        self._send_json({\"status\": \"ok\", \"agent\": agent_id, \"enabled\": action == \"enable\"})\n538\t\n539\t\n540\tclass ThreadedHTTPServer(ThreadingMixIn, HTTPServer):\n541\t    daemon_threads = True\n542\t\n543\t\n544\tdef main():\n545\t    host = os.environ.get(\"LOOPCLI_HOST\", \"127.0.0.1\")\n546\t    port = 8080\n547\t    server = ThreadedHTTPServer((host, port), WebUIHandler)\n548\t    print(f\"LoopCLI WebUI Server running on http://{host}:{port}\")\n549\t    print(f\"Static files served from: {WEBUI_DIR}\")\n550\t    print(f\"Agent root: {LOOPCLI_ROOT}\")\n551\t    print(\"Press Ctrl+C to stop.\")\n552\t    try:\n553\t        server.serve_forever()\n554\t    except KeyboardInterrupt:\n555\t        print(\"\\nShutting down.\")\n556\t        server.server_close()\n557\t\n558\t\n559\tif __name__ == \"__main__\":\n560\t    main()\n561\t"}]},"parent_tool_use_id":null,"session_id":"53eb080d-5854-4f04-96ec-a843eb289f59","uuid":"13d5dcfe-5b72-47ab-88c5-56ecbdc75ab7","timestamp":"2026-05-21T01:03:23.262Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\loopcli\\main\\webui\\server.py","content":"\"\"\"\nLoopCLI WebUI Backend Server\nREST API + static file hosting for the Agent control console.\n\"\"\"\n\nimport hmac\nimport json\nimport os\nimport signal\nimport subprocess\nimport sys\nimport time\nimport threading\nimport uuid\nfrom datetime import datetime, timezone\nfrom http.server import HTTPServer, SimpleHTTPRequestHandler\nfrom socketserver import ThreadingMixIn\nfrom pathlib import Path\nfrom urllib.parse import urlparse, parse_qs\n\nfrom loopcli_lib import (\n    LOOPCLI_ROOT,\n    read_json,\n    write_json,\n    safe_agent_path,\n    scan_agents,\n    create_task,\n    get_agent_tasks,\n    get_all_agent_tasks,\n    write_inbox_message,\n    set_agent_enabled,\n    get_recent_lines,\n    read_file_tail_incremental,\n)\n\nWEBUI_DIR = Path(__file__).parent.resolve()\nMAIN_DIR = LOOPCLI_ROOT / \"main\"\nLOOP_STATE_FILE = WEBUI_DIR / \"loop_state.json\"\n\n_loop_proc = None\n_loop_lock = threading.Lock()\nAPI_KEY = os.environ.get(\"LOOPCLI_API_KEY\", \"\")\nMAX_BODY_SIZE = 10 * 1024  # 10KB\n\n_raw_cors = os.environ.get(\"CORS_ORIGINS\", \"\").strip()\nif _raw_cors:\n    CORS_ORIGINS = [o.strip() for o in _raw_cors.split(\",\") if o.strip()]\nelse:\n    CORS_ORIGINS = [\"http://localhost:3000\"]\n\n_write_semaphore = threading.Semaphore(10)\n\n_sse_connections = 0\n_sse_lock = threading.Lock()\nSSE_MAX_CONNECTIONS = 10\nSSE_TIMEOUT_SECONDS = 300\n\n\ndef get_main_tasks():\n    return read_json(MAIN_DIR / \"memory\" / \"tasks.json\", [])\n\n\n# --- Loop Process Management ---\n\ndef get_loop_state():\n    return read_json(LOOP_STATE_FILE, {\n        \"status\": \"stopped\", \"pid\": None,\n        \"started_at\": None, \"iterations\": 0, \"total_iterations\": 0,\n    })\n\n\ndef set_loop_state(state):\n    write_json(LOOP_STATE_FILE, state)\n\n\ndef _is_pid_alive(pid):\n    if not pid:\n        return False\n    try:\n        os.kill(pid, 0)\n        return True\n    except (ProcessLookupError, PermissionError, OSError):\n        return False\n\n\ndef _monitor_loopcli(proc):\n    proc.wait()\n    with _loop_lock:\n        state = get_loop_state()\n        if state.get(\"pid\") == proc.pid:\n            state[\"status\"] = \"stopped\"\n            state[\"pid\"] = None\n            state[\"ended_at\"] = datetime.now().isoformat()\n            set_loop_state(state)\n\n\ndef start_loopcli_process(iterations=0):\n    global _loop_proc\n    with _loop_lock:\n        state = get_loop_state()\n        if state.get(\"status\") == \"running\" and _is_pid_alive(state.get(\"pid\")):\n            return {\"error\": \"Already running\"}, 409\n\n        cmd = [sys.executable, str(LOOPCLI_ROOT / \"run.py\"), \"run\"]\n        if iterations > 0:\n            cmd.extend([\"-n\", str(iterations)])\n\n        proc = subprocess.Popen(\n            cmd,\n            stdout=subprocess.DEVNULL,\n            stderr=subprocess.DEVNULL,\n            creationflags=getattr(subprocess, \"CREATE_NO_WINDOW\", 0),\n        )\n        _loop_proc = proc\n\n        state = {\n            \"status\": \"running\",\n            \"pid\": proc.pid,\n            \"started_at\": datetime.now().isoformat(),\n            \"iterations\": iterations,\n            \"total_iterations\": 0,\n        }\n        set_loop_state(state)\n\n        t = threading.Thread(target=_monitor_loopcli, args=(proc,), daemon=True)\n        t.start()\n        return state, 200\n\n\ndef stop_loopcli_process():\n    global _loop_proc\n    with _loop_lock:\n        state = get_loop_state()\n        pid = state.get(\"pid\")\n        if not pid or not _is_pid_alive(pid):\n            state[\"status\"] = \"stopped\"\n            state[\"pid\"] = None\n            set_loop_state(state)\n            return {\"error\": \"Not running\"}, 409\n\n        try:\n            os.kill(pid, signal.SIGTERM)\n        except OSError:\n            pass\n        if _loop_proc and _loop_proc.pid == pid:\n            try:\n                _loop_proc.terminate()\n            except OSError:\n                pass\n            _loop_proc = None\n\n        state[\"status\"] = \"stopped\"\n        state[\"pid\"] = None\n        state[\"ended_at\"] = datetime.now().isoformat()\n        set_loop_state(state)\n        return {\"status\": \"stopped\"}, 200\n\n\nclass WebUIHandler(SimpleHTTPRequestHandler):\n    def __init__(self, *args, **kwargs):\n        super().__init__(*args, directory=str(WEBUI_DIR), **kwargs)\n\n    def log_message(self, format, *args):\n        ts = datetime.now().strftime(\"%H:%M:%S\")\n        sys.stdout.write(f\"[{ts}] {format % args}\\n\")\n        sys.stdout.flush()\n\n    def _send_json(self, data, status=200):\n        body = json.dumps(data, ensure_ascii=False, indent=2).encode(\"utf-8\")\n        self.send_response(status)\n        self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def _read_body(self):\n        length = int(self.headers.get(\"Content-Length\", 0))\n        if length == 0:\n            return {}\n        if length > MAX_BODY_SIZE:\n            self._send_json({\"error\": \"Request body too large\"}, status=413)\n            return None\n        raw = self.rfile.read(length)\n        try:\n            return json.loads(raw.decode(\"utf-8\"))\n        except (json.JSONDecodeError, UnicodeDecodeError) as e:\n            self._send_json({\"error\": f\"Invalid JSON: {e}\"}, status=400)\n            return None\n\n    def _require_auth(self):\n        if not API_KEY:\n            return True\n        key = self.headers.get(\"X-API-Key\", \"\") or parse_qs(urlparse(self.path).query).get(\"key\", [\"\"])[0]\n        if not hmac.compare_digest(key, API_KEY):\n            self._send_json({\"error\": \"Unauthorized\"}, status=401)\n            return False\n        return True\n\n    def _cors_headers(self):\n        origin = self.headers.get(\"Origin\", \"\")\n        if CORS_ORIGINS:\n            if origin in CORS_ORIGINS:\n                self.send_header(\"Access-Control-Allow-Origin\", origin)\n                self.send_header(\"Vary\", \"Origin\")\n        else:\n            self.send_header(\"Access-Control-Allow-Origin\", \"*\")\n        self.send_header(\"Access-Control-Allow-Methods\", \"GET, POST, OPTIONS\")\n        self.send_header(\"Access-Control-Allow-Headers\", \"Content-Type\")\n\n    # ---------- SSE helpers ----------\n\n    def _send_sse_event(self, data):\n        payload = f\"data: {json.dumps(data, ensure_ascii=False)}\\n\\n\"\n        self.wfile.write(payload.encode(\"utf-8\"))\n        self.wfile.flush()\n\n    def _handle_sse_logs(self):\n        global _sse_connections\n        with _sse_lock:\n            if _sse_connections >= SSE_MAX_CONNECTIONS:\n                return self._send_json({\"error\": \"Max SSE connections reached\"}, status=503)\n            _sse_connections += 1\n\n        params = parse_qs(urlparse(self.path).query)\n        agent_id = params.get(\"agent\", [None])[0]\n        if agent_id:\n            agent_dir = safe_agent_path(agent_id)\n            if not agent_dir:\n                with _sse_lock:\n                    _sse_connections -= 1\n                return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n            log_path = agent_dir / \"log\" / \"run.md\"\n        else:\n            log_path = MAIN_DIR / \"log\" / \"run.md\"\n\n        self.send_response(200)\n        self.send_header(\"Content-Type\", \"text/event-stream\")\n        self.send_header(\"Cache-Control\", \"no-cache\")\n        self.send_header(\"Connection\", \"keep-alive\")\n        self.send_header(\"X-Accel-Buffering\", \"no\")\n        self._cors_headers()\n        self.end_headers()\n\n        last_pos = 0\n        start_time = time.time()\n        try:\n            while True:\n                if time.time() - start_time > SSE_TIMEOUT_SECONDS:\n                    self._send_sse_event({\"event\": \"timeout\", \"ts\": datetime.now().isoformat()})\n                    break\n                if log_path.exists():\n                    lines, last_pos = read_file_tail_incremental(log_path, last_pos)\n                    if lines:\n                        self._send_sse_event({\n                            \"agent\": agent_id,\n                            \"lines\": lines,\n                            \"ts\": datetime.now().isoformat(),\n                        })\n                else:\n                    if last_pos != -1:\n                        self._send_sse_event({\"agent\": agent_id, \"lines\": [], \"ts\": datetime.now().isoformat()})\n                        last_pos = -1\n                time.sleep(1)\n        except (BrokenPipeError, ConnectionResetError, OSError):\n            pass\n        finally:\n            with _sse_lock:\n                _sse_connections -= 1\n\n    # ---------- GET routes ----------\n\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        path = parsed.path\n\n        if path == \"/api/agents\":\n            return self._send_json(scan_agents())\n\n        if path == \"/api/tasks\":\n            params = parse_qs(parsed.query)\n            agent_id = params.get(\"agent\", [None])[0]\n            if agent_id == \"__all__\":\n                return self._send_json(get_all_agent_tasks())\n            if agent_id:\n                tasks = get_agent_tasks(agent_id)\n                if tasks is None:\n                    return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n                return self._send_json(tasks)\n            return self._send_json(get_main_tasks())\n\n        if path.startswith(\"/api/agents/\") and path.endswith(\"/tasks\"):\n            agent_id = path[len(\"/api/agents/\"):-len(\"/tasks\")]\n            tasks = get_agent_tasks(agent_id)\n            if tasks is None:\n                return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n            return self._send_json(tasks)\n\n        if path == \"/api/logs\":\n            params = parse_qs(parsed.query)\n            n = int(params.get(\"n\", [\"100\"])[0])\n            agent_id = params.get(\"agent\", [None])[0]\n            if agent_id:\n                agent_dir = safe_agent_path(agent_id)\n                if not agent_dir:\n                    return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n                log_path = agent_dir / \"log\" / \"run.md\"\n            else:\n                log_path = MAIN_DIR / \"log\" / \"run.md\"\n            lines = get_recent_lines(log_path, n)\n            return self._send_json({\"agent\": agent_id, \"lines\": lines})\n\n        if path == \"/api/logs/stream\":\n            return self._handle_sse_logs()\n\n        if path == \"/api/loopcli/status\":\n            return self._handle_loopcli_status()\n\n        # Static files\n        super().do_GET()\n\n    # ---------- POST routes ----------\n\n    def do_POST(self):\n        if not _write_semaphore.acquire(timeout=5):\n            return self._send_json({\"error\": \"Server busy, try again\"}, status=503)\n        try:\n            self._do_POST_impl()\n        finally:\n            _write_semaphore.release()\n\n    def _do_POST_impl(self):\n        parsed = urlparse(self.path)\n        path = parsed.path\n\n        if not self._require_auth():\n            return\n\n        if path == \"/api/tasks\":\n            return self._handle_create_task()\n        if path == \"/api/agents/start\":\n            return self._handle_agent_start()\n        if path == \"/api/loopcli/start\":\n            return self._handle_loopcli_start()\n        if path == \"/api/loopcli/stop\":\n            return self._handle_loopcli_stop()\n        if path == \"/api/loopcli/restart\":\n            return self._handle_loopcli_restart()\n        if path == \"/api/loopcli/dispatch\":\n            return self._handle_loopcli_dispatch()\n        if path == \"/api/messages/send\":\n            return self._handle_message_send()\n        if path == \"/api/agents/enable\":\n            return self._handle_agent_enable(\"enable\")\n        if path == \"/api/agents/disable\":\n            return self._handle_agent_enable(\"disable\")\n\n        self._send_json({\"error\": \"Not found\"}, status=404)\n\n    # ---------- OPTIONS (CORS preflight) ----------\n\n    def do_OPTIONS(self):\n        self.send_response(204)\n        self._cors_headers()\n        self.end_headers()\n\n    # ---------- Handlers ----------\n\n    def _handle_create_task(self):\n        body = self._read_body()\n        if body is None:\n            return\n        title = body.get(\"title\", \"\").strip()\n        if not title:\n            return self._send_json({\"error\": \"title is required\"}, status=400)\n\n        assignee = body.get(\"assignee\") or \"main\"\n        task = create_task(\n            MAIN_DIR, title,\n            description=body.get(\"description\", \"\"),\n            assignee=assignee,\n        )\n        self._send_json(task, status=201)\n\n    def _handle_agent_start(self):\n        body = self._read_body()\n        if body is None:\n            return\n        agent_id = body.get(\"agent\", \"\").strip()\n        if not agent_id:\n            return self._send_json({\"error\": \"agent is required\"}, status=400)\n\n        agent_dir = safe_agent_path(agent_id)\n        if not agent_dir:\n            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n\n        prompt_file = agent_dir / \"PROMPT.md\"\n        if not prompt_file.exists():\n            return self._send_json({\"error\": f\"Agent '{agent_id}' not found or no PROMPT.md\"}, status=404)\n\n        prompt = prompt_file.read_text(encoding=\"utf-8\")\n        proc = subprocess.Popen(\n            [\"claude\", \"--print\"],\n            stdin=subprocess.PIPE,\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            cwd=str(agent_dir),\n        )\n        proc.stdin.write(prompt.encode(\"utf-8\"))\n        proc.stdin.close()\n\n        self._send_json({\n            \"agent\": agent_id,\n            \"pid\": proc.pid,\n            \"status\": \"started\",\n        })\n\n    # --- Loop control handlers ---\n\n    def _handle_loopcli_status(self):\n        state = get_loop_state()\n        pid = state.get(\"pid\")\n        if state.get(\"status\") == \"running\" and pid and not _is_pid_alive(pid):\n            state[\"status\"] = \"stopped\"\n            state[\"pid\"] = None\n            state[\"ended_at\"] = datetime.now().isoformat()\n            set_loop_state(state)\n\n        uptime = 0\n        if state.get(\"started_at\"):\n            try:\n                started = datetime.fromisoformat(state[\"started_at\"])\n                uptime = int((datetime.now() - started).total_seconds())\n            except (ValueError, TypeError):\n                pass\n        state[\"uptime_seconds\"] = uptime\n        self._send_json(state)\n\n    def _handle_loopcli_start(self):\n        body = self._read_body()\n        if body is None:\n            return\n        iterations = int(body.get(\"iterations\", 0))\n        data, status = start_loopcli_process(iterations)\n        self._send_json(data, status)\n\n    def _handle_loopcli_stop(self):\n        data, status = stop_loopcli_process()\n        self._send_json(data, status)\n\n    def _handle_loopcli_restart(self):\n        body = self._read_body()\n        if body is None:\n            return\n        stop_loopcli_process()\n        time.sleep(0.5)\n        iterations = int(body.get(\"iterations\", 0))\n        data, status = start_loopcli_process(iterations)\n        self._send_json(data, status)\n\n    def _handle_loopcli_dispatch(self):\n        body = self._read_body()\n        if body is None:\n            return\n        agent_id = body.get(\"agent\", \"\").strip()\n        title = body.get(\"title\", \"\").strip()\n        if not agent_id or not title:\n            return self._send_json({\"error\": \"agent and title are required\"}, status=400)\n\n        agent_dir = safe_agent_path(agent_id)\n        if not agent_dir or not (agent_dir / \"AGENT\").exists():\n            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n\n        task = create_task(\n            agent_dir, title,\n            description=body.get(\"description\", \"\"),\n            assignee=agent_id,\n        )\n\n        # Start claude process for this agent\n        prompt_file = agent_dir / \"PROMPT.md\"\n        prompt = \"\"\n        if prompt_file.exists():\n            prompt = prompt_file.read_text(encoding=\"utf-8\")\n\n        proc = subprocess.Popen(\n            [\"claude\", \"--print\", \"--dangerously-skip-permissions\"],\n            stdin=subprocess.PIPE,\n            stdout=subprocess.DEVNULL,\n            stderr=subprocess.DEVNULL,\n            cwd=str(agent_dir),\n        )\n        if prompt:\n            proc.stdin.write(prompt.encode(\"utf-8\"))\n            proc.stdin.close()\n\n        self._send_json({\n            \"task\": task,\n            \"pid\": proc.pid,\n            \"status\": \"dispatched\",\n        }, status=201)\n\n    def _handle_message_send(self):\n        body = self._read_body()\n        if body is None:\n            return\n        content = body.get(\"content\", \"\").strip()\n        if not content:\n            return self._send_json({\"error\": \"content is required\"}, status=400)\n\n        agent_id = body.get(\"agent\", \"main\").strip() or \"main\"\n        agent_dir = safe_agent_path(agent_id)\n        if not agent_dir:\n            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n        if not (agent_dir / \"AGENT\").exists():\n            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n\n        msg_file = write_inbox_message(agent_dir, \"webui\", content)\n        self._send_json({\"status\": \"sent\", \"agent\": agent_id, \"file\": msg_file.name}, status=201)\n\n    def _handle_agent_enable(self, action):\n        body = self._read_body()\n        if body is None:\n            return\n        agent_id = body.get(\"agent\", \"\").strip()\n        if not agent_id:\n            return self._send_json({\"error\": \"agent is required\"}, status=400)\n        if agent_id == \"main\":\n            return self._send_json({\"error\": \"cannot disable main agent\"}, status=400)\n\n        agent_dir = safe_agent_path(agent_id)\n        if not agent_dir:\n            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n        if not (agent_dir / \"AGENT\").exists():\n            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n\n        set_agent_enabled(agent_dir, action == \"enable\")\n        self._send_json({\"status\": \"ok\", \"agent\": agent_id, \"enabled\": action == \"enable\"})\n\n\nclass ThreadedHTTPServer(ThreadingMixIn, HTTPServer):\n    daemon_threads = True\n\n\ndef main():\n    host = os.environ.get(\"LOOPCLI_HOST\", \"127.0.0.1\")\n    port = 8080\n    server = ThreadedHTTPServer((host, port), WebUIHandler)\n    print(f\"LoopCLI WebUI Server running on http://{host}:{port}\")\n    print(f\"Static files served from: {WEBUI_DIR}\")\n    print(f\"Agent root: {LOOPCLI_ROOT}\")\n    print(\"Press Ctrl+C to stop.\")\n    try:\n        server.serve_forever()\n    except KeyboardInterrupt:\n        print(\"\\nShutting down.\")\n        server.server_close()\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":561,"startLine":1,"totalLines":561}}}
