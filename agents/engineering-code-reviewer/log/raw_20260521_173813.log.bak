{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_4b1bc27e17c24e058925fcb4","type":"tool_result","content":"1\t\"\"\"WebUI Process Watchdog — auto-restart on crash, designed for Windows Task Scheduler.\"\"\"\n2\timport subprocess\n3\timport sys\n4\timport time\n5\timport os\n6\t\n7\tSERVER_SCRIPT = os.path.join(os.path.dirname(__file__), \"server.py\")\n8\tPYTHON = sys.executable\n9\tRESTART_DELAY = 5  # seconds between restart attempts\n10\t\n11\t\n12\tdef main():\n13\t    print(f\"[watchdog] Starting WebUI watchdog (python={PYTHON})\")\n14\t    while True:\n15\t        print(f\"[watchdog] Launching server.py ...\")\n16\t        try:\n17\t            proc = subprocess.run(\n18\t                [PYTHON, SERVER_SCRIPT],\n19\t                cwd=os.path.dirname(__file__),\n20\t            )\n21\t            print(f\"[watchdog] server.py exited with code {proc.returncode}\")\n22\t        except Exception as e:\n23\t            print(f\"[watchdog] Exception: {e}\")\n24\t\n25\t        print(f\"[watchdog] Restarting in {RESTART_DELAY}s ...\")\n26\t        time.sleep(RESTART_DELAY)\n27\t\n28\t\n29\tif __name__ == \"__main__\":\n30\t    main()\n31\t"}]},"parent_tool_use_id":null,"session_id":"53eb080d-5854-4f04-96ec-a843eb289f59","uuid":"8efbed88-ddbe-4b5a-8308-b60fc1d6d5dc","timestamp":"2026-05-21T01:03:29.743Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\loopcli\\main\\webui\\watchdog.py","content":"\"\"\"WebUI Process Watchdog — auto-restart on crash, designed for Windows Task Scheduler.\"\"\"\nimport subprocess\nimport sys\nimport time\nimport os\n\nSERVER_SCRIPT = os.path.join(os.path.dirname(__file__), \"server.py\")\nPYTHON = sys.executable\nRESTART_DELAY = 5  # seconds between restart attempts\n\n\ndef main():\n    print(f\"[watchdog] Starting WebUI watchdog (python={PYTHON})\")\n    while True:\n        print(f\"[watchdog] Launching server.py ...\")\n        try:\n            proc = subprocess.run(\n                [PYTHON, SERVER_SCRIPT],\n                cwd=os.path.dirname(__file__),\n            )\n            print(f\"[watchdog] server.py exited with code {proc.returncode}\")\n        except Exception as e:\n            print(f\"[watchdog] Exception: {e}\")\n\n        print(f\"[watchdog] Restarting in {RESTART_DELAY}s ...\")\n        time.sleep(RESTART_DELAY)\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":31,"startLine":1,"totalLines":31}}}
