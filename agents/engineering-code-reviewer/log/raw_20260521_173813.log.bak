{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_323ec7372771417b8d037937","type":"tool_result","content":"1\t\"\"\"\n2\tLoopCLI WebUI Backend Server\n3\tREST API + static file hosting for the Agent control console.\n4\t\"\"\"\n5\t\n6\timport hmac\n7\timport json\n8\timport os\n9\timport signal\n10\timport subprocess\n11\timport sys\n12\timport time\n13\timport threading\n14\timport uuid\n15\tfrom datetime import datetime, timezone\n16\tfrom http.server import HTTPServer, SimpleHTTPRequestHandler\n17\tfrom socketserver import ThreadingMixIn\n18\tfrom pathlib import Path\n19\tfrom urllib.parse import urlparse, parse_qs\n20\t\n21\tLOOPCLI_ROOT = Path(r\"D:\\loopcli\")\n22\tWEBUI_DIR = Path(__file__).parent.resolve()\n23\tMAIN_DIR = LOOPCLI_ROOT / \"main\"\n24\tLOOP_STATE_FILE = WEBUI_DIR / \"loop_state.json\"\n25\t\n26\t_loop_proc = None\n27\t_loop_lock = threading.Lock()\n28\t_json_lock = threading.Lock()\n29\tAPI_KEY = os.environ.get(\"LOOPCLI_API_KEY\", \"\")\n30\tMAX_BODY_SIZE = 10 * 1024  # 10KB\n31\t\n32\t_raw_cors = os.environ.get(\"CORS_ORIGINS\", \"\").strip()\n33\tif _raw_cors:\n34\t    CORS_ORIGINS = [o.strip() for o in _raw_cors.split(\",\") if o.strip()]\n35\telse:\n36\t    CORS_ORIGINS = [\"http://localhost:3000\"]\n37\t\n38\t_write_semaphore = threading.Semaphore(10)\n39\t\n40\t_sse_connections = 0\n41\t_sse_lock = threading.Lock()\n42\tSSE_MAX_CONNECTIONS = 10\n43\tSSE_TIMEOUT_SECONDS = 300\n44\t\n45\t\n46\tdef read_json(path: Path, default=None):\n47\t    if not path.exists():\n48\t        return default if default is not None else {}\n49\t    try:\n50\t        return json.loads(path.read_text(encoding=\"utf-8\"))\n51\t    except (json.JSONDecodeError, OSError):\n52\t        return default if default is not None else {}\n53\t\n54\t\n55\tdef write_json(path: Path, data):\n56\t    with _json_lock:\n57\t        path.parent.mkdir(parents=True, exist_ok=True)\n58\t        path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n59\t\n60\t\n61\tdef _safe_agent_path(agent_id: str) -> Path | None:\n62\t    if not agent_id or '/' in agent_id or '\\\\' in agent_id or '..' in agent_id or '\\x00' in agent_id:\n63\t        return None\n64\t    agent_dir = LOOPCLI_ROOT / agent_id\n65\t    try:\n66\t        agent_dir.resolve().relative_to(LOOPCLI_ROOT.resolve())\n67\t    except ValueError:\n68\t        return None\n69\t    return agent_dir\n70\t\n71\t\n72\tdef scan_agents():\n73\t    \"\"\"Scan loopcli root for agent directories (containing AGENT marker file).\"\"\"\n74\t    agents = []\n75\t    for child in LOOPCLI_ROOT.iterdir():\n76\t        if not child.is_dir():\n77\t            continue\n78\t        agent_marker = child / \"AGENT\"\n79\t        if not agent_marker.exists():\n80\t            continue\n81\t        state = read_json(child / \"memory\" / \"state.json\", {})\n82\t        soul_path = child / \"SOUL.md\"\n83\t        desc = \"\"\n84\t        if soul_path.exists():\n85\t            lines = soul_path.read_text(encoding=\"utf-8\").strip().splitlines()\n86\t            for line in lines:\n87\t                stripped = line.strip()\n88\t                if stripped and not stripped.startswith(\"#\"):\n89\t                    desc = stripped\n90\t                    break\n91\t        tasks = read_json(child / \"memory\" / \"tasks.json\", [])\n92\t        done_count = sum(1 for t in tasks if t.get(\"status\") == \"done\")\n93\t        pending_count = sum(1 for t in tasks if t.get(\"status\") == \"pending\")\n94\t        agents.append({\n95\t            \"id\": child.name,\n96\t            \"name\": state.get(\"agent\", child.name),\n97\t            \"status\": state.get(\"status\", \"unknown\"),\n98\t            \"description\": desc,\n99\t            \"last_run\": state.get(\"last_run\"),\n100\t            \"run_count\": state.get(\"run_count\", 0),\n101\t            \"current_task\": state.get(\"current_task\"),\n102\t            \"task_count\": len(tasks),\n103\t            \"task_done\": done_count,\n104\t            \"task_pending\": pending_count,\n105\t        })\n106\t    return agents\n107\t\n108\t\n109\tdef get_main_tasks():\n110\t    return read_json(MAIN_DIR / \"memory\" / \"tasks.json\", [])\n111\t\n112\t\n113\tdef get_agent_tasks(agent_id: str):\n114\t    agent_dir = _safe_agent_path(agent_id)\n115\t    if not agent_dir:\n116\t        return None\n117\t    tasks_file = agent_dir / \"memory\" / \"tasks.json\"\n118\t    return read_json(tasks_file, [])\n119\t\n120\t\n121\tdef get_all_agent_tasks():\n122\t    \"\"\"Aggregate tasks from all agents, each tagged with agent_id.\"\"\"\n123\t    all_tasks = []\n124\t    for child in LOOPCLI_ROOT.iterdir():\n125\t        if not child.is_dir() or not (child / \"AGENT\").exists():\n126\t            continue\n127\t        tasks_file = child / \"memory\" / \"tasks.json\"\n128\t        tasks = read_json(tasks_file, [])\n129\t        for t in tasks:\n130\t            t[\"_agent_id\"] = child.name\n131\t        all_tasks.extend(tasks)\n132\t    return all_tasks\n133\t\n134\t\n135\tdef get_recent_lines(filepath: Path, n=100):\n136\t    if not filepath.exists():\n137\t        return []\n138\t    try:\n139\t        with open(filepath, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n140\t            lines = f.readlines()\n141\t        return [l.rstrip(\"\\n\\r\") for l in lines[-n:]]\n142\t    except OSError:\n143\t        return []\n144\t\n145\t\n146\t# --- Loop Process Management ---\n147\t\n148\tdef get_loop_state():\n149\t    return read_json(LOOP_STATE_FILE, {\n150\t        \"status\": \"stopped\", \"pid\": None,\n151\t        \"started_at\": None, \"iterations\": 0, \"total_iterations\": 0,\n152\t    })\n153\t\n154\t\n155\tdef set_loop_state(state):\n156\t    write_json(LOOP_STATE_FILE, state)\n157\t\n158\t\n159\tdef _is_pid_alive(pid):\n160\t    if not pid:\n161\t        return False\n162\t    try:\n163\t        os.kill(pid, 0)\n164\t        return True\n165\t    except (ProcessLookupError, PermissionError, OSError):\n166\t        return False\n167\t\n168\t\n169\tdef _monitor_loopcli(proc):\n170\t    proc.wait()\n171\t    with _loop_lock:\n172\t        state = get_loop_state()\n173\t        if state.get(\"pid\") == proc.pid:\n174\t            state[\"status\"] = \"stopped\"\n175\t            state[\"pid\"] = None\n176\t            state[\"ended_at\"] = datetime.now().isoformat()\n177\t            set_loop_state(state)\n178\t\n179\t\n180\tdef start_loopcli_process(iterations=0):\n181\t    global _loop_proc\n182\t    with _loop_lock:\n183\t        state = get_loop_state()\n184\t        if state.get(\"status\") == \"running\" and _is_pid_alive(state.get(\"pid\")):\n185\t            return {\"error\": \"Already running\"}, 409\n186\t\n187\t        cmd = [sys.executable, str(LOOPCLI_ROOT / \"run.py\"), \"run\"]\n188\t        if iterations > 0:\n189\t            cmd.extend([\"-n\", str(iterations)])\n190\t\n191\t        proc = subprocess.Popen(\n192\t            cmd,\n193\t            stdout=subprocess.DEVNULL,\n194\t            stderr=subprocess.DEVNULL,\n195\t            creationflags=getattr(subprocess, \"CREATE_NO_WINDOW\", 0),\n196\t        )\n197\t        _loop_proc = proc\n198\t\n199\t        state = {\n200\t            \"status\": \"running\",\n201\t            \"pid\": proc.pid,\n202\t            \"started_at\": datetime.now().isoformat(),\n203\t            \"iterations\": iterations,\n204\t            \"total_iterations\": 0,\n205\t        }\n206\t        set_loop_state(state)\n207\t\n208\t        t = threading.Thread(target=_monitor_loopcli, args=(proc,), daemon=True)\n209\t        t.start()\n210\t        return state, 200\n211\t\n212\t\n213\tdef stop_loopcli_process():\n214\t    global _loop_proc\n215\t    with _loop_lock:\n216\t        state = get_loop_state()\n217\t        pid = state.get(\"pid\")\n218\t        if not pid or not _is_pid_alive(pid):\n219\t            state[\"status\"] = \"stopped\"\n220\t            state[\"pid\"] = None\n221\t            set_loop_state(state)\n222\t            return {\"error\": \"Not running\"}, 409\n223\t\n224\t        try:\n225\t            os.kill(pid, signal.SIGTERM)\n226\t        except OSError:\n227\t            pass\n228\t        if _loop_proc and _loop_proc.pid == pid:\n229\t            try:\n230\t                _loop_proc.terminate()\n231\t            except OSError:\n232\t                pass\n233\t            _loop_proc = None\n234\t\n235\t        state[\"status\"] = \"stopped\"\n236\t        state[\"pid\"] = None\n237\t        state[\"ended_at\"] = datetime.now().isoformat()\n238\t        set_loop_state(state)\n239\t        return {\"status\": \"stopped\"}, 200\n240\t\n241\t\n242\tclass WebUIHandler(SimpleHTTPRequestHandler):\n243\t    def __init__(self, *args, **kwargs):\n244\t        super().__init__(*args, directory=str(WEBUI_DIR), **kwargs)\n245\t\n246\t    def log_message(self, format, *args):\n247\t        ts = datetime.now().strftime(\"%H:%M:%S\")\n248\t        sys.stdout.write(f\"[{ts}] {format % args}\\n\")\n249\t        sys.stdout.flush()\n250\t\n251\t    def _send_json(self, data, status=200):\n252\t        body = json.dumps(data, ensure_ascii=False, indent=2).encode(\"utf-8\")\n253\t        self.send_response(status)\n254\t        self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n255\t        self.send_header(\"Content-Length\", str(len(body)))\n256\t        self.end_headers()\n257\t        self.wfile.write(body)\n258\t\n259\t    def _read_body(self):\n260\t        length = int(self.headers.get(\"Content-Length\", 0))\n261\t        if length == 0:\n262\t            return {}\n263\t        if length > MAX_BODY_SIZE:\n264\t            self._send_json({\"error\": \"Request body too large\"}, status=413)\n265\t            return None\n266\t        raw = self.rfile.read(length)\n267\t        try:\n268\t            return json.loads(raw.decode(\"utf-8\"))\n269\t        except (json.JSONDecodeError, UnicodeDecodeError):\n270\t            return {}\n271\t\n272\t    def _require_auth(self):\n273\t        if not API_KEY:\n274\t            return True\n275\t        key = self.headers.get(\"X-API-Key\", \"\") or parse_qs(urlparse(self.path).query).get(\"key\", [\"\"])[0]\n276\t        if not hmac.compare_digest(key, API_KEY):\n277\t            self._send_json({\"error\": \"Unauthorized\"}, status=401)\n278\t            return False\n279\t        return True\n280\t\n281\t    def _cors_headers(self):\n282\t        origin = self.headers.get(\"Origin\", \"\")\n283\t        if CORS_ORIGINS:\n284\t            if origin in CORS_ORIGINS:\n285\t                self.send_header(\"Access-Control-Allow-Origin\", origin)\n286\t                self.send_header(\"Vary\", \"Origin\")\n287\t        else:\n288\t            self.send_header(\"Access-Control-Allow-Origin\", \"*\")\n289\t        self.send_header(\"Access-Control-Allow-Methods\", \"GET, POST, OPTIONS\")\n290\t        self.send_header(\"Access-Control-Allow-Headers\", \"Content-Type\")\n291\t\n292\t    # ---------- SSE helpers ----------\n293\t\n294\t    def _send_sse_event(self, data):\n295\t        payload = f\"data: {json.dumps(data, ensure_ascii=False)}\\n\\n\"\n296\t        self.wfile.write(payload.encode(\"utf-8\"))\n297\t        self.wfile.flush()\n298\t\n299\t    def _handle_sse_logs(self):\n300\t        global _sse_connections\n301\t        with _sse_lock:\n302\t            if _sse_connections >= SSE_MAX_CONNECTIONS:\n303\t                return self._send_json({\"error\": \"Max SSE connections reached\"}, status=503)\n304\t            _sse_connections += 1\n305\t\n306\t        params = parse_qs(urlparse(self.path).query)\n307\t        agent_id = params.get(\"agent\", [None])[0]\n308\t        if agent_id:\n309\t            agent_dir = _safe_agent_path(agent_id)\n310\t            if not agent_dir:\n311\t                with _sse_lock:\n312\t                    _sse_connections -= 1\n313\t                return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n314\t            log_path = agent_dir / \"log\" / \"run.md\"\n315\t        else:\n316\t            log_path = MAIN_DIR / \"log\" / \"run.md\"\n317\t\n318\t        self.send_response(200)\n319\t        self.send_header(\"Content-Type\", \"text/event-stream\")\n320\t        self.send_header(\"Cache-Control\", \"no-cache\")\n321\t        self.send_header(\"Connection\", \"keep-alive\")\n322\t        self.send_header(\"X-Accel-Buffering\", \"no\")\n323\t        self._cors_headers()\n324\t        self.end_headers()\n325\t\n326\t        last_size = 0\n327\t        start_time = time.time()\n328\t        try:\n329\t            while True:\n330\t                if time.time() - start_time > SSE_TIMEOUT_SECONDS:\n331\t                    self._send_sse_event({\"event\": \"timeout\", \"ts\": datetime.now().isoformat()})\n332\t                    break\n333\t                if log_path.exists():\n334\t                    current_size = log_path.stat().st_size\n335\t                    if current_size != last_size:\n336\t                        lines = get_recent_lines(log_path, 500)\n337\t                        self._send_sse_event({\n338\t                            \"agent\": agent_id,\n339\t                            \"lines\": lines,\n340\t                            \"ts\": datetime.now().isoformat(),\n341\t                        })\n342\t                        last_size = current_size\n343\t                else:\n344\t                    if last_size != -1:\n345\t                        self._send_sse_event({\"agent\": agent_id, \"lines\": [], \"ts\": datetime.now().isoformat()})\n346\t                        last_size = -1\n347\t                time.sleep(1)\n348\t        except (BrokenPipeError, ConnectionResetError, OSError):\n349\t            pass\n350\t        finally:\n351\t            with _sse_lock:\n352\t                _sse_connections -= 1\n353\t\n354\t    # ---------- GET routes ----------\n355\t\n356\t    def do_GET(self):\n357\t        parsed = urlparse(self.path)\n358\t        path = parsed.path\n359\t\n360\t        if path == \"/api/agents\":\n361\t            return self._send_json(scan_agents())\n362\t\n363\t        if path == \"/api/tasks\":\n364\t            params = parse_qs(parsed.query)\n365\t            agent_id = params.get(\"agent\", [None])[0]\n366\t            if agent_id == \"__all__\":\n367\t                return self._send_json(get_all_agent_tasks())\n368\t            if agent_id:\n369\t                tasks = get_agent_tasks(agent_id)\n370\t                if tasks is None:\n371\t                    return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n372\t                return self._send_json(tasks)\n373\t            return self._send_json(get_main_tasks())\n374\t\n375\t        if path.startswith(\"/api/agents/\") and path.endswith(\"/tasks\"):\n376\t            agent_id = path[len(\"/api/agents/\"):-len(\"/tasks\")]\n377\t            tasks = get_agent_tasks(agent_id)\n378\t            if tasks is None:\n379\t                return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n380\t            return self._send_json(tasks)\n381\t\n382\t        if path == \"/api/logs\":\n383\t            params = parse_qs(parsed.query)\n384\t            n = int(params.get(\"n\", [\"100\"])[0])\n385\t            agent_id = params.get(\"agent\", [None])[0]\n386\t            if agent_id:\n387\t                agent_dir = _safe_agent_path(agent_id)\n388\t                if not agent_dir:\n389\t                    return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n390\t                log_path = agent_dir / \"log\" / \"run.md\"\n391\t            else:\n392\t                log_path = MAIN_DIR / \"log\" / \"run.md\"\n393\t            lines = get_recent_lines(log_path, n)\n394\t            return self._send_json({\"agent\": agent_id, \"lines\": lines})\n395\t\n396\t        if path == \"/api/logs/stream\":\n397\t            return self._handle_sse_logs()\n398\t\n399\t        if path == \"/api/loopcli/status\":\n400\t            return self._handle_loopcli_status()\n401\t\n402\t        # Static files\n403\t        super().do_GET()\n404\t\n405\t    # ---------- POST routes ----------\n406\t\n407\t    def do_POST(self):\n408\t        if not _write_semaphore.acquire(timeout=5):\n409\t            return self._send_json({\"error\": \"Server busy, try again\"}, status=503)\n410\t        try:\n411\t            self._do_POST_impl()\n412\t        finally:\n413\t            _write_semaphore.release()\n414\t\n415\t    def _do_POST_impl(self):\n416\t        parsed = urlparse(self.path)\n417\t        path = parsed.path\n418\t\n419\t        if not self._require_auth():\n420\t            return\n421\t\n422\t        if path == \"/api/tasks\":\n423\t            return self._handle_create_task()\n424\t        if path == \"/api/agents/start\":\n425\t            return self._handle_agent_start()\n426\t        if path == \"/api/loopcli/start\":\n427\t            return self._handle_loopcli_start()\n428\t        if path == \"/api/loopcli/stop\":\n429\t            return self._handle_loopcli_stop()\n430\t        if path == \"/api/loopcli/restart\":\n431\t            return self._handle_loopcli_restart()\n432\t        if path == \"/api/loopcli/dispatch\":\n433\t            return self._handle_loopcli_dispatch()\n434\t        if path == \"/api/messages/send\":\n435\t            return self._handle_message_send()\n436\t        if path == \"/api/agents/enable\":\n437\t            return self._handle_agent_enable(\"enable\")\n438\t        if path == \"/api/agents/disable\":\n439\t            return self._handle_agent_enable(\"disable\")\n440\t\n441\t        self._send_json({\"error\": \"Not found\"}, status=404)\n442\t\n443\t    # ---------- OPTIONS (CORS preflight) ----------\n444\t\n445\t    def do_OPTIONS(self):\n446\t        self.send_response(204)\n447\t        self._cors_headers()\n448\t        self.end_headers()\n449\t\n450\t    # ---------- Handlers ----------\n451\t\n452\t    def _handle_create_task(self):\n453\t        body = self._read_body()\n454\t        if body is None:\n455\t            return\n456\t        title = body.get(\"title\", \"\").strip()\n457\t        if not title:\n458\t            return self._send_json({\"error\": \"title is required\"}, status=400)\n459\t\n460\t        tasks = get_main_tasks()\n461\t        new_id = max((t.get(\"id\", 0) for t in tasks), default=0) + 1\n462\t        task = {\n463\t            \"id\": new_id,\n464\t            \"status\": \"pending\",\n465\t            \"title\": title,\n466\t            \"description\": body.get(\"description\", \"\"),\n467\t            \"created\": datetime.now(timezone.utc).strftime(\"%Y-%m-%d\"),\n468\t            \"assignee\": body.get(\"assignee\") or \"main\",\n469\t        }\n470\t        tasks.append(task)\n471\t        write_json(MAIN_DIR / \"memory\" / \"tasks.json\", tasks)\n472\t        self._send_json(task, status=201)\n473\t\n474\t    def _handle_agent_start(self):\n475\t        body = self._read_body()\n476\t        if body is None:\n477\t            return\n478\t        agent_id = body.get(\"agent\", \"\").strip()\n479\t        if not agent_id:\n480\t            return self._send_json({\"error\": \"agent is required\"}, status=400)\n481\t\n482\t        agent_dir = _safe_agent_path(agent_id)\n483\t        if not agent_dir:\n484\t            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n485\t\n486\t        prompt_file = agent_dir / \"PROMPT.md\"\n487\t        if not prompt_file.exists():\n488\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found or no PROMPT.md\"}, status=404)\n489\t\n490\t        prompt = prompt_file.read_text(encoding=\"utf-8\")\n491\t        proc = subprocess.Popen(\n492\t            [\"claude\", \"--print\"],\n493\t            stdin=subprocess.PIPE,\n494\t            stdout=subprocess.PIPE,\n495\t            stderr=subprocess.PIPE,\n496\t            cwd=str(agent_dir),\n497\t        )\n498\t        proc.stdin.write(prompt.encode(\"utf-8\"))\n499\t        proc.stdin.close()\n500\t\n501\t        self._send_json({\n502\t            \"agent\": agent_id,\n503\t            \"pid\": proc.pid,\n504\t            \"status\": \"started\",\n505\t        })\n506\t\n507\t    # --- Loop control handlers ---\n508\t\n509\t    def _handle_loopcli_status(self):\n510\t        state = get_loop_state()\n511\t        pid = state.get(\"pid\")\n512\t        if state.get(\"status\") == \"running\" and pid and not _is_pid_alive(pid):\n513\t            state[\"status\"] = \"stopped\"\n514\t            state[\"pid\"] = None\n515\t            state[\"ended_at\"] = datetime.now().isoformat()\n516\t            set_loop_state(state)\n517\t\n518\t        uptime = 0\n519\t        if state.get(\"started_at\"):\n520\t            try:\n521\t                started = datetime.fromisoformat(state[\"started_at\"])\n522\t                uptime = int((datetime.now() - started).total_seconds())\n523\t            except (ValueError, TypeError):\n524\t                pass\n525\t        state[\"uptime_seconds\"] = uptime\n526\t        self._send_json(state)\n527\t\n528\t    def _handle_loopcli_start(self):\n529\t        body = self._read_body()\n530\t        if body is None:\n531\t            return\n532\t        iterations = int(body.get(\"iterations\", 0))\n533\t        data, status = start_loopcli_process(iterations)\n534\t        self._send_json(data, status)\n535\t\n536\t    def _handle_loopcli_stop(self):\n537\t        data, status = stop_loopcli_process()\n538\t        self._send_json(data, status)\n539\t\n540\t    def _handle_loopcli_restart(self):\n541\t        body = self._read_body()\n542\t        if body is None:\n543\t            return\n544\t        stop_loopcli_process()\n545\t        time.sleep(0.5)\n546\t        iterations = int(body.get(\"iterations\", 0))\n547\t        data, status = start_loopcli_process(iterations)\n548\t        self._send_json(data, status)\n549\t\n550\t    def _handle_loopcli_dispatch(self):\n551\t        body = self._read_body()\n552\t        if body is None:\n553\t            return\n554\t        agent_id = body.get(\"agent\", \"\").strip()\n555\t        title = body.get(\"title\", \"\").strip()\n556\t        if not agent_id or not title:\n557\t            return self._send_json({\"error\": \"agent and title are required\"}, status=400)\n558\t\n559\t        agent_dir = _safe_agent_path(agent_id)\n560\t        if not agent_dir or not (agent_dir / \"AGENT\").exists():\n561\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n562\t\n563\t        # Write task to agent's tasks.json\n564\t        tasks_file = agent_dir / \"memory\" / \"tasks.json\"\n565\t        tasks = read_json(tasks_file, [])\n566\t        new_id = max((t.get(\"id\", 0) for t in tasks), default=0) + 1\n567\t        task = {\n568\t            \"id\": new_id,\n569\t            \"status\": \"pending\",\n570\t            \"title\": title,\n571\t            \"description\": body.get(\"description\", \"\"),\n572\t            \"created\": datetime.now(timezone.utc).strftime(\"%Y-%m-%d\"),\n573\t            \"assignee\": agent_id,\n574\t        }\n575\t        tasks.append(task)\n576\t        write_json(tasks_file, tasks)\n577\t\n578\t        # Start claude process for this agent\n579\t        prompt_file = agent_dir / \"PROMPT.md\"\n580\t        prompt = \"\"\n581\t        if prompt_file.exists():\n582\t            prompt = prompt_file.read_text(encoding=\"utf-8\")\n583\t\n584\t        proc = subprocess.Popen(\n585\t            [\"claude\", \"--print\", \"--dangerously-skip-permissions\"],\n586\t            stdin=subprocess.PIPE,\n587\t            stdout=subprocess.DEVNULL,\n588\t            stderr=subprocess.DEVNULL,\n589\t            cwd=str(agent_dir),\n590\t        )\n591\t        if prompt:\n592\t            proc.stdin.write(prompt.encode(\"utf-8\"))\n593\t            proc.stdin.close()\n594\t\n595\t        self._send_json({\n596\t            \"task\": task,\n597\t            \"pid\": proc.pid,\n598\t            \"status\": \"dispatched\",\n599\t        }, status=201)\n600\t\n601\t    def _handle_message_send(self):\n602\t        body = self._read_body()\n603\t        if body is None:\n604\t            return\n605\t        content = body.get(\"content\", \"\").strip()\n606\t        if not content:\n607\t            return self._send_json({\"error\": \"content is required\"}, status=400)\n608\t\n609\t        agent_id = body.get(\"agent\", \"main\").strip() or \"main\"\n610\t        agent_dir = _safe_agent_path(agent_id)\n611\t        if not agent_dir:\n612\t            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n613\t        if not (agent_dir / \"AGENT\").exists():\n614\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n615\t\n616\t        inbox_dir = agent_dir / \"inbox\"\n617\t        inbox_dir.mkdir(parents=True, exist_ok=True)\n618\t\n619\t        now = datetime.now()\n620\t        ts = now.strftime(\"%Y%m%d_%H%M\")\n621\t        msg_file = inbox_dir / f\"webui_{ts}_{uuid.uuid4().hex[:8]}.md\"\n622\t        msg_file.write_text(\n623\t            f\"# 来自 WebUI 的消息\\n- 类型：指令\\n- 时间：{now.strftime('%Y-%m-%d %H:%M')}\\n\\n## 内容\\n{content}\\n\",\n624\t            encoding=\"utf-8\",\n625\t        )\n626\t        self._send_json({\"status\": \"sent\", \"agent\": agent_id, \"file\": msg_file.name}, status=201)\n627\t\n628\t    def _handle_agent_enable(self, action):\n629\t        body = self._read_body()\n630\t        if body is None:\n631\t            return\n632\t        agent_id = body.get(\"agent\", \"\").strip()\n633\t        if not agent_id:\n634\t            return self._send_json({\"error\": \"agent is required\"}, status=400)\n635\t        if agent_id == \"main\":\n636\t            return self._send_json({\"error\": \"cannot disable main agent\"}, status=400)\n637\t\n638\t        agent_dir = _safe_agent_path(agent_id)\n639\t        if not agent_dir:\n640\t            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n641\t        marker = agent_dir / \"AGENT\"\n642\t        if not marker.exists():\n643\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n644\t\n645\t        if action == \"enable\":\n646\t            marker.write_text(\"type: main\\n\", encoding=\"utf-8\")\n647\t        else:\n648\t            marker.write_text(\"type: main\\ndisabled: true\\n\", encoding=\"utf-8\")\n649\t\n650\t        self._send_json({\"status\": \"ok\", \"agent\": agent_id, \"enabled\": action == \"enable\"})\n651\t\n652\t\n653\tclass ThreadedHTTPServer(ThreadingMixIn, HTTPServer):\n654\t    daemon_threads = True\n655\t\n656\t\n657\tdef main():\n658\t    host = os.environ.get(\"LOOPCLI_HOST\", \"127.0.0.1\")\n659\t    port = 8080\n660\t    server = ThreadedHTTPServer((host, port), WebUIHandler)\n661\t    print(f\"LoopCLI WebUI Server running on http://{host}:{port}\")\n662\t    print(f\"Static files served from: {WEBUI_DIR}\")\n663\t    print(f\"Agent root: {LOOPCLI_ROOT}\")\n664\t    print(\"Press Ctrl+C to stop.\")\n665\t    try:\n666\t        server.serve_forever()\n667\t    except KeyboardInterrupt:\n668\t        print(\"\\nShutting down.\")\n669\t        server.server_close()\n670\t\n671\t\n672\tif __name__ == \"__main__\":\n673\t    main()\n674\t"}]},"parent_tool_use_id":null,"session_id":"3155194a-dbbc-4fb8-93ec-1734839a2821","uuid":"09207788-1ccd-43eb-a5c6-0d765da332d4","timestamp":"2026-05-21T00:41:40.518Z","tool_use_result":{"type":"text","file":{"filePath":"D:/loopcli/main/webui/server.py","content":"\"\"\"\nLoopCLI WebUI Backend Server\nREST API + static file hosting for the Agent control console.\n\"\"\"\n\nimport hmac\nimport json\nimport os\nimport signal\nimport subprocess\nimport sys\nimport time\nimport threading\nimport uuid\nfrom datetime import datetime, timezone\nfrom http.server import HTTPServer, SimpleHTTPRequestHandler\nfrom socketserver import ThreadingMixIn\nfrom pathlib import Path\nfrom urllib.parse import urlparse, parse_qs\n\nLOOPCLI_ROOT = Path(r\"D:\\loopcli\")\nWEBUI_DIR = Path(__file__).parent.resolve()\nMAIN_DIR = LOOPCLI_ROOT / \"main\"\nLOOP_STATE_FILE = WEBUI_DIR / \"loop_state.json\"\n\n_loop_proc = None\n_loop_lock = threading.Lock()\n_json_lock = threading.Lock()\nAPI_KEY = os.environ.get(\"LOOPCLI_API_KEY\", \"\")\nMAX_BODY_SIZE = 10 * 1024  # 10KB\n\n_raw_cors = os.environ.get(\"CORS_ORIGINS\", \"\").strip()\nif _raw_cors:\n    CORS_ORIGINS = [o.strip() for o in _raw_cors.split(\",\") if o.strip()]\nelse:\n    CORS_ORIGINS = [\"http://localhost:3000\"]\n\n_write_semaphore = threading.Semaphore(10)\n\n_sse_connections = 0\n_sse_lock = threading.Lock()\nSSE_MAX_CONNECTIONS = 10\nSSE_TIMEOUT_SECONDS = 300\n\n\ndef read_json(path: Path, default=None):\n    if not path.exists():\n        return default if default is not None else {}\n    try:\n        return json.loads(path.read_text(encoding=\"utf-8\"))\n    except (json.JSONDecodeError, OSError):\n        return default if default is not None else {}\n\n\ndef write_json(path: Path, data):\n    with _json_lock:\n        path.parent.mkdir(parents=True, exist_ok=True)\n        path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n\n\ndef _safe_agent_path(agent_id: str) -> Path | None:\n    if not agent_id or '/' in agent_id or '\\\\' in agent_id or '..' in agent_id or '\\x00' in agent_id:\n        return None\n    agent_dir = LOOPCLI_ROOT / agent_id\n    try:\n        agent_dir.resolve().relative_to(LOOPCLI_ROOT.resolve())\n    except ValueError:\n        return None\n    return agent_dir\n\n\ndef scan_agents():\n    \"\"\"Scan loopcli root for agent directories (containing AGENT marker file).\"\"\"\n    agents = []\n    for child in LOOPCLI_ROOT.iterdir():\n        if not child.is_dir():\n            continue\n        agent_marker = child / \"AGENT\"\n        if not agent_marker.exists():\n            continue\n        state = read_json(child / \"memory\" / \"state.json\", {})\n        soul_path = child / \"SOUL.md\"\n        desc = \"\"\n        if soul_path.exists():\n            lines = soul_path.read_text(encoding=\"utf-8\").strip().splitlines()\n            for line in lines:\n                stripped = line.strip()\n                if stripped and not stripped.startswith(\"#\"):\n                    desc = stripped\n                    break\n        tasks = read_json(child / \"memory\" / \"tasks.json\", [])\n        done_count = sum(1 for t in tasks if t.get(\"status\") == \"done\")\n        pending_count = sum(1 for t in tasks if t.get(\"status\") == \"pending\")\n        agents.append({\n            \"id\": child.name,\n            \"name\": state.get(\"agent\", child.name),\n            \"status\": state.get(\"status\", \"unknown\"),\n            \"description\": desc,\n            \"last_run\": state.get(\"last_run\"),\n            \"run_count\": state.get(\"run_count\", 0),\n            \"current_task\": state.get(\"current_task\"),\n            \"task_count\": len(tasks),\n            \"task_done\": done_count,\n            \"task_pending\": pending_count,\n        })\n    return agents\n\n\ndef get_main_tasks():\n    return read_json(MAIN_DIR / \"memory\" / \"tasks.json\", [])\n\n\ndef get_agent_tasks(agent_id: str):\n    agent_dir = _safe_agent_path(agent_id)\n    if not agent_dir:\n        return None\n    tasks_file = agent_dir / \"memory\" / \"tasks.json\"\n    return read_json(tasks_file, [])\n\n\ndef get_all_agent_tasks():\n    \"\"\"Aggregate tasks from all agents, each tagged with agent_id.\"\"\"\n    all_tasks = []\n    for child in LOOPCLI_ROOT.iterdir():\n        if not child.is_dir() or not (child / \"AGENT\").exists():\n            continue\n        tasks_file = child / \"memory\" / \"tasks.json\"\n        tasks = read_json(tasks_file, [])\n        for t in tasks:\n            t[\"_agent_id\"] = child.name\n        all_tasks.extend(tasks)\n    return all_tasks\n\n\ndef get_recent_lines(filepath: Path, n=100):\n    if not filepath.exists():\n        return []\n    try:\n        with open(filepath, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n            lines = f.readlines()\n        return [l.rstrip(\"\\n\\r\") for l in lines[-n:]]\n    except OSError:\n        return []\n\n\n# --- Loop Process Management ---\n\ndef get_loop_state():\n    return read_json(LOOP_STATE_FILE, {\n        \"status\": \"stopped\", \"pid\": None,\n        \"started_at\": None, \"iterations\": 0, \"total_iterations\": 0,\n    })\n\n\ndef set_loop_state(state):\n    write_json(LOOP_STATE_FILE, state)\n\n\ndef _is_pid_alive(pid):\n    if not pid:\n        return False\n    try:\n        os.kill(pid, 0)\n        return True\n    except (ProcessLookupError, PermissionError, OSError):\n        return False\n\n\ndef _monitor_loopcli(proc):\n    proc.wait()\n    with _loop_lock:\n        state = get_loop_state()\n        if state.get(\"pid\") == proc.pid:\n            state[\"status\"] = \"stopped\"\n            state[\"pid\"] = None\n            state[\"ended_at\"] = datetime.now().isoformat()\n            set_loop_state(state)\n\n\ndef start_loopcli_process(iterations=0):\n    global _loop_proc\n    with _loop_lock:\n        state = get_loop_state()\n        if state.get(\"status\") == \"running\" and _is_pid_alive(state.get(\"pid\")):\n            return {\"error\": \"Already running\"}, 409\n\n        cmd = [sys.executable, str(LOOPCLI_ROOT / \"run.py\"), \"run\"]\n        if iterations > 0:\n            cmd.extend([\"-n\", str(iterations)])\n\n        proc = subprocess.Popen(\n            cmd,\n            stdout=subprocess.DEVNULL,\n            stderr=subprocess.DEVNULL,\n            creationflags=getattr(subprocess, \"CREATE_NO_WINDOW\", 0),\n        )\n        _loop_proc = proc\n\n        state = {\n            \"status\": \"running\",\n            \"pid\": proc.pid,\n            \"started_at\": datetime.now().isoformat(),\n            \"iterations\": iterations,\n            \"total_iterations\": 0,\n        }\n        set_loop_state(state)\n\n        t = threading.Thread(target=_monitor_loopcli, args=(proc,), daemon=True)\n        t.start()\n        return state, 200\n\n\ndef stop_loopcli_process():\n    global _loop_proc\n    with _loop_lock:\n        state = get_loop_state()\n        pid = state.get(\"pid\")\n        if not pid or not _is_pid_alive(pid):\n            state[\"status\"] = \"stopped\"\n            state[\"pid\"] = None\n            set_loop_state(state)\n            return {\"error\": \"Not running\"}, 409\n\n        try:\n            os.kill(pid, signal.SIGTERM)\n        except OSError:\n            pass\n        if _loop_proc and _loop_proc.pid == pid:\n            try:\n                _loop_proc.terminate()\n            except OSError:\n                pass\n            _loop_proc = None\n\n        state[\"status\"] = \"stopped\"\n        state[\"pid\"] = None\n        state[\"ended_at\"] = datetime.now().isoformat()\n        set_loop_state(state)\n        return {\"status\": \"stopped\"}, 200\n\n\nclass WebUIHandler(SimpleHTTPRequestHandler):\n    def __init__(self, *args, **kwargs):\n        super().__init__(*args, directory=str(WEBUI_DIR), **kwargs)\n\n    def log_message(self, format, *args):\n        ts = datetime.now().strftime(\"%H:%M:%S\")\n        sys.stdout.write(f\"[{ts}] {format % args}\\n\")\n        sys.stdout.flush()\n\n    def _send_json(self, data, status=200):\n        body = json.dumps(data, ensure_ascii=False, indent=2).encode(\"utf-8\")\n        self.send_response(status)\n        self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def _read_body(self):\n        length = int(self.headers.get(\"Content-Length\", 0))\n        if length == 0:\n            return {}\n        if length > MAX_BODY_SIZE:\n            self._send_json({\"error\": \"Request body too large\"}, status=413)\n            return None\n        raw = self.rfile.read(length)\n        try:\n            return json.loads(raw.decode(\"utf-8\"))\n        except (json.JSONDecodeError, UnicodeDecodeError):\n            return {}\n\n    def _require_auth(self):\n        if not API_KEY:\n            return True\n        key = self.headers.get(\"X-API-Key\", \"\") or parse_qs(urlparse(self.path).query).get(\"key\", [\"\"])[0]\n        if not hmac.compare_digest(key, API_KEY):\n            self._send_json({\"error\": \"Unauthorized\"}, status=401)\n            return False\n        return True\n\n    def _cors_headers(self):\n        origin = self.headers.get(\"Origin\", \"\")\n        if CORS_ORIGINS:\n            if origin in CORS_ORIGINS:\n                self.send_header(\"Access-Control-Allow-Origin\", origin)\n                self.send_header(\"Vary\", \"Origin\")\n        else:\n            self.send_header(\"Access-Control-Allow-Origin\", \"*\")\n        self.send_header(\"Access-Control-Allow-Methods\", \"GET, POST, OPTIONS\")\n        self.send_header(\"Access-Control-Allow-Headers\", \"Content-Type\")\n\n    # ---------- SSE helpers ----------\n\n    def _send_sse_event(self, data):\n        payload = f\"data: {json.dumps(data, ensure_ascii=False)}\\n\\n\"\n        self.wfile.write(payload.encode(\"utf-8\"))\n        self.wfile.flush()\n\n    def _handle_sse_logs(self):\n        global _sse_connections\n        with _sse_lock:\n            if _sse_connections >= SSE_MAX_CONNECTIONS:\n                return self._send_json({\"error\": \"Max SSE connections reached\"}, status=503)\n            _sse_connections += 1\n\n        params = parse_qs(urlparse(self.path).query)\n        agent_id = params.get(\"agent\", [None])[0]\n        if agent_id:\n            agent_dir = _safe_agent_path(agent_id)\n            if not agent_dir:\n                with _sse_lock:\n                    _sse_connections -= 1\n                return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n            log_path = agent_dir / \"log\" / \"run.md\"\n        else:\n            log_path = MAIN_DIR / \"log\" / \"run.md\"\n\n        self.send_response(200)\n        self.send_header(\"Content-Type\", \"text/event-stream\")\n        self.send_header(\"Cache-Control\", \"no-cache\")\n        self.send_header(\"Connection\", \"keep-alive\")\n        self.send_header(\"X-Accel-Buffering\", \"no\")\n        self._cors_headers()\n        self.end_headers()\n\n        last_size = 0\n        start_time = time.time()\n        try:\n            while True:\n                if time.time() - start_time > SSE_TIMEOUT_SECONDS:\n                    self._send_sse_event({\"event\": \"timeout\", \"ts\": datetime.now().isoformat()})\n                    break\n                if log_path.exists():\n                    current_size = log_path.stat().st_size\n                    if current_size != last_size:\n                        lines = get_recent_lines(log_path, 500)\n                        self._send_sse_event({\n                            \"agent\": agent_id,\n                            \"lines\": lines,\n                            \"ts\": datetime.now().isoformat(),\n                        })\n                        last_size = current_size\n                else:\n                    if last_size != -1:\n                        self._send_sse_event({\"agent\": agent_id, \"lines\": [], \"ts\": datetime.now().isoformat()})\n                        last_size = -1\n                time.sleep(1)\n        except (BrokenPipeError, ConnectionResetError, OSError):\n            pass\n        finally:\n            with _sse_lock:\n                _sse_connections -= 1\n\n    # ---------- GET routes ----------\n\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        path = parsed.path\n\n        if path == \"/api/agents\":\n            return self._send_json(scan_agents())\n\n        if path == \"/api/tasks\":\n            params = parse_qs(parsed.query)\n            agent_id = params.get(\"agent\", [None])[0]\n            if agent_id == \"__all__\":\n                return self._send_json(get_all_agent_tasks())\n            if agent_id:\n                tasks = get_agent_tasks(agent_id)\n                if tasks is None:\n                    return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n                return self._send_json(tasks)\n            return self._send_json(get_main_tasks())\n\n        if path.startswith(\"/api/agents/\") and path.endswith(\"/tasks\"):\n            agent_id = path[len(\"/api/agents/\"):-len(\"/tasks\")]\n            tasks = get_agent_tasks(agent_id)\n            if tasks is None:\n                return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n            return self._send_json(tasks)\n\n        if path == \"/api/logs\":\n            params = parse_qs(parsed.query)\n            n = int(params.get(\"n\", [\"100\"])[0])\n            agent_id = params.get(\"agent\", [None])[0]\n            if agent_id:\n                agent_dir = _safe_agent_path(agent_id)\n                if not agent_dir:\n                    return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n                log_path = agent_dir / \"log\" / \"run.md\"\n            else:\n                log_path = MAIN_DIR / \"log\" / \"run.md\"\n            lines = get_recent_lines(log_path, n)\n            return self._send_json({\"agent\": agent_id, \"lines\": lines})\n\n        if path == \"/api/logs/stream\":\n            return self._handle_sse_logs()\n\n        if path == \"/api/loopcli/status\":\n            return self._handle_loopcli_status()\n\n        # Static files\n        super().do_GET()\n\n    # ---------- POST routes ----------\n\n    def do_POST(self):\n        if not _write_semaphore.acquire(timeout=5):\n            return self._send_json({\"error\": \"Server busy, try again\"}, status=503)\n        try:\n            self._do_POST_impl()\n        finally:\n            _write_semaphore.release()\n\n    def _do_POST_impl(self):\n        parsed = urlparse(self.path)\n        path = parsed.path\n\n        if not self._require_auth():\n            return\n\n        if path == \"/api/tasks\":\n            return self._handle_create_task()\n        if path == \"/api/agents/start\":\n            return self._handle_agent_start()\n        if path == \"/api/loopcli/start\":\n            return self._handle_loopcli_start()\n        if path == \"/api/loopcli/stop\":\n            return self._handle_loopcli_stop()\n        if path == \"/api/loopcli/restart\":\n            return self._handle_loopcli_restart()\n        if path == \"/api/loopcli/dispatch\":\n            return self._handle_loopcli_dispatch()\n        if path == \"/api/messages/send\":\n            return self._handle_message_send()\n        if path == \"/api/agents/enable\":\n            return self._handle_agent_enable(\"enable\")\n        if path == \"/api/agents/disable\":\n            return self._handle_agent_enable(\"disable\")\n\n        self._send_json({\"error\": \"Not found\"}, status=404)\n\n    # ---------- OPTIONS (CORS preflight) ----------\n\n    def do_OPTIONS(self):\n        self.send_response(204)\n        self._cors_headers()\n        self.end_headers()\n\n    # ---------- Handlers ----------\n\n    def _handle_create_task(self):\n        body = self._read_body()\n        if body is None:\n            return\n        title = body.get(\"title\", \"\").strip()\n        if not title:\n            return self._send_json({\"error\": \"title is required\"}, status=400)\n\n        tasks = get_main_tasks()\n        new_id = max((t.get(\"id\", 0) for t in tasks), default=0) + 1\n        task = {\n            \"id\": new_id,\n            \"status\": \"pending\",\n            \"title\": title,\n            \"description\": body.get(\"description\", \"\"),\n            \"created\": datetime.now(timezone.utc).strftime(\"%Y-%m-%d\"),\n            \"assignee\": body.get(\"assignee\") or \"main\",\n        }\n        tasks.append(task)\n        write_json(MAIN_DIR / \"memory\" / \"tasks.json\", tasks)\n        self._send_json(task, status=201)\n\n    def _handle_agent_start(self):\n        body = self._read_body()\n        if body is None:\n            return\n        agent_id = body.get(\"agent\", \"\").strip()\n        if not agent_id:\n            return self._send_json({\"error\": \"agent is required\"}, status=400)\n\n        agent_dir = _safe_agent_path(agent_id)\n        if not agent_dir:\n            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n\n        prompt_file = agent_dir / \"PROMPT.md\"\n        if not prompt_file.exists():\n            return self._send_json({\"error\": f\"Agent '{agent_id}' not found or no PROMPT.md\"}, status=404)\n\n        prompt = prompt_file.read_text(encoding=\"utf-8\")\n        proc = subprocess.Popen(\n            [\"claude\", \"--print\"],\n            stdin=subprocess.PIPE,\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            cwd=str(agent_dir),\n        )\n        proc.stdin.write(prompt.encode(\"utf-8\"))\n        proc.stdin.close()\n\n        self._send_json({\n            \"agent\": agent_id,\n            \"pid\": proc.pid,\n            \"status\": \"started\",\n        })\n\n    # --- Loop control handlers ---\n\n    def _handle_loopcli_status(self):\n        state = get_loop_state()\n        pid = state.get(\"pid\")\n        if state.get(\"status\") == \"running\" and pid and not _is_pid_alive(pid):\n            state[\"status\"] = \"stopped\"\n            state[\"pid\"] = None\n            state[\"ended_at\"] = datetime.now().isoformat()\n            set_loop_state(state)\n\n        uptime = 0\n        if state.get(\"started_at\"):\n            try:\n                started = datetime.fromisoformat(state[\"started_at\"])\n                uptime = int((datetime.now() - started).total_seconds())\n            except (ValueError, TypeError):\n                pass\n        state[\"uptime_seconds\"] = uptime\n        self._send_json(state)\n\n    def _handle_loopcli_start(self):\n        body = self._read_body()\n        if body is None:\n            return\n        iterations = int(body.get(\"iterations\", 0))\n        data, status = start_loopcli_process(iterations)\n        self._send_json(data, status)\n\n    def _handle_loopcli_stop(self):\n        data, status = stop_loopcli_process()\n        self._send_json(data, status)\n\n    def _handle_loopcli_restart(self):\n        body = self._read_body()\n        if body is None:\n            return\n        stop_loopcli_process()\n        time.sleep(0.5)\n        iterations = int(body.get(\"iterations\", 0))\n        data, status = start_loopcli_process(iterations)\n        self._send_json(data, status)\n\n    def _handle_loopcli_dispatch(self):\n        body = self._read_body()\n        if body is None:\n            return\n        agent_id = body.get(\"agent\", \"\").strip()\n        title = body.get(\"title\", \"\").strip()\n        if not agent_id or not title:\n            return self._send_json({\"error\": \"agent and title are required\"}, status=400)\n\n        agent_dir = _safe_agent_path(agent_id)\n        if not agent_dir or not (agent_dir / \"AGENT\").exists():\n            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n\n        # Write task to agent's tasks.json\n        tasks_file = agent_dir / \"memory\" / \"tasks.json\"\n        tasks = read_json(tasks_file, [])\n        new_id = max((t.get(\"id\", 0) for t in tasks), default=0) + 1\n        task = {\n            \"id\": new_id,\n            \"status\": \"pending\",\n            \"title\": title,\n            \"description\": body.get(\"description\", \"\"),\n            \"created\": datetime.now(timezone.utc).strftime(\"%Y-%m-%d\"),\n            \"assignee\": agent_id,\n        }\n        tasks.append(task)\n        write_json(tasks_file, tasks)\n\n        # Start claude process for this agent\n        prompt_file = agent_dir / \"PROMPT.md\"\n        prompt = \"\"\n        if prompt_file.exists():\n            prompt = prompt_file.read_text(encoding=\"utf-8\")\n\n        proc = subprocess.Popen(\n            [\"claude\", \"--print\", \"--dangerously-skip-permissions\"],\n            stdin=subprocess.PIPE,\n            stdout=subprocess.DEVNULL,\n            stderr=subprocess.DEVNULL,\n            cwd=str(agent_dir),\n        )\n        if prompt:\n            proc.stdin.write(prompt.encode(\"utf-8\"))\n            proc.stdin.close()\n\n        self._send_json({\n            \"task\": task,\n            \"pid\": proc.pid,\n            \"status\": \"dispatched\",\n        }, status=201)\n\n    def _handle_message_send(self):\n        body = self._read_body()\n        if body is None:\n            return\n        content = body.get(\"content\", \"\").strip()\n        if not content:\n            return self._send_json({\"error\": \"content is required\"}, status=400)\n\n        agent_id = body.get(\"agent\", \"main\").strip() or \"main\"\n        agent_dir = _safe_agent_path(agent_id)\n        if not agent_dir:\n            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n        if not (agent_dir / \"AGENT\").exists():\n            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n\n        inbox_dir = agent_dir / \"inbox\"\n        inbox_dir.mkdir(parents=True, exist_ok=True)\n\n        now = datetime.now()\n        ts = now.strftime(\"%Y%m%d_%H%M\")\n        msg_file = inbox_dir / f\"webui_{ts}_{uuid.uuid4().hex[:8]}.md\"\n        msg_file.write_text(\n            f\"# 来自 WebUI 的消息\\n- 类型：指令\\n- 时间：{now.strftime('%Y-%m-%d %H:%M')}\\n\\n## 内容\\n{content}\\n\",\n            encoding=\"utf-8\",\n        )\n        self._send_json({\"status\": \"sent\", \"agent\": agent_id, \"file\": msg_file.name}, status=201)\n\n    def _handle_agent_enable(self, action):\n        body = self._read_body()\n        if body is None:\n            return\n        agent_id = body.get(\"agent\", \"\").strip()\n        if not agent_id:\n            return self._send_json({\"error\": \"agent is required\"}, status=400)\n        if agent_id == \"main\":\n            return self._send_json({\"error\": \"cannot disable main agent\"}, status=400)\n\n        agent_dir = _safe_agent_path(agent_id)\n        if not agent_dir:\n            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n        marker = agent_dir / \"AGENT\"\n        if not marker.exists():\n            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n\n        if action == \"enable\":\n            marker.write_text(\"type: main\\n\", encoding=\"utf-8\")\n        else:\n            marker.write_text(\"type: main\\ndisabled: true\\n\", encoding=\"utf-8\")\n\n        self._send_json({\"status\": \"ok\", \"agent\": agent_id, \"enabled\": action == \"enable\"})\n\n\nclass ThreadedHTTPServer(ThreadingMixIn, HTTPServer):\n    daemon_threads = True\n\n\ndef main():\n    host = os.environ.get(\"LOOPCLI_HOST\", \"127.0.0.1\")\n    port = 8080\n    server = ThreadedHTTPServer((host, port), WebUIHandler)\n    print(f\"LoopCLI WebUI Server running on http://{host}:{port}\")\n    print(f\"Static files served from: {WEBUI_DIR}\")\n    print(f\"Agent root: {LOOPCLI_ROOT}\")\n    print(\"Press Ctrl+C to stop.\")\n    try:\n        server.serve_forever()\n    except KeyboardInterrupt:\n        print(\"\\nShutting down.\")\n        server.server_close()\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":674,"startLine":1,"totalLines":674}}}
