{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_710f8d30c98a4a178cea2cc2","type":"tool_result","content":"1\t\"\"\"\n2\tTests for webui/server.py — API endpoints and helper functions.\n3\tUses a real threaded HTTP server with httpx client.\n4\t\"\"\"\n5\t\n6\timport json\n7\timport os\n8\timport sys\n9\timport time\n10\timport threading\n11\timport pytest\n12\timport httpx\n13\tfrom unittest.mock import patch\n14\t\n15\t# Add webui directory to path so we can import server\n16\tsys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"webui\"))\n17\t\n18\tfrom server import (\n19\t    WebUIHandler,\n20\t    ThreadedHTTPServer,\n21\t    MAIN_DIR,\n22\t)\n23\tfrom loopcli_lib import (\n24\t    safe_agent_path as _safe_agent_path,\n25\t    read_json,\n26\t    write_json,\n27\t    scan_agents,\n28\t    get_recent_lines,\n29\t    LOOPCLI_ROOT,\n30\t)\n31\tfrom pathlib import Path\n32\t\n33\t\n34\t# ─── Fixtures ───\n35\t\n36\tBASE_PORT = 18765\n37\t_port_lock = threading.Lock()\n38\t_port_counter = [0]\n39\t\n40\t\n41\tdef _get_port():\n42\t    with _port_lock:\n43\t        _port_counter[0] += 1\n44\t        return BASE_PORT + _port_counter[0]\n45\t\n46\t\n47\t@pytest.fixture(scope=\"module\")\n48\tdef http_server():\n49\t    \"\"\"Start a real HTTP server in a thread for the entire module.\"\"\"\n50\t    port = _get_port()\n51\t    server = ThreadedHTTPServer((\"127.0.0.1\", port), WebUIHandler)\n52\t    t = threading.Thread(target=server.serve_forever, daemon=True)\n53\t    t.start()\n54\t    time.sleep(0.2)\n55\t    yield f\"http://127.0.0.1:{port}\"\n56\t    server.shutdown()\n57\t\n58\t\n59\t@pytest.fixture\n60\tdef client(http_server):\n61\t    return httpx.Client(base_url=http_server, timeout=5)\n62\t\n63\t\n64\t# ─── Helper: _safe_agent_path ───\n65\t\n66\tclass TestSafeAgentPath:\n67\t    def test_valid_agent(self):\n68\t        result = _safe_agent_path(\"main\")\n69\t        assert result is not None\n70\t        assert str(result) == str(LOOPCLI_ROOT / \"main\")\n71\t\n72\t    def test_empty_string(self):\n73\t        assert _safe_agent_path(\"\") is None\n74\t\n75\t    def test_slash_traversal(self):\n76\t        assert _safe_agent_path(\"main/../../../etc\") is None\n77\t\n78\t    def test_backslash_traversal(self):\n79\t        assert _safe_agent_path(\"main\\\\..\\\\..\\\\etc\") is None\n80\t\n81\t    def test_double_dot(self):\n82\t        assert _safe_agent_path(\"..\") is None\n83\t\n84\t    def test_path_with_slash(self):\n85\t        assert _safe_agent_path(\"foo/bar\") is None\n86\t\n87\t    def test_path_with_backslash(self):\n88\t        assert _safe_agent_path(\"foo\\\\bar\") is None\n89\t\n90\t    def test_valid_subdir_name(self):\n91\t        result = _safe_agent_path(\"engineering-frontend-developer\")\n92\t        assert result is not None\n93\t        assert result.name == \"engineering-frontend-developer\"\n94\t\n95\t    def test_null_byte_injection(self):\n96\t        assert _safe_agent_path(\"main\\x00\") is None\n97\t\n98\t    def test_null_byte_in_middle(self):\n99\t        assert _safe_agent_path(\"main\\x00evil\") is None\n100\t\n101\t    def test_null_byte_at_start(self):\n102\t        assert _safe_agent_path(\"\\x00main\") is None\n103\t\n104\t    def test_null_byte_with_suffix(self):\n105\t        assert _safe_agent_path(\"main\\x00.sh\") is None\n106\t\n107\t\n108\t# ─── Helper: read_json / write_json ───\n109\t\n110\tclass TestJsonIO:\n111\t    def test_read_nonexistent_returns_default(self, tmp_path):\n112\t        result = read_json(tmp_path / \"nope.json\", {\"x\": 1})\n113\t        assert result == {\"x\": 1}\n114\t\n115\t    def test_read_nonexistent_no_default(self, tmp_path):\n116\t        result = read_json(tmp_path / \"nope.json\")\n117\t        assert result == {}\n118\t\n119\t    def test_read_valid_json(self, tmp_path):\n120\t        p = tmp_path / \"test.json\"\n121\t        p.write_text('{\"a\": 1}', encoding=\"utf-8\")\n122\t        assert read_json(p) == {\"a\": 1}\n123\t\n124\t    def test_read_corrupt_json(self, tmp_path):\n125\t        p = tmp_path / \"bad.json\"\n126\t        p.write_text(\"{invalid\", encoding=\"utf-8\")\n127\t        assert read_json(p, \"fallback\") == \"fallback\"\n128\t\n129\t    def test_write_json_creates_dirs(self, tmp_path):\n130\t        p = tmp_path / \"sub\" / \"dir\" / \"out.json\"\n131\t        write_json(p, {\"k\": \"v\"})\n132\t        assert p.exists()\n133\t        assert json.loads(p.read_text(encoding=\"utf-8\")) == {\"k\": \"v\"}\n134\t\n135\t    def test_roundtrip(self, tmp_path):\n136\t        p = tmp_path / \"rt.json\"\n137\t        data = {\"hello\": \"世界\", \"num\": 42}\n138\t        write_json(p, data)\n139\t        assert read_json(p) == data\n140\t\n141\t\n142\t# ─── Helper: get_recent_lines ───\n143\t\n144\tclass TestGetRecentLines:\n145\t    def test_nonexistent_file(self, tmp_path):\n146\t        assert get_recent_lines(tmp_path / \"nope.log\") == []\n147\t\n148\t    def test_reads_last_n(self, tmp_path):\n149\t        p = tmp_path / \"test.log\"\n150\t        p.write_text(\"\\n\".join(f\"line {i}\" for i in range(10)), encoding=\"utf-8\")\n151\t        lines = get_recent_lines(p, 3)\n152\t        assert len(lines) == 3\n153\t        assert lines[0] == \"line 7\"\n154\t\n155\t    def test_all_lines_if_fewer_than_n(self, tmp_path):\n156\t        p = tmp_path / \"short.log\"\n157\t        p.write_text(\"a\\nb\", encoding=\"utf-8\")\n158\t        lines = get_recent_lines(p, 100)\n159\t        assert len(lines) == 2\n160\t\n161\t\n162\t# ─── Helper: scan_agents ───\n163\t\n164\tclass TestScanAgents:\n165\t    def test_returns_list(self):\n166\t        agents = scan_agents()\n167\t        assert isinstance(agents, list)\n168\t\n169\t    def test_main_agent_present(self):\n170\t        agents = scan_agents()\n171\t        names = [a[\"id\"] for a in agents]\n172\t        assert \"main\" in names\n173\t\n174\t    def test_agent_has_required_fields(self):\n175\t        agents = scan_agents()\n176\t        for a in agents:\n177\t            assert \"id\" in a\n178\t            assert \"name\" in a\n179\t            assert \"status\" in a\n180\t\n181\t\n182\t# ─── API: GET /api/agents ───\n183\t\n184\tclass TestGetAgents:\n185\t    def test_returns_200(self, client):\n186\t        r = client.get(\"/api/agents\")\n187\t        assert r.status_code == 200\n188\t\n189\t    def test_returns_json_list(self, client):\n190\t        r = client.get(\"/api/agents\")\n191\t        data = r.json()\n192\t        assert isinstance(data, list)\n193\t\n194\t    def test_includes_main(self, client):\n195\t        r = client.get(\"/api/agents\")\n196\t        names = [a[\"id\"] for a in r.json()]\n197\t        assert \"main\" in names\n198\t\n199\t\n200\t# ─── API: GET /api/tasks ───\n201\t\n202\tclass TestGetTasks:\n203\t    def test_returns_200(self, client):\n204\t        r = client.get(\"/api/tasks\")\n205\t        assert r.status_code == 200\n206\t\n207\t    def test_returns_json_list(self, client):\n208\t        r = client.get(\"/api/tasks\")\n209\t        assert isinstance(r.json(), list)\n210\t\n211\t\n212\t# ─── API: POST /api/tasks ───\n213\t\n214\tclass TestCreateTask:\n215\t    def test_create_task_success(self, client):\n216\t        tasks_before = client.get(\"/api/tasks\").json()\n217\t        try:\n218\t            r = client.post(\"/api/tasks\", json={\n219\t                \"title\": f\"[TEST] unit test task {time.time()}\",\n220\t                \"description\": \"created by automated test\",\n221\t                \"assignee\": \"main\",\n222\t            })\n223\t            assert r.status_code == 201\n224\t            data = r.json()\n225\t            assert data[\"status\"] == \"pending\"\n226\t            assert data[\"title\"].startswith(\"[TEST]\")\n227\t        finally:\n228\t            write_json(MAIN_DIR / \"memory\" / \"tasks.json\", tasks_before)\n229\t\n230\t    def test_create_task_missing_title(self, client):\n231\t        r = client.post(\"/api/tasks\", json={\"description\": \"no title\"})\n232\t        assert r.status_code == 400\n233\t        assert \"error\" in r.json()\n234\t\n235\t    def test_create_task_empty_body(self, client):\n236\t        r = client.post(\"/api/tasks\", json={})\n237\t        assert r.status_code == 400\n238\t\n239\t\n240\t# ─── API: POST /api/messages/send ───\n241\t\n242\tclass TestMessageSend:\n243\t    def test_send_to_main(self, client):\n244\t        r = client.post(\"/api/messages/send\", json={\n245\t            \"content\": f\"test message {time.time()}\",\n246\t            \"agent\": \"main\",\n247\t        })\n248\t        assert r.status_code == 201\n249\t        data = r.json()\n250\t        assert data[\"status\"] == \"sent\"\n251\t        assert data[\"agent\"] == \"main\"\n252\t\n253\t        # Cleanup the test message\n254\t        if data.get(\"file\"):\n255\t            msg_path = LOOPCLI_ROOT / \"main\" / \"inbox\" / data[\"file\"]\n256\t            if msg_path.exists():\n257\t                msg_path.unlink()\n258\t\n259\t    def test_send_default_agent_is_main(self, client):\n260\t        r = client.post(\"/api/messages/send\", json={\n261\t            \"content\": f\"default agent test {time.time()}\",\n262\t        })\n263\t        assert r.status_code == 201\n264\t        assert r.json()[\"agent\"] == \"main\"\n265\t\n266\t        # Cleanup\n267\t        data = r.json()\n268\t        if data.get(\"file\"):\n269\t            msg_path = LOOPCLI_ROOT / \"main\" / \"inbox\" / data[\"file\"]\n270\t            if msg_path.exists():\n271\t                msg_path.unlink()\n272\t\n273\t    def test_send_empty_content(self, client):\n274\t        r = client.post(\"/api/messages/send\", json={\"content\": \"\"})\n275\t        assert r.status_code == 400\n276\t\n277\t    def test_send_to_invalid_agent(self, client):\n278\t        r = client.post(\"/api/messages/send\", json={\n279\t            \"content\": \"hello\",\n280\t            \"agent\": \"../etc\",\n281\t        })\n282\t        assert r.status_code == 400\n283\t\n284\t    def test_send_to_nonexistent_agent(self, client):\n285\t        r = client.post(\"/api/messages/send\", json={\n286\t            \"content\": \"hello\",\n287\t            \"agent\": \"nonexistent_agent_xyz\",\n288\t        })\n289\t        assert r.status_code == 404\n290\t\n291\t\n292\t# ─── API: Path traversal rejection ───\n293\t\n294\tclass TestPathTraversal:\n295\t    def test_agents_endpoint_rejects_traversal(self, client):\n296\t        # /api/logs?agent=../etc should be rejected\n297\t        r = client.get(\"/api/logs\", params={\"agent\": \"../etc\"})\n298\t        assert r.status_code == 400\n299\t\n300\t    def test_agents_endpoint_rejects_dotdot(self, client):\n301\t        r = client.get(\"/api/logs\", params={\"agent\": \"..\"})\n302\t        assert r.status_code == 400\n303\t\n304\t    def test_messages_send_rejects_traversal(self, client):\n305\t        r = client.post(\"/api/messages/send\", json={\n306\t            \"content\": \"test\",\n307\t            \"agent\": \"../etc\",\n308\t        })\n309\t        assert r.status_code == 400\n310\t\n311\t\n312\t# ─── API: GET /api/logs ───\n313\t\n314\tclass TestGetLogs:\n315\t    def test_returns_200(self, client):\n316\t        r = client.get(\"/api/logs\")\n317\t        assert r.status_code == 200\n318\t        data = r.json()\n319\t        assert \"lines\" in data\n320\t\n321\t    def test_with_valid_agent(self, client):\n322\t        r = client.get(\"/api/logs\", params={\"agent\": \"main\"})\n323\t        assert r.status_code == 200\n324\t\n325\t    def test_with_invalid_agent(self, client):\n326\t        r = client.get(\"/api/logs\", params={\"agent\": \"../etc\"})\n327\t        assert r.status_code == 400\n328\t\n329\t\n330\t# ─── API: OPTIONS (CORS) ───\n331\t\n332\tclass TestCORS:\n333\t    def test_options_returns_204(self, client):\n334\t        r = client.options(\"/api/agents\")\n335\t        assert r.status_code == 204\n336\t\n337\t    def test_cors_allows_configured_origin(self, client):\n338\t        r = client.options(\"/api/agents\", headers={\"Origin\": \"http://localhost:3000\"})\n339\t        assert r.status_code == 204\n340\t        assert r.headers.get(\"access-control-allow-origin\") == \"http://localhost:3000\"\n341\t\n342\t    def test_cors_rejects_unknown_origin(self, client):\n343\t        r = client.options(\"/api/agents\", headers={\"Origin\": \"http://evil.com\"})\n344\t        assert r.status_code == 204\n345\t        assert r.headers.get(\"access-control-allow-origin\") is None\n346\t\n347\t\n348\t# ─── API: 404 for unknown POST ───\n349\t\n350\tclass TestNotFound:\n351\t    def test_unknown_post_returns_404(self, client):\n352\t        r = client.post(\"/api/nonexistent\")\n353\t        assert r.status_code == 404\n354\t\n355\t\n356\t# ─── API Key authentication ───\n357\t\n358\tclass TestApiKeyAuth:\n359\t    @patch(\"server.API_KEY\", \"test-secret-key-12345\")\n360\t    def test_create_task_rejects_without_key(self, client):\n361\t        r = client.post(\"/api/tasks\", json={\n362\t            \"title\": \"[TEST] should be rejected\",\n363\t            \"description\": \"no api key\",\n364\t        })\n365\t        assert r.status_code == 401\n366\t        assert \"error\" in r.json()\n367\t\n368\t    @patch(\"server.API_KEY\", \"test-secret-key-12345\")\n369\t    def test_create_task_rejects_wrong_key(self, client):\n370\t        r = client.post(\"/api/tasks\", json={\n371\t            \"title\": \"[TEST] wrong key\",\n372\t            \"description\": \"bad api key\",\n373\t        }, headers={\"X-API-Key\": \"wrong-key\"})\n374\t        assert r.status_code == 401\n375\t\n376\t    @patch(\"server.API_KEY\", \"test-secret-key-12345\")\n377\t    def test_create_task_accepts_valid_key(self, client):\n378\t        tasks_before = client.get(\"/api/tasks\").json()\n379\t        try:\n380\t            r = client.post(\"/api/tasks\", json={\n381\t                \"title\": \"[TEST] auth validated task\",\n382\t                \"description\": \"with correct api key\",\n383\t            }, headers={\"X-API-Key\": \"test-secret-key-12345\"})\n384\t            assert r.status_code == 201\n385\t            assert r.json()[\"status\"] == \"pending\"\n386\t        finally:\n387\t            write_json(MAIN_DIR / \"memory\" / \"tasks.json\", tasks_before)\n388\t\n389\t    @patch(\"server.API_KEY\", \"test-secret-key-12345\")\n390\t    def test_message_send_rejects_without_key(self, client):\n391\t        r = client.post(\"/api/messages/send\", json={\n392\t            \"content\": \"should be rejected\",\n393\t        })\n394\t        assert r.status_code == 401\n395\t\n396\t    @patch(\"server.API_KEY\", \"test-secret-key-12345\")\n397\t    def test_message_send_accepts_valid_key(self, client):\n398\t        r = client.post(\"/api/messages/send\", json={\n399\t            \"content\": \"auth test message\",\n400\t        }, headers={\"X-API-Key\": \"test-secret-key-12345\"})\n401\t        assert r.status_code == 201\n402\t        data = r.json()\n403\t        assert data[\"status\"] == \"sent\"\n404\t        if data.get(\"file\"):\n405\t            msg_path = LOOPCLI_ROOT / \"main\" / \"inbox\" / data[\"file\"]\n406\t            if msg_path.exists():\n407\t                msg_path.unlink()\n408\t\n409\t    @patch(\"server.API_KEY\", \"test-secret-key-12345\")\n410\t    def test_message_send_key_in_query_params(self, client):\n411\t        r = client.post(\"/api/messages/send?key=test-secret-key-12345\", json={\n412\t            \"content\": \"query param key test\",\n413\t        })\n414\t        assert r.status_code == 201\n415\t        data = r.json()\n416\t        if data.get(\"file\"):\n417\t            msg_path = LOOPCLI_ROOT / \"main\" / \"inbox\" / data[\"file\"]\n418\t            if msg_path.exists():\n419\t                msg_path.unlink()\n420\t\n421\t\n422\t# ─── Atomic write_json ───\n423\t\n424\tclass TestAtomicWriteJson:\n425\t    def test_atomic_write_produces_valid_json(self, tmp_path):\n426\t        p = tmp_path / \"atomic.json\"\n427\t        data = {\"key\": \"value\", \"num\": 42, \"nested\": {\"a\": [1, 2, 3]}}\n428\t        write_json(p, data)\n429\t        assert p.exists()\n430\t        assert json.loads(p.read_text(encoding=\"utf-8\")) == data\n431\t\n432\t    def test_atomic_write_creates_parent_dirs(self, tmp_path):\n433\t        p = tmp_path / \"deep\" / \"nested\" / \"dir\" / \"out.json\"\n434\t        write_json(p, {\"x\": 1})\n435\t        assert p.exists()\n436\t        assert json.loads(p.read_text(encoding=\"utf-8\")) == {\"x\": 1}\n437\t\n438\t    def test_atomic_write_overwrites_existing(self, tmp_path):\n439\t        p = tmp_path / \"overwrite.json\"\n440\t        write_json(p, {\"v\": 1})\n441\t        write_json(p, {\"v\": 2})\n442\t        assert json.loads(p.read_text(encoding=\"utf-8\")) == {\"v\": 2}\n443\t\n444\t    def test_atomic_write_no_leftover_tmp_files(self, tmp_path):\n445\t        p = tmp_path / \"clean.json\"\n446\t        write_json(p, {\"clean\": True})\n447\t        tmp_files = list(tmp_path.glob(\".loopcli_*.tmp\"))\n448\t        assert len(tmp_files) == 0, f\"Leftover temp files: {tmp_files}\"\n449\t\n450\t    def test_atomic_write_preserves_unicode(self, tmp_path):\n451\t        p = tmp_path / \"unicode.json\"\n452\t        data = {\"hello\": \"世界\", \"emoji\": \"💻\"}\n453\t        write_json(p, data)\n454\t        assert json.loads(p.read_text(encoding=\"utf-8\")) == data\n455\t\n456\t    def test_atomic_write_concurrent_safety(self, tmp_path):\n457\t        \"\"\"Multiple threads writing to the same file should not corrupt it.\"\"\"\n458\t        import threading\n459\t        p = tmp_path / \"concurrent.json\"\n460\t        write_json(p, {\"counter\": 0})\n461\t        N = 10\n462\t        barrier = threading.Barrier(N)\n463\t        errors = []\n464\t\n465\t        def worker(i):\n466\t            barrier.wait()\n467\t            try:\n468\t                write_json(p, {\"worker\": i, \"counter\": i})\n469\t            except Exception as e:\n470\t                errors.append(e)\n471\t\n472\t        threads = [threading.Thread(target=worker, args=(i,)) for i in range(N)]\n473\t        for t in threads:\n474\t            t.start()\n475\t        for t in threads:\n476\t            t.join()\n477\t\n478\t        assert not errors, f\"Errors during concurrent writes: {errors}\"\n479\t        result = json.loads(p.read_text(encoding=\"utf-8\"))\n480\t        assert \"counter\" in result\n481\t        assert result[\"counter\"] < N\n482\t\n483\t    def test_roundtrip_atomic(self, tmp_path):\n484\t        p = tmp_path / \"roundtrip.json\"\n485\t        data = {\"list\": [1, 2, 3], \"bool\": True, \"null\": None}\n486\t        write_json(p, data)\n487\t        assert read_json(p) == data\n488\t\n489\t\n490\t# ─── SSE Heartbeat ───\n491\t\n492\tclass TestSSEHeartbeat:\n493\t    def test_heartbeat_interval_is_configured(self):\n494\t        from server import SSE_HEARTBEAT_INTERVAL\n495\t        assert SSE_HEARTBEAT_INTERVAL == 30\n496\t\n497\t    def test_sse_stream_contains_heartbeat(self, client):\n498\t        \"\"\"Connect to SSE stream briefly and verify heartbeat comment frames.\"\"\"\n499\t        import httpx\n500\t        # Use a raw stream to capture the SSE data\n501\t        try:\n502\t            with client.stream(\"GET\", \"/api/logs/stream\", timeout=8) as r:\n503\t                assert r.status_code == 200\n504\t                assert \"text/event-stream\" in r.headers.get(\"content-type\", \"\")\n505\t                # Collect data for a few seconds\n506\t                data_chunks = []\n507\t                deadline = time.time() + 5\n508\t                for line in r.iter_lines():\n509\t                    data_chunks.append(line)\n510\t                    if time.time() > deadline:\n511\t                        break\n512\t                # After ~30s we'd see a heartbeat, but with 5s we just verify\n513\t                # the stream is alive and producing valid SSE frames\n514\t                assert len(data_chunks) >= 0  # Stream connected successfully\n515\t        except httpx.ReadTimeout:\n516\t            pass  # Expected — the stream is long-lived\n517\t"}]},"parent_tool_use_id":null,"session_id":"a11b390c-8618-467f-b876-d1d624ad9195","uuid":"d5849f22-8699-47ea-881d-4f3f44f879f4","timestamp":"2026-05-21T05:05:41.069Z","tool_use_result":{"type":"text","file":{"filePath":"D:/loopcli/main/tests/test_server.py","content":"\"\"\"\nTests for webui/server.py — API endpoints and helper functions.\nUses a real threaded HTTP server with httpx client.\n\"\"\"\n\nimport json\nimport os\nimport sys\nimport time\nimport threading\nimport pytest\nimport httpx\nfrom unittest.mock import patch\n\n# Add webui directory to path so we can import server\nsys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"webui\"))\n\nfrom server import (\n    WebUIHandler,\n    ThreadedHTTPServer,\n    MAIN_DIR,\n)\nfrom loopcli_lib import (\n    safe_agent_path as _safe_agent_path,\n    read_json,\n    write_json,\n    scan_agents,\n    get_recent_lines,\n    LOOPCLI_ROOT,\n)\nfrom pathlib import Path\n\n\n# ─── Fixtures ───\n\nBASE_PORT = 18765\n_port_lock = threading.Lock()\n_port_counter = [0]\n\n\ndef _get_port():\n    with _port_lock:\n        _port_counter[0] += 1\n        return BASE_PORT + _port_counter[0]\n\n\n@pytest.fixture(scope=\"module\")\ndef http_server():\n    \"\"\"Start a real HTTP server in a thread for the entire module.\"\"\"\n    port = _get_port()\n    server = ThreadedHTTPServer((\"127.0.0.1\", port), WebUIHandler)\n    t = threading.Thread(target=server.serve_forever, daemon=True)\n    t.start()\n    time.sleep(0.2)\n    yield f\"http://127.0.0.1:{port}\"\n    server.shutdown()\n\n\n@pytest.fixture\ndef client(http_server):\n    return httpx.Client(base_url=http_server, timeout=5)\n\n\n# ─── Helper: _safe_agent_path ───\n\nclass TestSafeAgentPath:\n    def test_valid_agent(self):\n        result = _safe_agent_path(\"main\")\n        assert result is not None\n        assert str(result) == str(LOOPCLI_ROOT / \"main\")\n\n    def test_empty_string(self):\n        assert _safe_agent_path(\"\") is None\n\n    def test_slash_traversal(self):\n        assert _safe_agent_path(\"main/../../../etc\") is None\n\n    def test_backslash_traversal(self):\n        assert _safe_agent_path(\"main\\\\..\\\\..\\\\etc\") is None\n\n    def test_double_dot(self):\n        assert _safe_agent_path(\"..\") is None\n\n    def test_path_with_slash(self):\n        assert _safe_agent_path(\"foo/bar\") is None\n\n    def test_path_with_backslash(self):\n        assert _safe_agent_path(\"foo\\\\bar\") is None\n\n    def test_valid_subdir_name(self):\n        result = _safe_agent_path(\"engineering-frontend-developer\")\n        assert result is not None\n        assert result.name == \"engineering-frontend-developer\"\n\n    def test_null_byte_injection(self):\n        assert _safe_agent_path(\"main\\x00\") is None\n\n    def test_null_byte_in_middle(self):\n        assert _safe_agent_path(\"main\\x00evil\") is None\n\n    def test_null_byte_at_start(self):\n        assert _safe_agent_path(\"\\x00main\") is None\n\n    def test_null_byte_with_suffix(self):\n        assert _safe_agent_path(\"main\\x00.sh\") is None\n\n\n# ─── Helper: read_json / write_json ───\n\nclass TestJsonIO:\n    def test_read_nonexistent_returns_default(self, tmp_path):\n        result = read_json(tmp_path / \"nope.json\", {\"x\": 1})\n        assert result == {\"x\": 1}\n\n    def test_read_nonexistent_no_default(self, tmp_path):\n        result = read_json(tmp_path / \"nope.json\")\n        assert result == {}\n\n    def test_read_valid_json(self, tmp_path):\n        p = tmp_path / \"test.json\"\n        p.write_text('{\"a\": 1}', encoding=\"utf-8\")\n        assert read_json(p) == {\"a\": 1}\n\n    def test_read_corrupt_json(self, tmp_path):\n        p = tmp_path / \"bad.json\"\n        p.write_text(\"{invalid\", encoding=\"utf-8\")\n        assert read_json(p, \"fallback\") == \"fallback\"\n\n    def test_write_json_creates_dirs(self, tmp_path):\n        p = tmp_path / \"sub\" / \"dir\" / \"out.json\"\n        write_json(p, {\"k\": \"v\"})\n        assert p.exists()\n        assert json.loads(p.read_text(encoding=\"utf-8\")) == {\"k\": \"v\"}\n\n    def test_roundtrip(self, tmp_path):\n        p = tmp_path / \"rt.json\"\n        data = {\"hello\": \"世界\", \"num\": 42}\n        write_json(p, data)\n        assert read_json(p) == data\n\n\n# ─── Helper: get_recent_lines ───\n\nclass TestGetRecentLines:\n    def test_nonexistent_file(self, tmp_path):\n        assert get_recent_lines(tmp_path / \"nope.log\") == []\n\n    def test_reads_last_n(self, tmp_path):\n        p = tmp_path / \"test.log\"\n        p.write_text(\"\\n\".join(f\"line {i}\" for i in range(10)), encoding=\"utf-8\")\n        lines = get_recent_lines(p, 3)\n        assert len(lines) == 3\n        assert lines[0] == \"line 7\"\n\n    def test_all_lines_if_fewer_than_n(self, tmp_path):\n        p = tmp_path / \"short.log\"\n        p.write_text(\"a\\nb\", encoding=\"utf-8\")\n        lines = get_recent_lines(p, 100)\n        assert len(lines) == 2\n\n\n# ─── Helper: scan_agents ───\n\nclass TestScanAgents:\n    def test_returns_list(self):\n        agents = scan_agents()\n        assert isinstance(agents, list)\n\n    def test_main_agent_present(self):\n        agents = scan_agents()\n        names = [a[\"id\"] for a in agents]\n        assert \"main\" in names\n\n    def test_agent_has_required_fields(self):\n        agents = scan_agents()\n        for a in agents:\n            assert \"id\" in a\n            assert \"name\" in a\n            assert \"status\" in a\n\n\n# ─── API: GET /api/agents ───\n\nclass TestGetAgents:\n    def test_returns_200(self, client):\n        r = client.get(\"/api/agents\")\n        assert r.status_code == 200\n\n    def test_returns_json_list(self, client):\n        r = client.get(\"/api/agents\")\n        data = r.json()\n        assert isinstance(data, list)\n\n    def test_includes_main(self, client):\n        r = client.get(\"/api/agents\")\n        names = [a[\"id\"] for a in r.json()]\n        assert \"main\" in names\n\n\n# ─── API: GET /api/tasks ───\n\nclass TestGetTasks:\n    def test_returns_200(self, client):\n        r = client.get(\"/api/tasks\")\n        assert r.status_code == 200\n\n    def test_returns_json_list(self, client):\n        r = client.get(\"/api/tasks\")\n        assert isinstance(r.json(), list)\n\n\n# ─── API: POST /api/tasks ───\n\nclass TestCreateTask:\n    def test_create_task_success(self, client):\n        tasks_before = client.get(\"/api/tasks\").json()\n        try:\n            r = client.post(\"/api/tasks\", json={\n                \"title\": f\"[TEST] unit test task {time.time()}\",\n                \"description\": \"created by automated test\",\n                \"assignee\": \"main\",\n            })\n            assert r.status_code == 201\n            data = r.json()\n            assert data[\"status\"] == \"pending\"\n            assert data[\"title\"].startswith(\"[TEST]\")\n        finally:\n            write_json(MAIN_DIR / \"memory\" / \"tasks.json\", tasks_before)\n\n    def test_create_task_missing_title(self, client):\n        r = client.post(\"/api/tasks\", json={\"description\": \"no title\"})\n        assert r.status_code == 400\n        assert \"error\" in r.json()\n\n    def test_create_task_empty_body(self, client):\n        r = client.post(\"/api/tasks\", json={})\n        assert r.status_code == 400\n\n\n# ─── API: POST /api/messages/send ───\n\nclass TestMessageSend:\n    def test_send_to_main(self, client):\n        r = client.post(\"/api/messages/send\", json={\n            \"content\": f\"test message {time.time()}\",\n            \"agent\": \"main\",\n        })\n        assert r.status_code == 201\n        data = r.json()\n        assert data[\"status\"] == \"sent\"\n        assert data[\"agent\"] == \"main\"\n\n        # Cleanup the test message\n        if data.get(\"file\"):\n            msg_path = LOOPCLI_ROOT / \"main\" / \"inbox\" / data[\"file\"]\n            if msg_path.exists():\n                msg_path.unlink()\n\n    def test_send_default_agent_is_main(self, client):\n        r = client.post(\"/api/messages/send\", json={\n            \"content\": f\"default agent test {time.time()}\",\n        })\n        assert r.status_code == 201\n        assert r.json()[\"agent\"] == \"main\"\n\n        # Cleanup\n        data = r.json()\n        if data.get(\"file\"):\n            msg_path = LOOPCLI_ROOT / \"main\" / \"inbox\" / data[\"file\"]\n            if msg_path.exists():\n                msg_path.unlink()\n\n    def test_send_empty_content(self, client):\n        r = client.post(\"/api/messages/send\", json={\"content\": \"\"})\n        assert r.status_code == 400\n\n    def test_send_to_invalid_agent(self, client):\n        r = client.post(\"/api/messages/send\", json={\n            \"content\": \"hello\",\n            \"agent\": \"../etc\",\n        })\n        assert r.status_code == 400\n\n    def test_send_to_nonexistent_agent(self, client):\n        r = client.post(\"/api/messages/send\", json={\n            \"content\": \"hello\",\n            \"agent\": \"nonexistent_agent_xyz\",\n        })\n        assert r.status_code == 404\n\n\n# ─── API: Path traversal rejection ───\n\nclass TestPathTraversal:\n    def test_agents_endpoint_rejects_traversal(self, client):\n        # /api/logs?agent=../etc should be rejected\n        r = client.get(\"/api/logs\", params={\"agent\": \"../etc\"})\n        assert r.status_code == 400\n\n    def test_agents_endpoint_rejects_dotdot(self, client):\n        r = client.get(\"/api/logs\", params={\"agent\": \"..\"})\n        assert r.status_code == 400\n\n    def test_messages_send_rejects_traversal(self, client):\n        r = client.post(\"/api/messages/send\", json={\n            \"content\": \"test\",\n            \"agent\": \"../etc\",\n        })\n        assert r.status_code == 400\n\n\n# ─── API: GET /api/logs ───\n\nclass TestGetLogs:\n    def test_returns_200(self, client):\n        r = client.get(\"/api/logs\")\n        assert r.status_code == 200\n        data = r.json()\n        assert \"lines\" in data\n\n    def test_with_valid_agent(self, client):\n        r = client.get(\"/api/logs\", params={\"agent\": \"main\"})\n        assert r.status_code == 200\n\n    def test_with_invalid_agent(self, client):\n        r = client.get(\"/api/logs\", params={\"agent\": \"../etc\"})\n        assert r.status_code == 400\n\n\n# ─── API: OPTIONS (CORS) ───\n\nclass TestCORS:\n    def test_options_returns_204(self, client):\n        r = client.options(\"/api/agents\")\n        assert r.status_code == 204\n\n    def test_cors_allows_configured_origin(self, client):\n        r = client.options(\"/api/agents\", headers={\"Origin\": \"http://localhost:3000\"})\n        assert r.status_code == 204\n        assert r.headers.get(\"access-control-allow-origin\") == \"http://localhost:3000\"\n\n    def test_cors_rejects_unknown_origin(self, client):\n        r = client.options(\"/api/agents\", headers={\"Origin\": \"http://evil.com\"})\n        assert r.status_code == 204\n        assert r.headers.get(\"access-control-allow-origin\") is None\n\n\n# ─── API: 404 for unknown POST ───\n\nclass TestNotFound:\n    def test_unknown_post_returns_404(self, client):\n        r = client.post(\"/api/nonexistent\")\n        assert r.status_code == 404\n\n\n# ─── API Key authentication ───\n\nclass TestApiKeyAuth:\n    @patch(\"server.API_KEY\", \"test-secret-key-12345\")\n    def test_create_task_rejects_without_key(self, client):\n        r = client.post(\"/api/tasks\", json={\n            \"title\": \"[TEST] should be rejected\",\n            \"description\": \"no api key\",\n        })\n        assert r.status_code == 401\n        assert \"error\" in r.json()\n\n    @patch(\"server.API_KEY\", \"test-secret-key-12345\")\n    def test_create_task_rejects_wrong_key(self, client):\n        r = client.post(\"/api/tasks\", json={\n            \"title\": \"[TEST] wrong key\",\n            \"description\": \"bad api key\",\n        }, headers={\"X-API-Key\": \"wrong-key\"})\n        assert r.status_code == 401\n\n    @patch(\"server.API_KEY\", \"test-secret-key-12345\")\n    def test_create_task_accepts_valid_key(self, client):\n        tasks_before = client.get(\"/api/tasks\").json()\n        try:\n            r = client.post(\"/api/tasks\", json={\n                \"title\": \"[TEST] auth validated task\",\n                \"description\": \"with correct api key\",\n            }, headers={\"X-API-Key\": \"test-secret-key-12345\"})\n            assert r.status_code == 201\n            assert r.json()[\"status\"] == \"pending\"\n        finally:\n            write_json(MAIN_DIR / \"memory\" / \"tasks.json\", tasks_before)\n\n    @patch(\"server.API_KEY\", \"test-secret-key-12345\")\n    def test_message_send_rejects_without_key(self, client):\n        r = client.post(\"/api/messages/send\", json={\n            \"content\": \"should be rejected\",\n        })\n        assert r.status_code == 401\n\n    @patch(\"server.API_KEY\", \"test-secret-key-12345\")\n    def test_message_send_accepts_valid_key(self, client):\n        r = client.post(\"/api/messages/send\", json={\n            \"content\": \"auth test message\",\n        }, headers={\"X-API-Key\": \"test-secret-key-12345\"})\n        assert r.status_code == 201\n        data = r.json()\n        assert data[\"status\"] == \"sent\"\n        if data.get(\"file\"):\n            msg_path = LOOPCLI_ROOT / \"main\" / \"inbox\" / data[\"file\"]\n            if msg_path.exists():\n                msg_path.unlink()\n\n    @patch(\"server.API_KEY\", \"test-secret-key-12345\")\n    def test_message_send_key_in_query_params(self, client):\n        r = client.post(\"/api/messages/send?key=test-secret-key-12345\", json={\n            \"content\": \"query param key test\",\n        })\n        assert r.status_code == 201\n        data = r.json()\n        if data.get(\"file\"):\n            msg_path = LOOPCLI_ROOT / \"main\" / \"inbox\" / data[\"file\"]\n            if msg_path.exists():\n                msg_path.unlink()\n\n\n# ─── Atomic write_json ───\n\nclass TestAtomicWriteJson:\n    def test_atomic_write_produces_valid_json(self, tmp_path):\n        p = tmp_path / \"atomic.json\"\n        data = {\"key\": \"value\", \"num\": 42, \"nested\": {\"a\": [1, 2, 3]}}\n        write_json(p, data)\n        assert p.exists()\n        assert json.loads(p.read_text(encoding=\"utf-8\")) == data\n\n    def test_atomic_write_creates_parent_dirs(self, tmp_path):\n        p = tmp_path / \"deep\" / \"nested\" / \"dir\" / \"out.json\"\n        write_json(p, {\"x\": 1})\n        assert p.exists()\n        assert json.loads(p.read_text(encoding=\"utf-8\")) == {\"x\": 1}\n\n    def test_atomic_write_overwrites_existing(self, tmp_path):\n        p = tmp_path / \"overwrite.json\"\n        write_json(p, {\"v\": 1})\n        write_json(p, {\"v\": 2})\n        assert json.loads(p.read_text(encoding=\"utf-8\")) == {\"v\": 2}\n\n    def test_atomic_write_no_leftover_tmp_files(self, tmp_path):\n        p = tmp_path / \"clean.json\"\n        write_json(p, {\"clean\": True})\n        tmp_files = list(tmp_path.glob(\".loopcli_*.tmp\"))\n        assert len(tmp_files) == 0, f\"Leftover temp files: {tmp_files}\"\n\n    def test_atomic_write_preserves_unicode(self, tmp_path):\n        p = tmp_path / \"unicode.json\"\n        data = {\"hello\": \"世界\", \"emoji\": \"💻\"}\n        write_json(p, data)\n        assert json.loads(p.read_text(encoding=\"utf-8\")) == data\n\n    def test_atomic_write_concurrent_safety(self, tmp_path):\n        \"\"\"Multiple threads writing to the same file should not corrupt it.\"\"\"\n        import threading\n        p = tmp_path / \"concurrent.json\"\n        write_json(p, {\"counter\": 0})\n        N = 10\n        barrier = threading.Barrier(N)\n        errors = []\n\n        def worker(i):\n            barrier.wait()\n            try:\n                write_json(p, {\"worker\": i, \"counter\": i})\n            except Exception as e:\n                errors.append(e)\n\n        threads = [threading.Thread(target=worker, args=(i,)) for i in range(N)]\n        for t in threads:\n            t.start()\n        for t in threads:\n            t.join()\n\n        assert not errors, f\"Errors during concurrent writes: {errors}\"\n        result = json.loads(p.read_text(encoding=\"utf-8\"))\n        assert \"counter\" in result\n        assert result[\"counter\"] < N\n\n    def test_roundtrip_atomic(self, tmp_path):\n        p = tmp_path / \"roundtrip.json\"\n        data = {\"list\": [1, 2, 3], \"bool\": True, \"null\": None}\n        write_json(p, data)\n        assert read_json(p) == data\n\n\n# ─── SSE Heartbeat ───\n\nclass TestSSEHeartbeat:\n    def test_heartbeat_interval_is_configured(self):\n        from server import SSE_HEARTBEAT_INTERVAL\n        assert SSE_HEARTBEAT_INTERVAL == 30\n\n    def test_sse_stream_contains_heartbeat(self, client):\n        \"\"\"Connect to SSE stream briefly and verify heartbeat comment frames.\"\"\"\n        import httpx\n        # Use a raw stream to capture the SSE data\n        try:\n            with client.stream(\"GET\", \"/api/logs/stream\", timeout=8) as r:\n                assert r.status_code == 200\n                assert \"text/event-stream\" in r.headers.get(\"content-type\", \"\")\n                # Collect data for a few seconds\n                data_chunks = []\n                deadline = time.time() + 5\n                for line in r.iter_lines():\n                    data_chunks.append(line)\n                    if time.time() > deadline:\n                        break\n                # After ~30s we'd see a heartbeat, but with 5s we just verify\n                # the stream is alive and producing valid SSE frames\n                assert len(data_chunks) >= 0  # Stream connected successfully\n        except httpx.ReadTimeout:\n            pass  # Expected — the stream is long-lived\n","numLines":517,"startLine":1,"totalLines":517}}}
