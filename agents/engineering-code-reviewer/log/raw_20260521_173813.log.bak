{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a6791ac4de72403e98ec4d23","type":"tool_result","content":"1\t\"\"\"\n2\tLoopCLI WebUI Backend Server\n3\tREST API + static file hosting for the Agent control console.\n4\t\"\"\"\n5\t\n6\timport hmac\n7\timport json\n8\timport os\n9\timport signal\n10\timport subprocess\n11\timport sys\n12\timport time\n13\timport threading\n14\timport uuid\n15\tfrom datetime import datetime, timezone\n16\tfrom http.server import HTTPServer, SimpleHTTPRequestHandler\n17\tfrom socketserver import ThreadingMixIn\n18\tfrom pathlib import Path\n19\tfrom urllib.parse import urlparse, parse_qs\n20\t\n21\tfrom loopcli_lib import (\n22\t    LOOPCLI_ROOT,\n23\t    read_json,\n24\t    write_json,\n25\t    safe_agent_path,\n26\t    scan_agents,\n27\t    create_task,\n28\t    get_agent_tasks,\n29\t    get_all_agent_tasks,\n30\t    write_inbox_message,\n31\t    set_agent_enabled,\n32\t    get_recent_lines,\n33\t    read_file_tail_incremental,\n34\t)\n35\t\n36\tWEBUI_DIR = Path(__file__).parent.resolve()\n37\tMAIN_DIR = LOOPCLI_ROOT / \"main\"\n38\tLOOP_STATE_FILE = WEBUI_DIR / \"loop_state.json\"\n39\t\n40\t_loop_proc = None\n41\t_loop_lock = threading.Lock()\n42\tAPI_KEY = os.environ.get(\"LOOPCLI_API_KEY\", \"\")\n43\tMAX_BODY_SIZE = 10 * 1024  # 10KB\n44\t\n45\t_raw_cors = os.environ.get(\"CORS_ORIGINS\", \"\").strip()\n46\tif _raw_cors:\n47\t    CORS_ORIGINS = [o.strip() for o in _raw_cors.split(\",\") if o.strip()]\n48\telse:\n49\t    CORS_ORIGINS = [\"http://localhost:3000\"]\n50\t\n51\t_write_semaphore = threading.Semaphore(10)\n52\t\n53\t_sse_connections = 0\n54\t_sse_lock = threading.Lock()\n55\tSSE_MAX_CONNECTIONS = 10\n56\tSSE_TIMEOUT_SECONDS = 300\n57\tSSE_HEARTBEAT_INTERVAL = 30\n58\t\n59\t\n60\tdef get_main_tasks():\n61\t    return read_json(MAIN_DIR / \"memory\" / \"tasks.json\", [])\n62\t\n63\t\n64\t# --- Loop Process Management ---\n65\t\n66\tdef get_loop_state():\n67\t    return read_json(LOOP_STATE_FILE, {\n68\t        \"status\": \"stopped\", \"pid\": None,\n69\t        \"started_at\": None, \"iterations\": 0, \"total_iterations\": 0,\n70\t    })\n71\t\n72\t\n73\tdef set_loop_state(state):\n74\t    write_json(LOOP_STATE_FILE, state)\n75\t\n76\t\n77\tdef _is_pid_alive(pid):\n78\t    if not pid:\n79\t        return False\n80\t    try:\n81\t        os.kill(pid, 0)\n82\t        return True\n83\t    except (ProcessLookupError, PermissionError, OSError):\n84\t        return False\n85\t\n86\t\n87\tdef _monitor_loopcli(proc):\n88\t    proc.wait()\n89\t    with _loop_lock:\n90\t        state = get_loop_state()\n91\t        if state.get(\"pid\") == proc.pid:\n92\t            state[\"status\"] = \"stopped\"\n93\t            state[\"pid\"] = None\n94\t            state[\"ended_at\"] = datetime.now().isoformat()\n95\t            set_loop_state(state)\n96\t\n97\t\n98\tdef start_loopcli_process(iterations=0):\n99\t    global _loop_proc\n100\t    with _loop_lock:\n101\t        state = get_loop_state()\n102\t        if state.get(\"status\") == \"running\" and _is_pid_alive(state.get(\"pid\")):\n103\t            return {\"error\": \"Already running\"}, 409\n104\t\n105\t        cmd = [sys.executable, str(LOOPCLI_ROOT / \"run.py\"), \"run\"]\n106\t        if iterations > 0:\n107\t            cmd.extend([\"-n\", str(iterations)])\n108\t\n109\t        proc = subprocess.Popen(\n110\t            cmd,\n111\t            stdout=subprocess.DEVNULL,\n112\t            stderr=subprocess.DEVNULL,\n113\t            creationflags=getattr(subprocess, \"CREATE_NO_WINDOW\", 0),\n114\t        )\n115\t        _loop_proc = proc\n116\t\n117\t        state = {\n118\t            \"status\": \"running\",\n119\t            \"pid\": proc.pid,\n120\t            \"started_at\": datetime.now().isoformat(),\n121\t            \"iterations\": iterations,\n122\t            \"total_iterations\": 0,\n123\t        }\n124\t        set_loop_state(state)\n125\t\n126\t        t = threading.Thread(target=_monitor_loopcli, args=(proc,), daemon=True)\n127\t        t.start()\n128\t        return state, 200\n129\t\n130\t\n131\tdef stop_loopcli_process():\n132\t    global _loop_proc\n133\t    with _loop_lock:\n134\t        state = get_loop_state()\n135\t        pid = state.get(\"pid\")\n136\t        if not pid or not _is_pid_alive(pid):\n137\t            state[\"status\"] = \"stopped\"\n138\t            state[\"pid\"] = None\n139\t            set_loop_state(state)\n140\t            return {\"error\": \"Not running\"}, 409\n141\t\n142\t        try:\n143\t            os.kill(pid, signal.SIGTERM)\n144\t        except OSError:\n145\t            pass\n146\t        if _loop_proc and _loop_proc.pid == pid:\n147\t            try:\n148\t                _loop_proc.terminate()\n149\t            except OSError:\n150\t                pass\n151\t            _loop_proc = None\n152\t\n153\t        state[\"status\"] = \"stopped\"\n154\t        state[\"pid\"] = None\n155\t        state[\"ended_at\"] = datetime.now().isoformat()\n156\t        set_loop_state(state)\n157\t        return {\"status\": \"stopped\"}, 200\n158\t\n159\t\n160\tclass WebUIHandler(SimpleHTTPRequestHandler):\n161\t    def __init__(self, *args, **kwargs):\n162\t        super().__init__(*args, directory=str(WEBUI_DIR), **kwargs)\n163\t\n164\t    def log_message(self, format, *args):\n165\t        ts = datetime.now().strftime(\"%H:%M:%S\")\n166\t        sys.stdout.write(f\"[{ts}] {format % args}\\n\")\n167\t        sys.stdout.flush()\n168\t\n169\t    def _send_json(self, data, status=200):\n170\t        body = json.dumps(data, ensure_ascii=False, indent=2).encode(\"utf-8\")\n171\t        self.send_response(status)\n172\t        self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n173\t        self.send_header(\"Content-Length\", str(len(body)))\n174\t        self.end_headers()\n175\t        self.wfile.write(body)\n176\t\n177\t    def _read_body(self):\n178\t        length = int(self.headers.get(\"Content-Length\", 0))\n179\t        if length == 0:\n180\t            return {}\n181\t        if length > MAX_BODY_SIZE:\n182\t            self._send_json({\"error\": \"Request body too large\"}, status=413)\n183\t            return None\n184\t        raw = self.rfile.read(length)\n185\t        try:\n186\t            return json.loads(raw.decode(\"utf-8\"))\n187\t        except (json.JSONDecodeError, UnicodeDecodeError) as e:\n188\t            self._send_json({\"error\": f\"Invalid JSON: {e}\"}, status=400)\n189\t            return None\n190\t\n191\t    def _require_auth(self):\n192\t        if not API_KEY:\n193\t            return True\n194\t        key = self.headers.get(\"X-API-Key\", \"\") or parse_qs(urlparse(self.path).query).get(\"key\", [\"\"])[0]\n195\t        if not hmac.compare_digest(key, API_KEY):\n196\t            self._send_json({\"error\": \"Unauthorized\"}, status=401)\n197\t            return False\n198\t        return True\n199\t\n200\t    def _cors_headers(self):\n201\t        origin = self.headers.get(\"Origin\", \"\")\n202\t        if CORS_ORIGINS:\n203\t            if origin in CORS_ORIGINS:\n204\t                self.send_header(\"Access-Control-Allow-Origin\", origin)\n205\t                self.send_header(\"Vary\", \"Origin\")\n206\t        else:\n207\t            self.send_header(\"Access-Control-Allow-Origin\", \"*\")\n208\t        self.send_header(\"Access-Control-Allow-Methods\", \"GET, POST, OPTIONS\")\n209\t        self.send_header(\"Access-Control-Allow-Headers\", \"Content-Type\")\n210\t\n211\t    # ---------- SSE helpers ----------\n212\t\n213\t    def _send_sse_event(self, data):\n214\t        payload = f\"data: {json.dumps(data, ensure_ascii=False)}\\n\\n\"\n215\t        self.wfile.write(payload.encode(\"utf-8\"))\n216\t        self.wfile.flush()\n217\t\n218\t    def _handle_sse_logs(self):\n219\t        global _sse_connections\n220\t        with _sse_lock:\n221\t            if _sse_connections >= SSE_MAX_CONNECTIONS:\n222\t                return self._send_json({\"error\": \"Max SSE connections reached\"}, status=503)\n223\t            _sse_connections += 1\n224\t\n225\t        params = parse_qs(urlparse(self.path).query)\n226\t        agent_id = params.get(\"agent\", [None])[0]\n227\t        if agent_id:\n228\t            agent_dir = safe_agent_path(agent_id)\n229\t            if not agent_dir:\n230\t                with _sse_lock:\n231\t                    _sse_connections -= 1\n232\t                return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n233\t            log_path = agent_dir / \"log\" / \"run.md\"\n234\t        else:\n235\t            log_path = MAIN_DIR / \"log\" / \"run.md\"\n236\t\n237\t        self.send_response(200)\n238\t        self.send_header(\"Content-Type\", \"text/event-stream\")\n239\t        self.send_header(\"Cache-Control\", \"no-cache\")\n240\t        self.send_header(\"Connection\", \"keep-alive\")\n241\t        self.send_header(\"X-Accel-Buffering\", \"no\")\n242\t        self._cors_headers()\n243\t        self.end_headers()\n244\t\n245\t        last_pos = 0\n246\t        start_time = time.time()\n247\t        last_heartbeat = time.time()\n248\t        try:\n249\t            while True:\n250\t                now = time.time()\n251\t                if now - start_time > SSE_TIMEOUT_SECONDS:\n252\t                    self._send_sse_event({\"event\": \"timeout\", \"ts\": datetime.now().isoformat()})\n253\t                    break\n254\t                if now - last_heartbeat >= SSE_HEARTBEAT_INTERVAL:\n255\t                    self.wfile.write(b\": heartbeat\\n\\n\")\n256\t                    self.wfile.flush()\n257\t                    last_heartbeat = now\n258\t                if log_path.exists():\n259\t                    lines, last_pos = read_file_tail_incremental(log_path, last_pos)\n260\t                    if lines:\n261\t                        self._send_sse_event({\n262\t                            \"agent\": agent_id,\n263\t                            \"lines\": lines,\n264\t                            \"ts\": datetime.now().isoformat(),\n265\t                        })\n266\t                else:\n267\t                    if last_pos != -1:\n268\t                        self._send_sse_event({\"agent\": agent_id, \"lines\": [], \"ts\": datetime.now().isoformat()})\n269\t                        last_pos = -1\n270\t                time.sleep(1)\n271\t        except (BrokenPipeError, ConnectionResetError, OSError):\n272\t            pass\n273\t        finally:\n274\t            with _sse_lock:\n275\t                _sse_connections -= 1\n276\t\n277\t    # ---------- GET routes ----------\n278\t\n279\t    def do_GET(self):\n280\t        parsed = urlparse(self.path)\n281\t        path = parsed.path\n282\t\n283\t        if path == \"/api/agents\":\n284\t            return self._send_json(scan_agents())\n285\t\n286\t        if path == \"/api/tasks\":\n287\t            params = parse_qs(parsed.query)\n288\t            agent_id = params.get(\"agent\", [None])[0]\n289\t            if agent_id == \"__all__\":\n290\t                return self._send_json(get_all_agent_tasks())\n291\t            if agent_id:\n292\t                tasks = get_agent_tasks(agent_id)\n293\t                if tasks is None:\n294\t                    return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n295\t                return self._send_json(tasks)\n296\t            return self._send_json(get_main_tasks())\n297\t\n298\t        if path.startswith(\"/api/agents/\") and path.endswith(\"/tasks\"):\n299\t            agent_id = path[len(\"/api/agents/\"):-len(\"/tasks\")]\n300\t            tasks = get_agent_tasks(agent_id)\n301\t            if tasks is None:\n302\t                return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n303\t            return self._send_json(tasks)\n304\t\n305\t        if path == \"/api/logs\":\n306\t            params = parse_qs(parsed.query)\n307\t            n = int(params.get(\"n\", [\"100\"])[0])\n308\t            agent_id = params.get(\"agent\", [None])[0]\n309\t            if agent_id:\n310\t                agent_dir = safe_agent_path(agent_id)\n311\t                if not agent_dir:\n312\t                    return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n313\t                log_path = agent_dir / \"log\" / \"run.md\"\n314\t            else:\n315\t                log_path = MAIN_DIR / \"log\" / \"run.md\"\n316\t            lines = get_recent_lines(log_path, n)\n317\t            return self._send_json({\"agent\": agent_id, \"lines\": lines})\n318\t\n319\t        if path == \"/api/logs/stream\":\n320\t            return self._handle_sse_logs()\n321\t\n322\t        if path == \"/api/loopcli/status\":\n323\t            return self._handle_loopcli_status()\n324\t\n325\t        # Static files\n326\t        super().do_GET()\n327\t\n328\t    # ---------- POST routes ----------\n329\t\n330\t    def do_POST(self):\n331\t        if not _write_semaphore.acquire(timeout=5):\n332\t            return self._send_json({\"error\": \"Server busy, try again\"}, status=503)\n333\t        try:\n334\t            self._do_POST_impl()\n335\t        finally:\n336\t            _write_semaphore.release()\n337\t\n338\t    def _do_POST_impl(self):\n339\t        parsed = urlparse(self.path)\n340\t        path = parsed.path\n341\t\n342\t        if not self._require_auth():\n343\t            return\n344\t\n345\t        if path == \"/api/tasks\":\n346\t            return self._handle_create_task()\n347\t        if path == \"/api/agents/start\":\n348\t            return self._handle_agent_start()\n349\t        if path == \"/api/loopcli/start\":\n350\t            return self._handle_loopcli_start()\n351\t        if path == \"/api/loopcli/stop\":\n352\t            return self._handle_loopcli_stop()\n353\t        if path == \"/api/loopcli/restart\":\n354\t            return self._handle_loopcli_restart()\n355\t        if path == \"/api/loopcli/dispatch\":\n356\t            return self._handle_loopcli_dispatch()\n357\t        if path == \"/api/messages/send\":\n358\t            return self._handle_message_send()\n359\t        if path == \"/api/agents/enable\":\n360\t            return self._handle_agent_enable(\"enable\")\n361\t        if path == \"/api/agents/disable\":\n362\t            return self._handle_agent_enable(\"disable\")\n363\t\n364\t        self._send_json({\"error\": \"Not found\"}, status=404)\n365\t\n366\t    # ---------- OPTIONS (CORS preflight) ----------\n367\t\n368\t    def do_OPTIONS(self):\n369\t        self.send_response(204)\n370\t        self._cors_headers()\n371\t        self.end_headers()\n372\t\n373\t    # ---------- Handlers ----------\n374\t\n375\t    def _handle_create_task(self):\n376\t        body = self._read_body()\n377\t        if body is None:\n378\t            return\n379\t        title = body.get(\"title\", \"\").strip()\n380\t        if not title:\n381\t            return self._send_json({\"error\": \"title is required\"}, status=400)\n382\t\n383\t        assignee = body.get(\"assignee\") or \"main\"\n384\t        task = create_task(\n385\t            MAIN_DIR, title,\n386\t            description=body.get(\"description\", \"\"),\n387\t            assignee=assignee,\n388\t        )\n389\t        self._send_json(task, status=201)\n390\t\n391\t    def _handle_agent_start(self):\n392\t        body = self._read_body()\n393\t        if body is None:\n394\t            return\n395\t        agent_id = body.get(\"agent\", \"\").strip()\n396\t        if not agent_id:\n397\t            return self._send_json({\"error\": \"agent is required\"}, status=400)\n398\t\n399\t        agent_dir = safe_agent_path(agent_id)\n400\t        if not agent_dir:\n401\t            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n402\t\n403\t        prompt_file = agent_dir / \"PROMPT.md\"\n404\t        if not prompt_file.exists():\n405\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found or no PROMPT.md\"}, status=404)\n406\t\n407\t        prompt = prompt_file.read_text(encoding=\"utf-8\")\n408\t        proc = subprocess.Popen(\n409\t            [\"claude\", \"--print\"],\n410\t            stdin=subprocess.PIPE,\n411\t            stdout=subprocess.PIPE,\n412\t            stderr=subprocess.PIPE,\n413\t            cwd=str(agent_dir),\n414\t        )\n415\t        proc.stdin.write(prompt.encode(\"utf-8\"))\n416\t        proc.stdin.close()\n417\t\n418\t        self._send_json({\n419\t            \"agent\": agent_id,\n420\t            \"pid\": proc.pid,\n421\t            \"status\": \"started\",\n422\t        })\n423\t\n424\t    # --- Loop control handlers ---\n425\t\n426\t    def _handle_loopcli_status(self):\n427\t        state = get_loop_state()\n428\t        pid = state.get(\"pid\")\n429\t        if state.get(\"status\") == \"running\" and pid and not _is_pid_alive(pid):\n430\t            state[\"status\"] = \"stopped\"\n431\t            state[\"pid\"] = None\n432\t            state[\"ended_at\"] = datetime.now().isoformat()\n433\t            set_loop_state(state)\n434\t\n435\t        uptime = 0\n436\t        if state.get(\"started_at\"):\n437\t            try:\n438\t                started = datetime.fromisoformat(state[\"started_at\"])\n439\t                uptime = int((datetime.now() - started).total_seconds())\n440\t            except (ValueError, TypeError):\n441\t                pass\n442\t        state[\"uptime_seconds\"] = uptime\n443\t        self._send_json(state)\n444\t\n445\t    def _handle_loopcli_start(self):\n446\t        body = self._read_body()\n447\t        if body is None:\n448\t            return\n449\t        iterations = int(body.get(\"iterations\", 0))\n450\t        data, status = start_loopcli_process(iterations)\n451\t        self._send_json(data, status)\n452\t\n453\t    def _handle_loopcli_stop(self):\n454\t        data, status = stop_loopcli_process()\n455\t        self._send_json(data, status)\n456\t\n457\t    def _handle_loopcli_restart(self):\n458\t        body = self._read_body()\n459\t        if body is None:\n460\t            return\n461\t        stop_loopcli_process()\n462\t        time.sleep(0.5)\n463\t        iterations = int(body.get(\"iterations\", 0))\n464\t        data, status = start_loopcli_process(iterations)\n465\t        self._send_json(data, status)\n466\t\n467\t    def _handle_loopcli_dispatch(self):\n468\t        body = self._read_body()\n469\t        if body is None:\n470\t            return\n471\t        agent_id = body.get(\"agent\", \"\").strip()\n472\t        title = body.get(\"title\", \"\").strip()\n473\t        if not agent_id or not title:\n474\t            return self._send_json({\"error\": \"agent and title are required\"}, status=400)\n475\t\n476\t        agent_dir = safe_agent_path(agent_id)\n477\t        if not agent_dir or not (agent_dir / \"AGENT\").exists():\n478\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n479\t\n480\t        task = create_task(\n481\t            agent_dir, title,\n482\t            description=body.get(\"description\", \"\"),\n483\t            assignee=agent_id,\n484\t        )\n485\t\n486\t        # Start claude process for this agent\n487\t        prompt_file = agent_dir / \"PROMPT.md\"\n488\t        prompt = \"\"\n489\t        if prompt_file.exists():\n490\t            prompt = prompt_file.read_text(encoding=\"utf-8\")\n491\t\n492\t        proc = subprocess.Popen(\n493\t            [\"claude\", \"--print\", \"--dangerously-skip-permissions\"],\n494\t            stdin=subprocess.PIPE,\n495\t            stdout=subprocess.DEVNULL,\n496\t            stderr=subprocess.DEVNULL,\n497\t            cwd=str(agent_dir),\n498\t        )\n499\t        if prompt:\n500\t            proc.stdin.write(prompt.encode(\"utf-8\"))\n501\t            proc.stdin.close()\n502\t\n503\t        self._send_json({\n504\t            \"task\": task,\n505\t            \"pid\": proc.pid,\n506\t            \"status\": \"dispatched\",\n507\t        }, status=201)\n508\t\n509\t    def _handle_message_send(self):\n510\t        body = self._read_body()\n511\t        if body is None:\n512\t            return\n513\t        content = body.get(\"content\", \"\").strip()\n514\t        if not content:\n515\t            return self._send_json({\"error\": \"content is required\"}, status=400)\n516\t\n517\t        agent_id = body.get(\"agent\", \"main\").strip() or \"main\"\n518\t        agent_dir = safe_agent_path(agent_id)\n519\t        if not agent_dir:\n520\t            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n521\t        if not (agent_dir / \"AGENT\").exists():\n522\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n523\t\n524\t        msg_file = write_inbox_message(agent_dir, \"webui\", content)\n525\t        self._send_json({\"status\": \"sent\", \"agent\": agent_id, \"file\": msg_file.name}, status=201)\n526\t\n527\t    def _handle_agent_enable(self, action):\n528\t        body = self._read_body()\n529\t        if body is None:\n530\t            return\n531\t        agent_id = body.get(\"agent\", \"\").strip()\n532\t        if not agent_id:\n533\t            return self._send_json({\"error\": \"agent is required\"}, status=400)\n534\t        if agent_id == \"main\":\n535\t            return self._send_json({\"error\": \"cannot disable main agent\"}, status=400)\n536\t\n537\t        agent_dir = safe_agent_path(agent_id)\n538\t        if not agent_dir:\n539\t            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n540\t        if not (agent_dir / \"AGENT\").exists():\n541\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n542\t\n543\t        set_agent_enabled(agent_dir, action == \"enable\")\n544\t        self._send_json({\"status\": \"ok\", \"agent\": agent_id, \"enabled\": action == \"enable\"})\n545\t\n546\t\n547\tclass ThreadedHTTPServer(ThreadingMixIn, HTTPServer):\n548\t    daemon_threads = True\n549\t\n550\t\n551\tdef main():\n552\t    host = os.environ.get(\"LOOPCLI_HOST\", \"127.0.0.1\")\n553\t    port = 8080\n554\t    server = ThreadedHTTPServer((host, port), WebUIHandler)\n555\t    print(f\"LoopCLI WebUI Server running on http://{host}:{port}\")\n556\t    print(f\"Static files served from: {WEBUI_DIR}\")\n557\t    print(f\"Agent root: {LOOPCLI_ROOT}\")\n558\t    print(\"Press Ctrl+C to stop.\")\n559\t    try:\n560\t        server.serve_forever()\n561\t    except KeyboardInterrupt:\n562\t        print(\"\\nShutting down.\")\n563\t        server.server_close()\n564\t\n565\t\n566\tif __name__ == \"__main__\":\n567\t    main()\n568\t"}]},"parent_tool_use_id":"call_68a66c34d34e446485460b0e","session_id":"a11b390c-8618-467f-b876-d1d624ad9195","uuid":"d11494c5-e193-4fee-9aa6-ace86f4260c5","timestamp":"2026-05-21T05:05:12.837Z","subagent_type":"Explore","task_description":"Read loopcli_lib.py for review"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_2f13982d49ea4068972e309d","type":"tool_result","content":"1\t\"\"\"\n2\tLoopCLI shared library — common functions used by server.py and run.py.\n3\t\"\"\"\n4\t\n5\timport json\n6\timport os\n7\timport tempfile\n8\timport threading\n9\tfrom pathlib import Path\n10\t\n11\t\n12\tdef _resolve_root():\n13\t    \"\"\"Resolve LOOPCLI_ROOT: env var > auto-detect from file location.\"\"\"\n14\t    env = os.environ.get(\"LOOPCLI_ROOT\", \"\").strip()\n15\t    if env:\n16\t        return Path(env).resolve()\n17\t    # loopcli_lib.py lives at LOOPCLI_ROOT/main/webui/loopcli_lib.py\n18\t    return Path(__file__).resolve().parent.parent.parent\n19\t\n20\t\n21\tLOOPCLI_ROOT = _resolve_root()\n22\tAGENT_MARKER = \"AGENT\"\n23\t\n24\t_json_lock = threading.Lock()\n25\t\n26\t\n27\t# ─── JSON I/O ───\n28\t\n29\tdef read_json(path, default=None):\n30\t    \"\"\"Read and parse a JSON file, returning default on failure.\"\"\"\n31\t    path = Path(path)\n32\t    if not path.exists():\n33\t        return default if default is not None else {}\n34\t    try:\n35\t        return json.loads(path.read_text(encoding=\"utf-8\"))\n36\t    except (json.JSONDecodeError, OSError):\n37\t        return default if default is not None else {}\n38\t\n39\t\n40\tdef write_json(path, data):\n41\t    \"\"\"Atomically write data as JSON using tempfile + os.replace.\n42\t\n43\t    Writes to a temporary file first, then atomically replaces the target.\n44\t    This ensures no partial/corrupt files if the process crashes mid-write.\n45\t    \"\"\"\n46\t    import time as _time\n47\t    path = Path(path)\n48\t    with _json_lock:\n49\t        path.parent.mkdir(parents=True, exist_ok=True)\n50\t        content = json.dumps(data, ensure_ascii=False, indent=2)\n51\t        fd, tmp_path = tempfile.mkstemp(\n52\t            suffix=\".tmp\",\n53\t            prefix=\".loopcli_\",\n54\t            dir=str(path.parent),\n55\t        )\n56\t        try:\n57\t            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as f:\n58\t                f.write(content)\n59\t                f.flush()\n60\t                os.fsync(f.fileno())\n61\t            # On Windows, os.replace can fail if another thread is reading the file.\n62\t            # Retry a few times with a short delay.\n63\t            for attempt in range(5):\n64\t                try:\n65\t                    os.replace(tmp_path, str(path))\n66\t                    break\n67\t                except PermissionError:\n68\t                    if attempt == 4:\n69\t                        raise\n70\t                    _time.sleep(0.05)\n71\t        except BaseException:\n72\t            try:\n73\t                os.unlink(tmp_path)\n74\t            except OSError:\n75\t                pass\n76\t            raise\n77\t\n78\t\n79\t# ─── Agent path safety ───\n80\t\n81\tdef safe_agent_path(agent_id: str) -> Path | None:\n82\t    \"\"\"Validate and resolve an agent directory path, preventing traversal attacks.\"\"\"\n83\t    if not agent_id or '/' in agent_id or '\\\\' in agent_id or '..' in agent_id or '\\x00' in agent_id:\n84\t        return None\n85\t    agent_dir = LOOPCLI_ROOT / agent_id\n86\t    try:\n87\t        agent_dir.resolve().relative_to(LOOPCLI_ROOT.resolve())\n88\t    except ValueError:\n89\t        return None\n90\t    return agent_dir\n91\t\n92\t\n93\t# ─── Agent discovery ───\n94\t\n95\tdef get_agent_marker(agent_dir) -> str | None:\n96\t    \"\"\"Read AGENT marker file content, or None if missing.\"\"\"\n97\t    marker = Path(agent_dir) / AGENT_MARKER\n98\t    if marker.is_file():\n99\t        return marker.read_text(encoding=\"utf-8\").strip()\n100\t    return None\n101\t\n102\t\n103\tdef is_agent_enabled(agent_dir) -> bool:\n104\t    \"\"\"Check if an agent directory has a valid, non-disabled AGENT marker.\"\"\"\n105\t    content = get_agent_marker(agent_dir)\n106\t    if content is None:\n107\t        return False\n108\t    return \"disabled\" not in content\n109\t\n110\t\n111\tdef discover_agents(include_disabled=False):\n112\t    \"\"\"Discover agent directories under LOOPCLI_ROOT.\n113\t\n114\t    Returns list of {\"name\": str, \"path\": str}.\n115\t    \"\"\"\n116\t    agents = []\n117\t    for child in LOOPCLI_ROOT.iterdir():\n118\t        if not child.is_dir():\n119\t            continue\n120\t        if not (child / AGENT_MARKER).exists():\n121\t            continue\n122\t        if include_disabled or is_agent_enabled(child):\n123\t            agents.append({\"name\": child.name, \"path\": str(child)})\n124\t    return agents\n125\t\n126\t\n127\tdef scan_agents():\n128\t    \"\"\"Full agent scan with metadata (state, soul, task counts).\"\"\"\n129\t    agents = []\n130\t    for child in LOOPCLI_ROOT.iterdir():\n131\t        if not child.is_dir():\n132\t            continue\n133\t        if not (child / AGENT_MARKER).exists():\n134\t            continue\n135\t        state = read_json(child / \"memory\" / \"state.json\", {})\n136\t        soul_path = child / \"SOUL.md\"\n137\t        desc = \"\"\n138\t        if soul_path.exists():\n139\t            for line in soul_path.read_text(encoding=\"utf-8\").strip().splitlines():\n140\t                stripped = line.strip()\n141\t                if stripped and not stripped.startswith(\"#\"):\n142\t                    desc = stripped\n143\t                    break\n144\t        tasks = read_json(child / \"memory\" / \"tasks.json\", [])\n145\t        done_count = sum(1 for t in tasks if t.get(\"status\") == \"done\")\n146\t        pending_count = sum(1 for t in tasks if t.get(\"status\") == \"pending\")\n147\t        agents.append({\n148\t            \"id\": child.name,\n149\t            \"name\": state.get(\"agent\", child.name),\n150\t            \"status\": state.get(\"status\", \"unknown\"),\n151\t            \"description\": desc,\n152\t            \"last_run\": state.get(\"last_run\"),\n153\t            \"run_count\": state.get(\"run_count\", 0),\n154\t            \"current_task\": state.get(\"current_task\"),\n155\t            \"task_count\": len(tasks),\n156\t            \"task_done\": done_count,\n157\t            \"task_pending\": pending_count,\n158\t        })\n159\t    return agents\n160\t\n161\t\n162\t# ─── Task management ───\n163\t\n164\tdef next_task_id(tasks):\n165\t    \"\"\"Get the next auto-increment task ID from a task list.\"\"\"\n166\t    return max((t.get(\"id\", 0) for t in tasks), default=0) + 1\n167\t\n168\t\n169\tdef create_task(agent_dir, title, description=\"\", assignee=None, created=None):\n170\t    \"\"\"Create a new task in an agent's tasks.json and return the task dict.\"\"\"\n171\t    from datetime import datetime, timezone\n172\t    agent_dir = Path(agent_dir)\n173\t    tasks_file = agent_dir / \"memory\" / \"tasks.json\"\n174\t    tasks = read_json(tasks_file, [])\n175\t    new_id = next_task_id(tasks)\n176\t    task = {\n177\t        \"id\": new_id,\n178\t        \"status\": \"pending\",\n179\t        \"title\": title,\n180\t        \"description\": description,\n181\t        \"created\": created or datetime.now(timezone.utc).strftime(\"%Y-%m-%d\"),\n182\t        \"assignee\": assignee or agent_dir.name,\n183\t    }\n184\t    tasks.append(task)\n185\t    write_json(tasks_file, tasks)\n186\t    return task\n187\t\n188\t\n189\tdef get_agent_tasks(agent_id):\n190\t    \"\"\"Get tasks for a specific agent by ID. Returns None if agent_id is invalid.\"\"\"\n191\t    agent_dir = safe_agent_path(agent_id)\n192\t    if not agent_dir:\n193\t        return None\n194\t    return read_json(agent_dir / \"memory\" / \"tasks.json\", [])\n195\t\n196\t\n197\tdef get_all_agent_tasks():\n198\t    \"\"\"Aggregate tasks from all agents, each tagged with _agent_id.\"\"\"\n199\t    all_tasks = []\n200\t    for child in LOOPCLI_ROOT.iterdir():\n201\t        if not child.is_dir() or not (child / AGENT_MARKER).exists():\n202\t            continue\n203\t        tasks = read_json(child / \"memory\" / \"tasks.json\", [])\n204\t        for t in tasks:\n205\t            t[\"_agent_id\"] = child.name\n206\t        all_tasks.extend(tasks)\n207\t    return all_tasks\n208\t\n209\t\n210\t# ─── Message / inbox ───\n211\t\n212\tdef write_inbox_message(agent_dir, sender, content, msg_type=\"指令\"):\n213\t    \"\"\"Write a message to an agent's inbox directory. Returns the message file path.\"\"\"\n214\t    import uuid\n215\t    from datetime import datetime\n216\t    agent_dir = Path(agent_dir)\n217\t    inbox_dir = agent_dir / \"inbox\"\n218\t    inbox_dir.mkdir(parents=True, exist_ok=True)\n219\t    now = datetime.now()\n220\t    ts = now.strftime(\"%Y%m%d_%H%M\")\n221\t    msg_file = inbox_dir / f\"{sender}_{ts}_{uuid.uuid4().hex[:8]}.md\"\n222\t    msg_file.write_text(\n223\t        f\"# 来自 {sender} 的消息\\n- 类型：{msg_type}\\n- 时间：{now.strftime('%Y-%m-%d %H:%M')}\\n\\n## 内容\\n{content}\\n\",\n224\t        encoding=\"utf-8\",\n225\t    )\n226\t    return msg_file\n227\t\n228\t\n229\t# ─── Agent enable/disable ───\n230\t\n231\tdef set_agent_enabled(agent_dir, enabled=True):\n232\t    \"\"\"Enable or disable an agent by writing its AGENT marker.\"\"\"\n233\t    agent_dir = Path(agent_dir)\n234\t    marker = agent_dir / AGENT_MARKER\n235\t    if enabled:\n236\t        marker.write_text(\"type: main\\n\", encoding=\"utf-8\")\n237\t    else:\n238\t        marker.write_text(\"type: main\\ndisabled: true\\n\", encoding=\"utf-8\")\n239\t\n240\t\n241\t# ─── File utilities ───\n242\t\n243\tdef get_recent_lines(filepath, n=100):\n244\t    \"\"\"Read the last N lines from a text file.\"\"\"\n245\t    filepath = Path(filepath)\n246\t    if not filepath.exists():\n247\t        return []\n248\t    try:\n249\t        with open(filepath, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n250\t            lines = f.readlines()\n251\t        return [l.rstrip(\"\\n\\r\") for l in lines[-n:]]\n252\t    except OSError:\n253\t        return []\n254\t\n255\t\n256\tdef read_file_tail_incremental(filepath, last_pos=0):\n257\t    \"\"\"Read only new content appended since last_pos.\n258\t\n259\t    Returns (new_lines, new_pos). Efficient for SSE/polling scenarios.\n260\t    \"\"\"\n261\t    filepath = Path(filepath)\n262\t    if not filepath.exists():\n263\t        return [], 0\n264\t    try:\n265\t        size = filepath.stat().st_size\n266\t        if size < last_pos:\n267\t            # File was truncated/rotated — read from start\n268\t            last_pos = 0\n269\t        if size == last_pos:\n270\t            return [], last_pos\n271\t        with open(filepath, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n272\t            f.seek(last_pos)\n273\t            new_content = f.read()\n274\t            new_pos = f.tell()\n275\t        lines = [l.rstrip(\"\\n\\r\") for l in new_content.splitlines()]\n276\t        return lines, new_pos\n277\t    except OSError:\n278\t        return [], last_pos\n279\t"}]},"parent_tool_use_id":"call_68a66c34d34e446485460b0e","session_id":"a11b390c-8618-467f-b876-d1d624ad9195","uuid":"ee69cfeb-e53a-460a-905f-89bd8cb37d03","timestamp":"2026-05-21T05:05:12.838Z","subagent_type":"Explore","task_description":"Read loopcli_lib.py for review"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_c2c1e49948214f3c9366a874","type":"tool_result","content":"1\t\"\"\"\n2\tTests for run.py — agent discovery, task management, and helper functions.\n3\t\"\"\"\n4\t\n5\timport json\n6\timport os\n7\timport sys\n8\timport threading\n9\timport pytest\n10\tfrom pathlib import Path\n11\t\n12\t# run.py calls parser.parse_args() at module level, so we must\n13\t# provide valid argv before importing. \"list\" is a safe no-side-effect command.\n14\t_original_argv = sys.argv.copy()\n15\tsys.argv = [\"run.py\", \"list\"]\n16\tsys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))\n17\tfrom run import (\n18\t    get_agent_marker,\n19\t    is_agent_enabled,\n20\t    discover_agents,\n21\t    find_template,\n22\t    load_agent_state,\n23\t    load_agent_tasks,\n24\t    cmd_task_inner,\n25\t    LOOPCLI_DIR,\n26\t    AGENT_MARKER,\n27\t)\n28\tsys.argv = _original_argv\n29\t\n30\t\n31\t# ─── Fixtures ───\n32\t\n33\t@pytest.fixture\n34\tdef fake_agent(tmp_path):\n35\t    \"\"\"Create a minimal fake agent directory for testing.\"\"\"\n36\t    agent_dir = tmp_path / \"test-agent\"\n37\t    agent_dir.mkdir()\n38\t    (agent_dir / AGENT_MARKER).write_text(\"type: main\\n\", encoding=\"utf-8\")\n39\t    mem_dir = agent_dir / \"memory\"\n40\t    mem_dir.mkdir()\n41\t    (mem_dir / \"state.json\").write_text(json.dumps({\n42\t        \"agent\": \"test-agent\",\n43\t        \"status\": \"idle\",\n44\t        \"run_count\": 0,\n45\t    }), encoding=\"utf-8\")\n46\t    (mem_dir / \"tasks.json\").write_text(\"[]\", encoding=\"utf-8\")\n47\t    log_dir = agent_dir / \"log\"\n48\t    log_dir.mkdir()\n49\t    return agent_dir\n50\t\n51\t\n52\t# ─── get_agent_marker ───\n53\t\n54\tclass TestGetAgentMarker:\n55\t    def test_reads_valid_marker(self, fake_agent):\n56\t        content = get_agent_marker(str(fake_agent))\n57\t        assert content == \"type: main\"\n58\t\n59\t    def test_returns_none_for_missing(self, tmp_path):\n60\t        assert get_agent_marker(str(tmp_path / \"nonexistent\")) is None\n61\t\n62\t    def test_reads_disabled_marker(self, tmp_path):\n63\t        d = tmp_path / \"disabled-agent\"\n64\t        d.mkdir()\n65\t        (d / AGENT_MARKER).write_text(\"type: main\\ndisabled: true\\n\", encoding=\"utf-8\")\n66\t        content = get_agent_marker(str(d))\n67\t        assert \"disabled\" in content\n68\t\n69\t\n70\t# ─── is_agent_enabled ───\n71\t\n72\tclass TestIsAgentEnabled:\n73\t    def test_enabled_agent(self, fake_agent):\n74\t        assert is_agent_enabled(str(fake_agent)) is True\n75\t\n76\t    def test_disabled_agent(self, tmp_path):\n77\t        d = tmp_path / \"disabled\"\n78\t        d.mkdir()\n79\t        (d / AGENT_MARKER).write_text(\"type: main\\ndisabled: true\\n\", encoding=\"utf-8\")\n80\t        assert is_agent_enabled(str(d)) is False\n81\t\n82\t    def test_no_marker(self, tmp_path):\n83\t        assert is_agent_enabled(str(tmp_path)) is False\n84\t\n85\t\n86\t# ─── discover_agents ───\n87\t\n88\tclass TestDiscoverAgents:\n89\t    def test_finds_real_agents(self):\n90\t        agents = discover_agents()\n91\t        assert isinstance(agents, list)\n92\t        # main should always be discovered\n93\t        names = [a[\"name\"] for a in agents]\n94\t        assert \"main\" in names\n95\t\n96\t    def test_agent_has_required_keys(self):\n97\t        agents = discover_agents()\n98\t        for a in agents:\n99\t            assert \"name\" in a\n100\t            assert \"path\" in a\n101\t\n102\t    def test_excludes_disabled(self):\n103\t        # discover_agents() without include_disabled should skip disabled agents\n104\t        agents = discover_agents(include_disabled=False)\n105\t        # Verify none of the returned agents are disabled\n106\t        for a in agents:\n107\t            assert is_agent_enabled(a[\"path\"])\n108\t\n109\t\n110\t# ─── find_template ───\n111\t\n112\tclass TestFindTemplate:\n113\t    def test_existing_template(self):\n114\t        result = find_template(\"engineering-frontend-developer\")\n115\t        if result:\n116\t            assert result.endswith(\"engineering-frontend-developer.md\")\n117\t            assert os.path.isfile(result)\n118\t\n119\t    def test_nonexistent_template(self):\n120\t        result = find_template(\"nonexistent-template-xyz-999\")\n121\t        assert result is None\n122\t\n123\t\n124\t# ─── load_agent_state ───\n125\t\n126\tclass TestLoadAgentState:\n127\t    def test_loads_main_state(self):\n128\t        main_dir = os.path.join(LOOPCLI_DIR, \"main\")\n129\t        state = load_agent_state(main_dir)\n130\t        assert state is not None\n131\t        assert state.get(\"agent\", \"\").lower() == \"main\"\n132\t\n133\t    def test_loads_state_from_fixture(self, fake_agent):\n134\t        state = load_agent_state(str(fake_agent))\n135\t        assert state[\"agent\"] == \"test-agent\"\n136\t        assert state[\"status\"] == \"idle\"\n137\t\n138\t    def test_missing_state_returns_none(self, tmp_path):\n139\t        assert load_agent_state(str(tmp_path)) is None\n140\t\n141\t\n142\t# ─── load_agent_tasks ───\n143\t\n144\tclass TestLoadAgentTasks:\n145\t    def test_loads_tasks(self, fake_agent):\n146\t        tasks = load_agent_tasks(str(fake_agent))\n147\t        assert isinstance(tasks, list)\n148\t\n149\t    def test_empty_tasks(self, fake_agent):\n150\t        tasks = load_agent_tasks(str(fake_agent))\n151\t        assert tasks == []\n152\t\n153\t    def test_missing_returns_empty(self, tmp_path):\n154\t        tasks = load_agent_tasks(str(tmp_path))\n155\t        assert tasks == []\n156\t\n157\t    def test_real_main_tasks(self):\n158\t        main_dir = os.path.join(LOOPCLI_DIR, \"main\")\n159\t        tasks = load_agent_tasks(main_dir)\n160\t        assert isinstance(tasks, list)\n161\t\n162\t\n163\t# ─── cmd_task_inner ───\n164\t\n165\tclass TestCmdTaskInner:\n166\t    def test_adds_task_to_fake_agent_exits(self, fake_agent):\n167\t        \"\"\"cmd_task_inner expects agent in LOOPCLI_DIR, not tmp_path.\"\"\"\n168\t        with pytest.raises(SystemExit):\n169\t            cmd_task_inner(\"test-agent\", \"Test task title\", \"Test description\")\n170\t\n171\t    def test_adds_task_to_real_agent(self):\n172\t        \"\"\"Test adding a task to the real engineering-frontend-developer agent.\"\"\"\n173\t        agent_name = \"engineering-frontend-developer\"\n174\t        agent_dir = os.path.join(LOOPCLI_DIR, agent_name)\n175\t        if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n176\t            pytest.skip(\"Agent not found\")\n177\t\n178\t        tasks_before = load_agent_tasks(agent_dir)\n179\t        count_before = len(tasks_before)\n180\t\n181\t        try:\n182\t            cmd_task_inner(agent_name, \"[TEST] unit test task\", \"[TEST] desc\")\n183\t\n184\t            tasks_after = load_agent_tasks(agent_dir)\n185\t            assert len(tasks_after) == count_before + 1\n186\t\n187\t            new_task = tasks_after[-1]\n188\t            assert new_task[\"title\"] == \"[TEST] unit test task\"\n189\t            assert new_task[\"status\"] == \"pending\"\n190\t        finally:\n191\t            with open(os.path.join(agent_dir, \"memory\", \"tasks.json\"), \"w\", encoding=\"utf-8\") as f:\n192\t                json.dump(tasks_before, f, indent=2, ensure_ascii=False)\n193\t\n194\t    def test_task_id_auto_increments(self):\n195\t        agent_name = \"engineering-frontend-developer\"\n196\t        agent_dir = os.path.join(LOOPCLI_DIR, agent_name)\n197\t        if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n198\t            pytest.skip(\"Agent not found\")\n199\t\n200\t        tasks_before = load_agent_tasks(agent_dir)\n201\t        max_id = max((t[\"id\"] for t in tasks_before), default=0)\n202\t\n203\t        try:\n204\t            cmd_task_inner(agent_name, \"[TEST] increment test\", \"\")\n205\t\n206\t            tasks_after = load_agent_tasks(agent_dir)\n207\t            new_task = tasks_after[-1]\n208\t            assert new_task[\"id\"] == max_id + 1\n209\t        finally:\n210\t            with open(os.path.join(agent_dir, \"memory\", \"tasks.json\"), \"w\", encoding=\"utf-8\") as f:\n211\t                json.dump(tasks_before, f, indent=2, ensure_ascii=False)\n212\t\n213\t\n214\t# ─── Integration: agent directory structure ───\n215\t\n216\tclass TestAgentStructure:\n217\t    def test_main_has_required_files(self):\n218\t        main_dir = Path(LOOPCLI_DIR) / \"main\"\n219\t        assert (main_dir / AGENT_MARKER).exists()\n220\t        assert (main_dir / \"memory\" / \"state.json\").exists()\n221\t        assert (main_dir / \"memory\" / \"tasks.json\").exists()\n222\t\n223\t    def test_frontend_agent_has_required_files(self):\n224\t        agent_dir = Path(LOOPCLI_DIR) / \"engineering-frontend-developer\"\n225\t        if not (agent_dir / AGENT_MARKER).exists():\n226\t            pytest.skip(\"Agent not found\")\n227\t        assert (agent_dir / \"SOUL.md\").exists()\n228\t        assert (agent_dir / \"memory\" / \"state.json\").exists()\n229\t        assert (agent_dir / \"memory\" / \"tasks.json\").exists()\n230\t\n231\t\n232\t# ─── File lock mechanism ───\n233\t\n234\tclass TestFileLock:\n235\t    \"\"\"Tests that verify msvcrt file locking prevents data corruption.\"\"\"\n236\t\n237\t    def _locked_state_update(self, state_file):\n238\t        \"\"\"Simulates the state update logic from run_agent with file locking.\"\"\"\n239\t        import msvcrt\n240\t        with open(state_file, \"r+\") as f:\n241\t            msvcrt.locking(f.fileno(), msvcrt.LK_LOCK, 1)\n242\t            try:\n243\t                state = json.load(f)\n244\t                state[\"run_count\"] = state.get(\"run_count\", 0) + 1\n245\t                f.seek(0)\n246\t                f.truncate()\n247\t                json.dump(state, f, indent=2, ensure_ascii=False)\n248\t            finally:\n249\t                f.seek(0)\n250\t                msvcrt.locking(f.fileno(), msvcrt.LK_UNLCK, 1)\n251\t\n252\t    def test_concurrent_writes_no_corruption(self, tmp_path):\n253\t        \"\"\"Multiple threads updating state concurrently must produce correct result.\"\"\"\n254\t        state_file = str(tmp_path / \"state.json\")\n255\t        with open(state_file, \"w\", encoding=\"utf-8\") as f:\n256\t            json.dump({\"run_count\": 0}, f)\n257\t\n258\t        N = 10\n259\t        barrier = threading.Barrier(N)\n260\t        errors = []\n261\t\n262\t        def worker():\n263\t            barrier.wait()\n264\t            try:\n265\t                self._locked_state_update(state_file)\n266\t            except Exception as e:\n267\t                errors.append(e)\n268\t\n269\t        threads = [threading.Thread(target=worker) for _ in range(N)]\n270\t        for t in threads:\n271\t            t.start()\n272\t        for t in threads:\n273\t            t.join()\n274\t\n275\t        assert not errors, f\"Errors during concurrent writes: {errors}\"\n276\t        with open(state_file, encoding=\"utf-8\") as f:\n277\t            final = json.load(f)\n278\t        assert final[\"run_count\"] == N\n279\t\n280\t    def test_lock_produces_valid_json(self, tmp_path):\n281\t        \"\"\"Even under heavy contention, the output file must be valid JSON.\"\"\"\n282\t        import msvcrt\n283\t        state_file = str(tmp_path / \"state.json\")\n284\t        with open(state_file, \"w\", encoding=\"utf-8\") as f:\n285\t            json.dump({\"counter\": 0}, f)\n286\t\n287\t        N = 10\n288\t\n289\t        def update():\n290\t            for _ in range(50):\n291\t                try:\n292\t                    with open(state_file, \"r+\") as f:\n293\t                        msvcrt.locking(f.fileno(), msvcrt.LK_LOCK, 1)\n294\t                        try:\n295\t                            state = json.load(f)\n296\t                            state[\"counter\"] = state.get(\"counter\", 0) + 1\n297\t                            f.seek(0)\n298\t                            f.truncate()\n299\t                            json.dump(state, f, indent=2, ensure_ascii=False)\n300\t                        finally:\n301\t                            f.seek(0)\n302\t                            msvcrt.locking(f.fileno(), msvcrt.LK_UNLCK, 1)\n303\t                    return\n304\t                except OSError:\n305\t                    import time as _time\n306\t                    _time.sleep(0.01)\n307\t\n308\t        threads = [threading.Thread(target=update) for _ in range(N)]\n309\t        for t in threads:\n310\t            t.start()\n311\t        for t in threads:\n312\t            t.join()\n313\t\n314\t        with open(state_file, encoding=\"utf-8\") as f:\n315\t            final = json.load(f)\n316\t        assert final[\"counter\"] == N\n317\t\n318\t    def test_single_write_preserves_data(self, tmp_path):\n319\t        \"\"\"A single locked write preserves all existing fields.\"\"\"\n320\t        state_file = str(tmp_path / \"state.json\")\n321\t        with open(state_file, \"w\", encoding=\"utf-8\") as f:\n322\t            json.dump({\"agent\": \"test\", \"status\": \"running\", \"run_count\": 5}, f)\n323\t\n324\t        self._locked_state_update(state_file)\n325\t\n326\t        with open(state_file, encoding=\"utf-8\") as f:\n327\t            final = json.load(f)\n328\t        assert final[\"agent\"] == \"test\"\n329\t        assert final[\"status\"] == \"running\"\n330\t        assert final[\"run_count\"] == 6\n331\t"}]},"parent_tool_use_id":"call_68a66c34d34e446485460b0e","session_id":"a11b390c-8618-467f-b876-d1d624ad9195","uuid":"5ee70f43-a16a-4501-9310-2026ecfcf1ad","timestamp":"2026-05-21T05:05:12.839Z","subagent_type":"Explore","task_description":"Read loopcli_lib.py for review"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_44ea4d636a4f4b2ea711e615","type":"tool_result","content":"1\t\"\"\"\n2\tTests for webui/server.py — API endpoints and helper functions.\n3\tUses a real threaded HTTP server with httpx client.\n4\t\"\"\"\n5\t\n6\timport json\n7\timport os\n8\timport sys\n9\timport time\n10\timport threading\n11\timport pytest\n12\timport httpx\n13\tfrom unittest.mock import patch\n14\t\n15\t# Add webui directory to path so we can import server\n16\tsys.path.insert(0, os.path.join(os.path.dirname(__file__), \"..\", \"webui\"))\n17\t\n18\tfrom server import (\n19\t    WebUIHandler,\n20\t    ThreadedHTTPServer,\n21\t    MAIN_DIR,\n22\t)\n23\tfrom loopcli_lib import (\n24\t    safe_agent_path as _safe_agent_path,\n25\t    read_json,\n26\t    write_json,\n27\t    scan_agents,\n28\t    get_recent_lines,\n29\t    LOOPCLI_ROOT,\n30\t)\n31\tfrom pathlib import Path\n32\t\n33\t\n34\t# ─── Fixtures ───\n35\t\n36\tBASE_PORT = 18765\n37\t_port_lock = threading.Lock()\n38\t_port_counter = [0]\n39\t\n40\t\n41\tdef _get_port():\n42\t    with _port_lock:\n43\t        _port_counter[0] += 1\n44\t        return BASE_PORT + _port_counter[0]\n45\t\n46\t\n47\t@pytest.fixture(scope=\"module\")\n48\tdef http_server():\n49\t    \"\"\"Start a real HTTP server in a thread for the entire module.\"\"\"\n50\t    port = _get_port()\n51\t    server = ThreadedHTTPServer((\"127.0.0.1\", port), WebUIHandler)\n52\t    t = threading.Thread(target=server.serve_forever, daemon=True)\n53\t    t.start()\n54\t    time.sleep(0.2)\n55\t    yield f\"http://127.0.0.1:{port}\"\n56\t    server.shutdown()\n57\t\n58\t\n59\t@pytest.fixture\n60\tdef client(http_server):\n61\t    return httpx.Client(base_url=http_server, timeout=5)\n62\t\n63\t\n64\t# ─── Helper: _safe_agent_path ───\n65\t\n66\tclass TestSafeAgentPath:\n67\t    def test_valid_agent(self):\n68\t        result = _safe_agent_path(\"main\")\n69\t        assert result is not None\n70\t        assert str(result) == str(LOOPCLI_ROOT / \"main\")\n71\t\n72\t    def test_empty_string(self):\n73\t        assert _safe_agent_path(\"\") is None\n74\t\n75\t    def test_slash_traversal(self):\n76\t        assert _safe_agent_path(\"main/../../../etc\") is None\n77\t\n78\t    def test_backslash_traversal(self):\n79\t        assert _safe_agent_path(\"main\\\\..\\\\..\\\\etc\") is None\n80\t\n81\t    def test_double_dot(self):\n82\t        assert _safe_agent_path(\"..\") is None\n83\t\n84\t    def test_path_with_slash(self):\n85\t        assert _safe_agent_path(\"foo/bar\") is None\n86\t\n87\t    def test_path_with_backslash(self):\n88\t        assert _safe_agent_path(\"foo\\\\bar\") is None\n89\t\n90\t    def test_valid_subdir_name(self):\n91\t        result = _safe_agent_path(\"engineering-frontend-developer\")\n92\t        assert result is not None\n93\t        assert result.name == \"engineering-frontend-developer\"\n94\t\n95\t    def test_null_byte_injection(self):\n96\t        assert _safe_agent_path(\"main\\x00\") is None\n97\t\n98\t    def test_null_byte_in_middle(self):\n99\t        assert _safe_agent_path(\"main\\x00evil\") is None\n100\t\n101\t    def test_null_byte_at_start(self):\n102\t        assert _safe_agent_path(\"\\x00main\") is None\n103\t\n104\t    def test_null_byte_with_suffix(self):\n105\t        assert _safe_agent_path(\"main\\x00.sh\") is None\n106\t\n107\t\n108\t# ─── Helper: read_json / write_json ───\n109\t\n110\tclass TestJsonIO:\n111\t    def test_read_nonexistent_returns_default(self, tmp_path):\n112\t        result = read_json(tmp_path / \"nope.json\", {\"x\": 1})\n113\t        assert result == {\"x\": 1}\n114\t\n115\t    def test_read_nonexistent_no_default(self, tmp_path):\n116\t        result = read_json(tmp_path / \"nope.json\")\n117\t        assert result == {}\n118\t\n119\t    def test_read_valid_json(self, tmp_path):\n120\t        p = tmp_path / \"test.json\"\n121\t        p.write_text('{\"a\": 1}', encoding=\"utf-8\")\n122\t        assert read_json(p) == {\"a\": 1}\n123\t\n124\t    def test_read_corrupt_json(self, tmp_path):\n125\t        p = tmp_path / \"bad.json\"\n126\t        p.write_text(\"{invalid\", encoding=\"utf-8\")\n127\t        assert read_json(p, \"fallback\") == \"fallback\"\n128\t\n129\t    def test_write_json_creates_dirs(self, tmp_path):\n130\t        p = tmp_path / \"sub\" / \"dir\" / \"out.json\"\n131\t        write_json(p, {\"k\": \"v\"})\n132\t        assert p.exists()\n133\t        assert json.loads(p.read_text(encoding=\"utf-8\")) == {\"k\": \"v\"}\n134\t\n135\t    def test_roundtrip(self, tmp_path):\n136\t        p = tmp_path / \"rt.json\"\n137\t        data = {\"hello\": \"世界\", \"num\": 42}\n138\t        write_json(p, data)\n139\t        assert read_json(p) == data\n140\t\n141\t\n142\t# ─── Helper: get_recent_lines ───\n143\t\n144\tclass TestGetRecentLines:\n145\t    def test_nonexistent_file(self, tmp_path):\n146\t        assert get_recent_lines(tmp_path / \"nope.log\") == []\n147\t\n148\t    def test_reads_last_n(self, tmp_path):\n149\t        p = tmp_path / \"test.log\"\n150\t        p.write_text(\"\\n\".join(f\"line {i}\" for i in range(10)), encoding=\"utf-8\")\n151\t        lines = get_recent_lines(p, 3)\n152\t        assert len(lines) == 3\n153\t        assert lines[0] == \"line 7\"\n154\t\n155\t    def test_all_lines_if_fewer_than_n(self, tmp_path):\n156\t        p = tmp_path / \"short.log\"\n157\t        p.write_text(\"a\\nb\", encoding=\"utf-8\")\n158\t        lines = get_recent_lines(p, 100)\n159\t        assert len(lines) == 2\n160\t\n161\t\n162\t# ─── Helper: scan_agents ───\n163\t\n164\tclass TestScanAgents:\n165\t    def test_returns_list(self):\n166\t        agents = scan_agents()\n167\t        assert isinstance(agents, list)\n168\t\n169\t    def test_main_agent_present(self):\n170\t        agents = scan_agents()\n171\t        names = [a[\"id\"] for a in agents]\n172\t        assert \"main\" in names\n173\t\n174\t    def test_agent_has_required_fields(self):\n175\t        agents = scan_agents()\n176\t        for a in agents:\n177\t            assert \"id\" in a\n178\t            assert \"name\" in a\n179\t            assert \"status\" in a\n180\t\n181\t\n182\t# ─── API: GET /api/agents ───\n183\t\n184\tclass TestGetAgents:\n185\t    def test_returns_200(self, client):\n186\t        r = client.get(\"/api/agents\")\n187\t        assert r.status_code == 200\n188\t\n189\t    def test_returns_json_list(self, client):\n190\t        r = client.get(\"/api/agents\")\n191\t        data = r.json()\n192\t        assert isinstance(data, list)\n193\t\n194\t    def test_includes_main(self, client):\n195\t        r = client.get(\"/api/agents\")\n196\t        names = [a[\"id\"] for a in r.json()]\n197\t        assert \"main\" in names\n198\t\n199\t\n200\t# ─── API: GET /api/tasks ───\n201\t\n202\tclass TestGetTasks:\n203\t    def test_returns_200(self, client):\n204\t        r = client.get(\"/api/tasks\")\n205\t        assert r.status_code == 200\n206\t\n207\t    def test_returns_json_list(self, client):\n208\t        r = client.get(\"/api/tasks\")\n209\t        assert isinstance(r.json(), list)\n210\t\n211\t\n212\t# ─── API: POST /api/tasks ───\n213\t\n214\tclass TestCreateTask:\n215\t    def test_create_task_success(self, client):\n216\t        tasks_before = client.get(\"/api/tasks\").json()\n217\t        try:\n218\t            r = client.post(\"/api/tasks\", json={\n219\t                \"title\": f\"[TEST] unit test task {time.time()}\",\n220\t                \"description\": \"created by automated test\",\n221\t                \"assignee\": \"main\",\n222\t            })\n223\t            assert r.status_code == 201\n224\t            data = r.json()\n225\t            assert data[\"status\"] == \"pending\"\n226\t            assert data[\"title\"].startswith(\"[TEST]\")\n227\t        finally:\n228\t            write_json(MAIN_DIR / \"memory\" / \"tasks.json\", tasks_before)\n229\t\n230\t    def test_create_task_missing_title(self, client):\n231\t        r = client.post(\"/api/tasks\", json={\"description\": \"no title\"})\n232\t        assert r.status_code == 400\n233\t        assert \"error\" in r.json()\n234\t\n235\t    def test_create_task_empty_body(self, client):\n236\t        r = client.post(\"/api/tasks\", json={})\n237\t        assert r.status_code == 400\n238\t\n239\t\n240\t# ─── API: POST /api/messages/send ───\n241\t\n242\tclass TestMessageSend:\n243\t    def test_send_to_main(self, client):\n244\t        r = client.post(\"/api/messages/send\", json={\n245\t            \"content\": f\"test message {time.time()}\",\n246\t            \"agent\": \"main\",\n247\t        })\n248\t        assert r.status_code == 201\n249\t        data = r.json()\n250\t        assert data[\"status\"] == \"sent\"\n251\t        assert data[\"agent\"] == \"main\"\n252\t\n253\t        # Cleanup the test message\n254\t        if data.get(\"file\"):\n255\t            msg_path = LOOPCLI_ROOT / \"main\" / \"inbox\" / data[\"file\"]\n256\t            if msg_path.exists():\n257\t                msg_path.unlink()\n258\t\n259\t    def test_send_default_agent_is_main(self, client):\n260\t        r = client.post(\"/api/messages/send\", json={\n261\t            \"content\": f\"default agent test {time.time()}\",\n262\t        })\n263\t        assert r.status_code == 201\n264\t        assert r.json()[\"agent\"] == \"main\"\n265\t\n266\t        # Cleanup\n267\t        data = r.json()\n268\t        if data.get(\"file\"):\n269\t            msg_path = LOOPCLI_ROOT / \"main\" / \"inbox\" / data[\"file\"]\n270\t            if msg_path.exists():\n271\t                msg_path.unlink()\n272\t\n273\t    def test_send_empty_content(self, client):\n274\t        r = client.post(\"/api/messages/send\", json={\"content\": \"\"})\n275\t        assert r.status_code == 400\n276\t\n277\t    def test_send_to_invalid_agent(self, client):\n278\t        r = client.post(\"/api/messages/send\", json={\n279\t            \"content\": \"hello\",\n280\t            \"agent\": \"../etc\",\n281\t        })\n282\t        assert r.status_code == 400\n283\t\n284\t    def test_send_to_nonexistent_agent(self, client):\n285\t        r = client.post(\"/api/messages/send\", json={\n286\t            \"content\": \"hello\",\n287\t            \"agent\": \"nonexistent_agent_xyz\",\n288\t        })\n289\t        assert r.status_code == 404\n290\t\n291\t\n292\t# ─── API: Path traversal rejection ───\n293\t\n294\tclass TestPathTraversal:\n295\t    def test_agents_endpoint_rejects_traversal(self, client):\n296\t        # /api/logs?agent=../etc should be rejected\n297\t        r = client.get(\"/api/logs\", params={\"agent\": \"../etc\"})\n298\t        assert r.status_code == 400\n299\t\n300\t    def test_agents_endpoint_rejects_dotdot(self, client):\n301\t        r = client.get(\"/api/logs\", params={\"agent\": \"..\"})\n302\t        assert r.status_code == 400\n303\t\n304\t    def test_messages_send_rejects_traversal(self, client):\n305\t        r = client.post(\"/api/messages/send\", json={\n306\t            \"content\": \"test\",\n307\t            \"agent\": \"../etc\",\n308\t        })\n309\t        assert r.status_code == 400\n310\t\n311\t\n312\t# ─── API: GET /api/logs ───\n313\t\n314\tclass TestGetLogs:\n315\t    def test_returns_200(self, client):\n316\t        r = client.get(\"/api/logs\")\n317\t        assert r.status_code == 200\n318\t        data = r.json()\n319\t        assert \"lines\" in data\n320\t\n321\t    def test_with_valid_agent(self, client):\n322\t        r = client.get(\"/api/logs\", params={\"agent\": \"main\"})\n323\t        assert r.status_code == 200\n324\t\n325\t    def test_with_invalid_agent(self, client):\n326\t        r = client.get(\"/api/logs\", params={\"agent\": \"../etc\"})\n327\t        assert r.status_code == 400\n328\t\n329\t\n330\t# ─── API: OPTIONS (CORS) ───\n331\t\n332\tclass TestCORS:\n333\t    def test_options_returns_204(self, client):\n334\t        r = client.options(\"/api/agents\")\n335\t        assert r.status_code == 204\n336\t\n337\t    def test_cors_allows_configured_origin(self, client):\n338\t        r = client.options(\"/api/agents\", headers={\"Origin\": \"http://localhost:3000\"})\n339\t        assert r.status_code == 204\n340\t        assert r.headers.get(\"access-control-allow-origin\") == \"http://localhost:3000\"\n341\t\n342\t    def test_cors_rejects_unknown_origin(self, client):\n343\t        r = client.options(\"/api/agents\", headers={\"Origin\": \"http://evil.com\"})\n344\t        assert r.status_code == 204\n345\t        assert r.headers.get(\"access-control-allow-origin\") is None\n346\t\n347\t\n348\t# ─── API: 404 for unknown POST ───\n349\t\n350\tclass TestNotFound:\n351\t    def test_unknown_post_returns_404(self, client):\n352\t        r = client.post(\"/api/nonexistent\")\n353\t        assert r.status_code == 404\n354\t\n355\t\n356\t# ─── API Key authentication ───\n357\t\n358\tclass TestApiKeyAuth:\n359\t    @patch(\"server.API_KEY\", \"test-secret-key-12345\")\n360\t    def test_create_task_rejects_without_key(self, client):\n361\t        r = client.post(\"/api/tasks\", json={\n362\t            \"title\": \"[TEST] should be rejected\",\n363\t            \"description\": \"no api key\",\n364\t        })\n365\t        assert r.status_code == 401\n366\t        assert \"error\" in r.json()\n367\t\n368\t    @patch(\"server.API_KEY\", \"test-secret-key-12345\")\n369\t    def test_create_task_rejects_wrong_key(self, client):\n370\t        r = client.post(\"/api/tasks\", json={\n371\t            \"title\": \"[TEST] wrong key\",\n372\t            \"description\": \"bad api key\",\n373\t        }, headers={\"X-API-Key\": \"wrong-key\"})\n374\t        assert r.status_code == 401\n375\t\n376\t    @patch(\"server.API_KEY\", \"test-secret-key-12345\")\n377\t    def test_create_task_accepts_valid_key(self, client):\n378\t        tasks_before = client.get(\"/api/tasks\").json()\n379\t        try:\n380\t            r = client.post(\"/api/tasks\", json={\n381\t                \"title\": \"[TEST] auth validated task\",\n382\t                \"description\": \"with correct api key\",\n383\t            }, headers={\"X-API-Key\": \"test-secret-key-12345\"})\n384\t            assert r.status_code == 201\n385\t            assert r.json()[\"status\"] == \"pending\"\n386\t        finally:\n387\t            write_json(MAIN_DIR / \"memory\" / \"tasks.json\", tasks_before)\n388\t\n389\t    @patch(\"server.API_KEY\", \"test-secret-key-12345\")\n390\t    def test_message_send_rejects_without_key(self, client):\n391\t        r = client.post(\"/api/messages/send\", json={\n392\t            \"content\": \"should be rejected\",\n393\t        })\n394\t        assert r.status_code == 401\n395\t\n396\t    @patch(\"server.API_KEY\", \"test-secret-key-12345\")\n397\t    def test_message_send_accepts_valid_key(self, client):\n398\t        r = client.post(\"/api/messages/send\", json={\n399\t            \"content\": \"auth test message\",\n400\t        }, headers={\"X-API-Key\": \"test-secret-key-12345\"})\n401\t        assert r.status_code == 201\n402\t        data = r.json()\n403\t        assert data[\"status\"] == \"sent\"\n404\t        if data.get(\"file\"):\n405\t            msg_path = LOOPCLI_ROOT / \"main\" / \"inbox\" / data[\"file\"]\n406\t            if msg_path.exists():\n407\t                msg_path.unlink()\n408\t\n409\t    @patch(\"server.API_KEY\", \"test-secret-key-12345\")\n410\t    def test_message_send_key_in_query_params(self, client):\n411\t        r = client.post(\"/api/messages/send?key=test-secret-key-12345\", json={\n412\t            \"content\": \"query param key test\",\n413\t        })\n414\t        assert r.status_code == 201\n415\t        data = r.json()\n416\t        if data.get(\"file\"):\n417\t            msg_path = LOOPCLI_ROOT / \"main\" / \"inbox\" / data[\"file\"]\n418\t            if msg_path.exists():\n419\t                msg_path.unlink()\n420\t\n421\t\n422\t# ─── Atomic write_json ───\n423\t\n424\tclass TestAtomicWriteJson:\n425\t    def test_atomic_write_produces_valid_json(self, tmp_path):\n426\t        p = tmp_path / \"atomic.json\"\n427\t        data = {\"key\": \"value\", \"num\": 42, \"nested\": {\"a\": [1, 2, 3]}}\n428\t        write_json(p, data)\n429\t        assert p.exists()\n430\t        assert json.loads(p.read_text(encoding=\"utf-8\")) == data\n431\t\n432\t    def test_atomic_write_creates_parent_dirs(self, tmp_path):\n433\t        p = tmp_path / \"deep\" / \"nested\" / \"dir\" / \"out.json\"\n434\t        write_json(p, {\"x\": 1})\n435\t        assert p.exists()\n436\t        assert json.loads(p.read_text(encoding=\"utf-8\")) == {\"x\": 1}\n437\t\n438\t    def test_atomic_write_overwrites_existing(self, tmp_path):\n439\t        p = tmp_path / \"overwrite.json\"\n440\t        write_json(p, {\"v\": 1})\n441\t        write_json(p, {\"v\": 2})\n442\t        assert json.loads(p.read_text(encoding=\"utf-8\")) == {\"v\": 2}\n443\t\n444\t    def test_atomic_write_no_leftover_tmp_files(self, tmp_path):\n445\t        p = tmp_path / \"clean.json\"\n446\t        write_json(p, {\"clean\": True})\n447\t        tmp_files = list(tmp_path.glob(\".loopcli_*.tmp\"))\n448\t        assert len(tmp_files) == 0, f\"Leftover temp files: {tmp_files}\"\n449\t\n450\t    def test_atomic_write_preserves_unicode(self, tmp_path):\n451\t        p = tmp_path / \"unicode.json\"\n452\t        data = {\"hello\": \"世界\", \"emoji\": \"💻\"}\n453\t        write_json(p, data)\n454\t        assert json.loads(p.read_text(encoding=\"utf-8\")) == data\n455\t\n456\t    def test_atomic_write_concurrent_safety(self, tmp_path):\n457\t        \"\"\"Multiple threads writing to the same file should not corrupt it.\"\"\"\n458\t        import threading\n459\t        p = tmp_path / \"concurrent.json\"\n460\t        write_json(p, {\"counter\": 0})\n461\t        N = 10\n462\t        barrier = threading.Barrier(N)\n463\t        errors = []\n464\t\n465\t        def worker(i):\n466\t            barrier.wait()\n467\t            try:\n468\t                write_json(p, {\"worker\": i, \"counter\": i})\n469\t            except Exception as e:\n470\t                errors.append(e)\n471\t\n472\t        threads = [threading.Thread(target=worker, args=(i,)) for i in range(N)]\n473\t        for t in threads:\n474\t            t.start()\n475\t        for t in threads:\n476\t            t.join()\n477\t\n478\t        assert not errors, f\"Errors during concurrent writes: {errors}\"\n479\t        result = json.loads(p.read_text(encoding=\"utf-8\"))\n480\t        assert \"counter\" in result\n481\t        assert result[\"counter\"] < N\n482\t\n483\t    def test_roundtrip_atomic(self, tmp_path):\n484\t        p = tmp_path / \"roundtrip.json\"\n485\t        data = {\"list\": [1, 2, 3], \"bool\": True, \"null\": None}\n486\t        write_json(p, data)\n487\t        assert read_json(p) == data\n488\t\n489\t\n490\t# ─── SSE Heartbeat ───\n491\t\n492\tclass TestSSEHeartbeat:\n493\t    def test_heartbeat_interval_is_configured(self):\n494\t        from server import SSE_HEARTBEAT_INTERVAL\n495\t        assert SSE_HEARTBEAT_INTERVAL == 30\n496\t\n497\t    def test_sse_stream_contains_heartbeat(self, client):\n498\t        \"\"\"Connect to SSE stream briefly and verify heartbeat comment frames.\"\"\"\n499\t        import httpx\n500\t        # Use a raw stream to capture the SSE data\n501\t        try:\n502\t            with client.stream(\"GET\", \"/api/logs/stream\", timeout=8) as r:\n503\t                assert r.status_code == 200\n504\t                assert \"text/event-stream\" in r.headers.get(\"content-type\", \"\")\n505\t                # Collect data for a few seconds\n506\t                data_chunks = []\n507\t                deadline = time.time() + 5\n508\t                for line in r.iter_lines():\n509\t                    data_chunks.append(line)\n510\t                    if time.time() > deadline:\n511\t                        break\n512\t                # After ~30s we'd see a heartbeat, but with 5s we just verify\n513\t                # the stream is alive and producing valid SSE frames\n514\t                assert len(data_chunks) >= 0  # Stream connected successfully\n515\t        except httpx.ReadTimeout:\n516\t            pass  # Expected — the stream is long-lived\n517\t"}]},"parent_tool_use_id":"call_68a66c34d34e446485460b0e","session_id":"a11b390c-8618-467f-b876-d1d624ad9195","uuid":"ede51e27-c453-4b4d-8b80-6264ab0e0efa","timestamp":"2026-05-21T05:05:12.840Z","subagent_type":"Explore","task_description":"Read loopcli_lib.py for review"}
