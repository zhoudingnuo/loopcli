{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_33944e6376994e01ba239d19","type":"tool_result","content":"1\timport argparse\n2\timport json\n3\timport os\n4\timport shutil\n5\timport subprocess\n6\timport sys\n7\timport threading\n8\timport time\n9\tfrom datetime import datetime\n10\t\n11\tLOOPCLI_DIR = r\"D:\\loopcli\"\n12\tSUBAGENT_DIR = os.path.join(LOOPCLI_DIR, \"subagent\")\n13\tCLAUDE = os.path.join(os.environ.get(\"APPDATA\", \"\"), \"npm\", \"claude.cmd\")\n14\t\n15\tAGENT_MARKER = \"AGENT\"\n16\tLOGS_DIR = os.path.join(LOOPCLI_DIR, \"logs\")\n17\tDEFAULT_PROMPT = \"\"\"读取 SOUL.md 作为你的身份。\n18\t读取 D:/loopcli/skill/ 下所有技能文件（全局技能）。\n19\t读取 memory/tasks.json 获取分配给你的任务。\n20\t\n21\t执行步骤：\n22\t1. 从 tasks.json 中找 status 为 \"pending\" 的第一个任务\n23\t2. 执行该任务\n24\t3. 将结果写入 memory/results/ 目录（以时间戳命名）\n25\t4. 将该任务 status 改为 \"done\"，写回 tasks.json\n26\t5. 更新 memory/state.json（标记完成、记录时间戳）\n27\t6. 将本次运行摘要追加到 log/run.md\n28\t7. 通过 inbox 通知 main：写入 D:/loopcli/main/inbox/<你的名字>_<时间>.md，简要报告任务结果\n29\t8. 如果没有 pending 任务，输出 \"IDLE\" 并结束本轮\n30\t\"\"\"\n31\t\n32\t\n33\t# ─── 工具函数 ───\n34\t\n35\tdef discover_agents():\n36\t    agents = []\n37\t    for name in os.listdir(LOOPCLI_DIR):\n38\t        path = os.path.join(LOOPCLI_DIR, name)\n39\t        marker = os.path.join(path, AGENT_MARKER)\n40\t        if os.path.isdir(path) and os.path.isfile(marker):\n41\t            agents.append({\"name\": name, \"path\": path})\n42\t    return agents\n43\t\n44\t\n45\tdef find_template(template_id):\n46\t    \"\"\"在 subagent 目录下搜索模板文件\"\"\"\n47\t    for dept in os.listdir(SUBAGENT_DIR):\n48\t        dept_dir = os.path.join(SUBAGENT_DIR, dept)\n49\t        if not os.path.isdir(dept_dir):\n50\t            continue\n51\t        candidate = os.path.join(dept_dir, f\"{template_id}.md\")\n52\t        if os.path.isfile(candidate):\n53\t            return candidate\n54\t    return None\n55\t\n56\t\n57\tdef load_agent_state(agent_path):\n58\t    state_file = os.path.join(agent_path, \"memory\", \"state.json\")\n59\t    if os.path.isfile(state_file):\n60\t        with open(state_file, \"r\", encoding=\"utf-8\") as f:\n61\t            return json.load(f)\n62\t    return None\n63\t\n64\t\n65\tdef load_agent_tasks(agent_path):\n66\t    tasks_file = os.path.join(agent_path, \"memory\", \"tasks.json\")\n67\t    if os.path.isfile(tasks_file):\n68\t        with open(tasks_file, \"r\", encoding=\"utf-8\") as f:\n69\t            return json.load(f)\n70\t    return []\n71\t\n72\t\n73\t# ─── 子命令: create ───\n74\t\n75\tdef cmd_create(args):\n76\t    template_id = args.template\n77\t    task_desc = args.task or \"\"\n78\t\n79\t    tpl_file = find_template(template_id)\n80\t    if not tpl_file:\n81\t        print(f\"[错误] 找不到模板: {template_id}\")\n82\t        print(\"用 loopcli templates 查看所有可用模板\")\n83\t        sys.exit(1)\n84\t\n85\t    with open(tpl_file, \"r\", encoding=\"utf-8\") as f:\n86\t        soul_content = f.read()\n87\t\n88\t    agent_dir = os.path.join(LOOPCLI_DIR, template_id)\n89\t    if os.path.exists(agent_dir):\n90\t        print(f\"[跳过] Agent 已存在: {agent_dir}\")\n91\t        if task_desc:\n92\t            cmd_task_inner(template_id, task_desc, \"\")\n93\t        return\n94\t\n95\t    # 创建目录结构\n96\t    os.makedirs(os.path.join(agent_dir, \"memory\", \"results\"), exist_ok=True)\n97\t    os.makedirs(os.path.join(agent_dir, \"log\"), exist_ok=True)\n98\t\n99\t    # AGENT 标记\n100\t    with open(os.path.join(agent_dir, AGENT_MARKER), \"w\", encoding=\"utf-8\") as f:\n101\t        f.write(\"type: main\\n\")\n102\t\n103\t    # SOUL.md（模板内容）\n104\t    with open(os.path.join(agent_dir, \"SOUL.md\"), \"w\", encoding=\"utf-8\") as f:\n105\t        f.write(soul_content)\n106\t\n107\t    # PROMPT.md\n108\t    with open(os.path.join(agent_dir, \"PROMPT.md\"), \"w\", encoding=\"utf-8\") as f:\n109\t        f.write(DEFAULT_PROMPT)\n110\t\n111\t    # state.json\n112\t    state = {\"agent\": template_id, \"status\": \"idle\", \"current_task\": None, \"last_run\": None, \"run_count\": 0, \"created\": datetime.now().strftime(\"%Y-%m-%d\")}\n113\t    with open(os.path.join(agent_dir, \"memory\", \"state.json\"), \"w\", encoding=\"utf-8\") as f:\n114\t        json.dump(state, f, indent=2, ensure_ascii=False)\n115\t\n116\t    # tasks.json\n117\t    tasks = []\n118\t    if task_desc:\n119\t        tasks.append({\"id\": 1, \"status\": \"pending\", \"title\": task_desc, \"description\": task_desc, \"created\": datetime.now().strftime(\"%Y-%m-%d\"), \"assignee\": template_id})\n120\t    with open(os.path.join(agent_dir, \"memory\", \"tasks.json\"), \"w\", encoding=\"utf-8\") as f:\n121\t        json.dump(tasks, f, indent=2, ensure_ascii=False)\n122\t\n123\t    # run.md\n124\t    with open(os.path.join(agent_dir, \"log\", \"run.md\"), \"w\", encoding=\"utf-8\") as f:\n125\t        f.write(\"# 运行日志\\n\\n| 时间 | 状态 | 任务 | 摘要 |\\n|------|------|------|------|\\n\")\n126\t\n127\t    print(f\"[创建成功] {template_id}\")\n128\t    print(f\"  目录: {agent_dir}\")\n129\t    if task_desc:\n130\t        print(f\"  任务: {task_desc}\")\n131\t    print(f\"  下一轮 loopcli 将自动启动该 Agent\")\n132\t\n133\t\n134\t# ─── 子命令: task ───\n135\t\n136\tdef cmd_task_inner(agent_name, title, desc):\n137\t    agent_dir = os.path.join(LOOPCLI_DIR, agent_name)\n138\t    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n139\t        print(f\"[错误] 不是有效的 Agent: {agent_name}\")\n140\t        sys.exit(1)\n141\t\n142\t    tasks_file = os.path.join(agent_dir, \"memory\", \"tasks.json\")\n143\t    tasks = load_agent_tasks(agent_dir)\n144\t    next_id = max((t[\"id\"] for t in tasks), default=0) + 1\n145\t    tasks.append({\n146\t        \"id\": next_id,\n147\t        \"status\": \"pending\",\n148\t        \"title\": title,\n149\t        \"description\": desc or title,\n150\t        \"created\": datetime.now().strftime(\"%Y-%m-%d\"),\n151\t        \"assignee\": agent_name\n152\t    })\n153\t    with open(tasks_file, \"w\", encoding=\"utf-8\") as f:\n154\t        json.dump(tasks, f, indent=2, ensure_ascii=False)\n155\t    print(f\"[派发成功] {agent_name} <- #{next_id} {title}\")\n156\t\n157\t\n158\tdef cmd_task(args):\n159\t    cmd_task_inner(args.agent, args.title, args.desc)\n160\t\n161\t\n162\t# ─── 子命令: list ───\n163\t\n164\tdef cmd_list(args):\n165\t    agents = discover_agents()\n166\t    if not agents:\n167\t        print(\"没有发现任何 Agent\")\n168\t        return\n169\t    print(f\"{'Agent':<45} {'状态':<10} {'任务数':<8} {'最后运行'}\")\n170\t    print(\"-\" * 85)\n171\t    for a in agents:\n172\t        state = load_agent_state(a[\"path\"]) or {}\n173\t        tasks = load_agent_tasks(a[\"path\"])\n174\t        pending = len([t for t in tasks if t.get(\"status\") == \"pending\"])\n175\t        status = state.get(\"status\", \"?\")\n176\t        last_run = state.get(\"last_run\", \"-\")\n177\t        print(f\"{a['name']:<45} {status:<10} {pending:<8} {last_run}\")\n178\t\n179\t\n180\t# ─── 子命令: templates ───\n181\t\n182\tdef cmd_templates(args):\n183\t    found = []\n184\t    for dept in sorted(os.listdir(SUBAGENT_DIR)):\n185\t        dept_dir = os.path.join(SUBAGENT_DIR, dept)\n186\t        if not os.path.isdir(dept_dir):\n187\t            continue\n188\t        for fname in sorted(os.listdir(dept_dir)):\n189\t            if fname.endswith(\".md\"):\n190\t                found.append(fname[:-3])\n191\t    if args.filter:\n192\t        found = [t for t in found if args.filter.lower() in t.lower()]\n193\t    print(f\"共 {len(found)} 个模板:\")\n194\t    for t in found:\n195\t        print(f\"  {t}\")\n196\t\n197\t\n198\t# ─── 子命令: run（主循环）───\n199\t\n200\tdef handle_event(agent_name, line):\n201\t    line = line.strip()\n202\t    if not line:\n203\t        return\n204\t    try:\n205\t        event = json.loads(line)\n206\t    except json.JSONDecodeError:\n207\t        print(f\"[{agent_name}] {line}\", flush=True)\n208\t        return\n209\t\n210\t    event_type = event.get(\"type\", \"\")\n211\t\n212\t    if event_type == \"assistant\":\n213\t        msg = event.get(\"message\", {})\n214\t        for block in msg.get(\"content\", []):\n215\t            if block.get(\"type\") == \"text\":\n216\t                text = block.get(\"text\", \"\")\n217\t                if text:\n218\t                    print(f\"[{agent_name}] {text}\", flush=True)\n219\t            elif block.get(\"type\") == \"tool_use\":\n220\t                name = block.get(\"name\", \"\")\n221\t                inp = block.get(\"input\", {})\n222\t                detail = \"\"\n223\t                for k in (\"file_path\", \"command\", \"pattern\"):\n224\t                    if k in inp:\n225\t                        detail = inp[k]\n226\t                        break\n227\t                print(f\"[{agent_name}] ● {name}({detail})\", flush=True)\n228\t\n229\t    elif event_type == \"tool_result\":\n230\t        content = event.get(\"content\", \"\")\n231\t        texts = []\n232\t        if isinstance(content, list):\n233\t            texts = [b.get(\"text\", \"\") for b in content if b.get(\"text\")]\n234\t        elif isinstance(content, str):\n235\t            texts = [content]\n236\t        for text in texts:\n237\t            print(f\"[{agent_name}]   ↳ {text[:200]}\", flush=True)\n238\t\n239\t    elif event_type == \"result\":\n240\t        text = event.get(\"result\", \"\")\n241\t        if text:\n242\t            print(f\"[{agent_name}] [结果] {text[:500]}\", flush=True)\n243\t        cost = event.get(\"cost_usd\", \"\")\n244\t        duration = event.get(\"duration_ms\", \"\")\n245\t        if cost or duration:\n246\t            print(f\"[{agent_name}] [统计] 耗时: {duration}ms, 费用: ${cost}\", flush=True)\n247\t\n248\t    elif event_type == \"error\":\n249\t        print(f\"[{agent_name}] [错误] {event.get('error', '')}\", flush=True)\n250\t\n251\t\n252\tdef run_agent(agent, iteration, run_log_dir):\n253\t    name = agent[\"name\"]\n254\t    path = agent[\"path\"]\n255\t    prompt_file = os.path.join(path, \"PROMPT.md\")\n256\t    log_file_path = os.path.join(path, \"log\", \"raw.log\")\n257\t    run_agent_log = os.path.join(run_log_dir, f\"{name}.log\")\n258\t    ts = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n259\t\n260\t    if not os.path.isfile(prompt_file):\n261\t        print(f\"[{name}] 没有 PROMPT.md，跳过\", flush=True)\n262\t        return\n263\t\n264\t    with open(prompt_file, \"r\", encoding=\"utf-8\") as f:\n265\t        prompt = f.read()\n266\t\n267\t    os.makedirs(os.path.join(path, \"log\"), exist_ok=True)\n268\t    log_file = open(log_file_path, \"a\", encoding=\"utf-8\")\n269\t    agent_log = open(run_agent_log, \"a\", encoding=\"utf-8\")\n270\t\n271\t    header = f\"\\n[{ts}] --- 开始 (第{iteration}轮) ---\\n\"\n272\t    log_file.write(header)\n273\t    agent_log.write(header)\n274\t    log_file.flush()\n275\t    agent_log.flush()\n276\t\n277\t    env = {**os.environ, \"IS_SANDBOX\": \"1\"}\n278\t\n279\t    proc = subprocess.Popen(\n280\t        f'\"{CLAUDE}\" --print --verbose --output-format stream-json --dangerously-skip-permissions',\n281\t        stdin=subprocess.PIPE,\n282\t        stdout=subprocess.PIPE,\n283\t        stderr=subprocess.PIPE,\n284\t        env=env,\n285\t        shell=True,\n286\t        cwd=path,\n287\t    )\n288\t\n289\t    proc.stdin.write(prompt.encode(\"utf-8\"))\n290\t    proc.stdin.close()\n291\t\n292\t    for line in proc.stdout:\n293\t        decoded = line.decode(\"utf-8\", errors=\"replace\")\n294\t        log_file.write(decoded)\n295\t        agent_log.write(decoded)\n296\t        log_file.flush()\n297\t        agent_log.flush()\n298\t        handle_event(name, decoded)\n299\t\n300\t    stderr_output = proc.stderr.read().decode(\"utf-8\", errors=\"replace\")\n301\t    if stderr_output:\n302\t        print(f\"[{name}] [STDERR] {stderr_output}\", flush=True)\n303\t        log_file.write(stderr_output)\n304\t        agent_log.write(stderr_output)\n305\t\n306\t    proc.wait()\n307\t\n308\t    footer = f\"\\n[{ts}] --- 结束 (exit={proc.returncode}) ---\\n\"\n309\t    log_file.write(footer)\n310\t    agent_log.write(footer)\n311\t    log_file.close()\n312\t    agent_log.close()\n313\t\n314\t    # 更新 state.json\n315\t    state_file = os.path.join(path, \"memory\", \"state.json\")\n316\t    state = load_agent_state(path) or {}\n317\t    state[\"status\"] = \"idle\"\n318\t    state[\"last_run\"] = ts\n319\t    state[\"run_count\"] = state.get(\"run_count\", 0) + 1\n320\t    with open(state_file, \"w\", encoding=\"utf-8\") as f:\n321\t        json.dump(state, f, indent=2, ensure_ascii=False)\n322\t\n323\t    status = \"完成\" if proc.returncode == 0 else f\"异常(exit={proc.returncode})\"\n324\t    print(f\"[{name}] 本轮{status}\", flush=True)\n325\t\n326\t\n327\tdef cmd_run(args):\n328\t    agents = discover_agents()\n329\t    if not agents:\n330\t        print(\"未发现任何 Agent（需要目录下有 AGENT 标记文件）\")\n331\t        sys.exit(1)\n332\t\n333\t    # 创建本次运行日志目录\n334\t    run_id = datetime.now().strftime(\"run_%Y%m%d_%H%M%S\")\n335\t    run_log_dir = os.path.join(LOGS_DIR, run_id)\n336\t    os.makedirs(run_log_dir, exist_ok=True)\n337\t\n338\t    # 写入运行元信息\n339\t    meta = {\n340\t        \"run_id\": run_id,\n341\t        \"started\": datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"),\n342\t        \"iterations\": args.iterations or \"无限\",\n343\t        \"agents\": [a[\"name\"] for a in agents],\n344\t    }\n345\t    with open(os.path.join(run_log_dir, \"meta.json\"), \"w\", encoding=\"utf-8\") as f:\n346\t        json.dump(meta, f, indent=2, ensure_ascii=False)\n347\t\n348\t    print(f\"运行 ID: {run_id}\")\n349\t    print(f\"日志目录: {run_log_dir}\")\n350\t    print(f\"发现 {len(agents)} 个 Agent: {', '.join(a['name'] for a in agents)}\")\n351\t\n352\t    count = 0\n353\t    while args.iterations == 0 or count < args.iterations:\n354\t        count += 1\n355\t        # 每轮重新扫描（可能有新 Agent）\n356\t        agents = discover_agents()\n357\t        ts = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n358\t        print(f\"\\n{'='*60}\")\n359\t        print(f\"[{ts}] 第 {count}{'/' + str(args.iterations) if args.iterations else ''} 轮 | {len(agents)} 个 Agent\")\n360\t        print(f\"{'='*60}\")\n361\t\n362\t        threads = []\n363\t        for agent in agents:\n364\t            print(f\"\\n--- 启动 [{agent['name']}] ---\", flush=True)\n365\t            t = threading.Thread(target=run_agent, args=(agent, count, run_log_dir))\n366\t            t.start()\n367\t            threads.append(t)\n368\t        for t in threads:\n369\t            t.join()\n370\t\n371\t    # 写入结束信息\n372\t    meta[\"finished\"] = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n373\t    meta[\"total_iterations\"] = count\n374\t    with open(os.path.join(run_log_dir, \"meta.json\"), \"w\", encoding=\"utf-8\") as f:\n375\t        json.dump(meta, f, indent=2, ensure_ascii=False)\n376\t\n377\t    print(f\"\\n运行结束，日志保存在: {run_log_dir}\")\n378\t\n379\t\n380\t# ─── CLI 入口 ───\n381\t\n382\tparser = argparse.ArgumentParser(description=\"LoopCLI — 多 Agent 自治系统\")\n383\tsub = parser.add_subparsers(dest=\"command\")\n384\t\n385\t# loopcli run [-n N]\n386\tp_run = sub.add_parser(\"run\", help=\"启动 Agent 循环（默认）\")\n387\tp_run.add_argument(\"-n\", \"--iterations\", type=int, default=0, help=\"迭代次数，0=无限\")\n388\t\n389\t# loopcli create <template> [--task TASK]\n390\tp_create = sub.add_parser(\"create\", help=\"从模板创建新 Agent\")\n391\tp_create.add_argument(\"template\", help=\"模板 ID，如 engineering-frontend-developer\")\n392\tp_create.add_argument(\"--task\", \"-t\", help=\"初始任务描述\")\n393\t\n394\t# loopcli task <agent> <title> [--desc DESC]\n395\tp_task = sub.add_parser(\"task\", help=\"给 Agent 派发任务\")\n396\tp_task.add_argument(\"agent\", help=\"Agent 目录名\")\n397\tp_task.add_argument(\"title\", help=\"任务标题\")\n398\tp_task.add_argument(\"--desc\", \"-d\", default=\"\", help=\"任务描述\")\n399\t\n400\t# loopcli list\n401\tsub.add_parser(\"list\", help=\"列出所有 Agent 及状态\")\n402\t\n403\t# loopcli templates [--filter X]\n404\tp_tpl = sub.add_parser(\"templates\", help=\"列出可用模板\")\n405\tp_tpl.add_argument(\"--filter\", \"-f\", default=\"\", help=\"按关键词筛选\")\n406\t\n407\t# 预处理：把裸数字参数（如 -n 5）转为 run 子命令\n408\tif sys.argv[1:] and sys.argv[1] not in (\"run\", \"create\", \"task\", \"list\", \"templates\", \"-h\", \"--help\"):\n409\t    sys.argv.insert(1, \"run\")\n410\t\n411\targs = parser.parse_args()\n412\t\n413\tif args.command == \"create\":\n414\t    cmd_create(args)\n415\telif args.command == \"task\":\n416\t    cmd_task(args)\n417\telif args.command == \"list\":\n418\t    cmd_list(args)\n419\telif args.command == \"templates\":\n420\t    cmd_templates(args)\n421\telse:\n422\t    # run 或无子命令\n423\t    if not hasattr(args, \"iterations\"):\n424\t        args.iterations = 0\n425\t    cmd_run(args)\n426\t"}]},"parent_tool_use_id":null,"session_id":"cbcc82b3-7ad3-4d83-9d9a-bbf17bd9a264","uuid":"ab4a8800-2a97-439e-a2fe-8f8e4280d1b9","timestamp":"2026-05-20T22:14:56.979Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\loopcli\\run.py","content":"import argparse\nimport json\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport threading\nimport time\nfrom datetime import datetime\n\nLOOPCLI_DIR = r\"D:\\loopcli\"\nSUBAGENT_DIR = os.path.join(LOOPCLI_DIR, \"subagent\")\nCLAUDE = os.path.join(os.environ.get(\"APPDATA\", \"\"), \"npm\", \"claude.cmd\")\n\nAGENT_MARKER = \"AGENT\"\nLOGS_DIR = os.path.join(LOOPCLI_DIR, \"logs\")\nDEFAULT_PROMPT = \"\"\"读取 SOUL.md 作为你的身份。\n读取 D:/loopcli/skill/ 下所有技能文件（全局技能）。\n读取 memory/tasks.json 获取分配给你的任务。\n\n执行步骤：\n1. 从 tasks.json 中找 status 为 \"pending\" 的第一个任务\n2. 执行该任务\n3. 将结果写入 memory/results/ 目录（以时间戳命名）\n4. 将该任务 status 改为 \"done\"，写回 tasks.json\n5. 更新 memory/state.json（标记完成、记录时间戳）\n6. 将本次运行摘要追加到 log/run.md\n7. 通过 inbox 通知 main：写入 D:/loopcli/main/inbox/<你的名字>_<时间>.md，简要报告任务结果\n8. 如果没有 pending 任务，输出 \"IDLE\" 并结束本轮\n\"\"\"\n\n\n# ─── 工具函数 ───\n\ndef discover_agents():\n    agents = []\n    for name in os.listdir(LOOPCLI_DIR):\n        path = os.path.join(LOOPCLI_DIR, name)\n        marker = os.path.join(path, AGENT_MARKER)\n        if os.path.isdir(path) and os.path.isfile(marker):\n            agents.append({\"name\": name, \"path\": path})\n    return agents\n\n\ndef find_template(template_id):\n    \"\"\"在 subagent 目录下搜索模板文件\"\"\"\n    for dept in os.listdir(SUBAGENT_DIR):\n        dept_dir = os.path.join(SUBAGENT_DIR, dept)\n        if not os.path.isdir(dept_dir):\n            continue\n        candidate = os.path.join(dept_dir, f\"{template_id}.md\")\n        if os.path.isfile(candidate):\n            return candidate\n    return None\n\n\ndef load_agent_state(agent_path):\n    state_file = os.path.join(agent_path, \"memory\", \"state.json\")\n    if os.path.isfile(state_file):\n        with open(state_file, \"r\", encoding=\"utf-8\") as f:\n            return json.load(f)\n    return None\n\n\ndef load_agent_tasks(agent_path):\n    tasks_file = os.path.join(agent_path, \"memory\", \"tasks.json\")\n    if os.path.isfile(tasks_file):\n        with open(tasks_file, \"r\", encoding=\"utf-8\") as f:\n            return json.load(f)\n    return []\n\n\n# ─── 子命令: create ───\n\ndef cmd_create(args):\n    template_id = args.template\n    task_desc = args.task or \"\"\n\n    tpl_file = find_template(template_id)\n    if not tpl_file:\n        print(f\"[错误] 找不到模板: {template_id}\")\n        print(\"用 loopcli templates 查看所有可用模板\")\n        sys.exit(1)\n\n    with open(tpl_file, \"r\", encoding=\"utf-8\") as f:\n        soul_content = f.read()\n\n    agent_dir = os.path.join(LOOPCLI_DIR, template_id)\n    if os.path.exists(agent_dir):\n        print(f\"[跳过] Agent 已存在: {agent_dir}\")\n        if task_desc:\n            cmd_task_inner(template_id, task_desc, \"\")\n        return\n\n    # 创建目录结构\n    os.makedirs(os.path.join(agent_dir, \"memory\", \"results\"), exist_ok=True)\n    os.makedirs(os.path.join(agent_dir, \"log\"), exist_ok=True)\n\n    # AGENT 标记\n    with open(os.path.join(agent_dir, AGENT_MARKER), \"w\", encoding=\"utf-8\") as f:\n        f.write(\"type: main\\n\")\n\n    # SOUL.md（模板内容）\n    with open(os.path.join(agent_dir, \"SOUL.md\"), \"w\", encoding=\"utf-8\") as f:\n        f.write(soul_content)\n\n    # PROMPT.md\n    with open(os.path.join(agent_dir, \"PROMPT.md\"), \"w\", encoding=\"utf-8\") as f:\n        f.write(DEFAULT_PROMPT)\n\n    # state.json\n    state = {\"agent\": template_id, \"status\": \"idle\", \"current_task\": None, \"last_run\": None, \"run_count\": 0, \"created\": datetime.now().strftime(\"%Y-%m-%d\")}\n    with open(os.path.join(agent_dir, \"memory\", \"state.json\"), \"w\", encoding=\"utf-8\") as f:\n        json.dump(state, f, indent=2, ensure_ascii=False)\n\n    # tasks.json\n    tasks = []\n    if task_desc:\n        tasks.append({\"id\": 1, \"status\": \"pending\", \"title\": task_desc, \"description\": task_desc, \"created\": datetime.now().strftime(\"%Y-%m-%d\"), \"assignee\": template_id})\n    with open(os.path.join(agent_dir, \"memory\", \"tasks.json\"), \"w\", encoding=\"utf-8\") as f:\n        json.dump(tasks, f, indent=2, ensure_ascii=False)\n\n    # run.md\n    with open(os.path.join(agent_dir, \"log\", \"run.md\"), \"w\", encoding=\"utf-8\") as f:\n        f.write(\"# 运行日志\\n\\n| 时间 | 状态 | 任务 | 摘要 |\\n|------|------|------|------|\\n\")\n\n    print(f\"[创建成功] {template_id}\")\n    print(f\"  目录: {agent_dir}\")\n    if task_desc:\n        print(f\"  任务: {task_desc}\")\n    print(f\"  下一轮 loopcli 将自动启动该 Agent\")\n\n\n# ─── 子命令: task ───\n\ndef cmd_task_inner(agent_name, title, desc):\n    agent_dir = os.path.join(LOOPCLI_DIR, agent_name)\n    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n        print(f\"[错误] 不是有效的 Agent: {agent_name}\")\n        sys.exit(1)\n\n    tasks_file = os.path.join(agent_dir, \"memory\", \"tasks.json\")\n    tasks = load_agent_tasks(agent_dir)\n    next_id = max((t[\"id\"] for t in tasks), default=0) + 1\n    tasks.append({\n        \"id\": next_id,\n        \"status\": \"pending\",\n        \"title\": title,\n        \"description\": desc or title,\n        \"created\": datetime.now().strftime(\"%Y-%m-%d\"),\n        \"assignee\": agent_name\n    })\n    with open(tasks_file, \"w\", encoding=\"utf-8\") as f:\n        json.dump(tasks, f, indent=2, ensure_ascii=False)\n    print(f\"[派发成功] {agent_name} <- #{next_id} {title}\")\n\n\ndef cmd_task(args):\n    cmd_task_inner(args.agent, args.title, args.desc)\n\n\n# ─── 子命令: list ───\n\ndef cmd_list(args):\n    agents = discover_agents()\n    if not agents:\n        print(\"没有发现任何 Agent\")\n        return\n    print(f\"{'Agent':<45} {'状态':<10} {'任务数':<8} {'最后运行'}\")\n    print(\"-\" * 85)\n    for a in agents:\n        state = load_agent_state(a[\"path\"]) or {}\n        tasks = load_agent_tasks(a[\"path\"])\n        pending = len([t for t in tasks if t.get(\"status\") == \"pending\"])\n        status = state.get(\"status\", \"?\")\n        last_run = state.get(\"last_run\", \"-\")\n        print(f\"{a['name']:<45} {status:<10} {pending:<8} {last_run}\")\n\n\n# ─── 子命令: templates ───\n\ndef cmd_templates(args):\n    found = []\n    for dept in sorted(os.listdir(SUBAGENT_DIR)):\n        dept_dir = os.path.join(SUBAGENT_DIR, dept)\n        if not os.path.isdir(dept_dir):\n            continue\n        for fname in sorted(os.listdir(dept_dir)):\n            if fname.endswith(\".md\"):\n                found.append(fname[:-3])\n    if args.filter:\n        found = [t for t in found if args.filter.lower() in t.lower()]\n    print(f\"共 {len(found)} 个模板:\")\n    for t in found:\n        print(f\"  {t}\")\n\n\n# ─── 子命令: run（主循环）───\n\ndef handle_event(agent_name, line):\n    line = line.strip()\n    if not line:\n        return\n    try:\n        event = json.loads(line)\n    except json.JSONDecodeError:\n        print(f\"[{agent_name}] {line}\", flush=True)\n        return\n\n    event_type = event.get(\"type\", \"\")\n\n    if event_type == \"assistant\":\n        msg = event.get(\"message\", {})\n        for block in msg.get(\"content\", []):\n            if block.get(\"type\") == \"text\":\n                text = block.get(\"text\", \"\")\n                if text:\n                    print(f\"[{agent_name}] {text}\", flush=True)\n            elif block.get(\"type\") == \"tool_use\":\n                name = block.get(\"name\", \"\")\n                inp = block.get(\"input\", {})\n                detail = \"\"\n                for k in (\"file_path\", \"command\", \"pattern\"):\n                    if k in inp:\n                        detail = inp[k]\n                        break\n                print(f\"[{agent_name}] ● {name}({detail})\", flush=True)\n\n    elif event_type == \"tool_result\":\n        content = event.get(\"content\", \"\")\n        texts = []\n        if isinstance(content, list):\n            texts = [b.get(\"text\", \"\") for b in content if b.get(\"text\")]\n        elif isinstance(content, str):\n            texts = [content]\n        for text in texts:\n            print(f\"[{agent_name}]   ↳ {text[:200]}\", flush=True)\n\n    elif event_type == \"result\":\n        text = event.get(\"result\", \"\")\n        if text:\n            print(f\"[{agent_name}] [结果] {text[:500]}\", flush=True)\n        cost = event.get(\"cost_usd\", \"\")\n        duration = event.get(\"duration_ms\", \"\")\n        if cost or duration:\n            print(f\"[{agent_name}] [统计] 耗时: {duration}ms, 费用: ${cost}\", flush=True)\n\n    elif event_type == \"error\":\n        print(f\"[{agent_name}] [错误] {event.get('error', '')}\", flush=True)\n\n\ndef run_agent(agent, iteration, run_log_dir):\n    name = agent[\"name\"]\n    path = agent[\"path\"]\n    prompt_file = os.path.join(path, \"PROMPT.md\")\n    log_file_path = os.path.join(path, \"log\", \"raw.log\")\n    run_agent_log = os.path.join(run_log_dir, f\"{name}.log\")\n    ts = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n\n    if not os.path.isfile(prompt_file):\n        print(f\"[{name}] 没有 PROMPT.md，跳过\", flush=True)\n        return\n\n    with open(prompt_file, \"r\", encoding=\"utf-8\") as f:\n        prompt = f.read()\n\n    os.makedirs(os.path.join(path, \"log\"), exist_ok=True)\n    log_file = open(log_file_path, \"a\", encoding=\"utf-8\")\n    agent_log = open(run_agent_log, \"a\", encoding=\"utf-8\")\n\n    header = f\"\\n[{ts}] --- 开始 (第{iteration}轮) ---\\n\"\n    log_file.write(header)\n    agent_log.write(header)\n    log_file.flush()\n    agent_log.flush()\n\n    env = {**os.environ, \"IS_SANDBOX\": \"1\"}\n\n    proc = subprocess.Popen(\n        f'\"{CLAUDE}\" --print --verbose --output-format stream-json --dangerously-skip-permissions',\n        stdin=subprocess.PIPE,\n        stdout=subprocess.PIPE,\n        stderr=subprocess.PIPE,\n        env=env,\n        shell=True,\n        cwd=path,\n    )\n\n    proc.stdin.write(prompt.encode(\"utf-8\"))\n    proc.stdin.close()\n\n    for line in proc.stdout:\n        decoded = line.decode(\"utf-8\", errors=\"replace\")\n        log_file.write(decoded)\n        agent_log.write(decoded)\n        log_file.flush()\n        agent_log.flush()\n        handle_event(name, decoded)\n\n    stderr_output = proc.stderr.read().decode(\"utf-8\", errors=\"replace\")\n    if stderr_output:\n        print(f\"[{name}] [STDERR] {stderr_output}\", flush=True)\n        log_file.write(stderr_output)\n        agent_log.write(stderr_output)\n\n    proc.wait()\n\n    footer = f\"\\n[{ts}] --- 结束 (exit={proc.returncode}) ---\\n\"\n    log_file.write(footer)\n    agent_log.write(footer)\n    log_file.close()\n    agent_log.close()\n\n    # 更新 state.json\n    state_file = os.path.join(path, \"memory\", \"state.json\")\n    state = load_agent_state(path) or {}\n    state[\"status\"] = \"idle\"\n    state[\"last_run\"] = ts\n    state[\"run_count\"] = state.get(\"run_count\", 0) + 1\n    with open(state_file, \"w\", encoding=\"utf-8\") as f:\n        json.dump(state, f, indent=2, ensure_ascii=False)\n\n    status = \"完成\" if proc.returncode == 0 else f\"异常(exit={proc.returncode})\"\n    print(f\"[{name}] 本轮{status}\", flush=True)\n\n\ndef cmd_run(args):\n    agents = discover_agents()\n    if not agents:\n        print(\"未发现任何 Agent（需要目录下有 AGENT 标记文件）\")\n        sys.exit(1)\n\n    # 创建本次运行日志目录\n    run_id = datetime.now().strftime(\"run_%Y%m%d_%H%M%S\")\n    run_log_dir = os.path.join(LOGS_DIR, run_id)\n    os.makedirs(run_log_dir, exist_ok=True)\n\n    # 写入运行元信息\n    meta = {\n        \"run_id\": run_id,\n        \"started\": datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"),\n        \"iterations\": args.iterations or \"无限\",\n        \"agents\": [a[\"name\"] for a in agents],\n    }\n    with open(os.path.join(run_log_dir, \"meta.json\"), \"w\", encoding=\"utf-8\") as f:\n        json.dump(meta, f, indent=2, ensure_ascii=False)\n\n    print(f\"运行 ID: {run_id}\")\n    print(f\"日志目录: {run_log_dir}\")\n    print(f\"发现 {len(agents)} 个 Agent: {', '.join(a['name'] for a in agents)}\")\n\n    count = 0\n    while args.iterations == 0 or count < args.iterations:\n        count += 1\n        # 每轮重新扫描（可能有新 Agent）\n        agents = discover_agents()\n        ts = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n        print(f\"\\n{'='*60}\")\n        print(f\"[{ts}] 第 {count}{'/' + str(args.iterations) if args.iterations else ''} 轮 | {len(agents)} 个 Agent\")\n        print(f\"{'='*60}\")\n\n        threads = []\n        for agent in agents:\n            print(f\"\\n--- 启动 [{agent['name']}] ---\", flush=True)\n            t = threading.Thread(target=run_agent, args=(agent, count, run_log_dir))\n            t.start()\n            threads.append(t)\n        for t in threads:\n            t.join()\n\n    # 写入结束信息\n    meta[\"finished\"] = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n    meta[\"total_iterations\"] = count\n    with open(os.path.join(run_log_dir, \"meta.json\"), \"w\", encoding=\"utf-8\") as f:\n        json.dump(meta, f, indent=2, ensure_ascii=False)\n\n    print(f\"\\n运行结束，日志保存在: {run_log_dir}\")\n\n\n# ─── CLI 入口 ───\n\nparser = argparse.ArgumentParser(description=\"LoopCLI — 多 Agent 自治系统\")\nsub = parser.add_subparsers(dest=\"command\")\n\n# loopcli run [-n N]\np_run = sub.add_parser(\"run\", help=\"启动 Agent 循环（默认）\")\np_run.add_argument(\"-n\", \"--iterations\", type=int, default=0, help=\"迭代次数，0=无限\")\n\n# loopcli create <template> [--task TASK]\np_create = sub.add_parser(\"create\", help=\"从模板创建新 Agent\")\np_create.add_argument(\"template\", help=\"模板 ID，如 engineering-frontend-developer\")\np_create.add_argument(\"--task\", \"-t\", help=\"初始任务描述\")\n\n# loopcli task <agent> <title> [--desc DESC]\np_task = sub.add_parser(\"task\", help=\"给 Agent 派发任务\")\np_task.add_argument(\"agent\", help=\"Agent 目录名\")\np_task.add_argument(\"title\", help=\"任务标题\")\np_task.add_argument(\"--desc\", \"-d\", default=\"\", help=\"任务描述\")\n\n# loopcli list\nsub.add_parser(\"list\", help=\"列出所有 Agent 及状态\")\n\n# loopcli templates [--filter X]\np_tpl = sub.add_parser(\"templates\", help=\"列出可用模板\")\np_tpl.add_argument(\"--filter\", \"-f\", default=\"\", help=\"按关键词筛选\")\n\n# 预处理：把裸数字参数（如 -n 5）转为 run 子命令\nif sys.argv[1:] and sys.argv[1] not in (\"run\", \"create\", \"task\", \"list\", \"templates\", \"-h\", \"--help\"):\n    sys.argv.insert(1, \"run\")\n\nargs = parser.parse_args()\n\nif args.command == \"create\":\n    cmd_create(args)\nelif args.command == \"task\":\n    cmd_task(args)\nelif args.command == \"list\":\n    cmd_list(args)\nelif args.command == \"templates\":\n    cmd_templates(args)\nelse:\n    # run 或无子命令\n    if not hasattr(args, \"iterations\"):\n        args.iterations = 0\n    cmd_run(args)\n","numLines":426,"startLine":1,"totalLines":426}}}
