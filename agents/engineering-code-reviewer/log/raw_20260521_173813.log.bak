{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a96ece9cdb334f79808d1ff1","type":"tool_result","content":"1\timport argparse\n2\timport json\n3\timport msvcrt\n4\timport os\n5\timport shutil\n6\timport subprocess\n7\timport sys\n8\timport threading\n9\timport time\n10\tfrom datetime import datetime\n11\tfrom pathlib import Path\n12\t\n13\tsys.path.insert(0, str(Path(__file__).resolve().parent / \"main\" / \"webui\"))\n14\tfrom loopcli_lib import (\n15\t    LOOPCLI_ROOT,\n16\t    AGENT_MARKER,\n17\t    read_json,\n18\t    write_json,\n19\t    safe_agent_path,\n20\t    get_agent_marker,\n21\t    is_agent_enabled,\n22\t    discover_agents as _discover_agents,\n23\t    create_task,\n24\t    write_inbox_message,\n25\t    set_agent_enabled,\n26\t)\n27\t\n28\tLOOPCLI_DIR = str(LOOPCLI_ROOT)\n29\tSUBAGENT_DIR = os.path.join(LOOPCLI_DIR, \"subagent\")\n30\tCLAUDE = os.path.join(os.environ.get(\"APPDATA\", \"\"), \"npm\", \"claude.cmd\")\n31\t\n32\tLOGS_DIR = os.path.join(LOOPCLI_DIR, \"logs\")\n33\tGIT_TOKEN_FILE = os.path.join(LOOPCLI_DIR, \".gittoken\")\n34\tDEFAULT_PROMPT = \"\"\"读取 SOUL.md 作为你的身份。\n35\t读取 D:/loopcli/skill/ 下所有技能文件（全局技能）。\n36\t读取 memory/tasks.json 获取分配给你的任务。\n37\t\n38\t执行步骤：\n39\t1. 从 tasks.json 中找 status 为 \"pending\" 的第一个任务\n40\t2. 执行该任务\n41\t3. 将结果写入 memory/results/ 目录（以时间戳命名）\n42\t4. 将该任务 status 改为 \"done\"，写回 tasks.json\n43\t5. 更新 memory/state.json（标记完成、记录时间戳）\n44\t6. 将本次运行摘要追加到 log/run.md\n45\t7. 通过 inbox 通知 main：写入 D:/loopcli/main/inbox/<你的名字>_<时间>.md，简要报告任务结果\n46\t8. 如果没有 pending 任务，输出 \"IDLE\" 并结束本轮\n47\t\"\"\"\n48\t\n49\t\n50\t# ─── 工具函数 ───\n51\t\n52\tdef discover_agents(include_disabled=False):\n53\t    \"\"\"Wrapper that returns same format as before (name+path strings).\"\"\"\n54\t    return _discover_agents(include_disabled=include_disabled)\n55\t\n56\t\n57\tdef find_template(template_id):\n58\t    \"\"\"在 subagent 目录下搜索模板文件\"\"\"\n59\t    for dept in os.listdir(SUBAGENT_DIR):\n60\t        dept_dir = os.path.join(SUBAGENT_DIR, dept)\n61\t        if not os.path.isdir(dept_dir):\n62\t            continue\n63\t        candidate = os.path.join(dept_dir, f\"{template_id}.md\")\n64\t        if os.path.isfile(candidate):\n65\t            return candidate\n66\t    return None\n67\t\n68\t\n69\tdef load_agent_state(agent_path):\n70\t    state_file = os.path.join(agent_path, \"memory\", \"state.json\")\n71\t    if os.path.isfile(state_file):\n72\t        return read_json(state_file)\n73\t    return None\n74\t\n75\t\n76\tdef load_agent_tasks(agent_path):\n77\t    tasks_file = os.path.join(agent_path, \"memory\", \"tasks.json\")\n78\t    if os.path.isfile(tasks_file):\n79\t        return read_json(tasks_file, [])\n80\t    return []\n81\t\n82\t\n83\tdef rotate_log(log_path, max_size=1_000_000, max_backups=3):\n84\t    \"\"\"轮转日志文件：超过 max_size 时依次重命名为 .1 .2 .3，最多保留 max_backups 个归档\"\"\"\n85\t    if not os.path.isfile(log_path):\n86\t        return\n87\t    try:\n88\t        if os.path.getsize(log_path) < max_size:\n89\t            return\n90\t    except OSError:\n91\t        return\n92\t    oldest = f\"{log_path}.{max_backups}\"\n93\t    if os.path.isfile(oldest):\n94\t        os.remove(oldest)\n95\t    for i in range(max_backups, 1, -1):\n96\t        src = f\"{log_path}.{i - 1}\"\n97\t        dst = f\"{log_path}.{i}\"\n98\t        if os.path.isfile(src):\n99\t            os.rename(src, dst)\n100\t    os.rename(log_path, f\"{log_path}.1\")\n101\t\n102\t\n103\t# ─── 子命令: create ───\n104\t\n105\tdef cmd_create(args):\n106\t    template_id = args.template\n107\t    task_desc = args.task or \"\"\n108\t\n109\t    tpl_file = find_template(template_id)\n110\t    if not tpl_file:\n111\t        print(f\"[错误] 找不到模板: {template_id}\")\n112\t        print(\"用 loopcli templates 查看所有可用模板\")\n113\t        sys.exit(1)\n114\t\n115\t    with open(tpl_file, \"r\", encoding=\"utf-8\") as f:\n116\t        soul_content = f.read()\n117\t\n118\t    agent_dir = os.path.join(LOOPCLI_DIR, template_id)\n119\t    if os.path.exists(agent_dir):\n120\t        print(f\"[跳过] Agent 已存在: {agent_dir}\")\n121\t        if task_desc:\n122\t            cmd_task_inner(template_id, task_desc, \"\")\n123\t        return\n124\t\n125\t    os.makedirs(os.path.join(agent_dir, \"memory\", \"results\"), exist_ok=True)\n126\t    os.makedirs(os.path.join(agent_dir, \"log\"), exist_ok=True)\n127\t\n128\t    with open(os.path.join(agent_dir, AGENT_MARKER), \"w\", encoding=\"utf-8\") as f:\n129\t        f.write(\"type: main\\n\")\n130\t\n131\t    with open(os.path.join(agent_dir, \"SOUL.md\"), \"w\", encoding=\"utf-8\") as f:\n132\t        f.write(soul_content)\n133\t\n134\t    with open(os.path.join(agent_dir, \"PROMPT.md\"), \"w\", encoding=\"utf-8\") as f:\n135\t        f.write(DEFAULT_PROMPT)\n136\t\n137\t    state = {\"agent\": template_id, \"status\": \"idle\", \"current_task\": None, \"last_run\": None, \"run_count\": 0, \"created\": datetime.now().strftime(\"%Y-%m-%d\")}\n138\t    write_json(os.path.join(agent_dir, \"memory\", \"state.json\"), state)\n139\t\n140\t    tasks = []\n141\t    if task_desc:\n142\t        tasks.append({\"id\": 1, \"status\": \"pending\", \"title\": task_desc, \"description\": task_desc, \"created\": datetime.now().strftime(\"%Y-%m-%d\"), \"assignee\": template_id})\n143\t    write_json(os.path.join(agent_dir, \"memory\", \"tasks.json\"), tasks)\n144\t\n145\t    with open(os.path.join(agent_dir, \"log\", \"run.md\"), \"w\", encoding=\"utf-8\") as f:\n146\t        f.write(\"# 运行日志\\n\\n| 时间 | 状态 | 任务 | 摘要 |\\n|------|------|------|------|\\n\")\n147\t\n148\t    print(f\"[创建成功] {template_id}\")\n149\t    print(f\"  目录: {agent_dir}\")\n150\t    if task_desc:\n151\t        print(f\"  任务: {task_desc}\")\n152\t    print(f\"  下一轮 loopcli 将自动启动该 Agent\")\n153\t\n154\t\n155\t# ─── 子命令: task ───\n156\t\n157\tdef cmd_task_inner(agent_name, title, desc):\n158\t    agent_dir = os.path.join(LOOPCLI_DIR, agent_name)\n159\t    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n160\t        print(f\"[错误] 不是有效的 Agent: {agent_name}\")\n161\t        sys.exit(1)\n162\t\n163\t    task = create_task(\n164\t        agent_dir, title,\n165\t        description=desc or title,\n166\t        assignee=agent_name,\n167\t        created=datetime.now().strftime(\"%Y-%m-%d\"),\n168\t    )\n169\t    print(f\"[派发成功] {agent_name} <- #{task['id']} {title}\")\n170\t\n171\t\n172\tdef cmd_task(args):\n173\t    cmd_task_inner(args.agent, args.title, args.desc)\n174\t\n175\t\n176\t# ─── 子命令: list ───\n177\t\n178\tdef cmd_list(args):\n179\t    agents = discover_agents(include_disabled=True)\n180\t    if not agents:\n181\t        print(\"没有发现任何 Agent\")\n182\t        return\n183\t    print(f\"{'Agent':<45} {'启用':<6} {'状态':<10} {'任务数':<8} {'最后运行'}\")\n184\t    print(\"-\" * 95)\n185\t    for a in agents:\n186\t        enabled = \"是\" if is_agent_enabled(a[\"path\"]) else \"否\"\n187\t        state = load_agent_state(a[\"path\"]) or {}\n188\t        tasks = load_agent_tasks(a[\"path\"])\n189\t        pending = len([t for t in tasks if t.get(\"status\") == \"pending\"])\n190\t        status = state.get(\"status\", \"?\")\n191\t        last_run = state.get(\"last_run\", \"-\")\n192\t        print(f\"{a['name']:<45} {enabled:<6} {status:<10} {pending:<8} {last_run}\")\n193\t\n194\t\n195\t# ─── 子命令: templates ───\n196\t\n197\tdef cmd_templates(args):\n198\t    found = []\n199\t    for dept in sorted(os.listdir(SUBAGENT_DIR)):\n200\t        dept_dir = os.path.join(SUBAGENT_DIR, dept)\n201\t        if not os.path.isdir(dept_dir):\n202\t            continue\n203\t        for fname in sorted(os.listdir(dept_dir)):\n204\t            if fname.endswith(\".md\"):\n205\t                found.append(fname[:-3])\n206\t    if args.filter:\n207\t        found = [t for t in found if args.filter.lower() in t.lower()]\n208\t    print(f\"共 {len(found)} 个模板:\")\n209\t    for t in found:\n210\t        print(f\"  {t}\")\n211\t\n212\t\n213\t# ─── 子命令: run（主循环）───\n214\t\n215\tdef handle_event(agent_name, line):\n216\t    line = line.strip()\n217\t    if not line:\n218\t        return\n219\t    try:\n220\t        event = json.loads(line)\n221\t    except json.JSONDecodeError:\n222\t        print(f\"[{agent_name}] {line}\", flush=True)\n223\t        return\n224\t\n225\t    event_type = event.get(\"type\", \"\")\n226\t\n227\t    if event_type == \"assistant\":\n228\t        msg = event.get(\"message\", {})\n229\t        for block in msg.get(\"content\", []):\n230\t            if block.get(\"type\") == \"text\":\n231\t                text = block.get(\"text\", \"\")\n232\t                if text:\n233\t                    print(f\"[{agent_name}] {text}\", flush=True)\n234\t            elif block.get(\"type\") == \"tool_use\":\n235\t                name = block.get(\"name\", \"\")\n236\t                inp = block.get(\"input\", {})\n237\t                detail = \"\"\n238\t                for k in (\"file_path\", \"command\", \"pattern\"):\n239\t                    if k in inp:\n240\t                        detail = inp[k]\n241\t                        break\n242\t                print(f\"[{agent_name}] ● {name}({detail})\", flush=True)\n243\t\n244\t    elif event_type == \"tool_result\":\n245\t        content = event.get(\"content\", \"\")\n246\t        texts = []\n247\t        if isinstance(content, list):\n248\t            texts = [b.get(\"text\", \"\") for b in content if b.get(\"text\")]\n249\t        elif isinstance(content, str):\n250\t            texts = [content]\n251\t        for text in texts:\n252\t            print(f\"[{agent_name}]   ↳ {text[:200]}\", flush=True)\n253\t\n254\t    elif event_type == \"result\":\n255\t        text = event.get(\"result\", \"\")\n256\t        if text:\n257\t            print(f\"[{agent_name}] [结果] {text[:500]}\", flush=True)\n258\t        cost = event.get(\"cost_usd\", \"\")\n259\t        duration = event.get(\"duration_ms\", \"\")\n260\t        if cost or duration:\n261\t            print(f\"[{agent_name}] [统计] 耗时: {duration}ms, 费用: ${cost}\", flush=True)\n262\t\n263\t    elif event_type == \"error\":\n264\t        print(f\"[{agent_name}] [错误] {event.get('error', '')}\", flush=True)\n265\t\n266\t\n267\tdef run_agent(agent, iteration, run_log_dir):\n268\t    name = agent[\"name\"]\n269\t    path = agent[\"path\"]\n270\t    prompt_file = os.path.join(path, \"PROMPT.md\")\n271\t    log_file_path = os.path.join(path, \"log\", \"raw.log\")\n272\t    run_agent_log = os.path.join(run_log_dir, f\"{name}.log\")\n273\t    ts = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n274\t\n275\t    if not os.path.isfile(prompt_file):\n276\t        print(f\"[{name}] 没有 PROMPT.md，跳过\", flush=True)\n277\t        return\n278\t\n279\t    with open(prompt_file, \"r\", encoding=\"utf-8\") as f:\n280\t        prompt = f.read()\n281\t\n282\t    os.makedirs(os.path.join(path, \"log\"), exist_ok=True)\n283\t    rotate_log(log_file_path)\n284\t    log_file = open(log_file_path, \"a\", encoding=\"utf-8\")\n285\t    agent_log = open(run_agent_log, \"a\", encoding=\"utf-8\")\n286\t\n287\t    try:\n288\t        header = f\"\\n[{ts}] --- 开始 (第{iteration}轮) ---\\n\"\n289\t        log_file.write(header)\n290\t        agent_log.write(header)\n291\t        log_file.flush()\n292\t        agent_log.flush()\n293\t\n294\t        env = {**os.environ, \"IS_SANDBOX\": \"1\"}\n295\t\n296\t        proc = subprocess.Popen(\n297\t            [CLAUDE, \"--print\", \"--verbose\", \"--output-format\", \"stream-json\", \"--dangerously-skip-permissions\"],\n298\t            stdin=subprocess.PIPE,\n299\t            stdout=subprocess.PIPE,\n300\t            stderr=subprocess.PIPE,\n301\t            env=env,\n302\t            cwd=path,\n303\t        )\n304\t\n305\t        proc.stdin.write(prompt.encode(\"utf-8\"))\n306\t        proc.stdin.close()\n307\t\n308\t        for line in proc.stdout:\n309\t            decoded = line.decode(\"utf-8\", errors=\"replace\")\n310\t            log_file.write(decoded)\n311\t            agent_log.write(decoded)\n312\t            log_file.flush()\n313\t            agent_log.flush()\n314\t            handle_event(name, decoded)\n315\t\n316\t        stderr_output = proc.stderr.read().decode(\"utf-8\", errors=\"replace\")\n317\t        if stderr_output:\n318\t            print(f\"[{name}] [STDERR] {stderr_output}\", flush=True)\n319\t            log_file.write(stderr_output)\n320\t            agent_log.write(stderr_output)\n321\t\n322\t        proc.wait()\n323\t\n324\t        footer = f\"\\n[{ts}] --- 结束 (exit={proc.returncode}) ---\\n\"\n325\t        log_file.write(footer)\n326\t        agent_log.write(footer)\n327\t    finally:\n328\t        log_file.close()\n329\t        agent_log.close()\n330\t\n331\t    # 更新 state.json (with file lock)\n332\t    state_file = os.path.join(path, \"memory\", \"state.json\")\n333\t    with open(state_file, \"a+\") as f:\n334\t        msvcrt.locking(f.fileno(), msvcrt.LK_LOCK, 1)\n335\t        try:\n336\t            f.seek(0)\n337\t            try:\n338\t                state = json.load(f)\n339\t            except (json.JSONDecodeError, ValueError):\n340\t                state = {}\n341\t            state[\"status\"] = \"idle\"\n342\t            state[\"last_run\"] = ts\n343\t            state[\"run_count\"] = state.get(\"run_count\", 0) + 1\n344\t            f.seek(0)\n345\t            f.truncate()\n346\t            json.dump(state, f, indent=2, ensure_ascii=False)\n347\t        finally:\n348\t            msvcrt.locking(f.fileno(), msvcrt.LK_UNLCK, 1)\n349\t\n350\t    status = \"完成\" if proc.returncode == 0 else f\"异常(exit={proc.returncode})\"\n351\t    print(f\"[{name}] 本轮{status}\", flush=True)\n352\t\n353\t\n354\tdef git_push():\n355\t    \"\"\"自动 commit 和 push 到 GitHub\"\"\"\n356\t    token_file = GIT_TOKEN_FILE\n357\t    if not os.path.isfile(token_file):\n358\t        return\n359\t    with open(token_file, \"r\") as f:\n360\t        token = f.read().strip()\n361\t    if not token:\n362\t        return\n363\t    try:\n364\t        git = resolve_git()\n365\t        subprocess.run([git, \"add\", \"memory/\", \"log/\", \"inbox/\"], cwd=LOOPCLI_DIR, capture_output=True, timeout=30)\n366\t        subprocess.run(\n367\t            [git, \"commit\", \"-m\", f\"auto: loopcli sync {datetime.now().strftime('%Y-%m-%d %H:%M')}\"],\n368\t            cwd=LOOPCLI_DIR, capture_output=True, timeout=30\n369\t        )\n370\t        askpass_script = os.path.join(LOOPCLI_DIR, \".git_askpass.bat\")\n371\t        with open(askpass_script, \"w\") as f:\n372\t            f.write(\"@echo %GH_TOKEN%\\n\")\n373\t        push_env = {\n374\t            **os.environ,\n375\t            \"GH_TOKEN\": token,\n376\t            \"GIT_ASKPASS\": askpass_script,\n377\t            \"GIT_TERMINAL_PROMPT\": \"0\",\n378\t        }\n379\t        subprocess.run(\n380\t            [git, \"push\", \"https://x-access-token@github.com/zhoudingnuo/loopcli.git\", \"main\"],\n381\t            cwd=LOOPCLI_DIR, capture_output=True, timeout=60, env=push_env,\n382\t        )\n383\t        os.remove(askpass_script)\n384\t        print(\"[git] 已同步到 GitHub\", flush=True)\n385\t    except Exception as e:\n386\t        print(f\"[git] 同步失败: {e}\", flush=True)\n387\t\n388\t\n389\tdef resolve_git():\n390\t    \"\"\"找到 git.exe 的完整路径\"\"\"\n391\t    for p in os.environ.get(\"PATH\", \"\").split(\";\"):\n392\t        candidate = os.path.join(p, \"git.exe\")\n393\t        if os.path.isfile(candidate):\n394\t            return candidate\n395\t    for d in [r\"C:\\Program Files\\Git\\cmd\", r\"C:\\Program Files\\Git\\bin\"]:\n396\t        candidate = os.path.join(d, \"git.exe\")\n397\t        if os.path.isfile(candidate):\n398\t            return candidate\n399\t    return \"git\"\n400\t\n401\t\n402\tdef cmd_run(args):\n403\t    agents = discover_agents()\n404\t    if not agents:\n405\t        print(\"未发现任何 Agent（需要目录下有 AGENT 标记文件）\")\n406\t        sys.exit(1)\n407\t\n408\t    run_id = datetime.now().strftime(\"run_%Y%m%d_%H%M%S\")\n409\t    run_log_dir = os.path.join(LOGS_DIR, run_id)\n410\t    os.makedirs(run_log_dir, exist_ok=True)\n411\t\n412\t    meta = {\n413\t        \"run_id\": run_id,\n414\t        \"started\": datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"),\n415\t        \"iterations\": args.iterations or \"无限\",\n416\t        \"agents\": [a[\"name\"] for a in agents],\n417\t    }\n418\t    write_json(os.path.join(run_log_dir, \"meta.json\"), meta)\n419\t\n420\t    print(f\"运行 ID: {run_id}\")\n421\t    print(f\"日志目录: {run_log_dir}\")\n422\t    print(f\"发现 {len(agents)} 个 Agent: {', '.join(a['name'] for a in agents)}\")\n423\t\n424\t    count = 0\n425\t    while args.iterations == 0 or count < args.iterations:\n426\t        count += 1\n427\t        agents = discover_agents()\n428\t        ts = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n429\t        print(f\"\\n{'='*60}\")\n430\t        print(f\"[{ts}] 第 {count}{'/' + str(args.iterations) if args.iterations else ''} 轮 | {len(agents)} 个 Agent\")\n431\t        print(f\"{'='*60}\")\n432\t\n433\t        threads = []\n434\t        for agent in agents:\n435\t            print(f\"\\n--- 启动 [{agent['name']}] ---\", flush=True)\n436\t            t = threading.Thread(target=run_agent, args=(agent, count, run_log_dir))\n437\t            t.start()\n438\t            threads.append(t)\n439\t        for t in threads:\n440\t            t.join()\n441\t\n442\t        git_push()\n443\t\n444\t        if args.iterations == 0 or count < args.iterations:\n445\t            print(f\"\\n{'─'*60}\", flush=True)\n446\t            print(f\"输入消息发给 main（直接回车跳过，输入 exit 停止）:\", flush=True)\n447\t            try:\n448\t                user_input = input(f\"  > \").strip()\n449\t                if user_input.lower() == \"exit\":\n450\t                    print(\"用户终止运行\")\n451\t                    break\n452\t                if user_input:\n453\t                    msg_file = write_inbox_message(\n454\t                        os.path.join(LOOPCLI_DIR, \"main\"),\n455\t                        \"user\",\n456\t                        user_input,\n457\t                    )\n458\t                    print(f\"  [已发送] -> main/inbox/\", flush=True)\n459\t            except EOFError:\n460\t                pass\n461\t            print(f\"  等待 {args.wait} 秒后进入下一轮...\", flush=True)\n462\t            time.sleep(args.wait)\n463\t    meta[\"finished\"] = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n464\t    meta[\"total_iterations\"] = count\n465\t    write_json(os.path.join(run_log_dir, \"meta.json\"), meta)\n466\t\n467\t    print(f\"\\n运行结束，日志保存在: {run_log_dir}\")\n468\t\n469\t\n470\t# ─── CLI 入口 ───\n471\t\n472\tparser = argparse.ArgumentParser(description=\"LoopCLI — 多 Agent 自治系统\")\n473\tsub = parser.add_subparsers(dest=\"command\")\n474\t\n475\tp_run = sub.add_parser(\"run\", help=\"启动 Agent 循环（默认）\")\n476\tp_run.add_argument(\"-n\", \"--iterations\", type=int, default=0, help=\"迭代次数，0=无限\")\n477\tp_run.add_argument(\"-w\", \"--wait\", type=int, default=10, help=\"每轮间隔秒数（默认 10）\")\n478\t\n479\tp_create = sub.add_parser(\"create\", help=\"从模板创建新 Agent\")\n480\tp_create.add_argument(\"template\", help=\"模板 ID，如 engineering-frontend-developer\")\n481\tp_create.add_argument(\"--task\", \"-t\", help=\"初始任务描述\")\n482\t\n483\tp_task = sub.add_parser(\"task\", help=\"给 Agent 派发任务\")\n484\tp_task.add_argument(\"agent\", help=\"Agent 目录名\")\n485\tp_task.add_argument(\"title\", help=\"任务标题\")\n486\tp_task.add_argument(\"--desc\", \"-d\", default=\"\", help=\"任务描述\")\n487\t\n488\tsub.add_parser(\"list\", help=\"列出所有 Agent 及状态\")\n489\t\n490\tp_tpl = sub.add_parser(\"templates\", help=\"列出可用模板\")\n491\tp_tpl.add_argument(\"--filter\", \"-f\", default=\"\", help=\"按关键词筛选\")\n492\t\n493\tdef cmd_enable(args):\n494\t    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n495\t    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n496\t        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n497\t        sys.exit(1)\n498\t    set_agent_enabled(agent_dir, True)\n499\t    print(f\"[已启用] {args.agent}\")\n500\t\n501\t\n502\tdef cmd_disable(args):\n503\t    if args.agent == \"main\":\n504\t        print(\"[错误] 不能禁用 main Agent\")\n505\t        sys.exit(1)\n506\t    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n507\t    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n508\t        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n509\t        sys.exit(1)\n510\t    set_agent_enabled(agent_dir, False)\n511\t    print(f\"[已禁用] {args.agent}（loopcli run 将跳过此 Agent）\")\n512\t\n513\t\n514\tp_msg = sub.add_parser(\"msg\", help=\"给 Agent 发消息\")\n515\tp_msg.add_argument(\"content\", help=\"消息内容\")\n516\tp_msg.add_argument(\"--agent\", \"-a\", default=\"main\", help=\"目标 Agent（默认 main）\")\n517\t\n518\tp_enable = sub.add_parser(\"enable\", help=\"启用 Agent（可被 loopcli run 调度）\")\n519\tp_enable.add_argument(\"agent\", help=\"Agent 目录名\")\n520\t\n521\tp_disable = sub.add_parser(\"disable\", help=\"禁用 Agent（跳过调度，节省 token）\")\n522\tp_disable.add_argument(\"agent\", help=\"Agent 目录名\")\n523\t\n524\t\n525\tdef cmd_msg(args):\n526\t    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n527\t    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n528\t        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n529\t        sys.exit(1)\n530\t    msg_file = write_inbox_message(agent_dir, \"user\", args.content)\n531\t    print(f\"[已发送] -> {args.agent}/inbox/  {args.content}\")\n532\t\n533\t\n534\tif sys.argv[1:] and sys.argv[1] not in (\"run\", \"create\", \"task\", \"list\", \"templates\", \"msg\", \"enable\", \"disable\", \"-h\", \"--help\"):\n535\t    sys.argv.insert(1, \"run\")\n536\t\n537\targs = parser.parse_args()\n538\t\n539\tif args.command == \"create\":\n540\t    cmd_create(args)\n541\telif args.command == \"task\":\n542\t    cmd_task(args)\n543\telif args.command == \"list\":\n544\t    cmd_list(args)\n545\telif args.command == \"templates\":\n546\t    cmd_templates(args)\n547\telif args.command == \"msg\":\n548\t    cmd_msg(args)\n549\telif args.command == \"enable\":\n550\t    cmd_enable(args)\n551\telif args.command == \"disable\":\n552\t    cmd_disable(args)\n553\telse:\n554\t    if not hasattr(args, \"iterations\"):\n555\t        args.iterations = 0\n556\t    if not hasattr(args, \"wait\"):\n557\t        args.wait = 10\n558\t    cmd_run(args)\n559\t"}]},"parent_tool_use_id":null,"session_id":"a11b390c-8618-467f-b876-d1d624ad9195","uuid":"6f25f372-70bf-480d-9ff2-a8d4e4177d59","timestamp":"2026-05-21T05:06:11.620Z","tool_use_result":{"type":"text","file":{"filePath":"D:/loopcli/run.py","content":"import argparse\nimport json\nimport msvcrt\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport threading\nimport time\nfrom datetime import datetime\nfrom pathlib import Path\n\nsys.path.insert(0, str(Path(__file__).resolve().parent / \"main\" / \"webui\"))\nfrom loopcli_lib import (\n    LOOPCLI_ROOT,\n    AGENT_MARKER,\n    read_json,\n    write_json,\n    safe_agent_path,\n    get_agent_marker,\n    is_agent_enabled,\n    discover_agents as _discover_agents,\n    create_task,\n    write_inbox_message,\n    set_agent_enabled,\n)\n\nLOOPCLI_DIR = str(LOOPCLI_ROOT)\nSUBAGENT_DIR = os.path.join(LOOPCLI_DIR, \"subagent\")\nCLAUDE = os.path.join(os.environ.get(\"APPDATA\", \"\"), \"npm\", \"claude.cmd\")\n\nLOGS_DIR = os.path.join(LOOPCLI_DIR, \"logs\")\nGIT_TOKEN_FILE = os.path.join(LOOPCLI_DIR, \".gittoken\")\nDEFAULT_PROMPT = \"\"\"读取 SOUL.md 作为你的身份。\n读取 D:/loopcli/skill/ 下所有技能文件（全局技能）。\n读取 memory/tasks.json 获取分配给你的任务。\n\n执行步骤：\n1. 从 tasks.json 中找 status 为 \"pending\" 的第一个任务\n2. 执行该任务\n3. 将结果写入 memory/results/ 目录（以时间戳命名）\n4. 将该任务 status 改为 \"done\"，写回 tasks.json\n5. 更新 memory/state.json（标记完成、记录时间戳）\n6. 将本次运行摘要追加到 log/run.md\n7. 通过 inbox 通知 main：写入 D:/loopcli/main/inbox/<你的名字>_<时间>.md，简要报告任务结果\n8. 如果没有 pending 任务，输出 \"IDLE\" 并结束本轮\n\"\"\"\n\n\n# ─── 工具函数 ───\n\ndef discover_agents(include_disabled=False):\n    \"\"\"Wrapper that returns same format as before (name+path strings).\"\"\"\n    return _discover_agents(include_disabled=include_disabled)\n\n\ndef find_template(template_id):\n    \"\"\"在 subagent 目录下搜索模板文件\"\"\"\n    for dept in os.listdir(SUBAGENT_DIR):\n        dept_dir = os.path.join(SUBAGENT_DIR, dept)\n        if not os.path.isdir(dept_dir):\n            continue\n        candidate = os.path.join(dept_dir, f\"{template_id}.md\")\n        if os.path.isfile(candidate):\n            return candidate\n    return None\n\n\ndef load_agent_state(agent_path):\n    state_file = os.path.join(agent_path, \"memory\", \"state.json\")\n    if os.path.isfile(state_file):\n        return read_json(state_file)\n    return None\n\n\ndef load_agent_tasks(agent_path):\n    tasks_file = os.path.join(agent_path, \"memory\", \"tasks.json\")\n    if os.path.isfile(tasks_file):\n        return read_json(tasks_file, [])\n    return []\n\n\ndef rotate_log(log_path, max_size=1_000_000, max_backups=3):\n    \"\"\"轮转日志文件：超过 max_size 时依次重命名为 .1 .2 .3，最多保留 max_backups 个归档\"\"\"\n    if not os.path.isfile(log_path):\n        return\n    try:\n        if os.path.getsize(log_path) < max_size:\n            return\n    except OSError:\n        return\n    oldest = f\"{log_path}.{max_backups}\"\n    if os.path.isfile(oldest):\n        os.remove(oldest)\n    for i in range(max_backups, 1, -1):\n        src = f\"{log_path}.{i - 1}\"\n        dst = f\"{log_path}.{i}\"\n        if os.path.isfile(src):\n            os.rename(src, dst)\n    os.rename(log_path, f\"{log_path}.1\")\n\n\n# ─── 子命令: create ───\n\ndef cmd_create(args):\n    template_id = args.template\n    task_desc = args.task or \"\"\n\n    tpl_file = find_template(template_id)\n    if not tpl_file:\n        print(f\"[错误] 找不到模板: {template_id}\")\n        print(\"用 loopcli templates 查看所有可用模板\")\n        sys.exit(1)\n\n    with open(tpl_file, \"r\", encoding=\"utf-8\") as f:\n        soul_content = f.read()\n\n    agent_dir = os.path.join(LOOPCLI_DIR, template_id)\n    if os.path.exists(agent_dir):\n        print(f\"[跳过] Agent 已存在: {agent_dir}\")\n        if task_desc:\n            cmd_task_inner(template_id, task_desc, \"\")\n        return\n\n    os.makedirs(os.path.join(agent_dir, \"memory\", \"results\"), exist_ok=True)\n    os.makedirs(os.path.join(agent_dir, \"log\"), exist_ok=True)\n\n    with open(os.path.join(agent_dir, AGENT_MARKER), \"w\", encoding=\"utf-8\") as f:\n        f.write(\"type: main\\n\")\n\n    with open(os.path.join(agent_dir, \"SOUL.md\"), \"w\", encoding=\"utf-8\") as f:\n        f.write(soul_content)\n\n    with open(os.path.join(agent_dir, \"PROMPT.md\"), \"w\", encoding=\"utf-8\") as f:\n        f.write(DEFAULT_PROMPT)\n\n    state = {\"agent\": template_id, \"status\": \"idle\", \"current_task\": None, \"last_run\": None, \"run_count\": 0, \"created\": datetime.now().strftime(\"%Y-%m-%d\")}\n    write_json(os.path.join(agent_dir, \"memory\", \"state.json\"), state)\n\n    tasks = []\n    if task_desc:\n        tasks.append({\"id\": 1, \"status\": \"pending\", \"title\": task_desc, \"description\": task_desc, \"created\": datetime.now().strftime(\"%Y-%m-%d\"), \"assignee\": template_id})\n    write_json(os.path.join(agent_dir, \"memory\", \"tasks.json\"), tasks)\n\n    with open(os.path.join(agent_dir, \"log\", \"run.md\"), \"w\", encoding=\"utf-8\") as f:\n        f.write(\"# 运行日志\\n\\n| 时间 | 状态 | 任务 | 摘要 |\\n|------|------|------|------|\\n\")\n\n    print(f\"[创建成功] {template_id}\")\n    print(f\"  目录: {agent_dir}\")\n    if task_desc:\n        print(f\"  任务: {task_desc}\")\n    print(f\"  下一轮 loopcli 将自动启动该 Agent\")\n\n\n# ─── 子命令: task ───\n\ndef cmd_task_inner(agent_name, title, desc):\n    agent_dir = os.path.join(LOOPCLI_DIR, agent_name)\n    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n        print(f\"[错误] 不是有效的 Agent: {agent_name}\")\n        sys.exit(1)\n\n    task = create_task(\n        agent_dir, title,\n        description=desc or title,\n        assignee=agent_name,\n        created=datetime.now().strftime(\"%Y-%m-%d\"),\n    )\n    print(f\"[派发成功] {agent_name} <- #{task['id']} {title}\")\n\n\ndef cmd_task(args):\n    cmd_task_inner(args.agent, args.title, args.desc)\n\n\n# ─── 子命令: list ───\n\ndef cmd_list(args):\n    agents = discover_agents(include_disabled=True)\n    if not agents:\n        print(\"没有发现任何 Agent\")\n        return\n    print(f\"{'Agent':<45} {'启用':<6} {'状态':<10} {'任务数':<8} {'最后运行'}\")\n    print(\"-\" * 95)\n    for a in agents:\n        enabled = \"是\" if is_agent_enabled(a[\"path\"]) else \"否\"\n        state = load_agent_state(a[\"path\"]) or {}\n        tasks = load_agent_tasks(a[\"path\"])\n        pending = len([t for t in tasks if t.get(\"status\") == \"pending\"])\n        status = state.get(\"status\", \"?\")\n        last_run = state.get(\"last_run\", \"-\")\n        print(f\"{a['name']:<45} {enabled:<6} {status:<10} {pending:<8} {last_run}\")\n\n\n# ─── 子命令: templates ───\n\ndef cmd_templates(args):\n    found = []\n    for dept in sorted(os.listdir(SUBAGENT_DIR)):\n        dept_dir = os.path.join(SUBAGENT_DIR, dept)\n        if not os.path.isdir(dept_dir):\n            continue\n        for fname in sorted(os.listdir(dept_dir)):\n            if fname.endswith(\".md\"):\n                found.append(fname[:-3])\n    if args.filter:\n        found = [t for t in found if args.filter.lower() in t.lower()]\n    print(f\"共 {len(found)} 个模板:\")\n    for t in found:\n        print(f\"  {t}\")\n\n\n# ─── 子命令: run（主循环）───\n\ndef handle_event(agent_name, line):\n    line = line.strip()\n    if not line:\n        return\n    try:\n        event = json.loads(line)\n    except json.JSONDecodeError:\n        print(f\"[{agent_name}] {line}\", flush=True)\n        return\n\n    event_type = event.get(\"type\", \"\")\n\n    if event_type == \"assistant\":\n        msg = event.get(\"message\", {})\n        for block in msg.get(\"content\", []):\n            if block.get(\"type\") == \"text\":\n                text = block.get(\"text\", \"\")\n                if text:\n                    print(f\"[{agent_name}] {text}\", flush=True)\n            elif block.get(\"type\") == \"tool_use\":\n                name = block.get(\"name\", \"\")\n                inp = block.get(\"input\", {})\n                detail = \"\"\n                for k in (\"file_path\", \"command\", \"pattern\"):\n                    if k in inp:\n                        detail = inp[k]\n                        break\n                print(f\"[{agent_name}] ● {name}({detail})\", flush=True)\n\n    elif event_type == \"tool_result\":\n        content = event.get(\"content\", \"\")\n        texts = []\n        if isinstance(content, list):\n            texts = [b.get(\"text\", \"\") for b in content if b.get(\"text\")]\n        elif isinstance(content, str):\n            texts = [content]\n        for text in texts:\n            print(f\"[{agent_name}]   ↳ {text[:200]}\", flush=True)\n\n    elif event_type == \"result\":\n        text = event.get(\"result\", \"\")\n        if text:\n            print(f\"[{agent_name}] [结果] {text[:500]}\", flush=True)\n        cost = event.get(\"cost_usd\", \"\")\n        duration = event.get(\"duration_ms\", \"\")\n        if cost or duration:\n            print(f\"[{agent_name}] [统计] 耗时: {duration}ms, 费用: ${cost}\", flush=True)\n\n    elif event_type == \"error\":\n        print(f\"[{agent_name}] [错误] {event.get('error', '')}\", flush=True)\n\n\ndef run_agent(agent, iteration, run_log_dir):\n    name = agent[\"name\"]\n    path = agent[\"path\"]\n    prompt_file = os.path.join(path, \"PROMPT.md\")\n    log_file_path = os.path.join(path, \"log\", \"raw.log\")\n    run_agent_log = os.path.join(run_log_dir, f\"{name}.log\")\n    ts = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n\n    if not os.path.isfile(prompt_file):\n        print(f\"[{name}] 没有 PROMPT.md，跳过\", flush=True)\n        return\n\n    with open(prompt_file, \"r\", encoding=\"utf-8\") as f:\n        prompt = f.read()\n\n    os.makedirs(os.path.join(path, \"log\"), exist_ok=True)\n    rotate_log(log_file_path)\n    log_file = open(log_file_path, \"a\", encoding=\"utf-8\")\n    agent_log = open(run_agent_log, \"a\", encoding=\"utf-8\")\n\n    try:\n        header = f\"\\n[{ts}] --- 开始 (第{iteration}轮) ---\\n\"\n        log_file.write(header)\n        agent_log.write(header)\n        log_file.flush()\n        agent_log.flush()\n\n        env = {**os.environ, \"IS_SANDBOX\": \"1\"}\n\n        proc = subprocess.Popen(\n            [CLAUDE, \"--print\", \"--verbose\", \"--output-format\", \"stream-json\", \"--dangerously-skip-permissions\"],\n            stdin=subprocess.PIPE,\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            env=env,\n            cwd=path,\n        )\n\n        proc.stdin.write(prompt.encode(\"utf-8\"))\n        proc.stdin.close()\n\n        for line in proc.stdout:\n            decoded = line.decode(\"utf-8\", errors=\"replace\")\n            log_file.write(decoded)\n            agent_log.write(decoded)\n            log_file.flush()\n            agent_log.flush()\n            handle_event(name, decoded)\n\n        stderr_output = proc.stderr.read().decode(\"utf-8\", errors=\"replace\")\n        if stderr_output:\n            print(f\"[{name}] [STDERR] {stderr_output}\", flush=True)\n            log_file.write(stderr_output)\n            agent_log.write(stderr_output)\n\n        proc.wait()\n\n        footer = f\"\\n[{ts}] --- 结束 (exit={proc.returncode}) ---\\n\"\n        log_file.write(footer)\n        agent_log.write(footer)\n    finally:\n        log_file.close()\n        agent_log.close()\n\n    # 更新 state.json (with file lock)\n    state_file = os.path.join(path, \"memory\", \"state.json\")\n    with open(state_file, \"a+\") as f:\n        msvcrt.locking(f.fileno(), msvcrt.LK_LOCK, 1)\n        try:\n            f.seek(0)\n            try:\n                state = json.load(f)\n            except (json.JSONDecodeError, ValueError):\n                state = {}\n            state[\"status\"] = \"idle\"\n            state[\"last_run\"] = ts\n            state[\"run_count\"] = state.get(\"run_count\", 0) + 1\n            f.seek(0)\n            f.truncate()\n            json.dump(state, f, indent=2, ensure_ascii=False)\n        finally:\n            msvcrt.locking(f.fileno(), msvcrt.LK_UNLCK, 1)\n\n    status = \"完成\" if proc.returncode == 0 else f\"异常(exit={proc.returncode})\"\n    print(f\"[{name}] 本轮{status}\", flush=True)\n\n\ndef git_push():\n    \"\"\"自动 commit 和 push 到 GitHub\"\"\"\n    token_file = GIT_TOKEN_FILE\n    if not os.path.isfile(token_file):\n        return\n    with open(token_file, \"r\") as f:\n        token = f.read().strip()\n    if not token:\n        return\n    try:\n        git = resolve_git()\n        subprocess.run([git, \"add\", \"memory/\", \"log/\", \"inbox/\"], cwd=LOOPCLI_DIR, capture_output=True, timeout=30)\n        subprocess.run(\n            [git, \"commit\", \"-m\", f\"auto: loopcli sync {datetime.now().strftime('%Y-%m-%d %H:%M')}\"],\n            cwd=LOOPCLI_DIR, capture_output=True, timeout=30\n        )\n        askpass_script = os.path.join(LOOPCLI_DIR, \".git_askpass.bat\")\n        with open(askpass_script, \"w\") as f:\n            f.write(\"@echo %GH_TOKEN%\\n\")\n        push_env = {\n            **os.environ,\n            \"GH_TOKEN\": token,\n            \"GIT_ASKPASS\": askpass_script,\n            \"GIT_TERMINAL_PROMPT\": \"0\",\n        }\n        subprocess.run(\n            [git, \"push\", \"https://x-access-token@github.com/zhoudingnuo/loopcli.git\", \"main\"],\n            cwd=LOOPCLI_DIR, capture_output=True, timeout=60, env=push_env,\n        )\n        os.remove(askpass_script)\n        print(\"[git] 已同步到 GitHub\", flush=True)\n    except Exception as e:\n        print(f\"[git] 同步失败: {e}\", flush=True)\n\n\ndef resolve_git():\n    \"\"\"找到 git.exe 的完整路径\"\"\"\n    for p in os.environ.get(\"PATH\", \"\").split(\";\"):\n        candidate = os.path.join(p, \"git.exe\")\n        if os.path.isfile(candidate):\n            return candidate\n    for d in [r\"C:\\Program Files\\Git\\cmd\", r\"C:\\Program Files\\Git\\bin\"]:\n        candidate = os.path.join(d, \"git.exe\")\n        if os.path.isfile(candidate):\n            return candidate\n    return \"git\"\n\n\ndef cmd_run(args):\n    agents = discover_agents()\n    if not agents:\n        print(\"未发现任何 Agent（需要目录下有 AGENT 标记文件）\")\n        sys.exit(1)\n\n    run_id = datetime.now().strftime(\"run_%Y%m%d_%H%M%S\")\n    run_log_dir = os.path.join(LOGS_DIR, run_id)\n    os.makedirs(run_log_dir, exist_ok=True)\n\n    meta = {\n        \"run_id\": run_id,\n        \"started\": datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"),\n        \"iterations\": args.iterations or \"无限\",\n        \"agents\": [a[\"name\"] for a in agents],\n    }\n    write_json(os.path.join(run_log_dir, \"meta.json\"), meta)\n\n    print(f\"运行 ID: {run_id}\")\n    print(f\"日志目录: {run_log_dir}\")\n    print(f\"发现 {len(agents)} 个 Agent: {', '.join(a['name'] for a in agents)}\")\n\n    count = 0\n    while args.iterations == 0 or count < args.iterations:\n        count += 1\n        agents = discover_agents()\n        ts = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n        print(f\"\\n{'='*60}\")\n        print(f\"[{ts}] 第 {count}{'/' + str(args.iterations) if args.iterations else ''} 轮 | {len(agents)} 个 Agent\")\n        print(f\"{'='*60}\")\n\n        threads = []\n        for agent in agents:\n            print(f\"\\n--- 启动 [{agent['name']}] ---\", flush=True)\n            t = threading.Thread(target=run_agent, args=(agent, count, run_log_dir))\n            t.start()\n            threads.append(t)\n        for t in threads:\n            t.join()\n\n        git_push()\n\n        if args.iterations == 0 or count < args.iterations:\n            print(f\"\\n{'─'*60}\", flush=True)\n            print(f\"输入消息发给 main（直接回车跳过，输入 exit 停止）:\", flush=True)\n            try:\n                user_input = input(f\"  > \").strip()\n                if user_input.lower() == \"exit\":\n                    print(\"用户终止运行\")\n                    break\n                if user_input:\n                    msg_file = write_inbox_message(\n                        os.path.join(LOOPCLI_DIR, \"main\"),\n                        \"user\",\n                        user_input,\n                    )\n                    print(f\"  [已发送] -> main/inbox/\", flush=True)\n            except EOFError:\n                pass\n            print(f\"  等待 {args.wait} 秒后进入下一轮...\", flush=True)\n            time.sleep(args.wait)\n    meta[\"finished\"] = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n    meta[\"total_iterations\"] = count\n    write_json(os.path.join(run_log_dir, \"meta.json\"), meta)\n\n    print(f\"\\n运行结束，日志保存在: {run_log_dir}\")\n\n\n# ─── CLI 入口 ───\n\nparser = argparse.ArgumentParser(description=\"LoopCLI — 多 Agent 自治系统\")\nsub = parser.add_subparsers(dest=\"command\")\n\np_run = sub.add_parser(\"run\", help=\"启动 Agent 循环（默认）\")\np_run.add_argument(\"-n\", \"--iterations\", type=int, default=0, help=\"迭代次数，0=无限\")\np_run.add_argument(\"-w\", \"--wait\", type=int, default=10, help=\"每轮间隔秒数（默认 10）\")\n\np_create = sub.add_parser(\"create\", help=\"从模板创建新 Agent\")\np_create.add_argument(\"template\", help=\"模板 ID，如 engineering-frontend-developer\")\np_create.add_argument(\"--task\", \"-t\", help=\"初始任务描述\")\n\np_task = sub.add_parser(\"task\", help=\"给 Agent 派发任务\")\np_task.add_argument(\"agent\", help=\"Agent 目录名\")\np_task.add_argument(\"title\", help=\"任务标题\")\np_task.add_argument(\"--desc\", \"-d\", default=\"\", help=\"任务描述\")\n\nsub.add_parser(\"list\", help=\"列出所有 Agent 及状态\")\n\np_tpl = sub.add_parser(\"templates\", help=\"列出可用模板\")\np_tpl.add_argument(\"--filter\", \"-f\", default=\"\", help=\"按关键词筛选\")\n\ndef cmd_enable(args):\n    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n        sys.exit(1)\n    set_agent_enabled(agent_dir, True)\n    print(f\"[已启用] {args.agent}\")\n\n\ndef cmd_disable(args):\n    if args.agent == \"main\":\n        print(\"[错误] 不能禁用 main Agent\")\n        sys.exit(1)\n    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n        sys.exit(1)\n    set_agent_enabled(agent_dir, False)\n    print(f\"[已禁用] {args.agent}（loopcli run 将跳过此 Agent）\")\n\n\np_msg = sub.add_parser(\"msg\", help=\"给 Agent 发消息\")\np_msg.add_argument(\"content\", help=\"消息内容\")\np_msg.add_argument(\"--agent\", \"-a\", default=\"main\", help=\"目标 Agent（默认 main）\")\n\np_enable = sub.add_parser(\"enable\", help=\"启用 Agent（可被 loopcli run 调度）\")\np_enable.add_argument(\"agent\", help=\"Agent 目录名\")\n\np_disable = sub.add_parser(\"disable\", help=\"禁用 Agent（跳过调度，节省 token）\")\np_disable.add_argument(\"agent\", help=\"Agent 目录名\")\n\n\ndef cmd_msg(args):\n    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n        sys.exit(1)\n    msg_file = write_inbox_message(agent_dir, \"user\", args.content)\n    print(f\"[已发送] -> {args.agent}/inbox/  {args.content}\")\n\n\nif sys.argv[1:] and sys.argv[1] not in (\"run\", \"create\", \"task\", \"list\", \"templates\", \"msg\", \"enable\", \"disable\", \"-h\", \"--help\"):\n    sys.argv.insert(1, \"run\")\n\nargs = parser.parse_args()\n\nif args.command == \"create\":\n    cmd_create(args)\nelif args.command == \"task\":\n    cmd_task(args)\nelif args.command == \"list\":\n    cmd_list(args)\nelif args.command == \"templates\":\n    cmd_templates(args)\nelif args.command == \"msg\":\n    cmd_msg(args)\nelif args.command == \"enable\":\n    cmd_enable(args)\nelif args.command == \"disable\":\n    cmd_disable(args)\nelse:\n    if not hasattr(args, \"iterations\"):\n        args.iterations = 0\n    if not hasattr(args, \"wait\"):\n        args.wait = 10\n    cmd_run(args)\n","numLines":559,"startLine":1,"totalLines":559}}}
