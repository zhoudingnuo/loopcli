{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_597f3c07cd2b4b74b8fb0361","type":"tool_result","content":"1\t\"\"\"\n2\tLoopCLI shared library — common functions used by server.py and run.py.\n3\t\"\"\"\n4\t\n5\timport json\n6\timport os\n7\timport tempfile\n8\timport threading\n9\tfrom pathlib import Path\n10\t\n11\t\n12\tdef _resolve_root():\n13\t    \"\"\"Resolve LOOPCLI_ROOT: env var > auto-detect from file location.\"\"\"\n14\t    env = os.environ.get(\"LOOPCLI_ROOT\", \"\").strip()\n15\t    if env:\n16\t        return Path(env).resolve()\n17\t    # loopcli_lib.py lives at LOOPCLI_ROOT/main/webui/loopcli_lib.py\n18\t    return Path(__file__).resolve().parent.parent.parent\n19\t\n20\t\n21\tLOOPCLI_ROOT = _resolve_root()\n22\tAGENT_MARKER = \"AGENT\"\n23\t\n24\t_json_lock = threading.Lock()\n25\t\n26\t\n27\t# ─── JSON I/O ───\n28\t\n29\tdef read_json(path, default=None):\n30\t    \"\"\"Read and parse a JSON file, returning default on failure.\"\"\"\n31\t    path = Path(path)\n32\t    if not path.exists():\n33\t        return default if default is not None else {}\n34\t    try:\n35\t        return json.loads(path.read_text(encoding=\"utf-8\"))\n36\t    except (json.JSONDecodeError, OSError):\n37\t        return default if default is not None else {}\n38\t\n39\t\n40\tdef write_json(path, data):\n41\t    \"\"\"Atomically write data as JSON using tempfile + os.replace.\n42\t\n43\t    Writes to a temporary file first, then atomically replaces the target.\n44\t    This ensures no partial/corrupt files if the process crashes mid-write.\n45\t    \"\"\"\n46\t    import time as _time\n47\t    path = Path(path)\n48\t    with _json_lock:\n49\t        path.parent.mkdir(parents=True, exist_ok=True)\n50\t        content = json.dumps(data, ensure_ascii=False, indent=2)\n51\t        fd, tmp_path = tempfile.mkstemp(\n52\t            suffix=\".tmp\",\n53\t            prefix=\".loopcli_\",\n54\t            dir=str(path.parent),\n55\t        )\n56\t        try:\n57\t            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as f:\n58\t                f.write(content)\n59\t                f.flush()\n60\t                os.fsync(f.fileno())\n61\t            # On Windows, os.replace can fail if another thread is reading the file.\n62\t            # Retry a few times with a short delay.\n63\t            for attempt in range(5):\n64\t                try:\n65\t                    os.replace(tmp_path, str(path))\n66\t                    break\n67\t                except PermissionError:\n68\t                    if attempt == 4:\n69\t                        raise\n70\t                    _time.sleep(0.05)\n71\t        except BaseException:\n72\t            try:\n73\t                os.unlink(tmp_path)\n74\t            except OSError:\n75\t                pass\n76\t            raise\n77\t\n78\t\n79\t# ─── Agent path safety ───\n80\t\n81\tdef safe_agent_path(agent_id: str) -> Path | None:\n82\t    \"\"\"Validate and resolve an agent directory path, preventing traversal attacks.\"\"\"\n83\t    if not agent_id or '/' in agent_id or '\\\\' in agent_id or '..' in agent_id or '\\x00' in agent_id:\n84\t        return None\n85\t    agent_dir = LOOPCLI_ROOT / agent_id\n86\t    try:\n87\t        agent_dir.resolve().relative_to(LOOPCLI_ROOT.resolve())\n88\t    except ValueError:\n89\t        return None\n90\t    return agent_dir\n91\t\n92\t\n93\t# ─── Agent discovery ───\n94\t\n95\tdef get_agent_marker(agent_dir) -> str | None:\n96\t    \"\"\"Read AGENT marker file content, or None if missing.\"\"\"\n97\t    marker = Path(agent_dir) / AGENT_MARKER\n98\t    if marker.is_file():\n99\t        return marker.read_text(encoding=\"utf-8\").strip()\n100\t    return None\n101\t\n102\t\n103\tdef is_agent_enabled(agent_dir) -> bool:\n104\t    \"\"\"Check if an agent directory has a valid, non-disabled AGENT marker.\"\"\"\n105\t    content = get_agent_marker(agent_dir)\n106\t    if content is None:\n107\t        return False\n108\t    return \"disabled\" not in content\n109\t\n110\t\n111\tdef discover_agents(include_disabled=False):\n112\t    \"\"\"Discover agent directories under LOOPCLI_ROOT.\n113\t\n114\t    Returns list of {\"name\": str, \"path\": str}.\n115\t    \"\"\"\n116\t    agents = []\n117\t    for child in LOOPCLI_ROOT.iterdir():\n118\t        if not child.is_dir():\n119\t            continue\n120\t        if not (child / AGENT_MARKER).exists():\n121\t            continue\n122\t        if include_disabled or is_agent_enabled(child):\n123\t            agents.append({\"name\": child.name, \"path\": str(child)})\n124\t    return agents\n125\t\n126\t\n127\tdef scan_agents():\n128\t    \"\"\"Full agent scan with metadata (state, soul, task counts).\"\"\"\n129\t    agents = []\n130\t    for child in LOOPCLI_ROOT.iterdir():\n131\t        if not child.is_dir():\n132\t            continue\n133\t        if not (child / AGENT_MARKER).exists():\n134\t            continue\n135\t        state = read_json(child / \"memory\" / \"state.json\", {})\n136\t        soul_path = child / \"SOUL.md\"\n137\t        desc = \"\"\n138\t        if soul_path.exists():\n139\t            for line in soul_path.read_text(encoding=\"utf-8\").strip().splitlines():\n140\t                stripped = line.strip()\n141\t                if stripped and not stripped.startswith(\"#\"):\n142\t                    desc = stripped\n143\t                    break\n144\t        tasks = read_json(child / \"memory\" / \"tasks.json\", [])\n145\t        done_count = sum(1 for t in tasks if t.get(\"status\") == \"done\")\n146\t        pending_count = sum(1 for t in tasks if t.get(\"status\") == \"pending\")\n147\t        agents.append({\n148\t            \"id\": child.name,\n149\t            \"name\": state.get(\"agent\", child.name),\n150\t            \"status\": state.get(\"status\", \"unknown\"),\n151\t            \"description\": desc,\n152\t            \"last_run\": state.get(\"last_run\"),\n153\t            \"run_count\": state.get(\"run_count\", 0),\n154\t            \"current_task\": state.get(\"current_task\"),\n155\t            \"task_count\": len(tasks),\n156\t            \"task_done\": done_count,\n157\t            \"task_pending\": pending_count,\n158\t        })\n159\t    return agents\n160\t\n161\t\n162\t# ─── Task management ───\n163\t\n164\tdef next_task_id(tasks):\n165\t    \"\"\"Get the next auto-increment task ID from a task list.\"\"\"\n166\t    return max((t.get(\"id\", 0) for t in tasks), default=0) + 1\n167\t\n168\t\n169\tdef create_task(agent_dir, title, description=\"\", assignee=None, created=None):\n170\t    \"\"\"Create a new task in an agent's tasks.json and return the task dict.\"\"\"\n171\t    from datetime import datetime, timezone\n172\t    agent_dir = Path(agent_dir)\n173\t    tasks_file = agent_dir / \"memory\" / \"tasks.json\"\n174\t    tasks = read_json(tasks_file, [])\n175\t    new_id = next_task_id(tasks)\n176\t    task = {\n177\t        \"id\": new_id,\n178\t        \"status\": \"pending\",\n179\t        \"title\": title,\n180\t        \"description\": description,\n181\t        \"created\": created or datetime.now(timezone.utc).strftime(\"%Y-%m-%d\"),\n182\t        \"assignee\": assignee or agent_dir.name,\n183\t    }\n184\t    tasks.append(task)\n185\t    write_json(tasks_file, tasks)\n186\t    return task\n187\t\n188\t\n189\tdef get_agent_tasks(agent_id):\n190\t    \"\"\"Get tasks for a specific agent by ID. Returns None if agent_id is invalid.\"\"\"\n191\t    agent_dir = safe_agent_path(agent_id)\n192\t    if not agent_dir:\n193\t        return None\n194\t    return read_json(agent_dir / \"memory\" / \"tasks.json\", [])\n195\t\n196\t\n197\tdef get_all_agent_tasks():\n198\t    \"\"\"Aggregate tasks from all agents, each tagged with _agent_id.\"\"\"\n199\t    all_tasks = []\n200\t    for child in LOOPCLI_ROOT.iterdir():\n201\t        if not child.is_dir() or not (child / AGENT_MARKER).exists():\n202\t            continue\n203\t        tasks = read_json(child / \"memory\" / \"tasks.json\", [])\n204\t        for t in tasks:\n205\t            t[\"_agent_id\"] = child.name\n206\t        all_tasks.extend(tasks)\n207\t    return all_tasks\n208\t\n209\t\n210\t# ─── Message / inbox ───\n211\t\n212\tdef write_inbox_message(agent_dir, sender, content, msg_type=\"指令\"):\n213\t    \"\"\"Write a message to an agent's inbox directory. Returns the message file path.\"\"\"\n214\t    import uuid\n215\t    from datetime import datetime\n216\t    agent_dir = Path(agent_dir)\n217\t    inbox_dir = agent_dir / \"inbox\"\n218\t    inbox_dir.mkdir(parents=True, exist_ok=True)\n219\t    now = datetime.now()\n220\t    ts = now.strftime(\"%Y%m%d_%H%M\")\n221\t    msg_file = inbox_dir / f\"{sender}_{ts}_{uuid.uuid4().hex[:8]}.md\"\n222\t    msg_file.write_text(\n223\t        f\"# 来自 {sender} 的消息\\n- 类型：{msg_type}\\n- 时间：{now.strftime('%Y-%m-%d %H:%M')}\\n\\n## 内容\\n{content}\\n\",\n224\t        encoding=\"utf-8\",\n225\t    )\n226\t    return msg_file\n227\t\n228\t\n229\t# ─── Agent enable/disable ───\n230\t\n231\tdef set_agent_enabled(agent_dir, enabled=True):\n232\t    \"\"\"Enable or disable an agent by writing its AGENT marker.\"\"\"\n233\t    agent_dir = Path(agent_dir)\n234\t    marker = agent_dir / AGENT_MARKER\n235\t    if enabled:\n236\t        marker.write_text(\"type: main\\n\", encoding=\"utf-8\")\n237\t    else:\n238\t        marker.write_text(\"type: main\\ndisabled: true\\n\", encoding=\"utf-8\")\n239\t\n240\t\n241\t# ─── File utilities ───\n242\t\n243\tdef get_recent_lines(filepath, n=100):\n244\t    \"\"\"Read the last N lines from a text file.\"\"\"\n245\t    filepath = Path(filepath)\n246\t    if not filepath.exists():\n247\t        return []\n248\t    try:\n249\t        with open(filepath, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n250\t            lines = f.readlines()\n251\t        return [l.rstrip(\"\\n\\r\") for l in lines[-n:]]\n252\t    except OSError:\n253\t        return []\n254\t\n255\t\n256\tdef read_file_tail_incremental(filepath, last_pos=0):\n257\t    \"\"\"Read only new content appended since last_pos.\n258\t\n259\t    Returns (new_lines, new_pos). Efficient for SSE/polling scenarios.\n260\t    \"\"\"\n261\t    filepath = Path(filepath)\n262\t    if not filepath.exists():\n263\t        return [], 0\n264\t    try:\n265\t        size = filepath.stat().st_size\n266\t        if size < last_pos:\n267\t            # File was truncated/rotated — read from start\n268\t            last_pos = 0\n269\t        if size == last_pos:\n270\t            return [], last_pos\n271\t        with open(filepath, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n272\t            f.seek(last_pos)\n273\t            new_content = f.read()\n274\t            new_pos = f.tell()\n275\t        lines = [l.rstrip(\"\\n\\r\") for l in new_content.splitlines()]\n276\t        return lines, new_pos\n277\t    except OSError:\n278\t        return [], last_pos\n279\t"}]},"parent_tool_use_id":null,"session_id":"a11b390c-8618-467f-b876-d1d624ad9195","uuid":"031ec8fe-213a-4c3a-9742-f242306ca8d1","timestamp":"2026-05-21T05:05:32.018Z","tool_use_result":{"type":"text","file":{"filePath":"D:/loopcli/main/webui/loopcli_lib.py","content":"\"\"\"\nLoopCLI shared library — common functions used by server.py and run.py.\n\"\"\"\n\nimport json\nimport os\nimport tempfile\nimport threading\nfrom pathlib import Path\n\n\ndef _resolve_root():\n    \"\"\"Resolve LOOPCLI_ROOT: env var > auto-detect from file location.\"\"\"\n    env = os.environ.get(\"LOOPCLI_ROOT\", \"\").strip()\n    if env:\n        return Path(env).resolve()\n    # loopcli_lib.py lives at LOOPCLI_ROOT/main/webui/loopcli_lib.py\n    return Path(__file__).resolve().parent.parent.parent\n\n\nLOOPCLI_ROOT = _resolve_root()\nAGENT_MARKER = \"AGENT\"\n\n_json_lock = threading.Lock()\n\n\n# ─── JSON I/O ───\n\ndef read_json(path, default=None):\n    \"\"\"Read and parse a JSON file, returning default on failure.\"\"\"\n    path = Path(path)\n    if not path.exists():\n        return default if default is not None else {}\n    try:\n        return json.loads(path.read_text(encoding=\"utf-8\"))\n    except (json.JSONDecodeError, OSError):\n        return default if default is not None else {}\n\n\ndef write_json(path, data):\n    \"\"\"Atomically write data as JSON using tempfile + os.replace.\n\n    Writes to a temporary file first, then atomically replaces the target.\n    This ensures no partial/corrupt files if the process crashes mid-write.\n    \"\"\"\n    import time as _time\n    path = Path(path)\n    with _json_lock:\n        path.parent.mkdir(parents=True, exist_ok=True)\n        content = json.dumps(data, ensure_ascii=False, indent=2)\n        fd, tmp_path = tempfile.mkstemp(\n            suffix=\".tmp\",\n            prefix=\".loopcli_\",\n            dir=str(path.parent),\n        )\n        try:\n            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as f:\n                f.write(content)\n                f.flush()\n                os.fsync(f.fileno())\n            # On Windows, os.replace can fail if another thread is reading the file.\n            # Retry a few times with a short delay.\n            for attempt in range(5):\n                try:\n                    os.replace(tmp_path, str(path))\n                    break\n                except PermissionError:\n                    if attempt == 4:\n                        raise\n                    _time.sleep(0.05)\n        except BaseException:\n            try:\n                os.unlink(tmp_path)\n            except OSError:\n                pass\n            raise\n\n\n# ─── Agent path safety ───\n\ndef safe_agent_path(agent_id: str) -> Path | None:\n    \"\"\"Validate and resolve an agent directory path, preventing traversal attacks.\"\"\"\n    if not agent_id or '/' in agent_id or '\\\\' in agent_id or '..' in agent_id or '\\x00' in agent_id:\n        return None\n    agent_dir = LOOPCLI_ROOT / agent_id\n    try:\n        agent_dir.resolve().relative_to(LOOPCLI_ROOT.resolve())\n    except ValueError:\n        return None\n    return agent_dir\n\n\n# ─── Agent discovery ───\n\ndef get_agent_marker(agent_dir) -> str | None:\n    \"\"\"Read AGENT marker file content, or None if missing.\"\"\"\n    marker = Path(agent_dir) / AGENT_MARKER\n    if marker.is_file():\n        return marker.read_text(encoding=\"utf-8\").strip()\n    return None\n\n\ndef is_agent_enabled(agent_dir) -> bool:\n    \"\"\"Check if an agent directory has a valid, non-disabled AGENT marker.\"\"\"\n    content = get_agent_marker(agent_dir)\n    if content is None:\n        return False\n    return \"disabled\" not in content\n\n\ndef discover_agents(include_disabled=False):\n    \"\"\"Discover agent directories under LOOPCLI_ROOT.\n\n    Returns list of {\"name\": str, \"path\": str}.\n    \"\"\"\n    agents = []\n    for child in LOOPCLI_ROOT.iterdir():\n        if not child.is_dir():\n            continue\n        if not (child / AGENT_MARKER).exists():\n            continue\n        if include_disabled or is_agent_enabled(child):\n            agents.append({\"name\": child.name, \"path\": str(child)})\n    return agents\n\n\ndef scan_agents():\n    \"\"\"Full agent scan with metadata (state, soul, task counts).\"\"\"\n    agents = []\n    for child in LOOPCLI_ROOT.iterdir():\n        if not child.is_dir():\n            continue\n        if not (child / AGENT_MARKER).exists():\n            continue\n        state = read_json(child / \"memory\" / \"state.json\", {})\n        soul_path = child / \"SOUL.md\"\n        desc = \"\"\n        if soul_path.exists():\n            for line in soul_path.read_text(encoding=\"utf-8\").strip().splitlines():\n                stripped = line.strip()\n                if stripped and not stripped.startswith(\"#\"):\n                    desc = stripped\n                    break\n        tasks = read_json(child / \"memory\" / \"tasks.json\", [])\n        done_count = sum(1 for t in tasks if t.get(\"status\") == \"done\")\n        pending_count = sum(1 for t in tasks if t.get(\"status\") == \"pending\")\n        agents.append({\n            \"id\": child.name,\n            \"name\": state.get(\"agent\", child.name),\n            \"status\": state.get(\"status\", \"unknown\"),\n            \"description\": desc,\n            \"last_run\": state.get(\"last_run\"),\n            \"run_count\": state.get(\"run_count\", 0),\n            \"current_task\": state.get(\"current_task\"),\n            \"task_count\": len(tasks),\n            \"task_done\": done_count,\n            \"task_pending\": pending_count,\n        })\n    return agents\n\n\n# ─── Task management ───\n\ndef next_task_id(tasks):\n    \"\"\"Get the next auto-increment task ID from a task list.\"\"\"\n    return max((t.get(\"id\", 0) for t in tasks), default=0) + 1\n\n\ndef create_task(agent_dir, title, description=\"\", assignee=None, created=None):\n    \"\"\"Create a new task in an agent's tasks.json and return the task dict.\"\"\"\n    from datetime import datetime, timezone\n    agent_dir = Path(agent_dir)\n    tasks_file = agent_dir / \"memory\" / \"tasks.json\"\n    tasks = read_json(tasks_file, [])\n    new_id = next_task_id(tasks)\n    task = {\n        \"id\": new_id,\n        \"status\": \"pending\",\n        \"title\": title,\n        \"description\": description,\n        \"created\": created or datetime.now(timezone.utc).strftime(\"%Y-%m-%d\"),\n        \"assignee\": assignee or agent_dir.name,\n    }\n    tasks.append(task)\n    write_json(tasks_file, tasks)\n    return task\n\n\ndef get_agent_tasks(agent_id):\n    \"\"\"Get tasks for a specific agent by ID. Returns None if agent_id is invalid.\"\"\"\n    agent_dir = safe_agent_path(agent_id)\n    if not agent_dir:\n        return None\n    return read_json(agent_dir / \"memory\" / \"tasks.json\", [])\n\n\ndef get_all_agent_tasks():\n    \"\"\"Aggregate tasks from all agents, each tagged with _agent_id.\"\"\"\n    all_tasks = []\n    for child in LOOPCLI_ROOT.iterdir():\n        if not child.is_dir() or not (child / AGENT_MARKER).exists():\n            continue\n        tasks = read_json(child / \"memory\" / \"tasks.json\", [])\n        for t in tasks:\n            t[\"_agent_id\"] = child.name\n        all_tasks.extend(tasks)\n    return all_tasks\n\n\n# ─── Message / inbox ───\n\ndef write_inbox_message(agent_dir, sender, content, msg_type=\"指令\"):\n    \"\"\"Write a message to an agent's inbox directory. Returns the message file path.\"\"\"\n    import uuid\n    from datetime import datetime\n    agent_dir = Path(agent_dir)\n    inbox_dir = agent_dir / \"inbox\"\n    inbox_dir.mkdir(parents=True, exist_ok=True)\n    now = datetime.now()\n    ts = now.strftime(\"%Y%m%d_%H%M\")\n    msg_file = inbox_dir / f\"{sender}_{ts}_{uuid.uuid4().hex[:8]}.md\"\n    msg_file.write_text(\n        f\"# 来自 {sender} 的消息\\n- 类型：{msg_type}\\n- 时间：{now.strftime('%Y-%m-%d %H:%M')}\\n\\n## 内容\\n{content}\\n\",\n        encoding=\"utf-8\",\n    )\n    return msg_file\n\n\n# ─── Agent enable/disable ───\n\ndef set_agent_enabled(agent_dir, enabled=True):\n    \"\"\"Enable or disable an agent by writing its AGENT marker.\"\"\"\n    agent_dir = Path(agent_dir)\n    marker = agent_dir / AGENT_MARKER\n    if enabled:\n        marker.write_text(\"type: main\\n\", encoding=\"utf-8\")\n    else:\n        marker.write_text(\"type: main\\ndisabled: true\\n\", encoding=\"utf-8\")\n\n\n# ─── File utilities ───\n\ndef get_recent_lines(filepath, n=100):\n    \"\"\"Read the last N lines from a text file.\"\"\"\n    filepath = Path(filepath)\n    if not filepath.exists():\n        return []\n    try:\n        with open(filepath, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n            lines = f.readlines()\n        return [l.rstrip(\"\\n\\r\") for l in lines[-n:]]\n    except OSError:\n        return []\n\n\ndef read_file_tail_incremental(filepath, last_pos=0):\n    \"\"\"Read only new content appended since last_pos.\n\n    Returns (new_lines, new_pos). Efficient for SSE/polling scenarios.\n    \"\"\"\n    filepath = Path(filepath)\n    if not filepath.exists():\n        return [], 0\n    try:\n        size = filepath.stat().st_size\n        if size < last_pos:\n            # File was truncated/rotated — read from start\n            last_pos = 0\n        if size == last_pos:\n            return [], last_pos\n        with open(filepath, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n            f.seek(last_pos)\n            new_content = f.read()\n            new_pos = f.tell()\n        lines = [l.rstrip(\"\\n\\r\") for l in new_content.splitlines()]\n        return lines, new_pos\n    except OSError:\n        return [], last_pos\n","numLines":279,"startLine":1,"totalLines":279}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_79184e68398e472c9eea8ceb","type":"tool_result","content":"1\t\"\"\"\n2\tLoopCLI WebUI Backend Server\n3\tREST API + static file hosting for the Agent control console.\n4\t\"\"\"\n5\t\n6\timport hmac\n7\timport json\n8\timport os\n9\timport signal\n10\timport subprocess\n11\timport sys\n12\timport time\n13\timport threading\n14\timport uuid\n15\tfrom datetime import datetime, timezone\n16\tfrom http.server import HTTPServer, SimpleHTTPRequestHandler\n17\tfrom socketserver import ThreadingMixIn\n18\tfrom pathlib import Path\n19\tfrom urllib.parse import urlparse, parse_qs\n20\t\n21\tfrom loopcli_lib import (\n22\t    LOOPCLI_ROOT,\n23\t    read_json,\n24\t    write_json,\n25\t    safe_agent_path,\n26\t    scan_agents,\n27\t    create_task,\n28\t    get_agent_tasks,\n29\t    get_all_agent_tasks,\n30\t    write_inbox_message,\n31\t    set_agent_enabled,\n32\t    get_recent_lines,\n33\t    read_file_tail_incremental,\n34\t)\n35\t\n36\tWEBUI_DIR = Path(__file__).parent.resolve()\n37\tMAIN_DIR = LOOPCLI_ROOT / \"main\"\n38\tLOOP_STATE_FILE = WEBUI_DIR / \"loop_state.json\"\n39\t\n40\t_loop_proc = None\n41\t_loop_lock = threading.Lock()\n42\tAPI_KEY = os.environ.get(\"LOOPCLI_API_KEY\", \"\")\n43\tMAX_BODY_SIZE = 10 * 1024  # 10KB\n44\t\n45\t_raw_cors = os.environ.get(\"CORS_ORIGINS\", \"\").strip()\n46\tif _raw_cors:\n47\t    CORS_ORIGINS = [o.strip() for o in _raw_cors.split(\",\") if o.strip()]\n48\telse:\n49\t    CORS_ORIGINS = [\"http://localhost:3000\"]\n50\t\n51\t_write_semaphore = threading.Semaphore(10)\n52\t\n53\t_sse_connections = 0\n54\t_sse_lock = threading.Lock()\n55\tSSE_MAX_CONNECTIONS = 10\n56\tSSE_TIMEOUT_SECONDS = 300\n57\tSSE_HEARTBEAT_INTERVAL = 30\n58\t\n59\t\n60\tdef get_main_tasks():\n61\t    return read_json(MAIN_DIR / \"memory\" / \"tasks.json\", [])\n62\t\n63\t\n64\t# --- Loop Process Management ---\n65\t\n66\tdef get_loop_state():\n67\t    return read_json(LOOP_STATE_FILE, {\n68\t        \"status\": \"stopped\", \"pid\": None,\n69\t        \"started_at\": None, \"iterations\": 0, \"total_iterations\": 0,\n70\t    })\n71\t\n72\t\n73\tdef set_loop_state(state):\n74\t    write_json(LOOP_STATE_FILE, state)\n75\t\n76\t\n77\tdef _is_pid_alive(pid):\n78\t    if not pid:\n79\t        return False\n80\t    try:\n81\t        os.kill(pid, 0)\n82\t        return True\n83\t    except (ProcessLookupError, PermissionError, OSError):\n84\t        return False\n85\t\n86\t\n87\tdef _monitor_loopcli(proc):\n88\t    proc.wait()\n89\t    with _loop_lock:\n90\t        state = get_loop_state()\n91\t        if state.get(\"pid\") == proc.pid:\n92\t            state[\"status\"] = \"stopped\"\n93\t            state[\"pid\"] = None\n94\t            state[\"ended_at\"] = datetime.now().isoformat()\n95\t            set_loop_state(state)\n96\t\n97\t\n98\tdef start_loopcli_process(iterations=0):\n99\t    global _loop_proc\n100\t    with _loop_lock:\n101\t        state = get_loop_state()\n102\t        if state.get(\"status\") == \"running\" and _is_pid_alive(state.get(\"pid\")):\n103\t            return {\"error\": \"Already running\"}, 409\n104\t\n105\t        cmd = [sys.executable, str(LOOPCLI_ROOT / \"run.py\"), \"run\"]\n106\t        if iterations > 0:\n107\t            cmd.extend([\"-n\", str(iterations)])\n108\t\n109\t        proc = subprocess.Popen(\n110\t            cmd,\n111\t            stdout=subprocess.DEVNULL,\n112\t            stderr=subprocess.DEVNULL,\n113\t            creationflags=getattr(subprocess, \"CREATE_NO_WINDOW\", 0),\n114\t        )\n115\t        _loop_proc = proc\n116\t\n117\t        state = {\n118\t            \"status\": \"running\",\n119\t            \"pid\": proc.pid,\n120\t            \"started_at\": datetime.now().isoformat(),\n121\t            \"iterations\": iterations,\n122\t            \"total_iterations\": 0,\n123\t        }\n124\t        set_loop_state(state)\n125\t\n126\t        t = threading.Thread(target=_monitor_loopcli, args=(proc,), daemon=True)\n127\t        t.start()\n128\t        return state, 200\n129\t\n130\t\n131\tdef stop_loopcli_process():\n132\t    global _loop_proc\n133\t    with _loop_lock:\n134\t        state = get_loop_state()\n135\t        pid = state.get(\"pid\")\n136\t        if not pid or not _is_pid_alive(pid):\n137\t            state[\"status\"] = \"stopped\"\n138\t            state[\"pid\"] = None\n139\t            set_loop_state(state)\n140\t            return {\"error\": \"Not running\"}, 409\n141\t\n142\t        try:\n143\t            os.kill(pid, signal.SIGTERM)\n144\t        except OSError:\n145\t            pass\n146\t        if _loop_proc and _loop_proc.pid == pid:\n147\t            try:\n148\t                _loop_proc.terminate()\n149\t            except OSError:\n150\t                pass\n151\t            _loop_proc = None\n152\t\n153\t        state[\"status\"] = \"stopped\"\n154\t        state[\"pid\"] = None\n155\t        state[\"ended_at\"] = datetime.now().isoformat()\n156\t        set_loop_state(state)\n157\t        return {\"status\": \"stopped\"}, 200\n158\t\n159\t\n160\tclass WebUIHandler(SimpleHTTPRequestHandler):\n161\t    def __init__(self, *args, **kwargs):\n162\t        super().__init__(*args, directory=str(WEBUI_DIR), **kwargs)\n163\t\n164\t    def log_message(self, format, *args):\n165\t        ts = datetime.now().strftime(\"%H:%M:%S\")\n166\t        sys.stdout.write(f\"[{ts}] {format % args}\\n\")\n167\t        sys.stdout.flush()\n168\t\n169\t    def _send_json(self, data, status=200):\n170\t        body = json.dumps(data, ensure_ascii=False, indent=2).encode(\"utf-8\")\n171\t        self.send_response(status)\n172\t        self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n173\t        self.send_header(\"Content-Length\", str(len(body)))\n174\t        self.end_headers()\n175\t        self.wfile.write(body)\n176\t\n177\t    def _read_body(self):\n178\t        length = int(self.headers.get(\"Content-Length\", 0))\n179\t        if length == 0:\n180\t            return {}\n181\t        if length > MAX_BODY_SIZE:\n182\t            self._send_json({\"error\": \"Request body too large\"}, status=413)\n183\t            return None\n184\t        raw = self.rfile.read(length)\n185\t        try:\n186\t            return json.loads(raw.decode(\"utf-8\"))\n187\t        except (json.JSONDecodeError, UnicodeDecodeError) as e:\n188\t            self._send_json({\"error\": f\"Invalid JSON: {e}\"}, status=400)\n189\t            return None\n190\t\n191\t    def _require_auth(self):\n192\t        if not API_KEY:\n193\t            return True\n194\t        key = self.headers.get(\"X-API-Key\", \"\") or parse_qs(urlparse(self.path).query).get(\"key\", [\"\"])[0]\n195\t        if not hmac.compare_digest(key, API_KEY):\n196\t            self._send_json({\"error\": \"Unauthorized\"}, status=401)\n197\t            return False\n198\t        return True\n199\t\n200\t    def _cors_headers(self):\n201\t        origin = self.headers.get(\"Origin\", \"\")\n202\t        if CORS_ORIGINS:\n203\t            if origin in CORS_ORIGINS:\n204\t                self.send_header(\"Access-Control-Allow-Origin\", origin)\n205\t                self.send_header(\"Vary\", \"Origin\")\n206\t        else:\n207\t            self.send_header(\"Access-Control-Allow-Origin\", \"*\")\n208\t        self.send_header(\"Access-Control-Allow-Methods\", \"GET, POST, OPTIONS\")\n209\t        self.send_header(\"Access-Control-Allow-Headers\", \"Content-Type\")\n210\t\n211\t    # ---------- SSE helpers ----------\n212\t\n213\t    def _send_sse_event(self, data):\n214\t        payload = f\"data: {json.dumps(data, ensure_ascii=False)}\\n\\n\"\n215\t        self.wfile.write(payload.encode(\"utf-8\"))\n216\t        self.wfile.flush()\n217\t\n218\t    def _handle_sse_logs(self):\n219\t        global _sse_connections\n220\t        with _sse_lock:\n221\t            if _sse_connections >= SSE_MAX_CONNECTIONS:\n222\t                return self._send_json({\"error\": \"Max SSE connections reached\"}, status=503)\n223\t            _sse_connections += 1\n224\t\n225\t        params = parse_qs(urlparse(self.path).query)\n226\t        agent_id = params.get(\"agent\", [None])[0]\n227\t        if agent_id:\n228\t            agent_dir = safe_agent_path(agent_id)\n229\t            if not agent_dir:\n230\t                with _sse_lock:\n231\t                    _sse_connections -= 1\n232\t                return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n233\t            log_path = agent_dir / \"log\" / \"run.md\"\n234\t        else:\n235\t            log_path = MAIN_DIR / \"log\" / \"run.md\"\n236\t\n237\t        self.send_response(200)\n238\t        self.send_header(\"Content-Type\", \"text/event-stream\")\n239\t        self.send_header(\"Cache-Control\", \"no-cache\")\n240\t        self.send_header(\"Connection\", \"keep-alive\")\n241\t        self.send_header(\"X-Accel-Buffering\", \"no\")\n242\t        self._cors_headers()\n243\t        self.end_headers()\n244\t\n245\t        last_pos = 0\n246\t        start_time = time.time()\n247\t        last_heartbeat = time.time()\n248\t        try:\n249\t            while True:\n250\t                now = time.time()\n251\t                if now - start_time > SSE_TIMEOUT_SECONDS:\n252\t                    self._send_sse_event({\"event\": \"timeout\", \"ts\": datetime.now().isoformat()})\n253\t                    break\n254\t                if now - last_heartbeat >= SSE_HEARTBEAT_INTERVAL:\n255\t                    self.wfile.write(b\": heartbeat\\n\\n\")\n256\t                    self.wfile.flush()\n257\t                    last_heartbeat = now\n258\t                if log_path.exists():\n259\t                    lines, last_pos = read_file_tail_incremental(log_path, last_pos)\n260\t                    if lines:\n261\t                        self._send_sse_event({\n262\t                            \"agent\": agent_id,\n263\t                            \"lines\": lines,\n264\t                            \"ts\": datetime.now().isoformat(),\n265\t                        })\n266\t                else:\n267\t                    if last_pos != -1:\n268\t                        self._send_sse_event({\"agent\": agent_id, \"lines\": [], \"ts\": datetime.now().isoformat()})\n269\t                        last_pos = -1\n270\t                time.sleep(1)\n271\t        except (BrokenPipeError, ConnectionResetError, OSError):\n272\t            pass\n273\t        finally:\n274\t            with _sse_lock:\n275\t                _sse_connections -= 1\n276\t\n277\t    # ---------- GET routes ----------\n278\t\n279\t    def do_GET(self):\n280\t        parsed = urlparse(self.path)\n281\t        path = parsed.path\n282\t\n283\t        if path == \"/api/agents\":\n284\t            return self._send_json(scan_agents())\n285\t\n286\t        if path == \"/api/tasks\":\n287\t            params = parse_qs(parsed.query)\n288\t            agent_id = params.get(\"agent\", [None])[0]\n289\t            if agent_id == \"__all__\":\n290\t                return self._send_json(get_all_agent_tasks())\n291\t            if agent_id:\n292\t                tasks = get_agent_tasks(agent_id)\n293\t                if tasks is None:\n294\t                    return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n295\t                return self._send_json(tasks)\n296\t            return self._send_json(get_main_tasks())\n297\t\n298\t        if path.startswith(\"/api/agents/\") and path.endswith(\"/tasks\"):\n299\t            agent_id = path[len(\"/api/agents/\"):-len(\"/tasks\")]\n300\t            tasks = get_agent_tasks(agent_id)\n301\t            if tasks is None:\n302\t                return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n303\t            return self._send_json(tasks)\n304\t\n305\t        if path == \"/api/logs\":\n306\t            params = parse_qs(parsed.query)\n307\t            n = int(params.get(\"n\", [\"100\"])[0])\n308\t            agent_id = params.get(\"agent\", [None])[0]\n309\t            if agent_id:\n310\t                agent_dir = safe_agent_path(agent_id)\n311\t                if not agent_dir:\n312\t                    return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n313\t                log_path = agent_dir / \"log\" / \"run.md\"\n314\t            else:\n315\t                log_path = MAIN_DIR / \"log\" / \"run.md\"\n316\t            lines = get_recent_lines(log_path, n)\n317\t            return self._send_json({\"agent\": agent_id, \"lines\": lines})\n318\t\n319\t        if path == \"/api/logs/stream\":\n320\t            return self._handle_sse_logs()\n321\t\n322\t        if path == \"/api/loopcli/status\":\n323\t            return self._handle_loopcli_status()\n324\t\n325\t        # Static files\n326\t        super().do_GET()\n327\t\n328\t    # ---------- POST routes ----------\n329\t\n330\t    def do_POST(self):\n331\t        if not _write_semaphore.acquire(timeout=5):\n332\t            return self._send_json({\"error\": \"Server busy, try again\"}, status=503)\n333\t        try:\n334\t            self._do_POST_impl()\n335\t        finally:\n336\t            _write_semaphore.release()\n337\t\n338\t    def _do_POST_impl(self):\n339\t        parsed = urlparse(self.path)\n340\t        path = parsed.path\n341\t\n342\t        if not self._require_auth():\n343\t            return\n344\t\n345\t        if path == \"/api/tasks\":\n346\t            return self._handle_create_task()\n347\t        if path == \"/api/agents/start\":\n348\t            return self._handle_agent_start()\n349\t        if path == \"/api/loopcli/start\":\n350\t            return self._handle_loopcli_start()\n351\t        if path == \"/api/loopcli/stop\":\n352\t            return self._handle_loopcli_stop()\n353\t        if path == \"/api/loopcli/restart\":\n354\t            return self._handle_loopcli_restart()\n355\t        if path == \"/api/loopcli/dispatch\":\n356\t            return self._handle_loopcli_dispatch()\n357\t        if path == \"/api/messages/send\":\n358\t            return self._handle_message_send()\n359\t        if path == \"/api/agents/enable\":\n360\t            return self._handle_agent_enable(\"enable\")\n361\t        if path == \"/api/agents/disable\":\n362\t            return self._handle_agent_enable(\"disable\")\n363\t\n364\t        self._send_json({\"error\": \"Not found\"}, status=404)\n365\t\n366\t    # ---------- OPTIONS (CORS preflight) ----------\n367\t\n368\t    def do_OPTIONS(self):\n369\t        self.send_response(204)\n370\t        self._cors_headers()\n371\t        self.end_headers()\n372\t\n373\t    # ---------- Handlers ----------\n374\t\n375\t    def _handle_create_task(self):\n376\t        body = self._read_body()\n377\t        if body is None:\n378\t            return\n379\t        title = body.get(\"title\", \"\").strip()\n380\t        if not title:\n381\t            return self._send_json({\"error\": \"title is required\"}, status=400)\n382\t\n383\t        assignee = body.get(\"assignee\") or \"main\"\n384\t        task = create_task(\n385\t            MAIN_DIR, title,\n386\t            description=body.get(\"description\", \"\"),\n387\t            assignee=assignee,\n388\t        )\n389\t        self._send_json(task, status=201)\n390\t\n391\t    def _handle_agent_start(self):\n392\t        body = self._read_body()\n393\t        if body is None:\n394\t            return\n395\t        agent_id = body.get(\"agent\", \"\").strip()\n396\t        if not agent_id:\n397\t            return self._send_json({\"error\": \"agent is required\"}, status=400)\n398\t\n399\t        agent_dir = safe_agent_path(agent_id)\n400\t        if not agent_dir:\n401\t            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n402\t\n403\t        prompt_file = agent_dir / \"PROMPT.md\"\n404\t        if not prompt_file.exists():\n405\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found or no PROMPT.md\"}, status=404)\n406\t\n407\t        prompt = prompt_file.read_text(encoding=\"utf-8\")\n408\t        proc = subprocess.Popen(\n409\t            [\"claude\", \"--print\"],\n410\t            stdin=subprocess.PIPE,\n411\t            stdout=subprocess.PIPE,\n412\t            stderr=subprocess.PIPE,\n413\t            cwd=str(agent_dir),\n414\t        )\n415\t        proc.stdin.write(prompt.encode(\"utf-8\"))\n416\t        proc.stdin.close()\n417\t\n418\t        self._send_json({\n419\t            \"agent\": agent_id,\n420\t            \"pid\": proc.pid,\n421\t            \"status\": \"started\",\n422\t        })\n423\t\n424\t    # --- Loop control handlers ---\n425\t\n426\t    def _handle_loopcli_status(self):\n427\t        state = get_loop_state()\n428\t        pid = state.get(\"pid\")\n429\t        if state.get(\"status\") == \"running\" and pid and not _is_pid_alive(pid):\n430\t            state[\"status\"] = \"stopped\"\n431\t            state[\"pid\"] = None\n432\t            state[\"ended_at\"] = datetime.now().isoformat()\n433\t            set_loop_state(state)\n434\t\n435\t        uptime = 0\n436\t        if state.get(\"started_at\"):\n437\t            try:\n438\t                started = datetime.fromisoformat(state[\"started_at\"])\n439\t                uptime = int((datetime.now() - started).total_seconds())\n440\t            except (ValueError, TypeError):\n441\t                pass\n442\t        state[\"uptime_seconds\"] = uptime\n443\t        self._send_json(state)\n444\t\n445\t    def _handle_loopcli_start(self):\n446\t        body = self._read_body()\n447\t        if body is None:\n448\t            return\n449\t        iterations = int(body.get(\"iterations\", 0))\n450\t        data, status = start_loopcli_process(iterations)\n451\t        self._send_json(data, status)\n452\t\n453\t    def _handle_loopcli_stop(self):\n454\t        data, status = stop_loopcli_process()\n455\t        self._send_json(data, status)\n456\t\n457\t    def _handle_loopcli_restart(self):\n458\t        body = self._read_body()\n459\t        if body is None:\n460\t            return\n461\t        stop_loopcli_process()\n462\t        time.sleep(0.5)\n463\t        iterations = int(body.get(\"iterations\", 0))\n464\t        data, status = start_loopcli_process(iterations)\n465\t        self._send_json(data, status)\n466\t\n467\t    def _handle_loopcli_dispatch(self):\n468\t        body = self._read_body()\n469\t        if body is None:\n470\t            return\n471\t        agent_id = body.get(\"agent\", \"\").strip()\n472\t        title = body.get(\"title\", \"\").strip()\n473\t        if not agent_id or not title:\n474\t            return self._send_json({\"error\": \"agent and title are required\"}, status=400)\n475\t\n476\t        agent_dir = safe_agent_path(agent_id)\n477\t        if not agent_dir or not (agent_dir / \"AGENT\").exists():\n478\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n479\t\n480\t        task = create_task(\n481\t            agent_dir, title,\n482\t            description=body.get(\"description\", \"\"),\n483\t            assignee=agent_id,\n484\t        )\n485\t\n486\t        # Start claude process for this agent\n487\t        prompt_file = agent_dir / \"PROMPT.md\"\n488\t        prompt = \"\"\n489\t        if prompt_file.exists():\n490\t            prompt = prompt_file.read_text(encoding=\"utf-8\")\n491\t\n492\t        proc = subprocess.Popen(\n493\t            [\"claude\", \"--print\", \"--dangerously-skip-permissions\"],\n494\t            stdin=subprocess.PIPE,\n495\t            stdout=subprocess.DEVNULL,\n496\t            stderr=subprocess.DEVNULL,\n497\t            cwd=str(agent_dir),\n498\t        )\n499\t        if prompt:\n500\t            proc.stdin.write(prompt.encode(\"utf-8\"))\n501\t            proc.stdin.close()\n502\t\n503\t        self._send_json({\n504\t            \"task\": task,\n505\t            \"pid\": proc.pid,\n506\t            \"status\": \"dispatched\",\n507\t        }, status=201)\n508\t\n509\t    def _handle_message_send(self):\n510\t        body = self._read_body()\n511\t        if body is None:\n512\t            return\n513\t        content = body.get(\"content\", \"\").strip()\n514\t        if not content:\n515\t            return self._send_json({\"error\": \"content is required\"}, status=400)\n516\t\n517\t        agent_id = body.get(\"agent\", \"main\").strip() or \"main\"\n518\t        agent_dir = safe_agent_path(agent_id)\n519\t        if not agent_dir:\n520\t            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n521\t        if not (agent_dir / \"AGENT\").exists():\n522\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n523\t\n524\t        msg_file = write_inbox_message(agent_dir, \"webui\", content)\n525\t        self._send_json({\"status\": \"sent\", \"agent\": agent_id, \"file\": msg_file.name}, status=201)\n526\t\n527\t    def _handle_agent_enable(self, action):\n528\t        body = self._read_body()\n529\t        if body is None:\n530\t            return\n531\t        agent_id = body.get(\"agent\", \"\").strip()\n532\t        if not agent_id:\n533\t            return self._send_json({\"error\": \"agent is required\"}, status=400)\n534\t        if agent_id == \"main\":\n535\t            return self._send_json({\"error\": \"cannot disable main agent\"}, status=400)\n536\t\n537\t        agent_dir = safe_agent_path(agent_id)\n538\t        if not agent_dir:\n539\t            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n540\t        if not (agent_dir / \"AGENT\").exists():\n541\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n542\t\n543\t        set_agent_enabled(agent_dir, action == \"enable\")\n544\t        self._send_json({\"status\": \"ok\", \"agent\": agent_id, \"enabled\": action == \"enable\"})\n545\t\n546\t\n547\tclass ThreadedHTTPServer(ThreadingMixIn, HTTPServer):\n548\t    daemon_threads = True\n549\t\n550\t\n551\tdef main():\n552\t    host = os.environ.get(\"LOOPCLI_HOST\", \"127.0.0.1\")\n553\t    port = 8080\n554\t    server = ThreadedHTTPServer((host, port), WebUIHandler)\n555\t    print(f\"LoopCLI WebUI Server running on http://{host}:{port}\")\n556\t    print(f\"Static files served from: {WEBUI_DIR}\")\n557\t    print(f\"Agent root: {LOOPCLI_ROOT}\")\n558\t    print(\"Press Ctrl+C to stop.\")\n559\t    try:\n560\t        server.serve_forever()\n561\t    except KeyboardInterrupt:\n562\t        print(\"\\nShutting down.\")\n563\t        server.server_close()\n564\t\n565\t\n566\tif __name__ == \"__main__\":\n567\t    main()\n568\t"}]},"parent_tool_use_id":null,"session_id":"a11b390c-8618-467f-b876-d1d624ad9195","uuid":"5137d306-a3ae-4722-89c8-42fe0200ce97","timestamp":"2026-05-21T05:05:32.019Z","tool_use_result":{"type":"text","file":{"filePath":"D:/loopcli/main/webui/server.py","content":"\"\"\"\nLoopCLI WebUI Backend Server\nREST API + static file hosting for the Agent control console.\n\"\"\"\n\nimport hmac\nimport json\nimport os\nimport signal\nimport subprocess\nimport sys\nimport time\nimport threading\nimport uuid\nfrom datetime import datetime, timezone\nfrom http.server import HTTPServer, SimpleHTTPRequestHandler\nfrom socketserver import ThreadingMixIn\nfrom pathlib import Path\nfrom urllib.parse import urlparse, parse_qs\n\nfrom loopcli_lib import (\n    LOOPCLI_ROOT,\n    read_json,\n    write_json,\n    safe_agent_path,\n    scan_agents,\n    create_task,\n    get_agent_tasks,\n    get_all_agent_tasks,\n    write_inbox_message,\n    set_agent_enabled,\n    get_recent_lines,\n    read_file_tail_incremental,\n)\n\nWEBUI_DIR = Path(__file__).parent.resolve()\nMAIN_DIR = LOOPCLI_ROOT / \"main\"\nLOOP_STATE_FILE = WEBUI_DIR / \"loop_state.json\"\n\n_loop_proc = None\n_loop_lock = threading.Lock()\nAPI_KEY = os.environ.get(\"LOOPCLI_API_KEY\", \"\")\nMAX_BODY_SIZE = 10 * 1024  # 10KB\n\n_raw_cors = os.environ.get(\"CORS_ORIGINS\", \"\").strip()\nif _raw_cors:\n    CORS_ORIGINS = [o.strip() for o in _raw_cors.split(\",\") if o.strip()]\nelse:\n    CORS_ORIGINS = [\"http://localhost:3000\"]\n\n_write_semaphore = threading.Semaphore(10)\n\n_sse_connections = 0\n_sse_lock = threading.Lock()\nSSE_MAX_CONNECTIONS = 10\nSSE_TIMEOUT_SECONDS = 300\nSSE_HEARTBEAT_INTERVAL = 30\n\n\ndef get_main_tasks():\n    return read_json(MAIN_DIR / \"memory\" / \"tasks.json\", [])\n\n\n# --- Loop Process Management ---\n\ndef get_loop_state():\n    return read_json(LOOP_STATE_FILE, {\n        \"status\": \"stopped\", \"pid\": None,\n        \"started_at\": None, \"iterations\": 0, \"total_iterations\": 0,\n    })\n\n\ndef set_loop_state(state):\n    write_json(LOOP_STATE_FILE, state)\n\n\ndef _is_pid_alive(pid):\n    if not pid:\n        return False\n    try:\n        os.kill(pid, 0)\n        return True\n    except (ProcessLookupError, PermissionError, OSError):\n        return False\n\n\ndef _monitor_loopcli(proc):\n    proc.wait()\n    with _loop_lock:\n        state = get_loop_state()\n        if state.get(\"pid\") == proc.pid:\n            state[\"status\"] = \"stopped\"\n            state[\"pid\"] = None\n            state[\"ended_at\"] = datetime.now().isoformat()\n            set_loop_state(state)\n\n\ndef start_loopcli_process(iterations=0):\n    global _loop_proc\n    with _loop_lock:\n        state = get_loop_state()\n        if state.get(\"status\") == \"running\" and _is_pid_alive(state.get(\"pid\")):\n            return {\"error\": \"Already running\"}, 409\n\n        cmd = [sys.executable, str(LOOPCLI_ROOT / \"run.py\"), \"run\"]\n        if iterations > 0:\n            cmd.extend([\"-n\", str(iterations)])\n\n        proc = subprocess.Popen(\n            cmd,\n            stdout=subprocess.DEVNULL,\n            stderr=subprocess.DEVNULL,\n            creationflags=getattr(subprocess, \"CREATE_NO_WINDOW\", 0),\n        )\n        _loop_proc = proc\n\n        state = {\n            \"status\": \"running\",\n            \"pid\": proc.pid,\n            \"started_at\": datetime.now().isoformat(),\n            \"iterations\": iterations,\n            \"total_iterations\": 0,\n        }\n        set_loop_state(state)\n\n        t = threading.Thread(target=_monitor_loopcli, args=(proc,), daemon=True)\n        t.start()\n        return state, 200\n\n\ndef stop_loopcli_process():\n    global _loop_proc\n    with _loop_lock:\n        state = get_loop_state()\n        pid = state.get(\"pid\")\n        if not pid or not _is_pid_alive(pid):\n            state[\"status\"] = \"stopped\"\n            state[\"pid\"] = None\n            set_loop_state(state)\n            return {\"error\": \"Not running\"}, 409\n\n        try:\n            os.kill(pid, signal.SIGTERM)\n        except OSError:\n            pass\n        if _loop_proc and _loop_proc.pid == pid:\n            try:\n                _loop_proc.terminate()\n            except OSError:\n                pass\n            _loop_proc = None\n\n        state[\"status\"] = \"stopped\"\n        state[\"pid\"] = None\n        state[\"ended_at\"] = datetime.now().isoformat()\n        set_loop_state(state)\n        return {\"status\": \"stopped\"}, 200\n\n\nclass WebUIHandler(SimpleHTTPRequestHandler):\n    def __init__(self, *args, **kwargs):\n        super().__init__(*args, directory=str(WEBUI_DIR), **kwargs)\n\n    def log_message(self, format, *args):\n        ts = datetime.now().strftime(\"%H:%M:%S\")\n        sys.stdout.write(f\"[{ts}] {format % args}\\n\")\n        sys.stdout.flush()\n\n    def _send_json(self, data, status=200):\n        body = json.dumps(data, ensure_ascii=False, indent=2).encode(\"utf-8\")\n        self.send_response(status)\n        self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def _read_body(self):\n        length = int(self.headers.get(\"Content-Length\", 0))\n        if length == 0:\n            return {}\n        if length > MAX_BODY_SIZE:\n            self._send_json({\"error\": \"Request body too large\"}, status=413)\n            return None\n        raw = self.rfile.read(length)\n        try:\n            return json.loads(raw.decode(\"utf-8\"))\n        except (json.JSONDecodeError, UnicodeDecodeError) as e:\n            self._send_json({\"error\": f\"Invalid JSON: {e}\"}, status=400)\n            return None\n\n    def _require_auth(self):\n        if not API_KEY:\n            return True\n        key = self.headers.get(\"X-API-Key\", \"\") or parse_qs(urlparse(self.path).query).get(\"key\", [\"\"])[0]\n        if not hmac.compare_digest(key, API_KEY):\n            self._send_json({\"error\": \"Unauthorized\"}, status=401)\n            return False\n        return True\n\n    def _cors_headers(self):\n        origin = self.headers.get(\"Origin\", \"\")\n        if CORS_ORIGINS:\n            if origin in CORS_ORIGINS:\n                self.send_header(\"Access-Control-Allow-Origin\", origin)\n                self.send_header(\"Vary\", \"Origin\")\n        else:\n            self.send_header(\"Access-Control-Allow-Origin\", \"*\")\n        self.send_header(\"Access-Control-Allow-Methods\", \"GET, POST, OPTIONS\")\n        self.send_header(\"Access-Control-Allow-Headers\", \"Content-Type\")\n\n    # ---------- SSE helpers ----------\n\n    def _send_sse_event(self, data):\n        payload = f\"data: {json.dumps(data, ensure_ascii=False)}\\n\\n\"\n        self.wfile.write(payload.encode(\"utf-8\"))\n        self.wfile.flush()\n\n    def _handle_sse_logs(self):\n        global _sse_connections\n        with _sse_lock:\n            if _sse_connections >= SSE_MAX_CONNECTIONS:\n                return self._send_json({\"error\": \"Max SSE connections reached\"}, status=503)\n            _sse_connections += 1\n\n        params = parse_qs(urlparse(self.path).query)\n        agent_id = params.get(\"agent\", [None])[0]\n        if agent_id:\n            agent_dir = safe_agent_path(agent_id)\n            if not agent_dir:\n                with _sse_lock:\n                    _sse_connections -= 1\n                return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n            log_path = agent_dir / \"log\" / \"run.md\"\n        else:\n            log_path = MAIN_DIR / \"log\" / \"run.md\"\n\n        self.send_response(200)\n        self.send_header(\"Content-Type\", \"text/event-stream\")\n        self.send_header(\"Cache-Control\", \"no-cache\")\n        self.send_header(\"Connection\", \"keep-alive\")\n        self.send_header(\"X-Accel-Buffering\", \"no\")\n        self._cors_headers()\n        self.end_headers()\n\n        last_pos = 0\n        start_time = time.time()\n        last_heartbeat = time.time()\n        try:\n            while True:\n                now = time.time()\n                if now - start_time > SSE_TIMEOUT_SECONDS:\n                    self._send_sse_event({\"event\": \"timeout\", \"ts\": datetime.now().isoformat()})\n                    break\n                if now - last_heartbeat >= SSE_HEARTBEAT_INTERVAL:\n                    self.wfile.write(b\": heartbeat\\n\\n\")\n                    self.wfile.flush()\n                    last_heartbeat = now\n                if log_path.exists():\n                    lines, last_pos = read_file_tail_incremental(log_path, last_pos)\n                    if lines:\n                        self._send_sse_event({\n                            \"agent\": agent_id,\n                            \"lines\": lines,\n                            \"ts\": datetime.now().isoformat(),\n                        })\n                else:\n                    if last_pos != -1:\n                        self._send_sse_event({\"agent\": agent_id, \"lines\": [], \"ts\": datetime.now().isoformat()})\n                        last_pos = -1\n                time.sleep(1)\n        except (BrokenPipeError, ConnectionResetError, OSError):\n            pass\n        finally:\n            with _sse_lock:\n                _sse_connections -= 1\n\n    # ---------- GET routes ----------\n\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        path = parsed.path\n\n        if path == \"/api/agents\":\n            return self._send_json(scan_agents())\n\n        if path == \"/api/tasks\":\n            params = parse_qs(parsed.query)\n            agent_id = params.get(\"agent\", [None])[0]\n            if agent_id == \"__all__\":\n                return self._send_json(get_all_agent_tasks())\n            if agent_id:\n                tasks = get_agent_tasks(agent_id)\n                if tasks is None:\n                    return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n                return self._send_json(tasks)\n            return self._send_json(get_main_tasks())\n\n        if path.startswith(\"/api/agents/\") and path.endswith(\"/tasks\"):\n            agent_id = path[len(\"/api/agents/\"):-len(\"/tasks\")]\n            tasks = get_agent_tasks(agent_id)\n            if tasks is None:\n                return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n            return self._send_json(tasks)\n\n        if path == \"/api/logs\":\n            params = parse_qs(parsed.query)\n            n = int(params.get(\"n\", [\"100\"])[0])\n            agent_id = params.get(\"agent\", [None])[0]\n            if agent_id:\n                agent_dir = safe_agent_path(agent_id)\n                if not agent_dir:\n                    return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n                log_path = agent_dir / \"log\" / \"run.md\"\n            else:\n                log_path = MAIN_DIR / \"log\" / \"run.md\"\n            lines = get_recent_lines(log_path, n)\n            return self._send_json({\"agent\": agent_id, \"lines\": lines})\n\n        if path == \"/api/logs/stream\":\n            return self._handle_sse_logs()\n\n        if path == \"/api/loopcli/status\":\n            return self._handle_loopcli_status()\n\n        # Static files\n        super().do_GET()\n\n    # ---------- POST routes ----------\n\n    def do_POST(self):\n        if not _write_semaphore.acquire(timeout=5):\n            return self._send_json({\"error\": \"Server busy, try again\"}, status=503)\n        try:\n            self._do_POST_impl()\n        finally:\n            _write_semaphore.release()\n\n    def _do_POST_impl(self):\n        parsed = urlparse(self.path)\n        path = parsed.path\n\n        if not self._require_auth():\n            return\n\n        if path == \"/api/tasks\":\n            return self._handle_create_task()\n        if path == \"/api/agents/start\":\n            return self._handle_agent_start()\n        if path == \"/api/loopcli/start\":\n            return self._handle_loopcli_start()\n        if path == \"/api/loopcli/stop\":\n            return self._handle_loopcli_stop()\n        if path == \"/api/loopcli/restart\":\n            return self._handle_loopcli_restart()\n        if path == \"/api/loopcli/dispatch\":\n            return self._handle_loopcli_dispatch()\n        if path == \"/api/messages/send\":\n            return self._handle_message_send()\n        if path == \"/api/agents/enable\":\n            return self._handle_agent_enable(\"enable\")\n        if path == \"/api/agents/disable\":\n            return self._handle_agent_enable(\"disable\")\n\n        self._send_json({\"error\": \"Not found\"}, status=404)\n\n    # ---------- OPTIONS (CORS preflight) ----------\n\n    def do_OPTIONS(self):\n        self.send_response(204)\n        self._cors_headers()\n        self.end_headers()\n\n    # ---------- Handlers ----------\n\n    def _handle_create_task(self):\n        body = self._read_body()\n        if body is None:\n            return\n        title = body.get(\"title\", \"\").strip()\n        if not title:\n            return self._send_json({\"error\": \"title is required\"}, status=400)\n\n        assignee = body.get(\"assignee\") or \"main\"\n        task = create_task(\n            MAIN_DIR, title,\n            description=body.get(\"description\", \"\"),\n            assignee=assignee,\n        )\n        self._send_json(task, status=201)\n\n    def _handle_agent_start(self):\n        body = self._read_body()\n        if body is None:\n            return\n        agent_id = body.get(\"agent\", \"\").strip()\n        if not agent_id:\n            return self._send_json({\"error\": \"agent is required\"}, status=400)\n\n        agent_dir = safe_agent_path(agent_id)\n        if not agent_dir:\n            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n\n        prompt_file = agent_dir / \"PROMPT.md\"\n        if not prompt_file.exists():\n            return self._send_json({\"error\": f\"Agent '{agent_id}' not found or no PROMPT.md\"}, status=404)\n\n        prompt = prompt_file.read_text(encoding=\"utf-8\")\n        proc = subprocess.Popen(\n            [\"claude\", \"--print\"],\n            stdin=subprocess.PIPE,\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            cwd=str(agent_dir),\n        )\n        proc.stdin.write(prompt.encode(\"utf-8\"))\n        proc.stdin.close()\n\n        self._send_json({\n            \"agent\": agent_id,\n            \"pid\": proc.pid,\n            \"status\": \"started\",\n        })\n\n    # --- Loop control handlers ---\n\n    def _handle_loopcli_status(self):\n        state = get_loop_state()\n        pid = state.get(\"pid\")\n        if state.get(\"status\") == \"running\" and pid and not _is_pid_alive(pid):\n            state[\"status\"] = \"stopped\"\n            state[\"pid\"] = None\n            state[\"ended_at\"] = datetime.now().isoformat()\n            set_loop_state(state)\n\n        uptime = 0\n        if state.get(\"started_at\"):\n            try:\n                started = datetime.fromisoformat(state[\"started_at\"])\n                uptime = int((datetime.now() - started).total_seconds())\n            except (ValueError, TypeError):\n                pass\n        state[\"uptime_seconds\"] = uptime\n        self._send_json(state)\n\n    def _handle_loopcli_start(self):\n        body = self._read_body()\n        if body is None:\n            return\n        iterations = int(body.get(\"iterations\", 0))\n        data, status = start_loopcli_process(iterations)\n        self._send_json(data, status)\n\n    def _handle_loopcli_stop(self):\n        data, status = stop_loopcli_process()\n        self._send_json(data, status)\n\n    def _handle_loopcli_restart(self):\n        body = self._read_body()\n        if body is None:\n            return\n        stop_loopcli_process()\n        time.sleep(0.5)\n        iterations = int(body.get(\"iterations\", 0))\n        data, status = start_loopcli_process(iterations)\n        self._send_json(data, status)\n\n    def _handle_loopcli_dispatch(self):\n        body = self._read_body()\n        if body is None:\n            return\n        agent_id = body.get(\"agent\", \"\").strip()\n        title = body.get(\"title\", \"\").strip()\n        if not agent_id or not title:\n            return self._send_json({\"error\": \"agent and title are required\"}, status=400)\n\n        agent_dir = safe_agent_path(agent_id)\n        if not agent_dir or not (agent_dir / \"AGENT\").exists():\n            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n\n        task = create_task(\n            agent_dir, title,\n            description=body.get(\"description\", \"\"),\n            assignee=agent_id,\n        )\n\n        # Start claude process for this agent\n        prompt_file = agent_dir / \"PROMPT.md\"\n        prompt = \"\"\n        if prompt_file.exists():\n            prompt = prompt_file.read_text(encoding=\"utf-8\")\n\n        proc = subprocess.Popen(\n            [\"claude\", \"--print\", \"--dangerously-skip-permissions\"],\n            stdin=subprocess.PIPE,\n            stdout=subprocess.DEVNULL,\n            stderr=subprocess.DEVNULL,\n            cwd=str(agent_dir),\n        )\n        if prompt:\n            proc.stdin.write(prompt.encode(\"utf-8\"))\n            proc.stdin.close()\n\n        self._send_json({\n            \"task\": task,\n            \"pid\": proc.pid,\n            \"status\": \"dispatched\",\n        }, status=201)\n\n    def _handle_message_send(self):\n        body = self._read_body()\n        if body is None:\n            return\n        content = body.get(\"content\", \"\").strip()\n        if not content:\n            return self._send_json({\"error\": \"content is required\"}, status=400)\n\n        agent_id = body.get(\"agent\", \"main\").strip() or \"main\"\n        agent_dir = safe_agent_path(agent_id)\n        if not agent_dir:\n            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n        if not (agent_dir / \"AGENT\").exists():\n            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n\n        msg_file = write_inbox_message(agent_dir, \"webui\", content)\n        self._send_json({\"status\": \"sent\", \"agent\": agent_id, \"file\": msg_file.name}, status=201)\n\n    def _handle_agent_enable(self, action):\n        body = self._read_body()\n        if body is None:\n            return\n        agent_id = body.get(\"agent\", \"\").strip()\n        if not agent_id:\n            return self._send_json({\"error\": \"agent is required\"}, status=400)\n        if agent_id == \"main\":\n            return self._send_json({\"error\": \"cannot disable main agent\"}, status=400)\n\n        agent_dir = safe_agent_path(agent_id)\n        if not agent_dir:\n            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n        if not (agent_dir / \"AGENT\").exists():\n            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n\n        set_agent_enabled(agent_dir, action == \"enable\")\n        self._send_json({\"status\": \"ok\", \"agent\": agent_id, \"enabled\": action == \"enable\"})\n\n\nclass ThreadedHTTPServer(ThreadingMixIn, HTTPServer):\n    daemon_threads = True\n\n\ndef main():\n    host = os.environ.get(\"LOOPCLI_HOST\", \"127.0.0.1\")\n    port = 8080\n    server = ThreadedHTTPServer((host, port), WebUIHandler)\n    print(f\"LoopCLI WebUI Server running on http://{host}:{port}\")\n    print(f\"Static files served from: {WEBUI_DIR}\")\n    print(f\"Agent root: {LOOPCLI_ROOT}\")\n    print(\"Press Ctrl+C to stop.\")\n    try:\n        server.serve_forever()\n    except KeyboardInterrupt:\n        print(\"\\nShutting down.\")\n        server.server_close()\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":568,"startLine":1,"totalLines":568}}}
