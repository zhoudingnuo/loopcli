{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_fd721f90fef04df9a42af229","type":"tool_result","content":"1\t\"\"\"\n2\tLoopCLI WebUI Backend Server\n3\tREST API + static file hosting for the Agent control console.\n4\t\"\"\"\n5\t\n6\timport json\n7\timport os\n8\timport signal\n9\timport subprocess\n10\timport sys\n11\timport time\n12\timport threading\n13\tfrom datetime import datetime, timezone\n14\tfrom http.server import HTTPServer, SimpleHTTPRequestHandler\n15\tfrom socketserver import ThreadingMixIn\n16\tfrom pathlib import Path\n17\tfrom urllib.parse import urlparse, parse_qs\n18\t\n19\tLOOPCLI_ROOT = Path(r\"D:\\loopcli\")\n20\tWEBUI_DIR = Path(__file__).parent.resolve()\n21\tMAIN_DIR = LOOPCLI_ROOT / \"main\"\n22\tLOOP_STATE_FILE = WEBUI_DIR / \"loop_state.json\"\n23\t\n24\t_loop_proc = None\n25\t_loop_lock = threading.Lock()\n26\tAPI_KEY = os.environ.get(\"LOOPCLI_API_KEY\", \"\")\n27\t\n28\tCORS_ORIGINS = [o.strip() for o in os.environ.get(\"CORS_ORIGINS\", \"\").split(\",\") if o.strip()]\n29\t\n30\t_write_semaphore = threading.Semaphore(10)\n31\t\n32\t_sse_connections = 0\n33\t_sse_lock = threading.Lock()\n34\tSSE_MAX_CONNECTIONS = 10\n35\tSSE_TIMEOUT_SECONDS = 300\n36\t\n37\t\n38\tdef read_json(path: Path, default=None):\n39\t    if not path.exists():\n40\t        return default if default is not None else {}\n41\t    try:\n42\t        return json.loads(path.read_text(encoding=\"utf-8\"))\n43\t    except (json.JSONDecodeError, OSError):\n44\t        return default if default is not None else {}\n45\t\n46\t\n47\tdef write_json(path: Path, data):\n48\t    path.parent.mkdir(parents=True, exist_ok=True)\n49\t    path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n50\t\n51\t\n52\tdef _safe_agent_path(agent_id: str) -> Path | None:\n53\t    if not agent_id or '/' in agent_id or '\\\\' in agent_id or '..' in agent_id:\n54\t        return None\n55\t    agent_dir = LOOPCLI_ROOT / agent_id\n56\t    try:\n57\t        agent_dir.resolve().relative_to(LOOPCLI_ROOT.resolve())\n58\t    except ValueError:\n59\t        return None\n60\t    return agent_dir\n61\t\n62\t\n63\tdef scan_agents():\n64\t    \"\"\"Scan loopcli root for agent directories (containing AGENT marker file).\"\"\"\n65\t    agents = []\n66\t    for child in LOOPCLI_ROOT.iterdir():\n67\t        if not child.is_dir():\n68\t            continue\n69\t        agent_marker = child / \"AGENT\"\n70\t        if not agent_marker.exists():\n71\t            continue\n72\t        state = read_json(child / \"memory\" / \"state.json\", {})\n73\t        soul_path = child / \"SOUL.md\"\n74\t        desc = \"\"\n75\t        if soul_path.exists():\n76\t            lines = soul_path.read_text(encoding=\"utf-8\").strip().splitlines()\n77\t            for line in lines:\n78\t                stripped = line.strip()\n79\t                if stripped and not stripped.startswith(\"#\"):\n80\t                    desc = stripped\n81\t                    break\n82\t        agents.append({\n83\t            \"id\": child.name,\n84\t            \"name\": state.get(\"agent\", child.name),\n85\t            \"status\": state.get(\"status\", \"unknown\"),\n86\t            \"description\": desc,\n87\t            \"last_run\": state.get(\"last_run\"),\n88\t            \"run_count\": state.get(\"run_count\", 0),\n89\t            \"current_task\": state.get(\"current_task\"),\n90\t        })\n91\t    return agents\n92\t\n93\t\n94\tdef get_main_tasks():\n95\t    return read_json(MAIN_DIR / \"memory\" / \"tasks.json\", [])\n96\t\n97\t\n98\tdef get_recent_lines(filepath: Path, n=100):\n99\t    if not filepath.exists():\n100\t        return []\n101\t    try:\n102\t        with open(filepath, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n103\t            lines = f.readlines()\n104\t        return [l.rstrip(\"\\n\\r\") for l in lines[-n:]]\n105\t    except OSError:\n106\t        return []\n107\t\n108\t\n109\t# --- Loop Process Management ---\n110\t\n111\tdef get_loop_state():\n112\t    return read_json(LOOP_STATE_FILE, {\n113\t        \"status\": \"stopped\", \"pid\": None,\n114\t        \"started_at\": None, \"iterations\": 0, \"total_iterations\": 0,\n115\t    })\n116\t\n117\t\n118\tdef set_loop_state(state):\n119\t    write_json(LOOP_STATE_FILE, state)\n120\t\n121\t\n122\tdef _is_pid_alive(pid):\n123\t    if not pid:\n124\t        return False\n125\t    try:\n126\t        os.kill(pid, 0)\n127\t        return True\n128\t    except (ProcessLookupError, PermissionError, OSError):\n129\t        return False\n130\t\n131\t\n132\tdef _monitor_loopcli(proc):\n133\t    proc.wait()\n134\t    with _loop_lock:\n135\t        state = get_loop_state()\n136\t        if state.get(\"pid\") == proc.pid:\n137\t            state[\"status\"] = \"stopped\"\n138\t            state[\"pid\"] = None\n139\t            state[\"ended_at\"] = datetime.now().isoformat()\n140\t            set_loop_state(state)\n141\t\n142\t\n143\tdef start_loopcli_process(iterations=0):\n144\t    global _loop_proc\n145\t    with _loop_lock:\n146\t        state = get_loop_state()\n147\t        if state.get(\"status\") == \"running\" and _is_pid_alive(state.get(\"pid\")):\n148\t            return {\"error\": \"Already running\"}, 409\n149\t\n150\t        cmd = [sys.executable, str(LOOPCLI_ROOT / \"run.py\"), \"run\"]\n151\t        if iterations > 0:\n152\t            cmd.extend([\"-n\", str(iterations)])\n153\t\n154\t        proc = subprocess.Popen(\n155\t            cmd,\n156\t            stdout=subprocess.DEVNULL,\n157\t            stderr=subprocess.DEVNULL,\n158\t            creationflags=getattr(subprocess, \"CREATE_NO_WINDOW\", 0),\n159\t        )\n160\t        _loop_proc = proc\n161\t\n162\t        state = {\n163\t            \"status\": \"running\",\n164\t            \"pid\": proc.pid,\n165\t            \"started_at\": datetime.now().isoformat(),\n166\t            \"iterations\": iterations,\n167\t            \"total_iterations\": 0,\n168\t        }\n169\t        set_loop_state(state)\n170\t\n171\t        t = threading.Thread(target=_monitor_loopcli, args=(proc,), daemon=True)\n172\t        t.start()\n173\t        return state, 200\n174\t\n175\t\n176\tdef stop_loopcli_process():\n177\t    global _loop_proc\n178\t    with _loop_lock:\n179\t        state = get_loop_state()\n180\t        pid = state.get(\"pid\")\n181\t        if not pid or not _is_pid_alive(pid):\n182\t            state[\"status\"] = \"stopped\"\n183\t            state[\"pid\"] = None\n184\t            set_loop_state(state)\n185\t            return {\"error\": \"Not running\"}, 409\n186\t\n187\t        try:\n188\t            os.kill(pid, signal.SIGTERM)\n189\t        except OSError:\n190\t            pass\n191\t        if _loop_proc and _loop_proc.pid == pid:\n192\t            try:\n193\t                _loop_proc.terminate()\n194\t            except OSError:\n195\t                pass\n196\t            _loop_proc = None\n197\t\n198\t        state[\"status\"] = \"stopped\"\n199\t        state[\"pid\"] = None\n200\t        state[\"ended_at\"] = datetime.now().isoformat()\n201\t        set_loop_state(state)\n202\t        return {\"status\": \"stopped\"}, 200\n203\t\n204\t\n205\tclass WebUIHandler(SimpleHTTPRequestHandler):\n206\t    def __init__(self, *args, **kwargs):\n207\t        super().__init__(*args, directory=str(WEBUI_DIR), **kwargs)\n208\t\n209\t    def log_message(self, format, *args):\n210\t        ts = datetime.now().strftime(\"%H:%M:%S\")\n211\t        sys.stdout.write(f\"[{ts}] {format % args}\\n\")\n212\t        sys.stdout.flush()\n213\t\n214\t    def _send_json(self, data, status=200):\n215\t        body = json.dumps(data, ensure_ascii=False, indent=2).encode(\"utf-8\")\n216\t        self.send_response(status)\n217\t        self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n218\t        self.send_header(\"Content-Length\", str(len(body)))\n219\t        self.end_headers()\n220\t        self.wfile.write(body)\n221\t\n222\t    def _read_body(self):\n223\t        length = int(self.headers.get(\"Content-Length\", 0))\n224\t        if length == 0:\n225\t            return {}\n226\t        raw = self.rfile.read(length)\n227\t        try:\n228\t            return json.loads(raw.decode(\"utf-8\"))\n229\t        except (json.JSONDecodeError, UnicodeDecodeError):\n230\t            return {}\n231\t\n232\t    def _cors_headers(self):\n233\t        origin = self.headers.get(\"Origin\", \"\")\n234\t        if CORS_ORIGINS:\n235\t            if origin in CORS_ORIGINS:\n236\t                self.send_header(\"Access-Control-Allow-Origin\", origin)\n237\t                self.send_header(\"Vary\", \"Origin\")\n238\t        else:\n239\t            self.send_header(\"Access-Control-Allow-Origin\", \"*\")\n240\t        self.send_header(\"Access-Control-Allow-Methods\", \"GET, POST, OPTIONS\")\n241\t        self.send_header(\"Access-Control-Allow-Headers\", \"Content-Type\")\n242\t\n243\t    # ---------- SSE helpers ----------\n244\t\n245\t    def _send_sse_event(self, data):\n246\t        payload = f\"data: {json.dumps(data, ensure_ascii=False)}\\n\\n\"\n247\t        self.wfile.write(payload.encode(\"utf-8\"))\n248\t        self.wfile.flush()\n249\t\n250\t    def _handle_sse_logs(self):\n251\t        global _sse_connections\n252\t        with _sse_lock:\n253\t            if _sse_connections >= SSE_MAX_CONNECTIONS:\n254\t                return self._send_json({\"error\": \"Max SSE connections reached\"}, status=503)\n255\t            _sse_connections += 1\n256\t\n257\t        params = parse_qs(urlparse(self.path).query)\n258\t        agent_id = params.get(\"agent\", [None])[0]\n259\t        if agent_id:\n260\t            agent_dir = _safe_agent_path(agent_id)\n261\t            if not agent_dir:\n262\t                with _sse_lock:\n263\t                    _sse_connections -= 1\n264\t                return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n265\t            log_path = agent_dir / \"log\" / \"run.md\"\n266\t        else:\n267\t            log_path = MAIN_DIR / \"log\" / \"run.md\"\n268\t\n269\t        self.send_response(200)\n270\t        self.send_header(\"Content-Type\", \"text/event-stream\")\n271\t        self.send_header(\"Cache-Control\", \"no-cache\")\n272\t        self.send_header(\"Connection\", \"keep-alive\")\n273\t        self.send_header(\"X-Accel-Buffering\", \"no\")\n274\t        self._cors_headers()\n275\t        self.end_headers()\n276\t\n277\t        last_size = 0\n278\t        start_time = time.time()\n279\t        try:\n280\t            while True:\n281\t                if time.time() - start_time > SSE_TIMEOUT_SECONDS:\n282\t                    self._send_sse_event({\"event\": \"timeout\", \"ts\": datetime.now().isoformat()})\n283\t                    break\n284\t                if log_path.exists():\n285\t                    current_size = log_path.stat().st_size\n286\t                    if current_size != last_size:\n287\t                        lines = get_recent_lines(log_path, 500)\n288\t                        self._send_sse_event({\n289\t                            \"agent\": agent_id,\n290\t                            \"lines\": lines,\n291\t                            \"ts\": datetime.now().isoformat(),\n292\t                        })\n293\t                        last_size = current_size\n294\t                else:\n295\t                    if last_size != -1:\n296\t                        self._send_sse_event({\"agent\": agent_id, \"lines\": [], \"ts\": datetime.now().isoformat()})\n297\t                        last_size = -1\n298\t                time.sleep(1)\n299\t        except (BrokenPipeError, ConnectionResetError, OSError):\n300\t            pass\n301\t        finally:\n302\t            with _sse_lock:\n303\t                _sse_connections -= 1\n304\t\n305\t    # ---------- GET routes ----------\n306\t\n307\t    def do_GET(self):\n308\t        parsed = urlparse(self.path)\n309\t        path = parsed.path\n310\t\n311\t        if path == \"/api/agents\":\n312\t            return self._send_json(scan_agents())\n313\t\n314\t        if path == \"/api/tasks\":\n315\t            return self._send_json(get_main_tasks())\n316\t\n317\t        if path == \"/api/logs\":\n318\t            params = parse_qs(parsed.query)\n319\t            n = int(params.get(\"n\", [\"100\"])[0])\n320\t            agent_id = params.get(\"agent\", [None])[0]\n321\t            if agent_id:\n322\t                agent_dir = _safe_agent_path(agent_id)\n323\t                if not agent_dir:\n324\t                    return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n325\t                log_path = agent_dir / \"log\" / \"run.md\"\n326\t            else:\n327\t                log_path = MAIN_DIR / \"log\" / \"run.md\"\n328\t            lines = get_recent_lines(log_path, n)\n329\t            return self._send_json({\"agent\": agent_id, \"lines\": lines})\n330\t\n331\t        if path == \"/api/logs/stream\":\n332\t            return self._handle_sse_logs()\n333\t\n334\t        if path == \"/api/loopcli/status\":\n335\t            return self._handle_loopcli_status()\n336\t\n337\t        # Static files\n338\t        super().do_GET()\n339\t\n340\t    # ---------- POST routes ----------\n341\t\n342\t    def do_POST(self):\n343\t        if not _write_semaphore.acquire(timeout=5):\n344\t            return self._send_json({\"error\": \"Server busy, try again\"}, status=503)\n345\t        try:\n346\t            self._do_POST_impl()\n347\t        finally:\n348\t            _write_semaphore.release()\n349\t\n350\t    def _do_POST_impl(self):\n351\t        parsed = urlparse(self.path)\n352\t        path = parsed.path\n353\t\n354\t        if path == \"/api/tasks\":\n355\t            return self._handle_create_task()\n356\t        if path == \"/api/agents/start\":\n357\t            return self._handle_agent_start()\n358\t        if path == \"/api/loopcli/start\":\n359\t            return self._handle_loopcli_start()\n360\t        if path == \"/api/loopcli/stop\":\n361\t            return self._handle_loopcli_stop()\n362\t        if path == \"/api/loopcli/restart\":\n363\t            return self._handle_loopcli_restart()\n364\t        if path == \"/api/loopcli/dispatch\":\n365\t            return self._handle_loopcli_dispatch()\n366\t        if path == \"/api/messages/send\":\n367\t            return self._handle_message_send()\n368\t        if path == \"/api/agents/enable\":\n369\t            return self._handle_agent_enable(\"enable\")\n370\t        if path == \"/api/agents/disable\":\n371\t            return self._handle_agent_enable(\"disable\")\n372\t\n373\t        self._send_json({\"error\": \"Not found\"}, status=404)\n374\t\n375\t    # ---------- OPTIONS (CORS preflight) ----------\n376\t\n377\t    def do_OPTIONS(self):\n378\t        self.send_response(204)\n379\t        self._cors_headers()\n380\t        self.end_headers()\n381\t\n382\t    # ---------- Handlers ----------\n383\t\n384\t    def _handle_create_task(self):\n385\t        body = self._read_body()\n386\t        title = body.get(\"title\", \"\").strip()\n387\t        if not title:\n388\t            return self._send_json({\"error\": \"title is required\"}, status=400)\n389\t\n390\t        tasks = get_main_tasks()\n391\t        new_id = max((t.get(\"id\", 0) for t in tasks), default=0) + 1\n392\t        task = {\n393\t            \"id\": new_id,\n394\t            \"status\": \"pending\",\n395\t            \"title\": title,\n396\t            \"description\": body.get(\"description\", \"\"),\n397\t            \"created\": datetime.now(timezone.utc).strftime(\"%Y-%m-%d\"),\n398\t            \"assignee\": body.get(\"assignee\") or \"main\",\n399\t        }\n400\t        tasks.append(task)\n401\t        write_json(MAIN_DIR / \"memory\" / \"tasks.json\", tasks)\n402\t        self._send_json(task, status=201)\n403\t\n404\t    def _handle_agent_start(self):\n405\t        body = self._read_body()\n406\t        agent_id = body.get(\"agent\", \"\").strip()\n407\t        if not agent_id:\n408\t            return self._send_json({\"error\": \"agent is required\"}, status=400)\n409\t\n410\t        agent_dir = _safe_agent_path(agent_id)\n411\t        if not agent_dir:\n412\t            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n413\t\n414\t        prompt_file = agent_dir / \"PROMPT.md\"\n415\t        if not prompt_file.exists():\n416\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found or no PROMPT.md\"}, status=404)\n417\t\n418\t        prompt = prompt_file.read_text(encoding=\"utf-8\")\n419\t        proc = subprocess.Popen(\n420\t            [\"claude\", \"--print\"],\n421\t            stdin=subprocess.PIPE,\n422\t            stdout=subprocess.PIPE,\n423\t            stderr=subprocess.PIPE,\n424\t            cwd=str(agent_dir),\n425\t        )\n426\t        proc.stdin.write(prompt.encode(\"utf-8\"))\n427\t        proc.stdin.close()\n428\t\n429\t        self._send_json({\n430\t            \"agent\": agent_id,\n431\t            \"pid\": proc.pid,\n432\t            \"status\": \"started\",\n433\t        })\n434\t\n435\t    # --- Loop control handlers ---\n436\t\n437\t    def _handle_loopcli_status(self):\n438\t        state = get_loop_state()\n439\t        pid = state.get(\"pid\")\n440\t        if state.get(\"status\") == \"running\" and pid and not _is_pid_alive(pid):\n441\t            state[\"status\"] = \"stopped\"\n442\t            state[\"pid\"] = None\n443\t            state[\"ended_at\"] = datetime.now().isoformat()\n444\t            set_loop_state(state)\n445\t\n446\t        uptime = 0\n447\t        if state.get(\"started_at\"):\n448\t            try:\n449\t                started = datetime.fromisoformat(state[\"started_at\"])\n450\t                uptime = int((datetime.now() - started).total_seconds())\n451\t            except (ValueError, TypeError):\n452\t                pass\n453\t        state[\"uptime_seconds\"] = uptime\n454\t        self._send_json(state)\n455\t\n456\t    def _handle_loopcli_start(self):\n457\t        body = self._read_body()\n458\t        iterations = int(body.get(\"iterations\", 0))\n459\t        data, status = start_loopcli_process(iterations)\n460\t        self._send_json(data, status)\n461\t\n462\t    def _handle_loopcli_stop(self):\n463\t        data, status = stop_loopcli_process()\n464\t        self._send_json(data, status)\n465\t\n466\t    def _handle_loopcli_restart(self):\n467\t        body = self._read_body()\n468\t        stop_loopcli_process()\n469\t        time.sleep(0.5)\n470\t        iterations = int(body.get(\"iterations\", 0))\n471\t        data, status = start_loopcli_process(iterations)\n472\t        self._send_json(data, status)\n473\t\n474\t    def _handle_loopcli_dispatch(self):\n475\t        if API_KEY:\n476\t            key = self.headers.get(\"X-API-Key\", \"\") or parse_qs(urlparse(self.path).query).get(\"key\", [\"\"])[0]\n477\t            if key != API_KEY:\n478\t                return self._send_json({\"error\": \"Unauthorized\"}, status=401)\n479\t\n480\t        body = self._read_body()\n481\t        agent_id = body.get(\"agent\", \"\").strip()\n482\t        title = body.get(\"title\", \"\").strip()\n483\t        if not agent_id or not title:\n484\t            return self._send_json({\"error\": \"agent and title are required\"}, status=400)\n485\t\n486\t        agent_dir = _safe_agent_path(agent_id)\n487\t        if not agent_dir or not (agent_dir / \"AGENT\").exists():\n488\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n489\t\n490\t        # Write task to agent's tasks.json\n491\t        tasks_file = agent_dir / \"memory\" / \"tasks.json\"\n492\t        tasks = read_json(tasks_file, [])\n493\t        new_id = max((t.get(\"id\", 0) for t in tasks), default=0) + 1\n494\t        task = {\n495\t            \"id\": new_id,\n496\t            \"status\": \"pending\",\n497\t            \"title\": title,\n498\t            \"description\": body.get(\"description\", \"\"),\n499\t            \"created\": datetime.now(timezone.utc).strftime(\"%Y-%m-%d\"),\n500\t            \"assignee\": agent_id,\n501\t        }\n502\t        tasks.append(task)\n503\t        write_json(tasks_file, tasks)\n504\t\n505\t        # Start claude process for this agent\n506\t        prompt_file = agent_dir / \"PROMPT.md\"\n507\t        prompt = \"\"\n508\t        if prompt_file.exists():\n509\t            prompt = prompt_file.read_text(encoding=\"utf-8\")\n510\t\n511\t        proc = subprocess.Popen(\n512\t            [\"claude\", \"--print\", \"--dangerously-skip-permissions\"],\n513\t            stdin=subprocess.PIPE,\n514\t            stdout=subprocess.DEVNULL,\n515\t            stderr=subprocess.DEVNULL,\n516\t            cwd=str(agent_dir),\n517\t        )\n518\t        if prompt:\n519\t            proc.stdin.write(prompt.encode(\"utf-8\"))\n520\t            proc.stdin.close()\n521\t\n522\t        self._send_json({\n523\t            \"task\": task,\n524\t            \"pid\": proc.pid,\n525\t            \"status\": \"dispatched\",\n526\t        }, status=201)\n527\t\n528\t    def _handle_message_send(self):\n529\t        body = self._read_body()\n530\t        content = body.get(\"content\", \"\").strip()\n531\t        if not content:\n532\t            return self._send_json({\"error\": \"content is required\"}, status=400)\n533\t\n534\t        agent_id = body.get(\"agent\", \"main\").strip() or \"main\"\n535\t        agent_dir = _safe_agent_path(agent_id)\n536\t        if not agent_dir:\n537\t            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n538\t        if not (agent_dir / \"AGENT\").exists():\n539\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n540\t\n541\t        inbox_dir = agent_dir / \"inbox\"\n542\t        inbox_dir.mkdir(parents=True, exist_ok=True)\n543\t\n544\t        now = datetime.now()\n545\t        ts = now.strftime(\"%Y%m%d_%H%M\")\n546\t        msg_file = inbox_dir / f\"webui_{ts}.md\"\n547\t        msg_file.write_text(\n548\t            f\"# 来自 WebUI 的消息\\n- 类型：指令\\n- 时间：{now.strftime('%Y-%m-%d %H:%M')}\\n\\n## 内容\\n{content}\\n\",\n549\t            encoding=\"utf-8\",\n550\t        )\n551\t        self._send_json({\"status\": \"sent\", \"agent\": agent_id, \"file\": msg_file.name}, status=201)\n552\t\n553\t    def _handle_agent_enable(self, action):\n554\t        body = self._read_body()\n555\t        agent_id = body.get(\"agent\", \"\").strip()\n556\t        if not agent_id:\n557\t            return self._send_json({\"error\": \"agent is required\"}, status=400)\n558\t        if agent_id == \"main\":\n559\t            return self._send_json({\"error\": \"cannot disable main agent\"}, status=400)\n560\t\n561\t        agent_dir = _safe_agent_path(agent_id)\n562\t        if not agent_dir:\n563\t            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n564\t        marker = agent_dir / \"AGENT\"\n565\t        if not marker.exists():\n566\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n567\t\n568\t        if action == \"enable\":\n569\t            marker.write_text(\"type: main\\n\", encoding=\"utf-8\")\n570\t        else:\n571\t            marker.write_text(\"type: main\\ndisabled: true\\n\", encoding=\"utf-8\")\n572\t\n573\t        self._send_json({\"status\": \"ok\", \"agent\": agent_id, \"enabled\": action == \"enable\"})\n574\t\n575\t\n576\tclass ThreadedHTTPServer(ThreadingMixIn, HTTPServer):\n577\t    daemon_threads = True\n578\t\n579\t\n580\tdef main():\n581\t    host = \"0.0.0.0\"\n582\t    port = 8080\n583\t    server = ThreadedHTTPServer((host, port), WebUIHandler)\n584\t    print(f\"LoopCLI WebUI Server running on http://{host}:{port}\")\n585\t    print(f\"Static files served from: {WEBUI_DIR}\")\n586\t    print(f\"Agent root: {LOOPCLI_ROOT}\")\n587\t    print(\"Press Ctrl+C to stop.\")\n588\t    try:\n589\t        server.serve_forever()\n590\t    except KeyboardInterrupt:\n591\t        print(\"\\nShutting down.\")\n592\t        server.server_close()\n593\t\n594\t\n595\tif __name__ == \"__main__\":\n596\t    main()\n597\t"}]},"parent_tool_use_id":null,"session_id":"919a7148-5621-42bf-8d0b-ae3a5846fdc8","uuid":"d74d2752-c3fb-48eb-8553-0ab10bbf5b28","timestamp":"2026-05-21T00:04:15.030Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\loopcli\\main\\webui\\server.py","content":"\"\"\"\nLoopCLI WebUI Backend Server\nREST API + static file hosting for the Agent control console.\n\"\"\"\n\nimport json\nimport os\nimport signal\nimport subprocess\nimport sys\nimport time\nimport threading\nfrom datetime import datetime, timezone\nfrom http.server import HTTPServer, SimpleHTTPRequestHandler\nfrom socketserver import ThreadingMixIn\nfrom pathlib import Path\nfrom urllib.parse import urlparse, parse_qs\n\nLOOPCLI_ROOT = Path(r\"D:\\loopcli\")\nWEBUI_DIR = Path(__file__).parent.resolve()\nMAIN_DIR = LOOPCLI_ROOT / \"main\"\nLOOP_STATE_FILE = WEBUI_DIR / \"loop_state.json\"\n\n_loop_proc = None\n_loop_lock = threading.Lock()\nAPI_KEY = os.environ.get(\"LOOPCLI_API_KEY\", \"\")\n\nCORS_ORIGINS = [o.strip() for o in os.environ.get(\"CORS_ORIGINS\", \"\").split(\",\") if o.strip()]\n\n_write_semaphore = threading.Semaphore(10)\n\n_sse_connections = 0\n_sse_lock = threading.Lock()\nSSE_MAX_CONNECTIONS = 10\nSSE_TIMEOUT_SECONDS = 300\n\n\ndef read_json(path: Path, default=None):\n    if not path.exists():\n        return default if default is not None else {}\n    try:\n        return json.loads(path.read_text(encoding=\"utf-8\"))\n    except (json.JSONDecodeError, OSError):\n        return default if default is not None else {}\n\n\ndef write_json(path: Path, data):\n    path.parent.mkdir(parents=True, exist_ok=True)\n    path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n\n\ndef _safe_agent_path(agent_id: str) -> Path | None:\n    if not agent_id or '/' in agent_id or '\\\\' in agent_id or '..' in agent_id:\n        return None\n    agent_dir = LOOPCLI_ROOT / agent_id\n    try:\n        agent_dir.resolve().relative_to(LOOPCLI_ROOT.resolve())\n    except ValueError:\n        return None\n    return agent_dir\n\n\ndef scan_agents():\n    \"\"\"Scan loopcli root for agent directories (containing AGENT marker file).\"\"\"\n    agents = []\n    for child in LOOPCLI_ROOT.iterdir():\n        if not child.is_dir():\n            continue\n        agent_marker = child / \"AGENT\"\n        if not agent_marker.exists():\n            continue\n        state = read_json(child / \"memory\" / \"state.json\", {})\n        soul_path = child / \"SOUL.md\"\n        desc = \"\"\n        if soul_path.exists():\n            lines = soul_path.read_text(encoding=\"utf-8\").strip().splitlines()\n            for line in lines:\n                stripped = line.strip()\n                if stripped and not stripped.startswith(\"#\"):\n                    desc = stripped\n                    break\n        agents.append({\n            \"id\": child.name,\n            \"name\": state.get(\"agent\", child.name),\n            \"status\": state.get(\"status\", \"unknown\"),\n            \"description\": desc,\n            \"last_run\": state.get(\"last_run\"),\n            \"run_count\": state.get(\"run_count\", 0),\n            \"current_task\": state.get(\"current_task\"),\n        })\n    return agents\n\n\ndef get_main_tasks():\n    return read_json(MAIN_DIR / \"memory\" / \"tasks.json\", [])\n\n\ndef get_recent_lines(filepath: Path, n=100):\n    if not filepath.exists():\n        return []\n    try:\n        with open(filepath, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n            lines = f.readlines()\n        return [l.rstrip(\"\\n\\r\") for l in lines[-n:]]\n    except OSError:\n        return []\n\n\n# --- Loop Process Management ---\n\ndef get_loop_state():\n    return read_json(LOOP_STATE_FILE, {\n        \"status\": \"stopped\", \"pid\": None,\n        \"started_at\": None, \"iterations\": 0, \"total_iterations\": 0,\n    })\n\n\ndef set_loop_state(state):\n    write_json(LOOP_STATE_FILE, state)\n\n\ndef _is_pid_alive(pid):\n    if not pid:\n        return False\n    try:\n        os.kill(pid, 0)\n        return True\n    except (ProcessLookupError, PermissionError, OSError):\n        return False\n\n\ndef _monitor_loopcli(proc):\n    proc.wait()\n    with _loop_lock:\n        state = get_loop_state()\n        if state.get(\"pid\") == proc.pid:\n            state[\"status\"] = \"stopped\"\n            state[\"pid\"] = None\n            state[\"ended_at\"] = datetime.now().isoformat()\n            set_loop_state(state)\n\n\ndef start_loopcli_process(iterations=0):\n    global _loop_proc\n    with _loop_lock:\n        state = get_loop_state()\n        if state.get(\"status\") == \"running\" and _is_pid_alive(state.get(\"pid\")):\n            return {\"error\": \"Already running\"}, 409\n\n        cmd = [sys.executable, str(LOOPCLI_ROOT / \"run.py\"), \"run\"]\n        if iterations > 0:\n            cmd.extend([\"-n\", str(iterations)])\n\n        proc = subprocess.Popen(\n            cmd,\n            stdout=subprocess.DEVNULL,\n            stderr=subprocess.DEVNULL,\n            creationflags=getattr(subprocess, \"CREATE_NO_WINDOW\", 0),\n        )\n        _loop_proc = proc\n\n        state = {\n            \"status\": \"running\",\n            \"pid\": proc.pid,\n            \"started_at\": datetime.now().isoformat(),\n            \"iterations\": iterations,\n            \"total_iterations\": 0,\n        }\n        set_loop_state(state)\n\n        t = threading.Thread(target=_monitor_loopcli, args=(proc,), daemon=True)\n        t.start()\n        return state, 200\n\n\ndef stop_loopcli_process():\n    global _loop_proc\n    with _loop_lock:\n        state = get_loop_state()\n        pid = state.get(\"pid\")\n        if not pid or not _is_pid_alive(pid):\n            state[\"status\"] = \"stopped\"\n            state[\"pid\"] = None\n            set_loop_state(state)\n            return {\"error\": \"Not running\"}, 409\n\n        try:\n            os.kill(pid, signal.SIGTERM)\n        except OSError:\n            pass\n        if _loop_proc and _loop_proc.pid == pid:\n            try:\n                _loop_proc.terminate()\n            except OSError:\n                pass\n            _loop_proc = None\n\n        state[\"status\"] = \"stopped\"\n        state[\"pid\"] = None\n        state[\"ended_at\"] = datetime.now().isoformat()\n        set_loop_state(state)\n        return {\"status\": \"stopped\"}, 200\n\n\nclass WebUIHandler(SimpleHTTPRequestHandler):\n    def __init__(self, *args, **kwargs):\n        super().__init__(*args, directory=str(WEBUI_DIR), **kwargs)\n\n    def log_message(self, format, *args):\n        ts = datetime.now().strftime(\"%H:%M:%S\")\n        sys.stdout.write(f\"[{ts}] {format % args}\\n\")\n        sys.stdout.flush()\n\n    def _send_json(self, data, status=200):\n        body = json.dumps(data, ensure_ascii=False, indent=2).encode(\"utf-8\")\n        self.send_response(status)\n        self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def _read_body(self):\n        length = int(self.headers.get(\"Content-Length\", 0))\n        if length == 0:\n            return {}\n        raw = self.rfile.read(length)\n        try:\n            return json.loads(raw.decode(\"utf-8\"))\n        except (json.JSONDecodeError, UnicodeDecodeError):\n            return {}\n\n    def _cors_headers(self):\n        origin = self.headers.get(\"Origin\", \"\")\n        if CORS_ORIGINS:\n            if origin in CORS_ORIGINS:\n                self.send_header(\"Access-Control-Allow-Origin\", origin)\n                self.send_header(\"Vary\", \"Origin\")\n        else:\n            self.send_header(\"Access-Control-Allow-Origin\", \"*\")\n        self.send_header(\"Access-Control-Allow-Methods\", \"GET, POST, OPTIONS\")\n        self.send_header(\"Access-Control-Allow-Headers\", \"Content-Type\")\n\n    # ---------- SSE helpers ----------\n\n    def _send_sse_event(self, data):\n        payload = f\"data: {json.dumps(data, ensure_ascii=False)}\\n\\n\"\n        self.wfile.write(payload.encode(\"utf-8\"))\n        self.wfile.flush()\n\n    def _handle_sse_logs(self):\n        global _sse_connections\n        with _sse_lock:\n            if _sse_connections >= SSE_MAX_CONNECTIONS:\n                return self._send_json({\"error\": \"Max SSE connections reached\"}, status=503)\n            _sse_connections += 1\n\n        params = parse_qs(urlparse(self.path).query)\n        agent_id = params.get(\"agent\", [None])[0]\n        if agent_id:\n            agent_dir = _safe_agent_path(agent_id)\n            if not agent_dir:\n                with _sse_lock:\n                    _sse_connections -= 1\n                return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n            log_path = agent_dir / \"log\" / \"run.md\"\n        else:\n            log_path = MAIN_DIR / \"log\" / \"run.md\"\n\n        self.send_response(200)\n        self.send_header(\"Content-Type\", \"text/event-stream\")\n        self.send_header(\"Cache-Control\", \"no-cache\")\n        self.send_header(\"Connection\", \"keep-alive\")\n        self.send_header(\"X-Accel-Buffering\", \"no\")\n        self._cors_headers()\n        self.end_headers()\n\n        last_size = 0\n        start_time = time.time()\n        try:\n            while True:\n                if time.time() - start_time > SSE_TIMEOUT_SECONDS:\n                    self._send_sse_event({\"event\": \"timeout\", \"ts\": datetime.now().isoformat()})\n                    break\n                if log_path.exists():\n                    current_size = log_path.stat().st_size\n                    if current_size != last_size:\n                        lines = get_recent_lines(log_path, 500)\n                        self._send_sse_event({\n                            \"agent\": agent_id,\n                            \"lines\": lines,\n                            \"ts\": datetime.now().isoformat(),\n                        })\n                        last_size = current_size\n                else:\n                    if last_size != -1:\n                        self._send_sse_event({\"agent\": agent_id, \"lines\": [], \"ts\": datetime.now().isoformat()})\n                        last_size = -1\n                time.sleep(1)\n        except (BrokenPipeError, ConnectionResetError, OSError):\n            pass\n        finally:\n            with _sse_lock:\n                _sse_connections -= 1\n\n    # ---------- GET routes ----------\n\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        path = parsed.path\n\n        if path == \"/api/agents\":\n            return self._send_json(scan_agents())\n\n        if path == \"/api/tasks\":\n            return self._send_json(get_main_tasks())\n\n        if path == \"/api/logs\":\n            params = parse_qs(parsed.query)\n            n = int(params.get(\"n\", [\"100\"])[0])\n            agent_id = params.get(\"agent\", [None])[0]\n            if agent_id:\n                agent_dir = _safe_agent_path(agent_id)\n                if not agent_dir:\n                    return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n                log_path = agent_dir / \"log\" / \"run.md\"\n            else:\n                log_path = MAIN_DIR / \"log\" / \"run.md\"\n            lines = get_recent_lines(log_path, n)\n            return self._send_json({\"agent\": agent_id, \"lines\": lines})\n\n        if path == \"/api/logs/stream\":\n            return self._handle_sse_logs()\n\n        if path == \"/api/loopcli/status\":\n            return self._handle_loopcli_status()\n\n        # Static files\n        super().do_GET()\n\n    # ---------- POST routes ----------\n\n    def do_POST(self):\n        if not _write_semaphore.acquire(timeout=5):\n            return self._send_json({\"error\": \"Server busy, try again\"}, status=503)\n        try:\n            self._do_POST_impl()\n        finally:\n            _write_semaphore.release()\n\n    def _do_POST_impl(self):\n        parsed = urlparse(self.path)\n        path = parsed.path\n\n        if path == \"/api/tasks\":\n            return self._handle_create_task()\n        if path == \"/api/agents/start\":\n            return self._handle_agent_start()\n        if path == \"/api/loopcli/start\":\n            return self._handle_loopcli_start()\n        if path == \"/api/loopcli/stop\":\n            return self._handle_loopcli_stop()\n        if path == \"/api/loopcli/restart\":\n            return self._handle_loopcli_restart()\n        if path == \"/api/loopcli/dispatch\":\n            return self._handle_loopcli_dispatch()\n        if path == \"/api/messages/send\":\n            return self._handle_message_send()\n        if path == \"/api/agents/enable\":\n            return self._handle_agent_enable(\"enable\")\n        if path == \"/api/agents/disable\":\n            return self._handle_agent_enable(\"disable\")\n\n        self._send_json({\"error\": \"Not found\"}, status=404)\n\n    # ---------- OPTIONS (CORS preflight) ----------\n\n    def do_OPTIONS(self):\n        self.send_response(204)\n        self._cors_headers()\n        self.end_headers()\n\n    # ---------- Handlers ----------\n\n    def _handle_create_task(self):\n        body = self._read_body()\n        title = body.get(\"title\", \"\").strip()\n        if not title:\n            return self._send_json({\"error\": \"title is required\"}, status=400)\n\n        tasks = get_main_tasks()\n        new_id = max((t.get(\"id\", 0) for t in tasks), default=0) + 1\n        task = {\n            \"id\": new_id,\n            \"status\": \"pending\",\n            \"title\": title,\n            \"description\": body.get(\"description\", \"\"),\n            \"created\": datetime.now(timezone.utc).strftime(\"%Y-%m-%d\"),\n            \"assignee\": body.get(\"assignee\") or \"main\",\n        }\n        tasks.append(task)\n        write_json(MAIN_DIR / \"memory\" / \"tasks.json\", tasks)\n        self._send_json(task, status=201)\n\n    def _handle_agent_start(self):\n        body = self._read_body()\n        agent_id = body.get(\"agent\", \"\").strip()\n        if not agent_id:\n            return self._send_json({\"error\": \"agent is required\"}, status=400)\n\n        agent_dir = _safe_agent_path(agent_id)\n        if not agent_dir:\n            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n\n        prompt_file = agent_dir / \"PROMPT.md\"\n        if not prompt_file.exists():\n            return self._send_json({\"error\": f\"Agent '{agent_id}' not found or no PROMPT.md\"}, status=404)\n\n        prompt = prompt_file.read_text(encoding=\"utf-8\")\n        proc = subprocess.Popen(\n            [\"claude\", \"--print\"],\n            stdin=subprocess.PIPE,\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            cwd=str(agent_dir),\n        )\n        proc.stdin.write(prompt.encode(\"utf-8\"))\n        proc.stdin.close()\n\n        self._send_json({\n            \"agent\": agent_id,\n            \"pid\": proc.pid,\n            \"status\": \"started\",\n        })\n\n    # --- Loop control handlers ---\n\n    def _handle_loopcli_status(self):\n        state = get_loop_state()\n        pid = state.get(\"pid\")\n        if state.get(\"status\") == \"running\" and pid and not _is_pid_alive(pid):\n            state[\"status\"] = \"stopped\"\n            state[\"pid\"] = None\n            state[\"ended_at\"] = datetime.now().isoformat()\n            set_loop_state(state)\n\n        uptime = 0\n        if state.get(\"started_at\"):\n            try:\n                started = datetime.fromisoformat(state[\"started_at\"])\n                uptime = int((datetime.now() - started).total_seconds())\n            except (ValueError, TypeError):\n                pass\n        state[\"uptime_seconds\"] = uptime\n        self._send_json(state)\n\n    def _handle_loopcli_start(self):\n        body = self._read_body()\n        iterations = int(body.get(\"iterations\", 0))\n        data, status = start_loopcli_process(iterations)\n        self._send_json(data, status)\n\n    def _handle_loopcli_stop(self):\n        data, status = stop_loopcli_process()\n        self._send_json(data, status)\n\n    def _handle_loopcli_restart(self):\n        body = self._read_body()\n        stop_loopcli_process()\n        time.sleep(0.5)\n        iterations = int(body.get(\"iterations\", 0))\n        data, status = start_loopcli_process(iterations)\n        self._send_json(data, status)\n\n    def _handle_loopcli_dispatch(self):\n        if API_KEY:\n            key = self.headers.get(\"X-API-Key\", \"\") or parse_qs(urlparse(self.path).query).get(\"key\", [\"\"])[0]\n            if key != API_KEY:\n                return self._send_json({\"error\": \"Unauthorized\"}, status=401)\n\n        body = self._read_body()\n        agent_id = body.get(\"agent\", \"\").strip()\n        title = body.get(\"title\", \"\").strip()\n        if not agent_id or not title:\n            return self._send_json({\"error\": \"agent and title are required\"}, status=400)\n\n        agent_dir = _safe_agent_path(agent_id)\n        if not agent_dir or not (agent_dir / \"AGENT\").exists():\n            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n\n        # Write task to agent's tasks.json\n        tasks_file = agent_dir / \"memory\" / \"tasks.json\"\n        tasks = read_json(tasks_file, [])\n        new_id = max((t.get(\"id\", 0) for t in tasks), default=0) + 1\n        task = {\n            \"id\": new_id,\n            \"status\": \"pending\",\n            \"title\": title,\n            \"description\": body.get(\"description\", \"\"),\n            \"created\": datetime.now(timezone.utc).strftime(\"%Y-%m-%d\"),\n            \"assignee\": agent_id,\n        }\n        tasks.append(task)\n        write_json(tasks_file, tasks)\n\n        # Start claude process for this agent\n        prompt_file = agent_dir / \"PROMPT.md\"\n        prompt = \"\"\n        if prompt_file.exists():\n            prompt = prompt_file.read_text(encoding=\"utf-8\")\n\n        proc = subprocess.Popen(\n            [\"claude\", \"--print\", \"--dangerously-skip-permissions\"],\n            stdin=subprocess.PIPE,\n            stdout=subprocess.DEVNULL,\n            stderr=subprocess.DEVNULL,\n            cwd=str(agent_dir),\n        )\n        if prompt:\n            proc.stdin.write(prompt.encode(\"utf-8\"))\n            proc.stdin.close()\n\n        self._send_json({\n            \"task\": task,\n            \"pid\": proc.pid,\n            \"status\": \"dispatched\",\n        }, status=201)\n\n    def _handle_message_send(self):\n        body = self._read_body()\n        content = body.get(\"content\", \"\").strip()\n        if not content:\n            return self._send_json({\"error\": \"content is required\"}, status=400)\n\n        agent_id = body.get(\"agent\", \"main\").strip() or \"main\"\n        agent_dir = _safe_agent_path(agent_id)\n        if not agent_dir:\n            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n        if not (agent_dir / \"AGENT\").exists():\n            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n\n        inbox_dir = agent_dir / \"inbox\"\n        inbox_dir.mkdir(parents=True, exist_ok=True)\n\n        now = datetime.now()\n        ts = now.strftime(\"%Y%m%d_%H%M\")\n        msg_file = inbox_dir / f\"webui_{ts}.md\"\n        msg_file.write_text(\n            f\"# 来自 WebUI 的消息\\n- 类型：指令\\n- 时间：{now.strftime('%Y-%m-%d %H:%M')}\\n\\n## 内容\\n{content}\\n\",\n            encoding=\"utf-8\",\n        )\n        self._send_json({\"status\": \"sent\", \"agent\": agent_id, \"file\": msg_file.name}, status=201)\n\n    def _handle_agent_enable(self, action):\n        body = self._read_body()\n        agent_id = body.get(\"agent\", \"\").strip()\n        if not agent_id:\n            return self._send_json({\"error\": \"agent is required\"}, status=400)\n        if agent_id == \"main\":\n            return self._send_json({\"error\": \"cannot disable main agent\"}, status=400)\n\n        agent_dir = _safe_agent_path(agent_id)\n        if not agent_dir:\n            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n        marker = agent_dir / \"AGENT\"\n        if not marker.exists():\n            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n\n        if action == \"enable\":\n            marker.write_text(\"type: main\\n\", encoding=\"utf-8\")\n        else:\n            marker.write_text(\"type: main\\ndisabled: true\\n\", encoding=\"utf-8\")\n\n        self._send_json({\"status\": \"ok\", \"agent\": agent_id, \"enabled\": action == \"enable\"})\n\n\nclass ThreadedHTTPServer(ThreadingMixIn, HTTPServer):\n    daemon_threads = True\n\n\ndef main():\n    host = \"0.0.0.0\"\n    port = 8080\n    server = ThreadedHTTPServer((host, port), WebUIHandler)\n    print(f\"LoopCLI WebUI Server running on http://{host}:{port}\")\n    print(f\"Static files served from: {WEBUI_DIR}\")\n    print(f\"Agent root: {LOOPCLI_ROOT}\")\n    print(\"Press Ctrl+C to stop.\")\n    try:\n        server.serve_forever()\n    except KeyboardInterrupt:\n        print(\"\\nShutting down.\")\n        server.server_close()\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":597,"startLine":1,"totalLines":597}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_4ab8d878613a46c391a6b935","type":"tool_result","content":"1\timport argparse\n2\timport json\n3\timport msvcrt\n4\timport os\n5\timport shutil\n6\timport subprocess\n7\timport sys\n8\timport threading\n9\timport time\n10\tfrom datetime import datetime\n11\t\n12\tLOOPCLI_DIR = r\"D:\\loopcli\"\n13\tSUBAGENT_DIR = os.path.join(LOOPCLI_DIR, \"subagent\")\n14\tCLAUDE = os.path.join(os.environ.get(\"APPDATA\", \"\"), \"npm\", \"claude.cmd\")\n15\t\n16\tAGENT_MARKER = \"AGENT\"\n17\tLOGS_DIR = os.path.join(LOOPCLI_DIR, \"logs\")\n18\tGIT_TOKEN_FILE = os.path.join(LOOPCLI_DIR, \".gittoken\")\n19\tDEFAULT_PROMPT = \"\"\"读取 SOUL.md 作为你的身份。\n20\t读取 D:/loopcli/skill/ 下所有技能文件（全局技能）。\n21\t读取 memory/tasks.json 获取分配给你的任务。\n22\t\n23\t执行步骤：\n24\t1. 从 tasks.json 中找 status 为 \"pending\" 的第一个任务\n25\t2. 执行该任务\n26\t3. 将结果写入 memory/results/ 目录（以时间戳命名）\n27\t4. 将该任务 status 改为 \"done\"，写回 tasks.json\n28\t5. 更新 memory/state.json（标记完成、记录时间戳）\n29\t6. 将本次运行摘要追加到 log/run.md\n30\t7. 通过 inbox 通知 main：写入 D:/loopcli/main/inbox/<你的名字>_<时间>.md，简要报告任务结果\n31\t8. 如果没有 pending 任务，输出 \"IDLE\" 并结束本轮\n32\t\"\"\"\n33\t\n34\t\n35\t# ─── 工具函数 ───\n36\t\n37\tdef get_agent_marker(path):\n38\t    \"\"\"读取 AGENT 标记文件内容\"\"\"\n39\t    marker = os.path.join(path, AGENT_MARKER)\n40\t    if os.path.isfile(marker):\n41\t        with open(marker, \"r\", encoding=\"utf-8\") as f:\n42\t            return f.read().strip()\n43\t    return None\n44\t\n45\t\n46\tdef is_agent_enabled(path):\n47\t    \"\"\"检查 Agent 是否启用（AGENT 文件不含 disabled 标记）\"\"\"\n48\t    content = get_agent_marker(path)\n49\t    if content is None:\n50\t        return False\n51\t    return \"disabled\" not in content\n52\t\n53\t\n54\tdef discover_agents(include_disabled=False):\n55\t    agents = []\n56\t    for name in os.listdir(LOOPCLI_DIR):\n57\t        path = os.path.join(LOOPCLI_DIR, name)\n58\t        marker = os.path.join(path, AGENT_MARKER)\n59\t        if os.path.isdir(path) and os.path.isfile(marker):\n60\t            if include_disabled or is_agent_enabled(path):\n61\t                agents.append({\"name\": name, \"path\": path})\n62\t    return agents\n63\t\n64\t\n65\tdef find_template(template_id):\n66\t    \"\"\"在 subagent 目录下搜索模板文件\"\"\"\n67\t    for dept in os.listdir(SUBAGENT_DIR):\n68\t        dept_dir = os.path.join(SUBAGENT_DIR, dept)\n69\t        if not os.path.isdir(dept_dir):\n70\t            continue\n71\t        candidate = os.path.join(dept_dir, f\"{template_id}.md\")\n72\t        if os.path.isfile(candidate):\n73\t            return candidate\n74\t    return None\n75\t\n76\t\n77\tdef load_agent_state(agent_path):\n78\t    state_file = os.path.join(agent_path, \"memory\", \"state.json\")\n79\t    if os.path.isfile(state_file):\n80\t        with open(state_file, \"r\", encoding=\"utf-8\") as f:\n81\t            return json.load(f)\n82\t    return None\n83\t\n84\t\n85\tdef load_agent_tasks(agent_path):\n86\t    tasks_file = os.path.join(agent_path, \"memory\", \"tasks.json\")\n87\t    if os.path.isfile(tasks_file):\n88\t        with open(tasks_file, \"r\", encoding=\"utf-8\") as f:\n89\t            return json.load(f)\n90\t    return []\n91\t\n92\t\n93\t# ─── 子命令: create ───\n94\t\n95\tdef cmd_create(args):\n96\t    template_id = args.template\n97\t    task_desc = args.task or \"\"\n98\t\n99\t    tpl_file = find_template(template_id)\n100\t    if not tpl_file:\n101\t        print(f\"[错误] 找不到模板: {template_id}\")\n102\t        print(\"用 loopcli templates 查看所有可用模板\")\n103\t        sys.exit(1)\n104\t\n105\t    with open(tpl_file, \"r\", encoding=\"utf-8\") as f:\n106\t        soul_content = f.read()\n107\t\n108\t    agent_dir = os.path.join(LOOPCLI_DIR, template_id)\n109\t    if os.path.exists(agent_dir):\n110\t        print(f\"[跳过] Agent 已存在: {agent_dir}\")\n111\t        if task_desc:\n112\t            cmd_task_inner(template_id, task_desc, \"\")\n113\t        return\n114\t\n115\t    # 创建目录结构\n116\t    os.makedirs(os.path.join(agent_dir, \"memory\", \"results\"), exist_ok=True)\n117\t    os.makedirs(os.path.join(agent_dir, \"log\"), exist_ok=True)\n118\t\n119\t    # AGENT 标记\n120\t    with open(os.path.join(agent_dir, AGENT_MARKER), \"w\", encoding=\"utf-8\") as f:\n121\t        f.write(\"type: main\\n\")\n122\t\n123\t    # SOUL.md（模板内容）\n124\t    with open(os.path.join(agent_dir, \"SOUL.md\"), \"w\", encoding=\"utf-8\") as f:\n125\t        f.write(soul_content)\n126\t\n127\t    # PROMPT.md\n128\t    with open(os.path.join(agent_dir, \"PROMPT.md\"), \"w\", encoding=\"utf-8\") as f:\n129\t        f.write(DEFAULT_PROMPT)\n130\t\n131\t    # state.json\n132\t    state = {\"agent\": template_id, \"status\": \"idle\", \"current_task\": None, \"last_run\": None, \"run_count\": 0, \"created\": datetime.now().strftime(\"%Y-%m-%d\")}\n133\t    with open(os.path.join(agent_dir, \"memory\", \"state.json\"), \"w\", encoding=\"utf-8\") as f:\n134\t        json.dump(state, f, indent=2, ensure_ascii=False)\n135\t\n136\t    # tasks.json\n137\t    tasks = []\n138\t    if task_desc:\n139\t        tasks.append({\"id\": 1, \"status\": \"pending\", \"title\": task_desc, \"description\": task_desc, \"created\": datetime.now().strftime(\"%Y-%m-%d\"), \"assignee\": template_id})\n140\t    with open(os.path.join(agent_dir, \"memory\", \"tasks.json\"), \"w\", encoding=\"utf-8\") as f:\n141\t        json.dump(tasks, f, indent=2, ensure_ascii=False)\n142\t\n143\t    # run.md\n144\t    with open(os.path.join(agent_dir, \"log\", \"run.md\"), \"w\", encoding=\"utf-8\") as f:\n145\t        f.write(\"# 运行日志\\n\\n| 时间 | 状态 | 任务 | 摘要 |\\n|------|------|------|------|\\n\")\n146\t\n147\t    print(f\"[创建成功] {template_id}\")\n148\t    print(f\"  目录: {agent_dir}\")\n149\t    if task_desc:\n150\t        print(f\"  任务: {task_desc}\")\n151\t    print(f\"  下一轮 loopcli 将自动启动该 Agent\")\n152\t\n153\t\n154\t# ─── 子命令: task ───\n155\t\n156\tdef cmd_task_inner(agent_name, title, desc):\n157\t    agent_dir = os.path.join(LOOPCLI_DIR, agent_name)\n158\t    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n159\t        print(f\"[错误] 不是有效的 Agent: {agent_name}\")\n160\t        sys.exit(1)\n161\t\n162\t    tasks_file = os.path.join(agent_dir, \"memory\", \"tasks.json\")\n163\t    tasks = load_agent_tasks(agent_dir)\n164\t    next_id = max((t[\"id\"] for t in tasks), default=0) + 1\n165\t    tasks.append({\n166\t        \"id\": next_id,\n167\t        \"status\": \"pending\",\n168\t        \"title\": title,\n169\t        \"description\": desc or title,\n170\t        \"created\": datetime.now().strftime(\"%Y-%m-%d\"),\n171\t        \"assignee\": agent_name\n172\t    })\n173\t    with open(tasks_file, \"w\", encoding=\"utf-8\") as f:\n174\t        json.dump(tasks, f, indent=2, ensure_ascii=False)\n175\t    print(f\"[派发成功] {agent_name} <- #{next_id} {title}\")\n176\t\n177\t\n178\tdef cmd_task(args):\n179\t    cmd_task_inner(args.agent, args.title, args.desc)\n180\t\n181\t\n182\t# ─── 子命令: list ───\n183\t\n184\tdef cmd_list(args):\n185\t    agents = discover_agents(include_disabled=True)\n186\t    if not agents:\n187\t        print(\"没有发现任何 Agent\")\n188\t        return\n189\t    print(f\"{'Agent':<45} {'启用':<6} {'状态':<10} {'任务数':<8} {'最后运行'}\")\n190\t    print(\"-\" * 95)\n191\t    for a in agents:\n192\t        enabled = \"是\" if is_agent_enabled(a[\"path\"]) else \"否\"\n193\t        state = load_agent_state(a[\"path\"]) or {}\n194\t        tasks = load_agent_tasks(a[\"path\"])\n195\t        pending = len([t for t in tasks if t.get(\"status\") == \"pending\"])\n196\t        status = state.get(\"status\", \"?\")\n197\t        last_run = state.get(\"last_run\", \"-\")\n198\t        print(f\"{a['name']:<45} {enabled:<6} {status:<10} {pending:<8} {last_run}\")\n199\t\n200\t\n201\t# ─── 子命令: templates ───\n202\t\n203\tdef cmd_templates(args):\n204\t    found = []\n205\t    for dept in sorted(os.listdir(SUBAGENT_DIR)):\n206\t        dept_dir = os.path.join(SUBAGENT_DIR, dept)\n207\t        if not os.path.isdir(dept_dir):\n208\t            continue\n209\t        for fname in sorted(os.listdir(dept_dir)):\n210\t            if fname.endswith(\".md\"):\n211\t                found.append(fname[:-3])\n212\t    if args.filter:\n213\t        found = [t for t in found if args.filter.lower() in t.lower()]\n214\t    print(f\"共 {len(found)} 个模板:\")\n215\t    for t in found:\n216\t        print(f\"  {t}\")\n217\t\n218\t\n219\t# ─── 子命令: run（主循环）───\n220\t\n221\tdef handle_event(agent_name, line):\n222\t    line = line.strip()\n223\t    if not line:\n224\t        return\n225\t    try:\n226\t        event = json.loads(line)\n227\t    except json.JSONDecodeError:\n228\t        print(f\"[{agent_name}] {line}\", flush=True)\n229\t        return\n230\t\n231\t    event_type = event.get(\"type\", \"\")\n232\t\n233\t    if event_type == \"assistant\":\n234\t        msg = event.get(\"message\", {})\n235\t        for block in msg.get(\"content\", []):\n236\t            if block.get(\"type\") == \"text\":\n237\t                text = block.get(\"text\", \"\")\n238\t                if text:\n239\t                    print(f\"[{agent_name}] {text}\", flush=True)\n240\t            elif block.get(\"type\") == \"tool_use\":\n241\t                name = block.get(\"name\", \"\")\n242\t                inp = block.get(\"input\", {})\n243\t                detail = \"\"\n244\t                for k in (\"file_path\", \"command\", \"pattern\"):\n245\t                    if k in inp:\n246\t                        detail = inp[k]\n247\t                        break\n248\t                print(f\"[{agent_name}] ● {name}({detail})\", flush=True)\n249\t\n250\t    elif event_type == \"tool_result\":\n251\t        content = event.get(\"content\", \"\")\n252\t        texts = []\n253\t        if isinstance(content, list):\n254\t            texts = [b.get(\"text\", \"\") for b in content if b.get(\"text\")]\n255\t        elif isinstance(content, str):\n256\t            texts = [content]\n257\t        for text in texts:\n258\t            print(f\"[{agent_name}]   ↳ {text[:200]}\", flush=True)\n259\t\n260\t    elif event_type == \"result\":\n261\t        text = event.get(\"result\", \"\")\n262\t        if text:\n263\t            print(f\"[{agent_name}] [结果] {text[:500]}\", flush=True)\n264\t        cost = event.get(\"cost_usd\", \"\")\n265\t        duration = event.get(\"duration_ms\", \"\")\n266\t        if cost or duration:\n267\t            print(f\"[{agent_name}] [统计] 耗时: {duration}ms, 费用: ${cost}\", flush=True)\n268\t\n269\t    elif event_type == \"error\":\n270\t        print(f\"[{agent_name}] [错误] {event.get('error', '')}\", flush=True)\n271\t\n272\t\n273\tdef run_agent(agent, iteration, run_log_dir):\n274\t    name = agent[\"name\"]\n275\t    path = agent[\"path\"]\n276\t    prompt_file = os.path.join(path, \"PROMPT.md\")\n277\t    log_file_path = os.path.join(path, \"log\", \"raw.log\")\n278\t    run_agent_log = os.path.join(run_log_dir, f\"{name}.log\")\n279\t    ts = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n280\t\n281\t    if not os.path.isfile(prompt_file):\n282\t        print(f\"[{name}] 没有 PROMPT.md，跳过\", flush=True)\n283\t        return\n284\t\n285\t    with open(prompt_file, \"r\", encoding=\"utf-8\") as f:\n286\t        prompt = f.read()\n287\t\n288\t    os.makedirs(os.path.join(path, \"log\"), exist_ok=True)\n289\t    log_file = open(log_file_path, \"a\", encoding=\"utf-8\")\n290\t    agent_log = open(run_agent_log, \"a\", encoding=\"utf-8\")\n291\t\n292\t    try:\n293\t        header = f\"\\n[{ts}] --- 开始 (第{iteration}轮) ---\\n\"\n294\t        log_file.write(header)\n295\t        agent_log.write(header)\n296\t        log_file.flush()\n297\t        agent_log.flush()\n298\t\n299\t        env = {**os.environ, \"IS_SANDBOX\": \"1\"}\n300\t\n301\t        proc = subprocess.Popen(\n302\t            [CLAUDE, \"--print\", \"--verbose\", \"--output-format\", \"stream-json\", \"--dangerously-skip-permissions\"],\n303\t            stdin=subprocess.PIPE,\n304\t            stdout=subprocess.PIPE,\n305\t            stderr=subprocess.PIPE,\n306\t            env=env,\n307\t            cwd=path,\n308\t        )\n309\t\n310\t        proc.stdin.write(prompt.encode(\"utf-8\"))\n311\t        proc.stdin.close()\n312\t\n313\t        for line in proc.stdout:\n314\t            decoded = line.decode(\"utf-8\", errors=\"replace\")\n315\t            log_file.write(decoded)\n316\t            agent_log.write(decoded)\n317\t            log_file.flush()\n318\t            agent_log.flush()\n319\t            handle_event(name, decoded)\n320\t\n321\t        stderr_output = proc.stderr.read().decode(\"utf-8\", errors=\"replace\")\n322\t        if stderr_output:\n323\t            print(f\"[{name}] [STDERR] {stderr_output}\", flush=True)\n324\t            log_file.write(stderr_output)\n325\t            agent_log.write(stderr_output)\n326\t\n327\t        proc.wait()\n328\t\n329\t        footer = f\"\\n[{ts}] --- 结束 (exit={proc.returncode}) ---\\n\"\n330\t        log_file.write(footer)\n331\t        agent_log.write(footer)\n332\t    finally:\n333\t        log_file.close()\n334\t        agent_log.close()\n335\t\n336\t    # 更新 state.json (with file lock)\n337\t    state_file = os.path.join(path, \"memory\", \"state.json\")\n338\t    with open(state_file, \"a+\") as f:\n339\t        msvcrt.locking(f.fileno(), msvcrt.LK_LOCK, 1)\n340\t        try:\n341\t            f.seek(0)\n342\t            try:\n343\t                state = json.load(f)\n344\t            except (json.JSONDecodeError, ValueError):\n345\t                state = {}\n346\t            state[\"status\"] = \"idle\"\n347\t            state[\"last_run\"] = ts\n348\t            state[\"run_count\"] = state.get(\"run_count\", 0) + 1\n349\t            f.seek(0)\n350\t            f.truncate()\n351\t            json.dump(state, f, indent=2, ensure_ascii=False)\n352\t        finally:\n353\t            msvcrt.locking(f.fileno(), msvcrt.LK_UNLCK, 1)\n354\t\n355\t    status = \"完成\" if proc.returncode == 0 else f\"异常(exit={proc.returncode})\"\n356\t    print(f\"[{name}] 本轮{status}\", flush=True)\n357\t\n358\t\n359\tdef git_push():\n360\t    \"\"\"自动 commit 和 push 到 GitHub\"\"\"\n361\t    token_file = GIT_TOKEN_FILE\n362\t    if not os.path.isfile(token_file):\n363\t        return\n364\t    with open(token_file, \"r\") as f:\n365\t        token = f.read().strip()\n366\t    if not token:\n367\t        return\n368\t    try:\n369\t        git = resolve_git()\n370\t        subprocess.run([git, \"add\", \"-A\"], cwd=LOOPCLI_DIR, capture_output=True, timeout=30)\n371\t        subprocess.run(\n372\t            [git, \"commit\", \"-m\", f\"auto: loopcli sync {datetime.now().strftime('%Y-%m-%d %H:%M')}\"],\n373\t            cwd=LOOPCLI_DIR, capture_output=True, timeout=30\n374\t        )\n375\t        # Use GIT_ASKPASS to avoid exposing token in command line\n376\t        askpass_script = os.path.join(LOOPCLI_DIR, \".git_askpass.bat\")\n377\t        with open(askpass_script, \"w\") as f:\n378\t            f.write(\"@echo %GH_TOKEN%\\n\")\n379\t        push_env = {\n380\t            **os.environ,\n381\t            \"GH_TOKEN\": token,\n382\t            \"GIT_ASKPASS\": askpass_script,\n383\t            \"GIT_TERMINAL_PROMPT\": \"0\",\n384\t        }\n385\t        subprocess.run(\n386\t            [git, \"push\", \"https://x-access-token@github.com/zhoudingnuo/loopcli.git\", \"main\"],\n387\t            cwd=LOOPCLI_DIR, capture_output=True, timeout=60, env=push_env,\n388\t        )\n389\t        os.remove(askpass_script)\n390\t        print(\"[git] 已同步到 GitHub\", flush=True)\n391\t    except Exception as e:\n392\t        print(f\"[git] 同步失败: {e}\", flush=True)\n393\t\n394\t\n395\tdef resolve_git():\n396\t    \"\"\"找到 git.exe 的完整路径\"\"\"\n397\t    for p in os.environ.get(\"PATH\", \"\").split(\";\"):\n398\t        candidate = os.path.join(p, \"git.exe\")\n399\t        if os.path.isfile(candidate):\n400\t            return candidate\n401\t    # 常见安装路径\n402\t    for d in [r\"C:\\Program Files\\Git\\cmd\", r\"C:\\Program Files\\Git\\bin\"]:\n403\t        candidate = os.path.join(d, \"git.exe\")\n404\t        if os.path.isfile(candidate):\n405\t            return candidate\n406\t    return \"git\"\n407\t\n408\t\n409\tdef cmd_run(args):\n410\t    agents = discover_agents()\n411\t    if not agents:\n412\t        print(\"未发现任何 Agent（需要目录下有 AGENT 标记文件）\")\n413\t        sys.exit(1)\n414\t\n415\t    # 创建本次运行日志目录\n416\t    run_id = datetime.now().strftime(\"run_%Y%m%d_%H%M%S\")\n417\t    run_log_dir = os.path.join(LOGS_DIR, run_id)\n418\t    os.makedirs(run_log_dir, exist_ok=True)\n419\t\n420\t    # 写入运行元信息\n421\t    meta = {\n422\t        \"run_id\": run_id,\n423\t        \"started\": datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"),\n424\t        \"iterations\": args.iterations or \"无限\",\n425\t        \"agents\": [a[\"name\"] for a in agents],\n426\t    }\n427\t    with open(os.path.join(run_log_dir, \"meta.json\"), \"w\", encoding=\"utf-8\") as f:\n428\t        json.dump(meta, f, indent=2, ensure_ascii=False)\n429\t\n430\t    print(f\"运行 ID: {run_id}\")\n431\t    print(f\"日志目录: {run_log_dir}\")\n432\t    print(f\"发现 {len(agents)} 个 Agent: {', '.join(a['name'] for a in agents)}\")\n433\t\n434\t    count = 0\n435\t    while args.iterations == 0 or count < args.iterations:\n436\t        count += 1\n437\t        # 每轮重新扫描（可能有新 Agent）\n438\t        agents = discover_agents()\n439\t        ts = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n440\t        print(f\"\\n{'='*60}\")\n441\t        print(f\"[{ts}] 第 {count}{'/' + str(args.iterations) if args.iterations else ''} 轮 | {len(agents)} 个 Agent\")\n442\t        print(f\"{'='*60}\")\n443\t\n444\t        threads = []\n445\t        for agent in agents:\n446\t            print(f\"\\n--- 启动 [{agent['name']}] ---\", flush=True)\n447\t            t = threading.Thread(target=run_agent, args=(agent, count, run_log_dir))\n448\t            t.start()\n449\t            threads.append(t)\n450\t        for t in threads:\n451\t            t.join()\n452\t\n453\t        # 每轮结束后同步到 GitHub\n454\t        git_push()\n455\t\n456\t        # 等待下一轮，期间可输入消息\n457\t        if args.iterations == 0 or count < args.iterations:\n458\t            print(f\"\\n{'─'*60}\", flush=True)\n459\t            print(f\"输入消息发给 main（直接回车跳过，输入 exit 停止）:\", flush=True)\n460\t            try:\n461\t                user_input = input(f\"  > \").strip()\n462\t                if user_input.lower() == \"exit\":\n463\t                    print(\"用户终止运行\")\n464\t                    break\n465\t                if user_input:\n466\t                    ts = datetime.now().strftime(\"%Y%m%d_%H%M\")\n467\t                    inbox_dir = os.path.join(LOOPCLI_DIR, \"main\", \"inbox\")\n468\t                    os.makedirs(inbox_dir, exist_ok=True)\n469\t                    msg_file = os.path.join(inbox_dir, f\"user_{ts}.md\")\n470\t                    with open(msg_file, \"w\", encoding=\"utf-8\") as f:\n471\t                        f.write(f\"# 来自 zhoudingnuo 的消息\\n- 类型：指令\\n- 时间：{datetime.now().strftime('%Y-%m-%d %H:%M')}\\n\\n## 内容\\n{user_input}\\n\")\n472\t                    print(f\"  [已发送] -> main/inbox/\", flush=True)\n473\t            except EOFError:\n474\t                pass\n475\t            print(f\"  等待 {args.wait} 秒后进入下一轮...\", flush=True)\n476\t            time.sleep(args.wait)\n477\t    meta[\"finished\"] = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n478\t    meta[\"total_iterations\"] = count\n479\t    with open(os.path.join(run_log_dir, \"meta.json\"), \"w\", encoding=\"utf-8\") as f:\n480\t        json.dump(meta, f, indent=2, ensure_ascii=False)\n481\t\n482\t    print(f\"\\n运行结束，日志保存在: {run_log_dir}\")\n483\t\n484\t\n485\t# ─── CLI 入口 ───\n486\t\n487\tparser = argparse.ArgumentParser(description=\"LoopCLI — 多 Agent 自治系统\")\n488\tsub = parser.add_subparsers(dest=\"command\")\n489\t\n490\t# loopcli run [-n N]\n491\tp_run = sub.add_parser(\"run\", help=\"启动 Agent 循环（默认）\")\n492\tp_run.add_argument(\"-n\", \"--iterations\", type=int, default=0, help=\"迭代次数，0=无限\")\n493\tp_run.add_argument(\"-w\", \"--wait\", type=int, default=10, help=\"每轮间隔秒数（默认 10）\")\n494\t\n495\t# loopcli create <template> [--task TASK]\n496\tp_create = sub.add_parser(\"create\", help=\"从模板创建新 Agent\")\n497\tp_create.add_argument(\"template\", help=\"模板 ID，如 engineering-frontend-developer\")\n498\tp_create.add_argument(\"--task\", \"-t\", help=\"初始任务描述\")\n499\t\n500\t# loopcli task <agent> <title> [--desc DESC]\n501\tp_task = sub.add_parser(\"task\", help=\"给 Agent 派发任务\")\n502\tp_task.add_argument(\"agent\", help=\"Agent 目录名\")\n503\tp_task.add_argument(\"title\", help=\"任务标题\")\n504\tp_task.add_argument(\"--desc\", \"-d\", default=\"\", help=\"任务描述\")\n505\t\n506\t# loopcli list\n507\tsub.add_parser(\"list\", help=\"列出所有 Agent 及状态\")\n508\t\n509\t# loopcli templates [--filter X]\n510\tp_tpl = sub.add_parser(\"templates\", help=\"列出可用模板\")\n511\tp_tpl.add_argument(\"--filter\", \"-f\", default=\"\", help=\"按关键词筛选\")\n512\t\n513\tdef cmd_enable(args):\n514\t    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n515\t    marker = os.path.join(agent_dir, AGENT_MARKER)\n516\t    if not os.path.isfile(marker):\n517\t        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n518\t        sys.exit(1)\n519\t    with open(marker, \"w\", encoding=\"utf-8\") as f:\n520\t        f.write(\"type: main\\n\")\n521\t    print(f\"[已启用] {args.agent}\")\n522\t\n523\t\n524\tdef cmd_disable(args):\n525\t    if args.agent == \"main\":\n526\t        print(\"[错误] 不能禁用 main Agent\")\n527\t        sys.exit(1)\n528\t    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n529\t    marker = os.path.join(agent_dir, AGENT_MARKER)\n530\t    if not os.path.isfile(marker):\n531\t        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n532\t        sys.exit(1)\n533\t    with open(marker, \"w\", encoding=\"utf-8\") as f:\n534\t        f.write(\"type: main\\ndisabled: true\\n\")\n535\t    print(f\"[已禁用] {args.agent}（loopcli run 将跳过此 Agent）\")\n536\t\n537\t\n538\t# loopcli msg <内容> [--agent AGENT]\n539\tp_msg = sub.add_parser(\"msg\", help=\"给 Agent 发消息\")\n540\tp_msg.add_argument(\"content\", help=\"消息内容\")\n541\tp_msg.add_argument(\"--agent\", \"-a\", default=\"main\", help=\"目标 Agent（默认 main）\")\n542\t\n543\t# loopcli enable <agent>\n544\tp_enable = sub.add_parser(\"enable\", help=\"启用 Agent（可被 loopcli run 调度）\")\n545\tp_enable.add_argument(\"agent\", help=\"Agent 目录名\")\n546\t\n547\t# loopcli disable <agent>\n548\tp_disable = sub.add_parser(\"disable\", help=\"禁用 Agent（跳过调度，节省 token）\")\n549\tp_disable.add_argument(\"agent\", help=\"Agent 目录名\")\n550\t\n551\t# 预处理：把裸数字参数（如 -n 5）转为 run 子命令\n552\tdef cmd_msg(args):\n553\t    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n554\t    inbox = os.path.join(agent_dir, \"inbox\")\n555\t    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n556\t        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n557\t        sys.exit(1)\n558\t    os.makedirs(inbox, exist_ok=True)\n559\t    ts = datetime.now().strftime(\"%Y%m%d_%H%M\")\n560\t    msg_file = os.path.join(inbox, f\"user_{ts}.md\")\n561\t    with open(msg_file, \"w\", encoding=\"utf-8\") as f:\n562\t        f.write(f\"# 来自 zhoudingnuo 的消息\\n- 类型：指令\\n- 时间：{datetime.now().strftime('%Y-%m-%d %H:%M')}\\n\\n## 内容\\n{args.content}\\n\")\n563\t    print(f\"[已发送] -> {args.agent}/inbox/  {args.content}\")\n564\t\n565\t\n566\t# 预处理：把裸数字参数（如 -n 5）转为 run 子命令\n567\tif sys.argv[1:] and sys.argv[1] not in (\"run\", \"create\", \"task\", \"list\", \"templates\", \"msg\", \"enable\", \"disable\", \"-h\", \"--help\"):\n568\t    sys.argv.insert(1, \"run\")\n569\t\n570\targs = parser.parse_args()\n571\t\n572\tif args.command == \"create\":\n573\t    cmd_create(args)\n574\telif args.command == \"task\":\n575\t    cmd_task(args)\n576\telif args.command == \"list\":\n577\t    cmd_list(args)\n578\telif args.command == \"templates\":\n579\t    cmd_templates(args)\n580\telif args.command == \"msg\":\n581\t    cmd_msg(args)\n582\telif args.command == \"enable\":\n583\t    cmd_enable(args)\n584\telif args.command == \"disable\":\n585\t    cmd_disable(args)\n586\telse:\n587\t    # run 或无子命令\n588\t    if not hasattr(args, \"iterations\"):\n589\t        args.iterations = 0\n590\t    if not hasattr(args, \"wait\"):\n591\t        args.wait = 10\n592\t    cmd_run(args)\n593\t"}]},"parent_tool_use_id":null,"session_id":"919a7148-5621-42bf-8d0b-ae3a5846fdc8","uuid":"d100c9fe-bf8f-40b4-a707-cab973921336","timestamp":"2026-05-21T00:04:15.032Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\loopcli\\run.py","content":"import argparse\nimport json\nimport msvcrt\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport threading\nimport time\nfrom datetime import datetime\n\nLOOPCLI_DIR = r\"D:\\loopcli\"\nSUBAGENT_DIR = os.path.join(LOOPCLI_DIR, \"subagent\")\nCLAUDE = os.path.join(os.environ.get(\"APPDATA\", \"\"), \"npm\", \"claude.cmd\")\n\nAGENT_MARKER = \"AGENT\"\nLOGS_DIR = os.path.join(LOOPCLI_DIR, \"logs\")\nGIT_TOKEN_FILE = os.path.join(LOOPCLI_DIR, \".gittoken\")\nDEFAULT_PROMPT = \"\"\"读取 SOUL.md 作为你的身份。\n读取 D:/loopcli/skill/ 下所有技能文件（全局技能）。\n读取 memory/tasks.json 获取分配给你的任务。\n\n执行步骤：\n1. 从 tasks.json 中找 status 为 \"pending\" 的第一个任务\n2. 执行该任务\n3. 将结果写入 memory/results/ 目录（以时间戳命名）\n4. 将该任务 status 改为 \"done\"，写回 tasks.json\n5. 更新 memory/state.json（标记完成、记录时间戳）\n6. 将本次运行摘要追加到 log/run.md\n7. 通过 inbox 通知 main：写入 D:/loopcli/main/inbox/<你的名字>_<时间>.md，简要报告任务结果\n8. 如果没有 pending 任务，输出 \"IDLE\" 并结束本轮\n\"\"\"\n\n\n# ─── 工具函数 ───\n\ndef get_agent_marker(path):\n    \"\"\"读取 AGENT 标记文件内容\"\"\"\n    marker = os.path.join(path, AGENT_MARKER)\n    if os.path.isfile(marker):\n        with open(marker, \"r\", encoding=\"utf-8\") as f:\n            return f.read().strip()\n    return None\n\n\ndef is_agent_enabled(path):\n    \"\"\"检查 Agent 是否启用（AGENT 文件不含 disabled 标记）\"\"\"\n    content = get_agent_marker(path)\n    if content is None:\n        return False\n    return \"disabled\" not in content\n\n\ndef discover_agents(include_disabled=False):\n    agents = []\n    for name in os.listdir(LOOPCLI_DIR):\n        path = os.path.join(LOOPCLI_DIR, name)\n        marker = os.path.join(path, AGENT_MARKER)\n        if os.path.isdir(path) and os.path.isfile(marker):\n            if include_disabled or is_agent_enabled(path):\n                agents.append({\"name\": name, \"path\": path})\n    return agents\n\n\ndef find_template(template_id):\n    \"\"\"在 subagent 目录下搜索模板文件\"\"\"\n    for dept in os.listdir(SUBAGENT_DIR):\n        dept_dir = os.path.join(SUBAGENT_DIR, dept)\n        if not os.path.isdir(dept_dir):\n            continue\n        candidate = os.path.join(dept_dir, f\"{template_id}.md\")\n        if os.path.isfile(candidate):\n            return candidate\n    return None\n\n\ndef load_agent_state(agent_path):\n    state_file = os.path.join(agent_path, \"memory\", \"state.json\")\n    if os.path.isfile(state_file):\n        with open(state_file, \"r\", encoding=\"utf-8\") as f:\n            return json.load(f)\n    return None\n\n\ndef load_agent_tasks(agent_path):\n    tasks_file = os.path.join(agent_path, \"memory\", \"tasks.json\")\n    if os.path.isfile(tasks_file):\n        with open(tasks_file, \"r\", encoding=\"utf-8\") as f:\n            return json.load(f)\n    return []\n\n\n# ─── 子命令: create ───\n\ndef cmd_create(args):\n    template_id = args.template\n    task_desc = args.task or \"\"\n\n    tpl_file = find_template(template_id)\n    if not tpl_file:\n        print(f\"[错误] 找不到模板: {template_id}\")\n        print(\"用 loopcli templates 查看所有可用模板\")\n        sys.exit(1)\n\n    with open(tpl_file, \"r\", encoding=\"utf-8\") as f:\n        soul_content = f.read()\n\n    agent_dir = os.path.join(LOOPCLI_DIR, template_id)\n    if os.path.exists(agent_dir):\n        print(f\"[跳过] Agent 已存在: {agent_dir}\")\n        if task_desc:\n            cmd_task_inner(template_id, task_desc, \"\")\n        return\n\n    # 创建目录结构\n    os.makedirs(os.path.join(agent_dir, \"memory\", \"results\"), exist_ok=True)\n    os.makedirs(os.path.join(agent_dir, \"log\"), exist_ok=True)\n\n    # AGENT 标记\n    with open(os.path.join(agent_dir, AGENT_MARKER), \"w\", encoding=\"utf-8\") as f:\n        f.write(\"type: main\\n\")\n\n    # SOUL.md（模板内容）\n    with open(os.path.join(agent_dir, \"SOUL.md\"), \"w\", encoding=\"utf-8\") as f:\n        f.write(soul_content)\n\n    # PROMPT.md\n    with open(os.path.join(agent_dir, \"PROMPT.md\"), \"w\", encoding=\"utf-8\") as f:\n        f.write(DEFAULT_PROMPT)\n\n    # state.json\n    state = {\"agent\": template_id, \"status\": \"idle\", \"current_task\": None, \"last_run\": None, \"run_count\": 0, \"created\": datetime.now().strftime(\"%Y-%m-%d\")}\n    with open(os.path.join(agent_dir, \"memory\", \"state.json\"), \"w\", encoding=\"utf-8\") as f:\n        json.dump(state, f, indent=2, ensure_ascii=False)\n\n    # tasks.json\n    tasks = []\n    if task_desc:\n        tasks.append({\"id\": 1, \"status\": \"pending\", \"title\": task_desc, \"description\": task_desc, \"created\": datetime.now().strftime(\"%Y-%m-%d\"), \"assignee\": template_id})\n    with open(os.path.join(agent_dir, \"memory\", \"tasks.json\"), \"w\", encoding=\"utf-8\") as f:\n        json.dump(tasks, f, indent=2, ensure_ascii=False)\n\n    # run.md\n    with open(os.path.join(agent_dir, \"log\", \"run.md\"), \"w\", encoding=\"utf-8\") as f:\n        f.write(\"# 运行日志\\n\\n| 时间 | 状态 | 任务 | 摘要 |\\n|------|------|------|------|\\n\")\n\n    print(f\"[创建成功] {template_id}\")\n    print(f\"  目录: {agent_dir}\")\n    if task_desc:\n        print(f\"  任务: {task_desc}\")\n    print(f\"  下一轮 loopcli 将自动启动该 Agent\")\n\n\n# ─── 子命令: task ───\n\ndef cmd_task_inner(agent_name, title, desc):\n    agent_dir = os.path.join(LOOPCLI_DIR, agent_name)\n    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n        print(f\"[错误] 不是有效的 Agent: {agent_name}\")\n        sys.exit(1)\n\n    tasks_file = os.path.join(agent_dir, \"memory\", \"tasks.json\")\n    tasks = load_agent_tasks(agent_dir)\n    next_id = max((t[\"id\"] for t in tasks), default=0) + 1\n    tasks.append({\n        \"id\": next_id,\n        \"status\": \"pending\",\n        \"title\": title,\n        \"description\": desc or title,\n        \"created\": datetime.now().strftime(\"%Y-%m-%d\"),\n        \"assignee\": agent_name\n    })\n    with open(tasks_file, \"w\", encoding=\"utf-8\") as f:\n        json.dump(tasks, f, indent=2, ensure_ascii=False)\n    print(f\"[派发成功] {agent_name} <- #{next_id} {title}\")\n\n\ndef cmd_task(args):\n    cmd_task_inner(args.agent, args.title, args.desc)\n\n\n# ─── 子命令: list ───\n\ndef cmd_list(args):\n    agents = discover_agents(include_disabled=True)\n    if not agents:\n        print(\"没有发现任何 Agent\")\n        return\n    print(f\"{'Agent':<45} {'启用':<6} {'状态':<10} {'任务数':<8} {'最后运行'}\")\n    print(\"-\" * 95)\n    for a in agents:\n        enabled = \"是\" if is_agent_enabled(a[\"path\"]) else \"否\"\n        state = load_agent_state(a[\"path\"]) or {}\n        tasks = load_agent_tasks(a[\"path\"])\n        pending = len([t for t in tasks if t.get(\"status\") == \"pending\"])\n        status = state.get(\"status\", \"?\")\n        last_run = state.get(\"last_run\", \"-\")\n        print(f\"{a['name']:<45} {enabled:<6} {status:<10} {pending:<8} {last_run}\")\n\n\n# ─── 子命令: templates ───\n\ndef cmd_templates(args):\n    found = []\n    for dept in sorted(os.listdir(SUBAGENT_DIR)):\n        dept_dir = os.path.join(SUBAGENT_DIR, dept)\n        if not os.path.isdir(dept_dir):\n            continue\n        for fname in sorted(os.listdir(dept_dir)):\n            if fname.endswith(\".md\"):\n                found.append(fname[:-3])\n    if args.filter:\n        found = [t for t in found if args.filter.lower() in t.lower()]\n    print(f\"共 {len(found)} 个模板:\")\n    for t in found:\n        print(f\"  {t}\")\n\n\n# ─── 子命令: run（主循环）───\n\ndef handle_event(agent_name, line):\n    line = line.strip()\n    if not line:\n        return\n    try:\n        event = json.loads(line)\n    except json.JSONDecodeError:\n        print(f\"[{agent_name}] {line}\", flush=True)\n        return\n\n    event_type = event.get(\"type\", \"\")\n\n    if event_type == \"assistant\":\n        msg = event.get(\"message\", {})\n        for block in msg.get(\"content\", []):\n            if block.get(\"type\") == \"text\":\n                text = block.get(\"text\", \"\")\n                if text:\n                    print(f\"[{agent_name}] {text}\", flush=True)\n            elif block.get(\"type\") == \"tool_use\":\n                name = block.get(\"name\", \"\")\n                inp = block.get(\"input\", {})\n                detail = \"\"\n                for k in (\"file_path\", \"command\", \"pattern\"):\n                    if k in inp:\n                        detail = inp[k]\n                        break\n                print(f\"[{agent_name}] ● {name}({detail})\", flush=True)\n\n    elif event_type == \"tool_result\":\n        content = event.get(\"content\", \"\")\n        texts = []\n        if isinstance(content, list):\n            texts = [b.get(\"text\", \"\") for b in content if b.get(\"text\")]\n        elif isinstance(content, str):\n            texts = [content]\n        for text in texts:\n            print(f\"[{agent_name}]   ↳ {text[:200]}\", flush=True)\n\n    elif event_type == \"result\":\n        text = event.get(\"result\", \"\")\n        if text:\n            print(f\"[{agent_name}] [结果] {text[:500]}\", flush=True)\n        cost = event.get(\"cost_usd\", \"\")\n        duration = event.get(\"duration_ms\", \"\")\n        if cost or duration:\n            print(f\"[{agent_name}] [统计] 耗时: {duration}ms, 费用: ${cost}\", flush=True)\n\n    elif event_type == \"error\":\n        print(f\"[{agent_name}] [错误] {event.get('error', '')}\", flush=True)\n\n\ndef run_agent(agent, iteration, run_log_dir):\n    name = agent[\"name\"]\n    path = agent[\"path\"]\n    prompt_file = os.path.join(path, \"PROMPT.md\")\n    log_file_path = os.path.join(path, \"log\", \"raw.log\")\n    run_agent_log = os.path.join(run_log_dir, f\"{name}.log\")\n    ts = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n\n    if not os.path.isfile(prompt_file):\n        print(f\"[{name}] 没有 PROMPT.md，跳过\", flush=True)\n        return\n\n    with open(prompt_file, \"r\", encoding=\"utf-8\") as f:\n        prompt = f.read()\n\n    os.makedirs(os.path.join(path, \"log\"), exist_ok=True)\n    log_file = open(log_file_path, \"a\", encoding=\"utf-8\")\n    agent_log = open(run_agent_log, \"a\", encoding=\"utf-8\")\n\n    try:\n        header = f\"\\n[{ts}] --- 开始 (第{iteration}轮) ---\\n\"\n        log_file.write(header)\n        agent_log.write(header)\n        log_file.flush()\n        agent_log.flush()\n\n        env = {**os.environ, \"IS_SANDBOX\": \"1\"}\n\n        proc = subprocess.Popen(\n            [CLAUDE, \"--print\", \"--verbose\", \"--output-format\", \"stream-json\", \"--dangerously-skip-permissions\"],\n            stdin=subprocess.PIPE,\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            env=env,\n            cwd=path,\n        )\n\n        proc.stdin.write(prompt.encode(\"utf-8\"))\n        proc.stdin.close()\n\n        for line in proc.stdout:\n            decoded = line.decode(\"utf-8\", errors=\"replace\")\n            log_file.write(decoded)\n            agent_log.write(decoded)\n            log_file.flush()\n            agent_log.flush()\n            handle_event(name, decoded)\n\n        stderr_output = proc.stderr.read().decode(\"utf-8\", errors=\"replace\")\n        if stderr_output:\n            print(f\"[{name}] [STDERR] {stderr_output}\", flush=True)\n            log_file.write(stderr_output)\n            agent_log.write(stderr_output)\n\n        proc.wait()\n\n        footer = f\"\\n[{ts}] --- 结束 (exit={proc.returncode}) ---\\n\"\n        log_file.write(footer)\n        agent_log.write(footer)\n    finally:\n        log_file.close()\n        agent_log.close()\n\n    # 更新 state.json (with file lock)\n    state_file = os.path.join(path, \"memory\", \"state.json\")\n    with open(state_file, \"a+\") as f:\n        msvcrt.locking(f.fileno(), msvcrt.LK_LOCK, 1)\n        try:\n            f.seek(0)\n            try:\n                state = json.load(f)\n            except (json.JSONDecodeError, ValueError):\n                state = {}\n            state[\"status\"] = \"idle\"\n            state[\"last_run\"] = ts\n            state[\"run_count\"] = state.get(\"run_count\", 0) + 1\n            f.seek(0)\n            f.truncate()\n            json.dump(state, f, indent=2, ensure_ascii=False)\n        finally:\n            msvcrt.locking(f.fileno(), msvcrt.LK_UNLCK, 1)\n\n    status = \"完成\" if proc.returncode == 0 else f\"异常(exit={proc.returncode})\"\n    print(f\"[{name}] 本轮{status}\", flush=True)\n\n\ndef git_push():\n    \"\"\"自动 commit 和 push 到 GitHub\"\"\"\n    token_file = GIT_TOKEN_FILE\n    if not os.path.isfile(token_file):\n        return\n    with open(token_file, \"r\") as f:\n        token = f.read().strip()\n    if not token:\n        return\n    try:\n        git = resolve_git()\n        subprocess.run([git, \"add\", \"-A\"], cwd=LOOPCLI_DIR, capture_output=True, timeout=30)\n        subprocess.run(\n            [git, \"commit\", \"-m\", f\"auto: loopcli sync {datetime.now().strftime('%Y-%m-%d %H:%M')}\"],\n            cwd=LOOPCLI_DIR, capture_output=True, timeout=30\n        )\n        # Use GIT_ASKPASS to avoid exposing token in command line\n        askpass_script = os.path.join(LOOPCLI_DIR, \".git_askpass.bat\")\n        with open(askpass_script, \"w\") as f:\n            f.write(\"@echo %GH_TOKEN%\\n\")\n        push_env = {\n            **os.environ,\n            \"GH_TOKEN\": token,\n            \"GIT_ASKPASS\": askpass_script,\n            \"GIT_TERMINAL_PROMPT\": \"0\",\n        }\n        subprocess.run(\n            [git, \"push\", \"https://x-access-token@github.com/zhoudingnuo/loopcli.git\", \"main\"],\n            cwd=LOOPCLI_DIR, capture_output=True, timeout=60, env=push_env,\n        )\n        os.remove(askpass_script)\n        print(\"[git] 已同步到 GitHub\", flush=True)\n    except Exception as e:\n        print(f\"[git] 同步失败: {e}\", flush=True)\n\n\ndef resolve_git():\n    \"\"\"找到 git.exe 的完整路径\"\"\"\n    for p in os.environ.get(\"PATH\", \"\").split(\";\"):\n        candidate = os.path.join(p, \"git.exe\")\n        if os.path.isfile(candidate):\n            return candidate\n    # 常见安装路径\n    for d in [r\"C:\\Program Files\\Git\\cmd\", r\"C:\\Program Files\\Git\\bin\"]:\n        candidate = os.path.join(d, \"git.exe\")\n        if os.path.isfile(candidate):\n            return candidate\n    return \"git\"\n\n\ndef cmd_run(args):\n    agents = discover_agents()\n    if not agents:\n        print(\"未发现任何 Agent（需要目录下有 AGENT 标记文件）\")\n        sys.exit(1)\n\n    # 创建本次运行日志目录\n    run_id = datetime.now().strftime(\"run_%Y%m%d_%H%M%S\")\n    run_log_dir = os.path.join(LOGS_DIR, run_id)\n    os.makedirs(run_log_dir, exist_ok=True)\n\n    # 写入运行元信息\n    meta = {\n        \"run_id\": run_id,\n        \"started\": datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"),\n        \"iterations\": args.iterations or \"无限\",\n        \"agents\": [a[\"name\"] for a in agents],\n    }\n    with open(os.path.join(run_log_dir, \"meta.json\"), \"w\", encoding=\"utf-8\") as f:\n        json.dump(meta, f, indent=2, ensure_ascii=False)\n\n    print(f\"运行 ID: {run_id}\")\n    print(f\"日志目录: {run_log_dir}\")\n    print(f\"发现 {len(agents)} 个 Agent: {', '.join(a['name'] for a in agents)}\")\n\n    count = 0\n    while args.iterations == 0 or count < args.iterations:\n        count += 1\n        # 每轮重新扫描（可能有新 Agent）\n        agents = discover_agents()\n        ts = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n        print(f\"\\n{'='*60}\")\n        print(f\"[{ts}] 第 {count}{'/' + str(args.iterations) if args.iterations else ''} 轮 | {len(agents)} 个 Agent\")\n        print(f\"{'='*60}\")\n\n        threads = []\n        for agent in agents:\n            print(f\"\\n--- 启动 [{agent['name']}] ---\", flush=True)\n            t = threading.Thread(target=run_agent, args=(agent, count, run_log_dir))\n            t.start()\n            threads.append(t)\n        for t in threads:\n            t.join()\n\n        # 每轮结束后同步到 GitHub\n        git_push()\n\n        # 等待下一轮，期间可输入消息\n        if args.iterations == 0 or count < args.iterations:\n            print(f\"\\n{'─'*60}\", flush=True)\n            print(f\"输入消息发给 main（直接回车跳过，输入 exit 停止）:\", flush=True)\n            try:\n                user_input = input(f\"  > \").strip()\n                if user_input.lower() == \"exit\":\n                    print(\"用户终止运行\")\n                    break\n                if user_input:\n                    ts = datetime.now().strftime(\"%Y%m%d_%H%M\")\n                    inbox_dir = os.path.join(LOOPCLI_DIR, \"main\", \"inbox\")\n                    os.makedirs(inbox_dir, exist_ok=True)\n                    msg_file = os.path.join(inbox_dir, f\"user_{ts}.md\")\n                    with open(msg_file, \"w\", encoding=\"utf-8\") as f:\n                        f.write(f\"# 来自 zhoudingnuo 的消息\\n- 类型：指令\\n- 时间：{datetime.now().strftime('%Y-%m-%d %H:%M')}\\n\\n## 内容\\n{user_input}\\n\")\n                    print(f\"  [已发送] -> main/inbox/\", flush=True)\n            except EOFError:\n                pass\n            print(f\"  等待 {args.wait} 秒后进入下一轮...\", flush=True)\n            time.sleep(args.wait)\n    meta[\"finished\"] = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n    meta[\"total_iterations\"] = count\n    with open(os.path.join(run_log_dir, \"meta.json\"), \"w\", encoding=\"utf-8\") as f:\n        json.dump(meta, f, indent=2, ensure_ascii=False)\n\n    print(f\"\\n运行结束，日志保存在: {run_log_dir}\")\n\n\n# ─── CLI 入口 ───\n\nparser = argparse.ArgumentParser(description=\"LoopCLI — 多 Agent 自治系统\")\nsub = parser.add_subparsers(dest=\"command\")\n\n# loopcli run [-n N]\np_run = sub.add_parser(\"run\", help=\"启动 Agent 循环（默认）\")\np_run.add_argument(\"-n\", \"--iterations\", type=int, default=0, help=\"迭代次数，0=无限\")\np_run.add_argument(\"-w\", \"--wait\", type=int, default=10, help=\"每轮间隔秒数（默认 10）\")\n\n# loopcli create <template> [--task TASK]\np_create = sub.add_parser(\"create\", help=\"从模板创建新 Agent\")\np_create.add_argument(\"template\", help=\"模板 ID，如 engineering-frontend-developer\")\np_create.add_argument(\"--task\", \"-t\", help=\"初始任务描述\")\n\n# loopcli task <agent> <title> [--desc DESC]\np_task = sub.add_parser(\"task\", help=\"给 Agent 派发任务\")\np_task.add_argument(\"agent\", help=\"Agent 目录名\")\np_task.add_argument(\"title\", help=\"任务标题\")\np_task.add_argument(\"--desc\", \"-d\", default=\"\", help=\"任务描述\")\n\n# loopcli list\nsub.add_parser(\"list\", help=\"列出所有 Agent 及状态\")\n\n# loopcli templates [--filter X]\np_tpl = sub.add_parser(\"templates\", help=\"列出可用模板\")\np_tpl.add_argument(\"--filter\", \"-f\", default=\"\", help=\"按关键词筛选\")\n\ndef cmd_enable(args):\n    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n    marker = os.path.join(agent_dir, AGENT_MARKER)\n    if not os.path.isfile(marker):\n        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n        sys.exit(1)\n    with open(marker, \"w\", encoding=\"utf-8\") as f:\n        f.write(\"type: main\\n\")\n    print(f\"[已启用] {args.agent}\")\n\n\ndef cmd_disable(args):\n    if args.agent == \"main\":\n        print(\"[错误] 不能禁用 main Agent\")\n        sys.exit(1)\n    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n    marker = os.path.join(agent_dir, AGENT_MARKER)\n    if not os.path.isfile(marker):\n        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n        sys.exit(1)\n    with open(marker, \"w\", encoding=\"utf-8\") as f:\n        f.write(\"type: main\\ndisabled: true\\n\")\n    print(f\"[已禁用] {args.agent}（loopcli run 将跳过此 Agent）\")\n\n\n# loopcli msg <内容> [--agent AGENT]\np_msg = sub.add_parser(\"msg\", help=\"给 Agent 发消息\")\np_msg.add_argument(\"content\", help=\"消息内容\")\np_msg.add_argument(\"--agent\", \"-a\", default=\"main\", help=\"目标 Agent（默认 main）\")\n\n# loopcli enable <agent>\np_enable = sub.add_parser(\"enable\", help=\"启用 Agent（可被 loopcli run 调度）\")\np_enable.add_argument(\"agent\", help=\"Agent 目录名\")\n\n# loopcli disable <agent>\np_disable = sub.add_parser(\"disable\", help=\"禁用 Agent（跳过调度，节省 token）\")\np_disable.add_argument(\"agent\", help=\"Agent 目录名\")\n\n# 预处理：把裸数字参数（如 -n 5）转为 run 子命令\ndef cmd_msg(args):\n    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n    inbox = os.path.join(agent_dir, \"inbox\")\n    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n        sys.exit(1)\n    os.makedirs(inbox, exist_ok=True)\n    ts = datetime.now().strftime(\"%Y%m%d_%H%M\")\n    msg_file = os.path.join(inbox, f\"user_{ts}.md\")\n    with open(msg_file, \"w\", encoding=\"utf-8\") as f:\n        f.write(f\"# 来自 zhoudingnuo 的消息\\n- 类型：指令\\n- 时间：{datetime.now().strftime('%Y-%m-%d %H:%M')}\\n\\n## 内容\\n{args.content}\\n\")\n    print(f\"[已发送] -> {args.agent}/inbox/  {args.content}\")\n\n\n# 预处理：把裸数字参数（如 -n 5）转为 run 子命令\nif sys.argv[1:] and sys.argv[1] not in (\"run\", \"create\", \"task\", \"list\", \"templates\", \"msg\", \"enable\", \"disable\", \"-h\", \"--help\"):\n    sys.argv.insert(1, \"run\")\n\nargs = parser.parse_args()\n\nif args.command == \"create\":\n    cmd_create(args)\nelif args.command == \"task\":\n    cmd_task(args)\nelif args.command == \"list\":\n    cmd_list(args)\nelif args.command == \"templates\":\n    cmd_templates(args)\nelif args.command == \"msg\":\n    cmd_msg(args)\nelif args.command == \"enable\":\n    cmd_enable(args)\nelif args.command == \"disable\":\n    cmd_disable(args)\nelse:\n    # run 或无子命令\n    if not hasattr(args, \"iterations\"):\n        args.iterations = 0\n    if not hasattr(args, \"wait\"):\n        args.wait = 10\n    cmd_run(args)\n","numLines":593,"startLine":1,"totalLines":593}}}
{"type":"assistant","message":{"id":"msg_20260521080417d719d7b0e27948f0","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"thinking","thinking":"Now I have a complete picture. Let me analyze the tests against the source code and write a comprehensive review. Let me organize my thoughts:\n\n**Task #5: 审查 64 个单元测试的覆盖质量和有效性**\n\ntest_server.py: 41 tests (I need to count exactly)\ntest_run.py: 23 tests (I need to count exactly)\n\nLet me count the tests:\n\n**test_server.py:**\n1. TestSafeAgentPath:\n   - test_valid_agent\n   - test_empty_string\n   - test_slash_traversal\n   - test_backslash_traversal\n   - test_double_dot\n   - test_path_with_slash\n   - test_path_with_backslash\n   - test_valid_subdir_name\n   = 8 tests\n\n2. TestJsonIO:\n   - test_read_nonexistent_returns_default\n   - test_read_nonexistent_no_default\n   - test_read_valid_json\n   - test_read_corrupt_json\n   - test_write_json_creates_dirs\n   - test_roundtrip\n   = 6 tests\n\n3. TestGetRecentLines:\n   - test_nonexistent_file\n   - test_reads_last_n\n   - test_all_lines_if_fewer_than_n\n   = 3 tests\n\n4. TestScanAgents:\n   - test_returns_list\n   - test_main_agent_present\n   - test_agent_has_required_fields\n   = 3 tests\n\n5. TestGetAgents:\n   - test_returns_200\n   - test_returns_json_list\n   - test_includes_main\n   = 3 tests\n\n6. TestGetTasks:\n   - test_returns_200\n   - test_returns_json_list\n   = 2 tests\n\n7. TestCreateTask:\n   - test_create_task_success\n   - test_create_task_missing_title\n   - test_create_task_empty_body\n   = 3 tests\n\n8. TestMessageSend:\n   - test_send_to_main\n   - test_send_default_agent_is_main\n   - test_send_empty_content\n   - test_send_to_invalid_agent\n   - test_send_to_nonexistent_agent\n   = 5 tests\n\n9. TestPathTraversal:\n   - test_agents_endpoint_rejects_traversal\n   - test_agents_endpoint_rejects_dotdot\n   - test_messages_send_rejects_traversal\n   = 3 tests\n\n10. TestGetLogs:\n    - test_returns_200\n    - test_with_valid_agent\n    - test_with_invalid_agent\n    = 3 tests\n\n11. TestCORS:\n    - test_options_returns_204\n    = 1 test\n\n12. TestNotFound:\n    - test_unknown_post_returns_404\n    = 1 test\n\nTotal test_server.py: 8 + 6 + 3 + 3 + 3 + 2 + 3 + 5 + 3 + 3 + 1 + 1 = 41\n\n**test_run.py:**\n1. TestGetAgentMarker:\n   - test_reads_valid_marker\n   - test_returns_none_for_missing\n   - test_reads_disabled_marker\n   = 3 tests\n\n2. TestIsAgentEnabled:\n   - test_enabled_agent\n   - test_disabled_agent\n   - test_no_marker\n   = 3 tests\n\n3. TestDiscoverAgents:\n   - test_finds_real_agents\n   - test_agent_has_required_keys\n   - test_excludes_disabled\n   = 3 tests\n\n4. TestFindTemplate:\n   - test_existing_template\n   - test_nonexistent_template\n   = 2 tests\n\n5. TestLoadAgentState:\n   - test_loads_main_state\n   - test_loads_state_from_fixture\n   - test_missing_state_returns_none\n   = 3 tests\n\n6. TestLoadAgentTasks:\n   - test_loads_tasks\n   - test_empty_tasks\n   - test_missing_returns_empty\n   - test_real_main_tasks\n   = 4 tests\n\n7. TestCmdTaskInner:\n   - test_adds_task_to_fake_agent_exits\n   - test_adds_task_to_real_agent\n   - test_task_id_auto_increments\n   = 3 tests\n\n8. TestAgentStructure:\n   - test_main_has_required_files\n   - test_frontend_agent_has_required_files\n   = 2 tests\n\nTotal test_run.py: 3 + 3 + 3 + 2 + 3 + 4 + 3 + 2 = 23\n\nGrand total: 41 + 23 = 64 ✓\n\nNow let me do the actual review:\n\n**1. Tests covering key security fixes (_safe_agent_path, shell=True removal, file locks)**\n\n_safe_agent_path: Well tested in TestSafeAgentPath with 8 tests covering:\n- Valid input ✓\n- Empty string ✓\n- Forward slash traversal ✓\n- Backslash traversal ✓\n- Double dot ✓\n- Slash in path ✓\n- Backslash in path ✓\n- Valid subdir name ✓\n\nHowever, there are some edge cases not covered:\n- What about null bytes in path? (e.g., \"main\\x00/etc\")\n- What about Unicode-based traversal? (e.g., \"main\\uff0f\" which is a fullwidth slash)\n- What about URL-encoded characters? (e.g., \"%2e%2e\")\n- What about the path being valid but not a directory? (symlink attacks)\n- The resolve().relative_to() check is tested indirectly but there's no test for a specifically crafted path that passes the initial checks but fails the resolve check\n\nshell=True removal: This is not directly testable through unit tests since it's about how subprocess.Popen is called. The tests don't verify that shell=True is not used. However, this is more of a code review concern.\n\nFile locks: Not tested at all in the test suite. The msvcrt.locking mechanism in run.py's run_agent function is not tested.\n\n**2. Tests only covering happy paths vs edge cases**\n\nLet me check what's well tested and what's missing:\n\nWell tested (both happy and error paths):\n- _safe_agent_path: good coverage\n- read_json/write_json: good coverage\n- get_recent_lines: good coverage\n- Message send: good coverage including error cases\n\nMissing edge cases:\n- No test for concurrent writes to the same file (write_json under concurrent access)\n- No test for _read_body with malformed JSON (non-JSON body)\n- No test for very large payloads (DoS)\n- No test for SSE endpoints (/_handle_sse_logs)\n- No test for loop process management (start/stop/restart)\n- No test for _handle_loopcli_dispatch (API key auth)\n- No test for _handle_agent_start\n- No test for _handle_agent_enable/disable\n- No test for _monitor_loopcli\n- No test for _is_pid_alive\n- No test for _write_semaphore (concurrent write limiting)\n\n**3. Mock/Stub quality**\n\nThe test_server.py uses a real HTTP server (ThreadedHTTPServer), which is great for integration testing but:\n- Tests hit the real filesystem (LOOPCLI_ROOT, MAIN_DIR)\n- Tests modify real state (test_create_task_success writes to actual tasks.json)\n- The cleanup logic in test_create_task_success restores original tasks but via write_json which could fail\n- The message send tests clean up individual files but don't handle failure scenarios well\n\nThe test_run.py uses:\n- tmp_path fixtures for fake_agent - this is good\n- Real filesystem for discovery tests - this is acceptable\n- Real agent modifications in test_adds_task_to_real_agent - this writes to the real agent's tasks.json\n\n**4. Test independence**\n\n- test_create_task_success depends on the state of the real tasks.json\n- test_adds_task_to_real_agent modifies the real engineering-frontend-developer's tasks.json\n- test_send_to_main creates real files in the filesystem\n- Port conflicts could occur but are mitigated by the counter\n\n**5. Missing important test scenarios**\n\nCritical missing tests:\n- SSE streaming (/_handle_sse_logs) - completely untested\n- Loop process management (start/stop/restart/status) - completely untested\n- API key authentication (/_handle_loopcli_dispatch) - untested\n- Agent start (/_handle_agent_start) - untested\n- Agent enable/disable - untested\n- Concurrent access to shared files - untested\n- _monitor_loopcli callback - untested\n- _is_pid_alive - untested\n- handle_event in run.py - untested\n- run_agent in run.py - untested\n- cmd_create - untested\n- cmd_list - untested\n- cmd_run - untested\n- git_push - untested\n- File lock mechanism (msvcrt.locking) - untested\n- Semaphore-based rate limiting - untested\n\nLet me now write the review report.","signature":""}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"919a7148-5621-42bf-8d0b-ae3a5846fdc8","uuid":"5125effa-54d4-456d-a21c-54ba90229f95"}
