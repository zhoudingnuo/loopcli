{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ef9d08e5dbbf4cd6aaefd451","type":"tool_result","content":"1\t\"\"\"\n2\tLoopCLI WebUI Backend Server\n3\tREST API + static file hosting for the Agent control console.\n4\t\"\"\"\n5\t\n6\timport json\n7\timport os\n8\timport signal\n9\timport subprocess\n10\timport sys\n11\timport time\n12\timport threading\n13\tfrom datetime import datetime, timezone\n14\tfrom http.server import HTTPServer, SimpleHTTPRequestHandler\n15\tfrom socketserver import ThreadingMixIn\n16\tfrom pathlib import Path\n17\tfrom urllib.parse import urlparse, parse_qs\n18\t\n19\tLOOPCLI_ROOT = Path(r\"D:\\loopcli\")\n20\tWEBUI_DIR = Path(__file__).parent.resolve()\n21\tMAIN_DIR = LOOPCLI_ROOT / \"main\"\n22\tLOOP_STATE_FILE = WEBUI_DIR / \"loop_state.json\"\n23\t\n24\t_loop_proc = None\n25\t_loop_lock = threading.Lock()\n26\tAPI_KEY = os.environ.get(\"LOOPCLI_API_KEY\", \"\")\n27\t\n28\t\n29\tdef read_json(path: Path, default=None):\n30\t    if not path.exists():\n31\t        return default if default is not None else {}\n32\t    try:\n33\t        return json.loads(path.read_text(encoding=\"utf-8\"))\n34\t    except (json.JSONDecodeError, OSError):\n35\t        return default if default is not None else {}\n36\t\n37\t\n38\tdef write_json(path: Path, data):\n39\t    path.parent.mkdir(parents=True, exist_ok=True)\n40\t    path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n41\t\n42\t\n43\tdef _safe_agent_path(agent_id: str) -> Path | None:\n44\t    if not agent_id or '/' in agent_id or '\\\\' in agent_id or '..' in agent_id:\n45\t        return None\n46\t    agent_dir = LOOPCLI_ROOT / agent_id\n47\t    try:\n48\t        agent_dir.resolve().relative_to(LOOPCLI_ROOT.resolve())\n49\t    except ValueError:\n50\t        return None\n51\t    return agent_dir\n52\t\n53\t\n54\tdef scan_agents():\n55\t    \"\"\"Scan loopcli root for agent directories (containing AGENT marker file).\"\"\"\n56\t    agents = []\n57\t    for child in LOOPCLI_ROOT.iterdir():\n58\t        if not child.is_dir():\n59\t            continue\n60\t        agent_marker = child / \"AGENT\"\n61\t        if not agent_marker.exists():\n62\t            continue\n63\t        state = read_json(child / \"memory\" / \"state.json\", {})\n64\t        soul_path = child / \"SOUL.md\"\n65\t        desc = \"\"\n66\t        if soul_path.exists():\n67\t            lines = soul_path.read_text(encoding=\"utf-8\").strip().splitlines()\n68\t            for line in lines:\n69\t                stripped = line.strip()\n70\t                if stripped and not stripped.startswith(\"#\"):\n71\t                    desc = stripped\n72\t                    break\n73\t        agents.append({\n74\t            \"id\": child.name,\n75\t            \"name\": state.get(\"agent\", child.name),\n76\t            \"status\": state.get(\"status\", \"unknown\"),\n77\t            \"description\": desc,\n78\t            \"last_run\": state.get(\"last_run\"),\n79\t            \"run_count\": state.get(\"run_count\", 0),\n80\t            \"current_task\": state.get(\"current_task\"),\n81\t        })\n82\t    return agents\n83\t\n84\t\n85\tdef get_main_tasks():\n86\t    return read_json(MAIN_DIR / \"memory\" / \"tasks.json\", [])\n87\t\n88\t\n89\tdef get_recent_lines(filepath: Path, n=100):\n90\t    if not filepath.exists():\n91\t        return []\n92\t    try:\n93\t        with open(filepath, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n94\t            lines = f.readlines()\n95\t        return [l.rstrip(\"\\n\\r\") for l in lines[-n:]]\n96\t    except OSError:\n97\t        return []\n98\t\n99\t\n100\t# --- Loop Process Management ---\n101\t\n102\tdef get_loop_state():\n103\t    return read_json(LOOP_STATE_FILE, {\n104\t        \"status\": \"stopped\", \"pid\": None,\n105\t        \"started_at\": None, \"iterations\": 0, \"total_iterations\": 0,\n106\t    })\n107\t\n108\t\n109\tdef set_loop_state(state):\n110\t    write_json(LOOP_STATE_FILE, state)\n111\t\n112\t\n113\tdef _is_pid_alive(pid):\n114\t    if not pid:\n115\t        return False\n116\t    try:\n117\t        os.kill(pid, 0)\n118\t        return True\n119\t    except (ProcessLookupError, PermissionError, OSError):\n120\t        return False\n121\t\n122\t\n123\tdef _monitor_loopcli(proc):\n124\t    proc.wait()\n125\t    with _loop_lock:\n126\t        state = get_loop_state()\n127\t        if state.get(\"pid\") == proc.pid:\n128\t            state[\"status\"] = \"stopped\"\n129\t            state[\"pid\"] = None\n130\t            state[\"ended_at\"] = datetime.now().isoformat()\n131\t            set_loop_state(state)\n132\t\n133\t\n134\tdef start_loopcli_process(iterations=0):\n135\t    global _loop_proc\n136\t    with _loop_lock:\n137\t        state = get_loop_state()\n138\t        if state.get(\"status\") == \"running\" and _is_pid_alive(state.get(\"pid\")):\n139\t            return {\"error\": \"Already running\"}, 409\n140\t\n141\t        cmd = [sys.executable, str(LOOPCLI_ROOT / \"run.py\"), \"run\"]\n142\t        if iterations > 0:\n143\t            cmd.extend([\"-n\", str(iterations)])\n144\t\n145\t        proc = subprocess.Popen(\n146\t            cmd,\n147\t            stdout=subprocess.DEVNULL,\n148\t            stderr=subprocess.DEVNULL,\n149\t            creationflags=getattr(subprocess, \"CREATE_NO_WINDOW\", 0),\n150\t        )\n151\t        _loop_proc = proc\n152\t\n153\t        state = {\n154\t            \"status\": \"running\",\n155\t            \"pid\": proc.pid,\n156\t            \"started_at\": datetime.now().isoformat(),\n157\t            \"iterations\": iterations,\n158\t            \"total_iterations\": 0,\n159\t        }\n160\t        set_loop_state(state)\n161\t\n162\t        t = threading.Thread(target=_monitor_loopcli, args=(proc,), daemon=True)\n163\t        t.start()\n164\t        return state, 200\n165\t\n166\t\n167\tdef stop_loopcli_process():\n168\t    global _loop_proc\n169\t    with _loop_lock:\n170\t        state = get_loop_state()\n171\t        pid = state.get(\"pid\")\n172\t        if not pid or not _is_pid_alive(pid):\n173\t            state[\"status\"] = \"stopped\"\n174\t            state[\"pid\"] = None\n175\t            set_loop_state(state)\n176\t            return {\"error\": \"Not running\"}, 409\n177\t\n178\t        try:\n179\t            os.kill(pid, signal.SIGTERM)\n180\t        except OSError:\n181\t            pass\n182\t        if _loop_proc and _loop_proc.pid == pid:\n183\t            try:\n184\t                _loop_proc.terminate()\n185\t            except OSError:\n186\t                pass\n187\t            _loop_proc = None\n188\t\n189\t        state[\"status\"] = \"stopped\"\n190\t        state[\"pid\"] = None\n191\t        state[\"ended_at\"] = datetime.now().isoformat()\n192\t        set_loop_state(state)\n193\t        return {\"status\": \"stopped\"}, 200\n194\t\n195\t\n196\tclass WebUIHandler(SimpleHTTPRequestHandler):\n197\t    def __init__(self, *args, **kwargs):\n198\t        super().__init__(*args, directory=str(WEBUI_DIR), **kwargs)\n199\t\n200\t    def log_message(self, format, *args):\n201\t        ts = datetime.now().strftime(\"%H:%M:%S\")\n202\t        sys.stdout.write(f\"[{ts}] {format % args}\\n\")\n203\t        sys.stdout.flush()\n204\t\n205\t    def _send_json(self, data, status=200):\n206\t        body = json.dumps(data, ensure_ascii=False, indent=2).encode(\"utf-8\")\n207\t        self.send_response(status)\n208\t        self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n209\t        self.send_header(\"Content-Length\", str(len(body)))\n210\t        self.end_headers()\n211\t        self.wfile.write(body)\n212\t\n213\t    def _read_body(self):\n214\t        length = int(self.headers.get(\"Content-Length\", 0))\n215\t        if length == 0:\n216\t            return {}\n217\t        raw = self.rfile.read(length)\n218\t        try:\n219\t            return json.loads(raw.decode(\"utf-8\"))\n220\t        except (json.JSONDecodeError, UnicodeDecodeError):\n221\t            return {}\n222\t\n223\t    def _cors_headers(self):\n224\t        self.send_header(\"Access-Control-Allow-Origin\", \"*\")\n225\t        self.send_header(\"Access-Control-Allow-Methods\", \"GET, POST, OPTIONS\")\n226\t        self.send_header(\"Access-Control-Allow-Headers\", \"Content-Type\")\n227\t\n228\t    # ---------- SSE helpers ----------\n229\t\n230\t    def _send_sse_event(self, data):\n231\t        payload = f\"data: {json.dumps(data, ensure_ascii=False)}\\n\\n\"\n232\t        self.wfile.write(payload.encode(\"utf-8\"))\n233\t        self.wfile.flush()\n234\t\n235\t    def _handle_sse_logs(self):\n236\t        params = parse_qs(urlparse(self.path).query)\n237\t        agent_id = params.get(\"agent\", [None])[0]\n238\t        if agent_id:\n239\t            agent_dir = _safe_agent_path(agent_id)\n240\t            if not agent_dir:\n241\t                return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n242\t            log_path = agent_dir / \"log\" / \"run.md\"\n243\t        else:\n244\t            log_path = MAIN_DIR / \"log\" / \"run.md\"\n245\t\n246\t        self.send_response(200)\n247\t        self.send_header(\"Content-Type\", \"text/event-stream\")\n248\t        self.send_header(\"Cache-Control\", \"no-cache\")\n249\t        self.send_header(\"Connection\", \"keep-alive\")\n250\t        self.send_header(\"X-Accel-Buffering\", \"no\")\n251\t        self._cors_headers()\n252\t        self.end_headers()\n253\t\n254\t        last_size = 0\n255\t        try:\n256\t            while True:\n257\t                if log_path.exists():\n258\t                    current_size = log_path.stat().st_size\n259\t                    if current_size != last_size:\n260\t                        lines = get_recent_lines(log_path, 500)\n261\t                        self._send_sse_event({\n262\t                            \"agent\": agent_id,\n263\t                            \"lines\": lines,\n264\t                            \"ts\": datetime.now().isoformat(),\n265\t                        })\n266\t                        last_size = current_size\n267\t                else:\n268\t                    if last_size != -1:\n269\t                        self._send_sse_event({\"agent\": agent_id, \"lines\": [], \"ts\": datetime.now().isoformat()})\n270\t                        last_size = -1\n271\t                time.sleep(1)\n272\t        except (BrokenPipeError, ConnectionResetError, OSError):\n273\t            pass\n274\t\n275\t    # ---------- GET routes ----------\n276\t\n277\t    def do_GET(self):\n278\t        parsed = urlparse(self.path)\n279\t        path = parsed.path\n280\t\n281\t        if path == \"/api/agents\":\n282\t            return self._send_json(scan_agents())\n283\t\n284\t        if path == \"/api/tasks\":\n285\t            return self._send_json(get_main_tasks())\n286\t\n287\t        if path == \"/api/logs\":\n288\t            params = parse_qs(parsed.query)\n289\t            n = int(params.get(\"n\", [\"100\"])[0])\n290\t            agent_id = params.get(\"agent\", [None])[0]\n291\t            if agent_id:\n292\t                agent_dir = _safe_agent_path(agent_id)\n293\t                if not agent_dir:\n294\t                    return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n295\t                log_path = agent_dir / \"log\" / \"run.md\"\n296\t            else:\n297\t                log_path = MAIN_DIR / \"log\" / \"run.md\"\n298\t            lines = get_recent_lines(log_path, n)\n299\t            return self._send_json({\"agent\": agent_id, \"lines\": lines})\n300\t\n301\t        if path == \"/api/logs/stream\":\n302\t            return self._handle_sse_logs()\n303\t\n304\t        if path == \"/api/loopcli/status\":\n305\t            return self._handle_loopcli_status()\n306\t\n307\t        # Static files\n308\t        super().do_GET()\n309\t\n310\t    # ---------- POST routes ----------\n311\t\n312\t    def do_POST(self):\n313\t        parsed = urlparse(self.path)\n314\t        path = parsed.path\n315\t\n316\t        if path == \"/api/tasks\":\n317\t            return self._handle_create_task()\n318\t        if path == \"/api/agents/start\":\n319\t            return self._handle_agent_start()\n320\t        if path == \"/api/loopcli/start\":\n321\t            return self._handle_loopcli_start()\n322\t        if path == \"/api/loopcli/stop\":\n323\t            return self._handle_loopcli_stop()\n324\t        if path == \"/api/loopcli/restart\":\n325\t            return self._handle_loopcli_restart()\n326\t        if path == \"/api/loopcli/dispatch\":\n327\t            return self._handle_loopcli_dispatch()\n328\t        if path == \"/api/messages/send\":\n329\t            return self._handle_message_send()\n330\t        if path == \"/api/agents/enable\":\n331\t            return self._handle_agent_enable(\"enable\")\n332\t        if path == \"/api/agents/disable\":\n333\t            return self._handle_agent_enable(\"disable\")\n334\t\n335\t        self._send_json({\"error\": \"Not found\"}, status=404)\n336\t\n337\t    # ---------- OPTIONS (CORS preflight) ----------\n338\t\n339\t    def do_OPTIONS(self):\n340\t        self.send_response(204)\n341\t        self._cors_headers()\n342\t        self.end_headers()\n343\t\n344\t    # ---------- Handlers ----------\n345\t\n346\t    def _handle_create_task(self):\n347\t        body = self._read_body()\n348\t        title = body.get(\"title\", \"\").strip()\n349\t        if not title:\n350\t            return self._send_json({\"error\": \"title is required\"}, status=400)\n351\t\n352\t        tasks = get_main_tasks()\n353\t        new_id = max((t.get(\"id\", 0) for t in tasks), default=0) + 1\n354\t        task = {\n355\t            \"id\": new_id,\n356\t            \"status\": \"pending\",\n357\t            \"title\": title,\n358\t            \"description\": body.get(\"description\", \"\"),\n359\t            \"created\": datetime.now(timezone.utc).strftime(\"%Y-%m-%d\"),\n360\t            \"assignee\": body.get(\"assignee\") or \"main\",\n361\t        }\n362\t        tasks.append(task)\n363\t        write_json(MAIN_DIR / \"memory\" / \"tasks.json\", tasks)\n364\t        self._send_json(task, status=201)\n365\t\n366\t    def _handle_agent_start(self):\n367\t        body = self._read_body()\n368\t        agent_id = body.get(\"agent\", \"\").strip()\n369\t        if not agent_id:\n370\t            return self._send_json({\"error\": \"agent is required\"}, status=400)\n371\t\n372\t        agent_dir = _safe_agent_path(agent_id)\n373\t        if not agent_dir:\n374\t            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n375\t\n376\t        prompt_file = agent_dir / \"PROMPT.md\"\n377\t        if not prompt_file.exists():\n378\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found or no PROMPT.md\"}, status=404)\n379\t\n380\t        prompt = prompt_file.read_text(encoding=\"utf-8\")\n381\t        proc = subprocess.Popen(\n382\t            [\"claude\", \"--print\"],\n383\t            stdin=subprocess.PIPE,\n384\t            stdout=subprocess.PIPE,\n385\t            stderr=subprocess.PIPE,\n386\t            cwd=str(agent_dir),\n387\t        )\n388\t        proc.stdin.write(prompt.encode(\"utf-8\"))\n389\t        proc.stdin.close()\n390\t\n391\t        self._send_json({\n392\t            \"agent\": agent_id,\n393\t            \"pid\": proc.pid,\n394\t            \"status\": \"started\",\n395\t        })\n396\t\n397\t    # --- Loop control handlers ---\n398\t\n399\t    def _handle_loopcli_status(self):\n400\t        state = get_loop_state()\n401\t        pid = state.get(\"pid\")\n402\t        if state.get(\"status\") == \"running\" and pid and not _is_pid_alive(pid):\n403\t            state[\"status\"] = \"stopped\"\n404\t            state[\"pid\"] = None\n405\t            state[\"ended_at\"] = datetime.now().isoformat()\n406\t            set_loop_state(state)\n407\t\n408\t        uptime = 0\n409\t        if state.get(\"started_at\"):\n410\t            try:\n411\t                started = datetime.fromisoformat(state[\"started_at\"])\n412\t                uptime = int((datetime.now() - started).total_seconds())\n413\t            except (ValueError, TypeError):\n414\t                pass\n415\t        state[\"uptime_seconds\"] = uptime\n416\t        self._send_json(state)\n417\t\n418\t    def _handle_loopcli_start(self):\n419\t        body = self._read_body()\n420\t        iterations = int(body.get(\"iterations\", 0))\n421\t        data, status = start_loopcli_process(iterations)\n422\t        self._send_json(data, status)\n423\t\n424\t    def _handle_loopcli_stop(self):\n425\t        data, status = stop_loopcli_process()\n426\t        self._send_json(data, status)\n427\t\n428\t    def _handle_loopcli_restart(self):\n429\t        body = self._read_body()\n430\t        stop_loopcli_process()\n431\t        time.sleep(0.5)\n432\t        iterations = int(body.get(\"iterations\", 0))\n433\t        data, status = start_loopcli_process(iterations)\n434\t        self._send_json(data, status)\n435\t\n436\t    def _handle_loopcli_dispatch(self):\n437\t        if API_KEY:\n438\t            key = self.headers.get(\"X-API-Key\", \"\") or parse_qs(urlparse(self.path).query).get(\"key\", [\"\"])[0]\n439\t            if key != API_KEY:\n440\t                return self._send_json({\"error\": \"Unauthorized\"}, status=401)\n441\t\n442\t        body = self._read_body()\n443\t        agent_id = body.get(\"agent\", \"\").strip()\n444\t        title = body.get(\"title\", \"\").strip()\n445\t        if not agent_id or not title:\n446\t            return self._send_json({\"error\": \"agent and title are required\"}, status=400)\n447\t\n448\t        agent_dir = _safe_agent_path(agent_id)\n449\t        if not agent_dir or not (agent_dir / \"AGENT\").exists():\n450\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n451\t\n452\t        # Write task to agent's tasks.json\n453\t        tasks_file = agent_dir / \"memory\" / \"tasks.json\"\n454\t        tasks = read_json(tasks_file, [])\n455\t        new_id = max((t.get(\"id\", 0) for t in tasks), default=0) + 1\n456\t        task = {\n457\t            \"id\": new_id,\n458\t            \"status\": \"pending\",\n459\t            \"title\": title,\n460\t            \"description\": body.get(\"description\", \"\"),\n461\t            \"created\": datetime.now(timezone.utc).strftime(\"%Y-%m-%d\"),\n462\t            \"assignee\": agent_id,\n463\t        }\n464\t        tasks.append(task)\n465\t        write_json(tasks_file, tasks)\n466\t\n467\t        # Start claude process for this agent\n468\t        prompt_file = agent_dir / \"PROMPT.md\"\n469\t        prompt = \"\"\n470\t        if prompt_file.exists():\n471\t            prompt = prompt_file.read_text(encoding=\"utf-8\")\n472\t\n473\t        proc = subprocess.Popen(\n474\t            [\"claude\", \"--print\", \"--dangerously-skip-permissions\"],\n475\t            stdin=subprocess.PIPE,\n476\t            stdout=subprocess.DEVNULL,\n477\t            stderr=subprocess.DEVNULL,\n478\t            cwd=str(agent_dir),\n479\t        )\n480\t        if prompt:\n481\t            proc.stdin.write(prompt.encode(\"utf-8\"))\n482\t            proc.stdin.close()\n483\t\n484\t        self._send_json({\n485\t            \"task\": task,\n486\t            \"pid\": proc.pid,\n487\t            \"status\": \"dispatched\",\n488\t        }, status=201)\n489\t\n490\t    def _handle_message_send(self):\n491\t        body = self._read_body()\n492\t        content = body.get(\"content\", \"\").strip()\n493\t        if not content:\n494\t            return self._send_json({\"error\": \"content is required\"}, status=400)\n495\t\n496\t        agent_id = body.get(\"agent\", \"main\").strip() or \"main\"\n497\t        agent_dir = _safe_agent_path(agent_id)\n498\t        if not agent_dir:\n499\t            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n500\t        if not (agent_dir / \"AGENT\").exists():\n501\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n502\t\n503\t        inbox_dir = agent_dir / \"inbox\"\n504\t        inbox_dir.mkdir(parents=True, exist_ok=True)\n505\t\n506\t        now = datetime.now()\n507\t        ts = now.strftime(\"%Y%m%d_%H%M\")\n508\t        msg_file = inbox_dir / f\"webui_{ts}.md\"\n509\t        msg_file.write_text(\n510\t            f\"# 来自 WebUI 的消息\\n- 类型：指令\\n- 时间：{now.strftime('%Y-%m-%d %H:%M')}\\n\\n## 内容\\n{content}\\n\",\n511\t            encoding=\"utf-8\",\n512\t        )\n513\t        self._send_json({\"status\": \"sent\", \"agent\": agent_id, \"file\": msg_file.name}, status=201)\n514\t\n515\t    def _handle_agent_enable(self, action):\n516\t        body = self._read_body()\n517\t        agent_id = body.get(\"agent\", \"\").strip()\n518\t        if not agent_id:\n519\t            return self._send_json({\"error\": \"agent is required\"}, status=400)\n520\t        if agent_id == \"main\":\n521\t            return self._send_json({\"error\": \"cannot disable main agent\"}, status=400)\n522\t\n523\t        agent_dir = _safe_agent_path(agent_id)\n524\t        if not agent_dir:\n525\t            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n526\t        marker = agent_dir / \"AGENT\"\n527\t        if not marker.exists():\n528\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n529\t\n530\t        if action == \"enable\":\n531\t            marker.write_text(\"type: main\\n\", encoding=\"utf-8\")\n532\t        else:\n533\t            marker.write_text(\"type: main\\ndisabled: true\\n\", encoding=\"utf-8\")\n534\t\n535\t        self._send_json({\"status\": \"ok\", \"agent\": agent_id, \"enabled\": action == \"enable\"})\n536\t\n537\t\n538\tclass ThreadedHTTPServer(ThreadingMixIn, HTTPServer):\n539\t    daemon_threads = True\n540\t\n541\t\n542\tdef main():\n543\t    host = \"0.0.0.0\"\n544\t    port = 8080\n545\t    server = ThreadedHTTPServer((host, port), WebUIHandler)\n546\t    print(f\"LoopCLI WebUI Server running on http://{host}:{port}\")\n547\t    print(f\"Static files served from: {WEBUI_DIR}\")\n548\t    print(f\"Agent root: {LOOPCLI_ROOT}\")\n549\t    print(\"Press Ctrl+C to stop.\")\n550\t    try:\n551\t        server.serve_forever()\n552\t    except KeyboardInterrupt:\n553\t        print(\"\\nShutting down.\")\n554\t        server.server_close()\n555\t\n556\t\n557\tif __name__ == \"__main__\":\n558\t    main()\n559\t"}]},"parent_tool_use_id":null,"session_id":"64fc0c72-a71c-4868-9271-7214a8421c02","uuid":"6140c434-4cf7-4c4c-b975-c9ab58df3c22","timestamp":"2026-05-20T23:57:03.902Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\loopcli\\main\\webui\\server.py","content":"\"\"\"\nLoopCLI WebUI Backend Server\nREST API + static file hosting for the Agent control console.\n\"\"\"\n\nimport json\nimport os\nimport signal\nimport subprocess\nimport sys\nimport time\nimport threading\nfrom datetime import datetime, timezone\nfrom http.server import HTTPServer, SimpleHTTPRequestHandler\nfrom socketserver import ThreadingMixIn\nfrom pathlib import Path\nfrom urllib.parse import urlparse, parse_qs\n\nLOOPCLI_ROOT = Path(r\"D:\\loopcli\")\nWEBUI_DIR = Path(__file__).parent.resolve()\nMAIN_DIR = LOOPCLI_ROOT / \"main\"\nLOOP_STATE_FILE = WEBUI_DIR / \"loop_state.json\"\n\n_loop_proc = None\n_loop_lock = threading.Lock()\nAPI_KEY = os.environ.get(\"LOOPCLI_API_KEY\", \"\")\n\n\ndef read_json(path: Path, default=None):\n    if not path.exists():\n        return default if default is not None else {}\n    try:\n        return json.loads(path.read_text(encoding=\"utf-8\"))\n    except (json.JSONDecodeError, OSError):\n        return default if default is not None else {}\n\n\ndef write_json(path: Path, data):\n    path.parent.mkdir(parents=True, exist_ok=True)\n    path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n\n\ndef _safe_agent_path(agent_id: str) -> Path | None:\n    if not agent_id or '/' in agent_id or '\\\\' in agent_id or '..' in agent_id:\n        return None\n    agent_dir = LOOPCLI_ROOT / agent_id\n    try:\n        agent_dir.resolve().relative_to(LOOPCLI_ROOT.resolve())\n    except ValueError:\n        return None\n    return agent_dir\n\n\ndef scan_agents():\n    \"\"\"Scan loopcli root for agent directories (containing AGENT marker file).\"\"\"\n    agents = []\n    for child in LOOPCLI_ROOT.iterdir():\n        if not child.is_dir():\n            continue\n        agent_marker = child / \"AGENT\"\n        if not agent_marker.exists():\n            continue\n        state = read_json(child / \"memory\" / \"state.json\", {})\n        soul_path = child / \"SOUL.md\"\n        desc = \"\"\n        if soul_path.exists():\n            lines = soul_path.read_text(encoding=\"utf-8\").strip().splitlines()\n            for line in lines:\n                stripped = line.strip()\n                if stripped and not stripped.startswith(\"#\"):\n                    desc = stripped\n                    break\n        agents.append({\n            \"id\": child.name,\n            \"name\": state.get(\"agent\", child.name),\n            \"status\": state.get(\"status\", \"unknown\"),\n            \"description\": desc,\n            \"last_run\": state.get(\"last_run\"),\n            \"run_count\": state.get(\"run_count\", 0),\n            \"current_task\": state.get(\"current_task\"),\n        })\n    return agents\n\n\ndef get_main_tasks():\n    return read_json(MAIN_DIR / \"memory\" / \"tasks.json\", [])\n\n\ndef get_recent_lines(filepath: Path, n=100):\n    if not filepath.exists():\n        return []\n    try:\n        with open(filepath, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n            lines = f.readlines()\n        return [l.rstrip(\"\\n\\r\") for l in lines[-n:]]\n    except OSError:\n        return []\n\n\n# --- Loop Process Management ---\n\ndef get_loop_state():\n    return read_json(LOOP_STATE_FILE, {\n        \"status\": \"stopped\", \"pid\": None,\n        \"started_at\": None, \"iterations\": 0, \"total_iterations\": 0,\n    })\n\n\ndef set_loop_state(state):\n    write_json(LOOP_STATE_FILE, state)\n\n\ndef _is_pid_alive(pid):\n    if not pid:\n        return False\n    try:\n        os.kill(pid, 0)\n        return True\n    except (ProcessLookupError, PermissionError, OSError):\n        return False\n\n\ndef _monitor_loopcli(proc):\n    proc.wait()\n    with _loop_lock:\n        state = get_loop_state()\n        if state.get(\"pid\") == proc.pid:\n            state[\"status\"] = \"stopped\"\n            state[\"pid\"] = None\n            state[\"ended_at\"] = datetime.now().isoformat()\n            set_loop_state(state)\n\n\ndef start_loopcli_process(iterations=0):\n    global _loop_proc\n    with _loop_lock:\n        state = get_loop_state()\n        if state.get(\"status\") == \"running\" and _is_pid_alive(state.get(\"pid\")):\n            return {\"error\": \"Already running\"}, 409\n\n        cmd = [sys.executable, str(LOOPCLI_ROOT / \"run.py\"), \"run\"]\n        if iterations > 0:\n            cmd.extend([\"-n\", str(iterations)])\n\n        proc = subprocess.Popen(\n            cmd,\n            stdout=subprocess.DEVNULL,\n            stderr=subprocess.DEVNULL,\n            creationflags=getattr(subprocess, \"CREATE_NO_WINDOW\", 0),\n        )\n        _loop_proc = proc\n\n        state = {\n            \"status\": \"running\",\n            \"pid\": proc.pid,\n            \"started_at\": datetime.now().isoformat(),\n            \"iterations\": iterations,\n            \"total_iterations\": 0,\n        }\n        set_loop_state(state)\n\n        t = threading.Thread(target=_monitor_loopcli, args=(proc,), daemon=True)\n        t.start()\n        return state, 200\n\n\ndef stop_loopcli_process():\n    global _loop_proc\n    with _loop_lock:\n        state = get_loop_state()\n        pid = state.get(\"pid\")\n        if not pid or not _is_pid_alive(pid):\n            state[\"status\"] = \"stopped\"\n            state[\"pid\"] = None\n            set_loop_state(state)\n            return {\"error\": \"Not running\"}, 409\n\n        try:\n            os.kill(pid, signal.SIGTERM)\n        except OSError:\n            pass\n        if _loop_proc and _loop_proc.pid == pid:\n            try:\n                _loop_proc.terminate()\n            except OSError:\n                pass\n            _loop_proc = None\n\n        state[\"status\"] = \"stopped\"\n        state[\"pid\"] = None\n        state[\"ended_at\"] = datetime.now().isoformat()\n        set_loop_state(state)\n        return {\"status\": \"stopped\"}, 200\n\n\nclass WebUIHandler(SimpleHTTPRequestHandler):\n    def __init__(self, *args, **kwargs):\n        super().__init__(*args, directory=str(WEBUI_DIR), **kwargs)\n\n    def log_message(self, format, *args):\n        ts = datetime.now().strftime(\"%H:%M:%S\")\n        sys.stdout.write(f\"[{ts}] {format % args}\\n\")\n        sys.stdout.flush()\n\n    def _send_json(self, data, status=200):\n        body = json.dumps(data, ensure_ascii=False, indent=2).encode(\"utf-8\")\n        self.send_response(status)\n        self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def _read_body(self):\n        length = int(self.headers.get(\"Content-Length\", 0))\n        if length == 0:\n            return {}\n        raw = self.rfile.read(length)\n        try:\n            return json.loads(raw.decode(\"utf-8\"))\n        except (json.JSONDecodeError, UnicodeDecodeError):\n            return {}\n\n    def _cors_headers(self):\n        self.send_header(\"Access-Control-Allow-Origin\", \"*\")\n        self.send_header(\"Access-Control-Allow-Methods\", \"GET, POST, OPTIONS\")\n        self.send_header(\"Access-Control-Allow-Headers\", \"Content-Type\")\n\n    # ---------- SSE helpers ----------\n\n    def _send_sse_event(self, data):\n        payload = f\"data: {json.dumps(data, ensure_ascii=False)}\\n\\n\"\n        self.wfile.write(payload.encode(\"utf-8\"))\n        self.wfile.flush()\n\n    def _handle_sse_logs(self):\n        params = parse_qs(urlparse(self.path).query)\n        agent_id = params.get(\"agent\", [None])[0]\n        if agent_id:\n            agent_dir = _safe_agent_path(agent_id)\n            if not agent_dir:\n                return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n            log_path = agent_dir / \"log\" / \"run.md\"\n        else:\n            log_path = MAIN_DIR / \"log\" / \"run.md\"\n\n        self.send_response(200)\n        self.send_header(\"Content-Type\", \"text/event-stream\")\n        self.send_header(\"Cache-Control\", \"no-cache\")\n        self.send_header(\"Connection\", \"keep-alive\")\n        self.send_header(\"X-Accel-Buffering\", \"no\")\n        self._cors_headers()\n        self.end_headers()\n\n        last_size = 0\n        try:\n            while True:\n                if log_path.exists():\n                    current_size = log_path.stat().st_size\n                    if current_size != last_size:\n                        lines = get_recent_lines(log_path, 500)\n                        self._send_sse_event({\n                            \"agent\": agent_id,\n                            \"lines\": lines,\n                            \"ts\": datetime.now().isoformat(),\n                        })\n                        last_size = current_size\n                else:\n                    if last_size != -1:\n                        self._send_sse_event({\"agent\": agent_id, \"lines\": [], \"ts\": datetime.now().isoformat()})\n                        last_size = -1\n                time.sleep(1)\n        except (BrokenPipeError, ConnectionResetError, OSError):\n            pass\n\n    # ---------- GET routes ----------\n\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        path = parsed.path\n\n        if path == \"/api/agents\":\n            return self._send_json(scan_agents())\n\n        if path == \"/api/tasks\":\n            return self._send_json(get_main_tasks())\n\n        if path == \"/api/logs\":\n            params = parse_qs(parsed.query)\n            n = int(params.get(\"n\", [\"100\"])[0])\n            agent_id = params.get(\"agent\", [None])[0]\n            if agent_id:\n                agent_dir = _safe_agent_path(agent_id)\n                if not agent_dir:\n                    return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n                log_path = agent_dir / \"log\" / \"run.md\"\n            else:\n                log_path = MAIN_DIR / \"log\" / \"run.md\"\n            lines = get_recent_lines(log_path, n)\n            return self._send_json({\"agent\": agent_id, \"lines\": lines})\n\n        if path == \"/api/logs/stream\":\n            return self._handle_sse_logs()\n\n        if path == \"/api/loopcli/status\":\n            return self._handle_loopcli_status()\n\n        # Static files\n        super().do_GET()\n\n    # ---------- POST routes ----------\n\n    def do_POST(self):\n        parsed = urlparse(self.path)\n        path = parsed.path\n\n        if path == \"/api/tasks\":\n            return self._handle_create_task()\n        if path == \"/api/agents/start\":\n            return self._handle_agent_start()\n        if path == \"/api/loopcli/start\":\n            return self._handle_loopcli_start()\n        if path == \"/api/loopcli/stop\":\n            return self._handle_loopcli_stop()\n        if path == \"/api/loopcli/restart\":\n            return self._handle_loopcli_restart()\n        if path == \"/api/loopcli/dispatch\":\n            return self._handle_loopcli_dispatch()\n        if path == \"/api/messages/send\":\n            return self._handle_message_send()\n        if path == \"/api/agents/enable\":\n            return self._handle_agent_enable(\"enable\")\n        if path == \"/api/agents/disable\":\n            return self._handle_agent_enable(\"disable\")\n\n        self._send_json({\"error\": \"Not found\"}, status=404)\n\n    # ---------- OPTIONS (CORS preflight) ----------\n\n    def do_OPTIONS(self):\n        self.send_response(204)\n        self._cors_headers()\n        self.end_headers()\n\n    # ---------- Handlers ----------\n\n    def _handle_create_task(self):\n        body = self._read_body()\n        title = body.get(\"title\", \"\").strip()\n        if not title:\n            return self._send_json({\"error\": \"title is required\"}, status=400)\n\n        tasks = get_main_tasks()\n        new_id = max((t.get(\"id\", 0) for t in tasks), default=0) + 1\n        task = {\n            \"id\": new_id,\n            \"status\": \"pending\",\n            \"title\": title,\n            \"description\": body.get(\"description\", \"\"),\n            \"created\": datetime.now(timezone.utc).strftime(\"%Y-%m-%d\"),\n            \"assignee\": body.get(\"assignee\") or \"main\",\n        }\n        tasks.append(task)\n        write_json(MAIN_DIR / \"memory\" / \"tasks.json\", tasks)\n        self._send_json(task, status=201)\n\n    def _handle_agent_start(self):\n        body = self._read_body()\n        agent_id = body.get(\"agent\", \"\").strip()\n        if not agent_id:\n            return self._send_json({\"error\": \"agent is required\"}, status=400)\n\n        agent_dir = _safe_agent_path(agent_id)\n        if not agent_dir:\n            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n\n        prompt_file = agent_dir / \"PROMPT.md\"\n        if not prompt_file.exists():\n            return self._send_json({\"error\": f\"Agent '{agent_id}' not found or no PROMPT.md\"}, status=404)\n\n        prompt = prompt_file.read_text(encoding=\"utf-8\")\n        proc = subprocess.Popen(\n            [\"claude\", \"--print\"],\n            stdin=subprocess.PIPE,\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            cwd=str(agent_dir),\n        )\n        proc.stdin.write(prompt.encode(\"utf-8\"))\n        proc.stdin.close()\n\n        self._send_json({\n            \"agent\": agent_id,\n            \"pid\": proc.pid,\n            \"status\": \"started\",\n        })\n\n    # --- Loop control handlers ---\n\n    def _handle_loopcli_status(self):\n        state = get_loop_state()\n        pid = state.get(\"pid\")\n        if state.get(\"status\") == \"running\" and pid and not _is_pid_alive(pid):\n            state[\"status\"] = \"stopped\"\n            state[\"pid\"] = None\n            state[\"ended_at\"] = datetime.now().isoformat()\n            set_loop_state(state)\n\n        uptime = 0\n        if state.get(\"started_at\"):\n            try:\n                started = datetime.fromisoformat(state[\"started_at\"])\n                uptime = int((datetime.now() - started).total_seconds())\n            except (ValueError, TypeError):\n                pass\n        state[\"uptime_seconds\"] = uptime\n        self._send_json(state)\n\n    def _handle_loopcli_start(self):\n        body = self._read_body()\n        iterations = int(body.get(\"iterations\", 0))\n        data, status = start_loopcli_process(iterations)\n        self._send_json(data, status)\n\n    def _handle_loopcli_stop(self):\n        data, status = stop_loopcli_process()\n        self._send_json(data, status)\n\n    def _handle_loopcli_restart(self):\n        body = self._read_body()\n        stop_loopcli_process()\n        time.sleep(0.5)\n        iterations = int(body.get(\"iterations\", 0))\n        data, status = start_loopcli_process(iterations)\n        self._send_json(data, status)\n\n    def _handle_loopcli_dispatch(self):\n        if API_KEY:\n            key = self.headers.get(\"X-API-Key\", \"\") or parse_qs(urlparse(self.path).query).get(\"key\", [\"\"])[0]\n            if key != API_KEY:\n                return self._send_json({\"error\": \"Unauthorized\"}, status=401)\n\n        body = self._read_body()\n        agent_id = body.get(\"agent\", \"\").strip()\n        title = body.get(\"title\", \"\").strip()\n        if not agent_id or not title:\n            return self._send_json({\"error\": \"agent and title are required\"}, status=400)\n\n        agent_dir = _safe_agent_path(agent_id)\n        if not agent_dir or not (agent_dir / \"AGENT\").exists():\n            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n\n        # Write task to agent's tasks.json\n        tasks_file = agent_dir / \"memory\" / \"tasks.json\"\n        tasks = read_json(tasks_file, [])\n        new_id = max((t.get(\"id\", 0) for t in tasks), default=0) + 1\n        task = {\n            \"id\": new_id,\n            \"status\": \"pending\",\n            \"title\": title,\n            \"description\": body.get(\"description\", \"\"),\n            \"created\": datetime.now(timezone.utc).strftime(\"%Y-%m-%d\"),\n            \"assignee\": agent_id,\n        }\n        tasks.append(task)\n        write_json(tasks_file, tasks)\n\n        # Start claude process for this agent\n        prompt_file = agent_dir / \"PROMPT.md\"\n        prompt = \"\"\n        if prompt_file.exists():\n            prompt = prompt_file.read_text(encoding=\"utf-8\")\n\n        proc = subprocess.Popen(\n            [\"claude\", \"--print\", \"--dangerously-skip-permissions\"],\n            stdin=subprocess.PIPE,\n            stdout=subprocess.DEVNULL,\n            stderr=subprocess.DEVNULL,\n            cwd=str(agent_dir),\n        )\n        if prompt:\n            proc.stdin.write(prompt.encode(\"utf-8\"))\n            proc.stdin.close()\n\n        self._send_json({\n            \"task\": task,\n            \"pid\": proc.pid,\n            \"status\": \"dispatched\",\n        }, status=201)\n\n    def _handle_message_send(self):\n        body = self._read_body()\n        content = body.get(\"content\", \"\").strip()\n        if not content:\n            return self._send_json({\"error\": \"content is required\"}, status=400)\n\n        agent_id = body.get(\"agent\", \"main\").strip() or \"main\"\n        agent_dir = _safe_agent_path(agent_id)\n        if not agent_dir:\n            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n        if not (agent_dir / \"AGENT\").exists():\n            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n\n        inbox_dir = agent_dir / \"inbox\"\n        inbox_dir.mkdir(parents=True, exist_ok=True)\n\n        now = datetime.now()\n        ts = now.strftime(\"%Y%m%d_%H%M\")\n        msg_file = inbox_dir / f\"webui_{ts}.md\"\n        msg_file.write_text(\n            f\"# 来自 WebUI 的消息\\n- 类型：指令\\n- 时间：{now.strftime('%Y-%m-%d %H:%M')}\\n\\n## 内容\\n{content}\\n\",\n            encoding=\"utf-8\",\n        )\n        self._send_json({\"status\": \"sent\", \"agent\": agent_id, \"file\": msg_file.name}, status=201)\n\n    def _handle_agent_enable(self, action):\n        body = self._read_body()\n        agent_id = body.get(\"agent\", \"\").strip()\n        if not agent_id:\n            return self._send_json({\"error\": \"agent is required\"}, status=400)\n        if agent_id == \"main\":\n            return self._send_json({\"error\": \"cannot disable main agent\"}, status=400)\n\n        agent_dir = _safe_agent_path(agent_id)\n        if not agent_dir:\n            return self._send_json({\"error\": \"Invalid agent\"}, status=400)\n        marker = agent_dir / \"AGENT\"\n        if not marker.exists():\n            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n\n        if action == \"enable\":\n            marker.write_text(\"type: main\\n\", encoding=\"utf-8\")\n        else:\n            marker.write_text(\"type: main\\ndisabled: true\\n\", encoding=\"utf-8\")\n\n        self._send_json({\"status\": \"ok\", \"agent\": agent_id, \"enabled\": action == \"enable\"})\n\n\nclass ThreadedHTTPServer(ThreadingMixIn, HTTPServer):\n    daemon_threads = True\n\n\ndef main():\n    host = \"0.0.0.0\"\n    port = 8080\n    server = ThreadedHTTPServer((host, port), WebUIHandler)\n    print(f\"LoopCLI WebUI Server running on http://{host}:{port}\")\n    print(f\"Static files served from: {WEBUI_DIR}\")\n    print(f\"Agent root: {LOOPCLI_ROOT}\")\n    print(\"Press Ctrl+C to stop.\")\n    try:\n        server.serve_forever()\n    except KeyboardInterrupt:\n        print(\"\\nShutting down.\")\n        server.server_close()\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":559,"startLine":1,"totalLines":559}}}
