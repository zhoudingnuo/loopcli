{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_74d5eff1432c4d43ab1e0468","type":"tool_result","content":"1\t\"\"\"\n2\tLoopCLI WebUI Backend Server\n3\tREST API + static file hosting for the Agent control console.\n4\t\"\"\"\n5\t\n6\timport json\n7\timport os\n8\timport signal\n9\timport subprocess\n10\timport sys\n11\timport time\n12\timport threading\n13\tfrom datetime import datetime, timezone\n14\tfrom http.server import HTTPServer, SimpleHTTPRequestHandler\n15\tfrom socketserver import ThreadingMixIn\n16\tfrom pathlib import Path\n17\tfrom urllib.parse import urlparse, parse_qs\n18\t\n19\tLOOPCLI_ROOT = Path(r\"D:\\loopcli\")\n20\tWEBUI_DIR = Path(__file__).parent.resolve()\n21\tMAIN_DIR = LOOPCLI_ROOT / \"main\"\n22\tLOOP_STATE_FILE = WEBUI_DIR / \"loop_state.json\"\n23\t\n24\t_loop_proc = None\n25\t_loop_lock = threading.Lock()\n26\t\n27\t\n28\tdef read_json(path: Path, default=None):\n29\t    if not path.exists():\n30\t        return default if default is not None else {}\n31\t    try:\n32\t        return json.loads(path.read_text(encoding=\"utf-8\"))\n33\t    except (json.JSONDecodeError, OSError):\n34\t        return default if default is not None else {}\n35\t\n36\t\n37\tdef write_json(path: Path, data):\n38\t    path.parent.mkdir(parents=True, exist_ok=True)\n39\t    path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n40\t\n41\t\n42\tdef scan_agents():\n43\t    \"\"\"Scan loopcli root for agent directories (containing AGENT marker file).\"\"\"\n44\t    agents = []\n45\t    for child in LOOPCLI_ROOT.iterdir():\n46\t        if not child.is_dir():\n47\t            continue\n48\t        agent_marker = child / \"AGENT\"\n49\t        if not agent_marker.exists():\n50\t            continue\n51\t        state = read_json(child / \"memory\" / \"state.json\", {})\n52\t        soul_path = child / \"SOUL.md\"\n53\t        desc = \"\"\n54\t        if soul_path.exists():\n55\t            lines = soul_path.read_text(encoding=\"utf-8\").strip().splitlines()\n56\t            for line in lines:\n57\t                stripped = line.strip()\n58\t                if stripped and not stripped.startswith(\"#\"):\n59\t                    desc = stripped\n60\t                    break\n61\t        agents.append({\n62\t            \"id\": child.name,\n63\t            \"name\": state.get(\"agent\", child.name),\n64\t            \"status\": state.get(\"status\", \"unknown\"),\n65\t            \"description\": desc,\n66\t            \"last_run\": state.get(\"last_run\"),\n67\t            \"run_count\": state.get(\"run_count\", 0),\n68\t            \"current_task\": state.get(\"current_task\"),\n69\t        })\n70\t    return agents\n71\t\n72\t\n73\tdef get_main_tasks():\n74\t    return read_json(MAIN_DIR / \"memory\" / \"tasks.json\", [])\n75\t\n76\t\n77\tdef get_recent_lines(filepath: Path, n=100):\n78\t    if not filepath.exists():\n79\t        return []\n80\t    try:\n81\t        with open(filepath, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n82\t            lines = f.readlines()\n83\t        return [l.rstrip(\"\\n\\r\") for l in lines[-n:]]\n84\t    except OSError:\n85\t        return []\n86\t\n87\t\n88\t# --- Loop Process Management ---\n89\t\n90\tdef get_loop_state():\n91\t    return read_json(LOOP_STATE_FILE, {\n92\t        \"status\": \"stopped\", \"pid\": None,\n93\t        \"started_at\": None, \"iterations\": 0, \"total_iterations\": 0,\n94\t    })\n95\t\n96\t\n97\tdef set_loop_state(state):\n98\t    write_json(LOOP_STATE_FILE, state)\n99\t\n100\t\n101\tdef _is_pid_alive(pid):\n102\t    if not pid:\n103\t        return False\n104\t    try:\n105\t        os.kill(pid, 0)\n106\t        return True\n107\t    except (ProcessLookupError, PermissionError, OSError):\n108\t        return False\n109\t\n110\t\n111\tdef _monitor_loopcli(proc):\n112\t    proc.wait()\n113\t    with _loop_lock:\n114\t        state = get_loop_state()\n115\t        if state.get(\"pid\") == proc.pid:\n116\t            state[\"status\"] = \"stopped\"\n117\t            state[\"pid\"] = None\n118\t            state[\"ended_at\"] = datetime.now().isoformat()\n119\t            set_loop_state(state)\n120\t\n121\t\n122\tdef start_loopcli_process(iterations=0):\n123\t    global _loop_proc\n124\t    with _loop_lock:\n125\t        state = get_loop_state()\n126\t        if state.get(\"status\") == \"running\" and _is_pid_alive(state.get(\"pid\")):\n127\t            return {\"error\": \"Already running\"}, 409\n128\t\n129\t        cmd = [sys.executable, str(LOOPCLI_ROOT / \"run.py\"), \"run\"]\n130\t        if iterations > 0:\n131\t            cmd.extend([\"-n\", str(iterations)])\n132\t\n133\t        proc = subprocess.Popen(\n134\t            cmd,\n135\t            stdout=subprocess.DEVNULL,\n136\t            stderr=subprocess.DEVNULL,\n137\t            creationflags=getattr(subprocess, \"CREATE_NO_WINDOW\", 0),\n138\t        )\n139\t        _loop_proc = proc\n140\t\n141\t        state = {\n142\t            \"status\": \"running\",\n143\t            \"pid\": proc.pid,\n144\t            \"started_at\": datetime.now().isoformat(),\n145\t            \"iterations\": iterations,\n146\t            \"total_iterations\": 0,\n147\t        }\n148\t        set_loop_state(state)\n149\t\n150\t        t = threading.Thread(target=_monitor_loopcli, args=(proc,), daemon=True)\n151\t        t.start()\n152\t        return state, 200\n153\t\n154\t\n155\tdef stop_loopcli_process():\n156\t    global _loop_proc\n157\t    with _loop_lock:\n158\t        state = get_loop_state()\n159\t        pid = state.get(\"pid\")\n160\t        if not pid or not _is_pid_alive(pid):\n161\t            state[\"status\"] = \"stopped\"\n162\t            state[\"pid\"] = None\n163\t            set_loop_state(state)\n164\t            return {\"error\": \"Not running\"}, 409\n165\t\n166\t        try:\n167\t            os.kill(pid, signal.SIGTERM)\n168\t        except OSError:\n169\t            pass\n170\t        if _loop_proc and _loop_proc.pid == pid:\n171\t            try:\n172\t                _loop_proc.terminate()\n173\t            except OSError:\n174\t                pass\n175\t            _loop_proc = None\n176\t\n177\t        state[\"status\"] = \"stopped\"\n178\t        state[\"pid\"] = None\n179\t        state[\"ended_at\"] = datetime.now().isoformat()\n180\t        set_loop_state(state)\n181\t        return {\"status\": \"stopped\"}, 200\n182\t\n183\t\n184\tclass WebUIHandler(SimpleHTTPRequestHandler):\n185\t    def __init__(self, *args, **kwargs):\n186\t        super().__init__(*args, directory=str(WEBUI_DIR), **kwargs)\n187\t\n188\t    def log_message(self, format, *args):\n189\t        ts = datetime.now().strftime(\"%H:%M:%S\")\n190\t        sys.stdout.write(f\"[{ts}] {format % args}\\n\")\n191\t        sys.stdout.flush()\n192\t\n193\t    def _send_json(self, data, status=200):\n194\t        body = json.dumps(data, ensure_ascii=False, indent=2).encode(\"utf-8\")\n195\t        self.send_response(status)\n196\t        self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n197\t        self.send_header(\"Content-Length\", str(len(body)))\n198\t        self.end_headers()\n199\t        self.wfile.write(body)\n200\t\n201\t    def _read_body(self):\n202\t        length = int(self.headers.get(\"Content-Length\", 0))\n203\t        if length == 0:\n204\t            return {}\n205\t        raw = self.rfile.read(length)\n206\t        try:\n207\t            return json.loads(raw.decode(\"utf-8\"))\n208\t        except (json.JSONDecodeError, UnicodeDecodeError):\n209\t            return {}\n210\t\n211\t    def _cors_headers(self):\n212\t        self.send_header(\"Access-Control-Allow-Origin\", \"*\")\n213\t        self.send_header(\"Access-Control-Allow-Methods\", \"GET, POST, OPTIONS\")\n214\t        self.send_header(\"Access-Control-Allow-Headers\", \"Content-Type\")\n215\t\n216\t    # ---------- SSE helpers ----------\n217\t\n218\t    def _send_sse_event(self, data):\n219\t        payload = f\"data: {json.dumps(data, ensure_ascii=False)}\\n\\n\"\n220\t        self.wfile.write(payload.encode(\"utf-8\"))\n221\t        self.wfile.flush()\n222\t\n223\t    def _handle_sse_logs(self):\n224\t        params = parse_qs(urlparse(self.path).query)\n225\t        agent_id = params.get(\"agent\", [None])[0]\n226\t        if agent_id:\n227\t            log_path = LOOPCLI_ROOT / agent_id / \"log\" / \"run.md\"\n228\t        else:\n229\t            log_path = MAIN_DIR / \"log\" / \"run.md\"\n230\t\n231\t        self.send_response(200)\n232\t        self.send_header(\"Content-Type\", \"text/event-stream\")\n233\t        self.send_header(\"Cache-Control\", \"no-cache\")\n234\t        self.send_header(\"Connection\", \"keep-alive\")\n235\t        self.send_header(\"X-Accel-Buffering\", \"no\")\n236\t        self._cors_headers()\n237\t        self.end_headers()\n238\t\n239\t        last_size = 0\n240\t        try:\n241\t            while True:\n242\t                if log_path.exists():\n243\t                    current_size = log_path.stat().st_size\n244\t                    if current_size != last_size:\n245\t                        lines = get_recent_lines(log_path, 500)\n246\t                        self._send_sse_event({\n247\t                            \"agent\": agent_id,\n248\t                            \"lines\": lines,\n249\t                            \"ts\": datetime.now().isoformat(),\n250\t                        })\n251\t                        last_size = current_size\n252\t                else:\n253\t                    if last_size != -1:\n254\t                        self._send_sse_event({\"agent\": agent_id, \"lines\": [], \"ts\": datetime.now().isoformat()})\n255\t                        last_size = -1\n256\t                time.sleep(1)\n257\t        except (BrokenPipeError, ConnectionResetError, OSError):\n258\t            pass\n259\t\n260\t    # ---------- GET routes ----------\n261\t\n262\t    def do_GET(self):\n263\t        parsed = urlparse(self.path)\n264\t        path = parsed.path\n265\t\n266\t        if path == \"/api/agents\":\n267\t            return self._send_json(scan_agents())\n268\t\n269\t        if path == \"/api/tasks\":\n270\t            return self._send_json(get_main_tasks())\n271\t\n272\t        if path == \"/api/logs\":\n273\t            params = parse_qs(parsed.query)\n274\t            n = int(params.get(\"n\", [\"100\"])[0])\n275\t            agent_id = params.get(\"agent\", [None])[0]\n276\t            if agent_id:\n277\t                log_path = LOOPCLI_ROOT / agent_id / \"log\" / \"run.md\"\n278\t            else:\n279\t                log_path = MAIN_DIR / \"log\" / \"run.md\"\n280\t            lines = get_recent_lines(log_path, n)\n281\t            return self._send_json({\"agent\": agent_id, \"lines\": lines})\n282\t\n283\t        if path == \"/api/logs/stream\":\n284\t            return self._handle_sse_logs()\n285\t\n286\t        if path == \"/api/loopcli/status\":\n287\t            return self._handle_loopcli_status()\n288\t\n289\t        # Static files\n290\t        super().do_GET()\n291\t\n292\t    # ---------- POST routes ----------\n293\t\n294\t    def do_POST(self):\n295\t        parsed = urlparse(self.path)\n296\t        path = parsed.path\n297\t\n298\t        if path == \"/api/tasks\":\n299\t            return self._handle_create_task()\n300\t        if path == \"/api/agents/start\":\n301\t            return self._handle_agent_start()\n302\t        if path == \"/api/loopcli/start\":\n303\t            return self._handle_loopcli_start()\n304\t        if path == \"/api/loopcli/stop\":\n305\t            return self._handle_loopcli_stop()\n306\t        if path == \"/api/loopcli/restart\":\n307\t            return self._handle_loopcli_restart()\n308\t        if path == \"/api/loopcli/dispatch\":\n309\t            return self._handle_loopcli_dispatch()\n310\t\n311\t        self._send_json({\"error\": \"Not found\"}, status=404)\n312\t\n313\t    # ---------- OPTIONS (CORS preflight) ----------\n314\t\n315\t    def do_OPTIONS(self):\n316\t        self.send_response(204)\n317\t        self._cors_headers()\n318\t        self.end_headers()\n319\t\n320\t    # ---------- Handlers ----------\n321\t\n322\t    def _handle_create_task(self):\n323\t        body = self._read_body()\n324\t        title = body.get(\"title\", \"\").strip()\n325\t        if not title:\n326\t            return self._send_json({\"error\": \"title is required\"}, status=400)\n327\t\n328\t        tasks = get_main_tasks()\n329\t        new_id = max((t.get(\"id\", 0) for t in tasks), default=0) + 1\n330\t        task = {\n331\t            \"id\": new_id,\n332\t            \"status\": \"pending\",\n333\t            \"title\": title,\n334\t            \"description\": body.get(\"description\", \"\"),\n335\t            \"created\": datetime.now(timezone.utc).strftime(\"%Y-%m-%d\"),\n336\t            \"assignee\": body.get(\"assignee\") or \"main\",\n337\t        }\n338\t        tasks.append(task)\n339\t        write_json(MAIN_DIR / \"memory\" / \"tasks.json\", tasks)\n340\t        self._send_json(task, status=201)\n341\t\n342\t    def _handle_agent_start(self):\n343\t        body = self._read_body()\n344\t        agent_id = body.get(\"agent\", \"\").strip()\n345\t        if not agent_id:\n346\t            return self._send_json({\"error\": \"agent is required\"}, status=400)\n347\t\n348\t        agent_dir = LOOPCLI_ROOT / agent_id\n349\t        prompt_file = agent_dir / \"PROMPT.md\"\n350\t        if not prompt_file.exists():\n351\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found or no PROMPT.md\"}, status=404)\n352\t\n353\t        # Launch claude in the agent directory, reading PROMPT.md\n354\t        try:\n355\t            proc = subprocess.Popen(\n356\t                [\"claude\", \"--print\", \"$(cat PROMPT.md)\"],\n357\t                cwd=str(agent_dir),\n358\t                shell=True,\n359\t                stdout=subprocess.PIPE,\n360\t                stderr=subprocess.PIPE,\n361\t            )\n362\t        except FileNotFoundError:\n363\t            proc = subprocess.Popen(\n364\t                [\"claude\", \"--print\", prompt_file.read_text(encoding=\"utf-8\")],\n365\t                cwd=str(agent_dir),\n366\t                stdout=subprocess.PIPE,\n367\t                stderr=subprocess.PIPE,\n368\t            )\n369\t\n370\t        self._send_json({\n371\t            \"agent\": agent_id,\n372\t            \"pid\": proc.pid,\n373\t            \"status\": \"started\",\n374\t        })\n375\t\n376\t    # --- Loop control handlers ---\n377\t\n378\t    def _handle_loopcli_status(self):\n379\t        state = get_loop_state()\n380\t        pid = state.get(\"pid\")\n381\t        if state.get(\"status\") == \"running\" and pid and not _is_pid_alive(pid):\n382\t            state[\"status\"] = \"stopped\"\n383\t            state[\"pid\"] = None\n384\t            state[\"ended_at\"] = datetime.now().isoformat()\n385\t            set_loop_state(state)\n386\t\n387\t        uptime = 0\n388\t        if state.get(\"started_at\"):\n389\t            try:\n390\t                started = datetime.fromisoformat(state[\"started_at\"])\n391\t                uptime = int((datetime.now() - started).total_seconds())\n392\t            except (ValueError, TypeError):\n393\t                pass\n394\t        state[\"uptime_seconds\"] = uptime\n395\t        self._send_json(state)\n396\t\n397\t    def _handle_loopcli_start(self):\n398\t        body = self._read_body()\n399\t        iterations = int(body.get(\"iterations\", 0))\n400\t        data, status = start_loopcli_process(iterations)\n401\t        self._send_json(data, status)\n402\t\n403\t    def _handle_loopcli_stop(self):\n404\t        data, status = stop_loopcli_process()\n405\t        self._send_json(data, status)\n406\t\n407\t    def _handle_loopcli_restart(self):\n408\t        stop_loopcli_process()\n409\t        time.sleep(0.5)\n410\t        body = self._read_body()\n411\t        iterations = int(body.get(\"iterations\", 0))\n412\t        data, status = start_loopcli_process(iterations)\n413\t        self._send_json(data, status)\n414\t\n415\t    def _handle_loopcli_dispatch(self):\n416\t        body = self._read_body()\n417\t        agent_id = body.get(\"agent\", \"\").strip()\n418\t        title = body.get(\"title\", \"\").strip()\n419\t        if not agent_id or not title:\n420\t            return self._send_json({\"error\": \"agent and title are required\"}, status=400)\n421\t\n422\t        agent_dir = LOOPCLI_ROOT / agent_id\n423\t        if not (agent_dir / \"AGENT\").exists():\n424\t            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n425\t\n426\t        # Write task to agent's tasks.json\n427\t        tasks_file = agent_dir / \"memory\" / \"tasks.json\"\n428\t        tasks = read_json(tasks_file, [])\n429\t        new_id = max((t.get(\"id\", 0) for t in tasks), default=0) + 1\n430\t        task = {\n431\t            \"id\": new_id,\n432\t            \"status\": \"pending\",\n433\t            \"title\": title,\n434\t            \"description\": body.get(\"description\", \"\"),\n435\t            \"created\": datetime.now(timezone.utc).strftime(\"%Y-%m-%d\"),\n436\t            \"assignee\": agent_id,\n437\t        }\n438\t        tasks.append(task)\n439\t        write_json(tasks_file, tasks)\n440\t\n441\t        # Start claude process for this agent\n442\t        prompt_file = agent_dir / \"PROMPT.md\"\n443\t        prompt = \"\"\n444\t        if prompt_file.exists():\n445\t            prompt = prompt_file.read_text(encoding=\"utf-8\")\n446\t\n447\t        proc = subprocess.Popen(\n448\t            [\"claude\", \"--print\", \"--dangerously-skip-permissions\"],\n449\t            stdin=subprocess.PIPE,\n450\t            stdout=subprocess.DEVNULL,\n451\t            stderr=subprocess.DEVNULL,\n452\t            cwd=str(agent_dir),\n453\t        )\n454\t        if prompt:\n455\t            proc.stdin.write(prompt.encode(\"utf-8\"))\n456\t            proc.stdin.close()\n457\t\n458\t        self._send_json({\n459\t            \"task\": task,\n460\t            \"pid\": proc.pid,\n461\t            \"status\": \"dispatched\",\n462\t        }, status=201)\n463\t\n464\t\n465\tclass ThreadedHTTPServer(ThreadingMixIn, HTTPServer):\n466\t    daemon_threads = True\n467\t\n468\t\n469\tdef main():\n470\t    host = \"0.0.0.0\"\n471\t    port = 8080\n472\t    server = ThreadedHTTPServer((host, port), WebUIHandler)\n473\t    print(f\"LoopCLI WebUI Server running on http://{host}:{port}\")\n474\t    print(f\"Static files served from: {WEBUI_DIR}\")\n475\t    print(f\"Agent root: {LOOPCLI_ROOT}\")\n476\t    print(\"Press Ctrl+C to stop.\")\n477\t    try:\n478\t        server.serve_forever()\n479\t    except KeyboardInterrupt:\n480\t        print(\"\\nShutting down.\")\n481\t        server.server_close()\n482\t\n483\t\n484\tif __name__ == \"__main__\":\n485\t    main()\n486\t"}]},"parent_tool_use_id":null,"session_id":"cbcc82b3-7ad3-4d83-9d9a-bbf17bd9a264","uuid":"36af0f47-257f-4066-845c-3f001118fcc7","timestamp":"2026-05-20T22:13:21.513Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\loopcli\\main\\webui\\server.py","content":"\"\"\"\nLoopCLI WebUI Backend Server\nREST API + static file hosting for the Agent control console.\n\"\"\"\n\nimport json\nimport os\nimport signal\nimport subprocess\nimport sys\nimport time\nimport threading\nfrom datetime import datetime, timezone\nfrom http.server import HTTPServer, SimpleHTTPRequestHandler\nfrom socketserver import ThreadingMixIn\nfrom pathlib import Path\nfrom urllib.parse import urlparse, parse_qs\n\nLOOPCLI_ROOT = Path(r\"D:\\loopcli\")\nWEBUI_DIR = Path(__file__).parent.resolve()\nMAIN_DIR = LOOPCLI_ROOT / \"main\"\nLOOP_STATE_FILE = WEBUI_DIR / \"loop_state.json\"\n\n_loop_proc = None\n_loop_lock = threading.Lock()\n\n\ndef read_json(path: Path, default=None):\n    if not path.exists():\n        return default if default is not None else {}\n    try:\n        return json.loads(path.read_text(encoding=\"utf-8\"))\n    except (json.JSONDecodeError, OSError):\n        return default if default is not None else {}\n\n\ndef write_json(path: Path, data):\n    path.parent.mkdir(parents=True, exist_ok=True)\n    path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n\n\ndef scan_agents():\n    \"\"\"Scan loopcli root for agent directories (containing AGENT marker file).\"\"\"\n    agents = []\n    for child in LOOPCLI_ROOT.iterdir():\n        if not child.is_dir():\n            continue\n        agent_marker = child / \"AGENT\"\n        if not agent_marker.exists():\n            continue\n        state = read_json(child / \"memory\" / \"state.json\", {})\n        soul_path = child / \"SOUL.md\"\n        desc = \"\"\n        if soul_path.exists():\n            lines = soul_path.read_text(encoding=\"utf-8\").strip().splitlines()\n            for line in lines:\n                stripped = line.strip()\n                if stripped and not stripped.startswith(\"#\"):\n                    desc = stripped\n                    break\n        agents.append({\n            \"id\": child.name,\n            \"name\": state.get(\"agent\", child.name),\n            \"status\": state.get(\"status\", \"unknown\"),\n            \"description\": desc,\n            \"last_run\": state.get(\"last_run\"),\n            \"run_count\": state.get(\"run_count\", 0),\n            \"current_task\": state.get(\"current_task\"),\n        })\n    return agents\n\n\ndef get_main_tasks():\n    return read_json(MAIN_DIR / \"memory\" / \"tasks.json\", [])\n\n\ndef get_recent_lines(filepath: Path, n=100):\n    if not filepath.exists():\n        return []\n    try:\n        with open(filepath, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n            lines = f.readlines()\n        return [l.rstrip(\"\\n\\r\") for l in lines[-n:]]\n    except OSError:\n        return []\n\n\n# --- Loop Process Management ---\n\ndef get_loop_state():\n    return read_json(LOOP_STATE_FILE, {\n        \"status\": \"stopped\", \"pid\": None,\n        \"started_at\": None, \"iterations\": 0, \"total_iterations\": 0,\n    })\n\n\ndef set_loop_state(state):\n    write_json(LOOP_STATE_FILE, state)\n\n\ndef _is_pid_alive(pid):\n    if not pid:\n        return False\n    try:\n        os.kill(pid, 0)\n        return True\n    except (ProcessLookupError, PermissionError, OSError):\n        return False\n\n\ndef _monitor_loopcli(proc):\n    proc.wait()\n    with _loop_lock:\n        state = get_loop_state()\n        if state.get(\"pid\") == proc.pid:\n            state[\"status\"] = \"stopped\"\n            state[\"pid\"] = None\n            state[\"ended_at\"] = datetime.now().isoformat()\n            set_loop_state(state)\n\n\ndef start_loopcli_process(iterations=0):\n    global _loop_proc\n    with _loop_lock:\n        state = get_loop_state()\n        if state.get(\"status\") == \"running\" and _is_pid_alive(state.get(\"pid\")):\n            return {\"error\": \"Already running\"}, 409\n\n        cmd = [sys.executable, str(LOOPCLI_ROOT / \"run.py\"), \"run\"]\n        if iterations > 0:\n            cmd.extend([\"-n\", str(iterations)])\n\n        proc = subprocess.Popen(\n            cmd,\n            stdout=subprocess.DEVNULL,\n            stderr=subprocess.DEVNULL,\n            creationflags=getattr(subprocess, \"CREATE_NO_WINDOW\", 0),\n        )\n        _loop_proc = proc\n\n        state = {\n            \"status\": \"running\",\n            \"pid\": proc.pid,\n            \"started_at\": datetime.now().isoformat(),\n            \"iterations\": iterations,\n            \"total_iterations\": 0,\n        }\n        set_loop_state(state)\n\n        t = threading.Thread(target=_monitor_loopcli, args=(proc,), daemon=True)\n        t.start()\n        return state, 200\n\n\ndef stop_loopcli_process():\n    global _loop_proc\n    with _loop_lock:\n        state = get_loop_state()\n        pid = state.get(\"pid\")\n        if not pid or not _is_pid_alive(pid):\n            state[\"status\"] = \"stopped\"\n            state[\"pid\"] = None\n            set_loop_state(state)\n            return {\"error\": \"Not running\"}, 409\n\n        try:\n            os.kill(pid, signal.SIGTERM)\n        except OSError:\n            pass\n        if _loop_proc and _loop_proc.pid == pid:\n            try:\n                _loop_proc.terminate()\n            except OSError:\n                pass\n            _loop_proc = None\n\n        state[\"status\"] = \"stopped\"\n        state[\"pid\"] = None\n        state[\"ended_at\"] = datetime.now().isoformat()\n        set_loop_state(state)\n        return {\"status\": \"stopped\"}, 200\n\n\nclass WebUIHandler(SimpleHTTPRequestHandler):\n    def __init__(self, *args, **kwargs):\n        super().__init__(*args, directory=str(WEBUI_DIR), **kwargs)\n\n    def log_message(self, format, *args):\n        ts = datetime.now().strftime(\"%H:%M:%S\")\n        sys.stdout.write(f\"[{ts}] {format % args}\\n\")\n        sys.stdout.flush()\n\n    def _send_json(self, data, status=200):\n        body = json.dumps(data, ensure_ascii=False, indent=2).encode(\"utf-8\")\n        self.send_response(status)\n        self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def _read_body(self):\n        length = int(self.headers.get(\"Content-Length\", 0))\n        if length == 0:\n            return {}\n        raw = self.rfile.read(length)\n        try:\n            return json.loads(raw.decode(\"utf-8\"))\n        except (json.JSONDecodeError, UnicodeDecodeError):\n            return {}\n\n    def _cors_headers(self):\n        self.send_header(\"Access-Control-Allow-Origin\", \"*\")\n        self.send_header(\"Access-Control-Allow-Methods\", \"GET, POST, OPTIONS\")\n        self.send_header(\"Access-Control-Allow-Headers\", \"Content-Type\")\n\n    # ---------- SSE helpers ----------\n\n    def _send_sse_event(self, data):\n        payload = f\"data: {json.dumps(data, ensure_ascii=False)}\\n\\n\"\n        self.wfile.write(payload.encode(\"utf-8\"))\n        self.wfile.flush()\n\n    def _handle_sse_logs(self):\n        params = parse_qs(urlparse(self.path).query)\n        agent_id = params.get(\"agent\", [None])[0]\n        if agent_id:\n            log_path = LOOPCLI_ROOT / agent_id / \"log\" / \"run.md\"\n        else:\n            log_path = MAIN_DIR / \"log\" / \"run.md\"\n\n        self.send_response(200)\n        self.send_header(\"Content-Type\", \"text/event-stream\")\n        self.send_header(\"Cache-Control\", \"no-cache\")\n        self.send_header(\"Connection\", \"keep-alive\")\n        self.send_header(\"X-Accel-Buffering\", \"no\")\n        self._cors_headers()\n        self.end_headers()\n\n        last_size = 0\n        try:\n            while True:\n                if log_path.exists():\n                    current_size = log_path.stat().st_size\n                    if current_size != last_size:\n                        lines = get_recent_lines(log_path, 500)\n                        self._send_sse_event({\n                            \"agent\": agent_id,\n                            \"lines\": lines,\n                            \"ts\": datetime.now().isoformat(),\n                        })\n                        last_size = current_size\n                else:\n                    if last_size != -1:\n                        self._send_sse_event({\"agent\": agent_id, \"lines\": [], \"ts\": datetime.now().isoformat()})\n                        last_size = -1\n                time.sleep(1)\n        except (BrokenPipeError, ConnectionResetError, OSError):\n            pass\n\n    # ---------- GET routes ----------\n\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        path = parsed.path\n\n        if path == \"/api/agents\":\n            return self._send_json(scan_agents())\n\n        if path == \"/api/tasks\":\n            return self._send_json(get_main_tasks())\n\n        if path == \"/api/logs\":\n            params = parse_qs(parsed.query)\n            n = int(params.get(\"n\", [\"100\"])[0])\n            agent_id = params.get(\"agent\", [None])[0]\n            if agent_id:\n                log_path = LOOPCLI_ROOT / agent_id / \"log\" / \"run.md\"\n            else:\n                log_path = MAIN_DIR / \"log\" / \"run.md\"\n            lines = get_recent_lines(log_path, n)\n            return self._send_json({\"agent\": agent_id, \"lines\": lines})\n\n        if path == \"/api/logs/stream\":\n            return self._handle_sse_logs()\n\n        if path == \"/api/loopcli/status\":\n            return self._handle_loopcli_status()\n\n        # Static files\n        super().do_GET()\n\n    # ---------- POST routes ----------\n\n    def do_POST(self):\n        parsed = urlparse(self.path)\n        path = parsed.path\n\n        if path == \"/api/tasks\":\n            return self._handle_create_task()\n        if path == \"/api/agents/start\":\n            return self._handle_agent_start()\n        if path == \"/api/loopcli/start\":\n            return self._handle_loopcli_start()\n        if path == \"/api/loopcli/stop\":\n            return self._handle_loopcli_stop()\n        if path == \"/api/loopcli/restart\":\n            return self._handle_loopcli_restart()\n        if path == \"/api/loopcli/dispatch\":\n            return self._handle_loopcli_dispatch()\n\n        self._send_json({\"error\": \"Not found\"}, status=404)\n\n    # ---------- OPTIONS (CORS preflight) ----------\n\n    def do_OPTIONS(self):\n        self.send_response(204)\n        self._cors_headers()\n        self.end_headers()\n\n    # ---------- Handlers ----------\n\n    def _handle_create_task(self):\n        body = self._read_body()\n        title = body.get(\"title\", \"\").strip()\n        if not title:\n            return self._send_json({\"error\": \"title is required\"}, status=400)\n\n        tasks = get_main_tasks()\n        new_id = max((t.get(\"id\", 0) for t in tasks), default=0) + 1\n        task = {\n            \"id\": new_id,\n            \"status\": \"pending\",\n            \"title\": title,\n            \"description\": body.get(\"description\", \"\"),\n            \"created\": datetime.now(timezone.utc).strftime(\"%Y-%m-%d\"),\n            \"assignee\": body.get(\"assignee\") or \"main\",\n        }\n        tasks.append(task)\n        write_json(MAIN_DIR / \"memory\" / \"tasks.json\", tasks)\n        self._send_json(task, status=201)\n\n    def _handle_agent_start(self):\n        body = self._read_body()\n        agent_id = body.get(\"agent\", \"\").strip()\n        if not agent_id:\n            return self._send_json({\"error\": \"agent is required\"}, status=400)\n\n        agent_dir = LOOPCLI_ROOT / agent_id\n        prompt_file = agent_dir / \"PROMPT.md\"\n        if not prompt_file.exists():\n            return self._send_json({\"error\": f\"Agent '{agent_id}' not found or no PROMPT.md\"}, status=404)\n\n        # Launch claude in the agent directory, reading PROMPT.md\n        try:\n            proc = subprocess.Popen(\n                [\"claude\", \"--print\", \"$(cat PROMPT.md)\"],\n                cwd=str(agent_dir),\n                shell=True,\n                stdout=subprocess.PIPE,\n                stderr=subprocess.PIPE,\n            )\n        except FileNotFoundError:\n            proc = subprocess.Popen(\n                [\"claude\", \"--print\", prompt_file.read_text(encoding=\"utf-8\")],\n                cwd=str(agent_dir),\n                stdout=subprocess.PIPE,\n                stderr=subprocess.PIPE,\n            )\n\n        self._send_json({\n            \"agent\": agent_id,\n            \"pid\": proc.pid,\n            \"status\": \"started\",\n        })\n\n    # --- Loop control handlers ---\n\n    def _handle_loopcli_status(self):\n        state = get_loop_state()\n        pid = state.get(\"pid\")\n        if state.get(\"status\") == \"running\" and pid and not _is_pid_alive(pid):\n            state[\"status\"] = \"stopped\"\n            state[\"pid\"] = None\n            state[\"ended_at\"] = datetime.now().isoformat()\n            set_loop_state(state)\n\n        uptime = 0\n        if state.get(\"started_at\"):\n            try:\n                started = datetime.fromisoformat(state[\"started_at\"])\n                uptime = int((datetime.now() - started).total_seconds())\n            except (ValueError, TypeError):\n                pass\n        state[\"uptime_seconds\"] = uptime\n        self._send_json(state)\n\n    def _handle_loopcli_start(self):\n        body = self._read_body()\n        iterations = int(body.get(\"iterations\", 0))\n        data, status = start_loopcli_process(iterations)\n        self._send_json(data, status)\n\n    def _handle_loopcli_stop(self):\n        data, status = stop_loopcli_process()\n        self._send_json(data, status)\n\n    def _handle_loopcli_restart(self):\n        stop_loopcli_process()\n        time.sleep(0.5)\n        body = self._read_body()\n        iterations = int(body.get(\"iterations\", 0))\n        data, status = start_loopcli_process(iterations)\n        self._send_json(data, status)\n\n    def _handle_loopcli_dispatch(self):\n        body = self._read_body()\n        agent_id = body.get(\"agent\", \"\").strip()\n        title = body.get(\"title\", \"\").strip()\n        if not agent_id or not title:\n            return self._send_json({\"error\": \"agent and title are required\"}, status=400)\n\n        agent_dir = LOOPCLI_ROOT / agent_id\n        if not (agent_dir / \"AGENT\").exists():\n            return self._send_json({\"error\": f\"Agent '{agent_id}' not found\"}, status=404)\n\n        # Write task to agent's tasks.json\n        tasks_file = agent_dir / \"memory\" / \"tasks.json\"\n        tasks = read_json(tasks_file, [])\n        new_id = max((t.get(\"id\", 0) for t in tasks), default=0) + 1\n        task = {\n            \"id\": new_id,\n            \"status\": \"pending\",\n            \"title\": title,\n            \"description\": body.get(\"description\", \"\"),\n            \"created\": datetime.now(timezone.utc).strftime(\"%Y-%m-%d\"),\n            \"assignee\": agent_id,\n        }\n        tasks.append(task)\n        write_json(tasks_file, tasks)\n\n        # Start claude process for this agent\n        prompt_file = agent_dir / \"PROMPT.md\"\n        prompt = \"\"\n        if prompt_file.exists():\n            prompt = prompt_file.read_text(encoding=\"utf-8\")\n\n        proc = subprocess.Popen(\n            [\"claude\", \"--print\", \"--dangerously-skip-permissions\"],\n            stdin=subprocess.PIPE,\n            stdout=subprocess.DEVNULL,\n            stderr=subprocess.DEVNULL,\n            cwd=str(agent_dir),\n        )\n        if prompt:\n            proc.stdin.write(prompt.encode(\"utf-8\"))\n            proc.stdin.close()\n\n        self._send_json({\n            \"task\": task,\n            \"pid\": proc.pid,\n            \"status\": \"dispatched\",\n        }, status=201)\n\n\nclass ThreadedHTTPServer(ThreadingMixIn, HTTPServer):\n    daemon_threads = True\n\n\ndef main():\n    host = \"0.0.0.0\"\n    port = 8080\n    server = ThreadedHTTPServer((host, port), WebUIHandler)\n    print(f\"LoopCLI WebUI Server running on http://{host}:{port}\")\n    print(f\"Static files served from: {WEBUI_DIR}\")\n    print(f\"Agent root: {LOOPCLI_ROOT}\")\n    print(\"Press Ctrl+C to stop.\")\n    try:\n        server.serve_forever()\n    except KeyboardInterrupt:\n        print(\"\\nShutting down.\")\n        server.server_close()\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":486,"startLine":1,"totalLines":486}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_484005a8fc07418fa2417b4d","type":"tool_result","content":"1\t<!DOCTYPE html>\n2\t<html lang=\"zh-CN\">\n3\t<head>\n4\t<meta charset=\"UTF-8\">\n5\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n6\t<title>LoopCLI - Agent 控制台</title>\n7\t<style>\n8\t*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n9\t:root {\n10\t  --bg: #0f1117; --surface: #1a1d27; --surface2: #242834;\n11\t  --border: #2e3345; --text: #e4e6ed; --text2: #8b90a0;\n12\t  --accent: #6c5ce7; --accent2: #a29bfe;\n13\t  --green: #00b894; --yellow: #fdcb6e; --red: #e17055; --blue: #74b9ff;\n14\t  --radius: 10px;\n15\t}\n16\tbody { font-family: -apple-system, \"Segoe UI\", system-ui, sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }\n17\t\n18\t/* Layout */\n19\t.app { display: flex; height: 100vh; }\n20\t.sidebar { width: 240px; background: var(--surface); border-right: 1px solid var(--border); display: flex; flex-direction: column; flex-shrink: 0; }\n21\t.main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }\n22\t\n23\t/* Sidebar */\n24\t.brand { padding: 20px; border-bottom: 1px solid var(--border); }\n25\t.brand h1 { font-size: 18px; font-weight: 700; }\n26\t.brand span { color: var(--accent2); }\n27\t.nav { padding: 12px 8px; flex: 1; }\n28\t.nav-item { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: var(--radius); cursor: pointer; color: var(--text2); transition: all .15s; font-size: 14px; }\n29\t.nav-item:hover { background: var(--surface2); color: var(--text); }\n30\t.nav-item.active { background: rgba(108,92,231,.15); color: var(--accent2); }\n31\t.nav-item .icon { width: 20px; text-align: center; font-size: 16px; }\n32\t.sidebar-footer { padding: 16px 20px; border-top: 1px solid var(--border); font-size: 12px; color: var(--text2); }\n33\t\n34\t/* Header */\n35\t.header { padding: 16px 28px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }\n36\t.header h2 { font-size: 18px; font-weight: 600; }\n37\t.header-actions { display: flex; gap: 10px; }\n38\t\n39\t/* Content */\n40\t.content { flex: 1; overflow-y: auto; padding: 24px 28px; }\n41\t\n42\t/* Stats bar */\n43\t.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin-bottom: 24px; }\n44\t.stat-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; }\n45\t.stat-card .label { font-size: 12px; color: var(--text2); margin-bottom: 6px; }\n46\t.stat-card .value { font-size: 26px; font-weight: 700; }\n47\t\n48\t/* Agent cards */\n49\t.agent-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }\n50\t.agent-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px; transition: border-color .15s; }\n51\t.agent-card:hover { border-color: var(--accent); }\n52\t.agent-card .top { display: flex; justify-content: space-between; align-items: start; margin-bottom: 10px; }\n53\t.agent-card .name { font-weight: 600; font-size: 15px; }\n54\t.agent-card .dept { font-size: 12px; color: var(--text2); background: var(--surface2); padding: 2px 8px; border-radius: 4px; }\n55\t.agent-card .desc { font-size: 13px; color: var(--text2); margin-bottom: 12px; line-height: 1.5; }\n56\t.agent-card .bottom { display: flex; justify-content: space-between; align-items: center; }\n57\t.status-badge { font-size: 12px; padding: 3px 10px; border-radius: 20px; font-weight: 500; }\n58\t.status-badge.running { background: rgba(0,184,148,.15); color: var(--green); }\n59\t.status-badge.idle { background: rgba(116,185,255,.12); color: var(--blue); }\n60\t.status-badge.busy { background: rgba(253,203,110,.15); color: var(--yellow); }\n61\t.status-badge.error { background: rgba(225,112,85,.15); color: var(--red); }\n62\t\n63\t/* Task table */\n64\t.task-table { width: 100%; border-collapse: collapse; }\n65\t.task-table th { text-align: left; padding: 10px 14px; font-size: 12px; color: var(--text2); border-bottom: 1px solid var(--border); text-transform: uppercase; letter-spacing: .5px; }\n66\t.task-table td { padding: 12px 14px; font-size: 14px; border-bottom: 1px solid var(--border); }\n67\t.task-table tr:hover td { background: var(--surface2); }\n68\t.task-status { font-size: 12px; padding: 2px 8px; border-radius: 4px; }\n69\t.task-status.done { background: rgba(0,184,148,.15); color: var(--green); }\n70\t.task-status.pending { background: rgba(253,203,110,.15); color: var(--yellow); }\n71\t.task-status.in_progress { background: rgba(108,92,231,.15); color: var(--accent2); }\n72\t.task-status.blocked { background: rgba(225,112,85,.15); color: var(--red); }\n73\t\n74\t/* Button */\n75\t.btn { padding: 8px 16px; border-radius: var(--radius); border: 1px solid var(--border); background: var(--surface2); color: var(--text); font-size: 13px; cursor: pointer; transition: all .15s; }\n76\t.btn:hover { border-color: var(--accent); }\n77\t.btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }\n78\t.btn-primary:hover { background: var(--accent2); border-color: var(--accent2); }\n79\t\n80\t/* Modal */\n81\t.modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.6); display: none; justify-content: center; align-items: center; z-index: 100; }\n82\t.modal-overlay.show { display: flex; }\n83\t.modal { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 28px; width: 480px; max-width: 90vw; }\n84\t.modal h3 { margin-bottom: 20px; font-size: 17px; }\n85\t.form-group { margin-bottom: 16px; }\n86\t.form-group label { display: block; font-size: 13px; color: var(--text2); margin-bottom: 6px; }\n87\t.form-group input, .form-group textarea, .form-group select { width: 100%; padding: 9px 12px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); font-size: 14px; outline: none; }\n88\t.form-group input:focus, .form-group textarea:focus, .form-group select:focus { border-color: var(--accent); }\n89\t.form-group textarea { min-height: 70px; resize: vertical; }\n90\t.modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; }\n91\t\n92\t/* Page hidden */\n93\t.page { display: none; }\n94\t.page.active { display: block; }\n95\t\n96\t/* Logs */\n97\t.log-toolbar { display: flex; gap: 10px; align-items: center; margin-bottom: 14px; flex-wrap: wrap; }\n98\t.log-toolbar select, .log-toolbar input { padding: 7px 12px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); font-size: 13px; outline: none; }\n99\t.log-toolbar select:focus, .log-toolbar input:focus { border-color: var(--accent); }\n100\t.log-toolbar input { flex: 1; min-width: 180px; }\n101\t.log-auto-scroll { font-size: 13px; color: var(--text2); display: flex; align-items: center; gap: 5px; cursor: pointer; }\n102\t.log-auto-scroll input { accent-color: var(--accent); }\n103\t.log-container { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); height: calc(100vh - 220px); overflow-y: auto; }\n104\t.log-container pre { padding: 14px; font-family: \"Cascadia Code\", \"Fira Code\", \"Consolas\", monospace; font-size: 13px; line-height: 1.6; color: var(--text); margin: 0; white-space: pre-wrap; word-break: break-all; }\n105\t.log-container .log-line { border-bottom: 1px solid var(--border); padding: 2px 0; }\n106\t.log-container .log-line.highlight { background: rgba(108,92,231,.15); }\n107\t.log-container .log-time { color: var(--text2); margin-right: 8px; }\n108\t.log-container .log-agent-tag { color: var(--accent2); margin-right: 8px; font-size: 12px; }\n109\t.log-connected { color: var(--green); font-size: 12px; }\n110\t.log-disconnected { color: var(--red); font-size: 12px; }\n111\t\n112\t/* Control Panel */\n113\t.ctrl-section { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 22px; margin-bottom: 20px; }\n114\t.ctrl-title { font-size: 15px; font-weight: 600; margin-bottom: 16px; }\n115\t.ctrl-status-card { margin-bottom: 18px; }\n116\t.ctrl-status-row { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; font-size: 15px; font-weight: 600; }\n117\t.ctrl-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--red); display: inline-block; }\n118\t.ctrl-dot.running { background: var(--green); animation: pulse 1.5s infinite; }\n119\t@keyframes pulse { 0%,100%{ opacity:1 } 50%{ opacity:.4 } }\n120\t.ctrl-info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; }\n121\t.ctrl-info { background: var(--bg); border-radius: 8px; padding: 10px 14px; }\n122\t.ctrl-label { font-size: 11px; color: var(--text2); text-transform: uppercase; letter-spacing: .5px; }\n123\t.ctrl-val { font-size: 17px; font-weight: 700; display: block; margin-top: 4px; }\n124\t.ctrl-actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }\n125\t.ctrl-start-group { display: flex; gap: 8px; align-items: center; }\n126\t.ctrl-input { padding: 8px 12px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); font-size: 13px; outline: none; width: 180px; }\n127\t.ctrl-input:focus { border-color: var(--accent); }\n128\t.ctrl-dispatch-form { max-width: 500px; }\n129\t\n130\t/* Responsive */\n131\t@media (max-width: 768px) {\n132\t  .sidebar { width: 56px; }\n133\t  .brand h1, .nav-item span, .sidebar-footer { display: none; }\n134\t  .nav-item { justify-content: center; padding: 10px; }\n135\t  .content { padding: 16px; }\n136\t}\n137\t</style>\n138\t</head>\n139\t<body>\n140\t<div class=\"app\">\n141\t  <aside class=\"sidebar\">\n142\t    <div class=\"brand\"><h1><span>Loop</span>CLI</h1></div>\n143\t    <nav class=\"nav\">\n144\t      <div class=\"nav-item active\" data-page=\"dashboard\"><div class=\"icon\">📊</div><span>仪表盘</span></div>\n145\t      <div class=\"nav-item\" data-page=\"agents\"><div class=\"icon\">🤖</div><span>Agent 列表</span></div>\n146\t      <div class=\"nav-item\" data-page=\"tasks\"><div class=\"icon\">📋</div><span>任务管理</span></div>\n147\t      <div class=\"nav-item\" data-page=\"logs\"><div class=\"icon\">📄</div><span>实时日志</span></div>\n148\t      <div class=\"nav-item\" data-page=\"control\"><div class=\"icon\">⚙️</div><span>控制面板</span></div>\n149\t    </nav>\n150\t    <div class=\"sidebar-footer\">LoopCLI v0.1</div>\n151\t  </aside>\n152\t\n153\t  <div class=\"main\">\n154\t    <div class=\"header\">\n155\t      <h2 id=\"pageTitle\">仪表盘</h2>\n156\t      <div class=\"header-actions\">\n157\t        <span id=\"log-status\"></span>\n158\t        <button class=\"btn btn-primary\" id=\"newTaskBtn\">+ 新任务</button>\n159\t      </div>\n160\t    </div>\n161\t\n162\t    <div class=\"content\">\n163\t      <!-- Dashboard -->\n164\t      <div class=\"page active\" id=\"page-dashboard\">\n165\t        <div class=\"stats\">\n166\t          <div class=\"stat-card\"><div class=\"label\">Agent 总数</div><div class=\"value\" id=\"stat-agents\">-</div></div>\n167\t          <div class=\"stat-card\"><div class=\"label\">运行中</div><div class=\"value\" style=\"color:var(--green)\" id=\"stat-running\">-</div></div>\n168\t          <div class=\"stat-card\"><div class=\"label\">空闲</div><div class=\"value\" style=\"color:var(--blue)\" id=\"stat-idle\">-</div></div>\n169\t          <div class=\"stat-card\"><div class=\"label\">待处理任务</div><div class=\"value\" style=\"color:var(--yellow)\" id=\"stat-pending\">-</div></div>\n170\t        </div>\n171\t        <h3 style=\"margin-bottom:14px;font-size:15px\">Agent 概览</h3>\n172\t        <div class=\"agent-grid\" id=\"dash-agents\"></div>\n173\t      </div>\n174\t\n175\t      <!-- Agents -->\n176\t      <div class=\"page\" id=\"page-agents\">\n177\t        <div class=\"agent-grid\" id=\"agent-list\"></div>\n178\t      </div>\n179\t\n180\t      <!-- Tasks -->\n181\t      <div class=\"page\" id=\"page-tasks\">\n182\t        <table class=\"task-table\">\n183\t          <thead><tr><th>ID</th><th>标题</th><th>状态</th><th>负责人</th><th>创建日期</th></tr></thead>\n184\t          <tbody id=\"task-list\"></tbody>\n185\t        </table>\n186\t      </div>\n187\t\n188\t      <!-- Logs -->\n189\t      <div class=\"page\" id=\"page-logs\">\n190\t        <div class=\"log-toolbar\">\n191\t          <select id=\"log-agent-filter\"><option value=\"\">All Agents</option></select>\n192\t          <input id=\"log-search\" placeholder=\"搜索日志...\" />\n193\t          <button class=\"btn\" id=\"log-clear-btn\">清空显示</button>\n194\t          <label class=\"log-auto-scroll\"><input type=\"checkbox\" id=\"log-autoscroll\" checked /> 自动滚动</label>\n195\t        </div>\n196\t        <div class=\"log-container\" id=\"log-container\"><pre id=\"log-output\"></pre></div>\n197\t      </div>\n198\t\n199\t      <!-- Control Panel -->\n200\t      <div class=\"page\" id=\"page-control\">\n201\t        <div class=\"ctrl-section\">\n202\t          <h3 class=\"ctrl-title\">Loop 进程控制</h3>\n203\t          <div class=\"ctrl-status-card\">\n204\t            <div class=\"ctrl-status-row\">\n205\t              <span class=\"ctrl-dot\" id=\"ctrl-dot\"></span>\n206\t              <span id=\"ctrl-status-text\">已停止</span>\n207\t            </div>\n208\t            <div class=\"ctrl-info-grid\">\n209\t              <div class=\"ctrl-info\"><span class=\"ctrl-label\">PID</span><span class=\"ctrl-val\" id=\"ctrl-pid\">-</span></div>\n210\t              <div class=\"ctrl-info\"><span class=\"ctrl-label\">运行时长</span><span class=\"ctrl-val\" id=\"ctrl-uptime\">-</span></div>\n211\t              <div class=\"ctrl-info\"><span class=\"ctrl-label\">迭代次数</span><span class=\"ctrl-val\" id=\"ctrl-iterations\">-</span></div>\n212\t              <div class=\"ctrl-info\"><span class=\"ctrl-label\">启动时间</span><span class=\"ctrl-val\" id=\"ctrl-started\">-</span></div>\n213\t            </div>\n214\t          </div>\n215\t          <div class=\"ctrl-actions\">\n216\t            <div class=\"ctrl-start-group\">\n217\t              <input type=\"number\" id=\"ctrl-iter-input\" placeholder=\"迭代次数 (0=无限)\" min=\"0\" value=\"0\" class=\"ctrl-input\" />\n218\t              <button class=\"btn btn-primary\" id=\"ctrl-start-btn\">启动 Loop</button>\n219\t            </div>\n220\t            <button class=\"btn\" id=\"ctrl-stop-btn\">停止</button>\n221\t            <button class=\"btn\" id=\"ctrl-restart-btn\">重启</button>\n222\t          </div>\n223\t        </div>\n224\t\n225\t        <div class=\"ctrl-section\">\n226\t          <h3 class=\"ctrl-title\">一键派发任务</h3>\n227\t          <div class=\"ctrl-dispatch-form\">\n228\t            <div class=\"form-group\"><label>目标 Agent</label>\n229\t              <select id=\"d-agent\"><option value=\"\">-- 选择 Agent --</option></select>\n230\t            </div>\n231\t            <div class=\"form-group\"><label>任务标题</label><input id=\"d-title\" placeholder=\"输入任务标题\"></div>\n232\t            <div class=\"form-group\"><label>任务描述</label><textarea id=\"d-desc\" placeholder=\"描述任务内容\"></textarea></div>\n233\t            <button class=\"btn btn-primary\" id=\"d-submit\">派发并执行</button>\n234\t          </div>\n235\t        </div>\n236\t      </div>\n237\t    </div>\n238\t  </div>\n239\t</div>\n240\t\n241\t<!-- New Task Modal -->\n242\t<div class=\"modal-overlay\" id=\"modal\">\n243\t  <div class=\"modal\">\n244\t    <h3>创建新任务</h3>\n245\t    <div class=\"form-group\"><label>任务标题</label><input id=\"f-title\" placeholder=\"输入任务标题\"></div>\n246\t    <div class=\"form-group\"><label>任务描述</label><textarea id=\"f-desc\" placeholder=\"描述任务内容\"></textarea></div>\n247\t    <div class=\"form-group\"><label>指派 Agent</label>\n248\t      <select id=\"f-agent\"><option value=\"\">-- 未指派 --</option></select>\n249\t    </div>\n250\t    <div class=\"modal-actions\">\n251\t      <button class=\"btn\" id=\"modalCancel\">取消</button>\n252\t      <button class=\"btn btn-primary\" id=\"modalSubmit\">创建</button>\n253\t    </div>\n254\t  </div>\n255\t</div>\n256\t\n257\t<script>\n258\tlet agents = [];\n259\tlet tasks = [];\n260\t\n261\tasync function loadAgents() {\n262\t  try {\n263\t    const r = await fetch('/api/agents');\n264\t    agents = await r.json();\n265\t  } catch { agents = []; }\n266\t}\n267\t\n268\tasync function loadTasks() {\n269\t  try {\n270\t    const r = await fetch('/api/tasks');\n271\t    tasks = await r.json();\n272\t  } catch { tasks = []; }\n273\t}\n274\t\n275\tasync function loadData() {\n276\t  await Promise.all([loadAgents(), loadTasks()]);\n277\t  render();\n278\t}\n279\t\n280\tfunction render() {\n281\t  renderStats();\n282\t  renderAgentCards('dash-agents', agents);\n283\t  renderAgentCards('agent-list', agents);\n284\t  renderTasks();\n285\t  fillAgentSelect();\n286\t}\n287\t\n288\tfunction renderStats() {\n289\t  document.getElementById('stat-agents').textContent = agents.length;\n290\t  document.getElementById('stat-running').textContent = agents.filter(a => a.status === 'running').length;\n291\t  document.getElementById('stat-idle').textContent = agents.filter(a => a.status === 'idle').length;\n292\t  document.getElementById('stat-pending').textContent = tasks.filter(t => t.status === 'pending').length;\n293\t}\n294\t\n295\tfunction fmtTime(iso) {\n296\t  if (!iso) return '-';\n297\t  try {\n298\t    const d = new Date(iso);\n299\t    return d.toLocaleString('zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });\n300\t  } catch { return iso; }\n301\t}\n302\t\n303\tfunction renderAgentCards(containerId, list) {\n304\t  const c = document.getElementById(containerId);\n305\t  c.innerHTML = list.map(a => `\n306\t    <div class=\"agent-card\">\n307\t      <div class=\"top\">\n308\t        <div class=\"name\">${esc(a.name)}</div>\n309\t        <span class=\"status-badge ${a.status}\">${statusLabel(a.status)}</span>\n310\t      </div>\n311\t      <div class=\"desc\">${esc(a.description)}</div>\n312\t      <div class=\"bottom\">\n313\t        <span style=\"font-size:12px;color:var(--text2)\">最后运行: ${fmtTime(a.last_run)}</span>\n314\t        <span style=\"font-size:12px;color:var(--text2)\">轮次: ${a.run_count ?? 0}</span>\n315\t      </div>\n316\t    </div>\n317\t  `).join('');\n318\t}\n319\t\n320\tfunction renderTasks() {\n321\t  const tbody = document.getElementById('task-list');\n322\t  tbody.innerHTML = tasks.map(t => `\n323\t    <tr>\n324\t      <td>#${t.id}</td>\n325\t      <td>${esc(t.title)}</td>\n326\t      <td><span class=\"task-status ${t.status}\">${statusLabel(t.status)}</span></td>\n327\t      <td>${t.assignee ? esc(t.assignee) : '<span style=\"color:var(--text2)\">未指派</span>'}</td>\n328\t      <td style=\"color:var(--text2)\">${t.created}</td>\n329\t    </tr>\n330\t  `).join('');\n331\t}\n332\t\n333\tfunction fillAgentSelect() {\n334\t  const sel = document.getElementById('f-agent');\n335\t  sel.innerHTML = '<option value=\"\">-- 未指派 --</option>' +\n336\t    agents.map(a => `<option value=\"${esc(a.id)}\">${esc(a.name)}</option>`).join('');\n337\t}\n338\t\n339\t// Navigation\n340\tdocument.querySelectorAll('.nav-item').forEach(item => {\n341\t  item.addEventListener('click', () => {\n342\t    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));\n343\t    item.classList.add('active');\n344\t    const page = item.dataset.page;\n345\t    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));\n346\t    document.getElementById('page-' + page).classList.add('active');\n347\t    const titles = { dashboard: '仪表盘', agents: 'Agent 列表', tasks: '任务管理', logs: '实时日志', control: '控制面板' };\n348\t    document.getElementById('pageTitle').textContent = titles[page];\n349\t    if (page === 'logs') { initLogStream(); } else { closeLogStream(); }\n350\t  });\n351\t});\n352\t\n353\t// Modal\n354\tconst modal = document.getElementById('modal');\n355\tdocument.getElementById('newTaskBtn').addEventListener('click', () => modal.classList.add('show'));\n356\tdocument.getElementById('modalCancel').addEventListener('click', () => modal.classList.remove('show'));\n357\tmodal.addEventListener('click', e => { if (e.target === modal) modal.classList.remove('show'); });\n358\t\n359\tdocument.getElementById('modalSubmit').addEventListener('click', async () => {\n360\t  const title = document.getElementById('f-title').value.trim();\n361\t  const desc = document.getElementById('f-desc').value.trim();\n362\t  const agent = document.getElementById('f-agent').value;\n363\t  if (!title) return;\n364\t  try {\n365\t    await fetch('/api/tasks', {\n366\t      method: 'POST',\n367\t      headers: { 'Content-Type': 'application/json' },\n368\t      body: JSON.stringify({ title, description: desc, assignee: agent || undefined })\n369\t    });\n370\t  } catch { /* fallback: will reload anyway */ }\n371\t  modal.classList.remove('show');\n372\t  document.getElementById('f-title').value = '';\n373\t  document.getElementById('f-desc').value = '';\n374\t  document.getElementById('f-agent').value = '';\n375\t  await loadData();\n376\t});\n377\t\n378\tfunction statusLabel(s) {\n379\t  return { running: '运行中', idle: '空闲', busy: '忙碌', error: '异常', done: '已完成', pending: '待处理', in_progress: '进行中', blocked: '已阻塞' }[s] || s;\n380\t}\n381\tfunction esc(s) { const d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; }\n382\t\n383\t// --- Log SSE Stream ---\n384\tlet logEventSource = null;\n385\tlet logLines = [];\n386\tconst MAX_LOG_LINES = 2000;\n387\t\n388\tfunction initLogStream() {\n389\t  if (logEventSource) return;\n390\t  const agent = document.getElementById('log-agent-filter').value;\n391\t  const url = '/api/logs/stream' + (agent ? '?agent=' + encodeURIComponent(agent) : '');\n392\t  logEventSource = new EventSource(url);\n393\t  const statusEl = null; // could add a connection indicator\n394\t  logEventSource.onmessage = function(e) {\n395\t    try {\n396\t      const data = JSON.parse(e.data);\n397\t      const newLines = data.lines || [];\n398\t      const agentTag = data.agent || 'main';\n399\t      // Only update if content changed\n400\t      const joined = newLines.join('\\n');\n401\t      if (logLines.map(l => l.text).join('\\n') !== joined) {\n402\t        logLines = newLines.map(l => ({ text: l, agent: agentTag }));\n403\t        if (logLines.length > MAX_LOG_LINES) logLines = logLines.slice(-MAX_LOG_LINES);\n404\t        renderLogOutput();\n405\t      }\n406\t    } catch {}\n407\t  };\n408\t  logEventSource.onerror = function() {\n409\t    if (logEventSource) { logEventSource.close(); logEventSource = null; }\n410\t  };\n411\t}\n412\t\n413\tfunction closeLogStream() {\n414\t  if (logEventSource) { logEventSource.close(); logEventSource = null; }\n415\t}\n416\t\n417\tfunction renderLogOutput() {\n418\t  const pre = document.getElementById('log-output');\n419\t  const container = document.getElementById('log-container');\n420\t  const search = document.getElementById('log-search').value.toLowerCase();\n421\t  const autoScroll = document.getElementById('log-autoscroll').checked;\n422\t\n423\t  const html = logLines.map(l => {\n424\t    const text = esc(l.text);\n425\t    const match = !search || l.text.toLowerCase().includes(search);\n426\t    const hl = search && match ? ' highlight' : '';\n427\t    const agentTag = l.agent ? `<span class=\"log-agent-tag\">[${esc(l.agent)}]</span>` : '';\n428\t    return match ? `<div class=\"log-line${hl}\">${agentTag}${text}</div>` : '';\n429\t  }).join('');\n430\t  pre.innerHTML = html || '<div style=\"color:var(--text2)\">暂无日志</div>';\n431\t\n432\t  if (autoScroll) container.scrollTop = container.scrollHeight;\n433\t}\n434\t\n435\tdocument.getElementById('log-agent-filter').addEventListener('change', function() {\n436\t  logLines = [];\n437\t  closeLogStream();\n438\t  initLogStream();\n439\t});\n440\t\n441\tdocument.getElementById('log-search').addEventListener('input', renderLogOutput);\n442\tdocument.getElementById('log-clear-btn').addEventListener('click', function() {\n443\t  logLines = [];\n444\t  renderLogOutput();\n445\t});\n446\t\n447\tfunction fillLogAgentFilter() {\n448\t  const sel = document.getElementById('log-agent-filter');\n449\t  const cur = sel.value;\n450\t  sel.innerHTML = '<option value=\"\">All Agents</option>' +\n451\t    '<option value=\"\">main</option>' +\n452\t    agents.map(a => `<option value=\"${esc(a.id)}\">${esc(a.name)}</option>`).join('');\n453\t  sel.value = cur;\n454\t}\n455\t\n456\t// Patch render to also update log filter\n457\tconst _origRender = render;\n458\trender = function() {\n459\t  _origRender();\n460\t  fillLogAgentFilter();\n461\t};\n462\t\n463\tloadData();\n464\tsetInterval(loadData, 10000);\n465\t\n466\t// --- Control Panel ---\n467\tfunction fmtDuration(sec) {\n468\t  if (!sec || sec < 0) return '-';\n469\t  const h = Math.floor(sec / 3600);\n470\t  const m = Math.floor((sec % 3600) / 60);\n471\t  const s = sec % 60;\n472\t  return h > 0 ? `${h}h ${String(m).padStart(2,'0')}m ${String(s).padStart(2,'0')}s` : `${m}m ${String(s).padStart(2,'0')}s`;\n473\t}\n474\t\n475\tasync function loadLoopStatus() {\n476\t  try {\n477\t    const r = await fetch('/api/loopcli/status');\n478\t    const st = await r.json();\n479\t    const dot = document.getElementById('ctrl-dot');\n480\t    const txt = document.getElementById('ctrl-status-text');\n481\t    if (st.status === 'running') {\n482\t      dot.className = 'ctrl-dot running';\n483\t      txt.textContent = '运行中';\n484\t      txt.style.color = 'var(--green)';\n485\t    } else {\n486\t      dot.className = 'ctrl-dot';\n487\t      txt.textContent = '已停止';\n488\t      txt.style.color = 'var(--text2)';\n489\t    }\n490\t    document.getElementById('ctrl-pid').textContent = st.pid || '-';\n491\t    document.getElementById('ctrl-uptime').textContent = fmtDuration(st.uptime_seconds);\n492\t    document.getElementById('ctrl-iterations').textContent = st.iterations > 0 ? st.iterations : '∞';\n493\t    document.getElementById('ctrl-started').textContent = st.started_at ? new Date(st.started_at).toLocaleString('zh-CN') : '-';\n494\t  } catch {}\n495\t}\n496\t\n497\tdocument.getElementById('ctrl-start-btn').addEventListener('click', async () => {\n498\t  const n = parseInt(document.getElementById('ctrl-iter-input').value) || 0;\n499\t  await fetch('/api/loopcli/start', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({iterations: n}) });\n500\t  setTimeout(loadLoopStatus, 500);\n501\t});\n502\t\n503\tdocument.getElementById('ctrl-stop-btn').addEventListener('click', async () => {\n504\t  await fetch('/api/loopcli/stop', { method: 'POST' });\n505\t  setTimeout(loadLoopStatus, 500);\n506\t});\n507\t\n508\tdocument.getElementById('ctrl-restart-btn').addEventListener('click', async () => {\n509\t  const n = parseInt(document.getElementById('ctrl-iter-input').value) || 0;\n510\t  await fetch('/api/loopcli/restart', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({iterations: n}) });\n511\t  setTimeout(loadLoopStatus, 500);\n512\t});\n513\t\n514\t// Dispatch\n515\tfunction fillDispatchAgentSelect() {\n516\t  const sel = document.getElementById('d-agent');\n517\t  const cur = sel.value;\n518\t  sel.innerHTML = '<option value=\"\">-- 选择 Agent --</option>' +\n519\t    agents.map(a => `<option value=\"${esc(a.id)}\">${esc(a.name)}</option>`).join('');\n520\t  sel.value = cur;\n521\t}\n522\t\n523\tdocument.getElementById('d-submit').addEventListener('click', async () => {\n524\t  const agent = document.getElementById('d-agent').value;\n525\t  const title = document.getElementById('d-title').value.trim();\n526\t  const desc = document.getElementById('d-desc').value.trim();\n527\t  if (!agent || !title) return;\n528\t  await fetch('/api/loopcli/dispatch', {\n529\t    method: 'POST',\n530\t    headers: {'Content-Type':'application/json'},\n531\t    body: JSON.stringify({agent, title, description: desc}),\n532\t  });\n533\t  document.getElementById('d-title').value = '';\n534\t  document.getElementById('d-desc').value = '';\n535\t  await loadData();\n536\t});\n537\t\n538\t// Patch render to also update control panel\n539\tconst _origRender2 = render;\n540\trender = function() {\n541\t  _origRender2();\n542\t  fillDispatchAgentSelect();\n543\t};\n544\t\n545\tloadLoopStatus();\n546\tsetInterval(loadLoopStatus, 3000);\n547\t</script>\n548\t</body>\n549\t</html>\n550\t"}]},"parent_tool_use_id":null,"session_id":"cbcc82b3-7ad3-4d83-9d9a-bbf17bd9a264","uuid":"0c105715-ea29-4a5d-af66-c2f972937063","timestamp":"2026-05-20T22:13:22.004Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\loopcli\\main\\webui\\index.html","content":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>LoopCLI - Agent 控制台</title>\n<style>\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n:root {\n  --bg: #0f1117; --surface: #1a1d27; --surface2: #242834;\n  --border: #2e3345; --text: #e4e6ed; --text2: #8b90a0;\n  --accent: #6c5ce7; --accent2: #a29bfe;\n  --green: #00b894; --yellow: #fdcb6e; --red: #e17055; --blue: #74b9ff;\n  --radius: 10px;\n}\nbody { font-family: -apple-system, \"Segoe UI\", system-ui, sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }\n\n/* Layout */\n.app { display: flex; height: 100vh; }\n.sidebar { width: 240px; background: var(--surface); border-right: 1px solid var(--border); display: flex; flex-direction: column; flex-shrink: 0; }\n.main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }\n\n/* Sidebar */\n.brand { padding: 20px; border-bottom: 1px solid var(--border); }\n.brand h1 { font-size: 18px; font-weight: 700; }\n.brand span { color: var(--accent2); }\n.nav { padding: 12px 8px; flex: 1; }\n.nav-item { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: var(--radius); cursor: pointer; color: var(--text2); transition: all .15s; font-size: 14px; }\n.nav-item:hover { background: var(--surface2); color: var(--text); }\n.nav-item.active { background: rgba(108,92,231,.15); color: var(--accent2); }\n.nav-item .icon { width: 20px; text-align: center; font-size: 16px; }\n.sidebar-footer { padding: 16px 20px; border-top: 1px solid var(--border); font-size: 12px; color: var(--text2); }\n\n/* Header */\n.header { padding: 16px 28px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }\n.header h2 { font-size: 18px; font-weight: 600; }\n.header-actions { display: flex; gap: 10px; }\n\n/* Content */\n.content { flex: 1; overflow-y: auto; padding: 24px 28px; }\n\n/* Stats bar */\n.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin-bottom: 24px; }\n.stat-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; }\n.stat-card .label { font-size: 12px; color: var(--text2); margin-bottom: 6px; }\n.stat-card .value { font-size: 26px; font-weight: 700; }\n\n/* Agent cards */\n.agent-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }\n.agent-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px; transition: border-color .15s; }\n.agent-card:hover { border-color: var(--accent); }\n.agent-card .top { display: flex; justify-content: space-between; align-items: start; margin-bottom: 10px; }\n.agent-card .name { font-weight: 600; font-size: 15px; }\n.agent-card .dept { font-size: 12px; color: var(--text2); background: var(--surface2); padding: 2px 8px; border-radius: 4px; }\n.agent-card .desc { font-size: 13px; color: var(--text2); margin-bottom: 12px; line-height: 1.5; }\n.agent-card .bottom { display: flex; justify-content: space-between; align-items: center; }\n.status-badge { font-size: 12px; padding: 3px 10px; border-radius: 20px; font-weight: 500; }\n.status-badge.running { background: rgba(0,184,148,.15); color: var(--green); }\n.status-badge.idle { background: rgba(116,185,255,.12); color: var(--blue); }\n.status-badge.busy { background: rgba(253,203,110,.15); color: var(--yellow); }\n.status-badge.error { background: rgba(225,112,85,.15); color: var(--red); }\n\n/* Task table */\n.task-table { width: 100%; border-collapse: collapse; }\n.task-table th { text-align: left; padding: 10px 14px; font-size: 12px; color: var(--text2); border-bottom: 1px solid var(--border); text-transform: uppercase; letter-spacing: .5px; }\n.task-table td { padding: 12px 14px; font-size: 14px; border-bottom: 1px solid var(--border); }\n.task-table tr:hover td { background: var(--surface2); }\n.task-status { font-size: 12px; padding: 2px 8px; border-radius: 4px; }\n.task-status.done { background: rgba(0,184,148,.15); color: var(--green); }\n.task-status.pending { background: rgba(253,203,110,.15); color: var(--yellow); }\n.task-status.in_progress { background: rgba(108,92,231,.15); color: var(--accent2); }\n.task-status.blocked { background: rgba(225,112,85,.15); color: var(--red); }\n\n/* Button */\n.btn { padding: 8px 16px; border-radius: var(--radius); border: 1px solid var(--border); background: var(--surface2); color: var(--text); font-size: 13px; cursor: pointer; transition: all .15s; }\n.btn:hover { border-color: var(--accent); }\n.btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }\n.btn-primary:hover { background: var(--accent2); border-color: var(--accent2); }\n\n/* Modal */\n.modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.6); display: none; justify-content: center; align-items: center; z-index: 100; }\n.modal-overlay.show { display: flex; }\n.modal { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 28px; width: 480px; max-width: 90vw; }\n.modal h3 { margin-bottom: 20px; font-size: 17px; }\n.form-group { margin-bottom: 16px; }\n.form-group label { display: block; font-size: 13px; color: var(--text2); margin-bottom: 6px; }\n.form-group input, .form-group textarea, .form-group select { width: 100%; padding: 9px 12px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); font-size: 14px; outline: none; }\n.form-group input:focus, .form-group textarea:focus, .form-group select:focus { border-color: var(--accent); }\n.form-group textarea { min-height: 70px; resize: vertical; }\n.modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; }\n\n/* Page hidden */\n.page { display: none; }\n.page.active { display: block; }\n\n/* Logs */\n.log-toolbar { display: flex; gap: 10px; align-items: center; margin-bottom: 14px; flex-wrap: wrap; }\n.log-toolbar select, .log-toolbar input { padding: 7px 12px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); font-size: 13px; outline: none; }\n.log-toolbar select:focus, .log-toolbar input:focus { border-color: var(--accent); }\n.log-toolbar input { flex: 1; min-width: 180px; }\n.log-auto-scroll { font-size: 13px; color: var(--text2); display: flex; align-items: center; gap: 5px; cursor: pointer; }\n.log-auto-scroll input { accent-color: var(--accent); }\n.log-container { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); height: calc(100vh - 220px); overflow-y: auto; }\n.log-container pre { padding: 14px; font-family: \"Cascadia Code\", \"Fira Code\", \"Consolas\", monospace; font-size: 13px; line-height: 1.6; color: var(--text); margin: 0; white-space: pre-wrap; word-break: break-all; }\n.log-container .log-line { border-bottom: 1px solid var(--border); padding: 2px 0; }\n.log-container .log-line.highlight { background: rgba(108,92,231,.15); }\n.log-container .log-time { color: var(--text2); margin-right: 8px; }\n.log-container .log-agent-tag { color: var(--accent2); margin-right: 8px; font-size: 12px; }\n.log-connected { color: var(--green); font-size: 12px; }\n.log-disconnected { color: var(--red); font-size: 12px; }\n\n/* Control Panel */\n.ctrl-section { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 22px; margin-bottom: 20px; }\n.ctrl-title { font-size: 15px; font-weight: 600; margin-bottom: 16px; }\n.ctrl-status-card { margin-bottom: 18px; }\n.ctrl-status-row { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; font-size: 15px; font-weight: 600; }\n.ctrl-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--red); display: inline-block; }\n.ctrl-dot.running { background: var(--green); animation: pulse 1.5s infinite; }\n@keyframes pulse { 0%,100%{ opacity:1 } 50%{ opacity:.4 } }\n.ctrl-info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; }\n.ctrl-info { background: var(--bg); border-radius: 8px; padding: 10px 14px; }\n.ctrl-label { font-size: 11px; color: var(--text2); text-transform: uppercase; letter-spacing: .5px; }\n.ctrl-val { font-size: 17px; font-weight: 700; display: block; margin-top: 4px; }\n.ctrl-actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }\n.ctrl-start-group { display: flex; gap: 8px; align-items: center; }\n.ctrl-input { padding: 8px 12px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); font-size: 13px; outline: none; width: 180px; }\n.ctrl-input:focus { border-color: var(--accent); }\n.ctrl-dispatch-form { max-width: 500px; }\n\n/* Responsive */\n@media (max-width: 768px) {\n  .sidebar { width: 56px; }\n  .brand h1, .nav-item span, .sidebar-footer { display: none; }\n  .nav-item { justify-content: center; padding: 10px; }\n  .content { padding: 16px; }\n}\n</style>\n</head>\n<body>\n<div class=\"app\">\n  <aside class=\"sidebar\">\n    <div class=\"brand\"><h1><span>Loop</span>CLI</h1></div>\n    <nav class=\"nav\">\n      <div class=\"nav-item active\" data-page=\"dashboard\"><div class=\"icon\">📊</div><span>仪表盘</span></div>\n      <div class=\"nav-item\" data-page=\"agents\"><div class=\"icon\">🤖</div><span>Agent 列表</span></div>\n      <div class=\"nav-item\" data-page=\"tasks\"><div class=\"icon\">📋</div><span>任务管理</span></div>\n      <div class=\"nav-item\" data-page=\"logs\"><div class=\"icon\">📄</div><span>实时日志</span></div>\n      <div class=\"nav-item\" data-page=\"control\"><div class=\"icon\">⚙️</div><span>控制面板</span></div>\n    </nav>\n    <div class=\"sidebar-footer\">LoopCLI v0.1</div>\n  </aside>\n\n  <div class=\"main\">\n    <div class=\"header\">\n      <h2 id=\"pageTitle\">仪表盘</h2>\n      <div class=\"header-actions\">\n        <span id=\"log-status\"></span>\n        <button class=\"btn btn-primary\" id=\"newTaskBtn\">+ 新任务</button>\n      </div>\n    </div>\n\n    <div class=\"content\">\n      <!-- Dashboard -->\n      <div class=\"page active\" id=\"page-dashboard\">\n        <div class=\"stats\">\n          <div class=\"stat-card\"><div class=\"label\">Agent 总数</div><div class=\"value\" id=\"stat-agents\">-</div></div>\n          <div class=\"stat-card\"><div class=\"label\">运行中</div><div class=\"value\" style=\"color:var(--green)\" id=\"stat-running\">-</div></div>\n          <div class=\"stat-card\"><div class=\"label\">空闲</div><div class=\"value\" style=\"color:var(--blue)\" id=\"stat-idle\">-</div></div>\n          <div class=\"stat-card\"><div class=\"label\">待处理任务</div><div class=\"value\" style=\"color:var(--yellow)\" id=\"stat-pending\">-</div></div>\n        </div>\n        <h3 style=\"margin-bottom:14px;font-size:15px\">Agent 概览</h3>\n        <div class=\"agent-grid\" id=\"dash-agents\"></div>\n      </div>\n\n      <!-- Agents -->\n      <div class=\"page\" id=\"page-agents\">\n        <div class=\"agent-grid\" id=\"agent-list\"></div>\n      </div>\n\n      <!-- Tasks -->\n      <div class=\"page\" id=\"page-tasks\">\n        <table class=\"task-table\">\n          <thead><tr><th>ID</th><th>标题</th><th>状态</th><th>负责人</th><th>创建日期</th></tr></thead>\n          <tbody id=\"task-list\"></tbody>\n        </table>\n      </div>\n\n      <!-- Logs -->\n      <div class=\"page\" id=\"page-logs\">\n        <div class=\"log-toolbar\">\n          <select id=\"log-agent-filter\"><option value=\"\">All Agents</option></select>\n          <input id=\"log-search\" placeholder=\"搜索日志...\" />\n          <button class=\"btn\" id=\"log-clear-btn\">清空显示</button>\n          <label class=\"log-auto-scroll\"><input type=\"checkbox\" id=\"log-autoscroll\" checked /> 自动滚动</label>\n        </div>\n        <div class=\"log-container\" id=\"log-container\"><pre id=\"log-output\"></pre></div>\n      </div>\n\n      <!-- Control Panel -->\n      <div class=\"page\" id=\"page-control\">\n        <div class=\"ctrl-section\">\n          <h3 class=\"ctrl-title\">Loop 进程控制</h3>\n          <div class=\"ctrl-status-card\">\n            <div class=\"ctrl-status-row\">\n              <span class=\"ctrl-dot\" id=\"ctrl-dot\"></span>\n              <span id=\"ctrl-status-text\">已停止</span>\n            </div>\n            <div class=\"ctrl-info-grid\">\n              <div class=\"ctrl-info\"><span class=\"ctrl-label\">PID</span><span class=\"ctrl-val\" id=\"ctrl-pid\">-</span></div>\n              <div class=\"ctrl-info\"><span class=\"ctrl-label\">运行时长</span><span class=\"ctrl-val\" id=\"ctrl-uptime\">-</span></div>\n              <div class=\"ctrl-info\"><span class=\"ctrl-label\">迭代次数</span><span class=\"ctrl-val\" id=\"ctrl-iterations\">-</span></div>\n              <div class=\"ctrl-info\"><span class=\"ctrl-label\">启动时间</span><span class=\"ctrl-val\" id=\"ctrl-started\">-</span></div>\n            </div>\n          </div>\n          <div class=\"ctrl-actions\">\n            <div class=\"ctrl-start-group\">\n              <input type=\"number\" id=\"ctrl-iter-input\" placeholder=\"迭代次数 (0=无限)\" min=\"0\" value=\"0\" class=\"ctrl-input\" />\n              <button class=\"btn btn-primary\" id=\"ctrl-start-btn\">启动 Loop</button>\n            </div>\n            <button class=\"btn\" id=\"ctrl-stop-btn\">停止</button>\n            <button class=\"btn\" id=\"ctrl-restart-btn\">重启</button>\n          </div>\n        </div>\n\n        <div class=\"ctrl-section\">\n          <h3 class=\"ctrl-title\">一键派发任务</h3>\n          <div class=\"ctrl-dispatch-form\">\n            <div class=\"form-group\"><label>目标 Agent</label>\n              <select id=\"d-agent\"><option value=\"\">-- 选择 Agent --</option></select>\n            </div>\n            <div class=\"form-group\"><label>任务标题</label><input id=\"d-title\" placeholder=\"输入任务标题\"></div>\n            <div class=\"form-group\"><label>任务描述</label><textarea id=\"d-desc\" placeholder=\"描述任务内容\"></textarea></div>\n            <button class=\"btn btn-primary\" id=\"d-submit\">派发并执行</button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- New Task Modal -->\n<div class=\"modal-overlay\" id=\"modal\">\n  <div class=\"modal\">\n    <h3>创建新任务</h3>\n    <div class=\"form-group\"><label>任务标题</label><input id=\"f-title\" placeholder=\"输入任务标题\"></div>\n    <div class=\"form-group\"><label>任务描述</label><textarea id=\"f-desc\" placeholder=\"描述任务内容\"></textarea></div>\n    <div class=\"form-group\"><label>指派 Agent</label>\n      <select id=\"f-agent\"><option value=\"\">-- 未指派 --</option></select>\n    </div>\n    <div class=\"modal-actions\">\n      <button class=\"btn\" id=\"modalCancel\">取消</button>\n      <button class=\"btn btn-primary\" id=\"modalSubmit\">创建</button>\n    </div>\n  </div>\n</div>\n\n<script>\nlet agents = [];\nlet tasks = [];\n\nasync function loadAgents() {\n  try {\n    const r = await fetch('/api/agents');\n    agents = await r.json();\n  } catch { agents = []; }\n}\n\nasync function loadTasks() {\n  try {\n    const r = await fetch('/api/tasks');\n    tasks = await r.json();\n  } catch { tasks = []; }\n}\n\nasync function loadData() {\n  await Promise.all([loadAgents(), loadTasks()]);\n  render();\n}\n\nfunction render() {\n  renderStats();\n  renderAgentCards('dash-agents', agents);\n  renderAgentCards('agent-list', agents);\n  renderTasks();\n  fillAgentSelect();\n}\n\nfunction renderStats() {\n  document.getElementById('stat-agents').textContent = agents.length;\n  document.getElementById('stat-running').textContent = agents.filter(a => a.status === 'running').length;\n  document.getElementById('stat-idle').textContent = agents.filter(a => a.status === 'idle').length;\n  document.getElementById('stat-pending').textContent = tasks.filter(t => t.status === 'pending').length;\n}\n\nfunction fmtTime(iso) {\n  if (!iso) return '-';\n  try {\n    const d = new Date(iso);\n    return d.toLocaleString('zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });\n  } catch { return iso; }\n}\n\nfunction renderAgentCards(containerId, list) {\n  const c = document.getElementById(containerId);\n  c.innerHTML = list.map(a => `\n    <div class=\"agent-card\">\n      <div class=\"top\">\n        <div class=\"name\">${esc(a.name)}</div>\n        <span class=\"status-badge ${a.status}\">${statusLabel(a.status)}</span>\n      </div>\n      <div class=\"desc\">${esc(a.description)}</div>\n      <div class=\"bottom\">\n        <span style=\"font-size:12px;color:var(--text2)\">最后运行: ${fmtTime(a.last_run)}</span>\n        <span style=\"font-size:12px;color:var(--text2)\">轮次: ${a.run_count ?? 0}</span>\n      </div>\n    </div>\n  `).join('');\n}\n\nfunction renderTasks() {\n  const tbody = document.getElementById('task-list');\n  tbody.innerHTML = tasks.map(t => `\n    <tr>\n      <td>#${t.id}</td>\n      <td>${esc(t.title)}</td>\n      <td><span class=\"task-status ${t.status}\">${statusLabel(t.status)}</span></td>\n      <td>${t.assignee ? esc(t.assignee) : '<span style=\"color:var(--text2)\">未指派</span>'}</td>\n      <td style=\"color:var(--text2)\">${t.created}</td>\n    </tr>\n  `).join('');\n}\n\nfunction fillAgentSelect() {\n  const sel = document.getElementById('f-agent');\n  sel.innerHTML = '<option value=\"\">-- 未指派 --</option>' +\n    agents.map(a => `<option value=\"${esc(a.id)}\">${esc(a.name)}</option>`).join('');\n}\n\n// Navigation\ndocument.querySelectorAll('.nav-item').forEach(item => {\n  item.addEventListener('click', () => {\n    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));\n    item.classList.add('active');\n    const page = item.dataset.page;\n    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));\n    document.getElementById('page-' + page).classList.add('active');\n    const titles = { dashboard: '仪表盘', agents: 'Agent 列表', tasks: '任务管理', logs: '实时日志', control: '控制面板' };\n    document.getElementById('pageTitle').textContent = titles[page];\n    if (page === 'logs') { initLogStream(); } else { closeLogStream(); }\n  });\n});\n\n// Modal\nconst modal = document.getElementById('modal');\ndocument.getElementById('newTaskBtn').addEventListener('click', () => modal.classList.add('show'));\ndocument.getElementById('modalCancel').addEventListener('click', () => modal.classList.remove('show'));\nmodal.addEventListener('click', e => { if (e.target === modal) modal.classList.remove('show'); });\n\ndocument.getElementById('modalSubmit').addEventListener('click', async () => {\n  const title = document.getElementById('f-title').value.trim();\n  const desc = document.getElementById('f-desc').value.trim();\n  const agent = document.getElementById('f-agent').value;\n  if (!title) return;\n  try {\n    await fetch('/api/tasks', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ title, description: desc, assignee: agent || undefined })\n    });\n  } catch { /* fallback: will reload anyway */ }\n  modal.classList.remove('show');\n  document.getElementById('f-title').value = '';\n  document.getElementById('f-desc').value = '';\n  document.getElementById('f-agent').value = '';\n  await loadData();\n});\n\nfunction statusLabel(s) {\n  return { running: '运行中', idle: '空闲', busy: '忙碌', error: '异常', done: '已完成', pending: '待处理', in_progress: '进行中', blocked: '已阻塞' }[s] || s;\n}\nfunction esc(s) { const d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; }\n\n// --- Log SSE Stream ---\nlet logEventSource = null;\nlet logLines = [];\nconst MAX_LOG_LINES = 2000;\n\nfunction initLogStream() {\n  if (logEventSource) return;\n  const agent = document.getElementById('log-agent-filter').value;\n  const url = '/api/logs/stream' + (agent ? '?agent=' + encodeURIComponent(agent) : '');\n  logEventSource = new EventSource(url);\n  const statusEl = null; // could add a connection indicator\n  logEventSource.onmessage = function(e) {\n    try {\n      const data = JSON.parse(e.data);\n      const newLines = data.lines || [];\n      const agentTag = data.agent || 'main';\n      // Only update if content changed\n      const joined = newLines.join('\\n');\n      if (logLines.map(l => l.text).join('\\n') !== joined) {\n        logLines = newLines.map(l => ({ text: l, agent: agentTag }));\n        if (logLines.length > MAX_LOG_LINES) logLines = logLines.slice(-MAX_LOG_LINES);\n        renderLogOutput();\n      }\n    } catch {}\n  };\n  logEventSource.onerror = function() {\n    if (logEventSource) { logEventSource.close(); logEventSource = null; }\n  };\n}\n\nfunction closeLogStream() {\n  if (logEventSource) { logEventSource.close(); logEventSource = null; }\n}\n\nfunction renderLogOutput() {\n  const pre = document.getElementById('log-output');\n  const container = document.getElementById('log-container');\n  const search = document.getElementById('log-search').value.toLowerCase();\n  const autoScroll = document.getElementById('log-autoscroll').checked;\n\n  const html = logLines.map(l => {\n    const text = esc(l.text);\n    const match = !search || l.text.toLowerCase().includes(search);\n    const hl = search && match ? ' highlight' : '';\n    const agentTag = l.agent ? `<span class=\"log-agent-tag\">[${esc(l.agent)}]</span>` : '';\n    return match ? `<div class=\"log-line${hl}\">${agentTag}${text}</div>` : '';\n  }).join('');\n  pre.innerHTML = html || '<div style=\"color:var(--text2)\">暂无日志</div>';\n\n  if (autoScroll) container.scrollTop = container.scrollHeight;\n}\n\ndocument.getElementById('log-agent-filter').addEventListener('change', function() {\n  logLines = [];\n  closeLogStream();\n  initLogStream();\n});\n\ndocument.getElementById('log-search').addEventListener('input', renderLogOutput);\ndocument.getElementById('log-clear-btn').addEventListener('click', function() {\n  logLines = [];\n  renderLogOutput();\n});\n\nfunction fillLogAgentFilter() {\n  const sel = document.getElementById('log-agent-filter');\n  const cur = sel.value;\n  sel.innerHTML = '<option value=\"\">All Agents</option>' +\n    '<option value=\"\">main</option>' +\n    agents.map(a => `<option value=\"${esc(a.id)}\">${esc(a.name)}</option>`).join('');\n  sel.value = cur;\n}\n\n// Patch render to also update log filter\nconst _origRender = render;\nrender = function() {\n  _origRender();\n  fillLogAgentFilter();\n};\n\nloadData();\nsetInterval(loadData, 10000);\n\n// --- Control Panel ---\nfunction fmtDuration(sec) {\n  if (!sec || sec < 0) return '-';\n  const h = Math.floor(sec / 3600);\n  const m = Math.floor((sec % 3600) / 60);\n  const s = sec % 60;\n  return h > 0 ? `${h}h ${String(m).padStart(2,'0')}m ${String(s).padStart(2,'0')}s` : `${m}m ${String(s).padStart(2,'0')}s`;\n}\n\nasync function loadLoopStatus() {\n  try {\n    const r = await fetch('/api/loopcli/status');\n    const st = await r.json();\n    const dot = document.getElementById('ctrl-dot');\n    const txt = document.getElementById('ctrl-status-text');\n    if (st.status === 'running') {\n      dot.className = 'ctrl-dot running';\n      txt.textContent = '运行中';\n      txt.style.color = 'var(--green)';\n    } else {\n      dot.className = 'ctrl-dot';\n      txt.textContent = '已停止';\n      txt.style.color = 'var(--text2)';\n    }\n    document.getElementById('ctrl-pid').textContent = st.pid || '-';\n    document.getElementById('ctrl-uptime').textContent = fmtDuration(st.uptime_seconds);\n    document.getElementById('ctrl-iterations').textContent = st.iterations > 0 ? st.iterations : '∞';\n    document.getElementById('ctrl-started').textContent = st.started_at ? new Date(st.started_at).toLocaleString('zh-CN') : '-';\n  } catch {}\n}\n\ndocument.getElementById('ctrl-start-btn').addEventListener('click', async () => {\n  const n = parseInt(document.getElementById('ctrl-iter-input').value) || 0;\n  await fetch('/api/loopcli/start', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({iterations: n}) });\n  setTimeout(loadLoopStatus, 500);\n});\n\ndocument.getElementById('ctrl-stop-btn').addEventListener('click', async () => {\n  await fetch('/api/loopcli/stop', { method: 'POST' });\n  setTimeout(loadLoopStatus, 500);\n});\n\ndocument.getElementById('ctrl-restart-btn').addEventListener('click', async () => {\n  const n = parseInt(document.getElementById('ctrl-iter-input').value) || 0;\n  await fetch('/api/loopcli/restart', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({iterations: n}) });\n  setTimeout(loadLoopStatus, 500);\n});\n\n// Dispatch\nfunction fillDispatchAgentSelect() {\n  const sel = document.getElementById('d-agent');\n  const cur = sel.value;\n  sel.innerHTML = '<option value=\"\">-- 选择 Agent --</option>' +\n    agents.map(a => `<option value=\"${esc(a.id)}\">${esc(a.name)}</option>`).join('');\n  sel.value = cur;\n}\n\ndocument.getElementById('d-submit').addEventListener('click', async () => {\n  const agent = document.getElementById('d-agent').value;\n  const title = document.getElementById('d-title').value.trim();\n  const desc = document.getElementById('d-desc').value.trim();\n  if (!agent || !title) return;\n  await fetch('/api/loopcli/dispatch', {\n    method: 'POST',\n    headers: {'Content-Type':'application/json'},\n    body: JSON.stringify({agent, title, description: desc}),\n  });\n  document.getElementById('d-title').value = '';\n  document.getElementById('d-desc').value = '';\n  await loadData();\n});\n\n// Patch render to also update control panel\nconst _origRender2 = render;\nrender = function() {\n  _origRender2();\n  fillDispatchAgentSelect();\n};\n\nloadLoopStatus();\nsetInterval(loadLoopStatus, 3000);\n</script>\n</body>\n</html>\n","numLines":550,"startLine":1,"totalLines":550}}}
