{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_80c99a24e4ec496c8ee0128f","type":"tool_result","content":"1\timport argparse\n2\timport json\n3\timport msvcrt\n4\timport os\n5\timport shutil\n6\timport subprocess\n7\timport sys\n8\timport threading\n9\timport time\n10\tfrom datetime import datetime\n11\t\n12\tLOOPCLI_DIR = r\"D:\\loopcli\"\n13\tSUBAGENT_DIR = os.path.join(LOOPCLI_DIR, \"subagent\")\n14\tCLAUDE = os.path.join(os.environ.get(\"APPDATA\", \"\"), \"npm\", \"claude.cmd\")\n15\t\n16\tAGENT_MARKER = \"AGENT\"\n17\tLOGS_DIR = os.path.join(LOOPCLI_DIR, \"logs\")\n18\tGIT_TOKEN_FILE = os.path.join(LOOPCLI_DIR, \".gittoken\")\n19\tDEFAULT_PROMPT = \"\"\"读取 SOUL.md 作为你的身份。\n20\t读取 D:/loopcli/skill/ 下所有技能文件（全局技能）。\n21\t读取 memory/tasks.json 获取分配给你的任务。\n22\t\n23\t执行步骤：\n24\t1. 从 tasks.json 中找 status 为 \"pending\" 的第一个任务\n25\t2. 执行该任务\n26\t3. 将结果写入 memory/results/ 目录（以时间戳命名）\n27\t4. 将该任务 status 改为 \"done\"，写回 tasks.json\n28\t5. 更新 memory/state.json（标记完成、记录时间戳）\n29\t6. 将本次运行摘要追加到 log/run.md\n30\t7. 通过 inbox 通知 main：写入 D:/loopcli/main/inbox/<你的名字>_<时间>.md，简要报告任务结果\n31\t8. 如果没有 pending 任务，输出 \"IDLE\" 并结束本轮\n32\t\"\"\"\n33\t\n34\t\n35\t# ─── 工具函数 ───\n36\t\n37\tdef get_agent_marker(path):\n38\t    \"\"\"读取 AGENT 标记文件内容\"\"\"\n39\t    marker = os.path.join(path, AGENT_MARKER)\n40\t    if os.path.isfile(marker):\n41\t        with open(marker, \"r\", encoding=\"utf-8\") as f:\n42\t            return f.read().strip()\n43\t    return None\n44\t\n45\t\n46\tdef is_agent_enabled(path):\n47\t    \"\"\"检查 Agent 是否启用（AGENT 文件不含 disabled 标记）\"\"\"\n48\t    content = get_agent_marker(path)\n49\t    if content is None:\n50\t        return False\n51\t    return \"disabled\" not in content\n52\t\n53\t\n54\tdef discover_agents(include_disabled=False):\n55\t    agents = []\n56\t    for name in os.listdir(LOOPCLI_DIR):\n57\t        path = os.path.join(LOOPCLI_DIR, name)\n58\t        marker = os.path.join(path, AGENT_MARKER)\n59\t        if os.path.isdir(path) and os.path.isfile(marker):\n60\t            if include_disabled or is_agent_enabled(path):\n61\t                agents.append({\"name\": name, \"path\": path})\n62\t    return agents\n63\t\n64\t\n65\tdef find_template(template_id):\n66\t    \"\"\"在 subagent 目录下搜索模板文件\"\"\"\n67\t    for dept in os.listdir(SUBAGENT_DIR):\n68\t        dept_dir = os.path.join(SUBAGENT_DIR, dept)\n69\t        if not os.path.isdir(dept_dir):\n70\t            continue\n71\t        candidate = os.path.join(dept_dir, f\"{template_id}.md\")\n72\t        if os.path.isfile(candidate):\n73\t            return candidate\n74\t    return None\n75\t\n76\t\n77\tdef load_agent_state(agent_path):\n78\t    state_file = os.path.join(agent_path, \"memory\", \"state.json\")\n79\t    if os.path.isfile(state_file):\n80\t        with open(state_file, \"r\", encoding=\"utf-8\") as f:\n81\t            return json.load(f)\n82\t    return None\n83\t\n84\t\n85\tdef load_agent_tasks(agent_path):\n86\t    tasks_file = os.path.join(agent_path, \"memory\", \"tasks.json\")\n87\t    if os.path.isfile(tasks_file):\n88\t        with open(tasks_file, \"r\", encoding=\"utf-8\") as f:\n89\t            return json.load(f)\n90\t    return []\n91\t\n92\t\n93\tdef rotate_log(log_path, max_size=1_000_000, max_backups=3):\n94\t    \"\"\"轮转日志文件：超过 max_size 时依次重命名为 .1 .2 .3，最多保留 max_backups 个归档\"\"\"\n95\t    if not os.path.isfile(log_path):\n96\t        return\n97\t    try:\n98\t        if os.path.getsize(log_path) < max_size:\n99\t            return\n100\t    except OSError:\n101\t        return\n102\t    # 删除最老的归档\n103\t    oldest = f\"{log_path}.{max_backups}\"\n104\t    if os.path.isfile(oldest):\n105\t        os.remove(oldest)\n106\t    # 依次重命名 .2->.3, .1->.2\n107\t    for i in range(max_backups, 1, -1):\n108\t        src = f\"{log_path}.{i - 1}\"\n109\t        dst = f\"{log_path}.{i}\"\n110\t        if os.path.isfile(src):\n111\t            os.rename(src, dst)\n112\t    # 当前日志 -> .1\n113\t    os.rename(log_path, f\"{log_path}.1\")\n114\t\n115\t\n116\t# ─── 子命令: create ───\n117\t\n118\tdef cmd_create(args):\n119\t    template_id = args.template\n120\t    task_desc = args.task or \"\"\n121\t\n122\t    tpl_file = find_template(template_id)\n123\t    if not tpl_file:\n124\t        print(f\"[错误] 找不到模板: {template_id}\")\n125\t        print(\"用 loopcli templates 查看所有可用模板\")\n126\t        sys.exit(1)\n127\t\n128\t    with open(tpl_file, \"r\", encoding=\"utf-8\") as f:\n129\t        soul_content = f.read()\n130\t\n131\t    agent_dir = os.path.join(LOOPCLI_DIR, template_id)\n132\t    if os.path.exists(agent_dir):\n133\t        print(f\"[跳过] Agent 已存在: {agent_dir}\")\n134\t        if task_desc:\n135\t            cmd_task_inner(template_id, task_desc, \"\")\n136\t        return\n137\t\n138\t    # 创建目录结构\n139\t    os.makedirs(os.path.join(agent_dir, \"memory\", \"results\"), exist_ok=True)\n140\t    os.makedirs(os.path.join(agent_dir, \"log\"), exist_ok=True)\n141\t\n142\t    # AGENT 标记\n143\t    with open(os.path.join(agent_dir, AGENT_MARKER), \"w\", encoding=\"utf-8\") as f:\n144\t        f.write(\"type: main\\n\")\n145\t\n146\t    # SOUL.md（模板内容）\n147\t    with open(os.path.join(agent_dir, \"SOUL.md\"), \"w\", encoding=\"utf-8\") as f:\n148\t        f.write(soul_content)\n149\t\n150\t    # PROMPT.md\n151\t    with open(os.path.join(agent_dir, \"PROMPT.md\"), \"w\", encoding=\"utf-8\") as f:\n152\t        f.write(DEFAULT_PROMPT)\n153\t\n154\t    # state.json\n155\t    state = {\"agent\": template_id, \"status\": \"idle\", \"current_task\": None, \"last_run\": None, \"run_count\": 0, \"created\": datetime.now().strftime(\"%Y-%m-%d\")}\n156\t    with open(os.path.join(agent_dir, \"memory\", \"state.json\"), \"w\", encoding=\"utf-8\") as f:\n157\t        json.dump(state, f, indent=2, ensure_ascii=False)\n158\t\n159\t    # tasks.json\n160\t    tasks = []\n161\t    if task_desc:\n162\t        tasks.append({\"id\": 1, \"status\": \"pending\", \"title\": task_desc, \"description\": task_desc, \"created\": datetime.now().strftime(\"%Y-%m-%d\"), \"assignee\": template_id})\n163\t    with open(os.path.join(agent_dir, \"memory\", \"tasks.json\"), \"w\", encoding=\"utf-8\") as f:\n164\t        json.dump(tasks, f, indent=2, ensure_ascii=False)\n165\t\n166\t    # run.md\n167\t    with open(os.path.join(agent_dir, \"log\", \"run.md\"), \"w\", encoding=\"utf-8\") as f:\n168\t        f.write(\"# 运行日志\\n\\n| 时间 | 状态 | 任务 | 摘要 |\\n|------|------|------|------|\\n\")\n169\t\n170\t    print(f\"[创建成功] {template_id}\")\n171\t    print(f\"  目录: {agent_dir}\")\n172\t    if task_desc:\n173\t        print(f\"  任务: {task_desc}\")\n174\t    print(f\"  下一轮 loopcli 将自动启动该 Agent\")\n175\t\n176\t\n177\t# ─── 子命令: task ───\n178\t\n179\tdef cmd_task_inner(agent_name, title, desc):\n180\t    agent_dir = os.path.join(LOOPCLI_DIR, agent_name)\n181\t    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n182\t        print(f\"[错误] 不是有效的 Agent: {agent_name}\")\n183\t        sys.exit(1)\n184\t\n185\t    tasks_file = os.path.join(agent_dir, \"memory\", \"tasks.json\")\n186\t    tasks = load_agent_tasks(agent_dir)\n187\t    next_id = max((t[\"id\"] for t in tasks), default=0) + 1\n188\t    tasks.append({\n189\t        \"id\": next_id,\n190\t        \"status\": \"pending\",\n191\t        \"title\": title,\n192\t        \"description\": desc or title,\n193\t        \"created\": datetime.now().strftime(\"%Y-%m-%d\"),\n194\t        \"assignee\": agent_name\n195\t    })\n196\t    with open(tasks_file, \"w\", encoding=\"utf-8\") as f:\n197\t        json.dump(tasks, f, indent=2, ensure_ascii=False)\n198\t    print(f\"[派发成功] {agent_name} <- #{next_id} {title}\")\n199\t\n200\t\n201\tdef cmd_task(args):\n202\t    cmd_task_inner(args.agent, args.title, args.desc)\n203\t\n204\t\n205\t# ─── 子命令: list ───\n206\t\n207\tdef cmd_list(args):\n208\t    agents = discover_agents(include_disabled=True)\n209\t    if not agents:\n210\t        print(\"没有发现任何 Agent\")\n211\t        return\n212\t    print(f\"{'Agent':<45} {'启用':<6} {'状态':<10} {'任务数':<8} {'最后运行'}\")\n213\t    print(\"-\" * 95)\n214\t    for a in agents:\n215\t        enabled = \"是\" if is_agent_enabled(a[\"path\"]) else \"否\"\n216\t        state = load_agent_state(a[\"path\"]) or {}\n217\t        tasks = load_agent_tasks(a[\"path\"])\n218\t        pending = len([t for t in tasks if t.get(\"status\") == \"pending\"])\n219\t        status = state.get(\"status\", \"?\")\n220\t        last_run = state.get(\"last_run\", \"-\")\n221\t        print(f\"{a['name']:<45} {enabled:<6} {status:<10} {pending:<8} {last_run}\")\n222\t\n223\t\n224\t# ─── 子命令: templates ───\n225\t\n226\tdef cmd_templates(args):\n227\t    found = []\n228\t    for dept in sorted(os.listdir(SUBAGENT_DIR)):\n229\t        dept_dir = os.path.join(SUBAGENT_DIR, dept)\n230\t        if not os.path.isdir(dept_dir):\n231\t            continue\n232\t        for fname in sorted(os.listdir(dept_dir)):\n233\t            if fname.endswith(\".md\"):\n234\t                found.append(fname[:-3])\n235\t    if args.filter:\n236\t        found = [t for t in found if args.filter.lower() in t.lower()]\n237\t    print(f\"共 {len(found)} 个模板:\")\n238\t    for t in found:\n239\t        print(f\"  {t}\")\n240\t\n241\t\n242\t# ─── 子命令: run（主循环）───\n243\t\n244\tdef handle_event(agent_name, line):\n245\t    line = line.strip()\n246\t    if not line:\n247\t        return\n248\t    try:\n249\t        event = json.loads(line)\n250\t    except json.JSONDecodeError:\n251\t        print(f\"[{agent_name}] {line}\", flush=True)\n252\t        return\n253\t\n254\t    event_type = event.get(\"type\", \"\")\n255\t\n256\t    if event_type == \"assistant\":\n257\t        msg = event.get(\"message\", {})\n258\t        for block in msg.get(\"content\", []):\n259\t            if block.get(\"type\") == \"text\":\n260\t                text = block.get(\"text\", \"\")\n261\t                if text:\n262\t                    print(f\"[{agent_name}] {text}\", flush=True)\n263\t            elif block.get(\"type\") == \"tool_use\":\n264\t                name = block.get(\"name\", \"\")\n265\t                inp = block.get(\"input\", {})\n266\t                detail = \"\"\n267\t                for k in (\"file_path\", \"command\", \"pattern\"):\n268\t                    if k in inp:\n269\t                        detail = inp[k]\n270\t                        break\n271\t                print(f\"[{agent_name}] ● {name}({detail})\", flush=True)\n272\t\n273\t    elif event_type == \"tool_result\":\n274\t        content = event.get(\"content\", \"\")\n275\t        texts = []\n276\t        if isinstance(content, list):\n277\t            texts = [b.get(\"text\", \"\") for b in content if b.get(\"text\")]\n278\t        elif isinstance(content, str):\n279\t            texts = [content]\n280\t        for text in texts:\n281\t            print(f\"[{agent_name}]   ↳ {text[:200]}\", flush=True)\n282\t\n283\t    elif event_type == \"result\":\n284\t        text = event.get(\"result\", \"\")\n285\t        if text:\n286\t            print(f\"[{agent_name}] [结果] {text[:500]}\", flush=True)\n287\t        cost = event.get(\"cost_usd\", \"\")\n288\t        duration = event.get(\"duration_ms\", \"\")\n289\t        if cost or duration:\n290\t            print(f\"[{agent_name}] [统计] 耗时: {duration}ms, 费用: ${cost}\", flush=True)\n291\t\n292\t    elif event_type == \"error\":\n293\t        print(f\"[{agent_name}] [错误] {event.get('error', '')}\", flush=True)\n294\t\n295\t\n296\tdef run_agent(agent, iteration, run_log_dir):\n297\t    name = agent[\"name\"]\n298\t    path = agent[\"path\"]\n299\t    prompt_file = os.path.join(path, \"PROMPT.md\")\n300\t    log_file_path = os.path.join(path, \"log\", \"raw.log\")\n301\t    run_agent_log = os.path.join(run_log_dir, f\"{name}.log\")\n302\t    ts = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n303\t\n304\t    if not os.path.isfile(prompt_file):\n305\t        print(f\"[{name}] 没有 PROMPT.md，跳过\", flush=True)\n306\t        return\n307\t\n308\t    with open(prompt_file, \"r\", encoding=\"utf-8\") as f:\n309\t        prompt = f.read()\n310\t\n311\t    os.makedirs(os.path.join(path, \"log\"), exist_ok=True)\n312\t    rotate_log(log_file_path)\n313\t    log_file = open(log_file_path, \"a\", encoding=\"utf-8\")\n314\t    agent_log = open(run_agent_log, \"a\", encoding=\"utf-8\")\n315\t\n316\t    try:\n317\t        header = f\"\\n[{ts}] --- 开始 (第{iteration}轮) ---\\n\"\n318\t        log_file.write(header)\n319\t        agent_log.write(header)\n320\t        log_file.flush()\n321\t        agent_log.flush()\n322\t\n323\t        env = {**os.environ, \"IS_SANDBOX\": \"1\"}\n324\t\n325\t        proc = subprocess.Popen(\n326\t            [CLAUDE, \"--print\", \"--verbose\", \"--output-format\", \"stream-json\", \"--dangerously-skip-permissions\"],\n327\t            stdin=subprocess.PIPE,\n328\t            stdout=subprocess.PIPE,\n329\t            stderr=subprocess.PIPE,\n330\t            env=env,\n331\t            cwd=path,\n332\t        )\n333\t\n334\t        proc.stdin.write(prompt.encode(\"utf-8\"))\n335\t        proc.stdin.close()\n336\t\n337\t        for line in proc.stdout:\n338\t            decoded = line.decode(\"utf-8\", errors=\"replace\")\n339\t            log_file.write(decoded)\n340\t            agent_log.write(decoded)\n341\t            log_file.flush()\n342\t            agent_log.flush()\n343\t            handle_event(name, decoded)\n344\t\n345\t        stderr_output = proc.stderr.read().decode(\"utf-8\", errors=\"replace\")\n346\t        if stderr_output:\n347\t            print(f\"[{name}] [STDERR] {stderr_output}\", flush=True)\n348\t            log_file.write(stderr_output)\n349\t            agent_log.write(stderr_output)\n350\t\n351\t        proc.wait()\n352\t\n353\t        footer = f\"\\n[{ts}] --- 结束 (exit={proc.returncode}) ---\\n\"\n354\t        log_file.write(footer)\n355\t        agent_log.write(footer)\n356\t    finally:\n357\t        log_file.close()\n358\t        agent_log.close()\n359\t\n360\t    # 更新 state.json (with file lock)\n361\t    state_file = os.path.join(path, \"memory\", \"state.json\")\n362\t    with open(state_file, \"a+\") as f:\n363\t        msvcrt.locking(f.fileno(), msvcrt.LK_LOCK, 1)\n364\t        try:\n365\t            f.seek(0)\n366\t            try:\n367\t                state = json.load(f)\n368\t            except (json.JSONDecodeError, ValueError):\n369\t                state = {}\n370\t            state[\"status\"] = \"idle\"\n371\t            state[\"last_run\"] = ts\n372\t            state[\"run_count\"] = state.get(\"run_count\", 0) + 1\n373\t            f.seek(0)\n374\t            f.truncate()\n375\t            json.dump(state, f, indent=2, ensure_ascii=False)\n376\t        finally:\n377\t            msvcrt.locking(f.fileno(), msvcrt.LK_UNLCK, 1)\n378\t\n379\t    status = \"完成\" if proc.returncode == 0 else f\"异常(exit={proc.returncode})\"\n380\t    print(f\"[{name}] 本轮{status}\", flush=True)\n381\t\n382\t\n383\tdef git_push():\n384\t    \"\"\"自动 commit 和 push 到 GitHub\"\"\"\n385\t    token_file = GIT_TOKEN_FILE\n386\t    if not os.path.isfile(token_file):\n387\t        return\n388\t    with open(token_file, \"r\") as f:\n389\t        token = f.read().strip()\n390\t    if not token:\n391\t        return\n392\t    try:\n393\t        git = resolve_git()\n394\t        subprocess.run([git, \"add\", \"memory/\", \"log/\", \"inbox/\"], cwd=LOOPCLI_DIR, capture_output=True, timeout=30)\n395\t        subprocess.run(\n396\t            [git, \"commit\", \"-m\", f\"auto: loopcli sync {datetime.now().strftime('%Y-%m-%d %H:%M')}\"],\n397\t            cwd=LOOPCLI_DIR, capture_output=True, timeout=30\n398\t        )\n399\t        # Use GIT_ASKPASS to avoid exposing token in command line\n400\t        askpass_script = os.path.join(LOOPCLI_DIR, \".git_askpass.bat\")\n401\t        with open(askpass_script, \"w\") as f:\n402\t            f.write(\"@echo %GH_TOKEN%\\n\")\n403\t        push_env = {\n404\t            **os.environ,\n405\t            \"GH_TOKEN\": token,\n406\t            \"GIT_ASKPASS\": askpass_script,\n407\t            \"GIT_TERMINAL_PROMPT\": \"0\",\n408\t        }\n409\t        subprocess.run(\n410\t            [git, \"push\", \"https://x-access-token@github.com/zhoudingnuo/loopcli.git\", \"main\"],\n411\t            cwd=LOOPCLI_DIR, capture_output=True, timeout=60, env=push_env,\n412\t        )\n413\t        os.remove(askpass_script)\n414\t        print(\"[git] 已同步到 GitHub\", flush=True)\n415\t    except Exception as e:\n416\t        print(f\"[git] 同步失败: {e}\", flush=True)\n417\t\n418\t\n419\tdef resolve_git():\n420\t    \"\"\"找到 git.exe 的完整路径\"\"\"\n421\t    for p in os.environ.get(\"PATH\", \"\").split(\";\"):\n422\t        candidate = os.path.join(p, \"git.exe\")\n423\t        if os.path.isfile(candidate):\n424\t            return candidate\n425\t    # 常见安装路径\n426\t    for d in [r\"C:\\Program Files\\Git\\cmd\", r\"C:\\Program Files\\Git\\bin\"]:\n427\t        candidate = os.path.join(d, \"git.exe\")\n428\t        if os.path.isfile(candidate):\n429\t            return candidate\n430\t    return \"git\"\n431\t\n432\t\n433\tdef cmd_run(args):\n434\t    agents = discover_agents()\n435\t    if not agents:\n436\t        print(\"未发现任何 Agent（需要目录下有 AGENT 标记文件）\")\n437\t        sys.exit(1)\n438\t\n439\t    # 创建本次运行日志目录\n440\t    run_id = datetime.now().strftime(\"run_%Y%m%d_%H%M%S\")\n441\t    run_log_dir = os.path.join(LOGS_DIR, run_id)\n442\t    os.makedirs(run_log_dir, exist_ok=True)\n443\t\n444\t    # 写入运行元信息\n445\t    meta = {\n446\t        \"run_id\": run_id,\n447\t        \"started\": datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"),\n448\t        \"iterations\": args.iterations or \"无限\",\n449\t        \"agents\": [a[\"name\"] for a in agents],\n450\t    }\n451\t    with open(os.path.join(run_log_dir, \"meta.json\"), \"w\", encoding=\"utf-8\") as f:\n452\t        json.dump(meta, f, indent=2, ensure_ascii=False)\n453\t\n454\t    print(f\"运行 ID: {run_id}\")\n455\t    print(f\"日志目录: {run_log_dir}\")\n456\t    print(f\"发现 {len(agents)} 个 Agent: {', '.join(a['name'] for a in agents)}\")\n457\t\n458\t    count = 0\n459\t    while args.iterations == 0 or count < args.iterations:\n460\t        count += 1\n461\t        # 每轮重新扫描（可能有新 Agent）\n462\t        agents = discover_agents()\n463\t        ts = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n464\t        print(f\"\\n{'='*60}\")\n465\t        print(f\"[{ts}] 第 {count}{'/' + str(args.iterations) if args.iterations else ''} 轮 | {len(agents)} 个 Agent\")\n466\t        print(f\"{'='*60}\")\n467\t\n468\t        threads = []\n469\t        for agent in agents:\n470\t            print(f\"\\n--- 启动 [{agent['name']}] ---\", flush=True)\n471\t            t = threading.Thread(target=run_agent, args=(agent, count, run_log_dir))\n472\t            t.start()\n473\t            threads.append(t)\n474\t        for t in threads:\n475\t            t.join()\n476\t\n477\t        # 每轮结束后同步到 GitHub\n478\t        git_push()\n479\t\n480\t        # 等待下一轮，期间可输入消息\n481\t        if args.iterations == 0 or count < args.iterations:\n482\t            print(f\"\\n{'─'*60}\", flush=True)\n483\t            print(f\"输入消息发给 main（直接回车跳过，输入 exit 停止）:\", flush=True)\n484\t            try:\n485\t                user_input = input(f\"  > \").strip()\n486\t                if user_input.lower() == \"exit\":\n487\t                    print(\"用户终止运行\")\n488\t                    break\n489\t                if user_input:\n490\t                    ts = datetime.now().strftime(\"%Y%m%d_%H%M\")\n491\t                    inbox_dir = os.path.join(LOOPCLI_DIR, \"main\", \"inbox\")\n492\t                    os.makedirs(inbox_dir, exist_ok=True)\n493\t                    msg_file = os.path.join(inbox_dir, f\"user_{ts}.md\")\n494\t                    with open(msg_file, \"w\", encoding=\"utf-8\") as f:\n495\t                        f.write(f\"# 来自 zhoudingnuo 的消息\\n- 类型：指令\\n- 时间：{datetime.now().strftime('%Y-%m-%d %H:%M')}\\n\\n## 内容\\n{user_input}\\n\")\n496\t                    print(f\"  [已发送] -> main/inbox/\", flush=True)\n497\t            except EOFError:\n498\t                pass\n499\t            print(f\"  等待 {args.wait} 秒后进入下一轮...\", flush=True)\n500\t            time.sleep(args.wait)\n501\t    meta[\"finished\"] = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n502\t    meta[\"total_iterations\"] = count\n503\t    with open(os.path.join(run_log_dir, \"meta.json\"), \"w\", encoding=\"utf-8\") as f:\n504\t        json.dump(meta, f, indent=2, ensure_ascii=False)\n505\t\n506\t    print(f\"\\n运行结束，日志保存在: {run_log_dir}\")\n507\t\n508\t\n509\t# ─── CLI 入口 ───\n510\t\n511\tparser = argparse.ArgumentParser(description=\"LoopCLI — 多 Agent 自治系统\")\n512\tsub = parser.add_subparsers(dest=\"command\")\n513\t\n514\t# loopcli run [-n N]\n515\tp_run = sub.add_parser(\"run\", help=\"启动 Agent 循环（默认）\")\n516\tp_run.add_argument(\"-n\", \"--iterations\", type=int, default=0, help=\"迭代次数，0=无限\")\n517\tp_run.add_argument(\"-w\", \"--wait\", type=int, default=10, help=\"每轮间隔秒数（默认 10）\")\n518\t\n519\t# loopcli create <template> [--task TASK]\n520\tp_create = sub.add_parser(\"create\", help=\"从模板创建新 Agent\")\n521\tp_create.add_argument(\"template\", help=\"模板 ID，如 engineering-frontend-developer\")\n522\tp_create.add_argument(\"--task\", \"-t\", help=\"初始任务描述\")\n523\t\n524\t# loopcli task <agent> <title> [--desc DESC]\n525\tp_task = sub.add_parser(\"task\", help=\"给 Agent 派发任务\")\n526\tp_task.add_argument(\"agent\", help=\"Agent 目录名\")\n527\tp_task.add_argument(\"title\", help=\"任务标题\")\n528\tp_task.add_argument(\"--desc\", \"-d\", default=\"\", help=\"任务描述\")\n529\t\n530\t# loopcli list\n531\tsub.add_parser(\"list\", help=\"列出所有 Agent 及状态\")\n532\t\n533\t# loopcli templates [--filter X]\n534\tp_tpl = sub.add_parser(\"templates\", help=\"列出可用模板\")\n535\tp_tpl.add_argument(\"--filter\", \"-f\", default=\"\", help=\"按关键词筛选\")\n536\t\n537\tdef cmd_enable(args):\n538\t    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n539\t    marker = os.path.join(agent_dir, AGENT_MARKER)\n540\t    if not os.path.isfile(marker):\n541\t        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n542\t        sys.exit(1)\n543\t    with open(marker, \"w\", encoding=\"utf-8\") as f:\n544\t        f.write(\"type: main\\n\")\n545\t    print(f\"[已启用] {args.agent}\")\n546\t\n547\t\n548\tdef cmd_disable(args):\n549\t    if args.agent == \"main\":\n550\t        print(\"[错误] 不能禁用 main Agent\")\n551\t        sys.exit(1)\n552\t    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n553\t    marker = os.path.join(agent_dir, AGENT_MARKER)\n554\t    if not os.path.isfile(marker):\n555\t        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n556\t        sys.exit(1)\n557\t    with open(marker, \"w\", encoding=\"utf-8\") as f:\n558\t        f.write(\"type: main\\ndisabled: true\\n\")\n559\t    print(f\"[已禁用] {args.agent}（loopcli run 将跳过此 Agent）\")\n560\t\n561\t\n562\t# loopcli msg <内容> [--agent AGENT]\n563\tp_msg = sub.add_parser(\"msg\", help=\"给 Agent 发消息\")\n564\tp_msg.add_argument(\"content\", help=\"消息内容\")\n565\tp_msg.add_argument(\"--agent\", \"-a\", default=\"main\", help=\"目标 Agent（默认 main）\")\n566\t\n567\t# loopcli enable <agent>\n568\tp_enable = sub.add_parser(\"enable\", help=\"启用 Agent（可被 loopcli run 调度）\")\n569\tp_enable.add_argument(\"agent\", help=\"Agent 目录名\")\n570\t\n571\t# loopcli disable <agent>\n572\tp_disable = sub.add_parser(\"disable\", help=\"禁用 Agent（跳过调度，节省 token）\")\n573\tp_disable.add_argument(\"agent\", help=\"Agent 目录名\")\n574\t\n575\t# 预处理：把裸数字参数（如 -n 5）转为 run 子命令\n576\tdef cmd_msg(args):\n577\t    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n578\t    inbox = os.path.join(agent_dir, \"inbox\")\n579\t    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n580\t        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n581\t        sys.exit(1)\n582\t    os.makedirs(inbox, exist_ok=True)\n583\t    ts = datetime.now().strftime(\"%Y%m%d_%H%M\")\n584\t    msg_file = os.path.join(inbox, f\"user_{ts}.md\")\n585\t    with open(msg_file, \"w\", encoding=\"utf-8\") as f:\n586\t        f.write(f\"# 来自 zhoudingnuo 的消息\\n- 类型：指令\\n- 时间：{datetime.now().strftime('%Y-%m-%d %H:%M')}\\n\\n## 内容\\n{args.content}\\n\")\n587\t    print(f\"[已发送] -> {args.agent}/inbox/  {args.content}\")\n588\t\n589\t\n590\t# 预处理：把裸数字参数（如 -n 5）转为 run 子命令\n591\tif sys.argv[1:] and sys.argv[1] not in (\"run\", \"create\", \"task\", \"list\", \"templates\", \"msg\", \"enable\", \"disable\", \"-h\", \"--help\"):\n592\t    sys.argv.insert(1, \"run\")\n593\t\n594\targs = parser.parse_args()\n595\t\n596\tif args.command == \"create\":\n597\t    cmd_create(args)\n598\telif args.command == \"task\":\n599\t    cmd_task(args)\n600\telif args.command == \"list\":\n601\t    cmd_list(args)\n602\telif args.command == \"templates\":\n603\t    cmd_templates(args)\n604\telif args.command == \"msg\":\n605\t    cmd_msg(args)\n606\telif args.command == \"enable\":\n607\t    cmd_enable(args)\n608\telif args.command == \"disable\":\n609\t    cmd_disable(args)\n610\telse:\n611\t    # run 或无子命令\n612\t    if not hasattr(args, \"iterations\"):\n613\t        args.iterations = 0\n614\t    if not hasattr(args, \"wait\"):\n615\t        args.wait = 10\n616\t    cmd_run(args)\n617\t"}]},"parent_tool_use_id":null,"session_id":"3155194a-dbbc-4fb8-93ec-1734839a2821","uuid":"6722d355-714f-4e9a-bf02-4e6dc7b72514","timestamp":"2026-05-21T00:41:47.271Z","tool_use_result":{"type":"text","file":{"filePath":"D:/loopcli/run.py","content":"import argparse\nimport json\nimport msvcrt\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport threading\nimport time\nfrom datetime import datetime\n\nLOOPCLI_DIR = r\"D:\\loopcli\"\nSUBAGENT_DIR = os.path.join(LOOPCLI_DIR, \"subagent\")\nCLAUDE = os.path.join(os.environ.get(\"APPDATA\", \"\"), \"npm\", \"claude.cmd\")\n\nAGENT_MARKER = \"AGENT\"\nLOGS_DIR = os.path.join(LOOPCLI_DIR, \"logs\")\nGIT_TOKEN_FILE = os.path.join(LOOPCLI_DIR, \".gittoken\")\nDEFAULT_PROMPT = \"\"\"读取 SOUL.md 作为你的身份。\n读取 D:/loopcli/skill/ 下所有技能文件（全局技能）。\n读取 memory/tasks.json 获取分配给你的任务。\n\n执行步骤：\n1. 从 tasks.json 中找 status 为 \"pending\" 的第一个任务\n2. 执行该任务\n3. 将结果写入 memory/results/ 目录（以时间戳命名）\n4. 将该任务 status 改为 \"done\"，写回 tasks.json\n5. 更新 memory/state.json（标记完成、记录时间戳）\n6. 将本次运行摘要追加到 log/run.md\n7. 通过 inbox 通知 main：写入 D:/loopcli/main/inbox/<你的名字>_<时间>.md，简要报告任务结果\n8. 如果没有 pending 任务，输出 \"IDLE\" 并结束本轮\n\"\"\"\n\n\n# ─── 工具函数 ───\n\ndef get_agent_marker(path):\n    \"\"\"读取 AGENT 标记文件内容\"\"\"\n    marker = os.path.join(path, AGENT_MARKER)\n    if os.path.isfile(marker):\n        with open(marker, \"r\", encoding=\"utf-8\") as f:\n            return f.read().strip()\n    return None\n\n\ndef is_agent_enabled(path):\n    \"\"\"检查 Agent 是否启用（AGENT 文件不含 disabled 标记）\"\"\"\n    content = get_agent_marker(path)\n    if content is None:\n        return False\n    return \"disabled\" not in content\n\n\ndef discover_agents(include_disabled=False):\n    agents = []\n    for name in os.listdir(LOOPCLI_DIR):\n        path = os.path.join(LOOPCLI_DIR, name)\n        marker = os.path.join(path, AGENT_MARKER)\n        if os.path.isdir(path) and os.path.isfile(marker):\n            if include_disabled or is_agent_enabled(path):\n                agents.append({\"name\": name, \"path\": path})\n    return agents\n\n\ndef find_template(template_id):\n    \"\"\"在 subagent 目录下搜索模板文件\"\"\"\n    for dept in os.listdir(SUBAGENT_DIR):\n        dept_dir = os.path.join(SUBAGENT_DIR, dept)\n        if not os.path.isdir(dept_dir):\n            continue\n        candidate = os.path.join(dept_dir, f\"{template_id}.md\")\n        if os.path.isfile(candidate):\n            return candidate\n    return None\n\n\ndef load_agent_state(agent_path):\n    state_file = os.path.join(agent_path, \"memory\", \"state.json\")\n    if os.path.isfile(state_file):\n        with open(state_file, \"r\", encoding=\"utf-8\") as f:\n            return json.load(f)\n    return None\n\n\ndef load_agent_tasks(agent_path):\n    tasks_file = os.path.join(agent_path, \"memory\", \"tasks.json\")\n    if os.path.isfile(tasks_file):\n        with open(tasks_file, \"r\", encoding=\"utf-8\") as f:\n            return json.load(f)\n    return []\n\n\ndef rotate_log(log_path, max_size=1_000_000, max_backups=3):\n    \"\"\"轮转日志文件：超过 max_size 时依次重命名为 .1 .2 .3，最多保留 max_backups 个归档\"\"\"\n    if not os.path.isfile(log_path):\n        return\n    try:\n        if os.path.getsize(log_path) < max_size:\n            return\n    except OSError:\n        return\n    # 删除最老的归档\n    oldest = f\"{log_path}.{max_backups}\"\n    if os.path.isfile(oldest):\n        os.remove(oldest)\n    # 依次重命名 .2->.3, .1->.2\n    for i in range(max_backups, 1, -1):\n        src = f\"{log_path}.{i - 1}\"\n        dst = f\"{log_path}.{i}\"\n        if os.path.isfile(src):\n            os.rename(src, dst)\n    # 当前日志 -> .1\n    os.rename(log_path, f\"{log_path}.1\")\n\n\n# ─── 子命令: create ───\n\ndef cmd_create(args):\n    template_id = args.template\n    task_desc = args.task or \"\"\n\n    tpl_file = find_template(template_id)\n    if not tpl_file:\n        print(f\"[错误] 找不到模板: {template_id}\")\n        print(\"用 loopcli templates 查看所有可用模板\")\n        sys.exit(1)\n\n    with open(tpl_file, \"r\", encoding=\"utf-8\") as f:\n        soul_content = f.read()\n\n    agent_dir = os.path.join(LOOPCLI_DIR, template_id)\n    if os.path.exists(agent_dir):\n        print(f\"[跳过] Agent 已存在: {agent_dir}\")\n        if task_desc:\n            cmd_task_inner(template_id, task_desc, \"\")\n        return\n\n    # 创建目录结构\n    os.makedirs(os.path.join(agent_dir, \"memory\", \"results\"), exist_ok=True)\n    os.makedirs(os.path.join(agent_dir, \"log\"), exist_ok=True)\n\n    # AGENT 标记\n    with open(os.path.join(agent_dir, AGENT_MARKER), \"w\", encoding=\"utf-8\") as f:\n        f.write(\"type: main\\n\")\n\n    # SOUL.md（模板内容）\n    with open(os.path.join(agent_dir, \"SOUL.md\"), \"w\", encoding=\"utf-8\") as f:\n        f.write(soul_content)\n\n    # PROMPT.md\n    with open(os.path.join(agent_dir, \"PROMPT.md\"), \"w\", encoding=\"utf-8\") as f:\n        f.write(DEFAULT_PROMPT)\n\n    # state.json\n    state = {\"agent\": template_id, \"status\": \"idle\", \"current_task\": None, \"last_run\": None, \"run_count\": 0, \"created\": datetime.now().strftime(\"%Y-%m-%d\")}\n    with open(os.path.join(agent_dir, \"memory\", \"state.json\"), \"w\", encoding=\"utf-8\") as f:\n        json.dump(state, f, indent=2, ensure_ascii=False)\n\n    # tasks.json\n    tasks = []\n    if task_desc:\n        tasks.append({\"id\": 1, \"status\": \"pending\", \"title\": task_desc, \"description\": task_desc, \"created\": datetime.now().strftime(\"%Y-%m-%d\"), \"assignee\": template_id})\n    with open(os.path.join(agent_dir, \"memory\", \"tasks.json\"), \"w\", encoding=\"utf-8\") as f:\n        json.dump(tasks, f, indent=2, ensure_ascii=False)\n\n    # run.md\n    with open(os.path.join(agent_dir, \"log\", \"run.md\"), \"w\", encoding=\"utf-8\") as f:\n        f.write(\"# 运行日志\\n\\n| 时间 | 状态 | 任务 | 摘要 |\\n|------|------|------|------|\\n\")\n\n    print(f\"[创建成功] {template_id}\")\n    print(f\"  目录: {agent_dir}\")\n    if task_desc:\n        print(f\"  任务: {task_desc}\")\n    print(f\"  下一轮 loopcli 将自动启动该 Agent\")\n\n\n# ─── 子命令: task ───\n\ndef cmd_task_inner(agent_name, title, desc):\n    agent_dir = os.path.join(LOOPCLI_DIR, agent_name)\n    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n        print(f\"[错误] 不是有效的 Agent: {agent_name}\")\n        sys.exit(1)\n\n    tasks_file = os.path.join(agent_dir, \"memory\", \"tasks.json\")\n    tasks = load_agent_tasks(agent_dir)\n    next_id = max((t[\"id\"] for t in tasks), default=0) + 1\n    tasks.append({\n        \"id\": next_id,\n        \"status\": \"pending\",\n        \"title\": title,\n        \"description\": desc or title,\n        \"created\": datetime.now().strftime(\"%Y-%m-%d\"),\n        \"assignee\": agent_name\n    })\n    with open(tasks_file, \"w\", encoding=\"utf-8\") as f:\n        json.dump(tasks, f, indent=2, ensure_ascii=False)\n    print(f\"[派发成功] {agent_name} <- #{next_id} {title}\")\n\n\ndef cmd_task(args):\n    cmd_task_inner(args.agent, args.title, args.desc)\n\n\n# ─── 子命令: list ───\n\ndef cmd_list(args):\n    agents = discover_agents(include_disabled=True)\n    if not agents:\n        print(\"没有发现任何 Agent\")\n        return\n    print(f\"{'Agent':<45} {'启用':<6} {'状态':<10} {'任务数':<8} {'最后运行'}\")\n    print(\"-\" * 95)\n    for a in agents:\n        enabled = \"是\" if is_agent_enabled(a[\"path\"]) else \"否\"\n        state = load_agent_state(a[\"path\"]) or {}\n        tasks = load_agent_tasks(a[\"path\"])\n        pending = len([t for t in tasks if t.get(\"status\") == \"pending\"])\n        status = state.get(\"status\", \"?\")\n        last_run = state.get(\"last_run\", \"-\")\n        print(f\"{a['name']:<45} {enabled:<6} {status:<10} {pending:<8} {last_run}\")\n\n\n# ─── 子命令: templates ───\n\ndef cmd_templates(args):\n    found = []\n    for dept in sorted(os.listdir(SUBAGENT_DIR)):\n        dept_dir = os.path.join(SUBAGENT_DIR, dept)\n        if not os.path.isdir(dept_dir):\n            continue\n        for fname in sorted(os.listdir(dept_dir)):\n            if fname.endswith(\".md\"):\n                found.append(fname[:-3])\n    if args.filter:\n        found = [t for t in found if args.filter.lower() in t.lower()]\n    print(f\"共 {len(found)} 个模板:\")\n    for t in found:\n        print(f\"  {t}\")\n\n\n# ─── 子命令: run（主循环）───\n\ndef handle_event(agent_name, line):\n    line = line.strip()\n    if not line:\n        return\n    try:\n        event = json.loads(line)\n    except json.JSONDecodeError:\n        print(f\"[{agent_name}] {line}\", flush=True)\n        return\n\n    event_type = event.get(\"type\", \"\")\n\n    if event_type == \"assistant\":\n        msg = event.get(\"message\", {})\n        for block in msg.get(\"content\", []):\n            if block.get(\"type\") == \"text\":\n                text = block.get(\"text\", \"\")\n                if text:\n                    print(f\"[{agent_name}] {text}\", flush=True)\n            elif block.get(\"type\") == \"tool_use\":\n                name = block.get(\"name\", \"\")\n                inp = block.get(\"input\", {})\n                detail = \"\"\n                for k in (\"file_path\", \"command\", \"pattern\"):\n                    if k in inp:\n                        detail = inp[k]\n                        break\n                print(f\"[{agent_name}] ● {name}({detail})\", flush=True)\n\n    elif event_type == \"tool_result\":\n        content = event.get(\"content\", \"\")\n        texts = []\n        if isinstance(content, list):\n            texts = [b.get(\"text\", \"\") for b in content if b.get(\"text\")]\n        elif isinstance(content, str):\n            texts = [content]\n        for text in texts:\n            print(f\"[{agent_name}]   ↳ {text[:200]}\", flush=True)\n\n    elif event_type == \"result\":\n        text = event.get(\"result\", \"\")\n        if text:\n            print(f\"[{agent_name}] [结果] {text[:500]}\", flush=True)\n        cost = event.get(\"cost_usd\", \"\")\n        duration = event.get(\"duration_ms\", \"\")\n        if cost or duration:\n            print(f\"[{agent_name}] [统计] 耗时: {duration}ms, 费用: ${cost}\", flush=True)\n\n    elif event_type == \"error\":\n        print(f\"[{agent_name}] [错误] {event.get('error', '')}\", flush=True)\n\n\ndef run_agent(agent, iteration, run_log_dir):\n    name = agent[\"name\"]\n    path = agent[\"path\"]\n    prompt_file = os.path.join(path, \"PROMPT.md\")\n    log_file_path = os.path.join(path, \"log\", \"raw.log\")\n    run_agent_log = os.path.join(run_log_dir, f\"{name}.log\")\n    ts = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n\n    if not os.path.isfile(prompt_file):\n        print(f\"[{name}] 没有 PROMPT.md，跳过\", flush=True)\n        return\n\n    with open(prompt_file, \"r\", encoding=\"utf-8\") as f:\n        prompt = f.read()\n\n    os.makedirs(os.path.join(path, \"log\"), exist_ok=True)\n    rotate_log(log_file_path)\n    log_file = open(log_file_path, \"a\", encoding=\"utf-8\")\n    agent_log = open(run_agent_log, \"a\", encoding=\"utf-8\")\n\n    try:\n        header = f\"\\n[{ts}] --- 开始 (第{iteration}轮) ---\\n\"\n        log_file.write(header)\n        agent_log.write(header)\n        log_file.flush()\n        agent_log.flush()\n\n        env = {**os.environ, \"IS_SANDBOX\": \"1\"}\n\n        proc = subprocess.Popen(\n            [CLAUDE, \"--print\", \"--verbose\", \"--output-format\", \"stream-json\", \"--dangerously-skip-permissions\"],\n            stdin=subprocess.PIPE,\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            env=env,\n            cwd=path,\n        )\n\n        proc.stdin.write(prompt.encode(\"utf-8\"))\n        proc.stdin.close()\n\n        for line in proc.stdout:\n            decoded = line.decode(\"utf-8\", errors=\"replace\")\n            log_file.write(decoded)\n            agent_log.write(decoded)\n            log_file.flush()\n            agent_log.flush()\n            handle_event(name, decoded)\n\n        stderr_output = proc.stderr.read().decode(\"utf-8\", errors=\"replace\")\n        if stderr_output:\n            print(f\"[{name}] [STDERR] {stderr_output}\", flush=True)\n            log_file.write(stderr_output)\n            agent_log.write(stderr_output)\n\n        proc.wait()\n\n        footer = f\"\\n[{ts}] --- 结束 (exit={proc.returncode}) ---\\n\"\n        log_file.write(footer)\n        agent_log.write(footer)\n    finally:\n        log_file.close()\n        agent_log.close()\n\n    # 更新 state.json (with file lock)\n    state_file = os.path.join(path, \"memory\", \"state.json\")\n    with open(state_file, \"a+\") as f:\n        msvcrt.locking(f.fileno(), msvcrt.LK_LOCK, 1)\n        try:\n            f.seek(0)\n            try:\n                state = json.load(f)\n            except (json.JSONDecodeError, ValueError):\n                state = {}\n            state[\"status\"] = \"idle\"\n            state[\"last_run\"] = ts\n            state[\"run_count\"] = state.get(\"run_count\", 0) + 1\n            f.seek(0)\n            f.truncate()\n            json.dump(state, f, indent=2, ensure_ascii=False)\n        finally:\n            msvcrt.locking(f.fileno(), msvcrt.LK_UNLCK, 1)\n\n    status = \"完成\" if proc.returncode == 0 else f\"异常(exit={proc.returncode})\"\n    print(f\"[{name}] 本轮{status}\", flush=True)\n\n\ndef git_push():\n    \"\"\"自动 commit 和 push 到 GitHub\"\"\"\n    token_file = GIT_TOKEN_FILE\n    if not os.path.isfile(token_file):\n        return\n    with open(token_file, \"r\") as f:\n        token = f.read().strip()\n    if not token:\n        return\n    try:\n        git = resolve_git()\n        subprocess.run([git, \"add\", \"memory/\", \"log/\", \"inbox/\"], cwd=LOOPCLI_DIR, capture_output=True, timeout=30)\n        subprocess.run(\n            [git, \"commit\", \"-m\", f\"auto: loopcli sync {datetime.now().strftime('%Y-%m-%d %H:%M')}\"],\n            cwd=LOOPCLI_DIR, capture_output=True, timeout=30\n        )\n        # Use GIT_ASKPASS to avoid exposing token in command line\n        askpass_script = os.path.join(LOOPCLI_DIR, \".git_askpass.bat\")\n        with open(askpass_script, \"w\") as f:\n            f.write(\"@echo %GH_TOKEN%\\n\")\n        push_env = {\n            **os.environ,\n            \"GH_TOKEN\": token,\n            \"GIT_ASKPASS\": askpass_script,\n            \"GIT_TERMINAL_PROMPT\": \"0\",\n        }\n        subprocess.run(\n            [git, \"push\", \"https://x-access-token@github.com/zhoudingnuo/loopcli.git\", \"main\"],\n            cwd=LOOPCLI_DIR, capture_output=True, timeout=60, env=push_env,\n        )\n        os.remove(askpass_script)\n        print(\"[git] 已同步到 GitHub\", flush=True)\n    except Exception as e:\n        print(f\"[git] 同步失败: {e}\", flush=True)\n\n\ndef resolve_git():\n    \"\"\"找到 git.exe 的完整路径\"\"\"\n    for p in os.environ.get(\"PATH\", \"\").split(\";\"):\n        candidate = os.path.join(p, \"git.exe\")\n        if os.path.isfile(candidate):\n            return candidate\n    # 常见安装路径\n    for d in [r\"C:\\Program Files\\Git\\cmd\", r\"C:\\Program Files\\Git\\bin\"]:\n        candidate = os.path.join(d, \"git.exe\")\n        if os.path.isfile(candidate):\n            return candidate\n    return \"git\"\n\n\ndef cmd_run(args):\n    agents = discover_agents()\n    if not agents:\n        print(\"未发现任何 Agent（需要目录下有 AGENT 标记文件）\")\n        sys.exit(1)\n\n    # 创建本次运行日志目录\n    run_id = datetime.now().strftime(\"run_%Y%m%d_%H%M%S\")\n    run_log_dir = os.path.join(LOGS_DIR, run_id)\n    os.makedirs(run_log_dir, exist_ok=True)\n\n    # 写入运行元信息\n    meta = {\n        \"run_id\": run_id,\n        \"started\": datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"),\n        \"iterations\": args.iterations or \"无限\",\n        \"agents\": [a[\"name\"] for a in agents],\n    }\n    with open(os.path.join(run_log_dir, \"meta.json\"), \"w\", encoding=\"utf-8\") as f:\n        json.dump(meta, f, indent=2, ensure_ascii=False)\n\n    print(f\"运行 ID: {run_id}\")\n    print(f\"日志目录: {run_log_dir}\")\n    print(f\"发现 {len(agents)} 个 Agent: {', '.join(a['name'] for a in agents)}\")\n\n    count = 0\n    while args.iterations == 0 or count < args.iterations:\n        count += 1\n        # 每轮重新扫描（可能有新 Agent）\n        agents = discover_agents()\n        ts = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n        print(f\"\\n{'='*60}\")\n        print(f\"[{ts}] 第 {count}{'/' + str(args.iterations) if args.iterations else ''} 轮 | {len(agents)} 个 Agent\")\n        print(f\"{'='*60}\")\n\n        threads = []\n        for agent in agents:\n            print(f\"\\n--- 启动 [{agent['name']}] ---\", flush=True)\n            t = threading.Thread(target=run_agent, args=(agent, count, run_log_dir))\n            t.start()\n            threads.append(t)\n        for t in threads:\n            t.join()\n\n        # 每轮结束后同步到 GitHub\n        git_push()\n\n        # 等待下一轮，期间可输入消息\n        if args.iterations == 0 or count < args.iterations:\n            print(f\"\\n{'─'*60}\", flush=True)\n            print(f\"输入消息发给 main（直接回车跳过，输入 exit 停止）:\", flush=True)\n            try:\n                user_input = input(f\"  > \").strip()\n                if user_input.lower() == \"exit\":\n                    print(\"用户终止运行\")\n                    break\n                if user_input:\n                    ts = datetime.now().strftime(\"%Y%m%d_%H%M\")\n                    inbox_dir = os.path.join(LOOPCLI_DIR, \"main\", \"inbox\")\n                    os.makedirs(inbox_dir, exist_ok=True)\n                    msg_file = os.path.join(inbox_dir, f\"user_{ts}.md\")\n                    with open(msg_file, \"w\", encoding=\"utf-8\") as f:\n                        f.write(f\"# 来自 zhoudingnuo 的消息\\n- 类型：指令\\n- 时间：{datetime.now().strftime('%Y-%m-%d %H:%M')}\\n\\n## 内容\\n{user_input}\\n\")\n                    print(f\"  [已发送] -> main/inbox/\", flush=True)\n            except EOFError:\n                pass\n            print(f\"  等待 {args.wait} 秒后进入下一轮...\", flush=True)\n            time.sleep(args.wait)\n    meta[\"finished\"] = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n    meta[\"total_iterations\"] = count\n    with open(os.path.join(run_log_dir, \"meta.json\"), \"w\", encoding=\"utf-8\") as f:\n        json.dump(meta, f, indent=2, ensure_ascii=False)\n\n    print(f\"\\n运行结束，日志保存在: {run_log_dir}\")\n\n\n# ─── CLI 入口 ───\n\nparser = argparse.ArgumentParser(description=\"LoopCLI — 多 Agent 自治系统\")\nsub = parser.add_subparsers(dest=\"command\")\n\n# loopcli run [-n N]\np_run = sub.add_parser(\"run\", help=\"启动 Agent 循环（默认）\")\np_run.add_argument(\"-n\", \"--iterations\", type=int, default=0, help=\"迭代次数，0=无限\")\np_run.add_argument(\"-w\", \"--wait\", type=int, default=10, help=\"每轮间隔秒数（默认 10）\")\n\n# loopcli create <template> [--task TASK]\np_create = sub.add_parser(\"create\", help=\"从模板创建新 Agent\")\np_create.add_argument(\"template\", help=\"模板 ID，如 engineering-frontend-developer\")\np_create.add_argument(\"--task\", \"-t\", help=\"初始任务描述\")\n\n# loopcli task <agent> <title> [--desc DESC]\np_task = sub.add_parser(\"task\", help=\"给 Agent 派发任务\")\np_task.add_argument(\"agent\", help=\"Agent 目录名\")\np_task.add_argument(\"title\", help=\"任务标题\")\np_task.add_argument(\"--desc\", \"-d\", default=\"\", help=\"任务描述\")\n\n# loopcli list\nsub.add_parser(\"list\", help=\"列出所有 Agent 及状态\")\n\n# loopcli templates [--filter X]\np_tpl = sub.add_parser(\"templates\", help=\"列出可用模板\")\np_tpl.add_argument(\"--filter\", \"-f\", default=\"\", help=\"按关键词筛选\")\n\ndef cmd_enable(args):\n    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n    marker = os.path.join(agent_dir, AGENT_MARKER)\n    if not os.path.isfile(marker):\n        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n        sys.exit(1)\n    with open(marker, \"w\", encoding=\"utf-8\") as f:\n        f.write(\"type: main\\n\")\n    print(f\"[已启用] {args.agent}\")\n\n\ndef cmd_disable(args):\n    if args.agent == \"main\":\n        print(\"[错误] 不能禁用 main Agent\")\n        sys.exit(1)\n    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n    marker = os.path.join(agent_dir, AGENT_MARKER)\n    if not os.path.isfile(marker):\n        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n        sys.exit(1)\n    with open(marker, \"w\", encoding=\"utf-8\") as f:\n        f.write(\"type: main\\ndisabled: true\\n\")\n    print(f\"[已禁用] {args.agent}（loopcli run 将跳过此 Agent）\")\n\n\n# loopcli msg <内容> [--agent AGENT]\np_msg = sub.add_parser(\"msg\", help=\"给 Agent 发消息\")\np_msg.add_argument(\"content\", help=\"消息内容\")\np_msg.add_argument(\"--agent\", \"-a\", default=\"main\", help=\"目标 Agent（默认 main）\")\n\n# loopcli enable <agent>\np_enable = sub.add_parser(\"enable\", help=\"启用 Agent（可被 loopcli run 调度）\")\np_enable.add_argument(\"agent\", help=\"Agent 目录名\")\n\n# loopcli disable <agent>\np_disable = sub.add_parser(\"disable\", help=\"禁用 Agent（跳过调度，节省 token）\")\np_disable.add_argument(\"agent\", help=\"Agent 目录名\")\n\n# 预处理：把裸数字参数（如 -n 5）转为 run 子命令\ndef cmd_msg(args):\n    agent_dir = os.path.join(LOOPCLI_DIR, args.agent)\n    inbox = os.path.join(agent_dir, \"inbox\")\n    if not os.path.isfile(os.path.join(agent_dir, AGENT_MARKER)):\n        print(f\"[错误] 不是有效的 Agent: {args.agent}\")\n        sys.exit(1)\n    os.makedirs(inbox, exist_ok=True)\n    ts = datetime.now().strftime(\"%Y%m%d_%H%M\")\n    msg_file = os.path.join(inbox, f\"user_{ts}.md\")\n    with open(msg_file, \"w\", encoding=\"utf-8\") as f:\n        f.write(f\"# 来自 zhoudingnuo 的消息\\n- 类型：指令\\n- 时间：{datetime.now().strftime('%Y-%m-%d %H:%M')}\\n\\n## 内容\\n{args.content}\\n\")\n    print(f\"[已发送] -> {args.agent}/inbox/  {args.content}\")\n\n\n# 预处理：把裸数字参数（如 -n 5）转为 run 子命令\nif sys.argv[1:] and sys.argv[1] not in (\"run\", \"create\", \"task\", \"list\", \"templates\", \"msg\", \"enable\", \"disable\", \"-h\", \"--help\"):\n    sys.argv.insert(1, \"run\")\n\nargs = parser.parse_args()\n\nif args.command == \"create\":\n    cmd_create(args)\nelif args.command == \"task\":\n    cmd_task(args)\nelif args.command == \"list\":\n    cmd_list(args)\nelif args.command == \"templates\":\n    cmd_templates(args)\nelif args.command == \"msg\":\n    cmd_msg(args)\nelif args.command == \"enable\":\n    cmd_enable(args)\nelif args.command == \"disable\":\n    cmd_disable(args)\nelse:\n    # run 或无子命令\n    if not hasattr(args, \"iterations\"):\n        args.iterations = 0\n    if not hasattr(args, \"wait\"):\n        args.wait = 10\n    cmd_run(args)\n","numLines":617,"startLine":1,"totalLines":617}}}
{"type":"assistant","message":{"id":"msg_20260521084149916c0e5735d747cd","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"thinking","thinking":"Now I have a thorough understanding of both files. Let me perform the final code quality review. Let me also read the previous review reports to understand what's already been covered.\n\nActually, the task says \"无需逐行审查，重点关注架构层面问题\". So I should focus on architectural-level issues.\n\nLet me write the review report now. Let me structure it based on the 5 areas specified:\n1. Code readability and maintainability (naming, structure, complexity)\n2. Error handling completeness\n3. Performance bottlenecks\n4. API design consistency\n5. Code duplication and abstraction opportunities\n\nLet me analyze both files:\n\n### server.py (674 lines)\n\n**Architecture:**\n- Single-file HTTP server with a handler class\n- Good separation: utility functions, route handling, process management\n- Uses threading for concurrent requests\n\n**Readability & Maintainability:**\n- Generally well-structured and clear\n- Good use of constants for configuration\n- `WebUIHandler` is a large class with mixed responsibilities (routing, CORS, SSE, business logic)\n\n**Error Handling:**\n- `_read_body()` silently returns `{}` on JSON decode errors instead of signaling an error - could mask issues\n- `scan_agents()` catches broad exceptions in `read_json` but individual agent scanning could fail and affect the whole list\n- `_handle_loopcli_restart()` has `time.sleep(0.5)` which is fragile\n\n**Performance:**\n- SSE log streaming polls with `time.sleep(1)` and reads entire file each time - could be expensive for large logs\n- `get_recent_lines()` reads the entire file to get last N lines\n- `_write_semaphore` is good for limiting concurrent writes\n- `scan_agents()` reads multiple JSON files synchronously\n\n**API Design:**\n- Mixed REST patterns: `/api/agents` vs `/api/agents/start` (action in path)\n- Some endpoints use query params, others use body\n- `/api/agents/{id}/tasks` and `/api/tasks?agent=id` are redundant\n- Inconsistent: some POST handlers read body, some don't need to\n- `_handle_agent_enable` uses an action parameter to handle both enable/disable\n\n**Code Duplication:**\n- `get_agent_tasks()` and `get_all_agent_tasks()` share similar patterns\n- Agent validation (`_safe_agent_path` + check exists) repeated in multiple handlers\n- Task ID generation pattern `max((t.get(\"id\", 0) for t in tasks), default=0) + 1` appears twice\n- Route pattern matching is manual if/elif chains\n\n### run.py (617 lines)\n\n**Architecture:**\n- CLI tool with subcommands\n- Agent discovery, task management, process execution, git sync\n\n**Readability & Maintainability:**\n- Good function naming\n- `handle_event` is quite complex with nested conditions\n- `DEFAULT_PROMPT` is hardcoded as a multi-line string template\n- Global `LOOPCLI_DIR` hardcoded\n\n**Error Handling:**\n- `run_agent()` has try/finally for log files - good\n- `state_file` update uses file locking with msvcrt - Windows-specific\n- `git_push()` catches broad Exception\n- No error handling in `discover_agents()` if LOOPCLI_DIR doesn't exist\n- `resolve_git()` silently falls back to \"git\"\n\n**Performance:**\n- `discover_agents()` called each iteration in the loop - reasonable for freshness\n- All agents run in parallel threads - good\n- Log rotation is a nice touch\n\n**Code Duplication:**\n- Task creation logic duplicated between `cmd_create()` and server's `_handle_create_task()`\n- Message writing format duplicated between `cmd_msg()`, server's `_handle_message_send()`, and the user input section of `cmd_run()`\n- Agent marker reading/writing duplicated between `cmd_enable()`, `cmd_disable()`, and server's `_handle_agent_enable()`\n- `load_agent_tasks()`/`load_agent_state()` duplicate patterns from server.py's `read_json()`\n\n**Cross-cutting concerns:**\n- Both files hardcode `LOOPCLI_DIR` as `D:\\loopcli`\n- No shared configuration module\n- Windows-specific code (`msvcrt`, `CREATE_NO_WINDOW`) limits portability\n- No configuration file support\n- No graceful shutdown handling in `cmd_run()`\n\nLet me write the report now.","signature":""}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"3155194a-dbbc-4fb8-93ec-1734839a2821","uuid":"80a09f8b-ac10-46f9-99ca-182fe7470fa8"}
