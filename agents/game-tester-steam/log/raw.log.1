FFSET * 2).toBe(32);\n  });\n});\n\ndescribe('Player movement', () => {\n  it('does not move when no keys are pressed', () => {\n    const state = makePlayerState({ x: 500, y: 300 });\n    const player = new Player(state);\n    const map = new StoreMap();\n\n    const startX = player.x;\n    const startY = player.y;\n\n    player.update(16, map);\n\n    expect(player.x).toBe(startX);\n    expect(player.y).toBe(startY);\n    expect(player.moving).toBe(false);\n  });\n\n  it('respects collision with walls', () => {\n    const map = new StoreMap();\n    // Place player right next to a wall (top-left corner area)\n    // Row 0 is wall, so placing player at y=1 (pixel 32) and trying to move up\n    const state = makePlayerState({ x: 1 * 32, y: 1 * 32 });\n    const player = new Player(state);\n\n    // Simulate pressing 'w' (move up) for 1 second\n    // Since we can't easily simulate keyboard, we test collision directly\n    const wouldCollide = map.collides(\n      player.x + PLAYER_OFFSET,\n      (player.y - 150 + PLAYER_OFFSET),\n      PLAYER_SIZE,\n      PLAYER_SIZE,\n    );\n    expect(wouldCollide).toBe(true);\n  });\n\n  it('movement speed is applied correctly via dt', () => {\n    const state = makePlayerState({ speed: 150, x: 500, y: 300 });\n    const player = new Player(state);\n    const map = new StoreMap();\n\n    // At speed 150, with dt=1000ms, player should move 150 pixels\n    const moveSpeed = player.speed * 1 / 1000; // dt=1000\n    expect(moveSpeed).toBe(0.15);\n  });\n});\n\ndescribe('getFacingTile', () => {\n  it('returns correct tile when facing down', () => {\n    const player = new Player(makePlayerState({\n      x: 10 * 32,\n      y: 5 * 32,\n      direction: 'down',\n    }));\n\n    const { gx, gy } = player.getFacingTile();\n    // Player center: (10*32 + 16, 5*32 + 16) = (336, 176)\n    // Facing down: targetY = 176 + 32 = 208 => gy = 6\n    expect(gx).toBe(10 + 1); // (10*32 + 16) / 32 = 10.5 -> floor -> 10... wait\n    // Actually: cx = 10*32 + 16 = 336, cy = 5*32 + 16 = 176\n    // targetY = 176 + 32 = 208, gy = 208/32 = 6.5 -> floor = 6\n    expect(gy).toBe(6);\n  });\n\n  it('returns correct tile when facing up', () => {\n    const player = new Player(makePlayerState({\n      x: 10 * 32,\n      y: 5 * 32,\n      direction: 'up',\n    }));\n\n    const { gx, gy } = player.getFacingTile();\n    // targetY = 176 - 32 = 144, gy = 144/32 = 4.5 -> floor = 4\n    expect(gy).toBe(4);\n  });\n\n  it('returns correct tile when facing left', () => {\n    const player = new Player(makePlayerState({\n      x: 10 * 32,\n      y: 5 * 32,\n      direction: 'left',\n    }));\n\n    const { gx, gy } = player.getFacingTile();\n    // targetX = 336 - 32 = 304, gx = 304/32 = 9.5 -> floor = 9\n    expect(gx).toBe(9);\n  });\n\n  it('returns correct tile when facing right', () => {\n    const player = new Player(makePlayerState({\n      x: 10 * 32,\n      y: 5 * 32,\n      direction: 'right',\n    }));\n\n    const { gx, gy } = player.getFacingTile();\n    // targetX = 336 + 32 = 368, gx = 368/32 = 11.5 -> floor = 11\n    expect(gx).toBe(11);\n  });\n});\n\ndescribe('toState', () => {\n  it('serializes player state correctly', () => {\n    const state = makePlayerState({\n      x: 100,\n      y: 200,\n      speed: 180,\n      direction: 'left',\n    });\n    const player = new Player(state);\n    const serialized = player.toState();\n\n    expect(serialized.x).toBe(100);\n    expect(serialized.y).toBe(200);\n    expect(serialized.speed).toBe(180);\n    expect(serialized.direction).toBe('left');\n  });\n\n  it('returns default economy fields in serialized state', () => {\n    const player = new Player(makePlayerState());\n    const serialized = player.toState();\n\n    expect(serialized.money).toBe(0);\n    expect(serialized.debt).toBe(0);\n    expect(serialized.day).toBe(1);\n    expect(serialized.health).toBe(100);\n    expect(serialized.sanity).toBe(100);\n  });\n});\n\ndescribe('consumeInteract', () => {\n  it('returns false when interact has not been pressed', () => {\n    const player = new Player(makePlayerState());\n    expect(player.consumeInteract()).toBe(false);\n  });\n});\n","numLines":182,"startLine":1,"totalLines":182}}}
