{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_044e912c380d414cb5cadb50","type":"tool_result","content":"1\t// CrossRegionTeleport.ts — 跨区域传送系统 (v0.4.0)\n2\t\n3\timport type { CrossRegionLink, Resources } from './GameState';\n4\t\n5\texport interface CrossRegionTransferResult {\n6\t  links: CrossRegionLink[];\n7\t  transferred: Array<{ resource: string; amount: number; fromRegion: number; toRegion: number }>;\n8\t}\n9\t\n10\t// Create a new cross-region link\n11\texport function createCrossRegionLink(\n12\t  id: string,\n13\t  fromRegionIndex: number,\n14\t  fromX: number,\n15\t  fromY: number,\n16\t  toRegionIndex: number,\n17\t  toX: number,\n18\t  toY: number,\n19\t  resource: string,\n20\t  amount: number,\n21\t  interval: number,\n22\t): CrossRegionLink {\n23\t  return {\n24\t    id,\n25\t    fromRegionIndex,\n26\t    fromX,\n27\t    fromY,\n28\t    toRegionIndex,\n29\t    toX,\n30\t    toY,\n31\t    resource,\n32\t    amount,\n33\t    interval,\n34\t    lastTransfer: 0,\n35\t  };\n36\t}\n37\t\n38\t// Validate a cross-region link\n39\texport function validateLink(link: CrossRegionLink, regionCount: number): boolean {\n40\t  if (link.fromRegionIndex < 0 || link.fromRegionIndex >= regionCount) return false;\n41\t  if (link.toRegionIndex < 0 || link.toRegionIndex >= regionCount) return false;\n42\t  if (link.fromRegionIndex === link.toRegionIndex) return false;\n43\t  if (link.amount <= 0) return false;\n44\t  if (link.interval <= 0) return false;\n45\t  return true;\n46\t}\n47\t\n48\t// Tick all cross-region links and process transfers\n49\texport function tickCrossRegionLinks(\n50\t  links: CrossRegionLink[],\n51\t  resources: Resources,\n52\t  now: number,\n53\t): CrossRegionTransferResult {\n54\t  const transferred: Array<{ resource: string; amount: number; fromRegion: number; toRegion: number }> = [];\n55\t  const updatedLinks: CrossRegionLink[] = [];\n56\t\n57\t  for (const link of links) {\n58\t    const elapsed = now - link.lastTransfer;\n59\t\n60\t    if (elapsed >= link.interval) {\n61\t      const currentAmount = resources[link.resource as keyof Resources] ?? 0;\n62\t      if (currentAmount >= link.amount) {\n63\t        transferred.push({\n64\t          resource: link.resource,\n65\t          amount: link.amount,\n66\t          fromRegion: link.fromRegionIndex,\n67\t          toRegion: link.toRegionIndex,\n68\t        });\n69\t        updatedLinks.push({ ...link, lastTransfer: now });\n70\t      } else {\n71\t        updatedLinks.push(link);\n72\t      }\n73\t    } else {\n74\t      updatedLinks.push(link);\n75\t    }\n76\t  }\n77\t\n78\t  return { links: updatedLinks, transferred };\n79\t}\n80\t\n81\t// Get link status for display\n82\texport function getLinkStatus(link: CrossRegionLink, now: number): {\n83\t  progress: number;\n84\t  timeToNext: number;\n85\t} {\n86\t  const elapsed = now - link.lastTransfer;\n87\t  const progress = Math.min(1, elapsed / link.interval);\n88\t  const timeToNext = Math.max(0, link.interval - elapsed);\n89\t  return { progress, timeToNext };\n90\t}\n91\t\n92\t// Render a cross-region portal on canvas\n93\texport function renderCrossRegionPortal(\n94\t  ctx: CanvasRenderingContext2D,\n95\t  gridX: number,\n96\t  gridY: number,\n97\t  offsetX: number,\n98\t  offsetY: number,\n99\t  scale: number,\n100\t  cellSize: number,\n101\t  now: number,\n102\t): void {\n103\t  const x = offsetX + gridX * cellSize * scale;\n104\t  const y = offsetY + gridY * cellSize * scale;\n105\t  const s = 3 * cellSize * scale; // 3x3 building\n106\t\n107\t  // Portal base\n108\t  ctx.fillStyle = 'rgba(120, 80, 255, 0.3)';\n109\t  ctx.fillRect(x + 2, y + 2, s - 4, s - 4);\n110\t\n111\t  // Animated ring\n112\t  const phase = (now / 2000) % 1;\n113\t  const ringRadius = s * 0.3 + s * 0.1 * Math.sin(phase * Math.PI * 2);\n114\t\n115\t  ctx.strokeStyle = 'rgba(150, 100, 255, 0.8)';\n116\t  ctx.lineWidth = 3 * scale;\n117\t  ctx.beginPath();\n118\t  ctx.arc(x + s / 2, y + s / 2, ringRadius, 0, Math.PI * 2);\n119\t  ctx.stroke();\n120\t\n121\t  // Inner glow\n122\t  ctx.fillStyle = 'rgba(180, 140, 255, 0.2)';\n123\t  ctx.beginPath();\n124\t  ctx.arc(x + s / 2, y + s / 2, ringRadius * 0.6, 0, Math.PI * 2);\n125\t  ctx.fill();\n126\t\n127\t  // Portal icon\n128\t  ctx.fillStyle = '#fff';\n129\t  ctx.font = `${Math.max(14, Math.floor(20 * scale))}px serif`;\n130\t  ctx.textAlign = 'center';\n131\t  ctx.textBaseline = 'middle';\n132\t  ctx.fillText('🌀', x + s / 2, y + s / 2);\n133\t\n134\t  // Label\n135\t  ctx.font = `bold ${Math.max(6, Math.floor(8 * scale))}px monospace`;\n136\t  ctx.fillStyle = '#b480ff';\n137\t  ctx.fillText('跨域', x + s / 2, y + s - 6 * scale);\n138\t}\n139\t\n140\t// Render a space fold gate on canvas\n141\texport function renderSpaceFoldGate(\n142\t  ctx: CanvasRenderingContext2D,\n143\t  gridX: number,\n144\t  gridY: number,\n145\t  offsetX: number,\n146\t  offsetY: number,\n147\t  scale: number,\n148\t  cellSize: number,\n149\t  now: number,\n150\t): void {\n151\t  const x = offsetX + gridX * cellSize * scale;\n152\t  const y = offsetY + gridY * cellSize * scale;\n153\t  const s = 3 * cellSize * scale;\n154\t\n155\t  // Gate frame\n156\t  ctx.fillStyle = 'rgba(200, 100, 255, 0.25)';\n157\t  ctx.fillRect(x + 2, y + 2, s - 4, s - 4);\n158\t\n159\t  // Animated warp effect\n160\t  const phase = (now / 1500) % 1;\n161\t  for (let i = 0; i < 3; i++) {\n162\t    const r = s * (0.15 + i * 0.1) + s * 0.05 * Math.sin((phase + i * 0.3) * Math.PI * 2);\n163\t    ctx.strokeStyle = `rgba(220, 150, 255, ${0.6 - i * 0.15})`;\n164\t    ctx.lineWidth = 2 * scale;\n165\t    ctx.beginPath();\n166\t    ctx.arc(x + s / 2, y + s / 2, r, 0, Math.PI * 2);\n167\t    ctx.stroke();\n168\t  }\n169\t\n170\t  // Gate icon\n171\t  ctx.fillStyle = '#fff';\n172\t  ctx.font = `${Math.max(14, Math.floor(20 * scale))}px serif`;\n173\t  ctx.textAlign = 'center';\n174\t  ctx.textBaseline = 'middle';\n175\t  ctx.fillText('🌀', x + s / 2, y + s / 2);\n176\t\n177\t  ctx.font = `bold ${Math.max(6, Math.floor(8 * scale))}px monospace`;\n178\t  ctx.fillStyle = '#dc96ff';\n179\t  ctx.fillText('折叠', x + s / 2, y + s - 6 * scale);\n180\t}\n181\t"}]},"parent_tool_use_id":"call_2ec493ea325448abb2fac585","session_id":"561a5118-a4d0-464b-8f32-001690e29cb0","uuid":"e3b343d4-6615-456e-b96e-715a1b864655","timestamp":"2026-05-23T10:13:47.241Z","subagent_type":"general-purpose","task_description":"Read cultivation factory source"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_70b80e1cb3b5499dadcfd72e","type":"tool_result","content":"1\t// Renderer.ts — Canvas 2D rendering system\n2\t\n3\timport { Camera } from './Camera';\n4\timport { GameMap } from '../game/Map';\n5\timport type { BuildingInstance } from '../game/GameState';\n6\timport { renderBuilding } from '../game/Building';\n7\timport type { BuildingDef } from '../game/Building';\n8\timport { getResourceDisplays, formatAmount } from '../game/Resources';\n9\timport type { Resources, RealmProgress } from '../game/GameState';\n10\timport { type CultivationState, getFullRealmName, getShortRealmName } from '../game/Cultivation';\n11\t\n12\texport class Renderer {\n13\t  canvas: HTMLCanvasElement;\n14\t  ctx: CanvasRenderingContext2D;\n15\t  camera: Camera;\n16\t\n17\t  constructor(canvas: HTMLCanvasElement) {\n18\t    this.canvas = canvas;\n19\t    this.ctx = canvas.getContext('2d')!;\n20\t    this.camera = new Camera(canvas);\n21\t    this.resize();\n22\t  }\n23\t\n24\t  resize(): void {\n25\t    const dpr = window.devicePixelRatio || 1;\n26\t    const rect = this.canvas.getBoundingClientRect();\n27\t    this.canvas.width = rect.width * dpr;\n28\t    this.canvas.height = rect.height * dpr;\n29\t    this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n30\t  }\n31\t\n32\t  render(\n33\t    map: GameMap,\n34\t    buildings: BuildingInstance[],\n35\t    buildingDefs: Map<string, BuildingDef>,\n36\t    resources: Resources,\n37\t    realm: RealmProgress,\n38\t    cultivation: CultivationState,\n39\t    hoveredCell: { gx: number; gy: number } | null,\n40\t    placementPreview: { def: BuildingDef; gx: number; gy: number; valid: boolean } | null,\n41\t    now: number,\n42\t  ): void {\n43\t    const ctx = this.ctx;\n44\t    const w = this.canvas.getBoundingClientRect().width;\n45\t    const h = this.canvas.getBoundingClientRect().height;\n46\t\n47\t    ctx.fillStyle = '#1a1a2e';\n48\t    ctx.fillRect(0, 0, w, h);\n49\t\n50\t    const { offsetX, offsetY, scale } = this.camera.getTransform();\n51\t\n52\t    map.render(ctx, offsetX, offsetY, w, h, scale);\n53\t\n54\t    for (const building of buildings) {\n55\t      const def = buildingDefs.get(building.buildingId);\n56\t      if (def) {\n57\t        renderBuilding(ctx, building, def, offsetX, offsetY, scale, map.cellSize, now);\n58\t      }\n59\t    }\n60\t\n61\t    if (placementPreview) {\n62\t      this.renderPlacementPreview(ctx, placementPreview, offsetX, offsetY, scale, map.cellSize);\n63\t    }\n64\t\n65\t    if (hoveredCell && map.inBounds(hoveredCell.gx, hoveredCell.gy)) {\n66\t      const hx = offsetX + hoveredCell.gx * map.cellSize * scale;\n67\t      const hy = offsetY + hoveredCell.gy * map.cellSize * scale;\n68\t      const hs = map.cellSize * scale;\n69\t      ctx.strokeStyle = 'rgba(255,255,255,0.4)';\n70\t      ctx.lineWidth = 1;\n71\t      ctx.strokeRect(hx, hy, hs, hs);\n72\t    }\n73\t\n74\t    this.renderUI(ctx, w, h, resources, realm, cultivation);\n75\t  }\n76\t\n77\t  private renderPlacementPreview(\n78\t    ctx: CanvasRenderingContext2D,\n79\t    preview: { def: BuildingDef; gx: number; gy: number; valid: boolean },\n80\t    offsetX: number,\n81\t    offsetY: number,\n82\t    scale: number,\n83\t    cellSize: number,\n84\t  ): void {\n85\t    const x = offsetX + preview.gx * cellSize * scale;\n86\t    const y = offsetY + preview.gy * cellSize * scale;\n87\t    const w = preview.def.size.w * cellSize * scale;\n88\t    const h = preview.def.size.h * cellSize * scale;\n89\t\n90\t    const { r, g, b } = preview.def.color;\n91\t    const alpha = preview.valid ? 0.4 : 0.2;\n92\t\n93\t    ctx.fillStyle = preview.valid\n94\t      ? `rgba(${r},${g},${b},${alpha})`\n95\t      : `rgba(255,50,50,${alpha})`;\n96\t    ctx.fillRect(x + 2, y + 2, w - 4, h - 4);\n97\t\n98\t    ctx.strokeStyle = preview.valid ? 'rgba(100,255,100,0.8)' : 'rgba(255,100,100,0.8)';\n99\t    ctx.lineWidth = 2;\n100\t    ctx.setLineDash([4, 4]);\n101\t    ctx.strokeRect(x + 2, y + 2, w - 4, h - 4);\n102\t    ctx.setLineDash([]);\n103\t  }\n104\t\n105\t  private renderUI(\n106\t    ctx: CanvasRenderingContext2D,\n107\t    canvasW: number,\n108\t    canvasH: number,\n109\t    resources: Resources,\n110\t    realm: RealmProgress,\n111\t    cultivation: CultivationState,\n112\t  ): void {\n113\t    // Top bar background\n114\t    ctx.fillStyle = 'rgba(0,0,0,0.8)';\n115\t    ctx.fillRect(0, 0, canvasW, 52);\n116\t\n117\t    // Realm display using cultivation system\n118\t    const realmName = getFullRealmName(cultivation);\n119\t    ctx.fillStyle = '#ffd700';\n120\t    ctx.font = 'bold 14px monospace';\n121\t    ctx.textAlign = 'left';\n122\t    ctx.textBaseline = 'middle';\n123\t    ctx.fillText(realmName, 12, 18);\n124\t\n125\t    // Cultivation exp bar\n126\t    const expBarX = 12;\n127\t    const expBarY = 32;\n128\t    const expBarW = 140;\n129\t    const expBarH = 12;\n130\t    const expRatio = cultivation.exp / cultivation.expToNext;\n131\t    ctx.fillStyle = 'rgba(255,255,255,0.1)';\n132\t    ctx.fillRect(expBarX, expBarY, expBarW, expBarH);\n133\t    ctx.fillStyle = '#ffd700';\n134\t    ctx.fillRect(expBarX, expBarY, expBarW * expRatio, expBarH);\n135\t    ctx.strokeStyle = 'rgba(255,255,255,0.3)';\n136\t    ctx.lineWidth = 1;\n137\t    ctx.strokeRect(expBarX, expBarY, expBarW, expBarH);\n138\t    ctx.fillStyle = '#fff';\n139\t    ctx.font = '9px monospace';\n140\t    ctx.textAlign = 'center';\n141\t    ctx.fillText(`${Math.floor(expRatio * 100)}%`, expBarX + expBarW / 2, expBarY + 7);\n142\t\n143\t    // Resource display\n144\t    const displays = getResourceDisplays(resources);\n145\t    let rx = canvasW - 12;\n146\t    ctx.textAlign = 'right';\n147\t    for (let i = displays.length - 1; i >= 0; i--) {\n148\t      const d = displays[i];\n149\t      if (d.amount === 0) continue;\n150\t      const text = `${d.icon} ${formatAmount(d.amount)}`;\n151\t      ctx.font = '11px monospace';\n152\t      const metrics = ctx.measureText(text);\n153\t      rx -= metrics.width + 4;\n154\t      ctx.fillStyle = d.color;\n155\t      ctx.fillText(text, rx + metrics.width, 24);\n156\t      rx -= 14;\n157\t    }\n158\t\n159\t    // Cultivation rate indicator\n160\t    if (cultivation.cultivationRate > 0) {\n161\t      ctx.fillStyle = 'rgba(255,215,0,0.6)';\n162\t      ctx.font = '10px monospace';\n163\t      ctx.textAlign = 'left';\n164\t      ctx.fillText(`⚡${cultivation.cultivationRate.toFixed(1)}/s`, 160, 18);\n165\t    }\n166\t  }\n167\t\n168\t  destroy(): void {\n169\t    // Clean up\n170\t  }\n171\t}\n172\t"}]},"parent_tool_use_id":"call_2ec493ea325448abb2fac585","session_id":"561a5118-a4d0-464b-8f32-001690e29cb0","uuid":"4252564d-85d1-49f5-aac3-d9d4c21c4a69","timestamp":"2026-05-23T10:13:47.242Z","subagent_type":"general-purpose","task_description":"Read cultivation factory source"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_8e429326c8104ca6841acf6b","type":"tool_result","content":"1\t// Camera.ts — Camera system with zoom, pan, and coordinate transformation\n2\t\n3\texport class Camera {\n4\t  x: number = 0;\n5\t  y: number = 0;\n6\t  zoom: number = 1;\n7\t  minZoom: number = 0.25;\n8\t  maxZoom: number = 4;\n9\t  targetZoom: number = 1;\n10\t\n11\t  private isDragging: boolean = false;\n12\t  private dragStartX: number = 0;\n13\t  private dragStartY: number = 0;\n14\t  private camStartX: number = 0;\n15\t  private camStartY: number = 0;\n16\t  private canvas: HTMLCanvasElement;\n17\t\n18\t  constructor(canvas: HTMLCanvasElement) {\n19\t    this.canvas = canvas;\n20\t    this.setupInput(canvas);\n21\t  }\n22\t\n23\t  // Center the camera on a map position\n24\t  centerOnMap(mapWidth: number, mapHeight: number, cellSize: number): void {\n25\t    const mapPixelW = mapWidth * cellSize * this.zoom;\n26\t    const mapPixelH = mapHeight * cellSize * this.zoom;\n27\t    this.x = (this.canvas.width - mapPixelW) / 2;\n28\t    this.y = (this.canvas.height - mapPixelH) / 2;\n29\t  }\n30\t\n31\t  // Convert screen coords to world coords\n32\t  screenToWorld(sx: number, sy: number): { wx: number; wy: number } {\n33\t    return {\n34\t      wx: (sx - this.x) / this.zoom,\n35\t      wy: (sy - this.y) / this.zoom,\n36\t    };\n37\t  }\n38\t\n39\t  // Convert world coords to screen coords\n40\t  worldToScreen(wx: number, wy: number): { sx: number; sy: number } {\n41\t    return {\n42\t      sx: wx * this.zoom + this.x,\n43\t      sy: wy * this.zoom + this.y,\n44\t    };\n45\t  }\n46\t\n47\t  // Get the offset and scale for rendering\n48\t  getTransform(): { offsetX: number; offsetY: number; scale: number } {\n49\t    return {\n50\t      offsetX: this.x,\n51\t      offsetY: this.y,\n52\t      scale: this.zoom,\n53\t    };\n54\t  }\n55\t\n56\t  // Zoom toward a point (usually mouse position)\n57\t  zoomAt(delta: number, screenX: number, screenY: number): void {\n58\t    const oldZoom = this.zoom;\n59\t    this.targetZoom = Math.max(this.minZoom, Math.min(this.maxZoom, this.targetZoom * (1 - delta * 0.001)));\n60\t    this.zoom = this.targetZoom;\n61\t\n62\t    // Adjust position to zoom toward the cursor\n63\t    const zoomRatio = this.zoom / oldZoom;\n64\t    this.x = screenX - (screenX - this.x) * zoomRatio;\n65\t    this.y = screenY - (screenY - this.y) * zoomRatio;\n66\t  }\n67\t\n68\t  private setupInput(canvas: HTMLCanvasElement): void {\n69\t    // Mouse drag for panning\n70\t    canvas.addEventListener('mousedown', (e) => {\n71\t      if (e.button === 0 || e.button === 1) { // left or middle button\n72\t        this.isDragging = true;\n73\t        this.dragStartX = e.clientX;\n74\t        this.dragStartY = e.clientY;\n75\t        this.camStartX = this.x;\n76\t        this.camStartY = this.y;\n77\t      }\n78\t    });\n79\t\n80\t    canvas.addEventListener('mousemove', (e) => {\n81\t      if (!this.isDragging) return;\n82\t      this.x = this.camStartX + (e.clientX - this.dragStartX);\n83\t      this.y = this.camStartY + (e.clientY - this.dragStartY);\n84\t    });\n85\t\n86\t    canvas.addEventListener('mouseup', () => {\n87\t      this.isDragging = false;\n88\t    });\n89\t\n90\t    canvas.addEventListener('mouseleave', () => {\n91\t      this.isDragging = false;\n92\t    });\n93\t\n94\t    // Mouse wheel for zooming\n95\t    canvas.addEventListener('wheel', (e) => {\n96\t      e.preventDefault();\n97\t      this.zoomAt(e.deltaY, e.offsetX, e.offsetY);\n98\t    }, { passive: false });\n99\t\n100\t    // Touch support\n101\t    let lastTouchDist = 0;\n102\t    let lastTouchCenter = { x: 0, y: 0 };\n103\t\n104\t    canvas.addEventListener('touchstart', (e) => {\n105\t      if (e.touches.length === 1) {\n106\t        this.isDragging = true;\n107\t        this.dragStartX = e.touches[0].clientX;\n108\t        this.dragStartY = e.touches[0].clientY;\n109\t        this.camStartX = this.x;\n110\t        this.camStartY = this.y;\n111\t      } else if (e.touches.length === 2) {\n112\t        this.isDragging = false;\n113\t        lastTouchDist = this.getTouchDistance(e.touches);\n114\t        lastTouchCenter = this.getTouchCenter(e.touches);\n115\t      }\n116\t      e.preventDefault();\n117\t    }, { passive: false });\n118\t\n119\t    canvas.addEventListener('touchmove', (e) => {\n120\t      if (e.touches.length === 1 && this.isDragging) {\n121\t        this.x = this.camStartX + (e.touches[0].clientX - this.dragStartX);\n122\t        this.y = this.camStartY + (e.touches[0].clientY - this.dragStartY);\n123\t      } else if (e.touches.length === 2) {\n124\t        const dist = this.getTouchDistance(e.touches);\n125\t        const center = this.getTouchCenter(e.touches);\n126\t        const delta = lastTouchDist - dist;\n127\t        this.zoomAt(delta * 2, center.x, center.y);\n128\t        lastTouchDist = dist;\n129\t      }\n130\t      e.preventDefault();\n131\t    }, { passive: false });\n132\t\n133\t    canvas.addEventListener('touchend', () => {\n134\t      this.isDragging = false;\n135\t    });\n136\t  }\n137\t\n138\t  private getTouchDistance(touches: TouchList): number {\n139\t    const dx = touches[0].clientX - touches[1].clientX;\n140\t    const dy = touches[0].clientY - touches[1].clientY;\n141\t    return Math.sqrt(dx * dx + dy * dy);\n142\t  }\n143\t\n144\t  private getTouchCenter(touches: TouchList): { x: number; y: number } {\n145\t    return {\n146\t      x: (touches[0].clientX + touches[1].clientX) / 2,\n147\t      y: (touches[0].clientY + touches[1].clientY) / 2,\n148\t    };\n149\t  }\n150\t\n151\t  // Check if the camera was dragged (for distinguishing click vs drag)\n152\t  wasDragged(): boolean {\n153\t    return this.isDragging && (\n154\t      Math.abs(this.x - this.camStartX) > 3 ||\n155\t      Math.abs(this.y - this.camStartY) > 3\n156\t    );\n157\t  }\n158\t}\n159\t"}]},"parent_tool_use_id":"call_2ec493ea325448abb2fac585","session_id":"561a5118-a4d0-464b-8f32-001690e29cb0","uuid":"c9437a0f-cfa5-43e5-b43f-486dcea47823","timestamp":"2026-05-23T10:13:47.243Z","subagent_type":"general-purpose","task_description":"Read cultivation factory source"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_996b11dd156347d78114b8e0","type":"tool_result","content":"1\t// App.ts — Game main loop (v0.4.0 — M4: 元婴+化神, 跨区域传送, 高级丹方, 终局内容)\n2\t\n3\timport { Renderer } from './Renderer';\n4\timport { GameMap } from '../game/Map';\n5\timport {\n6\t  type GameState,\n7\t  type BuildingInstance,\n8\t  type AlchemySessionData,\n9\t  type GameMap as GameMapData,\n10\t  type CrossRegionLink,\n11\t  createInitialState,\n12\t  cloneState,\n13\t  setMap,\n14\t  placeBuilding,\n15\t  loadGame,\n16\t  saveGame,\n17\t  startAutoSave,\n18\t  stopAutoSave,\n19\t  addAchievement,\n20\t  addCrossRegionLink,\n21\t} from '../game/GameState';\n22\timport {\n23\t  type BuildingDef,\n24\t  loadBuildingDefs,\n25\t  createBuildingInstance,\n26\t  canPlace,\n27\t} from '../game/Building';\n28\timport {\n29\t  collectFromBuilding,\n30\t  plantField,\n31\t  tickAutoProduction,\n32\t  tickManualProduction,\n33\t  canAfford,\n34\t  deductCost,\n35\t} from '../game/Resources';\n36\timport {\n37\t  type CultivationState,\n38\t  type BreakthroughResult,\n39\t  addCultivationExp,\n40\t  canBreakthrough,\n41\t  attemptBreakthrough,\n42\t  getBreakthroughRequirements,\n43\t  getFullRealmName,\n44\t  isRealmUnlocked as cultivationIsRealmUnlocked,\n45\t  tickAutoCultivation,\n46\t} from '../game/Cultivation';\n47\timport {\n48\t  type AlchemyRecipe,\n49\t  getAvailableRecipes,\n50\t  canCraft,\n51\t  startCrafting,\n52\t  tickAlchemy,\n53\t  collectAlchemy,\n54\t  getRemainingTime,\n55\t} from '../game/Alchemy';\n56\timport {\n57\t  usePill,\n58\t  useMultiplePills,\n59\t  getAllPillDefs,\n60\t  type PillDef,\n61\t} from '../game/Inventory';\n62\timport { audioManager } from '../game/AudioManager';\n63\timport { getAllAchievements, checkAchievement, type AchievementContext } from '../game/Achievement';\n64\timport { getAscensionChallenge, checkAscensionRequirements, attemptAscension } from '../game/Ascension';\n65\timport { tickCrossRegionLinks, createCrossRegionLink, renderCrossRegionPortal } from '../game/CrossRegionTeleport';\n66\timport { processTalismans, renderTalisman, type TalismanInstance } from '../game/Talisman';\n67\timport type { Resources } from '../game/GameState';\n68\timport buildingData from '../data/buildings.json';\n69\timport regionData from '../data/regions.json';\n70\timport {\n71\t  type ConveyorSegment,\n72\t  type ConveyorItem,\n73\t  createSegment,\n74\t  buildSegmentMap,\n75\t  autoConnect,\n76\t  tickConveyorItems,\n77\t  renderConveyorSegment,\n78\t  renderConveyorItems,\n79\t} from '../game/ConveyorBelt';\n80\timport {\n81\t  type PuppetInstance,\n82\t  createPuppet,\n83\t  tickPuppet,\n84\t  renderPuppet,\n85\t} from '../game/Puppet';\n86\t\n87\texport type PlacementMode = BuildingDef | null;\n88\t\n89\texport interface GameNotification {\n90\t  id: number;\n91\t  text: string;\n92\t  type: 'info' | 'success' | 'warning' | 'error';\n93\t  time: number;\n94\t}\n95\t\n96\tinterface RegionDef {\n97\t  id: string;\n98\t  name: string;\n99\t  nameEn: string;\n100\t  width: number;\n101\t  height: number;\n102\t  unlockRealm: string;\n103\t  maxBuildings: number;\n104\t  specialResources: string[];\n105\t  terrainBase: string;\n106\t  color: { bg: string; grid: string };\n107\t}\n108\t\n109\tlet notifIdCounter = 0;\n110\t\n111\texport class App {\n112\t  canvas: HTMLCanvasElement;\n113\t  renderer: Renderer;\n114\t  state: GameState;\n115\t  buildingDefs: Map<string, BuildingDef>;\n116\t  regionDefs: RegionDef[];\n117\t  map: GameMap;\n118\t  currentRegionIndex = 0;\n119\t\n120\t  conveyorSegments: ConveyorSegment[] = [];\n121\t  conveyorItems: ConveyorItem[] = [];\n122\t  puppets: PuppetInstance[] = [];\n123\t  talismans: TalismanInstance[] = [];\n124\t\n125\t  private running = false;\n126\t  private lastFrameTime = 0;\n127\t  private animFrameId = 0;\n128\t  private lastTickTime = 0;\n129\t  private tickInterval = 200;\n130\t\n131\t  private hoveredCell: { gx: number; gy: number } | null = null;\n132\t  private clickStartTime = 0;\n133\t  private clickStartPos = { x: 0, y: 0 };\n134\t  placementMode: PlacementMode = null;\n135\t  private placementValid = false;\n136\t  private placementPos = { gx: 0, gy: 0 };\n137\t\n138\t  breakthroughAnim: { active: boolean; result: BreakthroughResult | null; startTime: number; duration: number } = {\n139\t    active: false,\n140\t    result: null,\n141\t    startTime: 0,\n142\t    duration: 3000,\n143\t  };\n144\t\n145\t  notifications: GameNotification[] = [];\n146\t\n147\t  // M4: Ascension animation\n148\t  ascensionAnim: { active: boolean; startTime: number; duration: number } = {\n149\t    active: false,\n150\t    startTime: 0,\n151\t    duration: 5000,\n152\t  };\n153\t\n154\t  onStateChange?: (state: GameState) => void;\n155\t  onBuildingSelect?: (building: BuildingInstance | null) => void;\n156\t  onNotification?: (notif: GameNotification) => void;\n157\t  onBreakthroughAnim?: (active: boolean, result: BreakthroughResult | null) => void;\n158\t  onAlchemyUpdate?: (session: AlchemySessionData | null) => void;\n159\t  onRegionChange?: (regionIndex: number, region: RegionDef) => void;\n160\t  onAchievementUnlocked?: (achievementId: string) => void;\n161\t\n162\t  constructor(canvas: HTMLCanvasElement) {\n163\t    this.canvas = canvas;\n164\t    this.renderer = new Renderer(canvas);\n165\t\n166\t    const saved = loadGame();\n167\t    this.state = saved ? saved : createInitialState();\n168\t\n169\t    this.buildingDefs = loadBuildingDefs(buildingData as unknown as { buildings: BuildingDef[] });\n170\t    this.regionDefs = (regionData as { regions: RegionDef[] }).regions;\n171\t\n172\t    this.map = new GameMap(20, 15, '#2a3a1a', '#3a4a2a');\n173\t    this.map.generateStartingArea();\n174\t\n175\t    if (this.state.maps.length === 0) {\n176\t      this.state = setMap(this.state, 0, {\n177\t        regionId: 'liqi_flat',\n178\t        width: 20,\n179\t        height: 15,\n180\t        terrain: this.map.terrain,\n181\t        buildings: [],\n182\t      });\n183\t    } else {\n184\t      const mapData = this.state.maps[this.state.currentRegionIndex];\n185\t      if (mapData) {\n186\t        this.currentRegionIndex = this.state.currentRegionIndex;\n187\t        this.loadRegionMap(this.currentRegionIndex);\n188\t      }\n189\t    }\n190\t\n191\t    this.setupInput(canvas);\n192\t\n193\t    window.addEventListener('resize', () => {\n194\t      this.renderer.resize();\n195\t    });\n196\t  }\n197\t\n198\t  private loadRegionMap(index: number): void {\n199\t    const mapData = this.state.maps[index];\n200\t    if (!mapData) return;\n201\t\n202\t    const regionDef = this.regionDefs.find(r => r.id === mapData.regionId);\n203\t    const bg = regionDef?.color.bg ?? '#2a3a1a';\n204\t    const grid = regionDef?.color.grid ?? '#3a4a2a';\n205\t\n206\t    this.map = new GameMap(mapData.width, mapData.height, bg, grid);\n207\t    this.map.terrain = mapData.terrain;\n208\t    this.currentRegionIndex = index;\n209\t  }\n210\t\n211\t  initRegion(regionDef: RegionDef): number {\n212\t    const existing = this.state.maps.findIndex(m => m.regionId === regionDef.id);\n213\t    if (existing >= 0) return existing;\n214\t\n215\t    const newMap = new GameMap(regionDef.width, regionDef.height, regionDef.color.bg, regionDef.color.grid);\n216\t    newMap.generateRegionTerrain(regionDef.id);\n217\t\n218\t    const index = this.state.maps.length;\n219\t    this.state = setMap(this.state, index, {\n220\t      regionId: regionDef.id,\n221\t      width: regionDef.width,\n222\t      height: regionDef.height,\n223\t      terrain: newMap.terrain,\n224\t      buildings: [],\n225\t    });\n226\t\n227\t    return index;\n228\t  }\n229\t\n230\t  switchRegion(index: number): boolean {\n231\t    if (index < 0 || index >= this.state.maps.length) return false;\n232\t    if (index === this.currentRegionIndex) return false;\n233\t\n234\t    this.currentRegionIndex = index;\n235\t    this.state.currentRegionIndex = index;\n236\t    this.loadRegionMap(index);\n237\t\n238\t    const regionDef = this.regionDefs.find(r => r.id === this.state.maps[index]?.regionId);\n239\t    if (regionDef) {\n240\t      this.onRegionChange?.(index, regionDef);\n241\t    }\n242\t\n243\t    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);\n244\t    this.onStateChange?.(this.state);\n245\t    return true;\n246\t  }\n247\t\n248\t  getUnlockedRegions(): Array<RegionDef & { index: number }> {\n249\t    return this.regionDefs\n250\t      .map((r) => {\n251\t        if (cultivationIsRealmUnlocked(r.unlockRealm, this.state.cultivation)) {\n252\t          const mapIndex = this.state.maps.findIndex(m => m.regionId === r.id);\n253\t          if (mapIndex < 0) {\n254\t            this.initRegion(r);\n255\t          }\n256\t          const actualIndex = Math.max(0, this.state.maps.findIndex(m => m.regionId === r.id));\n257\t          return { ...r, index: actualIndex };\n258\t        }\n259\t        return null;\n260\t      })\n261\t      .filter((r): r is RegionDef & { index: number } => r !== null);\n262\t  }\n263\t\n264\t  start(): void {\n265\t    if (this.running) return;\n266\t    this.running = true;\n267\t    this.lastFrameTime = performance.now();\n268\t    this.lastTickTime = this.lastFrameTime;\n269\t\n270\t    // Restore persisted conveyors/puppets/talismans\n271\t    if (this.state.savedConveyors?.length) {\n272\t      this.conveyorSegments = this.state.savedConveyors;\n273\t    }\n274\t    if (this.state.savedPuppets?.length) {\n275\t      this.puppets = this.state.savedPuppets;\n276\t    }\n277\t    if (this.state.savedTalismans?.length) {\n278\t      this.talismans = this.state.savedTalismans;\n279\t    }\n280\t\n281\t    this.loop(this.lastFrameTime);\n282\t\n283\t    startAutoSave(() => this.getSaveableState());\n284\t  }\n285\t\n286\t  private getSaveableState(): GameState {\n287\t    const state = cloneState(this.state);\n288\t    state.savedConveyors = this.conveyorSegments;\n289\t    state.savedPuppets = this.puppets;\n290\t    state.savedTalismans = this.talismans;\n291\t    return state;\n292\t  }\n293\t\n294\t  stop(): void {\n295\t    this.running = false;\n296\t    if (this.animFrameId) {\n297\t      cancelAnimationFrame(this.animFrameId);\n298\t    }\n299\t    stopAutoSave();\n300\t    saveGame(this.getSaveableState());\n301\t  }\n302\t\n303\t  private loop = (now: number): void => {\n304\t    if (!this.running) return;\n305\t\n306\t    const dt = now - this.lastFrameTime;\n307\t    this.lastFrameTime = now;\n308\t\n309\t    this.state.totalPlaytime += dt / 1000;\n310\t\n311\t    if (now - this.lastTickTime >= this.tickInterval) {\n312\t      this.tickProduction(now);\n313\t      this.lastTickTime = now;\n314\t    }\n315\t\n316\t    this.render(now);\n317\t\n318\t    this.animFrameId = requestAnimationFrame(this.loop);\n319\t  };\n320\t\n321\t  private tickProduction(now: number): void {\n322\t    this.state = tickAutoProduction(this.state, this.currentRegionIndex, now, this.buildingDefs);\n323\t    this.state = tickManualProduction(this.state, this.currentRegionIndex, now, this.buildingDefs);\n324\t\n325\t    this.state.cultivation = tickAutoCultivation(this.state.cultivation, this.tickInterval);\n326\t\n327\t    if (this.state.alchemySession) {\n328\t      this.state.alchemySession = tickAlchemy(this.state.alchemySession, now);\n329\t      this.onAlchemyUpdate?.(this.state.alchemySession);\n330\t    }\n331\t\n332\t    // M3: Conveyor items tick\n333\t    if (this.conveyorSegments.length > 0) {\n334\t      const segMap = buildSegmentMap(this.conveyorSegments);\n335\t      const result = tickConveyorItems(this.conveyorItems, segMap, this.tickInterval);\n336\t      this.conveyorItems = result.items;\n337\t\n338\t      for (const d of result.delivered) {\n339\t        const delta: Partial<Resources> = {};\n340\t        (delta as Record<string, number>)[d.resource] = d.amount;\n341\t        this.state = { ...this.state, resources: { ...this.state.resources, [d.resource]: (this.state.resources[d.resource] ?? 0) + d.amount } };\n342\t      }\n343\t    }\n344\t\n345\t    // M3: Puppet tick\n346\t    for (let i = 0; i < this.puppets.length; i++) {\n347\t      this.puppets[i] = tickPuppet(this.puppets[i], this.tickInterval);\n348\t    }\n349\t\n350\t    // M4: Cross-region teleport tick\n351\t    if (this.state.crossRegionLinks.length > 0) {\n352\t      const crResult = tickCrossRegionLinks(this.state.crossRegionLinks, this.state.resources, now);\n353\t      this.state.crossRegionLinks = crResult.links;\n354\t\n355\t      for (const t of crResult.transferred) {\n356\t        this.state = { ...this.state, resources: { ...this.state.resources, [t.resource]: (this.state.resources[t.resource] ?? 0) + t.amount } };\n357\t      }\n358\t    }\n359\t\n360\t    // M4: Achievement check (every 5 seconds)\n361\t    if (Math.floor(now / 5000) !== Math.floor((now - this.tickInterval) / 5000)) {\n362\t      this.checkAchievements();\n363\t    }\n364\t\n365\t    // Talisman processing\n366\t    if (this.talismans.length > 0) {\n367\t      const buildingCounts: Record<string, number> = {};\n368\t      for (const map of this.state.maps) {\n369\t        for (const b of map.buildings) {\n370\t          buildingCounts[b.buildingId] = (buildingCounts[b.buildingId] ?? 0) + 1;\n371\t        }\n372\t      }\n373\t      const talResult = processTalismans(\n374\t        this.talismans,\n375\t        this.state.resources,\n376\t        buildingCounts,\n377\t        this.state.realm.level,\n378\t        now,\n379\t      );\n380\t      this.talismans = talResult.talismans;\n381\t      for (const action of talResult.actions) {\n382\t        if (action.type === 'notify') {\n383\t          this.addNotification(action.message, 'info');\n384\t        } else if (action.type === 'stop_building') {\n385\t          const bld = this.state.maps[this.currentRegionIndex]?.buildings.find(b => b.uid === action.buildingUid);\n386\t          if (bld) bld.isProducing = false;\n387\t        } else if (action.type === 'start_building') {\n388\t          const bld = this.state.maps[this.currentRegionIndex]?.buildings.find(b => b.uid === action.buildingUid);\n389\t          if (bld) bld.isProducing = true;\n390\t        }\n391\t      }\n392\t    }\n393\t\n394\t    this.onStateChange?.(this.state);\n395\t  }\n396\t\n397\t  // M4: Achievement checking\n398\t  private checkAchievements(): void {\n399\t    const buildingCounts: Record<string, number> = {};\n400\t    let totalBuildingCount = 0;\n401\t    for (const map of this.state.maps) {\n402\t      for (const b of map.buildings) {\n403\t        buildingCounts[b.buildingId] = (buildingCounts[b.buildingId] ?? 0) + 1;\n404\t        totalBuildingCount++;\n405\t      }\n406\t    }\n407\t\n408\t    const unlockedRegions = this.regionDefs\n409\t      .filter(r => cultivationIsRealmUnlocked(r.unlockRealm, this.state.cultivation))\n410\t      .map(r => r.id);\n411\t\n412\t    const context: AchievementContext = {\n413\t      currentRealmId: this.state.cultivation.realmId,\n414\t      realmOrder: ['fanren', 'liqi', 'zhuji', 'jindan', 'yuanying', 'huashen'],\n415\t      totalResourcesCollected: this.state.totalCollected as Record<string, number>,\n416\t      buildingCounts,\n417\t      totalBuildingCount,\n418\t      pillsCrafted: {},\n419\t      totalPillsCrafted: 0,\n420\t      allPillTypesCrafted: false,\n421\t      unlockedRegions,\n422\t      ascensionCompleted: this.state.ascensionCompleted,\n423\t      playtimeHours: this.state.totalPlaytime / 3600,\n424\t      crossRegionLinkCount: this.state.crossRegionLinks.length,\n425\t    };\n426\t\n427\t    for (const ach of getAllAchievements()) {\n428\t      if (this.state.achievements.includes(ach.id)) continue;\n429\t      if (checkAchievement(ach, context)) {\n430\t        this.state = addAchievement(this.state, ach.id);\n431\t        this.addNotification(`🏆 成就解锁: ${ach.name}`, 'success');\n432\t        this.onAchievementUnlocked?.(ach.id);\n433\t      }\n434\t    }\n435\t  }\n436\t\n437\t  private render(now: number): void {\n438\t    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n439\t    const preview = this.placementMode\n440\t      ? { def: this.placementMode, gx: this.placementPos.gx, gy: this.placementPos.gy, valid: this.placementValid }\n441\t      : null;\n442\t\n443\t    this.renderer.render(\n444\t      this.map,\n445\t      buildings,\n446\t      this.buildingDefs,\n447\t      this.state.resources,\n448\t      this.state.realm,\n449\t      this.state.cultivation,\n450\t      this.hoveredCell,\n451\t      preview,\n452\t      now,\n453\t    );\n454\t\n455\t    const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n456\t    const segMap = buildSegmentMap(this.conveyorSegments);\n457\t    for (const seg of this.conveyorSegments) {\n458\t      renderConveyorSegment(this.renderer.ctx, seg, offsetX, offsetY, scale, this.map.cellSize, now);\n459\t    }\n460\t    renderConveyorItems(this.renderer.ctx, this.conveyorItems, segMap, offsetX, offsetY, scale, this.map.cellSize);\n461\t\n462\t    for (const puppet of this.puppets) {\n463\t      renderPuppet(this.renderer.ctx, puppet, offsetX, offsetY, scale, this.map.cellSize, now);\n464\t    }\n465\t\n466\t    for (const talisman of this.talismans) {\n467\t      renderTalisman(this.renderer.ctx, talisman, offsetX, offsetY, scale, this.map.cellSize, now);\n468\t    }\n469\t\n470\t    // M4: Render cross-region portals in current map\n471\t    for (const link of this.state.crossRegionLinks) {\n472\t      if (link.fromRegionIndex === this.currentRegionIndex) {\n473\t        renderCrossRegionPortal(this.renderer.ctx, link.fromX, link.fromY, offsetX, offsetY, scale, this.map.cellSize, now);\n474\t      }\n475\t    }\n476\t\n477\t    if (this.breakthroughAnim.active) {\n478\t      this.renderBreakthroughOverlay(now);\n479\t    }\n480\t\n481\t    if (this.ascensionAnim.active) {\n482\t      this.renderAscensionOverlay(now);\n483\t    }\n484\t  }\n485\t\n486\t  private renderBreakthroughOverlay(now: number): void {\n487\t    const ctx = this.renderer.ctx;\n488\t    const w = this.canvas.getBoundingClientRect().width;\n489\t    const h = this.canvas.getBoundingClientRect().height;\n490\t\n491\t    const elapsed = now - this.breakthroughAnim.startTime;\n492\t    const progress = Math.min(1, elapsed / this.breakthroughAnim.duration);\n493\t\n494\t    let alpha = 0;\n495\t    if (progress < 0.2) alpha = progress / 0.2;\n496\t    else if (progress > 0.8) alpha = (1 - progress) / 0.2;\n497\t    else alpha = 1;\n498\t\n499\t    const result = this.breakthroughAnim.result;\n500\t\n501\t    if (result?.success) {\n502\t      ctx.fillStyle = `rgba(255, 215, 0, ${alpha * 0.15})`;\n503\t      ctx.fillRect(0, 0, w, h);\n504\t\n505\t      ctx.fillStyle = `rgba(255, 215, 0, ${alpha})`;\n506\t      ctx.font = `bold ${24 + Math.sin(progress * Math.PI * 4) * 4}px serif`;\n507\t      ctx.textAlign = 'center';\n508\t      ctx.textBaseline = 'middle';\n509\t      ctx.fillText('⚡ 境界突破成功 ⚡', w / 2, h / 2 - 20);\n510\t\n511\t      ctx.font = '16px serif';\n512\t      ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;\n513\t      const realmName = getFullRealmName(this.state.cultivation);\n514\t      ctx.fillText(`进入 ${realmName}`, w / 2, h / 2 + 20);\n515\t    } else if (result) {\n516\t      ctx.fillStyle = `rgba(200, 50, 50, ${alpha * 0.15})`;\n517\t      ctx.fillRect(0, 0, w, h);\n518\t\n519\t      ctx.fillStyle = `rgba(255, 100, 100, ${alpha})`;\n520\t      ctx.font = 'bold 24px serif';\n521\t      ctx.textAlign = 'center';\n522\t      ctx.textBaseline = 'middle';\n523\t      ctx.fillText('突破失败...', w / 2, h / 2 - 20);\n524\t\n525\t      ctx.font = '14px serif';\n526\t      ctx.fillStyle = `rgba(255, 200, 200, ${alpha})`;\n527\t      ctx.fillText(`修为损失 ${Math.floor(result.penalty * 100)}%`, w / 2, h / 2 + 20);\n528\t    }\n529\t\n530\t    if (progress >= 1) {\n531\t      this.breakthroughAnim.active = false;\n532\t      this.breakthroughAnim.result = null;\n533\t      this.onBreakthroughAnim?.(false, null);\n534\t    }\n535\t  }\n536\t\n537\t  // M4: Ascension animation overlay\n538\t  private renderAscensionOverlay(now: number): void {\n539\t    const ctx = this.renderer.ctx;\n540\t    const w = this.canvas.getBoundingClientRect().width;\n541\t    const h = this.canvas.getBoundingClientRect().height;\n542\t\n543\t    const elapsed = now - this.ascensionAnim.startTime;\n544\t    const progress = Math.min(1, elapsed / this.ascensionAnim.duration);\n545\t\n546\t    // Golden-white gradient overlay\n547\t    let alpha = 0;\n548\t    if (progress < 0.15) alpha = progress / 0.15;\n549\t    else if (progress > 0.85) alpha = (1 - progress) / 0.15;\n550\t    else alpha = 1;\n551\t\n552\t    ctx.fillStyle = `rgba(255, 255, 200, ${alpha * 0.2})`;\n553\t    ctx.fillRect(0, 0, w, h);\n554\t\n555\t    // Radiating lines\n556\t    const centerX = w / 2;\n557\t    const centerY = h / 2;\n558\t    const lineCount = 12;\n559\t    for (let i = 0; i < lineCount; i++) {\n560\t      const angle = (i / lineCount) * Math.PI * 2 + progress * Math.PI;\n561\t      const len = 200 + Math.sin(progress * Math.PI * 6 + i) * 100;\n562\t      ctx.strokeStyle = `rgba(255, 215, 0, ${alpha * 0.3})`;\n563\t      ctx.lineWidth = 2;\n564\t      ctx.beginPath();\n565\t      ctx.moveTo(centerX, centerY);\n566\t      ctx.lineTo(centerX + Math.cos(angle) * len, centerY + Math.sin(angle) * len);\n567\t      ctx.stroke();\n568\t    }\n569\t\n570\t    ctx.fillStyle = `rgba(255, 215, 0, ${alpha})`;\n571\t    ctx.font = `bold ${28 + Math.sin(progress * Math.PI * 3) * 6}px serif`;\n572\t    ctx.textAlign = 'center';\n573\t    ctx.textBaseline = 'middle';\n574\t    ctx.fillText('🌟 飞升成功 🌟', w / 2, h / 2 - 30);\n575\t\n576\t    ctx.font = '18px serif';\n577\t    ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;\n578\t    ctx.fillText('飞升仙尊 — 全局效率×10', w / 2, h / 2 + 15);\n579\t\n580\t    ctx.font = '14px serif';\n581\t    ctx.fillStyle = `rgba(200, 200, 255, ${alpha})`;\n582\t    ctx.fillText('恭喜完成飞升挑战！', w / 2, h / 2 + 50);\n583\t\n584\t    if (progress >= 1) {\n585\t      this.ascensionAnim.active = false;\n586\t    }\n587\t  }\n588\t\n589\t  placeCurrentBuilding(): boolean {\n590\t    if (!this.placementMode) return false;\n591\t\n592\t    const def = this.placementMode;\n593\t    const { gx, gy } = this.placementPos;\n594\t\n595\t    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n596\t    if (!canPlace(this.map, def, gx, gy, buildings)) return false;\n597\t    if (!canAfford(this.state.resources, def.cost)) return false;\n598\t\n599\t    this.state = deductCost(this.state, def.cost);\n600\t\n601\t    // Handle conveyor/puppet placement\n602\t    if (def.category === 'transport' && (def.id === 'conveyor_lv1' || def.id === 'conveyor_lv2')) {\n603\t      const seg = createSegment(\n604\t        `seg_${Date.now()}_${Math.random().toString(36).slice(2)}`,\n605\t        gx, gy,\n606\t        def.id === 'conveyor_lv1' ? 1 : 2,\n607\t        'right',\n608\t      );\n609\t      const segMap = buildSegmentMap(this.conveyorSegments);\n610\t      this.conveyorSegments.push(autoConnect(seg, segMap));\n611\t      audioManager.playBuild();\n612\t      this.addNotification(`放置了 ${def.name}`, 'success');\n613\t      this.onStateChange?.(this.state);\n614\t      return true;\n615\t    }\n616\t\n617\t    if (def.category === 'automation' && def.id === 'puppet_sorter') {\n618\t      const puppet = createPuppet(\n619\t        `pup_${Date.now()}_${Math.random().toString(36).slice(2)}`,\n620\t        gx, gy, 1,\n621\t      );\n622\t      this.puppets.push(puppet);\n623\t      audioManager.playBuild();\n624\t      this.addNotification(`放置了 ${def.name}`, 'success');\n625\t      this.onStateChange?.(this.state);\n626\t      return true;\n627\t    }\n628\t\n629\t    const instance = createBuildingInstance(def.id, gx, gy);\n630\t    this.state = placeBuilding(this.state, this.currentRegionIndex, instance);\n631\t\n632\t    audioManager.playBuild();\n633\t    this.addNotification(`建造了 ${def.name}`, 'success');\n634\t    this.onStateChange?.(this.state);\n635\t    return true;\n636\t  }\n637\t\n638\t  private handleBuildingClick(building: BuildingInstance): void {\n639\t    const def = this.buildingDefs.get(building.buildingId);\n640\t    if (!def) return;\n641\t\n642\t    if (def.production.mode === 'manual') {\n643\t      if (def.category === 'farming') {\n644\t        if (!building.isProducing && building.progress < 1) {\n645\t          this.state = plantField(this.state, building, this.currentRegionIndex);\n646\t          audioManager.playCollect();\n647\t        } else if (building.progress >= 1) {\n648\t          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n649\t          audioManager.playHarvest();\n650\t          this.addNotification(`收获 ${def.production.amount} ${this.getResourceName(def.production.resource)}`, 'success');\n651\t        }\n652\t      } else if (def.category === 'mining') {\n653\t        this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n654\t        audioManager.playCollect();\n655\t      } else if (def.category === 'alchemy') {\n656\t        if (building.progress >= 1) {\n657\t          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n658\t          audioManager.playAlchemyComplete();\n659\t          this.addNotification(`获得 ${def.production.amount} ${this.getResourceName(def.production.resource)}`, 'success');\n660\t        } else if (!building.isProducing) {\n661\t          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n662\t          audioManager.playAlchemyStart();\n663\t        }\n664\t      } else if (def.category === 'cultivation') {\n665\t        if (!building.isProducing) {\n666\t          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n667\t        }\n668\t      }\n669\t      this.onStateChange?.(this.state);\n670\t    }\n671\t\n672\t    this.onBuildingSelect?.(building);\n673\t  }\n674\t\n675\t  usePillAction(pillId: string): boolean {\n676\t    const result = usePill(pillId, this.state.resources);\n677\t    if (!result) return false;\n678\t\n679\t    this.state.resources = result.resources as Resources;\n680\t    this.state.cultivation = addCultivationExp(this.state.cultivation, result.cultivation);\n681\t    this.state = this.addCultivationToRealm(result.cultivation);\n682\t\n683\t    audioManager.playUsePill();\n684\t    const pillName = this.getResourceName(pillId);\n685\t    this.addNotification(`服用 ${pillName}，修为+${result.cultivation}`, 'success');\n686\t    this.onStateChange?.(this.state);\n687\t    return true;\n688\t  }\n689\t\n690\t  useAllPills(pillId: string): boolean {\n691\t    const count = this.state.resources[pillId as keyof typeof this.state.resources] ?? 0;\n692\t    if (count <= 0) return false;\n693\t\n694\t    const result = useMultiplePills(pillId, count, this.state.resources);\n695\t    if (!result) return false;\n696\t\n697\t    this.state.resources = result.resources as Resources;\n698\t    this.state.cultivation = addCultivationExp(this.state.cultivation, result.cultivation);\n699\t    this.state = this.addCultivationToRealm(result.cultivation);\n700\t\n701\t    audioManager.playUsePill();\n702\t    this.addNotification(`服用 ${result.used} ${this.getResourceName(pillId)}，修为+${result.cultivation}`, 'success');\n703\t    this.onStateChange?.(this.state);\n704\t    return true;\n705\t  }\n706\t\n707\t  private addCultivationToRealm(amount: number): GameState {\n708\t    const next = cloneState(this.state);\n709\t    next.realm.exp += amount;\n710\t    while (next.realm.exp >= next.realm.expToNext) {\n711\t      next.realm.exp -= next.realm.expToNext;\n712\t      next.realm.level += 1;\n713\t      next.realm.expToNext = Math.floor(next.realm.expToNext * 1.8);\n714\t    }\n715\t    return next;\n716\t  }\n717\t\n718\t  attemptBreakthroughAction(): boolean {\n719\t    if (!canBreakthrough(this.state.cultivation)) {\n720\t      this.addNotification('修为不足，无法突破', 'warning');\n721\t      return false;\n722\t    }\n723\t\n724\t    const result = attemptBreakthrough(this.state.cultivation, this.state.resources);\n725\t    if (!result) {\n726\t      this.addNotification('材料不足，无法突破', 'warning');\n727\t      return false;\n728\t    }\n729\t\n730\t    this.state.cultivation = result.newState;\n731\t    this.state.resources = result.newResources as Resources;\n732\t\n733\t    if (result.result.success) {\n734\t      this.state.realm.realmId = result.newState.realmId;\n735\t      this.state.realm.level = result.newState.level;\n736\t      this.state.realm.exp = result.newState.exp;\n737\t      this.state.realm.expToNext = result.newState.expToNext;\n738\t    }\n739\t\n740\t    this.breakthroughAnim = {\n741\t      active: true,\n742\t      result: result.result,\n743\t      startTime: performance.now(),\n744\t      duration: 3000,\n745\t    };\n746\t\n747\t    if (result.result.success) {\n748\t      audioManager.playBreakthroughSuccess();\n749\t      this.addNotification(`突破成功！进入 ${getFullRealmName(this.state.cultivation)}`, 'success');\n750\t    } else {\n751\t      audioManager.playBreakthroughFail();\n752\t      this.addNotification(`突破失败，修为损失 ${Math.floor(result.result.penalty * 100)}%`, 'error');\n753\t    }\n754\t\n755\t    this.onBreakthroughAnim?.(true, result.result);\n756\t    this.onStateChange?.(this.state);\n757\t    return true;\n758\t  }\n759\t\n760\t  getBreakthroughInfo() {\n761\t    return getBreakthroughRequirements(this.state.cultivation);\n762\t  }\n763\t\n764\t  // === M4: Ascension Actions ===\n765\t\n766\t  getAscensionInfo() {\n767\t    return checkAscensionRequirements(this.state.resources, this.state.cultivation.totalCultivation);\n768\t  }\n769\t\n770\t  attemptAscensionAction(): boolean {\n771\t    const result = attemptAscension(this.state.resources, this.state.cultivation.totalCultivation);\n772\t    if (!result.success) {\n773\t      this.addNotification('飞升条件不满足', 'warning');\n774\t      return false;\n775\t    }\n776\t\n777\t    this.state.resources = result.newResources as Resources;\n778\t    this.state.ascensionCompleted = true;\n779\t\n780\t    this.ascensionAnim = {\n781\t      active: true,\n782\t      startTime: performance.now(),\n783\t      duration: 5000,\n784\t    };\n785\t\n786\t    audioManager.playBreakthroughSuccess();\n787\t    this.addNotification('🌟 飞升成功！获得称号：飞升仙尊', 'success');\n788\t    this.onStateChange?.(this.state);\n789\t    return true;\n790\t  }\n791\t\n792\t  // === M4: Cross-Region Link ===\n793\t\n794\t  createCrossRegionLinkAction(\n795\t    fromRegionIndex: number,\n796\t    fromX: number,\n797\t    fromY: number,\n798\t    toRegionIndex: number,\n799\t    toX: number,\n800\t    toY: number,\n801\t    resource: string,\n802\t    amount: number,\n803\t    interval: number,\n804\t  ): boolean {\n805\t    const id = `crl_${Date.now()}_${Math.random().toString(36).slice(2)}`;\n806\t    const link = createCrossRegionLink(id, fromRegionIndex, fromX, fromY, toRegionIndex, toX, toY, resource, amount, interval);\n807\t    this.state = addCrossRegionLink(this.state, link);\n808\t    this.addNotification(`建立跨区域传送链路`, 'success');\n809\t    this.onStateChange?.(this.state);\n810\t    return true;\n811\t  }\n812\t\n813\t  // === Alchemy Actions ===\n814\t\n815\t  getAvailableAlchemyRecipes(): AlchemyRecipe[] {\n816\t    return getAvailableRecipes((realm) => cultivationIsRealmUnlocked(realm, this.state.cultivation));\n817\t  }\n818\t\n819\t  startAlchemyAction(recipeId: string): boolean {\n820\t    const crafting = startCrafting(recipeId, this.state.resources);\n821\t    if (!crafting) return false;\n822\t\n823\t    this.state.resources = crafting.resources as Resources;\n824\t    this.state.alchemySession = crafting.session;\n825\t    audioManager.playAlchemyStart();\n826\t    this.addNotification(`开始炼丹`, 'info');\n827\t    this.onStateChange?.(this.state);\n828\t    this.onAlchemyUpdate?.(this.state.alchemySession);\n829\t    return true;\n830\t  }\n831\t\n832\t  collectAlchemyAction(): boolean {\n833\t    if (!this.state.alchemySession?.complete) return false;\n834\t\n835\t    const result = collectAlchemy(this.state.alchemySession, this.state.resources);\n836\t    if (!result) return false;\n837\t\n838\t    this.state.resources = result.resources as Resources;\n839\t    this.state.alchemySession = null;\n840\t\n841\t    if (result.success) {\n842\t      this.state.cultivation = addCultivationExp(this.state.cultivation, result.expReward);\n843\t      audioManager.playAlchemyComplete();\n844\t      this.addNotification(`炼丹成功！获得 ${result.amount} 颗丹药`, 'success');\n845\t    } else {\n846\t      audioManager.playAlchemyFail();\n847\t      this.addNotification('炼丹失败...', 'error');\n848\t    }\n849\t\n850\t    this.onStateChange?.(this.state);\n851\t    this.onAlchemyUpdate?.(null);\n852\t    return true;\n853\t  }\n854\t\n855\t  // === Notifications ===\n856\t\n857\t  addNotification(text: string, type: GameNotification['type'] = 'info'): void {\n858\t    const notif: GameNotification = {\n859\t      id: ++notifIdCounter,\n860\t      text,\n861\t      type,\n862\t      time: Date.now(),\n863\t    };\n864\t    this.notifications.push(notif);\n865\t    if (this.notifications.length > 10) {\n866\t      this.notifications = this.notifications.slice(-10);\n867\t    }\n868\t    this.onNotification?.(notif);\n869\t  }\n870\t\n871\t  // === Utility ===\n872\t\n873\t  private getResourceName(id: string): string {\n874\t    const names: Record<string, string> = {\n875\t      spirit_stone: '灵石',\n876\t      spirit_grass: '灵草',\n877\t      spirit_energy: '灵气',\n878\t      cultivation: '修为',\n879\t      pill_juling: '聚灵丹',\n880\t      pill_peiyuan: '培元丹',\n881\t      pill_ningqi: '凝气丹',\n882\t      pill_zhuji: '筑基丹',\n883\t      pill_jindanyin: '金丹引',\n884\t      pill_yuanyingguo: '元婴果',\n885\t      pill_huashenlu: '化神露',\n886\t      pill_jiuzhuan: '九转金丹',\n887\t      spirit_iron: '灵铁',\n888\t      spirit_wood: '灵木',\n889\t      talisman_paper: '符纸',\n890\t      monster_core: '妖丹',\n891\t      heaven_earth_liquid: '天地灵液',\n892\t      immortal_stone: '仙灵石',\n893\t      merit: '功德值',\n894\t    };\n895\t    return names[id] ?? id;\n896\t  }\n897\t\n898\t  centerCamera(): void {\n899\t    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);\n900\t  }\n901\t\n902\t  getAvailableBuildings(): BuildingDef[] {\n903\t    return Array.from(this.buildingDefs.values()).filter(def => {\n904\t      return cultivationIsRealmUnlocked(def.unlockRealm, this.state.cultivation);\n905\t    });\n906\t  }\n907\t\n908\t  getInventoryPills(): Array<PillDef & { count: number }> {\n909\t    const result: Array<PillDef & { count: number }> = [];\n910\t    for (const def of getAllPillDefs()) {\n911\t      const count = this.state.resources[def.id as keyof typeof this.state.resources] ?? 0;\n912\t      if (count > 0) {\n913\t        result.push({ ...def, count });\n914\t      }\n915\t    }\n916\t    return result;\n917\t  }\n918\t\n919\t  private setupInput(canvas: HTMLCanvasElement): void {\n920\t    canvas.addEventListener('mousemove', (e) => {\n921\t      const rect = canvas.getBoundingClientRect();\n922\t      const mx = e.clientX - rect.left;\n923\t      const my = e.clientY - rect.top;\n924\t\n925\t      const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n926\t      this.hoveredCell = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n927\t\n928\t      if (this.placementMode && this.hoveredCell) {\n929\t        this.placementPos = { gx: this.hoveredCell.gx, gy: this.hoveredCell.gy };\n930\t        const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n931\t        this.placementValid = canPlace(\n932\t          this.map,\n933\t          this.placementMode,\n934\t          this.placementPos.gx,\n935\t          this.placementPos.gy,\n936\t          buildings,\n937\t        );\n938\t      }\n939\t    });\n940\t\n941\t    canvas.addEventListener('mousedown', (e) => {\n942\t      if (e.button !== 0) return;\n943\t      this.clickStartTime = performance.now();\n944\t      this.clickStartPos = { x: e.clientX, y: e.clientY };\n945\t    });\n946\t\n947\t    canvas.addEventListener('mouseup', (e) => {\n948\t      if (e.button !== 0) return;\n949\t      const dt = performance.now() - this.clickStartTime;\n950\t      const dx = Math.abs(e.clientX - this.clickStartPos.x);\n951\t      const dy = Math.abs(e.clientY - this.clickStartPos.y);\n952\t\n953\t      if (dt < 300 && dx < 5 && dy < 5) {\n954\t        audioManager.init();\n955\t        audioManager.resume();\n956\t        this.handleClick(e);\n957\t      }\n958\t    });\n959\t\n960\t    document.addEventListener('keydown', (e) => {\n961\t      if (e.key === 'Escape') {\n962\t        this.placementMode = null;\n963\t      }\n964\t    });\n965\t  }\n966\t\n967\t  private handleClick(e: MouseEvent): void {\n968\t    const rect = this.canvas.getBoundingClientRect();\n969\t    const mx = e.clientX - rect.left;\n970\t    const my = e.clientY - rect.top;\n971\t    const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n972\t    const { gx, gy } = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n973\t\n974\t    if (!this.map.inBounds(gx, gy)) return;\n975\t\n976\t    if (this.placementMode) {\n977\t      this.placementPos = { gx, gy };\n978\t      const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n979\t      this.placementValid = canPlace(this.map, this.placementMode, gx, gy, buildings);\n980\t      if (this.placementValid) {\n981\t        this.placeCurrentBuilding();\n982\t      }\n983\t      return;\n984\t    }\n985\t\n986\t    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n987\t    const clicked = buildings.find(b => {\n988\t      const def = this.buildingDefs.get(b.buildingId);\n989\t      if (!def) return false;\n990\t      return (\n991\t        gx >= b.gridX && gx < b.gridX + def.size.w &&\n992\t        gy >= b.gridY && gy < b.gridY + def.size.h\n993\t      );\n994\t    });\n995\t\n996\t    if (clicked) {\n997\t      this.handleBuildingClick(clicked);\n998\t    }\n999\t  }\n1000\t}\n1001\t"}]},"parent_tool_use_id":"call_2ec493ea325448abb2fac585","session_id":"561a5118-a4d0-464b-8f32-001690e29cb0","uuid":"d63ee29b-1e22-4870-9023-d24d7ad144ff","timestamp":"2026-05-23T10:13:48.389Z","subagent_type":"general-purpose","task_description":"Read cultivation factory source"}
