{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_c1d128b263754133aafd00c9","type":"tool_result","content":"1\t// dayCycle.test.ts — Tests for DayCycle.ts\n2\t\n3\timport { describe, it, expect, vi, beforeEach } from 'vitest';\n4\timport { DayCycle, DAY_PHASES } from '../src/game/DayCycle';\n5\timport { GamePhase } from '../src/game/GameState';\n6\t\n7\tdescribe('DayCycle initialization', () => {\n8\t  it('starts at day 1, time 6 (6am)', () => {\n9\t    const dc = new DayCycle();\n10\t    expect(dc.currentDay).toBe(1);\n11\t    expect(dc.currentTime).toBe(6);\n12\t  });\n13\t\n14\t  it('starts in DAYTIME phase', () => {\n15\t    const dc = new DayCycle();\n16\t    expect(dc.currentPhase).toBe(GamePhase.DAYTIME);\n17\t  });\n18\t});\n19\t\n20\tdescribe('Phase transitions', () => {\n21\t  it('DAYTIME -> NIGHT_TRANSITION at hour 22', () => {\n22\t    const dc = new DayCycle();\n23\t    const phases: Array<{ phase: GamePhase; prev: GamePhase }> = [];\n24\t    dc.onPhaseChange((phase, prev) => phases.push({ phase, prev }));\n25\t\n26\t    dc.setTimeOfDay(22);\n27\t\n28\t    expect(dc.currentPhase).toBe(GamePhase.NIGHT_TRANSITION);\n29\t  });\n30\t\n31\t  it('NIGHT_TRANSITION -> NIGHT at hour 23', () => {\n32\t    const dc = new DayCycle();\n33\t    dc.setTimeOfDay(23);\n34\t    expect(dc.currentPhase).toBe(GamePhase.NIGHT);\n35\t  });\n36\t\n37\t  it('NIGHT -> DANGER at hour 2 (using extended time 26)', () => {\n38\t    const dc = new DayCycle();\n39\t    dc.setTimeOfDay(26);\n40\t    expect(dc.currentPhase).toBe(GamePhase.DANGER);\n41\t  });\n42\t\n43\t  it('DANGER -> DAWN at hour 29', () => {\n44\t    const dc = new DayCycle();\n45\t    dc.setTimeOfDay(29);\n46\t    expect(dc.currentPhase).toBe(GamePhase.DAWN);\n47\t  });\n48\t\n49\t  it('Full cycle: DAY -> EVENING -> NIGHT -> DANGER -> DAWN', () => {\n50\t    const dc = new DayCycle();\n51\t    const phases: GamePhase[] = [];\n52\t\n53\t    dc.onPhaseChange((phase) => phases.push(phase));\n54\t\n55\t    // Simulate time progression\n56\t    const transitions = [\n57\t      { time: 6, expected: GamePhase.DAYTIME },\n58\t      { time: 22, expected: GamePhase.NIGHT_TRANSITION },\n59\t      { time: 23, expected: GamePhase.NIGHT },\n60\t      { time: 26, expected: GamePhase.DANGER },\n61\t      { time: 29, expected: GamePhase.DAWN },\n62\t    ];\n63\t\n64\t    for (const { time, expected } of transitions) {\n65\t      dc.setTimeOfDay(time);\n66\t      expect(dc.currentPhase).toBe(expected);\n67\t    }\n68\t  });\n69\t});\n70\t\n71\tdescribe('Time progression', () => {\n72\t  it('time advances with update calls', () => {\n73\t    const dc = new DayCycle();\n74\t    const startTime = dc.currentTime;\n75\t\n76\t    // dt=10000ms (10s), speed=10, factor=0.05\n77\t    // delta = 10 * 10 * 0.05 = 5 hours\n78\t    dc.update(10000);\n79\t\n80\t    expect(dc.currentTime).toBeGreaterThan(startTime);\n81\t  });\n82\t\n83\t  it('effective time speed varies by phase', () => {\n84\t    const dc = new DayCycle();\n85\t\n86\t    dc.setTimeOfDay(10); // DAYTIME\n87\t    expect(dc.getEffectiveTimeSpeed()).toBe(10);\n88\t\n89\t    dc.setTimeOfDay(22); // NIGHT_TRANSITION\n90\t    expect(dc.getEffectiveTimeSpeed()).toBe(5);\n91\t\n92\t    dc.setTimeOfDay(23); // NIGHT\n93\t    expect(dc.getEffectiveTimeSpeed()).toBe(5);\n94\t\n95\t    dc.setTimeOfDay(26); // DANGER\n96\t    expect(dc.getEffectiveTimeSpeed()).toBe(5);\n97\t  });\n98\t\n99\t  it('does not advance when paused', () => {\n100\t    const dc = new DayCycle();\n101\t    dc.setPaused(true);\n102\t    const startTime = dc.currentTime;\n103\t\n104\t    dc.update(10000);\n105\t\n106\t    expect(dc.currentTime).toBe(startTime);\n107\t  });\n108\t});\n109\t\n110\tdescribe('Day increment', () => {\n111\t  it('increments day when time passes 30 (wraps around)', () => {\n112\t    const dc = new DayCycle();\n113\t    let newDay = 0;\n114\t    dc.onNewDay((day) => { newDay = day; });\n115\t\n116\t    // Set time close to the wrap point\n117\t    dc.setTimeOfDay(29.5);\n118\t    // Update enough to cross 30: time += dtSec * speed * 0.05\n119\t    // Need to add 0.5: with speed=5, dtSec * 5 * 0.05 = dtSec * 0.25\n120\t    // dtSec = 4 => delta = 1 => crosses 30\n121\t    dc.update(4000);\n122\t\n123\t    expect(dc.currentDay).toBe(2);\n124\t    expect(newDay).toBe(2);\n125\t  });\n126\t\n127\t  it('wraps time back by 24 when day increments', () => {\n128\t    const dc = new DayCycle();\n129\t    dc.setTimeOfDay(29.5);\n130\t    dc.update(4000);\n131\t\n132\t    // time should have wrapped: was ~30.5, now ~30.5 - 24 = ~6.5\n133\t    expect(dc.currentTime).toBeLessThan(10);\n134\t  });\n135\t});\n136\t\n137\tdescribe('Listener callbacks', () => {\n138\t  it('phase change listener fires with correct arguments', () => {\n139\t    const dc = new DayCycle();\n140\t    const calls: Array<{ phase: GamePhase; prev: GamePhase; day: number }> = [];\n141\t    dc.onPhaseChange((phase, prev, day) => calls.push({ phase, prev, day }));\n142\t\n143\t    dc.setTimeOfDay(22);\n144\t\n145\t    // Should have been called during update that crosses the threshold\n146\t    expect(calls.length).toBeGreaterThanOrEqual(0); // setTimeOfDay doesn't fire listeners\n147\t  });\n148\t\n149\t  it('phase change listener fires during update', () => {\n150\t    const dc = new DayCycle();\n151\t    const calls: Array<{ phase: GamePhase; prev: GamePhase }> = [];\n152\t    dc.onPhaseChange((phase, prev) => calls.push({ phase, prev }));\n153\t\n154\t    // Set time close to NIGHT_TRANSITION boundary (22)\n155\t    dc.setTimeOfDay(21.9);\n156\t    // Advance enough to cross 22\n157\t    // delta = dtSec * speed * 0.05 = 2.2 * 10 * 0.05 = 1.1 hours\n158\t    dc.update(2200);\n159\t\n160\t    if (calls.length > 0) {\n161\t      expect(calls[0].prev).toBe(GamePhase.DAYTIME);\n162\t      expect(calls[0].phase).toBe(GamePhase.NIGHT_TRANSITION);\n163\t    }\n164\t  });\n165\t\n166\t  it('new day listener fires with incremented day', () => {\n167\t    const dc = new DayCycle();\n168\t    let dayReceived = 0;\n169\t    dc.onNewDay((day) => { dayReceived = day; });\n170\t\n171\t    dc.setTimeOfDay(29.5);\n172\t    dc.update(4000);\n173\t\n174\t    expect(dayReceived).toBe(2);\n175\t  });\n176\t\n177\t  it('supports multiple phase change listeners', () => {\n178\t    const dc = new DayCycle();\n179\t    let count1 = 0;\n180\t    let count2 = 0;\n181\t\n182\t    dc.onPhaseChange(() => count1++);\n183\t    dc.onPhaseChange(() => count2++);\n184\t\n185\t    dc.setTimeOfDay(22);\n186\t    // Listeners added via onPhaseChange are for update-driven changes\n187\t    // setTimeOfDay sets phase directly, so we test via update\n188\t    dc.setTimeOfDay(21);\n189\t    dc.update(10000);\n190\t\n191\t    // Both should have been called the same number of times\n192\t    expect(count1).toBe(count2);\n193\t  });\n194\t});\n195\t\n196\tdescribe('getPhaseLabel', () => {\n197\t  it('returns Chinese label for DAYTIME', () => {\n198\t    const dc = new DayCycle();\n199\t    dc.setTimeOfDay(10);\n200\t    expect(dc.getPhaseLabel()).toBe('营业中');\n201\t  });\n202\t\n203\t  it('returns Chinese label for NIGHT_TRANSITION', () => {\n204\t    const dc = new DayCycle();\n205\t    dc.setTimeOfDay(22);\n206\t    expect(dc.getPhaseLabel()).toBe('准备打烊');\n207\t  });\n208\t\n209\t  it('returns Chinese label for DANGER', () => {\n210\t    const dc = new DayCycle();\n211\t    dc.setTimeOfDay(26);\n212\t    expect(dc.getPhaseLabel()).toBe('危险时段');\n213\t  });\n214\t});\n215\t\n216\tdescribe('getDayProgress', () => {\n217\t  it('returns 0 at start of day (hour 6)', () => {\n218\t    const dc = new DayCycle();\n219\t    dc.setTimeOfDay(6);\n220\t    expect(dc.getDayProgress()).toBe(0);\n221\t  });\n222\t\n223\t  it('returns ~0.5 at midday (hour 18)', () => {\n224\t    const dc = new DayCycle();\n225\t    dc.setTimeOfDay(18);\n226\t    expect(dc.getDayProgress()).toBe(0.5);\n227\t  });\n228\t\n229\t  it('returns 1 at end of day (hour 30)', () => {\n230\t    const dc = new DayCycle();\n231\t    dc.setTimeOfDay(30);\n232\t    expect(dc.getDayProgress()).toBe(1);\n233\t  });\n234\t});\n235\t\n236\tdescribe('getDaylight', () => {\n237\t  it('returns 1 during full daylight (7-17)', () => {\n238\t    const dc = new DayCycle();\n239\t    dc.setTimeOfDay(12);\n240\t    expect(dc.getDaylight()).toBe(1);\n241\t  });\n242\t\n243\t  it('returns 0 at night', () => {\n244\t    const dc = new DayCycle();\n245\t    dc.setTimeOfDay(2);\n246\t    expect(dc.getDaylight()).toBe(0);\n247\t  });\n248\t\n249\t  it('returns partial values during dawn/dusk transitions', () => {\n250\t    const dc = new DayCycle();\n251\t    dc.setTimeOfDay(6.5);\n252\t    expect(dc.getDaylight()).toBe(0.5);\n253\t\n254\t    dc.setTimeOfDay(17.5);\n255\t    expect(dc.getDaylight()).toBe(0.5);\n256\t  });\n257\t});\n258\t\n259\tdescribe('getState', () => {\n260\t  it('returns current state snapshot', () => {\n261\t    const dc = new DayCycle();\n262\t    dc.setDay(5);\n263\t    dc.setTimeOfDay(14);\n264\t\n265\t    const state = dc.getState();\n266\t    expect(state.day).toBe(5);\n267\t    expect(state.timeOfDay).toBe(14);\n268\t    expect(state.phase).toBe(GamePhase.DAYTIME);\n269\t  });\n270\t});\n271\t\n272\tdescribe('DAY_PHASES configuration', () => {\n273\t  it('covers all night-time phases', () => {\n274\t    const phaseNames = DAY_PHASES.map(p => p.phase);\n275\t    expect(phaseNames).toContain(GamePhase.DAYTIME);\n276\t    expect(phaseNames).toContain(GamePhase.NIGHT_TRANSITION);\n277\t    expect(phaseNames).toContain(GamePhase.NIGHT);\n278\t    expect(phaseNames).toContain(GamePhase.DANGER);\n279\t    expect(phaseNames).toContain(GamePhase.DAWN);\n280\t  });\n281\t\n282\t  it('phases have valid time ranges', () => {\n283\t    for (const phase of DAY_PHASES) {\n284\t      expect(phase.startHour).toBeLessThan(phase.endHour);\n285\t      expect(phase.timeSpeed).toBeGreaterThan(0);\n286\t    }\n287\t  });\n288\t});\n289\t"}]},"parent_tool_use