Ms: number,\n): { puppet: PuppetInstance; didPickup: boolean; didDeliver: boolean } {\n  if (puppet.state === 'idle') return { puppet, didPickup: false, didDeliver: false };\n\n  const progress = puppet.actionProgress + dtMs / puppet.actionSpeed;\n  if (progress >= 1) {\n    // Action complete — transition state\n    if (puppet.state === 'idle') {\n      // Shouldn't happen but handle gracefully\n      return { puppet: { ...puppet, state: 'picking', actionProgress: 0 }, didPickup: false, didDeliver: false };\n    } else if (puppet.state === 'picking') {\n      // Transition from picking to delivering\n      const pickedUp = puppetPickup(puppet, puppet.heldItem?.resource ?? 'spirit_grass', puppet.heldItem?.amount ?? 1);\n      return { puppet: pickedUp, didPickup: true, didDeliver: false };\n    } else if (puppet.state === 'delivering') {\n      // Transition from delivering to idle\n      const result = puppetDeliver(puppet);\n      return { puppet: result.puppet, didPickup: false, didDeliver: true };\n    }\n    return { puppet: { ...puppet, actionProgress: 0 }, didPickup: false, didDeliver: false };\n  }\n  return { puppet: { ...puppet, actionProgress: progress }, didPickup: false, didDeliver: false };\n}\n","numLines":30,"startLine":130,"totalLines":215}}}
