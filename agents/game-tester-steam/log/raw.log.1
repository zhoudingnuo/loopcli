etEffectiveTimeSpeed();\n    this.timeOfDay += dtSec * speed * 0.05;\n\n    const prevPhase = this.phase;\n    this.phase = getPhaseFromTime(this.timeOfDay);\n\n    if (this.phase !== prevPhase) {\n      for (const listener of this.phaseListeners) {\n        listener(this.phase, prevPhase, this.day, this.timeOfDay);\n      }\n    }\n\n    if (this.timeOfDay >= 30) {\n      this.timeOfDay -= 24;\n      this.day++;\n      for (const listener of this.newDayListeners) {\n        listener(this.day);\n      }\n    }\n  }\n\n  getPhaseLabel(): string {\n    const config = DAY_PHASES.find(p => p.phase === this.phase);","numLines":40,"startLine":50,"totalLines":110}}}
