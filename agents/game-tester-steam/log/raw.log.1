_CUSTOMER,\n151\t    level: HorrorLevel.ENTITY,\n152\t    baseProbability: 0.08,\n153\t    minDay: 8, maxDay: 30,\n154\t    phaseRequired: [GamePhase.DANGER],\n155\t    minActiveDuration: 10000, maxActiveDuration: 18000,\n156\t    buildupDuration: 2000, resolveDuration: 3000,\n157\t    sanityCost: 12, cooldownSec: 240,\n158\t    description: '两个完全一样的顾客同时出现在店里',\n159\t  },\n160\t  {\n161\t    type: HorrorEventType.SHADOW_MISALIGN,\n162\t    level: HorrorLevel.ENTITY,\n163\t    baseProbability: 0.10,\n164\t    minDay: 6, maxDay: 30,\n165\t    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n166\t    minActiveDuration: 6000, maxActiveDuration: 12000,\n167\t    buildupDuration: 1500, resolveDuration: 1000,\n168\t    sanityCost: 8, cooldownSec: 150,\n169\t    description: '你的影子角度不对，或者有自己的动作',\n170\t  },\n171\t  {\n172\t    type: HorrorEventType.NEW_PRODUCT,\n173\t    level: HorrorLevel.ENTITY,\n174\t    baseProbability: 0.08,\n175\t    minDay: 7, maxDay: 30,\n176\t    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n177\t    minActiveDuration: 6000, maxActiveDuration: 10000,\n178\t    buildupDuration: 0, resolveDuration: 500,\n179\t    sanityCost: 7, cooldownSec: 200,\n180\t    description: '货架上出现了你没进过货的商品，包装文字无法辨认',\n181\t  },\n182\t  // Level 3: Threat\n183\t  {\n184\t    type: HorrorEventType.DOOR_AUTO_OPEN,\n185\t    level: HorrorLevel.THREAT,\n186\t    baseProbability: 0.10,\n187\t    minDay: 16, maxDay: 30,\n188\t    phaseRequired: [GamePhase.DANGER],\n189\t    minActiveDuration: 5000, maxActiveDuration: 8000,\n190\t    buildupDuration: 1000, resolveDuration: 2000,\n191\t    sanityCost: 15, cooldownSec: 180,\n192\t    description: '前门或后门自己打开，外面是完全的黑暗',\n193\t  },\n194\t  {\n195\t    type: HorrorEventType.BLOOD_ON_SHELF,\n196\t    level: HorrorLevel.THREAT,\n197\t    baseProbability: 0.08,\n198\t    minDay: 18, maxDay: 30,\n199\t    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n200\t    minActiveDuration: 8000, maxActiveDuration: 12000,\n201\t    buildupDuration: 2000, resolveDuration: 3000,\n202\t    sanityCost: 18, cooldownSec: 240,\n203\t    description: '某个货架上出现暗红色液体缓缓渗出',\n204\t  },\n205\t  {\n206\t    type: HorrorEventType.NONPAYING_CUSTOMER,\n207\t    level: HorrorLevel.THREAT,\n208\t    baseProbability: 0.10,\n209\t    minDay: 16, maxDay: 30,\n210\t    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n211\t    minActiveDuration: 10000, maxActiveDuration: 20000,\n212\t    buildupDuration: 3000, resolveDuration: 1000,\n213\t    sanityCost: 14, cooldownSec: 200,\n214\t    description: '一个顾客拿了东西不走，也不付钱，只是盯着你看',\n215\t  },\n216\t  {\n217\t    type: HorrorEventType.WHISPER,\n218\t    level: HorrorLevel.THREAT,\n219\t    baseProbability: 0.12,\n220\t    minDay: 16, maxDay: 30,\n221\t    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n222\t    minActiveDuration: 4000, maxActiveDuration: 8000,\n223\t    buildupDuration: 2000, resolveDuration: 500,\n224\t    sanityCost: 12, cooldownSec: 120,\n225\t    description: '耳边传来低语声，听不清在说什么',\n226\t  },\n227\t  // Level 4: Existential\n228\t  {\n229\t    type: HorrorEventType.STORE_MUTATE,\n230\t    level: HorrorLevel.EXISTENTIAL,\n231\t    baseProbability: 0.06,\n232\t    minDay: 26, maxDay: 30,\n233\t    phaseRequired: [GamePhase.DANGER],\n234\t    minActiveDuration: 10000, maxActiveDuration: 20000,\n235\t    buildupDuration: 3000, resolveDuration: 5000,\n236\t    sanityCost: 25, cooldownSec: 300,\n237\t    description: '店铺结构开始改变，墙壁在移动',\n238\t  },\n239\t  {\n240\t    type: HorrorEventType.TIME_GLITCH,\n241\t    level: HorrorLevel.EXISTENTIAL,\n242\t    baseProbability: 0.05,\n243\t    minDay: 26, maxDay: 30,\n244\t    phaseRequired: [GamePhase.DANGER],\n245\t    minActiveDuration: 5000, maxActiveDuration: 8000,\n246\t    buildupDuration: 1000, resolveDuration: 2000,\n247\t    sanityCost: 20, cooldownSec: 300,\n248\t    description: '时钟突然倒转，时间出现异常',\n249\t  },\n250\t  // Level 3: Threat (new M5 events)\n251\t  {\n252\t    type: HorrorEventType.STALKER,\n253\t    level: HorrorLevel.THREAT,\n254\t    baseProbability: 0.08,\n255\t    minDay: 16, maxDay: 30,\n256\t    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n257\t    minActiveDuration: 12000, maxActiveDuration: 20000,\n258\t    buildupDuration: 2000, resolveDuration: 3000,\n259\t    sanityCost: 16, cooldownSec: 240,\n260\t    description: '后巷监控中有个身影，每次查看都更近了',\n261\t  },\n262\t  {\n263\t    type: HorrorEventType.CCTV_DOUBLE,\n264\t    level: HorrorLevel.THREAT,\n265\t    baseProbability: 0.07,\n266\t    minDay: 18, maxDay: 30,\n267\t    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n268\t    minActiveDuration: 8000, maxActiveDuration: 15000,\n269\t    buildupDuration: 1500, resolveDuration: 2000,\n270\t    sanityCost: 18, cooldownSec: 300,\n271\t    description: '监控画面出现了\"你\"，但你不在那个位置',\n272\t  },\n273\t  {\n274\t    type: HorrorEventType.CORRIDOR_EXTEND,\n275\t    level: HorrorLevel.THREAT,\n276\t    baseProbability: 0.06,\n277\t    minDay: 20, maxDay: 30,\n278\t    phaseRequired: [GamePhase.DANGER],\n279\t    minActiveDuration: 10000, maxActiveDuration: 18000,\n280\t    buildupDuration: 3000, resolveDuration: 4000,\n281\t    sanityCost: 20, cooldownSec: 360,\n282\t    description: '通向仓库的走廊变长了，尽头多了一扇门',\n283\t  },\n284\t  {\n285\t    type: HorrorEventType.RADIO_VOICE,\n286\t    level: HorrorLevel.THREAT,\n287\t    baseProbability: 0.07,\n288\t    minDay: 16, maxDay: 30,\n289\t    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n290\t    minActiveDuration: 8000, maxActiveDuration: 12000,\n291\t    buildupDuration: 1500, resolveDuration: 1000,\n292\t    sanityCost: 14, cooldownSec: 180,\n293\t    description: '收音机里传出前任店员的声音',\n294\t  },\n295\t  // Level 4: Existential (new M5 events)\n296\t  {\n297\t    type: HorrorEventType.MIRROR_STORE,\n298\t    level: HorrorLevel.EXISTENTIAL,\n299\t    baseProbability: 0.04,\n300\t    minDay: 26, maxDay: 30,\n301\t    phaseRequired: [GamePhase.DANGER],\n302\t    minActiveDuration: 15000, maxActiveDuration: 25000,\n303\t    buildupDuration: 3000, resolveDuration: 5000,\n304\t    sanityCost: 28, cooldownSec: 600,\n305\t    description: '你进入了镜像便利店，一切左右翻转',\n306\t  },\n307\t  {\n308\t    type: HorrorEventType.HE_COMES,\n309\t    level: HorrorLevel.EXISTENTIAL,\n310\t    baseProbability: 0.05,\n311\t    minDay: 26, maxDay: 30,\n312\t    phaseRequired: [GamePhase.DANGER],\n313\t    minActiveDuration: 30000, maxActiveDuration: 30000,\n314\t    buildupDuration: 5000, resolveDuration: 3000,\n315\t    sanityCost: 30, cooldownSec: 600,\n316\t    description: '\"他\"来了——30秒不可阻挡的缓慢接近',\n317\t  },\n318\t  {\n319\t    type: HorrorEventType.FINAL_CHOICE,\n320\t    level: HorrorLevel.EXISTENTIAL,\n321\t    baseProbability: 0.03,\n322\t    minDay: 29, maxDay: 30,\n323\t    phaseRequired: [GamePhase.DANGER],\n324\t    minActiveDuration: 0, maxActiveDuration: 0,\n325\t    buildupDuration: 3000, resolveDuration: 5000,\n326\t    sanityCost: 25, cooldownSec: 9999,\n327\t    description: '基于之前选择的最终决定时刻',\n328\t  },\n329\t];\n330\t\n331\t// --- Visual Effect State ---\n332\t\n333\texport interface HorrorVisualState {\n334\t  // Global\n335\t  frostIntensity: number;      // 0-1, frost on edges\n336\t  darknessBoost: number;       // 0-0.5, extra darkness\n337\t  screenShake: number;         // shake intensity\n338\t  chromaticAberration: number; // 0-1\n339\t  vignetteIntensity: number;   // 0-1\n340\t\n341\t  // Specific\n342\t  flickeringLightIndex: number; // which light is flickering (-1 = none)\n343\t  flickerIntensity: number;     // 0-1\n344\t\n345\t  bloodPositions: Array<{ x: number; y: number; size: number; alpha: number }>;\n346\t  ghostEntity: {\n347\t    active: boolean;\n348\t    x: number;\n349\t    y: number;\n350\t    opacity: number;\n351\t    type: 'ghost_customer' | 'duplicate' | 'nonpaying' | 'shadow';\n352\t  } | null;\n353\t  doorState: {\n354\t    frontOpen: boolean;\n355\t    backOpen: boolean;\n356\t  };\n357\t  timeGlitchActive: boolean;\n358\t  storeMutateOffset: { x: number; y: number };\n359\t  whisperActive: boolean;\n360\t\n361\t  // Level 3 new\n362\t  stalkerPosition: { x: number; y: number; distance: number } | null;\n363\t  cctvGlitchActive: boolean;\n364\t  corridorStretch: number; // 0-1 how much the corridor extends\n365\t  radioDistortion: number; // 0-1\n366\t\n367\t  // Level 4 new\n368\t  mirrorActive: boolean;\n369\t  mirrorFlipX: boolean;\n370\t  heComesActive: boolean;\n371\t  heComesProgress: number; // 0-1 how close \"he\" is\n372\t  finalChoiceActive: boolean;\n373\t\n374\t  // Atmosphere\n375\t  ambientFear: number; // 0-1 overall fear level\n376\t  recentHighFearCount: number; // for fear regulation\n377\t}\n378\t\n379\texport function createDefaultVisualState(): HorrorVisualState {\n380\t  return {\n381\t    frostIntensity: 0,\n382\t    darknessBoost: 0,\n383\t    screenShake: 0,\n384\t    chromaticAberration: 0,\n385\t    vignetteIntensity: 0.3,\n386\t    flickeringLightIndex: -1,\n387\t    flickerIntensity: 0,\n388\t    bloodPositions: [],\n389\t    ghostEntity: null,\n390\t    doorState: { frontOpen: false, backOpen: false },\n391\t    timeGlitchActive: false,\n392\t    storeMutateOffset: { x: 0, y: 0 },\n393\t    whisperActive: false,\n394\t    stalkerPosition: null,\n395\t    cctvGlitchActive: false,\n396\t    corridorStretch: 0,\n397\t    radioDistortion: 0,\n398\t    mirrorActive: false,\n399\t    mirrorFlipX: false,\n400\t    heComesActive: false,\n401\t    heComesProgress: 0,\n402\t    finalChoiceActive: false,\n403\t    ambientFear: 0,\n404\t    recentHighFearCount: 0,\n405\t  };\n406\t}\n407\t\n408\t// --- Manager ---\n409\t\n410\texport class HorrorEventManager {\n411\t  private activeEvents: HorrorEventInstance[] = [];\n412\t  private cooldowns: Map<HorrorEventType, number> = new Map();\n413\t  private visual: HorrorVisualState = createDefaultVisualState();\n414\t  private checkInterval = 5000; // check every 5 seconds\n415\t  private checkTimer = 0;\n416\t  private dayAccumulatedSanityCost = 0;\n417\t  private maxSanityCostPerNight = 40;\n418\t  private eventCounter = 0;\n419\t  private maxConcurrentEvents = 3;\n420\t\n421\t  // Callbacks\n422\t  onEventTrigger?: (event: HorrorEventInstance) => void;\n423\t  onSanityChange?: (delta: number) => void;\n424\t  onNotification?: (text: string) => void;\n425\t\n426\t  get visuals(): HorrorVisualState { return this.visual; }\n427\t  get activeEventCount(): number { return this.activeEvents.length; }\n428\t\n429\t  update(dt: number, day: number, phase: GamePhase, timeOfDay: number, sanity: number): HorrorVisualState {\n430\t    const dtSec = dt / 1000;\n431\t\n432\t    // Update cooldowns\n433\t    for (const [type, cd] of this.cooldowns) {\n434\t      if (cd > 0) this.cooldowns.set(type, Math.max(0, cd - dtSec));\n435\t    }\n436\t\n437\t    // Check for new events only at night\n438\t    if (isNightTime(phase) && this.activeEvents.length < this.maxConcurrentEvents) {\n439\t      this.checkTimer += dt;\n440\t      if (this.checkTimer >= this.checkInterval) {\n441\t        this.checkTimer = 0;\n442\t        this.tryTriggerEvents(day, phase, sanity);\n443\t      }\n444\t    }\n445\t\n446\t    // Update active events\n447\t    this.updateActiveEvents(dt);\n448\t\n449\t    // Decay visual effects toward baseline\n450\t    this.decayVisuals(dtSec);\n451\t\n452\t    // Calculate ambient fear\n453\t    this.updateAmbientFear(day, phase, timeOfDay);\n454\t\n455\t    return this.visual;\n456\t  }\n457\t\n458\t  private tryTriggerEvents(day: number, phase: GamePhase, sanity: number): void {\n459\t    for (const def of EVENT_DEFS) {\n460\t      if (this.activeEvents.length >= this.maxConcurrentEvents) break;\n461\t      if (this.activeEvents.some(e => e.type === def.type)) continue;\n462\t      if (day < def.minDay || day > def.maxDay) continue;\n463\t      if (!def.phaseRequired.includes(phase)) continue;\n464\t\n465\t      const cd = this.cooldowns.get(def.type) ?? 0;\n466\t      if (cd > 0) continue;\n467\t\n468\t      // Fear regulation: reduce probability if recent high fear\n469\t      let probabilityMod = 1;\n470\t      if (this.visual.recentHighFearCount >= 2 && def.level >= HorrorLevel.THREAT) {\n471\t        probabilityMod = 0.2; // big reduction after consecutive high fear\n472\t      }\n473\t\n474\t      // Sanity affects: lower sanity = slightly less events (overwhelmed player)\n475\t      if (sanity < 30) probabilityMod *= 0.5;\n476\t\n477\t      // Night depth increases probability\n478\t      const nightDepth = phase === GamePhase.DANGER ? 1.5 : 1;\n479\t      probabilityMod *= nightDepth;\n480\t\n481\t      // Day progression increases probability\n482\t      const dayProgress = Math.min(day / 15, 2);\n483\t      probabilityMod *= dayProgress;\n484\t\n485\t      const roll = Math.random();\n486\t      if (roll < def.baseProbability * probabilityMod) {\n487\t        this.triggerEvent(def);\n488\t      }\n489\t    }\n490\t  }\n491\t\n492\t  private triggerEvent(def: HorrorEventDef): void {\n493\t    const id = `horror_${++this.eventCounter}_${Date.now()}`;\n494\t    const event: HorrorEventInstance = {\n495\t      id,\n496\t      type: def.type,\n497\t      level: def.level,\n498\t      state: HorrorEventState.BUILDUP,\n499\t      timer: 0,\n500\t      duration: def.minActiveDuration + Math.random() * (def.maxActiveDuration - def.minActiveDuration),\n501\t      buildupDuration: def.buildupDuration,\n502\t      resolveDuration: def.resolveDuration,\n503\t      data: {},\n504\t      sanityCost: def.sanityCost,\n505\t    };\n506\t\n507\t    // Randomize specific data\n508\t    event.data = this.generateEventData(def);\n509\t\n510\t    this.activeEvents.push(event);\n511\t    this.cooldowns.set(def.type, def.cooldownSec);\n512\t\n513\t    if (def.level >= HorrorLevel.THREAT) {\n514\t      this.visual.recentHighFearCount++;\n515\t    }\n516\t\n517\t    this.onEventTrigger?.(event);\n518\t    this.onNotification?.(`⚠ ${def.description}`);\n519\t  }\n520\t\n521\t  private generateEventData(def: HorrorEventDef): Record<string, unknown> {\n522\t    switch (def.type) {\n523\t      case HorrorEventType.SHELF_SHIFT:\n524\t        return { shelfIndex: Math.floor(Math.random() * 5) };\n525\t      case HorrorEventType.LIGHT_FLICKER:\n526\t        return { lightIndex: Math.floor(Math.random() * 8) };\n527\t      case HorrorEventType.REGISTER_ANOMALY:\n528\t        return { registerIndex: Math.floor(Math.random() * 2), anomalyAmount: Math.floor(Math.random() * 9999) };\n529\t      case HorrorEventType.BLOOD_ON_SHELF: {\n530\t        const positions = [];\n531\t        const count = 2 + Math.floor(Math.random() * 4);\n532\t        for (let i = 0; i < count; i++) {\n533\t          positions.push({\n534\t            x: 100 + Math.random() * 600,\n535\t            y: 100 + Math.random() * 400,\n536\t            size: 8 + Math.random() * 20,\n537\t            alpha: 0.3 + Math.random() * 0.5,\n538\t          });\n539\t        }\n540\t        return { positions };\n541\t      }\n542\t      case HorrorEventType.GHOST_CUSTOMER:\n543\t        return { startX: Math.random() * 400 + 100, startY: 50, opacity: 0 };\n544\t      case HorrorEventType.DUPLICATE_CUSTOMER:\n545\t        return { x1: 200 + Math.random() * 200, x2: 400 + Math.random() * 200, y: 200 + Math.random() * 100 };\n546\t      case HorrorEventType.NONPAYING_CUSTOMER:\n547\t        return { x: 300 + Math.random() * 200, y: 150 + Math.random() * 100 };\n548\t      case HorrorEventType.DOOR_AUTO_OPEN:\n549\t        return { door: Math.random() < 0.5 ? 'front' : 'back' };\n550\t      case HorrorEventType.STALKER:\n551\t        return { startX: 400 + Math.random() * 200, startY: 200, distance: 300 + Math.random() * 200, checkCount: 0 };\n552\t      case HorrorEventType.CCTV_DOUBLE:\n553\t        return { glitchX: 200 + Math.random() * 400, glitchY: 100 + Math.random() * 200 };\n554\t      case HorrorEventType.CORRIDOR_EXTEND:\n555\t        return { extraDoors: 1 + Math.floor(Math.random() * 2), stretchAmount: 1.5 + Math.random() };\n556\t      case HorrorEventType.RADIO_VOICE:\n557\t        return { frequency: 88 + Math.random() * 20, voiceType: Math.floor(Math.random() * 3) };\n558\t      case HorrorEventType.MIRROR_STORE:\n559\t        return { flipAxis: 'x' as const };\n560\t      case HorrorEventType.HE_COMES:\n561\t        return { startX: 450, startY: 24 * 32, speed: 0.7 + Math.random() * 0.3 };\n562\t      case HorrorEventType.FINAL_CHOICE:\n563\t        return { choiceType: Math.floor(Math.random() * 3) };\n564\t      default:\n565\t        return {};\n566\t    }\n567\t  }\n568\t\n569\t  private updateActiveEvents(dt: number): void {\n570\t    const completed: string[] = [];\n571\t\n572\t    for (const event of this.activeEvents) {\n573\t      event.timer += dt;\n574\t\n575\t      switch (event.state) {\n576\t        case HorrorEventState.BUILDUP:\n577\t          this.applyBuildupEffect(event, event.timer / event.buildupDuration);\n578\t          if (event.timer >= event.buildupDuration) {\n579\t            event.state = HorrorEventState.ACTIVE;\n580\t            event.timer = 0;\n581\t            this.applyActiveEffect(event);\n582\t            this.onSanityChange?.(-event.sanityCost);\n583\t            this.dayAccumulatedSanityCost += event.sanityCost;\n584\t          }\n585\t          break;\n586\t\n587\t        case HorrorEventState.ACTIVE:\n588\t          this.sustainActiveEffect(event, event.timer / event.duration);\n589\t          if (event.timer >= event.duration) {\n590\t            event.state = HorrorEventState.RESOLVING;\n591\t            event.timer = 0;\n592\t            this.beginResolve(event);\n593\t          }\n594\t          break;\n595\t\n596\t        case HorrorEventState.RESOLVING:\n597\t          this.applyResolveEffect(event, event.timer / event.resolveDuration);\n598\t          if (event.timer >= event.resolveDuration) {\n599\t            event.state = HorrorEventState.COMPLETE;\n600\t            completed.push(event.id);\n601\t            this.clearEventEffects(event);\n602\t          }\n603\t          break;\n604\t      }\n605\t    }\n606\t\n607\t    for (const id of completed) {\n608\t      this.activeEvents = this.activeEvents.filter(e => e.id !== id);\n609\t    }\n610\t  }\n611\t\n612\t  // --- Buildup Effects (预兆) ---\n613\t\n614\t  private applyBuildupEffect(event: HorrorEventInstance, progress: number): void {\n615\t    const p = Math.min(1, progress);\n616\t    switch (event.type) {\n617\t      case HorrorEventType.LIGHT_FLICKER:\n618\t        this.visual.flickeringLightIndex = (event.data.lightIndex as number) ?? 0;\n619\t        this.visual.flickerIntensity = p * 0.3;\n620\t        break;\n621\t      case HorrorEventType.TEMP_DROP:\n622\t        this.visual.frostIntensity = p * 0.2;\n623\t        break;\n624\t      case HorrorEventType.BLOOD_ON_SHELF:\n625\t        this.visual.darknessBoost = p * 0.1;\n626\t        break;\n627\t      case HorrorEventType.WHISPER:\n628\t        this.visual.whisperActive = true;\n629\t        break;\n630\t      case HorrorEventType.GHOST_CUSTOMER:\n631\t      case HorrorEventType.DUPLICATE_CUSTOMER:\n632\t      case HorrorEventType.NONPAYING_CUSTOMER:\n633\t        this.visual.vignetteIntensity = Math.min(1, 0.3 + p * 0.3);\n634\t        break;\n635\t      case HorrorEventType.DOOR_AUTO_OPEN:\n636\t        this.visual.screenShake = p * 0.3;\n637\t        break;\n638\t      case HorrorEventType.STALKER:\n639\t        this.visual.vignetteIntensity = Math.min(1, 0.3 + p * 0.4);\n640\t        break;\n641\t      case HorrorEventType.CCTV_DOUBLE:\n642\t        this.visual.chromaticAberration = p * 0.2;\n643\t        break;\n644\t      case HorrorEventType.CORRIDOR_EXTEND:\n645\t        this.visual.corridorStretch = p * 0.3;\n646\t        break;\n647\t      case HorrorEventType.RADIO_VOICE:\n648\t        this.visual.radioDistortion = p * 0.3;\n649\t        break;\n650\t      case HorrorEventType.MIRROR_STORE:\n651\t        this.visual.chromaticAberration = p * 0.4;\n652\t        break;\n653\t      case HorrorEventType.HE_COMES:\n654\t        this.visual.vignetteIntensity = Math.min(1, 0.4 + p * 0.5);\n655\t        this.visual.darknessBoost = p * 0.2;\n656\t        break;\n657\t      case HorrorEventType.FINAL_CHOICE:\n658\t        this.visual.chromaticAberration = p * 0.5;\n659\t        this.visual.vignetteIntensity = Math.min(1, 0.5 + p * 0.5);\n660\t        break;\n661\t      case HorrorEventType.STORE_MUTATE:\n662\t        this.visual.chromaticAberration = p * 0.3;\n663\t        break;\n664\t      default:\n665\t        this.visual.darknessBoost = p * 0.05;\n666\t        break;\n667\t    }\n668\t  }\n669\t\n670\t  // --- Active Effects ---\n671\t\n672\t  private applyActiveEffect(event: HorrorEventInstance): void {\n673\t    switch (event.type) {\n674\t      case HorrorEventType.LIGHT_FLICKER:\n675\t        this.visual.flickerIntensity = 0.8;\n676\t        break;\n677\t      case HorrorEventType.TEMP_DROP:\n678\t        this.visual.frostIntensity = 0.6;\n679\t        this.visual.vignetteIntensity = 0.7;\n680\t        break;\n681\t      case HorrorEventType.FRIDGE_NOISE:\n682\t        this.visual.screenShake = 0.5;\n683\t        break;\n684\t      case HorrorEventType.BLOOD_ON_SHELF:\n685\t        this.visual.bloodPositions = (event.data.positions as Array<{ x: number; y: number; size: number; alpha: number }>) ?? [];\n686\t        break;\n687\t      case HorrorEventType.GHOST_CUSTOMER:\n688\t        this.visual.ghostEntity = {\n689\t          active: true,\n690\t          x: (event.data.startX as number) ?? 300,\n691\t          y: (event.data.startY as number) ?? 50,\n692\t          opacity: 0.4,\n693\t          type: 'ghost_customer',\n694\t        };\n695\t        break;\n696\t      case HorrorEventType.DUPLICATE_CUSTOMER:\n697\t        this.visual.ghostEntity = {\n698\t          active: true,\n699\t          x: (event.data.x1 as number) ?? 200,\n700\t          y: (event.data.y as number) ?? 200,\n701\t          opacity: 0.8,\n702\t          type: 'duplicate',\n703\t        };\n704\t        break;\n705\t      case HorrorEventType.NONPAYING_CUSTOMER:\n706\t        this.visual.ghostEntity = {\n707\t          active: true,\n708\t          x: (event.data.x as number) ?? 300,\n709\t          y: (event.data.y as number) ?? 150,\n710\t          opacity: 0.9,\n711\t          type: 'nonpaying',\n712\t        };\n713\t        break;\n714\t      case HorrorEventType.DOOR_AUTO_OPEN:\n715\t        if ((event.data.door as string) === 'front') {\n716\t          this.visual.doorState.frontOpen = true;\n717\t        } else {\n718\t          this.visual.doorState.backOpen = true;\n719\t        }\n720\t        this.visual.darknessBoost = 0.3;\n721\t        this.visual.screenShake = 0.8;\n722\t        break;\n723\t      case HorrorEventType.WHISPER:\n724\t        this.visual.whisperActive = true;\n725\t        this.visual.vignetteIntensity = 0.8;\n726\t        break;\n727\t      case HorrorEventType.STORE_MUTATE:\n728\t        this.visual.storeMutateOffset = { x: (Math.random() - 0.5) * 10, y: (Math.random() - 0.5) * 10 };\n729\t        this.visual.chromaticAberration = 0.8;\n730\t        this.visual.screenShake = 0.4;\n731\t        break;\n732\t      case HorrorEventType.TIME_GLITCH:\n733\t        this.visual.timeGlitchActive = true;\n734\t        this.visual.chromaticAberration = 0.6;\n735\t        break;\n736\t      case HorrorEventType.STALKER:\n737\t        this.visual.stalkerPosition = {\n738\t          x: (event.data.startX as number) ?? 400,\n739\t          y: (event.data.startY as number) ?? 200,\n740\t          distance: (event.data.distance as number) ?? 300,\n741\t        };\n742\t        this.visual.vignetteIntensity = 0.8;\n743\t        break;\n744\t      case HorrorEventType.CCTV_DOUBLE:\n745\t        this.visual.cctvGlitchActive = true;\n746\t        this.visual.chromaticAberration = 0.5;\n747\t        this.visual.screenShake = 0.3;\n748\t        break;\n749\t      case HorrorEventType.CORRIDOR_EXTEND:\n750\t        this.visual.corridorStretch = 1;\n751\t        this.visual.darknessBoost = 0.3;\n752\t        this.visual.screenShake = 0.2;\n753\t        break;\n754\t      case HorrorEventType.RADIO_VOICE:\n755\t        this.visual.radioDistortion = 1;\n756\t        this.visual.whisperActive = true;\n757\t        break;\n758\t      case HorrorEventType.MIRROR_STORE:\n759\t        this.visual.mirrorActive = true;\n760\t        this.visual.mirrorFlipX = true;\n761\t        this.visual.chromaticAberration = 0.8;\n762\t        this.visual.screenShake = 0.4;\n763\t        break;\n764\t      case HorrorEventType.HE_COMES:\n765\t        this.visual.heComesActive = true;\n766\t        this.visual.heComesProgress = 0;\n767\t        this.visual.darknessBoost = 0.5;\n768\t        this.visual.vignetteIntensity = 1;\n769\t        this.visual.screenShake = 0.6;\n770\t        break;\n771\t      case HorrorEventType.FINAL_CHOICE:\n772\t        this.visual.finalChoiceActive = true;\n773\t        this.visual.chromaticAberration = 1;\n774\t        this.visual.vignetteIntensity = 1;\n775\t        break;\n776\t      default:\n777\t        this.visual.darknessBoost = 0.15;\n778\t        break;\n779\t    }\n780\t  }\n781\t\n782\t  private sustainActiveEffect(event: HorrorEventInstance, progress: number): void {\n783\t    // Pulsing effects during sustain\n784\t    const pulse = Math.sin(progress * Math.PI * 4) * 0.5 + 0.5;\n785\t\n786\t    switch (event.type) {\n787\t      case HorrorEventType.LIGHT_FLICKER:\n788\t        this.visual.flickerIntensity = 0.4 + pulse * 0.5;\n789\t        break;\n790\t      case HorrorEventType.FRIDGE_NOISE:\n791\t        this.visual.screenShake = 0.2 + pulse * 0.3;\n792\t        break;\n793\t      case HorrorEventType.GHOST_CUSTOMER:\n794\t        if (this.visual.ghostEntity) {\n795\t          this.visual.ghostEntity.opacity = 0.2 + pulse * 0.4;\n796\t          this.visual.ghostEntity.y += 0.1;\n797\t        }\n798\t        break;\n799\t      case HorrorEventType.STORE_MUTATE: {\n800\t        const t = performance.now() * 0.001;\n801\t        this.visual.storeMutateOffset = {\n802\t          x: Math.sin(t * 0.5) * 8,\n803\t          y: Math.cos(t * 0.7) * 5,\n804\t        };\n805\t        break;\n806\t      }\n807\t      case HorrorEventType.TIME_GLITCH:\n808\t        this.visual.chromaticAberration = 0.3 + pulse * 0.5;\n809\t        break;\n810\t      case HorrorEventType.STALKER:\n811\t        if (this.visual.stalkerPosition) {\n812\t          this.visual.stalkerPosition.distance = Math.max(50, (this.visual.stalkerPosition.distance ?? 300) - 0.5);\n813\t        }\n814\t        break;\n815\t      case HorrorEventType.CCTV_DOUBLE:\n816\t        this.visual.chromaticAberration = 0.3 + pulse * 0.4;\n817\t        break;\n818\t      case HorrorEventType.CORRIDOR_EXTEND:\n819\t        this.visual.corridorStretch = 0.8 + pulse * 0.2;\n820\t        break;\n821\t      case HorrorEventType.HE_COMES:\n822\t        this.visual.heComesProgress = Math.min(1, progress);\n823\t        this.visual.darknessBoost = 0.3 + progress * 0.4;\n824\t        this.visual.screenShake = 0.3 + progress * 0.5;\n825\t        break;\n826\t      case HorrorEventType.FINAL_CHOICE:\n827\t        this.visual.chromaticAberration = 0.5 + pulse * 0.5;\n828\t        break;\n829\t      default:\n830\t        break;\n831\t    }\n832\t  }\n833\t\n834\t  // --- Resolve Effects ---\n835\t\n836\t  private beginResolve(event: HorrorEventInstance): void {\n837\t    switch (event.type) {\n838\t      case HorrorEventType.FRIDGE_NOISE:\n839\t        // Sudden silence is scarier\n840\t        this.visual.screenShake = 0;\n841\t        break;\n842\t      default:\n843\t        break;\n844\t    }\n845\t  }\n846\t\n847\t  private applyResolveEffect(event: HorrorEventInstance, progress: number): void {\n848\t    const p = Math.min(1, progress);\n849\t    switch (event.type) {\n850\t      case HorrorEventType.TEMP_DROP:\n851\t        this.visual.frostIntensity *= (1 - p);\n852\t        break;\n853\t      case HorrorEventType.LIGHT_FLICKER:\n854\t        this.visual.flickerIntensity *= (1 - p);\n855\t        if (p >= 1) this.visual.flickeringLightIndex = -1;\n856\t        break;\n857\t      case HorrorEventType.BLOOD_ON_SHELF:\n858\t        this.visual.bloodPositions = this.visual.bloodPositions.map(b => ({\n859\t          ...b, alpha: b.alpha * (1 - p),\n860\t        }));\n861\t        break;\n862\t      case HorrorEventType.GHOST_CUSTOMER:\n863\t      case HorrorEventType.DUPLICATE_CUSTOMER:\n864\t      case HorrorEventType.NONPAYING_CUSTOMER:\n865\t        if (this.visual.ghostEntity) {\n866\t          this.visual.ghostEntity.opacity *= (1 - p);\n867\t        }\n868\t        break;\n869\t      case HorrorEventType.DOOR_AUTO_OPEN:\n870\t        this.visual.doorState.frontOpen = false;\n871\t        this.visual.doorState.backOpen = false;\n872\t        this.visual.darknessBoost *= (1 - p);\n873\t        break;\n874\t      case HorrorEventType.STORE_MUTATE:\n875\t        this.visual.storeMutateOffset.x *= (1 - p);\n876\t        this.visual.storeMutateOffset.y *= (1 - p);\n877\t        this.visual.chromaticAberration *= (1 - p);\n878\t        break;\n879\t      case HorrorEventType.TIME_GLITCH:\n880\t        if (p >= 0.8) this.visual.timeGlitchActive = false;\n881\t        this.visual.chromaticAberration *= (1 - p);\n882\t        break;\n883\t      case HorrorEventType.STALKER:\n884\t        if (this.visual.stalkerPosition) {\n885\t          this.visual.stalkerPosition.distance *= (1 - p * 0.5);\n886\t        }\n887\t        if (p >= 1) this.visual.stalkerPosition = null;\n888\t        break;\n889\t      case HorrorEventType.CCTV_DOUBLE:\n890\t        this.visual.chromaticAberration *= (1 - p);\n891\t        if (p >= 1) this.visual.cctvGlitchActive = false;\n892\t        break;\n893\t      case HorrorEventType.CORRIDOR_EXTEND:\n894\t        this.visual.corridorStretch *= (1 - p);\n895\t        break;\n896\t      case HorrorEventType.RADIO_VOICE:\n897\t        this.visual.radioDistortion *= (1 - p);\n898\t        if (p >= 0.5) this.visual.whisperActive = false;\n899\t        break;\n900\t      case HorrorEventType.MIRROR_STORE:\n901\t        this.visual.chromaticAberration *= (1 - p);\n902\t        if (p >= 1) {\n903\t          this.visual.mirrorActive = false;\n904\t          this.visual.mirrorFlipX = false;\n905\t        }\n906\t        break;\n907\t      case HorrorEventType.HE_COMES:\n908\t        this.visual.darknessBoost *= (1 - p);\n909\t        this.visual.screenShake *= (1 - p);\n910\t        if (p >= 1) {\n911\t          this.visual.heComesActive = false;\n912\t          this.visual.heComesProgress = 0;\n913\t        }\n914\t        break;\n915\t      case HorrorEventType.FINAL_CHOICE:\n916\t        this.visual.chromaticAberration *= (1 - p);\n917\t        if (p >= 1) this.visual.finalChoiceActive = false;\n918\t        break;\n919\t      default:\n920\t        break;\n921\t    }\n922\t  }\n923\t\n924\t  private clearEventEffects(event: HorrorEventInstance): void {\n925\t    switch (event.type) {\n926\t      case HorrorEventType.GHOST_CUSTOMER:\n927\t      case HorrorEventType.DUPLICATE_CUSTOMER:\n928\t      case HorrorEventType.NONPAYING_CUSTOMER:\n929\t        this.visual.ghostEntity = null;\n930\t        break;\n931\t      case HorrorEventType.BLOOD_ON_SHELF:\n932\t        this.visual.bloodPositions = [];\n933\t        break;\n934\t      case HorrorEventType.WHISPER:\n935\t        this.visual.whisperActive = false;\n936\t        break;\n937\t      case HorrorEventType.TIME_GLITCH:\n938\t        this.visual.timeGlitchActive = false;\n939\t        break;\n940\t      case HorrorEventType.STALKER:\n941\t        this.visual.stalkerPosition = null;\n942\t        break;\n943\t      case HorrorEventType.CCTV_DOUBLE:\n944\t        this.visual.cctvGlitchActive = false;\n945\t        break;\n946\t      case HorrorEventType.CORRIDOR_EXTEND:\n947\t        this.visual.corridorStretch = 0;\n948\t        break;\n949\t      case HorrorEventType.RADIO_VOICE:\n950\t        this.visual.radioDistortion = 0;\n951\t        this.visual.whisperActive = false;\n952\t        break;\n953\t      case HorrorEventType.MIRROR_STORE:\n954\t        this.visual.mirrorActive = false;\n955\t        this.visual.mirrorFlipX = false;\n956\t        break;\n957\t      case HorrorEventType.HE_COMES:\n958\t        this.visual.heComesActive = false;\n959\t        this.visual.heComesProgress = 0;\n960\t        break;\n961\t      case HorrorEventType.FINAL_CHOICE:\n962\t        this.visual.finalChoiceActive = false;\n963\t        break;\n964\t      default:\n965\t        break;\n966\t    }\n967\t  }\n968\t\n969\t  private decayVisuals(dtSec: number): void {\n970\t    const decay = dtSec * 0.5;\n971\t    this.visual.screenShake = Math.max(0, this.visual.screenShake - decay);\n972\t    this.visual.darknessBoost = Math.max(0, this.visual.darknessBoost - decay * 0.1);\n973\t    if (this.visual.flickeringLightIndex === -1) {\n974\t      this.visual.flickerIntensity = Math.max(0, this.visual.flickerIntensity - decay * 0.2);\n975\t    }\n976\t  }\n977\t\n978\t  private updateAmbientFear(day: number, phase: GamePhase, timeOfDay: number): void {\n979\t    let target = 0;\n980\t\n981\t    if (isNightTime(phase)) {\n982\t      target = 0.3;\n983\t      if (phase === GamePhase.NIGHT) target = 0.5;\n984\t      if (phase === GamePhase.DANGER) target = 0.8;\n985\t\n986\t      // Day progression\n987\t      target *= Math.min(1 + (day - 1) * 0.05, 2);\n988\t\n989\t      // Active events boost fear\n990\t      target += this.activeEvents.length * 0.1;\n991\t    }\n992\t\n993\t    this.visual.ambientFear += (target - this.visual.ambientFear) * 0.02;\n994\t  }\n995\t\n996\t  // --- Public API ---\n997\t\n998\t  /** Reset daily state when new day begins */\n999\t  resetDaily(): void {\n1000\t    this.dayAccumulatedSanityCost = 0;\n1001\t    this.visual.recentHighFearCount = 0;\n1002\t    this.activeEvents = [];\n1003\t    this.visual = createDefaultVisualState();\n1004\t  }\n1005\t\n1006\t  /** Get the maximum event level available for current day */\n1007\t  getMaxLevel(day: number): HorrorLevel {\n1008\t    if (day >= 26) return HorrorLevel.EXISTENTIAL;\n1009\t    if (day >= 16) return HorrorLevel.THREAT;\n1010\t    if (day >= 6) return HorrorLevel.ENTITY;\n1011\t    return HorrorLevel.ENVIRONMENT;\n1012\t  }\n1013\t\n1014\t  /** Get active events for display */\n1015\t  getActiveEvents(): ReadonlyArray<HorrorEventInstance> {\n1016\t    return this.activeEvents;\n1017\t  }\n1018\t\n1019\t  /** Get save data */\n1020\t  getSaveData(): Record<string, unknown> {\n1021\t    return {\n1022\t      eventCounter: this.eventCounter,\n1023\t      dayAccumulatedSanityCost: this.dayAccumulatedSanityCost,\n1024\t    };\n1025\t  }\n1026\t\n1027\t  /** Load save data */\n1028\t  loadSaveData(data: Record<string, unknown>): void {\n1029\t    this.eventCounter = (data.eventCounter as number) ?? 0;\n1030\t    this.dayAccumulatedSanityCost = (data.dayAccumulatedSanityCost as number) ?? 0;\n1031\t  }\n1032\t}\n1033\t"}]},"parent_tool_use_id":"call_37a82845ea3e4d0c88fbf309","session_id":"561a5118-a4d0-464b-8f32-001690e29cb0","uuid":"908bd33c-cced-4484-8ace-c0d6bfe85946","timestamp":"2026-05-23T10:13:58.662Z","subagent_type":"general-purpose","task_description":"Read horror sim source"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ca3f91d31ae04d71ba3f6525","type":"tool_result","content":"1\t// SaveManager.ts — Auto-save after day end + load restore (M3)\n2\t\n3\timport { type GameState, type SaveData, CURRENT_VERSION } from './GameState';\n4\t\n5\texport interface SaveableSystem {\n6\t  getSaveData(): Record<string, unknown>;\n7\t  loadSaveData(data: Record<string, unknown>): void;\n8\t}\n9\t\n10\tconst SAVE_KEY = 'midnight_store_save_v3';\n11\t\n12\texport class SaveManager {\n13\t  private systems: Map<string, SaveableSystem> = new Map();\n14\t  private lastSaveTime = 0;\n15\t  private autoSaveInterval = 300000;\n16\t\n17\t  register(name: string, system: SaveableSystem): void {\n18\t    this.systems.set(name, system);\n19\t  }\n20\t\n21\t  save(state: GameState): boolean {\n22\t    const data: Record<string, unknown> = {};\n23\t    for (const [name, sys] of this.systems) {\n24\t      data[name] = sys.getSaveData();\n25\t    }\n26\t\n27\t    const saveData: SaveData = {\n28\t      version: CURRENT_VERSION,\n29\t      timestamp: Date.now(),\n30\t      playtime: state.totalPlaytime,\n31\t      gameState: state,\n32\t      productManager: (data['productManager'] as Record<string, unknown>) ?? {},\n33\t      economy: (data['economy'] as Record<string, unknown>) ?? {},\n34\t      pricing: (data['pricing'] as Record<string, unknown>) ?? {},\n35\t      customerStats: (data['customerManager'] as Record<string, unknown>) ?? {},\n36\t      registers: (data['registers'] as Record<string, unknown>[]) ?? [],\n37\t    };\n38\t\n39\t    try {\n40\t      localStorage.setItem(SAVE_KEY, JSON.stringify(saveData));\n41\t      this.lastSaveTime = Date.now();\n42\t      return true;\n43\t    } catch {\n44\t      console.warn('Save failed: storage quota exceeded');\n45\t      return false;\n46\t    }\n47\t  }\n48\t\n49\t  load(): SaveData | null {\n50\t    try {\n51\t      const raw = localStorage.getItem(SAVE_KEY);\n52\t      if (!raw) return null;\n53\t      return JSON.parse(raw) as SaveData;\n54\t    } catch {\n55\t      return null;\n56\t    }\n57\t  }\n58\t\n59\t  restore(save: SaveData, state: GameState): void {\n60\t    const gs = save.gameState;\n61\t    if (gs) {\n62\t      Object.assign(state, gs);\n63\t    }\n64\t\n65\t    const restoreSystem = (name: string, key: keyof SaveData) => {\n66\t      const sys = this.systems.get(name);\n67\t      const data = save[key] as Record<string, unknown> | undefined;\n68\t      if (sys && data && Object.keys(data).length > 0) {\n69\t        sys.loadSaveData(data);\n70\t      }\n71\t    };\n72\t\n73\t    restoreSystem('productManager', 'productManager');\n74\t    restoreSystem('economy', 'economy');\n75\t    restoreSystem('pricing', 'pricing');\n76\t    restoreSystem('customerManager', 'customerStats');\n77\t\n78\t    const sys = this.systems.get('registers');\n79\t    if (sys && save.registers) {\n80\t      sys.loadSaveData({ registers: save.registers });\n81\t    }\n82\t  }\n83\t\n84\t  clearSave(): void {\n85\t    localStorage.removeItem(SAVE_KEY);\n86\t  }\n87\t\n88\t  hasSave(): boolean {\n89\t    return localStorage.getItem(SAVE_KEY) !== null;\n90\t  }\n91\t\n92\t  startAutoSave(getState: () => GameState): void {\n93\t    window.setInterval(() => {\n94\t      this.save(getState());\n95\t    }, this.autoSaveInterval);\n96\t  }\n97\t}\n98\t"}]},"parent_tool_use_id":"call_37a82845ea3e4d0c88fbf309","session_id":"561a5118-a4d0-464b-8f32-001690e29cb0","uuid":"fa1efc47-49c3-4984-aeb8-c605544f1ced","timestamp":"2026-05-23T10:13:58.773Z","subagent_type":"general-purpose","task_description":"Read horror sim source"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6c99e76efcc9451097f7c886","type":"tool_result","content":"1\t// Renderer.ts — Canvas 2D rendering system (v0.2.0 — M2)\n2\t\n3\timport { Camera } from './Camera';\n4\timport { StoreMap, T } from '../game/StoreMap';\n5\timport { Player } from '../game/Player';\n6\timport { Lighting } from './Lighting';\n7\timport {\n8\t  type GameState,\n9\t  type GamePhase,\n10\t  type LightSource,\n11\t  type Interactable,\n12\t  GamePhase as GP,\n13\t  UIPanel,\n14\t  getTimeString,\n15\t  isNightTime,\n16\t} from '../game/GameState';\n17\timport { Customer } from '../game/Customer';\n18\timport { ProductManager } from '../game/ProductManager';\n19\timport { ShelfInteraction, ShelfAction } from '../game/ShelfInteraction';\n20\timport { CashRegister, RegisterState } from '../game/CashRegister';\n21\timport { EconomySystem } from '../game/EconomySystem';\n22\timport { PricingSystem } from '../game/PricingSystem';\n23\timport { DaySummaryManager } from '../game/DaySummary';\n24\timport { UpgradeManager } from '../game/UpgradeManager';\n25\timport { type HorrorVisualState } from '../game/HorrorEventManager';\n26\timport { type JumpScareVisualState } from '../game/JumpScareManager';\n27\timport { type HorrorNPC } from '../game/BehaviorTree';\n28\t\n29\texport interface RenderContext {\n30\t  customers: Customer[];\n31\t  productManager: ProductManager;\n32\t  shelfInteraction: ShelfInteraction;\n33\t  registers: CashRegister[];\n34\t  economy: EconomySystem;\n35\t  pricing: PricingSystem;\n36\t  lastTransaction: string;\n37\t  daySummary?: DaySummaryManager;\n38\t  upgradeManager?: UpgradeManager;\n39\t  horrorVisuals?: HorrorVisualState;\n40\t  scareVisuals?: JumpScareVisualState;\n41\t  activeNPCs?: ReadonlyArray<HorrorNPC>;\n42\t}\n43\t\n44\texport class Renderer {\n45\t  canvas: HTMLCanvasElement;\n46\t  ctx: CanvasRenderingContext2D;\n47\t  camera: Camera;\n48\t  lighting: Lighting;\n49\t\n50\t  constructor(canvas: HTMLCanvasElement) {\n51\t    this.canvas = canvas;\n52\t    this.ctx = canvas.getContext('2d')!;\n53\t    this.camera = new Camera(canvas);\n54\t    this.lighting = new Lighting();\n55\t    this.resize();\n56\t    this.camera.setupZoom(canvas);\n57\t  }\n58\t\n59\t  resize(): void {\n60\t    const dpr = window.devicePixelRatio || 1;\n61\t    const rect = this.canvas.getBoundingClientRect();\n62\t    this.canvas.width = rect.width * dpr;\n63\t    this.canvas.height = rect.height * dpr;\n64\t    this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n65\t  }\n66\t\n67\t  render(\n68\t    map: StoreMap,\n69\t    player: Player,\n70\t    state: GameState,\n71\t    now: number,\n72\t    ctx?: RenderContext,\n73\t  ): void {\n74\t    const c = this.ctx;\n75\t    const w = this.canvas.getBoundingClientRect().width;\n76\t    const h = this.canvas.getBoundingClientRect().height;\n77\t\n78\t    const bgPhase = state.phase;\n79\t    if (bgPhase === 'danger') {\n80\t      c.fillStyle = '#0a0a15';\n81\t    } else if (isNightTime(bgPhase)) {\n82\t      c.fillStyle = '#0f1020';\n83\t    } else {\n84\t      c.fillStyle = '#1a1520';\n85\t    }\n86\t    c.fillRect(0, 0, w, h);\n87\t\n88\t    const { offsetX, offsetY, scale } = this.camera.getTransform();\n89\t\n90\t    // Render map tiles\n91\t    map.render(c, offsetX, offsetY, w, h, scale);\n92\t\n93\t    // Render shelf product indicators\n94\t    if (ctx) {\n95\t      this.renderShelfIndicators(c, ctx.productManager, state.interactables, offsetX, offsetY, scale);\n96\t    }\n97\t\n98\t    // Render interactable highlights\n99\t    this.renderInteractables(c, state.interactables, offsetX, offsetY, scale, player, now);\n100\t\n101\t    // Render customers\n102\t    if (ctx) {\n103\t      for (const customer of ctx.customers) {\n104\t        customer.render(c, offsetX, offsetY, scale);\n105\t      }\n106\t    }\n107\t\n108\t    // Render player\n109\t    player.render(c, offsetX, offsetY, scale);\n110\t\n111\t    // Render lighting overlay (M3: pass timeOfDay for gradual transitions)\n112\t    this.lighting.render(c, w, h, state.lights, state.phase, offsetX, offsetY, scale, now, state.timeOfDay);\n113\t\n114\t    // Render HUD\n115\t    this.renderHUD(c, w, h, state, player, ctx);\n116\t\n117\t    // Render active panel\n118\t    if (ctx && state.activePanel !== UIPanel.NONE) {\n119\t      this.renderPanel(c, w, h, state, ctx);\n120\t    }\n121\t\n122\t    // M3: Render day summary overlay\n123\t    if (ctx?.daySummary) {\n124\t      ctx.daySummary.render(c, w, h);\n125\t    }\n126\t\n127\t    // M4: Render horror visual effects\n128\t    if (ctx?.horrorVisuals) {\n129\t      this.renderHorrorEffects(c, w, h, ctx.horrorVisuals, now, state);\n130\t    }\n131\t  }\n132\t\n133\t  private renderShelfIndicators(\n134\t    c: CanvasRenderingContext2D,\n135\t    pm: ProductManager,\n136\t    interactables: Interactable[],\n137\t    ox: number,\n138\t    oy: number,\n139\t    scale: number,\n140\t  ): void {\n141\t    for (const inter of interactables) {\n142\t      if (inter.type !== 'shelf' && inter.type !== 'fridge') continue;\n143\t      const slot = pm.shelfSlots.get(inter.id);\n144\t      if (!slot || !slot.productId || slot.quantity <= 0) continue;\n145\t\n146\t      const product = pm.getProduct(slot.productId);\n147\t      if (!product) continue;\n148\t\n149\t      const px = ox + inter.x * scale;\n150\t      const py = oy + (inter.y - 8) * scale;\n151\t      const pw = inter.width * scale;\n152\t\n153\t      // Stock level bar\n154\t      const ratio = slot.quantity / slot.maxQuantity;\n155\t      const barColor = ratio > 0.5 ? '#66aa66' : ratio > 0.2 ? '#aaaa44' : '#aa4444';\n156\t      c.fillStyle = 'rgba(0,0,0,0.5)';\n157\t      c.fillRect(px, py, pw, 6 * scale);\n158\t      c.fillStyle = barColor;\n159\t      c.fillRect(px, py, pw * ratio, 6 * scale);\n160\t\n161\t      // Product name\n162\t      c.fillStyle = 'rgba(255,255,255,0.7)';\n163\t      c.font = `${Math.round(8 * scale)}px monospace`;\n164\t      c.textAlign = 'center';\n165\t      c.textBaseline = 'top';\n166\t      c.fillText(`${product.name}(${slot.quantity})`, px + pw / 2, py + 7 * scale);\n167\t    }\n168\t  }\n169\t\n170\t  private renderInteractables(\n171\t    c: CanvasRenderingContext2D,\n172\t    interactables: Interactable[],\n173\t    ox: number,\n174\t    oy: number,\n175\t    scale: number,\n176\t    player: Player,\n177\t    now: number,\n178\t  ): void {\n179\t    const facing = player.getFacingTile();\n180\t\n181\t    for (const obj of interactables) {\n182\t      const px = ox + obj.x * scale;\n183\t      const py = oy + obj.y * scale;\n184\t      const pw = obj.width * scale;\n185\t      const ph = obj.height * scale;\n186\t\n187\t      const objGX = Math.floor(obj.x / 32);\n188\t      const objGY = Math.floor(obj.y / 32);\n189\t      const isFacing = facing.gx >= objGX && facing.gx <= objGX + Math.ceil(obj.width / 32) - 1 &&\n190\t        facing.gy >= objGY && facing.gy <= objGY + Math.ceil(obj.height / 32) - 1;\n191\t\n192\t      if (isFacing) {\n193\t        const pulse = 0.3 + Math.sin(now * 0.005) * 0.1;\n194\t        c.strokeStyle = `rgba(255, 255, 100, ${pulse})`;\n195\t        c.lineWidth = 2;\n196\t        c.strokeRect(px - 2, py - 2, pw + 4, ph + 4);\n197\t\n198\t        c.fillStyle = 'rgba(0,0,0,0.7)';\n199\t        const labelW = c.measureText(obj.label).width + 12;\n200\t        c.fillRect(px + pw / 2 - labelW / 2, py - 22, labelW, 18);\n201\t        c.fillStyle = '#ffdd66';\n202\t        c.font = `${Math.round(11)}px monospace`;\n203\t        c.textAlign = 'center';\n204\t        c.textBaseline = 'middle';\n205\t        c.fillText(obj.label, px + pw / 2, py - 13);\n206\t      }\n207\t    }\n208\t  }\n209\t\n210\t  private renderHUD(\n211\t    c: CanvasRenderingContext2D,\n212\t    canvasW: number,\n213\t    canvasH: number,\n214\t    state: GameState,\n215\t    player: Player,\n216\t    ctx?: RenderContext,\n217\t  ): void {\n218\t    // Top bar\n219\t    c.fillStyle = 'rgba(0,0,0,0.8)';\n220\t    c.fillRect(0, 0, canvasW, 44);\n221\t\n222\t    // Day counter\n223\t    c.fillStyle = '#e0d0b0';\n224\t    c.font = 'bold 13px monospace';\n225\t    c.textAlign = 'left';\n226\t    c.textBaseline = 'middle';\n227\t    c.fillText(`Day ${state.day}`, 12, 14);\n228\t\n229\t    // Time\n230\t    c.fillStyle = isNightTime(state.phase) ? '#8888cc' : '#ccaa66';\n231\t    c.font = '13px monospace';\n232\t    c.fillText(getTimeString(state.timeOfDay), 80, 14);\n233\t\n234\t    // Phase indicator\n235\t    const phaseLabels: Record<string, string> = {\n236\t      daytime: '营业中',\n237\t      night_transition: '准备打烊',\n238\t      night: '深夜营业',\n239\t      danger: '危险时段',\n240\t      dawn: '黎明',\n241\t    };\n242\t    c.fillStyle = state.phase === 'danger' ? '#ff4444' : '#aaa';\n243\t    c.font = '11px monospace';\n244\t    c.fillText(phaseLabels[state.phase] ?? state.phase, 160, 14);\n245\t\n246\t    // Money\n247\t    c.fillStyle = '#66cc66';\n248\t    c.font = '12px monospace';\n249\t    c.textAlign = 'right';\n250\t    c.fillText(`¥${state.money.toLocaleString()}`, canvasW - 12, 12);\n251\t\n252\t    // Debt\n253\t    c.fillStyle = '#cc6666';\n254\t    c.font = '10px monospace';\n255\t    c.fillText(`债务: ¥${state.debt.toLocaleString()}`, canvasW - 12, 26);\n256\t\n257\t    // Health bar\n258\t    c.textAlign = 'left';\n259\t    const hbX = 300;\n260\t    const hbY = 6;\n261\t    const hbW = 80;\n262\t    const hbH = 8;\n263\t    c.fillStyle = 'rgba(255,255,255,0.1)';\n264\t    c.fillRect(hbX, hbY, hbW, hbH);\n265\t    c.fillStyle = '#cc3333';\n266\t    c.fillRect(hbX, hbY, hbW * (state.player.health / 100), hbH);\n267\t    c.strokeStyle = 'rgba(255,255,255,0.2)';\n268\t    c.lineWidth = 1;\n269\t    c.strokeRect(hbX, hbY, hbW, hbH);\n270\t    c.fillStyle = '#aaa';\n271\t    c.font = '8px monospace';\n272\t    c.fillText('HP', hbX - 18, hbY + 7);\n273\t\n274\t    // Sanity bar\n275\t    const sbY = 18;\n276\t    c.fillStyle = 'rgba(255,255,255,0.1)';\n277\t    c.fillRect(hbX, sbY, hbW, hbH);\n278\t    c.fillStyle = '#6666cc';\n279\t    c.fillRect(hbX, sbY, hbW * (state.player.sanity / 100), hbH);\n280\t    c.strokeStyle = 'rgba(255,255,255,0.2)';\n281\t    c.strokeRect(hbX, sbY, hbW, hbH);\n282\t    c.fillStyle = '#aaa';\n283\t    c.fillText('SAN', hbX - 22, sbY + 7);\n284\t\n285\t    // Customer count\n286\t    if (ctx) {\n287\t      const custCount = ctx.customers.length;\n288\t      c.fillStyle = '#88aacc';\n289\t      c.font = '10px monospace';\n290\t      c.textAlign = 'left';\n291\t      c.fillText(`顾客: ${custCount}`, 420, 14);\n292\t    }\n293\t\n294\t    // Daily revenue\n295\t    c.fillStyle = '#88cc88';\n296\t    c.font = '10px monospace';\n297\t    c.textAlign = 'left';\n298\t    c.fillText(`今日: ¥${state.dailyRevenue.toFixed(0)}`, 500, 14);\n299\t\n300\t    // Shortcut hints\n301\t    c.fillStyle = 'rgba(255,255,255,0.4)';\n302\t    c.font = '10px monospace';\n303\t    c.textAlign = 'center';\n304\t    c.fillText('WASD 移动 | E 交互 | I 库存 | P 定价 | U 升级 | O 进货 | ESC 关闭', canvasW / 2, canvasH - 12);\n305\t\n306\t    // Notifications\n307\t    this.renderNotifications(c, canvasW, canvasH, state);\n308\t\n309\t    // Register status\n310\t    if (ctx) {\n311\t      this.renderRegisterStatus(c, canvasW, ctx.registers);\n312\t    }\n313\t  }\n314\t\n315\t  private renderNotifications(\n316\t    c: CanvasRenderingContext2D,\n317\t    w: number,\n318\t    h: number,\n319\t    state: GameState,\n320\t  ): void {\n321\t    const recent = state.notifications.slice(-5);\n322\t    if (recent.length === 0) return;\n323\t\n324\t    c.textAlign = 'right';\n325\t    c.font = '10px monospace';\n326\t    for (let i = 0; i < recent.length; i++) {\n327\t      const alpha = 0.3 + (i / recent.length) * 0.5;\n328\t      c.fillStyle = `rgba(200, 220, 255, ${alpha})`;\n329\t      c.fillText(recent[i], w - 12, h - 30 - (recent.length - 1 - i) * 14);\n330\t    }\n331\t  }\n332\t\n333\t  private renderRegisterStatus(\n334\t    c: CanvasRenderingContext2D,\n335\t    canvasW: number,\n336\t    registers: CashRegister[],\n337\t  ): void {\n338\t    let x = 12;\n339\t    const y = 48;\n340\t    for (const reg of registers) {\n341\t      const stateLabels: Record<string, string> = {\n342\t        idle: '空闲',\n343\t        scanning: '扫描中...',\n344\t        payment: '付款中',\n345\t        giving_change: '找零中',\n346\t        receipt: '打印收据',\n347\t        anomaly: '异常!',\n348\t      };\n349\t      const stateColors: Record<string, string> = {\n350\t        idle: '#666',\n351\t        scanning: '#6a6',\n352\t        payment: '#aa6',\n353\t        giving_change: '#6aa',\n354\t        receipt: '#66a',\n355\t        anomaly: '#a44',\n356\t      };\n357\t      const label = stateLabels[reg.state] ?? reg.state;\n358\t      const color = stateColors[reg.state] ?? '#666';\n359\t\n360\t      c.fillStyle = 'rgba(0,0,0,0.6)';\n361\t      c.fillRect(x, y, 80, 16);\n362\t      c.fillStyle = color;\n363\t      c.font = '9px monospace';\n364\t      c.textAlign = 'left';\n365\t      c.textBaseline = 'middle';\n366\t      c.fillText(`${reg.registerId}: ${label}`, x + 4, y + 8);\n367\t      x += 84;\n368\t    }\n369\t  }\n370\t\n371\t  private renderPanel(\n372\t    c: CanvasRenderingContext2D,\n373\t    w: number,\n374\t    h: number,\n375\t    state: GameState,\n376\t    ctx: RenderContext,\n377\t  ): void {\n378\t    // Darken background\n379\t    c.fillStyle = 'rgba(0,0,0,0.5)';\n380\t    c.fillRect(0, 0, w, h);\n381\t\n382\t    const panelW = Math.min(500, w - 40);\n383\t    const panelH = Math.min(400, h - 80);\n384\t    const px = (w - panelW) / 2;\n385\t    const py = (h - panelH) / 2;\n386\t\n387\t    // Panel background\n388\t    c.fillStyle = 'rgba(20, 20, 35, 0.95)';\n389\t    c.fillRect(px, py, panelW, panelH);\n390\t    c.strokeStyle = 'rgba(100, 120, 160, 0.5)';\n391\t    c.lineWidth = 1;\n392\t    c.strokeRect(px, py, panelW, panelH);\n393\t\n394\t    // Title bar\n395\t    c.fillStyle = 'rgba(40, 40, 60, 0.9)';\n396\t    c.fillRect(px, py, panelW, 30);\n397\t\n398\t    switch (state.activePanel) {\n399\t      case UIPanel.SHELF:\n400\t        this.renderShelfPanel(c, px, py, panelW, panelH, ctx);\n401\t        break;\n402\t      case UIPanel.INVENTORY:\n403\t        this.renderInventoryPanel(c, px, py, panelW, panelH, ctx);\n404\t        break;\n405\t      case UIPanel.PRICING:\n406\t        this.renderPricingPanel(c, px, py, panelW, panelH, ctx);\n407\t        break;\n408\t      case UIPanel.SHOP:\n409\t        this.renderShopPanel(c, px, py, panelW, panelH, ctx);\n410\t        break;\n411\t      case UIPanel.SUPPLIER:\n412\t        this.renderSupplierPanel(c, px, py, panelW, panelH, state, ctx);\n413\t        break;\n414\t    }\n415\t\n416\t    // Close button hint\n417\t    c.fillStyle = 'rgba(255,255,255,0.4)';\n418\t    c.font = '10px monospace';\n419\t    c.textAlign = 'center';\n420\t    c.fillText('按 ESC 或 E 关闭', w / 2, py + panelH + 15);\n421\t  }\n422\t\n423\t  private renderShelfPanel(\n424\t    c: CanvasRenderingContext2D,\n425\t    px: number, py: number,\n426\t    pw: number, ph: number,\n427\t    ctx: RenderContext,\n428\t  ): void {\n429\t    const shelf = ctx.shelfInteraction;\n430\t    if (!shelf.currentShelfId) return;\n431\t\n432\t    c.fillStyle = '#e0d0b0';\n433\t    c.font = 'bold 14px monospace';\n434\t    c.textAlign = 'left';\n435\t    c.textBaseline = 'top';\n436\t    c.fillText('货架管理', px + 10, py + 8);\n437\t\n438\t    const slot = ctx.productManager.shelfSlots.get(shelf.currentShelfId);\n439\t    if (!slot) return;\n440\t\n441\t    let y = py + 40;\n442\t\n443\t    if (slot.productId && slot.quantity > 0) {\n444\t      const product = ctx.productManager.getProduct(slot.productId);\n445\t      c.fillStyle = '#aac';\n446\t      c.font = '12px monospace';\n447\t      c.fillText(`商品: ${product?.name ?? slot.productId}`, px + 10, y);\n448\t      y += 18;\n449\t      c.fillText(`库存: ${slot.quantity}/${slot.maxQuantity}`, px + 10, y);\n450\t      y += 18;\n451\t      const price = ctx.pricing.getPrice(slot.productId);\n452\t      c.fillText(`售价: ¥${price.toFixed(2)}`, px + 10, y);\n453\t      y += 30;\n454\t    } else {\n455\t      c.fillStyle = '#888';\n456\t      c.font = '12px monospace';\n457\t      c.fillText('空货架', px + 10, y);\n458\t      y += 30;\n459\t    }\n460\t\n461\t    // Available products to stock\n462\t    c.fillStyle = '#ccc';\n463\t    c.font = '11px monospace';\n464\t    c.fillText('可上架商品:', px + 10, y);\n465\t    y += 18;\n466\t\n467\t    const available = shelf.getAvailableProductsForShelf(shelf.currentShelfId, ctx.productManager);\n468\t    for (let i = 0; i < Math.min(available.length, 8); i++) {\n469\t      const item = available[i];\n470\t      c.fillStyle = '#aab8cc';\n471\t      c.font = '11px monospace';\n472\t      c.fillText(`  ${item.name} x${item.quantity}`, px + 10, y);\n473\t      y += 16;\n474\t    }\n475\t\n476\t    if (available.length === 0) {\n477\t      c.fillStyle = '#666';\n478\t      c.fillText('  (无库存)', px + 10, y);\n479\t    }\n480\t  }\n481\t\n482\t  private renderInventoryPanel(\n483\t    c: CanvasRenderingContext2D,\n484\t    px: number, py: number,\n485\t    pw: number, ph: number,\n486\t    ctx: RenderContext,\n487\t  ): void {\n488\t    c.fillStyle = '#e0d0b0';\n489\t    c.font = 'bold 14px monospace';\n490\t    c.textAlign = 'left';\n491\t    c.textBaseline = 'top';\n492\t    c.fillText('库存管理', px + 10, py + 8);\n493\t\n494\t    let y = py + 40;\n495\t    c.fillStyle = '#aaa';\n496\t    c.font = '10px monospace';\n497\t    c.fillText(`仓库容量: ${ctx.productManager.storageUsed}/${ctx.productManager.storageCapacity}`, px + 10, y);\n498\t    y += 20;\n499\t\n500\t    for (const [id, item] of ctx.productManager.inventory) {\n501\t      if (item.quantity <= 0) continue;\n502\t      const product = ctx.productManager.getProduct(id);\n503\t      const price = ctx.pricing.getPrice(id);\n504\t      c.fillStyle = '#bbb';\n505\t      c.font = '11px monospace';\n506\t      c.fillText(`${product?.name ?? id}  x${item.quantity}  ¥${price.toFixed(2)}/个`, px + 10, y);\n507\t      y += 16;\n508\t      if (y > py + ph - 30) break;\n509\t    }\n510\t  }\n511\t\n512\t  private renderPricingPanel(\n513\t    c: CanvasRenderingContext2D,\n514\t    px: number, py: number,\n515\t    pw: number, ph: number,\n516\t    ctx: RenderContext,\n517\t  ): void {\n518\t    c.fillStyle = '#e0d0b0';\n519\t    c.font = 'bold 14px monospace';\n520\t    c.textAlign = 'left';\n521\t    c.textBaseline = 'top';\n522\t    c.fillText('定价管理', px + 10, py + 8);\n523\t\n524\t    let y = py + 40;\n525\t    const prices = ctx.pricing.getAllPrices();\n526\t\n527\t    c.fillStyle = '#888';\n528\t    c.font = '10px monospace';\n529\t    c.fillText('商品           基价      现价      范围', px + 10, y);\n530\t    y += 16;\n531\t\n532\t    for (const entry of prices) {\n533\t      const product = ctx.productManager.getProduct(entry.productId);\n534\t      if (!product) continue;\n535\t      c.fillStyle = '#bbb';\n536\t      c.font = '10px monospace';\n537\t      const name = product.name.padEnd(8, '　');\n538\t      c.fillText(\n539\t        `${name}  ¥${entry.basePrice.toFixed(0).padStart(3)}   ¥${entry.currentPrice.toFixed(0).padStart(3)}   ${entry.minPrice.toFixed(0)}-${entry.maxPrice.toFixed(0)}`,\n540\t        px + 10, y,\n541\t      );\n542\t      y += 14;\n543\t      if (y > py + ph - 30) break;\n544\t    }\n545\t  }\n546\t\n547\t  private renderShopPanel(\n548\t    c: CanvasRenderingContext2D,\n549\t    px: number, py: number,\n550\t    pw: number, ph: number,\n551\t    ctx: RenderContext,\n552\t  ): void {\n553\t    c.fillStyle = '#e0d0b0';\n554\t    c.font = 'bold 14px monospace';\n555\t    c.textAlign = 'left';\n556\t    c.textBaseline = 'top';\n557\t    c.fillText('店铺升级', px + 10, py + 8);\n558\t\n559\t    let y = py + 40;\n560\t    const upgrades = ctx.upgradeManager\n561\t      ? ctx.upgradeManager.getUpgrades()\n562\t      : ctx.economy.getUpgrades();\n563\t\n564\t    for (const upgrade of upgrades) {\n565\t      const owned = ctx.upgradeManager\n566\t        ? ctx.upgradeManager.isPurchased(upgrade.id)\n567\t        : ctx.economy.hasUpgrade(upgrade.id);\n568\t      c.fillStyle = owned ? '#5a7a5a' : '#bbb';\n569\t      c.font = '11px monospace';\n570\t      c.fillText(\n571\t        `${owned ? '[已购]' : `¥${upgrade.cost}`.padStart(6)} ${upgrade.name} — ${upgrade.description}`,\n572\t        px + 10, y,\n573\t      );\n574\t      y += 16;\n575\t      c.fillStyle = '#777';\n576\t      c.font = '9px monospace';\n577\t      c.fillText(`  ${upgrade.horrorLink}`, px + 10, y);\n578\t      y += 14;\n579\t      if (y > py + ph - 30) break;\n580\t    }\n581\t  }\n582\t\n583\t  private renderSupplierPanel(\n584\t    c: CanvasRenderingContext2D,\n585\t    px: number, py: number,\n586\t    pw: number, ph: number,\n587\t    state: GameState,\n588\t    ctx: RenderContext,\n589\t  ): void {\n590\t    c.fillStyle = '#e0d0b0';\n591\t    c.font = 'bold 14px monospace';\n592\t    c.textAlign = 'left';\n593\t    c.textBaseline = 'top';\n594\t    c.fillText('进货管理', px + 10, py + 8);\n595\t\n596\t    let y = py + 40;\n597\t\n598\t    // Show suppliers\n599\t    const isNight = isNightTime(state.phase);\n600\t    const suppliers = ctx.productManager.getUnlockedSuppliers(state.day, isNight);\n601\t    c.fillStyle = '#888';\n602\t    c.font = '10px monospace';\n603\t    c.fillText('可用供应商:', px + 10, y);\n604\t    y += 16;\n605\t\n606\t    for (const supplier of suppliers) {\n607\t      c.fillStyle = '#aab8cc';\n608\t      c.font = '11px monospace';\n609\t      c.fillText(`${supplier.name} — ${supplier.description}`, px + 10, y);\n610\t      y += 14;\n611\t      c.fillStyle = '#777';\n612\t      c.font = '9px monospace';\n613\t      c.fillText(`  价格x${supplier.priceMultiplier} 可靠度${Math.round(supplier.reliability * 100)}%`, px + 10, y);\n614\t      y += 16;\n615\t    }\n616\t\n617\t    y += 10;\n618\t\n619\t    // Pending orders\n620\t    if (ctx.productManager.pendingOrders.length > 0) {\n621\t      c.fillStyle = '#888';\n622\t      c.font = '10px monospace';\n623\t      c.fillText('待到货订单:', px + 10, y);\n624\t      y += 16;\n625\t\n626\t      for (const order of ctx.productManager.pendingOrders) {\n627\t        const product = ctx.productManager.getProduct(order.productId);\n628\t        c.fillStyle = '#cc9';\n629\t        c.font = '10px monospace';\n630\t        c.fillText(`${product?.name ?? order.productId} x${order.quantity} — ¥${order.totalCost} (Day ${order.arrivalDay}到)`, px + 10, y);\n631\t        y += 14;\n632\t        if (y > py + ph - 30) break;\n633\t      }\n634\t    }\n635\t  }\n636\t\n637\t  // M4: Horror visual effects rendering\n638\t  private renderHorrorEffects(\n639\t    c: CanvasRenderingContext2D,\n640\t    w: number,\n641\t    h: number,\n642\t    vs: HorrorVisualState,\n643\t    now: number,\n644\t    state: GameState,\n645\t  ): void {\n646\t    // Vignette (always present at night, stronger during horror)\n647\t    if (vs.vignetteIntensity > 0) {\n648\t      const vigGrad = c.createRadialGradient(w / 2, h / 2, w * 0.3, w / 2, h / 2, w * 0.7);\n649\t      vigGrad.addColorStop(0, 'rgba(0,0,0,0)');\n650\t      vigGrad.addColorStop(1, `rgba(0,0,0,${vs.vignetteIntensity})`);\n651\t      c.fillStyle = vigGrad;\n652\t      c.fillRect(0, 0, w, h);\n653\t    }\n654\t\n655\t    // Frost effect (temp drop)\n656\t    if (vs.frostIntensity > 0) {\n657\t      const fi = vs.frostIntensity;\n658\t      const frostGrad = c.createRadialGradient(w / 2, h / 2, w * 0.35, w / 2, h / 2, w * 0.6);\n659\t      frostGrad.addColorStop(0, 'rgba(0,0,0,0)');\n660\t      frostGrad.addColorStop(0.7, `rgba(180,210,240,${fi * 0.15})`);\n661\t      frostGrad.addColorStop(1, `rgba(200,220,255,${fi * 0.4})`);\n662\t      c.fillStyle = frostGrad;\n663\t      c.fillRect(0, 0, w, h);\n664\t\n665\t      c.fillStyle = `rgba(220,240,255,${fi * 0.6})`;\n666\t      const seed = Math.floor(now * 0.001);\n667\t      for (let i = 0; i < 30; i++) {\n668\t        const px = ((seed * 7 + i * 131) % w);\n669\t        const py = ((seed * 13 + i * 97) % h);\n670\t        const size = 1 + ((seed + i * 17) % 3);\n671\t        c.fillRect(px, py, size, size);\n672\t      }\n673\t    }\n674\t\n675\t    // Extra darkness\n676\t    if (vs.darknessBoost > 0) {\n677\t      c.fillStyle = `rgba(0,0,5,${vs.darknessBoost})`;\n678\t      c.fillRect(0, 0, w, h);\n679\t    }\n680\t\n681\t    // Screen shake\n682\t    if (vs.screenShake > 0) {\n683\t      const shakeX = (Math.random() - 0.5) * vs.screenShake * 6;\n684\t      const shakeY = (Math.random() - 0.5) * vs.screenShake * 6;\n685\t      c.drawImage(c.canvas, shakeX, shakeY);\n686\t    }\n687\t\n688\t    // Chromatic aberration\n689\t    if (vs.chromaticAberration > 0) {\n690\t      const ca = vs.chromaticAberration;\n691\t      c.globalCompositeOperation = 'lighter';\n692\t      c.globalAlpha = ca * 0.08;\n693\t      c.fillStyle = '#ff0000';\n694\t      c.fillRect(ca * -3, 0, w, h);\n695\t      c.fillStyle = '#0000ff';\n696\t      c.fillRect(ca * 3, 0, w, h);\n697\t      c.globalAlpha = 1;\n698\t      c.globalCompositeOperation = 'source-over';\n699\t    }\n700\t\n701\t    // Blood on shelves\n702\t    for (const blood of vs.bloodPositions) {\n703\t      c.fillStyle = `rgba(120, 10, 10, ${blood.alpha})`;\n704\t      c.beginPath();\n705\t      c.ellipse(blood.x, blood.y, blood.size, blood.size * 0.7, 0, 0, Math.PI * 2);\n706\t      c.fill();\n707\t      c.fillStyle = `rgba(100, 5, 5, ${blood.alpha * 0.7})`;\n708\t      c.fillRect(blood.x - 2, blood.y, 4, blood.size * 1.5);\n709\t    }\n710\t\n711\t    // Ghost entities\n712\t    if (vs.ghostEntity && vs.ghostEntity.active && vs.ghostEntity.opacity > 0.01) {\n713\t      const ge = vs.ghostEntity;\n714\t      c.globalAlpha = ge.opacity;\n715\t\n716\t      switch (ge.type) {\n717\t        case 'ghost_customer':\n718\t          c.fillStyle = '#8899aa';\n719\t          c.fillRect(ge.x, ge.y + 16, 16, 24);\n720\t          c.fillStyle = '#aabbcc';\n721\t          c.beginPath();\n722\t          c.arc(ge.x + 8, ge.y + 8, 8, 0, Math.PI * 2);\n723\t          c.fill();\n724\t          break;\n725\t        case 'duplicate':\n726\t          c.fillStyle = '#444455';\n727\t          c.fillRect(ge.x, ge.y + 8, 16, 28);\n728\t          c.fillStyle = '#888899';\n729\t          c.fillRect(ge.x + 2, ge.y, 12, 10);\n730\t          c.fillStyle = '#ff0000';\n731\t          c.fillRect(ge.x + 4, ge.y + 3, 3, 2);\n732\t          c.fillRect(ge.x + 10, ge.y + 3, 3, 2);\n733\t          break;\n734\t        case 'nonpaying':\n735\t          c.fillStyle = '#1a1a22';\n736\t          c.fillRect(ge.x, ge.y + 8, 16, 28);\n737\t          c.fillStyle = '#777788';\n738\t          c.fillRect(ge.x + 2, ge.y, 12, 10);\n739\t          c.fillStyle = '#ccddff';\n740\t          c.fillRect(ge.x + 4, ge.y + 3, 2, 3);\n741\t          c.fillRect(ge.x + 10, ge.y + 3, 2, 3);\n742\t          break;\n743\t      }\n744\t      c.globalAlpha = 1;\n745\t    }\n746\t\n747\t    // Door open darkness\n748\t    if (vs.doorState.frontOpen || vs.doorState.backOpen) {\n749\t      c.fillStyle = 'rgba(0,0,0,0.9)';\n750\t      c.fillRect(0, 0, w, h * 0.15);\n751\t      c.fillRect(0, h * 0.85, w, h * 0.15);\n752\t    }\n753\t\n754\t    // Time glitch\n755\t    if (vs.timeGlitchActive) {\n756\t      c.fillStyle = 'rgba(255,0,0,0.05)';\n757\t      c.fillRect(0, 0, w, h);\n758\t      for (let i = 0; i < 8; i++) {\n759\t        const y = (now * 0.1 + i * 67) % h;\n760\t        c.fillStyle = `rgba(${Math.random() > 0.5 ? '255,0,0' : '0,0,255'},0.1)`;\n761\t        c.fillRect(0, y, w, 2);\n762\t      }\n763\t    }\n764\t\n765\t    // Whisper overlay\n766\t    if (vs.whisperActive) {\n767\t      c.fillStyle = `rgba(150, 130, 200, ${0.1 + Math.sin(now * 0.005) * 0.05})`;\n768\t      c.fillRect(0, 0, w, h);\n769\t    }\n770\t\n771\t    // Ambient fear tint\n772\t    if (vs.ambientFear > 0.2) {\n773\t      const fearPulse = Math.sin(now * 0.002) * 0.03;\n774\t      c.fillStyle = `rgba(30, 0, 0, ${(vs.ambientFear - 0.2) * 0.1 + fearPulse})`;\n775\t      c.fillRect(0, 0, w, h);\n776\t    }\n777\t\n778\t    // Fear HUD\n779\t    if (isNightTime(state.phase) && vs.ambientFear > 0.3) {\n780\t      c.fillStyle = `rgba(255, 50, 50, ${0.4 + Math.sin(now * 0.003) * 0.2})`;\n781\t      c.font = 'bold 11px monospace';\n782\t      c.textAlign = 'left';\n783\t      c.textBaseline = 'top';\n784\t      c.fillText(`⚠ 恐惧: ${Math.round(vs.ambientFear * 100)}%`, 12, 32);\n785\t    }\n786\t  }\n787\t\n788\t  destroy(): void {}\n789\t}\n790\t"}]},"parent_tool_use_id":"call_37a82845ea3e4d0c88fbf309","session_id":"561a5118-a4d0-464b-8f32-001690e29cb0","uuid":"cf5ff394-e5ae-4476-84fd-cb7070a0e791","timestamp":"2026-05-23T10:14:00.847Z","subagent_type":"general-purpose","task_description":"Read horror sim source"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_b81a7b21e08d4e1bb6acbefe","type":"tool_result","content":"1\t// NarrativeTypes.ts — Shared types for the M6 narrative system\n2\t\n3\texport enum StoryLayer {\n4\t  SURFACE = 'surface',           // Day 1-5: 店有点奇怪\n5\t  FIRST = 'first',               // Day 6-10: 前任店员笔记\n6\t  SECOND = 'second',             // Day 11-15: 店建在特殊位置\n7\t  THIRD = 'third',               // Day 16-20: \"他\"是古老存在\n8\t  FOURTH = 'fourth',             // Day 21-25: 你是第N任店员\n9\t  CORE = 'core',                 // Day 26-30: 真相\n10\t}\n11\t\n12\texport enum ClueType {\n13\t  NOTE = 'note',                 // 前任店员笔记\n14\t  CCTV = 'cctv',                 // 监控录像\n15\t  PRODUCT = 'product',           // 异常商品描述\n16\t  RADIO = 'radio',               // 深夜广播\n17\t  CUSTOMER = 'customer',         // 顾客对话\n18\t  ENVIRONMENT = 'environment',   // 环境叙事\n19\t}\n20\t\n21\texport enum ClueCategory {\n22\t  PREVIOUS_CLERK = 'previous_clerck', // 前任店员\n23\t  LOCATION = 'location',               // 店铺位置\n24\t  ENTITY = 'entity',                   // \"他\"\n25\t  HISTORY = 'history',                 // 历任店员\n26\t  TRUTH = 'truth',                     // 最终真相\n27\t  STORE = 'store',                     // 店铺本身\n28\t}\n29\t\n30\texport interface Clue {\n31\t  id: string;\n32\t  name: string;\n33\t  description: string;\n34\t  content: string;\n35\t  type: ClueType;\n36\t  category: ClueCategory;\n37\t  layer: StoryLayer;\n38\t  minDay: number;\n39\t  location?: string;\n40\t  requiresClue?: string;   // prerequisite clue id\n41\t  acquired: boolean;\n42\t  acquiredDay?: number;\n43\t}\n44\t\n45\texport enum EndingType {\n46\t  ESCAPE = 'escape',       // A: 逃离\n47\t  TAKEOVER = 'takeover',   // B: 接管\n48\t  RESIST = 'resist',       // C: 对抗\n49\t  MERGE = 'merge',         // D: 融合\n50\t  TRUTH = 'truth',         // E: 真相\n51\t}\n52\t\n53\texport interface Ending {\n54\t  type: EndingType;\n55\t  title: string;\n56\t  description: string;\n57\t  triggerDescription: string;\n58\t  unlockConditions: {\n59\t    minDay: number;\n60\t    minClues: number;\n61\t    requiredFlags: string[];\n62\t  };\n63\t  endingText: string[];\n64\t}\n65\t\n66\texport interface NarrativeChoice {\n67\t  id: string;\n68\t  layer: StoryLayer;\n69\t  triggerDay: number;\n70\t  triggerPhase: string;\n71\t  title: string;\n72\t  description: string;\n73\t  options: NarrativeOption[];\n74\t  made: boolean;\n75\t  chosenOption?: string;\n76\t}\n77\t\n78\texport interface NarrativeOption {\n79\t  id: string;\n80\t  text: string;\n81\t  flag: string;            // flag set when chosen\n82\t  sanityCost: number;\n83\t  clueReward?: string;     // clue id granted\n84\t  consequence: string;     // description of consequence\n85\t}\n86\t\n87\texport interface RadioSegment {\n88\t  id: string;\n89\t  title: string;\n90\t  minDay: number;\n91\t  requiredHour: number;     // 23-5\n92\t  content: string[];\n93\t  clueId?: string;          // grants this clue when listened\n94\t  duration: number;         // seconds\n95\t}\n96\t\n97\texport interface StoryNote {\n98\t  id: string;\n99\t  title: string;\n100\t  content: string;\n101\t  layer: StoryLayer;\n102\t  minDay: number;\n103\t  location: string;         // where the note is found\n104\t  type: 'diary' | 'research' | 'warning' | 'receipt' | 'photo';\n105\t  clueIds: string[];        // clues granted when read\n106\t  read: boolean;\n107\t  readDay?: number;\n108\t}\n109\t\n110\texport interface NarrativeState {\n111\t  currentLayer: StoryLayer;\n112\t  storyProgress: number;    // 0-1 per layer\n113\t  flags: Set<string>;\n114\t  totalCluesFound: number;\n115\t  choicesMade: number;\n116\t  endingReached?: EndingType;\n117\t}\n118\t"}]},"parent_tool_use_id":"call_37a82845ea3e4d0c88fbf309","session_id":"561a5118-a4d0-464b-8f32-001690e29cb0","uuid":"7eb4d64a-a9bd-4f84-8d7b-92ffb185fa35","timestamp":"2026-05-23T10:14:01.783Z","subagent_type":"general-purpose","task_description":"Read horror sim source"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_00a587bf02c546999d668160","type":"tool_result","content":"1\t// Lighting.ts — 2D lighting with day/night gradual transitions (v0.3.0 — M3)\n2\t\n3\timport type { LightSource, GamePhase } from '../game/GameState';\n4\timport { isNightTime } from '../game/GameState';\n5\t\n6\texport class Lighting {\n7\t  private lightCanvas: HTMLCanvasElement;\n8\t  private lightCtx: CanvasRenderingContext2D;\n9\t  private lightBoost = 1.0;\n10\t\n11\t  constructor() {\n12\t    this.lightCanvas = document.createElement('canvas');\n13\t    this.lightCtx = this.lightCanvas.getContext('2d')!;\n14\t  }\n15\t\n16\t  setLightBoost(boost: number): void {\n17\t    this.lightBoost = boost;\n18\t  }\n19\t\n20\t  private getDaylightFactor(timeOfDay: number): number {\n21\t    if (timeOfDay >= 6 && timeOfDay < 7) return timeOfDay - 6;\n22\t    if (timeOfDay >= 7 && timeOfDay < 17) return 1;\n23\t    if (timeOfDay >= 17 && timeOfDay < 18) return 18 - timeOfDay;\n24\t    return 0;\n25\t  }\n26\t\n27\t  private getDarknessLevel(phase: GamePhase, timeOfDay: number): number {\n28\t    const daylight = this.getDaylightFactor(timeOfDay);\n29\t    if (daylight >= 1) return 0;\n30\t\n31\t    let nightDarkness = 0;\n32\t    if (phase === 'night_transition') nightDarkness = 0.3;\n33\t    else if (phase === 'night') nightDarkness = 0.6;\n34\t    else if (phase === 'danger') nightDarkness = 0.85;\n35\t    else if (phase === 'dawn') {\n36\t      if (timeOfDay >= 29) nightDarkness = Math.max(0, 0.4 * (30 - timeOfDay));\n37\t      else nightDarkness = 0.4;\n38\t    }\n39\t\n40\t    if (daylight > 0) return nightDarkness * (1 - daylight);\n41\t    return nightDarkness;\n42\t  }\n43\t\n44\t  render(\n45\t    ctx: CanvasRenderingContext2D,\n46\t    width: number,\n47\t    height: number,\n48\t    lights: LightSource[],\n49\t    phase: GamePhase,\n50\t    offsetX: number,\n51\t    offsetY: number,\n52\t    scale: number,\n53\t    now: number,\n54\t    timeOfDay?: number,\n55\t  ): void {\n56\t    const tod = timeOfDay ?? 12;\n57\t    const daylight = this.getDaylightFactor(tod);\n58\t\n59\t    if (daylight >= 1) {\n60\t      this.renderDayOverlay(ctx, width, height);\n61\t      return;\n62\t    }\n63\t\n64\t    const darkness = this.getDarknessLevel(phase, tod);\n65\t    if (darkness <= 0 && daylight > 0) {\n66\t      this.renderTransitionOverlay(ctx, width, height, daylight);\n67\t      return;\n68\t    }\n69\t\n70\t    this.lightCanvas.width = width;\n71\t    this.lightCanvas.height = height;\n72\t    const lctx = this.lightCtx;\n73\t\n74\t    lctx.fillStyle = `rgba(5, 5, 20, ${darkness})`;\n75\t    lctx.fillRect(0, 0, width, height);\n76\t\n77\t    lctx.globalCompositeOperation = 'destination-out';\n78\t\n79\t    for (const light of lights) {\n80\t      const screenX = offsetX + light.x * scale;\n81\t      const screenY = offsetY + light.y * scale;\n82\t      const radius = light.radius * scale * this.lightBoost;\n83\t      let intensity = light.intensity;\n84\t\n85\t      if (daylight > 0) {\n86\t        intensity *= (1 - daylight);\n87\t      }\n88\t\n89\t      if (light.flicker) {\n90\t        const flicker = Math.sin(now * light.flickerSpeed * 0.001) * 0.1 +\n91\t          Math.sin(now * light.flickerSpeed * 0.003) * 0.05;\n92\t        intensity = Math.max(0.3, Math.min(1, intensity + flicker));\n93\t      }\n94\t\n95\t      const gradient = lctx.createRadialGradient(screenX, screenY, 0, screenX, screenY, radius);\n96\t      gradient.addColorStop(0, `rgba(0, 0, 0, ${intensity})`);\n97\t      gradient.addColorStop(0.4, `rgba(0, 0, 0, ${intensity * 0.6})`);\n98\t      gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');\n99\t\n100\t      lctx.fillStyle = gradient;\n101\t      lctx.beginPath();\n102\t      lctx.arc(screenX, screenY, radius, 0, Math.PI * 2);\n103\t      lctx.fill();\n104\t    }\n105\t\n106\t    lctx.globalCompositeOperation = 'source-over';\n107\t\n108\t    lctx.globalCompositeOperation = 'source-atop';\n109\t    const tintAlpha = darkness * 0.15;\n110\t    lctx.fillStyle = `rgba(20, 40, 80, ${tintAlpha})`;\n111\t    lctx.fillRect(0, 0, width, height);\n112\t    lctx.globalCompositeOperation = 'source-over';\n113\t\n114\t    ctx.drawImage(this.lightCanvas, 0, 0);\n115\t  }\n116\t\n117\t  private renderDayOverlay(ctx: CanvasRenderingContext2D, w: number, h: number): void {\n118\t    ctx.fillStyle = 'rgba(255, 240, 200, 0.04)';\n119\t    ctx.fillRect(0, 0, w, h);\n120\t  }\n121\t\n122\t  private renderTransitionOverlay(ctx: CanvasRenderingContext2D, w: number, h: number, daylight: number): void {\n123\t    const alpha = (1 - daylight) * 0.1;\n124\t    ctx.fillStyle = `rgba(20, 20, 40, ${alpha})`;\n125\t    ctx.fillRect(0, 0, w, h);\n126\t  }\n127\t}\n128\t"}]},"parent_tool_use_id":"call_37a82845ea3e4d0c88fbf309","session_id":"561a5118-a4d0-464b-8f32-001690e29cb0","uuid":"a10ffc76-51e0-495f-aebf-f6a96ec4c00a","timestamp":"2026-05-23T10:14:01.991Z","subagent_type":"general-purpose","task_description":"Read horror sim source"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6174ef7dabf742f79874d86e","type":"tool_result","content":"1\t// DaySummary.ts — Daily settlement system with Canvas UI (M3)\n2\t\n3\timport { type GameState } from './GameState';\n4\timport { type DayReport, type EconomySystem } from './EconomySystem';\n5\timport { type CustomerManager } from './CustomerManager';\n6\t\n7\texport interface DaySummaryEntry {\n8\t  day: number;\n9\t  revenue: number;\n10\t  expenses: number;\n11\t  rent: number;\n12\t  electricity: number;\n13\t  purchaseCost: number;\n14\t  netIncome: number;\n15\t  debtPayment: number;\n16\t  debtRemaining: number;\n17\t  customersServed: number;\n18\t  customersLost: number;\n19\t  inventoryValue: number;\n20\t}\n21\t\n22\texport class DaySummaryManager {\n23\t  private summaries: DaySummaryEntry[] = [];\n24\t  private showSummary = false;\n25\t  private currentSummary: DaySummaryEntry | null = null;\n26\t  private summaryDisplayTimer = 0;\n27\t  private readonly DISPLAY_DURATION = 8000;\n28\t\n29\t  get isVisible(): boolean { return this.showSummary; }\n30\t  get current(): DaySummaryEntry | null { return this.currentSummary; }\n31\t  get allSummaries(): DaySummaryEntry[] { return this.summaries; }\n32\t\n33\t  generateSummary(\n34\t    report: DayReport,\n35\t    customerManager: CustomerManager,\n36\t  ): DaySummaryEntry {\n37\t    const stats = customerManager.getStats();\n38\t    const entry: DaySummaryEntry = {\n39\t      day: report.day,\n40\t      revenue: report.revenue,\n41\t      expenses: report.expenses,\n42\t      rent: report.rent,\n43\t      electricity: report.electricity,\n44\t      purchaseCost: report.purchaseCost,\n45\t      netIncome: report.netIncome,\n46\t      debtPayment: report.debtPayment,\n47\t      debtRemaining: report.debtRemaining,\n48\t      customersServed: stats.served,\n49\t      customersLost: stats.lost,\n50\t      inventoryValue: 0,\n51\t    };\n52\t    this.summaries.push(entry);\n53\t    this.currentSummary = entry;\n54\t    this.showSummary = true;\n55\t    this.summaryDisplayTimer = 0;\n56\t    return entry;\n57\t  }\n58\t\n59\t  update(dt: number): void {\n60\t    if (!this.showSummary) return;\n61\t    this.summaryDisplayTimer += dt;\n62\t    if (this.summaryDisplayTimer >= this.DISPLAY_DURATION) {\n63\t      this.showSummary = false;\n64\t    }\n65\t  }\n66\t\n67\t  dismiss(): void {\n68\t    this.showSummary = false;\n69\t  }\n70\t\n71\t  render(c: CanvasRenderingContext2D, w: number, h: number): void {\n72\t    if (!this.showSummary || !this.currentSummary) return;\n73\t\n74\t    const s = this.currentSummary;\n75\t    const panelW = 320;\n76\t    const panelH = 340;\n77\t    const px = (w - panelW) / 2;\n78\t    const py = (h - panelH) / 2;\n79\t\n80\t    c.fillStyle = 'rgba(0, 0, 0, 0.85)';\n81\t    c.fillRect(px, py, panelW, panelH);\n82\t    c.strokeStyle = '#8a7a60';\n83\t    c.lineWidth = 2;\n84\t    c.strokeRect(px, py, panelW, panelH);\n85\t\n86\t    let y = py + 12;\n87\t\n88\t    c.fillStyle = '#e0c890';\n89\t    c.font = 'bold 16px monospace';\n90\t    c.textAlign = 'center';\n91\t    c.textBaseline = 'top';\n92\t    c.fillText(`— Day ${s.day} 结算 —`, px + panelW / 2, y);\n93\t    y += 30;\n94\t\n95\t    const leftX = px + 20;\n96\t    const rightX = px + panelW - 20;\n97\t\n98\t    const drawRow = (label: string, value: string, color: string) => {\n99\t      c.fillStyle = '#aaa';\n100\t      c.font = '11px monospace';\n101\t      c.textAlign = 'left';\n102\t      c.fillText(label, leftX, y);\n103\t      c.fillStyle = color;\n104\t      c.textAlign = 'right';\n105\t      c.fillText(value, rightX, y);\n106\t      y += 18;\n107\t    };\n108\t\n109\t    drawRow('今日收入', `¥${s.revenue.toFixed(0)}`, '#88cc88');\n110\t    drawRow('采购成本', `¥${s.purchaseCost.toFixed(0)}`, '#cc8888');\n111\t    drawRow('房租', `¥${s.rent}`, '#cc8888');\n112\t    drawRow('电费', `¥${s.electricity}`, '#cc8888');\n113\t    drawRow('今日支出', `¥${s.expenses.toFixed(0)}`, '#cc8888');\n114\t    drawRow('债务还款', `¥${s.debtPayment}`, '#cc8866');\n115\t\n116\t    y += 6;\n117\t    c.strokeStyle = 'rgba(255,255,255,0.2)';\n118\t    c.lineWidth = 1;\n119\t    c.beginPath();\n120\t    c.moveTo(leftX, y);\n121\t    c.lineTo(rightX, y);\n122\t    c.stroke();\n123\t    y += 10;\n124\t\n125\t    drawRow('净利润', `¥${s.netIncome.toFixed(0)}`, s.netIncome >= 0 ? '#88cc88' : '#ff6666');\n126\t    drawRow('剩余债务', `¥${s.debtRemaining.toLocaleString()}`, '#cc6666');\n127\t    drawRow('服务顾客', `${s.customersServed}`, '#88aacc');\n128\t    drawRow('流失顾客', `${s.customersLost}`, '#aa8866');\n129\t\n130\t    y += 20;\n131\t    c.fillStyle = 'rgba(255,255,255,0.3)';\n132\t    c.font = '10px monospace';\n133\t    c.textAlign = 'center';\n134\t    c.fillText('按任意键关闭', px + panelW / 2, y);\n135\t  }\n136\t\n137\t  getSaveData(): Record<string, unknown> {\n138\t    return { summaries: this.summaries.slice(-30) };\n139\t  }\n140\t\n141\t  loadSaveData(data: Record<string, unknown>): void {\n142\t    if (data.summaries) {\n143\t      this.summaries = data.summaries as DaySummaryEntry[];\n144\t    }\n145\t  }\n146\t}\n147\t"}]},"parent_tool_use_id":"call_37a82845ea3e4d0c88fbf309","session_id":"561a5118-a4d0-464b-8f32-001690e29cb0","uuid":"dc21082a-dbd1-4400-9846-2854e2e8c721","timestamp":"2026-05-23T10:14:02.057Z","subagent_type":"general-purpose","task_description":"Read horror sim source"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_5f6491a1d4944648a774862c","type":"tool_result","content":"1\t// UpgradeManager.ts — Shop upgrade management with effects (M3)\n2\t\n3\texport interface UpgradeDef {\n4\t  id: string;\n5\t  name: string;\n6\t  description: string;\n7\t  cost: number;\n8\t  effect: string;\n9\t  value?: number;\n10\t  horrorLink: string;\n11\t}\n12\t\n13\tconst ALL_UPGRADES: UpgradeDef[] = [\n14\t  { id: 'bright_lights', name: '更亮的灯', description: '店内照明+50%', cost: 500, effect: 'light_boost', value: 1.5, horrorLink: '暗角减少，但某些东西在亮处更清楚' },\n15\t  { id: 'warehouse_shelf', name: '仓库货架', description: '库存+50%', cost: 800, effect: 'storage_capacity', value: 1.5, horrorLink: '仓库更深更暗...' },\n16\t  { id: 'register_upgrade', name: '收银机升级', description: '交易速度+30%', cost: 1000, effect: 'checkout_speed', value: 0.7, horrorLink: '异常收银记录更精确' },\n17\t  { id: 'camera', name: '监控摄像头', description: '实时查看店内各区域', cost: 2000, effect: 'enable_camera_view', horrorLink: '夜晚录像中可能看到不该看到的东西' },\n18\t  { id: 'security_door', name: '防盗门', description: '后门加固', cost: 3000, effect: 'block_back_intrusion', horrorLink: '减少物理入侵事件，但也减少了逃跑路线' },\n19\t  { id: 'emergency_button', name: '紧急按钮', description: '按下后...', cost: 5000, effect: 'emergency_call', horrorLink: '会有人来吗？' },\n20\t];\n21\t\n22\texport class UpgradeManager {\n23\t  private purchased: Set<string> = new Set();\n24\t\n25\t  getUpgrades(): UpgradeDef[] {\n26\t    return ALL_UPGRADES;\n27\t  }\n28\t\n29\t  getAvailableUpgrades(): UpgradeDef[] {\n30\t    return ALL_UPGRADES.filter(u => !this.purchased.has(u.id));\n31\t  }\n32\t\n33\t  isPurchased(id: string): boolean {\n34\t    return this.purchased.has(id);\n35\t  }\n36\t\n37\t  canAfford(id: string, money: number): boolean {\n38\t    const upgrade = ALL_UPGRADES.find(u => u.id === id);\n39\t    return upgrade !== undefined && !this.purchased.has(id) && money >= upgrade.cost;\n40\t  }\n41\t\n42\t  purchase(id: string, money: number): { success: boolean; cost: number; message: string } {\n43\t    const upgrade = ALL_UPGRADES.find(u => u.id === id);\n44\t    if (!upgrade) return { success: false, cost: 0, message: '升级不存在' };\n45\t    if (this.purchased.has(id)) return { success: false, cost: 0, message: '已购买' };\n46\t    if (money < upgrade.cost) return { success: false, cost: 0, message: '余额不足' };\n47\t\n48\t    this.purchased.add(id);\n49\t    return { success: true, cost: upgrade.cost, message: `已购买: ${upgrade.name}` };\n50\t  }\n51\t\n52\t  getLightBoost(): number {\n53\t    if (this.purchased.has('bright_lights')) return 1.5;\n54\t    return 1.0;\n55\t  }\n56\t\n57\t  getStorageMultiplier(): number {\n58\t    if (this.purchased.has('warehouse_shelf')) return 1.5;\n59\t    return 1.0;\n60\t  }\n61\t\n62\t  getCheckoutSpeedMultiplier(): number {\n63\t    if (this.purchased.has('register_upgrade')) return 0.7;\n64\t    return 1.0;\n65\t  }\n66\t\n67\t  hasCamera(): boolean {\n68\t    return this.purchased.has('camera');\n69\t  }\n70\t\n71\t  hasSecurityDoor(): boolean {\n72\t    return this.purchased.has('security_door');\n73\t  }\n74\t\n75\t  hasEmergencyButton(): boolean {\n76\t    return this.purchased.has('emergency_button');\n77\t  }\n78\t\n79\t  getSaveData(): Record<string, unknown> {\n80\t    return { purchased: Array.from(this.purchased) };\n81\t  }\n82\t\n83\t  loadSaveData(data: Record<string, unknown>): void {\n84\t    if (data.purchased) {\n85\t      this.purchased = new Set(data.purchased as string[]);\n86\t    }\n87\t  }\n88\t}\n89\t"}]},"parent_tool_use_id":"call_37a82845ea3e4d0c88fbf309","session_id":"561a5118-a4d0-464b-8f32-001690e29cb0","uuid":"1059ca3c-a940-496f-adaa-9110c9851740","timestamp":"2026-05-23T10:14:02.402Z","subagent_type":"general-purpose","task_description":"Read horror sim source"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_dbec93c4a9874295bc023ecd","type":"tool_result","content":"1\t// BehaviorTree.ts — NPC behavior tree system (M5)\n2\t\n3\t// --- Node Status ---\n4\t\n5\texport enum NodeStatus {\n6\t  SUCCESS = 'success',\n7\t  FAILURE = 'failure',\n8\t  RUNNING = 'running',\n9\t}\n10\t\n11\t// --- Context shared across all nodes ---\n12\t\n13\texport interface BehaviorContext {\n14\t  selfX: number;\n15\t  selfY: number;\n16\t  playerX: number;\n17\t  playerY: number;\n18\t  day: number;\n19\t  timeOfDay: number;\n20\t  sanity: number;\n21\t  fearLevel: number;\n22\t  canSeePlayer: boolean;\n23\t  distanceToPlayer: number;\n24\t  recentEvents: string[];\n25\t  dt: number;\n26\t  elapsedSec: number;\n27\t  storeOpen: boolean;\n28\t}\n29\t\n30\t// --- Base Node ---\n31\t\n32\texport abstract class BTNode {\n33\t  abstract tick(ctx: BehaviorContext): NodeStatus;\n34\t  reset(): void {}\n35\t}\n36\t\n37\t// --- Composite: Selector (OR — first success wins) ---\n38\t\n39\texport class Selector extends BTNode {\n40\t  private children: BTNode[];\n41\t  private currentIndex = 0;\n42\t\n43\t  constructor(children: BTNode[]) {\n44\t    super();\n45\t    this.children = children;\n46\t  }\n47\t\n48\t  tick(ctx: BehaviorContext): NodeStatus {\n49\t    for (let i = this.currentIndex; i < this.children.length; i++) {\n50\t      const status = this.children[i].tick(ctx);\n51\t      if (status === NodeStatus.RUNNING) {\n52\t        this.currentIndex = i;\n53\t        return NodeStatus.RUNNING;\n54\t      }\n55\t      if (status === NodeStatus.SUCCESS) {\n56\t        this.reset();\n57\t        return NodeStatus.SUCCESS;\n58\t      }\n59\t    }\n60\t    this.reset();\n61\t    return NodeStatus.FAILURE;\n62\t  }\n63\t\n64\t  reset(): void {\n65\t    this.currentIndex = 0;\n66\t    for (const child of this.children) child.reset();\n67\t  }\n68\t}\n69\t\n70\t// --- Composite: Sequence (AND — all must succeed) ---\n71\t\n72\texport class Sequence extends BTNode {\n73\t  private children: BTNode[];\n74\t  private currentIndex = 0;\n75\t\n76\t  constructor(children: BTNode[]) {\n77\t    super();\n78\t    this.children = children;\n79\t  }\n80\t\n81\t  tick(ctx: BehaviorContext): NodeStatus {\n82\t    for (let i = this.currentIndex; i < this.children.length; i++) {\n83\t      const status = this.children[i].tick(ctx);\n84\t      if (status === NodeStatus.RUNNING) {\n85\t        this.currentIndex = i;\n86\t        return NodeStatus.RUNNING;\n87\t      }\n88\t      if (status === NodeStatus.FAILURE) {\n89\t        this.reset();\n90\t        return NodeStatus.FAILURE;\n91\t      }\n92\t    }\n93\t    this.reset();\n94\t    return NodeStatus.SUCCESS;\n95\t  }\n96\t\n97\t  reset(): void {\n98\t    this.currentIndex = 0;\n99\t    for (const child of this.children) child.reset();\n100\t  }\n101\t}\n102\t\n103\t// --- Decorator: Inverter ---\n104\t\n105\texport class Inverter extends BTNode {\n106\t  private child: BTNode;\n107\t  constructor(child: BTNode) { super(); this.child = child; }\n108\t\n109\t  tick(ctx: BehaviorContext): NodeStatus {\n110\t    const status = this.child.tick(ctx);\n111\t    if (status === NodeStatus.RUNNING) return NodeStatus.RUNNING;\n112\t    return status === NodeStatus.SUCCESS ? NodeStatus.FAILURE : NodeStatus.SUCCESS;\n113\t  }\n114\t\n115\t  reset(): void { this.child.reset(); }\n116\t}\n117\t\n118\t// --- Decorator: RepeatUntilFail ---\n119\t\n120\texport class RepeatUntilFail extends BTNode {\n121\t  private child: BTNode;\n122\t  constructor(child: BTNode) { super(); this.child = child; }\n123\t\n124\t  tick(ctx: BehaviorContext): NodeStatus {\n125\t    const status = this.child.tick(ctx);\n126\t    if (status === NodeStatus.FAILURE) return NodeStatus.SUCCESS;\n127\t    return NodeStatus.RUNNING;\n128\t  }\n129\t\n130\t  reset(): void { this.child.reset(); }\n131\t}\n132\t\n133\t// --- Condition Nodes ---\n134\t\n135\texport class ConditionNode extends BTNode {\n136\t  private fn: (ctx: BehaviorContext) => boolean;\n137\t  constructor(fn: (ctx: BehaviorContext) => boolean) { super(); this.fn = fn; }\n138\t\n139\t  tick(ctx: BehaviorContext): NodeStatus {\n140\t    return this.fn(ctx) ? NodeStatus.SUCCESS : NodeStatus.FAILURE;\n141\t  }\n142\t}\n143\t\n144\t// --- Action Nodes ---\n145\t\n146\texport class ActionNode extends BTNode {\n147\t  private fn: (ctx: BehaviorContext) => NodeStatus;\n148\t  constructor(fn: (ctx: BehaviorContext) => NodeStatus) { super(); this.fn = fn; }\n149\t\n150\t  tick(ctx: BehaviorContext): NodeStatus {\n151\t    return this.fn(ctx);\n152\t  }\n153\t}\n154\t\n155\t// --- NPC State ---\n156\t\n157\texport interface NPCState {\n158\t  id: string;\n159\t  type: 'mysterious_customer' | 'landlord' | 'him';\n160\t  x: number;\n161\t  y: number;\n162\t  visible: boolean;\n163\t  phase: string;\n164\t  behaviorLabel: string;\n165\t  active: boolean;\n166\t  speed: number;\n167\t  opacity: number;\n168\t  facing: 'up' | 'down' | 'left' | 'right';\n169\t}\n170\t\n171\t// --- NPC Entity ---\n172\t\n173\texport class HorrorNPC {\n174\t  state: NPCState;\n175\t  private tree: BTNode;\n176\t  private moveTargetX: number;\n177\t  private moveTargetY: number;\n178\t  private timer = 0;\n179\t  private waitDuration = 0;\n180\t\n181\t  constructor(id: string, type: NPCState['type'], startX: number, startY: number, tree: BTNode) {\n182\t    this.state = {\n183\t      id, type, x: startX, y: startY,\n184\t      visible: false, phase: 'idle', behaviorLabel: '',\n185\t      active: false, speed: 30, opacity: 1,\n186\t      facing: 'down',\n187\t    };\n188\t    this.tree = tree;\n189\t    this.moveTargetX = startX;\n190\t    this.moveTargetY = startY;\n191\t  }\n192\t\n193\t  activate(x: number, y: number): void {\n194\t    this.state.x = x;\n195\t    this.state.y = y;\n196\t    this.state.active = true;\n197\t    this.state.visible = true;\n198\t    this.state.phase = 'active';\n199\t  }\n200\t\n201\t  deactivate(): void {\n202\t    this.state.active = false;\n203\t    this.state.visible = false;\n204\t    this.state.phase = 'idle';\n205\t    this.tree.reset();\n206\t  }\n207\t\n208\t  update(dt: number, playerX: number, playerY: number, day: number, timeOfDay: number, sanity: number, fearLevel: number): void {\n209\t    if (!this.state.active) return;\n210\t\n211\t    const ctx: BehaviorContext = {\n212\t      selfX: this.state.x,\n213\t      selfY: this.state.y,\n214\t      playerX, playerY,\n215\t      day, timeOfDay, sanity, fearLevel,\n216\t      canSeePlayer: true,\n217\t      distanceToPlayer: Math.sqrt((this.state.x - playerX) ** 2 + (this.state.y - playerY) ** 2),\n218\t      recentEvents: [],\n219\t      dt, elapsedSec: dt / 1000,\n220\t      storeOpen: true,\n221\t    };\n222\t\n223\t    this.tree.tick(ctx);\n224\t  }\n225\t\n226\t  getSaveData(): Record<string, unknown> {\n227\t    return { ...this.state };\n228\t  }\n229\t}\n230\t\n231\t// --- Factory: Build behavior trees for each NPC type ---\n232\t\n233\texport function createMysteriousCustomerTree(npc: HorrorNPC): BTNode {\n234\t  return new Selector([\n235\t    // Phase 1: Normal shopping if far from player\n236\t    new Sequence([\n237\t      new ConditionNode(ctx => ctx.distanceToPlayer > 200),\n238\t      new ActionNode(ctx => {\n239\t        npc.state.behaviorLabel = 'browsing';\n240\t        npc.state.opacity = 0.8;\n241\t        return NodeStatus.SUCCESS;\n242\t      }),\n243\t    ]),\n244\t    // Phase 2: Anomalous behavior — staring\n245\t    new Sequence([\n246\t      new ConditionNode(ctx => ctx.distanceToPlayer > 80 && ctx.distanceToPlayer <= 200),\n247\t      new ActionNode(ctx => {\n248\t        npc.state.behaviorLabel = 'staring';\n249\t        npc.state.opacity = 0.9;\n250\t        return NodeStatus.SUCCESS;\n251\t      }),\n252\t    ]),\n253\t    // Phase 3: Tracking player closely\n254\t    new Sequence([\n255\t      new ConditionNode(ctx => ctx.distanceToPlayer <= 80),\n256\t      new ActionNode(ctx => {\n257\t        npc.state.behaviorLabel = 'tracking';\n258\t        npc.state.opacity = 1;\n259\t        // Move toward player\n260\t        const dx = ctx.playerX - npc.state.x;\n261\t        const dy = ctx.playerY - npc.state.y;\n262\t        const dist = Math.sqrt(dx * dx + dy * dy);\n263\t        if (dist > 16) {\n264\t          const spd = npc.state.speed * ctx.elapsedSec;\n265\t          npc.state.x += (dx / dist) * spd;\n266\t          npc.state.y += (dy / dist) * spd;\n267\t        }\n268\t        return NodeStatus.SUCCESS;\n269\t      }),\n270\t    ]),\n271\t    // Fallback: idle\n272\t    new ActionNode(() => {\n273\t      npc.state.behaviorLabel = 'idle';\n274\t      return NodeStatus.SUCCESS;\n275\t    }),\n276\t  ]);\n277\t}\n278\t\n279\texport function createLandlordTree(npc: HorrorNPC): BTNode {\n280\t  return new Selector([\n281\t    // Phase 1: Collecting rent — normal behavior\n282\t    new Sequence([\n283\t      new ConditionNode(ctx => ctx.day < 20),\n284\t      new ActionNode(ctx => {\n285\t        npc.state.behaviorLabel = 'collecting_rent';\n286\t        npc.state.opacity = 1;\n287\t        return NodeStatus.SUCCESS;\n288\t      }),\n289\t    ]),\n290\t    // Phase 2: Increasingly nervous dialogue\n291\t    new Sequence([\n292\t      new ConditionNode(ctx => ctx.day >= 20 && ctx.day < 26),\n293\t      new ConditionNode(ctx => ctx.distanceToPlayer < 200),\n294\t      new ActionNode(ctx => {\n295\t        npc.state.behaviorLabel = 'uneasy_talk';\n296\t        npc.state.opacity = 1;\n297\t        return NodeStatus.SUCCESS;\n298\t      }),\n299\t    ]),\n300\t    // Phase 3: Abnormal behavior — appearing in wrong places\n301\t    new Sequence([\n302\t      new ConditionNode(ctx => ctx.day >= 26),\n303\t      new ActionNode(ctx => {\n304\t        npc.state.behaviorLabel = 'anomalous';\n305\t        npc.state.opacity = 0.5 + Math.random() * 0.3;\n306\t        return NodeStatus.SUCCESS;\n307\t      }),\n308\t    ]),\n309\t    new ActionNode(() => {\n310\t      npc.state.behaviorLabel = 'idle';\n311\t      return NodeStatus.SUCCESS;\n312\t    }),\n313\t  ]);\n314\t}\n315\t\n316\texport function createHimTree(npc: HorrorNPC): BTNode {\n317\t  return new Selector([\n318\t    // Far: distant hints\n319\t    new Sequence([\n320\t      new ConditionNode(ctx => ctx.distanceToPlayer > 300),\n321\t      new ActionNode(ctx => {\n322\t        npc.state.behaviorLabel = 'distant_hint';\n323\t        npc.state.opacity = 0.15;\n324\t        return NodeStatus.SUCCESS;\n325\t      }),\n326\t    ]),\n327\t    // Medium: approaching\n328\t    new Sequence([\n329\t      new ConditionNode(ctx => ctx.distanceToPlayer > 100 && ctx.distanceToPlayer <= 300),\n330\t      new ActionNode(ctx => {\n331\t        npc.state.behaviorLabel = 'approaching';\n332\t        npc.state.opacity = 0.4;\n333\t        const dx = ctx.playerX - npc.state.x;\n334\t        const dy = ctx.playerY - npc.state.y;\n335\t        const dist = Math.sqrt(dx * dx + dy * dy);\n336\t        if (dist > 16) {\n337\t          const spd = npc.state.speed * 0.5 * ctx.elapsedSec;\n338\t          npc.state.x += (dx / dist) * spd;\n339\t          npc.state.y += (dy / dist) * spd;\n340\t        }\n341\t        return NodeStatus.SUCCESS;\n342\t      }),\n343\t    ]),\n344\t    // Close: pursuit\n345\t    new Sequence([\n346\t      new ConditionNode(ctx => ctx.distanceToPlayer <= 100),\n347\t      new ActionNode(ctx => {\n348\t        npc.state.behaviorLabel = 'pursuing';\n349\t        npc.state.opacity = 0.8;\n350\t        const dx = ctx.playerX - npc.state.x;\n351\t        const dy = ctx.playerY - npc.state.y;\n352\t        const dist = Math.sqrt(dx * dx + dy * dy);\n353\t        if (dist > 16) {\n354\t          const spd = npc.state.speed * ctx.elapsedSec;\n355\t          npc.state.x += (dx / dist) * spd;\n356\t          npc.state.y += (dy / dist) * spd;\n357\t        }\n358\t        return NodeStatus.SUCCESS;\n359\t      }),\n360\t    ]),\n361\t    new ActionNode(() => {\n362\t      npc.state.behaviorLabel = 'idle';\n363\t      return NodeStatus.SUCCESS;\n364\t    }),\n365\t  ]);\n366\t}\n367\t\n368\t// --- NPC Manager ---\n369\t\n370\texport class NPCManager {\n371\t  private npcs: HorrorNPC[] = [];\n372\t  private activeNPCs: HorrorNPC[] = [];\n373\t  private activationCooldown = 0;\n374\t\n375\t  constructor() {\n376\t    this.initNPCs();\n377\t  }\n378\t\n379\t  private initNPCs(): void {\n380\t    const mysterious = new HorrorNPC('mysterious', 'mysterious_customer', 0, 0, createMysteriousCustomerTree(null!));\n381\t    mysterious.state.speed = 40;\n382\t    mysterious.deactivate();\n383\t\n384\t    const landlord = new HorrorNPC('landlord', 'landlord', 0, 0, createLandlordTree(null!));\n385\t    landlord.state.speed = 30;\n386\t    landlord.deactivate();\n387\t\n388\t    const him = new HorrorNPC('him', 'him', 0, 0, createHimTree(null!));\n389\t    him.state.speed = 20;\n390\t    him.deactivate();\n391\t\n392\t    this.npcs = [mysterious, landlord, him];\n393\t  }\n394\t\n395\t  update(dt: number, day: number, timeOfDay: number, playerX: number, playerY: number, sanity: number, fearLevel: number): void {\n396\t    const dtSec = dt / 1000;\n397\t    this.activationCooldown = Math.max(0, this.activationCooldown - dtSec);\n398\t\n399\t    // Activate NPCs based on day progression\n400\t    if (this.activationCooldown <= 0) {\n401\t      this.tryActivateNPC(day, timeOfDay, sanity, fearLevel, playerX, playerY);\n402\t    }\n403\t\n404\t    // Update active NPCs\n405\t    for (const npc of this.activeNPCs) {\n406\t      npc.update(dt, playerX, playerY, day, timeOfDay, sanity, fearLevel);\n407\t    }\n408\t\n409\t    // Deactivate NPCs that have been active too long\n410\t    this.activeNPCs = this.activeNPCs.filter(npc => npc.state.active);\n411\t  }\n412\t\n413\t  private tryActivateNPC(day: number, timeOfDay: number, sanity: number, fearLevel: number, playerX: number, playerY: number): void {\n414\t    if (this.activeNPCs.length >= 2) return;\n415\t\n416\t    // Spawn positions\n417\t    const spawnPoints = [\n418\t      { x: 14 * 32, y: 1 * 32 },   // front door\n419\t      { x: 9 * 32, y: 24 * 32 },   // back door\n420\t      { x: 3 * 32, y: 14 * 32 },   // warehouse area\n421\t    ];\n422\t\n423\t    const spawn = spawnPoints[Math.floor(Math.random() * spawnPoints.length)];\n424\t\n425\t    // Mysterious customer: appears from Day 10+ at night\n426\t    if (day >= 10 && timeOfDay >= 22 && sanity < 70) {\n427\t      const npc = this.npcs.find(n => n.state.type === 'mysterious_customer' && !n.state.active);\n428\t      if (npc && Math.random() < 0.05) {\n429\t        npc.activate(spawn.x, spawn.y);\n430\t        this.activeNPCs.push(npc);\n431\t        this.activationCooldown = 120;\n432\t      }\n433\t    }\n434\t\n435\t    // Landlord: appears from Day 15+\n436\t    if (day >= 15 && timeOfDay >= 20) {\n437\t      const npc = this.npcs.find(n => n.state.type === 'landlord' && !n.state.active);\n438\t      if (npc && Math.random() < 0.03) {\n439\t        npc.activate(spawn.x, spawn.y);\n440\t        this.activeNPCs.push(npc);\n441\t        this.activationCooldown = 180;\n442\t      }\n443\t    }\n444\t\n445\t    // \"He\": appears from Day 26+ during DANGER phase\n446\t    if (day >= 26 && (timeOfDay >= 23 || timeOfDay < 5) && fearLevel > 0.5) {\n447\t      const npc = this.npcs.find(n => n.state.type === 'him' && !n.state.active);\n448\t      if (npc && Math.random() < 0.04) {\n449\t        npc.activate(spawn.x, spawn.y);\n450\t        npc.state.speed = 15; // Slow, unstoppable approach\n451\t        this.activeNPCs.push(npc);\n452\t        this.activationCooldown = 240;\n453\t      }\n454\t    }\n455\t  }\n456\t\n457\t  getActiveNPCs(): ReadonlyArray<HorrorNPC> {\n458\t    return this.activeNPCs;\n459\t  }\n460\t\n461\t  /** Deactivate all NPCs (e.g. on new day) */\n462\t  resetDaily(): void {\n463\t    for (const npc of this.activeNPCs) {\n464\t      npc.deactivate();\n465\t    }\n466\t    this.activeNPCs = [];\n467\t    this.activationCooldown = 0;\n468\t  }\n469\t\n470\t  getSaveData(): Record<string, unknown> {\n471\t    return {\n472\t      npcs: this.npcs.map(n => n.getSaveData()),\n473\t    };\n474\t  }\n475\t}\n476\t"}]},"parent_tool_use_id":"call_37a82845ea3e4d0c88fbf309","session_id":"561a5118-a4d0-464b-8f32-001690e29cb0","uuid":"6b8d906f-7692-4ff9-9868-012debca0b26","timestamp":"2026-05-23T10:14:02.418Z","subagent_type":"general-purpose","task_description":"Read horror sim source"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_00331d7a5d8b4c1ca9cf67bb","type":"tool_result","content":"1\t// JumpScareManager.ts — Jump scare system with daily limits and consequences (M5)\n2\t\n3\texport enum JumpScareType {\n4\t  MIRROR_FACE = 'mirror_face',           // E-501: 玻璃反光中看到脸\n5\t  SHELF_HAND = 'shelf_hand',             // E-502: 货架缝隙中伸出一只手\n6\t  CCTV_FIGURE = 'cctv_figure',           // E-503: 监控画面闪过人影\n7\t  BEHIND_YOU = 'behind_you',             // E-504: 转身发现身后有人\n8\t  CEILING_DROP = 'ceiling_drop',         // E-505: 天花板突然\"掉\"下什么\n9\t}\n10\t\n11\texport interface JumpScareInstance {\n12\t  type: JumpScareType;\n13\t  startTime: number;\n14\t  duration: number;          // total ms (preview + scare + fade)\n15\t  previewDuration: number;   // 1-3 sec premonition\n16\t  active: boolean;\n17\t  completed: boolean;\n18\t  phase: 'preview' | 'scare' | 'fade';\n19\t  timer: number;\n20\t  consequence: JumpScareConsequence;\n21\t  variation: number;         // random 0-1 for variety\n22\t}\n23\t\n24\texport interface JumpScareConsequence {\n25\t  sanityDrain: number;       // sanity points lost\n26\t  moneyLoss: number;         // % of daily revenue lost\n27\t  description: string;\n28\t}\n29\t\n30\tinterface JumpScareDef {\n31\t  type: JumpScareType;\n32\t  minDay: number;\n33\t  probability: number;       // per eligible check\n34\t  previewDuration: [number, number]; // min-max ms\n35\t  scareDuration: number;     // ms\n36\t  fadeDuration: number;      // ms\n37\t  consequence: JumpScareConsequence;\n38\t  description: string;\n39\t}\n40\t\n41\tconst SCARE_DEFS: JumpScareDef[] = [\n42\t  {\n43\t    type: JumpScareType.MIRROR_FACE,\n44\t    minDay: 16,\n45\t    probability: 0.08,\n46\t    previewDuration: [1500, 2500],\n47\t    scareDuration: 800,\n48\t    fadeDuration: 600,\n49\t    consequence: { sanityDrain: 15, moneyLoss: 0.05, description: '你在玻璃反光中看到了一张不属于你的脸' },\n50\t    description: '玻璃反光中突然出现一张苍白的脸',\n51\t  },\n52\t  {\n53\t    type: JumpScareType.SHELF_HAND,\n54\t    minDay: 18,\n55\t    probability: 0.07,\n56\t    previewDuration: [1000, 2000],\n57\t    scareDuration: 600,\n58\t    fadeDuration: 500,\n59\t    consequence: { sanityDrain: 18, moneyLoss: 0.08, description: '货架缝隙中缓缓伸出一只苍白的手' },\n60\t    description: '货架间伸出一只手',\n61\t  },\n62\t  {\n63\t    type: JumpScareType.CCTV_FIGURE,\n64\t    minDay: 22,\n65\t    probability: 0.06,\n66\t    previewDuration: [2000, 3000],\n67\t    scareDuration: 700,\n68\t    fadeDuration: 800,\n69\t    consequence: { sanityDrain: 20, moneyLoss: 0.03, description: '监控画面中闪过一个人影，但店里没有人' },\n70\t    description: '监控中闪过人影',\n71\t  },\n72\t  {\n73\t    type: JumpScareType.BEHIND_YOU,\n74\t    minDay: 26,\n75\t    probability: 0.05,\n76\t    previewDuration: [1500, 2500],\n77\t    scareDuration: 900,\n78\t    fadeDuration: 700,\n79\t    consequence: { sanityDrain: 25, moneyLoss: 0.1, description: '你感觉背后有人，转身发现一张近在咫尺的脸' },\n80\t    description: '身后突然出现人',\n81\t  },\n82\t  {\n83\t    type: JumpScareType.CEILING_DROP,\n84\t    minDay: 28,\n85\t    probability: 0.04,\n86\t    previewDuration: [2000, 3000],\n87\t    scareDuration: 500,\n88\t    fadeDuration: 1000,\n89\t    consequence: { sanityDrain: 22, moneyLoss: 0.12, description: '天花板上\"掉\"下来什么东西，你来不及看清' },\n90\t    description: '天花板突然掉落',\n91\t  },\n92\t];\n93\t\n94\texport interface JumpScareVisualState {\n95\t  active: boolean;\n96\t  type: JumpScareType | null;\n97\t  phase: 'preview' | 'scare' | 'fade' | null;\n98\t  progress: number;   // 0-1 within current phase\n99\t  variation: number;  // random seed for positioning\n100\t  // Overlay effects\n101\t  overlayOpacity: number;\n102\t  flashIntensity: number;\n103\t  shakeIntensity: number;\n104\t  // Specific visual data\n105\t  faceX: number;\n106\t  faceY: number;\n107\t  handX: number;\n108\t  handY: number;\n109\t  handAngle: number;\n110\t}\n111\t\n112\texport function createDefaultScareVisuals(): JumpScareVisualState {\n113\t  return {\n114\t    active: false, type: null, phase: null,\n115\t    progress: 0, variation: 0,\n116\t    overlayOpacity: 0, flashIntensity: 0, shakeIntensity: 0,\n117\t    faceX: 0, faceY: 0,\n118\t    handX: 0, handY: 0, handAngle: 0,\n119\t  };\n120\t}\n121\t\n122\texport class JumpScareManager {\n123\t  private activeScare: JumpScareInstance | null = null;\n124\t  private visuals: JumpScareVisualState = createDefaultScareVisuals();\n125\t  private dailyCount = 0;\n126\t  private maxDaily = 2;\n127\t  private checkInterval = 15000; // check every 15 sec\n128\t  private checkTimer = 0;\n129\t  private cooldown = 0;\n130\t\n131\t  // Callbacks\n132\t  onScareTrigger?: (scare: JumpScareInstance) => void;\n133\t  onSanityDrain?: (amount: number) => void;\n134\t  onMoneyLoss?: (percent: number) => void;\n135\t  onNotification?: (text: string) => void;\n136\t\n137\t  get visual(): JumpScareVisualState { return this.visuals; }\n138\t  get isScaring(): boolean { return this.activeScare !== null && !this.activeScare.completed; }\n139\t\n140\t  update(dt: number, day: number, phase: string, sanity: number): JumpScareVisualState {\n141\t    const dtSec = dt / 1000;\n142\t    this.cooldown = Math.max(0, this.cooldown - dtSec);\n143\t\n144\t    // Check for new scare\n145\t    if (!this.activeScare && this.dailyCount < this.maxDaily && this.cooldown <= 0) {\n146\t      this.checkTimer += dt;\n147\t      if (this.checkTimer >= this.checkInterval) {\n148\t        this.checkTimer = 0;\n149\t        this.tryTrigger(day, phase, sanity);\n150\t      }\n151\t    }\n152\t\n153\t    // Update active scare\n154\t    if (this.activeScare && !this.activeScare.completed) {\n155\t      this.updateScare(dt);\n156\t    }\n157\t\n158\t    return this.visuals;\n159\t  }\n160\t\n161\t  private tryTrigger(day: number, phase: string, sanity: number): void {\n162\t    // Only trigger at night\n163\t    if (phase !== 'night' && phase !== 'danger') return;\n164\t    // Less likely if sanity is low (player already overwhelmed)\n165\t    const sanityMod = sanity < 30 ? 0.3 : 1;\n166\t\n167\t    for (const def of SCARE_DEFS) {\n168\t      if (day < def.minDay) continue;\n169\t      if (Math.random() < def.probability * sanityMod) {\n170\t        this.triggerScare(def);\n171\t        break;\n172\t      }\n173\t    }\n174\t  }\n175\t\n176\t  private triggerScare(def: JumpScareDef): void {\n177\t    const variation = Math.random();\n178\t    const previewDur = def.previewDuration[0] + Math.random() * (def.previewDuration[1] - def.previewDuration[0]);\n179\t\n180\t    this.activeScare = {\n181\t      type: def.type,\n182\t      startTime: Date.now(),\n183\t      duration: previewDur + def.scareDuration + def.fadeDuration,\n184\t      previewDuration: previewDur,\n185\t      active: true,\n186\t      completed: false,\n187\t      phase: 'preview',\n188\t      timer: 0,\n189\t      consequence: def.consequence,\n190\t      variation,\n191\t    };\n192\t\n193\t    this.dailyCount++;\n194\t    this.cooldown = 300; // 5 min cooldown between scares\n195\t\n196\t    this.visuals.active = true;\n197\t    this.visuals.type = def.type;\n198\t    this.visuals.variation = variation;\n199\t\n200\t    // Randomize position based on variation\n201\t    this.visuals.faceX = 0.2 + variation * 0.6;\n202\t    this.visuals.faceY = 0.2 + (1 - variation) * 0.4;\n203\t    this.visuals.handX = 0.3 + variation * 0.4;\n204\t    this.visuals.handY = 0.4 + variation * 0.3;\n205\t    this.visuals.handAngle = variation * Math.PI * 0.5;\n206\t\n207\t    this.onScareTrigger?.(this.activeScare);\n208\t  }\n209\t\n210\t  private updateScare(dt: number): void {\n211\t    if (!this.activeScare) return;\n212\t    this.activeScare.timer += dt;\n213\t\n214\t    const scare = this.activeScare;\n215\t    const previewEnd = scare.previewDuration;\n216\t    const scareEnd = previewEnd + SCARE_DEFS.find(d => d.type === scare.type)!.scareDuration;\n217\t    const totalEnd = scare.duration;\n218\t\n219\t    if (scare.timer < previewEnd) {\n220\t      // Preview phase: building tension\n221\t      scare.phase = 'preview';\n222\t      const p = scare.timer / previewEnd;\n223\t      this.visuals.phase = 'preview';\n224\t      this.visuals.progress = p;\n225\t      this.visuals.overlayOpacity = p * 0.15;\n226\t      this.visuals.flashIntensity = 0;\n227\t      this.visuals.shakeIntensity = p * 0.1;\n228\t    } else if (scare.timer < scareEnd) {\n229\t      // Active scare phase\n230\t      if (scare.phase === 'preview') {\n231\t        // Just transitioned — apply consequences\n232\t        scare.phase = 'scare';\n233\t        this.applyConsequences(scare);\n234\t      }\n235\t      this.visuals.phase = 'scare';\n236\t      this.visuals.progress = (scare.timer - previewEnd) / (scareEnd - previewEnd);\n237\t      this.visuals.overlayOpacity = 0.8;\n238\t      this.visuals.flashIntensity = 1;\n239\t      this.visuals.shakeIntensity = 1;\n240\t    } else if (scare.timer < totalEnd) {\n241\t      // Fade phase\n242\t      scare.phase = 'fade';\n243\t      const p = (scare.timer - scareEnd) / (totalEnd - scareEnd);\n244\t      this.visuals.phase = 'fade';\n245\t      this.visuals.progress = p;\n246\t      this.visuals.overlayOpacity = 0.8 * (1 - p);\n247\t      this.visuals.flashIntensity = 1 * (1 - p);\n248\t      this.visuals.shakeIntensity = (1 - p);\n249\t    } else {\n250\t      // Complete\n251\t      scare.completed = true;\n252\t      scare.active = false;\n253\t      this.visuals = createDefaultScareVisuals();\n254\t    }\n255\t  }\n256\t\n257\t  private applyConsequences(scare: JumpScareInstance): void {\n258\t    this.onSanityDrain?.(scare.consequence.sanityDrain);\n259\t    this.onMoneyLoss?.(scare.consequence.moneyLoss);\n260\t    this.onNotification?.(`!!! ${scare.consequence.description}`);\n261\t  }\n262\t\n263\t  resetDaily(): void {\n264\t    this.dailyCount = 0;\n265\t    this.checkTimer = 0;\n266\t    this.cooldown = 0;\n267\t    if (this.activeScare) {\n268\t      this.activeScare.completed = true;\n269\t      this.activeScare = null;\n270\t    }\n271\t    this.visuals = createDefaultScareVisuals();\n272\t  }\n273\t\n274\t  getSaveData(): Record<string, unknown> {\n275\t    return { dailyCount: this.dailyCount };\n276\t  }\n277\t\n278\t  loadSaveData(data: Record<string, unknown>): void {\n279\t    this.dailyCount = (data.dailyCount as number) ?? 0;\n280\t  }\n281\t}\n282\t"}]},"parent_tool_use_id":"call_37a82845ea3e4d0c88fbf309","session_id":"561a5118-a4d0-464b-8f32-001690e29cb0","uuid":"62b8c1d1-9d16-42ee-a808-9b8357b0944e","timestamp":"2026-05-23T10:14:02.420Z","subagent_type":"general-purpose","task_description":"Read horror sim source"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_55ac377f5c804fd086ea2ba7","type":"tool_result","content":"1\t// preload.ts — Electron preload script for IPC bridge (v0.5.0)\n2\t\n3\timport { contextBridge, ipcRenderer } from 'electron';\n4\t\n5\tcontextBridge.exposeInMainWorld('electronAPI', {\n6\t  // Settings\n7\t  getSettings: () => ipcRenderer.invoke('settings:get'),\n8\t  setSettings: (settings: any) => ipcRenderer.invoke('settings:set', settings),\n9\t  setFullscreen: (fullscreen: boolean) => ipcRenderer.invoke('window:fullscreen', fullscreen),\n10\t  setResolution: (w: number, h: number) => ipcRenderer.invoke('window:resolution', w, h),\n11\t\n12\t  // Steam\n13\t  isSteamAvailable: () => ipcRenderer.invoke('steam:isAvailable'),\n14\t  unlockAchievement: (id: string) => ipcRenderer.invoke('steam:unlockAchievement', id),\n15\t  cloudSave: (data: string) => ipcRenderer.invoke('steam:cloudSave', data),\n16\t  cloudLoad: () => ipcRenderer.invoke('steam:cloudLoad'),\n17\t\n18\t  // App\n19\t  getAppVersion: () => ipcRenderer.invoke('app:version'),\n20\t  quit: () => ipcRenderer.invoke('app:quit'),\n21\t});\n22\t"}]},"parent_tool_use_id":"call_2ec493ea325448abb2fac585","session_id":"561a5118-a4d0-464b-8f32-001690e29cb0","uuid":"238c9ab6-3267-4837-865a-2084be45fe2e","timestamp":"2026-05-23T10:14:07.059Z","subagent_type":"general-purpose","task_description":"Read cultivation factory source"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_07c2ab0645074126a4db36fd","type":"tool_result","content":"1\t// SteamIntegration.ts — Steam API wrapper with graceful fallback (v0.5.0)\n2\t// Uses steamworks.js for achievement + cloud save integration\n3\t\n4\tlet steamworks: any = null;\n5\tlet initialized = false;\n6\t\n7\texport interface SteamAchievement {\n8\t  id: string;\n9\t  name: string;\n10\t  unlocked: boolean;\n11\t}\n12\t\n13\texport function initSteam(): boolean {\n14\t  if (initialized) return steamworks !== null;\n15\t\n16\t  try {\n17\t    steamworks = require('steamworks.js');\n18\t    const success = steamworks.init();\n19\t    if (success) {\n20\t      initialized = true;\n21\t      console.log('[Steam] Initialized successfully');\n22\t      return true;\n23\t    }\n24\t    console.warn('[Steam] Init returned false, running without Steam');\n25\t    steamworks = null;\n26\t    initialized = true;\n27\t    return false;\n28\t  } catch (err) {\n29\t    console.warn('[Steam] Not available, running without Steam features:', (err as Error).message);\n30\t    steamworks = null;\n31\t    initialized = true;\n32\t    return false;\n33\t  }\n34\t}\n35\t\n36\texport function isSteamRunning(): boolean {\n37\t  return steamworks !== null && initialized;\n38\t}\n39\t\n40\t// Achievement mapping: game achievement ID -> Steam achievement API name\n41\tconst ACHIEVEMENT_MAP: Record<string, string> = {\n42\t  realm_liqi: 'REALM_LIQI',\n43\t  realm_zhuji: 'REALM_ZHUJI',\n44\t  realm_jindan: 'REALM_JINDAN',\n45\t  realm_yuanying: 'REALM_YUANYING',\n46\t  realm_huashen: 'REALM_HUASHEN',\n47\t  ascension: 'ASCENSION',\n48\t\n49\t  prod_stone_1k: 'PROD_STONE_1K',\n50\t  prod_stone_1m: 'PROD_STONE_1M',\n51\t  prod_grass_500: 'PROD_GRASS_500',\n52\t  prod_pill_100: 'PROD_PILL_100',\n53\t  prod_pill_1000: 'PROD_PILL_1000',\n54\t  prod_monster_core_100: 'PROD_MONSTER_CORE_100',\n55\t  prod_liquid_50: 'PROD_LIQUID_50',\n56\t  prod_immortal_20: 'PROD_IMMORTAL_20',\n57\t  prod_merit_100: 'PROD_MERIT_100',\n58\t  prod_jiuzhuan: 'PROD_JIUZHUAN',\n59\t\n60\t  auto_first_conveyor: 'AUTO_FIRST_CONVEYOR',\n61\t  auto_10_conveyors: 'AUTO_10_CONVEYORS',\n62\t  auto_first_puppet: 'AUTO_FIRST_PUPPET',\n63\t  auto_5_puppets: 'AUTO_5_PUPPETS',\n64\t  auto_smart_core: 'AUTO_SMART_CORE',\n65\t  auto_cross_region: 'AUTO_CROSS_REGION',\n66\t  auto_5_cross: 'AUTO_5_CROSS',\n67\t  auto_space_fold: 'AUTO_SPACE_FOLD',\n68\t  auto_50_buildings: 'AUTO_50_BUILDINGS',\n69\t  auto_200_buildings: 'AUTO_200_BUILDINGS',\n70\t\n71\t  collect_all_pills: 'COLLECT_ALL_PILLS',\n72\t  collect_monster_hunter: 'COLLECT_MONSTER_HUNTER',\n73\t  collect_vein_depth: 'COLLECT_VEIN_DEPTH',\n74\t  collect_immortal: 'COLLECT_IMMORTAL',\n75\t  collect_merit: 'COLLECT_MERIT',\n76\t  collect_yuanying_furnace: 'COLLECT_YUANYING_FURNACE',\n77\t  collect_huashen_furnace: 'COLLECT_HUASHEN_FURNACE',\n78\t  collect_jiuzhuan_furnace: 'COLLECT_JIUZHUAN_FURNACE',\n79\t\n80\t  hidden_playtime_10: 'HIDDEN_PLAYTIME_10',\n81\t  hidden_playtime_50: 'HIDDEN_PLAYTIME_50',\n82\t  hidden_all_regions: 'HIDDEN_ALL_REGIONS',\n83\t  hidden_immortal_mine_5: 'HIDDEN_IMMORTAL_MINE_5',\n84\t  hidden_10_cross_links: 'HIDDEN_10_CROSS_LINKS',\n85\t};\n86\t\n87\texport function unlockAchievement(gameAchievementId: string): boolean {\n88\t  if (!steamworks) return false;\n89\t\n90\t  const steamId = ACHIEVEMENT_MAP[gameAchievementId];\n91\t  if (!steamId) {\n92\t    console.warn(`[Steam] No mapping for achievement: ${gameAchievementId}`);\n93\t    return false;\n94\t  }\n95\t\n96\t  try {\n97\t    steamworks.achievement.activate(steamId);\n98\t    console.log(`[Steam] Achievement unlocked: ${steamId}`);\n99\t    return true;\n100\t  } catch (err) {\n101\t    console.warn(`[Steam] Failed to unlock ${steamId}:`, (err as Error).message);\n102\t    return false;\n103\t  }\n104\t}\n105\t\n106\texport function getAchievement(steamId: string): boolean {\n107\t  if (!steamworks) return false;\n108\t  try {\n109\t    return steamworks.achievement.isActivated(steamId);\n110\t  } catch {\n111\t    return false;\n112\t  }\n113\t}\n114\t\n115\texport function getAllAchievements(): SteamAchievement[] {\n116\t  if (!steamworks) return [];\n117\t  const results: SteamAchievement[] = [];\n118\t  for (const [gameId, steamId] of Object.entries(ACHIEVEMENT_MAP)) {\n119\t    results.push({\n120\t      id: gameId,\n121\t      name: steamId,\n122\t      unlocked: getAchievement(steamId),\n123\t    });\n124\t  }\n125\t  return results;\n126\t}\n127\t\n128\t// Cloud save integration\n129\tconst CLOUD_SAVE_KEY = 'cultivation_factory_save';\n130\t\n131\texport function saveToCloud(data: string): boolean {\n132\t  if (!steamworks) return false;\n133\t  try {\n134\t    steamworks.cloud.saveToFile(CLOUD_SAVE_KEY, data);\n135\t    console.log('[Steam] Cloud save successful');\n136\t    return true;\n137\t  } catch (err) {\n138\t    console.warn('[Steam] Cloud save failed:', (err as Error).message);\n139\t    return false;\n140\t  }\n141\t}\n142\t\n143\texport function loadFromCloud(): string | null {\n144\t  if (!steamworks) return null;\n145\t  try {\n146\t    const exists = steamworks.cloud.isFileExists(CLOUD_SAVE_KEY);\n147\t    if (!exists) return null;\n148\t    const data = steamworks.cloud.readFile(CLOUD_SAVE_KEY);\n149\t    console.log('[Steam] Cloud load successful');\n150\t    return data;\n151\t  } catch (err) {\n152\t    console.warn('[Steam] Cloud load failed:', (err as Error).message);\n153\t    return null;\n154\t  }\n155\t}\n156\t\n157\texport function shutdownSteam(): void {\n158\t  if (steamworks) {\n159\t    try {\n160\t      steamworks.shutdown();\n161\t      console.log('[Steam] Shutdown complete');\n162\t    } catch {\n163\t      // Ignore shutdown errors\n164\t    }\n165\t    steamworks = null;\n166\t  }\n167\t}\n168\t"}]},"parent_tool_use_id":"call_2ec493ea325448abb2fac585","session_id":"561a5118-a4d0-464b-8f32-001690e29cb0","uuid":"3c45233b-db01-47be-aad3-a3a91632a299","timestamp":"2026-05-23T10:14:07.060Z","subagent_type":"general-purpose","task_description":"Read cultivation factory source"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_de5549a322c54b51ad87b2a6","type":"tool_result","content":"1\t// math.ts — Utility math functions\n2\t\n3\texport function clamp(value: number, min: number, max: number): number {\n4\t  return Math.max(min, Math.min(max, value));\n5\t}\n6\t\n7\texport function lerp(a: number, b: number, t: number): number {\n8\t  return a + (b - a) * clamp(t, 0, 1);\n9\t}\n10\t\n11\texport function formatNumber(n: number): string {\n12\t  if (n >= 1_000_000_000) return (n / 1_000_000_000).toFixed(1) + 'B';\n13\t  if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';\n14\t  if (n >= 10_000) return (n / 1_000).toFixed(1) + 'K';\n15\t  if (n >= 1_000) return (n / 1_000).toFixed(1) + 'K';\n16\t  return Math.floor(n).toString();\n17\t}\n18\t\n19\texport function randomInt(min: number, max: number): number {\n20\t  return Math.floor(Math.random() * (max - min + 1)) + min;\n21\t}\n22\t\n23\texport function distance(x1: number, y1: number, x2: number, y2: number): number {\n24\t  const dx = x2 - x1;\n25\t  const dy = y2 - y1;\n26\t  return Math.sqrt(dx * dx + dy * dy);\n27\t}\n28\t"}]},"parent_tool_use_id":"call_2ec493ea325448abb2fac585","session_id":"561a5118-a4d0-464b-8f32-001690e29cb0","uuid":"72057595-7f18-4652-bfad-84f27251884d","timestamp":"2026-05-23T10:14:07.448Z","subagent_type":"general-purpose","task_description":"Read cultivation factory source"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_c9f7ed12feee45348d5ed690","type":"tool_result","content":"1\t// Electron main process entry point (v0.5.0 — M5: Steam + UI polish + packaging)\n2\t\n3\timport { app, BrowserWindow, ipcMain, screen } from 'electron';\n4\timport * as path from 'path';\n5\timport * as fs from 'fs';\n6\timport { initSteam, isSteamRunning, unlockAchievement, saveToCloud, loadFromCloud, shutdownSteam } from './SteamIntegration';\n7\t\n8\tlet mainWindow: BrowserWindow | null = null;\n9\t\n10\tconst SETTINGS_PATH = path.join(app.getPath('userData'), 'settings.json');\n11\t\n12\tinterface AppSettings {\n13\t  masterVolume: number;\n14\t  sfxVolume: number;\n15\t  musicVolume: number;\n16\t  resolution: { width: number; height: number };\n17\t  fullscreen: boolean;\n18\t  language: string;\n19\t  autoSaveInterval: number;\n20\t  showFPS: boolean;\n21\t  particleQuality: string;\n22\t}\n23\t\n24\tfunction loadAppSettings(): AppSettings {\n25\t  try {\n26\t    if (fs.existsSync(SETTINGS_PATH)) {\n27\t      return JSON.parse(fs.readFileSync(SETTINGS_PATH, 'utf-8'));\n28\t    }\n29\t  } catch { /* use defaults */ }\n30\t  return {\n31\t    masterVolume: 80, sfxVolume: 100, musicVolume: 70,\n32\t    resolution: { width: 1280, height: 800 },\n33\t    fullscreen: false, language: 'zh-CN',\n34\t    autoSaveInterval: 60, showFPS: true, particleQuality: 'high',\n35\t  };\n36\t}\n37\t\n38\tfunction saveAppSettings(settings: AppSettings): void {\n39\t  try {\n40\t    fs.writeFileSync(SETTINGS_PATH, JSON.stringify(settings, null, 2));\n41\t  } catch { /* ignore */ }\n42\t}\n43\t\n44\tfunction createWindow(): void {\n45\t  const settings = loadAppSettings();\n46\t  const { width, height } = settings.resolution;\n47\t\n48\t  mainWindow = new BrowserWindow({\n49\t    width,\n50\t    height,\n51\t    minWidth: 960,\n52\t    minHeight: 600,\n53\t    title: '修仙自动化工厂 — Cultivation Factory',\n54\t    backgroundColor: '#1a1a2e',\n55\t    fullscreen: settings.fullscreen,\n56\t    show: false,\n57\t    icon: path.join(__dirname, '../../assets/icons/icon.ico'),\n58\t    webPreferences: {\n59\t      nodeIntegration: false,\n60\t      contextIsolation: true,\n61\t      preload: path.join(__dirname, 'preload.js'),\n62\t    },\n63\t  });\n64\t\n65\t  // Show window when ready (avoids white flash)\n66\t  mainWindow.once('ready-to-show', () => {\n67\t    mainWindow?.show();\n68\t  });\n69\t\n70\t  // In development, load from Vite dev server\n71\t  const isDev = process.env.NODE_ENV === 'development';\n72\t  if (isDev) {\n73\t    mainWindow.loadURL('http://localhost:5173');\n74\t    mainWindow.webContents.openDevTools();\n75\t  } else {\n76\t    mainWindow.loadFile(path.join(__dirname, '../renderer/index.html'));\n77\t  }\n78\t\n79\t  mainWindow.on('closed', () => {\n80\t    mainWindow = null;\n81\t  });\n82\t}\n83\t\n84\t// === IPC Handlers ===\n85\t\n86\tfunction setupIPC(): void {\n87\t  ipcMain.handle('settings:get', () => {\n88\t    return loadAppSettings();\n89\t  });\n90\t\n91\t  ipcMain.handle('settings:set', (_event, settings: AppSettings) => {\n92\t    saveAppSettings(settings);\n93\t    return true;\n94\t  });\n95\t\n96\t  ipcMain.handle('window:fullscreen', (_event, fullscreen: boolean) => {\n97\t    if (mainWindow) {\n98\t      mainWindow.setFullScreen(fullscreen);\n99\t      const settings = loadAppSettings();\n100\t      settings.fullscreen = fullscreen;\n101\t      saveAppSettings(settings);\n102\t    }\n103\t    return true;\n104\t  });\n105\t\n106\t  ipcMain.handle('window:resolution', (_event, w: number, h: number) => {\n107\t    if (mainWindow) {\n108\t      mainWindow.setSize(w, h);\n109\t      mainWindow.center();\n110\t      const settings = loadAppSettings();\n111\t      settings.resolution = { width: w, height: h };\n112\t      saveAppSettings(settings);\n113\t    }\n114\t    return true;\n115\t  });\n116\t\n117\t  ipcMain.handle('steam:isAvailable', () => {\n118\t    return isSteamRunning();\n119\t  });\n120\t\n121\t  ipcMain.handle('steam:unlockAchievement', (_event, id: string) => {\n122\t    return unlockAchievement(id);\n123\t  });\n124\t\n125\t  ipcMain.handle('steam:cloudSave', (_event, data: string) => {\n126\t    return saveToCloud(data);\n127\t  });\n128\t\n129\t  ipcMain.handle('steam:cloudLoad', () => {\n130\t    return loadFromCloud();\n131\t  });\n132\t\n133\t  ipcMain.handle('app:version', () => {\n134\t    return app.getVersion();\n135\t  });\n136\t\n137\t  ipcMain.handle('app:quit', () => {\n138\t    app.quit();\n139\t  });\n140\t}\n141\t\n142\t// === App Lifecycle ===\n143\t\n144\tapp.whenReady().then(() => {\n145\t  // Initialize Steam\n146\t  initSteam();\n147\t\n148\t  // Setup IPC\n149\t  setupIPC();\n150\t\n151\t  // Create window\n152\t  createWindow();\n153\t\n154\t  app.on('activate', () => {\n155\t    if (mainWindow === null) {\n156\t      createWindow();\n157\t    }\n158\t  });\n159\t});\n160\t\n161\tapp.on('window-all-closed', () => {\n162\t  shutdownSteam();\n163\t  if (process.platform !== 'darwin') {\n164\t    app.quit();\n165\t  }\n166\t});\n167\t\n168\tapp.on('before-quit', () => {\n169\t  shutdownSteam();\n170\t});\n171\t"}]},"parent_tool_use_id":"call_2ec493ea325448abb2fac585","session_id":"561a5118-a4d0-464b-8f32-001690e29cb0","uuid":"098b2eb7-96bf-4336-a888-0300e7d9b435","timestamp":"2026-05-23T10:14:07.449Z","subagent_type":"general-purpose","task_description":"Read cultivation factory source"}
