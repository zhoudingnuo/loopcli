{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6080ae567fa34a7aab1f53b9","type":"tool_result","content":"1\t// gameState.test.ts — Tests for GameState.ts\n2\t\n3\timport { describe, it, expect, beforeEach, vi } from 'vitest';\n4\timport {\n5\t  GamePhase,\n6\t  UIPanel,\n7\t  createInitialState,\n8\t  cloneState,\n9\t  saveGame,\n10\t  loadGame,\n11\t  clearSave,\n12\t  getTimeString,\n13\t  getPhaseFromTime,\n14\t  isNightTime,\n15\t  CURRENT_VERSION,\n16\t} from '../src/game/GameState';\n17\t\n18\t// Mock localStorage\n19\tconst localStorageMock = (() => {\n20\t  let store: Record<string, string> = {};\n21\t  return {\n22\t    getItem: vi.fn((key: string) => store[key] ?? null),\n23\t    setItem: vi.fn((key: string, value: string) => { store[key] = value; }),\n24\t    removeItem: vi.fn((key: string) => { delete store[key]; }),\n25\t    clear: vi.fn(() => { store = {}; }),\n26\t    get length() { return Object.keys(store).length; },\n27\t    key: vi.fn((index: number) => Object.keys(store)[index] ?? null),\n28\t  };\n29\t})();\n30\t\n31\tObject.defineProperty(globalThis, 'localStorage', { value: localStorageMock });\n32\t\n33\t// Mock window.setInterval / clearInterval\n34\tObject.defineProperty(globalThis, 'window', {\n35\t  value: {\n36\t    setInterval: vi.fn(() => 12345),\n37\t    clearInterval: vi.fn(),\n38\t  },\n39\t  writable: true,\n40\t});\n41\t\n42\tdescribe('createInitialState', () => {\n43\t  it('returns a valid GameState with all required fields', () => {\n44\t    const state = createInitialState();\n45\t\n46\t    expect(state.phase).toBe(GamePhase.DAYTIME);\n47\t    expect(state.activePanel).toBe(UIPanel.NONE);\n48\t    expect(state.version).toBe(CURRENT_VERSION);\n49\t    expect(state.day).toBe(1);\n50\t    expect(state.timeOfDay).toBe(6);\n51\t    expect(state.timeSpeed).toBe(1);\n52\t    expect(state.totalPlaytime).toBe(0);\n53\t    expect(state.notifications).toEqual([]);\n54\t    expect(state.daySummaries).toEqual([]);\n55\t  });\n56\t\n57\t  it('initializes player state with correct defaults', () => {\n58\t    const state = createInitialState();\n59\t\n60\t    expect(state.player.x).toBe(15 * 32);\n61\t    expect(state.player.y).toBe(5 * 32);\n62\t    expect(state.player.speed).toBe(150);\n63\t    expect(state.player.direction).toBe('down');\n64\t    expect(state.player.health).toBe(100);\n65\t    expect(state.player.sanity).toBe(100);\n66\t  });\n67\t\n68\t  it('initializes economy fields', () => {\n69\t    const state = createInitialState();\n70\t\n71\t    expect(state.money).toBe(500);\n72\t    expect(state.debt).toBe(300000);\n73\t    expect(state.dailyRevenue).toBe(0);\n74\t    expect(state.dailyExpenses).toBe(0);\n75\t  });\n76\t\n77\t  it('initializes horror and narrative fields', () => {\n78\t    const state = createInitialState();\n79\t\n80\t    expect(state.horrorEventsTriggered).toBe(0);\n81\t    expect(state.lastHorrorEventDay).toBe(0);\n82\t    expect(state.fearLevel).toBe(0);\n83\t    expect(state.storyLayer).toBe('surface');\n84\t    expect(state.cluesFound).toBe(0);\n85\t    expect(state.totalClues).toBe(75);\n86\t    expect(state.choicesMade).toBe(0);\n87\t  });\n88\t});\n89\t\n90\tdescribe('getPhaseFromTime', () => {\n91\t  it('returns DAYTIME for morning hours (6-21)', () => {\n92\t    expect(getPhaseFromTime(6)).toBe(GamePhase.DAYTIME);\n93\t    expect(getPhaseFromTime(12)).toBe(GamePhase.DAYTIME);\n94\t    expect(getPhaseFromTime(21.9)).toBe(GamePhase.DAYTIME);\n95\t  });\n96\t\n97\t  it('returns NIGHT_TRANSITION for 22-23', () => {\n98\t    expect(getPhaseFromTime(22)).toBe(GamePhase.NIGHT_TRANSITION);\n99\t    expect(getPhaseFromTime(22.5)).toBe(GamePhase.NIGHT_TRANSITION);\n100\t    expect(getPhaseFromTime(22.99)).toBe(GamePhase.NIGHT_TRANSITION);\n101\t  });\n102\t\n103\t  it('returns NIGHT for 23-2 (wraps around midnight)', () => {\n104\t    expect(getPhaseFromTime(23)).toBe(GamePhase.NIGHT);\n105\t    expect(getPhaseFromTime(0)).toBe(GamePhase.NIGHT);\n106\t    expect(getPhaseFromTime(1)).toBe(GamePhase.NIGHT);\n107\t    expect(getPhaseFromTime(1.99)).toBe(GamePhase.NIGHT);\n108\t  });\n109\t\n110\t  it('returns DANGER for 2-5', () => {\n111\t    expect(getPhaseFromTime(2)).toBe(GamePhase.DANGER);\n112\t    expect(getPhaseFromTime(3)).toBe(GamePhase.DANGER);\n113\t    expect(getPhaseFromTime(4.99)).toBe(GamePhase.DANGER);\n114\t  });\n115\t\n116\t  it('returns DAWN for 5-6', () => {\n117\t    expect(getPhaseFromTime(5)).toBe(GamePhase.DAWN);\n118\t    expect(getPhaseFromTime(5.5)).toBe(GamePhase.DAWN);\n119\t    expect(getPhaseFromTime(5.99)).toBe(GamePhase.DAWN);\n120\t  });\n121\t});\n122\t\n123\tdescribe('isNightTime', () => {\n124\t  it('returns true for NIGHT_TRANSITION', () => {\n125\t    expect(isNightTime(GamePhase.NIGHT_TRANSITION)).toBe(true);\n126\t  });\n127\t\n128\t  it('returns true for NIGHT', () => {\n129\t    expect(isNightTime(GamePhase.NIGHT)).toBe(true);\n130\t  });\n131\t\n132\t  it('returns true for DANGER', () => {\n133\t    expect(isNightTime(GamePhase.DANGER)).toBe(true);\n134\t  });\n135\t\n136\t  it('returns false for DAYTIME', () => {\n137\t    expect(isNightTime(GamePhase.DAYTIME)).toBe(false);\n138\t  });\n139\t\n140\t  it('returns false for DAWN', () => {\n141\t    expect(isNightTime(GamePhase.DAWN)).toBe(false);\n142\t  });\n143\t\n144\t  it('returns false for MENU and PAUSED', () => {\n145\t    expect(isNightTime(GamePhase.MENU)).toBe(false);\n146\t    expect(isNightTime(GamePhase.PAUSED)).toBe(false);\n147\t  });\n148\t});\n149\t\n150\tdescribe('getTimeString', () => {\n151\t  it('formats whole hours correctly', () => {\n152\t    expect(getTimeString(6)).toBe('06:00');\n153\t    expect(getTimeString(14)).toBe('14:00');\n154\t    expect(getTimeString(23)).toBe('23:00');\n155\t  });\n156\t\n157\t  it('formats hours with minutes correctly', () => {\n158\t    expect(getTimeString(6.5)).toBe('06:30');\n159\t    expect(getTimeString(14.25)).toBe('14:15');\n160\t    expect(getTimeString(2