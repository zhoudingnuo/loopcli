n  GamePhase,\n  UIPanel,\n  createInitialState,\n  cloneState,\n  getTimeString,\n  getPhaseFromTime,\n  isNightTime,\n  CURRENT_VERSION,\n} from '../src/game/GameState';\n\n// Mock localStorage\nconst localStorageMock = (() => {\n  let store: Record<string, string> = {};\n  return {\n    getItem: vi.fn((key: string) => store[key] ?? null),\n    setItem: vi.fn((key: string, value: string) => { store[key] = value; }),\n    removeItem: vi.fn((key: string) => { delete store[key]; }),\n    clear: vi.fn(() => { store = {}; }),\n    get length() { return Object.keys(store).length; },\n    key: vi.fn((index: number) => Object.keys(store)[index] ?? null),\n  };\n})();\n\nObject.defineProperty(globalThis, 'localStorage', { value: localStorageMock });\n\n// Mock window.setInterval / clearInterval\nObject.defineProperty(globalThis, 'window', {\n  value: {\n    setInterval: vi.fn(() => 12345),\n    clearInterval: vi.fn(),\n  },\n  writable: true,\n});\n\ndescribe('createInitialState', () => {\n  it('returns a valid GameState with all required fields', () => {\n    const state = createInitialState();\n\n    expect(state.phase).toBe(GamePhase.DAYTIME);\n    expect(state.activePanel).toBe(UIPanel.NONE);\n    expect(state.version).toBe(CURRENT_VERSION);\n    expect(state.day).toBe(1);\n    expect(state.timeOfDay).toBe(6);\n    expect(state.timeSpeed).toBe(1);\n    expect(state.totalPlaytime).toBe(0);\n    expect(state.notifications).toEqual([]);\n    expect(state.daySummaries).toEqual([]);\n  });\n\n  it('initializes player state with correct defaults', () => {\n    const state = createInitialState();\n\n    expect(state.player.x).toBe(15 * 32);\n    expect(state.player.y).toBe(5 * 32);\n    expect(state.player.speed).toBe(150);\n    expect(state.player.direction).toBe('down');\n    expect(state.player.health).toBe(100);\n    expect(state.player.sanity).toBe(100);\n  });\n\n  it('initializes economy fields', () => {\n    const state = createInitialState();\n\n    expect(state.money).toBe(500);\n    expect(state.debt).toBe(300000);\n    expect(state.dailyRevenue).toBe(0);\n    expect(state.dailyExpenses).toBe(0);\n  });\n\n  it('initializes horror and narrative fields', () => {\n    const state = createInitialState();\n\n    expect(state.horrorEventsTriggered).toBe(0);\n    expect(state.lastHorrorEventDay).toBe(0);\n    expect(state.fearLevel).toBe(0);\n    expect(state.storyLayer).toBe('surface');\n    expect(state.cluesFound).toBe(0);\n    expect(state.totalClues).toBe(75);\n    expect(state.choicesMade).toBe(0);\n  });\n});\n\ndescribe('getPhaseFromTime', () => {\n  it('returns DAYTIME for morning hours (6-21)', () => {\n    expect(getPhaseFromTime(6)).toBe(GamePhase.DAYTIME);\n    expect(getPhaseFromTime(12)).toBe(GamePhase.DAYTIME);\n    expect(getPhaseFromTime(21.9)).toBe(GamePhase.DAYTIME);\n  });\n\n  it('returns NIGHT_TRANSITION for 22-23', () => {\n    expect(getPhaseFromTime(22)).toBe(GamePhase.NIGHT_TRANSITION);\n    expect(getPhaseFromTime(22.5)).toBe(GamePhase.NIGHT_TRANSITION);\n    expect(getPhaseFromTime(22.99)).toBe(GamePhase.NIGHT_TRANSITION);\n  });\n\n  it('returns NIGHT for 23-2 (wraps around midnight)', () => {\n    expect(getPhaseFromTime(23)).toBe(GamePhase.NIGHT);\n    expect(getPhaseFromTime(0)).toBe(GamePhase.NIGHT);\n    expect(getPhaseFromTime(1)).toBe(GamePhase.NIGHT);\n    expect(getPhaseFromTime(1.99)).toBe(GamePhase.NIGHT);\n  });\n\n  it('returns DANGER for 2-5', () => {\n    expect(getPhaseFromTime(2)).toBe(GamePhase.DANGER);\n    expect(getPhaseFromTime(3)).toBe(GamePhase.DANGER);\n    expect(getPhaseFromTime(4.99)).toBe(GamePhase.DANGER);\n  });\n\n  it('returns DAWN for 5-6', () => {\n    expect(getPhaseFromTime(5)).toBe(GamePhase.DAWN);\n    expect(getPhaseFromTime(5.5)).toBe(GamePhase.DAWN);\n    expect(getPhaseFromTime(5.99)).toBe(GamePhase.DAWN);\n  });\n});\n\ndescribe('isNightTime', () => {\n  it('returns true for NIGHT_TRANSITION', () => {\n    expect(isNightTime(GamePhase.NIGHT_TRANSITION)).toBe(true);\n  });\n\n  it('returns true for NIGHT', () => {\n    expect(isNightTime(GamePhase.NIGHT)).toBe(true);\n  });\n\n  it('returns true for DANGER', () => {\n    expect(isNightTime(GamePhase.DANGER)).toBe(true);\n  });\n\n  it('returns false for DAYTIME', () => {\n    expect(isNightTime(GamePhase.DAYTIME)).toBe(false);\n  });\n\n  it('returns false for DAWN', () => {\n    expect(isNightTime(GamePhase.DAWN)).toBe(false);\n  });\n\n  it('returns false for MENU and PAUSED', () => {\n    expect(isNightTime(GamePhase.MENU)).toBe(false);\n    expect(isNightTime(GamePhase.PAUSED)).toBe(false);\n  });\n});\n\ndescribe('getTimeString', () => {\n  it('formats whole hours correctly', () => {\n    expect(getTimeString(6)).toBe('06:00');\n    expect(getTimeString(14)).toBe('14:00');\n    expect(getTimeString(23)).toBe('23:00');\n  });\n\n  it('formats hours with minutes correctly', () => {\n    expect(getTimeString(6.5)).toBe('06:30');\n    expect(getTimeString(14.25)).toBe('14:15');\n    expect(getTimeString(22.75)).toBe('22:45');\n  });\n\n  it('wraps hours past 24', () => {\n    expect(getTimeString(25)).toBe('01:00');\n    expect(getTimeString(26.5)).toBe('02:30');\n  });\n\n  it('handles edge cases', () => {\n    expect(getTimeString(0)).toBe('00:00');\n    expect(getTimeString(23.99)).toBe('23:59');\n  });\n});\n\ndescribe('cloneState', () => {\n  it('creates a deep copy of the state', () => {\n    const state = createInitialState();\n    const cloned = cloneState(state);\n\n    expect(cloned).toEqual(state);\n    expect(cloned).not.toBe(state);\n  });\n\n  it('modifying the clone does not affect original', () => {\n    const state = createInitialState();\n    const cloned = cloneState(state);\n\n    cloned.money = 999;\n    cloned.player.health = 50;\n    cloned.notifications.push('test');\n\n    expect(state.money).toBe(500);\n    expect(state.player.health).toBe(100);\n    expect(state.notifications).toEqual([]);\n  });\n});\n\ndescribe('saveGame / loadGame', () => {\n  beforeEach(() => {\n    localStorageMock.clear();\n    vi.clearAllMocks();\n  });\n\n  it('saves and loads game state roundtrip', () => {\n    const state = createInitialState();\n    state.money = 1000;\n    state.day = 5;\n\n    saveGame(state);\n    const loaded = loadGame();\n\n    expect(loaded).not.toBeNull();\n    expect(loaded!.gameState.money).toBe(1000);\n    expect(loaded!.gameState.day).toBe(5);\n    expect(loaded!.version).toBe(CURRENT_VERSION);\n  });\n\n  it('returns null when no save exists', () => {\n    expect(loadGame()).toBeNull();\n  });\n\n  it('clears save data', () => {\n    const state = createInitialState();\n    saveGame(state);\n    expect(loadGame()).not.toBeNull();\n\n    clearSave();\n    expect(loadGame()).toBeNull();\n  });\n\n  it('saves extra system data', () => {\n    const state = createInitialState();\n    const pm = { shelves: 5 };\n    const eco = { revenue: 200 };\n    const prc = { markup: 1.2 };\n    const cust = { served: 10 };\n    const regs = [{ id: 'r1', total: 50 }];\n\n    saveGame(state, pm, eco, prc, cust, regs);\n    const loaded = loadGame();\n\n    expect(loaded!.productManager).toEqual(pm);\n    expect(loaded!.economy).toEqual(eco);\n    expect(loaded!.pricing).toEqual(prc);\n    expect(loaded!.customerStats).toEqual(cust);\n    expect(loaded!.registers).toEqual(regs);\n  });\n});\n","structuredPatch":[{"oldStart":25,"oldLines":17,"newStart":25,"newLines":6,"lines":["   };"," })();"," ","-Object.defineProperty(globalThis, 'localStorage', { value: localStorageMock });","-","-// Mock window.setInterval / clearInterval","-Object.defineProperty(globalThis, 'window', {","-  value: {","-    setInterval: vi.fn(() => 12345),","-    clearInterval: vi.fn(),","-  },","-  writable: true,","-});","-"," describe('createInitialState', () => {","   it('returns a valid GameState with all required fields', () => {","     const state = createInitialState();"]}],"userModified":false,"replaceAll":false}}
