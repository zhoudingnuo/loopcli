{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_9a744971db684e358ca2a64f","type":"tool_result","content":"The file D:\\game-projects\\steam-horror-sim\\tests\\saveManager.test.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"561a5118-a4d0-464b-8f32-001690e29cb0","uuid":"0ae366aa-ecb6-407e-8bcb-73c94897a67f","timestamp":"2026-05-23T10:31:37.911Z","tool_use_result":{"filePath":"D:\\game-projects\\steam-horror-sim\\tests\\saveManager.test.ts","oldString":"    const regData = [{ id: 'r1', total: 100 }];\n\n    const pm = createMockSystem(pmData);\n    const eco = createMockSystem(ecoData);\n    const prc = createMockSystem(prcData);\n    const cust = createMockSystem(custData);\n    const reg = createMockSystem(regData as unknown as Record<string, unknown>);","newString":"    const regData = [{ id: 'r1', total: 100 }];\n\n    const pm = createMockSystem(pmData);\n    const eco = createMockSystem(ecoData);\n    const prc = createMockSystem(prcData);\n    const cust = createMockSystem(custData);\n    const reg = createMockSystem({ items: regData });","originalFile":"// saveManager.test.ts — Tests for SaveManager.ts\n\nimport { describe, it, expect, beforeEach, vi } from 'vitest';\nimport { SaveManager, type SaveableSystem } from '../src/game/SaveManager';\nimport { createInitialState, type GameState } from '../src/game/GameState';\n\n// Mock localStorage\nconst localStorageMock = (() => {\n  let store: Record<string, string> = {};\n  return {\n    getItem: vi.fn((key: string) => store[key] ?? null),\n    setItem: vi.fn((key: string, value: string) => { store[key] = value; }),\n    removeItem: vi.fn((key: string) => { delete store[key]; }),\n    clear: vi.fn(() => { store = {}; }),\n    get length() { return Object.keys(store).length; },\n    key: vi.fn((index: number) => Object.keys(store)[index] ?? null),\n  };\n})();\n\nObject.defineProperty(globalThis, 'localStorage', { value: localStorageMock });\n\n// Mock window.setInterval\nObject.defineProperty(globalThis, 'window', {\n  value: {\n    setInterval: vi.fn(() => 12345),\n    clearInterval: vi.fn(),\n  },\n  writable: true,\n});\n\nfunction createMockSystem(data: Record<string, unknown>): SaveableSystem {\n  return {\n    getSaveData: vi.fn(() => data),\n    loadSaveData: vi.fn(),\n  };\n}\n\ndescribe('SaveManager system registration', () => {\n  it('registers systems by name', () => {\n    const sm = new SaveManager();\n    const system = createMockSystem({ count: 5 });\n    sm.register('testSystem', system);\n\n    // Verify registration by saving\n    const state = createInitialState();\n    const result = sm.save(state);\n    expect(result).toBe(true);\n  });\n\n  it('can register multiple systems', () => {\n    const sm = new SaveManager();\n    sm.register('productManager', createMockSystem({ shelves: 10 }));\n    sm.register('economy', createMockSystem({ money: 500 }));\n    sm.register('pricing', createMockSystem({ markup: 1.2 }));\n\n    const state = createInitialState();\n    const result = sm.save(state);\n    expect(result).toBe(true);\n  });\n});\n\ndescribe('Save/restore roundtrip', () => {\n  beforeEach(() => {\n    localStorageMock.clear();\n    vi.clearAllMocks();\n  });\n\n  it('saves and restores all registered systems', () => {\n    const sm = new SaveManager();\n    const pmData = { shelves: 10, products: ['a', 'b'] };\n    const ecoData = { money: 500, debt: 1000 };\n    const prcData = { markup: 1.2 };\n    const custData = { served: 15 };\n    const regData = [{ id: 'r1', total: 100 }];\n\n    const pm = createMockSystem(pmData);\n    const eco = createMockSystem(ecoData);\n    const prc = createMockSystem(prcData);\n    const cust = createMockSystem(custData);\n    const reg = createMockSystem(regData as unknown as Record<string, unknown>);\n\n    sm.register('productManager', pm);\n    sm.register('economy', eco);\n    sm.register('pricing', prc);\n    sm.register('customerManager', cust);\n    sm.register('registers', reg);\n\n    // Save\n    const state = createInitialState();\n    state.money = 999;\n    state.day = 7;\n    sm.save(state);\n\n    // Load\n    const loaded = sm.load();\n    expect(loaded).not.toBeNull();\n    expect(loaded!.gameState.money).toBe(999);\n    expect(loaded!.gameState.day).toBe(7);\n    expect(loaded!.productManager).toEqual(pmData);\n    expect(loaded!.economy).toEqual(ecoData);\n    expect(loaded!.pricing).toEqual(prcData);\n    expect(loaded!.customerStats).toEqual(custData);\n    expect(loaded!.registers).toEqual(regData);\n  });\n\n  it('restore calls loadSaveData on each registered system', () => {\n    const sm = new SaveManager();\n    const pm = createMockSystem({ shelves: 5 });\n    const eco = createMockSystem({ money: 200 });\n\n    sm.register('productManager', pm);\n    sm.register('economy', eco);\n\n    const state = createInitialState();\n    sm.save(state);\n\n    const loaded = sm.load()!;\n    const newState = createInitialState();\n\n    sm.restore(loaded, newState);\n\n    expect(pm.loadSaveData).toHaveBeenCalled();\n    expect(eco.loadSaveData).toHaveBeenCalled();\n  });\n\n  it('restore applies gameState to provided state object', () => {\n    const sm = new SaveManager();\n    const state = createInitialState();\n    state.money = 777;\n    state.day = 12;\n    sm.save(state);\n\n    const loaded = sm.load()!;\n    const restoredState = createInitialState();\n    sm.restore(loaded, restoredState);\n\n    expect(restoredState.money).toBe(777);\n    expect(restoredState.day).toBe(12);\n  });\n});\n\ndescribe('hasSave', () => {\n  beforeEach(() => {\n    localStorageMock.clear();\n  });\n\n  it('returns false when no save exists', () => {\n    const sm = new SaveManager();\n    expect(sm.hasSave()).toBe(false);\n  });\n\n  it('returns true after saving', () => {\n    const sm = new SaveManager();\n    sm.save(createInitialState());\n    expect(sm.hasSave()).toBe(true);\n  });\n});\n\ndescribe('clearSave', () => {\n  it('removes saved data', () => {\n    const sm = new SaveManager();\n    sm.save(createInitialState());\n    expect(sm.hasSave()).toBe(true);\n\n    sm.clearSave();\n    expect(sm.hasSave()).toBe(false);\n    expect(sm.load()).toBeNull();\n  });\n});\n\ndescribe('M4-M6 systems are saved', () => {\n  it('saves horror-related data when registered', () => {\n    const sm = new SaveManager();\n    const horrorSystem = createMockSystem({\n      eventCounter: 10,\n      dayAccumulatedSanityCost: 25,\n    });\n    sm.register('horror', horrorSystem);\n\n    const state = createInitialState();\n    state.fearLevel = 0.7;\n    state.horrorEventsTriggered = 5;\n    sm.save(state);\n\n    const loaded = sm.load();\n    expect(loaded).not.toBeNull();\n    expect(loaded!.gameState.fearLevel).toBe(0.7);\n    expect(loaded!.gameState.horrorEventsTriggered).toBe(5);\n  });\n\n  it('saves narrative-related data in gameState', () => {\n    const sm = new SaveManager();\n    const state = createInitialState();\n    state.storyLayer = 'third';\n    state.cluesFound = 30;\n    state.choicesMade = 5;\n    sm.save(state);\n\n    const loaded = sm.load();\n    expect(loaded!.gameState.storyLayer).toBe('third');\n    expect(loaded!.gameState.cluesFound).toBe(30);\n    expect(loaded!.gameState.choicesMade).toBe(5);\n  });\n});\n\ndescribe('auto-save', () => {\n  it('sets up interval for auto-save', () => {\n    const sm = new SaveManager();\n    const state = createInitialState();\n\n    sm.startAutoSave(() => state);\n\n    expect(window.setInterval).toHaveBeenCalled();\n  });\n\n  it('uses the provided getState callback', () => {\n    const sm = new SaveManager();\n    let callCount = 0;\n\n    sm.startAutoSave(() => {\n      callCount++;\n      return createInitialState();\n    });\n\n    // The interval was set up\n    expect(window.setInterval).toHaveBeenCalled();\n  });\n});\n\ndescribe('load returns null for corrupt data', () => {\n  beforeEach(() => {\n    localStorageMock.clear();\n  });\n\n  it('returns null for invalid JSON', () => {\n    localStorageMock.setItem('midnight_store_save_v3', 'not-json{{{');\n    const sm = new SaveManager();\n    expect(sm.load()).toBeNull();\n  });\n\n  it('returns null when nothing saved', () => {\n    const sm = new SaveManager();\n    expect(sm.load()).toBeNull();\n  });\n});\n","structuredPatch":[{"oldStart":77,"oldLines":7,"newStart":77,"newLines":7,"lines":["     const eco = createMockSystem(ecoData);","     const prc = createMockSystem(prcData);","     const cust = createMockSystem(custData);","-    const reg = createMockSystem(regData as unknown as Record<string, unknown>);","+    const reg = createMockSystem({ items: regData });"," ","     sm.register('productManager', pm);","     sm.register('economy', eco);"]}],"userModified":false,"replaceAll":false}}
