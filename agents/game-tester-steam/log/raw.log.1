xpect(serialized.y).toBe(200);\n    expect(serialized.speed).toBe(180);\n    expect(serialized.direction).toBe('left');\n  });\n\n  it('returns default economy fields in serialized state', () => {\n    const player = new Player(makePlayerState());\n    const serialized = player.toState();\n\n    expect(serialized.money).toBe(0);\n    expect(serialized.debt).toBe(0);\n    expect(serialized.day).toBe(1);\n    expect(serialized.health).toBe(100);\n    expect(serialized.sanity).toBe(100);\n  });\n});\n\ndescribe('consumeInteract', () => {\n  it('returns false when interact has not been pressed', () => {\n    const player = new Player(makePlayerState());\n    expect(player.consumeInteract()).toBe(false);\n  });\n});\n","structuredPatch":[{"oldStart":99,"oldLines":11,"newStart":99,"newLines":10,"lines":["     }));"," ","     const { gx, gy } = player.getFacingTile();","-    // Player center: (10*32 + 16, 5*32 + 16) = (336, 176)","-    // Facing down: targetY = 176 + 32 = 208 => gy = 6","-    expect(gx).toBe(10 + 1); // (10*32 + 16) / 32 = 10.5 -> floor -> 10... wait","-    // Actually: cx = 10*32 + 16 = 336, cy = 5*32 + 16 = 176","-    // targetY = 176 + 32 = 208, gy = 208/32 = 6.5 -> floor = 6","+    // cx = 10*32 + 16 = 336, cy = 5*32 + 16 = 176","+    // Facing down: targetX = 336, targetY = 208","+    // gx = floor(336/32) = 10, gy = floor(208/32) = 6","+    expect(gx).toBe(10);","     expect(gy).toBe(6);","   });"," "]}],"userModified":false,"replaceAll":false}}
