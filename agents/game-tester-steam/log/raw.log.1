{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_c1a2aa629d9d4725b28ae668","type":"tool_result","content":"The file D:\\game-projects\\steam-cultivation-factory\\src\\renderer\\App.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"561a5118-a4d0-464b-8f32-001690e29cb0","uuid":"faf99ec8-0f06-457b-947c-f89354886687","timestamp":"2026-05-23T10:22:17.095Z","tool_use_result":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\renderer\\App.ts","oldString":"    this.state.resources = result.resources as Resources;\n    this.state.alchemySession = null;\n\n    if (result.success) {\n      this.state.cultivation = addCultivationExp(this.state.cultivation, result.expReward);\n\n      // Track pill crafting for achievements\n      const recipe = this.state.alchemySession?.recipeId ?? 'unknown';\n      this.pillsCrafted[recipe] = (this.pillsCrafted[recipe] ?? 0) + result.amount;\n      this.totalPillsCrafted += result.amount;","newString":"    const recipeId = this.state.alchemySession?.recipeId ?? 'unknown';\n    this.state.resources = result.resources as Resources;\n    this.state.alchemySession = null;\n\n    if (result.success) {\n      this.state.cultivation = addCultivationExp(this.state.cultivation, result.expReward);\n\n      this.pillsCrafted[recipeId] = (this.pillsCrafted[recipeId] ?? 0) + result.amount;\n      this.totalPillsCrafted += result.amount;","originalFile":"// App.ts — Game main loop (v0.4.0 — M4: 元婴+化神, 跨区域传送, 高级丹方, 终局内容)\n\nimport { Renderer } from './Renderer';\nimport { GameMap } from '../game/Map';\nimport {\n  type GameState,\n  type BuildingInstance,\n  type AlchemySessionData,\n  type GameMap as GameMapData,\n  type CrossRegionLink,\n  createInitialState,\n  cloneState,\n  setMap,\n  placeBuilding,\n  loadGame,\n  saveGame,\n  startAutoSave,\n  stopAutoSave,\n  addAchievement,\n  addCrossRegionLink,\n} from '../game/GameState';\nimport {\n  type BuildingDef,\n  loadBuildingDefs,\n  createBuildingInstance,\n  canPlace,\n} from '../game/Building';\nimport {\n  collectFromBuilding,\n  plantField,\n  tickAutoProduction,\n  tickManualProduction,\n  canAfford,\n  deductCost,\n} from '../game/Resources';\nimport {\n  type CultivationState,\n  type BreakthroughResult,\n  addCultivationExp,\n  canBreakthrough,\n  attemptBreakthrough,\n  getBreakthroughRequirements,\n  getFullRealmName,\n  isRealmUnlocked as cultivationIsRealmUnlocked,\n  tickAutoCultivation,\n} from '../game/Cultivation';\nimport {\n  type AlchemyRecipe,\n  getAvailableRecipes,\n  canCraft,\n  startCrafting,\n  tickAlchemy,\n  collectAlchemy,\n  getRemainingTime,\n} from '../game/Alchemy';\nimport {\n  usePill,\n  useMultiplePills,\n  getAllPillDefs,\n  type PillDef,\n} from '../game/Inventory';\nimport { audioManager } from '../game/AudioManager';\nimport { getAllAchievements, checkAchievement, type AchievementContext } from '../game/Achievement';\nimport { getAscensionChallenge, checkAscensionRequirements, attemptAscension } from '../game/Ascension';\nimport { tickCrossRegionLinks, createCrossRegionLink, renderCrossRegionPortal } from '../game/CrossRegionTeleport';\nimport { processTalismans, renderTalisman, type TalismanInstance } from '../game/Talisman';\nimport type { Resources } from '../game/GameState';\nimport buildingData from '../data/buildings.json';\nimport regionData from '../data/regions.json';\nimport {\n  type ConveyorSegment,\n  type ConveyorItem,\n  createSegment,\n  buildSegmentMap,\n  autoConnect,\n  tickConveyorItems,\n  renderConveyorSegment,\n  renderConveyorItems,\n} from '../game/ConveyorBelt';\nimport {\n  type PuppetInstance,\n  createPuppet,\n  tickPuppet,\n  renderPuppet,\n} from '../game/Puppet';\n\nexport type PlacementMode = BuildingDef | null;\n\nexport interface GameNotification {\n  id: number;\n  text: string;\n  type: 'info' | 'success' | 'warning' | 'error';\n  time: number;\n}\n\ninterface RegionDef {\n  id: string;\n  name: string;\n  nameEn: string;\n  width: number;\n  height: number;\n  unlockRealm: string;\n  maxBuildings: number;\n  specialResources: string[];\n  terrainBase: string;\n  color: { bg: string; grid: string };\n}\n\nlet notifIdCounter = 0;\n\nexport class App {\n  canvas: HTMLCanvasElement;\n  renderer: Renderer;\n  state: GameState;\n  buildingDefs: Map<string, BuildingDef>;\n  regionDefs: RegionDef[];\n  map: GameMap;\n  currentRegionIndex = 0;\n\n  conveyorSegments: ConveyorSegment[] = [];\n  conveyorItems: ConveyorItem[] = [];\n  puppets: PuppetInstance[] = [];\n  talismans: TalismanInstance[] = [];\n\n  private running = false;\n  private lastFrameTime = 0;\n  private animFrameId = 0;\n  private lastTickTime = 0;\n  private tickInterval = 200;\n\n  pillsCrafted: Record<string, number> = {};\n  totalPillsCrafted = 0;\n  ascensionMultiplier = 1.0;\n\n  private hoveredCell: { gx: number; gy: number } | null = null;\n  private clickStartTime = 0;\n  private clickStartPos = { x: 0, y: 0 };\n  placementMode: PlacementMode = null;\n  private placementValid = false;\n  private placementPos = { gx: 0, gy: 0 };\n\n  breakthroughAnim: { active: boolean; result: BreakthroughResult | null; startTime: number; duration: number } = {\n    active: false,\n    result: null,\n    startTime: 0,\n    duration: 3000,\n  };\n\n  notifications: GameNotification[] = [];\n\n  // M4: Ascension animation\n  ascensionAnim: { active: boolean; startTime: number; duration: number } = {\n    active: false,\n    startTime: 0,\n    duration: 5000,\n  };\n\n  onStateChange?: (state: GameState) => void;\n  onBuildingSelect?: (building: BuildingInstance | null) => void;\n  onNotification?: (notif: GameNotification) => void;\n  onBreakthroughAnim?: (active: boolean, result: BreakthroughResult | null) => void;\n  onAlchemyUpdate?: (session: AlchemySessionData | null) => void;\n  onRegionChange?: (regionIndex: number, region: RegionDef) => void;\n  onAchievementUnlocked?: (achievementId: string) => void;\n\n  constructor(canvas: HTMLCanvasElement) {\n    this.canvas = canvas;\n    this.renderer = new Renderer(canvas);\n\n    const saved = loadGame();\n    this.state = saved ? saved : createInitialState();\n\n    this.buildingDefs = loadBuildingDefs(buildingData as unknown as { buildings: BuildingDef[] });\n    this.regionDefs = (regionData as { regions: RegionDef[] }).regions;\n\n    this.map = new GameMap(20, 15, '#2a3a1a', '#3a4a2a');\n    this.map.generateStartingArea();\n\n    if (this.state.maps.length === 0) {\n      this.state = setMap(this.state, 0, {\n        regionId: 'liqi_flat',\n        width: 20,\n        height: 15,\n        terrain: this.map.terrain,\n        buildings: [],\n      });\n    } else {\n      const mapData = this.state.maps[this.state.currentRegionIndex];\n      if (mapData) {\n        this.currentRegionIndex = this.state.currentRegionIndex;\n        this.loadRegionMap(this.currentRegionIndex);\n      }\n    }\n\n    this.setupInput(canvas);\n\n    window.addEventListener('resize', () => {\n      this.renderer.resize();\n    });\n  }\n\n  private loadRegionMap(index: number): void {\n    const mapData = this.state.maps[index];\n    if (!mapData) return;\n\n    const regionDef = this.regionDefs.find(r => r.id === mapData.regionId);\n    const bg = regionDef?.color.bg ?? '#2a3a1a';\n    const grid = regionDef?.color.grid ?? '#3a4a2a';\n\n    this.map = new GameMap(mapData.width, mapData.height, bg, grid);\n    this.map.terrain = mapData.terrain;\n    this.currentRegionIndex = index;\n  }\n\n  initRegion(regionDef: RegionDef): number {\n    const existing = this.state.maps.findIndex(m => m.regionId === regionDef.id);\n    if (existing >= 0) return existing;\n\n    const newMap = new GameMap(regionDef.width, regionDef.height, regionDef.color.bg, regionDef.color.grid);\n    newMap.generateRegionTerrain(regionDef.id);\n\n    const index = this.state.maps.length;\n    this.state = setMap(this.state, index, {\n      regionId: regionDef.id,\n      width: regionDef.width,\n      height: regionDef.height,\n      terrain: newMap.terrain,\n      buildings: [],\n    });\n\n    return index;\n  }\n\n  switchRegion(index: number): boolean {\n    if (index < 0 || index >= this.state.maps.length) return false;\n    if (index === this.currentRegionIndex) return false;\n\n    this.currentRegionIndex = index;\n    this.state.currentRegionIndex = index;\n    this.loadRegionMap(index);\n\n    const regionDef = this.regionDefs.find(r => r.id === this.state.maps[index]?.regionId);\n    if (regionDef) {\n      this.onRegionChange?.(index, regionDef);\n    }\n\n    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  getUnlockedRegions(): Array<RegionDef & { index: number }> {\n    return this.regionDefs\n      .map((r) => {\n        if (cultivationIsRealmUnlocked(r.unlockRealm, this.state.cultivation)) {\n          const mapIndex = this.state.maps.findIndex(m => m.regionId === r.id);\n          if (mapIndex < 0) {\n            this.initRegion(r);\n          }\n          const actualIndex = Math.max(0, this.state.maps.findIndex(m => m.regionId === r.id));\n          return { ...r, index: actualIndex };\n        }\n        return null;\n      })\n      .filter((r): r is RegionDef & { index: number } => r !== null);\n  }\n\n  start(): void {\n    if (this.running) return;\n    this.running = true;\n    this.lastFrameTime = performance.now();\n    this.lastTickTime = this.lastFrameTime;\n\n    // Restore persisted conveyors/puppets/talismans\n    if (this.state.savedConveyors?.length) {\n      this.conveyorSegments = this.state.savedConveyors;\n    }\n    if (this.state.savedPuppets?.length) {\n      this.puppets = this.state.savedPuppets;\n    }\n    if (this.state.savedTalismans?.length) {\n      this.talismans = this.state.savedTalismans;\n    }\n\n    this.loop(this.lastFrameTime);\n\n    startAutoSave(() => this.getSaveableState());\n  }\n\n  private getSaveableState(): GameState {\n    const state = cloneState(this.state);\n    state.savedConveyors = this.conveyorSegments;\n    state.savedPuppets = this.puppets;\n    state.savedTalismans = this.talismans;\n    return state;\n  }\n\n  stop(): void {\n    this.running = false;\n    if (this.animFrameId) {\n      cancelAnimationFrame(this.animFrameId);\n    }\n    stopAutoSave();\n    saveGame(this.getSaveableState());\n  }\n\n  private loop = (now: number): void => {\n    if (!this.running) return;\n\n    const dt = now - this.lastFrameTime;\n    this.lastFrameTime = now;\n\n    this.state.totalPlaytime += dt / 1000;\n\n    if (now - this.lastTickTime >= this.tickInterval) {\n      this.tickProduction(now);\n      this.lastTickTime = now;\n    }\n\n    this.render(now);\n\n    this.animFrameId = requestAnimationFrame(this.loop);\n  };\n\n  private tickProduction(now: number): void {\n    const resourcesBefore = { ...this.state.resources };\n    this.state = tickAutoProduction(this.state, this.currentRegionIndex, now, this.buildingDefs);\n\n    // Apply ascension multiplier to auto-production gains\n    if (this.ascensionMultiplier !== 1.0) {\n      for (const key of Object.keys(this.state.resources) as (keyof Resources)[]) {\n        const gained = this.state.resources[key] - (resourcesBefore[key] ?? 0);\n        if (gained > 0) {\n          this.state.resources = { ...this.state.resources, [key]: (resourcesBefore[key] ?? 0) + Math.floor(gained * this.ascensionMultiplier) };\n        }\n      }\n    }\n    this.state = tickManualProduction(this.state, this.currentRegionIndex, now, this.buildingDefs);\n\n    this.state.cultivation = tickAutoCultivation(this.state.cultivation, this.tickInterval);\n\n    if (this.state.alchemySession) {\n      this.state.alchemySession = tickAlchemy(this.state.alchemySession, now);\n      this.onAlchemyUpdate?.(this.state.alchemySession);\n    }\n\n    // M3: Conveyor items tick\n    if (this.conveyorSegments.length > 0) {\n      const segMap = buildSegmentMap(this.conveyorSegments);\n      const result = tickConveyorItems(this.conveyorItems, segMap, this.tickInterval);\n      this.conveyorItems = result.items;\n\n      for (const d of result.delivered) {\n        const delta: Partial<Resources> = {};\n        (delta as Record<string, number>)[d.resource] = d.amount;\n        this.state = { ...this.state, resources: { ...this.state.resources, [d.resource]: (this.state.resources[d.resource] ?? 0) + d.amount } };\n      }\n    }\n\n    // M3: Puppet tick\n    for (let i = 0; i < this.puppets.length; i++) {\n      const result = tickPuppet(this.puppets[i], this.tickInterval);\n      this.puppets[i] = result.puppet;\n    }\n\n    // M4: Cross-region teleport tick\n    if (this.state.crossRegionLinks.length > 0) {\n      const crResult = tickCrossRegionLinks(this.state.crossRegionLinks, this.state.resources, now);\n      this.state.crossRegionLinks = crResult.links;\n\n      for (const t of crResult.transferred) {\n        // Deduct from source first, then add to destination (simulates transfer)\n        const current = this.state.resources[t.resource] ?? 0;\n        const afterDeduct = Math.max(0, current - t.amount);\n        this.state = { ...this.state, resources: { ...this.state.resources, [t.resource]: afterDeduct + t.amount } };\n      }\n    }\n\n    // M4: Achievement check (every 5 seconds)\n    if (Math.floor(now / 5000) !== Math.floor((now - this.tickInterval) / 5000)) {\n      this.checkAchievements();\n    }\n\n    // Talisman processing\n    if (this.talismans.length > 0) {\n      const buildingCounts: Record<string, number> = {};\n      for (const map of this.state.maps) {\n        for (const b of map.buildings) {\n          buildingCounts[b.buildingId] = (buildingCounts[b.buildingId] ?? 0) + 1;\n        }\n      }\n      const talResult = processTalismans(\n        this.talismans,\n        this.state.resources,\n        buildingCounts,\n        this.state.realm.level,\n        now,\n      );\n      this.talismans = talResult.talismans;\n      for (const action of talResult.actions) {\n        if (action.type === 'notify') {\n          this.addNotification(action.message, 'info');\n        } else if (action.type === 'stop_building') {\n          const bld = this.state.maps[this.currentRegionIndex]?.buildings.find(b => b.uid === action.buildingUid);\n          if (bld) bld.isProducing = false;\n        } else if (action.type === 'start_building') {\n          const bld = this.state.maps[this.currentRegionIndex]?.buildings.find(b => b.uid === action.buildingUid);\n          if (bld) bld.isProducing = true;\n        }\n      }\n    }\n\n    this.onStateChange?.(this.state);\n  }\n\n  // M4: Achievement checking\n  private checkAchievements(): void {\n    const buildingCounts: Record<string, number> = {};\n    let totalBuildingCount = 0;\n    for (const map of this.state.maps) {\n      for (const b of map.buildings) {\n        buildingCounts[b.buildingId] = (buildingCounts[b.buildingId] ?? 0) + 1;\n        totalBuildingCount++;\n      }\n    }\n\n    const unlockedRegions = this.regionDefs\n      .filter(r => cultivationIsRealmUnlocked(r.unlockRealm, this.state.cultivation))\n      .map(r => r.id);\n\n    const context: AchievementContext = {\n      currentRealmId: this.state.cultivation.realmId,\n      realmOrder: ['fanren', 'liqi', 'zhuji', 'jindan', 'yuanying', 'huashen'],\n      totalResourcesCollected: this.state.totalCollected as Record<string, number>,\n      buildingCounts,\n      totalBuildingCount,\n      pillsCrafted: this.pillsCrafted,\n      totalPillsCrafted: this.totalPillsCrafted,\n      allPillTypesCrafted: false,\n      unlockedRegions,\n      ascensionCompleted: this.state.ascensionCompleted,\n      playtimeHours: this.state.totalPlaytime / 3600,\n      crossRegionLinkCount: this.state.crossRegionLinks.length,\n    };\n\n    for (const ach of getAllAchievements()) {\n      if (this.state.achievements.includes(ach.id)) continue;\n      if (checkAchievement(ach, context)) {\n        this.state = addAchievement(this.state, ach.id);\n        this.addNotification(`🏆 成就解锁: ${ach.name}`, 'success');\n        this.onAchievementUnlocked?.(ach.id);\n      }\n    }\n  }\n\n  private render(now: number): void {\n    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n    const preview = this.placementMode\n      ? { def: this.placementMode, gx: this.placementPos.gx, gy: this.placementPos.gy, valid: this.placementValid }\n      : null;\n\n    this.renderer.render(\n      this.map,\n      buildings,\n      this.buildingDefs,\n      this.state.resources,\n      this.state.realm,\n      this.state.cultivation,\n      this.hoveredCell,\n      preview,\n      now,\n    );\n\n    const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n    const segMap = buildSegmentMap(this.conveyorSegments);\n    for (const seg of this.conveyorSegments) {\n      renderConveyorSegment(this.renderer.ctx, seg, offsetX, offsetY, scale, this.map.cellSize, now);\n    }\n    renderConveyorItems(this.renderer.ctx, this.conveyorItems, segMap, offsetX, offsetY, scale, this.map.cellSize);\n\n    for (const puppet of this.puppets) {\n      renderPuppet(this.renderer.ctx, puppet, offsetX, offsetY, scale, this.map.cellSize, now);\n    }\n\n    for (const talisman of this.talismans) {\n      renderTalisman(this.renderer.ctx, talisman, offsetX, offsetY, scale, this.map.cellSize, now);\n    }\n\n    // M4: Render cross-region portals in current map\n    for (const link of this.state.crossRegionLinks) {\n      if (link.fromRegionIndex === this.currentRegionIndex) {\n        renderCrossRegionPortal(this.renderer.ctx, link.fromX, link.fromY, offsetX, offsetY, scale, this.map.cellSize, now);\n      }\n    }\n\n    if (this.breakthroughAnim.active) {\n      this.renderBreakthroughOverlay(now);\n    }\n\n    if (this.ascensionAnim.active) {\n      this.renderAscensionOverlay(now);\n    }\n  }\n\n  private renderBreakthroughOverlay(now: number): void {\n    const ctx = this.renderer.ctx;\n    const w = this.canvas.getBoundingClientRect().width;\n    const h = this.canvas.getBoundingClientRect().height;\n\n    const elapsed = now - this.breakthroughAnim.startTime;\n    const progress = Math.min(1, elapsed / this.breakthroughAnim.duration);\n\n    let alpha = 0;\n    if (progress < 0.2) alpha = progress / 0.2;\n    else if (progress > 0.8) alpha = (1 - progress) / 0.2;\n    else alpha = 1;\n\n    const result = this.breakthroughAnim.result;\n\n    if (result?.success) {\n      ctx.fillStyle = `rgba(255, 215, 0, ${alpha * 0.15})`;\n      ctx.fillRect(0, 0, w, h);\n\n      ctx.fillStyle = `rgba(255, 215, 0, ${alpha})`;\n      ctx.font = `bold ${24 + Math.sin(progress * Math.PI * 4) * 4}px serif`;\n      ctx.textAlign = 'center';\n      ctx.textBaseline = 'middle';\n      ctx.fillText('⚡ 境界突破成功 ⚡', w / 2, h / 2 - 20);\n\n      ctx.font = '16px serif';\n      ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;\n      const realmName = getFullRealmName(this.state.cultivation);\n      ctx.fillText(`进入 ${realmName}`, w / 2, h / 2 + 20);\n    } else if (result) {\n      ctx.fillStyle = `rgba(200, 50, 50, ${alpha * 0.15})`;\n      ctx.fillRect(0, 0, w, h);\n\n      ctx.fillStyle = `rgba(255, 100, 100, ${alpha})`;\n      ctx.font = 'bold 24px serif';\n      ctx.textAlign = 'center';\n      ctx.textBaseline = 'middle';\n      ctx.fillText('突破失败...', w / 2, h / 2 - 20);\n\n      ctx.font = '14px serif';\n      ctx.fillStyle = `rgba(255, 200, 200, ${alpha})`;\n      ctx.fillText(`修为损失 ${Math.floor(result.penalty * 100)}%`, w / 2, h / 2 + 20);\n    }\n\n    if (progress >= 1) {\n      this.breakthroughAnim.active = false;\n      this.breakthroughAnim.result = null;\n      this.onBreakthroughAnim?.(false, null);\n    }\n  }\n\n  // M4: Ascension animation overlay\n  private renderAscensionOverlay(now: number): void {\n    const ctx = this.renderer.ctx;\n    const w = this.canvas.getBoundingClientRect().width;\n    const h = this.canvas.getBoundingClientRect().height;\n\n    const elapsed = now - this.ascensionAnim.startTime;\n    const progress = Math.min(1, elapsed / this.ascensionAnim.duration);\n\n    // Golden-white gradient overlay\n    let alpha = 0;\n    if (progress < 0.15) alpha = progress / 0.15;\n    else if (progress > 0.85) alpha = (1 - progress) / 0.15;\n    else alpha = 1;\n\n    ctx.fillStyle = `rgba(255, 255, 200, ${alpha * 0.2})`;\n    ctx.fillRect(0, 0, w, h);\n\n    // Radiating lines\n    const centerX = w / 2;\n    const centerY = h / 2;\n    const lineCount = 12;\n    for (let i = 0; i < lineCount; i++) {\n      const angle = (i / lineCount) * Math.PI * 2 + progress * Math.PI;\n      const len = 200 + Math.sin(progress * Math.PI * 6 + i) * 100;\n      ctx.strokeStyle = `rgba(255, 215, 0, ${alpha * 0.3})`;\n      ctx.lineWidth = 2;\n      ctx.beginPath();\n      ctx.moveTo(centerX, centerY);\n      ctx.lineTo(centerX + Math.cos(angle) * len, centerY + Math.sin(angle) * len);\n      ctx.stroke();\n    }\n\n    ctx.fillStyle = `rgba(255, 215, 0, ${alpha})`;\n    ctx.font = `bold ${28 + Math.sin(progress * Math.PI * 3) * 6}px serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText('🌟 飞升成功 🌟', w / 2, h / 2 - 30);\n\n    ctx.font = '18px serif';\n    ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;\n    ctx.fillText('飞升仙尊 — 全局效率×10', w / 2, h / 2 + 15);\n\n    ctx.font = '14px serif';\n    ctx.fillStyle = `rgba(200, 200, 255, ${alpha})`;\n    ctx.fillText('恭喜完成飞升挑战！', w / 2, h / 2 + 50);\n\n    if (progress >= 1) {\n      this.ascensionAnim.active = false;\n    }\n  }\n\n  placeCurrentBuilding(): boolean {\n    if (!this.placementMode) return false;\n\n    const def = this.placementMode;\n    const { gx, gy } = this.placementPos;\n\n    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n    if (!canPlace(this.map, def, gx, gy, buildings)) return false;\n    if (!canAfford(this.state.resources, def.cost)) return false;\n\n    this.state = deductCost(this.state, def.cost);\n\n    // Handle conveyor/puppet placement\n    if (def.category === 'transport' && (def.id === 'conveyor_lv1' || def.id === 'conveyor_lv2')) {\n      const seg = createSegment(\n        `seg_${Date.now()}_${Math.random().toString(36).slice(2)}`,\n        gx, gy,\n        def.id === 'conveyor_lv1' ? 1 : 2,\n        'right',\n      );\n      const segMap = buildSegmentMap(this.conveyorSegments);\n      this.conveyorSegments.push(autoConnect(seg, segMap));\n      audioManager.playBuild();\n      this.addNotification(`放置了 ${def.name}`, 'success');\n      this.onStateChange?.(this.state);\n      return true;\n    }\n\n    if (def.category === 'automation' && def.id === 'puppet_sorter') {\n      const puppet = createPuppet(\n        `pup_${Date.now()}_${Math.random().toString(36).slice(2)}`,\n        gx, gy, 1,\n      );\n      this.puppets.push(puppet);\n      audioManager.playBuild();\n      this.addNotification(`放置了 ${def.name}`, 'success');\n      this.onStateChange?.(this.state);\n      return true;\n    }\n\n    const instance = createBuildingInstance(def.id, gx, gy);\n    this.state = placeBuilding(this.state, this.currentRegionIndex, instance);\n\n    audioManager.playBuild();\n    this.addNotification(`建造了 ${def.name}`, 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  private handleBuildingClick(building: BuildingInstance): void {\n    const def = this.buildingDefs.get(building.buildingId);\n    if (!def) return;\n\n    if (def.production.mode === 'manual') {\n      if (def.category === 'farming') {\n        if (!building.isProducing && building.progress < 1) {\n          this.state = plantField(this.state, building, this.currentRegionIndex);\n          audioManager.playCollect();\n        } else if (building.progress >= 1) {\n          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n          audioManager.playHarvest();\n          this.addNotification(`收获 ${def.production.amount} ${this.getResourceName(def.production.resource)}`, 'success');\n        }\n      } else if (def.category === 'mining') {\n        this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n        audioManager.playCollect();\n      } else if (def.category === 'alchemy') {\n        if (building.progress >= 1) {\n          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n          audioManager.playAlchemyComplete();\n          this.addNotification(`获得 ${def.production.amount} ${this.getResourceName(def.production.resource)}`, 'success');\n        } else if (!building.isProducing) {\n          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n          audioManager.playAlchemyStart();\n        }\n      } else if (def.category === 'cultivation') {\n        if (!building.isProducing) {\n          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n        }\n      }\n      this.onStateChange?.(this.state);\n    }\n\n    this.onBuildingSelect?.(building);\n  }\n\n  usePillAction(pillId: string): boolean {\n    const result = usePill(pillId, this.state.resources);\n    if (!result) return false;\n\n    this.state.resources = result.resources as Resources;\n    this.state.cultivation = addCultivationExp(this.state.cultivation, result.cultivation);\n    this.state = this.addCultivationToRealm(result.cultivation);\n\n    audioManager.playUsePill();\n    const pillName = this.getResourceName(pillId);\n    this.addNotification(`服用 ${pillName}，修为+${result.cultivation}`, 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  useAllPills(pillId: string): boolean {\n    const count = this.state.resources[pillId as keyof typeof this.state.resources] ?? 0;\n    if (count <= 0) return false;\n\n    const result = useMultiplePills(pillId, count, this.state.resources);\n    if (!result) return false;\n\n    this.state.resources = result.resources as Resources;\n    this.state.cultivation = addCultivationExp(this.state.cultivation, result.cultivation);\n    this.state = this.addCultivationToRealm(result.cultivation);\n\n    audioManager.playUsePill();\n    this.addNotification(`服用 ${result.used} ${this.getResourceName(pillId)}，修为+${result.cultivation}`, 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  private addCultivationToRealm(amount: number): GameState {\n    const next = cloneState(this.state);\n    next.realm.exp += amount;\n    next.cultivation = { ...next.cultivation };\n    next.cultivation.exp += amount;\n    next.cultivation.totalCultivation += amount;\n    while (next.realm.exp >= next.realm.expToNext) {\n      next.realm.exp -= next.realm.expToNext;\n      next.realm.level += 1;\n      next.realm.expToNext = Math.floor(next.realm.expToNext * 1.8);\n    }\n    return next;\n  }\n\n  attemptBreakthroughAction(): boolean {\n    if (!canBreakthrough(this.state.cultivation)) {\n      this.addNotification('修为不足，无法突破', 'warning');\n      return false;\n    }\n\n    const result = attemptBreakthrough(this.state.cultivation, this.state.resources);\n    if (!result) {\n      this.addNotification('材料不足，无法突破', 'warning');\n      return false;\n    }\n\n    this.state.cultivation = result.newState;\n    this.state.resources = result.newResources as Resources;\n\n    if (result.result.success) {\n      this.state.realm.realmId = result.newState.realmId;\n      this.state.realm.level = result.newState.level;\n      this.state.realm.exp = result.newState.exp;\n      this.state.realm.expToNext = result.newState.expToNext;\n    }\n\n    this.breakthroughAnim = {\n      active: true,\n      result: result.result,\n      startTime: performance.now(),\n      duration: 3000,\n    };\n\n    if (result.result.success) {\n      audioManager.playBreakthroughSuccess();\n      this.addNotification(`突破成功！进入 ${getFullRealmName(this.state.cultivation)}`, 'success');\n    } else {\n      audioManager.playBreakthroughFail();\n      this.addNotification(`突破失败，修为损失 ${Math.floor(result.result.penalty * 100)}%`, 'error');\n    }\n\n    this.onBreakthroughAnim?.(true, result.result);\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  getBreakthroughInfo() {\n    return getBreakthroughRequirements(this.state.cultivation);\n  }\n\n  // === M4: Ascension Actions ===\n\n  getAscensionInfo() {\n    return checkAscensionRequirements(this.state.resources, this.state.cultivation.totalCultivation);\n  }\n\n  attemptAscensionAction(): boolean {\n    const result = attemptAscension(this.state.resources, this.state.cultivation.totalCultivation);\n    if (!result.success) {\n      this.addNotification('飞升条件不满足', 'warning');\n      return false;\n    }\n\n    this.state.resources = result.newResources as Resources;\n    this.state.ascensionCompleted = true;\n    this.ascensionMultiplier = 10.0;\n\n    this.ascensionAnim = {\n      active: true,\n      startTime: performance.now(),\n      duration: 5000,\n    };\n\n    audioManager.playBreakthroughSuccess();\n    this.addNotification('🌟 飞升成功！获得称号：飞升仙尊', 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  // === M4: Cross-Region Link ===\n\n  createCrossRegionLinkAction(\n    fromRegionIndex: number,\n    fromX: number,\n    fromY: number,\n    toRegionIndex: number,\n    toX: number,\n    toY: number,\n    resource: string,\n    amount: number,\n    interval: number,\n  ): boolean {\n    const id = `crl_${Date.now()}_${Math.random().toString(36).slice(2)}`;\n    const link = createCrossRegionLink(id, fromRegionIndex, fromX, fromY, toRegionIndex, toX, toY, resource, amount, interval);\n    this.state = addCrossRegionLink(this.state, link);\n    this.addNotification(`建立跨区域传送链路`, 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  // === Alchemy Actions ===\n\n  getAvailableAlchemyRecipes(): AlchemyRecipe[] {\n    return getAvailableRecipes((realm) => cultivationIsRealmUnlocked(realm, this.state.cultivation));\n  }\n\n  startAlchemyAction(recipeId: string): boolean {\n    const crafting = startCrafting(recipeId, this.state.resources);\n    if (!crafting) return false;\n\n    this.state.resources = crafting.resources as Resources;\n    this.state.alchemySession = crafting.session;\n    audioManager.playAlchemyStart();\n    this.addNotification(`开始炼丹`, 'info');\n    this.onStateChange?.(this.state);\n    this.onAlchemyUpdate?.(this.state.alchemySession);\n    return true;\n  }\n\n  collectAlchemyAction(): boolean {\n    if (!this.state.alchemySession?.complete) return false;\n\n    const result = collectAlchemy(this.state.alchemySession, this.state.resources);\n    if (!result) return false;\n\n    this.state.resources = result.resources as Resources;\n    this.state.alchemySession = null;\n\n    if (result.success) {\n      this.state.cultivation = addCultivationExp(this.state.cultivation, result.expReward);\n\n      // Track pill crafting for achievements\n      const recipe = this.state.alchemySession?.recipeId ?? 'unknown';\n      this.pillsCrafted[recipe] = (this.pillsCrafted[recipe] ?? 0) + result.amount;\n      this.totalPillsCrafted += result.amount;\n\n      audioManager.playAlchemyComplete();\n      this.addNotification(`炼丹成功！获得 ${result.amount} 颗丹药`, 'success');\n    } else {\n      audioManager.playAlchemyFail();\n      this.addNotification('炼丹失败...', 'error');\n    }\n\n    this.onStateChange?.(this.state);\n    this.onAlchemyUpdate?.(null);\n    return true;\n  }\n\n  // === Notifications ===\n\n  addNotification(text: string, type: GameNotification['type'] = 'info'): void {\n    const notif: GameNotification = {\n      id: ++notifIdCounter,\n      text,\n      type,\n      time: Date.now(),\n    };\n    this.notifications.push(notif);\n    if (this.notifications.length > 10) {\n      this.notifications = this.notifications.slice(-10);\n    }\n    this.onNotification?.(notif);\n  }\n\n  // === Utility ===\n\n  private getResourceName(id: string): string {\n    const names: Record<string, string> = {\n      spirit_stone: '灵石',\n      spirit_grass: '灵草',\n      spirit_energy: '灵气',\n      cultivation: '修为',\n      pill_juling: '聚灵丹',\n      pill_peiyuan: '培元丹',\n      pill_ningqi: '凝气丹',\n      pill_zhuji: '筑基丹',\n      pill_jindanyin: '金丹引',\n      pill_yuanyingguo: '元婴果',\n      pill_huashenlu: '化神露',\n      pill_jiuzhuan: '九转金丹',\n      spirit_iron: '灵铁',\n      spirit_wood: '灵木',\n      talisman_paper: '符纸',\n      monster_core: '妖丹',\n      heaven_earth_liquid: '天地灵液',\n      immortal_stone: '仙灵石',\n      merit: '功德值',\n    };\n    return names[id] ?? id;\n  }\n\n  centerCamera(): void {\n    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);\n  }\n\n  getAvailableBuildings(): BuildingDef[] {\n    return Array.from(this.buildingDefs.values()).filter(def => {\n      return cultivationIsRealmUnlocked(def.unlockRealm, this.state.cultivation);\n    });\n  }\n\n  getInventoryPills(): Array<PillDef & { count: number }> {\n    const result: Array<PillDef & { count: number }> = [];\n    for (const def of getAllPillDefs()) {\n      const count = this.state.resources[def.id as keyof typeof this.state.resources] ?? 0;\n      if (count > 0) {\n        result.push({ ...def, count });\n      }\n    }\n    return result;\n  }\n\n  private setupInput(canvas: HTMLCanvasElement): void {\n    canvas.addEventListener('mousemove', (e) => {\n      const rect = canvas.getBoundingClientRect();\n      const mx = e.clientX - rect.left;\n      const my = e.clientY - rect.top;\n\n      const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n      this.hoveredCell = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n\n      if (this.placementMode && this.hoveredCell) {\n        this.placementPos = { gx: this.hoveredCell.gx, gy: this.hoveredCell.gy };\n        const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n        this.placementValid = canPlace(\n          this.map,\n          this.placementMode,\n          this.placementPos.gx,\n          this.placementPos.gy,\n          buildings,\n        );\n      }\n    });\n\n    canvas.addEventListener('mousedown', (e) => {\n      if (e.button !== 0) return;\n      this.clickStartTime = performance.now();\n      this.clickStartPos = { x: e.clientX, y: e.clientY };\n    });\n\n    canvas.addEventListener('mouseup', (e) => {\n      if (e.button !== 0) return;\n      const dt = performance.now() - this.clickStartTime;\n      const dx = Math.abs(e.clientX - this.clickStartPos.x);\n      const dy = Math.abs(e.clientY - this.clickStartPos.y);\n\n      if (dt < 300 && dx < 5 && dy < 5) {\n        audioManager.init();\n        audioManager.resume();\n        this.handleClick(e);\n      }\n    });\n\n    document.addEventListener('keydown', (e) => {\n      if (e.key === 'Escape') {\n        this.placementMode = null;\n      }\n    });\n  }\n\n  private handleClick(e: MouseEvent): void {\n    const rect = this.canvas.getBoundingClientRect();\n    const mx = e.clientX - rect.left;\n    const my = e.clientY - rect.top;\n    const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n    const { gx, gy } = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n\n    if (!this.map.inBounds(gx, gy)) return;\n\n    if (this.placementMode) {\n      this.placementPos = { gx, gy };\n      const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n      this.placementValid = canPlace(this.map, this.placementMode, gx, gy, buildings);\n      if (this.placementValid) {\n        this.placeCurrentBuilding();\n      }\n      return;\n    }\n\n    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n    const clicked = buildings.find(b => {\n      const def = this.buildingDefs.get(b.buildingId);\n      if (!def) return false;\n      return (\n        gx >= b.gridX && gx < b.gridX + def.size.w &&\n        gy >= b.gridY && gy < b.gridY + def.size.h\n      );\n    });\n\n    if (clicked) {\n      this.handleBuildingClick(clicked);\n    }\n  }\n}\n","structuredPatch":[{"oldStart":858,"oldLines":15,"newStart":858,"newLines":14,"lines":["     const result = collectAlchemy(this.state.alchemySession, this.state.resources);","     if (!result) return false;"," ","+    const recipeId = this.state.alchemySession?.recipeId ?? 'unknown';","     this.state.resources = result.resources as Resources;","     this.state.alchemySession = null;"," ","     if (result.success) {","       this.state.cultivation = addCultivationExp(this.state.cultivation, result.expReward);"," ","-      // Track pill crafting for achievements","-      const recipe = this.state.alchemySession?.recipeId ?? 'unknown';","-      this.pillsCrafted[recipe] = (this.pillsCrafted[recipe] ?? 0) + result.amount;","+      this.pillsCrafted[recipeId] = (this.pillsCrafted[recipeId] ?? 0) + result.amount;","       this.totalPillsCrafted += result.amount;"," ","       audioManager.playAlchemyComplete();"]}],"userModified":false,"replaceAll":false}}
