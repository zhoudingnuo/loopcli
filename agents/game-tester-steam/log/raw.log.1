{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_dcfde3a2360148c6abf80eb1","type":"tool_result","content":"1\t// SaveManager.ts — Auto-save after day end + load restore (M3)\n2\t\n3\timport { type GameState, type SaveData, CURRENT_VERSION } from './GameState';\n4\t\n5\texport interface SaveableSystem {\n6\t  getSaveData(): Record<string, unknown>;\n7\t  loadSaveData(data: Record<string, unknown>): void;\n8\t}\n9\t\n10\tconst SAVE_KEY = 'midnight_store_save_v3';\n11\t\n12\texport class SaveManager {\n13\t  private systems: Map<string, SaveableSystem> = new Map();\n14\t  private lastSaveTime = 0;\n15\t  private autoSaveInterval = 300000;\n16\t\n17\t  register(name: string, system: SaveableSystem): void {\n18\t    this.systems.set(name, system);\n19\t  }\n20\t\n21\t  save(state: GameState): boolean {\n22\t    const data: Record<string, unknown> = {};\n23\t    for (const [name, sys] of this.systems) {\n24\t      data[name] = sys.getSaveData();\n25\t    }\n26\t\n27\t    const saveData: SaveData = {\n28\t      version: CURRENT_VERSION,\n29\t      timestamp: Date.now(),\n30\t      playtime: state.totalPlaytime,\n31\t      gameState: state,\n32\t      productManager: (data['productManager'] as Record<string, unknown>) ?? {},\n33\t      economy: (data['economy'] as Record<string, unknown>) ?? {},\n34\t      pricing: (data['pricing'] as Record<string, unknown>) ?? {},\n35\t      customerStats: (data['customerManager'] as Record<string, unknown>) ?? {},\n36\t      registers: (data['registers'] as Record<string, unknown>[]) ?? [],\n37\t    };\n38\t\n39\t    try {\n40\t      localStorage.setItem(SAVE_KEY, JSON.stringify(saveData));\n41\t      this.lastSaveTime = Date.now();\n42\t      return true;\n43\t    } catch {\n44\t      console.warn('Save failed: storage quota exceeded');\n45\t      return false;\n46\t    }\n47\t  }\n48\t\n49\t  load(): SaveData | null {\n50\t    try {\n51\t      const raw = localStorage.getItem(SAVE_KEY);\n52\t      if (!raw) return null;\n53\t      return JSON.parse(raw) as SaveData;\n54\t    } catch {\n55\t      return null;\n56\t    }\n57\t  }\n58\t\n59\t  restore(save: SaveData, state: GameState): void {\n60\t    const gs = save.gameState;\n61\t    if (gs) {\n62\t      Object.assign(state, gs);\n63\t    }\n64\t\n65\t    const restoreSystem = (name: string, key: keyof SaveData) => {\n66\t      const sys = this.systems.get(name);\n67\t      const data = save[key] as Record<string, unknown> | undefined;\n68\t      if (sys && data && Object.keys(data).length > 0) {\n69\t        sys.loadSaveData(data);\n70\t      }\n71\t    };\n72\t\n73\t    restoreSystem('productManager', 'productManager');\n74\t    restoreSystem('economy', 'economy');\n75\t    restoreSystem('pricing', 'pricing');\n76\t    restoreSystem('customerManager', 'customerStats');\n77\t\n78\t    const sys = this.systems.get('registers');\n79\t    if (sys && save.registers) {\n80\t      sys.loadSaveData({ registers: save.registers });\n81\t    }\n82\t  }\n83\t\n84\t  clearSave(): void {\n85\t    localStorage.removeItem(SAVE_KEY);\n86\t  }\n87\t\n88\t  hasSave(): boolean {\n89\t    return localStorage.getItem(SAVE_KEY) !== null;\n90\t  }\n91\t\n92\t  startAutoSave(getState: () => GameState): void {\n93\t    window.setInterval(() => {\n94\t      this.save(getState());\n95\t    }, this.autoSaveInterval);\n96\t  }\n97\t}\n98\t"}]},"parent_tool_use_id":null,"session_id":"561a5118-a4d0-464b-8f32-001690e29cb0","uuid":"99be8913-16ce-46ca-826b-2c48f78086d3","timestamp":"2026-05-23T10:30:05.828Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-horror-sim\\src\\game\\SaveManager.ts","content":"// SaveManager.ts — Auto-save after day end + load restore (M3)\n\nimport { type GameState, type SaveData, CURRENT_VERSION } from './GameState';\n\nexport interface SaveableSystem {\n  getSaveData(): Record<string, unknown>;\n  loadSaveData(data: Record<string, unknown>): void;\n}\n\nconst SAVE_KEY = 'midnight_store_save_v3';\n\nexport class SaveManager {\n  private systems: Map<string, SaveableSystem> = new Map();\n  private lastSaveTime = 0;\n  private autoSaveInterval = 300000;\n\n  register(name: string, system: SaveableSystem): void {\n    this.systems.set(name, system);\n  }\n\n  save(state: GameState): boolean {\n    const data: Record<string, unknown> = {};\n    for (const [name, sys] of this.systems) {\n      data[name] = sys.getSaveData();\n    }\n\n    const saveData: SaveData = {\n      version: CURRENT_VERSION,\n      timestamp: Date.now(),\n      playtime: state.totalPlaytime,\n      gameState: state,\n      productManager: (data['productManager'] as Record<string, unknown>) ?? {},\n      economy: (data['economy'] as Record<string, unknown>) ?? {},\n      pricing: (data['pricing'] as Record<string, unknown>) ?? {},\n      customerStats: (data['customerManager'] as Record<string, unknown>) ?? {},\n      registers: (data['registers'] as Record<string, unknown>[]) ?? [],\n    };\n\n    try {\n      localStorage.setItem(SAVE_KEY, JSON.stringify(saveData));\n      this.lastSaveTime = Date.now();\n      return true;\n    } catch {\n      console.warn('Save failed: storage quota exceeded');\n      return false;\n    }\n  }\n\n  load(): SaveData | null {\n    try {\n      const raw = localStorage.getItem(SAVE_KEY);\n      if (!raw) return null;\n      return JSON.parse(raw) as SaveData;\n    } catch {\n      return null;\n    }\n  }\n\n  restore(save: SaveData, state: GameState): void {\n    const gs = save.gameState;\n    if (gs) {\n      Object.assign(state, gs);\n    }\n\n    const restoreSystem = (name: string, key: keyof SaveData) => {\n      const sys = this.systems.get(name);\n      const data = save[key] as Record<string, unknown> | undefined;\n      if (sys && data && Object.keys(data).length > 0) {\n        sys.loadSaveData(data);\n      }\n    };\n\n    restoreSystem('productManager', 'productManager');\n    restoreSystem('economy', 'economy');\n    restoreSystem('pricing', 'pricing');\n    restoreSystem('customerManager', 'customerStats');\n\n    const sys = this.systems.get('registers');\n    if (sys && save.registers) {\n      sys.loadSaveData({ registers: save.registers });\n    }\n  }\n\n  clearSave(): void {\n    localStorage.removeItem(SAVE_KEY);\n  }\n\n  hasSave(): boolean {\n    return localStorage.getItem(SAVE_KEY) !== null;\n  }\n\n  startAutoSave(getState: () => GameState): void {\n    window.setInterval(() => {\n      this.save(getState());\n    }, this.autoSaveInterval);\n  }\n}\n","numLines":98,"startLine":1,"totalLines":98}}}
