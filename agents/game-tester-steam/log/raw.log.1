toBeNull();\n225\t\n226\t    clearSave();\n227\t    expect(loadGame()).toBeNull();\n228\t  });\n229\t\n230\t  it('saves extra system data', () => {\n231\t    const state = createInitialState();\n232\t    const pm = { shelves: 5 };\n233\t    const eco = { revenue: 200 };\n234\t    const prc = { markup: 1.2 };\n235\t    const cust = { served: 10 };\n236\t    const regs = [{ id: 'r1', total: 50 }];\n237\t\n238\t    saveGame(state, pm, eco, prc, cust, regs);\n239\t    const loaded = loadGame();\n240\t\n241\t    expect(loaded!.productManager).toEqual(pm);\n242\t    expect(loaded!.economy).toEqual(eco);\n243\t    expect(loaded!.pricing).toEqual(prc);\n244\t    expect(loaded!.customerStats).toEqual(cust);\n245\t    expect(loaded!.registers).toEqual(regs);\n246\t  });\n247\t});\n248\t"}]},"parent_tool_use_id":null,"session_id":"561a5118-a4d0-464b-8f32-001690e29cb0","uuid":"2a16fbb2-e9f0-41e5-b75f-a4cad33402c3","timestamp":"2026-05-23T10:26:25.373Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-horror-sim\\tests\\gameState.test.ts","content":"// gameState.test.ts — Tests for GameState.ts\n\nimport { describe, it, expect, beforeEach, vi } from 'vitest';\nimport {\n  GamePhase,\n  UIPanel,\n  createInitialState,\n  cloneState,\n  saveGame,\n  loadGame,\n  clearSave,\n  getTimeString,\n  getPhaseFromTime,\n  isNightTime,\n  CURRENT_VERSION,\n} from '../src/game/GameState';\n\n// Mock localStorage\nconst localStorageMock = (() => {\n  let store: Record<string, string> = {};\n  return {\n    getItem: vi.fn((key: string) => store[key] ?? null),\n    setItem: vi.fn((key: string, value: string) => { store[key] = value; }),\n    removeItem: vi.fn((key: string) => { delete store[key]; }),\n    clear: vi.fn(() => { store = {}; }),\n    get length() { return Object.keys(store).length; },\n    key: vi.fn((index: number) => Object.keys(store)[index] ?? null),\n  };\n})();\n\nObject.defineProperty(globalThis, 'localStorage', { value: localStorageMock });\n\n// Mock window.setInterval / clearInterval\nObject.defineProperty(globalThis, 'window', {\n  value: {\n    setInterval: vi.fn(() => 12345),\n    clearInterval: vi.fn(),\n  },\n  writable: true,\n});\n\ndescribe('createInitialState', () => {\n  it('returns a valid GameState with all required fields', () => {\n    const state = createInitialState();\n\n    expect(state.phase).toBe(GamePhase.DAYTIME);\n    expect(state.activePanel).toBe(UIPanel.NONE);\n    expect(state.version).toBe(CURRENT_VERSION);\n    expect(state.day).toBe(1);\n    expect(state.timeOfDay).toBe(6);\n    expect(state.timeSpeed).toBe(1);\n    expect(state.totalPlaytime).toBe(0);\n    expect(state.notifications).toEqual([]);\n    expect(state.daySummaries).toEqual([]);\n  });\n\n  it('initializes player state with correct defaults', () => {\n    const state = createInitialState();\n\n    expect(state.player.x).toBe(15 * 32);\n    expect(state.player.y).toBe(5 * 32);\n    expect(state.player.speed).toBe(150);\n    expect(state.player.direction).toBe('down');\n    expect(state.player.health).toBe(100);\n    expect(state.player.sanity).toBe(100);\n  });\n\n  it('initializes economy fields', () => {\n    const state = createInitialState();\n\n    expect(state.money).toBe(500);\n    expect(state.debt).toBe(300000);\n    expect(state.dailyRevenue).toBe(0);\n    expect(state.dailyExpenses).toBe(0);\n  });\n\n  it('initializes horror and narrative fields', () => {\n    const state = createInitialState();\n\n    expect(state.horrorEventsTriggered).toBe(0);\n    expect(state.lastHorrorEventDay).toBe(0);\n    expect(state.fearLevel).toBe(0);\n    expect(state.storyLayer).toBe('surface');\n    expect(state.cluesFound).toBe(0);\n    expect(state.totalClues).toBe(75);\n    expect(state.choicesMade).toBe(0);\n  });\n});\n\ndescribe('getPhaseFromTime', () => {\n  it('returns DAYTIME for morning hours (6-21)', () => {\n    expect(getPhaseFromTime(6)).toBe(GamePhase.DAYTIME);\n    expect(getPhaseFromTime(12)).toBe(GamePhase.DAYTIME);\n    expect(getPhaseFromTime(21.9)).toBe(GamePhase.DAYTIME);\n  });\n\n  it('returns NIGHT_TRANSITION for 22-23', () => {\n    expect(getPhaseFromTime(22)).toBe(GamePhase.NIGHT_TRANSITION);\n    expect(getPhaseFromTime(22.5)).toBe(GamePhase.NIGHT_TRANSITION);\n    expect(getPhaseFromTime(22.99)).toBe(GamePhase.NIGHT_TRANSITION);\n  });\n\n  it('returns NIGHT for 23-2 (wraps around midnight)', () => {\n    expect(getPhaseFromTime(23)).toBe(GamePhase.NIGHT);\n    expect(getPhaseFromTime(0)).toBe(GamePhase.NIGHT);\n    expect(getPhaseFromTime(1)).toBe(GamePhase.NIGHT);\n    expect(getPhaseFromTime(1.99)).toBe(GamePhase.NIGHT);\n  });\n\n  it('returns DANGER for 2-5', () => {\n    expect(getPhaseFromTime(2)).toBe(GamePhase.DANGER);\n    expect(getPhaseFromTime(3)).toBe(GamePhase.DANGER);\n    expect(getPhaseFromTime(4.99)).toBe(GamePhase.DANGER);\n  });\n\n  it('returns DAWN for 5-6', () => {\n    expect(getPhaseFromTime(5)).toBe(GamePhase.DAWN);\n    expect(getPhaseFromTime(5.5)).toBe(GamePhase.DAWN);\n    expect(getPhaseFromTime(5.99)).toBe(GamePhase.DAWN);\n  });\n});\n\ndescribe('isNightTime', () => {\n  it('returns true for NIGHT_TRANSITION', () => {\n    expect(isNightTime(GamePhase.NIGHT_TRANSITION)).toBe(true);\n  });\n\n  it('returns true for NIGHT', () => {\n    expect(isNightTime(GamePhase.NIGHT)).toBe(true);\n  });\n\n  it('returns true for DANGER', () => {\n    expect(isNightTime(GamePhase.DANGER)).toBe(true);\n  });\n\n  it('returns false for DAYTIME', () => {\n    expect(isNightTime(GamePhase.DAYTIME)).toBe(false);\n  });\n\n  it('returns false for DAWN', () => {\n    expect(isNightTime(GamePhase.DAWN)).toBe(false);\n  });\n\n  it('returns false for MENU and PAUSED', () => {\n    expect(isNightTime(GamePhase.MENU)).toBe(false);\n    expect(isNightTime(GamePhase.PAUSED)).toBe(false);\n  });\n});\n\ndescribe('getTimeString', () => {\n  it('formats whole hours correctly', () => {\n    expect(getTimeString(6)).toBe('06:00');\n    expect(getTimeString(14)).toBe('14:00');\n    expect(getTimeString(23)).toBe('23:00');\n  });\n\n  it('formats hours with minutes correctly', () => {\n    expect(getTimeString(6.5)).toBe('06:30');\n    expect(getTimeString(14.25)).toBe('14:15');\n    expect(getTimeString(22.75)).toBe('22:45');\n  });\n\n  it('wraps hours past 24', () => {\n    expect(getTimeString(25)).toBe('01:00');\n    expect(getTimeString(26.5)).toBe('02:30');\n  });\n\n  it('handles edge cases', () => {\n    expect(getTimeString(0)).toBe('00:00');\n    expect(getTimeString(23.99)).toBe('23:59');\n  });\n});\n\ndescribe('cloneState', () => {\n  it('creates a deep copy of the state', () => {\n    const state = createInitialState();\n    const cloned = cloneState(state);\n\n    expect(cloned).toEqual(state);\n    expect(cloned).not.toBe(state);\n  });\n\n  it('modifying the clone does not affect original', () => {\n    const state = createInitialState();\n    const cloned = cloneState(state);\n\n    cloned.money = 999;\n    cloned.player.health = 50;\n    cloned.notifications.push('test');\n\n    expect(state.money).toBe(500);\n    expect(state.player.health).toBe(100);\n    expect(state.notifications).toEqual([]);\n  });\n});\n\ndescribe('saveGame / loadGame', () => {\n  beforeEach(() => {\n    localStorageMock.clear();\n    vi.clearAllMocks();\n  });\n\n  it('saves and loads game state roundtrip', () => {\n    const state = createInitialState();\n    state.money = 1000;\n    state.day = 5;\n\n    saveGame(state);\n    const loaded = loadGame();\n\n    expect(loaded).not.toBeNull();\n    expect(loaded!.gameState.money).toBe(1000);\n    expect(loaded!.gameState.day).toBe(5);\n    expect(loaded!.version).toBe(CURRENT_VERSION);\n  });\n\n  it('returns null when no save exists', () => {\n    expect(loadGame()).toBeNull();\n  });\n\n  it('clears save data', () => {\n    const state = createInitialState();\n    saveGame(state);\n    expect(loadGame()).not.toBeNull();\n\n    clearSave();\n    expect(loadGame()).toBeNull();\n  });\n\n  it('saves extra system data', () => {\n    const state = createInitialState();\n    const pm = { shelves: 5 };\n    const eco = { revenue: 200 };\n    const prc = { markup: 1.2 };\n    const cust = { served: 10 };\n    const regs = [{ id: 'r1', total: 50 }];\n\n    saveGame(state, pm, eco, prc, cust, regs);\n    const loaded = loadGame();\n\n    expect(loaded!.productManager).toEqual(pm);\n    expect(loaded!.economy).toEqual(eco);\n    expect(loaded!.pricing).toEqual(prc);\n    expect(loaded!.customerStats).toEqual(cust);\n    expect(loaded!.registers).toEqual(regs);\n  });\n});\n","numLines":248,"startLine":1,"totalLines":248}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_c9f3f33ee8bc4c52869861d7","type":"tool_result","content":"1\t// player.test.ts — Tests for Player.ts\n2\t\n3\timport { describe, it, expect } from 'vitest';\n4\timport { Player, PLAYER_SIZE, PLAYER_OFFSET } from '../src/game/Player';\n5\timport { StoreMap } from '../src/game/StoreMap';\n6\timport type { PlayerState } from '../src/game/GameState';\n7\t\n8\tfunction makePlayerState(overrides: Partial<PlayerState> = {}): PlayerState {\n9\t  return {\n10\t    x: 15 * 32,\n11\t    y: 5 * 32,\n12\t    speed: 150,\n13\t    direction: 'down',\n14\t    money: 500,\n15\t    debt: 300000,\n16\t    day: 1,\n17\t    health: 100,\n18\t    sanity: 100,\n19\t    ...overrides,\n20\t  };\n21\t}\n22\t\n23\tdescribe('Player initialization', () => {\n24\t  it('creates player from state', () => {\n25\t    const state = makePlayerState();\n26\t    const player = new Player(state);\n27\t\n28\t    expect(player.x).toBe(state.x);\n29\t    expect(player.y).toBe(state.y);\n30\t    expect(player.speed).toBe(state.speed);\n31\t    expect(player.direction).toBe(state.direction);\n32\t  });\n33\t\n34\t  it('initializes animation state', () => {\n35\t    const player = new Player(makePlayerState());\n36\t    expect(player.animFrame).toBe(0);\n37\t    expect(player.animTimer).toBe(0);\n38\t    expect(player.moving).toBe(false);\n39\t  });\n40\t\n41\t  it('PLAYER_SIZE and PLAYER_OFFSET are consistent', () => {\n42\t    expect(PLAYER_SIZE).toBe(20);\n43\t    expect(PLAYER_OFFSET).toBe((32 - 20) / 2);\n44\t    expect(PLAYER_SIZE + PLAYER_OFFSET * 2).toBe(32);\n45\t  });\n46\t});\n47\t\n48\tdescribe('Player movement', () => {\n49\t  it('does not move when no keys are pressed', () => {\n50\t    const state = makePlayerState({ x: 500, y: 300 });\n51\t    const player = new Player(state);\n52\t    const map = new StoreMap();\n53\t\n54\t    const startX = player.x;\n55\t    const startY = player.y;\n56\t\n57\t    player.update(16, map);\n58\t\n59\t    expect(player.x).toBe(startX);\n60\t    expect(player.y).toBe(startY);\n61\t    expect(player.moving).toBe(false);\n62\t  });\n63\t\n64\t  it('respects collision with walls', () => {\n65\t    const map = new StoreMap();\n66\t    // Place player right next to a wall (top-left corner area)\n67\t    // Row 0 is wall, so placing player at y=1 (pixel 32) and trying to move up\n68\t    const state = makePlayerState({ x: 1 * 32, y: 1 * 32 });\n69\t    const player = new Player(state);\n70\t\n71\t    // Simulate pressing 'w' (move up) for 1 second\n72\t    // Since we can't easily simulate keyboard, we test collision directly\n73\t    const wouldCollide = map.collides(\n74\t      player.x + PLAYER_OFFSET,\n75\t      (player.y - 150 + PLAYER_OFFSET),\n76\t      PLAYER_SIZE,\n77\t      PLAYER_SIZE,\n78\t    );\n79\t    expect(wouldCollide).toBe(true);\n80\t  });\n81\t\n82\t  it('movement speed is applied correctly via dt', () => {\n83\t    const state = makePlayerState({ speed: 150, x: 500, y: 300 });\n84\t    const player = new Player(state);\n85\t    const map = new StoreMap();\n86\t\n87\t    // At speed 150, with dt=1000ms, player should move 150 pixels\n88\t    const moveSpeed = player.speed * 1 / 1000; // dt=1000\n89\t    expect(moveSpeed).toBe(0.15);\n90\t  });\n91\t});\n92\t\n93\tdescribe('getFacingTile', () => {\n94\t  it('returns correct tile when facing down', () => {\n95\t    const player = new Player(makePlayerState({\n96\t      x: 10 * 32,\n97\t      y: 5 * 32,\n98\t      direction: 'down',\n99\t    }));\n100\t\n101\t    const { gx, gy } = player.getFacingTile();\n102\t    // Player center: (10*32 + 16, 5*32 + 16) = (336, 176)\n103\t    // Facing down: targetY = 176 + 32 = 208 => gy = 6\n104\t    expect(gx).toBe(10 + 1); // (10*32 + 16) / 32 = 10.5 -> floor -> 10... wait\n105\t    // Actually: cx = 10*32 + 16 = 336, cy = 5*32 + 16 = 176\n106\t    // targetY = 176 + 32 = 208, gy = 208/32 = 6.5 -> floor = 6\n107\t    expect(gy).toBe(6);\n108\t  });\n109\t\n110\t  it('returns correct tile when facing up', () => {\n111\t    const player = new Player(makePlayerState({\n112\t      x: 10 * 32,\n113\t      y: 5 * 32,\n114\t      direction: 'up',\n115\t    }));\n116\t\n117\t    const { gx, gy } = player.getFacingTile();\n118\t    // targetY = 176 - 32 = 144, gy = 144/32 = 4.5 -> floor = 4\n119\t    expect(gy).toBe(4);\n120\t  });\n121\t\n122\t  it('returns correct tile when facing left', () => {\n123\t    const player = new Player(makePlayerState({\n124\t      x: 10 * 32,\n125\t      y: 5 * 32,\n126\t      direction: 'left',\n127\t    }));\n128\t\n129\t    const { gx, gy } = player.getFacingTile();\n130\t    // targetX = 336 - 32 = 304, gx = 304/32 = 9.5 -> floor = 9\n131\t    expect(gx).toBe(9);\n132\t  });\n133\t\n134\t  it('returns correct tile when facing right', () => {\n135\t    const player = new Player(makePlayerState({\n136\t      x: 10 * 32,\n137\t      y: 5 * 32,\n138\t      direction: 'right',\n139\t    }));\n140\t\n141\t    const { gx, gy } = player.getFacingTile();\n142\t    // targetX = 336 + 32 = 368, gx = 368/32 = 11.5 -> floor = 11\n143\t    expect(gx).toBe(11);\n144\t  });\n145\t});\n146\t\n147\tdescribe('toState', () => {\n148\t  it('serializes player state correctly', () => {\n149\t    const state = makePlayerState({\n150\t      x: 100,\n151\t      y: 200,\n152\t      speed: 180,\n153\t      direction: 'left',\n154\t    });\n155\t    const player = new Player(state);\n156\t    const serialized = player.toState();\n157\t\n158\t    expect(serialized.x).toBe(100);\n159\t    expect(serialized.y).toBe(200);\n160\t    expect(serialized.speed).toBe(180);\n161\t    expect(serialized.direction).toBe('left');\n162\t  });\n163\t\n164\t  it('returns default economy fields in serialized state', () => {\n165\t    const player = new Player(makePlayerState());\n166\t    const serialized = player.toState();\n167\t\n168\t    expect(serialized.money).toBe(0);\n169\t    expect(serialized.debt).toBe(0);\n170\t    exp