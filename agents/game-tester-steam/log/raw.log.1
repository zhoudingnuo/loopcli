{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_74c28541ae714946a0e6e508","type":"tool_result","content":"1\t// App.ts — Game main loop + state machine (v1.0.0 — M7: Polish & Launch)\n2\t\n3\timport { Renderer } from './Renderer';\n4\timport { StoreMap, TILE_SIZE, T } from '../game/StoreMap';\n5\timport { Player } from '../game/Player';\n6\timport {\n7\t  type GameState,\n8\t  type Interactable,\n9\t  type LightSource,\n10\t  GamePhase,\n11\t  UIPanel,\n12\t  createInitialState,\n13\t  loadGame,\n14\t  saveGame,\n15\t  startAutoSave,\n16\t  stopAutoSave,\n17\t  getPhaseFromTime,\n18\t  cloneState,\n19\t  isNightTime,\n20\t} from '../game/GameState';\n21\timport { ProductManager } from '../game/ProductManager';\n22\timport { CustomerManager } from '../game/CustomerManager';\n23\timport { CashRegister } from '../game/CashRegister';\n24\timport { PricingSystem } from '../game/PricingSystem';\n25\timport { EconomySystem } from '../game/EconomySystem';\n26\timport { ShelfInteraction, ShelfAction } from '../game/ShelfInteraction';\n27\timport { Customer, CustomerState } from '../game/Customer';\n28\timport { DayCycle } from '../game/DayCycle';\n29\timport { DaySummaryManager } from '../game/DaySummary';\n30\timport { UpgradeManager } from '../game/UpgradeManager';\n31\timport { SaveManager } from '../game/SaveManager';\n32\timport { HorrorEventManager, HorrorEventType } from '../game/HorrorEventManager';\n33\timport { AudioManager } from '../game/AudioManager';\n34\timport { NPCManager } from '../game/BehaviorTree';\n35\timport { JumpScareManager } from '../game/JumpScareManager';\n36\timport { ClueManager } from '../game/ClueManager';\n37\timport { StoryManager } from '../game/StoryManager';\n38\timport { EndingSystem } from '../game/EndingSystem';\n39\timport { RadioManager } from '../game/RadioManager';\n40\timport { NoteManager } from '../game/NoteManager';\n41\timport { NarrativeChoiceManager } from '../game/NarrativeChoiceManager';\n42\t\n43\texport class App {\n44\t  canvas: HTMLCanvasElement;\n45\t  renderer: Renderer;\n46\t  state: GameState;\n47\t  map: StoreMap;\n48\t  player: Player;\n49\t\n50\t  // M2 systems\n51\t  productManager: ProductManager;\n52\t  customerManager: CustomerManager;\n53\t  registers: CashRegister[];\n54\t  pricing: PricingSystem;\n55\t  economy: EconomySystem;\n56\t  shelfInteraction: ShelfInteraction;\n57\t\n58\t  // M3 systems\n59\t  dayCycle: DayCycle;\n60\t  daySummary: DaySummaryManager;\n61\t  upgradeManager: UpgradeManager;\n62\t  saveManager: SaveManager;\n63\t\n64\t  // M4 systems\n65\t  horrorManager: HorrorEventManager;\n66\t  audioManager: AudioManager;\n67\t\n68\t  // M5 systems\n69\t  npcManager: NPCManager;\n70\t  jumpScareManager: JumpScareManager;\n71\t\n72\t  // M6 systems\n73\t  clueManager: ClueManager;\n74\t  storyManager: StoryManager;\n75\t  endingSystem: EndingSystem;\n76\t  radioManager: RadioManager;\n77\t  noteManager: NoteManager;\n78\t  narrativeChoices: NarrativeChoiceManager;\n79\t\n80\t  private running = false;\n81\t  private lastFrameTime = 0;\n82\t  private animFrameId = 0;\n83\t  private activeCustomers: Customer[] = [];\n84\t  private lastTransactionNotification = '';\n85\t\n86\t  onStateChange?: (state: GameState) => void;\n87\t  onNotification?: (text: string) => void;\n88\t\n89\t  constructor(canvas: HTMLCanvasElement) {\n90\t    this.canvas = canvas;\n91\t    this.renderer = new Renderer(canvas);\n92\t\n93\t    const saved = loadGame();\n94\t    this.state = saved ? { ...createInitialState(), ...saved.gameState } : createInitialState();\n95\t\n96\t    this.map = new StoreMap();\n97\t    this.player = new Player(this.state.player);\n98\t    this.player.setupInput();\n99\t\n100\t    // Initialize M2 systems\n101\t    this.productManager = new ProductManager();\n102\t    this.customerManager = new CustomerManager();\n103\t    this.registers = [\n104\t      new CashRegister('register_1'),\n105\t      new CashRegister('register_2'),\n106\t    ];\n107\t    this.pricing = new PricingSystem(this.productManager);\n108\t    this.economy = new EconomySystem();\n109\t    this.shelfInteraction = new ShelfInteraction();\n110\t\n111\t    // Initialize M3 systems\n112\t    this.dayCycle = new DayCycle();\n113\t    this.daySummary = new DaySummaryManager();\n114\t    this.upgradeManager = new UpgradeManager();\n115\t    this.saveManager = new SaveManager();\n116\t\n117\t    // Initialize M4 systems\n118\t    this.horrorManager = new HorrorEventManager();\n119\t    this.audioManager = new AudioManager();\n120\t\n121\t    // Initialize M5 systems\n122\t    this.npcManager = new NPCManager();\n123\t    this.jumpScareManager = new JumpScareManager();\n124\t\n125\t    // Initialize M6 systems\n126\t    this.clueManager = new ClueManager();\n127\t    this.storyManager = new StoryManager(this.clueManager);\n128\t    this.endingSystem = new EndingSystem(this.storyManager, this.clueManager);\n129\t    this.radioManager = new RadioManager();\n130\t    this.noteManager = new NoteManager();\n131\t    this.narrativeChoices = new NarrativeChoiceManager();\n132\t\n133\t    // M6: Wire up callbacks\n134\t    this.storyManager.onNotification = (text) => this.addNotification(text);\n135\t    this.endingSystem.onNotification = (text) => this.addNotification(text);\n136\t    this.radioManager.onNotification = (text) => this.addNotification(text);\n137\t    this.radioManager.onClueGrant = (clueId) => {\n138\t      this.clueManager.discoverClue(clueId, this.state.day);\n139\t      this.syncNarrativeState();\n140\t    };\n141\t    this.noteManager.onNotification = (text) => this.addNotification(text);\n142\t    this.noteManager.onCluesGranted = (clueIds) => {\n143\t      for (const id of clueIds) {\n144\t        this.clueManager.discoverClue(id, this.state.day);\n145\t      }\n146\t      this.syncNarrativeState();\n147\t    };\n148\t    this.narrativeChoices.onNotification = (text) => this.addNotification(text);\n149\t    this.narrativeChoices.onSanityCost = (amount) => {\n150\t      this.state.player.sanity = Math.max(0, this.state.player.sanity - amount);\n151\t    };\n152\t    this.narrativeChoices.onClueGrant = (clueId) => {\n153\t      this.clueManager.discoverClue(clueId, this.state.day);\n154\t      this.syncNarrativeState();\n155\t    };\n156\t\n157\t    // Register systems with SaveManager\n158\t    this.saveManager.register('productManager', this.productManager);\n159\t    this.saveManager.register('economy', this.economy);\n160\t    this.saveManager.register('pricing', this.pricing);\n161\t    this.saveManager.register('customerManager', this.customerManager);\n162\t    this.saveManager.register('upgradeManager', this.upgradeManager);\n163\t    this.saveManager.register('daySummary', this.daySummary);\n164\t\n165\t    // Load save data for M2 systems\n166\t    if (saved) {\n167\t      if (saved.productManager && Object.keys(saved.productManager).length > 0) {\n168\t        this.productManager.loadSaveData(saved.productManager);\n169\t      }\n170\t      if (saved.economy && Object.keys(saved.economy).length > 0) {\n171\t        this.economy.loadSaveData(saved.economy);\n172\t      }\n173\t      if (saved.pricing && Object.keys(saved.pricing).length > 0) {\n174\t        this.pricing.loadSaveData(saved.pricing);\n175\t      }\n176\t      if (saved.customerStats && Object.keys(saved.customerStats).length > 0) {\n177\t        this.customerManager.loadSaveData(saved.customerStats);\n178\t      }\n179\t      if (saved.registers) {\n180\t        for (let i = 0; i < saved.registers.length && i < this.registers.length; i++) {\n181\t          this.registers[i].loadSaveData(saved.registers[i]);\n182\t        }\n183\t      }\n184\t\n185\t      // Restore M3 day cycle state\n186\t      this.dayCycle.setDay(this.state.day);\n187\t      this.dayCycle.setTimeOfDay(this.state.timeOfDay);\n188\t    }\n189\t\n190\t    // Apply purchased upgrades\n191\t    this.applyUpgrades();\n192\t\n193\t    // Setup interactable objects\n194\t    this.state.interactables = this.createInteractables();\n195\t    this.state.lights = this.createLights();\n196\t\n197\t    // Give some starting inventory\n198\t    if (!saved) {\n199\t      this.setupStartingInventory();\n200\t    }\n201\t\n202\t    // Setup day cycle event listeners\n203\t    this.dayCycle.onPhaseChange((phase, prev) => {\n204\t      this.state.phase = phase;\n205\t      this.onStateChange?.(this.state);\n206\t    });\n207\t\n208\t    this.dayCycle.onNewDay((day) => {\n209\t      this.onNewDay();\n210\t    });\n211\t\n212\t    // M4: Horror event callbacks\n213\t    this.horrorManager.onSanityChange = (delta) => {\n214\t      this.state.player.sanity = Math.max(0, Math.min(100, this.state.player.sanity + delta));\n215\t      this.state.fearLevel = Math.min(1, this.state.fearLevel + Math.abs(delta) / 100);\n216\t    };\n217\t    this.horrorManager.onNotification = (text) => {\n218\t      this.addNotification(text);\n219\t    };\n220\t    this.horrorManager.onEventTrigger = (event) => {\n221\t      this.state.horrorEventsTriggered++;\n222\t      this.state.lastHorrorEventDay = this.state.day;\n223\t      this.triggerHorrorAudio(event.type);\n224\t    };\n225\t\n226\t    // M5: Jump scare callbacks\n227\t    this.jumpScareManager.onSanityDrain = (amount) => {\n228\t      this.state.player.sanity = Math.max(0, this.state.player.sanity - amount);\n229\t      this.state.fearLevel = Math.min(1, this.state.fearLevel + amount / 100);\n230\t    };\n231\t    this.jumpScareManager.onMoneyLoss = (percent) => {\n232\t      const loss = this.state.dailyRevenue * percent;\n233\t      this.state.dailyRevenue = Math.max(0, this.state.dailyRevenue - loss);\n234\t      this.economy.addExpense(loss);\n235\t    };\n236\t    this.jumpScareManager.onNotification = (text) => {\n237\t      this.addNotification(text);\n238\t    };\n239\t    this.jumpScareManager.onScareTrigger = (scare) => {\n240\t      this.audioManager.playHorrorJumpScare();\n241\t      this.state.horrorEventsTriggered++;\n242\t    };\n243\t\n244\t    // M4: Phase change BGM switching\n245\t    this.dayCycle.onPhaseChange((phase) => {\n246\t      this.switchBgmForPhase(phase);\n247\t      // M7: Ambient switching\n248\t      if (phase === GamePhase.DAYTIME) {\n249\t        this.audioManager.playAmbient('store_day');\n250\t      } else if (phase === GamePhase.NIGHT || phase === GamePhase.DANGER) {\n251\t        this.audioManager.playAmbient('store_night');\n252\t      } else {\n253\t        this.audioManager.stopAmbient();\n254\t      }\n255\t    });\n256\t\n257\t    // Snap camera to player immediately\n258\t    this.renderer.camera.snapTo(this.player.x + 16, this.player.y + 16);\n259\t\n260\t    // Setup keyboard shortcuts for panels\n261\t    this.setupPanelInput();\n262\t\n263\t    window.addEventListener('resize', () => {\n264\t      this.renderer.resize();\n265\t    });\n266\t  }\n267\t\n268\t  private setupStartingInventory(): void {\n269\t    this.productManager.addToInventory('water', 10, 1);\n270\t    this.productManager.addToInventory('cola', 8, 1);\n271\t    this.productManager.addToInventory('chips', 8, 1);\n272\t    this.productManager.addToInventory('biscuit', 6, 1);\n273\t    this.productManager.addToInventory('candy', 10, 1);\n274\t    this.productManager.addToInventory('bento_chicken', 4, 1);\n275\t    this.productManager.addToInventory('bento_veg', 4, 1);\n276\t    this.productManager.addToInventory('tissue', 5, 1);\n277\t    this.productManager.addToInventory('battery', 3, 1);\n278\t\n279\t    this.productManager.stockShelf('shelf_1', 'chips', 5);\n280\t    this.productManager.stockShelf('shelf_2', 'cola', 5);\n281\t    this.productManager.stockShelf('shelf_3', 'tissue', 5);\n282\t    this.productManager.stockShelf('fridge_1', 'water', 5);\n283\t    this.productManager.stockShelf('fridge_2', 'bento_chicken', 3);\n284\t  }\n285\t\n286\t  private applyUpgrades(): void {\n287\t    // M3 UpgradeManager effects\n288\t    this.renderer.lighting.setLightBoost(this.upgradeManager.getLightBoost());\n289\t\n290\t    if (this.upgradeManager.isPurchased('register_upgrade')) {\n291\t      this.registers.forEach(r => r.applySpeedUpgrade(0.3));\n292\t    }\n293\t    if (this.upgradeManager.isPurchased('warehouse_shelf')) {\n294\t      this.productManager.upgradeStorage(0.5);\n295\t    }\n296\t\n297\t    // Also apply economy system upgrades for backward compat\n298\t    if (this.economy.hasUpgrade('register_upgrade')) {\n299\t      this.registers.forEach(r => r.applySpeedUpgrade(0.3));\n300\t    }\n301\t    if (this.economy.hasUpgrade('warehouse_shelf')) {\n302\t      this.productManager.upgradeStorage(0.5);\n303\t    }\n304\t    if (this.economy.hasUpgrade('bright_lights')) {\n305\t      for (const light of this.state.lights) {\n306\t        light.intensity = Math.min(1, light.intensity * 1.5);\n307\t        light.radius *= 1.3;\n308\t      }\n309\t    }\n310\t  }\n311\t\n312\t  private setupPanelInput(): void {\n313\t    window.addEventListener('keydown', (e) => {\n314\t      // Dismiss day summary on any key\n315\t      if (this.daySummary.isVisible) {\n316\t        this.daySummary.dismiss();\n317\t        e.preventDefault();\n318\t        return;\n319\t      }\n320\t\n321\t      if (e.key === 'Escape') {\n322\t        if (this.state.activePanel !== UIPanel.NONE) {\n323\t          this.state.activePanel = UIPanel.NONE;\n324\t          this.shelfInteraction.close();\n325\t          e.preventDefault();\n326\t        }\n327\t      }\n328\t      if (e.key === 'i' || e.key === 'I') {\n329\t        this.togglePanel(UIPanel.INVENTORY);\n330\t        e.preventDefault();\n331\t      }\n332\t      if (e.key === 'p' || e.key === 'P') {\n333\t        this.togglePanel(UIPanel.PRICING);\n334\t        e.preventDefault();\n335\t      }\n336\t      if (e.key === 'u' || e.key === 'U') {\n337\t        this.togglePanel(UIPanel.SHOP);\n338\t        e.preventDefault();\n339\t      }\n340\t      if (e.key === 'o' || e.key === 'O') {\n341\t        this.togglePanel(UIPanel.SUPPLIER);\n342\t        e.preventDefault();\n343\t      }\n344\t    });\n345\t  }\n346\t\n347\t  private togglePanel(panel: UIPanel): void {\n348\t    this.state.activePanel = this.state.activePanel === panel ? UIPanel.NONE : panel;\n349\t    if (this.state.activePanel === UIPanel.NONE) {\n350\t      this.shelfInteraction.close();\n351\t    }\n352\t  }\n353\t\n354\t  private createInteractables(): Interactable[] {\n355\t    const S = TILE_SIZE;\n356\t    return [\n357\t      { id: 'register_1', type: 'register', x: 19 * S, y: 3 * S, width: S, height: S, label: '收银台', active: true },\n358\t      { id: 'register_2', type: 'register', x: 21 * S, y: 3 * S, width: S, height: S, label: '收银台', active: true },\n359\t      { id: 'shelf_1', type: 'shelf', x: 3 * S, y: 5 * S, width: 3 * S, height: S, label: '零食货架', active: true },\n360\t      { id: 'shelf_2', type: 'shelf', x: 7 * S, y: 5 * S, width: 3 * S, height: S, label: '饮料货架', active: true },\n361\t      { id: 'shelf_3', type: 'shelf', x: 11 * S, y: 5 * S, width: 3 * S, height: S, label: '日用品', active: true },\n362\t      { id: 'shelf_4', type: 'shelf', x: 17 * S, y: 5 * S, width: 3 * S, height: S, label: '烟酒柜', active: true },\n363\t      { id: 'shelf_5', type: 'shelf', x: 21 * S, y: 5 * S, width: 3 * S, height: S, label: '杂志架', active: true },\n364\t      { id: 'fridge_1', type: 'fridge', x: 3 * S, y: 9 * S, width: 3 * S, height: S, label: '冷饮冰柜', active: true },\n365\t      { id: 'fridge_2', type: 'fridge', x: 7 * S, y: 9 * S, width: 3 * S, height: S, label: '冷冻食品', active: true },\n366\t      { id: 'door_front', type: 'door', x: 14 * S, y: 0, width: 2 * S, height: S, label: '前门', active: true },\n367\t      { id: 'door_back', type: 'door', x: 9 * S, y: 24 * S, width: 2 * S, height: S, label: '后门', active: true },\n368\t      { id: 'door_warehouse', type: 'door', x: 14 * S, y: 11 * S, width: 2 * S, height: S, label: '仓库门', active: true },\n369\t      { id: 'note_safe', type: 'note', x: 4 * S, y: 20 * S, width: S, height: S, label: '保险柜', active: true },\n370\t    ];\n371\t  }\n372\t\n373\t  private createLights(): LightSource[] {\n374\t    const S = TILE_SIZE;\n375\t    return [\n376\t      { x: 15 * S, y: 3 * S, radius: 200, color: '#fff5e0', intensity: 0.8, flicker: false, flickerSpeed: 0 },\n377\t      { x: 8 * S, y: 6 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n378\t      { x: 22 * S, y: 6 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n379\t      { x: 8 * S, y: 8 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n380\t      { x: 15 * S, y: 10 * S, radius: 150, color: '#fff5e0', intensity: 0.6, flicker: false, flickerSpeed: 0 },\n381\t      { x: 12 * S, y: 14 * S, radius: 120, color: '#e0d0b0', intensity: 0.5, flicker: true, flickerSpeed: 3.5 },\n382\t      { x: 22 * S, y: 20 * S, radius: 100, color: '#ffe8c0', intensity: 0.4, flicker: false, flickerSpeed: 0 },\n383\t      { x: 20 * S, y: 3 * S, radius: 80, color: '#ffffff', intensity: 0.6, flicker: false, flickerSpeed: 0 },\n384\t    ];\n385\t  }\n386\t\n387\t  start(): void {\n388\t    if (this.running) return;\n389\t    this.running = true;\n390\t    this.lastFrameTime = performance.now();\n391\t    this.loop(this.lastFrameTime);\n392\t    startAutoSave(\n393\t      () => this.state,\n394\t      () => ({\n395\t        pm: this.productManager.getSaveData(),\n396\t        eco: this.economy.getSaveData(),\n397\t        prc: this.pricing.getSaveData(),\n398\t        cust: this.customerManager.getSaveData(),\n399\t        regs: this.registers.map(r => r.getSaveData()),\n400\t      }),\n401\t    );\n402\t    this.saveManager.startAutoSave(() => this.state);\n403\t  }\n404\t\n405\t  stop(): void {\n406\t    this.running = false;\n407\t    if (this.animFrameId) cancelAnimationFrame(this.animFrameId);\n408\t    stopAutoSave();\n409\t    this.saveManager.save(this.state);\n410\t  }\n411\t\n412\t  private loop = (now: number): void => {\n413\t    if (!this.running) return;\n414\t\n415\t    const dt = Math.min(now - this.lastFrameTime, 50);\n416\t    this.lastFrameTime = now;\n417\t\n418\t    this.state.totalPlaytime += dt / 1000;\n419\t\n420\t    // M3: Use DayCycle for time management\n421\t    const prevDay = this.state.day;\n422\t    this.dayCycle.update(dt);\n423\t    this.state.day = this.dayCycle.currentDay;\n424\t    this.state.timeOfDay = this.dayCycle.currentTime;\n425\t    this.state.phase = this.dayCycle.currentPhase;\n426\t    this.state.player.day = this.state.day;\n427\t\n428\t    // Update player (skip if panel is open)\n429\t    if (this.state.activePanel === UIPanel.NONE) {\n430\t      this.player.update(dt, this.map);\n431\t    }\n432\t\n433\t    // Handle interaction\n434\t    if (this.player.consumeInteract()) {\n435\t      this.handleInteraction();\n436\t    }\n437\t\n438\t    // Update M2 systems\n439\t    this.updateManagementSystems(dt, now);\n440\t\n441\t    // Update M3 day summary\n442\t    this.daySummary.update(dt);\n443\t\n444\t    // M4: Update horror events\n445\t    const horrorVisuals = this.horrorManager.update(dt, this.state.day, this.state.phase, this.state.timeOfDay, this.state.player.sanity);\n446\t\n447\t    // M5: Update NPCs and jump scares\n448\t    this.npcManager.update(dt, this.state.day, this.state.timeOfDay, this.player.x, this.player.y, this.state.player.sanity, this.state.fearLevel);\n449\t    const scareVisuals = this.jumpScareManager.update(dt, this.state.day, this.state.phase, this.state.player.sanity);\n450\t\n451\t    // M6: Update narrative systems\n452\t    this.storyManager.update(this.state.day);\n453\t    this.radioManager.update(dt, this.state.day, this.state.timeOfDay);\n454\t    this.noteManager.update(this.state.day);\n455\t    this.endingSystem.evaluate(this.state.day);\n456\t    this.syncNarrativeState();\n457\t\n458\t    // M7: Danger phase heartbeat\n459\t    if (this.state.phase === GamePhase.DANGER && Math.random() < dt / 3000) {\n460\t      this.audioManager.playHorrorHeartbeat(this.state.fearLevel > 0.6);\n461\t    }\n462\t\n463\t    // Update camera\n464\t    this.renderer.camera.follow(this.player.x + 16, this.player.y + 16);\n465\t\n466\t    // Update shelf interaction messages\n467\t    this.shelfInteraction.update(dt);\n468\t\n469\t    // Render\n470\t    this.renderer.render(this.map, this.player, this.state, now, {\n471\t      customers: this.activeCustomers,\n472\t      productManager: this.productManager,\n473\t      shelfInteraction: this.shelfInteraction,\n474\t      registers: this.registers,\n475\t      economy: this.economy,\n476\t      pricing: this.pricing,\n477\t      lastTransaction: this.lastTransactionNotification,\n478\t      daySummary: this.daySummary,\n479\t      upgradeManager: this.upgradeManager,\n480\t      horrorVisuals: horrorVisuals,\n481\t      scareVisuals: scareVisuals,\n482\t      activeNPCs: this.npcManager.getActiveNPCs(),\n483\t    });\n484\t\n485\t    this.animFrameId = requestAnimationFrame(this.loop);\n486\t  };\n487\t\n488\t  private updateManagementSystems(dt: number, now: number): void {\n489\t    // Process pending orders\n490\t    const fulfilled = this.productManager.processPendingOrders(this.state.day);\n491\t    if (fulfilled.length > 0) {\n492\t      for (const order of fulfilled) {\n493\t        const product = this.productManager.getProduct(order.productId);\n494\t        this.addNotification(`到货: ${product?.name ?? order.productId} x${order.quantity}`);\n495\t      }\n496\t    }\n497\t\n498\t    // Expire products\n499\t    const expired = this.productManager.expireProducts(this.state.day);\n500\t    if (expired.length > 0) {\n501\t      for (const pid of expired) {\n502\t        const product = this.productManager.getProduct(pid);\n503\t        this.addNotification(`过期: ${product?.name ?? pid}`);\n504\t      }\n505\t    }\n506\t\n507\t    // Update customers\n508\t    this.activeCustomers = this.customerManager.update(dt, this.state.timeOfDay, this.state.day, this.productManager);\n509\t\n510\t    // Update demand\n511\t    this.pricing.updateDemand(this.state.timeOfDay);\n512\t\n513\t    // Update registers\n514\t    for (const register of this.registers) {\n515\t      const txn = register.update(dt);\n516\t      if (txn) {\n517\t        this.economy.addRevenue(txn.total);\n518\t        this.state.dailyRevenue += txn.total;\n519\t        this.lastTransactionNotification = `交易完成: ¥${txn.total.toFixed(2)}`;\n520\t        this.addNotification(this.lastTransactionNotification);\n521\t        this.audioManager.playTransaction();\n522\t\n523\t        if (txn.isAnomalous) {\n524\t          this.addNotification('⚠ 收银机出现异常...');\n525\t          this.state.player.sanity = Math.max(0, this.state.player.sanity - 5);\n526\t        }\n527\t\n528\t        for (const item of txn.items) {\n529\t          this.pricing.recordSale(item.productId);\n530\t        }\n531\t      }\n532\t\n533\t      if (register.canAcceptCustomer()) {\n534\t        const waiting = this.customerManager.getFirstWaiting();\n535\t        if (waiting) {\n536\t          register.startCheckout(waiting, this.productManager, this.pricing);\n537\t        }\n538\t      }\n539\t    }\n540\t\n541\t    // Sync economy money with game state\n542\t    this.state.money = this.economy.getMoney();\n543\t    this.state.debt = this.economy.debt;\n544\t  }\n545\t\n546\t  private handleInteraction(): void {\n547\t    if (this.state.activePanel !== UIPanel.NONE) {\n548\t      this.state.activePanel = UIPanel.NONE;\n549\t      this.shelfInteraction.close();\n550\t      return;\n551\t    }\n552\t\n553\t    const facing = this.player.getFacingTile();\n554\t\n555\t    const obj = this.state.interactables.find(o => {\n556\t      const oGX = Math.floor(o.x / TILE_SIZE);\n557\t      const oGY = Math.floor(o.y / TILE_SIZE);\n558\t      const oGW = Math.ceil(o.width / TILE_SIZE);\n559\t      const oGH = Math.ceil(o.height / TILE_SIZE);\n560\t      return facing.gx >= oGX && facing.gx < oGX + oGW && facing.gy >= oGY && facing.gy < oGY + oGH;\n561\t    });\n562\t\n563\t    if (!obj) return;\n564\t\n565\t    switch (obj.type) {\n566\t      case 'shelf':\n567\t      case 'fridge': {\n568\t        const info = this.shelfInteraction.interactWithShelf(obj.id, this.state.interactables, this.productManager);\n569\t        if (info) {\n570\t          this.state.activePanel = UIPanel.SHELF;\n571\t          this.onNotification?.(`货架: ${info.label} — ${info.productName ?? '空'} (${info.quantity}/${info.maxQuantity})`);\n572\t        }\n573\t        break;\n574\t      }\n575\t      case 'register': {\n576\t        const register = this.registers.find(r => r.registerId === obj.id);\n577\t        const waiting = this.customerManager.getFirstWaiting();\n578\t        if (register && register.canAcceptCustomer() && waiting) {\n579\t          register.startCheckout(waiting, this.productManager, this.pricing);\n580\t          this.onNotification?.('开始收银...');\n581\t        } else if (register && !register.canAcceptCustomer()) {\n582\t          this.onNotification?.('收银中...');\n583\t        } else {\n584\t          this.onNotification?.('收银台 — 没有顾客等待');\n585\t        }\n586\t        break;\n587\t      }\n588\t      case 'door':\n589\t        this.onNotification?.(`交互: ${obj.label}`);\n590\t        break;\n591\t      default:\n592\t        this.onNotification?.(`交互: ${obj.label}`);\n593\t    }\n594\t  }\n595\t\n596\t  private onNewDay(): void {\n597\t    const report = this.economy.endDay();\n598\t    this.audioManager.playNewDay();\n599\t\n600\t    // M4: Reset horror system for new day\n601\t    this.horrorManager.resetDaily();\n602\t    this.state.fearLevel = Math.max(0, this.state.fearLevel - 0.3);\n603\t\n604\t    // M5: Reset NPC and jump scare systems\n605\t    this.npcManager.resetDaily();\n606\t    this.jumpScareManager.resetDaily();\n607\t\n608\t    // M6: Auto-discover clues and update narrative\n609\t    const newClues = this.clueManager.autoDiscoverForDay(report.day);\n610\t    for (const clue of newClues) {\n611\t      this.addNotification(`🔍 发现线索: ${clue.name}`);\n612\t    }\n613\t    this.storyManager.update(report.day);\n614\t\n615\t    // M6: Check for forced ending on Day 30\n616\t    if (report.day >= 30) {\n617\t      const ending = this.endingSystem.forceEnding(report.day);\n618\t      this.addNotification(`🏁 ${ending.title}`);\n619\t    }\n620\t\n621\t    // M3: Generate day summary with display\n622\t    this.daySummary.generateSummary(report, this.customerManager);\n623\t\n624\t    // Create day summary record\n625\t    const stats = this.customerManager.getStats();\n626\t    this.state.daySummaries.push({\n627\t      day: report.day,\n628\t      revenue: report.revenue,\n629\t      expenses: report.expenses,\n630\t      customersServed: stats.served,\n631\t      customersLost: stats.lost,\n632\t      debtRemaining: report.debtRemaining,\n633\t    });\n634\t\n635\t    this.state.dailyRevenue = 0;\n636\t    this.state.dailyExpenses = 0;\n637\t    this.customerManager.resetDailyStats();\n638\t    this.pricing.resetDailyVelocity();\n639\t\n640\t    this.addNotification(`Day ${report.day} 结算: 收入¥${report.revenue} 支出¥${report.expenses} 债务¥${report.debtRemaining}`);\n641\t\n642\t    // M3: Auto-save after day end\n643\t    this.saveManager.save(this.state);\n644\t\n645\t    // Check game over\n646\t    const gameOver = this.economy.isGameOver();\n647\t    if (gameOver.over) {\n648\t      this.addNotification(`游戏结束: ${gameOver.reason}`);\n649\t      this.audioManager.playGameOver();\n650\t    }\n651\t  }\n652\t\n653\t  private addNotification(text: string): void {\n654\t    this.state.notifications.push(text);\n655\t    if (this.state.notifications.length > 10) {\n656\t      this.state.notifications.shift();\n657\t    }\n658\t    this.onNotification?.(text);\n659\t  }\n660\t\n661\t  // Public API for UI interaction\n662\t  stockShelf(shelfId: string, productId: string, quantity: number): void {\n663\t    this.shelfInteraction.stockShelf(shelfId, productId, quantity, this.productManager);\n664\t    this.audioManager.playShelfPlace();\n665\t  }\n666\t\n667\t  unstockShelf(shelfId: string, quantity: number): void {\n668\t    this.shelfInteraction.unstockShelf(shelfId, quantity, this.productManager);\n669\t  }\n670\t\n671\t  orderProduct(productId: string, quantity: number, supplierId: string): boolean {\n672\t    const order = this.productManager.orderProduct(productId, quantity, supplierId, this.state.day);\n673\t    if (order) {\n674\t      this.economy.addPurchaseCost(order.totalCost);\n675\t      this.state.money = this.economy.getMoney();\n676\t      const product = this.productManager.getProduct(productId);\n677\t      this.addNotification(`下单: ${product?.name} x${quantity} — ¥${order.totalCost}`);\n678\t      return true;\n679\t    }\n680\t    return false;\n681\t  }\n682\t\n683\t  purchaseUpgrade(upgradeId: string): { success: boolean; message: string } {\n684\t    const result = this.economy.purchaseUpgrade(upgradeId);\n685\t    if (result.success) {\n686\t      this.state.money = this.economy.getMoney();\n687\t      this.applyUpgrades();\n688\t      this.addNotification(result.message);\n689\t    }\n690\t    return result;\n691\t  }\n692\t\n693\t  purchaseUpgradeM3(upgradeId: string): { success: boolean; message: string } {\n694\t    const result = this.upgradeManager.purchase(upgradeId, this.state.money);\n695\t    if (result.success) {\n696\t      this.economy.addExpense(result.cost);\n697\t      this.state.money = this.economy.getMoney();\n698\t      this.applyUpgrades();\n699\t      this.addNotification(result.message);\n700\t    }\n701\t    return { success: result.success, message: result.message };\n702\t  }\n703\t\n704\t  setProductPrice(productId: string, price: number): boolean {\n705\t    return this.pricing.setPrice(productId, price);\n706\t  }\n707\t\n708\t  centerCamera(): void {\n709\t    this.renderer.camera.snapTo(this.player.x + 16, this.player.y + 16);\n710\t  }\n711\t\n712\t  setTimeSpeed(speed: number): void {\n713\t    this.state.timeSpeed = speed;\n714\t  }\n715\t\n716\t  // M4: Horror audio helpers\n717\t  private triggerHorrorAudio(type: HorrorEventType): void {\n718\t    switch (type) {\n719\t      case HorrorEventType.LIGHT_FLICKER:\n720\t        this.audioManager.playHorrorFlicker();\n721\t        break;\n722\t      case HorrorEventType.FRIDGE_NOISE:\n723\t        this.audioManager.playHorrorJumpScare();\n724\t        break;\n725\t      case HorrorEventType.WHISPER:\n726\t        this.audioManager.playHorrorWhisper();\n727\t        break;\n728\t      case HorrorEventType.DOOR_AUTO_OPEN:\n729\t        this.audioManager.playHorrorDoorCreak();\n730\t        break;\n731\t      case HorrorEventType.GHOST_CUSTOMER:\n732\t      case HorrorEventType.DUPLICATE_CUSTOMER:\n733\t      case HorrorEventType.NONPAYING_CUSTOMER:\n734\t        this.audioManager.playHorrorAmbientDrone();\n735\t        break;\n736\t      case HorrorEventType.STORE_MUTATE:\n737\t      case HorrorEventType.TIME_GLITCH:\n738\t      case HorrorEventType.MIRROR_STORE:\n739\t      case HorrorEventType.HE_COMES:\n740\t      case HorrorEventType.FINAL_CHOICE:\n741\t        this.audioManager.playHorrorJumpScare();\n742\t        break;\n743\t      case HorrorEventType.STALKER:\n744\t      case HorrorEventType.CCTV_DOUBLE:\n745\t      case HorrorEventType.CORRIDOR_EXTEND:\n746\t        this.audioManager.playHorrorAmbientDrone();\n747\t        break;\n748\t      case HorrorEventType.RADIO_VOICE:\n749\t        this.audioManager.playHorrorWhisper();\n750\t        break;\n751\t      default:\n752\t        this.audioManager.playHorrorAmbientDrone();\n753\t        break;\n754\t    }\n755\t  }\n756\t\n757\t  private switchBgmForPhase(phase: GamePhase): void {\n758\t    if (phase === GamePhase.DAYTIME) {\n759\t      this.audioManager.playBgm('daytime');\n760\t    } else if (phase === GamePhase.NIGHT || phase === GamePhase.NIGHT_TRANSITION) {\n761\t      this.audioManager.playBgm('night');\n762\t    } else if (phase === GamePhase.DANGER) {\n763\t      this.audioManager.playBgm('danger');\n764\t    } else {\n765\t      this.audioManager.stopBgm();\n766\t    }\n767\t  }\n768\t\n769\t  // M6: Sync narrative state to game state\n770\t  private syncNarrativeState(): void {\n771\t    this.state.storyLayer = this.storyManager.currentLayer;\n772\t    this.state.cluesFound = this.clueManager.foundCount;\n773\t    this.state.choicesMade = this.narrativeChoices.madeCount;\n774\t    if (this.endingSystem.ending) {\n775\t      this.state.endingType = this.endingSystem.ending.type;\n776\t    }\n777\t  }\n778\t\n779\t  // M6: Public API for narrative interaction\n780\t\n781\t  /** Try to play the next available radio segment */\n782\t  playRadio(): boolean {\n783\t    const seg = this.radioManager.tryPlay(this.state.day, this.state.timeOfDay);\n784\t    return seg !== null;\n785\t  }\n786\t\n787\t  /** Read a discovered note */\n788\t  readNote(noteId: string): boolean {\n789\t    const note = this.noteManager.readNote(noteId, this.state.day);\n790\t    return note !== null;\n791\t  }\n792\t\n793\t  /** Find notes at current player location */\n794\t  searchLocation(location: string): string | null {\n795\t    const note = this.noteManager.findNoteAtLocation(location, this.state.day);\n796\t    return note?.id ?? null;\n797\t  }\n798\t\n799\t  /** Get available narrative choices */\n800\t  getAvailableChoices(): Array<{ id: string; title: string; description: string; options: Array<{ id: string; text: string }> }> {\n801\t    const choices = this.narrativeChoices.getAllAvailable(this.state.day, this.state.phase);\n802\t    return choices.map(c => ({\n803\t      id: c.id,\n804\t      title: c.title,\n805\t      description: c.description,\n806\t      options: c.options.map(o => ({ id: o.id, text: o.text })),\n807\t    }));\n808\t  }\n809\t\n810\t  /** Make a narrative choice */\n811\t  makeNarrativeChoice(choiceId: string, optionId: string): boolean {\n812\t    return this.narrativeChoices.makeChoice(choiceId, optionId, this.state.day);\n813\t  }\n814\t\n815\t  /** Get story summary for HUD */\n816\t  getStorySummary(): string {\n817\t    return this.storyManager.getSummary();\n818\t  }\n819\t\n820\t  /** Get ending progress for HUD */\n821\t  getEndingProgress(): Array<{ title: string; progress: number; hint: string }> {\n822\t    return this.endingSystem.getEndingProgress();\n823\t  }\n824\t\n825\t  /** Get found clues list */\n826\t  getFoundClues(): Array<{ name: string; description: string; acquired: boolean }> {\n827\t    return this.clueManager.getAllFound().map(c => ({\n828\t      name: c.name,\n829\t      description: c.description,\n830\t      acquired: c.acquired,\n831\t    }));\n832\t  }\n833\t}\n834\t"}]},"parent_tool_use_id":"call_37a82845ea3e4d0c88fbf309","session_id":"561a5118-a4d0-464b-8f32-001690e29cb0","uuid":"ebaede9f-4825-4080-8ec0-bec7fb2532ca","timestamp":"2026-05-23T10:14:47.018Z","subagent_type":"general-purpose","task_description":"Read horror sim source"}
