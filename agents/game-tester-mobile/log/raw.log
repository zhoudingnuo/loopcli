{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_1beebdca4dd24e28ae236d7c","type":"tool_result","content":"1\t/**\n2\t * Mobile Compatibility Tests for 消消消大作战 (Match-3)\n3\t * Tests: touch event handling, canvas resize, tt.* API integration, navigation\n4\t */\n5\t\n6\tconst fs = require('fs');\n7\tconst path = require('path');\n8\t\n9\tconst SRC = path.resolve(__dirname, '../src/js');\n10\tconst HTML = fs.readFileSync(path.resolve(__dirname, '../index.html'), 'utf-8');\n11\t\n12\tfunction readSrc(name) {\n13\t  return fs.readFileSync(path.join(SRC, name), 'utf-8');\n14\t}\n15\t\n16\t// ============================================================\n17\t// 1. Touch Event Tests\n18\t// ============================================================\n19\tdescribe('Touch Event Handling', () => {\n20\t  const inputSrc = readSrc('InputHandler.js');\n21\t  const htmlSrc = HTML;\n22\t\n23\t  test('InputHandler binds touchstart, touchmove, touchend events', () => {\n24\t    expect(inputSrc).toMatch(/addEventListener\\s*\\(\\s*['\"]touchstart['\"]/);\n25\t    expect(inputSrc).toMatch(/addEventListener\\s*\\(\\s*['\"]touchmove['\"]/);\n26\t    expect(inputSrc).toMatch(/addEventListener\\s*\\(\\s*['\"]touchend['\"]/);\n27\t  });\n28\t\n29\t  test('Touch events use passive: false', () => {\n30\t    // Count occurrences of passive: false\n31\t    const matches = inputSrc.match(/passive:\\s*false/g) || [];\n32\t    expect(matches.length).toBeGreaterThanOrEqual(3);\n33\t  });\n34\t\n35\t  test('Touch handlers use e.touches[0] / e.changedTouches[0]', () => {\n36\t    expect(inputSrc).toMatch(/e\\.touches\\[0\\]/);\n37\t    expect(inputSrc).toMatch(/e\\.changedTouches\\[0\\]/);\n38\t  });\n39\t\n40\t  test('InputHandler has active flag to skip touch when nav is showing', () => {\n41\t    expect(inputSrc).toMatch(/this\\.active/);\n42\t    expect(inputSrc).toMatch(/if\\s*\\(!this\\.active\\)\\s*return/);\n43\t  });\n44\t\n45\t  test('Navigation screens have touch handling via touchend listener', () => {\n46\t    expect(htmlSrc).toMatch(/addEventListener\\s*\\(\\s*['\"]touchend['\"]/);\n47\t    expect(htmlSrc).toMatch(/game\\.nav\\.handleClick/);\n48\t  });\n49\t\n50\t  test('Navigation.goTo toggles InputHandler.active', () => {\n51\t    const navSrc = readSrc('Navigation.js');\n52\t    expect(navSrc).toMatch(/this\\.game\\.input\\.active/);\n53\t  });\n54\t\n55\t  test('Back-to-map button works via touchend', () => {\n56\t    expect(htmlSrc).toMatch(/backX.*backY.*goTo\\s*\\(\\s*['\"]map['\"]\\)/s);\n57\t  });\n58\t});\n59\t\n60\t// ============================================================\n61\t// 2. Canvas Resize / Screen Adaptation Tests\n62\t// ============================================================\n63\tdescribe('Canvas Resize Adaptation', () => {\n64\t  const rendererSrc = readSrc('Renderer.js');\n65\t  const htmlSrc = HTML;\n66\t\n67\t  test('Renderer.resize() handles devicePixelRatio', () => {\n68\t    expect(rendererSrc).toMatch(/devicePixelRatio/);\n69\t    expect(rendererSrc).toMatch(/dpr/);\n70\t  });\n71\t\n72\t  test('Canvas dimensions use dpr scaling', () => {\n73\t    expect(rendererSrc).toMatch(/canvas\\.width\\s*=\\s*w\\s*\\*\\s*dpr/);\n74\t    expect(rendererSrc).toMatch(/canvas\\.height\\s*=\\s*h\\s*\\*\\s*dpr/);\n75\t  });\n76\t\n77\t  test('CSS dimensions set in logical pixels', () => {\n78\t    expect(rendererSrc).toMatch(/canvas\\.style\\.width\\s*=\\s*w/);\n79\t    expect(rendererSrc).toMatch(/canvas\\.style\\.height\\s*=\\s*h/);\n80\t  });\n81\t\n82\t  test('Context scaled by dpr for high-DPI rendering', () => {\n83\t    expect(rendererSrc).toMatch(/ctx\\.scale\\s*\\(\\s*dpr\\s*,\\s*dpr\\s*\\)/);\n84\t  });\n85\t\n86\t  test('Tile size calculated relative to screen dimensions', () => {\n87\t    expect(rendererSrc).toMatch(/tileSize\\s*=.*Math\\.floor.*Math\\.min/);\n88\t  });\n89\t\n90\t  test('Board centered with dynamic boardX offset', () => {\n91\t    expect(rendererSrc).toMatch(/boardX\\s*=.*\\(.*w.*-.*tileSize/);\n92\t  });\n93\t\n94\t  test('Window resize and orientationchange handled', () => {\n95\t    expect(htmlSrc).toMatch(/addEventListener\\s*\\(\\s*['\"]resize['\"]/);\n96\t    expect(htmlSrc).toMatch(/addEventListener\\s*\\(\\s*['\"]orientationchange['\"]/);\n97\t  });\n98\t\n99\t  test('InputHandler layout updated on resize', () => {\n100\t    expect(htmlSrc).toMatch(/game\\.input\\.updateLayout/);\n101\t  });\n102\t});\n103\t\n104\t// ============================================================\n105\t// 3. Douyin API (tt.*) Integration Tests\n106\t// ============================================================\n107\tdescribe('Douyin tt.* API Integration', () => {\n108\t  const adSrc = readSrc('AdManager.js');\n109\t  const socialSrc = readSrc('SocialSystem.js');\n110\t  const analyticsSrc = readSrc('Analytics.js');\n111\t\n112\t  test('AdManager detects Douyin environment', () => {\n113\t    expect(adSrc).toMatch(/typeof\\s+tt\\s*!==?\\s*['\"]undefined['\"]/);\n114\t  });\n115\t\n116\t  test('AdManager creates rewarded video ad via tt API', () => {\n117\t    expect(adSrc).toMatch(/tt\\.createRewardedVideoAd/);\n118\t  });\n119\t\n120\t  test('AdManager creates interstitial ad via tt API', () => {\n121\t    expect(adSrc).toMatch(/tt\\.createInterstitialAd/);\n122\t  });\n123\t\n124\t  test('AdManager handles ad load/error/close events', () => {\n125\t    expect(adSrc).toMatch(/\\.onLoad\\s*\\(/);\n126\t    expect(adSrc).toMatch(/\\.onError\\s*\\(/);\n127\t    expect(adSrc).toMatch(/\\.onClose\\s*\\(/);\n128\t  });\n129\t\n130\t  test('AdManager has stub fallback for development', () => {\n131\t    expect(adSrc).toMatch(/_showStubAd|stub/i);\n132\t  });\n133\t\n134\t  test('SocialSystem uses tt.shareAppMessage for sharing', () => {\n135\t    expect(socialSrc).toMatch(/tt\\.shareAppMessage/);\n136\t  });\n137\t\n138\t  test('SocialSystem has fallback when tt is unavailable', () => {\n139\t    expect(socialSrc).toMatch(/typeof\\s+tt\\s*!==?\\s*['\"]undefined['\"]/);\n140\t  });\n141\t\n142\t  test('Analytics uploads events with tt.request or fetch fallback', () => {\n143\t    expect(analyticsSrc).toMatch(/tt\\.request|fetch/);\n144\t  });\n145\t});\n146\t\n147\t// ============================================================\n148\t// 4. Viewport & Meta Tag Tests\n149\t// ============================================================\n150\tdescribe('Viewport Configuration', () => {\n151\t  const htmlSrc = HTML;\n152\t\n153\t  test('Viewport meta prevents user scaling', () => {\n154\t    expect(htmlSrc).toMatch(/user-scalable\\s*=\\s*no/);\n155\t    expect(htmlSrc).toMatch(/maximum-scale\\s*=\\s*1\\.0/);\n156\t  });\n157\t\n158\t  test('Portrait orientation enforced', () => {\n159\t    expect(htmlSrc).toMatch(/screen-orientation.*portrait|x5-orientation.*portrait/);\n160\t  });\n161\t\n162\t  test('touch-action: none prevents browser gesture interference', () => {\n163\t    expect(htmlSrc).toMatch(/touch-action\\s*:\\s*none/);\n164\t  });\n165\t\n166\t  test('User selection disabled', () => {\n167\t    expect(htmlSrc).toMatch(/user-select\\s*:\\s*none/);\n168\t  });\n169\t\n170\t  test('Phone number detection disabled', () => {\n171\t    expect(htmlSrc).toMatch(/format-detection.*telephone\\s*=\\s*no/);\n172\t  });\n173\t\n174\t  test('Apple mobile web app capable set', () => {\n175\t    expect(htmlSrc).toMatch(/apple-mobile-web-app-capable/);\n176\t  });\n177\t});\n178\t\n179\t// ============================================================\n180\t// 5. Input Coordinates Tests\n181\t// ============================================================\n182\tdescribe('Input Coordinate Handling', () => {\n183\t  const inputSrc = readSrc('InputHandler.js');\n184\t\n185\t  test('Screen-to-grid conversion handles bounds checking', () => {\n186\t    expect(inputSrc).toMatch(/row\\s*>=\\s*0.*row\\s*<.*board\\.size/);\n187\t    expect(inputSrc).toMatch(/col\\s*>=\\s*0.*col\\s*<.*board\\.size/);\n188\t  });\n189\t\n190\t  test('Swipe minimum distance threshold prevents accidental taps', () => {\n191\t    expect(inputSrc).toMatch(/tileSize.*0\\.2|0\\.2.*tileSize/);\n192\t  });\n193\t\n194\t  test('Swipe direction detection handles both axes', () => {\n195\t    expect(inputSrc).toMatch(/Math\\.abs\\s*\\(\\s*dx\\s*\\)\\s*>\\s*Math\\.abs\\s*\\(\\s*dy\\s*\\)/);\n196\t  });\n197\t\n198\t  test('Tap vs swipe distinction', () => {\n199\t    expect(inputSrc).toMatch(/onTap/);\n200\t  });\n201\t\n202\t  test('Input disabled during non-IDLE states', () => {\n203\t    const gameSrc = readSrc('Game.js');\n204\t    expect(gameSrc).toMatch(/input\\.enabled\\s*=\\s*this\\.state/);\n205\t  });\n206\t});\n207\t"}]},"parent_tool_use_id":null,"session_id":"7463fb62-2e03-4edd-abad-466ff792dff1","uuid":"04b7bc2a-0ee8-4dc1-b61f-98b0a1abebf0","timestamp":"2026-05-23T10:38:29.284Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-match3/test/mobile-compat.test.js","content":"/**\n * Mobile Compatibility Tests for 消消消大作战 (Match-3)\n * Tests: touch event handling, canvas resize, tt.* API integration, navigation\n */\n\nconst fs = require('fs');\nconst path = require('path');\n\nconst SRC = path.resolve(__dirname, '../src/js');\nconst HTML = fs.readFileSync(path.resolve(__dirname, '../index.html'), 'utf-8');\n\nfunction readSrc(name) {\n  return fs.readFileSync(path.join(SRC, name), 'utf-8');\n}\n\n// ============================================================\n// 1. Touch Event Tests\n// ============================================================\ndescribe('Touch Event Handling', () => {\n  const inputSrc = readSrc('InputHandler.js');\n  const htmlSrc = HTML;\n\n  test('InputHandler binds touchstart, touchmove, touchend events', () => {\n    expect(inputSrc).toMatch(/addEventListener\\s*\\(\\s*['\"]touchstart['\"]/);\n    expect(inputSrc).toMatch(/addEventListener\\s*\\(\\s*['\"]touchmove['\"]/);\n    expect(inputSrc).toMatch(/addEventListener\\s*\\(\\s*['\"]touchend['\"]/);\n  });\n\n  test('Touch events use passive: false', () => {\n    // Count occurrences of passive: false\n    const matches = inputSrc.match(/passive:\\s*false/g) || [];\n    expect(matches.length).toBeGreaterThanOrEqual(3);\n  });\n\n  test('Touch handlers use e.touches[0] / e.changedTouches[0]', () => {\n    expect(inputSrc).toMatch(/e\\.touches\\[0\\]/);\n    expect(inputSrc).toMatch(/e\\.changedTouches\\[0\\]/);\n  });\n\n  test('InputHandler has active flag to skip touch when nav is showing', () => {\n    expect(inputSrc).toMatch(/this\\.active/);\n    expect(inputSrc).toMatch(/if\\s*\\(!this\\.active\\)\\s*return/);\n  });\n\n  test('Navigation screens have touch handling via touchend listener', () => {\n    expect(htmlSrc).toMatch(/addEventListener\\s*\\(\\s*['\"]touchend['\"]/);\n    expect(htmlSrc).toMatch(/game\\.nav\\.handleClick/);\n  });\n\n  test('Navigation.goTo toggles InputHandler.active', () => {\n    const navSrc = readSrc('Navigation.js');\n    expect(navSrc).toMatch(/this\\.game\\.input\\.active/);\n  });\n\n  test('Back-to-map button works via touchend', () => {\n    expect(htmlSrc).toMatch(/backX.*backY.*goTo\\s*\\(\\s*['\"]map['\"]\\)/s);\n  });\n});\n\n// ============================================================\n// 2. Canvas Resize / Screen Adaptation Tests\n// ============================================================\ndescribe('Canvas Resize Adaptation', () => {\n  const rendererSrc = readSrc('Renderer.js');\n  const htmlSrc = HTML;\n\n  test('Renderer.resize() handles devicePixelRatio', () => {\n    expect(rendererSrc).toMatch(/devicePixelRatio/);\n    expect(rendererSrc).toMatch(/dpr/);\n  });\n\n  test('Canvas dimensions use dpr scaling', () => {\n    expect(rendererSrc).toMatch(/canvas\\.width\\s*=\\s*w\\s*\\*\\s*dpr/);\n    expect(rendererSrc).toMatch(/canvas\\.height\\s*=\\s*h\\s*\\*\\s*dpr/);\n  });\n\n  test('CSS dimensions set in logical pixels', () => {\n    expect(rendererSrc).toMatch(/canvas\\.style\\.width\\s*=\\s*w/);\n    expect(rendererSrc).toMatch(/canvas\\.style\\.height\\s*=\\s*h/);\n  });\n\n  test('Context scaled by dpr for high-DPI rendering', () => {\n    expect(rendererSrc).toMatch(/ctx\\.scale\\s*\\(\\s*dpr\\s*,\\s*dpr\\s*\\)/);\n  });\n\n  test('Tile size calculated relative to screen dimensions', () => {\n    expect(rendererSrc).toMatch(/tileSize\\s*=.*Math\\.floor.*Math\\.min/);\n  });\n\n  test('Board centered with dynamic boardX offset', () => {\n    expect(rendererSrc).toMatch(/boardX\\s*=.*\\(.*w.*-.*tileSize/);\n  });\n\n  test('Window resize and orientationchange handled', () => {\n    expect(htmlSrc).toMatch(/addEventListener\\s*\\(\\s*['\"]resize['\"]/);\n    expect(htmlSrc).toMatch(/addEventListener\\s*\\(\\s*['\"]orientationchange['\"]/);\n  });\n\n  test('InputHandler layout updated on resize', () => {\n    expect(htmlSrc).toMatch(/game\\.input\\.updateLayout/);\n  });\n});\n\n// ============================================================\n// 3. Douyin API (tt.*) Integration Tests\n// ============================================================\ndescribe('Douyin tt.* API Integration', () => {\n  const adSrc = readSrc('AdManager.js');\n  const socialSrc = readSrc('SocialSystem.js');\n  const analyticsSrc = readSrc('Analytics.js');\n\n  test('AdManager detects Douyin environment', () => {\n    expect(adSrc).toMatch(/typeof\\s+tt\\s*!==?\\s*['\"]undefined['\"]/);\n  });\n\n  test('AdManager creates rewarded video ad via tt API', () => {\n    expect(adSrc).toMatch(/tt\\.createRewardedVideoAd/);\n  });\n\n  test('AdManager creates interstitial ad via tt API', () => {\n    expect(adSrc).toMatch(/tt\\.createInterstitialAd/);\n  });\n\n  test('AdManager handles ad load/error/close events', () => {\n    expect(adSrc).toMatch(/\\.onLoad\\s*\\(/);\n    expect(adSrc).toMatch(/\\.onError\\s*\\(/);\n    expect(adSrc).toMatch(/\\.onClose\\s*\\(/);\n  });\n\n  test('AdManager has stub fallback for development', () => {\n    expect(adSrc).toMatch(/_showStubAd|stub/i);\n  });\n\n  test('SocialSystem uses tt.shareAppMessage for sharing', () => {\n    expect(socialSrc).toMatch(/tt\\.shareAppMessage/);\n  });\n\n  test('SocialSystem has fallback when tt is unavailable', () => {\n    expect(socialSrc).toMatch(/typeof\\s+tt\\s*!==?\\s*['\"]undefined['\"]/);\n  });\n\n  test('Analytics uploads events with tt.request or fetch fallback', () => {\n    expect(analyticsSrc).toMatch(/tt\\.request|fetch/);\n  });\n});\n\n// ============================================================\n// 4. Viewport & Meta Tag Tests\n// ============================================================\ndescribe('Viewport Configuration', () => {\n  const htmlSrc = HTML;\n\n  test('Viewport meta prevents user scaling', () => {\n    expect(htmlSrc).toMatch(/user-scalable\\s*=\\s*no/);\n    expect(htmlSrc).toMatch(/maximum-scale\\s*=\\s*1\\.0/);\n  });\n\n  test('Portrait orientation enforced', () => {\n    expect(htmlSrc).toMatch(/screen-orientation.*portrait|x5-orientation.*portrait/);\n  });\n\n  test('touch-action: none prevents browser gesture interference', () => {\n    expect(htmlSrc).toMatch(/touch-action\\s*:\\s*none/);\n  });\n\n  test('User selection disabled', () => {\n    expect(htmlSrc).toMatch(/user-select\\s*:\\s*none/);\n  });\n\n  test('Phone number detection disabled', () => {\n    expect(htmlSrc).toMatch(/format-detection.*telephone\\s*=\\s*no/);\n  });\n\n  test('Apple mobile web app capable set', () => {\n    expect(htmlSrc).toMatch(/apple-mobile-web-app-capable/);\n  });\n});\n\n// ============================================================\n// 5. Input Coordinates Tests\n// ============================================================\ndescribe('Input Coordinate Handling', () => {\n  const inputSrc = readSrc('InputHandler.js');\n\n  test('Screen-to-grid conversion handles bounds checking', () => {\n    expect(inputSrc).toMatch(/row\\s*>=\\s*0.*row\\s*<.*board\\.size/);\n    expect(inputSrc).toMatch(/col\\s*>=\\s*0.*col\\s*<.*board\\.size/);\n  });\n\n  test('Swipe minimum distance threshold prevents accidental taps', () => {\n    expect(inputSrc).toMatch(/tileSize.*0\\.2|0\\.2.*tileSize/);\n  });\n\n  test('Swipe direction detection handles both axes', () => {\n    expect(inputSrc).toMatch(/Math\\.abs\\s*\\(\\s*dx\\s*\\)\\s*>\\s*Math\\.abs\\s*\\(\\s*dy\\s*\\)/);\n  });\n\n  test('Tap vs swipe distinction', () => {\n    expect(inputSrc).toMatch(/onTap/);\n  });\n\n  test('Input disabled during non-IDLE states', () => {\n    const gameSrc = readSrc('Game.js');\n    expect(gameSrc).toMatch(/input\\.enabled\\s*=\\s*this\\.state/);\n  });\n});\n","numLines":207,"startLine":1,"totalLines":207}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_7eecdb4c963c4431b2e1b944","type":"tool_result","content":"1\t// AdManager.js — 穿山甲SDK广告管理，支持真实SDK + stub降级\n2\t// 广告位ID配置在 ad-config.js 中，提审前替换为真实ID\n3\t\n4\tconst AD_PLACEMENTS = {\n5\t  CONTINUE: 'continue',       // 续步激励视频（关卡失败）\n6\t  BOOST: 'boost',             // 开局增益激励视频\n7\t  DOUBLE: 'double',           // 双倍结算激励视频\n8\t  INTERSTITIAL: 'interstitial', // 插屏广告\n9\t  TREASURE: 'treasure',       // 宝箱加速激励视频\n10\t  DAILY_DOUBLE: 'daily_double', // 每日签到翻倍\n11\t};\n12\t\n13\tconst AD_LIMITS = {\n14\t  REWARDED_DAILY: 12,\n15\t  INTERSTITIAL_DAILY: 6,\n16\t  COOLDOWN_MS: 60000,\n17\t  NEW_USER_FREE_LEVELS: 3,\n18\t  INTERSTITIAL_LEVEL_INTERVAL: 3,\n19\t};\n20\t\n21\tclass AdManager {\n22\t  constructor(dataManager) {\n23\t    this.dm = dataManager;\n24\t    this._initStorage();\n25\t\n26\t    // SDK detection — use config if available, otherwise auto-detect\n27\t    const config = (typeof AD_CONFIG !== 'undefined') ? AD_CONFIG : null;\n28\t    this.isDouyin = config ? !config.devMode\n29\t      : (typeof tt !== 'undefined' && typeof tt.createRewardedVideoAd === 'function');\n30\t    this.rewardedAd = null;\n31\t    this.interstitialAd = null;\n32\t    this._loadRetry = 0;\n33\t    this._maxRetry = config ? config.loadRetryCount : 2;\n34\t    this._loadTimeout = config ? config.loadTimeout : 10000;\n35\t\n36\t    if (this.isDouyin) this._initSDK();\n37\t\n38\t    // State\n39\t    this._pendingResolve = null;\n40\t    this._currentPlacement = null;\n41\t    this._showingUI = false;\n42\t  }\n43\t\n44\t  _initStorage() {\n45\t    if (!this.dm.data.adState) {\n46\t      this.dm.data.adState = {\n47\t        dailyRewarded: 0,\n48\t        dailyInterstitial: 0,\n49\t        lastShowTime: {},\n50\t        lastInterstitialLevel: 0,\n51\t        date: this._todayStr(),\n52\t        consecutiveFails: 0,\n53\t      };\n54\t      this.dm.save();\n55\t    }\n56\t    this.adState = this.dm.data.adState;\n57\t    this._resetDaily();\n58\t  }\n59\t\n60\t  _todayStr() { return new Date().toISOString().slice(0, 10); }\n61\t\n62\t  _resetDaily() {\n63\t    if (this.adState.date !== this._todayStr()) {\n64\t      this.adState.dailyRewarded = 0;\n65\t      this.adState.dailyInterstitial = 0;\n66\t      this.adState.date = this._todayStr();\n67\t      this.dm.save();\n68\t    }\n69\t  }\n70\t\n71\t  _getAdUnitId(type) {\n72\t    const config = (typeof AD_CONFIG !== 'undefined') ? AD_CONFIG : null;\n73\t    if (config && config.adUnitIds && config.adUnitIds[type]) {\n74\t      return config.adUnitIds[type];\n75\t    }\n76\t    return `adunit-placeholder-${type}`;\n77\t  }\n78\t\n79\t  _initSDK() {\n80\t    try {\n81\t      const rewardedId = this._getAdUnitId('rewarded');\n82\t      this.rewardedAd = tt.createRewardedVideoAd({ adUnitId: rewardedId });\n83\t\n84\t      this.rewardedAd.onLoad(() => {\n85\t        this._loadRetry = 0;\n86\t      });\n87\t\n88\t      this.rewardedAd.onError((err) => {\n89\t        console.warn('[AdManager] Rewarded ad error:', err);\n90\t        if (this._loadRetry < this._maxRetry) {\n91\t          this._loadRetry++;\n92\t          setTimeout(() => this.rewardedAd.load(), 1000 * this._loadRetry);\n93\t        }\n94\t      });\n95\t\n96\t      this.rewardedAd.onClose((res) => {\n97\t        if (this._pendingResolve) {\n98\t          this._pendingResolve(res && res.isEnded);\n99\t          this._pendingResolve = null;\n100\t        }\n101\t      });\n102\t\n103\t      // Pre-load rewarded ad\n104\t      this.rewardedAd.load();\n105\t\n106\t      const interstitialId = this._getAdUnitId('interstitial');\n107\t      this.interstitialAd = tt.createInterstitialAd({ adUnitId: interstitialId });\n108\t\n109\t      this.interstitialAd.onLoad(() => {});\n110\t\n111\t      this.interstitialAd.onError((err) => {\n112\t        console.warn('[AdManager] Interstitial ad error:', err);\n113\t      });\n114\t    } catch (e) {\n115\t      console.warn('[AdManager] SDK init failed, falling back to stub:', e);\n116\t      this.isDouyin = false;\n117\t    }\n118\t  }\n119\t\n120\t  // --- Frequency checks ---\n121\t  isNewUser() {\n122\t    return this.dm.unlockedLevel <= AD_LIMITS.NEW_USER_FREE_LEVELS;\n123\t  }\n124\t\n125\t  canShowRewarded(placement) {\n126\t    this._resetDaily();\n127\t    if (this.isNewUser()) return false;\n128\t    if (this.adState.dailyRewarded >= AD_LIMITS.REWARDED_DAILY) return false;\n129\t    if (this._inCooldown(placement)) return false;\n130\t    return true;\n131\t  }\n132\t\n133\t  canShowInterstitial(currentLevel) {\n134\t    this._resetDaily();\n135\t    if (this.isNewUser()) return false;\n136\t    if (this.adState.dailyInterstitial >= AD_LIMITS.INTERSTITIAL_DAILY) return false;\n137\t    if (this.adState.consecutiveFails >= 2) return false;\n138\t    const lastLevel = this.adState.lastInterstitialLevel || 0;\n139\t    if (currentLevel - lastLevel < AD_LIMITS.INTERSTITIAL_LEVEL_INTERVAL) return false;\n140\t    if (this._inCooldown(AD_PLACEMENTS.INTERSTITIAL)) return false;\n141\t    return true;\n142\t  }\n143\t\n144\t  _inCooldown(placement) {\n145\t    const last = this.adState.lastShowTime[placement] || 0;\n146\t    return Date.now() - last < AD_LIMITS.COOLDOWN_MS;\n147\t  }\n148\t\n149\t  // --- Show rewarded video ---\n150\t  showRewarded(placement) {\n151\t    if (!this.canShowRewarded(placement)) return Promise.resolve(false);\n152\t\n153\t    this._currentPlacement = placement;\n154\t\n155\t    if (this.isDouyin && this.rewardedAd) {\n156\t      return new Promise((resolve) => {\n157\t        this._pendingResolve = resolve;\n158\t        this.rewardedAd.show().catch(() => {\n159\t          this.rewardedAd.load().then(() => {\n160\t            this.rewardedAd.show().catch(() => resolve(false));\n161\t          }).catch(() => resolve(false));\n162\t        });\n163\t      }).then((success) => {\n164\t        if (success) this._onAdComplete(placement);\n165\t        return success;\n166\t      });\n167\t    }\n168\t\n169\t    // Stub mode: simulate ad with a UI overlay\n170\t    return this._showStubAd(placement);\n171\t  }\n172\t\n173\t  // --- Show interstitial ---\n174\t  showInterstitial(currentLevel) {\n175\t    if (!this.canShowInterstitial(currentLevel)) return Promise.resolve(false);\n176\t\n177\t    if (this.isDouyin && this.interstitialAd) {\n178\t      return new Promise((resolve) => {\n179\t        this.interstitialAd.show().then(() => {\n180\t          this.adState.dailyInterstitial++;\n181\t          this.adState.lastInterstitialLevel = currentLevel;\n182\t          this.adState.lastShowTime[AD_PLACEMENTS.INTERSTITIAL] = Date.now();\n183\t          this.dm.save();\n184\t          setTimeout(() => resolve(true), 5000);\n185\t        }).catch(() => resolve(false));\n186\t      });\n187\t    }\n188\t\n189\t    // Stub: simulate 2s interstitial\n190\t    return new Promise((resolve) => {\n191\t      this._showingUI = true;\n192\t      this._stubInterstitial = true;\n193\t      this._stubTimer = 2;\n194\t      this.adState.dailyInterstitial++;\n195\t      this.adState.lastInterstitialLevel = currentLevel;\n196\t      this.adState.lastShowTime[AD_PLACEMENTS.INTERSTITIAL] = Date.now();\n197\t      this.dm.save();\n198\t      setTimeout(() => {\n199\t        this._showingUI = false;\n200\t        this._stubInterstitial = false;\n201\t        resolve(true);\n202\t      }, 2000);\n203\t    });\n204\t  }\n205\t\n206\t  _onAdComplete(placement) {\n207\t    this.adState.dailyRewarded++;\n208\t    this.adState.lastShowTime[placement] = Date.now();\n209\t    this.dm.save();\n210\t  }\n211\t\n212\t  // --- Stub ad simulation ---\n213\t  _showStubAd(placement) {\n214\t    return new Promise((resolve) => {\n215\t      this._showingUI = true;\n216\t      this._stubPlacement = placement;\n217\t      this._stubTimer = 3; // 3 second simulated ad\n218\t      this._stubResolve = resolve;\n219\t    });\n220\t  }\n221\t\n222\t  _completeStubAd(watched) {\n223\t    this._showingUI = false;\n224\t    if (watched) this._onAdComplete(this._stubPlacement);\n225\t    if (this._stubResolve) {\n226\t      this._stubResolve(watched);\n227\t      this._stubResolve = null;\n228\t    }\n229\t  }\n230\t\n231\t  // --- Fail tracking for interstitial suppression ---\n232\t  reportFail() {\n233\t    this.adState.consecutiveFails++;\n234\t    this.dm.save();\n235\t  }\n236\t\n237\t  reportSuccess() {\n238\t    this.adState.consecutiveFails = 0;\n239\t    this.dm.save();\n240\t  }\n241\t\n242\t  // --- Rendering (stub ad UI) ---\n243\t  update(dt) {\n244\t    if (this._stubTimer > 0) {\n245\t      this._stubTimer -= dt;\n246\t    }\n247\t  }\n248\t\n249\t  renderStubAd(ctx, w, h) {\n250\t    if (!this._showingUI) return false;\n251\t\n252\t    if (this._stubInterstitial) {\n253\t      // Interstitial overlay\n254\t      ctx.fillStyle = 'rgba(0,0,0,0.85)';\n255\t      ctx.fillRect(0, 0, w, h);\n256\t\n257\t      ctx.fillStyle = '#FFF';\n258\t      ctx.font = 'bold 20px sans-serif';\n259\t      ctx.textAlign = 'center';\n260\t      ctx.fillText('📢 广告', w / 2, h / 2 - 30);\n261\t\n262\t      ctx.font = '14px sans-serif';\n263\t      ctx.fillStyle = '#CCC';\n264\t      ctx.fillText('插屏广告模拟', w / 2, h / 2);\n265\t\n266\t      const remaining = Math.ceil(this._stubTimer);\n267\t      ctx.font = 'bold 24px sans-serif';\n268\t      ctx.fillStyle = '#FFB800';\n269\t      ctx.fillText(`${remaining}s`, w / 2, h / 2 + 40);\n270\t      return true;\n271\t    }\n272\t\n273\t    // Rewarded video stub\n274\t    ctx.fillStyle = 'rgba(0,0,0,0.9)';\n275\t    ctx.fillRect(0, 0, w, h);\n276\t\n277\t    // Fake ad content\n278\t    ctx.fillStyle = '#FFB800';\n279\t    ctx.font = 'bold 18px sans-serif';\n280\t    ctx.textAlign = 'center';\n281\t    ctx.fillText('🎬 激励视频广告', w / 2, h / 2 - 60);\n282\t\n283\t    ctx.fillStyle = '#FFF';\n284\t    ctx.font = '14px sans-serif';\n285\t    ctx.fillText(`广告位: ${this._stubPlacement}`, w / 2, h / 2 - 30);\n286\t    ctx.fillText('（开发模式模拟广告）', w / 2, h / 2);\n287\t\n288\t    // Countdown\n289\t    const remaining = Math.ceil(this._stubTimer);\n290\t    if (remaining > 0) {\n291\t      ctx.font = 'bold 32px sans-serif';\n292\t      ctx.fillStyle = '#FFB800';\n293\t      ctx.fillText(`${remaining}s`, w / 2, h / 2 + 50);\n294\t    }\n295\t\n296\t    // Close/complete button (appears after timer)\n297\t    if (remaining <= 0) {\n298\t      const btnW = 160, btnH = 44;\n299\t      const btnX = (w - btnW) / 2, btnY = h / 2 + 70;\n300\t      ctx.fillStyle = '#6BCB77';\n301\t      this._roundRect(ctx, btnX, btnY, btnW, btnH, btnH / 2);\n302\t      ctx.fill();\n303\t      ctx.fillStyle = '#FFF';\n304\t      ctx.font = 'bold 16px sans-serif';\n305\t      ctx.fillText('✓ 观看完成', w / 2, btnY + 28);\n306\t\n307\t      // Skip button\n308\t      ctx.fillStyle = '#666';\n309\t      ctx.font = '12px sans-serif';\n310\t      ctx.fillText('跳过（无奖励）', w / 2, btnY + btnH + 24);\n311\t    }\n312\t\n313\t    return true;\n314\t  }\n315\t\n316\t  handleStubClick(x, y, w, h) {\n317\t    if (!this._showingUI || this._stubInterstitial) return false;\n318\t    if (this._stubTimer > 0) return true; // consume click during countdown\n319\t\n320\t    const btnW = 160, btnH = 44;\n321\t    const btnX = (w - btnW) / 2, btnY = h / 2 + 70;\n322\t\n323\t    // Complete button\n324\t    if (x >= btnX && x <= btnX + btnW && y >= btnY && y <= btnY + btnH) {\n325\t      this._completeStubAd(true);\n326\t      return true;\n327\t    }\n328\t\n329\t    // Skip area\n330\t    if (y >= btnY + btnH && y <= btnY + btnH + 40) {\n331\t      this._completeStubAd(false);\n332\t      return true;\n333\t    }\n334\t\n335\t    return true; // consume all clicks while ad showing\n336\t  }\n337\t\n338\t  // --- Ad button helper for UI ---\n339\t  static shouldShowAdButton(adManager, placement) {\n340\t    return adManager && adManager.canShowRewarded(placement);\n341\t  }\n342\t\n343\t  _roundRect(ctx, x, y, w, h, r) {\n344\t    ctx.beginPath();\n345\t    ctx.moveTo(x + r, y);\n346\t    ctx.lineTo(x + w - r, y);\n347\t    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n348\t    ctx.lineTo(x + w, y + h - r);\n349\t    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n350\t    ctx.lineTo(x + r, y + h);\n351\t    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n352\t    ctx.lineTo(x, y + r);\n353\t    ctx.quadraticCurveTo(x, y, x + r, y);\n354\t    ctx.closePath();\n355\t  }\n356\t}\n357\t\n358\tif (typeof module !== 'undefined') module.exports = { AdManager, AD_PLACEMENTS, AD_LIMITS };\n359\t"}]},"parent_tool_use_id":null,"session_id":"7463fb62-2e03-4edd-abad-466ff792dff1","uuid":"f26ef718-a049-4b3a-92cf-253b623d81f8","timestamp":"2026-05-23T10:38:30.623Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-match3/src/js/AdManager.js","content":"// AdManager.js — 穿山甲SDK广告管理，支持真实SDK + stub降级\n// 广告位ID配置在 ad-config.js 中，提审前替换为真实ID\n\nconst AD_PLACEMENTS = {\n  CONTINUE: 'continue',       // 续步激励视频（关卡失败）\n  BOOST: 'boost',             // 开局增益激励视频\n  DOUBLE: 'double',           // 双倍结算激励视频\n  INTERSTITIAL: 'interstitial', // 插屏广告\n  TREASURE: 'treasure',       // 宝箱加速激励视频\n  DAILY_DOUBLE: 'daily_double', // 每日签到翻倍\n};\n\nconst AD_LIMITS = {\n  REWARDED_DAILY: 12,\n  INTERSTITIAL_DAILY: 6,\n  COOLDOWN_MS: 60000,\n  NEW_USER_FREE_LEVELS: 3,\n  INTERSTITIAL_LEVEL_INTERVAL: 3,\n};\n\nclass AdManager {\n  constructor(dataManager) {\n    this.dm = dataManager;\n    this._initStorage();\n\n    // SDK detection — use config if available, otherwise auto-detect\n    const config = (typeof AD_CONFIG !== 'undefined') ? AD_CONFIG : null;\n    this.isDouyin = config ? !config.devMode\n      : (typeof tt !== 'undefined' && typeof tt.createRewardedVideoAd === 'function');\n    this.rewardedAd = null;\n    this.interstitialAd = null;\n    this._loadRetry = 0;\n    this._maxRetry = config ? config.loadRetryCount : 2;\n    this._loadTimeout = config ? config.loadTimeout : 10000;\n\n    if (this.isDouyin) this._initSDK();\n\n    // State\n    this._pendingResolve = null;\n    this._currentPlacement = null;\n    this._showingUI = false;\n  }\n\n  _initStorage() {\n    if (!this.dm.data.adState) {\n      this.dm.data.adState = {\n        dailyRewarded: 0,\n        dailyInterstitial: 0,\n        lastShowTime: {},\n        lastInterstitialLevel: 0,\n        date: this._todayStr(),\n        consecutiveFails: 0,\n      };\n      this.dm.save();\n    }\n    this.adState = this.dm.data.adState;\n    this._resetDaily();\n  }\n\n  _todayStr() { return new Date().toISOString().slice(0, 10); }\n\n  _resetDaily() {\n    if (this.adState.date !== this._todayStr()) {\n      this.adState.dailyRewarded = 0;\n      this.adState.dailyInterstitial = 0;\n      this.adState.date = this._todayStr();\n      this.dm.save();\n    }\n  }\n\n  _getAdUnitId(type) {\n    const config = (typeof AD_CONFIG !== 'undefined') ? AD_CONFIG : null;\n    if (config && config.adUnitIds && config.adUnitIds[type]) {\n      return config.adUnitIds[type];\n    }\n    return `adunit-placeholder-${type}`;\n  }\n\n  _initSDK() {\n    try {\n      const rewardedId = this._getAdUnitId('rewarded');\n      this.rewardedAd = tt.createRewardedVideoAd({ adUnitId: rewardedId });\n\n      this.rewardedAd.onLoad(() => {\n        this._loadRetry = 0;\n      });\n\n      this.rewardedAd.onError((err) => {\n        console.warn('[AdManager] Rewarded ad error:', err);\n        if (this._loadRetry < this._maxRetry) {\n          this._loadRetry++;\n          setTimeout(() => this.rewardedAd.load(), 1000 * this._loadRetry);\n        }\n      });\n\n      this.rewardedAd.onClose((res) => {\n        if (this._pendingResolve) {\n          this._pendingResolve(res && res.isEnded);\n          this._pendingResolve = null;\n        }\n      });\n\n      // Pre-load rewarded ad\n      this.rewardedAd.load();\n\n      const interstitialId = this._getAdUnitId('interstitial');\n      this.interstitialAd = tt.createInterstitialAd({ adUnitId: interstitialId });\n\n      this.interstitialAd.onLoad(() => {});\n\n      this.interstitialAd.onError((err) => {\n        console.warn('[AdManager] Interstitial ad error:', err);\n      });\n    } catch (e) {\n      console.warn('[AdManager] SDK init failed, falling back to stub:', e);\n      this.isDouyin = false;\n    }\n  }\n\n  // --- Frequency checks ---\n  isNewUser() {\n    return this.dm.unlockedLevel <= AD_LIMITS.NEW_USER_FREE_LEVELS;\n  }\n\n  canShowRewarded(placement) {\n    this._resetDaily();\n    if (this.isNewUser()) return false;\n    if (this.adState.dailyRewarded >= AD_LIMITS.REWARDED_DAILY) return false;\n    if (this._inCooldown(placement)) return false;\n    return true;\n  }\n\n  canShowInterstitial(currentLevel) {\n    this._resetDaily();\n    if (this.isNewUser()) return false;\n    if (this.adState.dailyInterstitial >= AD_LIMITS.INTERSTITIAL_DAILY) return false;\n    if (this.adState.consecutiveFails >= 2) return false;\n    const lastLevel = this.adState.lastInterstitialLevel || 0;\n    if (currentLevel - lastLevel < AD_LIMITS.INTERSTITIAL_LEVEL_INTERVAL) return false;\n    if (this._inCooldown(AD_PLACEMENTS.INTERSTITIAL)) return false;\n    return true;\n  }\n\n  _inCooldown(placement) {\n    const last = this.adState.lastShowTime[placement] || 0;\n    return Date.now() - last < AD_LIMITS.COOLDOWN_MS;\n  }\n\n  // --- Show rewarded video ---\n  showRewarded(placement) {\n    if (!this.canShowRewarded(placement)) return Promise.resolve(false);\n\n    this._currentPlacement = placement;\n\n    if (this.isDouyin && this.rewardedAd) {\n      return new Promise((resolve) => {\n        this._pendingResolve = resolve;\n        this.rewardedAd.show().catch(() => {\n          this.rewardedAd.load().then(() => {\n            this.rewardedAd.show().catch(() => resolve(false));\n          }).catch(() => resolve(false));\n        });\n      }).then((success) => {\n        if (success) this._onAdComplete(placement);\n        return success;\n      });\n    }\n\n    // Stub mode: simulate ad with a UI overlay\n    return this._showStubAd(placement);\n  }\n\n  // --- Show interstitial ---\n  showInterstitial(currentLevel) {\n    if (!this.canShowInterstitial(currentLevel)) return Promise.resolve(false);\n\n    if (this.isDouyin && this.interstitialAd) {\n      return new Promise((resolve) => {\n        this.interstitialAd.show().then(() => {\n          this.adState.dailyInterstitial++;\n          this.adState.lastInterstitialLevel = currentLevel;\n          this.adState.lastShowTime[AD_PLACEMENTS.INTERSTITIAL] = Date.now();\n          this.dm.save();\n          setTimeout(() => resolve(true), 5000);\n        }).catch(() => resolve(false));\n      });\n    }\n\n    // Stub: simulate 2s interstitial\n    return new Promise((resolve) => {\n      this._showingUI = true;\n      this._stubInterstitial = true;\n      this._stubTimer = 2;\n      this.adState.dailyInterstitial++;\n      this.adState.lastInterstitialLevel = currentLevel;\n      this.adState.lastShowTime[AD_PLACEMENTS.INTERSTITIAL] = Date.now();\n      this.dm.save();\n      setTimeout(() => {\n        this._showingUI = false;\n        this._stubInterstitial = false;\n        resolve(true);\n      }, 2000);\n    });\n  }\n\n  _onAdComplete(placement) {\n    this.adState.dailyRewarded++;\n    this.adState.lastShowTime[placement] = Date.now();\n    this.dm.save();\n  }\n\n  // --- Stub ad simulation ---\n  _showStubAd(placement) {\n    return new Promise((resolve) => {\n      this._showingUI = true;\n      this._stubPlacement = placement;\n      this._stubTimer = 3; // 3 second simulated ad\n      this._stubResolve = resolve;\n    });\n  }\n\n  _completeStubAd(watched) {\n    this._showingUI = false;\n    if (watched) this._onAdComplete(this._stubPlacement);\n    if (this._stubResolve) {\n      this._stubResolve(watched);\n      this._stubResolve = null;\n    }\n  }\n\n  // --- Fail tracking for interstitial suppression ---\n  reportFail() {\n    this.adState.consecutiveFails++;\n    this.dm.save();\n  }\n\n  reportSuccess() {\n    this.adState.consecutiveFails = 0;\n    this.dm.save();\n  }\n\n  // --- Rendering (stub ad UI) ---\n  update(dt) {\n    if (this._stubTimer > 0) {\n      this._stubTimer -= dt;\n    }\n  }\n\n  renderStubAd(ctx, w, h) {\n    if (!this._showingUI) return false;\n\n    if (this._stubInterstitial) {\n      // Interstitial overlay\n      ctx.fillStyle = 'rgba(0,0,0,0.85)';\n      ctx.fillRect(0, 0, w, h);\n\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 20px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText('📢 广告', w / 2, h / 2 - 30);\n\n      ctx.font = '14px sans-serif';\n      ctx.fillStyle = '#CCC';\n      ctx.fillText('插屏广告模拟', w / 2, h / 2);\n\n      const remaining = Math.ceil(this._stubTimer);\n      ctx.font = 'bold 24px sans-serif';\n      ctx.fillStyle = '#FFB800';\n      ctx.fillText(`${remaining}s`, w / 2, h / 2 + 40);\n      return true;\n    }\n\n    // Rewarded video stub\n    ctx.fillStyle = 'rgba(0,0,0,0.9)';\n    ctx.fillRect(0, 0, w, h);\n\n    // Fake ad content\n    ctx.fillStyle = '#FFB800';\n    ctx.font = 'bold 18px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('🎬 激励视频广告', w / 2, h / 2 - 60);\n\n    ctx.fillStyle = '#FFF';\n    ctx.font = '14px sans-serif';\n    ctx.fillText(`广告位: ${this._stubPlacement}`, w / 2, h / 2 - 30);\n    ctx.fillText('（开发模式模拟广告）', w / 2, h / 2);\n\n    // Countdown\n    const remaining = Math.ceil(this._stubTimer);\n    if (remaining > 0) {\n      ctx.font = 'bold 32px sans-serif';\n      ctx.fillStyle = '#FFB800';\n      ctx.fillText(`${remaining}s`, w / 2, h / 2 + 50);\n    }\n\n    // Close/complete button (appears after timer)\n    if (remaining <= 0) {\n      const btnW = 160, btnH = 44;\n      const btnX = (w - btnW) / 2, btnY = h / 2 + 70;\n      ctx.fillStyle = '#6BCB77';\n      this._roundRect(ctx, btnX, btnY, btnW, btnH, btnH / 2);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText('✓ 观看完成', w / 2, btnY + 28);\n\n      // Skip button\n      ctx.fillStyle = '#666';\n      ctx.font = '12px sans-serif';\n      ctx.fillText('跳过（无奖励）', w / 2, btnY + btnH + 24);\n    }\n\n    return true;\n  }\n\n  handleStubClick(x, y, w, h) {\n    if (!this._showingUI || this._stubInterstitial) return false;\n    if (this._stubTimer > 0) return true; // consume click during countdown\n\n    const btnW = 160, btnH = 44;\n    const btnX = (w - btnW) / 2, btnY = h / 2 + 70;\n\n    // Complete button\n    if (x >= btnX && x <= btnX + btnW && y >= btnY && y <= btnY + btnH) {\n      this._completeStubAd(true);\n      return true;\n    }\n\n    // Skip area\n    if (y >= btnY + btnH && y <= btnY + btnH + 40) {\n      this._completeStubAd(false);\n      return true;\n    }\n\n    return true; // consume all clicks while ad showing\n  }\n\n  // --- Ad button helper for UI ---\n  static shouldShowAdButton(adManager, placement) {\n    return adManager && adManager.canShowRewarded(placement);\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { AdManager, AD_PLACEMENTS, AD_LIMITS };\n","numLines":359,"startLine":1,"totalLines":359}}}
