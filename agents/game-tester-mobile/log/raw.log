 ''\n64\t    };\n65\t\n66\t    if (this.isDouyin) {\n67\t      return this._douyinShare(shareData);\n68\t    }\n69\t    this.shareCount++;\n70\t    return Promise.resolve({ success: true, stub: true });\n71\t  }\n72\t\n73\t  _douyinShare(shareData) {\n74\t    return new Promise((resolve, reject) => {\n75\t      tt.shareAppMessage({\n76\t        ...shareData,\n77\t        success: () => {\n78\t          this.shareCount++;\n79\t          this.data.addCoins(10);\n80\t          resolve({ success: true });\n81\t        },\n82\t        fail: (err) => reject(err)\n83\t      });\n84\t    });\n85\t  }\n86\t\n87\t  getLeaderboard(type = 'score') {\n88\t    if (this.isDoujin && tt.getFriendCloudStorage) {\n89\t      return this._douyinLeaderboard(type);\n90\t    }\n91\t    return Promise.resolve(this._localLeaderboard(type));\n92\t  }\n93\t\n94\t  _douyinLeaderboard(type) {\n95\t    return new Promise((resolve) => {\n96\t      tt.getFriendCloudStorage({\n97\t        keyList: [`idiom_${type}`],\n98\t        success: (res) => resolve(res.data || []),\n99\t        fail: () => resolve([])\n100\t      });\n101\t    });\n102\t  }\n103\t\n104\t  _localLeaderboard(type) {\n105\t    const data = this.data.data;\n106\t    return [{\n107\t      rank: 1,\n108\t      name: '我',\n109\t      value: type === 'score' ? data.totalScore :\n110\t             type === 'pk' ? (data.pkWins || 0) :\n111\t             data.collectedIdioms.length\n112\t    }];\n113\t  }\n114\t}\n115\t\n116\tif (typeof module !== 'undefined') module.exports = { SocialManager };\n117\t"}]},"parent_tool_use_id":null,"session_id":"7463fb62-2e03-4edd-abad-466ff792dff1","uuid":"448a4f61-670d-49d7-b89f-11c71443d349","timestamp":"2026-05-23T10:38:31.507Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/src/js/SocialManager.js","content":"// SocialManager.js — Douyin share integration stub\n\nclass SocialManager {\n  constructor(data) {\n    this.data = data;\n    this.isDouyin = typeof tt !== 'undefined' && tt.shareAppMessage;\n    this.shareCount = 0;\n  }\n\n  shareResult(result) {\n    const shareData = {\n      title: `我在成语大闯关获得了${result.score}分！你能超越我吗？`,\n      desc: '来挑战成语大闯关，看看你认识多少成语！',\n      path: '/pages/home/index',\n      imageUrl: ''\n    };\n\n    if (this.isDouyin) {\n      return this._douyinShare(shareData);\n    }\n    this.shareCount++;\n    this.data.addCoins(10);\n    return Promise.resolve({ success: true, stub: true });\n  }\n\n  sharePKResult(result) {\n    const won = result.won ? '胜利' : '惜败';\n    const shareData = {\n      title: `成语PK ${won}！${result.correctCount}/5 正确`,\n      desc: '不服？来挑战我！',\n      path: '/pages/home/index',\n      imageUrl: ''\n    };\n\n    if (this.isDouyin) {\n      return this._douyinShare(shareData);\n    }\n    this.shareCount++;\n    return Promise.resolve({ success: true, stub: true });\n  }\n\n  shareDailyChallenge() {\n    const shareData = {\n      title: '今天的成语挑战你答对了吗？',\n      desc: '每日成语挑战，只有12%的人全对！',\n      path: '/pages/home/index',\n      imageUrl: ''\n    };\n\n    if (this.isDouyin) {\n      return this._douyinShare(shareData);\n    }\n    this.shareCount++;\n    this.data.addCoins(10);\n    return Promise.resolve({ success: true, stub: true });\n  }\n\n  shareCollection(collection) {\n    const shareData = {\n      title: `我已收集${collection.collected}个成语！成语图鉴${collection.percent}%完成`,\n      desc: '成语大闯关图鉴，快来收集！',\n      path: '/pages/home/index',\n      imageUrl: ''\n    };\n\n    if (this.isDouyin) {\n      return this._douyinShare(shareData);\n    }\n    this.shareCount++;\n    return Promise.resolve({ success: true, stub: true });\n  }\n\n  _douyinShare(shareData) {\n    return new Promise((resolve, reject) => {\n      tt.shareAppMessage({\n        ...shareData,\n        success: () => {\n          this.shareCount++;\n          this.data.addCoins(10);\n          resolve({ success: true });\n        },\n        fail: (err) => reject(err)\n      });\n    });\n  }\n\n  getLeaderboard(type = 'score') {\n    if (this.isDoujin && tt.getFriendCloudStorage) {\n      return this._douyinLeaderboard(type);\n    }\n    return Promise.resolve(this._localLeaderboard(type));\n  }\n\n  _douyinLeaderboard(type) {\n    return new Promise((resolve) => {\n      tt.getFriendCloudStorage({\n        keyList: [`idiom_${type}`],\n        success: (res) => resolve(res.data || []),\n        fail: () => resolve([])\n      });\n    });\n  }\n\n  _localLeaderboard(type) {\n    const data = this.data.data;\n    return [{\n      rank: 1,\n      name: '我',\n      value: type === 'score' ? data.totalScore :\n             type === 'pk' ? (data.pkWins || 0) :\n             data.collectedIdioms.length\n    }];\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { SocialManager };\n","numLines":117,"startLine":1,"totalLines":117}}}
