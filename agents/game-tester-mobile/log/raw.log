oth', 0.6);\n    this._noise(0.1, 0.5);\n  }\n\n  playBossAbility() {\n    this._tone(100, 0.3, 'sawtooth', 0.5);\n    this._noise(0.2, 0.4);\n  }\n\n  playBossDefeat() {\n    [523, 659, 784, 1047, 1319].forEach((f, i) => {\n      setTimeout(() => this._tone(f, 0.25, 'square'), i * 100);\n    });\n  }\n\n  playLevelWin() {\n    [523, 659, 784, 1047].forEach((f, i) => {\n      setTimeout(() => this._tone(f, 0.2), i * 120);\n    });\n  }\n\n  playLevelFail() {\n    [440, 349, 294, 262].forEach((f, i) => {\n      setTimeout(() => this._tone(f, 0.25), i * 180);\n    });\n  }\n\n  playInvalid() {\n    this._tone(200, 0.1, 'square');\n    setTimeout(() => this._tone(180, 0.1, 'square'), 80);\n  }\n\n  toggle() {\n    this.enabled = !this.enabled;\n    return this.enabled;\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { AudioManager };\n","numLines":138,"startLine":1,"totalLines":138}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a1c13754dbc84eb0a555ec99","type":"tool_result","content":"1\t// SocialSystem.js — Share, friend leaderboard, friend PK, invite help (Douyin API stubs)\n2\t\n3\tclass SocialSystem {\n4\t  constructor(dataManager) {\n5\t    this.dm = dataManager;\n6\t    if (!this.dm.data.social) {\n7\t      this.dm.data.social = {\n8\t        userId: this._genId(),\n9\t        sharedToday: false,\n10\t        shareCount: 0,\n11\t        helpCount: 0,\n12\t        pkWins: 0,\n13\t        pkHistory: [],\n14\t        friends: this._genFakeFriends(),\n15\t      };\n16\t      this.dm.save();\n17\t    }\n18\t    this.social = this.dm.data.social;\n19\t    this.isDouyin = typeof tt !== 'undefined';\n20\t  }\n21\t\n22\t  _genId() {\n23\t    return 'u_' + Math.random().toString(36).slice(2, 10);\n24\t  }\n25\t\n26\t  _genFakeFriends() {\n27\t    const names = ['小明', '小红', '大壮', '阿花', '老王', '小李', '大毛', '阿杰'];\n28\t    return names.map((name, i) => ({\n29\t      id: 'f_' + i,\n30\t      name,\n31\t      avatar: ['😎', '🤗', '💪', '🌸', '🎯', '🎮', '🏆', '✨'][i],\n32\t      maxLevel: Math.floor(Math.random() * 40) + 5,\n33\t      totalStars: Math.floor(Math.random() * 80) + 10,\n34\t      score: Math.floor(Math.random() * 50000) + 5000,\n35\t    }));\n36\t  }\n37\t\n38\t  getUserId() { return this.social.userId; }\n39\t\n40\t  // --- Share ---\n41\t  shareResult(levelId, score, stars) {\n42\t    if (this.isDouyin) {\n43\t      try {\n44\t        tt.shareAppMessage({\n45\t          title: `我在消消消大作战第${levelId}关获得了${stars}星！来挑战我吧`,\n46\t          query: `from=share&level=${levelId}&inviter=${this.getUserId()}`,\n47\t        });\n48\t      } catch (e) { /* fallback */ }\n49\t    }\n50\t    this.social.shareCount++;\n51\t    this.social.sharedToday = true;\n52\t    this.dm.save();\n53\t    return { success: true, type: 'share_result' };\n54\t  }\n55\t\n56\t  shareHelp(levelId) {\n57\t    if (this.isDouyin) {\n58\t      try {\n59\t      