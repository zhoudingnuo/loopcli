{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_e2cb0f0e02bc48c19b80554d","type":"tool_result","content":"1\t// SocialSystem.js — Share, friend leaderboard, friend PK, invite help (Douyin API stubs)\n2\t\n3\tclass SocialSystem {\n4\t  constructor(dataManager) {\n5\t    this.dm = dataManager;\n6\t    if (!this.dm.data.social) {\n7\t      this.dm.data.social = {\n8\t        userId: this._genId(),\n9\t        sharedToday: false,\n10\t        shareCount: 0,\n11\t        helpCount: 0,\n12\t        pkWins: 0,\n13\t        pkHistory: [],\n14\t        friends: this._genFakeFriends(),\n15\t      };\n16\t      this.dm.save();\n17\t    }\n18\t    this.social = this.dm.data.social;\n19\t    this.isDouyin = typeof tt !== 'undefined';\n20\t  }\n21\t\n22\t  _genId() {\n23\t    return 'u_' + Math.random().toString(36).slice(2, 10);\n24\t  }\n25\t\n26\t  _genFakeFriends() {\n27\t    const names = ['小明', '小红', '大壮', '阿花', '老王', '小李', '大毛', '阿杰'];\n28\t    return names.map((name, i) => ({\n29\t      id: 'f_' + i,\n30\t      name,\n31\t      avatar: ['😎', '🤗', '💪', '🌸', '🎯', '🎮', '🏆', '✨'][i],\n32\t      maxLevel: Math.floor(Math.random() * 40) + 5,\n33\t      totalStars: Math.floor(Math.random() * 80) + 10,\n34\t      score: Math.floor(Math.random() * 50000) + 5000,\n35\t    }));\n36\t  }\n37\t\n38\t  getUserId() { return this.social.userId; }\n39\t\n40\t  // --- Share ---\n41\t  shareResult(levelId, score, stars) {\n42\t    if (this.isDouyin) {\n43\t      try {\n44\t        tt.shareAppMessage({\n45\t          title: `我在消消消大作战第${levelId}关获得了${stars}星！来挑战我吧`,\n46\t          query: `from=share&level=${levelId}&inviter=${this.getUserId()}`,\n47\t        });\n48\t      } catch (e) { /* fallback */ }\n49\t    }\n50\t    this.social.shareCount++;\n51\t    this.social.sharedToday = true;\n52\t    this.dm.save();\n53\t    return { success: true, type: 'share_result' };\n54\t  }\n55\t\n56\t  shareHelp(levelId) {\n57\t    if (this.isDouyin) {\n58\t      try {\n59\t        tt.shareAppMessage({\n60\t          title: '帮帮我！我卡在这关了，送我5步继续挑战吧！',\n61\t          query: `from=help&level=${levelId}&inviter=${this.getUserId()}`,\n62\t        });\n63\t      } catch (e) { /* fallback */ }\n64\t    }\n65\t    this.social.helpCount++;\n66\t    this.dm.save();\n67\t    return { success: true, type: 'share_help', bonus: '+5步' };\n68\t  }\n69\t\n70\t  // --- Friend Leaderboard ---\n71\t  getLeaderboard() {\n72\t    const me = {\n73\t      id: this.getUserId(),\n74\t      name: '我',\n75\t      avatar: '🎮',\n76\t      score: this._getMyScore(),\n77\t      maxLevel: this.dm.unlockedLevel - 1,\n78\t      isMe: true,\n79\t    };\n80\t    const friends = this.social.friends.map(f => ({\n81\t      ...f,\n82\t      isMe: false,\n83\t      score: f.score + Math.floor(Math.random() * 500) - 250,\n84\t    }));\n85\t    const all = [me, ...friends].sort((a, b) => b.score - a.score);\n86\t    return all;\n87\t  }\n88\t\n89\t  _getMyScore() {\n90\t    let total = 0;\n91\t    for (const key of Object.keys(this.dm.data.levelStars)) {\n92\t      total += (this.dm.data.levelStars[key] || 0) * 1000 + Math.floor(Math.random() * 500);\n93\t    }\n94\t    return total;\n95\t  }\n96\t\n97\t  // --- Friend PK ---\n98\t  startPK(friendId) {\n99\t    const friend = this.social.friends.find(f => f.id === friendId);\n100\t    if (!friend) return null;\n101\t    return {\n102\t      opponent: friend,\n103\t      myMaxLevel: this.dm.unlockedLevel - 1,\n104\t      theirMaxLevel: friend.maxLevel,\n105\t    };\n106\t  }\n107\t\n108\t  resolvePK(friendId, myScore, theirScore) {\n109\t    const won = myScore > theirScore;\n110\t    if (won) {\n111\t      this.social.pkWins++;\n112\t      this.dm.addCoins(20);\n113\t    }\n114\t    this.social.pkHistory.push({\n115\t      friendId, myScore, theirScore, won, time: Date.now(),\n116\t    });\n117\t    if (this.social.pkHistory.length > 20) this.social.pkHistory.shift();\n118\t    this.dm.save();\n119\t    return { won, coinsWon: won ? 20 : 0 };\n120\t  }\n121\t\n122\t  getPKRecord() {\n123\t    return { wins: this.social.pkWins, total: this.social.pkHistory.length };\n124\t  }\n125\t\n126\t  // --- Invite Help ---\n127\t  receiveHelp() {\n128\t    this.dm.addItem('extra_moves', 1);\n129\t    this.dm.save();\n130\t    return { bonus: '+5步道具' };\n131\t  }\n132\t\n133\t  // --- Render ---\n134\t  render(ctx, screenW, screenH) {\n135\t    const grad = ctx.createLinearGradient(0, 0, 0, screenH);\n136\t    grad.addColorStop(0, '#E3F2FD');\n137\t    grad.addColorStop(0.5, '#F3E5F5');\n138\t    grad.addColorStop(1, '#FFF8E7');\n139\t    ctx.fillStyle = grad;\n140\t    ctx.fillRect(0, 0, screenW, screenH);\n141\t\n142\t    // Title bar\n143\t    ctx.fillStyle = '#4DA6FF';\n144\t    this._roundRect(ctx, 10, 8, screenW - 20, 48, 12);\n145\t    ctx.fill();\n146\t    ctx.fillStyle = '#FFF';\n147\t    ctx.font = 'bold 20px sans-serif';\n148\t    ctx.textAlign = 'center';\n149\t    ctx.fillText('👥 社交中心', screenW / 2, 40);\n150\t\n151\t    // Tab navigation\n152\t    const tabs = ['🏆 排行', '⚔️ PK', '📤 分享'];\n153\t    const tabW = (screenW - 40) / tabs.length;\n154\t    for (let i = 0; i < tabs.length; i++) {\n155\t      const active = (this._tab || 0) === i;\n156\t      ctx.fillStyle = active ? '#FFB800' : '#E8E0D8';\n157\t      this._roundRect(ctx, 20 + i * tabW, 65, tabW - 4, 30, 15);\n158\t      ctx.fill();\n159\t      ctx.fillStyle = active ? '#FFF' : '#8D6E63';\n160\t      ctx.font = 'bold 12px sans-serif';\n161\t      ctx.fillText(tabs[i], 20 + i * tabW + (tabW - 4) / 2, 85);\n162\t    }\n163\t\n164\t    const tab = this._tab || 0;\n165\t    if (tab === 0) this._renderLeaderboard(ctx, screenW, screenH);\n166\t    else if (tab === 1) this._renderPK(ctx, screenW, screenH);\n167\t    else this._renderShare(ctx, screenW, screenH);\n168\t\n169\t    // Back button\n170\t    ctx.fillStyle = '#8D6E63';\n171\t    this._roundRect(ctx, 20, screenH - 50, screenW - 40, 38, 19);\n172\t    ctx.fill();\n173\t    ctx.fillStyle = '#FFF';\n174\t    ctx.font = 'bold 14px sans-serif';\n175\t    ctx.fillText('返回地图', screenW / 2, screenH - 27);\n176\t  }\n177\t\n178\t  _renderLeaderboard(ctx, w, h) {\n179\t    const leaders = this.getLeaderboard();\n180\t    const startY = 108;\n181\t    ctx.fillStyle = '#5D4037';\n182\t    ctx.font = 'bold 14px sans-serif';\n183\t    ctx.textAlign = 'center';\n184\t    ctx.fillText('好友排行榜', w / 2, startY);\n185\t\n186\t    for (let i = 0; i < Math.min(leaders.length, 8); i++) {\n187\t      const l = leaders[i];\n188\t      const ly = startY + 14 + i * 48;\n189\t      ctx.fillStyle = l.isMe ? '#FFE0B2' : '#FFFFFFEE';\n190\t      this._roundRect(ctx, 20, ly, w - 40, 42, 8);\n191\t      ctx.fill();\n192\t\n193\t      if (l.isMe) {\n194\t        ctx.strokeStyle = '#FFB800';\n195\t        ctx.lineWidth = 2;\n196\t        this._roundRect(ctx, 20, ly, w - 40, 42, 8);\n197\t        ctx.stroke();\n198\t      }\n199\t\n200\t      // Rank\n201\t      ctx.textAlign = 'left';\n202\t      ctx.font = 'bold 16px sans-serif';\n203\t      ctx.fillStyle = i < 3 ? ['#FFD700', '#C0C0C0', '#CD7F32'][i] : '#8D6E63';\n204\t      const medals = ['🥇', '🥈', '🥉'];\n205\t      ctx.fillText(i < 3 ? medals[i] : `${i + 1}`, 30, ly + 28);\n206\t\n207\t      // Avatar\n208\t      ctx.font = '22px sans-serif';\n209\t      ctx.fillText(l.avatar, 65, ly + 30);\n210\t\n211\t      // Name & score\n212\t      ctx.font = 'bold 13px sans-serif';\n213\t      ctx.fillStyle = '#5D4037';\n214\t      ctx.fillText(l.name + (l.isMe ? ' (我)' : ''), 95, ly + 18);\n215\t      ctx.font = '11px sans-serif';\n216\t      ctx.fillStyle = '#8D6E63';\n217\t      ctx.fillText(`Lv.${l.maxLevel} | ${l.score.toLocaleString()}分`, 95, ly + 34);\n218\t    }\n219\t  }\n220\t\n221\t  _renderPK(ctx, w, h) {\n222\t    const startY = 108;\n223\t    const record = this.getPKRecord();\n224\t    ctx.fillStyle = '#5D4037';\n225\t    ctx.font = 'bold 14px sans-serif';\n226\t    ctx.textAlign = 'center';\n227\t    ctx.fillText(`PK战绩: ${record.wins}胜 / ${record.total}场`, w / 2, startY);\n228\t\n229\t    const friends = this.social.friends.slice(0, 6);\n230\t    for (let i = 0; i < friends.length; i++) {\n231\t      const f = friends[i];\n232\t      const fy = startY + 14 + i * 52;\n233\t      ctx.fillStyle = '#FFFFFFEE';\n234\t      this._roundRect(ctx, 20, fy, w - 40, 46, 8);\n235\t      ctx.fill();\n236\t\n237\t      ctx.textAlign = 'left';\n238\t      ctx.font = '20px sans-serif';\n239\t      ctx.fillText(f.avatar, 30, fy + 30);\n240\t      ctx.font = 'bold 13px sans-serif';\n241\t      ctx.fillStyle = '#5D4037';\n242\t      ctx.fillText(f.name, 58, fy + 20);\n243\t      ctx.font = '11px sans-serif';\n244\t      ctx.fillStyle = '#8D6E63';\n245\t      ctx.fillText(`Lv.${f.maxLevel} | ${f.score.toLocaleString()}分`, 58, fy + 36);\n246\t\n247\t      // Challenge button\n248\t      ctx.fillStyle = '#FF4D4D';\n249\t      this._roundRect(ctx, w - 90, fy + 8, 58, 30, 15);\n250\t      ctx.fill();\n251\t      ctx.fillStyle = '#FFF';\n252\t      ctx.font = 'bold 12px sans-serif';\n253\t      ctx.textAlign = 'center';\n254\t      ctx.fillText('挑战', w - 61, fy + 28);\n255\t    }\n256\t  }\n257\t\n258\t  _renderShare(ctx, w, h) {\n259\t    const startY = 108;\n260\t    ctx.fillStyle = '#5D4037';\n261\t    ctx.font = 'bold 14px sans-serif';\n262\t    ctx.textAlign = 'center';\n263\t    ctx.fillText(`已分享 ${this.social.shareCount} 次`, w / 2, startY);\n264\t\n265\t    const buttons = [\n266\t      { label: '分享战绩', emoji: '🏆', color: '#6BCB77', desc: '分享给好友炫耀' },\n267\t      { label: '求助续命', emoji: '🆘', color: '#FF4D4D', desc: '好友助力+5步' },\n268\t      { label: '邀请好友', emoji: '🎁', color: '#B47AEA', desc: '邀请得20🪙' },\n269\t    ];\n270\t\n271\t    for (let i = 0; i < buttons.length; i++) {\n272\t      const b = buttons[i];\n273\t      const by = startY + 20 + i * 70;\n274\t      ctx.fillStyle = b.color + '20';\n275\t      this._roundRect(ctx, 20, by, w - 40, 60, 12);\n276\t      ctx.fill();\n277\t      ctx.strokeStyle = b.color;\n278\t      ctx.lineWidth = 2;\n279\t      this._roundRect(ctx, 20, by, w - 40, 60, 12);\n280\t      ctx.stroke();\n281\t\n282\t      ctx.font = '28px sans-serif';\n283\t      ctx.textAlign = 'center';\n284\t      ctx.fillText(b.emoji, w / 2 - 80, by + 38);\n285\t      ctx.textAlign = 'left';\n286\t      ctx.fillStyle = '#5D4037';\n287\t      ctx.font = 'bold 14px sans-serif';\n288\t      ctx.fillText(b.label, w / 2 - 50, by + 28);\n289\t      ctx.font = '11px sans-serif';\n290\t      ctx.fillStyle = '#8D6E63';\n291\t      ctx.fillText(b.desc, w / 2 - 50, by + 46);\n292\t    }\n293\t  }\n294\t\n295\t  handleClick(x, y, screenW, screenH) {\n296\t    // Tab clicks\n297\t    const tabs = 3;\n298\t    const tabW = (screenW - 40) / tabs;\n299\t    if (y >= 65 && y <= 95) {\n300\t      for (let i = 0; i < tabs; i++) {\n301\t        const tx = 20 + i * tabW;\n302\t        if (x >= tx && x <= tx + tabW - 4) {\n303\t          this._tab = i;\n304\t          return { action: 'switch_tab', tab: i };\n305\t        }\n306\t      }\n307\t    }\n308\t\n309\t    const tab = this._tab || 0;\n310\t    if (tab === 1) {\n311\t      // PK challenge buttons\n312\t      const startY = 108;\n313\t      const friends = this.social.friends.slice(0, 6);\n314\t      for (let i = 0; i < friends.length; i++) {\n315\t        const fy = startY + 14 + i * 52;\n316\t        if (x >= screenW - 90 && x <= screenW - 32 && y >= fy + 8 && y <= fy + 38) {\n317\t          return { action: 'pk', friendId: friends[i].id };\n318\t        }\n319\t      }\n320\t    }\n321\t\n322\t    if (tab === 2) {\n323\t      // Share buttons\n324\t      const startY = 108;\n325\t      for (let i = 0; i < 3; i++) {\n326\t        const by = startY + 20 + i * 70;\n327\t        if (x >= 20 && x <= screenW - 20 && y >= by && y <= by + 60) {\n328\t          if (i === 0) return { action: 'share_result' };\n329\t          if (i === 1) return { action: 'share_help' };\n330\t          if (i === 2) {\n331\t            this.social.shareCount++;\n332\t            this.dm.addCoins(20);\n333\t            this.dm.save();\n334\t            return { action: 'share_invite', reward: 20 };\n335\t          }\n336\t        }\n337\t      }\n338\t    }\n339\t\n340\t    // Back button\n341\t    if (y >= screenH - 50 && y <= screenH - 12 && x >= 20 && x <= screenW - 20) {\n342\t      return { action: 'back' };\n343\t    }\n344\t\n345\t    return null;\n346\t  }\n347\t\n348\t  _roundRect(ctx, x, y, w, h, r) {\n349\t    ctx.beginPath();\n350\t    ctx.moveTo(x + r, y);\n351\t    ctx.lineTo(x + w - r, y);\n352\t    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n353\t    ctx.lineTo(x + w, y + h - r);\n354\t    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n355\t    ctx.lineTo(x + r, y + h);\n356\t    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n357\t    ctx.lineTo(x, y + r);\n358\t    ctx.quadraticCurveTo(x, y, x + r, y);\n359\t    ctx.closePath();\n360\t  }\n361\t}\n362\t\n363\tif (typeof module !== 'undefined') module.exports = { SocialSystem };\n364\t"}]},"parent_tool_use_id":"call_c22664ff5a1c4110b7c383c9","session_id":"33562fd9-d4f0-45be-a2a4-d9d379182d9f","uuid":"b0743097-9fc2-4cb7-818d-440f803c8494","timestamp":"2026-05-23T10:12:39.808Z","subagent_type":"Explore","task_description":"Explore match3 game structure"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_eae83c7dd43440baa6e5b024","type":"tool_result","content":"1\t// Analytics.js — Data tracking: level events, ad events, social events, batch queue\n2\t\n3\tconst ANALYTICS_EVENTS = {\n4\t  GAME_START: 'game_start',\n5\t  TUTORIAL_STEP: 'tutorial_step',\n6\t  LEVEL_START: 'level_start',\n7\t  LEVEL_COMPLETE: 'level_complete',\n8\t  LEVEL_FAIL: 'level_fail',\n9\t  AD_SHOW: 'ad_show',\n10\t  AD_CLICK: 'ad_click',\n11\t  SHARE: 'share',\n12\t  SOCIAL_PK: 'social_pk',\n13\t  PURCHASE: 'purchase',\n14\t  DAILY_LOGIN: 'daily_login',\n15\t  RETENTION_D1: 'retention_d1',\n16\t};\n17\t\n18\tclass Analytics {\n19\t  constructor(dataManager) {\n20\t    this.dm = dataManager;\n21\t    this._initStorage();\n22\t\n23\t    this.isDouyin = typeof tt !== 'undefined';\n24\t    this.flushInterval = 30000; // 30s batch flush\n25\t    this.maxQueueSize = 50;\n26\t    this._flushTimer = null;\n27\t  }\n28\t\n29\t  _initStorage() {\n30\t    if (!this.dm.data.analytics) {\n31\t      this.dm.data.analytics = {\n32\t        userId: this.dm.data.social?.userId || 'u_' + Math.random().toString(36).slice(2, 10),\n33\t        sessionId: this._genSessionId(),\n34\t        queue: [],\n35\t        totalCount: 0,\n36\t        firstLaunch: Date.now(),\n37\t        lastActive: Date.now(),\n38\t      };\n39\t      this.dm.save();\n40\t    }\n41\t    this.data = this.dm.data.analytics;\n42\t  }\n43\t\n44\t  _genSessionId() {\n45\t    return Date.now().toString(36) + Math.random().toString(36).slice(2, 6);\n46\t  }\n47\t\n48\t  // --- Core track method ---\n49\t  track(eventName, params) {\n50\t    const event = {\n51\t      event: eventName,\n52\t      ts: Date.now(),\n53\t      session: this.data.sessionId,\n54\t      uid: this.data.userId,\n55\t      ...(params || {}),\n56\t    };\n57\t\n58\t    this.data.queue.push(event);\n59\t    this.data.totalCount++;\n60\t    this.data.lastActive = Date.now();\n61\t\n62\t    if (this.data.queue.length >= this.maxQueueSize) {\n63\t      this.flush();\n64\t    } else {\n65\t      this.dm.save();\n66\t    }\n67\t\n68\t    // Console log in dev\n69\t    if (!this.isDouyin && typeof console !== 'undefined' && console.debug) {\n70\t      console.debug(`[Analytics] ${eventName}`, params || '');\n71\t    }\n72\t  }\n73\t\n74\t  // --- Convenience methods ---\n75\t  trackGameStart() {\n76\t    this.track(ANALYTICS_EVENTS.GAME_START, {\n77\t      version: '1.0',\n78\t      platform: this.isDouyin ? 'douyin' : 'web',\n79\t    });\n80\t  }\n81\t\n82\t  trackLevelStart(levelNum, config) {\n83\t    this.track(ANALYTICS_EVENTS.LEVEL_START, {\n84\t      level: levelNum,\n85\t      moves: config.moves,\n86\t      goalType: config.goal?.type || 'score',\n87\t    });\n88\t  }\n89\t\n90\t  trackLevelComplete(levelNum, score, stars, movesUsed) {\n91\t    this.track(ANALYTICS_EVENTS.LEVEL_COMPLETE, {\n92\t      level: levelNum,\n93\t      score,\n94\t      stars,\n95\t      movesUsed,\n96\t      completionTime: Date.now(),\n97\t    });\n98\t  }\n99\t\n100\t  trackLevelFail(levelNum, score, movesUsed, goalProgress) {\n101\t    this.track(ANALYTICS_EVENTS.LEVEL_FAIL, {\n102\t      level: levelNum,\n103\t      score,\n104\t      movesUsed,\n105\t      goalProgress,\n106\t    });\n107\t  }\n108\t\n109\t  trackAdShow(placement, completed) {\n110\t    this.track(ANALYTICS_EVENTS.AD_SHOW, {\n111\t      placement,\n112\t      completed,\n113\t      adType: placement === AD_PLACEMENTS.INTERSTITIAL ? 'interstitial' : 'rewarded',\n114\t    });\n115\t  }\n116\t\n117\t  trackAdClick(placement) {\n118\t    this.track(ANALYTICS_EVENTS.AD_CLICK, { placement });\n119\t  }\n120\t\n121\t  trackShare(type, level) {\n122\t    this.track(ANALYTICS_EVENTS.SHARE, { type, level });\n123\t  }\n124\t\n125\t  trackSocialPK(result, friendId) {\n126\t    this.track(ANALYTICS_EVENTS.SOCIAL_PK, { result, friendId });\n127\t  }\n128\t\n129\t  trackDailyLogin(day) {\n130\t    this.track(ANALYTICS_EVENTS.DAILY_LOGIN, { day });\n131\t  }\n132\t\n133\t  trackTutorialStep(stepId, level) {\n134\t    this.track(ANALYTICS_EVENTS.TUTORIAL_STEP, { stepId, level });\n135\t  }\n136\t\n137\t  // --- Flush queue ---\n138\t  flush() {\n139\t    if (this.data.queue.length === 0) return;\n140\t\n141\t    const batch = this.data.queue.splice(0, this.maxQueueSize);\n142\t    this.dm.save();\n143\t\n144\t    if (this.isDouyin) {\n145\t      this._uploadToServer(batch);\n146\t    } else {\n147\t      // Dev mode: log batch\n148\t      if (typeof console !== 'undefined' && console.debug) {\n149\t        console.debug(`[Analytics] Flush ${batch.length} events`, batch);\n150\t      }\n151\t    }\n152\t  }\n153\t\n154\t  _uploadToServer(events) {\n155\t    try {\n156\t      // 抖音云开发 or custom server endpoint\n157\t      const request = tt.request || fetch;\n158\t      if (request) {\n159\t        request({\n160\t          url: 'https://analytics.example.com/events',\n161\t          method: 'POST',\n162\t          data: { events, appId: 'match-and-blast' },\n163\t        }).catch(() => {\n164\t          // Re-queue on failure\n165\t          this.data.queue.unshift(...events);\n166\t          this.dm.save();\n167\t        });\n168\t      }\n169\t    } catch (e) {\n170\t      // Silent fail — analytics never blocks gameplay\n171\t    }\n172\t  }\n173\t\n174\t  // --- Session management ---\n175\t  newSession() {\n176\t    this.data.sessionId = this._genSessionId();\n177\t    this.dm.save();\n178\t  }\n179\t\n180\t  getSessionDuration() {\n181\t    return Date.now() - (this.data.firstLaunch || Date.now());\n182\t  }\n183\t\n184\t  // --- Metrics helpers ---\n185\t  getRetentionInfo() {\n186\t    const first = this.data.firstLaunch;\n187\t    if (!first) return { isD1: false };\n188\t    const daysSince = Math.floor((Date.now() - first) / 86400000);\n189\t    return { isD1: daysSince === 1, daysSince };\n190\t  }\n191\t}\n192\t\n193\tif (typeof module !== 'undefined') module.exports = { Analytics, ANALYTICS_EVENTS };\n194\t"}]},"parent_tool_use_id":"call_c22664ff5a1c4110b7c383c9","session_id":"33562fd9-d4f0-45be-a2a4-d9d379182d9f","uuid":"d0210aad-3cea-4f17-8a4c-092199e5c70e","timestamp":"2026-05-23T10:12:39.991Z","subagent_type":"Explore","task_description":"Explore match3 game structure"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_05198ca910964df2978ed760","type":"tool_result","content":"1\t// AdManager.js — 穿山甲SDK广告管理，支持真实SDK + stub降级\n2\t// 广告位ID配置在 ad-config.js 中，提审前替换为真实ID\n3\t\n4\tconst AD_PLACEMENTS = {\n5\t  CONTINUE: 'continue',       // 续步激励视频（关卡失败）\n6\t  BOOST: 'boost',             // 开局增益激励视频\n7\t  DOUBLE: 'double',           // 双倍结算激励视频\n8\t  INTERSTITIAL: 'interstitial', // 插屏广告\n9\t  TREASURE: 'treasure',       // 宝箱加速激励视频\n10\t  DAILY_DOUBLE: 'daily_double', // 每日签到翻倍\n11\t};\n12\t\n13\tconst AD_LIMITS = {\n14\t  REWARDED_DAILY: 12,\n15\t  INTERSTITIAL_DAILY: 6,\n16\t  COOLDOWN_MS: 60000,\n17\t  NEW_USER_FREE_LEVELS: 3,\n18\t  INTERSTITIAL_LEVEL_INTERVAL: 3,\n19\t};\n20\t\n21\tclass AdManager {\n22\t  constructor(dataManager) {\n23\t    this.dm = dataManager;\n24\t    this._initStorage();\n25\t\n26\t    // SDK detection — use config if available, otherwise auto-detect\n27\t    const config = (typeof AD_CONFIG !== 'undefined') ? AD_CONFIG : null;\n28\t    this.isDouyin = config ? !config.devMode\n29\t      : (typeof tt !== 'undefined' && typeof tt.createRewardedVideoAd === 'function');\n30\t    this.rewardedAd = null;\n31\t    this.interstitialAd = null;\n32\t    this._loadRetry = 0;\n33\t    this._maxRetry = config ? config.loadRetryCount : 2;\n34\t    this._loadTimeout = config ? config.loadTimeout : 10000;\n35\t\n36\t    if (this.isDouyin) this._initSDK();\n37\t\n38\t    // State\n39\t    this._pendingResolve = null;\n40\t    this._currentPlacement = null;\n41\t    this._showingUI = false;\n42\t  }\n43\t\n44\t  _initStorage() {\n45\t    if (!this.dm.data.adState) {\n46\t      this.dm.data.adState = {\n47\t        dailyRewarded: 0,\n48\t        dailyInterstitial: 0,\n49\t        lastShowTime: {},\n50\t        lastInterstitialLevel: 0,\n51\t        date: this._todayStr(),\n52\t        consecutiveFails: 0,\n53\t      };\n54\t      this.dm.save();\n55\t    }\n56\t    this.adState = this.dm.data.adState;\n57\t    this._resetDaily();\n58\t  }\n59\t\n60\t  _todayStr() { return new Date().toISOString().slice(0, 10); }\n61\t\n62\t  _resetDaily() {\n63\t    if (this.adState.date !== this._todayStr()) {\n64\t      this.adState.dailyRewarded = 0;\n65\t      this.adState.dailyInterstitial = 0;\n66\t      this.adState.date = this._todayStr();\n67\t      this.dm.save();\n68\t    }\n69\t  }\n70\t\n71\t  _getAdUnitId(type) {\n72\t    const config = (typeof AD_CONFIG !== 'undefined') ? AD_CONFIG : null;\n73\t    if (config && config.adUnitIds && config.adUnitIds[type]) {\n74\t      return config.adUnitIds[type];\n75\t    }\n76\t    return `adunit-placeholder-${type}`;\n77\t  }\n78\t\n79\t  _initSDK() {\n80\t    try {\n81\t      const rewardedId = this._getAdUnitId('rewarded');\n82\t      this.rewardedAd = tt.createRewardedVideoAd({ adUnitId: rewardedId });\n83\t\n84\t      this.rewardedAd.onLoad(() => {\n85\t        this._loadRetry = 0;\n86\t      });\n87\t\n88\t      this.rewardedAd.onError((err) => {\n89\t        console.warn('[AdManager] Rewarded ad error:', err);\n90\t        if (this._loadRetry < this._maxRetry) {\n91\t          this._loadRetry++;\n92\t          setTimeout(() => this.rewardedAd.load(), 1000 * this._loadRetry);\n93\t        }\n94\t      });\n95\t\n96\t      this.rewardedAd.onClose((res) => {\n97\t        if (this._pendingResolve) {\n98\t          this._pendingResolve(res && res.isEnded);\n99\t          this._pendingResolve = null;\n100\t        }\n101\t      });\n102\t\n103\t      // Pre-load rewarded ad\n104\t      this.rewardedAd.load();\n105\t\n106\t      const interstitialId = this._getAdUnitId('interstitial');\n107\t      this.interstitialAd = tt.createInterstitialAd({ adUnitId: interstitialId });\n108\t\n109\t      this.interstitialAd.onLoad(() => {});\n110\t\n111\t      this.interstitialAd.onError((err) => {\n112\t        console.warn('[AdManager] Interstitial ad error:', err);\n113\t      });\n114\t    } catch (e) {\n115\t      console.warn('[AdManager] SDK init failed, falling back to stub:', e);\n116\t      this.isDouyin = false;\n117\t    }\n118\t  }\n119\t\n120\t  // --- Frequency checks ---\n121\t  isNewUser() {\n122\t    return this.dm.unlockedLevel <= AD_LIMITS.NEW_USER_FREE_LEVELS;\n123\t  }\n124\t\n125\t  canShowRewarded(placement) {\n126\t    this._resetDaily();\n127\t    if (this.isNewUser()) return false;\n128\t    if (this.adState.dailyRewarded >= AD_LIMITS.REWARDED_DAILY) return false;\n129\t    if (this._inCooldown(placement)) return false;\n130\t    return true;\n131\t  }\n132\t\n133\t  canShowInterstitial(currentLevel) {\n134\t    this._resetDaily();\n135\t    if (this.isNewUser()) return false;\n136\t    if (this.adState.dailyInterstitial >= AD_LIMITS.INTERSTITIAL_DAILY) return false;\n137\t    if (this.adState.consecutiveFails >= 2) return false;\n138\t    const lastLevel = this.adState.lastInterstitialLevel || 0;\n139\t    if (currentLevel - lastLevel < AD_LIMITS.INTERSTITIAL_LEVEL_INTERVAL) return false;\n140\t    if (this._inCooldown(AD_PLACEMENTS.INTERSTITIAL)) return false;\n141\t    return true;\n142\t  }\n143\t\n144\t  _inCooldown(placement) {\n145\t    const last = this.adState.lastShowTime[placement] || 0;\n146\t    return Date.now() - last < AD_LIMITS.COOLDOWN_MS;\n147\t  }\n148\t\n149\t  // --- Show rewarded video ---\n150\t  showRewarded(placement) {\n151\t    if (!this.canShowRewarded(placement)) return Promise.resolve(false);\n152\t\n153\t    this._currentPlacement = placement;\n154\t\n155\t    if (this.isDouyin && this.rewardedAd) {\n156\t      return new Promise((resolve) => {\n157\t        this._pendingResolve = resolve;\n158\t        this.rewardedAd.show().catch(() => {\n159\t          this.rewardedAd.load().then(() => {\n160\t            this.rewardedAd.show().catch(() => resolve(false));\n161\t          }).catch(() => resolve(false));\n162\t        });\n163\t      }).then((success) => {\n164\t        if (success) this._onAdComplete(placement);\n165\t        return success;\n166\t      });\n167\t    }\n168\t\n169\t    // Stub mode: simulate ad with a UI overlay\n170\t    return this._showStubAd(placement);\n171\t  }\n172\t\n173\t  // --- Show interstitial ---\n174\t  showInterstitial(currentLevel) {\n175\t    if (!this.canShowInterstitial(currentLevel)) return Promise.resolve(false);\n176\t\n177\t    if (this.isDouyin && this.interstitialAd) {\n178\t      return new Promise((resolve) => {\n179\t        this.interstitialAd.show().then(() => {\n180\t          this.adState.dailyInterstitial++;\n181\t          this.adState.lastInterstitialLevel = currentLevel;\n182\t          this.adState.lastShowTime[AD_PLACEMENTS.INTERSTITIAL] = Date.now();\n183\t          this.dm.save();\n184\t          setTimeout(() => resolve(true), 5000);\n185\t        }).catch(() => resolve(false));\n186\t      });\n187\t    }\n188\t\n189\t    // Stub: simulate 2s interstitial\n190\t    return new Promise((resolve) => {\n191\t      this._showingUI = true;\n192\t      this._stubInterstitial = true;\n193\t      this._stubTimer = 2;\n194\t      this.adState.dailyInterstitial++;\n195\t      this.adState.lastInterstitialLevel = currentLevel;\n196\t      this.adState.lastShowTime[AD_PLACEMENTS.INTERSTITIAL] = Date.now();\n197\t      this.dm.save();\n198\t      setTimeout(() => {\n199\t        this._showingUI = false;\n200\t        this._stubInterstitial = false;\n201\t        resolve(true);\n202\t      }, 2000);\n203\t    });\n204\t  }\n205\t\n206\t  _onAdComplete(placement) {\n207\t    this.adState.dailyRewarded++;\n208\t    this.adState.lastShowTime[placement] = Date.now();\n209\t    this.dm.save();\n210\t  }\n211\t\n212\t  // --- Stub ad simulation ---\n213\t  _showStubAd(placement) {\n214\t    return new Promise((resolve) => {\n215\t      this._showingUI = true;\n216\t      this._stubPlacement = placement;\n217\t      this._stubTimer = 3; // 3 second simulated ad\n218\t      this._stubResolve = resolve;\n219\t    });\n220\t  }\n221\t\n222\t  _completeStubAd(watched) {\n223\t    this._showingUI = false;\n224\t    if (watched) this._onAdComplete(this._stubPlacement);\n225\t    if (this._stubResolve) {\n226\t      this._stubResolve(watched);\n227\t      this._stubResolve = null;\n228\t    }\n229\t  }\n230\t\n231\t  // --- Fail tracking for interstitial suppression ---\n232\t  reportFail() {\n233\t    this.adState.consecutiveFails++;\n234\t    this.dm.save();\n235\t  }\n236\t\n237\t  reportSuccess() {\n238\t    this.adState.consecutiveFails = 0;\n239\t    this.dm.save();\n240\t  }\n241\t\n242\t  // --- Rendering (stub ad UI) ---\n243\t  update(dt) {\n244\t    if (this._stubTimer > 0) {\n245\t      this._stubTimer -= dt;\n246\t    }\n247\t  }\n248\t\n249\t  renderStubAd(ctx, w, h) {\n250\t    if (!this._showingUI) return false;\n251\t\n252\t    if (this._stubInterstitial) {\n253\t      // Interstitial overlay\n254\t      ctx.fillStyle = 'rgba(0,0,0,0.85)';\n255\t      ctx.fillRect(0, 0, w, h);\n256\t\n257\t      ctx.fillStyle = '#FFF';\n258\t      ctx.font = 'bold 20px sans-serif';\n259\t      ctx.textAlign = 'center';\n260\t      ctx.fillText('📢 广告', w / 2, h / 2 - 30);\n261\t\n262\t      ctx.font = '14px sans-serif';\n263\t      ctx.fillStyle = '#CCC';\n264\t      ctx.fillText('插屏广告模拟', w / 2, h / 2);\n265\t\n266\t      const remaining = Math.ceil(this._stubTimer);\n267\t      ctx.font = 'bold 24px sans-serif';\n268\t      ctx.fillStyle = '#FFB800';\n269\t      ctx.fillText(`${remaining}s`, w / 2, h / 2 + 40);\n270\t      return true;\n271\t    }\n272\t\n273\t    // Rewarded video stub\n274\t    ctx.fillStyle = 'rgba(0,0,0,0.9)';\n275\t    ctx.fillRect(0, 0, w, h);\n276\t\n277\t    // Fake ad content\n278\t    ctx.fillStyle = '#FFB800';\n279\t    ctx.font = 'bold 18px sans-serif';\n280\t    ctx.textAlign = 'center';\n281\t    ctx.fillText('🎬 激励视频广告', w / 2, h / 2 - 60);\n282\t\n283\t    ctx.fillStyle = '#FFF';\n284\t    ctx.font = '14px sans-serif';\n285\t    ctx.fillText(`广告位: ${this._stubPlacement}`, w / 2, h / 2 - 30);\n286\t    ctx.fillText('（开发模式模拟广告）', w / 2, h / 2);\n287\t\n288\t    // Countdown\n289\t    const remaining = Math.ceil(this._stubTimer);\n290\t    if (remaining > 0) {\n291\t      ctx.font = 'bold 32px sans-serif';\n292\t      ctx.fillStyle = '#FFB800';\n293\t      ctx.fillText(`${remaining}s`, w / 2, h / 2 + 50);\n294\t    }\n295\t\n296\t    // Close/complete button (appears after timer)\n297\t    if (remaining <= 0) {\n298\t      const btnW = 160, btnH = 44;\n299\t      const btnX = (w - btnW) / 2, btnY = h / 2 + 70;\n300\t      ctx.fillStyle = '#6BCB77';\n301\t      this._roundRect(ctx, btnX, btnY, btnW, btnH, btnH / 2);\n302\t      ctx.fill();\n303\t      ctx.fillStyle = '#FFF';\n304\t      ctx.font = 'bold 16px sans-serif';\n305\t      ctx.fillText('✓ 观看完成', w / 2, btnY + 28);\n306\t\n307\t      // Skip button\n308\t      ctx.fillStyle = '#666';\n309\t      ctx.font = '12px sans-serif';\n310\t      ctx.fillText('跳过（无奖励）', w / 2, btnY + btnH + 24);\n311\t    }\n312\t\n313\t    return true;\n314\t  }\n315\t\n316\t  handleStubClick(x, y, w, h) {\n317\t    if (!this._showingUI || this._stubInterstitial) return false;\n318\t    if (this._stubTimer > 0) return true; // consume click during countdown\n319\t\n320\t    const btnW = 160, btnH = 44;\n321\t    const btnX = (w - btnW) / 2, btnY = h / 2 + 70;\n322\t\n323\t    // Complete button\n324\t    if (x >= btnX && x <= btnX + btnW && y >= btnY && y <= btnY + btnH) {\n325\t      this._completeStubAd(true);\n326\t      return true;\n327\t    }\n328\t\n329\t    // Skip area\n330\t    if (y >= btnY + btnH && y <= btnY + btnH + 40) {\n331\t      this._completeStubAd(false);\n332\t      return true;\n333\t    }\n334\t\n335\t    return true; // consume all clicks while ad showing\n336\t  }\n337\t\n338\t  // --- Ad button helper for UI ---\n339\t  static shouldShowAdButton(adManager, placement) {\n340\t    return adManager && adManager.canShowRewarded(placement);\n341\t  }\n342\t\n343\t  _roundRect(ctx, x, y, w, h, r) {\n344\t    ctx.beginPath();\n345\t    ctx.moveTo(x + r, y);\n346\t    ctx.lineTo(x + w - r, y);\n347\t    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n348\t    ctx.lineTo(x + w, y + h - r);\n349\t    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n350\t    ctx.lineTo(x + r, y + h);\n351\t    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n352\t    ctx.lineTo(x, y + r);\n353\t    ctx.quadraticCurveTo(x, y, x + r, y);\n354\t    ctx.closePath();\n355\t  }\n356\t}\n357\t\n358\tif (typeof module !== 'undefined') module.exports = { AdManager, AD_PLACEMENTS, AD_LIMITS };\n359\t"}]},"parent_tool_use_id":"call_c22664ff5a1c4110b7c383c9","session_id":"33562fd9-d4f0-45be-a2a4-d9d379182d9f","uuid":"1bedd862-6ca0-4ad5-8494-db0404a002a1","timestamp":"2026-05-23T10:12:40.154Z","subagent_type":"Explore","task_description":"Explore match3 game structure"}
