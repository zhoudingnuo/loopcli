{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_767d22b6d4e8461ba703e1a4","type":"tool_result","content":"1\t/**\n2\t * Mobile Compatibility Tests for 成语大闯关 (Idiom Master)\n3\t * Tests: touch handling, text input, scroll lists, DOM interaction, tt.* API\n4\t */\n5\t\n6\tconst fs = require('fs');\n7\tconst path = require('path');\n8\t\n9\tconst SRC = path.resolve(__dirname, '../src/js');\n10\tconst CSS = fs.readFileSync(path.resolve(__dirname, '../src/css/style.css'), 'utf-8');\n11\tconst HTML = fs.readFileSync(path.resolve(__dirname, '../index.html'), 'utf-8');\n12\t\n13\tfunction readSrc(name) {\n14\t  return fs.readFileSync(path.join(SRC, name), 'utf-8');\n15\t}\n16\t\n17\t// ============================================================\n18\t// 1. Touch & Interaction Tests\n19\t// ============================================================\n20\tdescribe('Touch Interaction Handling', () => {\n21\t  const htmlSrc = HTML;\n22\t  const cssSrc = CSS;\n23\t\n24\t  test('All interactive buttons use onclick handlers', () => {\n25\t    const onclickCount = (htmlSrc.match(/onclick/g) || []).length;\n26\t    expect(onclickCount).toBeGreaterThan(10);\n27\t  });\n28\t\n29\t  test('No confirm() dialogs blocking mobile interaction', () => {\n30\t    expect(htmlSrc).not.toMatch(/confirm\\s*\\(/);\n31\t  });\n32\t\n33\t  test('Body has touch-action: manipulation for proper touch response', () => {\n34\t    expect(cssSrc).toMatch(/touch-action\\s*:\\s*manipulation/);\n35\t  });\n36\t\n37\t  test('User selection disabled to prevent text selection on touch', () => {\n38\t    expect(cssSrc).toMatch(/user-select\\s*:\\s*none/);\n39\t  });\n40\t\n41\t  test('Buttons have :active state for touch feedback', () => {\n42\t    expect(cssSrc).toMatch(/\\.btn:active/);\n43\t    expect(cssSrc).toMatch(/\\.candidate:active/);\n44\t  });\n45\t\n46\t  test('Interactive elements use cursor: pointer', () => {\n47\t    expect(cssSrc).toMatch(/cursor\\s*:\\s*pointer/);\n48\t  });\n49\t\n50\t  test('Used candidates have pointer-events: none to prevent re-tap', () => {\n51\t    expect(cssSrc).toMatch(/pointer-events\\s*:\\s*none/);\n52\t  });\n53\t\n54\t  test('Locked level buttons have pointer-events: none', () => {\n55\t    expect(cssSrc).toMatch(/\\.level-btn\\.locked.*pointer-events\\s*:\\s*none/s);\n56\t  });\n57\t});\n58\t\n59\t// ============================================================\n60\t// 2. Text Input Mobile Adaptation Tests\n61\t// ============================================================\n62\tdescribe('Text Input Adaptation', () => {\n63\t  const htmlSrc = HTML;\n64\t\n65\t  test('Search input has autocomplete=\"off\"', () => {\n66\t    expect(htmlSrc).toMatch(/autocomplete\\s*=\\s*['\"]off['\"]/);\n67\t  });\n68\t\n69\t  test('Search input has autocapitalize=\"none\"', () => {\n70\t    expect(htmlSrc).toMatch(/autocapitalize\\s*=\\s*['\"]none['\"]/);\n71\t  });\n72\t\n73\t  test('Search input has enterkeyhint for mobile keyboard', () => {\n74\t    expect(htmlSrc).toMatch(/enterkeyhint/);\n75\t  });\n76\t\n77\t  test('Search input uses oninput for real-time filtering', () => {\n78\t    expect(htmlSrc).toMatch(/oninput\\s*=\\s*['\"]handleColSearch/);\n79\t  });\n80\t\n81\t  test('Search input has proper styling with focus state', () => {\n82\t    const cssSrc = CSS;\n83\t    expect(cssSrc).toMatch(/\\.col-search:focus/);\n84\t  });\n85\t});\n86\t\n87\t// ============================================================\n88\t// 3. Scroll List Touch Performance Tests\n89\t// ============================================================\n90\tdescribe('Scroll List Touch Performance', () => {\n91\t  const cssSrc = CSS;\n92\t\n93\t  test('Level grid has overflow-y: auto for scrolling', () => {\n94\t    expect(cssSrc).toMatch(/\\.level-grid[\\s\\S]*overflow-y\\s*:\\s*auto/);\n95\t  });\n96\t\n97\t  test('Scrollable areas use -webkit-overflow-scrolling: touch', () => {\n98\t    expect(cssSrc).toMatch(/-webkit-overflow-scrolling\\s*:\\s*touch/);\n99\t  });\n100\t\n101\t  test('Collection grid uses CSS grid for efficient layout', () => {\n102\t    expect(cssSrc).toMatch(/display\\s*:\\s*grid/);\n103\t  });\n104\t\n105\t  test('Collection grid has overflow-y: auto', () => {\n106\t    expect(cssSrc).toMatch(/\\.col-grid[\\s\\S]*overflow-y\\s*:\\s*auto/);\n107\t  });\n108\t\n109\t  test('Character grid has overflow-y: auto', () => {\n110\t    expect(cssSrc).toMatch(/\\.char-grid[\\s\\S]*overflow-y\\s*:\\s*auto/);\n111\t  });\n112\t\n113\t  test('Daily content scrollable', () => {\n114\t    expect(cssSrc).toMatch(/\\.daily-content[\\s\\S]*overflow-y\\s*:\\s*auto/);\n115\t  });\n116\t});\n117\t\n118\t// ============================================================\n119\t// 4. Screen Layout & Responsiveness Tests\n120\t// ============================================================\n121\tdescribe('Screen Layout Responsiveness', () => {\n122\t  const cssSrc = CSS;\n123\t  const htmlSrc = HTML;\n124\t\n125\t  test('App container has max-width for phone optimization', () => {\n126\t    expect(cssSrc).toMatch(/max-width\\s*:\\s*480px/);\n127\t  });\n128\t\n129\t  test('App centered with margin auto', () => {\n130\t    expect(cssSrc).toMatch(/margin\\s*:\\s*0\\s*auto/);\n131\t  });\n132\t\n133\t  test('Body has overflow: hidden to prevent scroll bounce', () => {\n134\t    expect(cssSrc).toMatch(/overflow\\s*:\\s*hidden/);\n135\t  });\n136\t\n137\t  test('Screens use flex layout', () => {\n138\t    expect(cssSrc).toMatch(/display\\s*:\\s*flex/);\n139\t  });\n140\t\n141\t  test('Viewport meta prevents zooming', () => {\n142\t    expect(htmlSrc).toMatch(/user-scalable\\s*=\\s*no/);\n143\t    expect(htmlSrc).toMatch(/maximum-scale\\s*=\\s*1\\.0/);\n144\t  });\n145\t\n146\t  test('Slot sizes are fixed for consistent touch targets', () => {\n147\t    expect(cssSrc).toMatch(/\\.slot[\\s\\S]*width\\s*:\\s*60px/);\n148\t    expect(cssSrc).toMatch(/\\.slot[\\s\\S]*height\\s*:\\s*60px/);\n149\t  });\n150\t\n151\t  test('Candidate button sizes adequate for touch (>=44px)', () => {\n152\t    expect(cssSrc).toMatch(/\\.candidate[\\s\\S]*width\\s*:\\s*48px/);\n153\t    expect(cssSrc).toMatch(/\\.candidate[\\s\\S]*height\\s*:\\s*48px/);\n154\t  });\n155\t});\n156\t\n157\t// ============================================================\n158\t// 5. Douyin API (tt.*) Integration Tests\n159\t// ============================================================\n160\tdescribe('Douyin tt.* API Integration', () => {\n161\t  const adSrc = readSrc('AdManager.js');\n162\t  const socialSrc = readSrc('SocialManager.js');\n163\t\n164\t  test('AdManager detects Douyin environment', () => {\n165\t    expect(adSrc).toMatch(/typeof\\s+tt\\s*!==?\\s*['\"]undefined['\"]/);\n166\t  });\n167\t\n168\t  test('AdManager creates rewarded video ad via tt API', () => {\n169\t    expect(adSrc).toMatch(/tt\\.createRewardedVideoAd/);\n170\t  });\n171\t\n172\t  test('AdManager creates interstitial ad via tt API', () => {\n173\t    expect(adSrc).toMatch(/tt\\.createInterstitialAd/);\n174\t  });\n175\t\n176\t  test('AdManager has DOM-based stub ad overlay for development', () => {\n177\t    expect(adSrc).toMatch(/stub-ad-overlay|_renderStubUI/);\n178\t  });\n179\t\n180\t  test('AdManager stub overlay has proper z-index to cover game', () => {\n181\t    expect(adSrc).toMatch(/z-index\\s*:\\s*10000|zIndex.*10000/);\n182\t  });\n183\t\n184\t  test('SocialManager uses tt.shareAppMessage', () => {\n185\t    expect(socialSrc).toMatch(/tt\\.shareAppMessage/);\n186\t  });\n187\t\n188\t  test('SocialManager checks tt availability before use', () => {\n189\t    expect(socialSrc).toMatch(/typeof\\s+tt\\s*!==?\\s*['\"]undefined['\"]/);\n190\t  });\n191\t});\n192\t\n193\t// ============================================================\n194\t// 6. Game Logic Mobile Safety Tests\n195\t// ============================================================\n196\tdescribe('Game Logic Mobile Safety', () => {\n197\t  const gameSrc = readSrc('Game.js');\n198\t  const rendererSrc = readSrc('Renderer.js');\n199\t\n200\t  test('Game state prevents input during non-playing states', () => {\n201\t    expect(gameSrc).toMatch(/state\\s*!==?\\s*['\"]playing['\"]/);\n202\t  });\n203\t\n204\t  test('DOM re-rendering triggered on state changes', () => {\n205\t    expect(gameSrc).toMatch(/this\\.render\\s*\\(\\s*\\)/);\n206\t  });\n207\t\n208\t  test('Renderer clears all screens before showing active one', () => {\n209\t    expect(rendererSrc).toMatch(/screens\\.forEach/);\n210\t    expect(rendererSrc).toMatch(/classList\\.remove\\(['\"]active['\"]\\)/);\n211\t  });\n212\t\n213\t  test('Slots dynamically created with onclick handlers', () => {\n214\t    expect(rendererSrc).toMatch(/slot\\.onclick/);\n215\t  });\n216\t\n217\t  test('Candidates dynamically created with onclick handlers', () => {\n218\t    expect(rendererSrc).toMatch(/btn\\.onclick/);\n219\t  });\n220\t\n221\t  test('Used/removed candidates have proper disabled styling', () => {\n222\t    expect(rendererSrc).toMatch(/classList\\.add\\s*\\(\\s*['\"]used['\"]\\)/);\n223\t    expect(rendererSrc).toMatch(/classList\\.add\\s*\\(\\s*['\"]removed['\"]\\)/);\n224\t  });\n225\t});\n226\t"}]},"parent_tool_use_id":null,"session_id":"7463fb62-2e03-4edd-abad-466ff792dff1","uuid":"cdc4462f-8d73-44f6-9e3d-a41973f30640","timestamp":"2026-05-23T10:41:53.180Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/test/mobile-compat.test.js","content":"/**\n * Mobile Compatibility Tests for 成语大闯关 (Idiom Master)\n * Tests: touch handling, text input, scroll lists, DOM interaction, tt.* API\n */\n\nconst fs = require('fs');\nconst path = require('path');\n\nconst SRC = path.resolve(__dirname, '../src/js');\nconst CSS = fs.readFileSync(path.resolve(__dirname, '../src/css/style.css'), 'utf-8');\nconst HTML = fs.readFileSync(path.resolve(__dirname, '../index.html'), 'utf-8');\n\nfunction readSrc(name) {\n  return fs.readFileSync(path.join(SRC, name), 'utf-8');\n}\n\n// ============================================================\n// 1. Touch & Interaction Tests\n// ============================================================\ndescribe('Touch Interaction Handling', () => {\n  const htmlSrc = HTML;\n  const cssSrc = CSS;\n\n  test('All interactive buttons use onclick handlers', () => {\n    const onclickCount = (htmlSrc.match(/onclick/g) || []).length;\n    expect(onclickCount).toBeGreaterThan(10);\n  });\n\n  test('No confirm() dialogs blocking mobile interaction', () => {\n    expect(htmlSrc).not.toMatch(/confirm\\s*\\(/);\n  });\n\n  test('Body has touch-action: manipulation for proper touch response', () => {\n    expect(cssSrc).toMatch(/touch-action\\s*:\\s*manipulation/);\n  });\n\n  test('User selection disabled to prevent text selection on touch', () => {\n    expect(cssSrc).toMatch(/user-select\\s*:\\s*none/);\n  });\n\n  test('Buttons have :active state for touch feedback', () => {\n    expect(cssSrc).toMatch(/\\.btn:active/);\n    expect(cssSrc).toMatch(/\\.candidate:active/);\n  });\n\n  test('Interactive elements use cursor: pointer', () => {\n    expect(cssSrc).toMatch(/cursor\\s*:\\s*pointer/);\n  });\n\n  test('Used candidates have pointer-events: none to prevent re-tap', () => {\n    expect(cssSrc).toMatch(/pointer-events\\s*:\\s*none/);\n  });\n\n  test('Locked level buttons have pointer-events: none', () => {\n    expect(cssSrc).toMatch(/\\.level-btn\\.locked.*pointer-events\\s*:\\s*none/s);\n  });\n});\n\n// ============================================================\n// 2. Text Input Mobile Adaptation Tests\n// ============================================================\ndescribe('Text Input Adaptation', () => {\n  const htmlSrc = HTML;\n\n  test('Search input has autocomplete=\"off\"', () => {\n    expect(htmlSrc).toMatch(/autocomplete\\s*=\\s*['\"]off['\"]/);\n  });\n\n  test('Search input has autocapitalize=\"none\"', () => {\n    expect(htmlSrc).toMatch(/autocapitalize\\s*=\\s*['\"]none['\"]/);\n  });\n\n  test('Search input has enterkeyhint for mobile keyboard', () => {\n    expect(htmlSrc).toMatch(/enterkeyhint/);\n  });\n\n  test('Search input uses oninput for real-time filtering', () => {\n    expect(htmlSrc).toMatch(/oninput\\s*=\\s*['\"]handleColSearch/);\n  });\n\n  test('Search input has proper styling with focus state', () => {\n    const cssSrc = CSS;\n    expect(cssSrc).toMatch(/\\.col-search:focus/);\n  });\n});\n\n// ============================================================\n// 3. Scroll List Touch Performance Tests\n// ============================================================\ndescribe('Scroll List Touch Performance', () => {\n  const cssSrc = CSS;\n\n  test('Level grid has overflow-y: auto for scrolling', () => {\n    expect(cssSrc).toMatch(/\\.level-grid[\\s\\S]*overflow-y\\s*:\\s*auto/);\n  });\n\n  test('Scrollable areas use -webkit-overflow-scrolling: touch', () => {\n    expect(cssSrc).toMatch(/-webkit-overflow-scrolling\\s*:\\s*touch/);\n  });\n\n  test('Collection grid uses CSS grid for efficient layout', () => {\n    expect(cssSrc).toMatch(/display\\s*:\\s*grid/);\n  });\n\n  test('Collection grid has overflow-y: auto', () => {\n    expect(cssSrc).toMatch(/\\.col-grid[\\s\\S]*overflow-y\\s*:\\s*auto/);\n  });\n\n  test('Character grid has overflow-y: auto', () => {\n    expect(cssSrc).toMatch(/\\.char-grid[\\s\\S]*overflow-y\\s*:\\s*auto/);\n  });\n\n  test('Daily content scrollable', () => {\n    expect(cssSrc).toMatch(/\\.daily-content[\\s\\S]*overflow-y\\s*:\\s*auto/);\n  });\n});\n\n// ============================================================\n// 4. Screen Layout & Responsiveness Tests\n// ============================================================\ndescribe('Screen Layout Responsiveness', () => {\n  const cssSrc = CSS;\n  const htmlSrc = HTML;\n\n  test('App container has max-width for phone optimization', () => {\n    expect(cssSrc).toMatch(/max-width\\s*:\\s*480px/);\n  });\n\n  test('App centered with margin auto', () => {\n    expect(cssSrc).toMatch(/margin\\s*:\\s*0\\s*auto/);\n  });\n\n  test('Body has overflow: hidden to prevent scroll bounce', () => {\n    expect(cssSrc).toMatch(/overflow\\s*:\\s*hidden/);\n  });\n\n  test('Screens use flex layout', () => {\n    expect(cssSrc).toMatch(/display\\s*:\\s*flex/);\n  });\n\n  test('Viewport meta prevents zooming', () => {\n    expect(htmlSrc).toMatch(/user-scalable\\s*=\\s*no/);\n    expect(htmlSrc).toMatch(/maximum-scale\\s*=\\s*1\\.0/);\n  });\n\n  test('Slot sizes are fixed for consistent touch targets', () => {\n    expect(cssSrc).toMatch(/\\.slot[\\s\\S]*width\\s*:\\s*60px/);\n    expect(cssSrc).toMatch(/\\.slot[\\s\\S]*height\\s*:\\s*60px/);\n  });\n\n  test('Candidate button sizes adequate for touch (>=44px)', () => {\n    expect(cssSrc).toMatch(/\\.candidate[\\s\\S]*width\\s*:\\s*48px/);\n    expect(cssSrc).toMatch(/\\.candidate[\\s\\S]*height\\s*:\\s*48px/);\n  });\n});\n\n// ============================================================\n// 5. Douyin API (tt.*) Integration Tests\n// ============================================================\ndescribe('Douyin tt.* API Integration', () => {\n  const adSrc = readSrc('AdManager.js');\n  const socialSrc = readSrc('SocialManager.js');\n\n  test('AdManager detects Douyin environment', () => {\n    expect(adSrc).toMatch(/typeof\\s+tt\\s*!==?\\s*['\"]undefined['\"]/);\n  });\n\n  test('AdManager creates rewarded video ad via tt API', () => {\n    expect(adSrc).toMatch(/tt\\.createRewardedVideoAd/);\n  });\n\n  test('AdManager creates interstitial ad via tt API', () => {\n    expect(adSrc).toMatch(/tt\\.createInterstitialAd/);\n  });\n\n  test('AdManager has DOM-based stub ad overlay for development', () => {\n    expect(adSrc).toMatch(/stub-ad-overlay|_renderStubUI/);\n  });\n\n  test('AdManager stub overlay has proper z-index to cover game', () => {\n    expect(adSrc).toMatch(/z-index\\s*:\\s*10000|zIndex.*10000/);\n  });\n\n  test('SocialManager uses tt.shareAppMessage', () => {\n    expect(socialSrc).toMatch(/tt\\.shareAppMessage/);\n  });\n\n  test('SocialManager checks tt availability before use', () => {\n    expect(socialSrc).toMatch(/typeof\\s+tt\\s*!==?\\s*['\"]undefined['\"]/);\n  });\n});\n\n// ============================================================\n// 6. Game Logic Mobile Safety Tests\n// ============================================================\ndescribe('Game Logic Mobile Safety', () => {\n  const gameSrc = readSrc('Game.js');\n  const rendererSrc = readSrc('Renderer.js');\n\n  test('Game state prevents input during non-playing states', () => {\n    expect(gameSrc).toMatch(/state\\s*!==?\\s*['\"]playing['\"]/);\n  });\n\n  test('DOM re-rendering triggered on state changes', () => {\n    expect(gameSrc).toMatch(/this\\.render\\s*\\(\\s*\\)/);\n  });\n\n  test('Renderer clears all screens before showing active one', () => {\n    expect(rendererSrc).toMatch(/screens\\.forEach/);\n    expect(rendererSrc).toMatch(/classList\\.remove\\(['\"]active['\"]\\)/);\n  });\n\n  test('Slots dynamically created with onclick handlers', () => {\n    expect(rendererSrc).toMatch(/slot\\.onclick/);\n  });\n\n  test('Candidates dynamically created with onclick handlers', () => {\n    expect(rendererSrc).toMatch(/btn\\.onclick/);\n  });\n\n  test('Used/removed candidates have proper disabled styling', () => {\n    expect(rendererSrc).toMatch(/classList\\.add\\s*\\(\\s*['\"]used['\"]\\)/);\n    expect(rendererSrc).toMatch(/classList\\.add\\s*\\(\\s*['\"]removed['\"]\\)/);\n  });\n});\n","numLines":226,"startLine":1,"totalLines":226}}}
