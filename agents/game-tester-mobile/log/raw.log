{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_36681a73c3f04beda0b399e2","type":"tool_result","content":"1\t// InputHandler.js — Touch and mouse input handling for swipe detection\n2\t\n3\tclass InputHandler {\n4\t  constructor(canvas, board) {\n5\t    this.canvas = canvas;\n6\t    this.board = board;\n7\t    this.tileSize = 0;\n8\t    this.boardX = 0;\n9\t    this.boardY = 0;\n10\t\n11\t    this.swipeStart = null;\n12\t    this.selectedTile = null;\n13\t    this.onSwap = null;         // (r1, c1, r2, c2) => void\n14\t    this.onTap = null;          // (row, col) => void\n15\t    this.enabled = true;\n16\t\n17\t    this._bindEvents();\n18\t  }\n19\t\n20\t  updateLayout(tileSize, boardX, boardY) {\n21\t    this.tileSize = tileSize;\n22\t    this.boardX = boardX;\n23\t    this.boardY = boardY;\n24\t  }\n25\t\n26\t  _bindEvents() {\n27\t    // Mouse events\n28\t    this.canvas.addEventListener('mousedown', e => this._onPointerDown(e.clientX, e.clientY));\n29\t    this.canvas.addEventListener('mousemove', e => this._onPointerMove(e.clientX, e.clientY));\n30\t    this.canvas.addEventListener('mouseup', e => this._onPointerUp(e.clientX, e.clientY));\n31\t\n32\t    // Touch events\n33\t    this.canvas.addEventListener('touchstart', e => {\n34\t      e.preventDefault();\n35\t      const t = e.touches[0];\n36\t      this._onPointerDown(t.clientX, t.clientY);\n37\t    }, { passive: false });\n38\t\n39\t    this.canvas.addEventListener('touchmove', e => {\n40\t      e.preventDefault();\n41\t      const t = e.touches[0];\n42\t      this._onPointerMove(t.clientX, t.clientY);\n43\t    }, { passive: false });\n44\t\n45\t    this.canvas.addEventListener('touchend', e => {\n46\t      e.preventDefault();\n47\t      const t = e.changedTouches[0];\n48\t      this._onPointerUp(t.clientX, t.clientY);\n49\t    }, { passive: false });\n50\t  }\n51\t\n52\t  _screenToGrid(x, y) {\n53\t    const col = Math.floor((x - this.boardX) / this.tileSize);\n54\t    const row = Math.floor((y - this.boardY) / this.tileSize);\n55\t    if (row >= 0 && row < this.board.size && col >= 0 && col < this.board.size) {\n56\t      return { row, col };\n57\t    }\n58\t    return null;\n59\t  }\n60\t\n61\t  _onPointerDown(x, y) {\n62\t    if (!this.enabled) return;\n63\t    const cell = this._screenToGrid(x, y);\n64\t    if (!cell) return;\n65\t    this.swipeStart = { x, y, row: cell.row, col: cell.col };\n66\t  }\n67\t\n68\t  _onPointerMove(x, y) {\n69\t    // Could use for drag visualization\n70\t  }\n71\t\n72\t  _onPointerUp(x, y) {\n73\t    if (!this.enabled || !this.swipeStart) return;\n74\t    const start = this.swipeStart;\n75\t    this.swipeStart = null;\n76\t\n77\t    const dx = x - start.x;\n78\t    const dy = y - start.y;\n79\t    const dist = Math.sqrt(dx * dx + dy * dy);\n80\t\n81\t    // Minimum swipe distance threshold\n82\t    if (dist < this.tileSize * 0.2) {\n83\t      // Tap — treat as selection or swap trigger\n84\t      if (this.onTap) this.onTap(start.row, start.col);\n85\t      this._lastInteraction = 'tap';\n86\t      return;\n87\t    }\n88\t\n89\t    this._lastInteraction = 'swipe';\n90\t\n91\t    // Determine swipe direction\n92\t    let targetRow = start.row;\n93\t    let targetCol = start.col;\n94\t    if (Math.abs(dx) > Math.abs(dy)) {\n95\t      targetCol += dx > 0 ? 1 : -1;\n96\t    } else {\n97\t      targetRow += dy > 0 ? 1 : -1;\n98\t    }\n99\t\n100\t    // Validate\n101\t    if (this.board.isValid(targetRow, targetCol)) {\n102\t      if (this.onSwap) {\n103\t        this.onSwap(start.row, start.col, targetRow, targetCol);\n104\t      }\n105\t    }\n106\t  }\n107\t}\n108\t\n109\tif (typeof module !== 'undefined') module.exports = { InputHandler };\n110\t"}]},"parent_tool_use_id":null,"session_id":"33562fd9-d4f0-45be-a2a4-d9d379182d9f","uuid":"3eb8715d-e413-4b9f-9a37-62ea3fbbd6dc","timestamp":"2026-05-23T10:17:22.896Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-match3/src/js/InputHandler.js","content":"// InputHandler.js — Touch and mouse input handling for swipe detection\n\nclass InputHandler {\n  constructor(canvas, board) {\n    this.canvas = canvas;\n    this.board = board;\n    this.tileSize = 0;\n    this.boardX = 0;\n    this.boardY = 0;\n\n    this.swipeStart = null;\n    this.selectedTile = null;\n    this.onSwap = null;         // (r1, c1, r2, c2) => void\n    this.onTap = null;          // (row, col) => void\n    this.enabled = true;\n\n    this._bindEvents();\n  }\n\n  updateLayout(tileSize, boardX, boardY) {\n    this.tileSize = tileSize;\n    this.boardX = boardX;\n    this.boardY = boardY;\n  }\n\n  _bindEvents() {\n    // Mouse events\n    this.canvas.addEventListener('mousedown', e => this._onPointerDown(e.clientX, e.clientY));\n    this.canvas.addEventListener('mousemove', e => this._onPointerMove(e.clientX, e.clientY));\n    this.canvas.addEventListener('mouseup', e => this._onPointerUp(e.clientX, e.clientY));\n\n    // Touch events\n    this.canvas.addEventListener('touchstart', e => {\n      e.preventDefault();\n      const t = e.touches[0];\n      this._onPointerDown(t.clientX, t.clientY);\n    }, { passive: false });\n\n    this.canvas.addEventListener('touchmove', e => {\n      e.preventDefault();\n      const t = e.touches[0];\n      this._onPointerMove(t.clientX, t.clientY);\n    }, { passive: false });\n\n    this.canvas.addEventListener('touchend', e => {\n      e.preventDefault();\n      const t = e.changedTouches[0];\n      this._onPointerUp(t.clientX, t.clientY);\n    }, { passive: false });\n  }\n\n  _screenToGrid(x, y) {\n    const col = Math.floor((x - this.boardX) / this.tileSize);\n    const row = Math.floor((y - this.boardY) / this.tileSize);\n    if (row >= 0 && row < this.board.size && col >= 0 && col < this.board.size) {\n      return { row, col };\n    }\n    return null;\n  }\n\n  _onPointerDown(x, y) {\n    if (!this.enabled) return;\n    const cell = this._screenToGrid(x, y);\n    if (!cell) return;\n    this.swipeStart = { x, y, row: cell.row, col: cell.col };\n  }\n\n  _onPointerMove(x, y) {\n    // Could use for drag visualization\n  }\n\n  _onPointerUp(x, y) {\n    if (!this.enabled || !this.swipeStart) return;\n    const start = this.swipeStart;\n    this.swipeStart = null;\n\n    const dx = x - start.x;\n    const dy = y - start.y;\n    const dist = Math.sqrt(dx * dx + dy * dy);\n\n    // Minimum swipe distance threshold\n    if (dist < this.tileSize * 0.2) {\n      // Tap — treat as selection or swap trigger\n      if (this.onTap) this.onTap(start.row, start.col);\n      this._lastInteraction = 'tap';\n      return;\n    }\n\n    this._lastInteraction = 'swipe';\n\n    // Determine swipe direction\n    let targetRow = start.row;\n    let targetCol = start.col;\n    if (Math.abs(dx) > Math.abs(dy)) {\n      targetCol += dx > 0 ? 1 : -1;\n    } else {\n      targetRow += dy > 0 ? 1 : -1;\n    }\n\n    // Validate\n    if (this.board.isValid(targetRow, targetCol)) {\n      if (this.onSwap) {\n        this.onSwap(start.row, start.col, targetRow, targetCol);\n      }\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { InputHandler };\n","numLines":110,"startLine":1,"totalLines":110}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_03b0f731d6604fd0a9c81ff9","type":"tool_result","content":"1\t// Game.js — Main game loop, state machine, integrates all Phase 2+3a systems\n2\t\n3\tconst STATES = {\n4\t  MENU: 'menu',\n5\t  IDLE: 'idle',\n6\t  SWAPPING: 'swapping',\n7\t  MATCHING: 'matching',\n8\t  REMOVING: 'removing',\n9\t  DROPPING: 'dropping',\n10\t  RESULT: 'result',\n11\t  BOSS_SKILL: 'boss_skill',\n12\t};\n13\t\n14\tclass Game {\n15\t  constructor(canvas) {\n16\t    this.canvas = canvas;\n17\t    this.board = new Board();\n18\t    this.matchEngine = new MatchEngine(this.board);\n19\t    this.renderer = new Renderer(canvas);\n20\t    this.input = new InputHandler(canvas, this.board);\n21\t    this.scoreSystem = new ScoreSystem();\n22\t    this.tweens = new TweenManager();\n23\t    this.particles = new ParticleSystem();\n24\t    this.obstacleMgr = new ObstacleManager(this.board);\n25\t    this.audio = new AudioManager();\n26\t    this.boss = null;\n27\t    this.levels = LEVELS;\n28\t    this.currentLevel = 0;\n29\t    this.state = STATES.IDLE;\n30\t    this.comboText = '';\n31\t    this.comboTimer = 0;\n32\t    this.lastTime = 0;\n33\t    this.resultData = null;\n34\t    this.moveCount = 0;\n35\t    this._selectedTile = null;\n36\t\n37\t    // Phase 3a: meta-progression systems\n38\t    this.dataManager = new DataManager();\n39\t    this.coinSystem = new CoinSystem(this.dataManager);\n40\t    this.characterMgr = new CharacterManager();\n41\t    this.mapScreen = new MapScreen(this.dataManager);\n42\t    this.shopUI = new ShopUI(this.coinSystem, this.dataManager);\n43\t    this.nav = new Navigation(this);\n44\t\n45\t    // Phase 3b: daily + social\n46\t    this.dailySystem = new DailySystem(this.dataManager, this.coinSystem);\n47\t    this.socialSystem = new SocialSystem(this.dataManager);\n48\t    this.dailySystem.checkNewDay();\n49\t\n50\t    // Phase 4: ads + analytics\n51\t    this.adManager = new AdManager(this.dataManager);\n52\t    this.analytics = new Analytics(this.dataManager);\n53\t    this.analytics.trackGameStart();\n54\t\n55\t    this.renderer.particleSystem = this.particles;\n56\t\n57\t    this._setupInput();\n58\t    this._setupScoreCallbacks();\n59\t    this._setupObstacleCallbacks();\n60\t  }\n61\t\n62\t  _setupInput() {\n63\t    this.input.onSwap = (r1, c1, r2, c2) => this._handleSwap(r1, c1, r2, c2);\n64\t    this.input.onTap = (row, col) => this._handleTap(row, col);\n65\t  }\n66\t\n67\t  _setupScoreCallbacks() {\n68\t    this.scoreSystem.onLevelComplete = (score, stars) => {\n69\t      this.nav.showResult(true, score, stars, this.currentLevel + 1);\n70\t      this.audio.playLevelWin();\n71\t      // Phase 3b: daily task tracking\n72\t      this.dailySystem.reportEvent('complete_levels', 1);\n73\t      if (stars === 3) this.dailySystem.reportEvent('star3', 1);\n74\t      if (score >= 2000) this.dailySystem.reportEvent('score', score);\n75\t      // Phase 4: analytics + ad success tracking\n76\t      this.analytics.trackLevelComplete(this.currentLevel + 1, score, stars, this.moveCount);\n77\t      this.adManager.reportSuccess();\n78\t    };\n79\t    this.scoreSystem.onLevelFail = (score) => {\n80\t      this.nav.showResult(false, score, 0, this.currentLevel + 1);\n81\t      this.audio.playLevelFail();\n82\t      // Phase 4: analytics + ad fail tracking\n83\t      this.analytics.trackLevelFail(this.currentLevel + 1, score, this.moveCount, this.scoreSystem.getGoalProgress());\n84\t      this.adManager.reportFail();\n85\t    };\n86\t  }\n87\t\n88\t  _setupObstacleCallbacks() {\n89\t    this.obstacleMgr.onObstacleDestroyed = (obs) => {\n90\t      this.scoreSystem.addObstacleCleared(obs.type);\n91\t      this.audio.playObstacleBreak();\n92\t      // Phase 3b: daily obstacle tracking\n93\t      this.dailySystem.reportEvent('clear_obstacle', obs.type);\n94\t      const pos = this.renderer.getTileCenter(obs.row, obs.col);\n95\t      this.particles.emitExplosion(pos.x, pos.y, this._obstacleColor(obs.type), 12);\n96\t    };\n97\t  }\n98\t\n99\t  _obstacleColor(type) {\n100\t    switch (type) {\n101\t      case OBSTACLE_ICE: return '#88CCFF';\n102\t      case OBSTACLE_CHAIN: return '#AAAAAA';\n103\t      case OBSTACLE_CHOCOLATE: return '#8B4513';\n104\t      default: return '#FFFFFF';\n105\t    }\n106\t  }\n107\t\n108\t  start() {\n109\t    this.lastTime = performance.now();\n110\t    this._loop();\n111\t  }\n112\t\n113\t  _loadLevel(idx) {\n114\t    this.currentLevel = idx;\n115\t    const config = this.levels[idx] || this.levels[0];\n116\t    this.board.init();\n117\t    this.scoreSystem.reset(idx + 1);\n118\t    this.scoreSystem.configure(config);\n119\t    this.tweens.clear();\n120\t    this.particles.particles = [];\n121\t    this.renderer.floatingTexts = [];\n122\t    this.comboText = '';\n123\t    this._selectedTile = null;\n124\t    this.resultData = null;\n125\t    this.moveCount = 0;\n126\t\n127\t    // Phase 4: analytics\n128\t    this.analytics.trackLevelStart(idx + 1, config);\n129\t\n130\t    this.obstacleMgr.loadFromConfig(config.obstacles);\n131\t\n132\t    for (const obs of this.obstacleMgr.obstacles) {\n133\t      if (obs.type === OBSTACLE_CHOCOLATE) {\n134\t        this.board.clearCell(obs.row, obs.col);\n135\t      }\n136\t    }\n137\t\n138\t    this.boss = null;\n139\t    if (config.boss) {\n140\t      this.boss = new Boss(config.boss);\n141\t      this.board.clearCell(this.boss.row, this.boss.col);\n142\t    }\n143\t\n144\t    this.board.applyGravity();\n145\t    this.board._removeInitialMatches();\n146\t\n147\t    this.input.updateLayout(\n148\t      this.renderer.tileSize,\n149\t      this.renderer.boardX,\n150\t      this.renderer.boardY,\n151\t    );\n152\t  }\n153\t\n154\t  _handleTap(row, col) {\n155\t    if (this.state !== STATES.IDLE) return;\n156\t    const tile = this.board.getTile(row, col);\n157\t    if (!tile) return;\n158\t\n159\t    this.audio.init();\n160\t\n161\t    if (tile.special === SPECIAL_RAINBOW) {\n162\t      // Rainbow tiles need a target — select and wait for second tap\n163\t      this._selectedTile = { row, col };\n164\t      return;\n165\t    }\n166\t\n167\t    if (this._selectedTile) {\n168\t      const { row: sr, col: sc } = this._selectedTile;\n169\t      this._selectedTile = null;\n170\t      if (this.board.isAdjacent(sr, sc, row, col)) {\n171\t        this._handleSwap(sr, sc, row, col);\n172\t        return;\n173\t      }\n174\t    }\n175\t\n176\t    this._selectedTile = { row, col };\n177\t  }\n178\t\n179\t  _handleSwap(r1, c1, r2, c2) {\n180\t    if (this.state !== STATES.IDLE) return;\n181\t\n182\t    this.audio.init();\n183\t\n184\t    const tileA = this.board.getTile(r1, c1);\n185\t    const tileB = this.board.getTile(r2, c2);\n186\t\n187\t    if (!this.obstacleMgr.canSwap(r1, c1) || !this.obstacleMgr.canSwap(r2, c2)) {\n188\t      this.audio.playInvalid();\n189\t      return;\n190\t    }\n191\t\n192\t    if (tileA && tileA.special === SPECIAL_RAINBOW) {\n193\t      this._activateRainbow(r1, c1, tileB ? tileB.color : 0, r2, c2);\n194\t      return;\n195\t    }\n196\t    if (tileB && tileB.special === SPECIAL_RAINBOW) {\n197\t      this._activateRainbow(r2, c2, tileA ? tileA.color : 0, r1, c1);\n198\t      return;\n199\t    }\n200\t\n201\t    if (!this.matchEngine.isValidSwap(r1, c1, r2, c2)) {\n202\t      this.audio.playInvalid();\n203\t      return;\n204\t    }\n205\t    if (!this.scoreSystem.useMove()) return;\n206\t\n207\t    this.audio.playSwap();\n208\t    this.moveCount++;\n209\t    this.state = STATES.SWAPPING;\n210\t    this.board.swap(r1, c1, r2, c2);\n211\t\n212\t    this._animateSwap(r1, c1, r2, c2, () => {\n213\t      this._processMatches();\n214\t    });\n215\t  }\n216\t\n217\t  _animateSwap(r1, c1, r2, c2, callback) {\n218\t    const tileSize = this.renderer.tileSize;\n219\t    const tileA = this.board.getTile(r2, c2);\n220\t    const tileB = this.board.getTile(r1, c1);\n221\t    const dx = (c2 - c1) * tileSize;\n222\t    const dy = (r2 - r1) * tileSize;\n223\t\n224\t    if (tileA) {\n225\t      tileA.offsetX = -dx;\n226\t      tileA.offsetY = -dy;\n227\t      this.tweens.add(tileA, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n228\t    }\n229\t    if (tileB) {\n230\t      tileB.offsetX = dx;\n231\t      tileB.offsetY = dy;\n232\t      this.tweens.add(tileB, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n233\t    }\n234\t    setTimeout(callback, 160);\n235\t  }\n236\t\n237\t  _activateRainbow(rainbowRow, rainbowCol, targetColor, otherRow, otherCol) {\n238\t    if (!this.scoreSystem.useMove()) return;\n239\t    this.moveCount++;\n240\t    this.audio.playSpecial();\n241\t    this.state = STATES.MATCHING;\n242\t\n243\t    const toRemove = this.matchEngine.triggerRainbow(rainbowRow, rainbowCol, targetColor);\n244\t    toRemove.push({ row: rainbowRow, col: rainbowCol });\n245\t    if (this.board.getTile(otherRow, otherCol)) {\n246\t      toRemove.push({ row: otherRow, col: otherCol });\n247\t    }\n248\t\n249\t    this._removeAndCascade(toRemove, 10);\n250\t  }\n251\t\n252\t  _processMatches() {\n253\t    this.state = STATES.MATCHING;\n254\t    const matches = this.board.findAllMatches();\n255\t\n256\t    if (matches.length === 0) {\n257\t      this._afterMoveComplete();\n258\t      return;\n259\t    }\n260\t\n261\t    this._processChain(0);\n262\t  }\n263\t\n264\t  _processChain(chainCount) {\n265\t    chainCount++;\n266\t    const matches = this.board.findAllMatches();\n267\t    if (matches.length === 0) {\n268\t      this._afterMoveComplete();\n269\t      return;\n270\t    }\n271\t\n272\t    const lShapes = this.board.findLShapeMatches(matches);\n273\t    const { removeCells, specials } = this.matchEngine._classifyMatches(matches, lShapes);\n274\t\n275\t    const multiplier = chainCount <= 1 ? 1 : chainCount === 2 ? 1.5 : chainCount === 3 ? 2.0 : 2.5;\n276\t    const baseScore = removeCells.size * 10;\n277\t    const points = Math.floor(baseScore * multiplier);\n278\t    this.scoreSystem.addScore(points);\n279\t\n280\t    // Phase 3a: character skill — chain bonus\n281\t    this.characterMgr.applySkill(\n282\t      this.dataManager.selectedCharacter,\n283\t      this, 'chain_score', { chainCount },\n284\t    );\n285\t\n286\t    if (chainCount >= 4) this.comboText = '超赞！！';\n287\t    else if (chainCount === 3) this.comboText = '太棒了！';\n288\t    else if (chainCount === 2) this.comboText = '不错！';\n289\t    this.comboTimer = 0.8;\n290\t\n291\t    // Phase 3b: daily chain tracking\n292\t    this.dailySystem.reportEvent('chain', 1);\n293\t\n294\t    this.audio.playMatch(chainCount);\n295\t    if (chainCount >= 2) this.audio.playCombo(chainCount);\n296\t\n297\t    // Collect matched positions\n298\t    const matchedPositions = [];\n299\t    for (const key of removeCells) {\n300\t      const [r, c] = key.split(',').map(Number);\n301\t      const tile = this.board.getTile(r, c);\n302\t      if (tile && tile.color >= 0) {\n303\t        this.scoreSystem.addCollected(tile.color, 1);\n304\t      }\n305\t      matchedPositions.push({ row: r, col: c });\n306\t    }\n307\t\n308\t    // Phase 3a: character skill — lucky special\n309\t    const matchCells = [];\n310\t    for (const key of removeCells) {\n311\t      const [r, c] = key.split(',').map(Number);\n312\t      matchCells.push({ row: r, col: c });\n313\t    }\n314\t    this.characterMgr.applySkill(\n315\t      this.dataManager.selectedCharacter,\n316\t      this, 'match_created', { cells: matchCells },\n317\t    );\n318\t\n319\t    // Create specials\n320\t    const specialPositions = new Set(specials.map(s => `${s.row},${s.col}`));\n321\t    for (const sp of specials) {\n322\t      const tile = this.board.getTile(sp.row, sp.col);\n323\t      if (tile) {\n324\t        tile.special = sp.type;\n325\t        tile.removing = false;\n326\t      }\n327\t    }\n328\t\n329\t    // Animate removal\n330\t    this.state = STATES.REMOVING;\n331\t    const toAnimate = [];\n332\t    for (const key of removeCells) {\n333\t      if (specialPositions.has(key)) continue;\n334\t      const [r, c] = key.split(',').map(Number);\n335\t      const tile = this.board.getTile(r, c);\n336\t      if (tile) {\n337\t        const pos = this.renderer.getTileCenter(r, c);\n338\t        const color = COLOR_MAP[tile.color];\n339\t        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 8);\n340\t        this.renderer.addFloatingText(`+${points}`, pos.x, pos.y);\n341\t        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n342\t        toAnimate.push(tile);\n343\t      }\n344\t    }\n345\t\n346\t    setTimeout(() => {\n347\t      for (const key of removeCells) {\n348\t        if (specialPositions.has(key)) continue;\n349\t        const [r, c] = key.split(',').map(Number);\n350\t        this.board.clearCell(r, c);\n351\t      }\n352\t\n353\t      for (const sp of specials) {\n354\t        this._triggerSpecialEffects(sp.row, sp.col, sp.type);\n355\t      }\n356\t\n357\t      this.obstacleMgr.onTilesMatched(matchedPositions);\n358\t\n359\t      if (this.boss && this.boss.active) {\n360\t        const dmg = this.boss.calculateDamage(matchedPositions);\n361\t        if (dmg > 0) {\n362\t          const defeated = this.boss.takeDamage(dmg);\n363\t          this.audio.playBossHit();\n364\t          if (defeated) {\n365\t            this.audio.playBossDefeat();\n366\t            this.scoreSystem.addScore(500);\n367\t          }\n368\t        }\n369\t      }\n370\t\n371\t      this.state = STATES.DROPPING;\n372\t      const drops = this.board.applyGravity();\n373\t\n374\t      for (const drop of drops) {\n375\t        const tile = drop.tile;\n376\t        const fromY = drop.fromRow * this.renderer.tileSize;\n377\t        const toY = drop.toRow * this.renderer.tileSize;\n378\t        tile.offsetY = fromY - toY;\n379\t        this.tweens.add(tile, { offsetY: 0 }, 0.2 + drop.distance * 0.03, 'easeOutBounce');\n380\t      }\n381\t\n382\t      setTimeout(() => {\n383\t        this._processChain(chainCount);\n384\t      }, 350);\n385\t    }, 280);\n386\t  }\n387\t\n388\t  _afterMoveComplete() {\n389\t    if (this.boss && this.boss.isDefeated() && this.scoreSystem.goalType === 'boss') {\n390\t      this.nav.showResult(true, this.scoreSystem.score, this.scoreSystem.getStarCount(), this.currentLevel + 1);\n391\t      this.audio.playLevelWin();\n392\t      return;\n393\t    }\n394\t\n395\t    this.obstacleMgr.spreadChocolate();\n396\t\n397\t    // Phase 3a: character skill — auto obstacle clear\n398\t    this.characterMgr.applySkill(\n399\t      this.dataManager.selectedCharacter,\n400\t      this, 'after_move', null,\n401\t    );\n402\t\n403\t    if (this.boss && this.boss.active) {\n404\t      const ability = this.boss.tryUseAbility();\n405\t      if (ability) {\n406\t        this._executeBossAbility(ability);\n407\t      }\n408\t    }\n409\t\n410\t    this.state = STATES.IDLE;\n411\t\n412\t    if (!this.board.hasValidMoves(this.obstacleMgr)) {\n413\t      this.board.shuffle();\n414\t    }\n415\t\n416\t    this.scoreSystem.checkState();\n417\t  }\n418\t\n419\t  _executeBossAbility(ability) {\n420\t    this.audio.playBossAbility();\n421\t\n422\t    switch (ability) {\n423\t      case 'freeze': {\n424\t        const candidates = [];\n425\t        for (let r = 0; r < this.board.size; r++) {\n426\t          for (let c = 0; c < this.board.size; c++) {\n427\t            if (!this.obstacleMgr.hasObstacle(r, c) && this.board.getTile(r, c)) {\n428\t              if (this.boss && r === this.boss.row && c === this.boss.col) continue;\n429\t              candidates.push({ row: r, col: c });\n430\t            }\n431\t          }\n432\t        }\n433\t        const count = Math.min(2, candidates.length);\n434\t        for (let i = 0; i < count; i++) {\n435\t          const idx = Math.floor(Math.random() * candidates.length);\n436\t          const target = candidates.splice(idx, 1)[0];\n437\t          this.obstacleMgr.addObstacle(OBSTACLE_ICE, target.row, target.col);\n438\t        }\n439\t        break;\n440\t      }\n441\t      case 'chain': {\n442\t        const candidates = [];\n443\t        for (let r = 0; r < this.board.size; r++) {\n444\t          for (let c = 0; c < this.board.size; c++) {\n445\t            if (!this.obstacleMgr.hasObstacle(r, c) && this.board.getTile(r, c)) {\n446\t              if (this.boss && r === this.boss.row && c === this.boss.col) continue;\n447\t              candidates.push({ row: r, col: c });\n448\t            }\n449\t          }\n450\t        }\n451\t        if (candidates.length > 0) {\n452\t          const idx = Math.floor(Math.random() * candidates.length);\n453\t          const target = candidates[idx];\n454\t          this.obstacleMgr.addObstacle(OBSTACLE_CHAIN, target.row, target.col);\n455\t        }\n456\t        break;\n457\t      }\n458\t      case 'chocolate': {\n459\t        const dirs = [[-1,0],[1,0],[0,-1],[0,1]];\n460\t        const candidates = [];\n461\t        for (const [dr, dc] of dirs) {\n462\t          const nr = this.boss.row + dr;\n463\t          const nc = this.boss.col + dc;\n464\t          if (this.board.isValid(nr, nc) && !this.obstacleMgr.hasObstacle(nr, nc)) {\n465\t            candidates.push({ row: nr, col: nc });\n466\t          }\n467\t        }\n468\t        if (candidates.length > 0) {\n469\t          const target = candidates[Math.floor(Math.random() * candidates.length)];\n470\t          this.obstacleMgr.addObstacle(OBSTACLE_CHOCOLATE, target.row, target.col);\n471\t        }\n472\t        break;\n473\t      }\n474\t    }\n475\t  }\n476\t\n477\t  _triggerSpecialEffects(row, col, type) {\n478\t    const pos = this.renderer.getTileCenter(row, col);\n479\t    const tile = this.board.getTile(row, col);\n480\t    const color = tile ? COLOR_MAP[tile.color]?.hex : '#FFB800';\n481\t\n482\t    this.audio.playSpecial();\n483\t\n484\t    switch (type) {\n485\t      case 1: case 2:\n486\t        this.particles.emitExplosion(pos.x, pos.y, color || '#FFB800', 20);\n487\t        break;\n488\t      case 3:\n489\t        this.particles.emitExplosion(pos.x, pos.y, '#FF9A3C', 30);\n490\t        break;\n491\t      case 4:\n492\t        for (let i = 0; i < 40; i++) {\n493\t          this.particles.emitExplosion(pos.x, pos.y, '#FFB800', 2);\n494\t        }\n495\t        break;\n496\t    }\n497\t  }\n498\t\n499\t  _removeAndCascade(cells, scorePerCell) {\n500\t    this.state = STATES.REMOVING;\n501\t    const points = cells.length * scorePerCell;\n502\t    this.scoreSystem.addScore(points);\n503\t\n504\t    for (const { row, col } of cells) {\n505\t      const tile = this.board.getTile(row, col);\n506\t      if (tile && tile.color >= 0) {\n507\t        this.scoreSystem.addCollected(tile.color, 1);\n508\t      }\n509\t    }\n510\t\n511\t    for (const { row, col } of cells) {\n512\t      const tile = this.board.getTile(row, col);\n513\t      if (tile) {\n514\t        const pos = this.renderer.getTileCenter(row, col);\n515\t        const color = COLOR_MAP[tile.color];\n516\t        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 6);\n517\t        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n518\t      }\n519\t    }\n520\t\n521\t    setTimeout(() => {\n522\t      for (const { row, col } of cells) {\n523\t        this.board.clearCell(row, col);\n524\t      }\n525\t\n526\t      this.obstacleMgr.onTilesMatched(cells);\n527\t\n528\t      if (this.boss && this.boss.active) {\n529\t        const dmg = this.boss.calculateDamage(cells);\n530\t        if (dmg > 0) {\n531\t          const defeated = this.boss.takeDamage(dmg);\n532\t          this.audio.playBossHit();\n533\t          if (defeated) {\n534\t            this.audio.playBossDefeat();\n535\t            this.scoreSystem.addScore(500);\n536\t          }\n537\t        }\n538\t      }\n539\t\n540\t      const drops = this.board.applyGravity();\n541\t\n542\t      for (const drop of drops) {\n543\t        const tile = drop.tile;\n544\t        const fromY = drop.fromRow * this.renderer.tileSize;\n545\t        const toY = drop.toRow * this.renderer.tileSize;\n546\t        tile.offsetY = fromY - toY;\n547\t        this.tweens.add(tile, { offsetY: 0 }, 0.2 + drop.distance * 0.03, 'easeOutBounce');\n548\t      }\n549\t\n550\t      this.state = STATES.IDLE;\n551\t      setTimeout(() => this._processMatches(), 350);\n552\t    }, 300);\n553\t  }\n554\t\n555\t  _loop() {\n556\t    const now = performance.now();\n557\t    const dt = Math.min((now - this.lastTime) / 1000, 0.05);\n558\t    this.lastTime = now;\n559\t\n560\t    // Phase 3a: Navigation screens take priority\n561\t    if (this.nav.isActive()) {\n562\t      this.nav.render(this.renderer.ctx, this.renderer.screenW, this.renderer.screenH);\n563\t      // Phase 4: ad stub overlay on top of navigation\n564\t      this.adManager.renderStubAd(this.renderer.ctx, this.renderer.screenW, this.renderer.screenH);\n565\t      requestAnimationFrame(() => this._loop());\n566\t      return;\n567\t    }\n568\t\n569\t    this.update(dt);\n570\t    this.render();\n571\t    // Phase 4: ad stub overlay on top of gameplay\n572\t    this.adManager.renderStubAd(this.renderer.ctx, this.renderer.screenW, this.renderer.screenH);\n573\t    requestAnimationFrame(() => this._loop());\n574\t  }\n575\t\n576\t  update(dt) {\n577\t    this.tweens.update(dt);\n578\t    this.particles.update(dt);\n579\t    this.obstacleMgr.update(dt);\n580\t    if (this.boss) this.boss.update(dt);\n581\t    // Phase 4: ad stub timer\n582\t    this.adManager.update(dt);\n583\t\n584\t    if (this.comboTimer > 0) {\n585\t      this.comboTimer -= dt;\n586\t      if (this.comboTimer <= 0) this.comboText = '';\n587\t    }\n588\t\n589\t    this.input.enabled = this.state === STATES.IDLE;\n590\t  }\n591\t\n592\t  render() {\n593\t    this.renderer.clear();\n594\t    this.renderer.drawBackground();\n595\t\n596\t    for (let r = 0; r < this.board.size; r++) {\n597\t      for (let c = 0; c < this.board.size; c++) {\n598\t        const tile = this.board.getTile(r, c);\n599\t        if (tile) {\n600\t          if (this._selectedTile && this._selectedTile.row === r && this._selectedTile.col === c) {\n601\t            tile.selected = true;\n602\t          } else {\n603\t            tile.selected = false;\n604\t          }\n605\t          this.renderer.drawTile(tile);\n606\t        }\n607\t      }\n608\t    }\n609\t\n610\t    this.renderer.drawObstacles(this.obstacleMgr);\n611\t\n612\t    if (this.boss && this.boss.active) {\n613\t      this.renderer.drawBoss(this.boss, this.renderer);\n614\t    }\n615\t\n616\t    this.particles.draw(this.renderer.ctx);\n617\t    this.renderer.updateAndDrawFloatingTexts(1 / 60);\n618\t\n619\t    const config = this.levels[this.currentLevel] || this.levels[0];\n620\t    this.renderer.drawUI(\n621\t      this.scoreSystem.score,\n622\t      this.scoreSystem.getRemainingMoves(),\n623\t      config,\n624\t      this.scoreSystem,\n625\t      this.currentLevel + 1,\n626\t    );\n627\t\n628\t    if (this.comboText) {\n629\t      this.renderer.drawComboText(this.comboText);\n630\t    }\n631\t\n632\t    if (this.boss && this.boss.active) {\n633\t      this.renderer.drawBossHealthBar(this.boss);\n634\t    }\n635\t\n636\t    // Phase 3a: back-to-map button during gameplay\n637\t    this._drawBackButton();\n638\t\n639\t    // Result screen is now handled by Navigation\n640\t  }\n641\t\n642\t  _drawBackButton() {\n643\t    const ctx = this.renderer.ctx;\n644\t    const w = this.renderer.screenW;\n645\t    ctx.fillStyle = '#8D6E6399';\n646\t    this.renderer._roundRect(ctx, w - 50, this.renderer.boardY + this.renderer.tileSize * BOARD_SIZE + 25, 40, 28, 14);\n647\t    ctx.fill();\n648\t    ctx.fillStyle = '#FFF';\n649\t    ctx.font = 'bold 12px sans-serif';\n650\t    ctx.textAlign = 'center';\n651\t    ctx.fillText('地图', w - 30, this.renderer.boardY + this.renderer.tileSize * BOARD_SIZE + 44);\n652\t  }\n653\t\n654\t  retry() {\n655\t    this._loadLevel(this.currentLevel);\n656\t    this.state = STATES.IDLE;\n657\t  }\n658\t\n659\t  nextLevel() {\n660\t    const next = this.currentLevel + 1;\n661\t    if (next < this.levels.length) {\n662\t      this._loadLevel(next);\n663\t      this.state = STATES.IDLE;\n664\t    } else {\n665\t      this._loadLevel(0);\n666\t      this.state = STATES.IDLE;\n667\t    }\n668\t  }\n669\t}\n670\t\n671\tif (typeof module !== 'undefined') module.exports = { Game, STATES };\n672\t"}]},"parent_tool_use_id":null,"session_id":"33562fd9-d4f0-45be-a2a4-d9d379182d9f","uuid":"5abfef3e-6bcf-49aa-8931-36dcb93e79ca","timestamp":"2026-05-23T10:17:22.957Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-match3/src/js/Game.js","content":"// Game.js — Main game loop, state machine, integrates all Phase 2+3a systems\n\nconst STATES = {\n  MENU: 'menu',\n  IDLE: 'idle',\n  SWAPPING: 'swapping',\n  MATCHING: 'matching',\n  REMOVING: 'removing',\n  DROPPING: 'dropping',\n  RESULT: 'result',\n  BOSS_SKILL: 'boss_skill',\n};\n\nclass Game {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.board = new Board();\n    this.matchEngine = new MatchEngine(this.board);\n    this.renderer = new Renderer(canvas);\n    this.input = new InputHandler(canvas, this.board);\n    this.scoreSystem = new ScoreSystem();\n    this.tweens = new TweenManager();\n    this.particles = new ParticleSystem();\n    this.obstacleMgr = new ObstacleManager(this.board);\n    this.audio = new AudioManager();\n    this.boss = null;\n    this.levels = LEVELS;\n    this.currentLevel = 0;\n    this.state = STATES.IDLE;\n    this.comboText = '';\n    this.comboTimer = 0;\n    this.lastTime = 0;\n    this.resultData = null;\n    this.moveCount = 0;\n    this._selectedTile = null;\n\n    // Phase 3a: meta-progression systems\n    this.dataManager = new DataManager();\n    this.coinSystem = new CoinSystem(this.dataManager);\n    this.characterMgr = new CharacterManager();\n    this.mapScreen = new MapScreen(this.dataManager);\n    this.shopUI = new ShopUI(this.coinSystem, this.dataManager);\n    this.nav = new Navigation(this);\n\n    // Phase 3b: daily + social\n    this.dailySystem = new DailySystem(this.dataManager, this.coinSystem);\n    this.socialSystem = new SocialSystem(this.dataManager);\n    this.dailySystem.checkNewDay();\n\n    // Phase 4: ads + analytics\n    this.adManager = new AdManager(this.dataManager);\n    this.analytics = new Analytics(this.dataManager);\n    this.analytics.trackGameStart();\n\n    this.renderer.particleSystem = this.particles;\n\n    this._setupInput();\n    this._setupScoreCallbacks();\n    this._setupObstacleCallbacks();\n  }\n\n  _setupInput() {\n    this.input.onSwap = (r1, c1, r2, c2) => this._handleSwap(r1, c1, r2, c2);\n    this.input.onTap = (row, col) => this._handleTap(row, col);\n  }\n\n  _setupScoreCallbacks() {\n    this.scoreSystem.onLevelComplete = (score, stars) => {\n      this.nav.showResult(true, score, stars, this.currentLevel + 1);\n      this.audio.playLevelWin();\n      // Phase 3b: daily task tracking\n      this.dailySystem.reportEvent('complete_levels', 1);\n      if (stars === 3) this.dailySystem.reportEvent('star3', 1);\n      if (score >= 2000) this.dailySystem.reportEvent('score', score);\n      // Phase 4: analytics + ad success tracking\n      this.analytics.trackLevelComplete(this.currentLevel + 1, score, stars, this.moveCount);\n      this.adManager.reportSuccess();\n    };\n    this.scoreSystem.onLevelFail = (score) => {\n      this.nav.showResult(false, score, 0, this.currentLevel + 1);\n      this.audio.playLevelFail();\n      // Phase 4: analytics + ad fail tracking\n      this.analytics.trackLevelFail(this.currentLevel + 1, score, this.moveCount, this.scoreSystem.getGoalProgress());\n      this.adManager.reportFail();\n    };\n  }\n\n  _setupObstacleCallbacks() {\n    this.obstacleMgr.onObstacleDestroyed = (obs) => {\n      this.scoreSystem.addObstacleCleared(obs.type);\n      this.audio.playObstacleBreak();\n      // Phase 3b: daily obstacle tracking\n      this.dailySystem.reportEvent('clear_obstacle', obs.type);\n      const pos = this.renderer.getTileCenter(obs.row, obs.col);\n      this.particles.emitExplosion(pos.x, pos.y, this._obstacleColor(obs.type), 12);\n    };\n  }\n\n  _obstacleColor(type) {\n    switch (type) {\n      case OBSTACLE_ICE: return '#88CCFF';\n      case OBSTACLE_CHAIN: return '#AAAAAA';\n      case OBSTACLE_CHOCOLATE: return '#8B4513';\n      default: return '#FFFFFF';\n    }\n  }\n\n  start() {\n    this.lastTime = performance.now();\n    this._loop();\n  }\n\n  _loadLevel(idx) {\n    this.currentLevel = idx;\n    const config = this.levels[idx] || this.levels[0];\n    this.board.init();\n    this.scoreSystem.reset(idx + 1);\n    this.scoreSystem.configure(config);\n    this.tweens.clear();\n    this.particles.particles = [];\n    this.renderer.floatingTexts = [];\n    this.comboText = '';\n    this._selectedTile = null;\n    this.resultData = null;\n    this.moveCount = 0;\n\n    // Phase 4: analytics\n    this.analytics.trackLevelStart(idx + 1, config);\n\n    this.obstacleMgr.loadFromConfig(config.obstacles);\n\n    for (const obs of this.obstacleMgr.obstacles) {\n      if (obs.type === OBSTACLE_CHOCOLATE) {\n        this.board.clearCell(obs.row, obs.col);\n      }\n    }\n\n    this.boss = null;\n    if (config.boss) {\n      this.boss = new Boss(config.boss);\n      this.board.clearCell(this.boss.row, this.boss.col);\n    }\n\n    this.board.applyGravity();\n    this.board._removeInitialMatches();\n\n    this.input.updateLayout(\n      this.renderer.tileSize,\n      this.renderer.boardX,\n      this.renderer.boardY,\n    );\n  }\n\n  _handleTap(row, col) {\n    if (this.state !== STATES.IDLE) return;\n    const tile = this.board.getTile(row, col);\n    if (!tile) return;\n\n    this.audio.init();\n\n    if (tile.special === SPECIAL_RAINBOW) {\n      // Rainbow tiles need a target — select and wait for second tap\n      this._selectedTile = { row, col };\n      return;\n    }\n\n    if (this._selectedTile) {\n      const { row: sr, col: sc } = this._selectedTile;\n      this._selectedTile = null;\n      if (this.board.isAdjacent(sr, sc, row, col)) {\n        this._handleSwap(sr, sc, row, col);\n        return;\n      }\n    }\n\n    this._selectedTile = { row, col };\n  }\n\n  _handleSwap(r1, c1, r2, c2) {\n    if (this.state !== STATES.IDLE) return;\n\n    this.audio.init();\n\n    const tileA = this.board.getTile(r1, c1);\n    const tileB = this.board.getTile(r2, c2);\n\n    if (!this.obstacleMgr.canSwap(r1, c1) || !this.obstacleMgr.canSwap(r2, c2)) {\n      this.audio.playInvalid();\n      return;\n    }\n\n    if (tileA && tileA.special === SPECIAL_RAINBOW) {\n      this._activateRainbow(r1, c1, tileB ? tileB.color : 0, r2, c2);\n      return;\n    }\n    if (tileB && tileB.special === SPECIAL_RAINBOW) {\n      this._activateRainbow(r2, c2, tileA ? tileA.color : 0, r1, c1);\n      return;\n    }\n\n    if (!this.matchEngine.isValidSwap(r1, c1, r2, c2)) {\n      this.audio.playInvalid();\n      return;\n    }\n    if (!this.scoreSystem.useMove()) return;\n\n    this.audio.playSwap();\n    this.moveCount++;\n    this.state = STATES.SWAPPING;\n    this.board.swap(r1, c1, r2, c2);\n\n    this._animateSwap(r1, c1, r2, c2, () => {\n      this._processMatches();\n    });\n  }\n\n  _animateSwap(r1, c1, r2, c2, callback) {\n    const tileSize = this.renderer.tileSize;\n    const tileA = this.board.getTile(r2, c2);\n    const tileB = this.board.getTile(r1, c1);\n    const dx = (c2 - c1) * tileSize;\n    const dy = (r2 - r1) * tileSize;\n\n    if (tileA) {\n      tileA.offsetX = -dx;\n      tileA.offsetY = -dy;\n      this.tweens.add(tileA, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n    }\n    if (tileB) {\n      tileB.offsetX = dx;\n      tileB.offsetY = dy;\n      this.tweens.add(tileB, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n    }\n    setTimeout(callback, 160);\n  }\n\n  _activateRainbow(rainbowRow, rainbowCol, targetColor, otherRow, otherCol) {\n    if (!this.scoreSystem.useMove()) return;\n    this.moveCount++;\n    this.audio.playSpecial();\n    this.state = STATES.MATCHING;\n\n    const toRemove = this.matchEngine.triggerRainbow(rainbowRow, rainbowCol, targetColor);\n    toRemove.push({ row: rainbowRow, col: rainbowCol });\n    if (this.board.getTile(otherRow, otherCol)) {\n      toRemove.push({ row: otherRow, col: otherCol });\n    }\n\n    this._removeAndCascade(toRemove, 10);\n  }\n\n  _processMatches() {\n    this.state = STATES.MATCHING;\n    const matches = this.board.findAllMatches();\n\n    if (matches.length === 0) {\n      this._afterMoveComplete();\n      return;\n    }\n\n    this._processChain(0);\n  }\n\n  _processChain(chainCount) {\n    chainCount++;\n    const matches = this.board.findAllMatches();\n    if (matches.length === 0) {\n      this._afterMoveComplete();\n      return;\n    }\n\n    const lShapes = this.board.findLShapeMatches(matches);\n    const { removeCells, specials } = this.matchEngine._classifyMatches(matches, lShapes);\n\n    const multiplier = chainCount <= 1 ? 1 : chainCount === 2 ? 1.5 : chainCount === 3 ? 2.0 : 2.5;\n    const baseScore = removeCells.size * 10;\n    const points = Math.floor(baseScore * multiplier);\n    this.scoreSystem.addScore(points);\n\n    // Phase 3a: character skill — chain bonus\n    this.characterMgr.applySkill(\n      this.dataManager.selectedCharacter,\n      this, 'chain_score', { chainCount },\n    );\n\n    if (chainCount >= 4) this.comboText = '超赞！！';\n    else if (chainCount === 3) this.comboText = '太棒了！';\n    else if (chainCount === 2) this.comboText = '不错！';\n    this.comboTimer = 0.8;\n\n    // Phase 3b: daily chain tracking\n    this.dailySystem.reportEvent('chain', 1);\n\n    this.audio.playMatch(chainCount);\n    if (chainCount >= 2) this.audio.playCombo(chainCount);\n\n    // Collect matched positions\n    const matchedPositions = [];\n    for (const key of removeCells) {\n      const [r, c] = key.split(',').map(Number);\n      const tile = this.board.getTile(r, c);\n      if (tile && tile.color >= 0) {\n        this.scoreSystem.addCollected(tile.color, 1);\n      }\n      matchedPositions.push({ row: r, col: c });\n    }\n\n    // Phase 3a: character skill — lucky special\n    const matchCells = [];\n    for (const key of removeCells) {\n      const [r, c] = key.split(',').map(Number);\n      matchCells.push({ row: r, col: c });\n    }\n    this.characterMgr.applySkill(\n      this.dataManager.selectedCharacter,\n      this, 'match_created', { cells: matchCells },\n    );\n\n    // Create specials\n    const specialPositions = new Set(specials.map(s => `${s.row},${s.col}`));\n    for (const sp of specials) {\n      const tile = this.board.getTile(sp.row, sp.col);\n      if (tile) {\n        tile.special = sp.type;\n        tile.removing = false;\n      }\n    }\n\n    // Animate removal\n    this.state = STATES.REMOVING;\n    const toAnimate = [];\n    for (const key of removeCells) {\n      if (specialPositions.has(key)) continue;\n      const [r, c] = key.split(',').map(Number);\n      const tile = this.board.getTile(r, c);\n      if (tile) {\n        const pos = this.renderer.getTileCenter(r, c);\n        const color = COLOR_MAP[tile.color];\n        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 8);\n        this.renderer.addFloatingText(`+${points}`, pos.x, pos.y);\n        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n        toAnimate.push(tile);\n      }\n    }\n\n    setTimeout(() => {\n      for (const key of removeCells) {\n        if (specialPositions.has(key)) continue;\n        const [r, c] = key.split(',').map(Number);\n        this.board.clearCell(r, c);\n      }\n\n      for (const sp of specials) {\n        this._triggerSpecialEffects(sp.row, sp.col, sp.type);\n      }\n\n      this.obstacleMgr.onTilesMatched(matchedPositions);\n\n      if (this.boss && this.boss.active) {\n        const dmg = this.boss.calculateDamage(matchedPositions);\n        if (dmg > 0) {\n          const defeated = this.boss.takeDamage(dmg);\n          this.audio.playBossHit();\n          if (defeated) {\n            this.audio.playBossDefeat();\n            this.scoreSystem.addScore(500);\n          }\n        }\n      }\n\n      this.state = STATES.DROPPING;\n      const drops = this.board.applyGravity();\n\n      for (const drop of drops) {\n        const tile = drop.tile;\n        const fromY = drop.fromRow * this.renderer.tileSize;\n        const toY = drop.toRow * this.renderer.tileSize;\n        tile.offsetY = fromY - toY;\n        this.tweens.add(tile, { offsetY: 0 }, 0.2 + drop.distance * 0.03, 'easeOutBounce');\n      }\n\n      setTimeout(() => {\n        this._processChain(chainCount);\n      }, 350);\n    }, 280);\n  }\n\n  _afterMoveComplete() {\n    if (this.boss && this.boss.isDefeated() && this.scoreSystem.goalType === 'boss') {\n      this.nav.showResult(true, this.scoreSystem.score, this.scoreSystem.getStarCount(), this.currentLevel + 1);\n      this.audio.playLevelWin();\n      return;\n    }\n\n    this.obstacleMgr.spreadChocolate();\n\n    // Phase 3a: character skill — auto obstacle clear\n    this.characterMgr.applySkill(\n      this.dataManager.selectedCharacter,\n      this, 'after_move', null,\n    );\n\n    if (this.boss && this.boss.active) {\n      const ability = this.boss.tryUseAbility();\n      if (ability) {\n        this._executeBossAbility(ability);\n      }\n    }\n\n    this.state = STATES.IDLE;\n\n    if (!this.board.hasValidMoves(this.obstacleMgr)) {\n      this.board.shuffle();\n    }\n\n    this.scoreSystem.checkState();\n  }\n\n  _executeBossAbility(ability) {\n    this.audio.playBossAbility();\n\n    switch (ability) {\n      case 'freeze': {\n        const candidates = [];\n        for (let r = 0; r < this.board.size; r++) {\n          for (let c = 0; c < this.board.size; c++) {\n            if (!this.obstacleMgr.hasObstacle(r, c) && this.board.getTile(r, c)) {\n              if (this.boss && r === this.boss.row && c === this.boss.col) continue;\n              candidates.push({ row: r, col: c });\n            }\n          }\n        }\n        const count = Math.min(2, candidates.length);\n        for (let i = 0; i < count; i++) {\n          const idx = Math.floor(Math.random() * candidates.length);\n          const target = candidates.splice(idx, 1)[0];\n          this.obstacleMgr.addObstacle(OBSTACLE_ICE, target.row, target.col);\n        }\n        break;\n      }\n      case 'chain': {\n        const candidates = [];\n        for (let r = 0; r < this.board.size; r++) {\n          for (let c = 0; c < this.board.size; c++) {\n            if (!this.obstacleMgr.hasObstacle(r, c) && this.board.getTile(r, c)) {\n              if (this.boss && r === this.boss.row && c === this.boss.col) continue;\n              candidates.push({ row: r, col: c });\n            }\n          }\n        }\n        if (candidates.length > 0) {\n          const idx = Math.floor(Math.random() * candidates.length);\n          const target = candidates[idx];\n          this.obstacleMgr.addObstacle(OBSTACLE_CHAIN, target.row, target.col);\n        }\n        break;\n      }\n      case 'chocolate': {\n        const dirs = [[-1,0],[1,0],[0,-1],[0,1]];\n        const candidates = [];\n        for (const [dr, dc] of dirs) {\n          const nr = this.boss.row + dr;\n          const nc = this.boss.col + dc;\n          if (this.board.isValid(nr, nc) && !this.obstacleMgr.hasObstacle(nr, nc)) {\n            candidates.push({ row: nr, col: nc });\n          }\n        }\n        if (candidates.length > 0) {\n          const target = candidates[Math.floor(Math.random() * candidates.length)];\n          this.obstacleMgr.addObstacle(OBSTACLE_CHOCOLATE, target.row, target.col);\n        }\n        break;\n      }\n    }\n  }\n\n  _triggerSpecialEffects(row, col, type) {\n    const pos = this.renderer.getTileCenter(row, col);\n    const tile = this.board.getTile(row, col);\n    const color = tile ? COLOR_MAP[tile.color]?.hex : '#FFB800';\n\n    this.audio.playSpecial();\n\n    switch (type) {\n      case 1: case 2:\n        this.particles.emitExplosion(pos.x, pos.y, color || '#FFB800', 20);\n        break;\n      case 3:\n        this.particles.emitExplosion(pos.x, pos.y, '#FF9A3C', 30);\n        break;\n      case 4:\n        for (let i = 0; i < 40; i++) {\n          this.particles.emitExplosion(pos.x, pos.y, '#FFB800', 2);\n        }\n        break;\n    }\n  }\n\n  _removeAndCascade(cells, scorePerCell) {\n    this.state = STATES.REMOVING;\n    const points = cells.length * scorePerCell;\n    this.scoreSystem.addScore(points);\n\n    for (const { row, col } of cells) {\n      const tile = this.board.getTile(row, col);\n      if (tile && tile.color >= 0) {\n        this.scoreSystem.addCollected(tile.color, 1);\n      }\n    }\n\n    for (const { row, col } of cells) {\n      const tile = this.board.getTile(row, col);\n      if (tile) {\n        const pos = this.renderer.getTileCenter(row, col);\n        const color = COLOR_MAP[tile.color];\n        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 6);\n        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n      }\n    }\n\n    setTimeout(() => {\n      for (const { row, col } of cells) {\n        this.board.clearCell(row, col);\n      }\n\n      this.obstacleMgr.onTilesMatched(cells);\n\n      if (this.boss && this.boss.active) {\n        const dmg = this.boss.calculateDamage(cells);\n        if (dmg > 0) {\n          const defeated = this.boss.takeDamage(dmg);\n          this.audio.playBossHit();\n          if (defeated) {\n            this.audio.playBossDefeat();\n            this.scoreSystem.addScore(500);\n          }\n        }\n      }\n\n      const drops = this.board.applyGravity();\n\n      for (const drop of drops) {\n        const tile = drop.tile;\n        const fromY = drop.fromRow * this.renderer.tileSize;\n        const toY = drop.toRow * this.renderer.tileSize;\n        tile.offsetY = fromY - toY;\n        this.tweens.add(tile, { offsetY: 0 }, 0.2 + drop.distance * 0.03, 'easeOutBounce');\n      }\n\n      this.state = STATES.IDLE;\n      setTimeout(() => this._processMatches(), 350);\n    }, 300);\n  }\n\n  _loop() {\n    const now = performance.now();\n    const dt = Math.min((now - this.lastTime) / 1000, 0.05);\n    this.lastTime = now;\n\n    // Phase 3a: Navigation screens take priority\n    if (this.nav.isActive()) {\n      this.nav.render(this.renderer.ctx, this.renderer.screenW, this.renderer.screenH);\n      // Phase 4: ad stub overlay on top of navigation\n      this.adManager.renderStubAd(this.renderer.ctx, this.renderer.screenW, this.renderer.screenH);\n      requestAnimationFrame(() => this._loop());\n      return;\n    }\n\n    this.update(dt);\n    this.render();\n    // Phase 4: ad stub overlay on top of gameplay\n    this.adManager.renderStubAd(this.renderer.ctx, this.renderer.screenW, this.renderer.screenH);\n    requestAnimationFrame(() => this._loop());\n  }\n\n  update(dt) {\n    this.tweens.update(dt);\n    this.particles.update(dt);\n    this.obstacleMgr.update(dt);\n    if (this.boss) this.boss.update(dt);\n    // Phase 4: ad stub timer\n    this.adManager.update(dt);\n\n    if (this.comboTimer > 0) {\n      this.comboTimer -= dt;\n      if (this.comboTimer <= 0) this.comboText = '';\n    }\n\n    this.input.enabled = this.state === STATES.IDLE;\n  }\n\n  render() {\n    this.renderer.clear();\n    this.renderer.drawBackground();\n\n    for (let r = 0; r < this.board.size; r++) {\n      for (let c = 0; c < this.board.size; c++) {\n        const tile = this.board.getTile(r, c);\n        if (tile) {\n          if (this._selectedTile && this._selectedTile.row === r && this._selectedTile.col === c) {\n            tile.selected = true;\n          } else {\n            tile.selected = false;\n          }\n          this.renderer.drawTile(tile);\n        }\n      }\n    }\n\n    this.renderer.drawObstacles(this.obstacleMgr);\n\n    if (this.boss && this.boss.active) {\n      this.renderer.drawBoss(this.boss, this.renderer);\n    }\n\n    this.particles.draw(this.renderer.ctx);\n    this.renderer.updateAndDrawFloatingTexts(1 / 60);\n\n    const config = this.levels[this.currentLevel] || this.levels[0];\n    this.renderer.drawUI(\n      this.scoreSystem.score,\n      this.scoreSystem.getRemainingMoves(),\n      config,\n      this.scoreSystem,\n      this.currentLevel + 1,\n    );\n\n    if (this.comboText) {\n      this.renderer.drawComboText(this.comboText);\n    }\n\n    if (this.boss && this.boss.active) {\n      this.renderer.drawBossHealthBar(this.boss);\n    }\n\n    // Phase 3a: back-to-map button during gameplay\n    this._drawBackButton();\n\n    // Result screen is now handled by Navigation\n  }\n\n  _drawBackButton() {\n    const ctx = this.renderer.ctx;\n    const w = this.renderer.screenW;\n    ctx.fillStyle = '#8D6E6399';\n    this.renderer._roundRect(ctx, w - 50, this.renderer.boardY + this.renderer.tileSize * BOARD_SIZE + 25, 40, 28, 14);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 12px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('地图', w - 30, this.renderer.boardY + this.renderer.tileSize * BOARD_SIZE + 44);\n  }\n\n  retry() {\n    this._loadLevel(this.currentLevel);\n    this.state = STATES.IDLE;\n  }\n\n  nextLevel() {\n    const next = this.currentLevel + 1;\n    if (next < this.levels.length) {\n      this._loadLevel(next);\n      this.state = STATES.IDLE;\n    } else {\n      this._loadLevel(0);\n      this.state = STATES.IDLE;\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Game, STATES };\n","numLines":672,"startLine":1,"totalLines":672}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_49cb106de7c647fbbec5e40b","type":"tool_result","content":"1\t// Renderer.js — Canvas 2D rendering engine with obstacle, boss, and updated UI support\n2\t\n3\tclass Renderer {\n4\t  constructor(canvas) {\n5\t    this.canvas = canvas;\n6\t    this.ctx = canvas.getContext('2d');\n7\t    this.tileSize = 0;\n8\t    this.boardX = 0;\n9\t    this.boardY = 0;\n10\t    this.particleSystem = null;\n11\t    this.floatingTexts = [];\n12\t    this.resize();\n13\t  }\n14\t\n15\t  resize() {\n16\t    const dpr = window.devicePixelRatio || 1;\n17\t    const w = window.innerWidth;\n18\t    const h = window.innerHeight;\n19\t    this.canvas.width = w * dpr;\n20\t    this.canvas.height = h * dpr;\n21\t    this.canvas.style.width = w + 'px';\n22\t    this.canvas.style.height = h + 'px';\n23\t    this.ctx.scale(dpr, dpr);\n24\t    this.screenW = w;\n25\t    this.screenH = h;\n26\t\n27\t    this.tileSize = Math.floor(Math.min(w * 0.9, (h - 160)) / BOARD_SIZE);\n28\t    this.boardX = (w - this.tileSize * BOARD_SIZE) / 2;\n29\t    this.boardY = 140;\n30\t  }\n31\t\n32\t  getTileCenter(row, col) {\n33\t    return {\n34\t      x: this.boardX + col * this.tileSize + this.tileSize / 2,\n35\t      y: this.boardY + row * this.tileSize + this.tileSize / 2,\n36\t    };\n37\t  }\n38\t\n39\t  clear() {\n40\t    this.ctx.clearRect(0, 0, this.screenW, this.screenH);\n41\t  }\n42\t\n43\t  drawBackground() {\n44\t    const ctx = this.ctx;\n45\t    ctx.fillStyle = '#FFF8E7';\n46\t    ctx.fillRect(0, 0, this.screenW, this.screenH);\n47\t\n48\t    const bw = this.tileSize * BOARD_SIZE;\n49\t    const bh = this.tileSize * BOARD_SIZE;\n50\t    ctx.fillStyle = '#FFFFFFCC';\n51\t    this._roundRect(ctx, this.boardX - 6, this.boardY - 6, bw + 12, bh + 12, 12);\n52\t    ctx.fill();\n53\t\n54\t    ctx.strokeStyle = '#F0E6D6';\n55\t    ctx.lineWidth = 1;\n56\t    for (let i = 0; i <= BOARD_SIZE; i++) {\n57\t      ctx.beginPath();\n58\t      ctx.moveTo(this.boardX + i * this.tileSize, this.boardY);\n59\t      ctx.lineTo(this.boardX + i * this.tileSize, this.boardY + bh);\n60\t      ctx.stroke();\n61\t      ctx.beginPath();\n62\t      ctx.moveTo(this.boardX, this.boardY + i * this.tileSize);\n63\t      ctx.lineTo(this.boardX + bw, this.boardY + i * this.tileSize);\n64\t      ctx.stroke();\n65\t    }\n66\t  }\n67\t\n68\t  drawTile(tile) {\n69\t    if (!tile || tile.color < 0) return;\n70\t    const ctx = this.ctx;\n71\t    const size = this.tileSize - 4;\n72\t    const cx = this.boardX + tile.col * this.tileSize + this.tileSize / 2 + (tile.offsetX || 0);\n73\t    const cy = this.boardY + tile.row * this.tileSize + this.tileSize / 2 + (tile.offsetY || 0);\n74\t    const scale = tile.scale || 1;\n75\t    const alpha = tile.alpha !== undefined ? tile.alpha : 1;\n76\t\n77\t    ctx.save();\n78\t    ctx.translate(cx, cy);\n79\t    ctx.scale(scale, scale);\n80\t    ctx.globalAlpha = alpha;\n81\t\n82\t    const half = size / 2;\n83\t    const color = COLOR_MAP[tile.color];\n84\t    if (!color) { ctx.restore(); return; }\n85\t\n86\t    ctx.fillStyle = color.hex;\n87\t    this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n88\t    ctx.fill();\n89\t\n90\t    ctx.fillStyle = 'rgba(255,255,255,0.25)';\n91\t    this._roundRect(ctx, -half + 3, -half + 3, size - 6, size / 2 - 3, size * 0.15);\n92\t    ctx.fill();\n93\t\n94\t    this._drawFruitIcon(ctx, tile.color, half * 0.55);\n95\t\n96\t    if (tile.special === SPECIAL_STRIPED_H) {\n97\t      this._drawStripes(ctx, size, half, '#FFFFFF80', true);\n98\t    } else if (tile.special === SPECIAL_STRIPED_V) {\n99\t      this._drawStripes(ctx, size, half, '#FFFFFF80', false);\n100\t    } else if (tile.special === SPECIAL_BOMB) {\n101\t      this._drawCrosshair(ctx, half);\n102\t    } else if (tile.special === SPECIAL_RAINBOW) {\n103\t      this._drawRainbowOverlay(ctx, half);\n104\t    }\n105\t\n106\t    if (tile.selected) {\n107\t      ctx.strokeStyle = '#FFFFFF';\n108\t      ctx.lineWidth = 3;\n109\t      ctx.shadowColor = '#FFB800';\n110\t      ctx.shadowBlur = 12;\n111\t      this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n112\t      ctx.stroke();\n113\t      ctx.shadowBlur = 0;\n114\t    }\n115\t\n116\t    ctx.restore();\n117\t  }\n118\t\n119\t  _drawFruitIcon(ctx, colorIdx, radius) {\n120\t    ctx.fillStyle = 'rgba(255,255,255,0.6)';\n121\t    ctx.font = `bold ${radius * 1.4}px sans-serif`;\n122\t    ctx.textAlign = 'center';\n123\t    ctx.textBaseline = 'middle';\n124\t    const icons = ['🍎', '🍌', '🫐', '🍏', '🍇', '🍊'];\n125\t    ctx.fillText(icons[colorIdx] || '', 0, 1);\n126\t  }\n127\t\n128\t  _drawStripes(ctx, size, half, color, horizontal) {\n129\t    ctx.strokeStyle = color;\n130\t    ctx.lineWidth = 2;\n131\t    if (horizontal) {\n132\t      for (let y = -half + 6; y < half; y += 8) {\n133\t        ctx.beginPath();\n134\t        ctx.moveTo(-half + 4, y);\n135\t        ctx.lineTo(half - 4, y);\n136\t        ctx.stroke();\n137\t      }\n138\t    } else {\n139\t      for (let x = -half + 6; x < half; x += 8) {\n140\t        ctx.beginPath();\n141\t        ctx.moveTo(x, -half + 4);\n142\t        ctx.lineTo(x, half - 4);\n143\t        ctx.stroke();\n144\t      }\n145\t    }\n146\t  }\n147\t\n148\t  _drawCrosshair(ctx, half) {\n149\t    ctx.strokeStyle = '#FFFFFF99';\n150\t    ctx.lineWidth = 2;\n151\t    ctx.beginPath();\n152\t    ctx.moveTo(-half * 0.6, 0); ctx.lineTo(half * 0.6, 0);\n153\t    ctx.moveTo(0, -half * 0.6); ctx.lineTo(0, half * 0.6);\n154\t    ctx.stroke();\n155\t    ctx.beginPath();\n156\t    ctx.arc(0, 0, half * 0.4, 0, Math.PI * 2);\n157\t    ctx.stroke();\n158\t  }\n159\t\n160\t  _drawRainbowOverlay(ctx, half) {\n161\t    const gradient = ctx.createLinearGradient(-half, -half, half, half);\n162\t    gradient.addColorStop(0, '#FF000080');\n163\t    gradient.addColorStop(0.17, '#FF880080');\n164\t    gradient.addColorStop(0.33, '#FFFF0080');\n165\t    gradient.addColorStop(0.5, '#00FF0080');\n166\t    gradient.addColorStop(0.67, '#0088FF80');\n167\t    gradient.addColorStop(0.83, '#8800FF80');\n168\t    gradient.addColorStop(1, '#FF008880');\n169\t    ctx.fillStyle = gradient;\n170\t    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.4);\n171\t    ctx.fill();\n172\t  }\n173\t\n174\t  // Draw all obstacles\n175\t  drawObstacles(obstacleMgr) {\n176\t    for (const obs of obstacleMgr.obstacles) {\n177\t      if (obs.isDestroyed()) continue;\n178\t      const shake = obs.shakeTimer > 0 ? (Math.random() - 0.5) * 4 : 0;\n179\t      const pos = this.getTileCenter(obs.row, obs.col);\n180\t      const half = (this.tileSize - 4) / 2;\n181\t\n182\t      this.ctx.save();\n183\t      this.ctx.translate(pos.x + shake, pos.y);\n184\t\n185\t      switch (obs.type) {\n186\t        case OBSTACLE_ICE:\n187\t          this._drawIce(this.ctx, half);\n188\t          break;\n189\t        case OBSTACLE_CHAIN:\n190\t          this._drawChain(this.ctx, half);\n191\t          break;\n192\t        case OBSTACLE_CHOCOLATE:\n193\t          this._drawChocolate(this.ctx, half);\n194\t          break;\n195\t      }\n196\t\n197\t      this.ctx.restore();\n198\t    }\n199\t  }\n200\t\n201\t  _drawIce(ctx, half) {\n202\t    // Translucent blue overlay\n203\t    ctx.fillStyle = 'rgba(135, 206, 250, 0.45)';\n204\t    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.2);\n205\t    ctx.fill();\n206\t    // Ice crack pattern\n207\t    ctx.strokeStyle = 'rgba(255, 255, 255, 0.7)';\n208\t    ctx.lineWidth = 1.5;\n209\t    ctx.beginPath();\n210\t    ctx.moveTo(-half * 0.3, -half * 0.5);\n211\t    ctx.lineTo(half * 0.2, 0);\n212\t    ctx.lineTo(-half * 0.1, half * 0.4);\n213\t    ctx.stroke();\n214\t    ctx.beginPath();\n215\t    ctx.moveTo(half * 0.3, -half * 0.3);\n216\t    ctx.lineTo(0, half * 0.1);\n217\t    ctx.stroke();\n218\t    // Ice label\n219\t    ctx.fillStyle = 'rgba(255,255,255,0.8)';\n220\t    ctx.font = `bold ${half * 0.6}px sans-serif`;\n221\t    ctx.textAlign = 'center';\n222\t    ctx.textBaseline = 'middle';\n223\t    ctx.fillText('❄', 0, 0);\n224\t  }\n225\t\n226\t  _drawChain(ctx, half) {\n227\t    // Chain icon overlay\n228\t    ctx.fillStyle = 'rgba(100, 100, 100, 0.35)';\n229\t    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.2);\n230\t    ctx.fill();\n231\t    // Chain links\n232\t    ctx.strokeStyle = 'rgba(80, 80, 80, 0.9)';\n233\t    ctx.lineWidth = 3;\n234\t    for (let i = -1; i <= 1; i++) {\n235\t      ctx.beginPath();\n236\t      ctx.ellipse(i * half * 0.5, 0, half * 0.25, half * 0.15, 0, 0, Math.PI * 2);\n237\t      ctx.stroke();\n238\t    }\n239\t    // Lock icon\n240\t    ctx.fillStyle = 'rgba(255,255,255,0.7)';\n241\t    ctx.font = `bold ${half * 0.7}px sans-serif`;\n242\t    ctx.textAlign = 'center';\n243\t    ctx.textBaseline = 'middle';\n244\t    ctx.fillText('🔗', 0, -half * 0.6);\n245\t  }\n246\t\n247\t  _drawChocolate(ctx, half) {\n248\t    // Brown blob\n249\t    ctx.fillStyle = '#6B3410';\n250\t    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.3);\n251\t    ctx.fill();\n252\t    // Chocolate drip pattern\n253\t    ctx.fillStyle = '#8B5E3C';\n254\t    this._roundRect(ctx, -half + 3, -half + 3, half * 2 - 6, half * 2 - 6, half * 0.25);\n255\t    ctx.fill();\n256\t    // Shine\n257\t    ctx.fillStyle = 'rgba(255,255,255,0.15)';\n258\t    this._roundRect(ctx, -half + 6, -half + 6, half - 3, half * 0.6, half * 0.15);\n259\t    ctx.fill();\n260\t    // Emoji\n261\t    ctx.font = `bold ${half * 0.8}px sans-serif`;\n262\t    ctx.textAlign = 'center';\n263\t    ctx.textBaseline = 'middle';\n264\t    ctx.fillText('🍫', 0, 0);\n265\t  }\n266\t\n267\t  // Draw boss on board\n268\t  drawBoss(boss, renderer) {\n269\t    const pos = this.getTileCenter(boss.row, boss.col);\n270\t    const half = (this.tileSize - 4) / 2;\n271\t    const shake = boss.shakeTimer > 0 ? (Math.random() - 0.5) * 6 : 0;\n272\t\n273\t    this.ctx.save();\n274\t    this.ctx.translate(pos.x + shake, pos.y);\n275\t\n276\t    // Boss body\n277\t    const isUsingSkill = boss.skillAnimTimer > 0;\n278\t    const pulseScale = isUsingSkill ? 1.1 : 1;\n279\t    this.ctx.scale(pulseScale, pulseScale);\n280\t\n281\t    // Dark aura\n282\t    this.ctx.fillStyle = isUsingSkill ? 'rgba(255,0,0,0.15)' : 'rgba(80,0,80,0.1)';\n283\t    this.ctx.beginPath();\n284\t    this.ctx.arc(0, 0, half * 1.3, 0, Math.PI * 2);\n285\t    this.ctx.fill();\n286\t\n287\t    // Boss face\n288\t    this.ctx.fillStyle = '#4A0E4E';\n289\t    this._roundRect(this.ctx, -half, -half, half * 2, half * 2, half * 0.3);\n290\t    this.ctx.fill();\n291\t\n292\t    // Inner glow\n293\t    const grad = this.ctx.createRadialGradient(0, 0, 0, 0, 0, half);\n294\t    grad.addColorStop(0, 'rgba(255,100,200,0.3)');\n295\t    grad.addColorStop(1, 'rgba(80,0,120,0.1)');\n296\t    this.ctx.fillStyle = grad;\n297\t    this._roundRect(this.ctx, -half, -half, half * 2, half * 2, half * 0.3);\n298\t    this.ctx.fill();\n299\t\n300\t    // Boss emoji\n301\t    this.ctx.font = `bold ${half * 1.2}px sans-serif`;\n302\t    this.ctx.textAlign = 'center';\n303\t    this.ctx.textBaseline = 'middle';\n304\t    const hpRatio = boss.hp / boss.maxHp;\n305\t    const bossEmoji = hpRatio > 0.5 ? '👹' : hpRatio > 0.25 ? '👿' : '💀';\n306\t    this.ctx.fillText(bossEmoji, 0, 0);\n307\t\n308\t    this.ctx.restore();\n309\t  }\n310\t\n311\t  // Draw boss health bar above the board\n312\t  drawBossHealthBar(boss) {\n313\t    const ctx = this.ctx;\n314\t    const barW = Math.min(200, this.screenW - 40);\n315\t    const barH = 14;\n316\t    const barX = (this.screenW - barW) / 2;\n317\t    const barY = this.boardY + this.tileSize * BOARD_SIZE + 50;\n318\t\n319\t    // Background\n320\t    ctx.fillStyle = '#E0D5C5';\n321\t    this._roundRect(ctx, barX, barY, barW, barH, 7);\n322\t    ctx.fill();\n323\t\n324\t    // HP bar\n325\t    const hpRatio = Math.max(0, boss.hp / boss.maxHp);\n326\t    if (hpRatio > 0) {\n327\t      const grad = ctx.createLinearGradient(barX, barY, barX + barW * hpRatio, barY);\n328\t      grad.addColorStop(0, '#FF4D4D');\n329\t      grad.addColorStop(1, '#CC0000');\n330\t      ctx.fillStyle = grad;\n331\t      this._roundRect(ctx, barX, barY, barW * hpRatio, barH, 7);\n332\t      ctx.fill();\n333\t    }\n334\t\n335\t    // Boss name and HP text\n336\t    ctx.fillStyle = '#5D4037';\n337\t    ctx.font = 'bold 12px sans-serif';\n338\t    ctx.textAlign = 'center';\n339\t    ctx.fillText(`${boss.name}  ${boss.hp}/${boss.maxHp}`, this.screenW / 2, barY + barH + 14);\n340\t  }\n341\t\n342\t  // Updated drawUI to support new goal types\n343\t  drawUI(score, moves, config, scoreSystem, level) {\n344\t    const ctx = this.ctx;\n345\t\n346\t    // Top bar background\n347\t    ctx.fillStyle = '#FFB800';\n348\t    this._roundRect(ctx, 8, 8, this.screenW - 16, 55, 12);\n349\t    ctx.fill();\n350\t\n351\t    // Level\n352\t    ctx.fillStyle = '#5D4037';\n353\t    ctx.font = 'bold 18px sans-serif';\n354\t    ctx.textAlign = 'left';\n355\t    ctx.fillText(`第 ${level} 关`, 20, 42);\n356\t\n357\t    // Level name\n358\t    if (config.name) {\n359\t      ctx.font = '12px sans-serif';\n360\t      ctx.fillText(config.name, 20, 22);\n361\t    }\n362\t\n363\t    // Score\n364\t    ctx.textAlign = 'center';\n365\t    ctx.fillStyle = '#FFFFFF';\n366\t    ctx.font = 'bold 20px sans-serif';\n367\t    ctx.fillText(`${score}`, this.screenW / 2, 32);\n368\t    ctx.font = '12px sans-serif';\n369\t    ctx.fillText('分数', this.screenW / 2, 48);\n370\t\n371\t    // Moves\n372\t    ctx.textAlign = 'right';\n373\t    ctx.fillStyle = moves <= 5 ? '#FF4D4D' : '#5D4037';\n374\t    ctx.font = 'bold 22px sans-serif';\n375\t    ctx.fillText(`${moves}`, this.screenW - 20, 32);\n376\t    ctx.font = '12px sans-serif';\n377\t    ctx.fillStyle = '#5D4037';\n378\t    ctx.fillText('剩余步数', this.screenW - 20, 48);\n379\t\n380\t    // Goal progress — use the new goal description\n381\t    const goalDesc = scoreSystem.getGoalDescription();\n382\t    const progressBars = scoreSystem.getProgressForUI();\n383\t\n384\t    const barW = this.screenW - 40;\n385\t    const barH = 16;\n386\t    const barY = 72;\n387\t    const barX = 20;\n388\t\n389\t    // Goal label\n390\t    ctx.fillStyle = '#5D4037';\n391\t    ctx.font = 'bold 11px sans-serif';\n392\t    ctx.textAlign = 'center';\n393\t\n394\t    if (progressBars.length === 1) {\n395\t      // Single goal — progress bar\n396\t      const p = progressBars[0];\n397\t      ctx.fillStyle = '#E0D5C5';\n398\t      this._roundRect(ctx, barX, barY, barW, barH, 8);\n399\t      ctx.fill();\n400\t\n401\t      const progress = Math.min(p.current / p.target, 1);\n402\t      if (progress > 0) {\n403\t        const grad = ctx.createLinearGradient(barX, barY, barX + barW * progress, barY);\n404\t        grad.addColorStop(0, '#6BCB77');\n405\t        grad.addColorStop(1, '#4DA66B');\n406\t        ctx.fillStyle = grad;\n407\t        this._roundRect(ctx, barX, barY, barW * progress, barH, 8);\n408\t        ctx.fill();\n409\t      }\n410\t\n411\t      ctx.fillStyle = '#5D4037';\n412\t      ctx.font = 'bold 11px sans-serif';\n413\t      ctx.fillText(goalDesc, this.screenW / 2, barY + 13);\n414\t    } else {\n415\t      // Dual goal — two smaller bars\n416\t      const halfBarW = (barW - 10) / 2;\n417\t      for (let i = 0; i < progressBars.length; i++) {\n418\t        const p = progressBars[i];\n419\t        const bx = barX + i * (halfBarW + 10);\n420\t\n421\t        ctx.fillStyle = '#E0D5C5';\n422\t        this._roundRect(ctx, bx, barY, halfBarW, barH, 8);\n423\t        ctx.fill();\n424\t\n425\t        const progress = Math.min(p.current / p.target, 1);\n426\t        if (progress > 0) {\n427\t          const grad = ctx.createLinearGradient(bx, barY, bx + halfBarW * progress, barY);\n428\t          grad.addColorStop(0, i === 0 ? '#6BCB77' : '#4DA6FF');\n429\t          grad.addColorStop(1, i === 0 ? '#4DA66B' : '#3388DD');\n430\t          ctx.fillStyle = grad;\n431\t          this._roundRect(ctx, bx, barY, halfBarW * progress, barH, 8);\n432\t          ctx.fill();\n433\t        }\n434\t\n435\t        ctx.fillStyle = '#5D4037';\n436\t        ctx.font = 'bold 10px sans-serif';\n437\t        ctx.fillText(`${p.current}/${p.target}`, bx + halfBarW / 2, barY + 13);\n438\t      }\n439\t    }\n440\t\n441\t    // Bottom hint\n442\t    ctx.fillStyle = '#8D6E63';\n443\t    ctx.font = '14px sans-serif';\n444\t    ctx.textAlign = 'center';\n445\t    const hintY = this.boardY + this.tileSize * BOARD_SIZE + 30;\n446\t    // Don't overlap with boss health bar\n447\t    const hintOffset = scoreSystem.goalType === 'boss' ? 0 : 30;\n448\t    ctx.fillText('滑动交换相邻方块', this.screenW / 2, hintY + hintOffset);\n449\t  }\n450\t\n451\t  drawComboText(text) {\n452\t    if (!text) return;\n453\t    const ctx = this.ctx;\n454\t    ctx.save();\n455\t    ctx.fillStyle = '#FF4D4D';\n456\t    ctx.font = 'bold 36px sans-serif';\n457\t    ctx.textAlign = 'center';\n458\t    ctx.textBaseline = 'middle';\n459\t    ctx.shadowColor = '#FFB800';\n460\t    ctx.shadowBlur = 8;\n461\t    ctx.fillText(text, this.screenW / 2, this.boardY + this.tileSize * BOARD_SIZE / 2);\n462\t    ctx.restore();\n463\t  }\n464\t\n465\t  addFloatingText(text, x, y, color = '#FF4D4D') {\n466\t    this.floatingTexts.push({ text, x, y, alpha: 1, vy: -60, life: 1.0, color });\n467\t  }\n468\t\n469\t  updateAndDrawFloatingTexts(dt) {\n470\t    const ctx = this.ctx;\n471\t    this.floatingTexts = this.floatingTexts.filter(ft => {\n472\t      ft.y += ft.vy * dt;\n473\t      ft.life -= dt;\n474\t      ft.alpha = Math.max(0, ft.life);\n475\t      if (ft.life <= 0) return false;\n476\t\n477\t      ctx.globalAlpha = ft.alpha;\n478\t      ctx.fillStyle = ft.color;\n479\t      ctx.font = 'bold 18px sans-serif';\n480\t      ctx.textAlign = 'center';\n481\t      ctx.fillText(ft.text, ft.x, ft.y);\n482\t      ctx.globalAlpha = 1;\n483\t      return true;\n484\t    });\n485\t  }\n486\t\n487\t  drawResultScreen(won, score, stars, level) {\n488\t    const ctx = this.ctx;\n489\t    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n490\t    ctx.fillRect(0, 0, this.screenW, this.screenH);\n491\t\n492\t    const pw = Math.min(320, this.screenW - 40);\n493\t    const ph = 260;\n494\t    const px = (this.screenW - pw) / 2;\n495\t    const py = (this.screenH - ph) / 2;\n496\t\n497\t    ctx.fillStyle = '#FFF8E7';\n498\t    this._roundRect(ctx, px, py, pw, ph, 16);\n499\t    ctx.fill();\n500\t    ctx.strokeStyle = '#FFB800';\n501\t    ctx.lineWidth = 3;\n502\t    this._roundRect(ctx, px, py, pw, ph, 16);\n503\t    ctx.stroke();\n504\t\n505\t    ctx.fillStyle = '#5D4037';\n506\t    ctx.font = 'bold 24px sans-serif';\n507\t    ctx.textAlign = 'center';\n508\t    ctx.fillText(won ? '🎉 恭喜过关！' : '😢 挑战失败', this.screenW / 2, py + 45);\n509\t\n510\t    ctx.font = 'bold 36px sans-serif';\n511\t    ctx.fillStyle = '#FFB800';\n512\t    ctx.fillText(score, this.screenW / 2, py + 95);\n513\t    ctx.font = '14px sans-serif';\n514\t    ctx.fillStyle = '#8D6E63';\n515\t    ctx.fillText('得分', this.screenW / 2, py + 115);\n516\t\n517\t    if (won) {\n518\t      for (let i = 0; i < 3; i++) {\n519\t        ctx.font = '32px sans-serif';\n520\t        ctx.fillText(i < stars ? '⭐' : '☆', this.screenW / 2 - 45 + i * 45, py + 160);\n521\t      }\n522\t    }\n523\t\n524\t    const btnW = 120, btnH = 42;\n525\t    const btnY = py + ph - 60;\n526\t\n527\t    ctx.fillStyle = '#6BCB77';\n528\t    this._roundRect(ctx, this.screenW / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n529\t    ctx.fill();\n530\t    ctx.fillStyle = '#FFFFFF';\n531\t    ctx.font = 'bold 16px sans-serif';\n532\t    ctx.fillText(won ? '下一关' : '重试', this.screenW / 2 - btnW / 2 - 10, btnY + 27);\n533\t\n534\t    ctx.fillStyle = '#8D6E63';\n535\t    this._roundRect(ctx, this.screenW / 2 + 10, btnY, btnW, btnH, btnH / 2);\n536\t    ctx.fill();\n537\t    ctx.fillStyle = '#FFFFFF';\n538\t    ctx.fillText('菜单', this.screenW / 2 + btnW / 2 + 10, btnY + 27);\n539\t  }\n540\t\n541\t  _roundRect(ctx, x, y, w, h, r) {\n542\t    ctx.beginPath();\n543\t    ctx.moveTo(x + r, y);\n544\t    ctx.lineTo(x + w - r, y);\n545\t    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n546\t    ctx.lineTo(x + w, y + h - r);\n547\t    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n548\t    ctx.lineTo(x + r, y + h);\n549\t    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n550\t    ctx.lineTo(x, y + r);\n551\t    ctx.quadraticCurveTo(x, y, x + r, y);\n552\t    ctx.closePath();\n553\t  }\n554\t}\n555\t\n556\tif (typeof module !== 'undefined') module.exports = { Renderer };\n557\t"}]},"parent_tool_use_id":null,"session_id":"33562fd9-d4f0-45be-a2a4-d9d379182d9f","uuid":"1a544c9e-ede7-477e-a1f3-dc1560f7fd0c","timestamp":"2026-05-23T10:17:22.961Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-match3/src/js/Renderer.js","content":"// Renderer.js — Canvas 2D rendering engine with obstacle, boss, and updated UI support\n\nclass Renderer {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d');\n    this.tileSize = 0;\n    this.boardX = 0;\n    this.boardY = 0;\n    this.particleSystem = null;\n    this.floatingTexts = [];\n    this.resize();\n  }\n\n  resize() {\n    const dpr = window.devicePixelRatio || 1;\n    const w = window.innerWidth;\n    const h = window.innerHeight;\n    this.canvas.width = w * dpr;\n    this.canvas.height = h * dpr;\n    this.canvas.style.width = w + 'px';\n    this.canvas.style.height = h + 'px';\n    this.ctx.scale(dpr, dpr);\n    this.screenW = w;\n    this.screenH = h;\n\n    this.tileSize = Math.floor(Math.min(w * 0.9, (h - 160)) / BOARD_SIZE);\n    this.boardX = (w - this.tileSize * BOARD_SIZE) / 2;\n    this.boardY = 140;\n  }\n\n  getTileCenter(row, col) {\n    return {\n      x: this.boardX + col * this.tileSize + this.tileSize / 2,\n      y: this.boardY + row * this.tileSize + this.tileSize / 2,\n    };\n  }\n\n  clear() {\n    this.ctx.clearRect(0, 0, this.screenW, this.screenH);\n  }\n\n  drawBackground() {\n    const ctx = this.ctx;\n    ctx.fillStyle = '#FFF8E7';\n    ctx.fillRect(0, 0, this.screenW, this.screenH);\n\n    const bw = this.tileSize * BOARD_SIZE;\n    const bh = this.tileSize * BOARD_SIZE;\n    ctx.fillStyle = '#FFFFFFCC';\n    this._roundRect(ctx, this.boardX - 6, this.boardY - 6, bw + 12, bh + 12, 12);\n    ctx.fill();\n\n    ctx.strokeStyle = '#F0E6D6';\n    ctx.lineWidth = 1;\n    for (let i = 0; i <= BOARD_SIZE; i++) {\n      ctx.beginPath();\n      ctx.moveTo(this.boardX + i * this.tileSize, this.boardY);\n      ctx.lineTo(this.boardX + i * this.tileSize, this.boardY + bh);\n      ctx.stroke();\n      ctx.beginPath();\n      ctx.moveTo(this.boardX, this.boardY + i * this.tileSize);\n      ctx.lineTo(this.boardX + bw, this.boardY + i * this.tileSize);\n      ctx.stroke();\n    }\n  }\n\n  drawTile(tile) {\n    if (!tile || tile.color < 0) return;\n    const ctx = this.ctx;\n    const size = this.tileSize - 4;\n    const cx = this.boardX + tile.col * this.tileSize + this.tileSize / 2 + (tile.offsetX || 0);\n    const cy = this.boardY + tile.row * this.tileSize + this.tileSize / 2 + (tile.offsetY || 0);\n    const scale = tile.scale || 1;\n    const alpha = tile.alpha !== undefined ? tile.alpha : 1;\n\n    ctx.save();\n    ctx.translate(cx, cy);\n    ctx.scale(scale, scale);\n    ctx.globalAlpha = alpha;\n\n    const half = size / 2;\n    const color = COLOR_MAP[tile.color];\n    if (!color) { ctx.restore(); return; }\n\n    ctx.fillStyle = color.hex;\n    this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n    ctx.fill();\n\n    ctx.fillStyle = 'rgba(255,255,255,0.25)';\n    this._roundRect(ctx, -half + 3, -half + 3, size - 6, size / 2 - 3, size * 0.15);\n    ctx.fill();\n\n    this._drawFruitIcon(ctx, tile.color, half * 0.55);\n\n    if (tile.special === SPECIAL_STRIPED_H) {\n      this._drawStripes(ctx, size, half, '#FFFFFF80', true);\n    } else if (tile.special === SPECIAL_STRIPED_V) {\n      this._drawStripes(ctx, size, half, '#FFFFFF80', false);\n    } else if (tile.special === SPECIAL_BOMB) {\n      this._drawCrosshair(ctx, half);\n    } else if (tile.special === SPECIAL_RAINBOW) {\n      this._drawRainbowOverlay(ctx, half);\n    }\n\n    if (tile.selected) {\n      ctx.strokeStyle = '#FFFFFF';\n      ctx.lineWidth = 3;\n      ctx.shadowColor = '#FFB800';\n      ctx.shadowBlur = 12;\n      this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n      ctx.stroke();\n      ctx.shadowBlur = 0;\n    }\n\n    ctx.restore();\n  }\n\n  _drawFruitIcon(ctx, colorIdx, radius) {\n    ctx.fillStyle = 'rgba(255,255,255,0.6)';\n    ctx.font = `bold ${radius * 1.4}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    const icons = ['🍎', '🍌', '🫐', '🍏', '🍇', '🍊'];\n    ctx.fillText(icons[colorIdx] || '', 0, 1);\n  }\n\n  _drawStripes(ctx, size, half, color, horizontal) {\n    ctx.strokeStyle = color;\n    ctx.lineWidth = 2;\n    if (horizontal) {\n      for (let y = -half + 6; y < half; y += 8) {\n        ctx.beginPath();\n        ctx.moveTo(-half + 4, y);\n        ctx.lineTo(half - 4, y);\n        ctx.stroke();\n      }\n    } else {\n      for (let x = -half + 6; x < half; x += 8) {\n        ctx.beginPath();\n        ctx.moveTo(x, -half + 4);\n        ctx.lineTo(x, half - 4);\n        ctx.stroke();\n      }\n    }\n  }\n\n  _drawCrosshair(ctx, half) {\n    ctx.strokeStyle = '#FFFFFF99';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.moveTo(-half * 0.6, 0); ctx.lineTo(half * 0.6, 0);\n    ctx.moveTo(0, -half * 0.6); ctx.lineTo(0, half * 0.6);\n    ctx.stroke();\n    ctx.beginPath();\n    ctx.arc(0, 0, half * 0.4, 0, Math.PI * 2);\n    ctx.stroke();\n  }\n\n  _drawRainbowOverlay(ctx, half) {\n    const gradient = ctx.createLinearGradient(-half, -half, half, half);\n    gradient.addColorStop(0, '#FF000080');\n    gradient.addColorStop(0.17, '#FF880080');\n    gradient.addColorStop(0.33, '#FFFF0080');\n    gradient.addColorStop(0.5, '#00FF0080');\n    gradient.addColorStop(0.67, '#0088FF80');\n    gradient.addColorStop(0.83, '#8800FF80');\n    gradient.addColorStop(1, '#FF008880');\n    ctx.fillStyle = gradient;\n    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.4);\n    ctx.fill();\n  }\n\n  // Draw all obstacles\n  drawObstacles(obstacleMgr) {\n    for (const obs of obstacleMgr.obstacles) {\n      if (obs.isDestroyed()) continue;\n      const shake = obs.shakeTimer > 0 ? (Math.random() - 0.5) * 4 : 0;\n      const pos = this.getTileCenter(obs.row, obs.col);\n      const half = (this.tileSize - 4) / 2;\n\n      this.ctx.save();\n      this.ctx.translate(pos.x + shake, pos.y);\n\n      switch (obs.type) {\n        case OBSTACLE_ICE:\n          this._drawIce(this.ctx, half);\n          break;\n        case OBSTACLE_CHAIN:\n          this._drawChain(this.ctx, half);\n          break;\n        case OBSTACLE_CHOCOLATE:\n          this._drawChocolate(this.ctx, half);\n          break;\n      }\n\n      this.ctx.restore();\n    }\n  }\n\n  _drawIce(ctx, half) {\n    // Translucent blue overlay\n    ctx.fillStyle = 'rgba(135, 206, 250, 0.45)';\n    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.2);\n    ctx.fill();\n    // Ice crack pattern\n    ctx.strokeStyle = 'rgba(255, 255, 255, 0.7)';\n    ctx.lineWidth = 1.5;\n    ctx.beginPath();\n    ctx.moveTo(-half * 0.3, -half * 0.5);\n    ctx.lineTo(half * 0.2, 0);\n    ctx.lineTo(-half * 0.1, half * 0.4);\n    ctx.stroke();\n    ctx.beginPath();\n    ctx.moveTo(half * 0.3, -half * 0.3);\n    ctx.lineTo(0, half * 0.1);\n    ctx.stroke();\n    // Ice label\n    ctx.fillStyle = 'rgba(255,255,255,0.8)';\n    ctx.font = `bold ${half * 0.6}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText('❄', 0, 0);\n  }\n\n  _drawChain(ctx, half) {\n    // Chain icon overlay\n    ctx.fillStyle = 'rgba(100, 100, 100, 0.35)';\n    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.2);\n    ctx.fill();\n    // Chain links\n    ctx.strokeStyle = 'rgba(80, 80, 80, 0.9)';\n    ctx.lineWidth = 3;\n    for (let i = -1; i <= 1; i++) {\n      ctx.beginPath();\n      ctx.ellipse(i * half * 0.5, 0, half * 0.25, half * 0.15, 0, 0, Math.PI * 2);\n      ctx.stroke();\n    }\n    // Lock icon\n    ctx.fillStyle = 'rgba(255,255,255,0.7)';\n    ctx.font = `bold ${half * 0.7}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText('🔗', 0, -half * 0.6);\n  }\n\n  _drawChocolate(ctx, half) {\n    // Brown blob\n    ctx.fillStyle = '#6B3410';\n    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.3);\n    ctx.fill();\n    // Chocolate drip pattern\n    ctx.fillStyle = '#8B5E3C';\n    this._roundRect(ctx, -half + 3, -half + 3, half * 2 - 6, half * 2 - 6, half * 0.25);\n    ctx.fill();\n    // Shine\n    ctx.fillStyle = 'rgba(255,255,255,0.15)';\n    this._roundRect(ctx, -half + 6, -half + 6, half - 3, half * 0.6, half * 0.15);\n    ctx.fill();\n    // Emoji\n    ctx.font = `bold ${half * 0.8}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText('🍫', 0, 0);\n  }\n\n  // Draw boss on board\n  drawBoss(boss, renderer) {\n    const pos = this.getTileCenter(boss.row, boss.col);\n    const half = (this.tileSize - 4) / 2;\n    const shake = boss.shakeTimer > 0 ? (Math.random() - 0.5) * 6 : 0;\n\n    this.ctx.save();\n    this.ctx.translate(pos.x + shake, pos.y);\n\n    // Boss body\n    const isUsingSkill = boss.skillAnimTimer > 0;\n    const pulseScale = isUsingSkill ? 1.1 : 1;\n    this.ctx.scale(pulseScale, pulseScale);\n\n    // Dark aura\n    this.ctx.fillStyle = isUsingSkill ? 'rgba(255,0,0,0.15)' : 'rgba(80,0,80,0.1)';\n    this.ctx.beginPath();\n    this.ctx.arc(0, 0, half * 1.3, 0, Math.PI * 2);\n    this.ctx.fill();\n\n    // Boss face\n    this.ctx.fillStyle = '#4A0E4E';\n    this._roundRect(this.ctx, -half, -half, half * 2, half * 2, half * 0.3);\n    this.ctx.fill();\n\n    // Inner glow\n    const grad = this.ctx.createRadialGradient(0, 0, 0, 0, 0, half);\n    grad.addColorStop(0, 'rgba(255,100,200,0.3)');\n    grad.addColorStop(1, 'rgba(80,0,120,0.1)');\n    this.ctx.fillStyle = grad;\n    this._roundRect(this.ctx, -half, -half, half * 2, half * 2, half * 0.3);\n    this.ctx.fill();\n\n    // Boss emoji\n    this.ctx.font = `bold ${half * 1.2}px sans-serif`;\n    this.ctx.textAlign = 'center';\n    this.ctx.textBaseline = 'middle';\n    const hpRatio = boss.hp / boss.maxHp;\n    const bossEmoji = hpRatio > 0.5 ? '👹' : hpRatio > 0.25 ? '👿' : '💀';\n    this.ctx.fillText(bossEmoji, 0, 0);\n\n    this.ctx.restore();\n  }\n\n  // Draw boss health bar above the board\n  drawBossHealthBar(boss) {\n    const ctx = this.ctx;\n    const barW = Math.min(200, this.screenW - 40);\n    const barH = 14;\n    const barX = (this.screenW - barW) / 2;\n    const barY = this.boardY + this.tileSize * BOARD_SIZE + 50;\n\n    // Background\n    ctx.fillStyle = '#E0D5C5';\n    this._roundRect(ctx, barX, barY, barW, barH, 7);\n    ctx.fill();\n\n    // HP bar\n    const hpRatio = Math.max(0, boss.hp / boss.maxHp);\n    if (hpRatio > 0) {\n      const grad = ctx.createLinearGradient(barX, barY, barX + barW * hpRatio, barY);\n      grad.addColorStop(0, '#FF4D4D');\n      grad.addColorStop(1, '#CC0000');\n      ctx.fillStyle = grad;\n      this._roundRect(ctx, barX, barY, barW * hpRatio, barH, 7);\n      ctx.fill();\n    }\n\n    // Boss name and HP text\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 12px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(`${boss.name}  ${boss.hp}/${boss.maxHp}`, this.screenW / 2, barY + barH + 14);\n  }\n\n  // Updated drawUI to support new goal types\n  drawUI(score, moves, config, scoreSystem, level) {\n    const ctx = this.ctx;\n\n    // Top bar background\n    ctx.fillStyle = '#FFB800';\n    this._roundRect(ctx, 8, 8, this.screenW - 16, 55, 12);\n    ctx.fill();\n\n    // Level\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 18px sans-serif';\n    ctx.textAlign = 'left';\n    ctx.fillText(`第 ${level} 关`, 20, 42);\n\n    // Level name\n    if (config.name) {\n      ctx.font = '12px sans-serif';\n      ctx.fillText(config.name, 20, 22);\n    }\n\n    // Score\n    ctx.textAlign = 'center';\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.fillText(`${score}`, this.screenW / 2, 32);\n    ctx.font = '12px sans-serif';\n    ctx.fillText('分数', this.screenW / 2, 48);\n\n    // Moves\n    ctx.textAlign = 'right';\n    ctx.fillStyle = moves <= 5 ? '#FF4D4D' : '#5D4037';\n    ctx.font = 'bold 22px sans-serif';\n    ctx.fillText(`${moves}`, this.screenW - 20, 32);\n    ctx.font = '12px sans-serif';\n    ctx.fillStyle = '#5D4037';\n    ctx.fillText('剩余步数', this.screenW - 20, 48);\n\n    // Goal progress — use the new goal description\n    const goalDesc = scoreSystem.getGoalDescription();\n    const progressBars = scoreSystem.getProgressForUI();\n\n    const barW = this.screenW - 40;\n    const barH = 16;\n    const barY = 72;\n    const barX = 20;\n\n    // Goal label\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 11px sans-serif';\n    ctx.textAlign = 'center';\n\n    if (progressBars.length === 1) {\n      // Single goal — progress bar\n      const p = progressBars[0];\n      ctx.fillStyle = '#E0D5C5';\n      this._roundRect(ctx, barX, barY, barW, barH, 8);\n      ctx.fill();\n\n      const progress = Math.min(p.current / p.target, 1);\n      if (progress > 0) {\n        const grad = ctx.createLinearGradient(barX, barY, barX + barW * progress, barY);\n        grad.addColorStop(0, '#6BCB77');\n        grad.addColorStop(1, '#4DA66B');\n        ctx.fillStyle = grad;\n        this._roundRect(ctx, barX, barY, barW * progress, barH, 8);\n        ctx.fill();\n      }\n\n      ctx.fillStyle = '#5D4037';\n      ctx.font = 'bold 11px sans-serif';\n      ctx.fillText(goalDesc, this.screenW / 2, barY + 13);\n    } else {\n      // Dual goal — two smaller bars\n      const halfBarW = (barW - 10) / 2;\n      for (let i = 0; i < progressBars.length; i++) {\n        const p = progressBars[i];\n        const bx = barX + i * (halfBarW + 10);\n\n        ctx.fillStyle = '#E0D5C5';\n        this._roundRect(ctx, bx, barY, halfBarW, barH, 8);\n        ctx.fill();\n\n        const progress = Math.min(p.current / p.target, 1);\n        if (progress > 0) {\n          const grad = ctx.createLinearGradient(bx, barY, bx + halfBarW * progress, barY);\n          grad.addColorStop(0, i === 0 ? '#6BCB77' : '#4DA6FF');\n          grad.addColorStop(1, i === 0 ? '#4DA66B' : '#3388DD');\n          ctx.fillStyle = grad;\n          this._roundRect(ctx, bx, barY, halfBarW * progress, barH, 8);\n          ctx.fill();\n        }\n\n        ctx.fillStyle = '#5D4037';\n        ctx.font = 'bold 10px sans-serif';\n        ctx.fillText(`${p.current}/${p.target}`, bx + halfBarW / 2, barY + 13);\n      }\n    }\n\n    // Bottom hint\n    ctx.fillStyle = '#8D6E63';\n    ctx.font = '14px sans-serif';\n    ctx.textAlign = 'center';\n    const hintY = this.boardY + this.tileSize * BOARD_SIZE + 30;\n    // Don't overlap with boss health bar\n    const hintOffset = scoreSystem.goalType === 'boss' ? 0 : 30;\n    ctx.fillText('滑动交换相邻方块', this.screenW / 2, hintY + hintOffset);\n  }\n\n  drawComboText(text) {\n    if (!text) return;\n    const ctx = this.ctx;\n    ctx.save();\n    ctx.fillStyle = '#FF4D4D';\n    ctx.font = 'bold 36px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.shadowColor = '#FFB800';\n    ctx.shadowBlur = 8;\n    ctx.fillText(text, this.screenW / 2, this.boardY + this.tileSize * BOARD_SIZE / 2);\n    ctx.restore();\n  }\n\n  addFloatingText(text, x, y, color = '#FF4D4D') {\n    this.floatingTexts.push({ text, x, y, alpha: 1, vy: -60, life: 1.0, color });\n  }\n\n  updateAndDrawFloatingTexts(dt) {\n    const ctx = this.ctx;\n    this.floatingTexts = this.floatingTexts.filter(ft => {\n      ft.y += ft.vy * dt;\n      ft.life -= dt;\n      ft.alpha = Math.max(0, ft.life);\n      if (ft.life <= 0) return false;\n\n      ctx.globalAlpha = ft.alpha;\n      ctx.fillStyle = ft.color;\n      ctx.font = 'bold 18px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText(ft.text, ft.x, ft.y);\n      ctx.globalAlpha = 1;\n      return true;\n    });\n  }\n\n  drawResultScreen(won, score, stars, level) {\n    const ctx = this.ctx;\n    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n    ctx.fillRect(0, 0, this.screenW, this.screenH);\n\n    const pw = Math.min(320, this.screenW - 40);\n    const ph = 260;\n    const px = (this.screenW - pw) / 2;\n    const py = (this.screenH - ph) / 2;\n\n    ctx.fillStyle = '#FFF8E7';\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.fill();\n    ctx.strokeStyle = '#FFB800';\n    ctx.lineWidth = 3;\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.stroke();\n\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 24px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(won ? '🎉 恭喜过关！' : '😢 挑战失败', this.screenW / 2, py + 45);\n\n    ctx.font = 'bold 36px sans-serif';\n    ctx.fillStyle = '#FFB800';\n    ctx.fillText(score, this.screenW / 2, py + 95);\n    ctx.font = '14px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText('得分', this.screenW / 2, py + 115);\n\n    if (won) {\n      for (let i = 0; i < 3; i++) {\n        ctx.font = '32px sans-serif';\n        ctx.fillText(i < stars ? '⭐' : '☆', this.screenW / 2 - 45 + i * 45, py + 160);\n      }\n    }\n\n    const btnW = 120, btnH = 42;\n    const btnY = py + ph - 60;\n\n    ctx.fillStyle = '#6BCB77';\n    this._roundRect(ctx, this.screenW / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n    ctx.fill();\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = 'bold 16px sans-serif';\n    ctx.fillText(won ? '下一关' : '重试', this.screenW / 2 - btnW / 2 - 10, btnY + 27);\n\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, this.screenW / 2 + 10, btnY, btnW, btnH, btnH / 2);\n    ctx.fill();\n    ctx.fillStyle = '#FFFFFF';\n    ctx.fillText('菜单', this.screenW / 2 + btnW / 2 + 10, btnY + 27);\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Renderer };\n","numLines":557,"startLine":1,"totalLines":557}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_415dbcf8b9634abb92f10b84","type":"tool_result","content":"1\t// Navigation.js — Full screen navigation: menu → map → character → game → result\n2\t\n3\tconst NAV_SCREENS = {\n4\t  MENU: 'menu',\n5\t  MAP: 'map',\n6\t  SHOP: 'shop',\n7\t  CHARACTER: 'character',\n8\t  GAME: 'game',\n9\t  RESULT: 'result',\n10\t  DAILY: 'daily',\n11\t  SOCIAL: 'social',\n12\t};\n13\t\n14\tclass Navigation {\n15\t  constructor(game) {\n16\t    this.game = game;\n17\t    this.screen = NAV_SCREENS.MENU;\n18\t    this.dataManager = game.dataManager;\n19\t    this.coinSystem = game.coinSystem;\n20\t    this.characterMgr = game.characterMgr;\n21\t    this.mapScreen = game.mapScreen;\n22\t    this.shopUI = game.shopUI;\n23\t    this.adManager = game.adManager;\n24\t    this.analytics = game.analytics;\n25\t    this.resultCoins = 0;\n26\t    this.resultWon = false;\n27\t    this.resultScore = 0;\n28\t    this.resultStars = 0;\n29\t    this.resultLevel = 0;\n30\t    this.resultDoubled = false;\n31\t    this.resultUsedContinue = false;\n32\t    this.menuAnim = 0;\n33\t    this.showBoostPrompt = false;\n34\t    this.boostLevel = -1;\n35\t  }\n36\t\n37\t  isActive() {\n38\t    return this.screen !== NAV_SCREENS.GAME;\n39\t  }\n40\t\n41\t  goTo(screen) {\n42\t    this.screen = screen;\n43\t  }\n44\t\n45\t  render(ctx, screenW, screenH) {\n46\t    switch (this.screen) {\n47\t      case NAV_SCREENS.MENU:\n48\t        this._renderMenu(ctx, screenW, screenH);\n49\t        break;\n50\t      case NAV_SCREENS.MAP:\n51\t        this.mapScreen.render(ctx, screenW, screenH);\n52\t        break;\n53\t      case NAV_SCREENS.SHOP:\n54\t        this.shopUI.render(ctx, screenW, screenH);\n55\t        break;\n56\t      case NAV_SCREENS.CHARACTER:\n57\t        this._renderCharacterSelect(ctx, screenW, screenH);\n58\t        break;\n59\t      case NAV_SCREENS.RESULT:\n60\t        this._renderResult(ctx, screenW, screenH);\n61\t        break;\n62\t      case NAV_SCREENS.DAILY:\n63\t        this.game.dailySystem.render(ctx, screenW, screenH);\n64\t        break;\n65\t      case NAV_SCREENS.SOCIAL:\n66\t        this.game.socialSystem.render(ctx, screenW, screenH);\n67\t        break;\n68\t    }\n69\t  }\n70\t\n71\t  handleClick(x, y, screenW, screenH) {\n72\t    switch (this.screen) {\n73\t      case NAV_SCREENS.MENU:\n74\t        return this._handleMenuClick(x, y, screenW, screenH);\n75\t      case NAV_SCREENS.MAP:\n76\t        return this._handleMapClick(x, y, screenW, screenH);\n77\t      case NAV_SCREENS.SHOP:\n78\t        return this._handleShopClick(x, y, screenW, screenH);\n79\t      case NAV_SCREENS.CHARACTER:\n80\t        return this._handleCharacterClick(x, y, screenW, screenH);\n81\t      case NAV_SCREENS.RESULT:\n82\t        return this._handleResultClick(x, y, screenW, screenH);\n83\t      case NAV_SCREENS.DAILY:\n84\t        return this._handleDailyClick(x, y, screenW, screenH);\n85\t      case NAV_SCREENS.SOCIAL:\n86\t        return this._handleSocialClick(x, y, screenW, screenH);\n87\t    }\n88\t    return null;\n89\t  }\n90\t\n91\t  // --- MENU ---\n92\t  _renderMenu(ctx, w, h) {\n93\t    this.menuAnim += 1 / 60;\n94\t\n95\t    // Gradient background\n96\t    const grad = ctx.createLinearGradient(0, 0, 0, h);\n97\t    grad.addColorStop(0, '#FFE8F0');\n98\t    grad.addColorStop(0.5, '#FFF8E7');\n99\t    grad.addColorStop(1, '#E3F2FD');\n100\t    ctx.fillStyle = grad;\n101\t    ctx.fillRect(0, 0, w, h);\n102\t\n103\t    // Floating fruit emojis\n104\t    const emojis = ['🍎', '🍌', '🫐', '🍏', '🍇', '🍊'];\n105\t    for (let i = 0; i < 12; i++) {\n106\t      const bx = (w * 0.08 + (i * 137.5) % (w * 0.84));\n107\t      const by = (h * 0.08 + (i * 97.3 + Math.sin(this.menuAnim * 0.8 + i * 0.7) * 25) % (h * 0.75));\n108\t      ctx.globalAlpha = 0.12;\n109\t      ctx.font = `${22 + (i % 3) * 8}px sans-serif`;\n110\t      ctx.textAlign = 'center';\n111\t      ctx.fillText(emojis[i % emojis.length], bx, by);\n112\t    }\n113\t    ctx.globalAlpha = 1;\n114\t\n115\t    // Title\n116\t    const titleY = h * 0.22;\n117\t    ctx.fillStyle = '#5D4037';\n118\t    ctx.font = 'bold 38px sans-serif';\n119\t    ctx.textAlign = 'center';\n120\t    ctx.fillText('消消消大作战', w / 2, titleY);\n121\t\n122\t    // Subtitle with wave animation\n123\t    ctx.font = '18px sans-serif';\n124\t    ctx.fillStyle = '#8D6E63';\n125\t    ctx.fillText('Match & Blast', w / 2, titleY + 35);\n126\t\n127\t    // Fruit emoji row\n128\t    ctx.font = '30px sans-serif';\n129\t    for (let i = 0; i < 6; i++) {\n130\t      const fx = w / 2 - 75 + i * 30;\n131\t      const fy = titleY + 70 + Math.sin(this.menuAnim * 2 + i * 0.8) * 5;\n132\t      ctx.fillText(emojis[i], fx, fy);\n133\t    }\n134\t\n135\t    // Start button with pulse\n136\t    const btnW = 200, btnH = 52;\n137\t    const btnX = (w - btnW) / 2;\n138\t    const btnY = h * 0.52;\n139\t    const pulse = 1 + Math.sin(this.menuAnim * 2.5) * 0.03;\n140\t\n141\t    ctx.save();\n142\t    ctx.translate(w / 2, btnY + btnH / 2);\n143\t    ctx.scale(pulse, pulse);\n144\t    ctx.translate(-w / 2, -(btnY + btnH / 2));\n145\t\n146\t    ctx.fillStyle = '#FFB800';\n147\t    ctx.shadowColor = '#FFB80088';\n148\t    ctx.shadowBlur = 15;\n149\t    this._roundRect(ctx, btnX, btnY, btnW, btnH, 26);\n150\t    ctx.fill();\n151\t    ctx.shadowBlur = 0;\n152\t\n153\t    ctx.fillStyle = '#FFF';\n154\t    ctx.font = 'bold 20px sans-serif';\n155\t    ctx.fillText('🎮 开始游戏', w / 2, btnY + 34);\n156\t    ctx.restore();\n157\t\n158\t    // Continue (if has progress)\n159\t    const completed = Object.keys(this.dataManager.data.levelStars).length;\n160\t    if (completed > 0) {\n161\t      const cBtnY = btnY + btnH + 20;\n162\t      ctx.fillStyle = '#6BCB77';\n163\t      this._roundRect(ctx, btnX, cBtnY, btnW, 44, 22);\n164\t      ctx.fill();\n165\t      ctx.fillStyle = '#FFF';\n166\t      ctx.font = 'bold 16px sans-serif';\n167\t      ctx.fillText(`继续游戏 (${completed}关)`, w / 2, cBtnY + 28);\n168\t    }\n169\t\n170\t    // Version\n171\t    ctx.fillStyle = '#C0B8A8';\n172\t    ctx.font = '12px sans-serif';\n173\t    ctx.fillText('Phase 4 v1.0', w / 2, h - 20);\n174\t  }\n175\t\n176\t  _handleMenuClick(x, y, w, h) {\n177\t    const btnW = 200, btnH = 52;\n178\t    const btnX = (w - btnW) / 2;\n179\t    const btnY = h * 0.52;\n180\t\n181\t    // Start button\n182\t    if (x >= btnX && x <= btnX + btnW && y >= btnY && y <= btnY + btnH) {\n183\t      this.goTo(NAV_SCREENS.MAP);\n184\t      return { action: 'start' };\n185\t    }\n186\t\n187\t    // Continue button\n188\t    const completed = Object.keys(this.dataManager.data.levelStars).length;\n189\t    if (completed > 0) {\n190\t      const cBtnY = btnY + btnH + 20;\n191\t      if (x >= btnX && x <= btnX + btnW && y >= cBtnY && y <= cBtnY + 44) {\n192\t        this.goTo(NAV_SCREENS.MAP);\n193\t        return { action: 'start' };\n194\t      }\n195\t    }\n196\t    return null;\n197\t  }\n198\t\n199\t  // --- MAP ---\n200\t  _handleMapClick(x, y, w, h) {\n201\t    const result = this.mapScreen.handleClick(x, y, w, h);\n202\t    if (!result) return null;\n203\t\n204\t    if (result.action === 'play') {\n205\t      this._startLevel(result.level);\n206\t    } else if (result.action === 'shop') {\n207\t      this.goTo(NAV_SCREENS.SHOP);\n208\t    } else if (result.action === 'character') {\n209\t      this.goTo(NAV_SCREENS.CHARACTER);\n210\t    } else if (result.action === 'daily') {\n211\t      this.goTo(NAV_SCREENS.DAILY);\n212\t    } else if (result.action === 'social') {\n213\t      this.goTo(NAV_SCREENS.SOCIAL);\n214\t    }\n215\t    return result;\n216\t  }\n217\t\n218\t  _startLevel(levelIdx) {\n219\t    this.game._loadLevel(levelIdx);\n220\t    this.game.state = STATES.IDLE;\n221\t    this.characterMgr.applySkill(\n222\t      this.dataManager.selectedCharacter,\n223\t      this.game, 'level_start', null,\n224\t    );\n225\t    this.goTo(NAV_SCREENS.GAME);\n226\t    // Phase 4: analytics\n227\t    this.analytics.trackLevelStart(levelIdx + 1, this.game.levels[levelIdx] || {});\n228\t  }\n229\t\n230\t  // --- SHOP ---\n231\t  _handleShopClick(x, y, w, h) {\n232\t    const result = this.shopUI.handleClick(x, y, w, h);\n233\t    if (!result) return null;\n234\t    if (result.action === 'buy') {\n235\t      this.coinSystem.buy(result.itemId);\n236\t    } else if (result.action === 'back') {\n237\t      this.goTo(NAV_SCREENS.MAP);\n238\t    }\n239\t    return result;\n240\t  }\n241\t\n242\t  // --- CHARACTER SELECT ---\n243\t  _renderCharacterSelect(ctx, w, h) {\n244\t    // Background\n245\t    const grad = ctx.createLinearGradient(0, 0, 0, h);\n246\t    grad.addColorStop(0, '#F3E5F5');\n247\t    grad.addColorStop(1, '#FFF8E7');\n248\t    ctx.fillStyle = grad;\n249\t    ctx.fillRect(0, 0, w, h);\n250\t\n251\t    // Title bar\n252\t    ctx.fillStyle = '#B47AEA';\n253\t    this._roundRect(ctx, 10, 8, w - 20, 48, 12);\n254\t    ctx.fill();\n255\t    ctx.fillStyle = '#FFF';\n256\t    ctx.font = 'bold 20px sans-serif';\n257\t    ctx.textAlign = 'center';\n258\t    ctx.fillText('👤 选择角色', w / 2, 40);\n259\t\n260\t    // Character cards\n261\t    const chars = this.characterMgr.getAll();\n262\t    const cardW = Math.min((w - 50) / 2, 160);\n263\t    const cardH = 130;\n264\t    const totalGridW = cardW * 2 + 16;\n265\t    const gridStartX = (w - totalGridW) / 2;\n266\t    const startY = 75;\n267\t\n268\t    for (let i = 0; i < chars.length; i++) {\n269\t      const ch = chars[i];\n270\t      const row = Math.floor(i / 2);\n271\t      const col = i % 2;\n272\t      const cx = gridStartX + col * (cardW + 16);\n273\t      const cy = startY + row * (cardH + 12);\n274\t      const unlocked = this.characterMgr.isUnlocked(i, this.dataManager.unlockedLevel);\n275\t      const selected = this.dataManager.selectedCharacter === i;\n276\t\n277\t      // Card background\n278\t      if (selected) {\n279\t        ctx.fillStyle = '#FFE0B2';\n280\t      } else if (unlocked) {\n281\t        ctx.fillStyle = '#FFFFFFEE';\n282\t      } else {\n283\t        ctx.fillStyle = '#E8E0D8';\n284\t      }\n285\t      this._roundRect(ctx, cx, cy, cardW, cardH, 12);\n286\t      ctx.fill();\n287\t\n288\t      // Selected border\n289\t      if (selected) {\n290\t        ctx.strokeStyle = '#FFB800';\n291\t        ctx.lineWidth = 3;\n292\t        this._roundRect(ctx, cx, cy, cardW, cardH, 12);\n293\t        ctx.stroke();\n294\t\n295\t        // Check mark\n296\t        ctx.fillStyle = '#FFB800';\n297\t        ctx.font = '16px sans-serif';\n298\t        ctx.textAlign = 'right';\n299\t        ctx.fillText('✓', cx + cardW - 8, cy + 18);\n300\t      }\n301\t\n302\t      // Emoji\n303\t      ctx.font = '36px sans-serif';\n304\t      ctx.textAlign = 'center';\n305\t      ctx.fillText(unlocked ? ch.emoji : '🔒', cx + cardW / 2, cy + 45);\n306\t\n307\t      // Name\n308\t      ctx.fillStyle = unlocked ? '#5D4037' : '#A09888';\n309\t      ctx.font = 'bold 16px sans-serif';\n310\t      ctx.fillText(ch.name, cx + cardW / 2, cy + 72);\n311\t\n312\t      // Title\n313\t      ctx.font = '11px sans-serif';\n314\t      ctx.fillStyle = unlocked ? '#B47AEA' : '#C0B8A8';\n315\t      ctx.fillText(ch.title, cx + cardW / 2, cy + 88);\n316\t\n317\t      // Description or unlock requirement\n318\t      ctx.fillStyle = unlocked ? '#8D6E63' : '#B0A898';\n319\t      ctx.font = '10px sans-serif';\n320\t      const desc = unlocked ? ch.desc : `通过第${ch.unlockLevel}关解锁`;\n321\t      // Word wrap for long text\n322\t      if (desc.length > 10) {\n323\t        const mid = Math.ceil(desc.length / 2);\n324\t        const spaceIdx = desc.indexOf(' ', mid - 3);\n325\t        if (spaceIdx > 0 && spaceIdx < desc.length - 1) {\n326\t          ctx.fillText(desc.substring(0, spaceIdx), cx + cardW / 2, cy + 104);\n327\t          ctx.fillText(desc.substring(spaceIdx + 1), cx + cardW / 2, cy + 118);\n328\t        } else {\n329\t          ctx.fillText(desc.substring(0, Math.ceil(desc.length / 2)), cx + cardW / 2, cy + 104);\n330\t          ctx.fillText(desc.substring(Math.ceil(desc.length / 2)), cx + cardW / 2, cy + 118);\n331\t        }\n332\t      } else {\n333\t        ctx.fillText(desc, cx + cardW / 2, cy + 110);\n334\t      }\n335\t    }\n336\t\n337\t    // Confirm button\n338\t    ctx.fillStyle = '#8D6E63';\n339\t    this._roundRect(ctx, 20, h - 58, w - 40, 42, 21);\n340\t    ctx.fill();\n341\t    ctx.fillStyle = '#FFF';\n342\t    ctx.font = 'bold 16px sans-serif';\n343\t    ctx.textAlign = 'center';\n344\t    ctx.fillText('确认返回', w / 2, h - 32);\n345\t  }\n346\t\n347\t  _handleCharacterClick(x, y, w, h) {\n348\t    const chars = this.characterMgr.getAll();\n349\t    const cardW = Math.min((w - 50) / 2, 160);\n350\t    const cardH = 130;\n351\t    const totalGridW = cardW * 2 + 16;\n352\t    const gridStartX = (w - totalGridW) / 2;\n353\t    const startY = 75;\n354\t\n355\t    for (let i = 0; i < chars.length; i++) {\n356\t      const row = Math.floor(i / 2);\n357\t      const col = i % 2;\n358\t      const cx = gridStartX + col * (cardW + 16);\n359\t      const cy = startY + row * (cardH + 12);\n360\t      if (x >= cx && x <= cx + cardW && y >= cy && y <= cy + cardH) {\n361\t        if (this.characterMgr.isUnlocked(i, this.dataManager.unlockedLevel)) {\n362\t          this.dataManager.selectedCharacter = i;\n363\t        }\n364\t        return { action: 'select_char', charId: i };\n365\t      }\n366\t    }\n367\t\n368\t    // Confirm button\n369\t    if (y >= h - 58 && y <= h - 16 && x >= 20 && x <= w - 20) {\n370\t      this.goTo(NAV_SCREENS.MAP);\n371\t      return { action: 'back' };\n372\t    }\n373\t    return null;\n374\t  }\n375\t\n376\t  // --- RESULT ---\n377\t  showResult(won, score, stars, level) {\n378\t    this.resultWon = won;\n379\t    this.resultScore = score;\n380\t    this.resultStars = stars;\n381\t    this.resultLevel = level;\n382\t    this.resultCoins = 0;\n383\t    this.resultDoubled = false;\n384\t    this.resultUsedContinue = false;\n385\t    if (won && stars > 0) {\n386\t      this.resultCoins = this.coinSystem.awardStars(stars);\n387\t      this.dataManager.setLevelStars(level, stars);\n388\t    }\n389\t    this.goTo(NAV_SCREENS.RESULT);\n390\t  }\n391\t\n392\t  _renderResult(ctx, w, h) {\n393\t    // Dim background\n394\t    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n395\t    ctx.fillRect(0, 0, w, h);\n396\t\n397\t    const pw = Math.min(320, w - 40);\n398\t    const ph = this.resultWon ? 380 : 400;\n399\t    const px = (w - pw) / 2;\n400\t    const py = (h - ph) / 2;\n401\t\n402\t    // Panel\n403\t    ctx.fillStyle = '#FFF8E7';\n404\t    this._roundRect(ctx, px, py, pw, ph, 16);\n405\t    ctx.fill();\n406\t    ctx.strokeStyle = '#FFB800';\n407\t    ctx.lineWidth = 3;\n408\t    this._roundRect(ctx, px, py, pw, ph, 16);\n409\t    ctx.stroke();\n410\t\n411\t    ctx.textAlign = 'center';\n412\t\n413\t    // Title\n414\t    ctx.fillStyle = '#5D4037';\n415\t    ctx.font = 'bold 24px sans-serif';\n416\t    ctx.fillText(this.resultWon ? '🎉 恭喜过关！' : '😢 挑战失败', w / 2, py + 45);\n417\t\n418\t    // Level number\n419\t    ctx.font = '14px sans-serif';\n420\t    ctx.fillStyle = '#8D6E63';\n421\t    ctx.fillText(`第 ${this.resultLevel} 关`, w / 2, py + 68);\n422\t\n423\t    // Score\n424\t    ctx.font = 'bold 36px sans-serif';\n425\t    ctx.fillStyle = '#FFB800';\n426\t    ctx.fillText(this.resultScore, w / 2, py + 110);\n427\t    ctx.font = '14px sans-serif';\n428\t    ctx.fillStyle = '#8D6E63';\n429\t    ctx.fillText('得分', w / 2, py + 130);\n430\t\n431\t    // Stars\n432\t    if (this.resultWon) {\n433\t      for (let i = 0; i < 3; i++) {\n434\t        ctx.font = '30px sans-serif';\n435\t        ctx.fillText(i < this.resultStars ? '⭐' : '☆', w / 2 - 40 + i * 40, py + 172);\n436\t      }\n437\t    }\n438\t\n439\t    // Coins earned\n440\t    if (this.resultCoins > 0) {\n441\t      const coinLabel = this.resultDoubled ? `+${this.resultCoins} 🪙 (已翻倍!)` : `+${this.resultCoins} 🪙`;\n442\t      ctx.fillStyle = this.resultDoubled ? '#FF4D4D' : '#FFB800';\n443\t      ctx.font = 'bold 18px sans-serif';\n444\t      ctx.fillText(coinLabel, w / 2, py + 205);\n445\t      ctx.fillStyle = '#8D6E63';\n446\t      ctx.font = '12px sans-serif';\n447\t      ctx.fillText(`余额: ${this.dataManager.coins} 🪙`, w / 2, py + 224);\n448\t\n449\t      // Phase 4: Double reward ad button\n450\t      if (!this.resultDoubled && AdManager.shouldShowAdButton(this.adManager, AD_PLACEMENTS.DOUBLE)) {\n451\t        const dBtnY = py + 235;\n452\t        ctx.fillStyle = '#FF4D4D';\n453\t        this._roundRect(ctx, w / 2 - 80, dBtnY, 160, 30, 15);\n454\t        ctx.fill();\n455\t        ctx.fillStyle = '#FFF';\n456\t        ctx.font = 'bold 12px sans-serif';\n457\t        ctx.fillText('🎬 看视频翻倍奖励', w / 2, dBtnY + 20);\n458\t      }\n459\t    }\n460\t\n461\t    // Phase 4: Continue via ad (fail screen)\n462\t    if (!this.resultWon && !this.resultUsedContinue) {\n463\t      const contBtnY = py + 250;\n464\t      if (AdManager.shouldShowAdButton(this.adManager, AD_PLACEMENTS.CONTINUE)) {\n465\t        ctx.fillStyle = '#6BCB77';\n466\t        this._roundRect(ctx, w / 2 - 100, contBtnY, 200, 34, 17);\n467\t        ctx.fill();\n468\t        ctx.fillStyle = '#FFF';\n469\t        ctx.font = 'bold 14px sans-serif';\n470\t        ctx.fillText('🎬 看视频+5步继续', w / 2, contBtnY + 22);\n471\t      } else if (this.coinSystem.canContinue()) {\n472\t        ctx.fillStyle = '#FFB800';\n473\t        this._roundRect(ctx, w / 2 - 80, contBtnY, 160, 30, 15);\n474\t        ctx.fill();\n475\t        ctx.fillStyle = '#FFF';\n476\t        ctx.font = 'bold 12px sans-serif';\n477\t        ctx.fillText('10🪙 购买+5步', w / 2, contBtnY + 20);\n478\t      }\n479\t    }\n480\t\n481\t    // Buttons\n482\t    const btnW = 120, btnH = 42;\n483\t    const btnY = py + ph - 65;\n484\t\n485\t    if (this.resultWon) {\n486\t      // Next level\n487\t      ctx.fillStyle = '#6BCB77';\n488\t      this._roundRect(ctx, w / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n489\t      ctx.fill();\n490\t      ctx.fillStyle = '#FFF';\n491\t      ctx.font = 'bold 16px sans-serif';\n492\t      ctx.fillText('下一关', w / 2 - btnW / 2 - 10, btnY + 27);\n493\t    } else {\n494\t      // Retry\n495\t      ctx.fillStyle = '#FF9A3C';\n496\t      this._roundRect(ctx, w / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n497\t      ctx.fill();\n498\t      ctx.fillStyle = '#FFF';\n499\t      ctx.font = 'bold 16px sans-serif';\n500\t      ctx.fillText('重试', w / 2 - btnW / 2 - 10, btnY + 27);\n501\t    }\n502\t\n503\t    // Map button\n504\t    ctx.fillStyle = '#8D6E63';\n505\t    this._roundRect(ctx, w / 2 + 10, btnY, btnW, btnH, btnH / 2);\n506\t    ctx.fill();\n507\t    ctx.fillStyle = '#FFF';\n508\t    ctx.fillText('🗺️ 地图', w / 2 + btnW / 2 + 10, btnY + 27);\n509\t  }\n510\t\n511\t  _handleResultClick(x, y, w, h) {\n512\t    const pw = Math.min(320, w - 40);\n513\t    const ph = this.resultWon ? 380 : 400;\n514\t    const px = (w - pw) / 2;\n515\t    const py = (h - ph) / 2;\n516\t    const btnW = 120, btnH = 42;\n517\t    const btnY = py + ph - 65;\n518\t\n519\t    // Phase 4: Double reward ad button\n520\t    if (this.resultWon && this.resultCoins > 0 && !this.resultDoubled) {\n521\t      if (AdManager.shouldShowAdButton(this.adManager, AD_PLACEMENTS.DOUBLE)) {\n522\t        const dBtnY = py + 235;\n523\t        if (x >= w / 2 - 80 && x <= w / 2 + 80 && y >= dBtnY && y <= dBtnY + 30) {\n524\t          this.adManager.showRewarded(AD_PLACEMENTS.DOUBLE).then((success) => {\n525\t            this.analytics.trackAdShow(AD_PLACEMENTS.DOUBLE, success);\n526\t            if (success) {\n527\t              this.resultDoubled = true;\n528\t              this.dataManager.addCoins(this.resultCoins);\n529\t            }\n530\t          });\n531\t          return { action: 'ad_double' };\n532\t        }\n533\t      }\n534\t    }\n535\t\n536\t    // Phase 4: Continue via ad button\n537\t    if (!this.resultWon && !this.resultUsedContinue) {\n538\t      const contBtnY = py + 250;\n539\t      if (AdManager.shouldShowAdButton(this.adManager, AD_PLACEMENTS.CONTINUE)) {\n540\t        if (x >= w / 2 - 100 && x <= w / 2 + 100 && y >= contBtnY && y <= contBtnY + 34) {\n541\t          this.adManager.showRewarded(AD_PLACEMENTS.CONTINUE).then((success) => {\n542\t            this.analytics.trackAdShow(AD_PLACEMENTS.CONTINUE, success);\n543\t            if (success) {\n544\t              this.resultUsedContinue = true;\n545\t              this.game.scoreSystem.addMoves(5);\n546\t              this.game.state = STATES.IDLE;\n547\t              this.goTo(NAV_SCREENS.GAME);\n548\t            }\n549\t          });\n550\t          return { action: 'ad_continue' };\n551\t        }\n552\t      } else if (this.coinSystem.canContinue()) {\n553\t        if (x >= w / 2 - 80 && x <= w / 2 + 80 && y >= contBtnY && y <= contBtnY + 30) {\n554\t          this.coinSystem.buyContinue();\n555\t          this.resultUsedContinue = true;\n556\t          this.game.scoreSystem.addMoves(5);\n557\t          this.game.state = STATES.IDLE;\n558\t          this.goTo(NAV_SCREENS.GAME);\n559\t          return { action: 'coin_continue' };\n560\t        }\n561\t      }\n562\t    }\n563\t\n564\t    // Next / Retry button\n565\t    if (x >= w / 2 - btnW - 10 && x <= w / 2 - 10 && y >= btnY && y <= btnY + btnH) {\n566\t      if (this.resultWon) {\n567\t        // Phase 4: show interstitial before next level\n568\t        this._tryInterstitial(() => {\n569\t          this.game.nextLevel();\n570\t          this.characterMgr.applySkill(\n571\t            this.dataManager.selectedCharacter,\n572\t            this.game, 'level_start', null,\n573\t          );\n574\t          this.goTo(NAV_SCREENS.GAME);\n575\t        });\n576\t      } else {\n577\t        this.game.retry();\n578\t        this.characterMgr.applySkill(\n579\t          this.dataManager.selectedCharacter,\n580\t          this.game, 'level_start', null,\n581\t        );\n582\t        this.goTo(NAV_SCREENS.GAME);\n583\t      }\n584\t      return { action: this.resultWon ? 'next' : 'retry' };\n585\t    }\n586\t\n587\t    // Map button\n588\t    if (x >= w / 2 + 10 && x <= w / 2 + 10 + btnW && y >= btnY && y <= btnY + btnH) {\n589\t      // Phase 4: show interstitial when going back to map\n590\t      this._tryInterstitial(() => {\n591\t        this.goTo(NAV_SCREENS.MAP);\n592\t      });\n593\t      return { action: 'map' };\n594\t    }\n595\t    return null;\n596\t  }\n597\t\n598\t  // Phase 4: Interstitial helper\n599\t  _tryInterstitial(callback) {\n600\t    if (this.adManager.canShowInterstitial(this.resultLevel)) {\n601\t      this.adManager.showInterstitial(this.resultLevel).then(() => {\n602\t        this.analytics.trackAdShow(AD_PLACEMENTS.INTERSTITIAL, true);\n603\t        callback();\n604\t      });\n605\t    } else {\n606\t      callback();\n607\t    }\n608\t  }\n609\t\n610\t  // --- DAILY ---\n611\t  _handleDailyClick(x, y, w, h) {\n612\t    const result = this.game.dailySystem.handleClick(x, y, w, h);\n613\t    if (!result) return null;\n614\t    if (result.action === 'back') {\n615\t      this.goTo(NAV_SCREENS.MAP);\n616\t    } else if (result.action === 'play_challenge') {\n617\t      this._startLevel(result.level);\n618\t    }\n619\t    return result;\n620\t  }\n621\t\n622\t  // --- SOCIAL ---\n623\t  _handleSocialClick(x, y, w, h) {\n624\t    const result = this.game.socialSystem.handleClick(x, y, w, h);\n625\t    if (!result) return null;\n626\t    if (result.action === 'back') {\n627\t      this.goTo(NAV_SCREENS.MAP);\n628\t    } else if (result.action === 'pk') {\n629\t      const pk = this.game.socialSystem.startPK(result.friendId);\n630\t      if (pk) {\n631\t        // Simulate PK result\n632\t        const myScore = Math.floor(Math.random() * 5000) + 1000;\n633\t        const theirScore = Math.floor(Math.random() * 5000) + 1000;\n634\t        const pkResult = this.game.socialSystem.resolvePK(result.friendId, myScore, theirScore);\n635\t        return { action: 'pk_result', ...pkResult, myScore, theirScore };\n636\t      }\n637\t    }\n638\t    return result;\n639\t  }\n640\t\n641\t  _roundRect(ctx, x, y, w, h, r) {\n642\t    ctx.beginPath();\n643\t    ctx.moveTo(x + r, y);\n644\t    ctx.lineTo(x + w - r, y);\n645\t    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n646\t    ctx.lineTo(x + w, y + h - r);\n647\t    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n648\t    ctx.lineTo(x + r, y + h);\n649\t    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n650\t    ctx.lineTo(x, y + r);\n651\t    ctx.quadraticCurveTo(x, y, x + r, y);\n652\t    ctx.closePath();\n653\t  }\n654\t}\n655\t\n656\tif (typeof module !== 'undefined') module.exports = { Navigation, NAV_SCREENS };\n657\t"}]},"parent_tool_use_id":null,"session_id":"33562fd9-d4f0-45be-a2a4-d9d379182d9f","uuid":"f95f8481-b26f-432b-bbd2-75662f9ea618","timestamp":"2026-05-23T10:17:22.966Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-match3/src/js/Navigation.js","content":"// Navigation.js — Full screen navigation: menu → map → character → game → result\n\nconst NAV_SCREENS = {\n  MENU: 'menu',\n  MAP: 'map',\n  SHOP: 'shop',\n  CHARACTER: 'character',\n  GAME: 'game',\n  RESULT: 'result',\n  DAILY: 'daily',\n  SOCIAL: 'social',\n};\n\nclass Navigation {\n  constructor(game) {\n    this.game = game;\n    this.screen = NAV_SCREENS.MENU;\n    this.dataManager = game.dataManager;\n    this.coinSystem = game.coinSystem;\n    this.characterMgr = game.characterMgr;\n    this.mapScreen = game.mapScreen;\n    this.shopUI = game.shopUI;\n    this.adManager = game.adManager;\n    this.analytics = game.analytics;\n    this.resultCoins = 0;\n    this.resultWon = false;\n    this.resultScore = 0;\n    this.resultStars = 0;\n    this.resultLevel = 0;\n    this.resultDoubled = false;\n    this.resultUsedContinue = false;\n    this.menuAnim = 0;\n    this.showBoostPrompt = false;\n    this.boostLevel = -1;\n  }\n\n  isActive() {\n    return this.screen !== NAV_SCREENS.GAME;\n  }\n\n  goTo(screen) {\n    this.screen = screen;\n  }\n\n  render(ctx, screenW, screenH) {\n    switch (this.screen) {\n      case NAV_SCREENS.MENU:\n        this._renderMenu(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.MAP:\n        this.mapScreen.render(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.SHOP:\n        this.shopUI.render(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.CHARACTER:\n        this._renderCharacterSelect(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.RESULT:\n        this._renderResult(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.DAILY:\n        this.game.dailySystem.render(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.SOCIAL:\n        this.game.socialSystem.render(ctx, screenW, screenH);\n        break;\n    }\n  }\n\n  handleClick(x, y, screenW, screenH) {\n    switch (this.screen) {\n      case NAV_SCREENS.MENU:\n        return this._handleMenuClick(x, y, screenW, screenH);\n      case NAV_SCREENS.MAP:\n        return this._handleMapClick(x, y, screenW, screenH);\n      case NAV_SCREENS.SHOP:\n        return this._handleShopClick(x, y, screenW, screenH);\n      case NAV_SCREENS.CHARACTER:\n        return this._handleCharacterClick(x, y, screenW, screenH);\n      case NAV_SCREENS.RESULT:\n        return this._handleResultClick(x, y, screenW, screenH);\n      case NAV_SCREENS.DAILY:\n        return this._handleDailyClick(x, y, screenW, screenH);\n      case NAV_SCREENS.SOCIAL:\n        return this._handleSocialClick(x, y, screenW, screenH);\n    }\n    return null;\n  }\n\n  // --- MENU ---\n  _renderMenu(ctx, w, h) {\n    this.menuAnim += 1 / 60;\n\n    // Gradient background\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0, '#FFE8F0');\n    grad.addColorStop(0.5, '#FFF8E7');\n    grad.addColorStop(1, '#E3F2FD');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n\n    // Floating fruit emojis\n    const emojis = ['🍎', '🍌', '🫐', '🍏', '🍇', '🍊'];\n    for (let i = 0; i < 12; i++) {\n      const bx = (w * 0.08 + (i * 137.5) % (w * 0.84));\n      const by = (h * 0.08 + (i * 97.3 + Math.sin(this.menuAnim * 0.8 + i * 0.7) * 25) % (h * 0.75));\n      ctx.globalAlpha = 0.12;\n      ctx.font = `${22 + (i % 3) * 8}px sans-serif`;\n      ctx.textAlign = 'center';\n      ctx.fillText(emojis[i % emojis.length], bx, by);\n    }\n    ctx.globalAlpha = 1;\n\n    // Title\n    const titleY = h * 0.22;\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 38px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('消消消大作战', w / 2, titleY);\n\n    // Subtitle with wave animation\n    ctx.font = '18px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText('Match & Blast', w / 2, titleY + 35);\n\n    // Fruit emoji row\n    ctx.font = '30px sans-serif';\n    for (let i = 0; i < 6; i++) {\n      const fx = w / 2 - 75 + i * 30;\n      const fy = titleY + 70 + Math.sin(this.menuAnim * 2 + i * 0.8) * 5;\n      ctx.fillText(emojis[i], fx, fy);\n    }\n\n    // Start button with pulse\n    const btnW = 200, btnH = 52;\n    const btnX = (w - btnW) / 2;\n    const btnY = h * 0.52;\n    const pulse = 1 + Math.sin(this.menuAnim * 2.5) * 0.03;\n\n    ctx.save();\n    ctx.translate(w / 2, btnY + btnH / 2);\n    ctx.scale(pulse, pulse);\n    ctx.translate(-w / 2, -(btnY + btnH / 2));\n\n    ctx.fillStyle = '#FFB800';\n    ctx.shadowColor = '#FFB80088';\n    ctx.shadowBlur = 15;\n    this._roundRect(ctx, btnX, btnY, btnW, btnH, 26);\n    ctx.fill();\n    ctx.shadowBlur = 0;\n\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.fillText('🎮 开始游戏', w / 2, btnY + 34);\n    ctx.restore();\n\n    // Continue (if has progress)\n    const completed = Object.keys(this.dataManager.data.levelStars).length;\n    if (completed > 0) {\n      const cBtnY = btnY + btnH + 20;\n      ctx.fillStyle = '#6BCB77';\n      this._roundRect(ctx, btnX, cBtnY, btnW, 44, 22);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText(`继续游戏 (${completed}关)`, w / 2, cBtnY + 28);\n    }\n\n    // Version\n    ctx.fillStyle = '#C0B8A8';\n    ctx.font = '12px sans-serif';\n    ctx.fillText('Phase 4 v1.0', w / 2, h - 20);\n  }\n\n  _handleMenuClick(x, y, w, h) {\n    const btnW = 200, btnH = 52;\n    const btnX = (w - btnW) / 2;\n    const btnY = h * 0.52;\n\n    // Start button\n    if (x >= btnX && x <= btnX + btnW && y >= btnY && y <= btnY + btnH) {\n      this.goTo(NAV_SCREENS.MAP);\n      return { action: 'start' };\n    }\n\n    // Continue button\n    const completed = Object.keys(this.dataManager.data.levelStars).length;\n    if (completed > 0) {\n      const cBtnY = btnY + btnH + 20;\n      if (x >= btnX && x <= btnX + btnW && y >= cBtnY && y <= cBtnY + 44) {\n        this.goTo(NAV_SCREENS.MAP);\n        return { action: 'start' };\n      }\n    }\n    return null;\n  }\n\n  // --- MAP ---\n  _handleMapClick(x, y, w, h) {\n    const result = this.mapScreen.handleClick(x, y, w, h);\n    if (!result) return null;\n\n    if (result.action === 'play') {\n      this._startLevel(result.level);\n    } else if (result.action === 'shop') {\n      this.goTo(NAV_SCREENS.SHOP);\n    } else if (result.action === 'character') {\n      this.goTo(NAV_SCREENS.CHARACTER);\n    } else if (result.action === 'daily') {\n      this.goTo(NAV_SCREENS.DAILY);\n    } else if (result.action === 'social') {\n      this.goTo(NAV_SCREENS.SOCIAL);\n    }\n    return result;\n  }\n\n  _startLevel(levelIdx) {\n    this.game._loadLevel(levelIdx);\n    this.game.state = STATES.IDLE;\n    this.characterMgr.applySkill(\n      this.dataManager.selectedCharacter,\n      this.game, 'level_start', null,\n    );\n    this.goTo(NAV_SCREENS.GAME);\n    // Phase 4: analytics\n    this.analytics.trackLevelStart(levelIdx + 1, this.game.levels[levelIdx] || {});\n  }\n\n  // --- SHOP ---\n  _handleShopClick(x, y, w, h) {\n    const result = this.shopUI.handleClick(x, y, w, h);\n    if (!result) return null;\n    if (result.action === 'buy') {\n      this.coinSystem.buy(result.itemId);\n    } else if (result.action === 'back') {\n      this.goTo(NAV_SCREENS.MAP);\n    }\n    return result;\n  }\n\n  // --- CHARACTER SELECT ---\n  _renderCharacterSelect(ctx, w, h) {\n    // Background\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0, '#F3E5F5');\n    grad.addColorStop(1, '#FFF8E7');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n\n    // Title bar\n    ctx.fillStyle = '#B47AEA';\n    this._roundRect(ctx, 10, 8, w - 20, 48, 12);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('👤 选择角色', w / 2, 40);\n\n    // Character cards\n    const chars = this.characterMgr.getAll();\n    const cardW = Math.min((w - 50) / 2, 160);\n    const cardH = 130;\n    const totalGridW = cardW * 2 + 16;\n    const gridStartX = (w - totalGridW) / 2;\n    const startY = 75;\n\n    for (let i = 0; i < chars.length; i++) {\n      const ch = chars[i];\n      const row = Math.floor(i / 2);\n      const col = i % 2;\n      const cx = gridStartX + col * (cardW + 16);\n      const cy = startY + row * (cardH + 12);\n      const unlocked = this.characterMgr.isUnlocked(i, this.dataManager.unlockedLevel);\n      const selected = this.dataManager.selectedCharacter === i;\n\n      // Card background\n      if (selected) {\n        ctx.fillStyle = '#FFE0B2';\n      } else if (unlocked) {\n        ctx.fillStyle = '#FFFFFFEE';\n      } else {\n        ctx.fillStyle = '#E8E0D8';\n      }\n      this._roundRect(ctx, cx, cy, cardW, cardH, 12);\n      ctx.fill();\n\n      // Selected border\n      if (selected) {\n        ctx.strokeStyle = '#FFB800';\n        ctx.lineWidth = 3;\n        this._roundRect(ctx, cx, cy, cardW, cardH, 12);\n        ctx.stroke();\n\n        // Check mark\n        ctx.fillStyle = '#FFB800';\n        ctx.font = '16px sans-serif';\n        ctx.textAlign = 'right';\n        ctx.fillText('✓', cx + cardW - 8, cy + 18);\n      }\n\n      // Emoji\n      ctx.font = '36px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText(unlocked ? ch.emoji : '🔒', cx + cardW / 2, cy + 45);\n\n      // Name\n      ctx.fillStyle = unlocked ? '#5D4037' : '#A09888';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText(ch.name, cx + cardW / 2, cy + 72);\n\n      // Title\n      ctx.font = '11px sans-serif';\n      ctx.fillStyle = unlocked ? '#B47AEA' : '#C0B8A8';\n      ctx.fillText(ch.title, cx + cardW / 2, cy + 88);\n\n      // Description or unlock requirement\n      ctx.fillStyle = unlocked ? '#8D6E63' : '#B0A898';\n      ctx.font = '10px sans-serif';\n      const desc = unlocked ? ch.desc : `通过第${ch.unlockLevel}关解锁`;\n      // Word wrap for long text\n      if (desc.length > 10) {\n        const mid = Math.ceil(desc.length / 2);\n        const spaceIdx = desc.indexOf(' ', mid - 3);\n        if (spaceIdx > 0 && spaceIdx < desc.length - 1) {\n          ctx.fillText(desc.substring(0, spaceIdx), cx + cardW / 2, cy + 104);\n          ctx.fillText(desc.substring(spaceIdx + 1), cx + cardW / 2, cy + 118);\n        } else {\n          ctx.fillText(desc.substring(0, Math.ceil(desc.length / 2)), cx + cardW / 2, cy + 104);\n          ctx.fillText(desc.substring(Math.ceil(desc.length / 2)), cx + cardW / 2, cy + 118);\n        }\n      } else {\n        ctx.fillText(desc, cx + cardW / 2, cy + 110);\n      }\n    }\n\n    // Confirm button\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, 20, h - 58, w - 40, 42, 21);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 16px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('确认返回', w / 2, h - 32);\n  }\n\n  _handleCharacterClick(x, y, w, h) {\n    const chars = this.characterMgr.getAll();\n    const cardW = Math.min((w - 50) / 2, 160);\n    const cardH = 130;\n    const totalGridW = cardW * 2 + 16;\n    const gridStartX = (w - totalGridW) / 2;\n    const startY = 75;\n\n    for (let i = 0; i < chars.length; i++) {\n      const row = Math.floor(i / 2);\n      const col = i % 2;\n      const cx = gridStartX + col * (cardW + 16);\n      const cy = startY + row * (cardH + 12);\n      if (x >= cx && x <= cx + cardW && y >= cy && y <= cy + cardH) {\n        if (this.characterMgr.isUnlocked(i, this.dataManager.unlockedLevel)) {\n          this.dataManager.selectedCharacter = i;\n        }\n        return { action: 'select_char', charId: i };\n      }\n    }\n\n    // Confirm button\n    if (y >= h - 58 && y <= h - 16 && x >= 20 && x <= w - 20) {\n      this.goTo(NAV_SCREENS.MAP);\n      return { action: 'back' };\n    }\n    return null;\n  }\n\n  // --- RESULT ---\n  showResult(won, score, stars, level) {\n    this.resultWon = won;\n    this.resultScore = score;\n    this.resultStars = stars;\n    this.resultLevel = level;\n    this.resultCoins = 0;\n    this.resultDoubled = false;\n    this.resultUsedContinue = false;\n    if (won && stars > 0) {\n      this.resultCoins = this.coinSystem.awardStars(stars);\n      this.dataManager.setLevelStars(level, stars);\n    }\n    this.goTo(NAV_SCREENS.RESULT);\n  }\n\n  _renderResult(ctx, w, h) {\n    // Dim background\n    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n    ctx.fillRect(0, 0, w, h);\n\n    const pw = Math.min(320, w - 40);\n    const ph = this.resultWon ? 380 : 400;\n    const px = (w - pw) / 2;\n    const py = (h - ph) / 2;\n\n    // Panel\n    ctx.fillStyle = '#FFF8E7';\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.fill();\n    ctx.strokeStyle = '#FFB800';\n    ctx.lineWidth = 3;\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.stroke();\n\n    ctx.textAlign = 'center';\n\n    // Title\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 24px sans-serif';\n    ctx.fillText(this.resultWon ? '🎉 恭喜过关！' : '😢 挑战失败', w / 2, py + 45);\n\n    // Level number\n    ctx.font = '14px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText(`第 ${this.resultLevel} 关`, w / 2, py + 68);\n\n    // Score\n    ctx.font = 'bold 36px sans-serif';\n    ctx.fillStyle = '#FFB800';\n    ctx.fillText(this.resultScore, w / 2, py + 110);\n    ctx.font = '14px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText('得分', w / 2, py + 130);\n\n    // Stars\n    if (this.resultWon) {\n      for (let i = 0; i < 3; i++) {\n        ctx.font = '30px sans-serif';\n        ctx.fillText(i < this.resultStars ? '⭐' : '☆', w / 2 - 40 + i * 40, py + 172);\n      }\n    }\n\n    // Coins earned\n    if (this.resultCoins > 0) {\n      const coinLabel = this.resultDoubled ? `+${this.resultCoins} 🪙 (已翻倍!)` : `+${this.resultCoins} 🪙`;\n      ctx.fillStyle = this.resultDoubled ? '#FF4D4D' : '#FFB800';\n      ctx.font = 'bold 18px sans-serif';\n      ctx.fillText(coinLabel, w / 2, py + 205);\n      ctx.fillStyle = '#8D6E63';\n      ctx.font = '12px sans-serif';\n      ctx.fillText(`余额: ${this.dataManager.coins} 🪙`, w / 2, py + 224);\n\n      // Phase 4: Double reward ad button\n      if (!this.resultDoubled && AdManager.shouldShowAdButton(this.adManager, AD_PLACEMENTS.DOUBLE)) {\n        const dBtnY = py + 235;\n        ctx.fillStyle = '#FF4D4D';\n        this._roundRect(ctx, w / 2 - 80, dBtnY, 160, 30, 15);\n        ctx.fill();\n        ctx.fillStyle = '#FFF';\n        ctx.font = 'bold 12px sans-serif';\n        ctx.fillText('🎬 看视频翻倍奖励', w / 2, dBtnY + 20);\n      }\n    }\n\n    // Phase 4: Continue via ad (fail screen)\n    if (!this.resultWon && !this.resultUsedContinue) {\n      const contBtnY = py + 250;\n      if (AdManager.shouldShowAdButton(this.adManager, AD_PLACEMENTS.CONTINUE)) {\n        ctx.fillStyle = '#6BCB77';\n        this._roundRect(ctx, w / 2 - 100, contBtnY, 200, 34, 17);\n        ctx.fill();\n        ctx.fillStyle = '#FFF';\n        ctx.font = 'bold 14px sans-serif';\n        ctx.fillText('🎬 看视频+5步继续', w / 2, contBtnY + 22);\n      } else if (this.coinSystem.canContinue()) {\n        ctx.fillStyle = '#FFB800';\n        this._roundRect(ctx, w / 2 - 80, contBtnY, 160, 30, 15);\n        ctx.fill();\n        ctx.fillStyle = '#FFF';\n        ctx.font = 'bold 12px sans-serif';\n        ctx.fillText('10🪙 购买+5步', w / 2, contBtnY + 20);\n      }\n    }\n\n    // Buttons\n    const btnW = 120, btnH = 42;\n    const btnY = py + ph - 65;\n\n    if (this.resultWon) {\n      // Next level\n      ctx.fillStyle = '#6BCB77';\n      this._roundRect(ctx, w / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText('下一关', w / 2 - btnW / 2 - 10, btnY + 27);\n    } else {\n      // Retry\n      ctx.fillStyle = '#FF9A3C';\n      this._roundRect(ctx, w / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText('重试', w / 2 - btnW / 2 - 10, btnY + 27);\n    }\n\n    // Map button\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, w / 2 + 10, btnY, btnW, btnH, btnH / 2);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.fillText('🗺️ 地图', w / 2 + btnW / 2 + 10, btnY + 27);\n  }\n\n  _handleResultClick(x, y, w, h) {\n    const pw = Math.min(320, w - 40);\n    const ph = this.resultWon ? 380 : 400;\n    const px = (w - pw) / 2;\n    const py = (h - ph) / 2;\n    const btnW = 120, btnH = 42;\n    const btnY = py + ph - 65;\n\n    // Phase 4: Double reward ad button\n    if (this.resultWon && this.resultCoins > 0 && !this.resultDoubled) {\n      if (AdManager.shouldShowAdButton(this.adManager, AD_PLACEMENTS.DOUBLE)) {\n        const dBtnY = py + 235;\n        if (x >= w / 2 - 80 && x <= w / 2 + 80 && y >= dBtnY && y <= dBtnY + 30) {\n          this.adManager.showRewarded(AD_PLACEMENTS.DOUBLE).then((success) => {\n            this.analytics.trackAdShow(AD_PLACEMENTS.DOUBLE, success);\n            if (success) {\n              this.resultDoubled = true;\n              this.dataManager.addCoins(this.resultCoins);\n            }\n          });\n          return { action: 'ad_double' };\n        }\n      }\n    }\n\n    // Phase 4: Continue via ad button\n    if (!this.resultWon && !this.resultUsedContinue) {\n      const contBtnY = py + 250;\n      if (AdManager.shouldShowAdButton(this.adManager, AD_PLACEMENTS.CONTINUE)) {\n        if (x >= w / 2 - 100 && x <= w / 2 + 100 && y >= contBtnY && y <= contBtnY + 34) {\n          this.adManager.showRewarded(AD_PLACEMENTS.CONTINUE).then((success) => {\n            this.analytics.trackAdShow(AD_PLACEMENTS.CONTINUE, success);\n            if (success) {\n              this.resultUsedContinue = true;\n              this.game.scoreSystem.addMoves(5);\n              this.game.state = STATES.IDLE;\n              this.goTo(NAV_SCREENS.GAME);\n            }\n          });\n          return { action: 'ad_continue' };\n        }\n      } else if (this.coinSystem.canContinue()) {\n        if (x >= w / 2 - 80 && x <= w / 2 + 80 && y >= contBtnY && y <= contBtnY + 30) {\n          this.coinSystem.buyContinue();\n          this.resultUsedContinue = true;\n          this.game.scoreSystem.addMoves(5);\n          this.game.state = STATES.IDLE;\n          this.goTo(NAV_SCREENS.GAME);\n          return { action: 'coin_continue' };\n        }\n      }\n    }\n\n    // Next / Retry button\n    if (x >= w / 2 - btnW - 10 && x <= w / 2 - 10 && y >= btnY && y <= btnY + btnH) {\n      if (this.resultWon) {\n        // Phase 4: show interstitial before next level\n        this._tryInterstitial(() => {\n          this.game.nextLevel();\n          this.characterMgr.applySkill(\n            this.dataManager.selectedCharacter,\n            this.game, 'level_start', null,\n          );\n          this.goTo(NAV_SCREENS.GAME);\n        });\n      } else {\n        this.game.retry();\n        this.characterMgr.applySkill(\n          this.dataManager.selectedCharacter,\n          this.game, 'level_start', null,\n        );\n        this.goTo(NAV_SCREENS.GAME);\n      }\n      return { action: this.resultWon ? 'next' : 'retry' };\n    }\n\n    // Map button\n    if (x >= w / 2 + 10 && x <= w / 2 + 10 + btnW && y >= btnY && y <= btnY + btnH) {\n      // Phase 4: show interstitial when going back to map\n      this._tryInterstitial(() => {\n        this.goTo(NAV_SCREENS.MAP);\n      });\n      return { action: 'map' };\n    }\n    return null;\n  }\n\n  // Phase 4: Interstitial helper\n  _tryInterstitial(callback) {\n    if (this.adManager.canShowInterstitial(this.resultLevel)) {\n      this.adManager.showInterstitial(this.resultLevel).then(() => {\n        this.analytics.trackAdShow(AD_PLACEMENTS.INTERSTITIAL, true);\n        callback();\n      });\n    } else {\n      callback();\n    }\n  }\n\n  // --- DAILY ---\n  _handleDailyClick(x, y, w, h) {\n    const result = this.game.dailySystem.handleClick(x, y, w, h);\n    if (!result) return null;\n    if (result.action === 'back') {\n      this.goTo(NAV_SCREENS.MAP);\n    } else if (result.action === 'play_challenge') {\n      this._startLevel(result.level);\n    }\n    return result;\n  }\n\n  // --- SOCIAL ---\n  _handleSocialClick(x, y, w, h) {\n    const result = this.game.socialSystem.handleClick(x, y, w, h);\n    if (!result) return null;\n    if (result.action === 'back') {\n      this.goTo(NAV_SCREENS.MAP);\n    } else if (result.action === 'pk') {\n      const pk = this.game.socialSystem.startPK(result.friendId);\n      if (pk) {\n        // Simulate PK result\n        const myScore = Math.floor(Math.random() * 5000) + 1000;\n        const theirScore = Math.floor(Math.random() * 5000) + 1000;\n        const pkResult = this.game.socialSystem.resolvePK(result.friendId, myScore, theirScore);\n        return { action: 'pk_result', ...pkResult, myScore, theirScore };\n      }\n    }\n    return result;\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Navigation, NAV_SCREENS };\n","numLines":657,"startLine":1,"totalLines":657}}}
