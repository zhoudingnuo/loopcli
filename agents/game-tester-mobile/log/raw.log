{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_62489b03027949e480187e0c","type":"tool_result","content":"1\t// AdManager.js — 穿山甲SDK广告管理，支持真实SDK + stub降级\n2\t// 广告位ID配置在 ad-config.js 中，提审前替换为真实ID\n3\t\n4\tconst AD_PLACEMENTS = {\n5\t  CONTINUE: 'continue',       // 续步激励视频（关卡失败）\n6\t  BOOST: 'boost',             // 开局增益激励视频\n7\t  DOUBLE: 'double',           // 双倍结算激励视频\n8\t  INTERSTITIAL: 'interstitial', // 插屏广告\n9\t  TREASURE: 'treasure',       // 宝箱加速激励视频\n10\t  DAILY_DOUBLE: 'daily_double', // 每日签到翻倍\n11\t};\n12\t\n13\tconst AD_LIMITS = {\n14\t  REWARDED_DAILY: 12,\n15\t  INTERSTITIAL_DAILY: 6,\n16\t  COOLDOWN_MS: 60000,\n17\t  NEW_USER_FREE_LEVELS: 3,\n18\t  INTERSTITIAL_LEVEL_INTERVAL: 3,\n19\t};\n20\t\n21\tclass AdManager {\n22\t  constructor(dataManager) {\n23\t    this.dm = dataManager;\n24\t    this._initStorage();\n25\t\n26\t    // SDK detection — use config if available, otherwise auto-detect\n27\t    const config = (typeof AD_CONFIG !== 'undefined') ? AD_CONFIG : null;\n28\t    this.isDouyin = config ? !config.devMode\n29\t      : (typeof tt !== 'undefined' && typeof tt.createRewardedVideoAd === 'function');\n30\t    this.rewardedAd = null;\n31\t    this.interstitialAd = null;\n32\t    this._loadRetry = 0;\n33\t    this._maxRetry = config ? config.loadRetryCount : 2;\n34\t    this._loadTimeout = config ? config.loadTimeout : 10000;\n35\t\n36\t    if (this.isDouyin) this._initSDK();\n37\t\n38\t    // State\n39\t    this._pendingResolve = null;\n40\t    this._currentPlacement = null;\n41\t    this._showingUI = false;\n42\t  }\n43\t\n44\t  _initStorage() {\n45\t    if (!this.dm.data.adState) {\n46\t      this.dm.data.adState = {\n47\t        dailyRewarded: 0,\n48\t        dailyInterstitial: 0,\n49\t        lastShowTime: {},\n50\t        lastInterstitialLevel: 0,\n51\t        date: this._todayStr(),\n52\t        consecutiveFails: 0,\n53\t      };\n54\t      this.dm.save();\n55\t    }\n56\t    this.adState = this.dm.data.adState;\n57\t    this._resetDaily();\n58\t  }\n59\t\n60\t  _todayStr() { return new Date().toISOString().slice(0, 10); }\n61\t\n62\t  _resetDaily() {\n63\t    if (this.adState.date !== this._todayStr()) {\n64\t      this.adState.dailyRewarded = 0;\n65\t      this.adState.dailyInterstitial = 0;\n66\t      this.adState.date = this._todayStr();\n67\t      this.dm.save();\n68\t    }\n69\t  }\n70\t\n71\t  _getAdUnitId(type) {\n72\t    const config = (typeof AD_CONFIG !== 'undefined') ? AD_CONFIG : null;\n73\t    if (config && config.adUnitIds && config.adUnitIds[type]) {\n74\t      return config.adUnitIds[type];\n75\t    }\n76\t    return `adunit-placeholder-${type}`;\n77\t  }\n78\t\n79\t  _initSDK() {\n80\t    try {\n81\t      const rewardedId = this._getAdUnitId('rewarded');\n82\t      this.rewardedAd = tt.createRewardedVideoAd({ adUnitId: rewardedId });\n83\t\n84\t      this.rewardedAd.onLoad(() => {\n85\t        this._loadRetry = 0;\n86\t      });\n87\t\n88\t      this.rewardedAd.onError((err) => {\n89\t        console.warn('[AdManager] Rewarded ad error:', err);\n90\t        if (this._loadRetry < this._maxRetry) {\n91\t          this._loadRetry++;\n92\t          setTimeout(() => this.rewardedAd.load(), 1000 * this._loadRetry);\n93\t        }\n94\t      });\n95\t\n96\t      this.rewardedAd.onClose((res) => {\n97\t        if (this._pendingResolve) {\n98\t          this._pendingResolve(res && res.isEnded);\n99\t          this._pendingResolve = null;\n100\t        }\n101\t      });\n102\t\n103\t      // Pre-load rewarded ad\n104\t      this.rewardedAd.load();\n105\t\n106\t      const interstitialId = this._getAdUnitId('interstitial');\n107\t      this.interstitialAd = tt.createInterstitialAd({ adUnitId: interstitialId });\n108\t\n109\t      this.interstitialAd.onLoad(() => {});\n110\t\n111\t      this.interstitialAd.onError((err) => {\n112\t        console.warn('[AdManager] Interstitial ad error:', err);\n113\t      });\n114\t    } catch (e) {\n115\t      console.warn('[AdManager] SDK init failed, falling back to stub:', e);\n116\t      this.isDouyin = false;\n117\t    }\n118\t  }\n119\t\n120\t  // --- Frequency checks ---\n121\t  isNewUser() {\n122\t    return this.dm.unlockedLevel <= AD_LIMITS.NEW_USER_FREE_LEVELS;\n123\t  }\n124\t\n125\t  canShowRewarded(placement) {\n126\t    this._resetDaily();\n127\t    if (this.isNewUser()) return false;\n128\t    if (this.adState.dailyRewarded >= AD_LIMITS.REWARDED_DAILY) return false;\n129\t    if (this._inCooldown(placement)) return false;\n130\t    return true;\n131\t  }\n132\t\n133\t  canShowInterstitial(currentLevel) {\n134\t    this._resetDaily();\n135\t    if (this.isNewUser()) return false;\n136\t    if (this.adState.dailyInterstitial >= AD_LIMITS.INTERSTITIAL_DAILY) return false;\n137\t    if (this.adState.consecutiveFails >= 2) return false;\n138\t    const lastLevel = this.adState.lastInterstitialLevel || 0;\n139\t    if (currentLevel - lastLevel < AD_LIMITS.INTERSTITIAL_LEVEL_INTERVAL) return false;\n140\t    if (this._inCooldown(AD_PLACEMENTS.INTERSTITIAL)) return false;\n141\t    return true;\n142\t  }\n143\t\n144\t  _inCooldown(placement) {\n145\t    const last = this.adState.lastShowTime[placement] || 0;\n146\t    return Date.now() - last < AD_LIMITS.COOLDOWN_MS;\n147\t  }\n148\t\n149\t  // --- Show rewarded video ---\n150\t  showRewarded(placement) {\n151\t    if (!this.canShowRewarded(placement)) return Promise.resolve(false);\n152\t\n153\t    this._currentPlacement = placement;\n154\t\n155\t    if (this.isDouyin && this.rewardedAd) {\n156\t      return new Promise((resolve) => {\n157\t        this._pendingResolve = resolve;\n158\t        this.rewardedAd.show().catch(() => {\n159\t          this.rewardedAd.load().then(() => {\n160\t            this.rewardedAd.show().catch(() => resolve(false));\n161\t          }).catch(() => resolve(false));\n162\t        });\n163\t      }).then((success) => {\n164\t        if (success) this._onAdComplete(placement);\n165\t        return success;\n166\t      });\n167\t    }\n168\t\n169\t    // Stub mode: simulate ad with a UI overlay\n170\t    return this._showStubAd(placement);\n171\t  }\n172\t\n173\t  // --- Show interstitial ---\n174\t  showInterstitial(currentLevel) {\n175\t    if (!this.canShowInterstitial(currentLevel)) return Promise.resolve(false);\n176\t\n177\t    if (this.isDouyin && this.interstitialAd) {\n178\t      return new Promise((resolve) => {\n179\t        this.interstitialAd.show().then(() => {\n180\t          this.adState.dailyInterstitial++;\n181\t          this.adState.lastInterstitialLevel = currentLevel;\n182\t          this.adState.lastShowTime[AD_PLACEMENTS.INTERSTITIAL] = Date.now();\n183\t          this.dm.save();\n184\t          setTimeout(() => resolve(true), 5000);\n185\t        }).catch(() => resolve(false));\n186\t      });\n187\t    }\n188\t\n189\t    // Stub: simulate 2s interstitial\n190\t    return new Promise((resolve) => {\n191\t      this._showingUI = true;\n192\t      this._stubInterstitial = true;\n193\t      this._stubTimer = 2;\n194\t      this.adState.dailyInterstitial++;\n195\t      this.adState.lastInterstitialLevel = currentLevel;\n196\t      this.adState.lastShowTime[AD_PLACEMENTS.INTERSTITIAL] = Date.now();\n197\t      this.dm.save();\n198\t      setTimeout(() => {\n199\t        this._showingUI = false;\n200\t        this._stubInterstitial = false;\n201\t        resolve(true);\n202\t      }, 2000);\n203\t    });\n204\t  }\n205\t\n206\t  _onAdComplete(placement) {\n207\t    this.adState.dailyRewarded++;\n208\t    this.adState.lastShowTime[placement] = Date.now();\n209\t    this.dm.save();\n210\t  }\n211\t\n212\t  // --- Stub ad simulation ---\n213\t  _showStubAd(placement) {\n214\t    return new Promise((resolve) => {\n215\t      this._showingUI = true;\n216\t      this._stubPlacement = placement;\n217\t      this._stubTimer = 3; // 3 second simulated ad\n218\t      this._stubResolve = resolve;\n219\t    });\n220\t  }\n221\t\n222\t  _completeStubAd(watched) {\n223\t    this._showingUI = false;\n224\t    if (watched) this._onAdComplete(this._stubPlacement);\n225\t    if (this._stubResolve) {\n226\t      this._stubResolve(watched);\n227\t      this._stubResolve = null;\n228\t    }\n229\t  }\n230\t\n231\t  // --- Fail tracking for interstitial suppression ---\n232\t  reportFail() {\n233\t    this.adState.consecutiveFails++;\n234\t    this.dm.save();\n235\t  }\n236\t\n237\t  reportSuccess() {\n238\t    this.adState.consecutiveFails = 0;\n239\t    this.dm.save();\n240\t  }\n241\t\n242\t  // --- Rendering (stub ad UI) ---\n243\t  update(dt) {\n244\t    if (this._stubTimer > 0) {\n245\t      this._stubTimer -= dt;\n246\t    }\n247\t  }\n248\t\n249\t  renderStubAd(ctx, w, h) {\n250\t    if (!this._showingUI) return false;\n251\t\n252\t    if (this._stubInterstitial) {\n253\t      // Interstitial overlay\n254\t      ctx.fillStyle = 'rgba(0,0,0,0.85)';\n255\t      ctx.fillRect(0, 0, w, h);\n256\t\n257\t      ctx.fillStyle = '#FFF';\n258\t      ctx.font = 'bold 20px sans-serif';\n259\t      ctx.textAlign = 'center';\n260\t      ctx.fillText('📢 广告', w / 2, h / 2 - 30);\n261\t\n262\t      ctx.font = '14px sans-serif';\n263\t      ctx.fillStyle = '#CCC';\n264\t      ctx.fillText('插屏广告模拟', w / 2, h / 2);\n265\t\n266\t      const remaining = Math.ceil(this._stubTimer);\n267\t      ctx.font = 'bold 24px sans-serif';\n268\t      ctx.fillStyle = '#FFB800';\n269\t      ctx.fillText(`${remaining}s`, w / 2, h / 2 + 40);\n270\t      return true;\n271\t    }\n272\t\n273\t    // Rewarded video stub\n274\t    ctx.fillStyle = 'rgba(0,0,0,0.9)';\n275\t    ctx.fillRect(0, 0, w, h);\n276\t\n277\t    // Fake ad content\n278\t    ctx.fillStyle = '#FFB800';\n279\t    ctx.font = 'bold 18px sans-serif';\n280\t    ctx.textAlign = 'center';\n281\t    ctx.fillText('🎬 激励视频广告', w / 2, h / 2 - 60);\n282\t\n283\t    ctx.fillStyle = '#FFF';\n284\t    ctx.font = '14px sans-serif';\n285\t    ctx.fillText(`广告位: ${this._stubPlacement}`, w / 2, h / 2 - 30);\n286\t    ctx.fillText('（开发模式模拟广告）', w / 2, h / 2);\n287\t\n288\t    // Countdown\n289\t    const remaining = Math.ceil(this._stubTimer);\n290\t    if (remaining > 0) {\n291\t      ctx.font = 'bold 32px sans-serif';\n292\t      ctx.fillStyle = '#FFB800';\n293\t      ctx.fillText(`${remaining}s`, w / 2, h / 2 + 50);\n294\t    }\n295\t\n296\t    // Close/complete button (appears after timer)\n297\t    if (remaining <= 0) {\n298\t      const btnW = 160, btnH = 44;\n299\t      const btnX = (w - btnW) / 2, btnY = h / 2 + 70;\n300\t      ctx.fillStyle = '#6BCB77';\n301\t      this._roundRect(ctx, btnX, btnY, btnW, btnH, btnH / 2);\n302\t      ctx.fill();\n303\t      ctx.fillStyle = '#FFF';\n304\t      ctx.font = 'bold 16px sans-serif';\n305\t      ctx.fillText('✓ 观看完成', w / 2, btnY + 28);\n306\t\n307\t      // Skip button\n308\t      ctx.fillStyle = '#666';\n309\t      ctx.font = '12px sans-serif';\n310\t      ctx.fillText('跳过（无奖励）', w / 2, btnY + btnH + 24);\n311\t    }\n312\t\n313\t    return true;\n314\t  }\n315\t\n316\t  handleStubClick(x, y, w, h) {\n317\t    if (!this._showingUI || this._stubInterstitial) return false;\n318\t    if (this._stubTimer > 0) return true; // consume click during countdown\n319\t\n320\t    const btnW = 160, btnH = 44;\n321\t    const btnX = (w - btnW) / 2, btnY = h / 2 + 70;\n322\t\n323\t    // Complete button\n324\t    if (x >= btnX && x <= btnX + btnW && y >= btnY && y <= btnY + btnH) {\n325\t      this._completeStubAd(true);\n326\t      return true;\n327\t    }\n328\t\n329\t    // Skip area\n330\t    if (y >= btnY + btnH && y <= btnY + btnH + 40) {\n331\t      this._completeStubAd(false);\n332\t      return true;\n333\t    }\n334\t\n335\t    return true; // consume all clicks while ad showing\n336\t  }\n337\t\n338\t  // --- Ad button helper for UI ---\n339\t  static shouldShowAdButton(adManager, placement) {\n340\t    return adManager && adManager.canShowRewarded(placement);\n341\t  }\n342\t\n343\t  _roundRect(ctx, x, y, w, h, r) {\n344\t    ctx.beginPath();\n345\t    ctx.moveTo(x + r, y);\n346\t    ctx.lineTo(x + w - r, y);\n347\t    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n348\t    ctx.lineTo(x + w, y + h - r);\n349\t    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n350\t    ctx.lineTo(x + r, y + h);\n351\t    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n352\t    ctx.lineTo(x, y + r);\n353\t    ctx.quadraticCurveTo(x, y, x + r, y);\n354\t    ctx.closePath();\n355\t  }\n356\t}\n357\t\n358\tif (typeof module !== 'undefined') module.exports = { AdManager, AD_PLACEMENTS, AD_LIMITS };\n359\t"}]},"parent_tool_use_id":null,"session_id":"33562fd9-d4f0-45be-a2a4-d9d379182d9f","uuid":"f6881015-ab72-4b7a-ac6c-e842f8150486","timestamp":"2026-05-23T10:17:37.313Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-match3/src/js/AdManager.js","content":"// AdManager.js — 穿山甲SDK广告管理，支持真实SDK + stub降级\n// 广告位ID配置在 ad-config.js 中，提审前替换为真实ID\n\nconst AD_PLACEMENTS = {\n  CONTINUE: 'continue',       // 续步激励视频（关卡失败）\n  BOOST: 'boost',             // 开局增益激励视频\n  DOUBLE: 'double',           // 双倍结算激励视频\n  INTERSTITIAL: 'interstitial', // 插屏广告\n  TREASURE: 'treasure',       // 宝箱加速激励视频\n  DAILY_DOUBLE: 'daily_double', // 每日签到翻倍\n};\n\nconst AD_LIMITS = {\n  REWARDED_DAILY: 12,\n  INTERSTITIAL_DAILY: 6,\n  COOLDOWN_MS: 60000,\n  NEW_USER_FREE_LEVELS: 3,\n  INTERSTITIAL_LEVEL_INTERVAL: 3,\n};\n\nclass AdManager {\n  constructor(dataManager) {\n    this.dm = dataManager;\n    this._initStorage();\n\n    // SDK detection — use config if available, otherwise auto-detect\n    const config = (typeof AD_CONFIG !== 'undefined') ? AD_CONFIG : null;\n    this.isDouyin = config ? !config.devMode\n      : (typeof tt !== 'undefined' && typeof tt.createRewardedVideoAd === 'function');\n    this.rewardedAd = null;\n    this.interstitialAd = null;\n    this._loadRetry = 0;\n    this._maxRetry = config ? config.loadRetryCount : 2;\n    this._loadTimeout = config ? config.loadTimeout : 10000;\n\n    if (this.isDouyin) this._initSDK();\n\n    // State\n    this._pendingResolve = null;\n    this._currentPlacement = null;\n    this._showingUI = false;\n  }\n\n  _initStorage() {\n    if (!this.dm.data.adState) {\n      this.dm.data.adState = {\n        dailyRewarded: 0,\n        dailyInterstitial: 0,\n        lastShowTime: {},\n        lastInterstitialLevel: 0,\n        date: this._todayStr(),\n        consecutiveFails: 0,\n      };\n      this.dm.save();\n    }\n    this.adState = this.dm.data.adState;\n    this._resetDaily();\n  }\n\n  _todayStr() { return new Date().toISOString().slice(0, 10); }\n\n  _resetDaily() {\n    if (this.adState.date !== this._todayStr()) {\n      this.adState.dailyRewarded = 0;\n      this.adState.dailyInterstitial = 0;\n      this.adState.date = this._todayStr();\n      this.dm.save();\n    }\n  }\n\n  _getAdUnitId(type) {\n    const config = (typeof AD_CONFIG !== 'undefined') ? AD_CONFIG : null;\n    if (config && config.adUnitIds && config.adUnitIds[type]) {\n      return config.adUnitIds[type];\n    }\n    return `adunit-placeholder-${type}`;\n  }\n\n  _initSDK() {\n    try {\n      const rewardedId = this._getAdUnitId('rewarded');\n      this.rewardedAd = tt.createRewardedVideoAd({ adUnitId: rewardedId });\n\n      this.rewardedAd.onLoad(() => {\n        this._loadRetry = 0;\n      });\n\n      this.rewardedAd.onError((err) => {\n        console.warn('[AdManager] Rewarded ad error:', err);\n        if (this._loadRetry < this._maxRetry) {\n          this._loadRetry++;\n          setTimeout(() => this.rewardedAd.load(), 1000 * this._loadRetry);\n        }\n      });\n\n      this.rewardedAd.onClose((res) => {\n        if (this._pendingResolve) {\n          this._pendingResolve(res && res.isEnded);\n          this._pendingResolve = null;\n        }\n      });\n\n      // Pre-load rewarded ad\n      this.rewardedAd.load();\n\n      const interstitialId = this._getAdUnitId('interstitial');\n      this.interstitialAd = tt.createInterstitialAd({ adUnitId: interstitialId });\n\n      this.interstitialAd.onLoad(() => {});\n\n      this.interstitialAd.onError((err) => {\n        console.warn('[AdManager] Interstitial ad error:', err);\n      });\n    } catch (e) {\n      console.warn('[AdManager] SDK init failed, falling back to stub:', e);\n      this.isDouyin = false;\n    }\n  }\n\n  // --- Frequency checks ---\n  isNewUser() {\n    return this.dm.unlockedLevel <= AD_LIMITS.NEW_USER_FREE_LEVELS;\n  }\n\n  canShowRewarded(placement) {\n    this._resetDaily();\n    if (this.isNewUser()) return false;\n    if (this.adState.dailyRewarded >= AD_LIMITS.REWARDED_DAILY) return false;\n    if (this._inCooldown(placement)) return false;\n    return true;\n  }\n\n  canShowInterstitial(currentLevel) {\n    this._resetDaily();\n    if (this.isNewUser()) return false;\n    if (this.adState.dailyInterstitial >= AD_LIMITS.INTERSTITIAL_DAILY) return false;\n    if (this.adState.consecutiveFails >= 2) return false;\n    const lastLevel = this.adState.lastInterstitialLevel || 0;\n    if (currentLevel - lastLevel < AD_LIMITS.INTERSTITIAL_LEVEL_INTERVAL) return false;\n    if (this._inCooldown(AD_PLACEMENTS.INTERSTITIAL)) return false;\n    return true;\n  }\n\n  _inCooldown(placement) {\n    const last = this.adState.lastShowTime[placement] || 0;\n    return Date.now() - last < AD_LIMITS.COOLDOWN_MS;\n  }\n\n  // --- Show rewarded video ---\n  showRewarded(placement) {\n    if (!this.canShowRewarded(placement)) return Promise.resolve(false);\n\n    this._currentPlacement = placement;\n\n    if (this.isDouyin && this.rewardedAd) {\n      return new Promise((resolve) => {\n        this._pendingResolve = resolve;\n        this.rewardedAd.show().catch(() => {\n          this.rewardedAd.load().then(() => {\n            this.rewardedAd.show().catch(() => resolve(false));\n          }).catch(() => resolve(false));\n        });\n      }).then((success) => {\n        if (success) this._onAdComplete(placement);\n        return success;\n      });\n    }\n\n    // Stub mode: simulate ad with a UI overlay\n    return this._showStubAd(placement);\n  }\n\n  // --- Show interstitial ---\n  showInterstitial(currentLevel) {\n    if (!this.canShowInterstitial(currentLevel)) return Promise.resolve(false);\n\n    if (this.isDouyin && this.interstitialAd) {\n      return new Promise((resolve) => {\n        this.interstitialAd.show().then(() => {\n          this.adState.dailyInterstitial++;\n          this.adState.lastInterstitialLevel = currentLevel;\n          this.adState.lastShowTime[AD_PLACEMENTS.INTERSTITIAL] = Date.now();\n          this.dm.save();\n          setTimeout(() => resolve(true), 5000);\n        }).catch(() => resolve(false));\n      });\n    }\n\n    // Stub: simulate 2s interstitial\n    return new Promise((resolve) => {\n      this._showingUI = true;\n      this._stubInterstitial = true;\n      this._stubTimer = 2;\n      this.adState.dailyInterstitial++;\n      this.adState.lastInterstitialLevel = currentLevel;\n      this.adState.lastShowTime[AD_PLACEMENTS.INTERSTITIAL] = Date.now();\n      this.dm.save();\n      setTimeout(() => {\n        this._showingUI = false;\n        this._stubInterstitial = false;\n        resolve(true);\n      }, 2000);\n    });\n  }\n\n  _onAdComplete(placement) {\n    this.adState.dailyRewarded++;\n    this.adState.lastShowTime[placement] = Date.now();\n    this.dm.save();\n  }\n\n  // --- Stub ad simulation ---\n  _showStubAd(placement) {\n    return new Promise((resolve) => {\n      this._showingUI = true;\n      this._stubPlacement = placement;\n      this._stubTimer = 3; // 3 second simulated ad\n      this._stubResolve = resolve;\n    });\n  }\n\n  _completeStubAd(watched) {\n    this._showingUI = false;\n    if (watched) this._onAdComplete(this._stubPlacement);\n    if (this._stubResolve) {\n      this._stubResolve(watched);\n      this._stubResolve = null;\n    }\n  }\n\n  // --- Fail tracking for interstitial suppression ---\n  reportFail() {\n    this.adState.consecutiveFails++;\n    this.dm.save();\n  }\n\n  reportSuccess() {\n    this.adState.consecutiveFails = 0;\n    this.dm.save();\n  }\n\n  // --- Rendering (stub ad UI) ---\n  update(dt) {\n    if (this._stubTimer > 0) {\n      this._stubTimer -= dt;\n    }\n  }\n\n  renderStubAd(ctx, w, h) {\n    if (!this._showingUI) return false;\n\n    if (this._stubInterstitial) {\n      // Interstitial overlay\n      ctx.fillStyle = 'rgba(0,0,0,0.85)';\n      ctx.fillRect(0, 0, w, h);\n\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 20px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText('📢 广告', w / 2, h / 2 - 30);\n\n      ctx.font = '14px sans-serif';\n      ctx.fillStyle = '#CCC';\n      ctx.fillText('插屏广告模拟', w / 2, h / 2);\n\n      const remaining = Math.ceil(this._stubTimer);\n      ctx.font = 'bold 24px sans-serif';\n      ctx.fillStyle = '#FFB800';\n      ctx.fillText(`${remaining}s`, w / 2, h / 2 + 40);\n      return true;\n    }\n\n    // Rewarded video stub\n    ctx.fillStyle = 'rgba(0,0,0,0.9)';\n    ctx.fillRect(0, 0, w, h);\n\n    // Fake ad content\n    ctx.fillStyle = '#FFB800';\n    ctx.font = 'bold 18px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('🎬 激励视频广告', w / 2, h / 2 - 60);\n\n    ctx.fillStyle = '#FFF';\n    ctx.font = '14px sans-serif';\n    ctx.fillText(`广告位: ${this._stubPlacement}`, w / 2, h / 2 - 30);\n    ctx.fillText('（开发模式模拟广告）', w / 2, h / 2);\n\n    // Countdown\n    const remaining = Math.ceil(this._stubTimer);\n    if (remaining > 0) {\n      ctx.font = 'bold 32px sans-serif';\n      ctx.fillStyle = '#FFB800';\n      ctx.fillText(`${remaining}s`, w / 2, h / 2 + 50);\n    }\n\n    // Close/complete button (appears after timer)\n    if (remaining <= 0) {\n      const btnW = 160, btnH = 44;\n      const btnX = (w - btnW) / 2, btnY = h / 2 + 70;\n      ctx.fillStyle = '#6BCB77';\n      this._roundRect(ctx, btnX, btnY, btnW, btnH, btnH / 2);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText('✓ 观看完成', w / 2, btnY + 28);\n\n      // Skip button\n      ctx.fillStyle = '#666';\n      ctx.font = '12px sans-serif';\n      ctx.fillText('跳过（无奖励）', w / 2, btnY + btnH + 24);\n    }\n\n    return true;\n  }\n\n  handleStubClick(x, y, w, h) {\n    if (!this._showingUI || this._stubInterstitial) return false;\n    if (this._stubTimer > 0) return true; // consume click during countdown\n\n    const btnW = 160, btnH = 44;\n    const btnX = (w - btnW) / 2, btnY = h / 2 + 70;\n\n    // Complete button\n    if (x >= btnX && x <= btnX + btnW && y >= btnY && y <= btnY + btnH) {\n      this._completeStubAd(true);\n      return true;\n    }\n\n    // Skip area\n    if (y >= btnY + btnH && y <= btnY + btnH + 40) {\n      this._completeStubAd(false);\n      return true;\n    }\n\n    return true; // consume all clicks while ad showing\n  }\n\n  // --- Ad button helper for UI ---\n  static shouldShowAdButton(adManager, placement) {\n    return adManager && adManager.canShowRewarded(placement);\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { AdManager, AD_PLACEMENTS, AD_LIMITS };\n","numLines":359,"startLine":1,"totalLines":359}}}
