<button class=\"tool-btn\" onclick=\"handleHintRemove()\">✂️ 去干扰 (5🪙)</button>\n        <button class=\"tool-btn\" onclick=\"handleSkip()\">⏭ 跳过 (10🪙)</button>\n      </div>\n\n      <!-- 教学覆盖层 -->\n      <div id=\"tutorial-overlay\" class=\"tutorial-overlay\" style=\"display:none\">\n        <div class=\"tutorial-arrow\"></div>\n        <div id=\"tutorial-text\" class=\"tutorial-text\"></div>\n      </div>\n    </div>\n\n    <!-- 结算界面 -->\n    <div id=\"result-screen\" class=\"screen\">\n      <div class=\"result-card\">\n        <h2 id=\"result-title\" class=\"result-title\">通关!</h2>\n        <div id=\"result-stars\" class=\"result-stars\"></div>\n        <div class=\"result-stats\">\n          <p>正确: <span id=\"result-correct\">0</span> / <span id=\"result-total\">10</span></p>\n          <p>得分: <span id=\"result-score\">0</span></p>\n          <p>最大连击: <span id=\"result-combo\">0</span></p>\n          <p class=\"coins-earned\">🪙 +<span id=\"result-coins\">0</span></p>\n        </div>\n        <div class=\"result-buttons\">\n          <button class=\"btn btn-primary\" onclick=\"game.goToMenu()\">返回地图</button>\n          <button class=\"btn btn-secondary\" id=\"btn-retry\" onclick=\"game.startLevel(game.currentLevel.id)\">重新挑战</button>\n          <button class=\"btn btn-accent\" id=\"btn-next\" onclick=\"game.startLevel(game.currentLevel.id + 1)\">下一关</button>\n          <button class=\"btn btn-ad\" id=\"btn-double\" style=\"display:none\" onclick=\"handleDoubleReward()\">🎬 看视频领取 ×2</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- 续命弹窗 -->\n    <div id=\"continue-modal\" class=\"modal\" style=\"display:none\">\n      <div class=\"modal-content\">\n        <h3>挑战失败</h3>\n        <p>生命值耗尽了！</p>\n        <div class=\"modal-buttons\">\n          <button class=\"btn btn-secondary\" onclick=\"game.finishLevel(); document.getElementById('continue-modal').style.display='none'\">放弃</button>\n          <button class=\"btn btn-ad\" onclick=\"game.continueWithAd()\">🎬 看视频续命 ❤️×3</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- ===== W2: 限时挑战 ===== -->\n    <div id=\"timed-screen\" class=\"screen\">\n      <div class=\"game-header\">\n        <button class=\"btn-back\" onclick=\"if(confirm('确定退出？')){game.timed.end();game.goToMenu()}\">✕</button>\n        <div class=\"header-center\">\n          <span id=\"timed-timer\" class=\"timer-display\">60s</span>\n        </div>\n        <div class=\"header-right\">\n          <span>得分: <span id=\"timed-score\">0</span></span>\n        </div>\n      </div>\n      <div class=\"game-body\">\n        <div id=\"timed-combo\" class=\"combo-display\"></div>\n        <div class=\"meaning-box\"><span id=\"timed-meaning\"></span></div>\n        <div id=\"timed-slots\" class=\"slots-container\"></div>\n        <div id=\"timed-candidates\" class=\"candidates-container\"></div>\n      </div>\n      <div class=\"game-footer\">\n        <button class=\"tool-btn\" onclick=\"game.timed.useHintReveal()\">📖 揭示</button>\n        <button class=\"tool-btn\" onclick=\"game.timed.useHintRemove()\">✂️ 去干扰</button>\n      </div>\n    </div>\n\n    <!-- W2: 限时挑战结算 -->\n    <div id=\"timed-result-screen\" class=\"screen\">\n      <div class=\"result-card\">\n        <h2 class=\"result-title\">⏱ 限时挑战结束</h2>\n        <div class=\"result-stats\">\n          <p>得分: <span id=\"tr-score\">0</span></p>\n          <p>正确: <span id=\"tr-correct\">0</span> / <span id=\"tr-total\">0</span></p>\n          <p>最大连击: <span id=\"tr-combo\">0</span></p>\n          <p class=\"coins-earned\">🪙 +<span id=\"tr-coins\">0</span></p>\n        </div>\n        <div class=\"result-buttons\">\n          <button class=\"btn btn-primary\" onclick=\"game.goToMenu()\">返回</button>\n          <button class=\"btn btn-accent\" onclick=\"game.startTimedChallenge()\">再来一次</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- ===== W2: 成语图鉴 ===== -->\n    <div id=\"collection-screen\" class=\"screen\">\n      <div class=\"map-header\">\n        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n        <h2>成语图鉴</h2>\n        <span id=\"col-progress\">0/0</span>\n      </div>\n      <div class=\"col-bar-wrap\">\n        <div class=\"col-bar\"><div id=\"col-progress-bar\" class=\"col-bar-fill\"></div></div>\n      </div>\n      <input type=\"text\" id=\"col-search\" class=\"col-search\" placeholder=\"搜索成语/释义...\" autocomplete=\"off\" autocapitalize=\"none\" enterkeyhint=\"search\" oninput=\"handleColSearch(this.value)\">\n      <div id=\"col-categories\" class=\"col-categories\"></div>\n      <div id=\"col-grid\" class=\"col-grid\"></div>\n      <div id=\"col-detail\" class=\"col-detail\" style=\"display:none\"></div>\n    </div>\n\n    <!-- ===== W2: 每日系统 ===== -->\n    <div id=\"daily-screen\" class=\"screen\">\n      <div class=\"map-header\">\n        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n        <h2>📅 每日</h2>\n      </div>\n      <div class=\"daily-content\">\n        <div class=\"daily-login\">\n          <h3>每日签到</h3>\n          <p>连续签到: <span id=\"daily-streak\" class=\"streak-num\">1</span> 天</p>\n          <p>状态: <span id=\"daily-claimed\">未领取</span></p>\n          <button id=\"daily-claim-btn\" class=\"btn btn-accent\" onclick=\"game.daily.claimLogin(); game.render()\">领取签到奖励</button>\n          <button id=\"daily-double-btn\" class=\"btn btn-ad\" style=\"display:none\" onclick=\"handleDailyDouble()\">🎬 看视频翻倍</button>\n        </div>\n\n        <div class=\"daily-section\">\n          <h3>每日任务</h3>\n          <div id=\"daily-tasks\" class=\"task-list\"></div>\n        </div>\n\n        <div class=\"daily-section\">\n          <h3>今日挑战</h3>\n          <div id=\"daily-challenge\"></div>\n        </div>\n      </div>\n    </div>\n\n    <!-- ===== W2: 好友PK ===== -->\n    <div id=\"pk-screen\" class=\"screen\">\n      <div class=\"game-header\">\n        <button class=\"btn-back\" onclick=\"game.goToMenu()\">✕</button>\n        <div class=\"header-center\">\n          <span>好友PK</span>\n          <span id=\"pk-progress\">1/5</span>\n        </div>\n        <div class=\"header-right\"></div>\n      </div>\n      <div class=\"game-body\">\n        <div class=\"meaning-box\"><span id=\"pk-meaning\"></span></div>\n        <div id=\"pk-slots\" class=\"slots-container\"></div>\n        <div id=\"pk-candidates\" class=\"candidates-container\"></div>\n      </div>\n    </div>\n\n    <!-- W2: PK结果 -->\n    <div id=\"pk-result-screen\" class=\"screen\">\n      <div class=\"result-card\">\n        <h2 id=\"pkr-result\" class=\"result-title\">结果</h2>\n        <div class=\"result-stats\">\n          <p>正确: <span id=\"pkr-correct\">0/5</span></p>\n          <p>用时: <span id=\"pkr-time\">0s</span></p>\n          <p class=\"coins-earned\"><span id=\"pkr-reward\"></span></p>\n        </div>\n        <div id=\"pkr-answers\" class=\"pk-answers\"></div>\n        <div class=\"result-buttons\">\n          <button class=\"btn btn-primary\" onclick=\"game.goToMenu()\">返回</button>\n          <button class=\"btn btn-secondary\" onclick=\"game.social.sharePKResult(game.pk.getResult())\">分享结果</button>\n          <button class=\"btn btn-accent\" onclick=\"game.startPK()\">再来一局</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- ===== W2: 角色 ===== -->\n    <div id=\"characters-screen\" class=\"screen\">\n      <div class=\"map-header\">\n        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n        <h2>👤 角色选择</h2>\n      </div>\n      <div id=\"char-grid\" class=\"char-grid\"></div>\n      <div id=\"char-detail\" class=\"char-detail\"></div>\n    </div>\n  </div>\n\n  <script src=\"src/js/IdiomDBExtra.js\"></script>\n  <script src=\"src/js/IdiomDB.js\"></script>\n  <script src=\"src/js/levels.js\"></script>\n  <script src=\"src/js/IdiomEngine.js\"></script>\n  <script src=\"src/js/Judge.js\"></script>\n  <script src=\"src/js/ComboSystem.js\"></script>\n  <script src=\"src/js/DataManager.js\