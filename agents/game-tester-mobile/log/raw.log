{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_85e71f2097184b408a69600b","type":"tool_result","content":"1\t// Renderer.js — UI rendering (W2 extended)\n2\t\n3\tfunction renderUI(game) {\n4\t  const screens = ['menu-screen','map-screen','game-screen','result-screen',\n5\t    'timed-screen','timed-result-screen','collection-screen','daily-screen',\n6\t    'pk-screen','pk-result-screen','characters-screen'];\n7\t  screens.forEach(id => {\n8\t    const el = document.getElementById(id);\n9\t    if (el) el.classList.remove('active');\n10\t  });\n11\t\n12\t  switch (game.state) {\n13\t    case 'menu': renderMenu(game); break;\n14\t    case 'map': renderMap(game); break;\n15\t    case 'playing': renderGame(game); break;\n16\t    case 'result': renderResult(game); break;\n17\t    case 'timed': renderTimed(game); break;\n18\t    case 'timed_result': renderTimedResult(game); break;\n19\t    case 'collection': renderCollection(game); break;\n20\t    case 'daily': renderDaily(game); break;\n21\t    case 'pk': renderPK(game); break;\n22\t    case 'pk_result': renderPKResult(game); break;\n23\t    case 'characters': renderCharacters(game); break;\n24\t  }\n25\t}\n26\t\n27\tfunction showScreen(id) {\n28\t  const el = document.getElementById(id);\n29\t  if (el) el.classList.add('active');\n30\t}\n31\t\n32\tfunction renderMenu(game) {\n33\t  showScreen('menu-screen');\n34\t  const mc = document.getElementById('menu-coins');\n35\t  const mcl = document.getElementById('menu-collected');\n36\t  if (mc) mc.textContent = game.data.coins;\n37\t  if (mcl) mcl.textContent = game.data.collectedCount;\n38\t\n39\t  const charAvatar = document.getElementById('menu-avatar');\n40\t  if (charAvatar) {\n41\t    const ch = game.characters.getCurrent();\n42\t    charAvatar.textContent = ch.avatar;\n43\t  }\n44\t}\n45\t\n46\tfunction renderMap(game) {\n47\t  showScreen('map-screen');\n48\t  const mc = document.getElementById('map-coins');\n49\t  if (mc) mc.textContent = game.data.coins;\n50\t\n51\t  const grid = document.getElementById('level-grid');\n52\t  if (!grid) return;\n53\t  grid.innerHTML = '';\n54\t\n55\t  const chapters = {};\n56\t  LEVELS.forEach(l => {\n57\t    if (!chapters[l.chapter]) chapters[l.chapter] = [];\n58\t    chapters[l.chapter].push(l);\n59\t  });\n60\t\n61\t  const chapInfo = document.getElementById('chapter-info');\n62\t  if (chapInfo) {\n63\t    chapInfo.innerHTML = CHAPTERS.map(c =>\n64\t      `<div class=\"chapter-badge\" style=\"background:${c.color};${c.id>=4?'color:#fff':''}\">${c.name} · ${c.subtitle}</div>`\n65\t    ).join('');\n66\t  }\n67\t\n68\t  Object.keys(chapters).forEach(chId => {\n69\t    const section = document.createElement('div');\n70\t    section.className = 'chapter-section';\n71\t    const chap = CHAPTERS.find(c => c.id === parseInt(chId));\n72\t    if (chap) section.style.borderColor = chap.color;\n73\t\n74\t    chapters[chId].forEach(level => {\n75\t      const btn = document.createElement('button');\n76\t      const stars = game.data.getLevelStars(level.id);\n77\t      const unlocked = level.id <= game.data.unlockedLevel;\n78\t      const isBoss = level.boss;\n79\t\n80\t      btn.className = 'level-btn' + (isBoss ? ' boss' : '') + (!unlocked ? ' locked' : '') + (stars > 0 ? ' completed' : '');\n81\t      btn.innerHTML = `\n82\t        <span class=\"level-num\">${level.id}</span>\n83\t        <span class=\"level-stars\">${'★'.repeat(stars)}${'☆'.repeat(3 - stars)}</span>\n84\t        <span class=\"level-name\">${level.name}</span>\n85\t      `;\n86\t\n87\t      if (unlocked) btn.onclick = () => game.startLevel(level.id);\n88\t      section.appendChild(btn);\n89\t    });\n90\t    grid.appendChild(section);\n91\t  });\n92\t}\n93\t\n94\tfunction renderGame(game) {\n95\t  showScreen('game-screen');\n96\t  const q = game.getCurrentQuestion();\n97\t  if (!q) return;\n98\t\n99\t  const ll = document.getElementById('level-label');\n100\t  const pl = document.getElementById('progress-label');\n101\t  const ld = document.getElementById('lives-display');\n102\t  if (ll) ll.textContent = `第${game.currentLevel.id}关`;\n103\t  if (pl) pl.textContent = `${game.questionIndex + 1}/${game.questions.length}`;\n104\t  if (ld) ld.textContent = '❤️'.repeat(Math.max(0, game.lives));\n105\t\n106\t  const mt = document.getElementById('meaning-text');\n107\t  if (mt) mt.textContent = q.idiom.meaning;\n108\t\n109\t  const cd = document.getElementById('combo-display');\n110\t  if (cd) {\n111\t    if (game.combo.combo >= 3) {\n112\t      cd.textContent = `🔥 ${game.combo.combo}连击！${game.combo.getComboMessage()}`;\n113\t      cd.style.display = 'block';\n114\t      cd.className = 'combo-display combo-' + Math.min(game.combo.combo, 10);\n115\t    } else {\n116\t      cd.style.display = 'none';\n117\t    }\n118\t  }\n119\t\n120\t  const sc = document.getElementById('slots-container');\n121\t  if (sc) {\n122\t    sc.innerHTML = '';\n123\t    const slots = game.judge.getSlots();\n124\t    for (let i = 0; i < 4; i++) {\n125\t      const slot = document.createElement('div');\n126\t      slot.className = 'slot';\n127\t      if (slots[i]) {\n128\t        slot.classList.add('filled');\n129\t        slot.textContent = slots[i].char;\n130\t        slot.onclick = () => { game.removeSlot(i); };\n131\t      }\n132\t      if (q.answered && q.correct === true) slot.classList.add('correct');\n133\t      if (q.answered && q.correct === false) slot.classList.add('wrong');\n134\t      sc.appendChild(slot);\n135\t    }\n136\t  }\n137\t\n138\t  const ih = document.getElementById('idiom-hint');\n139\t  if (ih) {\n140\t    if (q.answered && q.correct) {\n141\t      ih.innerHTML = `<strong>${q.idiom.idiom}</strong>：${q.idiom.meaning}`;\n142\t      ih.style.display = 'block';\n143\t    } else {\n144\t      ih.style.display = 'none';\n145\t    }\n146\t  }\n147\t\n148\t  const cc = document.getElementById('candidates-container');\n149\t  if (cc) {\n150\t    cc.innerHTML = '';\n151\t    q.candidates.forEach((c, i) => {\n152\t      const btn = document.createElement('button');\n153\t      btn.className = 'candidate';\n154\t      btn.textContent = c.char;\n155\t      if (c.used) btn.classList.add('used');\n156\t      if (c.removed) btn.classList.add('removed');\n157\t      if (!c.used && !c.removed && !q.answered) btn.onclick = () => game.pickChar(i);\n158\t      cc.appendChild(btn);\n159\t    });\n160\t  }\n161\t\n162\t  const to = document.getElementById('tutorial-overlay');\n163\t  const tt = document.getElementById('tutorial-text');\n164\t  if (to && tt) {\n165\t    const step = game.tutorial.getCurrentStep();\n166\t    if (step) { tt.textContent = step.msg; to.style.display = 'flex'; }\n167\t    else { to.style.display = 'none'; }\n168\t  }\n169\t\n170\t  // Update tool button costs\n171\t  const hintBtns = document.querySelectorAll('.tool-btn');\n172\t  if (hintBtns.length >= 3) {\n173\t    hintBtns[0].textContent = `📖 揭示 (${game.hintRevealCost}🪙)`;\n174\t    hintBtns[1].textContent = `✂️ 去干扰 (${game.hintRemoveCost}🪙)`;\n175\t    hintBtns[2].textContent = `⏭ 跳过 (${game.skipCost}🪙)`;\n176\t  }\n177\t}\n178\t\n179\tfunction renderResult(game) {\n180\t  showScreen('result-screen');\n181\t  const r = game.levelResult;\n182\t  if (!r) return;\n183\t\n184\t  const rt = document.getElementById('result-title');\n185\t  if (rt) rt.textContent = r.stars > 0 ? '🎉 通关!' : '😞 失败';\n186\t\n187\t  const rs = document.getElementById('result-stars');\n188\t  if (rs) rs.innerHTML = '★'.repeat(r.stars) + '☆'.repeat(3 - r.stars);\n189\t\n190\t  document.getElementById('result-correct').textContent = r.correctCount;\n191\t  document.getElementById('result-total').textContent = r.totalQuestions;\n192\t  document.getElementById('result-score').textContent = r.score;\n193\t  document.getElementById('result-combo').textContent = r.maxCombo;\n194\t  document.getElementById('result-coins').textContent = r.coins;\n195\t\n196\t  const btnNext = document.getElementById('btn-next');\n197\t  if (btnNext) {\n198\t    const nextId = game.currentLevel.id + 1;\n199\t    btnNext.style.display = (r.stars > 0 && LEVELS.find(l => l.id === nextId)) ? 'inline-block' : 'none';\n200\t  }\n201\t  const btnRetry = document.getElementById('btn-retry');\n202\t  if (btnRetry) btnRetry.style.display = r.stars > 0 ? 'none' : 'inline-block';\n203\t\n204\t  // W3: Double reward button\n205\t  const btnDouble = document.getElementById('btn-double');\n206\t  if (btnDouble) {\n207\t    const canDouble = r.stars > 0 && !game._doubledReward &&\n208\t      game.adManager && game.adManager.canShowRewarded(AD_PLACEMENTS.DOUBLE_REWARD);\n209\t    btnDouble.style.display = canDouble ? 'inline-block' : 'none';\n210\t  }\n211\t}\n212\t\n213\t// ===== W2: Timed Challenge =====\n214\tfunction renderTimed(game) {\n215\t  showScreen('timed-screen');\n216\t  const tc = game.timed;\n217\t  const q = tc.currentQ;\n218\t  if (!q) return;\n219\t\n220\t  const timer = document.getElementById('timed-timer');\n221\t  if (timer) {\n222\t    timer.textContent = `${tc.timeLeft}s`;\n223\t    timer.className = 'timer-display' + (tc.timeLeft <= 10 ? ' timer-warning' : '');\n224\t  }\n225\t\n226\t  const score = document.getElementById('timed-score');\n227\t  if (score) score.textContent = tc.score;\n228\t\n229\t  const combo = document.getElementById('timed-combo');\n230\t  if (combo) {\n231\t    if (game.combo.combo >= 3) {\n232\t      combo.textContent = `🔥 ${game.combo.combo}连击！`;\n233\t      combo.style.display = 'block';\n234\t    } else {\n235\t      combo.style.display = 'none';\n236\t    }\n237\t  }\n238\t\n239\t  const mt = document.getElementById('timed-meaning');\n240\t  if (mt) mt.textContent = q.idiom.meaning;\n241\t\n242\t  const sc = document.getElementById('timed-slots');\n243\t  if (sc) {\n244\t    sc.innerHTML = '';\n245\t    const slots = tc.judge.getSlots();\n246\t    for (let i = 0; i < 4; i++) {\n247\t      const slot = document.createElement('div');\n248\t      slot.className = 'slot';\n249\t      if (slots[i]) { slot.classList.add('filled'); slot.textContent = slots[i].char; slot.onclick = () => tc.removeSlot(i); }\n250\t      if (q.answered && q.correct === true) slot.classList.add('correct');\n251\t      if (q.answered && q.correct === false) slot.classList.add('wrong');\n252\t      sc.appendChild(slot);\n253\t    }\n254\t  }\n255\t\n256\t  const cc = document.getElementById('timed-candidates');\n257\t  if (cc) {\n258\t    cc.innerHTML = '';\n259\t    q.candidates.forEach((c, i) => {\n260\t      const btn = document.createElement('button');\n261\t      btn.className = 'candidate';\n262\t      btn.textContent = c.char;\n263\t      if (c.used) btn.classList.add('used');\n264\t      if (c.removed) btn.classList.add('removed');\n265\t      if (!c.used && !c.removed && !q.answered) btn.onclick = () => tc.pickChar(i);\n266\t      cc.appendChild(btn);\n267\t    });\n268\t  }\n269\t}\n270\t\n271\tfunction renderTimedResult(game) {\n272\t  showScreen('timed-result-screen');\n273\t  const r = game.timed.getResult();\n274\t  document.getElementById('tr-score').textContent = r.score;\n275\t  document.getElementById('tr-correct').textContent = r.correctCount;\n276\t  document.getElementById('tr-total').textContent = r.answeredCount;\n277\t  document.getElementById('tr-combo').textContent = r.maxCombo;\n278\t  document.getElementById('tr-coins').textContent = Math.floor(r.score / 10);\n279\t}\n280\t\n281\t// ===== W2: Collection =====\n282\tfunction renderCollection(game) {\n283\t  showScreen('collection-screen');\n284\t  const col = game.collection;\n285\t  const progress = col.getProgress();\n286\t\n287\t  document.getElementById('col-progress').textContent = `${progress.collected}/${progress.total} (${progress.percent}%)`;\n288\t\n289\t  const bar = document.getElementById('col-progress-bar');\n290\t  if (bar) bar.style.width = progress.percent + '%';\n291\t\n292\t  // Categories\n293\t  const catContainer = document.getElementById('col-categories');\n294\t  if (catContainer) {\n295\t    const cats = ['全部', ...col.getCategories()];\n296\t    catContainer.innerHTML = cats.map(c =>\n297\t      `<button class=\"cat-btn${col.selectedCategory === (c === '全部' ? null : c) ? ' active' : ''}\" onclick=\"handleCategoryFilter('${c}')\">${c}</button>`\n298\t    ).join('');\n299\t  }\n300\t\n301\t  // Search\n302\t  const searchInput = document.getElementById('col-search');\n303\t  if (searchInput && searchInput.value !== col.searchQuery) {\n304\t    searchInput.value = col.searchQuery;\n305\t  }\n306\t\n307\t  // Idiom grid\n308\t  const grid = document.getElementById('col-grid');\n309\t  if (grid) {\n310\t    const idioms = col.getFilteredIdioms();\n311\t    grid.innerHTML = idioms.slice(0, 60).map(i =>\n312\t      `<div class=\"idiom-card${i.collected ? ' collected' : ''}\" onclick=\"handleIdiomSelect('${i.id}')\">\n313\t        <span class=\"idiom-text\">${i.collected ? i.idiom : '？？？？'}</span>\n314\t        <span class=\"idiom-cat\">${(i.category || [])[0] || ''}</span>\n315\t      </div>`\n316\t    ).join('');\n317\t    if (idioms.length > 60) {\n318\t      grid.innerHTML += `<div class=\"more-hint\">还有${idioms.length - 60}个...</div>`;\n319\t    }\n320\t  }\n321\t\n322\t  // Detail view\n323\t  const detail = document.getElementById('col-detail');\n324\t  if (detail) {\n325\t    if (col.selectedIdiom) {\n326\t      const i = col.selectedIdiom;\n327\t      const collected = game.data.collectedIdioms.includes(i.id);\n328\t      detail.style.display = 'block';\n329\t      detail.innerHTML = `\n330\t        <div class=\"detail-header\">\n331\t          <h3>${collected ? i.idiom : '？？？？'}</h3>\n332\t          <button class=\"btn-back\" onclick=\"game.collection.selectIdiom(null)\">✕</button>\n333\t        </div>\n334\t        ${collected ? `\n335\t          <p class=\"detail-pinyin\">${i.pinyin || ''}</p>\n336\t          <p class=\"detail-meaning\">${i.meaning}</p>\n337\t          ${i.origin ? `<p class=\"detail-origin\">出处：${i.origin}</p>` : ''}\n338\t          ${i.example ? `<p class=\"detail-example\">例句：${i.example}</p>` : ''}\n339\t        ` : '<p class=\"detail-locked\">收集此成语后可查看详情</p>'}\n340\t      `;\n341\t    } else {\n342\t      detail.style.display = 'none';\n343\t    }\n344\t  }\n345\t}\n346\t\n347\t// ===== W2: Daily =====\n348\tfunction renderDaily(game) {\n349\t  showScreen('daily-screen');\n350\t  const ds = game.daily.getDailyState();\n351\t\n352\t  document.getElementById('daily-streak').textContent = ds.loginStreak;\n353\t  document.getElementById('daily-claimed').textContent = ds.todayClaimed ? '已领取' : '未领取';\n354\t  document.getElementById('daily-claim-btn').disabled = ds.todayClaimed;\n355\t  document.getElementById('daily-claim-btn').textContent = ds.todayClaimed ? '已领取 ✓' : `领取签到奖励 (×${Math.min(ds.loginStreak, 7)}0🪙)`;\n356\t\n357\t  // W3: Daily double ad button\n358\t  const dailyDoubleBtn = document.getElementById('daily-double-btn');\n359\t  if (dailyDoubleBtn) {\n360\t    dailyDoubleBtn.style.display = (ds.todayClaimed && !ds.doubled &&\n361\t      game.adManager && game.adManager.canShowRewarded(AD_PLACEMENTS.DAILY_DOUBLE)) ? 'inline-block' : 'none';\n362\t  }\n363\t\n364\t  // Tasks\n365\t  const tasksEl = document.getElementById('daily-tasks');\n366\t  if (tasksEl) {\n367\t    tasksEl.innerHTML = ds.tasks.map(t => `\n368\t      <div class=\"task-item${t.claimed ? ' done' : ''}\">\n369\t        <span class=\"task-desc\">${t.desc}</span>\n370\t        <span class=\"task-progress\">${t.progress}/${t.target}</span>\n371\t        <button class=\"task-btn${t.claimed ? ' claimed' : ''}\"\n372\t          ${t.claimed || t.progress < t.target ? 'disabled' : ''}\n373\t          onclick=\"handleClaimTask('${t.id}')\">\n374\t          ${t.claimed ? '已领' : `${t.reward}🪙`}\n375\t        </button>\n376\t      </div>\n377\t    `).join('');\n378\t  }\n379\t\n380\t  // Challenge\n381\t  const challengeEl = document.getElementById('daily-challenge');\n382\t  if (challengeEl) {\n383\t    if (ds.challengeIdiom) {\n384\t      challengeEl.innerHTML = `\n385\t        <div class=\"challenge-card${ds.challengeCompleted ? ' done' : ''}\">\n386\t          <h4>今日成语挑战</h4>\n387\t          <p class=\"challenge-meaning\">${ds.challengeIdiom.meaning}</p>\n388\t          <p class=\"challenge-hint\">${ds.challengeCompleted ? `答案：${ds.challengeIdiom.idiom}` : '提示：' + ds.challengeIdiom.chars[0] + '？？？'}</p>\n389\t          ${ds.challengeCompleted ?\n390\t            '<span class=\"challenge-done\">已完成 ✓ +50🪙</span>' :\n391\t            `<button class=\"btn btn-primary btn-sm\" onclick=\"handleDailyChallenge()\">挑战</button>`\n392\t          }\n393\t        </div>\n394\t      `;\n395\t    }\n396\t  }\n397\t}\n398\t\n399\t// ===== W2: PK =====\n400\tfunction renderPK(game) {\n401\t  showScreen('pk-screen');\n402\t  const pk = game.pk;\n403\t  const q = pk.currentQ;\n404\t  if (!q) return;\n405\t\n406\t  document.getElementById('pk-progress').textContent = `${pk.currentIndex + 1}/5`;\n407\t\n408\t  const mt = document.getElementById('pk-meaning');\n409\t  if (mt) mt.textContent = q.idiom.meaning;\n410\t\n411\t  const sc = document.getElementById('pk-slots');\n412\t  if (sc) {\n413\t    sc.innerHTML = '';\n414\t    const slots = pk.judge.getSlots();\n415\t    for (let i = 0; i < 4; i++) {\n416\t      const slot = document.createElement('div');\n417\t      slot.className = 'slot';\n418\t      if (slots[i]) { slot.classList.add('filled'); slot.textContent = slots[i].char; slot.onclick = () => pk.removeSlot(i); }\n419\t      if (q.answered && q.correct === true) slot.classList.add('correct');\n420\t      if (q.answered && q.correct === false) slot.classList.add('wrong');\n421\t      sc.appendChild(slot);\n422\t    }\n423\t  }\n424\t\n425\t  const cc = document.getElementById('pk-candidates');\n426\t  if (cc) {\n427\t    cc.innerHTML = '';\n428\t    q.candidates.forEach((c, i) => {\n429\t      const btn = document.createElement('button');\n430\t      btn.className = 'candidate';\n431\t      btn.textContent = c.char;\n432\t      if (c.used) btn.classList.add('used');\n433\t      if (c.removed) btn.classList.add('removed');\n434\t      if (!c.used && !c.removed && !q.answered) btn.onclick = () => pk.pickChar(i);\n435\t      cc.appendChild(btn);\n436\t    });\n437\t  }\n438\t}\n439\t\n440\tfunction renderPKResult(game) {\n441\t  showScreen('pk-result-screen');\n442\t  const r = game.pk.getResult();\n443\t  document.getElementById('pkr-result').textContent = r.won ? '🎉 胜利！' : '😢 惜败';\n444\t  document.getElementById('pkr-correct').textContent = `${r.correctCount}/5`;\n445\t  document.getElementById('pkr-time').textContent = `${(r.time / 1000).toFixed(1)}s`;\n446\t  document.getElementById('pkr-reward').textContent = r.won ? '+50🪙' : '';\n447\t\n448\t  // Answers review\n449\t  const answersEl = document.getElementById('pkr-answers');\n450\t  if (answersEl) {\n451\t    answersEl.innerHTML = r.answers.map((a, i) =>\n452\t      `<div class=\"answer-item${a.correct ? ' correct' : ' wrong'}\">${i+1}. ${a.idiom} ${a.correct ? '✓' : '✗'}</div>`\n453\t    ).join('');\n454\t  }\n455\t}\n456\t\n457\t// ===== W2: Characters =====\n458\tfunction renderCharacters(game) {\n459\t  showScreen('characters-screen');\n460\t  const chars = game.characters.getAll();\n461\t\n462\t  const grid = document.getElementById('char-grid');\n463\t  if (grid) {\n464\t    grid.innerHTML = chars.map(c => {\n465\t      const selected = game.data.data.characters.current === c.id;\n466\t      return `\n467\t        <div class=\"char-card${selected ? ' selected' : ''}${!c.unlocked ? ' locked' : ''}\"\n468\t             onclick=\"${c.unlocked ? `game.characters.select('${c.id}'); game.render()` : ''}\">\n469\t          <div class=\"char-avatar\">${c.unlocked ? c.avatar : '🔒'}</div>\n470\t          <div class=\"char-name\">${c.name}</div>\n471\t          <div class=\"char-skill\">${c.unlocked ? c.skill.name : `通关第${c.unlock.level || '?'}关解锁`}</div>\n472\t          ${selected ? '<div class=\"char-badge\">使用中</div>' : ''}\n473\t        </div>\n474\t      `;\n475\t    }).join('');\n476\t  }\n477\t\n478\t  // Skill detail\n479\t  const current = game.characters.getCurrent();\n480\t  const detail = document.getElementById('char-detail');\n481\t  if (detail) {\n482\t    detail.innerHTML = `\n483\t      <h4>${current.avatar} ${current.name}</h4>\n484\t      <p class=\"skill-name\">${current.skill.name}</p>\n485\t      <p class=\"skill-desc\">${current.skill.desc}</p>\n486\t    `;\n487\t  }\n488\t}\n489\t\n490\t// ===== Global handlers =====\n491\tfunction handleCategoryFilter(cat) {\n492\t  if (cat === '全部') { game.collection.clearFilter(); }\n493\t  else { game.collection.filterByCategory(cat); }\n494\t  game.render();\n495\t}\n496\t\n497\tfunction handleIdiomSelect(id) { game.collection.selectIdiom(id); game.render(); }\n498\t\n499\tfunction handleClaimTask(taskId) { game.daily.claimTask(taskId); game.render(); }\n500\t\n501\tfunction handleDailyChallenge() {\n502\t  const ds = game.daily.getDailyState();\n503\t  if (ds.challengeIdiom && !ds.challengeCompleted) {\n504\t    game.daily.completeChallenge();\n505\t    game.render();\n506\t  }\n507\t}\n508\t\n509\tfunction handleColSearch(val) { game.collection.search(val); game.render(); }\n510\t"}]},"parent_tool_use_id":"call_6bcfccedf3554e28a59ea4df","session_id":"33562fd9-d4f0-45be-a2a4-d9d379182d9f","uuid":"3e283d0f-82f7-4fe3-88b0-c54387dd800d","timestamp":"2026-05-23T10:12:59.139Z","subagent_type":"Explore","task_description":"Explore idiom game structure"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_1e12578b393043eeab652c55","type":"tool_result","content":"1\t// Renderer.js — Canvas 2D rendering engine with obstacle, boss, and updated UI support\n2\t\n3\tclass Renderer {\n4\t  constructor(canvas) {\n5\t    this.canvas = canvas;\n6\t    this.ctx = canvas.getContext('2d');\n7\t    this.tileSize = 0;\n8\t    this.boardX = 0;\n9\t    this.boardY = 0;\n10\t    this.particleSystem = null;\n11\t    this.floatingTexts = [];\n12\t    this.resize();\n13\t  }\n14\t\n15\t  resize() {\n16\t    const dpr = window.devicePixelRatio || 1;\n17\t    const w = window.innerWidth;\n18\t    const h = window.innerHeight;\n19\t    this.canvas.width = w * dpr;\n20\t    this.canvas.height = h * dpr;\n21\t    this.canvas.style.width = w + 'px';\n22\t    this.canvas.style.height = h + 'px';\n23\t    this.ctx.scale(dpr, dpr);\n24\t    this.screenW = w;\n25\t    this.screenH = h;\n26\t\n27\t    this.tileSize = Math.floor(Math.min(w * 0.9, (h - 160)) / BOARD_SIZE);\n28\t    this.boardX = (w - this.tileSize * BOARD_SIZE) / 2;\n29\t    this.boardY = 140;\n30\t  }\n31\t\n32\t  getTileCenter(row, col) {\n33\t    return {\n34\t      x: this.boardX + col * this.tileSize + this.tileSize / 2,\n35\t      y: this.boardY + row * this.tileSize + this.tileSize / 2,\n36\t    };\n37\t  }\n38\t\n39\t  clear() {\n40\t    this.ctx.clearRect(0, 0, this.screenW, this.screenH);\n41\t  }\n42\t\n43\t  drawBackground() {\n44\t    const ctx = this.ctx;\n45\t    ctx.fillStyle = '#FFF8E7';\n46\t    ctx.fillRect(0, 0, this.screenW, this.screenH);\n47\t\n48\t    const bw = this.tileSize * BOARD_SIZE;\n49\t    const bh = this.tileSize * BOARD_SIZE;\n50\t    ctx.fillStyle = '#FFFFFFCC';\n51\t    this._roundRect(ctx, this.boardX - 6, this.boardY - 6, bw + 12, bh + 12, 12);\n52\t    ctx.fill();\n53\t\n54\t    ctx.strokeStyle = '#F0E6D6';\n55\t    ctx.lineWidth = 1;\n56\t    for (let i = 0; i <= BOARD_SIZE; i++) {\n57\t      ctx.beginPath();\n58\t      ctx.moveTo(this.boardX + i * this.tileSize, this.boardY);\n59\t      ctx.lineTo(this.boardX + i * this.tileSize, this.boardY + bh);\n60\t      ctx.stroke();\n61\t      ctx.beginPath();\n62\t      ctx.moveTo(this.boardX, this.boardY + i * this.tileSize);\n63\t      ctx.lineTo(this.boardX + bw, this.boardY + i * this.tileSize);\n64\t      ctx.stroke();\n65\t    }\n66\t  }\n67\t\n68\t  drawTile(tile) {\n69\t    if (!tile || tile.color < 0) return;\n70\t    const ctx = this.ctx;\n71\t    const size = this.tileSize - 4;\n72\t    const cx = this.boardX + tile.col * this.tileSize + this.tileSize / 2 + (tile.offsetX || 0);\n73\t    const cy = this.boardY + tile.row * this.tileSize + this.tileSize / 2 + (tile.offsetY || 0);\n74\t    const scale = tile.scale || 1;\n75\t    const alpha = tile.alpha !== undefined ? tile.alpha : 1;\n76\t\n77\t    ctx.save();\n78\t    ctx.translate(cx, cy);\n79\t    ctx.scale(scale, scale);\n80\t    ctx.globalAlpha = alpha;\n81\t\n82\t    const half = size / 2;\n83\t    const color = COLOR_MAP[tile.color];\n84\t    if (!color) { ctx.restore(); return; }\n85\t\n86\t    ctx.fillStyle = color.hex;\n87\t    this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n88\t    ctx.fill();\n89\t\n90\t    ctx.fillStyle = 'rgba(255,255,255,0.25)';\n91\t    this._roundRect(ctx, -half + 3, -half + 3, size - 6, size / 2 - 3, size * 0.15);\n92\t    ctx.fill();\n93\t\n94\t    this._drawFruitIcon(ctx, tile.color, half * 0.55);\n95\t\n96\t    if (tile.special === SPECIAL_STRIPED_H) {\n97\t      this._drawStripes(ctx, size, half, '#FFFFFF80', true);\n98\t    } else if (tile.special === SPECIAL_STRIPED_V) {\n99\t      this._drawStripes(ctx, size, half, '#FFFFFF80', false);\n100\t    } else if (tile.special === SPECIAL_BOMB) {\n101\t      this._drawCrosshair(ctx, half);\n102\t    } else if (tile.special === SPECIAL_RAINBOW) {\n103\t      this._drawRainbowOverlay(ctx, half);\n104\t    }\n105\t\n106\t    if (tile.selected) {\n107\t      ctx.strokeStyle = '#FFFFFF';\n108\t      ctx.lineWidth = 3;\n109\t      ctx.shadowColor = '#FFB800';\n110\t      ctx.shadowBlur = 12;\n111\t      this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n112\t      ctx.stroke();\n113\t      ctx.shadowBlur = 0;\n114\t    }\n115\t\n116\t    ctx.restore();\n117\t  }\n118\t\n119\t  _drawFruitIcon(ctx, colorIdx, radius) {\n120\t    ctx.fillStyle = 'rgba(255,255,255,0.6)';\n121\t    ctx.font = `bold ${radius * 1.4}px sans-serif`;\n122\t    ctx.textAlign = 'center';\n123\t    ctx.textBaseline = 'middle';\n124\t    const icons = ['🍎', '🍌', '🫐', '🍏', '🍇', '🍊'];\n125\t    ctx.fillText(icons[colorIdx] || '', 0, 1);\n126\t  }\n127\t\n128\t  _drawStripes(ctx, size, half, color, horizontal) {\n129\t    ctx.strokeStyle = color;\n130\t    ctx.lineWidth = 2;\n131\t    if (horizontal) {\n132\t      for (let y = -half + 6; y < half; y += 8) {\n133\t        ctx.beginPath();\n134\t        ctx.moveTo(-half + 4, y);\n135\t        ctx.lineTo(half - 4, y);\n136\t        ctx.stroke();\n137\t      }\n138\t    } else {\n139\t      for (let x = -half + 6; x < half; x += 8) {\n140\t        ctx.beginPath();\n141\t        ctx.moveTo(x, -half + 4);\n142\t        ctx.lineTo(x, half - 4);\n143\t        ctx.stroke();\n144\t      }\n145\t    }\n146\t  }\n147\t\n148\t  _drawCrosshair(ctx, half) {\n149\t    ctx.strokeStyle = '#FFFFFF99';\n150\t    ctx.lineWidth = 2;\n151\t    ctx.beginPath();\n152\t    ctx.moveTo(-half * 0.6, 0); ctx.lineTo(half * 0.6, 0);\n153\t    ctx.moveTo(0, -half * 0.6); ctx.lineTo(0, half * 0.6);\n154\t    ctx.stroke();\n155\t    ctx.beginPath();\n156\t    ctx.arc(0, 0, half * 0.4, 0, Math.PI * 2);\n157\t    ctx.stroke();\n158\t  }\n159\t\n160\t  _drawRainbowOverlay(ctx, half) {\n161\t    const gradient = ctx.createLinearGradient(-half, -half, half, half);\n162\t    gradient.addColorStop(0, '#FF000080');\n163\t    gradient.addColorStop(0.17, '#FF880080');\n164\t    gradient.addColorStop(0.33, '#FFFF0080');\n165\t    gradient.addColorStop(0.5, '#00FF0080');\n166\t    gradient.addColorStop(0.67, '#0088FF80');\n167\t    gradient.addColorStop(0.83, '#8800FF80');\n168\t    gradient.addColorStop(1, '#FF008880');\n169\t    ctx.fillStyle = gradient;\n170\t    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.4);\n171\t    ctx.fill();\n172\t  }\n173\t\n174\t  // Draw all obstacles\n175\t  drawObstacles(obstacleMgr) {\n176\t    for (const obs of obstacleMgr.obstacles) {\n177\t      if (obs.isDestroyed()) continue;\n178\t      const shake = obs.shakeTimer > 0 ? (Math.random() - 0.5) * 4 : 0;\n179\t      const pos = this.getTileCenter(obs.row, obs.col);\n180\t      const half = (this.tileSize - 4) / 2;\n181\t\n182\t      this.ctx.save();\n183\t      this.ctx.translate(pos.x + shake, pos.y);\n184\t\n185\t      switch (obs.type) {\n186\t        case OBSTACLE_ICE:\n187\t          this._drawIce(this.ctx, half);\n188\t          break;\n189\t        case OBSTACLE_CHAIN:\n190\t          this._drawChain(this.ctx, half);\n191\t          break;\n192\t        case OBSTACLE_CHOCOLATE:\n193\t          this._drawChocolate(this.ctx, half);\n194\t          break;\n195\t      }\n196\t\n197\t      this.ctx.restore();\n198\t    }\n199\t  }\n200\t\n201\t  _drawIce(ctx, half) {\n202\t    // Translucent blue overlay\n203\t    ctx.fillStyle = 'rgba(135, 206, 250, 0.45)';\n204\t    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.2);\n205\t    ctx.fill();\n206\t    // Ice crack pattern\n207\t    ctx.strokeStyle = 'rgba(255, 255, 255, 0.7)';\n208\t    ctx.lineWidth = 1.5;\n209\t    ctx.beginPath();\n210\t    ctx.moveTo(-half * 0.3, -half * 0.5);\n211\t    ctx.lineTo(half * 0.2, 0);\n212\t    ctx.lineTo(-half * 0.1, half * 0.4);\n213\t    ctx.stroke();\n214\t    ctx.beginPath();\n215\t    ctx.moveTo(half * 0.3, -half * 0.3);\n216\t    ctx.lineTo(0, half * 0.1);\n217\t    ctx.stroke();\n218\t    // Ice label\n219\t    ctx.fillStyle = 'rgba(255,255,255,0.8)';\n220\t    ctx.font = `bold ${half * 0.6}px sans-serif`;\n221\t    ctx.textAlign = 'center';\n222\t    ctx.textBaseline = 'middle';\n223\t    ctx.fillText('❄', 0, 0);\n224\t  }\n225\t\n226\t  _drawChain(ctx, half) {\n227\t    // Chain icon overlay\n228\t    ctx.fillStyle = 'rgba(100, 100, 100, 0.35)';\n229\t    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.2);\n230\t    ctx.fill();\n231\t    // Chain links\n232\t    ctx.strokeStyle = 'rgba(80, 80, 80, 0.9)';\n233\t    ctx.lineWidth = 3;\n234\t    for (let i = -1; i <= 1; i++) {\n235\t      ctx.beginPath();\n236\t      ctx.ellipse(i * half * 0.5, 0, half * 0.25, half * 0.15, 0, 0, Math.PI * 2);\n237\t      ctx.stroke();\n238\t    }\n239\t    // Lock icon\n240\t    ctx.fillStyle = 'rgba(255,255,255,0.7)';\n241\t    ctx.font = `bold ${half * 0.7}px sans-serif`;\n242\t    ctx.textAlign = 'center';\n243\t    ctx.textBaseline = 'middle';\n244\t    ctx.fillText('🔗', 0, -half * 0.6);\n245\t  }\n246\t\n247\t  _drawChocolate(ctx, half) {\n248\t    // Brown blob\n249\t    ctx.fillStyle = '#6B3410';\n250\t    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.3);\n251\t    ctx.fill();\n252\t    // Chocolate drip pattern\n253\t    ctx.fillStyle = '#8B5E3C';\n254\t    this._roundRect(ctx, -half + 3, -half + 3, half * 2 - 6, half * 2 - 6, half * 0.25);\n255\t    ctx.fill();\n256\t    // Shine\n257\t    ctx.fillStyle = 'rgba(255,255,255,0.15)';\n258\t    this._roundRect(ctx, -half + 6, -half + 6, half - 3, half * 0.6, half * 0.15);\n259\t    ctx.fill();\n260\t    // Emoji\n261\t    ctx.font = `bold ${half * 0.8}px sans-serif`;\n262\t    ctx.textAlign = 'center';\n263\t    ctx.textBaseline = 'middle';\n264\t    ctx.fillText('🍫', 0, 0);\n265\t  }\n266\t\n267\t  // Draw boss on board\n268\t  drawBoss(boss, renderer) {\n269\t    const pos = this.getTileCenter(boss.row, boss.col);\n270\t    const half = (this.tileSize - 4) / 2;\n271\t    const shake = boss.shakeTimer > 0 ? (Math.random() - 0.5) * 6 : 0;\n272\t\n273\t    this.ctx.save();\n274\t    this.ctx.translate(pos.x + shake, pos.y);\n275\t\n276\t    // Boss body\n277\t    const isUsingSkill = boss.skillAnimTimer > 0;\n278\t    const pulseScale = isUsingSkill ? 1.1 : 1;\n279\t    this.ctx.scale(pulseScale, pulseScale);\n280\t\n281\t    // Dark aura\n282\t    this.ctx.fillStyle = isUsingSkill ? 'rgba(255,0,0,0.15)' : 'rgba(80,0,80,0.1)';\n283\t    this.ctx.beginPath();\n284\t    this.ctx.arc(0, 0, half * 1.3, 0, Math.PI * 2);\n285\t    this.ctx.fill();\n286\t\n287\t    // Boss face\n288\t    this.ctx.fillStyle = '#4A0E4E';\n289\t    this._roundRect(this.ctx, -half, -half, half * 2, half * 2, half * 0.3);\n290\t    this.ctx.fill();\n291\t\n292\t    // Inner glow\n293\t    const grad = this.ctx.createRadialGradient(0, 0, 0, 0, 0, half);\n294\t    grad.addColorStop(0, 'rgba(255,100,200,0.3)');\n295\t    grad.addColorStop(1, 'rgba(80,0,120,0.1)');\n296\t    this.ctx.fillStyle = grad;\n297\t    this._roundRect(this.ctx, -half, -half, half * 2, half * 2, half * 0.3);\n298\t    this.ctx.fill();\n299\t\n300\t    // Boss emoji\n301\t    this.ctx.font = `bold ${half * 1.2}px sans-serif`;\n302\t    this.ctx.textAlign = 'center';\n303\t    this.ctx.textBaseline = 'middle';\n304\t    const hpRatio = boss.hp / boss.maxHp;\n305\t    const bossEmoji = hpRatio > 0.5 ? '👹' : hpRatio > 0.25 ? '👿' : '💀';\n306\t    this.ctx.fillText(bossEmoji, 0, 0);\n307\t\n308\t    this.ctx.restore();\n309\t  }\n310\t\n311\t  // Draw boss health bar above the board\n312\t  drawBossHealthBar(boss) {\n313\t    const ctx = this.ctx;\n314\t    const barW = Math.min(200, this.screenW - 40);\n315\t    const barH = 14;\n316\t    const barX = (this.screenW - barW) / 2;\n317\t    const barY = this.boardY + this.tileSize * BOARD_SIZE + 50;\n318\t\n319\t    // Background\n320\t    ctx.fillStyle = '#E0D5C5';\n321\t    this._roundRect(ctx, barX, barY, barW, barH, 7);\n322\t    ctx.fill();\n323\t\n324\t    // HP bar\n325\t    const hpRatio = Math.max(0, boss.hp / boss.maxHp);\n326\t    if (hpRatio > 0) {\n327\t      const grad = ctx.createLinearGradient(barX, barY, barX + barW * hpRatio, barY);\n328\t      grad.addColorStop(0, '#FF4D4D');\n329\t      grad.addColorStop(1, '#CC0000');\n330\t      ctx.fillStyle = grad;\n331\t      this._roundRect(ctx, barX, barY, barW * hpRatio, barH, 7);\n332\t      ctx.fill();\n333\t    }\n334\t\n335\t    // Boss name and HP text\n336\t    ctx.fillStyle = '#5D4037';\n337\t    ctx.font = 'bold 12px sans-serif';\n338\t    ctx.textAlign = 'center';\n339\t    ctx.fillText(`${boss.name}  ${boss.hp}/${boss.maxHp}`, this.screenW / 2, barY + barH + 14);\n340\t  }\n341\t\n342\t  // Updated drawUI to support new goal types\n343\t  drawUI(score, moves, config, scoreSystem, level) {\n344\t    const ctx = this.ctx;\n345\t\n346\t    // Top bar background\n347\t    ctx.fillStyle = '#FFB800';\n348\t    this._roundRect(ctx, 8, 8, this.screenW - 16, 55, 12);\n349\t    ctx.fill();\n350\t\n351\t    // Level\n352\t    ctx.fillStyle = '#5D4037';\n353\t    ctx.font = 'bold 18px sans-serif';\n354\t    ctx.textAlign = 'left';\n355\t    ctx.fillText(`第 ${level} 关`, 20, 42);\n356\t\n357\t    // Level name\n358\t    if (config.name) {\n359\t      ctx.font = '12px sans-serif';\n360\t      ctx.fillText(config.name, 20, 22);\n361\t    }\n362\t\n363\t    // Score\n364\t    ctx.textAlign = 'center';\n365\t    ctx.fillStyle = '#FFFFFF';\n366\t    ctx.font = 'bold 20px sans-serif';\n367\t    ctx.fillText(`${score}`, this.screenW / 2, 32);\n368\t    ctx.font = '12px sans-serif';\n369\t    ctx.fillText('分数', this.screenW / 2, 48);\n370\t\n371\t    // Moves\n372\t    ctx.textAlign = 'right';\n373\t    ctx.fillStyle = moves <= 5 ? '#FF4D4D' : '#5D4037';\n374\t    ctx.font = 'bold 22px sans-serif';\n375\t    ctx.fillText(`${moves}`, this.screenW - 20, 32);\n376\t    ctx.font = '12px sans-serif';\n377\t    ctx.fillStyle = '#5D4037';\n378\t    ctx.fillText('剩余步数', this.screenW - 20, 48);\n379\t\n380\t    // Goal progress — use the new goal description\n381\t    const goalDesc = scoreSystem.getGoalDescription();\n382\t    const progressBars = scoreSystem.getProgressForUI();\n383\t\n384\t    const barW = this.screenW - 40;\n385\t    const barH = 16;\n386\t    const barY = 72;\n387\t    const barX = 20;\n388\t\n389\t    // Goal label\n390\t    ctx.fillStyle = '#5D4037';\n391\t    ctx.font = 'bold 11px sans-serif';\n392\t    ctx.textAlign = 'center';\n393\t\n394\t    if (progressBars.length === 1) {\n395\t      // Single goal — progress bar\n396\t      const p = progressBars[0];\n397\t      ctx.fillStyle = '#E0D5C5';\n398\t      this._roundRect(ctx, barX, barY, barW, barH, 8);\n399\t      ctx.fill();\n400\t\n401\t      const progress = Math.min(p.current / p.target, 1);\n402\t      if (progress > 0) {\n403\t        const grad = ctx.createLinearGradient(barX, barY, barX + barW * progress, barY);\n404\t        grad.addColorStop(0, '#6BCB77');\n405\t        grad.addColorStop(1, '#4DA66B');\n406\t        ctx.fillStyle = grad;\n407\t        this._roundRect(ctx, barX, barY, barW * progress, barH, 8);\n408\t        ctx.fill();\n409\t      }\n410\t\n411\t      ctx.fillStyle = '#5D4037';\n412\t      ctx.font = 'bold 11px sans-serif';\n413\t      ctx.fillText(goalDesc, this.screenW / 2, barY + 13);\n414\t    } else {\n415\t      // Dual goal — two smaller bars\n416\t      const halfBarW = (barW - 10) / 2;\n417\t      for (let i = 0; i < progressBars.length; i++) {\n418\t        const p = progressBars[i];\n419\t        const bx = barX + i * (halfBarW + 10);\n420\t\n421\t        ctx.fillStyle = '#E0D5C5';\n422\t        this._roundRect(ctx, bx, barY, halfBarW, barH, 8);\n423\t        ctx.fill();\n424\t\n425\t        const progress = Math.min(p.current / p.target, 1);\n426\t        if (progress > 0) {\n427\t          const grad = ctx.createLinearGradient(bx, barY, bx + halfBarW * progress, barY);\n428\t          grad.addColorStop(0, i === 0 ? '#6BCB77' : '#4DA6FF');\n429\t          grad.addColorStop(1, i === 0 ? '#4DA66B' : '#3388DD');\n430\t          ctx.fillStyle = grad;\n431\t          this._roundRect(ctx, bx, barY, halfBarW * progress, barH, 8);\n432\t          ctx.fill();\n433\t        }\n434\t\n435\t        ctx.fillStyle = '#5D4037';\n436\t        ctx.font = 'bold 10px sans-serif';\n437\t        ctx.fillText(`${p.current}/${p.target}`, bx + halfBarW / 2, barY + 13);\n438\t      }\n439\t    }\n440\t\n441\t    // Bottom hint\n442\t    ctx.fillStyle = '#8D6E63';\n443\t    ctx.font = '14px sans-serif';\n444\t    ctx.textAlign = 'center';\n445\t    const hintY = this.boardY + this.tileSize * BOARD_SIZE + 30;\n446\t    // Don't overlap with boss health bar\n447\t    const hintOffset = scoreSystem.goalType === 'boss' ? 0 : 30;\n448\t    ctx.fillText('滑动交换相邻方块', this.screenW / 2, hintY + hintOffset);\n449\t  }\n450\t\n451\t  drawComboText(text) {\n452\t    if (!text) return;\n453\t    const ctx = this.ctx;\n454\t    ctx.save();\n455\t    ctx.fillStyle = '#FF4D4D';\n456\t    ctx.font = 'bold 36px sans-serif';\n457\t    ctx.textAlign = 'center';\n458\t    ctx.textBaseline = 'middle';\n459\t    ctx.shadowColor = '#FFB800';\n460\t    ctx.shadowBlur = 8;\n461\t    ctx.fillText(text, this.screenW / 2, this.boardY + this.tileSize * BOARD_SIZE / 2);\n462\t    ctx.restore();\n463\t  }\n464\t\n465\t  addFloatingText(text, x, y, color = '#FF4D4D') {\n466\t    this.floatingTexts.push({ text, x, y, alpha: 1, vy: -60, life: 1.0, color });\n467\t  }\n468\t\n469\t  updateAndDrawFloatingTexts(dt) {\n470\t    const ctx = this.ctx;\n471\t    this.floatingTexts = this.floatingTexts.filter(ft => {\n472\t      ft.y += ft.vy * dt;\n473\t      ft.life -= dt;\n474\t      ft.alpha = Math.max(0, ft.life);\n475\t      if (ft.life <= 0) return false;\n476\t\n477\t      ctx.globalAlpha = ft.alpha;\n478\t      ctx.fillStyle = ft.color;\n479\t      ctx.font = 'bold 18px sans-serif';\n480\t      ctx.textAlign = 'center';\n481\t      ctx.fillText(ft.text, ft.x, ft.y);\n482\t      ctx.globalAlpha = 1;\n483\t      return true;\n484\t    });\n485\t  }\n486\t\n487\t  drawResultScreen(won, score, stars, level) {\n488\t    const ctx = this.ctx;\n489\t    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n490\t    ctx.fillRect(0, 0, this.screenW, this.screenH);\n491\t\n492\t    const pw = Math.min(320, this.screenW - 40);\n493\t    const ph = 260;\n494\t    const px = (this.screenW - pw) / 2;\n495\t    const py = (this.screenH - ph) / 2;\n496\t\n497\t    ctx.fillStyle = '#FFF8E7';\n498\t    this._roundRect(ctx, px, py, pw, ph, 16);\n499\t    ctx.fill();\n500\t    ctx.strokeStyle = '#FFB800';\n501\t    ctx.lineWidth = 3;\n502\t    this._roundRect(ctx, px, py, pw, ph, 16);\n503\t    ctx.stroke();\n504\t\n505\t    ctx.fillStyle = '#5D4037';\n506\t    ctx.font = 'bold 24px sans-serif';\n507\t    ctx.textAlign = 'center';\n508\t    ctx.fillText(won ? '🎉 恭喜过关！' : '😢 挑战失败', this.screenW / 2, py + 45);\n509\t\n510\t    ctx.font = 'bold 36px sans-serif';\n511\t    ctx.fillStyle = '#FFB800';\n512\t    ctx.fillText(score, this.screenW / 2, py + 95);\n513\t    ctx.font = '14px sans-serif';\n514\t    ctx.fillStyle = '#8D6E63';\n515\t    ctx.fillText('得分', this.screenW / 2, py + 115);\n516\t\n517\t    if (won) {\n518\t      for (let i = 0; i < 3; i++) {\n519\t        ctx.font = '32px sans-serif';\n520\t        ctx.fillText(i < stars ? '⭐' : '☆', this.screenW / 2 - 45 + i * 45, py + 160);\n521\t      }\n522\t    }\n523\t\n524\t    const btnW = 120, btnH = 42;\n525\t    const btnY = py + ph - 60;\n526\t\n527\t    ctx.fillStyle = '#6BCB77';\n528\t    this._roundRect(ctx, this.screenW / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n529\t    ctx.fill();\n530\t    ctx.fillStyle = '#FFFFFF';\n531\t    ctx.font = 'bold 16px sans-serif';\n532\t    ctx.fillText(won ? '下一关' : '重试', this.screenW / 2 - btnW / 2 - 10, btnY + 27);\n533\t\n534\t    ctx.fillStyle = '#8D6E63';\n535\t    this._roundRect(ctx, this.screenW / 2 + 10, btnY, btnW, btnH, btnH / 2);\n536\t    ctx.fill();\n537\t    ctx.fillStyle = '#FFFFFF';\n538\t    ctx.fillText('菜单', this.screenW / 2 + btnW / 2 + 10, btnY + 27);\n53