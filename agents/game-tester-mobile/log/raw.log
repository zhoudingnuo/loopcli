{"type":"assistant","message":{"id":"msg_20260523182223b0f5a1833f814990","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_65b47f3ccaa047568739f2b0","name":"Write","input":{"file_path":"D:/game-projects/douyin-match3/test/mobile-compat.test.js","content":"/**\n * Mobile Compatibility Tests for 消消消大作战 (Match-3)\n * Tests: touch event handling, canvas resize, tt.* API integration, navigation\n */\n\nconst fs = require('fs');\nconst path = require('path');\n\nconst SRC = path.resolve(__dirname, '../src/js');\nconst HTML = fs.readFileSync(path.resolve(__dirname, '../index.html'), 'utf-8');\n\nfunction readSrc(name) {\n  return fs.readFileSync(path.join(SRC, name), 'utf-8');\n}\n\n// ============================================================\n// 1. Touch Event Tests\n// ============================================================\ndescribe('Touch Event Handling', () => {\n  const inputSrc = readSrc('InputHandler.js');\n  const htmlSrc = HTML;\n\n  test('InputHandler binds touchstart, touchmove, touchend events', () => {\n    expect(inputSrc).toMatch(/addEventListener\\s*\\(\\s*['\"]touchstart['\"]/);\n    expect(inputSrc).toMatch(/addEventListener\\s*\\(\\s*['\"]touchmove['\"]/);\n    expect(inputSrc).toMatch(/addEventListener\\s*\\(\\s*['\"]touchend['\"]/);\n  });\n\n  test('Touch events use passive: false', () => {\n    // Count occurrences of passive: false\n    const matches = inputSrc.match(/passive:\\s*false/g) || [];\n    expect(matches.length).toBeGreaterThanOrEqual(3);\n  });\n\n  test('Touch handlers use e.touches[0] / e.changedTouches[0]', () => {\n    expect(inputSrc).toMatch(/e\\.touches\\[0\\]/);\n    expect(inputSrc).toMatch(/e\\.changedTouches\\[0\\]/);\n  });\n\n  test('InputHandler has active flag to skip touch when nav is showing', () => {\n    expect(inputSrc).toMatch(/this\\.active/);\n    expect(inputSrc).toMatch(/if\\s*\\(!this\\.active\\)\\s*return/);\n  });\n\n  test('Navigation screens have touch handling via touchend listener', () => {\n    expect(htmlSrc).toMatch(/addEventListener\\s*\\(\\s*['\"]touchend['\"]/);\n    expect(htmlSrc).toMatch(/game\\.nav\\.handleClick/);\n  });\n\n  test('Navigation.goTo toggles InputHandler.active', () => {\n    const navSrc = readSrc('Navigation.js');\n    expect(navSrc).toMatch(/this\\.game\\.input\\.active/);\n  });\n\n  test('Back-to-map button works via touchend', () => {\n    expect(htmlSrc).toMatch(/backX.*backY.*goTo\\s*\\(\\s*['\"]map['\"]\\)/s);\n  });\n});\n\n// ============================================================\n// 2. Canvas Resize / Screen Adaptation Tests\n// ============================================================\ndescribe('Canvas Resize Adaptation', () => {\n  const rendererSrc = readSrc('Renderer.js');\n  const htmlSrc = HTML;\n\n  test('Renderer.resize() handles devicePixelRatio', () => {\n    expect(rendererSrc).toMatch(/devicePixelRatio/);\n    expect(rendererSrc).toMatch(/dpr/);\n  });\n\n  test('Canvas dimensions use dpr scaling', () => {\n    expect(rendererSrc).toMatch(/canvas\\.width\\s*=\\s*w\\s*\\*\\s*dpr/);\n    expect(rendererSrc).toMatch(/canvas\\.height\\s*=\\s*h\\s*\\*\\s*dpr/);\n  });\n\n  test('CSS dimensions set in logical pixels', () => {\n    expect(rendererSrc).toMatch(/canvas\\.style\\.width\\s*=\\s*w/);\n    expect(rendererSrc).toMatch(/canvas\\.style\\.height\\s*=\\s*h/);\n  });\n\n  test('Context scaled by dpr for high-DPI rendering', () => {\n    expect(rendererSrc).toMatch(/ctx\\.scale\\s*\\(\\s*dpr\\s*,\\s*dpr\\s*\\)/);\n  });\n\n  test('Tile size calculated relative to screen dimensions', () => {\n    expect(rendererSrc).toMatch(/tileSize\\s*=.*Math\\.floor.*Math\\.min/);\n  });\n\n  test('Board centered with dynamic boardX offset', () => {\n    expect(rendererSrc).toMatch(/boardX\\s*=.*\\(.*w.*-.*tileSize/);\n  });\n\n  test('Window resize and orientationchange handled', () => {\n    expect(htmlSrc).toMatch(/addEventListener\\s*\\(\\s*['\"]resize['\"]/);\n    expect(htmlSrc).toMatch(/addEventListener\\s*\\(\\s*['\"]orientationchange['\"]/);\n  });\n\n  test('InputHandler layout updated on resize', () => {\n    expect(htmlSrc).toMatch(/game\\.input\\.updateLayout/);\n  });\n});\n\n// ============================================================\n// 3. Douyin API (tt.*) Integration Tests\n// ============================================================\ndescribe('Douyin tt.* API Integration', () => {\n  const adSrc = readSrc('AdManager.js');\n  const socialSrc = readSrc('SocialSystem.js');\n  const analyticsSrc = readSrc('Analytics.js');\n\n  test('AdManager detects Douyin environment', () => {\n    expect(adSrc).toMatch(/typeof\\s+tt\\s*!==?\\s*['\"]undefined['\"]/);\n  });\n\n  test('AdManager creates rewarded video ad via tt API', () => {\n    expect(adSrc).toMatch(/tt\\.createRewardedVideoAd/);\n  });\n\n  test('AdManager creates interstitial ad via tt API', () => {\n    expect(adSrc).toMatch(/tt\\.createInterstitialAd/);\n  });\n\n  test('AdManager handles ad load/error/close events', () => {\n    expect(adSrc).toMatch(/\\.onLoad\\s*\\(/);\n    expect(adSrc).toMatch(/\\.onError\\s*\\(/);\n    expect(adSrc).toMatch(/\\.onClose\\s*\\(/);\n  });\n\n  test('AdManager has stub fallback for development', () => {\n    expect(adSrc).toMatch(/_showStubAd|stub/i);\n  });\n\n  test('SocialSystem uses tt.shareAppMessage for sharing', () => {\n    expect(socialSrc).toMatch(/tt\\.shareAppMessage/);\n  });\n\n  test('SocialSystem has fallback when tt is unavailable', () => {\n    expect(socialSrc).toMatch(/typeof\\s+tt\\s*!==?\\s*['\"]undefined['\"]/);\n  });\n\n  test('Analytics uploads events with tt.request or fetch fallback', () => {\n    expect(analyticsSrc).toMatch(/tt\\.request|fetch/);\n  });\n});\n\n// ============================================================\n// 4. Viewport & Meta Tag Tests\n// ============================================================\ndescribe('Viewport Configuration', () => {\n  const htmlSrc = HTML;\n\n  test('Viewport meta prevents user scaling', () => {\n    expect(htmlSrc).toMatch(/user-scalable\\s*=\\s*no/);\n    expect(htmlSrc).toMatch(/maximum-scale\\s*=\\s*1\\.0/);\n  });\n\n  test('Portrait orientation enforced', () => {\n    expect(htmlSrc).toMatch(/screen-orientation.*portrait|x5-orientation.*portrait/);\n  });\n\n  test('touch-action: none prevents browser gesture interference', () => {\n    expect(htmlSrc).toMatch(/touch-action\\s*:\\s*none/);\n  });\n\n  test('User selection disabled', () => {\n    expect(htmlSrc).toMatch(/user-select\\s*:\\s*none/);\n  });\n\n  test('Phone number detection disabled', () => {\n    expect(htmlSrc).toMatch(/format-detection.*telephone\\s*=\\s*no/);\n  });\n\n  test('Apple mobile web app capable set', () => {\n    expect(htmlSrc).toMatch(/apple-mobile-web-app-capable/);\n  });\n});\n\n// ============================================================\n// 5. Input Coordinates Tests\n// ============================================================\ndescribe('Input Coordinate Handling', () => {\n  const inputSrc = readSrc('InputHandler.js');\n\n  test('Screen-to-grid conversion handles bounds checking', () => {\n    expect(inputSrc).toMatch(/row\\s*>=\\s*0.*row\\s*<.*board\\.size/);\n    expect(inputSrc).toMatch(/col\\s*>=\\s*0.*col\\s*<.*board\\.size/);\n  });\n\n  test('Swipe minimum distance threshold prevents accidental taps', () => {\n    expect(inputSrc).toMatch(/tileSize.*0\\.2|0\\.2.*tileSize/);\n  });\n\n  test('Swipe direction detection handles both axes', () => {\n    expect(inputSrc).toMatch(/Math\\.abs\\s*\\(\\s*dx\\s*\\)\\s*>\\s*Math\\.abs\\s*\\(\\s*dy\\s*\\)/);\n  });\n\n  test('Tap vs swipe distinction', () => {\n    expect(inputSrc).toMatch(/onTap/);\n  });\n\n  test('Input disabled during non-IDLE states', () => {\n    const gameSrc = readSrc('Game.js');\n    expect(gameSrc).toMatch(/input\\.enabled\\s*=\\s*this\\.state/);\n  });\n});\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"33562fd9-d4f0-45be-a2a4-d9d379182d9f","uuid":"72e13f99-49a6-41d0-88ed-9102a15aba8f"}
