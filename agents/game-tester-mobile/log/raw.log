"nán yuán běi zhé\",meaning:\"比喻行动和目的相反\",difficulty:1,category:[\"常用\"],frequency:56},\n91\t{id:\"e086\",idiom:\"光明正大\",chars:[\"光\",\"明\",\"正\",\"大\"],pinyin:\"guāng míng zhèng dà\",meaning:\"心怀坦白言行正派\",difficulty:1,category:[\"常用\"],frequency:55},\n92\t{id:\"e087\",idiom:\"日月星辰\",chars:[\"日\",\"月\",\"星\",\"辰\"],pinyin:\"rì yuè xīng chén\",meaning:\"太阳月亮和星星\",difficulty:1,category:[\"自然\"],frequency:55},\n93\t{id:\"e088\",idiom:\"水落石出\",chars:[\"水\",\"落\",\"石\",\"出\"],pinyin:\"shuǐ luò shí chū\",meaning:\"比喻事情真相大白\",difficulty:1,category:[\"自然\"],frequency:54},\n94\t{id:\"e089\",idiom:\"火上浇油\",chars:[\"火\",\"上\",\"浇\",\"油\"],pinyin:\"huǒ shàng jiāo yóu\",meaning:\"比喻使事态更加严重\",difficulty:1,category:[\"自然\"],frequency:54},\n95\t{id:\"e090\",idiom:\"雪中送炭\",chars:[\"雪\",\"中\",\"送\",\"炭\"],pinyin:\"xuě zhōng sòng tàn\",meaning:\"比喻在别人急需时给予帮助\",difficulty:1,category:[\"自然\"],frequency:53},\n96\t{id:\"e091\",idiom:\"锦上添花\",chars:[\"锦\",\"上\",\"添\",\"花\"],pinyin:\"jǐn shàng tiān huā\",meaning:\"比喻好上加好美上添美\",difficulty:1,category:[\"自然\"],frequency:53},\n97\t{id:\"e092\",idiom:\"春暖花开\",chars:[\"春\",\"暖\",\"花\",\"开\"],pinyin:\"chūn nuǎn huā kāi\",meaning:\"春天气候暖和百花盛开\",difficulty:1,category:[\"四季\",\"自然\"],frequency:52},\n98\t{id:\"e093\",idiom:\"秋高气爽\",chars:[\"秋\",\"高\",\"气\",\"爽\"],pinyin:\"qiū gāo qì shuǎng\",meaning:\"形容秋天晴空万里天气凉爽\",difficulty:1,category:[\"四季\",\"自然\"],frequency:52},\n99\t{id:\"e094\",idiom:\"张灯结彩\",chars:[\"张\",\"灯\",\"结\",\"彩\"],pinyin:\"zhāng dēng jié cǎi\",meaning:\"形容节日或喜庆的景象\",difficulty:1,category:[\"常用\"],frequency:51},\n100\t{id:\"e095\",idiom:\"兴高采烈\",chars:[\"兴\",\"高\",\"采\",\"烈\"],pinyin:\"xìng gāo cǎi liè\",meaning:\"形容非常高兴的样子\",difficulty:1,category:[\"情感\"],frequency:51},"}]},"parent_tool_use_id":"call_6bcfccedf3554e28a59ea4df","session_id":"33562fd9-d4f0-45be-a2a4-d9d379182d9f","uuid":"a12d357e-47bf-4cd0-b8b1-b9711b098b25","timestamp":"2026-05-23T10:14:34.966Z","subagent_type":"Explore","task_description":"Explore idiom game structure"