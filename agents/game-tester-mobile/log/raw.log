{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_83c253eb09a64065917ac9a6","type":"tool_result","content":"1\t<!DOCTYPE html>\n2\t<html lang=\"zh-CN\">\n3\t<head>\n4\t  <meta charset=\"UTF-8\">\n5\t  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n6\t  <title>成语大闯关 - Idiom Master</title>\n7\t  <link rel=\"stylesheet\" href=\"src/css/style.css\">\n8\t</head>\n9\t<body>\n10\t  <div id=\"app\">\n11\t    <!-- 主菜单 -->\n12\t    <div id=\"menu-screen\" class=\"screen active\">\n13\t      <div class=\"menu-bg\">\n14\t        <div class=\"title-block\">\n15\t          <h1 class=\"title\">成语大闯关</h1>\n16\t          <p class=\"subtitle\">Idiom Master</p>\n17\t        </div>\n18\t        <div class=\"menu-stats\">\n19\t          <span class=\"stat-item\" id=\"menu-avatar\">👦</span>\n20\t          <span class=\"stat-item\">🪙 <span id=\"menu-coins\">0</span></span>\n21\t          <span class=\"stat-item\">📖 <span id=\"menu-collected\">0</span>成语</span>\n22\t        </div>\n23\t        <div class=\"menu-buttons\">\n24\t          <button class=\"btn btn-primary\" onclick=\"game.showLevelMap()\">闯关模式</button>\n25\t          <button class=\"btn btn-secondary\" onclick=\"game.startTimedChallenge()\">限时挑战</button>\n26\t          <button class=\"btn btn-accent\" onclick=\"game.startPK()\">好友PK</button>\n27\t        </div>\n28\t        <div class=\"menu-row\">\n29\t          <button class=\"btn btn-outline\" onclick=\"game.showCollection()\">📖 成语图鉴</button>\n30\t          <button class=\"btn btn-outline\" onclick=\"game.showDaily()\">📅 每日</button>\n31\t          <button class=\"btn btn-outline\" onclick=\"game.showCharacters()\">👤 角色</button>\n32\t        </div>\n33\t        <div class=\"menu-footer\">\n34\t          <button class=\"btn-icon\" onclick=\"game.audio.toggle(); this.textContent = game.audio.enabled ? '🔊' : '🔇'\">🔊</button>\n35\t          <button class=\"btn-icon\" onclick=\"game.data.reset(); location.reload()\">🔄</button>\n36\t        </div>\n37\t      </div>\n38\t    </div>\n39\t\n40\t    <!-- 关卡地图 -->\n41\t    <div id=\"map-screen\" class=\"screen\">\n42\t      <div class=\"map-header\">\n43\t        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n44\t        <h2>选择关卡</h2>\n45\t        <span>🪙 <span id=\"map-coins\">0</span></span>\n46\t      </div>\n47\t      <div id=\"chapter-info\" class=\"chapter-info\"></div>\n48\t      <div id=\"level-grid\" class=\"level-grid\"></div>\n49\t    </div>\n50\t\n51\t    <!-- 游戏界面 -->\n52\t    <div id=\"game-screen\" class=\"screen\">\n53\t      <div class=\"game-header\">\n54\t        <button class=\"btn-back\" onclick=\"game.goToMenu()\">✕</button>\n55\t        <div class=\"header-center\">\n56\t          <span id=\"level-label\">第1关</span>\n57\t          <span id=\"progress-label\">1/10</span>\n58\t        </div>\n59\t        <div class=\"header-right\">\n60\t          <span id=\"lives-display\">❤️❤️❤️❤️❤️</span>\n61\t        </div>\n62\t      </div>\n63\t\n64\t      <div class=\"game-body\">\n65\t        <div id=\"combo-display\" class=\"combo-display\"></div>\n66\t        <div id=\"meaning-box\" class=\"meaning-box\">\n67\t          <span id=\"meaning-text\"></span>\n68\t        </div>\n69\t        <div id=\"slots-container\" class=\"slots-container\"></div>\n70\t        <div id=\"idiom-hint\" class=\"idiom-hint\"></div>\n71\t        <div id=\"candidates-container\" class=\"candidates-container\"></div>\n72\t      </div>\n73\t\n74\t      <div class=\"game-footer\">\n75\t        <button class=\"tool-btn\" onclick=\"handleHintReveal()\">📖 揭示 (5🪙)</button>\n76\t        <button class=\"tool-btn\" onclick=\"handleHintRemove()\">✂️ 去干扰 (5🪙)</button>\n77\t        <button class=\"tool-btn\" onclick=\"handleSkip()\">⏭ 跳过 (10🪙)</button>\n78\t      </div>\n79\t\n80\t      <!-- 教学覆盖层 -->\n81\t      <div id=\"tutorial-overlay\" class=\"tutorial-overlay\" style=\"display:none\">\n82\t        <div class=\"tutorial-arrow\"></div>\n83\t        <div id=\"tutorial-text\" class=\"tutorial-text\"></div>\n84\t      </div>\n85\t    </div>\n86\t\n87\t    <!-- 结算界面 -->\n88\t    <div id=\"result-screen\" class=\"screen\">\n89\t      <div class=\"result-card\">\n90\t        <h2 id=\"result-title\" class=\"result-title\">通关!</h2>\n91\t        <div id=\"result-stars\" class=\"result-stars\"></div>\n92\t        <div class=\"result-stats\">\n93\t          <p>正确: <span id=\"result-correct\">0</span> / <span id=\"result-total\">10</span></p>\n94\t          <p>得分: <span id=\"result-score\">0</span></p>\n95\t          <p>最大连击: <span id=\"result-combo\">0</span></p>\n96\t          <p class=\"coins-earned\">🪙 +<span id=\"result-coins\">0</span></p>\n97\t        </div>\n98\t        <div class=\"result-buttons\">\n99\t          <button class=\"btn btn-primary\" onclick=\"game.goToMenu()\">返回地图</button>\n100\t          <button class=\"btn btn-secondary\" id=\"btn-retry\" onclick=\"game.startLevel(game.currentLevel.id)\">重新挑战</button>\n101\t          <button class=\"btn btn-accent\" id=\"btn-next\" onclick=\"game.startLevel(game.currentLevel.id + 1)\">下一关</button>\n102\t          <button class=\"btn btn-ad\" id=\"btn-double\" style=\"display:none\" onclick=\"handleDoubleReward()\">🎬 看视频领取 ×2</button>\n103\t        </div>\n104\t      </div>\n105\t    </div>\n106\t\n107\t    <!-- 续命弹窗 -->\n108\t    <div id=\"continue-modal\" class=\"modal\" style=\"display:none\">\n109\t      <div class=\"modal-content\">\n110\t        <h3>挑战失败</h3>\n111\t        <p>生命值耗尽了！</p>\n112\t        <div class=\"modal-buttons\">\n113\t          <button class=\"btn btn-secondary\" onclick=\"game.finishLevel(); document.getElementById('continue-modal').style.display='none'\">放弃</button>\n114\t          <button class=\"btn btn-ad\" onclick=\"game.continueWithAd()\">🎬 看视频续命 ❤️×3</button>\n115\t        </div>\n116\t      </div>\n117\t    </div>\n118\t\n119\t    <!-- ===== W2: 限时挑战 ===== -->\n120\t    <div id=\"timed-screen\" class=\"screen\">\n121\t      <div class=\"game-header\">\n122\t        <button class=\"btn-back\" onclick=\"game.timed.end();game.goToMenu()\">✕</button>\n123\t        <div class=\"header-center\">\n124\t          <span id=\"timed-timer\" class=\"timer-display\">60s</span>\n125\t        </div>\n126\t        <div class=\"header-right\">\n127\t          <span>得分: <span id=\"timed-score\">0</span></span>\n128\t        </div>\n129\t      </div>\n130\t      <div class=\"game-body\">\n131\t        <div id=\"timed-combo\" class=\"combo-display\"></div>\n132\t        <div class=\"meaning-box\"><span id=\"timed-meaning\"></span></div>\n133\t        <div id=\"timed-slots\" class=\"slots-container\"></div>\n134\t        <div id=\"timed-candidates\" class=\"candidates-container\"></div>\n135\t      </div>\n136\t      <div class=\"game-footer\">\n137\t        <button class=\"tool-btn\" onclick=\"game.timed.useHintReveal()\">📖 揭示</button>\n138\t        <button class=\"tool-btn\" onclick=\"game.timed.useHintRemove()\">✂️ 去干扰</button>\n139\t      </div>\n140\t    </div>\n141\t\n142\t    <!-- W2: 限时挑战结算 -->\n143\t    <div id=\"timed-result-screen\" class=\"screen\">\n144\t      <div class=\"result-card\">\n145\t        <h2 class=\"result-title\">⏱ 限时挑战结束</h2>\n146\t        <div class=\"result-stats\">\n147\t          <p>得分: <span id=\"tr-score\">0</span></p>\n148\t          <p>正确: <span id=\"tr-correct\">0</span> / <span id=\"tr-total\">0</span></p>\n149\t          <p>最大连击: <span id=\"tr-combo\">0</span></p>\n150\t          <p class=\"coins-earned\">🪙 +<span id=\"tr-coins\">0</span></p>\n151\t        </div>\n152\t        <div class=\"result-buttons\">\n153\t          <button class=\"btn btn-primary\" onclick=\"game.goToMenu()\">返回</button>\n154\t          <button class=\"btn btn-accent\" onclick=\"game.startTimedChallenge()\">再来一次</button>\n155\t        </div>\n156\t      </div>\n157\t    </div>\n158\t\n159\t    <!-- ===== W2: 成语图鉴 ===== -->\n160\t    <div id=\"collection-screen\" class=\"screen\">\n161\t      <div class=\"map-header\">\n162\t        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n163\t        <h2>成语图鉴</h2>\n164\t        <span id=\"col-progress\">0/0</span>\n165\t      </div>\n166\t      <div class=\"col-bar-wrap\">\n167\t        <div class=\"col-bar\"><div id=\"col-progress-bar\" class=\"col-bar-fill\"></div></div>\n168\t      </div>\n169\t      <input type=\"text\" id=\"col-search\" class=\"col-search\" placeholder=\"搜索成语/释义...\" autocomplete=\"off\" autocapitalize=\"none\" enterkeyhint=\"search\" oninput=\"handleColSearch(this.value)\">\n170\t      <div id=\"col-categories\" class=\"col-categories\"></div>\n171\t      <div id=\"col-grid\" class=\"col-grid\"></div>\n172\t      <div id=\"col-detail\" class=\"col-detail\" style=\"display:none\"></div>\n173\t    </div>\n174\t\n175\t    <!-- ===== W2: 每日系统 ===== -->\n176\t    <div id=\"daily-screen\" class=\"screen\">\n177\t      <div class=\"map-header\">\n178\t        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n179\t        <h2>📅 每日</h2>\n180\t      </div>\n181\t      <div class=\"daily-content\">\n182\t        <div class=\"daily-login\">\n183\t          <h3>每日签到</h3>\n184\t          <p>连续签到: <span id=\"daily-streak\" class=\"streak-num\">1</span> 天</p>\n185\t          <p>状态: <span id=\"daily-claimed\">未领取</span></p>\n186\t          <button id=\"daily-claim-btn\" class=\"btn btn-accent\" onclick=\"game.daily.claimLogin(); game.render()\">领取签到奖励</button>\n187\t          <button id=\"daily-double-btn\" class=\"btn btn-ad\" style=\"display:none\" onclick=\"handleDailyDouble()\">🎬 看视频翻倍</button>\n188\t        </div>\n189\t\n190\t        <div class=\"daily-section\">\n191\t          <h3>每日任务</h3>\n192\t          <div id=\"daily-tasks\" class=\"task-list\"></div>\n193\t        </div>\n194\t\n195\t        <div class=\"daily-section\">\n196\t          <h3>今日挑战</h3>\n197\t          <div id=\"daily-challenge\"></div>\n198\t        </div>\n199\t      </div>\n200\t    </div>\n201\t\n202\t    <!-- ===== W2: 好友PK ===== -->\n203\t    <div id=\"pk-screen\" class=\"screen\">\n204\t      <div class=\"game-header\">\n205\t        <button class=\"btn-back\" onclick=\"game.goToMenu()\">✕</button>\n206\t        <div class=\"header-center\">\n207\t          <span>好友PK</span>\n208\t          <span id=\"pk-progress\">1/5</span>\n209\t        </div>\n210\t        <div class=\"header-right\"></div>\n211\t      </div>\n212\t      <div class=\"game-body\">\n213\t        <div class=\"meaning-box\"><span id=\"pk-meaning\"></span></div>\n214\t        <div id=\"pk-slots\" class=\"slots-container\"></div>\n215\t        <div id=\"pk-candidates\" class=\"candidates-container\"></div>\n216\t      </div>\n217\t    </div>\n218\t\n219\t    <!-- W2: PK结果 -->\n220\t    <div id=\"pk-result-screen\" class=\"screen\">\n221\t      <div class=\"result-card\">\n222\t        <h2 id=\"pkr-result\" class=\"result-title\">结果</h2>\n223\t        <div class=\"result-stats\">\n224\t          <p>正确: <span id=\"pkr-correct\">0/5</span></p>\n225\t          <p>用时: <span id=\"pkr-time\">0s</span></p>\n226\t          <p class=\"coins-earned\"><span id=\"pkr-reward\"></span></p>\n227\t        </div>\n228\t        <div id=\"pkr-answers\" class=\"pk-answers\"></div>\n229\t        <div class=\"result-buttons\">\n230\t          <button class=\"btn btn-primary\" onclick=\"game.goToMenu()\">返回</button>\n231\t          <button class=\"btn btn-secondary\" onclick=\"game.social.sharePKResult(game.pk.getResult())\">分享结果</button>\n232\t          <button class=\"btn btn-accent\" onclick=\"game.startPK()\">再来一局</button>\n233\t        </div>\n234\t      </div>\n235\t    </div>\n236\t\n237\t    <!-- ===== W2: 角色 ===== -->\n238\t    <div id=\"characters-screen\" class=\"screen\">\n239\t      <div class=\"map-header\">\n240\t        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n241\t        <h2>👤 角色选择</h2>\n242\t      </div>\n243\t      <div id=\"char-grid\" class=\"char-grid\"></div>\n244\t      <div id=\"char-detail\" class=\"char-detail\"></div>\n245\t    </div>\n246\t  </div>\n247\t\n248\t  <script src=\"src/js/IdiomDBExtra.js\"></script>\n249\t  <script src=\"src/js/IdiomDB.js\"></script>\n250\t  <script src=\"src/js/levels.js\"></script>\n251\t  <script src=\"src/js/IdiomEngine.js\"></script>\n252\t  <script src=\"src/js/Judge.js\"></script>\n253\t  <script src=\"src/js/ComboSystem.js\"></script>\n254\t  <script src=\"src/js/DataManager.js\"></script>\n255\t  <script src=\"src/js/AudioManager.js\"></script>\n256\t  <script src=\"src/js/Tutorial.js\"></script>\n257\t  <!-- W2 modules -->\n258\t  <script src=\"src/js/TimedChallenge.js\"></script>\n259\t  <script src=\"src/js/IdiomCollection.js\"></script>\n260\t  <script src=\"src/js/DailySystem.js\"></script>\n261\t  <script src=\"src/js/PKMode.js\"></script>\n262\t  <script src=\"src/js/SocialManager.js\"></script>\n263\t  <script src=\"src/js/Characters.js\"></script>\n264\t  <!-- W3 modules -->\n265\t  <script src=\"src/js/ad-config.js\"></script>\n266\t  <script src=\"src/js/AdManager.js\"></script>\n267\t  <script src=\"src/js/Analytics.js\"></script>\n268\t  <script src=\"src/js/Game.js\"></script>\n269\t  <script src=\"src/js/Renderer.js\"></script>\n270\t  <script>\n271\t    const game = new Game();\n272\t    game.audio.init();\n273\t    renderUI(game);\n274\t  </script>\n275\t</body>\n276\t</html>\n277\t"}]},"parent_tool_use_id":null,"session_id":"7463fb62-2e03-4edd-abad-466ff792dff1","uuid":"0cdd97de-bd25-494d-9874-e4acd5a23583","timestamp":"2026-05-23T10:38:02.985Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/index.html","content":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n  <title>成语大闯关 - Idiom Master</title>\n  <link rel=\"stylesheet\" href=\"src/css/style.css\">\n</head>\n<body>\n  <div id=\"app\">\n    <!-- 主菜单 -->\n    <div id=\"menu-screen\" class=\"screen active\">\n      <div class=\"menu-bg\">\n        <div class=\"title-block\">\n          <h1 class=\"title\">成语大闯关</h1>\n          <p class=\"subtitle\">Idiom Master</p>\n        </div>\n        <div class=\"menu-stats\">\n          <span class=\"stat-item\" id=\"menu-avatar\">👦</span>\n          <span class=\"stat-item\">🪙 <span id=\"menu-coins\">0</span></span>\n          <span class=\"stat-item\">📖 <span id=\"menu-collected\">0</span>成语</span>\n        </div>\n        <div class=\"menu-buttons\">\n          <button class=\"btn btn-primary\" onclick=\"game.showLevelMap()\">闯关模式</button>\n          <button class=\"btn btn-secondary\" onclick=\"game.startTimedChallenge()\">限时挑战</button>\n          <button class=\"btn btn-accent\" onclick=\"game.startPK()\">好友PK</button>\n        </div>\n        <div class=\"menu-row\">\n          <button class=\"btn btn-outline\" onclick=\"game.showCollection()\">📖 成语图鉴</button>\n          <button class=\"btn btn-outline\" onclick=\"game.showDaily()\">📅 每日</button>\n          <button class=\"btn btn-outline\" onclick=\"game.showCharacters()\">👤 角色</button>\n        </div>\n        <div class=\"menu-footer\">\n          <button class=\"btn-icon\" onclick=\"game.audio.toggle(); this.textContent = game.audio.enabled ? '🔊' : '🔇'\">🔊</button>\n          <button class=\"btn-icon\" onclick=\"game.data.reset(); location.reload()\">🔄</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- 关卡地图 -->\n    <div id=\"map-screen\" class=\"screen\">\n      <div class=\"map-header\">\n        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n        <h2>选择关卡</h2>\n        <span>🪙 <span id=\"map-coins\">0</span></span>\n      </div>\n      <div id=\"chapter-info\" class=\"chapter-info\"></div>\n      <div id=\"level-grid\" class=\"level-grid\"></div>\n    </div>\n\n    <!-- 游戏界面 -->\n    <div id=\"game-screen\" class=\"screen\">\n      <div class=\"game-header\">\n        <button class=\"btn-back\" onclick=\"game.goToMenu()\">✕</button>\n        <div class=\"header-center\">\n          <span id=\"level-label\">第1关</span>\n          <span id=\"progress-label\">1/10</span>\n        </div>\n        <div class=\"header-right\">\n          <span id=\"lives-display\">❤️❤️❤️❤️❤️</span>\n        </div>\n      </div>\n\n      <div class=\"game-body\">\n        <div id=\"combo-display\" class=\"combo-display\"></div>\n        <div id=\"meaning-box\" class=\"meaning-box\">\n          <span id=\"meaning-text\"></span>\n        </div>\n        <div id=\"slots-container\" class=\"slots-container\"></div>\n        <div id=\"idiom-hint\" class=\"idiom-hint\"></div>\n        <div id=\"candidates-container\" class=\"candidates-container\"></div>\n      </div>\n\n      <div class=\"game-footer\">\n        <button class=\"tool-btn\" onclick=\"handleHintReveal()\">📖 揭示 (5🪙)</button>\n        <button class=\"tool-btn\" onclick=\"handleHintRemove()\">✂️ 去干扰 (5🪙)</button>\n        <button class=\"tool-btn\" onclick=\"handleSkip()\">⏭ 跳过 (10🪙)</button>\n      </div>\n\n      <!-- 教学覆盖层 -->\n      <div id=\"tutorial-overlay\" class=\"tutorial-overlay\" style=\"display:none\">\n        <div class=\"tutorial-arrow\"></div>\n        <div id=\"tutorial-text\" class=\"tutorial-text\"></div>\n      </div>\n    </div>\n\n    <!-- 结算界面 -->\n    <div id=\"result-screen\" class=\"screen\">\n      <div class=\"result-card\">\n        <h2 id=\"result-title\" class=\"result-title\">通关!</h2>\n        <div id=\"result-stars\" class=\"result-stars\"></div>\n        <div class=\"result-stats\">\n          <p>正确: <span id=\"result-correct\">0</span> / <span id=\"result-total\">10</span></p>\n          <p>得分: <span id=\"result-score\">0</span></p>\n          <p>最大连击: <span id=\"result-combo\">0</span></p>\n          <p class=\"coins-earned\">🪙 +<span id=\"result-coins\">0</span></p>\n        </div>\n        <div class=\"result-buttons\">\n          <button class=\"btn btn-primary\" onclick=\"game.goToMenu()\">返回地图</button>\n          <button class=\"btn btn-secondary\" id=\"btn-retry\" onclick=\"game.startLevel(game.currentLevel.id)\">重新挑战</button>\n          <button class=\"btn btn-accent\" id=\"btn-next\" onclick=\"game.startLevel(game.currentLevel.id + 1)\">下一关</button>\n          <button class=\"btn btn-ad\" id=\"btn-double\" style=\"display:none\" onclick=\"handleDoubleReward()\">🎬 看视频领取 ×2</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- 续命弹窗 -->\n    <div id=\"continue-modal\" class=\"modal\" style=\"display:none\">\n      <div class=\"modal-content\">\n        <h3>挑战失败</h3>\n        <p>生命值耗尽了！</p>\n        <div class=\"modal-buttons\">\n          <button class=\"btn btn-secondary\" onclick=\"game.finishLevel(); document.getElementById('continue-modal').style.display='none'\">放弃</button>\n          <button class=\"btn btn-ad\" onclick=\"game.continueWithAd()\">🎬 看视频续命 ❤️×3</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- ===== W2: 限时挑战 ===== -->\n    <div id=\"timed-screen\" class=\"screen\">\n      <div class=\"game-header\">\n        <button class=\"btn-back\" onclick=\"game.timed.end();game.goToMenu()\">✕</button>\n        <div class=\"header-center\">\n          <span id=\"timed-timer\" class=\"timer-display\">60s</span>\n        </div>\n        <div class=\"header-right\">\n          <span>得分: <span id=\"timed-score\">0</span></span>\n        </div>\n      </div>\n      <div class=\"game-body\">\n        <div id=\"timed-combo\" class=\"combo-display\"></div>\n        <div class=\"meaning-box\"><span id=\"timed-meaning\"></span></div>\n        <div id=\"timed-slots\" class=\"slots-container\"></div>\n        <div id=\"timed-candidates\" class=\"candidates-container\"></div>\n      </div>\n      <div class=\"game-footer\">\n        <button class=\"tool-btn\" onclick=\"game.timed.useHintReveal()\">📖 揭示</button>\n        <button class=\"tool-btn\" onclick=\"game.timed.useHintRemove()\">✂️ 去干扰</button>\n      </div>\n    </div>\n\n    <!-- W2: 限时挑战结算 -->\n    <div id=\"timed-result-screen\" class=\"screen\">\n      <div class=\"result-card\">\n        <h2 class=\"result-title\">⏱ 限时挑战结束</h2>\n        <div class=\"result-stats\">\n          <p>得分: <span id=\"tr-score\">0</span></p>\n          <p>正确: <span id=\"tr-correct\">0</span> / <span id=\"tr-total\">0</span></p>\n          <p>最大连击: <span id=\"tr-combo\">0</span></p>\n          <p class=\"coins-earned\">🪙 +<span id=\"tr-coins\">0</span></p>\n        </div>\n        <div class=\"result-buttons\">\n          <button class=\"btn btn-primary\" onclick=\"game.goToMenu()\">返回</button>\n          <button class=\"btn btn-accent\" onclick=\"game.startTimedChallenge()\">再来一次</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- ===== W2: 成语图鉴 ===== -->\n    <div id=\"collection-screen\" class=\"screen\">\n      <div class=\"map-header\">\n        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n        <h2>成语图鉴</h2>\n        <span id=\"col-progress\">0/0</span>\n      </div>\n      <div class=\"col-bar-wrap\">\n        <div class=\"col-bar\"><div id=\"col-progress-bar\" class=\"col-bar-fill\"></div></div>\n      </div>\n      <input type=\"text\" id=\"col-search\" class=\"col-search\" placeholder=\"搜索成语/释义...\" autocomplete=\"off\" autocapitalize=\"none\" enterkeyhint=\"search\" oninput=\"handleColSearch(this.value)\">\n      <div id=\"col-categories\" class=\"col-categories\"></div>\n      <div id=\"col-grid\" class=\"col-grid\"></div>\n      <div id=\"col-detail\" class=\"col-detail\" style=\"display:none\"></div>\n    </div>\n\n    <!-- ===== W2: 每日系统 ===== -->\n    <div id=\"daily-screen\" class=\"screen\">\n      <div class=\"map-header\">\n        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n        <h2>📅 每日</h2>\n      </div>\n      <div class=\"daily-content\">\n        <div class=\"daily-login\">\n          <h3>每日签到</h3>\n          <p>连续签到: <span id=\"daily-streak\" class=\"streak-num\">1</span> 天</p>\n          <p>状态: <span id=\"daily-claimed\">未领取</span></p>\n          <button id=\"daily-claim-btn\" class=\"btn btn-accent\" onclick=\"game.daily.claimLogin(); game.render()\">领取签到奖励</button>\n          <button id=\"daily-double-btn\" class=\"btn btn-ad\" style=\"display:none\" onclick=\"handleDailyDouble()\">🎬 看视频翻倍</button>\n        </div>\n\n        <div class=\"daily-section\">\n          <h3>每日任务</h3>\n          <div id=\"daily-tasks\" class=\"task-list\"></div>\n        </div>\n\n        <div class=\"daily-section\">\n          <h3>今日挑战</h3>\n          <div id=\"daily-challenge\"></div>\n        </div>\n      </div>\n    </div>\n\n    <!-- ===== W2: 好友PK ===== -->\n    <div id=\"pk-screen\" class=\"screen\">\n      <div class=\"game-header\">\n        <button class=\"btn-back\" onclick=\"game.goToMenu()\">✕</button>\n        <div class=\"header-center\">\n          <span>好友PK</span>\n          <span id=\"pk-progress\">1/5</span>\n        </div>\n        <div class=\"header-right\"></div>\n      </div>\n      <div class=\"game-body\">\n        <div class=\"meaning-box\"><span id=\"pk-meaning\"></span></div>\n        <div id=\"pk-slots\" class=\"slots-container\"></div>\n        <div id=\"pk-candidates\" class=\"candidates-container\"></div>\n      </div>\n    </div>\n\n    <!-- W2: PK结果 -->\n    <div id=\"pk-result-screen\" class=\"screen\">\n      <div class=\"result-card\">\n        <h2 id=\"pkr-result\" class=\"result-title\">结果</h2>\n        <div class=\"result-stats\">\n          <p>正确: <span id=\"pkr-correct\">0/5</span></p>\n          <p>用时: <span id=\"pkr-time\">0s</span></p>\n          <p class=\"coins-earned\"><span id=\"pkr-reward\"></span></p>\n        </div>\n        <div id=\"pkr-answers\" class=\"pk-answers\"></div>\n        <div class=\"result-buttons\">\n          <button class=\"btn btn-primary\" onclick=\"game.goToMenu()\">返回</button>\n          <button class=\"btn btn-secondary\" onclick=\"game.social.sharePKResult(game.pk.getResult())\">分享结果</button>\n          <button class=\"btn btn-accent\" onclick=\"game.startPK()\">再来一局</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- ===== W2: 角色 ===== -->\n    <div id=\"characters-screen\" class=\"screen\">\n      <div class=\"map-header\">\n        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n        <h2>👤 角色选择</h2>\n      </div>\n      <div id=\"char-grid\" class=\"char-grid\"></div>\n      <div id=\"char-detail\" class=\"char-detail\"></div>\n    </div>\n  </div>\n\n  <script src=\"src/js/IdiomDBExtra.js\"></script>\n  <script src=\"src/js/IdiomDB.js\"></script>\n  <script src=\"src/js/levels.js\"></script>\n  <script src=\"src/js/IdiomEngine.js\"></script>\n  <script src=\"src/js/Judge.js\"></script>\n  <script src=\"src/js/ComboSystem.js\"></script>\n  <script src=\"src/js/DataManager.js\"></script>\n  <script src=\"src/js/AudioManager.js\"></script>\n  <script src=\"src/js/Tutorial.js\"></script>\n  <!-- W2 modules -->\n  <script src=\"src/js/TimedChallenge.js\"></script>\n  <script src=\"src/js/IdiomCollection.js\"></script>\n  <script src=\"src/js/DailySystem.js\"></script>\n  <script src=\"src/js/PKMode.js\"></script>\n  <script src=\"src/js/SocialManager.js\"></script>\n  <script src=\"src/js/Characters.js\"></script>\n  <!-- W3 modules -->\n  <script src=\"src/js/ad-config.js\"></script>\n  <script src=\"src/js/AdManager.js\"></script>\n  <script src=\"src/js/Analytics.js\"></script>\n  <script src=\"src/js/Game.js\"></script>\n  <script src=\"src/js/Renderer.js\"></script>\n  <script>\n    const game = new Game();\n    game.audio.init();\n    renderUI(game);\n  </script>\n</body>\n</html>\n","numLines":277,"startLine":1,"totalLines":277}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_eee3b0d02d594f1280bde7ca","type":"tool_result","content":"1\t# 成语大闯关（Idiom Master）— 详细立项文档\n2\t\n3\t> **版本**：1.0 | **日期**：2026-05-23 | **设计师**：游戏设计师 Agent\n4\t> **状态**：立项 — 待开发评审\n5\t> **关联文档**：[[douyin-mini-games-blueprint.md]] — 平台调研与初始概念；[[../douyin-match3/GDD.md]] — 三消游戏框架（可复用组件）\n6\t\n7\t---\n8\t\n9\t## 一、项目概览\n10\t\n11\t| 字段 | 值 |\n12\t|------|-----|\n13\t| 游戏名称 | 成语大闯关（Idiom Master） |\n14\t| 品类 | 文字益智（Word Puzzle） |\n15\t| 目标平台 | 抖音小游戏（优先）→ 微信小游戏 → H5 |\n16\t| 核心差异化 | 中文成语专项（蓝海品类）+ 抖音社交竞赛 + 轻量社交裂变 |\n17\t| 开发周期 | 3 周（单人全栈，含提审） |\n18\t| 目标 DAU | 首发 3K → 3 个月 30K |\n19\t| 变现模式 | IAA 为主（激励视频 + 插屏），后续叠加 IAP（皮肤/道具） |\n20\t| 包体目标 | < 2MB（纯文字 + 少量图标，极轻量） |\n21\t| 软著申请 | 与三消游戏同步，复用同一主体 |\n22\t\n23\t### 设计支柱（不可妥协）\n24\t\n25\t1. **15 秒内上手** — 看一眼就知道怎么玩，答题 = 点击选字，零解释\n26\t2. **每题都是微成就感** — 正确动画 + 连击 + 释义弹出，持续刺激\"我很聪明\"的满足感\n27\t3. **知识 = 社交货币** — 成绩可炫耀，PK 可分享，失败可求助，天然传播动力\n28\t4. **极低开发成本** — 纯文字渲染，无美术依赖，复用三消游戏的广告/社交/经济框架\n29\t\n30\t---\n31\t\n32\t## 二、竞品分析\n33\t\n34\t### 2.1 抖音热门成语游戏\n35\t\n36\t| 竞品 | 品类 | 核心玩法 | 日活估算 | 优势 | 短板 |\n37\t|------|------|----------|----------|------|------|\n38\t| **成语小秀才** | 文字益智 | 选字组词 + 官职升级 | 50K+ | 官职系统驱动长期留存 | 美术简陋，社交弱 |\n39\t| **成语大挑战** | 文字益智 | 看图猜成语 | 30K+ | 图文结合有新意 | 图片包体大，题库有限 |\n40\t| **疯狂猜成语** | 问答 | 图片/emoji 猜成语 | 20K+ | 短视频传播力强 | 题目质量参差不齐 |\n41\t| **成语消消乐** | 混合 | 三消 + 成语 | 10K+ | 创新融合 | 两套系统互相干扰 |\n42\t\n43\t### 2.2 竞品共性问题\n44\t\n45\t1. **社交裂变浅** — 大多只有分享领金币，缺乏深度互动\n46\t2. **内容运营弱** — 题库静态不更新，老玩家很快刷完\n47\t3. **变现设计粗暴** — 广告弹出频繁，严重影响体验\n48\t4. **视觉风格统一差** — 大多采用模板化 UI，无品牌辨识度\n49\t\n50\t### 2.3 我们的差异化策略\n51\t\n52\t| 维度 | 竞品做法 | 我们的做法 |\n53\t|------|----------|-----------|\n54\t| 核心玩法 | 单一模式 | 闯关 + 限时 + PK 三模式 |\n55\t| 社交 | 分享领金币 | 好友 PK + 求助 + 每日挑战排行 |\n56\t| 内容运营 | 固定题库 | 每周更新 + 玩家投稿 + AI 扩充 |\n57\t| 变现 | 强制广告 | 70%+ 激励视频（用户主动选择） |\n58\t| 视觉 | 模板 UI | 国风主题 + 角色皮肤系统 |\n59\t| 长期留存 | 无 | 成语图鉴收集 + 称号系统 + 角色养成 |\n60\t\n61\t---\n62\t\n63\t## 三、核心玩法机制设计\n64\t\n65\t### 3.1 基本规则\n66\t\n67\t- 屏幕上方显示成语的**释义**（如\"形容非常开心\"）\n68\t- 中间显示 **4 个空位**（组成完整成语）\n69\t- 下方显示 **8-12 个候选字**（含 4 个正确字 + 干扰字）\n70\t- 玩家**依次点击** 4 个正确字，按正确顺序填入空位\n71\t- 答对 → 绿色闪光 + 释义弹出 + 连击 +1 → 下一题\n72\t- 答错 → 红色抖动 + 字飞回 + 失去 1 条命（初始 5 条命）\n73\t\n74\t### 3.2 出题引擎规格\n75\t\n76\t```\n77\t输入：成语数据库（idioms.json）+ 难度等级 + 关卡配置\n78\t输出：一道完整的成语题\n79\t\n80\t算法：\n81\t1. 根据关卡难度等级，从题库中随机选取一个成语\n82\t2. 生成干扰字池：\n83\t   a. 优先从同类别成语中取字（如动物类成语取动物相关字）\n84\t   b. 补充形近字（如\"己\"/\"已\"/\"巳\"）\n85\t   c. 补充音近字（如\"画\"/\"话\"）\n86\t   d. 确保干扰字与正确字不重复\n87\t3. 将正确字 + 干扰字随机排列（8-12 个）\n88\t4. 记录正确答案的索引顺序（用于判定）\n89\t\n90\t干扰字数量规则：\n91\t- ★ 简单：4 正确 + 4 干扰 = 8 候选\n92\t- ★★ 中等：4 正确 + 6 干扰 = 10 候选\n93\t- ★★★ 困难：4 正确 + 8 干扰 = 12 候选\n94\t- ★★★★ 大师：4 正确 + 8 干扰 = 12 候选（干扰字更相似）\n95\t\n96\t性能要求：出题 < 10ms（纯内存操作）\n97\t```\n98\t\n99\t### 3.3 答题判定逻辑\n100\t\n101\t```\n102\t状态：4 个空位 slot[0..3]，当前已填 fillCount\n103\t玩家点击候选字 candidate[i]：\n104\t  → 候选字飞入 slot[fillCount]\n105\t  → fillCount++\n106\t  → 如果 fillCount == 4：\n107\t      → 检查 slot[0..3] 是否等于 idiom.chars[0..3]\n108\t      → 正确：触发\"正确\"动画链\n109\t      → 错误：触发\"错误\"动画链，slot 清空，fillCount = 0\n110\t  → 如果 fillCount < 4：\n111\t      → 等待继续点击\n112\t\n113\t撤销机制：\n114\t  → 点击已填入的 slot[i]：该字飞回候选区，后续 slot 自动左移\n115\t  → 仅在\"撤销提示\"道具激活时可用（默认不可撤销已填字）\n116\t```\n117\t\n118\t### 3.4 三种游戏模式\n119\t\n120\t#### 模式一：闯关模式（核心进度）\n121\t\n122\t| 规则 | 说明 |\n123\t|------|------|\n124\t| 每关题数 | 10 题 |\n125\t| 生命值 | 初始 5 条命 |\n126\t| 通关条件 | 答完 10 题（允许使用提示/跳过） |\n127\t| 星级评定 | 按正确率：≥9 对 = 3 星，≥7 对 = 2 星，≥5 对 = 1 星 |\n128\t| 失败条件 | 生命值归零 |\n129\t| 难度递进 | 每 10 关提升一个难度等级 |\n130\t\n131\t#### 模式二：限时挑战\n132\t\n133\t| 规则 | 说明 |\n134\t|------|------|\n135\t| 时间 | 60 秒倒计时 |\n136\t| 题目 | 无限出题，难度随机（偏中等） |\n137\t| 得分 | 每题基础 100 分 + 连击加成（连击数 × 20） |\n138\t| 结束 | 倒计时结束 → 结算 |\n139\t| 排行榜 | 全局 + 好友 |\n140\t\n141\t#### 模式三：好友 PK\n142\t\n143\t| 规则 | 说明 |\n144\t|------|------|\n145\t| 题数 | 5 题 |\n146\t| 机制 | 双方答相同题目，互不知对方进度 |\n147\t| 胜负 | 正确率高者胜；相同则比用时 |\n148\t| 奖励 | 胜者 +50 金币 + 1 PK 积分 |\n149\t| 裂变 | PK 结果页 → 一键分享到抖音 |\n150\t\n151\t### 3.5 连击系统（核心爽感来源）\n152\t\n153\t```\n154\t连续答对触发连击：\n155\t- 3 连击：+60 分加成 → \"不错！\" 文字弹出 + 音效升调\n156\t- 5 连击：+100 分加成 → \"厉害了！\" + 屏幕微震 + 粒子特效\n157\t- 8 连击：+160 分加成 → \"学霸！\" + 全屏金色光效\n158\t- 10+ 连击：+200+ 分加成 → \"成语大师！！\" + 烟花特效 + 额外 1 金币\n159\t\n160\t连击断裂：\n161\t- 答错或使用跳过 → 连击归零\n162\t- 使用提示答对 → 连击继续，但本题不计加分\n163\t\n164\t动画时间预算（单题交互总时间不超过 1.5 秒）：\n165\t- 点击填字：0.15s\n166\t- 正确动画：0.4s（绿色闪光 + 释义弹出）\n167\t- 错误动画：0.5s（红色抖动 + 字飞回）\n168\t- 连击特效：0.3s（叠加在正确动画上）\n169\t```\n170\t\n171\t### 3.6 失败与续命\n172\t\n173\t| 事件 | 玩家选择 | 结果 |\n174\t|------|----------|------|\n175\t| 生命值归零 | 看激励视频（30s） | 恢复 3 条命，可续命 1 次 |\n176\t| 生命值归零 | 使用 10 金币购买 | 恢复 3 条命 |\n177\t| 生命值归零 | 放弃 | 回到关卡地图，保留已获星星 |\n178\t\n179\t---\n180\t\n181\t## 四、关卡系统设计（首发 50 关）\n182\t\n183\t### 4.1 关卡数据结构\n184\t\n185\t```json\n186\t{\n187\t  \"id\": 1,\n188\t  \"chapter\": 1,\n189\t  \"difficulty\": 1,\n190\t  \"questions\": 10,\n191\t  \"lives\": 5,\n192\t  \"stars\": [5, 7, 9],\n193\t  \"reward\": { \"coins\": 20, \"exp\": 10 },\n194\t  \"idiom_pool\": [\"easy_01\", \"easy_02\"],\n195\t  \"category\": [\"常用\", \"动物\"],\n196\t  \"tutorial_step\": \"T1\"\n197\t}\n198\t```\n199\t\n200\t| 字段 | 类型 | 说明 |\n201\t|------|------|------|\n202\t| id | int | 关卡编号 |\n203\t| chapter | int | 章节编号 |\n204\t| difficulty | int | 难度等级（1-4） |\n205\t| questions | int | 题目数量 |\n206\t| lives | int | 初始生命 |\n207\t| stars | int[3] | 1/2/3 星正确数阈值 |\n208\t| reward | object | 通关奖励（金币 + 经验） |\n209\t| idiom_pool | string[] | 本关出题池（可选，为空则按难度随机） |\n210\t| category | string[] | 成语类别限制 |\n211\t| tutorial_step | string/null | 关联教学步骤 |\n212\t\n213\t### 4.2 前 50 关详细设计\n214\t\n215\t#### 第 1-5 关：新手教学（零失败区）\n216\t\n217\t| 关卡 | 难度 | 生命 | 星级阈值 | 候选字数 | 教学内容 |\n218\t|------|------|------|----------|----------|----------|\n219\t| 1 | ★ | 5 | [3, 4, 5] | 8 | 强制引导：高亮正确字，引导逐字点击 |\n220\t| 2 | ★ | 5 | [3, 4, 5] | 8 | 半引导：只提示第一个字 |\n221\t| 3 | ★ | 5 | [4, 5, 5] | 8 | 自由作答，成语极简（一心一意、画蛇添足等） |\n222\t| 4 | ★ | 5 | [4, 5, 5] | 8 | 引入释义提示按钮（免费） |\n223\t| 5 | ★ | 5 | [4, 5, 5] | 8 | 引入连击概念，连对 3 题触发特效 |\n224\t\n225\t**设计原则**：\n226\t- 前 5 关保证所有玩家都能 3 星通关\n227\t- 成语选取最常见的日常用语\n228\t- 释义用白话文，不用文言原文\n229\t- 每关第 1 题必是最简单的成语（如\"心花怒放\"）\n230\t\n231\t#### 第 6-15 关：简单进阶（建立习惯）\n232\t\n233\t| 关卡 | 难度 | 生命 | 星级阈值 | 新元素 |\n234\t|------|------|------|----------|--------|\n235\t| 6 | ★ | 5 | [5, 7, 9] | 标准规则 |\n236\t| 7 | ★ | 5 | [5, 7, 9] | 引入\"去干扰\"道具（首次免费） |\n237\t| 8 | ★ | 5 | [5, 7, 9] | 引入\"跳过\"功能 |\n238\t| 9 | ★ | 5 | [5, 7, 9] | — |\n239\t| 10 | ★ | 5 | [5, 7, 9] | Boss 关：10 题全对额外奖励 50 金币 |\n240\t| 11 | ★ | 4 | [5, 7, 9] | 生命值降至 4 |\n241\t| 12 | ★ | 4 | [5, 7, 9] | — |\n242\t| 13 | ★ | 4 | [5, 7, 9] | 引入双类别混合（动物+数字） |\n243\t| 14 | ★ | 4 | [5, 7, 9] | — |\n244\t| 15 | ★ | 4 | [5, 7, 9] | Boss 关：正确率 ≥80% 通关 |\n245\t\n246\t#### 第 16-30 关：中等难度（策略性增强）\n247\t\n248\t| 关卡段 | 难度 | 生命 | 候选字数 | 新元素 |\n249\t|--------|------|------|----------|--------|\n250\t| 16-20 | ★★ | 4 | 10 | 中等成语（望梅止渴、纸上谈兵等） |\n251\t| 21-25 | ★★ | 3 | 10 | 生命降至 3，需要更谨慎 |\n252\t| 26-30 | ★★ | 3 | 10 | 引入形近干扰（己/已、蓝/篮等） |\n253\t\n254\t#### 第 31-45 关：困难挑战（硬核考验）\n255\t\n256\t| 关卡段 | 难度 | 生命 | 候选字数 | 新元素 |\n257\t|--------|------|------|----------|--------|\n258\t| 31-35 | ★★★ | 3 | 12 | 困难成语（沆瀣一气、韦编三绝等） |\n259\t| 36-40 | ★★★ | 3 | 12 | 音近干扰（画/话、故/顾等） |\n260\t| 41-45 | ★★★ | 3 | 12 | 混合干扰（形近 + 音近） |\n261\t\n262\t#### 第 46-50 关：大师挑战（里程碑）\n263\t\n264\t| 关卡 | 难度 | 生命 | 特殊规则 |\n265\t|------|------|------|----------|\n266\t| 46-49 | ★★★★ | 3 | 生僻成语 + 最大干扰 + 无释义提示 |\n267\t| 50 | ★★★★ | 3 | Boss 关：12 题全对 = 传说称号 + 200 金币 |\n268\t\n269\t### 4.3 章节结构（每 10 关一个章节）\n270\t\n271\t| 章节 | 主题 | 关卡 | 视觉风格 |\n272\t|------|------|------|----------|\n273\t| 第一章 | 初学启蒙 | 1-10 | 书院·晨光（浅黄暖色） |\n274\t| 第二章 | 蒙学进阶 | 11-20 | 书院·午后（橙色暖调） |\n275\t| 第三章 | 经典成语 | 21-30 | 书院·夕阳（深橙红） |\n276\t| 第四章 | 典故深处 | 31-40 | 书院·月夜（深蓝紫） |\n277\t| 第五章 | 博学大师 | 41-50 | 书院·星辰（星空金黑） |\n278\t\n279\t### 4.4 关卡验证规则\n280\t\n281\t- 每关题池至少 15 个成语（10 个必答 + 5 个备用）\n282\t- 所有成语必须经过人工审核：释义准确、出处可查\n283\t- ★ 简单关成语必须在《新华字典》常用词表中\n284\t- 干扰字不能组成其他有效成语（避免歧义）\n285\t- Boss 关题目从固定池中选取（保证公平性）\n286\t\n287\t---\n288\t\n289\t## 五、角色/皮肤系统\n290\t\n291\t### 5.1 角色（导师系统）\n292\t\n293\t| 角色 | 主题 | 技能 | 获取方式 |\n294\t|------|------|------|----------|\n295\t| **书童小明** | 基础 | 答错时有 20% 概率不扣命 | 初始角色 |\n296\t| **才女小红** | 中等 | 每关首次使用提示不消耗次数 | 通过 20 关解锁 |\n297\t| **状元先生** | 高级 | 连击加分 ×1.5 倍 | 收集 80 碎片兑换 |\n298\t| **诗仙李白** | 稀有 | 答对时额外获得 1 经验 | 月卡/活动限定 |\n299\t\n300\t### 5.2 角色皮肤（视觉自定义）\n301\t\n302\t| 皮肤 | 风格 | 获取方式 | 价格 |\n303\t|------|------|----------|------|\n304\t| 经典蓝袍 | 默认 | 初始 | 免费 |\n305\t| 红色喜庆 | 节日风 | 春节活动 | 限时 |\n306\t| 青绿山水 | 国风 | 图鉴收集 100 个成语 | 100 金币 |\n307\t| 金色荣耀 | 奢华 | PK 积分达到 100 | 200 金币 |\n308\t| Q版萌趣 | 可爱 | 首次充值（后续） | ¥6 |\n309\t\n310\t### 5.3 背景皮肤（答题界面背景）\n311\t\n312\t| 背景 | 风格 | 获取 |\n313\t|------|------|------|\n314\t| 水墨竹影 | 国风淡雅 | 初始 |\n315\t| 春日桃林 | 花开满屏 | 通关第 2 章 |\n316\t| 秋月寒江 | 冷色调 | 通关第 3 章 |\n317\t| 星河夜空 | 梦幻 | 通关第 4 章 |\n318\t| 古典书斋 | 木质纹理 | 收集 200 个成语 |\n319\t\n320\t---\n321\t\n322\t## 六、社交裂变机制\n323\t\n324\t### 6.1 好友 PK 挑战（核心裂变）\n325\t\n326\t```\n327\t流程：\n328\t1. 玩家 A 在 PK 模式中选择好友 → 生成挑战链接\n329\t2. 分享到抖音（视频/消息）\n330\t3. 玩家 B 点击链接 → 进入游戏 → 答相同 5 题\n331\t4. 双方各答完 → 揭晓结果\n332\t5. 结果页：\n333\t   - 胜方：胜利动画 + 奖杯 + \"+50 金币\"\n334\t   - 败方：鼓励文字 + \"不服？再来一局\" → 分享按钮\n335\t6. 核心裂变：不服输 → 再来 → 分享给更多人\n336\t\n337\tPK 积分系统：\n338\t- 胜 +3 分，平 +1 分，负 +0 分\n339\t- 每周重置排行\n340\t- 前 10 名获得称号 + 金币奖励\n341\t```\n342\t\n343\t### 6.2 \"你能全对吗？\" 短视频分享\n344\t\n345\t```\n346\t触发条件：连对 5+ 题 / 通关 Boss 关 / PK 胜利\n347\t自动生成 15 秒短视频：\n348\t  - 答题过程回放（加速 ×2）\n349\t  - 连击特效叠加\n350\t  - 最终得分 + \"你能超越我吗？\"\n351\t一键分享到抖音 → 带游戏入口链接\n352\t```\n353\t\n354\t### 6.3 求助好友\n355\t\n356\t```\n357\t触发条件：答错且只剩 1 条命\n358\t选项：\"求助好友\" → 生成分享卡片\n359\t好友点击 → 好友获得 10 金币 + 玩家恢复 1 条命\n360\t每日求助上限：3 次\n361\t```\n362\t\n363\t### 6.4 每日成语挑战\n364\t\n365\t```\n366\t每天 1 道特殊题（全平台统一）：\n367\t  - 成语 + 图片提示（如一张画了蛇和脚的图 → 画蛇添足）\n368\t  - 或：emoji 组合猜成语\n369\t  - 难度偏中高\n370\t  - 全平台排行榜：\"今日全对率：23%\"\n371\t  - FOMO 驱动：\"只有 12% 的人答对了今天的题目\"\n372\t\n373\t奖励：\n374\t  - 答对：50 金币 + 1 碎片\n375\t  - 分享答题结果到抖音：额外 20 金币\n376\t```\n377\t\n378\t### 6.5 好友排行榜\n379\t\n380\t```\n381\t维度：\n382\t  - 闯关进度（已通关数）\n383\t  - 限时挑战最高分\n384\t  - PK 积分\n385\t  - 图鉴收集数\n386\t使用 tt.getFriendCloudStorage() 实时获取好友数据\n387\t```\n388\t\n389\t---\n390\t\n391\t## 七、变现方案\n392\t\n393\t### 7.1 广告收入（IAA — 主力）\n394\t\n395\t#### 广告位详细设计\n396\t\n397\t**广告位 1：揭示 1 字（激励视频）**\n398\t\n399\t| 属性 | 值 |\n400\t|------|-----|\n401\t| 触发条件 | 答题中，玩家点击\"揭示\"按钮 |\n402\t| 广告类型 | 激励视频（穿山甲 rewardedVideoAd） |\n403\t| 视频时长 | 15-30 秒 |\n404\t| 用户奖励 | 自动填入第 1 个正确字 |\n405\t| UI 设计 | 答题区上方小按钮：\"揭示 1 字 📖\" + 播放图标 |\n406\t| 预估触发率 | 每关使用 1-2 次，约 60-70% 玩家会使用 |\n407\t\n408\t**广告位 2：去干扰（激励视频）**\n409\t\n410\t| 属性 | 值 |\n411\t|------|-----|\n412\t| 触发条件 | 答题中，玩家点击\"去干扰\"按钮 |\n413\t| 广告类型 | 激励视频 |\n414\t| 用户奖励 | 移除 2 个错误候选字 |\n415\t| UI 设计 | 候选字区下方按钮：\"去掉 2 个 ✂️\" |\n416\t| 预估触发率 | 每关 1-2 次，约 50% 玩家使用 |\n417\t\n418\t**广告位 3：双倍结算（激励视频）**\n419\t\n420\t| 属性 | 值 |\n421\t|------|-----|\n422\t| 触发条件 | 关卡结算页 |\n423\t| 广告类型 | 激励视频 |\n424\t| 用户奖励 | 本关金币奖励翻倍 |\n425\t| UI 设计 | 结算页底部：\"领取 ×1\" vs \"看视频领取 ×2\" |\n426\t| 预估触发率 | 55-65%（成功心情好，接受度高） |\n427\t\n428\t**广告位 4：额外生命（激励视频）**\n429\t\n430\t| 属性 | 值 |\n431\t|------|-----|\n432\t| 触发条件 | 生命值归零，游戏结束 |\n433\t| 广告类型 | 激励视频 |\n434\t| 用户奖励 | 恢复 3 条命，继续答题 |\n435\t| UI 设计 | 失败弹窗：左侧\"结束\"，右侧\"看视频继续\"（金色高亮） |\n436\t| 预估触发率 | 70-80%（沉没成本高，续命意愿强） |\n437\t\n438\t**广告位 5：关卡间插屏**\n439\t\n440\t| 属性 | 值 |\n441\t|------|-----|\n442\t| 触发条件 | 每通过 2 关后，结算页 → 返回地图时 |\n443\t| 广告类型 | 插屏广告（5 秒后可关闭） |\n444\t| 用户奖励 | 无 |\n445\t| UI 设计 | 全屏展示，右上角 5 秒倒计时 |\n446\t| 预估频率 | 2-3 次/天 |\n447\t\n448\t**广告位 6：每日签到翻倍**\n449\t\n450\t| 属性 | 值 |\n451\t|------|-----|\n452\t| 触发条件 | 每日登录签到时 |\n453\t| 广告类型 | 激励视频 |\n454\t| 用户奖励 | 今日签到奖励翻倍 |\n455\t\n456\t### 7.2 广告频率控制（防骚扰）\n457\t\n458\t```\n459\t规则：\n460\t- 同一广告位两次触发最小间隔：90 秒\n461\t- 激励视频每日总上限：15 次\n462\t- 插屏广告每日总上限：8 次\n463\t- 连续 2 次失败后暂停插屏展示\n464\t- 新用户前 3 关不展示任何广告\n465\t- 限时挑战模式不展示插屏（沉浸体验）\n466\t```\n467\t\n468\t### 7.3 收入预估\n469\t\n470\t| DAU | 激励视频/DAU | 插屏/DAU | 激励 eCPM | 插屏 eCPM | 日收入 | 月收入 |\n471\t|-----|-------------|----------|-----------|-----------|--------|--------|\n472\t| 3K | 4 次 | 2 次 | ¥80 | ¥35 | ¥1,020 | ¥30,600 |\n473\t| 10K | 4 次 | 2 次 | ¥80 | ¥35 | ¥3,400 | ¥102,000 |\n474\t| 30K | 4 次 | 2 次 | ¥80 | ¥35 | ¥10,200 | ¥306,000 |\n475\t\n476\t> ARPU ≈ ¥0.34/天\n477\t\n478\t**扣除平台分成（40%）后开发者实得：月 ¥18,360（3K DAU）/ ¥61,200（10K DAU）/ ¥183,600（30K DAU）**\n479\t\n480\t### 7.4 内购道具（V1.1 迭代）\n481\t\n482\t| 道具 | 价格（¥） | 效果 | 上线时机 |\n483\t|------|-----------|------|----------|\n484\t| 去广告 | 8 | 永久移除插屏，激励视频按钮变为金币购买 | V1.1 |\n485\t| 金币包 S | 3 | 200 金币 | V1.1 |\n486\t| 金币包 M | 12 | 1000 金币（+10% 赠送） | V1.1 |\n487\t| 金币包 L | 25 | 2500 金币（+20% 赠送） | V1.1 |\n488\t| 月卡 | 15/月 | 每日 100 金币 + 专属皮肤 + 去广告 | V1.2 |\n489\t\n490\t### 7.5 盈利关键假设 [待测试]\n491\t\n492\t| 假设 | 基础值 | 依据 |\n493\t|------|--------|------|\n494\t| 激励视频 eCPM | ¥80/千次 | 文字益智品类中位数 |\n495\t| 留存率 | 次日 35%，7 日 18%，30 日 6% | 文字游戏品类平均 |\n496\t| 人均广告次数 | 6 次/天 | 与调研数据一致 |\n497\t| 视频完成率 | 90% | 教育类用户观看意愿高 |\n498\t| 限时挑战参与率 | 40% DAU | 基于竞品数据估算 |\n499\t| PK 裂变系数 | 1.3（每个用户带来 0.3 个新用户） | 文字游戏社交传播效率 |\n500\t\n501\t---\n502\t\n503\t## 八、技术方案\n504\t\n505\t### 8.1 技术栈选型\n506\t\n507\t| 组件 | 选型 | 理由 |\n508\t|------|------|------|\n509\t| 渲染引擎 | **TTML + TTSS**（抖音小程序原生） | 纯文字游戏，DOM 渲染更快开发，无需 Canvas |\n510\t| 编程语言 | **原生 JavaScript**（ES6+） | 最小依赖，最快开发 |\n511\t| 动画 | CSS Animation + JS 补间 | 文字飞入/弹出效果用 CSS 足够 |\n512\t| 音频 | `tt.createInnerAudioContext()` | 抖音原生 API |\n513\t| 广告 | 穿山甲 SDK（csjplatform.com） | 抖音官方广告平台 |\n514\t| 数据存储 | `tt.setStorageSync()` + 云开发 | 本地进度 + 云端排行/PK |\n515\t| 社交 | `tt.shareAppMessage()` + `tt.getFriendCloudStorage()` | 抖音好友关系链 |\n516\t| 构建工具 | 无 | 小程序直接上传开发者工具 |\n517\t\n518\t**选择 TTML（DOM）而非 Canvas 的理由**：\n519\t- 成语游戏无复杂图形，文字 + 按钮 = DOM 更高效\n520\t- CSS 动画性能足够（文字飞入、缩放、抖动）\n521\t- 开发效率比 Canvas 高 30-40%\n522\t- 可复用三消游戏的广告管理、社交、经济模块\n523\t\n524\t### 8.2 项目文件结构\n525\t\n526\t```\n527\tidiom-master/\n528\t├── app.js                    # 小程序入口（App 生命周期）\n529\t├── app.json                  # 页面路由 + 全局配置\n530\t├── app.ttss                  # 全局样式（国风主题）\n531\t├── project.config.json       # 抖音开发者工具配置\n532\t│\n533\t├── pages/\n534\t│   ├── home/                 # 主页\n535\t│   │   ├── index.js          # 模式选择 + 每日入口 + 角色/地图入口\n536\t│   │   ├── index.ttml\n537\t│   │   └── index.ttss\n538\t│   ├── play/                 # 答题页\n539\t│   │   ├── index.js          # 出题逻辑 + 答题判定 + 连击系统\n540\t│   │   ├── index.ttml\n541\t│   │   └── index.ttss\n542\t│   ├── result/               # 结算页\n543\t│   │   ├── index.js          # 星级 + 奖励 + 广告（双倍）+ 分享\n544\t│   │   ├── index.ttml\n545\t│   │   └── index.ttss\n546\t│   ├── timed/                # 限时挑战\n547\t│   │   ├── index.js          # 60s 倒计时 + 无限出题 + 排行榜提交\n548\t│   │   ├── index.ttml\n549\t│   │   └── index.ttss\n550\t│   ├── pk/                   # 好友 PK\n551\t│   │   ├── index.js          # 5 题 PK + 结果揭晓\n552\t│   │   ├── index.ttml\n553\t│   │   └── index.ttss\n554\t│   ├── collection/           # 成语图鉴\n555\t│   │   ├── index.js          # 分类浏览 + 搜索 + 详情\n556\t│   │   ├── index.ttml\n557\t│   │   └── index.ttss\n558\t│   ├── leaderboard/          # 排行榜\n559\t│   │   ├── index.js          # 好友排行 + 全局排行\n560\t│   │   ├── index.ttml\n561\t│   │   └── index.ttss\n562\t│   ├── characters/           # 角色选择\n563\t│   │   ├── index.js          # 角色列表 + 技能 + 皮肤\n564\t│   │   ├── index.ttml\n565\t│   │   └── index.ttss\n566\t│   └── daily/                # 每日挑战\n567\t│       ├── index.js          # 每日 1 题 + 统计\n568\t│       ├── index.ttml\n569\t│       └── index.ttss\n570\t│\n571\t├── components/\n572\t│   ├── tile-char/            # 候选字组件（点击 + 飞入动画）\n573\t│   │   ├── index.js\n574\t│   │   ├── index.ttml\n575\t│   │   └── index.ttss\n576\t│   ├── idiom-slot/           # 成语填空组件（4 个空位）\n577\t│   │   ├── index.js\n578\t│   │   ├── index.ttml\n579\t│   │   └── index.ttss\n580\t│   ├── ad-modal/             # 广告弹窗组件（激励视频/插屏通用）\n581\t│   │   ├── index.js\n582\t│   │   ├── index.ttml\n583\t│   │   └── index.ttss\n584\t│   ├── combo-display/        # 连击显示组件（数字 + 特效）\n585\t│   ├── star-rating/          # 星级评定组件\n586\t│   └── share-card/           # 分享卡片生成组件\n587\t│\n588\t├── utils/\n589\t│   ├── idiom-engine.js       # 出题引擎（选题 + 干扰字生成）\n590\t│   ├── judge.js              # 答题判定（正确/错误/撤销）\n591\t│   ├── combo.js              # 连击计算与特效触发\n592\t│   ├── pk-logic.js           # PK 匹配、出题同步、结算\n593\t│   ├── ad-manager.js         # 穿山甲广告管理（从三消项目复用）\n594\t│   ├── social.js             # 分享 + 好友关系链（从三消项目复用）\n595\t│   ├── economy.js            # 金币/提示经济系统（从三消项目复用）\n596\t│   ├── storage.js            # 持久化封装（从三消项目复用）\n597\t│   ├── daily.js              # 每日挑战 + 每日任务\n598\t│   └── cloud.js              # 云开发封装（排行榜 + PK 数据）\n599\t│\n600\t├── data/\n601\t│   ├── idioms/               # 成语数据库（按难度分文件）\n602\t│   │   ├── easy.json         # ★ 简单（500 个）\n603\t│   │   ├── medium.json       # ★★ 中等（500 个）\n604\t│   │   ├── hard.json         # ★★★ 困难（500 个）\n605\t│   │   └── master.json       # ★★★★ 大师（500 个）\n606\t│   ├── levels.json           # 关卡配置（50 关）\n607\t│   ├── characters.json       # 角色配置\n608\t│   ├── skins.json            # 皮肤配置\n609\t│   ├── daily-tasks.json      # 每日任务模板\n610\t│   └── economy.json          # 经济数值配置\n611\t│\n612\t├── assets/\n613\t│   ├── icons/                # 分类图标（动物/数字/历史等，< 50KB）\n614\t│   ├── characters/           # 角色头像（4 个 × 16KB = 64KB）\n615\t│   ├── backgrounds/          # 答题背景（5 个 × 30KB = 150KB）\n616\t│   ├── effects/              # 特效帧（连击/正确/错误，< 100KB）\n617\t│   └── audio/                # 音效（< 200KB 总计）\n618\t│       ├── sfx/              # 短音效\n619\t│       └── bgm/              # 背景音乐\n620\t│\n621\t└── README.md\n622\t```\n623\t\n624\t### 8.3 可复用三消游戏框架的模块\n625\t\n626\t| 模块 | 三消项目文件 | 复用程度 | 修改内容 |\n627\t|------|-------------|----------|----------|\n628\t| 广告管理 | `ad-manager.js` | **90%** | 调整广告位配置 |\n629\t| 社交分享 | `social.js` | **80%** | 改分享文案和图片 |\n630\t| 经济系统 | `economy.js` | **70%** | 调整金币数值 |\n631\t| 数据存储 | `storage.js` | **95%** | 几乎直接复用 |\n632\t| 云开发 | `cloud.js` | **80%** | 调整排行榜字段 |\n633\t| 平台适配 | `platform/` | **100%** | 完全复用 |\n634\t\n635\t**预估框架复用可节省 40-50% 开发时间。**\n636\t\n637\t### 8.4 成语数据库设计\n638\t\n639\t```json\n640\t{\n641\t  \"id\": \"idiom_00001\",\n642\t  \"idiom\": \"画蛇添足\",\n643\t  \"chars\": [\"画\", \"蛇\", \"添\", \"足\"],\n644\t  \"pinyin\": \"huà shé tiān zú\",\n645\t  \"meaning\": \"比喻做了多余的事，反而不恰当\",\n646\t  \"origin\": \"《战国策·齐策二》\",\n647\t  \"example\": \"你已经写得很好了，再修改就是画蛇添足。\",\n648\t  \"difficulty\": 1,\n649\t  \"category\": [\"动物\", \"寓言\"],\n650\t  \"tags\": [\"小学\", \"常用\"],\n651\t  \"distractors_easy\": [\"龙\", \"虎\", \"飞\", \"跑\"],\n652\t  \"distractors_hard\": [\"化\", \"它\", \"捻\", \"促\"],\n653\t  \"frequency\": 95\n654\t}\n655\t```\n656\t\n657\t**数据库字段说明**：\n658\t\n659\t| 字段 | 类型 | 说明 |\n660\t|------|------|------|\n661\t| id | string | 唯一标识 |\n662\t| idiom | string | 成语原文 |\n663\t| chars | string[4] | 四个字（有序） |\n664\t| pinyin | string | 拼音（带声调） |\n665\t| meaning | string | 白话文释义 |\n666\t| origin | string | 出处 |\n667\t| example | string | 例句 |\n668\t| difficulty | int | 难度等级（1-4） |\n669\t| category | string[] | 类别标签 |\n670\t| tags | string[] | 附加标签 |\n671\t| distractors_easy | string[] | 简单干扰字（形音差异大） |\n672\t| distractors_hard | string[] | 困难干扰字（形近/音近） |\n673\t| frequency | int | 使用频率（1-100，100 最常用） |\n674\t\n675\t### 8.5 数据获取策略\n676\t\n677\t| 阶段 | 方式 | 数量 | 时间 |\n678\t|------|------|------|------|\n679\t| **首发** | AI 辅助生成 + 人工审核 | 2,000 条 | W1-W2 |\n680\t| **V1.1** | 公开成语词典数据（合规抓取） | +3,000 条 | 上线后 2 周 |\n681\t| **持续** | 每周新增 50 条 + 玩家投稿 | +200 条/月 | 持续 |\n682\t\n683\t**AI 生成流程**：\n684\t1. 从《汉语成语大词典》提取成语列表（公开数据）\n685\t2. AI 批量生成释义、拼音、例句、干扰字\n686\t3. 人工审核：释义准确性、例句自然度、干扰字合理性\n687\t4. 按难度分类 + 打标签\n688\t5. 导入 JSON 数据库\n689\t\n690\t### 8.6 抖音小游戏 SDK 集成要点\n691\t\n692\t#### 入口文件 app.js\n693\t\n694\t```javascript\n695\tApp({\n696\t  onLaunch() {\n697\t    // 初始化广告\n698\t    this.adManager = new AdManager();\n699\t    this.adManager.init();\n700\t\n701\t    // 初始化存储\n702\t    this.storage = new Storage();\n703\t    this.storage.init();\n704\t\n705\t    // 获取用户信息\n706\t    tt.login({\n707\t      success: (res) => {\n708\t        this.userId = res.code;\n709\t      }\n710\t    });\n711\t  },\n712\t  globalData: {\n713\t    userId: null,\n714\t    adManager: null,\n715\t    storage: null\n716\t  }\n717\t});\n718\t```\n719\t\n720\t#### 出题引擎核心\n721\t\n722\t```javascript\n723\t// idiom-engine.js\n724\tclass IdiomEngine {\n725\t  constructor(idiomDB) {\n726\t    this.db = idiomDB; // 按难度分组的成语数据\n727\t    this.history = [];  // 已出题目（避免重复）\n728\t  }\n729\t\n730\t  generateQuestion(difficulty) {\n731\t    const pool = this.db.getByDifficulty(difficulty);\n732\t    const idiom = this.pickRandom(pool, this.history);\n733\t    this.history.push(idiom.id);\n734\t\n735\t    const distractorCount = [0, 4, 6, 8, 8][difficulty];\n736\t    const distractors = idiom.distractors_hard\n737\t      ? idiom.distractors_hard.slice(0, distractorCount)\n738\t      : this.generateDistractors(idiom, distractorCount);\n739\t\n740\t    return {\n741\t      idiom: idiom,\n742\t      slots: [null, null, null, null],\n743\t      candidates: this.shuffle([...idiom.chars, ...distractors]),\n744\t      answered: false\n745\t    };\n746\t  }\n747\t}\n748\t```\n749\t\n750\t---\n751\t\n752\t## 九、美术风格定义\n753\t\n754\t### 9.1 主题\n755\t\n756\t**\"国风书斋\"** — 中国传统文化气息，水墨淡雅，有书卷气但不老气\n757\t\n758\t### 9.2 色彩规范\n759\t\n760\t| 用途 | 颜色 | HEX | 说明 |\n761\t|------|------|-----|------|\n762\t| 主背景 | 宣纸色 | #F5F0E8 | 温暖米色，有纸质感 |\n763\t| 卡片/面板 | 白色微黄 | #FFFDF7 | 比背景稍亮 |\n764\t| 主色调 | 朱砂红 | #C84B31 | 按钮/高亮/正确 |\n765\t| 辅助色 | 墨绿 | #2D6A4F | 进度条/成功 |\n766\t| 金色强调 | 金箔色 | #D4A843 | 星星/奖励/高级 |\n767\t| 文字主色 | 墨黑 | #2C2C2C | 正文 |\n768\t| 文字副色 | 灰棕 | #8B7355 | 次要信息 |\n769\t| 正确反馈 | 翠绿 | #27AE60 | 答对 |\n770\t| 错误反馈 | 朱红 | #E74C3C | 答错 |\n771\t| 连击特效 | 金色渐变 | #FFD700→#FFA500 | 连击高光 |\n772\t\n773\t### 9.3 字体规范\n774\t\n775\t| 用途 | 字体 | 说明 |\n776\t|------|------|------|\n777\t| 成语填空 | 思源宋体 / 系统宋体 | 正式感，有文化氛围 |\n778\t| 候选字 | 系统默认圆体 | 清晰易辨认 |\n779\t| 释义/正文 | 系统默认 | 可读性优先 |\n780\t| 数字/分数 | DIN / 等宽 | 对齐美观 |\n781\t\n782\t### 9.4 UI 设计规范\n783\t\n784\t| 元素 | 规范 |\n785\t|------|------|\n786\t| 成语空位 | 4 个正方形，深色边框，底部有浅色横线，尺寸 60×60px |\n787\t| 候选字按钮 | 圆角正方形（圆角 12px），朱砂红底 + 白字，按压缩小 5% |\n788\t| 正确动画 | 空位变绿 + 对勾弹出 + 候选字位置出现绿色勾 |\n789\t| 错误动画 | 空位变红 + 左右抖动 + 字飞回候选位置 |\n790\t| 按钮 | 圆角矩形，朱砂红渐变，白色文字，按压缩小 5% |\n791\t| 弹窗 | 白色圆角面板 + 半透明遮罩，底部滑入 |\n792\t| 星星 | 金色五角星，从左到右依次弹出 |\n793\t| 连击文字 | 从小到大弹出，金色描边，0.3s 淡出 |\n794\t\n795\t### 9.5 章节视觉\n796\t\n797\t| 章节 | 背景元素 | 色调 |\n798\t|------|----------|------|\n799\t| 初学启蒙 | 竹简 + 晨光 | 浅黄暖色 |\n800\t| 蒙学进阶 | 书桌 + 茶杯 | 橙色暖调 |\n801\t| 经典成语 | 窗外夕阳 + 书架 | 深橙红 |\n802\t| 典故深处 | 月光 + 古书 | 深蓝紫 |\n803\t| 博学大师 | 星空 + 卷轴 | 星空金黑 |\n804\t\n805\t---\n806\t\n807\t## 十、新手引导流程\n808\t\n809\t### 10.1 引导序列\n810\t\n811\t| 步骤 | 时间 | 触发条件 | 引导动作 | UI 表现 |\n812\t|------|------|----------|----------|---------|\n813\t| T1 | 0-3s | 第 1 关第 1 题 | 显示成语释义 + 高亮第 1 个正确候选字 | 半透明遮罩 + 箭头 + 手指动画 |\n814\t| T2 | 3-6s | 玩家点击第 1 个字 | 字飞入空位 + 自动高亮第 2 个正确字 | 继续引导 |\n815\t| T3 | 6-10s | 4 字填完（引导完成） | 正确动画 + 释义弹出 | \"心花怒放：形容非常开心！\" |\n816\t| T4 | 10-15s | 第 2 题出现 | 高亮第 1 个字，其余自由操作 | 逐步减少引导 |\n817\t| T5 | 15-25s | 第 3-5 题 | 无引导，自由作答 | — |\n818\t| T6 | 25-30s | 连对 3 题 | 连击特效触发 | \"连击 ×3！太棒了！\" |\n819\t| T7 | 30-35s | 第 7 题出错 | 红色抖动 + 引导使用提示按钮 | \"卡住了？试试揭示一个字\" |\n820\t| T8 | 35-40s | 第 1 关完成 | 星级评定 + 结算页 | \"完美通关！\" |\n821\t\n822\t### 10.2 引导设计原则\n823\t\n824\t- 第 1 关完全引导，确保成功体验\n825\t- 第 2-3 关逐步放手，只在关键新功能出现时引导\n826\t- 第 4 关起无引导\n827\t- 智能跳过：如果检测到玩家已理解操作（如 3 秒内自主答题），跳过后续引导\n828\t\n829\t---\n830\t\n831\t## 十一、开发排期（3 周里程碑）\n832\t\n833\t### Week 1：核心玩法（MVP）\n834\t\n835\t| 天 | 任务 | 交付物 |\n836\t|----|------|--------|\n837\t| D1 | 项目搭建 + TTML 页面结构 + 全局样式 | 可运行的小程序框架 |\n838\t| D1 | 成语数据库设计 + AI 生成 500 条初始数据 | idioms/easy.json |\n839\t| D2 | 出题引擎（选题 + 干扰字 + 随机排列） | 可生成完整题目 |\n840\t| D2 | 答题界面（空位 + 候选字 + 点击交互） | 可交互的答题页 |\n841\t| D3 | 答题判定（正确/错误动画 + 生命系统） | 完整的单题循环 |\n842\t| D3 | 连击系统（计算 + 特效 + 加分） | 连击反馈完整 |\n843\t| D4 | 关卡配置系统 + JSON 加载 | 可配置不同关卡 |\n844\t| D4 | 前 20 关数据制作 + 关卡地图页面 | 20 个可玩关卡 |\n845\t| D5 | 新手引导序列 + W1 内测 | 稳定可玩的 20 关 Demo |\n846\t\n847\t**W1 里程碑验收**：20 关完整可玩，含教学引导、连击系统、生命值、音效。\n848\t\n849\t### Week 2：完整体验 + 社交\n850\t\n851\t| 天 | 任务 | 交付物 |\n852\t|----|------|--------|\n853\t| D6 | 限时挑战模式 + 倒计时 + 排行 | 限时模式可玩 |\n854\t| D6 | 成语图鉴系统（收集 + 分类 + 详情） | 图鉴页完成 |\n855\t| D7 | 提示系统（揭示/去干扰/跳过）+ 金币消耗 | 所有道具就绪 |\n856\t| D7 | 每日系统（登录/任务/挑战） | 每日内容 |\n857\t| D8 | 好友 PK 模式 + 云端数据同步 | PK 可玩 |\n858\t| D8 | 抖音分享集成 + 短视频分享 | 社交分享就绪 |\n859\t| D9 | 角色系统 + 皮肤系统 | 4 角色 + 3 皮肤 |\n860\t| D9 | 关卡 21-50 数据制作 | 50 关完整 |\n861\t| D10 | W2 内测 + Bug 修复 | 稳定可玩的 50 关 + 社交 |\n862\t\n863\t**W2 里程碑验收**：50 关 + 三模式 + 图鉴 + 角色 + 社交分享。\n864\t\n865\t### Week 3：变现 + 上线\n866\t\n867\t| 天 | 任务 | 交付物 |\n868\t|----|------|--------|\n869\t| D11 | 穿山甲 SDK 集成（复用三消广告管理） | 广告可展示 |\n870\t| D11 | 6 个广告位 UI + 频率控制 | 广告系统完成 |\n871\t| D12 | 数据埋点（复用三消埋点框架） | 关键事件全覆盖 |\n872\t| D12 | 包体优化 + 资源压缩 | < 2MB |\n873\t| D13 | 全量测试 + Bug 修复 | 无阻塞性 Bug |\n874\t| D13 | 软著材料提交 | 提审准备 |\n875\t| D14 | 抖音提审 | 提交审核 |\n876\t| D14 | 备用：修复审核反馈 | 快速迭代 |\n877\t| D15 | 上线 + 监控首日数据 | 正式发布 |\n878\t\n879\t**W3 里程碑验收**：游戏上架抖音小游戏平台，广告变现运行正常。\n880\t\n881\t### 11.1 关键依赖\n882\t\n883\t| 依赖项 | 来源 | 截止时间 | 风险 |\n884\t|--------|------|----------|------|\n885\t| 抖音开发者账号 | 复用三消项目 | 已有 | 无 |\n886\t| 穿山甲广告账号 | 复用三消项目 | 已有 | 无 |\n887\t| 软著 | 复用三消项目主体 | 提审前 | 低 |\n888\t| 成语数据库 2000 条 | AI 生成 + 人工审核 | D2-D5 | 中（需人工审核） |\n889\t| 角色头像 4 张 | AI 绘制 | W1 结束 | 低 |\n890\t| 背景图 5 张 | AI 绘制 | W2 结束 | 低 |\n891\t| 音效 10-15 个 | AI 生成 | W1 结束 | 低 |\n892\t\n893\t---\n894\t\n895\t## 十二、数据埋点与运营\n896\t\n897\t### 12.1 关键指标\n898\t\n899\t| 指标 | 定义 | 目标值 | 告警阈值 |\n900\t|------|------|--------|----------|\n901\t| 次日留存 | D1/D0 | 35%+ | < 25% |\n902\t| 7 日留存 | D7/D0 | 18%+ | < 10% |\n903\t| 平均会话时长 | — | 6+ 分钟 | < 3 分钟 |\n904\t| 人均广告次数/天 | — | 6+ 次 | < 3 次 |\n905\t| 激励视频完成率 | — | 90%+ | < 75% |\n906\t| 新手引导完成率 | 完成教学关卡比例 | 95%+ | < 80% |\n907\t| 关卡通过率（前 10 关） | 单关通过比例 | 85%+ | < 70% |\n908\t| PK 参与率 | DAU 中参与 PK 比例 | 30%+ | < 15% |\n909\t| 图鉴收集率 | 人均收集成语数 | 50+/周 | < 20/周 |\n910\t| ARPU | 日收入/DAU | ¥0.34+ | < ¥0.15 |\n911\t\n912\t### 12.2 埋点事件\n913\t\n914\t```javascript\n915\tconst EVENTS = {\n916\t  GAME_START: 'game_start',           // 游戏启动\n917\t  TUTORIAL_STEP: 'tutorial_step',     // 引导步骤\n918\t  LEVEL_START: 'level_start',         // 关卡开始\n919\t  QUESTION_ANSWER: 'question_answer', // 答题结果（正确/错误/用时/是否用提示）\n920\t  LEVEL_COMPLETE: 'level_complete',   // 关卡完成（正确率/星级/金币）\n921\t  LEVEL_FAIL: 'level_fail',           // 关卡失败（剩余生命/第几题失败）\n922\t  COMBO_HIT: 'combo_hit',             // 连击数（N 连击触发）\n923\t  HINT_USE: 'hint_use',               // 使用提示（类型：揭示/去干扰/跳过）\n924\t  AD_SHOW: 'ad_show',                 // 广告展示（广告位/是否完成）\n925\t  SHARE: 'share',                     // 分享（类型：PK/求助/成绩/每日挑战）\n926\t  PK_START: 'pk_start',               // PK 开始\n927\t  PK_RESULT: 'pk_result',             // PK 结果（胜/负/平）\n928\t  TIMED_START: 'timed_start',         // 限时挑战开始\n929\t  TIMED_END: 'timed_end',             // 限时挑战结束（分数/答题数）\n930\t  COLLECTION_UNLOCK: 'collection_unlock', // 解锁新成语\n931\t  CHARACTER_USE: 'character_use',     // 角色使用\n932\t};\n933\t```\n934\t\n935\t---\n936\t\n937\t## 十三、风险与缓解\n938\t\n939\t| 风险 | 概率 | 影响 | 缓解措施 |\n940\t|------|------|------|----------|\n941\t| 成语数据质量差 | 中 | 玩家信任度下降 | AI 生成后必须人工审核释义准确性 |\n942\t| 成语歧义（多组成语） | 中 | 玩家困惑 | 出题时排除有歧义的成语；提供释义辅助 |\n943\t| 互动性不如三消 | 中 | 留存偏低 | 用 PK、限时、排行弥补；加快节奏 |\n944\t| 题库消耗过快 | 中 | 内容枯竭 | 首发 2000 条 + 每周更新；按频率分配保证 50 关不重复 |\n945\t| 广告 eCPM 偏低 | 中 | 收入不足 | 增加激励视频比重；优化提示触发点 |\n946\t| 文字游戏天花板低 | 中 | DAU 上限低 | 作为矩阵第二产品，不追求单一爆款 |\n947\t\n948\t---\n949\t\n950\t## 十四、版本规划\n951\t\n952\t| 版本 | 时间 | 内容 |\n953\t|------|------|------|\n954\t| **V1.0** | 第 3 周末 | 50 关 + IAA 广告 + 基础社交 + 4 角色 + 图鉴 |\n955\t| V1.1 | 上线后 2 周 | 内购道具 + 题库扩充至 5000 + 新章节 51-80 关 |\n956\t| V1.2 | 上线后 4 周 | 月卡系统 + 每周挑战赛 + 新角色 + 皮肤商店 |\n957\t| V1.3 | 上线后 6 周 | 微信小游戏版本上线 |\n958\t| V2.0 | 上线后 2 月 | Emoji 猜成语模式 + 看图猜成语 + 成语接龙模式 |\n959\t\n960\t---\n961\t\n962\t## 附录 A：调参表\n963\t\n964\t```\n965\t变量                       | 基础值   | 最小值 | 最大值 | 调参备注\n966\t---------------------------|---------|--------|--------|---------------------------\n967\t初始生命值                   | 5       | 3      | 8      | ★ 简单关 5，★★★ 关 3 [待测试]\n968\t每关题数                     | 10      | 8      | 15     | Boss 关可增加\n969\t候选字数（★ 简单）           | 8       | 6      | 10     | [待测试] 8 是否太容易\n970\t候选字数（★★★★ 大师）      | 12      | 10     | 16     | [待测试]\n971\t答错扣命数                   | 1       | 1      | 2      | 保持 1，降低挫败感\n972\t续命恢复命数                 | 3       | 2      | 5      | [待测试]\n973\t揭示提示金币价格              | 5       | 3      | 10     | [待测试]\n974\t去干扰金币价格                | 8       | 5      | 15     | [待测试]\n975\t连击加分倍率                  | 1+0.2×n | 1+0.1×n| 1+0.5×n| [待测试] 是否激励足够\n976\t限时挑战时长                  | 60s     | 30s    | 120s   | [待测试]\n977\t插屏广告间隔（关数）          | 2       | 1      | 4      | [待测试] 2 是否太频繁\n978\t激励视频每日上限              | 15      | 10     | 25     | [待测试]\n979\t```\n980\t\n981\t## 附录 B：音效列表\n982\t\n983\t| ID | 音效名 | 触发时机 | 时长 | 风格 |\n984\t|----|--------|----------|------|------|\n985\t| S01 | char_place | 字填入空位 | 0.1s | 清脆 click |\n986\t| S02 | answer_correct | 答对整题 | 0.3s | 上升音阶叮 |\n987\t| S03 | answer_wrong | 答错 | 0.3s | 低沉 buzz |\n988\t| S04 | combo_3 | 3 连击 | 0.3s | 快乐升调 |\n989\t| S05 | combo_5 | 5 连击 | 0.5s | 激动弦乐 |\n990\t| S06 | combo_8 | 8+ 连击 | 0.6s | 欢呼 + 管弦 |\n991\t| S07 | level_complete | 通关 | 1.0s | 古风 fanfare |\n992\t| S08 | level_fail | 失败 | 0.8s | 柔和叹息 |\n993\t| S09 | star_earned | 获得星星 | 0.2s | 叮—— |\n994\t| S10 | hint_reveal | 使用揭示 | 0.2s | 翻书声 |\n995\t| S11 | hint_remove | 使用去干扰 | 0.2s | 消散声 |\n996\t| S12 | pk_win | PK 胜利 | 0.8s | 胜利鼓点 |\n997\t| S13 | pk_lose | PK 失败 | 0.5s | 鼓励音 |\n998\t| S14 | button_click | 按钮点击 | 0.08s | 轻触 |\n999\t| S15 | timed_tick | 倒计时最后 10 秒 | 0.1s | 滴答 |\n1000\t\n1001\t## 附录 C：成语图鉴分类设计\n1002\t\n1003\t| 类别 | 数量（首发） | 图标 | 解锁条件 |\n1004\t|------|-------------|------|----------|\n1005\t| 动物世界 | 300 | 🐉 | 初始解锁 |\n1006\t| 数字密码 | 150 | 🔢 | 通关第 2 章 |\n1007\t| 历史典故 | 250 | 📜 | 通关第 3 章 |\n1008\t| 自然风光 | 150 | 🏔️ | 通关第 4 章 |\n1009\t| 人物描写 | 200 | 👤 | 收集 100 个成语 |\n1010\t| 寓言哲理 | 200 | 💡 | 收集 150 个成语 |\n1011\t| 军事谋略 | 150 | ⚔️ | 收集 200 个成语 |\n1012\t| 情感表达 | 150 | ❤️ | 收集 300 个成语 |\n1013\t| 四季时令 | 100 | 🌸 | 收集 400 个成语 |\n1014\t| 美食文化 | 100 | 🍜 | 收集 500 个成语 |\n1015\t\n1016\t每类收集满 → 解锁该类专属背景皮肤\n1017\t\n1018\t## 附录 D：变更日志\n1019\t\n1020\t| 版本 | 日期 | 变更内容 |\n1021\t|------|------|----------|\n1022\t| 1.0 | 2026-05-23 | 初始立项文档 |\n1023\t"}]},"parent_tool_use_id":null,"session_id":"7463fb62-2e03-4edd-abad-466ff792dff1","uuid":"af8d9538-489f-4c8b-883d-cee8dad28373","timestamp":"2026-05-23T10:38:03.617Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/GDD.md","content":"# 成语大闯关（Idiom Master）— 详细立项文档\n\n> **版本**：1.0 | **日期**：2026-05-23 | **设计师**：游戏设计师 Agent\n> **状态**：立项 — 待开发评审\n> **关联文档**：[[douyin-mini-games-blueprint.md]] — 平台调研与初始概念；[[../douyin-match3/GDD.md]] — 三消游戏框架（可复用组件）\n\n---\n\n## 一、项目概览\n\n| 字段 | 值 |\n|------|-----|\n| 游戏名称 | 成语大闯关（Idiom Master） |\n| 品类 | 文字益智（Word Puzzle） |\n| 目标平台 | 抖音小游戏（优先）→ 微信小游戏 → H5 |\n| 核心差异化 | 中文成语专项（蓝海品类）+ 抖音社交竞赛 + 轻量社交裂变 |\n| 开发周期 | 3 周（单人全栈，含提审） |\n| 目标 DAU | 首发 3K → 3 个月 30K |\n| 变现模式 | IAA 为主（激励视频 + 插屏），后续叠加 IAP（皮肤/道具） |\n| 包体目标 | < 2MB（纯文字 + 少量图标，极轻量） |\n| 软著申请 | 与三消游戏同步，复用同一主体 |\n\n### 设计支柱（不可妥协）\n\n1. **15 秒内上手** — 看一眼就知道怎么玩，答题 = 点击选字，零解释\n2. **每题都是微成就感** — 正确动画 + 连击 + 释义弹出，持续刺激\"我很聪明\"的满足感\n3. **知识 = 社交货币** — 成绩可炫耀，PK 可分享，失败可求助，天然传播动力\n4. **极低开发成本** — 纯文字渲染，无美术依赖，复用三消游戏的广告/社交/经济框架\n\n---\n\n## 二、竞品分析\n\n### 2.1 抖音热门成语游戏\n\n| 竞品 | 品类 | 核心玩法 | 日活估算 | 优势 | 短板 |\n|------|------|----------|----------|------|------|\n| **成语小秀才** | 文字益智 | 选字组词 + 官职升级 | 50K+ | 官职系统驱动长期留存 | 美术简陋，社交弱 |\n| **成语大挑战** | 文字益智 | 看图猜成语 | 30K+ | 图文结合有新意 | 图片包体大，题库有限 |\n| **疯狂猜成语** | 问答 | 图片/emoji 猜成语 | 20K+ | 短视频传播力强 | 题目质量参差不齐 |\n| **成语消消乐** | 混合 | 三消 + 成语 | 10K+ | 创新融合 | 两套系统互相干扰 |\n\n### 2.2 竞品共性问题\n\n1. **社交裂变浅** — 大多只有分享领金币，缺乏深度互动\n2. **内容运营弱** — 题库静态不更新，老玩家很快刷完\n3. **变现设计粗暴** — 广告弹出频繁，严重影响体验\n4. **视觉风格统一差** — 大多采用模板化 UI，无品牌辨识度\n\n### 2.3 我们的差异化策略\n\n| 维度 | 竞品做法 | 我们的做法 |\n|------|----------|-----------|\n| 核心玩法 | 单一模式 | 闯关 + 限时 + PK 三模式 |\n| 社交 | 分享领金币 | 好友 PK + 求助 + 每日挑战排行 |\n| 内容运营 | 固定题库 | 每周更新 + 玩家投稿 + AI 扩充 |\n| 变现 | 强制广告 | 70%+ 激励视频（用户主动选择） |\n| 视觉 | 模板 UI | 国风主题 + 角色皮肤系统 |\n| 长期留存 | 无 | 成语图鉴收集 + 称号系统 + 角色养成 |\n\n---\n\n## 三、核心玩法机制设计\n\n### 3.1 基本规则\n\n- 屏幕上方显示成语的**释义**（如\"形容非常开心\"）\n- 中间显示 **4 个空位**（组成完整成语）\n- 下方显示 **8-12 个候选字**（含 4 个正确字 + 干扰字）\n- 玩家**依次点击** 4 个正确字，按正确顺序填入空位\n- 答对 → 绿色闪光 + 释义弹出 + 连击 +1 → 下一题\n- 答错 → 红色抖动 + 字飞回 + 失去 1 条命（初始 5 条命）\n\n### 3.2 出题引擎规格\n\n```\n输入：成语数据库（idioms.json）+ 难度等级 + 关卡配置\n输出：一道完整的成语题\n\n算法：\n1. 根据关卡难度等级，从题库中随机选取一个成语\n2. 生成干扰字池：\n   a. 优先从同类别成语中取字（如动物类成语取动物相关字）\n   b. 补充形近字（如\"己\"/\"已\"/\"巳\"）\n   c. 补充音近字（如\"画\"/\"话\"）\n   d. 确保干扰字与正确字不重复\n3. 将正确字 + 干扰字随机排列（8-12 个）\n4. 记录正确答案的索引顺序（用于判定）\n\n干扰字数量规则：\n- ★ 简单：4 正确 + 4 干扰 = 8 候选\n- ★★ 中等：4 正确 + 6 干扰 = 10 候选\n- ★★★ 困难：4 正确 + 8 干扰 = 12 候选\n- ★★★★ 大师：4 正确 + 8 干扰 = 12 候选（干扰字更相似）\n\n性能要求：出题 < 10ms（纯内存操作）\n```\n\n### 3.3 答题判定逻辑\n\n```\n状态：4 个空位 slot[0..3]，当前已填 fillCount\n玩家点击候选字 candidate[i]：\n  → 候选字飞入 slot[fillCount]\n  → fillCount++\n  → 如果 fillCount == 4：\n      → 检查 slot[0..3] 是否等于 idiom.chars[0..3]\n      → 正确：触发\"正确\"动画链\n      → 错误：触发\"错误\"动画链，slot 清空，fillCount = 0\n  → 如果 fillCount < 4：\n      → 等待继续点击\n\n撤销机制：\n  → 点击已填入的 slot[i]：该字飞回候选区，后续 slot 自动左移\n  → 仅在\"撤销提示\"道具激活时可用（默认不可撤销已填字）\n```\n\n### 3.4 三种游戏模式\n\n#### 模式一：闯关模式（核心进度）\n\n| 规则 | 说明 |\n|------|------|\n| 每关题数 | 10 题 |\n| 生命值 | 初始 5 条命 |\n| 通关条件 | 答完 10 题（允许使用提示/跳过） |\n| 星级评定 | 按正确率：≥9 对 = 3 星，≥7 对 = 2 星，≥5 对 = 1 星 |\n| 失败条件 | 生命值归零 |\n| 难度递进 | 每 10 关提升一个难度等级 |\n\n#### 模式二：限时挑战\n\n| 规则 | 说明 |\n|------|------|\n| 时间 | 60 秒倒计时 |\n| 题目 | 无限出题，难度随机（偏中等） |\n| 得分 | 每题基础 100 分 + 连击加成（连击数 × 20） |\n| 结束 | 倒计时结束 → 结算 |\n| 排行榜 | 全局 + 好友 |\n\n#### 模式三：好友 PK\n\n| 规则 | 说明 |\n|------|------|\n| 题数 | 5 题 |\n| 机制 | 双方答相同题目，互不知对方进度 |\n| 胜负 | 正确率高者胜；相同则比用时 |\n| 奖励 | 胜者 +50 金币 + 1 PK 积分 |\n| 裂变 | PK 结果页 → 一键分享到抖音 |\n\n### 3.5 连击系统（核心爽感来源）\n\n```\n连续答对触发连击：\n- 3 连击：+60 分加成 → \"不错！\" 文字弹出 + 音效升调\n- 5 连击：+100 分加成 → \"厉害了！\" + 屏幕微震 + 粒子特效\n- 8 连击：+160 分加成 → \"学霸！\" + 全屏金色光效\n- 10+ 连击：+200+ 分加成 → \"成语大师！！\" + 烟花特效 + 额外 1 金币\n\n连击断裂：\n- 答错或使用跳过 → 连击归零\n- 使用提示答对 → 连击继续，但本题不计加分\n\n动画时间预算（单题交互总时间不超过 1.5 秒）：\n- 点击填字：0.15s\n- 正确动画：0.4s（绿色闪光 + 释义弹出）\n- 错误动画：0.5s（红色抖动 + 字飞回）\n- 连击特效：0.3s（叠加在正确动画上）\n```\n\n### 3.6 失败与续命\n\n| 事件 | 玩家选择 | 结果 |\n|------|----------|------|\n| 生命值归零 | 看激励视频（30s） | 恢复 3 条命，可续命 1 次 |\n| 生命值归零 | 使用 10 金币购买 | 恢复 3 条命 |\n| 生命值归零 | 放弃 | 回到关卡地图，保留已获星星 |\n\n---\n\n## 四、关卡系统设计（首发 50 关）\n\n### 4.1 关卡数据结构\n\n```json\n{\n  \"id\": 1,\n  \"chapter\": 1,\n  \"difficulty\": 1,\n  \"questions\": 10,\n  \"lives\": 5,\n  \"stars\": [5, 7, 9],\n  \"reward\": { \"coins\": 20, \"exp\": 10 },\n  \"idiom_pool\": [\"easy_01\", \"easy_02\"],\n  \"category\": [\"常用\", \"动物\"],\n  \"tutorial_step\": \"T1\"\n}\n```\n\n| 字段 | 类型 | 说明 |\n|------|------|------|\n| id | int | 关卡编号 |\n| chapter | int | 章节编号 |\n| difficulty | int | 难度等级（1-4） |\n| questions | int | 题目数量 |\n| lives | int | 初始生命 |\n| stars | int[3] | 1/2/3 星正确数阈值 |\n| reward | object | 通关奖励（金币 + 经验） |\n| idiom_pool | string[] | 本关出题池（可选，为空则按难度随机） |\n| category | string[] | 成语类别限制 |\n| tutorial_step | string/null | 关联教学步骤 |\n\n### 4.2 前 50 关详细设计\n\n#### 第 1-5 关：新手教学（零失败区）\n\n| 关卡 | 难度 | 生命 | 星级阈值 | 候选字数 | 教学内容 |\n|------|------|------|----------|----------|----------|\n| 1 | ★ | 5 | [3, 4, 5] | 8 | 强制引导：高亮正确字，引导逐字点击 |\n| 2 | ★ | 5 | [3, 4, 5] | 8 | 半引导：只提示第一个字 |\n| 3 | ★ | 5 | [4, 5, 5] | 8 | 自由作答，成语极简（一心一意、画蛇添足等） |\n| 4 | ★ | 5 | [4, 5, 5] | 8 | 引入释义提示按钮（免费） |\n| 5 | ★ | 5 | [4, 5, 5] | 8 | 引入连击概念，连对 3 题触发特效 |\n\n**设计原则**：\n- 前 5 关保证所有玩家都能 3 星通关\n- 成语选取最常见的日常用语\n- 释义用白话文，不用文言原文\n- 每关第 1 题必是最简单的成语（如\"心花怒放\"）\n\n#### 第 6-15 关：简单进阶（建立习惯）\n\n| 关卡 | 难度 | 生命 | 星级阈值 | 新元素 |\n|------|------|------|----------|--------|\n| 6 | ★ | 5 | [5, 7, 9] | 标准规则 |\n| 7 | ★ | 5 | [5, 7, 9] | 引入\"去干扰\"道具（首次免费） |\n| 8 | ★ | 5 | [5, 7, 9] | 引入\"跳过\"功能 |\n| 9 | ★ | 5 | [5, 7, 9] | — |\n| 10 | ★ | 5 | [5, 7, 9] | Boss 关：10 题全对额外奖励 50 金币 |\n| 11 | ★ | 4 | [5, 7, 9] | 生命值降至 4 |\n| 12 | ★ | 4 | [5, 7, 9] | — |\n| 13 | ★ | 4 | [5, 7, 9] | 引入双类别混合（动物+数字） |\n| 14 | ★ | 4 | [5, 7, 9] | — |\n| 15 | ★ | 4 | [5, 7, 9] | Boss 关：正确率 ≥80% 通关 |\n\n#### 第 16-30 关：中等难度（策略性增强）\n\n| 关卡段 | 难度 | 生命 | 候选字数 | 新元素 |\n|--------|------|------|----------|--------|\n| 16-20 | ★★ | 4 | 10 | 中等成语（望梅止渴、纸上谈兵等） |\n| 21-25 | ★★ | 3 | 10 | 生命降至 3，需要更谨慎 |\n| 26-30 | ★★ | 3 | 10 | 引入形近干扰（己/已、蓝/篮等） |\n\n#### 第 31-45 关：困难挑战（硬核考验）\n\n| 关卡段 | 难度 | 生命 | 候选字数 | 新元素 |\n|--------|------|------|----------|--------|\n| 31-35 | ★★★ | 3 | 12 | 困难成语（沆瀣一气、韦编三绝等） |\n| 36-40 | ★★★ | 3 | 12 | 音近干扰（画/话、故/顾等） |\n| 41-45 | ★★★ | 3 | 12 | 混合干扰（形近 + 音近） |\n\n#### 第 46-50 关：大师挑战（里程碑）\n\n| 关卡 | 难度 | 生命 | 特殊规则 |\n|------|------|------|----------|\n| 46-49 | ★★★★ | 3 | 生僻成语 + 最大干扰 + 无释义提示 |\n| 50 | ★★★★ | 3 | Boss 关：12 题全对 = 传说称号 + 200 金币 |\n\n### 4.3 章节结构（每 10 关一个章节）\n\n| 章节 | 主题 | 关卡 | 视觉风格 |\n|------|------|------|----------|\n| 第一章 | 初学启蒙 | 1-10 | 书院·晨光（浅黄暖色） |\n| 第二章 | 蒙学进阶 | 11-20 | 书院·午后（橙色暖调） |\n| 第三章 | 经典成语 | 21-30 | 书院·夕阳（深橙红） |\n| 第四章 | 典故深处 | 31-40 | 书院·月夜（深蓝紫） |\n| 第五章 | 博学大师 | 41-50 | 书院·星辰（星空金黑） |\n\n### 4.4 关卡验证规则\n\n- 每关题池至少 15 个成语（10 个必答 + 5 个备用）\n- 所有成语必须经过人工审核：释义准确、出处可查\n- ★ 简单关成语必须在《新华字典》常用词表中\n- 干扰字不能组成其他有效成语（避免歧义）\n- Boss 关题目从固定池中选取（保证公平性）\n\n---\n\n## 五、角色/皮肤系统\n\n### 5.1 角色（导师系统）\n\n| 角色 | 主题 | 技能 | 获取方式 |\n|------|------|------|----------|\n| **书童小明** | 基础 | 答错时有 20% 概率不扣命 | 初始角色 |\n| **才女小红** | 中等 | 每关首次使用提示不消耗次数 | 通过 20 关解锁 |\n| **状元先生** | 高级 | 连击加分 ×1.5 倍 | 收集 80 碎片兑换 |\n| **诗仙李白** | 稀有 | 答对时额外获得 1 经验 | 月卡/活动限定 |\n\n### 5.2 角色皮肤（视觉自定义）\n\n| 皮肤 | 风格 | 获取方式 | 价格 |\n|------|------|----------|------|\n| 经典蓝袍 | 默认 | 初始 | 免费 |\n| 红色喜庆 | 节日风 | 春节活动 | 限时 |\n| 青绿山水 | 国风 | 图鉴收集 100 个成语 | 100 金币 |\n| 金色荣耀 | 奢华 | PK 积分达到 100 | 200 金币 |\n| Q版萌趣 | 可爱 | 首次充值（后续） | ¥6 |\n\n### 5.3 背景皮肤（答题界面背景）\n\n| 背景 | 风格 | 获取 |\n|------|------|------|\n| 水墨竹影 | 国风淡雅 | 初始 |\n| 春日桃林 | 花开满屏 | 通关第 2 章 |\n| 秋月寒江 | 冷色调 | 通关第 3 章 |\n| 星河夜空 | 梦幻 | 通关第 4 章 |\n| 古典书斋 | 木质纹理 | 收集 200 个成语 |\n\n---\n\n## 六、社交裂变机制\n\n### 6.1 好友 PK 挑战（核心裂变）\n\n```\n流程：\n1. 玩家 A 在 PK 模式中选择好友 → 生成挑战链接\n2. 分享到抖音（视频/消息）\n3. 玩家 B 点击链接 → 进入游戏 → 答相同 5 题\n4. 双方各答完 → 揭晓结果\n5. 结果页：\n   - 胜方：胜利动画 + 奖杯 + \"+50 金币\"\n   - 败方：鼓励文字 + \"不服？再来一局\" → 分享按钮\n6. 核心裂变：不服输 → 再来 → 分享给更多人\n\nPK 积分系统：\n- 胜 +3 分，平 +1 分，负 +0 分\n- 每周重置排行\n- 前 10 名获得称号 + 金币奖励\n```\n\n### 6.2 \"你能全对吗？\" 短视频分享\n\n```\n触发条件：连对 5+ 题 / 通关 Boss 关 / PK 胜利\n自动生成 15 秒短视频：\n  - 答题过程回放（加速 ×2）\n  - 连击特效叠加\n  - 最终得分 + \"你能超越我吗？\"\n一键分享到抖音 → 带游戏入口链接\n```\n\n### 6.3 求助好友\n\n```\n触发条件：答错且只剩 1 条命\n选项：\"求助好友\" → 生成分享卡片\n好友点击 → 好友获得 10 金币 + 玩家恢复 1 条命\n每日求助上限：3 次\n```\n\n### 6.4 每日成语挑战\n\n```\n每天 1 道特殊题（全平台统一）：\n  - 成语 + 图片提示（如一张画了蛇和脚的图 → 画蛇添足）\n  - 或：emoji 组合猜成语\n  - 难度偏中高\n  - 全平台排行榜：\"今日全对率：23%\"\n  - FOMO 驱动：\"只有 12% 的人答对了今天的题目\"\n\n奖励：\n  - 答对：50 金币 + 1 碎片\n  - 分享答题结果到抖音：额外 20 金币\n```\n\n### 6.5 好友排行榜\n\n```\n维度：\n  - 闯关进度（已通关数）\n  - 限时挑战最高分\n  - PK 积分\n  - 图鉴收集数\n使用 tt.getFriendCloudStorage() 实时获取好友数据\n```\n\n---\n\n## 七、变现方案\n\n### 7.1 广告收入（IAA — 主力）\n\n#### 广告位详细设计\n\n**广告位 1：揭示 1 字（激励视频）**\n\n| 属性 | 值 |\n|------|-----|\n| 触发条件 | 答题中，玩家点击\"揭示\"按钮 |\n| 广告类型 | 激励视频（穿山甲 rewardedVideoAd） |\n| 视频时长 | 15-30 秒 |\n| 用户奖励 | 自动填入第 1 个正确字 |\n| UI 设计 | 答题区上方小按钮：\"揭示 1 字 📖\" + 播放图标 |\n| 预估触发率 | 每关使用 1-2 次，约 60-70% 玩家会使用 |\n\n**广告位 2：去干扰（激励视频）**\n\n| 属性 | 值 |\n|------|-----|\n| 触发条件 | 答题中，玩家点击\"去干扰\"按钮 |\n| 广告类型 | 激励视频 |\n| 用户奖励 | 移除 2 个错误候选字 |\n| UI 设计 | 候选字区下方按钮：\"去掉 2 个 ✂️\" |\n| 预估触发率 | 每关 1-2 次，约 50% 玩家使用 |\n\n**广告位 3：双倍结算（激励视频）**\n\n| 属性 | 值 |\n|------|-----|\n| 触发条件 | 关卡结算页 |\n| 广告类型 | 激励视频 |\n| 用户奖励 | 本关金币奖励翻倍 |\n| UI 设计 | 结算页底部：\"领取 ×1\" vs \"看视频领取 ×2\" |\n| 预估触发率 | 55-65%（成功心情好，接受度高） |\n\n**广告位 4：额外生命（激励视频）**\n\n| 属性 | 值 |\n|------|-----|\n| 触发条件 | 生命值归零，游戏结束 |\n| 广告类型 | 激励视频 |\n| 用户奖励 | 恢复 3 条命，继续答题 |\n| UI 设计 | 失败弹窗：左侧\"结束\"，右侧\"看视频继续\"（金色高亮） |\n| 预估触发率 | 70-80%（沉没成本高，续命意愿强） |\n\n**广告位 5：关卡间插屏**\n\n| 属性 | 值 |\n|------|-----|\n| 触发条件 | 每通过 2 关后，结算页 → 返回地图时 |\n| 广告类型 | 插屏广告（5 秒后可关闭） |\n| 用户奖励 | 无 |\n| UI 设计 | 全屏展示，右上角 5 秒倒计时 |\n| 预估频率 | 2-3 次/天 |\n\n**广告位 6：每日签到翻倍**\n\n| 属性 | 值 |\n|------|-----|\n| 触发条件 | 每日登录签到时 |\n| 广告类型 | 激励视频 |\n| 用户奖励 | 今日签到奖励翻倍 |\n\n### 7.2 广告频率控制（防骚扰）\n\n```\n规则：\n- 同一广告位两次触发最小间隔：90 秒\n- 激励视频每日总上限：15 次\n- 插屏广告每日总上限：8 次\n- 连续 2 次失败后暂停插屏展示\n- 新用户前 3 关不展示任何广告\n- 限时挑战模式不展示插屏（沉浸体验）\n```\n\n### 7.3 收入预估\n\n| DAU | 激励视频/DAU | 插屏/DAU | 激励 eCPM | 插屏 eCPM | 日收入 | 月收入 |\n|-----|-------------|----------|-----------|-----------|--------|--------|\n| 3K | 4 次 | 2 次 | ¥80 | ¥35 | ¥1,020 | ¥30,600 |\n| 10K | 4 次 | 2 次 | ¥80 | ¥35 | ¥3,400 | ¥102,000 |\n| 30K | 4 次 | 2 次 | ¥80 | ¥35 | ¥10,200 | ¥306,000 |\n\n> ARPU ≈ ¥0.34/天\n\n**扣除平台分成（40%）后开发者实得：月 ¥18,360（3K DAU）/ ¥61,200（10K DAU）/ ¥183,600（30K DAU）**\n\n### 7.4 内购道具（V1.1 迭代）\n\n| 道具 | 价格（¥） | 效果 | 上线时机 |\n|------|-----------|------|----------|\n| 去广告 | 8 | 永久移除插屏，激励视频按钮变为金币购买 | V1.1 |\n| 金币包 S | 3 | 200 金币 | V1.1 |\n| 金币包 M | 12 | 1000 金币（+10% 赠送） | V1.1 |\n| 金币包 L | 25 | 2500 金币（+20% 赠送） | V1.1 |\n| 月卡 | 15/月 | 每日 100 金币 + 专属皮肤 + 去广告 | V1.2 |\n\n### 7.5 盈利关键假设 [待测试]\n\n| 假设 | 基础值 | 依据 |\n|------|--------|------|\n| 激励视频 eCPM | ¥80/千次 | 文字益智品类中位数 |\n| 留存率 | 次日 35%，7 日 18%，30 日 6% | 文字游戏品类平均 |\n| 人均广告次数 | 6 次/天 | 与调研数据一致 |\n| 视频完成率 | 90% | 教育类用户观看意愿高 |\n| 限时挑战参与率 | 40% DAU | 基于竞品数据估算 |\n| PK 裂变系数 | 1.3（每个用户带来 0.3 个新用户） | 文字游戏社交传播效率 |\n\n---\n\n## 八、技术方案\n\n### 8.1 技术栈选型\n\n| 组件 | 选型 | 理由 |\n|------|------|------|\n| 渲染引擎 | **TTML + TTSS**（抖音小程序原生） | 纯文字游戏，DOM 渲染更快开发，无需 Canvas |\n| 编程语言 | **原生 JavaScript**（ES6+） | 最小依赖，最快开发 |\n| 动画 | CSS Animation + JS 补间 | 文字飞入/弹出效果用 CSS 足够 |\n| 音频 | `tt.createInnerAudioContext()` | 抖音原生 API |\n| 广告 | 穿山甲 SDK（csjplatform.com） | 抖音官方广告平台 |\n| 数据存储 | `tt.setStorageSync()` + 云开发 | 本地进度 + 云端排行/PK |\n| 社交 | `tt.shareAppMessage()` + `tt.getFriendCloudStorage()` | 抖音好友关系链 |\n| 构建工具 | 无 | 小程序直接上传开发者工具 |\n\n**选择 TTML（DOM）而非 Canvas 的理由**：\n- 成语游戏无复杂图形，文字 + 按钮 = DOM 更高效\n- CSS 动画性能足够（文字飞入、缩放、抖动）\n- 开发效率比 Canvas 高 30-40%\n- 可复用三消游戏的广告管理、社交、经济模块\n\n### 8.2 项目文件结构\n\n```\nidiom-master/\n├── app.js                    # 小程序入口（App 生命周期）\n├── app.json                  # 页面路由 + 全局配置\n├── app.ttss                  # 全局样式（国风主题）\n├── project.config.json       # 抖音开发者工具配置\n│\n├── pages/\n│   ├── home/                 # 主页\n│   │   ├── index.js          # 模式选择 + 每日入口 + 角色/地图入口\n│   │   ├── index.ttml\n│   │   └── index.ttss\n│   ├── play/                 # 答题页\n│   │   ├── index.js          # 出题逻辑 + 答题判定 + 连击系统\n│   │   ├── index.ttml\n│   │   └── index.ttss\n│   ├── result/               # 结算页\n│   │   ├── index.js          # 星级 + 奖励 + 广告（双倍）+ 分享\n│   │   ├── index.ttml\n│   │   └── index.ttss\n│   ├── timed/                # 限时挑战\n│   │   ├── index.js          # 60s 倒计时 + 无限出题 + 排行榜提交\n│   │   ├── index.ttml\n│   │   └── index.ttss\n│   ├── pk/                   # 好友 PK\n│   │   ├── index.js          # 5 题 PK + 结果揭晓\n│   │   ├── index.ttml\n│   │   └── index.ttss\n│   ├── collection/           # 成语图鉴\n│   │   ├── index.js          # 分类浏览 + 搜索 + 详情\n│   │   ├── index.ttml\n│   │   └── index.ttss\n│   ├── leaderboard/          # 排行榜\n│   │   ├── index.js          # 好友排行 + 全局排行\n│   │   ├── index.ttml\n│   │   └── index.ttss\n│   ├── characters/           # 角色选择\n│   │   ├── index.js          # 角色列表 + 技能 + 皮肤\n│   │   ├── index.ttml\n│   │   └── index.ttss\n│   └── daily/                # 每日挑战\n│       ├── index.js          # 每日 1 题 + 统计\n│       ├── index.ttml\n│       └── index.ttss\n│\n├── components/\n│   ├── tile-char/            # 候选字组件（点击 + 飞入动画）\n│   │   ├── index.js\n│   │   ├── index.ttml\n│   │   └── index.ttss\n│   ├── idiom-slot/           # 成语填空组件（4 个空位）\n│   │   ├── index.js\n│   │   ├── index.ttml\n│   │   └── index.ttss\n│   ├── ad-modal/             # 广告弹窗组件（激励视频/插屏通用）\n│   │   ├── index.js\n│   │   ├── index.ttml\n│   │   └── index.ttss\n│   ├── combo-display/        # 连击显示组件（数字 + 特效）\n│   ├── star-rating/          # 星级评定组件\n│   └── share-card/           # 分享卡片生成组件\n│\n├── utils/\n│   ├── idiom-engine.js       # 出题引擎（选题 + 干扰字生成）\n│   ├── judge.js              # 答题判定（正确/错误/撤销）\n│   ├── combo.js              # 连击计算与特效触发\n│   ├── pk-logic.js           # PK 匹配、出题同步、结算\n│   ├── ad-manager.js         # 穿山甲广告管理（从三消项目复用）\n│   ├── social.js             # 分享 + 好友关系链（从三消项目复用）\n│   ├── economy.js            # 金币/提示经济系统（从三消项目复用）\n│   ├── storage.js            # 持久化封装（从三消项目复用）\n│   ├── daily.js              # 每日挑战 + 每日任务\n│   └── cloud.js              # 云开发封装（排行榜 + PK 数据）\n│\n├── data/\n│   ├── idioms/               # 成语数据库（按难度分文件）\n│   │   ├── easy.json         # ★ 简单（500 个）\n│   │   ├── medium.json       # ★★ 中等（500 个）\n│   │   ├── hard.json         # ★★★ 困难（500 个）\n│   │   └── master.json       # ★★★★ 大师（500 个）\n│   ├── levels.json           # 关卡配置（50 关）\n│   ├── characters.json       # 角色配置\n│   ├── skins.json            # 皮肤配置\n│   ├── daily-tasks.json      # 每日任务模板\n│   └── economy.json          # 经济数值配置\n│\n├── assets/\n│   ├── icons/                # 分类图标（动物/数字/历史等，< 50KB）\n│   ├── characters/           # 角色头像（4 个 × 16KB = 64KB）\n│   ├── backgrounds/          # 答题背景（5 个 × 30KB = 150KB）\n│   ├── effects/              # 特效帧（连击/正确/错误，< 100KB）\n│   └── audio/                # 音效（< 200KB 总计）\n│       ├── sfx/              # 短音效\n│       └── bgm/              # 背景音乐\n│\n└── README.md\n```\n\n### 8.3 可复用三消游戏框架的模块\n\n| 模块 | 三消项目文件 | 复用程度 | 修改内容 |\n|------|-------------|----------|----------|\n| 广告管理 | `ad-manager.js` | **90%** | 调整广告位配置 |\n| 社交分享 | `social.js` | **80%** | 改分享文案和图片 |\n| 经济系统 | `economy.js` | **70%** | 调整金币数值 |\n| 数据存储 | `storage.js` | **95%** | 几乎直接复用 |\n| 云开发 | `cloud.js` | **80%** | 调整排行榜字段 |\n| 平台适配 | `platform/` | **100%** | 完全复用 |\n\n**预估框架复用可节省 40-50% 开发时间。**\n\n### 8.4 成语数据库设计\n\n```json\n{\n  \"id\": \"idiom_00001\",\n  \"idiom\": \"画蛇添足\",\n  \"chars\": [\"画\", \"蛇\", \"添\", \"足\"],\n  \"pinyin\": \"huà shé tiān zú\",\n  \"meaning\": \"比喻做了多余的事，反而不恰当\",\n  \"origin\": \"《战国策·齐策二》\",\n  \"example\": \"你已经写得很好了，再修改就是画蛇添足。\",\n  \"difficulty\": 1,\n  \"category\": [\"动物\", \"寓言\"],\n  \"tags\": [\"小学\", \"常用\"],\n  \"distractors_easy\": [\"龙\", \"虎\", \"飞\", \"跑\"],\n  \"distractors_hard\": [\"化\", \"它\", \"捻\", \"促\"],\n  \"frequency\": 95\n}\n```\n\n**数据库字段说明**：\n\n| 字段 | 类型 | 说明 |\n|------|------|------|\n| id | string | 唯一标识 |\n| idiom | string | 成语原文 |\n| chars | string[4] | 四个字（有序） |\n| pinyin | string | 拼音（带声调） |\n| meaning | string | 白话文释义 |\n| origin | string | 出处 |\n| example | string | 例句 |\n| difficulty | int | 难度等级（1-4） |\n| category | string[] | 类别标签 |\n| tags | string[] | 附加标签 |\n| distractors_easy | string[] | 简单干扰字（形音差异大） |\n| distractors_hard | string[] | 困难干扰字（形近/音近） |\n| frequency | int | 使用频率（1-100，100 最常用） |\n\n### 8.5 数据获取策略\n\n| 阶段 | 方式 | 数量 | 时间 |\n|------|------|------|------|\n| **首发** | AI 辅助生成 + 人工审核 | 2,000 条 | W1-W2 |\n| **V1.1** | 公开成语词典数据（合规抓取） | +3,000 条 | 上线后 2 周 |\n| **持续** | 每周新增 50 条 + 玩家投稿 | +200 条/月 | 持续 |\n\n**AI 生成流程**：\n1. 从《汉语成语大词典》提取成语列表（公开数据）\n2. AI 批量生成释义、拼音、例句、干扰字\n3. 人工审核：释义准确性、例句自然度、干扰字合理性\n4. 按难度分类 + 打标签\n5. 导入 JSON 数据库\n\n### 8.6 抖音小游戏 SDK 集成要点\n\n#### 入口文件 app.js\n\n```javascript\nApp({\n  onLaunch() {\n    // 初始化广告\n    this.adManager = new AdManager();\n    this.adManager.init();\n\n    // 初始化存储\n    this.storage = new Storage();\n    this.storage.init();\n\n    // 获取用户信息\n    tt.login({\n      success: (res) => {\n        this.userId = res.code;\n      }\n    });\n  },\n  globalData: {\n    userId: null,\n    adManager: null,\n    storage: null\n  }\n});\n```\n\n#### 出题引擎核心\n\n```javascript\n// idiom-engine.js\nclass IdiomEngine {\n  constructor(idiomDB) {\n    this.db = idiomDB; // 按难度分组的成语数据\n    this.history = [];  // 已出题目（避免重复）\n  }\n\n  generateQuestion(difficulty) {\n    const pool = this.db.getByDifficulty(difficulty);\n    const idiom = this.pickRandom(pool, this.history);\n    this.history.push(idiom.id);\n\n    const distractorCount = [0, 4, 6, 8, 8][difficulty];\n    const distractors = idiom.distractors_hard\n      ? idiom.distractors_hard.slice(0, distractorCount)\n      : this.generateDistractors(idiom, distractorCount);\n\n    return {\n      idiom: idiom,\n      slots: [null, null, null, null],\n      candidates: this.shuffle([...idiom.chars, ...distractors]),\n      answered: false\n    };\n  }\n}\n```\n\n---\n\n## 九、美术风格定义\n\n### 9.1 主题\n\n**\"国风书斋\"** — 中国传统文化气息，水墨淡雅，有书卷气但不老气\n\n### 9.2 色彩规范\n\n| 用途 | 颜色 | HEX | 说明 |\n|------|------|-----|------|\n| 主背景 | 宣纸色 | #F5F0E8 | 温暖米色，有纸质感 |\n| 卡片/面板 | 白色微黄 | #FFFDF7 | 比背景稍亮 |\n| 主色调 | 朱砂红 | #C84B31 | 按钮/高亮/正确 |\n| 辅助色 | 墨绿 | #2D6A4F | 进度条/成功 |\n| 金色强调 | 金箔色 | #D4A843 | 星星/奖励/高级 |\n| 文字主色 | 墨黑 | #2C2C2C | 正文 |\n| 文字副色 | 灰棕 | #8B7355 | 次要信息 |\n| 正确反馈 | 翠绿 | #27AE60 | 答对 |\n| 错误反馈 | 朱红 | #E74C3C | 答错 |\n| 连击特效 | 金色渐变 | #FFD700→#FFA500 | 连击高光 |\n\n### 9.3 字体规范\n\n| 用途 | 字体 | 说明 |\n|------|------|------|\n| 成语填空 | 思源宋体 / 系统宋体 | 正式感，有文化氛围 |\n| 候选字 | 系统默认圆体 | 清晰易辨认 |\n| 释义/正文 | 系统默认 | 可读性优先 |\n| 数字/分数 | DIN / 等宽 | 对齐美观 |\n\n### 9.4 UI 设计规范\n\n| 元素 | 规范 |\n|------|------|\n| 成语空位 | 4 个正方形，深色边框，底部有浅色横线，尺寸 60×60px |\n| 候选字按钮 | 圆角正方形（圆角 12px），朱砂红底 + 白字，按压缩小 5% |\n| 正确动画 | 空位变绿 + 对勾弹出 + 候选字位置出现绿色勾 |\n| 错误动画 | 空位变红 + 左右抖动 + 字飞回候选位置 |\n| 按钮 | 圆角矩形，朱砂红渐变，白色文字，按压缩小 5% |\n| 弹窗 | 白色圆角面板 + 半透明遮罩，底部滑入 |\n| 星星 | 金色五角星，从左到右依次弹出 |\n| 连击文字 | 从小到大弹出，金色描边，0.3s 淡出 |\n\n### 9.5 章节视觉\n\n| 章节 | 背景元素 | 色调 |\n|------|----------|------|\n| 初学启蒙 | 竹简 + 晨光 | 浅黄暖色 |\n| 蒙学进阶 | 书桌 + 茶杯 | 橙色暖调 |\n| 经典成语 | 窗外夕阳 + 书架 | 深橙红 |\n| 典故深处 | 月光 + 古书 | 深蓝紫 |\n| 博学大师 | 星空 + 卷轴 | 星空金黑 |\n\n---\n\n## 十、新手引导流程\n\n### 10.1 引导序列\n\n| 步骤 | 时间 | 触发条件 | 引导动作 | UI 表现 |\n|------|------|----------|----------|---------|\n| T1 | 0-3s | 第 1 关第 1 题 | 显示成语释义 + 高亮第 1 个正确候选字 | 半透明遮罩 + 箭头 + 手指动画 |\n| T2 | 3-6s | 玩家点击第 1 个字 | 字飞入空位 + 自动高亮第 2 个正确字 | 继续引导 |\n| T3 | 6-10s | 4 字填完（引导完成） | 正确动画 + 释义弹出 | \"心花怒放：形容非常开心！\" |\n| T4 | 10-15s | 第 2 题出现 | 高亮第 1 个字，其余自由操作 | 逐步减少引导 |\n| T5 | 15-25s | 第 3-5 题 | 无引导，自由作答 | — |\n| T6 | 25-30s | 连对 3 题 | 连击特效触发 | \"连击 ×3！太棒了！\" |\n| T7 | 30-35s | 第 7 题出错 | 红色抖动 + 引导使用提示按钮 | \"卡住了？试试揭示一个字\" |\n| T8 | 35-40s | 第 1 关完成 | 星级评定 + 结算页 | \"完美通关！\" |\n\n### 10.2 引导设计原则\n\n- 第 1 关完全引导，确保成功体验\n- 第 2-3 关逐步放手，只在关键新功能出现时引导\n- 第 4 关起无引导\n- 智能跳过：如果检测到玩家已理解操作（如 3 秒内自主答题），跳过后续引导\n\n---\n\n## 十一、开发排期（3 周里程碑）\n\n### Week 1：核心玩法（MVP）\n\n| 天 | 任务 | 交付物 |\n|----|------|--------|\n| D1 | 项目搭建 + TTML 页面结构 + 全局样式 | 可运行的小程序框架 |\n| D1 | 成语数据库设计 + AI 生成 500 条初始数据 | idioms/easy.json |\n| D2 | 出题引擎（选题 + 干扰字 + 随机排列） | 可生成完整题目 |\n| D2 | 答题界面（空位 + 候选字 + 点击交互） | 可交互的答题页 |\n| D3 | 答题判定（正确/错误动画 + 生命系统） | 完整的单题循环 |\n| D3 | 连击系统（计算 + 特效 + 加分） | 连击反馈完整 |\n| D4 | 关卡配置系统 + JSON 加载 | 可配置不同关卡 |\n| D4 | 前 20 关数据制作 + 关卡地图页面 | 20 个可玩关卡 |\n| D5 | 新手引导序列 + W1 内测 | 稳定可玩的 20 关 Demo |\n\n**W1 里程碑验收**：20 关完整可玩，含教学引导、连击系统、生命值、音效。\n\n### Week 2：完整体验 + 社交\n\n| 天 | 任务 | 交付物 |\n|----|------|--------|\n| D6 | 限时挑战模式 + 倒计时 + 排行 | 限时模式可玩 |\n| D6 | 成语图鉴系统（收集 + 分类 + 详情） | 图鉴页完成 |\n| D7 | 提示系统（揭示/去干扰/跳过）+ 金币消耗 | 所有道具就绪 |\n| D7 | 每日系统（登录/任务/挑战） | 每日内容 |\n| D8 | 好友 PK 模式 + 云端数据同步 | PK 可玩 |\n| D8 | 抖音分享集成 + 短视频分享 | 社交分享就绪 |\n| D9 | 角色系统 + 皮肤系统 | 4 角色 + 3 皮肤 |\n| D9 | 关卡 21-50 数据制作 | 50 关完整 |\n| D10 | W2 内测 + Bug 修复 | 稳定可玩的 50 关 + 社交 |\n\n**W2 里程碑验收**：50 关 + 三模式 + 图鉴 + 角色 + 社交分享。\n\n### Week 3：变现 + 上线\n\n| 天 | 任务 | 交付物 |\n|----|------|--------|\n| D11 | 穿山甲 SDK 集成（复用三消广告管理） | 广告可展示 |\n| D11 | 6 个广告位 UI + 频率控制 | 广告系统完成 |\n| D12 | 数据埋点（复用三消埋点框架） | 关键事件全覆盖 |\n| D12 | 包体优化 + 资源压缩 | < 2MB |\n| D13 | 全量测试 + Bug 修复 | 无阻塞性 Bug |\n| D13 | 软著材料提交 | 提审准备 |\n| D14 | 抖音提审 | 提交审核 |\n| D14 | 备用：修复审核反馈 | 快速迭代 |\n| D15 | 上线 + 监控首日数据 | 正式发布 |\n\n**W3 里程碑验收**：游戏上架抖音小游戏平台，广告变现运行正常。\n\n### 11.1 关键依赖\n\n| 依赖项 | 来源 | 截止时间 | 风险 |\n|--------|------|----------|------|\n| 抖音开发者账号 | 复用三消项目 | 已有 | 无 |\n| 穿山甲广告账号 | 复用三消项目 | 已有 | 无 |\n| 软著 | 复用三消项目主体 | 提审前 | 低 |\n| 成语数据库 2000 条 | AI 生成 + 人工审核 | D2-D5 | 中（需人工审核） |\n| 角色头像 4 张 | AI 绘制 | W1 结束 | 低 |\n| 背景图 5 张 | AI 绘制 | W2 结束 | 低 |\n| 音效 10-15 个 | AI 生成 | W1 结束 | 低 |\n\n---\n\n## 十二、数据埋点与运营\n\n### 12.1 关键指标\n\n| 指标 | 定义 | 目标值 | 告警阈值 |\n|------|------|--------|----------|\n| 次日留存 | D1/D0 | 35%+ | < 25% |\n| 7 日留存 | D7/D0 | 18%+ | < 10% |\n| 平均会话时长 | — | 6+ 分钟 | < 3 分钟 |\n| 人均广告次数/天 | — | 6+ 次 | < 3 次 |\n| 激励视频完成率 | — | 90%+ | < 75% |\n| 新手引导完成率 | 完成教学关卡比例 | 95%+ | < 80% |\n| 关卡通过率（前 10 关） | 单关通过比例 | 85%+ | < 70% |\n| PK 参与率 | DAU 中参与 PK 比例 | 30%+ | < 15% |\n| 图鉴收集率 | 人均收集成语数 | 50+/周 | < 20/周 |\n| ARPU | 日收入/DAU | ¥0.34+ | < ¥0.15 |\n\n### 12.2 埋点事件\n\n```javascript\nconst EVENTS = {\n  GAME_START: 'game_start',           // 游戏启动\n  TUTORIAL_STEP: 'tutorial_step',     // 引导步骤\n  LEVEL_START: 'level_start',         // 关卡开始\n  QUESTION_ANSWER: 'question_answer', // 答题结果（正确/错误/用时/是否用提示）\n  LEVEL_COMPLETE: 'level_complete',   // 关卡完成（正确率/星级/金币）\n  LEVEL_FAIL: 'level_fail',           // 关卡失败（剩余生命/第几题失败）\n  COMBO_HIT: 'combo_hit',             // 连击数（N 连击触发）\n  HINT_USE: 'hint_use',               // 使用提示（类型：揭示/去干扰/跳过）\n  AD_SHOW: 'ad_show',                 // 广告展示（广告位/是否完成）\n  SHARE: 'share',                     // 分享（类型：PK/求助/成绩/每日挑战）\n  PK_START: 'pk_start',               // PK 开始\n  PK_RESULT: 'pk_result',             // PK 结果（胜/负/平）\n  TIMED_START: 'timed_start',         // 限时挑战开始\n  TIMED_END: 'timed_end',             // 限时挑战结束（分数/答题数）\n  COLLECTION_UNLOCK: 'collection_unlock', // 解锁新成语\n  CHARACTER_USE: 'character_use',     // 角色使用\n};\n```\n\n---\n\n## 十三、风险与缓解\n\n| 风险 | 概率 | 影响 | 缓解措施 |\n|------|------|------|----------|\n| 成语数据质量差 | 中 | 玩家信任度下降 | AI 生成后必须人工审核释义准确性 |\n| 成语歧义（多组成语） | 中 | 玩家困惑 | 出题时排除有歧义的成语；提供释义辅助 |\n| 互动性不如三消 | 中 | 留存偏低 | 用 PK、限时、排行弥补；加快节奏 |\n| 题库消耗过快 | 中 | 内容枯竭 | 首发 2000 条 + 每周更新；按频率分配保证 50 关不重复 |\n| 广告 eCPM 偏低 | 中 | 收入不足 | 增加激励视频比重；优化提示触发点 |\n| 文字游戏天花板低 | 中 | DAU 上限低 | 作为矩阵第二产品，不追求单一爆款 |\n\n---\n\n## 十四、版本规划\n\n| 版本 | 时间 | 内容 |\n|------|------|------|\n| **V1.0** | 第 3 周末 | 50 关 + IAA 广告 + 基础社交 + 4 角色 + 图鉴 |\n| V1.1 | 上线后 2 周 | 内购道具 + 题库扩充至 5000 + 新章节 51-80 关 |\n| V1.2 | 上线后 4 周 | 月卡系统 + 每周挑战赛 + 新角色 + 皮肤商店 |\n| V1.3 | 上线后 6 周 | 微信小游戏版本上线 |\n| V2.0 | 上线后 2 月 | Emoji 猜成语模式 + 看图猜成语 + 成语接龙模式 |\n\n---\n\n## 附录 A：调参表\n\n```\n变量                       | 基础值   | 最小值 | 最大值 | 调参备注\n---------------------------|---------|--------|--------|---------------------------\n初始生命值                   | 5       | 3      | 8      | ★ 简单关 5，★★★ 关 3 [待测试]\n每关题数                     | 10      | 8      | 15     | Boss 关可增加\n候选字数（★ 简单）           | 8       | 6      | 10     | [待测试] 8 是否太容易\n候选字数（★★★★ 大师）      | 12      | 10     | 16     | [待测试]\n答错扣命数                   | 1       | 1      | 2      | 保持 1，降低挫败感\n续命恢复命数                 | 3       | 2      | 5      | [待测试]\n揭示提示金币价格              | 5       | 3      | 10     | [待测试]\n去干扰金币价格                | 8       | 5      | 15     | [待测试]\n连击加分倍率                  | 1+0.2×n | 1+0.1×n| 1+0.5×n| [待测试] 是否激励足够\n限时挑战时长                  | 60s     | 30s    | 120s   | [待测试]\n插屏广告间隔（关数）          | 2       | 1      | 4      | [待测试] 2 是否太频繁\n激励视频每日上限              | 15      | 10     | 25     | [待测试]\n```\n\n## 附录 B：音效列表\n\n| ID | 音效名 | 触发时机 | 时长 | 风格 |\n|----|--------|----------|------|------|\n| S01 | char_place | 字填入空位 | 0.1s | 清脆 click |\n| S02 | answer_correct | 答对整题 | 0.3s | 上升音阶叮 |\n| S03 | answer_wrong | 答错 | 0.3s | 低沉 buzz |\n| S04 | combo_3 | 3 连击 | 0.3s | 快乐升调 |\n| S05 | combo_5 | 5 连击 | 0.5s | 激动弦乐 |\n| S06 | combo_8 | 8+ 连击 | 0.6s | 欢呼 + 管弦 |\n| S07 | level_complete | 通关 | 1.0s | 古风 fanfare |\n| S08 | level_fail | 失败 | 0.8s | 柔和叹息 |\n| S09 | star_earned | 获得星星 | 0.2s | 叮—— |\n| S10 | hint_reveal | 使用揭示 | 0.2s | 翻书声 |\n| S11 | hint_remove | 使用去干扰 | 0.2s | 消散声 |\n| S12 | pk_win | PK 胜利 | 0.8s | 胜利鼓点 |\n| S13 | pk_lose | PK 失败 | 0.5s | 鼓励音 |\n| S14 | button_click | 按钮点击 | 0.08s | 轻触 |\n| S15 | timed_tick | 倒计时最后 10 秒 | 0.1s | 滴答 |\n\n## 附录 C：成语图鉴分类设计\n\n| 类别 | 数量（首发） | 图标 | 解锁条件 |\n|------|-------------|------|----------|\n| 动物世界 | 300 | 🐉 | 初始解锁 |\n| 数字密码 | 150 | 🔢 | 通关第 2 章 |\n| 历史典故 | 250 | 📜 | 通关第 3 章 |\n| 自然风光 | 150 | 🏔️ | 通关第 4 章 |\n| 人物描写 | 200 | 👤 | 收集 100 个成语 |\n| 寓言哲理 | 200 | 💡 | 收集 150 个成语 |\n| 军事谋略 | 150 | ⚔️ | 收集 200 个成语 |\n| 情感表达 | 150 | ❤️ | 收集 300 个成语 |\n| 四季时令 | 100 | 🌸 | 收集 400 个成语 |\n| 美食文化 | 100 | 🍜 | 收集 500 个成语 |\n\n每类收集满 → 解锁该类专属背景皮肤\n\n## 附录 D：变更日志\n\n| 版本 | 日期 | 变更内容 |\n|------|------|----------|\n| 1.0 | 2026-05-23 | 初始立项文档 |\n","numLines":1023,"startLine":1,"totalLines":1023}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f045c6f3c1114bbaaabd8a1e","type":"tool_result","content":"1\t// AdManager.js — 成语大闯关穿山甲SDK广告管理，适配DOM渲染\n2\t// 广告位ID配置在 ad-config.js 中，提审前替换为真实ID\n3\t\n4\tconst AD_PLACEMENTS = {\n5\t  HINT_REVEAL: 'hint_reveal',       // 揭示1字（激励视频）\n6\t  HINT_REMOVE: 'hint_remove',       // 去干扰（激励视频）\n7\t  DOUBLE_REWARD: 'double_reward',   // 双倍结算（激励视频）\n8\t  CONTINUE: 'continue',             // 续命（激励视频）\n9\t  INTERSTITIAL: 'interstitial',     // 关卡间插屏\n10\t  DAILY_DOUBLE: 'daily_double',     // 每日签到翻倍（激励视频）\n11\t};\n12\t\n13\tconst AD_LIMITS = {\n14\t  REWARDED_DAILY: 15,\n15\t  INTERSTITIAL_DAILY: 8,\n16\t  COOLDOWN_MS: 90000,\n17\t  NEW_USER_FREE_LEVELS: 3,\n18\t  INTERSTITIAL_LEVEL_INTERVAL: 2,\n19\t};\n20\t\n21\tclass AdManager {\n22\t  constructor(dataManager) {\n23\t    this.dm = dataManager;\n24\t    this._initStorage();\n25\t\n26\t    const config = (typeof AD_CONFIG !== 'undefined') ? AD_CONFIG : null;\n27\t    this.isDouyin = config ? !config.devMode\n28\t      : (typeof tt !== 'undefined' && typeof tt.createRewardedVideoAd === 'function');\n29\t    this.rewardedAd = null;\n30\t    this.interstitialAd = null;\n31\t    this._loadRetry = 0;\n32\t    this._maxRetry = config ? config.loadRetryCount : 2;\n33\t    this._loadTimeout = config ? config.loadTimeout : 10000;\n34\t\n35\t    if (this.isDouyin) this._initSDK();\n36\t\n37\t    this._pendingResolve = null;\n38\t    this._currentPlacement = null;\n39\t    this._showingUI = false;\n40\t    this._stubTimer = 0;\n41\t    this._stubResolve = null;\n42\t    this._stubPlacement = null;\n43\t    this._stubInterstitial = false;\n44\t  }\n45\t\n46\t  _initStorage() {\n47\t    if (!this.dm.data.adState) {\n48\t      this.dm.data.adState = {\n49\t        dailyRewarded: 0,\n50\t        dailyInterstitial: 0,\n51\t        lastShowTime: {},\n52\t        lastInterstitialLevel: 0,\n53\t        date: this._todayStr(),\n54\t        consecutiveFails: 0,\n55\t      };\n56\t      this.dm.save();\n57\t    }\n58\t    this.adState = this.dm.data.adState;\n59\t    this._resetDaily();\n60\t  }\n61\t\n62\t  _todayStr() { return new Date().toISOString().slice(0, 10); }\n63\t\n64\t  _resetDaily() {\n65\t    if (this.adState.date !== this._todayStr()) {\n66\t      this.adState.dailyRewarded = 0;\n67\t      this.adState.dailyInterstitial = 0;\n68\t      this.adState.date = this._todayStr();\n69\t      this.dm.save();\n70\t    }\n71\t  }\n72\t\n73\t  _getAdUnitId(type) {\n74\t    const config = (typeof AD_CONFIG !== 'undefined') ? AD_CONFIG : null;\n75\t    if (config && config.adUnitIds && config.adUnitIds[type]) return config.adUnitIds[type];\n76\t    return `adunit-placeholder-${type}`;\n77\t  }\n78\t\n79\t  _initSDK() {\n80\t    try {\n81\t      const rewardedId = this._getAdUnitId('rewarded');\n82\t      this.rewardedAd = tt.createRewardedVideoAd({ adUnitId: rewardedId });\n83\t      this.rewardedAd.onLoad(() => { this._loadRetry = 0; });\n84\t      this.rewardedAd.onError((err) => {\n85\t        console.warn('[AdManager] Rewarded ad error:', err);\n86\t        if (this._loadRetry < this._maxRetry) {\n87\t          this._loadRetry++;\n88\t          setTimeout(() => this.rewardedAd.load(), 1000 * this._loadRetry);\n89\t        }\n90\t      });\n91\t      this.rewardedAd.onClose((res) => {\n92\t        if (this._pendingResolve) {\n93\t          this._pendingResolve(res && res.isEnded);\n94\t          this._pendingResolve = null;\n95\t        }\n96\t      });\n97\t      this.rewardedAd.load();\n98\t\n99\t      const interstitialId = this._getAdUnitId('interstitial');\n100\t      this.interstitialAd = tt.createInterstitialAd({ adUnitId: interstitialId });\n101\t      this.interstitialAd.onLoad(() => {});\n102\t      this.interstitialAd.onError((err) => { console.warn('[AdManager] Interstitial ad error:', err); });\n103\t    } catch (e) {\n104\t      console.warn('[AdManager] SDK init failed, falling back to stub:', e);\n105\t      this.isDouyin = false;\n106\t    }\n107\t  }\n108\t\n109\t  isNewUser() { return this.dm.unlockedLevel <= AD_LIMITS.NEW_USER_FREE_LEVELS; }\n110\t\n111\t  canShowRewarded(placement) {\n112\t    this._resetDaily();\n113\t    if (this.isNewUser()) return false;\n114\t    if (this.adState.dailyRewarded >= AD_LIMITS.REWARDED_DAILY) return false;\n115\t    if (this._inCooldown(placement)) return false;\n116\t    return true;\n117\t  }\n118\t\n119\t  canShowInterstitial(currentLevel) {\n120\t    this._resetDaily();\n121\t    if (this.isNewUser()) return false;\n122\t    if (this.adState.dailyInterstitial >= AD_LIMITS.INTERSTITIAL_DAILY) return false;\n123\t    if (this.adState.consecutiveFails >= 2) return false;\n124\t    const lastLevel = this.adState.lastInterstitialLevel || 0;\n125\t    if (currentLevel - lastLevel < AD_LIMITS.INTERSTITIAL_LEVEL_INTERVAL) return false;\n126\t    if (this._inCooldown(AD_PLACEMENTS.INTERSTITIAL)) return false;\n127\t    return true;\n128\t  }\n129\t\n130\t  _inCooldown(placement) {\n131\t    const last = this.adState.lastShowTime[placement] || 0;\n132\t    return Date.now() - last < AD_LIMITS.COOLDOWN_MS;\n133\t  }\n134\t\n135\t  showRewarded(placement) {\n136\t    if (!this.canShowRewarded(placement)) return Promise.resolve(false);\n137\t    this._currentPlacement = placement;\n138\t\n139\t    if (this.isDouyin && this.rewardedAd) {\n140\t      return new Promise((resolve) => {\n141\t        this._pendingResolve = resolve;\n142\t        this.rewardedAd.show().catch(() => {\n143\t          this.rewardedAd.load().then(() => {\n144\t            this.rewardedAd.show().catch(() => resolve(false));\n145\t          }).catch(() => resolve(false));\n146\t        });\n147\t      }).then((success) => {\n148\t        if (success) this._onAdComplete(placement);\n149\t        return success;\n150\t      });\n151\t    }\n152\t\n153\t    return this._showStubAd(placement);\n154\t  }\n155\t\n156\t  showInterstitial(currentLevel) {\n157\t    if (!this.canShowInterstitial(currentLevel)) return Promise.resolve(false);\n158\t\n159\t    if (this.isDouyin && this.interstitialAd) {\n160\t      return new Promise((resolve) => {\n161\t        this.interstitialAd.show().then(() => {\n162\t          this.adState.dailyInterstitial++;\n163\t          this.adState.lastInterstitialLevel = currentLevel;\n164\t          this.adState.lastShowTime[AD_PLACEMENTS.INTERSTITIAL] = Date.now();\n165\t          this.dm.save();\n166\t          setTimeout(() => resolve(true), 5000);\n167\t        }).catch(() => resolve(false));\n168\t      });\n169\t    }\n170\t\n171\t    return new Promise((resolve) => {\n172\t      this._showingUI = true;\n173\t      this._stubInterstitial = true;\n174\t      this._stubTimer = 3;\n175\t      this.adState.dailyInterstitial++;\n176\t      this.adState.lastInterstitialLevel = currentLevel;\n177\t      this.adState.lastShowTime[AD_PLACEMENTS.INTERSTITIAL] = Date.now();\n178\t      this.dm.save();\n179\t      this._renderStubUI();\n180\t      setTimeout(() => {\n181\t        this._showingUI = false;\n182\t        this._stubInterstitial = false;\n183\t        this._removeStubUI();\n184\t        resolve(true);\n185\t      }, 3000);\n186\t    });\n187\t  }\n188\t\n189\t  _onAdComplete(placement) {\n190\t    this.adState.dailyRewarded++;\n191\t    this.adState.lastShowTime[placement] = Date.now();\n192\t    this.dm.save();\n193\t  }\n194\t\n195\t  _showStubAd(placement) {\n196\t    return new Promise((resolve) => {\n197\t      this._showingUI = true;\n198\t      this._stubPlacement = placement;\n199\t      this._stubTimer = 3;\n200\t      this._stubResolve = resolve;\n201\t      this._renderStubUI();\n202\t    });\n203\t  }\n204\t\n205\t  _completeStubAd(watched) {\n206\t    this._showingUI = false;\n207\t    if (watched) this._onAdComplete(this._stubPlacement);\n208\t    this._removeStubUI();\n209\t    if (this._stubResolve) {\n210\t      this._stubResolve(watched);\n211\t      this._stubResolve = null;\n212\t    }\n213\t  }\n214\t\n215\t  reportFail() { this.adState.consecutiveFails++; this.dm.save(); }\n216\t  reportSuccess() { this.adState.consecutiveFails = 0; this.dm.save(); }\n217\t\n218\t  // DOM-based stub ad rendering (适配成语游戏的HTML渲染)\n219\t  _renderStubUI() {\n220\t    if (document.getElementById('stub-ad-overlay')) return;\n221\t    const overlay = document.createElement('div');\n222\t    overlay.id = 'stub-ad-overlay';\n223\t    overlay.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.9);z-index:10000;display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:sans-serif;';\n224\t\n225\t    if (this._stubInterstitial) {\n226\t      overlay.innerHTML = `\n227\t        <div style=\"color:#FFB800;font-size:20px;font-weight:bold;margin-bottom:10px\">📢 广告</div>\n228\t        <div style=\"color:#CCC;font-size:14px\">插屏广告模拟</div>\n229\t        <div id=\"stub-timer\" style=\"color:#FFB800;font-size:28px;font-weight:bold;margin-top:20px\">3s</div>`;\n230\t    } else {\n231\t      overlay.innerHTML = `\n232\t        <div style=\"color:#FFB800;font-size:18px;font-weight:bold;margin-bottom:10px\">🎬 激励视频广告</div>\n233\t        <div style=\"color:#FFF;font-size:14px\">广告位: ${this._stubPlacement || ''}</div>\n234\t        <div style=\"color:#999;font-size:12px;margin-top:5px\">（开发模式模拟广告）</div>\n235\t        <div id=\"stub-timer\" style=\"color:#FFB800;font-size:32px;font-weight:bold;margin-top:20px\">3s</div>\n236\t        <button id=\"stub-complete-btn\" style=\"display:none;margin-top:20px;padding:12px 40px;background:#6BCB77;color:#fff;border:none;border-radius:22px;font-size:16px;font-weight:bold;cursor:pointer\">✓ 观看完成</button>\n237\t        <button id=\"stub-skip-btn\" style=\"display:none;margin-top:10px;padding:8px 20px;background:transparent;color:#888;border:none;font-size:12px;cursor:pointer\">跳过（无奖励）</button>`;\n238\t    }\n239\t    document.body.appendChild(overlay);\n240\t\n241\t    const timerEl = document.getElementById('stub-timer');\n242\t    const interval = setInterval(() => {\n243\t      this._stubTimer--;\n244\t      if (timerEl) timerEl.textContent = this._stubTimer > 0 ? `${this._stubTimer}s` : '';\n245\t      if (this._stubTimer <= 0) {\n246\t        clearInterval(interval);\n247\t        const completeBtn = document.getElementById('stub-complete-btn');\n248\t        const skipBtn = document.getElementById('stub-skip-btn');\n249\t        if (completeBtn) {\n250\t          completeBtn.style.display = 'block';\n251\t          completeBtn.onclick = () => this._completeStubAd(true);\n252\t        }\n253\t        if (skipBtn) {\n254\t          skipBtn.style.display = 'block';\n255\t          skipBtn.onclick = () => this._completeStubAd(false);\n256\t        }\n257\t      }\n258\t    }, 1000);\n259\t  }\n260\t\n261\t  _removeStubUI() {\n262\t    const overlay = document.getElementById('stub-ad-overlay');\n263\t    if (overlay) overlay.remove();\n264\t  }\n265\t\n266\t  // Ad button visibility helper\n267\t  static shouldShowAdButton(adManager, placement) {\n268\t    return adManager && adManager.canShowRewarded(placement);\n269\t  }\n270\t}\n271\t\n272\tif (typeof module !== 'undefined') module.exports = { AdManager, AD_PLACEMENTS, AD_LIMITS };\n273\t"}]},"parent_tool_use_id":null,"session_id":"7463fb62-2e03-4edd-abad-466ff792dff1","uuid":"47c9692c-0127-45b4-a71c-da2eb674e944","timestamp":"2026-05-23T10:38:04.287Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/src/js/AdManager.js","content":"// AdManager.js — 成语大闯关穿山甲SDK广告管理，适配DOM渲染\n// 广告位ID配置在 ad-config.js 中，提审前替换为真实ID\n\nconst AD_PLACEMENTS = {\n  HINT_REVEAL: 'hint_reveal',       // 揭示1字（激励视频）\n  HINT_REMOVE: 'hint_remove',       // 去干扰（激励视频）\n  DOUBLE_REWARD: 'double_reward',   // 双倍结算（激励视频）\n  CONTINUE: 'continue',             // 续命（激励视频）\n  INTERSTITIAL: 'interstitial',     // 关卡间插屏\n  DAILY_DOUBLE: 'daily_double',     // 每日签到翻倍（激励视频）\n};\n\nconst AD_LIMITS = {\n  REWARDED_DAILY: 15,\n  INTERSTITIAL_DAILY: 8,\n  COOLDOWN_MS: 90000,\n  NEW_USER_FREE_LEVELS: 3,\n  INTERSTITIAL_LEVEL_INTERVAL: 2,\n};\n\nclass AdManager {\n  constructor(dataManager) {\n    this.dm = dataManager;\n    this._initStorage();\n\n    const config = (typeof AD_CONFIG !== 'undefined') ? AD_CONFIG : null;\n    this.isDouyin = config ? !config.devMode\n      : (typeof tt !== 'undefined' && typeof tt.createRewardedVideoAd === 'function');\n    this.rewardedAd = null;\n    this.interstitialAd = null;\n    this._loadRetry = 0;\n    this._maxRetry = config ? config.loadRetryCount : 2;\n    this._loadTimeout = config ? config.loadTimeout : 10000;\n\n    if (this.isDouyin) this._initSDK();\n\n    this._pendingResolve = null;\n    this._currentPlacement = null;\n    this._showingUI = false;\n    this._stubTimer = 0;\n    this._stubResolve = null;\n    this._stubPlacement = null;\n    this._stubInterstitial = false;\n  }\n\n  _initStorage() {\n    if (!this.dm.data.adState) {\n      this.dm.data.adState = {\n        dailyRewarded: 0,\n        dailyInterstitial: 0,\n        lastShowTime: {},\n        lastInterstitialLevel: 0,\n        date: this._todayStr(),\n        consecutiveFails: 0,\n      };\n      this.dm.save();\n    }\n    this.adState = this.dm.data.adState;\n    this._resetDaily();\n  }\n\n  _todayStr() { return new Date().toISOString().slice(0, 10); }\n\n  _resetDaily() {\n    if (this.adState.date !== this._todayStr()) {\n      this.adState.dailyRewarded = 0;\n      this.adState.dailyInterstitial = 0;\n      this.adState.date = this._todayStr();\n      this.dm.save();\n    }\n  }\n\n  _getAdUnitId(type) {\n    const config = (typeof AD_CONFIG !== 'undefined') ? AD_CONFIG : null;\n    if (config && config.adUnitIds && config.adUnitIds[type]) return config.adUnitIds[type];\n    return `adunit-placeholder-${type}`;\n  }\n\n  _initSDK() {\n    try {\n      const rewardedId = this._getAdUnitId('rewarded');\n      this.rewardedAd = tt.createRewardedVideoAd({ adUnitId: rewardedId });\n      this.rewardedAd.onLoad(() => { this._loadRetry = 0; });\n      this.rewardedAd.onError((err) => {\n        console.warn('[AdManager] Rewarded ad error:', err);\n        if (this._loadRetry < this._maxRetry) {\n          this._loadRetry++;\n          setTimeout(() => this.rewardedAd.load(), 1000 * this._loadRetry);\n        }\n      });\n      this.rewardedAd.onClose((res) => {\n        if (this._pendingResolve) {\n          this._pendingResolve(res && res.isEnded);\n          this._pendingResolve = null;\n        }\n      });\n      this.rewardedAd.load();\n\n      const interstitialId = this._getAdUnitId('interstitial');\n      this.interstitialAd = tt.createInterstitialAd({ adUnitId: interstitialId });\n      this.interstitialAd.onLoad(() => {});\n      this.interstitialAd.onError((err) => { console.warn('[AdManager] Interstitial ad error:', err); });\n    } catch (e) {\n      console.warn('[AdManager] SDK init failed, falling back to stub:', e);\n      this.isDouyin = false;\n    }\n  }\n\n  isNewUser() { return this.dm.unlockedLevel <= AD_LIMITS.NEW_USER_FREE_LEVELS; }\n\n  canShowRewarded(placement) {\n    this._resetDaily();\n    if (this.isNewUser()) return false;\n    if (this.adState.dailyRewarded >= AD_LIMITS.REWARDED_DAILY) return false;\n    if (this._inCooldown(placement)) return false;\n    return true;\n  }\n\n  canShowInterstitial(currentLevel) {\n    this._resetDaily();\n    if (this.isNewUser()) return false;\n    if (this.adState.dailyInterstitial >= AD_LIMITS.INTERSTITIAL_DAILY) return false;\n    if (this.adState.consecutiveFails >= 2) return false;\n    const lastLevel = this.adState.lastInterstitialLevel || 0;\n    if (currentLevel - lastLevel < AD_LIMITS.INTERSTITIAL_LEVEL_INTERVAL) return false;\n    if (this._inCooldown(AD_PLACEMENTS.INTERSTITIAL)) return false;\n    return true;\n  }\n\n  _inCooldown(placement) {\n    const last = this.adState.lastShowTime[placement] || 0;\n    return Date.now() - last < AD_LIMITS.COOLDOWN_MS;\n  }\n\n  showRewarded(placement) {\n    if (!this.canShowRewarded(placement)) return Promise.resolve(false);\n    this._currentPlacement = placement;\n\n    if (this.isDouyin && this.rewardedAd) {\n      return new Promise((resolve) => {\n        this._pendingResolve = resolve;\n        this.rewardedAd.show().catch(() => {\n          this.rewardedAd.load().then(() => {\n            this.rewardedAd.show().catch(() => resolve(false));\n          }).catch(() => resolve(false));\n        });\n      }).then((success) => {\n        if (success) this._onAdComplete(placement);\n        return success;\n      });\n    }\n\n    return this._showStubAd(placement);\n  }\n\n  showInterstitial(currentLevel) {\n    if (!this.canShowInterstitial(currentLevel)) return Promise.resolve(false);\n\n    if (this.isDouyin && this.interstitialAd) {\n      return new Promise((resolve) => {\n        this.interstitialAd.show().then(() => {\n          this.adState.dailyInterstitial++;\n          this.adState.lastInterstitialLevel = currentLevel;\n          this.adState.lastShowTime[AD_PLACEMENTS.INTERSTITIAL] = Date.now();\n          this.dm.save();\n          setTimeout(() => resolve(true), 5000);\n        }).catch(() => resolve(false));\n      });\n    }\n\n    return new Promise((resolve) => {\n      this._showingUI = true;\n      this._stubInterstitial = true;\n      this._stubTimer = 3;\n      this.adState.dailyInterstitial++;\n      this.adState.lastInterstitialLevel = currentLevel;\n      this.adState.lastShowTime[AD_PLACEMENTS.INTERSTITIAL] = Date.now();\n      this.dm.save();\n      this._renderStubUI();\n      setTimeout(() => {\n        this._showingUI = false;\n        this._stubInterstitial = false;\n        this._removeStubUI();\n        resolve(true);\n      }, 3000);\n    });\n  }\n\n  _onAdComplete(placement) {\n    this.adState.dailyRewarded++;\n    this.adState.lastShowTime[placement] = Date.now();\n    this.dm.save();\n  }\n\n  _showStubAd(placement) {\n    return new Promise((resolve) => {\n      this._showingUI = true;\n      this._stubPlacement = placement;\n      this._stubTimer = 3;\n      this._stubResolve = resolve;\n      this._renderStubUI();\n    });\n  }\n\n  _completeStubAd(watched) {\n    this._showingUI = false;\n    if (watched) this._onAdComplete(this._stubPlacement);\n    this._removeStubUI();\n    if (this._stubResolve) {\n      this._stubResolve(watched);\n      this._stubResolve = null;\n    }\n  }\n\n  reportFail() { this.adState.consecutiveFails++; this.dm.save(); }\n  reportSuccess() { this.adState.consecutiveFails = 0; this.dm.save(); }\n\n  // DOM-based stub ad rendering (适配成语游戏的HTML渲染)\n  _renderStubUI() {\n    if (document.getElementById('stub-ad-overlay')) return;\n    const overlay = document.createElement('div');\n    overlay.id = 'stub-ad-overlay';\n    overlay.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.9);z-index:10000;display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:sans-serif;';\n\n    if (this._stubInterstitial) {\n      overlay.innerHTML = `\n        <div style=\"color:#FFB800;font-size:20px;font-weight:bold;margin-bottom:10px\">📢 广告</div>\n        <div style=\"color:#CCC;font-size:14px\">插屏广告模拟</div>\n        <div id=\"stub-timer\" style=\"color:#FFB800;font-size:28px;font-weight:bold;margin-top:20px\">3s</div>`;\n    } else {\n      overlay.innerHTML = `\n        <div style=\"color:#FFB800;font-size:18px;font-weight:bold;margin-bottom:10px\">🎬 激励视频广告</div>\n        <div style=\"color:#FFF;font-size:14px\">广告位: ${this._stubPlacement || ''}</div>\n        <div style=\"color:#999;font-size:12px;margin-top:5px\">（开发模式模拟广告）</div>\n        <div id=\"stub-timer\" style=\"color:#FFB800;font-size:32px;font-weight:bold;margin-top:20px\">3s</div>\n        <button id=\"stub-complete-btn\" style=\"display:none;margin-top:20px;padding:12px 40px;background:#6BCB77;color:#fff;border:none;border-radius:22px;font-size:16px;font-weight:bold;cursor:pointer\">✓ 观看完成</button>\n        <button id=\"stub-skip-btn\" style=\"display:none;margin-top:10px;padding:8px 20px;background:transparent;color:#888;border:none;font-size:12px;cursor:pointer\">跳过（无奖励）</button>`;\n    }\n    document.body.appendChild(overlay);\n\n    const timerEl = document.getElementById('stub-timer');\n    const interval = setInterval(() => {\n      this._stubTimer--;\n      if (timerEl) timerEl.textContent = this._stubTimer > 0 ? `${this._stubTimer}s` : '';\n      if (this._stubTimer <= 0) {\n        clearInterval(interval);\n        const completeBtn = document.getElementById('stub-complete-btn');\n        const skipBtn = document.getElementById('stub-skip-btn');\n        if (completeBtn) {\n          completeBtn.style.display = 'block';\n          completeBtn.onclick = () => this._completeStubAd(true);\n        }\n        if (skipBtn) {\n          skipBtn.style.display = 'block';\n          skipBtn.onclick = () => this._completeStubAd(false);\n        }\n      }\n    }, 1000);\n  }\n\n  _removeStubUI() {\n    const overlay = document.getElementById('stub-ad-overlay');\n    if (overlay) overlay.remove();\n  }\n\n  // Ad button visibility helper\n  static shouldShowAdButton(adManager, placement) {\n    return adManager && adManager.canShowRewarded(placement);\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { AdManager, AD_PLACEMENTS, AD_LIMITS };\n","numLines":273,"startLine":1,"totalLines":273}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_40ae24ac57764e82b5f9cfe4","type":"tool_result","content":"1\t// Game.js — Main game controller (W2 extended)\n2\t\n3\tclass Game {\n4\t  constructor() {\n5\t    this.engine = new IdiomEngine(IDIOM_DB);\n6\t    this.judge = new Judge();\n7\t    this.combo = new ComboSystem();\n8\t    this.data = new DataManager();\n9\t    this.audio = new AudioManager();\n10\t    this.tutorial = new Tutorial();\n11\t\n12\t    // W2 systems\n13\t    this.timed = new TimedChallenge(this.engine, this.combo, this.audio, this.data);\n14\t    this.collection = new IdiomCollection(IDIOM_DB, this.data);\n15\t    this.daily = new DailySystem(this.data, this.engine, this.audio);\n16\t    this.pk = new PKMode(this.engine, this.audio, this.data);\n17\t    this.social = new SocialManager(this.data);\n18\t    this.characters = new Characters(this.data);\n19\t\n20\t    // W3 systems\n21\t    this.adManager = new AdManager(this.data);\n22\t    this.analytics = new Analytics(this.data);\n23\t\n24\t    this.currentLevel = null;\n25\t    this.questions = [];\n26\t    this.questionIndex = 0;\n27\t    this.lives = 5;\n28\t    this.state = 'menu';\n29\t    this.usedHintThisQuestion = false;\n30\t    this.continuedOnce = false;\n31\t    this.levelResult = null;\n32\t    this.hintRevealCost = 5;\n33\t    this.hintRemoveCost = 5;\n34\t    this.skipCost = 10;\n35\t    this._doubledReward = false;\n36\t\n37\t    this.analytics.trackGameStart();\n38\t    this.analytics.startFlushTimer();\n39\t  }\n40\t\n41\t  startLevel(levelId) {\n42\t    const level = LEVELS.find(l => l.id === levelId);\n43\t    if (!level) { this.goToMenu(); return; }\n44\t    if (levelId > this.data.unlockedLevel && levelId > 1) {\n45\t      alert('关卡尚未解锁'); return;\n46\t    }\n47\t\n48\t    this.currentLevel = level;\n49\t    this.lives = level.lives;\n50\t    this.engine.reset();\n51\t    this.questions = this.engine.generateForLevel(level);\n52\t    this.questionIndex = 0;\n53\t    this.combo.reset();\n54\t    this.continuedOnce = false;\n55\t    this._doubledReward = false;\n56\t    this.state = 'playing';\n57\t    this.characters.resetLevelState();\n58\t\n59\t    this.analytics.trackLevelStart(levelId, level);\n60\t\n61\t    if (level.tutorial) this.tutorial.start(level.tutorial);\n62\t    else this.tutorial.end();\n63\t\n64\t    this._startQuestion();\n65\t    this.render();\n66\t  }\n67\t\n68\t  _startQuestion() {\n69\t    if (this.questionIndex >= this.questions.length) { this.finishLevel(); return; }\n70\t    const q = this.questions[this.questionIndex];\n71\t    this.judge.startQuestion(q);\n72\t    this.usedHintThisQuestion = false;\n73\t  }\n74\t\n75\t  pickChar(candidateIndex) {\n76\t    if (this.state !== 'playing') return null;\n77\t    const q = this.questions[this.questionIndex];\n78\t    if (!q || q.answered) return null;\n79\t    const result = this.judge.placeChar(candidateIndex);\n80\t    if (result.action === 'placed') {\n81\t      this.audio.playPlace();\n82\t      if (result.fillCount === 4) {\n83\t        setTimeout(() => this._handleFull(result), 400);\n84\t      }\n85\t    } else if (result.action === 'full') {\n86\t      setTimeout(() => this._handleFull(result), 200);\n87\t    } else if (result.action === 'used') {\n88\t      return null;\n89\t    }\n90\t    this.render();\n91\t    return result;\n92\t  }\n93\t\n94\t  _handleFull(result) {\n95\t    const q = this.questions[this.questionIndex];\n96\t    if (!q || q.answered) return;\n97\t    q.answered = true;\n98\t    q.correct = result.isCorrect;\n99\t\n100\t    if (result.isCorrect) {\n101\t      this.audio.playCorrect();\n102\t      const cr = this.combo.onCorrect(this.usedHintThisQuestion);\n103\t\n104\t      this.analytics.trackQuestionAnswer(true, 0, this.usedHintThisQuestion, cr.combo);\n105\t      this.analytics.trackComboHit(cr.combo, cr.totalGain);\n106\t\n107\t      // Character skill: combo boost\n108\t      const skillResult = this.characters.applySkill({ event: 'combo_bonus' });\n109\t      if (skillResult.triggered && skillResult.multiplier) {\n110\t        const bonus = Math.floor(cr.comboBonus * (skillResult.multiplier - 1));\n111\t        cr.comboBonus += bonus;\n112\t        this.combo.score += bonus;\n113\t        cr.totalGain += bonus;\n114\t      }\n115\t\n116\t      // Character skill: bonus exp\n117\t      const expResult = this.characters.applySkill({ event: 'correct' });\n118\t      if (expResult.triggered && expResult.bonus) {\n119\t        this.data.addExp(expResult.bonus);\n120\t      }\n121\t\n122\t      if (cr.combo >= 3) this.audio.playCombo(cr.combo);\n123\t      this.data.collectIdiom(q.idiom.id);\n124\t      this.daily.updateTaskProgress('answer', 1);\n125\t      this.daily.updateTaskProgress('combo', cr.combo >= 3 ? 1 : 0);\n126\t      q.comboResult = cr;\n127\t      this.render();\n128\t      setTimeout(() => { this.questionIndex++; this._startQuestion(); this.render(); }, 800);\n129\t    } else {\n130\t      // Character skill: lucky save\n131\t      const skillResult = this.characters.applySkill({ event: 'wrong' });\n132\t      if (skillResult.triggered) {\n133\t        this.audio.playHint();\n134\t        this.render();\n135\t        setTimeout(() => {\n136\t          q.answered = false; q.correct = null;\n137\t          this.judge.startQuestion(q);\n138\t          this.render();\n139\t        }, 800);\n140\t        return;\n141\t      }\n142\t\n143\t      this.audio.playWrong();\n144\t      this.combo.onWrong();\n145\t      this.lives--;\n146\t      this.analytics.trackQuestionAnswer(false, 0, false, 0);\n147\t      this.render();\n148\t      if (this.lives <= 0) {\n149\t        if (!this.continuedOnce) {\n150\t          document.getElementById('continue-modal').style.display = 'flex';\n151\t        } else {\n152\t          setTimeout(() => this.finishLevel(), 600);\n153\t        }\n154\t      } else {\n155\t        setTimeout(() => {\n156\t          q.answered = false; q.correct = null;\n157\t          this.judge.startQuestion(q);\n158\t          this.render();\n159\t        }, 600);\n160\t      }\n161\t    }\n162\t  }\n163\t\n164\t  removeSlot(slotIndex) {\n165\t    if (this.state !== 'playing') return null;\n166\t    const q = this.questions[this.questionIndex];\n167\t    if (!q || q.answered) return null;\n168\t    const result = this.judge.removeSlot(slotIndex);\n169\t    if (result.action === 'removed') this.audio.playPlace();\n170\t    this.render();\n171\t    return result;\n172\t  }\n173\t\n174\t  useHintReveal() {\n175\t    if (this.state !== 'playing') return null;\n176\t    const q = this.questions[this.questionIndex];\n177\t    if (!q || q.answered) return null;\n178\t    const fc = this.judge.getFillCount();\n179\t    if (fc >= 4) return null;\n180\t\n181\t    // Character skill: free hint\n182\t    const skillResult = this.characters.applySkill({ event: 'hint' });\n183\t    if (!skillResult.triggered) {\n184\t      if (this.data.coins < this.hintRevealCost) {\n185\t        alert('金币不足');\n186\t        return null;\n187\t      }\n188\t      this.data.spendCoins(this.hintRevealCost);\n189\t    }\n190\t\n191\t    const ch = this.judge.currentIdiom.chars[fc];\n192\t    const cand = q.candidates.find(c => c.char === ch && !c.used);\n193\t    if (!cand) return null;\n194\t    this.usedHintThisQuestion = true;\n195\t    this.audio.playHint();\n196\t    const result = this.judge.placeChar(cand.index);\n197\t    if (result.fillCount === 4) setTimeout(() => this._handleFull(result), 400);\n198\t    this.render();\n199\t    return result;\n200\t  }\n201\t\n202\t  useHintRemove() {\n203\t    if (this.state !== 'playing') return null;\n204\t    const q = this.questions[this.questionIndex];\n205\t    if (!q || q.answered) return null;\n206\t\n207\t    if (this.data.coins < this.hintRemoveCost) {\n208\t      alert('金币不足');\n209\t      return null;\n210\t    }\n211\t    this.data.spendCoins(this.hintRemoveCost);\n212\t\n213\t    const wrong = q.candidates.filter(c => !c.used && !this.judge.currentIdiom.chars.includes(c.char) && !c.removed);\n214\t    const removed = [];\n215\t    const cnt = Math.min(2, wrong.length);\n216\t    for (let i = 0; i < cnt; i++) {\n217\t      const idx = Math.floor(Math.random() * wrong.length);\n218\t      wrong[idx].removed = true;\n219\t      removed.push(wrong[idx]);\n220\t      wrong.splice(idx, 1);\n221\t    }\n222\t    this.audio.playRemove();\n223\t    this.render();\n224\t    return { action: 'removed_distractors', removed };\n225\t  }\n226\t\n227\t  skipQuestion() {\n228\t    if (this.state !== 'playing') return;\n229\t    if (this.data.coins < this.skipCost) {\n230\t      alert('金币不足');\n231\t      return;\n232\t    }\n233\t    this.data.spendCoins(this.skipCost);\n234\t    const q = this.questions[this.questionIndex];\n235\t    if (q) { q.answered = true; q.correct = false; q.skipped = true; }\n236\t    this.combo.onSkip();\n237\t    this.questionIndex++;\n238\t    this._startQuestion();\n239\t    this.render();\n240\t  }\n241\t\n242\t  continueWithAd() {\n243\t    if (this.continuedOnce) return;\n244\t    this.adManager.showRewarded(AD_PLACEMENTS.CONTINUE).then(success => {\n245\t      if (success) {\n246\t        this.analytics.trackAdShow(AD_PLACEMENTS.CONTINUE, true);\n247\t        this.lives = 3;\n248\t        this.continuedOnce = true;\n249\t        const q = this.questions[this.questionIndex];\n250\t        if (q) { q.answered = false; q.correct = null; this.judge.startQuestion(q); }\n251\t        document.getElementById('continue-modal').style.display = 'none';\n252\t        this.render();\n253\t      } else {\n254\t        this.analytics.trackAdShow(AD_PLACEMENTS.CONTINUE, false);\n255\t      }\n256\t    });\n257\t  }\n258\t\n259\t  finishLevel() {\n260\t    this.state = 'result';\n261\t    document.getElementById('continue-modal').style.display = 'none';\n262\t    const s = this.combo.getStats();\n263\t    const stars = this.combo.getStarRating(s.correctCount, this.questions.length);\n264\t\n265\t    if (stars > 0 && this.currentLevel) {\n266\t      this.data.setLevelStars(this.currentLevel.id, stars);\n267\t      this.data.addCoins(this.currentLevel.reward.coins);\n268\t      this.data.addScore(s.score);\n269\t      this.data.updateBestCombo(s.maxCombo);\n270\t      this.data.addExp(this.currentLevel.reward.exp || 10);\n271\t      this.daily.updateTaskProgress('level', 1);\n272\t      this.daily.updateTaskProgress('collect', s.correctCount);\n273\t      this.adManager.reportSuccess();\n274\t      this.analytics.trackLevelComplete(this.currentLevel.id, s.correctCount, this.questions.length, stars, this.currentLevel.reward.coins, s.maxCombo);\n275\t    } else {\n276\t      this.adManager.reportFail();\n277\t      this.analytics.trackLevelFail(this.currentLevel ? this.currentLevel.id : 0, s.correctCount, this.lives, this.questionIndex);\n278\t    }\n279\t\n280\t    this.levelResult = {\n281\t      stars, correctCount: s.correctCount, totalQuestions: this.questions.length,\n282\t      score: s.score, maxCombo: s.maxCombo,\n283\t      coins: stars > 0 ? this.currentLevel.reward.coins : 0\n284\t    };\n285\t    this._doubledReward = false;\n286\t    if (stars > 0) this.audio.playLevelWin(); else this.audio.playLevelFail();\n287\t    this.render();\n288\t\n289\t    // Show interstitial after successful level\n290\t    if (stars > 0 && this.currentLevel) {\n291\t      this.adManager.showInterstitial(this.currentLevel.id);\n292\t    }\n293\t  }\n294\t\n295\t  // W3: Double reward via ad\n296\t  doubleRewardWithAd() {\n297\t    if (this._doubledReward || !this.levelResult || this.levelResult.stars <= 0) return;\n298\t    this.adManager.showRewarded(AD_PLACEMENTS.DOUBLE_REWARD).then(success => {\n299\t      if (success) {\n300\t        this.analytics.trackAdShow(AD_PLACEMENTS.DOUBLE_REWARD, true);\n301\t        this._doubledReward = true;\n302\t        const extra = this.levelResult.coins;\n303\t        this.data.addCoins(extra);\n304\t        this.levelResult.coins *= 2;\n305\t        this.render();\n306\t      } else {\n307\t        this.analytics.trackAdShow(AD_PLACEMENTS.DOUBLE_REWARD, false);\n308\t      }\n309\t    });\n310\t  }\n311\t\n312\t  // W3: Ad-powered hint reveal\n313\t  useHintRevealWithAd() {\n314\t    if (!this.adManager.canShowRewarded(AD_PLACEMENTS.HINT_REVEAL)) {\n315\t      this.useHintReveal();\n316\t      return;\n317\t    }\n318\t    this.adManager.showRewarded(AD_PLACEMENTS.HINT_REVEAL).then(success => {\n319\t      if (success) {\n320\t        this.analytics.trackAdShow(AD_PLACEMENTS.HINT_REVEAL, true);\n321\t        this._doHintReveal(true);\n322\t      } else {\n323\t        this.analytics.trackAdShow(AD_PLACEMENTS.HINT_REVEAL, false);\n324\t        this.useHintReveal();\n325\t      }\n326\t    });\n327\t  }\n328\t\n329\t  // W3: Ad-powered hint remove\n330\t  useHintRemoveWithAd() {\n331\t    if (!this.adManager.canShowRewarded(AD_PLACEMENTS.HINT_REMOVE)) {\n332\t      this.useHintRemove();\n333\t      return;\n334\t    }\n335\t    this.adManager.showRewarded(AD_PLACEMENTS.HINT_REMOVE).then(success => {\n336\t      if (success) {\n337\t        this.analytics.trackAdShow(AD_PLACEMENTS.HINT_REMOVE, true);\n338\t        this._doHintRemove(true);\n339\t      } else {\n340\t        this.analytics.trackAdShow(AD_PLACEMENTS.HINT_REMOVE, false);\n341\t        this.useHintRemove();\n342\t      }\n343\t    });\n344\t  }\n345\t\n346\t  _doHintReveal(free) {\n347\t    if (this.state !== 'playing') return;\n348\t    const q = this.questions[this.questionIndex];\n349\t    if (!q || q.answered) return;\n350\t    const fc = this.judge.getFillCount();\n351\t    if (fc >= 4) return;\n352\t    if (!free) {\n353\t      const skillResult = this.characters.applySkill({ event: 'hint' });\n354\t      if (!skillResult.triggered) {\n355\t        if (this.data.coins < this.hintRevealCost) { alert('金币不足'); return; }\n356\t        this.data.spendCoins(this.hintRevealCost);\n357\t      }\n358\t    }\n359\t    const ch = this.judge.currentIdiom.chars[fc];\n360\t    const cand = q.candidates.find(c => c.char === ch && !c.used);\n361\t    if (!cand) return;\n362\t    this.usedHintThisQuestion = true;\n363\t    this.audio.playHint();\n364\t    this.analytics.trackHintUse('reveal', free ? 0 : this.hintRevealCost);\n365\t    const result = this.judge.placeChar(cand.index);\n366\t    if (result.fillCount === 4) setTimeout(() => this._handleFull(result), 400);\n367\t    this.render();\n368\t  }\n369\t\n370\t  _doHintRemove(free) {\n371\t    if (this.state !== 'playing') return;\n372\t    const q = this.questions[this.questionIndex];\n373\t    if (!q || q.answered) return;\n374\t    if (!free) {\n375\t      if (this.data.coins < this.hintRemoveCost) { alert('金币不足'); return; }\n376\t      this.data.spendCoins(this.hintRemoveCost);\n377\t    }\n378\t    const wrong = q.candidates.filter(c => !c.used && !this.judge.currentIdiom.chars.includes(c.char) && !c.removed);\n379\t    const cnt = Math.min(2, wrong.length);\n380\t    for (let i = 0; i < cnt; i++) {\n381\t      const idx = Math.floor(Math.random() * wrong.length);\n382\t      wrong[idx].removed = true;\n383\t      wrong.splice(idx, 1);\n384\t    }\n385\t    this.audio.playRemove();\n386\t    this.analytics.trackHintUse('remove', free ? 0 : this.hintRemoveCost);\n387\t    this.render();\n388\t  }\n389\t\n390\t  // W3: Daily double via ad\n391\t  dailyDoubleWithAd() {\n392\t    this.adManager.showRewarded(AD_PLACEMENTS.DAILY_DOUBLE).then(success => {\n393\t      if (success) {\n394\t        this.analytics.trackAdShow(AD_PLACEMENTS.DAILY_DOUBLE, true);\n395\t        this.daily.claimLoginDouble();\n396\t        this.render();\n397\t      }\n398\t    });\n399\t  }\n400\t\n401\t  // ===== W2: Timed Challenge =====\n402\t  startTimedChallenge() {\n403\t    this.state = 'timed';\n404\t    this.analytics.trackTimedStart();\n405\t    this.timed.onUpdate = (evt) => {\n406\t      if (evt === 'end') {\n407\t        this.state = 'timed_result';\n408\t        const r = this.timed.getResult();\n409\t        this.analytics.trackTimedEnd(r.score, r.correctCount, r.answeredCount, r.maxCombo);\n410\t      }\n411\t      this.render();\n412\t    };\n413\t    this.timed.start();\n414\t  }\n415\t\n416\t  // ===== W2: PK Mode =====\n417\t  startPK(opponentResult) {\n418\t    this.state = 'pk';\n419\t    this.analytics.trackPKStart();\n420\t    this.pk.onUpdate = (evt) => {\n421\t      if (evt === 'end') {\n422\t        this.state = 'pk_result';\n423\t        const r = this.pk.getResult();\n424\t        this.analytics.trackPKResult(r.won ? 'win' : 'lose', r.correctCount, r.time);\n425\t      }\n426\t      this.render();\n427\t    };\n428\t    this.pk.start(opponentResult);\n429\t  }\n430\t\n431\t  // ===== W2: Collection =====\n432\t  showCollection() {\n433\t    this.state = 'collection';\n434\t    this.render();\n435\t  }\n436\t\n437\t  // ===== W2: Daily =====\n438\t  showDaily() {\n439\t    this.state = 'daily';\n440\t    this.render();\n441\t  }\n442\t\n443\t  // ===== W2: Characters =====\n444\t  showCharacters() {\n445\t    this.state = 'characters';\n446\t    this.render();\n447\t  }\n448\t\n449\t  showLevelMap() {\n450\t    this.state = 'map';\n451\t    this.render();\n452\t  }\n453\t\n454\t  goToMenu() {\n455\t    this.state = 'menu';\n456\t    this.tutorial.end();\n457\t    this.render();\n458\t  }\n459\t\n460\t  getCurrentQuestion() { return this.questions[this.questionIndex]; }\n461\t\n462\t  render() { if (typeof renderUI === 'function') renderUI(this); }\n463\t}\n464\t\n465\tfunction handleHintReveal() { game.useHintRevealWithAd(); }\n466\tfunction handleHintRemove() { game.useHintRemoveWithAd(); }\n467\tfunction handleSkip() { game.skipQuestion(); }\n468\tfunction handleDoubleReward() { game.doubleRewardWithAd(); }\n469\tfunction handleDailyDouble() { game.dailyDoubleWithAd(); }\n470\t\n471\tif (typeof module !== 'undefined') module.exports = { Game };\n472\t"}]},"parent_tool_use_id":null,"session_id":"7463fb62-2e03-4edd-abad-466ff792dff1","uuid":"3176876e-bdbd-4bcb-ad8d-f7ffa0c6b6c8","timestamp":"2026-05-23T10:38:04.427Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/src/js/Game.js","content":"// Game.js — Main game controller (W2 extended)\n\nclass Game {\n  constructor() {\n    this.engine = new IdiomEngine(IDIOM_DB);\n    this.judge = new Judge();\n    this.combo = new ComboSystem();\n    this.data = new DataManager();\n    this.audio = new AudioManager();\n    this.tutorial = new Tutorial();\n\n    // W2 systems\n    this.timed = new TimedChallenge(this.engine, this.combo, this.audio, this.data);\n    this.collection = new IdiomCollection(IDIOM_DB, this.data);\n    this.daily = new DailySystem(this.data, this.engine, this.audio);\n    this.pk = new PKMode(this.engine, this.audio, this.data);\n    this.social = new SocialManager(this.data);\n    this.characters = new Characters(this.data);\n\n    // W3 systems\n    this.adManager = new AdManager(this.data);\n    this.analytics = new Analytics(this.data);\n\n    this.currentLevel = null;\n    this.questions = [];\n    this.questionIndex = 0;\n    this.lives = 5;\n    this.state = 'menu';\n    this.usedHintThisQuestion = false;\n    this.continuedOnce = false;\n    this.levelResult = null;\n    this.hintRevealCost = 5;\n    this.hintRemoveCost = 5;\n    this.skipCost = 10;\n    this._doubledReward = false;\n\n    this.analytics.trackGameStart();\n    this.analytics.startFlushTimer();\n  }\n\n  startLevel(levelId) {\n    const level = LEVELS.find(l => l.id === levelId);\n    if (!level) { this.goToMenu(); return; }\n    if (levelId > this.data.unlockedLevel && levelId > 1) {\n      alert('关卡尚未解锁'); return;\n    }\n\n    this.currentLevel = level;\n    this.lives = level.lives;\n    this.engine.reset();\n    this.questions = this.engine.generateForLevel(level);\n    this.questionIndex = 0;\n    this.combo.reset();\n    this.continuedOnce = false;\n    this._doubledReward = false;\n    this.state = 'playing';\n    this.characters.resetLevelState();\n\n    this.analytics.trackLevelStart(levelId, level);\n\n    if (level.tutorial) this.tutorial.start(level.tutorial);\n    else this.tutorial.end();\n\n    this._startQuestion();\n    this.render();\n  }\n\n  _startQuestion() {\n    if (this.questionIndex >= this.questions.length) { this.finishLevel(); return; }\n    const q = this.questions[this.questionIndex];\n    this.judge.startQuestion(q);\n    this.usedHintThisQuestion = false;\n  }\n\n  pickChar(candidateIndex) {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const result = this.judge.placeChar(candidateIndex);\n    if (result.action === 'placed') {\n      this.audio.playPlace();\n      if (result.fillCount === 4) {\n        setTimeout(() => this._handleFull(result), 400);\n      }\n    } else if (result.action === 'full') {\n      setTimeout(() => this._handleFull(result), 200);\n    } else if (result.action === 'used') {\n      return null;\n    }\n    this.render();\n    return result;\n  }\n\n  _handleFull(result) {\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return;\n    q.answered = true;\n    q.correct = result.isCorrect;\n\n    if (result.isCorrect) {\n      this.audio.playCorrect();\n      const cr = this.combo.onCorrect(this.usedHintThisQuestion);\n\n      this.analytics.trackQuestionAnswer(true, 0, this.usedHintThisQuestion, cr.combo);\n      this.analytics.trackComboHit(cr.combo, cr.totalGain);\n\n      // Character skill: combo boost\n      const skillResult = this.characters.applySkill({ event: 'combo_bonus' });\n      if (skillResult.triggered && skillResult.multiplier) {\n        const bonus = Math.floor(cr.comboBonus * (skillResult.multiplier - 1));\n        cr.comboBonus += bonus;\n        this.combo.score += bonus;\n        cr.totalGain += bonus;\n      }\n\n      // Character skill: bonus exp\n      const expResult = this.characters.applySkill({ event: 'correct' });\n      if (expResult.triggered && expResult.bonus) {\n        this.data.addExp(expResult.bonus);\n      }\n\n      if (cr.combo >= 3) this.audio.playCombo(cr.combo);\n      this.data.collectIdiom(q.idiom.id);\n      this.daily.updateTaskProgress('answer', 1);\n      this.daily.updateTaskProgress('combo', cr.combo >= 3 ? 1 : 0);\n      q.comboResult = cr;\n      this.render();\n      setTimeout(() => { this.questionIndex++; this._startQuestion(); this.render(); }, 800);\n    } else {\n      // Character skill: lucky save\n      const skillResult = this.characters.applySkill({ event: 'wrong' });\n      if (skillResult.triggered) {\n        this.audio.playHint();\n        this.render();\n        setTimeout(() => {\n          q.answered = false; q.correct = null;\n          this.judge.startQuestion(q);\n          this.render();\n        }, 800);\n        return;\n      }\n\n      this.audio.playWrong();\n      this.combo.onWrong();\n      this.lives--;\n      this.analytics.trackQuestionAnswer(false, 0, false, 0);\n      this.render();\n      if (this.lives <= 0) {\n        if (!this.continuedOnce) {\n          document.getElementById('continue-modal').style.display = 'flex';\n        } else {\n          setTimeout(() => this.finishLevel(), 600);\n        }\n      } else {\n        setTimeout(() => {\n          q.answered = false; q.correct = null;\n          this.judge.startQuestion(q);\n          this.render();\n        }, 600);\n      }\n    }\n  }\n\n  removeSlot(slotIndex) {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const result = this.judge.removeSlot(slotIndex);\n    if (result.action === 'removed') this.audio.playPlace();\n    this.render();\n    return result;\n  }\n\n  useHintReveal() {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const fc = this.judge.getFillCount();\n    if (fc >= 4) return null;\n\n    // Character skill: free hint\n    const skillResult = this.characters.applySkill({ event: 'hint' });\n    if (!skillResult.triggered) {\n      if (this.data.coins < this.hintRevealCost) {\n        alert('金币不足');\n        return null;\n      }\n      this.data.spendCoins(this.hintRevealCost);\n    }\n\n    const ch = this.judge.currentIdiom.chars[fc];\n    const cand = q.candidates.find(c => c.char === ch && !c.used);\n    if (!cand) return null;\n    this.usedHintThisQuestion = true;\n    this.audio.playHint();\n    const result = this.judge.placeChar(cand.index);\n    if (result.fillCount === 4) setTimeout(() => this._handleFull(result), 400);\n    this.render();\n    return result;\n  }\n\n  useHintRemove() {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n\n    if (this.data.coins < this.hintRemoveCost) {\n      alert('金币不足');\n      return null;\n    }\n    this.data.spendCoins(this.hintRemoveCost);\n\n    const wrong = q.candidates.filter(c => !c.used && !this.judge.currentIdiom.chars.includes(c.char) && !c.removed);\n    const removed = [];\n    const cnt = Math.min(2, wrong.length);\n    for (let i = 0; i < cnt; i++) {\n      const idx = Math.floor(Math.random() * wrong.length);\n      wrong[idx].removed = true;\n      removed.push(wrong[idx]);\n      wrong.splice(idx, 1);\n    }\n    this.audio.playRemove();\n    this.render();\n    return { action: 'removed_distractors', removed };\n  }\n\n  skipQuestion() {\n    if (this.state !== 'playing') return;\n    if (this.data.coins < this.skipCost) {\n      alert('金币不足');\n      return;\n    }\n    this.data.spendCoins(this.skipCost);\n    const q = this.questions[this.questionIndex];\n    if (q) { q.answered = true; q.correct = false; q.skipped = true; }\n    this.combo.onSkip();\n    this.questionIndex++;\n    this._startQuestion();\n    this.render();\n  }\n\n  continueWithAd() {\n    if (this.continuedOnce) return;\n    this.adManager.showRewarded(AD_PLACEMENTS.CONTINUE).then(success => {\n      if (success) {\n        this.analytics.trackAdShow(AD_PLACEMENTS.CONTINUE, true);\n        this.lives = 3;\n        this.continuedOnce = true;\n        const q = this.questions[this.questionIndex];\n        if (q) { q.answered = false; q.correct = null; this.judge.startQuestion(q); }\n        document.getElementById('continue-modal').style.display = 'none';\n        this.render();\n      } else {\n        this.analytics.trackAdShow(AD_PLACEMENTS.CONTINUE, false);\n      }\n    });\n  }\n\n  finishLevel() {\n    this.state = 'result';\n    document.getElementById('continue-modal').style.display = 'none';\n    const s = this.combo.getStats();\n    const stars = this.combo.getStarRating(s.correctCount, this.questions.length);\n\n    if (stars > 0 && this.currentLevel) {\n      this.data.setLevelStars(this.currentLevel.id, stars);\n      this.data.addCoins(this.currentLevel.reward.coins);\n      this.data.addScore(s.score);\n      this.data.updateBestCombo(s.maxCombo);\n      this.data.addExp(this.currentLevel.reward.exp || 10);\n      this.daily.updateTaskProgress('level', 1);\n      this.daily.updateTaskProgress('collect', s.correctCount);\n      this.adManager.reportSuccess();\n      this.analytics.trackLevelComplete(this.currentLevel.id, s.correctCount, this.questions.length, stars, this.currentLevel.reward.coins, s.maxCombo);\n    } else {\n      this.adManager.reportFail();\n      this.analytics.trackLevelFail(this.currentLevel ? this.currentLevel.id : 0, s.correctCount, this.lives, this.questionIndex);\n    }\n\n    this.levelResult = {\n      stars, correctCount: s.correctCount, totalQuestions: this.questions.length,\n      score: s.score, maxCombo: s.maxCombo,\n      coins: stars > 0 ? this.currentLevel.reward.coins : 0\n    };\n    this._doubledReward = false;\n    if (stars > 0) this.audio.playLevelWin(); else this.audio.playLevelFail();\n    this.render();\n\n    // Show interstitial after successful level\n    if (stars > 0 && this.currentLevel) {\n      this.adManager.showInterstitial(this.currentLevel.id);\n    }\n  }\n\n  // W3: Double reward via ad\n  doubleRewardWithAd() {\n    if (this._doubledReward || !this.levelResult || this.levelResult.stars <= 0) return;\n    this.adManager.showRewarded(AD_PLACEMENTS.DOUBLE_REWARD).then(success => {\n      if (success) {\n        this.analytics.trackAdShow(AD_PLACEMENTS.DOUBLE_REWARD, true);\n        this._doubledReward = true;\n        const extra = this.levelResult.coins;\n        this.data.addCoins(extra);\n        this.levelResult.coins *= 2;\n        this.render();\n      } else {\n        this.analytics.trackAdShow(AD_PLACEMENTS.DOUBLE_REWARD, false);\n      }\n    });\n  }\n\n  // W3: Ad-powered hint reveal\n  useHintRevealWithAd() {\n    if (!this.adManager.canShowRewarded(AD_PLACEMENTS.HINT_REVEAL)) {\n      this.useHintReveal();\n      return;\n    }\n    this.adManager.showRewarded(AD_PLACEMENTS.HINT_REVEAL).then(success => {\n      if (success) {\n        this.analytics.trackAdShow(AD_PLACEMENTS.HINT_REVEAL, true);\n        this._doHintReveal(true);\n      } else {\n        this.analytics.trackAdShow(AD_PLACEMENTS.HINT_REVEAL, false);\n        this.useHintReveal();\n      }\n    });\n  }\n\n  // W3: Ad-powered hint remove\n  useHintRemoveWithAd() {\n    if (!this.adManager.canShowRewarded(AD_PLACEMENTS.HINT_REMOVE)) {\n      this.useHintRemove();\n      return;\n    }\n    this.adManager.showRewarded(AD_PLACEMENTS.HINT_REMOVE).then(success => {\n      if (success) {\n        this.analytics.trackAdShow(AD_PLACEMENTS.HINT_REMOVE, true);\n        this._doHintRemove(true);\n      } else {\n        this.analytics.trackAdShow(AD_PLACEMENTS.HINT_REMOVE, false);\n        this.useHintRemove();\n      }\n    });\n  }\n\n  _doHintReveal(free) {\n    if (this.state !== 'playing') return;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return;\n    const fc = this.judge.getFillCount();\n    if (fc >= 4) return;\n    if (!free) {\n      const skillResult = this.characters.applySkill({ event: 'hint' });\n      if (!skillResult.triggered) {\n        if (this.data.coins < this.hintRevealCost) { alert('金币不足'); return; }\n        this.data.spendCoins(this.hintRevealCost);\n      }\n    }\n    const ch = this.judge.currentIdiom.chars[fc];\n    const cand = q.candidates.find(c => c.char === ch && !c.used);\n    if (!cand) return;\n    this.usedHintThisQuestion = true;\n    this.audio.playHint();\n    this.analytics.trackHintUse('reveal', free ? 0 : this.hintRevealCost);\n    const result = this.judge.placeChar(cand.index);\n    if (result.fillCount === 4) setTimeout(() => this._handleFull(result), 400);\n    this.render();\n  }\n\n  _doHintRemove(free) {\n    if (this.state !== 'playing') return;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return;\n    if (!free) {\n      if (this.data.coins < this.hintRemoveCost) { alert('金币不足'); return; }\n      this.data.spendCoins(this.hintRemoveCost);\n    }\n    const wrong = q.candidates.filter(c => !c.used && !this.judge.currentIdiom.chars.includes(c.char) && !c.removed);\n    const cnt = Math.min(2, wrong.length);\n    for (let i = 0; i < cnt; i++) {\n      const idx = Math.floor(Math.random() * wrong.length);\n      wrong[idx].removed = true;\n      wrong.splice(idx, 1);\n    }\n    this.audio.playRemove();\n    this.analytics.trackHintUse('remove', free ? 0 : this.hintRemoveCost);\n    this.render();\n  }\n\n  // W3: Daily double via ad\n  dailyDoubleWithAd() {\n    this.adManager.showRewarded(AD_PLACEMENTS.DAILY_DOUBLE).then(success => {\n      if (success) {\n        this.analytics.trackAdShow(AD_PLACEMENTS.DAILY_DOUBLE, true);\n        this.daily.claimLoginDouble();\n        this.render();\n      }\n    });\n  }\n\n  // ===== W2: Timed Challenge =====\n  startTimedChallenge() {\n    this.state = 'timed';\n    this.analytics.trackTimedStart();\n    this.timed.onUpdate = (evt) => {\n      if (evt === 'end') {\n        this.state = 'timed_result';\n        const r = this.timed.getResult();\n        this.analytics.trackTimedEnd(r.score, r.correctCount, r.answeredCount, r.maxCombo);\n      }\n      this.render();\n    };\n    this.timed.start();\n  }\n\n  // ===== W2: PK Mode =====\n  startPK(opponentResult) {\n    this.state = 'pk';\n    this.analytics.trackPKStart();\n    this.pk.onUpdate = (evt) => {\n      if (evt === 'end') {\n        this.state = 'pk_result';\n        const r = this.pk.getResult();\n        this.analytics.trackPKResult(r.won ? 'win' : 'lose', r.correctCount, r.time);\n      }\n      this.render();\n    };\n    this.pk.start(opponentResult);\n  }\n\n  // ===== W2: Collection =====\n  showCollection() {\n    this.state = 'collection';\n    this.render();\n  }\n\n  // ===== W2: Daily =====\n  showDaily() {\n    this.state = 'daily';\n    this.render();\n  }\n\n  // ===== W2: Characters =====\n  showCharacters() {\n    this.state = 'characters';\n    this.render();\n  }\n\n  showLevelMap() {\n    this.state = 'map';\n    this.render();\n  }\n\n  goToMenu() {\n    this.state = 'menu';\n    this.tutorial.end();\n    this.render();\n  }\n\n  getCurrentQuestion() { return this.questions[this.questionIndex]; }\n\n  render() { if (typeof renderUI === 'function') renderUI(this); }\n}\n\nfunction handleHintReveal() { game.useHintRevealWithAd(); }\nfunction handleHintRemove() { game.useHintRemoveWithAd(); }\nfunction handleSkip() { game.skipQuestion(); }\nfunction handleDoubleReward() { game.doubleRewardWithAd(); }\nfunction handleDailyDouble() { game.dailyDoubleWithAd(); }\n\nif (typeof module !== 'undefined') module.exports = { Game };\n","numLines":472,"startLine":1,"totalLines":472}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_075a3d062ab4431ebc629c52","type":"tool_result","content":"1\t// Analytics.js — 成语大闯关数据埋点，15种事件全覆盖\n2\t// 复用三消埋点框架，适配成语游戏场景\n3\t\n4\tconst ANALYTICS_EVENTS = {\n5\t  GAME_START: 'game_start',\n6\t  TUTORIAL_STEP: 'tutorial_step',\n7\t  LEVEL_START: 'level_start',\n8\t  QUESTION_ANSWER: 'question_answer',\n9\t  LEVEL_COMPLETE: 'level_complete',\n10\t  LEVEL_FAIL: 'level_fail',\n11\t  COMBO_HIT: 'combo_hit',\n12\t  HINT_USE: 'hint_use',\n13\t  AD_SHOW: 'ad_show',\n14\t  AD_CLICK: 'ad_click',\n15\t  SHARE: 'share',\n16\t  PK_START: 'pk_start',\n17\t  PK_RESULT: 'pk_result',\n18\t  TIMED_START: 'timed_start',\n19\t  TIMED_END: 'timed_end',\n20\t  COLLECTION_UNLOCK: 'collection_unlock',\n21\t  CHARACTER_USE: 'character_use',\n22\t  DAILY_LOGIN: 'daily_login',\n23\t};\n24\t\n25\tclass Analytics {\n26\t  constructor(dataManager) {\n27\t    this.dm = dataManager;\n28\t    this._initStorage();\n29\t    this.isDouyin = typeof tt !== 'undefined';\n30\t    this.flushInterval = 30000;\n31\t    this.maxQueueSize = 50;\n32\t    this._flushTimer = null;\n33\t  }\n34\t\n35\t  _initStorage() {\n36\t    if (!this.dm.data.analytics) {\n37\t      this.dm.data.analytics = {\n38\t        userId: 'u_' + Math.random().toString(36).slice(2, 10),\n39\t        sessionId: this._genSessionId(),\n40\t        queue: [],\n41\t        totalCount: 0,\n42\t        firstLaunch: Date.now(),\n43\t        lastActive: Date.now(),\n44\t      };\n45\t      this.dm.save();\n46\t    }\n47\t    this.data = this.dm.data.analytics;\n48\t  }\n49\t\n50\t  _genSessionId() {\n51\t    return Date.now().toString(36) + Math.random().toString(36).slice(2, 6);\n52\t  }\n53\t\n54\t  track(eventName, params) {\n55\t    const event = {\n56\t      event: eventName,\n57\t      ts: Date.now(),\n58\t      session: this.data.sessionId,\n59\t      uid: this.data.userId,\n60\t      appId: 'idiom-master',\n61\t      ...(params || {}),\n62\t    };\n63\t    this.data.queue.push(event);\n64\t    this.data.totalCount++;\n65\t    this.data.lastActive = Date.now();\n66\t    if (this.data.queue.length >= this.maxQueueSize) this.flush();\n67\t    else this.dm.save();\n68\t\n69\t    if (!this.isDouyin && typeof console !== 'undefined') {\n70\t      console.debug(`[Analytics] ${eventName}`, params || '');\n71\t    }\n72\t  }\n73\t\n74\t  trackGameStart() {\n75\t    this.track(ANALYTICS_EVENTS.GAME_START, {\n76\t      version: '1.0',\n77\t      platform: this.isDouyin ? 'douyin' : 'web',\n78\t    });\n79\t  }\n80\t\n81\t  trackTutorialStep(stepId, level) {\n82\t    this.track(ANALYTICS_EVENTS.TUTORIAL_STEP, { stepId, level });\n83\t  }\n84\t\n85\t  trackLevelStart(levelNum, config) {\n86\t    this.track(ANALYTICS_EVENTS.LEVEL_START, {\n87\t      level: levelNum,\n88\t      questions: config.questions,\n89\t      difficulty: config.difficulty,\n90\t    });\n91\t  }\n92\t\n93\t  trackQuestionAnswer(correct, timeMs, usedHint, combo) {\n94\t    this.track(ANALYTICS_EVENTS.QUESTION_ANSWER, {\n95\t      correct, timeMs, usedHint, combo,\n96\t    });\n97\t  }\n98\t\n99\t  trackLevelComplete(levelNum, correctCount, totalQuestions, stars, coins, maxCombo) {\n100\t    this.track(ANALYTICS_EVENTS.LEVEL_COMPLETE, {\n101\t      level: levelNum, correctCount, totalQuestions, stars, coins, maxCombo,\n102\t      completionTime: Date.now(),\n103\t    });\n104\t  }\n105\t\n106\t  trackLevelFail(levelNum, correctCount, livesRemaining, failQuestion) {\n107\t    this.track(ANALYTICS_EVENTS.LEVEL_FAIL, {\n108\t      level: levelNum, correctCount, livesRemaining, failQuestion,\n109\t    });\n110\t  }\n111\t\n112\t  trackComboHit(combo, score) {\n113\t    if (combo >= 3) {\n114\t      this.track(ANALYTICS_EVENTS.COMBO_HIT, { combo, score });\n115\t    }\n116\t  }\n117\t\n118\t  trackHintUse(type, cost) {\n119\t    this.track(ANALYTICS_EVENTS.HINT_USE, { type, cost });\n120\t  }\n121\t\n122\t  trackAdShow(placement, completed) {\n123\t    this.track(ANALYTICS_EVENTS.AD_SHOW, {\n124\t      placement, completed,\n125\t      adType: placement === 'interstitial' ? 'interstitial' : 'rewarded',\n126\t    });\n127\t  }\n128\t\n129\t  trackAdClick(placement) {\n130\t    this.track(ANALYTICS_EVENTS.AD_CLICK, { placement });\n131\t  }\n132\t\n133\t  trackShare(type, extra) {\n134\t    this.track(ANALYTICS_EVENTS.SHARE, { type, ...(extra || {}) });\n135\t  }\n136\t\n137\t  trackPKStart() {\n138\t    this.track(ANALYTICS_EVENTS.PK_START);\n139\t  }\n140\t\n141\t  trackPKResult(result, correctCount, timeMs) {\n142\t    this.track(ANALYTICS_EVENTS.PK_RESULT, { result, correctCount, timeMs });\n143\t  }\n144\t\n145\t  trackTimedStart() {\n146\t    this.track(ANALYTICS_EVENTS.TIMED_START);\n147\t  }\n148\t\n149\t  trackTimedEnd(score, correctCount, totalQuestions, maxCombo) {\n150\t    this.track(ANALYTICS_EVENTS.TIMED_END, {\n151\t      score, correctCount, totalQuestions, maxCombo,\n152\t    });\n153\t  }\n154\t\n155\t  trackCollectionUnlock(idiomId, category, totalCollected) {\n156\t    this.track(ANALYTICS_EVENTS.COLLECTION_UNLOCK, {\n157\t      idiomId, category, totalCollected,\n158\t    });\n159\t  }\n160\t\n161\t  trackCharacterUse(characterId) {\n162\t    this.track(ANALYTICS_EVENTS.CHARACTER_USE, { characterId });\n163\t  }\n164\t\n165\t  trackDailyLogin(day, reward) {\n166\t    this.track(ANALYTICS_EVENTS.DAILY_LOGIN, { day, reward });\n167\t  }\n168\t\n169\t  flush() {\n170\t    if (this.data.queue.length === 0) return;\n171\t    const batch = this.data.queue.splice(0, this.maxQueueSize);\n172\t    this.dm.save();\n173\t\n174\t    if (this.isDouyin) {\n175\t      this._uploadToServer(batch);\n176\t    } else if (typeof console !== 'undefined') {\n177\t      console.debug(`[Analytics] Flush ${batch.length} events`, batch);\n178\t    }\n179\t  }\n180\t\n181\t  _uploadToServer(events) {\n182\t    try {\n183\t      const request = tt.request || fetch;\n184\t      if (request) {\n185\t        request({\n186\t          url: 'https://analytics.example.com/events',\n187\t          method: 'POST',\n188\t          data: { events, appId: 'idiom-master' },\n189\t        }).catch(() => {\n190\t          this.data.queue.unshift(...events);\n191\t          this.dm.save();\n192\t        });\n193\t      }\n194\t    } catch (e) { /* analytics never blocks gameplay */ }\n195\t  }\n196\t\n197\t  newSession() {\n198\t    this.data.sessionId = this._genSessionId();\n199\t    this.dm.save();\n200\t  }\n201\t\n202\t  startFlushTimer() {\n203\t    if (this._flushTimer) clearInterval(this._flushTimer);\n204\t    this._flushTimer = setInterval(() => this.flush(), this.flushInterval);\n205\t  }\n206\t\n207\t  stopFlushTimer() {\n208\t    if (this._flushTimer) { clearInterval(this._flushTimer); this._flushTimer = null; }\n209\t  }\n210\t}\n211\t\n212\tif (typeof module !== 'undefined') module.exports = { Analytics, ANALYTICS_EVENTS };\n213\t"}]},"parent_tool_use_id":null,"session_id":"7463fb62-2e03-4edd-abad-466ff792dff1","uuid":"2f5a4226-1007-44ec-8e9b-b4a469060137","timestamp":"2026-05-23T10:38:05.439Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/src/js/Analytics.js","content":"// Analytics.js — 成语大闯关数据埋点，15种事件全覆盖\n// 复用三消埋点框架，适配成语游戏场景\n\nconst ANALYTICS_EVENTS = {\n  GAME_START: 'game_start',\n  TUTORIAL_STEP: 'tutorial_step',\n  LEVEL_START: 'level_start',\n  QUESTION_ANSWER: 'question_answer',\n  LEVEL_COMPLETE: 'level_complete',\n  LEVEL_FAIL: 'level_fail',\n  COMBO_HIT: 'combo_hit',\n  HINT_USE: 'hint_use',\n  AD_SHOW: 'ad_show',\n  AD_CLICK: 'ad_click',\n  SHARE: 'share',\n  PK_START: 'pk_start',\n  PK_RESULT: 'pk_result',\n  TIMED_START: 'timed_start',\n  TIMED_END: 'timed_end',\n  COLLECTION_UNLOCK: 'collection_unlock',\n  CHARACTER_USE: 'character_use',\n  DAILY_LOGIN: 'daily_login',\n};\n\nclass Analytics {\n  constructor(dataManager) {\n    this.dm = dataManager;\n    this._initStorage();\n    this.isDouyin = typeof tt !== 'undefined';\n    this.flushInterval = 30000;\n    this.maxQueueSize = 50;\n    this._flushTimer = null;\n  }\n\n  _initStorage() {\n    if (!this.dm.data.analytics) {\n      this.dm.data.analytics = {\n        userId: 'u_' + Math.random().toString(36).slice(2, 10),\n        sessionId: this._genSessionId(),\n        queue: [],\n        totalCount: 0,\n        firstLaunch: Date.now(),\n        lastActive: Date.now(),\n      };\n      this.dm.save();\n    }\n    this.data = this.dm.data.analytics;\n  }\n\n  _genSessionId() {\n    return Date.now().toString(36) + Math.random().toString(36).slice(2, 6);\n  }\n\n  track(eventName, params) {\n    const event = {\n      event: eventName,\n      ts: Date.now(),\n      session: this.data.sessionId,\n      uid: this.data.userId,\n      appId: 'idiom-master',\n      ...(params || {}),\n    };\n    this.data.queue.push(event);\n    this.data.totalCount++;\n    this.data.lastActive = Date.now();\n    if (this.data.queue.length >= this.maxQueueSize) this.flush();\n    else this.dm.save();\n\n    if (!this.isDouyin && typeof console !== 'undefined') {\n      console.debug(`[Analytics] ${eventName}`, params || '');\n    }\n  }\n\n  trackGameStart() {\n    this.track(ANALYTICS_EVENTS.GAME_START, {\n      version: '1.0',\n      platform: this.isDouyin ? 'douyin' : 'web',\n    });\n  }\n\n  trackTutorialStep(stepId, level) {\n    this.track(ANALYTICS_EVENTS.TUTORIAL_STEP, { stepId, level });\n  }\n\n  trackLevelStart(levelNum, config) {\n    this.track(ANALYTICS_EVENTS.LEVEL_START, {\n      level: levelNum,\n      questions: config.questions,\n      difficulty: config.difficulty,\n    });\n  }\n\n  trackQuestionAnswer(correct, timeMs, usedHint, combo) {\n    this.track(ANALYTICS_EVENTS.QUESTION_ANSWER, {\n      correct, timeMs, usedHint, combo,\n    });\n  }\n\n  trackLevelComplete(levelNum, correctCount, totalQuestions, stars, coins, maxCombo) {\n    this.track(ANALYTICS_EVENTS.LEVEL_COMPLETE, {\n      level: levelNum, correctCount, totalQuestions, stars, coins, maxCombo,\n      completionTime: Date.now(),\n    });\n  }\n\n  trackLevelFail(levelNum, correctCount, livesRemaining, failQuestion) {\n    this.track(ANALYTICS_EVENTS.LEVEL_FAIL, {\n      level: levelNum, correctCount, livesRemaining, failQuestion,\n    });\n  }\n\n  trackComboHit(combo, score) {\n    if (combo >= 3) {\n      this.track(ANALYTICS_EVENTS.COMBO_HIT, { combo, score });\n    }\n  }\n\n  trackHintUse(type, cost) {\n    this.track(ANALYTICS_EVENTS.HINT_USE, { type, cost });\n  }\n\n  trackAdShow(placement, completed) {\n    this.track(ANALYTICS_EVENTS.AD_SHOW, {\n      placement, completed,\n      adType: placement === 'interstitial' ? 'interstitial' : 'rewarded',\n    });\n  }\n\n  trackAdClick(placement) {\n    this.track(ANALYTICS_EVENTS.AD_CLICK, { placement });\n  }\n\n  trackShare(type, extra) {\n    this.track(ANALYTICS_EVENTS.SHARE, { type, ...(extra || {}) });\n  }\n\n  trackPKStart() {\n    this.track(ANALYTICS_EVENTS.PK_START);\n  }\n\n  trackPKResult(result, correctCount, timeMs) {\n    this.track(ANALYTICS_EVENTS.PK_RESULT, { result, correctCount, timeMs });\n  }\n\n  trackTimedStart() {\n    this.track(ANALYTICS_EVENTS.TIMED_START);\n  }\n\n  trackTimedEnd(score, correctCount, totalQuestions, maxCombo) {\n    this.track(ANALYTICS_EVENTS.TIMED_END, {\n      score, correctCount, totalQuestions, maxCombo,\n    });\n  }\n\n  trackCollectionUnlock(idiomId, category, totalCollected) {\n    this.track(ANALYTICS_EVENTS.COLLECTION_UNLOCK, {\n      idiomId, category, totalCollected,\n    });\n  }\n\n  trackCharacterUse(characterId) {\n    this.track(ANALYTICS_EVENTS.CHARACTER_USE, { characterId });\n  }\n\n  trackDailyLogin(day, reward) {\n    this.track(ANALYTICS_EVENTS.DAILY_LOGIN, { day, reward });\n  }\n\n  flush() {\n    if (this.data.queue.length === 0) return;\n    const batch = this.data.queue.splice(0, this.maxQueueSize);\n    this.dm.save();\n\n    if (this.isDouyin) {\n      this._uploadToServer(batch);\n    } else if (typeof console !== 'undefined') {\n      console.debug(`[Analytics] Flush ${batch.length} events`, batch);\n    }\n  }\n\n  _uploadToServer(events) {\n    try {\n      const request = tt.request || fetch;\n      if (request) {\n        request({\n          url: 'https://analytics.example.com/events',\n          method: 'POST',\n          data: { events, appId: 'idiom-master' },\n        }).catch(() => {\n          this.data.queue.unshift(...events);\n          this.dm.save();\n        });\n      }\n    } catch (e) { /* analytics never blocks gameplay */ }\n  }\n\n  newSession() {\n    this.data.sessionId = this._genSessionId();\n    this.dm.save();\n  }\n\n  startFlushTimer() {\n    if (this._flushTimer) clearInterval(this._flushTimer);\n    this._flushTimer = setInterval(() => this.flush(), this.flushInterval);\n  }\n\n  stopFlushTimer() {\n    if (this._flushTimer) { clearInterval(this._flushTimer); this._flushTimer = null; }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Analytics, ANALYTICS_EVENTS };\n","numLines":213,"startLine":1,"totalLines":213}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_085287b0ffb449b1918f84f7","type":"tool_result","content":"1\t/* 成语大闯关 — 国风主题 */\n2\t\n3\t* { margin: 0; padding: 0; box-sizing: border-box; user-select: none; -webkit-user-select: none; }\n4\t\n5\tbody {\n6\t  font-family: 'PingFang SC', 'Microsoft YaHei', 'SimSun', serif;\n7\t  background: linear-gradient(135deg, #F5F0E8 0%, #E8DED0 100%);\n8\t  min-height: 100vh;\n9\t  overflow: hidden;\n10\t  color: #2C2C2C;\n11\t  touch-action: manipulation;\n12\t  -webkit-user-select: none;\n13\t  user-select: none;\n14\t}\n15\t\n16\t#app {\n17\t  width: 100%; height: 100vh;\n18\t  max-width: 480px; margin: 0 auto;\n19\t  position: relative; overflow: hidden;\n20\t}\n21\t\n22\t.screen {\n23\t  display: none; width: 100%; height: 100%;\n24\t  flex-direction: column; position: absolute; top: 0; left: 0;\n25\t}\n26\t.screen.active { display: flex; }\n27\t\n28\t/* ===== 主菜单 ===== */\n29\t.menu-bg {\n30\t  flex: 1; display: flex; flex-direction: column;\n31\t  align-items: center; justify-content: center; padding: 40px 20px;\n32\t  background: linear-gradient(180deg, #FFFDF7 0%, #F5F0E8 50%, #E8DED0 100%);\n33\t}\n34\t\n35\t.title-block { text-align: center; margin-bottom: 30px; }\n36\t.title {\n37\t  font-size: 42px; font-weight: 900; color: #C84B31;\n38\t  text-shadow: 2px 2px 0 #D4A843, 4px 4px 0 rgba(0,0,0,0.05);\n39\t  letter-spacing: 8px;\n40\t}\n41\t.subtitle { font-size: 16px; color: #8B7355; margin-top: 8px; letter-spacing: 4px; }\n42\t\n43\t.menu-stats {\n44\t  display: flex; gap: 24px; margin-bottom: 40px;\n45\t  font-size: 16px; color: #8B7355;\n46\t}\n47\t.stat-item { display: flex; align-items: center; gap: 4px; }\n48\t\n49\t.menu-buttons { display: flex; flex-direction: column; gap: 12px; width: 240px; }\n50\t.menu-footer { margin-top: 40px; display: flex; gap: 16px; }\n51\t.btn-icon {\n52\t  width: 44px; height: 44px; border: 2px solid #D4A843;\n53\t  border-radius: 50%; background: #FFFDF7; font-size: 20px;\n54\t  cursor: pointer; display: flex; align-items: center; justify-content: center;\n55\t}\n56\t.btn-icon:active { background: #F5F0E8; }\n57\t\n58\t/* ===== 按钮 ===== */\n59\t.btn {\n60\t  padding: 14px 28px; border: none; border-radius: 24px;\n61\t  font-size: 18px; font-weight: 600; cursor: pointer;\n62\t  transition: transform 0.1s, box-shadow 0.2s;\n63\t  letter-spacing: 2px;\n64\t}\n65\t.btn:active { transform: scale(0.95); }\n66\t.btn-primary {\n67\t  background: linear-gradient(135deg, #C84B31, #A63A22);\n68\t  color: white; box-shadow: 0 4px 12px rgba(200,75,49,0.3);\n69\t}\n70\t.btn-secondary {\n71\t  background: linear-gradient(135deg, #2D6A4F, #1E4D33);\n72\t  color: white; box-shadow: 0 4px 12px rgba(45,106,79,0.3);\n73\t}\n74\t.btn-accent {\n75\t  background: linear-gradient(135deg, #D4A843, #B8922E);\n76\t  color: white; box-shadow: 0 4px 12px rgba(212,168,67,0.3);\n77\t}\n78\t\n79\t.btn-back {\n80\t  background: none; border: none; font-size: 20px;\n81\t  cursor: pointer; padding: 8px; color: #8B7355;\n82\t}\n83\t\n84\t/* ===== 关卡地图 ===== */\n85\t.map-header {\n86\t  display: flex; align-items: center; justify-content: space-between;\n87\t  padding: 12px 16px; background: rgba(255,255,255,0.9);\n88\t  border-bottom: 1px solid #E8DED0;\n89\t}\n90\t.map-header h2 { font-size: 18px; color: #C84B31; }\n91\t\n92\t.chapter-info { padding: 8px 16px; }\n93\t.chapter-badge {\n94\t  display: inline-block; padding: 4px 12px; border-radius: 12px;\n95\t  font-size: 13px; color: #2C2C2C; margin-right: 8px;\n96\t}\n97\t\n98\t.level-grid {\n99\t  flex: 1; overflow-y: auto; padding: 16px;\n100\t  -webkit-overflow-scrolling: touch;\n101\t}\n102\t\n103\t.chapter-section {\n104\t  margin-bottom: 16px; padding: 12px;\n105\t  background: rgba(255,255,255,0.7); border-radius: 16px;\n106\t  border-left: 4px solid #D4A843;\n107\t  display: flex; flex-wrap: wrap; gap: 8px; justify-content: center;\n108\t}\n109\t\n110\t.level-btn {\n111\t  width: 70px; padding: 8px 4px; border: 2px solid #E8DED0;\n112\t  border-radius: 12px; background: #FFFDF7; cursor: pointer;\n113\t  display: flex; flex-direction: column; align-items: center;\n114\t  gap: 2px; transition: transform 0.1s;\n115\t}\n116\t.level-btn:active { transform: scale(0.95); }\n117\t.level-btn.locked { opacity: 0.5; pointer-events: none; }\n118\t.level-btn.completed { border-color: #27AE60; }\n119\t.level-btn.boss {\n120\t  background: linear-gradient(135deg, #FFF5E0, #FFE0B2);\n121\t  border-color: #D4A843;\n122\t}\n123\t.level-num { font-size: 18px; font-weight: bold; color: #C84B31; }\n124\t.level-stars { font-size: 10px; color: #D4A843; }\n125\t.level-name { font-size: 9px; color: #8B7355; }\n126\t.level-btn.locked .level-num { color: #ccc; }\n127\t\n128\t/* ===== 游戏界面 ===== */\n129\t.game-header {\n130\t  display: flex; align-items: center; justify-content: space-between;\n131\t  padding: 8px 16px; background: rgba(255,255,255,0.95);\n132\t  border-bottom: 1px solid #E8DED0;\n133\t}\n134\t.header-center { display: flex; gap: 12px; font-size: 14px; font-weight: 600; }\n135\t.header-right { font-size: 14px; }\n136\t\n137\t.game-body {\n138\t  flex: 1; display: flex; flex-direction: column;\n139\t  align-items: center; justify-content: center;\n140\t  padding: 12px 16px; gap: 16px; overflow: hidden;\n141\t}\n142\t\n143\t.combo-display {\n144\t  font-size: 20px; font-weight: 800; color: #D4A843;\n145\t  text-shadow: 0 2px 8px rgba(212,168,67,0.5);\n146\t  display: none; animation: comboPopIn 0.3s ease-out;\n147\t}\n148\t.combo-3, .combo-4 { color: #D4A843; }\n149\t.combo-5, .combo-6, .combo-7 { color: #FF8C00; font-size: 24px; }\n150\t.combo-8, .combo-9 { color: #FF6347; font-size: 28px; }\n151\t.combo-10 { color: #FF4500; font-size: 32px; animation: comboShake 0.3s ease-out; }\n152\t\n153\t@keyframes comboPopIn {\n154\t  0% { transform: scale(0.5); opacity: 0; }\n155\t  100% { transform: scale(1); opacity: 1; }\n156\t}\n157\t@keyframes comboShake {\n158\t  0%, 100% { transform: translateX(0); }\n159\t  25% { transform: translateX(-5px); }\n160\t  75% { transform: translateX(5px); }\n161\t}\n162\t\n163\t.meaning-box {\n164\t  background: #FFFDF7; border: 2px solid #E8DED0;\n165\t  border-radius: 12px; padding: 14px 20px;\n166\t  text-align: center; max-width: 90%; min-height: 50px;\n167\t  box-shadow: 0 2px 8px rgba(0,0,0,0.05);\n168\t}\n169\t#meaning-text { font-size: 16px; line-height: 1.5; color: #2C2C2C; }\n170\t\n171\t.slots-container {\n172\t  display: flex; gap: 10px; margin: 8px 0;\n173\t}\n174\t\n175\t.slot {\n176\t  width: 60px; height: 60px;\n177\t  border: 3px solid #8B7355; border-radius: 10px;\n178\t  background: #FFFDF7; display: flex;\n179\t  align-items: center; justify-content: center;\n180\t  font-size: 28px; font-weight: bold; color: #2C2C2C;\n181\t  cursor: pointer; transition: all 0.2s;\n182\t  position: relative;\n183\t}\n184\t.slot.filled { background: #FFF8E8; border-color: #C84B31; }\n185\t.slot.correct {\n186\t  background: #27AE60; border-color: #27AE60; color: white;\n187\t  animation: correctPulse 0.4s;\n188\t}\n189\t.slot.wrong {\n190\t  background: #E74C3C; border-color: #E74C3C; color: white;\n191\t  animation: wrongShake 0.5s;\n192\t}\n193\t\n194\t@keyframes correctPulse {\n195\t  0%, 100% { transform: scale(1); }\n196\t  50% { transform: scale(1.12); }\n197\t}\n198\t@keyframes wrongShake {\n199\t  0%, 100% { transform: translateX(0); }\n200\t  25% { transform: translateX(-8px); }\n201\t  75% { transform: translateX(8px); }\n202\t}\n203\t\n204\t.idiom-hint {\n205\t  font-size: 13px; color: #8B7355; text-align: center;\n206\t  padding: 6px 12px; background: rgba(255,255,255,0.7);\n207\t  border-radius: 8px; display: none; max-width: 90%;\n208\t}\n209\t.idiom-hint strong { color: #C84B31; }\n210\t\n211\t.candidates-container {\n212\t  display: flex; flex-wrap: wrap; gap: 8px;\n213\t  justify-content: center; max-width: 340px; margin-top: 8px;\n214\t}\n215\t\n216\t.candidate {\n217\t  width: 48px; height: 48px; border: none; border-radius: 10px;\n218\t  background: linear-gradient(135deg, #C84B31, #A63A22);\n219\t  color: white; font-size: 22px; font-weight: bold;\n220\t  cursor: pointer; transition: all 0.15s;\n221\t  display: flex; align-items: center; justify-content: center;\n222\t}\n223\t.candidate:active { transform: scale(0.9); }\n224\t.candidate.used {\n225\t  opacity: 0.25; pointer-events: none; transform: scale(0.9);\n226\t}\n227\t.candidate.removed {\n228\t  opacity: 0.1; pointer-events: none;\n229\t}\n230\t\n231\t.game-footer {\n232\t  display: flex; justify-content: center; gap: 12px;\n233\t  padding: 12px 16px; background: rgba(255,255,255,0.9);\n234\t  border-top: 1px solid #E8DED0;\n235\t}\n236\t\n237\t.tool-btn {\n238\t  padding: 8px 16px; border: 2px solid #2D6A4F;\n239\t  border-radius: 20px; background: white;\n240\t  color: #2D6A4F; font-size: 14px; cursor: pointer;\n241\t  transition: all 0.15s;\n242\t}\n243\t.tool-btn:active { background: #2D6A4F; color: white; }\n244\t\n245\t/* ===== 教学覆盖层 ===== */\n246\t.tutorial-overlay {\n247\t  position: absolute; bottom: 0; left: 0; right: 0;\n248\t  background: rgba(0,0,0,0.7); padding: 20px;\n249\t  display: flex; align-items: center; justify-content: center;\n250\t  z-index: 100;\n251\t}\n252\t.tutorial-text {\n253\t  color: white; font-size: 16px; text-align: center;\n254\t  line-height: 1.5; max-width: 80%;\n255\t}\n256\t\n257\t/* ===== 结算界面 ===== */\n258\t.result-card {\n259\t  flex: 1; display: flex; flex-direction: column;\n260\t  align-items: center; justify-content: center;\n261\t  background: linear-gradient(180deg, #FFFDF7, #F5F0E8);\n262\t  padding: 40px 20px;\n263\t}\n264\t\n265\t.result-title {\n266\t  font-size: 36px; color: #C84B31; margin-bottom: 16px;\n267\t}\n268\t\n269\t.result-stars {\n270\t  font-size: 40px; color: #D4A843; margin-bottom: 20px;\n271\t  display: flex; gap: 8px;\n272\t}\n273\t\n274\t.result-stats {\n275\t  text-align: center; margin-bottom: 24px; line-height: 2;\n276\t  font-size: 16px;\n277\t}\n278\t.coins-earned {\n279\t  font-size: 20px; font-weight: bold; color: #D4A843;\n280\t  margin-top: 8px;\n281\t}\n282\t\n283\t.result-buttons {\n284\t  display: flex; flex-direction: column; gap: 10px; width: 220px;\n285\t}\n286\t\n287\t/* ===== 模态框 ===== */\n288\t.modal {\n289\t  position: absolute; top: 0; left: 0; right: 0; bottom: 0;\n290\t  background: rgba(0,0,0,0.6); display: flex;\n291\t  align-items: center; justify-content: center; z-index: 200;\n292\t}\n293\t.modal-content {\n294\t  background: #FFFDF7; border-radius: 20px; padding: 30px;\n295\t  text-align: center; max-width: 320px; width: 90%;\n296\t}\n297\t.modal-content h3 { font-size: 22px; color: #C84B31; margin-bottom: 12px; }\n298\t.modal-content p { margin-bottom: 20px; color: #8B7355; }\n299\t.modal-buttons { display: flex; gap: 12px; justify-content: center; }\n300\t\n301\t/* ===== W2: 通用 ===== */\n302\t.btn-outline {\n303\t  padding: 10px 16px; border: 2px solid #D4A843; border-radius: 20px;\n304\t  background: transparent; color: #8B7355; font-size: 14px; cursor: pointer;\n305\t  transition: all 0.15s;\n306\t}\n307\t.btn-outline:active { background: #FFF8E8; }\n308\t.btn-sm { padding: 8px 16px; font-size: 14px; }\n309\t\n310\t.menu-row {\n311\t  display: flex; gap: 10px; margin-top: 16px; justify-content: center; flex-wrap: wrap;\n312\t}\n313\t\n314\t/* ===== W2: 计时器 ===== */\n315\t.timer-display {\n316\t  font-size: 22px; font-weight: 800; color: #C84B31;\n317\t  font-variant-numeric: tabular-nums;\n318\t}\n319\t.timer-warning { color: #E74C3C; animation: timerPulse 0.5s infinite; }\n320\t@keyframes timerPulse {\n321\t  0%, 100% { opacity: 1; }\n322\t  50% { opacity: 0.5; }\n323\t}\n324\t\n325\t/* ===== W2: 成语图鉴 ===== */\n326\t.col-bar-wrap { padding: 8px 16px; }\n327\t.col-bar {\n328\t  height: 8px; background: #E8DED0; border-radius: 4px; overflow: hidden;\n329\t}\n330\t.col-bar-fill {\n331\t  height: 100%; background: linear-gradient(90deg, #2D6A4F, #27AE60);\n332\t  border-radius: 4px; transition: width 0.3s;\n333\t}\n334\t.col-search {\n335\t  display: block; width: calc(100% - 32px); margin: 8px 16px;\n336\t  padding: 10px 14px; border: 2px solid #E8DED0; border-radius: 12px;\n337\t  font-size: 14px; background: #FFFDF7; outline: none;\n338\t}\n339\t.col-search:focus { border-color: #C84B31; }\n340\t.col-categories {\n341\t  display: flex; flex-wrap: wrap; gap: 6px; padding: 4px 16px 8px;\n342\t  overflow-x: auto;\n343\t}\n344\t.cat-btn {\n345\t  padding: 4px 12px; border: 1px solid #E8DED0; border-radius: 14px;\n346\t  background: #FFFDF7; font-size: 12px; cursor: pointer; white-space: nowrap;\n347\t  color: #8B7355;\n348\t}\n349\t.cat-btn.active { background: #C84B31; color: white; border-color: #C84B31; }\n350\t.col-grid {\n351\t  flex: 1; overflow-y: auto; padding: 8px 16px;\n352\t  display: grid; grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));\n353\t  gap: 8px; align-content: start;\n354\t}\n355\t.idiom-card {\n356\t  background: #FFFDF7; border: 2px solid #E8DED0; border-radius: 10px;\n357\t  padding: 8px 4px; text-align: center; cursor: pointer;\n358\t  transition: all 0.15s;\n359\t}\n360\t.idiom-card.collected { border-color: #2D6A4F; background: #F0FFF4; }\n361\t.idiom-card:active { transform: scale(0.95); }\n362\t.idiom-text { display: block; font-size: 15px; font-weight: bold; color: #2C2C2C; }\n363\t.idiom-card:not(.collected) .idiom-text { color: #ccc; }\n364\t.idiom-cat { display: block; font-size: 10px; color: #8B7355; margin-top: 2px; }\n365\t.more-hint {\n366\t  grid-column: 1 / -1; text-align: center; font-size: 13px;\n367\t  color: #8B7355; padding: 8px;\n368\t}\n369\t.col-detail {\n370\t  position: absolute; bottom: 0; left: 0; right: 0;\n371\t  background: #FFFDF7; border-radius: 20px 20px 0 0; padding: 20px;\n372\t  box-shadow: 0 -4px 20px rgba(0,0,0,0.1); max-height: 60vh; overflow-y: auto;\n373\t  z-index: 50;\n374\t}\n375\t.detail-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }\n376\t.detail-header h3 { font-size: 24px; color: #C84B31; }\n377\t.detail-pinyin { color: #8B7355; font-size: 14px; margin-bottom: 8px; }\n378\t.detail-meaning { font-size: 16px; line-height: 1.6; margin-bottom: 8px; }\n379\t.detail-origin { font-size: 13px; color: #8B7355; margin-bottom: 4px; }\n380\t.detail-example { font-size: 13px; color: #2D6A4F; font-style: italic; }\n381\t.detail-locked { color: #8B7355; text-align: center; padding: 20px; }\n382\t\n383\t/* ===== W2: 每日系统 ===== */\n384\t.daily-content { flex: 1; overflow-y: auto; padding: 16px; }\n385\t.daily-login {\n386\t  background: linear-gradient(135deg, #FFF8E8, #F5F0E8);\n387\t  border-radius: 16px; padding: 20px; text-align: center; margin-bottom: 16px;\n388\t  border: 2px solid #D4A843;\n389\t}\n390\t.daily-login h3 { color: #C84B31; margin-bottom: 8px; }\n391\t.streak-num { font-size: 22px; font-weight: 800; color: #D4A843; }\n392\t.daily-section { margin-bottom: 16px; }\n393\t.daily-section h3 { font-size: 16px; color: #C84B31; margin-bottom: 8px; }\n394\t.task-list { display: flex; flex-direction: column; gap: 8px; }\n395\t.task-item {\n396\t  display: flex; align-items: center; justify-content: space-between;\n397\t  background: #FFFDF7; border: 1px solid #E8DED0; border-radius: 12px;\n398\t  padding: 10px 14px;\n399\t}\n400\t.task-item.done { opacity: 0.6; }\n401\t.task-desc { font-size: 14px; flex: 1; }\n402\t.task-progress { font-size: 13px; color: #8B7355; margin: 0 8px; }\n403\t.task-btn {\n404\t  padding: 4px 12px; border: 1px solid #2D6A4F; border-radius: 12px;\n405\t  background: white; color: #2D6A4F; font-size: 12px; cursor: pointer;\n406\t}\n407\t.task-btn.claimed { background: #F0F0F0; color: #999; border-color: #ddd; }\n408\t.task-btn:disabled { cursor: default; }\n409\t.challenge-card {\n410\t  background: #FFFDF7; border: 2px solid #D4A843; border-radius: 16px;\n411\t  padding: 16px; text-align: center;\n412\t}\n413\t.challenge-card.done { border-color: #2D6A4F; background: #F0FFF4; }\n414\t.challenge-card h4 { color: #C84B31; margin-bottom: 8px; }\n415\t.challenge-meaning { font-size: 16px; margin-bottom: 8px; }\n416\t.challenge-hint { font-size: 14px; color: #8B7355; margin-bottom: 12px; }\n417\t.challenge-done { color: #2D6A4F; font-weight: bold; }\n418\t\n419\t/* ===== W2: PK ===== */\n420\t.pk-answers { margin: 12px 0; text-align: left; max-width: 280px; margin-left: auto; margin-right: auto; }\n421\t.answer-item {\n422\t  padding: 6px 12px; border-radius: 8px; margin-bottom: 4px;\n423\t  font-size: 14px;\n424\t}\n425\t.answer-item.correct { background: #F0FFF4; color: #2D6A4F; }\n426\t.answer-item.wrong { background: #FFF0F0; color: #E74C3C; }\n427\t\n428\t/* ===== W2: 角色 ===== */\n429\t.char-grid {\n430\t  flex: 1; overflow-y: auto; padding: 16px;\n431\t  display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;\n432\t  align-content: start;\n433\t}\n434\t.char-card {\n435\t  background: #FFFDF7; border: 2px solid #E8DED0; border-radius: 16px;\n436\t  padding: 16px; text-align: center; cursor: pointer; transition: all 0.15s;\n437\t}\n438\t.char-card.selected { border-color: #D4A843; background: #FFF8E8; box-shadow: 0 2px 12px rgba(212,168,67,0.3); }\n439\t.char-card.locked { opacity: 0.5; cursor: default; }\n440\t.char-card:active:not(.locked) { transform: scale(0.97); }\n441\t.char-avatar { font-size: 40px; margin-bottom: 8px; }\n442\t.char-name { font-size: 15px; font-weight: bold; color: #2C2C2C; margin-bottom: 4px; }\n443\t.char-skill { font-size: 12px; color: #8B7355; }\n444\t.char-badge {\n445\t  margin-top: 8px; padding: 2px 10px; background: #D4A843; color: white;\n446\t  border-radius: 10px; font-size: 11px; display: inline-block;\n447\t}\n448\t.char-detail {\n449\t  padding: 16px; background: #FFFDF7; border-top: 1px solid #E8DED0;\n450\t  text-align: center;\n451\t}\n452\t.char-detail h4 { font-size: 18px; color: #C84B31; margin-bottom: 8px; }\n453\t.skill-name { font-weight: bold; color: #2D6A4F; margin-bottom: 4px; }\n454\t.skill-desc { font-size: 14px; color: #8B7355; }\n455\t\n456\t/* ===== W3: 广告按钮 ===== */\n457\t.btn-ad {\n458\t  background: linear-gradient(135deg, #D4A843 0%, #E8B84D 100%);\n459\t  color: white; border: none; border-radius: 12px;\n460\t  padding: 10px 24px; font-size: 15px; font-weight: bold;\n461\t  cursor: pointer; display: inline-flex; align-items: center; gap: 6px;\n462\t  transition: all 0.15s; box-shadow: 0 2px 8px rgba(212,168,67,0.3);\n463\t}\n464\t.btn-ad:active { transform: scale(0.96); }\n465\t.btn-ad:hover { box-shadow: 0 4px 12px rgba(212,168,67,0.4); }\n466\t"}]},"parent_tool_use_id":null,"session_id":"7463fb62-2e03-4edd-abad-466ff792dff1","uuid":"6c3f7b9e-6c09-4593-8851-30918f60175a","timestamp":"2026-05-23T10:38:05.443Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/src/css/style.css","content":"/* 成语大闯关 — 国风主题 */\n\n* { margin: 0; padding: 0; box-sizing: border-box; user-select: none; -webkit-user-select: none; }\n\nbody {\n  font-family: 'PingFang SC', 'Microsoft YaHei', 'SimSun', serif;\n  background: linear-gradient(135deg, #F5F0E8 0%, #E8DED0 100%);\n  min-height: 100vh;\n  overflow: hidden;\n  color: #2C2C2C;\n  touch-action: manipulation;\n  -webkit-user-select: none;\n  user-select: none;\n}\n\n#app {\n  width: 100%; height: 100vh;\n  max-width: 480px; margin: 0 auto;\n  position: relative; overflow: hidden;\n}\n\n.screen {\n  display: none; width: 100%; height: 100%;\n  flex-direction: column; position: absolute; top: 0; left: 0;\n}\n.screen.active { display: flex; }\n\n/* ===== 主菜单 ===== */\n.menu-bg {\n  flex: 1; display: flex; flex-direction: column;\n  align-items: center; justify-content: center; padding: 40px 20px;\n  background: linear-gradient(180deg, #FFFDF7 0%, #F5F0E8 50%, #E8DED0 100%);\n}\n\n.title-block { text-align: center; margin-bottom: 30px; }\n.title {\n  font-size: 42px; font-weight: 900; color: #C84B31;\n  text-shadow: 2px 2px 0 #D4A843, 4px 4px 0 rgba(0,0,0,0.05);\n  letter-spacing: 8px;\n}\n.subtitle { font-size: 16px; color: #8B7355; margin-top: 8px; letter-spacing: 4px; }\n\n.menu-stats {\n  display: flex; gap: 24px; margin-bottom: 40px;\n  font-size: 16px; color: #8B7355;\n}\n.stat-item { display: flex; align-items: center; gap: 4px; }\n\n.menu-buttons { display: flex; flex-direction: column; gap: 12px; width: 240px; }\n.menu-footer { margin-top: 40px; display: flex; gap: 16px; }\n.btn-icon {\n  width: 44px; height: 44px; border: 2px solid #D4A843;\n  border-radius: 50%; background: #FFFDF7; font-size: 20px;\n  cursor: pointer; display: flex; align-items: center; justify-content: center;\n}\n.btn-icon:active { background: #F5F0E8; }\n\n/* ===== 按钮 ===== */\n.btn {\n  padding: 14px 28px; border: none; border-radius: 24px;\n  font-size: 18px; font-weight: 600; cursor: pointer;\n  transition: transform 0.1s, box-shadow 0.2s;\n  letter-spacing: 2px;\n}\n.btn:active { transform: scale(0.95); }\n.btn-primary {\n  background: linear-gradient(135deg, #C84B31, #A63A22);\n  color: white; box-shadow: 0 4px 12px rgba(200,75,49,0.3);\n}\n.btn-secondary {\n  background: linear-gradient(135deg, #2D6A4F, #1E4D33);\n  color: white; box-shadow: 0 4px 12px rgba(45,106,79,0.3);\n}\n.btn-accent {\n  background: linear-gradient(135deg, #D4A843, #B8922E);\n  color: white; box-shadow: 0 4px 12px rgba(212,168,67,0.3);\n}\n\n.btn-back {\n  background: none; border: none; font-size: 20px;\n  cursor: pointer; padding: 8px; color: #8B7355;\n}\n\n/* ===== 关卡地图 ===== */\n.map-header {\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 12px 16px; background: rgba(255,255,255,0.9);\n  border-bottom: 1px solid #E8DED0;\n}\n.map-header h2 { font-size: 18px; color: #C84B31; }\n\n.chapter-info { padding: 8px 16px; }\n.chapter-badge {\n  display: inline-block; padding: 4px 12px; border-radius: 12px;\n  font-size: 13px; color: #2C2C2C; margin-right: 8px;\n}\n\n.level-grid {\n  flex: 1; overflow-y: auto; padding: 16px;\n  -webkit-overflow-scrolling: touch;\n}\n\n.chapter-section {\n  margin-bottom: 16px; padding: 12px;\n  background: rgba(255,255,255,0.7); border-radius: 16px;\n  border-left: 4px solid #D4A843;\n  display: flex; flex-wrap: wrap; gap: 8px; justify-content: center;\n}\n\n.level-btn {\n  width: 70px; padding: 8px 4px; border: 2px solid #E8DED0;\n  border-radius: 12px; background: #FFFDF7; cursor: pointer;\n  display: flex; flex-direction: column; align-items: center;\n  gap: 2px; transition: transform 0.1s;\n}\n.level-btn:active { transform: scale(0.95); }\n.level-btn.locked { opacity: 0.5; pointer-events: none; }\n.level-btn.completed { border-color: #27AE60; }\n.level-btn.boss {\n  background: linear-gradient(135deg, #FFF5E0, #FFE0B2);\n  border-color: #D4A843;\n}\n.level-num { font-size: 18px; font-weight: bold; color: #C84B31; }\n.level-stars { font-size: 10px; color: #D4A843; }\n.level-name { font-size: 9px; color: #8B7355; }\n.level-btn.locked .level-num { color: #ccc; }\n\n/* ===== 游戏界面 ===== */\n.game-header {\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 8px 16px; background: rgba(255,255,255,0.95);\n  border-bottom: 1px solid #E8DED0;\n}\n.header-center { display: flex; gap: 12px; font-size: 14px; font-weight: 600; }\n.header-right { font-size: 14px; }\n\n.game-body {\n  flex: 1; display: flex; flex-direction: column;\n  align-items: center; justify-content: center;\n  padding: 12px 16px; gap: 16px; overflow: hidden;\n}\n\n.combo-display {\n  font-size: 20px; font-weight: 800; color: #D4A843;\n  text-shadow: 0 2px 8px rgba(212,168,67,0.5);\n  display: none; animation: comboPopIn 0.3s ease-out;\n}\n.combo-3, .combo-4 { color: #D4A843; }\n.combo-5, .combo-6, .combo-7 { color: #FF8C00; font-size: 24px; }\n.combo-8, .combo-9 { color: #FF6347; font-size: 28px; }\n.combo-10 { color: #FF4500; font-size: 32px; animation: comboShake 0.3s ease-out; }\n\n@keyframes comboPopIn {\n  0% { transform: scale(0.5); opacity: 0; }\n  100% { transform: scale(1); opacity: 1; }\n}\n@keyframes comboShake {\n  0%, 100% { transform: translateX(0); }\n  25% { transform: translateX(-5px); }\n  75% { transform: translateX(5px); }\n}\n\n.meaning-box {\n  background: #FFFDF7; border: 2px solid #E8DED0;\n  border-radius: 12px; padding: 14px 20px;\n  text-align: center; max-width: 90%; min-height: 50px;\n  box-shadow: 0 2px 8px rgba(0,0,0,0.05);\n}\n#meaning-text { font-size: 16px; line-height: 1.5; color: #2C2C2C; }\n\n.slots-container {\n  display: flex; gap: 10px; margin: 8px 0;\n}\n\n.slot {\n  width: 60px; height: 60px;\n  border: 3px solid #8B7355; border-radius: 10px;\n  background: #FFFDF7; display: flex;\n  align-items: center; justify-content: center;\n  font-size: 28px; font-weight: bold; color: #2C2C2C;\n  cursor: pointer; transition: all 0.2s;\n  position: relative;\n}\n.slot.filled { background: #FFF8E8; border-color: #C84B31; }\n.slot.correct {\n  background: #27AE60; border-color: #27AE60; color: white;\n  animation: correctPulse 0.4s;\n}\n.slot.wrong {\n  background: #E74C3C; border-color: #E74C3C; color: white;\n  animation: wrongShake 0.5s;\n}\n\n@keyframes correctPulse {\n  0%, 100% { transform: scale(1); }\n  50% { transform: scale(1.12); }\n}\n@keyframes wrongShake {\n  0%, 100% { transform: translateX(0); }\n  25% { transform: translateX(-8px); }\n  75% { transform: translateX(8px); }\n}\n\n.idiom-hint {\n  font-size: 13px; color: #8B7355; text-align: center;\n  padding: 6px 12px; background: rgba(255,255,255,0.7);\n  border-radius: 8px; display: none; max-width: 90%;\n}\n.idiom-hint strong { color: #C84B31; }\n\n.candidates-container {\n  display: flex; flex-wrap: wrap; gap: 8px;\n  justify-content: center; max-width: 340px; margin-top: 8px;\n}\n\n.candidate {\n  width: 48px; height: 48px; border: none; border-radius: 10px;\n  background: linear-gradient(135deg, #C84B31, #A63A22);\n  color: white; font-size: 22px; font-weight: bold;\n  cursor: pointer; transition: all 0.15s;\n  display: flex; align-items: center; justify-content: center;\n}\n.candidate:active { transform: scale(0.9); }\n.candidate.used {\n  opacity: 0.25; pointer-events: none; transform: scale(0.9);\n}\n.candidate.removed {\n  opacity: 0.1; pointer-events: none;\n}\n\n.game-footer {\n  display: flex; justify-content: center; gap: 12px;\n  padding: 12px 16px; background: rgba(255,255,255,0.9);\n  border-top: 1px solid #E8DED0;\n}\n\n.tool-btn {\n  padding: 8px 16px; border: 2px solid #2D6A4F;\n  border-radius: 20px; background: white;\n  color: #2D6A4F; font-size: 14px; cursor: pointer;\n  transition: all 0.15s;\n}\n.tool-btn:active { background: #2D6A4F; color: white; }\n\n/* ===== 教学覆盖层 ===== */\n.tutorial-overlay {\n  position: absolute; bottom: 0; left: 0; right: 0;\n  background: rgba(0,0,0,0.7); padding: 20px;\n  display: flex; align-items: center; justify-content: center;\n  z-index: 100;\n}\n.tutorial-text {\n  color: white; font-size: 16px; text-align: center;\n  line-height: 1.5; max-width: 80%;\n}\n\n/* ===== 结算界面 ===== */\n.result-card {\n  flex: 1; display: flex; flex-direction: column;\n  align-items: center; justify-content: center;\n  background: linear-gradient(180deg, #FFFDF7, #F5F0E8);\n  padding: 40px 20px;\n}\n\n.result-title {\n  font-size: 36px; color: #C84B31; margin-bottom: 16px;\n}\n\n.result-stars {\n  font-size: 40px; color: #D4A843; margin-bottom: 20px;\n  display: flex; gap: 8px;\n}\n\n.result-stats {\n  text-align: center; margin-bottom: 24px; line-height: 2;\n  font-size: 16px;\n}\n.coins-earned {\n  font-size: 20px; font-weight: bold; color: #D4A843;\n  margin-top: 8px;\n}\n\n.result-buttons {\n  display: flex; flex-direction: column; gap: 10px; width: 220px;\n}\n\n/* ===== 模态框 ===== */\n.modal {\n  position: absolute; top: 0; left: 0; right: 0; bottom: 0;\n  background: rgba(0,0,0,0.6); display: flex;\n  align-items: center; justify-content: center; z-index: 200;\n}\n.modal-content {\n  background: #FFFDF7; border-radius: 20px; padding: 30px;\n  text-align: center; max-width: 320px; width: 90%;\n}\n.modal-content h3 { font-size: 22px; color: #C84B31; margin-bottom: 12px; }\n.modal-content p { margin-bottom: 20px; color: #8B7355; }\n.modal-buttons { display: flex; gap: 12px; justify-content: center; }\n\n/* ===== W2: 通用 ===== */\n.btn-outline {\n  padding: 10px 16px; border: 2px solid #D4A843; border-radius: 20px;\n  background: transparent; color: #8B7355; font-size: 14px; cursor: pointer;\n  transition: all 0.15s;\n}\n.btn-outline:active { background: #FFF8E8; }\n.btn-sm { padding: 8px 16px; font-size: 14px; }\n\n.menu-row {\n  display: flex; gap: 10px; margin-top: 16px; justify-content: center; flex-wrap: wrap;\n}\n\n/* ===== W2: 计时器 ===== */\n.timer-display {\n  font-size: 22px; font-weight: 800; color: #C84B31;\n  font-variant-numeric: tabular-nums;\n}\n.timer-warning { color: #E74C3C; animation: timerPulse 0.5s infinite; }\n@keyframes timerPulse {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 0.5; }\n}\n\n/* ===== W2: 成语图鉴 ===== */\n.col-bar-wrap { padding: 8px 16px; }\n.col-bar {\n  height: 8px; background: #E8DED0; border-radius: 4px; overflow: hidden;\n}\n.col-bar-fill {\n  height: 100%; background: linear-gradient(90deg, #2D6A4F, #27AE60);\n  border-radius: 4px; transition: width 0.3s;\n}\n.col-search {\n  display: block; width: calc(100% - 32px); margin: 8px 16px;\n  padding: 10px 14px; border: 2px solid #E8DED0; border-radius: 12px;\n  font-size: 14px; background: #FFFDF7; outline: none;\n}\n.col-search:focus { border-color: #C84B31; }\n.col-categories {\n  display: flex; flex-wrap: wrap; gap: 6px; padding: 4px 16px 8px;\n  overflow-x: auto;\n}\n.cat-btn {\n  padding: 4px 12px; border: 1px solid #E8DED0; border-radius: 14px;\n  background: #FFFDF7; font-size: 12px; cursor: pointer; white-space: nowrap;\n  color: #8B7355;\n}\n.cat-btn.active { background: #C84B31; color: white; border-color: #C84B31; }\n.col-grid {\n  flex: 1; overflow-y: auto; padding: 8px 16px;\n  display: grid; grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));\n  gap: 8px; align-content: start;\n}\n.idiom-card {\n  background: #FFFDF7; border: 2px solid #E8DED0; border-radius: 10px;\n  padding: 8px 4px; text-align: center; cursor: pointer;\n  transition: all 0.15s;\n}\n.idiom-card.collected { border-color: #2D6A4F; background: #F0FFF4; }\n.idiom-card:active { transform: scale(0.95); }\n.idiom-text { display: block; font-size: 15px; font-weight: bold; color: #2C2C2C; }\n.idiom-card:not(.collected) .idiom-text { color: #ccc; }\n.idiom-cat { display: block; font-size: 10px; color: #8B7355; margin-top: 2px; }\n.more-hint {\n  grid-column: 1 / -1; text-align: center; font-size: 13px;\n  color: #8B7355; padding: 8px;\n}\n.col-detail {\n  position: absolute; bottom: 0; left: 0; right: 0;\n  background: #FFFDF7; border-radius: 20px 20px 0 0; padding: 20px;\n  box-shadow: 0 -4px 20px rgba(0,0,0,0.1); max-height: 60vh; overflow-y: auto;\n  z-index: 50;\n}\n.detail-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }\n.detail-header h3 { font-size: 24px; color: #C84B31; }\n.detail-pinyin { color: #8B7355; font-size: 14px; margin-bottom: 8px; }\n.detail-meaning { font-size: 16px; line-height: 1.6; margin-bottom: 8px; }\n.detail-origin { font-size: 13px; color: #8B7355; margin-bottom: 4px; }\n.detail-example { font-size: 13px; color: #2D6A4F; font-style: italic; }\n.detail-locked { color: #8B7355; text-align: center; padding: 20px; }\n\n/* ===== W2: 每日系统 ===== */\n.daily-content { flex: 1; overflow-y: auto; padding: 16px; }\n.daily-login {\n  background: linear-gradient(135deg, #FFF8E8, #F5F0E8);\n  border-radius: 16px; padding: 20px; text-align: center; margin-bottom: 16px;\n  border: 2px solid #D4A843;\n}\n.daily-login h3 { color: #C84B31; margin-bottom: 8px; }\n.streak-num { font-size: 22px; font-weight: 800; color: #D4A843; }\n.daily-section { margin-bottom: 16px; }\n.daily-section h3 { font-size: 16px; color: #C84B31; margin-bottom: 8px; }\n.task-list { display: flex; flex-direction: column; gap: 8px; }\n.task-item {\n  display: flex; align-items: center; justify-content: space-between;\n  background: #FFFDF7; border: 1px solid #E8DED0; border-radius: 12px;\n  padding: 10px 14px;\n}\n.task-item.done { opacity: 0.6; }\n.task-desc { font-size: 14px; flex: 1; }\n.task-progress { font-size: 13px; color: #8B7355; margin: 0 8px; }\n.task-btn {\n  padding: 4px 12px; border: 1px solid #2D6A4F; border-radius: 12px;\n  background: white; color: #2D6A4F; font-size: 12px; cursor: pointer;\n}\n.task-btn.claimed { background: #F0F0F0; color: #999; border-color: #ddd; }\n.task-btn:disabled { cursor: default; }\n.challenge-card {\n  background: #FFFDF7; border: 2px solid #D4A843; border-radius: 16px;\n  padding: 16px; text-align: center;\n}\n.challenge-card.done { border-color: #2D6A4F; background: #F0FFF4; }\n.challenge-card h4 { color: #C84B31; margin-bottom: 8px; }\n.challenge-meaning { font-size: 16px; margin-bottom: 8px; }\n.challenge-hint { font-size: 14px; color: #8B7355; margin-bottom: 12px; }\n.challenge-done { color: #2D6A4F; font-weight: bold; }\n\n/* ===== W2: PK ===== */\n.pk-answers { margin: 12px 0; text-align: left; max-width: 280px; margin-left: auto; margin-right: auto; }\n.answer-item {\n  padding: 6px 12px; border-radius: 8px; margin-bottom: 4px;\n  font-size: 14px;\n}\n.answer-item.correct { background: #F0FFF4; color: #2D6A4F; }\n.answer-item.wrong { background: #FFF0F0; color: #E74C3C; }\n\n/* ===== W2: 角色 ===== */\n.char-grid {\n  flex: 1; overflow-y: auto; padding: 16px;\n  display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;\n  align-content: start;\n}\n.char-card {\n  background: #FFFDF7; border: 2px solid #E8DED0; border-radius: 16px;\n  padding: 16px; text-align: center; cursor: pointer; transition: all 0.15s;\n}\n.char-card.selected { border-color: #D4A843; background: #FFF8E8; box-shadow: 0 2px 12px rgba(212,168,67,0.3); }\n.char-card.locked { opacity: 0.5; cursor: default; }\n.char-card:active:not(.locked) { transform: scale(0.97); }\n.char-avatar { font-size: 40px; margin-bottom: 8px; }\n.char-name { font-size: 15px; font-weight: bold; color: #2C2C2C; margin-bottom: 4px; }\n.char-skill { font-size: 12px; color: #8B7355; }\n.char-badge {\n  margin-top: 8px; padding: 2px 10px; background: #D4A843; color: white;\n  border-radius: 10px; font-size: 11px; display: inline-block;\n}\n.char-detail {\n  padding: 16px; background: #FFFDF7; border-top: 1px solid #E8DED0;\n  text-align: center;\n}\n.char-detail h4 { font-size: 18px; color: #C84B31; margin-bottom: 8px; }\n.skill-name { font-weight: bold; color: #2D6A4F; margin-bottom: 4px; }\n.skill-desc { font-size: 14px; color: #8B7355; }\n\n/* ===== W3: 广告按钮 ===== */\n.btn-ad {\n  background: linear-gradient(135deg, #D4A843 0%, #E8B84D 100%);\n  color: white; border: none; border-radius: 12px;\n  padding: 10px 24px; font-size: 15px; font-weight: bold;\n  cursor: pointer; display: inline-flex; align-items: center; gap: 6px;\n  transition: all 0.15s; box-shadow: 0 2px 8px rgba(212,168,67,0.3);\n}\n.btn-ad:active { transform: scale(0.96); }\n.btn-ad:hover { box-shadow: 0 4px 12px rgba(212,168,67,0.4); }\n","numLines":466,"startLine":1,"totalLines":466}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_dd0cba23cfee41c8839f1716","type":"tool_result","content":"1\t// Renderer.js — UI rendering (W2 extended)\n2\t\n3\tfunction renderUI(game) {\n4\t  const screens = ['menu-screen','map-screen','game-screen','result-screen',\n5\t    'timed-screen','timed-result-screen','collection-screen','daily-screen',\n6\t    'pk-screen','pk-result-screen','characters-screen'];\n7\t  screens.forEach(id => {\n8\t    const el = document.getElementById(id);\n9\t    if (el) el.classList.remove('active');\n10\t  });\n11\t\n12\t  switch (game.state) {\n13\t    case 'menu': renderMenu(game); break;\n14\t    case 'map': renderMap(game); break;\n15\t    case 'playing': renderGame(game); break;\n16\t    case 'result': renderResult(game); break;\n17\t    case 'timed': renderTimed(game); break;\n18\t    case 'timed_result': renderTimedResult(game); break;\n19\t    case 'collection': renderCollection(game); break;\n20\t    case 'daily': renderDaily(game); break;\n21\t    case 'pk': renderPK(game); break;\n22\t    case 'pk_result': renderPKResult(game); break;\n23\t    case 'characters': renderCharacters(game); break;\n24\t  }\n25\t}\n26\t\n27\tfunction showScreen(id) {\n28\t  const el = document.getElementById(id);\n29\t  if (el) el.classList.add('active');\n30\t}\n31\t\n32\tfunction renderMenu(game) {\n33\t  showScreen('menu-screen');\n34\t  const mc = document.getElementById('menu-coins');\n35\t  const mcl = document.getElementById('menu-collected');\n36\t  if (mc) mc.textContent = game.data.coins;\n37\t  if (mcl) mcl.textContent = game.data.collectedCount;\n38\t\n39\t  const charAvatar = document.getElementById('menu-avatar');\n40\t  if (charAvatar) {\n41\t    const ch = game.characters.getCurrent();\n42\t    charAvatar.textContent = ch.avatar;\n43\t  }\n44\t}\n45\t\n46\tfunction renderMap(game) {\n47\t  showScreen('map-screen');\n48\t  const mc = document.getElementById('map-coins');\n49\t  if (mc) mc.textContent = game.data.coins;\n50\t\n51\t  const grid = document.getElementById('level-grid');\n52\t  if (!grid) return;\n53\t  grid.innerHTML = '';\n54\t\n55\t  const chapters = {};\n56\t  LEVELS.forEach(l => {\n57\t    if (!chapters[l.chapter]) chapters[l.chapter] = [];\n58\t    chapters[l.chapter].push(l);\n59\t  });\n60\t\n61\t  const chapInfo = document.getElementById('chapter-info');\n62\t  if (chapInfo) {\n63\t    chapInfo.innerHTML = CHAPTERS.map(c =>\n64\t      `<div class=\"chapter-badge\" style=\"background:${c.color};${c.id>=4?'color:#fff':''}\">${c.name} · ${c.subtitle}</div>`\n65\t    ).join('');\n66\t  }\n67\t\n68\t  Object.keys(chapters).forEach(chId => {\n69\t    const section = document.createElement('div');\n70\t    section.className = 'chapter-section';\n71\t    const chap = CHAPTERS.find(c => c.id === parseInt(chId));\n72\t    if (chap) section.style.borderColor = chap.color;\n73\t\n74\t    chapters[chId].forEach(level => {\n75\t      const btn = document.createElement('button');\n76\t      const stars = game.data.getLevelStars(level.id);\n77\t      const unlocked = level.id <= game.data.unlockedLevel;\n78\t      const isBoss = level.boss;\n79\t\n80\t      btn.className = 'level-btn' + (isBoss ? ' boss' : '') + (!unlocked ? ' locked' : '') + (stars > 0 ? ' completed' : '');\n81\t      btn.innerHTML = `\n82\t        <span class=\"level-num\">${level.id}</span>\n83\t        <span class=\"level-stars\">${'★'.repeat(stars)}${'☆'.repeat(3 - stars)}</span>\n84\t        <span class=\"level-name\">${level.name}</span>\n85\t      `;\n86\t\n87\t      if (unlocked) btn.onclick = () => game.startLevel(level.id);\n88\t      section.appendChild(btn);\n89\t    });\n90\t    grid.appendChild(section);\n91\t  });\n92\t}\n93\t\n94\tfunction renderGame(game) {\n95\t  showScreen('game-screen');\n96\t  const q = game.getCurrentQuestion();\n97\t  if (!q) return;\n98\t\n99\t  const ll = document.getElementById('level-label');\n100\t  const pl = document.getElementById('progress-label');\n101\t  const ld = document.getElementById('lives-display');\n102\t  if (ll) ll.textContent = `第${game.currentLevel.id}关`;\n103\t  if (pl) pl.textContent = `${game.questionIndex + 1}/${game.questions.length}`;\n104\t  if (ld) ld.textContent = '❤️'.repeat(Math.max(0, game.lives));\n105\t\n106\t  const mt = document.getElementById('meaning-text');\n107\t  if (mt) mt.textContent = q.idiom.meaning;\n108\t\n109\t  const cd = document.getElementById('combo-display');\n110\t  if (cd) {\n111\t    if (game.combo.combo >= 3) {\n112\t      cd.textContent = `🔥 ${game.combo.combo}连击！${game.combo.getComboMessage()}`;\n113\t      cd.style.display = 'block';\n114\t      cd.className = 'combo-display combo-' + Math.min(game.combo.combo, 10);\n115\t    } else {\n116\t      cd.style.display = 'none';\n117\t    }\n118\t  }\n119\t\n120\t  const sc = document.getElementById('slots-container');\n121\t  if (sc) {\n122\t    sc.innerHTML = '';\n123\t    const slots = game.judge.getSlots();\n124\t    for (let i = 0; i < 4; i++) {\n125\t      const slot = document.createElement('div');\n126\t      slot.className = 'slot';\n127\t      if (slots[i]) {\n128\t        slot.classList.add('filled');\n129\t        slot.textContent = slots[i].char;\n130\t        slot.onclick = () => { game.removeSlot(i); };\n131\t      }\n132\t      if (q.answered && q.correct === true) slot.classList.add('correct');\n133\t      if (q.answered && q.correct === false) slot.classList.add('wrong');\n134\t      sc.appendChild(slot);\n135\t    }\n136\t  }\n137\t\n138\t  const ih = document.getElementById('idiom-hint');\n139\t  if (ih) {\n140\t    if (q.answered && q.correct) {\n141\t      ih.innerHTML = `<strong>${q.idiom.idiom}</strong>：${q.idiom.meaning}`;\n142\t      ih.style.display = 'block';\n143\t    } else {\n144\t      ih.style.display = 'none';\n145\t    }\n146\t  }\n147\t\n148\t  const cc = document.getElementById('candidates-container');\n149\t  if (cc) {\n150\t    cc.innerHTML = '';\n151\t    q.candidates.forEach((c, i) => {\n152\t      const btn = document.createElement('button');\n153\t      btn.className = 'candidate';\n154\t      btn.textContent = c.char;\n155\t      if (c.used) btn.classList.add('used');\n156\t      if (c.removed) btn.classList.add('removed');\n157\t      if (!c.used && !c.removed && !q.answered) btn.onclick = () => game.pickChar(i);\n158\t      cc.appendChild(btn);\n159\t    });\n160\t  }\n161\t\n162\t  const to = document.getElementById('tutorial-overlay');\n163\t  const tt = document.getElementById('tutorial-text');\n164\t  if (to && tt) {\n165\t    const step = game.tutorial.getCurrentStep();\n166\t    if (step) { tt.textContent = step.msg; to.style.display = 'flex'; }\n167\t    else { to.style.display = 'none'; }\n168\t  }\n169\t\n170\t  // Update tool button costs\n171\t  const hintBtns = document.querySelectorAll('.tool-btn');\n172\t  if (hintBtns.length >= 3) {\n173\t    hintBtns[0].textContent = `📖 揭示 (${game.hintRevealCost}🪙)`;\n174\t    hintBtns[1].textContent = `✂️ 去干扰 (${game.hintRemoveCost}🪙)`;\n175\t    hintBtns[2].textContent = `⏭ 跳过 (${game.skipCost}🪙)`;\n176\t  }\n177\t}\n178\t\n179\tfunction renderResult(game) {\n180\t  showScreen('result-screen');\n181\t  const r = game.levelResult;\n182\t  if (!r) return;\n183\t\n184\t  const rt = document.getElementById('result-title');\n185\t  if (rt) rt.textContent = r.stars > 0 ? '🎉 通关!' : '😞 失败';\n186\t\n187\t  const rs = document.getElementById('result-stars');\n188\t  if (rs) rs.innerHTML = '★'.repeat(r.stars) + '☆'.repeat(3 - r.stars);\n189\t\n190\t  document.getElementById('result-correct').textContent = r.correctCount;\n191\t  document.getElementById('result-total').textContent = r.totalQuestions;\n192\t  document.getElementById('result-score').textContent = r.score;\n193\t  document.getElementById('result-combo').textContent = r.maxCombo;\n194\t  document.getElementById('result-coins').textContent = r.coins;\n195\t\n196\t  const btnNext = document.getElementById('btn-next');\n197\t  if (btnNext) {\n198\t    const nextId = game.currentLevel.id + 1;\n199\t    btnNext.style.display = (r.stars > 0 && LEVELS.find(l => l.id === nextId)) ? 'inline-block' : 'none';\n200\t  }\n201\t  const btnRetry = document.getElementById('btn-retry');\n202\t  if (btnRetry) btnRetry.style.display = r.stars > 0 ? 'none' : 'inline-block';\n203\t\n204\t  // W3: Double reward button\n205\t  const btnDouble = document.getElementById('btn-double');\n206\t  if (btnDouble) {\n207\t    const canDouble = r.stars > 0 && !game._doubledReward &&\n208\t      game.adManager && game.adManager.canShowRewarded(AD_PLACEMENTS.DOUBLE_REWARD);\n209\t    btnDouble.style.display = canDouble ? 'inline-block' : 'none';\n210\t  }\n211\t}\n212\t\n213\t// ===== W2: Timed Challenge =====\n214\tfunction renderTimed(game) {\n215\t  showScreen('timed-screen');\n216\t  const tc = game.timed;\n217\t  const q = tc.currentQ;\n218\t  if (!q) return;\n219\t\n220\t  const timer = document.getElementById('timed-timer');\n221\t  if (timer) {\n222\t    timer.textContent = `${tc.timeLeft}s`;\n223\t    timer.className = 'timer-display' + (tc.timeLeft <= 10 ? ' timer-warning' : '');\n224\t  }\n225\t\n226\t  const score = document.getElementById('timed-score');\n227\t  if (score) score.textContent = tc.score;\n228\t\n229\t  const combo = document.getElementById('timed-combo');\n230\t  if (combo) {\n231\t    if (game.combo.combo >= 3) {\n232\t      combo.textContent = `🔥 ${game.combo.combo}连击！`;\n233\t      combo.style.display = 'block';\n234\t    } else {\n235\t      combo.style.display = 'none';\n236\t    }\n237\t  }\n238\t\n239\t  const mt = document.getElementById('timed-meaning');\n240\t  if (mt) mt.textContent = q.idiom.meaning;\n241\t\n242\t  const sc = document.getElementById('timed-slots');\n243\t  if (sc) {\n244\t    sc.innerHTML = '';\n245\t    const slots = tc.judge.getSlots();\n246\t    for (let i = 0; i < 4; i++) {\n247\t      const slot = document.createElement('div');\n248\t      slot.className = 'slot';\n249\t      if (slots[i]) { slot.classList.add('filled'); slot.textContent = slots[i].char; slot.onclick = () => tc.removeSlot(i); }\n250\t      if (q.answered && q.correct === true) slot.classList.add('correct');\n251\t      if (q.answered && q.correct === false) slot.classList.add('wrong');\n252\t      sc.appendChild(slot);\n253\t    }\n254\t  }\n255\t\n256\t  const cc = document.getElementById('timed-candidates');\n257\t  if (cc) {\n258\t    cc.innerHTML = '';\n259\t    q.candidates.forEach((c, i) => {\n260\t      const btn = document.createElement('button');\n261\t      btn.className = 'candidate';\n262\t      btn.textContent = c.char;\n263\t      if (c.used) btn.classList.add('used');\n264\t      if (c.removed) btn.classList.add('removed');\n265\t      if (!c.used && !c.removed && !q.answered) btn.onclick = () => tc.pickChar(i);\n266\t      cc.appendChild(btn);\n267\t    });\n268\t  }\n269\t}\n270\t\n271\tfunction renderTimedResult(game) {\n272\t  showScreen('timed-result-screen');\n273\t  const r = game.timed.getResult();\n274\t  document.getElementById('tr-score').textContent = r.score;\n275\t  document.getElementById('tr-correct').textContent = r.correctCount;\n276\t  document.getElementById('tr-total').textContent = r.answeredCount;\n277\t  document.getElementById('tr-combo').textContent = r.maxCombo;\n278\t  document.getElementById('tr-coins').textContent = Math.floor(r.score / 10);\n279\t}\n280\t\n281\t// ===== W2: Collection =====\n282\tfunction renderCollection(game) {\n283\t  showScreen('collection-screen');\n284\t  const col = game.collection;\n285\t  const progress = col.getProgress();\n286\t\n287\t  document.getElementById('col-progress').textContent = `${progress.collected}/${progress.total} (${progress.percent}%)`;\n288\t\n289\t  const bar = document.getElementById('col-progress-bar');\n290\t  if (bar) bar.style.width = progress.percent + '%';\n291\t\n292\t  // Categories\n293\t  const catContainer = document.getElementById('col-categories');\n294\t  if (catContainer) {\n295\t    const cats = ['全部', ...col.getCategories()];\n296\t    catContainer.innerHTML = cats.map(c =>\n297\t      `<button class=\"cat-btn${col.selectedCategory === (c === '全部' ? null : c) ? ' active' : ''}\" onclick=\"handleCategoryFilter('${c}')\">${c}</button>`\n298\t    ).join('');\n299\t  }\n300\t\n301\t  // Search\n302\t  const searchInput = document.getElementById('col-search');\n303\t  if (searchInput && searchInput.value !== col.searchQuery) {\n304\t    searchInput.value = col.searchQuery;\n305\t  }\n306\t\n307\t  // Idiom grid\n308\t  const grid = document.getElementById('col-grid');\n309\t  if (grid) {\n310\t    const idioms = col.getFilteredIdioms();\n311\t    grid.innerHTML = idioms.slice(0, 60).map(i =>\n312\t      `<div class=\"idiom-card${i.collected ? ' collected' : ''}\" onclick=\"handleIdiomSelect('${i.id}')\">\n313\t        <span class=\"idiom-text\">${i.collected ? i.idiom : '？？？？'}</span>\n314\t        <span class=\"idiom-cat\">${(i.category || [])[0] || ''}</span>\n315\t      </div>`\n316\t    ).join('');\n317\t    if (idioms.length > 60) {\n318\t      grid.innerHTML += `<div class=\"more-hint\">还有${idioms.length - 60}个...</div>`;\n319\t    }\n320\t  }\n321\t\n322\t  // Detail view\n323\t  const detail = document.getElementById('col-detail');\n324\t  if (detail) {\n325\t    if (col.selectedIdiom) {\n326\t      const i = col.selectedIdiom;\n327\t      const collected = game.data.collectedIdioms.includes(i.id);\n328\t      detail.style.display = 'block';\n329\t      detail.innerHTML = `\n330\t        <div class=\"detail-header\">\n331\t          <h3>${collected ? i.idiom : '？？？？'}</h3>\n332\t          <button class=\"btn-back\" onclick=\"game.collection.selectIdiom(null)\">✕</button>\n333\t        </div>\n334\t        ${collected ? `\n335\t          <p class=\"detail-pinyin\">${i.pinyin || ''}</p>\n336\t          <p class=\"detail-meaning\">${i.meaning}</p>\n337\t          ${i.origin ? `<p class=\"detail-origin\">出处：${i.origin}</p>` : ''}\n338\t          ${i.example ? `<p class=\"detail-example\">例句：${i.example}</p>` : ''}\n339\t        ` : '<p class=\"detail-locked\">收集此成语后可查看详情</p>'}\n340\t      `;\n341\t    } else {\n342\t      detail.style.display = 'none';\n343\t    }\n344\t  }\n345\t}\n346\t\n347\t// ===== W2: Daily =====\n348\tfunction renderDaily(game) {\n349\t  showScreen('daily-screen');\n350\t  const ds = game.daily.getDailyState();\n351\t\n352\t  document.getElementById('daily-streak').textContent = ds.loginStreak;\n353\t  document.getElementById('daily-claimed').textContent = ds.todayClaimed ? '已领取' : '未领取';\n354\t  document.getElementById('daily-claim-btn').disabled = ds.todayClaimed;\n355\t  document.getElementById('daily-claim-btn').textContent = ds.todayClaimed ? '已领取 ✓' : `领取签到奖励 (×${Math.min(ds.loginStreak, 7)}0🪙)`;\n356\t\n357\t  // W3: Daily double ad button\n358\t  const dailyDoubleBtn = document.getElementById('daily-double-btn');\n359\t  if (dailyDoubleBtn) {\n360\t    dailyDoubleBtn.style.display = (ds.todayClaimed && !ds.doubled &&\n361\t      game.adManager && game.adManager.canShowRewarded(AD_PLACEMENTS.DAILY_DOUBLE)) ? 'inline-block' : 'none';\n362\t  }\n363\t\n364\t  // Tasks\n365\t  const tasksEl = document.getElementById('daily-tasks');\n366\t  if (tasksEl) {\n367\t    tasksEl.innerHTML = ds.tasks.map(t => `\n368\t      <div class=\"task-item${t.claimed ? ' done' : ''}\">\n369\t        <span class=\"task-desc\">${t.desc}</span>\n370\t        <span class=\"task-progress\">${t.progress}/${t.target}</span>\n371\t        <button class=\"task-btn${t.claimed ? ' claimed' : ''}\"\n372\t          ${t.claimed || t.progress < t.target ? 'disabled' : ''}\n373\t          onclick=\"handleClaimTask('${t.id}')\">\n374\t          ${t.claimed ? '已领' : `${t.reward}🪙`}\n375\t        </button>\n376\t      </div>\n377\t    `).join('');\n378\t  }\n379\t\n380\t  // Challenge\n381\t  const challengeEl = document.getElementById('daily-challenge');\n382\t  if (challengeEl) {\n383\t    if (ds.challengeIdiom) {\n384\t      challengeEl.innerHTML = `\n385\t        <div class=\"challenge-card${ds.challengeCompleted ? ' done' : ''}\">\n386\t          <h4>今日成语挑战</h4>\n387\t          <p class=\"challenge-meaning\">${ds.challengeIdiom.meaning}</p>\n388\t          <p class=\"challenge-hint\">${ds.challengeCompleted ? `答案：${ds.challengeIdiom.idiom}` : '提示：' + ds.challengeIdiom.chars[0] + '？？？'}</p>\n389\t          ${ds.challengeCompleted ?\n390\t            '<span class=\"challenge-done\">已完成 ✓ +50🪙</span>' :\n391\t            `<button class=\"btn btn-primary btn-sm\" onclick=\"handleDailyChallenge()\">挑战</button>`\n392\t          }\n393\t        </div>\n394\t      `;\n395\t    }\n396\t  }\n397\t}\n398\t\n399\t// ===== W2: PK =====\n400\tfunction renderPK(game) {\n401\t  showScreen('pk-screen');\n402\t  const pk = game.pk;\n403\t  const q = pk.currentQ;\n404\t  if (!q) return;\n405\t\n406\t  document.getElementById('pk-progress').textContent = `${pk.currentIndex + 1}/5`;\n407\t\n408\t  const mt = document.getElementById('pk-meaning');\n409\t  if (mt) mt.textContent = q.idiom.meaning;\n410\t\n411\t  const sc = document.getElementById('pk-slots');\n412\t  if (sc) {\n413\t    sc.innerHTML = '';\n414\t    const slots = pk.judge.getSlots();\n415\t    for (let i = 0; i < 4; i++) {\n416\t      const slot = document.createElement('div');\n417\t      slot.className = 'slot';\n418\t      if (slots[i]) { slot.classList.add('filled'); slot.textContent = slots[i].char; slot.onclick = () => pk.removeSlot(i); }\n419\t      if (q.answered && q.correct === true) slot.classList.add('correct');\n420\t      if (q.answered && q.correct === false) slot.classList.add('wrong');\n421\t      sc.appendChild(slot);\n422\t    }\n423\t  }\n424\t\n425\t  const cc = document.getElementById('pk-candidates');\n426\t  if (cc) {\n427\t    cc.innerHTML = '';\n428\t    q.candidates.forEach((c, i) => {\n429\t      const btn = document.createElement('button');\n430\t      btn.className = 'candidate';\n431\t      btn.textContent = c.char;\n432\t      if (c.used) btn.classList.add('used');\n433\t      if (c.removed) btn.classList.add('removed');\n434\t      if (!c.used && !c.removed && !q.answered) btn.onclick = () => pk.pickChar(i);\n435\t      cc.appendChild(btn);\n436\t    });\n437\t  }\n438\t}\n439\t\n440\tfunction renderPKResult(game) {\n441\t  showScreen('pk-result-screen');\n442\t  const r = game.pk.getResult();\n443\t  document.getElementById('pkr-result').textContent = r.won ? '🎉 胜利！' : '😢 惜败';\n444\t  document.getElementById('pkr-correct').textContent = `${r.correctCount}/5`;\n445\t  document.getElementById('pkr-time').textContent = `${(r.time / 1000).toFixed(1)}s`;\n446\t  document.getElementById('pkr-reward').textContent = r.won ? '+50🪙' : '';\n447\t\n448\t  // Answers review\n449\t  const answersEl = document.getElementById('pkr-answers');\n450\t  if (answersEl) {\n451\t    answersEl.innerHTML = r.answers.map((a, i) =>\n452\t      `<div class=\"answer-item${a.correct ? ' correct' : ' wrong'}\">${i+1}. ${a.idiom} ${a.correct ? '✓' : '✗'}</div>`\n453\t    ).join('');\n454\t  }\n455\t}\n456\t\n457\t// ===== W2: Characters =====\n458\tfunction renderCharacters(game) {\n459\t  showScreen('characters-screen');\n460\t  const chars = game.characters.getAll();\n461\t\n462\t  const grid = document.getElementById('char-grid');\n463\t  if (grid) {\n464\t    grid.innerHTML = chars.map(c => {\n465\t      const selected = game.data.data.characters.current === c.id;\n466\t      return `\n467\t        <div class=\"char-card${selected ? ' selected' : ''}${!c.unlocked ? ' locked' : ''}\"\n468\t             onclick=\"${c.unlocked ? `game.characters.select('${c.id}'); game.render()` : ''}\">\n469\t          <div class=\"char-avatar\">${c.unlocked ? c.avatar : '🔒'}</div>\n470\t          <div class=\"char-name\">${c.name}</div>\n471\t          <div class=\"char-skill\">${c.unlocked ? c.skill.name : `通关第${c.unlock.level || '?'}关解锁`}</div>\n472\t          ${selected ? '<div class=\"char-badge\">使用中</div>' : ''}\n473\t        </div>\n474\t      `;\n475\t    }).join('');\n476\t  }\n477\t\n478\t  // Skill detail\n479\t  const current = game.characters.getCurrent();\n480\t  const detail = document.getElementById('char-detail');\n481\t  if (detail) {\n482\t    detail.innerHTML = `\n483\t      <h4>${current.avatar} ${current.name}</h4>\n484\t      <p class=\"skill-name\">${current.skill.name}</p>\n485\t      <p class=\"skill-desc\">${current.skill.desc}</p>\n486\t    `;\n487\t  }\n488\t}\n489\t\n490\t// ===== Global handlers =====\n491\tfunction handleCategoryFilter(cat) {\n492\t  if (cat === '全部') { game.collection.clearFilter(); }\n493\t  else { game.collection.filterByCategory(cat); }\n494\t  game.render();\n495\t}\n496\t\n497\tfunction handleIdiomSelect(id) { game.collection.selectIdiom(id); game.render(); }\n498\t\n499\tfunction handleClaimTask(taskId) { game.daily.claimTask(taskId); game.render(); }\n500\t\n501\tfunction handleDailyChallenge() {\n502\t  const ds = game.daily.getDailyState();\n503\t  if (ds.challengeIdiom && !ds.challengeCompleted) {\n504\t    game.daily.completeChallenge();\n505\t    game.render();\n506\t  }\n507\t}\n508\t\n509\tfunction handleColSearch(val) { game.collection.search(val); game.render(); }\n510\t"}]},"parent_tool_use_id":null,"session_id":"7463fb62-2e03-4edd-abad-466ff792dff1","uuid":"1822be74-6fab-4d58-8f7b-e0b90da30490","timestamp":"2026-05-23T10:38:05.879Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/src/js/Renderer.js","content":"// Renderer.js — UI rendering (W2 extended)\n\nfunction renderUI(game) {\n  const screens = ['menu-screen','map-screen','game-screen','result-screen',\n    'timed-screen','timed-result-screen','collection-screen','daily-screen',\n    'pk-screen','pk-result-screen','characters-screen'];\n  screens.forEach(id => {\n    const el = document.getElementById(id);\n    if (el) el.classList.remove('active');\n  });\n\n  switch (game.state) {\n    case 'menu': renderMenu(game); break;\n    case 'map': renderMap(game); break;\n    case 'playing': renderGame(game); break;\n    case 'result': renderResult(game); break;\n    case 'timed': renderTimed(game); break;\n    case 'timed_result': renderTimedResult(game); break;\n    case 'collection': renderCollection(game); break;\n    case 'daily': renderDaily(game); break;\n    case 'pk': renderPK(game); break;\n    case 'pk_result': renderPKResult(game); break;\n    case 'characters': renderCharacters(game); break;\n  }\n}\n\nfunction showScreen(id) {\n  const el = document.getElementById(id);\n  if (el) el.classList.add('active');\n}\n\nfunction renderMenu(game) {\n  showScreen('menu-screen');\n  const mc = document.getElementById('menu-coins');\n  const mcl = document.getElementById('menu-collected');\n  if (mc) mc.textContent = game.data.coins;\n  if (mcl) mcl.textContent = game.data.collectedCount;\n\n  const charAvatar = document.getElementById('menu-avatar');\n  if (charAvatar) {\n    const ch = game.characters.getCurrent();\n    charAvatar.textContent = ch.avatar;\n  }\n}\n\nfunction renderMap(game) {\n  showScreen('map-screen');\n  const mc = document.getElementById('map-coins');\n  if (mc) mc.textContent = game.data.coins;\n\n  const grid = document.getElementById('level-grid');\n  if (!grid) return;\n  grid.innerHTML = '';\n\n  const chapters = {};\n  LEVELS.forEach(l => {\n    if (!chapters[l.chapter]) chapters[l.chapter] = [];\n    chapters[l.chapter].push(l);\n  });\n\n  const chapInfo = document.getElementById('chapter-info');\n  if (chapInfo) {\n    chapInfo.innerHTML = CHAPTERS.map(c =>\n      `<div class=\"chapter-badge\" style=\"background:${c.color};${c.id>=4?'color:#fff':''}\">${c.name} · ${c.subtitle}</div>`\n    ).join('');\n  }\n\n  Object.keys(chapters).forEach(chId => {\n    const section = document.createElement('div');\n    section.className = 'chapter-section';\n    const chap = CHAPTERS.find(c => c.id === parseInt(chId));\n    if (chap) section.style.borderColor = chap.color;\n\n    chapters[chId].forEach(level => {\n      const btn = document.createElement('button');\n      const stars = game.data.getLevelStars(level.id);\n      const unlocked = level.id <= game.data.unlockedLevel;\n      const isBoss = level.boss;\n\n      btn.className = 'level-btn' + (isBoss ? ' boss' : '') + (!unlocked ? ' locked' : '') + (stars > 0 ? ' completed' : '');\n      btn.innerHTML = `\n        <span class=\"level-num\">${level.id}</span>\n        <span class=\"level-stars\">${'★'.repeat(stars)}${'☆'.repeat(3 - stars)}</span>\n        <span class=\"level-name\">${level.name}</span>\n      `;\n\n      if (unlocked) btn.onclick = () => game.startLevel(level.id);\n      section.appendChild(btn);\n    });\n    grid.appendChild(section);\n  });\n}\n\nfunction renderGame(game) {\n  showScreen('game-screen');\n  const q = game.getCurrentQuestion();\n  if (!q) return;\n\n  const ll = document.getElementById('level-label');\n  const pl = document.getElementById('progress-label');\n  const ld = document.getElementById('lives-display');\n  if (ll) ll.textContent = `第${game.currentLevel.id}关`;\n  if (pl) pl.textContent = `${game.questionIndex + 1}/${game.questions.length}`;\n  if (ld) ld.textContent = '❤️'.repeat(Math.max(0, game.lives));\n\n  const mt = document.getElementById('meaning-text');\n  if (mt) mt.textContent = q.idiom.meaning;\n\n  const cd = document.getElementById('combo-display');\n  if (cd) {\n    if (game.combo.combo >= 3) {\n      cd.textContent = `🔥 ${game.combo.combo}连击！${game.combo.getComboMessage()}`;\n      cd.style.display = 'block';\n      cd.className = 'combo-display combo-' + Math.min(game.combo.combo, 10);\n    } else {\n      cd.style.display = 'none';\n    }\n  }\n\n  const sc = document.getElementById('slots-container');\n  if (sc) {\n    sc.innerHTML = '';\n    const slots = game.judge.getSlots();\n    for (let i = 0; i < 4; i++) {\n      const slot = document.createElement('div');\n      slot.className = 'slot';\n      if (slots[i]) {\n        slot.classList.add('filled');\n        slot.textContent = slots[i].char;\n        slot.onclick = () => { game.removeSlot(i); };\n      }\n      if (q.answered && q.correct === true) slot.classList.add('correct');\n      if (q.answered && q.correct === false) slot.classList.add('wrong');\n      sc.appendChild(slot);\n    }\n  }\n\n  const ih = document.getElementById('idiom-hint');\n  if (ih) {\n    if (q.answered && q.correct) {\n      ih.innerHTML = `<strong>${q.idiom.idiom}</strong>：${q.idiom.meaning}`;\n      ih.style.display = 'block';\n    } else {\n      ih.style.display = 'none';\n    }\n  }\n\n  const cc = document.getElementById('candidates-container');\n  if (cc) {\n    cc.innerHTML = '';\n    q.candidates.forEach((c, i) => {\n      const btn = document.createElement('button');\n      btn.className = 'candidate';\n      btn.textContent = c.char;\n      if (c.used) btn.classList.add('used');\n      if (c.removed) btn.classList.add('removed');\n      if (!c.used && !c.removed && !q.answered) btn.onclick = () => game.pickChar(i);\n      cc.appendChild(btn);\n    });\n  }\n\n  const to = document.getElementById('tutorial-overlay');\n  const tt = document.getElementById('tutorial-text');\n  if (to && tt) {\n    const step = game.tutorial.getCurrentStep();\n    if (step) { tt.textContent = step.msg; to.style.display = 'flex'; }\n    else { to.style.display = 'none'; }\n  }\n\n  // Update tool button costs\n  const hintBtns = document.querySelectorAll('.tool-btn');\n  if (hintBtns.length >= 3) {\n    hintBtns[0].textContent = `📖 揭示 (${game.hintRevealCost}🪙)`;\n    hintBtns[1].textContent = `✂️ 去干扰 (${game.hintRemoveCost}🪙)`;\n    hintBtns[2].textContent = `⏭ 跳过 (${game.skipCost}🪙)`;\n  }\n}\n\nfunction renderResult(game) {\n  showScreen('result-screen');\n  const r = game.levelResult;\n  if (!r) return;\n\n  const rt = document.getElementById('result-title');\n  if (rt) rt.textContent = r.stars > 0 ? '🎉 通关!' : '😞 失败';\n\n  const rs = document.getElementById('result-stars');\n  if (rs) rs.innerHTML = '★'.repeat(r.stars) + '☆'.repeat(3 - r.stars);\n\n  document.getElementById('result-correct').textContent = r.correctCount;\n  document.getElementById('result-total').textContent = r.totalQuestions;\n  document.getElementById('result-score').textContent = r.score;\n  document.getElementById('result-combo').textContent = r.maxCombo;\n  document.getElementById('result-coins').textContent = r.coins;\n\n  const btnNext = document.getElementById('btn-next');\n  if (btnNext) {\n    const nextId = game.currentLevel.id + 1;\n    btnNext.style.display = (r.stars > 0 && LEVELS.find(l => l.id === nextId)) ? 'inline-block' : 'none';\n  }\n  const btnRetry = document.getElementById('btn-retry');\n  if (btnRetry) btnRetry.style.display = r.stars > 0 ? 'none' : 'inline-block';\n\n  // W3: Double reward button\n  const btnDouble = document.getElementById('btn-double');\n  if (btnDouble) {\n    const canDouble = r.stars > 0 && !game._doubledReward &&\n      game.adManager && game.adManager.canShowRewarded(AD_PLACEMENTS.DOUBLE_REWARD);\n    btnDouble.style.display = canDouble ? 'inline-block' : 'none';\n  }\n}\n\n// ===== W2: Timed Challenge =====\nfunction renderTimed(game) {\n  showScreen('timed-screen');\n  const tc = game.timed;\n  const q = tc.currentQ;\n  if (!q) return;\n\n  const timer = document.getElementById('timed-timer');\n  if (timer) {\n    timer.textContent = `${tc.timeLeft}s`;\n    timer.className = 'timer-display' + (tc.timeLeft <= 10 ? ' timer-warning' : '');\n  }\n\n  const score = document.getElementById('timed-score');\n  if (score) score.textContent = tc.score;\n\n  const combo = document.getElementById('timed-combo');\n  if (combo) {\n    if (game.combo.combo >= 3) {\n      combo.textContent = `🔥 ${game.combo.combo}连击！`;\n      combo.style.display = 'block';\n    } else {\n      combo.style.display = 'none';\n    }\n  }\n\n  const mt = document.getElementById('timed-meaning');\n  if (mt) mt.textContent = q.idiom.meaning;\n\n  const sc = document.getElementById('timed-slots');\n  if (sc) {\n    sc.innerHTML = '';\n    const slots = tc.judge.getSlots();\n    for (let i = 0; i < 4; i++) {\n      const slot = document.createElement('div');\n      slot.className = 'slot';\n      if (slots[i]) { slot.classList.add('filled'); slot.textContent = slots[i].char; slot.onclick = () => tc.removeSlot(i); }\n      if (q.answered && q.correct === true) slot.classList.add('correct');\n      if (q.answered && q.correct === false) slot.classList.add('wrong');\n      sc.appendChild(slot);\n    }\n  }\n\n  const cc = document.getElementById('timed-candidates');\n  if (cc) {\n    cc.innerHTML = '';\n    q.candidates.forEach((c, i) => {\n      const btn = document.createElement('button');\n      btn.className = 'candidate';\n      btn.textContent = c.char;\n      if (c.used) btn.classList.add('used');\n      if (c.removed) btn.classList.add('removed');\n      if (!c.used && !c.removed && !q.answered) btn.onclick = () => tc.pickChar(i);\n      cc.appendChild(btn);\n    });\n  }\n}\n\nfunction renderTimedResult(game) {\n  showScreen('timed-result-screen');\n  const r = game.timed.getResult();\n  document.getElementById('tr-score').textContent = r.score;\n  document.getElementById('tr-correct').textContent = r.correctCount;\n  document.getElementById('tr-total').textContent = r.answeredCount;\n  document.getElementById('tr-combo').textContent = r.maxCombo;\n  document.getElementById('tr-coins').textContent = Math.floor(r.score / 10);\n}\n\n// ===== W2: Collection =====\nfunction renderCollection(game) {\n  showScreen('collection-screen');\n  const col = game.collection;\n  const progress = col.getProgress();\n\n  document.getElementById('col-progress').textContent = `${progress.collected}/${progress.total} (${progress.percent}%)`;\n\n  const bar = document.getElementById('col-progress-bar');\n  if (bar) bar.style.width = progress.percent + '%';\n\n  // Categories\n  const catContainer = document.getElementById('col-categories');\n  if (catContainer) {\n    const cats = ['全部', ...col.getCategories()];\n    catContainer.innerHTML = cats.map(c =>\n      `<button class=\"cat-btn${col.selectedCategory === (c === '全部' ? null : c) ? ' active' : ''}\" onclick=\"handleCategoryFilter('${c}')\">${c}</button>`\n    ).join('');\n  }\n\n  // Search\n  const searchInput = document.getElementById('col-search');\n  if (searchInput && searchInput.value !== col.searchQuery) {\n    searchInput.value = col.searchQuery;\n  }\n\n  // Idiom grid\n  const grid = document.getElementById('col-grid');\n  if (grid) {\n    const idioms = col.getFilteredIdioms();\n    grid.innerHTML = idioms.slice(0, 60).map(i =>\n      `<div class=\"idiom-card${i.collected ? ' collected' : ''}\" onclick=\"handleIdiomSelect('${i.id}')\">\n        <span class=\"idiom-text\">${i.collected ? i.idiom : '？？？？'}</span>\n        <span class=\"idiom-cat\">${(i.category || [])[0] || ''}</span>\n      </div>`\n    ).join('');\n    if (idioms.length > 60) {\n      grid.innerHTML += `<div class=\"more-hint\">还有${idioms.length - 60}个...</div>`;\n    }\n  }\n\n  // Detail view\n  const detail = document.getElementById('col-detail');\n  if (detail) {\n    if (col.selectedIdiom) {\n      const i = col.selectedIdiom;\n      const collected = game.data.collectedIdioms.includes(i.id);\n      detail.style.display = 'block';\n      detail.innerHTML = `\n        <div class=\"detail-header\">\n          <h3>${collected ? i.idiom : '？？？？'}</h3>\n          <button class=\"btn-back\" onclick=\"game.collection.selectIdiom(null)\">✕</button>\n        </div>\n        ${collected ? `\n          <p class=\"detail-pinyin\">${i.pinyin || ''}</p>\n          <p class=\"detail-meaning\">${i.meaning}</p>\n          ${i.origin ? `<p class=\"detail-origin\">出处：${i.origin}</p>` : ''}\n          ${i.example ? `<p class=\"detail-example\">例句：${i.example}</p>` : ''}\n        ` : '<p class=\"detail-locked\">收集此成语后可查看详情</p>'}\n      `;\n    } else {\n      detail.style.display = 'none';\n    }\n  }\n}\n\n// ===== W2: Daily =====\nfunction renderDaily(game) {\n  showScreen('daily-screen');\n  const ds = game.daily.getDailyState();\n\n  document.getElementById('daily-streak').textContent = ds.loginStreak;\n  document.getElementById('daily-claimed').textContent = ds.todayClaimed ? '已领取' : '未领取';\n  document.getElementById('daily-claim-btn').disabled = ds.todayClaimed;\n  document.getElementById('daily-claim-btn').textContent = ds.todayClaimed ? '已领取 ✓' : `领取签到奖励 (×${Math.min(ds.loginStreak, 7)}0🪙)`;\n\n  // W3: Daily double ad button\n  const dailyDoubleBtn = document.getElementById('daily-double-btn');\n  if (dailyDoubleBtn) {\n    dailyDoubleBtn.style.display = (ds.todayClaimed && !ds.doubled &&\n      game.adManager && game.adManager.canShowRewarded(AD_PLACEMENTS.DAILY_DOUBLE)) ? 'inline-block' : 'none';\n  }\n\n  // Tasks\n  const tasksEl = document.getElementById('daily-tasks');\n  if (tasksEl) {\n    tasksEl.innerHTML = ds.tasks.map(t => `\n      <div class=\"task-item${t.claimed ? ' done' : ''}\">\n        <span class=\"task-desc\">${t.desc}</span>\n        <span class=\"task-progress\">${t.progress}/${t.target}</span>\n        <button class=\"task-btn${t.claimed ? ' claimed' : ''}\"\n          ${t.claimed || t.progress < t.target ? 'disabled' : ''}\n          onclick=\"handleClaimTask('${t.id}')\">\n          ${t.claimed ? '已领' : `${t.reward}🪙`}\n        </button>\n      </div>\n    `).join('');\n  }\n\n  // Challenge\n  const challengeEl = document.getElementById('daily-challenge');\n  if (challengeEl) {\n    if (ds.challengeIdiom) {\n      challengeEl.innerHTML = `\n        <div class=\"challenge-card${ds.challengeCompleted ? ' done' : ''}\">\n          <h4>今日成语挑战</h4>\n          <p class=\"challenge-meaning\">${ds.challengeIdiom.meaning}</p>\n          <p class=\"challenge-hint\">${ds.challengeCompleted ? `答案：${ds.challengeIdiom.idiom}` : '提示：' + ds.challengeIdiom.chars[0] + '？？？'}</p>\n          ${ds.challengeCompleted ?\n            '<span class=\"challenge-done\">已完成 ✓ +50🪙</span>' :\n            `<button class=\"btn btn-primary btn-sm\" onclick=\"handleDailyChallenge()\">挑战</button>`\n          }\n        </div>\n      `;\n    }\n  }\n}\n\n// ===== W2: PK =====\nfunction renderPK(game) {\n  showScreen('pk-screen');\n  const pk = game.pk;\n  const q = pk.currentQ;\n  if (!q) return;\n\n  document.getElementById('pk-progress').textContent = `${pk.currentIndex + 1}/5`;\n\n  const mt = document.getElementById('pk-meaning');\n  if (mt) mt.textContent = q.idiom.meaning;\n\n  const sc = document.getElementById('pk-slots');\n  if (sc) {\n    sc.innerHTML = '';\n    const slots = pk.judge.getSlots();\n    for (let i = 0; i < 4; i++) {\n      const slot = document.createElement('div');\n      slot.className = 'slot';\n      if (slots[i]) { slot.classList.add('filled'); slot.textContent = slots[i].char; slot.onclick = () => pk.removeSlot(i); }\n      if (q.answered && q.correct === true) slot.classList.add('correct');\n      if (q.answered && q.correct === false) slot.classList.add('wrong');\n      sc.appendChild(slot);\n    }\n  }\n\n  const cc = document.getElementById('pk-candidates');\n  if (cc) {\n    cc.innerHTML = '';\n    q.candidates.forEach((c, i) => {\n      const btn = document.createElement('button');\n      btn.className = 'candidate';\n      btn.textContent = c.char;\n      if (c.used) btn.classList.add('used');\n      if (c.removed) btn.classList.add('removed');\n      if (!c.used && !c.removed && !q.answered) btn.onclick = () => pk.pickChar(i);\n      cc.appendChild(btn);\n    });\n  }\n}\n\nfunction renderPKResult(game) {\n  showScreen('pk-result-screen');\n  const r = game.pk.getResult();\n  document.getElementById('pkr-result').textContent = r.won ? '🎉 胜利！' : '😢 惜败';\n  document.getElementById('pkr-correct').textContent = `${r.correctCount}/5`;\n  document.getElementById('pkr-time').textContent = `${(r.time / 1000).toFixed(1)}s`;\n  document.getElementById('pkr-reward').textContent = r.won ? '+50🪙' : '';\n\n  // Answers review\n  const answersEl = document.getElementById('pkr-answers');\n  if (answersEl) {\n    answersEl.innerHTML = r.answers.map((a, i) =>\n      `<div class=\"answer-item${a.correct ? ' correct' : ' wrong'}\">${i+1}. ${a.idiom} ${a.correct ? '✓' : '✗'}</div>`\n    ).join('');\n  }\n}\n\n// ===== W2: Characters =====\nfunction renderCharacters(game) {\n  showScreen('characters-screen');\n  const chars = game.characters.getAll();\n\n  const grid = document.getElementById('char-grid');\n  if (grid) {\n    grid.innerHTML = chars.map(c => {\n      const selected = game.data.data.characters.current === c.id;\n      return `\n        <div class=\"char-card${selected ? ' selected' : ''}${!c.unlocked ? ' locked' : ''}\"\n             onclick=\"${c.unlocked ? `game.characters.select('${c.id}'); game.render()` : ''}\">\n          <div class=\"char-avatar\">${c.unlocked ? c.avatar : '🔒'}</div>\n          <div class=\"char-name\">${c.name}</div>\n          <div class=\"char-skill\">${c.unlocked ? c.skill.name : `通关第${c.unlock.level || '?'}关解锁`}</div>\n          ${selected ? '<div class=\"char-badge\">使用中</div>' : ''}\n        </div>\n      `;\n    }).join('');\n  }\n\n  // Skill detail\n  const current = game.characters.getCurrent();\n  const detail = document.getElementById('char-detail');\n  if (detail) {\n    detail.innerHTML = `\n      <h4>${current.avatar} ${current.name}</h4>\n      <p class=\"skill-name\">${current.skill.name}</p>\n      <p class=\"skill-desc\">${current.skill.desc}</p>\n    `;\n  }\n}\n\n// ===== Global handlers =====\nfunction handleCategoryFilter(cat) {\n  if (cat === '全部') { game.collection.clearFilter(); }\n  else { game.collection.filterByCategory(cat); }\n  game.render();\n}\n\nfunction handleIdiomSelect(id) { game.collection.selectIdiom(id); game.render(); }\n\nfunction handleClaimTask(taskId) { game.daily.claimTask(taskId); game.render(); }\n\nfunction handleDailyChallenge() {\n  const ds = game.daily.getDailyState();\n  if (ds.challengeIdiom && !ds.challengeCompleted) {\n    game.daily.completeChallenge();\n    game.render();\n  }\n}\n\nfunction handleColSearch(val) { game.collection.search(val); game.render(); }\n","numLines":510,"startLine":1,"totalLines":510}}}
