n82\t        <div class=\"tutorial-arrow\"></div>\n83\t        <div id=\"tutorial-text\" class=\"tutorial-text\"></div>\n84\t      </div>\n85\t    </div>\n86\t\n87\t    <!-- 结算界面 -->\n88\t    <div id=\"result-screen\" class=\"screen\">\n89\t      <div class=\"result-card\">\n90\t        <h2 id=\"result-title\" class=\"result-title\">通关!</h2>\n91\t        <div id=\"result-stars\" class=\"result-stars\"></div>\n92\t        <div class=\"result-stats\">\n93\t          <p>正确: <span id=\"result-correct\">0</span> / <span id=\"result-total\">10</span></p>\n94\t          <p>得分: <span id=\"result-score\">0</span></p>\n95\t          <p>最大连击: <span id=\"result-combo\">0</span></p>\n96\t          <p class=\"coins-earned\">🪙 +<span id=\"result-coins\">0</span></p>\n97\t        </div>\n98\t        <div class=\"result-buttons\">\n99\t          <button class=\"btn btn-primary\" onclick=\"game.goToMenu()\">返回地图</button>\n100\t          <button class=\"btn btn-secondary\" id=\"btn-retry\" onclick=\"game.startLevel(game.currentLevel.id)\">重新挑战</button>\n101\t          <button class=\"btn btn-accent\" id=\"btn-next\" onclick=\"game.startLevel(game.currentLevel.id + 1)\">下一关</button>\n102\t          <button class=\"btn btn-ad\" id=\"btn-double\" style=\"display:none\" onclick=\"handleDoubleReward()\">🎬 看视频领取 ×2</button>\n103\t        </div>\n104\t      </div>\n105\t    </div>\n106\t\n107\t    <!-- 续命弹窗 -->\n108\t    <div id=\"continue-modal\" class=\"modal\" style=\"display:none\">\n109\t      <div class=\"modal-content\">\n110\t        <h3>挑战失败</h3>\n111\t        <p>生命值耗尽了！</p>\n112\t        <div class=\"modal-buttons\">\n113\t          <button class=\"btn btn-secondary\" onclick=\"game.finishLevel(); document.getElementById('continue-modal').style.display='none'\">放弃</button>\n114\t          <button class=\"btn btn-ad\" onclick=\"game.continueWithAd()\">🎬 看视频续命 ❤️×3</button>\n115\t        </div>\n116\t      </div>\n117\t    </div>\n118\t\n119\t    <!-- ===== W2: 限时挑战 ===== -->\n120\t 