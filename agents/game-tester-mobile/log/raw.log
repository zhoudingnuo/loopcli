Count++;\n    this.data.addCoins(10);\n    return Promise.resolve({ success: true, stub: true });\n  }\n\n  shareCollection(collection) {\n    const shareData = {\n      title: `我已收集${collection.collected}个成语！成语图鉴${collection.percent}%完成`,\n      desc: '成语大闯关图鉴，快来收集！',\n      path: '/pages/home/index',\n      imageUrl: ''\n    };\n\n    if (this.isDouyin) {\n      return this._douyinShare(shareData);\n    }\n    this.shareCount++;\n    return Promise.resolve({ success: true, stub: true });\n  }\n\n  _douyinShare(shareData) {\n    return new Promise((resolve, reject) => {\n      tt.shareAppMessage({\n        ...shareData,\n        success: () => {\n          this.shareCount++;\n          this.data.addCoins(10);\n          resolve({ success: true });\n        },\n        fail: (err) => reject(err)\n      });\n    });\n  }\n\n  getLeaderboard(type = 'score') {\n    if (this.isDoujin && tt.getFriendCloudStorage) {\n      return this._douyinLeaderboard(type);\n    }\n    return Promise.resolve(this._localLeaderboard(type));\n  }\n\n  _douyinLeaderboard(type) {\n    return new Promise((resolve) => {\n      tt.getFriendCloudStorage({\n        keyList: [`idiom_${type}`],\n        success: (res) => resolve(res.data || []),\n        fail: () => resolve([])\n      });\n    });\n  }\n\n  _localLeaderboard(type) {\n    const data = this.data.data;\n    return [{\n      rank: 1,\n      name: '我',\n      value: type === 'score' ? data.totalScore :\n             type === 'pk' ? (data.pkWins || 0) :\n             data.collectedIdioms.length\n    }];\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { SocialManager };\n","structuredPatch":[{"oldStart":85,"oldLines":7,"newStart":85,"newLines":7,"lines":["   }"," ","   getLeaderboard(type = 'score') {","-    if (this.isDoujin && tt.getFriendCloudStorage) {","+    if (this.isDouyin && tt.getFriendCloudStorage) {","       return this._douyinLeaderboard(type);","     }","     return Promise.resolve(this._localLeaderboard(type));"]}],"userModified":false,"replaceAll":false}}
