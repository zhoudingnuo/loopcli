===== -->\n160\t    <div id=\"collection-screen\" class=\"screen\">\n161\t      <div class=\"map-header\">\n162\t        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n163\t        <h2>成语图鉴</h2>\n164\t        <span id=\"col-progress\">0/0</span>\n165\t      </div>\n166\t      <div class=\"col-bar-wrap\">\n167\t        <div class=\"col-bar\"><div id=\"col-progress-bar\" class=\"col-bar-fill\"></div></div>\n168\t      </div>\n169\t      <input type=\"text\" id=\"col-search\" class=\"col-search\" placeholder=\"搜索成语/释义...\" oninput=\"handleColSearch(this.value)\">\n170\t      <div id=\"col-categories\" class=\"col-categories\"></div>\n171\t      <div id=\"col-grid\" class=\"col-grid\"></div>\n172\t      <div id=\"col-detail\" class=\"col-detail\" style=\"display:none\"></div>\n173\t    </div>\n174\t\n175\t    <!-- ===== W2: 每日系统 ===== -->\n176\t    <div id=\"daily-screen\" class=\"screen\">\n177\t      <div class=\"map-header\">\n178\t        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n179\t        <h2>📅 每日</h2>\n180\t      </div>\n181\t      <div class=\"daily-content\">\n182\t        <div class=\"daily-login\">\n183\t          <h3>每日签到</h3>\n184\t          <p>连续签到: <span id=\"daily-streak\" class=\"streak-num\">1</span> 天</p>\n185\t          <p>状态: <span id=\"daily-claimed\">未领取</span></p>\n186\t          <button id=\"daily-claim-btn\" class=\"btn btn-accent\" onclick=\"game.daily.claimLogin(); game.render()\">领取签到奖励</button>\n187\t          <button id=\"daily-double-btn\" class=\"btn btn-ad\" style=\"display:none\" onclick=\"handleDailyDouble()\">🎬 看视频翻倍</button>\n188\t        </div>\n189\t\n190\t        <div class=\"daily-section\">\n191\t          <h3>每日任务</h3>\n192\t          <div id=\"daily-tasks\" class=\"task-list\"></div>\n193\t        </div>\n194\t\n195\t        <div class=\"daily-section\">\n196\t          <h3>今日挑战</h3>\n197\t          <div id=\"daily-challenge\"></div>\n198\t        </div>\n199\t      </div>\n200\t    </div>\n201\t\n202\t    <!-- ===== W2: 好友PK ===== -->\n203\t    <div id=\"pk-screen\" class=\"screen\">\n204\t      <div class=\"game-header\">\n205\t        <button class=\"btn-back\" onclick=\"game.goToMenu()\">✕</button>\n206\t        <div class=\"header-center\">\n207\t          <span>好友PK</span>\n208\t          <span id=\"pk-progress\">1/5</span>\n209\t        </div>\n210\t        <div class=\"header-right\"></div>\n211\t      </div>\n212\t      <div class=\"game-body\">\n213\t        <div class=\"meaning-box\"><span id=\"pk-meaning\"></span></div>\n214\t        <div id=\"pk-slots\" class=\"slots-container\"></div>\n215\t        <div id=\"pk-candidates\" class=\"candidates-container\"></div>\n216\t      </div>\n217\t    </div>\n218\t\n219\t    <!-- W2: PK结果 -->\n220\t    <div id=\"pk-result-screen\" class=\"screen\">\n221\t      <div class=\"result-card\">\n222\t        <h2 id=\"pkr-result\" class=\"result-title\">结果</h2>\n223\t        <div class=\"result-stats\">\n224\t          <p>正确: <span id=\"pkr-correct\">0/5</span></p>\n225\t          <p>用时: <span id=\"pkr-time\">0s</span></p>\n226\t          <p class=\"coins-earned\"><span id=\"pkr-reward\"></span></p>\n227\t        </div>\n228\t        <div id=\"pkr-answers\" class=\"pk-answers\"></div>\n229\t        <div class=\"result-buttons\">\n230\t          <button class=\"btn btn-primary\" onclick=\"game.goToMenu()\">返回</button>\n231\t          <button class=\"btn btn-secondary\" onclick=\"game.social.sharePKResult(game.pk.getResult())\">分享结果</button>\n232\t          <button class=\"btn btn-accent\" onclick=\"game.startPK()\">再来一局</button>\n233\t        </div>\n234\t      </div>\n235\t    </div>\n236\t\n237\t    <!-- ===== W2: 角色 ===== -->\n238\t    <div id=\"characters-screen\" class=\"screen\">\n239\t      <div class=\"map-header\">\n240\t        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n241\t        <h2>👤 角色选择</h2>\n242\t      </div>\n243\t      <div id=\"char-grid\" class=\"char-grid\"></div>\n244\t      <div id=\"char-detail\" class=\"char-detail\"></div>\n245\t    </div>\n246\t  </div>\n247\t\n248\t  <script src=\"src/js/IdiomDBExtra.js\"></script>\n249\t  <script src=\"src/js/IdiomDB.js\"></script>\n250\t  <script src=\"src/js/levels.js\"></script>\n251\t  <script src=\"src/js/IdiomEngine.js\"></script>\n252\t  <script src=\"src/js/Judge.js\"></script>\n253\t  <script src=\"src/js/ComboSystem.js\"></script>\n254\t  <script src=\"src/js/DataManager.js\"></script>\n255\t  <script src=\"src/js/AudioManager.js\"></script>\n256\t  <script src=\"src/js/Tutorial.js\"></script>\n257\t  <!-- W2 modules -->\n258\t  <script src=\"src/js/TimedChallenge.js\"></script>\n259\t  <script src=\"src/js/IdiomCollection.js\"></script>\n260\t  <script src=\"src/js/DailySystem.js\"></script>\n261\t  <script src=\"src/js/PKMode.js\"></script>\n262\t  <script src=\"src/js/SocialManager.js\"></script>\n263\t  <script src=\"src/js/Characters.js\"></script>\n264\t  <!-- W3 modules -->\n265\t  <script src=\"src/js/ad-config.js\"></script>\n266\t  <script src=\"src/js/AdManager.js\"></script>\n267\t  <script src=\"src/js/Analytics.js\"></script>\n268\t  <script src=\"src/js/Game.js\"></script>\n269\t  <script src=\"src/js/Renderer.js\"></script>\n270\t  <script>\n271\t    const game = new Game();\n272\t    game.audio.init();\n273\t    renderUI(game);\n274\t  </script>\n275\t</body>\n276\t</html>\n277\t"}]},"parent_tool_use_id":null,"session_id":"33562fd9-d4f0-45be-a2a4-d9d379182d9f","uuid":"27eca122-8278-4036-a8a3-64e583b9b5a9","timestamp":"2026-05-23T10:18:19.080Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/index.html","content":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n  <title>成语大闯关 - Idiom Master</title>\n  <link rel=\"stylesheet\" href=\"src/css/style.css\">\n</head>\n<body>\n  <div id=\"app\">\n    <!-- 主菜单 -->\n    <div id=\"menu-screen\" class=\"screen active\">\n      <div class=\"menu-bg\">\n        <div class=\"title-block\">\n          <h1 class=\"title\">成语大闯关</h1>\n          <p class=\"subtitle\">Idiom Master</p>\n        </div>\n        <div class=\"menu-stats\">\n          <span class=\"stat-item\" id=\"menu-avatar\">👦</span>\n          <span class=\"stat-item\">🪙 <span id=\"menu-coins\">0</span></span>\n          <span class=\"stat-item\">📖 <span id=\"menu-collected\">0</span>成语</span>\n        </div>\n        <div class=\"menu-buttons\">\n          <button class=\"btn btn-primary\" onclick=\"game.showLevelMap()\">闯关模式</button>\n          <button class=\"btn btn-secondary\" onclick=\"game.startTimedChallenge()\">限时挑战</button>\n          <button class=\"btn btn-accent\" onclick=\"game.startPK()\">好友PK</button>\n        </div>\n        <div class=\"menu-row\">\n          <button class=\"btn btn-outline\" onclick=\"game.showCollection()\">📖 成语图鉴</button>\n          <button class=\"btn btn-outline\" onclick=\"game.showDaily()\">📅 每日</button>\n          <button class=\"btn btn-outline\" onclick=\"game.showCharacters()\">👤 角色</button>\n        </div>\n        <div class=\"menu-footer\">\n          <button class=\"btn-icon\" onclick=\"game.audio.toggle(); this.textContent = game.audio.enabled ? '🔊' : '🔇'\">🔊</button>\n          <button class=\"btn-icon\" onclick=\"game.data.reset(); location.reload()\">🔄</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- 关卡地图 -->\n    <div id=\"map-screen\" class=\"screen\">\n      <div class=\"map-header\">\n        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n        <h2>选择关卡</h2>\n        <span>🪙 <span id=\"map-coins\">0</span></span>\n      </div>\n      <div id=\"chapter-info\" class=\"chapter-info\"></div>\n      <div id=\"level-grid\" class=\"level-grid\"></div>\n    </div>\n\n    <!-- 游戏界面 -->\n    <div id=\"game-screen\" class=\"screen\">\n      <div class=\"game-header\">\n        <button class=\"btn-back\" onclick=\"if(confirm('确定退出？')) game.goToMenu()\">✕</button>\n        <div class=\"header-center\">\n          <span id=\"level-label\">第1关</span>\n          <span id=\"progress-label\">1/10</span>\n        </div>\n        <div class=\"header-right\">\n          <span id=\"lives-display\">❤️❤️❤️❤️❤️</span>\n        </div>\n      </div>\n\n      <div class=\"game-body\">\n        <div id=\"combo-display\" class=\"combo-display\"></div>\n        <div id=\"meaning-box\" class=\"meaning-box\">\n          <span id=\"meaning-text\"></span>\n        </div>\n        <div id=\"slots-container\" class=\"slots-container\"></div>\n        <div id=\"idiom-hint\" class=\"idiom-hint\"></div>\n        <div id=\"candidates-container\" class=\"candidates-container\"></div>\n      </div>\n\n      <div class=\"game-footer\">\n        <button class=\"tool-btn\" onclick=\"handleHintReveal()\">📖 揭示 (5🪙)</button>\n        <button class=\"tool-btn\" onclick=\"handleHintRemove()\">✂️ 去干扰 (5🪙)</button>\n        <button class=\"tool-btn\" onclick=\"handleSkip()\">⏭ 跳过 (10🪙)</button>\n      </div>\n\n      <!-- 教学覆盖层 -->\n      <div id=\"tutorial-overlay\" class=\"tutorial-overlay\" style=\"display:none\">\n        <div class=\"tutorial-arrow\"></div>\n        <div id=\"tutorial-text\" class=\"tutorial-text\"></div>\n      </div>\n    </div>\n\n    <!-- 结算界面 -->\n    <div id=\"result-screen\" class=\"screen\">\n      <div class=\"result-card\">\n        <h2 id=\"result-title\" class=\"result-title\">通关!</h2>\n        <div id=\"result-stars\" class=\"result-stars\"></div>\n        <div class=\"result-stats\">\n          <p>正确: <span id=\"result-correct\">0</span> / <span id=\"result-total\">10</span></p>\n          <p>得分: <span id=\"result-score\">0</span></p>\n          <p>最大连击: <span id=\"result-combo\">0</span></p>\n          <p class=\"coins-earned\">🪙 +<span id=\"result-coins\">0</span></p>\n        </div>\n        <div class=\"result-buttons\">\n          <button class=\"btn btn-primary\" onclick=\"game.goToMenu()\">返回地图</button>\n          <button class=\"btn btn-secondary\" id=\"btn-retry\" onclick=\"game.startLevel(game.currentLevel.id)\">重新挑战</button>\n          <button class=\"btn btn-accent\" id=\"btn-next\" onclick=\"game.startLevel(game.currentLevel.id + 1)\">下一关</button>\n          <button class=\"btn btn-ad\" id=\"btn-double\" style=\"display:none\" onclick=\"handleDoubleReward()\">🎬 看视频领取 ×2</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- 续命弹窗 -->\n    <div id=\"continue-modal\" class=\"modal\" style=\"display:none\">\n      <div class=\"modal-content\">\n        <h3>挑战失败</h3>\n        <p>生命值耗尽了！</p>\n        <div class=\"modal-buttons\">\n          <button class=\"btn btn-secondary\" onclick=\"game.finishLevel(); document.getElementById('continue-modal').style.display='none'\">放弃</button>\n          <button class=\"btn btn-ad\" onclick=\"game.continueWithAd()\">🎬 看视频续命 ❤️×3</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- ===== W2: 限时挑战 ===== -->\n    <div id=\"timed-screen\" class=\"screen\">\n      <div class=\"game-header\">\n        <button class=\"btn-back\" onclick=\"if(confirm('确定退出？')){game.timed.end();game.goToMenu()}\">✕</button>\n        <div class=\"header-center\">\n          <span id=\"timed-timer\" class=\"timer-display\">60s</span>\n        </div>\n        <div class=\"header-right\">\n          <span>得分: <span id=\"timed-score\">0</span></span>\n        </div>\n      </div>\n      <div class=\"game-body\">\n        <div id=\"timed-combo\" class=\"combo-display\"></div>\n        <div class=\"meaning-box\"><span id=\"timed-meaning\"></span></div>\n        <div id=\"timed-slots\" class=\"slots-container\"></div>\n        <div id=\"timed-candidates\" class=\"candidates-container\"></div>\n      </div>\n      <div class=\"game-footer\">\n        <button class=\"tool-btn\" onclick=\"game.timed.useHintReveal()\">📖 揭示</button>\n        <button class=\"tool-btn\" onclick=\"game.timed.useHintRemove()\">✂️ 去干扰</button>\n      </div>\n    </div>\n\n    <!-- W2: 限时挑战结算 -->\n    <div id=\"timed-result-screen\" class=\"screen\">\n      <div class=\"result-card\">\n        <h2 class=\"result-title\">⏱ 限时挑战结束</h2>\n        <div class=\"result-stats\">\n          <p>得分: <span id=\"tr-score\">0</span></p>\n          <p>正确: <span id=\"tr-correct\">0</span> / <span id=\"tr-total\">0</span></p>\n          <p>最大连击: <span id=\"tr-combo\">0</span></p>\n          <p class=\"coins-earned\">🪙 +<span id=\"tr-coins\">0</span></p>\n        </div>\n        <div class=\"result-buttons\">\n          <button class=\"btn btn-primary\" onclick=\"game.goToMenu()\">返回</button>\n          <button class=\"btn btn-accent\" onclick=\"game.startTimedChallenge()\">再来一次</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- ===== W2: 成语图鉴 ===== -->\n    <div id=\"collection-screen\" class=\"screen\">\n      <div class=\"map-header\">\n        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n        <h2>成语图鉴</h2>\n        <span id=\"col-progress\">0/0</span>\n      </div>\n      <div class=\"col-bar-wrap\">\n        <div class=\"col-bar\"><div id=\"col-progress-bar\" class=\"col-bar-fill\"></div></div>\n      </div>\n      <input type=\"text\" id=\"col-search\" class=\"col-search\" placeholder=\"搜索成语/释义...\" oninput=\"handleColSearch(this.value)\">\n      <div id=\"col-categories\" class=\"col-categories\"></div>\n      <div id=\"col-grid\" class=\"col-grid\"></div>\n      <div id=\"col-detail\" class=\"col-detail\" style=\"display:none\"></div>\n    </div>\n\n    <!-- ===== W2: 每日系统 ===== -->\n    <div id=\"daily-screen\" class=\"screen\">\n      <div class=\"map-header\">\n        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n        <h2>📅 每日</h2>\n      </div>\n      <div class=\"daily-content\">\n        <div class=\"daily-login\">\n          <h3>每日签到</h3>\n          <p>连续签到: <span id=\"daily-streak\" class=\"streak-num\">1</span> 天</p>\n          <p>状态: <span id=\"daily-claimed\">未领取</span></p>\n          <button id=\"daily-claim-btn\" class=\"btn btn-accent\" onclick=\"game.daily.claimLogin(); game.render()\">领取签到奖励</button>\n          <button id=\"daily-double-btn\" class=\"btn btn-ad\" style=\"display:none\" onclick=\"handleDailyDouble()\">🎬 看视频翻倍</button>\n        </div>\n\n        <div class=\"daily-section\">\n          <h3>每日任务</h3>\n          <div id=\"daily-tasks\" class=\"task-list\"></div>\n        </div>\n\n        <div class=\"daily-section\">\n          <h3>今日挑战</h3>\n          <div id=\"daily-challenge\"></div>\n        </div>\n      </div>\n    </div>\n\n    <!-- ===== W2: 好友PK ===== -->\n    <div id=\"pk-screen\" class=\"screen\">\n      <div class=\"game-header\">\n        <button class=\"btn-back\" onclick=\"game.goToMenu()\">✕</button>\n        <div class=\"header-center\">\n          <span>好友PK</span>\n          <span id=\"pk-progress\">1/5</span>\n        </div>\n        <div class=\"header-right\"></div>\n      </div>\n      <div class=\"game-body\">\n        <div class=\"meaning-box\"><span id=\"pk-meaning\"></span></div>\n        <div id=\"pk-slots\" class=\"slots-container\"></div>\n        <div id=\"pk-candidates\" class=\"candidates-container\"></div>\n      </div>\n    </div>\n\n    <!-- W2: PK结果 -->\n    <div id=\"pk-result-screen\" class=\"screen\">\n      <div class=\"result-card\">\n        <h2 id=\"pkr-result\" class=\"result-title\">结果</h2>\n        <div class=\"result-stats\">\n          <p>正确: <span id=\"pkr-correct\">0/5</span></p>\n          <p>用时: <span id=\"pkr-time\">0s</span></p>\n          <p class=\"coins-earned\"><span id=\"pkr-reward\"></span></p>\n        </div>\n        <div id=\"pkr-answers\" class=\"pk-answers\"></div>\n        <div class=\"result-buttons\">\n          <button class=\"btn btn-primary\" onclick=\"game.goToMenu()\">返回</button>\n          <button class=\"btn btn-secondary\" onclick=\"game.social.sharePKResult(game.pk.getResult())\">分享结果</button>\n          <button class=\"btn btn-accent\" onclick=\"game.startPK()\">再来一局</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- ===== W2: 角色 ===== -->\n    <div id=\"characters-screen\" class=\"screen\">\n      <div class=\"map-header\">\n        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n        <h2>👤 角色选择</h2>\n      </div>\n      <div id=\"char-grid\" class=\"char-grid\"></div>\n      <div id=\"char-detail\" class=\"char-detail\"></div>\n    </div>\n  </div>\n\n  <script src=\"src/js/IdiomDBExtra.js\"></script>\n  <script src=\"src/js/IdiomDB.js\"></script>\n  <script src=\"src/js/levels.js\"></script>\n  <script src=\"src/js/IdiomEngine.js\"></script>\n  <script src=\"src/js/Judge.js\"></script>\n  <script src=\"src/js/ComboSystem.js\"></script>\n  <script src=\"src/js/DataManager.js\"></script>\n  <script src=\"src/js/AudioManager.js\"></script>\n  <script src=\"src/js/Tutorial.js\"></script>\n  <!-- W2 modules -->\n  <script src=\"src/js/TimedChallenge.js\"></script>\n  <script src=\"src/js/IdiomCollection.js\"></script>\n  <script src=\"src/js/DailySystem.js\"></script>\n  <script src=\"src/js/PKMode.js\"></script>\n  <script src=\"src/js/SocialManager.js\"></script>\n  <script src=\"src/js/Characters.js\"></script>\n  <!-- W3 modules -->\n  <script src=\"src/js/ad-config.js\"></script>\n  <script src=\"src/js/AdManager.js\"></script>\n  <script src=\"src/js/Analytics.js\"></script>\n  <script src=\"src/js/Game.js\"></script>\n  <script src=\"src/js/Renderer.js\"></script>\n  <script>\n    const game = new Game();\n    game.audio.init();\n    renderUI(game);\n  </script>\n</body>\n</html>\n","numLines":277,"startLine":1,"totalLines":277}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f1954853dcb04c14928df70b","type":"tool_result","content":"1\t// Game.js — Main game controller (W2 extended)\n2\t\n3\tclass Game {\n4\t  constructor() {\n5\t    this.engine = new IdiomEngine(IDIOM_DB);\n6\t    this.judge = new Judge();\n7\t    this.combo = new ComboSystem();\n8\t    this.data = new DataManager();\n9\t    this.audio = new AudioManager();\n10\t    this.tutorial = new Tutorial();\n11\t\n12\t    // W2 systems\n13\t    this.timed = new TimedChallenge(this.engine, this.combo, this.audio, this.data);\n14\t    this.collection = new IdiomCollection(IDIOM_DB, this.data);\n15\t    this.daily = new DailySystem(this.data, this.engine, this.audio);\n16\t    this.pk = new PKMode(this.engine, this.audio, this.data);\n17\t    this.social = new SocialManager(this.data);\n18\t    this.characters = new Characters(this.data);\n19\t\n20\t    // W3 systems\n21\t    this.adManager = new AdManager(this.data);\n22\t    this.analytics = new Analytics(this.data);\n23\t\n24\t    this.currentLevel = null;\n25\t    this.questions = [];\n26\t    this.questionIndex = 0;\n27\t    this.lives = 5;\n28\t    this.state = 'menu';\n29\t    this.usedHintThisQuestion = false;\n30\t    this.continuedOnce = false;\n31\t    this.levelResult = null;\n32\t    this.hintRevealCost = 5;\n33\t    this.hintRemoveCost = 5;\n34\t    this.skipCost = 10;\n35\t    this._doubledReward = false;\n36\t\n37\t    this.analytics.trackGameStart();\n38\t    this.analytics.startFlushTimer();\n39\t  }\n40\t\n41\t  startLevel(levelId) {\n42\t    const level = LEVELS.find(l => l.id === levelId);\n43\t    if (!level) { this.goToMenu(); return; }\n44\t    if (levelId > this.data.unlockedLevel && levelId > 1) {\n45\t      alert('关卡尚未解锁'); return;\n46\t    }\n47\t\n48\t    this.currentLevel = level;\n49\t    this.lives = level.lives;\n50\t    this.engine.reset();\n51\t    this.questions = this.engine.generateForLevel(level);\n52\t    this.questionIndex = 0;\n53\t    this.combo.reset();\n54\t    this.continuedOnce = false;\n55\t    this._doubledReward = false;\n56\t    this.state = 'playing';\n57\t    this.characters.resetLevelState();\n58\t\n59\t    this.analytics.trackLevelStart(levelId, level);\n60\t\n61\t    if (level.tutorial) this.tutorial.start(level.tutorial);\n62\t    else this.tutorial.end();\n63\t\n64\t    this._startQuestion();\n65\t    this.render();\n66\t  }\n67\t\n68\t  _startQuestion() {\n69\t    if (this.questionIndex >= this.questions.length) { this.finishLevel(); return; }\n70\t    const q = this.questions[this.questionIndex];\n71\t    this.judge.startQuestion(q);\n72\t    this.usedHintThisQuestion = false;\n73\t  }\n74\t\n75\t  pickChar(candidateIndex) {\n76\t    if (this.state !== 'playing') return null;\n77\t    const q = this.questions[this.questionIndex];\n78\t    if (!q || q.answered) return null;\n79\t    const result = this.judge.placeChar(candidateIndex);\n80\t    if (result.action === 'placed') {\n81\t      this.audio.playPlace();\n82\t      if (result.fillCount === 4) {\n83\t        setTimeout(() => this._handleFull(result), 400);\n84\t      }\n85\t    } else if (result.action === 'full') {\n86\t      setTimeout(() => this._handleFull(result), 200);\n87\t    } else if (result.action === 'used') {\n88\t      return null;\n89\t    }\n90\t    this.render();\n91\t    return result;\n92\t  }\n93\t\n94\t  _handleFull(result) {\n95\t    const q = this.questions[this.questionIndex];\n96\t    if (!q || q.answered) return;\n97\t    q.answered = true;\n98\t    q.correct = result.isCorrect;\n99\t\n100\t    if (result.isCorrect) {\n101\t      this.audio.playCorrect();\n102\t      const cr = this.combo.onCorrect(this.usedHintThisQuestion);\n103\t\n104\t      this.analytics.trackQuestionAnswer(true, 0, this.usedHintThisQuestion, cr.combo);\n105\t      this.analytics.trackComboHit(cr.combo, cr.totalGain);\n106\t\n107\t      // Character skill: combo boost\n108\t      const skillResult = this.characters.applySkill({ event: 'combo_bonus' });\n109\t      if (skillResult.triggered && skillResult.multiplier) {\n110\t        const bonus = Math.floor(cr.comboBonus * (skillResult.multiplier - 1));\n111\t        cr.comboBonus += bonus;\n112\t        this.combo.score += bonus;\n113\t        cr.totalGain += bonus;\n114\t      }\n115\t\n116\t      // Character skill: bonus exp\n117\t      const expResult = this.characters.applySkill({ event: 'correct' });\n118\t      if (expResult.triggered && expResult.bonus) {\n119\t        this.data.addExp(expResult.bonus);\n120\t      }\n121\t\n122\t      if (cr.combo >= 3) this.audio.playCombo(cr.combo);\n123\t      this.data.collectIdiom(q.idiom.id);\n124\t      this.daily.updateTaskProgress('answer', 1);\n125\t      this.daily.updateTaskProgress('combo', cr.combo >= 3 ? 1 : 0);\n126\t      q.comboResult = cr;\n127\t      this.render();\n128\t      setTimeout(() => { this.questionIndex++; this._startQuestion(); this.render(); }, 800);\n129\t    } else {\n130\t      // Character skill: lucky save\n131\t      const skillResult = this.characters.applySkill({ event: 'wrong' });\n132\t      if (skillResult.triggered) {\n133\t        this.audio.playHint();\n134\t        this.render();\n135\t        setTimeout(() => {\n136\t          q.answered = false; q.correct = null;\n137\t          this.judge.startQuestion(q);\n138\t          this.render();\n139\t        }, 800);\n140\t        return;\n141\t      }\n142\t\n143\t      this.audio.playWrong();\n144\t      this.combo.onWrong();\n145\t      this.lives--;\n146\t      this.analytics.trackQuestionAnswer(false, 0, false, 0);\n147\t      this.render();\n148\t      if (this.lives <= 0) {\n149\t        if (!this.continuedOnce) {\n150\t          document.getElementById('continue-modal').style.display = 'flex';\n151\t        } else {\n152\t          setTimeout(() => this.finishLevel(), 600);\n153\t        }\n154\t      } else {\n155\t        setTimeout(() => {\n156\t          q.answered = false; q.correct = null;\n157\t          this.judge.startQuestion(q);\n158\t          this.render();\n159\t        }, 600);\n160\t      }\n161\t    }\n162\t  }\n163\t\n164\t  removeSlot(slotIndex) {\n165\t    if (this.state !== 'playing') return null;\n166\t    const q = this.questions[this.questionIndex];\n167\t    if (!q || q.answered) return null;\n168\t    const result = this.judge.removeSlot(slotIndex);\n169\t    if (result.action === 'removed') this.audio.playPlace();\n170\t    this.render();\n171\t    return result;\n172\t  }\n173\t\n174\t  useHintReveal() {\n175\t    if (this.state !== 'playing') return null;\n176\t    const q = this.questions[this.questionIndex];\n177\t    if (!q || q.answered) return null;\n178\t    const fc = this.judge.getFillCount();\n179\t    if (fc >= 4) return null;\n180\t\n181\t    // Character skill: free hint\n182\t    const skillResult = this.characters.applySkill({ event: 'hint' });\n183\t    if (!skillResult.triggered) {\n184\t      if (this.data.coins < this.hintRevealCost) {\n185\t        alert('金币不足');\n186\t        return null;\n187\t      }\n188\t      this.data.spendCoins(this.hintRevealCost);\n189\t    }\n190\t\n191\t    const ch = this.judge.currentIdiom.chars[fc];\n192\t    const cand = q.candidates.find(c => c.char === ch && !c.used);\n193\t    if (!cand) return null;\n194\t    this.usedHintThisQuestion = true;\n195\t    this.audio.playHint();\n196\t    const result = this.judge.placeChar(cand.index);\n197\t    if (result.fillCount === 4) setTimeout(() => this._handleFull(result), 400);\n198\t    this.render();\n199\t    return result;\n200\t  }\n201\t\n202\t  useHintRemove() {\n203\t    if (this.state !== 'playing') return null;\n204\t    const q = this.questions[this.questionIndex];\n205\t    if (!q || q.answered) return null;\n206\t\n207\t    if (this.data.coins < this.hintRemoveCost) {\n208\t      alert('金币不足');\n209\t      return null;\n210\t    }\n211\t    this.data.spendCoins(this.hintRemoveCost);\n212\t\n213\t    const wrong = q.candidates.filter(c => !c.used && !this.judge.currentIdiom.chars.includes(c.char) && !c.removed);\n214\t    const removed = [];\n215\t    const cnt = Math.min(2, wrong.length);\n216\t    for (let i = 0; i < cnt; i++) {\n217\t      const idx = Math.floor(Math.random() * wrong.length);\n218\t      wrong[idx].removed = true;\n219\t      removed.push(wrong[idx]);\n220\t      wrong.splice(idx, 1);\n221\t    }\n222\t    this.audio.playRemove();\n223\t    this.render();\n224\t    return { action: 'removed_distractors', removed };\n225\t  }\n226\t\n227\t  skipQuestion() {\n228\t    if (this.state !== 'playing') return;\n229\t    if (this.data.coins < this.skipCost) {\n230\t      alert('金币不足');\n231\t      return;\n232\t    }\n233\t    this.data.spendCoins(this.skipCost);\n234\t    const q = this.questions[this.questionIndex];\n235\t    if (q) { q.answered = true; q.correct = false; q.skipped = true; }\n236\t    this.combo.onSkip();\n237\t    this.questionIndex++;\n238\t    this._startQuestion();\n239\t    this.render();\n240\t  }\n241\t\n242\t  continueWithAd() {\n243\t    if (this.continuedOnce) return;\n244\t    this.adManager.showRewarded(AD_PLACEMENTS.CONTINUE).then(success => {\n245\t      if (success) {\n246\t        this.analytics.trackAdShow(AD_PLACEMENTS.CONTINUE, true);\n247\t        this.lives = 3;\n248\t        this.continuedOnce = true;\n249\t        const q = this.questions[this.questionIndex];\n250\t        if (q) { q.answered = false; q.correct = null; this.judge.startQuestion(q); }\n251\t        document.getElementById('continue-modal').style.display = 'none';\n252\t        this.render();\n253\t      } else {\n254\t        this.analytics.trackAdShow(AD_PLACEMENTS.CONTINUE, false);\n255\t      }\n256\t    });\n257\t  }\n258\t\n259\t  finishLevel() {\n260\t    this.state = 'result';\n261\t    document.getElementById('continue-modal').style.display = 'none';\n262\t    const s = this.combo.getStats();\n263\t    const stars = this.combo.getStarRating(s.correctCount, this.questions.length);\n264\t\n265\t    if (stars > 0 && this.currentLevel) {\n266\t      this.data.setLevelStars(this.currentLevel.id, stars);\n267\t      this.data.addCoins(this.currentLevel.reward.coins);\n268\t      this.data.addScore(s.score);\n269\t      this.data.updateBestCombo(s.maxCombo);\n270\t      this.data.addExp(this.currentLevel.reward.exp || 10);\n271\t      this.daily.updateTaskProgress('level', 1);\n272\t      this.daily.updateTaskProgress('collect', s.correctCount);\n273\t      this.adManager.reportSuccess();\n274\t      this.analytics.trackLevelComplete(this.currentLevel.id, s.correctCount, this.questions.length, stars, this.currentLevel.reward.coins, s.maxCombo);\n275\t    } else {\n276\t      this.adManager.reportFail();\n277\t      this.analytics.trackLevelFail(this.currentLevel ? this.currentLevel.id : 0, s.correctCount, this.lives, this.questionIndex);\n278\t    }\n279\t\n280\t    this.levelResult = {\n281\t      stars, correctCount: s.correctCount, totalQuestions: this.questions.length,\n282\t      score: s.score, maxCombo: s.maxCombo,\n283\t      coins: stars > 0 ? this.currentLevel.reward.coins : 0\n284\t    };\n285\t    this._doubledReward = false;\n286\t    if (stars > 0) this.audio.playLevelWin(); else this.audio.playLevelFail();\n287\t    this.render();\n288\t\n289\t    // Show interstitial after successful level\n290\t    if (stars > 0 && this.currentLevel) {\n291\t      this.adManager.showInterstitial(this.currentLevel.id);\n292\t    }\n293\t  }\n294\t\n295\t  // W3: Double reward via ad\n296\t  doubleRewardWithAd() {\n297\t    if (this._doubledReward || !this.levelResult || this.levelResult.stars <= 0) return;\n298\t    this.adManager.showRewarded(AD_PLACEMENTS.DOUBLE_REWARD).then(success => {\n299\t      if (success) {\n300\t        this.analytics.trackAdShow(AD_PLACEMENTS.DOUBLE_REWARD, true);\n301\t        this._doubledReward = true;\n302\t        const extra = this.levelResult.coins;\n303\t        this.data.addCoins(extra);\n304\t        this.levelResult.coins *= 2;\n305\t        this.render();\n306\t      } else {\n307\t        this.analytics.trackAdShow(AD_PLACEMENTS.DOUBLE_REWARD, false);\n308\t      }\n309\t    });\n310\t  }\n311\t\n312\t  // W3: Ad-powered hint reveal\n313\t  useHintRevealWithAd() {\n314\t    if (!this.adManager.canShowRewarded(AD_PLACEMENTS.HINT_REVEAL)) {\n315\t      this.useHintReveal();\n316\t      return;\n317\t    }\n318\t    this.adManager.showRewarded(AD_PLACEMENTS.HINT_REVEAL).then(success => {\n319\t      if (success) {\n320\t        this.analytics.trackAdShow(AD_PLACEMENTS.HINT_REVEAL, true);\n321\t        this._doHintReveal(true);\n322\t      } else {\n323\t        this.analytics.trackAdShow(AD_PLACEMENTS.HINT_REVEAL, false);\n324\t        this.useHintReveal();\n325\t      }\n326\t    });\n327\t  }\n328\t\n329\t  // W3: Ad-powered hint remove\n330\t  useHintRemoveWithAd() {\n331\t    if (!this.adManager.canShowRewarded(AD_PLACEMENTS.HINT_REMOVE)) {\n332\t      this.useHintRemove();\n333\t      return;\n334\t    }\n335\t    this.adManager.showRewarded(AD_PLACEMENTS.HINT_REMOVE).then(success => {\n336\t      if (success) {\n337\t        this.analytics.trackAdShow(AD_PLACEMENTS.HINT_REMOVE, true);\n338\t        this._doHintRemove(true);\n339\t      } else {\n340\t        this.analytics.trackAdShow(AD_PLACEMENTS.HINT_REMOVE, false);\n341\t        this.useHintRemove();\n342\t      }\n343\t    });\n344\t  }\n345\t\n346\t  _doHintReveal(free) {\n347\t    if (this.state !== 'playing') return;\n348\t    const q = this.questions[this.questionIndex];\n349\t    if (!q || q.answered) return;\n350\t    const fc = this.judge.getFillCount();\n351\t    if (fc >= 4) return;\n352\t    if (!free) {\n353\t      const skillResult = this.characters.applySkill({ event: 'hint' });\n354\t      if (!skillResult.triggered) {\n355\t        if (this.data.coins < this.hintRevealCost) { alert('金币不足'); return; }\n356\t        this.data.spendCoins(this.hintRevealCost);\n357\t      }\n358\t    }\n359\t    const ch = this.judge.currentIdiom.chars[fc];\n360\t    const cand = q.candidates.find(c => c.char === ch && !c.used);\n361\t    if (!cand) return;\n362\t    this.usedHintThisQuestion = true;\n363\t    this.audio.playHint();\n364\t    this.analytics.trackHintUse('reveal', free ? 0 : this.hintRevealCost);\n365\t    const result = this.judge.placeChar(cand.index);\n366\t    if (result.fillCount === 4) setTimeout(() => this._handleFull(result), 400);\n367\t    this.render();\n368\t  }\n369\t\n370\t  _doHintRemove(free) {\n371\t    if (this.state !== 'playing') return;\n372\t    const q = this.questions[this.questionIndex];\n373\t    if (!q || q.answered) return;\n374\t    if (!free) {\n375\t      if (this.data.coins < this.hintRemoveCost) { alert('金币不足'); return; }\n376\t      this.data.spendCoins(this.hintRemoveCost);\n377\t    }\n378\t    const wrong = q.candidates.filter(c => !c.used && !this.judge.currentIdiom.chars.includes(c.char) && !c.removed);\n379\t    const cnt = Math.min(2, wrong.length);\n380\t    for (let i = 0; i < cnt; i++) {\n381\t      const idx = Math.floor(Math.random() * wrong.length);\n382\t      wrong[idx].removed = true;\n383\t      wrong.splice(idx, 1);\n384\t    }\n385\t    this.audio.playRemove();\n386\t    this.analytics.trackHintUse('remove', free ? 0 : this.hintRemoveCost);\n387\t    this.render();\n388\t  }\n389\t\n390\t  // W3: Daily double via ad\n391\t  dailyDoubleWithAd() {\n392\t    this.adManager.showRewarded(AD_PLACEMENTS.DAILY_DOUBLE).then(success => {\n393\t      if (success) {\n394\t        this.analytics.trackAdShow(AD_PLACEMENTS.DAILY_DOUBLE, true);\n395\t        this.daily.claimLoginDouble();\n396\t        this.render();\n397\t      }\n398\t    });\n399\t  }\n400\t\n401\t  // ===== W2: Timed Challenge =====\n402\t  startTimedChallenge() {\n403\t    this.state = 'timed';\n404\t    this.analytics.trackTimedStart();\n405\t    this.timed.onUpdate = (evt) => {\n406\t      if (evt === 'end') {\n407\t        this.state = 'timed_result';\n408\t        const r = this.timed.getResult();\n409\t        this.analytics.trackTimedEnd(r.score, r.correctCount, r.answeredCount, r.maxCombo);\n410\t      }\n411\t      this.render();\n412\t    };\n413\t    this.timed.start();\n414\t  }\n415\t\n416\t  // ===== W2: PK Mode =====\n417\t  startPK(opponentResult) {\n418\t    this.state = 'pk';\n419\t    this.analytics.trackPKStart();\n420\t    this.pk.onUpdate = (evt) => {\n421\t      if (evt === 'end') {\n422\t        this.state = 'pk_result';\n423\t        const r = this.pk.getResult();\n424\t        this.analytics.trackPKResult(r.won ? 'win' : 'lose', r.correctCount, r.time);\n425\t      }\n426\t      this.render();\n427\t    };\n428\t    this.pk.start(opponentResult);\n429\t  }\n430\t\n431\t  // ===== W2: Collection =====\n432\t  showCollection() {\n433\t    this.state = 'collection';\n434\t    this.render();\n435\t  }\n436\t\n437\t  // ===== W2: Daily =====\n438\t  showDaily() {\n439\t    this.state = 'daily';\n440\t    this.render();\n441\t  }\n442\t\n443\t  // ===== W2: Characters =====\n444\t  showCharacters() {\n445\t    this.state = 'characters';\n446\t    this.render();\n447\t  }\n448\t\n449\t  showLevelMap() {\n450\t    this.state = 'map';\n451\t    this.render();\n452\t  }\n453\t\n454\t  goToMenu() {\n455\t    this.state = 'menu';\n456\t    this.tutorial.end();\n457\t    this.render();\n458\t  }\n459\t\n460\t  getCurrentQuestion() { return this.questions[this.questionIndex]; }\n461\t\n462\t  render() { if (typeof renderUI === 'function') renderUI(this); }\n463\t}\n464\t\n465\tfunction handleHintReveal() { game.useHintRevealWithAd(); }\n466\tfunction handleHintRemove() { game.useHintRemoveWithAd(); }\n467\tfunction handleSkip() { game.skipQuestion(); }\n468\tfunction handleDoubleReward() { game.doubleRewardWithAd(); }\n469\tfunction handleDailyDouble() { game.dailyDoubleWithAd(); }\n470\t\n471\tif (typeof module !== 'undefined') module.exports = { Game };\n472\t"}]},"parent_tool_use_id":null,"session_id":"33562fd9-d4f0-45be-a2a4-d9d379182d9f","uuid":"2a790399-c5f9-4b11-8805-c30b00fa9061","timestamp":"2026-05-23T10:18:19.142Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/src/js/Game.js","content":"// Game.js — Main game controller (W2 extended)\n\nclass Game {\n  constructor() {\n    this.engine = new IdiomEngine(IDIOM_DB);\n    this.judge = new Judge();\n    this.combo = new ComboSystem();\n    this.data = new DataManager();\n    this.audio = new AudioManager();\n    this.tutorial = new Tutorial();\n\n    // W2 systems\n    this.timed = new TimedChallenge(this.engine, this.combo, this.audio, this.data);\n    this.collection = new IdiomCollection(IDIOM_DB, this.data);\n    this.daily = new DailySystem(this.data, this.engine, this.audio);\n    this.pk = new PKMode(this.engine, this.audio, this.data);\n    this.social = new SocialManager(this.data);\n    this.characters = new Characters(this.data);\n\n    // W3 systems\n    this.adManager = new AdManager(this.data);\n    this.analytics = new Analytics(this.data);\n\n    this.currentLevel = null;\n    this.questions = [];\n    this.questionIndex = 0;\n    this.lives = 5;\n    this.state = 'menu';\n    this.usedHintThisQuestion = false;\n    this.continuedOnce = false;\n    this.levelResult = null;\n    this.hintRevealCost = 5;\n    this.hintRemoveCost = 5;\n    this.skipCost = 10;\n    this._doubledReward = false;\n\n    this.analytics.trackGameStart();\n    this.analytics.startFlushTimer();\n  }\n\n  startLevel(levelId) {\n    const level = LEVELS.find(l => l.id === levelId);\n    if (!level) { this.goToMenu(); return; }\n    if (levelId > this.data.unlockedLevel && levelId > 1) {\n      alert('关卡尚未解锁'); return;\n    }\n\n    this.currentLevel = level;\n    this.lives = level.lives;\n    this.engine.reset();\n    this.questions = this.engine.generateForLevel(level);\n    this.questionIndex = 0;\n    this.combo.reset();\n    this.continuedOnce = false;\n    this._doubledReward = false;\n    this.state = 'playing';\n    this.characters.resetLevelState();\n\n    this.analytics.trackLevelStart(levelId, level);\n\n    if (level.tutorial) this.tutorial.start(level.tutorial);\n    else this.tutorial.end();\n\n    this._startQuestion();\n    this.render();\n  }\n\n  _startQuestion() {\n    if (this.questionIndex >= this.questions.length) { this.finishLevel(); return; }\n    const q = this.questions[this.questionIndex];\n    this.judge.startQuestion(q);\n    this.usedHintThisQuestion = false;\n  }\n\n  pickChar(candidateIndex) {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const result = this.judge.placeChar(candidateIndex);\n    if (result.action === 'placed') {\n      this.audio.playPlace();\n      if (result.fillCount === 4) {\n        setTimeout(() => this._handleFull(result), 400);\n      }\n    } else if (result.action === 'full') {\n      setTimeout(() => this._handleFull(result), 200);\n    } else if (result.action === 'used') {\n      return null;\n    }\n    this.render();\n    return result;\n  }\n\n  _handleFull(result) {\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return;\n    q.answered = true;\n    q.correct = result.isCorrect;\n\n    if (result.isCorrect) {\n      this.audio.playCorrect();\n      const cr = this.combo.onCorrect(this.usedHintThisQuestion);\n\n      this.analytics.trackQuestionAnswer(true, 0, this.usedHintThisQuestion, cr.combo);\n      this.analytics.trackComboHit(cr.combo, cr.totalGain);\n\n      // Character skill: combo boost\n      const skillResult = this.characters.applySkill({ event: 'combo_bonus' });\n      if (skillResult.triggered && skillResult.multiplier) {\n        const bonus = Math.floor(cr.comboBonus * (skillResult.multiplier - 1));\n        cr.comboBonus += bonus;\n        this.combo.score += bonus;\n        cr.totalGain += bonus;\n      }\n\n      // Character skill: bonus exp\n      const expResult = this.characters.applySkill({ event: 'correct' });\n      if (expResult.triggered && expResult.bonus) {\n        this.data.addExp(expResult.bonus);\n      }\n\n      if (cr.combo >= 3) this.audio.playCombo(cr.combo);\n      this.data.collectIdiom(q.idiom.id);\n      this.daily.updateTaskProgress('answer', 1);\n      this.daily.updateTaskProgress('combo', cr.combo >= 3 ? 1 : 0);\n      q.comboResult = cr;\n      this.render();\n      setTimeout(() => { this.questionIndex++; this._startQuestion(); this.render(); }, 800);\n    } else {\n      // Character skill: lucky save\n      const skillResult = this.characters.applySkill({ event: 'wrong' });\n      if (skillResult.triggered) {\n        this.audio.playHint();\n        this.render();\n        setTimeout(() => {\n          q.answered = false; q.correct = null;\n          this.judge.startQuestion(q);\n          this.render();\n        }, 800);\n        return;\n      }\n\n      this.audio.playWrong();\n      this.combo.onWrong();\n      this.lives--;\n      this.analytics.trackQuestionAnswer(false, 0, false, 0);\n      this.render();\n      if (this.lives <= 0) {\n        if (!this.continuedOnce) {\n          document.getElementById('continue-modal').style.display = 'flex';\n        } else {\n          setTimeout(() => this.finishLevel(), 600);\n        }\n      } else {\n        setTimeout(() => {\n          q.answered = false; q.correct = null;\n          this.judge.startQuestion(q);\n          this.render();\n        }, 600);\n      }\n    }\n  }\n\n  removeSlot(slotIndex) {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const result = this.judge.removeSlot(slotIndex);\n    if (result.action === 'removed') this.audio.playPlace();\n    this.render();\n    return result;\n  }\n\n  useHintReveal() {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const fc = this.judge.getFillCount();\n    if (fc >= 4) return null;\n\n    // Character skill: free hint\n    const skillResult = this.characters.applySkill({ event: 'hint' });\n    if (!skillResult.triggered) {\n      if (this.data.coins < this.hintRevealCost) {\n        alert('金币不足');\n        return null;\n      }\n      this.data.spendCoins(this.hintRevealCost);\n    }\n\n    const ch = this.judge.currentIdiom.chars[fc];\n    const cand = q.candidates.find(c => c.char === ch && !c.used);\n    if (!cand) return null;\n    this.usedHintThisQuestion = true;\n    this.audio.playHint();\n    const result = this.judge.placeChar(cand.index);\n    if (result.fillCount === 4) setTimeout(() => this._handleFull(result), 400);\n    this.render();\n    return result;\n  }\n\n  useHintRemove() {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n\n    if (this.data.coins < this.hintRemoveCost) {\n      alert('金币不足');\n      return null;\n    }\n    this.data.spendCoins(this.hintRemoveCost);\n\n    const wrong = q.candidates.filter(c => !c.used && !this.judge.currentIdiom.chars.includes(c.char) && !c.removed);\n    const removed = [];\n    const cnt = Math.min(2, wrong.length);\n    for (let i = 0; i < cnt; i++) {\n      const idx = Math.floor(Math.random() * wrong.length);\n      wrong[idx].removed = true;\n      removed.push(wrong[idx]);\n      wrong.splice(idx, 1);\n    }\n    this.audio.playRemove();\n    this.render();\n    return { action: 'removed_distractors', removed };\n  }\n\n  skipQuestion() {\n    if (this.state !== 'playing') return;\n    if (this.data.coins < this.skipCost) {\n      alert('金币不足');\n      return;\n    }\n    this.data.spendCoins(this.skipCost);\n    const q = this.questions[this.questionIndex];\n    if (q) { q.answered = true; q.correct = false; q.skipped = true; }\n    this.combo.onSkip();\n    this.questionIndex++;\n    this._startQuestion();\n    this.render();\n  }\n\n  continueWithAd() {\n    if (this.continuedOnce) return;\n    this.adManager.showRewarded(AD_PLACEMENTS.CONTINUE).then(success => {\n      if (success) {\n        this.analytics.trackAdShow(AD_PLACEMENTS.CONTINUE, true);\n        this.lives = 3;\n        this.continuedOnce = true;\n        const q = this.questions[this.questionIndex];\n        if (q) { q.answered = false; q.correct = null; this.judge.startQuestion(q); }\n        document.getElementById('continue-modal').style.display = 'none';\n        this.render();\n      } else {\n        this.analytics.trackAdShow(AD_PLACEMENTS.CONTINUE, false);\n      }\n    });\n  }\n\n  finishLevel() {\n    this.state = 'result';\n    document.getElementById('continue-modal').style.display = 'none';\n    const s = this.combo.getStats();\n    const stars = this.combo.getStarRating(s.correctCount, this.questions.length);\n\n    if (stars > 0 && this.currentLevel) {\n      this.data.setLevelStars(this.currentLevel.id, stars);\n      this.data.addCoins(this.currentLevel.reward.coins);\n      this.data.addScore(s.score);\n      this.data.updateBestCombo(s.maxCombo);\n      this.data.addExp(this.currentLevel.reward.exp || 10);\n      this.daily.updateTaskProgress('level', 1);\n      this.daily.updateTaskProgress('collect', s.correctCount);\n      this.adManager.reportSuccess();\n      this.analytics.trackLevelComplete(this.currentLevel.id, s.correctCount, this.questions.length, stars, this.currentLevel.reward.coins, s.maxCombo);\n    } else {\n      this.adManager.reportFail();\n      this.analytics.trackLevelFail(this.currentLevel ? this.currentLevel.id : 0, s.correctCount, this.lives, this.questionIndex);\n    }\n\n    this.levelResult = {\n      stars, correctCount: s.correctCount, totalQuestions: this.questions.length,\n      score: s.score, maxCombo: s.maxCombo,\n      coins: stars > 0 ? this.currentLevel.reward.coins : 0\n    };\n    this._doubledReward = false;\n    if (stars > 0) this.audio.playLevelWin(); else this.audio.playLevelFail();\n    this.render();\n\n    // Show interstitial after successful level\n    if (stars > 0 && this.currentLevel) {\n      this.adManager.showInterstitial(this.currentLevel.id);\n    }\n  }\n\n  // W3: Double reward via ad\n  doubleRewardWithAd() {\n    if (this._doubledReward || !this.levelResult || this.levelResult.stars <= 0) return;\n    this.adManager.showRewarded(AD_PLACEMENTS.DOUBLE_REWARD).then(success => {\n      if (success) {\n        this.analytics.trackAdShow(AD_PLACEMENTS.DOUBLE_REWARD, true);\n        this._doubledReward = true;\n        const extra = this.levelResult.coins;\n        this.data.addCoins(extra);\n        this.levelResult.coins *= 2;\n        this.render();\n      } else {\n        this.analytics.trackAdShow(AD_PLACEMENTS.DOUBLE_REWARD, false);\n      }\n    });\n  }\n\n  // W3: Ad-powered hint reveal\n  useHintRevealWithAd() {\n    if (!this.adManager.canShowRewarded(AD_PLACEMENTS.HINT_REVEAL)) {\n      this.useHintReveal();\n      return;\n    }\n    this.adManager.showRewarded(AD_PLACEMENTS.HINT_REVEAL).then(success => {\n      if (success) {\n        this.analytics.trackAdShow(AD_PLACEMENTS.HINT_REVEAL, true);\n        this._doHintReveal(true);\n      } else {\n        this.analytics.trackAdShow(AD_PLACEMENTS.HINT_REVEAL, false);\n        this.useHintReveal();\n      }\n    });\n  }\n\n  // W3: Ad-powered hint remove\n  useHintRemoveWithAd() {\n    if (!this.adManager.canShowRewarded(AD_PLACEMENTS.HINT_REMOVE)) {\n      this.useHintRemove();\n      return;\n    }\n    this.adManager.showRewarded(AD_PLACEMENTS.HINT_REMOVE).then(success => {\n      if (success) {\n        this.analytics.trackAdShow(AD_PLACEMENTS.HINT_REMOVE, true);\n        this._doHintRemove(true);\n      } else {\n        this.analytics.trackAdShow(AD_PLACEMENTS.HINT_REMOVE, false);\n        this.useHintRemove();\n      }\n    });\n  }\n\n  _doHintReveal(free) {\n    if (this.state !== 'playing') return;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return;\n    const fc = this.judge.getFillCount();\n    if (fc >= 4) return;\n    if (!free) {\n      const skillResult = this.characters.applySkill({ event: 'hint' });\n      if (!skillResult.triggered) {\n        if (this.data.coins < this.hintRevealCost) { alert('金币不足'); return; }\n        this.data.spendCoins(this.hintRevealCost);\n      }\n    }\n    const ch = this.judge.currentIdiom.chars[fc];\n    const cand = q.candidates.find(c => c.char === ch && !c.used);\n    if (!cand) return;\n    this.usedHintThisQuestion = true;\n    this.audio.playHint();\n    this.analytics.trackHintUse('reveal', free ? 0 : this.hintRevealCost);\n    const result = this.judge.placeChar(cand.index);\n    if (result.fillCount === 4) setTimeout(() => this._handleFull(result), 400);\n    this.render();\n  }\n\n  _doHintRemove(free) {\n    if (this.state !== 'playing') return;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return;\n    if (!free) {\n      if (this.data.coins < this.hintRemoveCost) { alert('金币不足'); return; }\n      this.data.spendCoins(this.hintRemoveCost);\n    }\n    const wrong = q.candidates.filter(c => !c.used && !this.judge.currentIdiom.chars.includes(c.char) && !c.removed);\n    const cnt = Math.min(2, wrong.length);\n    for (let i = 0; i < cnt; i++) {\n      const idx = Math.floor(Math.random() * wrong.length);\n      wrong[idx].removed = true;\n      wrong.splice(idx, 1);\n    }\n    this.audio.playRemove();\n    this.analytics.trackHintUse('remove', free ? 0 : this.hintRemoveCost);\n    this.render();\n  }\n\n  // W3: Daily double via ad\n  dailyDoubleWithAd() {\n    this.adManager.showRewarded(AD_PLACEMENTS.DAILY_DOUBLE).then(success => {\n      if (success) {\n        this.analytics.trackAdShow(AD_PLACEMENTS.DAILY_DOUBLE, true);\n        this.daily.claimLoginDouble();\n        this.render();\n      }\n    });\n  }\n\n  // ===== W2: Timed Challenge =====\n  startTimedChallenge() {\n    this.state = 'timed';\n    this.analytics.trackTimedStart();\n    this.timed.onUpdate = (evt) => {\n      if (evt === 'end') {\n        this.state = 'timed_result';\n        const r = this.timed.getResult();\n        this.analytics.trackTimedEnd(r.score, r.correctCount, r.answeredCount, r.maxCombo);\n      }\n      this.render();\n    };\n    this.timed.start();\n  }\n\n  // ===== W2: PK Mode =====\n  startPK(opponentResult) {\n    this.state = 'pk';\n    this.analytics.trackPKStart();\n    this.pk.onUpdate = (evt) => {\n      if (evt === 'end') {\n        this.state = 'pk_result';\n        const r = this.pk.getResult();\n        this.analytics.trackPKResult(r.won ? 'win' : 'lose', r.correctCount, r.time);\n      }\n      this.render();\n    };\n    this.pk.start(opponentResult);\n  }\n\n  // ===== W2: Collection =====\n  showCollection() {\n    this.state = 'collection';\n    this.render();\n  }\n\n  // ===== W2: Daily =====\n  showDaily() {\n    this.state = 'daily';\n    this.render();\n  }\n\n  // ===== W2: Characters =====\n  showCharacters() {\n    this.state = 'characters';\n    this.render();\n  }\n\n  showLevelMap() {\n    this.state = 'map';\n    this.render();\n  }\n\n  goToMenu() {\n    this.state = 'menu';\n    this.tutorial.end();\n    this.render();\n  }\n\n  getCurrentQuestion() { return this.questions[this.questionIndex]; }\n\n  render() { if (typeof renderUI === 'function') renderUI(this); }\n}\n\nfunction handleHintReveal() { game.useHintRevealWithAd(); }\nfunction handleHintRemove() { game.useHintRemoveWithAd(); }\nfunction handleSkip() { game.skipQuestion(); }\nfunction handleDoubleReward() { game.doubleRewardWithAd(); }\nfunction handleDailyDouble() { game.dailyDoubleWithAd(); }\n\nif (typeof module !== 'undefined') module.exports = { Game };\n","numLines":472,"startLine":1,"totalLines":472}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_735c0a1f48094a0b9bcc8b4d","type":"tool_result","content":"1\t// Renderer.js — UI rendering (W2 extended)\n2\t\n3\tfunction renderUI(game) {\n4\t  const screens = ['menu-screen','map-screen','game-screen','result-screen',\n5\t    'timed-screen','timed-result-screen','collection-screen','daily-screen',\n6\t    'pk-screen','pk-result-screen','characters-screen'];\n7\t  screens.forEach(id => {\n8\t    const el = document.getElementById(id);\n9\t    if (el) el.classList.remove('active');\n10\t  });\n11\t\n12\t  switch (game.state) {\n13\t    case 'menu': renderMenu(game); break;\n14\t    case 'map': renderMap(game); break;\n15\t    case 'playing': renderGame(game); break;\n16\t    case 'result': renderResult(game); break;\n17\t    case 'timed': renderTimed(game); break;\n18\t    case 'timed_result': renderTimedResult(game); break;\n19\t    case 'collection': renderCollection(game); break;\n20\t    case 'daily': renderDaily(game); break;\n21\t    case 'pk': renderPK(game); break;\n22\t    case 'pk_result': renderPKResult(game); break;\n23\t    case 'characters': renderCharacters(game); break;\n24\t  }\n25\t}\n26\t\n27\tfunction showScreen(id) {\n28\t  const el = document.getElementById(id);\n29\t  if (el) el.classList.add('active');\n30\t}\n31\t\n32\tfunction renderMenu(game) {\n33\t  showScreen('menu-screen');\n34\t  const mc = document.getElementById('menu-coins');\n35\t  const mcl = document.getElementById('menu-collected');\n36\t  if (mc) mc.textContent = game.data.coins;\n37\t  if (mcl) mcl.textContent = game.data.collectedCount;\n38\t\n39\t  const charAvatar = document.getElementById('menu-avatar');\n40\t  if (charAvatar) {\n41\t    const ch = game.characters.getCurrent();\n42\t    charAvatar.textContent = ch.avatar;\n43\t  }\n44\t}\n45\t\n46\tfunction renderMap(game) {\n47\t  showScreen('map-screen');\n48\t  const mc = document.getElementById('map-coins');\n49\t  if (mc) mc.textContent = game.data.coins;\n50\t\n51\t  const grid = document.getElementById('level-grid');\n52\t  if (!grid) return;\n53\t  grid.innerHTML = '';\n54\t\n55\t  const chapters = {};\n56\t  LEVELS.forEach(l => {\n57\t    if (!chapters[l.chapter]) chapters[l.chapter] = [];\n58\t    chapters[l.chapter].push(l);\n59\t  });\n60\t\n61\t  const chapInfo = document.getElementById('chapter-info');\n62\t  if (chapInfo) {\n63\t    chapInfo.innerHTML = CHAPTERS.map(c =>\n64\t      `<div class=\"chapter-badge\" style=\"background:${c.color};${c.id>=4?'color:#fff':''}\">${c.name} · ${c.subtitle}</div>`\n65\t    ).join('');\n66\t  }\n67\t\n68\t  Object.keys(chapters).forEach(chId => {\n69\t    const section = document.createElement('div');\n70\t    section.className = 'chapter-section';\n71\t    const chap = CHAPTERS.find(c => c.id === parseInt(chId));\n72\t    if (chap) section.style.borderColor = chap.color;\n73\t\n74\t    chapters[chId].forEach(level => {\n75\t      const btn = document.createElement('button');\n76\t      const stars = game.data.getLevelStars(level.id);\n77\t      const unlocked = level.id <= game.data.unlockedLevel;\n78\t      const isBoss = level.boss;\n79\t\n80\t      btn.className = 'level-btn' + (isBoss ? ' boss' : '') + (!unlocked ? ' locked' : '') + (stars > 0 ? ' completed' : '');\n81\t      btn.innerHTML = `\n82\t        <span class=\"level-num\">${level.id}</span>\n83\t        <span class=\"level-stars\">${'★'.repeat(stars)}${'☆'.repeat(3 - stars)}</span>\n84\t        <span class=\"level-name\">${level.name}</span>\n85\t      `;\n86\t\n87\t      if (unlocked) btn.onclick = () => game.startLevel(level.id);\n88\t      section.appendChild(btn);\n89\t    });\n90\t    grid.appendChild(section);\n91\t  });\n92\t}\n93\t\n94\tfunction renderGame(game) {\n95\t  showScreen('game-screen');\n96\t  const q = game.getCurrentQuestion();\n97\t  if (!q) return;\n98\t\n99\t  const ll = document.getElementById('level-label');\n100\t  const pl = document.getElementById('progress-label');\n101\t  const ld = document.getElementById('lives-display');\n102\t  if (ll) ll.textContent = `第${game.currentLevel.id}关`;\n103\t  if (pl) pl.textContent = `${game.questionIndex + 1}/${game.questions.length}`;\n104\t  if (ld) ld.textContent = '❤️'.repeat(Math.max(0, game.lives));\n105\t\n106\t  const mt = document.getElementById('meaning-text');\n107\t  if (mt) mt.textContent = q.idiom.meaning;\n108\t\n109\t  const cd = document.getElementById('combo-display');\n110\t  if (cd) {\n111\t    if (game.combo.combo >= 3) {\n112\t      cd.textContent = `🔥 ${game.combo.combo}连击！${game.combo.getComboMessage()}`;\n113\t      cd.style.display = 'block';\n114\t      cd.className = 'combo-display combo-' + Math.min(game.combo.combo, 10);\n115\t    } else {\n116\t      cd.style.display = 'none';\n117\t    }\n118\t  }\n119\t\n120\t  const sc = document.getElementById('slots-container');\n121\t  if (sc) {\n122\t    sc.innerHTML = '';\n123\t    const slots = game.judge.getSlots();\n124\t    for (let i = 0; i < 4; i++) {\n125\t      const slot = document.createElement('div');\n126\t      slot.className = 'slot';\n127\t      if (slots[i]) {\n128\t        slot.classList.add('filled');\n129\t        slot.textContent = slots[i].char;\n130\t        slot.onclick = () => { game.removeSlot(i); };\n131\t      }\n132\t      if (q.answered && q.correct === true) slot.classList.add('correct');\n133\t      if (q.answered && q.correct === false) slot.classList.add('wrong');\n134\t      sc.appendChild(slot);\n135\t    }\n136\t  }\n137\t\n138\t  const ih = document.getElementById('idiom-hint');\n139\t  if (ih) {\n140\t    if (q.answered && q.correct) {\n141\t      ih.innerHTML = `<strong>${q.idiom.idiom}</strong>：${q.idiom.meaning}`;\n142\t      ih.style.display = 'block';\n143\t    } else {\n144\t      ih.style.display = 'none';\n145\t    }\n146\t  }\n147\t\n148\t  const cc = document.getElementById('candidates-container');\n149\t  if (cc) {\n150\t    cc.innerHTML = '';\n151\t    q.candidates.forEach((c, i) => {\n152\t      const btn = document.createElement('button');\n153\t      btn.className = 'candidate';\n154\t      btn.textContent = c.char;\n155\t      if (c.used) btn.classList.add('used');\n156\t      if (c.removed) btn.classList.add('removed');\n157\t      if (!c.used && !c.removed && !q.answered) btn.onclick = () => game.pickChar(i);\n158\t      cc.appendChild(btn);\n159\t    });\n160\t  }\n161\t\n162\t  const to = document.getElementById('tutorial-overlay');\n163\t  const tt = document.getElementById('tutorial-text');\n164\t  if (to && tt) {\n165\t    const step = game.tutorial.getCurrentStep();\n166\t    if (step) { tt.textContent = step.msg; to.style.display = 'flex'; }\n167\t    else { to.style.display = 'none'; }\n168\t  }\n169\t\n170\t  // Update tool button costs\n171\t  const hintBtns = document.querySelectorAll('.tool-btn');\n172\t  if (hintBtns.length >= 3) {\n173\t    hintBtns[0].textContent = `📖 揭示 (${game.hintRevealCost}🪙)`;\n174\t    hintBtns[1].textContent = `✂️ 去干扰 (${game.hintRemoveCost}🪙)`;\n175\t    hintBtns[2].textContent = `⏭ 跳过 (${game.skipCost}🪙)`;\n176\t  }\n177\t}\n178\t\n179\tfunction renderResult(game) {\n180\t  showScreen('result-screen');\n181\t  const r = game.levelResult;\n182\t  if (!r) return;\n183\t\n184\t  const rt = document.getElementById('result-title');\n185\t  if (rt) rt.textContent = r.stars > 0 ? '🎉 通关!' : '😞 失败';\n186\t\n187\t  const rs = document.getElementById('result-stars');\n188\t  if (rs) rs.innerHTML = '★'.repeat(r.stars) + '☆'.repeat(3 - r.stars);\n189\t\n190\t  document.getElementById('result-correct').textContent = r.correctCount;\n191\t  document.getElementById('result-total').textContent = r.totalQuestions;\n192\t  document.getElementById('result-score').textContent = r.score;\n193\t  document.getElementById('result-combo').textContent = r.maxCombo;\n194\t  document.getElementById('result-coins').textContent = r.coins;\n195\t\n196\t  const btnNext = document.getElementById('btn-next');\n197\t  if (btnNext) {\n198\t    const nextId = game.currentLevel.id + 1;\n199\t    btnNext.style.display = (r.stars > 0 && LEVELS.find(l => l.id === nextId)) ? 'inline-block' : 'none';\n200\t  }\n201\t  const btnRetry = document.getElementById('btn-retry');\n202\t  if (btnRetry) btnRetry.style.display = r.stars > 0 ? 'none' : 'inline-block';\n203\t\n204\t  // W3: Double reward button\n205\t  const btnDouble = document.getElementById('btn-double');\n206\t  if (btnDouble) {\n207\t    const canDouble = r.stars > 0 && !game._doubledReward &&\n208\t      game.adManager && game.adManager.canShowRewarded(AD_PLACEMENTS.DOUBLE_REWARD);\n209\t    btnDouble.style.display = canDouble ? 'inline-block' : 'none';\n210\t  }\n211\t}\n212\t\n213\t// ===== W2: Timed Challenge =====\n214\tfunction renderTimed(game) {\n215\t  showScreen('timed-screen');\n216\t  const tc = game.timed;\n217\t  const q = tc.currentQ;\n218\t  if (!q) return;\n219\t\n220\t  const timer = document.getElementById('timed-timer');\n221\t  if (timer) {\n222\t    timer.textContent = `${tc.timeLeft}s`;\n223\t    timer.className = 'timer-display' + (tc.timeLeft <= 10 ? ' timer-warning' : '');\n224\t  }\n225\t\n226\t  const score = document.getElementById('timed-score');\n227\t  if (score) score.textContent = tc.score;\n228\t\n229\t  const combo = document.getElementById('timed-combo');\n230\t  if (combo) {\n231\t    if (game.combo.combo >= 3) {\n232\t      combo.textContent = `🔥 ${game.combo.combo}连击！`;\n233\t      combo.style.display = 'block';\n234\t    } else {\n235\t      combo.style.display = 'none';\n236\t    }\n237\t  }\n238\t\n239\t  const mt = document.getElementById('timed-meaning');\n240\t  if (mt) mt.textContent = q.idiom.meaning;\n241\t\n242\t  const sc = document.getElementById('timed-slots');\n243\t  if (sc) {\n244\t    sc.innerHTML = '';\n245\t    const slots = tc.judge.getSlots();\n246\t    for (let i = 0; i < 4; i++) {\n247\t      const slot = document.createElement('div');\n248\t      slot.className = 'slot';\n249\t      if (slots[i]) { slot.classList.add('filled'); slot.textContent = slots[i].char; slot.onclick = () => tc.removeSlot(i); }\n250\t      if (q.answered && q.correct === true) slot.classList.add('correct');\n251\t      if (q.answered && q.correct === false) slot.classList.add('wrong');\n252\t      sc.appendChild(slot);\n253\t    }\n254\t  }\n255\t\n256\t  const cc = document.getElementById('timed-candidates');\n257\t  if (cc) {\n258\t    cc.innerHTML = '';\n259\t    q.candidates.forEach((c, i) => {\n260\t      const btn = document.createElement('button');\n261\t      btn.className = 'candidate';\n262\t      btn.textContent = c.char;\n263\t      if (c.used) btn.classList.add('used');\n264\t      if (c.removed) btn.classList.add('removed');\n265\t      if (!c.used && !c.removed && !q.answered) btn.onclick = () => tc.pickChar(i);\n266\t      cc.appendChild(btn);\n267\t    });\n268\t  }\n269\t}\n270\t\n271\tfunction renderTimedResult(game) {\n272\t  showScreen('timed-result-screen');\n273\t  const r = game.timed.getResult();\n274\t  document.getElementById('tr-score').textContent = r.score;\n275\t  document.getElementById('tr-correct').textContent = r.correctCount;\n276\t  document.getElementById('tr-total').textContent = r.answeredCount;\n277\t  document.getElementById('tr-combo').textContent = r.maxCombo;\n278\t  document.getElementById('tr-coins').textContent = Math.floor(r.score / 10);\n279\t}\n280\t\n281\t// ===== W2: Collection =====\n282\tfunction renderCollection(game) {\n283\t  showScreen('collection-screen');\n284\t  const col = game.collection;\n285\t  const progress = col.getProgress();\n286\t\n287\t  document.getElementById('col-progress').textContent = `${progress.collected}/${progress.total} (${progress.percent}%)`;\n288\t\n289\t  const bar = document.getElementById('col-progress-bar');\n290\t  if (bar) bar.style.width = progress.percent + '%';\n291\t\n292\t  // Categories\n293\t  const catContainer = document.getElementById('col-categories');\n294\t  if (catContainer) {\n295\t    const cats = ['全部', ...col.getCategories()];\n296\t    catContainer.innerHTML = cats.map(c =>\n297\t      `<button class=\"cat-btn${col.selectedCategory === (c === '全部' ? null : c) ? ' active' : ''}\" onclick=\"handleCategoryFilter('${c}')\">${c}</button>`\n298\t    ).join('');\n299\t  }\n300\t\n301\t  // Search\n302\t  const searchInput = document.getElementById('col-search');\n303\t  if (searchInput && searchInput.value !== col.searchQuery) {\n304\t    searchInput.value = col.searchQuery;\n305\t  }\n306\t\n307\t  // Idiom grid\n308\t  const grid = document.getElementById('col-grid');\n309\t  if (grid) {\n310\t    const idioms = col.getFilteredIdioms();\n311\t    grid.innerHTML = idioms.slice(0, 60).map(i =>\n312\t      `<div class=\"idiom-card${i.collected ? ' collected' : ''}\" onclick=\"handleIdiomSelect('${i.id}')\">\n313\t        <span class=\"idiom-text\">${i.collected ? i.idiom : '？？？？'}</span>\n314\t        <span class=\"idiom-cat\">${(i.category || [])[0] || ''}</span>\n315\t      </div>`\n316\t    ).join('');\n317\t    if (idioms.length > 60) {\n318\t      grid.innerHTML += `<div class=\"more-hint\">还有${idioms.length - 60}个...</div>`;\n319\t    }\n320\t  }\n321\t\n322\t  // Detail view\n323\t  const detail = document.getElementById('col-detail');\n324\t  if (detail) {\n325\t    if (col.selectedIdiom) {\n326\t      const i = col.selectedIdiom;\n327\t      const collected = game.data.collectedIdioms.includes(i.id);\n328\t      detail.style.display = 'block';\n329\t      detail.innerHTML = `\n330\t        <div class=\"detail-header\">\n331\t          <h3>${collected ? i.idiom : '？？？？'}</h3>\n332\t          <button class=\"btn-back\" onclick=\"game.collection.selectIdiom(null)\">✕</button>\n333\t        </div>\n334\t        ${collected ? `\n335\t          <p class=\"detail-pinyin\">${i.pinyin || ''}</p>\n336\t          <p class=\"detail-meaning\">${i.meaning}</p>\n337\t          ${i.origin ? `<p class=\"detail-origin\">出处：${i.origin}</p>` : ''}\n338\t          ${i.example ? `<p class=\"detail-example\">例句：${i.example}</p>` : ''}\n339\t        ` : '<p class=\"detail-locked\">收集此成语后可查看详情</p>'}\n340\t      `;\n341\t    } else {\n342\t      detail.style.display = 'none';\n343\t    }\n344\t  }\n345\t}\n346\t\n347\t// ===== W2: Daily =====\n348\tfunction renderDaily(game) {\n349\t  showScreen('daily-screen');\n350\t  const ds = game.daily.getDailyState();\n351\t\n352\t  document.getElementById('daily-streak').textContent = ds.loginStreak;\n353\t  document.getElementById('daily-claimed').textContent = ds.todayClaimed ? '已领取' : '未领取';\n354\t  document.getElementById('daily-claim-btn').disabled = ds.todayClaimed;\n355\t  document.getElementById('daily-claim-btn').textContent = ds.todayClaimed ? '已领取 ✓' : `领取签到奖励 (×${Math.min(ds.loginStreak, 7)}0🪙)`;\n356\t\n357\t  // W3: Daily double ad button\n358\t  const dailyDoubleBtn = document.getElementById('daily-double-btn');\n359\t  if (dailyDoubleBtn) {\n360\t    dailyDoubleBtn.style.display = (ds.todayClaimed && !ds.doubled &&\n361\t      game.adManager && game.adManager.canShowRewarded(AD_PLACEMENTS.DAILY_DOUBLE)) ? 'inline-block' : 'none';\n362\t  }\n363\t\n364\t  // Tasks\n365\t  const tasksEl = document.getElementById('daily-tasks');\n366\t  if (tasksEl) {\n367\t    tasksEl.innerHTML = ds.tasks.map(t => `\n368\t      <div class=\"task-item${t.claimed ? ' done' : ''}\">\n369\t        <span class=\"task-desc\">${t.desc}</span>\n370\t        <span class=\"task-progress\">${t.progress}/${t.target}</span>\n371\t        <button class=\"task-btn${t.claimed ? ' claimed' : ''}\"\n372\t          ${t.claimed || t.progress < t.target ? 'disabled' : ''}\n373\t          onclick=\"handleClaimTask('${t.id}')\">\n374\t          ${t.claimed ? '已领' : `${t.reward}🪙`}\n375\t        </button>\n376\t      </div>\n377\t    `).join('');\n378\t  }\n379\t\n380\t  // Challenge\n381\t  const challengeEl = document.getElementById('daily-challenge');\n382\t  if (challengeEl) {\n383\t    if (ds.challengeIdiom) {\n384\t      challengeEl.innerHTML = `\n385\t        <div class=\"challenge-card${ds.challengeCompleted ? ' done' : ''}\">\n386\t          <h4>今日成语挑战</h4>\n387\t          <p class=\"challenge-meaning\">${ds.challengeIdiom.meaning}</p>\n388\t          <p class=\"challenge-hint\">${ds.challengeCompleted ? `答案：${ds.challengeIdiom.idiom}` : '提示：' + ds.challengeIdiom.chars[0] + '？？？'}</p>\n389\t          ${ds.challengeCompleted ?\n390\t            '<span class=\"challenge-done\">已完成 ✓ +50🪙</span>' :\n391\t            `<button class=\"btn btn-primary btn-sm\" onclick=\"handleDailyChallenge()\">挑战</button>`\n392\t          }\n393\t        </div>\n394\t      `;\n395\t    }\n396\t  }\n397\t}\n398\t\n399\t// ===== W2: PK =====\n400\tfunction renderPK(game) {\n401\t  showScreen('pk-screen');\n402\t  const pk = game.pk;\n403\t  const q = pk.currentQ;\n404\t  if (!q) return;\n405\t\n406\t  document.getElementById('pk-progress').textContent = `${pk.currentIndex + 1}/5`;\n407\t\n408\t  const mt = document.getElementById('pk-meaning');\n409\t  if (mt) mt.textContent = q.idiom.meaning;\n410\t\n411\t  const sc = document.getElementById('pk-slots');\n412\t  if (sc) {\n413\t    sc.innerHTML = '';\n414\t    const slots = pk.judge.getSlots();\n415\t    for (let i = 0; i < 4; i++) {\n416\t      const slot = document.createElement('div');\n417\t      slot.className = 'slot';\n418\t      if (slots[i]) { slot.classList.add('filled'); slot.textContent = slots[i].char; slot.onclick = () => pk.removeSlot(i); }\n419\t      if (q.answered && q.correct === true) slot.classList.add('correct');\n420\t      if (q.answered && q.correct === false) slot.classList.add('wrong');\n421\t      sc.appendChild(slot);\n422\t    }\n423\t  }\n424\t\n425\t  const cc = document.getElementById('pk-candidates');\n426\t  if (cc) {\n427\t    cc.innerHTML = '';\n428\t    q.candidates.forEach((c, i) => {\n429\t      const btn = document.createElement('button');\n430\t      btn.className = 'candidate';\n431\t      btn.textContent = c.char;\n432\t      if (c.used) btn.classList.add('used');\n433\t      if (c.removed) btn.classList.add('removed');\n434\t      if (!c.used && !c.removed && !q.answered) btn.onclick = () => pk.pickChar(i);\n435\t      cc.appendChild(btn);\n436\t    });\n437\t  }\n438\t}\n439\t\n440\tfunction renderPKResult(game) {\n441\t  showScreen('pk-result-screen');\n442\t  const r = game.pk.getResult();\n443\t  document.getElementById('pkr-result').textContent = r.won ? '🎉 胜利！' : '😢 惜败';\n444\t  document.getElementById('pkr-correct').textContent = `${r.correctCount}/5`;\n445\t  document.getElementById('pkr-time').textContent = `${(r.time / 1000).toFixed(1)}s`;\n446\t  document.getElementById('pkr-reward').textContent = r.won ? '+50🪙' : '';\n447\t\n448\t  // Answers review\n449\t  const answersEl = document.getElementById('pkr-answers');\n450\t  if (answersEl) {\n451\t    answersEl.innerHTML = r.answers.map((a, i) =>\n452\t      `<div class=\"answer-item${a.correct ? ' correct' : ' wrong'}\">${i+1}. ${a.idiom} ${a.correct ? '✓' : '✗'}</div>`\n453\t    ).join('');\n454\t  }\n455\t}\n456\t\n457\t// ===== W2: Characters =====\n458\tfunction renderCharacters(game) {\n459\t  showScreen('characters-screen');\n460\t  const chars = game.characters.getAll();\n461\t\n462\t  const grid = document.getElementById('char-grid');\n463\t  if (grid) {\n464\t    grid.innerHTML = chars.map(c => {\n465\t      const selected = game.data.data.characters.current === c.id;\n466\t      return `\n467\t        <div class=\"char-card${selected ? ' selected' : ''}${!c.unlocked ? ' locked' : ''}\"\n468\t             onclick=\"${c.unlocked ? `game.characters.select('${c.id}'); game.render()` : ''}\">\n469\t          <div class=\"char-avatar\">${c.unlocked ? c.avatar : '🔒'}</div>\n470\t          <div class=\"char-name\">${c.name}</div>\n471\t          <div class=\"char-skill\">${c.unlocked ? c.skill.name : `通关第${c.unlock.level || '?'}关解锁`}</div>\n472\t          ${selected ? '<div class=\"char-badge\">使用中</div>' : ''}\n473\t        </div>\n474\t      `;\n475\t    }).join('');\n476\t  }\n477\t\n478\t  // Skill detail\n479\t  const current = game.characters.getCurrent();\n480\t  const detail = document.getElementById('char-detail');\n481\t  if (detail) {\n482\t    detail.innerHTML = `\n483\t      <h4>${current.avatar} ${current.name}</h4>\n484\t      <p class=\"skill-name\">${current.skill.name}</p>\n485\t      <p class=\"skill-desc\">${current.skill.desc}</p>\n486\t    `;\n487\t  }\n488\t}\n489\t\n490\t// ===== Global handlers =====\n491\tfunction handleCategoryFilter(cat) {\n492\t  if (cat === '全部') { game.collection.clearFilter(); }\n493\t  else { game.collection.filterByCategory(cat); }\n494\t  game.render();\n495\t}\n496\t\n497\tfunction handleIdiomSelect(id) { game.collection.selectIdiom(id); game.render(); }\n498\t\n499\tfunction handleClaimTask(taskId) { game.daily.claimTask(taskId); game.render(); }\n500\t\n501\tfunction handleDailyChallenge() {\n502\t  const ds = game.daily.getDailyState();\n503\t  if (ds.challengeIdiom && !ds.challengeCompleted) {\n504\t    game.daily.completeChallenge();\n505\t    game.render();\n506\t  }\n507\t}\n508\t\n509\tfunction handleColSearch(val) { game.collection.search(val); game.render(); }\n510\t"}]},"parent_tool_use_id":null,"session_id":"33562fd9-d4f0-45be-a2a4-d9d379182d9f","uuid":"2d0aacae-9e09-42ec-8c59-069511e79250","timestamp":"2026-05-23T10:18:19.145Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/src/js/Renderer.js","content":"// Renderer.js — UI rendering (W2 extended)\n\nfunction renderUI(game) {\n  const screens = ['menu-screen','map-screen','game-screen','result-screen',\n    'timed-screen','timed-result-screen','collection-screen','daily-screen',\n    'pk-screen','pk-result-screen','characters-screen'];\n  screens.forEach(id => {\n    const el = document.getElementById(id);\n    if (el) el.classList.remove('active');\n  });\n\n  switch (game.state) {\n    case 'menu': renderMenu(game); break;\n    case 'map': renderMap(game); break;\n    case 'playing': renderGame(game); break;\n    case 'result': renderResult(game); break;\n    case 'timed': renderTimed(game); break;\n    case 'timed_result': renderTimedResult(game); break;\n    case 'collection': renderCollection(game); break;\n    case 'daily': renderDaily(game); break;\n    case 'pk': renderPK(game); break;\n    case 'pk_result': renderPKResult(game); break;\n    case 'characters': renderCharacters(game); break;\n  }\n}\n\nfunction showScreen(id) {\n  const el = document.getElementById(id);\n  if (el) el.classList.add('active');\n}\n\nfunction renderMenu(game) {\n  showScreen('menu-screen');\n  const mc = document.getElementById('menu-coins');\n  const mcl = document.getElementById('menu-collected');\n  if (mc) mc.textContent = game.data.coins;\n  if (mcl) mcl.textContent = game.data.collectedCount;\n\n  const charAvatar = document.getElementById('menu-avatar');\n  if (charAvatar) {\n    const ch = game.characters.getCurrent();\n    charAvatar.textContent = ch.avatar;\n  }\n}\n\nfunction renderMap(game) {\n  showScreen('map-screen');\n  const mc = document.getElementById('map-coins');\n  if (mc) mc.textContent = game.data.coins;\n\n  const grid = document.getElementById('level-grid');\n  if (!grid) return;\n  grid.innerHTML = '';\n\n  const chapters = {};\n  LEVELS.forEach(l => {\n    if (!chapters[l.chapter]) chapters[l.chapter] = [];\n    chapters[l.chapter].push(l);\n  });\n\n  const chapInfo = document.getElementById('chapter-info');\n  if (chapInfo) {\n    chapInfo.innerHTML = CHAPTERS.map(c =>\n      `<div class=\"chapter-badge\" style=\"background:${c.color};${c.id>=4?'color:#fff':''}\">${c.name} · ${c.subtitle}</div>`\n    ).join('');\n  }\n\n  Object.keys(chapters).forEach(chId => {\n    const section = document.createElement('div');\n    section.className = 'chapter-section';\n    const chap = CHAPTERS.find(c => c.id === parseInt(chId));\n    if (chap) section.style.borderColor = chap.color;\n\n    chapters[chId].forEach(level => {\n      const btn = document.createElement('button');\n      const stars = game.data.getLevelStars(level.id);\n      const unlocked = level.id <= game.data.unlockedLevel;\n      const isBoss = level.boss;\n\n      btn.className = 'level-btn' + (isBoss ? ' boss' : '') + (!unlocked ? ' locked' : '') + (stars > 0 ? ' completed' : '');\n      btn.innerHTML = `\n        <span class=\"level-num\">${level.id}</span>\n        <span class=\"level-stars\">${'★'.repeat(stars)}${'☆'.repeat(3 - stars)}</span>\n        <span class=\"level-name\">${level.name}</span>\n      `;\n\n      if (unlocked) btn.onclick = () => game.startLevel(level.id);\n      section.appendChild(btn);\n    });\n    grid.appendChild(section);\n  });\n}\n\nfunction renderGame(game) {\n  showScreen('game-screen');\n  const q = game.getCurrentQuestion();\n  if (!q) return;\n\n  const ll = document.getElementById('level-label');\n  const pl = document.getElementById('progress-label');\n  const ld = document.getElementById('lives-display');\n  if (ll) ll.textContent = `第${game.currentLevel.id}关`;\n  if (pl) pl.textContent = `${game.questionIndex + 1}/${game.questions.length}`;\n  if (ld) ld.textContent = '❤️'.repeat(Math.max(0, game.lives));\n\n  const mt = document.getElementById('meaning-text');\n  if (mt) mt.textContent = q.idiom.meaning;\n\n  const cd = document.getElementById('combo-display');\n  if (cd) {\n    if (game.combo.combo >= 3) {\n      cd.textContent = `🔥 ${game.combo.combo}连击！${game.combo.getComboMessage()}`;\n      cd.style.display = 'block';\n      cd.className = 'combo-display combo-' + Math.min(game.combo.combo, 10);\n    } else {\n      cd.style.display = 'none';\n    }\n  }\n\n  const sc = document.getElementById('slots-container');\n  if (sc) {\n    sc.innerHTML = '';\n    const slots = game.judge.getSlots();\n    for (let i = 0; i < 4; i++) {\n      const slot = document.createElement('div');\n      slot.className = 'slot';\n      if (slots[i]) {\n        slot.classList.add('filled');\n        slot.textContent = slots[i].char;\n        slot.onclick = () => { game.removeSlot(i); };\n      }\n      if (q.answered && q.correct === true) slot.classList.add('correct');\n      if (q.answered && q.correct === false) slot.classList.add('wrong');\n      sc.appendChild(slot);\n    }\n  }\n\n  const ih = document.getElementById('idiom-hint');\n  if (ih) {\n    if (q.answered && q.correct) {\n      ih.innerHTML = `<strong>${q.idiom.idiom}</strong>：${q.idiom.meaning}`;\n      ih.style.display = 'block';\n    } else {\n      ih.style.display = 'none';\n    }\n  }\n\n  const cc = document.getElementById('candidates-container');\n  if (cc) {\n    cc.innerHTML = '';\n    q.candidates.forEach((c, i) => {\n      const btn = document.createElement('button');\n      btn.className = 'candidate';\n      btn.textContent = c.char;\n      if (c.used) btn.classList.add('used');\n      if (c.removed) btn.classList.add('removed');\n      if (!c.used && !c.removed && !q.answered) btn.onclick = () => game.pickChar(i);\n      cc.appendChild(btn);\n    });\n  }\n\n  const to = document.getElementById('tutorial-overlay');\n  const tt = document.getElementById('tutorial-text');\n  if (to && tt) {\n    const step = game.tutorial.getCurrentStep();\n    if (step) { tt.textContent = step.msg; to.style.display = 'flex'; }\n    else { to.style.display = 'none'; }\n  }\n\n  // Update tool button costs\n  const hintBtns = document.querySelectorAll('.tool-btn');\n  if (hintBtns.length >= 3) {\n    hintBtns[0].textContent = `📖 揭示 (${game.hintRevealCost}🪙)`;\n    hintBtns[1].textContent = `✂️ 去干扰 (${game.hintRemoveCost}🪙)`;\n    hintBtns[2].textContent = `⏭ 跳过 (${game.skipCost}🪙)`;\n  }\n}\n\nfunction renderResult(game) {\n  showScreen('result-screen');\n  const r = game.levelResult;\n  if (!r) return;\n\n  const rt = document.getElementById('result-title');\n  if (rt) rt.textContent = r.stars > 0 ? '🎉 通关!' : '😞 失败';\n\n  const rs = document.getElementById('result-stars');\n  if (rs) rs.innerHTML = '★'.repeat(r.stars) + '☆'.repeat(3 - r.stars);\n\n  document.getElementById('result-correct').textContent = r.correctCount;\n  document.getElementById('result-total').textContent = r.totalQuestions;\n  document.getElementById('result-score').textContent = r.score;\n  document.getElementById('result-combo').textContent = r.maxCombo;\n  document.getElementById('result-coins').textContent = r.coins;\n\n  const btnNext = document.getElementById('btn-next');\n  if (btnNext) {\n    const nextId = game.currentLevel.id + 1;\n    btnNext.style.display = (r.stars > 0 && LEVELS.find(l => l.id === nextId)) ? 'inline-block' : 'none';\n  }\n  const btnRetry = document.getElementById('btn-retry');\n  if (btnRetry) btnRetry.style.display = r.stars > 0 ? 'none' : 'inline-block';\n\n  // W3: Double reward button\n  const btnDouble = document.getElementById('btn-double');\n  if (btnDouble) {\n    const canDouble = r.stars > 0 && !game._doubledReward &&\n      game.adManager && game.adManager.canShowRewarded(AD_PLACEMENTS.DOUBLE_REWARD);\n    btnDouble.style.display = canDouble ? 'inline-block' : 'none';\n  }\n}\n\n// ===== W2: Timed Challenge =====\nfunction renderTimed(game) {\n  showScreen('timed-screen');\n  const tc = game.timed;\n  const q = tc.currentQ;\n  if (!q) return;\n\n  const timer = document.getElementById('timed-timer');\n  if (timer) {\n    timer.textContent = `${tc.timeLeft}s`;\n    timer.className = 'timer-display' + (tc.timeLeft <= 10 ? ' timer-warning' : '');\n  }\n\n  const score = document.getElementById('timed-score');\n  if (score) score.textContent = tc.score;\n\n  const combo = document.getElementById('timed-combo');\n  if (combo) {\n    if (game.combo.combo >= 3) {\n      combo.textContent = `🔥 ${game.combo.combo}连击！`;\n      combo.style.display = 'block';\n    } else {\n      combo.style.display = 'none';\n    }\n  }\n\n  const mt = document.getElementById('timed-meaning');\n  if (mt) mt.textContent = q.idiom.meaning;\n\n  const sc = document.getElementById('timed-slots');\n  if (sc) {\n    sc.innerHTML = '';\n    const slots = tc.judge.getSlots();\n    for (let i = 0; i < 4; i++) {\n      const slot = document.createElement('div');\n      slot.className = 'slot';\n      if (slots[i]) { slot.classList.add('filled'); slot.textContent = slots[i].char; slot.onclick = () => tc.removeSlot(i); }\n      if (q.answered && q.correct === true) slot.classList.add('correct');\n      if (q.answered && q.correct === false) slot.classList.add('wrong');\n      sc.appendChild(slot);\n    }\n  }\n\n  const cc = document.getElementById('timed-candidates');\n  if (cc) {\n    cc.innerHTML = '';\n    q.candidates.forEach((c, i) => {\n      const btn = document.createElement('button');\n      btn.className = 'candidate';\n      btn.textContent = c.char;\n      if (c.used) btn.classList.add('used');\n      if (c.removed) btn.classList.add('removed');\n      if (!c.used && !c.removed && !q.answered) btn.onclick = () => tc.pickChar(i);\n      cc.appendChild(btn);\n    });\n  }\n}\n\nfunction renderTimedResult(game) {\n  showScreen('timed-result-screen');\n  const r = game.timed.getResult();\n  document.getElementById('tr-score').textContent = r.score;\n  document.getElementById('tr-correct').textContent = r.correctCount;\n  document.getElementById('tr-total').textContent = r.answeredCount;\n  document.getElementById('tr-combo').textContent = r.maxCombo;\n  document.getElementById('tr-coins').textContent = Math.floor(r.score / 10);\n}\n\n// ===== W2: Collection =====\nfunction renderCollection(game) {\n  showScreen('collection-screen');\n  const col = game.collection;\n  const progress = col.getProgress();\n\n  document.getElementById('col-progress').textContent = `${progress.collected}/${progress.total} (${progress.percent}%)`;\n\n  const bar = document.getElementById('col-progress-bar');\n  if (bar) bar.style.width = progress.percent + '%';\n\n  // Categories\n  const catContainer = document.getElementById('col-categories');\n  if (catContainer) {\n    const cats = ['全部', ...col.getCategories()];\n    catContainer.innerHTML = cats.map(c =>\n      `<button class=\"cat-btn${col.selectedCategory === (c === '全部' ? null : c) ? ' active' : ''}\" onclick=\"handleCategoryFilter('${c}')\">${c}</button>`\n    ).join('');\n  }\n\n  // Search\n  const searchInput = document.getElementById('col-search');\n  if (searchInput && searchInput.value !== col.searchQuery) {\n    searchInput.value = col.searchQuery;\n  }\n\n  // Idiom grid\n  const grid = document.getElementById('col-grid');\n  if (grid) {\n    const idioms = col.getFilteredIdioms();\n    grid.innerHTML = idioms.slice(0, 60).map(i =>\n      `<div class=\"idiom-card${i.collected ? ' collected' : ''}\" onclick=\"handleIdiomSelect('${i.id}')\">\n        <span class=\"idiom-text\">${i.collected ? i.idiom : '？？？？'}</span>\n        <span class=\"idiom-cat\">${(i.category || [])[0] || ''}</span>\n      </div>`\n    ).join('');\n    if (idioms.length > 60) {\n      grid.innerHTML += `<div class=\"more-hint\">还有${idioms.length - 60}个...</div>`;\n    }\n  }\n\n  // Detail view\n  const detail = document.getElementById('col-detail');\n  if (detail) {\n    if (col.selectedIdiom) {\n      const i = col.selectedIdiom;\n      const collected = game.data.collectedIdioms.includes(i.id);\n      detail.style.display = 'block';\n      detail.innerHTML = `\n        <div class=\"detail-header\">\n          <h3>${collected ? i.idiom : '？？？？'}</h3>\n          <button class=\"btn-back\" onclick=\"game.collection.selectIdiom(null)\">✕</button>\n        </div>\n        ${collected ? `\n          <p class=\"detail-pinyin\">${i.pinyin || ''}</p>\n          <p class=\"detail-meaning\">${i.meaning}</p>\n          ${i.origin ? `<p class=\"detail-origin\">出处：${i.origin}</p>` : ''}\n          ${i.example ? `<p class=\"detail-example\">例句：${i.example}</p>` : ''}\n        ` : '<p class=\"detail-locked\">收集此成语后可查看详情</p>'}\n      `;\n    } else {\n      detail.style.display = 'none';\n    }\n  }\n}\n\n// ===== W2: Daily =====\nfunction renderDaily(game) {\n  showScreen('daily-screen');\n  const ds = game.daily.getDailyState();\n\n  document.getElementById('daily-streak').textContent = ds.loginStreak;\n  document.getElementById('daily-claimed').textContent = ds.todayClaimed ? '已领取' : '未领取';\n  document.getElementById('daily-claim-btn').disabled = ds.todayClaimed;\n  document.getElementById('daily-claim-btn').textContent = ds.todayClaimed ? '已领取 ✓' : `领取签到奖励 (×${Math.min(ds.loginStreak, 7)}0🪙)`;\n\n  // W3: Daily double ad button\n  const dailyDoubleBtn = document.getElementById('daily-double-btn');\n  if (dailyDoubleBtn) {\n    dailyDoubleBtn.style.display = (ds.todayClaimed && !ds.doubled &&\n      game.adManager && game.adManager.canShowRewarded(AD_PLACEMENTS.DAILY_DOUBLE)) ? 'inline-block' : 'none';\n  }\n\n  // Tasks\n  const tasksEl = document.getElementById('daily-tasks');\n  if (tasksEl) {\n    tasksEl.innerHTML = ds.tasks.map(t => `\n      <div class=\"task-item${t.claimed ? ' done' : ''}\">\n        <span class=\"task-desc\">${t.desc}</span>\n        <span class=\"task-progress\">${t.progress}/${t.target}</span>\n        <button class=\"task-btn${t.claimed ? ' claimed' : ''}\"\n          ${t.claimed || t.progress < t.target ? 'disabled' : ''}\n          onclick=\"handleClaimTask('${t.id}')\">\n          ${t.claimed ? '已领' : `${t.reward}🪙`}\n        </button>\n      </div>\n    `).join('');\n  }\n\n  // Challenge\n  const challengeEl = document.getElementById('daily-challenge');\n  if (challengeEl) {\n    if (ds.challengeIdiom) {\n      challengeEl.innerHTML = `\n        <div class=\"challenge-card${ds.challengeCompleted ? ' done' : ''}\">\n          <h4>今日成语挑战</h4>\n          <p class=\"challenge-meaning\">${ds.challengeIdiom.meaning}</p>\n          <p class=\"challenge-hint\">${ds.challengeCompleted ? `答案：${ds.challengeIdiom.idiom}` : '提示：' + ds.challengeIdiom.chars[0] + '？？？'}</p>\n          ${ds.challengeCompleted ?\n            '<span class=\"challenge-done\">已完成 ✓ +50🪙</span>' :\n            `<button class=\"btn btn-primary btn-sm\" onclick=\"handleDailyChallenge()\">挑战</button>`\n          }\n        </div>\n      `;\n    }\n  }\n}\n\n// ===== W2: PK =====\nfunction renderPK(game) {\n  showScreen('pk-screen');\n  const pk = game.pk;\n  const q = pk.currentQ;\n  if (!q) return;\n\n  document.getElementById('pk-progress').textContent = `${pk.currentIndex + 1}/5`;\n\n  const mt = document.getElementById('pk-meaning');\n  if (mt) mt.textContent = q.idiom.meaning;\n\n  const sc = document.getElementById('pk-slots');\n  if (sc) {\n    sc.innerHTML = '';\n    const slots = pk.judge.getSlots();\n    for (let i = 0; i < 4; i++) {\n      const slot = document.createElement('div');\n      slot.className = 'slot';\n      if (slots[i]) { slot.classList.add('filled'); slot.textContent = slots[i].char; slot.onclick = () => pk.removeSlot(i); }\n      if (q.answered && q.correct === true) slot.classList.add('correct');\n      if (q.answered && q.correct === false) slot.classList.add('wrong');\n      sc.appendChild(slot);\n    }\n  }\n\n  const cc = document.getElementById('pk-candidates');\n  if (cc) {\n    cc.innerHTML = '';\n    q.candidates.forEach((c, i) => {\n      const btn = document.createElement('button');\n      btn.className = 'candidate';\n      btn.textContent = c.char;\n      if (c.used) btn.classList.add('used');\n      if (c.removed) btn.classList.add('removed');\n      if (!c.used && !c.removed && !q.answered) btn.onclick = () => pk.pickChar(i);\n      cc.appendChild(btn);\n    });\n  }\n}\n\nfunction renderPKResult(game) {\n  showScreen('pk-result-screen');\n  const r = game.pk.getResult();\n  document.getElementById('pkr-result').textContent = r.won ? '🎉 胜利！' : '😢 惜败';\n  document.getElementById('pkr-correct').textContent = `${r.correctCount}/5`;\n  document.getElementById('pkr-time').textContent = `${(r.time / 1000).toFixed(1)}s`;\n  document.getElementById('pkr-reward').textContent = r.won ? '+50🪙' : '';\n\n  // Answers review\n  const answersEl = document.getElementById('pkr-answers');\n  if (answersEl) {\n    answersEl.innerHTML = r.answers.map((a, i) =>\n      `<div class=\"answer-item${a.correct ? ' correct' : ' wrong'}\">${i+1}. ${a.idiom} ${a.correct ? '✓' : '✗'}</div>`\n    ).join('');\n  }\n}\n\n// ===== W2: Characters =====\nfunction renderCharacters(game) {\n  showScreen('characters-screen');\n  const chars = game.characters.getAll();\n\n  const grid = document.getElementById('char-grid');\n  if (grid) {\n    grid.innerHTML = chars.map(c => {\n      const selected = game.data.data.characters.current === c.id;\n      return `\n        <div class=\"char-card${selected ? ' selected' : ''}${!c.unlocked ? ' locked' : ''}\"\n             onclick=\"${c.unlocked ? `game.characters.select('${c.id}'); game.render()` : ''}\">\n          <div class=\"char-avatar\">${c.unlocked ? c.avatar : '🔒'}</div>\n          <div class=\"char-name\">${c.name}</div>\n          <div class=\"char-skill\">${c.unlocked ? c.skill.name : `通关第${c.unlock.level || '?'}关解锁`}</div>\n          ${selected ? '<div class=\"char-badge\">使用中</div>' : ''}\n        </div>\n      `;\n    }).join('');\n  }\n\n  // Skill detail\n  const current = game.characters.getCurrent();\n  const detail = document.getElementById('char-detail');\n  if (detail) {\n    detail.innerHTML = `\n      <h4>${current.avatar} ${current.name}</h4>\n      <p class=\"skill-name\">${current.skill.name}</p>\n      <p class=\"skill-desc\">${current.skill.desc}</p>\n    `;\n  }\n}\n\n// ===== Global handlers =====\nfunction handleCategoryFilter(cat) {\n  if (cat === '全部') { game.collection.clearFilter(); }\n  else { game.collection.filterByCategory(cat); }\n  game.render();\n}\n\nfunction handleIdiomSelect(id) { game.collection.selectIdiom(id); game.render(); }\n\nfunction handleClaimTask(taskId) { game.daily.claimTask(taskId); game.render(); }\n\nfunction handleDailyChallenge() {\n  const ds = game.daily.getDailyState();\n  if (ds.challengeIdiom && !ds.challengeCompleted) {\n    game.daily.completeChallenge();\n    game.render();\n  }\n}\n\nfunction handleColSearch(val) { game.collection.search(val); game.render(); }\n","numLines":510,"startLine":1,"totalLines":510}}}
