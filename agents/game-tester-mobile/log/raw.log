{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a72181960e6f4e9da54e53d5","type":"tool_result","content":"1\t// InputHandler.js — Touch and mouse input handling for swipe detection\n2\t\n3\tclass InputHandler {\n4\t  constructor(canvas, board) {\n5\t    this.canvas = canvas;\n6\t    this.board = board;\n7\t    this.tileSize = 0;\n8\t    this.boardX = 0;\n9\t    this.boardY = 0;\n10\t\n11\t    this.swipeStart = null;\n12\t    this.selectedTile = null;\n13\t    this.onSwap = null;         // (r1, c1, r2, c2) => void\n14\t    this.onTap = null;          // (row, col) => void\n15\t    this.enabled = true;\n16\t    this.active = true;         // false when nav screens are showing — skip touch interception\n17\t\n18\t    this._bindEvents();\n19\t  }\n20\t\n21\t  updateLayout(tileSize, boardX, boardY) {\n22\t    this.tileSize = tileSize;\n23\t    this.boardX = boardX;\n24\t    this.boardY = boardY;\n25\t  }\n26\t\n27\t  _bindEvents() {\n28\t    // Mouse events\n29\t    this.canvas.addEventListener('mousedown', e => this._onPointerDown(e.clientX, e.clientY));\n30\t    this.canvas.addEventListener('mousemove', e => this._onPointerMove(e.clientX, e.clientY));\n31\t    this.canvas.addEventListener('mouseup', e => this._onPointerUp(e.clientX, e.clientY));\n32\t\n33\t    // Touch events — only intercept when game board is active (not on nav screens)\n34\t    this.canvas.addEventListener('touchstart', e => {\n35\t      if (!this.active) return;\n36\t      e.preventDefault();\n37\t      const t = e.touches[0];\n38\t      this._onPointerDown(t.clientX, t.clientY);\n39\t    }, { passive: false });\n40\t\n41\t    this.canvas.addEventListener('touchmove', e => {\n42\t      if (!this.active) return;\n43\t      e.preventDefault();\n44\t      const t = e.touches[0];\n45\t      this._onPointerMove(t.clientX, t.clientY);\n46\t    }, { passive: false });\n47\t\n48\t    this.canvas.addEventListener('touchend', e => {\n49\t      if (!this.active) return;\n50\t      e.preventDefault();\n51\t      const t = e.changedTouches[0];\n52\t      this._onPointerUp(t.clientX, t.clientY);\n53\t    }, { passive: false });\n54\t  }\n55\t\n56\t  _screenToGrid(x, y) {\n57\t    const col = Math.floor((x - this.boardX) / this.tileSize);\n58\t    const row = Math.floor((y - this.boardY) / this.tileSize);\n59\t    if (row >= 0 && row < this.board.size && col >= 0 && col < this.board.size) {\n60\t      return { row, col };\n61\t    }\n62\t    return null;\n63\t  }\n64\t\n65\t  _onPointerDown(x, y) {\n66\t    if (!this.enabled) return;\n67\t    const cell = this._screenToGrid(x, y);\n68\t    if (!cell) return;\n69\t    this.swipeStart = { x, y, row: cell.row, col: cell.col };\n70\t  }\n71\t\n72\t  _onPointerMove(x, y) {\n73\t    // Could use for drag visualization\n74\t  }\n75\t\n76\t  _onPointerUp(x, y) {\n77\t    if (!this.enabled || !this.swipeStart) return;\n78\t    const start = this.swipeStart;\n79\t    this.swipeStart = null;\n80\t\n81\t    const dx = x - start.x;\n82\t    const dy = y - start.y;\n83\t    const dist = Math.sqrt(dx * dx + dy * dy);\n84\t\n85\t    // Minimum swipe distance threshold\n86\t    if (dist < this.tileSize * 0.2) {\n87\t      // Tap — treat as selection or swap trigger\n88\t      if (this.onTap) this.onTap(start.row, start.col);\n89\t      this._lastInteraction = 'tap';\n90\t      return;\n91\t    }\n92\t\n93\t    this._lastInteraction = 'swipe';\n94\t\n95\t    // Determine swipe direction\n96\t    let targetRow = start.row;\n97\t    let targetCol = start.col;\n98\t    if (Math.abs(dx) > Math.abs(dy)) {\n99\t      targetCol += dx > 0 ? 1 : -1;\n100\t    } else {\n101\t      targetRow += dy > 0 ? 1 : -1;\n102\t    }\n103\t\n104\t    // Validate\n105\t    if (this.board.isValid(targetRow, targetCol)) {\n106\t      if (this.onSwap) {\n107\t        this.onSwap(start.row, start.col, targetRow, targetCol);\n108\t      }\n109\t    }\n110\t  }\n111\t}\n112\t\n113\tif (typeof module !== 'undefined') module.exports = { InputHandler };\n114\t"}]},"parent_tool_use_id":null,"session_id":"7463fb62-2e03-4edd-abad-466ff792dff1","uuid":"79772458-1f74-44e5-b449-fb78f0a83ad8","timestamp":"2026-05-23T10:37:37.479Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-match3/src/js/InputHandler.js","content":"// InputHandler.js — Touch and mouse input handling for swipe detection\n\nclass InputHandler {\n  constructor(canvas, board) {\n    this.canvas = canvas;\n    this.board = board;\n    this.tileSize = 0;\n    this.boardX = 0;\n    this.boardY = 0;\n\n    this.swipeStart = null;\n    this.selectedTile = null;\n    this.onSwap = null;         // (r1, c1, r2, c2) => void\n    this.onTap = null;          // (row, col) => void\n    this.enabled = true;\n    this.active = true;         // false when nav screens are showing — skip touch interception\n\n    this._bindEvents();\n  }\n\n  updateLayout(tileSize, boardX, boardY) {\n    this.tileSize = tileSize;\n    this.boardX = boardX;\n    this.boardY = boardY;\n  }\n\n  _bindEvents() {\n    // Mouse events\n    this.canvas.addEventListener('mousedown', e => this._onPointerDown(e.clientX, e.clientY));\n    this.canvas.addEventListener('mousemove', e => this._onPointerMove(e.clientX, e.clientY));\n    this.canvas.addEventListener('mouseup', e => this._onPointerUp(e.clientX, e.clientY));\n\n    // Touch events — only intercept when game board is active (not on nav screens)\n    this.canvas.addEventListener('touchstart', e => {\n      if (!this.active) return;\n      e.preventDefault();\n      const t = e.touches[0];\n      this._onPointerDown(t.clientX, t.clientY);\n    }, { passive: false });\n\n    this.canvas.addEventListener('touchmove', e => {\n      if (!this.active) return;\n      e.preventDefault();\n      const t = e.touches[0];\n      this._onPointerMove(t.clientX, t.clientY);\n    }, { passive: false });\n\n    this.canvas.addEventListener('touchend', e => {\n      if (!this.active) return;\n      e.preventDefault();\n      const t = e.changedTouches[0];\n      this._onPointerUp(t.clientX, t.clientY);\n    }, { passive: false });\n  }\n\n  _screenToGrid(x, y) {\n    const col = Math.floor((x - this.boardX) / this.tileSize);\n    const row = Math.floor((y - this.boardY) / this.tileSize);\n    if (row >= 0 && row < this.board.size && col >= 0 && col < this.board.size) {\n      return { row, col };\n    }\n    return null;\n  }\n\n  _onPointerDown(x, y) {\n    if (!this.enabled) return;\n    const cell = this._screenToGrid(x, y);\n    if (!cell) return;\n    this.swipeStart = { x, y, row: cell.row, col: cell.col };\n  }\n\n  _onPointerMove(x, y) {\n    // Could use for drag visualization\n  }\n\n  _onPointerUp(x, y) {\n    if (!this.enabled || !this.swipeStart) return;\n    const start = this.swipeStart;\n    this.swipeStart = null;\n\n    const dx = x - start.x;\n    const dy = y - start.y;\n    const dist = Math.sqrt(dx * dx + dy * dy);\n\n    // Minimum swipe distance threshold\n    if (dist < this.tileSize * 0.2) {\n      // Tap — treat as selection or swap trigger\n      if (this.onTap) this.onTap(start.row, start.col);\n      this._lastInteraction = 'tap';\n      return;\n    }\n\n    this._lastInteraction = 'swipe';\n\n    // Determine swipe direction\n    let targetRow = start.row;\n    let targetCol = start.col;\n    if (Math.abs(dx) > Math.abs(dy)) {\n      targetCol += dx > 0 ? 1 : -1;\n    } else {\n      targetRow += dy > 0 ? 1 : -1;\n    }\n\n    // Validate\n    if (this.board.isValid(targetRow, targetCol)) {\n      if (this.onSwap) {\n        this.onSwap(start.row, start.col, targetRow, targetCol);\n      }\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { InputHandler };\n","numLines":114,"startLine":1,"totalLines":114}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_0e76799810cd4ca1b07a4906","type":"tool_result","content":"1\t// Game.js — Main game loop, state machine, integrates all Phase 2+3a systems\n2\t\n3\tconst STATES = {\n4\t  MENU: 'menu',\n5\t  IDLE: 'idle',\n6\t  SWAPPING: 'swapping',\n7\t  MATCHING: 'matching',\n8\t  REMOVING: 'removing',\n9\t  DROPPING: 'dropping',\n10\t  RESULT: 'result',\n11\t  BOSS_SKILL: 'boss_skill',\n12\t};\n13\t\n14\tclass Game {\n15\t  constructor(canvas) {\n16\t    this.canvas = canvas;\n17\t    this.board = new Board();\n18\t    this.matchEngine = new MatchEngine(this.board);\n19\t    this.renderer = new Renderer(canvas);\n20\t    this.input = new InputHandler(canvas, this.board);\n21\t    this.scoreSystem = new ScoreSystem();\n22\t    this.tweens = new TweenManager();\n23\t    this.particles = new ParticleSystem();\n24\t    this.obstacleMgr = new ObstacleManager(this.board);\n25\t    this.audio = new AudioManager();\n26\t    this.boss = null;\n27\t    this.levels = LEVELS;\n28\t    this.currentLevel = 0;\n29\t    this.state = STATES.IDLE;\n30\t    this.comboText = '';\n31\t    this.comboTimer = 0;\n32\t    this.lastTime = 0;\n33\t    this.resultData = null;\n34\t    this.moveCount = 0;\n35\t    this._selectedTile = null;\n36\t\n37\t    // Phase 3a: meta-progression systems\n38\t    this.dataManager = new DataManager();\n39\t    this.coinSystem = new CoinSystem(this.dataManager);\n40\t    this.characterMgr = new CharacterManager();\n41\t    this.mapScreen = new MapScreen(this.dataManager);\n42\t    this.shopUI = new ShopUI(this.coinSystem, this.dataManager);\n43\t    this.nav = new Navigation(this);\n44\t\n45\t    // Phase 3b: daily + social\n46\t    this.dailySystem = new DailySystem(this.dataManager, this.coinSystem);\n47\t    this.socialSystem = new SocialSystem(this.dataManager);\n48\t    this.dailySystem.checkNewDay();\n49\t\n50\t    // Phase 4: ads + analytics\n51\t    this.adManager = new AdManager(this.dataManager);\n52\t    this.analytics = new Analytics(this.dataManager);\n53\t    this.analytics.trackGameStart();\n54\t\n55\t    this.renderer.particleSystem = this.particles;\n56\t\n57\t    this._setupInput();\n58\t    this._setupScoreCallbacks();\n59\t    this._setupObstacleCallbacks();\n60\t  }\n61\t\n62\t  _setupInput() {\n63\t    this.input.onSwap = (r1, c1, r2, c2) => this._handleSwap(r1, c1, r2, c2);\n64\t    this.input.onTap = (row, col) => this._handleTap(row, col);\n65\t  }\n66\t\n67\t  _setupScoreCallbacks() {\n68\t    this.scoreSystem.onLevelComplete = (score, stars) => {\n69\t      this.nav.showResult(true, score, stars, this.currentLevel + 1);\n70\t      this.audio.playLevelWin();\n71\t      // Phase 3b: daily task tracking\n72\t      this.dailySystem.reportEvent('complete_levels', 1);\n73\t      if (stars === 3) this.dailySystem.reportEvent('star3', 1);\n74\t      if (score >= 2000) this.dailySystem.reportEvent('score', score);\n75\t      // Phase 4: analytics + ad success tracking\n76\t      this.analytics.trackLevelComplete(this.currentLevel + 1, score, stars, this.moveCount);\n77\t      this.adManager.reportSuccess();\n78\t    };\n79\t    this.scoreSystem.onLevelFail = (score) => {\n80\t      this.nav.showResult(false, score, 0, this.currentLevel + 1);\n81\t      this.audio.playLevelFail();\n82\t      // Phase 4: analytics + ad fail tracking\n83\t      this.analytics.trackLevelFail(this.currentLevel + 1, score, this.moveCount, this.scoreSystem.getGoalProgress());\n84\t      this.adManager.reportFail();\n85\t    };\n86\t  }\n87\t\n88\t  _setupObstacleCallbacks() {\n89\t    this.obstacleMgr.onObstacleDestroyed = (obs) => {\n90\t      this.scoreSystem.addObstacleCleared(obs.type);\n91\t      this.audio.playObstacleBreak();\n92\t      // Phase 3b: daily obstacle tracking\n93\t      this.dailySystem.reportEvent('clear_obstacle', obs.type);\n94\t      const pos = this.renderer.getTileCenter(obs.row, obs.col);\n95\t      this.particles.emitExplosion(pos.x, pos.y, this._obstacleColor(obs.type), 12);\n96\t    };\n97\t  }\n98\t\n99\t  _obstacleColor(type) {\n100\t    switch (type) {\n101\t      case OBSTACLE_ICE: return '#88CCFF';\n102\t      case OBSTACLE_CHAIN: return '#AAAAAA';\n103\t      case OBSTACLE_CHOCOLATE: return '#8B4513';\n104\t      default: return '#FFFFFF';\n105\t    }\n106\t  }\n107\t\n108\t  start() {\n109\t    this.lastTime = performance.now();\n110\t    this._loop();\n111\t  }\n112\t\n113\t  _loadLevel(idx) {\n114\t    this.currentLevel = idx;\n115\t    const config = this.levels[idx] || this.levels[0];\n116\t    this.board.init();\n117\t    this.scoreSystem.reset(idx + 1);\n118\t    this.scoreSystem.configure(config);\n119\t    this.tweens.clear();\n120\t    this.particles.particles = [];\n121\t    this.renderer.floatingTexts = [];\n122\t    this.comboText = '';\n123\t    this._selectedTile = null;\n124\t    this.resultData = null;\n125\t    this.moveCount = 0;\n126\t\n127\t    // Phase 4: analytics\n128\t    this.analytics.trackLevelStart(idx + 1, config);\n129\t\n130\t    this.obstacleMgr.loadFromConfig(config.obstacles);\n131\t\n132\t    for (const obs of this.obstacleMgr.obstacles) {\n133\t      if (obs.type === OBSTACLE_CHOCOLATE) {\n134\t        this.board.clearCell(obs.row, obs.col);\n135\t      }\n136\t    }\n137\t\n138\t    this.boss = null;\n139\t    if (config.boss) {\n140\t      this.boss = new Boss(config.boss);\n141\t      this.board.clearCell(this.boss.row, this.boss.col);\n142\t    }\n143\t\n144\t    this.board.applyGravity();\n145\t    this.board._removeInitialMatches();\n146\t\n147\t    this.input.updateLayout(\n148\t      this.renderer.tileSize,\n149\t      this.renderer.boardX,\n150\t      this.renderer.boardY,\n151\t    );\n152\t  }\n153\t\n154\t  _handleTap(row, col) {\n155\t    if (this.state !== STATES.IDLE) return;\n156\t    const tile = this.board.getTile(row, col);\n157\t    if (!tile) return;\n158\t\n159\t    this.audio.init();\n160\t\n161\t    if (tile.special === SPECIAL_RAINBOW) {\n162\t      // Rainbow tiles need a target — select and wait for second tap\n163\t      this._selectedTile = { row, col };\n164\t      return;\n165\t    }\n166\t\n167\t    if (this._selectedTile) {\n168\t      const { row: sr, col: sc } = this._selectedTile;\n169\t      this._selectedTile = null;\n170\t      if (this.board.isAdjacent(sr, sc, row, col)) {\n171\t        this._handleSwap(sr, sc, row, col);\n172\t        return;\n173\t      }\n174\t    }\n175\t\n176\t    this._selectedTile = { row, col };\n177\t  }\n178\t\n179\t  _handleSwap(r1, c1, r2, c2) {\n180\t    if (this.state !== STATES.IDLE) return;\n181\t\n182\t    this.audio.init();\n183\t\n184\t    const tileA = this.board.getTile(r1, c1);\n185\t    const tileB = this.board.getTile(r2, c2);\n186\t\n187\t    if (!this.obstacleMgr.canSwap(r1, c1) || !this.obstacleMgr.canSwap(r2, c2)) {\n188\t      this.audio.playInvalid();\n189\t      return;\n190\t    }\n191\t\n192\t    if (tileA && tileA.special === SPECIAL_RAINBOW) {\n193\t      this._activateRainbow(r1, c1, tileB ? tileB.color : 0, r2, c2);\n194\t      return;\n195\t    }\n196\t    if (tileB && tileB.special === SPECIAL_RAINBOW) {\n197\t      this._activateRainbow(r2, c2, tileA ? tileA.color : 0, r1, c1);\n198\t      return;\n199\t    }\n200\t\n201\t    if (!this.matchEngine.isValidSwap(r1, c1, r2, c2)) {\n202\t      this.audio.playInvalid();\n203\t      return;\n204\t    }\n205\t    if (!this.scoreSystem.useMove()) return;\n206\t\n207\t    this.audio.playSwap();\n208\t    this.moveCount++;\n209\t    this.state = STATES.SWAPPING;\n210\t    this.board.swap(r1, c1, r2, c2);\n211\t\n212\t    this._animateSwap(r1, c1, r2, c2, () => {\n213\t      this._processMatches();\n214\t    });\n215\t  }\n216\t\n217\t  _animateSwap(r1, c1, r2, c2, callback) {\n218\t    const tileSize = this.renderer.tileSize;\n219\t    const tileA = this.board.getTile(r2, c2);\n220\t    const tileB = this.board.getTile(r1, c1);\n221\t    const dx = (c2 - c1) * tileSize;\n222\t    const dy = (r2 - r1) * tileSize;\n223\t\n224\t    if (tileA) {\n225\t      tileA.offsetX = -dx;\n226\t      tileA.offsetY = -dy;\n227\t      this.tweens.add(tileA, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n228\t    }\n229\t    if (tileB) {\n230\t      tileB.offsetX = dx;\n231\t      tileB.offsetY = dy;\n232\t      this.tweens.add(tileB, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n233\t    }\n234\t    setTimeout(callback, 160);\n235\t  }\n236\t\n237\t  _activateRainbow(rainbowRow, rainbowCol, targetColor, otherRow, otherCol) {\n238\t    if (!this.scoreSystem.useMove()) return;\n239\t    this.moveCount++;\n240\t    this.audio.playSpecial();\n241\t    this.state = STATES.MATCHING;\n242\t\n243\t    const toRemove = this.matchEngine.triggerRainbow(rainbowRow, rainbowCol, targetColor);\n244\t    toRemove.push({ row: rainbowRow, col: rainbowCol });\n245\t    if (this.board.getTile(otherRow, otherCol)) {\n246\t      toRemove.push({ row: otherRow, col: otherCol });\n247\t    }\n248\t\n249\t    this._removeAndCascade(toRemove, 10);\n250\t  }\n251\t\n252\t  _processMatches() {\n253\t    this.state = STATES.MATCHING;\n254\t    const matches = this.board.findAllMatches();\n255\t\n256\t    if (matches.length === 0) {\n257\t      this._afterMoveComplete();\n258\t      return;\n259\t    }\n260\t\n261\t    this._processChain(0);\n262\t  }\n263\t\n264\t  _processChain(chainCount) {\n265\t    chainCount++;\n266\t    const matches = this.board.findAllMatches();\n267\t    if (matches.length === 0) {\n268\t      this._afterMoveComplete();\n269\t      return;\n270\t    }\n271\t\n272\t    const lShapes = this.board.findLShapeMatches(matches);\n273\t    const { removeCells, specials } = this.matchEngine._classifyMatches(matches, lShapes);\n274\t\n275\t    const multiplier = chainCount <= 1 ? 1 : chainCount === 2 ? 1.5 : chainCount === 3 ? 2.0 : 2.5;\n276\t    const baseScore = removeCells.size * 10;\n277\t    const points = Math.floor(baseScore * multiplier);\n278\t    this.scoreSystem.addScore(points);\n279\t\n280\t    // Phase 3a: character skill — chain bonus\n281\t    this.characterMgr.applySkill(\n282\t      this.dataManager.selectedCharacter,\n283\t      this, 'chain_score', { chainCount },\n284\t    );\n285\t\n286\t    if (chainCount >= 4) this.comboText = '超赞！！';\n287\t    else if (chainCount === 3) this.comboText = '太棒了！';\n288\t    else if (chainCount === 2) this.comboText = '不错！';\n289\t    this.comboTimer = 0.8;\n290\t\n291\t    // Phase 3b: daily chain tracking\n292\t    this.dailySystem.reportEvent('chain', 1);\n293\t\n294\t    this.audio.playMatch(chainCount);\n295\t    if (chainCount >= 2) this.audio.playCombo(chainCount);\n296\t\n297\t    // Collect matched positions\n298\t    const matchedPositions = [];\n299\t    for (const key of removeCells) {\n300\t      const [r, c] = key.split(',').map(Number);\n301\t      const tile = this.board.getTile(r, c);\n302\t      if (tile && tile.color >= 0) {\n303\t        this.scoreSystem.addCollected(tile.color, 1);\n304\t      }\n305\t      matchedPositions.push({ row: r, col: c });\n306\t    }\n307\t\n308\t    // Phase 3a: character skill — lucky special\n309\t    const matchCells = [];\n310\t    for (const key of removeCells) {\n311\t      const [r, c] = key.split(',').map(Number);\n312\t      matchCells.push({ row: r, col: c });\n313\t    }\n314\t    this.characterMgr.applySkill(\n315\t      this.dataManager.selectedCharacter,\n316\t      this, 'match_created', { cells: matchCells },\n317\t    );\n318\t\n319\t    // Create specials\n320\t    const specialPositions = new Set(specials.map(s => `${s.row},${s.col}`));\n321\t    for (const sp of specials) {\n322\t      const tile = this.board.getTile(sp.row, sp.col);\n323\t      if (tile) {\n324\t        tile.special = sp.type;\n325\t        tile.removing = false;\n326\t      }\n327\t    }\n328\t\n329\t    // Animate removal\n330\t    this.state = STATES.REMOVING;\n331\t    const toAnimate = [];\n332\t    for (const key of removeCells) {\n333\t      if (specialPositions.has(key)) continue;\n334\t      const [r, c] = key.split(',').map(Number);\n335\t      const tile = this.board.getTile(r, c);\n336\t      if (tile) {\n337\t        const pos = this.renderer.getTileCenter(r, c);\n338\t        const color = COLOR_MAP[tile.color];\n339\t        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 8);\n340\t        this.renderer.addFloatingText(`+${points}`, pos.x, pos.y);\n341\t        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n342\t        toAnimate.push(tile);\n343\t      }\n344\t    }\n345\t\n346\t    setTimeout(() => {\n347\t      for (const key of removeCells) {\n348\t        if (specialPositions.has(key)) continue;\n349\t        const [r, c] = key.split(',').map(Number);\n350\t        this.board.clearCell(r, c);\n351\t      }\n352\t\n353\t      for (const sp of specials) {\n354\t        this._triggerSpecialEffects(sp.row, sp.col, sp.type);\n355\t      }\n356\t\n357\t      this.obstacleMgr.onTilesMatched(matchedPositions);\n358\t\n359\t      if (this.boss && this.boss.active) {\n360\t        const dmg = this.boss.calculateDamage(matchedPositions);\n361\t        if (dmg > 0) {\n362\t          const defeated = this.boss.takeDamage(dmg);\n363\t          this.audio.playBossHit();\n364\t          if (defeated) {\n365\t            this.audio.playBossDefeat();\n366\t            this.scoreSystem.addScore(500);\n367\t          }\n368\t        }\n369\t      }\n370\t\n371\t      this.state = STATES.DROPPING;\n372\t      const drops = this.board.applyGravity();\n373\t\n374\t      for (const drop of drops) {\n375\t        const tile = drop.tile;\n376\t        const fromY = drop.fromRow * this.renderer.tileSize;\n377\t        const toY = drop.toRow * this.renderer.tileSize;\n378\t        tile.offsetY = fromY - toY;\n379\t        this.tweens.add(tile, { offsetY: 0 }, 0.2 + drop.distance * 0.03, 'easeOutBounce');\n380\t      }\n381\t\n382\t      setTimeout(() => {\n383\t        this._processChain(chainCount);\n384\t      }, 350);\n385\t    }, 280);\n386\t  }\n387\t\n388\t  _afterMoveComplete() {\n389\t    if (this.boss && this.boss.isDefeated() && this.scoreSystem.goalType === 'boss') {\n390\t      this.nav.showResult(true, this.scoreSystem.score, this.scoreSystem.getStarCount(), this.currentLevel + 1);\n391\t      this.audio.playLevelWin();\n392\t      return;\n393\t    }\n394\t\n395\t    this.obstacleMgr.spreadChocolate();\n396\t\n397\t    // Phase 3a: character skill — auto obstacle clear\n398\t    this.characterMgr.applySkill(\n399\t      this.dataManager.selectedCharacter,\n400\t      this, 'after_move', null,\n401\t    );\n402\t\n403\t    if (this.boss && this.boss.active) {\n404\t      const ability = this.boss.tryUseAbility();\n405\t      if (ability) {\n406\t        this._executeBossAbility(ability);\n407\t      }\n408\t    }\n409\t\n410\t    this.state = STATES.IDLE;\n411\t\n412\t    if (!this.board.hasValidMoves(this.obstacleMgr)) {\n413\t      this.board.shuffle();\n414\t    }\n415\t\n416\t    this.scoreSystem.checkState();\n417\t  }\n418\t\n419\t  _executeBossAbility(ability) {\n420\t    this.audio.playBossAbility();\n421\t\n422\t    switch (ability) {\n423\t      case 'freeze': {\n424\t        const candidates = [];\n425\t        for (let r = 0; r < this.board.size; r++) {\n426\t          for (let c = 0; c < this.board.size; c++) {\n427\t            if (!this.obstacleMgr.hasObstacle(r, c) && this.board.getTile(r, c)) {\n428\t              if (this.boss && r === this.boss.row && c === this.boss.col) continue;\n429\t              candidates.push({ row: r, col: c });\n430\t            }\n431\t          }\n432\t        }\n433\t        const count = Math.min(2, candidates.length);\n434\t        for (let i = 0; i < count; i++) {\n435\t          const idx = Math.floor(Math.random() * candidates.length);\n436\t          const target = candidates.splice(idx, 1)[0];\n437\t          this.obstacleMgr.addObstacle(OBSTACLE_ICE, target.row, target.col);\n438\t        }\n439\t        break;\n440\t      }\n441\t      case 'chain': {\n442\t        const candidates = [];\n443\t        for (let r = 0; r < this.board.size; r++) {\n444\t          for (let c = 0; c < this.board.size; c++) {\n445\t            if (!this.obstacleMgr.hasObstacle(r, c) && this.board.getTile(r, c)) {\n446\t              if (this.boss && r === this.boss.row && c === this.boss.col) continue;\n447\t              candidates.push({ row: r, col: c });\n448\t            }\n449\t          }\n450\t        }\n451\t        if (candidates.length > 0) {\n452\t          const idx = Math.floor(Math.random() * candidates.length);\n453\t          const target = candidates[idx];\n454\t          this.obstacleMgr.addObstacle(OBSTACLE_CHAIN, target.row, target.col);\n455\t        }\n456\t        break;\n457\t      }\n458\t      case 'chocolate': {\n459\t        const dirs = [[-1,0],[1,0],[0,-1],[0,1]];\n460\t        const candidates = [];\n461\t        for (const [dr, dc] of dirs) {\n462\t          const nr = this.boss.row + dr;\n463\t          const nc = this.boss.col + dc;\n464\t          if (this.board.isValid(nr, nc) && !this.obstacleMgr.hasObstacle(nr, nc)) {\n465\t            candidates.push({ row: nr, col: nc });\n466\t          }\n467\t        }\n468\t        if (candidates.length > 0) {\n469\t          const target = candidates[Math.floor(Math.random() * candidates.length)];\n470\t          this.obstacleMgr.addObstacle(OBSTACLE_CHOCOLATE, target.row, target.col);\n471\t        }\n472\t        break;\n473\t      }\n474\t    }\n475\t  }\n476\t\n477\t  _triggerSpecialEffects(row, col, type) {\n478\t    const pos = this.renderer.getTileCenter(row, col);\n479\t    const tile = this.board.getTile(row, col);\n480\t    const color = tile ? COLOR_MAP[tile.color]?.hex : '#FFB800';\n481\t\n482\t    this.audio.playSpecial();\n483\t\n484\t    switch (type) {\n485\t      case 1: case 2:\n486\t        this.particles.emitExplosion(pos.x, pos.y, color || '#FFB800', 20);\n487\t        break;\n488\t      case 3:\n489\t        this.particles.emitExplosion(pos.x, pos.y, '#FF9A3C', 30);\n490\t        break;\n491\t      case 4:\n492\t        for (let i = 0; i < 40; i++) {\n493\t          this.particles.emitExplosion(pos.x, pos.y, '#FFB800', 2);\n494\t        }\n495\t        break;\n496\t    }\n497\t  }\n498\t\n499\t  _removeAndCascade(cells, scorePerCell) {\n500\t    this.state = STATES.REMOVING;\n501\t    const points = cells.length * scorePerCell;\n502\t    this.scoreSystem.addScore(points);\n503\t\n504\t    for (const { row, col } of cells) {\n505\t      const tile = this.board.getTile(row, col);\n506\t      if (tile && tile.color >= 0) {\n507\t        this.scoreSystem.addCollected(tile.color, 1);\n508\t      }\n509\t    }\n510\t\n511\t    for (const { row, col } of cells) {\n512\t      const tile = this.board.getTile(row, col);\n513\t      if (tile) {\n514\t        const pos = this.renderer.getTileCenter(row, col);\n515\t        const color = COLOR_MAP[tile.color];\n516\t        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 6);\n517\t        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n518\t      }\n519\t    }\n520\t\n521\t    setTimeout(() => {\n522\t      for (const { row, col } of cells) {\n523\t        this.board.clearCell(row, col);\n524\t      }\n525\t\n526\t      this.obstacleMgr.onTilesMatched(cells);\n527\t\n528\t      if (this.boss && this.boss.active) {\n529\t        const dmg = this.boss.calculateDamage(cells);\n530\t        if (dmg > 0) {\n531\t          const defeated = this.boss.takeDamage(dmg);\n532\t          this.audio.playBossHit();\n533\t          if (defeated) {\n534\t            this.audio.playBossDefeat();\n535\t            this.scoreSystem.addScore(500);\n536\t          }\n537\t        }\n538\t      }\n539\t\n540\t      const drops = this.board.applyGravity();\n541\t\n542\t      for (const drop of drops) {\n543\t        const tile = drop.tile;\n544\t        const fromY = drop.fromRow * this.renderer.tileSize;\n545\t        const toY = drop.toRow * this.renderer.tileSize;\n546\t        tile.offsetY = fromY - toY;\n547\t        this.tweens.add(tile, { offsetY: 0 }, 0.2 + drop.distance * 0.03, 'easeOutBounce');\n548\t      }\n549\t\n550\t      this.state = STATES.IDLE;\n551\t      setTimeout(() => this._processMatches(), 350);\n552\t    }, 300);\n553\t  }\n554\t\n555\t  _loop() {\n556\t    const now = performance.now();\n557\t    const dt = Math.min((now - this.lastTime) / 1000, 0.05);\n558\t    this.lastTime = now;\n559\t\n560\t    // Phase 3a: Navigation screens take priority\n561\t    if (this.nav.isActive()) {\n562\t      this.nav.render(this.renderer.ctx, this.renderer.screenW, this.renderer.screenH);\n563\t      // Phase 4: ad stub overlay on top of navigation\n564\t      this.adManager.renderStubAd(this.renderer.ctx, this.renderer.screenW, this.renderer.screenH);\n565\t      requestAnimationFrame(() => this._loop());\n566\t      return;\n567\t    }\n568\t\n569\t    this.update(dt);\n570\t    this.render();\n571\t    // Phase 4: ad stub overlay on top of gameplay\n572\t    this.adManager.renderStubAd(this.renderer.ctx, this.renderer.screenW, this.renderer.screenH);\n573\t    requestAnimationFrame(() => this._loop());\n574\t  }\n575\t\n576\t  update(dt) {\n577\t    this.tweens.update(dt);\n578\t    this.particles.update(dt);\n579\t    this.obstacleMgr.update(dt);\n580\t    if (this.boss) this.boss.update(dt);\n581\t    // Phase 4: ad stub timer\n582\t    this.adManager.update(dt);\n583\t\n584\t    if (this.comboTimer > 0) {\n585\t      this.comboTimer -= dt;\n586\t      if (this.comboTimer <= 0) this.comboText = '';\n587\t    }\n588\t\n589\t    this.input.enabled = this.state === STATES.IDLE;\n590\t  }\n591\t\n592\t  render() {\n593\t    this.renderer.clear();\n594\t    this.renderer.drawBackground();\n595\t\n596\t    for (let r = 0; r < this.board.size; r++) {\n597\t      for (let c = 0; c < this.board.size; c++) {\n598\t        const tile = this.board.getTile(r, c);\n599\t        if (tile) {\n600\t          if (this._selectedTile && this._selectedTile.row === r && this._selectedTile.col === c) {\n601\t            tile.selected = true;\n602\t          } else {\n603\t            tile.selected = false;\n604\t          }\n605\t          this.renderer.drawTile(tile);\n606\t        }\n607\t      }\n608\t    }\n609\t\n610\t    this.renderer.drawObstacles(this.obstacleMgr);\n611\t\n612\t    if (this.boss && this.boss.active) {\n613\t      this.renderer.drawBoss(this.boss, this.renderer);\n614\t    }\n615\t\n616\t    this.particles.draw(this.renderer.ctx);\n617\t    this.renderer.updateAndDrawFloatingTexts(1 / 60);\n618\t\n619\t    const config = this.levels[this.currentLevel] || this.levels[0];\n620\t    this.renderer.drawUI(\n621\t      this.scoreSystem.score,\n622\t      this.scoreSystem.getRemainingMoves(),\n623\t      config,\n624\t      this.scoreSystem,\n625\t      this.currentLevel + 1,\n626\t    );\n627\t\n628\t    if (this.comboText) {\n629\t      this.renderer.drawComboText(this.comboText);\n630\t    }\n631\t\n632\t    if (this.boss && this.boss.active) {\n633\t      this.renderer.drawBossHealthBar(this.boss);\n634\t    }\n635\t\n636\t    // Phase 3a: back-to-map button during gameplay\n637\t    this._drawBackButton();\n638\t\n639\t    // Result screen is now handled by Navigation\n640\t  }\n641\t\n642\t  _drawBackButton() {\n643\t    const ctx = this.renderer.ctx;\n644\t    const w = this.renderer.screenW;\n645\t    ctx.fillStyle = '#8D6E6399';\n646\t    this.renderer._roundRect(ctx, w - 50, this.renderer.boardY + this.renderer.tileSize * BOARD_SIZE + 25, 40, 28, 14);\n647\t    ctx.fill();\n648\t    ctx.fillStyle = '#FFF';\n649\t    ctx.font = 'bold 12px sans-serif';\n650\t    ctx.textAlign = 'center';\n651\t    ctx.fillText('地图', w - 30, this.renderer.boardY + this.renderer.tileSize * BOARD_SIZE + 44);\n652\t  }\n653\t\n654\t  retry() {\n655\t    this._loadLevel(this.currentLevel);\n656\t    this.state = STATES.IDLE;\n657\t  }\n658\t\n659\t  nextLevel() {\n660\t    const next = this.currentLevel + 1;\n661\t    if (next < this.levels.length) {\n662\t      this._loadLevel(next);\n663\t      this.state = STATES.IDLE;\n664\t    } else {\n665\t      this._loadLevel(0);\n666\t      this.state = STATES.IDLE;\n667\t    }\n668\t  }\n669\t}\n670\t\n671\tif (typeof module !== 'undefined') module.exports = { Game, STATES };\n672\t"}]},"parent_tool_use_id":null,"session_id":"7463fb62-2e03-4edd-abad-466ff792dff1","uuid":"63247959-72d7-4a6e-b8c4-905bd7cc0b13","timestamp":"2026-05-23T10:37:38.726Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-match3/src/js/Game.js","content":"// Game.js — Main game loop, state machine, integrates all Phase 2+3a systems\n\nconst STATES = {\n  MENU: 'menu',\n  IDLE: 'idle',\n  SWAPPING: 'swapping',\n  MATCHING: 'matching',\n  REMOVING: 'removing',\n  DROPPING: 'dropping',\n  RESULT: 'result',\n  BOSS_SKILL: 'boss_skill',\n};\n\nclass Game {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.board = new Board();\n    this.matchEngine = new MatchEngine(this.board);\n    this.renderer = new Renderer(canvas);\n    this.input = new InputHandler(canvas, this.board);\n    this.scoreSystem = new ScoreSystem();\n    this.tweens = new TweenManager();\n    this.particles = new ParticleSystem();\n    this.obstacleMgr = new ObstacleManager(this.board);\n    this.audio = new AudioManager();\n    this.boss = null;\n    this.levels = LEVELS;\n    this.currentLevel = 0;\n    this.state = STATES.IDLE;\n    this.comboText = '';\n    this.comboTimer = 0;\n    this.lastTime = 0;\n    this.resultData = null;\n    this.moveCount = 0;\n    this._selectedTile = null;\n\n    // Phase 3a: meta-progression systems\n    this.dataManager = new DataManager();\n    this.coinSystem = new CoinSystem(this.dataManager);\n    this.characterMgr = new CharacterManager();\n    this.mapScreen = new MapScreen(this.dataManager);\n    this.shopUI = new ShopUI(this.coinSystem, this.dataManager);\n    this.nav = new Navigation(this);\n\n    // Phase 3b: daily + social\n    this.dailySystem = new DailySystem(this.dataManager, this.coinSystem);\n    this.socialSystem = new SocialSystem(this.dataManager);\n    this.dailySystem.checkNewDay();\n\n    // Phase 4: ads + analytics\n    this.adManager = new AdManager(this.dataManager);\n    this.analytics = new Analytics(this.dataManager);\n    this.analytics.trackGameStart();\n\n    this.renderer.particleSystem = this.particles;\n\n    this._setupInput();\n    this._setupScoreCallbacks();\n    this._setupObstacleCallbacks();\n  }\n\n  _setupInput() {\n    this.input.onSwap = (r1, c1, r2, c2) => this._handleSwap(r1, c1, r2, c2);\n    this.input.onTap = (row, col) => this._handleTap(row, col);\n  }\n\n  _setupScoreCallbacks() {\n    this.scoreSystem.onLevelComplete = (score, stars) => {\n      this.nav.showResult(true, score, stars, this.currentLevel + 1);\n      this.audio.playLevelWin();\n      // Phase 3b: daily task tracking\n      this.dailySystem.reportEvent('complete_levels', 1);\n      if (stars === 3) this.dailySystem.reportEvent('star3', 1);\n      if (score >= 2000) this.dailySystem.reportEvent('score', score);\n      // Phase 4: analytics + ad success tracking\n      this.analytics.trackLevelComplete(this.currentLevel + 1, score, stars, this.moveCount);\n      this.adManager.reportSuccess();\n    };\n    this.scoreSystem.onLevelFail = (score) => {\n      this.nav.showResult(false, score, 0, this.currentLevel + 1);\n      this.audio.playLevelFail();\n      // Phase 4: analytics + ad fail tracking\n      this.analytics.trackLevelFail(this.currentLevel + 1, score, this.moveCount, this.scoreSystem.getGoalProgress());\n      this.adManager.reportFail();\n    };\n  }\n\n  _setupObstacleCallbacks() {\n    this.obstacleMgr.onObstacleDestroyed = (obs) => {\n      this.scoreSystem.addObstacleCleared(obs.type);\n      this.audio.playObstacleBreak();\n      // Phase 3b: daily obstacle tracking\n      this.dailySystem.reportEvent('clear_obstacle', obs.type);\n      const pos = this.renderer.getTileCenter(obs.row, obs.col);\n      this.particles.emitExplosion(pos.x, pos.y, this._obstacleColor(obs.type), 12);\n    };\n  }\n\n  _obstacleColor(type) {\n    switch (type) {\n      case OBSTACLE_ICE: return '#88CCFF';\n      case OBSTACLE_CHAIN: return '#AAAAAA';\n      case OBSTACLE_CHOCOLATE: return '#8B4513';\n      default: return '#FFFFFF';\n    }\n  }\n\n  start() {\n    this.lastTime = performance.now();\n    this._loop();\n  }\n\n  _loadLevel(idx) {\n    this.currentLevel = idx;\n    const config = this.levels[idx] || this.levels[0];\n    this.board.init();\n    this.scoreSystem.reset(idx + 1);\n    this.scoreSystem.configure(config);\n    this.tweens.clear();\n    this.particles.particles = [];\n    this.renderer.floatingTexts = [];\n    this.comboText = '';\n    this._selectedTile = null;\n    this.resultData = null;\n    this.moveCount = 0;\n\n    // Phase 4: analytics\n    this.analytics.trackLevelStart(idx + 1, config);\n\n    this.obstacleMgr.loadFromConfig(config.obstacles);\n\n    for (const obs of this.obstacleMgr.obstacles) {\n      if (obs.type === OBSTACLE_CHOCOLATE) {\n        this.board.clearCell(obs.row, obs.col);\n      }\n    }\n\n    this.boss = null;\n    if (config.boss) {\n      this.boss = new Boss(config.boss);\n      this.board.clearCell(this.boss.row, this.boss.col);\n    }\n\n    this.board.applyGravity();\n    this.board._removeInitialMatches();\n\n    this.input.updateLayout(\n      this.renderer.tileSize,\n      this.renderer.boardX,\n      this.renderer.boardY,\n    );\n  }\n\n  _handleTap(row, col) {\n    if (this.state !== STATES.IDLE) return;\n    const tile = this.board.getTile(row, col);\n    if (!tile) return;\n\n    this.audio.init();\n\n    if (tile.special === SPECIAL_RAINBOW) {\n      // Rainbow tiles need a target — select and wait for second tap\n      this._selectedTile = { row, col };\n      return;\n    }\n\n    if (this._selectedTile) {\n      const { row: sr, col: sc } = this._selectedTile;\n      this._selectedTile = null;\n      if (this.board.isAdjacent(sr, sc, row, col)) {\n        this._handleSwap(sr, sc, row, col);\n        return;\n      }\n    }\n\n    this._selectedTile = { row, col };\n  }\n\n  _handleSwap(r1, c1, r2, c2) {\n    if (this.state !== STATES.IDLE) return;\n\n    this.audio.init();\n\n    const tileA = this.board.getTile(r1, c1);\n    const tileB = this.board.getTile(r2, c2);\n\n    if (!this.obstacleMgr.canSwap(r1, c1) || !this.obstacleMgr.canSwap(r2, c2)) {\n      this.audio.playInvalid();\n      return;\n    }\n\n    if (tileA && tileA.special === SPECIAL_RAINBOW) {\n      this._activateRainbow(r1, c1, tileB ? tileB.color : 0, r2, c2);\n      return;\n    }\n    if (tileB && tileB.special === SPECIAL_RAINBOW) {\n      this._activateRainbow(r2, c2, tileA ? tileA.color : 0, r1, c1);\n      return;\n    }\n\n    if (!this.matchEngine.isValidSwap(r1, c1, r2, c2)) {\n      this.audio.playInvalid();\n      return;\n    }\n    if (!this.scoreSystem.useMove()) return;\n\n    this.audio.playSwap();\n    this.moveCount++;\n    this.state = STATES.SWAPPING;\n    this.board.swap(r1, c1, r2, c2);\n\n    this._animateSwap(r1, c1, r2, c2, () => {\n      this._processMatches();\n    });\n  }\n\n  _animateSwap(r1, c1, r2, c2, callback) {\n    const tileSize = this.renderer.tileSize;\n    const tileA = this.board.getTile(r2, c2);\n    const tileB = this.board.getTile(r1, c1);\n    const dx = (c2 - c1) * tileSize;\n    const dy = (r2 - r1) * tileSize;\n\n    if (tileA) {\n      tileA.offsetX = -dx;\n      tileA.offsetY = -dy;\n      this.tweens.add(tileA, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n    }\n    if (tileB) {\n      tileB.offsetX = dx;\n      tileB.offsetY = dy;\n      this.tweens.add(tileB, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n    }\n    setTimeout(callback, 160);\n  }\n\n  _activateRainbow(rainbowRow, rainbowCol, targetColor, otherRow, otherCol) {\n    if (!this.scoreSystem.useMove()) return;\n    this.moveCount++;\n    this.audio.playSpecial();\n    this.state = STATES.MATCHING;\n\n    const toRemove = this.matchEngine.triggerRainbow(rainbowRow, rainbowCol, targetColor);\n    toRemove.push({ row: rainbowRow, col: rainbowCol });\n    if (this.board.getTile(otherRow, otherCol)) {\n      toRemove.push({ row: otherRow, col: otherCol });\n    }\n\n    this._removeAndCascade(toRemove, 10);\n  }\n\n  _processMatches() {\n    this.state = STATES.MATCHING;\n    const matches = this.board.findAllMatches();\n\n    if (matches.length === 0) {\n      this._afterMoveComplete();\n      return;\n    }\n\n    this._processChain(0);\n  }\n\n  _processChain(chainCount) {\n    chainCount++;\n    const matches = this.board.findAllMatches();\n    if (matches.length === 0) {\n      this._afterMoveComplete();\n      return;\n    }\n\n    const lShapes = this.board.findLShapeMatches(matches);\n    const { removeCells, specials } = this.matchEngine._classifyMatches(matches, lShapes);\n\n    const multiplier = chainCount <= 1 ? 1 : chainCount === 2 ? 1.5 : chainCount === 3 ? 2.0 : 2.5;\n    const baseScore = removeCells.size * 10;\n    const points = Math.floor(baseScore * multiplier);\n    this.scoreSystem.addScore(points);\n\n    // Phase 3a: character skill — chain bonus\n    this.characterMgr.applySkill(\n      this.dataManager.selectedCharacter,\n      this, 'chain_score', { chainCount },\n    );\n\n    if (chainCount >= 4) this.comboText = '超赞！！';\n    else if (chainCount === 3) this.comboText = '太棒了！';\n    else if (chainCount === 2) this.comboText = '不错！';\n    this.comboTimer = 0.8;\n\n    // Phase 3b: daily chain tracking\n    this.dailySystem.reportEvent('chain', 1);\n\n    this.audio.playMatch(chainCount);\n    if (chainCount >= 2) this.audio.playCombo(chainCount);\n\n    // Collect matched positions\n    const matchedPositions = [];\n    for (const key of removeCells) {\n      const [r, c] = key.split(',').map(Number);\n      const tile = this.board.getTile(r, c);\n      if (tile && tile.color >= 0) {\n        this.scoreSystem.addCollected(tile.color, 1);\n      }\n      matchedPositions.push({ row: r, col: c });\n    }\n\n    // Phase 3a: character skill — lucky special\n    const matchCells = [];\n    for (const key of removeCells) {\n      const [r, c] = key.split(',').map(Number);\n      matchCells.push({ row: r, col: c });\n    }\n    this.characterMgr.applySkill(\n      this.dataManager.selectedCharacter,\n      this, 'match_created', { cells: matchCells },\n    );\n\n    // Create specials\n    const specialPositions = new Set(specials.map(s => `${s.row},${s.col}`));\n    for (const sp of specials) {\n      const tile = this.board.getTile(sp.row, sp.col);\n      if (tile) {\n        tile.special = sp.type;\n        tile.removing = false;\n      }\n    }\n\n    // Animate removal\n    this.state = STATES.REMOVING;\n    const toAnimate = [];\n    for (const key of removeCells) {\n      if (specialPositions.has(key)) continue;\n      const [r, c] = key.split(',').map(Number);\n      const tile = this.board.getTile(r, c);\n      if (tile) {\n        const pos = this.renderer.getTileCenter(r, c);\n        const color = COLOR_MAP[tile.color];\n        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 8);\n        this.renderer.addFloatingText(`+${points}`, pos.x, pos.y);\n        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n        toAnimate.push(tile);\n      }\n    }\n\n    setTimeout(() => {\n      for (const key of removeCells) {\n        if (specialPositions.has(key)) continue;\n        const [r, c] = key.split(',').map(Number);\n        this.board.clearCell(r, c);\n      }\n\n      for (const sp of specials) {\n        this._triggerSpecialEffects(sp.row, sp.col, sp.type);\n      }\n\n      this.obstacleMgr.onTilesMatched(matchedPositions);\n\n      if (this.boss && this.boss.active) {\n        const dmg = this.boss.calculateDamage(matchedPositions);\n        if (dmg > 0) {\n          const defeated = this.boss.takeDamage(dmg);\n          this.audio.playBossHit();\n          if (defeated) {\n            this.audio.playBossDefeat();\n            this.scoreSystem.addScore(500);\n          }\n        }\n      }\n\n      this.state = STATES.DROPPING;\n      const drops = this.board.applyGravity();\n\n      for (const drop of drops) {\n        const tile = drop.tile;\n        const fromY = drop.fromRow * this.renderer.tileSize;\n        const toY = drop.toRow * this.renderer.tileSize;\n        tile.offsetY = fromY - toY;\n        this.tweens.add(tile, { offsetY: 0 }, 0.2 + drop.distance * 0.03, 'easeOutBounce');\n      }\n\n      setTimeout(() => {\n        this._processChain(chainCount);\n      }, 350);\n    }, 280);\n  }\n\n  _afterMoveComplete() {\n    if (this.boss && this.boss.isDefeated() && this.scoreSystem.goalType === 'boss') {\n      this.nav.showResult(true, this.scoreSystem.score, this.scoreSystem.getStarCount(), this.currentLevel + 1);\n      this.audio.playLevelWin();\n      return;\n    }\n\n    this.obstacleMgr.spreadChocolate();\n\n    // Phase 3a: character skill — auto obstacle clear\n    this.characterMgr.applySkill(\n      this.dataManager.selectedCharacter,\n      this, 'after_move', null,\n    );\n\n    if (this.boss && this.boss.active) {\n      const ability = this.boss.tryUseAbility();\n      if (ability) {\n        this._executeBossAbility(ability);\n      }\n    }\n\n    this.state = STATES.IDLE;\n\n    if (!this.board.hasValidMoves(this.obstacleMgr)) {\n      this.board.shuffle();\n    }\n\n    this.scoreSystem.checkState();\n  }\n\n  _executeBossAbility(ability) {\n    this.audio.playBossAbility();\n\n    switch (ability) {\n      case 'freeze': {\n        const candidates = [];\n        for (let r = 0; r < this.board.size; r++) {\n          for (let c = 0; c < this.board.size; c++) {\n            if (!this.obstacleMgr.hasObstacle(r, c) && this.board.getTile(r, c)) {\n              if (this.boss && r === this.boss.row && c === this.boss.col) continue;\n              candidates.push({ row: r, col: c });\n            }\n          }\n        }\n        const count = Math.min(2, candidates.length);\n        for (let i = 0; i < count; i++) {\n          const idx = Math.floor(Math.random() * candidates.length);\n          const target = candidates.splice(idx, 1)[0];\n          this.obstacleMgr.addObstacle(OBSTACLE_ICE, target.row, target.col);\n        }\n        break;\n      }\n      case 'chain': {\n        const candidates = [];\n        for (let r = 0; r < this.board.size; r++) {\n          for (let c = 0; c < this.board.size; c++) {\n            if (!this.obstacleMgr.hasObstacle(r, c) && this.board.getTile(r, c)) {\n              if (this.boss && r === this.boss.row && c === this.boss.col) continue;\n              candidates.push({ row: r, col: c });\n            }\n          }\n        }\n        if (candidates.length > 0) {\n          const idx = Math.floor(Math.random() * candidates.length);\n          const target = candidates[idx];\n          this.obstacleMgr.addObstacle(OBSTACLE_CHAIN, target.row, target.col);\n        }\n        break;\n      }\n      case 'chocolate': {\n        const dirs = [[-1,0],[1,0],[0,-1],[0,1]];\n        const candidates = [];\n        for (const [dr, dc] of dirs) {\n          const nr = this.boss.row + dr;\n          const nc = this.boss.col + dc;\n          if (this.board.isValid(nr, nc) && !this.obstacleMgr.hasObstacle(nr, nc)) {\n            candidates.push({ row: nr, col: nc });\n          }\n        }\n        if (candidates.length > 0) {\n          const target = candidates[Math.floor(Math.random() * candidates.length)];\n          this.obstacleMgr.addObstacle(OBSTACLE_CHOCOLATE, target.row, target.col);\n        }\n        break;\n      }\n    }\n  }\n\n  _triggerSpecialEffects(row, col, type) {\n    const pos = this.renderer.getTileCenter(row, col);\n    const tile = this.board.getTile(row, col);\n    const color = tile ? COLOR_MAP[tile.color]?.hex : '#FFB800';\n\n    this.audio.playSpecial();\n\n    switch (type) {\n      case 1: case 2:\n        this.particles.emitExplosion(pos.x, pos.y, color || '#FFB800', 20);\n        break;\n      case 3:\n        this.particles.emitExplosion(pos.x, pos.y, '#FF9A3C', 30);\n        break;\n      case 4:\n        for (let i = 0; i < 40; i++) {\n          this.particles.emitExplosion(pos.x, pos.y, '#FFB800', 2);\n        }\n        break;\n    }\n  }\n\n  _removeAndCascade(cells, scorePerCell) {\n    this.state = STATES.REMOVING;\n    const points = cells.length * scorePerCell;\n    this.scoreSystem.addScore(points);\n\n    for (const { row, col } of cells) {\n      const tile = this.board.getTile(row, col);\n      if (tile && tile.color >= 0) {\n        this.scoreSystem.addCollected(tile.color, 1);\n      }\n    }\n\n    for (const { row, col } of cells) {\n      const tile = this.board.getTile(row, col);\n      if (tile) {\n        const pos = this.renderer.getTileCenter(row, col);\n        const color = COLOR_MAP[tile.color];\n        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 6);\n        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n      }\n    }\n\n    setTimeout(() => {\n      for (const { row, col } of cells) {\n        this.board.clearCell(row, col);\n      }\n\n      this.obstacleMgr.onTilesMatched(cells);\n\n      if (this.boss && this.boss.active) {\n        const dmg = this.boss.calculateDamage(cells);\n        if (dmg > 0) {\n          const defeated = this.boss.takeDamage(dmg);\n          this.audio.playBossHit();\n          if (defeated) {\n            this.audio.playBossDefeat();\n            this.scoreSystem.addScore(500);\n          }\n        }\n      }\n\n      const drops = this.board.applyGravity();\n\n      for (const drop of drops) {\n        const tile = drop.tile;\n        const fromY = drop.fromRow * this.renderer.tileSize;\n        const toY = drop.toRow * this.renderer.tileSize;\n        tile.offsetY = fromY - toY;\n        this.tweens.add(tile, { offsetY: 0 }, 0.2 + drop.distance * 0.03, 'easeOutBounce');\n      }\n\n      this.state = STATES.IDLE;\n      setTimeout(() => this._processMatches(), 350);\n    }, 300);\n  }\n\n  _loop() {\n    const now = performance.now();\n    const dt = Math.min((now - this.lastTime) / 1000, 0.05);\n    this.lastTime = now;\n\n    // Phase 3a: Navigation screens take priority\n    if (this.nav.isActive()) {\n      this.nav.render(this.renderer.ctx, this.renderer.screenW, this.renderer.screenH);\n      // Phase 4: ad stub overlay on top of navigation\n      this.adManager.renderStubAd(this.renderer.ctx, this.renderer.screenW, this.renderer.screenH);\n      requestAnimationFrame(() => this._loop());\n      return;\n    }\n\n    this.update(dt);\n    this.render();\n    // Phase 4: ad stub overlay on top of gameplay\n    this.adManager.renderStubAd(this.renderer.ctx, this.renderer.screenW, this.renderer.screenH);\n    requestAnimationFrame(() => this._loop());\n  }\n\n  update(dt) {\n    this.tweens.update(dt);\n    this.particles.update(dt);\n    this.obstacleMgr.update(dt);\n    if (this.boss) this.boss.update(dt);\n    // Phase 4: ad stub timer\n    this.adManager.update(dt);\n\n    if (this.comboTimer > 0) {\n      this.comboTimer -= dt;\n      if (this.comboTimer <= 0) this.comboText = '';\n    }\n\n    this.input.enabled = this.state === STATES.IDLE;\n  }\n\n  render() {\n    this.renderer.clear();\n    this.renderer.drawBackground();\n\n    for (let r = 0; r < this.board.size; r++) {\n      for (let c = 0; c < this.board.size; c++) {\n        const tile = this.board.getTile(r, c);\n        if (tile) {\n          if (this._selectedTile && this._selectedTile.row === r && this._selectedTile.col === c) {\n            tile.selected = true;\n          } else {\n            tile.selected = false;\n          }\n          this.renderer.drawTile(tile);\n        }\n      }\n    }\n\n    this.renderer.drawObstacles(this.obstacleMgr);\n\n    if (this.boss && this.boss.active) {\n      this.renderer.drawBoss(this.boss, this.renderer);\n    }\n\n    this.particles.draw(this.renderer.ctx);\n    this.renderer.updateAndDrawFloatingTexts(1 / 60);\n\n    const config = this.levels[this.currentLevel] || this.levels[0];\n    this.renderer.drawUI(\n      this.scoreSystem.score,\n      this.scoreSystem.getRemainingMoves(),\n      config,\n      this.scoreSystem,\n      this.currentLevel + 1,\n    );\n\n    if (this.comboText) {\n      this.renderer.drawComboText(this.comboText);\n    }\n\n    if (this.boss && this.boss.active) {\n      this.renderer.drawBossHealthBar(this.boss);\n    }\n\n    // Phase 3a: back-to-map button during gameplay\n    this._drawBackButton();\n\n    // Result screen is now handled by Navigation\n  }\n\n  _drawBackButton() {\n    const ctx = this.renderer.ctx;\n    const w = this.renderer.screenW;\n    ctx.fillStyle = '#8D6E6399';\n    this.renderer._roundRect(ctx, w - 50, this.renderer.boardY + this.renderer.tileSize * BOARD_SIZE + 25, 40, 28, 14);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 12px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('地图', w - 30, this.renderer.boardY + this.renderer.tileSize * BOARD_SIZE + 44);\n  }\n\n  retry() {\n    this._loadLevel(this.currentLevel);\n    this.state = STATES.IDLE;\n  }\n\n  nextLevel() {\n    const next = this.currentLevel + 1;\n    if (next < this.levels.length) {\n      this._loadLevel(next);\n      this.state = STATES.IDLE;\n    } else {\n      this._loadLevel(0);\n      this.state = STATES.IDLE;\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Game, STATES };\n","numLines":672,"startLine":1,"totalLines":672}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_1a278c87110240a4b56d05fd","type":"tool_result","content":"1\t# 消消消大作战（Match & Blast）— 详细立项文档\n2\t\n3\t> **版本**：1.0 | **日期**：2026-05-23 | **设计师**：游戏设计师 Agent\n4\t> **状态**：立项 — 待开发评审\n5\t> **关联文档**：[[douyin-mini-games-blueprint.md]] — 平台调研与初始概念\n6\t\n7\t---\n8\t\n9\t## 一、项目概览\n10\t\n11\t| 字段 | 值 |\n12\t|------|-----|\n13\t| 游戏名称 | 消消消大作战（Match & Blast） |\n14\t| 品类 | 三消益智（Match-3 Puzzle） |\n15\t| 目标平台 | 抖音小游戏（优先）→ 微信小游戏 → H5 |\n16\t| 核心差异化 | 抖音社交裂变深度集成 + 轻量元进度 + 极简操作 |\n17\t| 开发周期 | 4 周（单人全栈，含提审） |\n18\t| 目标 DAU | 首发 5K → 3 个月 50K |\n19\t| 变现模式 | IAA 为主（激励视频 + 插屏），后续叠加 IAP |\n20\t| 包体目标 | < 4MB |\n21\t| 软著申请 | 开发首日同步启动，预计 2-4 周下发 |\n22\t\n23\t### 设计支柱（不可妥协）\n24\t\n25\t1. **30 秒内上手** — 零学习成本，任何人第一次打开就知道怎么玩\n26\t2. **每次操作都有快感** — 消除、连锁、特效必须持续刺激多巴胺\n27\t3. **每关结束都是广告机会** — 关卡节奏与广告位无缝衔接，不破坏体验\n28\t4. **抖音 = 第一公民** — 所有社交功能优先适配抖音 API，不是后期嫁接\n29\t\n30\t---\n31\t\n32\t## 二、核心玩法机制设计\n33\t\n34\t### 2.1 基础规则\n35\t\n36\t- **棋盘**：8×8 网格，填充 6 种颜色元素（水果主题：苹果红、香蕉黄、葡萄紫、蓝莓蓝、橙子橙、青柠绿）\n37\t- **操作**：触摸滑动交换两个相邻元素（上下左右），不允许对角交换\n38\t- **匹配**：3 个或以上同色水平/垂直连线触发消除\n39\t- **消除后**：上方元素受重力下落 → 顶部生成新元素 → 检测连锁\n40\t- **步数限制**：每关限定步数内完成目标\n41\t\n42\t### 2.2 匹配检测算法（伪代码规格）\n43\t\n44\t```\n45\t输入：8×8 网格状态\n46\t输出：所有匹配组列表\n47\t\n48\t1. 水平扫描：从左到右，对每行寻找连续 >= 3 同色\n49\t   - 记录起始坐标和长度\n50\t2. 垂直扫描：从上到下，对每列寻找连续 >= 3 同色\n51\t   - 记录起始坐标和长度\n52\t3. 合并重叠区域：L/T 形匹配 = 水平匹配与垂直匹配的交集\n53\t4. 按匹配长度分类：\n54\t   - 长度 3 → 普通消除\n55\t   - 长度 4 → 生成条纹炸弹（方向 = 匹配方向垂直）\n56\t   - 长度 5 → 生成彩虹方块\n57\t   - L/T 形 → 生成区域炸弹（3×3 爆炸范围）\n58\t\n59\t性能要求：单次检测 < 1ms（8×8 网格遍历量极小）\n60\t```\n61\t\n62\t### 2.3 特殊方块系统\n63\t\n64\t| 方块类型 | 生成条件 | 效果 | 视觉标识 |\n65\t|----------|----------|------|----------|\n66\t| 条纹炸弹 | 4 连线 | 消除整行或整列 | 方块带横/竖条纹 + 发光 |\n67\t| 区域炸弹 | L 形 / T 形匹配 | 爆炸消除 3×3 范围 | 方块带十字准星 |\n68\t| 彩虹方块 | 5 连线 | 选中后消除棋盘上所有同色方块 | 七彩渐变 + 流光动画 |\n69\t| 彩虹 + 条纹 | 彩虹与条纹相邻交换 | 所有同色方块变为条纹炸弹并激活 | 组合特效：彩虹漩涡 → 全屏条纹发射 |\n70\t| 彩虹 + 区域 | 彩虹与区域炸弹相邻交换 | 所有同色方块变为区域炸弹并激活 | 组合特效：彩虹漩涡 → 全屏爆炸 |\n71\t| 条纹 + 条纹 | 两条纹相邻交换 | 同时消除一行 + 一列（十字形） | 十字光束 |\n72\t| 区域 + 区域 | 两区域炸弹相邻交换 | 爆炸范围扩大到 5×5 | 大爆炸特效 |\n73\t\n74\t### 2.4 障碍物系统\n75\t\n76\t| 障碍物 | 机制 | 消除方式 | 引入关卡段 |\n77\t|--------|------|----------|-----------|\n78\t| 冰块 | 覆盖在方块上，方块被消除时冰块碎裂 | 消除冰块下方的方块 | 21-30 |\n79\t| 双层冰块 | 需要消除下方方块两次 | 同上，需两次 | 51-80 |\n80\t| 链条 | 锁定方块位置，不能交换 | 相邻方块消除时连锁消除链条 | 31-50 |\n81\t| 泥土 | 占据格位，不可移动 | 相邻消除 3 次清除 | 41-60 |\n82\t| 巧克力 | 每回合未消除则向相邻空格扩散 | 消除相邻方块阻止扩散 | 81-120 |\n83\t| 障碍箱 | 需要相邻消除 N 次才打开 | 相邻方块消除累计伤害 | 61-100 |\n84\t| 彩虹锁 | 锁定特定颜色，该色不可消除 | 彩虹方块直接解锁 | 101+ |\n85\t\n86\t**障碍物组合规则**（从关卡 51 开始）：\n87\t- 冰块 + 链条：方块被锁住且被冰覆盖，需先破链再破冰\n88\t- 泥土 + 巧克力：泥土被清除后巧克力可能扩散到该位置\n89\t- 障碍箱 + 冰块：箱内方块被冰覆盖，需先破冰再伤害箱子\n90\t\n91\t### 2.5 关卡目标类型\n92\t\n93\t| 目标类型 | 规则 | 占比 | 配置示例 |\n94\t|----------|------|------|----------|\n95\t| **分数达标** | 限步内达到目标分数 | 40% | 25 步内达到 5000 分 |\n96\t| **收集颜色** | 消除指定数量的特定颜色方块 | 25% | 消除 30 个红色 + 20 个蓝色 |\n97\t| **清除障碍** | 消除棋盘上所有指定障碍物 | 20% | 清除 15 块冰 |\n98\t| **材料收集** | 将材料方块从底部导出棋盘 | 10% | 收集 5 个蜂蜜罐 |\n99\t| **Boss 挑战** | 消除方块对 Boss 造成伤害，Boss 血量归零前完成 | 5% | Boss 300 HP，每消除 1 方块 -1 HP |\n100\t\n101\t### 2.6 连锁系统（核心爽感来源）\n102\t\n103\t```\n104\t玩家交换 → 检测匹配 → 标记消除 → 播放消除动画（0.3s）\n105\t→ 检测特殊方块触发 → 播放特殊效果（0.2s）\n106\t→ 重力下落 → 顶部填充 → 再次检测匹配\n107\t→ 如有新匹配 → 连锁！→ 连锁计数 +1 → 分数倍率 = 1 + 0.5 × 连锁数\n108\t→ 重复直到无新匹配 → 结算本操作\n109\t→ 回到玩家操作\n110\t\n111\t连锁奖励：\n112\t- 2 连锁：1.5x 分数 + \"不错！\" 文字弹出\n113\t- 3 连锁：2.0x 分数 + \"太棒了！\" + 短暂屏幕震动\n114\t- 4+ 连锁：2.5x+ 分数 + \"超赞！！\" + 全屏光效 + 额外赠送 1 步\n115\t```\n116\t\n117\t**动画时间预算**（单次操作总动画不超过 2 秒）：\n118\t- 消除动画：0.3s\n119\t- 下落动画：0.2s（加速）\n120\t- 填充动画：0.15s\n121\t- 特殊效果：0.2s\n122\t- 连锁间停顿：0.1s\n123\t\n124\t### 2.7 关卡失败与续命\n125\t\n126\t| 事件 | 玩家选择 | 结果 |\n127\t|------|----------|------|\n128\t| 步数耗尽但未达标 | 看激励视频（30s） | 获得 5 步续命，可续命 1 次 |\n129\t| 步数耗尽但未达标 | 使用 10 金币购买 | 获得 5 步续命 |\n130\t| 步数耗尽但未达标 | 放弃 | 回到关卡地图，扣 0 生命 |\n131\t\n132\t---\n133\t\n134\t## 三、关卡系统设计（首发 50 关）\n135\t\n136\t### 3.1 关卡数据结构\n137\t\n138\t```json\n139\t{\n140\t  \"id\": 1,\n141\t  \"grid\": [\n142\t    [1, 2, 3, 4, 5, 6, 1, 2],\n143\t    [3, 4, 1, 2, 3, 4, 5, 6],\n144\t    ...\n145\t  ],\n146\t  \"goal\": {\n147\t    \"type\": \"score\",\n148\t    \"target\": 2000\n149\t  },\n150\t  \"moves\": 30,\n151\t  \"stars\": [2000, 3500, 5000],\n152\t  \"obstacles\": [],\n153\t  \"specials\": [],\n154\t  \"tutorial_step\": null\n155\t}\n156\t```\n157\t\n158\t| 字段 | 类型 | 说明 |\n159\t|------|------|------|\n160\t| id | int | 关卡编号 |\n161\t| grid | int[8][8] | 初始布局（0=空, 1-6=颜色, 负数=障碍物） |\n162\t| goal | object | 目标类型和参数 |\n163\t| moves | int | 步数限制 |\n164\t| stars | int[3] | 1/2/3 星分数阈值 |\n165\t| obstacles | array | 本关障碍物配置 |\n166\t| specials | array | 本关特殊规则（如\"本关不会生成绿色\"） |\n167\t| tutorial_step | string/null | 关联的教学步骤 ID |\n168\t\n169\t### 3.2 前 50 关详细设计\n170\t\n171\t#### 第 1-10 关：纯教学（零失败区）\n172\t\n173\t| 关卡 | 目标 | 步数 | 星级分数 | 教学内容 |\n174\t|------|------|------|----------|----------|\n175\t| 1 | 分数 1000 | 30 | [1000, 1500, 2000] | 引导滑动交换（强制引导第 1 步） |\n176\t| 2 | 分数 1500 | 28 | [1500, 2200, 3000] | 自由操作，无引导 |\n177\t| 3 | 分数 2000 | 25 | [2000, 3000, 4000] | 引导 4 连 → 合成条纹炸弹 |\n178\t| 4 | 分数 2000 | 25 | [2000, 3000, 4000] | 自由体验条纹炸弹效果 |\n179\t| 5 | 分数 2500 | 25 | [2500, 3500, 4500] | 引导 L 形匹配 → 合成区域炸弹 |\n180\t| 6 | 分数 2500 | 25 | [2500, 3500, 4500] | 自由体验区域炸弹 |\n181\t| 7 | 分数 3000 | 22 | [3000, 4000, 5500] | 引导 5 连 → 合成彩虹方块 |\n182\t| 8 | 分数 3000 | 22 | [3000, 4000, 5500] | 自由体验彩虹方块 |\n183\t| 9 | 收集红 15 蓝 15 | 25 | [2000, 3500, 5000] | 引入收集目标 |\n184\t| 10 | 分数 3500 | 20 | [3500, 5000, 6500] | 综合测试，保证 3 星 |\n185\t\n186\t**设计原则**：\n187\t- 1-10 关保证任何玩家都能 3 星通关\n188\t- 步数至少宽裕 50%（即最优解只需给定步数的 60-70%）\n189\t- 棋盘布局偏向容易形成长链和连锁\n190\t\n191\t#### 第 11-20 关：基础挑战\n192\t\n193\t| 关卡 | 目标 | 步数 | 星级分数 | 新元素 |\n194\t|------|------|------|----------|--------|\n195\t| 11 | 分数 4000 | 22 | [4000, 5500, 7000] | 步数开始收紧 |\n196\t| 12 | 收集红 20 绿 20 | 22 | [2500, 4000, 5500] | 双色收集 |\n197\t| 13 | 分数 4500 | 20 | [4500, 6000, 8000] | — |\n198\t| 14 | 收集蓝 25 紫 25 | 20 | [3000, 4500, 6000] | — |\n199\t| 15 | 分数 5000 | 20 | [5000, 6500, 8500] | 引导组合特殊方块 |\n200\t| 16 | 收集红 30 黄 20 | 18 | [3500, 5000, 6500] | — |\n201\t| 17 | 分数 5000 | 18 | [5000, 7000, 9000] | — |\n202\t| 18 | 收集蓝 20 绿 30 | 18 | [3000, 4500, 6000] | — |\n203\t| 19 | 分数 5500 | 18 | [5500, 7500, 9500] | 难度微增 |\n204\t| 20 | 分数 6000 | 18 | [6000, 8000, 10000] | Boss 关（Boss 100 HP，教学向） |\n205\t\n206\t**设计原则**：\n207\t- 步数宽裕度降至 30-40%\n208\t- 引入双色收集增加策略性\n209\t- 第 20 关作为第一章 Boss，消除伤害 = 普通 HP 扣减\n210\t\n211\t#### 第 21-35 关：冰块时代\n212\t\n213\t| 关卡 | 目标 | 步数 | 新元素 | 星级分数 |\n214\t|------|------|------|--------|----------|\n215\t| 21 | 清除冰块 8 | 25 | 冰块首次出现 | [2000, 3500, 5000] |\n216\t| 22 | 清除冰块 10 | 24 | — | [2500, 4000, 5500] |\n217\t| 23 | 分数 5000 + 清除冰块 6 | 22 | 双目标 | [5000, 6500, 8000] |\n218\t| 24 | 清除冰块 12 | 22 | — | [2500, 4000, 5500] |\n219\t| 25 | 收集红 25 + 清除冰块 8 | 20 | — | [3000, 4500, 6000] |\n220\t| 26-30 | 渐进混合 | 20-22 | 冰块密度增加 | 渐进 |\n221\t| 31 | 清除链条 8 | 22 | 链条首次出现 | [2500, 4000, 5500] |\n222\t| 32 | 清除链条 10 | 20 | — | [3000, 4500, 6000] |\n223\t| 33 | 清除冰块 6 + 链条 6 | 20 | 冰块 + 链条组合 | [3000, 4500, 6000] |\n224\t| 34 | 分数 6000 + 清除链条 8 | 18 | — | [6000, 8000, 10000] |\n225\t| 35 | Boss 200 HP | 18 | Boss + 冰块 | [5000, 7000, 9000] |\n226\t\n227\t#### 第 36-50 关：混合进阶\n228\t\n229\t| 关卡段 | 关卡 | 新元素 | 设计思路 |\n230\t|--------|------|--------|----------|\n231\t| 36-40 | 5 关 | 泥土 | 泥土引入，需多次相邻消除 |\n232\t| 41-45 | 5 关 | 障碍箱 | 箱子 HP 3-5，组合已有障碍 |\n233\t| 46-49 | 4 关 | 全类型混合 | 难度曲线上升，步数 18-20 |\n234\t| 50 | Boss 关 | Boss 300 HP + 障碍 | 里程碑 Boss，难度中等偏上 |\n235\t\n236\t**关卡验证规则**：\n237\t- 每关通过 BFS/DFS 验证可解性\n238\t- 1 星必须能在给定步数 80% 内完成\n239\t- 3 星需要合理利用特殊方块和连锁\n240\t- 棋盘不能出现初始就有 3 连的情况（除非教学关卡故意设置）\n241\t\n242\t### 3.3 关卡生成工具（开发辅助）\n243\t\n244\t开发阶段需要一个简单的关卡编辑器/验证器：\n245\t\n246\t```\n247\t输入：JSON 关卡数据\n248\t输出：PASS/FAIL + 最少步数\n249\t\n250\t1. 模拟棋盘初始状态\n251\t2. BFS 搜索所有可能的交换序列\n252\t3. 计算最优解步数\n253\t4. 验证：最优解步数 <= 给定步数 × 0.7（保证 1 星可达）\n254\t5. 验证：最优解步数 × 0.4 >= 给定步数（保证有挑战性）\n255\t```\n256\t\n257\t> 注：完整 50 关 JSON 数据将在开发阶段由设计师 + 工具共同产出，此处定义结构和设计规范。\n258\t\n259\t---\n260\t\n261\t## 四、变现策略细节\n262\t\n263\t### 4.1 广告位详细设计\n264\t\n265\t#### 广告位 1：续步激励视频（最高优先级）\n266\t\n267\t| 属性 | 值 |\n268\t|------|-----|\n269\t| 触发条件 | 关卡失败（步数耗尽且未达标） |\n270\t| 广告类型 | 激励视频（穿山甲 rewardedVideoAd） |\n271\t| 视频时长 | 15-30 秒 |\n272\t| 用户奖励 | +5 步续命（每关限 1 次） |\n273\t| UI 设计 | 失败弹窗：左侧\"放弃\"按钮（灰色小字），右侧\"看视频继续\"按钮（金色高亮，带播放图标） |\n274\t| 预估触发率 | 30-40% 的关卡会失败，其中 70% 选择看视频 |\n275\t\n276\t#### 广告位 2：开局增益激励视频\n277\t\n278\t| 属性 | 值 |\n279\t|------|-----|\n280\t| 触发条件 | 关卡开始前的\"准备\"界面 |\n281\t| 广告类型 | 激励视频 |\n282\t| 用户奖励 | 开局随机获得 1 个条纹炸弹（放置在棋盘上） |\n283\t| UI 设计 | 关卡准备页底部横幅：\"观看视频获得开局炸弹\" + 炸弹图标动画 |\n284\t| 预估触发率 | 40-50% 的玩家会选择观看 |\n285\t\n286\t#### 广告位 3：双倍结算激励视频\n287\t\n288\t| 属性 | 值 |\n289\t|------|-----|\n290\t| 触发条件 | 关卡成功结算页 |\n291\t| 广告类型 | 激励视频 |\n292\t| 用户奖励 | 本关金币奖励翻倍 |\n293\t| UI 设计 | 结算页底部按钮：\"领取 ×1\"（普通） vs \"看视频领取 ×2\"（高亮动画） |\n294\t| 预估触发率 | 50-60%（因为已经成功，心情好，更愿意看） |\n295\t\n296\t#### 广告位 4：关卡间插屏\n297\t\n298\t| 属性 | 值 |\n299\t|------|-----|\n300\t| 触发条件 | 每通过 3 关后，从结算页返回地图时 |\n301\t| 广告类型 | 插屏广告（5 秒后可关闭） |\n302\t| 用户奖励 | 无（不可跳过前 5 秒） |\n303\t| UI 设计 | 全屏展示，右上角 5 秒倒计时 → 变为\"关闭\"按钮 |\n304\t| 预估频率 | 每通关 3 关 1 次，约 2-3 次/天 |\n305\t\n306\t#### 广告位 5：宝箱加速激励视频\n307\t\n308\t| 属性 | 值 |\n309\t|------|-----|\n310\t| 触发条件 | 地图上的进度宝箱（每 10 关出现一个），倒计时解锁 |\n311\t| 广告类型 | 激励视频 |\n312\t| 用户奖励 | 立即解锁宝箱（跳过等待） |\n313\t| UI 设计 | 宝箱倒计时界面 + \"立即开启\"视频按钮 |\n314\t| 预估触发率 | 60-70%（宝箱奖励吸引力强） |\n315\t\n316\t#### 广告位 6：每日签到翻倍\n317\t\n318\t| 属性 | 值 |\n319\t|------|-----|\n320\t| 触发条件 | 每日登录签到时 |\n321\t| 广告类型 | 激励视频 |\n322\t| 用户奖励 | 今日登录奖励翻倍 |\n323\t| UI 设计 | 签到弹窗底部：\"看视频翻倍今日奖励\" |\n324\t\n325\t### 4.2 广告展示频率控制（防骚扰）\n326\t\n327\t```\n328\t规则：\n329\t- 同一广告位两次触发最小间隔：60 秒\n330\t- 激励视频每日总上限：12 次（超出后隐藏激励视频按钮）\n331\t- 插屏广告每日总上限：6 次\n332\t- 连续 2 次失败后暂停展示插屏（避免挫败感叠加）\n333\t- 新用户前 3 关不展示任何广告\n334\t```\n335\t\n336\t### 4.3 内购道具（后续迭代，首版不包含）\n337\t\n338\t| 道具 | 价格（¥） | 效果 | 上线时机 |\n339\t|------|-----------|------|----------|\n340\t| 去广告 | 12 | 永久移除所有非激励视频广告 | V1.1 |\n341\t| 金币包 S | 6 | 500 金币 | V1.1 |\n342\t| 金币包 M | 18 | 2000 金币（+10%赠送） | V1.1 |\n343\t| 金币包 L | 30 | 4000 金币（+20%赠送） | V1.1 |\n344\t| 月卡 | 25/月 | 每日 200 金币 + 专属角色 + 去广告 | V1.2 |\n345\t\n346\t### 4.4 金币经济（IAA 获取为主）\n347\t\n348\t| 来源 | 金币/次 | 频率 |\n349\t|------|---------|------|\n350\t| 通关 1 星 | 10 | 每次 |\n351\t| 通关 2 星 | 20 | 每次 |\n352\t| 通关 3 星 | 30 | 每次 |\n353\t| 每日登录 Day 1-7 | 10/20/40/80/150/300/500 | 每日 |\n354\t| 宝箱（每 10 关） | 100-300 | 每 10 关 |\n355\t| 每日任务完成 | 50-100 | 每日 |\n356\t| 好友助力 | 20 | 每日上限 3 次 |\n357\t\n358\t| 消耗 | 金币/次 | 说明 |\n359\t|------|---------|------|\n360\t| 续步（非广告） | 10 | 每关限 1 次 |\n361\t| 购买开局道具 | 5-15 | 条纹炸弹/区域炸弹 |\n362\t| 角色碎片 | 50 | 每 10 碎片兑换 1 角色 |\n363\t\n364\t**经济平衡目标**：\n365\t- 免费（纯 IAA）玩家每天净收入约 150-300 金币\n366\t- 日均消耗约 50-100 金币（用于续步和道具）\n367\t- 每周可攒够兑换 1 个角色碎片包\n368\t- 不存在经济死胡同（任何消耗品都可通过广告获取）\n369\t\n370\t---\n371\t\n372\t## 五、技术方案\n373\t\n374\t### 5.1 技术栈选型\n375\t\n376\t| 组件 | 选型 | 理由 |\n377\t|------|------|------|\n378\t| 渲染引擎 | **Canvas 2D**（`tt.createCanvas()`） | 三消无需 WebGL，Canvas 2D 足够且兼容性最好 |\n379\t| 编程语言 | **原生 JavaScript**（ES6+） | 无需编译步骤，最小依赖，包体最小 |\n380\t| 动画 | 自写缓动库（tween.js 轻量替代） | 避免 50KB+ 的 tween 库，三消动画类型有限 |\n381\t| 粒子效果 | 自写粒子系统 | 消除特效只需 3-5 种粒子模板 |\n382\t| 音频 | `tt.createInnerAudioContext()` | 抖音原生 API |\n383\t| 广告 | 穿山甲 SDK（csjplatform.com） | 抖音官方广告平台 |\n384\t| 数据存储 | `tt.setStorageSync()` + 云开发 | 本地进度 + 云端排行榜 |\n385\t| 社交 | `tt.shareAppMessage()` + `tt.getFriendCloudStorage()` | 抖音好友关系链 |\n386\t| 构建工具 | 无（直接编写） | 抖音小游戏无需 webpack 等构建 |\n387\t| 代码规范 | ESLint + Prettier | 统一代码风格 |\n388\t\n389\t**不使用游戏引擎的理由**：\n390\t- 三消逻辑简单，引擎引入 1MB+ 开销\n391\t- Canvas 2D API 对 8×8 网格绑绑有余\n392\t- 原生 JS 最小化包体，审核更快，加载更快\n393\t\n394\t### 5.2 项目文件结构\n395\t\n396\t```\n397\tmatch-and-blast/\n398\t├── tt/                        # 抖音小游戏入口\n399\t│   ├── game.js               # 入口文件：初始化 Canvas、启动游戏\n400\t│   ├── game.json             # 小游戏配置（屏幕方向、API 权限声明）\n401\t│   └── project.config.json   # 抖音开发者工具配置（AppID 等）\n402\t│\n403\t├── src/\n404\t│   ├── core/                 # 核心游戏逻辑\n405\t│   │   ├── board.js          # 棋盘状态管理（8×8 网格）\n406\t│   │   ├── match-engine.js   # 匹配检测算法（水平/垂直/L-T 形）\n407\t│   │   ├── gravity.js        # 重力下落 + 填充逻辑\n408\t│   │   ├── chain.js          # 连锁检测与计分\n409\t│   │   ├── special-tiles.js  # 特殊方块生成与触发\n410\t│   │   ├── swap.js           # 交换验证与执行\n411\t│   │   └── obstacles.js      # 障碍物逻辑（冰块/链条/泥土等）\n412\t│   │\n413\t│   ├── game/                 # 游戏系统\n414\t│   │   ├── state-machine.js  # 游戏状态机（LOADING→MENU→PLAYING→RESULT）\n415\t│   │   ├── level-manager.js  # 关卡加载、目标判定、星级计算\n416\t│   │   ├── level-goals.js    # 目标系统（分数/收集/清除/Boss）\n417\t│   │   ├── score.js          # 分数计算（含连锁倍率）\n418\t│   │   ├── moves.js          # 步数管理\n419\t│   │   └── tutorial.js       # 新手引导序列\n420\t│   │\n421\t│   ├── meta/                 # 元进度系统\n422\t│   │   ├── map.js            # 地图界面与进度\n423\t│   │   ├── characters.js     # 角色系统与技能\n424\t│   │   ├── daily.js          # 每日登录 + 每日任务 + 每日挑战\n425\t│   │   ├── economy.js        # 金币经济管理\n426\t│   │   └── rewards.js        # 宝箱/成就/里程碑奖励\n427\t│   │\n428\t│   ├── social/               # 社交与裂变\n429\t│   │   ├── share.js          # 分享（tt.shareAppMessage）\n430\t│   │   ├── friends.js        # 好友排行榜（tt.getFriendCloudStorage）\n431\t│   │   ├── pk.js             # 好友 PK 逻辑\n432\t│   │   └── invite.js         # 邀请助力\n433\t│   │\n434\t│   ├── monetization/         # 变现\n435\t│   │   ├── ad-manager.js     # 穿山甲广告管理（初始化/预加载/展示/频率控制）\n436\t│   │   └── iap.js            # 内购（后续版本）\n437\t│   │\n438\t│   ├── render/               # 渲染层\n439\t│   │   ├── renderer.js       # Canvas 主渲染循环\n440\t│   │   ├── tile-renderer.js  # 方块绘制（6 色 + 特殊方块）\n441\t│   │   ├── obstacle-renderer.js # 障碍物绘制\n442\t│   │   ├── animation.js      # 动画系统（缓动 + 补间）\n443\t│   │   ├── particles.js      # 粒子效果系统\n444\t│   │   ├── ui.js             # UI 组件（按钮/弹窗/文字）\n445\t│   │   └── map-renderer.js   # 地图界面渲染\n446\t│   │\n447\t│   ├── audio/                # 音频\n448\t│   │   └── audio-manager.js  # 音效管理（消除/连锁/特殊/BGM）\n449\t│   │\n450\t│   ├── input/                # 输入处理\n451\t│   │   └── touch-handler.js  # 触摸事件（滑动方向判定 + 点击）\n452\t│   │\n453\t│   ├── data/                 # 数据\n454\t│   │   └── storage.js        # 持久化（tt.setStorageSync 封装）\n455\t│   │\n456\t│   └── platform/             # 平台适配\n457\t│       ├── douyin.js         # 抖音 API 封装\n458\t│       └── wechat.js         # 微信 API 适配层（tt.* → wx.* 映射）\n459\t│\n460\t├── data/\n461\t│   ├── levels/\n462\t│   │   ├── chapter-01.json   # 第 1-10 关\n463\t│   │   ├── chapter-02.json   # 第 11-20 关\n464\t│   │   ├── chapter-03.json   # 第 21-35 关\n465\t│   │   ├── chapter-04.json   # 第 36-50 关\n466\t│   │   └── weekly/           # 每周更新关卡\n467\t│   ├── characters.json       # 角色配置\n468\t│   ├── daily-tasks.json      # 每日任务模板\n469\t│   └── economy.json          # 经济数值配置\n470\t│\n471\t├── assets/\n472\t│   ├── tiles/                # 方块精灵图（6 色 × 4 帧 = 24 张，每张 < 5KB）\n473\t│   ├── effects/              # 消除特效帧动画（爆炸/光效/粒子）\n474\t│   ├── characters/           # 角色立绘（4 个角色 × 2 帧 = 8 张）\n475\t│   ├── maps/                 # 地图背景（5 个主题 × 1 张 = 5 张）\n476\t│   ├── ui/                   # UI 元素（按钮/弹窗/图标）\n477\t│   └── audio/                # 音效（< 200KB 总计）\n478\t│       ├── sfx/              # 音效（消除/连锁/失败/成功）\n479\t│       └── bgm/              # 背景音乐（1-2 首，循环）\n480\t│\n481\t├── tools/                    # 开发辅助工具\n482\t│   └── level-validator.js    # 关卡可解性验证器（BFS）\n483\t│\n484\t└── README.md\n485\t```\n486\t\n487\t### 5.3 抖音小游戏 SDK 集成要点\n488\t\n489\t#### 入口文件 game.js\n490\t\n491\t```javascript\n492\t// 最小入口示例\n493\tconst canvas = tt.createCanvas();\n494\tconst ctx = canvas.getContext('2d');\n495\tconst { pixelRatio, windowWidth, windowHeight } = tt.getSystemInfoSync();\n496\t\n497\tcanvas.width = windowWidth * pixelRatio;\n498\tcanvas.height = windowHeight * pixelRatio;\n499\tctx.scale(pixelRatio, pixelRatio);\n500\t\n501\timport { Game } from '../src/core/state-machine.js';\n502\tconst game = new Game(canvas, ctx);\n503\tgame.start();\n504\t```\n505\t\n506\t#### 广告初始化\n507\t\n508\t```javascript\n509\t// ads-manager.js 核心流程\n510\tclass AdManager {\n511\t  constructor() {\n512\t    this.rewardedAd = null;\n513\t    this.interstitialAd = null;\n514\t    this.dailyCount = { rewarded: 0, interstitial: 0 };\n515\t    this.lastShowTime = {};\n516\t  }\n517\t\n518\t  init() {\n519\t    // 激励视频\n520\t    this.rewardedAd = tt.createRewardedVideoAd({\n521\t      adUnitId: 'adunit-xxx' // 穿山甲后台获取\n522\t    });\n523\t    this.rewardedAd.onError((err) => console.warn('激励视频加载失败', err));\n524\t    this.rewardedAd.load(); // 预加载\n525\t\n526\t    // 插屏\n527\t    this.interstitialAd = tt.createInterstitialAd({\n528\t      adUnitId: 'adunit-yyy'\n529\t    });\n530\t  }\n531\t\n532\t  async showRewarded(placement) {\n533\t    if (this.dailyCount.rewarded >= 12) return false;\n534\t    // 频率控制：同位置 60 秒间隔\n535\t    if (this.checkCooldown(placement)) return false;\n536\t\n537\t    return new Promise((resolve) => {\n538\t      this.rewardedAd.onClose((res) => {\n539\t        if (res.isEnded) {\n540\t          this.dailyCount.rewarded++;\n541\t          this.lastShowTime[placement] = Date.now();\n542\t          resolve(true);\n543\t        } else {\n544\t          resolve(false);\n545\t        }\n546\t      });\n547\t      this.rewardedAd.show().catch(() => resolve(false));\n548\t    });\n549\t  }\n550\t}\n551\t```\n552\t\n553\t#### 社交分享\n554\t\n555\t```javascript\n556\t// share.js\n557\tfunction shareResult(levelId, score, stars) {\n558\t  tt.shareAppMessage({\n559\t    title: `我在消消消大作战第 ${levelId} 关获得了 ${stars} 星！来挑战我吧`,\n560\t    imageUrl: '/assets/ui/share-bg.jpg', // 400×300 预制分享图\n561\t    query: `from=share&level=${levelId}&inviter=${getUserId()}`\n562\t  });\n563\t}\n564\t```\n565\t\n566\t### 5.4 核心渲染循环\n567\t\n568\t```\n569\trequestAnimationFrame 循环：\n570\t  1. 处理输入队列（触摸事件 → 交换请求）\n571\t  2. 更新游戏状态\n572\t     - 如果在动画中：推进动画帧\n573\t     - 如果需要检测匹配：执行匹配检测\n574\t     - 如果有连锁：推进连锁\n575\t  3. 渲染\n576\t     - 清除画布\n577\t     - 绘制棋盘背景\n578\t     - 绘制方块（含动画偏移/缩放/透明度）\n579\t     - 绘制障碍物\n580\t     - 绘制特效（粒子/光效）\n581\t     - 绘制 UI（分数/步数/目标进度）\n582\t  4. 处理音频队列\n583\t```\n584\t\n585\t**性能目标**：稳定 60fps，Canvas draw call < 100/帧（8×8 网格 + UI ≈ 70-80 次）\n586\t\n587\t### 5.5 跨平台适配策略\n588\t\n589\t| 层 | 抽象 | 说明 |\n590\t|-----|------|------|\n591\t| 平台 API | `platform/douyin.js` → `platform/wechat.js` | `tt.*` → `wx.*` 一对一映射 |\n592\t| 存储 | `storage.js` 封装 | `tt.setStorageSync` → `wx.setStorageSync` |\n593\t| 广告 | 各平台广告 SDK 不同 | 抖音用穿山甲，微信用广点通 |\n594\t| 分享 | 接口相似，参数不同 | `tt.shareAppMessage` vs `wx.shareAppMessage` |\n595\t| Canvas | 完全兼容 | 两个平台 Canvas 2D API 一致 |\n596\t\n597\t---\n598\t\n599\t## 六、美术风格定义\n600\t\n601\t### 6.1 主题\n602\t\n603\t**\"甜蜜水果乐园\"** — 明亮、圆润、可爱、有食欲感\n604\t\n605\t### 6.2 色彩规范\n606\t\n607\t| 用途 | 颜色 | HEX | 说明 |\n608\t|------|------|-----|------|\n609\t| 背景 | 浅奶油色 | #FFF8E7 | 温暖不刺眼 |\n610\t| 棋盘底色 | 白色带微透明 | #FFFFFF CC | 突出方块 |\n611\t| 红色方块 | 苹果红 | #FF4D4D | 鲜艳饱和 |\n612\t| 黄色方块 | 香蕉黄 | #FFD93D | 明亮温暖 |\n613\t| 蓝色方块 | 蓝莓蓝 | #4DA6FF | 清新 |\n614\t| 绿色方块 | 青柠绿 | #6BCB77 | 自然 |\n615\t| 紫色方块 | 葡萄紫 | #B47AEA | 高级感 |\n616\t| 橙色方块 | 橙子橙 | #FF9A3C | 活力 |\n617\t| 强调色 | 金色 | #FFB800 | 按钮/奖励/星级 |\n618\t| 文字主色 | 深棕 | #5D4037 | 温暖不刺眼 |\n619\t| 文字副色 | 灰棕 | #8D6E63 | 次要信息 |\n620\t\n621\t### 6.3 方块设计规范\n622\t\n623\t- **形状**：圆角正方形，圆角半径 = 边长 × 0.2\n624\t- **内部**：对应水果的简化卡通图标（扁平面风格，无渐变阴影）\n625\t- **尺寸**：方块边长 = 屏幕宽度 / 8.5（留左右边距）\n626\t- **动画帧**：\n627\t  - 待机：微呼吸（scale 0.98-1.02，1.5s 循环）\n628\t  - 选中：放大 10% + 白色描边闪烁\n629\t  - 消除：缩小 + 旋转 + 粒子爆炸（0.3s）\n630\t  - 下落：弹性缓动（overshoot 1.2）\n631\t\n632\t### 6.4 UI 设计规范\n633\t\n634\t| 元素 | 规范 |\n635\t|------|------|\n636\t| 字体 | 系统默认圆体（抖音环境默认），数字用等宽字体 |\n637\t| 按钮 | 圆角矩形（圆角 = 高度 × 0.5），纯色 + 白色文字，按压时缩小 5% |\n638\t| 弹窗 | 白色圆角面板 + 半透明遮罩，底部滑入动画 |\n639\t| 星星 | 金色五角星，从左到右依次弹出（0.2s 间隔） |\n640\t| 进度条 | 圆角长条，填充色为绿色渐变，右侧显示百分比 |\n641\t| 金币图标 | 金色圆形 + \"$\" 符号，数字右对齐 |\n642\t\n643\t### 6.5 地图主题（首发 5 个，每主题 10 关）\n644\t\n645\t| 主题 | 背景色调 | 关卡范围 | 视觉特征 |\n646\t|------|----------|----------|----------|\n647\t| 糖果森林 | 粉绿渐变 | 1-10 | 大树糖果装饰，弯曲路径 |\n648\t| 海底世界 | 蓝绿渐变 | 11-20 | 珊瑚、气泡、水下光线 |\n649\t| 火山岛 | 橙红渐变 | 21-35 | 岩浆、烟雾、火焰粒子 |\n650\t| 冰雪王国 | 蓝白渐变 | 36-45 | 冰晶、雪花、极光 |\n651\t| 魔法城堡 | 紫金渐变 | 46-50+ | 星空、魔法阵、闪光 |\n652\t\n653\t---\n654\t\n655\t## 七、新手引导流程（详细规格）\n656\t\n657\t### 7.1 引导序列\n658\t\n659\t| 步骤 | 时间 | 触发条件 | 引导动作 | UI 表现 |\n660\t|------|------|----------|----------|---------|\n661\t| G1 | 0-3s | 第 1 关开始 | 高亮一个可行交换位置 | 半透明遮罩 + 箭头指向 + 手指动画 |\n662\t| G2 | 3-8s | 玩家完成第 1 次交换 | 无（自动） | 匹配消除 + 大号 \"+100\" 飞字 |\n663\t| G3 | 8-12s | 第 1 次消除后 | 文字提示\"滑动相邻方块交换位置\" | 底部文字条，2s 后淡出 |\n664\t| G4 | 12-20s | 等待玩家操作 2-3 次 | 无引导，让玩家自由操作 | — |\n665\t| G5 | 20-25s | 第 3 关开始 | 高亮 4 连位置 + 箭头 | \"4 个连在一起试试！\" |\n666\t| G6 | 25-30s | 玩家合成条纹炸弹 | 自动触发条纹效果 | 放大条纹效果动画 + \"太厉害了！炸弹！\" |\n667\t| G7 | 30-35s | 第 5 关开始 | 高亮 L 形位置 | \"试试 L 形匹配\" |\n668\t| G8 | 35-40s | 合成区域炸弹 | 自动触发 | 区域爆炸放大动画 |\n669\t| G9 | 40-50s | 第 7 关开始 | 高亮 5 连位置 | \"5 个一排会怎样？\" |\n670\t| G10 | 50-55s | 合成彩虹方块 | 自动触发 | 彩虹特效 + \"彩虹方块！点任意颜色消除全屏！\" |\n671\t\n672\t### 7.2 引导系统技术实现\n673\t\n674\t```javascript\n675\t// tutorial.js\n676\tconst tutorialSteps = [\n677\t  {\n678\t    id: 'G1',\n679\t    level: 1,\n680\t    trigger: 'level_start',\n681\t    action: 'highlight_swap',\n682\t    params: { from: {row: 3, col: 2}, to: {row: 3, col: 3} },\n683\t    text: null,  // 纯视觉引导\n684\t    blockOther: true  // 只允许操作引导位置\n685\t  },\n686\t  // ... 后续步骤\n687\t];\n688\t```\n689\t\n690\t**引导设计原则**：\n691\t- 前 3 关强制引导（`blockOther: true`），之后逐渐放开\n692\t- 每个引导只介绍 1 个概念\n693\t- 引导完成后不再重复\n694\t- 跳过机制：如果检测到玩家已经理解（如已经独立完成过 4 连），自动跳过对应引导\n695\t\n696\t---\n697\t\n698\t## 八、开发排期（4 周里程碑）\n699\t\n700\t### Week 1：核心玩法（MVP）\n701\t\n702\t| 天 | 任务 | 交付物 |\n703\t|----|------|--------|\n704\t| D1 | 项目搭建 + 入口文件 + Canvas 初始化 | 可运行的空白 Canvas |\n705\t| D1 | 棋盘渲染（8×8 网格 + 6 色方块） | 可视化棋盘 |\n706\t| D2 | 触摸输入 + 交换逻辑 | 可以拖动交换方块 |\n707\t| D2 | 匹配检测算法（3 连） | 交换后检测并消除 3 连 |\n708\t| D3 | 重力下落 + 填充 + 连锁检测 | 完整的单次操作循环 |\n709\t| D3 | 消除动画（缩小+粒子） | 消除有视觉反馈 |\n710\t| D4 | 特殊方块（条纹/区域/彩虹） | 4连/L形/5连生成特殊方块 |\n711\t| D4 | 特殊方块效果 | 条纹消行/区域爆炸/彩虹全消 |\n712\t| D5 | 组合效果（彩虹+条纹等） | 特殊方块组合触发 |\n713\t| D5 | 步数系统 + 分数计算 | 限步玩法可玩 |\n714\t\n715\t**W1 里程碑验收**：可以在限步内玩一局完整的三消，含特殊方块和连锁。\n716\t\n717\t### Week 2：完整单局\n718\t\n719\t| 天 | 任务 | 交付物 |\n720\t|----|------|--------|\n721\t| D6 | 关卡配置系统 + JSON 加载 | 可配置不同关卡 |\n722\t| D6 | 关卡目标（分数/收集/清除） | 多种目标类型 |\n723\t| D7 | 障碍物系统（冰块/链条/泥土） | 3 种障碍物 |\n724\t| D7 | Boss 关逻辑 | 消除对 Boss 造成伤害 |\n725\t| D8 | 前 20 关数据制作 + 可解性验证 | 20 个可玩关卡 |\n726\t| D8 | 星级评定 + 通关结算 UI | 1-3 星结算页 |\n727\t| D9 | 失败/续命 UI + 新手引导系统 | 引导序列 + 失败弹窗 |\n728\t| D9 | 音效集成（消除/连锁/失败/成功） | 有声游戏 |\n729\t| D10 | W2 内测 + Bug 修复 | 稳定可玩的 20 关 Demo |\n730\t\n731\t**W2 里程碑验收**：20 关完整可玩，含新手引导、目标系统、障碍物、音效。\n732\t\n733\t### Week 3：元进度 + 社交\n734\t\n735\t| 天 | 任务 | 交付物 |\n736\t|----|------|--------|\n737\t| D11 | 地图界面 + 路径推进 | 可视化关卡地图 |\n738\t| D11 | 角色系统（4 个角色 + 技能） | 可选角色 |\n739\t| D12 | 每日系统（登录/任务/挑战） | 每日内容 |\n740\t| D12 | 金币经济系统 | 金币收入/消耗 |\n741\t| D13 | 抖音分享集成 | 分享到抖音 |\n742\t| D13 | 好友排行榜 | 好友分数排行 |\n743\t| D14 | 好友 PK（同关卡比分数） | PK 模式 |\n744\t| D14 | 好友助力（续命分享） | 分享续命 |\n745\t| D15 | 关卡 21-50 数据 + W3 测试 | 50 关 + 社交功能 |\n746\t\n747\t**W3 里程碑验收**：50 关 + 地图 + 角色 + 每日系统 + 抖音社交功能。\n748\t\n749\t### Week 4：变现 + 上线\n750\t\n751\t| 天 | 任务 | 交付物 |\n752\t|----|------|--------|\n753\t| D16 | 穿山甲 SDK 集成（激励视频） | 广告可展示 |\n754\t| D16 | 广告位 UI（6 个广告位） | 所有广告位就绪 |\n755\t| D17 | 广告频率控制 + 数据埋点 | 广告系统完成 |\n756\t| D17 | 包体优化（资源压缩 + 代码瘦身） | < 4MB |\n757\t| D18 | 全量测试 + Bug 修复 | 无阻塞性 Bug |\n758\t| D18 | 软著材料提交（如已下发） | 提审准备 |\n759\t| D19 | 抖音提审 | 提交审核 |\n760\t| D19 | 备用：修复审核反馈 | 快速迭代 |\n761\t| D20 | 上线 + 监控首日数据 | 正式发布 |\n762\t\n763\t**W4 里程碑验收**：游戏上架抖音小游戏平台，广告变现运行正常。\n764\t\n765\t### 关键依赖\n766\t\n767\t| 依赖项 | 负责人 | 截止时间 | 风险 |\n768\t|--------|--------|----------|------|\n769\t| 抖音开发者账号注册 | 运营/商务 | 开发前 | 低 |\n770\t| 穿山甲广告账号 | 运营/商务 | W3 结束前 | 低 |\n771\t| 软著申请 | 运营/商务 | D1 启动，D20 前下发 | **高（可能延迟 2-4 周）** |\n772\t| 方块精灵图（24 张） | 美术 | W1 结束前 | 中 |\n773\t| 角色立绘（8 张） | 美术 | W2 结束前 | 低 |\n774\t| 地图背景（5 张） | 美术 | W3 结束前 | 低 |\n775\t| 音效（10-15 个） | 音频 | W2 结束前 | 低 |\n776\t| BGM（1-2 首） | 音频 | W3 结束前 | 低 |\n777\t\n778\t---\n779\t\n780\t## 九、数据埋点与运营\n781\t\n782\t### 9.1 关键指标\n783\t\n784\t| 指标 | 定义 | 目标值 | 告警阈值 |\n785\t|------|------|--------|----------|\n786\t| 次日留存 | D1/D0 | 40%+ | < 30% |\n787\t| 7 日留存 | D7/D0 | 20%+ | < 12% |\n788\t| 平均会话时长 | — | 8+ 分钟 | < 4 分钟 |\n789\t| 人均广告次数/天 | — | 6+ 次 | < 3 次 |\n790\t| 激励视频完成率 | — | 85%+ | < 70% |\n791\t| 新手引导完成率 | 完成教学关卡的玩家比例 | 95%+ | < 80% |\n792\t| 关卡通过率（前 10 关） | 单关通过比例 | 90%+ | < 75% |\n793\t| ARPU | 日收入/DAU | ¥0.4+ | < ¥0.2 |\n794\t| CPI（投放时） | 获客成本 | < ¥2 | > ¥5 |\n795\t\n796\t### 9.2 埋点事件\n797\t\n798\t```javascript\n799\t// 关键事件列表\n800\tconst EVENTS = {\n801\t  GAME_START: 'game_start',           // 游戏启动\n802\t  TUTORIAL_STEP: 'tutorial_step',     // 引导步骤\n803\t  LEVEL_START: 'level_start',         // 关卡开始\n804\t  LEVEL_COMPLETE: 'level_complete',   // 关卡完成（含分数/星级/步数）\n805\t  LEVEL_FAIL: 'level_fail',           // 关卡失败（含剩余目标/步数）\n806\t  AD_SHOW: 'ad_show',                 // 广告展示（含广告位/是否完成）\n807\t  AD_CLICK: 'ad_click',               // 广告点击\n808\t  SHARE: 'share',                     // 分享（含分享类型）\n809\t  RETENTION_DAY1: 'retention_d1',     // 次日回访\n810\t  PURCHASE: 'purchase',               // 内购（后续）\n811\t};\n812\t```\n813\t\n814\t---\n815\t\n816\t## 十、风险与缓解\n817\t\n818\t| 风险 | 概率 | 影响 | 缓解措施 |\n819\t|------|------|------|----------|\n820\t| 软著延迟 | 高 | 上线推迟 | D1 立即申请，准备代办加急；同时以个人开发者 IAA 模式先上架 |\n821\t| 三消竞品太强 | 高 | CPI 高 | 差异化靠抖音社交功能（PK/助力），不做纯买量 |\n822\t| 广告 eCPM 低于预期 | 中 | 收入降 | 优化激励视频位置，增加宝箱/签到广告位 |\n823\t| Canvas 性能问题 | 低 | 体验差 | 提前做性能测试；必要时切 Cocos Creator |\n824\t| 留存不达标 | 中 | LTV 低 | 持续更新关卡，AB 测试新手引导，加入每日挑战 |\n825\t| 抖音审核被拒 | 低 | 延迟 1-2 周 | 严格遵循内容规范，准备审核材料清单 |\n826\t\n827\t---\n828\t\n829\t## 十一、版本规划\n830\t\n831\t| 版本 | 时间 | 内容 |\n832\t|------|------|------|\n833\t| **V1.0** | 第 4 周末 | 50 关 + IAA 广告 + 基础社交 + 4 角色 |\n834\t| V1.1 | 上线后 2 周 | 内购道具 + 关卡扩充至 100 关 + 巧克力障碍 |\n835\t| V1.2 | 上线后 4 周 | 月卡系统 + 赛季通行证 + 新角色 |\n836\t| V1.3 | 上线后 6 周 | 微信小游戏版本上线 |\n837\t| V2.0 | 上线后 2 月 | 每周挑战赛 + 排行榜重做 + 直播互动 |\n838\t\n839\t---\n840\t\n841\t## 附录 A：调参表模板\n842\t\n843\t```\n844\t变量                    | 基础值      | 最小值  | 最大值  | 调参备注\n845\t------------------------|------------|---------|---------|---------------------------\n846\t棋盘大小                 | 8×8        | 6×6     | 10×10   | 固定 8×8，不调\n847\t颜色数量                 | 6          | 4       | 7       | [待测试] 6 是否让匹配太难\n848\t连锁分数倍率             | 1+0.5×n    | 1+0.3×n | 1+0.8×n | [待测试] 倍率是否激励足够\n849\t4 连生成条纹概率         | 100%       | 80%     | 100%    | 保持 100%\n850\t失败后续命步数           | 5          | 3       | 8       | [待测试] 5 是否太容易\n851\t续命金币价格             | 10         | 5       | 30      | [待测试]\n852\t新手关步数宽裕度         | 50%        | 30%     | 70%     | 根据新手完成率调整\n853\t插屏广告间隔（关数）     | 3          | 2       | 5       | [待测试] 3 是否太频繁\n854\t激励视频每日上限         | 12         | 8       | 20      | [待测试]\n855\tBoss HP（第 20 关）      | 100        | 50      | 200     | [待测试]\n856\t```\n857\t\n858\t## 附录 B：音效列表\n859\t\n860\t| ID | 音效名 | 触发时机 | 时长 | 风格 |\n861\t|----|--------|----------|------|------|\n862\t| S01 | match_basic | 3 连消除 | 0.2s | 清脆 pop |\n863\t| S02 | match_4 | 4 连消除 | 0.3s | 升调 pop |\n864\t| S03 | match_5 | 5 连消除 | 0.5s | 魔法 sparkle |\n865\t| S04 | chain_2 | 2 连锁 | 0.3s | 快乐升调 |\n866\t| S05 | chain_3 | 3+ 连锁 | 0.5s | 激动管弦 |\n867\t| S06 | special_striped | 条纹炸弹激活 | 0.4s | 嗖—— |\n868\t| S07 | special_bomb | 区域炸弹爆炸 | 0.5s | 低频 boom |\n869\t| S08 | special_rainbow | 彩虹全消 | 0.8s | 魔法 shimmer |\n870\t| S09 | level_complete | 通关 | 1.5s | 欢快 fanfare |\n871\t| S10 | level_fail | 失败 | 1.0s | 温柔 sad |\n872\t| S11 | star_earned | 获得星星 | 0.3s | 叮—— |\n873\t| S12 | button_click | 按钮点击 | 0.1s | 轻触 |\n874\t| S13 | combo_text | 连击文字弹出 | 0.2s | 叮咚 |\n875\t| S14 | boss_hit | Boss 受伤 | 0.3s | 打击感 |\n876\t| S15 | boss_defeat | Boss 击败 | 1.0s | 胜利号角 |\n877\t\n878\t## 附录 C：变更日志\n879\t\n880\t| 版本 | 日期 | 变更内容 |\n881\t|------|------|----------|\n882\t| 1.0 | 2026-05-23 | 初始立项文档 |\n883\t"}]},"parent_tool_use_id":null,"session_id":"7463fb62-2e03-4edd-abad-466ff792dff1","uuid":"49ae2d13-a435-4160-b109-7e706966a579","timestamp":"2026-05-23T10:37:39.870Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-match3/GDD.md","content":"# 消消消大作战（Match & Blast）— 详细立项文档\n\n> **版本**：1.0 | **日期**：2026-05-23 | **设计师**：游戏设计师 Agent\n> **状态**：立项 — 待开发评审\n> **关联文档**：[[douyin-mini-games-blueprint.md]] — 平台调研与初始概念\n\n---\n\n## 一、项目概览\n\n| 字段 | 值 |\n|------|-----|\n| 游戏名称 | 消消消大作战（Match & Blast） |\n| 品类 | 三消益智（Match-3 Puzzle） |\n| 目标平台 | 抖音小游戏（优先）→ 微信小游戏 → H5 |\n| 核心差异化 | 抖音社交裂变深度集成 + 轻量元进度 + 极简操作 |\n| 开发周期 | 4 周（单人全栈，含提审） |\n| 目标 DAU | 首发 5K → 3 个月 50K |\n| 变现模式 | IAA 为主（激励视频 + 插屏），后续叠加 IAP |\n| 包体目标 | < 4MB |\n| 软著申请 | 开发首日同步启动，预计 2-4 周下发 |\n\n### 设计支柱（不可妥协）\n\n1. **30 秒内上手** — 零学习成本，任何人第一次打开就知道怎么玩\n2. **每次操作都有快感** — 消除、连锁、特效必须持续刺激多巴胺\n3. **每关结束都是广告机会** — 关卡节奏与广告位无缝衔接，不破坏体验\n4. **抖音 = 第一公民** — 所有社交功能优先适配抖音 API，不是后期嫁接\n\n---\n\n## 二、核心玩法机制设计\n\n### 2.1 基础规则\n\n- **棋盘**：8×8 网格，填充 6 种颜色元素（水果主题：苹果红、香蕉黄、葡萄紫、蓝莓蓝、橙子橙、青柠绿）\n- **操作**：触摸滑动交换两个相邻元素（上下左右），不允许对角交换\n- **匹配**：3 个或以上同色水平/垂直连线触发消除\n- **消除后**：上方元素受重力下落 → 顶部生成新元素 → 检测连锁\n- **步数限制**：每关限定步数内完成目标\n\n### 2.2 匹配检测算法（伪代码规格）\n\n```\n输入：8×8 网格状态\n输出：所有匹配组列表\n\n1. 水平扫描：从左到右，对每行寻找连续 >= 3 同色\n   - 记录起始坐标和长度\n2. 垂直扫描：从上到下，对每列寻找连续 >= 3 同色\n   - 记录起始坐标和长度\n3. 合并重叠区域：L/T 形匹配 = 水平匹配与垂直匹配的交集\n4. 按匹配长度分类：\n   - 长度 3 → 普通消除\n   - 长度 4 → 生成条纹炸弹（方向 = 匹配方向垂直）\n   - 长度 5 → 生成彩虹方块\n   - L/T 形 → 生成区域炸弹（3×3 爆炸范围）\n\n性能要求：单次检测 < 1ms（8×8 网格遍历量极小）\n```\n\n### 2.3 特殊方块系统\n\n| 方块类型 | 生成条件 | 效果 | 视觉标识 |\n|----------|----------|------|----------|\n| 条纹炸弹 | 4 连线 | 消除整行或整列 | 方块带横/竖条纹 + 发光 |\n| 区域炸弹 | L 形 / T 形匹配 | 爆炸消除 3×3 范围 | 方块带十字准星 |\n| 彩虹方块 | 5 连线 | 选中后消除棋盘上所有同色方块 | 七彩渐变 + 流光动画 |\n| 彩虹 + 条纹 | 彩虹与条纹相邻交换 | 所有同色方块变为条纹炸弹并激活 | 组合特效：彩虹漩涡 → 全屏条纹发射 |\n| 彩虹 + 区域 | 彩虹与区域炸弹相邻交换 | 所有同色方块变为区域炸弹并激活 | 组合特效：彩虹漩涡 → 全屏爆炸 |\n| 条纹 + 条纹 | 两条纹相邻交换 | 同时消除一行 + 一列（十字形） | 十字光束 |\n| 区域 + 区域 | 两区域炸弹相邻交换 | 爆炸范围扩大到 5×5 | 大爆炸特效 |\n\n### 2.4 障碍物系统\n\n| 障碍物 | 机制 | 消除方式 | 引入关卡段 |\n|--------|------|----------|-----------|\n| 冰块 | 覆盖在方块上，方块被消除时冰块碎裂 | 消除冰块下方的方块 | 21-30 |\n| 双层冰块 | 需要消除下方方块两次 | 同上，需两次 | 51-80 |\n| 链条 | 锁定方块位置，不能交换 | 相邻方块消除时连锁消除链条 | 31-50 |\n| 泥土 | 占据格位，不可移动 | 相邻消除 3 次清除 | 41-60 |\n| 巧克力 | 每回合未消除则向相邻空格扩散 | 消除相邻方块阻止扩散 | 81-120 |\n| 障碍箱 | 需要相邻消除 N 次才打开 | 相邻方块消除累计伤害 | 61-100 |\n| 彩虹锁 | 锁定特定颜色，该色不可消除 | 彩虹方块直接解锁 | 101+ |\n\n**障碍物组合规则**（从关卡 51 开始）：\n- 冰块 + 链条：方块被锁住且被冰覆盖，需先破链再破冰\n- 泥土 + 巧克力：泥土被清除后巧克力可能扩散到该位置\n- 障碍箱 + 冰块：箱内方块被冰覆盖，需先破冰再伤害箱子\n\n### 2.5 关卡目标类型\n\n| 目标类型 | 规则 | 占比 | 配置示例 |\n|----------|------|------|----------|\n| **分数达标** | 限步内达到目标分数 | 40% | 25 步内达到 5000 分 |\n| **收集颜色** | 消除指定数量的特定颜色方块 | 25% | 消除 30 个红色 + 20 个蓝色 |\n| **清除障碍** | 消除棋盘上所有指定障碍物 | 20% | 清除 15 块冰 |\n| **材料收集** | 将材料方块从底部导出棋盘 | 10% | 收集 5 个蜂蜜罐 |\n| **Boss 挑战** | 消除方块对 Boss 造成伤害，Boss 血量归零前完成 | 5% | Boss 300 HP，每消除 1 方块 -1 HP |\n\n### 2.6 连锁系统（核心爽感来源）\n\n```\n玩家交换 → 检测匹配 → 标记消除 → 播放消除动画（0.3s）\n→ 检测特殊方块触发 → 播放特殊效果（0.2s）\n→ 重力下落 → 顶部填充 → 再次检测匹配\n→ 如有新匹配 → 连锁！→ 连锁计数 +1 → 分数倍率 = 1 + 0.5 × 连锁数\n→ 重复直到无新匹配 → 结算本操作\n→ 回到玩家操作\n\n连锁奖励：\n- 2 连锁：1.5x 分数 + \"不错！\" 文字弹出\n- 3 连锁：2.0x 分数 + \"太棒了！\" + 短暂屏幕震动\n- 4+ 连锁：2.5x+ 分数 + \"超赞！！\" + 全屏光效 + 额外赠送 1 步\n```\n\n**动画时间预算**（单次操作总动画不超过 2 秒）：\n- 消除动画：0.3s\n- 下落动画：0.2s（加速）\n- 填充动画：0.15s\n- 特殊效果：0.2s\n- 连锁间停顿：0.1s\n\n### 2.7 关卡失败与续命\n\n| 事件 | 玩家选择 | 结果 |\n|------|----------|------|\n| 步数耗尽但未达标 | 看激励视频（30s） | 获得 5 步续命，可续命 1 次 |\n| 步数耗尽但未达标 | 使用 10 金币购买 | 获得 5 步续命 |\n| 步数耗尽但未达标 | 放弃 | 回到关卡地图，扣 0 生命 |\n\n---\n\n## 三、关卡系统设计（首发 50 关）\n\n### 3.1 关卡数据结构\n\n```json\n{\n  \"id\": 1,\n  \"grid\": [\n    [1, 2, 3, 4, 5, 6, 1, 2],\n    [3, 4, 1, 2, 3, 4, 5, 6],\n    ...\n  ],\n  \"goal\": {\n    \"type\": \"score\",\n    \"target\": 2000\n  },\n  \"moves\": 30,\n  \"stars\": [2000, 3500, 5000],\n  \"obstacles\": [],\n  \"specials\": [],\n  \"tutorial_step\": null\n}\n```\n\n| 字段 | 类型 | 说明 |\n|------|------|------|\n| id | int | 关卡编号 |\n| grid | int[8][8] | 初始布局（0=空, 1-6=颜色, 负数=障碍物） |\n| goal | object | 目标类型和参数 |\n| moves | int | 步数限制 |\n| stars | int[3] | 1/2/3 星分数阈值 |\n| obstacles | array | 本关障碍物配置 |\n| specials | array | 本关特殊规则（如\"本关不会生成绿色\"） |\n| tutorial_step | string/null | 关联的教学步骤 ID |\n\n### 3.2 前 50 关详细设计\n\n#### 第 1-10 关：纯教学（零失败区）\n\n| 关卡 | 目标 | 步数 | 星级分数 | 教学内容 |\n|------|------|------|----------|----------|\n| 1 | 分数 1000 | 30 | [1000, 1500, 2000] | 引导滑动交换（强制引导第 1 步） |\n| 2 | 分数 1500 | 28 | [1500, 2200, 3000] | 自由操作，无引导 |\n| 3 | 分数 2000 | 25 | [2000, 3000, 4000] | 引导 4 连 → 合成条纹炸弹 |\n| 4 | 分数 2000 | 25 | [2000, 3000, 4000] | 自由体验条纹炸弹效果 |\n| 5 | 分数 2500 | 25 | [2500, 3500, 4500] | 引导 L 形匹配 → 合成区域炸弹 |\n| 6 | 分数 2500 | 25 | [2500, 3500, 4500] | 自由体验区域炸弹 |\n| 7 | 分数 3000 | 22 | [3000, 4000, 5500] | 引导 5 连 → 合成彩虹方块 |\n| 8 | 分数 3000 | 22 | [3000, 4000, 5500] | 自由体验彩虹方块 |\n| 9 | 收集红 15 蓝 15 | 25 | [2000, 3500, 5000] | 引入收集目标 |\n| 10 | 分数 3500 | 20 | [3500, 5000, 6500] | 综合测试，保证 3 星 |\n\n**设计原则**：\n- 1-10 关保证任何玩家都能 3 星通关\n- 步数至少宽裕 50%（即最优解只需给定步数的 60-70%）\n- 棋盘布局偏向容易形成长链和连锁\n\n#### 第 11-20 关：基础挑战\n\n| 关卡 | 目标 | 步数 | 星级分数 | 新元素 |\n|------|------|------|----------|--------|\n| 11 | 分数 4000 | 22 | [4000, 5500, 7000] | 步数开始收紧 |\n| 12 | 收集红 20 绿 20 | 22 | [2500, 4000, 5500] | 双色收集 |\n| 13 | 分数 4500 | 20 | [4500, 6000, 8000] | — |\n| 14 | 收集蓝 25 紫 25 | 20 | [3000, 4500, 6000] | — |\n| 15 | 分数 5000 | 20 | [5000, 6500, 8500] | 引导组合特殊方块 |\n| 16 | 收集红 30 黄 20 | 18 | [3500, 5000, 6500] | — |\n| 17 | 分数 5000 | 18 | [5000, 7000, 9000] | — |\n| 18 | 收集蓝 20 绿 30 | 18 | [3000, 4500, 6000] | — |\n| 19 | 分数 5500 | 18 | [5500, 7500, 9500] | 难度微增 |\n| 20 | 分数 6000 | 18 | [6000, 8000, 10000] | Boss 关（Boss 100 HP，教学向） |\n\n**设计原则**：\n- 步数宽裕度降至 30-40%\n- 引入双色收集增加策略性\n- 第 20 关作为第一章 Boss，消除伤害 = 普通 HP 扣减\n\n#### 第 21-35 关：冰块时代\n\n| 关卡 | 目标 | 步数 | 新元素 | 星级分数 |\n|------|------|------|--------|----------|\n| 21 | 清除冰块 8 | 25 | 冰块首次出现 | [2000, 3500, 5000] |\n| 22 | 清除冰块 10 | 24 | — | [2500, 4000, 5500] |\n| 23 | 分数 5000 + 清除冰块 6 | 22 | 双目标 | [5000, 6500, 8000] |\n| 24 | 清除冰块 12 | 22 | — | [2500, 4000, 5500] |\n| 25 | 收集红 25 + 清除冰块 8 | 20 | — | [3000, 4500, 6000] |\n| 26-30 | 渐进混合 | 20-22 | 冰块密度增加 | 渐进 |\n| 31 | 清除链条 8 | 22 | 链条首次出现 | [2500, 4000, 5500] |\n| 32 | 清除链条 10 | 20 | — | [3000, 4500, 6000] |\n| 33 | 清除冰块 6 + 链条 6 | 20 | 冰块 + 链条组合 | [3000, 4500, 6000] |\n| 34 | 分数 6000 + 清除链条 8 | 18 | — | [6000, 8000, 10000] |\n| 35 | Boss 200 HP | 18 | Boss + 冰块 | [5000, 7000, 9000] |\n\n#### 第 36-50 关：混合进阶\n\n| 关卡段 | 关卡 | 新元素 | 设计思路 |\n|--------|------|--------|----------|\n| 36-40 | 5 关 | 泥土 | 泥土引入，需多次相邻消除 |\n| 41-45 | 5 关 | 障碍箱 | 箱子 HP 3-5，组合已有障碍 |\n| 46-49 | 4 关 | 全类型混合 | 难度曲线上升，步数 18-20 |\n| 50 | Boss 关 | Boss 300 HP + 障碍 | 里程碑 Boss，难度中等偏上 |\n\n**关卡验证规则**：\n- 每关通过 BFS/DFS 验证可解性\n- 1 星必须能在给定步数 80% 内完成\n- 3 星需要合理利用特殊方块和连锁\n- 棋盘不能出现初始就有 3 连的情况（除非教学关卡故意设置）\n\n### 3.3 关卡生成工具（开发辅助）\n\n开发阶段需要一个简单的关卡编辑器/验证器：\n\n```\n输入：JSON 关卡数据\n输出：PASS/FAIL + 最少步数\n\n1. 模拟棋盘初始状态\n2. BFS 搜索所有可能的交换序列\n3. 计算最优解步数\n4. 验证：最优解步数 <= 给定步数 × 0.7（保证 1 星可达）\n5. 验证：最优解步数 × 0.4 >= 给定步数（保证有挑战性）\n```\n\n> 注：完整 50 关 JSON 数据将在开发阶段由设计师 + 工具共同产出，此处定义结构和设计规范。\n\n---\n\n## 四、变现策略细节\n\n### 4.1 广告位详细设计\n\n#### 广告位 1：续步激励视频（最高优先级）\n\n| 属性 | 值 |\n|------|-----|\n| 触发条件 | 关卡失败（步数耗尽且未达标） |\n| 广告类型 | 激励视频（穿山甲 rewardedVideoAd） |\n| 视频时长 | 15-30 秒 |\n| 用户奖励 | +5 步续命（每关限 1 次） |\n| UI 设计 | 失败弹窗：左侧\"放弃\"按钮（灰色小字），右侧\"看视频继续\"按钮（金色高亮，带播放图标） |\n| 预估触发率 | 30-40% 的关卡会失败，其中 70% 选择看视频 |\n\n#### 广告位 2：开局增益激励视频\n\n| 属性 | 值 |\n|------|-----|\n| 触发条件 | 关卡开始前的\"准备\"界面 |\n| 广告类型 | 激励视频 |\n| 用户奖励 | 开局随机获得 1 个条纹炸弹（放置在棋盘上） |\n| UI 设计 | 关卡准备页底部横幅：\"观看视频获得开局炸弹\" + 炸弹图标动画 |\n| 预估触发率 | 40-50% 的玩家会选择观看 |\n\n#### 广告位 3：双倍结算激励视频\n\n| 属性 | 值 |\n|------|-----|\n| 触发条件 | 关卡成功结算页 |\n| 广告类型 | 激励视频 |\n| 用户奖励 | 本关金币奖励翻倍 |\n| UI 设计 | 结算页底部按钮：\"领取 ×1\"（普通） vs \"看视频领取 ×2\"（高亮动画） |\n| 预估触发率 | 50-60%（因为已经成功，心情好，更愿意看） |\n\n#### 广告位 4：关卡间插屏\n\n| 属性 | 值 |\n|------|-----|\n| 触发条件 | 每通过 3 关后，从结算页返回地图时 |\n| 广告类型 | 插屏广告（5 秒后可关闭） |\n| 用户奖励 | 无（不可跳过前 5 秒） |\n| UI 设计 | 全屏展示，右上角 5 秒倒计时 → 变为\"关闭\"按钮 |\n| 预估频率 | 每通关 3 关 1 次，约 2-3 次/天 |\n\n#### 广告位 5：宝箱加速激励视频\n\n| 属性 | 值 |\n|------|-----|\n| 触发条件 | 地图上的进度宝箱（每 10 关出现一个），倒计时解锁 |\n| 广告类型 | 激励视频 |\n| 用户奖励 | 立即解锁宝箱（跳过等待） |\n| UI 设计 | 宝箱倒计时界面 + \"立即开启\"视频按钮 |\n| 预估触发率 | 60-70%（宝箱奖励吸引力强） |\n\n#### 广告位 6：每日签到翻倍\n\n| 属性 | 值 |\n|------|-----|\n| 触发条件 | 每日登录签到时 |\n| 广告类型 | 激励视频 |\n| 用户奖励 | 今日登录奖励翻倍 |\n| UI 设计 | 签到弹窗底部：\"看视频翻倍今日奖励\" |\n\n### 4.2 广告展示频率控制（防骚扰）\n\n```\n规则：\n- 同一广告位两次触发最小间隔：60 秒\n- 激励视频每日总上限：12 次（超出后隐藏激励视频按钮）\n- 插屏广告每日总上限：6 次\n- 连续 2 次失败后暂停展示插屏（避免挫败感叠加）\n- 新用户前 3 关不展示任何广告\n```\n\n### 4.3 内购道具（后续迭代，首版不包含）\n\n| 道具 | 价格（¥） | 效果 | 上线时机 |\n|------|-----------|------|----------|\n| 去广告 | 12 | 永久移除所有非激励视频广告 | V1.1 |\n| 金币包 S | 6 | 500 金币 | V1.1 |\n| 金币包 M | 18 | 2000 金币（+10%赠送） | V1.1 |\n| 金币包 L | 30 | 4000 金币（+20%赠送） | V1.1 |\n| 月卡 | 25/月 | 每日 200 金币 + 专属角色 + 去广告 | V1.2 |\n\n### 4.4 金币经济（IAA 获取为主）\n\n| 来源 | 金币/次 | 频率 |\n|------|---------|------|\n| 通关 1 星 | 10 | 每次 |\n| 通关 2 星 | 20 | 每次 |\n| 通关 3 星 | 30 | 每次 |\n| 每日登录 Day 1-7 | 10/20/40/80/150/300/500 | 每日 |\n| 宝箱（每 10 关） | 100-300 | 每 10 关 |\n| 每日任务完成 | 50-100 | 每日 |\n| 好友助力 | 20 | 每日上限 3 次 |\n\n| 消耗 | 金币/次 | 说明 |\n|------|---------|------|\n| 续步（非广告） | 10 | 每关限 1 次 |\n| 购买开局道具 | 5-15 | 条纹炸弹/区域炸弹 |\n| 角色碎片 | 50 | 每 10 碎片兑换 1 角色 |\n\n**经济平衡目标**：\n- 免费（纯 IAA）玩家每天净收入约 150-300 金币\n- 日均消耗约 50-100 金币（用于续步和道具）\n- 每周可攒够兑换 1 个角色碎片包\n- 不存在经济死胡同（任何消耗品都可通过广告获取）\n\n---\n\n## 五、技术方案\n\n### 5.1 技术栈选型\n\n| 组件 | 选型 | 理由 |\n|------|------|------|\n| 渲染引擎 | **Canvas 2D**（`tt.createCanvas()`） | 三消无需 WebGL，Canvas 2D 足够且兼容性最好 |\n| 编程语言 | **原生 JavaScript**（ES6+） | 无需编译步骤，最小依赖，包体最小 |\n| 动画 | 自写缓动库（tween.js 轻量替代） | 避免 50KB+ 的 tween 库，三消动画类型有限 |\n| 粒子效果 | 自写粒子系统 | 消除特效只需 3-5 种粒子模板 |\n| 音频 | `tt.createInnerAudioContext()` | 抖音原生 API |\n| 广告 | 穿山甲 SDK（csjplatform.com） | 抖音官方广告平台 |\n| 数据存储 | `tt.setStorageSync()` + 云开发 | 本地进度 + 云端排行榜 |\n| 社交 | `tt.shareAppMessage()` + `tt.getFriendCloudStorage()` | 抖音好友关系链 |\n| 构建工具 | 无（直接编写） | 抖音小游戏无需 webpack 等构建 |\n| 代码规范 | ESLint + Prettier | 统一代码风格 |\n\n**不使用游戏引擎的理由**：\n- 三消逻辑简单，引擎引入 1MB+ 开销\n- Canvas 2D API 对 8×8 网格绑绑有余\n- 原生 JS 最小化包体，审核更快，加载更快\n\n### 5.2 项目文件结构\n\n```\nmatch-and-blast/\n├── tt/                        # 抖音小游戏入口\n│   ├── game.js               # 入口文件：初始化 Canvas、启动游戏\n│   ├── game.json             # 小游戏配置（屏幕方向、API 权限声明）\n│   └── project.config.json   # 抖音开发者工具配置（AppID 等）\n│\n├── src/\n│   ├── core/                 # 核心游戏逻辑\n│   │   ├── board.js          # 棋盘状态管理（8×8 网格）\n│   │   ├── match-engine.js   # 匹配检测算法（水平/垂直/L-T 形）\n│   │   ├── gravity.js        # 重力下落 + 填充逻辑\n│   │   ├── chain.js          # 连锁检测与计分\n│   │   ├── special-tiles.js  # 特殊方块生成与触发\n│   │   ├── swap.js           # 交换验证与执行\n│   │   └── obstacles.js      # 障碍物逻辑（冰块/链条/泥土等）\n│   │\n│   ├── game/                 # 游戏系统\n│   │   ├── state-machine.js  # 游戏状态机（LOADING→MENU→PLAYING→RESULT）\n│   │   ├── level-manager.js  # 关卡加载、目标判定、星级计算\n│   │   ├── level-goals.js    # 目标系统（分数/收集/清除/Boss）\n│   │   ├── score.js          # 分数计算（含连锁倍率）\n│   │   ├── moves.js          # 步数管理\n│   │   └── tutorial.js       # 新手引导序列\n│   │\n│   ├── meta/                 # 元进度系统\n│   │   ├── map.js            # 地图界面与进度\n│   │   ├── characters.js     # 角色系统与技能\n│   │   ├── daily.js          # 每日登录 + 每日任务 + 每日挑战\n│   │   ├── economy.js        # 金币经济管理\n│   │   └── rewards.js        # 宝箱/成就/里程碑奖励\n│   │\n│   ├── social/               # 社交与裂变\n│   │   ├── share.js          # 分享（tt.shareAppMessage）\n│   │   ├── friends.js        # 好友排行榜（tt.getFriendCloudStorage）\n│   │   ├── pk.js             # 好友 PK 逻辑\n│   │   └── invite.js         # 邀请助力\n│   │\n│   ├── monetization/         # 变现\n│   │   ├── ad-manager.js     # 穿山甲广告管理（初始化/预加载/展示/频率控制）\n│   │   └── iap.js            # 内购（后续版本）\n│   │\n│   ├── render/               # 渲染层\n│   │   ├── renderer.js       # Canvas 主渲染循环\n│   │   ├── tile-renderer.js  # 方块绘制（6 色 + 特殊方块）\n│   │   ├── obstacle-renderer.js # 障碍物绘制\n│   │   ├── animation.js      # 动画系统（缓动 + 补间）\n│   │   ├── particles.js      # 粒子效果系统\n│   │   ├── ui.js             # UI 组件（按钮/弹窗/文字）\n│   │   └── map-renderer.js   # 地图界面渲染\n│   │\n│   ├── audio/                # 音频\n│   │   └── audio-manager.js  # 音效管理（消除/连锁/特殊/BGM）\n│   │\n│   ├── input/                # 输入处理\n│   │   └── touch-handler.js  # 触摸事件（滑动方向判定 + 点击）\n│   │\n│   ├── data/                 # 数据\n│   │   └── storage.js        # 持久化（tt.setStorageSync 封装）\n│   │\n│   └── platform/             # 平台适配\n│       ├── douyin.js         # 抖音 API 封装\n│       └── wechat.js         # 微信 API 适配层（tt.* → wx.* 映射）\n│\n├── data/\n│   ├── levels/\n│   │   ├── chapter-01.json   # 第 1-10 关\n│   │   ├── chapter-02.json   # 第 11-20 关\n│   │   ├── chapter-03.json   # 第 21-35 关\n│   │   ├── chapter-04.json   # 第 36-50 关\n│   │   └── weekly/           # 每周更新关卡\n│   ├── characters.json       # 角色配置\n│   ├── daily-tasks.json      # 每日任务模板\n│   └── economy.json          # 经济数值配置\n│\n├── assets/\n│   ├── tiles/                # 方块精灵图（6 色 × 4 帧 = 24 张，每张 < 5KB）\n│   ├── effects/              # 消除特效帧动画（爆炸/光效/粒子）\n│   ├── characters/           # 角色立绘（4 个角色 × 2 帧 = 8 张）\n│   ├── maps/                 # 地图背景（5 个主题 × 1 张 = 5 张）\n│   ├── ui/                   # UI 元素（按钮/弹窗/图标）\n│   └── audio/                # 音效（< 200KB 总计）\n│       ├── sfx/              # 音效（消除/连锁/失败/成功）\n│       └── bgm/              # 背景音乐（1-2 首，循环）\n│\n├── tools/                    # 开发辅助工具\n│   └── level-validator.js    # 关卡可解性验证器（BFS）\n│\n└── README.md\n```\n\n### 5.3 抖音小游戏 SDK 集成要点\n\n#### 入口文件 game.js\n\n```javascript\n// 最小入口示例\nconst canvas = tt.createCanvas();\nconst ctx = canvas.getContext('2d');\nconst { pixelRatio, windowWidth, windowHeight } = tt.getSystemInfoSync();\n\ncanvas.width = windowWidth * pixelRatio;\ncanvas.height = windowHeight * pixelRatio;\nctx.scale(pixelRatio, pixelRatio);\n\nimport { Game } from '../src/core/state-machine.js';\nconst game = new Game(canvas, ctx);\ngame.start();\n```\n\n#### 广告初始化\n\n```javascript\n// ads-manager.js 核心流程\nclass AdManager {\n  constructor() {\n    this.rewardedAd = null;\n    this.interstitialAd = null;\n    this.dailyCount = { rewarded: 0, interstitial: 0 };\n    this.lastShowTime = {};\n  }\n\n  init() {\n    // 激励视频\n    this.rewardedAd = tt.createRewardedVideoAd({\n      adUnitId: 'adunit-xxx' // 穿山甲后台获取\n    });\n    this.rewardedAd.onError((err) => console.warn('激励视频加载失败', err));\n    this.rewardedAd.load(); // 预加载\n\n    // 插屏\n    this.interstitialAd = tt.createInterstitialAd({\n      adUnitId: 'adunit-yyy'\n    });\n  }\n\n  async showRewarded(placement) {\n    if (this.dailyCount.rewarded >= 12) return false;\n    // 频率控制：同位置 60 秒间隔\n    if (this.checkCooldown(placement)) return false;\n\n    return new Promise((resolve) => {\n      this.rewardedAd.onClose((res) => {\n        if (res.isEnded) {\n          this.dailyCount.rewarded++;\n          this.lastShowTime[placement] = Date.now();\n          resolve(true);\n        } else {\n          resolve(false);\n        }\n      });\n      this.rewardedAd.show().catch(() => resolve(false));\n    });\n  }\n}\n```\n\n#### 社交分享\n\n```javascript\n// share.js\nfunction shareResult(levelId, score, stars) {\n  tt.shareAppMessage({\n    title: `我在消消消大作战第 ${levelId} 关获得了 ${stars} 星！来挑战我吧`,\n    imageUrl: '/assets/ui/share-bg.jpg', // 400×300 预制分享图\n    query: `from=share&level=${levelId}&inviter=${getUserId()}`\n  });\n}\n```\n\n### 5.4 核心渲染循环\n\n```\nrequestAnimationFrame 循环：\n  1. 处理输入队列（触摸事件 → 交换请求）\n  2. 更新游戏状态\n     - 如果在动画中：推进动画帧\n     - 如果需要检测匹配：执行匹配检测\n     - 如果有连锁：推进连锁\n  3. 渲染\n     - 清除画布\n     - 绘制棋盘背景\n     - 绘制方块（含动画偏移/缩放/透明度）\n     - 绘制障碍物\n     - 绘制特效（粒子/光效）\n     - 绘制 UI（分数/步数/目标进度）\n  4. 处理音频队列\n```\n\n**性能目标**：稳定 60fps，Canvas draw call < 100/帧（8×8 网格 + UI ≈ 70-80 次）\n\n### 5.5 跨平台适配策略\n\n| 层 | 抽象 | 说明 |\n|-----|------|------|\n| 平台 API | `platform/douyin.js` → `platform/wechat.js` | `tt.*` → `wx.*` 一对一映射 |\n| 存储 | `storage.js` 封装 | `tt.setStorageSync` → `wx.setStorageSync` |\n| 广告 | 各平台广告 SDK 不同 | 抖音用穿山甲，微信用广点通 |\n| 分享 | 接口相似，参数不同 | `tt.shareAppMessage` vs `wx.shareAppMessage` |\n| Canvas | 完全兼容 | 两个平台 Canvas 2D API 一致 |\n\n---\n\n## 六、美术风格定义\n\n### 6.1 主题\n\n**\"甜蜜水果乐园\"** — 明亮、圆润、可爱、有食欲感\n\n### 6.2 色彩规范\n\n| 用途 | 颜色 | HEX | 说明 |\n|------|------|-----|------|\n| 背景 | 浅奶油色 | #FFF8E7 | 温暖不刺眼 |\n| 棋盘底色 | 白色带微透明 | #FFFFFF CC | 突出方块 |\n| 红色方块 | 苹果红 | #FF4D4D | 鲜艳饱和 |\n| 黄色方块 | 香蕉黄 | #FFD93D | 明亮温暖 |\n| 蓝色方块 | 蓝莓蓝 | #4DA6FF | 清新 |\n| 绿色方块 | 青柠绿 | #6BCB77 | 自然 |\n| 紫色方块 | 葡萄紫 | #B47AEA | 高级感 |\n| 橙色方块 | 橙子橙 | #FF9A3C | 活力 |\n| 强调色 | 金色 | #FFB800 | 按钮/奖励/星级 |\n| 文字主色 | 深棕 | #5D4037 | 温暖不刺眼 |\n| 文字副色 | 灰棕 | #8D6E63 | 次要信息 |\n\n### 6.3 方块设计规范\n\n- **形状**：圆角正方形，圆角半径 = 边长 × 0.2\n- **内部**：对应水果的简化卡通图标（扁平面风格，无渐变阴影）\n- **尺寸**：方块边长 = 屏幕宽度 / 8.5（留左右边距）\n- **动画帧**：\n  - 待机：微呼吸（scale 0.98-1.02，1.5s 循环）\n  - 选中：放大 10% + 白色描边闪烁\n  - 消除：缩小 + 旋转 + 粒子爆炸（0.3s）\n  - 下落：弹性缓动（overshoot 1.2）\n\n### 6.4 UI 设计规范\n\n| 元素 | 规范 |\n|------|------|\n| 字体 | 系统默认圆体（抖音环境默认），数字用等宽字体 |\n| 按钮 | 圆角矩形（圆角 = 高度 × 0.5），纯色 + 白色文字，按压时缩小 5% |\n| 弹窗 | 白色圆角面板 + 半透明遮罩，底部滑入动画 |\n| 星星 | 金色五角星，从左到右依次弹出（0.2s 间隔） |\n| 进度条 | 圆角长条，填充色为绿色渐变，右侧显示百分比 |\n| 金币图标 | 金色圆形 + \"$\" 符号，数字右对齐 |\n\n### 6.5 地图主题（首发 5 个，每主题 10 关）\n\n| 主题 | 背景色调 | 关卡范围 | 视觉特征 |\n|------|----------|----------|----------|\n| 糖果森林 | 粉绿渐变 | 1-10 | 大树糖果装饰，弯曲路径 |\n| 海底世界 | 蓝绿渐变 | 11-20 | 珊瑚、气泡、水下光线 |\n| 火山岛 | 橙红渐变 | 21-35 | 岩浆、烟雾、火焰粒子 |\n| 冰雪王国 | 蓝白渐变 | 36-45 | 冰晶、雪花、极光 |\n| 魔法城堡 | 紫金渐变 | 46-50+ | 星空、魔法阵、闪光 |\n\n---\n\n## 七、新手引导流程（详细规格）\n\n### 7.1 引导序列\n\n| 步骤 | 时间 | 触发条件 | 引导动作 | UI 表现 |\n|------|------|----------|----------|---------|\n| G1 | 0-3s | 第 1 关开始 | 高亮一个可行交换位置 | 半透明遮罩 + 箭头指向 + 手指动画 |\n| G2 | 3-8s | 玩家完成第 1 次交换 | 无（自动） | 匹配消除 + 大号 \"+100\" 飞字 |\n| G3 | 8-12s | 第 1 次消除后 | 文字提示\"滑动相邻方块交换位置\" | 底部文字条，2s 后淡出 |\n| G4 | 12-20s | 等待玩家操作 2-3 次 | 无引导，让玩家自由操作 | — |\n| G5 | 20-25s | 第 3 关开始 | 高亮 4 连位置 + 箭头 | \"4 个连在一起试试！\" |\n| G6 | 25-30s | 玩家合成条纹炸弹 | 自动触发条纹效果 | 放大条纹效果动画 + \"太厉害了！炸弹！\" |\n| G7 | 30-35s | 第 5 关开始 | 高亮 L 形位置 | \"试试 L 形匹配\" |\n| G8 | 35-40s | 合成区域炸弹 | 自动触发 | 区域爆炸放大动画 |\n| G9 | 40-50s | 第 7 关开始 | 高亮 5 连位置 | \"5 个一排会怎样？\" |\n| G10 | 50-55s | 合成彩虹方块 | 自动触发 | 彩虹特效 + \"彩虹方块！点任意颜色消除全屏！\" |\n\n### 7.2 引导系统技术实现\n\n```javascript\n// tutorial.js\nconst tutorialSteps = [\n  {\n    id: 'G1',\n    level: 1,\n    trigger: 'level_start',\n    action: 'highlight_swap',\n    params: { from: {row: 3, col: 2}, to: {row: 3, col: 3} },\n    text: null,  // 纯视觉引导\n    blockOther: true  // 只允许操作引导位置\n  },\n  // ... 后续步骤\n];\n```\n\n**引导设计原则**：\n- 前 3 关强制引导（`blockOther: true`），之后逐渐放开\n- 每个引导只介绍 1 个概念\n- 引导完成后不再重复\n- 跳过机制：如果检测到玩家已经理解（如已经独立完成过 4 连），自动跳过对应引导\n\n---\n\n## 八、开发排期（4 周里程碑）\n\n### Week 1：核心玩法（MVP）\n\n| 天 | 任务 | 交付物 |\n|----|------|--------|\n| D1 | 项目搭建 + 入口文件 + Canvas 初始化 | 可运行的空白 Canvas |\n| D1 | 棋盘渲染（8×8 网格 + 6 色方块） | 可视化棋盘 |\n| D2 | 触摸输入 + 交换逻辑 | 可以拖动交换方块 |\n| D2 | 匹配检测算法（3 连） | 交换后检测并消除 3 连 |\n| D3 | 重力下落 + 填充 + 连锁检测 | 完整的单次操作循环 |\n| D3 | 消除动画（缩小+粒子） | 消除有视觉反馈 |\n| D4 | 特殊方块（条纹/区域/彩虹） | 4连/L形/5连生成特殊方块 |\n| D4 | 特殊方块效果 | 条纹消行/区域爆炸/彩虹全消 |\n| D5 | 组合效果（彩虹+条纹等） | 特殊方块组合触发 |\n| D5 | 步数系统 + 分数计算 | 限步玩法可玩 |\n\n**W1 里程碑验收**：可以在限步内玩一局完整的三消，含特殊方块和连锁。\n\n### Week 2：完整单局\n\n| 天 | 任务 | 交付物 |\n|----|------|--------|\n| D6 | 关卡配置系统 + JSON 加载 | 可配置不同关卡 |\n| D6 | 关卡目标（分数/收集/清除） | 多种目标类型 |\n| D7 | 障碍物系统（冰块/链条/泥土） | 3 种障碍物 |\n| D7 | Boss 关逻辑 | 消除对 Boss 造成伤害 |\n| D8 | 前 20 关数据制作 + 可解性验证 | 20 个可玩关卡 |\n| D8 | 星级评定 + 通关结算 UI | 1-3 星结算页 |\n| D9 | 失败/续命 UI + 新手引导系统 | 引导序列 + 失败弹窗 |\n| D9 | 音效集成（消除/连锁/失败/成功） | 有声游戏 |\n| D10 | W2 内测 + Bug 修复 | 稳定可玩的 20 关 Demo |\n\n**W2 里程碑验收**：20 关完整可玩，含新手引导、目标系统、障碍物、音效。\n\n### Week 3：元进度 + 社交\n\n| 天 | 任务 | 交付物 |\n|----|------|--------|\n| D11 | 地图界面 + 路径推进 | 可视化关卡地图 |\n| D11 | 角色系统（4 个角色 + 技能） | 可选角色 |\n| D12 | 每日系统（登录/任务/挑战） | 每日内容 |\n| D12 | 金币经济系统 | 金币收入/消耗 |\n| D13 | 抖音分享集成 | 分享到抖音 |\n| D13 | 好友排行榜 | 好友分数排行 |\n| D14 | 好友 PK（同关卡比分数） | PK 模式 |\n| D14 | 好友助力（续命分享） | 分享续命 |\n| D15 | 关卡 21-50 数据 + W3 测试 | 50 关 + 社交功能 |\n\n**W3 里程碑验收**：50 关 + 地图 + 角色 + 每日系统 + 抖音社交功能。\n\n### Week 4：变现 + 上线\n\n| 天 | 任务 | 交付物 |\n|----|------|--------|\n| D16 | 穿山甲 SDK 集成（激励视频） | 广告可展示 |\n| D16 | 广告位 UI（6 个广告位） | 所有广告位就绪 |\n| D17 | 广告频率控制 + 数据埋点 | 广告系统完成 |\n| D17 | 包体优化（资源压缩 + 代码瘦身） | < 4MB |\n| D18 | 全量测试 + Bug 修复 | 无阻塞性 Bug |\n| D18 | 软著材料提交（如已下发） | 提审准备 |\n| D19 | 抖音提审 | 提交审核 |\n| D19 | 备用：修复审核反馈 | 快速迭代 |\n| D20 | 上线 + 监控首日数据 | 正式发布 |\n\n**W4 里程碑验收**：游戏上架抖音小游戏平台，广告变现运行正常。\n\n### 关键依赖\n\n| 依赖项 | 负责人 | 截止时间 | 风险 |\n|--------|--------|----------|------|\n| 抖音开发者账号注册 | 运营/商务 | 开发前 | 低 |\n| 穿山甲广告账号 | 运营/商务 | W3 结束前 | 低 |\n| 软著申请 | 运营/商务 | D1 启动，D20 前下发 | **高（可能延迟 2-4 周）** |\n| 方块精灵图（24 张） | 美术 | W1 结束前 | 中 |\n| 角色立绘（8 张） | 美术 | W2 结束前 | 低 |\n| 地图背景（5 张） | 美术 | W3 结束前 | 低 |\n| 音效（10-15 个） | 音频 | W2 结束前 | 低 |\n| BGM（1-2 首） | 音频 | W3 结束前 | 低 |\n\n---\n\n## 九、数据埋点与运营\n\n### 9.1 关键指标\n\n| 指标 | 定义 | 目标值 | 告警阈值 |\n|------|------|--------|----------|\n| 次日留存 | D1/D0 | 40%+ | < 30% |\n| 7 日留存 | D7/D0 | 20%+ | < 12% |\n| 平均会话时长 | — | 8+ 分钟 | < 4 分钟 |\n| 人均广告次数/天 | — | 6+ 次 | < 3 次 |\n| 激励视频完成率 | — | 85%+ | < 70% |\n| 新手引导完成率 | 完成教学关卡的玩家比例 | 95%+ | < 80% |\n| 关卡通过率（前 10 关） | 单关通过比例 | 90%+ | < 75% |\n| ARPU | 日收入/DAU | ¥0.4+ | < ¥0.2 |\n| CPI（投放时） | 获客成本 | < ¥2 | > ¥5 |\n\n### 9.2 埋点事件\n\n```javascript\n// 关键事件列表\nconst EVENTS = {\n  GAME_START: 'game_start',           // 游戏启动\n  TUTORIAL_STEP: 'tutorial_step',     // 引导步骤\n  LEVEL_START: 'level_start',         // 关卡开始\n  LEVEL_COMPLETE: 'level_complete',   // 关卡完成（含分数/星级/步数）\n  LEVEL_FAIL: 'level_fail',           // 关卡失败（含剩余目标/步数）\n  AD_SHOW: 'ad_show',                 // 广告展示（含广告位/是否完成）\n  AD_CLICK: 'ad_click',               // 广告点击\n  SHARE: 'share',                     // 分享（含分享类型）\n  RETENTION_DAY1: 'retention_d1',     // 次日回访\n  PURCHASE: 'purchase',               // 内购（后续）\n};\n```\n\n---\n\n## 十、风险与缓解\n\n| 风险 | 概率 | 影响 | 缓解措施 |\n|------|------|------|----------|\n| 软著延迟 | 高 | 上线推迟 | D1 立即申请，准备代办加急；同时以个人开发者 IAA 模式先上架 |\n| 三消竞品太强 | 高 | CPI 高 | 差异化靠抖音社交功能（PK/助力），不做纯买量 |\n| 广告 eCPM 低于预期 | 中 | 收入降 | 优化激励视频位置，增加宝箱/签到广告位 |\n| Canvas 性能问题 | 低 | 体验差 | 提前做性能测试；必要时切 Cocos Creator |\n| 留存不达标 | 中 | LTV 低 | 持续更新关卡，AB 测试新手引导，加入每日挑战 |\n| 抖音审核被拒 | 低 | 延迟 1-2 周 | 严格遵循内容规范，准备审核材料清单 |\n\n---\n\n## 十一、版本规划\n\n| 版本 | 时间 | 内容 |\n|------|------|------|\n| **V1.0** | 第 4 周末 | 50 关 + IAA 广告 + 基础社交 + 4 角色 |\n| V1.1 | 上线后 2 周 | 内购道具 + 关卡扩充至 100 关 + 巧克力障碍 |\n| V1.2 | 上线后 4 周 | 月卡系统 + 赛季通行证 + 新角色 |\n| V1.3 | 上线后 6 周 | 微信小游戏版本上线 |\n| V2.0 | 上线后 2 月 | 每周挑战赛 + 排行榜重做 + 直播互动 |\n\n---\n\n## 附录 A：调参表模板\n\n```\n变量                    | 基础值      | 最小值  | 最大值  | 调参备注\n------------------------|------------|---------|---------|---------------------------\n棋盘大小                 | 8×8        | 6×6     | 10×10   | 固定 8×8，不调\n颜色数量                 | 6          | 4       | 7       | [待测试] 6 是否让匹配太难\n连锁分数倍率             | 1+0.5×n    | 1+0.3×n | 1+0.8×n | [待测试] 倍率是否激励足够\n4 连生成条纹概率         | 100%       | 80%     | 100%    | 保持 100%\n失败后续命步数           | 5          | 3       | 8       | [待测试] 5 是否太容易\n续命金币价格             | 10         | 5       | 30      | [待测试]\n新手关步数宽裕度         | 50%        | 30%     | 70%     | 根据新手完成率调整\n插屏广告间隔（关数）     | 3          | 2       | 5       | [待测试] 3 是否太频繁\n激励视频每日上限         | 12         | 8       | 20      | [待测试]\nBoss HP（第 20 关）      | 100        | 50      | 200     | [待测试]\n```\n\n## 附录 B：音效列表\n\n| ID | 音效名 | 触发时机 | 时长 | 风格 |\n|----|--------|----------|------|------|\n| S01 | match_basic | 3 连消除 | 0.2s | 清脆 pop |\n| S02 | match_4 | 4 连消除 | 0.3s | 升调 pop |\n| S03 | match_5 | 5 连消除 | 0.5s | 魔法 sparkle |\n| S04 | chain_2 | 2 连锁 | 0.3s | 快乐升调 |\n| S05 | chain_3 | 3+ 连锁 | 0.5s | 激动管弦 |\n| S06 | special_striped | 条纹炸弹激活 | 0.4s | 嗖—— |\n| S07 | special_bomb | 区域炸弹爆炸 | 0.5s | 低频 boom |\n| S08 | special_rainbow | 彩虹全消 | 0.8s | 魔法 shimmer |\n| S09 | level_complete | 通关 | 1.5s | 欢快 fanfare |\n| S10 | level_fail | 失败 | 1.0s | 温柔 sad |\n| S11 | star_earned | 获得星星 | 0.3s | 叮—— |\n| S12 | button_click | 按钮点击 | 0.1s | 轻触 |\n| S13 | combo_text | 连击文字弹出 | 0.2s | 叮咚 |\n| S14 | boss_hit | Boss 受伤 | 0.3s | 打击感 |\n| S15 | boss_defeat | Boss 击败 | 1.0s | 胜利号角 |\n\n## 附录 C：变更日志\n\n| 版本 | 日期 | 变更内容 |\n|------|------|----------|\n| 1.0 | 2026-05-23 | 初始立项文档 |\n","numLines":883,"startLine":1,"totalLines":883}}}
