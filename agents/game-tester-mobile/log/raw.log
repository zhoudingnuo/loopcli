    const names = ['小明', '小红', '大壮', '阿花', '老王', '小李', '大毛', '阿杰'];\n    return names.map((name, i) => ({\n      id: 'f_' + i,\n      name,\n      avatar: ['😎', '🤗', '💪', '🌸', '🎯', '🎮', '🏆', '✨'][i],\n      maxLevel: Math.floor(Math.random() * 40) + 5,\n      totalStars: Math.floor(Math.random() * 80) + 10,\n      score: Math.floor(Math.random() * 50000) + 5000,\n    }));\n  }\n\n  getUserId() { return this.social.userId; }\n\n  // --- Share ---\n  shareResult(levelId, score, stars) {\n    if (this.isDouyin) {\n      try {\n        tt.shareAppMessage({\n          title: `我在消消消大作战第${levelId}关获得了${stars}星！来挑战我吧`,\n          query: `from=share&level=${levelId}&inviter=${this.getUserId()}`,\n        });\n      } catch (e) { /* fallback */ }\n    }\n    this.social.shareCount++;\n    this.social.sharedToday = true;\n    this.dm.save();\n    return { success: true, type: 'share_result' };\n  }\n\n  shareHelp(levelId) {\n    if (this.isDouyin) {\n      try {\n        tt.shareAppMessage({\n          title: '帮帮我！我卡在这关了，送我5步继续挑战吧！',\n          query: `from=help&level=${levelId}&inviter=${this.getUserId()}`,\n        });\n      } catch (e) { /* fallback */ }\n    }\n    this.social.helpCount++;\n    this.dm.save();\n    return { success: true, type: 'share_help', bonus: '+5步' };\n  }\n\n  // --- Friend Leaderboard ---\n  getLeaderboard() {\n    const me = {\n      id: this.getUserId(),\n      name: '我',\n      avatar: '🎮',\n      score: this._getMyScore(),\n      maxLevel: this.dm.unlockedLevel - 1,\n      isMe: true,\n    };\n    const friends = this.social.friends.map(f => ({\n      ...f,\n      isMe: false,\n      score: f.score + Math.floor(Math.random() * 500) - 250,\n    }));\n    const all = [me, ...friends].sort((a, b) => b.score - a.score);\n    return all;\n  }\n\n  _getMyScore() {\n    let total = 0;\n    for (const key of Object.keys(this.dm.data.levelStars)) {\n      total += (this.dm.data.levelStars[key] || 0) * 1000 + Math.floor(Math.random() * 500);\n    }\n    return total;\n  }\n\n  // --- Friend PK ---\n  startPK(friendId) {\n    const friend = this.social.friends.find(f => f.id === friendId);\n    if (!friend) return null;\n    return {\n      opponent: friend,\n      myMaxLevel: this.dm.unlockedLevel - 1,\n      theirMaxLevel: friend.maxLevel,\n    };\n  }\n\n  resolvePK(friendId, myScore, theirScore) {\n    const won = myScore > theirScore;\n    if (won) {\n      this.social.pkWins++;\n      this.dm.addCoins(20);\n    }\n    this.social.pkHistory.push({\n      friendId, myScore, theirScore, won, time: Date.now(),\n    });\n    if (this.social.pkHistory.length > 20) this.social.pkHistory.shift();\n    this.dm.save();\n    return { won, coinsWon: won ? 20 : 0 };\n  }\n\n  getPKRecord() {\n    return { wins: this.social.pkWins, total: this.social.pkHistory.length };\n  }\n\n  // --- Invite Help ---\n  receiveHelp() {\n    this.dm.addItem('extra_moves', 1);\n    this.dm.save();\n    return { bonus: '+5步道具' };\n  }\n\n  // --- Render ---\n  render(ctx, screenW, screenH) {\n    const grad = ctx.createLinearGradient(0, 0, 0, screenH);\n    grad.addColorStop(0, '#E3F2FD');\n    grad.addColorStop(0.5, '#F3E5F5');\n    grad.addColorStop(1, '#FFF8E7');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, screenW, screenH);\n\n    // Title bar\n    ctx.fillStyle = '#4DA6FF';\n    this._roundRect(ctx, 10, 8, screenW - 20, 48, 12);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('👥 社交中心', screenW / 2, 40);\n\n    // Tab navigation\n    const tabs = ['🏆 排行', '⚔️ PK', '📤 分享'];\n    const tabW = (screenW - 40) / tabs.length;\n    for (let i = 0; i < tabs.length; i++) {\n      const active = (this._tab || 0) === i;\n      ctx.fillStyle = active ? '#FFB800' : '#E8E0D8';\n      this._roundRect(ctx, 20 + i * tabW, 65, tabW - 4, 30, 15);\n      ctx.fill();\n      ctx.fillStyle = active ? '#FFF' : '#8D6E63';\n      ctx.font = 'bold 12px sans-serif';\n      ctx.fillText(tabs[i], 20 + i * tabW + (tabW - 4) / 2, 85);\n    }\n\n    const tab = this._tab || 0;\n    if (tab === 0) this._renderLeaderboard(ctx, screenW, screenH);\n    else if (tab === 1) this._renderPK(ctx, screenW, screenH);\n    else this._renderShare(ctx, screenW, screenH);\n\n    // Back button\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, 20, screenH - 50, screenW - 40, 38, 19);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 14px sans-serif';\n    ctx.fillText('返回地图', screenW / 2, screenH - 27);\n  }\n\n  _renderLeaderboard(ctx, w, h) {\n    const leaders = this.getLeaderboard();\n    const startY = 108;\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 14px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('好友排行榜', w / 2, startY);\n\n    for (let i = 0; i < Math.min(leaders.length, 8); i++) {\n      const l = leaders[i];\n      const ly = startY + 14 + i * 48;\n      ctx.fillStyle = l.isMe ? '#FFE0B2' : '#FFFFFFEE';\n      this._roundRect(ctx, 20, ly, w - 40, 42, 8);\n      ctx.fill();\n\n      if (l.isMe) {\n        ctx.strokeStyle = '#FFB800';\n        ctx.lineWidth = 2;\n        this._roundRect(ctx, 20, ly, w - 40, 42, 8);\n        ctx.stroke();\n      }\n\n      // Rank\n      ctx.textAlign = 'left';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillStyle = i < 3 ? ['#FFD700', '#C0C0C0', '#CD7F32'][i] : '#8D6E63';\n      const medals = ['🥇', '🥈', '🥉'];\n      ctx.fillText(i < 3 ? medals[i] : `${i + 1}`, 30, ly + 28);\n\n      // Avatar\n      ctx.font = '22px sans-serif';\n      ctx.fillText(l.avatar, 65, ly + 30);\n\n      // Name & score\n      ctx.font = 'bold 13px sans-serif';\n      ctx.fillStyle = '#5D4037';\n      ctx.fillText(l.name + (l.isMe ? ' (我)' : ''), 95, ly + 18);\n      ctx.font = '11px sans-serif';\n      ctx.fillStyle = '#8D6E63';\n      ctx.fillText(`Lv.${l.maxLevel} | ${l.score.toLocaleString()}分`, 95, ly + 34);\n    }\n  }\n\n  _renderPK(ctx, w, h) {\n    const startY = 108;\n    const record = this.getPKRecord();\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 14px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(`PK战绩: ${record.wins}胜 / ${record.total}场`, w / 2, startY);\n\n    const friends = this.social.friends.slice(0, 6);\n    for (let i = 0; i < friends.length; i++) {\n      const f = friends[i];\n      const fy = startY + 14 + i * 52;\n      ctx.fillStyle = '#FFFFFFEE';\n      this._roundRect(ctx, 20, fy, w - 40, 46, 8);\n      ctx.fill();\n\n      ctx.textAlign = 'left';\n      ctx.font = '20px sans-serif';\n      ctx.fillText(f.avatar, 30, fy + 30);\n      ctx.font = 'bold 13px sans-serif';\n      ctx.fillStyle = '#5D4037';\n      ctx.fillText(f.name, 58, fy + 20);\n      ctx.font = '11px sans-serif';\n      ctx.fillStyle = '#8D6E63';\n      ctx.fillText(`Lv.${f.maxLevel} | ${f.score.toLocaleString()}分`, 58, fy + 36);\n\n      // Challenge button\n      ctx.fillStyle = '#FF4D4D';\n      this._roundRect(ctx, w - 90, fy + 8, 58, 30, 15);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 12px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText('挑战', w - 61, fy + 28);\n    }\n  }\n\n  _renderShare(ctx, w, h) {\n    const startY = 108;\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 14px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(`已分享 ${this.social.shareCount} 次`, w / 2, startY);\n\n    const buttons = [\n      { label: '分享战绩', emoji: '🏆', color: '#6BCB77', desc: '分享给好友炫耀' },\n      { label: '求助续命', emoji: '🆘', color: '#FF4D4D', desc: '好友助力+5步' },\n      { label: '邀请好友', emoji: '🎁', color: '#B47AEA', desc: '邀请得20🪙' },\n    ];\n\n    for (let i = 0; i < buttons.length; i++) {\n      const b = buttons[i];\n      const by = startY + 20 + i * 70;\n      ctx.fillStyle = b.color + '20';\n      this._roundRect(ctx, 20, by, w - 40, 60, 12);\n      ctx.fill();\n      ctx.strokeStyle = b.color;\n      ctx.lineWidth = 2;\n      this._roundRect(ctx, 20, by, w - 40, 60, 12);\n      ctx.stroke();\n\n      ctx.font = '28px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText(b.emoji, w / 2 - 80, by + 38);\n      ctx.textAlign = 'left';\n      ctx.fillStyle = '#5D4037';\n      ctx.font = 'bold 14px sans-serif';\n      ctx.fillText(b.label, w / 2 - 50, by + 28);\n      ctx.font = '11px sans-serif';\n      ctx.fillStyle = '#8D6E63';\n      ctx.fillText(b.desc, w / 2 - 50, by + 46);\n    }\n  }\n\n  handleClick(x, y, screenW, screenH) {\n    // Tab clicks\n    const tabs = 3;\n    const tabW = (screenW - 40) / tabs;\n    if (y >= 65 && y <= 95) {\n      for (let i = 0; i < tabs; i++) {\n        const tx = 20 + i * tabW;\n        if (x >= tx && x <= tx + tabW - 4) {\n          this._tab = i;\n          return { action: 'switch_tab', tab: i };\n        }\n      }\n    }\n\n    const tab = this._tab || 0;\n    if (tab === 1) {\n      // PK challenge buttons\n      const startY = 108;\n      const friends = this.social.friends.slice(0, 6);\n      for (let i = 0; i < friends.length; i++) {\n        const fy = startY + 14 + i * 52;\n        if (x >= screenW - 90 && x <= screenW - 32 && y >= fy + 8 && y <= fy + 38) {\n          return { action: 'pk', friendId: friends[i].id };\n        }\n      }\n    }\n\n    if (tab === 2) {\n      // Share buttons\n      const startY = 108;\n      for (let i = 0; i < 3; i++) {\n        const by = startY + 20 + i * 70;\n        if (x >= 20 && x <= screenW - 20 && y >= by && y <= by + 60) {\n          if (i === 0) return { action: 'share_result' };\n          if (i === 1) return { action: 'share_help' };\n          if (i === 2) {\n            this.social.shareCount++;\n            this.dm.addCoins(20);\n            this.dm.save();\n            return { action: 'share_invite', reward: 20 };\n          }\n        }\n      }\n    }\n\n    // Back button\n    if (y >= screenH - 50 && y <= screenH - 12 && x >= 20 && x <= screenW - 20) {\n      return { action: 'back' };\n    }\n\n    return null;\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { SocialSystem };\n","numLines":364,"startLine":1,"totalLines":364}}}
