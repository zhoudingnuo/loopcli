{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ac159489c8ba4363adb070b1","type":"tool_result","content":"1\t<!DOCTYPE html>\n2\t<html lang=\"zh-CN\">\n3\t<head>\n4\t  <meta charset=\"UTF-8\">\n5\t  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no, maximum-scale=1.0\">\n6\t  <meta name=\"screen-orientation\" content=\"portrait\">\n7\t  <meta name=\"x5-orientation\" content=\"portrait\">\n8\t  <meta name=\"format-detection\" content=\"telephone=no\">\n9\t  <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n10\t  <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n11\t  <title>消消消大作战</title>\n12\t  <style>\n13\t    * { margin: 0; padding: 0; box-sizing: border-box; }\n14\t    html, body {\n15\t      width: 100%; height: 100%;\n16\t      overflow: hidden;\n17\t      background: #FFF8E7;\n18\t      touch-action: none;\n19\t      -webkit-user-select: none;\n20\t      user-select: none;\n21\t      -webkit-touch-callout: none;\n22\t    }\n23\t    canvas {\n24\t      display: block;\n25\t      width: 100%;\n26\t      height: 100%;\n27\t    }\n28\t  </style>\n29\t</head>\n30\t<body>\n31\t  <canvas id=\"gameCanvas\"></canvas>\n32\t\n33\t  <!-- Phase 1+2: Core modules -->\n34\t  <script src=\"src/js/Board.js\"></script>\n35\t  <script src=\"src/js/MatchEngine.js\"></script>\n36\t  <script src=\"src/js/Animation.js\"></script>\n37\t  <script src=\"src/js/Obstacle.js\"></script>\n38\t  <script src=\"src/js/AudioManager.js\"></script>\n39\t  <script src=\"src/js/Boss.js\"></script>\n40\t  <script src=\"src/js/levels.js\"></script>\n41\t  <script src=\"src/js/Renderer.js\"></script>\n42\t  <script src=\"src/js/InputHandler.js\"></script>\n43\t  <script src=\"src/js/ScoreSystem.js\"></script>\n44\t\n45\t  <!-- Phase 3a: Meta-progression modules -->\n46\t  <script src=\"src/js/DataManager.js\"></script>\n47\t  <script src=\"src/js/CoinSystem.js\"></script>\n48\t  <script src=\"src/js/Characters.js\"></script>\n49\t  <script src=\"src/js/MapScreen.js\"></script>\n50\t  <script src=\"src/js/ShopUI.js\"></script>\n51\t\n52\t  <!-- Phase 3b: Daily + Social -->\n53\t  <script src=\"src/js/DailySystem.js\"></script>\n54\t  <script src=\"src/js/SocialSystem.js\"></script>\n55\t\n56\t  <!-- Phase 4: Ads + Analytics -->\n57\t  <script src=\"src/js/ad-config.js\"></script>\n58\t  <script src=\"src/js/AdManager.js\"></script>\n59\t  <script src=\"src/js/Analytics.js\"></script>\n60\t\n61\t  <script src=\"src/js/Navigation.js\"></script>\n62\t\n63\t  <!-- Main game -->\n64\t  <script src=\"src/js/Game.js\"></script>\n65\t\n66\t  <script>\n67\t    const canvas = document.getElementById('gameCanvas');\n68\t    const game = new Game(canvas);\n69\t\n70\t    // Handle resize\n71\t    function onResize() {\n72\t      game.renderer.resize();\n73\t      game.input.updateLayout(\n74\t        game.renderer.tileSize,\n75\t        game.renderer.boardX,\n76\t        game.renderer.boardY,\n77\t      );\n78\t    }\n79\t\n80\t    window.addEventListener('resize', onResize);\n81\t    window.addEventListener('orientationchange', () => setTimeout(onResize, 100));\n82\t\n83\t    // Unified click handler — routes through Navigation (non-board interactions only)\n84\t    canvas.addEventListener('click', (e) => {\n85\t      // Skip if InputHandler already processed a swipe\n86\t      if (game.input._lastInteraction === 'swipe') {\n87\t        game.input._lastInteraction = null;\n88\t        return;\n89\t      }\n90\t      game.input._lastInteraction = null;\n91\t\n92\t      const rect = canvas.getBoundingClientRect();\n93\t      const x = e.clientX - rect.left;\n94\t      const y = e.clientY - rect.top;\n95\t      const w = game.renderer.screenW;\n96\t      const h = game.renderer.screenH;\n97\t\n98\t      // Phase 4: ad stub overlay consumes clicks first\n99\t      if (game.adManager.handleStubClick(x, y, w, h)) return;\n100\t\n101\t      // Navigation screens\n102\t      if (game.nav.isActive()) {\n103\t        game.nav.handleClick(x, y, w, h);\n104\t        return;\n105\t      }\n106\t\n107\t      // In-game: check back-to-map button\n108\t      const backX = w - 50;\n109\t      const backY = game.renderer.boardY + game.renderer.tileSize * BOARD_SIZE + 25;\n110\t      if (x >= backX && x <= backX + 40 && y >= backY && y <= backY + 28) {\n111\t        game.nav.goTo('map');\n112\t        return;\n113\t      }\n114\t    });\n115\t\n116\t    // Touch handler for Navigation screens (click events are suppressed by InputHandler preventDefault)\n117\t    canvas.addEventListener('touchend', (e) => {\n118\t      if (!game.nav.isActive()) {\n119\t        // Back-to-map button during gameplay\n120\t        const t = e.changedTouches[0];\n121\t        if (!t) return;\n122\t        const rect = canvas.getBoundingClientRect();\n123\t        const x = t.clientX - rect.left;\n124\t        const y = t.clientY - rect.top;\n125\t        const w = game.renderer.screenW;\n126\t        const backX = w - 50;\n127\t        const backY = game.renderer.boardY + game.renderer.tileSize * BOARD_SIZE + 25;\n128\t        if (x >= backX && x <= backX + 40 && y >= backY && y <= backY + 28) {\n129\t          e.preventDefault();\n130\t          game.nav.goTo('map');\n131\t        }\n132\t        return;\n133\t      }\n134\t      // Navigation screen active — InputHandler skipped this touch, handle here\n135\t      const t = e.changedTouches[0];\n136\t      if (!t) return;\n137\t      const rect = canvas.getBoundingClientRect();\n138\t      const x = t.clientX - rect.left;\n139\t      const y = t.clientY - rect.top;\n140\t      const w = game.renderer.screenW;\n141\t      const h = game.renderer.screenH;\n142\t\n143\t      if (game.adManager.handleStubClick(x, y, w, h)) return;\n144\t      game.nav.handleClick(x, y, w, h);\n145\t    });\n146\t\n147\t    // Start the game (shows main menu)\n148\t    game.start();\n149\t  </script>\n150\t</body>\n151\t</html>\n152\t"}]},"parent_tool_use_id":null,"session_id":"7463fb62-2e03-4edd-abad-466ff792dff1","uuid":"6b5b5d1d-0f53-4211-9e64-01c850a245f4","timestamp":"2026-05-23T10:37:39.875Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-match3/index.html","content":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no, maximum-scale=1.0\">\n  <meta name=\"screen-orientation\" content=\"portrait\">\n  <meta name=\"x5-orientation\" content=\"portrait\">\n  <meta name=\"format-detection\" content=\"telephone=no\">\n  <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n  <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n  <title>消消消大作战</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    html, body {\n      width: 100%; height: 100%;\n      overflow: hidden;\n      background: #FFF8E7;\n      touch-action: none;\n      -webkit-user-select: none;\n      user-select: none;\n      -webkit-touch-callout: none;\n    }\n    canvas {\n      display: block;\n      width: 100%;\n      height: 100%;\n    }\n  </style>\n</head>\n<body>\n  <canvas id=\"gameCanvas\"></canvas>\n\n  <!-- Phase 1+2: Core modules -->\n  <script src=\"src/js/Board.js\"></script>\n  <script src=\"src/js/MatchEngine.js\"></script>\n  <script src=\"src/js/Animation.js\"></script>\n  <script src=\"src/js/Obstacle.js\"></script>\n  <script src=\"src/js/AudioManager.js\"></script>\n  <script src=\"src/js/Boss.js\"></script>\n  <script src=\"src/js/levels.js\"></script>\n  <script src=\"src/js/Renderer.js\"></script>\n  <script src=\"src/js/InputHandler.js\"></script>\n  <script src=\"src/js/ScoreSystem.js\"></script>\n\n  <!-- Phase 3a: Meta-progression modules -->\n  <script src=\"src/js/DataManager.js\"></script>\n  <script src=\"src/js/CoinSystem.js\"></script>\n  <script src=\"src/js/Characters.js\"></script>\n  <script src=\"src/js/MapScreen.js\"></script>\n  <script src=\"src/js/ShopUI.js\"></script>\n\n  <!-- Phase 3b: Daily + Social -->\n  <script src=\"src/js/DailySystem.js\"></script>\n  <script src=\"src/js/SocialSystem.js\"></script>\n\n  <!-- Phase 4: Ads + Analytics -->\n  <script src=\"src/js/ad-config.js\"></script>\n  <script src=\"src/js/AdManager.js\"></script>\n  <script src=\"src/js/Analytics.js\"></script>\n\n  <script src=\"src/js/Navigation.js\"></script>\n\n  <!-- Main game -->\n  <script src=\"src/js/Game.js\"></script>\n\n  <script>\n    const canvas = document.getElementById('gameCanvas');\n    const game = new Game(canvas);\n\n    // Handle resize\n    function onResize() {\n      game.renderer.resize();\n      game.input.updateLayout(\n        game.renderer.tileSize,\n        game.renderer.boardX,\n        game.renderer.boardY,\n      );\n    }\n\n    window.addEventListener('resize', onResize);\n    window.addEventListener('orientationchange', () => setTimeout(onResize, 100));\n\n    // Unified click handler — routes through Navigation (non-board interactions only)\n    canvas.addEventListener('click', (e) => {\n      // Skip if InputHandler already processed a swipe\n      if (game.input._lastInteraction === 'swipe') {\n        game.input._lastInteraction = null;\n        return;\n      }\n      game.input._lastInteraction = null;\n\n      const rect = canvas.getBoundingClientRect();\n      const x = e.clientX - rect.left;\n      const y = e.clientY - rect.top;\n      const w = game.renderer.screenW;\n      const h = game.renderer.screenH;\n\n      // Phase 4: ad stub overlay consumes clicks first\n      if (game.adManager.handleStubClick(x, y, w, h)) return;\n\n      // Navigation screens\n      if (game.nav.isActive()) {\n        game.nav.handleClick(x, y, w, h);\n        return;\n      }\n\n      // In-game: check back-to-map button\n      const backX = w - 50;\n      const backY = game.renderer.boardY + game.renderer.tileSize * BOARD_SIZE + 25;\n      if (x >= backX && x <= backX + 40 && y >= backY && y <= backY + 28) {\n        game.nav.goTo('map');\n        return;\n      }\n    });\n\n    // Touch handler for Navigation screens (click events are suppressed by InputHandler preventDefault)\n    canvas.addEventListener('touchend', (e) => {\n      if (!game.nav.isActive()) {\n        // Back-to-map button during gameplay\n        const t = e.changedTouches[0];\n        if (!t) return;\n        const rect = canvas.getBoundingClientRect();\n        const x = t.clientX - rect.left;\n        const y = t.clientY - rect.top;\n        const w = game.renderer.screenW;\n        const backX = w - 50;\n        const backY = game.renderer.boardY + game.renderer.tileSize * BOARD_SIZE + 25;\n        if (x >= backX && x <= backX + 40 && y >= backY && y <= backY + 28) {\n          e.preventDefault();\n          game.nav.goTo('map');\n        }\n        return;\n      }\n      // Navigation screen active — InputHandler skipped this touch, handle here\n      const t = e.changedTouches[0];\n      if (!t) return;\n      const rect = canvas.getBoundingClientRect();\n      const x = t.clientX - rect.left;\n      const y = t.clientY - rect.top;\n      const w = game.renderer.screenW;\n      const h = game.renderer.screenH;\n\n      if (game.adManager.handleStubClick(x, y, w, h)) return;\n      game.nav.handleClick(x, y, w, h);\n    });\n\n    // Start the game (shows main menu)\n    game.start();\n  </script>\n</body>\n</html>\n","numLines":152,"startLine":1,"totalLines":152}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_02ace7d1543043fb91fe87e5","type":"tool_result","content":"1\t// Board.js — 8x8 grid state management\n2\tconst TILE_COLORS = 6;\n3\tconst BOARD_SIZE = 8;\n4\tconst EMPTY = -1;\n5\t\n6\tconst COLOR_MAP = {\n7\t  0: { name: 'apple',   hex: '#FF4D4D', label: '红' },\n8\t  1: { name: 'banana',  hex: '#FFD93D', label: '黄' },\n9\t  2: { name: 'blueberry', hex: '#4DA6FF', label: '蓝' },\n10\t  3: { name: 'lime',    hex: '#6BCB77', label: '绿' },\n11\t  4: { name: 'grape',   hex: '#B47AEA', label: '紫' },\n12\t  5: { name: 'orange',  hex: '#FF9A3C', label: '橙' },\n13\t};\n14\t\n15\t// Special tile types\n16\tconst SPECIAL_NONE = 0;\n17\tconst SPECIAL_STRIPED_H = 1;  // horizontal stripe bomb\n18\tconst SPECIAL_STRIPED_V = 2;  // vertical stripe bomb\n19\tconst SPECIAL_BOMB = 3;       // 3x3 area bomb\n20\tconst SPECIAL_RAINBOW = 4;    // clears all of one color\n21\t\n22\tclass Tile {\n23\t  constructor(color, row, col) {\n24\t    this.color = color;\n25\t    this.row = row;\n26\t    this.col = col;\n27\t    this.special = SPECIAL_NONE;\n28\t    this.removing = false;\n29\t    this.offsetY = 0;\n30\t    this.offsetX = 0;\n31\t    this.scale = 1;\n32\t    this.alpha = 1;\n33\t    this.selected = false;\n34\t    this.id = Tile._nextId++;\n35\t  }\n36\t  get type() { return this.color; }\n37\t}\n38\t\n39\tTile._nextId = 0;\n40\t\n41\tclass Board {\n42\t  constructor(size = BOARD_SIZE, numColors = TILE_COLORS) {\n43\t    this.size = size;\n44\t    this.numColors = numColors;\n45\t    this.grid = [];\n46\t    this.listeners = [];\n47\t  }\n48\t\n49\t  init() {\n50\t    this.grid = [];\n51\t    for (let r = 0; r < this.size; r++) {\n52\t      this.grid[r] = [];\n53\t      for (let c = 0; c < this.size; c++) {\n54\t        this.grid[r][c] = this._createTile(r, c);\n55\t      }\n56\t    }\n57\t    // Ensure no initial matches\n58\t    this._removeInitialMatches();\n59\t  }\n60\t\n61\t  _createTile(row, col) {\n62\t    return new Tile(this._randomColor(), row, col);\n63\t  }\n64\t\n65\t  _randomColor() {\n66\t    return Math.floor(Math.random() * this.numColors);\n67\t  }\n68\t\n69\t  _removeInitialMatches() {\n70\t    let maxIter = 1000;\n71\t    while (this._hasMatch() && maxIter-- > 0) {\n72\t      const matches = this.findAllMatches();\n73\t      for (const group of matches) {\n74\t        for (const { row, col } of group.cells) {\n75\t          this.grid[row][col] = this._createTile(row, col);\n76\t        }\n77\t      }\n78\t    }\n79\t  }\n80\t\n81\t  _hasMatch() {\n82\t    return this.findAllMatches().length > 0;\n83\t  }\n84\t\n85\t  getTile(r, c) {\n86\t    if (r < 0 || r >= this.size || c < 0 || c >= this.size) return null;\n87\t    return this.grid[r][c];\n88\t  }\n89\t\n90\t  setTile(r, c, tile) {\n91\t    if (r >= 0 && r < this.size && c >= 0 && c < this.size) {\n92\t      tile.row = r;\n93\t      tile.col = c;\n94\t      this.grid[r][c] = tile;\n95\t    }\n96\t  }\n97\t\n98\t  swap(r1, c1, r2, c2) {\n99\t    const a = this.grid[r1][c1];\n100\t    const b = this.grid[r2][c2];\n101\t    this.grid[r1][c1] = b;\n102\t    this.grid[r2][c2] = a;\n103\t    if (a) { a.row = r2; a.col = c2; }\n104\t    if (b) { b.row = r1; b.col = c1; }\n105\t  }\n106\t\n107\t  removeTile(r, c) {\n108\t    const tile = this.grid[r][c];\n109\t    if (tile) tile.removing = true;\n110\t    return tile;\n111\t  }\n112\t\n113\t  clearCell(r, c) {\n114\t    this.grid[r][c] = null;\n115\t  }\n116\t\n117\t  isValid(r, c) {\n118\t    return r >= 0 && r < this.size && c >= 0 && c < this.size;\n119\t  }\n120\t\n121\t  isAdjacent(r1, c1, r2, c2) {\n122\t    const dr = Math.abs(r1 - r2);\n123\t    const dc = Math.abs(c1 - c2);\n124\t    return (dr + dc) === 1;\n125\t  }\n126\t\n127\t  // Find all horizontal and vertical matches of length >= 3\n128\t  findAllMatches() {\n129\t    const matches = [];\n130\t\n131\t    // Horizontal scan\n132\t    for (let r = 0; r < this.size; r++) {\n133\t      let start = 0;\n134\t      for (let c = 1; c <= this.size; c++) {\n135\t        const cur = c < this.size ? this.grid[r][c] : null;\n136\t        const prev = this.grid[r][start];\n137\t        if (c < this.size && cur && prev && cur.color === prev.color && cur.color !== EMPTY) {\n138\t          continue;\n139\t        }\n140\t        const len = c - start;\n141\t        if (len >= 3 && prev && prev.color !== EMPTY) {\n142\t          const cells = [];\n143\t          for (let k = start; k < c; k++) cells.push({ row: r, col: k });\n144\t          matches.push({ cells, length: len, direction: 'horizontal', color: prev.color });\n145\t        }\n146\t        start = c;\n147\t      }\n148\t    }\n149\t\n150\t    // Vertical scan\n151\t    for (let c = 0; c < this.size; c++) {\n152\t      let start = 0;\n153\t      for (let r = 1; r <= this.size; r++) {\n154\t        const cur = r < this.size ? this.grid[r][c] : null;\n155\t        const prev = this.grid[start][c];\n156\t        if (r < this.size && cur && prev && cur.color === prev.color && cur.color !== EMPTY) {\n157\t          continue;\n158\t        }\n159\t        const len = r - start;\n160\t        if (len >= 3 && prev && prev.color !== EMPTY) {\n161\t          const cells = [];\n162\t          for (let k = start; k < r; k++) cells.push({ row: k, col: c });\n163\t          matches.push({ cells, length: len, direction: 'vertical', color: prev.color });\n164\t        }\n165\t        start = r;\n166\t      }\n167\t    }\n168\t\n169\t    return matches;\n170\t  }\n171\t\n172\t  // Detect L/T shape matches by finding intersections of horizontal and vertical matches\n173\t  findLShapeMatches(matches) {\n174\t    const lShapes = [];\n175\t    for (let i = 0; i < matches.length; i++) {\n176\t      for (let j = i + 1; j < matches.length; j++) {\n177\t        const a = matches[i], b = matches[j];\n178\t        if (a.direction === b.direction) continue;\n179\t        if (a.color !== b.color) continue;\n180\t        // Find intersection\n181\t        const setA = new Set(a.cells.map(c => `${c.row},${c.col}`));\n182\t        for (const cell of b.cells) {\n183\t          if (setA.has(`${cell.row},${cell.col}`)) {\n184\t            // L/T shape found — merge all cells\n185\t            const allCellsMap = {};\n186\t            for (const c of a.cells) allCellsMap[`${c.row},${c.col}`] = c;\n187\t            for (const c of b.cells) allCellsMap[`${c.row},${c.col}`] = c;\n188\t            const allCells = Object.values(allCellsMap);\n189\t            lShapes.push({ cells: allCells, color: a.color });\n190\t          }\n191\t        }\n192\t      }\n193\t    }\n194\t    return lShapes;\n195\t  }\n196\t\n197\t  // Apply gravity: move tiles down to fill empty cells\n198\t  applyGravity() {\n199\t    const drops = [];\n200\t    for (let c = 0; c < this.size; c++) {\n201\t      let writeRow = this.size - 1;\n202\t      for (let r = this.size - 1; r >= 0; r--) {\n203\t        if (this.grid[r][c] !== null) {\n204\t          if (r !== writeRow) {\n205\t            const tile = this.grid[r][c];\n206\t            const fromRow = r;\n207\t            this.grid[r][c] = null;\n208\t            this.grid[writeRow][c] = tile;\n209\t            const distance = writeRow - fromRow;\n210\t            tile.row = writeRow;\n211\t            drops.push({ tile, fromRow, toRow: writeRow, col: c, distance });\n212\t          }\n213\t          writeRow--;\n214\t        }\n215\t      }\n216\t      // Fill empty top cells\n217\t      for (let r = writeRow; r >= 0; r--) {\n218\t        const tile = this._createTile(r, c);\n219\t        tile.offsetY = -(writeRow - r + 1); // start above board\n220\t        this.grid[r][c] = tile;\n221\t        drops.push({ tile, fromRow: -(writeRow - r + 1), toRow: r, col: c, distance: r + (writeRow - r + 1) });\n222\t      }\n223\t    }\n224\t    return drops;\n225\t  }\n226\t\n227\t  // Check if any valid move exists (for deadlock detection)\n228\t  // obstacleMgr is optional — if provided, skip chained/blocked cells\n229\t  hasValidMoves(obstacleMgr) {\n230\t    for (let r = 0; r < this.size; r++) {\n231\t      for (let c = 0; c < this.size; c++) {\n232\t        if (!this.grid[r][c]) continue;\n233\t        // Skip if tile is chained or cell is blocked\n234\t        if (obstacleMgr) {\n235\t          if (obstacleMgr.isCellBlocked(r, c)) continue;\n236\t          if (!obstacleMgr.canSwap(r, c)) continue;\n237\t        }\n238\t        // Try swap right\n239\t        if (c + 1 < this.size && this.grid[r][c + 1]) {\n240\t          if (obstacleMgr && !obstacleMgr.canSwap(r, c + 1)) continue;\n241\t          this.swap(r, c, r, c + 1);\n242\t          const has = this.findAllMatches().length > 0;\n243\t          this.swap(r, c, r, c + 1);\n244\t          if (has) return true;\n245\t        }\n246\t        // Try swap down\n247\t        if (r + 1 < this.size && this.grid[r + 1][c]) {\n248\t          if (obstacleMgr && !obstacleMgr.canSwap(r + 1, c)) continue;\n249\t          this.swap(r, c, r + 1, c);\n250\t          const has = this.findAllMatches().length > 0;\n251\t          this.swap(r, c, r + 1, c);\n252\t          if (has) return true;\n253\t        }\n254\t      }\n255\t    }\n256\t    return false;\n257\t  }\n258\t\n259\t  // Shuffle board if no valid moves\n260\t  shuffle() {\n261\t    const tiles = [];\n262\t    for (let r = 0; r < this.size; r++) {\n263\t      for (let c = 0; c < this.size; c++) {\n264\t        if (this.grid[r][c]) {\n265\t          tiles.push(this.grid[r][c].color);\n266\t        }\n267\t      }\n268\t    }\n269\t    // Fisher-Yates shuffle\n270\t    for (let i = tiles.length - 1; i > 0; i--) {\n271\t      const j = Math.floor(Math.random() * (i + 1));\n272\t      [tiles[i], tiles[j]] = [tiles[j], tiles[i]];\n273\t    }\n274\t    let idx = 0;\n275\t    for (let r = 0; r < this.size; r++) {\n276\t      for (let c = 0; c < this.size; c++) {\n277\t        if (this.grid[r][c]) {\n278\t          this.grid[r][c].color = tiles[idx++] || this._randomColor();\n279\t        }\n280\t      }\n281\t    }\n282\t    // Remove any initial matches from shuffle\n283\t    this._removeInitialMatches();\n284\t    // If still no valid moves, re-init\n285\t    if (!this.hasValidMoves()) {\n286\t      this.init();\n287\t    }\n288\t  }\n289\t}\n290\t\n291\tif (typeof module !== 'undefined') module.exports = { Board, Tile, BOARD_SIZE, TILE_COLORS, SPECIAL_NONE, SPECIAL_STRIPED_H, SPECIAL_STRIPED_V, SPECIAL_BOMB, SPECIAL_RAINBOW, COLOR_MAP };\n292\t"}]},"parent_tool_use_id":null,"session_id":"7463fb62-2e03-4edd-abad-466ff792dff1","uuid":"bc34c8cf-e59e-48b4-846d-30ba9aa0ef77","timestamp":"2026-05-23T10:37:40.703Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-match3/src/js/Board.js","content":"// Board.js — 8x8 grid state management\nconst TILE_COLORS = 6;\nconst BOARD_SIZE = 8;\nconst EMPTY = -1;\n\nconst COLOR_MAP = {\n  0: { name: 'apple',   hex: '#FF4D4D', label: '红' },\n  1: { name: 'banana',  hex: '#FFD93D', label: '黄' },\n  2: { name: 'blueberry', hex: '#4DA6FF', label: '蓝' },\n  3: { name: 'lime',    hex: '#6BCB77', label: '绿' },\n  4: { name: 'grape',   hex: '#B47AEA', label: '紫' },\n  5: { name: 'orange',  hex: '#FF9A3C', label: '橙' },\n};\n\n// Special tile types\nconst SPECIAL_NONE = 0;\nconst SPECIAL_STRIPED_H = 1;  // horizontal stripe bomb\nconst SPECIAL_STRIPED_V = 2;  // vertical stripe bomb\nconst SPECIAL_BOMB = 3;       // 3x3 area bomb\nconst SPECIAL_RAINBOW = 4;    // clears all of one color\n\nclass Tile {\n  constructor(color, row, col) {\n    this.color = color;\n    this.row = row;\n    this.col = col;\n    this.special = SPECIAL_NONE;\n    this.removing = false;\n    this.offsetY = 0;\n    this.offsetX = 0;\n    this.scale = 1;\n    this.alpha = 1;\n    this.selected = false;\n    this.id = Tile._nextId++;\n  }\n  get type() { return this.color; }\n}\n\nTile._nextId = 0;\n\nclass Board {\n  constructor(size = BOARD_SIZE, numColors = TILE_COLORS) {\n    this.size = size;\n    this.numColors = numColors;\n    this.grid = [];\n    this.listeners = [];\n  }\n\n  init() {\n    this.grid = [];\n    for (let r = 0; r < this.size; r++) {\n      this.grid[r] = [];\n      for (let c = 0; c < this.size; c++) {\n        this.grid[r][c] = this._createTile(r, c);\n      }\n    }\n    // Ensure no initial matches\n    this._removeInitialMatches();\n  }\n\n  _createTile(row, col) {\n    return new Tile(this._randomColor(), row, col);\n  }\n\n  _randomColor() {\n    return Math.floor(Math.random() * this.numColors);\n  }\n\n  _removeInitialMatches() {\n    let maxIter = 1000;\n    while (this._hasMatch() && maxIter-- > 0) {\n      const matches = this.findAllMatches();\n      for (const group of matches) {\n        for (const { row, col } of group.cells) {\n          this.grid[row][col] = this._createTile(row, col);\n        }\n      }\n    }\n  }\n\n  _hasMatch() {\n    return this.findAllMatches().length > 0;\n  }\n\n  getTile(r, c) {\n    if (r < 0 || r >= this.size || c < 0 || c >= this.size) return null;\n    return this.grid[r][c];\n  }\n\n  setTile(r, c, tile) {\n    if (r >= 0 && r < this.size && c >= 0 && c < this.size) {\n      tile.row = r;\n      tile.col = c;\n      this.grid[r][c] = tile;\n    }\n  }\n\n  swap(r1, c1, r2, c2) {\n    const a = this.grid[r1][c1];\n    const b = this.grid[r2][c2];\n    this.grid[r1][c1] = b;\n    this.grid[r2][c2] = a;\n    if (a) { a.row = r2; a.col = c2; }\n    if (b) { b.row = r1; b.col = c1; }\n  }\n\n  removeTile(r, c) {\n    const tile = this.grid[r][c];\n    if (tile) tile.removing = true;\n    return tile;\n  }\n\n  clearCell(r, c) {\n    this.grid[r][c] = null;\n  }\n\n  isValid(r, c) {\n    return r >= 0 && r < this.size && c >= 0 && c < this.size;\n  }\n\n  isAdjacent(r1, c1, r2, c2) {\n    const dr = Math.abs(r1 - r2);\n    const dc = Math.abs(c1 - c2);\n    return (dr + dc) === 1;\n  }\n\n  // Find all horizontal and vertical matches of length >= 3\n  findAllMatches() {\n    const matches = [];\n\n    // Horizontal scan\n    for (let r = 0; r < this.size; r++) {\n      let start = 0;\n      for (let c = 1; c <= this.size; c++) {\n        const cur = c < this.size ? this.grid[r][c] : null;\n        const prev = this.grid[r][start];\n        if (c < this.size && cur && prev && cur.color === prev.color && cur.color !== EMPTY) {\n          continue;\n        }\n        const len = c - start;\n        if (len >= 3 && prev && prev.color !== EMPTY) {\n          const cells = [];\n          for (let k = start; k < c; k++) cells.push({ row: r, col: k });\n          matches.push({ cells, length: len, direction: 'horizontal', color: prev.color });\n        }\n        start = c;\n      }\n    }\n\n    // Vertical scan\n    for (let c = 0; c < this.size; c++) {\n      let start = 0;\n      for (let r = 1; r <= this.size; r++) {\n        const cur = r < this.size ? this.grid[r][c] : null;\n        const prev = this.grid[start][c];\n        if (r < this.size && cur && prev && cur.color === prev.color && cur.color !== EMPTY) {\n          continue;\n        }\n        const len = r - start;\n        if (len >= 3 && prev && prev.color !== EMPTY) {\n          const cells = [];\n          for (let k = start; k < r; k++) cells.push({ row: k, col: c });\n          matches.push({ cells, length: len, direction: 'vertical', color: prev.color });\n        }\n        start = r;\n      }\n    }\n\n    return matches;\n  }\n\n  // Detect L/T shape matches by finding intersections of horizontal and vertical matches\n  findLShapeMatches(matches) {\n    const lShapes = [];\n    for (let i = 0; i < matches.length; i++) {\n      for (let j = i + 1; j < matches.length; j++) {\n        const a = matches[i], b = matches[j];\n        if (a.direction === b.direction) continue;\n        if (a.color !== b.color) continue;\n        // Find intersection\n        const setA = new Set(a.cells.map(c => `${c.row},${c.col}`));\n        for (const cell of b.cells) {\n          if (setA.has(`${cell.row},${cell.col}`)) {\n            // L/T shape found — merge all cells\n            const allCellsMap = {};\n            for (const c of a.cells) allCellsMap[`${c.row},${c.col}`] = c;\n            for (const c of b.cells) allCellsMap[`${c.row},${c.col}`] = c;\n            const allCells = Object.values(allCellsMap);\n            lShapes.push({ cells: allCells, color: a.color });\n          }\n        }\n      }\n    }\n    return lShapes;\n  }\n\n  // Apply gravity: move tiles down to fill empty cells\n  applyGravity() {\n    const drops = [];\n    for (let c = 0; c < this.size; c++) {\n      let writeRow = this.size - 1;\n      for (let r = this.size - 1; r >= 0; r--) {\n        if (this.grid[r][c] !== null) {\n          if (r !== writeRow) {\n            const tile = this.grid[r][c];\n            const fromRow = r;\n            this.grid[r][c] = null;\n            this.grid[writeRow][c] = tile;\n            const distance = writeRow - fromRow;\n            tile.row = writeRow;\n            drops.push({ tile, fromRow, toRow: writeRow, col: c, distance });\n          }\n          writeRow--;\n        }\n      }\n      // Fill empty top cells\n      for (let r = writeRow; r >= 0; r--) {\n        const tile = this._createTile(r, c);\n        tile.offsetY = -(writeRow - r + 1); // start above board\n        this.grid[r][c] = tile;\n        drops.push({ tile, fromRow: -(writeRow - r + 1), toRow: r, col: c, distance: r + (writeRow - r + 1) });\n      }\n    }\n    return drops;\n  }\n\n  // Check if any valid move exists (for deadlock detection)\n  // obstacleMgr is optional — if provided, skip chained/blocked cells\n  hasValidMoves(obstacleMgr) {\n    for (let r = 0; r < this.size; r++) {\n      for (let c = 0; c < this.size; c++) {\n        if (!this.grid[r][c]) continue;\n        // Skip if tile is chained or cell is blocked\n        if (obstacleMgr) {\n          if (obstacleMgr.isCellBlocked(r, c)) continue;\n          if (!obstacleMgr.canSwap(r, c)) continue;\n        }\n        // Try swap right\n        if (c + 1 < this.size && this.grid[r][c + 1]) {\n          if (obstacleMgr && !obstacleMgr.canSwap(r, c + 1)) continue;\n          this.swap(r, c, r, c + 1);\n          const has = this.findAllMatches().length > 0;\n          this.swap(r, c, r, c + 1);\n          if (has) return true;\n        }\n        // Try swap down\n        if (r + 1 < this.size && this.grid[r + 1][c]) {\n          if (obstacleMgr && !obstacleMgr.canSwap(r + 1, c)) continue;\n          this.swap(r, c, r + 1, c);\n          const has = this.findAllMatches().length > 0;\n          this.swap(r, c, r + 1, c);\n          if (has) return true;\n        }\n      }\n    }\n    return false;\n  }\n\n  // Shuffle board if no valid moves\n  shuffle() {\n    const tiles = [];\n    for (let r = 0; r < this.size; r++) {\n      for (let c = 0; c < this.size; c++) {\n        if (this.grid[r][c]) {\n          tiles.push(this.grid[r][c].color);\n        }\n      }\n    }\n    // Fisher-Yates shuffle\n    for (let i = tiles.length - 1; i > 0; i--) {\n      const j = Math.floor(Math.random() * (i + 1));\n      [tiles[i], tiles[j]] = [tiles[j], tiles[i]];\n    }\n    let idx = 0;\n    for (let r = 0; r < this.size; r++) {\n      for (let c = 0; c < this.size; c++) {\n        if (this.grid[r][c]) {\n          this.grid[r][c].color = tiles[idx++] || this._randomColor();\n        }\n      }\n    }\n    // Remove any initial matches from shuffle\n    this._removeInitialMatches();\n    // If still no valid moves, re-init\n    if (!this.hasValidMoves()) {\n      this.init();\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Board, Tile, BOARD_SIZE, TILE_COLORS, SPECIAL_NONE, SPECIAL_STRIPED_H, SPECIAL_STRIPED_V, SPECIAL_BOMB, SPECIAL_RAINBOW, COLOR_MAP };\n","numLines":292,"startLine":1,"totalLines":292}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_42dced68560c4e1fbf9bde96","type":"tool_result","content":"1\t// Renderer.js — Canvas 2D rendering engine with obstacle, boss, and updated UI support\n2\t\n3\tclass Renderer {\n4\t  constructor(canvas) {\n5\t    this.canvas = canvas;\n6\t    this.ctx = canvas.getContext('2d');\n7\t    this.tileSize = 0;\n8\t    this.boardX = 0;\n9\t    this.boardY = 0;\n10\t    this.particleSystem = null;\n11\t    this.floatingTexts = [];\n12\t    this.resize();\n13\t  }\n14\t\n15\t  resize() {\n16\t    const dpr = window.devicePixelRatio || 1;\n17\t    const w = window.innerWidth;\n18\t    const h = window.innerHeight;\n19\t    this.canvas.width = w * dpr;\n20\t    this.canvas.height = h * dpr;\n21\t    this.canvas.style.width = w + 'px';\n22\t    this.canvas.style.height = h + 'px';\n23\t    this.ctx.scale(dpr, dpr);\n24\t    this.screenW = w;\n25\t    this.screenH = h;\n26\t\n27\t    this.tileSize = Math.floor(Math.min(w * 0.9, (h - 160)) / BOARD_SIZE);\n28\t    this.boardX = (w - this.tileSize * BOARD_SIZE) / 2;\n29\t    this.boardY = 140;\n30\t  }\n31\t\n32\t  getTileCenter(row, col) {\n33\t    return {\n34\t      x: this.boardX + col * this.tileSize + this.tileSize / 2,\n35\t      y: this.boardY + row * this.tileSize + this.tileSize / 2,\n36\t    };\n37\t  }\n38\t\n39\t  clear() {\n40\t    this.ctx.clearRect(0, 0, this.screenW, this.screenH);\n41\t  }\n42\t\n43\t  drawBackground() {\n44\t    const ctx = this.ctx;\n45\t    ctx.fillStyle = '#FFF8E7';\n46\t    ctx.fillRect(0, 0, this.screenW, this.screenH);\n47\t\n48\t    const bw = this.tileSize * BOARD_SIZE;\n49\t    const bh = this.tileSize * BOARD_SIZE;\n50\t    ctx.fillStyle = '#FFFFFFCC';\n51\t    this._roundRect(ctx, this.boardX - 6, this.boardY - 6, bw + 12, bh + 12, 12);\n52\t    ctx.fill();\n53\t\n54\t    ctx.strokeStyle = '#F0E6D6';\n55\t    ctx.lineWidth = 1;\n56\t    for (let i = 0; i <= BOARD_SIZE; i++) {\n57\t      ctx.beginPath();\n58\t      ctx.moveTo(this.boardX + i * this.tileSize, this.boardY);\n59\t      ctx.lineTo(this.boardX + i * this.tileSize, this.boardY + bh);\n60\t      ctx.stroke();\n61\t      ctx.beginPath();\n62\t      ctx.moveTo(this.boardX, this.boardY + i * this.tileSize);\n63\t      ctx.lineTo(this.boardX + bw, this.boardY + i * this.tileSize);\n64\t      ctx.stroke();\n65\t    }\n66\t  }\n67\t\n68\t  drawTile(tile) {\n69\t    if (!tile || tile.color < 0) return;\n70\t    const ctx = this.ctx;\n71\t    const size = this.tileSize - 4;\n72\t    const cx = this.boardX + tile.col * this.tileSize + this.tileSize / 2 + (tile.offsetX || 0);\n73\t    const cy = this.boardY + tile.row * this.tileSize + this.tileSize / 2 + (tile.offsetY || 0);\n74\t    const scale = tile.scale || 1;\n75\t    const alpha = tile.alpha !== undefined ? tile.alpha : 1;\n76\t\n77\t    ctx.save();\n78\t    ctx.translate(cx, cy);\n79\t    ctx.scale(scale, scale);\n80\t    ctx.globalAlpha = alpha;\n81\t\n82\t    const half = size / 2;\n83\t    const color = COLOR_MAP[tile.color];\n84\t    if (!color) { ctx.restore(); return; }\n85\t\n86\t    ctx.fillStyle = color.hex;\n87\t    this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n88\t    ctx.fill();\n89\t\n90\t    ctx.fillStyle = 'rgba(255,255,255,0.25)';\n91\t    this._roundRect(ctx, -half + 3, -half + 3, size - 6, size / 2 - 3, size * 0.15);\n92\t    ctx.fill();\n93\t\n94\t    this._drawFruitIcon(ctx, tile.color, half * 0.55);\n95\t\n96\t    if (tile.special === SPECIAL_STRIPED_H) {\n97\t      this._drawStripes(ctx, size, half, '#FFFFFF80', true);\n98\t    } else if (tile.special === SPECIAL_STRIPED_V) {\n99\t      this._drawStripes(ctx, size, half, '#FFFFFF80', false);\n100\t    } else if (tile.special === SPECIAL_BOMB) {\n101\t      this._drawCrosshair(ctx, half);\n102\t    } else if (tile.special === SPECIAL_RAINBOW) {\n103\t      this._drawRainbowOverlay(ctx, half);\n104\t    }\n105\t\n106\t    if (tile.selected) {\n107\t      ctx.strokeStyle = '#FFFFFF';\n108\t      ctx.lineWidth = 3;\n109\t      ctx.shadowColor = '#FFB800';\n110\t      ctx.shadowBlur = 12;\n111\t      this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n112\t      ctx.stroke();\n113\t      ctx.shadowBlur = 0;\n114\t    }\n115\t\n116\t    ctx.restore();\n117\t  }\n118\t\n119\t  _drawFruitIcon(ctx, colorIdx, radius) {\n120\t    ctx.fillStyle = 'rgba(255,255,255,0.6)';\n121\t    ctx.font = `bold ${radius * 1.4}px sans-serif`;\n122\t    ctx.textAlign = 'center';\n123\t    ctx.textBaseline = 'middle';\n124\t    const icons = ['🍎', '🍌', '🫐', '🍏', '🍇', '🍊'];\n125\t    ctx.fillText(icons[colorIdx] || '', 0, 1);\n126\t  }\n127\t\n128\t  _drawStripes(ctx, size, half, color, horizontal) {\n129\t    ctx.strokeStyle = color;\n130\t    ctx.lineWidth = 2;\n131\t    if (horizontal) {\n132\t      for (let y = -half + 6; y < half; y += 8) {\n133\t        ctx.beginPath();\n134\t        ctx.moveTo(-half + 4, y);\n135\t        ctx.lineTo(half - 4, y);\n136\t        ctx.stroke();\n137\t      }\n138\t    } else {\n139\t      for (let x = -half + 6; x < half; x += 8) {\n140\t        ctx.beginPath();\n141\t        ctx.moveTo(x, -half + 4);\n142\t        ctx.lineTo(x, half - 4);\n143\t        ctx.stroke();\n144\t      }\n145\t    }\n146\t  }\n147\t\n148\t  _drawCrosshair(ctx, half) {\n149\t    ctx.strokeStyle = '#FFFFFF99';\n150\t    ctx.lineWidth = 2;\n151\t    ctx.beginPath();\n152\t    ctx.moveTo(-half * 0.6, 0); ctx.lineTo(half * 0.6, 0);\n153\t    ctx.moveTo(0, -half * 0.6); ctx.lineTo(0, half * 0.6);\n154\t    ctx.stroke();\n155\t    ctx.beginPath();\n156\t    ctx.arc(0, 0, half * 0.4, 0, Math.PI * 2);\n157\t    ctx.stroke();\n158\t  }\n159\t\n160\t  _drawRainbowOverlay(ctx, half) {\n161\t    const gradient = ctx.createLinearGradient(-half, -half, half, half);\n162\t    gradient.addColorStop(0, '#FF000080');\n163\t    gradient.addColorStop(0.17, '#FF880080');\n164\t    gradient.addColorStop(0.33, '#FFFF0080');\n165\t    gradient.addColorStop(0.5, '#00FF0080');\n166\t    gradient.addColorStop(0.67, '#0088FF80');\n167\t    gradient.addColorStop(0.83, '#8800FF80');\n168\t    gradient.addColorStop(1, '#FF008880');\n169\t    ctx.fillStyle = gradient;\n170\t    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.4);\n171\t    ctx.fill();\n172\t  }\n173\t\n174\t  // Draw all obstacles\n175\t  drawObstacles(obstacleMgr) {\n176\t    for (const obs of obstacleMgr.obstacles) {\n177\t      if (obs.isDestroyed()) continue;\n178\t      const shake = obs.shakeTimer > 0 ? (Math.random() - 0.5) * 4 : 0;\n179\t      const pos = this.getTileCenter(obs.row, obs.col);\n180\t      const half = (this.tileSize - 4) / 2;\n181\t\n182\t      this.ctx.save();\n183\t      this.ctx.translate(pos.x + shake, pos.y);\n184\t\n185\t      switch (obs.type) {\n186\t        case OBSTACLE_ICE:\n187\t          this._drawIce(this.ctx, half);\n188\t          break;\n189\t        case OBSTACLE_CHAIN:\n190\t          this._drawChain(this.ctx, half);\n191\t          break;\n192\t        case OBSTACLE_CHOCOLATE:\n193\t          this._drawChocolate(this.ctx, half);\n194\t          break;\n195\t      }\n196\t\n197\t      this.ctx.restore();\n198\t    }\n199\t  }\n200\t\n201\t  _drawIce(ctx, half) {\n202\t    // Translucent blue overlay\n203\t    ctx.fillStyle = 'rgba(135, 206, 250, 0.45)';\n204\t    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.2);\n205\t    ctx.fill();\n206\t    // Ice crack pattern\n207\t    ctx.strokeStyle = 'rgba(255, 255, 255, 0.7)';\n208\t    ctx.lineWidth = 1.5;\n209\t    ctx.beginPath();\n210\t    ctx.moveTo(-half * 0.3, -half * 0.5);\n211\t    ctx.lineTo(half * 0.2, 0);\n212\t    ctx.lineTo(-half * 0.1, half * 0.4);\n213\t    ctx.stroke();\n214\t    ctx.beginPath();\n215\t    ctx.moveTo(half * 0.3, -half * 0.3);\n216\t    ctx.lineTo(0, half * 0.1);\n217\t    ctx.stroke();\n218\t    // Ice label\n219\t    ctx.fillStyle = 'rgba(255,255,255,0.8)';\n220\t    ctx.font = `bold ${half * 0.6}px sans-serif`;\n221\t    ctx.textAlign = 'center';\n222\t    ctx.textBaseline = 'middle';\n223\t    ctx.fillText('❄', 0, 0);\n224\t  }\n225\t\n226\t  _drawChain(ctx, half) {\n227\t    // Chain icon overlay\n228\t    ctx.fillStyle = 'rgba(100, 100, 100, 0.35)';\n229\t    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.2);\n230\t    ctx.fill();\n231\t    // Chain links\n232\t    ctx.strokeStyle = 'rgba(80, 80, 80, 0.9)';\n233\t    ctx.lineWidth = 3;\n234\t    for (let i = -1; i <= 1; i++) {\n235\t      ctx.beginPath();\n236\t      ctx.ellipse(i * half * 0.5, 0, half * 0.25, half * 0.15, 0, 0, Math.PI * 2);\n237\t      ctx.stroke();\n238\t    }\n239\t    // Lock icon\n240\t    ctx.fillStyle = 'rgba(255,255,255,0.7)';\n241\t    ctx.font = `bold ${half * 0.7}px sans-serif`;\n242\t    ctx.textAlign = 'center';\n243\t    ctx.textBaseline = 'middle';\n244\t    ctx.fillText('🔗', 0, -half * 0.6);\n245\t  }\n246\t\n247\t  _drawChocolate(ctx, half) {\n248\t    // Brown blob\n249\t    ctx.fillStyle = '#6B3410';\n250\t    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.3);\n251\t    ctx.fill();\n252\t    // Chocolate drip pattern\n253\t    ctx.fillStyle = '#8B5E3C';\n254\t    this._roundRect(ctx, -half + 3, -half + 3, half * 2 - 6, half * 2 - 6, half * 0.25);\n255\t    ctx.fill();\n256\t    // Shine\n257\t    ctx.fillStyle = 'rgba(255,255,255,0.15)';\n258\t    this._roundRect(ctx, -half + 6, -half + 6, half - 3, half * 0.6, half * 0.15);\n259\t    ctx.fill();\n260\t    // Emoji\n261\t    ctx.font = `bold ${half * 0.8}px sans-serif`;\n262\t    ctx.textAlign = 'center';\n263\t    ctx.textBaseline = 'middle';\n264\t    ctx.fillText('🍫', 0, 0);\n265\t  }\n266\t\n267\t  // Draw boss on board\n268\t  drawBoss(boss, renderer) {\n269\t    const pos = this.getTileCenter(boss.row, boss.col);\n270\t    const half = (this.tileSize - 4) / 2;\n271\t    const shake = boss.shakeTimer > 0 ? (Math.random() - 0.5) * 6 : 0;\n272\t\n273\t    this.ctx.save();\n274\t    this.ctx.translate(pos.x + shake, pos.y);\n275\t\n276\t    // Boss body\n277\t    const isUsingSkill = boss.skillAnimTimer > 0;\n278\t    const pulseScale = isUsingSkill ? 1.1 : 1;\n279\t    this.ctx.scale(pulseScale, pulseScale);\n280\t\n281\t    // Dark aura\n282\t    this.ctx.fillStyle = isUsingSkill ? 'rgba(255,0,0,0.15)' : 'rgba(80,0,80,0.1)';\n283\t    this.ctx.beginPath();\n284\t    this.ctx.arc(0, 0, half * 1.3, 0, Math.PI * 2);\n285\t    this.ctx.fill();\n286\t\n287\t    // Boss face\n288\t    this.ctx.fillStyle = '#4A0E4E';\n289\t    this._roundRect(this.ctx, -half, -half, half * 2, half * 2, half * 0.3);\n290\t    this.ctx.fill();\n291\t\n292\t    // Inner glow\n293\t    const grad = this.ctx.createRadialGradient(0, 0, 0, 0, 0, half);\n294\t    grad.addColorStop(0, 'rgba(255,100,200,0.3)');\n295\t    grad.addColorStop(1, 'rgba(80,0,120,0.1)');\n296\t    this.ctx.fillStyle = grad;\n297\t    this._roundRect(this.ctx, -half, -half, half * 2, half * 2, half * 0.3);\n298\t    this.ctx.fill();\n299\t\n300\t    // Boss emoji\n301\t    this.ctx.font = `bold ${half * 1.2}px sans-serif`;\n302\t    this.ctx.textAlign = 'center';\n303\t    this.ctx.textBaseline = 'middle';\n304\t    const hpRatio = boss.hp / boss.maxHp;\n305\t    const bossEmoji = hpRatio > 0.5 ? '👹' : hpRatio > 0.25 ? '👿' : '💀';\n306\t    this.ctx.fillText(bossEmoji, 0, 0);\n307\t\n308\t    this.ctx.restore();\n309\t  }\n310\t\n311\t  // Draw boss health bar above the board\n312\t  drawBossHealthBar(boss) {\n313\t    const ctx = this.ctx;\n314\t    const barW = Math.min(200, this.screenW - 40);\n315\t    const barH = 14;\n316\t    const barX = (this.screenW - barW) / 2;\n317\t    const barY = this.boardY + this.tileSize * BOARD_SIZE + 50;\n318\t\n319\t    // Background\n320\t    ctx.fillStyle = '#E0D5C5';\n321\t    this._roundRect(ctx, barX, barY, barW, barH, 7);\n322\t    ctx.fill();\n323\t\n324\t    // HP bar\n325\t    const hpRatio = Math.max(0, boss.hp / boss.maxHp);\n326\t    if (hpRatio > 0) {\n327\t      const grad = ctx.createLinearGradient(barX, barY, barX + barW * hpRatio, barY);\n328\t      grad.addColorStop(0, '#FF4D4D');\n329\t      grad.addColorStop(1, '#CC0000');\n330\t      ctx.fillStyle = grad;\n331\t      this._roundRect(ctx, barX, barY, barW * hpRatio, barH, 7);\n332\t      ctx.fill();\n333\t    }\n334\t\n335\t    // Boss name and HP text\n336\t    ctx.fillStyle = '#5D4037';\n337\t    ctx.font = 'bold 12px sans-serif';\n338\t    ctx.textAlign = 'center';\n339\t    ctx.fillText(`${boss.name}  ${boss.hp}/${boss.maxHp}`, this.screenW / 2, barY + barH + 14);\n340\t  }\n341\t\n342\t  // Updated drawUI to support new goal types\n343\t  drawUI(score, moves, config, scoreSystem, level) {\n344\t    const ctx = this.ctx;\n345\t\n346\t    // Top bar background\n347\t    ctx.fillStyle = '#FFB800';\n348\t    this._roundRect(ctx, 8, 8, this.screenW - 16, 55, 12);\n349\t    ctx.fill();\n350\t\n351\t    // Level\n352\t    ctx.fillStyle = '#5D4037';\n353\t    ctx.font = 'bold 18px sans-serif';\n354\t    ctx.textAlign = 'left';\n355\t    ctx.fillText(`第 ${level} 关`, 20, 42);\n356\t\n357\t    // Level name\n358\t    if (config.name) {\n359\t      ctx.font = '12px sans-serif';\n360\t      ctx.fillText(config.name, 20, 22);\n361\t    }\n362\t\n363\t    // Score\n364\t    ctx.textAlign = 'center';\n365\t    ctx.fillStyle = '#FFFFFF';\n366\t    ctx.font = 'bold 20px sans-serif';\n367\t    ctx.fillText(`${score}`, this.screenW / 2, 32);\n368\t    ctx.font = '12px sans-serif';\n369\t    ctx.fillText('分数', this.screenW / 2, 48);\n370\t\n371\t    // Moves\n372\t    ctx.textAlign = 'right';\n373\t    ctx.fillStyle = moves <= 5 ? '#FF4D4D' : '#5D4037';\n374\t    ctx.font = 'bold 22px sans-serif';\n375\t    ctx.fillText(`${moves}`, this.screenW - 20, 32);\n376\t    ctx.font = '12px sans-serif';\n377\t    ctx.fillStyle = '#5D4037';\n378\t    ctx.fillText('剩余步数', this.screenW - 20, 48);\n379\t\n380\t    // Goal progress — use the new goal description\n381\t    const goalDesc = scoreSystem.getGoalDescription();\n382\t    const progressBars = scoreSystem.getProgressForUI();\n383\t\n384\t    const barW = this.screenW - 40;\n385\t    const barH = 16;\n386\t    const barY = 72;\n387\t    const barX = 20;\n388\t\n389\t    // Goal label\n390\t    ctx.fillStyle = '#5D4037';\n391\t    ctx.font = 'bold 11px sans-serif';\n392\t    ctx.textAlign = 'center';\n393\t\n394\t    if (progressBars.length === 1) {\n395\t      // Single goal — progress bar\n396\t      const p = progressBars[0];\n397\t      ctx.fillStyle = '#E0D5C5';\n398\t      this._roundRect(ctx, barX, barY, barW, barH, 8);\n399\t      ctx.fill();\n400\t\n401\t      const progress = Math.min(p.current / p.target, 1);\n402\t      if (progress > 0) {\n403\t        const grad = ctx.createLinearGradient(barX, barY, barX + barW * progress, barY);\n404\t        grad.addColorStop(0, '#6BCB77');\n405\t        grad.addColorStop(1, '#4DA66B');\n406\t        ctx.fillStyle = grad;\n407\t        this._roundRect(ctx, barX, barY, barW * progress, barH, 8);\n408\t        ctx.fill();\n409\t      }\n410\t\n411\t      ctx.fillStyle = '#5D4037';\n412\t      ctx.font = 'bold 11px sans-serif';\n413\t      ctx.fillText(goalDesc, this.screenW / 2, barY + 13);\n414\t    } else {\n415\t      // Dual goal — two smaller bars\n416\t      const halfBarW = (barW - 10) / 2;\n417\t      for (let i = 0; i < progressBars.length; i++) {\n418\t        const p = progressBars[i];\n419\t        const bx = barX + i * (halfBarW + 10);\n420\t\n421\t        ctx.fillStyle = '#E0D5C5';\n422\t        this._roundRect(ctx, bx, barY, halfBarW, barH, 8);\n423\t        ctx.fill();\n424\t\n425\t        const progress = Math.min(p.current / p.target, 1);\n426\t        if (progress > 0) {\n427\t          const grad = ctx.createLinearGradient(bx, barY, bx + halfBarW * progress, barY);\n428\t          grad.addColorStop(0, i === 0 ? '#6BCB77' : '#4DA6FF');\n429\t          grad.addColorStop(1, i === 0 ? '#4DA66B' : '#3388DD');\n430\t          ctx.fillStyle = grad;\n431\t          this._roundRect(ctx, bx, barY, halfBarW * progress, barH, 8);\n432\t          ctx.fill();\n433\t        }\n434\t\n435\t        ctx.fillStyle = '#5D4037';\n436\t        ctx.font = 'bold 10px sans-serif';\n437\t        ctx.fillText(`${p.current}/${p.target}`, bx + halfBarW / 2, barY + 13);\n438\t      }\n439\t    }\n440\t\n441\t    // Bottom hint\n442\t    ctx.fillStyle = '#8D6E63';\n443\t    ctx.font = '14px sans-serif';\n444\t    ctx.textAlign = 'center';\n445\t    const hintY = this.boardY + this.tileSize * BOARD_SIZE + 30;\n446\t    // Don't overlap with boss health bar\n447\t    const hintOffset = scoreSystem.goalType === 'boss' ? 0 : 30;\n448\t    ctx.fillText('滑动交换相邻方块', this.screenW / 2, hintY + hintOffset);\n449\t  }\n450\t\n451\t  drawComboText(text) {\n452\t    if (!text) return;\n453\t    const ctx = this.ctx;\n454\t    ctx.save();\n455\t    ctx.fillStyle = '#FF4D4D';\n456\t    ctx.font = 'bold 36px sans-serif';\n457\t    ctx.textAlign = 'center';\n458\t    ctx.textBaseline = 'middle';\n459\t    ctx.shadowColor = '#FFB800';\n460\t    ctx.shadowBlur = 8;\n461\t    ctx.fillText(text, this.screenW / 2, this.boardY + this.tileSize * BOARD_SIZE / 2);\n462\t    ctx.restore();\n463\t  }\n464\t\n465\t  addFloatingText(text, x, y, color = '#FF4D4D') {\n466\t    this.floatingTexts.push({ text, x, y, alpha: 1, vy: -60, life: 1.0, color });\n467\t  }\n468\t\n469\t  updateAndDrawFloatingTexts(dt) {\n470\t    const ctx = this.ctx;\n471\t    this.floatingTexts = this.floatingTexts.filter(ft => {\n472\t      ft.y += ft.vy * dt;\n473\t      ft.life -= dt;\n474\t      ft.alpha = Math.max(0, ft.life);\n475\t      if (ft.life <= 0) return false;\n476\t\n477\t      ctx.globalAlpha = ft.alpha;\n478\t      ctx.fillStyle = ft.color;\n479\t      ctx.font = 'bold 18px sans-serif';\n480\t      ctx.textAlign = 'center';\n481\t      ctx.fillText(ft.text, ft.x, ft.y);\n482\t      ctx.globalAlpha = 1;\n483\t      return true;\n484\t    });\n485\t  }\n486\t\n487\t  drawResultScreen(won, score, stars, level) {\n488\t    const ctx = this.ctx;\n489\t    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n490\t    ctx.fillRect(0, 0, this.screenW, this.screenH);\n491\t\n492\t    const pw = Math.min(320, this.screenW - 40);\n493\t    const ph = 260;\n494\t    const px = (this.screenW - pw) / 2;\n495\t    const py = (this.screenH - ph) / 2;\n496\t\n497\t    ctx.fillStyle = '#FFF8E7';\n498\t    this._roundRect(ctx, px, py, pw, ph, 16);\n499\t    ctx.fill();\n500\t    ctx.strokeStyle = '#FFB800';\n501\t    ctx.lineWidth = 3;\n502\t    this._roundRect(ctx, px, py, pw, ph, 16);\n503\t    ctx.stroke();\n504\t\n505\t    ctx.fillStyle = '#5D4037';\n506\t    ctx.font = 'bold 24px sans-serif';\n507\t    ctx.textAlign = 'center';\n508\t    ctx.fillText(won ? '🎉 恭喜过关！' : '😢 挑战失败', this.screenW / 2, py + 45);\n509\t\n510\t    ctx.font = 'bold 36px sans-serif';\n511\t    ctx.fillStyle = '#FFB800';\n512\t    ctx.fillText(score, this.screenW / 2, py + 95);\n513\t    ctx.font = '14px sans-serif';\n514\t    ctx.fillStyle = '#8D6E63';\n515\t    ctx.fillText('得分', this.screenW / 2, py + 115);\n516\t\n517\t    if (won) {\n518\t      for (let i = 0; i < 3; i++) {\n519\t        ctx.font = '32px sans-serif';\n520\t        ctx.fillText(i < stars ? '⭐' : '☆', this.screenW / 2 - 45 + i * 45, py + 160);\n521\t      }\n522\t    }\n523\t\n524\t    const btnW = 120, btnH = 42;\n525\t    const btnY = py + ph - 60;\n526\t\n527\t    ctx.fillStyle = '#6BCB77';\n528\t    this._roundRect(ctx, this.screenW / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n529\t    ctx.fill();\n530\t    ctx.fillStyle = '#FFFFFF';\n531\t    ctx.font = 'bold 16px sans-serif';\n532\t    ctx.fillText(won ? '下一关' : '重试', this.screenW / 2 - btnW / 2 - 10, btnY + 27);\n533\t\n534\t    ctx.fillStyle = '#8D6E63';\n535\t    this._roundRect(ctx, this.screenW / 2 + 10, btnY, btnW, btnH, btnH / 2);\n536\t    ctx.fill();\n537\t    ctx.fillStyle = '#FFFFFF';\n538\t    ctx.fillText('菜单', this.screenW / 2 + btnW / 2 + 10, btnY + 27);\n539\t  }\n540\t\n541\t  _roundRect(ctx, x, y, w, h, r) {\n542\t    ctx.beginPath();\n543\t    ctx.moveTo(x + r, y);\n544\t    ctx.lineTo(x + w - r, y);\n545\t    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n546\t    ctx.lineTo(x + w, y + h - r);\n547\t    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n548\t    ctx.lineTo(x + r, y + h);\n549\t    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n550\t    ctx.lineTo(x, y + r);\n551\t    ctx.quadraticCurveTo(x, y, x + r, y);\n552\t    ctx.closePath();\n553\t  }\n554\t}\n555\t\n556\tif (typeof module !== 'undefined') module.exports = { Renderer };\n557\t"}]},"parent_tool_use_id":null,"session_id":"7463fb62-2e03-4edd-abad-466ff792dff1","uuid":"d9645ac0-f7b5-4f9a-b5c8-01de8c269f3f","timestamp":"2026-05-23T10:37:40.706Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-match3/src/js/Renderer.js","content":"// Renderer.js — Canvas 2D rendering engine with obstacle, boss, and updated UI support\n\nclass Renderer {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d');\n    this.tileSize = 0;\n    this.boardX = 0;\n    this.boardY = 0;\n    this.particleSystem = null;\n    this.floatingTexts = [];\n    this.resize();\n  }\n\n  resize() {\n    const dpr = window.devicePixelRatio || 1;\n    const w = window.innerWidth;\n    const h = window.innerHeight;\n    this.canvas.width = w * dpr;\n    this.canvas.height = h * dpr;\n    this.canvas.style.width = w + 'px';\n    this.canvas.style.height = h + 'px';\n    this.ctx.scale(dpr, dpr);\n    this.screenW = w;\n    this.screenH = h;\n\n    this.tileSize = Math.floor(Math.min(w * 0.9, (h - 160)) / BOARD_SIZE);\n    this.boardX = (w - this.tileSize * BOARD_SIZE) / 2;\n    this.boardY = 140;\n  }\n\n  getTileCenter(row, col) {\n    return {\n      x: this.boardX + col * this.tileSize + this.tileSize / 2,\n      y: this.boardY + row * this.tileSize + this.tileSize / 2,\n    };\n  }\n\n  clear() {\n    this.ctx.clearRect(0, 0, this.screenW, this.screenH);\n  }\n\n  drawBackground() {\n    const ctx = this.ctx;\n    ctx.fillStyle = '#FFF8E7';\n    ctx.fillRect(0, 0, this.screenW, this.screenH);\n\n    const bw = this.tileSize * BOARD_SIZE;\n    const bh = this.tileSize * BOARD_SIZE;\n    ctx.fillStyle = '#FFFFFFCC';\n    this._roundRect(ctx, this.boardX - 6, this.boardY - 6, bw + 12, bh + 12, 12);\n    ctx.fill();\n\n    ctx.strokeStyle = '#F0E6D6';\n    ctx.lineWidth = 1;\n    for (let i = 0; i <= BOARD_SIZE; i++) {\n      ctx.beginPath();\n      ctx.moveTo(this.boardX + i * this.tileSize, this.boardY);\n      ctx.lineTo(this.boardX + i * this.tileSize, this.boardY + bh);\n      ctx.stroke();\n      ctx.beginPath();\n      ctx.moveTo(this.boardX, this.boardY + i * this.tileSize);\n      ctx.lineTo(this.boardX + bw, this.boardY + i * this.tileSize);\n      ctx.stroke();\n    }\n  }\n\n  drawTile(tile) {\n    if (!tile || tile.color < 0) return;\n    const ctx = this.ctx;\n    const size = this.tileSize - 4;\n    const cx = this.boardX + tile.col * this.tileSize + this.tileSize / 2 + (tile.offsetX || 0);\n    const cy = this.boardY + tile.row * this.tileSize + this.tileSize / 2 + (tile.offsetY || 0);\n    const scale = tile.scale || 1;\n    const alpha = tile.alpha !== undefined ? tile.alpha : 1;\n\n    ctx.save();\n    ctx.translate(cx, cy);\n    ctx.scale(scale, scale);\n    ctx.globalAlpha = alpha;\n\n    const half = size / 2;\n    const color = COLOR_MAP[tile.color];\n    if (!color) { ctx.restore(); return; }\n\n    ctx.fillStyle = color.hex;\n    this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n    ctx.fill();\n\n    ctx.fillStyle = 'rgba(255,255,255,0.25)';\n    this._roundRect(ctx, -half + 3, -half + 3, size - 6, size / 2 - 3, size * 0.15);\n    ctx.fill();\n\n    this._drawFruitIcon(ctx, tile.color, half * 0.55);\n\n    if (tile.special === SPECIAL_STRIPED_H) {\n      this._drawStripes(ctx, size, half, '#FFFFFF80', true);\n    } else if (tile.special === SPECIAL_STRIPED_V) {\n      this._drawStripes(ctx, size, half, '#FFFFFF80', false);\n    } else if (tile.special === SPECIAL_BOMB) {\n      this._drawCrosshair(ctx, half);\n    } else if (tile.special === SPECIAL_RAINBOW) {\n      this._drawRainbowOverlay(ctx, half);\n    }\n\n    if (tile.selected) {\n      ctx.strokeStyle = '#FFFFFF';\n      ctx.lineWidth = 3;\n      ctx.shadowColor = '#FFB800';\n      ctx.shadowBlur = 12;\n      this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n      ctx.stroke();\n      ctx.shadowBlur = 0;\n    }\n\n    ctx.restore();\n  }\n\n  _drawFruitIcon(ctx, colorIdx, radius) {\n    ctx.fillStyle = 'rgba(255,255,255,0.6)';\n    ctx.font = `bold ${radius * 1.4}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    const icons = ['🍎', '🍌', '🫐', '🍏', '🍇', '🍊'];\n    ctx.fillText(icons[colorIdx] || '', 0, 1);\n  }\n\n  _drawStripes(ctx, size, half, color, horizontal) {\n    ctx.strokeStyle = color;\n    ctx.lineWidth = 2;\n    if (horizontal) {\n      for (let y = -half + 6; y < half; y += 8) {\n        ctx.beginPath();\n        ctx.moveTo(-half + 4, y);\n        ctx.lineTo(half - 4, y);\n        ctx.stroke();\n      }\n    } else {\n      for (let x = -half + 6; x < half; x += 8) {\n        ctx.beginPath();\n        ctx.moveTo(x, -half + 4);\n        ctx.lineTo(x, half - 4);\n        ctx.stroke();\n      }\n    }\n  }\n\n  _drawCrosshair(ctx, half) {\n    ctx.strokeStyle = '#FFFFFF99';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.moveTo(-half * 0.6, 0); ctx.lineTo(half * 0.6, 0);\n    ctx.moveTo(0, -half * 0.6); ctx.lineTo(0, half * 0.6);\n    ctx.stroke();\n    ctx.beginPath();\n    ctx.arc(0, 0, half * 0.4, 0, Math.PI * 2);\n    ctx.stroke();\n  }\n\n  _drawRainbowOverlay(ctx, half) {\n    const gradient = ctx.createLinearGradient(-half, -half, half, half);\n    gradient.addColorStop(0, '#FF000080');\n    gradient.addColorStop(0.17, '#FF880080');\n    gradient.addColorStop(0.33, '#FFFF0080');\n    gradient.addColorStop(0.5, '#00FF0080');\n    gradient.addColorStop(0.67, '#0088FF80');\n    gradient.addColorStop(0.83, '#8800FF80');\n    gradient.addColorStop(1, '#FF008880');\n    ctx.fillStyle = gradient;\n    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.4);\n    ctx.fill();\n  }\n\n  // Draw all obstacles\n  drawObstacles(obstacleMgr) {\n    for (const obs of obstacleMgr.obstacles) {\n      if (obs.isDestroyed()) continue;\n      const shake = obs.shakeTimer > 0 ? (Math.random() - 0.5) * 4 : 0;\n      const pos = this.getTileCenter(obs.row, obs.col);\n      const half = (this.tileSize - 4) / 2;\n\n      this.ctx.save();\n      this.ctx.translate(pos.x + shake, pos.y);\n\n      switch (obs.type) {\n        case OBSTACLE_ICE:\n          this._drawIce(this.ctx, half);\n          break;\n        case OBSTACLE_CHAIN:\n          this._drawChain(this.ctx, half);\n          break;\n        case OBSTACLE_CHOCOLATE:\n          this._drawChocolate(this.ctx, half);\n          break;\n      }\n\n      this.ctx.restore();\n    }\n  }\n\n  _drawIce(ctx, half) {\n    // Translucent blue overlay\n    ctx.fillStyle = 'rgba(135, 206, 250, 0.45)';\n    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.2);\n    ctx.fill();\n    // Ice crack pattern\n    ctx.strokeStyle = 'rgba(255, 255, 255, 0.7)';\n    ctx.lineWidth = 1.5;\n    ctx.beginPath();\n    ctx.moveTo(-half * 0.3, -half * 0.5);\n    ctx.lineTo(half * 0.2, 0);\n    ctx.lineTo(-half * 0.1, half * 0.4);\n    ctx.stroke();\n    ctx.beginPath();\n    ctx.moveTo(half * 0.3, -half * 0.3);\n    ctx.lineTo(0, half * 0.1);\n    ctx.stroke();\n    // Ice label\n    ctx.fillStyle = 'rgba(255,255,255,0.8)';\n    ctx.font = `bold ${half * 0.6}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText('❄', 0, 0);\n  }\n\n  _drawChain(ctx, half) {\n    // Chain icon overlay\n    ctx.fillStyle = 'rgba(100, 100, 100, 0.35)';\n    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.2);\n    ctx.fill();\n    // Chain links\n    ctx.strokeStyle = 'rgba(80, 80, 80, 0.9)';\n    ctx.lineWidth = 3;\n    for (let i = -1; i <= 1; i++) {\n      ctx.beginPath();\n      ctx.ellipse(i * half * 0.5, 0, half * 0.25, half * 0.15, 0, 0, Math.PI * 2);\n      ctx.stroke();\n    }\n    // Lock icon\n    ctx.fillStyle = 'rgba(255,255,255,0.7)';\n    ctx.font = `bold ${half * 0.7}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText('🔗', 0, -half * 0.6);\n  }\n\n  _drawChocolate(ctx, half) {\n    // Brown blob\n    ctx.fillStyle = '#6B3410';\n    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.3);\n    ctx.fill();\n    // Chocolate drip pattern\n    ctx.fillStyle = '#8B5E3C';\n    this._roundRect(ctx, -half + 3, -half + 3, half * 2 - 6, half * 2 - 6, half * 0.25);\n    ctx.fill();\n    // Shine\n    ctx.fillStyle = 'rgba(255,255,255,0.15)';\n    this._roundRect(ctx, -half + 6, -half + 6, half - 3, half * 0.6, half * 0.15);\n    ctx.fill();\n    // Emoji\n    ctx.font = `bold ${half * 0.8}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText('🍫', 0, 0);\n  }\n\n  // Draw boss on board\n  drawBoss(boss, renderer) {\n    const pos = this.getTileCenter(boss.row, boss.col);\n    const half = (this.tileSize - 4) / 2;\n    const shake = boss.shakeTimer > 0 ? (Math.random() - 0.5) * 6 : 0;\n\n    this.ctx.save();\n    this.ctx.translate(pos.x + shake, pos.y);\n\n    // Boss body\n    const isUsingSkill = boss.skillAnimTimer > 0;\n    const pulseScale = isUsingSkill ? 1.1 : 1;\n    this.ctx.scale(pulseScale, pulseScale);\n\n    // Dark aura\n    this.ctx.fillStyle = isUsingSkill ? 'rgba(255,0,0,0.15)' : 'rgba(80,0,80,0.1)';\n    this.ctx.beginPath();\n    this.ctx.arc(0, 0, half * 1.3, 0, Math.PI * 2);\n    this.ctx.fill();\n\n    // Boss face\n    this.ctx.fillStyle = '#4A0E4E';\n    this._roundRect(this.ctx, -half, -half, half * 2, half * 2, half * 0.3);\n    this.ctx.fill();\n\n    // Inner glow\n    const grad = this.ctx.createRadialGradient(0, 0, 0, 0, 0, half);\n    grad.addColorStop(0, 'rgba(255,100,200,0.3)');\n    grad.addColorStop(1, 'rgba(80,0,120,0.1)');\n    this.ctx.fillStyle = grad;\n    this._roundRect(this.ctx, -half, -half, half * 2, half * 2, half * 0.3);\n    this.ctx.fill();\n\n    // Boss emoji\n    this.ctx.font = `bold ${half * 1.2}px sans-serif`;\n    this.ctx.textAlign = 'center';\n    this.ctx.textBaseline = 'middle';\n    const hpRatio = boss.hp / boss.maxHp;\n    const bossEmoji = hpRatio > 0.5 ? '👹' : hpRatio > 0.25 ? '👿' : '💀';\n    this.ctx.fillText(bossEmoji, 0, 0);\n\n    this.ctx.restore();\n  }\n\n  // Draw boss health bar above the board\n  drawBossHealthBar(boss) {\n    const ctx = this.ctx;\n    const barW = Math.min(200, this.screenW - 40);\n    const barH = 14;\n    const barX = (this.screenW - barW) / 2;\n    const barY = this.boardY + this.tileSize * BOARD_SIZE + 50;\n\n    // Background\n    ctx.fillStyle = '#E0D5C5';\n    this._roundRect(ctx, barX, barY, barW, barH, 7);\n    ctx.fill();\n\n    // HP bar\n    const hpRatio = Math.max(0, boss.hp / boss.maxHp);\n    if (hpRatio > 0) {\n      const grad = ctx.createLinearGradient(barX, barY, barX + barW * hpRatio, barY);\n      grad.addColorStop(0, '#FF4D4D');\n      grad.addColorStop(1, '#CC0000');\n      ctx.fillStyle = grad;\n      this._roundRect(ctx, barX, barY, barW * hpRatio, barH, 7);\n      ctx.fill();\n    }\n\n    // Boss name and HP text\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 12px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(`${boss.name}  ${boss.hp}/${boss.maxHp}`, this.screenW / 2, barY + barH + 14);\n  }\n\n  // Updated drawUI to support new goal types\n  drawUI(score, moves, config, scoreSystem, level) {\n    const ctx = this.ctx;\n\n    // Top bar background\n    ctx.fillStyle = '#FFB800';\n    this._roundRect(ctx, 8, 8, this.screenW - 16, 55, 12);\n    ctx.fill();\n\n    // Level\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 18px sans-serif';\n    ctx.textAlign = 'left';\n    ctx.fillText(`第 ${level} 关`, 20, 42);\n\n    // Level name\n    if (config.name) {\n      ctx.font = '12px sans-serif';\n      ctx.fillText(config.name, 20, 22);\n    }\n\n    // Score\n    ctx.textAlign = 'center';\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.fillText(`${score}`, this.screenW / 2, 32);\n    ctx.font = '12px sans-serif';\n    ctx.fillText('分数', this.screenW / 2, 48);\n\n    // Moves\n    ctx.textAlign = 'right';\n    ctx.fillStyle = moves <= 5 ? '#FF4D4D' : '#5D4037';\n    ctx.font = 'bold 22px sans-serif';\n    ctx.fillText(`${moves}`, this.screenW - 20, 32);\n    ctx.font = '12px sans-serif';\n    ctx.fillStyle = '#5D4037';\n    ctx.fillText('剩余步数', this.screenW - 20, 48);\n\n    // Goal progress — use the new goal description\n    const goalDesc = scoreSystem.getGoalDescription();\n    const progressBars = scoreSystem.getProgressForUI();\n\n    const barW = this.screenW - 40;\n    const barH = 16;\n    const barY = 72;\n    const barX = 20;\n\n    // Goal label\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 11px sans-serif';\n    ctx.textAlign = 'center';\n\n    if (progressBars.length === 1) {\n      // Single goal — progress bar\n      const p = progressBars[0];\n      ctx.fillStyle = '#E0D5C5';\n      this._roundRect(ctx, barX, barY, barW, barH, 8);\n      ctx.fill();\n\n      const progress = Math.min(p.current / p.target, 1);\n      if (progress > 0) {\n        const grad = ctx.createLinearGradient(barX, barY, barX + barW * progress, barY);\n        grad.addColorStop(0, '#6BCB77');\n        grad.addColorStop(1, '#4DA66B');\n        ctx.fillStyle = grad;\n        this._roundRect(ctx, barX, barY, barW * progress, barH, 8);\n        ctx.fill();\n      }\n\n      ctx.fillStyle = '#5D4037';\n      ctx.font = 'bold 11px sans-serif';\n      ctx.fillText(goalDesc, this.screenW / 2, barY + 13);\n    } else {\n      // Dual goal — two smaller bars\n      const halfBarW = (barW - 10) / 2;\n      for (let i = 0; i < progressBars.length; i++) {\n        const p = progressBars[i];\n        const bx = barX + i * (halfBarW + 10);\n\n        ctx.fillStyle = '#E0D5C5';\n        this._roundRect(ctx, bx, barY, halfBarW, barH, 8);\n        ctx.fill();\n\n        const progress = Math.min(p.current / p.target, 1);\n        if (progress > 0) {\n          const grad = ctx.createLinearGradient(bx, barY, bx + halfBarW * progress, barY);\n          grad.addColorStop(0, i === 0 ? '#6BCB77' : '#4DA6FF');\n          grad.addColorStop(1, i === 0 ? '#4DA66B' : '#3388DD');\n          ctx.fillStyle = grad;\n          this._roundRect(ctx, bx, barY, halfBarW * progress, barH, 8);\n          ctx.fill();\n        }\n\n        ctx.fillStyle = '#5D4037';\n        ctx.font = 'bold 10px sans-serif';\n        ctx.fillText(`${p.current}/${p.target}`, bx + halfBarW / 2, barY + 13);\n      }\n    }\n\n    // Bottom hint\n    ctx.fillStyle = '#8D6E63';\n    ctx.font = '14px sans-serif';\n    ctx.textAlign = 'center';\n    const hintY = this.boardY + this.tileSize * BOARD_SIZE + 30;\n    // Don't overlap with boss health bar\n    const hintOffset = scoreSystem.goalType === 'boss' ? 0 : 30;\n    ctx.fillText('滑动交换相邻方块', this.screenW / 2, hintY + hintOffset);\n  }\n\n  drawComboText(text) {\n    if (!text) return;\n    const ctx = this.ctx;\n    ctx.save();\n    ctx.fillStyle = '#FF4D4D';\n    ctx.font = 'bold 36px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.shadowColor = '#FFB800';\n    ctx.shadowBlur = 8;\n    ctx.fillText(text, this.screenW / 2, this.boardY + this.tileSize * BOARD_SIZE / 2);\n    ctx.restore();\n  }\n\n  addFloatingText(text, x, y, color = '#FF4D4D') {\n    this.floatingTexts.push({ text, x, y, alpha: 1, vy: -60, life: 1.0, color });\n  }\n\n  updateAndDrawFloatingTexts(dt) {\n    const ctx = this.ctx;\n    this.floatingTexts = this.floatingTexts.filter(ft => {\n      ft.y += ft.vy * dt;\n      ft.life -= dt;\n      ft.alpha = Math.max(0, ft.life);\n      if (ft.life <= 0) return false;\n\n      ctx.globalAlpha = ft.alpha;\n      ctx.fillStyle = ft.color;\n      ctx.font = 'bold 18px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText(ft.text, ft.x, ft.y);\n      ctx.globalAlpha = 1;\n      return true;\n    });\n  }\n\n  drawResultScreen(won, score, stars, level) {\n    const ctx = this.ctx;\n    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n    ctx.fillRect(0, 0, this.screenW, this.screenH);\n\n    const pw = Math.min(320, this.screenW - 40);\n    const ph = 260;\n    const px = (this.screenW - pw) / 2;\n    const py = (this.screenH - ph) / 2;\n\n    ctx.fillStyle = '#FFF8E7';\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.fill();\n    ctx.strokeStyle = '#FFB800';\n    ctx.lineWidth = 3;\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.stroke();\n\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 24px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(won ? '🎉 恭喜过关！' : '😢 挑战失败', this.screenW / 2, py + 45);\n\n    ctx.font = 'bold 36px sans-serif';\n    ctx.fillStyle = '#FFB800';\n    ctx.fillText(score, this.screenW / 2, py + 95);\n    ctx.font = '14px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText('得分', this.screenW / 2, py + 115);\n\n    if (won) {\n      for (let i = 0; i < 3; i++) {\n        ctx.font = '32px sans-serif';\n        ctx.fillText(i < stars ? '⭐' : '☆', this.screenW / 2 - 45 + i * 45, py + 160);\n      }\n    }\n\n    const btnW = 120, btnH = 42;\n    const btnY = py + ph - 60;\n\n    ctx.fillStyle = '#6BCB77';\n    this._roundRect(ctx, this.screenW / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n    ctx.fill();\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = 'bold 16px sans-serif';\n    ctx.fillText(won ? '下一关' : '重试', this.screenW / 2 - btnW / 2 - 10, btnY + 27);\n\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, this.screenW / 2 + 10, btnY, btnW, btnH, btnH / 2);\n    ctx.fill();\n    ctx.fillStyle = '#FFFFFF';\n    ctx.fillText('菜单', this.screenW / 2 + btnW / 2 + 10, btnY + 27);\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Renderer };\n","numLines":557,"startLine":1,"totalLines":557}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f35027673bfa45808e489851","type":"tool_result","content":"1\t// Navigation.js — Full screen navigation: menu → map → character → game → result\n2\t\n3\tconst NAV_SCREENS = {\n4\t  MENU: 'menu',\n5\t  MAP: 'map',\n6\t  SHOP: 'shop',\n7\t  CHARACTER: 'character',\n8\t  GAME: 'game',\n9\t  RESULT: 'result',\n10\t  DAILY: 'daily',\n11\t  SOCIAL: 'social',\n12\t};\n13\t\n14\tclass Navigation {\n15\t  constructor(game) {\n16\t    this.game = game;\n17\t    this.screen = NAV_SCREENS.MENU;\n18\t    this.dataManager = game.dataManager;\n19\t    this.coinSystem = game.coinSystem;\n20\t    this.characterMgr = game.characterMgr;\n21\t    this.mapScreen = game.mapScreen;\n22\t    this.shopUI = game.shopUI;\n23\t    this.adManager = game.adManager;\n24\t    this.analytics = game.analytics;\n25\t    this.resultCoins = 0;\n26\t    this.resultWon = false;\n27\t    this.resultScore = 0;\n28\t    this.resultStars = 0;\n29\t    this.resultLevel = 0;\n30\t    this.resultDoubled = false;\n31\t    this.resultUsedContinue = false;\n32\t    this.menuAnim = 0;\n33\t    this.showBoostPrompt = false;\n34\t    this.boostLevel = -1;\n35\t  }\n36\t\n37\t  isActive() {\n38\t    return this.screen !== NAV_SCREENS.GAME;\n39\t  }\n40\t\n41\t  goTo(screen) {\n42\t    this.screen = screen;\n43\t    this.game.input.active = (screen === NAV_SCREENS.GAME);\n44\t  }\n45\t\n46\t  render(ctx, screenW, screenH) {\n47\t    switch (this.screen) {\n48\t      case NAV_SCREENS.MENU:\n49\t        this._renderMenu(ctx, screenW, screenH);\n50\t        break;\n51\t      case NAV_SCREENS.MAP:\n52\t        this.mapScreen.render(ctx, screenW, screenH);\n53\t        break;\n54\t      case NAV_SCREENS.SHOP:\n55\t        this.shopUI.render(ctx, screenW, screenH);\n56\t        break;\n57\t      case NAV_SCREENS.CHARACTER:\n58\t        this._renderCharacterSelect(ctx, screenW, screenH);\n59\t        break;\n60\t      case NAV_SCREENS.RESULT:\n61\t        this._renderResult(ctx, screenW, screenH);\n62\t        break;\n63\t      case NAV_SCREENS.DAILY:\n64\t        this.game.dailySystem.render(ctx, screenW, screenH);\n65\t        break;\n66\t      case NAV_SCREENS.SOCIAL:\n67\t        this.game.socialSystem.render(ctx, screenW, screenH);\n68\t        break;\n69\t    }\n70\t  }\n71\t\n72\t  handleClick(x, y, screenW, screenH) {\n73\t    switch (this.screen) {\n74\t      case NAV_SCREENS.MENU:\n75\t        return this._handleMenuClick(x, y, screenW, screenH);\n76\t      case NAV_SCREENS.MAP:\n77\t        return this._handleMapClick(x, y, screenW, screenH);\n78\t      case NAV_SCREENS.SHOP:\n79\t        return this._handleShopClick(x, y, screenW, screenH);\n80\t      case NAV_SCREENS.CHARACTER:\n81\t        return this._handleCharacterClick(x, y, screenW, screenH);\n82\t      case NAV_SCREENS.RESULT:\n83\t        return this._handleResultClick(x, y, screenW, screenH);\n84\t      case NAV_SCREENS.DAILY:\n85\t        return this._handleDailyClick(x, y, screenW, screenH);\n86\t      case NAV_SCREENS.SOCIAL:\n87\t        return this._handleSocialClick(x, y, screenW, screenH);\n88\t    }\n89\t    return null;\n90\t  }\n91\t\n92\t  // --- MENU ---\n93\t  _renderMenu(ctx, w, h) {\n94\t    this.menuAnim += 1 / 60;\n95\t\n96\t    // Gradient background\n97\t    const grad = ctx.createLinearGradient(0, 0, 0, h);\n98\t    grad.addColorStop(0, '#FFE8F0');\n99\t    grad.addColorStop(0.5, '#FFF8E7');\n100\t    grad.addColorStop(1, '#E3F2FD');\n101\t    ctx.fillStyle = grad;\n102\t    ctx.fillRect(0, 0, w, h);\n103\t\n104\t    // Floating fruit emojis\n105\t    const emojis = ['🍎', '🍌', '🫐', '🍏', '🍇', '🍊'];\n106\t    for (let i = 0; i < 12; i++) {\n107\t      const bx = (w * 0.08 + (i * 137.5) % (w * 0.84));\n108\t      const by = (h * 0.08 + (i * 97.3 + Math.sin(this.menuAnim * 0.8 + i * 0.7) * 25) % (h * 0.75));\n109\t      ctx.globalAlpha = 0.12;\n110\t      ctx.font = `${22 + (i % 3) * 8}px sans-serif`;\n111\t      ctx.textAlign = 'center';\n112\t      ctx.fillText(emojis[i % emojis.length], bx, by);\n113\t    }\n114\t    ctx.globalAlpha = 1;\n115\t\n116\t    // Title\n117\t    const titleY = h * 0.22;\n118\t    ctx.fillStyle = '#5D4037';\n119\t    ctx.font = 'bold 38px sans-serif';\n120\t    ctx.textAlign = 'center';\n121\t    ctx.fillText('消消消大作战', w / 2, titleY);\n122\t\n123\t    // Subtitle with wave animation\n124\t    ctx.font = '18px sans-serif';\n125\t    ctx.fillStyle = '#8D6E63';\n126\t    ctx.fillText('Match & Blast', w / 2, titleY + 35);\n127\t\n128\t    // Fruit emoji row\n129\t    ctx.font = '30px sans-serif';\n130\t    for (let i = 0; i < 6; i++) {\n131\t      const fx = w / 2 - 75 + i * 30;\n132\t      const fy = titleY + 70 + Math.sin(this.menuAnim * 2 + i * 0.8) * 5;\n133\t      ctx.fillText(emojis[i], fx, fy);\n134\t    }\n135\t\n136\t    // Start button with pulse\n137\t    const btnW = 200, btnH = 52;\n138\t    const btnX = (w - btnW) / 2;\n139\t    const btnY = h * 0.52;\n140\t    const pulse = 1 + Math.sin(this.menuAnim * 2.5) * 0.03;\n141\t\n142\t    ctx.save();\n143\t    ctx.translate(w / 2, btnY + btnH / 2);\n144\t    ctx.scale(pulse, pulse);\n145\t    ctx.translate(-w / 2, -(btnY + btnH / 2));\n146\t\n147\t    ctx.fillStyle = '#FFB800';\n148\t    ctx.shadowColor = '#FFB80088';\n149\t    ctx.shadowBlur = 15;\n150\t    this._roundRect(ctx, btnX, btnY, btnW, btnH, 26);\n151\t    ctx.fill();\n152\t    ctx.shadowBlur = 0;\n153\t\n154\t    ctx.fillStyle = '#FFF';\n155\t    ctx.font = 'bold 20px sans-serif';\n156\t    ctx.fillText('🎮 开始游戏', w / 2, btnY + 34);\n157\t    ctx.restore();\n158\t\n159\t    // Continue (if has progress)\n160\t    const completed = Object.keys(this.dataManager.data.levelStars).length;\n161\t    if (completed > 0) {\n162\t      const cBtnY = btnY + btnH + 20;\n163\t      ctx.fillStyle = '#6BCB77';\n164\t      this._roundRect(ctx, btnX, cBtnY, btnW, 44, 22);\n165\t      ctx.fill();\n166\t      ctx.fillStyle = '#FFF';\n167\t      ctx.font = 'bold 16px sans-serif';\n168\t      ctx.fillText(`继续游戏 (${completed}关)`, w / 2, cBtnY + 28);\n169\t    }\n170\t\n171\t    // Version\n172\t    ctx.fillStyle = '#C0B8A8';\n173\t    ctx.font = '12px sans-serif';\n174\t    ctx.fillText('Phase 4 v1.0', w / 2, h - 20);\n175\t  }\n176\t\n177\t  _handleMenuClick(x, y, w, h) {\n178\t    const btnW = 200, btnH = 52;\n179\t    const btnX = (w - btnW) / 2;\n180\t    const btnY = h * 0.52;\n181\t\n182\t    // Start button\n183\t    if (x >= btnX && x <= btnX + btnW && y >= btnY && y <= btnY + btnH) {\n184\t      this.goTo(NAV_SCREENS.MAP);\n185\t      return { action: 'start' };\n186\t    }\n187\t\n188\t    // Continue button\n189\t    const completed = Object.keys(this.dataManager.data.levelStars).length;\n190\t    if (completed > 0) {\n191\t      const cBtnY = btnY + btnH + 20;\n192\t      if (x >= btnX && x <= btnX + btnW && y >= cBtnY && y <= cBtnY + 44) {\n193\t        this.goTo(NAV_SCREENS.MAP);\n194\t        return { action: 'start' };\n195\t      }\n196\t    }\n197\t    return null;\n198\t  }\n199\t\n200\t  // --- MAP ---\n201\t  _handleMapClick(x, y, w, h) {\n202\t    const result = this.mapScreen.handleClick(x, y, w, h);\n203\t    if (!result) return null;\n204\t\n205\t    if (result.action === 'play') {\n206\t      this._startLevel(result.level);\n207\t    } else if (result.action === 'shop') {\n208\t      this.goTo(NAV_SCREENS.SHOP);\n209\t    } else if (result.action === 'character') {\n210\t      this.goTo(NAV_SCREENS.CHARACTER);\n211\t    } else if (result.action === 'daily') {\n212\t      this.goTo(NAV_SCREENS.DAILY);\n213\t    } else if (result.action === 'social') {\n214\t      this.goTo(NAV_SCREENS.SOCIAL);\n215\t    }\n216\t    return result;\n217\t  }\n218\t\n219\t  _startLevel(levelIdx) {\n220\t    this.game._loadLevel(levelIdx);\n221\t    this.game.state = STATES.IDLE;\n222\t    this.characterMgr.applySkill(\n223\t      this.dataManager.selectedCharacter,\n224\t      this.game, 'level_start', null,\n225\t    );\n226\t    this.goTo(NAV_SCREENS.GAME);\n227\t    // Phase 4: analytics\n228\t    this.analytics.trackLevelStart(levelIdx + 1, this.game.levels[levelIdx] || {});\n229\t  }\n230\t\n231\t  // --- SHOP ---\n232\t  _handleShopClick(x, y, w, h) {\n233\t    const result = this.shopUI.handleClick(x, y, w, h);\n234\t    if (!result) return null;\n235\t    if (result.action === 'buy') {\n236\t      this.coinSystem.buy(result.itemId);\n237\t    } else if (result.action === 'back') {\n238\t      this.goTo(NAV_SCREENS.MAP);\n239\t    }\n240\t    return result;\n241\t  }\n242\t\n243\t  // --- CHARACTER SELECT ---\n244\t  _renderCharacterSelect(ctx, w, h) {\n245\t    // Background\n246\t    const grad = ctx.createLinearGradient(0, 0, 0, h);\n247\t    grad.addColorStop(0, '#F3E5F5');\n248\t    grad.addColorStop(1, '#FFF8E7');\n249\t    ctx.fillStyle = grad;\n250\t    ctx.fillRect(0, 0, w, h);\n251\t\n252\t    // Title bar\n253\t    ctx.fillStyle = '#B47AEA';\n254\t    this._roundRect(ctx, 10, 8, w - 20, 48, 12);\n255\t    ctx.fill();\n256\t    ctx.fillStyle = '#FFF';\n257\t    ctx.font = 'bold 20px sans-serif';\n258\t    ctx.textAlign = 'center';\n259\t    ctx.fillText('👤 选择角色', w / 2, 40);\n260\t\n261\t    // Character cards\n262\t    const chars = this.characterMgr.getAll();\n263\t    const cardW = Math.min((w - 50) / 2, 160);\n264\t    const cardH = 130;\n265\t    const totalGridW = cardW * 2 + 16;\n266\t    const gridStartX = (w - totalGridW) / 2;\n267\t    const startY = 75;\n268\t\n269\t    for (let i = 0; i < chars.length; i++) {\n270\t      const ch = chars[i];\n271\t      const row = Math.floor(i / 2);\n272\t      const col = i % 2;\n273\t      const cx = gridStartX + col * (cardW + 16);\n274\t      const cy = startY + row * (cardH + 12);\n275\t      const unlocked = this.characterMgr.isUnlocked(i, this.dataManager.unlockedLevel);\n276\t      const selected = this.dataManager.selectedCharacter === i;\n277\t\n278\t      // Card background\n279\t      if (selected) {\n280\t        ctx.fillStyle = '#FFE0B2';\n281\t      } else if (unlocked) {\n282\t        ctx.fillStyle = '#FFFFFFEE';\n283\t      } else {\n284\t        ctx.fillStyle = '#E8E0D8';\n285\t      }\n286\t      this._roundRect(ctx, cx, cy, cardW, cardH, 12);\n287\t      ctx.fill();\n288\t\n289\t      // Selected border\n290\t      if (selected) {\n291\t        ctx.strokeStyle = '#FFB800';\n292\t        ctx.lineWidth = 3;\n293\t        this._roundRect(ctx, cx, cy, cardW, cardH, 12);\n294\t        ctx.stroke();\n295\t\n296\t        // Check mark\n297\t        ctx.fillStyle = '#FFB800';\n298\t        ctx.font = '16px sans-serif';\n299\t        ctx.textAlign = 'right';\n300\t        ctx.fillText('✓', cx + cardW - 8, cy + 18);\n301\t      }\n302\t\n303\t      // Emoji\n304\t      ctx.font = '36px sans-serif';\n305\t      ctx.textAlign = 'center';\n306\t      ctx.fillText(unlocked ? ch.emoji : '🔒', cx + cardW / 2, cy + 45);\n307\t\n308\t      // Name\n309\t      ctx.fillStyle = unlocked ? '#5D4037' : '#A09888';\n310\t      ctx.font = 'bold 16px sans-serif';\n311\t      ctx.fillText(ch.name, cx + cardW / 2, cy + 72);\n312\t\n313\t      // Title\n314\t      ctx.font = '11px sans-serif';\n315\t      ctx.fillStyle = unlocked ? '#B47AEA' : '#C0B8A8';\n316\t      ctx.fillText(ch.title, cx + cardW / 2, cy + 88);\n317\t\n318\t      // Description or unlock requirement\n319\t      ctx.fillStyle = unlocked ? '#8D6E63' : '#B0A898';\n320\t      ctx.font = '10px sans-serif';\n321\t      const desc = unlocked ? ch.desc : `通过第${ch.unlockLevel}关解锁`;\n322\t      // Word wrap for long text\n323\t      if (desc.length > 10) {\n324\t        const mid = Math.ceil(desc.length / 2);\n325\t        const spaceIdx = desc.indexOf(' ', mid - 3);\n326\t        if (spaceIdx > 0 && spaceIdx < desc.length - 1) {\n327\t          ctx.fillText(desc.substring(0, spaceIdx), cx + cardW / 2, cy + 104);\n328\t          ctx.fillText(desc.substring(spaceIdx + 1), cx + cardW / 2, cy + 118);\n329\t        } else {\n330\t          ctx.fillText(desc.substring(0, Math.ceil(desc.length / 2)), cx + cardW / 2, cy + 104);\n331\t          ctx.fillText(desc.substring(Math.ceil(desc.length / 2)), cx + cardW / 2, cy + 118);\n332\t        }\n333\t      } else {\n334\t        ctx.fillText(desc, cx + cardW / 2, cy + 110);\n335\t      }\n336\t    }\n337\t\n338\t    // Confirm button\n339\t    ctx.fillStyle = '#8D6E63';\n340\t    this._roundRect(ctx, 20, h - 58, w - 40, 42, 21);\n341\t    ctx.fill();\n342\t    ctx.fillStyle = '#FFF';\n343\t    ctx.font = 'bold 16px sans-serif';\n344\t    ctx.textAlign = 'center';\n345\t    ctx.fillText('确认返回', w / 2, h - 32);\n346\t  }\n347\t\n348\t  _handleCharacterClick(x, y, w, h) {\n349\t    const chars = this.characterMgr.getAll();\n350\t    const cardW = Math.min((w - 50) / 2, 160);\n351\t    const cardH = 130;\n352\t    const totalGridW = cardW * 2 + 16;\n353\t    const gridStartX = (w - totalGridW) / 2;\n354\t    const startY = 75;\n355\t\n356\t    for (let i = 0; i < chars.length; i++) {\n357\t      const row = Math.floor(i / 2);\n358\t      const col = i % 2;\n359\t      const cx = gridStartX + col * (cardW + 16);\n360\t      const cy = startY + row * (cardH + 12);\n361\t      if (x >= cx && x <= cx + cardW && y >= cy && y <= cy + cardH) {\n362\t        if (this.characterMgr.isUnlocked(i, this.dataManager.unlockedLevel)) {\n363\t          this.dataManager.selectedCharacter = i;\n364\t        }\n365\t        return { action: 'select_char', charId: i };\n366\t      }\n367\t    }\n368\t\n369\t    // Confirm button\n370\t    if (y >= h - 58 && y <= h - 16 && x >= 20 && x <= w - 20) {\n371\t      this.goTo(NAV_SCREENS.MAP);\n372\t      return { action: 'back' };\n373\t    }\n374\t    return null;\n375\t  }\n376\t\n377\t  // --- RESULT ---\n378\t  showResult(won, score, stars, level) {\n379\t    this.resultWon = won;\n380\t    this.resultScore = score;\n381\t    this.resultStars = stars;\n382\t    this.resultLevel = level;\n383\t    this.resultCoins = 0;\n384\t    this.resultDoubled = false;\n385\t    this.resultUsedContinue = false;\n386\t    if (won && stars > 0) {\n387\t      this.resultCoins = this.coinSystem.awardStars(stars);\n388\t      this.dataManager.setLevelStars(level, stars);\n389\t    }\n390\t    this.goTo(NAV_SCREENS.RESULT);\n391\t  }\n392\t\n393\t  _renderResult(ctx, w, h) {\n394\t    // Dim background\n395\t    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n396\t    ctx.fillRect(0, 0, w, h);\n397\t\n398\t    const pw = Math.min(320, w - 40);\n399\t    const ph = this.resultWon ? 380 : 400;\n400\t    const px = (w - pw) / 2;\n401\t    const py = (h - ph) / 2;\n402\t\n403\t    // Panel\n404\t    ctx.fillStyle = '#FFF8E7';\n405\t    this._roundRect(ctx, px, py, pw, ph, 16);\n406\t    ctx.fill();\n407\t    ctx.strokeStyle = '#FFB800';\n408\t    ctx.lineWidth = 3;\n409\t    this._roundRect(ctx, px, py, pw, ph, 16);\n410\t    ctx.stroke();\n411\t\n412\t    ctx.textAlign = 'center';\n413\t\n414\t    // Title\n415\t    ctx.fillStyle = '#5D4037';\n416\t    ctx.font = 'bold 24px sans-serif';\n417\t    ctx.fillText(this.resultWon ? '🎉 恭喜过关！' : '😢 挑战失败', w / 2, py + 45);\n418\t\n419\t    // Level number\n420\t    ctx.font = '14px sans-serif';\n421\t    ctx.fillStyle = '#8D6E63';\n422\t    ctx.fillText(`第 ${this.resultLevel} 关`, w / 2, py + 68);\n423\t\n424\t    // Score\n425\t    ctx.font = 'bold 36px sans-serif';\n426\t    ctx.fillStyle = '#FFB800';\n427\t    ctx.fillText(this.resultScore, w / 2, py + 110);\n428\t    ctx.font = '14px sans-serif';\n429\t    ctx.fillStyle = '#8D6E63';\n430\t    ctx.fillText('得分', w / 2, py + 130);\n431\t\n432\t    // Stars\n433\t    if (this.resultWon) {\n434\t      for (let i = 0; i < 3; i++) {\n435\t        ctx.font = '30px sans-serif';\n436\t        ctx.fillText(i < this.resultStars ? '⭐' : '☆', w / 2 - 40 + i * 40, py + 172);\n437\t      }\n438\t    }\n439\t\n440\t    // Coins earned\n441\t    if (this.resultCoins > 0) {\n442\t      const coinLabel = this.resultDoubled ? `+${this.resultCoins} 🪙 (已翻倍!)` : `+${this.resultCoins} 🪙`;\n443\t      ctx.fillStyle = this.resultDoubled ? '#FF4D4D' : '#FFB800';\n444\t      ctx.font = 'bold 18px sans-serif';\n445\t      ctx.fillText(coinLabel, w / 2, py + 205);\n446\t      ctx.fillStyle = '#8D6E63';\n447\t      ctx.font = '12px sans-serif';\n448\t      ctx.fillText(`余额: ${this.dataManager.coins} 🪙`, w / 2, py + 224);\n449\t\n450\t      // Phase 4: Double reward ad button\n451\t      if (!this.resultDoubled && AdManager.shouldShowAdButton(this.adManager, AD_PLACEMENTS.DOUBLE)) {\n452\t        const dBtnY = py + 235;\n453\t        ctx.fillStyle = '#FF4D4D';\n454\t        this._roundRect(ctx, w / 2 - 80, dBtnY, 160, 30, 15);\n455\t        ctx.fill();\n456\t        ctx.fillStyle = '#FFF';\n457\t        ctx.font = 'bold 12px sans-serif';\n458\t        ctx.fillText('🎬 看视频翻倍奖励', w / 2, dBtnY + 20);\n459\t      }\n460\t    }\n461\t\n462\t    // Phase 4: Continue via ad (fail screen)\n463\t    if (!this.resultWon && !this.resultUsedContinue) {\n464\t      const contBtnY = py + 250;\n465\t      if (AdManager.shouldShowAdButton(this.adManager, AD_PLACEMENTS.CONTINUE)) {\n466\t        ctx.fillStyle = '#6BCB77';\n467\t        this._roundRect(ctx, w / 2 - 100, contBtnY, 200, 34, 17);\n468\t        ctx.fill();\n469\t        ctx.fillStyle = '#FFF';\n470\t        ctx.font = 'bold 14px sans-serif';\n471\t        ctx.fillText('🎬 看视频+5步继续', w / 2, contBtnY + 22);\n472\t      } else if (this.coinSystem.canContinue()) {\n473\t        ctx.fillStyle = '#FFB800';\n474\t        this._roundRect(ctx, w / 2 - 80, contBtnY, 160, 30, 15);\n475\t        ctx.fill();\n476\t        ctx.fillStyle = '#FFF';\n477\t        ctx.font = 'bold 12px sans-serif';\n478\t        ctx.fillText('10🪙 购买+5步', w / 2, contBtnY + 20);\n479\t      }\n480\t    }\n481\t\n482\t    // Buttons\n483\t    const btnW = 120, btnH = 42;\n484\t    const btnY = py + ph - 65;\n485\t\n486\t    if (this.resultWon) {\n487\t      // Next level\n488\t      ctx.fillStyle = '#6BCB77';\n489\t      this._roundRect(ctx, w / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n490\t      ctx.fill();\n491\t      ctx.fillStyle = '#FFF';\n492\t      ctx.font = 'bold 16px sans-serif';\n493\t      ctx.fillText('下一关', w / 2 - btnW / 2 - 10, btnY + 27);\n494\t    } else {\n495\t      // Retry\n496\t      ctx.fillStyle = '#FF9A3C';\n497\t      this._roundRect(ctx, w / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n498\t      ctx.fill();\n499\t      ctx.fillStyle = '#FFF';\n500\t      ctx.font = 'bold 16px sans-serif';\n501\t      ctx.fillText('重试', w / 2 - btnW / 2 - 10, btnY + 27);\n502\t    }\n503\t\n504\t    // Map button\n505\t    ctx.fillStyle = '#8D6E63';\n506\t    this._roundRect(ctx, w / 2 + 10, btnY, btnW, btnH, btnH / 2);\n507\t    ctx.fill();\n508\t    ctx.fillStyle = '#FFF';\n509\t    ctx.fillText('🗺️ 地图', w / 2 + btnW / 2 + 10, btnY + 27);\n510\t  }\n511\t\n512\t  _handleResultClick(x, y, w, h) {\n513\t    const pw = Math.min(320, w - 40);\n514\t    const ph = this.resultWon ? 380 : 400;\n515\t    const px = (w - pw) / 2;\n516\t    const py = (h - ph) / 2;\n517\t    const btnW = 120, btnH = 42;\n518\t    const btnY = py + ph - 65;\n519\t\n520\t    // Phase 4: Double reward ad button\n521\t    if (this.resultWon && this.resultCoins > 0 && !this.resultDoubled) {\n522\t      if (AdManager.shouldShowAdButton(this.adManager, AD_PLACEMENTS.DOUBLE)) {\n523\t        const dBtnY = py + 235;\n524\t        if (x >= w / 2 - 80 && x <= w / 2 + 80 && y >= dBtnY && y <= dBtnY + 30) {\n525\t          this.adManager.showRewarded(AD_PLACEMENTS.DOUBLE).then((success) => {\n526\t            this.analytics.trackAdShow(AD_PLACEMENTS.DOUBLE, success);\n527\t            if (success) {\n528\t              this.resultDoubled = true;\n529\t              this.dataManager.addCoins(this.resultCoins);\n530\t            }\n531\t          });\n532\t          return { action: 'ad_double' };\n533\t        }\n534\t      }\n535\t    }\n536\t\n537\t    // Phase 4: Continue via ad button\n538\t    if (!this.resultWon && !this.resultUsedContinue) {\n539\t      const contBtnY = py + 250;\n540\t      if (AdManager.shouldShowAdButton(this.adManager, AD_PLACEMENTS.CONTINUE)) {\n541\t        if (x >= w / 2 - 100 && x <= w / 2 + 100 && y >= contBtnY && y <= contBtnY + 34) {\n542\t          this.adManager.showRewarded(AD_PLACEMENTS.CONTINUE).then((success) => {\n543\t            this.analytics.trackAdShow(AD_PLACEMENTS.CONTINUE, success);\n544\t            if (success) {\n545\t              this.resultUsedContinue = true;\n546\t              this.game.scoreSystem.addMoves(5);\n547\t              this.game.state = STATES.IDLE;\n548\t              this.goTo(NAV_SCREENS.GAME);\n549\t            }\n550\t          });\n551\t          return { action: 'ad_continue' };\n552\t        }\n553\t      } else if (this.coinSystem.canContinue()) {\n554\t        if (x >= w / 2 - 80 && x <= w / 2 + 80 && y >= contBtnY && y <= contBtnY + 30) {\n555\t          this.coinSystem.buyContinue();\n556\t          this.resultUsedContinue = true;\n557\t          this.game.scoreSystem.addMoves(5);\n558\t          this.game.state = STATES.IDLE;\n559\t          this.goTo(NAV_SCREENS.GAME);\n560\t          return { action: 'coin_continue' };\n561\t        }\n562\t      }\n563\t    }\n564\t\n565\t    // Next / Retry button\n566\t    if (x >= w / 2 - btnW - 10 && x <= w / 2 - 10 && y >= btnY && y <= btnY + btnH) {\n567\t      if (this.resultWon) {\n568\t        // Phase 4: show interstitial before next level\n569\t        this._tryInterstitial(() => {\n570\t          this.game.nextLevel();\n571\t          this.characterMgr.applySkill(\n572\t            this.dataManager.selectedCharacter,\n573\t            this.game, 'level_start', null,\n574\t          );\n575\t          this.goTo(NAV_SCREENS.GAME);\n576\t        });\n577\t      } else {\n578\t        this.game.retry();\n579\t        this.characterMgr.applySkill(\n580\t          this.dataManager.selectedCharacter,\n581\t          this.game, 'level_start', null,\n582\t        );\n583\t        this.goTo(NAV_SCREENS.GAME);\n584\t      }\n585\t      return { action: this.resultWon ? 'next' : 'retry' };\n586\t    }\n587\t\n588\t    // Map button\n589\t    if (x >= w / 2 + 10 && x <= w / 2 + 10 + btnW && y >= btnY && y <= btnY + btnH) {\n590\t      // Phase 4: show interstitial when going back to map\n591\t      this._tryInterstitial(() => {\n592\t        this.goTo(NAV_SCREENS.MAP);\n593\t      });\n594\t      return { action: 'map' };\n595\t    }\n596\t    return null;\n597\t  }\n598\t\n599\t  // Phase 4: Interstitial helper\n600\t  _tryInterstitial(callback) {\n601\t    if (this.adManager.canShowInterstitial(this.resultLevel)) {\n602\t      this.adManager.showInterstitial(this.resultLevel).then(() => {\n603\t        this.analytics.trackAdShow(AD_PLACEMENTS.INTERSTITIAL, true);\n604\t        callback();\n605\t      });\n606\t    } else {\n607\t      callback();\n608\t    }\n609\t  }\n610\t\n611\t  // --- DAILY ---\n612\t  _handleDailyClick(x, y, w, h) {\n613\t    const result = this.game.dailySystem.handleClick(x, y, w, h);\n614\t    if (!result) return null;\n615\t    if (result.action === 'back') {\n616\t      this.goTo(NAV_SCREENS.MAP);\n617\t    } else if (result.action === 'play_challenge') {\n618\t      this._startLevel(result.level);\n619\t    }\n620\t    return result;\n621\t  }\n622\t\n623\t  // --- SOCIAL ---\n624\t  _handleSocialClick(x, y, w, h) {\n625\t    const result = this.game.socialSystem.handleClick(x, y, w, h);\n626\t    if (!result) return null;\n627\t    if (result.action === 'back') {\n628\t      this.goTo(NAV_SCREENS.MAP);\n629\t    } else if (result.action === 'pk') {\n630\t      const pk = this.game.socialSystem.startPK(result.friendId);\n631\t      if (pk) {\n632\t        // Simulate PK result\n633\t        const myScore = Math.floor(Math.random() * 5000) + 1000;\n634\t        const theirScore = Math.floor(Math.random() * 5000) + 1000;\n635\t        const pkResult = this.game.socialSystem.resolvePK(result.friendId, myScore, theirScore);\n636\t        return { action: 'pk_result', ...pkResult, myScore, theirScore };\n637\t      }\n638\t    }\n639\t    return result;\n640\t  }\n641\t\n642\t  _roundRect(ctx, x, y, w, h, r) {\n643\t    ctx.beginPath();\n644\t    ctx.moveTo(x + r, y);\n645\t    ctx.lineTo(x + w - r, y);\n646\t    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n647\t    ctx.lineTo(x + w, y + h - r);\n648\t    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n649\t    ctx.lineTo(x + r, y + h);\n650\t    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n651\t    ctx.lineTo(x, y + r);\n652\t    ctx.quadraticCurveTo(x, y, x + r, y);\n653\t    ctx.closePath();\n654\t  }\n655\t}\n656\t\n657\tif (typeof module !== 'undefined') module.exports = { Navigation, NAV_SCREENS };\n658\t"}]},"parent_tool_use_id":null,"session_id":"7463fb62-2e03-4edd-abad-466ff792dff1","uuid":"7aa21f9c-34b5-4530-994b-c99db59f8ce6","timestamp":"2026-05-23T10:37:40.709Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-match3/src/js/Navigation.js","content":"// Navigation.js — Full screen navigation: menu → map → character → game → result\n\nconst NAV_SCREENS = {\n  MENU: 'menu',\n  MAP: 'map',\n  SHOP: 'shop',\n  CHARACTER: 'character',\n  GAME: 'game',\n  RESULT: 'result',\n  DAILY: 'daily',\n  SOCIAL: 'social',\n};\n\nclass Navigation {\n  constructor(game) {\n    this.game = game;\n    this.screen = NAV_SCREENS.MENU;\n    this.dataManager = game.dataManager;\n    this.coinSystem = game.coinSystem;\n    this.characterMgr = game.characterMgr;\n    this.mapScreen = game.mapScreen;\n    this.shopUI = game.shopUI;\n    this.adManager = game.adManager;\n    this.analytics = game.analytics;\n    this.resultCoins = 0;\n    this.resultWon = false;\n    this.resultScore = 0;\n    this.resultStars = 0;\n    this.resultLevel = 0;\n    this.resultDoubled = false;\n    this.resultUsedContinue = false;\n    this.menuAnim = 0;\n    this.showBoostPrompt = false;\n    this.boostLevel = -1;\n  }\n\n  isActive() {\n    return this.screen !== NAV_SCREENS.GAME;\n  }\n\n  goTo(screen) {\n    this.screen = screen;\n    this.game.input.active = (screen === NAV_SCREENS.GAME);\n  }\n\n  render(ctx, screenW, screenH) {\n    switch (this.screen) {\n      case NAV_SCREENS.MENU:\n        this._renderMenu(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.MAP:\n        this.mapScreen.render(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.SHOP:\n        this.shopUI.render(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.CHARACTER:\n        this._renderCharacterSelect(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.RESULT:\n        this._renderResult(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.DAILY:\n        this.game.dailySystem.render(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.SOCIAL:\n        this.game.socialSystem.render(ctx, screenW, screenH);\n        break;\n    }\n  }\n\n  handleClick(x, y, screenW, screenH) {\n    switch (this.screen) {\n      case NAV_SCREENS.MENU:\n        return this._handleMenuClick(x, y, screenW, screenH);\n      case NAV_SCREENS.MAP:\n        return this._handleMapClick(x, y, screenW, screenH);\n      case NAV_SCREENS.SHOP:\n        return this._handleShopClick(x, y, screenW, screenH);\n      case NAV_SCREENS.CHARACTER:\n        return this._handleCharacterClick(x, y, screenW, screenH);\n      case NAV_SCREENS.RESULT:\n        return this._handleResultClick(x, y, screenW, screenH);\n      case NAV_SCREENS.DAILY:\n        return this._handleDailyClick(x, y, screenW, screenH);\n      case NAV_SCREENS.SOCIAL:\n        return this._handleSocialClick(x, y, screenW, screenH);\n    }\n    return null;\n  }\n\n  // --- MENU ---\n  _renderMenu(ctx, w, h) {\n    this.menuAnim += 1 / 60;\n\n    // Gradient background\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0, '#FFE8F0');\n    grad.addColorStop(0.5, '#FFF8E7');\n    grad.addColorStop(1, '#E3F2FD');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n\n    // Floating fruit emojis\n    const emojis = ['🍎', '🍌', '🫐', '🍏', '🍇', '🍊'];\n    for (let i = 0; i < 12; i++) {\n      const bx = (w * 0.08 + (i * 137.5) % (w * 0.84));\n      const by = (h * 0.08 + (i * 97.3 + Math.sin(this.menuAnim * 0.8 + i * 0.7) * 25) % (h * 0.75));\n      ctx.globalAlpha = 0.12;\n      ctx.font = `${22 + (i % 3) * 8}px sans-serif`;\n      ctx.textAlign = 'center';\n      ctx.fillText(emojis[i % emojis.length], bx, by);\n    }\n    ctx.globalAlpha = 1;\n\n    // Title\n    const titleY = h * 0.22;\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 38px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('消消消大作战', w / 2, titleY);\n\n    // Subtitle with wave animation\n    ctx.font = '18px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText('Match & Blast', w / 2, titleY + 35);\n\n    // Fruit emoji row\n    ctx.font = '30px sans-serif';\n    for (let i = 0; i < 6; i++) {\n      const fx = w / 2 - 75 + i * 30;\n      const fy = titleY + 70 + Math.sin(this.menuAnim * 2 + i * 0.8) * 5;\n      ctx.fillText(emojis[i], fx, fy);\n    }\n\n    // Start button with pulse\n    const btnW = 200, btnH = 52;\n    const btnX = (w - btnW) / 2;\n    const btnY = h * 0.52;\n    const pulse = 1 + Math.sin(this.menuAnim * 2.5) * 0.03;\n\n    ctx.save();\n    ctx.translate(w / 2, btnY + btnH / 2);\n    ctx.scale(pulse, pulse);\n    ctx.translate(-w / 2, -(btnY + btnH / 2));\n\n    ctx.fillStyle = '#FFB800';\n    ctx.shadowColor = '#FFB80088';\n    ctx.shadowBlur = 15;\n    this._roundRect(ctx, btnX, btnY, btnW, btnH, 26);\n    ctx.fill();\n    ctx.shadowBlur = 0;\n\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.fillText('🎮 开始游戏', w / 2, btnY + 34);\n    ctx.restore();\n\n    // Continue (if has progress)\n    const completed = Object.keys(this.dataManager.data.levelStars).length;\n    if (completed > 0) {\n      const cBtnY = btnY + btnH + 20;\n      ctx.fillStyle = '#6BCB77';\n      this._roundRect(ctx, btnX, cBtnY, btnW, 44, 22);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText(`继续游戏 (${completed}关)`, w / 2, cBtnY + 28);\n    }\n\n    // Version\n    ctx.fillStyle = '#C0B8A8';\n    ctx.font = '12px sans-serif';\n    ctx.fillText('Phase 4 v1.0', w / 2, h - 20);\n  }\n\n  _handleMenuClick(x, y, w, h) {\n    const btnW = 200, btnH = 52;\n    const btnX = (w - btnW) / 2;\n    const btnY = h * 0.52;\n\n    // Start button\n    if (x >= btnX && x <= btnX + btnW && y >= btnY && y <= btnY + btnH) {\n      this.goTo(NAV_SCREENS.MAP);\n      return { action: 'start' };\n    }\n\n    // Continue button\n    const completed = Object.keys(this.dataManager.data.levelStars).length;\n    if (completed > 0) {\n      const cBtnY = btnY + btnH + 20;\n      if (x >= btnX && x <= btnX + btnW && y >= cBtnY && y <= cBtnY + 44) {\n        this.goTo(NAV_SCREENS.MAP);\n        return { action: 'start' };\n      }\n    }\n    return null;\n  }\n\n  // --- MAP ---\n  _handleMapClick(x, y, w, h) {\n    const result = this.mapScreen.handleClick(x, y, w, h);\n    if (!result) return null;\n\n    if (result.action === 'play') {\n      this._startLevel(result.level);\n    } else if (result.action === 'shop') {\n      this.goTo(NAV_SCREENS.SHOP);\n    } else if (result.action === 'character') {\n      this.goTo(NAV_SCREENS.CHARACTER);\n    } else if (result.action === 'daily') {\n      this.goTo(NAV_SCREENS.DAILY);\n    } else if (result.action === 'social') {\n      this.goTo(NAV_SCREENS.SOCIAL);\n    }\n    return result;\n  }\n\n  _startLevel(levelIdx) {\n    this.game._loadLevel(levelIdx);\n    this.game.state = STATES.IDLE;\n    this.characterMgr.applySkill(\n      this.dataManager.selectedCharacter,\n      this.game, 'level_start', null,\n    );\n    this.goTo(NAV_SCREENS.GAME);\n    // Phase 4: analytics\n    this.analytics.trackLevelStart(levelIdx + 1, this.game.levels[levelIdx] || {});\n  }\n\n  // --- SHOP ---\n  _handleShopClick(x, y, w, h) {\n    const result = this.shopUI.handleClick(x, y, w, h);\n    if (!result) return null;\n    if (result.action === 'buy') {\n      this.coinSystem.buy(result.itemId);\n    } else if (result.action === 'back') {\n      this.goTo(NAV_SCREENS.MAP);\n    }\n    return result;\n  }\n\n  // --- CHARACTER SELECT ---\n  _renderCharacterSelect(ctx, w, h) {\n    // Background\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0, '#F3E5F5');\n    grad.addColorStop(1, '#FFF8E7');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n\n    // Title bar\n    ctx.fillStyle = '#B47AEA';\n    this._roundRect(ctx, 10, 8, w - 20, 48, 12);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('👤 选择角色', w / 2, 40);\n\n    // Character cards\n    const chars = this.characterMgr.getAll();\n    const cardW = Math.min((w - 50) / 2, 160);\n    const cardH = 130;\n    const totalGridW = cardW * 2 + 16;\n    const gridStartX = (w - totalGridW) / 2;\n    const startY = 75;\n\n    for (let i = 0; i < chars.length; i++) {\n      const ch = chars[i];\n      const row = Math.floor(i / 2);\n      const col = i % 2;\n      const cx = gridStartX + col * (cardW + 16);\n      const cy = startY + row * (cardH + 12);\n      const unlocked = this.characterMgr.isUnlocked(i, this.dataManager.unlockedLevel);\n      const selected = this.dataManager.selectedCharacter === i;\n\n      // Card background\n      if (selected) {\n        ctx.fillStyle = '#FFE0B2';\n      } else if (unlocked) {\n        ctx.fillStyle = '#FFFFFFEE';\n      } else {\n        ctx.fillStyle = '#E8E0D8';\n      }\n      this._roundRect(ctx, cx, cy, cardW, cardH, 12);\n      ctx.fill();\n\n      // Selected border\n      if (selected) {\n        ctx.strokeStyle = '#FFB800';\n        ctx.lineWidth = 3;\n        this._roundRect(ctx, cx, cy, cardW, cardH, 12);\n        ctx.stroke();\n\n        // Check mark\n        ctx.fillStyle = '#FFB800';\n        ctx.font = '16px sans-serif';\n        ctx.textAlign = 'right';\n        ctx.fillText('✓', cx + cardW - 8, cy + 18);\n      }\n\n      // Emoji\n      ctx.font = '36px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText(unlocked ? ch.emoji : '🔒', cx + cardW / 2, cy + 45);\n\n      // Name\n      ctx.fillStyle = unlocked ? '#5D4037' : '#A09888';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText(ch.name, cx + cardW / 2, cy + 72);\n\n      // Title\n      ctx.font = '11px sans-serif';\n      ctx.fillStyle = unlocked ? '#B47AEA' : '#C0B8A8';\n      ctx.fillText(ch.title, cx + cardW / 2, cy + 88);\n\n      // Description or unlock requirement\n      ctx.fillStyle = unlocked ? '#8D6E63' : '#B0A898';\n      ctx.font = '10px sans-serif';\n      const desc = unlocked ? ch.desc : `通过第${ch.unlockLevel}关解锁`;\n      // Word wrap for long text\n      if (desc.length > 10) {\n        const mid = Math.ceil(desc.length / 2);\n        const spaceIdx = desc.indexOf(' ', mid - 3);\n        if (spaceIdx > 0 && spaceIdx < desc.length - 1) {\n          ctx.fillText(desc.substring(0, spaceIdx), cx + cardW / 2, cy + 104);\n          ctx.fillText(desc.substring(spaceIdx + 1), cx + cardW / 2, cy + 118);\n        } else {\n          ctx.fillText(desc.substring(0, Math.ceil(desc.length / 2)), cx + cardW / 2, cy + 104);\n          ctx.fillText(desc.substring(Math.ceil(desc.length / 2)), cx + cardW / 2, cy + 118);\n        }\n      } else {\n        ctx.fillText(desc, cx + cardW / 2, cy + 110);\n      }\n    }\n\n    // Confirm button\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, 20, h - 58, w - 40, 42, 21);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 16px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('确认返回', w / 2, h - 32);\n  }\n\n  _handleCharacterClick(x, y, w, h) {\n    const chars = this.characterMgr.getAll();\n    const cardW = Math.min((w - 50) / 2, 160);\n    const cardH = 130;\n    const totalGridW = cardW * 2 + 16;\n    const gridStartX = (w - totalGridW) / 2;\n    const startY = 75;\n\n    for (let i = 0; i < chars.length; i++) {\n      const row = Math.floor(i / 2);\n      const col = i % 2;\n      const cx = gridStartX + col * (cardW + 16);\n      const cy = startY + row * (cardH + 12);\n      if (x >= cx && x <= cx + cardW && y >= cy && y <= cy + cardH) {\n        if (this.characterMgr.isUnlocked(i, this.dataManager.unlockedLevel)) {\n          this.dataManager.selectedCharacter = i;\n        }\n        return { action: 'select_char', charId: i };\n      }\n    }\n\n    // Confirm button\n    if (y >= h - 58 && y <= h - 16 && x >= 20 && x <= w - 20) {\n      this.goTo(NAV_SCREENS.MAP);\n      return { action: 'back' };\n    }\n    return null;\n  }\n\n  // --- RESULT ---\n  showResult(won, score, stars, level) {\n    this.resultWon = won;\n    this.resultScore = score;\n    this.resultStars = stars;\n    this.resultLevel = level;\n    this.resultCoins = 0;\n    this.resultDoubled = false;\n    this.resultUsedContinue = false;\n    if (won && stars > 0) {\n      this.resultCoins = this.coinSystem.awardStars(stars);\n      this.dataManager.setLevelStars(level, stars);\n    }\n    this.goTo(NAV_SCREENS.RESULT);\n  }\n\n  _renderResult(ctx, w, h) {\n    // Dim background\n    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n    ctx.fillRect(0, 0, w, h);\n\n    const pw = Math.min(320, w - 40);\n    const ph = this.resultWon ? 380 : 400;\n    const px = (w - pw) / 2;\n    const py = (h - ph) / 2;\n\n    // Panel\n    ctx.fillStyle = '#FFF8E7';\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.fill();\n    ctx.strokeStyle = '#FFB800';\n    ctx.lineWidth = 3;\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.stroke();\n\n    ctx.textAlign = 'center';\n\n    // Title\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 24px sans-serif';\n    ctx.fillText(this.resultWon ? '🎉 恭喜过关！' : '😢 挑战失败', w / 2, py + 45);\n\n    // Level number\n    ctx.font = '14px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText(`第 ${this.resultLevel} 关`, w / 2, py + 68);\n\n    // Score\n    ctx.font = 'bold 36px sans-serif';\n    ctx.fillStyle = '#FFB800';\n    ctx.fillText(this.resultScore, w / 2, py + 110);\n    ctx.font = '14px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText('得分', w / 2, py + 130);\n\n    // Stars\n    if (this.resultWon) {\n      for (let i = 0; i < 3; i++) {\n        ctx.font = '30px sans-serif';\n        ctx.fillText(i < this.resultStars ? '⭐' : '☆', w / 2 - 40 + i * 40, py + 172);\n      }\n    }\n\n    // Coins earned\n    if (this.resultCoins > 0) {\n      const coinLabel = this.resultDoubled ? `+${this.resultCoins} 🪙 (已翻倍!)` : `+${this.resultCoins} 🪙`;\n      ctx.fillStyle = this.resultDoubled ? '#FF4D4D' : '#FFB800';\n      ctx.font = 'bold 18px sans-serif';\n      ctx.fillText(coinLabel, w / 2, py + 205);\n      ctx.fillStyle = '#8D6E63';\n      ctx.font = '12px sans-serif';\n      ctx.fillText(`余额: ${this.dataManager.coins} 🪙`, w / 2, py + 224);\n\n      // Phase 4: Double reward ad button\n      if (!this.resultDoubled && AdManager.shouldShowAdButton(this.adManager, AD_PLACEMENTS.DOUBLE)) {\n        const dBtnY = py + 235;\n        ctx.fillStyle = '#FF4D4D';\n        this._roundRect(ctx, w / 2 - 80, dBtnY, 160, 30, 15);\n        ctx.fill();\n        ctx.fillStyle = '#FFF';\n        ctx.font = 'bold 12px sans-serif';\n        ctx.fillText('🎬 看视频翻倍奖励', w / 2, dBtnY + 20);\n      }\n    }\n\n    // Phase 4: Continue via ad (fail screen)\n    if (!this.resultWon && !this.resultUsedContinue) {\n      const contBtnY = py + 250;\n      if (AdManager.shouldShowAdButton(this.adManager, AD_PLACEMENTS.CONTINUE)) {\n        ctx.fillStyle = '#6BCB77';\n        this._roundRect(ctx, w / 2 - 100, contBtnY, 200, 34, 17);\n        ctx.fill();\n        ctx.fillStyle = '#FFF';\n        ctx.font = 'bold 14px sans-serif';\n        ctx.fillText('🎬 看视频+5步继续', w / 2, contBtnY + 22);\n      } else if (this.coinSystem.canContinue()) {\n        ctx.fillStyle = '#FFB800';\n        this._roundRect(ctx, w / 2 - 80, contBtnY, 160, 30, 15);\n        ctx.fill();\n        ctx.fillStyle = '#FFF';\n        ctx.font = 'bold 12px sans-serif';\n        ctx.fillText('10🪙 购买+5步', w / 2, contBtnY + 20);\n      }\n    }\n\n    // Buttons\n    const btnW = 120, btnH = 42;\n    const btnY = py + ph - 65;\n\n    if (this.resultWon) {\n      // Next level\n      ctx.fillStyle = '#6BCB77';\n      this._roundRect(ctx, w / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText('下一关', w / 2 - btnW / 2 - 10, btnY + 27);\n    } else {\n      // Retry\n      ctx.fillStyle = '#FF9A3C';\n      this._roundRect(ctx, w / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText('重试', w / 2 - btnW / 2 - 10, btnY + 27);\n    }\n\n    // Map button\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, w / 2 + 10, btnY, btnW, btnH, btnH / 2);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.fillText('🗺️ 地图', w / 2 + btnW / 2 + 10, btnY + 27);\n  }\n\n  _handleResultClick(x, y, w, h) {\n    const pw = Math.min(320, w - 40);\n    const ph = this.resultWon ? 380 : 400;\n    const px = (w - pw) / 2;\n    const py = (h - ph) / 2;\n    const btnW = 120, btnH = 42;\n    const btnY = py + ph - 65;\n\n    // Phase 4: Double reward ad button\n    if (this.resultWon && this.resultCoins > 0 && !this.resultDoubled) {\n      if (AdManager.shouldShowAdButton(this.adManager, AD_PLACEMENTS.DOUBLE)) {\n        const dBtnY = py + 235;\n        if (x >= w / 2 - 80 && x <= w / 2 + 80 && y >= dBtnY && y <= dBtnY + 30) {\n          this.adManager.showRewarded(AD_PLACEMENTS.DOUBLE).then((success) => {\n            this.analytics.trackAdShow(AD_PLACEMENTS.DOUBLE, success);\n            if (success) {\n              this.resultDoubled = true;\n              this.dataManager.addCoins(this.resultCoins);\n            }\n          });\n          return { action: 'ad_double' };\n        }\n      }\n    }\n\n    // Phase 4: Continue via ad button\n    if (!this.resultWon && !this.resultUsedContinue) {\n      const contBtnY = py + 250;\n      if (AdManager.shouldShowAdButton(this.adManager, AD_PLACEMENTS.CONTINUE)) {\n        if (x >= w / 2 - 100 && x <= w / 2 + 100 && y >= contBtnY && y <= contBtnY + 34) {\n          this.adManager.showRewarded(AD_PLACEMENTS.CONTINUE).then((success) => {\n            this.analytics.trackAdShow(AD_PLACEMENTS.CONTINUE, success);\n            if (success) {\n              this.resultUsedContinue = true;\n              this.game.scoreSystem.addMoves(5);\n              this.game.state = STATES.IDLE;\n              this.goTo(NAV_SCREENS.GAME);\n            }\n          });\n          return { action: 'ad_continue' };\n        }\n      } else if (this.coinSystem.canContinue()) {\n        if (x >= w / 2 - 80 && x <= w / 2 + 80 && y >= contBtnY && y <= contBtnY + 30) {\n          this.coinSystem.buyContinue();\n          this.resultUsedContinue = true;\n          this.game.scoreSystem.addMoves(5);\n          this.game.state = STATES.IDLE;\n          this.goTo(NAV_SCREENS.GAME);\n          return { action: 'coin_continue' };\n        }\n      }\n    }\n\n    // Next / Retry button\n    if (x >= w / 2 - btnW - 10 && x <= w / 2 - 10 && y >= btnY && y <= btnY + btnH) {\n      if (this.resultWon) {\n        // Phase 4: show interstitial before next level\n        this._tryInterstitial(() => {\n          this.game.nextLevel();\n          this.characterMgr.applySkill(\n            this.dataManager.selectedCharacter,\n            this.game, 'level_start', null,\n          );\n          this.goTo(NAV_SCREENS.GAME);\n        });\n      } else {\n        this.game.retry();\n        this.characterMgr.applySkill(\n          this.dataManager.selectedCharacter,\n          this.game, 'level_start', null,\n        );\n        this.goTo(NAV_SCREENS.GAME);\n      }\n      return { action: this.resultWon ? 'next' : 'retry' };\n    }\n\n    // Map button\n    if (x >= w / 2 + 10 && x <= w / 2 + 10 + btnW && y >= btnY && y <= btnY + btnH) {\n      // Phase 4: show interstitial when going back to map\n      this._tryInterstitial(() => {\n        this.goTo(NAV_SCREENS.MAP);\n      });\n      return { action: 'map' };\n    }\n    return null;\n  }\n\n  // Phase 4: Interstitial helper\n  _tryInterstitial(callback) {\n    if (this.adManager.canShowInterstitial(this.resultLevel)) {\n      this.adManager.showInterstitial(this.resultLevel).then(() => {\n        this.analytics.trackAdShow(AD_PLACEMENTS.INTERSTITIAL, true);\n        callback();\n      });\n    } else {\n      callback();\n    }\n  }\n\n  // --- DAILY ---\n  _handleDailyClick(x, y, w, h) {\n    const result = this.game.dailySystem.handleClick(x, y, w, h);\n    if (!result) return null;\n    if (result.action === 'back') {\n      this.goTo(NAV_SCREENS.MAP);\n    } else if (result.action === 'play_challenge') {\n      this._startLevel(result.level);\n    }\n    return result;\n  }\n\n  // --- SOCIAL ---\n  _handleSocialClick(x, y, w, h) {\n    const result = this.game.socialSystem.handleClick(x, y, w, h);\n    if (!result) return null;\n    if (result.action === 'back') {\n      this.goTo(NAV_SCREENS.MAP);\n    } else if (result.action === 'pk') {\n      const pk = this.game.socialSystem.startPK(result.friendId);\n      if (pk) {\n        // Simulate PK result\n        const myScore = Math.floor(Math.random() * 5000) + 1000;\n        const theirScore = Math.floor(Math.random() * 5000) + 1000;\n        const pkResult = this.game.socialSystem.resolvePK(result.friendId, myScore, theirScore);\n        return { action: 'pk_result', ...pkResult, myScore, theirScore };\n      }\n    }\n    return result;\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Navigation, NAV_SCREENS };\n","numLines":658,"startLine":1,"totalLines":658}}}
