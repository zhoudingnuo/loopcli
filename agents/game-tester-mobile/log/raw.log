],frequency:81},\n41\t{id:\"e036\",idiom:\"鱼目混珠\",chars:[\"鱼\",\"目\",\"混\",\"珠\"],pinyin:\"yú mù hùn zhū\",meaning:\"比喻以假充真\",difficulty:1,category:[\"动物\"],frequency:80},\n42\t{id:\"e037\",idiom:\"龙马精神\",chars:[\"龙\",\"马\",\"精\",\"神\"],pinyin:\"lóng mǎ jīng shén\",meaning:\"比喻精神旺盛\",difficulty:1,category:[\"动物\"],frequency:80},\n43\t{id:\"e038\",idiom:\"画龙点睛\",chars:[\"画\",\"龙\",\"点\",\"睛\"],pinyin:\"huà lóng diǎn jīng\",meaning:\"比喻在关键处加上精辟的话使内容更加生动\",difficulty:1,category:[\"动物\"],frequency:79},\n44\t{id:\"e039\",idiom:\"骑虎难下\",chars:[\"骑\",\"虎\",\"难\",\"下\"],pinyin:\"qí hǔ nán xià\",meaning:\"比喻做事中途遇到困难但不能停止\",difficulty:1,category:[\"动物\"],frequency:79},\n45\t{id:\"e040\",idiom:\"指鹿为马\",chars:[\"指\",\"鹿\",\"为\",\"马\"],pinyin:\"zhǐ lù wéi mǎ\",meaning:\"比喻故意颠倒黑白混淆是非\",difficulty:1,category:[\"动物\"],frequency:78},\n46\t{id:\"e041\",idiom:\"鹏程万里\",chars:[\"鹏\",\"程\",\"万\",\"里\"],pinyin:\"péng chéng wàn lǐ\",meaning:\"比喻前程远大\",difficulty:1,category:[\"动物\",\"数字\"],frequency:78},\n47\t{id:\"e042\",idiom:\"开天辟地\",chars:[\"开\",\"天\",\"辟\",\"地\"],pinyin:\"kāi tiān pì dì\",meaning:\"比喻前所未有的伟大事业\",difficulty:1,category:[\"自然\"],frequency:77},\n48\t{id:\"e043\",idiom:\"惊天动地\",chars:[\"惊\",\"天\",\"动\",\"地\"],pinyin:\"jīng tiān dòng dì\",meaning:\"形容声势浩大或影响深远\",difficulty:1,category:[\"自然\"],frequency:77},\n49\t{id:\"e044\",idiom:\"欢天喜地\",chars:[\"欢\",\"天\",\"喜\",\"地\"],pinyin:\"huān tiān xǐ dì\",meaning:\"形容非常高兴\",difficulty:1,category:[\"情感\"],frequency:76},\n50\t{id:\"e045\",idiom:\"冰天雪地\",chars:[\"冰\",\"天\",\"雪\",\"地\"],pinyin:\"bīng tiān xuě dì\",meaning:\"形容冰雪漫天盖地\",difficulty:1,category:[\"自然\",\"四季\"],frequency:76},\n51\t{id:\"e046\",idiom:\"顶天立地\",chars:[\"顶\",\"天\",\"立\",\"地\"],pinyin:\"dǐng tiān lì dì\",meaning:\"形容形象高大气概豪迈\",difficulty:1,category:[\"人物\"],frequency:75},\n52\t{id:\"e047\",idiom:\"铺天盖地\",chars:[\"铺\",\"天\",\"盖\",\"地\"],pinyin:\"pū tiān gài dì\",meaning:\"形容来势猛声势大\",difficulty:1,category:[\"自然\"],frequency:75},\n53\t{id:\"e048\",idiom:\"漫不经心\",chars:[\"漫\",\"不\",\"经\",\"心\"],pinyin:\"màn bù jīng xīn\",meaning:\"形容随随便便不放在心上\",difficulty:1,category:[\"常用\"],frequency:74},\n54\t{id:\"e049\",idiom:\"异想天开\",chars:[\"异\",\"想\",\"天\",\"开\"],pinyin:\"yì xiǎng tiān kāi\",meaning:\"形容想法离奇不切实际\",difficulty:1,category:[\"常用\"],frequency:74},\n55\t{id:\"e050\",idiom:\"一鸣惊人\",chars:[\"一\",\"鸣\",\"惊\",\"人\"],pinyin:\"yī míng jīng rén\",meaning:\"比喻平时没有表现突然做出惊人的成绩\",difficulty:1,category:[\"数字\"],frequency:73},\n56\t{id:\"e051\",idiom:\"一帆风顺\",chars:[\"一\",\"帆\",\"风\",\"顺\"],pinyin:\"yī fān fēng shùn\",meaning:\"比喻非常顺利没有阻碍\",difficulty:1,category:[\"自然\"],frequency:73},\n57\t{id:\"e052\",idiom:\"一目了然\",chars:[\"一\",\"目\",\"了\",\"然\"],pinyin:\"yī mù liǎo rán\",meaning:\"一眼看去就清楚明白\",difficulty:1,category:[\"常用\"],frequency:72},\n58\t{id:\"e053\",idiom:\"一言为定\",chars:[\"一\",\"言\",\"为\",\"定\"],pinyin:\"yī yán wéi dìng\",meaning:\"一句话说定不再更改\",difficulty:1,category:[\"常用\"],frequency:72},\n59\t{id:\"e054\",idiom:\"一诺千金\",chars:[\"一\",\"诺\",\"千\",\"金\"],pinyin:\"yī nuò qiān jīn\",meaning:\"形容说话算数极有信用\",difficulty:1,category:[\"数字\"],frequency:71},\n60\t{id:\"e055\",idiom:\"一丝不苟\",chars:[\"一\",\"丝\",\"不\",\"苟\"],pinyin:\"yī sī bù gǒu\",meaning:\"形容做事认真仔细一点不马虎\",difficulty:1,category:[\"常用\"],frequency:71},\n61\t{id:\"e056\",idiom:\"一视同仁\",chars:[\"一\",\"视\",\"同\",\"仁\"],pinyin:\"yī shì tóng rén\",meaning:\"平等对待不分厚薄\",difficulty:1,category:[\"常用\"],frequency:70},\n62\t{id:\"e057\",idiom:\"一见钟情\",chars:[\"一\",\"见\",\"钟\",\"情\"],pinyin:\"yī jiàn zhōng qíng\",meaning:\"第一次见面就产生了爱情\",difficulty:1,category:[\"情感\"],frequency:70},\n63\t{id:\"e058\",idiom:\"半途而废\",chars:[\"半\",\"途\",\"而\",\"废\"],pinyin:\"bàn tú ér fèi\",meaning:\"做事中途停止没有坚持到底\",difficulty:1,category:[\"常用\"],frequency:69},\n64\t{id:\"e059\",idiom:\"大名鼎鼎\",chars:[\"大\",\"名\",\"鼎\",\"鼎\"],pinyin:\"dà míng dǐng dǐng\",meaning:\"形容名声很大\",difficulty:1,category:[\"人物\"],frequency:69},\n65\t{id:\"e060\",idiom:\"有名无实\",chars:[\"有\",\"名\",\"无\",\"实\"],pinyin:\"yǒu míng wú shí\",mean