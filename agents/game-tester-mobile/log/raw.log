fillCount === 4) {\n61\t        setTimeout(() => this._handleFull(result), 400);\n62\t      }\n63\t    } else if (result.action === 'full') {\n64\t      setTimeout(() => this._handleFull(result), 200);\n65\t    }\n66\t    if (this.onUpdate) this.onUpdate('pick');\n67\t    return result;\n68\t  }\n69\t\n70\t  removeSlot(slotIndex) {\n71\t    if (!this.active || !this.currentQ || this.currentQ.answered) return null;\n72\t    const result = this.judge.removeSlot(slotIndex);\n73\t    if (result.action === 'removed') this.audio.playPlace();\n74\t    if (this.onUpdate) this.onUpdate('pick');\n75\t    return result;\n76\t  }\n77\t\n78\t  useHintReveal() {\n79\t    if (!this.active || !this.currentQ || this.currentQ.answered) return null;\n80\t    const fc = this.judge.getFillCount();\n81\t    if (fc >= 4) return null;\n82\t    const ch = this.judge.currentIdiom.chars[fc];\n83\t    const cand = this.currentQ.candidates.find(c => c.char === ch && !c.used);\n84\t    if (!cand) return null;\n85\t    this.usedHintThisQuestion = true;\n86\t    this.audio.playHint();\n87\t    const result = this.judge.placeChar(cand.index);\n88\t    if (result.fillCount === 4) setTimeout(() => this._handleFull(result), 400);\n89\t    if (this.onUpdate) this.onUpdate('pick');\n90\t    return result;\n91\t  }\n92\t\n93\t  useHintRemove() {\n94\t    if (!this.active || !this.currentQ || this.currentQ.answered) return;\n95\t    const wrong = this.currentQ.candidates.filter(c =>\n96\t      !c.used && !this.judge.currentIdiom.chars.includes(c.char) && !c.removed\n97\t    );\n98\t    const cnt = Math.min(2, wrong.length);\n99\t    for (let i = 0; i < cnt; i++) {\n100\t      const idx = Math.floor(Math.random() * wrong.length);\n101\t      wrong[idx].removed = true;\n102\t      wrong.splice(idx, 1);\n103\t    }\n104\t    this.audio.playRemove();\n105\t    if (this.onUpdate) this.onUpdate('pick');\n106\t  }\n107\t\n108\t  _handleFull(result) {\n109\t    if (!this.currentQ || this.currentQ.answered) return;\n110\t    this.currentQ.answered = true;\n111\t    this.currentQ.correct = result.isCorrect;\n112\t    this.answeredCount++;\n113\t\n114\t    if (result.isCorrect) {\n115\t      this.audio.playCorrect();\n116\t      this.correctCount++;\n117\t      const cr = this.combo.onCorrect(this.usedHintThisQuestion);\n118\t      this.score = this.combo.score;\n119\t      if (cr.combo >= 3) this.audio.playCombo(cr.combo);\n120\t      this.data.collectIdiom(this.currentQ.idiom.id);\n121\t      this.currentQ.comboResult = cr;\n122\t      if (this.onUpdate) this.onUpdate('correct');\n123\t      setTimeout(() => this._nextQuestion(), 600);\n124\t    } else {\n125\t      this.audio.playWrong();\n126\t      this.combo.onWrong();\n127\t      this.score = this.combo.score;\n128\t      if (this.onUpdate) this.onUpdate('wrong');\n129\t      setTimeout(() => {\n130\t        if (!this.active) return;\n131\t        this.currentQ.answered = false;\n132\t        this.currentQ.correct = null;\n133\t        this.judge.startQuestion(this.currentQ);\n134\t        if (this.onUpdate) this.onUpdate('question');\n135\t      }, 500);\n136\t    }\n137\t  }\n138\t\n139\t  end() {\n140\t    this.active = false;\n141\t    if (this.timer) { clearInterval(this.timer); this.timer = null; }\n142\t    this.data.addTimedScore(this.score);\n143\t    this.data.addCoins(Math.floor(this.score / 10));\n144\t    if (this.onUpdate) this.onUpdate('end');\n145\t  }\n146\t\n147\t  getResult() {\n148\t    return {\n149\t      score: this.score,\n150\t      correctCount: this.correctCount,\n151\t      answeredCount: this.answeredCount,\n152\t      timeLeft: this.timeLeft,\n153\t      maxCombo: this.combo.maxCombo\n154\t    };\n155\t  }\n156\t}\n157\t\n158\tif (typeof module !== 'undefined') module.exports = { TimedChallenge };\n159\t"}]},"parent_tool_use_id":null,"session_id":"7463fb62-2e03-4edd-abad-466ff792dff1","uuid":"20016359-8866-480d-8fa6-d3dadd7ff328","timestamp":"2026-05-23T10:38:30.962Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/src/js/TimedChallenge.js","content":"// TimedChallenge.js — 60s timed challenge mode\n\nclass TimedChallenge {\n  constructor(engine, combo, audio, data) {\n    this.engine = engine;\n    this.combo = combo;\n    this.audio = audio;\n    this.data = data;\n    this.active = false;\n    this.timeLeft = 60;\n    this.timer = null;\n    this.questions = [];\n    this.currentQ = null;\n    this.judge = new Judge();\n    this.score = 0;\n    this.answeredCount = 0;\n    this.correctCount = 0;\n    this.onUpdate = null;\n    this.usedHintThisQuestion = false;\n  }\n\n  start() {\n    this.active = true;\n    this.timeLeft = 60;\n    this.score = 0;\n    this.answeredCount = 0;\n    this.correctCount = 0;\n    this.questions = [];\n    this.engine.reset();\n    this.combo.reset();\n    this._nextQuestion();\n    this.timer = setInterval(() => this._tick(), 1000);\n    if (this.onUpdate) this.onUpdate('start');\n  }\n\n  _tick() {\n    this.timeLeft--;\n    if (this.timeLeft <= 0) {\n      this.timeLeft = 0;\n      this.end();\n    }\n    if (this.onUpdate) this.onUpdate('tick');\n  }\n\n  _nextQuestion() {\n    const diff = Math.random() < 0.6 ? 2 : (Math.random() < 0.5 ? 1 : 3);\n    const q = this.engine.generateQuestion(diff);\n    if (!q) return;\n    this.currentQ = q;\n    this.judge.startQuestion(q);\n    this.usedHintThisQuestion = false;\n    if (this.onUpdate) this.onUpdate('question');\n  }\n\n  pickChar(candidateIndex) {\n    if (!this.active || !this.currentQ || this.currentQ.answered) return null;\n    const result = this.judge.placeChar(candidateIndex);\n    if (result.action === 'placed') {\n      this.audio.playPlace();\n      if (result.fillCount === 4) {\n        setTimeout(() => this._handleFull(result), 400);\n      }\n    } else if (result.action === 'full') {\n      setTimeout(() => this._handleFull(result), 200);\n    }\n    if (this.onUpdate) this.onUpdate('pick');\n    return result;\n  }\n\n  removeSlot(slotIndex) {\n    if (!this.active || !this.currentQ || this.currentQ.answered) return null;\n    const result = this.judge.removeSlot(slotIndex);\n    if (result.action === 'removed') this.audio.playPlace();\n    if (this.onUpdate) this.onUpdate('pick');\n    return result;\n  }\n\n  useHintReveal() {\n    if (!this.active || !this.currentQ || this.currentQ.answered) return null;\n    const fc = this.judge.getFillCount();\n    if (fc >= 4) return null;\n    const ch = this.judge.currentIdiom.chars[fc];\n    const cand = this.currentQ.candidates.find(c => c.char === ch && !c.used);\n    if (!cand) return null;\n    this.usedHintThisQuestion = true;\n    this.audio.playHint();\n    const result = this.judge.placeChar(cand.index);\n    if (result.fillCount === 4) setTimeout(() => this._handleFull(result), 400);\n    if (this.onUpdate) this.onUpdate('pick');\n    return result;\n  }\n\n  useHintRemove() {\n    if (!this.active || !this.currentQ || this.currentQ.answered) return;\n    const wrong = this.currentQ.candidates.filter(c =>\n      !c.used && !this.judge.currentIdiom.chars.includes(c.char) && !c.removed\n    );\n    const cnt = Math.min(2, wrong.length);\n    for (let i = 0; i < cnt; i++) {\n      const idx = Math.floor(Math.random() * wrong.length);\n      wrong[idx].removed = true;\n      wrong.splice(idx, 1);\n    }\n    this.audio.playRemove();\n    if (this.onUpdate) this.onUpdate('pick');\n  }\n\n  _handleFull(result) {\n    if (!this.currentQ || this.currentQ.answered) return;\n    this.currentQ.answered = true;\n    this.currentQ.correct = result.isCorrect;\n    this.answeredCount++;\n\n    if (result.isCorrect) {\n      this.audio.playCorrect();\n      this.correctCount++;\n      const cr = this.combo.onCorrect(this.usedHintThisQuestion);\n      this.score = this.combo.score;\n      if (cr.combo >= 3) this.audio.playCombo(cr.combo);\n      this.data.collectIdiom(this.currentQ.idiom.id);\n      this.currentQ.comboResult = cr;\n      if (this.onUpdate) this.onUpdate('correct');\n      setTimeout(() => this._nextQuestion(), 600);\n    } else {\n      this.audio.playWrong();\n      this.combo.onWrong();\n      this.score = this.combo.score;\n      if (this.onUpdate) this.onUpdate('wrong');\n      setTimeout(() => {\n        if (!this.active) return;\n        this.currentQ.answered = false;\n        this.currentQ.correct = null;\n        this.judge.startQuestion(this.currentQ);\n        if (this.onUpdate) this.onUpdate('question');\n      }, 500);\n    }\n  }\n\n  end() {\n    this.active = false;\n    if (this.timer) { clearInterval(this.timer); this.timer = null; }\n    this.data.addTimedScore(this.score);\n    this.data.addCoins(Math.floor(this.score / 10));\n    if (this.onUpdate) this.onUpdate('end');\n  }\n\n  getResult() {\n    return {\n      score: this.score,\n      correctCount: this.correctCount,\n      answeredCount: this.answeredCount,\n      timeLeft: this.timeLeft,\n      maxCombo: this.combo.maxCombo\n    };\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { TimedChallenge };\n","numLines":159,"startLine":1,"totalLines":159}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_e38be74d6b474682849ff86d","type":"tool_result","content":"1\t// SocialSystem.js — Share, friend leaderboard, friend PK, invite help (Douyin API stubs)\n2\t\n3\tclass SocialSystem {\n4\t  constructor(dataManager) {\n5\t    this.dm = dataManager;\n6\t    if (!this.dm.data.social) {\n7\t      this.dm.data.social = {\n8\t        userId: this._genId(),\n9\t        sharedToday: false,\n10\t        shareCount: 0,\n11\t        helpCount: 0,\n12\t        pkWins: 0,\n13\t        pkHistory: [],\n14\t        friends: this._genFakeFriends(),\n15\t      };\n16\t      this.dm.save();\n17\t    }\n18\t    this.social = this.dm.data.social;\n19\t    this.isDouyin = typeof tt !== 'undefined';\n20\t  }\n21\t\n22\t  _genId() {\n23\t    return 'u_' + Math.random().toString(36).slice(2, 10);\n24\t  }\n25\t\n26\t  _genFakeFriends() {\n27\t    const names = ['小明', '小红', '大壮', '阿花', '老王', '小李', '大毛', '阿杰'];\n28\t    return names.map((name, i) => ({\n29\t      id: 'f_' + i,\n30\t      name,\n31\t      avatar: ['😎', '🤗', '💪', '🌸', '🎯', '🎮', '🏆', '✨'][i],\n32\t      maxLevel: Math.floor(Math.random() * 40) + 5,\n33\t      totalStars: Math.floor(Math.random() * 80) + 10,\n34\t      score: Math.floor(Math.random() * 50000) + 5000,\n35\t    }));\n36\t  }\n37\t\n38\t  getUserId() { return this.social.userId; }\n39\t\n40\t  // --- Share ---\n41\t  shareResult(levelId, score, stars) {\n42\t    if (this.isDouyin) {\n43\t      try {\n44\t        tt.shareAppMessage({\n45\t          title: `我在消消消大作战第${levelId}关获得了${stars}星！来挑战我吧`,\n46\t          query: `from=share&level=${levelId}&inviter=${this.getUserId()}`,\n47\t        });\n48\t      } catch (e) { /* fallback */ }\n49\t    }\n50\t    this.social.shareCount++;\n51\t    this.social.sharedToday = true;\n52\t    this.dm.save();\n53\t    return { success: true, type: 'share_result' };\n54\t  }\n55\t\n56\t  shareHelp(levelId) {\n57\t    if (this.isDouyin) {\n58\t      try {\n59\t        tt.shareAppMessage({\n60\t          title: '帮帮我！我卡在这关了，送我5步继续挑战吧！',\n61\t          query: `from=help&level=${levelId}&inviter=${this.getUserId()}`,\n62\t        });\n63\t      } catch (e) { /* fallback */ }\n64\t    }\n65\t    this.social.helpCount++;\n66\t    this.dm.save();\n67\t    return { success: true, type: 'share_help', bonus: '+5步' };\n68\t  }\n69\t\n70\t  // --- Friend Leaderboard ---\n71\t  getLeaderboard() {\n72\t    const me = {\n73\t      id: this.getUserId(),\n74\t      name: '我',\n75\t      avatar: '🎮',\n76\t      score: this._getMyScore(),\n77\t      maxLevel: this.dm.unlockedLevel - 1,\n78\t      isMe: true,\n79\t    };\n80\t    const friends = this.social.friends.map(f => ({\n81\t      ...f,\n82\t      isMe: false,\n83\t      score: f.score + Math.floor(Math.random() * 500) - 250,\n84\t    }));\n85\t    const all = [me, ...friends].sort((a, b) => b.score - a.score);\n86\t    return all;\n87\t  }\n88\t\n89\t  _getMyScore() {\n90\t    let total = 0;\n91\t    for (const key of Object.keys(this.dm.data.levelStars)) {\n92\t      total += (this.dm.data.levelStars[key] || 0) * 1000 + Math.floor(Math.random() * 500);\n93\t    }\n94\t    return total;\n95\t  }\n96\t\n97\t  // --- Friend PK ---\n98\t  startPK(friendId) {\n99\t    const friend = this.social.friends.find(f => f.id === friendId);\n100\t    if (!friend) return null;\n101\t    return {\n102\t      opponent: friend,\n103\t      myMaxLevel: this.dm.unlockedLevel - 1,\n104\t      theirMaxLevel: friend.maxLevel,\n105\t    };\n106\t  }\n107\t\n108\t  resolvePK(friendId, myScore, theirScore) {\n109\t    const won = myScore > theirScore;\n110\t    if (won) {\n111\t      this.social.pkWins++;\n112\t      this.dm.addCoins(20);\n113\t    }\n114\t    this.social.pkHistory.push({\n115\t      friendId, myScore, theirScore, won, time: Date.now(),\n116\t    });\n117\t    if (this.social.pkHistory.length > 20) this.social.pkHistory.shift();\n118\t    this.dm.save();\n119\t    return { won, coinsWon: won ? 20 : 0 };\n120\t  }\n121\t\n122\t  getPKRecord() {\n123\t    return { wins: this.social.pkWins, total: this.social.pkHistory.length };\n124\t  }\n125\t\n126\t  // --- Invite Help ---\n127\t  receiveHelp() {\n128\t    this.dm.addItem('extra_moves', 1);\n129\t    this.dm.save();\n130\t    return { bonus: '+5步道具' };\n131\t  }\n132\t\n133\t  // --- Render ---\n134\t  render(ctx, screenW, screenH) {\n135\t    const grad = ctx.createLinearGradient(0, 0, 0, screenH);\n136\t    grad.addColorStop(0, '#E3F2FD');\n137\t    grad.addColorStop(0.5, '#F3E5F5');\n138\t    grad.addColorStop(1, '#FFF8E7');\n139\t    ctx.fillStyle = grad;\n140\t    ctx.fillRect(0, 0, screenW, screenH);\n141\t\n142\t    // Title bar\n143\t    ctx.fillStyle = '#4DA6FF';\n144\t    this._roundRect(ctx, 10, 8, screenW - 20, 48, 12);\n145\t    ctx.fill();\n146\t    ctx.fillStyle = '#FFF';\n147\t    ctx.font = 'bold 20px sans-serif';\n148\t    ctx.textAlign = 'center';\n149\t    ctx.fillText('👥 社交中心', screenW / 2, 40);\n150\t\n151\t    // Tab navigation\n152\t    const tabs = ['🏆 排行', '⚔️ PK', '📤 分享'];\n153\t    const tabW = (screenW - 40) / tabs.length;\n154\t    for (let i = 0; i < tabs.length; i++) {\n155\t      const active = (this._tab || 0) === i;\n156\t      ctx.fillStyle = active ? '#FFB800' : '#E8E0D8';\n157\t      this._roundRect(ctx, 20 + i * tabW, 65, tabW - 4, 30, 15);\n158\t      ctx.fill();\n159\t      ctx.fillStyle = active ? '#FFF' : '#8D6E63';\n160\t      ctx.font = 'bold 12px sans-serif';\n161\t      ctx.fillText(tabs[i], 20 + i * tabW + (tabW - 4) / 2, 85);\n162\t    }\n163\t\n164\t    const tab = this._tab || 0;\n165\t    if (tab === 0) this._renderLeaderboard(ctx, screenW, screenH);\n166\t    else if (tab === 1) this._renderPK(ctx, screenW, screenH);\n167\t    else this._renderShare(ctx, screenW, screenH);\n168\t\n169\t    // Back button\n170\t    ctx.fillStyle = '#8D6E63';\n171\t    this._roundRect(ctx, 20, screenH - 50, screenW - 40, 38, 19);\n172\t    ctx.fill();\n173\t    ctx.fillStyle = '#FFF';\n174\t    ctx.font = 'bold 14px sans-serif';\n175\t    ctx.fillText('返回地图', screenW / 2, screenH - 27);\n176\t  }\n177\t\n178\t  _renderLeaderboard(ctx, w, h) {\n179\t    const leaders = this.getLeaderboard();\n180\t    const startY = 108;\n181\t    ctx.fillStyle = '#5D4037';\n182\t    ctx.font = 'bold 14px sans-serif';\n183\t    ctx.textAlign = 'center';\n184\t    ctx.fillText('好友排行榜', w / 2, startY);\n185\t\n186\t    for (let i = 0; i < Math.min(leaders.length, 8); i++) {\n187\t      const l = leaders[i];\n188\t      const ly = startY + 14 + i * 48;\n189\t      ctx.fillStyle = l.isMe ? '#FFE0B2' : '#FFFFFFEE';\n190\t      this._roundRect(ctx, 20, ly, w - 40, 42, 8);\n191\t      ctx.fill();\n192\t\n193\t      if (l.isMe) {\n194\t        ctx.strokeStyle = '#FFB800';\n195\t        ctx.lineWidth = 2;\n196\t        this._roundRect(ctx, 20, ly, w - 40, 42, 8);\n197\t        ctx.stroke();\n198\t      }\n199\t\n200\t      // Rank\n201\t      ctx.textAlign = 'left';\n202\t      ctx.font = 'bold 16px sans-serif';\n203\t      ctx.fillStyle = i < 3 ? ['#FFD700', '#C0C0C0', '#CD7F32'][i] : '#8D6E63';\n204\t      const medals = ['🥇', '🥈', '🥉'];\n205\t      ctx.fillText(i < 3 ? medals[i] : `${i + 1}`, 30, ly + 28);\n206\t\n207\t      // Avatar\n208\t      ctx.font = '22px sans-serif';\n209\t      ctx.fillText(l.avatar, 65, ly + 30);\n210\t\n211\t      // Name & score\n212\t      ctx.font = 'bold 13px sans-serif';\n213\t      ctx.fillStyle = '#5D4037';\n214\t      ctx.fillText(l.name + (l.isMe ? ' (我)' : ''), 95, ly + 18);\n215\t      ctx.font = '11px sans-serif';\n216\t      ctx.fillStyle = '#8D6E63';\n217\t      ctx.fillText(`Lv.${l.maxLevel} | ${l.score.toLocaleString()}分`, 95, ly + 34);\n218\t    }\n219\t  }\n220\t\n221\t  _renderPK(ctx, w, h) {\n222\t    const startY = 108;\n223\t    const record = this.getPKRecord();\n224\t    ctx.fillStyle = '#5D4037';\n225\t    ctx.font = 'bold 14px sans-serif';\n226\t    ctx.textAlign = 'center';\n227\t    ctx.fillText(`PK战绩: ${record.wins}胜 / ${record.total}场`, w / 2, startY);\n228\t\n229\t    const friends = this.social.friends.slice(0, 6);\n230\t    for (let i = 0; i < friends.length; i++) {\n231\t      const f = friends[i];\n232\t      const fy = startY + 14 + i * 52;\n233\t      ctx.fillStyle = '#FFFFFFEE';\n234\t      this._roundRect(ctx, 20, fy, w - 40, 46, 8);\n235\t      ctx.fill();\n236\t\n237\t      ctx.textAlign = 'left';\n238\t      ctx.font = '20px sans-serif';\n239\t      ctx.fillText(f.avatar, 30, fy + 30);\n240\t      ctx.font = 'bold 13px sans-serif';\n241\t      ctx.fillStyle = '#5D4037';\n242\t      ctx.fillText(f.name, 58, fy + 20);\n243\t      ctx.font = '11px sans-serif';\n244\t      ctx.fillStyle = '#8D6E63';\n245\t      ctx.fillText(`Lv.${f.maxLevel} | ${f.score.toLocaleString()}分`, 58, fy + 36);\n246\t\n247\t      // Challenge button\n248\t      ctx.fillStyle = '#FF4D4D';\n249\t      this._roundRect(ctx, w - 90, fy + 8, 58, 30, 15);\n250\t      ctx.fill();\n251\t      ctx.fillStyle = '#FFF';\n252\t      ctx.font = 'bold 12px sans-serif';\n253\t      ctx.textAlign = 'center';\n254\t      ctx.fillText('挑战', w - 61, fy + 28);\n255\t    }\n256\t  }\n257\t\n258\t  _renderShare(ctx, w, h) {\n259\t    const startY = 108;\n260\t    ctx.fillStyle = '#5D4037';\n261\t    ctx.font = 'bold 14px sans-serif';\n262\t    ctx.textAlign = 'center';\n263\t    ctx.fillText(`已分享 ${this.social.shareCount} 次`, w / 2, startY);\n264\t\n265\t    const buttons = [\n266\t      { label: '分享战绩', emoji: '🏆', color: '#6BCB77', desc: '分享给好友炫耀' },\n267\t      { label: '求助续命', emoji: '🆘', color: '#FF4D4D', desc: '好友助力+5步' },\n268\t      { label: '邀请好友', emoji: '🎁', color: '#B47AEA', desc: '邀请得20🪙' },\n269\t    ];\n270\t\n271\t    for (let i = 0; i < buttons.length; i++) {\n272\t      const b = buttons[i];\n273\t      const by = startY + 20 + i * 70;\n274\t      ctx.fillStyle = b.color + '20';\n275\t      this._roundRect(ctx, 20, by, w - 40, 60, 12);\n276\t      ctx.fill();\n277\t      ctx.strokeStyle = b.color;\n278\t      ctx.lineWidth = 2;\n279\t      this._roundRect(ctx, 20, by, w - 40, 60, 12);\n280\t      ctx.stroke();\n281\t\n282\t      ctx.font = '28px sans-serif';\n283\t      ctx.textAlign = 'center';\n284\t      ctx.fillText(b.emoji, w / 2 - 80, by + 38);\n285\t      ctx.textAlign = 'left';\n286\t      ctx.fillStyle = '#5D4037';\n287\t      ctx.font = 'bold 14px sans-serif';\n288\t      ctx.fillText(b.label, w / 2 - 50, by + 28);\n289\t      ctx.font = '11px sans-serif';\n290\t      ctx.fillStyle = '#8D6E63';\n291\t      ctx.fillText(b.desc, w / 2 - 50, by + 46);\n292\t    }\n293\t  }\n294\t\n295\t  handleClick(x, y, screenW, screenH) {\n296\t    // Tab clicks\n297\t    const tabs = 3;\n298\t    const tabW = (screenW - 40) / tabs;\n299\t    if (y >= 65 && y <= 95) {\n300\t      for (let i = 0; i < tabs; i++) {\n301\t        const tx = 20 + i * tabW;\n302\t        if (x >= tx && x <= tx + tabW - 4) {\n303\t          this._tab = i;\n304\t          return { action: 'switch_tab', tab: i };\n305\t        }\n306\t      }\n307\t    }\n308\t\n309\t    const tab = this._tab || 0;\n310\t    if (tab === 1) {\n311\t      // PK challenge buttons\n312\t      const startY = 108;\n313\t      const friends = this.social.friends.slice(0, 6);\n314\t      for (let i = 0; i < friends.length; i++) {\n315\t        const fy = startY + 14 + i * 52;\n316\t        if (x >= screenW - 90 && x <= screenW - 32 && y >= fy + 8 && y <= fy + 38) {\n317\t          return { action: 'pk', friendId: friends[i].id };\n318\t        }\n319\t      }\n320\t    }\n321\t\n322\t    if (tab === 2) {\n323\t      // Share buttons\n324\t      const startY = 108;\n325\t      for (let i = 0; i < 3; i++) {\n326\t        const by = startY + 20 + i * 70;\n327\t        if (x >= 20 && x <= screenW - 20 && y >= by && y <= by + 60) {\n328\t          if (i === 0) return { action: 'share_result' };\n329\t          if (i === 1) return { action: 'share_help' };\n330\t          if (i === 2) {\n331\t            this.social.shareCount++;\n332\t            this.dm.addCoins(20);\n333\t            this.dm.save();\n334\t            return { action: 'share_invite', reward: 20 };\n335\t          }\n336\t        }\n337\t      }\n338\t    }\n339\t\n340\t    // Back button\n341\t    if (y >= screenH - 50 && y <= screenH - 12 && x >= 20 && x <= screenW - 20) {\n342\t      return { action: 'back' };\n343\t    }\n344\t\n345\t    return null;\n346\t  }\n347\t\n348\t  _roundRect(ctx, x, y, w, h, r) {\n349\t    ctx.beginPath();\n350\t    ctx.moveTo(x + r, y);\n351\t    ctx.lineTo(x + w - r, y);\n352\t    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n353\t    ctx.lineTo(x + w, y + h - r);\n354\t    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n355\t    ctx.lineTo(x + r, y + h);\n356\t    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n357\t    ctx.lineTo(x, y + r);\n358\t    ctx.quadraticCurveTo(x, y, x + r, y);\n359\t    ctx.closePath();\n360\t  }\n361\t}\n362\t\n363\tif (typeof module !== 'undefined') module.exports = { SocialSystem };\n364\t"}]},"parent_tool_use_id":null,"session_id":"7463fb62-2e03-4edd-abad-466ff792dff1","uuid":"a7590ab5-c1f4-4021-a642-3a26bc258d94","timestamp":"2026-05-23T10:38:30.965Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-match3/src/js/SocialSystem.js","content":"// SocialSystem.js — Share, friend leaderboard, friend PK, invite help (Douyin API stubs)\n\nclass SocialSystem {\n  constructor(dataManager) {\n    this.dm = dataManager;\n    if (!this.dm.data.social) {\n      this.dm.data.social = {\n        userId: this._genId(),\n        sharedToday: false,\n        shareCount: 0,\n        helpCount: 0,\n        pkWins: 0,\n        pkHistory: [],\n        friends: this._genFakeFriends(),\n      };\n      this.dm.save();\n    }\n    this.social = this.dm.data.social;\n    this.isDouyin = typeof tt !== 'undefined';\n  }\n\n  _genId() {\n    return 'u_' + Math.random().toString(36).slice(2, 10);\n  }\n\n  _genFakeFriends() {\n    const names = ['小明', '小红', '大壮', '阿花', '老王', '小李', '大毛', '阿杰'];\n    return names.map((name, i) => ({\n      id: 'f_' + i,\n      name,\n      avatar: ['😎', '🤗', '💪', '🌸', '🎯', '🎮', '🏆', '✨'][i],\n      maxLevel: Math.floor(Math.random() * 40) + 5,\n      totalStars: Math.floor(Math.random() * 80) + 10,\n      score: Math.floor(Math.random() * 50000) + 5000,\n    }));\n  }\n\n  getUserId() { return this.social.userId; }\n\n  // --- Share ---\n  shareResult(levelId, score, stars) {\n    if (this.isDouyin) {\n      try {\n        tt.shareAppMessage({\n          title: `我在消消消大作战第${levelId}关获得了${stars}星！来挑战我吧`,\n          query: `from=share&level=${levelId}&inviter=${this.getUserId()}`,\n        });\n      } catch (e) { /* fallback */ }\n    }\n    this.social.shareCount++;\n    this.social.sharedToday = true;\n    this.dm.save();\n    return { success: true, type: 'share_result' };\n  }\n\n  shareHelp(levelId) {\n    if (this.isDouyin) {\n      try {\n        tt.shareAppMessage({\n          title: '帮帮我！我卡在这关了，送我5步继续挑战吧！',\n          query: `from=help&level=${levelId}&inviter=${this.getUserId()}`,\n        });\n      } catch (e) { /* fallback */ }\n    }\n    this.social.helpCount++;\n    this.dm.save();\n    return { success: true, type: 'share_help', bonus: '+5步' };\n  }\n\n  // --- Friend Leaderboard ---\n  getLeaderboard() {\n    const me = {\n      id: this.getUserId(),\n      name: '我',\n      avatar: '🎮',\n      score: this._getMyScore(),\n      maxLevel: this.dm.unlockedLevel - 1,\n      isMe: true,\n    };\n    const friends = this.social.friends.map(f => ({\n      ...f,\n      isMe: false,\n      score: f.score + Math.floor(Math.random() * 500) - 250,\n    }));\n    const all = [me, ...friends].sort((a, b) => b.score - a.score);\n    return all;\n  }\n\n  _getMyScore() {\n    let total = 0;\n    for (const key of Object.keys(this.dm.data.levelStars)) {\n      total += (this.dm.data.levelStars[key] || 0) * 1000 + Math.floor(Math.random() * 500);\n    }\n    return total;\n  }\n\n  // --- Friend PK ---\n  startPK(friendId) {\n    const friend = this.social.friends.find(f => f.id === friendId);\n    if (!friend) return null;\n    return {\n      opponent: friend,\n      myMaxLevel: this.dm.unlockedLevel - 1,\n      theirMaxLevel: friend.maxLevel,\n    };\n  }\n\n  resolvePK(friendId, myScore, theirScore) {\n    const won = myScore > theirScore;\n    if (won) {\n      this.social.pkWins++;\n      this.dm.addCoins(20);\n    }\n    this.social.pkHistory.push({\n      friendId, myScore, theirScore, won, time: Date.now(),\n    });\n    if (this.social.pkHistory.length > 20) this.social.pkHistory.shift();\n    this.dm.save();\n    return { won, coinsWon: won ? 20 : 0 };\n  }\n\n  getPKRecord() {\n    return { wins: this.social.pkWins, total: this.social.pkHistory.length };\n  }\n\n  // --- Invite Help ---\n  receiveHelp() {\n    this.dm.addItem('extra_moves', 1);\n    this.dm.save();\n    return { bonus: '+5步道具' };\n  }\n\n  // --- Render ---\n  render(ctx, screenW, screenH) {\n    const grad = ctx.createLinearGradient(0, 0, 0, screenH);\n    grad.addColorStop(0, '#E3F2FD');\n    grad.addColorStop(0.5, '#F3E5F5');\n    grad.addColorStop(1, '#FFF8E7');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, screenW, screenH);\n\n    // Title bar\n    ctx.fillStyle = '#4DA6FF';\n    this._roundRect(ctx, 10, 8, screenW - 20, 48, 12);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('👥 社交中心', screenW / 2, 40);\n\n    // Tab navigation\n    const tabs = ['🏆 排行', '⚔️ PK', '📤 分享'];\n    const tabW = (screenW - 40) / tabs.length;\n    for (let i = 0; i < tabs.length; i++) {\n      const active = (this._tab || 0) === i;\n      ctx.fillStyle = active ? '#FFB800' : '#E8E0D8';\n      this._roundRect(ctx, 20 + i * tabW, 65, tabW - 4, 30, 15);\n      ctx.fill();\n      ctx.fillStyle = active ? '#FFF' : '#8D6E63';\n      ctx.font = 'bold 12px sans-serif';\n      ctx.fillText(tabs[i], 20 + i * tabW + (tabW - 4) / 2, 85);\n    }\n\n    const tab = this._tab || 0;\n    if (tab === 0) this._renderLeaderboard(ctx, screenW, screenH);\n    else if (tab === 1) this._renderPK(ctx, screenW, screenH);\n    else this._renderShare(ctx, screenW, screenH);\n\n    // Back button\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, 20, screenH - 50, screenW - 40, 38, 19);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 14px sans-serif';\n    ctx.fillText('返回地图', screenW / 2, screenH - 27);\n  }\n\n  _renderLeaderboard(ctx, w, h) {\n    const leaders = this.getLeaderboard();\n    const startY = 108;\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 14px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('好友排行榜', w / 2, startY);\n\n    for (let i = 0; i < Math.min(leaders.length, 8); i++) {\n      const l = leaders[i];\n      const ly = startY + 14 + i * 48;\n      ctx.fillStyle = l.isMe ? '#FFE0B2' : '#FFFFFFEE';\n      this._roundRect(ctx, 20, ly, w - 40, 42, 8);\n      ctx.fill();\n\n      if (l.isMe) {\n        ctx.strokeStyle = '#FFB800';\n        ctx.lineWidth = 2;\n        this._roundRect(ctx, 20, ly, w - 40, 42, 8);\n        ctx.stroke();\n      }\n\n      // Rank\n      ctx.textAlign = 'left';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillStyle = i < 3 ? ['#FFD700', '#C0C0C0', '#CD7F32'][i] : '#8D6E63';\n      const medals = ['🥇', '🥈', '🥉'];\n      ctx.fillText(i < 3 ? medals[i] : `${i + 1}`, 30, ly + 28);\n\n      // Avatar\n      ctx.font = '22px sans-serif';\n      ctx.fillText(l.avatar, 65, ly + 30);\n\n      // Name & score\n      ctx.font = 'bold 13px sans-serif';\n      ctx.fillStyle = '#5D4037';\n      ctx.fillText(l.name + (l.isMe ? ' (我)' : ''), 95, ly + 18);\n      ctx.font = '11px sans-serif';\n      ctx.fillStyle = '#8D6E63';\n      ctx.fillText(`Lv.${l.maxLevel} | ${l.score.toLocaleString()}分`, 95, ly + 34);\n    }\n  }\n\n  _renderPK(ctx, w, h) {\n    const startY = 108;\n    const record = this.getPKRecord();\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 14px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(`PK战绩: ${record.wins}胜 / ${record.total}场`, w / 2, startY);\n\n    const friends = this.social.friends.slice(0, 6);\n    for (let i = 0; i < friends.length; i++) {\n      const f = friends[i];\n      const fy = startY + 14 + i * 52;\n      ctx.fillStyle = '#FFFFFFEE';\n      this._roundRect(ctx, 20, fy, w - 40, 46, 8);\n      ctx.fill();\n\n      ctx.textAlign = 'left';\n      ctx.font = '20px sans-serif';\n      ctx.fillText(f.avatar, 30, fy + 30);\n      ctx.font = 'bold 13px sans-serif';\n      ctx.fillStyle = '#5D4037';\n      ctx.fillText(f.name, 58, fy + 20);\n      ctx.font = '11px sans-serif';\n      ctx.fillStyle = '#8D6E63';\n      ctx.fillText(`Lv.${f.maxLevel} | ${f.score.toLocaleString()}分`, 58, fy + 36);\n\n      // Challenge button\n      ctx.fillStyle = '#FF4D4D';\n      this._roundRect(ctx, w - 90, fy + 8, 58, 30, 15);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 12px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText('挑战', w - 61, fy + 28);\n    }\n  }\n\n  _renderShare(ctx, w, h) {\n    const startY = 108;\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 14px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(`已分享 ${this.social.shareCount} 次`, w / 2, startY);\n\n    const buttons = [\n      { label: '分享战绩', emoji: '🏆', color: '#6BCB77', desc: '分享给好友炫耀' },\n      { label: '求助续命', emoji: '🆘', color: '#FF4D4D', desc: '好友助力+5步' },\n      { label: '邀请好友', emoji: '🎁', color: '#B47AEA', desc: '邀请得20🪙' },\n    ];\n\n    for (let i = 0; i < buttons.length; i++) {\n      const b = buttons[i];\n      const by = startY + 20 + i * 70;\n      ctx.fillStyle = b.color + '20';\n      this._roundRect(ctx, 20, by, w - 40, 60, 12);\n      ctx.fill();\n      ctx.strokeStyle = b.color;\n      ctx.lineWidth = 2;\n      this._roundRect(ctx, 20, by, w - 40, 60, 12);\n      ctx.stroke();\n\n      ctx.font = '28px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText(b.emoji, w / 2 - 80, by + 38);\n      ctx.textAlign = 'left';\n      ctx.fillStyle = '#5D4037';\n      ctx.font = 'bold 14px sans-serif';\n      ctx.fillText(b.label, w / 2 - 50, by + 28);\n      ctx.font = '11px sans-serif';\n      ctx.fillStyle = '#8D6E63';\n      ctx.fillText(b.desc, w / 2 - 50, by + 46);\n    }\n  }\n\n  handleClick(x, y, screenW, screenH) {\n    // Tab clicks\n    const tabs = 3;\n    const tabW = (screenW - 40) / tabs;\n    if (y >= 65 && y <= 95) {\n      for (let i = 0; i < tabs; i++) {\n        const tx = 20 + i * tabW;\n        if (x >= tx && x <= tx + tabW - 4) {\n          this._tab = i;\n          return { action: 'switch_tab', tab: i };\n        }\n      }\n    }\n\n    const tab = this._tab || 0;\n    if (tab === 1) {\n      // PK challenge buttons\n      const startY = 108;\n      const friends = this.social.friends.slice(0, 6);\n      for (let i = 0; i < friends.length; i++) {\n        const fy = startY + 14 + i * 52;\n        if (x >= screenW - 90 && x <= screenW - 32 && y >= fy + 8 && y <= fy + 38) {\n          return { action: 'pk', friendId: friends[i].id };\n        }\n      }\n    }\n\n    if (tab === 2) {\n      // Share buttons\n      const startY = 108;\n      for (let i = 0; i < 3; i++) {\n        const by = startY + 20 + i * 70;\n        if (x >= 20 && x <= screenW - 20 && y >= by && y <= by + 60) {\n          if (i === 0) return { action: 'share_result' };\n          if (i === 1) return { action: 'share_help' };\n          if (i === 2) {\n            this.social.shareCount++;\n            this.dm.addCoins(20);\n            this.dm.save();\n            return { action: 'share_invite', reward: 20 };\n          }\n        }\n      }\n    }\n\n    // Back button\n    if (y >= screenH - 50 && y <= screenH - 12 && x >= 20 && x <= screenW - 20) {\n      return { action: 'back' };\n    }\n\n    return null;\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { SocialSystem };\n","numLines":364,"startLine":1,"totalLines":364}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_10559756cd8a49ef86b1f514","type":"tool_result","content":"1\t// MapScreen.js — Path-style level selection map with star display and lock states (50 levels)\n2\t\n3\tclass MapScreen {\n4\t  constructor(dataManager) {\n5\t    this.dm = dataManager;\n6\t    this.nodeSize = 44;\n7\t    this.animTime = 0;\n8\t    this.page = 0;\n9\t    this.totalLevels = 50;\n10\t    this.perPage = 20;\n11\t  }\n12\t\n13\t  _totalPages() { return Math.ceil(this.totalLevels / this.perPage); }\n14\t\n15\t  getNodePositions(screenW) {\n16\t    const positions = [];\n17\t    const levelsOnPage = Math.min(this.perPage, this.totalLevels - this.page * this.perPage);\n18\t    const cols = 5;\n19\t    const rows = Math.ceil(levelsOnPage / cols);\n20\t    const hSpacing = Math.min((screenW - 80) / (cols - 1), 80);\n21\t    const vSpacing = 110;\n22\t    const startX = (screenW - hSpacing * (cols - 1)) / 2;\n23\t    const startY = 130;\n24\t\n25\t    for (let r = 0; r < rows; r++) {\n26\t      const colsInRow = Math.min(cols, levelsOnPage - r * cols);\n27\t      for (let c = 0; c < colsInRow; c++) {\n28\t        const levelIdx = this.page * this.perPage + r * cols + c;\n29\t        const actualCol = r % 2 === 0 ? c : (colsInRow - 1 - c);\n30\t        positions.push({\n31\t          level: levelIdx,\n32\t          x: startX + actualCol * hSpacing,\n33\t          y: startY + r * vSpacing,\n34\t        });\n35\t      }\n36\t    }\n37\t    return positions;\n38\t  }\n39\t\n40\t  getThemeColor(levelIdx) {\n41\t    if (levelIdx < 10) return { node: '#FF4D4D', path: '#FFB800', glow: '#FFE0EC' };\n42\t    if (levelIdx < 20) return { node: '#4DA6FF', path: '#4DA6FF', glow: '#B3E5FC' };\n43\t    if (levelIdx < 30) return { node: '#FF9A3C', path: '#FF9A3C', glow: '#FFE0B2' };\n44\t    if (levelIdx < 40) return { node: '#6BCB77', path: '#6BCB77', glow: '#E8F5E9' };\n45\t    return { node: '#B47AEA', path: '#B47AEA', glow: '#D1C4E9' };\n46\t  }\n47\t\n48\t  render(ctx, screenW, screenH) {\n49\t    this.animTime += 1 / 60;\n50\t    const positions = this.getNodePositions(screenW);\n51\t\n52\t    // Background gradient\n53\t    const grad = ctx.createLinearGradient(0, 0, 0, screenH);\n54\t    grad.addColorStop(0, '#FFE8F0');\n55\t    grad.addColorStop(0.4, '#E8F5E9');\n56\t    grad.addColorStop(1, '#E3F2FD');\n57\t    ctx.fillStyle = grad;\n58\t    ctx.fillRect(0, 0, screenW, screenH);\n59\t\n60\t    // Decorative floating elements\n61\t    const decos = ['🍬', '🍭', '🌟', '✨', '🍰'];\n62\t    for (let i = 0; i < 8; i++) {\n63\t      ctx.globalAlpha = 0.1;\n64\t      ctx.font = `${16 + (i % 3) * 6}px sans-serif`;\n65\t      ctx.textAlign = 'center';\n66\t      const dx = (screenW * 0.15 + (i * 97) % (screenW * 0.7));\n67\t      const dy = (50 + (i * 67 + Math.sin(this.animTime * 0.5 + i) * 15) % (screenH * 0.8));\n68\t      ctx.fillText(decos[i % decos.length], dx, dy);\n69\t    }\n70\t    ctx.globalAlpha = 1;\n71\t\n72\t    // Title bar\n73\t    ctx.fillStyle = '#FFB800';\n74\t    this._roundRect(ctx, 10, 8, screenW - 20, 48, 12);\n75\t    ctx.fill();\n76\t    ctx.fillStyle = '#FFF';\n77\t    ctx.font = 'bold 20px sans-serif';\n78\t    ctx.textAlign = 'center';\n79\t    ctx.fillText(`🗺️ 关卡地图 (${this.page + 1}/${this._totalPages()})`, screenW / 2, 40);\n80\t\n81\t    // Coins\n82\t    ctx.textAlign = 'right';\n83\t    ctx.font = 'bold 14px sans-serif';\n84\t    ctx.fillStyle = '#FFF';\n85\t    ctx.fillText(`🪙 ${this.dm.coins}`, screenW - 18, 38);\n86\t\n87\t    // Shop button\n88\t    ctx.fillStyle = '#6BCB77';\n89\t    this._roundRect(ctx, screenW - 82, 62, 65, 28, 14);\n90\t    ctx.fill();\n91\t    ctx.fillStyle = '#FFF';\n92\t    ctx.font = 'bold 12px sans-serif';\n93\t    ctx.textAlign = 'center';\n94\t    ctx.fillText('🏪 商店', screenW - 50, 80);\n95\t\n96\t    // Character button\n97\t    ctx.fillStyle = '#B47AEA';\n98\t    this._roundRect(ctx, 17, 62, 65, 28, 14);\n99\t    ctx.fill();\n100\t    ctx.fillStyle = '#FFF';\n101\t    ctx.fillText('👤 角色', 50, 80);\n102\t\n103\t    // Daily button\n104\t    ctx.fillStyle = '#FF9A3C';\n105\t    this._roundRect(ctx, 17, 95, 65, 28, 14);\n106\t    ctx.fill();\n107\t    ctx.fillStyle = '#FFF';\n108\t    ctx.fillText('📅 每日', 50, 113);\n109\t\n110\t    // Social button\n111\t    ctx.fillStyle = '#4DA6FF';\n112\t    this._roundRect(ctx, screenW - 82, 95, 65, 28, 14);\n113\t    ctx.fill();\n114\t    ctx.fillStyle = '#FFF';\n115\t    ctx.fillText('👥 社交', screenW - 50, 113);\n116\t\n117\t    // Page navigation\n118\t    const totalPages = this._totalPages();\n119\t    if (totalPages > 1) {\n120\t      // Prev page\n121\t      if (this.page > 0) {\n122\t        ctx.fillStyle = '#8D6E63';\n123\t        this._roundRect(ctx, 10, screenH - 55, 60, 28, 14);\n124\t        ctx.fill();\n125\t        ctx.fillStyle = '#FFF';\n126\t        ctx.font = 'bold 12px sans-serif';\n127\t        ctx.fillText('◀ 上页', 40, screenH - 37);\n128\t      }\n129\t      // Next page\n130\t      if (this.page < totalPages - 1) {\n131\t        ctx.fillStyle = '#8D6E63';\n132\t        this._roundRect(ctx, screenW - 70, screenH - 55, 60, 28, 14);\n133\t        ctx.fill();\n134\t        ctx.fillStyle = '#FFF';\n135\t        ctx.fillText('下页 ▶', screenW - 40, screenH - 37);\n136\t      }\n137\t    }\n138\t\n139\t    // Draw connecting paths\n140\t    for (let i = 0; i < positions.length - 1; i++) {\n141\t      const a = positions[i];\n142\t      const b = positions[i + 1];\n143\t      const theme = this.getThemeColor(a.level);\n144\t      ctx.strokeStyle = theme.path + '60';\n145\t      ctx.lineWidth = 4;\n146\t      ctx.setLineDash([8, 4]);\n147\t      ctx.beginPath();\n148\t      ctx.moveTo(a.x, a.y);\n149\t      ctx.lineTo(b.x, b.y);\n150\t      ctx.stroke();\n151\t      ctx.setLineDash([]);\n152\t    }\n153\t\n154\t    // Draw level nodes\n155\t    const unlocked = this.dm.unlockedLevel;\n156\t    for (const pos of positions) {\n157\t      const levelNum = pos.level + 1;\n158\t      const stars = this.dm.getLevelStars(levelNum);\n159\t      const isUnlocked = levelNum <= unlocked;\n160\t      const isCurrent = levelNum === unlocked;\n161\t      const theme = this.getThemeColor(pos.level);\n162\t      const r = this.nodeSize / 2;\n163\t\n164\t      if (isUnlocked) {\n165\t        if (isCurrent) {\n166\t          const glow = 6 + Math.sin(this.animTime * 3) * 4;\n167\t          ctx.shadowColor = theme.node;\n168\t          ctx.shadowBlur = glow;\n169\t        }\n170\t\n171\t        const nodeGrad = ctx.createRadialGradient(pos.x, pos.y - 4, 2, pos.x, pos.y, r);\n172\t        nodeGrad.addColorStop(0, theme.node + 'EE');\n173\t        nodeGrad.addColorStop(1, theme.node);\n174\t        ctx.fillStyle = nodeGrad;\n175\t        ctx.beginPath();\n176\t        ctx.arc(pos.x, pos.y, r, 0, Math.PI * 2);\n177\t        ctx.fill();\n178\t        ctx.shadowBlur = 0;\n179\t\n180\t        ctx.fillStyle = 'rgba(255,255,255,0.25)';\n181\t        ctx.beginPath();\n182\t        ctx.ellipse(pos.x, pos.y - r * 0.25, r * 0.6, r * 0.35, 0, 0, Math.PI * 2);\n183\t        ctx.fill();\n184\t\n185\t        ctx.fillStyle = '#FFF';\n186\t        ctx.font = 'bold 18px sans-serif';\n187\t        ctx.textAlign = 'center';\n188\t        ctx.textBaseline = 'middle';\n189\t        ctx.fillText(levelNum, pos.x, pos.y + 1);\n190\t      } else {\n191\t        ctx.fillStyle = '#D5CFC5';\n192\t        ctx.beginPath();\n193\t        ctx.arc(pos.x, pos.y, r, 0, Math.PI * 2);\n194\t        ctx.fill();\n195\t        ctx.fillStyle = '#B0A898';\n196\t        ctx.font = '16px sans-serif';\n197\t        ctx.textAlign = 'center';\n198\t        ctx.textBaseline = 'middle';\n199\t        ctx.fillText('🔒', pos.x, pos.y);\n200\t      }\n201\t\n202\t      if (stars > 0) {\n203\t        const starY = pos.y + r + 12;\n204\t        ctx.font = '12px sans-serif';\n205\t        ctx.textBaseline = 'alphabetic';\n206\t        for (let s = 0; s < 3; s++) {\n207\t          ctx.fillText(s < stars ? '⭐' : '☆', pos.x - 15 + s * 15, starY);\n208\t        }\n209\t      }\n210\t    }\n211\t\n212\t    // Progress info\n213\t    const completed = Object.keys(this.dm.data.levelStars).length;\n214\t    ctx.fillStyle = '#8D6E63';\n215\t    ctx.font = '12px sans-serif';\n216\t    ctx.textAlign = 'center';\n217\t    ctx.textBaseline = 'alphabetic';\n218\t    ctx.fillText(`已通关 ${completed}/${this.totalLevels} 关`, screenW / 2, screenH - 20);\n219\t  }\n220\t\n221\t  handleClick(x, y, screenW, screenH) {\n222\t    // Shop button\n223\t    if (x >= screenW - 82 && x <= screenW - 17 && y >= 62 && y <= 90) {\n224\t      return { action: 'shop' };\n225\t    }\n226\t\n227\t    // Character button\n228\t    if (x >= 17 && x <= 82 && y >= 62 && y <= 90) {\n229\t      return { action: 'character' };\n230\t    }\n231\t\n232\t    // Daily button\n233\t    if (x >= 17 && x <= 82 && y >= 95 && y <= 123) {\n234\t      return { action: 'daily' };\n235\t    }\n236\t\n237\t    // Social button\n238\t    if (x >= screenW - 82 && x <= screenW - 17 && y >= 95 && y <= 123) {\n239\t      return { action: 'social' };\n240\t    }\n241\t\n242\t    // Page navigation\n243\t    if (this.page > 0 && x >= 10 && x <= 70 && y >= screenH - 55 && y <= screenH - 27) {\n244\t      this.page--;\n245\t      return { action: 'page', page: this.page };\n246\t    }\n247\t    if (this.page < this._totalPages() - 1 && x >= screenW - 70 && x <= screenW - 10 && y >= screenH - 55 && y <= screenH - 27) {\n248\t      this.page++;\n249\t      return { action: 'page', page: this.page };\n250\t    }\n251\t\n252\t    // Level nodes\n253\t    const positions = this.getNodePositions(screenW);\n254\t    const unlocked = this.dm.unlockedLevel;\n255\t    for (const pos of positions) {\n256\t      const dx = x - pos.x;\n257\t      const dy = y - pos.y;\n258\t      const hitR = this.nodeSize / 2 + 8;\n259\t      if (dx * dx + dy * dy <= hitR * hitR) {\n260\t        const levelNum = pos.level + 1;\n261\t        if (levelNum <= unlocked) {\n262\t          return { action: 'play', level: pos.level };\n263\t        }\n264\t        return null;\n265\t      }\n266\t    }\n267\t    return null;\n268\t  }\n269\t\n270\t  _roundRect(ctx, x, y, w, h, r) {\n271\t    ctx.beginPath();\n272\t    ctx.moveTo(x + r, y);\n273\t    ctx.lineTo(x + w - r, y);\n274\t    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n275\t    ctx.lineTo(x + w, y + h - r);\n276\t    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n277\t    ctx.lineTo(x + r, y + h);\n278\t    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n279\t    ctx.lineTo(x, y + r);\n280\t    ctx.quadraticCurveTo(x, y, x + r, y);\n281\t    ctx.closePath();\n282\t  }\n283\t}\n284\t\n285\tif (typeof module !== 'undefined') module.exports = { MapScreen };\n286\t"}]},"parent_tool_use_id":null,"session_id":"7463fb62-2e03-4edd-abad-466ff792dff1","uuid":"8593627b-67c6-4dd6-905a-d2137531495c","timestamp":"2026-05-23T10:38:31.142Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-match3/src/js/MapScreen.js","content":"// MapScreen.js — Path-style level selection map with star display and lock states (50 levels)\n\nclass MapScreen {\n  constructor(dataManager) {\n    this.dm = dataManager;\n    this.nodeSize = 44;\n    this.animTime = 0;\n    this.page = 0;\n    this.totalLevels = 50;\n    this.perPage = 20;\n  }\n\n  _totalPages() { return Math.ceil(this.totalLevels / this.perPage); }\n\n  getNodePositions(screenW) {\n    const positions = [];\n    const levelsOnPage = Math.min(this.perPage, this.totalLevels - this.page * this.perPage);\n    const cols = 5;\n    const rows = Math.ceil(levelsOnPage / cols);\n    const hSpacing = Math.min((screenW - 80) / (cols - 1), 80);\n    const vSpacing = 110;\n    const startX = (screenW - hSpacing * (cols - 1)) / 2;\n    const startY = 130;\n\n    for (let r = 0; r < rows; r++) {\n      const colsInRow = Math.min(cols, levelsOnPage - r * cols);\n      for (let c = 0; c < colsInRow; c++) {\n        const levelIdx = this.page * this.perPage + r * cols + c;\n        const actualCol = r % 2 === 0 ? c : (colsInRow - 1 - c);\n        positions.push({\n          level: levelIdx,\n          x: startX + actualCol * hSpacing,\n          y: startY + r * vSpacing,\n        });\n      }\n    }\n    return positions;\n  }\n\n  getThemeColor(levelIdx) {\n    if (levelIdx < 10) return { node: '#FF4D4D', path: '#FFB800', glow: '#FFE0EC' };\n    if (levelIdx < 20) return { node: '#4DA6FF', path: '#4DA6FF', glow: '#B3E5FC' };\n    if (levelIdx < 30) return { node: '#FF9A3C', path: '#FF9A3C', glow: '#FFE0B2' };\n    if (levelIdx < 40) return { node: '#6BCB77', path: '#6BCB77', glow: '#E8F5E9' };\n    return { node: '#B47AEA', path: '#B47AEA', glow: '#D1C4E9' };\n  }\n\n  render(ctx, screenW, screenH) {\n    this.animTime += 1 / 60;\n    const positions = this.getNodePositions(screenW);\n\n    // Background gradient\n    const grad = ctx.createLinearGradient(0, 0, 0, screenH);\n    grad.addColorStop(0, '#FFE8F0');\n    grad.addColorStop(0.4, '#E8F5E9');\n    grad.addColorStop(1, '#E3F2FD');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, screenW, screenH);\n\n    // Decorative floating elements\n    const decos = ['🍬', '🍭', '🌟', '✨', '🍰'];\n    for (let i = 0; i < 8; i++) {\n      ctx.globalAlpha = 0.1;\n      ctx.font = `${16 + (i % 3) * 6}px sans-serif`;\n      ctx.textAlign = 'center';\n      const dx = (screenW * 0.15 + (i * 97) % (screenW * 0.7));\n      const dy = (50 + (i * 67 + Math.sin(this.animTime * 0.5 + i) * 15) % (screenH * 0.8));\n      ctx.fillText(decos[i % decos.length], dx, dy);\n    }\n    ctx.globalAlpha = 1;\n\n    // Title bar\n    ctx.fillStyle = '#FFB800';\n    this._roundRect(ctx, 10, 8, screenW - 20, 48, 12);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(`🗺️ 关卡地图 (${this.page + 1}/${this._totalPages()})`, screenW / 2, 40);\n\n    // Coins\n    ctx.textAlign = 'right';\n    ctx.font = 'bold 14px sans-serif';\n    ctx.fillStyle = '#FFF';\n    ctx.fillText(`🪙 ${this.dm.coins}`, screenW - 18, 38);\n\n    // Shop button\n    ctx.fillStyle = '#6BCB77';\n    this._roundRect(ctx, screenW - 82, 62, 65, 28, 14);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 12px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('🏪 商店', screenW - 50, 80);\n\n    // Character button\n    ctx.fillStyle = '#B47AEA';\n    this._roundRect(ctx, 17, 62, 65, 28, 14);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.fillText('👤 角色', 50, 80);\n\n    // Daily button\n    ctx.fillStyle = '#FF9A3C';\n    this._roundRect(ctx, 17, 95, 65, 28, 14);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.fillText('📅 每日', 50, 113);\n\n    // Social button\n    ctx.fillStyle = '#4DA6FF';\n    this._roundRect(ctx, screenW - 82, 95, 65, 28, 14);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.fillText('👥 社交', screenW - 50, 113);\n\n    // Page navigation\n    const totalPages = this._totalPages();\n    if (totalPages > 1) {\n      // Prev page\n      if (this.page > 0) {\n        ctx.fillStyle = '#8D6E63';\n        this._roundRect(ctx, 10, screenH - 55, 60, 28, 14);\n        ctx.fill();\n        ctx.fillStyle = '#FFF';\n        ctx.font = 'bold 12px sans-serif';\n        ctx.fillText('◀ 上页', 40, screenH - 37);\n      }\n      // Next page\n      if (this.page < totalPages - 1) {\n        ctx.fillStyle = '#8D6E63';\n        this._roundRect(ctx, screenW - 70, screenH - 55, 60, 28, 14);\n        ctx.fill();\n        ctx.fillStyle = '#FFF';\n        ctx.fillText('下页 ▶', screenW - 40, screenH - 37);\n      }\n    }\n\n    // Draw connecting paths\n    for (let i = 0; i < positions.length - 1; i++) {\n      const a = positions[i];\n      const b = positions[i + 1];\n      const theme = this.getThemeColor(a.level);\n      ctx.strokeStyle = theme.path + '60';\n      ctx.lineWidth = 4;\n      ctx.setLineDash([8, 4]);\n      ctx.beginPath();\n      ctx.moveTo(a.x, a.y);\n      ctx.lineTo(b.x, b.y);\n      ctx.stroke();\n      ctx.setLineDash([]);\n    }\n\n    // Draw level nodes\n    const unlocked = this.dm.unlockedLevel;\n    for (const pos of positions) {\n      const levelNum = pos.level + 1;\n      const stars = this.dm.getLevelStars(levelNum);\n      const isUnlocked = levelNum <= unlocked;\n      const isCurrent = levelNum === unlocked;\n      const theme = this.getThemeColor(pos.level);\n      const r = this.nodeSize / 2;\n\n      if (isUnlocked) {\n        if (isCurrent) {\n          const glow = 6 + Math.sin(this.animTime * 3) * 4;\n          ctx.shadowColor = theme.node;\n          ctx.shadowBlur = glow;\n        }\n\n        const nodeGrad = ctx.createRadialGradient(pos.x, pos.y - 4, 2, pos.x, pos.y, r);\n        nodeGrad.addColorStop(0, theme.node + 'EE');\n        nodeGrad.addColorStop(1, theme.node);\n        ctx.fillStyle = nodeGrad;\n        ctx.beginPath();\n        ctx.arc(pos.x, pos.y, r, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.shadowBlur = 0;\n\n        ctx.fillStyle = 'rgba(255,255,255,0.25)';\n        ctx.beginPath();\n        ctx.ellipse(pos.x, pos.y - r * 0.25, r * 0.6, r * 0.35, 0, 0, Math.PI * 2);\n        ctx.fill();\n\n        ctx.fillStyle = '#FFF';\n        ctx.font = 'bold 18px sans-serif';\n        ctx.textAlign = 'center';\n        ctx.textBaseline = 'middle';\n        ctx.fillText(levelNum, pos.x, pos.y + 1);\n      } else {\n        ctx.fillStyle = '#D5CFC5';\n        ctx.beginPath();\n        ctx.arc(pos.x, pos.y, r, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.fillStyle = '#B0A898';\n        ctx.font = '16px sans-serif';\n        ctx.textAlign = 'center';\n        ctx.textBaseline = 'middle';\n        ctx.fillText('🔒', pos.x, pos.y);\n      }\n\n      if (stars > 0) {\n        const starY = pos.y + r + 12;\n        ctx.font = '12px sans-serif';\n        ctx.textBaseline = 'alphabetic';\n        for (let s = 0; s < 3; s++) {\n          ctx.fillText(s < stars ? '⭐' : '☆', pos.x - 15 + s * 15, starY);\n        }\n      }\n    }\n\n    // Progress info\n    const completed = Object.keys(this.dm.data.levelStars).length;\n    ctx.fillStyle = '#8D6E63';\n    ctx.font = '12px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'alphabetic';\n    ctx.fillText(`已通关 ${completed}/${this.totalLevels} 关`, screenW / 2, screenH - 20);\n  }\n\n  handleClick(x, y, screenW, screenH) {\n    // Shop button\n    if (x >= screenW - 82 && x <= screenW - 17 && y >= 62 && y <= 90) {\n      return { action: 'shop' };\n    }\n\n    // Character button\n    if (x >= 17 && x <= 82 && y >= 62 && y <= 90) {\n      return { action: 'character' };\n    }\n\n    // Daily button\n    if (x >= 17 && x <= 82 && y >= 95 && y <= 123) {\n      return { action: 'daily' };\n    }\n\n    // Social button\n    if (x >= screenW - 82 && x <= screenW - 17 && y >= 95 && y <= 123) {\n      return { action: 'social' };\n    }\n\n    // Page navigation\n    if (this.page > 0 && x >= 10 && x <= 70 && y >= screenH - 55 && y <= screenH - 27) {\n      this.page--;\n      return { action: 'page', page: this.page };\n    }\n    if (this.page < this._totalPages() - 1 && x >= screenW - 70 && x <= screenW - 10 && y >= screenH - 55 && y <= screenH - 27) {\n      this.page++;\n      return { action: 'page', page: this.page };\n    }\n\n    // Level nodes\n    const positions = this.getNodePositions(screenW);\n    const unlocked = this.dm.unlockedLevel;\n    for (const pos of positions) {\n      const dx = x - pos.x;\n      const dy = y - pos.y;\n      const hitR = this.nodeSize / 2 + 8;\n      if (dx * dx + dy * dy <= hitR * hitR) {\n        const levelNum = pos.level + 1;\n        if (levelNum <= unlocked) {\n          return { action: 'play', level: pos.level };\n        }\n        return null;\n      }\n    }\n    return null;\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { MapScreen };\n","numLines":286,"startLine":1,"totalLines":286}}}
