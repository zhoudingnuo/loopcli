/AdManager.js\"></script>\n52\t  <script src=\"src/js/Analytics.js\"></script>\n53\t\n54\t  <script src=\"src/js/Navigation.js\"></script>\n55\t\n56\t  <!-- Main game -->\n57\t  <script src=\"src/js/Game.js\"></script>\n58\t\n59\t  <script>\n60\t    const canvas = document.getElementById('gameCanvas');\n61\t    const game = new Game(canvas);\n62\t\n63\t    // Handle resize\n64\t    function onResize() {\n65\t      game.renderer.resize();\n66\t      game.input.updateLayout(\n67\t        game.renderer.tileSize,\n68\t        game.renderer.boardX,\n69\t        game.renderer.boardY,\n70\t      );\n71\t    }\n72\t\n73\t    window.addEventListener('resize', onResize);\n74\t    window.addEventListener('orientationchange', () => setTimeout(onResize, 100));\n75\t\n76\t    // Unified click handler — routes through Navigation\n77\t    canvas.addEventListener('click', (e) => {\n78\t      const rect = canvas.getBoundingClientRect();\n79\t      const x = e.clientX - rect.left;\n80\t      const y = e.clientY - rect.top;\n81\t      const w = game.renderer.screenW;\n82\t      const h = game.renderer.screenH;\n83\t\n84\t      // Phase 4: ad stub overlay consumes clicks first\n85\t      if (game.adManager.handleStubClick(x, y, w, h)) return;\n86\t\n87\t      // Navigation screens\n88\t      if (game.nav.isActive()) {\n89\t        game.nav.handleClick(x, y, w, h);\n90\t        return;\n91\t      }\n92\t\n93\t      // In-game: check back-to-map button\n94\t      const backX = w - 50;\n95\t      const backY = game.renderer.boardY + game.renderer.tileSize * BOARD_SIZE + 25;\n96\t      if (x >= backX && x <= backX + 40 && y >= backY && y <= backY + 28) {\n97\t        game.nav.goTo('map');\n98\t        return;\n99\t      }\n100\t    });\n101\t\n102\t    // Start the game (shows main menu)\n103\t    game.start();\n104\t  </script>\n105\t</body>\n106\t</html>\n107\t"}]},"parent_tool_use_id":null,"session_id":"ec73960d-df44-45f4-a48b-a11bb93a968e","uuid":"13ec5241-042c-4b18-bbbd-b52415656df2","timestamp":"2026-05-22T22:42:56.912Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\douyin-match3\\index.html","content":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no, maximum-scale=1.0\">\n  <title>消消消大作战 - Match & Blast</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    html, body {\n      width: 100%; height: 100%;\n      overflow: hidden;\n      background: #FFF8E7;\n      touch-action: none;\n      -webkit-user-select: none;\n      user-select: none;\n    }\n    canvas {\n      display: block;\n      width: 100%;\n      height: 100%;\n    }\n  </style>\n</head>\n<body>\n  <canvas id=\"gameCanvas\"></canvas>\n\n  <!-- Phase 1+2: Core modules -->\n  <script src=\"src/js/Board.js\"></script>\n  <script src=\"src/js/MatchEngine.js\"></script>\n  <script src=\"src/js/Animation.js\"></script>\n  <script src=\"src/js/Obstacle.js\"></script>\n  <script src=\"src/js/AudioManager.js\"></script>\n  <script src=\"src/js/Boss.js\"></script>\n  <script src=\"src/js/levels.js\"></script>\n  <script src=\"src/js/Renderer.js\"></script>\n  <script src=\"src/js/InputHandler.js\"></script>\n  <script src=\"src/js/ScoreSystem.js\"></script>\n\n  <!-- Phase 3a: Meta-progression modules -->\n  <script src=\"src/js/DataManager.js\"></script>\n  <script src=\"src/js/CoinSystem.js\"></script>\n  <script src=\"src/js/Characters.js\"></script>\n  <script src=\"src/js/MapScreen.js\"></script>\n  <script src=\"src/js/ShopUI.js\"></script>\n\n  <!-- Phase 3b: Daily + Social -->\n  <script src=\"src/js/DailySystem.js\"></script>\n  <script src=\"src/js/SocialSystem.js\"></script>\n\n  <!-- Phase 4: Ads + Analytics -->\n  <script src=\"src/js/AdManager.js\"></script>\n  <script src=\"src/js/Analytics.js\"></script>\n\n  <script src=\"src/js/Navigation.js\"></script>\n\n  <!-- Main game -->\n  <script src=\"src/js/Game.js\"></script>\n\n  <script>\n    const canvas = document.getElementById('gameCanvas');\n    const game = new Game(canvas);\n\n    // Handle resize\n    function onResize() {\n      game.renderer.resize();\n      game.input.updateLayout(\n        game.renderer.tileSize,\n        game.renderer.boardX,\n        game.renderer.boardY,\n      );\n    }\n\n    window.addEventListener('resize', onResize);\n    window.addEventListener('orientationchange', () => setTimeout(onResize, 100));\n\n    // Unified click handler — routes through Navigation\n    canvas.addEventListener('click', (e) => {\n      const rect = canvas.getBoundingClientRect();\n      const x = e.clientX - rect.left;\n      const y = e.clientY - rect.top;\n      const w = game.renderer.screenW;\n      const h = game.renderer.screenH;\n\n      // Phase 4: ad stub overlay consumes clicks first\n      if (game.adManager.handleStubClick(x, y, w, h)) return;\n\n      // Navigation screens\n      if (game.nav.isActive()) {\n        game.nav.handleClick(x, y, w, h);\n        return;\n      }\n\n      // In-game: check back-to-map button\n      const backX = w - 50;\n      const backY = game.renderer.boardY + game.renderer.tileSize * BOARD_SIZE + 25;\n      if (x >= backX && x <= backX + 40 && y >= backY && y <= backY + 28) {\n        game.nav.goTo('map');\n        return;\n      }\n    });\n\n    // Start the game (shows main menu)\n    game.start();\n  </script>\n</body>\n</html>\n","numLines":107,"startLine":1,"totalLines":107}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_0f1885af3af9400b9810c3df","type":"tool_result","content":"1\t// InputHandler.js — Touch and mouse input handling for swipe detection\n2\t\n3\tclass InputHandler {\n4\t  constructor(canvas, board) {\n5\t    this.canvas = canvas;\n6\t    this.board = board;\n7\t    this.tileSize = 0;\n8\t    this.boardX = 0;\n9\t    this.boardY = 0;\n10\t\n11\t    this.swipeStart = null;\n12\t    this.selectedTile = null;\n13\t    this.onSwap = null;         // (r1, c1, r2, c2) => void\n14\t    this.onTap = null;          // (row, col) => void\n15\t    this.enabled = true;\n16\t\n17\t    this._bindEvents();\n18\t  }\n19\t\n20\t  updateLayout(tileSize, boardX, boardY) {\n21\t    this.tileSize = tileSize;\n22\t    this.boardX = boardX;\n23\t    this.boardY = boardY;\n24\t  }\n25\t\n26\t  _bindEvents() {\n27\t    // Mouse events\n28\t    this.canvas.addEventListener('mousedown', e => this._onPointerDown(e.clientX, e.clientY));\n29\t    this.canvas.addEventListener('mousemove', e => this._onPointerMove(e.clientX, e.clientY));\n30\t    this.canvas.addEventListener('mouseup', e => this._onPointerUp(e.clientX, e.clientY));\n31\t\n32\t    // Touch events\n33\t    this.canvas.addEventListener('touchstart', e => {\n34\t      e.preventDefault();\n35\t      const t = e.touches[0];\n36\t      this._onPointerDown(t.clientX, t.clientY);\n37\t    }, { passive: false });\n38\t\n39\t    this.canvas.addEventListener('touchmove', e => {\n40\t      e.preventDefault();\n41\t      const t = e.touches[0];\n42\t      this._onPointerMove(t.clientX, t.clientY);\n43\t    }, { passive: false });\n44\t\n45\t    this.canvas.addEventListener('touchend', e => {\n46\t      e.preventDefault();\n47\t      const t = e.changedTouches[0];\n48\t      this._onPointerUp(t.clientX, t.clientY);\n49\t    }, { passive: false });\n50\t  }\n51\t\n52\t  _screenToGrid(x, y) {\n53\t    const col = Math.floor((x - this.boardX) / this.tileSize);\n54\t    const row = Math.floor((y - this.boardY) / this.tileSize);\n55\t    if (row >= 0 && row < this.board.size && col >= 0 && col < this.board.size) {\n56\t      return { row, col };\n57\t    }\n58\t    return null;\n59\t  }\n60\t\n61\t  _onPointerDown(x, y) {\n62\t    if (!this.enabled) return;\n63\t    const cell = this._screenToGrid(x, y);\n64\t    if (!cell) return;\n65\t    this.swipeStart = { x, y, row: cell.row, col: cell.col };\n66\t  }\n67\t\n68\t  _onPointerMove(x, y) {\n69\t    // Could use for drag visualization\n70\t  }\n71\t\n72\t  _onPointerUp(x, y) {\n73\t    if (!this.enabled || !this.swipeStart) return;\n74\t    const start = this.swipeStart;\n75\t    this.swipeStart = null;\n76\t\n77\t    const dx = x - start.x;\n78\t    const dy = y - start.y;\n79\t    const dist = Math.sqrt(dx * dx + dy * dy);\n80\t\n81\t    // Minimum swipe distance threshold\n82\t    if (dist < this.tileSize * 0.2) {\n83\t      // Tap — treat as selection or swap trigger\n84\t      if (this.onTap) this.onTap(start.row, start.col);\n85\t      return;\n86\t    }\n87\t\n88\t    // Determine swipe direction\n89\t    let targetRow = start.row;\n90\t    let targetCol = start.col;\n91\t    if (Math.abs(dx) > Math.abs(dy)) {\n92\t      targetCol += dx > 0 ? 1 : -1;\n93\t    } else {\n94\t      targetRow += dy > 0 ? 1 : -1;\n95\t    }\n96\t\n97\t    // Validate\n98\t    if (this.board.isValid(targetRow, targetCol)) {\n99\t      if (this.onSwap) {\n100\t        this.onSwap(start.row, start.col, targetRow, targetCol);\n101\t      }\n102\t    }\n103\t  }\n104\t}\n105\t\n106\tif (typeof module !== 'undefined') module.exports = { InputHandler };\n107\t"}]},"parent_tool_use_id":null,"session_id":"ec73960d-df44-45f4-a48b-a11bb93a968e","uuid":"a64b4e95-4813-467e-bdd8-23b9a093612a","timestamp":"2026-05-22T22:42:56.914Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\douyin-match3\\src\\js\\InputHandler.js","content":"// InputHandler.js — Touch and mouse input handling for swipe detection\n\nclass InputHandler {\n  constructor(canvas, board) {\n    this.canvas = canvas;\n    this.board = board;\n    this.tileSize = 0;\n    this.boardX = 0;\n    this.boardY = 0;\n\n    this.swipeStart = null;\n    this.selectedTile = null;\n    this.onSwap = null;         // (r1, c1, r2, c2) => void\n    this.onTap = null;          // (row, col) => void\n    this.enabled = true;\n\n    this._bindEvents();\n  }\n\n  updateLayout(tileSize, boardX, boardY) {\n    this.tileSize = tileSize;\n    this.boardX = boardX;\n    this.boardY = boardY;\n  }\n\n  _bindEvents() {\n    // Mouse events\n    this.canvas.addEventListener('mousedown', e => this._onPointerDown(e.clientX, e.clientY));\n    this.canvas.addEventListener('mousemove', e => this._onPointerMove(e.clientX, e.clientY));\n    this.canvas.addEventListener('mouseup', e => this._onPointerUp(e.clientX, e.clientY));\n\n    // Touch events\n    this.canvas.addEventListener('touchstart', e => {\n      e.preventDefault();\n      const t = e.touches[0];\n      this._onPointerDown(t.clientX, t.clientY);\n    }, { passive: false });\n\n    this.canvas.addEventListener('touchmove', e => {\n      e.preventDefault();\n      const t = e.touches[0];\n      this._onPointerMove(t.clientX, t.clientY);\n    }, { passive: false });\n\n    this.canvas.addEventListener('touchend', e => {\n      e.preventDefault();\n      const t = e.changedTouches[0];\n      this._onPointerUp(t.clientX, t.clientY);\n    }, { passive: false });\n  }\n\n  _screenToGrid(x, y) {\n    const col = Math.floor((x - this.boardX) / this.tileSize);\n    const row = Math.floor((y - this.boardY) / this.tileSize);\n    if (row >= 0 && row < this.board.size && col >= 0 && col < this.board.size) {\n      return { row, col };\n    }\n    return null;\n  }\n\n  _onPointerDown(x, y) {\n    if (!this.enabled) return;\n    const cell = this._screenToGrid(x, y);\n    if (!cell) return;\n    this.swipeStart = { x, y, row: cell.row, col: cell.col };\n  }\n\n  _onPointerMove(x, y) {\n    // Could use for drag visualization\n  }\n\n  _onPointerUp(x, y) {\n    if (!this.enabled || !this.swipeStart) return;\n    const start = this.swipeStart;\n    this.swipeStart = null;\n\n    const dx = x - start.x;\n    const dy = y - start.y;\n    const dist = Math.sqrt(dx * dx + dy * dy);\n\n    // Minimum swipe distance threshold\n    if (dist < this.tileSize * 0.2) {\n      // Tap — treat as selection or swap trigger\n      if (this.onTap) this.onTap(start.row, start.col);\n      return;\n    }\n\n    // Determine swipe direction\n    let targetRow = start.row;\n    let targetCol = start.col;\n    if (Math.abs(dx) > Math.abs(dy)) {\n      targetCol += dx > 0 ? 1 : -1;\n    } else {\n      targetRow += dy > 0 ? 1 : -1;\n    }\n\n    // Validate\n    if (this.board.isValid(targetRow, targetCol)) {\n      if (this.onSwap) {\n        this.onSwap(start.row, start.col, targetRow, targetCol);\n      }\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { InputHandler };\n","numLines":107,"startLine":1,"totalLines":107}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ae671a1c75914b14b0a6810d","type":"tool_result","content":"1\t// Game.js — Main game loop, state machine, integrates all Phase 2+3a systems\n2\t\n3\tconst STATES = {\n4\t  MENU: 'menu',\n5\t  IDLE: 'idle',\n6\t  SWAPPING: 'swapping',\n7\t  MATCHING: 'matching',\n8\t  REMOVING: 'removing',\n9\t  DROPPING: 'dropping',\n10\t  RESULT: 'result',\n11\t  BOSS_SKILL: 'boss_skill',\n12\t};\n13\t\n14\tclass Game {\n15\t  constructor(canvas) {\n16\t    this.canvas = canvas;\n17\t    this.board = new Board();\n18\t    this.matchEngine = new MatchEngine(this.board);\n19\t    this.renderer = new Renderer(canvas);\n20\t    this.input = new InputHandler(canvas, this.board);\n21\t    this.scoreSystem = new ScoreSystem();\n22\t    this.tweens = new TweenManager();\n23\t    this.particles = new ParticleSystem();\n24\t    this.obstacleMgr = new ObstacleManager(this.board);\n25\t    this.audio = new AudioManager();\n26\t    this.boss = null;\n27\t    this.levels = LEVELS;\n28\t    this.currentLevel = 0;\n29\t    this.state = STATES.IDLE;\n30\t    this.comboText = '';\n31\t    this.comboTimer = 0;\n32\t    this.lastTime = 0;\n33\t    this.resultData = null;\n34\t    this.moveCount = 0;\n35\t\n36\t    // Phase 3a: meta-progression systems\n37\t    this.dataManager = new DataManager();\n38\t    this.coinSystem = new CoinSystem(this.dataManager);\n39\t    this.characterMgr = new CharacterManager();\n40\t    this.mapScreen = new MapScreen(this.dataManager);\n41\t    this.shopUI = new ShopUI(this.coinSystem, this.dataManager);\n42\t    this.nav = new Navigation(this);\n43\t\n44\t    // Phase 3b: daily + social\n45\t    this.dailySystem = new DailySystem(this.dataManager, this.coinSystem);\n46\t    this.socialSystem = new SocialSystem(this.dataManager);\n47\t    this.dailySystem.checkNewDay();\n48\t\n49\t    // Phase 4: ads + analytics\n50\t    this.adManager = new AdManager(this.dataManager);\n51\t    this.analytics = new Analytics(this.dataManager);\n52\t    this.analytics.trackGameStart();\n53\t\n54\t    this.renderer.particleSystem = this.particles;\n55\t\n56\t    this._setupInput();\n57\t    this._setupScoreCallbacks();\n58\t    this._setupObstacleCallbacks();\n59\t  }\n60\t\n61\t  _setupInput() {\n62\t    this.input.onSwap = (r1, c1, r2, c2) => this._handleSwap(r1, c1, r2, c2);\n63\t    this.input.onTap = (row, col) => this._handleTap(row, col);\n64\t  }\n65\t\n66\t  _setupScoreCallbacks() {\n67\t    this.scoreSystem.onLevelComplete = (score, stars) => {\n68\t      this.nav.showResult(true, score, stars, this.currentLevel + 1);\n69\t      this.audio.playLevelWin();\n70\t      // Phase 3b: daily task tracking\n71\t      this.dailySystem.reportEvent('complete_levels', 1);\n72\t      if (stars === 3) this.dailySystem.reportEvent('star3', 1);\n73\t      if (score >= 2000) this.dailySystem.reportEvent('score', score);\n74\t      // Phase 4: analytics + ad success tracking\n75\t      this.analytics.trackLevelComplete(this.currentLevel + 1, score, stars, this.moveCount);\n76\t      this.adManager.reportSuccess();\n77\t    };\n78\t    this.scoreSystem.onLevelFail = (score) => {\n79\t      this.nav.showResult(false, score, 0, this.currentLevel + 1);\n80\t      this.audio.playLevelFail();\n81\t      // Phase 4: analytics + ad fail tracking\n82\t      this.analytics.trackLevelFail(this.currentLevel + 1, score, this.moveCount, this.scoreSystem.getGoalProgress());\n83\t      this.adManager.reportFail();\n84\t    };\n85\t  }\n86\t\n87\t  _setupObstacleCallbacks() {\n88\t    this.obstacleMgr.onObstacleDestroyed = (obs) => {\n89\t      this.scoreSystem.addObstacleCleared(obs.type);\n90\t      this.audio.playObstacleBreak();\n91\t      // Phase 3b: daily obstacle tracking\n92\t      this.dailySystem.reportEvent('clear_obstacle', obs.type);\n93\t      const pos = this.renderer.getTileCenter(obs.row, obs.col);\n94\t      this.particles.emitExplosion(pos.x, pos.y, this._obstacleColor(obs.type), 12);\n95\t    };\n96\t  }\n97\t\n98\t  _obstacleColor(type) {\n99\t    switch (type) {\n100\t      case OBSTACLE_ICE: return '#88CCFF';\n101\t      case OBSTACLE_CHAIN: return '#AAAAAA';\n102\t      case OBSTACLE_CHOCOLATE: return '#8B4513';\n103\t      default: return '#FFFFFF';\n104\t    }\n105\t  }\n106\t\n107\t  start() {\n108\t    this.lastTime = performance.now();\n109\t    this._loop();\n110\t  }\n111\t\n112\t  _loadLevel(idx) {\n113\t    this.currentLevel = idx;\n114\t    const config = this.levels[idx] || this.levels[0];\n115\t    this.board.init();\n116\t    this.scoreSystem.reset(idx + 1);\n117\t    this.scoreSystem.configure(config);\n118\t    this.tweens.clear();\n119\t    this.particles.particles = [];\n120\t    this.renderer.floatingTexts = [];\n121\t    this.comboText = '';\n122\t    this.resultData = null;\n123\t    this.moveCount = 0;\n124\t\n125\t    // Phase 4: analytics\n126\t    this.analytics.trackLevelStart(idx + 1, config);\n127\t\n128\t    this.obstacleMgr.loadFromConfig(config.obstacles);\n129\t\n130\t    for (const obs of this.obstacleMgr.obstacles) {\n131\t      if (obs.type === OBSTACLE_CHOCOLATE) {\n132\t        this.board.clearCell(obs.row, obs.col);\n133\t      }\n134\t    }\n135\t\n136\t    this.boss = null;\n137\t    if (config.boss) {\n138\t      this.boss = new Boss(config.boss);\n139\t      this.board.clearCell(this.boss.row, this.boss.col);\n140\t    }\n141\t\n142\t    this.board.applyGravity();\n143\t    this.board._removeInitialMatches();\n144\t\n145\t    this.input.updateLayout(\n146\t      this.renderer.tileSize,\n147\t      this.renderer.boardX,\n148\t      this.renderer.boardY,\n149\t    );\n150\t  }\n151\t\n152\t  _handleTap(row, col) {\n153\t    if (this.state !== STATES.IDLE) return;\n154\t    const tile = this.board.getTile(row, col);\n155\t    if (!tile) return;\n156\t\n157\t    this.audio.init();\n158\t\n159\t    if (tile.special === SPECIAL_RAINBOW) return;\n160\t  }\n161\t\n162\t  _handleSwap(r1, c1, r2, c2) {\n163\t    if (this.state !== STATES.IDLE) return;\n164\t\n165\t    this.audio.init();\n166\t\n167\t    const tileA = this.board.getTile(r1, c1);\n168\t    const tileB = this.board.getTile(r2, c2);\n169\t\n170\t    if (!this.obstacleMgr.canSwap(r1, c1) || !this.obstacleMgr.canSwap(r2, c2)) {\n171\t      this.audio.playInvalid();\n172\t      return;\n173\t    }\n174\t\n175\t    if (tileA && tileA.special === SPECIAL_RAINBOW) {\n176\t      this._activateRainbow(r1, c1, tileB ? tileB.color : 0, r2, c2);\n177\t      return;\n178\t    }\n179\t    if (tileB && tileB.special === SPECIAL_RAINBOW) {\n180\t      this._activateRainbow(r2, c2, tileA ? tileA.color : 0, r1, c1);\n181\t      return;\n182\t    }\n183\t\n184\t    if (!this.matchEngine.isValidSwap(r1, c1, r2, c2)) {\n185\t      this.audio.playInvalid();\n186\t      return;\n187\t    }\n188\t    if (!this.scoreSystem.useMove()) return;\n189\t\n190\t    this.audio.playSwap();\n191\t    this.moveCount++;\n192\t    this.state = STATES.SWAPPING;\n193\t    this.board.swap(r1, c1, r2, c2);\n194\t\n195\t    this._animateSwap(r1, c1, r2, c2, () => {\n196\t      this._processMatches();\n197\t    });\n198\t  }\n199\t\n200\t  _animateSwap(r1, c1, r2, c2, callback) {\n201\t    const tileSize = this.renderer.tileSize;\n202\t    const tileA = this.board.getTile(r2, c2);\n203\t    const tileB = this.board.getTile(r1, c1);\n204\t    const dx = (c2 - c1) * tileSize;\n205\t    const dy = (r2 - r1) * tileSize;\n206\t\n207\t    if (tileA) {\n208\t      tileA.offsetX = -dx;\n209\t      tileA.offsetY = -dy;\n210\t      this.tweens.add(tileA, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n211\t    }\n212\t    if (tileB) {\n213\t      tileB.offsetX = dx;\n214\t      tileB.offsetY = dy;\n215\t      this.tweens.add(tileB, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n216\t    }\n217\t    setTimeout(callback, 160);\n218\t  }\n219\t\n220\t  _activateRainbow(rainbowRow, rainbowCol, targetColor, otherRow, otherCol) {\n221\t    if (!this.scoreSystem.useMove()) return;\n222\t    this.moveCount++;\n223\t    this.audio.playSpecial();\n224\t    this.state = STATES.MATCHING;\n225\t\n226\t    const toRemove = this.matchEngine.triggerRainbow(rainbowRow, rainbowCol, targetColor);\n227\t    toRemove.push({ row: rainbowRow, col: rainbowCol });\n228\t    if (this.board.getTile(otherRow, otherCol)) {\n229\t      toRemove.push({ row: otherRow, col: otherCol });\n230\t    }\n231\t\n232\t    this._removeAndCascade(toRemove, 10);\n233\t  }\n234\t\n235\t  _processMatches() {\n236\t    this.state = STATES.MATCHING;\n237\t    const matches = this.board.findAllMatches();\n238\t\n239\t    if (matches.length === 0) {\n240\t      this._afterMoveComplete();\n241\t      return;\n242\t    }\n243\t\n244\t    this._processChain(0);\n245\t  }\n246\t\n247\t  _processChain(chainCount) {\n248\t    chainCount++;\n249\t    const matches = this.board.findAllMatches();\n250\t    if (matches.length === 0) {\n251\t      this._afterMoveComplete();\n252\t      return;\n253\t    }\n254\t\n255\t    const lShapes = this.board.findLShapeMatches(matches);\n256\t    const { removeCells, specials } = this.matchEngine._classifyMatches(matches, lShapes);\n257\t\n258\t    const multiplier = chainCount <= 1 ? 1 : chainCount === 2 ? 1.5 : chainCount === 3 ? 2.0 : 2.5;\n259\t    const baseScore = removeCells.size * 10;\n260\t    const points = Math.floor(baseScore * multiplier);\n261\t    this.scoreSystem.addScore(points);\n262\t\n263\t    // Phase 3a: character skill — chain bonus\n264\t    this.characterMgr.applySkill(\n265\t      this.dataManager.selectedCharacter,\n266\t      this, 'chain_score', { chainCount },\n267\t    );\n268\t\n269\t    if (chainCount >= 4) this.comboText = '超赞！！';\n270\t    else if (chainCount === 3) this.comboText = '太棒了！';\n271\t    else if (chainCount === 2) this.comboText = '不错！';\n272\t    this.comboTimer = 0.8;\n273\t\n274\t    // Phase 3b: daily chain tracking\n275\t    this.dailySystem.reportEvent('chain', 1);\n276\t\n277\t    this.audio.playMatch(chainCount);\n278\t    if (chainCount >= 2) this.audio.playCombo(chainCount);\n279\t\n280\t    // Collect matched positions\n281\t    const matchedPositions = [];\n282\t    for (const key of removeCells) {\n283\t      const [r, c] = key.split(',').map(Number);\n284\t      const tile = this.board.getTile(r, c);\n285\t      if (tile && tile.color >= 0) {\n286\t        this.scoreSystem.addCollected(tile.color, 1);\n287\t      }\n288\t      matchedPositions.push({ row: r, col: c });\n289\t    }\n290\t\n291\t    // Phase 3a: character skill — lucky special\n292\t    const matchCells = [];\n293\t    for (const key of removeCells) {\n294\t      const [r, c] = key.split(',').map(Number);\n295\t      matchCells.push({ row: r, col: c });\n296\t    }\n297\t    this.characterMgr.applySkill(\n298\t      this.dataManager.selectedCharacter,\n299\t      this, 'match_created', { cells: matchCells },\n300\t    );\n301\t\n302\t    // Create specials\n303\t    const specialPositions = new Set(specials.map(s => `${s.row},${s.col}`));\n304\t    for (const sp of specials) {\n305\t      const tile = this.board.getTile(sp.row, sp.col);\n306\t      if (tile) {\n307\t        tile.special = sp.type;\n308\t        tile.removing = false;\n309\t      }\n310\t    }\n311\t\n312\t    // Animate removal\n313\t    this.state = STATES.REMOVING;\n314\t    const toAnimate = [];\n315\t    for (const key of removeCells) {\n316\t      if (specialPositions.has(key)) continue;\n317\t      const [r, c] = key.split(',').map(Number);\n318\t      const tile = this.board.getTile(r, c);\n319\t      if (tile) {\n320\t        const pos = this.renderer.getTileCenter(r, c);\n321\t        const color = COLOR_MAP[tile.color];\n322\t        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 8);\n323\t        this.renderer.addFloatingText(`+${points}`, pos.x, pos.y);\n324\t        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n325\t        toAnimate.push(tile);\n326\t      }\n327\t    }\n328\t\n329\t    setTimeout(() => {\n330\t      for (const key of removeCells) {\n331\t        if (specialPositions.has(key)) continue;\n332\t        const [r, c] = key.split(',').map(Number);\n333\t        this.board.clearCell(r, c);\n334\t      }\n335\t\n336\t      for (const sp of specials) {\n337\t        this._triggerSpecialEffects(sp.row, sp.col, sp.type);\n338\t      }\n339\t\n340\t      this.obstacleMgr.onTilesMatched(matchedPositions);\n341\t\n342\t      if (this.boss && this.boss.active) {\n343\t        const dmg = this.boss.calculateDamage(matchedPositions);\n344\t        if (dmg > 0) {\n345\t          const defeated = this.boss.takeDamage(dmg);\n346\t          this.audio.playBossHit();\n347\t          if (defeated) {\n348\t            this.audio.playBossDefeat();\n349\t            this.scoreSystem.addScore(500);\n350\t          }\n351\t        }\n352\t      }\n353\t\n354\t      this.state = STATES.DROPPING;\n355\t      const drops = this.board.applyGravity();\n356\t\n357\t      for (const drop of drops) {\n358\t        const tile = drop.tile;\n359\t        const fromY = drop.fromRow * this.renderer.tileSize;\n360\t        const toY = drop.toRow * this.renderer.tileSize;\n361\t        tile.offsetY = fromY - toY;\n362\t        this.tweens.add(tile, { offsetY: 0 }, 0.2 + drop.distance * 0.03, 'easeOutBounce');\n363\t      }\n364\t\n365\t      setTimeout(() => {\n366\t        this._processChain(chainCount);\n367\t      }, 350);\n368\t    }, 280);\n369\t  }\n370\t\n371\t  _afterMoveComplete() {\n372\t    if (this.boss && this.boss.isDefeated() && this.scoreSystem.goalType === 'boss') {\n373\t      this.nav.showResult(true, this.scoreSystem.score, this.scoreSystem.getStarCount(), this.currentLevel + 1);\n374\t      this.audio.playLevelWin();\n375\t      return;\n376\t    }\n377\t\n378\t    this.obstacleMgr.spreadChocolate();\n379\t\n380\t    // Phase 3a: character skill — auto obstacle clear\n381\t    this.characterMgr.applySkill(\n382\t      this.dataManager.selectedCharacter,\n383\t      this, 'after_move', null,\n384\t    );\n385\t\n386\t    if (this.boss && this.boss.active) {\n387\t      const ability = this.boss.tryUseAbility();\n388\t      if (ability) {\n389\t        this._executeBossAbility(ability);\n390\t      }\n391\t    }\n392\t\n393\t    this.state = STATES.IDLE;\n394\t\n395\t    if (!this.board.hasValidMoves(this.obstacleMgr)) {\n396\t      this.board.shuffle();\n397\t    }\n398\t\n399\t    this.scoreSystem.checkState();\n400\t  }\n401\t\n402\t  _executeBossAbility(ability) {\n403\t    this.audio.playBossAbility();\n404\t\n405\t    switch (ability) {\n406\t      case 'freeze': {\n407\t        const candidates = [];\n408\t        for (let r = 0; r < this.board.size; r++) {\n409\t          for (let c = 0; c < this.board.size; c++) {\n410\t            if (!this.obstacleMgr.hasObstacle(r, c) && this.board.getTile(r, c)) {\n411\t              if (this.boss && r === this.boss.row && c === this.boss.col) continue;\n412\t              candidates.push({ row: r, col: c });\n413\t            }\n414\t          }\n415\t        }\n416\t        const count = Math.min(2, candidates.length);\n417\t        for (let i = 0; i < count; i++) {\n418\t          const idx = Math.floor(Math.random() * candidates.length);\n419\t          const target = candidates.splice(idx, 1)[0];\n420\t          this.obstacleMgr.addObstacle(OBSTACLE_ICE, target.row, target.col);\n421\t        }\n422\t        break;\n423\t      }\n424\t      case 'chain': {\n425\t        const candidates = [];\n426\t        for (let r = 0; r < this.board.size; r++) {\n427\t          for (let c = 0; c < this.board.size; c++) {\n428\t            if (!this.obstacleMgr.hasObstacle(r, c) && this.board.getTile(r, c)) {\n429\t              if (this.boss && r === this.boss.row && c === this.boss.col) continue;\n430\t              candidates.push({ row: r, col: c });\n431\t            }\n432\t          }\n433\t        }\n434\t        if (candidates.length > 0) {\n435\t          const idx = Math.floor(Math.random() * candidates.length);\n436\t          const target = candidates[idx];\n437\t          this.obstacleMgr.addObstacle(OBSTACLE_CHAIN, target.row, target.col);\n438\t        }\n439\t        break;\n440\t      }\n441\t      case 'chocolate': {\n442\t        const dirs = [[-1,0],[1,0],[0,-1],[0,1]];\n443\t        const candidates = [];\n444\t        for (const [dr, dc] of dirs) {\n445\t          const nr = this.boss.row + dr;\n446\t          const nc = this.boss.col + dc;\n447\t          if (this.board.isValid(nr, nc) && !this.obstacleMgr.hasObstacle(nr, nc)) {\n448\t            candidates.push({ row: nr, col: nc });\n449\t          }\n450\t        }\n451\t        if (candidates.length > 0) {\n452\t          const target = candidates[Math.floor(Math.random() * candidates.length)];\n453\t          this.obstacleMgr.addObstacle(OBSTACLE_CHOCOLATE, target.row, target.col);\n454\t        }\n455\t        break;\n456\t      }\n457\t    }\n458\t  }\n459\t\n460\t  _triggerSpecialEffects(row, col, type) {\n461\t    const pos = this.renderer.getTileCenter(row, col);\n462\t    const tile = this.board.getTile(row, col);\n463\t    const color = tile ? COLOR_MAP[tile.color]?.hex : '#FFB800';\n464\t\n465\t    this.audio.playSpecial();\n466\t\n467\t    switch (type) {\n468\t      case 1: case 2:\n469\t        this.particles.emitExplosion(pos.x, pos.y, color || '#FFB800', 20);\n470\t        break;\n471\t      case 3:\n472\t        this.particles.emitExplosion(pos.x, pos.y, '#FF9A3C', 30);\n473\t        break;\n474\t      case 4:\n475\t        for (let i = 0; i < 40; i++) {\n476\t          this.particles.emitExplosion(pos.x, pos.y, '#FFB800', 2);\n477\t        }\n478\t        break;\n479\t    }\n480\t  }\n481\t\n482\t  _removeAndCascade(cells, scorePerCell) {\n483\t    this.state = STATES.REMOVING;\n484\t    const points = cells.length * scorePerCell;\n485\t    this.scoreSystem.addScore(points);\n486\t\n487\t    for (const { row, col } of cells) {\n488\t      const tile = this.board.getTile(row, col);\n489\t      if (tile && tile.color >= 0) {\n490\t        this.scoreSystem.addCollected(tile.color, 1);\n491\t      }\n492\t    }\n493\t\n494\t    for (const { row, col } of cells) {\n495\t      const tile = this.board.getTile(row, col);\n496\t      if (tile) {\n497\t        const pos = this.renderer.getTileCenter(row, col);\n498\t        const color = COLOR_MAP[tile.color];\n499\t        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 6);\n500\t        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n501\t      }\n502\t    }\n503\t\n504\t    setTimeout(() => {\n505\t      for (const { row, col } of cells) {\n506\t        this.board.clearCell(row, col);\n507\t      }\n508\t\n509\t      this.obstacleMgr.onTilesMatched(cells);\n510\t\n511\t      if (this.boss && this.boss.active) {\n512\t        const dmg = this.boss.calculateDamage(cells);\n513\t        if (dmg > 0) {\n514\t          const defeated = this.boss.takeDamage(dmg);\n515\t          this.audio.playBossHit();\n516\t          if (defeated) {\n517\t            this.audio.playBossDefeat();\n518\t            this.scoreSystem.addScore(500);\n519\t          }\n520\t        }\n521\t      }\n522\t\n523\t      this.board.applyGravity();\n524\t\n525\t      this.state = STATES.IDLE;\n526\t      setTimeout(() => this._processMatches(), 200);\n527\t    }, 300);\n528\t  }\n529\t\n530\t  _loop() {\n531\t    const now = performance.now();\n532\t    const dt = Math.min((now - this.lastTime) / 1000, 0.05);\n533\t    this.lastTime = now;\n534\t\n535\t    // Phase 3a: Navigation screens take priority\n536\t    if (this.nav.isActive()) {\n537\t      this.nav.render(this.renderer.ctx, this.renderer.screenW, this.renderer.screenH);\n538\t      // Phase 4: ad stub overlay on top of navigation\n539\t      this.adManager.renderStubAd(this.renderer.ctx, this.renderer.screenW, this.renderer.screenH);\n540\t      requestAnimationFrame(() => this._loop());\n541\t      return;\n542\t    }\n543\t\n544\t    this.update(dt);\n545\t    this.render();\n546\t    // Phase 4: ad stub overlay on top of gameplay\n547\t    this.adManager.renderStubAd(this.renderer.ctx, this.renderer.screenW, this.renderer.screenH);\n548\t    requestAnimationFrame(() => this._loop());\n549\t  }\n550\t\n551\t  update(dt) {\n552\t    this.tweens.update(dt);\n553\t    this.particles.update(dt);\n554\t    this.obstacleMgr.update(dt);\n555\t    if (this.boss) this.boss.update(dt);\n556\t    // Phase 4: ad stub timer\n557\t    this.adManager.update(dt);\n558\t\n559\t    if (this.comboTimer > 0) {\n560\t      this.comboTimer -= dt;\n561\t      if (this.comboTimer <= 0) this.comboText = '';\n562\t    }\n563\t\n564\t    this.input.enabled = this.state === STATES.IDLE;\n565\t  }\n566\t\n567\t  render() {\n568\t    this.renderer.clear();\n569\t    this.renderer.drawBackground();\n570\t\n571\t    for (let r = 0; r < this.board.size; r++) {\n572\t      for (let c = 0; c < this.board.size; c++) {\n573\t        const tile = this.board.getTile(r, c);\n574\t        if (tile) this.renderer.drawTile(tile);\n575\t      }\n576\t    }\n577\t\n578\t    this.renderer.drawObstacles(this.obstacleMgr);\n579\t\n580\t    if (this.boss && this.boss.active) {\n581\t      this.renderer.drawBoss(this.boss, this.renderer);\n582\t    }\n583\t\n584\t    this.particles.draw(this.renderer.ctx);\n585\t    this.renderer.updateAndDrawFloatingTexts(1 / 60);\n586\t\n587\t    const config = this.levels[this.currentLevel] || this.levels[0];\n588\t    this.renderer.drawUI(\n589\t      this.scoreSystem.score,\n590\t      this.scoreSystem.getRemainingMoves(),\n591\t      config,\n592\t      this.scoreSystem,\n593\t      this.currentLevel + 1,\n594\t    );\n595\t\n596\t    if (this.comboText) {\n597\t      this.renderer.drawComboText(this.comboText);\n598\t    }\n599\t\n600\t    if (this.boss && this.boss.active) {\n601\t      this.renderer.drawBossHealthBar(this.boss);\n602\t    }\n603\t\n604\t    // Phase 3a: back-to-map button during gameplay\n605\t    this._drawBackButton();\n606\t\n607\t    // Result screen is now handled by Navigation\n608\t  }\n609\t\n610\t  _drawBackButton() {\n611\t    const ctx = this.renderer.ctx;\n612\t    const w = this.renderer.screenW;\n613\t    ctx.fillStyle = '#8D6E6399';\n614\t    this.renderer._roundRect(ctx, w - 50, this.renderer.boardY + this.renderer.tileSize * BOARD_SIZE + 25, 40, 28, 14);\n615\t    ctx.fill();\n616\t    ctx.fillStyle = '#FFF';\n617\t    ctx.font = 'bold 12px sans-serif';\n618\t    ctx.textAlign = 'center';\n619\t    ctx.fillText('地图', w - 30, this.renderer.boardY + this.renderer.tileSize * BOARD_SIZE + 44);\n620\t  }\n621\t\n622\t  retry() {\n623\t    this._loadLevel(this.currentLevel);\n624\t    this.state = STATES.IDLE;\n625\t  }\n626\t\n627\t  nextLevel() {\n628\t    const next = this.currentLevel + 1;\n629\t    if (next < this.levels.length) {\n630\t      this._loadLevel(next);\n631\t      this.state = STATES.IDLE;\n632\t    } else {\n633\t      this._loadLevel(0);\n634\t      this.state = STATES.IDLE;\n635\t    }\n636\t  }\n637\t}\n638\t\n639\tif (typeof module !== 'undefined') module.exports = { Game, STATES };\n640\t"}]},"parent_tool_use_id":null,"session_id":"ec73960d-df44-45f4-a48b-a11bb93a968e","uuid":"c1694b44-441d-4ae4-8355-f90804059d1c","timestamp":"2026-05-22T22:42:56.917Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\douyin-match3\\src\\js\\Game.js","content":"// Game.js — Main game loop, state machine, integrates all Phase 2+3a systems\n\nconst STATES = {\n  MENU: 'menu',\n  IDLE: 'idle',\n  SWAPPING: 'swapping',\n  MATCHING: 'matching',\n  REMOVING: 'removing',\n  DROPPING: 'dropping',\n  RESULT: 'result',\n  BOSS_SKILL: 'boss_skill',\n};\n\nclass Game {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.board = new Board();\n    this.matchEngine = new MatchEngine(this.board);\n    this.renderer = new Renderer(canvas);\n    this.input = new InputHandler(canvas, this.board);\n    this.scoreSystem = new ScoreSystem();\n    this.tweens = new TweenManager();\n    this.particles = new ParticleSystem();\n    this.obstacleMgr = new ObstacleManager(this.board);\n    this.audio = new AudioManager();\n    this.boss = null;\n    this.levels = LEVELS;\n    this.currentLevel = 0;\n    this.state = STATES.IDLE;\n    this.comboText = '';\n    this.comboTimer = 0;\n    this.lastTime = 0;\n    this.resultData = null;\n    this.moveCount = 0;\n\n    // Phase 3a: meta-progression systems\n    this.dataManager = new DataManager();\n    this.coinSystem = new CoinSystem(this.dataManager);\n    this.characterMgr = new CharacterManager();\n    this.mapScreen = new MapScreen(this.dataManager);\n    this.shopUI = new ShopUI(this.coinSystem, this.dataManager);\n    this.nav = new Navigation(this);\n\n    // Phase 3b: daily + social\n    this.dailySystem = new DailySystem(this.dataManager, this.coinSystem);\n    this.socialSystem = new SocialSystem(this.dataManager);\n    this.dailySystem.checkNewDay();\n\n    // Phase 4: ads + analytics\n    this.adManager = new AdManager(this.dataManager);\n    this.analytics = new Analytics(this.dataManager);\n    this.analytics.trackGameStart();\n\n    this.renderer.particleSystem = this.particles;\n\n    this._setupInput();\n    this._setupScoreCallbacks();\n    this._setupObstacleCallbacks();\n  }\n\n  _setupInput() {\n    this.input.onSwap = (r1, c1, r2, c2) => this._handleSwap(r1, c1, r2, c2);\n    this.input.onTap = (row, col) => this._handleTap(row, col);\n  }\n\n  _setupScoreCallbacks() {\n    this.scoreSystem.onLevelComplete = (score, stars) => {\n      this.nav.showResult(true, score, stars, this.currentLevel + 1);\n      this.audio.playLevelWin();\n      // Phase 3b: daily task tracking\n      this.dailySystem.reportEvent('complete_levels', 1);\n      if (stars === 3) this.dailySystem.reportEvent('star3', 1);\n      if (score >= 2000) this.dailySystem.reportEvent('score', score);\n      // Phase 4: analytics + ad success tracking\n      this.analytics.trackLevelComplete(this.currentLevel + 1, score, stars, this.moveCount);\n      this.adManager.reportSuccess();\n    };\n    this.scoreSystem.onLevelFail = (score) => {\n      this.nav.showResult(false, score, 0, this.currentLevel + 1);\n      this.audio.playLevelFail();\n      // Phase 4: analytics + ad fail tracking\n      this.analytics.trackLevelFail(this.currentLevel + 1, score, this.moveCount, this.scoreSystem.getGoalProgress());\n      this.adManager.reportFail();\n    };\n  }\n\n  _setupObstacleCallbacks() {\n    this.obstacleMgr.onObstacleDestroyed = (obs) => {\n      this.scoreSystem.addObstacleCleared(obs.type);\n      this.audio.playObstacleBreak();\n      // Phase 3b: daily obstacle tracking\n      this.dailySystem.reportEvent('clear_obstacle', obs.type);\n      const pos = this.renderer.getTileCenter(obs.row, obs.col);\n      this.particles.emitExplosion(pos.x, pos.y, this._obstacleColor(obs.type), 12);\n    };\n  }\n\n  _obstacleColor(type) {\n    switch (type) {\n      case OBSTACLE_ICE: return '#88CCFF';\n      case OBSTACLE_CHAIN: return '#AAAAAA';\n      case OBSTACLE_CHOCOLATE: return '#8B4513';\n      default: return '#FFFFFF';\n    }\n  }\n\n  start() {\n    this.lastTime = performance.now();\n    this._loop();\n  }\n\n  _loadLevel(idx) {\n    this.currentLevel = idx;\n    const config = this.levels[idx] || this.levels[0];\n    this.board.init();\n    this.scoreSystem.reset(idx + 1);\n    this.scoreSystem.configure(config);\n    this.tweens.clear();\n    this.particles.particles = [];\n    this.renderer.floatingTexts = [];\n    this.comboText = '';\n    this.resultData = null;\n    this.moveCount = 0;\n\n    // Phase 4: analytics\n    this.analytics.trackLevelStart(idx + 1, config);\n\n    this.obstacleMgr.loadFromConfig(config.obstacles);\n\n    for (const obs of this.obstacleMgr.obstacles) {\n      if (obs.type === OBSTACLE_CHOCOLATE) {\n        this.board.clearCell(obs.row, obs.col);\n      }\n    }\n\n    this.boss = null;\n    if (config.boss) {\n      this.boss = new Boss(config.boss);\n      this.board.clearCell(this.boss.row, this.boss.col);\n    }\n\n    this.board.applyGravity();\n    this.board._removeInitialMatches();\n\n    this.input.updateLayout(\n      this.renderer.tileSize,\n      this.renderer.boardX,\n      this.renderer.boardY,\n    );\n  }\n\n  _handleTap(row, col) {\n    if (this.state !== STATES.IDLE) return;\n    const tile = this.board.getTile(row, col);\n    if (!tile) return;\n\n    this.audio.init();\n\n    if (tile.special === SPECIAL_RAINBOW) return;\n  }\n\n  _handleSwap(r1, c1, r2, c2) {\n    if (this.state !== STATES.IDLE) return;\n\n    this.audio.init();\n\n    const tileA = this.board.getTile(r1, c1);\n    const tileB = this.board.getTile(r2, c2);\n\n    if (!this.obstacleMgr.canSwap(r1, c1) || !this.obstacleMgr.canSwap(r2, c2)) {\n      this.audio.playInvalid();\n      return;\n    }\n\n    if (tileA && tileA.special === SPECIAL_RAINBOW) {\n      this._activateRainbow(r1, c1, tileB ? tileB.color : 0, r2, c2);\n      return;\n    }\n    if (tileB && tileB.special === SPECIAL_RAINBOW) {\n      this._activateRainbow(r2, c2, tileA ? tileA.color : 0, r1, c1);\n      return;\n    }\n\n    if (!this.matchEngine.isValidSwap(r1, c1, r2, c2)) {\n      this.audio.playInvalid();\n      return;\n    }\n    if (!this.scoreSystem.useMove()) return;\n\n    this.audio.playSwap();\n    this.moveCount++;\n    this.state = STATES.SWAPPING;\n    this.board.swap(r1, c1, r2, c2);\n\n    this._animateSwap(r1, c1, r2, c2, () => {\n      this._processMatches();\n    });\n  }\n\n  _animateSwap(r1, c1, r2, c2, callback) {\n    const tileSize = this.renderer.tileSize;\n    const tileA = this.board.getTile(r2, c2);\n    const tileB = this.board.getTile(r1, c1);\n    const dx = (c2 - c1) * tileSize;\n    const dy = (r2 - r1) * tileSize;\n\n    if (tileA) {\n      tileA.offsetX = -dx;\n      tileA.offsetY = -dy;\n      this.tweens.add(tileA, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n    }\n    if (tileB) {\n      tileB.offsetX = dx;\n      tileB.offsetY = dy;\n      this.tweens.add(tileB, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n    }\n    setTimeout(callback, 160);\n  }\n\n  _activateRainbow(rainbowRow, rainbowCol, targetColor, otherRow, otherCol) {\n    if (!this.scoreSystem.useMove()) return;\n    this.moveCount++;\n    this.audio.playSpecial();\n    this.state = STATES.MATCHING;\n\n    const toRemove = this.matchEngine.triggerRainbow(rainbowRow, rainbowCol, targetColor);\n    toRemove.push({ row: rainbowRow, col: rainbowCol });\n    if (this.board.getTile(otherRow, otherCol)) {\n      toRemove.push({ row: otherRow, col: otherCol });\n    }\n\n    this._removeAndCascade(toRemove, 10);\n  }\n\n  _processMatches() {\n    this.state = STATES.MATCHING;\n    const matches = this.board.findAllMatches();\n\n    if (matches.length === 0) {\n      this._afterMoveComplete();\n      return;\n    }\n\n    this._processChain(0);\n  }\n\n  _processChain(chainCount) {\n    chainCount++;\n    const matches = this.board.findAllMatches();\n    if (matches.length === 0) {\n      this._afterMoveComplete();\n      return;\n    }\n\n    const lShapes = this.board.findLShapeMatches(matches);\n    const { removeCells, specials } = this.matchEngine._classifyMatches(matches, lShapes);\n\n    const multiplier = chainCount <= 1 ? 1 : chainCount === 2 ? 1.5 : chainCount === 3 ? 2.0 : 2.5;\n    const baseScore = removeCells.size * 10;\n    const points = Math.floor(baseScore * multiplier);\n    this.scoreSystem.addScore(points);\n\n    // Phase 3a: character skill — chain bonus\n    this.characterMgr.applySkill(\n      this.dataManager.selectedCharacter,\n      this, 'chain_score', { chainCount },\n    );\n\n    if (chainCount >= 4) this.comboText = '超赞！！';\n    else if (chainCount === 3) this.comboText = '太棒了！';\n    else if (chainCount === 2) this.comboText = '不错！';\n    this.comboTimer = 0.8;\n\n    // Phase 3b: daily chain tracking\n    this.dailySystem.reportEvent('chain', 1);\n\n    this.audio.playMatch(chainCount);\n    if (chainCount >= 2) this.audio.playCombo(chainCount);\n\n    // Collect matched positions\n    const matchedPositions = [];\n    for (const key of removeCells) {\n      const [r, c] = key.split(',').map(Number);\n      const tile = this.board.getTile(r, c);\n      if (tile && tile.color >= 0) {\n        this.scoreSystem.addCollected(tile.color, 1);\n      }\n      matchedPositions.push({ row: r, col: c });\n    }\n\n    // Phase 3a: character skill — lucky special\n    const matchCells = [];\n    for (const key of removeCells) {\n      const [r, c] = key.split(',').map(Number);\n      matchCells.push({ row: r, col: c });\n    }\n    this.characterMgr.applySkill(\n      this.dataManager.selectedCharacter,\n      this, 'match_created', { cells: matchCells },\n    );\n\n    // Create specials\n    const specialPositions = new Set(specials.map(s => `${s.row},${s.col}`));\n    for (const sp of specials) {\n      const tile = this.board.getTile(sp.row, sp.col);\n      if (tile) {\n        tile.special = sp.type;\n        tile.removing = false;\n      }\n    }\n\n    // Animate removal\n    this.state = STATES.REMOVING;\n    const toAnimate = [];\n    for (const key of removeCells) {\n      if (specialPositions.has(key)) continue;\n      const [r, c] = key.split(',').map(Number);\n      const tile = this.board.getTile(r, c);\n      if (tile) {\n        const pos = this.renderer.getTileCenter(r, c);\n        const color = COLOR_MAP[tile.color];\n        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 8);\n        this.renderer.addFloatingText(`+${points}`, pos.x, pos.y);\n        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n        toAnimate.push(tile);\n      }\n    }\n\n    setTimeout(() => {\n      for (const key of removeCells) {\n        if (specialPositions.has(key)) continue;\n        const [r, c] = key.split(',').map(Number);\n        this.board.clearCell(r, c);\n      }\n\n      for (const sp of specials) {\n        this._triggerSpecialEffects(sp.row, sp.col, sp.type);\n      }\n\n      this.obstacleMgr.onTilesMatched(matchedPositions);\n\n      if (this.boss && this.boss.active) {\n        const dmg = this.boss.calculateDamage(matchedPositions);\n        if (dmg > 0) {\n          const defeated = this.boss.takeDamage(dmg);\n          this.audio.playBossHit();\n          if (defeated) {\n            this.audio.playBossDefeat();\n            this.scoreSystem.addScore(500);\n          }\n        }\n      }\n\n      this.state = STATES.DROPPING;\n      const drops = this.board.applyGravity();\n\n      for (const drop of drops) {\n        const tile = drop.tile;\n        const fromY = drop.fromRow * this.renderer.tileSize;\n        const toY = drop.toRow * this.renderer.tileSize;\n        tile.offsetY = fromY - toY;\n        this.tweens.add(tile, { offsetY: 0 }, 0.2 + drop.distance * 0.03, 'easeOutBounce');\n      }\n\n      setTimeout(() => {\n        this._processChain(chainCount);\n      }, 350);\n    }, 280);\n  }\n\n  _afterMoveComplete() {\n    if (this.boss && this.boss.isDefeated() && this.scoreSystem.goalType === 'boss') {\n      this.nav.showResult(true, this.scoreSystem.score, this.scoreSystem.getStarCount(), this.currentLevel + 1);\n      this.audio.playLevelWin();\n      return;\n    }\n\n    this.obstacleMgr.spreadChocolate();\n\n    // Phase 3a: character skill — auto obstacle clear\n    this.characterMgr.applySkill(\n      this.dataManager.selectedCharacter,\n      this, 'after_move', null,\n    );\n\n    if (this.boss && this.boss.active) {\n      const ability = this.boss.tryUseAbility();\n      if (ability) {\n        this._executeBossAbility(ability);\n      }\n    }\n\n    this.state = STATES.IDLE;\n\n    if (!this.board.hasValidMoves(this.obstacleMgr)) {\n      this.board.shuffle();\n    }\n\n    this.scoreSystem.checkState();\n  }\n\n  _executeBossAbility(ability) {\n    this.audio.playBossAbility();\n\n    switch (ability) {\n      case 'freeze': {\n        const candidates = [];\n        for (let r = 0; r < this.board.size; r++) {\n          for (let c = 0; c < this.board.size; c++) {\n            if (!this.obstacleMgr.hasObstacle(r, c) && this.board.getTile(r, c)) {\n              if (this.boss && r === this.boss.row && c === this.boss.col) continue;\n              candidates.push({ row: r, col: c });\n            }\n          }\n        }\n        const count = Math.min(2, candidates.length);\n        for (let i = 0; i < count; i++) {\n          const idx = Math.floor(Math.random() * candidates.length);\n          const target = candidates.splice(idx, 1)[0];\n          this.obstacleMgr.addObstacle(OBSTACLE_ICE, target.row, target.col);\n        }\n        break;\n      }\n      case 'chain': {\n        const candidates = [];\n        for (let r = 0; r < this.board.size; r++) {\n          for (let c = 0; c < this.board.size; c++) {\n            if (!this.obstacleMgr.hasObstacle(r, c) && this.board.getTile(r, c)) {\n              if (this.boss && r === this.boss.row && c === this.boss.col) continue;\n              candidates.push({ row: r, col: c });\n            }\n          }\n        }\n        if (candidates.length > 0) {\n          const idx = Math.floor(Math.random() * candidates.length);\n          const target = candidates[idx];\n          this.obstacleMgr.addObstacle(OBSTACLE_CHAIN, target.row, target.col);\n        }\n        break;\n      }\n      case 'chocolate': {\n        const dirs = [[-1,0],[1,0],[0,-1],[0,1]];\n        const candidates = [];\n        for (const [dr, dc] of dirs) {\n          const nr = this.boss.row + dr;\n          const nc = this.boss.col + dc;\n          if (this.board.isValid(nr, nc) && !this.obstacleMgr.hasObstacle(nr, nc)) {\n            candidates.push({ row: nr, col: nc });\n          }\n        }\n        if (candidates.length > 0) {\n          const target = candidates[Math.floor(Math.random() * candidates.length)];\n          this.obstacleMgr.addObstacle(OBSTACLE_CHOCOLATE, target.row, target.col);\n        }\n        break;\n      }\n    }\n  }\n\n  _triggerSpecialEffects(row, col, type) {\n    const pos = this.renderer.getTileCenter(row, col);\n    const tile = this.board.getTile(row, col);\n    const color = tile ? COLOR_MAP[tile.color]?.hex : '#FFB800';\n\n    this.audio.playSpecial();\n\n    switch (type) {\n      case 1: case 2:\n        this.particles.emitExplosion(pos.x, pos.y, color || '#FFB800', 20);\n        break;\n      case 3:\n        this.particles.emitExplosion(pos.x, pos.y, '#FF9A3C', 30);\n        break;\n      case 4:\n        for (let i = 0; i < 40; i++) {\n          this.particles.emitExplosion(pos.x, pos.y, '#FFB800', 2);\n        }\n        break;\n    }\n  }\n\n  _removeAndCascade(cells, scorePerCell) {\n    this.state = STATES.REMOVING;\n    const points = cells.length * scorePerCell;\n    this.scoreSystem.addScore(points);\n\n    for (const { row, col } of cells) {\n      const tile = this.board.getTile(row, col);\n      if (tile && tile.color >= 0) {\n        this.scoreSystem.addCollected(tile.color, 1);\n      }\n    }\n\n    for (const { row, col } of cells) {\n      const tile = this.board.getTile(row, col);\n      if (tile) {\n        const pos = this.renderer.getTileCenter(row, col);\n        const color = COLOR_MAP[tile.color];\n        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 6);\n        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n      }\n    }\n\n    setTimeout(() => {\n      for (const { row, col } of cells) {\n        this.board.clearCell(row, col);\n      }\n\n      this.obstacleMgr.onTilesMatched(cells);\n\n      if (this.boss && this.boss.active) {\n        const dmg = this.boss.calculateDamage(cells);\n        if (dmg > 0) {\n          const defeated = this.boss.takeDamage(dmg);\n          this.audio.playBossHit();\n          if (defeated) {\n            this.audio.playBossDefeat();\n            this.scoreSystem.addScore(500);\n          }\n        }\n      }\n\n      this.board.applyGravity();\n\n      this.state = STATES.IDLE;\n      setTimeout(() => this._processMatches(), 200);\n    }, 300);\n  }\n\n  _loop() {\n    const now = performance.now();\n    const dt = Math.min((now - this.lastTime) / 1000, 0.05);\n    this.lastTime = now;\n\n    // Phase 3a: Navigation screens take priority\n    if (this.nav.isActive()) {\n      this.nav.render(this.renderer.ctx, this.renderer.screenW, this.renderer.screenH);\n      // Phase 4: ad stub overlay on top of navigation\n      this.adManager.renderStubAd(this.renderer.ctx, this.renderer.screenW, this.renderer.screenH);\n      requestAnimationFrame(() => this._loop());\n      return;\n    }\n\n    this.update(dt);\n    this.render();\n    // Phase 4: ad stub overlay on top of gameplay\n    this.adManager.renderStubAd(this.renderer.ctx, this.renderer.screenW, this.renderer.screenH);\n    requestAnimationFrame(() => this._loop());\n  }\n\n  update(dt) {\n    this.tweens.update(dt);\n    this.particles.update(dt);\n    this.obstacleMgr.update(dt);\n    if (this.boss) this.boss.update(dt);\n    // Phase 4: ad stub timer\n    this.adManager.update(dt);\n\n    if (this.comboTimer > 0) {\n      this.comboTimer -= dt;\n      if (this.comboTimer <= 0) this.comboText = '';\n    }\n\n    this.input.enabled = this.state === STATES.IDLE;\n  }\n\n  render() {\n    this.renderer.clear();\n    this.renderer.drawBackground();\n\n    for (let r = 0; r < this.board.size; r++) {\n      for (let c = 0; c < this.board.size; c++) {\n        const tile = this.board.getTile(r, c);\n        if (tile) this.renderer.drawTile(tile);\n      }\n    }\n\n    this.renderer.drawObstacles(this.obstacleMgr);\n\n    if (this.boss && this.boss.active) {\n      this.renderer.drawBoss(this.boss, this.renderer);\n    }\n\n    this.particles.draw(this.renderer.ctx);\n    this.renderer.updateAndDrawFloatingTexts(1 / 60);\n\n    const config = this.levels[this.currentLevel] || this.levels[0];\n    this.renderer.drawUI(\n      this.scoreSystem.score,\n      this.scoreSystem.getRemainingMoves(),\n      config,\n      this.scoreSystem,\n      this.currentLevel + 1,\n    );\n\n    if (this.comboText) {\n      this.renderer.drawComboText(this.comboText);\n    }\n\n    if (this.boss && this.boss.active) {\n      this.renderer.drawBossHealthBar(this.boss);\n    }\n\n    // Phase 3a: back-to-map button during gameplay\n    this._drawBackButton();\n\n    // Result screen is now handled by Navigation\n  }\n\n  _drawBackButton() {\n    const ctx = this.renderer.ctx;\n    const w = this.renderer.screenW;\n    ctx.fillStyle = '#8D6E6399';\n    this.renderer._roundRect(ctx, w - 50, this.renderer.boardY + this.renderer.tileSize * BOARD_SIZE + 25, 40, 28, 14);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 12px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('地图', w - 30, this.renderer.boardY + this.renderer.tileSize * BOARD_SIZE + 44);\n  }\n\n  retry() {\n    this._loadLevel(this.currentLevel);\n    this.state = STATES.IDLE;\n  }\n\n  nextLevel() {\n    const next = this.currentLevel + 1;\n    if (next < this.levels.length) {\n      this._loadLevel(next);\n      this.state = STATES.IDLE;\n    } else {\n      this._loadLevel(0);\n      this.state = STATES.IDLE;\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Game, STATES };\n","numLines":640,"startLine":1,"totalLines":640}}}
