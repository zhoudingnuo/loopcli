hocolates = this.obstacles.filter(o => o.type === OBSTACLE_CHOCOLATE && !o.isDestroyed());\n    if (chocolates.length === 0) return [];\n\n    const dirs = [[-1,0],[1,0],[0,-1],[0,1]];\n    const choco = chocolates[Math.floor(Math.random() * chocolates.length)];\n    const candidates = [];\n\n    for (const [dr, dc] of dirs) {\n      const nr = choco.row + dr;\n      const nc = choco.col + dc;\n      if (this.board.isValid(nr, nc) && !this.hasObstacle(nr, nc)) {\n        candidates.push({ row: nr, col: nc });\n      }\n    }\n\n    if (candidates.length > 0) {\n      const target = candidates[Math.floor(Math.random() * candidates.length)];\n      const newObs = new ObstacleCell(OBSTACLE_CHOCOLATE, target.row, target.col);\n      this.obstacles.push(newObs);\n      this.board.clearCell(target.row, target.col);\n      if (this.onChocolateSpread) this.onChocolateSpread(newObs);\n      return [newObs];\n    }\n    return [];\n  }\n\n  addObstacle(type, row, col, hp) {\n    if (this.hasObstacle(row, col)) return null;\n    const obs = new ObstacleCell(type, row, col, hp || 1);\n    this.obstacles.push(obs);\n    if (type === OBSTACLE_CHOCOLATE) {\n      this.board.clearCell(row, col);\n    }\n    return obs;\n  }\n\n  countByType(type) {\n    return this.obstacles.filter(o => o.type === type && !o.isDestroyed()).length;\n  }\n\n  countAll() {\n    return this.obstacles.filter(o => !o.isDestroyed()).length;\n  }\n\n  clear() {\n    this.obstacles = [];\n  }\n\n  update(dt) {\n    for (const obs of this.obstacles) {\n      if (obs.shakeTimer > 0) obs.shakeTimer -= dt;\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = {\n  ObstacleCell, ObstacleManager,\n  OBSTACLE_NONE, OBSTACLE_ICE, OBSTACLE_CHAIN, OBSTACLE_CHOCOLATE\n};\n","structuredPatch":[],"originalFile":null,"userModified":false}}
