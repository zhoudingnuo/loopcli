{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6569694a4c414c3aba3b7a6d","type":"tool_result","content":"1\t// Map.ts — Grid-based map system with terrain and area rendering\n2\t\n3\texport enum Terrain {\n4\t  Grass = 0,\n5\t  Rock = 1,\n6\t  Water = 2,\n7\t  RichSoil = 3,\n8\t  Mountain = 4,\n9\t  Path = 5,\n10\t  SpiritVein = 6,\n11\t}\n12\t\n13\texport interface MapConfig {\n14\t  width: number;\n15\t  height: number;\n16\t  bgColor: string;\n17\t  gridColor: string;\n18\t  cellSize: number;\n19\t}\n20\t\n21\texport const DEFAULT_CELL_SIZE = 32;\n22\t\n23\texport class GameMap {\n24\t  width: number;\n25\t  height: number;\n26\t  cellSize: number;\n27\t  terrain: Terrain[];\n28\t  bgColor: string;\n29\t  gridColor: string;\n30\t\n31\t  constructor(\n32\t    width: number,\n33\t    height: number,\n34\t    bgColor: string = '#2a3a1a',\n35\t    gridColor: string = '#3a4a2a',\n36\t    cellSize: number = DEFAULT_CELL_SIZE,\n37\t  ) {\n38\t    this.width = width;\n39\t    this.height = height;\n40\t    this.cellSize = cellSize;\n41\t    this.bgColor = bgColor;\n42\t    this.gridColor = gridColor;\n43\t    this.terrain = new Array(width * height).fill(Terrain.Grass);\n44\t  }\n45\t\n46\t  get indexSize(): number {\n47\t    return this.width * this.height;\n48\t  }\n49\t\n50\t  inBounds(gx: number, gy: number): boolean {\n51\t    return gx >= 0 && gx < this.width && gy >= 0 && gy < this.height;\n52\t  }\n53\t\n54\t  getTerrain(gx: number, gy: number): Terrain {\n55\t    if (!this.inBounds(gx, gy)) return Terrain.Mountain;\n56\t    return this.terrain[gy * this.width + gx];\n57\t  }\n58\t\n59\t  setTerrain(gx: number, gy: number, t: Terrain): void {\n60\t    if (!this.inBounds(gx, gy)) return;\n61\t    this.terrain[gy * this.width + gx] = t;\n62\t  }\n63\t\n64\t  // Check if a rect of cells is free for placement\n65\t  isAreaFree(gx: number, gy: number, w: number, h: number, occupied: Set<string>): boolean {\n66\t    for (let dy = 0; dy < h; dy++) {\n67\t      for (let dx = 0; dx < w; dx++) {\n68\t        const cx = gx + dx;\n69\t        const cy = gy + dy;\n70\t        if (!this.inBounds(cx, cy)) return false;\n71\t        const t = this.getTerrain(cx, cy);\n72\t        if (t === Terrain.Water || t === Terrain.Mountain) return false;\n73\t        const key = `${cx},${cy}`;\n74\t        if (occupied.has(key)) return false;\n75\t      }\n76\t    }\n77\t    return true;\n78\t  }\n79\t\n80\t  // Generate terrain for the starting area (炼气坪)\n81\t  generateStartingArea(): void {\n82\t    // Add some spirit veins (矿脉)\n83\t    const veinPositions = [\n84\t      [3, 2], [4, 2], [3, 3],\n85\t      [14, 10], [15, 10], [15, 11],\n86\t      [8, 7], [8, 8],\n87\t    ];\n88\t    for (const [x, y] of veinPositions) {\n89\t      this.setTerrain(x, y, Terrain.SpiritVein);\n90\t    }\n91\t\n92\t    // Add some water features\n93\t    const waterPositions = [\n94\t      [10, 1], [11, 1], [10, 2],\n95\t      [1, 12], [2, 12], [1, 11],\n96\t    ];\n97\t    for (const [x, y] of waterPositions) {\n98\t      this.setTerrain(x, y, Terrain.Water);\n99\t    }\n100\t\n101\t    // Add path\n102\t    for (let x = 5; x < 15; x++) {\n103\t      this.setTerrain(x, 7, Terrain.Path);\n104\t    }\n105\t    for (let y = 3; y < 12; y++) {\n106\t      this.setTerrain(10, y, Terrain.Path);\n107\t    }\n108\t\n109\t    // Rich soil near center\n110\t    for (let y = 5; y < 8; y++) {\n111\t      for (let x = 6; x < 9; x++) {\n112\t        this.setTerrain(x, y, Terrain.RichSoil);\n113\t      }\n114\t    }\n115\t  }\n116\t\n117\t  // Generate terrain for a specific region type\n118\t  generateRegionTerrain(regionId: string): void {\n119\t    switch (regionId) {\n120\t      case 'zhuji_platform':\n121\t        this.generateZhujiPlatform();\n122\t        break;\n123\t      case 'medicine_valley':\n124\t        this.generateMedicineValley();\n125\t        break;\n126\t      case 'core_peak':\n127\t        this.generateCorePeak();\n128\t        break;\n129\t      case 'ore_mountain':\n130\t        this.generateOreMountain();\n131\t        break;\n132\t      case 'spirit_field_area':\n133\t        this.generateSpiritFieldArea();\n134\t        break;\n135\t      case 'mine_area':\n136\t        this.generateMineArea();\n137\t        break;\n138\t      default:\n139\t        this.generateStartingArea();\n140\t    }\n141\t  }\n142\t\n143\t  private generateZhujiPlatform(): void {\n144\t    // 筑基台：灵铁+灵木丰富，中等大小\n145\t    const veinPositions = [\n146\t      [5, 3], [6, 3], [5, 4],\n147\t      [20, 15], [21, 15], [21, 16],\n148\t      [12, 10], [13, 10],\n149\t    ];\n150\t    for (const [x, y] of veinPositions) {\n151\t      this.setTerrain(x, y, Terrain.SpiritVein);\n152\t    }\n153\t\n154\t    // Rich soil patches\n155\t    for (let y = 6; y < 12; y++) {\n156\t      for (let x = 8; x < 14; x++) {\n157\t        this.setTerrain(x, y, Terrain.RichSoil);\n158\t      }\n159\t    }\n160\t\n161\t    // Paths\n162\t    for (let x = 4; x < 26; x++) {\n163\t      this.setTerrain(x, 12, Terrain.Path);\n164\t    }\n165\t    for (let y = 4; y < 22; y++) {\n166\t      this.setTerrain(15, y, Terrain.Path);\n167\t    }\n168\t\n169\t    // Water features\n170\t    this.setTerrain(2, 2, Terrain.Water);\n171\t    this.setTerrain(3, 2, Terrain.Water);\n172\t    this.setTerrain(2, 3, Terrain.Water);\n173\t  }\n174\t\n175\t  private generateMedicineValley(): void {\n176\t    // 药王谷：大量灵田，稀有灵草\n177\t    for (let y = 3; y < 22; y++) {\n178\t      for (let x = 3; x < 32; x++) {\n179\t        if (Math.random() < 0.6) {\n180\t          this.setTerrain(x, y, Terrain.RichSoil);\n181\t        }\n182\t      }\n183\t    }\n184\t\n185\t    // Spirit veins at edges\n186\t    const veinPositions = [\n187\t      [1, 1], [33, 1], [1, 23], [33, 23],\n188\t      [17, 12],\n189\t    ];\n190\t    for (const [x, y] of veinPositions) {\n191\t      this.setTerrain(x, y, Terrain.SpiritVein);\n192\t    }\n193\t\n194\t    // Central path\n195\t    for (let x = 5; x < 30; x++) {\n196\t      this.setTerrain(x, 12, Terrain.Path);\n197\t    }\n198\t  }\n199\t\n200\t  private generateCorePeak(): void {\n201\t    // 丹鼎峰：炼丹圣地，岩石地形多\n202\t    const veinPositions = [\n203\t      [5, 5], [6, 5], [5, 6],\n204\t      [28, 22], [29, 22], [29, 23],\n205\t      [17, 14], [18, 14],\n206\t      [10, 20], [24, 8],\n207\t    ];\n208\t    for (const [x, y] of veinPositions) {\n209\t      this.setTerrain(x, y, Terrain.SpiritVein);\n210\t    }\n211\t\n212\t    // Rocky terrain\n213\t    for (let y = 2; y < 28; y += 4) {\n214\t      for (let x = 2; x < 33; x += 5) {\n215\t        if (Math.random() < 0.3) {\n216\t          this.setTerrain(x, y, Terrain.Rock);\n217\t        }\n218\t      }\n219\t    }\n220\t\n221\t    // Paths\n222\t    for (let x = 3; x < 32; x++) {\n223\t      this.setTerrain(x, 15, Terrain.Path);\n224\t    }\n225\t    for (let y = 3; y < 28; y++) {\n226\t      this.setTerrain(17, y, Terrain.Path);\n227\t    }\n228\t  }\n229\t\n230\t  private generateOreMountain(): void {\n231\t    // 矿脉山：大量矿脉，灵石/灵铁高产\n232\t    const veinPositions = [\n233\t      [4, 4], [5, 4], [4, 5],\n234\t      [20, 5], [21, 5], [21, 6],\n235\t      [35, 15], [36, 15], [36, 16],\n236\t      [10, 20], [11, 20], [11, 21],\n237\t      [28, 25], [29, 25], [29, 26],\n238\t    ];\n239\t    for (const [x, y] of veinPositions) {\n240\t      this.setTerrain(x, y, Terrain.SpiritVein);\n241\t    }\n242\t\n243\t    // Mountain terrain\n244\t    for (let y = 0; y < 5; y++) {\n245\t      for (let x = 0; x < this.width; x++) {\n246\t        if (Math.random() < 0.4) this.setTerrain(x, y, Terrain.Mountain);\n247\t      }\n248\t    }\n249\t\n250\t    // Paths\n251\t    for (let x = 5; x < 35; x++) {\n252\t      this.setTerrain(x, 15, Terrain.Path);\n253\t    }\n254\t    for (let y = 5; y < 25; y++) {\n255\t      this.setTerrain(20, y, Terrain.Path);\n256\t    }\n257\t  }\n258\t\n259\t  private generateSpiritFieldArea(): void {\n260\t    // 灵田区：大量灵田资源\n261\t    for (let y = 4; y < 16; y++) {\n262\t      for (let x = 4; x < 21; x++) {\n263\t        if (Math.random() < 0.5) {\n264\t          this.setTerrain(x, y, Terrain.RichSoil);\n265\t        }\n266\t      }\n267\t    }\n268\t\n269\t    const veinPositions = [\n270\t      [2, 2], [22, 18],\n271\t    ];\n272\t    for (const [x, y] of veinPositions) {\n273\t      this.setTerrain(x, y, Terrain.SpiritVein);\n274\t    }\n275\t\n276\t    for (let x = 3; x < 22; x++) {\n277\t      this.setTerrain(x, 10, Terrain.Path);\n278\t    }\n279\t  }\n280\t\n281\t  private generateMineArea(): void {\n282\t    // 灵石矿区：大量矿脉\n283\t    const veinPositions = [\n284\t      [3, 3], [4, 3], [3, 4],\n285\t      [15, 8], [16, 8], [16, 9],\n286\t      [25, 15], [26, 15], [26, 16],\n287\t    ];\n288\t    for (const [x, y] of veinPositions) {\n289\t      this.setTerrain(x, y, Terrain.SpiritVein);\n290\t    }\n291\t\n292\t    for (let x = 5; x < 25; x++) {\n293\t      this.setTerrain(x, 10, Terrain.Path);\n294\t    }\n295\t  }\n296\t\n297\t  // Render map terrain to canvas\n298\t  render(\n299\t    ctx: CanvasRenderingContext2D,\n300\t    offsetX: number,\n301\t    offsetY: number,\n302\t    viewportW: number,\n303\t    viewportH: number,\n304\t    scale: number,\n305\t  ): void {\n306\t    const invScale = 1 / scale;\n307\t    const startCol = Math.max(0, Math.floor(-offsetX * invScale / this.cellSize));\n308\t    const startRow = Math.max(0, Math.floor(-offsetY * invScale / this.cellSize));\n309\t    const endCol = Math.min(this.width, Math.ceil((-offsetX + viewportW) * invScale / this.cellSize) + 1);\n310\t    const endRow = Math.min(this.height, Math.ceil((-offsetY + viewportH) * invScale / this.cellSize) + 1);\n311\t\n312\t    // Draw terrain cells\n313\t    for (let row = startRow; row < endRow; row++) {\n314\t      for (let col = startCol; col < endCol; col++) {\n315\t        const x = offsetX + col * this.cellSize * scale;\n316\t        const y = offsetY + row * this.cellSize * scale;\n317\t        const size = this.cellSize * scale;\n318\t\n319\t        ctx.fillStyle = this.getTerrainColor(this.getTerrain(col, row));\n320\t        ctx.fillRect(x, y, size, size);\n321\t\n322\t        // Draw grid line\n323\t        ctx.strokeStyle = this.gridColor;\n324\t        ctx.lineWidth = 0.5;\n325\t        ctx.strokeRect(x, y, size, size);\n326\t      }\n327\t    }\n328\t  }\n329\t\n330\t  private getTerrainColor(t: Terrain): string {\n331\t    switch (t) {\n332\t      case Terrain.Grass: return this.bgColor;\n333\t      case Terrain.Rock: return '#3a3a4a';\n334\t      case Terrain.Water: return '#1a3a5a';\n335\t      case Terrain.RichSoil: return '#2a4a1a';\n336\t      case Terrain.Mountain: return '#4a4a4a';\n337\t      case Terrain.Path: return '#4a3a2a';\n338\t      case Terrain.SpiritVein: return '#2a4a5a';\n339\t      default: return this.bgColor;\n340\t    }\n341\t  }\n342\t\n343\t  // Screen coordinates to grid cell\n344\t  screenToGrid(\n345\t    screenX: number,\n346\t    screenY: number,\n347\t    offsetX: number,\n348\t    offsetY: number,\n349\t    scale: number,\n350\t  ): { gx: number; gy: number } {\n351\t    const invScale = 1 / scale;\n352\t    const gx = Math.floor((screenX - offsetX) * invScale / this.cellSize);\n353\t    const gy = Math.floor((screenY - offsetY) * invScale / this.cellSize);\n354\t    return { gx, gy };\n355\t  }\n356\t\n357\t  // Grid cell center to screen coordinates\n358\t  gridToScreen(\n359\t    gx: number,\n360\t    gy: number,\n361\t    offsetX: number,\n362\t    offsetY: number,\n363\t    scale: number,\n364\t  ): { x: number; y: number } {\n365\t    return {\n366\t      x: offsetX + (gx + 0.5) * this.cellSize * scale,\n367\t      y: offsetY + (gy + 0.5) * this.cellSize * scale,\n368\t    };\n369\t  }\n370\t}\n371\t"}]},"parent_tool_use_id":"call_a5a9e75d09cd453897e0e9b2","session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"3d458114-5e86-4b6e-b687-cd7fa56bc847","timestamp":"2026-05-23T01:53:26.576Z","subagent_type":"Explore","task_de