arSave }) => {\n          clearSave();\n          location.reload();\n        });\n        return;\n      }\n\n      app.centerCamera();\n      app.start();\n    }\n\n    // Menu buttons\n    document.getElementById('btn-continue').addEventListener('click', () => startGame(false));\n    document.getElementById('btn-new-game').addEventListener('click', () => {\n      if (isGameRunning) {\n        if (confirm('开始新游戏将清除当前进度，确定吗？')) {\n          startGame(true);\n        }\n      } else {\n        startGame(true);\n      }\n    });\n    document.getElementById('btn-settings').addEventListener('click', () => showSettings());\n    document.getElementById('btn-quit').addEventListener('click', () => {\n      if (electronAPI) {\n        electronAPI.quit();\n      } else {\n        if (confirm('确定要退出游戏吗？')) {\n          window.close();\n        }\n      }\n    });\n\n    // ==================== SETTINGS PAGE ====================\n    const settingsPage = document.getElementById('settings-page');\n    let settings = loadSettings();\n    let previousPage = 'menu'; // 'menu' or 'game'\n\n    function showSettings() {\n      previousPage = mainMenu.classList.contains('active') ? 'menu' : 'game';\n      settingsPage.classList.add('active');\n      populateSettings();\n    }\n\n    function hideSettings() {\n      settingsPage.classList.remove('active');\n    }\n\n    function populateSettings() {\n      (document.getElementById('set-master-vol') as HTMLInputElement).value = String(settings.masterVolume);\n      document.getElementById('val-master-vol').textContent = String(settings.masterVolume);\n      (document.getElementById('set-sfx-vol') as HTMLInputElement).value = String(settings.sfxVolume);\n      document.getElementById('val-sfx-vol').textContent = String(settings.sfxVolume);\n      (document.getElementById('set-music-vol') as HTMLInputElement).value = String(settings.musicVolume);\n      document.getElementById('val-music-vol').textContent = String(settings.musicVolume);\n\n      const resKey = `${settings.resolution.width}x${settings.resolution.height}`;\n      (document.getElementById('set-resolution') as HTMLSelectElement).value = resKey;\n\n      const fsBtn = document.getElementById('set-fullscreen');\n      fsBtn.classList.toggle('on', settings.fullscreen);\n\n      const fpsBtn = document.getElementById('set-showfps');\n      fpsBtn.classList.toggle('on', settings.showFPS);\n\n      (document.getElementById('set-quality') as HTMLSelectElement).value = settings.particleQuality;\n      (document.getElementById('set-autosave') as HTMLSelectElement).value = String(settings.autoSaveInterval);\n    }\n\n    // Slider bindings\n    ['master-vol', 'sfx-vol', 'music-vol'].forEach(key => {\n      const slider = document.getElementById(`set-${key}`) as HTMLInputElement;\n      const label = document.getElementById(`val-${key}`);\n      slider.addEventListener('input', () => { label.textContent = slider.value; });\n    });\n\n    // Toggle bindings\n    ['set-fullscreen', 'set-showfps'].forEach(id => {\n      document.getElementById(id).addEventListener('click', function() {\n        this.classList.toggle('on');\n      });\n    });\n\n    document.getElementById('btn-settings-cancel').addEventListener('click', hideSettings);\n    document.getElementById('btn-settings-save').addEventListener('click', () => {\n      const masterVol = parseInt((document.getElementById('set-master-vol') as HTMLInputElement).value);\n      const sfxVol = parseInt((document.getElementById('set-sfx-vol') as HTMLInputElement).value);\n      const musicVol = parseInt((document.getElementById('set-music-vol') as HTMLInputElement).value);\n      const resVal = (document.getElementById('set-resolution') as HTMLSelectElement).value.split('x');\n      const fullscreen = document.getElementById('set-fullscreen').classList.contains('on');\n      const showFPS = document.getElementById('set-showfps').classList.contains('on');\n      const quality = (document.getElementById('set-quality') as HTMLSelectElement).value;\n      const autoSave = parseInt((document.getElementById('set-autosave') as HTMLSelectElement).value);\n\n      settings = {\n        masterVolume: masterVol,\n        sfxVolume: sfxVol,\n        musicVolume: musicVol,\n        resolution: { width: parseInt(resVal[0]), height: parseInt(resVal[1]) },\n        fullscreen,\n        language: 'zh-CN',\n        autoSaveInterval: autoSave,\n        showFPS,\n        particleQuality: quality,\n      };\n      saveSettings(settings);\n\n      // Apply Electron-level settings\n      if (electronAPI) {\n        electronAPI.setFullscreen(fullscreen);\n        electronAPI.setResolution(parseInt(resVal[0]), parseInt(resVal[1]));\n      }\n\n      hideSettings();\n    });\n\n    // Settings from toolbar\n    document.getElementById('btn-settings-ingame').addEventListener('click', showSettings);\n\n    // ==================== GAME UI SETUP ====================\n    function setupGameUI() {\n      if (!app) return;\n\n      const canvas = document.getElementById('gameCanvas') as HTMLCanvasElement;\n\n      // FPS counter\n      let frameCount = 0;\n      let fpsTime = performance.now();\n      const fpsDisplay = document.getElementById('fps-display');\n      const statusText = document.getElementById('status-text');\n      const playtimeDisplay = document.getElementById('playtime');\n\n      setInterval(() => {\n        const now = performance.now();\n        const fps = Math.round(frameCount * 1000 / (now - fpsTime));\n        fpsDisplay.textContent = `FPS: ${fps}`;\n        fpsDisplay.style.display = settings.showFPS ? '' : 'none';\n        frameCount = 0;\n        fpsTime = now;\n\n        if (app) {\n          const secs = Math.floor(app.state.totalPlaytime);\n          const mins = Math.floor(secs / 60);\n          const hrs = Math.floor(mins / 60);\n          playtimeDisplay.textContent = `游玩时间: ${hrs}:${String(mins % 60).padStart(2, '0')}`;\n        }\n      }, 1000);\n\n      const origLoop = app.loop.bind(app);\n      app.loop = (now) => { frameCount++; origLoop(now); };\n\n      // === Notifications ===\n      const notifContainer = document.getElementById('notifications');\n      app.onNotification = (notif) => {\n        const el = document.createElement('div');\n        el.className = `notif ${notif.type}`;\n        el.textContent = notif.text;\n        notifContainer.appendChild(el);\n        requestAnimationFrame(() => el.classList.add('show'));\n        setTimeout(() => {\n          el.classList.remove('show');\n          setTimeout(() => el.remove(), 300);\n        }, 3000);\n      };\n\n      // === Tabs ===\n      document.querySelectorAll('.tab-btn').forEach(btn => {\n        btn.addEventListener('click', () => {\n          document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\n          document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));\n          btn.classList.add('active');\n          document.getElementById(`tab-${(btn as HTMLElement).dataset.tab}`).classList.add('active');\n        });\n      });\n\n      // === Building sidebar ===\n      const buildingList = document.getElementById('building-list');\n      const placementHint = document.getElementById('placement-hint');\n\n      function renderBuildingList() {\n        buildingList.innerHTML = '';\n        let available = app!.getAvailableBuildings();\n        if (buildingCategoryFilter !== 'all') {\n          available = available.filter(d => d.category === buildingCategoryFilter);\n        }\n        for (const def of available) {\n          const item = document.createElement('div');\n          item.className = 'building-item';\n          if (app!.placementMode?.id === def.id) item.classList.add('selected');\n","numLines":200,"startLine":730,"totalLines":1261}}}
