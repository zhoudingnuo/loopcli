ridY: number,\n53\t  name: string,\n54\t  condition: TalismanCondition,\n55\t  action: TalismanAction,\n56\t): TalismanInstance {\n57\t  return {\n58\t    uid,\n59\t    gridX,\n60\t    gridY,\n61\t    name,\n62\t    condition,\n63\t    action,\n64\t    enabled: true,\n65\t    cooldown: 5000,\n66\t    lastTriggered: 0,\n67\t  };\n68\t}\n69\t\n70\t// Process all talismans and return triggered actions\n71\texport function processTalismans(\n72\t  talismans: TalismanInstance[],\n73\t  resources: Record<string, number>,\n74\t  buildingCounts: Record<string, number>,\n75\t  realmLevel: number,\n76\t  now: number,\n77\t): { talismans: TalismanInstance[]; actions: TalismanAction[] } {\n78\t  const updated: TalismanInstance[] = [];\n79\t  const actions: TalismanAction[] = [];\n80\t\n81\t  for (const t of talismans) {\n82\t    if (!t.enabled) {\n83\t      updated.push(t);\n84\t      continue;\n85\t    }\n86\t\n87\t    if (now - t.lastTriggered < t.cooldown) {\n88\t      updated.push(t);\n89\t      continue;\n90\t    }\n91\t\n92\t    const triggered = evaluateCondition(t.condition, resources, buildingCounts, realmLevel);\n93\t\n94\t    if (triggered) {\n95\t      actions.push(t.action);\n96\t      updated.push({ ...t, lastTriggered: now });\n97\t    } else {\n98\t      updated.push(t);\n99\t    }\n100\t  }\n101\t\n102\t  return { talismans: updated, actions };\n103\t}\n104\t\n105\t// Preset talisman templates\n106\texport const TALISMAN_PRESETS: Array<{\n107\t  id: string;\n108\t  name: string;\n109\t  description: string;\n110\t  condition: TalismanCondition;\n111\t  action: TalismanAction;\n112\t}> = [\n113\t  {\n114\t    id: 'auto_stop_field',\n115\t    name: '灵田自停符',\n116\t    description: '灵草超过50时停止灵田',\n117\t    condition: { type: 'resource_above', resource: 'spirit_grass', threshold: 50 },\n118\t    action: { type: 'notify', message: '灵草充足，灵田已暂停' },\n119\t  },\n120\t  {\n121\t    id: 'auto_stop_miner',\n122\t    name: '矿机自停符',\n123\t    description: '灵石超过200时停止矿机',\n124\t    condition: { type: 'resource_above', resource: 'spirit_stone', threshold: 200 },\n125\t    action: { type: 'notify', message: '灵石充足，矿机已暂停' },\n126\t  },\n127\t  {\n128\t    id: 'speed_boost',\n129\t    name: '加速灵符',\n130\t    description: '修为达到要求时加速生产',\n131\t    condition: { type: 'realm_level_above', level: 15 },\n132\t    action: { type: 'notify', message: '灵符激活，生产加速！' },\n133\t  },\n134\t];\n135\t\n136\t// Render a talisman on canvas\n137\texport function renderTalisman(\n138\t  ctx: CanvasRenderingContext2D,\n139\t  talisman: TalismanInstance,\n140\t  offsetX: number,\n141\t  offsetY: number,\n142\t  scale: number,\n143\t  cellSize: number,\n144\t  now: number,\n145\t): void {\n146\t  const x = offsetX + talisman.gridX * cellSize * scale;\n147\t  const y = offsetY + talisman.gridY * cellSize * scale;\n148\t  const s = cellSize * scale;\n149\t\n150\t  // Scroll background\n151\t  ctx.fillStyle = talisman.enabled ? 'rgba(200,180,100,0.3)' : 'rgba(100,100,100,0.3)';\n152\t  ctx.fillRect(x + 2, y + 2, s - 4, s - 4);\n153\t\n154\t  // Scroll icon\n155\t  ctx.fillStyle = talisman.enabled ? '#ffd700' : '#666';\n156\t  ctx.font = `${Math.max(10, Math.floor(14 * scale))}px serif`;\n157\t  ctx.textAlign = 'center';\n158\t  ctx.textBaseline = 'middle';\n159\t  ctx.fillText('📜', x + s / 2, y + s / 2);\n160\t\n161\t  // Active glow\n162\t  if (talisman.enabled && now - talisman.lastTriggered < 1000) {\n163\t    ctx.fillStyle = 'rgba(255,215,0,0.2)';\n164\t    ctx.fillRect(x + 2, y + 2, s - 4, s - 4);\n165\t  }\n166\t}\n167\t"}]},"parent_tool_use_id":null,"session_id":"094f9230-fe12-4466-ab83-fdd0d233a191","uuid":"ad84477a-caf7-48dc-960f-6ca79a6f886e","timestamp":"2026-05-23T02:55:11.668Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/steam-cultivation-factory/src/game/Talisman.ts","content":"// Talisman.ts — 基础灵符条件触发系统\n\nexport type TalismanCondition =\n  | { type: 'resource_above'; resource: string; threshold: number }\n  | { type: 'resource_below'; resource: string; threshold: number }\n  | { type: 'building_count_above'; buildingId: string; threshold: number }\n  | { type: 'realm_level_above'; level: number };\n\nexport type TalismanAction =\n  | { type: 'stop_building'; buildingUid: string }\n  | { type: 'start_building'; buildingUid: string }\n  | { type: 'set_production_rate'; buildingUid: string; multiplier: number }\n  | { type: 'notify'; message: string };\n\nexport interface TalismanInstance {\n  uid: string;\n  gridX: number;\n  gridY: number;\n  name: string;\n  condition: TalismanCondition;\n  action: TalismanAction;\n  enabled: boolean;\n  /** Cooldown between triggers (ms) */\n  cooldown: number;\n  /** Last trigger time */\n  lastTriggered: number;\n}\n\n// Evaluate a condition against current game state\nexport function evaluateCondition(\n  condition: TalismanCondition,\n  resources: Record<string, number>,\n  buildingCounts: Record<string, number>,\n  realmLevel: number,\n): boolean {\n  switch (condition.type) {\n    case 'resource_above':\n      return (resources[condition.resource] ?? 0) > condition.threshold;\n    case 'resource_below':\n      return (resources[condition.resource] ?? 0) < condition.threshold;\n    case 'building_count_above':\n      return (buildingCounts[condition.buildingId] ?? 0) > condition.threshold;\n    case 'realm_level_above':\n      return realmLevel >= condition.level;\n  }\n}\n\n// Create a talisman instance\nexport function createTalisman(\n  uid: string,\n  gridX: number,\n  gridY: number,\n  name: string,\n  condition: TalismanCondition,\n  action: TalismanAction,\n): TalismanInstance {\n  return {\n    uid,\n    gridX,\n    gridY,\n    name,\n    condition,\n    action,\n    enabled: true,\n    cooldown: 5000,\n    lastTriggered: 0,\n  };\n}\n\n// Process all talismans and return triggered actions\nexport function processTalismans(\n  talismans: TalismanInstance[],\n  resources: Record<string, number>,\n  buildingCounts: Record<string, number>,\n  realmLevel: number,\n  now: number,\n): { talismans: TalismanInstance[]; actions: TalismanAction[] } {\n  const updated: TalismanInstance[] = [];\n  const actions: TalismanAction[] = [];\n\n  for (const t of talismans) {\n    if (!t.enabled) {\n      updated.push(t);\n      continue;\n    }\n\n    if (now - t.lastTriggered < t.cooldown) {\n      updated.push(t);\n      continue;\n    }\n\n    const triggered = evaluateCondition(t.condition, resources, buildingCounts, realmLevel);\n\n    if (triggered) {\n      actions.push(t.action);\n      updated.push({ ...t, lastTriggered: now });\n    } else {\n      updated.push(t);\n    }\n  }\n\n  return { talismans: updated, actions };\n}\n\n// Preset talisman templates\nexport const TALISMAN_PRESETS: Array<{\n  id: string;\n  name: string;\n  description: string;\n  condition: TalismanCondition;\n  action: TalismanAction;\n}> = [\n  {\n    id: 'auto_stop_field',\n    name: '灵田自停符',\n    description: '灵草超过50时停止灵田',\n    condition: { type: 'resource_above', resource: 'spirit_grass', threshold: 50 },\n    action: { type: 'notify', message: '灵草充足，灵田已暂停' },\n  },\n  {\n    id: 'auto_stop_miner',\n    name: '矿机自停符',\n    description: '灵石超过200时停止矿机',\n    condition: { type: 'resource_above', resource: 'spirit_stone', threshold: 200 },\n    action: { type: 'notify', message: '灵石充足，矿机已暂停' },\n  },\n  {\n    id: 'speed_boost',\n    name: '加速灵符',\n    description: '修为达到要求时加速生产',\n    condition: { type: 'realm_level_above', level: 15 },\n    action: { type: 'notify', message: '灵符激活，生产加速！' },\n  },\n];\n\n// Render a talisman on canvas\nexport function renderTalisman(\n  ctx: CanvasRenderingContext2D,\n  talisman: TalismanInstance,\n  offsetX: number,\n  offsetY: number,\n  scale: number,\n  cellSize: number,\n  now: number,\n): void {\n  const x = offsetX + talisman.gridX * cellSize * scale;\n  const y = offsetY + talisman.gridY * cellSize * scale;\n  const s = cellSize * scale;\n\n  // Scroll background\n  ctx.fillStyle = talisman.enabled ? 'rgba(200,180,100,0.3)' : 'rgba(100,100,100,0.3)';\n  ctx.fillRect(x + 2, y + 2, s - 4, s - 4);\n\n  // Scroll icon\n  ctx.fillStyle = talisman.enabled ? '#ffd700' : '#666';\n  ctx.font = `${Math.max(10, Math.floor(14 * scale))}px serif`;\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n  ctx.fillText('📜', x + s / 2, y + s / 2);\n\n  // Active glow\n  if (talisman.enabled && now - talisman.lastTriggered < 1000) {\n    ctx.fillStyle = 'rgba(255,215,0,0.2)';\n    ctx.fillRect(x + 2, y + 2, s - 4, s - 4);\n  }\n}\n","numLines":167,"startLine":1,"totalLines":167}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_26d2fd18db4a448c9b0bb669","type":"tool_result","content":"1\t<!DOCTYPE html>\n2\t<html lang=\"zh-CN\">\n3\t<head>\n4\t  <meta charset=\"UTF-8\">\n5\t  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n6\t  <title>修仙自动化工厂 — Cultivation Factory</title>\n7\t  <style>\n8\t    * { margin: 0; padding: 0; box-sizing: border-box; }\n9\t    body {\n10\t      background: #1a1a2e;\n11\t      color: #e0e0e0;\n12\t      font-family: 'Segoe UI', system-ui, monospace;\n13\t      overflow: hidden;\n14\t      height: 100vh;\n15\t      width: 100vw;\n16\t    }\n17\t\n18\t    /* ==================== LOADING SCREEN ==================== */\n19\t    #loading-screen {\n20\t      position: fixed; top: 0; left: 0; width: 100%; height: 100%;\n21\t      background: radial-gradient(ellipse at center, #1e2a4a 0%, #0a0e1a 100%);\n22\t      display: flex; flex-direction: column; align-items: center; justify-content: center;\n23\t      z-index: 1000; transition: opacity 0.8s ease;\n24\t    }\n25\t    #loading-screen.fade-out { opacity: 0; pointer-events: none; }\n26\t    .loading-title {\n27\t      font-size: 36px; color: #ffd700;\n28\t      text-shadow: 0 0 20px rgba(255,215,0,0.5), 0 0 60px rgba(255,215,0,0.2);\n29\t      margin-bottom: 8px; letter-spacing: 4px;\n30\t      animation: titlePulse 3s ease-in-out infinite;\n31\t    }\n32\t    @keyframes titlePulse {\n33\t      0%, 100% { text-shadow: 0 0 20px rgba(255,215,0,0.5), 0 0 60px rgba(255,215,0,0.2); }\n34\t      50% { text-shadow: 0 0 30px rgba(255,215,0,0.8), 0 0 80px rgba(255,215,0,0.4); }\n35\t    }\n36\t    .loading-subtitle { font-size: 14px; color: #888; margin-bottom: 40px; letter-spacing: 2px; }\n37\t    .loading-bar-container {\n38\t      width: 320px; height: 4px; background: rgba(255,255,255,0.1);\n39\t      border-radius: 2px; overflow: hidden; margin-bottom: 16px;\n40\t    }\n41\t    .loading-bar-fill {\n42\t      height: 100%; width: 0%; border-radius: 2px;\n43\t      background: linear-gradient(90deg, #ffd700, #ff8c00);\n44\t      transition: width 0.3s ease;\n45\t    }\n46\t    .loading-text { font-size: 12px; color: #666; }\n47\t    .loading-particles {\n48\t      position: absolute; width: 100%; height: 100%; pointer-events: none;\n49\t    }\n50\t\n51\t    /* ==================== MAIN MENU ==================== */\n52\t    #main-menu {\n53\t      position: fixed; top: 0; left: 0; width: 100%; height: 100%;\n54\t      background: radial-gradient(ellipse at center, #1e2a4a 0%, #0a0e1a 100%);\n55\t      display: none; flex-direction: column; align-items: center; justify-content: center;\n56\t      z-index: 900;\n57\t    }\n58\t    #main-menu.active { display: flex; }\n59\t    .menu-bg {\n60\t      position: absolute; width: 100%; height: 100%;\n61\t      background-image:\n62\t        radial-gradient(2px 2px at 20% 30%, rgba(255,215,0,0.3), transparent),\n63\t        radial-gradient(2px 2px at 40% 70%, rgba(100,200,255,0.2), transparent),\n64\t        radial-gradient(1px 1px at 60% 20%, rgba(255,255,255,0.3), transparent),\n65\t        radial-gradient(1px 1px at 80% 60%, rgba(255,200,50,0.2), transparent),\n66\t        radial-gradient(2px 2px at 10% 80%, rgba(200,150,255,0.2), transparent),\n67\t        radial-gradient(1px 1px at 70% 40%, rgba(255,255,255,0.2), transparent),\n68\t        radial-gradient(1px 1px at 90% 90%, rgba(255,215,0,0.2), transparent);\n69\t      animation: starDrift 60s linear infinite;\n70\t    }\n71\t    @keyframes starDrift { from { transform: translateY(0); } to { transform: translateY(-20px); } }\n72\t\n73\t    .menu-content { position: relative; z-index: 1; text-align: center; }\n74\t    .menu-logo {\n75\t      font-size: 48px; color: #ffd700; margin-bottom: 4px;\n76\t      text-shadow: 0 0 30px rgba(255,215,0,0.6), 0 0 60px rgba(255,215,0,0.3);\n77\t      letter-spacing: 6px;\n78\t    }\n79\t    .menu-version { font-size: 12px; color: #555; margin-bottom: 48px; }\n80\t    .menu-buttons { display: flex; flex-direction: column; gap: 12px; width: 280px; margin: 0 auto; }\n81\t    .menu-btn {\n82\t      background: rgba(255,255,255,0.05);\n83\t      border: 1px solid rgba(255,215,0,0.3);\n84\t      color: #ffd700; padding: 14px 24px; border-radius: 6px;\n85\t      cursor: pointer; font-size: 16px; letter-spacing: 2px;\n86\t      transition: all 0.3s ease; font-family: inherit;\n87\t    }\n88\t    .menu-btn:hover {\n89\t      background: rgba(255,215,0,0.1);\n90\t      border-color: rgba(255,215,0,0.6);\n91\t      text-shadow: 0 0 10px rgba(255,215,0,0.5);\n92\t      transform: translateY(-1px);\n93\t    }\n94\t    .menu-btn:active { transform: translateY(0); }\n95\t    .menu-btn.primary {\n96\t      background: linear-gradient(135deg, rgba(255,215,0,0.15), rgba(255,140,0,0.15));\n97\t      border-color: rgba(255,215,0,0.5);\n98\t    }\n99\t    .menu-btn.primary:hover {\n100\t      background: linear-gradient(135deg, rgba(255,215,0,0.25), rgba(255,140,0,0.25));\n101\t    }\n102\t    .menu-footer { margin-top: 40px; font-size: 11px; color: #444; }\n103\t    .menu-footer .steam-status { color: #6a6; }\n104\t    .menu-footer .steam-status.offline { color: #666; }\n105\t\n106\t    /* ==================== SETTINGS PAGE ==================== */\n107\t    #settings-page {\n108\t      position: fixed; top: 0; left: 0; width: 100%; height: 100%;\n109\t      background: rgba(0,0,0,0.85); backdrop-filter: blur(8px);\n110\t      display: none; align-items: center; justify-content: center;\n111\t      z-index: 950;\n112\t    }\n113\t    #settings-page.active { display: flex; }\n114\t    .settings-panel {\n115\t      background: linear-gradient(145deg, #1a2040, #141830);\n116\t      border: 1px solid rgba(255,215,0,0.2);\n117\t      border-radius: 12px; padding: 32px; width: 480px; max-height: 80vh;\n118\t      overflow-y: auto;\n119\t    }\n120\t    .settings-title {\n121\t      font-size: 22px; color: #ffd700; margin-bottom: 24px;\n122\t      text-align: center; letter-spacing: 2px;\n123\t    }\n124\t    .settings-group {\n125\t      margin-bottom: 20px; padding-bottom: 16px;\n126\t      border-bottom: 1px solid rgba(255,255,255,0.06);\n127\t    }\n128\t    .settings-group:last-child { border-bottom: none; margin-bottom: 0; }\n129\t    .settings-group-label {\n130\t      font-size: 11px; color: #888; text-transform: uppercase;\n131\t      margin-bottom: 12px; letter-spacing: 1px;\n132\t    }\n133\t    .setting-row {\n134\t      display: flex; align-items: center; justify-content: space-between;\n135\t      padding: 8px 0; gap: 16px;\n136\t    }\n137\t    .setting-label { font-size: 13px; color: #ccc; flex-shrink: 0; min-width: 80px; }\n138\t    .setting-value { font-size: 12px; color: #888; min-width: 40px; text-align: right; }\n139\t    .setting-slider {\n140\t      flex: 1; -webkit-appearance: none; height: 4px;\n141\t      background: rgba(255,255,255,0.1); border-radius: 2px; outline: none;\n142\t    }\n143\t    .setting-slider::-webkit-slider-thumb {\n144\t      -webkit-appearance: none; width: 14px; height: 14px;\n145\t      background: #ffd700; border-radius: 50%; cursor: pointer;\n146\t    }\n147\t    .setting-select {\n148\t      flex: 1; background: rgba(255,255,255,0.05);\n149\t      border: 1px solid rgba(255,255,255,0.15);\n150\t      color: #e0e0e0; padding: 6px 12px; border-radius: 4px;\n151\t      font-size: 13px; font-family: inherit; cursor: pointer;\n152\t    }\n153\t    .setting-select option { background: #1a2040; }\n154\t    .setting-toggle {\n155\t      width: 44px; height: 24px; background: rgba(255,255,255,0.1);\n156\t      border-radius: 12px; cursor: pointer; position: relative;\n157\t      border: none; transition: background 0.2s;\n158\t    }\n159\t    .setting-toggle.on { background: rgba(255,215,0,0.4); }\n160\t    .setting-toggle::after {\n161\t      content: ''; position: absolute; top: 3px; left: 3px;\n162\t      width: 18px; height: 18px; background: #e0e0e0;\n163\t      border-radius: 50%; transition: transform 0.2s;\n164\t    }\n165\t    .setting-toggle.on::after { transform: translateX(20px); background: #ffd700; }\n166\t    .settings-actions {\n167\t      display: flex; gap: 12px; margin-top: 24px; justify-content: center;\n168\t    }\n169\t    .settings-btn {\n170\t      background: rgba(255,255,255,0.05);\n171\t      border: 1px solid rgba(255,255,255,0.15);\n172\t      color: #e0e0e0; padding: 8px 24px; border-radius: 4px;\n173\t      cursor: pointer; font-size: 13px; font-family: inherit;\n174\t      transition: background 0.2s;\n175\t    }\n176\t    .settings-btn:hover { background: rgba(255,255,255,0.1); }\n177\t    .settings-btn.save {\n178\t      background: rgba(255,215,0,0.15); border-color: rgba(255,215,0,0.3);\n179\t      color: #ffd700;\n180\t    }\n181\t    .settings-btn.save:hover { background: rgba(255,215,0,0.25); }\n182\t\n183\t    /* ==================== GAME UI ==================== */\n184\t    #game-ui { display: none; }\n185\t    #game-ui.active { display: flex; flex-direction: column; height: 100vh; }\n186\t\n187\t    /* Toolbar */\n188\t    #toolbar {\n189\t      display: flex; align-items: center; gap: 8px;\n190\t      padding: 6px 12px;\n191\t      background: linear-gradient(180deg, rgba(20,24,48,0.95), rgba(10,14,26,0.95));\n192\t      border-bottom: 1px solid rgba(255,215,0,0.15);\n193\t      min-height: 44px; flex-shrink: 0;\n194\t    }\n195\t    #toolbar h1 { font-size: 15px; color: #ffd700; margin-right: 12px; white-space: nowrap; text-shadow: 0 0 8px rgba(255,215,0,0.3); }\n196\t    #toolbar .spacer { flex: 1; }\n197\t    .toolbar-btn {\n198\t      background: rgba(255,255,255,0.05);\n199\t      border: 1px solid rgba(255,255,255,0.1);\n200\t      color: #e0e0e0; padding: 4px 12px; border-radius: 4px;\n201\t      cursor: pointer; font-size: 12px; transition: all 0.2s;\n202\t    }\n203\t    .toolbar-btn:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,215,0,0.3); }\n204\t    .toolbar-btn.active { background: rgba(100,200,100,0.2); border-color: rgba(100,200,100,0.4); }\n205\t\n206\t    /* Main layout */\n207\t    #main { display: flex; flex: 1; overflow: hidden; }\n208\t\n209\t    /* Sidebar */\n210\t    #sidebar {\n211\t      width: 220px;\n212\t      background: linear-gradient(180deg, rgba(20,24,48,0.9), rgba(15,18,35,0.95));\n213\t      border-right: 1px solid rgba(255,215,0,0.1);\n214\t      overflow-y: auto; flex-shrink: 0;\n215\t      display: flex; flex-direction: column;\n216\t    }\n217\t    .sidebar-section {\n218\t      padding: 8px;\n219\t      border-bottom: 1px solid rgba(255,255,255,0.04);\n220\t    }\n221\t    .sidebar-section h3 {\n222\t      font-size: 11px; color: #ffd700; opacity: 0.7;\n223\t      margin-bottom: 6px; letter-spacing: 1px;\n224\t    }\n225\t    .building-item {\n226\t      display: flex; align-items: center; gap: 8px;\n227\t      padding: 6px 8px; margin: 2px 0; border-radius: 4px;\n228\t      cursor: pointer; transition: all 0.2s; font-size: 12px;\n229\t      border: 1px solid transparent;\n230\t    }\n231\t    .building-item:hover { background: rgba(255,215,0,0.05); border-color: rgba(255,215,0,0.1); }\n232\t    .building-item.selected { background: rgba(100,200,100,0.15); border-color: rgba(100,200,100,0.3); }\n233\t    .building-item .icon { font-size: 18px; }\n234\t    .building-item .info { flex: 1; }\n235\t    .building-item .name { color: #e0e0e0; }\n236\t    .building-item .cost { color: #777; font-size: 10px; }\n237\t    .building-item .cost.cannot { color: #c44; }\n238\t\n239\t    /* Canvas */\n240\t    #canvas-container { flex: 1; position: relative; }\n241\t    #gameCanvas { display: block; width: 100%; height: 100%; }\n242\t\n243\t    /* Info panel */\n244\t    #info-panel {\n245\t      width: 240px;\n246\t      background: linear-gradient(180deg, rgba(20,24,48,0.9), rgba(15,18,35,0.95));\n247\t      border-left: 1px solid rgba(255,215,0,0.1);\n248\t      overflow-y: auto; flex-shrink: 0; padding: 8px;\n249\t      display: flex; flex-direction: column; gap: 8px;\n250\t    }\n251\t    #info-panel h3 { font-size: 11px; color: #888; margin-bottom: 4px; }\n252\t    .info-entry { font-size: 11px; padding: 3px 0; color: #ccc; }\n253\t\n254\t    /* Realm panel */\n255\t    .realm-panel {\n256\t      background: rgba(255,215,0,0.03);\n257\t      border: 1px solid rgba(255,215,0,0.15);\n258\t      border-radius: 8px; padding: 10px;\n259\t    }\n260\t    .realm-panel .realm-name {\n261\t      color: #ffd700; font-weight: bold; font-size: 15px;\n262\t      text-shadow: 0 0 6px rgba(255,215,0,0.3);\n263\t    }\n264\t    .realm-panel .realm-exp-bar {\n265\t      background: rgba(255,255,255,0.08);\n266\t      border-radius: 4px; height: 16px;\n267\t      margin: 6px 0; position: relative; overflow: hidden;\n268\t    }\n269\t    .realm-panel .realm-exp-fill {\n270\t      background: linear-gradient(90deg, #ffd700, #ff8c00);\n271\t      height: 100%; border-radius: 4px; transition: width 0.3s;\n272\t      box-shadow: 0 0 8px rgba(255,215,0,0.3);\n273\t    }\n274\t    .realm-panel .realm-exp-text {\n275\t      position: absolute; top: 0; left: 50%; transform: translateX(-50%);\n276\t      font-size: 9px; color: #fff; line-height: 16px;\n277\t    }\n278\t    .breakthrough-btn {\n279\t      background: linear-gradient(135deg, #ffd700, #ff8c00);\n280\t      border: none; color: #1a1a2e; font-weight: bold;\n281\t      padding: 6px 12px; border-radius: 6px; cursor: pointer;\n282\t      font-size: 12px; width: 100%; margin-top: 6px;\n283\t      transition: all 0.2s; letter-spacing: 1px;\n284\t    }\n285\t    .breakthrough-btn:hover { opacity: 0.9; box-shadow: 0 0 12px rgba(255,215,0,0.4); }\n286\t    .breakthrough-btn:disabled {\n287\t      background: rgba(255,255,255,0.08); color: #555;\n288\t      cursor: not-allowed; box-shadow: none;\n289\t    }\n290\t    .breakthrough-req { font-size: 10px; color: #777; padding: 2px 0; }\n291\t    .breakthrough-req.met { color: #6c6; }\n292\t    .breakthrough-req.unmet { color: #c44; }\n293\t\n294\t    /* Inventory panel */\n295\t    .inventory-panel {\n296\t      background: rgba(255,255,255,0.02);\n297\t      border: 1px solid rgba(255,255,255,0.08);\n298\t      border-radius: 8px; padding: 8px;\n299\t    }\n300\t    .pill-item {\n301\t      display: flex; align-items: center; gap: 6px;\n302\t      padding: 4px 0; font-size: 11px;\n303\t    }\n304\t    .pill-item .pill-name { flex: 1; }\n305\t    .pill-item .pill-count { color: #888; }\n306\t    .pill-use-btn {\n307\t      background: rgba(100,200,100,0.15);\n308\t      border: 1px solid rgba(100,200,100,0.25);\n309\t      color: #6c6; padding: 2px 8px; border-radius: 3px;\n310\t      cursor: pointer; font-size: 10px; transition: background 0.2s;\n311\t    }\n312\t    .pill-use-btn:hover { background: rgba(100,200,100,0.25); }\n313\t    .pill-use-all-btn {\n314\t      background: rgba(255,200,50,0.15);\n315\t      border: 1px solid rgba(255,200,50,0.25);\n316\t      color: #ffd700; padding: 2px 6px; border-radius: 3px;\n317\t      cursor: pointer; font-size: 10px;\n318\t    }\n319\t\n320\t    /* Alchemy panel */\n321\t    .alchemy-panel {\n322\t      background: rgba(255,140,50,0.03);\n323\t      border: 1px solid rgba(255,140,50,0.15);\n324\t      border-radius: 8px; padding: 8px;\n325\t    }\n326\t    .recipe-item {\n327\t      display: flex; align-items: center; gap: 6px;\n328\t      padding: 4px 0; font-size: 11px;\n329\t    }\n330\t    .recipe-item .recipe-name { flex: 1; }\n331\t    .recipe-craft-btn {\n332\t      background: rgba(255,140,50,0.15);\n333\t      border: 1px solid rgba(255,140,50,0.25);\n334\t      color: #ff8c32; padding: 2px 8px; border-radius: 3px;\n335\t      cursor: pointer; font-size: 10px; transition: background 0.2s;\n336\t    }\n337\t    .recipe-craft-btn:hover { background: rgba(255,140,50,0.25); }\n338\t    .recipe-craft-btn:disabled { opacity: 0.4; cursor: not-allowed; }\n339\t    .alchemy-progress {\n340\t      background: rgba(255,255,255,0.08);\n341\t      border-radius: 4px; height: 14px;\n342\t      margin: 6px 0; position: relative; overflow: hidden;\n343\t    }\n344\t    .alchemy-progress-fill {\n345\t      background: linear-gradient(90deg, #ff8c32, #ffaa00);\n346\t      height: 100%; border-radius: 4px; transition: width 0.3s;\n347\t      box-shadow: 0 0 6px rgba(255,140,50,0.3);\n348\t    }\n349\t    .alchemy-progress-text {\n350\t      position: absolute; top: 0; left: 50%; transform: translateX(-50%);\n351\t      font-size: 9px; color: #fff; line-height: 14px;\n352\t    }\n353\t    .alchemy-collect-btn {\n354\t      background: linear-gradient(135deg, #ff8c32, #ffaa00);\n355\t      border: none; color: #1a1a2e; font-weight: bold;\n356\t      padding: 6px 12px; border-radius: 4px; cursor: pointer;\n357\t      font-size: 11px; width: 100%; letter-spacing: 1px;\n358\t    }\n359\t\n360\t    /* Notifications */\n361\t    #notifications {\n362\t      position: absolute; top: 56px; right: 12px;\n363\t      display: flex; flex-direction: column; gap: 4px;\n364\t      pointer-events: none; z-index: 10;\n365\t    }\n366\t    .notif {\n367\t      padding: 8px 14px; border-radius: 6px;\n368\t      font-size: 11px; opacity: 0; transition: opacity 0.3s;\n369\t      pointer-events: auto; backdrop-filter: blur(4px);\n370\t    }\n371\t    .notif.show { opacity: 1; }\n372\t    .notif.info { background: rgba(100,100,255,0.2); border: 1px solid rgba(100,100,255,0.3); }\n373\t    .notif.success { background: rgba(100,200,100,0.2); border: 1px solid rgba(100,200,100,0.3); }\n374\t    .notif.warning { background: rgba(255,200,50,0.2); border: 1px solid rgba(255,200,50,0.3); }\n375\t    .notif.error { background: rgba(200,100,100,0.2); border: 1px solid rgba(200,100,100,0.3); }\n376\t\n377\t    /* Status bar */\n378\t    #statusbar {\n379\t      display: flex; align-items: center; gap: 12px;\n380\t      padding: 4px 12px;\n381\t      background: linear-gradient(0deg, rgba(10,14,26,0.95), rgba(20,24,48,0.95));\n382\t      border-top: 1px solid rgba(255,215,0,0.1);\n383\t      font-size: 11px; color: #666;\n384\t      min-height: 28px; flex-shrink: 0;\n385\t    }\n386\t    #statusbar .fps { color: #6a6; }\n387\t\n388\t    #placement-hint {\n389\t      position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%);\n390\t      background: rgba(0,0,0,0.85); color: #ffd700;\n391\t      padding: 8px 20px; border-radius: 6px; font-size: 12px;\n392\t      pointer-events: none; display: none;\n393\t      border: 1px solid rgba(255,215,0,0.2);\n394\t    }\n395\t\n396\t    /* Region navigation */\n397\t    .region-nav { display: flex; flex-wrap: wrap; gap: 4px; padding: 4px 0; }\n398\t    .region-btn {\n399\t      background: rgba(255,255,255,0.03);\n400\t      border: 1px solid rgba(255,255,255,0.08);\n401\t      color: #999; padding: 3px 8px; border-radius: 3px;\n402\t      cursor: pointer; font-size: 10px; transition: all 0.2s;\n403\t    }\n404\t    .region-btn:hover { background: rgba(255,215,0,0.05); border-color: rgba(255,215,0,0.2); }\n405\t    .region-btn.active { background: rgba(100,200,100,0.15); border-color: rgba(100,200,100,0.3); color: #6c6; }\n406\t    .region-btn.locked { opacity: 0.4; cursor: not-allowed; }\n407\t\n408\t    /* Building category tabs */\n409\t    .building-tabs { display: flex; gap: 2px; margin-bottom: 4px; }\n410\t    .building-tab {\n411\t      flex: 1; background: rgba(255,255,255,0.02);\n412\t      border: 1px solid rgba(255,255,255,0.06);\n413\t      color: #555; padding: 3px 0; border-radius: 3px;\n414\t      cursor: pointer; font-size: 9px; text-align: center;\n415\t      transition: all 0.2s;\n416\t    }\n417\t    .building-tab.active { background: rgba(255,215,0,0.08); color: #e0e0e0; border-color: rgba(255,215,0,0.2); }\n418\t\n419\t    /* Scrollbar */\n420\t    ::-webkit-scrollbar { width: 5px; }\n421\t    ::-webkit-scrollbar-track { background: transparent; }\n422\t    ::-webkit-scrollbar-thumb { background: rgba(255,215,0,0.15); border-radius: 3px; }\n423\t    ::-webkit-scrollbar-thumb:hover { background: rgba(255,215,0,0.3); }\n424\t\n425\t    /* Tab buttons for info panel */\n426\t    .tab-bar { display: flex; gap: 4px; margin-bottom: 4px; }\n427\t    .tab-btn {\n428\t      flex: 1; background: rgba(255,255,255,0.03);\n429\t      border: 1px solid rgba(255,255,255,0.08);\n430\t      color: #666; padding: 4px 0; border-radius: 3px;\n431\t      cursor: pointer; font-size: 10px; text-align: center;\n432\t      transition: all 0.2s;\n433\t    }\n434\t    .tab-btn.active { background: rgba(255,255,255,0.08); color: #e0e0e0; border-color: rgba(255,215,0,0.2); }\n435\t    .tab-content { display: none; }\n436\t    .tab-content.active { display: block; }\n437\t  </style>\n438\t</head>\n439\t<body>\n440\t\n441\t  <!-- ========== LOADING SCREEN ========== -->\n442\t  <div id=\"loading-screen\">\n443\t    <canvas id=\"loading-particles\" class=\"loading-particles\"></canvas>\n444\t    <div class=\"loading-title\">修仙自动化工厂</div>\n445\t    <div class=\"loading-subtitle\">CULTIVATION FACTORY</div>\n446\t    <div class=\"loading-bar-container\">\n447\t      <div class=\"loading-bar-fill\" id=\"loading-fill\"></div>\n448\t    </div>\n449\t    <div class=\"loading-text\" id=\"loading-text\">正在加载资源...</div>\n450\t  </div>\n451\t\n452\t  <!-- ========== MAIN MENU ========== -->\n453\t  <div id=\"main-menu\">\n454\t    <div class=\"menu-bg\"></div>\n455\t    <div class=\"menu-content\">\n456\t      <div class=\"menu-logo\">⛰ 修仙工厂</div>\n457\t      <div class=\"menu-version\" id=\"menu-version\">v0.5.0</div>\n458\t      <div class=\"menu-buttons\">\n459\t        <button class=\"menu-btn primary\" id=\"btn-continue\">继续修炼</button>\n460\t        <button class=\"menu-btn\" id=\"btn-new-game\">新的旅程</button>\n461\t        <button class=\"menu-btn\" id=\"btn-settings\">⚙ 系统设置</button>\n462\t        <button class=\"menu-btn\" id=\"btn-quit\">退出游戏</button>\n463\t      </div>\n464\t      <div class=\"menu-footer\">\n465\t        <span class=\"steam-status\" id=\"steam-status\"></span>\n466\t      </div>\n467\t    </div>\n468\t  </div>\n469\t\n470\t  <!-- ========== SETTINGS PAGE ========== -->\n471\t  <div id=\"settings-page\">\n472\t    <div class=\"settings-panel\">\n473\t      <div class=\"settings-title\">⚙ 系统设置</div>\n474\t\n475\t      <div class=\"settings-group\">\n476\t        <div class=\"settings-group-label\">🔊 音频</div>\n477\t        <div class=\"setting-row\">\n478\t          <span class=\"setting-label\">主音量</span>\n479\t          <input type=\"range\" class=\"setting-slider\" id=\"set-master-vol\" min=\"0\" max=\"100\" value=\"80\">\n480\t          <span class=\"setting-value\" id=\"val-master-vol\">80</span>\n481\t        </div>\n482\t        <div class=\"setting-row\">\n483\t          <span class=\"setting-label\">音效</span>\n484\t          <input type=\"range\" class=\"setting-slider\" id=\"set-sfx-vol\" min=\"0\" max=\"100\" value=\"100\">\n485\t          <span class=\"setting-value\" id=\"val-sfx-vol\">100</span>\n486\t        </div>\n487\t        <div class=\"setting-row\">\n488\t          <span class=\"setting-label\">音乐</span>\n489\t          <input type=\"range\" class=\"setting-slider\" id=\"set-music-vol\" min=\"0\" max=\"100\" value=\"70\">\n490\t          <span class=\"setting-value\" id=\"val-music-vol\">70</span>\n491\t        </div>\n492\t      </div>\n493\t\n494\t      <div class=\"settings-group\">\n495\t        <div class=\"settings-group-label\">🖥 显示</div>\n496\t        <div class=\"setting-row\">\n497\t          <span class=\"setting-label\">分辨率</span>\n498\t          <select class=\"setting-select\" id=\"set-resolution\">\n499\t            <option value=\"960x600\">960 × 600</option>\n500\t            <option value=\"1280x800\" selected>1280 × 800</option>\n501\t            <option value=\"1600x900\">1600 × 900</option>\n502\t            <option value=\"1920x1080\">1920 × 1080</option>\n503\t          </select>\n504\t        </div>\n505\t        <div class=\"setting-row\">\n506\t          <span class=\"setting-label\">全屏</span>\n507\t          <button class=\"setting-toggle\" id=\"set-fullscreen\"></button>\n508\t        </div>\n509\t        <div class=\"setting-row\">\n510\t          <span class=\"setting-label\">画质</span>\n511\t          <select class=\"setting-select\" id=\"set-quality\">\n512\t            <option value=\"low\">低</option>\n513\t            <option value=\"medium\">中</option>\n514\t            <option value=\"high\" selected>高</option>\n515\t          </select>\n516\t        </div>\n517\t        <div class=\"setting-row\">\n518\t          <span class=\"setting-label\">显示FPS</span>\n519\t          <button class=\"setting-toggle on\" id=\"set-showfps\"></button>\n520\t        </div>\n521\t      </div>\n522\t\n523\t      <div class=\"settings-group\">\n524\t        <div class=\"settings-group-label\">💾 存储</div>\n525\t        <div class=\"setting-row\">\n526\t          <span class=\"setting-label\">自动保存</span>\n527\t          <select class=\"setting-select\" id=\"set-autosave\">\n528\t            <option value=\"30\">每30秒</option>\n529\t            <option value=\"60\" selected>每60秒</option>\n530\t            <option value=\"120\">每2分钟</option>\n531\t            <option value=\"300\">每5分钟</option>\n532\t          </select>\n533\t        </div>\n534\t      </div>\n535\t\n536\t      <div class=\"settings-actions\">\n537\t        <button class=\"settings-btn\" id=\"btn-settings-cancel\">取消</button>\n538\t        <button class=\"settings-btn save\" id=\"btn-settings-save\">保存设置</button>\n539\t      </div>\n540\t    </div>\n541\t  </div>\n542\t\n543\t  <!-- ========== GAME UI ========== -->\n544\t  <div id=\"game-ui\">\n545\t    <div id=\"toolbar\">\n546\t      <h1>⛰ 修仙工厂</h1>\n547\t      <div class=\"spacer\"></div>\n548\t      <button class=\"toolbar-btn\" id=\"btn-audio\" title=\"音效开关\">🔊</button>\n549\t      <button class=\"toolbar-btn\" id=\"btn-menu\" title=\"返回菜单\">☰ 菜单</button>\n550\t      <button class=\"toolbar-btn\" id=\"btn-settings-ingame\" title=\"设置\">⚙ 设置</button>\n551\t      <button class=\"toolbar-btn\" id=\"btn-save\" title=\"保存游戏\">💾 保存</button>\n552\t      <button class=\"toolbar-btn\" id=\"btn-center\" title=\"居中视角\">◎ 居中</button>\n553\t      <button class=\"toolbar-btn\" id=\"btn-reset\" title=\"重置游戏\">⚠ 重置</button>\n554\t    </div>\n555\t    <div id=\"main\">\n556\t      <div id=\"sidebar\">\n557\t        <div class=\"sidebar-section\">\n558\t          <h3>🗺 区域</h3>\n559\t          <div id=\"region-list\" class=\"region-nav\"></div>\n560\t        </div>\n561\t        <div class=\"sidebar-section\">\n562\t          <h3>🏗 建筑设施</h3>\n563\t          <div class=\"building-tabs\" id=\"building-tabs\">\n564\t            <button class=\"building-tab active\" data-cat=\"all\">全部</button>\n565\t            <button class=\"building-tab\" data-cat=\"mining\">⛏ 矿</button>\n566\t            <button class=\"building-tab\" data-cat=\"farming\">🌿 田</button>\n567\t            <button class=\"building-tab\" data-cat=\"alchemy\">🔥 炉</button>\n568\t            <button class=\"building-tab\" data-cat=\"transport\">➡ 道</button>\n569\t            <button class=\"building-tab\" data-cat=\"automation\">🤖 傀</button>\n570\t          </div>\n571\t          <div id=\"building-list\"></div>\n572\t        </div>\n573\t        <div class=\"sidebar-section\">\n574\t          <h3>🔬 炼丹配方</h3>\n575\t          <div id=\"recipe-list\"></div>\n576\t        </div>\n577\t      </div>\n578\t      <div id=\"canvas-container\">\n579\t        <canvas id=\"gameCanvas\"></canvas>\n580\t        <div id=\"placement-hint\">点击地图放置建筑 | ESC 取消</div>\n581\t        <div id=\"notifications\"></div>\n582\t      </div>\n583\t      <div id=\"info-panel\">\n584\t        <!-- Realm panel -->\n585\t        <div class=\"realm-panel\" id=\"realm-panel\">\n586\t          <div class=\"realm-name\" id=\"realm-name\">凡人</div>\n587\t          <div class=\"realm-exp-bar\">\n588\t            <div class=\"realm-exp-fill\" id=\"realm-exp-fill\" style=\"width:0%\"></div>\n589\t            <div class=\"realm-exp-text\" id=\"realm-exp-text\">0%</div>\n590\t          </div>\n591\t          <div id=\"breakthrough-reqs\"></div>\n592\t          <button class=\"breakthrough-btn\" id=\"btn-breakthrough\" disabled>境界突破</button>\n593\t        </div>\n594\t\n595\t        <!-- Tab bar -->\n596\t        <div class=\"tab-bar\">\n597\t          <button class=\"tab-btn active\" data-tab=\"inventory\">🎒 丹药</button>\n598\t          <button class=\"tab-btn\" data-tab=\"info\">📊 信息</button>\n599\t          <button class=\"tab-btn\" data-tab=\"alchemy\">🔥 炼丹</button>\n600\t        </div>\n601\t\n602\t        <!-- Inventory tab -->\n603\t        <div class=\"tab-content active\" id=\"tab-inventory\">\n604\t          <div class=\"inventory-panel\">\n605\t            <h3>💊 丹药背包</h3>\n606\t            <div id=\"pill-list\"><div class=\"info-entry\">暂无丹药</div></div>\n607\t          </div>\n608\t        </div>\n609\t\n610\t        <!-- Info tab -->\n611\t        <div class=\"tab-content\" id=\"tab-info\">\n612\t          <div id=\"building-info\"><div class=\"info-entry\">点击建筑查看详情</div></div>\n613\t        </div>\n614\t\n615\t        <!-- Alchemy tab -->\n616\t        <div class=\"tab-content\" id=\"tab-alchemy\">\n617\t          <div class=\"alchemy-panel\">\n618\t            <h3>🔥 炼丹进度</h3>\n619\t            <div id=\"alchemy-status\">\n620\t              <div class=\"info-entry\">选择配方开始炼丹</div>\n621\t            </div>\n622\t          </div>\n623\t        </div>\n624\t      </div>\n625\t    </div>\n626\t    <div id=\"statusbar\">\n627\t      <span class=\"fps\" id=\"fps-display\">FPS: --</span>\n628\t      <span id=\"status-text\">就绪</span>\n629\t      <div class=\"spacer\"></div>\n630\t      <span id=\"playtime\">游玩时间: 0:00</span>\n631\t    </div>\n632\t  </div>\n633\t\n634\t  <script type=\"module\">\n635\t    import { App } from './src/renderer/App.ts';\n636\t    import { loadSettings, saveSettings, updateSetting, getAvailableResolutions, getDefaultSettings } from './src/game/Settings.ts';\n637\t\n638\t    // ==================== LOADING SCREEN ====================\n639\t    const loadingScreen = document.getElementById('loading-screen');\n640\t    const loadingFill = document.getElementById('loading-fill');\n641\t    const loadingText = document.getElementById('loading-text');\n642\t\n643\t    // Particle animation on loading screen\n644\t    const loadCanvas = document.getElementById('loading-particles');\n645\t    const loadCtx = loadCanvas.getContext('2d');\n646\t    loadCanvas.width = window.innerWidth;\n647\t    loadCanvas.height = window.innerHeight;\n648\t\n649\t    const particles = Array.from({ length: 40 }, () => ({\n650\t      x: Math.random() * loadCanvas.width,\n651\t      y: Math.random() * loadCanvas.height,\n652\t      vx: (Math.random() - 0.5) * 0.3,\n653\t      vy: -Math.random() * 0.5 - 0.2,\n654\t      size: Math.random() * 2 + 0.5,\n655\t      alpha: Math.random() * 0.5 + 0.1,\n656\t    }));\n657\t\n658\t    let loadAnimId: number;\n659\t    function animateLoading() {\n660\t      loadCtx.clearRect(0, 0, loadCanvas.width, loadCanvas.height);\n661\t      for (const p of particles) {\n662\t        p.x += p.vx;\n663\t        p.y += p.vy;\n664\t        if (p.y < -10) { p.y = loadCanvas.height + 10; p.x = Math.random() * loadCanvas.width; }\n665\t        loadCtx.fillStyle = `rgba(255, 215, 0, ${p.alpha})`;\n666\t        loadCtx.beginPath();\n667\t        loadCtx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\n668\t        loadCtx.fill();\n669\t      }\n670\t      loadAnimId = requestAnimationFrame(animateLoading);\n671\t    }\n672\t    animateLoading();\n673\t\n674\t    // Simulate loading progress\n675\t    let loadProgress = 0;\n676\t    const loadMessages = ['正在加载资源...', '初始化灵脉...', '唤醒傀儡...', '点燃丹炉...', '准备就绪'];\n677\t    const loadInterval = setInterval(() => {\n678\t      loadProgress += Math.random() * 15 + 5;\n679\t      if (loadProgress >= 100) loadProgress = 100;\n680\t      loadingFill.style.width = `${loadProgress}%`;\n681\t      loadingText.textContent = loadMessages[Math.min(4, Math.floor(loadProgress / 25))];\n682\t      if (loadProgress >= 100) {\n683\t        clearInterval(loadInterval);\n684\t        setTimeout(() => {\n685\t          cancelAnimationFrame(loadAnimId);\n686\t          loadingScreen.classList.add('fade-out');\n687\t          setTimeout(() => {\n688\t            loadingScreen.style.display = 'none';\n689\t            showMainMenu();\n690\t          }, 800);\n691\t        }, 300);\n692\t      }\n693\t    }, 200);\n694\t\n695\t    // ==================== MAIN MENU ====================\n696\t    const mainMenu = document.getElementById('main-menu');\n697\t    const steamStatus = document.getElementById('steam-status');\n698\t    const gameUI = document.getElementById('game-ui');\n699\t    let app: App | null = null;\n700\t    let isGameRunning = false;\n701\t\n702\t    // Check Steam availability\n703\t    const electronAPI = (window as any).electronAPI;\n704\t    if (electronAPI) {\n705\t      electronAPI.isSteamAvailable().then((available: boolean) => {\n706\t        steamStatus.textContent = available ? '✓ Steam 已连接' : '— 离线模式';\n707\t        steamStatus.className = `steam-status${available ? '' : ' offline'}`;\n708\t        const version = document.getElementById('menu-version');\n709\t        electronAPI.getAppVersion().then((v: string) => {\n710\t          version.textContent = `v${v}`;\n711\t        });\n712\t      });\n713\t    } else {\n714\t      steamStatus.textContent = '— 浏览器模式';\n715\t      steamStatus.className = 'steam-status offline';\n716\t    }\n717\t\n718\t    function showMainMenu() {\n719\t      mainMenu.classList.add('active');\n720\t      if (isGameRunning && app) {\n721\t        app.stop();\n722\t        isGameRunning = false;\n723\t      }\n724\t    }\n725\t\n726\t    function startGame(newGame: boolean) {\n727\t      mainMenu.classList.remove('active');\n728\t      gameUI.classList.add('active');\n729\t      isGameRunning = true;\n730\t\n731\t      if (!app) {\n732\t        const canvas = document.getElementById('gameCanvas') as HTMLCanvasElement;\n733\t        app = new App(canvas);\n734\t        setupGameUI();\n735\t      } else if (newGame) {\n736\t        import('./src/game/GameState.ts').then(({ clearSave }) => {\n737\t          clearSave();\n738\t          location.reload();\n739\t        });\n740\t        return;\n741\t      }\n742\t\n743\t      app.centerCamera();\n744\t      app.start();\n745\t    }\n746\t\n747\t    // Menu buttons\n748\t    document.getElementById('btn-continue').addEventListener('click', () => startGame(false));\n749\t    document.getElementById('btn-new-game').addEventListener('click', () => {\n750\t      if (isGameRunning) {\n751\t        if (confirm('开始新游戏将清除当前进度，确定吗？')) {\n752\t          startGame(true);\n753\t        }\n754\t      } else {\n755\t        startGame(true);\n756\t      }\n757\t    });\n758\t    document.getElementById('btn-settings').addEventListener('click', () => showSettings());\n759\t    document.getElementById('btn-quit').addEventListener('click', () => {\n760\t      if (electronAPI) {\n761\t        electronAPI.quit();\n762\t      } else {\n763\t        if (confirm('确定要退出游戏吗？')) {\n764\t          window.close();\n765\t        }\n766\t      }\n767\t    });\n768\t\n769\t    // ==================== SETTINGS PAGE ====================\n770\t    const settingsPage = document.getElementById('settings-page');\n771\t    let settings = loadSettings();\n772\t    let previousPage = 'menu'; // 'menu' or 'game'\n773\t\n774\t    function showSettings() {\n775\t      previousPage = mainMenu.classList.contains('active') ? 'menu' : 'game';\n776\t      settingsPage.classList.add('active');\n777\t      populateSettings();\n778\t    }\n779\t\n780\t    function hideSettings() {\n781\t      settingsPage.classList.remove('active');\n782\t    }\n783\t\n784\t    function populateSettings() {\n785\t      (document.getElementById('set-master-vol') as HTMLInputElement).value = String(settings.masterVolume);\n786\t      document.getElementById('val-master-vol').textContent = String(settings.masterVolume);\n787\t      (document.getElementById('set-sfx-vol') as HTMLInputElement).value = String(settings.sfxVolume);\n788\t      document.getElementById('val-sfx-vol').textContent = String(settings.sfxVolume);\n789\t      (document.getElementById('set-music-vol') as HTMLInputElement).value = String(settings.musicVolume);\n790\t      document.getElementById('val-music-vol').textContent = String(settings.musicVolume);\n791\t\n792\t      const resKey = `${settings.resolution.width}x${settings.resolution.height}`;\n793\t      (document.getElementById('set-resolution') as HTMLSelectElement).value = resKey;\n794\t\n795\t      const fsBtn = document.getElementById('set-fullscreen');\n796\t      fsBtn.classList.toggle('on', settings.fullscreen);\n797\t\n798\t      const fpsBtn = document.getElementById('set-showfps');\n799\t      fpsBtn.classList.toggle('on', settings.showFPS);\n800\t\n801\t      (document.getElementById('set-quality') as HTMLSelectElement).value = settings.particleQuality;\n802\t      (document.getElementById('set-autosave') as HTMLSelectElement).value = String(settings.autoSaveInterval);\n803\t    }\n804\t\n805\t    // Slider bindings\n806\t    ['master-vol', 'sfx-vol', 'music-vol'].forEach(key => {\n807\t      const slider = document.getElementById(`set-${key}`) as HTMLInputElement;\n808\t      const label = document.getElementById(`val-${key}`);\n809\t      slider.addEventListener('input', () => { label.textContent = slider.value; });\n810\t    });\n811\t\n812\t    // Toggle bindings\n813\t    ['set-fullscreen', 'set-showfps'].forEach(id => {\n814\t      document.getElementById(id).addEventListener('click', function() {\n815\t        this.classList.toggle('on');\n816\t      });\n817\t    });\n818\t\n819\t    document.getElementById('btn-settings-cancel').addEventListener('click', hideSettings);\n820\t    document.getElementById('btn-settings-save').addEventListener('click', () => {\n821\t      const masterVol = parseInt((document.getElementById('set-master-vol') as HTMLInputElement).value);\n822\t      const sfxVol = parseInt((document.getElementById('set-sfx-vol') as HTMLInputElement).value);\n823\t      const musicVol = parseInt((document.getElementById('set-music-vol') as HTMLInputElement).value);\n824\t      const resVal = (document.getElementById('set-resolution') as HTMLSelectElement).value.split('x');\n825\t      const fullscreen = document.getElementById('set-fullscreen').classList.contains('on');\n826\t      const showFPS = document.getElementById('set-showfps').classList.contains('on');\n827\t      const quality = (document.getElementById('set-quality') as HTMLSelectElement).value;\n828\t      const autoSave = parseInt((document.getElementById('set-autosave') as HTMLSelectElement).value);\n829\t\n830\t      settings = {\n831\t        masterVolume: masterVol,\n832\t        sfxVolume: sfxVol,\n833\t        musicVolume: musicVol,\n834\t        resolution: { width: parseInt(resVal[0]), height: parseInt(resVal[1]) },\n835\t        fullscreen,\n836\t        language: 'zh-CN',\n837\t        autoSaveInterval: autoSave,\n838\t        showFPS,\n839\t        particleQuality: quality as any,\n840\t      };\n841\t      saveSettings(settings);\n842\t\n843\t      // Apply Electron-level settings\n844\t      if (electronAPI) {\n845\t        electronAPI.setFullscreen(fullscreen);\n846\t        electronAPI.setResolution(parseInt(resVal[0]), parseInt(resVal[1]));\n847\t      }\n848\t\n849\t      hideSettings();\n850\t    });\n851\t\n852\t    // Settings from toolbar\n853\t    document.getElementById('btn-settings-ingame').addEventListener('click', showSettings);\n854\t\n855\t    // ==================== GAME UI SETUP ====================\n856\t    function setupGameUI() {\n857\t      if (!app) return;\n858\t\n859\t      const canvas = document.getElementById('gameCanvas') as HTMLCanvasElement;\n860\t\n861\t      // FPS counter\n862\t      let frameCount = 0;\n863\t      let fpsTime = performance.now();\n864\t      const fpsDisplay = document.getElementById('fps-display');\n865\t      const statusText = document.getElementById('status-text');\n866\t      const playtimeDisplay = document.getElementById('playtime');\n867\t\n868\t      setInterval(() => {\n869\t        const now = performance.now();\n870\t        const fps = Math.round(frameCount * 1000 / (now - fpsTime));\n871\t        fpsDisplay.textContent = `FPS: ${fps}`;\n872\t        fpsDisplay.style.display = settings.showFPS ? '' : 'none';\n873\t        frameCount = 0;\n874\t        fpsTime = now;\n875\t\n876\t        if (app) {\n877\t          const secs = Math.floor(app.state.totalPlaytime);\n878\t          const mins = Math.floor(secs / 60);\n879\t          const hrs = Math.floor(mins / 60);\n880\t          playtimeDisplay.textContent = `游玩时间: ${hrs}:${String(mins % 60).padStart(2, '0')}`;\n881\t        }\n882\t      }, 1000);\n883\t\n884\t      const origLoop = app.loop.bind(app);\n885\t      app.loop = (now) => { frameCount++; origLoop(now); };\n886\t\n887\t      // === Notifications ===\n888\t      const notifContainer = document.getElementById('notifications');\n889\t      app.onNotification = (notif) => {\n890\t        const el = document.createElement('div');\n891\t        el.className = `notif ${notif.type}`;\n892\t        el.textContent = notif.text;\n893\t        notifContainer.appendChild(el);\n894\t        requestAnimationFrame(() => el.classList.add('show'));\n895\t        setTimeout(() => {\n896\t          el.classList.remove('show');\n897\t          setTimeout(() => el.remove(), 300);\n898\t        }, 3000);\n899\t      };\n900\t\n901\t      // === Tabs ===\n902\t      document.querySelectorAll('.tab-btn').forEach(btn => {\n903\t        btn.addEventListener('click', () => {\n904\t          document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\n905\t          document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));\n906\t          btn.classList.add('active');\n907\t          document.getElementById(`tab-${(btn as HTMLElement).dataset.tab}`).classList.add('active');\n908\t        });\n909\t      });\n910\t\n911\t      // === Building sidebar ===\n912\t      const buildingList = document.getElementById('building-list');\n913\t      const placementHint = document.getElementById('placement-hint');\n914\t\n915\t      function renderBuildingList() {\n916\t        buildingList.innerHTML = '';\n917\t        let available = app!.getAvailableBuildings();\n918\t        if (buildingCategoryFilter !== 'all') {\n919\t          available = available.filter(d => d.category === buildingCategoryFilter);\n920\t        }\n921\t        for (const def of available) {\n922\t          const item = document.createElement('div');\n923\t          item.className = 'building-item';\n924\t          if (app!.placementMode?.id === def.id) item.classList.add('selected');\n925\t\n926\t          const affordable = !Object.keys(def.cost).length ||\n927\t            Object.entries(def.cost).every(([r, c]) => (app!.state.resources[r] ?? 0) >= c);\n928\t\n929\t          const icon = getIcon(def.category);\n930\t          const costStr = Object.entries(def.cost).length > 0\n931\t            ? Object.entries(def.cost).map(([r, c]) => `${getResourceName(r)}:${c}`).join(' ')\n932\t            : '免费';\n933\t\n934\t          item.innerHTML = `\n935\t            <span class=\"icon\">${icon}</span>\n936\t            <div class=\"info\">\n937\t              <div class=\"name\">${def.name}</div>\n938\t              <div class=\"cost ${affordable ? '' : 'cannot'}\">${costStr}</div>\n939\t            </div>\n940\t          `;\n941\t\n942\t          item.addEventListener('click', () => {\n943\t            if (app!.placementMode?.id === def.id) {\n944\t              app!.placementMode = null;\n945\t              placementHint.style.display = 'none';\n946\t              statusText.textContent = '就绪';\n947\t            } else {\n948\t              app!.placementMode = def;\n949\t              placementHint.style.display = 'block';\n950\t              statusText.textContent = `放置模式: ${def.name}`;\n951\t            }\n952\t            renderBuildingList();\n953\t          });\n954\t\n955\t          buildingList.appendChild(item);\n956\t        }\n957\t      }\n958\t\n959\t      function getIcon(category) {\n960\t        const icons = { mining: '⛏', farming: '🌿', alchemy: '🔥', energy: '✨', cultivation: '🧘', transport: '➡', automation: '🤖', control: '📜', processing: '🔩' };\n961\t        return icons[category] || '🏠';\n962\t      }\n963\t\n964\t      function getResourceName(id) {\n965\t        const names = {\n966\t          spirit_stone: '灵石', spirit_grass: '灵草', spirit_energy: '灵气',\n967\t          cultivation: '修为', pill_juling: '聚灵丹', pill_peiyuan: '培元丹',\n968\t          pill_ningqi: '凝气丹', pill_zhuji: '筑基丹', pill_jindanyin: '金丹引',\n969\t          spirit_iron: '灵铁', spirit_wood: '灵木', talisman_paper: '符纸',\n970\t        };\n971\t        return names[id] ?? id;\n972\t      }\n973\t\n974\t      // === Building category filter ===\n975\t      let buildingCategoryFilter = 'all';\n976\t      document.querySelectorAll('#building-tabs .building-tab').forEach(btn => {\n977\t        btn.addEventListener('click', () => {\n978\t          document.querySelectorAll('.building-tab').forEach(b => b.classList.remove('active'));\n979\t          btn.classList.add('active');\n980\t          buildingCategoryFilter = (btn as HTMLElement).dataset.cat!;\n981\t          renderBuildingList();\n982\t        });\n983\t      });\n984\t\n985\t      renderBuildingList();\n986\t\n987\t      // === Region navigation ===\n988\t      function renderRegionList() {\n989\t        const regionList = document.getElementById('region-list');\n990\t        regionList.innerHTML = '';\n991\t        const regions = app!.getUnlockedRegions();\n992\t        for (const r of regions) {\n993\t          const btn = document.createElement('button');\n994\t          btn.className = 'region-btn' + (r.index === app!.currentRegionIndex ? ' active' : '');\n995\t          btn.textContent = r.name;\n996\t          btn.addEventListener('click', () => {\n997\t            app!.switchRegion(r.index);\n998\t            renderRegionList();\n999\t          });\n1000\t          regionList.appendChild(btn);\n1001\t        }\n1002\t        const allRegions = [\n1003\t          { name: '炼气坪', unlock: 'liqi_1' },\n1004\t          { name: '灵田区', unlock: 'liqi_5' },\n1005\t          { name: '灵石矿区', unlock: 'liqi_8' },\n1006\t          { name: '筑基台', unlock: 'zhuji_1' },\n1007\t          { name: '药王谷', unlock: 'zhuji_10' },\n1008\t          { name: '丹鼎峰', unlock: 'jindan_1' },\n1009\t          { name: '矿脉山', unlock: 'jindan_5' },\n1010\t        ];\n1011\t        const unlockedNames = new Set(regions.map(r => r.name));\n1012\t        for (const ar of allRegions) {\n1013\t          if (!unlockedNames.has(ar.name)) {\n1014\t            const btn = document.createElement('button');\n1015\t            btn.className = 'region-btn locked';\n1016\t            btn.textContent = `🔒 ${ar.name}`;\n1017\t            btn.title = `需要达到 ${ar.unlock.replace('_', ' Lv')} 解锁`;\n1018\t            regionList.appendChild(btn);\n1019\t          }\n1020\t        }\n1021\t      }\n1022\t\n1023\t      renderRegionList();\n1024\t      app.onRegionChange = () => { renderRegionList(); };\n1025\t\n1026\t      // === Recipe sidebar ===\n1027\t      function renderRecipeList() {\n1028\t        const recipeList = document.getElementById('recipe-list');\n1029\t        recipeList.innerHTML = '';\n1030\t        const recipes = app!.getAvailableAlchemyRecipes();\n1031\t        for (const recipe of recipes) {\n1032\t          const item = document.createElement('div');\n1033\t          item.className = 'recipe-item';\n1034\t\n1035\t          const ingredients = Object.entries(recipe.ingredients)\n1036\t            .map(([r, c]) => `${getResourceName(r)}:${c}`).join(' ');\n1037\t          const canCraftNow = app!.state.alchemySession === null &&\n1038\t            Object.entries(recipe.ingredients).every(([r, c]) => (app!.state.resources[r] ?? 0) >= c);\n1039\t\n1040\t          item.innerHTML = `\n1041\t            <span style=\"color:${recipe.output.resource === 'pill_juling' ? '#ff8c32' : recipe.output.resource === 'pill_peiyuan' ? '#ff6699' : '#cc66ff'}\">💊</span>\n1042\t            <span class=\"recipe-name\">${recipe.name}</span>\n1043\t            <button class=\"recipe-craft-btn\" ${canCraftNow ? '' : 'disabled'}>${ingredients}</button>\n1044\t          `;\n1045\t\n1046\t          item.querySelector('.recipe-craft-btn').addEventListener('click', () => {\n1047\t            app!.startAlchemyAction(recipe.id);\n1048\t          });\n1049\t\n1050\t          recipeList.appendChild(item);\n1051\t        }\n1052\t      }\n1053\t\n1054\t      // === Realm panel ===\n1055\t      function renderRealmPanel() {\n1056\t        const c = app!.state.cultivation;\n1057\t        const nameEl = document.getElementById('realm-name');\n1058\t        const fillEl = document.getElementById('realm-exp-fill');\n1059\t        const textEl = document.getElementById('realm-exp-text');\n1060\t        const reqsEl = document.getElementById('breakthrough-reqs');\n1061\t        const btnEl = document.getElementById('btn-breakthrough');\n1062\t\n1063\t        import('./src/game/Cultivation.ts').then(({ getFullRealmName, canBreakthrough, getBreakthroughRequirements, getSubStageName }) => {\n1064\t          nameEl.textContent = getFullRealmName(c);\n1065\t          const ratio = c.exp / c.expToNext;\n1066\t          fillEl.style.width = `${Math.floor(ratio * 100)}%`;\n1067\t          textEl.textContent = `${Math.floor(ratio * 100)}%`;\n1068\t\n1069\t          const reqs = getBreakthroughRequirements(c);\n1070\t          reqsEl.innerHTML = '';\n1071\t\n1072\t          if (reqs.canAttempt || c.level >= 3) {\n1073\t            for (const [res, amount] of Object.entries(reqs.resourceCost)) {\n1074\t              const current = app!.state.resources[res] ?? 0;\n1075\t              const met = current >= amount;\n1076\t              reqsEl.innerHTML += `<div class=\"breakthrough-req ${met ? 'met' : 'unmet'}\">${met ? '✓' : '✗'} ${getResourceName(res)}: ${current}/${amount}</div>`;\n1077\t            }\n1078\t            if (reqs.needsPill && reqs.pillId) {\n1079\t              const current = app!.state.resources[reqs.pillId] ?? 0;\n1080\t              const met = current >= reqs.pillCount;\n1081\t              reqsEl.innerHTML += `<div class=\"breakthrough-req ${met ? 'met' : 'unmet'}\">${met ? '✓' : '✗'} ${getResourceName(reqs.pillId)}: ${current}/${reqs.pillCount}</div>`;\n1082\t            }\n1083\t            reqsEl.innerHTML += `<div class=\"breakthrough-req\" style=\"color:#aaa\">成功率: ${Math.floor(reqs.successRate * 100)}%</div>`;\n1084\t\n1085\t            const canAttempt = reqs.canAttempt &&\n1086\t              Object.entries(reqs.resourceCost).every(([r, a]) => (app!.state.resources[r] ?? 0) >= a) &&\n1087\t              (!reqs.needsPill || (app!.state.resources[reqs.pillId ?? ''] ?? 0) >= (reqs.pillCount ?? 0));\n1088\t\n1089\t            btnEl.disabled = !canAttempt;\n1090\t          } else {\n1091\t            reqsEl.innerHTML = `<div class=\"breakthrough-req\" style=\"color:#666\">修为满级后可突破</div>`;\n1092\t            btnEl.disabled = true;\n1093\t          }\n1094\t        });\n1095\t      }\n1096\t\n1097\t      // === Inventory panel ===\n1098\t      function renderInventory() {\n1099\t        const pillList = document.getElementById('pill-list');\n1100\t        const pills = app!.getInventoryPills();\n1101\t\n1102\t        if (pills.length === 0) {\n1103\t          pillList.innerHTML = '<div class=\"info-entry\" style=\"color:#555\">暂无丹药</div>';\n1104\t          return;\n1105\t        }\n1106\t\n1107\t        pillList.innerHTML = '';\n1108\t        for (const pill of pills) {\n1109\t          const item = document.createElement('div');\n1110\t          item.className = 'pill-item';\n1111\t          item.innerHTML = `\n1112\t            <span style=\"color:${pill.color}\">💊</span>\n1113\t            <span class=\"pill-name\">${pill.name}</span>\n1114\t            <span class=\"pill-count\">×${pill.count}</span>\n1115\t            <button class=\"pill-use-btn\" data-id=\"${pill.id}\">服用</button>\n1116\t            ${pill.count > 1 ? `<button class=\"pill-use-all-btn\" data-id=\"${pill.id}\">全部</button>` : ''}\n1117\t          `;\n1118\t          pillList.appendChild(item);\n1119\t        }\n1120\t\n1121\t        pillList.querySelectorAll('.pill-use-btn').forEach(btn => {\n1122\t          btn.addEventListener('click', () => app!.usePillAction((btn as HTMLElement).dataset.id!));\n1123\t        });\n1124\t        pillList.querySelectorAll('.pill-use-all-btn').forEach(btn => {\n1125\t          btn.addEventListener('click', () => app!.useAllPills((btn as HTMLElement).dataset.id!));\n1126\t        });\n1127\t      }\n1128\t\n1129\t      // === Alchemy status ===\n1130\t      function renderAlchemyStatus() {\n1131\t        const statusEl = document.getElementById('alchemy-status');\n1132\t        const session = app!.state.alchemySession;\n1133\t\n1134\t        if (!session) {\n1135\t          statusEl.innerHTML = '<div class=\"info-entry\">选择配方开始炼丹</div>';\n1136\t          return;\n1137\t        }\n1138\t\n1139\t        const progress = Math.floor(session.progress * 100);\n1140\t        statusEl.innerHTML = `\n1141\t          <div class=\"info-entry\" style=\"color:#ff8c32\">${session.recipeId === 'pill_juling' ? '聚灵丹' : session.recipeId === 'pill_peiyuan' ? '培元丹' : '凝气丹'}</div>\n1142\t          <div class=\"alchemy-progress\">\n1143\t            <div class=\"alchemy-progress-fill\" style=\"width:${progress}%\"></div>\n1144\t            <div class=\"alchemy-progress-text\">${progress}%</div>\n1145\t          </div>\n1146\t          ${session.complete ? '<button class=\"alchemy-collect-btn\" id=\"btn-collect-alchemy\">收取丹药</button>' : ''}\n1147\t        `;\n1148\t\n1149\t        const collectBtn = document.getElementById('btn-collect-alchemy');\n1150\t        if (collectBtn) {\n1151\t          collectBtn.addEventListener('click', () => app!.collectAlchemyAction());\n1152\t        }\n1153\t      }\n1154\t\n1155\t      // === Building info ===\n1156\t      function updateBuildingInfo(building) {\n1157\t        const infoDiv = document.getElementById('building-info');\n1158\t        if (!building) {\n1159\t          infoDiv.innerHTML = '<div class=\"info-entry\">点击建筑查看详情</div>';\n1160\t          return;\n1161\t        }\n1162\t        const def = app!.buildingDefs.get(building.buildingId);\n1163\t        if (!def) return;\n1164\t        const prod = def.production;\n1165\t        infoDiv.innerHTML = `\n1166\t          <div class=\"info-entry\" style=\"color:#ffd700;font-weight:bold\">${def.name}</div>\n1167\t          <div class=\"info-entry\">等级: ${building.level}/${def.maxLevel}</div>\n1168\t          <div class=\"info-entry\">类型: ${prod.mode === 'manual' ? '手动' : '自动'}</div>\n1169\t          <div class=\"info-entry\">产出: ${getResourceName(prod.resource)} ×${prod.amount}</div>\n1170\t          ${prod.interval > 0 ? `<div class=\"info-entry\">间隔: ${(prod.interval / 1000).toFixed(1)}s</div>` : ''}\n1171\t          ${prod.input ? `<div class=\"info-entry\">消耗: ${Object.entries(prod.input).map(([r,c]) => `${getResourceName(r)}:${c}`).join(' ')}</div>` : ''}\n1172\t          <div class=\"info-entry\">状态: ${building.isProducing ? '生产中' : '空闲'}</div>\n1173\t          ${building.progress > 0 ? `<div class=\"info-entry\">进度: ${Math.floor(building.progress * 100)}%</div>` : ''}\n1174\t        `;\n1175\t      }\n1176\t\n1177\t      // === State change handler ===\n1178\t      app.onStateChange = (state) => {\n1179\t        renderBuildingList();\n1180\t        renderRecipeList();\n1181\t        renderRealmPanel();\n1182\t        renderInventory();\n1183\t        renderAlchemyStatus();\n1184\t      };\n1185\t\n1186\t      app.onBuildingSelect = (building) => {\n1187\t        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\n1188\t        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));\n1189\t        document.querySelector('[data-tab=\"info\"]').classList.add('active');\n1190\t        document.getElementById('tab-info').classList.add('active');\n1191\t        updateBuildingInfo(building);\n1192\t      };\n1193\t\n1194\t      app.onAlchemyUpdate = (session) => {\n1195\t        renderAlchemyStatus();\n1196\t      };\n1197\t\n1198\t      // === Breakthrough ===\n1199\t      document.getElementById('btn-breakthrough').addEventListener('click', () => {\n1200\t        app!.attemptBreakthroughAction();\n1201\t      });\n1202\t\n1203\t      // === Toolbar buttons ===\n1204\t      document.getElementById('btn-save').addEventListener('click', () => {\n1205\t        import('./src/game/GameState.ts').then(({ saveGame }) => {\n1206\t          saveGame(app!.state);\n1207\t          app!.addNotification('游戏已保存', 'info');\n1208\t        });\n1209\t      });\n1210\t\n1211\t      document.getElementById('btn-center').addEventListener('click', () => {\n1212\t        app!.centerCamera();\n1213\t      });\n1214\t\n1215\t      document.getElementById('btn-reset').addEventListener('click', () => {\n1216\t        if (confirm('确定要重置游戏进度吗？此操作不可撤销！')) {\n1217\t          import('./src/game/GameState.ts').then(({ clearSave }) => {\n1218\t            clearSave();\n1219\t            location.reload();\n1220\t          });\n1221\t        }\n1222\t      });\n1223\t\n1224\t      // Back to menu\n1225\t      document.getElementById('btn-menu').addEventListener('click', () => {\n1226\t        if (confirm('返回主菜单？当前进度已自动保存。')) {\n1227\t          app!.stop();\n1228\t          gameUI.classList.remove('active');\n1229\t          showMainMenu();\n1230\t        }\n1231\t      });\n1232\t\n1233\t      // Audio toggle\n1234\t      import('./src/game/AudioManager.ts').then(({ audioManager }) => {\n1235\t        const audioBtn = document.getElementById('btn-audio');\n1236\t        audioBtn.addEventListener('click', () => {\n1237\t          audioManager.init();\n1238\t          const muted = audioManager.toggleMute();\n1239\t          audioBtn.textContent = muted ? '🔇' : '🔊';\n1240\t        });\n1241\t      });\n1242\t\n1243\t      // Initial render\n1244\t      renderRealmPanel();\n1245\t      renderInventory();\n1246\t      renderAlchemyStatus();\n1247\t      renderRecipeList();\n1248\t    }\n1249\t  </script>\n1250\t</body>\n1251\t</html>\n1252\t"}]},"parent_tool_use_id":null,"session_id":"094f9230-fe12-4466-ab83-fdd0d233a191","uuid":"0f7e9865-453b-400c-afa4-a353252bdea0","timestamp":"2026-05-23T02:55:11.942Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/steam-cultivation-factory/index.html","content":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>修仙自动化工厂 — Cultivation Factory</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body {\n      background: #1a1a2e;\n      color: #e0e0e0;\n      font-family: 'Segoe UI', system-ui, monospace;\n      overflow: hidden;\n      height: 100vh;\n      width: 100vw;\n    }\n\n    /* ==================== LOADING SCREEN ==================== */\n    #loading-screen {\n      position: fixed; top: 0; left: 0; width: 100%; height: 100%;\n      background: radial-gradient(ellipse at center, #1e2a4a 0%, #0a0e1a 100%);\n      display: flex; flex-direction: column; align-items: center; justify-content: center;\n      z-index: 1000; transition: opacity 0.8s ease;\n    }\n    #loading-screen.fade-out { opacity: 0; pointer-events: none; }\n    .loading-title {\n      font-size: 36px; color: #ffd700;\n      text-shadow: 0 0 20px rgba(255,215,0,0.5), 0 0 60px rgba(255,215,0,0.2);\n      margin-bottom: 8px; letter-spacing: 4px;\n      animation: titlePulse 3s ease-in-out infinite;\n    }\n    @keyframes titlePulse {\n      0%, 100% { text-shadow: 0 0 20px rgba(255,215,0,0.5), 0 0 60px rgba(255,215,0,0.2); }\n      50% { text-shadow: 0 0 30px rgba(255,215,0,0.8), 0 0 80px rgba(255,215,0,0.4); }\n    }\n    .loading-subtitle { font-size: 14px; color: #888; margin-bottom: 40px; letter-spacing: 2px; }\n    .loading-bar-container {\n      width: 320px; height: 4px; background: rgba(255,255,255,0.1);\n      border-radius: 2px; overflow: hidden; margin-bottom: 16px;\n    }\n    .loading-bar-fill {\n      height: 100%; width: 0%; border-radius: 2px;\n      background: linear-gradient(90deg, #ffd700, #ff8c00);\n      transition: width 0.3s ease;\n    }\n    .loading-text { font-size: 12px; color: #666; }\n    .loading-particles {\n      position: absolute; width: 100%; height: 100%; pointer-events: none;\n    }\n\n    /* ==================== MAIN MENU ==================== */\n    #main-menu {\n      position: fixed; top: 0; left: 0; width: 100%; height: 100%;\n      background: radial-gradient(ellipse at center, #1e2a4a 0%, #0a0e1a 100%);\n      display: none; flex-direction: column; align-items: center; justify-content: center;\n      z-index: 900;\n    }\n    #main-menu.active { display: flex; }\n    .menu-bg {\n      position: absolute; width: 100%; height: 100%;\n      background-image:\n        radial-gradient(2px 2px at 20% 30%, rgba(255,215,0,0.3), transparent),\n        radial-gradient(2px 2px at 40% 70%, rgba(100,200,255,0.2), transparent),\n        radial-gradient(1px 1px at 60% 20%, rgba(255,255,255,0.3), transparent),\n        radial-gradient(1px 1px at 80% 60%, rgba(255,200,50,0.2), transparent),\n        radial-gradient(2px 2px at 10% 80%, rgba(200,150,255,0.2), transparent),\n        radial-gradient(1px 1px at 70% 40%, rgba(255,255,255,0.2), transparent),\n        radial-gradient(1px 1px at 90% 90%, rgba(255,215,0,0.2), transparent);\n      animation: starDrift 60s linear infinite;\n    }\n    @keyframes starDrift { from { transform: translateY(0); } to { transform: translateY(-20px); } }\n\n    .menu-content { position: relative; z-index: 1; text-align: center; }\n    .menu-logo {\n      font-size: 48px; color: #ffd700; margin-bottom: 4px;\n      text-shadow: 0 0 30px rgba(255,215,0,0.6), 0 0 60px rgba(255,215,0,0.3);\n      letter-spacing: 6px;\n    }\n    .menu-version { font-size: 12px; color: #555; margin-bottom: 48px; }\n    .menu-buttons { display: flex; flex-direction: column; gap: 12px; width: 280px; margin: 0 auto; }\n    .menu-btn {\n      background: rgba(255,255,255,0.05);\n      border: 1px solid rgba(255,215,0,0.3);\n      color: #ffd700; padding: 14px 24px; border-radius: 6px;\n      cursor: pointer; font-size: 16px; letter-spacing: 2px;\n      transition: all 0.3s ease; font-family: inherit;\n    }\n    .menu-btn:hover {\n      background: rgba(255,215,0,0.1);\n      border-color: rgba(255,215,0,0.6);\n      text-shadow: 0 0 10px rgba(255,215,0,0.5);\n      transform: translateY(-1px);\n    }\n    .menu-btn:active { transform: translateY(0); }\n    .menu-btn.primary {\n      background: linear-gradient(135deg, rgba(255,215,0,0.15), rgba(255,140,0,0.15));\n      border-color: rgba(255,215,0,0.5);\n    }\n    .menu-btn.primary:hover {\n      background: linear-gradient(135deg, rgba(255,215,0,0.25), rgba(255,140,0,0.25));\n    }\n    .menu-footer { margin-top: 40px; font-size: 11px; color: #444; }\n    .menu-footer .steam-status { color: #6a6; }\n    .menu-footer .steam-status.offline { color: #666; }\n\n    /* ==================== SETTINGS PAGE ==================== */\n    #settings-page {\n      position: fixed; top: 0; left: 0; width: 100%; height: 100%;\n      background: rgba(0,0,0,0.85); backdrop-filter: blur(8px);\n      display: none; align-items: center; justify-content: center;\n      z-index: 950;\n    }\n    #settings-page.active { display: flex; }\n    .settings-panel {\n      background: linear-gradient(145deg, #1a2040, #141830);\n      border: 1px solid rgba(255,215,0,0.2);\n      border-radius: 12px; padding: 32px; width: 480px; max-height: 80vh;\n      overflow-y: auto;\n    }\n    .settings-title {\n      font-size: 22px; color: #ffd700; margin-bottom: 24px;\n      text-align: center; letter-spacing: 2px;\n    }\n    .settings-group {\n      margin-bottom: 20px; padding-bottom: 16px;\n      border-bottom: 1px solid rgba(255,255,255,0.06);\n    }\n    .settings-group:last-child { border-bottom: none; margin-bottom: 0; }\n    .settings-group-label {\n      font-size: 11px; color: #888; text-transform: uppercase;\n      margin-bottom: 12px; letter-spacing: 1px;\n    }\n    .setting-row {\n      display: flex; align-items: center; justify-content: space-between;\n      padding: 8px 0; gap: 16px;\n    }\n    .setting-label { font-size: 13px; color: #ccc; flex-shrink: 0; min-width: 80px; }\n    .setting-value { font-size: 12px; color: #888; min-width: 40px; text-align: right; }\n    .setting-slider {\n      flex: 1; -webkit-appearance: none; height: 4px;\n      background: rgba(255,255,255,0.1); border-radius: 2px; outline: none;\n    }\n    .setting-slider::-webkit-slider-thumb {\n      -webkit-appearance: none; width: 14px; height: 14px;\n      background: #ffd700; border-radius: 50%; cursor: pointer;\n    }\n    .setting-select {\n      flex: 1; background: rgba(255,255,255,0.05);\n      border: 1px solid rgba(255,255,255,0.15);\n      color: #e0e0e0; padding: 6px 12px; border-radius: 4px;\n      font-size: 13px; font-family: inherit; cursor: pointer;\n    }\n    .setting-select option { background: #1a2040; }\n    .setting-toggle {\n      width: 44px; height: 24px; background: rgba(255,255,255,0.1);\n      border-radius: 12px; cursor: pointer; position: relative;\n      border: none; transition: background 0.2s;\n    }\n    .setting-toggle.on { background: rgba(255,215,0,0.4); }\n    .setting-toggle::after {\n      content: ''; position: absolute; top: 3px; left: 3px;\n      width: 18px; height: 18px; background: #e0e0e0;\n      border-radius: 50%; transition: transform 0.2s;\n    }\n    .setting-toggle.on::after { transform: translateX(20px); background: #ffd700; }\n    .settings-actions {\n      display: flex; gap: 12px; margin-top: 24px; justify-content: center;\n    }\n    .settings-btn {\n      background: rgba(255,255,255,0.05);\n      border: 1px solid rgba(255,255,255,0.15);\n      color: #e0e0e0; padding: 8px 24px; border-radius: 4px;\n      cursor: pointer; font-size: 13px; font-family: inherit;\n      transition: background 0.2s;\n    }\n    .settings-btn:hover { background: rgba(255,255,255,0.1); }\n    .settings-btn.save {\n      background: rgba(255,215,0,0.15); border-color: rgba(255,215,0,0.3);\n      color: #ffd700;\n    }\n    .settings-btn.save:hover { background: rgba(255,215,0,0.25); }\n\n    /* ==================== GAME UI ==================== */\n    #game-ui { display: none; }\n    #game-ui.active { display: flex; flex-direction: column; height: 100vh; }\n\n    /* Toolbar */\n    #toolbar {\n      display: flex; align-items: center; gap: 8px;\n      padding: 6px 12px;\n      background: linear-gradient(180deg, rgba(20,24,48,0.95), rgba(10,14,26,0.95));\n      border-bottom: 1px solid rgba(255,215,0,0.15);\n      min-height: 44px; flex-shrink: 0;\n    }\n    #toolbar h1 { font-size: 15px; color: #ffd700; margin-right: 12px; white-space: nowrap; text-shadow: 0 0 8px rgba(255,215,0,0.3); }\n    #toolbar .spacer { flex: 1; }\n    .toolbar-btn {\n      background: rgba(255,255,255,0.05);\n      border: 1px solid rgba(255,255,255,0.1);\n      color: #e0e0e0; padding: 4px 12px; border-radius: 4px;\n      cursor: pointer; font-size: 12px; transition: all 0.2s;\n    }\n    .toolbar-btn:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,215,0,0.3); }\n    .toolbar-btn.active { background: rgba(100,200,100,0.2); border-color: rgba(100,200,100,0.4); }\n\n    /* Main layout */\n    #main { display: flex; flex: 1; overflow: hidden; }\n\n    /* Sidebar */\n    #sidebar {\n      width: 220px;\n      background: linear-gradient(180deg, rgba(20,24,48,0.9), rgba(15,18,35,0.95));\n      border-right: 1px solid rgba(255,215,0,0.1);\n      overflow-y: auto; flex-shrink: 0;\n      display: flex; flex-direction: column;\n    }\n    .sidebar-section {\n      padding: 8px;\n      border-bottom: 1px solid rgba(255,255,255,0.04);\n    }\n    .sidebar-section h3 {\n      font-size: 11px; color: #ffd700; opacity: 0.7;\n      margin-bottom: 6px; letter-spacing: 1px;\n    }\n    .building-item {\n      display: flex; align-items: center; gap: 8px;\n      padding: 6px 8px; margin: 2px 0; border-radius: 4px;\n      cursor: pointer; transition: all 0.2s; font-size: 12px;\n      border: 1px solid transparent;\n    }\n    .building-item:hover { background: rgba(255,215,0,0.05); border-color: rgba(255,215,0,0.1); }\n    .building-item.selected { background: rgba(100,200,100,0.15); border-color: rgba(100,200,100,0.3); }\n    .building-item .icon { font-size: 18px; }\n    .building-item .info { flex: 1; }\n    .building-item .name { color: #e0e0e0; }\n    .building-item .cost { color: #777; font-size: 10px; }\n    .building-item .cost.cannot { color: #c44; }\n\n    /* Canvas */\n    #canvas-container { flex: 1; position: relative; }\n    #gameCanvas { display: block; width: 100%; height: 100%; }\n\n    /* Info panel */\n    #info-panel {\n      width: 240px;\n      background: linear-gradient(180deg, rgba(20,24,48,0.9), rgba(15,18,35,0.95));\n      border-left: 1px solid rgba(255,215,0,0.1);\n      overflow-y: auto; flex-shrink: 0; padding: 8px;\n      display: flex; flex-direction: column; gap: 8px;\n    }\n    #info-panel h3 { font-size: 11px; color: #888; margin-bottom: 4px; }\n    .info-entry { font-size: 11px; padding: 3px 0; color: #ccc; }\n\n    /* Realm panel */\n    .realm-panel {\n      background: rgba(255,215,0,0.03);\n      border: 1px solid rgba(255,215,0,0.15);\n      border-radius: 8px; padding: 10px;\n    }\n    .realm-panel .realm-name {\n      color: #ffd700; font-weight: bold; font-size: 15px;\n      text-shadow: 0 0 6px rgba(255,215,0,0.3);\n    }\n    .realm-panel .realm-exp-bar {\n      background: rgba(255,255,255,0.08);\n      border-radius: 4px; height: 16px;\n      margin: 6px 0; position: relative; overflow: hidden;\n    }\n    .realm-panel .realm-exp-fill {\n      background: linear-gradient(90deg, #ffd700, #ff8c00);\n      height: 100%; border-radius: 4px; transition: width 0.3s;\n      box-shadow: 0 0 8px rgba(255,215,0,0.3);\n    }\n    .realm-panel .realm-exp-text {\n      position: absolute; top: 0; left: 50%; transform: translateX(-50%);\n      font-size: 9px; color: #fff; line-height: 16px;\n    }\n    .breakthrough-btn {\n      background: linear-gradient(135deg, #ffd700, #ff8c00);\n      border: none; color: #1a1a2e; font-weight: bold;\n      padding: 6px 12px; border-radius: 6px; cursor: pointer;\n      font-size: 12px; width: 100%; margin-top: 6px;\n      transition: all 0.2s; letter-spacing: 1px;\n    }\n    .breakthrough-btn:hover { opacity: 0.9; box-shadow: 0 0 12px rgba(255,215,0,0.4); }\n    .breakthrough-btn:disabled {\n      background: rgba(255,255,255,0.08); color: #555;\n      cursor: not-allowed; box-shadow: none;\n    }\n    .breakthrough-req { font-size: 10px; color: #777; padding: 2px 0; }\n    .breakthrough-req.met { color: #6c6; }\n    .breakthrough-req.unmet { color: #c44; }\n\n    /* Inventory panel */\n    .inventory-panel {\n      background: rgba(255,255,255,0.02);\n      border: 1px solid rgba(255,255,255,0.08);\n      border-radius: 8px; padding: 8px;\n    }\n    .pill-item {\n      display: flex; align-items: center; gap: 6px;\n      padding: 4px 0; font-size: 11px;\n    }\n    .pill-item .pill-name { flex: 1; }\n    .pill-item .pill-count { color: #888; }\n    .pill-use-btn {\n      background: rgba(100,200,100,0.15);\n      border: 1px solid rgba(100,200,100,0.25);\n      color: #6c6; padding: 2px 8px; border-radius: 3px;\n      cursor: pointer; font-size: 10px; transition: background 0.2s;\n    }\n    .pill-use-btn:hover { background: rgba(100,200,100,0.25); }\n    .pill-use-all-btn {\n      background: rgba(255,200,50,0.15);\n      border: 1px solid rgba(255,200,50,0.25);\n      color: #ffd700; padding: 2px 6px; border-radius: 3px;\n      cursor: pointer; font-size: 10px;\n    }\n\n    /* Alchemy panel */\n    .alchemy-panel {\n      background: rgba(255,140,50,0.03);\n      border: 1px solid rgba(255,140,50,0.15);\n      border-radius: 8px; padding: 8px;\n    }\n    .recipe-item {\n      display: flex; align-items: center; gap: 6px;\n      padding: 4px 0; font-size: 11px;\n    }\n    .recipe-item .recipe-name { flex: 1; }\n    .recipe-craft-btn {\n      background: rgba(255,140,50,0.15);\n      border: 1px solid rgba(255,140,50,0.25);\n      color: #ff8c32; padding: 2px 8px; border-radius: 3px;\n      cursor: pointer; font-size: 10px; transition: background 0.2s;\n    }\n    .recipe-craft-btn:hover { background: rgba(255,140,50,0.25); }\n    .recipe-craft-btn:disabled { opacity: 0.4; cursor: not-allowed; }\n    .alchemy-progress {\n      background: rgba(255,255,255,0.08);\n      border-radius: 4px; height: 14px;\n      margin: 6px 0; position: relative; overflow: hidden;\n    }\n    .alchemy-progress-fill {\n      background: linear-gradient(90deg, #ff8c32, #ffaa00);\n      height: 100%; border-radius: 4px; transition: width 0.3s;\n      box-shadow: 0 0 6px rgba(255,140,50,0.3);\n    }\n    .alchemy-progress-text {\n      position: absolute; top: 0; left: 50%; transform: translateX(-50%);\n      font-size: 9px; color: #fff; line-height: 14px;\n    }\n    .alchemy-collect-btn {\n      background: linear-gradient(135deg, #ff8c32, #ffaa00);\n      border: none; color: #1a1a2e; font-weight: bold;\n      padding: 6px 12px; border-radius: 4px; cursor: pointer;\n      font-size: 11px; width: 100%; letter-spacing: 1px;\n    }\n\n    /* Notifications */\n    #notifications {\n      position: absolute; top: 56px; right: 12px;\n      display: flex; flex-direction: column; gap: 4px;\n      pointer-events: none; z-index: 10;\n    }\n    .notif {\n      padding: 8px 14px; border-radius: 6px;\n      font-size: 11px; opacity: 0; transition: opacity 0.3s;\n      pointer-events: auto; backdrop-filter: blur(4px);\n    }\n    .notif.show { opacity: 1; }\n    .notif.info { background: rgba(100,100,255,0.2); border: 1px solid rgba(100,100,255,0.3); }\n    .notif.success { background: rgba(100,200,100,0.2); border: 1px solid rgba(100,200,100,0.3); }\n    .notif.warning { background: rgba(255,200,50,0.2); border: 1px solid rgba(255,200,50,0.3); }\n    .notif.error { background: rgba(200,100,100,0.2); border: 1px solid rgba(200,100,100,0.3); }\n\n    /* Status bar */\n    #statusbar {\n      display: flex; align-items: center; gap: 12px;\n      padding: 4px 12px;\n      background: linear-gradient(0deg, rgba(10,14,26,0.95), rgba(20,24,48,0.95));\n      border-top: 1px solid rgba(255,215,0,0.1);\n      font-size: 11px; color: #666;\n      min-height: 28px; flex-shrink: 0;\n    }\n    #statusbar .fps { color: #6a6; }\n\n    #placement-hint {\n      position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%);\n      background: rgba(0,0,0,0.85); color: #ffd700;\n      padding: 8px 20px; border-radius: 6px; font-size: 12px;\n      pointer-events: none; display: none;\n      border: 1px solid rgba(255,215,0,0.2);\n    }\n\n    /* Region navigation */\n    .region-nav { display: flex; flex-wrap: wrap; gap: 4px; padding: 4px 0; }\n    .region-btn {\n      background: rgba(255,255,255,0.03);\n      border: 1px solid rgba(255,255,255,0.08);\n      color: #999; padding: 3px 8px; border-radius: 3px;\n      cursor: pointer; font-size: 10px; transition: all 0.2s;\n    }\n    .region-btn:hover { background: rgba(255,215,0,0.05); border-color: rgba(255,215,0,0.2); }\n    .region-btn.active { background: rgba(100,200,100,0.15); border-color: rgba(100,200,100,0.3); color: #6c6; }\n    .region-btn.locked { opacity: 0.4; cursor: not-allowed; }\n\n    /* Building category tabs */\n    .building-tabs { display: flex; gap: 2px; margin-bottom: 4px; }\n    .building-tab {\n      flex: 1; background: rgba(255,255,255,0.02);\n      border: 1px solid rgba(255,255,255,0.06);\n      color: #555; padding: 3px 0; border-radius: 3px;\n      cursor: pointer; font-size: 9px; text-align: center;\n      transition: all 0.2s;\n    }\n    .building-tab.active { background: rgba(255,215,0,0.08); color: #e0e0e0; border-color: rgba(255,215,0,0.2); }\n\n    /* Scrollbar */\n    ::-webkit-scrollbar { width: 5px; }\n    ::-webkit-scrollbar-track { background: transparent; }\n    ::-webkit-scrollbar-thumb { background: rgba(255,215,0,0.15); border-radius: 3px; }\n    ::-webkit-scrollbar-thumb:hover { background: rgba(255,215,0,0.3); }\n\n    /* Tab buttons for info panel */\n    .tab-bar { display: flex; gap: 4px; margin-bottom: 4px; }\n    .tab-btn {\n      flex: 1; background: rgba(255,255,255,0.03);\n      border: 1px solid rgba(255,255,255,0.08);\n      color: #666; padding: 4px 0; border-radius: 3px;\n      cursor: pointer; font-size: 10px; text-align: center;\n      transition: all 0.2s;\n    }\n    .tab-btn.active { background: rgba(255,255,255,0.08); color: #e0e0e0; border-color: rgba(255,215,0,0.2); }\n    .tab-content { display: none; }\n    .tab-content.active { display: block; }\n  </style>\n</head>\n<body>\n\n  <!-- ========== LOADING SCREEN ========== -->\n  <div id=\"loading-screen\">\n    <canvas id=\"loading-particles\" class=\"loading-particles\"></canvas>\n    <div class=\"loading-title\">修仙自动化工厂</div>\n    <div class=\"loading-subtitle\">CULTIVATION FACTORY</div>\n    <div class=\"loading-bar-container\">\n      <div class=\"loading-bar-fill\" id=\"loading-fill\"></div>\n    </div>\n    <div class=\"loading-text\" id=\"loading-text\">正在加载资源...</div>\n  </div>\n\n  <!-- ========== MAIN MENU ========== -->\n  <div id=\"main-menu\">\n    <div class=\"menu-bg\"></div>\n    <div class=\"menu-content\">\n      <div class=\"menu-logo\">⛰ 修仙工厂</div>\n      <div class=\"menu-version\" id=\"menu-version\">v0.5.0</div>\n      <div class=\"menu-buttons\">\n        <button class=\"menu-btn primary\" id=\"btn-continue\">继续修炼</button>\n        <button class=\"menu-btn\" id=\"btn-new-game\">新的旅程</button>\n        <button class=\"menu-btn\" id=\"btn-settings\">⚙ 系统设置</button>\n        <button class=\"menu-btn\" id=\"btn-quit\">退出游戏</button>\n      </div>\n      <div class=\"menu-footer\">\n        <span class=\"steam-status\" id=\"steam-status\"></span>\n      </div>\n    </div>\n  </div>\n\n  <!-- ========== SETTINGS PAGE ========== -->\n  <div id=\"settings-page\">\n    <div class=\"settings-panel\">\n      <div class=\"settings-title\">⚙ 系统设置</div>\n\n      <div class=\"settings-group\">\n        <div class=\"settings-group-label\">🔊 音频</div>\n        <div class=\"setting-row\">\n          <span class=\"setting-label\">主音量</span>\n          <input type=\"range\" class=\"setting-slider\" id=\"set-master-vol\" min=\"0\" max=\"100\" value=\"80\">\n          <span class=\"setting-value\" id=\"val-master-vol\">80</span>\n        </div>\n        <div class=\"setting-row\">\n          <span class=\"setting-label\">音效</span>\n          <input type=\"range\" class=\"setting-slider\" id=\"set-sfx-vol\" min=\"0\" max=\"100\" value=\"100\">\n          <span class=\"setting-value\" id=\"val-sfx-vol\">100</span>\n        </div>\n        <div class=\"setting-row\">\n          <span class=\"setting-label\">音乐</span>\n          <input type=\"range\" class=\"setting-slider\" id=\"set-music-vol\" min=\"0\" max=\"100\" value=\"70\">\n          <span class=\"setting-value\" id=\"val-music-vol\">70</span>\n        </div>\n      </div>\n\n      <div class=\"settings-group\">\n        <div class=\"settings-group-label\">🖥 显示</div>\n        <div class=\"setting-row\">\n          <span class=\"setting-label\">分辨率</span>\n          <select class=\"setting-select\" id=\"set-resolution\">\n            <option value=\"960x600\">960 × 600</option>\n            <option value=\"1280x800\" selected>1280 × 800</option>\n            <option value=\"1600x900\">1600 × 900</option>\n            <option value=\"1920x1080\">1920 × 1080</option>\n          </select>\n        </div>\n        <div class=\"setting-row\">\n          <span class=\"setting-label\">全屏</span>\n          <button class=\"setting-toggle\" id=\"set-fullscreen\"></button>\n        </div>\n        <div class=\"setting-row\">\n          <span class=\"setting-label\">画质</span>\n          <select class=\"setting-select\" id=\"set-quality\">\n            <option value=\"low\">低</option>\n            <option value=\"medium\">中</option>\n            <option value=\"high\" selected>高</option>\n          </select>\n        </div>\n        <div class=\"setting-row\">\n          <span class=\"setting-label\">显示FPS</span>\n          <button class=\"setting-toggle on\" id=\"set-showfps\"></button>\n        </div>\n      </div>\n\n      <div class=\"settings-group\">\n        <div class=\"settings-group-label\">💾 存储</div>\n        <div class=\"setting-row\">\n          <span class=\"setting-label\">自动保存</span>\n          <select class=\"setting-select\" id=\"set-autosave\">\n            <option value=\"30\">每30秒</option>\n            <option value=\"60\" selected>每60秒</option>\n            <option value=\"120\">每2分钟</option>\n            <option value=\"300\">每5分钟</option>\n          </select>\n        </div>\n      </div>\n\n      <div class=\"settings-actions\">\n        <button class=\"settings-btn\" id=\"btn-settings-cancel\">取消</button>\n        <button class=\"settings-btn save\" id=\"btn-settings-save\">保存设置</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- ========== GAME UI ========== -->\n  <div id=\"game-ui\">\n    <div id=\"toolbar\">\n      <h1>⛰ 修仙工厂</h1>\n      <div class=\"spacer\"></div>\n      <button class=\"toolbar-btn\" id=\"btn-audio\" title=\"音效开关\">🔊</button>\n      <button class=\"toolbar-btn\" id=\"btn-menu\" title=\"返回菜单\">☰ 菜单</button>\n      <button class=\"toolbar-btn\" id=\"btn-settings-ingame\" title=\"设置\">⚙ 设置</button>\n      <button class=\"toolbar-btn\" id=\"btn-save\" title=\"保存游戏\">💾 保存</button>\n      <button class=\"toolbar-btn\" id=\"btn-center\" title=\"居中视角\">◎ 居中</button>\n      <button class=\"toolbar-btn\" id=\"btn-reset\" title=\"重置游戏\">⚠ 重置</button>\n    </div>\n    <div id=\"main\">\n      <div id=\"sidebar\">\n        <div class=\"sidebar-section\">\n          <h3>🗺 区域</h3>\n          <div id=\"region-list\" class=\"region-nav\"></div>\n        </div>\n        <div class=\"sidebar-section\">\n          <h3>🏗 建筑设施</h3>\n          <div class=\"building-tabs\" id=\"building-tabs\">\n            <button class=\"building-tab active\" data-cat=\"all\">全部</button>\n            <button class=\"building-tab\" data-cat=\"mining\">⛏ 矿</button>\n            <button class=\"building-tab\" data-cat=\"farming\">🌿 田</button>\n            <button class=\"building-tab\" data-cat=\"alchemy\">🔥 炉</button>\n            <button class=\"building-tab\" data-cat=\"transport\">➡ 道</button>\n            <button class=\"building-tab\" data-cat=\"automation\">🤖 傀</button>\n          </div>\n          <div id=\"building-list\"></div>\n        </div>\n        <div class=\"sidebar-section\">\n          <h3>🔬 炼丹配方</h3>\n          <div id=\"recipe-list\"></div>\n        </div>\n      </div>\n      <div id=\"canvas-container\">\n        <canvas id=\"gameCanvas\"></canvas>\n        <div id=\"placement-hint\">点击地图放置建筑 | ESC 取消</div>\n        <div id=\"notifications\"></div>\n      </div>\n      <div id=\"info-panel\">\n        <!-- Realm panel -->\n        <div class=\"realm-panel\" id=\"realm-panel\">\n          <div class=\"realm-name\" id=\"realm-name\">凡人</div>\n          <div class=\"realm-exp-bar\">\n            <div class=\"realm-exp-fill\" id=\"realm-exp-fill\" style=\"width:0%\"></div>\n            <div class=\"realm-exp-text\" id=\"realm-exp-text\">0%</div>\n          </div>\n          <div id=\"breakthrough-reqs\"></div>\n          <button class=\"breakthrough-btn\" id=\"btn-breakthrough\" disabled>境界突破</button>\n        </div>\n\n        <!-- Tab bar -->\n        <div class=\"tab-bar\">\n          <button class=\"tab-btn active\" data-tab=\"inventory\">🎒 丹药</button>\n          <button class=\"tab-btn\" data-tab=\"info\">📊 信息</button>\n          <button class=\"tab-btn\" data-tab=\"alchemy\">🔥 炼丹</button>\n        </div>\n\n        <!-- Inventory tab -->\n        <div class=\"tab-content active\" id=\"tab-inventory\">\n          <div class=\"inventory-panel\">\n            <h3>💊 丹药背包</h3>\n            <div id=\"pill-list\"><div class=\"info-entry\">暂无丹药</div></div>\n          </div>\n        </div>\n\n        <!-- Info tab -->\n        <div class=\"tab-content\" id=\"tab-info\">\n          <div id=\"building-info\"><div class=\"info-entry\">点击建筑查看详情</div></div>\n        </div>\n\n        <!-- Alchemy tab -->\n        <div class=\"tab-content\" id=\"tab-alchemy\">\n          <div class=\"alchemy-panel\">\n            <h3>🔥 炼丹进度</h3>\n            <div id=\"alchemy-status\">\n              <div class=\"info-entry\">选择配方开始炼丹</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div id=\"statusbar\">\n      <span class=\"fps\" id=\"fps-display\">FPS: --</span>\n      <span id=\"status-text\">就绪</span>\n      <div class=\"spacer\"></div>\n      <span id=\"playtime\">游玩时间: 0:00</span>\n    </div>\n  </div>\n\n  <script type=\"module\">\n    import { App } from './src/renderer/App.ts';\n    import { loadSettings, saveSettings, updateSetting, getAvailableResolutions, getDefaultSettings } from './src/game/Settings.ts';\n\n    // ==================== LOADING SCREEN ====================\n    const loadingScreen = document.getElementById('loading-screen');\n    const loadingFill = document.getElementById('loading-fill');\n    const loadingText = document.getElementById('loading-text');\n\n    // Particle animation on loading screen\n    const loadCanvas = document.getElementById('loading-particles');\n    const loadCtx = loadCanvas.getContext('2d');\n    loadCanvas.width = window.innerWidth;\n    loadCanvas.height = window.innerHeight;\n\n    const particles = Array.from({ length: 40 }, () => ({\n      x: Math.random() * loadCanvas.width,\n      y: Math.random() * loadCanvas.height,\n      vx: (Math.random() - 0.5) * 0.3,\n      vy: -Math.random() * 0.5 - 0.2,\n      size: Math.random() * 2 + 0.5,\n      alpha: Math.random() * 0.5 + 0.1,\n    }));\n\n    let loadAnimId: number;\n    function animateLoading() {\n      loadCtx.clearRect(0, 0, loadCanvas.width, loadCanvas.height);\n      for (const p of particles) {\n        p.x += p.vx;\n        p.y += p.vy;\n        if (p.y < -10) { p.y = loadCanvas.height + 10; p.x = Math.random() * loadCanvas.width; }\n        loadCtx.fillStyle = `rgba(255, 215, 0, ${p.alpha})`;\n        loadCtx.beginPath();\n        loadCtx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\n        loadCtx.fill();\n      }\n      loadAnimId = requestAnimationFrame(animateLoading);\n    }\n    animateLoading();\n\n    // Simulate loading progress\n    let loadProgress = 0;\n    const loadMessages = ['正在加载资源...', '初始化灵脉...', '唤醒傀儡...', '点燃丹炉...', '准备就绪'];\n    const loadInterval = setInterval(() => {\n      loadProgress += Math.random() * 15 + 5;\n      if (loadProgress >= 100) loadProgress = 100;\n      loadingFill.style.width = `${loadProgress}%`;\n      loadingText.textContent = loadMessages[Math.min(4, Math.floor(loadProgress / 25))];\n      if (loadProgress >= 100) {\n        clearInterval(loadInterval);\n        setTimeout(() => {\n          cancelAnimationFrame(loadAnimId);\n          loadingScreen.classList.add('fade-out');\n          setTimeout(() => {\n            loadingScreen.style.display = 'none';\n            showMainMenu();\n          }, 800);\n        }, 300);\n      }\n    }, 200);\n\n    // ==================== MAIN MENU ====================\n    const mainMenu = document.getElementById('main-menu');\n    const steamStatus = document.getElementById('steam-status');\n    const gameUI = document.getElementById('game-ui');\n    let app: App | null = null;\n    let isGameRunning = false;\n\n    // Check Steam availability\n    const electronAPI = (window as any).electronAPI;\n    if (electronAPI) {\n      electronAPI.isSteamAvailable().then((available: boolean) => {\n        steamStatus.textContent = available ? '✓ Steam 已连接' : '— 离线模式';\n        steamStatus.className = `steam-status${available ? '' : ' offline'}`;\n        const version = document.getElementById('menu-version');\n        electronAPI.getAppVersion().then((v: string) => {\n          version.textContent = `v${v}`;\n        });\n      });\n    } else {\n      steamStatus.textContent = '— 浏览器模式';\n      steamStatus.className = 'steam-status offline';\n    }\n\n    function showMainMenu() {\n      mainMenu.classList.add('active');\n      if (isGameRunning && app) {\n        app.stop();\n        isGameRunning = false;\n      }\n    }\n\n    function startGame(newGame: boolean) {\n      mainMenu.classList.remove('active');\n      gameUI.classList.add('active');\n      isGameRunning = true;\n\n      if (!app) {\n        const canvas = document.getElementById('gameCanvas') as HTMLCanvasElement;\n        app = new App(canvas);\n        setupGameUI();\n      } else if (newGame) {\n        import('./src/game/GameState.ts').then(({ clearSave }) => {\n          clearSave();\n          location.reload();\n        });\n        return;\n      }\n\n      app.centerCamera();\n      app.start();\n    }\n\n    // Menu buttons\n    document.getElementById('btn-continue').addEventListener('click', () => startGame(false));\n    document.getElementById('btn-new-game').addEventListener('click', () => {\n      if (isGameRunning) {\n        if (confirm('开始新游戏将清除当前进度，确定吗？')) {\n          startGame(true);\n        }\n      } else {\n        startGame(true);\n      }\n    });\n    document.getElementById('btn-settings').addEventListener('click', () => showSettings());\n    document.getElementById('btn-quit').addEventListener('click', () => {\n      if (electronAPI) {\n        electronAPI.quit();\n      } else {\n        if (confirm('确定要退出游戏吗？')) {\n          window.close();\n        }\n      }\n    });\n\n    // ==================== SETTINGS PAGE ====================\n    const settingsPage = document.getElementById('settings-page');\n    let settings = loadSettings();\n    let previousPage = 'menu'; // 'menu' or 'game'\n\n    function showSettings() {\n      previousPage = mainMenu.classList.contains('active') ? 'menu' : 'game';\n      settingsPage.classList.add('active');\n      populateSettings();\n    }\n\n    function hideSettings() {\n      settingsPage.classList.remove('active');\n    }\n\n    function populateSettings() {\n      (document.getElementById('set-master-vol') as HTMLInputElement).value = String(settings.masterVolume);\n      document.getElementById('val-master-vol').textContent = String(settings.masterVolume);\n      (document.getElementById('set-sfx-vol') as HTMLInputElement).value = String(settings.sfxVolume);\n      document.getElementById('val-sfx-vol').textContent = String(settings.sfxVolume);\n      (document.getElementById('set-music-vol') as HTMLInputElement).value = String(settings.musicVolume);\n      document.getElementById('val-music-vol').textContent = String(settings.musicVolume);\n\n      const resKey = `${settings.resolution.width}x${settings.resolution.height}`;\n      (document.getElementById('set-resolution') as HTMLSelectElement).value = resKey;\n\n      const fsBtn = document.getElementById('set-fullscreen');\n      fsBtn.classList.toggle('on', settings.fullscreen);\n\n      const fpsBtn = document.getElementById('set-showfps');\n      fpsBtn.classList.toggle('on', settings.showFPS);\n\n      (document.getElementById('set-quality') as HTMLSelectElement).value = settings.particleQuality;\n      (document.getElementById('set-autosave') as HTMLSelectElement).value = String(settings.autoSaveInterval);\n    }\n\n    // Slider bindings\n    ['master-vol', 'sfx-vol', 'music-vol'].forEach(key => {\n      const slider = document.getElementById(`set-${key}`) as HTMLInputElement;\n      const label = document.getElementById(`val-${key}`);\n      slider.addEventListener('input', () => { label.textContent = slider.value; });\n    });\n\n    // Toggle bindings\n    ['set-fullscreen', 'set-showfps'].forEach(id => {\n      document.getElementById(id).addEventListener('click', function() {\n        this.classList.toggle('on');\n      });\n    });\n\n    document.getElementById('btn-settings-cancel').addEventListener('click', hideSettings);\n    document.getElementById('btn-settings-save').addEventListener('click', () => {\n      const masterVol = parseInt((document.getElementById('set-master-vol') as HTMLInputElement).value);\n      const sfxVol = parseInt((document.getElementById('set-sfx-vol') as HTMLInputElement).value);\n      const musicVol = parseInt((document.getElementById('set-music-vol') as HTMLInputElement).value);\n      const resVal = (document.getElementById('set-resolution') as HTMLSelectElement).value.split('x');\n      const fullscreen = document.getElementById('set-fullscreen').classList.contains('on');\n      const showFPS = document.getElementById('set-showfps').classList.contains('on');\n      const quality = (document.getElementById('set-quality') as HTMLSelectElement).value;\n      const autoSave = parseInt((document.getElementById('set-autosave') as HTMLSelectElement).value);\n\n      settings = {\n        masterVolume: masterVol,\n        sfxVolume: sfxVol,\n        musicVolume: musicVol,\n        resolution: { width: parseInt(resVal[0]), height: parseInt(resVal[1]) },\n        fullscreen,\n        language: 'zh-CN',\n        autoSaveInterval: autoSave,\n        showFPS,\n        particleQuality: quality as any,\n      };\n      saveSettings(settings);\n\n      // Apply Electron-level settings\n      if (electronAPI) {\n        electronAPI.setFullscreen(fullscreen);\n        electronAPI.setResolution(parseInt(resVal[0]), parseInt(resVal[1]));\n      }\n\n      hideSettings();\n    });\n\n    // Settings from toolbar\n    document.getElementById('btn-settings-ingame').addEventListener('click', showSettings);\n\n    // ==================== GAME UI SETUP ====================\n    function setupGameUI() {\n      if (!app) return;\n\n      const canvas = document.getElementById('gameCanvas') as HTMLCanvasElement;\n\n      // FPS counter\n      let frameCount = 0;\n      let fpsTime = performance.now();\n      const fpsDisplay = document.getElementById('fps-display');\n      const statusText = document.getElementById('status-text');\n      const playtimeDisplay = document.getElementById('playtime');\n\n      setInterval(() => {\n        const now = performance.now();\n        const fps = Math.round(frameCount * 1000 / (now - fpsTime));\n        fpsDisplay.textContent = `FPS: ${fps}`;\n        fpsDisplay.style.display = settings.showFPS ? '' : 'none';\n        frameCount = 0;\n        fpsTime = now;\n\n        if (app) {\n          const secs = Math.floor(app.state.totalPlaytime);\n          const mins = Math.floor(secs / 60);\n          const hrs = Math.floor(mins / 60);\n          playtimeDisplay.textContent = `游玩时间: ${hrs}:${String(mins % 60).padStart(2, '0')}`;\n        }\n      }, 1000);\n\n      const origLoop = app.loop.bind(app);\n      app.loop = (now) => { frameCount++; origLoop(now); };\n\n      // === Notifications ===\n      const notifContainer = document.getElementById('notifications');\n      app.onNotification = (notif) => {\n        const el = document.createElement('div');\n        el.className = `notif ${notif.type}`;\n        el.textContent = notif.text;\n        notifContainer.appendChild(el);\n        requestAnimationFrame(() => el.classList.add('show'));\n        setTimeout(() => {\n          el.classList.remove('show');\n          setTimeout(() => el.remove(), 300);\n        }, 3000);\n      };\n\n      // === Tabs ===\n      document.querySelectorAll('.tab-btn').forEach(btn => {\n        btn.addEventListener('click', () => {\n          document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\n          document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));\n          btn.classList.add('active');\n          document.getElementById(`tab-${(btn as HTMLElement).dataset.tab}`).classList.add('active');\n        });\n      });\n\n      // === Building sidebar ===\n      const buildingList = document.getElementById('building-list');\n      const placementHint = document.getElementById('placement-hint');\n\n      function renderBuildingList() {\n        buildingList.innerHTML = '';\n        let available = app!.getAvailableBuildings();\n        if (buildingCategoryFilter !== 'all') {\n          available = available.filter(d => d.category === buildingCategoryFilter);\n        }\n        for (const def of available) {\n          const item = document.createElement('div');\n          item.className = 'building-item';\n          if (app!.placementMode?.id === def.id) item.classList.add('selected');\n\n          const affordable = !Object.keys(def.cost).length ||\n            Object.entries(def.cost).every(([r, c]) => (app!.state.resources[r] ?? 0) >= c);\n\n          const icon = getIcon(def.category);\n          const costStr = Object.entries(def.cost).length > 0\n            ? Object.entries(def.cost).map(([r, c]) => `${getResourceName(r)}:${c}`).join(' ')\n            : '免费';\n\n          item.innerHTML = `\n            <span class=\"icon\">${icon}</span>\n            <div class=\"info\">\n              <div class=\"name\">${def.name}</div>\n              <div class=\"cost ${affordable ? '' : 'cannot'}\">${costStr}</div>\n            </div>\n          `;\n\n          item.addEventListener('click', () => {\n            if (app!.placementMode?.id === def.id) {\n              app!.placementMode = null;\n              placementHint.style.display = 'none';\n              statusText.textContent = '就绪';\n            } else {\n              app!.placementMode = def;\n              placementHint.style.display = 'block';\n              statusText.textContent = `放置模式: ${def.name}`;\n            }\n            renderBuildingList();\n          });\n\n          buildingList.appendChild(item);\n        }\n      }\n\n      function getIcon(category) {\n        const icons = { mining: '⛏', farming: '🌿', alchemy: '🔥', energy: '✨', cultivation: '🧘', transport: '➡', automation: '🤖', control: '📜', processing: '🔩' };\n        return icons[category] || '🏠';\n      }\n\n      function getResourceName(id) {\n        const names = {\n          spirit_stone: '灵石', spirit_grass: '灵草', spirit_energy: '灵气',\n          cultivation: '修为', pill_juling: '聚灵丹', pill_peiyuan: '培元丹',\n          pill_ningqi: '凝气丹', pill_zhuji: '筑基丹', pill_jindanyin: '金丹引',\n          spirit_iron: '灵铁', spirit_wood: '灵木', talisman_paper: '符纸',\n        };\n        return names[id] ?? id;\n      }\n\n      // === Building category filter ===\n      let buildingCategoryFilter = 'all';\n      document.querySelectorAll('#building-tabs .building-tab').forEach(btn => {\n        btn.addEventListener('click', () => {\n          document.querySelectorAll('.building-tab').forEach(b => b.classList.remove('active'));\n          btn.classList.add('active');\n          buildingCategoryFilter = (btn as HTMLElement).dataset.cat!;\n          renderBuildingList();\n        });\n      });\n\n      renderBuildingList();\n\n      // === Region navigation ===\n      function renderRegionList() {\n        const regionList = document.getElementById('region-list');\n        regionList.innerHTML = '';\n        const regions = app!.getUnlockedRegions();\n        for (const r of regions) {\n          const btn = document.createElement('button');\n          btn.className = 'region-btn' + (r.index === app!.currentRegionIndex ? ' active' : '');\n          btn.textContent = r.name;\n          btn.addEventListener('click', () => {\n            app!.switchRegion(r.index);\n            renderRegionList();\n          });\n          regionList.appendChild(btn);\n        }\n        const allRegions = [\n          { name: '炼气坪', unlock: 'liqi_1' },\n          { name: '灵田区', unlock: 'liqi_5' },\n          { name: '灵石矿区', unlock: 'liqi_8' },\n          { name: '筑基台', unlock: 'zhuji_1' },\n          { name: '药王谷', unlock: 'zhuji_10' },\n          { name: '丹鼎峰', unlock: 'jindan_1' },\n          { name: '矿脉山', unlock: 'jindan_5' },\n        ];\n        const unlockedNames = new Set(regions.map(r => r.name));\n        for (const ar of allRegions) {\n          if (!unlockedNames.has(ar.name)) {\n            const btn = document.createElement('button');\n            btn.className = 'region-btn locked';\n            btn.textContent = `🔒 ${ar.name}`;\n            btn.title = `需要达到 ${ar.unlock.replace('_', ' Lv')} 解锁`;\n            regionList.appendChild(btn);\n          }\n        }\n      }\n\n      renderRegionList();\n      app.onRegionChange = () => { renderRegionList(); };\n\n      // === Recipe sidebar ===\n      function renderRecipeList() {\n        const recipeList = document.getElementById('recipe-list');\n        recipeList.innerHTML = '';\n        const recipes = app!.getAvailableAlchemyRecipes();\n        for (const recipe of recipes) {\n          const item = document.createElement('div');\n          item.className = 'recipe-item';\n\n          const ingredients = Object.entries(recipe.ingredients)\n            .map(([r, c]) => `${getResourceName(r)}:${c}`).join(' ');\n          const canCraftNow = app!.state.alchemySession === null &&\n            Object.entries(recipe.ingredients).every(([r, c]) => (app!.state.resources[r] ?? 0) >= c);\n\n          item.innerHTML = `\n            <span style=\"color:${recipe.output.resource === 'pill_juling' ? '#ff8c32' : recipe.output.resource === 'pill_peiyuan' ? '#ff6699' : '#cc66ff'}\">💊</span>\n            <span class=\"recipe-name\">${recipe.name}</span>\n            <button class=\"recipe-craft-btn\" ${canCraftNow ? '' : 'disabled'}>${ingredients}</button>\n          `;\n\n          item.querySelector('.recipe-craft-btn').addEventListener('click', () => {\n            app!.startAlchemyAction(recipe.id);\n          });\n\n          recipeList.appendChild(item);\n        }\n      }\n\n      // === Realm panel ===\n      function renderRealmPanel() {\n        const c = app!.state.cultivation;\n        const nameEl = document.getElementById('realm-name');\n        const fillEl = document.getElementById('realm-exp-fill');\n        const textEl = document.getElementById('realm-exp-text');\n        const reqsEl = document.getElementById('breakthrough-reqs');\n        const btnEl = document.getElementById('btn-breakthrough');\n\n        import('./src/game/Cultivation.ts').then(({ getFullRealmName, canBreakthrough, getBreakthroughRequirements, getSubStageName }) => {\n          nameEl.textContent = getFullRealmName(c);\n          const ratio = c.exp / c.expToNext;\n          fillEl.style.width = `${Math.floor(ratio * 100)}%`;\n          textEl.textContent = `${Math.floor(ratio * 100)}%`;\n\n          const reqs = getBreakthroughRequirements(c);\n          reqsEl.innerHTML = '';\n\n          if (reqs.canAttempt || c.level >= 3) {\n            for (const [res, amount] of Object.entries(reqs.resourceCost)) {\n              const current = app!.state.resources[res] ?? 0;\n              const met = current >= amount;\n              reqsEl.innerHTML += `<div class=\"breakthrough-req ${met ? 'met' : 'unmet'}\">${met ? '✓' : '✗'} ${getResourceName(res)}: ${current}/${amount}</div>`;\n            }\n            if (reqs.needsPill && reqs.pillId) {\n              const current = app!.state.resources[reqs.pillId] ?? 0;\n              const met = current >= reqs.pillCount;\n              reqsEl.innerHTML += `<div class=\"breakthrough-req ${met ? 'met' : 'unmet'}\">${met ? '✓' : '✗'} ${getResourceName(reqs.pillId)}: ${current}/${reqs.pillCount}</div>`;\n            }\n            reqsEl.innerHTML += `<div class=\"breakthrough-req\" style=\"color:#aaa\">成功率: ${Math.floor(reqs.successRate * 100)}%</div>`;\n\n            const canAttempt = reqs.canAttempt &&\n              Object.entries(reqs.resourceCost).every(([r, a]) => (app!.state.resources[r] ?? 0) >= a) &&\n              (!reqs.needsPill || (app!.state.resources[reqs.pillId ?? ''] ?? 0) >= (reqs.pillCount ?? 0));\n\n            btnEl.disabled = !canAttempt;\n          } else {\n            reqsEl.innerHTML = `<div class=\"breakthrough-req\" style=\"color:#666\">修为满级后可突破</div>`;\n            btnEl.disabled = true;\n          }\n        });\n      }\n\n      // === Inventory panel ===\n      function renderInventory() {\n        const pillList = document.getElementById('pill-list');\n        const pills = app!.getInventoryPills();\n\n        if (pills.length === 0) {\n          pillList.innerHTML = '<div class=\"info-entry\" style=\"color:#555\">暂无丹药</div>';\n          return;\n        }\n\n        pillList.innerHTML = '';\n        for (const pill of pills) {\n          const item = document.createElement('div');\n          item.className = 'pill-item';\n          item.innerHTML = `\n            <span style=\"color:${pill.color}\">💊</span>\n            <span class=\"pill-name\">${pill.name}</span>\n            <span class=\"pill-count\">×${pill.count}</span>\n            <button class=\"pill-use-btn\" data-id=\"${pill.id}\">服用</button>\n            ${pill.count > 1 ? `<button class=\"pill-use-all-btn\" data-id=\"${pill.id}\">全部</button>` : ''}\n          `;\n          pillList.appendChild(item);\n        }\n\n        pillList.querySelectorAll('.pill-use-btn').forEach(btn => {\n          btn.addEventListener('click', () => app!.usePillAction((btn as HTMLElement).dataset.id!));\n        });\n        pillList.querySelectorAll('.pill-use-all-btn').forEach(btn => {\n          btn.addEventListener('click', () => app!.useAllPills((btn as HTMLElement).dataset.id!));\n        });\n      }\n\n      // === Alchemy status ===\n      function renderAlchemyStatus() {\n        const statusEl = document.getElementById('alchemy-status');\n        const session = app!.state.alchemySession;\n\n        if (!session) {\n          statusEl.innerHTML = '<div class=\"info-entry\">选择配方开始炼丹</div>';\n          return;\n        }\n\n        const progress = Math.floor(session.progress * 100);\n        statusEl.innerHTML = `\n          <div class=\"info-entry\" style=\"color:#ff8c32\">${session.recipeId === 'pill_juling' ? '聚灵丹' : session.recipeId === 'pill_peiyuan' ? '培元丹' : '凝气丹'}</div>\n          <div class=\"alchemy-progress\">\n            <div class=\"alchemy-progress-fill\" style=\"width:${progress}%\"></div>\n            <div class=\"alchemy-progress-text\">${progress}%</div>\n          </div>\n          ${session.complete ? '<button class=\"alchemy-collect-btn\" id=\"btn-collect-alchemy\">收取丹药</button>' : ''}\n        `;\n\n        const collectBtn = document.getElementById('btn-collect-alchemy');\n        if (collectBtn) {\n          collectBtn.addEventListener('click', () => app!.collectAlchemyAction());\n        }\n      }\n\n      // === Building info ===\n      function updateBuildingInfo(building) {\n        const infoDiv = document.getElementById('building-info');\n        if (!building) {\n          infoDiv.innerHTML = '<div class=\"info-entry\">点击建筑查看详情</div>';\n          return;\n        }\n        const def = app!.buildingDefs.get(building.buildingId);\n        if (!def) return;\n        const prod = def.production;\n        infoDiv.innerHTML = `\n          <div class=\"info-entry\" style=\"color:#ffd700;font-weight:bold\">${def.name}</div>\n          <div class=\"info-entry\">等级: ${building.level}/${def.maxLevel}</div>\n          <div class=\"info-entry\">类型: ${prod.mode === 'manual' ? '手动' : '自动'}</div>\n          <div class=\"info-entry\">产出: ${getResourceName(prod.resource)} ×${prod.amount}</div>\n          ${prod.interval > 0 ? `<div class=\"info-entry\">间隔: ${(prod.interval / 1000).toFixed(1)}s</div>` : ''}\n          ${prod.input ? `<div class=\"info-entry\">消耗: ${Object.entries(prod.input).map(([r,c]) => `${getResourceName(r)}:${c}`).join(' ')}</div>` : ''}\n          <div class=\"info-entry\">状态: ${building.isProducing ? '生产中' : '空闲'}</div>\n          ${building.progress > 0 ? `<div class=\"info-entry\">进度: ${Math.floor(building.progress * 100)}%</div>` : ''}\n        `;\n      }\n\n      // === State change handler ===\n      app.onStateChange = (state) => {\n        renderBuildingList();\n        renderRecipeList();\n        renderRealmPanel();\n        renderInventory();\n        renderAlchemyStatus();\n      };\n\n      app.onBuildingSelect = (building) => {\n        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\n        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));\n        document.querySelector('[data-tab=\"info\"]').classList.add('active');\n        document.getElementById('tab-info').classList.add('active');\n        updateBuildingInfo(building);\n      };\n\n      app.onAlchemyUpdate = (session) => {\n        renderAlchemyStatus();\n      };\n\n      // === Breakthrough ===\n      document.getElementById('btn-breakthrough').addEventListener('click', () => {\n        app!.attemptBreakthroughAction();\n      });\n\n      // === Toolbar buttons ===\n      document.getElementById('btn-save').addEventListener('click', () => {\n        import('./src/game/GameState.ts').then(({ saveGame }) => {\n          saveGame(app!.state);\n          app!.addNotification('游戏已保存', 'info');\n        });\n      });\n\n      document.getElementById('btn-center').addEventListener('click', () => {\n        app!.centerCamera();\n      });\n\n      document.getElementById('btn-reset').addEventListener('click', () => {\n        if (confirm('确定要重置游戏进度吗？此操作不可撤销！')) {\n          import('./src/game/GameState.ts').then(({ clearSave }) => {\n            clearSave();\n            location.reload();\n          });\n        }\n      });\n\n      // Back to menu\n      document.getElementById('btn-menu').addEventListener('click', () => {\n        if (confirm('返回主菜单？当前进度已自动保存。')) {\n          app!.stop();\n          gameUI.classList.remove('active');\n          showMainMenu();\n        }\n      });\n\n      // Audio toggle\n      import('./src/game/AudioManager.ts').then(({ audioManager }) => {\n        const audioBtn = document.getElementById('btn-audio');\n        audioBtn.addEventListener('click', () => {\n          audioManager.init();\n          const muted = audioManager.toggleMute();\n          audioBtn.textContent = muted ? '🔇' : '🔊';\n        });\n      });\n\n      // Initial render\n      renderRealmPanel();\n      renderInventory();\n      renderAlchemyStatus();\n      renderRecipeList();\n    }\n  </script>\n</body>\n</html>\n","numLines":1252,"startLine":1,"totalLines":1252}}}
