const has = this.board.findAllMatches().length > 0;\n262\t    this.board.swap(r1, c1, r2, c2);\n263\t    return has;\n264\t  }\n265\t}\n266\t\n267\tif (typeof module !== 'undefined') module.exports = { MatchEngine, MatchResult };\n268\t"}]},"parent_tool_use_id":null,"session_id":"efc4c585-24c5-4fd5-bbba-79c262b1755c","uuid":"8a69ff0c-506f-40d7-8c4e-5f646f3f5028","timestamp":"2026-05-22T22:33:20.563Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\douyin-match3\\src\\js\\MatchEngine.js","content":"// MatchEngine.js — Match detection, special tile generation, cascade processing\n\nclass MatchResult {\n  constructor() {\n    this.toRemove = new Set();       // \"row,col\" strings\n    this.specials = [];              // { row, col, type, color }\n    this.chainCount = 0;\n    this.totalScore = 0;\n    this.removedByColor = {};        // color -> count for collection goals\n    this.comboText = '';\n  }\n}\n\nclass MatchEngine {\n  constructor(board) {\n    this.board = board;\n    this.onSpecialTrigger = null;    // callback(tile, type)\n  }\n\n  // Full cascade: find matches → remove → gravity → repeat\n  processCascade() {\n    const result = new MatchResult();\n    let chainCount = 0;\n\n    const process = () => {\n      const matches = this.board.findAllMatches();\n      if (matches.length === 0) return Promise.resolve();\n\n      chainCount++;\n      result.chainCount = chainCount;\n\n      // Detect L/T shapes\n      const lShapes = this.board.findLShapeMatches(matches);\n\n      // Determine which cells to remove and what specials to create\n      const { removeCells, specials } = this._classifyMatches(matches, lShapes);\n\n      // Track removed tiles by color\n      for (const key of removeCells) {\n        const [r, c] = key.split(',').map(Number);\n        const tile = this.board.getTile(r, c);\n        if (tile && tile.color >= 0) {\n          result.removedByColor[tile.color] = (result.removedByColor[tile.color] || 0) + 1;\n        }\n        result.toRemove.add(key);\n      }\n\n      // Calculate score\n      const multiplier = chainCount <= 1 ? 1 : chainCount === 2 ? 1.5 : chainCount === 3 ? 2.0 : 2.5;\n      const baseScore = removeCells.size * 10;\n      result.totalScore += Math.floor(baseScore * multiplier);\n\n      // Set combo text\n      if (chainCount >= 4) result.comboText = '超赞！！';\n      else if (chainCount === 3) result.comboText = '太棒了！';\n      else if (chainCount === 2) result.comboText = '不错！';\n\n      // Mark specials to create (don't remove these cells yet)\n      for (const sp of specials) {\n        result.specials.push(sp);\n      }\n\n      // Remove matched tiles (except those becoming specials)\n      const specialPositions = new Set(specials.map(s => `${s.row},${s.col}`));\n      for (const key of removeCells) {\n        if (!specialPositions.has(key)) {\n          const [r, c] = key.split(',').map(Number);\n          this.board.removeTile(r, c);\n        }\n      }\n\n      // Create special tiles in place\n      for (const sp of specials) {\n        const tile = this.board.getTile(sp.row, sp.col);\n        if (tile) {\n          tile.special = sp.type;\n          tile.removing = false;\n        }\n      }\n\n      return new Promise(resolve => {\n        // Gravity + fill\n        setTimeout(() => {\n          const drops = this.board.applyGravity();\n          // Clear nulls\n          for (let r = 0; r < this.board.size; r++) {\n            for (let c = 0; c < this.board.size; c++) {\n              if (this.board.grid[r][c] && this.board.grid[r][c].removing) {\n                this.board.clearCell(r, c);\n              }\n            }\n          }\n\n          // Animate drops then check for more matches\n          setTimeout(() => process().then(resolve), 250);\n        }, 300);\n      });\n    };\n\n    return new Promise(resolve => {\n      process().then(() => {\n        result.chainCount = chainCount;\n        resolve(result);\n      });\n    });\n  }\n\n  // Synchronous version for cascade without animations\n  processCascadeSync() {\n    const result = new MatchResult();\n    let chainCount = 0;\n\n    while (true) {\n      const matches = this.board.findAllMatches();\n      if (matches.length === 0) break;\n\n      chainCount++;\n      const lShapes = this.board.findLShapeMatches(matches);\n      const { removeCells, specials } = this._classifyMatches(matches, lShapes);\n\n      for (const key of removeCells) {\n        const [r, c] = key.split(',').map(Number);\n        const tile = this.board.getTile(r, c);\n        if (tile && tile.color >= 0) {\n          result.removedByColor[tile.color] = (result.removedByColor[tile.color] || 0) + 1;\n        }\n        result.toRemove.add(key);\n      }\n\n      const multiplier = chainCount <= 1 ? 1 : chainCount === 2 ? 1.5 : chainCount === 3 ? 2.0 : 2.5;\n      result.totalScore += Math.floor(removeCells.size * 10 * multiplier);\n\n      if (chainCount >= 4) result.comboText = '超赞！！';\n      else if (chainCount === 3) result.comboText = '太棒了！';\n      else if (chainCount === 2) result.comboText = '不错！';\n\n      result.specials.push(...specials);\n\n      const specialPositions = new Set(specials.map(s => `${s.row},${s.col}`));\n      for (const key of removeCells) {\n        if (!specialPositions.has(key)) {\n          const [r, c] = key.split(',').map(Number);\n          this.board.clearCell(r, c);\n        }\n      }\n\n      for (const sp of specials) {\n        const tile = this.board.getTile(sp.row, sp.col);\n        if (tile) {\n          tile.special = sp.type;\n          tile.removing = false;\n        }\n      }\n\n      this.board.applyGravity();\n    }\n\n    result.chainCount = chainCount;\n    return result;\n  }\n\n  _classifyMatches(matches, lShapes) {\n    const removeCells = new Set();\n    const specials = [];\n    const lShapeCells = new Set();\n\n    // L/T shapes first (highest priority)\n    for (const l of lShapes) {\n      const center = l.cells[Math.floor(l.cells.length / 2)];\n      specials.push({ row: center.row, col: center.col, type: SPECIAL_BOMB, color: l.color });\n      for (const cell of l.cells) {\n        removeCells.add(`${cell.row},${cell.col}`);\n        lShapeCells.add(`${cell.row},${cell.col}`);\n      }\n    }\n\n    // Process remaining matches — skip any that overlap with L-shapes\n    for (const match of matches) {\n      const overlapCount = match.cells.filter(c => lShapeCells.has(`${c.row},${c.col}`)).length;\n      if (overlapCount > 0) {\n        // Already handled by L-shape, just add cells to remove set\n        for (const cell of match.cells) removeCells.add(`${cell.row},${cell.col}`);\n        continue;\n      }\n\n      for (const cell of match.cells) {\n        removeCells.add(`${cell.row},${cell.col}`);\n      }\n\n      if (match.length >= 5) {\n        const center = match.cells[Math.floor(match.cells.length / 2)];\n        specials.push({ row: center.row, col: center.col, type: SPECIAL_RAINBOW, color: match.color });\n      } else if (match.length === 4) {\n        const center = match.cells[1];\n        const type = match.direction === 'horizontal' ? SPECIAL_STRIPED_V : SPECIAL_STRIPED_H;\n        specials.push({ row: center.row, col: center.col, type, color: match.color });\n      }\n    }\n\n    return { removeCells, specials };\n  }\n\n  // Trigger a special tile's effect, return list of cells to remove\n  triggerSpecial(row, col) {\n    const tile = this.board.getTile(row, col);\n    if (!tile || tile.special === SPECIAL_NONE) return [];\n\n    const toRemove = [];\n\n    switch (tile.special) {\n      case SPECIAL_STRIPED_H:\n        for (let c = 0; c < this.board.size; c++) {\n          if (this.board.getTile(row, c)) toRemove.push({ row, col: c });\n        }\n        break;\n\n      case SPECIAL_STRIPED_V:\n        for (let r = 0; r < this.board.size; r++) {\n          if (this.board.getTile(r, col)) toRemove.push({ row: r, col });\n        }\n        break;\n\n      case SPECIAL_BOMB:\n        for (let dr = -1; dr <= 1; dr++) {\n          for (let dc = -1; dc <= 1; dc++) {\n            const nr = row + dr, nc = col + dc;\n            if (this.board.isValid(nr, nc) && this.board.getTile(nr, nc)) {\n              toRemove.push({ row: nr, col: nc });\n            }\n          }\n        }\n        break;\n\n      case SPECIAL_RAINBOW:\n        // Rainbow removes all tiles of a target color — we need the swap target's color\n        // This is handled externally via triggerRainbow()\n        break;\n    }\n\n    tile.special = SPECIAL_NONE;\n    return toRemove;\n  }\n\n  triggerRainbow(rainbowRow, rainbowCol, targetColor) {\n    const toRemove = [];\n    for (let r = 0; r < this.board.size; r++) {\n      for (let c = 0; c < this.board.size; c++) {\n        const tile = this.board.getTile(r, c);\n        if (tile && tile.color === targetColor) {\n          toRemove.push({ row: r, col: c });\n        }\n      }\n    }\n    return toRemove;\n  }\n\n  // Check if swapping two tiles results in a valid match\n  isValidSwap(r1, c1, r2, c2) {\n    if (!this.board.isAdjacent(r1, c1, r2, c2)) return false;\n    this.board.swap(r1, c1, r2, c2);\n    const has = this.board.findAllMatches().length > 0;\n    this.board.swap(r1, c1, r2, c2);\n    return has;\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { MatchEngine, MatchResult };\n","numLines":268,"startLine":1,"totalLines":268}}}
