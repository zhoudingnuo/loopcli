\n      // Phase 4: ad stub overlay consumes clicks first\n      if (game.adManager.handleStubClick(x, y, w, h)) return;\n\n      // Navigation screens\n      if (game.nav.isActive()) {\n        game.nav.handleClick(x, y, w, h);\n        return;\n      }\n\n      // In-game: check back-to-map button\n      const backX = w - 50;\n      const backY = game.renderer.boardY + game.renderer.tileSize * BOARD_SIZE + 25;\n      if (x >= backX && x <= backX + 40 && y >= backY && y <= backY + 28) {\n        game.nav.goTo('map');\n        return;\n      }\n    });","originalFile":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no, maximum-scale=1.0\">\n  <title>消消消大作战 - Match & Blast</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    html, body {\n      width: 100%; height: 100%;\n      overflow: hidden;\n      background: #FFF8E7;\n      touch-action: none;\n      -webkit-user-select: none;\n      user-select: none;\n    }\n    canvas {\n      display: block;\n      width: 100%;\n      height: 100%;\n    }\n  </style>\n</head>\n<body>\n  <canvas id=\"gameCanvas\"></canvas>\n\n  <!-- Phase 1+2: Core modules -->\n  <script src=\"src/js/Board.js\"></script>\n  <script src=\"src/js/MatchEngine.js\"></script>\n  <script src=\"src/js/Animation.js\"></script>\n  <script src=\"src/js/Obstacle.js\"></script>\n  <script src=\"src/js/AudioManager.js\"></script>\n  <script src=\"src/js/Boss.js\"></script>\n  <script src=\"src/js/levels.js\"></script>\n  <script src=\"src/js/Renderer.js\"></script>\n  <script src=\"src/js/InputHandler.js\"></script>\n  <script src=\"src/js/ScoreSystem.js\"></script>\n\n  <!-- Phase 3a: Meta-progression modules -->\n  <script src=\"src/js/DataManager.js\"></script>\n  <script src=\"src/js/CoinSystem.js\"></script>\n  <script src=\"src/js/Characters.js\"></script>\n  <script src=\"src/js/MapScreen.js\"></script>\n  <script src=\"src/js/ShopUI.js\"></script>\n\n  <!-- Phase 3b: Daily + Social -->\n  <script src=\"src/js/DailySystem.js\"></script>\n  <script src=\"src/js/SocialSystem.js\"></script>\n\n  <!-- Phase 4: Ads + Analytics -->\n  <script src=\"src/js/AdManager.js\"></script>\n  <script src=\"src/js/Analytics.js\"></script>\n\n  <script src=\"src/js/Navigation.js\"></script>\n\n  <!-- Main game -->\n  <script src=\"src/js/Game.js\"></script>\n\n  <script>\n    const canvas = document.getElementById('gameCanvas');\n    const game = new Game(canvas);\n\n    // Handle resize\n    function onResize() {\n      game.renderer.resize();\n      game.input.updateLayout(\n        game.renderer.tileSize,\n        game.renderer.boardX,\n        game.renderer.boardY,\n      );\n    }\n\n    window.addEventListener('resize', onResize);\n    window.addEventListener('orientationchange', () => setTimeout(onResize, 100));\n\n    // Unified click handler — routes through Navigation\n    canvas.addEventListener('click', (e) => {\n      const rect = canvas.getBoundingClientRect();\n      const x = e.clientX - rect.left;\n      const y = e.clientY - rect.top;\n      const w = game.renderer.screenW;\n      const h = game.renderer.screenH;\n\n      // Phase 4: ad stub overlay consumes clicks first\n      if (game.adManager.handleStubClick(x, y, w, h)) return;\n\n      // Navigation screens\n      if (game.nav.isActive()) {\n        game.nav.handleClick(x, y, w, h);\n        return;\n      }\n\n      // In-game: check back-to-map button\n      const backX = w - 50;\n      const backY = game.renderer.boardY + game.renderer.tileSize * BOARD_SIZE + 25;\n      if (x >= backX && x <= backX + 40 && y >= backY && y <= backY + 28) {\n        game.nav.goTo('map');\n        return;\n      }\n    });\n\n    // Start the game (shows main menu)\n    game.start();\n  </script>\n</body>\n</html>\n","structuredPatch":[{"oldStart":73,"oldLines":8,"newStart":73,"newLines":15,"lines":["     window.addEventList