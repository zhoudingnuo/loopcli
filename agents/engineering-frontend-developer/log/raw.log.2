s) {\n      this.target[key] = this.startProps[key] + (this.endProps[key] - this.startProps[key]) * easedT;\n    }\n\n    if (t >= 1) {\n      this.done = true;\n      if (this.onComplete) this.onComplete();\n      return true;\n    }\n    return false;\n  }\n}\n\nclass TweenManager {\n  constructor() {\n    this.tweens = [];\n  }\n\n  add(target, props, duration, easing, onComplete) {\n    const tween = new Tween(target, props, duration, easing, onComplete);\n    this.tweens.push(tween);\n    return tween;\n  }\n\n  update(dt) {\n    this.tweens = this.tweens.filter(t => !t.update(dt));\n  }\n\n  clear() {\n    this.tweens = [];\n  }\n\n  get activeCount() {\n    return this.tweens.length;\n  }\n}\n\n// Particle system for match effects\nclass Particle {\n  constructor(x, y, vx, vy, color, life, size) {\n    this.x = x;\n    this.y = y;\n    this.vx = vx;\n    this.vy = vy;\n    this.color = color;\n    this.life = life;\n    this.maxLife = life;\n    this.size = size;\n    this.alpha = 1;\n  }\n\n  update(dt) {\n    this.x += this.vx * dt;\n    this.y += this.vy * dt;\n    this.vy += 200 * dt; // gravity\n    this.life -= dt;\n    this.alpha = Math.max(0, this.life / this.maxLife);\n    return this.life <= 0;\n  }\n}\n\nclass ParticleSystem {\n  constructor() {\n    this.particles = [];\n  }\n\n  emit(x, y, color, count = 8) {\n    for (let i = 0; i < count; i++) {\n      const angle = (Math.PI * 2 / count) * i + Math.random() * 0.5;\n      const speed = 80 + Math.random() * 120;\n      const vx = Math.cos(angle) * speed;\n      const vy = Math.sin(angle) * speed - 50;\n      const life = 0.3 + Math.random() * 0.4;\n      const size = 3 + Math.random() * 4;\n      this.particles.push(new Particle(x, y, vx, vy, color, life, size));\n    }\n  }\n\n  emitExplosion(x, y, color, count = 16) {\n    for (let i = 0; i < count; i++) {\n      const angle = Math.random() * Math.PI * 2;\n      const speed = 50 + Math.random() * 200;\n      const vx = Math.cos(angle) * speed;\