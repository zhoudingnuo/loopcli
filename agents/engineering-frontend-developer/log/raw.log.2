{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_43945128b4c64e58876b2731","type":"tool_result","content":"1\t// Talisman.ts — 基础灵符条件触发系统\n2\t\n3\texport type TalismanCondition =\n4\t  | { type: 'resource_above'; resource: string; threshold: number }\n5\t  | { type: 'resource_below'; resource: string; threshold: number }\n6\t  | { type: 'building_count_above'; buildingId: string; threshold: number }\n7\t  | { type: 'realm_level_above'; level: number };\n8\t\n9\texport type TalismanAction =\n10\t  | { type: 'stop_building'; buildingUid: string }\n11\t  | { type: 'start_building'; buildingUid: string }\n12\t  | { type: 'set_production_rate'; buildingUid: string; multiplier: number }\n13\t  | { type: 'notify'; message: string };\n14\t\n15\texport interface TalismanInstance {\n16\t  uid: string;\n17\t  gridX: number;\n18\t  gridY: number;\n19\t  name: string;\n20\t  condition: TalismanCondition;\n21\t  action: TalismanAction;\n22\t  enabled: boolean;\n23\t  /** Cooldown between triggers (ms) */\n24\t  cooldown: number;\n25\t  /** Last trigger time */\n26\t  lastTriggered: number;\n27\t}\n28\t\n29\t// Evaluate a condition against current game state\n30\texport function evaluateCondition(\n31\t  condition: TalismanCondition,\n32\t  resources: Record<string, number>,\n33\t  buildingCounts: Record<string, number>,\n34\t  realmLevel: number,\n35\t): boolean {\n36\t  switch (condition.type) {\n37\t    case 'resource_above':\n38\t      return (resources[condition.resource] ?? 0) > condition.threshold;\n39\t    case 'resource_below':\n40\t      return (resources[condition.resource] ?? 0) < condition.threshold;\n41\t    case 'building_count_above':\n42\t      return (buildingCounts[condition.buildingId] ?? 0) > condition.threshold;\n43\t    case 'realm_level_above':\n44\t      return realmLevel >= condition.level;\n45\t  }\n46\t}\n47\t\n48\t// Create a talisman instance\n49\texport function createTalisman(\n50\t  uid: string,\n51\t  gridX: number,\n52\t  gridY: number,\n53\t  name: string,\n54\t  condition: TalismanCondition,\n55\t  action: TalismanAction,\n56\t): TalismanInstance {\n57\t  return {\n58\t    uid,\n59\t    gridX,\n60\t    gridY,\n61\t    name,\n62\t    condition,\n63\t    action,\n64\t    enabled: true,\n65\t    cooldown: 5000,\n66\t    lastTriggered: 0,\n67\t  };\n68\t}\n69\t\n70\t// Process all talismans and return triggered actions\n71\texport function processTalismans(\n72\t  talismans: TalismanInstance[],\n73\t  resources: Record<string, number>,\n74\t  buildingCounts: Record<string, number>,\n75\t  realmLevel: number,\n76\t  now: number,\n77\t): { talismans: TalismanInstance[]; actions: TalismanAction[] } {\n78\t  const updated: TalismanInstance[] = [];\n79\t  const actions: TalismanAction[] = [];\n80\t\n81\t  for (const t of talismans) {\n82\t    if (!t.enabled) {\n83\t      updated.push(t);\n84\t      continue;\n85\t    }\n86\t\n87\t    if (now - t.lastTriggered < t.cooldown) {\n88\t      updated.push(t);\n89\t      continue;\n90\t    }\n91\t\n92\t    const triggered = evaluateCondition(t.condition, resources, buildingCounts, realmLevel);\n93\t\n94\t    if (triggered) {\n95\t      actions.push(t.action);\n96\t      updated.push({ ...t, lastTriggered: now });\n97\t    } else {\n98\t      updated.push(t);\n99\t    }\n100\t  }\n101\t\n102\t  return { talismans: updated, actions };\n103\t}\n104\t\n105\t// Preset talisman templates\n106\texport const TALISMAN_PRESETS: Array<{\n107\t  id: string;\n108\t  name: string;\n109\t  description: string;\n110\t  condition: TalismanCondition;\n111\t  action: TalismanAction;\n112\t}> = [\n113\t  {\n114\t    id: 'auto_stop_field',\n115\t    name: '灵田自停符',\n116\t    description: '灵草超过50时停止灵田',\n117\t    condition: { type: 'resource_above', resource: 'spirit_grass', threshold: 50 },\n118\t    action: { type: 'notify', message: '灵草充足，灵田已暂停' },\n119\t  },\n120\t  {\n121\t    id: 'auto_stop_miner',\n122\t    name: '矿机自停符',\n123\t    description: '灵石超过200时停止矿机',\n124\t    condition: { type: 'resource_above', resource: 'spirit_stone', threshold: 200 },\n125\t    action: { type: 'notify', message: '灵石充足，矿机已暂停' },\n126\t  },\n127\t  {\n128\t    id: 'speed_boost',\n129\t    name: '加速灵符',\n130\t    description: '修为达到要求时加速生产',\n131\t    condition: { type: 'realm_level_above', level: 15 },\n132\t    action: { type: 'notify', message: '灵符激活，生产加速！' },\n133\t  },\n134\t];\n135\t\n136\t// Render a talisman on canvas\n137\texport function renderTalisman(\n138\t  ctx: CanvasRenderingContext2D,\n139\t  talisman: TalismanInstance,\n140\t  offsetX: number,\n141\t  offsetY: number,\n142\t  scale: number,\n143\t  cellSize: number,\n144\t  now: number,\n145\t): void {\n146\t  const x = offsetX + talisman.gridX * cellSize * scale;\n147\t  const y = offsetY + talisman.gridY * cellSize * scale;\n148\t  const s = cellSize * scale;\n149\t\n150\t  // Scroll background\n151\t  ctx.fillStyle = talisman.enabled ? 'rgba(200,180,100,0.3)' : 'rgba(100,100,100,0.3)';\n152\t  ctx.fillRect(x + 2, y + 2, s - 4, s - 4);\n153\t\n154\t  // Scroll icon\n155\t  ctx.fillStyle = talisman.enabled ? '#ffd700' : '#666';\n156\t  ctx.font = `${Math.max(10, Math.floor(14 * scale))}px serif`;\n157\t  ctx.textAlign = 'center';\n158\t  ctx.textBaseline = 'middle';\n159\t  ctx.fillText('📜', x + s / 2, y + s / 2);\n160\t\n161\t  // Active glow\n162\t  if (talisman.enabled && now - talisman.lastTriggered < 1000) {\n163\t    ctx.fillStyle = 'rgba(255,215,0,0.2)';\n164\t    ctx.fillRect(x + 2, y + 2, s - 4, s - 4);\n165\t  }\n166\t}\n167\t"}]},"parent_tool_use_id":"call_a5a9e75d09cd453897e0e9b2","session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"8bfac909-336f-4e78-ab69-4970bd16fae1","timestamp":"2026-05-23T01:53:53.588Z","subagent_type":"Explore","task_description":"Read M3 core game files"}
