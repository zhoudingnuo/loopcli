earRampToValueAtTime(freqEnd, this.ctx.currentTime + duration);\n66\t    }\n67\t\n68\t    gain.gain.setValueAtTime(gainValue, this.ctx.currentTime);\n69\t    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);\n70\t\n71\t    osc.connect(gain);\n72\t    gain.connect(this.masterGain);\n73\t\n74\t    osc.start(this.ctx.currentTime);\n75\t    osc.stop(this.ctx.currentTime + duration);\n76\t  }\n77\t\n78\t  private playNoise(duration: number, gainValue: number = 0.1): void {\n79\t    if (!this.ctx || !this.masterGain) return;\n80\t\n81\t    const bufferSize = this.ctx.sampleRate * duration;\n82\t    const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);\n83\t    const data = buffer.getChannelData(0);\n84\t    for (let i = 0; i < bufferSize; i++) {\n85\t      data[i] = (Math.random() * 2 - 1) * 0.5;\n86\t    }\n87\t\n88\t    const source = this.ctx.createBufferSource();\n89\t    source.buffer = buffer;\n90\t\n91\t    const gain = this.ctx.createGain();\n92\t    gain.gain.setValueAtTime(gainValue, this.ctx.currentTime);\n93\t    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);\n94\t\n95\t    source.connect(gain);\n96\t    gain.connect(this.masterGain);\n97\t    source.start();\n98\t  }\n99\t\n100\t  // === Sound Effects ===\n101\t\n102\t  playCollect(): void {\n103\t    this.init();\n104\t    this.playTone(800, 0.1, 'sine', 0.2);\n105\t    setTimeout(() => this.playTone(1200, 0.08, 'sine', 0.15), 50);\n106\t  }\n107\t\n108\t  playHarvest(): void {\n109\t    this.init();\n110\t    this.playTone(600, 0.12, 'triangle', 0.2);\n111\t    setTimeout(() => this.playTone(900, 0.1, 'triangle', 0.15), 80);\n112\t  }\n113\t\n114\t  playBuild(): void {\n115\t    this.init();\n116\t    this.playTone(200, 0.15, 'square', 0.15);\n117\t    this.playNoise(0.1, 0.05);\n118\t  }\n119\t\n120\t  playAlchemyStart(): void {\n121\t    this.init();\n122\t    this.playTone(400, 0.2, 'sine', 0.15);\n123\t    setTimeout(() =