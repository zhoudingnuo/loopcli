 === 'dual') {\n60\t      this.dualGoals = (config.goal?.goals || []).map(g => ({\n61\t        type: g.type,\n62\t        target: g.target,\n63\t        progress: 0,\n64\t        colors: g.colors || [],\n65\t        obstacleType: g.obstacleType || 0,\n66\t      }));\n67\t    }\n68\t  }\n69\t\n70\t  useMove() {\n71\t    if (this.getRemainingMoves() <= 0) return false;\n72\t    this.moves++;\n73\t    if (this.onMovesChange) this.onMovesChange(this.getRemainingMoves());\n74\t    return true;\n75\t  }\n76\t\n77\t  getRemainingMoves() {\n78\t    return this.maxMoves - this.moves;\n79\t  }\n80\t\n81\t  addMoves(n) {\n82\t    this.maxMoves += n;\n83\t    if (this.onMovesChange) this.onMovesChange(this.getRemainingMoves());\n84\t  }\n85\t\n86\t  getGoalProgress() {\n87\t    return this.goalProgress;\n88\t  }\n89\t\n90\t  addScore(points) {\n91\t    this.score += points;\n92\t    if (this.goalType === 'score') {\n93\t      this.goalProgress = this.score;\n94\t    }\n95\t    // Update dual score goals\n96\t    for (const dg of this.dualGoals) {\n97\t      if (dg.type === 'score') dg.progress = this.score;\n98\t    }\n99\t    if (this.onScoreChange) this.onScoreChange(this.score);\n100\t  }\n101\t\n102\t  addChainScore(basePoints, chainLevel) {\n103\t    const multiplier = chainLevel <= 1 ? 1 : chainLevel === 2 ? 1.5 : chainLevel === 3 ? 2.0 : 2.5;\n104\t    const points = Math.floor(basePoints * multiplier);\n105\t    this.addScore(points);\n106\t    this.chainCount = Math.max(this.chainCount, chainLevel);\n107\t    return points;\n108\t  }\n109\t\n110\t  addCollected(color, count) {\n111\t    this.collected[color] = (this.collected[color] || 0) + count;\n112\t    this._updateCollectProgress();\n113\t  }\n114\t\n115\t  _updateCollectProgress() {\n116\t    if (this.goalType === 'collect_color') {\n117\t      let total = 0;\n118\t      for (const c of this.collectColors) {\n119\t        total += this.collected[c] || 0;\n120\t      }\n121\t      this.goalProgress = total;\n122\t    }\n123\t    for (const dg of this.dualGoals) {\n124\t      if (dg.type === 'collect_color') {\n125\t        let total = 0;\n126\t        for (const c of dg.colors) {\n127\t          total += this.collected[c] || 0;\n128\t        }\n129\t        dg.progress = total;\n130\t      }\n131\t    }\n132\t  }\n133\t\n134\t  addObstacleCleared(type) {\n135\t    if (!this.obstaclesCleared[type]) this.obstaclesCleared[type] = 0;\n136\t    this.obstaclesCleared[type]++;\n137\t    this.totalObstaclesCleared++;\n138\t    this._updateClearProgress();\n139\t  }\n140\t\n141\t  _updateClearProgress() {\n142\t    if (this.goalType === 'clear_obstacle') {\n143\t      if (this.clearObstacleType === 0) {\n144\t        this.goalProgress = this.totalObstaclesCleared;\n145\t      } else {\n146\t        this.goalProgress = this.obstaclesCleared[this.clearObstacleType] || 0;\n147\t      }\n148\t    }\n149\t    for (const dg of this.dualGoals) {\n150\t      if (dg.type === 'clear_obstacle') {\n151\t        if (dg.obstacleType === 0) {\n152\t          dg.progress = this.totalObstaclesCleared;\n153\t        } else {\n154\t          dg.progress = this.obstaclesCleared[dg.obstacleType] || 0;\n155\t        }\n156\t      }\n157\t    }\n158\t  }\n159\t\n160\t  getStarCount() {\n161\t    if (this.score >= this.stars[2]) return 3;\n162\t    if (this.score >= this.stars[1]) return 2;\n163\t    if (this.score >= this.stars[0]) return 1;\n164\t    return 0;\n165\t  }\n166\t\n167\t  isGoalComplete() {\n168\t    switch (this.goalType) {\n169\t      case 'score':\n170\t        return this.score >= this.goalTarget;\n171\t      case 'collect_color':\n172\t        return this.goalProgress >= this.goalTarget;\n173\t      case 'clear_obstacle':\n174\t        return this.goalProgress >= this.goalTarget;\n175\t      case 'boss':\n176\t        return false; // Handled externally\n177\t      case 'dual':\n178\t        return this.dualGoals.every(g => g.progress >= g.target);\n179\t      default:\n180\t        return false;\n181\t    }\n182\t  }\n183\t\n184\t  isBossDefeated() {\n185\t    return this.goalType === 'boss';\n186\t  }\n187\t\n188\t  isGameOver() {\n189\t    return this.getRemainingMoves() <= 0 && !this.isGoalComplete();\n190\t  }\n191\t\n192\t  getGoalDescription() {\n193\t    switch (this.goalType) {\n194\t      case 'score':\n195\t        return `分数 ${this.goalProgress}/${this.goalTarget}`;\n196\t      case 'collect_color': {\n197\t        const names = this.collectColors.map(c => COLOR_MAP[c]?.label || '?').join('+');\n198\t        return `收集${names} ${this.goalProgress}/${this.goalTarget}`;\n199\t      }\n200\t      case 'clear_obstacle': {\n201\t        const label = this.clearObstacleType === 1 ? '冰块' :\n202\t                      this.clearObstacleType === 2 ? '锁链' :\n203\t                      this.clearObstacleType === 3 ? '巧克力' : '障碍';\n204\t        return `清除${label} ${this.goalProgress}/${this.goalTarget}`;\n205\t      }\n206\t      case 'boss':\n207\t        return '击败Boss';\n208\t      case 'dual':\n209\t        return this.dualGoals.map(g => {\n210\t          if (g.type === 'score') return `分数 ${this.score}/${g.target}`;\n211\t          if (g.type === 'collect_color') {\n212\t            const names = g.colors.map(c => COLOR_MAP[c]?.label || '?').join('+');\n213\t            return `收集${names} ${g.progress}/${g.target}`;\n214\t          }\n215\t          if (g.type === 'clear_obstacle') return `清除障碍 ${g.progress}/${g.target}`;\n216\t          return '';\n217\t        }).join(' | ');\n218\t      default:\n219\t        return '';\n220\t    }\n221\t  }\n222\t\n223\t  getProgressForUI() {\n224\t    if (this.goalType === 'dual') {\n225\t      return this.dualGoals.map(g => ({\n226\t        label: g.type === 'score' ? '分数' :\n227\t               g.type === 'collect_color' ? '收集' : '清除',\n228\t        current: g.progress,\n229\t        target: g.target,\n230\t      }));\n231\t    }\n232\t    return [{ label: '', current: this.goalProgress, target: this.goalTarget }];\n233\t  }\n234\t\n235\t  checkState() {\n236\t    if (this.isGoalComplete()) {\n237\t      if (this.onLevelComplete) this.onLevelComplete(this.score, this.getStarCount());\n238\t      return 'complete';\n239\t    }\n240\t    if (this.isGameOver()) {\n241\t      if (this.onLevelFail) this.onLevelFail(this.score);\n242\t      return 'fail';\n243\t    }\n244\t    return 'playing';\n245\t  }\n246\t}\n247\t\n248\tif (typeof module !== 'undefined') module.exports = { ScoreSystem };\n249\t"}]},"parent_tool_use_id":null,"session_id":"ec73960d-df44-45f4-a48b-a11bb93a968e","uuid":"b9541c5a-dd5d-4332-a370-01997c591f15","timestamp":"2026-05-22T22:43:36.992Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\douyin-match3\\src\\js\\ScoreSystem.js","content":"// ScoreSystem.js — Score, moves, goals (score/collect_color/clear_obstacle/boss/dual), stars\n\nclass ScoreSystem {\n  constructor() {\n    this.score = 0;\n    this.moves = 0;\n    this.maxMoves = 30;\n    this.goalType = 'score';\n    this.goalTarget = 1000;\n    this.goalProgress = 0;\n    this.level = 1;\n    this.stars = [0, 0, 0];\n    this.collected = {};\n    this.obstaclesCleared = {};\n    this.totalObstaclesCleared = 0;\n    this.chainCount = 0;\n    this.config = null;\n\n    // Dual goal support\n    this.dualGoals = [];\n\n    // Collect_color specifics\n    this.collectColors = [];\n\n    // Clear_obstacle specifics\n    this.clearObstacleType = 0;\n\n    this.onScoreChange = null;\n    this.onMovesChange = null;\n    this.onLevelComplete = null;\n    this.onLevelFail = null;\n  }\n\n  reset(level = 1) {\n    this.score = 0;\n    this.moves = 0;\n    this.goalProgress = 0;\n    this.chainCount = 0;\n    this.collected = {};\n    this.obstaclesCleared = {};\n    this.totalObstaclesCleared = 0;\n    this.dualGoals = [];\n    this.collectColors = [];\n    this.clearObstacleType = 0;\n    this.level = level;\n  }\n\n  configure(config) {\n    this.config = config;\n    this.maxMoves = config.moves || 30;\n    this.goalType = config.goal?.type || 'score';\n    this.goalTarget = config.goal?.target || 1000;\n    this.stars = config.stars || [1000, 1500, 2000];\n\n    if (this.goalType === 'collect_color') {\n      this.collectColors = config.goal?.colors || [];\n    } else if (this.goalType === 'clear_obstacle') {\n      this.clearObstacleType = config.goal?.obstacleType || 0;\n    } else if (this.goalType === 'dual') {\n      this.dualGoals = (config.goal?.goals || []).map(g => ({\n        type: g.type,\n        target: g.target,\n        progress: 0,\n        colors: g.colors || [],\n        obstacleType: g.obstacleType || 0,\n      }));\n    }\n  }\n\n  useMove() {\n    if (this.getRemainingMoves() <= 0) return false;\n    this.moves++;\n    if (this.onMovesChange) this.onMovesChange(this.getRemainingMoves());\n    return true;\n  }\n\n  getRemainingMoves() {\n    return this.maxMoves - this.moves;\n  }\n\n  addMoves(n) {\n    this.maxMoves += n;\n    if (this.onMovesChange) this.onMovesChange(this.getRemainingMoves());\n  }\n\n  getGoalProgress() {\n    return this.goalProgress;\n  }\n\n  addScore(points) {\n    this.score += points;\n    if (this.goalType === 'score') {\n      this.goalProgress = this.score;\n    }\n    // Update dual score goals\n    for (const dg of this.dualGoals) {\n      if (dg.type === 'score') dg.progress = this.score;\n    }\n    if (this.onScoreChange) this.onScoreChange(this.score);\n  }\n\n  addChainScore(basePoints, chainLevel) {\n    const multiplier = chainLevel <= 1 ? 1 : chainLevel === 2 ? 1.5 : chainLevel === 3 ? 2.0 : 2.5;\n    const points = Math.floor(basePoints * multiplier);\n    this.addScore(points);\n    this.chainCount = Math.max(this.chainCount, chainLevel);\n    return points;\n  }\n\n  addCollected(color, count) {\n    this.collected[color] = (this.collected[color] || 0) + count;\n    this._updateCollectProgress();\n  }\n\n  _updateCollectProgress() {\n    if (this.goalType === 'collect_color') {\n      let total = 0;\n      for (const c of this.collectColors) {\n        total += this.collected[c] || 0;\n      }\n      this.goalProgress = total;\n    }\n    for (const dg of this.dualGoals) {\n      if (dg.type === 'collect_color') {\n        let total = 0;\n        for (const c of dg.colors) {\n          total += this.collected[c] || 0;\n        }\n        dg.progress = total;\n      }\n    }\n  }\n\n  addObstacleCleared(type) {\n    if (!this.obstaclesCleared[type]) this.obstaclesCleared[type] = 0;\n    this.obstaclesCleared[type]++;\n    this.totalObstaclesCleared++;\n    this._updateClearProgress();\n  }\n\n  _updateClearProgress() {\n    if (this.goalType === 'clear_obstacle') {\n      if (this.clearObstacleType === 0) {\n        this.goalProgress = this.totalObstaclesCleared;\n      } else {\n        this.goalProgress = this.obstaclesCleared[this.clearObstacleType] || 0;\n      }\n    }\n    for (const dg of this.dualGoals) {\n      if (dg.type === 'clear_obstacle') {\n        if (dg.obstacleType === 0) {\n          dg.progress = this.totalObstaclesCleared;\n        } else {\n          dg.progress = this.obstaclesCleared[dg.obstacleType] || 0;\n        }\n      }\n    }\n  }\n\n  getStarCount() {\n    if (this.score >= this.stars[2]) return 3;\n    if (this.score >= this.stars[1]) return 2;\n    if (this.score >= this.stars[0]) return 1;\n    return 0;\n  }\n\n  isGoalComplete() {\n    switch (this.goalType) {\n      case 'score':\n        return this.score >= this.goalTarget;\n      case 'collect_color':\n        return this.goalProgress >= this.goalTarget;\n      case 'clear_obstacle':\n        return this.goalProgress >= this.goalTarget;\n      case 'boss':\n        return false; // Handled externally\n      case 'dual':\n        return this.dualGoals.every(g => g.progress >= g.target);\n      default:\n        return false;\n    }\n  }\n\n  isBossDefeated() {\n    return this.goalType === 'boss';\n  }\n\n  isGameOver() {\n    return this.getRemainingMoves() <= 0 && !this.isGoalComplete();\n  }\n\n  getGoalDescription() {\n    switch (this.goalType) {\n      case 'score':\n        return `分数 ${this.goalProgress}/${this.goalTarget}`;\n      case 'collect_color': {\n        const names = this.collectColors.map(c => COLOR_MAP[c]?.label || '?').join('+');\n        return `收集${names} ${this.goalProgress}/${this.goalTarget}`;\n      }\n      case 'clear_obstacle': {\n        const label = this.clearObstacleType === 1 ? '冰块' :\n                      this.clearObstacleType === 2 ? '锁链' :\n                      this.clearObstacleType === 3 ? '巧克力' : '障碍';\n        return `清除${label} ${this.goalProgress}/${this.goalTarget}`;\n      }\n      case 'boss':\n        return '击败Boss';\n      case 'dual':\n        return this.dualGoals.map(g => {\n          if (g.type === 'score') return `分数 ${this.score}/${g.target}`;\n          if (g.type === 'collect_color') {\n            const names = g.colors.map(c => COLOR_MAP[c]?.label || '?').join('+');\n            return `收集${names} ${g.progress}/${g.target}`;\n          }\n          if (g.type === 'clear_obstacle') return `清除障碍 ${g.progress}/${g.target}`;\n          return '';\n        }).join(' | ');\n      default:\n        return '';\n    }\n  }\n\n  getProgressForUI() {\n    if (this.goalType === 'dual') {\n      return this.dualGoals.map(g => ({\n        label: g.type === 'score' ? '分数' :\n               g.type === 'collect_color' ? '收集' : '清除',\n        current: g.progress,\n        target: g.target,\n      }));\n    }\n    return [{ label: '', current: this.goalProgress, target: this.goalTarget }];\n  }\n\n  checkState() {\n    if (this.isGoalComplete()) {\n      if (this.onLevelComplete) this.onLevelComplete(this.score, this.getStarCount());\n      return 'complete';\n    }\n    if (this.isGameOver()) {\n      if (this.onLevelFail) this.onLevelFail(this.score);\n      return 'fail';\n    }\n    return 'playing';\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { ScoreSystem };\n","numLines":249,"startLine":1,"totalLines":249}}}
