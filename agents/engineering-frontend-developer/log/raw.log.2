  this.swap(r, c, r, c + 1);\n          if (has) return true;\n        }\n        // Try swap down\n        if (r + 1 < this.size && this.grid[r + 1][c]) {\n          if (obstacleMgr && !obstacleMgr.canSwap(r + 1, c)) continue;\n          this.swap(r, c, r + 1, c);\n          const has = this.findAllMatches().length > 0;\n          this.swap(r, c, r + 1, c);\n          if (has) return true;\n        }\n      }\n    }\n    return false;\n  }","originalFile":"// Board.js — 8x8 grid state management\nconst TILE_COLORS = 6;\nconst BOARD_SIZE = 8;\nconst EMPTY = -1;\n\nconst COLOR_MAP = {\n  0: { name: 'apple',   hex: '#FF4D4D', label: '红' },\n  1: { name: 'banana',  hex: '#FFD93D', label: '黄' },\n  2: { name: 'blueberry', hex: '#4DA6FF', label: '蓝' },\n  3: { name: 'lime',    hex: '#6BCB77', label: '绿' },\n  4: { name: 'grape',   hex: '#B47AEA', label: '紫' },\n  5: { name: 'orange',  hex: '#FF9A3C', label: '橙' },\n};\n\n// Special tile types\nconst SPECIAL_NONE = 0;\nconst SPECIAL_STRIPED_H = 1;  // horizontal stripe bomb\nconst SPECIAL_STRIPED_V = 2;  // vertical stripe bomb\nconst SPECIAL_BOMB = 3;       // 3x3 area bomb\nconst SPECIAL_RAINBOW = 4;    // clears all of one color\n\nclass Tile {\n  constructor(color, row, col) {\n    this.color = color;\n    this.row = row;\n    this.col = col;\n    this.special = SPECIAL_NONE;\n    this.removing = false;\n    this.offsetY = 0;\n    this.offsetX = 0;\n    this.scale = 1;\n    this.alpha = 1;\n    this.selected = false;\n    this.id = Tile._nextId++;\n  }\n  get type() { return this.color; }\n}\n\nTile._nextId = 0;\n\nclass Board {\n  constructor(size = BOARD_SIZE, numColors = TILE_COLORS) {\n    this.size = size;\n    this.numColors = numColors;\n    this.grid = [];\n    this.listeners = [];\n  }\n\n  init() {\n    this.grid = [];\n    for (let r = 0; r < this.size; r++) {\n      this.grid[r] = [];\n      for (let c = 0; c < this.size; c++) {\n        this.grid[r][c] = this._createTile(r, c);\n      }\n    }\n    // Ens