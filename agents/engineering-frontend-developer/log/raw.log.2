{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_acf3b16619b34ab782d00073","type":"tool_result","content":"1\t// App.ts — Game main loop (60FPS + deltaTime + state management + input handling)\n2\t// M3: Multi-region, conveyors, puppets, talismans\n3\t\n4\timport { Renderer } from './Renderer';\n5\timport { GameMap } from '../game/Map';\n6\timport {\n7\t  type GameState,\n8\t  type BuildingInstance,\n9\t  type AlchemySessionData,\n10\t  type GameMap as GameMapData,\n11\t  createInitialState,\n12\t  cloneState,\n13\t  setMap,\n14\t  placeBuilding,\n15\t  loadGame,\n16\t  saveGame,\n17\t  startAutoSave,\n18\t  stopAutoSave,\n19\t} from '../game/GameState';\n20\timport {\n21\t  type BuildingDef,\n22\t  loadBuildingDefs,\n23\t  createBuildingInstance,\n24\t  canPlace,\n25\t} from '../game/Building';\n26\timport {\n27\t  collectFromBuilding,\n28\t  plantField,\n29\t  tickAutoProduction,\n30\t  tickManualProduction,\n31\t  canAfford,\n32\t  deductCost,\n33\t} from '../game/Resources';\n34\timport {\n35\t  type CultivationState,\n36\t  type BreakthroughResult,\n37\t  addCultivationExp,\n38\t  canBreakthrough,\n39\t  attemptBreakthrough,\n40\t  getBreakthroughRequirements,\n41\t  getFullRealmName,\n42\t  isRealmUnlocked as cultivationIsRealmUnlocked,\n43\t  tickAutoCultivation,\n44\t} from '../game/Cultivation';\n45\timport {\n46\t  type AlchemyRecipe,\n47\t  getAvailableRecipes,\n48\t  canCraft,\n49\t  startCrafting,\n50\t  tickAlchemy,\n51\t  collectAlchemy,\n52\t  getRemainingTime,\n53\t} from '../game/Alchemy';\n54\timport {\n55\t  usePill,\n56\t  useMultiplePills,\n57\t  getAllPillDefs,\n58\t  type PillDef,\n59\t} from '../game/Inventory';\n60\timport { audioManager } from '../game/AudioManager';\n61\timport type { Resources } from '../game/GameState';\n62\timport buildingData from '../data/buildings.json';\n63\timport regionData from '../data/regions.json';\n64\timport {\n65\t  type ConveyorSegment,\n66\t  type ConveyorItem,\n67\t  createSegment,\n68\t  buildSegmentMap,\n69\t  autoConnect,\n70\t  spawnItem,\n71\t  tickConveyorItems,\n72\t  renderConveyorSegment,\n73\t  renderConveyorItems,\n74\t  directionFromDelta,\n75\t} from '../game/ConveyorBelt';\n76\timport {\n77\t  type PuppetInstance,\n78\t  createPuppet,\n79\t  tickPuppet,\n80\t  puppetPickup,\n81\t  puppetDeliver,\n82\t  renderPuppet,\n83\t} from '../game/Puppet';\n84\t\n85\texport type PlacementMode = BuildingDef | null;\n86\t\n87\texport interface GameNotification {\n88\t  id: number;\n89\t  text: string;\n90\t  type: 'info' | 'success' | 'warning' | 'error';\n91\t  time: number;\n92\t}\n93\t\n94\tinterface RegionDef {\n95\t  id: string;\n96\t  name: string;\n97\t  nameEn: string;\n98\t  width: number;\n99\t  height: number;\n100\t  unlockRealm: string;\n101\t  maxBuildings: number;\n102\t  specialResources: string[];\n103\t  terrainBase: string;\n104\t  color: { bg: string; grid: string };\n105\t}\n106\t\n107\tlet notifIdCounter = 0;\n108\t\n109\texport class App {\n110\t  canvas: HTMLCanvasElement;\n111\t  renderer: Renderer;\n112\t  state: GameState;\n113\t  buildingDefs: Map<string, BuildingDef>;\n114\t  regionDefs: RegionDef[];\n115\t  map: GameMap;\n116\t  currentRegionIndex = 0;\n117\t\n118\t  // M3: Conveyor & Puppet state\n119\t  conveyorSegments: ConveyorSegment[] = [];\n120\t  conveyorItems: ConveyorItem[] = [];\n121\t  puppets: PuppetInstance[] = [];\n122\t\n123\t  private running = false;\n124\t  private lastFrameTime = 0;\n125\t  private animFrameId = 0;\n126\t  private lastTickTime = 0;\n127\t  private tickInterval = 200;\n128\t\n129\t  // Input state\n130\t  private hoveredCell: { gx: number; gy: number } | null = null;\n131\t  private clickStartTime = 0;\n132\t  private clickStartPos = { x: 0, y: 0 };\n133\t  placementMode: PlacementMode = null;\n134\t  private placementValid = false;\n135\t  private placementPos = { gx: 0, gy: 0 };\n136\t\n137\t  // M2: Breakthrough animation state\n138\t  breakthroughAnim: { active: boolean; result: BreakthroughResult | null; startTime: number; duration: number } = {\n139\t    active: false,\n140\t    result: null,\n141\t    startTime: 0,\n142\t    duration: 3000,\n143\t  };\n144\t\n145\t  // M2: Notifications\n146\t  notifications: GameNotification[] = [];\n147\t\n148\t  // UI callbacks\n149\t  onStateChange?: (state: GameState) => void;\n150\t  onBuildingSelect?: (building: BuildingInstance | null) => void;\n151\t  onNotification?: (notif: GameNotification) => void;\n152\t  onBreakthroughAnim?: (active: boolean, result: BreakthroughResult | null) => void;\n153\t  onAlchemyUpdate?: (session: AlchemySessionData | null) => void;\n154\t  onRegionChange?: (regionIndex: number, region: RegionDef) => void;\n155\t\n156\t  constructor(canvas: HTMLCanvasElement) {\n157\t    this.canvas = canvas;\n158\t    this.renderer = new Renderer(canvas);\n159\t\n160\t    const saved = loadGame();\n161\t    this.state = saved ? saved : createInitialState();\n162\t\n163\t    this.buildingDefs = loadBuildingDefs(buildingData as unknown as { buildings: BuildingDef[] });\n164\t    this.regionDefs = (regionData as { regions: RegionDef[] }).regions;\n165\t\n166\t    this.map = new GameMap(20, 15, '#2a3a1a', '#3a4a2a');\n167\t    this.map.generateStartingArea();\n168\t\n169\t    if (this.state.maps.length === 0) {\n170\t      this.state = setMap(this.state, 0, {\n171\t        regionId: 'liqi_flat',\n172\t        width: 20,\n173\t        height: 15,\n174\t        terrain: this.map.terrain,\n175\t        buildings: [],\n176\t      });\n177\t    } else {\n178\t      // Restore current region map\n179\t      const mapData = this.state.maps[this.state.currentRegionIndex];\n180\t      if (mapData) {\n181\t        this.currentRegionIndex = this.state.currentRegionIndex;\n182\t        this.loadRegionMap(this.currentRegionIndex);\n183\t      }\n184\t    }\n185\t\n186\t    this.setupInput(canvas);\n187\t\n188\t    window.addEventListener('resize', () => {\n189\t      this.renderer.resize();\n190\t    });\n191\t  }\n192\t\n193\t  // Load a region's map data into the active GameMap\n194\t  private loadRegionMap(index: number): void {\n195\t    const mapData = this.state.maps[index];\n196\t    if (!mapData) return;\n197\t\n198\t    const regionDef = this.regionDefs.find(r => r.id === mapData.regionId);\n199\t    const bg = regionDef?.color.bg ?? '#2a3a1a';\n200\t    const grid = regionDef?.color.grid ?? '#3a4a2a';\n201\t\n202\t    this.map = new GameMap(mapData.width, mapData.height, bg, grid);\n203\t    this.map.terrain = mapData.terrain;\n204\t    this.currentRegionIndex = index;\n205\t  }\n206\t\n207\t  // Initialize a new region\n208\t  initRegion(regionDef: RegionDef): number {\n209\t    // Check if already initialized\n210\t    const existing = this.state.maps.findIndex(m => m.regionId === regionDef.id);\n211\t    if (existing >= 0) return existing;\n212\t\n213\t    const newMap = new GameMap(regionDef.width, regionDef.height, regionDef.color.bg, regionDef.color.grid);\n214\t    newMap.generateRegionTerrain(regionDef.id);\n215\t\n216\t    const index = this.state.maps.length;\n217\t    this.state = setMap(this.state, index, {\n218\t      regionId: regionDef.id,\n219\t      width: regionDef.width,\n220\t      height: regionDef.height,\n221\t      terrain: newMap.terrain,\n222\t      buildings: [],\n223\t    });\n224\t\n225\t    return index;\n226\t  }\n227\t\n228\t  // Switch to a different region\n229\t  switchRegion(index: number): boolean {\n230\t    if (index < 0 || index >= this.state.maps.length) return false;\n231\t    if (index === this.currentRegionIndex) return false;\n232\t\n233\t    this.currentRegionIndex = index;\n234\t    this.state.currentRegionIndex = index;\n235\t    this.loadRegionMap(index);\n236\t\n237\t    const regionDef = this.regionDefs.find(r => r.id === this.state.maps[index]?.regionId);\n238\t    if (regionDef) {\n239\t      this.onRegionChange?.(index, regionDef);\n240\t    }\n241\t\n242\t    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);\n243\t    this.onStateChange?.(this.state);\n244\t    return true;\n245\t  }\n246\t\n247\t  // Get unlocked regions\n248\t  getUnlockedRegions(): Array<RegionDef & { index: number }> {\n249\t    return this.regionDefs\n250\t      .map((r, i) => {\n251\t        if (cultivationIsRealmUnlocked(r.unlockRealm, this.state.cultivation)) {\n252\t          // Ensure region is initialized\n253\t          const mapIndex = this.state.maps.findIndex(m => m.regionId === r.id);\n254\t          if (mapIndex < 0) {\n255\t            this.initRegion(r);\n256\t          }\n257\t          const actualIndex = Math.max(0, this.state.maps.findIndex(m => m.regionId === r.id));\n258\t          return { ...r, index: actualIndex };\n259\t        }\n260\t        return null;\n261\t      })\n262\t      .filter((r): r is RegionDef & { index: number } => r !== null);\n263\t  }\n264\t\n265\t  start(): void {\n266\t    if (this.running) return;\n267\t    this.running = true;\n268\t    this.lastFrameTime = performance.now();\n269\t    this.lastTickTime = this.lastFrameTime;\n270\t    this.loop(this.lastFrameTime);\n271\t\n272\t    startAutoSave(() => this.state);\n273\t  }\n274\t\n275\t  stop(): void {\n276\t    this.running = false;\n277\t    if (this.animFrameId) {\n278\t      cancelAnimationFrame(this.animFrameId);\n279\t    }\n280\t    stopAutoSave();\n281\t    saveGame(this.state);\n282\t  }\n283\t\n284\t  private loop = (now: number): void => {\n285\t    if (!this.running) return;\n286\t\n287\t    const dt = now - this.lastFrameTime;\n288\t    this.lastFrameTime = now;\n289\t\n290\t    this.state.totalPlaytime += dt / 1000;\n291\t\n292\t    if (now - this.lastTickTime >= this.tickInterval) {\n293\t      this.tickProduction(now);\n294\t      this.lastTickTime = now;\n295\t    }\n296\t\n297\t    this.render(now);\n298\t\n299\t    this.animFrameId = requestAnimationFrame(this.loop);\n300\t  };\n301\t\n302\t  private tickProduction(now: number): void {\n303\t    this.state = tickAutoProduction(this.state, this.currentRegionIndex, now, this.buildingDefs);\n304\t    this.state = tickManualProduction(this.state, this.currentRegionIndex, now, this.buildingDefs);\n305\t\n306\t    // M2: Auto-cultivation tick\n307\t    this.state.cultivation = tickAutoCultivation(this.state.cultivation, this.tickInterval);\n308\t\n309\t    // M2: Alchemy tick\n310\t    if (this.state.alchemySession) {\n311\t      this.state.alchemySession = tickAlchemy(this.state.alchemySession, now);\n312\t      this.onAlchemyUpdate?.(this.state.alchemySession);\n313\t    }\n314\t\n315\t    // M3: Conveyor items tick\n316\t    if (this.conveyorSegments.length > 0) {\n317\t      const segMap = buildSegmentMap(this.conveyorSegments);\n318\t      const result = tickConveyorItems(this.conveyorItems, segMap, this.tickInterval);\n319\t      this.conveyorItems = result.items;\n320\t\n321\t      // Deliver items to resource pool\n322\t      for (const d of result.delivered) {\n323\t        const delta: Partial<Resources> = {};\n324\t        (delta as Record<string, number>)[d.resource] = d.amount;\n325\t        this.state = { ...this.state, resources: { ...this.state.resources, [d.resource]: (this.state.resources[d.resource] ?? 0) + d.amount } };\n326\t      }\n327\t    }\n328\t\n329\t    // M3: Puppet tick\n330\t    for (let i = 0; i < this.puppets.length; i++) {\n331\t      this.puppets[i] = tickPuppet(this.puppets[i], this.tickInterval);\n332\t    }\n333\t\n334\t    this.onStateChange?.(this.state);\n335\t  }\n336\t\n337\t  private render(now: number): void {\n338\t    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n339\t    const preview = this.placementMode\n340\t      ? {\n341\t          def: this.placementMode,\n342\t          gx: this.placementPos.gx,\n343\t          gy: this.placementPos.gy,\n344\t          valid: this.placementValid,\n345\t        }\n346\t      : null;\n347\t\n348\t    this.renderer.render(\n349\t      this.map,\n350\t      buildings,\n351\t      this.buildingDefs,\n352\t      this.state.resources,\n353\t      this.state.realm,\n354\t      this.state.cultivation,\n355\t      this.hoveredCell,\n356\t      preview,\n357\t      now,\n358\t    );\n359\t\n360\t    // M3: Render conveyors\n361\t    const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n362\t    const segMap = buildSegmentMap(this.conveyorSegments);\n363\t    for (const seg of this.conveyorSegments) {\n364\t      renderConveyorSegment(this.renderer.ctx, seg, offsetX, offsetY, scale, this.map.cellSize, now);\n365\t    }\n366\t    renderConveyorItems(this.renderer.ctx, this.conveyorItems, segMap, offsetX, offsetY, scale, this.map.cellSize);\n367\t\n368\t    // M3: Render puppets\n369\t    for (const puppet of this.puppets) {\n370\t      renderPuppet(this.renderer.ctx, puppet, offsetX, offsetY, scale, this.map.cellSize, now);\n371\t    }\n372\t\n373\t    // Render breakthrough animation overlay\n374\t    if (this.breakthroughAnim.active) {\n375\t      this.renderBreakthroughOverlay(now);\n376\t    }\n377\t  }\n378\t\n379\t  private renderBreakthroughOverlay(now: number): void {\n380\t    const ctx = this.renderer.ctx;\n381\t    const w = this.canvas.getBoundingClientRect().width;\n382\t    const h = this.canvas.getBoundingClientRect().height;\n383\t\n384\t    const elapsed = now - this.breakthroughAnim.startTime;\n385\t    const progress = Math.min(1, elapsed / this.breakthroughAnim.duration);\n386\t\n387\t    let alpha = 0;\n388\t    if (progress < 0.2) alpha = progress / 0.2;\n389\t    else if (progress > 0.8) alpha = (1 - progress) / 0.2;\n390\t    else alpha = 1;\n391\t\n392\t    const result = this.breakthroughAnim.result;\n393\t\n394\t    if (result?.success) {\n395\t      ctx.fillStyle = `rgba(255, 215, 0, ${alpha * 0.15})`;\n396\t      ctx.fillRect(0, 0, w, h);\n397\t\n398\t      ctx.fillStyle = `rgba(255, 215, 0, ${alpha})`;\n399\t      ctx.font = `bold ${24 + Math.sin(progress * Math.PI * 4) * 4}px serif`;\n400\t      ctx.textAlign = 'center';\n401\t      ctx.textBaseline = 'middle';\n402\t      ctx.fillText('⚡ 境界突破成功 ⚡', w / 2, h / 2 - 20);\n403\t\n404\t      ctx.font = '16px serif';\n405\t      ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;\n406\t      const realmName = getFullRealmName(this.state.cultivation);\n407\t      ctx.fillText(`进入 ${realmName}`, w / 2, h / 2 + 20);\n408\t    } else if (result) {\n409\t      ctx.fillStyle = `rgba(200, 50, 50, ${alpha * 0.15})`;\n410\t      ctx.fillRect(0, 0, w, h);\n411\t\n412\t      ctx.fillStyle = `rgba(255, 100, 100, ${alpha})`;\n413\t      ctx.font = 'bold 24px serif';\n414\t      ctx.textAlign = 'center';\n415\t      ctx.textBaseline = 'middle';\n416\t      ctx.fillText('突破失败...', w / 2, h / 2 - 20);\n417\t\n418\t      ctx.font = '14px serif';\n419\t      ctx.fillStyle = `rgba(255, 200, 200, ${alpha})`;\n420\t      ctx.fillText(`修为损失 ${Math.floor(result.penalty * 100)}%`, w / 2, h / 2 + 20);\n421\t    }\n422\t\n423\t    if (progress >= 1) {\n424\t      this.breakthroughAnim.active = false;\n425\t      this.breakthroughAnim.result = null;\n426\t      this.onBreakthroughAnim?.(false, null);\n427\t    }\n428\t  }\n429\t\n430\t  // Try to place a building at current placement position\n431\t  placeCurrentBuilding(): boolean {\n432\t    if (!this.placementMode) return false;\n433\t\n434\t    const def = this.placementMode;\n435\t    const { gx, gy } = this.placementPos;\n436\t\n437\t    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n438\t    if (!canPlace(this.map, def, gx, gy, buildings)) return false;\n439\t    if (!canAfford(this.state.resources, def.cost)) return false;\n440\t\n441\t    this.state = deductCost(this.state, def.cost);\n442\t\n443\t    // Handle conveyor/puppet/talisman placement\n444\t    if (def.category === 'transport' && (def.id === 'conveyor_lv1' || def.id === 'conveyor_lv2')) {\n445\t      const seg = createSegment(\n446\t        `seg_${Date.now()}_${Math.random().toString(36).slice(2)}`,\n447\t        gx, gy,\n448\t        def.id === 'conveyor_lv1' ? 1 : 2,\n449\t        'right',\n450\t      );\n451\t      const segMap = buildSegmentMap(this.conveyorSegments);\n452\t      this.conveyorSegments.push(autoConnect(seg, segMap));\n453\t      audioManager.playBuild();\n454\t      this.addNotification(`放置了 ${def.name}`, 'success');\n455\t      this.onStateChange?.(this.state);\n456\t      return true;\n457\t    }\n458\t\n459\t    if (def.category === 'automation' && def.id === 'puppet_sorter') {\n460\t      const puppet = createPuppet(\n461\t        `pup_${Date.now()}_${Math.random().toString(36).slice(2)}`,\n462\t        gx, gy, 1,\n463\t      );\n464\t      this.puppets.push(puppet);\n465\t      audioManager.playBuild();\n466\t      this.addNotification(`放置了 ${def.name}`, 'success');\n467\t      this.onStateChange?.(this.state);\n468\t      return true;\n469\t    }\n470\t\n471\t    const instance = createBuildingInstance(def.id, gx, gy);\n472\t    this.state = placeBuilding(this.state, this.currentRegionIndex, instance);\n473\t\n474\t    audioManager.playBuild();\n475\t    this.addNotification(`建造了 ${def.name}`, 'success');\n476\t    this.onStateChange?.(this.state);\n477\t    return true;\n478\t  }\n479\t\n480\t  // Handle click on a building\n481\t  private handleBuildingClick(building: BuildingInstance): void {\n482\t    const def = this.buildingDefs.get(building.buildingId);\n483\t    if (!def) return;\n484\t\n485\t    if (def.production.mode === 'manual') {\n486\t      if (def.category === 'farming') {\n487\t        if (!building.isProducing && building.progress < 1) {\n488\t          this.state = plantField(this.state, building, this.currentRegionIndex);\n489\t          audioManager.playCollect();\n490\t        } else if (building.progress >= 1) {\n491\t          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n492\t          audioManager.playHarvest();\n493\t          this.addNotification(`收获 ${def.production.amount} ${this.getResourceName(def.production.resource)}`, 'success');\n494\t        }\n495\t      } else if (def.category === 'mining') {\n496\t        this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n497\t        audioManager.playCollect();\n498\t      } else if (def.category === 'alchemy') {\n499\t        if (building.progress >= 1) {\n500\t          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n501\t          audioManager.playAlchemyComplete();\n502\t          this.addNotification(`获得 ${def.production.amount} ${this.getResourceName(def.production.resource)}`, 'success');\n503\t        } else if (!building.isProducing) {\n504\t          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n505\t          audioManager.playAlchemyStart();\n506\t        }\n507\t      } else if (def.category === 'cultivation') {\n508\t        if (!building.isProducing) {\n509\t          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n510\t        }\n511\t      }\n512\t      this.onStateChange?.(this.state);\n513\t    }\n514\t\n515\t    this.onBuildingSelect?.(building);\n516\t  }\n517\t\n518\t  // === M2: Cultivation Actions ===\n519\t\n520\t  usePillAction(pillId: string): boolean {\n521\t    const result = usePill(pillId, this.state.resources);\n522\t    if (!result) return false;\n523\t\n524\t    this.state.resources = result.resources as Resources;\n525\t    this.state.cultivation = addCultivationExp(this.state.cultivation, result.cultivation);\n526\t    this.state = this.addCultivationToRealm(result.cultivation);\n527\t\n528\t    audioManager.playUsePill();\n529\t    const pillName = this.getResourceName(pillId);\n530\t    this.addNotification(`服用 ${pillName}，修为+${result.cultivation}`, 'success');\n531\t    this.onStateChange?.(this.state);\n532\t    return true;\n533\t  }\n534\t\n535\t  useAllPills(pillId: string): boolean {\n536\t    const count = this.state.resources[pillId as keyof typeof this.state.resources] ?? 0;\n537\t    if (count <= 0) return false;\n538\t\n539\t    const result = useMultiplePills(pillId, count, this.state.resources);\n540\t    if (!result) return false;\n541\t\n542\t    this.state.resources = result.resources as Resources;\n543\t    this.state.cultivation = addCultivationExp(this.state.cultivation, result.cultivation);\n544\t    this.state = this.addCultivationToRealm(result.cultivation);\n545\t\n546\t    audioManager.playUsePill();\n547\t    this.addNotification(`服用 ${result.used} ${this.getResourceName(pillId)}，修为+${result.cultivation}`, 'success');\n548\t    this.onStateChange?.(this.state);\n549\t    return true;\n550\t  }\n551\t\n552\t  private addCultivationToRealm(amount: number): GameState {\n553\t    const next = cloneState(this.state);\n554\t    next.realm.exp += amount;\n555\t    while (next.realm.exp >= next.realm.expToNext) {\n556\t      next.realm.exp -= next.realm.expToNext;\n557\t      next.realm.level += 1;\n558\t      next.realm.expToNext = Math.floor(next.realm.expToNext * 1.8);\n559\t    }\n560\t    return next;\n561\t  }\n562\t\n563\t  attemptBreakthroughAction(): boolean {\n564\t    if (!canBreakthrough(this.state.cultivation)) {\n565\t      this.addNotification('修为不足，无法突破', 'warning');\n566\t      return false;\n567\t    }\n568\t\n569\t    const result = attemptBreakthrough(this.state.cultivation, this.state.resources);\n570\t    if (!result) {\n571\t      this.addNotification('材料不足，无法突破', 'warning');\n572\t      return false;\n573\t    }\n574\t\n575\t    this.state.cultivation = result.newState;\n576\t    this.state.resources = result.newResources as Resources;\n577\t\n578\t    if (result.result.success) {\n579\t      this.state.realm.realmId = result.newState.realmId;\n580\t      this.state.realm.level = result.newState.level;\n581\t      this.state.realm.exp = result.newState.exp;\n582\t      this.state.realm.expToNext = result.newState.expToNext;\n583\t    }\n584\t\n585\t    this.breakthroughAnim = {\n586\t      active: true,\n587\t      result: result.result,\n588\t      startTime: performance.now(),\n589\t      duration: 3000,\n590\t    };\n591\t\n592\t    if (result.result.success) {\n593\t      audioManager.playBreakthroughSuccess();\n594\t      this.addNotification(`突破成功！进入 ${getFullRealmName(this.state.cultivation)}`, 'success');\n595\t    } else {\n596\t      audioManager.playBreakthroughFail();\n597\t      this.addNotification(`突破失败，修为损失 ${Math.floor(result.result.penalty * 100)}%`, 'error');\n598\t    }\n599\t\n600\t    this.onBreakthroughAnim?.(true, result.result);\n601\t    this.onStateChange?.(this.state);\n602\t    return true;\n603\t  }\n604\t\n605\t  getBreakthroughInfo() {\n606\t    return getBreakthroughRequirements(this.state.cultivation);\n607\t  }\n608\t\n609\t  // === M2: Alchemy Actions ===\n610\t\n611\t  getAvailableAlchemyRecipes(): AlchemyRecipe[] {\n612\t    return getAvailableRecipes((realm) => cultivationIsRealmUnlocked(realm, this.state.cultivation));\n613\t  }\n614\t\n615\t  startAlchemyAction(recipeId: string): boolean {\n616\t    const crafting = startCrafting(recipeId, this.state.resources);\n617\t    if (!crafting) return false;\n618\t\n619\t    this.state.resources = crafting.resources as Resources;\n620\t    this.state.alchemySession = crafting.session;\n621\t    audioManager.playAlchemyStart();\n622\t    this.addNotification(`开始炼丹`, 'info');\n623\t    this.onStateChange?.(this.state);\n624\t    this.onAlchemyUpdate?.(this.state.alchemySession);\n625\t    return true;\n626\t  }\n627\t\n628\t  collectAlchemyAction(): boolean {\n629\t    if (!this.state.alchemySession?.complete) return false;\n630\t\n631\t    const result = collectAlchemy(this.state.alchemySession, this.state.resources);\n632\t    if (!result) return false;\n633\t\n634\t    this.state.resources = result.resources as Resources;\n635\t    this.state.alchemySession = null;\n636\t\n637\t    if (result.success) {\n638\t      this.state.cultivation = addCultivationExp(this.state.cultivation, result.expReward);\n639\t      audioManager.playAlchemyComplete();\n640\t      this.addNotification(`炼丹成功！获得 ${result.amount} 颗丹药`, 'success');\n641\t    } else {\n642\t      audioManager.playAlchemyFail();\n643\t      this.addNotification('炼丹失败...', 'error');\n644\t    }\n645\t\n646\t    this.onStateChange?.(this.state);\n647\t    this.onAlchemyUpdate?.(null);\n648\t    return true;\n649\t  }\n650\t\n651\t  // === Notifications ===\n652\t\n653\t  addNotification(text: string, type: GameNotification['type'] = 'info'): void {\n654\t    const notif: GameNotification = {\n655\t      id: ++notifIdCounter,\n656\t      text,\n657\t      type,\n658\t      time: Date.now(),\n659\t    };\n660\t    this.notifications.push(notif);\n661\t    if (this.notifications.length > 10) {\n662\t      this.notifications = this.notifications.slice(-10);\n663\t    }\n664\t    this.onNotification?.(notif);\n665\t  }\n666\t\n667\t  // === Utility ===\n668\t\n669\t  private getResourceName(id: string): string {\n670\t    const names: Record<string, string> = {\n671\t      spirit_stone: '灵石',\n672\t      spirit_grass: '灵草',\n673\t      spirit_energy: '灵气',\n674\t      cultivation: '修为',\n675\t      pill_juling: '聚灵丹',\n676\t      pill_peiyuan: '培元丹',\n677\t      pill_ningqi: '凝气丹',\n678\t      pill_zhuji: '筑基丹',\n679\t      pill_jindanyin: '金丹引',\n680\t      spirit_iron: '灵铁',\n681\t      spirit_wood: '灵木',\n682\t      talisman_paper: '符纸',\n683\t    };\n684\t    return names[id] ?? id;\n685\t  }\n686\t\n687\t  centerCamera(): void {\n688\t    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);\n689\t  }\n690\t\n691\t  getAvailableBuildings(): BuildingDef[] {\n692\t    return Array.from(this.buildingDefs.values()).filter(def => {\n693\t      return cultivationIsRealmUnlocked(def.unlockRealm, this.state.cultivation);\n694\t    });\n695\t  }\n696\t\n697\t  getInventoryPills(): Array<PillDef & { count: number }> {\n698\t    const result: Array<PillDef & { count: number }> = [];\n699\t    for (const def of getAllPillDefs()) {\n700\t      const count = this.state.resources[def.id as keyof typeof this.state.resources] ?? 0;\n701\t      if (count > 0) {\n702\t        result.push({ ...def, count });\n703\t      }\n704\t    }\n705\t    return result;\n706\t  }\n707\t\n708\t  private setupInput(canvas: HTMLCanvasElement): void {\n709\t    canvas.addEventListener('mousemove', (e) => {\n710\t      const rect = canvas.getBoundingClientRect();\n711\t      const mx = e.clientX - rect.left;\n712\t      const my = e.clientY - rect.top;\n713\t\n714\t      const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n715\t      this.hoveredCell = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n716\t\n717\t      if (this.placementMode && this.hoveredCell) {\n718\t        this.placementPos = { gx: this.hoveredCell.gx, gy: this.hoveredCell.gy };\n719\t        const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n720\t        this.placementValid = canPlace(\n721\t          this.map,\n722\t          this.placementMode,\n723\t          this.placementPos.gx,\n724\t          this.placementPos.gy,\n725\t          buildings,\n726\t        );\n727\t      }\n728\t    });\n729\t\n730\t    canvas.addEventListener('mousedown', (e) => {\n731\t      if (e.button !== 0) return;\n732\t      this.clickStartTime = performance.now();\n733\t      this.clickStartPos = { x: e.clientX, y: e.clientY };\n734\t    });\n735\t\n736\t    canvas.addEventListener('mouseup', (e) => {\n737\t      if (e.button !== 0) return;\n738\t      const dt = performance.now() - this.clickStartTime;\n739\t      const dx = Math.abs(e.clientX - this.clickStartPos.x);\n740\t      const dy = Math.abs(e.clientY - this.clickStartPos.y);\n741\t\n742\t      if (dt < 300 && dx < 5 && dy < 5) {\n743\t        audioManager.init();\n744\t        audioManager.resume();\n745\t        this.handleClick(e);\n746\t      }\n747\t    });\n748\t\n749\t    document.addEventListener('keydown', (e) => {\n750\t      if (e.key === 'Escape') {\n751\t        this.placementMode = null;\n752\t      }\n753\t    });\n754\t  }\n755\t\n756\t  private handleClick(e: MouseEvent): void {\n757\t    const rect = this.canvas.getBoundingClientRect();\n758\t    const mx = e.clientX - rect.left;\n759\t    const my = e.clientY - rect.top;\n760\t    const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n761\t    const { gx, gy } = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n762\t\n763\t    if (!this.map.inBounds(gx, gy)) return;\n764\t\n765\t    if (this.placementMode) {\n766\t      this.placementPos = { gx, gy };\n767\t      const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n768\t      this.placementValid = canPlace(this.map, this.placementMode, gx, gy, buildings);\n769\t      if (this.placementValid) {\n770\t        this.placeCurrentBuilding();\n771\t      }\n772\t      return;\n773\t    }\n774\t\n775\t    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n776\t    const clicked = buildings.find(b => {\n777\t      const def = this.buildingDefs.get(b.buildingId);\n778\t      if (!def) return false;\n779\t      return (\n780\t        gx >= b.gridX && gx < b.gridX + def.size.w &&\n781\t        gy >= b.gridY && gy < b.gridY + def.size.h\n782\t      );\n783\t    });\n784\t\n785\t    if (clicked) {\n786\t      this.handleBuildingClick(clicked);\n787\t    }\n788\t  }\n789\t}\n790\t"}]},"parent_tool_use_id":null,"session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"8b1083a0-1d44-4ef2-b328-ab9deac284cc","timestamp":"2026-05-23T02:11:23.480Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\renderer\\App.ts","content":"// App.ts — Game main loop (60FPS + deltaTime + state management + input handling)\n// M3: Multi-region, conveyors, puppets, talismans\n\nimport { Renderer } from './Renderer';\nimport { GameMap } from '../game/Map';\nimport {\n  type GameState,\n  type BuildingInstance,\n  type AlchemySessionData,\n  type GameMap as GameMapData,\n  createInitialState,\n  cloneState,\n  setMap,\n  placeBuilding,\n  loadGame,\n  saveGame,\n  startAutoSave,\n  stopAutoSave,\n} from '../game/GameState';\nimport {\n  type BuildingDef,\n  loadBuildingDefs,\n  createBuildingInstance,\n  canPlace,\n} from '../game/Building';\nimport {\n  collectFromBuilding,\n  plantField,\n  tickAutoProduction,\n  tickManualProduction,\n  canAfford,\n  deductCost,\n} from '../game/Resources';\nimport {\n  type CultivationState,\n  type BreakthroughResult,\n  addCultivationExp,\n  canBreakthrough,\n  attemptBreakthrough,\n  getBreakthroughRequirements,\n  getFullRealmName,\n  isRealmUnlocked as cultivationIsRealmUnlocked,\n  tickAutoCultivation,\n} from '../game/Cultivation';\nimport {\n  type AlchemyRecipe,\n  getAvailableRecipes,\n  canCraft,\n  startCrafting,\n  tickAlchemy,\n  collectAlchemy,\n  getRemainingTime,\n} from '../game/Alchemy';\nimport {\n  usePill,\n  useMultiplePills,\n  getAllPillDefs,\n  type PillDef,\n} from '../game/Inventory';\nimport { audioManager } from '../game/AudioManager';\nimport type { Resources } from '../game/GameState';\nimport buildingData from '../data/buildings.json';\nimport regionData from '../data/regions.json';\nimport {\n  type ConveyorSegment,\n  type ConveyorItem,\n  createSegment,\n  buildSegmentMap,\n  autoConnect,\n  spawnItem,\n  tickConveyorItems,\n  renderConveyorSegment,\n  renderConveyorItems,\n  directionFromDelta,\n} from '../game/ConveyorBelt';\nimport {\n  type PuppetInstance,\n  createPuppet,\n  tickPuppet,\n  puppetPickup,\n  puppetDeliver,\n  renderPuppet,\n} from '../game/Puppet';\n\nexport type PlacementMode = BuildingDef | null;\n\nexport interface GameNotification {\n  id: number;\n  text: string;\n  type: 'info' | 'success' | 'warning' | 'error';\n  time: number;\n}\n\ninterface RegionDef {\n  id: string;\n  name: string;\n  nameEn: string;\n  width: number;\n  height: number;\n  unlockRealm: string;\n  maxBuildings: number;\n  specialResources: string[];\n  terrainBase: string;\n  color: { bg: string; grid: string };\n}\n\nlet notifIdCounter = 0;\n\nexport class App {\n  canvas: HTMLCanvasElement;\n  renderer: Renderer;\n  state: GameState;\n  buildingDefs: Map<string, BuildingDef>;\n  regionDefs: RegionDef[];\n  map: GameMap;\n  currentRegionIndex = 0;\n\n  // M3: Conveyor & Puppet state\n  conveyorSegments: ConveyorSegment[] = [];\n  conveyorItems: ConveyorItem[] = [];\n  puppets: PuppetInstance[] = [];\n\n  private running = false;\n  private lastFrameTime = 0;\n  private animFrameId = 0;\n  private lastTickTime = 0;\n  private tickInterval = 200;\n\n  // Input state\n  private hoveredCell: { gx: number; gy: number } | null = null;\n  private clickStartTime = 0;\n  private clickStartPos = { x: 0, y: 0 };\n  placementMode: PlacementMode = null;\n  private placementValid = false;\n  private placementPos = { gx: 0, gy: 0 };\n\n  // M2: Breakthrough animation state\n  breakthroughAnim: { active: boolean; result: BreakthroughResult | null; startTime: number; duration: number } = {\n    active: false,\n    result: null,\n    startTime: 0,\n    duration: 3000,\n  };\n\n  // M2: Notifications\n  notifications: GameNotification[] = [];\n\n  // UI callbacks\n  onStateChange?: (state: GameState) => void;\n  onBuildingSelect?: (building: BuildingInstance | null) => void;\n  onNotification?: (notif: GameNotification) => void;\n  onBreakthroughAnim?: (active: boolean, result: BreakthroughResult | null) => void;\n  onAlchemyUpdate?: (session: AlchemySessionData | null) => void;\n  onRegionChange?: (regionIndex: number, region: RegionDef) => void;\n\n  constructor(canvas: HTMLCanvasElement) {\n    this.canvas = canvas;\n    this.renderer = new Renderer(canvas);\n\n    const saved = loadGame();\n    this.state = saved ? saved : createInitialState();\n\n    this.buildingDefs = loadBuildingDefs(buildingData as unknown as { buildings: BuildingDef[] });\n    this.regionDefs = (regionData as { regions: RegionDef[] }).regions;\n\n    this.map = new GameMap(20, 15, '#2a3a1a', '#3a4a2a');\n    this.map.generateStartingArea();\n\n    if (this.state.maps.length === 0) {\n      this.state = setMap(this.state, 0, {\n        regionId: 'liqi_flat',\n        width: 20,\n        height: 15,\n        terrain: this.map.terrain,\n        buildings: [],\n      });\n    } else {\n      // Restore current region map\n      const mapData = this.state.maps[this.state.currentRegionIndex];\n      if (mapData) {\n        this.currentRegionIndex = this.state.currentRegionIndex;\n        this.loadRegionMap(this.currentRegionIndex);\n      }\n    }\n\n    this.setupInput(canvas);\n\n    window.addEventListener('resize', () => {\n      this.renderer.resize();\n    });\n  }\n\n  // Load a region's map data into the active GameMap\n  private loadRegionMap(index: number): void {\n    const mapData = this.state.maps[index];\n    if (!mapData) return;\n\n    const regionDef = this.regionDefs.find(r => r.id === mapData.regionId);\n    const bg = regionDef?.color.bg ?? '#2a3a1a';\n    const grid = regionDef?.color.grid ?? '#3a4a2a';\n\n    this.map = new GameMap(mapData.width, mapData.height, bg, grid);\n    this.map.terrain = mapData.terrain;\n    this.currentRegionIndex = index;\n  }\n\n  // Initialize a new region\n  initRegion(regionDef: RegionDef): number {\n    // Check if already initialized\n    const existing = this.state.maps.findIndex(m => m.regionId === regionDef.id);\n    if (existing >= 0) return existing;\n\n    const newMap = new GameMap(regionDef.width, regionDef.height, regionDef.color.bg, regionDef.color.grid);\n    newMap.generateRegionTerrain(regionDef.id);\n\n    const index = this.state.maps.length;\n    this.state = setMap(this.state, index, {\n      regionId: regionDef.id,\n      width: regionDef.width,\n      height: regionDef.height,\n      terrain: newMap.terrain,\n      buildings: [],\n    });\n\n    return index;\n  }\n\n  // Switch to a different region\n  switchRegion(index: number): boolean {\n    if (index < 0 || index >= this.state.maps.length) return false;\n    if (index === this.currentRegionIndex) return false;\n\n    this.currentRegionIndex = index;\n    this.state.currentRegionIndex = index;\n    this.loadRegionMap(index);\n\n    const regionDef = this.regionDefs.find(r => r.id === this.state.maps[index]?.regionId);\n    if (regionDef) {\n      this.onRegionChange?.(index, regionDef);\n    }\n\n    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  // Get unlocked regions\n  getUnlockedRegions(): Array<RegionDef & { index: number }> {\n    return this.regionDefs\n      .map((r, i) => {\n        if (cultivationIsRealmUnlocked(r.unlockRealm, this.state.cultivation)) {\n          // Ensure region is initialized\n          const mapIndex = this.state.maps.findIndex(m => m.regionId === r.id);\n          if (mapIndex < 0) {\n            this.initRegion(r);\n          }\n          const actualIndex = Math.max(0, this.state.maps.findIndex(m => m.regionId === r.id));\n          return { ...r, index: actualIndex };\n        }\n        return null;\n      })\n      .filter((r): r is RegionDef & { index: number } => r !== null);\n  }\n\n  start(): void {\n    if (this.running) return;\n    this.running = true;\n    this.lastFrameTime = performance.now();\n    this.lastTickTime = this.lastFrameTime;\n    this.loop(this.lastFrameTime);\n\n    startAutoSave(() => this.state);\n  }\n\n  stop(): void {\n    this.running = false;\n    if (this.animFrameId) {\n      cancelAnimationFrame(this.animFrameId);\n    }\n    stopAutoSave();\n    saveGame(this.state);\n  }\n\n  private loop = (now: number): void => {\n    if (!this.running) return;\n\n    const dt = now - this.lastFrameTime;\n    this.lastFrameTime = now;\n\n    this.state.totalPlaytime += dt / 1000;\n\n    if (now - this.lastTickTime >= this.tickInterval) {\n      this.tickProduction(now);\n      this.lastTickTime = now;\n    }\n\n    this.render(now);\n\n    this.animFrameId = requestAnimationFrame(this.loop);\n  };\n\n  private tickProduction(now: number): void {\n    this.state = tickAutoProduction(this.state, this.currentRegionIndex, now, this.buildingDefs);\n    this.state = tickManualProduction(this.state, this.currentRegionIndex, now, this.buildingDefs);\n\n    // M2: Auto-cultivation tick\n    this.state.cultivation = tickAutoCultivation(this.state.cultivation, this.tickInterval);\n\n    // M2: Alchemy tick\n    if (this.state.alchemySession) {\n      this.state.alchemySession = tickAlchemy(this.state.alchemySession, now);\n      this.onAlchemyUpdate?.(this.state.alchemySession);\n    }\n\n    // M3: Conveyor items tick\n    if (this.conveyorSegments.length > 0) {\n      const segMap = buildSegmentMap(this.conveyorSegments);\n      const result = tickConveyorItems(this.conveyorItems, segMap, this.tickInterval);\n      this.conveyorItems = result.items;\n\n      // Deliver items to resource pool\n      for (const d of result.delivered) {\n        const delta: Partial<Resources> = {};\n        (delta as Record<string, number>)[d.resource] = d.amount;\n        this.state = { ...this.state, resources: { ...this.state.resources, [d.resource]: (this.state.resources[d.resource] ?? 0) + d.amount } };\n      }\n    }\n\n    // M3: Puppet tick\n    for (let i = 0; i < this.puppets.length; i++) {\n      this.puppets[i] = tickPuppet(this.puppets[i], this.tickInterval);\n    }\n\n    this.onStateChange?.(this.state);\n  }\n\n  private render(now: number): void {\n    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n    const preview = this.placementMode\n      ? {\n          def: this.placementMode,\n          gx: this.placementPos.gx,\n          gy: this.placementPos.gy,\n          valid: this.placementValid,\n        }\n      : null;\n\n    this.renderer.render(\n      this.map,\n      buildings,\n      this.buildingDefs,\n      this.state.resources,\n      this.state.realm,\n      this.state.cultivation,\n      this.hoveredCell,\n      preview,\n      now,\n    );\n\n    // M3: Render conveyors\n    const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n    const segMap = buildSegmentMap(this.conveyorSegments);\n    for (const seg of this.conveyorSegments) {\n      renderConveyorSegment(this.renderer.ctx, seg, offsetX, offsetY, scale, this.map.cellSize, now);\n    }\n    renderConveyorItems(this.renderer.ctx, this.conveyorItems, segMap, offsetX, offsetY, scale, this.map.cellSize);\n\n    // M3: Render puppets\n    for (const puppet of this.puppets) {\n      renderPuppet(this.renderer.ctx, puppet, offsetX, offsetY, scale, this.map.cellSize, now);\n    }\n\n    // Render breakthrough animation overlay\n    if (this.breakthroughAnim.active) {\n      this.renderBreakthroughOverlay(now);\n    }\n  }\n\n  private renderBreakthroughOverlay(now: number): void {\n    const ctx = this.renderer.ctx;\n    const w = this.canvas.getBoundingClientRect().width;\n    const h = this.canvas.getBoundingClientRect().height;\n\n    const elapsed = now - this.breakthroughAnim.startTime;\n    const progress = Math.min(1, elapsed / this.breakthroughAnim.duration);\n\n    let alpha = 0;\n    if (progress < 0.2) alpha = progress / 0.2;\n    else if (progress > 0.8) alpha = (1 - progress) / 0.2;\n    else alpha = 1;\n\n    const result = this.breakthroughAnim.result;\n\n    if (result?.success) {\n      ctx.fillStyle = `rgba(255, 215, 0, ${alpha * 0.15})`;\n      ctx.fillRect(0, 0, w, h);\n\n      ctx.fillStyle = `rgba(255, 215, 0, ${alpha})`;\n      ctx.font = `bold ${24 + Math.sin(progress * Math.PI * 4) * 4}px serif`;\n      ctx.textAlign = 'center';\n      ctx.textBaseline = 'middle';\n      ctx.fillText('⚡ 境界突破成功 ⚡', w / 2, h / 2 - 20);\n\n      ctx.font = '16px serif';\n      ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;\n      const realmName = getFullRealmName(this.state.cultivation);\n      ctx.fillText(`进入 ${realmName}`, w / 2, h / 2 + 20);\n    } else if (result) {\n      ctx.fillStyle = `rgba(200, 50, 50, ${alpha * 0.15})`;\n      ctx.fillRect(0, 0, w, h);\n\n      ctx.fillStyle = `rgba(255, 100, 100, ${alpha})`;\n      ctx.font = 'bold 24px serif';\n      ctx.textAlign = 'center';\n      ctx.textBaseline = 'middle';\n      ctx.fillText('突破失败...', w / 2, h / 2 - 20);\n\n      ctx.font = '14px serif';\n      ctx.fillStyle = `rgba(255, 200, 200, ${alpha})`;\n      ctx.fillText(`修为损失 ${Math.floor(result.penalty * 100)}%`, w / 2, h / 2 + 20);\n    }\n\n    if (progress >= 1) {\n      this.breakthroughAnim.active = false;\n      this.breakthroughAnim.result = null;\n      this.onBreakthroughAnim?.(false, null);\n    }\n  }\n\n  // Try to place a building at current placement position\n  placeCurrentBuilding(): boolean {\n    if (!this.placementMode) return false;\n\n    const def = this.placementMode;\n    const { gx, gy } = this.placementPos;\n\n    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n    if (!canPlace(this.map, def, gx, gy, buildings)) return false;\n    if (!canAfford(this.state.resources, def.cost)) return false;\n\n    this.state = deductCost(this.state, def.cost);\n\n    // Handle conveyor/puppet/talisman placement\n    if (def.category === 'transport' && (def.id === 'conveyor_lv1' || def.id === 'conveyor_lv2')) {\n      const seg = createSegment(\n        `seg_${Date.now()}_${Math.random().toString(36).slice(2)}`,\n        gx, gy,\n        def.id === 'conveyor_lv1' ? 1 : 2,\n        'right',\n      );\n      const segMap = buildSegmentMap(this.conveyorSegments);\n      this.conveyorSegments.push(autoConnect(seg, segMap));\n      audioManager.playBuild();\n      this.addNotification(`放置了 ${def.name}`, 'success');\n      this.onStateChange?.(this.state);\n      return true;\n    }\n\n    if (def.category === 'automation' && def.id === 'puppet_sorter') {\n      const puppet = createPuppet(\n        `pup_${Date.now()}_${Math.random().toString(36).slice(2)}`,\n        gx, gy, 1,\n      );\n      this.puppets.push(puppet);\n      audioManager.playBuild();\n      this.addNotification(`放置了 ${def.name}`, 'success');\n      this.onStateChange?.(this.state);\n      return true;\n    }\n\n    const instance = createBuildingInstance(def.id, gx, gy);\n    this.state = placeBuilding(this.state, this.currentRegionIndex, instance);\n\n    audioManager.playBuild();\n    this.addNotification(`建造了 ${def.name}`, 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  // Handle click on a building\n  private handleBuildingClick(building: BuildingInstance): void {\n    const def = this.buildingDefs.get(building.buildingId);\n    if (!def) return;\n\n    if (def.production.mode === 'manual') {\n      if (def.category === 'farming') {\n        if (!building.isProducing && building.progress < 1) {\n          this.state = plantField(this.state, building, this.currentRegionIndex);\n          audioManager.playCollect();\n        } else if (building.progress >= 1) {\n          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n          audioManager.playHarvest();\n          this.addNotification(`收获 ${def.production.amount} ${this.getResourceName(def.production.resource)}`, 'success');\n        }\n      } else if (def.category === 'mining') {\n        this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n        audioManager.playCollect();\n      } else if (def.category === 'alchemy') {\n        if (building.progress >= 1) {\n          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n          audioManager.playAlchemyComplete();\n          this.addNotification(`获得 ${def.production.amount} ${this.getResourceName(def.production.resource)}`, 'success');\n        } else if (!building.isProducing) {\n          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n          audioManager.playAlchemyStart();\n        }\n      } else if (def.category === 'cultivation') {\n        if (!building.isProducing) {\n          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n        }\n      }\n      this.onStateChange?.(this.state);\n    }\n\n    this.onBuildingSelect?.(building);\n  }\n\n  // === M2: Cultivation Actions ===\n\n  usePillAction(pillId: string): boolean {\n    const result = usePill(pillId, this.state.resources);\n    if (!result) return false;\n\n    this.state.resources = result.resources as Resources;\n    this.state.cultivation = addCultivationExp(this.state.cultivation, result.cultivation);\n    this.state = this.addCultivationToRealm(result.cultivation);\n\n    audioManager.playUsePill();\n    const pillName = this.getResourceName(pillId);\n    this.addNotification(`服用 ${pillName}，修为+${result.cultivation}`, 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  useAllPills(pillId: string): boolean {\n    const count = this.state.resources[pillId as keyof typeof this.state.resources] ?? 0;\n    if (count <= 0) return false;\n\n    const result = useMultiplePills(pillId, count, this.state.resources);\n    if (!result) return false;\n\n    this.state.resources = result.resources as Resources;\n    this.state.cultivation = addCultivationExp(this.state.cultivation, result.cultivation);\n    this.state = this.addCultivationToRealm(result.cultivation);\n\n    audioManager.playUsePill();\n    this.addNotification(`服用 ${result.used} ${this.getResourceName(pillId)}，修为+${result.cultivation}`, 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  private addCultivationToRealm(amount: number): GameState {\n    const next = cloneState(this.state);\n    next.realm.exp += amount;\n    while (next.realm.exp >= next.realm.expToNext) {\n      next.realm.exp -= next.realm.expToNext;\n      next.realm.level += 1;\n      next.realm.expToNext = Math.floor(next.realm.expToNext * 1.8);\n    }\n    return next;\n  }\n\n  attemptBreakthroughAction(): boolean {\n    if (!canBreakthrough(this.state.cultivation)) {\n      this.addNotification('修为不足，无法突破', 'warning');\n      return false;\n    }\n\n    const result = attemptBreakthrough(this.state.cultivation, this.state.resources);\n    if (!result) {\n      this.addNotification('材料不足，无法突破', 'warning');\n      return false;\n    }\n\n    this.state.cultivation = result.newState;\n    this.state.resources = result.newResources as Resources;\n\n    if (result.result.success) {\n      this.state.realm.realmId = result.newState.realmId;\n      this.state.realm.level = result.newState.level;\n      this.state.realm.exp = result.newState.exp;\n      this.state.realm.expToNext = result.newState.expToNext;\n    }\n\n    this.breakthroughAnim = {\n      active: true,\n      result: result.result,\n      startTime: performance.now(),\n      duration: 3000,\n    };\n\n    if (result.result.success) {\n      audioManager.playBreakthroughSuccess();\n      this.addNotification(`突破成功！进入 ${getFullRealmName(this.state.cultivation)}`, 'success');\n    } else {\n      audioManager.playBreakthroughFail();\n      this.addNotification(`突破失败，修为损失 ${Math.floor(result.result.penalty * 100)}%`, 'error');\n    }\n\n    this.onBreakthroughAnim?.(true, result.result);\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  getBreakthroughInfo() {\n    return getBreakthroughRequirements(this.state.cultivation);\n  }\n\n  // === M2: Alchemy Actions ===\n\n  getAvailableAlchemyRecipes(): AlchemyRecipe[] {\n    return getAvailableRecipes((realm) => cultivationIsRealmUnlocked(realm, this.state.cultivation));\n  }\n\n  startAlchemyAction(recipeId: string): boolean {\n    const crafting = startCrafting(recipeId, this.state.resources);\n    if (!crafting) return false;\n\n    this.state.resources = crafting.resources as Resources;\n    this.state.alchemySession = crafting.session;\n    audioManager.playAlchemyStart();\n    this.addNotification(`开始炼丹`, 'info');\n    this.onStateChange?.(this.state);\n    this.onAlchemyUpdate?.(this.state.alchemySession);\n    return true;\n  }\n\n  collectAlchemyAction(): boolean {\n    if (!this.state.alchemySession?.complete) return false;\n\n    const result = collectAlchemy(this.state.alchemySession, this.state.resources);\n    if (!result) return false;\n\n    this.state.resources = result.resources as Resources;\n    this.state.alchemySession = null;\n\n    if (result.success) {\n      this.state.cultivation = addCultivationExp(this.state.cultivation, result.expReward);\n      audioManager.playAlchemyComplete();\n      this.addNotification(`炼丹成功！获得 ${result.amount} 颗丹药`, 'success');\n    } else {\n      audioManager.playAlchemyFail();\n      this.addNotification('炼丹失败...', 'error');\n    }\n\n    this.onStateChange?.(this.state);\n    this.onAlchemyUpdate?.(null);\n    return true;\n  }\n\n  // === Notifications ===\n\n  addNotification(text: string, type: GameNotification['type'] = 'info'): void {\n    const notif: GameNotification = {\n      id: ++notifIdCounter,\n      text,\n      type,\n      time: Date.now(),\n    };\n    this.notifications.push(notif);\n    if (this.notifications.length > 10) {\n      this.notifications = this.notifications.slice(-10);\n    }\n    this.onNotification?.(notif);\n  }\n\n  // === Utility ===\n\n  private getResourceName(id: string): string {\n    const names: Record<string, string> = {\n      spirit_stone: '灵石',\n      spirit_grass: '灵草',\n      spirit_energy: '灵气',\n      cultivation: '修为',\n      pill_juling: '聚灵丹',\n      pill_peiyuan: '培元丹',\n      pill_ningqi: '凝气丹',\n      pill_zhuji: '筑基丹',\n      pill_jindanyin: '金丹引',\n      spirit_iron: '灵铁',\n      spirit_wood: '灵木',\n      talisman_paper: '符纸',\n    };\n    return names[id] ?? id;\n  }\n\n  centerCamera(): void {\n    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);\n  }\n\n  getAvailableBuildings(): BuildingDef[] {\n    return Array.from(this.buildingDefs.values()).filter(def => {\n      return cultivationIsRealmUnlocked(def.unlockRealm, this.state.cultivation);\n    });\n  }\n\n  getInventoryPills(): Array<PillDef & { count: number }> {\n    const result: Array<PillDef & { count: number }> = [];\n    for (const def of getAllPillDefs()) {\n      const count = this.state.resources[def.id as keyof typeof this.state.resources] ?? 0;\n      if (count > 0) {\n        result.push({ ...def, count });\n      }\n    }\n    return result;\n  }\n\n  private setupInput(canvas: HTMLCanvasElement): void {\n    canvas.addEventListener('mousemove', (e) => {\n      const rect = canvas.getBoundingClientRect();\n      const mx = e.clientX - rect.left;\n      const my = e.clientY - rect.top;\n\n      const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n      this.hoveredCell = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n\n      if (this.placementMode && this.hoveredCell) {\n        this.placementPos = { gx: this.hoveredCell.gx, gy: this.hoveredCell.gy };\n        const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n        this.placementValid = canPlace(\n          this.map,\n          this.placementMode,\n          this.placementPos.gx,\n          this.placementPos.gy,\n          buildings,\n        );\n      }\n    });\n\n    canvas.addEventListener('mousedown', (e) => {\n      if (e.button !== 0) return;\n      this.clickStartTime = performance.now();\n      this.clickStartPos = { x: e.clientX, y: e.clientY };\n    });\n\n    canvas.addEventListener('mouseup', (e) => {\n      if (e.button !== 0) return;\n      const dt = performance.now() - this.clickStartTime;\n      const dx = Math.abs(e.clientX - this.clickStartPos.x);\n      const dy = Math.abs(e.clientY - this.clickStartPos.y);\n\n      if (dt < 300 && dx < 5 && dy < 5) {\n        audioManager.init();\n        audioManager.resume();\n        this.handleClick(e);\n      }\n    });\n\n    document.addEventListener('keydown', (e) => {\n      if (e.key === 'Escape') {\n        this.placementMode = null;\n      }\n    });\n  }\n\n  private handleClick(e: MouseEvent): void {\n    const rect = this.canvas.getBoundingClientRect();\n    const mx = e.clientX - rect.left;\n    const my = e.clientY - rect.top;\n    const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n    const { gx, gy } = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n\n    if (!this.map.inBounds(gx, gy)) return;\n\n    if (this.placementMode) {\n      this.placementPos = { gx, gy };\n      const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n      this.placementValid = canPlace(this.map, this.placementMode, gx, gy, buildings);\n      if (this.placementValid) {\n        this.placeCurrentBuilding();\n      }\n      return;\n    }\n\n    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n    const clicked = buildings.find(b => {\n      const def = this.buildingDefs.get(b.buildingId);\n      if (!def) return false;\n      return (\n        gx >= b.gridX && gx < b.gridX + def.size.w &&\n        gy >= b.gridY && gy < b.gridY + def.size.h\n      );\n    });\n\n    if (clicked) {\n      this.handleBuildingClick(clicked);\n    }\n  }\n}\n","numLines":790,"startLine":1,"totalLines":790}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ae7718bce1fb41789f8cf5dd","type":"tool_result","content":"1\t// Inventory.ts — Inventory and pill management system\n2\t\n3\texport interface PillDef {\n4\t  id: string;\n5\t  name: string;\n6\t  nameEn: string;\n7\t  description: string;\n8\t  effect: string;\n9\t  cultivationAmount: number;\n10\t  grade: string;\n11\t  color: string;\n12\t}\n13\t\n14\tconst PILL_DEFS: Record<string, PillDef> = {\n15\t  pill_juling: {\n16\t    id: 'pill_juling',\n17\t    name: '聚灵丹',\n18\t    nameEn: 'Spirit Gathering Pill',\n19\t    description: '基础修炼丹药',\n20\t    effect: '服用获得修为+10',\n21\t    cultivationAmount: 10,\n22\t    grade: '下品',\n23\t    color: '#ff8c32',\n24\t  },\n25\t  pill_peiyuan: {\n26\t    id: 'pill_peiyuan',\n27\t    name: '培元丹',\n28\t    nameEn: 'Foundation Pill',\n29\t    description: '培元固本的丹药',\n30\t    effect: '服用获得修为+30',\n31\t    cultivationAmount: 30,\n32\t    grade: '下品',\n33\t    color: '#ff6699',\n34\t  },\n35\t  pill_ningqi: {\n36\t    id: 'pill_ningqi',\n37\t    name: '凝气丹',\n38\t    nameEn: 'Qi Condensing Pill',\n39\t    description: '凝练灵气的高级丹药',\n40\t    effect: '服用获得修为+50',\n41\t    cultivationAmount: 50,\n42\t    grade: '下品',\n43\t    color: '#cc66ff',\n44\t  },\n45\t  pill_zhuji: {\n46\t    id: 'pill_zhuji',\n47\t    name: '筑基丹',\n48\t    nameEn: 'Foundation Pill',\n49\t    description: '筑基必备丹药',\n50\t    effect: '服用获得修为+100',\n51\t    cultivationAmount: 100,\n52\t    grade: '中品',\n53\t    color: '#ffcc00',\n54\t  },\n55\t  pill_jindanyin: {\n56\t    id: 'pill_jindanyin',\n57\t    name: '金丹引',\n58\t    nameEn: 'Golden Core Catalyst',\n59\t    description: '金丹期必备丹药',\n60\t    effect: '服用获得修为+500',\n61\t    cultivationAmount: 500,\n62\t    grade: '中品',\n63\t    color: '#ff4444',\n64\t  },\n65\t};\n66\t\n67\texport function getPillDef(id: string): PillDef | undefined {\n68\t  return PILL_DEFS[id];\n69\t}\n70\t\n71\texport function getAllPillDefs(): PillDef[] {\n72\t  return Object.values(PILL_DEFS);\n73\t}\n74\t\n75\t// Get all pills in inventory with their definitions and counts\n76\texport function getInventoryPills(resources: Record<string, number>): Array<PillDef & { count: number }> {\n77\t  const result: Array<PillDef & { count: number }> = [];\n78\t  for (const [id, def] of Object.entries(PILL_DEFS)) {\n79\t    const count = resources[id] ?? 0;\n80\t    if (count > 0) {\n81\t      result.push({ ...def, count });\n82\t    }\n83\t  }\n84\t  return result;\n85\t}\n86\t\n87\t// Use a pill: returns cultivation amount gained\n88\texport function usePill(\n89\t  pillId: string,\n90\t  resources: Record<string, number>,\n91\t): { cultivation: number; resources: Record<string, number> } | null {\n92\t  const def = PILL_DEFS[pillId];\n93\t  if (!def) return null;\n94\t\n95\t  const count = resources[pillId] ?? 0;\n96\t  if (count <= 0) return null;\n97\t\n98\t  const newResources = { ...resources };\n99\t  newResources[pillId] = count - 1;\n100\t\n101\t  return {\n102\t    cultivation: def.cultivationAmount,\n103\t    resources: newResources,\n104\t  };\n105\t}\n106\t\n107\t// Use multiple pills at once\n108\texport function useMultiplePills(\n109\t  pillId: string,\n110\t  amount: number,\n111\t  resources: Record<string, number>,\n112\t): { cultivation: number; resources: Record<string, number>; used: number } | null {\n113\t  const def = PILL_DEFS[pillId];\n114\t  if (!def) return null;\n115\t\n116\t  const count = resources[pillId] ?? 0;\n117\t  const toUse = Math.min(count, amount);\n118\t  if (toUse <= 0) return null;\n119\t\n120\t  const newResources = { ...resources };\n121\t  newResources[pillId] = count - toUse;\n122\t\n123\t  return {\n124\t    cultivation: def.cultivationAmount * toUse,\n125\t    resources: newResources,\n126\t    used: toUse,\n127\t  };\n128\t}\n129\t"}]},"parent_tool_use_id":null,"session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"21e2d52d-24bf-49f1-b78d-295525b27b52","timestamp":"2026-05-23T02:11:23.802Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Inventory.ts","content":"// Inventory.ts — Inventory and pill management system\n\nexport interface PillDef {\n  id: string;\n  name: string;\n  nameEn: string;\n  description: string;\n  effect: string;\n  cultivationAmount: number;\n  grade: string;\n  color: string;\n}\n\nconst PILL_DEFS: Record<string, PillDef> = {\n  pill_juling: {\n    id: 'pill_juling',\n    name: '聚灵丹',\n    nameEn: 'Spirit Gathering Pill',\n    description: '基础修炼丹药',\n    effect: '服用获得修为+10',\n    cultivationAmount: 10,\n    grade: '下品',\n    color: '#ff8c32',\n  },\n  pill_peiyuan: {\n    id: 'pill_peiyuan',\n    name: '培元丹',\n    nameEn: 'Foundation Pill',\n    description: '培元固本的丹药',\n    effect: '服用获得修为+30',\n    cultivationAmount: 30,\n    grade: '下品',\n    color: '#ff6699',\n  },\n  pill_ningqi: {\n    id: 'pill_ningqi',\n    name: '凝气丹',\n    nameEn: 'Qi Condensing Pill',\n    description: '凝练灵气的高级丹药',\n    effect: '服用获得修为+50',\n    cultivationAmount: 50,\n    grade: '下品',\n    color: '#cc66ff',\n  },\n  pill_zhuji: {\n    id: 'pill_zhuji',\n    name: '筑基丹',\n    nameEn: 'Foundation Pill',\n    description: '筑基必备丹药',\n    effect: '服用获得修为+100',\n    cultivationAmount: 100,\n    grade: '中品',\n    color: '#ffcc00',\n  },\n  pill_jindanyin: {\n    id: 'pill_jindanyin',\n    name: '金丹引',\n    nameEn: 'Golden Core Catalyst',\n    description: '金丹期必备丹药',\n    effect: '服用获得修为+500',\n    cultivationAmount: 500,\n    grade: '中品',\n    color: '#ff4444',\n  },\n};\n\nexport function getPillDef(id: string): PillDef | undefined {\n  return PILL_DEFS[id];\n}\n\nexport function getAllPillDefs(): PillDef[] {\n  return Object.values(PILL_DEFS);\n}\n\n// Get all pills in inventory with their definitions and counts\nexport function getInventoryPills(resources: Record<string, number>): Array<PillDef & { count: number }> {\n  const result: Array<PillDef & { count: number }> = [];\n  for (const [id, def] of Object.entries(PILL_DEFS)) {\n    const count = resources[id] ?? 0;\n    if (count > 0) {\n      result.push({ ...def, count });\n    }\n  }\n  return result;\n}\n\n// Use a pill: returns cultivation amount gained\nexport function usePill(\n  pillId: string,\n  resources: Record<string, number>,\n): { cultivation: number; resources: Record<string, number> } | null {\n  const def = PILL_DEFS[pillId];\n  if (!def) return null;\n\n  const count = resources[pillId] ?? 0;\n  if (count <= 0) return null;\n\n  const newResources = { ...resources };\n  newResources[pillId] = count - 1;\n\n  return {\n    cultivation: def.cultivationAmount,\n    resources: newResources,\n  };\n}\n\n// Use multiple pills at once\nexport function useMultiplePills(\n  pillId: string,\n  amount: number,\n  resources: Record<string, number>,\n): { cultivation: number; resources: Record<string, number>; used: number } | null {\n  const def = PILL_DEFS[pillId];\n  if (!def) return null;\n\n  const count = resources[pillId] ?? 0;\n  const toUse = Math.min(count, amount);\n  if (toUse <= 0) return null;\n\n  const newResources = { ...resources };\n  newResources[pillId] = count - toUse;\n\n  return {\n    cultivation: def.cultivationAmount * toUse,\n    resources: newResources,\n    used: toUse,\n  };\n}\n","numLines":129,"startLine":1,"totalLines":129}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6bf27a6c2433435ba77dc994","type":"tool_result","content":"1\t// Building.ts — Building placement system with grid validation\n2\t\n3\timport type { BuildingInstance } from './GameState';\n4\timport { GameMap, Terrain } from './Map';\n5\t\n6\texport interface BuildingDef {\n7\t  id: string;\n8\t  name: string;\n9\t  nameEn: string;\n10\t  type: string;\n11\t  category: string;\n12\t  cost: Record<string, number>;\n13\t  size: { w: number; h: number };\n14\t  production: {\n15\t    resource: string;\n16\t    amount: number;\n17\t    interval: number;\n18\t    mode: string;\n19\t    input?: Record<string, number>;\n20\t  };\n21\t  description: string;\n22\t  unlockRealm: string;\n23\t  maxLevel: number;\n24\t  color: { r: number; g: number; b: number; a: number };\n25\t}\n26\t\n27\tlet uidCounter = 0;\n28\t\n29\texport function generateUid(): string {\n30\t  return `b_${Date.now()}_${++uidCounter}`;\n31\t}\n32\t\n33\texport function createBuildingInstance(\n34\t  buildingId: string,\n35\t  gridX: number,\n36\t  gridY: number,\n37\t): BuildingInstance {\n38\t  return {\n39\t    uid: generateUid(),\n40\t    buildingId,\n41\t    gridX,\n42\t    gridY,\n43\t    level: 1,\n44\t    lastCollectTime: 0,\n45\t    isProducing: false,\n46\t    progress: 0,\n47\t  };\n48\t}\n49\t\n50\t// Check if a building can be placed at the given position\n51\texport function canPlace(\n52\t  map: GameMap,\n53\t  def: BuildingDef,\n54\t  gridX: number,\n55\t  gridY: number,\n56\t  existingBuildings: BuildingInstance[],\n57\t): boolean {\n58\t  // Build occupied set from existing buildings\n59\t  const occupied = buildOccupiedSet(existingBuildings);\n60\t\n61\t  // Check the area is free\n62\t  if (!map.isAreaFree(gridX, gridY, def.size.w, def.size.h, occupied)) {\n63\t    return false;\n64\t  }\n65\t\n66\t  // Spirit vein buildings should be near spirit veins\n67\t  if (def.category === 'mining') {\n68\t    let nearVein = false;\n69\t    for (let dy = -1; dy <= def.size.h && !nearVein; dy++) {\n70\t      for (let dx = -1; dx <= def.size.w && !nearVein; dx++) {\n71\t        const t = map.getTerrain(gridX + dx, gridY + dy);\n72\t        if (t === Terrain.SpiritVein) nearVein = true;\n73\t      }\n74\t    }\n75\t    // Allow placement anywhere for now (relaxed constraint for M1)\n76\t  }\n77\t\n78\t  return true;\n79\t}\n80\t\n81\t// Get all grid cells occupied by a building\n82\texport function getBuildingCells(building: BuildingInstance, def: BuildingDef): string[] {\n83\t  const cells: string[] = [];\n84\t  for (let dy = 0; dy < def.size.h; dy++) {\n85\t    for (let dx = 0; dx < def.size.w; dx++) {\n86\t      cells.push(`${building.gridX + dx},${building.gridY + dy}`);\n87\t    }\n88\t  }\n89\t  return cells;\n90\t}\n91\t\n92\t// Build a set of occupied grid positions\n93\texport function buildOccupiedSet(buildings: BuildingInstance[], defs?: Map<string, BuildingDef>): Set<string> {\n94\t  const occupied = new Set<string>();\n95\t  for (const b of buildings) {\n96\t    const size = defs?.get(b.buildingId)?.size ?? { w: 1, h: 1 };\n97\t    for (let dy = 0; dy < size.h; dy++) {\n98\t      for (let dx = 0; dx < size.w; dx++) {\n99\t        occupied.add(`${b.gridX + dx},${b.gridY + dy}`);\n100\t      }\n101\t    }\n102\t  }\n103\t  return occupied;\n104\t}\n105\t\n106\t// Render a building on canvas\n107\texport function renderBuilding(\n108\t  ctx: CanvasRenderingContext2D,\n109\t  building: BuildingInstance,\n110\t  def: BuildingDef,\n111\t  offsetX: number,\n112\t  offsetY: number,\n113\t  scale: number,\n114\t  cellSize: number,\n115\t  now: number,\n116\t): void {\n117\t  const x = offsetX + building.gridX * cellSize * scale;\n118\t  const y = offsetY + building.gridY * cellSize * scale;\n119\t  const w = def.size.w * cellSize * scale;\n120\t  const h = def.size.h * cellSize * scale;\n121\t\n122\t  const { r, g, b, a } = def.color;\n123\t\n124\t  // Building body\n125\t  ctx.fillStyle = `rgba(${r},${g},${b},${a})`;\n126\t  ctx.fillRect(x + 2, y + 2, w - 4, h - 4);\n127\t\n128\t  // Border\n129\t  ctx.strokeStyle = `rgba(${Math.min(255, r + 40)},${Math.min(255, g + 40)},${Math.min(255, b + 40)},0.8)`;\n130\t  ctx.lineWidth = 1.5;\n131\t  ctx.strokeRect(x + 2, y + 2, w - 4, h - 4);\n132\t\n133\t  // Icon/label\n134\t  const fontSize = Math.max(8, Math.floor(10 * scale));\n135\t  ctx.fillStyle = '#fff';\n136\t  ctx.font = `bold ${fontSize}px monospace`;\n137\t  ctx.textAlign = 'center';\n138\t  ctx.textBaseline = 'middle';\n139\t\n140\t  const centerX = x + w / 2;\n141\t  const centerY = y + h / 2;\n142\t\n143\t  // Draw icon based on category\n144\t  const icon = getCategoryIcon(def.category);\n145\t  ctx.font = `${Math.max(12, Math.floor(16 * scale))}px serif`;\n146\t  ctx.fillText(icon, centerX, centerY - 4 * scale);\n147\t\n148\t  // Draw level\n149\t  ctx.font = `bold ${Math.max(6, Math.floor(8 * scale))}px monospace`;\n150\t  ctx.fillStyle = '#ffd700';\n151\t  ctx.fillText(`Lv${building.level}`, centerX, centerY + 10 * scale);\n152\t\n153\t  // Progress bar for auto-production\n154\t  if (def.production.mode === 'auto' && building.isProducing) {\n155\t    const barW = w - 8;\n156\t    const barH = 3 * scale;\n157\t    const barY = y + h - 6 * scale;\n158\t    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n159\t    ctx.fillRect(x + 4, barY, barW, barH);\n160\t    ctx.fillStyle = '#4f4';\n161\t    ctx.fillRect(x + 4, barY, barW * building.progress, barH);\n162\t  }\n163\t\n164\t  // Production ready indicator (for manual buildings)\n165\t  if (def.production.mode === 'manual' && building.progress >= 1) {\n166\t    ctx.fillStyle = '#ff0';\n167\t    ctx.beginPath();\n168\t    ctx.arc(x + w - 6 * scale, y + 6 * scale, 3 * scale, 0, Math.PI * 2);\n169\t    ctx.fill();\n170\t  }\n171\t}\n172\t\n173\tfunction getCategoryIcon(category: string): string {\n174\t  const icons: Record<string, string> = {\n175\t    mining: '⛏',\n176\t    farming: '🌿',\n177\t    alchemy: '🔥',\n178\t    energy: '✨',\n179\t    transport: '➡',\n180\t    control: '📜',\n181\t    automation: '🤖',\n182\t    processing: '🔩',\n183\t    cultivation: '🧘',\n184\t  };\n185\t  return icons[category] || '🏠';\n186\t}\n187\t\n188\t// Parse building definitions from JSON\n189\texport function loadBuildingDefs(data: { buildings: BuildingDef[] }): Map<string, BuildingDef> {\n190\t  const map = new Map<string, BuildingDef>();\n191\t  for (const b of data.buildings) {\n192\t    map.set(b.id, b);\n193\t  }\n194\t  return map;\n195\t}\n196\t"}]},"parent_tool_use_id":null,"session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"ee0391ec-07e4-4f43-869e-6623e80cad41","timestamp":"2026-05-23T02:11:23.805Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Building.ts","content":"// Building.ts — Building placement system with grid validation\n\nimport type { BuildingInstance } from './GameState';\nimport { GameMap, Terrain } from './Map';\n\nexport interface BuildingDef {\n  id: string;\n  name: string;\n  nameEn: string;\n  type: string;\n  category: string;\n  cost: Record<string, number>;\n  size: { w: number; h: number };\n  production: {\n    resource: string;\n    amount: number;\n    interval: number;\n    mode: string;\n    input?: Record<string, number>;\n  };\n  description: string;\n  unlockRealm: string;\n  maxLevel: number;\n  color: { r: number; g: number; b: number; a: number };\n}\n\nlet uidCounter = 0;\n\nexport function generateUid(): string {\n  return `b_${Date.now()}_${++uidCounter}`;\n}\n\nexport function createBuildingInstance(\n  buildingId: string,\n  gridX: number,\n  gridY: number,\n): BuildingInstance {\n  return {\n    uid: generateUid(),\n    buildingId,\n    gridX,\n    gridY,\n    level: 1,\n    lastCollectTime: 0,\n    isProducing: false,\n    progress: 0,\n  };\n}\n\n// Check if a building can be placed at the given position\nexport function canPlace(\n  map: GameMap,\n  def: BuildingDef,\n  gridX: number,\n  gridY: number,\n  existingBuildings: BuildingInstance[],\n): boolean {\n  // Build occupied set from existing buildings\n  const occupied = buildOccupiedSet(existingBuildings);\n\n  // Check the area is free\n  if (!map.isAreaFree(gridX, gridY, def.size.w, def.size.h, occupied)) {\n    return false;\n  }\n\n  // Spirit vein buildings should be near spirit veins\n  if (def.category === 'mining') {\n    let nearVein = false;\n    for (let dy = -1; dy <= def.size.h && !nearVein; dy++) {\n      for (let dx = -1; dx <= def.size.w && !nearVein; dx++) {\n        const t = map.getTerrain(gridX + dx, gridY + dy);\n        if (t === Terrain.SpiritVein) nearVein = true;\n      }\n    }\n    // Allow placement anywhere for now (relaxed constraint for M1)\n  }\n\n  return true;\n}\n\n// Get all grid cells occupied by a building\nexport function getBuildingCells(building: BuildingInstance, def: BuildingDef): string[] {\n  const cells: string[] = [];\n  for (let dy = 0; dy < def.size.h; dy++) {\n    for (let dx = 0; dx < def.size.w; dx++) {\n      cells.push(`${building.gridX + dx},${building.gridY + dy}`);\n    }\n  }\n  return cells;\n}\n\n// Build a set of occupied grid positions\nexport function buildOccupiedSet(buildings: BuildingInstance[], defs?: Map<string, BuildingDef>): Set<string> {\n  const occupied = new Set<string>();\n  for (const b of buildings) {\n    const size = defs?.get(b.buildingId)?.size ?? { w: 1, h: 1 };\n    for (let dy = 0; dy < size.h; dy++) {\n      for (let dx = 0; dx < size.w; dx++) {\n        occupied.add(`${b.gridX + dx},${b.gridY + dy}`);\n      }\n    }\n  }\n  return occupied;\n}\n\n// Render a building on canvas\nexport function renderBuilding(\n  ctx: CanvasRenderingContext2D,\n  building: BuildingInstance,\n  def: BuildingDef,\n  offsetX: number,\n  offsetY: number,\n  scale: number,\n  cellSize: number,\n  now: number,\n): void {\n  const x = offsetX + building.gridX * cellSize * scale;\n  const y = offsetY + building.gridY * cellSize * scale;\n  const w = def.size.w * cellSize * scale;\n  const h = def.size.h * cellSize * scale;\n\n  const { r, g, b, a } = def.color;\n\n  // Building body\n  ctx.fillStyle = `rgba(${r},${g},${b},${a})`;\n  ctx.fillRect(x + 2, y + 2, w - 4, h - 4);\n\n  // Border\n  ctx.strokeStyle = `rgba(${Math.min(255, r + 40)},${Math.min(255, g + 40)},${Math.min(255, b + 40)},0.8)`;\n  ctx.lineWidth = 1.5;\n  ctx.strokeRect(x + 2, y + 2, w - 4, h - 4);\n\n  // Icon/label\n  const fontSize = Math.max(8, Math.floor(10 * scale));\n  ctx.fillStyle = '#fff';\n  ctx.font = `bold ${fontSize}px monospace`;\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n\n  const centerX = x + w / 2;\n  const centerY = y + h / 2;\n\n  // Draw icon based on category\n  const icon = getCategoryIcon(def.category);\n  ctx.font = `${Math.max(12, Math.floor(16 * scale))}px serif`;\n  ctx.fillText(icon, centerX, centerY - 4 * scale);\n\n  // Draw level\n  ctx.font = `bold ${Math.max(6, Math.floor(8 * scale))}px monospace`;\n  ctx.fillStyle = '#ffd700';\n  ctx.fillText(`Lv${building.level}`, centerX, centerY + 10 * scale);\n\n  // Progress bar for auto-production\n  if (def.production.mode === 'auto' && building.isProducing) {\n    const barW = w - 8;\n    const barH = 3 * scale;\n    const barY = y + h - 6 * scale;\n    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n    ctx.fillRect(x + 4, barY, barW, barH);\n    ctx.fillStyle = '#4f4';\n    ctx.fillRect(x + 4, barY, barW * building.progress, barH);\n  }\n\n  // Production ready indicator (for manual buildings)\n  if (def.production.mode === 'manual' && building.progress >= 1) {\n    ctx.fillStyle = '#ff0';\n    ctx.beginPath();\n    ctx.arc(x + w - 6 * scale, y + 6 * scale, 3 * scale, 0, Math.PI * 2);\n    ctx.fill();\n  }\n}\n\nfunction getCategoryIcon(category: string): string {\n  const icons: Record<string, string> = {\n    mining: '⛏',\n    farming: '🌿',\n    alchemy: '🔥',\n    energy: '✨',\n    transport: '➡',\n    control: '📜',\n    automation: '🤖',\n    processing: '🔩',\n    cultivation: '🧘',\n  };\n  return icons[category] || '🏠';\n}\n\n// Parse building definitions from JSON\nexport function loadBuildingDefs(data: { buildings: BuildingDef[] }): Map<string, BuildingDef> {\n  const map = new Map<string, BuildingDef>();\n  for (const b of data.buildings) {\n    map.set(b.id, b);\n  }\n  return map;\n}\n","numLines":196,"startLine":1,"totalLines":196}}}
