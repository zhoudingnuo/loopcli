{"type":"assistant","message":{"id":"msg_202605230529140c3ee2cef3d14a34","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_97f97f0186c54600b02d25da","name":"Write","input":{"file_path":"D:/game-projects/douyin-match3/src/js/Obstacle.js","content":"// Obstacle.js — Ice, Chain, Chocolate obstacle system\n\nconst OBSTACLE_NONE = 0;\nconst OBSTACLE_ICE = 1;\nconst OBSTACLE_CHAIN = 2;\nconst OBSTACLE_CHOCOLATE = 3;\n\nclass ObstacleCell {\n  constructor(type, row, col, hp = 1) {\n    this.type = type;\n    this.row = row;\n    this.col = col;\n    this.hp = hp;\n    this.maxHp = hp;\n    this.alpha = 1;\n    this.shakeTimer = 0;\n  }\n\n  damage(amount = 1) {\n    this.hp -= amount;\n    this.shakeTimer = 0.3;\n    return this.hp <= 0;\n  }\n\n  isDestroyed() {\n    return this.hp <= 0;\n  }\n}\n\nclass ObstacleManager {\n  constructor(board) {\n    this.board = board;\n    this.obstacles = [];\n    this.destroyedCount = 0;\n    this.destroyedByType = {};\n    this.onObstacleDestroyed = null;\n    this.onChocolateSpread = null;\n  }\n\n  loadFromConfig(configs) {\n    this.obstacles = [];\n    this.destroyedCount = 0;\n    this.destroyedByType = {};\n    if (!configs || !configs.length) return;\n    for (const cfg of configs) {\n      const hp = cfg.hp || 1;\n      this.obstacles.push(new ObstacleCell(cfg.type, cfg.row, cfg.col, hp));\n    }\n  }\n\n  getAt(row, col) {\n    return this.obstacles.find(o => o.row === row && o.col === col && !o.isDestroyed());\n  }\n\n  hasObstacle(row, col) {\n    return !!this.getAt(row, col);\n  }\n\n  hasIce(row, col) {\n    const o = this.getAt(row, col);\n    return o && o.type === OBSTACLE_ICE;\n  }\n\n  hasChain(row, col) {\n    const o = this.getAt(row, col);\n    return o && o.type === OBSTACLE_CHAIN;\n  }\n\n  hasChocolate(row, col) {\n    const o = this.getAt(row, col);\n    return o && o.type === OBSTACLE_CHOCOLATE;\n  }\n\n  isCellBlocked(row, col) {\n    return this.hasChocolate(row, col);\n  }\n\n  canSwap(row, col) {\n    return !this.hasChain(row, col);\n  }\n\n  onTilesMatched(matchedPositions) {\n    const destroyed = [];\n    const adjacentSet = new Set();\n    const atMatchSet = new Set();\n\n    for (const pos of matchedPositions) {\n      atMatchSet.add(`${pos.row},${pos.col}`);\n      for (const [dr, dc] of [[-1,0],[1,0],[0,-1],[0,1]]) {\n        const nr = pos.row + dr;\n        const nc = pos.col + dc;\n        if (this.board.isValid(nr, nc)) {\n          adjacentSet.add(`${nr},${nc}`);\n        }\n      }\n    }\n\n    for (const obs of this.obstacles) {\n      if (obs.isDestroyed()) continue;\n      const key = `${obs.row},${obs.col}`;\n      if (obs.type === OBSTACLE_ICE) {\n        if (atMatchSet.has(key)) {\n          if (obs.damage(1)) {\n            destroyed.push(obs);\n            this._trackDestroyed(obs);\n          }\n        }\n      } else if (obs.type === OBSTACLE_CHAIN) {\n        if (atMatchSet.has(key)) {\n          if (obs.damage(1)) {\n            destroyed.push(obs);\n            this._trackDestroyed(obs);\n          }\n        }\n      } else if (obs.type === OBSTACLE_CHOCOLATE) {\n        if (adjacentSet.has(key) || atMatchSet.has(key)) {\n          if (obs.damage(1)) {\n            destroyed.push(obs);\n            this._trackDestroyed(obs);\n          }\n        }\n      }\n    }\n\n    this.obstacles = this.obstacles.filter(o => !o.isDestroyed());\n    return destroyed;\n  }\n\n  _trackDestroyed(obs) {\n    this.destroyedCount++;\n    if (!this.destroyedByType[obs.type]) this.destroyedByType[obs.type] = 0;\n    this.destroyedByType[obs.type]++;\n    if (this.onObstacleDestroyed) this.onObstacleDestroyed(obs);\n  }\n\n  spreadChocolate() {\n    const chocolates = this.obstacles.filter(o => o.type === OBSTACLE_CHOCOLATE && !o.isDestroyed());\n    if (chocolates.length === 0) return [];\n\n    const dirs = [[-1,0],[1,0],[0,-1],[0,1]];\n    const choco = chocolates[Math.floor(Math.random() * chocolates.length)];\n    const candidates = [];\n\n    for (const [dr, dc] of dirs) {\n      const nr = choco.row + dr;\n      const nc = choco.col + dc;\n      if (this.board.isValid(nr, nc) && !this.hasObstacle(nr, nc)) {\n        candidates.push({ row: nr, col: nc });\n      }\n    }\n\n    if (candidates.length > 0) {\n      const target = candidates[Math.floor(Math.random() * candidates.length)];\n      const newObs = new ObstacleCell(OBSTACLE_CHOCOLATE, target.row, target.col);\n      this.obstacles.push(newObs);\n      this.board.clearCell(target.row, target.col);\n      if (this.onChocolateSpread) this.onChocolateSpread(newObs);\n      return [newObs];\n    }\n    return [];\n  }\n\n  addObstacle(type, row, col, hp) {\n    if (this.hasObstacle(row, col)) return null;\n    const obs = new ObstacleCell(type, row, col, hp || 1);\n    this.obstacles.push(obs);\n    if (type === OBSTACLE_CHOCOLATE) {\n      this.board.clearCell(row, col);\n    }\n    return obs;\n  }\n\n  countByType(type) {\n    return this.obstacles.filter(o => o.type === type && !o.isDestroyed()).length;\n  }\n\n  countAll() {\n    return this.obstacles.filter(o => !o.isDestroyed()).length;\n  }\n\n  clear() {\n    this.obstacles = [];\n  }\n\n  update(dt) {\n    for (const obs of this.obstacles) {\n      if (obs.shakeTimer > 0) obs.shakeTimer -= dt;\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = {\n  ObstacleCell, ObstacleManager,\n  OBSTACLE_NONE, OBSTACLE_ICE, OBSTACLE_CHAIN, OBSTACLE_CHOCOLATE\n};\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"4fc1920c-0b5c-4266-b43d-05c38f749fa3","uuid":"51d3130b-85a0-4185-9682-be2b78f796eb"}
