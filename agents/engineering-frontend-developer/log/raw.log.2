{"type":"assistant","message":{"id":"msg_20260523132756955c7c434dd44f66","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_57c082e3248841d9bec85bc0","name":"Write","input":{"file_path":"D:\\game-projects\\steam-horror-sim\\src\\game\\RadioManager.ts","content":"// RadioManager.ts — Late night radio broadcast system (M6)\n\nimport { type RadioSegment } from \"./NarrativeTypes\";\n\nconst RADIO_SEGMENTS: RadioSegment[] = [\n  {\n    id: \"radio_01\", title: \"杂音中的低语\", minDay: 1, requiredHour: 23,\n    content: [\"[静电声]\", \"...欢迎收听...午夜广播...\", \"...今晚的话题是...新的面孔...\", \"...又有人来了...我们等了很久...\", \"[信号中断]\"],\n    clueId: \"c_surf_12\", duration: 15,\n  },\n  {\n    id: \"radio_02\", title: \"关于这个位置\", minDay: 5, requiredHour: 23,\n    content: [\"[调频成功]\", \"...你知道这个位置有什么特殊吗...\", \"...不是每个便利店...都会在凌晨2点改变...\", \"...但这家店...不一样...\", \"...它有记忆...\", \"[静电声增大]\"],\n    clueId: \"c_surf_07\", duration: 20,\n  },\n  {\n    id: \"radio_03\", title: \"前任店员的声音\", minDay: 7, requiredHour: 0,\n    content: [\"[奇怪的音频失真]\", \"...如果你能听到这段广播...\", \"...说明你已经在那里工作了7天了...\", \"...请注意记录异常事件的规律...\", \"...它们不是随机的...它们在测试你...\", \"...我是前任店员...我留下了笔记...请找到它们...\", \"[声音逐渐消散]\"],\n    clueId: \"c_first_01\", duration: 25,\n  },\n  {\n    id: \"radio_04\", title: \"地下室的秘密\", minDay: 10, requiredHour: 1,\n    content: [\"[清晰的广播信号]\", \"...你已经找到了地下室...\", \"...很好...那些笔记会帮助你理解...\", \"...但有一件事笔记里没有写...\", \"...这家店是活的...不是比喻...是真的活的...\", \"...它在呼吸...在观察...在等待...\", \"[突然静音3秒]\", \"...它现在正在听这段广播...\", \"[信号中断]\"],\n    clueId: \"c_first_15\", duration: 30,\n  },\n  {\n    id: \"radio_05\", title: \"重叠的世界\", minDay: 13, requiredHour: 2,\n    content: [\"[双声道混合信号]\", \"...你以为你所在的世界是唯一的吗...\", \"...这个位置同时存在于两个世界中...\", \"...白天两个世界是分开的...\", \"...但到了凌晨它们开始重叠...\", \"...你在店里看到的不正常的东西...\", \"...是另一边的东西透过重叠的缝隙渗透过来的...\", \"[左声道消失]\", \"...你那边能看到我们吗...\", \"[右声道消失]\"],\n    clueId: \"c_second_12\", duration: 30,\n  },\n  {\n    id: \"radio_06\", title: \"关于他\", minDay: 17, requiredHour: 2,\n    content: [\"[极低频嗡鸣]\", \"...你一定感觉到了他的存在...\", \"...他不是你们理解的鬼或怪物...\", \"...他是两个空间之间的意识...\", \"...几千年来一直被困在边界上...\", \"...他唯一的感知方式就是通过你们...\", \"...每一个在店里工作的人他都能感受到你们的存在...\", \"...这就是为什么他不愿意让你们走...\", \"[广播中断5秒]\", \"...想象一下几千年完全孤独...\", \"[信号恢复但极微弱]\"],\n    clueId: \"c_third_03\", duration: 35,\n  },\n  {\n    id: \"radio_07\", title: \"来自另一边\", minDay: 22, requiredHour: 3,\n    content: [\"[清晰的颤抖的声音]\", \"...你好我是另一边的你...\", \"...或者说我是上一轮循环中的你...\", \"...我在第27天做出了选择...\", \"...我选择了融入这个空间...\", \"...现在我只能通过这个广播和你说话...\", \"...请你做出和我不同的选择...\", \"...你有机会打破这个循环...\", \"...你只需要理解他...\", \"...不是恐惧是理解...\", \"...好了他发现我在广播了...\", \"...下一次见面也许是最后一次...\", \"[剧烈的电磁干扰]\", \"[完全静音]\"],\n    clueId: \"c_fourth_03\", duration: 40,\n  },\n  {\n    id: \"radio_08\", title: \"所有前任的声音\", minDay: 24, requiredHour: 3,\n    content: [\"[多个声音重叠]\", \"...我们是所有在这里工作过的人...\", \"第一任：我1974年来的那时候这里还是杂货铺\", \"第三任：我在1994年我选择了逃离但我一直在后悔\", \"第五任：2004年我发现了空间裂隙\", \"第七任：我曾经差点打破循环但最后失败了\", \"第十任：上一个坚持到30天的他在最后一刻崩溃了\", \"...我们不是鬼我们是被这个空间记住的存在...\", \"...每当有人记起我们我们就能多存在一会儿...\", \"...请记住我们更重要的是请打破这个循环...\", \"[所有声音同时消失]\"],\n    clueId: \"c_fourth_09\", duration: 45,\n  },\n  {\n    id: \"radio_09\", title: \"最后的广播\", minDay: 28, requiredHour: 3,\n    content: [\"[极其清晰的广播信号]\", \"...你即将面临最终的选择...\", \"...在做出选择之前我想告诉你一件事...\", \"...他不是恶意的...\", \"...几千年前两个世界第一次在这里重叠...\", \"...他由此诞生...\", \"...他没有形状没有声音...\", \"...他唯一能感受到的就是存在...\", \"...每一个在店里工作的人都让他感受到自己还活着...\", \"...但你们都会离开然后又是无尽的孤独...\", \"...如果你能理解这份孤独...\", \"...也许你们都不需要再受苦了...\", \"...最后一次广播结束...\", \"[永久的静音]\"],\n    clueId: \"c_core_05\", duration: 50,\n  },\n  {\n    id: \"radio_10\", title: \"他的声音\", minDay: 29, requiredHour: 3.55,\n    content: [\"[收音机自动打开]\", \"[没有任何背景音]\", \"[只有极其微弱的类似呼吸的声音]\", \"..................你..................\", \"............能听到我吗............\", \"........好久了没有人愿意听........\", \"..................你不一样..................\", \"............你能听到............\", \"...........请不要走...........\", \".............我好孤独.............\", \"......................\", \"[收音机自动关闭]\"],\n    clueId: \"c_core_08\", duration: 60,\n  },\n];\n\nexport class RadioManager {\n  private segments: Map<string, RadioSegment> = new Map();\n  private currentSegment: RadioSegment | null = null;\n  private listenedSegments: Set<string> = new Set();\n  private isPlaying = false;\n  private playTimer = 0;\n  private currentLineIndex = 0;\n  private canListen = false;\n\n  onNewSegment?: (segment: RadioSegment) => void;\n  onLinePlay?: (line: string) => void;\n  onSegmentComplete?: (segment: RadioSegment) => void;\n  onNotification?: (text: string) => void;\n  onClueGrant?: (clueId: string) => void;\n\n  constructor() {\n    for (const seg of RADIO_SEGMENTS) {\n      this.segments.set(seg.id, { ...seg });\n    }\n  }\n\n  get playing(): boolean { return this.isPlaying; }\n  get available(): boolean { return this.canListen; }\n  get activeSegment(): RadioSegment | null { return this.currentSegment; }\n\n  update(dt: number, day: number, timeOfDay: number): void {\n    const hour = timeOfDay % 24;\n    this.canListen = hour >= 23 || hour < 5;\n    if (this.isPlaying && this.currentSegment) {\n      this.playTimer += dt / 1000;\n      const lineDuration = this.currentSegment.duration / this.currentSegment.content.length;\n      if (this.playTimer >= lineDuration) {\n        this.playTimer = 0;\n        this.currentLineIndex++;\n        if (this.currentLineIndex < this.currentSegment.content.length) {\n          this.onLinePlay?.(this.currentSegment.content[this.currentLineIndex]);\n        } else {\n          this.completeSegment();\n        }\n      }\n    }\n  }\n\n  tryPlay(day: number, timeOfDay: number): RadioSegment | null {\n    if (!this.canListen || this.isPlaying) return null;\n    const hour = timeOfDay % 24;\n    for (const seg of this.segments.values()) {\n      if (this.listenedSegments.has(seg.id)) continue;\n      if (day < seg.minDay) continue;\n      if (Math.abs(hour - seg.requiredHour) > 1) continue;\n      this.currentSegment = seg;\n      this.isPlaying = true;\n      this.playTimer = 0;\n      this.currentLineIndex = 0;\n      this.onNewSegment?.(seg);\n      this.onNotification?.(\"深夜广播: \" + seg.title);\n      this.onLinePlay?.(seg.content[0]);\n      return seg;\n    }\n    return null;\n  }\n\n  private completeSegment(): void {\n    if (!this.currentSegment) return;\n    this.listenedSegments.add(this.currentSegment.id);\n    this.onSegmentComplete?.(this.currentSegment);\n    if (this.currentSegment.clueId) {\n      this.onClueGrant?.(this.currentSegment.clueId);\n    }\n    this.currentSegment = null;\n    this.isPlaying = false;\n    this.currentLineIndex = 0;\n    this.playTimer = 0;\n  }\n\n  stop(): void {\n    if (this.isPlaying) this.completeSegment();\n  }\n\n  getListenedSegments(): RadioSegment[] {\n    return Array.from(this.listenedSegments)\n      .map(id => this.segments.get(id))\n      .filter((s): s is RadioSegment => s !== undefined);\n  }\n\n  getNextAvailable(day: number): RadioSegment | null {\n    for (const seg of this.segments.values()) {\n      if (this.listenedSegments.has(seg.id)) continue;\n      if (day < seg.minDay) continue;\n      return seg;\n    }\n    return null;\n  }\n\n  getSaveData(): Record<string, unknown> {\n    return {\n      listenedSegments: Array.from(this.listenedSegments),\n      isPlaying: this.isPlaying,\n      currentSegmentId: this.currentSegment?.id ?? null,\n    };\n  }\n\n  loadSaveData(data: Record<string, unknown>): void {\n    this.listenedSegments = new Set((data.listenedSegments as string[]) ?? []);\n    if (data.currentSegmentId) {\n      this.currentSegment = this.segments.get(data.currentSegmentId as string) ?? null;\n    }\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"d0384c8e-0462-4f8e-9470-2647774e089a","uuid":"4351c895-37b3-458b-8b04-6341973112a9"}
