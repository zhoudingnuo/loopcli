 shuffle\n    this._removeInitialMatches();\n    // If still no valid moves, re-init\n    if (!this.hasValidMoves()) {\n      this.init();\n    }\n  }","originalFile":"// Board.js — 8x8 grid state management\nconst TILE_COLORS = 6;\nconst BOARD_SIZE = 8;\nconst EMPTY = -1;\n\nconst COLOR_MAP = {\n  0: { name: 'apple',   hex: '#FF4D4D', label: '红' },\n  1: { name: 'banana',  hex: '#FFD93D', label: '黄' },\n  2: { name: 'blueberry', hex: '#4DA6FF', label: '蓝' },\n  3: { name: 'lime',    hex: '#6BCB77', label: '绿' },\n  4: { name: 'grape',   hex: '#B47AEA', label: '紫' },\n  5: { name: 'orange',  hex: '#FF9A3C', label: '橙' },\n};\n\n// Special tile types\nconst SPECIAL_NONE = 0;\nconst SPECIAL_STRIPED_H = 1;  // horizontal stripe bomb\nconst SPECIAL_STRIPED_V = 2;  // vertical stripe bomb\nconst SPECIAL_BOMB = 3;       // 3x3 area bomb\nconst SPECIAL_RAINBOW = 4;    // clears all of one color\n\nclass Tile {\n  constructor(color, row, col) {\n    this.color = color;\n    this.row = row;\n    this.col = col;\n    this.special = SPECIAL_NONE;\n    this.removing = false;\n    this.offsetY = 0;\n    this.offsetX = 0;\n    this.scale = 1;\n    this.alpha = 1;\n    this.selected = false;\n    this.id = Tile._nextId++;\n  }\n  get type() { return this.color; }\n}\n\nTile._nextId = 0;\n\nclass Board {\n  constructor(size = BOARD_SIZE, numColors = TILE_COLORS) {\n    this.size = size;\n    this.numColors = numColors;\n    this.grid = [];\n    this.listeners = [];\n  }\n\n  init() {\n    this.grid = [];\n    for (let r = 0; r < this.size; r++) {\n      this.grid[r] = [];\n      for (let c = 0; c < this.size; c++) {\n        this.grid[r][c] = this._createTile(r, c);\n      }\n    }\n    // Ensure no initial matches\n    this._removeInitialMatches();\n  }\n\n  _createTile(row, col) {\n    return new Tile(this._randomColor(), row, col);\n  }\n\n  _randomColor() {\n    return Math.floor(Math.random() * this.numColors);\n  }\n\n  _removeInitialMatches() {\n    let maxIter = 1000;\n    while (this._hasMatch() && maxIter-- > 0) {\n      const matches = this.findAllMatches();\n      for (const group of matches) {\n        for (const { row, col } of group.cells) {\n          this.grid[row][col] = this._createTile(row, col);\n        }\n      }\n    }\n  }\n\n  _hasMatch() {\n    return this.findAllMatches().length > 0;\n  }\n\n  getTile(r, c) {\n    if (r < 0 || r >= this.size || c < 0 || c >= this.size) return null;\n    return this.grid[r][c];\n  }\n\n  setTile(r, c, tile) {\n    if (r >= 0 && r < this.size && c >= 0 && c < this.size) {\n      tile.row = r;\n      tile.col = c;\n      this.grid[r][c] = tile;\n    }\n  }\n\n  swap(r1, c1, r2, c2) {\n    const a = this.grid[r1][c1];\n    const b = this.grid[r2][c2];\n    this.grid[r1][c1] = b;\n    this.grid[r2][c2] = a;\n    if (a) { a.row = r2; a.col = c2; }\n    if (b) { b.row = r1; b.col = c1; }\n  }\n\n  removeTile(r, c) {\n    const tile = this.grid[r][c];\n    if (tile) tile.removing = true;\n    return tile;\n  }\n\n  clearCell(r, c) {\n    this.grid[r][c] = null;\n  }\n\n  isValid(r, c) {\n    return r >= 0 && r < this.size && c >= 0 && c < this.size;\n  }\n\n  isAdjacent(r1, c1, r2, c2) {\n    const dr = Math.abs(r1 - r2);\n    const dc = Math.abs(c1 - c2);\n    return (dr + dc) === 1;\n  }\n\n  // Find all horizontal and vertical matches of length >= 3\n  findAllMatches() {\n    const matches = [];\n\n    // Horizontal scan\n    for (let r = 0; r < this.size; r++) {\n      let start = 0;\n      for (let c = 1; c <= this.size; c++) {\n        const cur = c < this.size ? this.grid[r][c] : null;\n        const prev = this.grid[r][start];\n        if (c < this.size && cur && prev && cur.color === prev.color && cur.color !== EMPTY) {\n          continue;\n        }\n        const len = c - start;\n        if (len >= 3 && prev && prev.color !== EMPTY) {\n          const cells = [];\n          for (let k = start; k < c; k++) cells.push({ row: r, col: k });\n          matches.push({ cells, length: len, direction: 'horizontal', color: prev.color });\n        }\n        start = c;\n      }\n    }\n\n    // Vertical scan\n    for (let c = 0; c < this.size; c++) {\n      let start = 0;\n      for (let r = 1; r <= this.size; r++) {\n        const cur = r < this.size ? this.grid[r][c] : null;\n        const prev = this.grid[start][c];\n        if (r < this.size && cur && prev && cur.color === prev.color && cur.color !== EMPTY) {\n          continue;\n        }\n        const len = r - start;\n        if (len >= 3 && prev && prev.color !== EMPTY) {\n          const cells = [];\n          for (let k = start; k < r; k++) cells.push({ row: k, col: c });\n          matches.push({ cells, length: len, direction: 'vertical', color: prev.color });\n        }\n        start = r;\n      }\n    }\n\n    return matches;\n  }\n\n  // Detect L/T shape matches by finding intersections of horizontal and vertical matches\n  findLShapeMatches(matches) {\n    const lShapes = [];\n    for (let i = 0; i < matches.length; i++) {\n      for (let j = i + 1; j < matches.length; j++) {\n        const a = matches[i], b = matches[j];\n        if (a.direction === b.direction) continue;\n        if (a.color !== b.color) continue;\n        // Find intersection\n        const setA = new Set(a.cells.map(c => `${c.row},${c.col}`));\n        for (const cell of b.cells) {\n          if (setA.has(`${cell.row},${cell.col}`)) {\n            // L/T shape found — merge all cells\n            const allCellsMap = {};\n            for (const c of a.cells) allCellsMap[`${c.row},${c.col}`] = c;\n            for (const c of b.cells) allCellsMap[`${c.row},${c.col}`] = c;\n            const allCells = Object.values(allCellsMap);\n            lShapes.push({ cells: allCells, color: a.color });\n          }\n        }\n      }\n    }\n    return lShapes;\n  }\n\n  // Apply gravity: move tiles down to fill empty cells\n  applyGravity() {\n    const drops = [];\n    for (let c = 0; c < this.size; c++) {\n      let writeRow = this.size - 1;\n      for (let r = this.size - 1; r >= 0; r--) {\n        if (this.grid[r][c] !== null) {\n          if (r !== writeRow) {\n            const tile = this.grid[r][c];\n            const fromRow = r;\n            this.grid[r][c] = null;\n            this.grid[writeRow][c] = tile;\n            const distance = writeRow - fromRow;\n            tile.row = writeRow;\n            drops.push({ tile, fromRow, toRow: writeRow, col: c, distance });\n          }\n          writeRow--;\n        }\n      }\n      // Fill empty top cells\n      for (let r = writeRow; r >= 0; r--) {\n        const tile = this._createTile(r, c);\n        tile.offsetY = -(writeRow - r + 1); // start above board\n        this.grid[r][c] = tile;\n        drops.push({ tile, fromRow: -(writeRow - r + 1), toRow: r, col: c, distance: r + (writeRow - r + 1) });\n      }\n    }\n    return drops;\n  }\n\n  // Check if any valid move exists (for deadlock detection)\n  // obstacleMgr is optional — if provided, skip chained/blocked cells\n  hasValidMoves(obstacleMgr) {\n    for (let r = 0; r < this.size; r++) {\n      for (let c = 0; c < this.size; c++) {\n        if (!this.grid[r][c]) continue;\n        // Skip if tile is chained or cell is blocked\n        if (obstacleMgr) {\n          if (obstacleMgr.isCellBlocked(r, c)) continue;\n          if (!obstacleMgr.canSwap(r, c)) continue;\n        }\n        // Try swap right\n        if (c + 1 < this.size && this.grid[r][c + 1]) {\n          if (obstacleMgr && !obstacleMgr.canSwap(r, c + 1)) continue;\n          this.swap(r, c, r, c + 1);\n          const has = this.findAllMatches().length > 0;\n          this.swap(r, c, r, c + 1);\n          if (has) return true;\n        }\n        // Try swap down\n        if (r + 1 < this.size && this.grid[r + 1][c]) {\n          if (obstacleMgr && !obstacleMgr.canSwap(r + 1, c)) continue;\n          this.swap(r, c, r + 1, c);\n          const has = this.findAllMatches().length > 0;\n          this.swap(r, c, r + 1, c);\n          if (has) return true;\n        }\n      }\n    }\n    return false;\n  }\n\n  // Shuffle board if no valid moves\n  shuffle() {\n    const tiles = [];\n    for (let r = 0; r < this.size; r++) {\n      for (let c = 0; c < this.size; c++) {\n        tiles.push(this.grid[r][c].color);\n      }\n    }\n    // Fisher-Yates shuffle\n    for (let i = tiles.length - 1; i > 0; i--) {\n      const j = Math.floor(Math.random() * (i + 1));\n      [tiles[i], tiles[j]] = [tiles[j], tiles[i]];\n    }\n    let idx = 0;\n    for (let r = 0; r < this.size; r++) {\n      for (let c = 0; c < this.size; c++) {\n        this.grid[r][c].color = tiles[idx++];\n      }\n    }\n    // Remove any initial matches from shuffle\n    this._removeInitialMatches();\n    // If still no valid moves, re-init\n    if (!this.hasValidMoves()) {\n      this.init();\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Board, Tile, BOARD_SIZE, TILE_COLORS, SPECIAL_NONE, SPECIAL_STRIPED_H, SPECIAL_STRIPED_V, SPECIAL_BOMB, SPECIAL_RAINBOW, COLOR_MAP };\n","structuredPatch":[{"oldStart":261,"oldLines":7,"newStart":261,"newLines":9,"lines":["     const tiles = [];","     for (let r = 0; r < this.size; r++) {","       for (let c = 0; c < this.size; c++) {","-        tiles.push(this.grid[r][c].color);","+        if (this.grid[r][c]) {","+          tiles.push(this.grid[r][c].color);","+        }","       }","     }","     // Fisher-Yates shuffle"]},{"oldStart":272,"oldLines":7,"newStart":274,"newLines":9,"lines":["     let idx = 0;","     for (let r = 0; r < this.size; r++) {","       for (let c = 0; c < this.size; c++) {","-        this.grid[r][c].color = tiles[idx++];","+        if (this.grid[r][c]) {","+          this.grid[r][c].color = tiles[idx++] || this._randomColor();","+        }","       }","     }","     // Remove any initial matches from shuffle"]}],"userModified":false,"replaceAll":false}}
