.2})`;","+    ctx.fillRect(0, 0, w, h);","+","+    // Radiating lines","+    const centerX = w / 2;","+    const centerY = h / 2;","+    const lineCount = 12;","+    for (let i = 0; i < lineCount; i++) {","+      const angle = (i / lineCount) * Math.PI * 2 + progress * Math.PI;","+      const len = 200 + Math.sin(progress * Math.PI * 6 + i) * 100;","+      ctx.strokeStyle = `rgba(255, 215, 0, ${alpha * 0.3})`;","+      ctx.lineWidth = 2;","+      ctx.beginPath();","+      ctx.moveTo(centerX, centerY);","+      ctx.lineTo(centerX + Math.cos(angle) * len, centerY + Math.sin(angle) * len);","+      ctx.stroke();","+    }","+","+    ctx.fillStyle = `rgba(255, 215, 0, ${alpha})`;","+    ctx.font = `bold ${28 + Math.sin(progress * Math.PI * 3) * 6}px serif`;","+    ctx.textAlign = 'center';","+    ctx.textBaseline = 'middle';","+    ctx.fillText('🌟 飞升成功 🌟', w / 2, h / 2 - 30);","+","+    ctx.font = '18px serif';","+    ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;","+    ctx.fillText('飞升仙尊 — 全局效率×10', w / 2, h / 2 + 15);","+","+    ctx.font = '14px serif';","+    ctx.fillStyle = `rgba(200, 200, 255, ${alpha})`;","+    ctx.fillText('恭喜完成飞升挑战！', w / 2, h / 2 + 50);","+","+    if (progress >= 1) {","+      this.ascensionAnim.active = false;","+    }","+  }","+","   placeCurrentBuilding(): boolean {","     if (!this.placementMode) return false;"," "]},{"oldStart":440,"oldLines":7,"newStart":543,"newLines":7,"lines":[" ","     this.state = deductCost(this.state, def.cost);"," ","-    // Handle conveyor/puppet/talisman placement","+    // Handle conveyor/puppet placement","     if (def.category === 'transport' && (def.id === 'conveyor_lv1' || def.id === 'conveyor_lv2')) {","       const seg = createSegment(","         `seg_${Date.now()}_${Math.random().toString(36).slice(2)}`,"]},{"oldStart":477,"oldLines":7,"newStart":580,"newLines":6,"lines":["     return true;","   }"," ","-  // Handle click on a building","   private handleBuildingClick(building: BuildingInstance): void 