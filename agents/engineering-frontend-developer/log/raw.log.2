{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ed5e883a89b444f69419235f","type":"tool_result","content":"1\t// Puppet.ts — 傀儡分拣系统：自动分类灵草到丹炉，按类型路由资源\n2\t\n3\texport interface PuppetInstance {\n4\t  uid: string;\n5\t  gridX: number;\n6\t  gridY: number;\n7\t  level: number;\n8\t  /** 分拣规则：资源类型 → 目标方向 */\n9\t  rules: PuppetRule[];\n10\t  /** 当前持有的物品 */\n11\t  heldItem: HeldItem | null;\n12\t  /** 工作状态 */\n13\t  state: 'idle' | 'picking' | 'delivering';\n14\t  /** 动作进度 0-1 */\n15\t  actionProgress: number;\n16\t  /** 动作速度 ms */\n17\t  actionSpeed: number;\n18\t}\n19\t\n20\texport interface PuppetRule {\n21\t  resourceType: string;\n22\t  targetDx: number;\n23\t  targetDy: number;\n24\t  /** 优先级 */\n25\t  priority: number;\n26\t}\n27\t\n28\texport interface HeldItem {\n29\t  resource: string;\n30\t  amount: number;\n31\t}\n32\t\n33\t// Default routing rules: map resource types to directions\n34\tconst DEFAULT_RULES: PuppetRule[] = [\n35\t  { resourceType: 'spirit_grass', targetDx: 0, targetDy: -1, priority: 1 },\n36\t  { resourceType: 'spirit_stone', targetDx: 1, targetDy: 0, priority: 2 },\n37\t  { resourceType: 'pill_juling', targetDx: 0, targetDy: 1, priority: 3 },\n38\t  { resourceType: 'pill_peiyuan', targetDx: -1, targetDy: 0, priority: 4 },\n39\t  { resourceType: 'spirit_iron', targetDx: -1, targetDy: 0, priority: 5 },\n40\t];\n41\t\n42\texport function createPuppet(\n43\t  uid: string,\n44\t  gridX: number,\n45\t  gridY: number,\n46\t  level: number = 1,\n47\t): PuppetInstance {\n48\t  return {\n49\t    uid,\n50\t    gridX,\n51\t    gridY,\n52\t    level,\n53\t    rules: [...DEFAULT_RULES],\n54\t    heldItem: null,\n55\t    state: 'idle',\n56\t    actionProgress: 0,\n57\t    actionSpeed: 3000, // 3 seconds per action\n58\t  };\n59\t}\n60\t\n61\t// Get sorting rule for a resource type\n62\texport function getRuleForResource(puppet: PuppetInstance, resourceType: string): PuppetRule | undefined {\n63\t  return puppet.rules\n64\t    .filter(r => r.resourceType === resourceType)\n65\t    .sort((a, b) => a.priority - b.priority)[0];\n66\t}\n67\t\n68\t// Add or update a routing rule\n69\texport function setRule(\n70\t  puppet: PuppetInstance,\n71\t  resourceType: string,\n72\t  targetDx: number,\n73\t  targetDy: number,\n74\t  priority: number = 0,\n75\t): PuppetInstance {\n76\t  const existing = puppet.rules.findIndex(r => r.resourceType === resourceType);\n77\t  const newRule: PuppetRule = { resourceType, targetDx, targetDy, priority };\n78\t\n79\t  const newRules = [...puppet.rules];\n80\t  if (existing >= 0) {\n81\t    newRules[existing] = newRule;\n82\t  } else {\n83\t    newRules.push(newRule);\n84\t  }\n85\t\n86\t  return { ...puppet, rules: newRules };\n87\t}\n88\t\n89\t// Puppet picks up an item from an adjacent source\n90\texport function puppetPickup(\n91\t  puppet: PuppetInstance,\n92\t  resource: string,\n93\t  amount: number,\n94\t): PuppetInstance {\n95\t  return {\n96\t    ...puppet,\n97\t    heldItem: { resource, amount },\n98\t    state: 'delivering',\n99\t    actionProgress: 0,\n100\t  };\n101\t}\n102\t\n103\t// Puppet delivers held item — returns the delivery info and cleared puppet\n104\texport function puppetDeliver(puppet: PuppetInstance): {\n105\t  puppet: PuppetInstance;\n106\t  delivery: { resource: string; amount: number; targetDx: number; targetDy: number } | null;\n107\t} {\n108\t  if (!puppet.heldItem) {\n109\t    return { puppet: { ...puppet, state: 'idle' }, delivery: null };\n110\t  }\n111\t\n112\t  const rule = getRuleForResource(puppet, puppet.heldItem.resource);\n113\t  const delivery = rule\n114\t    ? {\n115\t        resource: puppet.heldItem.resource,\n116\t        amount: puppet.heldItem.amount,\n117\t        targetDx: rule.targetDx,\n118\t        targetDy: rule.targetDy,\n119\t      }\n120\t    : null;\n121\t\n122\t  return {\n123\t    puppet: {\n124\t      ...puppet,\n125\t      heldItem: null,\n126\t      state: 'idle',\n127\t      actionProgress: 0,\n128\t    },\n129\t    delivery,\n130\t  };\n131\t}\n132\t\n133\t// Tick puppet progress\n134\texport function tickPuppet(\n135\t  puppet: PuppetInstance,\n136\t  dtMs: number,\n137\t): PuppetInstance {\n138\t  if (puppet.state === 'idle') return puppet;\n139\t\n140\t  const progress = puppet.actionProgress + dtMs / puppet.actionSpeed;\n141\t  if (progress >= 1) {\n142\t    // Action complete\n143\t    return { ...puppet, actionProgress: 1 };\n144\t  }\n145\t  return { ...puppet, actionProgress: progress };\n146\t}\n147\t\n148\t// Render a puppet on canvas\n149\texport function renderPuppet(\n150\t  ctx: CanvasRenderingContext2D,\n151\t  puppet: PuppetInstance,\n152\t  offsetX: number,\n153\t  offsetY: number,\n154\t  scale: number,\n155\t  cellSize: number,\n156\t  now: number,\n157\t): void {\n158\t  const x = offsetX + puppet.gridX * cellSize * scale;\n159\t  const y = offsetY + puppet.gridY * cellSize * scale;\n160\t  const s = cellSize * scale;\n161\t\n162\t  // Puppet body\n163\t  const bodyColor = puppet.state === 'idle' ? 'rgba(200,180,100,0.7)' : 'rgba(255,200,50,0.8)';\n164\t  ctx.fillStyle = bodyColor;\n165\t  ctx.beginPath();\n166\t  ctx.arc(x + s / 2, y + s / 2, s * 0.35, 0, Math.PI * 2);\n167\t  ctx.fill();\n168\t\n169\t  // Face icon\n170\t  ctx.fillStyle = '#fff';\n171\t  ctx.font = `${Math.max(10, Math.floor(14 * scale))}px serif`;\n172\t  ctx.textAlign = 'center';\n173\t  ctx.textBaseline = 'middle';\n174\t  ctx.fillText('🤖', x + s / 2, y + s / 2);\n175\t\n176\t  // Level badge\n177\t  ctx.font = `bold ${Math.max(6, Math.floor(8 * scale))}px monospace`;\n178\t  ctx.fillStyle = '#ffd700';\n179\t  ctx.fillText(`Lv${puppet.level}`, x + s / 2, y + s - 4 * scale);\n180\t\n181\t  // Action progress ring\n182\t  if (puppet.state !== 'idle') {\n183\t    ctx.strokeStyle = '#ffd700';\n184\t    ctx.lineWidth = 2;\n185\t    ctx.beginPath();\n186\t    ctx.arc(x + s / 2, y + s / 2, s * 0.4, -Math.PI / 2, -Math.PI / 2 + puppet.actionProgress * Math.PI * 2);\n187\t    ctx.stroke();\n188\t  }\n189\t\n190\t  // Held item indicator\n191\t  if (puppet.heldItem) {\n192\t    const RESOURCE_COLORS: Record<string, string> = {\n193\t      spirit_stone: '#7cc8ff',\n194\t      spirit_grass: '#6adf6a',\n195\t      spirit_iron: '#8a8aaa',\n196\t    };\n197\t    ctx.fillStyle = RESOURCE_COLORS[puppet.heldItem.resource] ?? '#fff';\n198\t    ctx.beginPath();\n199\t    ctx.arc(x + s - 4 * scale, y + 4 * scale, 3 * scale, 0, Math.PI * 2);\n200\t    ctx.fill();\n201\t  }\n202\t}\n203\t"}]},"parent_tool_use_id":null,"session_id":"094f9230-fe12-4466-ab83-fdd0d233a191","uuid":"3e2c65a7-8c57-455e-89d1-bf810bf7b0ff","timestamp":"2026-05-23T02:55:11.651Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/steam-cultivation-factory/src/game/Puppet.ts","content":"// Puppet.ts — 傀儡分拣系统：自动分类灵草到丹炉，按类型路由资源\n\nexport interface PuppetInstance {\n  uid: string;\n  gridX: number;\n  gridY: number;\n  level: number;\n  /** 分拣规则：资源类型 → 目标方向 */\n  rules: PuppetRule[];\n  /** 当前持有的物品 */\n  heldItem: HeldItem | null;\n  /** 工作状态 */\n  state: 'idle' | 'picking' | 'delivering';\n  /** 动作进度 0-1 */\n  actionProgress: number;\n  /** 动作速度 ms */\n  actionSpeed: number;\n}\n\nexport interface PuppetRule {\n  resourceType: string;\n  targetDx: number;\n  targetDy: number;\n  /** 优先级 */\n  priority: number;\n}\n\nexport interface HeldItem {\n  resource: string;\n  amount: number;\n}\n\n// Default routing rules: map resource types to directions\nconst DEFAULT_RULES: PuppetRule[] = [\n  { resourceType: 'spirit_grass', targetDx: 0, targetDy: -1, priority: 1 },\n  { resourceType: 'spirit_stone', targetDx: 1, targetDy: 0, priority: 2 },\n  { resourceType: 'pill_juling', targetDx: 0, targetDy: 1, priority: 3 },\n  { resourceType: 'pill_peiyuan', targetDx: -1, targetDy: 0, priority: 4 },\n  { resourceType: 'spirit_iron', targetDx: -1, targetDy: 0, priority: 5 },\n];\n\nexport function createPuppet(\n  uid: string,\n  gridX: number,\n  gridY: number,\n  level: number = 1,\n): PuppetInstance {\n  return {\n    uid,\n    gridX,\n    gridY,\n    level,\n    rules: [...DEFAULT_RULES],\n    heldItem: null,\n    state: 'idle',\n    actionProgress: 0,\n    actionSpeed: 3000, // 3 seconds per action\n  };\n}\n\n// Get sorting rule for a resource type\nexport function getRuleForResource(puppet: PuppetInstance, resourceType: string): PuppetRule | undefined {\n  return puppet.rules\n    .filter(r => r.resourceType === resourceType)\n    .sort((a, b) => a.priority - b.priority)[0];\n}\n\n// Add or update a routing rule\nexport function setRule(\n  puppet: PuppetInstance,\n  resourceType: string,\n  targetDx: number,\n  targetDy: number,\n  priority: number = 0,\n): PuppetInstance {\n  const existing = puppet.rules.findIndex(r => r.resourceType === resourceType);\n  const newRule: PuppetRule = { resourceType, targetDx, targetDy, priority };\n\n  const newRules = [...puppet.rules];\n  if (existing >= 0) {\n    newRules[existing] = newRule;\n  } else {\n    newRules.push(newRule);\n  }\n\n  return { ...puppet, rules: newRules };\n}\n\n// Puppet picks up an item from an adjacent source\nexport function puppetPickup(\n  puppet: PuppetInstance,\n  resource: string,\n  amount: number,\n): PuppetInstance {\n  return {\n    ...puppet,\n    heldItem: { resource, amount },\n    state: 'delivering',\n    actionProgress: 0,\n  };\n}\n\n// Puppet delivers held item — returns the delivery info and cleared puppet\nexport function puppetDeliver(puppet: PuppetInstance): {\n  puppet: PuppetInstance;\n  delivery: { resource: string; amount: number; targetDx: number; targetDy: number } | null;\n} {\n  if (!puppet.heldItem) {\n    return { puppet: { ...puppet, state: 'idle' }, delivery: null };\n  }\n\n  const rule = getRuleForResource(puppet, puppet.heldItem.resource);\n  const delivery = rule\n    ? {\n        resource: puppet.heldItem.resource,\n        amount: puppet.heldItem.amount,\n        targetDx: rule.targetDx,\n        targetDy: rule.targetDy,\n      }\n    : null;\n\n  return {\n    puppet: {\n      ...puppet,\n      heldItem: null,\n      state: 'idle',\n      actionProgress: 0,\n    },\n    delivery,\n  };\n}\n\n// Tick puppet progress\nexport function tickPuppet(\n  puppet: PuppetInstance,\n  dtMs: number,\n): PuppetInstance {\n  if (puppet.state === 'idle') return puppet;\n\n  const progress = puppet.actionProgress + dtMs / puppet.actionSpeed;\n  if (progress >= 1) {\n    // Action complete\n    return { ...puppet, actionProgress: 1 };\n  }\n  return { ...puppet, actionProgress: progress };\n}\n\n// Render a puppet on canvas\nexport function renderPuppet(\n  ctx: CanvasRenderingContext2D,\n  puppet: PuppetInstance,\n  offsetX: number,\n  offsetY: number,\n  scale: number,\n  cellSize: number,\n  now: number,\n): void {\n  const x = offsetX + puppet.gridX * cellSize * scale;\n  const y = offsetY + puppet.gridY * cellSize * scale;\n  const s = cellSize * scale;\n\n  // Puppet body\n  const bodyColor = puppet.state === 'idle' ? 'rgba(200,180,100,0.7)' : 'rgba(255,200,50,0.8)';\n  ctx.fillStyle = bodyColor;\n  ctx.beginPath();\n  ctx.arc(x + s / 2, y + s / 2, s * 0.35, 0, Math.PI * 2);\n  ctx.fill();\n\n  // Face icon\n  ctx.fillStyle = '#fff';\n  ctx.font = `${Math.max(10, Math.floor(14 * scale))}px serif`;\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n  ctx.fillText('🤖', x + s / 2, y + s / 2);\n\n  // Level badge\n  ctx.font = `bold ${Math.max(6, Math.floor(8 * scale))}px monospace`;\n  ctx.fillStyle = '#ffd700';\n  ctx.fillText(`Lv${puppet.level}`, x + s / 2, y + s - 4 * scale);\n\n  // Action progress ring\n  if (puppet.state !== 'idle') {\n    ctx.strokeStyle = '#ffd700';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.arc(x + s / 2, y + s / 2, s * 0.4, -Math.PI / 2, -Math.PI / 2 + puppet.actionProgress * Math.PI * 2);\n    ctx.stroke();\n  }\n\n  // Held item indicator\n  if (puppet.heldItem) {\n    const RESOURCE_COLORS: Record<string, string> = {\n      spirit_stone: '#7cc8ff',\n      spirit_grass: '#6adf6a',\n      spirit_iron: '#8a8aaa',\n    };\n    ctx.fillStyle = RESOURCE_COLORS[puppet.heldItem.resource] ?? '#fff';\n    ctx.beginPath();\n    ctx.arc(x + s - 4 * scale, y + 4 * scale, 3 * scale, 0, Math.PI * 2);\n    ctx.fill();\n  }\n}\n","numLines":203,"startLine":1,"totalLines":203}}}
