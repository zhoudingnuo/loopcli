 => r.resourceType === resourceType)\n65\t    .sort((a, b) => a.priority - b.priority)[0];\n66\t}\n67\t\n68\t// Add or update a routing rule\n69\texport function setRule(\n70\t  puppet: PuppetInstance,\n71\t  resourceType: string,\n72\t  targetDx: number,\n73\t  targetDy: number,\n74\t  priority: number = 0,\n75\t): PuppetInstance {\n76\t  const existing = puppet.rules.findIndex(r => r.resourceType === resourceType);\n77\t  const newRule: PuppetRule = { resourceType, targetDx, targetDy, priority };\n78\t\n79\t  const newRules = [...puppet.rules];\n80\t  if (existing >= 0) {\n81\t    newRules[existing] = newRule;\n82\t  } else {\n83\t    newRules.push(newRule);\n84\t  }\n85\t\n86\t  return { ...puppet, rules: newRules };\n87\t}\n88\t\n89\t// Puppet picks up an item from an adjacent source\n90\texport function puppetPickup(\n91\t  puppet: PuppetInstance,\n92\t  resource: string,\n93\t  amount: number,\n94\t): PuppetInstance {\n95\t  return {\n96\t    ...puppet,\n97\t    heldItem: { resource, amount },\n98\t    state: 'delivering',\n99\t    actionProgress: 0,\n100\t  };\n101\t}\n102\t\n103\t// Puppet delivers held item — returns the delivery info and cleared puppet\n104\texport function puppetDeliver(puppet: PuppetInstance): {\n105\t  puppet: PuppetInstance;\n106\t  delivery: { resource: string; amount: number; targetDx: number; targetDy: number } | null;\n107\t} {\n108\t  if (!puppet.heldItem) {\n109\t    return { puppet: { ...puppet, state: 'idle' }, delivery: null };\n110\t  }\n111\t\n112\t  const rule = getRuleForResource(puppet, puppet.heldItem.resource);\n113\t  const delivery = rule\n114\t    ? {\n115\t        resource: puppet.heldItem.resource,\n116\t        amount: puppet.heldItem.amount,\n117\t        targetDx: rule.targetDx,\n118\t        targetDy: rule.targetDy,\n119\t      }\n120\t    : null;\n121\t\n122\t  return {\n123\t    puppet: {\n124\t      ...puppet,\n125\t      heldItem: null,\n126\t      state: 'idle',\n127\t      actionProgress: 0,\n128\t    },\n129\t    delivery,\n130\t  };\n131\t}\n132\t\n133\t// Tick puppet progress\n134\texport function tickPuppet(\n135\t  puppet: PuppetInstance,\n136\t  dtMs: number,\n137\t): PuppetInstance {\n138\t  if (puppet.state === 'idle') return puppet;\n139\t\n140\t  const progress = puppet.actionProgress + dtMs / puppet.actionSpeed;\n141\t  if (progress >= 1) {\n142\t    // Action complete\n143\t    return { ...puppet, actionProgress: 1 };\n144\t  }\n145\t  return { ...puppet, actionProgress: progress };\n146\t}\n147\t\n148\t// Render a puppet on canvas\n149\texport function renderPuppet(\n150\t  ctx: CanvasRenderingContext2D,\n151\t  puppet: PuppetInstance,\n152\t  offsetX: number,\n153\t  offsetY: number,\n154\t  scale: number,\n155\t  cellSize: number,\n156\t  now: number,\n157\t): void {\n158\t  const x = offsetX + puppet.gridX * cellSize * scale;\n159\t  const y = offsetY + puppet.gridY * cellSize * scale;\n160\t  const s = cellSize * scale;\n161\t\n162\t  // Puppet body\n163\t  const bodyColor = puppet.state === 'idle' ? 'rgba(200,180,100,0.7)' : 'rgba(255,200,50,0.8)';\n164\t  ctx.fillStyle = bodyColor;\n165\t  ctx.beginPath();\n166\t  ctx.arc(x + s / 2, y + s / 2, s * 0.35, 0, Math.PI * 2);\n167\t  ctx.fill();\n168\t\n169\t  // Face icon\n170\t  ctx.fillStyle = '#fff';\n171\t  ctx.font = `${Math.max(10, Math.floor(14 * scale))}px serif`;\n172\t  ctx.textAlign = 'center';\n173\t  ctx.textBaseline = 'middle';\n174\t  ctx.fillText('🤖', x + s / 2, y + s / 2);\n175\t\n176\t  // Level badge\n177\t  ctx.font = `bold ${Math.max(6, Math.floor(8 * scale))}px monospace`;\n178\t  ctx.fillStyle = '#ffd700';\n179\t  ctx.fillText(`Lv${puppet.level}`, x + s / 2, y + s - 4 * scale);\n180\t\n181\t  // Action progress ring\n182\t  if (puppet.state !== 'idle') {\n183\t    ctx.strokeStyle = '#ffd700';\n184\t    ctx.lineWidth = 2;\n185\t    ctx.beginPath();\n186\t    ctx.arc(x + s / 2, y + s / 2, s * 0.4, -Math.PI / 2, -Math.PI / 2 + puppet.actionProgress * Math.PI * 2);\n187\t    ctx.stro