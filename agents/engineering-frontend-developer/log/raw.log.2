) this.setTerrain(x, y, Terrain.Ruins);","       }","     }","-","-    const veinPositions = [","-      [2, 2], [22, 18],","-    ];","-    for (const [x, y] of veinPositions) {","+    // Spirit veins (ancient formations)","+    for (const [x, y] of [[10, 10], [11, 10], [10, 11], [40, 15], [41, 15], [41, 16], [25, 25], [26, 25], [26, 26], [15, 35], [16, 35], [16, 36], [35, 30], [36, 30], [36, 31]])","       this.setTerrain(x, y, Terrain.SpiritVein);","-    }","+    // Ruined structures","+    for (let x = 20; x < 30; x++) this.setTerrain(x, 20, Terrain.Ruins);","+    for (let y = 15; y < 25; y++) this.setTerrain(25, y, Terrain.Ruins);","+    // Paths","+    for (let x = 5; x < 45; x++) this.setTerrain(x, 20, Terrain.Path);","+    for (let y = 5; y < 37; y++) this.setTerrain(25, y, Terrain.Path);","+  }"," ","-    for (let x = 3; x < 22; x++) {","-      this.setTerrain(x, 10, Terrain.Path);","+  private generateStarCliff(): void {","+    // Ethereal void terrain with merit shrines","+    for (let y = 3; y < 37; y++) {","+      for (let x = 3; x < 47; x++) {","+        if (Math.random() < 0.2) this.setTerrain(x, y, Terrain.Void);","+      }","     }","+    // Spirit veins (star points)","+    for (const [x, y] of [[10, 8], [11, 8], [10, 9], [40, 8], [41, 8], [41, 9], [25, 20], [26, 20], [26, 21], [10, 32], [11, 32], [11, 33], [40, 32], [41, 32], [41, 33]])","+      this.setTerrain(x, y, Terrain.SpiritVein);","+    // Floating platforms","+    for (let y = 12; y < 16; y++) for (let x = 15; x < 25; x++) this.setTerrain(x, y, Terrain.Grass);","+    for (let y = 24; y < 28; y++) for (let x = 28; x < 38; x++) this.setTerrain(x, y, Terrain.Grass);","+    // Paths","+    for (let x = 8; x < 42; x++) this.setTerrain(x, 20, Terrain.Path);","+    for (let y = 8; y < 35; y++) this.setTerrain(25, y, Terrain.Path);","   }"," ","-  private generateMineArea(): void {","-    // 灵石矿区：大量矿脉","-    const veinPositions = [","-      [3, 3], [4, 3], [3, 4],","-      [15, 8], [16, 8], [16, 9],","-      [25, 15], [26, 15], [26, 16],","-    ];","-    for (const [x, y] of veinPositions) {","-      this.setTerrain(x, y, Terrain.SpiritVein);","+  private generateSkyPeak(): void {","+    // Ultimate celestial region with all terrain types","+    // Central platform","+    for (let y = 15; y < 35; y++) for (let x = 15; x < 45; x++) this.setTerrain(x, y, Terrain.Celestial);","+    // Outer celestial ring","+    for (let y = 5; y < 45; y++) {","+      for (let x = 5; x < 55; x++) {","+        const dx = x - 30;","+        const dy = y - 25;","+        const dist = Math.sqrt(dx * dx + dy * dy);","+        if (dist > 18 && dist < 25 && Math.random() < 0.3) this.setTerrain(x, y, Terrain.Void);","+      }","     }","-","-    for (let x = 5; x < 25; x++) {","-      this.setTerrain(x, 10, Terrain.Path);","-    }","+    // Rich resource deposits","+    for (const [x, y] of [[10, 10], [11, 10], [10, 11], [50, 10], [51, 10], [51, 11], [10, 40], [11, 40], [11, 41], [50, 40], [51, 40], [51, 41],","+      [25, 20], [26, 20], [26, 21], [35, 30], [36, 30], [36, 31], [20, 35], [21, 35], [21, 36], [40, 15], [41, 15], [41, 16]])","+      this.setTerrain(x, y, Terrain.SpiritVein);","+    // Various terrain patches","+    for (let y = 8; y < 12; y++) for (let x = 20; x < 28; x++) this.setTerrain(x, y, Terrain.RichSoil);","+    for (let y = 38; y < 42; y++) for (let x = 35; x < 43; x++) this.setTerrain(x, y, Terrain.Forest);","+    for (let y = 20; y < 24; y++) for (let x = 8; x < 14; x++) this.setTerrain(x, y, Terrain.Crystal);","+    for (let y = 30; y < 34; y++) for (let x = 48; x < 54; x++) this.setTerrain(x, y, Terrain.Ruins);","+    // Water features","+    for (const [x, y] of [[30, 12], [31, 12], [30, 13], [29, 13], [30, 38], [31, 38], [30, 39], [29, 39]])","+      this.setTerrain(x, y, Terrain.Water);","+    // Main paths (cross pattern)","+    for (let x = 10; x < 50; x++) this.setTerrain(x, 25, Terrain.Path);","+    for (let y = 10; y < 42; y++) this.setTerrain(30, y, Terrain.Path);","   }"," ","-  // Render map terrain to canvas","   render(","     ctx: CanvasRenderingContext2D,","     offsetX: number,"]},{"oldStart":309,"oldLines":7,"newStart":291,"newLines":6,"lines":["     const endCol = Math.min(this.width, Math.ceil((-offsetX + viewportW) * invScale / this.cellSize) + 1);","     const endRow = Math.min(this.height, Math.ceil((-offsetY + viewportH) * invScale / this.cellSize) + 1);"," ","-    // Draw terrain cells","     for (let row = startRow; row < endRow; row++) {","       for (let col = startCol; col < endCol; col++) {","         const x = offsetX + col * this.cellSize * scale;"]},{"oldStart":319,"oldLines":7,"newStart":300,"newLines":6,"lines":["         ctx.fillStyle = this.getTerrainColor(this.getTerrain(col, row));","         ctx.fillRect(x, y, size, size);"," ","-        // Draw grid line","         ctx.strokeStyle = this.gridColor;","         ctx.lineWidth = 0.5;","         ctx.strokeRect(x, y, size, size);"]},{"oldStart":336,"oldLines":11,"newStart":316,"newLines":15,"lines":["       case Terrain.Mountain: return '#4a4a4a';","       case Terrain.Path: return '#4a3a2a';","       case Terrain.SpiritVein: return '#2a4a5a';","+      case Terrain.Forest: return '#1a3a1a';","+      case Terrain.Crystal: return '#3a2a5a';","+      case Terrain.Ruins: return '#3a2a2a';","+      case Terrain.Void: return '#0a0a2a';","+      case Terrain.Celestial: return '#2a2a4a';","       default: return this.bgColor;","     }","   }"," ","-  // Screen coordinates to grid cell","   screenToGrid(","     screenX: number,","     screenY: number,"]},{"oldStart":354,"oldLines":7,"newStart":338,"newLines":6,"lines":["     return { gx, gy };","   }"," ","-  // Grid cell center to screen coordinates","   gridToScreen(","     gx: number,","     gy: number,"]}],"originalFile":"// Map.ts — Grid-based map system with terrain and area rendering\n\nexport enum Terrain {\n  Grass = 0,\n  Rock = 1,\n  Water = 2,\n  RichSoil = 3,\n  Mountain = 4,\n  Path = 5,\n  SpiritVein = 6,\n}\n\nexport interface MapConfig {\n  width: number;\n  height: number;\n  bgColor: string;\n  gridColor: string;\n  cellSize: number;\n}\n\nexport const DEFAULT_CELL_SIZE = 32;\n\nexport class GameMap {\n  width: number;\n  height: number;\n  cellSize: number;\n  terrain: Terrain[];\n  bgColor: string;\n  gridColor: string;\n\n  constructor(\n    width: number,\n    height: number,\n    bgColor: string = '#2a3a1a',\n    gridColor: string = '#3a4a2a',\n    cellSize: number = DEFAULT_CELL_SIZE,\n  ) {\n    this.width = width;\n    this.height = height;\n    this.cellSize = cellSize;\n    this.bgColor = bgColor;\n    this.gridColor = gridColor;\n    this.terrain = new Array(width * height).fill(Terrain.Grass);\n  }\n\n  get indexSize(): number {\n    return this.width * this.height;\n  }\n\n  inBounds(gx: number, gy: number): boolean {\n    return gx >= 0 && gx < this.width && gy >= 0 && gy < this.height;\n  }\n\n  getTerrain(gx: number, gy: number): Terrain {\n    if (!this.inBounds(gx, gy)) return Terrain.Mountain;\n    return this.terrain[gy * this.width + gx];\n  }\n\n  setTerrain(gx: number, gy: number, t: Terrain): void {\n    if (!this.inBounds(gx, gy)) return;\n    this.terrain[gy * this.width + gx] = t;\n  }\n\n  // Check if a rect of cells is free for placement\n  isAreaFree(gx: number, gy: number, w: number, h: number, occupied: Set<string>): boolean {\n    for (let dy = 0; dy < h; dy++) {\n      for (let dx = 0; dx < w; dx++) {\n        const cx = gx + dx;\n        const cy = gy + dy;\n        if (!this.inBounds(cx, cy)) return false;\n        const t = this.getTerrain(cx, cy);\n        if (t === Terrain.Water || t === Terrain.Mountain) return false;\n        const key = `${cx},${cy}`;\n        if (occupied.has(key)) return false;\n      }\n    }\n    return true;\n  }\n\n  // Generate terrain for the starting area (炼气坪)\n  generateStartingArea(): void {\n    // Add some spirit veins (矿脉)\n    const veinPositions = [\n      [3, 2], [4, 2], [3, 3],\n      [14, 10], [15, 10], [15, 11],\n      [8, 7], [8, 8],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    // Add some water features\n    const waterPositions = [\n      [10, 1], [11, 1], [10, 2],\n      [1, 12], [2, 12], [1, 11],\n    ];\n    for (const [x, y] of waterPositions) {\n      this.setTerrain(x, y, Terrain.Water);\n    }\n\n    // Add path\n    for (let x = 5; x < 15; x++) {\n      this.setTerrain(x, 7, Terrain.Path);\n    }\n    for (let y = 3; y < 12; y++) {\n      this.setTerrain(10, y, Terrain.Path);\n    }\n\n    // Rich soil near center\n    for (let y = 5; y < 8; y++) {\n      for (let x = 6; x < 9; x++) {\n        this.setTerrain(x, y, Terrain.RichSoil);\n      }\n    }\n  }\n\n  // Generate terrain for a specific region type\n  generateRegionTerrain(regionId: string): void {\n    switch (regionId) {\n      case 'zhuji_platform':\n        this.generateZhujiPlatform();\n        break;\n      case 'medicine_valley':\n        this.generateMedicineValley();\n        break;\n      case 'core_peak':\n        this.generateCorePeak();\n        break;\n      case 'ore_mountain':\n        this.generateOreMountain();\n        break;\n      case 'spirit_field_area':\n        this.generateSpiritFieldArea();\n        break;\n      case 'mine_area':\n        this.generateMineArea();\n        break;\n      default:\n        this.generateStartingArea();\n    }\n  }\n\n  private generateZhujiPlatform(): void {\n    // 筑基台：灵铁+灵木丰富，中等大小\n    const veinPositions = [\n      [5, 3], [6, 3], [5, 4],\n      [20, 15], [21, 15], [21, 16],\n      [12, 10], [13, 10],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    // Rich soil patches\n    for (let y = 6; y < 12; y++) {\n      for (let x = 8; x < 14; x++) {\n        this.setTerrain(x, y, Terrain.RichSoil);\n      }\n    }\n\n    // Paths\n    for (let x = 4; x < 26; x++) {\n      this.setTerrain(x, 12, Terrain.Path);\n    }\n    for (let y = 4; y < 22; y++) {\n      this.setTerrain(15, y, Terrain.Path);\n    }\n\n    // Water features\n    this.setTerrain(2, 2, Terrain.Water);\n    this.setTerrain(3, 2, Terrain.Water);\n    this.setTerrain(2, 3, Terrain.Water);\n  }\n\n  private generateMedicineValley(): void {\n    // 药王谷：大量灵田，稀有灵草\n    for (let y = 3; y < 22; y++) {\n      for (let x = 3; x < 32; x++) {\n        if (Math.random() < 0.6) {\n          this.setTerrain(x, y, Terrain.RichSoil);\n        }\n      }\n    }\n\n    // Spirit veins at edges\n    const veinPositions = [\n      [1, 1], [33, 1], [1, 23], [33, 23],\n      [17, 12],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    // Central path\n    for (let x = 5; x < 30; x++) {\n      this.setTerrain(x, 12, Terrain.Path);\n    }\n  }\n\n  private generateCorePeak(): void {\n    // 丹鼎峰：炼丹圣地，岩石地形多\n    const veinPositions = [\n      [5, 5], [6, 5], [5, 6],\n      [28, 22], [29, 22], [29, 23],\n      [17, 14], [18, 14],\n      [10, 20], [24, 8],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    // Rocky terrain\n    for (let y = 2; y < 28; y += 4) {\n      for (let x = 2; x < 33; x += 5) {\n        if (Math.random() < 0.3) {\n          this.setTerrain(x, y, Terrain.Rock);\n        }\n      }\n    }\n\n    // Paths\n    for (let x = 3; x < 32; x++) {\n      this.setTerrain(x, 15, Terrain.Path);\n    }\n    for (let y = 3; y < 28; y++) {\n      this.setTerrain(17, y, Terrain.Path);\n    }\n  }\n\n  private generateOreMountain(): void {\n    // 矿脉山：大量矿脉，灵石/灵铁高产\n    const veinPositions = [\n      [4, 4], [5, 4], [4, 5],\n      [20, 5], [21, 5], [21, 6],\n      [35, 15], [36, 15], [36, 16],\n      [10, 20], [11, 20], [11, 21],\n      [28, 25], [29, 25], [29, 26],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    // Mountain terrain\n    for (let y = 0; y < 5; y++) {\n      for (let x = 0; x < this.width; x++) {\n        if (Math.random() < 0.4) this.setTerrain(x, y, Terrain.Mountain);\n      }\n    }\n\n    // Paths\n    for (let x = 5; x < 35; x++) {\n      this.setTerrain(x, 15, Terrain.Path);\n    }\n    for (let y = 5; y < 25; y++) {\n      this.setTerrain(20, y, Terrain.Path);\n    }\n  }\n\n  private generateSpiritFieldArea(): void {\n    // 灵田区：大量灵田资源\n    for (let y = 4; y < 16; y++) {\n      for (let x = 4; x < 21; x++) {\n        if (Math.random() < 0.5) {\n          this.setTerrain(x, y, Terrain.RichSoil);\n        }\n      }\n    }\n\n    const veinPositions = [\n      [2, 2], [22, 18],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    for (let x = 3; x < 22; x++) {\n      this.setTerrain(x, 10, Terrain.Path);\n    }\n  }\n\n  private generateMineArea(): void {\n    // 灵石矿区：大量矿脉\n    const veinPositions = [\n      [3, 3], [4, 3], [3, 4],\n      [15, 8], [16, 8], [16, 9],\n      [25, 15], [26, 15], [26, 16],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    for (let x = 5; x < 25; x++) {\n      this.setTerrain(x, 10, Terrain.Path);\n    }\n  }\n\n  // Render map terrain to canvas\n  render(\n    ctx: CanvasRenderingContext2D,\n    offsetX: number,\n    offsetY: number,\n    viewportW: number,\n    viewportH: number,\n    scale: number,\n  ): void {\n    const invScale = 1 / scale;\n    const startCol = Math.max(0, Math.floor(-offsetX * invScale / this.cellSize));\n    const startRow = Math.max(0, Math.floor(-offsetY * invScale / this.cellSize));\n    const endCol = Math.min(this.width, Math.ceil((-offsetX + viewportW) * invScale / this.cellSize) + 1);\n    const endRow = Math.min(this.height, Math.ceil((-offsetY + viewportH) * invScale / this.cellSize) + 1);\n\n    // Draw terrain cells\n    for (let row = startRow; row < endRow; row++) {\n      for (let col = startCol; col < endCol; col++) {\n        const x = offsetX + col * this.cellSize * scale;\n        const y = offsetY + row * this.cellSize * scale;\n        const size = this.cellSize * scale;\n\n        ctx.fillStyle = this.getTerrainColor(this.getTerrain(col, row));\n        ctx.fillRect(x, y, size, size);\n\n        // Draw grid line\n        ctx.strokeStyle = this.gridColor;\n        ctx.lineWidth = 0.5;\n        ctx.strokeRect(x, y, size, size);\n      }\n    }\n  }\n\n  private getTerrainColor(t: Terrain): string {\n    switch (t) {\n      case Terrain.Grass: return this.bgColor;\n      case Terrain.Rock: return '#3a3a4a';\n      case Terrain.Water: return '#1a3a5a';\n      case Terrain.RichSoil: return '#2a4a1a';\n      case Terrain.Mountain: return '#4a4a4a';\n      case Terrain.Path: return '#4a3a2a';\n      case Terrain.SpiritVein: return '#2a4a5a';\n      default: return this.bgColor;\n    }\n  }\n\n  // Screen coordinates to grid cell\n  screenToGrid(\n    screenX: number,\n    screenY: number,\n    offsetX: number,\n    offsetY: number,\n    scale: number,\n  ): { gx: number; gy: number } {\n    const invScale = 1 / scale;\n    const gx = Math.floor((screenX - offsetX) * invScale / this.cellSize);\n    const gy = Math.floor((screenY - offsetY) * invScale / this.cellSize);\n    return { gx, gy };\n  }\n\n  // Grid cell center to screen coordinates\n  gridToScreen(\n    gx: number,\n    gy: number,\n    offsetX: number,\n    offsetY: number,\n    scale: number,\n  ): { x: number; y: number } {\n    return {\n      x: offsetX + (gx + 0.5) * this.cellSize * scale,\n      y: offsetY + (gy + 0.5) * this.cellSize * scale,\n    };\n  }\n}\n","userModified":false}}
{"type":"assistant","message":{"id":"msg_202605231017511683eec23e834104","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"text","text":"现在，创建新的M4系统文件：成就、飞升和跨区域传送。"}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"70497fdf-fe2b-457b-a803-661079378f19"}
{"type":"assistant","message":{"id":"msg_202605231017511683eec23e834104","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_561ea03e5071445db8b1fd99","name":"Write","input":{"file_path":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Achievement.ts","content":"// Achievement.ts — Achievement system with realm, production, automation, collection, and hidden achievements (v0.4.0)\n\nexport interface AchievementDef {\n  id: string;\n  name: string;\n  nameEn: string;\n  description: string;\n  category: 'realm' | 'production' | 'automation' | 'collection' | 'hidden';\n  condition: AchievementCondition;\n  reward?: { resource: string; amount: number };\n}\n\nexport type AchievementCondition =\n  | { type: 'realm_reached'; realmId: string }\n  | { type: 'resource_collected'; resource: string; totalAmount: number }\n  | { type: 'building_count'; buildingId: string; count: number }\n  | { type: 'pill_crafted'; pillId: string; count: number }\n  | { type: 'region_unlocked'; regionId: string }\n  | { type: 'ascension_completed' }\n  | { type: 'total_buildings'; count: number }\n  | { type: 'playtime_hours'; hours: number }\n  | { type: 'cross_region_links'; count: number };\n\nconst ACHIEVEMENT_DEFS: AchievementDef[] = [\n  // Realm achievements (6)\n  { id: 'realm_liqi', name: '踏入修途', nameEn: 'First Step', description: '突破至炼气期', category: 'realm', condition: { type: 'realm_reached', realmId: 'liqi' } },\n  { id: 'realm_zhuji', name: '筑基有成', nameEn: 'Foundation Set', description: '突破至筑基期', category: 'realm', condition: { type: 'realm_reached', realmId: 'zhuji' } },\n  { id: 'realm_jindan', name: '金丹大道', nameEn: 'Golden Path', description: '突破至金丹期', category: 'realm', condition: { type: 'realm_reached', realmId: 'jindan' } },\n  { id: 'realm_yuanying', name: '元婴初成', nameEn: 'Soul Emergence', description: '突破至元婴期', category: 'realm', condition: { type: 'realm_reached', realmId: 'yuanying' } },\n  { id: 'realm_huashen', name: '化神成仙', nameEn: 'Spirit Severing', description: '突破至化神期', category: 'realm', condition: { type: 'realm_reached', realmId: 'huashen' } },\n  { id: 'ascension', name: '飞升天界', nameEn: 'Ascension', description: '完成飞升挑战', category: 'realm', condition: { type: 'ascension_completed' } },\n\n  // Production achievements (10)\n  { id: 'prod_stone_1k', name: '灵石小富', nameEn: 'Stone Hoarder', description: '累计收集1000灵石', category: 'production', condition: { type: 'resource_collected', resource: 'spirit_stone', totalAmount: 1000 } },\n  { id: 'prod_stone_1m', name: '灵石大亨', nameEn: 'Stone Tycoon', description: '累计收集1000000灵石', category: 'production', condition: { type: 'resource_collected', resource: 'spirit_stone', totalAmount: 1000000 } },\n  { id: 'prod_grass_500', name: '灵草丰收', nameEn: 'Herb Harvest', description: '累计收集500灵草', category: 'production', condition: { type: 'resource_collected', resource: 'spirit_grass', totalAmount: 500 } },\n  { id: 'prod_pill_100', name: '炼丹百颗', nameEn: 'Pill Centurion', description: '累计炼制100颗丹药', category: 'production', condition: { type: 'pill_crafted', pillId: 'any', count: 100 } },\n  { id: 'prod_pill_1000', name: '丹道宗师', nameEn: 'Pill Grandmaster', description: '累计炼制1000颗丹药', category: 'production', condition: { type: 'pill_crafted', pillId: 'any', count: 1000 } },\n  { id: 'prod_monster_core_100', name: '妖丹猎手', nameEn: 'Core Hunter', description: '累计获取100妖丹', category: 'production', condition: { type: 'resource_collected', resource: 'monster_core', totalAmount: 100 } },\n  { id: 'prod_liquid_50', name: '灵液收集者', nameEn: 'Liquid Collector', description: '累计获取50天地灵液', category: 'production', condition: { type: 'resource_collected', resource: 'heaven_earth_liquid', totalAmount: 50 } },\n  { id: 'prod_immortal_20', name: '仙石矿主', nameEn: 'Immortal Miner', description: '累计获取20仙灵石', category: 'production', condition: { type: 'resource_collected', resource: 'immortal_stone', totalAmount: 20 } },\n  { id: 'prod_merit_100', name: '功德圆满', nameEn: 'Merit Master', description: '累计获取100功德值', category: 'production', condition: { type: 'resource_collected', resource: 'merit', totalAmount: 100 } },\n  { id: 'prod_jiuzhuan', name: '九转功成', nameEn: 'Nine-Turn Success', description: '成功炼制一颗九转金丹', category: 'production', condition: { type: 'pill_crafted', pillId: 'pill_jiuzhuan', count: 1 } },\n\n  // Automation achievements (10)\n  { id: 'auto_first_conveyor', name: '第一条通道', nameEn: 'First Channel', description: '放置第一条灵脉通道', category: 'automation', condition: { type: 'building_count', buildingId: 'conveyor_lv1', count: 1 } },\n  { id: 'auto_10_conveyors', name: '通道网络', nameEn: 'Channel Network', description: '拥有10条灵脉通道', category: 'automation', condition: { type: 'building_count', buildingId: 'any_conveyor', count: 10 } },\n  { id: 'auto_first_puppet', name: '第一傀儡', nameEn: 'First Puppet', description: '放置第一个分拣傀儡', category: 'automation', condition: { type: 'building_count', buildingId: 'puppet_sorter', count: 1 } },\n  { id: 'auto_5_puppets', name: '傀儡小队', nameEn: 'Puppet Squad', description: '拥有5个傀儡', category: 'automation', condition: { type: 'building_count', buildingId: 'puppet_sorter', count: 5 } },\n  { id: 'auto_smart_core', name: '智能核心', nameEn: 'Smart Core', description: '建造智能傀儡核心', category: 'automation', condition: { type: 'building_count', buildingId: 'smart_puppet_core', count: 1 } },\n  { id: 'auto_cross_region', name: '跨域连接', nameEn: 'Cross-Region', description: '建立第一条跨区域传送链路', category: 'automation', condition: { type: 'cross_region_links', count: 1 } },\n  { id: 'auto_5_cross', name: '跨域网络', nameEn: 'Cross-Region Network', description: '建立5条跨区域传送链路', category: 'automation', condition: { type: 'cross_region_links', count: 5 } },\n  { id: 'auto_space_fold', name: '空间折叠', nameEn: 'Space Fold', description: '建造空间折叠门', category: 'automation', condition: { type: 'building_count', buildingId: 'space_fold_gate', count: 1 } },\n  { id: 'auto_50_buildings', name: '设施遍地', nameEn: 'Building Boom', description: '同时拥有50座设施', category: 'automation', condition: { type: 'total_buildings', count: 50 } },\n  { id: 'auto_200_buildings', name: '工厂帝国', nameEn: 'Factory Empire', description: '同时拥有200座设施', category: 'automation', condition: { type: 'total_buildings', count: 200 } },\n\n  // Collection achievements (8)\n  { id: 'collect_all_pills', name: '丹药全鉴', nameEn: 'Pill Encyclopedia', description: '炼制过所有品阶丹药', category: 'collection', condition: { type: 'pill_crafted', pillId: 'all', count: 1 } },\n  { id: 'collect_monster_hunter', name: '猎妖专家', nameEn: 'Monster Expert', description: '在万兽岭建造猎妖台', category: 'collection', condition: { type: 'building_count', buildingId: 'monster_hunter', count: 1 } },\n  { id: 'collect_vein_depth', name: '灵脉探险', nameEn: 'Vein Explorer', description: '在灵脉深处建造灵液提取器', category: 'collection', condition: { type: 'building_count', buildingId: 'vein_extractor', count: 1 } },\n  { id: 'collect_immortal', name: '仙石开采', nameEn: 'Immortal Mining', description: '建造仙灵矿机', category: 'collection', condition: { type: 'building_count', buildingId: 'immortal_mine', count: 1 } },\n  { id: 'collect_merit', name: '功德祭坛', nameEn: 'Merit Altar', description: '建造功德祭坛', category: 'collection', condition: { type: 'building_count', buildingId: 'merit_altar', count: 1 } },\n  { id: 'collect_yuanying_furnace', name: '元婴丹师', nameEn: 'Soul Alchemist', description: '建造元婴果炉', category: 'collection', condition: { type: 'building_count', buildingId: 'furnace_yuanyingguo', count: 1 } },\n  { id: 'collect_huashen_furnace', name: '化神炼丹', nameEn: 'Severing Alchemist', description: '建造化神露炉', category: 'collection', condition: { type: 'building_count', buildingId: 'furnace_huashenlu', count: 1 } },\n  { id: 'collect_jiuzhuan_furnace', name: '九转炉成', nameEn: 'Nine-Turn Furnace', description: '建造九转金丹炉', category: 'collection', condition: { type: 'building_count', buildingId: 'furnace_jiuzhuan', count: 1 } },\n\n  // Hidden achievements (5)\n  { id: 'hidden_playtime_10', name: '闭关七日', nameEn: 'Secluded Cultivation', description: '游玩超过10小时', category: 'hidden', condition: { type: 'playtime_hours', hours: 10 } },\n  { id: 'hidden_playtime_50', name: '修仙五十年', nameEn: 'Fifty Years', description: '游玩超过50小时', category: 'hidden', condition: { type: 'playtime_hours', hours: 50 } },\n  { id: 'hidden_all_regions', name: '踏遍灵山', nameEn: 'Mountain Walker', description: '解锁所有地图区域', category: 'hidden', condition: { type: 'region_unlocked', regionId: 'sky_peak' } },\n  { id: 'hidden_immortal_mine_5', name: '仙石大亨', nameEn: 'Immortal Baron', description: '拥有5座仙灵矿机', category: 'hidden', condition: { type: 'building_count', buildingId: 'immortal_mine', count: 5 } },\n  { id: 'hidden_10_cross_links', name: '空间大师', nameEn: 'Space Master', description: '建立10条跨区域链路', category: 'hidden', condition: { type: 'cross_region_links', count: 10 } },\n];\n\nexport function getAllAchievements(): AchievementDef[] {\n  return ACHIEVEMENT_DEFS;\n}\n\nexport function getAchievement(id: string): AchievementDef | undefined {\n  return ACHIEVEMENT_DEFS.find(a => a.id === id);\n}\n\nexport function checkAchievement(\n  def: AchievementDef,\n  context: AchievementContext,\n): boolean {\n  const cond = def.condition;\n\n  switch (cond.type) {\n    case 'realm_reached': {\n      const idx = context.realmOrder.indexOf(cond.realmId);\n      return context.realmOrder.indexOf(context.currentRealmId) >= idx;\n    }\n    case 'resource_collected':\n      return (context.totalResourcesCollected[cond.resource] ?? 0) >= cond.totalAmount;\n    case 'building_count': {\n      if (cond.buildingId === 'any_conveyor') {\n        const count = (context.buildingCounts['conveyor_lv1'] ?? 0) + (context.buildingCounts['conveyor_lv2'] ?? 0);\n        return count >= cond.count;\n      }\n      return (context.buildingCounts[cond.buildingId] ?? 0) >= cond.count;\n    }\n    case 'pill_crafted':\n      if (cond.pillId === 'any') return (context.totalPillsCrafted ?? 0) >= cond.count;\n      if (cond.pillId === 'all') return context.allPillTypesCrafted;\n      return (context.pillsCrafted[cond.pillId] ?? 0) >= cond.count;\n    case 'region_unlocked':\n      return context.unlockedRegions.includes(cond.regionId);\n    case 'ascension_completed':\n      return context.ascensionCompleted;\n    case 'total_buildings':\n      return context.totalBuildingCount >= cond.count;\n    case 'playtime_hours':\n      return context.playtimeHours >= cond.hours;\n    case 'cross_region_links':\n      return context.crossRegionLinkCount >= cond.count;\n  }\n}\n\nexport interface AchievementContext {\n  currentRealmId: string;\n  realmOrder: string[];\n  totalResourcesCollected: Record<string, number>;\n  buildingCounts: Record<string, number>;\n  totalBuildingCount: number;\n  pillsCrafted: Record<string, number>;\n  totalPillsCrafted: number;\n  allPillTypesCrafted: boolean;\n  unlockedRegions: string[];\n  ascensionCompleted: boolean;\n  playtimeHours: number;\n  crossRegionLinkCount: number;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"568e9a5a-b639-4ff0-8e99-5710fe9e722e"}
{"type":"assistant","message":{"id":"msg_202605231017511683eec23e834104","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_34d493380ab745469907225b","name":"Write","input":{"file_path":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Ascension.ts","content":"// Ascension.ts — 飞升挑战系统 (v0.4.0)\n\nexport interface AscensionChallenge {\n  id: string;\n  name: string;\n  nameEn: string;\n  description: string;\n  requirements: AscensionRequirement[];\n  rewards: AscensionReward;\n}\n\nexport interface AscensionRequirement {\n  type: 'resource' | 'cultivation' | 'achievement';\n  resourceId?: string;\n  amount: number;\n  achievementId?: string;\n}\n\nexport interface AscensionReward {\n  title: string;\n  titleEn: string;\n  multiplier: number;\n}\n\nexport interface AscensionState {\n  canAttempt: boolean;\n  completed: boolean;\n  missingRequirements: string[];\n  attemptCount: number;\n}\n\nconst ASCENSION_CHALLENGE: AscensionChallenge = {\n  id: 'ascension',\n  name: '飞升挑战',\n  nameEn: 'Ascension Challenge',\n  description: '集齐全部资源，修为圆满，完成终极飞升！',\n  requirements: [\n    { type: 'cultivation', amount: 10000000 },\n    { type: 'resource', resourceId: 'pill_jiuzhuan', amount: 5 },\n    { type: 'resource', resourceId: 'immortal_stone', amount: 50 },\n    { type: 'resource', resourceId: 'heaven_earth_liquid', amount: 100 },\n    { type: 'resource', resourceId: 'merit', amount: 200 },\n    { type: 'resource', resourceId: 'monster_core', amount: 100 },\n  ],\n  rewards: {\n    title: '飞升仙尊',\n    titleEn: 'Ascended Immortal',\n    multiplier: 10.0,\n  },\n};\n\nexport function getAscensionChallenge(): AscensionChallenge {\n  return ASCENSION_CHALLENGE;\n}\n\nexport function checkAscensionRequirements(\n  resources: Record<string, number>,\n  totalCultivation: number,\n): AscensionState {\n  const missing: string[] = [];\n\n  for (const req of ASCENSION_CHALLENGE.requirements) {\n    switch (req.type) {\n      case 'cultivation':\n        if (totalCultivation < req.amount) {\n          missing.push(`修为 ${formatNum(totalCultivation)}/${formatNum(req.amount)}`);\n        }\n        break;\n      case 'resource':\n        if (req.resourceId) {\n          const current = resources[req.resourceId] ?? 0;\n          if (current < req.amount) {\n            missing.push(`${getResourceName(req.resourceId)} ${current}/${req.amount}`);\n          }\n        }\n        break;\n    }\n  }\n\n  return {\n    canAttempt: missing.length === 0,\n    completed: false,\n    missingRequirements: missing,\n    attemptCount: 0,\n  };\n}\n\nexport function attemptAscension(\n  resources: Record<string, number>,\n  totalCultivation: number,\n): { success: boolean; newResources: Record<string, number>; reward: AscensionReward | null } {\n  const state = checkAscensionRequirements(resources, totalCultivation);\n  if (!state.canAttempt) return { success: false, newResources: resources, reward: null };\n\n  // Consume resources\n  const newResources = { ...resources };\n  for (const req of ASCENSION_CHALLENGE.requirements) {\n    if (req.type === 'resource' && req.resourceId) {\n      newResources[req.resourceId] = (newResources[req.resourceId] ?? 0) - req.amount;\n    }\n  }\n\n  return {\n    success: true,\n    newResources,\n    reward: ASCENSION_CHALLENGE.rewards,\n  };\n}\n\nfunction getResourceName(id: string): string {\n  const names: Record<string, string> = {\n    pill_jiuzhuan: '九转金丹',\n    immortal_stone: '仙灵石',\n    heaven_earth_liquid: '天地灵液',\n    merit: '功德值',\n    monster_core: '妖丹',\n  };\n  return names[id] ?? id;\n}\n\nfunction formatNum(n: number): string {\n  if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';\n  if (n >= 1_000) return (n / 1_000).toFixed(1) + 'K';\n  return n.toString();\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"2e4247ba-df4c-46c3-8ea1-7c2d0dc045e3"}
{"type":"assistant","message":{"id":"msg_202605231017511683eec23e834104","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_ddab46766ee24218bf122e47","name":"Write","input":{"file_path":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\CrossRegionTeleport.ts","content":"// CrossRegionTeleport.ts — 跨区域传送系统 (v0.4.0)\n\nimport type { CrossRegionLink, Resources } from './GameState';\n\nexport interface CrossRegionTransferResult {\n  links: CrossRegionLink[];\n  transferred: Array<{ resource: string; amount: number; fromRegion: number; toRegion: number }>;\n}\n\n// Create a new cross-region link\nexport function createCrossRegionLink(\n  id: string,\n  fromRegionIndex: number,\n  fromX: number,\n  fromY: number,\n  toRegionIndex: number,\n  toX: number,\n  toY: number,\n  resource: string,\n  amount: number,\n  interval: number,\n): CrossRegionLink {\n  return {\n    id,\n    fromRegionIndex,\n    fromX,\n    fromY,\n    toRegionIndex,\n    toX,\n    toY,\n    resource,\n    amount,\n    interval,\n    lastTransfer: 0,\n  };\n}\n\n// Validate a cross-region link\nexport function validateLink(link: CrossRegionLink, regionCount: number): boolean {\n  if (link.fromRegionIndex < 0 || link.fromRegionIndex >= regionCount) return false;\n  if (link.toRegionIndex < 0 || link.toRegionIndex >= regionCount) return false;\n  if (link.fromRegionIndex === link.toRegionIndex) return false;\n  if (link.amount <= 0) return false;\n  if (link.interval <= 0) return false;\n  return true;\n}\n\n// Tick all cross-region links and process transfers\nexport function tickCrossRegionLinks(\n  links: CrossRegionLink[],\n  resources: Resources,\n  now: number,\n): CrossRegionTransferResult {\n  const transferred: Array<{ resource: string; amount: number; fromRegion: number; toRegion: number }> = [];\n  const updatedLinks: CrossRegionLink[] = [];\n\n  for (const link of links) {\n    const elapsed = now - link.lastTransfer;\n\n    if (elapsed >= link.interval) {\n      const currentAmount = resources[link.resource as keyof Resources] ?? 0;\n      if (currentAmount >= link.amount) {\n        transferred.push({\n          resource: link.resource,\n          amount: link.amount,\n          fromRegion: link.fromRegionIndex,\n          toRegion: link.toRegionIndex,\n        });\n        updatedLinks.push({ ...link, lastTransfer: now });\n      } else {\n        updatedLinks.push(link);\n      }\n    } else {\n      updatedLinks.push(link);\n    }\n  }\n\n  return { links: updatedLinks, transferred };\n}\n\n// Get link status for display\nexport function getLinkStatus(link: CrossRegionLink, now: number): {\n  progress: number;\n  timeToNext: number;\n} {\n  const elapsed = now - link.lastTransfer;\n  const progress = Math.min(1, elapsed / link.interval);\n  const timeToNext = Math.max(0, link.interval - elapsed);\n  return { progress, timeToNext };\n}\n\n// Render a cross-region portal on canvas\nexport function renderCrossRegionPortal(\n  ctx: CanvasRenderingContext2D,\n  gridX: number,\n  gridY: number,\n  offsetX: number,\n  offsetY: number,\n  scale: number,\n  cellSize: number,\n  now: number,\n): void {\n  const x = offsetX + gridX * cellSize * scale;\n  const y = offsetY + gridY * cellSize * scale;\n  const s = 3 * cellSize * scale; // 3x3 building\n\n  // Portal base\n  ctx.fillStyle = 'rgba(120, 80, 255, 0.3)';\n  ctx.fillRect(x + 2, y + 2, s - 4, s - 4);\n\n  // Animated ring\n  const phase = (now / 2000) % 1;\n  const ringRadius = s * 0.3 + s * 0.1 * Math.sin(phase * Math.PI * 2);\n\n  ctx.strokeStyle = 'rgba(150, 100, 255, 0.8)';\n  ctx.lineWidth = 3 * scale;\n  ctx.beginPath();\n  ctx.arc(x + s / 2, y + s / 2, ringRadius, 0, Math.PI * 2);\n  ctx.stroke();\n\n  // Inner glow\n  ctx.fillStyle = 'rgba(180, 140, 255, 0.2)';\n  ctx.beginPath();\n  ctx.arc(x + s / 2, y + s / 2, ringRadius * 0.6, 0, Math.PI * 2);\n  ctx.fill();\n\n  // Portal icon\n  ctx.fillStyle = '#fff';\n  ctx.font = `${Math.max(14, Math.floor(20 * scale))}px serif`;\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n  ctx.fillText('🌀', x + s / 2, y + s / 2);\n\n  // Label\n  ctx.font = `bold ${Math.max(6, Math.floor(8 * scale))}px monospace`;\n  ctx.fillStyle = '#b480ff';\n  ctx.fillText('跨域', x + s / 2, y + s - 6 * scale);\n}\n\n// Render a space fold gate on canvas\nexport function renderSpaceFoldGate(\n  ctx: CanvasRenderingContext2D,\n  gridX: number,\n  gridY: number,\n  offsetX: number,\n  offsetY: number,\n  scale: number,\n  cellSize: number,\n  now: number,\n): void {\n  const x = offsetX + gridX * cellSize * scale;\n  const y = offsetY + gridY * cellSize * scale;\n  const s = 3 * cellSize * scale;\n\n  // Gate frame\n  ctx.fillStyle = 'rgba(200, 100, 255, 0.25)';\n  ctx.fillRect(x + 2, y + 2, s - 4, s - 4);\n\n  // Animated warp effect\n  const phase = (now / 1500) % 1;\n  for (let i = 0; i < 3; i++) {\n    const r = s * (0.15 + i * 0.1) + s * 0.05 * Math.sin((phase + i * 0.3) * Math.PI * 2);\n    ctx.strokeStyle = `rgba(220, 150, 255, ${0.6 - i * 0.15})`;\n    ctx.lineWidth = 2 * scale;\n    ctx.beginPath();\n    ctx.arc(x + s / 2, y + s / 2, r, 0, Math.PI * 2);\n    ctx.stroke();\n  }\n\n  // Gate icon\n  ctx.fillStyle = '#fff';\n  ctx.font = `${Math.max(14, Math.floor(20 * scale))}px serif`;\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n  ctx.fillText('🌀', x + s / 2, y + s / 2);\n\n  ctx.font = `bold ${Math.max(6, Math.floor(8 * scale))}px monospace`;\n  ctx.fillStyle = '#dc96ff';\n  ctx.fillText('折叠', x + s / 2, y + s - 6 * scale);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"4fb27b27-ab48-4cc0-8c71-3be89c09080e"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_561ea03e5071445db8b1fd99","type":"tool_result","content":"File created successfully at: D:\\game-projects\\steam-cultivation-factory\\src\\game\\Achievement.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"df754a2a-7f64-4151-9f0c-32a9c17e3aca","timestamp":"2026-05-23T02:19:17.404Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Achievement.ts","content":"// Achievement.ts — Achievement system with realm, production, automation, collection, and hidden achievements (v0.4.0)\n\nexport interface AchievementDef {\n  id: string;\n  name: string;\n  nameEn: string;\n  description: string;\n  category: 'realm' | 'production' | 'automation' | 'collection' | 'hidden';\n  condition: AchievementCondition;\n  reward?: { resource: string; amount: number };\n}\n\nexport type AchievementCondition =\n  | { type: 'realm_reached'; realmId: string }\n  | { type: 'resource_collected'; resource: string; totalAmount: number }\n  | { type: 'building_count'; buildingId: string; count: number }\n  | { type: 'pill_crafted'; pillId: string; count: number }\n  | { type: 'region_unlocked'; regionId: string }\n  | { type: 'ascension_completed' }\n  | { type: 'total_buildings'; count: number }\n  | { type: 'playtime_hours'; hours: number }\n  | { type: 'cross_region_links'; count: number };\n\nconst ACHIEVEMENT_DEFS: AchievementDef[] = [\n  // Realm achievements (6)\n  { id: 'realm_liqi', name: '踏入修途', nameEn: 'First Step', description: '突破至炼气期', category: 'realm', condition: { type: 'realm_reached', realmId: 'liqi' } },\n  { id: 'realm_zhuji', name: '筑基有成', nameEn: 'Foundation Set', description: '突破至筑基期', category: 'realm', condition: { type: 'realm_reached', realmId: 'zhuji' } },\n  { id: 'realm_jindan', name: '金丹大道', nameEn: 'Golden Path', description: '突破至金丹期', category: 'realm', condition: { type: 'realm_reached', realmId: 'jindan' } },\n  { id: 'realm_yuanying', name: '元婴初成', nameEn: 'Soul Emergence', description: '突破至元婴期', category: 'realm', condition: { type: 'realm_reached', realmId: 'yuanying' } },\n  { id: 'realm_huashen', name: '化神成仙', nameEn: 'Spirit Severing', description: '突破至化神期', category: 'realm', condition: { type: 'realm_reached', realmId: 'huashen' } },\n  { id: 'ascension', name: '飞升天界', nameEn: 'Ascension', description: '完成飞升挑战', category: 'realm', condition: { type: 'ascension_completed' } },\n\n  // Production achievements (10)\n  { id: 'prod_stone_1k', name: '灵石小富', nameEn: 'Stone Hoarder', description: '累计收集1000灵石', category: 'production', condition: { type: 'resource_collected', resource: 'spirit_stone', totalAmount: 1000 } },\n  { id: 'prod_stone_1m', name: '灵石大亨', nameEn: 'Stone Tycoon', description: '累计收集1000000灵石', category: 'production', condition: { type: 'resource_collected', resource: 'spirit_stone', totalAmount: 1000000 } },\n  { id: 'prod_grass_500', name: '灵草丰收', nameEn: 'Herb Harvest', description: '累计收集500灵草', category: 'production', condition: { type: 'resource_collected', resource: 'spirit_grass', totalAmount: 500 } },\n  { id: 'prod_pill_100', name: '炼丹百颗', nameEn: 'Pill Centurion', description: '累计炼制100颗丹药', category: 'production', condition: { type: 'pill_crafted', pillId: 'any', count: 100 } },\n  { id: 'prod_pill_1000', name: '丹道宗师', nameEn: 'Pill Grandmaster', description: '累计炼制1000颗丹药', category: 'production', condition: { type: 'pill_crafted', pillId: 'any', count: 1000 } },\n  { id: 'prod_monster_core_100', name: '妖丹猎手', nameEn: 'Core Hunter', description: '累计获取100妖丹', category: 'production', condition: { type: 'resource_collected', resource: 'monster_core', totalAmount: 100 } },\n  { id: 'prod_liquid_50', name: '灵液收集者', nameEn: 'Liquid Collector', description: '累计获取50天地灵液', category: 'production', condition: { type: 'resource_collected', resource: 'heaven_earth_liquid', totalAmount: 50 } },\n  { id: 'prod_immortal_20', name: '仙石矿主', nameEn: 'Immortal Miner', description: '累计获取20仙灵石', category: 'production', condition: { type: 'resource_collected', resource: 'immortal_stone', totalAmount: 20 } },\n  { id: 'prod_merit_100', name: '功德圆满', nameEn: 'Merit Master', description: '累计获取100功德值', category: 'production', condition: { type: 'resource_collected', resource: 'merit', totalAmount: 100 } },\n  { id: 'prod_jiuzhuan', name: '九转功成', nameEn: 'Nine-Turn Success', description: '成功炼制一颗九转金丹', category: 'production', condition: { type: 'pill_crafted', pillId: 'pill_jiuzhuan', count: 1 } },\n\n  // Automation achievements (10)\n  { id: 'auto_first_conveyor', name: '第一条通道', nameEn: 'First Channel', description: '放置第一条灵脉通道', category: 'automation', condition: { type: 'building_count', buildingId: 'conveyor_lv1', count: 1 } },\n  { id: 'auto_10_conveyors', name: '通道网络', nameEn: 'Channel Network', description: '拥有10条灵脉通道', category: 'automation', condition: { type: 'building_count', buildingId: 'any_conveyor', count: 10 } },\n  { id: 'auto_first_puppet', name: '第一傀儡', nameEn: 'First Puppet', description: '放置第一个分拣傀儡', category: 'automation', condition: { type: 'building_count', buildingId: 'puppet_sorter', count: 1 } },\n  { id: 'auto_5_puppets', name: '傀儡小队', nameEn: 'Puppet Squad', description: '拥有5个傀儡', category: 'automation', condition: { type: 'building_count', buildingId: 'puppet_sorter', count: 5 } },\n  { id: 'auto_smart_core', name: '智能核心', nameEn: 'Smart Core', description: '建造智能傀儡核心', category: 'automation', condition: { type: 'building_count', buildingId: 'smart_puppet_core', count: 1 } },\n  { id: 'auto_cross_region', name: '跨域连接', nameEn: 'Cross-Region', description: '建立第一条跨区域传送链路', category: 'automation', condition: { type: 'cross_region_links', count: 1 } },\n  { id: 'auto_5_cross', name: '跨域网络', nameEn: 'Cross-Region Network', description: '建立5条跨区域传送链路', category: 'automation', condition: { type: 'cross_region_links', count: 5 } },\n  { id: 'auto_space_fold', name: '空间折叠', nameEn: 'Space Fold', description: '建造空间折叠门', category: 'automation', condition: { type: 'building_count', buildingId: 'space_fold_gate', count: 1 } },\n  { id: 'auto_50_buildings', name: '设施遍地', nameEn: 'Building Boom', description: '同时拥有50座设施', category: 'automation', condition: { type: 'total_buildings', count: 50 } },\n  { id: 'auto_200_buildings', name: '工厂帝国', nameEn: 'Factory Empire', description: '同时拥有200座设施', category: 'automation', condition: { type: 'total_buildings', count: 200 } },\n\n  // Collection achievements (8)\n  { id: 'collect_all_pills', name: '丹药全鉴', nameEn: 'Pill Encyclopedia', description: '炼制过所有品阶丹药', category: 'collection', condition: { type: 'pill_crafted', pillId: 'all', count: 1 } },\n  { id: 'collect_monster_hunter', name: '猎妖专家', nameEn: 'Monster Expert', description: '在万兽岭建造猎妖台', category: 'collection', condition: { type: 'building_count', buildingId: 'monster_hunter', count: 1 } },\n  { id: 'collect_vein_depth', name: '灵脉探险', nameEn: 'Vein Explorer', description: '在灵脉深处建造灵液提取器', category: 'collection', condition: { type: 'building_count', buildingId: 'vein_extractor', count: 1 } },\n  { id: 'collect_immortal', name: '仙石开采', nameEn: 'Immortal Mining', description: '建造仙灵矿机', category: 'collection', condition: { type: 'building_count', buildingId: 'immortal_mine', count: 1 } },\n  { id: 'collect_merit', name: '功德祭坛', nameEn: 'Merit Altar', description: '建造功德祭坛', category: 'collection', condition: { type: 'building_count', buildingId: 'merit_altar', count: 1 } },\n  { id: 'collect_yuanying_furnace', name: '元婴丹师', nameEn: 'Soul Alchemist', description: '建造元婴果炉', category: 'collection', condition: { type: 'building_count', buildingId: 'furnace_yuanyingguo', count: 1 } },\n  { id: 'collect_huashen_furnace', name: '化神炼丹', nameEn: 'Severing Alchemist', description: '建造化神露炉', category: 'collection', condition: { type: 'building_count', buildingId: 'furnace_huashenlu', count: 1 } },\n  { id: 'collect_jiuzhuan_furnace', name: '九转炉成', nameEn: 'Nine-Turn Furnace', description: '建造九转金丹炉', category: 'collection', condition: { type: 'building_count', buildingId: 'furnace_jiuzhuan', count: 1 } },\n\n  // Hidden achievements (5)\n  { id: 'hidden_playtime_10', name: '闭关七日', nameEn: 'Secluded Cultivation', description: '游玩超过10小时', category: 'hidden', condition: { type: 'playtime_hours', hours: 10 } },\n  { id: 'hidden_playtime_50', name: '修仙五十年', nameEn: 'Fifty Years', description: '游玩超过50小时', category: 'hidden', condition: { type: 'playtime_hours', hours: 50 } },\n  { id: 'hidden_all_regions', name: '踏遍灵山', nameEn: 'Mountain Walker', description: '解锁所有地图区域', category: 'hidden', condition: { type: 'region_unlocked', regionId: 'sky_peak' } },\n  { id: 'hidden_immortal_mine_5', name: '仙石大亨', nameEn: 'Immortal Baron', description: '拥有5座仙灵矿机', category: 'hidden', condition: { type: 'building_count', buildingId: 'immortal_mine', count: 5 } },\n  { id: 'hidden_10_cross_links', name: '空间大师', nameEn: 'Space Master', description: '建立10条跨区域链路', category: 'hidden', condition: { type: 'cross_region_links', count: 10 } },\n];\n\nexport function getAllAchievements(): AchievementDef[] {\n  return ACHIEVEMENT_DEFS;\n}\n\nexport function getAchievement(id: string): AchievementDef | undefined {\n  return ACHIEVEMENT_DEFS.find(a => a.id === id);\n}\n\nexport function checkAchievement(\n  def: AchievementDef,\n  context: AchievementContext,\n): boolean {\n  const cond = def.condition;\n\n  switch (cond.type) {\n    case 'realm_reached': {\n      const idx = context.realmOrder.indexOf(cond.realmId);\n      return context.realmOrder.indexOf(context.currentRealmId) >= idx;\n    }\n    case 'resource_collected':\n      return (context.totalResourcesCollected[cond.resource] ?? 0) >= cond.totalAmount;\n    case 'building_count': {\n      if (cond.buildingId === 'any_conveyor') {\n        const count = (context.buildingCounts['conveyor_lv1'] ?? 0) + (context.buildingCounts['conveyor_lv2'] ?? 0);\n        return count >= cond.count;\n      }\n      return (context.buildingCounts[cond.buildingId] ?? 0) >= cond.count;\n    }\n    case 'pill_crafted':\n      if (cond.pillId === 'any') return (context.totalPillsCrafted ?? 0) >= cond.count;\n      if (cond.pillId === 'all') return context.allPillTypesCrafted;\n      return (context.pillsCrafted[cond.pillId] ?? 0) >= cond.count;\n    case 'region_unlocked':\n      return context.unlockedRegions.includes(cond.regionId);\n    case 'ascension_completed':\n      return context.ascensionCompleted;\n    case 'total_buildings':\n      return context.totalBuildingCount >= cond.count;\n    case 'playtime_hours':\n      return context.playtimeHours >= cond.hours;\n    case 'cross_region_links':\n      return context.crossRegionLinkCount >= cond.count;\n  }\n}\n\nexport interface AchievementContext {\n  currentRealmId: string;\n  realmOrder: string[];\n  totalResourcesCollected: Record<string, number>;\n  buildingCounts: Record<string, number>;\n  totalBuildingCount: number;\n  pillsCrafted: Record<string, number>;\n  totalPillsCrafted: number;\n  allPillTypesCrafted: boolean;\n  unlockedRegions: string[];\n  ascensionCompleted: boolean;\n  playtimeHours: number;\n  crossRegionLinkCount: number;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_34d493380ab745469907225b","type":"tool_result","content":"File created successfully at: D:\\game-projects\\steam-cultivation-factory\\src\\game\\Ascension.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"665b8754-e62f-44c5-a84f-9eb67519dc5c","timestamp":"2026-05-23T02:19:18.310Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Ascension.ts","content":"// Ascension.ts — 飞升挑战系统 (v0.4.0)\n\nexport interface AscensionChallenge {\n  id: string;\n  name: string;\n  nameEn: string;\n  description: string;\n  requirements: AscensionRequirement[];\n  rewards: AscensionReward;\n}\n\nexport interface AscensionRequirement {\n  type: 'resource' | 'cultivation' | 'achievement';\n  resourceId?: string;\n  amount: number;\n  achievementId?: string;\n}\n\nexport interface AscensionReward {\n  title: string;\n  titleEn: string;\n  multiplier: number;\n}\n\nexport interface AscensionState {\n  canAttempt: boolean;\n  completed: boolean;\n  missingRequirements: string[];\n  attemptCount: number;\n}\n\nconst ASCENSION_CHALLENGE: AscensionChallenge = {\n  id: 'ascension',\n  name: '飞升挑战',\n  nameEn: 'Ascension Challenge',\n  description: '集齐全部资源，修为圆满，完成终极飞升！',\n  requirements: [\n    { type: 'cultivation', amount: 10000000 },\n    { type: 'resource', resourceId: 'pill_jiuzhuan', amount: 5 },\n    { type: 'resource', resourceId: 'immortal_stone', amount: 50 },\n    { type: 'resource', resourceId: 'heaven_earth_liquid', amount: 100 },\n    { type: 'resource', resourceId: 'merit', amount: 200 },\n    { type: 'resource', resourceId: 'monster_core', amount: 100 },\n  ],\n  rewards: {\n    title: '飞升仙尊',\n    titleEn: 'Ascended Immortal',\n    multiplier: 10.0,\n  },\n};\n\nexport function getAscensionChallenge(): AscensionChallenge {\n  return ASCENSION_CHALLENGE;\n}\n\nexport function checkAscensionRequirements(\n  resources: Record<string, number>,\n  totalCultivation: number,\n): AscensionState {\n  const missing: string[] = [];\n\n  for (const req of ASCENSION_CHALLENGE.requirements) {\n    switch (req.type) {\n      case 'cultivation':\n        if (totalCultivation < req.amount) {\n          missing.push(`修为 ${formatNum(totalCultivation)}/${formatNum(req.amount)}`);\n        }\n        break;\n      case 'resource':\n        if (req.resourceId) {\n          const current = resources[req.resourceId] ?? 0;\n          if (current < req.amount) {\n            missing.push(`${getResourceName(req.resourceId)} ${current}/${req.amount}`);\n          }\n        }\n        break;\n    }\n  }\n\n  return {\n    canAttempt: missing.length === 0,\n    completed: false,\n    missingRequirements: missing,\n    attemptCount: 0,\n  };\n}\n\nexport function attemptAscension(\n  resources: Record<string, number>,\n  totalCultivation: number,\n): { success: boolean; newResources: Record<string, number>; reward: AscensionReward | null } {\n  const state = checkAscensionRequirements(resources, totalCultivation);\n  if (!state.canAttempt) return { success: false, newResources: resources, reward: null };\n\n  // Consume resources\n  const newResources = { ...resources };\n  for (const req of ASCENSION_CHALLENGE.requirements) {\n    if (req.type === 'resource' && req.resourceId) {\n      newResources[req.resourceId] = (newResources[req.resourceId] ?? 0) - req.amount;\n    }\n  }\n\n  return {\n    success: true,\n    newResources,\n    reward: ASCENSION_CHALLENGE.rewards,\n  };\n}\n\nfunction getResourceName(id: string): string {\n  const names: Record<string, string> = {\n    pill_jiuzhuan: '九转金丹',\n    immortal_stone: '仙灵石',\n    heaven_earth_liquid: '天地灵液',\n    merit: '功德值',\n    monster_core: '妖丹',\n  };\n  return names[id] ?? id;\n}\n\nfunction formatNum(n: number): string {\n  if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';\n  if (n >= 1_000) return (n / 1_000).toFixed(1) + 'K';\n  return n.toString();\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ddab46766ee24218bf122e47","type":"tool_result","content":"File created successfully at: D:\\game-projects\\steam-cultivation-factory\\src\\game\\CrossRegionTeleport.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"f6e3407f-15f7-4228-b38e-bc591bf77f45","timestamp":"2026-05-23T02:19:19.147Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\CrossRegionTeleport.ts","content":"// CrossRegionTeleport.ts — 跨区域传送系统 (v0.4.0)\n\nimport type { CrossRegionLink, Resources } from './GameState';\n\nexport interface CrossRegionTransferResult {\n  links: CrossRegionLink[];\n  transferred: Array<{ resource: string; amount: number; fromRegion: number; toRegion: number }>;\n}\n\n// Create a new cross-region link\nexport function createCrossRegionLink(\n  id: string,\n  fromRegionIndex: number,\n  fromX: number,\n  fromY: number,\n  toRegionIndex: number,\n  toX: number,\n  toY: number,\n  resource: string,\n  amount: number,\n  interval: number,\n): CrossRegionLink {\n  return {\n    id,\n    fromRegionIndex,\n    fromX,\n    fromY,\n    toRegionIndex,\n    toX,\n    toY,\n    resource,\n    amount,\n    interval,\n    lastTransfer: 0,\n  };\n}\n\n// Validate a cross-region link\nexport function validateLink(link: CrossRegionLink, regionCount: number): boolean {\n  if (link.fromRegionIndex < 0 || link.fromRegionIndex >= regionCount) return false;\n  if (link.toRegionIndex < 0 || link.toRegionIndex >= regionCount) return false;\n  if (link.fromRegionIndex === link.toRegionIndex) return false;\n  if (link.amount <= 0) return false;\n  if (link.interval <= 0) return false;\n  return true;\n}\n\n// Tick all cross-region links and process transfers\nexport function tickCrossRegionLinks(\n  links: CrossRegionLink[],\n  resources: Resources,\n  now: number,\n): CrossRegionTransferResult {\n  const transferred: Array<{ resource: string; amount: number; fromRegion: number; toRegion: number }> = [];\n  const updatedLinks: CrossRegionLink[] = [];\n\n  for (const link of links) {\n    const elapsed = now - link.lastTransfer;\n\n    if (elapsed >= link.interval) {\n      const currentAmount = resources[link.resource as keyof Resources] ?? 0;\n      if (currentAmount >= link.amount) {\n        transferred.push({\n          resource: link.resource,\n          amount: link.amount,\n          fromRegion: link.fromRegionIndex,\n          toRegion: link.toRegionIndex,\n        });\n        updatedLinks.push({ ...link, lastTransfer: now });\n      } else {\n        updatedLinks.push(link);\n      }\n    } else {\n      updatedLinks.push(link);\n    }\n  }\n\n  return { links: updatedLinks, transferred };\n}\n\n// Get link status for display\nexport function getLinkStatus(link: CrossRegionLink, now: number): {\n  progress: number;\n  timeToNext: number;\n} {\n  const elapsed = now - link.lastTransfer;\n  const progress = Math.min(1, elapsed / link.interval);\n  const timeToNext = Math.max(0, link.interval - elapsed);\n  return { progress, timeToNext };\n}\n\n// Render a cross-region portal on canvas\nexport function renderCrossRegionPortal(\n  ctx: CanvasRenderingContext2D,\n  gridX: number,\n  gridY: number,\n  offsetX: number,\n  offsetY: number,\n  scale: number,\n  cellSize: number,\n  now: number,\n): void {\n  const x = offsetX + gridX * cellSize * scale;\n  const y = offsetY + gridY * cellSize * scale;\n  const s = 3 * cellSize * scale; // 3x3 building\n\n  // Portal base\n  ctx.fillStyle = 'rgba(120, 80, 255, 0.3)';\n  ctx.fillRect(x + 2, y + 2, s - 4, s - 4);\n\n  // Animated ring\n  const phase = (now / 2000) % 1;\n  const ringRadius = s * 0.3 + s * 0.1 * Math.sin(phase * Math.PI * 2);\n\n  ctx.strokeStyle = 'rgba(150, 100, 255, 0.8)';\n  ctx.lineWidth = 3 * scale;\n  ctx.beginPath();\n  ctx.arc(x + s / 2, y + s / 2, ringRadius, 0, Math.PI * 2);\n  ctx.stroke();\n\n  // Inner glow\n  ctx.fillStyle = 'rgba(180, 140, 255, 0.2)';\n  ctx.beginPath();\n  ctx.arc(x + s / 2, y + s / 2, ringRadius * 0.6, 0, Math.PI * 2);\n  ctx.fill();\n\n  // Portal icon\n  ctx.fillStyle = '#fff';\n  ctx.font = `${Math.max(14, Math.floor(20 * scale))}px serif`;\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n  ctx.fillText('🌀', x + s / 2, y + s / 2);\n\n  // Label\n  ctx.font = `bold ${Math.max(6, Math.floor(8 * scale))}px monospace`;\n  ctx.fillStyle = '#b480ff';\n  ctx.fillText('跨域', x + s / 2, y + s - 6 * scale);\n}\n\n// Render a space fold gate on canvas\nexport function renderSpaceFoldGate(\n  ctx: CanvasRenderingContext2D,\n  gridX: number,\n  gridY: number,\n  offsetX: number,\n  offsetY: number,\n  scale: number,\n  cellSize: number,\n  now: number,\n): void {\n  const x = offsetX + gridX * cellSize * scale;\n  const y = offsetY + gridY * cellSize * scale;\n  const s = 3 * cellSize * scale;\n\n  // Gate frame\n  ctx.fillStyle = 'rgba(200, 100, 255, 0.25)';\n  ctx.fillRect(x + 2, y + 2, s - 4, s - 4);\n\n  // Animated warp effect\n  const phase = (now / 1500) % 1;\n  for (let i = 0; i < 3; i++) {\n    const r = s * (0.15 + i * 0.1) + s * 0.05 * Math.sin((phase + i * 0.3) * Math.PI * 2);\n    ctx.strokeStyle = `rgba(220, 150, 255, ${0.6 - i * 0.15})`;\n    ctx.lineWidth = 2 * scale;\n    ctx.beginPath();\n    ctx.arc(x + s / 2, y + s / 2, r, 0, Math.PI * 2);\n    ctx.stroke();\n  }\n\n  // Gate icon\n  ctx.fillStyle = '#fff';\n  ctx.font = `${Math.max(14, Math.floor(20 * scale))}px serif`;\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n  ctx.fillText('🌀', x + s / 2, y + s / 2);\n\n  ctx.font = `bold ${Math.max(6, Math.floor(8 * scale))}px monospace`;\n  ctx.fillStyle = '#dc96ff';\n  ctx.fillText('折叠', x + s / 2, y + s - 6 * scale);\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
