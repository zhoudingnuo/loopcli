 + 'px';\n    this.canvas.style.height = h + 'px';\n    this.ctx.scale(dpr, dpr);\n    this.screenW = w;\n    this.screenH = h;\n\n    this.tileSize = Math.floor(Math.min(w * 0.9, (h - 160)) / BOARD_SIZE);\n    this.boardX = (w - this.tileSize * BOARD_SIZE) / 2;\n    this.boardY = 140;\n  }","numLines":30,"startLine":1,"totalLines":557}}}
