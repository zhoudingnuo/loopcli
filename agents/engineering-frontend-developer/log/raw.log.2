{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_1f4ae53913994e6da8fd9ca8","type":"tool_result","content":"1\t// ScoreSystem.js — Score, moves, goals (score/collect_color/clear_obstacle/boss/dual), stars\n2\t\n3\tclass ScoreSystem {\n4\t  constructor() {\n5\t    this.score = 0;\n6\t    this.moves = 0;\n7\t    this.maxMoves = 30;\n8\t    this.goalType = 'score';\n9\t    this.goalTarget = 1000;\n10\t    this.goalProgress = 0;\n11\t    this.level = 1;\n12\t    this.stars = [0, 0, 0];\n13\t    this.collected = {};\n14\t    this.obstaclesCleared = {};\n15\t    this.totalObstaclesCleared = 0;\n16\t    this.chainCount = 0;\n17\t    this.config = null;\n18\t\n19\t    // Dual goal support\n20\t    this.dualGoals = [];\n21\t\n22\t    // Collect_color specifics\n23\t    this.collectColors = [];\n24\t\n25\t    // Clear_obstacle specifics\n26\t    this.clearObstacleType = 0;\n27\t\n28\t    this.onScoreChange = null;\n29\t    this.onMovesChange = null;\n30\t    this.onLevelComplete = null;\n31\t    this.onLevelFail = null;\n32\t  }\n33\t\n34\t  reset(level = 1) {\n35\t    this.score = 0;\n36\t    this.moves = 0;\n37\t    this.goalProgress = 0;\n38\t    this.chainCount = 0;\n39\t    this.collected = {};\n40\t    this.obstaclesCleared = {};\n41\t    this.totalObstaclesCleared = 0;\n42\t    this.dualGoals = [];\n43\t    this.collectColors = [];\n44\t    this.clearObstacleType = 0;\n45\t    this.level = level;\n46\t  }\n47\t\n48\t  configure(config) {\n49\t    this.config = config;\n50\t    this.maxMoves = config.moves || 30;\n51\t    this.goalType = config.goal?.type || 'score';\n52\t    this.goalTarget = config.goal?.target || 1000;\n53\t    this.stars = config.stars || [1000, 1500, 2000];\n54\t\n55\t    if (this.goalType === 'collect_color') {\n56\t      this.collectColors = config.goal?.colors || [];\n57\t    } else if (this.goalType === 'clear_obstacle') {\n58\t      this.clearObstacleType = config.goal?.obstacleType || 0;\n59\t    } else if (this.goalType === 'dual') {\n60\t      this.dualGoals = (config.goal?.goals || []).map(g => ({\n61\t        type: g.type,\n62\t        target: g.target,\n63\t        progress: 0,\n64\t        colors: g.colors || [],\n65\t        obstacleType: g.obstacleType || 0,\n66\t      }));\n67\t    }\n68\t  }\n69\t\n70\t  useMove() {\n71\t    this.moves++;\n72\t    if (this.onMovesChange) this.onMovesChange(this.getRemainingMoves());\n73\t    return this.getRemainingMoves() >= 0;\n74\t  }\n75\t\n76\t  getRemainingMoves() {\n77\t    return this.maxMoves - this.moves;\n78\t  }\n79\t\n80\t  addMoves(n) {\n81\t    this.maxMoves += n;\n82\t    if (this.onMovesChange) this.onMovesChange(this.getRemainingMoves());\n83\t  }\n84\t\n85\t  getGoalProgress() {\n86\t    return this.goalProgress;\n87\t  }\n88\t\n89\t  addScore(points) {\n90\t    this.score += points;\n91\t    if (this.goalType === 'score') {\n92\t      this.goalProgress = this.score;\n93\t    }\n94\t    // Update dual score goals\n95\t    for (const dg of this.dualGoals) {\n96\t      if (dg.type === 'score') dg.progress = this.score;\n97\t    }\n98\t    if (this.onScoreChange) this.onScoreChange(this.score);\n99\t  }\n100\t\n101\t  addChainScore(basePoints, chainLevel) {\n102\t    const multiplier = chainLevel <= 1 ? 1 : chainLevel === 2 ? 1.5 : chainLevel === 3 ? 2.0 : 2.5;\n103\t    const points = Math.floor(basePoints * multiplier);\n104\t    this.addScore(points);\n105\t    this.chainCount = Math.max(this.chainCount, chainLevel);\n106\t    return points;\n107\t  }\n108\t\n109\t  addCollected(color, count) {\n110\t    this.collected[color] = (this.collected[color] || 0) + count;\n111\t    this._updateCollectProgress();\n112\t  }\n113\t\n114\t  _updateCollectProgress() {\n115\t    if (this.goalType === 'collect_color') {\n116\t      let total = 0;\n117\t      for (const c of this.collectColors) {\n118\t        total += this.collected[c] || 0;\n119\t      }\n120\t      this.goalProgress = total;\n121\t    }\n122\t    for (const dg of this.dualGoals) {\n123\t      if (dg.type === 'collect_color') {\n124\t        let total = 0;\n125\t        for (const c of dg.colors) {\n126\t          total += this.collected[c] || 0;\n127\t        }\n128\t        dg.progress = total;\n129\t      }\n130\t    }\n131\t  }\n132\t\n133\t  addObstacleCleared(type) {\n134\t    if (!this.obstaclesCleared[type]) this.obstaclesCleared[type] = 0;\n135\t    this.obstaclesCleared[type]++;\n136\t    this.totalObstaclesCleared++;\n137\t    this._updateClearProgress();\n138\t  }\n139\t\n140\t  _updateClearProgress() {\n141\t    if (this.goalType === 'clear_obstacle') {\n142\t      if (this.clearObstacleType === 0) {\n143\t        this.goalProgress = this.totalObstaclesCleared;\n144\t      } else {\n145\t        this.goalProgress = this.obstaclesCleared[this.clearObstacleType] || 0;\n146\t      }\n147\t    }\n148\t    for (const dg of this.dualGoals) {\n149\t      if (dg.type === 'clear_obstacle') {\n150\t        if (dg.obstacleType === 0) {\n151\t          dg.progress = this.totalObstaclesCleared;\n152\t        } else {\n153\t          dg.progress = this.obstaclesCleared[dg.obstacleType] || 0;\n154\t        }\n155\t      }\n156\t    }\n157\t  }\n158\t\n159\t  getStarCount() {\n160\t    if (this.score >= this.stars[2]) return 3;\n161\t    if (this.score >= this.stars[1]) return 2;\n162\t    if (this.score >= this.stars[0]) return 1;\n163\t    return 0;\n164\t  }\n165\t\n166\t  isGoalComplete() {\n167\t    switch (this.goalType) {\n168\t      case 'score':\n169\t        return this.score >= this.goalTarget;\n170\t      case 'collect_color':\n171\t        return this.goalProgress >= this.goalTarget;\n172\t      case 'clear_obstacle':\n173\t        return this.goalProgress >= this.goalTarget;\n174\t      case 'boss':\n175\t        return false; // Handled externally\n176\t      case 'dual':\n177\t        return this.dualGoals.every(g => g.progress >= g.target);\n178\t      default:\n179\t        return false;\n180\t    }\n181\t  }\n1