 }\n    this.data = this.dm.data.analytics;\n  }\n\n  _genSessionId() {\n    return Date.now().toString(36) + Math.random().toString(36).slice(2, 6);\n  }\n\n  // --- Core track method ---\n  track(eventName, params) {\n    const event = {\n      event: eventName,\n      ts: Date.now(),\n      session: this.data.sessionId,\n      uid: this.data.userId,\n      ...(params || {}),\n    };\n\n    this.data.queue.push(event);\n    this.data.totalCount++;\n    this.data.lastActive = Date.now();\n\n    if (this.data.queue.length >= this.maxQueueSize) {\n      this.flush();\n    } else {\n      this.dm.save();\n    }\n\n    // Console log in dev\n    if (!this.isDouyin) {\n      console.log(`[Analytics] ${eventName}`, params || '');\n    }\n  }\n\n  // --- Convenience methods ---\n  trackGameStart() {\n    this.track(ANALYTICS_EVENTS.GAME_START, {\n      version: '1.0',\n      platform: this.isDouyin ? 'douyin' : 'web',\n    });\n  }\n\n  trackLevelStart(levelNum, config) {\n    this.track(ANALYTICS_EVENTS.LEVEL_START, {\n      level: levelNum,\n      moves: config.moves,\n      goalType: config.goal?.type || 'score',\n    });\n  }\n\n  trackLevelComplete(levelNum, score, stars, movesUsed) {\n    this.track(ANALYTICS_EVENTS.LEVEL_COMPLETE, {\n      level: levelNum,\n      score,\n      stars,\n      movesUsed,\n      completionTime: Date.now(),\n    });\n  }\n\n  trackLevelFail(levelNum, score, movesUsed, goalProgress) {\n    this.track(ANALYTICS_EVENTS.LEVEL_FAIL, {\n      level: levelNum,\n      score,\n      movesUsed,\n      goalProgress,\n    });\n  }\n\n  trackAdShow(placement, completed) {\n    this.track(ANALYTICS_EVENTS.AD_SHOW, {\n      placement,\n      completed,\n      adType: placement === AD_PLACEMENTS.INTERSTITIAL ? 'interstitial' : 'rewarded',\n    });\n  }\n\n  trackAdClick(placement) {\n    this.track(ANALYTICS_EVENTS.AD_CLICK, { placement });\n  }\n\n  trackShare(type, level) {\n    this.track(ANALYTICS_EVENTS.SHARE, { type, level });\n  }\n\n  trackSocialPK(result, friendId) {\n    this.track(ANALYTICS_EVENTS.SOCIAL_PK, { result, friendId });\n  }\n\n  trackDailyLogin(day) {\n    this.track(ANALYTICS_EVENTS.DAILY_LOGIN, { day });\n  }\n\n  trackTutorialStep(stepId, level) {\n    this.track(ANALYTICS_EVENTS.TUTORIAL_STEP, { stepId, level });\n  }\n\n  // --- Flush queue ---\n  flush() {\n    if (this.data.queue.length === 0) return;\n\n    const batch = this.data.queue.splice(0, this.maxQueueSize);\n    this.dm.save();\n\n    if (this.isDouyin) {\n      this._uploadToServer(batch);\n    } else {\n      // Dev mode: log batch\n      console.log(`[Analytics] Flush ${batch.length} events`, batch);\n    }\n  }\n\n  _uploadToServer(events) {\n    try {\n      // 抖音云开发 or custom server endpoint\n      const request = tt.request || fetch;\n      if (request) {\n        request({\n          url: 'https://analytics.example.com/events',\n          method: 'POST',\n          data: { events, appId: 'match-and-blast' },\n        }).catch(() => {\n          // Re-queue on failure\n          this.data.queue.unshift(...events);\n          this.dm.save();\n        });\n      }\n    } catch (e) {\n      // Silent fail — analytics never blocks gameplay\n    }\n  }\n\n  // --- Session management ---\n  newSession() {\n    this.data.sessionId = this._genSessionId();\n    this.dm.save();\n  }\n\n  getSessionDuration() {\n    return Date.now() - (this.data.firstLaunch || Date.now());\n  }\n\n  // --- Metrics helpers ---\n  getRetentionInfo() {\n    const first = this.data.firstLaunch;\n    if (!first) return { isD1: false };\n    const daysSince = Math.floor((Date.now() - first) / 86400000);\n    return { isD1: daysSince === 1, daysSince };\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Analytics, ANALYTICS_EVENTS };\n","structuredPatch":[{"oldStart":66,"oldLines":8,"newStart":66,"newLines":8,"lines":["     }"," ","     // Console log in dev","-    if (!this.isDouyin) {","-      console.log(`[Analytics] ${eventName}`, params || '');","+    if (!this.isDouyin && typeof console !== 'undefined' && console.debug) {","+      console.debug(`[Analytics] ${eventName}`, params || '');","     }","   }"," "]}],"userModified":false,"replaceAll":false}}
