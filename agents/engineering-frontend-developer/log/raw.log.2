{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_c90ec38e681d48e981fdc84d","type":"tool_result","content":"The file D:/game-projects/douyin-match3/src/js/AudioManager.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"4fc1920c-0b5c-4266-b43d-05c38f749fa3","uuid":"a0500f07-9392-4359-868f-9c950edda21f","timestamp":"2026-05-22T21:34:55.001Z","tool_use_result":{"filePath":"D:/game-projects/douyin-match3/src/js/AudioManager.js","oldString":"  _ensure() {\n    if (!this._initialized) this.init();\n    this.resume();\n  }","newString":"  _ensure() {\n    if (!this._initialized) this.init();\n    this.resume();\n    return this._initialized;\n  }","originalFile":"// AudioManager.js — Web Audio API synthesized sound effects\n\nclass AudioManager {\n  constructor() {\n    this.ctx = null;\n    this.enabled = true;\n    this.volume = 0.5;\n    this._initialized = false;\n  }\n\n  init() {\n    if (this._initialized) return;\n    try {\n      this.ctx = new (window.AudioContext || window.webkitAudioContext)();\n      this._initialized = true;\n    } catch (e) {\n      this.enabled = false;\n    }\n  }\n\n  resume() {\n    if (this.ctx && this.ctx.state === 'suspended') {\n      this.ctx.resume();\n    }\n  }\n\n  _ensure() {\n    if (!this._initialized) this.init();\n    this.resume();\n  }\n\n  _tone(freq, dur, type = 'sine', vol = null) {\n    if (!this.enabled || !this._ensure()) return;\n    if (!this.ctx) return;\n    const osc = this.ctx.createOscillator();\n    const gain = this.ctx.createGain();\n    osc.type = type;\n    osc.frequency.setValueAtTime(freq, this.ctx.currentTime);\n    const v = (vol !== null ? vol : this.volume) * 0.25;\n    gain.gain.setValueAtTime(Math.max(0.001, v), this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + dur);\n    osc.connect(gain);\n    gain.connect(this.ctx.destination);\n    osc.start(this.ctx.currentTime);\n    osc.stop(this.ctx.currentTime + dur);\n  }\n\n  _noise(dur, vol = null) {\n    if (!this.enabled || !this.ctx) return;\n    this._ensure();\n    if (!this.ctx) return;\n    const size = Math.floor(this.ctx.sampleRate * dur);\n    const buffer = this.ctx.createBuffer(1, size, this.ctx.sampleRate);\n    const data = buffer.getChannelData(0);\n    for (let i = 0; i < size; i++) data[i] = (Math.random() * 2 - 1) * 0.5;\n    const source = this.ctx.createBufferSource();\n    source.buffer = buffer;\n    const gain = this.ctx.createGain();\n    const v = (vol !== null ? vol : this.volume) * 0.15;\n    gain.gain.setValueAtTime(Math.max(0.001, v), this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + dur);\n    const filter = this.ctx.createBiquadFilter();\n    filter.type = 'highpass';\n    filter.frequency.setValueAtTime(2000, this.ctx.currentTime);\n    source.connect(filter);\n    filter.connect(gain);\n    gain.connect(this.ctx.destination);\n    source.start(this.ctx.currentTime);\n  }\n\n  playMatch(chain = 1) {\n    const base = 440 + (chain - 1) * 80;\n    this._tone(base, 0.12);\n    setTimeout(() => this._tone(base * 1.25, 0.1), 40);\n  }\n\n  playSwap() { this._tone(330, 0.08); }\n\n  playSpecial() {\n    this._tone(523, 0.08, 'square');\n    setTimeout(() => this._tone(659, 0.08, 'square'), 60);\n    setTimeout(() => this._tone(784, 0.12, 'square'), 120);\n  }\n\n  playCombo(level) {\n    const freqs = [523, 659, 784, 1047];\n    for (let i = 0; i < Math.min(level, freqs.length); i++) {\n      setTimeout(() => this._tone(freqs[i], 0.12), i * 80);\n    }\n  }\n\n  playObstacleBreak() {\n    this._noise(0.15);\n    this._tone(200, 0.12, 'sawtooth');\n  }\n\n  playBossHit() {\n    this._tone(150, 0.15, 'sawtooth', 0.6);\n    this._noise(0.1, 0.5);\n  }\n\n  playBossAbility() {\n    this._tone(100, 0.3, 'sawtooth', 0.5);\n    this._noise(0.2, 0.4);\n  }\n\n  playBossDefeat() {\n    [523, 659, 784, 1047, 1319].forEach((f, i) => {\n      setTimeout(() => this._tone(f, 0.25, 'square'), i * 100);\n    });\n  }\n\n  playLevelWin() {\n    [523, 659, 784, 1047].forEach((f, i) => {\n      setTimeout(() => this._tone(f, 0.2), i * 120);\n    });\n  }\n\n  playLevelFail() {\n    [440, 349, 294, 262].forEach((f, i) => {\n      setTimeout(() => this._tone(f, 0.25), i * 180);\n    });\n  }\n\n  playInvalid() {\n    this._tone(200, 0.1, 'square');\n    setTimeout(() => this._tone(180, 0.1, 'square'), 80);\n  }\n\n  toggle() {\n    this.enabled = !this.enabled;\n    return this.enabled;\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { AudioManager };\n","structuredPatch":[{"oldStart":27,"oldLines":6,"newStart":27,"newLines":7,"lines":["   _ensure() {","     if (!this._initialized) this.init();","     this.resume();","+    return this._initialized;","   }"," ","   _tone(freq, dur, type = 'sine', vol = null) {"]}],"userModified":false,"replaceAll":false}}
