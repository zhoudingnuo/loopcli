= this.boss.takeDamage(dmg);\n          this.audio.playBossHit();\n          if (defeated) {\n            this.audio.playBossDefeat();\n            this.scoreSystem.addScore(500);\n          }\n        }\n      }\n\n      const drops = this.board.applyGravity();","numLines":60,"startLine":480,"totalLines":671}}}
