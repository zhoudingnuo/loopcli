is.phase = getPhaseFromTime(this.timeOfDay);\n48\t  }\n49\t\n50\t  setDay(d: number): void {"}]},"parent_tool_use_id":null,"session_id":"d0384c8e-0462-4f8e-9470-2647774e089a","uuid":"6a00051a-3165-448d-a92e-51e9bdad8b0e","timestamp":"2026-05-23T05:12:47.588Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-horror-sim\\src\\game\\DayCycle.ts","content":"// DayCycle.ts — Full day loop management with phase transitions (M3)\n\nimport { GamePhase, getPhaseFromTime } from './GameState';\n\nexport interface DayPhaseConfig {\n  phase: GamePhase;\n  startHour: number;\n  endHour: number;\n  label: string;\n  timeSpeed: number;\n}\n\nexport const DAY_PHASES: DayPhaseConfig[] = [\n  { phase: GamePhase.DAYTIME, startHour: 6, endHour: 22, label: '营业中', timeSpeed: 10 },\n  { phase: GamePhase.NIGHT_TRANSITION, startHour: 22, endHour: 23, label: '准备打烊', timeSpeed: 5 },\n  { phase: GamePhase.NIGHT, startHour: 23, endHour: 26, label: '深夜营业', timeSpeed: 5 },\n  { phase: GamePhase.DANGER, startHour: 26, endHour: 29, label: '危险时段', timeSpeed: 5 },\n  { phase: GamePhase.DAWN, startHour: 29, endHour: 30, label: '黎明', timeSpeed: 5 },\n];\n\nexport type PhaseChangeListener = (phase: GamePhase, prevPhase: GamePhase, day: number, timeOfDay: number) => void;\nexport type NewDayListener = (day: number) => void;\n\nexport class DayCycle {\n  private day: number = 1;\n  private timeOfDay: number = 6;\n  private baseTimeSpeed: number = 10;\n  private phase: GamePhase = GamePhase.DAYTIME;\n  private phaseListeners: PhaseChangeListener[] = [];\n  private newDayListeners: NewDayListener[] = [];\n  private paused = false;\n\n  get currentDay(): number { return this.day; }\n  get currentTime(): number { return this.timeOfDay; }\n  get currentPhase(): GamePhase { return this.phase; }\n\n  onPhaseChange(listener: PhaseChangeListener): void {\n    this.phaseListeners.push(listener);\n  }\n\n  onNewDay(listener: NewDayListener): void {\n    this.newDayListeners.push(listener);\n  }\n\n  setTimeOfDay(t: number): void {\n    this.timeOfDay = t;\n    this.phase = getPhaseFromTime(this.timeOfDay);\n  }\n\n  setDay(d: number): void {","numLines":50,"startLine":1,"totalLines":110}}}
