or && cur.color !== EMPTY) {\n          continue;\n        }\n        const len = c - start;\n        if (len >= 3 && prev && prev.color !== EMPTY) {\n          const cells = [];\n          for (let k = start; k < c; k++) cells.push({ row: r, col: k });\n          matches.push({ cells, length: len, direction: 'horizontal', color: prev.color });\n        }\n        start = c;\n      }\n    }\n\n    // Vertical scan\n    for (let c = 0; c < this.size; c++) {\n      let start = 0;\n      for (let r = 1; r <= this.size; r++) {\n        const cur = r < this.size ? this.grid[r][c] : null;\n        const prev = this.grid[start][c];\n        if (r < this.size && cur && prev && cur.color === prev.color && cur.color !== EMPTY) {\n          continue;\n        }\n        const len = r - start;\n        if (len >= 3 && prev && prev.color !== EMPTY) {\n          const cells = [];\n          for (let k = start; k < r; k++) cells.push({ row: k, col: c });\n          matches.push({ cells, length: len, direction: 'vertical', color: prev.color });\n        }\n        start = r;\n      }\n    }\n\n    return matches;\n  }\n\n  // Detect L/T shape matches by finding intersections of horizontal and vertical matches\n  findLShapeMatches(matches) {\n    const lShapes = [];\n    for (let i = 0; i < matches.length; i++) {\n      for (let j = i + 1; j < matches.length; j++) {\n        const a = matches[i], b = matches[j];\n        if (a.direction === b.direction) continue;\n        if (a.color !== b.color) continue;\n        // Find intersection\n        const setA = new Set(a.cells.map(c => `${c.row},${c.col}`));\n        for (const cell of b.cells) {\n          if (setA.has(`${cell.row},${cell.col}`)) {\n            // L/T shape found — merge all cells\n            const allCellsMap = {};\n            for (const c of a.cells) allCellsMap[`${c.row},${c.col}`] = c;\n            for (const c of b.cells) allCellsMap[`${c.row},${c.col}`] = c;\n            const allCells = Object.values(allCellsMap);\n            lShapes.push({ cells: allCells, color: a.color });\n          }\n        }\n      }\n    }\n    return lShapes;\n  }\n\n  // Apply gravity: move tiles down to fill empty cells\n  applyGravity() {\n    const drops = [];\n    for (let c = 0; c < this.size; c++) {\n      let writeRow = this.size - 1;\n      for (let r = this.size - 1; r >= 0; r--) {\n        if (this.grid[r][c] !== null) {\n          if (r !== writeRow) {\n            const tile = this.grid[r][c];\n            const fromRow = r;\n            this.grid[r][c] = null;\n            this.grid[writeRow][c] = tile;\n            const distance = writeRow - fromRow;\n            tile.row = writeRow;\n            drops.push({ tile, fromRow, toRow: writeRow, col: c, distance });\n          }\n          writeRow--;\n        }\n      }\n      // Fill empty top cells\n      for (let r = writeRow; r >= 0; r--) {\n        const tile = this._createTile(r, c);\n        tile.offsetY = -(writeRow - r + 1); // start above board\n        this.grid[r][c] = tile;\n        drops.push({ tile, fromRow: -(writeRow - r + 1), toRow: r, col: c, distance: r + (writeRow - r + 1) });\n      }\n    }\n    return drops;\n  }\n\n  // Check if any valid move exists (for deadlock detection)\n  hasValidMoves() {\n    for (let r = 0; r < this.size; r++) {\n      for (let c = 0; c < this.size; c++) {\n        // Try swap right\n        if (c + 1 < this.size) {\n          this.swap(r, c, r, c + 1);\n          const has = this.findAllMatches().length > 0;\n          this.swap(r, c, r, c + 1);\n          if (has) return true;\n        }\n        // Try swap down\n        if (r + 1 < this.size) {\n          this.swap(r, c, r + 1, c);\n          const has = this.findAllMatches().length > 0;\n          this.swap(r, c, r + 1, c);\n          if (has) return true;\n        }\n      }\n    }\n    return false;\n  }\n\n  // Shuffle board if no valid moves\n  shuffle() {\n    const tiles = [];\n    for (let r = 0; r < this.size; r++) {\n      for (let c = 0; c < this.size; c++) {\n        tiles.push(this.grid[r][c].color);\n      }\n    }\n    // Fisher-Yates shuffle\n    for (let i = tiles.length - 1; i > 0; i--) {\n      const j = Math.floor(Math.random() * (i + 1));\n      [tiles[i], tiles[j]] = [tiles[j], tiles[i]];\n    }\n    let idx = 0;\n    for (let r = 0; r < this.size; r++) {\n      for (let c = 0; c < this.size; c++) {\n        this.grid[r][c].color = tiles[idx++];\n      }\n    }\n    // Remove any initial matches from shuffle\n    this._removeInitialMatches();\n    // If still no valid moves, re-init\n    if (!this.hasValidMoves()) {\n      this.init();\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Board, Tile, BOARD_SIZE, TILE_COLORS, SPECIAL_NONE, SPECIAL_STRIPED_H, SPECIAL_STRIPED_V, SPECIAL_BOMB, SPECIAL_RAINBOW, COLOR_MAP };\n","structuredPatch":[{"oldStart":225,"oldLines":18,"newStart":225,"newLines":27,"lines":["   }"," ","   // Check if any valid move exists (for deadlock detection)","-  hasValidMoves() {","+  // obstacleMgr is optional — if provided, skip chained/blocked cells","+  hasValidMoves(obstacleMgr) {","     for (let r = 0; r < this.size; r++) {","       for (let c = 0; c < this.size; c++) {","+        if (!this.grid[r][c]) continue;","+        // Skip if tile is chained or cell is blocked","+        if (obstacleMgr) {","+          if (obstacleMgr.isCellBlocked(r, c)) continue;","+          if (!obstacleMgr.canSwap(r, c)) continue;","+        }","         // Try swap right","-        if (c + 1 < this.size) {","+        if (c + 1 < this.size && this.grid[r][c + 1]) {","+          if (obstacleMgr && !obstacleMgr.canSwap(r, c + 1)) continue;","           this.swap(r, c, r, c + 1);","           const has = this.findAllMatches().length > 0;","           this.swap(r, c, r, c + 1);","           if (has) return true;","         }","         // Try swap down","-        if (r + 1 < this.size) {","+        if (r + 1 < this.size && this.grid[r + 1][c]) 