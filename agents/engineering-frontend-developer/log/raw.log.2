{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_976b51cf805e4d8ab55f851b","type":"tool_result","content":"1\t// Inventory.ts — Inventory and pill management system (v0.4.0)\n2\t\n3\texport interface PillDef {\n4\t  id: string;\n5\t  name: string;\n6\t  nameEn: string;\n7\t  description: string;\n8\t  effect: string;\n9\t  cultivationAmount: number;\n10\t  grade: string;\n11\t  color: string;\n12\t}\n13\t\n14\tconst PILL_DEFS: Record<string, PillDef> = {\n15\t  pill_juling: {\n16\t    id: 'pill_juling',\n17\t    name: '聚灵丹',\n18\t    nameEn: 'Spirit Gathering Pill',\n19\t    description: '基础修炼丹药',\n20\t    effect: '服用获得修为+10',\n21\t    cultivationAmount: 10,\n22\t    grade: '下品',\n23\t    color: '#ff8c32',\n24\t  },\n25\t  pill_peiyuan: {\n26\t    id: 'pill_peiyuan',\n27\t    name: '培元丹',\n28\t    nameEn: 'Foundation Pill',\n29\t    description: '培元固本的丹药',\n30\t    effect: '服用获得修为+30',\n31\t    cultivationAmount: 30,\n32\t    grade: '下品',\n33\t    color: '#ff6699',\n34\t  },\n35\t  pill_ningqi: {\n36\t    id: 'pill_ningqi',\n37\t    name: '凝气丹',\n38\t    nameEn: 'Qi Condensing Pill',\n39\t    description: '凝练灵气的高级丹药',\n40\t    effect: '服用获得修为+50',\n41\t    cultivationAmount: 50,\n42\t    grade: '下品',\n43\t    color: '#cc66ff',\n44\t  },\n45\t  pill_zhuji: {\n46\t    id: 'pill_zhuji',\n47\t    name: '筑基丹',\n48\t    nameEn: 'Foundation Pill',\n49\t    description: '筑基必备丹药',\n50\t    effect: '服用获得修为+100',\n51\t    cultivationAmount: 100,\n52\t    grade: '中品',\n53\t    color: '#ffcc00',\n54\t  },\n55\t  pill_jindanyin: {\n56\t    id: 'pill_jindanyin',\n57\t    name: '金丹引',\n58\t    nameEn: 'Golden Core Catalyst',\n59\t    description: '金丹期必备丹药',\n60\t    effect: '服用获得修为+500',\n61\t    cultivationAmount: 500,\n62\t    grade: '中品',\n63\t    color: '#ff4444',\n64\t  },\n65\t  pill_yuanyingguo: {\n66\t    id: 'pill_yuanyingguo',\n67\t    name: '元婴果',\n68\t    nameEn: 'Nascent Soul Fruit',\n69\t    description: '元婴期上品丹药',\n70\t    effect: '服用获得修为+2000',\n71\t    cultivationAmount: 2000,\n72\t    grade: '上品',\n73\t    color: '#b450ff',\n74\t  },\n75\t  pill_huashenlu: {\n76\t    id: 'pill_huashenlu',\n77\t    name: '化神露',\n78\t    nameEn: 'Spirit Severing Dew',\n79\t    description: '化神期上品丹药',\n80\t    effect: '服用获得修为+10000',\n81\t    cultivationAmount: 10000,\n82\t    grade: '上品',\n83\t    color: '#ff96ff',\n84\t  },\n85\t  pill_jiuzhuan: {\n86\t    id: 'pill_jiuzhuan',\n87\t    name: '九转金丹',\n88\t    nameEn: 'Nine-Turn Golden Pill',\n89\t    description: '飞升极品丹药',\n90\t    effect: '服用获得修为+100000',\n91\t    cultivationAmount: 100000,\n92\t    grade: '极品',\n93\t    color: '#ffc832',\n94\t  },\n95\t};\n96\t\n97\texport function getPillDef(id: string): PillDef | undefined {\n98\t  return PILL_DEFS[id];\n99\t}\n100\t\n101\texport function getAllPillDefs(): PillDef[] {\n102\t  return Object.values(PILL_DEFS);\n103\t}\n104\t\n105\texport function getInventoryPills(resources: Record<string, number>): Array<PillDef & { count: number }> {\n106\t  const result: Array<PillDef & { count: number }> = [];\n107\t  for (const [id, def] of Object.entries(PILL_DEFS)) {\n108\t    const count = resources[id] ?? 0;\n109\t    if (count > 0) {\n110\t      result.push({ ...def, count });\n111\t    }\n112\t  }\n113\t  return result;\n114\t}\n115\t\n116\texport function usePill(\n117\t  pillId: string,\n118\t  resources: Record<string, number>,\n119\t): { cultivation: number; resources: Record<string, number> } | null {\n120\t  const def = PILL_DEFS[pillId];\n121\t  if (!def) return null;\n122\t\n123\t  const count = resources[pillId] ?? 0;\n124\t  if (count <= 0) return null;\n125\t\n126\t  const newResources = { ...resources };\n127\t  newResources[pillId] = count - 1;\n128\t\n129\t  return {\n130\t    cultivation: def.cultivationAmount,\n131\t    resources: newResources,\n132\t  };\n133\t}\n134\t\n135\texport function useMultiplePills(\n136\t  pillId: string,\n137\t  amount: number,\n138\t  resources: Record<string, number>,\n139\t): { cultivation: number; resources: Record<string, number>; used: number } | null {\n140\t  const def = PILL_DEFS[pillId];\n141\t  if (!def) return null;\n142\t\n143\t  const count = resources[pillId] ?? 0;\n144\t  const toUse = Math.min(count, amount);\n145\t  if (toUse <= 0) return null;\n146\t\n147\t  const newResources = { ...resources };\n148\t  newResources[pillId] = count - toUse;\n149\t\n150\t  return {\n151\t    cultivation: def.cultivationAmount * toUse,\n152\t    resources: newResources,\n153\t    used: toUse,\n154\t  };\n155\t}\n156\t"}]},"parent_tool_use_id":null,"session_id":"094f9230-fe12-4466-ab83-fdd0d233a191","uuid":"72f3e495-feda-4500-bcd4-ed9344b00f83","timestamp":"2026-05-23T02:54:59.348Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/steam-cultivation-factory/src/game/Inventory.ts","content":"// Inventory.ts — Inventory and pill management system (v0.4.0)\n\nexport interface PillDef {\n  id: string;\n  name: string;\n  nameEn: string;\n  description: string;\n  effect: string;\n  cultivationAmount: number;\n  grade: string;\n  color: string;\n}\n\nconst PILL_DEFS: Record<string, PillDef> = {\n  pill_juling: {\n    id: 'pill_juling',\n    name: '聚灵丹',\n    nameEn: 'Spirit Gathering Pill',\n    description: '基础修炼丹药',\n    effect: '服用获得修为+10',\n    cultivationAmount: 10,\n    grade: '下品',\n    color: '#ff8c32',\n  },\n  pill_peiyuan: {\n    id: 'pill_peiyuan',\n    name: '培元丹',\n    nameEn: 'Foundation Pill',\n    description: '培元固本的丹药',\n    effect: '服用获得修为+30',\n    cultivationAmount: 30,\n    grade: '下品',\n    color: '#ff6699',\n  },\n  pill_ningqi: {\n    id: 'pill_ningqi',\n    name: '凝气丹',\n    nameEn: 'Qi Condensing Pill',\n    description: '凝练灵气的高级丹药',\n    effect: '服用获得修为+50',\n    cultivationAmount: 50,\n    grade: '下品',\n    color: '#cc66ff',\n  },\n  pill_zhuji: {\n    id: 'pill_zhuji',\n    name: '筑基丹',\n    nameEn: 'Foundation Pill',\n    description: '筑基必备丹药',\n    effect: '服用获得修为+100',\n    cultivationAmount: 100,\n    grade: '中品',\n    color: '#ffcc00',\n  },\n  pill_jindanyin: {\n    id: 'pill_jindanyin',\n    name: '金丹引',\n    nameEn: 'Golden Core Catalyst',\n    description: '金丹期必备丹药',\n    effect: '服用获得修为+500',\n    cultivationAmount: 500,\n    grade: '中品',\n    color: '#ff4444',\n  },\n  pill_yuanyingguo: {\n    id: 'pill_yuanyingguo',\n    name: '元婴果',\n    nameEn: 'Nascent Soul Fruit',\n    description: '元婴期上品丹药',\n    effect: '服用获得修为+2000',\n    cultivationAmount: 2000,\n    grade: '上品',\n    color: '#b450ff',\n  },\n  pill_huashenlu: {\n    id: 'pill_huashenlu',\n    name: '化神露',\n    nameEn: 'Spirit Severing Dew',\n    description: '化神期上品丹药',\n    effect: '服用获得修为+10000',\n    cultivationAmount: 10000,\n    grade: '上品',\n    color: '#ff96ff',\n  },\n  pill_jiuzhuan: {\n    id: 'pill_jiuzhuan',\n    name: '九转金丹',\n    nameEn: 'Nine-Turn Golden Pill',\n    description: '飞升极品丹药',\n    effect: '服用获得修为+100000',\n    cultivationAmount: 100000,\n    grade: '极品',\n    color: '#ffc832',\n  },\n};\n\nexport function getPillDef(id: string): PillDef | undefined {\n  return PILL_DEFS[id];\n}\n\nexport function getAllPillDefs(): PillDef[] {\n  return Object.values(PILL_DEFS);\n}\n\nexport function getInventoryPills(resources: Record<string, number>): Array<PillDef & { count: number }> {\n  const result: Array<PillDef & { count: number }> = [];\n  for (const [id, def] of Object.entries(PILL_DEFS)) {\n    const count = resources[id] ?? 0;\n    if (count > 0) {\n      result.push({ ...def, count });\n    }\n  }\n  return result;\n}\n\nexport function usePill(\n  pillId: string,\n  resources: Record<string, number>,\n): { cultivation: number; resources: Record<string, number> } | null {\n  const def = PILL_DEFS[pillId];\n  if (!def) return null;\n\n  const count = resources[pillId] ?? 0;\n  if (count <= 0) return null;\n\n  const newResources = { ...resources };\n  newResources[pillId] = count - 1;\n\n  return {\n    cultivation: def.cultivationAmount,\n    resources: newResources,\n  };\n}\n\nexport function useMultiplePills(\n  pillId: string,\n  amount: number,\n  resources: Record<string, number>,\n): { cultivation: number; resources: Record<string, number>; used: number } | null {\n  const def = PILL_DEFS[pillId];\n  if (!def) return null;\n\n  const count = resources[pillId] ?? 0;\n  const toUse = Math.min(count, amount);\n  if (toUse <= 0) return null;\n\n  const newResources = { ...resources };\n  newResources[pillId] = count - toUse;\n\n  return {\n    cultivation: def.cultivationAmount * toUse,\n    resources: newResources,\n    used: toUse,\n  };\n}\n","numLines":156,"startLine":1,"totalLines":156}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_95412e72d66b462c8dd56653","type":"tool_result","content":"1\t// GameState.ts — Immutable game state with save/load interface (v0.4.0)\n2\t\n3\timport { type CultivationState, createInitialCultivationState, migrateFromOldRealm } from './Cultivation';\n4\t\n5\texport interface Resources {\n6\t  [key: string]: number;\n7\t  spirit_stone: number;\n8\t  spirit_grass: number;\n9\t  spirit_energy: number;\n10\t  cultivation: number;\n11\t  pill_juling: number;\n12\t  pill_peiyuan: number;\n13\t  pill_ningqi: number;\n14\t  pill_zhuji: number;\n15\t  pill_jindanyin: number;\n16\t  pill_yuanyingguo: number;\n17\t  pill_huashenlu: number;\n18\t  pill_jiuzhuan: number;\n19\t  spirit_iron: number;\n20\t  spirit_wood: number;\n21\t  talisman_paper: number;\n22\t  monster_core: number;\n23\t  heaven_earth_liquid: number;\n24\t  immortal_stone: number;\n25\t  merit: number;\n26\t}\n27\t\n28\texport interface BuildingInstance {\n29\t  uid: string;\n30\t  buildingId: string;\n31\t  gridX: number;\n32\t  gridY: number;\n33\t  level: number;\n34\t  lastCollectTime: number;\n35\t  isProducing: boolean;\n36\t  progress: number;\n37\t}\n38\t\n39\texport interface RealmProgress {\n40\t  realmId: string;\n41\t  level: number;\n42\t  exp: number;\n43\t  expToNext: number;\n44\t}\n45\t\n46\texport interface AlchemySessionData {\n47\t  recipeId: string;\n48\t  startTime: number;\n49\t  progress: number;\n50\t  complete: boolean;\n51\t}\n52\t\n53\texport interface GameMap {\n54\t  regionId: string;\n55\t  width: number;\n56\t  height: number;\n57\t  terrain: number[];\n58\t  buildings: BuildingInstance[];\n59\t}\n60\t\n61\texport interface GameState {\n62\t  resources: Resources;\n63\t  realm: RealmProgress;\n64\t  cultivation: CultivationState;\n65\t  alchemySession: AlchemySessionData | null;\n66\t  maps: GameMap[];\n67\t  currentRegionIndex: number;\n68\t  totalPlaytime: number;\n69\t  lastSaveTime: number;\n70\t  lastOnlineTime: number;\n71\t  version: string;\n72\t  achievements: string[];\n73\t  ascensionCompleted: boolean;\n74\t  crossRegionLinks: CrossRegionLink[];\n75\t}\n76\t\n77\texport interface CrossRegionLink {\n78\t  id: string;\n79\t  fromRegionIndex: number;\n80\t  fromX: number;\n81\t  fromY: number;\n82\t  toRegionIndex: number;\n83\t  toX: number;\n84\t  toY: number;\n85\t  resource: string;\n86\t  amount: number;\n87\t  interval: number;\n88\t  lastTransfer: number;\n89\t}\n90\t\n91\texport interface SaveData {\n92\t  version: string;\n93\t  timestamp: number;\n94\t  playtime: number;\n95\t  gameState: GameState;\n96\t}\n97\t\n98\tconst SAVE_KEY = 'cultivation_factory_save';\n99\tconst CURRENT_VERSION = '0.4.0';\n100\t\n101\tfunction initialResources(): Resources {\n102\t  return {\n103\t    spirit_stone: 0,\n104\t    spirit_grass: 0,\n105\t    spirit_energy: 0,\n106\t    cultivation: 0,\n107\t    pill_juling: 0,\n108\t    pill_peiyuan: 0,\n109\t    pill_ningqi: 0,\n110\t    pill_zhuji: 0,\n111\t    pill_jindanyin: 0,\n112\t    pill_yuanyingguo: 0,\n113\t    pill_huashenlu: 0,\n114\t    pill_jiuzhuan: 0,\n115\t    spirit_iron: 0,\n116\t    spirit_wood: 0,\n117\t    talisman_paper: 0,\n118\t    monster_core: 0,\n119\t    heaven_earth_liquid: 0,\n120\t    immortal_stone: 0,\n121\t    merit: 0,\n122\t  };\n123\t}\n124\t\n125\tfunction initialRealm(): RealmProgress {\n126\t  return {\n127\t    realmId: 'liqi',\n128\t    level: 1,\n129\t    exp: 0,\n130\t    expToNext: 100,\n131\t  };\n132\t}\n133\t\n134\texport function createInitialState(): GameState {\n135\t  return {\n136\t    resources: initialResources(),\n137\t    realm: initialRealm(),\n138\t    cultivation: createInitialCultivationState(),\n139\t    alchemySession: null,\n140\t    maps: [],\n141\t    currentRegionIndex: 0,\n142\t    totalPlaytime: 0,\n143\t    lastSaveTime: Date.now(),\n144\t    lastOnlineTime: Date.now(),\n145\t    version: CURRENT_VERSION,\n146\t    achievements: [],\n147\t    ascensionCompleted: false,\n148\t    crossRegionLinks: [],\n149\t  };\n150\t}\n151\t\n152\texport function cloneState(state: GameState): GameState {\n153\t  return JSON.parse(JSON.stringify(state));\n154\t}\n155\t\n156\texport function addResources(state: GameState, delta: Partial<Resources>): GameState {\n157\t  const next = cloneState(state);\n158\t  for (const key of Object.keys(delta) as (keyof Resources)[]) {\n159\t    next.resources[key] = Math.max(0, next.resources[key] + (delta[key] ?? 0));\n160\t  }\n161\t  return next;\n162\t}\n163\t\n164\texport function addCultivation(state: GameState, amount: number): GameState {\n165\t  const next = cloneState(state);\n166\t  next.realm.exp += amount;\n167\t  while (next.realm.exp >= next.realm.expToNext) {\n168\t    next.realm.exp -= next.realm.expToNext;\n169\t    next.realm.level += 1;\n170\t    next.realm.expToNext = Math.floor(next.realm.expToNext * 1.8);\n171\t  }\n172\t  return next;\n173\t}\n174\t\n175\texport function placeBuilding(state: GameState, mapIndex: number, building: BuildingInstance): GameState {\n176\t  const next = cloneState(state);\n177\t  next.maps[mapIndex].buildings.push(building);\n178\t  return next;\n179\t}\n180\t\n181\texport function removeBuilding(state: GameState, mapIndex: number, buildingUid: string): GameState {\n182\t  const next = cloneState(state);\n183\t  const map = next.maps[mapIndex];\n184\t  map.buildings = map.buildings.filter(b => b.uid !== buildingUid);\n185\t  return next;\n186\t}\n187\t\n188\texport function updateBuilding(\n189\t  state: GameState,\n190\t  mapIndex: number,\n191\t  buildingUid: string,\n192\t  patch: Partial<BuildingInstance>,\n193\t): GameState {\n194\t  const next = cloneState(state);\n195\t  const building = next.maps[mapIndex].buildings.find(b => b.uid === buildingUid);\n196\t  if (building) {\n197\t    Object.assign(building, patch);\n198\t  }\n199\t  return next;\n200\t}\n201\t\n202\texport function setMap(state: GameState, index: number, map: GameMap): GameState {\n203\t  const next = cloneState(state);\n204\t  next.maps[index] = map;\n205\t  return next;\n206\t}\n207\t\n208\texport function addAchievement(state: GameState, achievementId: string): GameState {\n209\t  if (state.achievements.includes(achievementId)) return state;\n210\t  const next = cloneState(state);\n211\t  next.achievements.push(achievementId);\n212\t  return next;\n213\t}\n214\t\n215\texport function addCrossRegionLink(state: GameState, link: CrossRegionLink): GameState {\n216\t  const next = cloneState(state);\n217\t  next.crossRegionLinks.push(link);\n218\t  return next;\n219\t}\n220\t\n221\texport function removeCrossRegionLink(state: GameState, linkId: string): GameState {\n222\t  const next = cloneState(state);\n223\t  next.crossRegionLinks = next.crossRegionLinks.filter(l => l.id !== linkId);\n224\t  return next;\n225\t}\n226\t\n227\texport function saveGame(state: GameState): void {\n228\t  const data: SaveData = {\n229\t    version: CURRENT_VERSION,\n230\t    timestamp: Date.now(),\n231\t    playtime: state.totalPlaytime,\n232\t    gameState: state,\n233\t  };\n234\t  try {\n235\t    localStorage.setItem(SAVE_KEY, JSON.stringify(data));\n236\t  } catch {\n237\t    console.warn('Save failed: storage quota exceeded');\n238\t  }\n239\t}\n240\t\n241\texport function loadGame(): GameState | null {\n242\t  try {\n243\t    const raw = localStorage.getItem(SAVE_KEY);\n244\t    if (!raw) return null;\n245\t    const data: SaveData = JSON.parse(raw);\n246\t    const state = data.gameState ?? null;\n247\t\n248\t    // Migration: add cultivation (v0.2.0)\n249\t    if (state && !state.cultivation) {\n250\t      state.cultivation = state.realm\n251\t        ? migrateFromOldRealm(state.realm)\n252\t        : createInitialCultivationState();\n253\t    }\n254\t    if (state && !state.alchemySession) {\n255\t      state.alchemySession = null;\n256\t    }\n257\t    // Add new resource fields progressively\n258\t    if (state) {\n259\t      const res = state.resources as Record<string, number>;\n260\t      if (res.pill_peiyuan === undefined) res.pill_peiyuan = 0;\n261\t      if (res.pill_ningqi === undefined) res.pill_ningqi = 0;\n262\t      if (res.pill_zhuji === undefined) res.pill_zhuji = 0;\n263\t      if (res.pill_jindanyin === undefined) res.pill_jindanyin = 0;\n264\t      if (res.spirit_wood === undefined) res.spirit_wood = 0;\n265\t      if (res.talisman_paper === undefined) res.talisman_paper = 0;\n266\t      // v0.4.0 new resources\n267\t      if (res.pill_yuanyingguo === undefined) res.pill_yuanyingguo = 0;\n268\t      if (res.pill_huashenlu === undefined) res.pill_huashenlu = 0;\n269\t      if (res.pill_jiuzhuan === undefined) res.pill_jiuzhuran = 0;\n270\t      if (res.monster_core === undefined) res.monster_core = 0;\n271\t      if (res.heaven_earth_liquid === undefined) res.heaven_earth_liquid = 0;\n272\t      if (res.immortal_stone === undefined) res.immortal_stone = 0;\n273\t      if (res.merit === undefined) res.merit = 0;\n274\t      // Fix potential typo from migration\n275\t      if (res.pill_jiuzhuran !== undefined) {\n276\t        res.pill_jiuzhuan = res.pill_jiuzhuran;\n277\t        delete res.pill_jiuzhuran;\n278\t      }\n279\t    }\n280\t    // v0.4.0 new fields\n281\t    if (state) {\n282\t      if (!state.achievements) state.achievements = [];\n283\t      if (state.ascensionCompleted === undefined) state.ascensionCompleted = false;\n284\t      if (!state.crossRegionLinks) state.crossRegionLinks = [];\n285\t    }\n286\t\n287\t    return state;\n288\t  } catch {\n289\t    return null;\n290\t  }\n291\t}\n292\t\n293\texport function clearSave(): void {\n294\t  localStorage.removeItem(SAVE_KEY);\n295\t}\n296\t\n297\tlet autoSaveTimer = 0;\n298\t\n299\texport function startAutoSave(getState: () => GameState, intervalMs: number = 300000): void {\n300\t  stopAutoSave();\n301\t  autoSaveTimer = window.setInterval(() => {\n302\t    saveGame(getState());\n303\t  }, intervalMs);\n304\t}\n305\t\n306\texport function stopAutoSave(): void {\n307\t  if (autoSaveTimer) {\n308\t    clearInterval(autoSaveTimer);\n309\t    autoSaveTimer = 0;\n310\t  }\n311\t}\n312\t"}]},"parent_tool_use_id":null,"session_id":"094f9230-fe12-4466-ab83-fdd0d233a191","uuid":"5688d8a5-29cf-4ec5-b342-7f895bb0e62b","timestamp":"2026-05-23T02:54:59.575Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/steam-cultivation-factory/src/game/GameState.ts","content":"// GameState.ts — Immutable game state with save/load interface (v0.4.0)\n\nimport { type CultivationState, createInitialCultivationState, migrateFromOldRealm } from './Cultivation';\n\nexport interface Resources {\n  [key: string]: number;\n  spirit_stone: number;\n  spirit_grass: number;\n  spirit_energy: number;\n  cultivation: number;\n  pill_juling: number;\n  pill_peiyuan: number;\n  pill_ningqi: number;\n  pill_zhuji: number;\n  pill_jindanyin: number;\n  pill_yuanyingguo: number;\n  pill_huashenlu: number;\n  pill_jiuzhuan: number;\n  spirit_iron: number;\n  spirit_wood: number;\n  talisman_paper: number;\n  monster_core: number;\n  heaven_earth_liquid: number;\n  immortal_stone: number;\n  merit: number;\n}\n\nexport interface BuildingInstance {\n  uid: string;\n  buildingId: string;\n  gridX: number;\n  gridY: number;\n  level: number;\n  lastCollectTime: number;\n  isProducing: boolean;\n  progress: number;\n}\n\nexport interface RealmProgress {\n  realmId: string;\n  level: number;\n  exp: number;\n  expToNext: number;\n}\n\nexport interface AlchemySessionData {\n  recipeId: string;\n  startTime: number;\n  progress: number;\n  complete: boolean;\n}\n\nexport interface GameMap {\n  regionId: string;\n  width: number;\n  height: number;\n  terrain: number[];\n  buildings: BuildingInstance[];\n}\n\nexport interface GameState {\n  resources: Resources;\n  realm: RealmProgress;\n  cultivation: CultivationState;\n  alchemySession: AlchemySessionData | null;\n  maps: GameMap[];\n  currentRegionIndex: number;\n  totalPlaytime: number;\n  lastSaveTime: number;\n  lastOnlineTime: number;\n  version: string;\n  achievements: string[];\n  ascensionCompleted: boolean;\n  crossRegionLinks: CrossRegionLink[];\n}\n\nexport interface CrossRegionLink {\n  id: string;\n  fromRegionIndex: number;\n  fromX: number;\n  fromY: number;\n  toRegionIndex: number;\n  toX: number;\n  toY: number;\n  resource: string;\n  amount: number;\n  interval: number;\n  lastTransfer: number;\n}\n\nexport interface SaveData {\n  version: string;\n  timestamp: number;\n  playtime: number;\n  gameState: GameState;\n}\n\nconst SAVE_KEY = 'cultivation_factory_save';\nconst CURRENT_VERSION = '0.4.0';\n\nfunction initialResources(): Resources {\n  return {\n    spirit_stone: 0,\n    spirit_grass: 0,\n    spirit_energy: 0,\n    cultivation: 0,\n    pill_juling: 0,\n    pill_peiyuan: 0,\n    pill_ningqi: 0,\n    pill_zhuji: 0,\n    pill_jindanyin: 0,\n    pill_yuanyingguo: 0,\n    pill_huashenlu: 0,\n    pill_jiuzhuan: 0,\n    spirit_iron: 0,\n    spirit_wood: 0,\n    talisman_paper: 0,\n    monster_core: 0,\n    heaven_earth_liquid: 0,\n    immortal_stone: 0,\n    merit: 0,\n  };\n}\n\nfunction initialRealm(): RealmProgress {\n  return {\n    realmId: 'liqi',\n    level: 1,\n    exp: 0,\n    expToNext: 100,\n  };\n}\n\nexport function createInitialState(): GameState {\n  return {\n    resources: initialResources(),\n    realm: initialRealm(),\n    cultivation: createInitialCultivationState(),\n    alchemySession: null,\n    maps: [],\n    currentRegionIndex: 0,\n    totalPlaytime: 0,\n    lastSaveTime: Date.now(),\n    lastOnlineTime: Date.now(),\n    version: CURRENT_VERSION,\n    achievements: [],\n    ascensionCompleted: false,\n    crossRegionLinks: [],\n  };\n}\n\nexport function cloneState(state: GameState): GameState {\n  return JSON.parse(JSON.stringify(state));\n}\n\nexport function addResources(state: GameState, delta: Partial<Resources>): GameState {\n  const next = cloneState(state);\n  for (const key of Object.keys(delta) as (keyof Resources)[]) {\n    next.resources[key] = Math.max(0, next.resources[key] + (delta[key] ?? 0));\n  }\n  return next;\n}\n\nexport function addCultivation(state: GameState, amount: number): GameState {\n  const next = cloneState(state);\n  next.realm.exp += amount;\n  while (next.realm.exp >= next.realm.expToNext) {\n    next.realm.exp -= next.realm.expToNext;\n    next.realm.level += 1;\n    next.realm.expToNext = Math.floor(next.realm.expToNext * 1.8);\n  }\n  return next;\n}\n\nexport function placeBuilding(state: GameState, mapIndex: number, building: BuildingInstance): GameState {\n  const next = cloneState(state);\n  next.maps[mapIndex].buildings.push(building);\n  return next;\n}\n\nexport function removeBuilding(state: GameState, mapIndex: number, buildingUid: string): GameState {\n  const next = cloneState(state);\n  const map = next.maps[mapIndex];\n  map.buildings = map.buildings.filter(b => b.uid !== buildingUid);\n  return next;\n}\n\nexport function updateBuilding(\n  state: GameState,\n  mapIndex: number,\n  buildingUid: string,\n  patch: Partial<BuildingInstance>,\n): GameState {\n  const next = cloneState(state);\n  const building = next.maps[mapIndex].buildings.find(b => b.uid === buildingUid);\n  if (building) {\n    Object.assign(building, patch);\n  }\n  return next;\n}\n\nexport function setMap(state: GameState, index: number, map: GameMap): GameState {\n  const next = cloneState(state);\n  next.maps[index] = map;\n  return next;\n}\n\nexport function addAchievement(state: GameState, achievementId: string): GameState {\n  if (state.achievements.includes(achievementId)) return state;\n  const next = cloneState(state);\n  next.achievements.push(achievementId);\n  return next;\n}\n\nexport function addCrossRegionLink(state: GameState, link: CrossRegionLink): GameState {\n  const next = cloneState(state);\n  next.crossRegionLinks.push(link);\n  return next;\n}\n\nexport function removeCrossRegionLink(state: GameState, linkId: string): GameState {\n  const next = cloneState(state);\n  next.crossRegionLinks = next.crossRegionLinks.filter(l => l.id !== linkId);\n  return next;\n}\n\nexport function saveGame(state: GameState): void {\n  const data: SaveData = {\n    version: CURRENT_VERSION,\n    timestamp: Date.now(),\n    playtime: state.totalPlaytime,\n    gameState: state,\n  };\n  try {\n    localStorage.setItem(SAVE_KEY, JSON.stringify(data));\n  } catch {\n    console.warn('Save failed: storage quota exceeded');\n  }\n}\n\nexport function loadGame(): GameState | null {\n  try {\n    const raw = localStorage.getItem(SAVE_KEY);\n    if (!raw) return null;\n    const data: SaveData = JSON.parse(raw);\n    const state = data.gameState ?? null;\n\n    // Migration: add cultivation (v0.2.0)\n    if (state && !state.cultivation) {\n      state.cultivation = state.realm\n        ? migrateFromOldRealm(state.realm)\n        : createInitialCultivationState();\n    }\n    if (state && !state.alchemySession) {\n      state.alchemySession = null;\n    }\n    // Add new resource fields progressively\n    if (state) {\n      const res = state.resources as Record<string, number>;\n      if (res.pill_peiyuan === undefined) res.pill_peiyuan = 0;\n      if (res.pill_ningqi === undefined) res.pill_ningqi = 0;\n      if (res.pill_zhuji === undefined) res.pill_zhuji = 0;\n      if (res.pill_jindanyin === undefined) res.pill_jindanyin = 0;\n      if (res.spirit_wood === undefined) res.spirit_wood = 0;\n      if (res.talisman_paper === undefined) res.talisman_paper = 0;\n      // v0.4.0 new resources\n      if (res.pill_yuanyingguo === undefined) res.pill_yuanyingguo = 0;\n      if (res.pill_huashenlu === undefined) res.pill_huashenlu = 0;\n      if (res.pill_jiuzhuan === undefined) res.pill_jiuzhuran = 0;\n      if (res.monster_core === undefined) res.monster_core = 0;\n      if (res.heaven_earth_liquid === undefined) res.heaven_earth_liquid = 0;\n      if (res.immortal_stone === undefined) res.immortal_stone = 0;\n      if (res.merit === undefined) res.merit = 0;\n      // Fix potential typo from migration\n      if (res.pill_jiuzhuran !== undefined) {\n        res.pill_jiuzhuan = res.pill_jiuzhuran;\n        delete res.pill_jiuzhuran;\n      }\n    }\n    // v0.4.0 new fields\n    if (state) {\n      if (!state.achievements) state.achievements = [];\n      if (state.ascensionCompleted === undefined) state.ascensionCompleted = false;\n      if (!state.crossRegionLinks) state.crossRegionLinks = [];\n    }\n\n    return state;\n  } catch {\n    return null;\n  }\n}\n\nexport function clearSave(): void {\n  localStorage.removeItem(SAVE_KEY);\n}\n\nlet autoSaveTimer = 0;\n\nexport function startAutoSave(getState: () => GameState, intervalMs: number = 300000): void {\n  stopAutoSave();\n  autoSaveTimer = window.setInterval(() => {\n    saveGame(getState());\n  }, intervalMs);\n}\n\nexport function stopAutoSave(): void {\n  if (autoSaveTimer) {\n    clearInterval(autoSaveTimer);\n    autoSaveTimer = 0;\n  }\n}\n","numLines":312,"startLine":1,"totalLines":312}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_41fd7b16675d46eca6ad239d","type":"tool_result","content":"1\t// Alchemy.ts — Alchemy system with recipes, progress, and success rates (v0.4.0)\n2\t\n3\texport interface AlchemyRecipe {\n4\t  id: string;\n5\t  name: string;\n6\t  nameEn: string;\n7\t  grade: string;\n8\t  ingredients: Record<string, number>;\n9\t  output: { resource: string; amount: number; amountMax?: number };\n10\t  time: number;\n11\t  successRate: number;\n12\t  expReward: number;\n13\t  unlockRealm: string;\n14\t  description: string;\n15\t}\n16\t\n17\texport interface AlchemySession {\n18\t  recipeId: string;\n19\t  startTime: number;\n20\t  progress: number;\n21\t  complete: boolean;\n22\t}\n23\t\n24\tconst RECIPES: Record<string, AlchemyRecipe> = {\n25\t  pill_juling: {\n26\t    id: 'pill_juling',\n27\t    name: '聚灵丹',\n28\t    nameEn: 'Spirit Gathering Pill',\n29\t    grade: '下品',\n30\t    ingredients: { spirit_grass: 3 },\n31\t    output: { resource: 'pill_juling', amount: 1 },\n32\t    time: 15000,\n33\t    successRate: 0.95,\n34\t    expReward: 10,\n35\t    unlockRealm: 'liqi_2',\n36\t    description: '基础丹药，修为+10',\n37\t  },\n38\t  pill_peiyuan: {\n39\t    id: 'pill_peiyuan',\n40\t    name: '培元丹',\n41\t    nameEn: 'Foundation Pill',\n42\t    grade: '下品',\n43\t    ingredients: { spirit_grass: 5, spirit_stone: 2 },\n44\t    output: { resource: 'pill_peiyuan', amount: 1 },\n45\t    time: 20000,\n46\t    successRate: 0.90,\n47\t    expReward: 30,\n48\t    unlockRealm: 'liqi_6',\n49\t    description: '中级丹药，修为+30',\n50\t  },\n51\t  pill_ningqi: {\n52\t    id: 'pill_ningqi',\n53\t    name: '凝气丹',\n54\t    nameEn: 'Qi Condensing Pill',\n55\t    grade: '下品',\n56\t    ingredients: { spirit_grass: 5, spirit_stone: 2 },\n57\t    output: { resource: 'pill_ningqi', amount: 1, amountMax: 2 },\n58\t    time: 25000,\n59\t    successRate: 0.85,\n60\t    expReward: 50,\n61\t    unlockRealm: 'liqi_8',\n62\t    description: '凝练灵气，修为+50',\n63\t  },\n64\t  pill_zhuji: {\n65\t    id: 'pill_zhuji',\n66\t    name: '筑基丹',\n67\t    nameEn: 'Foundation Pill',\n68\t    grade: '中品',\n69\t    ingredients: { spirit_grass: 8, spirit_stone: 5, spirit_iron: 1 },\n70\t    output: { resource: 'pill_zhuji', amount: 1, amountMax: 3 },\n71\t    time: 30000,\n72\t    successRate: 0.80,\n73\t    expReward: 100,\n74\t    unlockRealm: 'zhuji_1',\n75\t    description: '筑基必需丹药，修为+100',\n76\t  },\n77\t  pill_jindanyin: {\n78\t    id: 'pill_jindanyin',\n79\t    name: '金丹引',\n80\t    nameEn: 'Golden Core Catalyst',\n81\t    grade: '中品',\n82\t    ingredients: { spirit_grass: 12, spirit_stone: 8, spirit_iron: 3 },\n83\t    output: { resource: 'pill_jindanyin', amount: 1, amountMax: 2 },\n84\t    time: 45000,\n85\t    successRate: 0.70,\n86\t    expReward: 500,\n87\t    unlockRealm: 'jindan_1',\n88\t    description: '金丹期必需丹药，修为+500',\n89\t  },\n90\t  pill_yuanyingguo: {\n91\t    id: 'pill_yuanyingguo',\n92\t    name: '元婴果',\n93\t    nameEn: 'Nascent Soul Fruit',\n94\t    grade: '上品',\n95\t    ingredients: { spirit_grass: 20, spirit_iron: 5, monster_core: 3, heaven_earth_liquid: 3 },\n96\t    output: { resource: 'pill_yuanyingguo', amount: 1, amountMax: 2 },\n97\t    time: 60000,\n98\t    successRate: 0.60,\n99\t    expReward: 2000,\n100\t    unlockRealm: 'yuanying_1',\n101\t    description: '元婴期上品丹药，修为+2000',\n102\t  },\n103\t  pill_huashenlu: {\n104\t    id: 'pill_huashenlu',\n105\t    name: '化神露',\n106\t    nameEn: 'Spirit Severing Dew',\n107\t    grade: '上品',\n108\t    ingredients: { spirit_grass: 30, immortal_stone: 3, monster_core: 10, heaven_earth_liquid: 8 },\n109\t    output: { resource: 'pill_huashenlu', amount: 1, amountMax: 2 },\n110\t    time: 90000,\n111\t    successRate: 0.50,\n112\t    expReward: 10000,\n113\t    unlockRealm: 'huashen_1',\n114\t    description: '化神期上品丹药，修为+10000',\n115\t  },\n116\t  pill_jiuzhuan: {\n117\t    id: 'pill_jiuzhuan',\n118\t    name: '九转金丹',\n119\t    nameEn: 'Nine-Turn Golden Pill',\n120\t    grade: '极品',\n121\t    ingredients: { spirit_grass: 20, spirit_stone: 20, spirit_iron: 20, monster_core: 20, heaven_earth_liquid: 20, immortal_stone: 20, merit: 20 },\n122\t    output: { resource: 'pill_jiuzhuan', amount: 1 },\n123\t    time: 120000,\n124\t    successRate: 0.40,\n125\t    expReward: 100000,\n126\t    unlockRealm: 'huashen_10',\n127\t    description: '飞升挑战极品丹药，修为+100000',\n128\t  },\n129\t};\n130\t\n131\texport function getRecipe(id: string): AlchemyRecipe | undefined {\n132\t  return RECIPES[id];\n133\t}\n134\t\n135\texport function getAllRecipes(): AlchemyRecipe[] {\n136\t  return Object.values(RECIPES);\n137\t}\n138\t\n139\texport function getAvailableRecipes(unlockCheck: (realm: string) => boolean): AlchemyRecipe[] {\n140\t  return getAllRecipes().filter(r => unlockCheck(r.unlockRealm));\n141\t}\n142\t\n143\texport function canCraft(recipe: AlchemyRecipe, resources: Record<string, number>): boolean {\n144\t  return Object.entries(recipe.ingredients).every(\n145\t    ([res, cost]) => (resources[res] ?? 0) >= cost,\n146\t  );\n147\t}\n148\t\n149\texport function startCrafting(\n150\t  recipeId: string,\n151\t  resources: Record<string, number>,\n152\t): { session: AlchemySession; resources: Record<string, number> } | null {\n153\t  const recipe = RECIPES[recipeId];\n154\t  if (!recipe) return null;\n155\t  if (!canCraft(recipe, resources)) return null;\n156\t\n157\t  const newResources = { ...resources };\n158\t  for (const [res, cost] of Object.entries(recipe.ingredients)) {\n159\t    newResources[res] = (newResources[res] ?? 0) - cost;\n160\t  }\n161\t\n162\t  return {\n163\t    session: {\n164\t      recipeId,\n165\t      startTime: Date.now(),\n166\t      progress: 0,\n167\t      complete: false,\n168\t    },\n169\t    resources: newResources,\n170\t  };\n171\t}\n172\t\n173\texport function tickAlchemy(session: AlchemySession | null, now: number): AlchemySession | null {\n174\t  if (!session || session.complete) return session;\n175\t\n176\t  const recipe = RECIPES[session.recipeId];\n177\t  if (!recipe) return null;\n178\t\n179\t  const elapsed = now - session.startTime;\n180\t  const progress = Math.min(1, elapsed / recipe.time);\n181\t\n182\t  return {\n183\t    ...session,\n184\t    progress,\n185\t    complete: progress >= 1,\n186\t  };\n187\t}\n188\t\n189\texport function collectAlchemy(\n190\t  session: AlchemySession,\n191\t  resources: Record<string, number>,\n192\t): { resources: Record<string, number>; expReward: number; amount: number; success: boolean } | null {\n193\t  if (!session.complete) return null;\n194\t\n195\t  const recipe = RECIPES[session.recipeId];\n196\t  if (!recipe) return null;\n197\t\n198\t  const roll = Math.random();\n199\t  const success = roll < recipe.successRate;\n200\t\n201\t  if (!success) {\n202\t    return { resources, expReward: 0, amount: 0, success: false };\n203\t  }\n204\t\n205\t  const amount = recipe.output.amountMax\n206\t    ? recipe.output.amount + Math.floor(Math.random() * (recipe.output.amountMax - recipe.output.amount + 1))\n207\t    : recipe.output.amount;\n208\t\n209\t  const newResources = { ...resources };\n210\t  newResources[recipe.output.resource] = (newResources[recipe.output.resource] ?? 0) + amount;\n211\t\n212\t  return { resources: newResources, expReward: recipe.expReward, amount, success: true };\n213\t}\n214\t\n215\texport function getRemainingTime(session: AlchemySession | null): string {\n216\t  if (!session) return '';\n217\t  const recipe = RECIPES[session.recipeId];\n218\t  if (!recipe) return '';\n219\t\n220\t  const elapsed = Date.now() - session.startTime;\n221\t  const remaining = Math.max(0, recipe.time - elapsed);\n222\t  const secs = Math.ceil(remaining / 1000);\n223\t  return `${secs}s`;\n224\t}\n225\t"}]},"parent_tool_use_id":null,"session_id":"094f9230-fe12-4466-ab83-fdd0d233a191","uuid":"34f18a4e-0477-43b1-9403-ef824abc14c0","timestamp":"2026-05-23T02:55:00.434Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/steam-cultivation-factory/src/game/Alchemy.ts","content":"// Alchemy.ts — Alchemy system with recipes, progress, and success rates (v0.4.0)\n\nexport interface AlchemyRecipe {\n  id: string;\n  name: string;\n  nameEn: string;\n  grade: string;\n  ingredients: Record<string, number>;\n  output: { resource: string; amount: number; amountMax?: number };\n  time: number;\n  successRate: number;\n  expReward: number;\n  unlockRealm: string;\n  description: string;\n}\n\nexport interface AlchemySession {\n  recipeId: string;\n  startTime: number;\n  progress: number;\n  complete: boolean;\n}\n\nconst RECIPES: Record<string, AlchemyRecipe> = {\n  pill_juling: {\n    id: 'pill_juling',\n    name: '聚灵丹',\n    nameEn: 'Spirit Gathering Pill',\n    grade: '下品',\n    ingredients: { spirit_grass: 3 },\n    output: { resource: 'pill_juling', amount: 1 },\n    time: 15000,\n    successRate: 0.95,\n    expReward: 10,\n    unlockRealm: 'liqi_2',\n    description: '基础丹药，修为+10',\n  },\n  pill_peiyuan: {\n    id: 'pill_peiyuan',\n    name: '培元丹',\n    nameEn: 'Foundation Pill',\n    grade: '下品',\n    ingredients: { spirit_grass: 5, spirit_stone: 2 },\n    output: { resource: 'pill_peiyuan', amount: 1 },\n    time: 20000,\n    successRate: 0.90,\n    expReward: 30,\n    unlockRealm: 'liqi_6',\n    description: '中级丹药，修为+30',\n  },\n  pill_ningqi: {\n    id: 'pill_ningqi',\n    name: '凝气丹',\n    nameEn: 'Qi Condensing Pill',\n    grade: '下品',\n    ingredients: { spirit_grass: 5, spirit_stone: 2 },\n    output: { resource: 'pill_ningqi', amount: 1, amountMax: 2 },\n    time: 25000,\n    successRate: 0.85,\n    expReward: 50,\n    unlockRealm: 'liqi_8',\n    description: '凝练灵气，修为+50',\n  },\n  pill_zhuji: {\n    id: 'pill_zhuji',\n    name: '筑基丹',\n    nameEn: 'Foundation Pill',\n    grade: '中品',\n    ingredients: { spirit_grass: 8, spirit_stone: 5, spirit_iron: 1 },\n    output: { resource: 'pill_zhuji', amount: 1, amountMax: 3 },\n    time: 30000,\n    successRate: 0.80,\n    expReward: 100,\n    unlockRealm: 'zhuji_1',\n    description: '筑基必需丹药，修为+100',\n  },\n  pill_jindanyin: {\n    id: 'pill_jindanyin',\n    name: '金丹引',\n    nameEn: 'Golden Core Catalyst',\n    grade: '中品',\n    ingredients: { spirit_grass: 12, spirit_stone: 8, spirit_iron: 3 },\n    output: { resource: 'pill_jindanyin', amount: 1, amountMax: 2 },\n    time: 45000,\n    successRate: 0.70,\n    expReward: 500,\n    unlockRealm: 'jindan_1',\n    description: '金丹期必需丹药，修为+500',\n  },\n  pill_yuanyingguo: {\n    id: 'pill_yuanyingguo',\n    name: '元婴果',\n    nameEn: 'Nascent Soul Fruit',\n    grade: '上品',\n    ingredients: { spirit_grass: 20, spirit_iron: 5, monster_core: 3, heaven_earth_liquid: 3 },\n    output: { resource: 'pill_yuanyingguo', amount: 1, amountMax: 2 },\n    time: 60000,\n    successRate: 0.60,\n    expReward: 2000,\n    unlockRealm: 'yuanying_1',\n    description: '元婴期上品丹药，修为+2000',\n  },\n  pill_huashenlu: {\n    id: 'pill_huashenlu',\n    name: '化神露',\n    nameEn: 'Spirit Severing Dew',\n    grade: '上品',\n    ingredients: { spirit_grass: 30, immortal_stone: 3, monster_core: 10, heaven_earth_liquid: 8 },\n    output: { resource: 'pill_huashenlu', amount: 1, amountMax: 2 },\n    time: 90000,\n    successRate: 0.50,\n    expReward: 10000,\n    unlockRealm: 'huashen_1',\n    description: '化神期上品丹药，修为+10000',\n  },\n  pill_jiuzhuan: {\n    id: 'pill_jiuzhuan',\n    name: '九转金丹',\n    nameEn: 'Nine-Turn Golden Pill',\n    grade: '极品',\n    ingredients: { spirit_grass: 20, spirit_stone: 20, spirit_iron: 20, monster_core: 20, heaven_earth_liquid: 20, immortal_stone: 20, merit: 20 },\n    output: { resource: 'pill_jiuzhuan', amount: 1 },\n    time: 120000,\n    successRate: 0.40,\n    expReward: 100000,\n    unlockRealm: 'huashen_10',\n    description: '飞升挑战极品丹药，修为+100000',\n  },\n};\n\nexport function getRecipe(id: string): AlchemyRecipe | undefined {\n  return RECIPES[id];\n}\n\nexport function getAllRecipes(): AlchemyRecipe[] {\n  return Object.values(RECIPES);\n}\n\nexport function getAvailableRecipes(unlockCheck: (realm: string) => boolean): AlchemyRecipe[] {\n  return getAllRecipes().filter(r => unlockCheck(r.unlockRealm));\n}\n\nexport function canCraft(recipe: AlchemyRecipe, resources: Record<string, number>): boolean {\n  return Object.entries(recipe.ingredients).every(\n    ([res, cost]) => (resources[res] ?? 0) >= cost,\n  );\n}\n\nexport function startCrafting(\n  recipeId: string,\n  resources: Record<string, number>,\n): { session: AlchemySession; resources: Record<string, number> } | null {\n  const recipe = RECIPES[recipeId];\n  if (!recipe) return null;\n  if (!canCraft(recipe, resources)) return null;\n\n  const newResources = { ...resources };\n  for (const [res, cost] of Object.entries(recipe.ingredients)) {\n    newResources[res] = (newResources[res] ?? 0) - cost;\n  }\n\n  return {\n    session: {\n      recipeId,\n      startTime: Date.now(),\n      progress: 0,\n      complete: false,\n    },\n    resources: newResources,\n  };\n}\n\nexport function tickAlchemy(session: AlchemySession | null, now: number): AlchemySession | null {\n  if (!session || session.complete) return session;\n\n  const recipe = RECIPES[session.recipeId];\n  if (!recipe) return null;\n\n  const elapsed = now - session.startTime;\n  const progress = Math.min(1, elapsed / recipe.time);\n\n  return {\n    ...session,\n    progress,\n    complete: progress >= 1,\n  };\n}\n\nexport function collectAlchemy(\n  session: AlchemySession,\n  resources: Record<string, number>,\n): { resources: Record<string, number>; expReward: number; amount: number; success: boolean } | null {\n  if (!session.complete) return null;\n\n  const recipe = RECIPES[session.recipeId];\n  if (!recipe) return null;\n\n  const roll = Math.random();\n  const success = roll < recipe.successRate;\n\n  if (!success) {\n    return { resources, expReward: 0, amount: 0, success: false };\n  }\n\n  const amount = recipe.output.amountMax\n    ? recipe.output.amount + Math.floor(Math.random() * (recipe.output.amountMax - recipe.output.amount + 1))\n    : recipe.output.amount;\n\n  const newResources = { ...resources };\n  newResources[recipe.output.resource] = (newResources[recipe.output.resource] ?? 0) + amount;\n\n  return { resources: newResources, expReward: recipe.expReward, amount, success: true };\n}\n\nexport function getRemainingTime(session: AlchemySession | null): string {\n  if (!session) return '';\n  const recipe = RECIPES[session.recipeId];\n  if (!recipe) return '';\n\n  const elapsed = Date.now() - session.startTime;\n  const remaining = Math.max(0, recipe.time - elapsed);\n  const secs = Math.ceil(remaining / 1000);\n  return `${secs}s`;\n}\n","numLines":225,"startLine":1,"totalLines":225}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_266bf894cc4240bc975a0c38","type":"tool_result","content":"1\t// Cultivation.ts — Realm breakthrough and cultivation progression system (v0.4.0)\n2\t\n3\texport interface RealmDef {\n4\t  id: string;\n5\t  name: string;\n6\t  nameEn: string;\n7\t  subStages: string[];\n8\t  levelsPerStage: number;\n9\t  expBase: number;\n10\t  expGrowth: number;\n11\t  cultivationBaseRate: number;\n12\t  breakthroughCost: Record<string, number>;\n13\t  breakthroughPill?: string;\n14\t  breakthroughPillCount?: number;\n15\t  breakthroughSuccessRate: number;\n16\t  failPenaltyPercent: number;\n17\t  unlockContent: string[];\n18\t}\n19\t\n20\texport interface CultivationState {\n21\t  realmId: string;\n22\t  subStage: number;\n23\t  level: number;\n24\t  exp: number;\n25\t  expToNext: number;\n26\t  totalCultivation: number;\n27\t  cultivationRate: number;\n28\t  isAutoCultivating: boolean;\n29\t}\n30\t\n31\texport interface BreakthroughResult {\n32\t  success: boolean;\n33\t  oldRealm: string;\n34\t  newRealm: string;\n35\t  oldSubStage: number;\n36\t  newSubStage: number;\n37\t  penalty: number;\n38\t}\n39\t\n40\tconst REALM_ORDER = ['fanren', 'liqi', 'zhuji', 'jindan', 'yuanying', 'huashen'];\n41\t\n42\tconst REALM_DEFS: Record<string, RealmDef> = {\n43\t  fanren: {\n44\t    id: 'fanren',\n45\t    name: '凡人',\n46\t    nameEn: 'Mortal',\n47\t    subStages: ['凡人'],\n48\t    levelsPerStage: 1,\n49\t    expBase: 50,\n50\t    expGrowth: 1.0,\n51\t    cultivationBaseRate: 0,\n52\t    breakthroughCost: { spirit_stone: 10 },\n53\t    breakthroughSuccessRate: 1.0,\n54\t    failPenaltyPercent: 0,\n55\t    unlockContent: [],\n56\t  },\n57\t  liqi: {\n58\t    id: 'liqi',\n59\t    name: '炼气期',\n60\t    nameEn: 'Qi Refining',\n61\t    subStages: ['初期', '中期', '后期'],\n62\t    levelsPerStage: 4,\n63\t    expBase: 100,\n64\t    expGrowth: 1.8,\n65\t    cultivationBaseRate: 0.5,\n66\t    breakthroughCost: { spirit_stone: 200 },\n67\t    breakthroughPill: 'pill_juling',\n68\t    breakthroughPillCount: 5,\n69\t    breakthroughSuccessRate: 0.85,\n70\t    failPenaltyPercent: 0.2,\n71\t    unlockContent: ['灵石矿机', '灵田', '丹炉', '聚灵丹'],\n72\t  },\n73\t  zhuji: {\n74\t    id: 'zhuji',\n75\t    name: '筑基期',\n76\t    nameEn: 'Foundation Building',\n77\t    subStages: ['初期', '中期', '后期'],\n78\t    levelsPerStage: 5,\n79\t    expBase: 1000,\n80\t    expGrowth: 1.8,\n81\t    cultivationBaseRate: 2.0,\n82\t    breakthroughCost: { spirit_stone: 500 },\n83\t    breakthroughPill: 'pill_zhuji',\n84\t    breakthroughPillCount: 5,\n85\t    breakthroughSuccessRate: 0.75,\n86\t    failPenaltyPercent: 0.25,\n87\t    unlockContent: ['灵脉通道', '传送带', '筑基丹'],\n88\t  },\n89\t  jindan: {\n90\t    id: 'jindan',\n91\t    name: '金丹期',\n92\t    nameEn: 'Golden Core',\n93\t    subStages: ['初期', '中期', '后期', '圆满'],\n94\t    levelsPerStage: 5,\n95\t    expBase: 10000,\n96\t    expGrowth: 1.8,\n97\t    cultivationBaseRate: 10.0,\n98\t    breakthroughCost: { spirit_stone: 5000, spirit_iron: 10 },\n99\t    breakthroughPill: 'pill_jindanyin',\n100\t    breakthroughPillCount: 10,\n101\t    breakthroughSuccessRate: 0.70,\n102\t    failPenaltyPercent: 0.3,\n103\t    unlockContent: ['傀儡工人', '分拣器', '金丹引', '精炼炉', '传送阵'],\n104\t  },\n105\t  yuanying: {\n106\t    id: 'yuanying',\n107\t    name: '元婴期',\n108\t    nameEn: 'Nascent Soul',\n109\t    subStages: ['初期', '中期', '后期', '圆满'],\n110\t    levelsPerStage: 5,\n111\t    expBase: 100000,\n112\t    expGrowth: 1.8,\n113\t    cultivationBaseRate: 50.0,\n114\t    breakthroughCost: { spirit_stone: 50000, heaven_earth_liquid: 5 },\n115\t    breakthroughPill: 'pill_jindanyin',\n116\t    breakthroughPillCount: 10,\n117\t    breakthroughSuccessRate: 0.65,\n118\t    failPenaltyPercent: 0.35,\n119\t    unlockContent: ['灵阵加速', '跨区域传送', '高级丹方', '智能傀儡核心', '元婴果'],\n120\t  },\n121\t  huashen: {\n122\t    id: 'huashen',\n123\t    name: '化神期',\n124\t    nameEn: 'Spirit Severing',\n125\t    subStages: ['初期', '中期', '后期', '圆满'],\n126\t    levelsPerStage: 4,\n127\t    expBase: 1000000,\n128\t    expGrowth: 1.8,\n129\t    cultivationBaseRate: 200.0,\n130\t    breakthroughCost: { spirit_stone: 500000, heaven_earth_liquid: 20 },\n131\t    breakthroughPill: 'pill_yuanyingguo',\n132\t    breakthroughPillCount: 20,\n133\t    breakthroughSuccessRate: 0.60,\n134\t    failPenaltyPercent: 0.4,\n135\t    unlockContent: ['空间折叠', '跨维度工厂', '神级丹方', '飞升挑战', '化神露'],\n136\t  },\n137\t};\n138\t\n139\texport function getRealmDef(realmId: string): RealmDef | undefined {\n140\t  return REALM_DEFS[realmId];\n141\t}\n142\t\n143\texport function getRealmOrder(): string[] {\n144\t  return REALM_ORDER;\n145\t}\n146\t\n147\texport function createInitialCultivationState(): CultivationState {\n148\t  return {\n149\t    realmId: 'fanren',\n150\t    subStage: 0,\n151\t    level: 1,\n152\t    exp: 0,\n153\t    expToNext: 50,\n154\t    totalCultivation: 0,\n155\t    cultivationRate: 0,\n156\t    isAutoCultivating: false,\n157\t  };\n158\t}\n159\t\n160\texport function getSubStageName(realmId: string, subStage: number): string {\n161\t  const def = REALM_DEFS[realmId];\n162\t  if (!def) return '';\n163\t  return def.subStages[subStage] ?? '';\n164\t}\n165\t\n166\texport function getFullRealmName(state: CultivationState): string {\n167\t  const def = REALM_DEFS[state.realmId];\n168\t  if (!def) return state.realmId;\n169\t  if (def.subStages.length === 1) return def.name;\n170\t  return `${def.name} ${def.subStages[state.subStage] ?? ''} Lv${state.level}`;\n171\t}\n172\t\n173\texport function getShortRealmName(state: CultivationState): string {\n174\t  const def = REALM_DEFS[state.realmId];\n175\t  if (!def) return state.realmId;\n176\t  return def.name;\n177\t}\n178\t\n179\texport function calcExpToNext(realmId: string, level: number): number {\n180\t  const def = REALM_DEFS[realmId];\n181\t  if (!def) return 100;\n182\t  return Math.floor(def.expBase * Math.pow(def.expGrowth, level - 1));\n183\t}\n184\t\n185\texport function addCultivationExp(state: CultivationState, amount: number): CultivationState {\n186\t  const next = { ...state };\n187\t  next.exp += amount;\n188\t  next.totalCultivation += amount;\n189\t\n190\t  const def = REALM_DEFS[next.realmId];\n191\t  if (!def) return next;\n192\t\n193\t  while (next.exp >= next.expToNext) {\n194\t    next.exp -= next.expToNext;\n195\t    next.level += 1;\n196\t\n197\t    if (next.level > def.levelsPerStage) {\n198\t      next.level = def.levelsPerStage;\n199\t      next.exp = next.expToNext;\n200\t      break;\n201\t    }\n202\t\n203\t    next.expToNext = calcExpToNext(next.realmId, next.level);\n204\t  }\n205\t\n206\t  next.cultivationRate = def.cultivationBaseRate;\n207\t\n208\t  return next;\n209\t}\n210\t\n211\texport function canBreakthrough(state: CultivationState): boolean {\n212\t  const def = REALM_DEFS[state.realmId];\n213\t  if (!def) return false;\n214\t  if (state.level < def.levelsPerStage) return false;\n215\t  if (state.exp < state.expToNext) return false;\n216\t  return true;\n217\t}\n218\t\n219\texport function isRealmTransition(state: CultivationState): boolean {\n220\t  const def = REALM_DEFS[state.realmId];\n221\t  if (!def) return false;\n222\t  return state.subStage >= def.subStages.length - 1;\n223\t}\n224\t\n225\texport function getBreakthroughRequirements(state: CultivationState): {\n226\t  canAttempt: boolean;\n227\t  needsPill: boolean;\n228\t  pillId: string | null;\n229\t  pillCount: number;\n230\t  resourceCost: Record<string, number>;\n231\t  successRate: number;\n232\t} {\n233\t  const def = REALM_DEFS[state.realmId];\n234\t  if (!def) return { canAttempt: false, needsPill: false, pillId: null, pillCount: 0, resourceCost: {}, successRate: 0 };\n235\t\n236\t  const atMax = state.level >= def.levelsPerStage && state.exp >= state.expToNext;\n237\t\n238\t  return {\n239\t    canAttempt: atMax,\n240\t    needsPill: !!def.breakthroughPill,\n241\t    pillId: def.breakthroughPill ?? null,\n242\t    pillCount: def.breakthroughPillCount ?? 0,\n243\t    resourceCost: def.breakthroughCost,\n244\t    successRate: def.breakthroughSuccessRate,\n245\t  };\n246\t}\n247\t\n248\texport function attemptBreakthrough(\n249\t  state: CultivationState,\n250\t  resources: Record<string, number>,\n251\t): { result: BreakthroughResult; newState: CultivationState; newResources: Record<string, number> } | null {\n252\t  const def = REALM_DEFS[state.realmId];\n253\t  if (!def) return null;\n254\t\n255\t  if (!canBreakthrough(state)) return null;\n256\t\n257\t  const costs = def.breakthroughCost;\n258\t  for (const [res, amount] of Object.entries(costs)) {\n259\t    if ((resources[res] ?? 0) < amount) return null;\n260\t  }\n261\t\n262\t  if (def.breakthroughPill && def.breakthroughPillCount) {\n263\t    if ((resources[def.breakthroughPill] ?? 0) < def.breakthroughPillCount) return null;\n264\t  }\n265\t\n266\t  const newResources = { ...resources };\n267\t  for (const [res, amount] of Object.entries(costs)) {\n268\t    newResources[res] = (newResources[res] ?? 0) - amount;\n269\t  }\n270\t  if (def.breakthroughPill && def.breakthroughPillCount) {\n271\t    newResources[def.breakthroughPill] = (newResources[def.breakthroughPill] ?? 0) - def.breakthroughPillCount;\n272\t  }\n273\t\n274\t  const roll = Math.random();\n275\t  const success = roll < def.breakthroughSuccessRate;\n276\t\n277\t  const newState = { ...state };\n278\t\n279\t  if (success) {\n280\t    const isTransition = isRealmTransition(state);\n281\t\n282\t    if (isTransition) {\n283\t      const currentIdx = REALM_ORDER.indexOf(state.realmId);\n284\t      const nextRealmId = REALM_ORDER[currentIdx + 1] ?? state.realmId;\n285\t      const nextDef = REALM_DEFS[nextRealmId];\n286\t\n287\t      newState.realmId = nextRealmId;\n288\t      newState.subStage = 0;\n289\t      newState.level = 1;\n290\t      newState.exp = 0;\n291\t      newState.expToNext = nextDef ? nextDef.expBase : 100;\n292\t      newState.cultivationRate = nextDef?.cultivationBaseRate ?? 0;\n293\t    } else {\n294\t      newState.subStage = state.subStage + 1;\n295\t      newState.level = 1;\n296\t      newState.exp = 0;\n297\t      newState.expToNext = calcExpToNext(state.realmId, 1);\n298\t    }\n299\t\n300\t    return {\n301\t      result: {\n302\t        success: true,\n303\t        oldRealm: state.realmId,\n304\t        newRealm: newState.realmId,\n305\t        oldSubStage: state.subStage,\n306\t        newSubStage: newState.subStage,\n307\t        penalty: 0,\n308\t      },\n309\t      newState,\n310\t      newResources,\n311\t    };\n312\t  } else {\n313\t    const penalty = def.failPenaltyPercent;\n314\t    const expLoss = Math.floor(newState.totalCultivation * penalty);\n315\t    newState.exp = Math.max(0, newState.exp - expLoss);\n316\t    newState.totalCultivation = Math.max(0, newState.totalCultivation - expLoss);\n317\t\n318\t    return {\n319\t      result: {\n320\t        success: false,\n321\t        oldRealm: state.realmId,\n322\t        newRealm: state.realmId,\n323\t        oldSubStage: state.subStage,\n324\t        newSubStage: state.subStage,\n325\t        penalty: penalty,\n326\t      },\n327\t      newState,\n328\t      newResources,\n329\t    };\n330\t  }\n331\t}\n332\t\n333\texport function tickAutoCultivation(state: CultivationState, dtMs: number): CultivationState {\n334\t  if (state.cultivationRate <= 0) return state;\n335\t\n336\t  const amount = state.cultivationRate * (dtMs / 1000);\n337\t  return addCultivationExp(state, amount);\n338\t}\n339\t\n340\texport function migrateFromOldRealm(oldRealm: {\n341\t  realmId: string;\n342\t  level: number;\n343\t  exp: number;\n344\t  expToNext: number;\n345\t}): CultivationState {\n346\t  let subStage = 0;\n347\t  let level = oldRealm.level;\n348\t  const levelsPerStage = 4;\n349\t\n350\t  if (level > levelsPerStage) {\n351\t    subStage = Math.floor((level - 1) / levelsPerStage);\n352\t    level = ((level - 1) % levelsPerStage) + 1;\n353\t  }\n354\t\n355\t  return {\n356\t    realmId: oldRealm.realmId,\n357\t    subStage: Math.min(subStage, 2),\n358\t    level,\n359\t    exp: oldRealm.exp,\n360\t    expToNext: oldRealm.expToNext,\n361\t    totalCultivation: oldRealm.exp,\n362\t    cultivationRate: oldRealm.realmId === 'liqi' ? 0.5 : 0,\n363\t    isAutoCultivating: false,\n364\t  };\n365\t}\n366\t\n367\texport function getRealmIndex(realmId: string): number {\n368\t  return REALM_ORDER.indexOf(realmId);\n369\t}\n370\t\n371\texport function isRealmUnlocked(required: string, cultivation: CultivationState): boolean {\n372\t  const [rRealm, rLevel] = required.split('_');\n373\t  const rRealmIdx = REALM_ORDER.indexOf(rRealm);\n374\t  const cRealmIdx = REALM_ORDER.indexOf(cultivation.realmId);\n375\t\n376\t  if (cRealmIdx > rRealmIdx) return true;\n377\t  if (cRealmIdx < rRealmIdx) return false;\n378\t\n379\t  const def = REALM_DEFS[cultivation.realmId];\n380\t  const totalLevel = cultivation.subStage * (def?.levelsPerStage ?? 4) + cultivation.level;\n381\t  return totalLevel >= parseInt(rLevel);\n382\t}\n383\t\n384\t// Get total game level from cultivation state\n385\texport function getTotalGameLevel(state: CultivationState): number {\n386\t  let total = 0;\n387\t  const realmIdx = REALM_ORDER.indexOf(state.realmId);\n388\t\n389\t  for (let i = 0; i < realmIdx; i++) {\n390\t    const def = REALM_DEFS[REALM_ORDER[i]];\n391\t    total += def ? def.subStages.length * def.levelsPerStage : 0;\n392\t  }\n393\t\n394\t  const def = REALM_DEFS[state.realmId];\n395\t  total += state.subStage * (def?.levelsPerStage ?? 4) + state.level;\n396\t  return total;\n397\t}\n398\t"}]},"parent_tool_use_id":null,"session_id":"094f9230-fe12-4466-ab83-fdd0d233a191","uuid":"39e15d4e-bc3b-4794-b034-75dec8fcbc97","timestamp":"2026-05-23T02:55:00.437Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/steam-cultivation-factory/src/game/Cultivation.ts","content":"// Cultivation.ts — Realm breakthrough and cultivation progression system (v0.4.0)\n\nexport interface RealmDef {\n  id: string;\n  name: string;\n  nameEn: string;\n  subStages: string[];\n  levelsPerStage: number;\n  expBase: number;\n  expGrowth: number;\n  cultivationBaseRate: number;\n  breakthroughCost: Record<string, number>;\n  breakthroughPill?: string;\n  breakthroughPillCount?: number;\n  breakthroughSuccessRate: number;\n  failPenaltyPercent: number;\n  unlockContent: string[];\n}\n\nexport interface CultivationState {\n  realmId: string;\n  subStage: number;\n  level: number;\n  exp: number;\n  expToNext: number;\n  totalCultivation: number;\n  cultivationRate: number;\n  isAutoCultivating: boolean;\n}\n\nexport interface BreakthroughResult {\n  success: boolean;\n  oldRealm: string;\n  newRealm: string;\n  oldSubStage: number;\n  newSubStage: number;\n  penalty: number;\n}\n\nconst REALM_ORDER = ['fanren', 'liqi', 'zhuji', 'jindan', 'yuanying', 'huashen'];\n\nconst REALM_DEFS: Record<string, RealmDef> = {\n  fanren: {\n    id: 'fanren',\n    name: '凡人',\n    nameEn: 'Mortal',\n    subStages: ['凡人'],\n    levelsPerStage: 1,\n    expBase: 50,\n    expGrowth: 1.0,\n    cultivationBaseRate: 0,\n    breakthroughCost: { spirit_stone: 10 },\n    breakthroughSuccessRate: 1.0,\n    failPenaltyPercent: 0,\n    unlockContent: [],\n  },\n  liqi: {\n    id: 'liqi',\n    name: '炼气期',\n    nameEn: 'Qi Refining',\n    subStages: ['初期', '中期', '后期'],\n    levelsPerStage: 4,\n    expBase: 100,\n    expGrowth: 1.8,\n    cultivationBaseRate: 0.5,\n    breakthroughCost: { spirit_stone: 200 },\n    breakthroughPill: 'pill_juling',\n    breakthroughPillCount: 5,\n    breakthroughSuccessRate: 0.85,\n    failPenaltyPercent: 0.2,\n    unlockContent: ['灵石矿机', '灵田', '丹炉', '聚灵丹'],\n  },\n  zhuji: {\n    id: 'zhuji',\n    name: '筑基期',\n    nameEn: 'Foundation Building',\n    subStages: ['初期', '中期', '后期'],\n    levelsPerStage: 5,\n    expBase: 1000,\n    expGrowth: 1.8,\n    cultivationBaseRate: 2.0,\n    breakthroughCost: { spirit_stone: 500 },\n    breakthroughPill: 'pill_zhuji',\n    breakthroughPillCount: 5,\n    breakthroughSuccessRate: 0.75,\n    failPenaltyPercent: 0.25,\n    unlockContent: ['灵脉通道', '传送带', '筑基丹'],\n  },\n  jindan: {\n    id: 'jindan',\n    name: '金丹期',\n    nameEn: 'Golden Core',\n    subStages: ['初期', '中期', '后期', '圆满'],\n    levelsPerStage: 5,\n    expBase: 10000,\n    expGrowth: 1.8,\n    cultivationBaseRate: 10.0,\n    breakthroughCost: { spirit_stone: 5000, spirit_iron: 10 },\n    breakthroughPill: 'pill_jindanyin',\n    breakthroughPillCount: 10,\n    breakthroughSuccessRate: 0.70,\n    failPenaltyPercent: 0.3,\n    unlockContent: ['傀儡工人', '分拣器', '金丹引', '精炼炉', '传送阵'],\n  },\n  yuanying: {\n    id: 'yuanying',\n    name: '元婴期',\n    nameEn: 'Nascent Soul',\n    subStages: ['初期', '中期', '后期', '圆满'],\n    levelsPerStage: 5,\n    expBase: 100000,\n    expGrowth: 1.8,\n    cultivationBaseRate: 50.0,\n    breakthroughCost: { spirit_stone: 50000, heaven_earth_liquid: 5 },\n    breakthroughPill: 'pill_jindanyin',\n    breakthroughPillCount: 10,\n    breakthroughSuccessRate: 0.65,\n    failPenaltyPercent: 0.35,\n    unlockContent: ['灵阵加速', '跨区域传送', '高级丹方', '智能傀儡核心', '元婴果'],\n  },\n  huashen: {\n    id: 'huashen',\n    name: '化神期',\n    nameEn: 'Spirit Severing',\n    subStages: ['初期', '中期', '后期', '圆满'],\n    levelsPerStage: 4,\n    expBase: 1000000,\n    expGrowth: 1.8,\n    cultivationBaseRate: 200.0,\n    breakthroughCost: { spirit_stone: 500000, heaven_earth_liquid: 20 },\n    breakthroughPill: 'pill_yuanyingguo',\n    breakthroughPillCount: 20,\n    breakthroughSuccessRate: 0.60,\n    failPenaltyPercent: 0.4,\n    unlockContent: ['空间折叠', '跨维度工厂', '神级丹方', '飞升挑战', '化神露'],\n  },\n};\n\nexport function getRealmDef(realmId: string): RealmDef | undefined {\n  return REALM_DEFS[realmId];\n}\n\nexport function getRealmOrder(): string[] {\n  return REALM_ORDER;\n}\n\nexport function createInitialCultivationState(): CultivationState {\n  return {\n    realmId: 'fanren',\n    subStage: 0,\n    level: 1,\n    exp: 0,\n    expToNext: 50,\n    totalCultivation: 0,\n    cultivationRate: 0,\n    isAutoCultivating: false,\n  };\n}\n\nexport function getSubStageName(realmId: string, subStage: number): string {\n  const def = REALM_DEFS[realmId];\n  if (!def) return '';\n  return def.subStages[subStage] ?? '';\n}\n\nexport function getFullRealmName(state: CultivationState): string {\n  const def = REALM_DEFS[state.realmId];\n  if (!def) return state.realmId;\n  if (def.subStages.length === 1) return def.name;\n  return `${def.name} ${def.subStages[state.subStage] ?? ''} Lv${state.level}`;\n}\n\nexport function getShortRealmName(state: CultivationState): string {\n  const def = REALM_DEFS[state.realmId];\n  if (!def) return state.realmId;\n  return def.name;\n}\n\nexport function calcExpToNext(realmId: string, level: number): number {\n  const def = REALM_DEFS[realmId];\n  if (!def) return 100;\n  return Math.floor(def.expBase * Math.pow(def.expGrowth, level - 1));\n}\n\nexport function addCultivationExp(state: CultivationState, amount: number): CultivationState {\n  const next = { ...state };\n  next.exp += amount;\n  next.totalCultivation += amount;\n\n  const def = REALM_DEFS[next.realmId];\n  if (!def) return next;\n\n  while (next.exp >= next.expToNext) {\n    next.exp -= next.expToNext;\n    next.level += 1;\n\n    if (next.level > def.levelsPerStage) {\n      next.level = def.levelsPerStage;\n      next.exp = next.expToNext;\n      break;\n    }\n\n    next.expToNext = calcExpToNext(next.realmId, next.level);\n  }\n\n  next.cultivationRate = def.cultivationBaseRate;\n\n  return next;\n}\n\nexport function canBreakthrough(state: CultivationState): boolean {\n  const def = REALM_DEFS[state.realmId];\n  if (!def) return false;\n  if (state.level < def.levelsPerStage) return false;\n  if (state.exp < state.expToNext) return false;\n  return true;\n}\n\nexport function isRealmTransition(state: CultivationState): boolean {\n  const def = REALM_DEFS[state.realmId];\n  if (!def) return false;\n  return state.subStage >= def.subStages.length - 1;\n}\n\nexport function getBreakthroughRequirements(state: CultivationState): {\n  canAttempt: boolean;\n  needsPill: boolean;\n  pillId: string | null;\n  pillCount: number;\n  resourceCost: Record<string, number>;\n  successRate: number;\n} {\n  const def = REALM_DEFS[state.realmId];\n  if (!def) return { canAttempt: false, needsPill: false, pillId: null, pillCount: 0, resourceCost: {}, successRate: 0 };\n\n  const atMax = state.level >= def.levelsPerStage && state.exp >= state.expToNext;\n\n  return {\n    canAttempt: atMax,\n    needsPill: !!def.breakthroughPill,\n    pillId: def.breakthroughPill ?? null,\n    pillCount: def.breakthroughPillCount ?? 0,\n    resourceCost: def.breakthroughCost,\n    successRate: def.breakthroughSuccessRate,\n  };\n}\n\nexport function attemptBreakthrough(\n  state: CultivationState,\n  resources: Record<string, number>,\n): { result: BreakthroughResult; newState: CultivationState; newResources: Record<string, number> } | null {\n  const def = REALM_DEFS[state.realmId];\n  if (!def) return null;\n\n  if (!canBreakthrough(state)) return null;\n\n  const costs = def.breakthroughCost;\n  for (const [res, amount] of Object.entries(costs)) {\n    if ((resources[res] ?? 0) < amount) return null;\n  }\n\n  if (def.breakthroughPill && def.breakthroughPillCount) {\n    if ((resources[def.breakthroughPill] ?? 0) < def.breakthroughPillCount) return null;\n  }\n\n  const newResources = { ...resources };\n  for (const [res, amount] of Object.entries(costs)) {\n    newResources[res] = (newResources[res] ?? 0) - amount;\n  }\n  if (def.breakthroughPill && def.breakthroughPillCount) {\n    newResources[def.breakthroughPill] = (newResources[def.breakthroughPill] ?? 0) - def.breakthroughPillCount;\n  }\n\n  const roll = Math.random();\n  const success = roll < def.breakthroughSuccessRate;\n\n  const newState = { ...state };\n\n  if (success) {\n    const isTransition = isRealmTransition(state);\n\n    if (isTransition) {\n      const currentIdx = REALM_ORDER.indexOf(state.realmId);\n      const nextRealmId = REALM_ORDER[currentIdx + 1] ?? state.realmId;\n      const nextDef = REALM_DEFS[nextRealmId];\n\n      newState.realmId = nextRealmId;\n      newState.subStage = 0;\n      newState.level = 1;\n      newState.exp = 0;\n      newState.expToNext = nextDef ? nextDef.expBase : 100;\n      newState.cultivationRate = nextDef?.cultivationBaseRate ?? 0;\n    } else {\n      newState.subStage = state.subStage + 1;\n      newState.level = 1;\n      newState.exp = 0;\n      newState.expToNext = calcExpToNext(state.realmId, 1);\n    }\n\n    return {\n      result: {\n        success: true,\n        oldRealm: state.realmId,\n        newRealm: newState.realmId,\n        oldSubStage: state.subStage,\n        newSubStage: newState.subStage,\n        penalty: 0,\n      },\n      newState,\n      newResources,\n    };\n  } else {\n    const penalty = def.failPenaltyPercent;\n    const expLoss = Math.floor(newState.totalCultivation * penalty);\n    newState.exp = Math.max(0, newState.exp - expLoss);\n    newState.totalCultivation = Math.max(0, newState.totalCultivation - expLoss);\n\n    return {\n      result: {\n        success: false,\n        oldRealm: state.realmId,\n        newRealm: state.realmId,\n        oldSubStage: state.subStage,\n        newSubStage: state.subStage,\n        penalty: penalty,\n      },\n      newState,\n      newResources,\n    };\n  }\n}\n\nexport function tickAutoCultivation(state: CultivationState, dtMs: number): CultivationState {\n  if (state.cultivationRate <= 0) return state;\n\n  const amount = state.cultivationRate * (dtMs / 1000);\n  return addCultivationExp(state, amount);\n}\n\nexport function migrateFromOldRealm(oldRealm: {\n  realmId: string;\n  level: number;\n  exp: number;\n  expToNext: number;\n}): CultivationState {\n  let subStage = 0;\n  let level = oldRealm.level;\n  const levelsPerStage = 4;\n\n  if (level > levelsPerStage) {\n    subStage = Math.floor((level - 1) / levelsPerStage);\n    level = ((level - 1) % levelsPerStage) + 1;\n  }\n\n  return {\n    realmId: oldRealm.realmId,\n    subStage: Math.min(subStage, 2),\n    level,\n    exp: oldRealm.exp,\n    expToNext: oldRealm.expToNext,\n    totalCultivation: oldRealm.exp,\n    cultivationRate: oldRealm.realmId === 'liqi' ? 0.5 : 0,\n    isAutoCultivating: false,\n  };\n}\n\nexport function getRealmIndex(realmId: string): number {\n  return REALM_ORDER.indexOf(realmId);\n}\n\nexport function isRealmUnlocked(required: string, cultivation: CultivationState): boolean {\n  const [rRealm, rLevel] = required.split('_');\n  const rRealmIdx = REALM_ORDER.indexOf(rRealm);\n  const cRealmIdx = REALM_ORDER.indexOf(cultivation.realmId);\n\n  if (cRealmIdx > rRealmIdx) return true;\n  if (cRealmIdx < rRealmIdx) return false;\n\n  const def = REALM_DEFS[cultivation.realmId];\n  const totalLevel = cultivation.subStage * (def?.levelsPerStage ?? 4) + cultivation.level;\n  return totalLevel >= parseInt(rLevel);\n}\n\n// Get total game level from cultivation state\nexport function getTotalGameLevel(state: CultivationState): number {\n  let total = 0;\n  const realmIdx = REALM_ORDER.indexOf(state.realmId);\n\n  for (let i = 0; i < realmIdx; i++) {\n    const def = REALM_DEFS[REALM_ORDER[i]];\n    total += def ? def.subStages.length * def.levelsPerStage : 0;\n  }\n\n  const def = REALM_DEFS[state.realmId];\n  total += state.subStage * (def?.levelsPerStage ?? 4) + state.level;\n  return total;\n}\n","numLines":398,"startLine":1,"totalLines":398}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_883abc8718504011af2e43f5","type":"tool_result","content":"1\t// App.ts — Game main loop (v0.4.0 — M4: 元婴+化神, 跨区域传送, 高级丹方, 终局内容)\n2\t\n3\timport { Renderer } from './Renderer';\n4\timport { GameMap } from '../game/Map';\n5\timport {\n6\t  type GameState,\n7\t  type BuildingInstance,\n8\t  type AlchemySessionData,\n9\t  type GameMap as GameMapData,\n10\t  type CrossRegionLink,\n11\t  createInitialState,\n12\t  cloneState,\n13\t  setMap,\n14\t  placeBuilding,\n15\t  loadGame,\n16\t  saveGame,\n17\t  startAutoSave,\n18\t  stopAutoSave,\n19\t  addAchievement,\n20\t  addCrossRegionLink,\n21\t} from '../game/GameState';\n22\timport {\n23\t  type BuildingDef,\n24\t  loadBuildingDefs,\n25\t  createBuildingInstance,\n26\t  canPlace,\n27\t} from '../game/Building';\n28\timport {\n29\t  collectFromBuilding,\n30\t  plantField,\n31\t  tickAutoProduction,\n32\t  tickManualProduction,\n33\t  canAfford,\n34\t  deductCost,\n35\t} from '../game/Resources';\n36\timport {\n37\t  type CultivationState,\n38\t  type BreakthroughResult,\n39\t  addCultivationExp,\n40\t  canBreakthrough,\n41\t  attemptBreakthrough,\n42\t  getBreakthroughRequirements,\n43\t  getFullRealmName,\n44\t  isRealmUnlocked as cultivationIsRealmUnlocked,\n45\t  tickAutoCultivation,\n46\t} from '../game/Cultivation';\n47\timport {\n48\t  type AlchemyRecipe,\n49\t  getAvailableRecipes,\n50\t  canCraft,\n51\t  startCrafting,\n52\t  tickAlchemy,\n53\t  collectAlchemy,\n54\t  getRemainingTime,\n55\t} from '../game/Alchemy';\n56\timport {\n57\t  usePill,\n58\t  useMultiplePills,\n59\t  getAllPillDefs,\n60\t  type PillDef,\n61\t} from '../game/Inventory';\n62\timport { audioManager } from '../game/AudioManager';\n63\timport { getAllAchievements, checkAchievement, type AchievementContext } from '../game/Achievement';\n64\timport { getAscensionChallenge, checkAscensionRequirements, attemptAscension } from '../game/Ascension';\n65\timport { tickCrossRegionLinks, createCrossRegionLink, renderCrossRegionPortal } from '../game/CrossRegionTeleport';\n66\timport type { Resources } from '../game/GameState';\n67\timport buildingData from '../data/buildings.json';\n68\timport regionData from '../data/regions.json';\n69\timport {\n70\t  type ConveyorSegment,\n71\t  type ConveyorItem,\n72\t  createSegment,\n73\t  buildSegmentMap,\n74\t  autoConnect,\n75\t  tickConveyorItems,\n76\t  renderConveyorSegment,\n77\t  renderConveyorItems,\n78\t} from '../game/ConveyorBelt';\n79\timport {\n80\t  type PuppetInstance,\n81\t  createPuppet,\n82\t  tickPuppet,\n83\t  renderPuppet,\n84\t} from '../game/Puppet';\n85\t\n86\texport type PlacementMode = BuildingDef | null;\n87\t\n88\texport interface GameNotification {\n89\t  id: number;\n90\t  text: string;\n91\t  type: 'info' | 'success' | 'warning' | 'error';\n92\t  time: number;\n93\t}\n94\t\n95\tinterface RegionDef {\n96\t  id: string;\n97\t  name: string;\n98\t  nameEn: string;\n99\t  width: number;\n100\t  height: number;\n101\t  unlockRealm: string;\n102\t  maxBuildings: number;\n103\t  specialResources: string[];\n104\t  terrainBase: string;\n105\t  color: { bg: string; grid: string };\n106\t}\n107\t\n108\tlet notifIdCounter = 0;\n109\t\n110\texport class App {\n111\t  canvas: HTMLCanvasElement;\n112\t  renderer: Renderer;\n113\t  state: GameState;\n114\t  buildingDefs: Map<string, BuildingDef>;\n115\t  regionDefs: RegionDef[];\n116\t  map: GameMap;\n117\t  currentRegionIndex = 0;\n118\t\n119\t  conveyorSegments: ConveyorSegment[] = [];\n120\t  conveyorItems: ConveyorItem[] = [];\n121\t  puppets: PuppetInstance[] = [];\n122\t\n123\t  private running = false;\n124\t  private lastFrameTime = 0;\n125\t  private animFrameId = 0;\n126\t  private lastTickTime = 0;\n127\t  private tickInterval = 200;\n128\t\n129\t  private hoveredCell: { gx: number; gy: number } | null = null;\n130\t  private clickStartTime = 0;\n131\t  private clickStartPos = { x: 0, y: 0 };\n132\t  placementMode: PlacementMode = null;\n133\t  private placementValid = false;\n134\t  private placementPos = { gx: 0, gy: 0 };\n135\t\n136\t  breakthroughAnim: { active: boolean; result: BreakthroughResult | null; startTime: number; duration: number } = {\n137\t    active: false,\n138\t    result: null,\n139\t    startTime: 0,\n140\t    duration: 3000,\n141\t  };\n142\t\n143\t  notifications: GameNotification[] = [];\n144\t\n145\t  // M4: Ascension animation\n146\t  ascensionAnim: { active: boolean; startTime: number; duration: number } = {\n147\t    active: false,\n148\t    startTime: 0,\n149\t    duration: 5000,\n150\t  };\n151\t\n152\t  onStateChange?: (state: GameState) => void;\n153\t  onBuildingSelect?: (building: BuildingInstance | null) => void;\n154\t  onNotification?: (notif: GameNotification) => void;\n155\t  onBreakthroughAnim?: (active: boolean, result: BreakthroughResult | null) => void;\n156\t  onAlchemyUpdate?: (session: AlchemySessionData | null) => void;\n157\t  onRegionChange?: (regionIndex: number, region: RegionDef) => void;\n158\t  onAchievementUnlocked?: (achievementId: string) => void;\n159\t\n160\t  constructor(canvas: HTMLCanvasElement) {\n161\t    this.canvas = canvas;\n162\t    this.renderer = new Renderer(canvas);\n163\t\n164\t    const saved = loadGame();\n165\t    this.state = saved ? saved : createInitialState();\n166\t\n167\t    this.buildingDefs = loadBuildingDefs(buildingData as unknown as { buildings: BuildingDef[] });\n168\t    this.regionDefs = (regionData as { regions: RegionDef[] }).regions;\n169\t\n170\t    this.map = new GameMap(20, 15, '#2a3a1a', '#3a4a2a');\n171\t    this.map.generateStartingArea();\n172\t\n173\t    if (this.state.maps.length === 0) {\n174\t      this.state = setMap(this.state, 0, {\n175\t        regionId: 'liqi_flat',\n176\t        width: 20,\n177\t        height: 15,\n178\t        terrain: this.map.terrain,\n179\t        buildings: [],\n180\t      });\n181\t    } else {\n182\t      const mapData = this.state.maps[this.state.currentRegionIndex];\n183\t      if (mapData) {\n184\t        this.currentRegionIndex = this.state.currentRegionIndex;\n185\t        this.loadRegionMap(this.currentRegionIndex);\n186\t      }\n187\t    }\n188\t\n189\t    this.setupInput(canvas);\n190\t\n191\t    window.addEventListener('resize', () => {\n192\t      this.renderer.resize();\n193\t    });\n194\t  }\n195\t\n196\t  private loadRegionMap(index: number): void {\n197\t    const mapData = this.state.maps[index];\n198\t    if (!mapData) return;\n199\t\n200\t    const regionDef = this.regionDefs.find(r => r.id === mapData.regionId);\n201\t    const bg = regionDef?.color.bg ?? '#2a3a1a';\n202\t    const grid = regionDef?.color.grid ?? '#3a4a2a';\n203\t\n204\t    this.map = new GameMap(mapData.width, mapData.height, bg, grid);\n205\t    this.map.terrain = mapData.terrain;\n206\t    this.currentRegionIndex = index;\n207\t  }\n208\t\n209\t  initRegion(regionDef: RegionDef): number {\n210\t    const existing = this.state.maps.findIndex(m => m.regionId === regionDef.id);\n211\t    if (existing >= 0) return existing;\n212\t\n213\t    const newMap = new GameMap(regionDef.width, regionDef.height, regionDef.color.bg, regionDef.color.grid);\n214\t    newMap.generateRegionTerrain(regionDef.id);\n215\t\n216\t    const index = this.state.maps.length;\n217\t    this.state = setMap(this.state, index, {\n218\t      regionId: regionDef.id,\n219\t      width: regionDef.width,\n220\t      height: regionDef.height,\n221\t      terrain: newMap.terrain,\n222\t      buildings: [],\n223\t    });\n224\t\n225\t    return index;\n226\t  }\n227\t\n228\t  switchRegion(index: number): boolean {\n229\t    if (index < 0 || index >= this.state.maps.length) return false;\n230\t    if (index === this.currentRegionIndex) return false;\n231\t\n232\t    this.currentRegionIndex = index;\n233\t    this.state.currentRegionIndex = index;\n234\t    this.loadRegionMap(index);\n235\t\n236\t    const regionDef = this.regionDefs.find(r => r.id === this.state.maps[index]?.regionId);\n237\t    if (regionDef) {\n238\t      this.onRegionChange?.(index, regionDef);\n239\t    }\n240\t\n241\t    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);\n242\t    this.onStateChange?.(this.state);\n243\t    return true;\n244\t  }\n245\t\n246\t  getUnlockedRegions(): Array<RegionDef & { index: number }> {\n247\t    return this.regionDefs\n248\t      .map((r) => {\n249\t        if (cultivationIsRealmUnlocked(r.unlockRealm, this.state.cultivation)) {\n250\t          const mapIndex = this.state.maps.findIndex(m => m.regionId === r.id);\n251\t          if (mapIndex < 0) {\n252\t            this.initRegion(r);\n253\t          }\n254\t          const actualIndex = Math.max(0, this.state.maps.findIndex(m => m.regionId === r.id));\n255\t          return { ...r, index: actualIndex };\n256\t        }\n257\t        return null;\n258\t      })\n259\t      .filter((r): r is RegionDef & { index: number } => r !== null);\n260\t  }\n261\t\n262\t  start(): void {\n263\t    if (this.running) return;\n264\t    this.running = true;\n265\t    this.lastFrameTime = performance.now();\n266\t    this.lastTickTime = this.lastFrameTime;\n267\t    this.loop(this.lastFrameTime);\n268\t\n269\t    startAutoSave(() => this.state);\n270\t  }\n271\t\n272\t  stop(): void {\n273\t    this.running = false;\n274\t    if (this.animFrameId) {\n275\t      cancelAnimationFrame(this.animFrameId);\n276\t    }\n277\t    stopAutoSave();\n278\t    saveGame(this.state);\n279\t  }\n280\t\n281\t  private loop = (now: number): void => {\n282\t    if (!this.running) return;\n283\t\n284\t    const dt = now - this.lastFrameTime;\n285\t    this.lastFrameTime = now;\n286\t\n287\t    this.state.totalPlaytime += dt / 1000;\n288\t\n289\t    if (now - this.lastTickTime >= this.tickInterval) {\n290\t      this.tickProduction(now);\n291\t      this.lastTickTime = now;\n292\t    }\n293\t\n294\t    this.render(now);\n295\t\n296\t    this.animFrameId = requestAnimationFrame(this.loop);\n297\t  };\n298\t\n299\t  private tickProduction(now: number): void {\n300\t    this.state = tickAutoProduction(this.state, this.currentRegionIndex, now, this.buildingDefs);\n301\t    this.state = tickManualProduction(this.state, this.currentRegionIndex, now, this.buildingDefs);\n302\t\n303\t    this.state.cultivation = tickAutoCultivation(this.state.cultivation, this.tickInterval);\n304\t\n305\t    if (this.state.alchemySession) {\n306\t      this.state.alchemySession = tickAlchemy(this.state.alchemySession, now);\n307\t      this.onAlchemyUpdate?.(this.state.alchemySession);\n308\t    }\n309\t\n310\t    // M3: Conveyor items tick\n311\t    if (this.conveyorSegments.length > 0) {\n312\t      const segMap = buildSegmentMap(this.conveyorSegments);\n313\t      const result = tickConveyorItems(this.conveyorItems, segMap, this.tickInterval);\n314\t      this.conveyorItems = result.items;\n315\t\n316\t      for (const d of result.delivered) {\n317\t        const delta: Partial<Resources> = {};\n318\t        (delta as Record<string, number>)[d.resource] = d.amount;\n319\t        this.state = { ...this.state, resources: { ...this.state.resources, [d.resource]: (this.state.resources[d.resource] ?? 0) + d.amount } };\n320\t      }\n321\t    }\n322\t\n323\t    // M3: Puppet tick\n324\t    for (let i = 0; i < this.puppets.length; i++) {\n325\t      this.puppets[i] = tickPuppet(this.puppets[i], this.tickInterval);\n326\t    }\n327\t\n328\t    // M4: Cross-region teleport tick\n329\t    if (this.state.crossRegionLinks.length > 0) {\n330\t      const crResult = tickCrossRegionLinks(this.state.crossRegionLinks, this.state.resources, now);\n331\t      this.state.crossRegionLinks = crResult.links;\n332\t\n333\t      for (const t of crResult.transferred) {\n334\t        this.state = { ...this.state, resources: { ...this.state.resources, [t.resource]: (this.state.resources[t.resource] ?? 0) + t.amount } };\n335\t      }\n336\t    }\n337\t\n338\t    // M4: Achievement check (every 5 seconds)\n339\t    if (Math.floor(now / 5000) !== Math.floor((now - this.tickInterval) / 5000)) {\n340\t      this.checkAchievements();\n341\t    }\n342\t\n343\t    this.onStateChange?.(this.state);\n344\t  }\n345\t\n346\t  // M4: Achievement checking\n347\t  private checkAchievements(): void {\n348\t    const buildingCounts: Record<string, number> = {};\n349\t    let totalBuildingCount = 0;\n350\t    for (const map of this.state.maps) {\n351\t      for (const b of map.buildings) {\n352\t        buildingCounts[b.buildingId] = (buildingCounts[b.buildingId] ?? 0) + 1;\n353\t        totalBuildingCount++;\n354\t      }\n355\t    }\n356\t\n357\t    const unlockedRegions = this.regionDefs\n358\t      .filter(r => cultivationIsRealmUnlocked(r.unlockRealm, this.state.cultivation))\n359\t      .map(r => r.id);\n360\t\n361\t    const context: AchievementContext = {\n362\t      currentRealmId: this.state.cultivation.realmId,\n363\t      realmOrder: ['fanren', 'liqi', 'zhuji', 'jindan', 'yuanying', 'huashen'],\n364\t      totalResourcesCollected: this.state.resources as Record<string, number>,\n365\t      buildingCounts,\n366\t      totalBuildingCount,\n367\t      pillsCrafted: {},\n368\t      totalPillsCrafted: 0,\n369\t      allPillTypesCrafted: false,\n370\t      unlockedRegions,\n371\t      ascensionCompleted: this.state.ascensionCompleted,\n372\t      playtimeHours: this.state.totalPlaytime / 3600,\n373\t      crossRegionLinkCount: this.state.crossRegionLinks.length,\n374\t    };\n375\t\n376\t    for (const ach of getAllAchievements()) {\n377\t      if (this.state.achievements.includes(ach.id)) continue;\n378\t      if (checkAchievement(ach, context)) {\n379\t        this.state = addAchievement(this.state, ach.id);\n380\t        this.addNotification(`🏆 成就解锁: ${ach.name}`, 'success');\n381\t        this.onAchievementUnlocked?.(ach.id);\n382\t      }\n383\t    }\n384\t  }\n385\t\n386\t  private render(now: number): void {\n387\t    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n388\t    const preview = this.placementMode\n389\t      ? { def: this.placementMode, gx: this.placementPos.gx, gy: this.placementPos.gy, valid: this.placementValid }\n390\t      : null;\n391\t\n392\t    this.renderer.render(\n393\t      this.map,\n394\t      buildings,\n395\t      this.buildingDefs,\n396\t      this.state.resources,\n397\t      this.state.realm,\n398\t      this.state.cultivation,\n399\t      this.hoveredCell,\n400\t      preview,\n401\t      now,\n402\t    );\n403\t\n404\t    const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n405\t    const segMap = buildSegmentMap(this.conveyorSegments);\n406\t    for (const seg of this.conveyorSegments) {\n407\t      renderConveyorSegment(this.renderer.ctx, seg, offsetX, offsetY, scale, this.map.cellSize, now);\n408\t    }\n409\t    renderConveyorItems(this.renderer.ctx, this.conveyorItems, segMap, offsetX, offsetY, scale, this.map.cellSize);\n410\t\n411\t    for (const puppet of this.puppets) {\n412\t      renderPuppet(this.renderer.ctx, puppet, offsetX, offsetY, scale, this.map.cellSize, now);\n413\t    }\n414\t\n415\t    // M4: Render cross-region portals in current map\n416\t    for (const link of this.state.crossRegionLinks) {\n417\t      if (link.fromRegionIndex === this.currentRegionIndex) {\n418\t        renderCrossRegionPortal(this.renderer.ctx, link.fromX, link.fromY, offsetX, offsetY, scale, this.map.cellSize, now);\n419\t      }\n420\t    }\n421\t\n422\t    if (this.breakthroughAnim.active) {\n423\t      this.renderBreakthroughOverlay(now);\n424\t    }\n425\t\n426\t    if (this.ascensionAnim.active) {\n427\t      this.renderAscensionOverlay(now);\n428\t    }\n429\t  }\n430\t\n431\t  private renderBreakthroughOverlay(now: number): void {\n432\t    const ctx = this.renderer.ctx;\n433\t    const w = this.canvas.getBoundingClientRect().width;\n434\t    const h = this.canvas.getBoundingClientRect().height;\n435\t\n436\t    const elapsed = now - this.breakthroughAnim.startTime;\n437\t    const progress = Math.min(1, elapsed / this.breakthroughAnim.duration);\n438\t\n439\t    let alpha = 0;\n440\t    if (progress < 0.2) alpha = progress / 0.2;\n441\t    else if (progress > 0.8) alpha = (1 - progress) / 0.2;\n442\t    else alpha = 1;\n443\t\n444\t    const result = this.breakthroughAnim.result;\n445\t\n446\t    if (result?.success) {\n447\t      ctx.fillStyle = `rgba(255, 215, 0, ${alpha * 0.15})`;\n448\t      ctx.fillRect(0, 0, w, h);\n449\t\n450\t      ctx.fillStyle = `rgba(255, 215, 0, ${alpha})`;\n451\t      ctx.font = `bold ${24 + Math.sin(progress * Math.PI * 4) * 4}px serif`;\n452\t      ctx.textAlign = 'center';\n453\t      ctx.textBaseline = 'middle';\n454\t      ctx.fillText('⚡ 境界突破成功 ⚡', w / 2, h / 2 - 20);\n455\t\n456\t      ctx.font = '16px serif';\n457\t      ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;\n458\t      const realmName = getFullRealmName(this.state.cultivation);\n459\t      ctx.fillText(`进入 ${realmName}`, w / 2, h / 2 + 20);\n460\t    } else if (result) {\n461\t      ctx.fillStyle = `rgba(200, 50, 50, ${alpha * 0.15})`;\n462\t      ctx.fillRect(0, 0, w, h);\n463\t\n464\t      ctx.fillStyle = `rgba(255, 100, 100, ${alpha})`;\n465\t      ctx.font = 'bold 24px serif';\n466\t      ctx.textAlign = 'center';\n467\t      ctx.textBaseline = 'middle';\n468\t      ctx.fillText('突破失败...', w / 2, h / 2 - 20);\n469\t\n470\t      ctx.font = '14px serif';\n471\t      ctx.fillStyle = `rgba(255, 200, 200, ${alpha})`;\n472\t      ctx.fillText(`修为损失 ${Math.floor(result.penalty * 100)}%`, w / 2, h / 2 + 20);\n473\t    }\n474\t\n475\t    if (progress >= 1) {\n476\t      this.breakthroughAnim.active = false;\n477\t      this.breakthroughAnim.result = null;\n478\t      this.onBreakthroughAnim?.(false, null);\n479\t    }\n480\t  }\n481\t\n482\t  // M4: Ascension animation overlay\n483\t  private renderAscensionOverlay(now: number): void {\n484\t    const ctx = this.renderer.ctx;\n485\t    const w = this.canvas.getBoundingClientRect().width;\n486\t    const h = this.canvas.getBoundingClientRect().height;\n487\t\n488\t    const elapsed = now - this.ascensionAnim.startTime;\n489\t    const progress = Math.min(1, elapsed / this.ascensionAnim.duration);\n490\t\n491\t    // Golden-white gradient overlay\n492\t    let alpha = 0;\n493\t    if (progress < 0.15) alpha = progress / 0.15;\n494\t    else if (progress > 0.85) alpha = (1 - progress) / 0.15;\n495\t    else alpha = 1;\n496\t\n497\t    ctx.fillStyle = `rgba(255, 255, 200, ${alpha * 0.2})`;\n498\t    ctx.fillRect(0, 0, w, h);\n499\t\n500\t    // Radiating lines\n501\t    const centerX = w / 2;\n502\t    const centerY = h / 2;\n503\t    const lineCount = 12;\n504\t    for (let i = 0; i < lineCount; i++) {\n505\t      const angle = (i / lineCount) * Math.PI * 2 + progress * Math.PI;\n506\t      const len = 200 + Math.sin(progress * Math.PI * 6 + i) * 100;\n507\t      ctx.strokeStyle = `rgba(255, 215, 0, ${alpha * 0.3})`;\n508\t      ctx.lineWidth = 2;\n509\t      ctx.beginPath();\n510\t      ctx.moveTo(centerX, centerY);\n511\t      ctx.lineTo(centerX + Math.cos(angle) * len, centerY + Math.sin(angle) * len);\n512\t      ctx.stroke();\n513\t    }\n514\t\n515\t    ctx.fillStyle = `rgba(255, 215, 0, ${alpha})`;\n516\t    ctx.font = `bold ${28 + Math.sin(progress * Math.PI * 3) * 6}px serif`;\n517\t    ctx.textAlign = 'center';\n518\t    ctx.textBaseline = 'middle';\n519\t    ctx.fillText('🌟 飞升成功 🌟', w / 2, h / 2 - 30);\n520\t\n521\t    ctx.font = '18px serif';\n522\t    ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;\n523\t    ctx.fillText('飞升仙尊 — 全局效率×10', w / 2, h / 2 + 15);\n524\t\n525\t    ctx.font = '14px serif';\n526\t    ctx.fillStyle = `rgba(200, 200, 255, ${alpha})`;\n527\t    ctx.fillText('恭喜完成飞升挑战！', w / 2, h / 2 + 50);\n528\t\n529\t    if (progress >= 1) {\n530\t      this.ascensionAnim.active = false;\n531\t    }\n532\t  }\n533\t\n534\t  placeCurrentBuilding(): boolean {\n535\t    if (!this.placementMode) return false;\n536\t\n537\t    const def = this.placementMode;\n538\t    const { gx, gy } = this.placementPos;\n539\t\n540\t    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n541\t    if (!canPlace(this.map, def, gx, gy, buildings)) return false;\n542\t    if (!canAfford(this.state.resources, def.cost)) return false;\n543\t\n544\t    this.state = deductCost(this.state, def.cost);\n545\t\n546\t    // Handle conveyor/puppet placement\n547\t    if (def.category === 'transport' && (def.id === 'conveyor_lv1' || def.id === 'conveyor_lv2')) {\n548\t      const seg = createSegment(\n549\t        `seg_${Date.now()}_${Math.random().toString(36).slice(2)}`,\n550\t        gx, gy,\n551\t        def.id === 'conveyor_lv1' ? 1 : 2,\n552\t        'right',\n553\t      );\n554\t      const segMap = buildSegmentMap(this.conveyorSegments);\n555\t      this.conveyorSegments.push(autoConnect(seg, segMap));\n556\t      audioManager.playBuild();\n557\t      this.addNotification(`放置了 ${def.name}`, 'success');\n558\t      this.onStateChange?.(this.state);\n559\t      return true;\n560\t    }\n561\t\n562\t    if (def.category === 'automation' && def.id === 'puppet_sorter') {\n563\t      const puppet = createPuppet(\n564\t        `pup_${Date.now()}_${Math.random().toString(36).slice(2)}`,\n565\t        gx, gy, 1,\n566\t      );\n567\t      this.puppets.push(puppet);\n568\t      audioManager.playBuild();\n569\t      this.addNotification(`放置了 ${def.name}`, 'success');\n570\t      this.onStateChange?.(this.state);\n571\t      return true;\n572\t    }\n573\t\n574\t    const instance = createBuildingInstance(def.id, gx, gy);\n575\t    this.state = placeBuilding(this.state, this.currentRegionIndex, instance);\n576\t\n577\t    audioManager.playBuild();\n578\t    this.addNotification(`建造了 ${def.name}`, 'success');\n579\t    this.onStateChange?.(this.state);\n580\t    return true;\n581\t  }\n582\t\n583\t  private handleBuildingClick(building: BuildingInstance): void {\n584\t    const def = this.buildingDefs.get(building.buildingId);\n585\t    if (!def) return;\n586\t\n587\t    if (def.production.mode === 'manual') {\n588\t      if (def.category === 'farming') {\n589\t        if (!building.isProducing && building.progress < 1) {\n590\t          this.state = plantField(this.state, building, this.currentRegionIndex);\n591\t          audioManager.playCollect();\n592\t        } else if (building.progress >= 1) {\n593\t          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n594\t          audioManager.playHarvest();\n595\t          this.addNotification(`收获 ${def.production.amount} ${this.getResourceName(def.production.resource)}`, 'success');\n596\t        }\n597\t      } else if (def.category === 'mining') {\n598\t        this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n599\t        audioManager.playCollect();\n600\t      } else if (def.category === 'alchemy') {\n601\t        if (building.progress >= 1) {\n602\t          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n603\t          audioManager.playAlchemyComplete();\n604\t          this.addNotification(`获得 ${def.production.amount} ${this.getResourceName(def.production.resource)}`, 'success');\n605\t        } else if (!building.isProducing) {\n606\t          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n607\t          audioManager.playAlchemyStart();\n608\t        }\n609\t      } else if (def.category === 'cultivation') {\n610\t        if (!building.isProducing) {\n611\t          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n612\t        }\n613\t      }\n614\t      this.onStateChange?.(this.state);\n615\t    }\n616\t\n617\t    this.onBuildingSelect?.(building);\n618\t  }\n619\t\n620\t  usePillAction(pillId: string): boolean {\n621\t    const result = usePill(pillId, this.state.resources);\n622\t    if (!result) return false;\n623\t\n624\t    this.state.resources = result.resources as Resources;\n625\t    this.state.cultivation = addCultivationExp(this.state.cultivation, result.cultivation);\n626\t    this.state = this.addCultivationToRealm(result.cultivation);\n627\t\n628\t    audioManager.playUsePill();\n629\t    const pillName = this.getResourceName(pillId);\n630\t    this.addNotification(`服用 ${pillName}，修为+${result.cultivation}`, 'success');\n631\t    this.onStateChange?.(this.state);\n632\t    return true;\n633\t  }\n634\t\n635\t  useAllPills(pillId: string): boolean {\n636\t    const count = this.state.resources[pillId as keyof typeof this.state.resources] ?? 0;\n637\t    if (count <= 0) return false;\n638\t\n639\t    const result = useMultiplePills(pillId, count, this.state.resources);\n640\t    if (!result) return false;\n641\t\n642\t    this.state.resources = result.resources as Resources;\n643\t    this.state.cultivation = addCultivationExp(this.state.cultivation, result.cultivation);\n644\t    this.state = this.addCultivationToRealm(result.cultivation);\n645\t\n646\t    audioManager.playUsePill();\n647\t    this.addNotification(`服用 ${result.used} ${this.getResourceName(pillId)}，修为+${result.cultivation}`, 'success');\n648\t    this.onStateChange?.(this.state);\n649\t    return true;\n650\t  }\n651\t\n652\t  private addCultivationToRealm(amount: number): GameState {\n653\t    const next = cloneState(this.state);\n654\t    next.realm.exp += amount;\n655\t    while (next.realm.exp >= next.realm.expToNext) {\n656\t      next.realm.exp -= next.realm.expToNext;\n657\t      next.realm.level += 1;\n658\t      next.realm.expToNext = Math.floor(next.realm.expToNext * 1.8);\n659\t    }\n660\t    return next;\n661\t  }\n662\t\n663\t  attemptBreakthroughAction(): boolean {\n664\t    if (!canBreakthrough(this.state.cultivation)) {\n665\t      this.addNotification('修为不足，无法突破', 'warning');\n666\t      return false;\n667\t    }\n668\t\n669\t    const result = attemptBreakthrough(this.state.cultivation, this.state.resources);\n670\t    if (!result) {\n671\t      this.addNotification('材料不足，无法突破', 'warning');\n672\t      return false;\n673\t    }\n674\t\n675\t    this.state.cultivation = result.newState;\n676\t    this.state.resources = result.newResources as Resources;\n677\t\n678\t    if (result.result.success) {\n679\t      this.state.realm.realmId = result.newState.realmId;\n680\t      this.state.realm.level = result.newState.level;\n681\t      this.state.realm.exp = result.newState.exp;\n682\t      this.state.realm.expToNext = result.newState.expToNext;\n683\t    }\n684\t\n685\t    this.breakthroughAnim = {\n686\t      active: true,\n687\t      result: result.result,\n688\t      startTime: performance.now(),\n689\t      duration: 3000,\n690\t    };\n691\t\n692\t    if (result.result.success) {\n693\t      audioManager.playBreakthroughSuccess();\n694\t      this.addNotification(`突破成功！进入 ${getFullRealmName(this.state.cultivation)}`, 'success');\n695\t    } else {\n696\t      audioManager.playBreakthroughFail();\n697\t      this.addNotification(`突破失败，修为损失 ${Math.floor(result.result.penalty * 100)}%`, 'error');\n698\t    }\n699\t\n700\t    this.onBreakthroughAnim?.(true, result.result);\n701\t    this.onStateChange?.(this.state);\n702\t    return true;\n703\t  }\n704\t\n705\t  getBreakthroughInfo() {\n706\t    return getBreakthroughRequirements(this.state.cultivation);\n707\t  }\n708\t\n709\t  // === M4: Ascension Actions ===\n710\t\n711\t  getAscensionInfo() {\n712\t    return checkAscensionRequirements(this.state.resources, this.state.cultivation.totalCultivation);\n713\t  }\n714\t\n715\t  attemptAscensionAction(): boolean {\n716\t    const result = attemptAscension(this.state.resources, this.state.cultivation.totalCultivation);\n717\t    if (!result.success) {\n718\t      this.addNotification('飞升条件不满足', 'warning');\n719\t      return false;\n720\t    }\n721\t\n722\t    this.state.resources = result.newResources as Resources;\n723\t    this.state.ascensionCompleted = true;\n724\t\n725\t    this.ascensionAnim = {\n726\t      active: true,\n727\t      startTime: performance.now(),\n728\t      duration: 5000,\n729\t    };\n730\t\n731\t    audioManager.playBreakthroughSuccess();\n732\t    this.addNotification('🌟 飞升成功！获得称号：飞升仙尊', 'success');\n733\t    this.onStateChange?.(this.state);\n734\t    return true;\n735\t  }\n736\t\n737\t  // === M4: Cross-Region Link ===\n738\t\n739\t  createCrossRegionLinkAction(\n740\t    fromRegionIndex: number,\n741\t    fromX: number,\n742\t    fromY: number,\n743\t    toRegionIndex: number,\n744\t    toX: number,\n745\t    toY: number,\n746\t    resource: string,\n747\t    amount: number,\n748\t    interval: number,\n749\t  ): boolean {\n750\t    const id = `crl_${Date.now()}_${Math.random().toString(36).slice(2)}`;\n751\t    const link = createCrossRegionLink(id, fromRegionIndex, fromX, fromY, toRegionIndex, toX, toY, resource, amount, interval);\n752\t    this.state = addCrossRegionLink(this.state, link);\n753\t    this.addNotification(`建立跨区域传送链路`, 'success');\n754\t    this.onStateChange?.(this.state);\n755\t    return true;\n756\t  }\n757\t\n758\t  // === Alchemy Actions ===\n759\t\n760\t  getAvailableAlchemyRecipes(): AlchemyRecipe[] {\n761\t    return getAvailableRecipes((realm) => cultivationIsRealmUnlocked(realm, this.state.cultivation));\n762\t  }\n763\t\n764\t  startAlchemyAction(recipeId: string): boolean {\n765\t    const crafting = startCrafting(recipeId, this.state.resources);\n766\t    if (!crafting) return false;\n767\t\n768\t    this.state.resources = crafting.resources as Resources;\n769\t    this.state.alchemySession = crafting.session;\n770\t    audioManager.playAlchemyStart();\n771\t    this.addNotification(`开始炼丹`, 'info');\n772\t    this.onStateChange?.(this.state);\n773\t    this.onAlchemyUpdate?.(this.state.alchemySession);\n774\t    return true;\n775\t  }\n776\t\n777\t  collectAlchemyAction(): boolean {\n778\t    if (!this.state.alchemySession?.complete) return false;\n779\t\n780\t    const result = collectAlchemy(this.state.alchemySession, this.state.resources);\n781\t    if (!result) return false;\n782\t\n783\t    this.state.resources = result.resources as Resources;\n784\t    this.state.alchemySession = null;\n785\t\n786\t    if (result.success) {\n787\t      this.state.cultivation = addCultivationExp(this.state.cultivation, result.expReward);\n788\t      audioManager.playAlchemyComplete();\n789\t      this.addNotification(`炼丹成功！获得 ${result.amount} 颗丹药`, 'success');\n790\t    } else {\n791\t      audioManager.playAlchemyFail();\n792\t      this.addNotification('炼丹失败...', 'error');\n793\t    }\n794\t\n795\t    this.onStateChange?.(this.state);\n796\t    this.onAlchemyUpdate?.(null);\n797\t    return true;\n798\t  }\n799\t\n800\t  // === Notifications ===\n801\t\n802\t  addNotification(text: string, type: GameNotification['type'] = 'info'): void {\n803\t    const notif: GameNotification = {\n804\t      id: ++notifIdCounter,\n805\t      text,\n806\t      type,\n807\t      time: Date.now(),\n808\t    };\n809\t    this.notifications.push(notif);\n810\t    if (this.notifications.length > 10) {\n811\t      this.notifications = this.notifications.slice(-10);\n812\t    }\n813\t    this.onNotification?.(notif);\n814\t  }\n815\t\n816\t  // === Utility ===\n817\t\n818\t  private getResourceName(id: string): string {\n819\t    const names: Record<string, string> = {\n820\t      spirit_stone: '灵石',\n821\t      spirit_grass: '灵草',\n822\t      spirit_energy: '灵气',\n823\t      cultivation: '修为',\n824\t      pill_juling: '聚灵丹',\n825\t      pill_peiyuan: '培元丹',\n826\t      pill_ningqi: '凝气丹',\n827\t      pill_zhuji: '筑基丹',\n828\t      pill_jindanyin: '金丹引',\n829\t      pill_yuanyingguo: '元婴果',\n830\t      pill_huashenlu: '化神露',\n831\t      pill_jiuzhuan: '九转金丹',\n832\t      spirit_iron: '灵铁',\n833\t      spirit_wood: '灵木',\n834\t      talisman_paper: '符纸',\n835\t      monster_core: '妖丹',\n836\t      heaven_earth_liquid: '天地灵液',\n837\t      immortal_stone: '仙灵石',\n838\t      merit: '功德值',\n839\t    };\n840\t    return names[id] ?? id;\n841\t  }\n842\t\n843\t  centerCamera(): void {\n844\t    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);\n845\t  }\n846\t\n847\t  getAvailableBuildings(): BuildingDef[] {\n848\t    return Array.from(this.buildingDefs.values()).filter(def => {\n849\t      return cultivationIsRealmUnlocked(def.unlockRealm, this.state.cultivation);\n850\t    });\n851\t  }\n852\t\n853\t  getInventoryPills(): Array<PillDef & { count: number }> {\n854\t    const result: Array<PillDef & { count: number }> = [];\n855\t    for (const def of getAllPillDefs()) {\n856\t      const count = this.state.resources[def.id as keyof typeof this.state.resources] ?? 0;\n857\t      if (count > 0) {\n858\t        result.push({ ...def, count });\n859\t      }\n860\t    }\n861\t    return result;\n862\t  }\n863\t\n864\t  private setupInput(canvas: HTMLCanvasElement): void {\n865\t    canvas.addEventListener('mousemove', (e) => {\n866\t      const rect = canvas.getBoundingClientRect();\n867\t      const mx = e.clientX - rect.left;\n868\t      const my = e.clientY - rect.top;\n869\t\n870\t      const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n871\t      this.hoveredCell = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n872\t\n873\t      if (this.placementMode && this.hoveredCell) {\n874\t        this.placementPos = { gx: this.hoveredCell.gx, gy: this.hoveredCell.gy };\n875\t        const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n876\t        this.placementValid = canPlace(\n877\t          this.map,\n878\t          this.placementMode,\n879\t          this.placementPos.gx,\n880\t          this.placementPos.gy,\n881\t          buildings,\n882\t        );\n883\t      }\n884\t    });\n885\t\n886\t    canvas.addEventListener('mousedown', (e) => {\n887\t      if (e.button !== 0) return;\n888\t      this.clickStartTime = performance.now();\n889\t      this.clickStartPos = { x: e.clientX, y: e.clientY };\n890\t    });\n891\t\n892\t    canvas.addEventListener('mouseup', (e) => {\n893\t      if (e.button !== 0) return;\n894\t      const dt = performance.now() - this.clickStartTime;\n895\t      const dx = Math.abs(e.clientX - this.clickStartPos.x);\n896\t      const dy = Math.abs(e.clientY - this.clickStartPos.y);\n897\t\n898\t      if (dt < 300 && dx < 5 && dy < 5) {\n899\t        audioManager.init();\n900\t        audioManager.resume();\n901\t        this.handleClick(e);\n902\t      }\n903\t    });\n904\t\n905\t    document.addEventListener('keydown', (e) => {\n906\t      if (e.key === 'Escape') {\n907\t        this.placementMode = null;\n908\t      }\n909\t    });\n910\t  }\n911\t\n912\t  private handleClick(e: MouseEvent): void {\n913\t    const rect = this.canvas.getBoundingClientRect();\n914\t    const mx = e.clientX - rect.left;\n915\t    const my = e.clientY - rect.top;\n916\t    const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n917\t    const { gx, gy } = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n918\t\n919\t    if (!this.map.inBounds(gx, gy)) return;\n920\t\n921\t    if (this.placementMode) {\n922\t      this.placementPos = { gx, gy };\n923\t      const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n924\t      this.placementValid = canPlace(this.map, this.placementMode, gx, gy, buildings);\n925\t      if (this.placementValid) {\n926\t        this.placeCurrentBuilding();\n927\t      }\n928\t      return;\n929\t    }\n930\t\n931\t    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n932\t    const clicked = buildings.find(b => {\n933\t      const def = this.buildingDefs.get(b.buildingId);\n934\t      if (!def) return false;\n935\t      return (\n936\t        gx >= b.gridX && gx < b.gridX + def.size.w &&\n937\t        gy >= b.gridY && gy < b.gridY + def.size.h\n938\t      );\n939\t    });\n940\t\n941\t    if (clicked) {\n942\t      this.handleBuildingClick(clicked);\n943\t    }\n944\t  }\n945\t}\n946\t"}]},"parent_tool_use_id":null,"session_id":"094f9230-fe12-4466-ab83-fdd0d233a191","uuid":"1693a06d-d34a-4f3d-ae11-f8a4b52703cb","timestamp":"2026-05-23T02:55:00.440Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/steam-cultivation-factory/src/renderer/App.ts","content":"// App.ts — Game main loop (v0.4.0 — M4: 元婴+化神, 跨区域传送, 高级丹方, 终局内容)\n\nimport { Renderer } from './Renderer';\nimport { GameMap } from '../game/Map';\nimport {\n  type GameState,\n  type BuildingInstance,\n  type AlchemySessionData,\n  type GameMap as GameMapData,\n  type CrossRegionLink,\n  createInitialState,\n  cloneState,\n  setMap,\n  placeBuilding,\n  loadGame,\n  saveGame,\n  startAutoSave,\n  stopAutoSave,\n  addAchievement,\n  addCrossRegionLink,\n} from '../game/GameState';\nimport {\n  type BuildingDef,\n  loadBuildingDefs,\n  createBuildingInstance,\n  canPlace,\n} from '../game/Building';\nimport {\n  collectFromBuilding,\n  plantField,\n  tickAutoProduction,\n  tickManualProduction,\n  canAfford,\n  deductCost,\n} from '../game/Resources';\nimport {\n  type CultivationState,\n  type BreakthroughResult,\n  addCultivationExp,\n  canBreakthrough,\n  attemptBreakthrough,\n  getBreakthroughRequirements,\n  getFullRealmName,\n  isRealmUnlocked as cultivationIsRealmUnlocked,\n  tickAutoCultivation,\n} from '../game/Cultivation';\nimport {\n  type AlchemyRecipe,\n  getAvailableRecipes,\n  canCraft,\n  startCrafting,\n  tickAlchemy,\n  collectAlchemy,\n  getRemainingTime,\n} from '../game/Alchemy';\nimport {\n  usePill,\n  useMultiplePills,\n  getAllPillDefs,\n  type PillDef,\n} from '../game/Inventory';\nimport { audioManager } from '../game/AudioManager';\nimport { getAllAchievements, checkAchievement, type AchievementContext } from '../game/Achievement';\nimport { getAscensionChallenge, checkAscensionRequirements, attemptAscension } from '../game/Ascension';\nimport { tickCrossRegionLinks, createCrossRegionLink, renderCrossRegionPortal } from '../game/CrossRegionTeleport';\nimport type { Resources } from '../game/GameState';\nimport buildingData from '../data/buildings.json';\nimport regionData from '../data/regions.json';\nimport {\n  type ConveyorSegment,\n  type ConveyorItem,\n  createSegment,\n  buildSegmentMap,\n  autoConnect,\n  tickConveyorItems,\n  renderConveyorSegment,\n  renderConveyorItems,\n} from '../game/ConveyorBelt';\nimport {\n  type PuppetInstance,\n  createPuppet,\n  tickPuppet,\n  renderPuppet,\n} from '../game/Puppet';\n\nexport type PlacementMode = BuildingDef | null;\n\nexport interface GameNotification {\n  id: number;\n  text: string;\n  type: 'info' | 'success' | 'warning' | 'error';\n  time: number;\n}\n\ninterface RegionDef {\n  id: string;\n  name: string;\n  nameEn: string;\n  width: number;\n  height: number;\n  unlockRealm: string;\n  maxBuildings: number;\n  specialResources: string[];\n  terrainBase: string;\n  color: { bg: string; grid: string };\n}\n\nlet notifIdCounter = 0;\n\nexport class App {\n  canvas: HTMLCanvasElement;\n  renderer: Renderer;\n  state: GameState;\n  buildingDefs: Map<string, BuildingDef>;\n  regionDefs: RegionDef[];\n  map: GameMap;\n  currentRegionIndex = 0;\n\n  conveyorSegments: ConveyorSegment[] = [];\n  conveyorItems: ConveyorItem[] = [];\n  puppets: PuppetInstance[] = [];\n\n  private running = false;\n  private lastFrameTime = 0;\n  private animFrameId = 0;\n  private lastTickTime = 0;\n  private tickInterval = 200;\n\n  private hoveredCell: { gx: number; gy: number } | null = null;\n  private clickStartTime = 0;\n  private clickStartPos = { x: 0, y: 0 };\n  placementMode: PlacementMode = null;\n  private placementValid = false;\n  private placementPos = { gx: 0, gy: 0 };\n\n  breakthroughAnim: { active: boolean; result: BreakthroughResult | null; startTime: number; duration: number } = {\n    active: false,\n    result: null,\n    startTime: 0,\n    duration: 3000,\n  };\n\n  notifications: GameNotification[] = [];\n\n  // M4: Ascension animation\n  ascensionAnim: { active: boolean; startTime: number; duration: number } = {\n    active: false,\n    startTime: 0,\n    duration: 5000,\n  };\n\n  onStateChange?: (state: GameState) => void;\n  onBuildingSelect?: (building: BuildingInstance | null) => void;\n  onNotification?: (notif: GameNotification) => void;\n  onBreakthroughAnim?: (active: boolean, result: BreakthroughResult | null) => void;\n  onAlchemyUpdate?: (session: AlchemySessionData | null) => void;\n  onRegionChange?: (regionIndex: number, region: RegionDef) => void;\n  onAchievementUnlocked?: (achievementId: string) => void;\n\n  constructor(canvas: HTMLCanvasElement) {\n    this.canvas = canvas;\n    this.renderer = new Renderer(canvas);\n\n    const saved = loadGame();\n    this.state = saved ? saved : createInitialState();\n\n    this.buildingDefs = loadBuildingDefs(buildingData as unknown as { buildings: BuildingDef[] });\n    this.regionDefs = (regionData as { regions: RegionDef[] }).regions;\n\n    this.map = new GameMap(20, 15, '#2a3a1a', '#3a4a2a');\n    this.map.generateStartingArea();\n\n    if (this.state.maps.length === 0) {\n      this.state = setMap(this.state, 0, {\n        regionId: 'liqi_flat',\n        width: 20,\n        height: 15,\n        terrain: this.map.terrain,\n        buildings: [],\n      });\n    } else {\n      const mapData = this.state.maps[this.state.currentRegionIndex];\n      if (mapData) {\n        this.currentRegionIndex = this.state.currentRegionIndex;\n        this.loadRegionMap(this.currentRegionIndex);\n      }\n    }\n\n    this.setupInput(canvas);\n\n    window.addEventListener('resize', () => {\n      this.renderer.resize();\n    });\n  }\n\n  private loadRegionMap(index: number): void {\n    const mapData = this.state.maps[index];\n    if (!mapData) return;\n\n    const regionDef = this.regionDefs.find(r => r.id === mapData.regionId);\n    const bg = regionDef?.color.bg ?? '#2a3a1a';\n    const grid = regionDef?.color.grid ?? '#3a4a2a';\n\n    this.map = new GameMap(mapData.width, mapData.height, bg, grid);\n    this.map.terrain = mapData.terrain;\n    this.currentRegionIndex = index;\n  }\n\n  initRegion(regionDef: RegionDef): number {\n    const existing = this.state.maps.findIndex(m => m.regionId === regionDef.id);\n    if (existing >= 0) return existing;\n\n    const newMap = new GameMap(regionDef.width, regionDef.height, regionDef.color.bg, regionDef.color.grid);\n    newMap.generateRegionTerrain(regionDef.id);\n\n    const index = this.state.maps.length;\n    this.state = setMap(this.state, index, {\n      regionId: regionDef.id,\n      width: regionDef.width,\n      height: regionDef.height,\n      terrain: newMap.terrain,\n      buildings: [],\n    });\n\n    return index;\n  }\n\n  switchRegion(index: number): boolean {\n    if (index < 0 || index >= this.state.maps.length) return false;\n    if (index === this.currentRegionIndex) return false;\n\n    this.currentRegionIndex = index;\n    this.state.currentRegionIndex = index;\n    this.loadRegionMap(index);\n\n    const regionDef = this.regionDefs.find(r => r.id === this.state.maps[index]?.regionId);\n    if (regionDef) {\n      this.onRegionChange?.(index, regionDef);\n    }\n\n    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  getUnlockedRegions(): Array<RegionDef & { index: number }> {\n    return this.regionDefs\n      .map((r) => {\n        if (cultivationIsRealmUnlocked(r.unlockRealm, this.state.cultivation)) {\n          const mapIndex = this.state.maps.findIndex(m => m.regionId === r.id);\n          if (mapIndex < 0) {\n            this.initRegion(r);\n          }\n          const actualIndex = Math.max(0, this.state.maps.findIndex(m => m.regionId === r.id));\n          return { ...r, index: actualIndex };\n        }\n        return null;\n      })\n      .filter((r): r is RegionDef & { index: number } => r !== null);\n  }\n\n  start(): void {\n    if (this.running) return;\n    this.running = true;\n    this.lastFrameTime = performance.now();\n    this.lastTickTime = this.lastFrameTime;\n    this.loop(this.lastFrameTime);\n\n    startAutoSave(() => this.state);\n  }\n\n  stop(): void {\n    this.running = false;\n    if (this.animFrameId) {\n      cancelAnimationFrame(this.animFrameId);\n    }\n    stopAutoSave();\n    saveGame(this.state);\n  }\n\n  private loop = (now: number): void => {\n    if (!this.running) return;\n\n    const dt = now - this.lastFrameTime;\n    this.lastFrameTime = now;\n\n    this.state.totalPlaytime += dt / 1000;\n\n    if (now - this.lastTickTime >= this.tickInterval) {\n      this.tickProduction(now);\n      this.lastTickTime = now;\n    }\n\n    this.render(now);\n\n    this.animFrameId = requestAnimationFrame(this.loop);\n  };\n\n  private tickProduction(now: number): void {\n    this.state = tickAutoProduction(this.state, this.currentRegionIndex, now, this.buildingDefs);\n    this.state = tickManualProduction(this.state, this.currentRegionIndex, now, this.buildingDefs);\n\n    this.state.cultivation = tickAutoCultivation(this.state.cultivation, this.tickInterval);\n\n    if (this.state.alchemySession) {\n      this.state.alchemySession = tickAlchemy(this.state.alchemySession, now);\n      this.onAlchemyUpdate?.(this.state.alchemySession);\n    }\n\n    // M3: Conveyor items tick\n    if (this.conveyorSegments.length > 0) {\n      const segMap = buildSegmentMap(this.conveyorSegments);\n      const result = tickConveyorItems(this.conveyorItems, segMap, this.tickInterval);\n      this.conveyorItems = result.items;\n\n      for (const d of result.delivered) {\n        const delta: Partial<Resources> = {};\n        (delta as Record<string, number>)[d.resource] = d.amount;\n        this.state = { ...this.state, resources: { ...this.state.resources, [d.resource]: (this.state.resources[d.resource] ?? 0) + d.amount } };\n      }\n    }\n\n    // M3: Puppet tick\n    for (let i = 0; i < this.puppets.length; i++) {\n      this.puppets[i] = tickPuppet(this.puppets[i], this.tickInterval);\n    }\n\n    // M4: Cross-region teleport tick\n    if (this.state.crossRegionLinks.length > 0) {\n      const crResult = tickCrossRegionLinks(this.state.crossRegionLinks, this.state.resources, now);\n      this.state.crossRegionLinks = crResult.links;\n\n      for (const t of crResult.transferred) {\n        this.state = { ...this.state, resources: { ...this.state.resources, [t.resource]: (this.state.resources[t.resource] ?? 0) + t.amount } };\n      }\n    }\n\n    // M4: Achievement check (every 5 seconds)\n    if (Math.floor(now / 5000) !== Math.floor((now - this.tickInterval) / 5000)) {\n      this.checkAchievements();\n    }\n\n    this.onStateChange?.(this.state);\n  }\n\n  // M4: Achievement checking\n  private checkAchievements(): void {\n    const buildingCounts: Record<string, number> = {};\n    let totalBuildingCount = 0;\n    for (const map of this.state.maps) {\n      for (const b of map.buildings) {\n        buildingCounts[b.buildingId] = (buildingCounts[b.buildingId] ?? 0) + 1;\n        totalBuildingCount++;\n      }\n    }\n\n    const unlockedRegions = this.regionDefs\n      .filter(r => cultivationIsRealmUnlocked(r.unlockRealm, this.state.cultivation))\n      .map(r => r.id);\n\n    const context: AchievementContext = {\n      currentRealmId: this.state.cultivation.realmId,\n      realmOrder: ['fanren', 'liqi', 'zhuji', 'jindan', 'yuanying', 'huashen'],\n      totalResourcesCollected: this.state.resources as Record<string, number>,\n      buildingCounts,\n      totalBuildingCount,\n      pillsCrafted: {},\n      totalPillsCrafted: 0,\n      allPillTypesCrafted: false,\n      unlockedRegions,\n      ascensionCompleted: this.state.ascensionCompleted,\n      playtimeHours: this.state.totalPlaytime / 3600,\n      crossRegionLinkCount: this.state.crossRegionLinks.length,\n    };\n\n    for (const ach of getAllAchievements()) {\n      if (this.state.achievements.includes(ach.id)) continue;\n      if (checkAchievement(ach, context)) {\n        this.state = addAchievement(this.state, ach.id);\n        this.addNotification(`🏆 成就解锁: ${ach.name}`, 'success');\n        this.onAchievementUnlocked?.(ach.id);\n      }\n    }\n  }\n\n  private render(now: number): void {\n    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n    const preview = this.placementMode\n      ? { def: this.placementMode, gx: this.placementPos.gx, gy: this.placementPos.gy, valid: this.placementValid }\n      : null;\n\n    this.renderer.render(\n      this.map,\n      buildings,\n      this.buildingDefs,\n      this.state.resources,\n      this.state.realm,\n      this.state.cultivation,\n      this.hoveredCell,\n      preview,\n      now,\n    );\n\n    const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n    const segMap = buildSegmentMap(this.conveyorSegments);\n    for (const seg of this.conveyorSegments) {\n      renderConveyorSegment(this.renderer.ctx, seg, offsetX, offsetY, scale, this.map.cellSize, now);\n    }\n    renderConveyorItems(this.renderer.ctx, this.conveyorItems, segMap, offsetX, offsetY, scale, this.map.cellSize);\n\n    for (const puppet of this.puppets) {\n      renderPuppet(this.renderer.ctx, puppet, offsetX, offsetY, scale, this.map.cellSize, now);\n    }\n\n    // M4: Render cross-region portals in current map\n    for (const link of this.state.crossRegionLinks) {\n      if (link.fromRegionIndex === this.currentRegionIndex) {\n        renderCrossRegionPortal(this.renderer.ctx, link.fromX, link.fromY, offsetX, offsetY, scale, this.map.cellSize, now);\n      }\n    }\n\n    if (this.breakthroughAnim.active) {\n      this.renderBreakthroughOverlay(now);\n    }\n\n    if (this.ascensionAnim.active) {\n      this.renderAscensionOverlay(now);\n    }\n  }\n\n  private renderBreakthroughOverlay(now: number): void {\n    const ctx = this.renderer.ctx;\n    const w = this.canvas.getBoundingClientRect().width;\n    const h = this.canvas.getBoundingClientRect().height;\n\n    const elapsed = now - this.breakthroughAnim.startTime;\n    const progress = Math.min(1, elapsed / this.breakthroughAnim.duration);\n\n    let alpha = 0;\n    if (progress < 0.2) alpha = progress / 0.2;\n    else if (progress > 0.8) alpha = (1 - progress) / 0.2;\n    else alpha = 1;\n\n    const result = this.breakthroughAnim.result;\n\n    if (result?.success) {\n      ctx.fillStyle = `rgba(255, 215, 0, ${alpha * 0.15})`;\n      ctx.fillRect(0, 0, w, h);\n\n      ctx.fillStyle = `rgba(255, 215, 0, ${alpha})`;\n      ctx.font = `bold ${24 + Math.sin(progress * Math.PI * 4) * 4}px serif`;\n      ctx.textAlign = 'center';\n      ctx.textBaseline = 'middle';\n      ctx.fillText('⚡ 境界突破成功 ⚡', w / 2, h / 2 - 20);\n\n      ctx.font = '16px serif';\n      ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;\n      const realmName = getFullRealmName(this.state.cultivation);\n      ctx.fillText(`进入 ${realmName}`, w / 2, h / 2 + 20);\n    } else if (result) {\n      ctx.fillStyle = `rgba(200, 50, 50, ${alpha * 0.15})`;\n      ctx.fillRect(0, 0, w, h);\n\n      ctx.fillStyle = `rgba(255, 100, 100, ${alpha})`;\n      ctx.font = 'bold 24px serif';\n      ctx.textAlign = 'center';\n      ctx.textBaseline = 'middle';\n      ctx.fillText('突破失败...', w / 2, h / 2 - 20);\n\n      ctx.font = '14px serif';\n      ctx.fillStyle = `rgba(255, 200, 200, ${alpha})`;\n      ctx.fillText(`修为损失 ${Math.floor(result.penalty * 100)}%`, w / 2, h / 2 + 20);\n    }\n\n    if (progress >= 1) {\n      this.breakthroughAnim.active = false;\n      this.breakthroughAnim.result = null;\n      this.onBreakthroughAnim?.(false, null);\n    }\n  }\n\n  // M4: Ascension animation overlay\n  private renderAscensionOverlay(now: number): void {\n    const ctx = this.renderer.ctx;\n    const w = this.canvas.getBoundingClientRect().width;\n    const h = this.canvas.getBoundingClientRect().height;\n\n    const elapsed = now - this.ascensionAnim.startTime;\n    const progress = Math.min(1, elapsed / this.ascensionAnim.duration);\n\n    // Golden-white gradient overlay\n    let alpha = 0;\n    if (progress < 0.15) alpha = progress / 0.15;\n    else if (progress > 0.85) alpha = (1 - progress) / 0.15;\n    else alpha = 1;\n\n    ctx.fillStyle = `rgba(255, 255, 200, ${alpha * 0.2})`;\n    ctx.fillRect(0, 0, w, h);\n\n    // Radiating lines\n    const centerX = w / 2;\n    const centerY = h / 2;\n    const lineCount = 12;\n    for (let i = 0; i < lineCount; i++) {\n      const angle = (i / lineCount) * Math.PI * 2 + progress * Math.PI;\n      const len = 200 + Math.sin(progress * Math.PI * 6 + i) * 100;\n      ctx.strokeStyle = `rgba(255, 215, 0, ${alpha * 0.3})`;\n      ctx.lineWidth = 2;\n      ctx.beginPath();\n      ctx.moveTo(centerX, centerY);\n      ctx.lineTo(centerX + Math.cos(angle) * len, centerY + Math.sin(angle) * len);\n      ctx.stroke();\n    }\n\n    ctx.fillStyle = `rgba(255, 215, 0, ${alpha})`;\n    ctx.font = `bold ${28 + Math.sin(progress * Math.PI * 3) * 6}px serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText('🌟 飞升成功 🌟', w / 2, h / 2 - 30);\n\n    ctx.font = '18px serif';\n    ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;\n    ctx.fillText('飞升仙尊 — 全局效率×10', w / 2, h / 2 + 15);\n\n    ctx.font = '14px serif';\n    ctx.fillStyle = `rgba(200, 200, 255, ${alpha})`;\n    ctx.fillText('恭喜完成飞升挑战！', w / 2, h / 2 + 50);\n\n    if (progress >= 1) {\n      this.ascensionAnim.active = false;\n    }\n  }\n\n  placeCurrentBuilding(): boolean {\n    if (!this.placementMode) return false;\n\n    const def = this.placementMode;\n    const { gx, gy } = this.placementPos;\n\n    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n    if (!canPlace(this.map, def, gx, gy, buildings)) return false;\n    if (!canAfford(this.state.resources, def.cost)) return false;\n\n    this.state = deductCost(this.state, def.cost);\n\n    // Handle conveyor/puppet placement\n    if (def.category === 'transport' && (def.id === 'conveyor_lv1' || def.id === 'conveyor_lv2')) {\n      const seg = createSegment(\n        `seg_${Date.now()}_${Math.random().toString(36).slice(2)}`,\n        gx, gy,\n        def.id === 'conveyor_lv1' ? 1 : 2,\n        'right',\n      );\n      const segMap = buildSegmentMap(this.conveyorSegments);\n      this.conveyorSegments.push(autoConnect(seg, segMap));\n      audioManager.playBuild();\n      this.addNotification(`放置了 ${def.name}`, 'success');\n      this.onStateChange?.(this.state);\n      return true;\n    }\n\n    if (def.category === 'automation' && def.id === 'puppet_sorter') {\n      const puppet = createPuppet(\n        `pup_${Date.now()}_${Math.random().toString(36).slice(2)}`,\n        gx, gy, 1,\n      );\n      this.puppets.push(puppet);\n      audioManager.playBuild();\n      this.addNotification(`放置了 ${def.name}`, 'success');\n      this.onStateChange?.(this.state);\n      return true;\n    }\n\n    const instance = createBuildingInstance(def.id, gx, gy);\n    this.state = placeBuilding(this.state, this.currentRegionIndex, instance);\n\n    audioManager.playBuild();\n    this.addNotification(`建造了 ${def.name}`, 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  private handleBuildingClick(building: BuildingInstance): void {\n    const def = this.buildingDefs.get(building.buildingId);\n    if (!def) return;\n\n    if (def.production.mode === 'manual') {\n      if (def.category === 'farming') {\n        if (!building.isProducing && building.progress < 1) {\n          this.state = plantField(this.state, building, this.currentRegionIndex);\n          audioManager.playCollect();\n        } else if (building.progress >= 1) {\n          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n          audioManager.playHarvest();\n          this.addNotification(`收获 ${def.production.amount} ${this.getResourceName(def.production.resource)}`, 'success');\n        }\n      } else if (def.category === 'mining') {\n        this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n        audioManager.playCollect();\n      } else if (def.category === 'alchemy') {\n        if (building.progress >= 1) {\n          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n          audioManager.playAlchemyComplete();\n          this.addNotification(`获得 ${def.production.amount} ${this.getResourceName(def.production.resource)}`, 'success');\n        } else if (!building.isProducing) {\n          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n          audioManager.playAlchemyStart();\n        }\n      } else if (def.category === 'cultivation') {\n        if (!building.isProducing) {\n          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n        }\n      }\n      this.onStateChange?.(this.state);\n    }\n\n    this.onBuildingSelect?.(building);\n  }\n\n  usePillAction(pillId: string): boolean {\n    const result = usePill(pillId, this.state.resources);\n    if (!result) return false;\n\n    this.state.resources = result.resources as Resources;\n    this.state.cultivation = addCultivationExp(this.state.cultivation, result.cultivation);\n    this.state = this.addCultivationToRealm(result.cultivation);\n\n    audioManager.playUsePill();\n    const pillName = this.getResourceName(pillId);\n    this.addNotification(`服用 ${pillName}，修为+${result.cultivation}`, 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  useAllPills(pillId: string): boolean {\n    const count = this.state.resources[pillId as keyof typeof this.state.resources] ?? 0;\n    if (count <= 0) return false;\n\n    const result = useMultiplePills(pillId, count, this.state.resources);\n    if (!result) return false;\n\n    this.state.resources = result.resources as Resources;\n    this.state.cultivation = addCultivationExp(this.state.cultivation, result.cultivation);\n    this.state = this.addCultivationToRealm(result.cultivation);\n\n    audioManager.playUsePill();\n    this.addNotification(`服用 ${result.used} ${this.getResourceName(pillId)}，修为+${result.cultivation}`, 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  private addCultivationToRealm(amount: number): GameState {\n    const next = cloneState(this.state);\n    next.realm.exp += amount;\n    while (next.realm.exp >= next.realm.expToNext) {\n      next.realm.exp -= next.realm.expToNext;\n      next.realm.level += 1;\n      next.realm.expToNext = Math.floor(next.realm.expToNext * 1.8);\n    }\n    return next;\n  }\n\n  attemptBreakthroughAction(): boolean {\n    if (!canBreakthrough(this.state.cultivation)) {\n      this.addNotification('修为不足，无法突破', 'warning');\n      return false;\n    }\n\n    const result = attemptBreakthrough(this.state.cultivation, this.state.resources);\n    if (!result) {\n      this.addNotification('材料不足，无法突破', 'warning');\n      return false;\n    }\n\n    this.state.cultivation = result.newState;\n    this.state.resources = result.newResources as Resources;\n\n    if (result.result.success) {\n      this.state.realm.realmId = result.newState.realmId;\n      this.state.realm.level = result.newState.level;\n      this.state.realm.exp = result.newState.exp;\n      this.state.realm.expToNext = result.newState.expToNext;\n    }\n\n    this.breakthroughAnim = {\n      active: true,\n      result: result.result,\n      startTime: performance.now(),\n      duration: 3000,\n    };\n\n    if (result.result.success) {\n      audioManager.playBreakthroughSuccess();\n      this.addNotification(`突破成功！进入 ${getFullRealmName(this.state.cultivation)}`, 'success');\n    } else {\n      audioManager.playBreakthroughFail();\n      this.addNotification(`突破失败，修为损失 ${Math.floor(result.result.penalty * 100)}%`, 'error');\n    }\n\n    this.onBreakthroughAnim?.(true, result.result);\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  getBreakthroughInfo() {\n    return getBreakthroughRequirements(this.state.cultivation);\n  }\n\n  // === M4: Ascension Actions ===\n\n  getAscensionInfo() {\n    return checkAscensionRequirements(this.state.resources, this.state.cultivation.totalCultivation);\n  }\n\n  attemptAscensionAction(): boolean {\n    const result = attemptAscension(this.state.resources, this.state.cultivation.totalCultivation);\n    if (!result.success) {\n      this.addNotification('飞升条件不满足', 'warning');\n      return false;\n    }\n\n    this.state.resources = result.newResources as Resources;\n    this.state.ascensionCompleted = true;\n\n    this.ascensionAnim = {\n      active: true,\n      startTime: performance.now(),\n      duration: 5000,\n    };\n\n    audioManager.playBreakthroughSuccess();\n    this.addNotification('🌟 飞升成功！获得称号：飞升仙尊', 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  // === M4: Cross-Region Link ===\n\n  createCrossRegionLinkAction(\n    fromRegionIndex: number,\n    fromX: number,\n    fromY: number,\n    toRegionIndex: number,\n    toX: number,\n    toY: number,\n    resource: string,\n    amount: number,\n    interval: number,\n  ): boolean {\n    const id = `crl_${Date.now()}_${Math.random().toString(36).slice(2)}`;\n    const link = createCrossRegionLink(id, fromRegionIndex, fromX, fromY, toRegionIndex, toX, toY, resource, amount, interval);\n    this.state = addCrossRegionLink(this.state, link);\n    this.addNotification(`建立跨区域传送链路`, 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  // === Alchemy Actions ===\n\n  getAvailableAlchemyRecipes(): AlchemyRecipe[] {\n    return getAvailableRecipes((realm) => cultivationIsRealmUnlocked(realm, this.state.cultivation));\n  }\n\n  startAlchemyAction(recipeId: string): boolean {\n    const crafting = startCrafting(recipeId, this.state.resources);\n    if (!crafting) return false;\n\n    this.state.resources = crafting.resources as Resources;\n    this.state.alchemySession = crafting.session;\n    audioManager.playAlchemyStart();\n    this.addNotification(`开始炼丹`, 'info');\n    this.onStateChange?.(this.state);\n    this.onAlchemyUpdate?.(this.state.alchemySession);\n    return true;\n  }\n\n  collectAlchemyAction(): boolean {\n    if (!this.state.alchemySession?.complete) return false;\n\n    const result = collectAlchemy(this.state.alchemySession, this.state.resources);\n    if (!result) return false;\n\n    this.state.resources = result.resources as Resources;\n    this.state.alchemySession = null;\n\n    if (result.success) {\n      this.state.cultivation = addCultivationExp(this.state.cultivation, result.expReward);\n      audioManager.playAlchemyComplete();\n      this.addNotification(`炼丹成功！获得 ${result.amount} 颗丹药`, 'success');\n    } else {\n      audioManager.playAlchemyFail();\n      this.addNotification('炼丹失败...', 'error');\n    }\n\n    this.onStateChange?.(this.state);\n    this.onAlchemyUpdate?.(null);\n    return true;\n  }\n\n  // === Notifications ===\n\n  addNotification(text: string, type: GameNotification['type'] = 'info'): void {\n    const notif: GameNotification = {\n      id: ++notifIdCounter,\n      text,\n      type,\n      time: Date.now(),\n    };\n    this.notifications.push(notif);\n    if (this.notifications.length > 10) {\n      this.notifications = this.notifications.slice(-10);\n    }\n    this.onNotification?.(notif);\n  }\n\n  // === Utility ===\n\n  private getResourceName(id: string): string {\n    const names: Record<string, string> = {\n      spirit_stone: '灵石',\n      spirit_grass: '灵草',\n      spirit_energy: '灵气',\n      cultivation: '修为',\n      pill_juling: '聚灵丹',\n      pill_peiyuan: '培元丹',\n      pill_ningqi: '凝气丹',\n      pill_zhuji: '筑基丹',\n      pill_jindanyin: '金丹引',\n      pill_yuanyingguo: '元婴果',\n      pill_huashenlu: '化神露',\n      pill_jiuzhuan: '九转金丹',\n      spirit_iron: '灵铁',\n      spirit_wood: '灵木',\n      talisman_paper: '符纸',\n      monster_core: '妖丹',\n      heaven_earth_liquid: '天地灵液',\n      immortal_stone: '仙灵石',\n      merit: '功德值',\n    };\n    return names[id] ?? id;\n  }\n\n  centerCamera(): void {\n    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);\n  }\n\n  getAvailableBuildings(): BuildingDef[] {\n    return Array.from(this.buildingDefs.values()).filter(def => {\n      return cultivationIsRealmUnlocked(def.unlockRealm, this.state.cultivation);\n    });\n  }\n\n  getInventoryPills(): Array<PillDef & { count: number }> {\n    const result: Array<PillDef & { count: number }> = [];\n    for (const def of getAllPillDefs()) {\n      const count = this.state.resources[def.id as keyof typeof this.state.resources] ?? 0;\n      if (count > 0) {\n        result.push({ ...def, count });\n      }\n    }\n    return result;\n  }\n\n  private setupInput(canvas: HTMLCanvasElement): void {\n    canvas.addEventListener('mousemove', (e) => {\n      const rect = canvas.getBoundingClientRect();\n      const mx = e.clientX - rect.left;\n      const my = e.clientY - rect.top;\n\n      const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n      this.hoveredCell = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n\n      if (this.placementMode && this.hoveredCell) {\n        this.placementPos = { gx: this.hoveredCell.gx, gy: this.hoveredCell.gy };\n        const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n        this.placementValid = canPlace(\n          this.map,\n          this.placementMode,\n          this.placementPos.gx,\n          this.placementPos.gy,\n          buildings,\n        );\n      }\n    });\n\n    canvas.addEventListener('mousedown', (e) => {\n      if (e.button !== 0) return;\n      this.clickStartTime = performance.now();\n      this.clickStartPos = { x: e.clientX, y: e.clientY };\n    });\n\n    canvas.addEventListener('mouseup', (e) => {\n      if (e.button !== 0) return;\n      const dt = performance.now() - this.clickStartTime;\n      const dx = Math.abs(e.clientX - this.clickStartPos.x);\n      const dy = Math.abs(e.clientY - this.clickStartPos.y);\n\n      if (dt < 300 && dx < 5 && dy < 5) {\n        audioManager.init();\n        audioManager.resume();\n        this.handleClick(e);\n      }\n    });\n\n    document.addEventListener('keydown', (e) => {\n      if (e.key === 'Escape') {\n        this.placementMode = null;\n      }\n    });\n  }\n\n  private handleClick(e: MouseEvent): void {\n    const rect = this.canvas.getBoundingClientRect();\n    const mx = e.clientX - rect.left;\n    const my = e.clientY - rect.top;\n    const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n    const { gx, gy } = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n\n    if (!this.map.inBounds(gx, gy)) return;\n\n    if (this.placementMode) {\n      this.placementPos = { gx, gy };\n      const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n      this.placementValid = canPlace(this.map, this.placementMode, gx, gy, buildings);\n      if (this.placementValid) {\n        this.placeCurrentBuilding();\n      }\n      return;\n    }\n\n    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n    const clicked = buildings.find(b => {\n      const def = this.buildingDefs.get(b.buildingId);\n      if (!def) return false;\n      return (\n        gx >= b.gridX && gx < b.gridX + def.size.w &&\n        gy >= b.gridY && gy < b.gridY + def.size.h\n      );\n    });\n\n    if (clicked) {\n      this.handleBuildingClick(clicked);\n    }\n  }\n}\n","numLines":946,"startLine":1,"totalLines":946}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a173420c0bd44129a145ac23","type":"tool_result","content":"1\t// Renderer.ts — Canvas 2D rendering system\n2\t\n3\timport { Camera } from './Camera';\n4\timport { GameMap } from '../game/Map';\n5\timport type { BuildingInstance } from '../game/GameState';\n6\timport { renderBuilding } from '../game/Building';\n7\timport type { BuildingDef } from '../game/Building';\n8\timport { getResourceDisplays, formatAmount } from '../game/Resources';\n9\timport type { Resources, RealmProgress } from '../game/GameState';\n10\timport { type CultivationState, getFullRealmName, getShortRealmName } from '../game/Cultivation';\n11\t\n12\texport class Renderer {\n13\t  canvas: HTMLCanvasElement;\n14\t  ctx: CanvasRenderingContext2D;\n15\t  camera: Camera;\n16\t\n17\t  constructor(canvas: HTMLCanvasElement) {\n18\t    this.canvas = canvas;\n19\t    this.ctx = canvas.getContext('2d')!;\n20\t    this.camera = new Camera(canvas);\n21\t    this.resize();\n22\t  }\n23\t\n24\t  resize(): void {\n25\t    const dpr = window.devicePixelRatio || 1;\n26\t    const rect = this.canvas.getBoundingClientRect();\n27\t    this.canvas.width = rect.width * dpr;\n28\t    this.canvas.height = rect.height * dpr;\n29\t    this.ctx.scale(dpr, dpr);\n30\t  }\n31\t\n32\t  render(\n33\t    map: GameMap,\n34\t    buildings: BuildingInstance[],\n35\t    buildingDefs: Map<string, BuildingDef>,\n36\t    resources: Resources,\n37\t    realm: RealmProgress,\n38\t    cultivation: CultivationState,\n39\t    hoveredCell: { gx: number; gy: number } | null,\n40\t    placementPreview: { def: BuildingDef; gx: number; gy: number; valid: boolean } | null,\n41\t    now: number,\n42\t  ): void {\n43\t    const ctx = this.ctx;\n44\t    const w = this.canvas.getBoundingClientRect().width;\n45\t    const h = this.canvas.getBoundingClientRect().height;\n46\t\n47\t    ctx.fillStyle = '#1a1a2e';\n48\t    ctx.fillRect(0, 0, w, h);\n49\t\n50\t    const { offsetX, offsetY, scale } = this.camera.getTransform();\n51\t\n52\t    map.render(ctx, offsetX, offsetY, w, h, scale);\n53\t\n54\t    for (const building of buildings) {\n55\t      const def = buildingDefs.get(building.buildingId);\n56\t      if (def) {\n57\t        renderBuilding(ctx, building, def, offsetX, offsetY, scale, map.cellSize, now);\n58\t      }\n59\t    }\n60\t\n61\t    if (placementPreview) {\n62\t      this.renderPlacementPreview(ctx, placementPreview, offsetX, offsetY, scale, map.cellSize);\n63\t    }\n64\t\n65\t    if (hoveredCell && map.inBounds(hoveredCell.gx, hoveredCell.gy)) {\n66\t      const hx = offsetX + hoveredCell.gx * map.cellSize * scale;\n67\t      const hy = offsetY + hoveredCell.gy * map.cellSize * scale;\n68\t      const hs = map.cellSize * scale;\n69\t      ctx.strokeStyle = 'rgba(255,255,255,0.4)';\n70\t      ctx.lineWidth = 1;\n71\t      ctx.strokeRect(hx, hy, hs, hs);\n72\t    }\n73\t\n74\t    this.renderUI(ctx, w, h, resources, realm, cultivation);\n75\t  }\n76\t\n77\t  private renderPlacementPreview(\n78\t    ctx: CanvasRenderingContext2D,\n79\t    preview: { def: BuildingDef; gx: number; gy: number; valid: boolean },\n80\t    offsetX: number,\n81\t    offsetY: number,\n82\t    scale: number,\n83\t    cellSize: number,\n84\t  ): void {\n85\t    const x = offsetX + preview.gx * cellSize * scale;\n86\t    const y = offsetY + preview.gy * cellSize * scale;\n87\t    const w = preview.def.size.w * cellSize * scale;\n88\t    const h = preview.def.size.h * cellSize * scale;\n89\t\n90\t    const { r, g, b } = preview.def.color;\n91\t    const alpha = preview.valid ? 0.4 : 0.2;\n92\t\n93\t    ctx.fillStyle = preview.valid\n94\t      ? `rgba(${r},${g},${b},${alpha})`\n95\t      : `rgba(255,50,50,${alpha})`;\n96\t    ctx.fillRect(x + 2, y + 2, w - 4, h - 4);\n97\t\n98\t    ctx.strokeStyle = preview.valid ? 'rgba(100,255,100,0.8)' : 'rgba(255,100,100,0.8)';\n99\t    ctx.lineWidth = 2;\n100\t    ctx.setLineDash([4, 4]);\n101\t    ctx.strokeRect(x + 2, y + 2, w - 4, h - 4);\n102\t    ctx.setLineDash([]);\n103\t  }\n104\t\n105\t  private renderUI(\n106\t    ctx: CanvasRenderingContext2D,\n107\t    canvasW: number,\n108\t    canvasH: number,\n109\t    resources: Resources,\n110\t    realm: RealmProgress,\n111\t    cultivation: CultivationState,\n112\t  ): void {\n113\t    // Top bar background\n114\t    ctx.fillStyle = 'rgba(0,0,0,0.8)';\n115\t    ctx.fillRect(0, 0, canvasW, 52);\n116\t\n117\t    // Realm display using cultivation system\n118\t    const realmName = getFullRealmName(cultivation);\n119\t    ctx.fillStyle = '#ffd700';\n120\t    ctx.font = 'bold 14px monospace';\n121\t    ctx.textAlign = 'left';\n122\t    ctx.textBaseline = 'middle';\n123\t    ctx.fillText(realmName, 12, 18);\n124\t\n125\t    // Cultivation exp bar\n126\t    const expBarX = 12;\n127\t    const expBarY = 32;\n128\t    const expBarW = 140;\n129\t    const expBarH = 12;\n130\t    const expRatio = cultivation.exp / cultivation.expToNext;\n131\t    ctx.fillStyle = 'rgba(255,255,255,0.1)';\n132\t    ctx.fillRect(expBarX, expBarY, expBarW, expBarH);\n133\t    ctx.fillStyle = '#ffd700';\n134\t    ctx.fillRect(expBarX, expBarY, expBarW * expRatio, expBarH);\n135\t    ctx.strokeStyle = 'rgba(255,255,255,0.3)';\n136\t    ctx.lineWidth = 1;\n137\t    ctx.strokeRect(expBarX, expBarY, expBarW, expBarH);\n138\t    ctx.fillStyle = '#fff';\n139\t    ctx.font = '9px monospace';\n140\t    ctx.textAlign = 'center';\n141\t    ctx.fillText(`${Math.floor(expRatio * 100)}%`, expBarX + expBarW / 2, expBarY + 7);\n142\t\n143\t    // Resource display\n144\t    const displays = getResourceDisplays(resources);\n145\t    let rx = canvasW - 12;\n146\t    ctx.textAlign = 'right';\n147\t    for (let i = displays.length - 1; i >= 0; i--) {\n148\t      const d = displays[i];\n149\t      if (d.amount === 0) continue;\n150\t      const text = `${d.icon} ${formatAmount(d.amount)}`;\n151\t      ctx.font = '11px monospace';\n152\t      const metrics = ctx.measureText(text);\n153\t      rx -= metrics.width + 4;\n154\t      ctx.fillStyle = d.color;\n155\t      ctx.fillText(text, rx + metrics.width, 24);\n156\t      rx -= 14;\n157\t    }\n158\t\n159\t    // Cultivation rate indicator\n160\t    if (cultivation.cultivationRate > 0) {\n161\t      ctx.fillStyle = 'rgba(255,215,0,0.6)';\n162\t      ctx.font = '10px monospace';\n163\t      ctx.textAlign = 'left';\n164\t      ctx.fillText(`⚡${cultivation.cultivationRate.toFixed(1)}/s`, 160, 18);\n165\t    }\n166\t  }\n167\t\n168\t  destroy(): void {\n169\t    // Clean up\n170\t  }\n171\t}\n172\t"}]},"parent_tool_use_id":null,"session_id":"094f9230-fe12-4466-ab83-fdd0d233a191","uuid":"40a71179-9f99-4f7e-a445-4fa12bc47ad9","timestamp":"2026-05-23T02:55:00.443Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/steam-cultivation-factory/src/renderer/Renderer.ts","content":"// Renderer.ts — Canvas 2D rendering system\n\nimport { Camera } from './Camera';\nimport { GameMap } from '../game/Map';\nimport type { BuildingInstance } from '../game/GameState';\nimport { renderBuilding } from '../game/Building';\nimport type { BuildingDef } from '../game/Building';\nimport { getResourceDisplays, formatAmount } from '../game/Resources';\nimport type { Resources, RealmProgress } from '../game/GameState';\nimport { type CultivationState, getFullRealmName, getShortRealmName } from '../game/Cultivation';\n\nexport class Renderer {\n  canvas: HTMLCanvasElement;\n  ctx: CanvasRenderingContext2D;\n  camera: Camera;\n\n  constructor(canvas: HTMLCanvasElement) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d')!;\n    this.camera = new Camera(canvas);\n    this.resize();\n  }\n\n  resize(): void {\n    const dpr = window.devicePixelRatio || 1;\n    const rect = this.canvas.getBoundingClientRect();\n    this.canvas.width = rect.width * dpr;\n    this.canvas.height = rect.height * dpr;\n    this.ctx.scale(dpr, dpr);\n  }\n\n  render(\n    map: GameMap,\n    buildings: BuildingInstance[],\n    buildingDefs: Map<string, BuildingDef>,\n    resources: Resources,\n    realm: RealmProgress,\n    cultivation: CultivationState,\n    hoveredCell: { gx: number; gy: number } | null,\n    placementPreview: { def: BuildingDef; gx: number; gy: number; valid: boolean } | null,\n    now: number,\n  ): void {\n    const ctx = this.ctx;\n    const w = this.canvas.getBoundingClientRect().width;\n    const h = this.canvas.getBoundingClientRect().height;\n\n    ctx.fillStyle = '#1a1a2e';\n    ctx.fillRect(0, 0, w, h);\n\n    const { offsetX, offsetY, scale } = this.camera.getTransform();\n\n    map.render(ctx, offsetX, offsetY, w, h, scale);\n\n    for (const building of buildings) {\n      const def = buildingDefs.get(building.buildingId);\n      if (def) {\n        renderBuilding(ctx, building, def, offsetX, offsetY, scale, map.cellSize, now);\n      }\n    }\n\n    if (placementPreview) {\n      this.renderPlacementPreview(ctx, placementPreview, offsetX, offsetY, scale, map.cellSize);\n    }\n\n    if (hoveredCell && map.inBounds(hoveredCell.gx, hoveredCell.gy)) {\n      const hx = offsetX + hoveredCell.gx * map.cellSize * scale;\n      const hy = offsetY + hoveredCell.gy * map.cellSize * scale;\n      const hs = map.cellSize * scale;\n      ctx.strokeStyle = 'rgba(255,255,255,0.4)';\n      ctx.lineWidth = 1;\n      ctx.strokeRect(hx, hy, hs, hs);\n    }\n\n    this.renderUI(ctx, w, h, resources, realm, cultivation);\n  }\n\n  private renderPlacementPreview(\n    ctx: CanvasRenderingContext2D,\n    preview: { def: BuildingDef; gx: number; gy: number; valid: boolean },\n    offsetX: number,\n    offsetY: number,\n    scale: number,\n    cellSize: number,\n  ): void {\n    const x = offsetX + preview.gx * cellSize * scale;\n    const y = offsetY + preview.gy * cellSize * scale;\n    const w = preview.def.size.w * cellSize * scale;\n    const h = preview.def.size.h * cellSize * scale;\n\n    const { r, g, b } = preview.def.color;\n    const alpha = preview.valid ? 0.4 : 0.2;\n\n    ctx.fillStyle = preview.valid\n      ? `rgba(${r},${g},${b},${alpha})`\n      : `rgba(255,50,50,${alpha})`;\n    ctx.fillRect(x + 2, y + 2, w - 4, h - 4);\n\n    ctx.strokeStyle = preview.valid ? 'rgba(100,255,100,0.8)' : 'rgba(255,100,100,0.8)';\n    ctx.lineWidth = 2;\n    ctx.setLineDash([4, 4]);\n    ctx.strokeRect(x + 2, y + 2, w - 4, h - 4);\n    ctx.setLineDash([]);\n  }\n\n  private renderUI(\n    ctx: CanvasRenderingContext2D,\n    canvasW: number,\n    canvasH: number,\n    resources: Resources,\n    realm: RealmProgress,\n    cultivation: CultivationState,\n  ): void {\n    // Top bar background\n    ctx.fillStyle = 'rgba(0,0,0,0.8)';\n    ctx.fillRect(0, 0, canvasW, 52);\n\n    // Realm display using cultivation system\n    const realmName = getFullRealmName(cultivation);\n    ctx.fillStyle = '#ffd700';\n    ctx.font = 'bold 14px monospace';\n    ctx.textAlign = 'left';\n    ctx.textBaseline = 'middle';\n    ctx.fillText(realmName, 12, 18);\n\n    // Cultivation exp bar\n    const expBarX = 12;\n    const expBarY = 32;\n    const expBarW = 140;\n    const expBarH = 12;\n    const expRatio = cultivation.exp / cultivation.expToNext;\n    ctx.fillStyle = 'rgba(255,255,255,0.1)';\n    ctx.fillRect(expBarX, expBarY, expBarW, expBarH);\n    ctx.fillStyle = '#ffd700';\n    ctx.fillRect(expBarX, expBarY, expBarW * expRatio, expBarH);\n    ctx.strokeStyle = 'rgba(255,255,255,0.3)';\n    ctx.lineWidth = 1;\n    ctx.strokeRect(expBarX, expBarY, expBarW, expBarH);\n    ctx.fillStyle = '#fff';\n    ctx.font = '9px monospace';\n    ctx.textAlign = 'center';\n    ctx.fillText(`${Math.floor(expRatio * 100)}%`, expBarX + expBarW / 2, expBarY + 7);\n\n    // Resource display\n    const displays = getResourceDisplays(resources);\n    let rx = canvasW - 12;\n    ctx.textAlign = 'right';\n    for (let i = displays.length - 1; i >= 0; i--) {\n      const d = displays[i];\n      if (d.amount === 0) continue;\n      const text = `${d.icon} ${formatAmount(d.amount)}`;\n      ctx.font = '11px monospace';\n      const metrics = ctx.measureText(text);\n      rx -= metrics.width + 4;\n      ctx.fillStyle = d.color;\n      ctx.fillText(text, rx + metrics.width, 24);\n      rx -= 14;\n    }\n\n    // Cultivation rate indicator\n    if (cultivation.cultivationRate > 0) {\n      ctx.fillStyle = 'rgba(255,215,0,0.6)';\n      ctx.font = '10px monospace';\n      ctx.textAlign = 'left';\n      ctx.fillText(`⚡${cultivation.cultivationRate.toFixed(1)}/s`, 160, 18);\n    }\n  }\n\n  destroy(): void {\n    // Clean up\n  }\n}\n","numLines":172,"startLine":1,"totalLines":172}}}
