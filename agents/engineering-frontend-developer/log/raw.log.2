: Terrain): void {\n    if (!this.inBounds(gx, gy)) return;\n    this.terrain[gy * this.width + gx] = t;\n  }\n\n  isAreaFree(gx: number, gy: number, w: number, h: number, occupied: Set<string>): boolean {\n    for (let dy = 0; dy < h; dy++) {\n      for (let dx = 0; dx < w; dx++) {\n        const cx = gx + dx;\n        const cy = gy + dy;\n        if (!this.inBounds(cx, cy)) return false;\n        const t = this.getTerrain(cx, cy);\n        if (t === Terrain.Water || t === Terrain.Mountain) return false;\n        const key = `${cx},${cy}`;\n        if (occupied.has(key)) return false;\n      }\n    }\n    return true;\n  }\n\n  generateStartingArea(): void {\n    const veinPositions = [\n      [3, 2], [4, 2], [3, 3],\n      [14, 10], [15, 10], [15, 11],\n      [8, 7], [8, 8],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    const waterPositions = [\n      [10, 1], [11, 1], [10, 2],\n      [1, 12], [2, 12], [1, 11],\n    ];\n    for (const [x, y] of waterPositions) {\n      this.setTerrain(x, y, Terrain.Water);\n    }\n\n    for (let x = 5; x < 15; x++) {\n      this.setTerrain(x, 7, Terrain.Path);\n    }\n    for (let y = 3; y < 12; y++) {\n      this.setTerrain(10, y, Terrain.Path);\n    }\n\n    for (let y = 5; y < 8; y++) {\n      for (let x = 6; x < 9; x++) {\n        this.setTerrain(x, y, Terrain.RichSoil);\n      }\n    }\n  }\n\n  generateRegionTerrain(regionId: string): void {\n    switch (regionId) {\n      case 'zhuji_platform': this.generateZhujiPlatform(); break;\n      case 'medicine_valley': this.generateMedicineValley(); break;\n      case 'core_peak': this.generateCorePeak(); break;\n      case 'ore_mountain': this.generateOreMountain(); break;\n      case 'spirit_field_area': this.generateSpiritFieldArea(); break;\n      case 'mine_area': this.generateMineArea(); break;\n      case 'beast_ridge': this.generateBeastRidge(); break;\n      case 'vein_depth': this.generateVeinDepth(); break;\n      case 'ancient_battlefield': this.generateAncientBattlefield(); break;\n      case 'star_cliff': this.generateStarCliff(); break;\n      case 'sky_peak': this.generateSkyPeak(); break;\n      default: this.generateStartingArea();\n    }\n  }\n\n  private generateZhujiPlatform(): void {\n    const veinPositions = [[5, 3], [6, 3], [5, 4], [20, 15], [21, 15], [21, 16], [12, 10], [13, 10]];\n    for (const [x, y] of veinPositions) this.setTerrain(x, y, Terrain.SpiritVein);\n    for (let y = 6; y < 12; y++) for (let x = 8; x < 14; x++) this.setTerrain(x, y, Terrain.RichSoil);\n    for (let x = 4; x < 26; x++) this.setTerrain(x, 12, Terrain.Path);\n    for (let y = 4; y < 22; y++) this.setTerrain(15, y, Terrain.Path);\n    this.setTerrain(2, 2, Terrain.Water); this.setTerrain(3, 2, Terrain.Water); this.setTerrain(2, 3, Terrain.Water);\n  }\n\n  private generateMedicineValley(): void {\n    for (let y = 3; y < 22; y++) for (let x = 3; x < 32; x++) if (Math.random() < 0.6) this.setTerrain(x, y, Terrain.RichSoil);\n    for (const [x, y] of [[1, 1], [33, 1], [1, 23], [33, 23], [17, 12]]) this.setTerrain(x, y, Terrain.SpiritVein);\n    for (let x = 5; x < 30; x++) this.setTerrain(x, 12, Terrain.Path);\n  }\n\n  private generateCorePeak(): void {\n    for (const [x, y] of [[5, 5], [6, 5], [5, 6], [28, 22], [29, 22], [29, 23], [17, 14], [18, 14], [10, 20], [24, 8]])\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    for (let y = 2; y < 28; y += 4) for (let x = 2; x < 33; x += 5) if (Math.random() < 0.3) this.setTerrain(x, y, Terrain.Rock);\n    for (let x = 3; x < 32; x++) this.setTerrain(x, 15, Terrain.Path);\n    for (let y = 3; y < 28; y++) this.setTerrain(17, y, Terrain.Path);\n  }\n\n  private generateOreMountain(): void {\n    for (const [x, y] of [[4, 4], [5, 4], [4, 5], [20, 5], [21, 5], [21, 6], [35, 15], [36, 15], [36, 16], [10, 20], [11, 20], [11, 21], [28, 25], [29, 25], [29, 26]])\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    for (let y = 0; y < 5; y++) for (let x = 0; x < this.width; x++) if (Math.random() < 0.4) this.setTerrain(x, y, Terrain.Mountain);\n    for (let x = 5; x < 35; x++) this.setTerrain(x, 15, Terrain.Path);\n    for (let y = 5; y < 25; y++) this.setTerrain(20, y, Terrain.Path);\n  }\n\n  private generateSpiritFieldArea(): void {\n    for (let y = 4; y < 16; y++) for (let x = 4; x < 21; x++) if (Math.random() < 0.5) this.setTerrain(x, y, Terrain.RichSoil);\n    for (const [x, y] of [[2, 2], [22, 18]]) this.setTerrain(x, y, Terrain.SpiritVein);\n    for (let x = 3; x < 22; x++) this.setTerrain(x, 10, Terrain.Path);\n  }\n\n  private generateMineArea(): void {\n    for (const [x, y] of [[3, 3], [4, 3], [3, 4], [15, 8], [16, 8], [16, 9], [25, 15], [26, 15], [26, 16]])\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    for (let x = 5; x < 25; x++) this.setTerrain(x, 10, Terrain.Path);\n  }\n\n  // === M4: New region generators ===\n\n  private generateBeastRidge(): void {\n    // Dense forest with clearings, spirit veins for hunting\n    for (let y = 2; y < 33; y++) {\n      for (let x = 2; x < 38; x++) {\n        if (Math.random() < 0.4) this.setTerrain(x, y, Terrain.Forest);\n      }\n    }\n    // Clearings for building\n    for (let y = 8; y < 16; y++) for (let x = 10; x < 20; x++) this.setTerrain(x, y, Terrain.Grass);\n    for (let y = 22; y < 30; y++) for (let x = 25; x < 35; x++) this.setTerrain(x, y, Terrain.Grass);\n    // Spirit veins\n    for (const [x, y] of [[5, 5], [6, 5], [30, 8], [31, 8], [15, 28], [16, 28], [35, 30], [36, 30]])\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    // Paths\n    for (let x = 5; x < 35; x++) this.setTerrain(x, 17, Terrain.Path);\n    for (let y = 5; y < 32; y++) this.setTerrain(20, y, Terrain.Path);\n  }\n\n  private generateVeinDepth(): void {\n    // Crystal caverns with rich spirit liquid deposits\n    for (let y = 3; y < 32; y++) {\n      for (let x = 3; x < 42; x++) {\n        if (Math.random() < 0.15) this.setTerrain(x, y, Terrain.Crystal);\n      }\n    }\n    // Spirit vein clusters (deep veins)\n    for (const [x, y] of [[8, 8], [9, 8], [8, 9], [35, 10], [36, 10], [36, 11], [20, 20], [21, 20], [21, 21], [10, 28], [11, 28], [11, 29], [38, 28], [39, 28], [39, 29]])\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    // Water pools\n    for (const [x, y] of [[15, 12], [16, 12], [15, 13], [30, 22], [31, 22], [30, 23]])\n      this.setTerrain(x, y, Terrain.Water);\n    // Paths\n    for (let x = 5; x < 40; x++) this.setTerrain(x, 17, Terrain.Path);\n    for (let y = 5; y < 32; y++) this.setTerrain(22, y, Terrain.Path);\n  }\n\n  private generateAncientBattlefield(): void {\n    // Ruins and ancient weapons, immortal stone deposits\n    for (let y = 5; y < 35; y++) {\n      for (let x = 5; x < 45; x++) {\n        if (Math.random() < 0.12) this.setTerrain(x, y, Terrain.Ruins);\n      }\n    }\n    // Spirit veins (ancient formations)\n    for (const [x, y] of [[10, 10], [11, 10], [10, 11], [40, 15], [41, 15], [41, 16], [25, 25], [26, 25], [26, 26], [15, 35], [16, 35], [16, 36], [35, 30], [36, 30], [36, 31]])\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    // Ruined structures\n    for (let x = 20; x < 30; x++) this.setTerrain(x, 20, Terrain.Ruins);\n    for (let y = 15; y < 25; y++) this.setTerrain(25, y, Terrain.Ruins);\n    // Paths\n    for (let x = 5; x < 45; x++) this.setTerrain(x, 20, Terrain.Path);\n    for (let y = 5; y < 37; y++) this.setTerrain(25, y, Terrain.Path);\n  }\n\n  private generateStarCliff(): void {\n    // Ethereal void terrain with merit shrines\n    for (let y = 3; y < 37; y++) {\n      for (let x = 3; x < 47; x++) {\n        if (Math.random() < 0.2) this.setTerrain(x, y, Terrain.Void);\n      }\n    }\n    // Spirit veins (star points)\n    for (const [x, y] of [[10, 8], [11, 8], [10, 9], [40, 8], [41, 8], [41, 9], [25, 20], [26, 20], [26, 21], [10, 32], [11, 32], [11, 33], [40, 32], [41, 32], [41, 33]])\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    // Floating platforms\n    for (let y = 12; y < 16; y++) for (let x = 15; x < 25; x++) this.setTerrain(x, y, Terrain.Grass);\n    for (let y = 24; y < 28; y++) for (let x = 28; x < 38; x++) this.setTerrain(x, y, Terrain.Grass);\n    // Paths\n    for (let x = 8; x < 42; x++) this.setTerrain(x, 20, Terrain.Path);\n    for (let y = 8; y < 35; y++) this.setTerrain(25, y, Terrain.Path);\n  }\n\n  private generateSkyPeak(): void {\n    // Ultimate celestial region with all terrain types\n    // Central platform\n    for (let y = 15; y < 35; y++) for (let x = 15; x < 45; x++) this.setTerrain(x, y, Terrain.Celestial);\n    // Outer celestial ring\n    for (let y = 5; y < 45; y++) {\n      for (let x = 5; x < 55; x++) {\n        const dx = x - 30;\n        const dy = y - 25;\n        const dist = Math.sqrt(dx * dx + dy * dy);\n        if (dist > 18 && dist < 25 && Math.random() < 0.3) this.setTerrain(x, y, Terrain.Void);\n      }\n    }\n    // Rich resource deposits\n    for (const [x, y] of [[10, 10], [11, 10], [10, 11], [50, 10], [51, 10], [51, 11], [10, 40], [11, 40], [11, 41], [50, 40], [51, 40], [51, 41],\n      [25, 20], [26, 20], [26, 21], [35, 30], [36, 30], [36, 31], [20, 35], [21, 35], [21, 36], [40, 15], [41, 15], [41, 16]])\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    // Various terrain patches\n    for (let y = 8; y < 12; y++) for (let x = 20; x < 28; x++) this.setTerrain(x, y, Terrain.RichSoil);\n    for (let y = 38; y < 42; y++) for (let x = 35; x < 43; x++) this.setTerrain(x, y, Terrain.Forest);\n    for (let y = 20; y < 24; y++) for (let x = 8; x < 14; x++) this.setTerrain(x, y, Terrain.Crystal);\n    for (let y = 30; y < 34; y++) for (let x = 48; x < 54; x++) this.setTerrain(x, y, Terrain.Ruins);\n    // Water features\n    for (const [x, y] of [[30, 12], [31, 12], [30, 13], [29, 13], [30, 38], [31, 38], [30, 39], [29, 39]])\n      this.setTerrain(x, y, Terrain.Water);\n    // Main paths (cross pattern)\n    for (let x = 10; x < 50; x++) this.setTerrain(x, 25, Terrain.Path);\n    for (let y = 10; y < 42; y++) this.setTerrain(30, y, Terrain.Path);\n  }\n\n  render(\n    ctx: CanvasRenderingContext2D,\n    offsetX: number,\n    offsetY: number,\n    viewportW: number,\n    viewportH: number,\n    scale: number,\n  ): void {\n    const invScale = 1 / scale;\n    const startCol = Math.max(0, Math.floor(-offsetX * invScale / this.cellSize));\n    const startRow = Math.max(0, Math.floor(-offsetY * invScale / this.cellSize));\n    const endCol = Math.min(this.width, Math.ceil((-offsetX + viewportW) * invScale / this.cellSize) + 1);\n    const endRow = Math.min(this.height, Math.ceil((-offsetY + viewportH) * invScale / this.cellSize) + 1);\n\n    for (let row = startRow; row < endRow; row++) {\n      for (let col = startCol; col < endCol; col++) {\n        const x = offsetX + col * this.cellSize * scale;\n        const y = offsetY + row * this.cellSize * scale;\n        const size = this.cellSize * scale;\n\n        ctx.fillStyle = this.getTerrainColor(this.getTerrain(col, row));\n        ctx.fillRect(x, y, size, size);\n\n        ctx.strokeStyle = this.gridColor;\n        ctx.lineWidth = 0.5;\n        ctx.strokeRect(x, y, size, size);\n      }\n    }\n  }\n\n  private getTerrainColor(t: Terrain): string {\n    switch (t) {\n      case Terrain.Grass: return this.bgColor;\n      case Terrain.Rock: return '#3a3a4a';\n      case Terrain.Water: return '#1a3a5a';\n      case Terrain.RichSoil: return '#2a4a1a';\n      case Terrain.Mountain: return '#4a4a4a';\n      case Terrain.Path: return '#4a3a2a';\n      case Terrain.SpiritVein: return '#2a4a5a';\n      case Terrain.Forest: return '#1a3a1a';\n      case Terrain.Crystal: return '#3a2a5a';\n      case Terrain.Ruins: return '#3a2a2a';\n      case Terrain.Void: return '#0a0a2a';\n      case Terrain.Celestial: return '#2a2a4a';\n      default: return this.bgColor;\n    }\n  }\n\n  screenToGrid(\n    screenX: number,\n    screenY: number,\n    offsetX: number,\n    offsetY: number,\n    scale: number,\n  ): { gx: number; gy: number } {\n    const invScale = 1 / scale;\n    const gx = Math.floor((screenX - offsetX) * invScale / this.cellSize);\n    const gy = Math.floor((screenY - offsetY) * invScale / this.cellSize);\n    return { gx, gy };\n  }\n\n  gridToScreen(\n    gx: number,\n    gy: number,\n    offsetX: number,\n    offsetY: number,\n    scale: number,\n  ): { x: number; y: number } {\n    return {\n      x: offsetX + (gx + 0.5) * this.cellSize * scale,\n      y: offsetY + (gy + 0.5) * this.cellSize * scale,\n    };\n  }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":4,"newStart":1,"newLines":4,"lines":["-// Map.ts — Grid-based map system with terrain and area rendering","+// Map.ts — Grid-based map system with terrain and area rendering (v0.4.0)"," "," export enum Terrain {","   Grass = 0,"]},{"oldStart":8,"oldLines":6,"newStart":8,"newLines":11,"lines":["   Mountain = 4,","   Path = 5,","   SpiritVein = 6,","+  Forest = 7,","+  Crystal = 8,","+  Ruins = 9,","+  Void = 10,","+  Celestial = 11,"," }"," "," export interface MapConfig {"]},{"oldStart":61,"oldLines":7,"newStart":66,"newLines":6,"lines":["     this.terrain[gy * this.width + gx] = t;","   }"," ","-  // Check if a rect of cells is free for placement","   isAreaFree(gx: number, gy: number, w: number, h: number, occupied: Set<string>): boolean {","     for (let dy = 0; dy < h; dy++) {","       for (let dx = 0; dx < w; dx++) {"]},{"oldStart":77,"oldLines":9,"newStart":81,"newLines":7,"lines":["     return true;","   }"," ","-  // Generate terrain for the starting area (炼气坪)","   generateStartingArea(): void {","-    // Add some spirit veins (矿脉)","     const veinPositions = [","       [3, 2], [4, 2], [3, 3],","       [14, 10], [15, 10], [15, 11],"]},{"oldStart":89,"oldLines":7,"newStart":91,"newLines":6,"lines":["       this.setTerrain(x, y, Terrain.SpiritVein);","     }"," ","-    // Add some water features","     const waterPositions = [","       [10, 1], [11, 1],