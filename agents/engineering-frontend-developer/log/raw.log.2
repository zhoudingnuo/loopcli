{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_02f162a51e224bbea98f9451","type":"tool_result","content":"1\t// ConveyorBelt.ts — 灵脉通道（传送带）系统，支持 Lv1 直线 / Lv2 转弯分叉\n2\t\n3\texport interface ConveyorSegment {\n4\t  uid: string;\n5\t  gridX: number;\n6\t  gridY: number;\n7\t  level: 1 | 2; // Lv1 直线, Lv2 转弯分叉\n8\t  direction: Direction;\n9\t  /** 连接到的下一格坐标（null = 未连接） */\n10\t  nextX: number | null;\n11\t  nextY: number | null;\n12\t  /** 分叉出口（仅 Lv2） */\n13\t  branchX: number | null;\n14\t  branchY: number | null;\n15\t}\n16\t\n17\texport type Direction = 'up' | 'down' | 'left' | 'right';\n18\t\n19\texport interface ConveyorItem {\n20\t  id: string;\n21\t  resource: string;\n22\t  amount: number;\n23\t  /** 当前所在格 x */\n24\t  x: number;\n25\t  /** 当前所在格 y */\n26\t  y: number;\n27\t  /** 移动进度 0-1 */\n28\t  progress: number;\n29\t  /** 每格移动时间 ms */\n30\t  speed: number;\n31\t  /** 目标建筑 uid（终点） */\n32\t  targetBuildingUid: string | null;\n33\t}\n34\t\n35\tlet itemCounter = 0;\n36\t\n37\tconst DIR_DELTA: Record<Direction, { dx: number; dy: number }> = {\n38\t  up: { dx: 0, dy: -1 },\n39\t  down: { dx: 0, dy: 1 },\n40\t  left: { dx: -1, dy: 0 },\n41\t  right: { dx: 1, dy: 0 },\n42\t};\n43\t\n44\tconst OPPOSITE: Record<Direction, Direction> = {\n45\t  up: 'down',\n46\t  down: 'up',\n47\t  left: 'right',\n48\t  right: 'left',\n49\t};\n50\t\n51\texport function getDirDelta(dir: Direction): { dx: number; dy: number } {\n52\t  return DIR_DELTA[dir];\n53\t}\n54\t\n55\texport function oppositeDir(dir: Direction): Direction {\n56\t  return OPPOSITE[dir];\n57\t}\n58\t\n59\texport function directionFromDelta(dx: number, dy: number): Direction {\n60\t  if (Math.abs(dx) > Math.abs(dy)) return dx > 0 ? 'right' : 'left';\n61\t  return dy > 0 ? 'down' : 'up';\n62\t}\n63\t\n64\t// Create a conveyor segment\n65\texport function createSegment(\n66\t  uid: string,\n67\t  gridX: number,\n68\t  gridY: number,\n69\t  level: 1 | 2,\n70\t  direction: Direction,\n71\t): ConveyorSegment {\n72\t  return {\n73\t    uid,\n74\t    gridX,\n75\t    gridY,\n76\t    level,\n77\t    direction,\n78\t    nextX: null,\n79\t    nextY: null,\n80\t    branchX: null,\n81\t    branchY: null,\n82\t  };\n83\t}\n84\t\n85\t// Build a lookup map from grid position to segment\n86\texport function buildSegmentMap(segments: ConveyorSegment[]): Map<string, ConveyorSegment> {\n87\t  const map = new Map<string, ConveyorSegment>();\n88\t  for (const seg of segments) {\n89\t    map.set(`${seg.gridX},${seg.gridY}`, seg);\n90\t  }\n91\t  return map;\n92\t}\n93\t\n94\t// Auto-connect a segment to its neighbors\n95\texport function autoConnect(\n96\t  segment: ConveyorSegment,\n97\t  segmentMap: Map<string, ConveyorSegment>,\n98\t): ConveyorSegment {\n99\t  const updated = { ...segment };\n100\t\n101\t  // Look ahead in current direction\n102\t  const { dx, dy } = getDirDelta(segment.direction);\n103\t  const aheadKey = `${segment.gridX + dx},${segment.gridY + dy}`;\n104\t  const ahead = segmentMap.get(aheadKey);\n105\t  if (ahead && ahead.direction !== oppositeDir(segment.direction)) {\n106\t    updated.nextX = segment.gridX + dx;\n107\t    updated.nextY = segment.gridY + dy;\n108\t  } else {\n109\t    updated.nextX = null;\n110\t    updated.nextY = null;\n111\t  }\n112\t\n113\t  // Lv2: branch detection — check perpendicular directions\n114\t  if (segment.level >= 2) {\n115\t    const perpDirs: Direction[] =\n116\t      segment.direction === 'up' || segment.direction === 'down'\n117\t        ? ['left', 'right']\n118\t        : ['up', 'down'];\n119\t\n120\t    for (const pd of perpDirs) {\n121\t      const pdx = getDirDelta(pd).dx;\n122\t      const pdy = getDirDelta(pd).dy;\n123\t      const branchKey = `${segment.gridX + pdx},${segment.gridY + pdy}`;\n124\t      const branch = segmentMap.get(branchKey);\n125\t      if (branch && branch.direction !== oppositeDir(pd)) {\n126\t        updated.branchX = segment.gridX + pdx;\n127\t        updated.branchY = segment.gridY + pdy;\n128\t        break; // Only one branch\n129\t      }\n130\t    }\n131\t  }\n132\t\n133\t  return updated;\n134\t}\n135\t\n136\t// Spawn a new item on the conveyor\n137\texport function spawnItem(\n138\t  resource: string,\n139\t  amount: number,\n140\t  startX: number,\n141\t  startY: number,\n142\t  speed: number = 2000,\n143\t): ConveyorItem {\n144\t  return {\n145\t    id: `item_${Date.now()}_${++itemCounter}`,\n146\t    resource,\n147\t    amount,\n148\t    x: startX,\n149\t    y: startY,\n150\t    progress: 0,\n151\t    speed,\n152\t    targetBuildingUid: null,\n153\t  };\n154\t}\n155\t\n156\t// Tick all conveyor items — move them along segments\n157\texport function tickConveyorItems(\n158\t  items: ConveyorItem[],\n159\t  segmentMap: Map<string, ConveyorSegment>,\n160\t  dtMs: number,\n161\t): { items: ConveyorItem[]; delivered: Array<{ resource: string; amount: number; x: number; y: number }> } {\n162\t  const delivered: Array<{ resource: string; amount: number; x: number; y: number }> = [];\n163\t  const remaining: ConveyorItem[] = [];\n164\t\n165\t  for (const item of items) {\n166\t    const seg = segmentMap.get(`${item.x},${item.y}`);\n167\t    if (!seg) {\n168\t      remaining.push(item);\n169\t      continue;\n170\t    }\n171\t\n172\t    const progress = item.progress + dtMs / item.speed;\n173\t\n174\t    if (progress >= 1) {\n175\t      // Item arrived at next cell\n176\t      if (seg.nextX !== null && seg.nextY !== null) {\n177\t        remaining.push({\n178\t          ...item,\n179\t          x: seg.nextX,\n180\t          y: seg.nextY,\n181\t          progress: progress - 1,\n182\t        });\n183\t      } else {\n184\t        // End of line — deliver\n185\t        delivered.push({\n186\t          resource: item.resource,\n187\t          amount: item.amount,\n188\t          x: item.x,\n189\t          y: item.y,\n190\t        });\n191\t      }\n192\t    } else {\n193\t      remaining.push({ ...item, progress });\n194\t    }\n195\t  }\n196\t\n197\t  return { items: remaining, delivered };\n198\t}\n199\t\n200\t// Render a conveyor segment on canvas\n201\texport function renderConveyorSegment(\n202\t  ctx: CanvasRenderingContext2D,\n203\t  seg: ConveyorSegment,\n204\t  offsetX: number,\n205\t  offsetY: number,\n206\t  scale: number,\n207\t  cellSize: number,\n208\t  now: number,\n209\t): void {\n210\t  const x = offsetX + seg.gridX * cellSize * scale;\n211\t  const y = offsetY + seg.gridY * cellSize * scale;\n212\t  const s = cellSize * scale;\n213\t\n214\t  // Belt background\n215\t  const baseColor = seg.level === 1 ? 'rgba(100,150,200,0.4)' : 'rgba(150,120,220,0.4)';\n216\t  ctx.fillStyle = baseColor;\n217\t  ctx.fillRect(x + 1, y + 1, s - 2, s - 2);\n218\t\n219\t  // Direction arrow with animation\n220\t  const arrowPhase = ((now / 500) % 1);\n221\t  const { dx, dy } = getDirDelta(seg.direction);\n222\t  const cx = x + s / 2 + dx * s * 0.15 * arrowPhase;\n223\t  const cy = y + s / 2 + dy * s * 0.15 * arrowPhase;\n224\t\n225\t  ctx.fillStyle = seg.level === 1 ? '#6496c8' : '#9678dc';\n226\t  ctx.font = `${Math.max(10, Math.floor(14 * scale))}px serif`;\n227\t  ctx.textAlign = 'center';\n228\t  ctx.textBaseline = 'middle';\n229\t\n230\t  const arrows: Record<Direction, string> = { up: '↑', down: '↓', left: '←', right: '→' };\n231\t  ctx.fillText(arrows[seg.direction], cx, cy);\n232\t\n233\t  // Branch indicator for Lv2\n234\t  if (seg.level >= 2 && seg.branchX !== null) {\n235\t    ctx.fillStyle = 'rgba(180,160,255,0.5)';\n236\t    ctx.beginPath();\n237\t    ctx.arc(x + s - 4 * scale, y + s - 4 * scale, 2 * scale, 0, Math.PI * 2);\n238\t    ctx.fill();\n239\t  }\n240\t\n241\t  // Connection indicators\n242\t  ctx.strokeStyle = 'rgba(150,200,255,0.3)';\n243\t  ctx.lineWidth = 1;\n244\t  if (seg.nextX !== null && seg.nextY !== null) {\n245\t    const nx = offsetX + seg.nextX * cellSize * scale;\n246\t    const ny = offsetY + seg.nextY * cellSize * scale;\n247\t    ctx.beginPath();\n248\t    ctx.moveTo(x + s / 2, y + s / 2);\n249\t    ctx.lineTo(nx + s / 2, ny + s / 2);\n250\t    ctx.stroke();\n251\t  }\n252\t}\n253\t\n254\t// Render items moving on conveyors\n255\texport function renderConveyorItems(\n256\t  ctx: CanvasRenderingContext2D,\n257\t  items: ConveyorItem[],\n258\t  segmentMap: Map<string, ConveyorSegment>,\n259\t  offsetX: number,\n260\t  offsetY: number,\n261\t  scale: number,\n262\t  cellSize: number,\n263\t): void {\n264\t  const RESOURCE_COLORS: Record<string, string> = {\n265\t    spirit_stone: '#7cc8ff',\n266\t    spirit_grass: '#6adf6a',\n267\t    spirit_iron: '#8a8aaa',\n268\t    pill_juling: '#ff8c32',\n269\t    pill_peiyuan: '#ff6699',\n270\t    pill_zhuji: '#ffcc00',\n271\t    pill_jindanyin: '#ff4444',\n272\t  };\n273\t\n274\t  for (const item of items) {\n275\t    const seg = segmentMap.get(`${item.x},${item.y}`);\n276\t    if (!seg) continue;\n277\t\n278\t    let tx = item.x;\n279\t    let ty = item.y;\n280\t\n281\t    if (seg.nextX !== null && seg.nextY !== null) {\n282\t      tx = item.x + (seg.nextX - item.x) * item.progress;\n283\t      ty = item.y + ((seg.nextY as number) - item.y) * item.progress;\n284\t    }\n285\t\n286\t    const sx = offsetX + (tx + 0.5) * cellSize * scale;\n287\t    const sy = offsetY + (ty + 0.5) * cellSize * scale;\n288\t    const r = 4 * scale;\n289\t\n290\t    ctx.fillStyle = RESOURCE_COLORS[item.resource] ?? '#fff';\n291\t    ctx.beginPath();\n292\t    ctx.arc(sx, sy, r, 0, Math.PI * 2);\n293\t    ctx.fill();\n294\t\n295\t    // Glow\n296\t    ctx.fillStyle = (RESOURCE_COLORS[item.resource] ?? '#fff').replace(')', ',0.3)').replace('rgb', 'rgba');\n297\t    ctx.beginPath();\n298\t    ctx.arc(sx, sy, r * 1.5, 0, Math.PI * 2);\n299\t    ctx.fill();\n300\t  }\n301\t}\n302\t"}]},"parent_tool_use_id":null,"session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"07245c7e-a9ad-4c59-b957-674eb86f14ac","timestamp":"2026-05-23T02:11:34.369Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\ConveyorBelt.ts","content":"// ConveyorBelt.ts — 灵脉通道（传送带）系统，支持 Lv1 直线 / Lv2 转弯分叉\n\nexport interface ConveyorSegment {\n  uid: string;\n  gridX: number;\n  gridY: number;\n  level: 1 | 2; // Lv1 直线, Lv2 转弯分叉\n  direction: Direction;\n  /** 连接到的下一格坐标（null = 未连接） */\n  nextX: number | null;\n  nextY: number | null;\n  /** 分叉出口（仅 Lv2） */\n  branchX: number | null;\n  branchY: number | null;\n}\n\nexport type Direction = 'up' | 'down' | 'left' | 'right';\n\nexport interface ConveyorItem {\n  id: string;\n  resource: string;\n  amount: number;\n  /** 当前所在格 x */\n  x: number;\n  /** 当前所在格 y */\n  y: number;\n  /** 移动进度 0-1 */\n  progress: number;\n  /** 每格移动时间 ms */\n  speed: number;\n  /** 目标建筑 uid（终点） */\n  targetBuildingUid: string | null;\n}\n\nlet itemCounter = 0;\n\nconst DIR_DELTA: Record<Direction, { dx: number; dy: number }> = {\n  up: { dx: 0, dy: -1 },\n  down: { dx: 0, dy: 1 },\n  left: { dx: -1, dy: 0 },\n  right: { dx: 1, dy: 0 },\n};\n\nconst OPPOSITE: Record<Direction, Direction> = {\n  up: 'down',\n  down: 'up',\n  left: 'right',\n  right: 'left',\n};\n\nexport function getDirDelta(dir: Direction): { dx: number; dy: number } {\n  return DIR_DELTA[dir];\n}\n\nexport function oppositeDir(dir: Direction): Direction {\n  return OPPOSITE[dir];\n}\n\nexport function directionFromDelta(dx: number, dy: number): Direction {\n  if (Math.abs(dx) > Math.abs(dy)) return dx > 0 ? 'right' : 'left';\n  return dy > 0 ? 'down' : 'up';\n}\n\n// Create a conveyor segment\nexport function createSegment(\n  uid: string,\n  gridX: number,\n  gridY: number,\n  level: 1 | 2,\n  direction: Direction,\n): ConveyorSegment {\n  return {\n    uid,\n    gridX,\n    gridY,\n    level,\n    direction,\n    nextX: null,\n    nextY: null,\n    branchX: null,\n    branchY: null,\n  };\n}\n\n// Build a lookup map from grid position to segment\nexport function buildSegmentMap(segments: ConveyorSegment[]): Map<string, ConveyorSegment> {\n  const map = new Map<string, ConveyorSegment>();\n  for (const seg of segments) {\n    map.set(`${seg.gridX},${seg.gridY}`, seg);\n  }\n  return map;\n}\n\n// Auto-connect a segment to its neighbors\nexport function autoConnect(\n  segment: ConveyorSegment,\n  segmentMap: Map<string, ConveyorSegment>,\n): ConveyorSegment {\n  const updated = { ...segment };\n\n  // Look ahead in current direction\n  const { dx, dy } = getDirDelta(segment.direction);\n  const aheadKey = `${segment.gridX + dx},${segment.gridY + dy}`;\n  const ahead = segmentMap.get(aheadKey);\n  if (ahead && ahead.direction !== oppositeDir(segment.direction)) {\n    updated.nextX = segment.gridX + dx;\n    updated.nextY = segment.gridY + dy;\n  } else {\n    updated.nextX = null;\n    updated.nextY = null;\n  }\n\n  // Lv2: branch detection — check perpendicular directions\n  if (segment.level >= 2) {\n    const perpDirs: Direction[] =\n      segment.direction === 'up' || segment.direction === 'down'\n        ? ['left', 'right']\n        : ['up', 'down'];\n\n    for (const pd of perpDirs) {\n      const pdx = getDirDelta(pd).dx;\n      const pdy = getDirDelta(pd).dy;\n      const branchKey = `${segment.gridX + pdx},${segment.gridY + pdy}`;\n      const branch = segmentMap.get(branchKey);\n      if (branch && branch.direction !== oppositeDir(pd)) {\n        updated.branchX = segment.gridX + pdx;\n        updated.branchY = segment.gridY + pdy;\n        break; // Only one branch\n      }\n    }\n  }\n\n  return updated;\n}\n\n// Spawn a new item on the conveyor\nexport function spawnItem(\n  resource: string,\n  amount: number,\n  startX: number,\n  startY: number,\n  speed: number = 2000,\n): ConveyorItem {\n  return {\n    id: `item_${Date.now()}_${++itemCounter}`,\n    resource,\n    amount,\n    x: startX,\n    y: startY,\n    progress: 0,\n    speed,\n    targetBuildingUid: null,\n  };\n}\n\n// Tick all conveyor items — move them along segments\nexport function tickConveyorItems(\n  items: ConveyorItem[],\n  segmentMap: Map<string, ConveyorSegment>,\n  dtMs: number,\n): { items: ConveyorItem[]; delivered: Array<{ resource: string; amount: number; x: number; y: number }> } {\n  const delivered: Array<{ resource: string; amount: number; x: number; y: number }> = [];\n  const remaining: ConveyorItem[] = [];\n\n  for (const item of items) {\n    const seg = segmentMap.get(`${item.x},${item.y}`);\n    if (!seg) {\n      remaining.push(item);\n      continue;\n    }\n\n    const progress = item.progress + dtMs / item.speed;\n\n    if (progress >= 1) {\n      // Item arrived at next cell\n      if (seg.nextX !== null && seg.nextY !== null) {\n        remaining.push({\n          ...item,\n          x: seg.nextX,\n          y: seg.nextY,\n          progress: progress - 1,\n        });\n      } else {\n        // End of line — deliver\n        delivered.push({\n          resource: item.resource,\n          amount: item.amount,\n          x: item.x,\n          y: item.y,\n        });\n      }\n    } else {\n      remaining.push({ ...item, progress });\n    }\n  }\n\n  return { items: remaining, delivered };\n}\n\n// Render a conveyor segment on canvas\nexport function renderConveyorSegment(\n  ctx: CanvasRenderingContext2D,\n  seg: ConveyorSegment,\n  offsetX: number,\n  offsetY: number,\n  scale: number,\n  cellSize: number,\n  now: number,\n): void {\n  const x = offsetX + seg.gridX * cellSize * scale;\n  const y = offsetY + seg.gridY * cellSize * scale;\n  const s = cellSize * scale;\n\n  // Belt background\n  const baseColor = seg.level === 1 ? 'rgba(100,150,200,0.4)' : 'rgba(150,120,220,0.4)';\n  ctx.fillStyle = baseColor;\n  ctx.fillRect(x + 1, y + 1, s - 2, s - 2);\n\n  // Direction arrow with animation\n  const arrowPhase = ((now / 500) % 1);\n  const { dx, dy } = getDirDelta(seg.direction);\n  const cx = x + s / 2 + dx * s * 0.15 * arrowPhase;\n  const cy = y + s / 2 + dy * s * 0.15 * arrowPhase;\n\n  ctx.fillStyle = seg.level === 1 ? '#6496c8' : '#9678dc';\n  ctx.font = `${Math.max(10, Math.floor(14 * scale))}px serif`;\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n\n  const arrows: Record<Direction, string> = { up: '↑', down: '↓', left: '←', right: '→' };\n  ctx.fillText(arrows[seg.direction], cx, cy);\n\n  // Branch indicator for Lv2\n  if (seg.level >= 2 && seg.branchX !== null) {\n    ctx.fillStyle = 'rgba(180,160,255,0.5)';\n    ctx.beginPath();\n    ctx.arc(x + s - 4 * scale, y + s - 4 * scale, 2 * scale, 0, Math.PI * 2);\n    ctx.fill();\n  }\n\n  // Connection indicators\n  ctx.strokeStyle = 'rgba(150,200,255,0.3)';\n  ctx.lineWidth = 1;\n  if (seg.nextX !== null && seg.nextY !== null) {\n    const nx = offsetX + seg.nextX * cellSize * scale;\n    const ny = offsetY + seg.nextY * cellSize * scale;\n    ctx.beginPath();\n    ctx.moveTo(x + s / 2, y + s / 2);\n    ctx.lineTo(nx + s / 2, ny + s / 2);\n    ctx.stroke();\n  }\n}\n\n// Render items moving on conveyors\nexport function renderConveyorItems(\n  ctx: CanvasRenderingContext2D,\n  items: ConveyorItem[],\n  segmentMap: Map<string, ConveyorSegment>,\n  offsetX: number,\n  offsetY: number,\n  scale: number,\n  cellSize: number,\n): void {\n  const RESOURCE_COLORS: Record<string, string> = {\n    spirit_stone: '#7cc8ff',\n    spirit_grass: '#6adf6a',\n    spirit_iron: '#8a8aaa',\n    pill_juling: '#ff8c32',\n    pill_peiyuan: '#ff6699',\n    pill_zhuji: '#ffcc00',\n    pill_jindanyin: '#ff4444',\n  };\n\n  for (const item of items) {\n    const seg = segmentMap.get(`${item.x},${item.y}`);\n    if (!seg) continue;\n\n    let tx = item.x;\n    let ty = item.y;\n\n    if (seg.nextX !== null && seg.nextY !== null) {\n      tx = item.x + (seg.nextX - item.x) * item.progress;\n      ty = item.y + ((seg.nextY as number) - item.y) * item.progress;\n    }\n\n    const sx = offsetX + (tx + 0.5) * cellSize * scale;\n    const sy = offsetY + (ty + 0.5) * cellSize * scale;\n    const r = 4 * scale;\n\n    ctx.fillStyle = RESOURCE_COLORS[item.resource] ?? '#fff';\n    ctx.beginPath();\n    ctx.arc(sx, sy, r, 0, Math.PI * 2);\n    ctx.fill();\n\n    // Glow\n    ctx.fillStyle = (RESOURCE_COLORS[item.resource] ?? '#fff').replace(')', ',0.3)').replace('rgb', 'rgba');\n    ctx.beginPath();\n    ctx.arc(sx, sy, r * 1.5, 0, Math.PI * 2);\n    ctx.fill();\n  }\n}\n","numLines":302,"startLine":1,"totalLines":302}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_4f9b4da8cebc46ca9407826a","type":"tool_result","content":"1\t// Talisman.ts — 基础灵符条件触发系统\n2\t\n3\texport type TalismanCondition =\n4\t  | { type: 'resource_above'; resource: string; threshold: number }\n5\t  | { type: 'resource_below'; resource: string; threshold: number }\n6\t  | { type: 'building_count_above'; buildingId: string; threshold: number }\n7\t  | { type: 'realm_level_above'; level: number };\n8\t\n9\texport type TalismanAction =\n10\t  | { type: 'stop_building'; buildingUid: string }\n11\t  | { type: 'start_building'; buildingUid: string }\n12\t  | { type: 'set_production_rate'; buildingUid: string; multiplier: number }\n13\t  | { type: 'notify'; message: string };\n14\t\n15\texport interface TalismanInstance {\n16\t  uid: string;\n17\t  gridX: number;\n18\t  gridY: number;\n19\t  name: string;\n20\t  condition: TalismanCondition;\n21\t  action: TalismanAction;\n22\t  enabled: boolean;\n23\t  /** Cooldown between triggers (ms) */\n24\t  cooldown: number;\n25\t  /** Last trigger time */\n26\t  lastTriggered: number;\n27\t}\n28\t\n29\t// Evaluate a condition against current game state\n30\texport function evaluateCondition(\n31\t  condition: TalismanCondition,\n32\t  resources: Record<string, number>,\n33\t  buildingCounts: Record<string, number>,\n34\t  realmLevel: number,\n35\t): boolean {\n36\t  switch (condition.type) {\n37\t    case 'resource_above':\n38\t      return (resources[condition.resource] ?? 0) > condition.threshold;\n39\t    case 'resource_below':\n40\t      return (resources[condition.resource] ?? 0) < condition.threshold;\n41\t    case 'building_count_above':\n42\t      return (buildingCounts[condition.buildingId] ?? 0) > condition.threshold;\n43\t    case 'realm_level_above':\n44\t      return realmLevel >= condition.level;\n45\t  }\n46\t}\n47\t\n48\t// Create a talisman instance\n49\texport function createTalisman(\n50\t  uid: string,\n51\t  gridX: number,\n52\t  gridY: number,\n53\t  name: string,\n54\t  condition: TalismanCondition,\n55\t  action: TalismanAction,\n56\t): TalismanInstance {\n57\t  return {\n58\t    uid,\n59\t    gridX,\n60\t    gridY,\n61\t    name,\n62\t    condition,\n63\t    action,\n64\t    enabled: true,\n65\t    cooldown: 5000,\n66\t    lastTriggered: 0,\n67\t  };\n68\t}\n69\t\n70\t// Process all talismans and return triggered actions\n71\texport function processTalismans(\n72\t  talismans: TalismanInstance[],\n73\t  resources: Record<string, number>,\n74\t  buildingCounts: Record<string, number>,\n75\t  realmLevel: number,\n76\t  now: number,\n77\t): { talismans: TalismanInstance[]; actions: TalismanAction[] } {\n78\t  const updated: TalismanInstance[] = [];\n79\t  const actions: TalismanAction[] = [];\n80\t\n81\t  for (const t of talismans) {\n82\t    if (!t.enabled) {\n83\t      updated.push(t);\n84\t      continue;\n85\t    }\n86\t\n87\t    if (now - t.lastTriggered < t.cooldown) {\n88\t      updated.push(t);\n89\t      continue;\n90\t    }\n91\t\n92\t    const triggered = evaluateCondition(t.condition, resources, buildingCounts, realmLevel);\n93\t\n94\t    if (triggered) {\n95\t      actions.push(t.action);\n96\t      updated.push({ ...t, lastTriggered: now });\n97\t    } else {\n98\t      updated.push(t);\n99\t    }\n100\t  }\n101\t\n102\t  return { talismans: updated, actions };\n103\t}\n104\t\n105\t// Preset talisman templates\n106\texport const TALISMAN_PRESETS: Array<{\n107\t  id: string;\n108\t  name: string;\n109\t  description: string;\n110\t  condition: TalismanCondition;\n111\t  action: TalismanAction;\n112\t}> = [\n113\t  {\n114\t    id: 'auto_stop_field',\n115\t    name: '灵田自停符',\n116\t    description: '灵草超过50时停止灵田',\n117\t    condition: { type: 'resource_above', resource: 'spirit_grass', threshold: 50 },\n118\t    action: { type: 'notify', message: '灵草充足，灵田已暂停' },\n119\t  },\n120\t  {\n121\t    id: 'auto_stop_miner',\n122\t    name: '矿机自停符',\n123\t    description: '灵石超过200时停止矿机',\n124\t    condition: { type: 'resource_above', resource: 'spirit_stone', threshold: 200 },\n125\t    action: { type: 'notify', message: '灵石充足，矿机已暂停' },\n126\t  },\n127\t  {\n128\t    id: 'speed_boost',\n129\t    name: '加速灵符',\n130\t    description: '修为达到要求时加速生产',\n131\t    condition: { type: 'realm_level_above', level: 15 },\n132\t    action: { type: 'notify', message: '灵符激活，生产加速！' },\n133\t  },\n134\t];\n135\t\n136\t// Render a talisman on canvas\n137\texport function renderTalisman(\n138\t  ctx: CanvasRenderingContext2D,\n139\t  talisman: TalismanInstance,\n140\t  offsetX: number,\n141\t  offsetY: number,\n142\t  scale: number,\n143\t  cellSize: number,\n144\t  now: number,\n145\t): void {\n146\t  const x = offsetX + talisman.gridX * cellSize * scale;\n147\t  const y = offsetY + talisman.gridY * cellSize * scale;\n148\t  const s = cellSize * scale;\n149\t\n150\t  // Scroll background\n151\t  ctx.fillStyle = talisman.enabled ? 'rgba(200,180,100,0.3)' : 'rgba(100,100,100,0.3)';\n152\t  ctx.fillRect(x + 2, y + 2, s - 4, s - 4);\n153\t\n154\t  // Scroll icon\n155\t  ctx.fillStyle = talisman.enabled ? '#ffd700' : '#666';\n156\t  ctx.font = `${Math.max(10, Math.floor(14 * scale))}px serif`;\n157\t  ctx.textAlign = 'center';\n158\t  ctx.textBaseline = 'middle';\n159\t  ctx.fillText('📜', x + s / 2, y + s / 2);\n160\t\n161\t  // Active glow\n162\t  if (talisman.enabled && now - talisman.lastTriggered < 1000) {\n163\t    ctx.fillStyle = 'rgba(255,215,0,0.2)';\n164\t    ctx.fillRect(x + 2, y + 2, s - 4, s - 4);\n165\t  }\n166\t}\n167\t"}]},"parent_tool_use_id":null,"session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"c357a495-809b-43a2-95a9-51c1ef308103","timestamp":"2026-05-23T02:11:34.424Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Talisman.ts","content":"// Talisman.ts — 基础灵符条件触发系统\n\nexport type TalismanCondition =\n  | { type: 'resource_above'; resource: string; threshold: number }\n  | { type: 'resource_below'; resource: string; threshold: number }\n  | { type: 'building_count_above'; buildingId: string; threshold: number }\n  | { type: 'realm_level_above'; level: number };\n\nexport type TalismanAction =\n  | { type: 'stop_building'; buildingUid: string }\n  | { type: 'start_building'; buildingUid: string }\n  | { type: 'set_production_rate'; buildingUid: string; multiplier: number }\n  | { type: 'notify'; message: string };\n\nexport interface TalismanInstance {\n  uid: string;\n  gridX: number;\n  gridY: number;\n  name: string;\n  condition: TalismanCondition;\n  action: TalismanAction;\n  enabled: boolean;\n  /** Cooldown between triggers (ms) */\n  cooldown: number;\n  /** Last trigger time */\n  lastTriggered: number;\n}\n\n// Evaluate a condition against current game state\nexport function evaluateCondition(\n  condition: TalismanCondition,\n  resources: Record<string, number>,\n  buildingCounts: Record<string, number>,\n  realmLevel: number,\n): boolean {\n  switch (condition.type) {\n    case 'resource_above':\n      return (resources[condition.resource] ?? 0) > condition.threshold;\n    case 'resource_below':\n      return (resources[condition.resource] ?? 0) < condition.threshold;\n    case 'building_count_above':\n      return (buildingCounts[condition.buildingId] ?? 0) > condition.threshold;\n    case 'realm_level_above':\n      return realmLevel >= condition.level;\n  }\n}\n\n// Create a talisman instance\nexport function createTalisman(\n  uid: string,\n  gridX: number,\n  gridY: number,\n  name: string,\n  condition: TalismanCondition,\n  action: TalismanAction,\n): TalismanInstance {\n  return {\n    uid,\n    gridX,\n    gridY,\n    name,\n    condition,\n    action,\n    enabled: true,\n    cooldown: 5000,\n    lastTriggered: 0,\n  };\n}\n\n// Process all talismans and return triggered actions\nexport function processTalismans(\n  talismans: TalismanInstance[],\n  resources: Record<string, number>,\n  buildingCounts: Record<string, number>,\n  realmLevel: number,\n  now: number,\n): { talismans: TalismanInstance[]; actions: TalismanAction[] } {\n  const updated: TalismanInstance[] = [];\n  const actions: TalismanAction[] = [];\n\n  for (const t of talismans) {\n    if (!t.enabled) {\n      updated.push(t);\n      continue;\n    }\n\n    if (now - t.lastTriggered < t.cooldown) {\n      updated.push(t);\n      continue;\n    }\n\n    const triggered = evaluateCondition(t.condition, resources, buildingCounts, realmLevel);\n\n    if (triggered) {\n      actions.push(t.action);\n      updated.push({ ...t, lastTriggered: now });\n    } else {\n      updated.push(t);\n    }\n  }\n\n  return { talismans: updated, actions };\n}\n\n// Preset talisman templates\nexport const TALISMAN_PRESETS: Array<{\n  id: string;\n  name: string;\n  description: string;\n  condition: TalismanCondition;\n  action: TalismanAction;\n}> = [\n  {\n    id: 'auto_stop_field',\n    name: '灵田自停符',\n    description: '灵草超过50时停止灵田',\n    condition: { type: 'resource_above', resource: 'spirit_grass', threshold: 50 },\n    action: { type: 'notify', message: '灵草充足，灵田已暂停' },\n  },\n  {\n    id: 'auto_stop_miner',\n    name: '矿机自停符',\n    description: '灵石超过200时停止矿机',\n    condition: { type: 'resource_above', resource: 'spirit_stone', threshold: 200 },\n    action: { type: 'notify', message: '灵石充足，矿机已暂停' },\n  },\n  {\n    id: 'speed_boost',\n    name: '加速灵符',\n    description: '修为达到要求时加速生产',\n    condition: { type: 'realm_level_above', level: 15 },\n    action: { type: 'notify', message: '灵符激活，生产加速！' },\n  },\n];\n\n// Render a talisman on canvas\nexport function renderTalisman(\n  ctx: CanvasRenderingContext2D,\n  talisman: TalismanInstance,\n  offsetX: number,\n  offsetY: number,\n  scale: number,\n  cellSize: number,\n  now: number,\n): void {\n  const x = offsetX + talisman.gridX * cellSize * scale;\n  const y = offsetY + talisman.gridY * cellSize * scale;\n  const s = cellSize * scale;\n\n  // Scroll background\n  ctx.fillStyle = talisman.enabled ? 'rgba(200,180,100,0.3)' : 'rgba(100,100,100,0.3)';\n  ctx.fillRect(x + 2, y + 2, s - 4, s - 4);\n\n  // Scroll icon\n  ctx.fillStyle = talisman.enabled ? '#ffd700' : '#666';\n  ctx.font = `${Math.max(10, Math.floor(14 * scale))}px serif`;\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n  ctx.fillText('📜', x + s / 2, y + s / 2);\n\n  // Active glow\n  if (talisman.enabled && now - talisman.lastTriggered < 1000) {\n    ctx.fillStyle = 'rgba(255,215,0,0.2)';\n    ctx.fillRect(x + 2, y + 2, s - 4, s - 4);\n  }\n}\n","numLines":167,"startLine":1,"totalLines":167}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_42420f5f89b0448db2b6e252","type":"tool_result","content":"1\t// Renderer.ts — Canvas 2D rendering system\n2\t\n3\timport { Camera } from './Camera';\n4\timport { GameMap } from '../game/Map';\n5\timport type { BuildingInstance } from '../game/GameState';\n6\timport { renderBuilding } from '../game/Building';\n7\timport type { BuildingDef } from '../game/Building';\n8\timport { getResourceDisplays, formatAmount } from '../game/Resources';\n9\timport type { Resources, RealmProgress } from '../game/GameState';\n10\timport { type CultivationState, getFullRealmName, getShortRealmName } from '../game/Cultivation';\n11\t\n12\texport class Renderer {\n13\t  canvas: HTMLCanvasElement;\n14\t  ctx: CanvasRenderingContext2D;\n15\t  camera: Camera;\n16\t\n17\t  constructor(canvas: HTMLCanvasElement) {\n18\t    this.canvas = canvas;\n19\t    this.ctx = canvas.getContext('2d')!;\n20\t    this.camera = new Camera(canvas);\n21\t    this.resize();\n22\t  }\n23\t\n24\t  resize(): void {\n25\t    const dpr = window.devicePixelRatio || 1;\n26\t    const rect = this.canvas.getBoundingClientRect();\n27\t    this.canvas.width = rect.width * dpr;\n28\t    this.canvas.height = rect.height * dpr;\n29\t    this.ctx.scale(dpr, dpr);\n30\t  }\n31\t\n32\t  render(\n33\t    map: GameMap,\n34\t    buildings: BuildingInstance[],\n35\t    buildingDefs: Map<string, BuildingDef>,\n36\t    resources: Resources,\n37\t    realm: RealmProgress,\n38\t    cultivation: CultivationState,\n39\t    hoveredCell: { gx: number; gy: number } | null,\n40\t    placementPreview: { def: BuildingDef; gx: number; gy: number; valid: boolean } | null,\n41\t    now: number,\n42\t  ): void {\n43\t    const ctx = this.ctx;\n44\t    const w = this.canvas.getBoundingClientRect().width;\n45\t    const h = this.canvas.getBoundingClientRect().height;\n46\t\n47\t    ctx.fillStyle = '#1a1a2e';\n48\t    ctx.fillRect(0, 0, w, h);\n49\t\n50\t    const { offsetX, offsetY, scale } = this.camera.getTransform();\n51\t\n52\t    map.render(ctx, offsetX, offsetY, w, h, scale);\n53\t\n54\t    for (const building of buildings) {\n55\t      const def = buildingDefs.get(building.buildingId);\n56\t      if (def) {\n57\t        renderBuilding(ctx, building, def, offsetX, offsetY, scale, map.cellSize, now);\n58\t      }\n59\t    }\n60\t\n61\t    if (placementPreview) {\n62\t      this.renderPlacementPreview(ctx, placementPreview, offsetX, offsetY, scale, map.cellSize);\n63\t    }\n64\t\n65\t    if (hoveredCell && map.inBounds(hoveredCell.gx, hoveredCell.gy)) {\n66\t      const hx = offsetX + hoveredCell.gx * map.cellSize * scale;\n67\t      const hy = offsetY + hoveredCell.gy * map.cellSize * scale;\n68\t      const hs = map.cellSize * scale;\n69\t      ctx.strokeStyle = 'rgba(255,255,255,0.4)';\n70\t      ctx.lineWidth = 1;\n71\t      ctx.strokeRect(hx, hy, hs, hs);\n72\t    }\n73\t\n74\t    this.renderUI(ctx, w, h, resources, realm, cultivation);\n75\t  }\n76\t\n77\t  private renderPlacementPreview(\n78\t    ctx: CanvasRenderingContext2D,\n79\t    preview: { def: BuildingDef; gx: number; gy: number; valid: boolean },\n80\t    offsetX: number,\n81\t    offsetY: number,\n82\t    scale: number,\n83\t    cellSize: number,\n84\t  ): void {\n85\t    const x = offsetX + preview.gx * cellSize * scale;\n86\t    const y = offsetY + preview.gy * cellSize * scale;\n87\t    const w = preview.def.size.w * cellSize * scale;\n88\t    const h = preview.def.size.h * cellSize * scale;\n89\t\n90\t    const { r, g, b } = preview.def.color;\n91\t    const alpha = preview.valid ? 0.4 : 0.2;\n92\t\n93\t    ctx.fillStyle = preview.valid\n94\t      ? `rgba(${r},${g},${b},${alpha})`\n95\t      : `rgba(255,50,50,${alpha})`;\n96\t    ctx.fillRect(x + 2, y + 2, w - 4, h - 4);\n97\t\n98\t    ctx.strokeStyle = preview.valid ? 'rgba(100,255,100,0.8)' : 'rgba(255,100,100,0.8)';\n99\t    ctx.lineWidth = 2;\n100\t    ctx.setLineDash([4, 4]);\n101\t    ctx.strokeRect(x + 2, y + 2, w - 4, h - 4);\n102\t    ctx.setLineDash([]);\n103\t  }\n104\t\n105\t  private renderUI(\n106\t    ctx: CanvasRenderingContext2D,\n107\t    canvasW: number,\n108\t    canvasH: number,\n109\t    resources: Resources,\n110\t    realm: RealmProgress,\n111\t    cultivation: CultivationState,\n112\t  ): void {\n113\t    // Top bar background\n114\t    ctx.fillStyle = 'rgba(0,0,0,0.8)';\n115\t    ctx.fillRect(0, 0, canvasW, 52);\n116\t\n117\t    // Realm display using cultivation system\n118\t    const realmName = getFullRealmName(cultivation);\n119\t    ctx.fillStyle = '#ffd700';\n120\t    ctx.font = 'bold 14px monospace';\n121\t    ctx.textAlign = 'left';\n122\t    ctx.textBaseline = 'middle';\n123\t    ctx.fillText(realmName, 12, 18);\n124\t\n125\t    // Cultivation exp bar\n126\t    const expBarX = 12;\n127\t    const expBarY = 32;\n128\t    const expBarW = 140;\n129\t    const expBarH = 12;\n130\t    const expRatio = cultivation.exp / cultivation.expToNext;\n131\t    ctx.fillStyle = 'rgba(255,255,255,0.1)';\n132\t    ctx.fillRect(expBarX, expBarY, expBarW, expBarH);\n133\t    ctx.fillStyle = '#ffd700';\n134\t    ctx.fillRect(expBarX, expBarY, expBarW * expRatio, expBarH);\n135\t    ctx.strokeStyle = 'rgba(255,255,255,0.3)';\n136\t    ctx.lineWidth = 1;\n137\t    ctx.strokeRect(expBarX, expBarY, expBarW, expBarH);\n138\t    ctx.fillStyle = '#fff';\n139\t    ctx.font = '9px monospace';\n140\t    ctx.textAlign = 'center';\n141\t    ctx.fillText(`${Math.floor(expRatio * 100)}%`, expBarX + expBarW / 2, expBarY + 7);\n142\t\n143\t    // Resource display\n144\t    const displays = getResourceDisplays(resources);\n145\t    let rx = canvasW - 12;\n146\t    ctx.textAlign = 'right';\n147\t    for (let i = displays.length - 1; i >= 0; i--) {\n148\t      const d = displays[i];\n149\t      if (d.amount === 0) continue;\n150\t      const text = `${d.icon} ${formatAmount(d.amount)}`;\n151\t      ctx.font = '11px monospace';\n152\t      const metrics = ctx.measureText(text);\n153\t      rx -= metrics.width + 4;\n154\t      ctx.fillStyle = d.color;\n155\t      ctx.fillText(text, rx + metrics.width, 24);\n156\t      rx -= 14;\n157\t    }\n158\t\n159\t    // Cultivation rate indicator\n160\t    if (cultivation.cultivationRate > 0) {\n161\t      ctx.fillStyle = 'rgba(255,215,0,0.6)';\n162\t      ctx.font = '10px monospace';\n163\t      ctx.textAlign = 'left';\n164\t      ctx.fillText(`⚡${cultivation.cultivationRate.toFixed(1)}/s`, 160, 18);\n165\t    }\n166\t  }\n167\t\n168\t  destroy(): void {\n169\t    // Clean up\n170\t  }\n171\t}\n172\t"}]},"parent_tool_use_id":null,"session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"17930464-e6c0-4998-8933-221bad11b091","timestamp":"2026-05-23T02:11:34.630Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\renderer\\Renderer.ts","content":"// Renderer.ts — Canvas 2D rendering system\n\nimport { Camera } from './Camera';\nimport { GameMap } from '../game/Map';\nimport type { BuildingInstance } from '../game/GameState';\nimport { renderBuilding } from '../game/Building';\nimport type { BuildingDef } from '../game/Building';\nimport { getResourceDisplays, formatAmount } from '../game/Resources';\nimport type { Resources, RealmProgress } from '../game/GameState';\nimport { type CultivationState, getFullRealmName, getShortRealmName } from '../game/Cultivation';\n\nexport class Renderer {\n  canvas: HTMLCanvasElement;\n  ctx: CanvasRenderingContext2D;\n  camera: Camera;\n\n  constructor(canvas: HTMLCanvasElement) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d')!;\n    this.camera = new Camera(canvas);\n    this.resize();\n  }\n\n  resize(): void {\n    const dpr = window.devicePixelRatio || 1;\n    const rect = this.canvas.getBoundingClientRect();\n    this.canvas.width = rect.width * dpr;\n    this.canvas.height = rect.height * dpr;\n    this.ctx.scale(dpr, dpr);\n  }\n\n  render(\n    map: GameMap,\n    buildings: BuildingInstance[],\n    buildingDefs: Map<string, BuildingDef>,\n    resources: Resources,\n    realm: RealmProgress,\n    cultivation: CultivationState,\n    hoveredCell: { gx: number; gy: number } | null,\n    placementPreview: { def: BuildingDef; gx: number; gy: number; valid: boolean } | null,\n    now: number,\n  ): void {\n    const ctx = this.ctx;\n    const w = this.canvas.getBoundingClientRect().width;\n    const h = this.canvas.getBoundingClientRect().height;\n\n    ctx.fillStyle = '#1a1a2e';\n    ctx.fillRect(0, 0, w, h);\n\n    const { offsetX, offsetY, scale } = this.camera.getTransform();\n\n    map.render(ctx, offsetX, offsetY, w, h, scale);\n\n    for (const building of buildings) {\n      const def = buildingDefs.get(building.buildingId);\n      if (def) {\n        renderBuilding(ctx, building, def, offsetX, offsetY, scale, map.cellSize, now);\n      }\n    }\n\n    if (placementPreview) {\n      this.renderPlacementPreview(ctx, placementPreview, offsetX, offsetY, scale, map.cellSize);\n    }\n\n    if (hoveredCell && map.inBounds(hoveredCell.gx, hoveredCell.gy)) {\n      const hx = offsetX + hoveredCell.gx * map.cellSize * scale;\n      const hy = offsetY + hoveredCell.gy * map.cellSize * scale;\n      const hs = map.cellSize * scale;\n      ctx.strokeStyle = 'rgba(255,255,255,0.4)';\n      ctx.lineWidth = 1;\n      ctx.strokeRect(hx, hy, hs, hs);\n    }\n\n    this.renderUI(ctx, w, h, resources, realm, cultivation);\n  }\n\n  private renderPlacementPreview(\n    ctx: CanvasRenderingContext2D,\n    preview: { def: BuildingDef; gx: number; gy: number; valid: boolean },\n    offsetX: number,\n    offsetY: number,\n    scale: number,\n    cellSize: number,\n  ): void {\n    const x = offsetX + preview.gx * cellSize * scale;\n    const y = offsetY + preview.gy * cellSize * scale;\n    const w = preview.def.size.w * cellSize * scale;\n    const h = preview.def.size.h * cellSize * scale;\n\n    const { r, g, b } = preview.def.color;\n    const alpha = preview.valid ? 0.4 : 0.2;\n\n    ctx.fillStyle = preview.valid\n      ? `rgba(${r},${g},${b},${alpha})`\n      : `rgba(255,50,50,${alpha})`;\n    ctx.fillRect(x + 2, y + 2, w - 4, h - 4);\n\n    ctx.strokeStyle = preview.valid ? 'rgba(100,255,100,0.8)' : 'rgba(255,100,100,0.8)';\n    ctx.lineWidth = 2;\n    ctx.setLineDash([4, 4]);\n    ctx.strokeRect(x + 2, y + 2, w - 4, h - 4);\n    ctx.setLineDash([]);\n  }\n\n  private renderUI(\n    ctx: CanvasRenderingContext2D,\n    canvasW: number,\n    canvasH: number,\n    resources: Resources,\n    realm: RealmProgress,\n    cultivation: CultivationState,\n  ): void {\n    // Top bar background\n    ctx.fillStyle = 'rgba(0,0,0,0.8)';\n    ctx.fillRect(0, 0, canvasW, 52);\n\n    // Realm display using cultivation system\n    const realmName = getFullRealmName(cultivation);\n    ctx.fillStyle = '#ffd700';\n    ctx.font = 'bold 14px monospace';\n    ctx.textAlign = 'left';\n    ctx.textBaseline = 'middle';\n    ctx.fillText(realmName, 12, 18);\n\n    // Cultivation exp bar\n    const expBarX = 12;\n    const expBarY = 32;\n    const expBarW = 140;\n    const expBarH = 12;\n    const expRatio = cultivation.exp / cultivation.expToNext;\n    ctx.fillStyle = 'rgba(255,255,255,0.1)';\n    ctx.fillRect(expBarX, expBarY, expBarW, expBarH);\n    ctx.fillStyle = '#ffd700';\n    ctx.fillRect(expBarX, expBarY, expBarW * expRatio, expBarH);\n    ctx.strokeStyle = 'rgba(255,255,255,0.3)';\n    ctx.lineWidth = 1;\n    ctx.strokeRect(expBarX, expBarY, expBarW, expBarH);\n    ctx.fillStyle = '#fff';\n    ctx.font = '9px monospace';\n    ctx.textAlign = 'center';\n    ctx.fillText(`${Math.floor(expRatio * 100)}%`, expBarX + expBarW / 2, expBarY + 7);\n\n    // Resource display\n    const displays = getResourceDisplays(resources);\n    let rx = canvasW - 12;\n    ctx.textAlign = 'right';\n    for (let i = displays.length - 1; i >= 0; i--) {\n      const d = displays[i];\n      if (d.amount === 0) continue;\n      const text = `${d.icon} ${formatAmount(d.amount)}`;\n      ctx.font = '11px monospace';\n      const metrics = ctx.measureText(text);\n      rx -= metrics.width + 4;\n      ctx.fillStyle = d.color;\n      ctx.fillText(text, rx + metrics.width, 24);\n      rx -= 14;\n    }\n\n    // Cultivation rate indicator\n    if (cultivation.cultivationRate > 0) {\n      ctx.fillStyle = 'rgba(255,215,0,0.6)';\n      ctx.font = '10px monospace';\n      ctx.textAlign = 'left';\n      ctx.fillText(`⚡${cultivation.cultivationRate.toFixed(1)}/s`, 160, 18);\n    }\n  }\n\n  destroy(): void {\n    // Clean up\n  }\n}\n","numLines":172,"startLine":1,"totalLines":172}}}
