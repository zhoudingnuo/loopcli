 Math.floor((y - this.boardY) / this.tileSize);\n55\t    if (row >= 0 && row < this.board.size && col >= 0 && col < this.board.size) {\n56\t      return { row, col };\n57\t    }\n58\t    return null;\n59\t  }\n60\t\n61\t  _onPointerDown(x, y) {\n62\t    if (!this.enabled) return;\n63\t    const cell = this._screenToGrid(x, y);\n64\t    if (!cell) return;\n65\t    this.swipeStart = { x, y, row: cell.row, col: cell.col };\n66\t  }\n67\t\n68\t  _onPointerMove(x, y) {\n69\t    // Could use for drag visualization\n70\t  }\n71\t\n72\t  _onPointerUp(x, y) {\n73\t    if (!this.enabled || !this.swipeStart) return;\n74\t    const start = this.swipeStart;\n75\t    this.swipeStart = null;\n76\t\n77\t    const dx = x - start.x;\n78\t    const dy = y - start.y;\n79\t    const dist = Math.sqrt(dx * dx + dy * dy);\n80\t\n81\t    // Minimum swipe distance threshold\n82\t    if (dist < this.tileSize * 0.2) {\n83\t      // Tap — treat as selection or swap trigger\n84\t      if (this.onTap) this.onTap(start.row, start.col);\n85\t      return;\n86\t    }\n87\t\n88\t    // Determine swipe direction\n89\t    let targetRow = start.row;\n90\t    let targetCol = start.col;\n91\t    if (Math.abs(dx) > Math.abs(dy)) {\n92\t      targetCol += dx > 0 ? 1 : -1;\n93\t    } else {\n94\t      targetRow += dy > 0 ? 1 : -1;\n95\t    }\n96\t\n97\t    // Validate\n98\t    if (this.board.isValid(targetRow, targetCol)) {\n99\t      if (this.onSwap) {\n100\t        this.onSwap(start.row, start.col, targetRow, targetCol);\n101\t      }\n102\t    }\n103\t  }\n104\t}\n105\t\n106\tif (typeof module !== 'undefined') module.exports = { InputHandler };\n107\t"}]},"parent_tool_use_id":null,"session_id":"4fc1920c-0b5c-4266-b43d-05c38f749fa3","uuid":"5e103d24-c4d6-4abe-94b3-ff4e59fe6877","timestamp":"2026-05-22T21:28:47.961Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-match3/src/js/InputHandler.js","content":"// InputHandler.js — Touch and mouse input handling for swipe detection\n\nclass InputHandler {\n  constructor(canvas, board) {\n    this.canvas = canvas;\n    this.board = board;\n    this.tileSize = 0;\n    this.boardX = 0;\n    this.boardY = 0;\n\n    this.swipeStart = null;\n    this.selectedTile = null;\n    this.onSwap = null;         // (r1, c1, r2, c2) => void\n    this.onTap = null;          // (row, col) => void\n    this.enabled = true;\n\n    this._bindEvents();\n  }\n\n  updateLayout(tileSize, boardX, boardY) {\n    this.tileSize = tileSize;\n    this.boardX = boardX;\n    this.boardY = boardY;\n  }\n\n  _bindEvents() {\n    // Mouse events\n    this.canvas.addEventListener('mousedown', e => this._onPointerDown(e.clientX, e.clientY));\n    this.canvas.addEventListener('mousemove', e => this._onPointerMove(e.clientX, e.clientY));\n    this.canvas.addEventListener('mouseup', e => this._onPointerUp(e.clientX, e.clientY));\n\n    // Touch events\n    this.canvas.addEventListener('touchstart', e => {\n      e.preventDefault();\n      const t = e.touches[0];\n      this._onPointerDown(t.clientX, t.clientY);\n    }, { passive: false });\n\n    this.canvas.addEventListener('touchmove', e => {\n      e.preventDefault();\n      const t = e.touches[0];\n      this._onPointerMove(t.clientX, t.clientY);\n    }, { passive: false });\n\n    this.canvas.addEventListener('touchend', e => {\n      e.preventDefault();\n      const t = e.changedTouches[0];\n      this._onPointerUp(t.clientX, t.clientY);\n    }, { passive: false });\n  }\n\n  _screenToGrid(x, y) {\n    const col = Math.floor((x - this.boardX) / this.tileSize);\n    const row = Math.floor((y - this.boardY) / this.tileSize);\n    if (row >= 0 && row < this.board.size && col >= 0 && col < this.board.size) {\n      return { row, col };\n    }\n    return null;\n  }\n\n  _onPointerDown(x, y) {\n    if (!this.enabled) return;\n    const cell = this._screenToGrid(x, y);\n    if (!cell) return;\n    this.swipeStart = { x, y, row: cell.row, col: cell.col };\n  }\n\n  _onPointerMove(x, y) {\n    // Could use for drag visualization\n  }\n\n  _onPointerUp(x, y) {\n    if (!this.enabled || !this.swipeStart) return;\n    const start = this.swipeStart;\n    this.swipeStart = null;\n\n    const dx = x - start.x;\n    const dy = y - start.y;\n    const dist = Math.sqrt(dx * dx + dy * dy);\n\n    // Minimum swipe distance threshold\n    if (dist < this.tileSize * 0.2) {\n      // Tap — treat as selection or swap trigger\n      if (this.onTap) this.onTap(start.row, start.col);\n      return;\n    }\n\n    // Determine swipe direction\n    let targetRow = start.row;\n    let targetCol = start.col;\n    if (Math.abs(dx) > Math.abs(dy)) {\n      targetCol += dx > 0 ? 1 : -1;\n    } else {\n      targetRow += dy > 0 ? 1 : -1;\n    }\n\n    // Validate\n    if (this.board.isValid(targetRow, targetCol)) {\n      if (this.onSwap) {\n        this.onSwap(start.row, start.col, targetRow, targetCol);\n      }\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { InputHandler };\n","numLines":107,"startLine":1,"totalLines":107}}}
