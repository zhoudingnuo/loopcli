{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_108f67001a6f4be2ac9cb0b9","type":"tool_result","content":"The file D:/game-projects/douyin-match3/src/js/Game.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"4fc1920c-0b5c-4266-b43d-05c38f749fa3","uuid":"401d4916-e9d9-433d-81e4-d47472272477","timestamp":"2026-05-22T21:35:31.966Z","tool_use_result":{"filePath":"D:/game-projects/douyin-match3/src/js/Game.js","oldString":"  _afterMoveComplete() {\n    // Spread chocolate\n    this.obstacleMgr.spreadChocolate();\n\n    // Boss ability\n    if (this.boss && this.boss.active) {\n      const ability = this.boss.tryUseAbility();\n      if (ability) {\n        this._executeBossAbility(ability);\n      }\n    }\n\n    this.state = STATES.IDLE;\n\n    // Check deadlock\n    if (!this.board.hasValidMoves(this.obstacleMgr)) {\n      this.board.shuffle();\n    }\n\n    this.scoreSystem.checkState();\n  }","newString":"  _afterMoveComplete() {\n    // Check if boss was defeated this turn\n    if (this.boss && this.boss.isDefeated() && this.scoreSystem.goalType === 'boss') {\n      this.state = STATES.RESULT;\n      const stars = this.scoreSystem.getStarCount();\n      this.resultData = { won: true, score: this.scoreSystem.score, stars, level: this.currentLevel + 1 };\n      this.audio.playLevelWin();\n      return;\n    }\n\n    // Spread chocolate\n    this.obstacleMgr.spreadChocolate();\n\n    // Boss ability\n    if (this.boss && this.boss.active) {\n      const ability = this.boss.tryUseAbility();\n      if (ability) {\n        this._executeBossAbility(ability);\n      }\n    }\n\n    this.state = STATES.IDLE;\n\n    // Check deadlock\n    if (!this.board.hasValidMoves(this.obstacleMgr)) {\n      this.board.shuffle();\n    }\n\n    this.scoreSystem.checkState();\n  }","originalFile":"// Game.js — Main game loop, state machine, integrates all Phase 2 systems\n\nconst STATES = {\n  MENU: 'menu',\n  IDLE: 'idle',\n  SWAPPING: 'swapping',\n  MATCHING: 'matching',\n  REMOVING: 'removing',\n  DROPPING: 'dropping',\n  RESULT: 'result',\n  BOSS_SKILL: 'boss_skill',\n};\n\nclass Game {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.board = new Board();\n    this.matchEngine = new MatchEngine(this.board);\n    this.renderer = new Renderer(canvas);\n    this.input = new InputHandler(canvas, this.board);\n    this.scoreSystem = new ScoreSystem();\n    this.tweens = new TweenManager();\n    this.particles = new ParticleSystem();\n    this.obstacleMgr = new ObstacleManager(this.board);\n    this.audio = new AudioManager();\n    this.boss = null;\n    this.levels = LEVELS;\n    this.currentLevel = 0;\n    this.state = STATES.MENU;\n    this.comboText = '';\n    this.comboTimer = 0;\n    this.lastTime = 0;\n    this.resultData = null;\n    this.moveCount = 0;\n\n    this.renderer.particleSystem = this.particles;\n\n    this._setupInput();\n    this._setupScoreCallbacks();\n    this._setupObstacleCallbacks();\n  }\n\n  _setupInput() {\n    this.input.onSwap = (r1, c1, r2, c2) => this._handleSwap(r1, c1, r2, c2);\n    this.input.onTap = (row, col) => this._handleTap(row, col);\n  }\n\n  _setupScoreCallbacks() {\n    this.scoreSystem.onLevelComplete = (score, stars) => {\n      this.state = STATES.RESULT;\n      this.resultData = { won: true, score, stars, level: this.currentLevel + 1 };\n      this.audio.playLevelWin();\n    };\n    this.scoreSystem.onLevelFail = (score) => {\n      this.state = STATES.RESULT;\n      this.resultData = { won: false, score, stars: 0, level: this.currentLevel + 1 };\n      this.audio.playLevelFail();\n    };\n  }\n\n  _setupObstacleCallbacks() {\n    this.obstacleMgr.onObstacleDestroyed = (obs) => {\n      this.scoreSystem.addObstacleCleared(obs.type);\n      this.audio.playObstacleBreak();\n      const pos = this.renderer.getTileCenter(obs.row, obs.col);\n      this.particles.emitExplosion(pos.x, pos.y, this._obstacleColor(obs.type), 12);\n    };\n  }\n\n  _obstacleColor(type) {\n    switch (type) {\n      case OBSTACLE_ICE: return '#88CCFF';\n      case OBSTACLE_CHAIN: return '#AAAAAA';\n      case OBSTACLE_CHOCOLATE: return '#8B4513';\n      default: return '#FFFFFF';\n    }\n  }\n\n  start() {\n    this._loadLevel(0);\n    this.state = STATES.IDLE;\n    this.lastTime = performance.now();\n    this._loop();\n  }\n\n  _loadLevel(idx) {\n    this.currentLevel = idx;\n    const config = this.levels[idx] || this.levels[0];\n    this.board.init();\n    this.scoreSystem.reset(idx + 1);\n    this.scoreSystem.configure(config);\n    this.tweens.clear();\n    this.particles.particles = [];\n    this.renderer.floatingTexts = [];\n    this.comboText = '';\n    this.resultData = null;\n    this.moveCount = 0;\n\n    // Load obstacles\n    this.obstacleMgr.loadFromConfig(config.obstacles);\n\n    // Clear cells with chocolate obstacles\n    for (const obs of this.obstacleMgr.obstacles) {\n      if (obs.type === OBSTACLE_CHOCOLATE) {\n        this.board.clearCell(obs.row, obs.col);\n      }\n    }\n\n    // Load boss\n    this.boss = null;\n    if (config.boss) {\n      this.boss = new Boss(config.boss);\n      this.board.clearCell(this.boss.row, this.boss.col);\n    }\n\n    // Apply gravity to fill gaps from chocolate/boss\n    this.board.applyGravity();\n\n    // Remove initial matches\n    this.board._removeInitialMatches();\n\n    this.input.updateLayout(\n      this.renderer.tileSize,\n      this.renderer.boardX,\n      this.renderer.boardY,\n    );\n  }\n\n  _handleTap(row, col) {\n    if (this.state !== STATES.IDLE) return;\n    const tile = this.board.getTile(row, col);\n    if (!tile) return;\n\n    // Initialize audio on first interaction\n    this.audio.init();\n\n    if (tile.special === SPECIAL_RAINBOW) return;\n  }\n\n  _handleSwap(r1, c1, r2, c2) {\n    if (this.state !== STATES.IDLE) return;\n\n    this.audio.init();\n\n    const tileA = this.board.getTile(r1, c1);\n    const tileB = this.board.getTile(r2, c2);\n\n    // Check chain lock\n    if (!this.obstacleMgr.canSwap(r1, c1) || !this.obstacleMgr.canSwap(r2, c2)) {\n      this.audio.playInvalid();\n      return;\n    }\n\n    // Rainbow special combinations\n    if (tileA && tileA.special === SPECIAL_RAINBOW) {\n      this._activateRainbow(r1, c1, tileB ? tileB.color : 0, r2, c2);\n      return;\n    }\n    if (tileB && tileB.special === SPECIAL_RAINBOW) {\n      this._activateRainbow(r2, c2, tileA ? tileA.color : 0, r1, c1);\n      return;\n    }\n\n    if (!this.matchEngine.isValidSwap(r1, c1, r2, c2)) {\n      this.audio.playInvalid();\n      return;\n    }\n    if (!this.scoreSystem.useMove()) return;\n\n    this.audio.playSwap();\n    this.moveCount++;\n    this.state = STATES.SWAPPING;\n    this.board.swap(r1, c1, r2, c2);\n\n    this._animateSwap(r1, c1, r2, c2, () => {\n      this._processMatches();\n    });\n  }\n\n  _animateSwap(r1, c1, r2, c2, callback) {\n    const tileSize = this.renderer.tileSize;\n    const tileA = this.board.getTile(r2, c2);\n    const tileB = this.board.getTile(r1, c1);\n    const dx = (c2 - c1) * tileSize;\n    const dy = (r2 - r1) * tileSize;\n\n    if (tileA) {\n      tileA.offsetX = -dx;\n      tileA.offsetY = -dy;\n      this.tweens.add(tileA, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n    }\n    if (tileB) {\n      tileB.offsetX = dx;\n      tileB.offsetY = dy;\n      this.tweens.add(tileB, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n    }\n    setTimeout(callback, 160);\n  }\n\n  _activateRainbow(rainbowRow, rainbowCol, targetColor, otherRow, otherCol) {\n    if (!this.scoreSystem.useMove()) return;\n    this.moveCount++;\n    this.audio.playSpecial();\n    this.state = STATES.MATCHING;\n\n    const toRemove = this.matchEngine.triggerRainbow(rainbowRow, rainbowCol, targetColor);\n    toRemove.push({ row: rainbowRow, col: rainbowCol });\n    if (this.board.getTile(otherRow, otherCol)) {\n      toRemove.push({ row: otherRow, col: otherCol });\n    }\n\n    this._removeAndCascade(toRemove, 10);\n  }\n\n  _processMatches() {\n    this.state = STATES.MATCHING;\n    const matches = this.board.findAllMatches();\n\n    if (matches.length === 0) {\n      this._afterMoveComplete();\n      return;\n    }\n\n    this._processChain(0);\n  }\n\n  _processChain(chainCount) {\n    chainCount++;\n    const matches = this.board.findAllMatches();\n    if (matches.length === 0) {\n      this._afterMoveComplete();\n      return;\n    }\n\n    const lShapes = this.board.findLShapeMatches(matches);\n    const { removeCells, specials } = this.matchEngine._classifyMatches(matches, lShapes);\n\n    const multiplier = chainCount <= 1 ? 1 : chainCount === 2 ? 1.5 : chainCount === 3 ? 2.0 : 2.5;\n    const baseScore = removeCells.size * 10;\n    const points = Math.floor(baseScore * multiplier);\n    this.scoreSystem.addScore(points);\n\n    if (chainCount >= 4) this.comboText = '超赞！！';\n    else if (chainCount === 3) this.comboText = '太棒了！';\n    else if (chainCount === 2) this.comboText = '不错！';\n    this.comboTimer = 0.8;\n\n    this.audio.playMatch(chainCount);\n    if (chainCount >= 2) this.audio.playCombo(chainCount);\n\n    // Collect matched positions for obstacle/boss damage\n    const matchedPositions = [];\n    for (const key of removeCells) {\n      const [r, c] = key.split(',').map(Number);\n      const tile = this.board.getTile(r, c);\n      if (tile && tile.color >= 0) {\n        this.scoreSystem.addCollected(tile.color, 1);\n      }\n      matchedPositions.push({ row: r, col: c });\n    }\n\n    // Create specials\n    const specialPositions = new Set(specials.map(s => `${s.row},${s.col}`));\n    for (const sp of specials) {\n      const tile = this.board.getTile(sp.row, sp.col);\n      if (tile) {\n        tile.special = sp.type;\n        tile.removing = false;\n      }\n    }\n\n    // Animate removal\n    this.state = STATES.REMOVING;\n    const toAnimate = [];\n    for (const key of removeCells) {\n      if (specialPositions.has(key)) continue;\n      const [r, c] = key.split(',').map(Number);\n      const tile = this.board.getTile(r, c);\n      if (tile) {\n        const pos = this.renderer.getTileCenter(r, c);\n        const color = COLOR_MAP[tile.color];\n        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 8);\n        this.renderer.addFloatingText(`+${points}`, pos.x, pos.y);\n        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n        toAnimate.push(tile);\n      }\n    }\n\n    setTimeout(() => {\n      // Remove tiles\n      for (const key of removeCells) {\n        if (specialPositions.has(key)) continue;\n        const [r, c] = key.split(',').map(Number);\n        this.board.clearCell(r, c);\n      }\n\n      // Trigger specials\n      for (const sp of specials) {\n        this._triggerSpecialEffects(sp.row, sp.col, sp.type);\n      }\n\n      // Damage obstacles\n      this.obstacleMgr.onTilesMatched(matchedPositions);\n\n      // Damage boss\n      if (this.boss && this.boss.active) {\n        const dmg = this.boss.calculateDamage(matchedPositions);\n        if (dmg > 0) {\n          const defeated = this.boss.takeDamage(dmg);\n          this.audio.playBossHit();\n          if (defeated) {\n            this.audio.playBossDefeat();\n            this.scoreSystem.addScore(500);\n          }\n        }\n      }\n\n      // Apply gravity\n      this.state = STATES.DROPPING;\n      const drops = this.board.applyGravity();\n\n      for (const drop of drops) {\n        const tile = drop.tile;\n        const fromY = drop.fromRow * this.renderer.tileSize;\n        const toY = drop.toRow * this.renderer.tileSize;\n        tile.offsetY = fromY - toY;\n        this.tweens.add(tile, { offsetY: 0 }, 0.2 + drop.distance * 0.03, 'easeOutBounce');\n      }\n\n      setTimeout(() => {\n        this._processChain(chainCount);\n      }, 350);\n    }, 280);\n  }\n\n  _afterMoveComplete() {\n    // Spread chocolate\n    this.obstacleMgr.spreadChocolate();\n\n    // Boss ability\n    if (this.boss && this.boss.active) {\n      const ability = this.boss.tryUseAbility();\n      if (ability) {\n        this._executeBossAbility(ability);\n      }\n    }\n\n    this.state = STATES.IDLE;\n\n    // Check deadlock\n    if (!this.board.hasValidMoves(this.obstacleMgr)) {\n      this.board.shuffle();\n    }\n\n    this.scoreSystem.checkState();\n  }\n\n  _executeBossAbility(ability) {\n    this.audio.playBossAbility();\n\n    switch (ability) {\n      case 'freeze': {\n        // Add ice to 2 random empty cells (no existing obstacle)\n        const candidates = [];\n        for (let r = 0; r < this.board.size; r++) {\n          for (let c = 0; c < this.board.size; c++) {\n            if (!this.obstacleMgr.hasObstacle(r, c) && this.board.getTile(r, c)) {\n              // Don't freeze boss position\n              if (this.boss && r === this.boss.row && c === this.boss.col) continue;\n              candidates.push({ row: r, col: c });\n            }\n          }\n        }\n        const count = Math.min(2, candidates.length);\n        for (let i = 0; i < count; i++) {\n          const idx = Math.floor(Math.random() * candidates.length);\n          const target = candidates.splice(idx, 1)[0];\n          this.obstacleMgr.addObstacle(OBSTACLE_ICE, target.row, target.col);\n        }\n        break;\n      }\n      case 'chain': {\n        const candidates = [];\n        for (let r = 0; r < this.board.size; r++) {\n          for (let c = 0; c < this.board.size; c++) {\n            if (!this.obstacleMgr.hasObstacle(r, c) && this.board.getTile(r, c)) {\n              if (this.boss && r === this.boss.row && c === this.boss.col) continue;\n              candidates.push({ row: r, col: c });\n            }\n          }\n        }\n        if (candidates.length > 0) {\n          const idx = Math.floor(Math.random() * candidates.length);\n          const target = candidates[idx];\n          this.obstacleMgr.addObstacle(OBSTACLE_CHAIN, target.row, target.col);\n        }\n        break;\n      }\n      case 'chocolate': {\n        // Add chocolate to 1 random empty cell\n        const dirs = [[-1,0],[1,0],[0,-1],[0,1]];\n        const candidates = [];\n        for (const [dr, dc] of dirs) {\n          const nr = this.boss.row + dr;\n          const nc = this.boss.col + dc;\n          if (this.board.isValid(nr, nc) && !this.obstacleMgr.hasObstacle(nr, nc)) {\n            candidates.push({ row: nr, col: nc });\n          }\n        }\n        if (candidates.length > 0) {\n          const target = candidates[Math.floor(Math.random() * candidates.length)];\n          this.obstacleMgr.addObstacle(OBSTACLE_CHOCOLATE, target.row, target.col);\n        }\n        break;\n      }\n    }\n  }\n\n  _triggerSpecialEffects(row, col, type) {\n    const pos = this.renderer.getTileCenter(row, col);\n    const tile = this.board.getTile(row, col);\n    const color = tile ? COLOR_MAP[tile.color]?.hex : '#FFB800';\n\n    this.audio.playSpecial();\n\n    switch (type) {\n      case 1: case 2:\n        this.particles.emitExplosion(pos.x, pos.y, color || '#FFB800', 20);\n        break;\n      case 3:\n        this.particles.emitExplosion(pos.x, pos.y, '#FF9A3C', 30);\n        break;\n      case 4:\n        for (let i = 0; i < 40; i++) {\n          this.particles.emitExplosion(pos.x, pos.y, '#FFB800', 2);\n        }\n        break;\n    }\n  }\n\n  _removeAndCascade(cells, scorePerCell) {\n    this.state = STATES.REMOVING;\n    const points = cells.length * scorePerCell;\n    this.scoreSystem.addScore(points);\n\n    // Collect colors\n    for (const { row, col } of cells) {\n      const tile = this.board.getTile(row, col);\n      if (tile && tile.color >= 0) {\n        this.scoreSystem.addCollected(tile.color, 1);\n      }\n    }\n\n    for (const { row, col } of cells) {\n      const tile = this.board.getTile(row, col);\n      if (tile) {\n        const pos = this.renderer.getTileCenter(row, col);\n        const color = COLOR_MAP[tile.color];\n        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 6);\n        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n      }\n    }\n\n    setTimeout(() => {\n      for (const { row, col } of cells) {\n        this.board.clearCell(row, col);\n      }\n\n      // Damage obstacles\n      this.obstacleMgr.onTilesMatched(cells);\n\n      // Damage boss\n      if (this.boss && this.boss.active) {\n        const dmg = this.boss.calculateDamage(cells);\n        if (dmg > 0) {\n          const defeated = this.boss.takeDamage(dmg);\n          this.audio.playBossHit();\n          if (defeated) {\n            this.audio.playBossDefeat();\n            this.scoreSystem.addScore(500);\n          }\n        }\n      }\n\n      this.board.applyGravity();\n\n      this.state = STATES.IDLE;\n      setTimeout(() => this._processMatches(), 200);\n    }, 300);\n  }\n\n  _loop() {\n    const now = performance.now();\n    const dt = Math.min((now - this.lastTime) / 1000, 0.05);\n    this.lastTime = now;\n\n    this.update(dt);\n    this.render();\n    requestAnimationFrame(() => this._loop());\n  }\n\n  update(dt) {\n    this.tweens.update(dt);\n    this.particles.update(dt);\n    this.obstacleMgr.update(dt);\n    if (this.boss) this.boss.update(dt);\n\n    if (this.comboTimer > 0) {\n      this.comboTimer -= dt;\n      if (this.comboTimer <= 0) this.comboText = '';\n    }\n\n    this.input.enabled = this.state === STATES.IDLE;\n  }\n\n  render() {\n    this.renderer.clear();\n    this.renderer.drawBackground();\n\n    // Draw tiles\n    for (let r = 0; r < this.board.size; r++) {\n      for (let c = 0; c < this.board.size; c++) {\n        const tile = this.board.getTile(r, c);\n        if (tile) this.renderer.drawTile(tile);\n      }\n    }\n\n    // Draw obstacles\n    this.renderer.drawObstacles(this.obstacleMgr);\n\n    // Draw boss\n    if (this.boss && this.boss.active) {\n      this.renderer.drawBoss(this.boss, this.renderer);\n    }\n\n    // Particles\n    this.particles.draw(this.renderer.ctx);\n\n    // Floating texts\n    this.renderer.updateAndDrawFloatingTexts(1 / 60);\n\n    // UI\n    const config = this.levels[this.currentLevel] || this.levels[0];\n    this.renderer.drawUI(\n      this.scoreSystem.score,\n      this.scoreSystem.getRemainingMoves(),\n      config,\n      this.scoreSystem,\n      this.currentLevel + 1,\n    );\n\n    // Combo text\n    if (this.comboText) {\n      this.renderer.drawComboText(this.comboText);\n    }\n\n    // Boss health bar\n    if (this.boss && this.boss.active) {\n      this.renderer.drawBossHealthBar(this.boss);\n    }\n\n    // Result screen\n    if (this.resultData) {\n      this.renderer.drawResultScreen(\n        this.resultData.won,\n        this.resultData.score,\n        this.resultData.stars,\n        this.resultData.level,\n      );\n    }\n  }\n\n  retry() {\n    this._loadLevel(this.currentLevel);\n    this.state = STATES.IDLE;\n  }\n\n  nextLevel() {\n    const next = this.currentLevel + 1;\n    if (next < this.levels.length) {\n      this._loadLevel(next);\n      this.state = STATES.IDLE;\n    } else {\n      this._loadLevel(0);\n      this.state = STATES.IDLE;\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Game, STATES };\n","structuredPatch":[{"oldStart":334,"oldLines":6,"newStart":334,"newLines":15,"lines":["   }"," ","   _afterMoveComplete() {","+    // Check if boss was defeated this turn","+    if (this.boss && this.boss.isDefeated() && this.scoreSystem.goalType === 'boss') {","+      this.state = STATES.RESULT;","+      const stars = this.scoreSystem.getStarCount();","+      this.resultData = { won: true, score: this.scoreSystem.score, stars, level: this.currentLevel + 1 };","+      this.audio.playLevelWin();","+      return;","+    }","+","     // Spread chocolate","     this.obstacleMgr.spreadChocolate();"," "]}],"userModified":false,"repla