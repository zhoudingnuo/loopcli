{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_cb331b551cc8451c96a34d9e","type":"tool_result","content":"1\t// Camera.ts — Camera system with zoom, pan, and coordinate transformation\n2\t\n3\texport class Camera {\n4\t  x: number = 0;\n5\t  y: number = 0;\n6\t  zoom: number = 1;\n7\t  minZoom: number = 0.25;\n8\t  maxZoom: number = 4;\n9\t  targetZoom: number = 1;\n10\t\n11\t  private isDragging: boolean = false;\n12\t  private dragStartX: number = 0;\n13\t  private dragStartY: number = 0;\n14\t  private camStartX: number = 0;\n15\t  private camStartY: number = 0;\n16\t  private canvas: HTMLCanvasElement;\n17\t\n18\t  constructor(canvas: HTMLCanvasElement) {\n19\t    this.canvas = canvas;\n20\t    this.setupInput(canvas);\n21\t  }\n22\t\n23\t  // Center the camera on a map position\n24\t  centerOnMap(mapWidth: number, mapHeight: number, cellSize: number): void {\n25\t    const mapPixelW = mapWidth * cellSize * this.zoom;\n26\t    const mapPixelH = mapHeight * cellSize * this.zoom;\n27\t    this.x = (this.canvas.width - mapPixelW) / 2;\n28\t    this.y = (this.canvas.height - mapPixelH) / 2;\n29\t  }\n30\t\n31\t  // Convert screen coords to world coords\n32\t  screenToWorld(sx: number, sy: number): { wx: number; wy: number } {\n33\t    return {\n34\t      wx: (sx - this.x) / this.zoom,\n35\t      wy: (sy - this.y) / this.zoom,\n36\t    };\n37\t  }\n38\t\n39\t  // Convert world coords to screen coords\n40\t  worldToScreen(wx: number, wy: number): { sx: number; sy: number } {\n41\t    return {\n42\t      sx: wx * this.zoom + this.x,\n43\t      sy: wy * this.zoom + this.y,\n44\t    };\n45\t  }\n46\t\n47\t  // Get the offset and scale for rendering\n48\t  getTransform(): { offsetX: number; offsetY: number; scale: number } {\n49\t    return {\n50\t      offsetX: this.x,\n51\t      offsetY: this.y,\n52\t      scale: this.zoom,\n53\t    };\n54\t  }\n55\t\n56\t  // Zoom toward a point (usually mouse position)\n57\t  zoomAt(delta: number, screenX: number, screenY: number): void {\n58\t    const oldZoom = this.zoom;\n59\t    this.targetZoom = Math.max(this.minZoom, Math.min(this.maxZoom, this.targetZoom * (1 - delta * 0.001)));\n60\t    this.zoom = this.targetZoom;\n61\t\n62\t    // Adjust position to zoom toward the cursor\n63\t    const zoomRatio = this.zoom / oldZoom;\n64\t    this.x = screenX - (screenX - this.x) * zoomRatio;\n65\t    this.y = screenY - (screenY - this.y) * zoomRatio;\n66\t  }\n67\t\n68\t  private setupInput(canvas: HTMLCanvasElement): void {\n69\t    // Mouse drag for panning\n70\t    canvas.addEventListener('mousedown', (e) => {\n71\t      if (e.button === 0 || e.button === 1) { // left or middle button\n72\t        this.isDragging = true;\n73\t        this.dragStartX = e.clientX;\n74\t        this.dragStartY = e.clientY;\n75\t        this.camStartX = this.x;\n76\t        this.camStartY = this.y;\n77\t      }\n78\t    });\n79\t\n80\t    canvas.addEventListener('mousemove', (e) => {\n81\t      if (!this.isDragging) return;\n82\t      this.x = this.camStartX + (e.clientX - this.dragStartX);\n83\t      this.y = this.camStartY + (e.clientY - this.dragStartY);\n84\t    });\n85\t\n86\t    canvas.addEventListener('mouseup', () => {\n87\t      this.isDragging = false;\n88\t    });\n89\t\n90\t    canvas.addEventListener('mouseleave', () => {\n91\t      this.isDragging = false;\n92\t    });\n93\t\n94\t    // Mouse wheel for zooming\n95\t    canvas.addEventListener('wheel', (e) => {\n96\t      e.preventDefault();\n97\t      this.zoomAt(e.deltaY, e.offsetX, e.offsetY);\n98\t    }, { passive: false });\n99\t\n100\t    // Touch support\n101\t    let lastTouchDist = 0;\n102\t    let lastTouchCenter = { x: 0, y: 0 };\n103\t\n104\t    canvas.addEventListener('touchstart', (e) => {\n105\t      if (e.touches.length === 1) {\n106\t        this.isDragging = true;\n107\t        this.dragStartX = e.touches[0].clientX;\n108\t        this.dragStartY = e.touches[0].clientY;\n109\t        this.camStartX = this.x;\n110\t        this.camStartY = this.y;\n111\t      } else if (e.touches.length === 2) {\n112\t        this.isDragging = false;\n113\t        lastTouchDist = this.getTouchDistance(e.touches);\n114\t        lastTouchCenter = this.getTouchCenter(e.touches);\n115\t      }\n116\t      e.preventDefault();\n117\t    }, { passive: false });\n118\t\n119\t    canvas.addEventListener('touchmove', (e) => {\n120\t      if (e.touches.length === 1 && this.isDragging) {\n121\t        this.x = this.camStartX + (e.touches[0].clientX - this.dragStartX);\n122\t        this.y = this.camStartY + (e.touches[0].clientY - this.dragStartY);\n123\t      } else if (e.touches.length === 2) {\n124\t        const dist = this.getTouchDistance(e.touches);\n125\t        const center = this.getTouchCenter(e.touches);\n126\t        const delta = lastTouchDist - dist;\n127\t        this.zoomAt(delta * 2, center.x, center.y);\n128\t        lastTouchDist = dist;\n129\t      }\n130\t      e.preventDefault();\n131\t    }, { passive: false });\n132\t\n133\t    canvas.addEventListener('touchend', () => {\n134\t      this.isDragging = false;\n135\t    });\n136\t  }\n137\t\n138\t  private getTouchDistance(touches: TouchList): number {\n139\t    const dx = touches[0].clientX - touches[1].clientX;\n140\t    const dy = touches[0].clientY - touches[1].clientY;\n141\t    return Math.sqrt(dx * dx + dy * dy);\n142\t  }\n143\t\n144\t  private getTouchCenter(touches: TouchList): { x: number; y: number } {\n145\t    return {\n146\t      x: (touches[0].clientX + touches[1].clientX) / 2,\n147\t      y: (touches[0].clientY + touches[1].clientY) / 2,\n148\t    };\n149\t  }\n150\t\n151\t  // Check if the camera was dragged (for distinguishing click vs drag)\n152\t  wasDragged(): boolean {\n153\t    return this.isDragging && (\n154\t      Math.abs(this.x - this.camStartX) > 3 ||\n155\t      Math.abs(this.y - this.camStartY) > 3\n156\t    );\n157\t  }\n158\t}\n159\t"}]},"parent_tool_use_id":null,"session_id":"b5917fbe-2c6f-4545-ae