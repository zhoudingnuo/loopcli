l: { type: 'boss', target: 1 },\n    stars: [500, 1000, 1500],\n    boss: { name: '冰霜守卫', hp: 30, row: 3, col: 4, abilities: ['freeze'], skillInterval: 3 },\n    obstacles: []\n  },\n\n  // 6-7: Introduce chains\n  {\n    id: 6, name: '锁链迷宫', moves: 25,\n    goal: { type: 'score', target: 2000 },\n    stars: [2000, 3000, 4000],\n    obstacles: [\n      {type:2, row:2, col:2}, {type:2, row:2, col:5},\n      {type:2, row:5, col:2}, {type:2, row:5, col:5},\n      {type:2, row:3, col:3}, {type:2, row:3, col:4},\n    ],\n    boss: null\n  },\n  {\n    id: 7, name: '冰锁交织', moves: 25,\n    goal: { type: 'score', target: 2000 },\n    stars: [2000, 3000, 4200],\n    obstacles: [\n      {type:1, row:0, col:0}, {type:1, row:0, col:7},\n      {type:1, row:7, col:0}, {type:1, row:7, col:7},\n      {type:2, row:3, col:2}, {type:2, row:3, col:5},\n      {type:2, row:4, col:2}, {type:2, row:4, col:5},\n    ],\n    boss: null\n  },\n\n  // 8: Collect color goal\n  {\n    id: 8, name: '收集达人', moves: 25,\n    goal: { type: 'collect_color', target: 30, colors: [0, 1] },\n    stars: [800, 1200, 1800],\n    obstacles: [\n      {type:1, row:2, col:1}, {type:1, row:2, col:6},\n      {type:2, row:5, col:3}, {type:2, row:5, col:4},\n    ],\n    boss: null\n  },\n\n  // 9: Clear obstacle goal\n  {\n    id: 9, name: '破冰行动', moves: 22,\n    goal: { type: 'clear_obstacle', target: 8, obstacleType: 1 },\n    stars: [600, 1000, 1500],\n    obstacles: [\n      {type:1, row:1, col:2}, {type:1, row:1, col:3}, {type:1, row:1, col:4}, {type:1, row:1, col:5},\n      {type:1, row:6, col:2}, {type:1, row:6, col:3}, {type:1, row:6, col:4}, {type:1, row:6, col:5},\n      {type:1, row:3, col:1}, {type:1, row:4, col:1}, {type:1, row:3, col:6}, {type:1, row:4, col:6},\n    ],\n    boss: null\n  },\n\n  // 10: Boss with chains\n  {\n    id: 10, name: '锁链领主', moves: 22,\n    goal: { type: 'boss', target: 1 },\n    stars: [500, 1000, 1500],\n    boss: { name: '锁链领主', hp: 50, row: 4, col: 3, abilities: ['freeze', 