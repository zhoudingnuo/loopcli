{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ef3c25b657d349a2a450f214","type":"tool_result","content":"1\t// GameState.ts — Immutable game state with save/load interface\n2\t\n3\timport { type CultivationState, createInitialCultivationState, migrateFromOldRealm } from './Cultivation';\n4\t\n5\texport interface Resources {\n6\t  [key: string]: number;\n7\t  spirit_stone: number;\n8\t  spirit_grass: number;\n9\t  spirit_energy: number;\n10\t  cultivation: number;\n11\t  pill_juling: number;\n12\t  pill_peiyuan: number;\n13\t  pill_ningqi: number;\n14\t  pill_zhuji: number;\n15\t  pill_jindanyin: number;\n16\t  spirit_iron: number;\n17\t  spirit_wood: number;\n18\t  talisman_paper: number;\n19\t}\n20\t\n21\texport interface BuildingInstance {\n22\t  uid: string;\n23\t  buildingId: string;\n24\t  gridX: number;\n25\t  gridY: number;\n26\t  level: number;\n27\t  lastCollectTime: number;\n28\t  isProducing: boolean;\n29\t  progress: number;\n30\t}\n31\t\n32\texport interface RealmProgress {\n33\t  realmId: string;\n34\t  level: number;\n35\t  exp: number;\n36\t  expToNext: number;\n37\t}\n38\t\n39\texport interface AlchemySessionData {\n40\t  recipeId: string;\n41\t  startTime: number;\n42\t  progress: number;\n43\t  complete: boolean;\n44\t}\n45\t\n46\texport interface GameMap {\n47\t  regionId: string;\n48\t  width: number;\n49\t  height: number;\n50\t  terrain: number[];\n51\t  buildings: BuildingInstance[];\n52\t}\n53\t\n54\texport interface GameState {\n55\t  resources: Resources;\n56\t  realm: RealmProgress;\n57\t  cultivation: CultivationState;\n58\t  alchemySession: AlchemySessionData | null;\n59\t  maps: GameMap[];\n60\t  currentRegionIndex: number;\n61\t  totalPlaytime: number;\n62\t  lastSaveTime: number;\n63\t  lastOnlineTime: number;\n64\t  version: string;\n65\t}\n66\t\n67\texport interface SaveData {\n68\t  version: string;\n69\t  timestamp: number;\n70\t  playtime: number;\n71\t  gameState: GameState;\n72\t}\n73\t\n74\tconst SAVE_KEY = 'cultivation_factory_save';\n75\tconst CURRENT_VERSION = '0.3.0';\n76\t\n77\tfunction initialResources(): Resources {\n78\t  return {\n79\t    spirit_stone: 0,\n80\t    spirit_grass: 0,\n81\t    spirit_energy: 0,\n82\t    cultivation: 0,\n83\t    pill_juling: 0,\n84\t    pill_peiyuan: 0,\n85\t    pill_ningqi: 0,\n86\t    pill_zhuji: 0,\n87\t    pill_jindanyin: 0,\n88\t    spirit_iron: 0,\n89\t    spirit_wood: 0,\n90\t    talisman_paper: 0,\n91\t  };\n92\t}\n93\t\n94\tfunction initialRealm(): RealmProgress {\n95\t  return {\n96\t    realmId: 'liqi',\n97\t    level: 1,\n98\t    exp: 0,\n99\t    expToNext: 100,\n100\t  };\n101\t}\n102\t\n103\texport function createInitialState(): GameState {\n104\t  return {\n105\t    resources: initialResources(),\n106\t    realm: initialRealm(),\n107\t    cultivation: createInitialCultivationState(),\n108\t    alchemySession: null,\n109\t    maps: [],\n110\t    currentRegionIndex: 0,\n111\t    totalPlaytime: 0,\n112\t    lastSaveTime: Date.now(),\n113\t    lastOnlineTime: Date.now(),\n114\t    version: CURRENT_VERSION,\n115\t  };\n116\t}\n117\t\n118\texport function cloneState(state: GameState): GameState {\n119\t  return JSON.parse(JSON.stringify(state));\n120\t}\n121\t\n122\t// Produce a new state with resource delta applied\n123\texport function addResources(state: GameState, delta: Partial<Resources>): GameState {\n124\t  const next = cloneState(state);\n125\t  for (const key of Object.keys(delta) as (keyof Resources)[]) {\n126\t    next.resources[key] = Math.max(0, next.resources[key] + (delta[key] ?? 0));\n127\t  }\n128\t  return next;\n129\t}\n130\t\n131\t// Add cultivation exp and check for level-up\n132\texport function addCultivation(state: GameState, amount: number): GameState {\n133\t  const next = cloneState(state);\n134\t  next.realm.exp += amount;\n135\t  while (next.realm.exp >= next.realm.expToNext) {\n136\t    next.realm.exp -= next.realm.expToNext;\n137\t    next.realm.level += 1;\n138\t    next.realm.expToNext = Math.floor(next.realm.expToNext * 1.8);\n139\t  }\n140\t  return next;\n141\t}\n142\t\n143\t// Add a building to a map\n144\texport function placeBuilding(state: GameState, mapIndex: number, building: BuildingInstance): GameState {\n145\t  const next = cloneState(state);\n146\t  next.maps[mapIndex].buildings.push(building);\n147\t  return next;\n148\t}\n149\t\n150\t// Remove a building from a map\n151\texport function removeBuilding(state: GameState, mapIndex: number, buildingUid: string): GameState {\n152\t  const next = cloneState(state);\n153\t  const map = next.maps[mapIndex];\n154\t  map.buildings = map.buildings.filter(b => b.uid !== buildingUid);\n155\t  return next;\n156\t}\n157\t\n158\t// Update a specific building\n159\texport function updateBuilding(\n160\t  state: GameState,\n161\t  mapIndex: number,\n162\t  buildingUid: string,\n163\t  patch: Partial<BuildingInstance>,\n164\t): GameState {\n165\t  const next = cloneState(state);\n166\t  const building = next.maps[mapIndex].buildings.find(b => b.uid === buildingUid);\n167\t  if (building) {\n168\t    Object.assign(building, patch);\n169\t  }\n170\t  return next;\n171\t}\n172\t\n173\t// Set a map on the state\n174\texport function setMap(state: GameState, index: number, map: GameMap): GameState {\n175\t  const next = cloneState(state);\n176\t  next.maps[index] = map;\n177\t  return next;\n178\t}\n179\t\n180\t// Save to localStorage\n181\texport function saveGame(state: GameState): void {\n182\t  const data: SaveData = {\n183\t    version: CURRENT_VERSION,\n184\t    timestamp: Date.now(),\n185\t    playtime: state.totalPlaytime,\n186\t    gameState: state,\n187\t  };\n188\t  try {\n189\t    localStorage.setItem(SAVE_KEY, JSON.stringify(data));\n190\t  } catch {\n191\t    console.warn('Save failed: storage quota exceeded');\n192\t  }\n193\t}\n194\t\n195\t// Load from localStorage\n196\texport function loadGame(): GameState | null {\n197\t  try {\n198\t    const raw = localStorage.getItem(SAVE_KEY);\n199\t    if (!raw) return null;\n200\t    const data: SaveData = JSON.parse(raw);\n201\t    const state = data.gameState ?? null;\n202\t\n203\t    // Migration: add new fields for v0.2.0\n204\t    if (state && !state.cultivation) {\n205\t      state.cultivation = state.realm\n206\t        ? migrateFromOldRealm(state.realm)\n207\t        : createInitialCultivationState();\n208\t    }\n209\t    if (state && !state.alchemySession) {\n210\t      state.alchemySession = null;\n211\t    }\n212\t    // Add new resource fields\n213\t    if (state) {\n214\t      const res = state.resources as Record<string, number>;\n215\t      if (res.pill_peiyuan === undefined) res.pill_peiyuan = 0;\n216\t      if (res.pill_ningqi === undefined) res.pill_ningqi = 0;\n217\t      if (res.pill_zhuji === undefined) res.pill_zhuji = 0;\n218\t      if (res.pill_jindanyin === undefined) res.pill_jindanyin = 0;\n219\t      if (res.spirit_wood === undefined) res.spirit_wood = 0;\n220\t      if (res.talisman_paper === undefined) res.talisman_paper = 0;\n221\t    }\n222\t\n223\t    return state;\n224\t  } catch {\n225\t    return null;\n226\t  }\n227\t}\n228\t\n229\texport function clearSave(): void {\n230\t  localStorage.removeItem(SAVE_KEY);\n231\t}\n232\t\n233\tlet autoSaveTimer = 0;\n234\t\n235\texport function startAutoSave(getState: () => GameState, intervalMs: number = 300000): void {\n236\t  stopAutoSave();\n237\t  autoSaveTimer = window.setInterval(() => {\n238\t    saveGame(getState());\n239\t  }, intervalMs);\n240\t}\n241\t\n242\texport function stopAutoSave(): void {\n243\t  if (autoSaveTimer) {\n244\t    clearInterval(autoSaveTimer);\n245\t    autoSaveTimer = 0;\n246\t  }\n247\t}\n248\t"}]},"parent_tool_use_id":null,"session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"6d0b9f40-a358-488e-9b39-df8e567c6279","timestamp":"2026-05-23T02:11:04.827Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\GameState.ts","content":"// GameState.ts — Immutable game state with save/load interface\n\nimport { type CultivationState, createInitialCultivationState, migrateFromOldRealm } from './Cultivation';\n\nexport interface Resources {\n  [key: string]: number;\n  spirit_stone: number;\n  spirit_grass: number;\n  spirit_energy: number;\n  cultivation: number;\n  pill_juling: number;\n  pill_peiyuan: number;\n  pill_ningqi: number;\n  pill_zhuji: number;\n  pill_jindanyin: number;\n  spirit_iron: number;\n  spirit_wood: number;\n  talisman_paper: number;\n}\n\nexport interface BuildingInstance {\n  uid: string;\n  buildingId: string;\n  gridX: number;\n  gridY: number;\n  level: number;\n  lastCollectTime: number;\n  isProducing: boolean;\n  progress: number;\n}\n\nexport interface RealmProgress {\n  realmId: string;\n  level: number;\n  exp: number;\n  expToNext: number;\n}\n\nexport interface AlchemySessionData {\n  recipeId: string;\n  startTime: number;\n  progress: number;\n  complete: boolean;\n}\n\nexport interface GameMap {\n  regionId: string;\n  width: number;\n  height: number;\n  terrain: number[];\n  buildings: BuildingInstance[];\n}\n\nexport interface GameState {\n  resources: Resources;\n  realm: RealmProgress;\n  cultivation: CultivationState;\n  alchemySession: AlchemySessionData | null;\n  maps: GameMap[];\n  currentRegionIndex: number;\n  totalPlaytime: number;\n  lastSaveTime: number;\n  lastOnlineTime: number;\n  version: string;\n}\n\nexport interface SaveData {\n  version: string;\n  timestamp: number;\n  playtime: number;\n  gameState: GameState;\n}\n\nconst SAVE_KEY = 'cultivation_factory_save';\nconst CURRENT_VERSION = '0.3.0';\n\nfunction initialResources(): Resources {\n  return {\n    spirit_stone: 0,\n    spirit_grass: 0,\n    spirit_energy: 0,\n    cultivation: 0,\n    pill_juling: 0,\n    pill_peiyuan: 0,\n    pill_ningqi: 0,\n    pill_zhuji: 0,\n    pill_jindanyin: 0,\n    spirit_iron: 0,\n    spirit_wood: 0,\n    talisman_paper: 0,\n  };\n}\n\nfunction initialRealm(): RealmProgress {\n  return {\n    realmId: 'liqi',\n    level: 1,\n    exp: 0,\n    expToNext: 100,\n  };\n}\n\nexport function createInitialState(): GameState {\n  return {\n    resources: initialResources(),\n    realm: initialRealm(),\n    cultivation: createInitialCultivationState(),\n    alchemySession: null,\n    maps: [],\n    currentRegionIndex: 0,\n    totalPlaytime: 0,\n    lastSaveTime: Date.now(),\n    lastOnlineTime: Date.now(),\n    version: CURRENT_VERSION,\n  };\n}\n\nexport function cloneState(state: GameState): GameState {\n  return JSON.parse(JSON.stringify(state));\n}\n\n// Produce a new state with resource delta applied\nexport function addResources(state: GameState, delta: Partial<Resources>): GameState {\n  const next = cloneState(state);\n  for (const key of Object.keys(delta) as (keyof Resources)[]) {\n    next.resources[key] = Math.max(0, next.resources[key] + (delta[key] ?? 0));\n  }\n  return next;\n}\n\n// Add cultivation exp and check for level-up\nexport function addCultivation(state: GameState, amount: number): GameState {\n  const next = cloneState(state);\n  next.realm.exp += amount;\n  while (next.realm.exp >= next.realm.expToNext) {\n    next.realm.exp -= next.realm.expToNext;\n    next.realm.level += 1;\n    next.realm.expToNext = Math.floor(next.realm.expToNext * 1.8);\n  }\n  return next;\n}\n\n// Add a building to a map\nexport function placeBuilding(state: GameState, mapIndex: number, building: BuildingInstance): GameState {\n  const next = cloneState(state);\n  next.maps[mapIndex].buildings.push(building);\n  return next;\n}\n\n// Remove a building from a map\nexport function removeBuilding(state: GameState, mapIndex: number, buildingUid: string): GameState {\n  const next = cloneState(state);\n  const map = next.maps[mapIndex];\n  map.buildings = map.buildings.filter(b => b.uid !== buildingUid);\n  return next;\n}\n\n// Update a specific building\nexport function updateBuilding(\n  state: GameState,\n  mapIndex: number,\n  buildingUid: string,\n  patch: Partial<BuildingInstance>,\n): GameState {\n  const next = cloneState(state);\n  const building = next.maps[mapIndex].buildings.find(b => b.uid === buildingUid);\n  if (building) {\n    Object.assign(building, patch);\n  }\n  return next;\n}\n\n// Set a map on the state\nexport function setMap(state: GameState, index: number, map: GameMap): GameState {\n  const next = cloneState(state);\n  next.maps[index] = map;\n  return next;\n}\n\n// Save to localStorage\nexport function saveGame(state: GameState): void {\n  const data: SaveData = {\n    version: CURRENT_VERSION,\n    timestamp: Date.now(),\n    playtime: state.totalPlaytime,\n    gameState: state,\n  };\n  try {\n    localStorage.setItem(SAVE_KEY, JSON.stringify(data));\n  } catch {\n    console.warn('Save failed: storage quota exceeded');\n  }\n}\n\n// Load from localStorage\nexport function loadGame(): GameState | null {\n  try {\n    const raw = localStorage.getItem(SAVE_KEY);\n    if (!raw) return null;\n    const data: SaveData = JSON.parse(raw);\n    const state = data.gameState ?? null;\n\n    // Migration: add new fields for v0.2.0\n    if (state && !state.cultivation) {\n      state.cultivation = state.realm\n        ? migrateFromOldRealm(state.realm)\n        : createInitialCultivationState();\n    }\n    if (state && !state.alchemySession) {\n      state.alchemySession = null;\n    }\n    // Add new resource fields\n    if (state) {\n      const res = state.resources as Record<string, number>;\n      if (res.pill_peiyuan === undefined) res.pill_peiyuan = 0;\n      if (res.pill_ningqi === undefined) res.pill_ningqi = 0;\n      if (res.pill_zhuji === undefined) res.pill_zhuji = 0;\n      if (res.pill_jindanyin === undefined) res.pill_jindanyin = 0;\n      if (res.spirit_wood === undefined) res.spirit_wood = 0;\n      if (res.talisman_paper === undefined) res.talisman_paper = 0;\n    }\n\n    return state;\n  } catch {\n    return null;\n  }\n}\n\nexport function clearSave(): void {\n  localStorage.removeItem(SAVE_KEY);\n}\n\nlet autoSaveTimer = 0;\n\nexport function startAutoSave(getState: () => GameState, intervalMs: number = 300000): void {\n  stopAutoSave();\n  autoSaveTimer = window.setInterval(() => {\n    saveGame(getState());\n  }, intervalMs);\n}\n\nexport function stopAutoSave(): void {\n  if (autoSaveTimer) {\n    clearInterval(autoSaveTimer);\n    autoSaveTimer = 0;\n  }\n}\n","numLines":248,"startLine":1,"totalLines":248}}}
