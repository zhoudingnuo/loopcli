{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a9abf3701e054fc6aa925eb6","type":"tool_result","content":"1\t// Game.js — Main game loop, state machine, ties all modules together\n2\t\n3\tconst STATES = {\n4\t  MENU: 'menu',\n5\t  IDLE: 'idle',\n6\t  SWAPPING: 'swapping',\n7\t  MATCHING: 'matching',\n8\t  REMOVING: 'removing',\n9\t  DROPPING: 'dropping',\n10\t  RESULT: 'result',\n11\t};\n12\t\n13\tclass Game {\n14\t  constructor(canvas) {\n15\t    this.canvas = canvas;\n16\t    this.board = new Board();\n17\t    this.matchEngine = new MatchEngine(this.board);\n18\t    this.renderer = new Renderer(canvas);\n19\t    this.input = new InputHandler(canvas, this.board);\n20\t    this.scoreSystem = new ScoreSystem();\n21\t    this.tweens = new TweenManager();\n22\t    this.particles = new ParticleSystem();\n23\t    this.levels = generateLevels();\n24\t    this.currentLevel = 0;\n25\t    this.state = STATES.MENU;\n26\t    this.comboText = '';\n27\t    this.comboTimer = 0;\n28\t    this.lastTime = 0;\n29\t    this.animationQueue = [];\n30\t\n31\t    this.renderer.particleSystem = this.particles;\n32\t\n33\t    this._setupInput();\n34\t    this._setupScoreCallbacks();\n35\t  }\n36\t\n37\t  _setupInput() {\n38\t    this.input.onSwap = (r1, c1, r2, c2) => this._handleSwap(r1, c1, r2, c2);\n39\t    this.input.onTap = (row, col) => this._handleTap(row, col);\n40\t  }\n41\t\n42\t  _setupScoreCallbacks() {\n43\t    this.scoreSystem.onLevelComplete = (score, stars) => {\n44\t      this.state = STATES.RESULT;\n45\t      this.resultData = { won: true, score, stars, level: this.currentLevel + 1 };\n46\t    };\n47\t    this.scoreSystem.onLevelFail = (score) => {\n48\t      this.state = STATES.RESULT;\n49\t      this.resultData = { won: false, score, stars: 0, level: this.currentLevel + 1 };\n50\t    };\n51\t  }\n52\t\n53\t  start() {\n54\t    this._loadLevel(0);\n55\t    this.state = STATES.IDLE;\n56\t    this.lastTime = performance.now();\n57\t    this._loop();\n58\t  }\n59\t\n60\t  _loadLevel(idx) {\n61\t    this.currentLevel = idx;\n62\t    const config = this.levels[idx] || this.levels[0];\n63\t    this.board.init();\n64\t    this.scoreSystem.reset(idx + 1);\n65\t    this.scoreSystem.configure(config);\n66\t    this.input.updateLayout(\n67\t      this.renderer.tileSize,\n68\t      this.renderer.boardX,\n69\t      this.renderer.boardY,\n70\t    );\n71\t    this.tweens.clear();\n72\t    this.particles.particles = [];\n73\t    this.renderer.floatingTexts = [];\n74\t    this.comboText = '';\n75\t    this.resultData = null;\n76\t  }\n77\t\n78\t  _handleTap(row, col) {\n79\t    if (this.state !== STATES.IDLE) return;\n80\t    const tile = this.board.getTile(row, col);\n81\t    if (!tile) return;\n82\t\n83\t    // Rainbow special: tap to activate\n84\t    if (tile.special !== SPECIAL_NONE) {\n85\t      // For now, rainbow on tap picks a random color\n86\t      // In full game, this would be from the swapped tile's color\n87\t      return;\n88\t    }\n89\t  }\n90\t\n91\t  _handleSwap(r1, c1, r2, c2) {\n92\t    if (this.state !== STATES.IDLE) return;\n93\t\n94\t    // Check if any special tile combination\n95\t    const tileA = this.board.getTile(r1, c1);\n96\t    const tileB = this.board.getTile(r2, c2);\n97\t\n98\t    if (tileA && tileA.special === SPECIAL_RAINBOW) {\n99\t      this._activateRainbow(r1, c1, tileB ? tileB.color : 0, r2, c2);\n100\t      return;\n101\t    }\n102\t    if (tileB && tileB.special === SPECIAL_RAINBOW) {\n103\t      this._activateRainbow(r2, c2, tileA ? tileA.color : 0, r1, c1);\n104\t      return;\n105\t    }\n106\t\n107\t    if (!this.matchEngine.isValidSwap(r1, c1, r2, c2)) return;\n108\t    if (!this.scoreSystem.useMove()) return;\n109\t\n110\t    this.state = STATES.SWAPPING;\n111\t    this.board.swap(r1, c1, r2, c2);\n112\t\n113\t    // Animate swap\n114\t    this._animateSwap(r1, c1, r2, c2, () => {\n115\t      this._processMatches();\n116\t    });\n117\t  }\n118\t\n119\t  _animateSwap(r1, c1, r2, c2, callback) {\n120\t    const tileSize = this.renderer.tileSize;\n121\t    const tileA = this.board.getTile(r2, c2); // After swap, tileA is at (r2,c2)\n122\t    const tileB = this.board.getTile(r1, c1);\n123\t\n124\t    const dx = (c2 - c1) * tileSize;\n125\t    const dy = (r2 - r1) * tileSize;\n126\t\n127\t    if (tileA) {\n128\t      tileA.offsetX = -dx;\n129\t      tileA.offsetY = -dy;\n130\t      this.tweens.add(tileA, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n131\t    }\n132\t    if (tileB) {\n133\t      tileB.offsetX = dx;\n134\t      tileB.offsetY = dy;\n135\t      this.tweens.add(tileB, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n136\t    }\n137\t\n138\t    setTimeout(callback, 160);\n139\t  }\n140\t\n141\t  _activateRainbow(rainbowRow, rainbowCol, targetColor, otherRow, otherCol) {\n142\t    if (!this.scoreSystem.useMove()) return;\n143\t    this.state = STATES.MATCHING;\n144\t\n145\t    // Remove the rainbow tile and the other tile\n146\t    const toRemove = this.matchEngine.triggerRainbow(rainbowRow, rainbowCol, targetColor);\n147\t    toRemove.push({ row: rainbowRow, col: rainbowCol });\n148\t    if (this.board.getTile(otherRow, otherCol)) {\n149\t      toRemove.push({ row: otherRow, col: otherCol });\n150\t    }\n151\t\n152\t    this._removeAndCascade(toRemove, 10);\n153\t  }\n154\t\n155\t  _processMatches() {\n156\t    this.state = STATES.MATCHING;\n157\t    const matches = this.board.findAllMatches();\n158\t\n159\t    if (matches.length === 0) {\n160\t      this.state = STATES.IDLE;\n161\t      this.scoreSystem.checkState();\n162\t      return;\n163\t    }\n164\t\n165\t    let chainCount = 0;\n166\t    this._processChain(chainCount);\n167\t  }\n168\t\n169\t  _processChain(chainCount) {\n170\t    chainCount++;\n171\t    const matches = this.board.findAllMatches();\n172\t    if (matches.length === 0) {\n173\t      // Check for special tiles to trigger\n174\t      this.state = STATES.IDLE;\n175\t\n176\t      // Check deadlock\n177\t      if (!this.board.hasValidMoves()) {\n178\t        this.board.shuffle();\n179\t      }\n180\t\n181\t      const result = this.scoreSystem.checkState();\n182\t      if (result === 'playing') {\n183\t        // All done for this move\n184\t      }\n185\t      return;\n186\t    }\n187\t\n188\t    const lShapes = this.board.findLShapeMatches(matches);\n189\t    const { removeCells, specials } = this.matchEngine._classifyMatches(matches, lShapes);\n190\t\n191\t    // Score\n192\t    const multiplier = chainCount <= 1 ? 1 : chainCount === 2 ? 1.5 : chainCount === 3 ? 2.0 : 2.5;\n193\t    const baseScore = removeCells.size * 10;\n194\t    const points = Math.floor(baseScore * multiplier);\n195\t    this.scoreSystem.addScore(points);\n196\t\n197\t    // Combo text\n198\t    if (chainCount >= 4) { this.comboText = '超赞！！'; }\n199\t    else if (chainCount === 3) { this.comboText = '太棒了！'; }\n200\t    else if (chainCount === 2) { this.comboText = '不错！'; }\n201\t    this.comboTimer = 0.8;\n202\t\n203\t    // Track collected colors\n204\t    for (const key of removeCells) {\n205\t      const [r, c] = key.split(',').map(Number);\n206\t      const tile = this.board.getTile(r, c);\n207\t      if (tile && tile.color >= 0) {\n208\t        this.scoreSystem.addCollected(tile.color, 1);\n209\t      }\n210\t    }\n211\t\n212\t    // Create specials\n213\t    const specialPositions = new Set(specials.map(s => `${s.row},${s.col}`));\n214\t    for (const sp of specials) {\n215\t      const tile = this.board.getTile(sp.row, sp.col);\n216\t      if (tile) {\n217\t        tile.special = sp.type;\n218\t        tile.removing = false;\n219\t      }\n220\t    }\n221\t\n222\t    // Animate removal\n223\t    this.state = STATES.REMOVING;\n224\t    const toAnimate = [];\n225\t    for (const key of removeCells) {\n226\t      if (specialPositions.has(key)) continue;\n227\t      const [r, c] = key.split(',').map(Number);\n228\t      const tile = this.board.getTile(r, c);\n229\t      if (tile) {\n230\t        // Particle effect\n231\t        const pos = this.renderer.getTileCenter(r, c);\n232\t        const color = COLOR_MAP[tile.color];\n233\t        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 8);\n234\t\n235\t        // Score float\n236\t        this.renderer.addFloatingText(`+${points}`, pos.x, pos.y);\n237\t\n238\t        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n239\t        toAnimate.push(tile);\n240\t      }\n241\t    }\n242\t\n243\t    setTimeout(() => {\n244\t      // Actually remove tiles\n245\t      for (const key of removeCells) {\n246\t        if (specialPositions.has(key)) continue;\n247\t        const [r, c] = key.split(',').map(Number);\n248\t        this.board.clearCell(r, c);\n249\t      }\n250\t\n251\t      // Trigger specials in removed cells\n252\t      for (const sp of specials) {\n253\t        this._triggerSpecialEffects(sp.row, sp.col, sp.type);\n254\t      }\n255\t\n256\t      // Apply gravity\n257\t      this.state = STATES.DROPPING;\n258\t      const drops = this.board.applyGravity();\n259\t\n260\t      // Animate drops\n261\t      for (const drop of drops) {\n262\t        const tile = drop.tile;\n263\t        const fromY = drop.fromRow * this.renderer.tileSize;\n264\t        const toY = drop.toRow * this.renderer.tileSize;\n265\t        tile.offsetY = fromY - toY;\n266\t        this.tweens.add(tile, { offsetY: 0 }, 0.2 + drop.distance * 0.03, 'easeOutBounce');\n267\t      }\n268\t\n269\t      setTimeout(() => {\n270\t        this._processChain(chainCount);\n271\t      }, 350);\n272\t    }, 280);\n273\t  }\n274\t\n275\t  _triggerSpecialEffects(row, col, type) {\n276\t    const pos = this.renderer.getTileCenter(row, col);\n277\t    const tile = this.board.getTile(row, col);\n278\t    const color = tile ? COLOR_MAP[tile.color]?.hex : '#FFB800';\n279\t\n280\t    switch (type) {\n281\t      case 1: // STRIPED_H\n282\t      case 2: // STRIPED_V\n283\t        this.particles.emitExplosion(pos.x, pos.y, color || '#FFB800', 20);\n284\t        break;\n285\t      case 3: // BOMB\n286\t        this.particles.emitExplosion(pos.x, pos.y, '#FF9A3C', 30);\n287\t        break;\n288\t      case 4: // RAINBOW\n289\t        for (let i = 0; i < 40; i++) {\n290\t          this.particles.emitExplosion(pos.x, pos.y, '#FFB800', 2);\n291\t        }\n292\t        break;\n293\t    }\n294\t  }\n295\t\n296\t  _removeAndCascade(cells, scorePerCell) {\n297\t    this.state = STATES.REMOVING;\n298\t    const points = cells.length * scorePerCell;\n299\t    this.scoreSystem.addScore(points);\n300\t\n301\t    for (const { row, col } of cells) {\n302\t      const tile = this.board.getTile(row, col);\n303\t      if (tile) {\n304\t        const pos = this.renderer.getTileCenter(row, col);\n305\t        const color = COLOR_MAP[tile.color];\n306\t        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 6);\n307\t        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n308\t      }\n309\t    }\n310\t\n311\t    setTimeout(() => {\n312\t      for (const { row, col } of cells) {\n313\t        this.board.clearCell(row, col);\n314\t      }\n315\t      this.board.applyGravity();\n316\t\n317\t      this.state = STATES.IDLE;\n318\t      // Check for more cascades\n319\t      setTimeout(() => this._processMatches(), 200);\n320\t    }, 300);\n321\t  }\n322\t\n323\t  _loop() {\n324\t    const now = performance.now();\n325\t    const dt = Math.min((now - this.lastTime) / 1000, 0.05);\n326\t    this.lastTime = now;\n327\t\n328\t    this.update(dt);\n329\t    this.render();\n330\t    requestAnimationFrame(() => this._loop());\n331\t  }\n332\t\n333\t  update(dt) {\n334\t    this.tweens.update(dt);\n335\t    this.particles.update(dt);\n336\t\n337\t    if (this.comboTimer > 0) {\n338\t      this.comboTimer -= dt;\n339\t      if (this.comboTimer <= 0) this.comboText = '';\n340\t    }\n341\t\n342\t    this.input.enabled = this.state === STATES.IDLE;\n343\t  }\n344\t\n345\t  render() {\n346\t    this.renderer.clear();\n347\t    this.renderer.drawBackground();\n348\t\n349\t    // Draw tiles\n350\t    for (let r = 0; r < this.board.size; r++) {\n351\t      for (let c = 0; c < this.board.size; c++) {\n352\t        const tile = this.board.getTile(r, c);\n353\t        if (tile) this.renderer.drawTile(tile);\n354\t      }\n355\t    }\n356\t\n357\t    // Particles\n358\t    this.particles.draw(this.renderer.ctx);\n359\t\n360\t    // Floating texts\n361\t    this.renderer.updateAndDrawFloatingTexts(1 / 60);\n362\t\n363\t    // UI\n364\t    this.renderer.drawUI(\n365\t      this.scoreSystem.score,\n366\t      this.scoreSystem.getRemainingMoves(),\n367\t      this.scoreSystem.goalTarget,\n368\t      this.scoreSystem.goalProgress,\n369\t      this.currentLevel + 1,\n370\t    );\n371\t\n372\t    // Combo text\n373\t    if (this.comboText) {\n374\t      this.renderer.drawComboText(this.comboText);\n375\t    }\n376\t\n377\t    // Result screen\n378\t    if (this.resultData) {\n379\t      this.renderer.drawResultScreen(\n380\t        this.resultData.won,\n381\t        this.resultData.score,\n382\t        this.resultData.stars,\n383\t        this.resultData.level,\n384\t      );\n385\t    }\n386\t  }\n387\t\n388\t  // Public methods for UI interaction\n389\t  retry() {\n390\t    this._loadLevel(this.currentLevel);\n391\t    this.state = STATES.IDLE;\n392\t  }\n393\t\n394\t  nextLevel() {\n395\t    const next = this.currentLevel + 1;\n396\t    if (next < this.levels.length) {\n397\t      this._loadLevel(next);\n398\t      this.state = STATES.IDLE;\n399\t    } else {\n400\t      this._loadLevel(0);\n401\t      this.state = STATES.IDLE;\n402\t    }\n403\t  }\n404\t}\n405\t\n406\tif (typeof module !== 'undefined') module.exports = { Game, STATES };\n407\t"}]},"parent_tool_use_id":"call_4992cf6ab3f54b25a69b4987","session_id":"4fc1920c-0b5c-4266-b43d-05c38f749fa3","uuid":"2c1ace39-14b0-4107-a343-03dc89452485","timestamp":"2026-05-22T21:22:56.307Z","subagent_