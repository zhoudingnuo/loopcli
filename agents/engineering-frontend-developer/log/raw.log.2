velsPerStage: 5,\n    expBase: 10000,\n    expGrowth: 1.6,\n    cultivationBaseRate: 30.0,\n    breakthroughCost: { spirit_stone: 5000, spirit_iron: 10 },\n    breakthroughPill: 'pill_jindanyin',\n    breakthroughPillCount: 10,\n    breakthroughSuccessRate: 0.70,\n    failPenaltyPercent: 0.3,\n    unlockContent: ['傀儡工人', '分拣器', '金丹引', '精炼炉', '传送阵'],\n  },\n  yuanying: {\n    id: 'yuanying',\n    name: '元婴期',\n    nameEn: 'Nascent Soul',\n    subStages: ['初期', '中期', '后期', '圆满'],\n    levelsPerStage: 5,\n    expBase: 100000,\n    expGrowth: 1.5,\n    cultivationBaseRate: 150.0,\n    breakthroughCost: { spirit_stone: 50000, heaven_earth_liquid: 5 },\n    breakthroughPill: 'pill_yuanyingguo',\n    breakthroughPillCount: 10,\n    breakthroughSuccessRate: 0.65,\n    failPenaltyPercent: 0.35,\n    unlockContent: ['灵阵加速', '跨区域传送', '高级丹方', '智能傀儡核心', '元婴果'],\n  },\n  huashen: {\n    id: 'huashen',\n    name: '化神期',\n    nameEn: 'Spirit Severing',\n    subStages: ['初期', '中期', '后期', '圆满'],\n    levelsPerStage: 4,\n    expBase: 1000000,\n    expGrowth: 1.5,\n    cultivationBaseRate: 800.0,\n    breakthroughCost: { spirit_stone: 500000, heaven_earth_liquid: 20 },\n    breakthroughPill: 'pill_yuanyingguo',\n    breakthroughPillCount: 20,\n    breakthroughSuccessRate: 0.60,\n    failPenaltyPercent: 0.4,\n    unlockContent: ['空间折叠', '跨维度工厂', '神级丹方', '飞升挑战', '化神露'],\n  },","originalFile":"// Cultivation.ts — Realm breakthrough and cultivation progression system (v0.4.0)\n\nexport interface RealmDef {\n  id: string;\n  name: string;\n  nameEn: string;\n  subStages: string[];\n  levelsPerStage: number;\n  expBase: number;\n  expGrowth: number;\n  cultivationBaseRate: number;\n  breakthroughCost: Record<string, number>;\n  breakthroughPill?: string;\n  breakthroughPillCount?: number;\n  breakthroughSuccessRate: number;\n  failPenaltyPercent: number;\n  unlockContent: string[];\n}\n\nexport interface CultivationState {\n  realmId: string;\n  subStage: number;\n  level: number;\n  exp: number;\n  expToNext: number;\n  totalCultivation: number;\n  cultivationRate: number;\n  isAutoCultivating: boolean;\n}\n\nexport interface BreakthroughResult {\n  success: boolean;\n  oldRealm: string;\n  newRealm: string;\n  oldSubStage: number;\n  newSubStage: number;\n  penalty: number;\n}\n\nconst REALM_ORDER = ['fanren', 'liqi', 'zhuji', 'jindan', 'yuanying', 'huashen'];\n\nconst REALM_DEFS: Record<string, RealmDef> = {\n  fanren: {\n    id: 'fanren',\n    name: '凡人',\n    nameEn: 'Mortal',\n    subStages: ['凡人'],\n    levelsPerStage: 1,\n    expBase: 50,\n    expGrowth: 1.0,\n    cultivationBaseRate: 0,\n    breakthroughCost: { spirit_stone: 10 },\n    breakthroughSuccessRate: 1.0,\n    failPenaltyPercent: 0,\n    unlockContent: [],\n  },\n  liqi: {\n    id: 'liqi',\n    name: '炼气期',\n    nameEn: 'Qi Refining',\n    subStages: ['初期', '中期', '后期'],\n    levelsPerStage: 4,\n    expBase: 100,\n    expGrowth: 1.8,\n    cultivationBaseRate: 0.5,\n    breakthroughCost: { spirit_stone: 200 },\n    breakthroughPill: 'pill_juling',\n    breakthroughPillCount: 5,\n    breakthroughSuccessRate: 0.85,\n    failPenaltyPercent: 0.2,\n    unlockContent: ['灵石矿机', '灵田', '丹炉', '聚灵丹'],\n  },\n  zhuji: {\n    id: 'zhuji',\n    name: '筑基期',\n    nameEn: 'Foundation Building',\n    subStages: ['初期', '中期', '后期'],\n    levelsPerStage: 5,\n    expBase: 1000,\n    expGrowth: 1.8,\n    cultivationBaseRate: 2.0,\n    breakthroughCost: { spirit_stone: 500 },\n    breakthroughPill: 'pill_zhuji',\n    breakthroughPillCount: 5,\n    breakthroughSuccessRate: 0.75,\n    failPenaltyPercent: 0.25,\n    unlockContent: ['灵脉通道', '传送带', '筑基丹'],\n  },\n  jindan: {\n    id: 'jindan',\n    name: '金丹期',\n    nameEn: 'Golden Core',\n    subStages: ['初期', '中期', '后期', '圆满'],\n    levelsPerStage: 5,\n    expBase: 10000,\n    expGrowth: 1.8,\n    cultivationBaseRate: 10.0,\n    breakthroughCost: { spirit_stone: 5000, spirit_iron: 10 },\n    breakthroughPill: 'pill_jindanyin',\n    breakthroughPillCount: 10,\n    breakthroughSuccessRate: 0.70,\n    failPenaltyPercent: 0.3,\n    unlockContent: ['傀儡工人', '分拣器', '金丹引', '精炼炉', '传送阵'],\n  },\n  yuanying: {\n    id: 'yuanying',\n    name: '元婴期',\n    nameEn: 'Nascent Soul',\n    subStages: ['初期', '中期', '后期', '圆满'],\n    levelsPerStage: 5,\n    expBase: 100000,\n    expGrowth: 1.8,\n    cultivationBaseRate: 50.0,\n    breakthroughCost: { spirit_stone: 50000, heaven_earth_liquid: 5 },\n    breakthroughPill: 'pill_yuanyingguo',\n    breakthroughPillCount: 10,\n    breakthroughSuccessRate: 0.65,\n    failPenaltyPercent: 0.35,\n    unlockContent: ['灵阵加速', '跨区域传送', '高级丹方', '智能傀儡核心', '元婴果'],\n  },\n  huashen: {\n    id: 'huashen',\n    name: '化神期',\n    nameEn: 'Spirit Severing',\n    subStages: ['初期', '中期', '后期', '圆满'],\n    levelsPerStage: 4,\n    expBase: 1000000,\n    expGrowth: 1.8,\n    cultivationBaseRate: 200.0,\n    breakthroughCost: { spirit_stone: 500000, heaven_earth_liquid: 20 },\n    breakthroughPill: 'pill_yuanyingguo',\n    breakthroughPillCount: 20,\n    breakthroughSuccessRate: 0.60,\n    failPenaltyPercent: 0.4,\n    unlockContent: ['空间折叠', '跨维度工厂', '神级丹方', '飞升挑战', '化神露'],\n  },\n};\n\nexport function getRealmDef(realmId: string): RealmDef | undefined {\n  return REALM_DEFS[realmId];\n}\n\nexport function getRealmOrder(): string[] {\n  return REALM_ORDER;\n}\n\nexport function createInitialCultivationState(): CultivationState {\n  return {\n    realmId: 'fanren',\n    subStage: 0,\n    level: 1,\n    exp: 0,\n    expToNext: 50,\n    totalCultivation: 0,\n    cultivationRate: 0,\n    isAutoCultivating: false,\n  };\n}\n\nexport function getSubStageName(realmId: string, subStage: number): string {\n  const def = REALM_DEFS[realmId];\n  if (!def) return '';\n  return def.subStages[subStage] ?? '';\n}\n\nexport function getFullRealmName(state: CultivationState): string {\n  const def = REALM_DEFS[state.realmId];\n  if (!def) return state.realmId;\n  if (def.subStages.length === 1) return def.name;\n  return `${def.name} ${def.subStages[state.subStage] ?? ''} Lv${state.level}`;\n}\n\nexport function getShortRealmName(state: CultivationState): string {\n  const def = REALM_DEFS[state.realmId];\n  if (!def) return state.realmId;\n  return def.name;\n}\n\nexport function calcExpToNext(realmId: string, level: number): number {\n  const def = REALM_DEFS[realmId];\n  if (!def) return 100;\n  return Math.floor(def.expBase * Math.pow(def.expGrowth, level - 1));\n}\n\nexport function addCultivationExp(state: CultivationState, amount: number): CultivationState {\n  const next = { ...state };\n  next.exp += amount;\n  next.totalCultivation += amount;\n\n  const def = REALM_DEFS[next.realmId];\n  if (!def) return next;\n\n  while (next.exp >= next.expToNext) {\n    next.exp -= next.expToNext;\n    next.level += 1;\n\n    if (next.level > def.levelsPerStage) {\n      next.level = def.levelsPerStage;\n      next.exp = next.expToNext;\n      break;\n    }\n\n    next.expToNext = calcExpToNext(next.realmId, next.level);\n  }\n\n  next.cultivationRate = def.cultivationBaseRate * (1 + (next.level - 1) * 0.15);\n\n  return next;\n}\n\nexport function canBreakthrough(state: CultivationState): boolean {\n  const def = REALM_DEFS[state.realmId];\n  if (!def) return false;\n  if (state.level < def.levelsPerStage) return false;\n  if (state.exp < state.expToNext) return false;\n  return true;\n}\n\nexport function isRealmTransition(state: CultivationState): boolean {\n  const def = REALM_DEFS[state.realmId];\n  if (!def) return false;\n  return state.subStage >= def.subStages.length - 1;\n}\n\nexport function getBreakthroughRequirements(state: CultivationState): {\n  canAttempt: boolean;\n  needsPill: boolean;\n  pillId: string | null;\n  pillCount: number;\n  resourceCost: Record<string, number>;\n  successRate: number;\n} {\n  const def = REALM_DEFS[state.realmId];\n  if (!def) return { canAttempt: false, needsPill: false, pillId: null, pillCount: 0, resourceCost: {}, successRate: 0 };\n\n  const atMax = state.level >= def.levelsPerStage && state.exp >= state.expToNext;\n\n  return {\n    canAttempt: atMax,\n    needsPill: !!def.breakthroughPill,\n    pillId: def.breakthroughPill ?? null,\n    pillCount: def.breakthroughPillCount ?? 0,\n    resourceCost: def.breakthroughCost,\n    successRate: def.breakthroughSuccessRate,\n  };\n}\n\nexport function attemptBreakthrough(\n  state: CultivationState,\n  resources: Record<string, number>,\n): { result: BreakthroughResult; newState: CultivationState; newResources: Record<string, number> } | null {\n  const def = REALM_DEFS[state.realmId];\n  if (!def) return null;\n\n  if (!canBreakthrough(state)) return null;\n\n  const costs = def.breakthroughCost;\n  for (const [res, amount] of Object.entries(costs)) {\n    if ((resources[res] ?? 0) < amount) return null;\n  }\n\n  if (def.breakthroughPill && def.breakthroughPillCount) {\n    if ((resources[def.breakthroughPill] ?? 0) < def.breakthroughPillCount) return null;\n  }\n\n  const newResources = { ...resources };\n  for (const [res, amount] of Object.entries(costs)) {\n    newResources[res] = (newResources[res] ?? 0) - amount;\n  }\n  if (def.breakthroughPill && def.breakthroughPillCount) {\n    newResources[def.breakthroughPill] = (newResources[def.breakthroughPill] ?? 0) - def.breakthroughPillCount;\n  }\n\n  const roll = Math.random();\n  const success = roll < def.breakthroughSuccessRate;\n\n  const newState = { ...state };\n\n  if (success) {\n    const isTransition = isRealmTransition(state);\n\n    if (isTransition) {\n      const currentIdx = REALM_ORDER.indexOf(state.realmId);\n      const nextRealmId = REALM_ORDER[currentIdx + 1] ?? state.realmId;\n      const nextDef = REALM_DEFS[nextRealmId];\n\n      newState.realmId = nextRealmId;\n      newState.subStage = 0;\n      newState.level = 1;\n      newState.exp = 0;\n      newState.expToNext = nextDef ? nextDef.expBase : 100;\n      newState.cultivationRate = nextDef?.cultivationBaseRate ?? 0;\n    } else {\n      newState.subStage = state.subStage + 1;\n      newState.level = 1;\n      newState.exp = 0;\n      newState.expToNext = calcExpToNext(state.realmId, 1);\n    }\n\n    return {\n      result: {\n        success: true,\n        oldRealm: state.realmId,\n        newRealm: newState.realmId,\n        oldSubStage: state.subStage,\n        newSubStage: newState.subStage,\n        penalty: 0,\n      },\n      newState,\n      newResources,\n    };\n  } else {\n    const penalty = def.failPenaltyPercent;\n    const expLoss = Math.floor(newState.totalCultivation * penalty);\n    newState.exp = Math.max(0, newState.exp - expLoss);\n    newState.totalCultivation = Math.max(0, newState.totalCultivation - expLoss);\n\n    return {\n      result: {\n        success: false,\n        oldRealm: state.realmId,\n        newRealm: state.realmId,\n        oldSubStage: state.subStage,\n        newSubStage: state.subStage,\n        penalty: penalty,\n      },\n      newState,\n      newResources,\n    };\n  }\n}\n\nexport function tickAutoCultivation(state: CultivationState, dtMs: number): CultivationState {\n  if (state.cultivationRate <= 0) return state;\n\n  const amount = state.cultivationRate * (dtMs / 1000);\n  return addCultivationExp(state, amount);\n}\n\nexport function migrateFromOldRealm(oldRealm: {\n  realmId: string;\n  level: number;\n  exp: number;\n  expToNext: number;\n}): CultivationState {\n  let subStage = 0;\n  let level = oldRealm.level;\n  const levelsPerStage = 4;\n\n  if (level > levelsPerStage) {\n    subStage = Math.floor((level - 1) / levelsPerStage);\n    level = ((level - 1) % levelsPerStage) + 1;\n  }\n\n  return {\n    realmId: oldRealm.realmId,\n    subStage: Math.min(subStage, 2),\n    level,\n    exp: oldRealm.exp,\n    expToNext: oldRealm.expToNext,\n    totalCultivation: oldRealm.exp,\n    cultivationRate: oldRealm.realmId === 'liqi' ? 0.5 : 0,\n    isAutoCultivating: false,\n  };\n}\n\nexport function getRealmIndex(realmId: string): number {\n  return REALM_ORDER.indexOf(realmId);\n}\n\nexport function isRealmUnlocked(required: string, cultivation: CultivationState): boolean {\n  const [rRealm, rLevel] = required.split('_');\n  const rRealmIdx = REALM_ORDER.indexOf(rRealm);\n  const cRealmIdx = REALM_ORDER.indexOf(cultivation.realmId);\n\n  if (cRealmIdx > rRealmIdx) return true;\n  if (cRealmIdx < rRealmIdx) return false;\n\n  const def = REALM_DEFS[cultivation.realmId];\n  const totalLevel = cultivation.subStage * (def?.levelsPerStage ?? 4) + cultivation.level;\n  return totalLevel >= parseInt(rLevel);\n}\n\n// Get total game level from cultivation state\nexport function getTotalGameLevel(state: CultivationState): number {\n  let total = 0;\n  const realmIdx = REALM_ORDER.indexOf(state.realmId);\n\n  for (let i = 0; i < realmIdx; i++) {\n    const def = REALM_DEFS[REALM_ORDER[i]];\n    total += def ? def.subStages.length * def.levelsPerStage : 0;\n  }\n\n  const def = REALM_DEFS[state.realmId];\n  total += state.subStage * (def?.levelsPerStage ?? 4) + state.level;\n  return total;\n}\n","structuredPatch":[{"oldStart":61,"oldLines":8,"newStart":61,"newLines":8,"lines":["     subStages: ['初期', '中期', '后期'],","     levelsPerStage: 4,","     expBase: 100,","-    expGrowth: 1.8,","-    cultivationBaseRate: 0.5,","+    expGrowth: 1.6,","+    cultivationBaseRate: 1.0,","     breakthroughCost: { spirit_stone: 200 },","     breakthroughPill: 'pill_juling',","     breakthroughPillCount: 5,"]},{"oldStart":77,"oldLines":8,"newStart":77,"newLines":8,"lines":["     subStages: ['初期', '中期', '后期'],","     levelsPerStage: 5,","     expBase: 1000,","-    expGrowth: 1.8,","-    cultivationBaseRate: 2.0,","+    expGrowth: 1.6,","+    cultivationBaseRate: 5.0,","     breakthroughCost: { spirit_stone: 500 },","     breakthroughPill: 'pill_zhuji',","     breakthroughPillCount: 5,"]},{"oldStart":93,"oldLines":8,"newStart":93,"newLines":8,"lines":["     subStages: ['初期', '中期', '后期', '圆满'],","     levelsPerStage: 5,","     expBase: 10000