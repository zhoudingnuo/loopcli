dupDuration: 2000, resolveDuration: 3000,\n202\t    sanityCost: 18, cooldownSec: 240,\n203\t    description: '某个货架上出现暗红色液体缓缓渗出',\n204\t  },\n205\t  {\n206\t    type: HorrorEventType.NONPAYING_CUSTOMER,\n207\t    level: HorrorLevel.THREAT,\n208\t    baseProbability: 0.10,\n209\t    minDay: 16, maxDay: 30,\n210\t    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n211\t    minActiveDuration: 10000, maxActiveDuration: 20000,\n212\t    buildupDuration: 3000, resolveDuration: 1000,\n213\t    sanityCost: 14, cooldownSec: 200,\n214\t    description: '一个顾客拿了东西不走，也不付钱，只是盯着你看',\n215\t  },\n216\t  {\n217\t    type: HorrorEventType.WHISPER,\n218\t    level: HorrorLevel.THREAT,\n219\t    baseProbability: 0.12,\n220\t    minDay: 16, maxDay: 30,\n221\t    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n222\t    minActiveDuration: 4000, maxActiveDuration: 8000,\n223\t    buildupDuration: 2000, resolveDuration: 500,\n224\t    sanityCost: 12, cooldownSec: 120,\n225\t    description: '耳边传来低语声，听不清在说什么',\n226\t  },\n227\t  // Level 4: Existential\n228\t  {\n229\t    type: HorrorEventType.STORE_MUTATE,\n230\t    level: HorrorLevel.EXISTENTIAL,\n231\t    baseProbability: 0.06,\n232\t    minDay: 26, maxDay: 30,\n233\t    phaseRequired: [GamePhase.DANGER],\n234\t    minActiveDuration: 10000, maxActiveDuration: 20000,\n235\t    buildupDuration: 3000, resolveDuration: 5000,\n236\t    sanityCost: 25, cooldownSec: 300,\n237\t    description: '店铺结构开始改变，墙壁在移动',\n238\t  },\n239\t  {\n240\t    type: HorrorEventType.TIME_GLITCH,\n241\t    level: HorrorLevel.EXISTENTIAL,\n242\t    baseProbability: 0.05,\n243\t    minDay: 26, maxDay: 30,\n244\t    phaseRequired: [GamePhase.DANGER],\n245\t    minActiveDuration: 5000, maxActiveDuration: 8000,\n246\t    buildupDuration: 1000, resolveDuration: 2000,\n247\t    sanityCost: 20, cooldownSec: 300,\n248\t    description: '时钟突然倒转，时间出现异常',\n249\t  },\n250\t  // Level 3: Threat (new M5 events)\n251\t  {\n252\t    type: HorrorEventType.STALKER,\n253\t    level: HorrorLevel.THREAT,\n254\t    baseProbability: 0.08,\n255\t    minDay: 16, maxDay: 30,\n256\t    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n257\t    minActiveDuration: 12000, maxActiveDuration: 20000,\n258\t    buildupDuration: 2000, resolveDuration: 3000,\n259\t    sanityCost: 16, cooldownSec: 240,\n260\t    description: '后巷监控中有个身影，每次查看都更近了',\n261\t  },\n262\t  {\n263\t    type: HorrorEventType.CCTV_DOUBLE,\n264\t    level: HorrorLevel.THREAT,\n265\t    baseProbability: 0.07,\n266\t    minDay: 18, maxDay: 30,\n267\t    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n268\t    minActiveDuration: 8000, maxActiveDuration: 15000,\n269\t    buildupDuration: 1500, resolveDuration: 2000,\n270\t    sanityCost: 18, cooldownSec: 300,\n271\t    description: '监控画面出现了\"你\"，但你不在那个位置',\n272\t  },\n273\t  {\n274\t    type: HorrorEventType.CORRIDOR_EXTEND,\n275\t    level: HorrorLevel.THREAT,\n276\t    baseProbability: 0.06,\n277\t    minDay: 20, maxDay: 30,\n278\t    phaseRequired: [GamePhase.DANGER],\n279\t    minActiveDuration: 10000, maxActiveDuration: 18000,\n280\t    buildupDuration: 3000, resolveDuration: 4000,\n281\t    sanityCost: 20, cooldownSec: 360,\n282\t    description: '通向仓库的走廊变长了，尽头多了一扇门',\n283\t  },\n284\t  {\n285\t    type: HorrorEventType.RADIO_VOICE,\n286\t    level: HorrorLevel.THREAT,\n287\t    baseProbability: 0.07,\n288\t    minDay: 16, maxDay: 30,\n289\t    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n290\t    minActiveDuration: 8000, maxActiveDuration: 12000,\n291\t    buildupDuration: 1500, resolveDuration: 1000,\n292\t    sanityCost: 14, cooldownSec: 180,\n293\t    description: '收音机里传出前任店员的声音',\n294\t  },\n295\t  // Level 4: Existential (new M5 events)\n296\t  {\n297\t    type: HorrorEventType.MIRROR_STORE,\n298\t    level: HorrorLevel.EXISTENTIAL,\n299\t    baseProbability: 0.04,\n300\t    minDay: 26, maxDay: 30,\n301\t    phaseRequired: [GamePhase.DANGER],\n302\t    minActiveDuration: 15000, maxActiveDuration: 25000,\n303\t    buildupDuration: 3000, resolveDuration: 5000,\n304\t    sanityCost: 28, cooldownSec: 600,\n305\t    description: '你进入了镜像便利店，一切左右翻转',\n306\t  },\n307\t  {\n308\t    type: HorrorEventType.HE_COMES,\n309\t    level: HorrorLevel.EXISTENTIAL,\n310\t    baseProbability: 0.05,\n311\t    minDay: 26, maxDay: 30,\n312\t    phaseRequired: [GamePhase.DANGER],\n313\t    minActiveDuration: 30000, maxActiveDuration: 30000,\n314\t    buildupDuration: 5000, resolveDuration: 3000,\n315\t    sanityCost: 30, cooldownSec: 600,\n316\t    description: '\"他\"来了——30秒不可阻挡的缓慢接近',\n317\t  },\n318\t  {\n319\t    type: HorrorEventType.FINAL_CHOICE,\n320\t    level: HorrorLevel.EXISTENTIAL,\n321\t    baseProbability: 0.03,\n322\t    minDay: 29, maxDay: 30,\n323\t    phaseRequired: [GamePhase.DANGER],\n324\t    minActiveDuration: 0, maxActiveDuration: 0,\n325\t    buildupDuration: 3000, resolveDuration: 5000,\n326\t    sanityCost: 25, cooldownSec: 9999,\n327\t    description: '基于之前选择的最终决定时刻',\n328\t  },\n329\t];\n330\t\n331\t// --- Visual Effect State ---\n332\t\n333\texport interface HorrorVisualState {\n334\t  // Global\n335\t  frostIntensity: number;      // 0-1, frost on edges\n336\t  darknessBoost: number;       // 0-0.5, extra darkness\n337\t  screenShake: number;         // shake intensity\n338\t  chromaticAberration: number; // 0-1\n339\t  vignetteIntensity: number;   // 0-1\n340\t\n341\t  // Specific\n342\t  flickeringLightIndex: number; // which light is flickering (-1 = none)\n343\t  flickerIntensity: number;     // 0-1\n344\t\n345\t  bloodPositions: Array<{ x: number; y: number; size: number; alpha: number }>;\n346\t  ghostEntity: {\n347\t    active: boolean;\n348\t    x: number;\n349\t    y: number;\n350\t    opacity: number;\n351\t    type: 'ghost_customer' | 'duplicate' | 'nonpaying' | 'shadow';\n352\t  } | null;\n353\t  doorState: {\n354\t    frontOpen: boolean;\n355\t    backOpen: boolean;\n356\t  };\n357\t  timeGlitchActive: boolean;\n358\t  storeMutateOffset: { x: number; y: number };\n359\t  whisperActive: boolean;\n360\t\n361\t  // Level 3 new\n362\t  stalkerPosition: { x: number; y: number; distance: number } | null;\n363\t  cctvGlitchActive: boolean;\n364\t  corridorStretch: number; // 0-1 how much the corridor extends\n365\t  radioDistortion: number; // 0-1\n366\t\n367\t  // Level 4 new\n368\t  mirrorActive: boolean;\n369\t  mirrorFlipX: boolean;\n370\t  heComesActive: boolean;\n371\t  heComesProgress: number; // 0-1 how close \"he\" is\n372\t  finalChoiceActive: boolean;\n373\t\n374\t  // Atmosphere\n375\t  ambientFear: number; // 0-1 overall fear level\n376\t  recentHighFearCount: number; // for fear regulation\n377\t}\n378\t\n379\texport function createDefaultVisualState(): HorrorVisualState {\n380\t  return {\n381\t    frostIntensity: 0,\n382\t    darknessBoost: 0,\n383\t    screenShake: 0,\n384\t    chromaticAberration: 0,\n385\t    vignetteIntensity: 0.3,\n386\t    flickeringLightIndex: -1,\n387\t    flickerIntensity: 0,\n388\t    bloodPositions: [],\n389\t    ghostEntity: null,\n390\t    doorState: { frontOpen: false, backOpen: false },\n391\t    timeGlitchActive: false,\n392\t    storeMutateOffset: { x: 0, y: 0 },\n393\t    whisperActive: false,\n394\t    stalkerPosition: null,\n395\t    cctvGlitchActive: false,\n396\t    corridorStretch: 0,\n397\t    radioDistortion: 0,\n398\t    mirrorActive: false,\n399\t    mirrorFlipX: false,\n400\t    heComesActive: false,\n401\t    heComesProgress: 0,\n402\t    finalChoiceActive: false,\n403\t    ambientFear: 0,\n404\t    recentHighFearCount: 0,\n405\t  };\n406\t}\n407\t\n408\t// --- Manager ---\n409\t\n410\texport class HorrorEventManager {\n411\t  private activeEvents: HorrorEventInstance[] = [];\n412\t  private cooldowns: Map<HorrorEventType, number> = new Map();\n413\t  private visual: HorrorVisualState = createDefaultVisualState();\n414\t  private checkInterval = 5000; // check every 5 seconds\n415\t  private checkTimer = 0;\n416\t  private dayAccumulatedSanityCost = 0;\n417\t  private maxSanityCostPerNight = 40;\n418\t  private eventCounter = 0;\n419\t  private maxConcurrentEvents = 3;\n420\t\n421\t  // Callbacks\n422\t  onEventTrigger?: (event: HorrorEventInstance) => void;\n423\t  onSanityChange?: (delta: number) => void;\n424\t  onNotification?: (text: string) => void;\n425\t\n426\t  get visuals(): HorrorVisualState { return this.visual; }\n427\t  get activeEventCount(): number { return this.activeEvents.length; }\n428\t\n429\t  update(dt: number, day: number, phase: GamePhase, timeOfDay: number, sanity: number): HorrorVisualState {\n430\t    const dtSec = dt / 1000;\n431\t\n432\t    // Update cooldowns\n433\t    for (const [type, cd] of this.cooldowns) {\n434\t      if (cd > 0) this.cooldowns.set(type, Math.max(0, cd - dtSec));\n435\t    }\n436\t\n437\t    // Check for new events only at night\n438\t    if (isNightTime(phase) && this.activeEvents.length < this.maxConcurrentEvents) {\n439\t      this.checkTimer += dt;\n440\t      if (this.checkTimer >= this.checkInterval) {\n441\t        this.checkTimer = 0;\n442\t        this.tryTriggerEvents(day, phase, sanity);\n443\t      }\n444\t    }\n445\t\n446\t    // Update active events\n447\t    this.updateActiveEvents(dt);\n448\t\n449\t    // Decay visual effects toward baseline\n450\t    this.decayVisuals(dtSec);\n451\t\n452\t    // Calculate ambient fear\n453\t    this.updateAmbientFear(day, phase, timeOfDay);\n454\t\n455\t    return this.visual;\n456\t  }\n457\t\n458\t  private tryTriggerEvents(day: number, phase: GamePhase, sanity: number): void {\n459\t    for (const def of EVENT_DEFS) {\n460\t      if (this.activeEvents.length >= this.maxConcurrentEvents) break;\n461\t      if (this.activeEvents.some(e => e.type === def.type)) continue;\n462\t      if (day < def.minDay || day > def.maxDay) continue;\n463\t      if (!def.phaseRequired.includes(phase)) continue;\n464\t\n465\t      const cd = this.cooldowns.get(def.type) ?? 0;\n466\t      if (cd > 0) continue;\n467\t\n468\t      // Fear regulation: reduce probability if recent high fear\n469\t      let probabilityMod = 1;\n470\t      if (this.visual.recentHighFearCount >= 2 && def.level >= HorrorLevel.THREAT) {\n471\t        probabilityMod = 0.2; // big reduction after consecutive high fear\n472\t      }\n473\t\n474\t      // Sanity affects: lower sanity = slightly less events (overwhelmed player)\n475\t      if (sanity < 30) probabilityMod *= 0.5;\n476\t\n477\t      // Night depth increases probability\n478\t      const nightDepth = phase === GamePhase.DANGER ? 1.5 : 1;\n479\t      probabilityMod *= nightDepth;\n480\t\n481\t      // Day progression increases probability\n482\t      const dayProgress = Math.min(day / 15, 2);\n483\t      probabilityMod *= dayProgress;\n484\t\n485\t      const roll = Math.random();\n486\t      if (roll < def.baseProbability * probabilityMod) {\n487\t        this.triggerEvent(def);\n488\t      }\n489\t    }\n490\t  }\n491\t\n492\t  private triggerEvent(def: HorrorEventDef): void {\n493\t    const id = `horror_${++this.eventCounter}_${Date.now()}`;\n494\t    const event: HorrorEventInstance = {\n495\t      id,\n496\t      type: def.type,\n497\t      level: def.level,\n498\t      state: HorrorEventState.BUILDUP,\n499\t      timer: 0,\n500\t      duration: def.minActiveDuration + Math.random() * (def.maxActiveDuration - def.minActiveDuration),\n501\t      buildupDuration: def.buildupDuration,\n502\t      resolveDuration: def.resolveDuration,\n503\t      data: {},\n504\t      sanityCost: def.sanityCost,\n505\t    };\n506\t\n507\t    // Randomize specific data\n508\t    event.data = this.generateEventData(def);\n509\t\n510\t    this.activeEvents.push(event);\n511\t    this.cooldowns.set(def.type, def.cooldownSec);\n512\t\n513\t    if (def.level >= HorrorLevel.THREAT) {\n514\t      this.visual.recentHighFearCount++;\n515\t    }\n516\t\n517\t    this.onEventTrigger?.(event);\n518\t    this.onNotification?.(`⚠ ${def.description}`);\n519\t  }\n520\t\n521\t  private generateEventData(def: HorrorEventDef): Record<string, unknown> {\n522\t    switch (def.type) {\n523\t      case HorrorEventType.SHELF_SHIFT:\n524\t        return { shelfIndex: Math.floor(Math.random() * 5) };\n525\t      case HorrorEventType.LIGHT_FLICKER:\n526\t        return { lightIndex: Math.floor(Math.random() * 8) };\n527\t      case HorrorEventType.REGISTER_ANOMALY:\n528\t        return { registerIndex: Math.floor(Math.random() * 2), anomalyAmount: Math.floor(Math.random() * 9999) };\n529\t      case HorrorEventType.BLOOD_ON_SHELF: {\n530\t        const positions = [];\n531\t        const count = 2 + Math.floor(Math.random() * 4);\n532\t        for (let i = 0; i < count; i++) {\n533\t          positions.push({\n534\t            x: 100 + Math.random() * 600,\n535\t            y: 100 + Math.random() * 400,\n536\t            size: 8 + Math.random() * 20,\n537\t            alpha: 0.3 + Math.random() * 0.5,\n538\t          });\n539\t        }\n540\t        return { positions };\n541\t      }\n542\t      case HorrorEventType.GHOST_CUSTOMER:\n543\t        return { startX: Math.random() * 400 + 100, startY: 50, opacity: 0 };\n544\t      case HorrorEventType.DUPLICATE_CUSTOMER:\n545\t        return { x1: 200 + Math.random() * 200, x2: 400 + Math.random() * 200, y: 200 + Math.random() * 100 };\n546\t      case HorrorEventType.NONPAYING_CUSTOMER:\n547\t        return { x: 300 + Math.random() * 200, y: 150 + Math.random() * 100 };\n548\t      case HorrorEventType.DOOR_AUTO_OPEN:\n549\t        return { door: Math.random() < 0.5 ? 'front' : 'back' };\n550\t      case HorrorEventType.STALKER:\n551\t        return { startX: 400 + Math.random() * 200, startY: 200, distance: 300 + Math.random() * 200, checkCount: 0 };\n552\t      case HorrorEventType.CCTV_DOUBLE:\n553\t        return { glitchX: 200 + Math.random() * 400, glitchY: 100 + Math.random() * 200 };\n554\t      case HorrorEventType.CORRIDOR_EXTEND:\n555\t        return { extraDoors: 1 + Math.floor(Math.random() * 2), stretchAmount: 1.5 + Math.random() };\n556\t      case HorrorEventType.RADIO_VOICE:\n557\t        return { frequency: 88 + Math.random() * 20, voiceType: Math.floor(Math.random() * 3) };\n558\t      case HorrorEventType.MIRROR_STORE:\n559\t        return { flipAxis: 'x' as const };\n560\t      case HorrorEventType.HE_COMES:\n561\t        return { startX: 450, startY: 24 * 32, speed: 0.7 + Math.random() * 0.3 };\n562\t      case HorrorEventType.FINAL_CHOICE:\n563\t        return { choiceType: Math.floor(Math.random() * 3) };\n564\t      default:\n565\t        return {};\n566\t    }\n567\t  }\n568\t\n569\t  private updateActiveEvents(dt: number): void {\n570\t    const completed: string[] = [];\n571\t\n572\t    for (const event of this.activeEvents) {\n573\t      event.timer += dt;\n574\t\n575\t      switch (event.state) {\n576\t        case HorrorEventState.BUILDUP:\n577\t          this.applyBuildupEffect(event, event.timer / event.buildupDuration);\n578\t          if (event.timer >= event.buildupDuration) {\n579\t            event.state = HorrorEventState.ACTIVE;\n580\t            event.timer = 0;\n581\t            this.applyActiveEffect(event);\n582\t            this.onSanityChange?.(-event.sanityCost);\n583\t            this.dayAccumulatedSanityCost += event.sanityCost;\n584\t          }\n585\t          break;\n586\t\n587\t        case HorrorEventState.ACTIVE:\n588\t          this.sustainActiveEffect(event, event.timer / event.duration);\n589\t          if (event.timer >= event.duration) {\n590\t            event.state = HorrorEventState.RESOLVING;\n591\t            event.timer = 0;\n592\t            this.beginResolve(event);\n593\t          }\n594\t          break;\n595\t\n596\t        case HorrorEventState.RESOLVING:\n597\t          this.applyResolveEffect(event, event.timer / event.resolveDuration);\n598\t          if (event.timer >= event.resolveDuration) {\n599\t            event.state = HorrorEventState.COMPLETE;\n600\t            completed.push(event.id);\n601\t            this.clearEventEffects(event);\n602\t          }\n603\t          break;\n604\t      }\n605\t    }\n606\t\n607\t    for (const id of completed) {\n608\t      this.activeEvents = this.activeEvents.filter(e => e.id !== id);\n609\t    }\n610\t  }\n611\t\n612\t  // --- Buildup Effects (预兆) ---\n613\t\n614\t  private applyBuildupEffect(event: HorrorEventInstance, progress: number): void {\n615\t    const p = Math.min(1, progress);\n616\t    switch (event.type) {\n617\t      case HorrorEventType.LIGHT_FLICKER:\n618\t        this.visual.flickeringLightIndex = (event.data.lightIndex as number) ?? 0;\n619\t        this.visual.flickerIntensity = p * 0.3;\n620\t        break;\n621\t      case HorrorEventType.TEMP_DROP:\n622\t        this.visual.frostIntensity = p * 0.2;\n623\t        break;\n624\t      case HorrorEventType.BLOOD_ON_SHELF:\n625\t        this.visual.darknessBoost = p * 0.1;\n626\t        break;\n627\t      case HorrorEventType.WHISPER:\n628\t        this.visual.whisperActive = true;\n629\t        break;\n630\t      case HorrorEventType.GHOST_CUSTOMER:\n631\t      case HorrorEventType.DUPLICATE_CUSTOMER:\n632\t      case HorrorEventType.NONPAYING_CUSTOMER:\n633\t        this.visual.vignetteIntensity = Math.min(1, 0.3 + p * 0.3);\n634\t        break;\n635\t      case HorrorEventType.DOOR_AUTO_OPEN:\n636\t        this.visual.screenShake = p * 0.3;\n637\t        break;\n638\t      case HorrorEventType.STALKER:\n639\t        this.visual.vignetteIntensity = Math.min(1, 0.3 + p * 0.4);\n640\t        break;\n641\t      case HorrorEventType.CCTV_DOUBLE:\n642\t        this.visual.chromaticAberration = p * 0.2;\n643\t        break;\n644\t      case HorrorEventType.CORRIDOR_EXTEND:\n645\t        this.visual.corridorStretch = p * 0.3;\n646\t        break;\n647\t      case HorrorEventType.RADIO_VOICE:\n648\t        this.visual.radioDistortion = p * 0.3;\n649\t        break;\n650\t      case HorrorEventType.MIRROR_STORE:\n651\t        this.visual.chromaticAberration = p * 0.4;\n652\t        break;\n653\t      case HorrorEventType.HE_COMES:\n654\t        this.visual.vignetteIntensity = Math.min(1, 0.4 + p * 0.5);\n655\t        this.visual.darknessBoost = p * 0.2;\n656\t        break;\n657\t      case HorrorEventType.FINAL_CHOICE:\n658\t        this.visual.chromaticAberration = p * 0.5;\n659\t        this.visual.vignetteIntensity = Math.min(1, 0.5 + p * 0.5);\n660\t        break;\n661\t      case HorrorEventType.STORE_MUTATE:\n662\t        this.visual.chromaticAberration = p * 0.3;\n663\t        break;\n664\t      default:\n665\t        this.visual.darknessBoost = p * 0.05;\n666\t        break;\n667\t    }\n668\t  }\n669\t\n670\t  // --- Active Effects ---\n671\t\n672\t  private applyActiveEffect(event: HorrorEventInstance): void {\n673\t    switch (event.type) {\n674\t      case HorrorEventType.LIGHT_FLICKER:\n675\t        this.visual.flickerIntensity = 0.8;\n676\t        break;\n677\t      case HorrorEventType.TEMP_DROP:\n678\t        this.visual.frostIntensity = 0.6;\n679\t        this.visual.vignetteIntensity = 0.7;\n680\t        break;\n681\t      case HorrorEventType.FRIDGE_NOISE:\n682\t        this.visual.screenShake = 0.5;\n683\t        break;\n684\t      case HorrorEventType.BLOOD_ON_SHELF:\n685\t        this.visual.bloodPositions = (event.data.positions as Array<{ x: number; y: number; size: number; alpha: number }>) ?? [];\n686\t        break;\n687\t      case HorrorEventType.GHOST_CUSTOMER:\n688\t        this.visual.ghostEntity = {\n689\t          active: true,\n690\t          x: (event.data.startX as number) ?? 300,\n691\t          y: (event.data.startY as number) ?? 50,\n692\t          opacity: 0.4,\n693\t          type: 'ghost_customer',\n694\t        };\n695\t        break;\n696\t      case HorrorEventType.DUPLICATE_CUSTOMER:\n697\t        this.visual.ghostEntity = {\n698\t          active: true,\n699\t          x: (event.data.x1 as number) ?? 200,\n700\t          y: (event.data.y as number) ?? 200,\n701\t          opacity: 0.8,\n702\t          type: 'duplicate',\n703\t        };\n704\t        break;\n705\t      case HorrorEventType.NONPAYING_CUSTOMER:\n706\t        this.visual.ghostEntity = {\n707\t          active: true,\n708\t          x: (event.data.x as number) ?? 300,\n709\t          y: (event.data.y as number) ?? 150,\n710\t          opacity: 0.9,\n711\t          type: 'nonpaying',\n712\t        };\n713\t        break;\n714\t      case HorrorEventType.DOOR_AUTO_OPEN:\n715\t        if ((event.data.door as string) === 'front') {\n716\t          this.visual.doorState.frontOpen = true;\n717\t        } else {\n718\t          this.visual.doorState.backOpen = true;\n719\t        }\n720\t        this.visual.darknessBoost = 0.3;\n721\t        this.visual.screenShake = 0.8;\n722\t        break;\n723\t      case HorrorEventType.WHISPER:\n724\t        this.visual.whisperActive = true;\n725\t        this.visual.vignetteIntensity = 0.8;\n726\t        break;\n727\t      case HorrorEventType.STORE_MUTATE:\n728\t        this.visual.storeMutateOffset = { x: (Math.random() - 0.5) * 10, y: (Math.random() - 0.5) * 10 };\n729\t        this.visual.chromaticAberration = 0.8;\n730\t        this.visual.screenShake = 0.4;\n731\t        break;\n732\t      case HorrorEventType.TIME_GLITCH:\n733\t        this.visual.timeGlitchActive = true;\n734\t        this.visual.chromaticAberration = 0.6;\n735\t        break;\n736\t      case HorrorEventType.STALKER:\n737\t        this.visual.stalkerPosition = {\n738\t          x: (event.data.startX as number) ?? 400,\n739\t          y: (event.data.startY as number) ?? 200,\n740\t          distance: (event.data.distance as number) ?? 300,\n741\t        };\n742\t        this.visual.vignetteIntensity = 0.8;\n743\t        break;\n744\t      case HorrorEventType.CCTV_DOUBLE:\n745\t        this.visual.cctvGlitchActive = true;\n746\t        this.visual.chromaticAberration = 0.5;\n747\t        this.visual.screenShake = 0.3;\n748\t        break;\n749\t      case HorrorEventType.CORRIDOR_EXTEND:\n750\t        this.visual.corridorStretch = 1;\n751\t        this.visual.darknessBoost = 0.3;\n752\t        this.visual.screenShake = 0.2;\n753\t        break;\n754\t      case HorrorEventType.RADIO_VOICE:\n755\t        this.visual.radioDistortion = 1;\n756\t        this.visual.whisperActive = true;\n757\t        break;\n758\t      case HorrorEventType.MIRROR_STORE:\n759\t        this.visual.mirrorActive = true;\n760\t        this.visual.mirrorFlipX = true;\n761\t        this.visual.chromaticAberration = 0.8;\n762\t        this.visual.screenShake = 0.4;\n763\t        break;\n764\t      case HorrorEventType.HE_COMES:\n765\t        this.visual.heComesActive = true;\n766\t        this.visual.heComesProgress = 0;\n767\t        this.visual.darknessBoost = 0.5;\n768\t        this.visual.vignetteIntensity = 1;\n769\t        this.visual.screenShake = 0.6;\n770\t        break;\n771\t      case HorrorEventType.FINAL_CHOICE:\n772\t        this.visual.finalChoiceActive = true;\n773\t        this.visual.chromaticAberration = 1;\n774\t        this.visual.vignetteIntensity = 1;\n775\t        break;\n776\t      default:\n777\t        this.visual.darknessBoost = 0.15;\n778\t        break;\n779\t    }\n780\t  }\n781\t\n782\t  private sustainActiveEffect(event: HorrorEventInstance, progress: number): void {\n783\t    // Pulsing effects during sustain\n784\t    const pulse = Math.sin(progress * Math.PI * 4) * 0.5 + 0.5;\n785\t\n786\t    switch (event.type) {\n787\t      case HorrorEventType.LIGHT_FLICKER:\n788\t        this.visual.flickerIntensity = 0.4 + pulse * 0.5;\n789\t        break;\n790\t      case HorrorEventType.FRIDGE_NOISE:\n791\t        this.visual.screenShake = 0.2 + pulse * 0.3;\n792\t        break;\n793\t      case HorrorEventType.GHOST_CUSTOMER:\n794\t        if (this.visual.ghostEntity) {\n795\t          this.visual.ghostEntity.opacity = 0.2 + pulse * 0.4;\n796\t          this.visual.ghostEntity.y += 0.1;\n797\t        }\n798\t        break;\n799\t      case HorrorEventType.STORE_MUTATE: {\n800\t        const t = performance.now() * 0.001;\n801\t        this.visual.storeMutateOffset = {\n802\t          x: Math.sin(t * 0.5) * 8,\n803\t          y: Math.cos(t * 0.7) * 5,\n804\t        };\n805\t        break;\n806\t      }\n807\t      case HorrorEventType.TIME_GLITCH:\n808\t        this.visual.chromaticAberration = 0.3 + pulse * 0.5;\n809\t        break;\n810\t      case HorrorEventType.STALKER:\n811\t        if (this.visual.stalkerPosition) {\n812\t          this.visual.stalkerPosition.distance = Math.max(50, (this.visual.stalkerPosition.distance ?? 300) - 0.5);\n813\t        }\n814\t        break;\n815\t      case HorrorEventType.CCTV_DOUBLE:\n816\t        this.visual.chromaticAberration = 0.3 + pulse * 0.4;\n817\t        break;\n818\t      case HorrorEventType.CORRIDOR_EXTEND:\n819\t        this.visual.corridorStretch = 0.8 + pulse * 0.2;\n820\t        break;\n821\t      case HorrorEventType.HE_COMES:\n822\t        this.visual.heComesProgress = Math.min(1, progress);\n823\t        this.visual.darknessBoost = 0.3 + progress * 0.4;\n824\t        this.visual.screenShake = 0.3 + progress * 0.5;\n825\t        break;\n826\t      case HorrorEventType.FINAL_CHOICE:\n827\t        this.visual.chromaticAberration = 0.5 + pulse * 0.5;\n828\t        break;\n829\t      default:\n830\t        break;\n831\t    }\n832\t  }\n833\t\n834\t  // --- Resolve Effects ---\n835\t\n836\t  private beginResolve(event: HorrorEventInstance): void {\n837\t    switch (event.type) {\n838\t      case HorrorEventType.FRIDGE_NOISE:\n839\t        // Sudden silence is scarier\n840\t        this.visual.screenShake = 0;\n841\t        break;\n842\t      default:\n843\t        break;\n844\t    }\n845\t  }\n846\t\n847\t  private applyResolveEffect(event: HorrorEventInstance, progress: number): void {\n848\t    const p = Math.min(1, progress);\n849\t    switch (event.type) {\n850\t      case HorrorEventType.TEMP_DROP:\n851\t        this.visual.frostIntensity *= (1 - p);\n852\t        break;\n853\t      case HorrorEventType.LIGHT_FLICKER:\n854\t        this.visual.flickerIntensity *= (1 - p);\n855\t        if (p >= 1) this.visual.flickeringLightIndex = -1;\n856\t        break;\n857\t      case HorrorEventType.BLOOD_ON_SHELF:\n858\t        this.visual.bloodPositions = this.visual.bloodPositions.map(b => ({\n859\t          ...b, alpha: b.alpha * (1 - p),\n860\t        }));\n861\t        break;\n862\t      case HorrorEventType.GHOST_CUSTOMER:\n863\t      case HorrorEventType.DUPLICATE_CUSTOMER:\n864\t      case HorrorEventType.NONPAYING_CUSTOMER:\n865\t        if (this.visual.ghostEntity) {\n866\t          this.visual.ghostEntity.opacity *= (1 - p);\n867\t        }\n868\t        break;\n869\t      case HorrorEventType.DOOR_AUTO_OPEN:\n870\t        this.visual.doorState.frontOpen = false;\n871\t        this.visual.doorState.backOpen = false;\n872\t        this.visual.darknessBoost *= (1 - p);\n873\t        break;\n874\t      case HorrorEventType.STORE_MUTATE:\n875\t        this.visual.storeMutateOffset.x *= (1 - p);\n876\t        this.visual.storeMutateOffset.y *= (1 - p);\n877\t        this.visual.chromaticAberration *= (1 - p);\n878\t        break;\n879\t      case HorrorEventType.TIME_GLITCH:\n880\t        if (p >= 0.8) this.visual.timeGlitchActive = false;\n881\t        this.visual.chromaticAberration *= (1 - p);\n882\t        break;\n883\t      case HorrorEventType.STALKER:\n884\t        if (this.visual.stalkerPosition) {\n885\t          this.visual.stalkerPosition.distance *= (1 - p * 0.5);\n886\t        }\n887\t        if (p >= 1) this.visual.stalkerPosition = null;\n888\t        break;\n889\t      case HorrorEventType.CCTV_DOUBLE:\n890\t        this.visual.chromaticAberration *= (1 - p);\n891\t        if (p >= 1) this.visual.cctvGlitchActive = false;\n892\t        break;\n893\t      case HorrorEventType.CORRIDOR_EXTEND:\n894\t        this.visual.corridorStretch *= (1 - p);\n895\t        break;\n896\t      case HorrorEventType.RADIO_VOICE:\n897\t        this.visual.radioDistortion *= (1 - p);\n898\t        if (p >= 0.5) this.visual.whisperActive = false;\n899\t        break;\n900\t      case HorrorEventType.MIRROR_STORE:\n901\t        this.visual.chromaticAberration *= (1 - p);\n902\t        if (p >= 1) {\n903\t          this.visual.mirrorActive = false;\n904\t          this.visual.mirrorFlipX = false;\n905\t        }\n906\t        break;\n907\t      case HorrorEventType.HE_COMES:\n908\t        this.visual.darknessBoost *= (1 - p);\n909\t        this.visual.screenShake *= (1 - p);\n910\t        if (p >= 1) {\n911\t          this.visual.heComesActive = false;\n912\t          this.visual.heComesProgress = 0;\n913\t        }\n914\t        break;\n915\t      case HorrorEventType.FINAL_CHOICE:\n916\t        this.visual.chromaticAberration *= (1 - p);\n917\t        if (p >= 1) this.visual.finalChoiceActive = false;\n918\t        break;\n919\t      default:\n920\t        break;\n921\t    }\n922\t  }\n923\t\n924\t  private clearEventEffects(event: HorrorEventInstance): void {\n925\t    switch (event.type) {\n926\t      case HorrorEventType.GHOST_CUSTOMER:\n927\t      case HorrorEventType.DUPLICATE_CUSTOMER:\n928\t      case HorrorEventType.NONPAYING_CUSTOMER:\n929\t        this.visual.ghostEntity = null;\n930\t        break;\n931\t      case HorrorEventType.BLOOD_ON_SHELF:\n932\t        this.visual.bloodPositions = [];\n933\t        break;\n934\t      case HorrorEventType.WHISPER:\n935\t        this.visual.whisperActive = false;\n936\t        break;\n937\t      case HorrorEventType.TIME_GLITCH:\n938\t        this.visual.timeGlitchActive = false;\n939\t        break;\n940\t      case HorrorEventType.STALKER:\n941\t        this.visual.stalkerPosition = null;\n942\t        break;\n943\t      case HorrorEventType.CCTV_DOUBLE:\n944\t        this.visual.cctvGlitchActive = false;\n945\t        break;\n946\t      case HorrorEventType.CORRIDOR_EXTEND:\n947\t        this.visual.corridorStretch = 0;\n948\t        break;\n949\t      case HorrorEventType.RADIO_VOICE:\n950\t        this.visual.radioDistortion = 0;\n951\t        this.visual.whisperActive = false;\n952\t        break;\n953\t      case HorrorEventType.MIRROR_STORE:\n954\t        this.visual.mirrorActive = false;\n955\t        this.visual.mirrorFlipX = false;\n956\t        break;\n957\t      case HorrorEventType.HE_COMES:\n958\t        this.visual.heComesActive = false;\n959\t        this.visual.heComesProgress = 0;\n960\t        break;\n961\t      case HorrorEventType.FINAL_CHOICE:\n962\t        this.visual.finalChoiceActive = false;\n963\t        break;\n964\t      default:\n965\t        break;\n966\t    }\n967\t  }\n968\t\n969\t  private decayVisuals(dtSec: number): void {\n970\t    const decay = dtSec * 0.5;\n971\t    this.visual.screenShake = Math.max(0, this.visual.screenShake - decay);\n972\t    this.visual.darknessBoost = Math.max(0, this.visual.darknessBoost - decay * 0.1);\n973\t    if (this.visual.flickeringLightIndex === -1) {\n974\t      this.visual.flickerIntensity = Math.max(0, this.visual.flickerIntensity - decay * 0.2);\n975\t    }\n976\t  }\n977\t\n978\t  private updateAmbientFear(day: number, phase: GamePhase, timeOfDay: number): void {\n979\t    let target = 0;\n980\t\n981\t    if (isNightTime(phase)) {\n982\t      target = 0.3;\n983\t      if (phase === GamePhase.NIGHT) target = 0.5;\n984\t      if (phase === GamePhase.DANGER) target = 0.8;\n985\t\n986\t      // Day progression\n987\t      target *= Math.min(1 + (day - 1) * 0.05, 2);\n988\t\n989\t      // Active events boost fear\n990\t      target += this.activeEvents.length * 0.1;\n991\t    }\n992\t\n993\t    this.visual.ambientFear += (target - this.visual.ambientFear) * 0.02;\n994\t  }\n995\t\n996\t  // --- Public API ---\n997\t\n998\t  /** Reset daily state when new day begins */\n999\t  resetDaily(): void {\n1000\t    this.dayAccumulatedSanityCost = 0;\n1001\t    this.visual.recentHighFearCount = 0;\n1002\t    this.activeEvents = [];\n1003\t    this.visual = createDefaultVisualState();\n1004\t  }\n1005\t\n1006\t  /** Get the maximum event level available for current day */\n1007\t  getMaxLevel(day: number): HorrorLevel {\n1008\t    if (day >= 26) return HorrorLevel.EXISTENTIAL;\n1009\t    if (day >= 16) return HorrorLevel.THREAT;\n1010\t    if (day >= 6) return HorrorLevel.ENTITY;\n1011\t    return HorrorLevel.ENVIRONMENT;\n1012\t  }\n1013\t\n1014\t  /** Get active events for display */\n1015\t  getActiveEvents(): ReadonlyArray<HorrorEventInstance> {\n1016\t    return this.activeEvents;\n1017\t  }\n1018\t\n1019\t  /** Get save data */\n1020\t  getSaveData(): Record<string, unknown> {\n1021\t    return {\n1022\t      eventCounter: this.eventCounter,\n1023\t      dayAccumulatedSanityCost: this.dayAccumulatedSanityCost,\n1024\t    };\n1025\t  }\n1026\t\n1027\t  /** Load save data */\n1028\t  loadSaveData(data: Record<string, unknown>): void {\n1029\t    this.eventCounter = (data.eventCounter as number) ?? 0;\n1030\t    this.dayAccumulatedSanityCost = (data.dayAccumulatedSanityCost as number) ?? 0;\n1031\t  }\n1032\t}\n1033\t"}]},"parent_tool_use_id":null,"session_id":"d0384c8e-0462-4f8e-9470-2647774e089a","uuid":"0c4c8289-ce62-4062-b648-b0f7d0e17b46","timestamp":"2026-05-23T05:12:38.146Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-horror-sim\\src\\game\\HorrorEventManager.ts","content":"// HorrorEventManager.ts — Event trigger engine with atmosphere escalation (M4)\n\nimport { GamePhase, isNightTime } from './GameState';\n\n// --- Event Definitions ---\n\nexport enum HorrorLevel {\n  ENVIRONMENT = 1,   // Level 1: 微恐 (Day 1-5)\n  ENTITY = 2,        // Level 2: 中恐 (Day 6-15)\n  THREAT = 3,        // Level 3: 高恐 (Day 16-25)\n  EXISTENTIAL = 4,   // Level 4: 极高恐 (Day 26-30)\n}\n\nexport enum HorrorEventType {\n  // Level 1: Environment\n  SHELF_SHIFT = 'shelf_shift',           // 商品位移\n  REGISTER_ANOMALY = 'register_anomaly', // 收银机异常\n  LIGHT_FLICKER = 'light_flicker',       // 灯光闪烁\n  TEMP_DROP = 'temp_drop',               // 温度骤降\n  FRIDGE_NOISE = 'fridge_noise',         // 冰箱异响\n  // Level 2: Entity\n  GHOST_CUSTOMER = 'ghost_customer',     // 透明顾客\n  DUPLICATE_CUSTOMER = 'duplicate_customer', // 重复脸顾客\n  SHADOW_MISALIGN = 'shadow_misalign',   // 影子错位\n  NEW_PRODUCT = 'new_product',           // 诡异新商品\n  // Level 3: Threat (Day 16-25)\n  DOOR_AUTO_OPEN = 'door_auto_open',     // 门自动开\n  BLOOD_ON_SHELF = 'blood_on_shelf',     // 货架流血\n  NONPAYING_CUSTOMER = 'nonpaying_customer', // 不付款顾客\n  WHISPER = 'whisper',                   // 低语声\n  STALKER = 'stalker',                   // E-301: 尾随者\n  CCTV_DOUBLE = 'cctv_double',           // E-302: 闭路电视中出现\"你\"\n  CORRIDOR_EXTEND = 'corridor_extend',   // E-304: 走廊延伸\n  RADIO_VOICE = 'radio_voice',           // E-305: 收音机播放前任店员声音\n  // Level 4: Existential (Day 26-30)\n  STORE_MUTATE = 'store_mutate',         // E-404: 店铺异变（墙壁移动）\n  TIME_GLITCH = 'time_glitch',           // E-402: 时间循环\n  MIRROR_STORE = 'mirror_store',         // E-401: 平行店（镜像便利店）\n  HE_COMES = 'he_comes',                 // E-403: \"他\"来了\n  FINAL_CHOICE = 'final_choice',         // E-405: 终局选择\n}\n\nexport enum HorrorEventState {\n  INACTIVE = 'inactive',\n  BUILDUP = 'buildup',       // 预兆阶段 (1-3秒)\n  ACTIVE = 'active',         // 活跃阶段\n  RESOLVING = 'resolving',   // 消退阶段\n  COMPLETE = 'complete',\n}\n\nexport interface HorrorEventInstance {\n  id: string;\n  type: HorrorEventType;\n  level: HorrorLevel;\n  state: HorrorEventState;\n  timer: number;          // ms elapsed in current state\n  duration: number;       // total active duration ms\n  buildupDuration: number;\n  resolveDuration: number;\n  data: Record<string, unknown>;\n  sanityCost: number;\n}\n\ninterface HorrorEventDef {\n  type: HorrorEventType;\n  level: HorrorLevel;\n  baseProbability: number;   // per check (0-1)\n  minDay: number;\n  maxDay: number;\n  phaseRequired: GamePhase[];\n  minActiveDuration: number; // ms\n  maxActiveDuration: number;\n  buildupDuration: number;\n  resolveDuration: number;\n  sanityCost: number;\n  cooldownSec: number;       // min seconds between same event type\n  description: string;\n}\n\nconst EVENT_DEFS: HorrorEventDef[] = [\n  // Level 1: Environment\n  {\n    type: HorrorEventType.SHELF_SHIFT,\n    level: HorrorLevel.ENVIRONMENT,\n    baseProbability: 0.15,\n    minDay: 1, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 3000, maxActiveDuration: 6000,\n    buildupDuration: 1500, resolveDuration: 1000,\n    sanityCost: 3, cooldownSec: 60,\n    description: '某个货架上的商品在你不注意时换了位置',\n  },\n  {\n    type: HorrorEventType.REGISTER_ANOMALY,\n    level: HorrorLevel.ENVIRONMENT,\n    baseProbability: 0.10,\n    minDay: 1, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 4000, maxActiveDuration: 8000,\n    buildupDuration: 800, resolveDuration: 1500,\n    sanityCost: 5, cooldownSec: 90,\n    description: '收银机自动打开/关上，或显示异常金额',\n  },\n  {\n    type: HorrorEventType.LIGHT_FLICKER,\n    level: HorrorLevel.ENVIRONMENT,\n    baseProbability: 0.20,\n    minDay: 1, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT_TRANSITION, GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 2000, maxActiveDuration: 5000,\n    buildupDuration: 500, resolveDuration: 800,\n    sanityCost: 4, cooldownSec: 45,\n    description: '某盏灯间歇性闪烁，频率逐渐加快',\n  },\n  {\n    type: HorrorEventType.TEMP_DROP,\n    level: HorrorLevel.ENVIRONMENT,\n    baseProbability: 0.12,\n    minDay: 1, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 5000, maxActiveDuration: 10000,\n    buildupDuration: 2000, resolveDuration: 1500,\n    sanityCost: 4, cooldownSec: 120,\n    description: '画面边缘出现霜冻效果，呼吸可见',\n  },\n  {\n    type: HorrorEventType.FRIDGE_NOISE,\n    level: HorrorLevel.ENVIRONMENT,\n    baseProbability: 0.15,\n    minDay: 1, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 2000, maxActiveDuration: 4000,\n    buildupDuration: 300, resolveDuration: 500,\n    sanityCost: 3, cooldownSec: 60,\n    description: '冰箱突然发出很大的嗡鸣，然后瞬间安静',\n  },\n  // Level 2: Entity\n  {\n    type: HorrorEventType.GHOST_CUSTOMER,\n    level: HorrorLevel.ENTITY,\n    baseProbability: 0.12,\n    minDay: 6, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 8000, maxActiveDuration: 15000,\n    buildupDuration: 3000, resolveDuration: 2000,\n    sanityCost: 10, cooldownSec: 180,\n    description: '一位半透明的顾客走进店里，若隐若现',\n  },\n  {\n    type: HorrorEventType.DUPLICATE_CUSTOMER,\n    level: HorrorLevel.ENTITY,\n    baseProbability: 0.08,\n    minDay: 8, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 10000, maxActiveDuration: 18000,\n    buildupDuration: 2000, resolveDuration: 3000,\n    sanityCost: 12, cooldownSec: 240,\n    description: '两个完全一样的顾客同时出现在店里',\n  },\n  {\n    type: HorrorEventType.SHADOW_MISALIGN,\n    level: HorrorLevel.ENTITY,\n    baseProbability: 0.10,\n    minDay: 6, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 6000, maxActiveDuration: 12000,\n    buildupDuration: 1500, resolveDuration: 1000,\n    sanityCost: 8, cooldownSec: 150,\n    description: '你的影子角度不对，或者有自己的动作',\n  },\n  {\n    type: HorrorEventType.NEW_PRODUCT,\n    level: HorrorLevel.ENTITY,\n    baseProbability: 0.08,\n    minDay: 7, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 6000, maxActiveDuration: 10000,\n    buildupDuration: 0, resolveDuration: 500,\n    sanityCost: 7, cooldownSec: 200,\n    description: '货架上出现了你没进过货的商品，包装文字无法辨认',\n  },\n  // Level 3: Threat\n  {\n    type: HorrorEventType.DOOR_AUTO_OPEN,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.10,\n    minDay: 16, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 5000, maxActiveDuration: 8000,\n    buildupDuration: 1000, resolveDuration: 2000,\n    sanityCost: 15, cooldownSec: 180,\n    description: '前门或后门自己打开，外面是完全的黑暗',\n  },\n  {\n    type: HorrorEventType.BLOOD_ON_SHELF,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.08,\n    minDay: 18, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 8000, maxActiveDuration: 12000,\n    buildupDuration: 2000, resolveDuration: 3000,\n    sanityCost: 18, cooldownSec: 240,\n    description: '某个货架上出现暗红色液体缓缓渗出',\n  },\n  {\n    type: HorrorEventType.NONPAYING_CUSTOMER,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.10,\n    minDay: 16, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 10000, maxActiveDuration: 20000,\n    buildupDuration: 3000, resolveDuration: 1000,\n    sanityCost: 14, cooldownSec: 200,\n    description: '一个顾客拿了东西不走，也不付钱，只是盯着你看',\n  },\n  {\n    type: HorrorEventType.WHISPER,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.12,\n    minDay: 16, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 4000, maxActiveDuration: 8000,\n    buildupDuration: 2000, resolveDuration: 500,\n    sanityCost: 12, cooldownSec: 120,\n    description: '耳边传来低语声，听不清在说什么',\n  },\n  // Level 4: Existential\n  {\n    type: HorrorEventType.STORE_MUTATE,\n    level: HorrorLevel.EXISTENTIAL,\n    baseProbability: 0.06,\n    minDay: 26, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 10000, maxActiveDuration: 20000,\n    buildupDuration: 3000, resolveDuration: 5000,\n    sanityCost: 25, cooldownSec: 300,\n    description: '店铺结构开始改变，墙壁在移动',\n  },\n  {\n    type: HorrorEventType.TIME_GLITCH,\n    level: HorrorLevel.EXISTENTIAL,\n    baseProbability: 0.05,\n    minDay: 26, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 5000, maxActiveDuration: 8000,\n    buildupDuration: 1000, resolveDuration: 2000,\n    sanityCost: 20, cooldownSec: 300,\n    description: '时钟突然倒转，时间出现异常',\n  },\n  // Level 3: Threat (new M5 events)\n  {\n    type: HorrorEventType.STALKER,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.08,\n    minDay: 16, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 12000, maxActiveDuration: 20000,\n    buildupDuration: 2000, resolveDuration: 3000,\n    sanityCost: 16, cooldownSec: 240,\n    description: '后巷监控中有个身影，每次查看都更近了',\n  },\n  {\n    type: HorrorEventType.CCTV_DOUBLE,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.07,\n    minDay: 18, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 8000, maxActiveDuration: 15000,\n    buildupDuration: 1500, resolveDuration: 2000,\n    sanityCost: 18, cooldownSec: 300,\n    description: '监控画面出现了\"你\"，但你不在那个位置',\n  },\n  {\n    type: HorrorEventType.CORRIDOR_EXTEND,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.06,\n    minDay: 20, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 10000, maxActiveDuration: 18000,\n    buildupDuration: 3000, resolveDuration: 4000,\n    sanityCost: 20, cooldownSec: 360,\n    description: '通向仓库的走廊变长了，尽头多了一扇门',\n  },\n  {\n    type: HorrorEventType.RADIO_VOICE,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.07,\n    minDay: 16, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 8000, maxActiveDuration: 12000,\n    buildupDuration: 1500, resolveDuration: 1000,\n    sanityCost: 14, cooldownSec: 180,\n    description: '收音机里传出前任店员的声音',\n  },\n  // Level 4: Existential (new M5 events)\n  {\n    type: HorrorEventType.MIRROR_STORE,\n    level: HorrorLevel.EXISTENTIAL,\n    baseProbability: 0.04,\n    minDay: 26, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 15000, maxActiveDuration: 25000,\n    buildupDuration: 3000, resolveDuration: 5000,\n    sanityCost: 28, cooldownSec: 600,\n    description: '你进入了镜像便利店，一切左右翻转',\n  },\n  {\n    type: HorrorEventType.HE_COMES,\n    level: HorrorLevel.EXISTENTIAL,\n    baseProbability: 0.05,\n    minDay: 26, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 30000, maxActiveDuration: 30000,\n    buildupDuration: 5000, resolveDuration: 3000,\n    sanityCost: 30, cooldownSec: 600,\n    description: '\"他\"来了——30秒不可阻挡的缓慢接近',\n  },\n  {\n    type: HorrorEventType.FINAL_CHOICE,\n    level: HorrorLevel.EXISTENTIAL,\n    baseProbability: 0.03,\n    minDay: 29, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 0, maxActiveDuration: 0,\n    buildupDuration: 3000, resolveDuration: 5000,\n    sanityCost: 25, cooldownSec: 9999,\n    description: '基于之前选择的最终决定时刻',\n  },\n];\n\n// --- Visual Effect State ---\n\nexport interface HorrorVisualState {\n  // Global\n  frostIntensity: number;      // 0-1, frost on edges\n  darknessBoost: number;       // 0-0.5, extra darkness\n  screenShake: number;         // shake intensity\n  chromaticAberration: number; // 0-1\n  vignetteIntensity: number;   // 0-1\n\n  // Specific\n  flickeringLightIndex: number; // which light is flickering (-1 = none)\n  flickerIntensity: number;     // 0-1\n\n  bloodPositions: Array<{ x: number; y: number; size: number; alpha: number }>;\n  ghostEntity: {\n    active: boolean;\n    x: number;\n    y: number;\n    opacity: number;\n    type: 'ghost_customer' | 'duplicate' | 'nonpaying' | 'shadow';\n  } | null;\n  doorState: {\n    frontOpen: boolean;\n    backOpen: boolean;\n  };\n  timeGlitchActive: boolean;\n  storeMutateOffset: { x: number; y: number };\n  whisperActive: boolean;\n\n  // Level 3 new\n  stalkerPosition: { x: number; y: number; distance: number } | null;\n  cctvGlitchActive: boolean;\n  corridorStretch: number; // 0-1 how much the corridor extends\n  radioDistortion: number; // 0-1\n\n  // Level 4 new\n  mirrorActive: boolean;\n  mirrorFlipX: boolean;\n  heComesActive: boolean;\n  heComesProgress: number; // 0-1 how close \"he\" is\n  finalChoiceActive: boolean;\n\n  // Atmosphere\n  ambientFear: number; // 0-1 overall fear level\n  recentHighFearCount: number; // for fear regulation\n}\n\nexport function createDefaultVisualState(): HorrorVisualState {\n  return {\n    frostIntensity: 0,\n    darknessBoost: 0,\n    screenShake: 0,\n    chromaticAberration: 0,\n    vignetteIntensity: 0.3,\n    flickeringLightIndex: -1,\n    flickerIntensity: 0,\n    bloodPositions: [],\n    ghostEntity: null,\n    doorState: { frontOpen: false, backOpen: false },\n    timeGlitchActive: false,\n    storeMutateOffset: { x: 0, y: 0 },\n    whisperActive: false,\n    stalkerPosition: null,\n    cctvGlitchActive: false,\n    corridorStretch: 0,\n    radioDistortion: 0,\n    mirrorActive: false,\n    mirrorFlipX: false,\n    heComesActive: false,\n    heComesProgress: 0,\n    finalChoiceActive: false,\n    ambientFear: 0,\n    recentHighFearCount: 0,\n  };\n}\n\n// --- Manager ---\n\nexport class HorrorEventManager {\n  private activeEvents: HorrorEventInstance[] = [];\n  private cooldowns: Map<HorrorEventType, number> = new Map();\n  private visual: HorrorVisualState = createDefaultVisualState();\n  private checkInterval = 5000; // check every 5 seconds\n  private checkTimer = 0;\n  private dayAccumulatedSanityCost = 0;\n  private maxSanityCostPerNight = 40;\n  private eventCounter = 0;\n  private maxConcurrentEvents = 3;\n\n  // Callbacks\n  onEventTrigger?: (event: HorrorEventInstance) => void;\n  onSanityChange?: (delta: number) => void;\n  onNotification?: (text: string) => void;\n\n  get visuals(): HorrorVisualState { return this.visual; }\n  get activeEventCount(): number { return this.activeEvents.length; }\n\n  update(dt: number, day: number, phase: GamePhase, timeOfDay: number, sanity: number): HorrorVisualState {\n    const dtSec = dt / 1000;\n\n    // Update cooldowns\n    for (const [type, cd] of this.cooldowns) {\n      if (cd > 0) this.cooldowns.set(type, Math.max(0, cd - dtSec));\n    }\n\n    // Check for new events only at night\n    if (isNightTime(phase) && this.activeEvents.length < this.maxConcurrentEvents) {\n      this.checkTimer += dt;\n      if (this.checkTimer >= this.checkInterval) {\n        this.checkTimer = 0;\n        this.tryTriggerEvents(day, phase, sanity);\n      }\n    }\n\n    // Update active events\n    this.updateActiveEvents(dt);\n\n    // Decay visual effects toward baseline\n    this.decayVisuals(dtSec);\n\n    // Calculate ambient fear\n    this.updateAmbientFear(day, phase, timeOfDay);\n\n    return this.visual;\n  }\n\n  private tryTriggerEvents(day: number, phase: GamePhase, sanity: number): void {\n    for (const def of EVENT_DEFS) {\n      if (this.activeEvents.length >= this.maxConcurrentEvents) break;\n      if (this.activeEvents.some(e => e.type === def.type)) continue;\n      if (day < def.minDay || day > def.maxDay) continue;\n      if (!def.phaseRequired.includes(phase)) continue;\n\n      const cd = this.cooldowns.get(def.type) ?? 0;\n      if (cd > 0) continue;\n\n      // Fear regulation: reduce probability if recent high fear\n      let probabilityMod = 1;\n      if (this.visual.recentHighFearCount >= 2 && def.level >= HorrorLevel.THREAT) {\n        probabilityMod = 0.2; // big reduction after consecutive high fear\n      }\n\n      // Sanity affects: lower sanity = slightly less events (overwhelmed player)\n      if (sanity < 30) probabilityMod *= 0.5;\n\n      // Night depth increases probability\n      const nightDepth = phase === GamePhase.DANGER ? 1.5 : 1;\n      probabilityMod *= nightDepth;\n\n      // Day progression increases probability\n      const dayProgress = Math.min(day / 15, 2);\n      probabilityMod *= dayProgress;\n\n      const roll = Math.random();\n      if (roll < def.baseProbability * probabilityMod) {\n        this.triggerEvent(def);\n      }\n    }\n  }\n\n  private triggerEvent(def: HorrorEventDef): void {\n    const id = `horror_${++this.eventCounter}_${Date.now()}`;\n    const event: HorrorEventInstance = {\n      id,\n      type: def.type,\n      level: def.level,\n      state: HorrorEventState.BUILDUP,\n      timer: 0,\n      duration: def.minActiveDuration + Math.random() * (def.maxActiveDuration - def.minActiveDuration),\n      buildupDuration: def.buildupDuration,\n      resolveDuration: def.resolveDuration,\n      data: {},\n      sanityCost: def.sanityCost,\n    };\n\n    // Randomize specific data\n    event.data = this.generateEventData(def);\n\n    this.activeEvents.push(event);\n    this.cooldowns.set(def.type, def.cooldownSec);\n\n    if (def.level >= HorrorLevel.THREAT) {\n      this.visual.recentHighFearCount++;\n    }\n\n    this.onEventTrigger?.(event);\n    this.onNotification?.(`⚠ ${def.description}`);\n  }\n\n  private generateEventData(def: HorrorEventDef): Record<string, unknown> {\n    switch (def.type) {\n      case HorrorEventType.SHELF_SHIFT:\n        return { shelfIndex: Math.floor(Math.random() * 5) };\n      case HorrorEventType.LIGHT_FLICKER:\n        return { lightIndex: Math.floor(Math.random() * 8) };\n      case HorrorEventType.REGISTER_ANOMALY:\n        return { registerIndex: Math.floor(Math.random() * 2), anomalyAmount: Math.floor(Math.random() * 9999) };\n      case HorrorEventType.BLOOD_ON_SHELF: {\n        const positions = [];\n        const count = 2 + Math.floor(Math.random() * 4);\n        for (let i = 0; i < count; i++) {\n          positions.push({\n            x: 100 + Math.random() * 600,\n            y: 100 + Math.random() * 400,\n            size: 8 + Math.random() * 20,\n            alpha: 0.3 + Math.random() * 0.5,\n          });\n        }\n        return { positions };\n      }\n      case HorrorEventType.GHOST_CUSTOMER:\n        return { startX: Math.random() * 400 + 100, startY: 50, opacity: 0 };\n      case HorrorEventType.DUPLICATE_CUSTOMER:\n        return { x1: 200 + Math.random() * 200, x2: 400 + Math.random() * 200, y: 200 + Math.random() * 100 };\n      case HorrorEventType.NONPAYING_CUSTOMER:\n        return { x: 300 + Math.random() * 200, y: 150 + Math.random() * 100 };\n      case HorrorEventType.DOOR_AUTO_OPEN:\n        return { door: Math.random() < 0.5 ? 'front' : 'back' };\n      case HorrorEventType.STALKER:\n        return { startX: 400 + Math.random() * 200, startY: 200, distance: 300 + Math.random() * 200, checkCount: 0 };\n      case HorrorEventType.CCTV_DOUBLE:\n        return { glitchX: 200 + Math.random() * 400, glitchY: 100 + Math.random() * 200 };\n      case HorrorEventType.CORRIDOR_EXTEND:\n        return { extraDoors: 1 + Math.floor(Math.random() * 2), stretchAmount: 1.5 + Math.random() };\n      case HorrorEventType.RADIO_VOICE:\n        return { frequency: 88 + Math.random() * 20, voiceType: Math.floor(Math.random() * 3) };\n      case HorrorEventType.MIRROR_STORE:\n        return { flipAxis: 'x' as const };\n      case HorrorEventType.HE_COMES:\n        return { startX: 450, startY: 24 * 32, speed: 0.7 + Math.random() * 0.3 };\n      case HorrorEventType.FINAL_CHOICE:\n        return { choiceType: Math.floor(Math.random() * 3) };\n      default:\n        return {};\n    }\n  }\n\n  private updateActiveEvents(dt: number): void {\n    const completed: string[] = [];\n\n    for (const event of this.activeEvents) {\n      event.timer += dt;\n\n      switch (event.state) {\n        case HorrorEventState.BUILDUP:\n          this.applyBuildupEffect(event, event.timer / event.buildupDuration);\n          if (event.timer >= event.buildupDuration) {\n            event.state = HorrorEventState.ACTIVE;\n            event.timer = 0;\n            this.applyActiveEffect(event);\n            this.onSanityChange?.(-event.sanityCost);\n            this.dayAccumulatedSanityCost += event.sanityCost;\n          }\n          break;\n\n        case HorrorEventState.ACTIVE:\n          this.sustainActiveEffect(event, event.timer / event.duration);\n          if (event.timer >= event.duration) {\n            event.state = HorrorEventState.RESOLVING;\n            event.timer = 0;\n            this.beginResolve(event);\n          }\n          break;\n\n        case HorrorEventState.RESOLVING:\n          this.applyResolveEffect(event, event.timer / event.resolveDuration);\n          if (event.timer >= event.resolveDuration) {\n            event.state = HorrorEventState.COMPLETE;\n            completed.push(event.id);\n            this.clearEventEffects(event);\n          }\n          break;\n      }\n    }\n\n    for (const id of completed) {\n      this.activeEvents = this.activeEvents.filter(e => e.id !== id);\n    }\n  }\n\n  // --- Buildup Effects (预兆) ---\n\n  private applyBuildupEffect(event: HorrorEventInstance, progress: number): void {\n    const p = Math.min(1, progress);\n    switch (event.type) {\n      case HorrorEventType.LIGHT_FLICKER:\n        this.visual.flickeringLightIndex = (event.data.lightIndex as number) ?? 0;\n        this.visual.flickerIntensity = p * 0.3;\n        break;\n      case HorrorEventType.TEMP_DROP:\n        this.visual.frostIntensity = p * 0.2;\n        break;\n      case HorrorEventType.BLOOD_ON_SHELF:\n        this.visual.darknessBoost = p * 0.1;\n        break;\n      case HorrorEventType.WHISPER:\n        this.visual.whisperActive = true;\n        break;\n      case HorrorEventType.GHOST_CUSTOMER:\n      case HorrorEventType.DUPLICATE_CUSTOMER:\n      case HorrorEventType.NONPAYING_CUSTOMER:\n        this.visual.vignetteIntensity = Math.min(1, 0.3 + p * 0.3);\n        break;\n      case HorrorEventType.DOOR_AUTO_OPEN:\n        this.visual.screenShake = p * 0.3;\n        break;\n      case HorrorEventType.STALKER:\n        this.visual.vignetteIntensity = Math.min(1, 0.3 + p * 0.4);\n        break;\n      case HorrorEventType.CCTV_DOUBLE:\n        this.visual.chromaticAberration = p * 0.2;\n        break;\n      case HorrorEventType.CORRIDOR_EXTEND:\n        this.visual.corridorStretch = p * 0.3;\n        break;\n      case HorrorEventType.RADIO_VOICE:\n        this.visual.radioDistortion = p * 0.3;\n        break;\n      case HorrorEventType.MIRROR_STORE:\n        this.visual.chromaticAberration = p * 0.4;\n        break;\n      case HorrorEventType.HE_COMES:\n        this.visual.vignetteIntensity = Math.min(1, 0.4 + p * 0.5);\n        this.visual.darknessBoost = p * 0.2;\n        break;\n      case HorrorEventType.FINAL_CHOICE:\n        this.visual.chromaticAberration = p * 0.5;\n        this.visual.vignetteIntensity = Math.min(1, 0.5 + p * 0.5);\n        break;\n      case HorrorEventType.STORE_MUTATE:\n        this.visual.chromaticAberration = p * 0.3;\n        break;\n      default:\n        this.visual.darknessBoost = p * 0.05;\n        break;\n    }\n  }\n\n  // --- Active Effects ---\n\n  private applyActiveEffect(event: HorrorEventInstance): void {\n    switch (event.type) {\n      case HorrorEventType.LIGHT_FLICKER:\n        this.visual.flickerIntensity = 0.8;\n        break;\n      case HorrorEventType.TEMP_DROP:\n        this.visual.frostIntensity = 0.6;\n        this.visual.vignetteIntensity = 0.7;\n        break;\n      case HorrorEventType.FRIDGE_NOISE:\n        this.visual.screenShake = 0.5;\n        break;\n      case HorrorEventType.BLOOD_ON_SHELF:\n        this.visual.bloodPositions = (event.data.positions as Array<{ x: number; y: number; size: number; alpha: number }>) ?? [];\n        break;\n      case HorrorEventType.GHOST_CUSTOMER:\n        this.visual.ghostEntity = {\n          active: true,\n          x: (event.data.startX as number) ?? 300,\n          y: (event.data.startY as number) ?? 50,\n          opacity: 0.4,\n          type: 'ghost_customer',\n        };\n        break;\n      case HorrorEventType.DUPLICATE_CUSTOMER:\n        this.visual.ghostEntity = {\n          active: true,\n          x: (event.data.x1 as number) ?? 200,\n          y: (event.data.y as number) ?? 200,\n          opacity: 0.8,\n          type: 'duplicate',\n        };\n        break;\n      case HorrorEventType.NONPAYING_CUSTOMER:\n        this.visual.ghostEntity = {\n          active: true,\n          x: (event.data.x as number) ?? 300,\n          y: (event.data.y as number) ?? 150,\n          opacity: 0.9,\n          type: 'nonpaying',\n        };\n        break;\n      case HorrorEventType.DOOR_AUTO_OPEN:\n        if ((event.data.door as string) === 'front') {\n          this.visual.doorState.frontOpen = true;\n        } else {\n          this.visual.doorState.backOpen = true;\n        }\n        this.visual.darknessBoost = 0.3;\n        this.visual.screenShake = 0.8;\n        break;\n      case HorrorEventType.WHISPER:\n        this.visual.whisperActive = true;\n        this.visual.vignetteIntensity = 0.8;\n        break;\n      case HorrorEventType.STORE_MUTATE:\n        this.visual.storeMutateOffset = { x: (Math.random() - 0.5) * 10, y: (Math.random() - 0.5) * 10 };\n        this.visual.chromaticAberration = 0.8;\n        this.visual.screenShake = 0.4;\n        break;\n      case HorrorEventType.TIME_GLITCH:\n        this.visual.timeGlitchActive = true;\n        this.visual.chromaticAberration = 0.6;\n        break;\n      case HorrorEventType.STALKER:\n        this.visual.stalkerPosition = {\n          x: (event.data.startX as number) ?? 400,\n          y: (event.data.startY as number) ?? 200,\n          distance: (event.data.distance as number) ?? 300,\n        };\n        this.visual.vignetteIntensity = 0.8;\n        break;\n      case HorrorEventType.CCTV_DOUBLE:\n        this.visual.cctvGlitchActive = true;\n        this.visual.chromaticAberration = 0.5;\n        this.visual.screenShake = 0.3;\n        break;\n      case HorrorEventType.CORRIDOR_EXTEND:\n        this.visual.corridorStretch = 1;\n        this.visual.darknessBoost = 0.3;\n        this.visual.screenShake = 0.2;\n        break;\n      case HorrorEventType.RADIO_VOICE:\n        this.visual.radioDistortion = 1;\n        this.visual.whisperActive = true;\n        break;\n      case HorrorEventType.MIRROR_STORE:\n        this.visual.mirrorActive = true;\n        this.visual.mirrorFlipX = true;\n        this.visual.chromaticAberration = 0.8;\n        this.visual.screenShake = 0.4;\n        break;\n      case HorrorEventType.HE_COMES:\n        this.visual.heComesActive = true;\n        this.visual.heComesProgress = 0;\n        this.visual.darknessBoost = 0.5;\n        this.visual.vignetteIntensity = 1;\n        this.visual.screenShake = 0.6;\n        break;\n      case HorrorEventType.FINAL_CHOICE:\n        this.visual.finalChoiceActive = true;\n        this.visual.chromaticAberration = 1;\n        this.visual.vignetteIntensity = 1;\n        break;\n      default:\n        this.visual.darknessBoost = 0.15;\n        break;\n    }\n  }\n\n  private sustainActiveEffect(event: HorrorEventInstance, progress: number): void {\n    // Pulsing effects during sustain\n    const pulse = Math.sin(progress * Math.PI * 4) * 0.5 + 0.5;\n\n    switch (event.type) {\n      case HorrorEventType.LIGHT_FLICKER:\n        this.visual.flickerIntensity = 0.4 + pulse * 0.5;\n        break;\n      case HorrorEventType.FRIDGE_NOISE:\n        this.visual.screenShake = 0.2 + pulse * 0.3;\n        break;\n      case HorrorEventType.GHOST_CUSTOMER:\n        if (this.visual.ghostEntity) {\n          this.visual.ghostEntity.opacity = 0.2 + pulse * 0.4;\n          this.visual.ghostEntity.y += 0.1;\n        }\n        break;\n      case HorrorEventType.STORE_MUTATE: {\n        const t = performance.now() * 0.001;\n        this.visual.storeMutateOffset = {\n          x: Math.sin(t * 0.5) * 8,\n          y: Math.cos(t * 0.7) * 5,\n        };\n        break;\n      }\n      case HorrorEventType.TIME_GLITCH:\n        this.visual.chromaticAberration = 0.3 + pulse * 0.5;\n        break;\n      case HorrorEventType.STALKER:\n        if (this.visual.stalkerPosition) {\n          this.visual.stalkerPosition.distance = Math.max(50, (this.visual.stalkerPosition.distance ?? 300) - 0.5);\n        }\n        break;\n      case HorrorEventType.CCTV_DOUBLE:\n        this.visual.chromaticAberration = 0.3 + pulse * 0.4;\n        break;\n      case HorrorEventType.CORRIDOR_EXTEND:\n        this.visual.corridorStretch = 0.8 + pulse * 0.2;\n        break;\n      case HorrorEventType.HE_COMES:\n        this.visual.heComesProgress = Math.min(1, progress);\n        this.visual.darknessBoost = 0.3 + progress * 0.4;\n        this.visual.screenShake = 0.3 + progress * 0.5;\n        break;\n      case HorrorEventType.FINAL_CHOICE:\n        this.visual.chromaticAberration = 0.5 + pulse * 0.5;\n        break;\n      default:\n        break;\n    }\n  }\n\n  // --- Resolve Effects ---\n\n  private beginResolve(event: HorrorEventInstance): void {\n    switch (event.type) {\n      case HorrorEventType.FRIDGE_NOISE:\n        // Sudden silence is scarier\n        this.visual.screenShake = 0;\n        break;\n      default:\n        break;\n    }\n  }\n\n  private applyResolveEffect(event: HorrorEventInstance, progress: number): void {\n    const p = Math.min(1, progress);\n    switch (event.type) {\n      case HorrorEventType.TEMP_DROP:\n        this.visual.frostIntensity *= (1 - p);\n        break;\n      case HorrorEventType.LIGHT_FLICKER:\n        this.visual.flickerIntensity *= (1 - p);\n        if (p >= 1) this.visual.flickeringLightIndex = -1;\n        break;\n      case HorrorEventType.BLOOD_ON_SHELF:\n        this.visual.bloodPositions = this.visual.bloodPositions.map(b => ({\n          ...b, alpha: b.alpha * (1 - p),\n        }));\n        break;\n      case HorrorEventType.GHOST_CUSTOMER:\n      case HorrorEventType.DUPLICATE_CUSTOMER:\n      case HorrorEventType.NONPAYING_CUSTOMER:\n        if (this.visual.ghostEntity) {\n          this.visual.ghostEntity.opacity *= (1 - p);\n        }\n        break;\n      case HorrorEventType.DOOR_AUTO_OPEN:\n        this.visual.doorState.frontOpen = false;\n        this.visual.doorState.backOpen = false;\n        this.visual.darknessBoost *= (1 - p);\n        break;\n      case HorrorEventType.STORE_MUTATE:\n        this.visual.storeMutateOffset.x *= (1 - p);\n        this.visual.storeMutateOffset.y *= (1 - p);\n        this.visual.chromaticAberration *= (1 - p);\n        break;\n      case HorrorEventType.TIME_GLITCH:\n        if (p >= 0.8) this.visual.timeGlitchActive = false;\n        this.visual.chromaticAberration *= (1 - p);\n        break;\n      case HorrorEventType.STALKER:\n        if (this.visual.stalkerPosition) {\n          this.visual.stalkerPosition.distance *= (1 - p * 0.5);\n        }\n        if (p >= 1) this.visual.stalkerPosition = null;\n        break;\n      case HorrorEventType.CCTV_DOUBLE:\n        this.visual.chromaticAberration *= (1 - p);\n        if (p >= 1) this.visual.cctvGlitchActive = false;\n        break;\n      case HorrorEventType.CORRIDOR_EXTEND:\n        this.visual.corridorStretch *= (1 - p);\n        break;\n      case HorrorEventType.RADIO_VOICE:\n        this.visual.radioDistortion *= (1 - p);\n        if (p >= 0.5) this.visual.whisperActive = false;\n        break;\n      case HorrorEventType.MIRROR_STORE:\n        this.visual.chromaticAberration *= (1 - p);\n        if (p >= 1) {\n          this.visual.mirrorActive = false;\n          this.visual.mirrorFlipX = false;\n        }\n        break;\n      case HorrorEventType.HE_COMES:\n        this.visual.darknessBoost *= (1 - p);\n        this.visual.screenShake *= (1 - p);\n        if (p >= 1) {\n          this.visual.heComesActive = false;\n          this.visual.heComesProgress = 0;\n        }\n        break;\n      case HorrorEventType.FINAL_CHOICE:\n        this.visual.chromaticAberration *= (1 - p);\n        if (p >= 1) this.visual.finalChoiceActive = false;\n        break;\n      default:\n        break;\n    }\n  }\n\n  private clearEventEffects(event: HorrorEventInstance): void {\n    switch (event.type) {\n      case HorrorEventType.GHOST_CUSTOMER:\n      case HorrorEventType.DUPLICATE_CUSTOMER:\n      case HorrorEventType.NONPAYING_CUSTOMER:\n        this.visual.ghostEntity = null;\n        break;\n      case HorrorEventType.BLOOD_ON_SHELF:\n        this.visual.bloodPositions = [];\n        break;\n      case HorrorEventType.WHISPER:\n        this.visual.whisperActive = false;\n        break;\n      case HorrorEventType.TIME_GLITCH:\n        this.visual.timeGlitchActive = false;\n        break;\n      case HorrorEventType.STALKER:\n        this.visual.stalkerPosition = null;\n        break;\n      case HorrorEventType.CCTV_DOUBLE:\n        this.visual.cctvGlitchActive = false;\n        break;\n      case HorrorEventType.CORRIDOR_EXTEND:\n        this.visual.corridorStretch = 0;\n        break;\n      case HorrorEventType.RADIO_VOICE:\n        this.visual.radioDistortion = 0;\n        this.visual.whisperActive = false;\n        break;\n      case HorrorEventType.MIRROR_STORE:\n        this.visual.mirrorActive = false;\n        this.visual.mirrorFlipX = false;\n        break;\n      case HorrorEventType.HE_COMES:\n        this.visual.heComesActive = false;\n        this.visual.heComesProgress = 0;\n        break;\n      case HorrorEventType.FINAL_CHOICE:\n        this.visual.finalChoiceActive = false;\n        break;\n      default:\n        break;\n    }\n  }\n\n  private decayVisuals(dtSec: number): void {\n    const decay = dtSec * 0.5;\n    this.visual.screenShake = Math.max(0, this.visual.screenShake - decay);\n    this.visual.darknessBoost = Math.max(0, this.visual.darknessBoost - decay * 0.1);\n    if (this.visual.flickeringLightIndex === -1) {\n      this.visual.flickerIntensity = Math.max(0, this.visual.flickerIntensity - decay * 0.2);\n    }\n  }\n\n  private updateAmbientFear(day: number, phase: GamePhase, timeOfDay: number): void {\n    let target = 0;\n\n    if (isNightTime(phase)) {\n      target = 0.3;\n      if (phase === GamePhase.NIGHT) target = 0.5;\n      if (phase === GamePhase.DANGER) target = 0.8;\n\n      // Day progression\n      target *= Math.min(1 + (day - 1) * 0.05, 2);\n\n      // Active events boost fear\n      target += this.activeEvents.length * 0.1;\n    }\n\n    this.visual.ambientFear += (target - this.visual.ambientFear) * 0.02;\n  }\n\n  // --- Public API ---\n\n  /** Reset daily state when new day begins */\n  resetDaily(): void {\n    this.dayAccumulatedSanityCost = 0;\n    this.visual.recentHighFearCount = 0;\n    this.activeEvents = [];\n    this.visual = createDefaultVisualState();\n  }\n\n  /** Get the maximum event level available for current day */\n  getMaxLevel(day: number): HorrorLevel {\n    if (day >= 26) return HorrorLevel.EXISTENTIAL;\n    if (day >= 16) return HorrorLevel.THREAT;\n    if (day >= 6) return HorrorLevel.ENTITY;\n    return HorrorLevel.ENVIRONMENT;\n  }\n\n  /** Get active events for display */\n  getActiveEvents(): ReadonlyArray<HorrorEventInstance> {\n    return this.activeEvents;\n  }\n\n  /** Get save data */\n  getSaveData(): Record<string, unknown> {\n    return {\n      eventCounter: this.eventCounter,\n      dayAccumulatedSanityCost: this.dayAccumulatedSanityCost,\n    };\n  }\n\n  /** Load save data */\n  loadSaveData(data: Record<string, unknown>): void {\n    this.eventCounter = (data.eventCounter as number) ?? 0;\n    this.dayAccumulatedSanityCost = (data.dayAccumulatedSanityCost as number) ?? 0;\n  }\n}\n","numLines":1033,"startLine":1,"totalLines":1033}}}
