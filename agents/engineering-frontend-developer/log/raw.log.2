{"type":"assistant","message":{"id":"msg_202605230532035915b2a7083e40b0","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_40335a552afb4f689d54b3b6","name":"Write","input":{"file_path":"D:/game-projects/douyin-match3/src/js/ScoreSystem.js","content":"// ScoreSystem.js — Score, moves, goals (score/collect_color/clear_obstacle/boss/dual), stars\n\nclass ScoreSystem {\n  constructor() {\n    this.score = 0;\n    this.moves = 0;\n    this.maxMoves = 30;\n    this.goalType = 'score';\n    this.goalTarget = 1000;\n    this.goalProgress = 0;\n    this.level = 1;\n    this.stars = [0, 0, 0];\n    this.collected = {};\n    this.obstaclesCleared = {};\n    this.totalObstaclesCleared = 0;\n    this.chainCount = 0;\n    this.config = null;\n\n    // Dual goal support\n    this.dualGoals = [];\n\n    // Collect_color specifics\n    this.collectColors = [];\n\n    // Clear_obstacle specifics\n    this.clearObstacleType = 0;\n\n    this.onScoreChange = null;\n    this.onMovesChange = null;\n    this.onLevelComplete = null;\n    this.onLevelFail = null;\n  }\n\n  reset(level = 1) {\n    this.score = 0;\n    this.moves = 0;\n    this.goalProgress = 0;\n    this.chainCount = 0;\n    this.collected = {};\n    this.obstaclesCleared = {};\n    this.totalObstaclesCleared = 0;\n    this.dualGoals = [];\n    this.collectColors = [];\n    this.clearObstacleType = 0;\n    this.level = level;\n  }\n\n  configure(config) {\n    this.config = config;\n    this.maxMoves = config.moves || 30;\n    this.goalType = config.goal?.type || 'score';\n    this.goalTarget = config.goal?.target || 1000;\n    this.stars = config.stars || [1000, 1500, 2000];\n\n    if (this.goalType === 'collect_color') {\n      this.collectColors = config.goal?.colors || [];\n    } else if (this.goalType === 'clear_obstacle') {\n      this.clearObstacleType = config.goal?.obstacleType || 0;\n    } else if (this.goalType === 'dual') {\n      this.dualGoals = (config.goal?.goals || []).map(g => ({\n        type: g.type,\n        target: g.target,\n        progress: 0,\n        colors: g.colors || [],\n        obstacleType: g.obstacleType || 0,\n      }));\n    }\n  }\n\n  useMove() {\n    this.moves++;\n    if (this.onMovesChange) this.onMovesChange(this.getRemainingMoves());\n    return this.getRemainingMoves() >= 0;\n  }\n\n  getRemainingMoves() {\n    return this.maxMoves - this.moves;\n  }\n\n  addScore(points) {\n    this.score += points;\n    if (this.goalType === 'score') {\n      this.goalProgress = this.score;\n    }\n    // Update dual score goals\n    for (const dg of this.dualGoals) {\n      if (dg.type === 'score') dg.progress = this.score;\n    }\n    if (this.onScoreChange) this.onScoreChange(this.score);\n  }\n\n  addChainScore(basePoints, chainLevel) {\n    const multiplier = chainLevel <= 1 ? 1 : chainLevel === 2 ? 1.5 : chainLevel === 3 ? 2.0 : 2.5;\n    const points = Math.floor(basePoints * multiplier);\n    this.addScore(points);\n    this.chainCount = Math.max(this.chainCount, chainLevel);\n    return points;\n  }\n\n  addCollected(color, count) {\n    this.collected[color] = (this.collected[color] || 0) + count;\n    this._updateCollectProgress();\n  }\n\n  _updateCollectProgress() {\n    if (this.goalType === 'collect_color') {\n      let total = 0;\n      for (const c of this.collectColors) {\n        total += this.collected[c] || 0;\n      }\n      this.goalProgress = total;\n    }\n    for (const dg of this.dualGoals) {\n      if (dg.type === 'collect_color') {\n        let total = 0;\n        for (const c of dg.colors) {\n          total += this.collected[c] || 0;\n        }\n        dg.progress = total;\n      }\n    }\n  }\n\n  addObstacleCleared(type) {\n    if (!this.obstaclesCleared[type]) this.obstaclesCleared[type] = 0;\n    this.obstaclesCleared[type]++;\n    this.totalObstaclesCleared++;\n    this._updateClearProgress();\n  }\n\n  _updateClearProgress() {\n    if (this.goalType === 'clear_obstacle') {\n      if (this.clearObstacleType === 0) {\n        this.goalProgress = this.totalObstaclesCleared;\n      } else {\n        this.goalProgress = this.obstaclesCleared[this.clearObstacleType] || 0;\n      }\n    }\n    for (const dg of this.dualGoals) {\n      if (dg.type === 'clear_obstacle') {\n        if (dg.obstacleType === 0) {\n          dg.progress = this.totalObstaclesCleared;\n        } else {\n          dg.progress = this.obstaclesCleared[dg.obstacleType] || 0;\n        }\n      }\n    }\n  }\n\n  getStarCount() {\n    if (this.score >= this.stars[2]) return 3;\n    if (this.score >= this.stars[1]) return 2;\n    if (this.score >= this.stars[0]) return 1;\n    return 0;\n  }\n\n  isGoalComplete() {\n    switch (this.goalType) {\n      case 'score':\n        return this.score >= this.goalTarget;\n      case 'collect_color':\n        return this.goalProgress >= this.goalTarget;\n      case 'clear_obstacle':\n        return this.goalProgress >= this.goalTarget;\n      case 'boss':\n        return false; // Handled externally\n      case 'dual':\n        return this.dualGoals.every(g => g.progress >= g.target);\n      default:\n        return false;\n    }\n  }\n\n  isBossDefeated() {\n    return this.goalType === 'boss';\n  }\n\n  isGameOver() {\n    return this.getRemainingMoves() <= 0 && !this.isGoalComplete();\n  }\n\n  getGoalDescription() {\n    switch (this.goalType) {\n      case 'score':\n        return `分数 ${this.goalProgress}/${this.goalTarget}`;\n      case 'collect_color': {\n        const names = this.collectColors.map(c => COLOR_MAP[c]?.label || '?').join('+');\n        return `收集${names} ${this.goalProgress}/${this.goalTarget}`;\n      }\n      case 'clear_obstacle': {\n        const label = this.clearObstacleType === 1 ? '冰块' :\n                      this.clearObstacleType === 2 ? '锁链' :\n                      this.clearObstacleType === 3 ? '巧克力' : '障碍';\n        return `清除${label} ${this.goalProgress}/${this.goalTarget}`;\n      }\n      case 'boss':\n        return '击败Boss';\n      case 'dual':\n        return this.dualGoals.map(g => {\n          if (g.type === 'score') return `分数 ${this.score}/${g.target}`;\n          if (g.type === 'collect_color') {\n            const names = g.colors.map(c => COLOR_MAP[c]?.label || '?').join('+');\n            return `收集${names} ${g.progress}/${g.target}`;\n          }\n          if (g.type === 'clear_obstacle') return `清除障碍 ${g.progress}/${g.target}`;\n          return '';\n        }).join(' | ');\n      default:\n        return '';\n    }\n  }\n\n  getProgressForUI() {\n    if (this.goalType === 'dual') {\n      return this.dualGoals.map(g => ({\n        label: g.type === 'score' ? '分数' :\n               g.type === 'collect_color' ? '收集' : '清除',\n        current: g.progress,\n        target: g.target,\n      }));\n    }\n    return [{ label: '', current: this.goalProgress, target: this.goalTarget }];\n  }\n\n  checkState() {\n    if (this.isGoalComplete()) {\n      if (this.onLevelComplete) this.onLevelComplete(this.score, this.getStarCount());\n      return 'complete';\n    }\n    if (this.isGameOver()) {\n      if (this.onLevelFail) this.onLevelFail(this.score);\n      return 'fail';\n    }\n    return 'playing';\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { ScoreSystem };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"4fc1920c-0b5c-4266-b43d-05c38f749fa3","uuid":"9969210e-17d0-42de-8e14-aae92d1020d6"}
