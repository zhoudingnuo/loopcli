,\n): PuppetInstance {\n  return {\n    uid,\n    gridX,\n    gridY,\n    level,\n    rules: [...DEFAULT_RULES],\n    heldItem: null,\n    state: 'idle',\n    actionProgress: 0,\n    actionSpeed: 3000, // 3 seconds per action\n  };\n}\n\n// Get sorting rule for a resource type\nexport function getRuleForResource(puppet: PuppetInstance, resourceType: string): PuppetRule | undefined {\n  return puppet.rules\n    .filter(r => r.resourceType === resourceType)\n    .sort((a, b) => a.priority - b.priority)[0];\n}\n\n// Add or update a routing rule\nexport function setRule(\n  puppet: PuppetInstance,\n  resourceType: string,\n  targetDx: number,\n  targetDy: number,\n  priority: number = 0,\n): PuppetInstance {\n  const existing = puppet.rules.findIndex(r => r.resourceType === resourceType);\n  const newRule: PuppetRule = { resourceType, targetDx, targetDy, priority };\n\n  const newRules = [...puppet.rules];\n  if (existing >= 0) {\n    newRules[existing] = newRule;\n  } else {\n    newRules.push(newRule);\n  }\n\n  return { ...puppet, rules: newRules };\n}\n\n// Puppet picks up an item from an adjacent source\nexport function puppetPickup(\n  puppet: PuppetInstance,\n  resource: string,\n  amount: number,\n): PuppetInstance {\n  return {\n    ...puppet,\n    heldItem: { resource, amount },\n    state: 'delivering',\n    actionProgress: 0,\n  };\n}\n\n// Puppet delivers held item — returns the delivery info and cleared puppet\nexport function puppetDeliver(puppet: PuppetInstance): {\n  puppet: PuppetInstance;\n  delivery: { resource: string; amount: number; targetDx: number; targetDy: number } | null;\n} {\n  if (!puppet.heldItem) {\n    return { puppet: { ...puppet, state: 'idle' }, delivery: null };\n  }\n\n  const rule = getRuleForResource(puppet, puppet.heldItem.resource);\n  const delivery = rule\n    ? {\n        resource: puppet.heldItem.resource,\n        amount: puppet.heldItem.amount,\n        targetDx: rule.targetDx,\n        targetDy: rule.targetDy,\n      }\n    : null;\n\n  return {\n    puppet: {\n      ...puppet,\n      heldItem: null,\n      state: 'idle',\n      actionProgress: 0,\n    },\n    delivery,\n  };\n}\n\n// Tick puppet progress\nexport function tickPuppet(\n  puppet: PuppetInstance,\n  dtMs: number,\n): PuppetInstance {\n  if (puppet.state === 'idle') return puppet;\n\n  const progress = puppet.actionProgress + dtMs / puppet.actionSpeed;\n  if (progress >= 1) {\n    // Action complete\n    return { ...puppet, actionProgress: 1 };\n  }\n  return { ...puppet, actionProgress: progress };\n}\n\n// Render a puppet on canvas\nexport function renderPuppet(\n  ctx: CanvasRenderingContext2D,\n  puppet: PuppetInstance,\n  offsetX: number,\n  offsetY: number,\n  scale: number,\n  cellSize: number,\n  now: number,\n): void {\n  const x = offsetX + puppet.gridX * cellSize * scale;\n  const y = offsetY + puppet.gridY * cellSize * scale;\n  const s = cellSize * scale;\n\n  // Puppet body\n  const bodyColor = puppet.state === 'idle' ? 'rgba(200,180,100,0.7)' : 'rgba(255,200,50,0.8)';\n  ctx.fillStyle = bodyColor;\n  ctx.beginPath();\n  ctx.arc(x + s / 2, y + s / 2, s * 0.35, 0, Math.PI * 2);\n  ctx.fill();\n\n  // Face icon\n  ctx.fillStyle = '#fff';\n  ctx.font = `${Math.max(10, Math.floor(14 * scale))}px serif`;\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n  ctx.fillText('🤖', x + s / 2, y + s / 2);\n\n  // Level badge\n  ctx.font = `bold ${Math.max(6, Math.floor(8 * scale))}px monospace`;\n  ctx.fillStyle = '#ffd700';\n  ctx.fillText(`Lv${puppet.level}`, x + s / 2, y + s - 4 * scale);\n\n  // Action progress ring\n  if (puppet.state !== 'idle') {\n    ctx.strokeStyle = '#ffd700';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.arc(x + s / 2, y + s / 2, s * 0.4, -Math.PI / 2, -Math.PI / 2 + puppet.actionProgress * Math.PI * 2);\n    ctx.stroke();\n  }\n\n  // Held item indicator\n  if (puppet.heldItem) {\n    const RESOURCE_COLORS: Record<string, string> = {\n      spirit_stone: '#7cc8ff',\n      spirit_grass: '#6adf6a',\n      spirit_iron: '#8a8aaa',\n    };\n    ctx.fillStyle = RESOURCE_COLORS[puppet.heldItem.resource] ?? '#fff';\n    ctx.beginPath();\n    ctx.arc(x + s - 4 * scale, y + 4 * scale, 3 * scale, 0, Math.PI * 2);\n    ctx.fill();\n  }\n}\n","numLines":203,"startLine":1,"totalLines":203}}}
