e.length >= this.maxQueueSize) {\n63\t      this.flush();\n64\t    } else {\n65\t      this.dm.save();\n66\t    }\n67\t\n68\t    // Console log in dev\n69\t    if (!this.isDouyin) {\n70\t      console.log(`[Analytics] ${eventName}`, params || '');\n71\t    }\n72\t  }\n73\t\n74\t  // --- Convenience methods ---\n75\t  trackGameStart() {\n76\t    this.track(ANALYTICS_EVENTS.GAME_START, {\n77\t      version: '1.0',\n78\t      platform: this.isDouyin ? 'douyin' : 'web',\n79\t    });\n80\t  }\n81\t\n82\t  trackLevelStart(levelNum, config) {\n83\t    this.track(ANALYTICS_EVENTS.LEVEL_START, {\n84\t      level: levelNum,\n85\t      moves: config.moves,\n86\t      goalType: config.goal?.type || 'score',\n87\t    });\n88\t  }\n89\t\n90\t  trackLevelComplete(levelNum, score, stars, movesUsed) {\n91\t    this.track(ANALYTICS_EVENTS.LEVEL_COMPLETE, {\n92\t      level: levelNum,\n93\t      score,\n94\t      stars,\n95\t      movesUsed,\n96\t      completionTime: Date.now(),\n97\t    });\n98\t  }\n99\t\n100\t  trackLevelFail(levelNum, score, movesUsed, goalProgress) {\n101\t    this.track(ANALYTICS_EVENTS.LEVEL_FAIL, {\n102\t      level: levelNum,\n103\t      score,\n104\t      movesUsed,\n105\t      goalProgress,\n106\t    });\n107\t  }\n108\t\n109\t  trackAdShow(placement, completed) {\n110\t    this.track(ANALYTICS_EVENTS.AD_SHOW, {\n111\t      placement,\n112\t      completed,\n113\t      adType: placement === AD_PLACEMENTS.INTERSTITIAL ? 'interstitial' : 'rewarded',\n114\t    });\n115\t  }\n116\t\n117\t  trackAdClick(placement) {\n118\t    this.track(ANALYTICS_EVENTS.AD_CLICK, { placement });\n119\t  }\n120\t\n121\t  trackShare(type, level) {\n122\t    this.track(ANALYTICS_EVENTS.SHARE, { type, level });\n123\t  }\n124\t\n125\t  trackSocialPK(result, friendId) {\n126\t    this.track(ANALYTICS_EVENTS.SOCIAL_PK, { result, friendId });\n127\t  }\n128\t\n129\t  trackDailyLogin(day) {\n130\t    this.track(ANALYTICS_EVENTS.DAILY_LOGIN, { day });\n131\t  }\n132\t\n133\t  trackTutorialStep(stepId, level) {\n134\t    this.track(ANALYTICS_EVENTS.TUTORIAL_STEP, { stepId, level });\n135\t  }\n136\t\n137\t  // --- Flush queue ---\n138\t  flush() {\n139\t    if (this.data.queue.length === 0) return;\n140\t\n141\t    const batch = this.data.queue.splice(0, this.maxQueueSize);\n142\t    this.dm.save();\n143\t\n144\t    if (this.isDouyin) {\n145\t      this._uploadToServer(batch);\n146\t    } else {\n147\t      // Dev mode: log batch\n148\t      console.log(`[Analytics] Flush ${batch.length} events`, batch);\n149\t    }\n150\t  }\n151\t\n152\t  _uploadToServer(events) {\n153\t    try {\n154\t      // 抖音云开发 or custom server endpoint\n155\t      const request = tt.request || fetch;\n156\t      if (request) {\n157\t        request({\n158\t          url: 'https://analytics.example.com/events',\n159\t          method: 'POST',\n160\t          data: { events, appId: 'match-and-blast' },\n161\t        }).catch(() => {\n162\t          // Re-queue on failure\n163\t          this.data.queue.unshift(...events);\n164\t          this.dm.save();\n165\t        });\n166\t      }\n167\t    } catch (e) {\n168\t      // Silent fail — analytics never blocks gameplay\n169\t    }\n170\t  }\n171\t\n172\t  // --- Session management ---\n173\t  newSession() {\n174\t    this.data.sessionId = this._genSessionId();\n175\t    this.dm.save();\n176\t  }\n177\t\n178\t  getSessionDuration() {\n179\t    return Date.now() - (this.data.firstLaunch || Date.now());\n180\t  }\n181\t\n182\t  // --- Metrics helpers ---\n183\t  getRetentionInfo() {\n184\t    const first = this.data.firstLaunch;\n185\t    if (!first) return { isD1: false };\n186\t    const daysSince = Math.floor((Date.now() - first) / 86400000);\n187\t    return { isD1: daysSince === 1, daysSince };\n188\t  }\n189\t}\n190\t\n191\tif (typeof module !== 'undefined') module.exports = { Analytics, ANALYTICS_EVENTS };\n192\t"}]},"parent_tool_use_id":null,"session_id":"ec73960d-df44-45f4-a48b-a11bb93a968e","uuid":"bc54b189-a273-4e90-a2e7-22f5564a106f","timestamp":"2026-05-22T22:43:36.762Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\douyin-match3\\src\\js\\Analytics.js","content":"// Analytics.js — Data tracking: level events, ad events, social events, batch queue\n\nconst ANALYTICS_EVENTS = {\n  GAME_START: 'game_start',\n  TUTORIAL_STEP: 'tutorial_step',\n  LEVEL_START: 'level_start',\n  LEVEL_COMPLETE: 'level_complete',\n  LEVEL_FAIL: 'level_fail',\n  AD_SHOW: 'ad_show',\n  AD_CLICK: 'ad_click',\n  SHARE: 'share',\n  SOCIAL_PK: 'social_pk',\n  PURCHASE: 'purchase',\n  DAILY_LOGIN: 'daily_login',\n  RETENTION_D1: 'retention_d1',\n};\n\nclass Analytics {\n  constructor(dataManager) {\n    this.dm = dataManager;\n    this._initStorage();\n\n    this.isDouyin = typeof tt !== 'undefined';\n    this.flushInterval = 30000; // 30s batch flush\n    this.maxQueueSize = 50;\n    this._flushTimer = null;\n  }\n\n  _initStorage() {\n    if (!this.dm.data.analytics) {\n      this.dm.data.analytics = {\n        userId: this.dm.data.social?.userId || 'u_' + Math.random().toString(36).slice(2, 10),\n        sessionId: this._genSessionId(),\n        queue: [],\n        totalCount: 0,\n        firstLaunch: Date.now(),\n        lastActive: Date.now(),\n      };\n      this.dm.save();\n    }\n    this.data = this.dm.data.analytics;\n  }\n\n  _genSessionId() {\n    return Date.now().toString(36) + Math.random().toString(36).slice(2, 6);\n  }\n\n  // --- Core track method ---\n  track(eventName, params) {\n    const event = {\n      event: eventName,\n      ts: Date.now(),\n      session: this.data.sessionId,\n      uid: this.data.userId,\n      ...(params || {}),\n    };\n\n    this.data.queue.push(event);\n    this.data.totalCount++;\n    this.data.lastActive = Date.now();\n\n    if (this.data.queue.length >= this.maxQueueSize) {\n      this.flush();\n    } else {\n      this.dm.save();\n    }\n\n    // Console log in dev\n    if (!this.isDouyin) {\n      console.log(`[Analytics] ${eventName}`, params || '');\n    }\n  }\n\n  // --- Convenience methods ---\n  trackGameStart() {\n    this.track(ANALYTICS_EVENTS.GAME_START, {\n      version: '1.0',\n      platform: this.isDouyin ? 'douyin' : 'web',\n    });\n  }\n\n  trackLevelStart(levelNum, config) {\n    this.track(ANALYTICS_EVENTS.LEVEL_START, {\n      level: levelNum,\n      moves: config.moves,\n      goalType: config.goal?.type || 'score',\n    });\n  }\n\n  trackLevelComplete(levelNum, score, stars, movesUsed) {\n    this.track(ANALYTICS_EVENTS.LEVEL_COMPLETE, {\n      level: levelNum,\n      score,\n      stars,\n      movesUsed,\n      completionTime: Date.now(),\n    });\n  }\n\n  trackLevelFail(levelNum, score, movesUsed, goalProgress) {\n    this.track(ANALYTICS_EVENTS.LEVEL_FAIL, {\n      level: levelNum,\n      score,\n      movesUsed,\n      goalProgress,\n    });\n  }\n\n  trackAdShow(placement, completed) {\n    this.track(ANALYTICS_EVENTS.AD_SHOW, {\n      placement,\n      completed,\n      adType: placement === AD_PLACEMENTS.INTERSTITIAL ? 'interstitial' : 'rewarded',\n    });\n  }\n\n  trackAdClick(placement) {\n    this.track(ANALYTICS_EVENTS.AD_CLICK, { placement });\n  }\n\n  trackShare(type, level) {\n    this.track(ANALYTICS_EVENTS.SHARE, { type, level });\n  }\n\n  trackSocialPK(result, friendId) {\n    this.track(ANALYTICS_EVENTS.SOCIAL_PK, { result, friendId });\n  }\n\n  trackDailyLogin(day) {\n    this.track(ANALYTICS_EVENTS.DAILY_LOGIN, { day });\n  }\n\n  trackTutorialStep(stepId, level) {\n    this.track(ANALYTICS_EVENTS.TUTORIAL_STEP, { stepId, level });\n  }\n\n  // --- Flush queue ---\n  flush() {\n    if (this.data.queue.length === 0) return;\n\n    const batch = this.data.queue.splice(0, this.maxQueueSize);\n    this.dm.save();\n\n    if (this.isDouyin) {\n      this._uploadToServer(batch);\n    } else {\n      // Dev mode: log batch\n      console.log(`[Analytics] Flush ${batch.length} events`, batch);\n    }\n  }\n\n  _uploadToServer(events) {\n    try {\n      // 抖音云开发 or custom server endpoint\n      const request = tt.request || fetch;\n      if (request) {\n        request({\n          url: 'https://analytics.example.com/events',\n          method: 'POST',\n          data: { events, appId: 'match-and-blast' },\n        }).catch(() => {\n          // Re-queue on failure\n          this.data.queue.unshift(...events);\n          this.dm.save();\n        });\n      }\n    } catch (e) {\n      // Silent fail — analytics never blocks gameplay\n    }\n  }\n\n  // --- Session management ---\n  newSession() {\n    this.data.sessionId = this._genSessionId();\n    this.dm.save();\n  }\n\n  getSessionDuration() {\n    return Date.now() - (this.data.firstLaunch || Date.now());\n  }\n\n  // --- Metrics helpers ---\n  getRetentionInfo() {\n    const first = this.data.firstLaunch;\n    if (!first) return { isD1: false };\n    const daysSince = Math.floor((Date.now() - first) / 86400000);\n    return { isD1: daysSince === 1, daysSince };\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Analytics, ANALYTICS_EVENTS };\n","numLines":192,"startLine":1,"totalLines":192}}}
