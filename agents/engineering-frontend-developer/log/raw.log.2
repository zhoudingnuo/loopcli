w, t.col);\n52\t            game.particles.emitExplosion(pos.x, pos.y, '#88CCFF', 12);\n53\t            game.audio.playObstacleBreak();\n54\t          }\n55\t        }\n56\t        break;\n57\t\n58\t      case 'lucky_special':\n59\t        if (event === 'match_created' && Math.random() < ch.param && params && params.cells) {\n60\t          const cell = params.cells[Math.floor(Math.random() * params.cells.length)];\n61\t          const tile = game.board.getTile(cell.row, cell.col);\n62\t          if (tile && tile.special === SPECIAL_NONE) {\n63\t            tile.special = SPECIAL_STRIPED_H;\n64\t            game.audio.playSpecial();\n65\t          }\n66\t        }\n67\t        break;\n68\t\n69\t      case 'chain_bonus':\n70\t        if (event === 'chain_score' && params && params.chainCount >= 3) {\n71\t          game.scoreSystem.addScore(ch.param);\n72\t        }\n73\t        break;\n74\t    }\n75\t  }\n76\t}\n77\t\n78\tif (typeof module !== 'undefined') module.exports = { CharacterManager };\n79\t"}]},"parent_tool_use_id":null,"session_id":"ec73960d-df44-45f4-a48b-a11bb93a968e","uuid":"195c369a-517d-491e-809d-53df1cb790d6","timestamp":"2026-05-22T22:42:56.523Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\douyin-match3\\src\\js\\Characters.js","content":"// Characters.js — 4 playable characters with unique skills\n\nclass CharacterManager {\n  constructor() {\n    this.characters = [\n      {\n        id: 0, name: '小果', emoji: '🍎', title: '果实精灵',\n        desc: '开局额外+2步',\n        skill: 'extra_moves', param: 2, unlockLevel: 1,\n      },\n      {\n        id: 1, name: '冰冰', emoji: '❄️', title: '冰雪仙子',\n        desc: '每5步自动清除1个障碍',\n        skill: 'auto_obstacle', param: 5, unlockLevel: 5,\n      },\n      {\n        id: 2, name: '星星', emoji: '⭐', title: '幸运星',\n        desc: '消除时15%概率生成条纹炸弹',\n        skill: 'lucky_special', param: 0.15, unlockLevel: 10,\n      },\n      {\n        id: 3, name: '彩虹', emoji: '🌈', title: '彩虹使者',\n        desc: '连锁3+时额外+100分',\n        skill: 'chain_bonus', param: 100, unlockLevel: 15,\n      },\n    ];\n  }\n\n  getAll() { return this.characters; }\n  get(id) { return this.characters[id]; }\n  isUnlocked(id, maxLevel) { return this.characters[id].unlockLevel <= maxLevel; }\n\n  applySkill(charId, game, event, params) {\n    const ch = this.characters[charId];\n    if (!ch) return;\n\n    switch (ch.skill) {\n      case 'extra_moves':\n        if (event === 'level_start') {\n          game.scoreSystem.maxMoves += ch.param;\n        }\n        break;\n\n      case 'auto_obstacle':\n        if (event === 'after_move' && game.moveCount % ch.param === 0) {\n          const obs = game.obstacleMgr.obstacles.filter(o => !o.isDestroyed());\n          if (obs.length > 0) {\n            const t = obs[Math.floor(Math.random() * obs.length)];\n            t.hp = 0;\n            game.scoreSystem.addObstacleCleared(t.type);\n            const pos = game.renderer.getTileCenter(t.row, t.col);\n            game.particles.emitExplosion(pos.x, pos.y, '#88CCFF', 12);\n            game.audio.playObstacleBreak();\n          }\n        }\n        break;\n\n      case 'lucky_special':\n        if (event === 'match_created' && Math.random() < ch.param && params && params.cells) {\n          const cell = params.cells[Math.floor(Math.random() * params.cells.length)];\n          const tile = game.board.getTile(cell.row, cell.col);\n          if (tile && tile.special === SPECIAL_NONE) {\n            tile.special = SPECIAL_STRIPED_H;\n            game.audio.playSpecial();\n          }\n        }\n        break;\n\n      case 'chain_bonus':\n        if (event === 'chain_score' && params && params.chainCount >= 3) {\n          game.scoreSystem.addScore(ch.param);\n        }\n        break;\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { CharacterManager };\n","numLines":79,"startLine":1,"totalLines":79}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_108fb5bc431f4e8eacbcd0a0","type":"tool_result","content":"1\t// Board.js — 8x8 grid state management\n2\tconst TILE_COLORS = 6;\n3\tconst BOARD_SIZE = 8;\n4\tconst EMPTY = -1;\n5\t\n6\tconst COLOR_MAP = {\n7\t  0: { name: 'apple',   hex: '#FF4D4D', label: '红' },\n8\t  1: { name: 'banana',  hex: '#FFD93D', label: '黄' },\n9\t  2: { name: 'blueberry', hex: '#4DA6FF', label: '蓝' },\n10\t  3: { name: 'lime',    hex: '#6BCB77', label: '绿' },\n11\t  4: { name: 'grape',   hex: '#B47AEA', label: '紫' },\n12\t  5: { name: 'orange',  hex: '#FF9A3C', label: '橙' },\n13\t};\n14\t\n15\t// Special tile types\n16\tconst SPECIAL_NONE = 0;\n17\tconst SPECIAL_STRIPED_H = 1;  // horizontal stripe bomb\n18\tconst SPECIAL_STRIPED_V = 2;  // vertical stripe bomb\n19\tconst SPECIAL_BOMB = 3;       // 3x3 area bomb\n20\tconst SPECIAL_RAINBOW = 4;    // clears all of one color\n21\t\n22\tclass Tile {\n23\t  constructor(color, row, col) {\n24\t    this.color = color;\n25\t    this.row = row;\n26\t    this.col = col;\n27\t    this.special = SPECIAL_NONE;\n28\t    this.removing = false;\n29\t    this.offsetY = 0;\n30\t    this.offsetX = 0;\n31\t    this.scale = 1;\n32\t    this.alpha = 1;\n33\t    this.selected = false;\n34\t    this.id = Tile._nextId++;\n35\t  }\n36\t  get type() { return this.color; }\n37\t}\n38\t\n39\tTile._nextId = 0;\n40\t\n41\tclass Board {\n42\t  constructor(size = BOARD_SIZE, numColors = TILE_COLORS) {\n43\t    this.size = size;\n44\t    this.numColors = numColors;\n45\t    this.grid = [];\n46\t    this.listeners = [];\n47\t  }\n48\t\n49\t  init() {\n50\t    this.grid = [];\n51\t    for (let r = 0; r < this.size; r++) {\n52\t      this.grid[r] = [];\n53\t      for (let c = 0; c < this.size; c++) {\n54\t        this.grid[r][c] = this._createTile(r, c);\n55\t      }\n56\t    }\n57\t    // Ensure no initial matches\n58\t    this._removeInitialMatches();\n59\t  }\n60\t\n61\t  _createTile(row, col) {\n62\t    return new Tile(this._randomColor(), row, col);\n63\t  }\n64\t\n65\t  _randomColor() {\n66\t    return Math.floor(Math.random() * this.numColors);\n67\t  }\n68\t\n69\t  _removeInitialMatches() {\n70\t    let maxIter = 1000;\n71\t    while (this._hasMatch() && maxIter-- > 0) {\n72\t      const matches = this.findAllMatches();\n73\t      for (const group of matches) {\n74\t        for (const { row, col } of group.cells) {\n75\t          this.grid[row][col] = this._createTile(row, col);\n76\t        }\n77\t      }\n78\t    }\n79\t  }\n80\t\n81\t  _hasMatch() {\n82\t    return this.findAllMatches().length > 0;\n83\t  }\n84\t\n85\t  getTile(r, c) {\n86\t    if (r < 0 || r >= this.size || c < 0 || c >= this.size) return null;\n87\t    return this.grid[r][c];\n88\t  }\n89\t\n90\t  setTile(r, c, tile) {\n91\t    if (r >= 0 && r < this.size && c >= 0 && c < this.size) {\n92\t      tile.row = r;\n93\t      tile.col = c;\n94\t      this.grid[r][c] = tile;\n95\t    }\n96\t  }\n97\t\n98\t  swap(r1, c1, r2, c2) {\n99\t    const a = this.grid[r1][c1];\n100\t    const b = this.grid[r2][c2];\n101\t    this.grid[r1][c1] = b;\n102\t    this.grid[r2][c2] = a;\n103\t    if (a) { a.row = r2; a.col = c2; }\n104\t    if (b) { b.row = r1; b.col = c1; }\n105\t  }\n106\t\n107\t  removeTile(r, c) {\n108\t    const tile = this.grid[r][c];\n109\t    if (tile) tile.removing = true;\n110\t    return tile;\n111\t  }\n112\t\n113\t  clearCell(r, c) {\n114\t    this.grid[r][c] = null;\n115\t  }\n116\t\n117\t  isValid(r, c) {\n118\t    return r >= 0 && r < this.size && c >= 0 && c < this.size;\n119\t  }\n120\t\n121\t  isAdjacent(r1, c1, r2, c2) {\n122\t    const dr = Math.abs(r1 - r2);\n123\t    const dc = Math.abs(c1 - c2);\n124\t    return (dr + dc) === 1;\n125\t  }\n126\t\n127\t  // Find all horizontal and vertical matches of length >= 3\n128\t  findAllMatches() {\n129\t    const matches = [];\n130\t\n131\t    // Horizontal scan\n132\t    for (let r = 0; r < this.size; r++) {\n133\t      let start = 0;\n134\t      for (let c = 1; c <= this.size; c++) {\n135\t        const cur = c < this.size ? this.grid[r][c] : null;\n136\t        const prev = this.grid[r][start];\n137\t        if (c < this.size && cur && prev && cur.color === prev.color && cur.color !== EMPTY) {\n138\t          continue;\n139\t        }\n140\t        const len = c - start;\n141\t        if (len >= 3 && prev && prev.color !== EMPTY) {\n142\t          const cells = [];\n143\t          for (let k = start; k < c; k++) cells.push({ row: r, col: k });\n144\t          matches.push({ cells, length: len, direction: 'horizontal', color: prev.color });\n145\t        }\n146\t        start = c;\n147\t      }\n148\t    }\n149\t\n150\t    // Vertical scan\n151\t    for (let c = 0; c < this.size; c++) {\n152\t      let start = 0;\n153\t      for (let r = 1; r <= this.size; r++) {\n154\t        const cur = r < this.size ? this.grid[r][c] : null;\n155\t        const prev = this.grid[start][c];\n156\t        if (r < this.size && cur && prev && cur.color === prev.color && cur.color !== EMPTY) {\n157\t          continue;\n158\t        }\n159\t        const len = r - start;\n160\t        if (len >= 3 && prev && prev.color !== EMPTY) {\n161\t          const cells = [];\n162\t          for (let k = start; k < r; k++) cells.push({ row: k, col: c });\n163\t          matches.push({ cells, length: len, direction: 'vertical', color: prev.color });\n164\t        }\n165\t        start = r;\n166\t      }\n167\t    }\n168\t\n169\t    return matches;\n170\t  }\n171\t\n172\t  // Detect L/T shape matches by finding intersections of horizontal and vertical matches\n173\t  findLShapeMatches(matches) {\n174\t    const lShapes = [];\n175\t    for (let i = 0; i < matches.length; i++) {\n176\t      for (let j = i + 1; j < matches.length; j++) {\n177\t        const a = matches[i], b = matches[j];\n178\t        if (a.direction === b.direction) continue;\n179\t        if (a.color !== b.color) continue;\n180\t        // Find intersection\n181\t        const setA = new Set(a.cells.map(c => `${c.row},${c.col}`));\n182\t        for (const cell of b.cells) {\n183\t          if (setA.has(`${cell.row},${cell.col}`)) {\n184\t            // L/T shape found — merge all cells\n185\t            const allCellsMap = {};\n186\t            for (const c of a.cells) allCellsMap[`${c.row},${c.col}`] = c;\n187\t            for (const c of b.cells) allCellsMap[`${c.row},${c.col}`] = c;\n188\t            const allCells = Object.values(allCellsMap);\n189\t            lShapes.push({ cells: allCells, color: a.color });\n190\t          }\n191\t        }\n192\t      }\n193\t    }\n194\t    return lShapes;\n195\t  }\n196\t\n197\t  // Apply gravity: move tiles down to fill empty cells\n198\t  applyGravity() {\n199\t    const drops = [];\n200\t    for (let c = 0; c < this.size; c++) {\n201\t      let writeRow = this.size - 1;\n202\t      for (let r = this.size - 1; r >= 0; r--) {\n203\t        if (this.grid[r][c] !== null) {\n204\t          if (r !== writeRow) {\n205\t            const tile = this.grid[r][c];\n206\t            const fromRow = r;\n207\t            this.grid[r][c] = null;\n208\t            this.grid[writeRow][c] = tile;\n209\t            const distance = writeRow - fromRow;\n210\t            tile.row = writeRow;\n211\t            drops.push({ tile, fromRow, toRow: writeRow, col: c, distance });\n212\t          }\n213\t          writeRow--;\n214\t        }\n215\t      }\n216\t      // Fill empty top cells\n217\t      for (let r = writeRow; r >= 0; r--) {\n218\t        const tile = this._createTile(r, c);\n219\t        tile.offsetY = -(writeRow - r + 1); // start above board\n220\t        this.grid[r][c] = tile;\n221\t        drops.push({ tile, fromRow: -(writeRow - r + 1), toRow: r, col: c, distance: r + (writeRow - r + 1) });\n222\t      }\n223\t    }\n224\t    return drops;\n225\t  }\n226\t\n227\t  // Check if any valid move exists (for deadlock detection)\n228\t  // obstacleMgr is optional — if provided, skip chained/blocked cells\n229\t  hasValidMoves(obstacleMgr) {\n230\t    for (let r = 0; r < this.size; r++) {\n231\t      for (let c = 0; c < this.size; c++) {\n232\t        if (!this.grid[r][c]) continue;\n233\t        // Skip if tile is chained or cell is blocked\n234\t        if (obstacleMgr) {\n235\t          if (obstacleMgr.isCellBlocked(r, c)) continue;\n236\t          if (!obstacleMgr.canSwap(r, c)) continue;\n237\t        }\n238\t        // Try swap right\n239\t        if (c + 1 < this.size && this.grid[r][c + 1]) {\n240\t          if (obstacleMgr && !obstacleMgr.canSwap(r, c + 1)) continue;\n241\t          this.swap(r, c, r, c + 1);\n242\t          const has = this.findAllMatches().length > 0;\n243\t          this.swap(r, c, r, c + 1);\n244\t          if (has) return true;\n245\t        }\n246\t        // Try swap down\n247\t        if (r + 1 < this.size && this.grid[r + 1][c]) {\n248\t          if (obstacleMgr && !obstacleMgr.canSwap(r + 1, c)) continue;\n249\t          this.swap(r, c, r + 1, c);\n250\t          const has = this.findAllMatches().length > 0;\n251\t          this.swap(r, c, r + 1, c);\n252\t          if (has) return true;\n253\t        }\n254\t      }\n255\t    }\n256\t    return false;\n257\t  }\n258\t\n259\t  // Shuffle board if no valid moves\n260\t  shuffle() {\n261\t    const tiles = [];\n262\t    for (let r = 0; r < this.size; r++) {\n263\t      for (let c = 0; c < this.size; c++) {\n264\t        if (this.grid[r][c]) {\n265\t          tiles.push(this.grid[r][c].color);\n266\t        }\n267\t      }\n268\t    }\n269\t    // Fisher-Yates shuffle\n270\t    for (let i = tiles.length - 1; i > 0; i--) {\n271\t      const j = Math.floor(Math.random() * (i + 1));\n272\t      [tiles[i], tiles[j]] = [tiles[j], tiles[i]];\n273\t    }\n274\t    let idx = 0;\n275\t    for (let r = 0; r < this.size; r++) {\n276\t      for (let c = 0; c < this.size; c++) {\n277\t        if (this.grid[r][c]) {\n278\t          this.grid[r][c].color = tiles[idx++] || this._randomColor();\n279\t        }\n280\t      }\n281\t    }\n282\t    // Remove any initial matches from shuffle\n283\t    this._removeInitialMatches();\n284\t    // If still no valid moves, re-init\n285\t    if (!this.hasValidMoves()) {\n286\t      this.init();\n287\t    }\n288\t  }\n289\t}\n290\t\n291\tif (typeof module !== 'undefined') module.exports = { Board, Tile, BOARD_SIZE, TILE_COLORS, SPECIAL_NONE, SPECIAL_STRIPED_H, SPECIAL_STRIPED_V, SPECIAL_BOMB, SPECIAL_RAINBOW, COLOR_MAP };\n292\t"}]},"parent_tool_use_id":null,"session_id":"ec73960d-df44-45f4-a48b-a11bb93a968e","uuid":"f8a19f5f-1847-413d-8c1e-789420ab73fd","timestamp":"2026-05-22T22:42:56.906Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\douyin-match3\\src\\js\\Board.js","content":"// Board.js — 8x8 grid state management\nconst TILE_COLORS = 6;\nconst BOARD_SIZE = 8;\nconst EMPTY = -1;\n\nconst COLOR_MAP = {\n  0: { name: 'apple',   hex: '#FF4D4D', label: '红' },\n  1: { name: 'banana',  hex: '#FFD93D', label: '黄' },\n  2: { name: 'blueberry', hex: '#4DA6FF', label: '蓝' },\n  3: { name: 'lime',    hex: '#6BCB77', label: '绿' },\n  4: { name: 'grape',   hex: '#B47AEA', label: '紫' },\n  5: { name: 'orange',  hex: '#FF9A3C', label: '橙' },\n};\n\n// Special tile types\nconst SPECIAL_NONE = 0;\nconst SPECIAL_STRIPED_H = 1;  // horizontal stripe bomb\nconst SPECIAL_STRIPED_V = 2;  // vertical stripe bomb\nconst SPECIAL_BOMB = 3;       // 3x3 area bomb\nconst SPECIAL_RAINBOW = 4;    // clears all of one color\n\nclass Tile {\n  constructor(color, row, col) {\n    this.color = color;\n    this.row = row;\n    this.col = col;\n    this.special = SPECIAL_NONE;\n    this.removing = false;\n    this.offsetY = 0;\n    this.offsetX = 0;\n    this.scale = 1;\n    this.alpha = 1;\n    this.selected = false;\n    this.id = Tile._nextId++;\n  }\n  get type() { return this.color; }\n}\n\nTile._nextId = 0;\n\nclass Board {\n  constructor(size = BOARD_SIZE, numColors = TILE_COLORS) {\n    this.size = size;\n    this.numColors = numColors;\n    this.grid = [];\n    this.listeners = [];\n  }\n\n  init() {\n    this.grid = [];\n    for (let r = 0; r < this.size; r++) {\n      this.grid[r] = [];\n      for (let c = 0; c < this.size; c++) {\n        this.grid[r][c] = this._createTile(r, c);\n      }\n    }\n    // Ensure no initial matches\n    this._removeInitialMatches();\n  }\n\n  _createTile(row, col) {\n    return new Tile(this._randomColor(), row, col);\n  }\n\n  _randomColor() {\n    return Math.floor(Math.random() * this.numColors);\n  }\n\n  _removeInitialMatches() {\n    let maxIter = 1000;\n    while (this._hasMatch() && maxIter-- > 0) {\n      const matches = this.findAllMatches();\n      for (const group of matches) {\n        for (const { row, col } of group.cells) {\n          this.grid[row][col] = this._createTile(row, col);\n        }\n      }\n    }\n  }\n\n  _hasMatch() {\n    return this.findAllMatches().length > 0;\n  }\n\n  getTile(r, c) {\n    if (r < 0 || r >= this.size || c < 0 || c >= this.size) return null;\n    return this.grid[r][c];\n  }\n\n  setTile(r, c, tile) {\n    if (r >= 0 && r < this.size && c >= 0 && c < this.size) {\n      tile.row = r;\n      tile.col = c;\n      this.grid[r][c] = tile;\n    }\n  }\n\n  swap(r1, c1, r2, c2) {\n    const a = this.grid[r1][c1];\n    const b = this.grid[r2][c2];\n    this.grid[r1][c1] = b;\n    this.grid[r2][c2] = a;\n    if (a) { a.row = r2; a.col = c2; }\n    if (b) { b.row = r1; b.col = c1; }\n  }\n\n  removeTile(r, c) {\n    const tile = this.grid[r][c];\n    if (tile) tile.removing = true;\n    return tile;\n  }\n\n  clearCell(r, c) {\n    this.grid[r][c] = null;\n  }\n\n  isValid(r, c) {\n    return r >= 0 && r < this.size && c >= 0 && c < this.size;\n  }\n\n  isAdjacent(r1, c1, r2, c2) {\n    const dr = Math.abs(r1 - r2);\n    const dc = Math.abs(c1 - c2);\n    return (dr + dc) === 1;\n  }\n\n  // Find all horizontal and vertical matches of length >= 3\n  findAllMatches() {\n    const matches = [];\n\n    // Horizontal scan\n    for (let r = 0; r < this.size; r++) {\n      let start = 0;\n      for (let c = 1; c <= this.size; c++) {\n        const cur = c < this.size ? this.grid[r][c] : null;\n        const prev = this.grid[r][start];\n        if (c < this.size && cur && prev && cur.color === prev.color && cur.color !== EMPTY) {\n          continue;\n        }\n        const len = c - start;\n        if (len >= 3 && prev && prev.color !== EMPTY) {\n          const cells = [];\n          for (let k = start; k < c; k++) cells.push({ row: r, col: k });\n          matches.push({ cells, length: len, direction: 'horizontal', color: prev.color });\n        }\n        start = c;\n      }\n    }\n\n    // Vertical scan\n    for (let c = 0; c < this.size; c++) {\n      let start = 0;\n      for (let r = 1; r <= this.size; r++) {\n        const cur = r < this.size ? this.grid[r][c] : null;\n        const prev = this.grid[start][c];\n        if (r < this.size && cur && prev && cur.color === prev.color && cur.color !== EMPTY) {\n          continue;\n        }\n        const len = r - start;\n        if (len >= 3 && prev && prev.color !== EMPTY) {\n          const cells = [];\n          for (let k = start; k < r; k++) cells.push({ row: k, col: c });\n          matches.push({ cells, length: len, direction: 'vertical', color: prev.color });\n        }\n        start = r;\n      }\n    }\n\n    return matches;\n  }\n\n  // Detect L/T shape matches by finding intersections of horizontal and vertical matches\n  findLShapeMatches(matches) {\n    const lShapes = [];\n    for (let i = 0; i < matches.length; i++) {\n      for (let j = i + 1; j < matches.length; j++) {\n        const a = matches[i], b = matches[j];\n        if (a.direction === b.direction) continue;\n        if (a.color !== b.color) continue;\n        // Find intersection\n        const setA = new Set(a.cells.map(c => `${c.row},${c.col}`));\n        for (const cell of b.cells) {\n          if (setA.has(`${cell.row},${cell.col}`)) {\n            // L/T shape found — merge all cells\n            const allCellsMap = {};\n            for (const c of a.cells) allCellsMap[`${c.row},${c.col}`] = c;\n            for (const c of b.cells) allCellsMap[`${c.row},${c.col}`] = c;\n            const allCells = Object.values(allCellsMap);\n            lShapes.push({ cells: allCells, color: a.color });\n          }\n        }\n      }\n    }\n    return lShapes;\n  }\n\n  // Apply gravity: move tiles down to fill empty cells\n  applyGravity() {\n    const drops = [];\n    for (let c = 0; c < this.size; c++) {\n      let writeRow = this.size - 1;\n      for (let r = this.size - 1; r >= 0; r--) {\n        if (this.grid[r][c] !== null) {\n          if (r !== writeRow) {\n            const tile = this.grid[r][c];\n            const fromRow = r;\n            this.grid[r][c] = null;\n            this.grid[writeRow][c] = tile;\n            const distance = writeRow - fromRow;\n            tile.row = writeRow;\n            drops.push({ tile, fromRow, toRow: writeRow, col: c, distance });\n          }\n          writeRow--;\n        }\n      }\n      // Fill empty top cells\n      for (let r = writeRow; r >= 0; r--) {\n        const tile = this._createTile(r, c);\n        tile.offsetY = -(writeRow - r + 1); // start above board\n        this.grid[r][c] = tile;\n        drops.push({ tile, fromRow: -(writeRow - r + 1), toRow: r, col: c, distance: r + (writeRow - r + 1) });\n      }\n    }\n    return drops;\n  }\n\n  // Check if any valid move exists (for deadlock detection)\n  // obstacleMgr is optional — if provided, skip chained/blocked cells\n  hasValidMoves(obstacleMgr) {\n    for (let r = 0; r < this.size; r++) {\n      for (let c = 0; c < this.size; c++) {\n        if (!this.grid[r][c]) continue;\n        // Skip if tile is chained or cell is blocked\n        if (obstacleMgr) {\n          if (obstacleMgr.isCellBlocked(r, c)) continue;\n          if (!obstacleMgr.canSwap(r, c)) continue;\n        }\n        // Try swap right\n        if (c + 1 < this.size && this.grid[r][c + 1]) {\n          if (obstacleMgr && !obstacleMgr.canSwap(r, c + 1)) continue;\n          this.swap(r, c, r, c + 1);\n          const has = this.findAllMatches().length > 0;\n          this.swap(r, c, r, c + 1);\n          if (has) return true;\n        }\n        // Try swap down\n        if (r + 1 < this.size && this.grid[r + 1][c]) {\n          if (obstacleMgr && !obstacleMgr.canSwap(r + 1, c)) continue;\n          this.swap(r, c, r + 1, c);\n          const has = this.findAllMatches().length > 0;\n          this.swap(r, c, r + 1, c);\n          if (has) return true;\n        }\n      }\n    }\n    return false;\n  }\n\n  // Shuffle board if no valid moves\n  shuffle() {\n    const tiles = [];\n    for (let r = 0; r < this.size; r++) {\n      for (let c = 0; c < this.size; c++) {\n        if (this.grid[r][c]) {\n          tiles.push(this.grid[r][c].color);\n        }\n      }\n    }\n    // Fisher-Yates shuffle\n    for (let i = tiles.length - 1; i > 0; i--) {\n      const j = Math.floor(Math.random() * (i + 1));\n      [tiles[i], tiles[j]] = [tiles[j], tiles[i]];\n    }\n    let idx = 0;\n    for (let r = 0; r < this.size; r++) {\n      for (let c = 0; c < this.size; c++) {\n        if (this.grid[r][c]) {\n          this.grid[r][c].color = tiles[idx++] || this._randomColor();\n        }\n      }\n    }\n    // Remove any initial matches from shuffle\n    this._removeInitialMatches();\n    // If still no valid moves, re-init\n    if (!this.hasValidMoves()) {\n      this.init();\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Board, Tile, BOARD_SIZE, TILE_COLORS, SPECIAL_NONE, SPECIAL_STRIPED_H, SPECIAL_STRIPED_V, SPECIAL_BOMB, SPECIAL_RAINBOW, COLOR_MAP };\n","numLines":292,"startLine":1,"totalLines":292}}}
