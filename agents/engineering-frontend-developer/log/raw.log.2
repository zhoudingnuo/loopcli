{"type":"assistant","message":{"id":"msg_202605230532393fd56eafdea748b6","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_a2c9f980ffb84c6a95f1d0ee","name":"Write","input":{"file_path":"D:/game-projects/douyin-match3/src/js/Renderer.js","content":"// Renderer.js — Canvas 2D rendering engine with obstacle, boss, and updated UI support\n\nclass Renderer {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d');\n    this.tileSize = 0;\n    this.boardX = 0;\n    this.boardY = 0;\n    this.particleSystem = null;\n    this.floatingTexts = [];\n    this.resize();\n  }\n\n  resize() {\n    const dpr = window.devicePixelRatio || 1;\n    const w = window.innerWidth;\n    const h = window.innerHeight;\n    this.canvas.width = w * dpr;\n    this.canvas.height = h * dpr;\n    this.canvas.style.width = w + 'px';\n    this.canvas.style.height = h + 'px';\n    this.ctx.scale(dpr, dpr);\n    this.screenW = w;\n    this.screenH = h;\n\n    this.tileSize = Math.floor(Math.min(w * 0.9, (h - 160)) / BOARD_SIZE);\n    this.boardX = (w - this.tileSize * BOARD_SIZE) / 2;\n    this.boardY = 140;\n  }\n\n  getTileCenter(row, col) {\n    return {\n      x: this.boardX + col * this.tileSize + this.tileSize / 2,\n      y: this.boardY + row * this.tileSize + this.tileSize / 2,\n    };\n  }\n\n  clear() {\n    this.ctx.clearRect(0, 0, this.screenW, this.screenH);\n  }\n\n  drawBackground() {\n    const ctx = this.ctx;\n    ctx.fillStyle = '#FFF8E7';\n    ctx.fillRect(0, 0, this.screenW, this.screenH);\n\n    const bw = this.tileSize * BOARD_SIZE;\n    const bh = this.tileSize * BOARD_SIZE;\n    ctx.fillStyle = '#FFFFFFCC';\n    this._roundRect(ctx, this.boardX - 6, this.boardY - 6, bw + 12, bh + 12, 12);\n    ctx.fill();\n\n    ctx.strokeStyle = '#F0E6D6';\n    ctx.lineWidth = 1;\n    for (let i = 0; i <= BOARD_SIZE; i++) {\n      ctx.beginPath();\n      ctx.moveTo(this.boardX + i * this.tileSize, this.boardY);\n      ctx.lineTo(this.boardX + i * this.tileSize, this.boardY + bh);\n      ctx.stroke();\n      ctx.beginPath();\n      ctx.moveTo(this.boardX, this.boardY + i * this.tileSize);\n      ctx.lineTo(this.boardX + bw, this.boardY + i * this.tileSize);\n      ctx.stroke();\n    }\n  }\n\n  drawTile(tile) {\n    if (!tile || tile.color < 0) return;\n    const ctx = this.ctx;\n    const size = this.tileSize - 4;\n    const cx = this.boardX + tile.col * this.tileSize + this.tileSize / 2 + (tile.offsetX || 0);\n    const cy = this.boardY + tile.row * this.tileSize + this.tileSize / 2 + (tile.offsetY || 0);\n    const scale = tile.scale || 1;\n    const alpha = tile.alpha !== undefined ? tile.alpha : 1;\n\n    ctx.save();\n    ctx.translate(cx, cy);\n    ctx.scale(scale, scale);\n    ctx.globalAlpha = alpha;\n\n    const half = size / 2;\n    const color = COLOR_MAP[tile.color];\n    if (!color) { ctx.restore(); return; }\n\n    ctx.fillStyle = color.hex;\n    this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n    ctx.fill();\n\n    ctx.fillStyle = 'rgba(255,255,255,0.25)';\n    this._roundRect(ctx, -half + 3, -half + 3, size - 6, size / 2 - 3, size * 0.15);\n    ctx.fill();\n\n    this._drawFruitIcon(ctx, tile.color, half * 0.55);\n\n    if (tile.special === SPECIAL_STRIPED_H) {\n      this._drawStripes(ctx, size, half, '#FFFFFF80', true);\n    } else if (tile.special === SPECIAL_STRIPED_V) {\n      this._drawStripes(ctx, size, half, '#FFFFFF80', false);\n    } else if (tile.special === SPECIAL_BOMB) {\n      this._drawCrosshair(ctx, half);\n    } else if (tile.special === SPECIAL_RAINBOW) {\n      this._drawRainbowOverlay(ctx, half);\n    }\n\n    if (tile.selected) {\n      ctx.strokeStyle = '#FFFFFF';\n      ctx.lineWidth = 3;\n      ctx.shadowColor = '#FFB800';\n      ctx.shadowBlur = 12;\n      this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n      ctx.stroke();\n      ctx.shadowBlur = 0;\n    }\n\n    ctx.restore();\n  }\n\n  _drawFruitIcon(ctx, colorIdx, radius) {\n    ctx.fillStyle = 'rgba(255,255,255,0.6)';\n    ctx.font = `bold ${radius * 1.4}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    const icons = ['🍎', '🍌', '🫐', '🍏', '🍇', '🍊'];\n    ctx.fillText(icons[colorIdx] || '', 0, 1);\n  }\n\n  _drawStripes(ctx, size, half, color, horizontal) {\n    ctx.strokeStyle = color;\n    ctx.lineWidth = 2;\n    if (horizontal) {\n      for (let y = -half + 6; y < half; y += 8) {\n        ctx.beginPath();\n        ctx.moveTo(-half + 4, y);\n        ctx.lineTo(half - 4, y);\n        ctx.stroke();\n      }\n    } else {\n      for (let x = -half + 6; x < half; x += 8) {\n        ctx.beginPath();\n        ctx.moveTo(x, -half + 4);\n        ctx.lineTo(x, half - 4);\n        ctx.stroke();\n      }\n    }\n  }\n\n  _drawCrosshair(ctx, half) {\n    ctx.strokeStyle = '#FFFFFF99';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.moveTo(-half * 0.6, 0); ctx.lineTo(half * 0.6, 0);\n    ctx.moveTo(0, -half * 0.6); ctx.lineTo(0, half * 0.6);\n    ctx.stroke();\n    ctx.beginPath();\n    ctx.arc(0, 0, half * 0.4, 0, Math.PI * 2);\n    ctx.stroke();\n  }\n\n  _drawRainbowOverlay(ctx, half) {\n    const gradient = ctx.createLinearGradient(-half, -half, half, half);\n    gradient.addColorStop(0, '#FF000080');\n    gradient.addColorStop(0.17, '#FF880080');\n    gradient.addColorStop(0.33, '#FFFF0080');\n    gradient.addColorStop(0.5, '#00FF0080');\n    gradient.addColorStop(0.67, '#0088FF80');\n    gradient.addColorStop(0.83, '#8800FF80');\n    gradient.addColorStop(1, '#FF008880');\n    ctx.fillStyle = gradient;\n    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.4);\n    ctx.fill();\n  }\n\n  // Draw all obstacles\n  drawObstacles(obstacleMgr) {\n    for (const obs of obstacleMgr.obstacles) {\n      if (obs.isDestroyed()) continue;\n      const shake = obs.shakeTimer > 0 ? (Math.random() - 0.5) * 4 : 0;\n      const pos = this.getTileCenter(obs.row, obs.col);\n      const half = (this.tileSize - 4) / 2;\n\n      this.ctx.save();\n      this.ctx.translate(pos.x + shake, pos.y);\n\n      switch (obs.type) {\n        case OBSTACLE_ICE:\n          this._drawIce(this.ctx, half);\n          break;\n        case OBSTACLE_CHAIN:\n          this._drawChain(this.ctx, half);\n          break;\n        case OBSTACLE_CHOCOLATE:\n          this._drawChocolate(this.ctx, half);\n          break;\n      }\n\n      this.ctx.restore();\n    }\n  }\n\n  _drawIce(ctx, half) {\n    // Translucent blue overlay\n    ctx.fillStyle = 'rgba(135, 206, 250, 0.45)';\n    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.2);\n    ctx.fill();\n    // Ice crack pattern\n    ctx.strokeStyle = 'rgba(255, 255, 255, 0.7)';\n    ctx.lineWidth = 1.5;\n    ctx.beginPath();\n    ctx.moveTo(-half * 0.3, -half * 0.5);\n    ctx.lineTo(half * 0.2, 0);\n    ctx.lineTo(-half * 0.1, half * 0.4);\n    ctx.stroke();\n    ctx.beginPath();\n    ctx.moveTo(half * 0.3, -half * 0.3);\n    ctx.lineTo(0, half * 0.1);\n    ctx.stroke();\n    // Ice label\n    ctx.fillStyle = 'rgba(255,255,255,0.8)';\n    ctx.font = `bold ${half * 0.6}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText('❄', 0, 0);\n  }\n\n  _drawChain(ctx, half) {\n    // Chain icon overlay\n    ctx.fillStyle = 'rgba(100, 100, 100, 0.35)';\n    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.2);\n    ctx.fill();\n    // Chain links\n    ctx.strokeStyle = 'rgba(80, 80, 80, 0.9)';\n    ctx.lineWidth = 3;\n    for (let i = -1; i <= 1; i++) {\n      ctx.beginPath();\n      ctx.ellipse(i * half * 0.5, 0, half * 0.25, half * 0.15, 0, 0, Math.PI * 2);\n      ctx.stroke();\n    }\n    // Lock icon\n    ctx.fillStyle = 'rgba(255,255,255,0.7)';\n    ctx.font = `bold ${half * 0.7}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText('🔗', 0, -half * 0.6);\n  }\n\n  _drawChocolate(ctx, half) {\n    // Brown blob\n    ctx.fillStyle = '#6B3410';\n    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.3);\n    ctx.fill();\n    // Chocolate drip pattern\n    ctx.fillStyle = '#8B5E3C';\n    this._roundRect(ctx, -half + 3, -half + 3, half * 2 - 6, half * 2 - 6, half * 0.25);\n    ctx.fill();\n    // Shine\n    ctx.fillStyle = 'rgba(255,255,255,0.15)';\n    this._roundRect(ctx, -half + 6, -half + 6, half - 3, half * 0.6, half * 0.15);\n    ctx.fill();\n    // Emoji\n    ctx.font = `bold ${half * 0.8}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText('🍫', 0, 0);\n  }\n\n  // Draw boss on board\n  drawBoss(boss, renderer) {\n    const pos = this.getTileCenter(boss.row, boss.col);\n    const half = (this.tileSize - 4) / 2;\n    const shake = boss.shakeTimer > 0 ? (Math.random() - 0.5) * 6 : 0;\n\n    this.ctx.save();\n    this.ctx.translate(pos.x + shake, pos.y);\n\n    // Boss body\n    const isUsingSkill = boss.skillAnimTimer > 0;\n    const pulseScale = isUsingSkill ? 1.1 : 1;\n    this.ctx.scale(pulseScale, pulseScale);\n\n    // Dark aura\n    this.ctx.fillStyle = isUsingSkill ? 'rgba(255,0,0,0.15)' : 'rgba(80,0,80,0.1)';\n    this.ctx.beginPath();\n    this.ctx.arc(0, 0, half * 1.3, 0, Math.PI * 2);\n    this.ctx.fill();\n\n    // Boss face\n    this.ctx.fillStyle = '#4A0E4E';\n    this._roundRect(this.ctx, -half, -half, half * 2, half * 2, half * 0.3);\n    this.ctx.fill();\n\n    // Inner glow\n    const grad = this.ctx.createRadialGradient(0, 0, 0, 0, 0, half);\n    grad.addColorStop(0, 'rgba(255,100,200,0.3)');\n    grad.addColorStop(1, 'rgba(80,0,120,0.1)');\n    this.ctx.fillStyle = grad;\n    this._roundRect(this.ctx, -half, -half, half * 2, half * 2, half * 0.3);\n    this.ctx.fill();\n\n    // Boss emoji\n    this.ctx.font = `bold ${half * 1.2}px sans-serif`;\n    this.ctx.textAlign = 'center';\n    this.ctx.textBaseline = 'middle';\n    const hpRatio = boss.hp / boss.maxHp;\n    const bossEmoji = hpRatio > 0.5 ? '👹' : hpRatio > 0.25 ? '👿' : '💀';\n    this.ctx.fillText(bossEmoji, 0, 0);\n\n    this.ctx.restore();\n  }\n\n  // Draw boss health bar above the board\n  drawBossHealthBar(boss) {\n    const ctx = this.ctx;\n    const barW = Math.min(200, this.screenW - 40);\n    const barH = 14;\n    const barX = (this.screenW - barW) / 2;\n    const barY = this.boardY + this.tileSize * BOARD_SIZE + 50;\n\n    // Background\n    ctx.fillStyle = '#E0D5C5';\n    this._roundRect(ctx, barX, barY, barW, barH, 7);\n    ctx.fill();\n\n    // HP bar\n    const hpRatio = Math.max(0, boss.hp / boss.maxHp);\n    if (hpRatio > 0) {\n      const grad = ctx.createLinearGradient(barX, barY, barX + barW * hpRatio, barY);\n      grad.addColorStop(0, '#FF4D4D');\n      grad.addColorStop(1, '#CC0000');\n      ctx.fillStyle = grad;\n      this._roundRect(ctx, barX, barY, barW * hpRatio, barH, 7);\n      ctx.fill();\n    }\n\n    // Boss name and HP text\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 12px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(`${boss.name}  ${boss.hp}/${boss.maxHp}`, this.screenW / 2, barY + barH + 14);\n  }\n\n  // Updated drawUI to support new goal types\n  drawUI(score, moves, config, scoreSystem, level) {\n    const ctx = this.ctx;\n\n    // Top bar background\n    ctx.fillStyle = '#FFB800';\n    this._roundRect(ctx, 8, 8, this.screenW - 16, 55, 12);\n    ctx.fill();\n\n    // Level\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 18px sans-serif';\n    ctx.textAlign = 'left';\n    ctx.fillText(`第 ${level} 关`, 20, 42);\n\n    // Level name\n    if (config.name) {\n      ctx.font = '12px sans-serif';\n      ctx.fillText(config.name, 20, 22);\n    }\n\n    // Score\n    ctx.textAlign = 'center';\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.fillText(`${score}`, this.screenW / 2, 32);\n    ctx.font = '12px sans-serif';\n    ctx.fillText('分数', this.screenW / 2, 48);\n\n    // Moves\n    ctx.textAlign = 'right';\n    ctx.fillStyle = moves <= 5 ? '#FF4D4D' : '#5D4037';\n    ctx.font = 'bold 22px sans-serif';\n    ctx.fillText(`${moves}`, this.screenW - 20, 32);\n    ctx.font = '12px sans-serif';\n    ctx.fillStyle = '#5D4037';\n    ctx.fillText('剩余步数', this.screenW - 20, 48);\n\n    // Goal progress — use the new goal description\n    const goalDesc = scoreSystem.getGoalDescription();\n    const progressBars = scoreSystem.getProgressForUI();\n\n    const barW = this.screenW - 40;\n    const barH = 16;\n    const barY = 72;\n    const barX = 20;\n\n    // Goal label\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 11px sans-serif';\n    ctx.textAlign = 'center';\n\n    if (progressBars.length === 1) {\n      // Single goal — progress bar\n      const p = progressBars[0];\n      ctx.fillStyle = '#E0D5C5';\n      this._roundRect(ctx, barX, barY, barW, barH, 8);\n      ctx.fill();\n\n      const progress = Math.min(p.current / p.target, 1);\n      if (progress > 0) {\n        const grad = ctx.createLinearGradient(barX, barY, barX + barW * progress, barY);\n        grad.addColorStop(0, '#6BCB77');\n        grad.addColorStop(1, '#4DA66B');\n        ctx.fillStyle = grad;\n        this._roundRect(ctx, barX, barY, barW * progress, barH, 8);\n        ctx.fill();\n      }\n\n      ctx.fillStyle = '#5D4037';\n      ctx.font = 'bold 11px sans-serif';\n      ctx.fillText(goalDesc, this.screenW / 2, barY + 13);\n    } else {\n      // Dual goal — two smaller bars\n      const halfBarW = (barW - 10) / 2;\n      for (let i = 0; i < progressBars.length; i++) {\n        const p = progressBars[i];\n        const bx = barX + i * (halfBarW + 10);\n\n        ctx.fillStyle = '#E0D5C5';\n        this._roundRect(ctx, bx, barY, halfBarW, barH, 8);\n        ctx.fill();\n\n        const progress = Math.min(p.current / p.target, 1);\n        if (progress > 0) {\n          const grad = ctx.createLinearGradient(bx, barY, bx + halfBarW * progress, barY);\n          grad.addColorStop(0, i === 0 ? '#6BCB77' : '#4DA6FF');\n          grad.addColorStop(1, i === 0 ? '#4DA66B' : '#3388DD');\n          ctx.fillStyle = grad;\n          this._roundRect(ctx, bx, barY, halfBarW * progress, barH, 8);\n          ctx.fill();\n        }\n\n        ctx.fillStyle = '#5D4037';\n        ctx.font = 'bold 10px sans-serif';\n        ctx.fillText(`${p.current}/${p.target}`, bx + halfBarW / 2, barY + 13);\n      }\n    }\n\n    // Bottom hint\n    ctx.fillStyle = '#8D6E63';\n    ctx.font = '14px sans-serif';\n    ctx.textAlign = 'center';\n    const hintY = this.boardY + this.tileSize * BOARD_SIZE + 30;\n    // Don't overlap with boss health bar\n    const hintOffset = scoreSystem.goalType === 'boss' ? 0 : 30;\n    ctx.fillText('滑动交换相邻方块', this.screenW / 2, hintY + hintOffset);\n  }\n\n  drawComboText(text) {\n    if (!text) return;\n    const ctx = this.ctx;\n    ctx.save();\n    ctx.fillStyle = '#FF4D4D';\n    ctx.font = 'bold 36px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.shadowColor = '#FFB800';\n    ctx.shadowBlur = 8;\n    ctx.fillText(text, this.screenW / 2, this.boardY + this.tileSize * BOARD_SIZE / 2);\n    ctx.restore();\n  }\n\n  addFloatingText(text, x, y, color = '#FF4D4D') {\n    this.floatingTexts.push({ text, x, y, alpha: 1, vy: -60, life: 1.0, color });\n  }\n\n  updateAndDrawFloatingTexts(dt) {\n    const ctx = this.ctx;\n    this.floatingTexts = this.floatingTexts.filter(ft => {\n      ft.y += ft.vy * dt;\n      ft.life -= dt;\n      ft.alpha = Math.max(0, ft.life);\n      if (ft.life <= 0) return false;\n\n      ctx.globalAlpha = ft.alpha;\n      ctx.fillStyle = ft.color;\n      ctx.font = 'bold 18px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText(ft.text, ft.x, ft.y);\n      ctx.globalAlpha = 1;\n      return true;\n    });\n  }\n\n  drawResultScreen(won, score, stars, level) {\n    const ctx = this.ctx;\n    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n    ctx.fillRect(0, 0, this.screenW, this.screenH);\n\n    const pw = Math.min(320, this.screenW - 40);\n    const ph = 260;\n    const px = (this.screenW - pw) / 2;\n    const py = (this.screenH - ph) / 2;\n\n    ctx.fillStyle = '#FFF8E7';\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.fill();\n    ctx.strokeStyle = '#FFB800';\n    ctx.lineWidth = 3;\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.stroke();\n\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 24px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(won ? '🎉 恭喜过关！' : '😢 挑战失败', this.screenW / 2, py + 45);\n\n    ctx.font = 'bold 36px sans-serif';\n    ctx.fillStyle = '#FFB800';\n    ctx.fillText(score, this.screenW / 2, py + 95);\n    ctx.font = '14px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText('得分', this.screenW / 2, py + 115);\n\n    if (won) {\n      for (let i = 0; i < 3; i++) {\n        ctx.font = '32px sans-serif';\n        ctx.fillText(i < stars ? '⭐' : '☆', this.screenW / 2 - 45 + i * 45, py + 160);\n      }\n    }\n\n    const btnW = 120, btnH = 42;\n    const btnY = py + ph - 60;\n\n    ctx.fillStyle = '#6BCB77';\n    this._roundRect(ctx, this.screenW / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n    ctx.fill();\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = 'bold 16px sans-serif';\n    ctx.fillText(won ? '下一关' : '重试', this.screenW / 2 - btnW / 2 - 10, btnY + 27);\n\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, this.screenW / 2 + 10, btnY, btnW, btnH, btnH / 2);\n    ctx.fill();\n    ctx.fillStyle = '#FFFFFF';\n    ctx.fillText('菜单', this.screenW / 2 + btnW / 2 + 10, btnY + 27);\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Renderer };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"4fc1920c-0b5c-4266-b43d-05c38f749fa3","uuid":"b197563c-556b-42b3-a3c4-a3883e0a7e55"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a2c9f980ffb84c6a95f1d0ee","type":"tool_result","content":"The file D:/game-projects/douyin-match3/src/js/Renderer.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"4fc1920c-0b5c-4266-b43d-05c38f749fa3","uuid":"b056f798-bf57-48e6-84c2-2477390a2b44","timestamp":"2026-05-22T21:33:47.775Z","tool_use_result":{"type":"update","filePath":"D:/game-projects/douyin-match3/src/js/Renderer.js","content":"// Renderer.js — Canvas 2D rendering engine with obstacle, boss, and updated UI support\n\nclass Renderer {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d');\n    this.tileSize = 0;\n    this.boardX = 0;\n    this.boardY = 0;\n    this.particleSystem = null;\n    this.floatingTexts = [];\n    this.resize();\n  }\n\n  resize() {\n    const dpr = window.devicePixelRatio || 1;\n    const w = window.innerWidth;\n    const h = window.innerHeight;\n    this.canvas.width = w * dpr;\n    this.canvas.height = h * dpr;\n    this.canvas.style.width = w + 'px';\n    this.canvas.style.height = h + 'px';\n    this.ctx.scale(dpr, dpr);\n    this.screenW = w;\n    this.screenH = h;\n\n    this.tileSize = Math.floor(Math.min(w * 0.9, (h - 160)) / BOARD_SIZE);\n    this.boardX = (w - this.tileSize * BOARD_SIZE) / 2;\n    this.boardY = 140;\n  }\n\n  getTileCenter(row, col) {\n    return {\n      x: this.boardX + col * this.tileSize + this.tileSize / 2,\n      y: this.boardY + row * this.tileSize + this.tileSize / 2,\n    };\n  }\n\n  clear() {\n    this.ctx.clearRect(0, 0, this.screenW, this.screenH);\n  }\n\n  drawBackground() {\n    const ctx = this.ctx;\n    ctx.fillStyle = '#FFF8E7';\n    ctx.fillRect(0, 0, this.screenW, this.screenH);\n\n    const bw = this.tileSize * BOARD_SIZE;\n    const bh = this.tileSize * BOARD_SIZE;\n    ctx.fillStyle = '#FFFFFFCC';\n    this._roundRect(ctx, this.boardX - 6, this.boardY - 6, bw + 12, bh + 12, 12);\n    ctx.fill();\n\n    ctx.strokeStyle = '#F0E6D6';\n    ctx.lineWidth = 1;\n    for (let i = 0; i <= BOARD_SIZE; i++) {\n      ctx.beginPath();\n      ctx.moveTo(this.boardX + i * this.tileSize, this.boardY);\n      ctx.lineTo(this.boardX + i * this.tileSize, this.boardY + bh);\n      ctx.stroke();\n      ctx.beginPath();\n      ctx.moveTo(this.boardX, this.boardY + i * this.tileSize);\n      ctx.lineTo(this.boardX + bw, this.boardY + i * this.tileSize);\n      ctx.stroke();\n    }\n  }\n\n  drawTile(tile) {\n    if (!tile || tile.color < 0) return;\n    const ctx = this.ctx;\n    const size = this.tileSize - 4;\n    const cx = this.boardX + tile.col * this.tileSize + this.tileSize / 2 + (tile.offsetX || 0);\n    const cy = this.boardY + tile.row * this.tileSize + this.tileSize / 2 + (tile.offsetY || 0);\n    const scale = tile.scale || 1;\n    const alpha = tile.alpha !== undefined ? tile.alpha : 1;\n\n    ctx.save();\n    ctx.translate(cx, cy);\n    ctx.scale(scale, scale);\n    ctx.globalAlpha = alpha;\n\n    const half = size / 2;\n    const color = COLOR_MAP[tile.color];\n    if (!color) { ctx.restore(); return; }\n\n    ctx.fillStyle = color.hex;\n    this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n    ctx.fill();\n\n    ctx.fillStyle = 'rgba(255,255,255,0.25)';\n    this._roundRect(ctx, -half + 3, -half + 3, size - 6, size / 2 - 3, size * 0.15);\n    ctx.fill();\n\n    this._drawFruitIcon(ctx, tile.color, half * 0.55);\n\n    if (tile.special === SPECIAL_STRIPED_H) {\n      this._drawStripes(ctx, size, half, '#FFFFFF80', true);\n    } else if (tile.special === SPECIAL_STRIPED_V) {\n      this._drawStripes(ctx, size, half, '#FFFFFF80', false);\n    } else if (tile.special === SPECIAL_BOMB) {\n      this._drawCrosshair(ctx, half);\n    } else if (tile.special === SPECIAL_RAINBOW) {\n      this._drawRainbowOverlay(ctx, half);\n    }\n\n    if (tile.selected) {\n      ctx.strokeStyle = '#FFFFFF';\n      ctx.lineWidth = 3;\n      ctx.shadowColor = '#FFB800';\n      ctx.shadowBlur = 12;\n      this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n      ctx.stroke();\n      ctx.shadowBlur = 0;\n    }\n\n    ctx.restore();\n  }\n\n  _drawFruitIcon(ctx, colorIdx, radius) {\n    ctx.fillStyle = 'rgba(255,255,255,0.6)';\n    ctx.font = `bold ${radius * 1.4}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    const icons = ['🍎', '🍌', '🫐', '🍏', '🍇', '🍊'];\n    ctx.fillText(icons[colorIdx] || '', 0, 1);\n  }\n\n  _drawStripes(ctx, size, half, color, horizontal) {\n    ctx.strokeStyle = color;\n    ctx.lineWidth = 2;\n    if (horizontal) {\n      for (let y = -half + 6; y < half; y += 8) {\n        ctx.beginPath();\n        ctx.moveTo(-half + 4, y);\n        ctx.lineTo(half - 4, y);\n        ctx.stroke();\n      }\n    } else {\n      for (let x = -half + 6; x < half; x += 8) {\n        ctx.beginPath();\n        ctx.moveTo(x, -half + 4);\n        ctx.lineTo(x, half - 4);\n        ctx.stroke();\n      }\n    }\n  }\n\n  _drawCrosshair(ctx, half) {\n    ctx.strokeStyle = '#FFFFFF99';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.moveTo(-half * 0.6, 0); ctx.lineTo(half * 0.6, 0);\n    ctx.moveTo(0, -half * 0.6); ctx.lineTo(0, half * 0.6);\n    ctx.stroke();\n    ctx.beginPath();\n    ctx.arc(0, 0, half * 0.4, 0, Math.PI * 2);\n    ctx.stroke();\n  }\n\n  _drawRainbowOverlay(ctx, half) {\n    const gradient = ctx.createLinearGradient(-half, -half, half, half);\n    gradient.addColorStop(0, '#FF000080');\n    gradient.addColorStop(0.17, '#FF880080');\n    gradient.addColorStop(0.33, '#FFFF0080');\n    gradient.addColorStop(0.5, '#00FF0080');\n    gradient.addColorStop(0.67, '#0088FF80');\n    gradient.addColorStop(0.83, '#8800FF80');\n    gradient.addColorStop(1, '#FF008880');\n    ctx.fillStyle = gradient;\n    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.4);\n    ctx.fill();\n  }\n\n  // Draw all obstacles\n  drawObstacles(obstacleMgr) {\n    for (const obs of obstacleMgr.obstacles) {\n      if (obs.isDestroyed()) continue;\n      const shake = obs.shakeTimer > 0 ? (Math.random() - 0.5) * 4 : 0;\n      const pos = this.getTileCenter(obs.row, obs.col);\n      const half = (this.tileSize - 4) / 2;\n\n      this.ctx.save();\n      this.ctx.translate(pos.x + shake, pos.y);\n\n      switch (obs.type) {\n        case OBSTACLE_ICE:\n          this._drawIce(this.ctx, half);\n          break;\n        case OBSTACLE_CHAIN:\n          this._drawChain(this.ctx, half);\n          break;\n        case OBSTACLE_CHOCOLATE:\n          this._drawChocolate(this.ctx, half);\n          break;\n      }\n\n      this.ctx.restore();\n    }\n  }\n\n  _drawIce(ctx, half) {\n    // Translucent blue overlay\n    ctx.fillStyle = 'rgba(135, 206, 250, 0.45)';\n    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.2);\n    ctx.fill();\n    // Ice crack pattern\n    ctx.strokeStyle = 'rgba(255, 255, 255, 0.7)';\n    ctx.lineWidth = 1.5;\n    ctx.beginPath();\n    ctx.moveTo(-half * 0.3, -half * 0.5);\n    ctx.lineTo(half * 0.2, 0);\n    ctx.lineTo(-half * 0.1, half * 0.4);\n    ctx.stroke();\n    ctx.beginPath();\n    ctx.moveTo(half * 0.3, -half * 0.3);\n    ctx.lineTo(0, half * 0.1);\n    ctx.stroke();\n    // Ice label\n    ctx.fillStyle = 'rgba(255,255,255,0.8)';\n    ctx.font = `bold ${half * 0.6}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText('❄', 0, 0);\n  }\n\n  _drawChain(ctx, half) {\n    // Chain icon overlay\n    ctx.fillStyle = 'rgba(100, 100, 100, 0.35)';\n    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.2);\n    ctx.fill();\n    // Chain links\n    ctx.strokeStyle = 'rgba(80, 80, 80, 0.9)';\n    ctx.lineWidth = 3;\n    for (let i = -1; i <= 1; i++) {\n      ctx.beginPath();\n      ctx.ellipse(i * half * 0.5, 0, half * 0.25, half * 0.15, 0, 0, Math.PI * 2);\n      ctx.stroke();\n    }\n    // Lock icon\n    ctx.fillStyle = 'rgba(255,255,255,0.7)';\n    ctx.font = `bold ${half * 0.7}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText('🔗', 0, -half * 0.6);\n  }\n\n  _drawChocolate(ctx, half) {\n    // Brown blob\n    ctx.fillStyle = '#6B3410';\n    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.3);\n    ctx.fill();\n    // Chocolate drip pattern\n    ctx.fillStyle = '#8B5E3C';\n    this._roundRect(ctx, -half + 3, -half + 3, half * 2 - 6, half * 2 - 6, half * 0.25);\n    ctx.fill();\n    // Shine\n    ctx.fillStyle = 'rgba(255,255,255,0.15)';\n    this._roundRect(ctx, -half + 6, -half + 6, half - 3, half * 0.6, half * 0.15);\n    ctx.fill();\n    // Emoji\n    ctx.font = `bold ${half * 0.8}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText('🍫', 0, 0);\n  }\n\n  // Draw boss on board\n  drawBoss(boss, renderer) {\n    const pos = this.getTileCenter(boss.row, boss.col);\n    const half = (this.tileSize - 4) / 2;\n    const shake = boss.shakeTimer > 0 ? (Math.random() - 0.5) * 6 : 0;\n\n    this.ctx.save();\n    this.ctx.translate(pos.x + shake, pos.y);\n\n    // Boss body\n    const isUsingSkill = boss.skillAnimTimer > 0;\n    const pulseScale = isUsingSkill ? 1.1 : 1;\n    this.ctx.scale(pulseScale, pulseScale);\n\n    // Dark aura\n    this.ctx.fillStyle = isUsingSkill ? 'rgba(255,0,0,0.15)' : 'rgba(80,0,80,0.1)';\n    this.ctx.beginPath();\n    this.ctx.arc(0, 0, half * 1.3, 0, Math.PI * 2);\n    this.ctx.fill();\n\n    // Boss face\n    this.ctx.fillStyle = '#4A0E4E';\n    this._roundRect(this.ctx, -half, -half, half * 2, half * 2, half * 0.3);\n    this.ctx.fill();\n\n    // Inner glow\n    const grad = this.ctx.createRadialGradient(0, 0, 0, 0, 0, half);\n    grad.addColorStop(0, 'rgba(255,100,200,0.3)');\n    grad.addColorStop(1, 'rgba(80,0,120,0.1)');\n    this.ctx.fillStyle = grad;\n    this._roundRect(this.ctx, -half, -half, half * 2, half * 2, half * 0.3);\n    this.ctx.fill();\n\n    // Boss emoji\n    this.ctx.font = `bold ${half * 1.2}px sans-serif`;\n    this.ctx.textAlign = 'center';\n    this.ctx.textBaseline = 'middle';\n    const hpRatio = boss.hp / boss.maxHp;\n    const bossEmoji = hpRatio > 0.5 ? '👹' : hpRatio > 0.25 ? '👿' : '💀';\n    this.ctx.fillText(bossEmoji, 0, 0);\n\n    this.ctx.restore();\n  }\n\n  // Draw boss health bar above the board\n  drawBossHealthBar(boss) {\n    const ctx = this.ctx;\n    const barW = Math.min(200, this.screenW - 40);\n    const barH = 14;\n    const barX = (this.screenW - barW) / 2;\n    const barY = this.boardY + this.tileSize * BOARD_SIZE + 50;\n\n    // Background\n    ctx.fillStyle = '#E0D5C5';\n    this._roundRect(ctx, barX, barY, barW, barH, 7);\n    ctx.fill();\n\n    // HP bar\n    const hpRatio = Math.max(0, boss.hp / boss.maxHp);\n    if (hpRatio > 0) {\n      const grad = ctx.createLinearGradient(barX, barY, barX + barW * hpRatio, barY);\n      grad.addColorStop(0, '#FF4D4D');\n      grad.addColorStop(1, '#CC0000');\n      ctx.fillStyle = grad;\n      this._roundRect(ctx, barX, barY, barW * hpRatio, barH, 7);\n      ctx.fill();\n    }\n\n    // Boss name and HP text\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 12px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(`${boss.name}  ${boss.hp}/${boss.maxHp}`, this.screenW / 2, barY + barH + 14);\n  }\n\n  // Updated drawUI to support new goal types\n  drawUI(score, moves, config, scoreSystem, level) {\n    const ctx = this.ctx;\n\n    // Top bar background\n    ctx.fillStyle = '#FFB800';\n    this._roundRect(ctx, 8, 8, this.screenW - 16, 55, 12);\n    ctx.fill();\n\n    // Level\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 18px sans-serif';\n    ctx.textAlign = 'left';\n    ctx.fillText(`第 ${level} 关`, 20, 42);\n\n    // Level name\n    if (config.name) {\n      ctx.font = '12px sans-serif';\n      ctx.fillText(config.name, 20, 22);\n    }\n\n    // Score\n    ctx.textAlign = 'center';\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.fillText(`${score}`, this.screenW / 2, 32);\n    ctx.font = '12px sans-serif';\n    ctx.fillText('分数', this.screenW / 2, 48);\n\n    // Moves\n    ctx.textAlign = 'right';\n    ctx.fillStyle = moves <= 5 ? '#FF4D4D' : '#5D4037';\n    ctx.font = 'bold 22px sans-serif';\n    ctx.fillText(`${moves}`, this.screenW - 20, 32);\n    ctx.font = '12px sans-serif';\n    ctx.fillStyle = '#5D4037';\n    ctx.fillText('剩余步数', this.screenW - 20, 48);\n\n    // Goal progress — use the new goal description\n    const goalDesc = scoreSystem.getGoalDescription();\n    const progressBars = scoreSystem.getProgressForUI();\n\n    const barW = this.screenW - 40;\n    const barH = 16;\n    const barY = 72;\n    const barX = 20;\n\n    // Goal label\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 11px sans-serif';\n    ctx.textAlign = 'center';\n\n    if (progressBars.length === 1) {\n      // Single goal — progress bar\n      const p = progressBars[0];\n      ctx.fillStyle = '#E0D5C5';\n      this._roundRect(ctx, barX, barY, barW, barH, 8);\n      ctx.fill();\n\n      const progress = Math.min(p.current / p.target, 1);\n      if (progress > 0) {\n        const grad = ctx.createLinearGradient(barX, barY, barX + barW * progress, barY);\n        grad.addColorStop(0, '#6BCB77');\n        grad.addColorStop(1, '#4DA66B');\n        ctx.fillStyle = grad;\n        this._roundRect(ctx, barX, barY, barW * progress, barH, 8);\n        ctx.fill();\n      }\n\n      ctx.fillStyle = '#5D4037';\n      ctx.font = 'bold 11px sans-serif';\n      ctx.fillText(goalDesc, this.screenW / 2, barY + 13);\n    } else {\n      // Dual goal — two smaller bars\n      const halfBarW = (barW - 10) / 2;\n      for (let i = 0; i < progressBars.length; i++) {\n        const p = progressBars[i];\n        const bx = barX + i * (halfBarW + 10);\n\n        ctx.fillStyle = '#E0D5C5';\n        this._roundRect(ctx, bx, barY, halfBarW, barH, 8);\n        ctx.fill();\n\n        const progress = Math.min(p.current / p.target, 1);\n        if (progress > 0) {\n          const grad = ctx.createLinearGradient(bx, barY, bx + halfBarW * progress, barY);\n          grad.addColorStop(0, i === 0 ? '#6BCB77' : '#4DA6FF');\n          grad.addColorStop(1, i === 0 ? '#4DA66B' : '#3388DD');\n          ctx.fillStyle = grad;\n          this._roundRect(ctx, bx, barY, halfBarW * progress, barH, 8);\n          ctx.fill();\n        }\n\n        ctx.fillStyle = '#5D4037';\n        ctx.font = 'bold 10px sans-serif';\n        ctx.fillText(`${p.current}/${p.target}`, bx + halfBarW / 2, barY + 13);\n      }\n    }\n\n    // Bottom hint\n    ctx.fillStyle = '#8D6E63';\n    ctx.font = '14px sans-serif';\n    ctx.textAlign = 'center';\n    const hintY = this.boardY + this.tileSize * BOARD_SIZE + 30;\n    // Don't overlap with boss health bar\n    const hintOffset = scoreSystem.goalType === 'boss' ? 0 : 30;\n    ctx.fillText('滑动交换相邻方块', this.screenW / 2, hintY + hintOffset);\n  }\n\n  drawComboText(text) {\n    if (!text) return;\n    const ctx = this.ctx;\n    ctx.save();\n    ctx.fillStyle = '#FF4D4D';\n    ctx.font = 'bold 36px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.shadowColor = '#FFB800';\n    ctx.shadowBlur = 8;\n    ctx.fillText(text, this.screenW / 2, this.boardY + this.tileSize * BOARD_SIZE / 2);\n    ctx.restore();\n  }\n\n  addFloatingText(text, x, y, color = '#FF4D4D') {\n    this.floatingTexts.push({ text, x, y, alpha: 1, vy: -60, life: 1.0, color });\n  }\n\n  updateAndDrawFloatingTexts(dt) {\n    const ctx = this.ctx;\n    this.floatingTexts = this.floatingTexts.filter(ft => {\n      ft.y += ft.vy * dt;\n      ft.life -= dt;\n      ft.alpha = Math.max(0, ft.life);\n      if (ft.life <= 0) return false;\n\n      ctx.globalAlpha = ft.alpha;\n      ctx.fillStyle = ft.color;\n      ctx.font = 'bold 18px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText(ft.text, ft.x, ft.y);\n      ctx.globalAlpha = 1;\n      return true;\n    });\n  }\n\n  drawResultScreen(won, score, stars, level) {\n    const ctx = this.ctx;\n    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n    ctx.fillRect(0, 0, this.screenW, this.screenH);\n\n    const pw = Math.min(320, this.screenW - 40);\n    const ph = 260;\n    const px = (this.screenW - pw) / 2;\n    const py = (this.screenH - ph) / 2;\n\n    ctx.fillStyle = '#FFF8E7';\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.fill();\n    ctx.strokeStyle = '#FFB800';\n    ctx.lineWidth = 3;\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.stroke();\n\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 24px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(won ? '🎉 恭喜过关！' : '😢 挑战失败', this.screenW / 2, py + 45);\n\n    ctx.font = 'bold 36px sans-serif';\n    ctx.fillStyle = '#FFB800';\n    ctx.fillText(score, this.screenW / 2, py + 95);\n    ctx.font = '14px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText('得分', this.screenW / 2, py + 115);\n\n    if (won) {\n      for (let i = 0; i < 3; i++) {\n        ctx.font = '32px sans-serif';\n        ctx.fillText(i < stars ? '⭐' : '☆', this.screenW / 2 - 45 + i * 45, py + 160);\n      }\n    }\n\n    const btnW = 120, btnH = 42;\n    const btnY = py + ph - 60;\n\n    ctx.fillStyle = '#6BCB77';\n    this._roundRect(ctx, this.screenW / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n    ctx.fill();\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = 'bold 16px sans-serif';\n    ctx.fillText(won ? '下一关' : '重试', this.screenW / 2 - btnW / 2 - 10, btnY + 27);\n\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, this.screenW / 2 + 10, btnY, btnW, btnH, btnH / 2);\n    ctx.fill();\n    ctx.fillStyle = '#FFFFFF';\n    ctx.fillText('菜单', this.screenW / 2 + btnW / 2 + 10, btnY + 27);\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Renderer };\n","structuredPatch":[{"oldStart":1,"oldLines":4,"newStart":1,"newLines":4,"lines":["-// Renderer.js — Canvas 2D rendering engine for the match-3 board","+// Renderer.js — Canvas 2D rendering engine with obstacle, boss, and updated UI support"," "," class Renderer {","   constructor(canvas) {"]},{"oldStart":24,"oldLines":7,"newStart":24,"newLines":6,"lines":["     this.screenW = w;","     this.screenH = h;"," ","-    // Board layout: centered, leave room for top UI","     this.tileSize = Math.floor(Math.min(w * 0.9, (h - 160)) / BOARD_SIZE);","     this.boardX = (w - this.tileSize * BOARD_SIZE) / 2;","     this.boardY = 140;"]},{"oldStart":43,"oldLines":18,"newStart":42,"newLines":15,"lines":[" ","   drawBackground() {","     const ctx = this.ctx;","-    // Cream background","     ctx.fillStyle = '#FFF8E7';","     ctx.fillRect(0, 0, this.screenW, this.screenH);"," ","-    // Board background","     const bw = this.tileSize * BOARD_SIZE;","     const bh = this.tileSize * BOARD_SIZE;","     ctx.fillStyle = '#FFFFFFCC';","     this._roundRect(ctx, this.boardX - 6, this.boardY - 6, bw + 12, bh + 12, 12);","     ctx.fill();"," ","-    // Grid lines (subtle)","     ctx.strokeStyle = '#F0E6D6';","     ctx.lineWidth = 1;","     for (let i = 0; i <= BOARD_SIZE; i++) {"]},{"oldStart":87,"oldLines":20,"newStart":83,"newLines":16,"lines":["     const color = COLOR_MAP[tile.color];","     if (!color) { ctx.restore(); return; }"," ","-    // Tile body","     ctx.fillStyle = color.hex;","     this._roundRect(ctx, -half, -half, size, size, size * 0.2);","     ctx.fill();"," ","-    // Highlight","     ctx.fillStyle = 'rgba