{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_4daff52f02ce48d0ae6b69a5","type":"tool_result","content":"1\t// AudioManager.ts — Web Audio API sound framework with procedural generation\n2\t\n3\texport class AudioManager {\n4\t  private ctx: AudioContext | null = null;\n5\t  private masterGain: GainNode | null = null;\n6\t  private volume = 0.5;\n7\t  private muted = false;\n8\t\n9\t  init(): void {\n10\t    if (this.ctx) return;\n11\t    try {\n12\t      this.ctx = new AudioContext();\n13\t      this.masterGain = this.ctx.createGain();\n14\t      this.masterGain.gain.value = this.volume;\n15\t      this.masterGain.connect(this.ctx.destination);\n16\t    } catch {\n17\t      console.warn('AudioManager: Web Audio API not available');\n18\t    }\n19\t  }\n20\t\n21\t  resume(): void {\n22\t    if (this.ctx?.state === 'suspended') {\n23\t      this.ctx.resume();\n24\t    }\n25\t  }\n26\t\n27\t  setVolume(vol: number): void {\n28\t    this.volume = Math.max(0, Math.min(1, vol));\n29\t    if (this.masterGain) {\n30\t      this.masterGain.gain.value = this.volume;\n31\t    }\n32\t  }\n33\t\n34\t  toggleMute(): boolean {\n35\t    this.muted = !this.muted;\n36\t    if (this.masterGain) {\n37\t      this.masterGain.gain.value = this.muted ? 0 : this.volume;\n38\t    }\n39\t    return this.muted;\n40\t  }\n41\t\n42\t  get isMuted(): boolean {\n43\t    return this.muted;\n44\t  }\n45\t\n46\t  get currentVolume(): number {\n47\t    return this.volume;\n48\t  }\n49\t\n50\t  private playTone(\n51\t    freq: number,\n52\t    duration: number,\n53\t    type: OscillatorType = 'sine',\n54\t    gainValue: number = 0.3,\n55\t    freqEnd?: number,\n56\t  ): void {\n57\t    if (!this.ctx || !this.masterGain) return;\n58\t\n59\t    const osc = this.ctx.createOscillator();\n60\t    const gain = this.ctx.createGain();\n61\t\n62\t    osc.type = type;\n63\t    osc.frequency.setValueAtTime(freq, this.ctx.currentTime);\n64\t    if (freqEnd) {\n65\t      osc.frequency.linearRampToValueAtTime(freqEnd, this.ctx.currentTime + duration);\n66\t    }\n67\t\n68\t    gain.gain.setValueAtTime(gainValue, this.ctx.currentTime);\n69\t    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);\n70\t\n71\t    osc.connect(gain);\n72\t    gain.connect(this.masterGain);\n73\t\n74\t    osc.start(this.ctx.currentTime);\n75\t    osc.stop(this.ctx.currentTime + duration);\n76\t  }\n77\t\n78\t  private playNoise(duration: number, gainValue: number = 0.1): void {\n79\t    if (!this.ctx || !this.masterGain) return;\n80\t\n81\t    const bufferSize = this.ctx.sampleRate * duration;\n82\t    const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);\n83\t    const data = buffer.getChannelData(0);\n84\t    for (let i = 0; i < bufferSize; i++) {\n85\t      data[i] = (Math.random() * 2 - 1) * 0.5;\n86\t    }\n87\t\n88\t    const source = this.ctx.createBufferSource();\n89\t    source.buffer = buffer;\n90\t\n91\t    const gain = this.ctx.createGain();\n92\t    gain.gain.setValueAtTime(gainValue, this.ctx.currentTime);\n93\t    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);\n94\t\n95\t    source.connect(gain);\n96\t    gain.connect(this.masterGain);\n97\t    source.start();\n98\t  }\n99\t\n100\t  // === Sound Effects ===\n101\t\n102\t  playCollect(): void {\n103\t    this.init();\n104\t    this.playTone(800, 0.1, 'sine', 0.2);\n105\t    setTimeout(() => this.playTone(1200, 0.08, 'sine', 0.15), 50);\n106\t  }\n107\t\n108\t  playHarvest(): void {\n109\t    this.init();\n110\t    this.playTone(600, 0.12, 'triangle', 0.2);\n111\t    setTimeout(() => this.playTone(900, 0.1, 'triangle', 0.15), 80);\n112\t  }\n113\t\n114\t  playBuild(): void {\n115\t    this.init();\n116\t    this.playTone(200, 0.15, 'square', 0.15);\n117\t    this.playNoise(0.1, 0.05);\n118\t  }\n119\t\n120\t  playAlchemyStart(): void {\n121\t    this.init();\n122\t    this.playTone(400, 0.2, 'sine', 0.15);\n123\t    setTimeout(() => this.playTone(500, 0.2, 'sine', 0.15), 150);\n124\t  }\n125\t\n126\t  playAlchemyComplete(): void {\n127\t    this.init();\n128\t    this.playTone(800, 0.15, 'sine', 0.25);\n129\t    setTimeout(() => this.playTone(1000, 0.15, 'sine', 0.2), 100);\n130\t    setTimeout(() => this.playTone(1200, 0.2, 'sine', 0.25), 200);\n131\t  }\n132\t\n133\t  playAlchemyFail(): void {\n134\t    this.init();\n135\t    this.playTone(300, 0.3, 'sawtooth', 0.15);\n136\t    setTimeout(() => this.playTone(200, 0.4, 'sawtooth', 0.1), 200);\n137\t  }\n138\t\n139\t  playBreakthroughStart(): void {\n140\t    this.init();\n141\t    // Rising tone sequence\n142\t    const notes = [400, 500, 600, 700, 800, 1000, 1200];\n143\t    notes.forEach((freq, i) => {\n144\t      setTimeout(() => this.playTone(freq, 0.3, 'sine', 0.2), i * 150);\n145\t    });\n146\t  }\n147\t\n148\t  playBreakthroughSuccess(): void {\n149\t    this.init();\n150\t    // Triumphant ascending scale\n151\t    const notes = [523, 659, 784, 1047, 1319];\n152\t    notes.forEach((freq, i) => {\n153\t      setTimeout(() => {\n154\t        this.playTone(freq, 0.4, 'sine', 0.3);\n155\t        this.playTone(freq * 1.5, 0.4, 'sine', 0.15);\n156\t      }, i * 200);\n157\t    });\n158\t    // Final shimmer\n159\t    setTimeout(() => {\n160\t      for (let i = 0; i < 5; i++) {\n161\t        setTimeout(() => this.playTone(2000 + i * 200, 0.3, 'sine', 0.1), i * 50);\n162\t      }\n163\t    }, 1200);\n164\t  }\n165\t\n166\t  playBreakthroughFail(): void {\n167\t    this.init();\n168\t    this.playTone(300, 0.5, 'sawtooth', 0.2);\n169\t    setTimeout(() => this.playTone(200, 0.6, 'sawtooth', 0.15), 300);\n170\t    this.playNoise(0.3, 0.08);\n171\t  }\n172\t\n173\t  playUsePill(): void {\n174\t    this.init();\n175\t    this.playTone(600, 0.1, 'sine', 0.15);\n176\t    setTimeout(() => this.playTone(800, 0.1, 'sine', 0.15), 80);\n177\t    setTimeout(() => this.playTone(1000, 0.15, 'sine', 0.1), 160);\n178\t  }\n179\t\n180\t  playButtonClick(): void {\n181\t    this.init();\n182\t    this.playTone(1000, 0.05, 'sine', 0.1);\n183\t  }\n184\t\n185\t  playLevelUp(): void {\n186\t    this.init();\n187\t    this.playTone(523, 0.15, 'sine', 0.2);\n188\t    setTimeout(() => this.playTone(659, 0.15, 'sine', 0.2), 120);\n189\t    setTimeout(() => this.playTone(784, 0.2, 'sine', 0.25), 240);\n190\t  }\n191\t}\n192\t\n193\t// Singleton\n194\texport const audioManager = new AudioManager();\n195\t"}]},"parent_tool_use_id":"call_a5a9e75d09cd453897e0e9b2","session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"90f0762b-f695-4c0a-a924-b85d4b3b8e8c","timestamp":"2026-05-23T01:53:57.985Z","subagent_type":"Explore","task_description":"Read M3 core game files"}
