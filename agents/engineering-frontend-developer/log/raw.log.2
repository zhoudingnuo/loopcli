{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a9c184994a854e45ad3c43c9","type":"tool_result","content":"1\t// Animation.js — Easing functions, tween system, particle effects\n2\t\n3\t// Easing functions\n4\tconst Easing = {\n5\t  linear: t => t,\n6\t  easeInQuad: t => t * t,\n7\t  easeOutQuad: t => t * (2 - t),\n8\t  easeInOutQuad: t => t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t,\n9\t  easeOutBack: t => {\n10\t    const s = 1.70158;\n11\t    return (t -= 1) * t * ((s + 1) * t + s) + 1;\n12\t  },\n13\t  easeOutBounce: t => {\n14\t    if (t < 1 / 2.75) return 7.5625 * t * t;\n15\t    if (t < 2 / 2.75) return 7.5625 * (t -= 1.5 / 2.75) * t + 0.75;\n16\t    if (t < 2.5 / 2.75) return 7.5625 * (t -= 2.25 / 2.75) * t + 0.9375;\n17\t    return 7.5625 * (t -= 2.625 / 2.75) * t + 0.984375;\n18\t  },\n19\t  easeOutElastic: t => {\n20\t    if (t === 0 || t === 1) return t;\n21\t    return Math.pow(2, -10 * t) * Math.sin((t - 0.075) * (2 * Math.PI) / 0.3) + 1;\n22\t  },\n23\t};\n24\t\n25\tclass Tween {\n26\t  constructor(target, props, duration, easing = 'easeOutQuad', onComplete = null) {\n27\t    this.target = target;\n28\t    this.startProps = {};\n29\t    this.endProps = props;\n30\t    this.duration = duration;\n31\t    this.easingFn = Easing[easing] || Easing.easeOutQuad;\n32\t    this.onComplete = onComplete;\n33\t    this.elapsed = 0;\n34\t    this.done = false;\n35\t\n36\t    for (const key in props) {\n37\t      this.startProps[key] = target[key];\n38\t    }\n39\t  }\n40\t\n41\t  update(dt) {\n42\t    if (this.done) return true;\n43\t    this.elapsed += dt;\n44\t    let t = Math.min(this.elapsed / this.duration, 1);\n45\t    const easedT = this.easingFn(t);\n46\t\n47\t    for (const key in this.endProps) {\n48\t      this.target[key] = this.startProps[key] + (this.endProps[key] - this.startProps[key]) * easedT;\n49\t    }\n50\t\n51\t    if (t >= 1) {\n52\t      this.done = true;\n53\t      if (this.onComplete) this.onComplete();\n54\t      return true;\n55\t    }\n56\t    return false;\n57\t  }\n58\t}\n59\t\n60\tclass TweenManager {\n61\t  constructor() {\n62\t    this.tweens = [];\n63\t  }\n64\t\n65\t  add(target, props, duration, easing, onComplete) {\n66\t    const tween = new Tween(target, props, duration, easing, onComplete);\n67\t    this.tweens.push(tween);\n68\t    return tween;\n69\t  }\n70\t\n71\t  update(dt) {\n72\t    this.tweens = this.tweens.filter(t => !t.update(dt));\n73\t  }\n74\t\n75\t  clear() {\n76\t    this.tweens = [];\n77\t  }\n78\t\n79\t  get activeCount() {\n80\t    return this.tweens.length;\n81\t  }\n82\t}\n83\t\n84\t// Particle system for match effects\n85\tclass Particle {\n86\t  constructor(x, y, vx, vy, color, life, size) {\n87\t    this.x = x;\n88\t    this.y = y;\n89\t    this.vx = vx;\n90\t    this.vy = vy;\n91\t    this.color = color;\n92\t    this.life = life;\n93\t    this.maxLife = life;\n94\t    this.size = size;\n95\t    this.alpha = 1;\n96\t  }\n97\t\n98\t  update(dt) {\n99\t    this.x += this.vx * dt;\n100\t    this.y += this.vy * dt;\n101\t    this.vy += 200 * dt; // gravity\n102\t    this.life -= dt;\n103\t    this.alpha = Math.max(0, this.life / this.maxLife);\n104\t    return this.life <= 0;\n105\t  }\n106\t}\n107\t\n108\tclass ParticleSystem {\n109\t  constructor() {\n110\t    this.particles = [];\n111\t  }\n112\t\n113\t  emit(x, y, color, count = 8) {\n114\t    for (let i = 0; i < count; i++) {\n115\t      const angle = (Math.PI * 2 / count) * i + Math.random() * 0.5;\n116\t      const speed = 80 + Math.random() * 120;\n117\t      const vx = Math.cos(angle) * speed;\n118\t      const vy = Math.sin(angle) * speed - 50;\n119\t      const life = 0.3 + Math.random() * 0.4;\n120\t      const size = 3 + Math.random() * 4;\n121\t      this.particles.push(new Particle(x, y, vx, vy, color, life, size));\n122\t    }\n123\t  }\n124\t\n125\t  emitExplosion(x, y, color, count = 16) {\n126\t    for (let i = 0; i < count; i++) {\n127\t      const angle = Math.random() * Math.PI * 2;\n128\t      const speed = 50 + Math.random() * 200;\n129\t      const vx = Math.cos(angle) * speed;\n130\t      const vy = Math.sin(angle) * speed - 100;\n131\t      const life = 0.4 + Math.random() * 0.6;\n132\t      const size = 2 + Math.random() * 6;\n133\t      this.particles.push(new Particle(x, y, vx, vy, color, life, size));\n134\t    }\n135\t  }\n136\t\n137\t  update(dt) {\n138\t    this.particles = this.particles.filter(p => !p.update(dt));\n139\t  }\n140\t\n141\t  draw(ctx) {\n142\t    for (const p of this.particles) {\n143\t      ctx.globalAlpha = p.alpha;\n144\t      ctx.fillStyle = p.color;\n145\t      ctx.beginPath();\n146\t      ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\n147\t      ctx.fill();\n148\t    }\n149\t    ctx.globalAlpha = 1;\n150\t  }\n151\t\n152\t  get activeCount() {\n153\t    return this.particles.length;\n154\t  }\n155\t}\n156\t\n157\tif (typeof module !== 'undefined') module.exports = { Easing, Tween, TweenManager, Particle, ParticleSystem };\n158\t"}]},"parent_tool_use_id":null,"session_id":"4fc1920c-0b5c-4266-b43d-05c38f749fa3","uuid":"18790c09-d615-4b35-a913-b26939af07f2","timestamp":"2026-05-22T21:24:58.027Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-match3/src/js/Animation.js","content":"// Animation.js — Easing functions, tween system, particle effects\n\n// Easing functions\nconst Easing = {\n  linear: t => t,\n  easeInQuad: t => t * t,\n  easeOutQuad: t => t * (2 - t),\n  easeInOutQuad: t => t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t,\n  easeOutBack: t => {\n    const s = 1.70158;\n    return (t -= 1) * t * ((s + 1) * t + s) + 1;\n  },\n  easeOutBounce: t => {\n    if (t < 1 / 2.75) return 7.5625 * t * t;\n    if (t < 2 / 2.75) return 7.5625 * (t -= 1.5 / 2.75) * t + 0.75;\n    if (t < 2.5 / 2.75) return 7.5625 * (t -= 2.25 / 2.75) * t + 0.9375;\n    return 7.5625 * (t -= 2.625 / 2.75) * t + 0.984375;\n  },\n  easeOutElastic: t => {\n    if (t === 0 || t === 1) return t;\n    return Math.pow(2, -10 * t) * Math.sin((t - 0.075) * (2 * Math.PI) / 0.3) + 1;\n  },\n};\n\nclass Tween {\n  constructor(target, props, duration, easing = 'easeOutQuad', onComplete = null) {\n    this.target = target;\n    this.startProps = {};\n    this.endProps = props;\n    this.duration = duration;\n    this.easingFn = Easing[easing] || Easing.easeOutQuad;\n    this.onComplete = onComplete;\n    this.elapsed = 0;\n    this.done = false;\n\n    for (const key in props) {\n      this.startProps[key] = target[key];\n    }\n  }\n\n  update(dt) {\n    if (this.done) return true;\n    this.elapsed += dt;\n    let t = Math.min(this.elapsed / this.duration, 1);\n    const easedT = this.easingFn(t);\n\n    for (const key in this.endProps) {\n      this.target[key] = this.startProps[key] + (this.endProps[key] - this.startProps[key]) * easedT;\n    }\n\n    if (t >= 1) {\n      this.done = true;\n      if (this.onComplete) this.onComplete();\n      return true;\n    }\n    return false;\n  }\n}\n\nclass TweenManager {\n  constructor() {\n    this.tweens = [];\n  }\n\n  add(target, props, duration, easing, onComplete) {\n    const tween = new Tween(target, props, duration, easing, onComplete);\n    this.tweens.push(tween);\n    return tween;\n  }\n\n  update(dt) {\n    this.tweens = this.tweens.filter(t => !t.update(dt));\n  }\n\n  clear() {\n    this.tweens = [];\n  }\n\n  get activeCount() {\n    return this.tweens.length;\n  }\n}\n\n// Particle system for match effects\nclass Particle {\n  constructor(x, y, vx, vy, color, life, size) {\n    this.x = x;\n    this.y = y;\n    this.vx = vx;\n    this.vy = vy;\n    this.color = color;\n    this.life = life;\n    this.maxLife = life;\n    this.size = size;\n    this.alpha = 1;\n  }\n\n  update(dt) {\n    this.x += this.vx * dt;\n    this.y += this.vy * dt;\n    this.vy += 200 * dt; // gravity\n    this.life -= dt;\n    this.alpha = Math.max(0, this.life / this.maxLife);\n    return this.life <= 0;\n  }\n}\n\nclass ParticleSystem {\n  constructor() {\n    this.particles = [];\n  }\n\n  emit(x, y, color, count = 8) {\n    for (let i = 0; i < count; i++) {\n      const angle = (Math.PI * 2 / count) * i + Math.random() * 0.5;\n      const speed = 80 + Math.random() * 120;\n      const vx = Math.cos(angle) * speed;\n      const vy = Math.sin(angle) * speed - 50;\n      const life = 0.3 + Math.random() * 0.4;\n      const size = 3 + Math.random() * 4;\n      this.particles.push(new Particle(x, y, vx, vy, color, life, size));\n    }\n  }\n\n  emitExplosion(x, y, color, count = 16) {\n    for (let i = 0; i < count; i++) {\n      const angle = Math.random() * Math.PI * 2;\n      const speed = 50 + Math.random() * 200;\n      const vx = Math.cos(angle) * speed;\n      const vy = Math.sin(angle) * speed - 100;\n      const life = 0.4 + Math.random() * 0.6;\n      const size = 2 + Math.random() * 6;\n      this.particles.push(new Particle(x, y, vx, vy, color, life, size));\n    }\n  }\n\n  update(dt) {\n    this.particles = this.particles.filter(p => !p.update(dt));\n  }\n\n  draw(ctx) {\n    for (const p of this.particles) {\n      ctx.globalAlpha = p.alpha;\n      ctx.fillStyle = p.color;\n      ctx.beginPath();\n      ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\n      ctx.fill();\n    }\n    ctx.globalAlpha = 1;\n  }\n\n  get activeCount() {\n    return this.particles.length;\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Easing, Tween, TweenManager, Particle, ParticleSystem };\n","numLines":158,"startLine":1,"totalLines":158}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_bbeaaddd2a8248cb89055271","type":"tool_result","content":"1\t// Renderer.js — Canvas 2D rendering engine for the match-3 board\n2\t\n3\tclass Renderer {\n4\t  constructor(canvas) {\n5\t    this.canvas = canvas;\n6\t    this.ctx = canvas.getContext('2d');\n7\t    this.tileSize = 0;\n8\t    this.boardX = 0;\n9\t    this.boardY = 0;\n10\t    this.particleSystem = null;\n11\t    this.floatingTexts = [];\n12\t    this.resize();\n13\t  }\n14\t\n15\t  resize() {\n16\t    const dpr = window.devicePixelRatio || 1;\n17\t    const w = window.innerWidth;\n18\t    const h = window.innerHeight;\n19\t    this.canvas.width = w * dpr;\n20\t    this.canvas.height = h * dpr;\n21\t    this.canvas.style.width = w + 'px';\n22\t    this.canvas.style.height = h + 'px';\n23\t    this.ctx.scale(dpr, dpr);\n24\t    this.screenW = w;\n25\t    this.screenH = h;\n26\t\n27\t    // Board layout: centered, leave room for top UI\n28\t    this.tileSize = Math.floor(Math.min(w * 0.9, (h - 160)) / BOARD_SIZE);\n29\t    this.boardX = (w - this.tileSize * BOARD_SIZE) / 2;\n30\t    this.boardY = 140;\n31\t  }\n32\t\n33\t  getTileCenter(row, col) {\n34\t    return {\n35\t      x: this.boardX + col * this.tileSize + this.tileSize / 2,\n36\t      y: this.boardY + row * this.tileSize + this.tileSize / 2,\n37\t    };\n38\t  }\n39\t\n40\t  clear() {\n41\t    this.ctx.clearRect(0, 0, this.screenW, this.screenH);\n42\t  }\n43\t\n44\t  drawBackground() {\n45\t    const ctx = this.ctx;\n46\t    // Cream background\n47\t    ctx.fillStyle = '#FFF8E7';\n48\t    ctx.fillRect(0, 0, this.screenW, this.screenH);\n49\t\n50\t    // Board background\n51\t    const bw = this.tileSize * BOARD_SIZE;\n52\t    const bh = this.tileSize * BOARD_SIZE;\n53\t    ctx.fillStyle = '#FFFFFFCC';\n54\t    this._roundRect(ctx, this.boardX - 6, this.boardY - 6, bw + 12, bh + 12, 12);\n55\t    ctx.fill();\n56\t\n57\t    // Grid lines (subtle)\n58\t    ctx.strokeStyle = '#F0E6D6';\n59\t    ctx.lineWidth = 1;\n60\t    for (let i = 0; i <= BOARD_SIZE; i++) {\n61\t      ctx.beginPath();\n62\t      ctx.moveTo(this.boardX + i * this.tileSize, this.boardY);\n63\t      ctx.lineTo(this.boardX + i * this.tileSize, this.boardY + bh);\n64\t      ctx.stroke();\n65\t      ctx.beginPath();\n66\t      ctx.moveTo(this.boardX, this.boardY + i * this.tileSize);\n67\t      ctx.lineTo(this.boardX + bw, this.boardY + i * this.tileSize);\n68\t      ctx.stroke();\n69\t    }\n70\t  }\n71\t\n72\t  drawTile(tile) {\n73\t    if (!tile || tile.color < 0) return;\n74\t    const ctx = this.ctx;\n75\t    const size = this.tileSize - 4;\n76\t    const cx = this.boardX + tile.col * this.tileSize + this.tileSize / 2 + (tile.offsetX || 0);\n77\t    const cy = this.boardY + tile.row * this.tileSize + this.tileSize / 2 + (tile.offsetY || 0);\n78\t    const scale = tile.scale || 1;\n79\t    const alpha = tile.alpha !== undefined ? tile.alpha : 1;\n80\t\n81\t    ctx.save();\n82\t    ctx.translate(cx, cy);\n83\t    ctx.scale(scale, scale);\n84\t    ctx.globalAlpha = alpha;\n85\t\n86\t    const half = size / 2;\n87\t    const color = COLOR_MAP[tile.color];\n88\t    if (!color) { ctx.restore(); return; }\n89\t\n90\t    // Tile body\n91\t    ctx.fillStyle = color.hex;\n92\t    this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n93\t    ctx.fill();\n94\t\n95\t    // Highlight\n96\t    ctx.fillStyle = 'rgba(255,255,255,0.25)';\n97\t    this._roundRect(ctx, -half + 3, -half + 3, size - 6, size / 2 - 3, size * 0.15);\n98\t    ctx.fill();\n99\t\n100\t    // Draw fruit icon\n101\t    this._drawFruitIcon(ctx, tile.color, half * 0.55);\n102\t\n103\t    // Special tile overlay\n104\t    if (tile.special === SPECIAL_STRIPED_H) {\n105\t      this._drawStripes(ctx, size, half, '#FFFFFF80', true);\n106\t    } else if (tile.special === SPECIAL_STRIPED_V) {\n107\t      this._drawStripes(ctx, size, half, '#FFFFFF80', false);\n108\t    } else if (tile.special === SPECIAL_BOMB) {\n109\t      this._drawCrosshair(ctx, half);\n110\t    } else if (tile.special === SPECIAL_RAINBOW) {\n111\t      this._drawRainbowOverlay(ctx, half);\n112\t    }\n113\t\n114\t    // Selection glow\n115\t    if (tile.selected) {\n116\t      ctx.strokeStyle = '#FFFFFF';\n117\t      ctx.lineWidth = 3;\n118\t      ctx.shadowColor = '#FFB800';\n119\t      ctx.shadowBlur = 12;\n120\t      this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n121\t      ctx.stroke();\n122\t      ctx.shadowBlur = 0;\n123\t    }\n124\t\n125\t    ctx.restore();\n126\t  }\n127\t\n128\t  _drawFruitIcon(ctx, colorIdx, radius) {\n129\t    ctx.fillStyle = 'rgba(255,255,255,0.6)';\n130\t    ctx.font = `bold ${radius * 1.4}px sans-serif`;\n131\t    ctx.textAlign = 'center';\n132\t    ctx.textBaseline = 'middle';\n133\t    const icons = ['🍎', '🍌', '🫐', '🍏', '🍇', '🍊'];\n134\t    ctx.fillText(icons[colorIdx] || '', 0, 1);\n135\t  }\n136\t\n137\t  _drawStripes(ctx, size, half, color, horizontal) {\n138\t    ctx.strokeStyle = color;\n139\t    ctx.lineWidth = 2;\n140\t    if (horizontal) {\n141\t      for (let y = -half + 6; y < half; y += 8) {\n142\t        ctx.beginPath();\n143\t        ctx.moveTo(-half + 4, y);\n144\t        ctx.lineTo(half - 4, y);\n145\t        ctx.stroke();\n146\t      }\n147\t    } else {\n148\t      for (let x = -half + 6; x < half; x += 8) {\n149\t        ctx.beginPath();\n150\t        ctx.moveTo(x, -half + 4);\n151\t        ctx.lineTo(x, half - 4);\n152\t        ctx.stroke();\n153\t      }\n154\t    }\n155\t  }\n156\t\n157\t  _drawCrosshair(ctx, half) {\n158\t    ctx.strokeStyle = '#FFFFFF99';\n159\t    ctx.lineWidth = 2;\n160\t    ctx.beginPath();\n161\t    ctx.moveTo(-half * 0.6, 0); ctx.lineTo(half * 0.6, 0);\n162\t    ctx.moveTo(0, -half * 0.6); ctx.lineTo(0, half * 0.6);\n163\t    ctx.stroke();\n164\t    ctx.beginPath();\n165\t    ctx.arc(0, 0, half * 0.4, 0, Math.PI * 2);\n166\t    ctx.stroke();\n167\t  }\n168\t\n169\t  _drawRainbowOverlay(ctx, half) {\n170\t    const gradient = ctx.createLinearGradient(-half, -half, half, half);\n171\t    gradient.addColorStop(0, '#FF000080');\n172\t    gradient.addColorStop(0.17, '#FF880080');\n173\t    gradient.addColorStop(0.33, '#FFFF0080');\n174\t    gradient.addColorStop(0.5, '#00FF0080');\n175\t    gradient.addColorStop(0.67, '#0088FF80');\n176\t    gradient.addColorStop(0.83, '#8800FF80');\n177\t    gradient.addColorStop(1, '#FF008880');\n178\t    ctx.fillStyle = gradient;\n179\t    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.4);\n180\t    ctx.fill();\n181\t  }\n182\t\n183\t  drawUI(score, moves, goal, goalProgress, level) {\n184\t    const ctx = this.ctx;\n185\t\n186\t    // Top bar background\n187\t    ctx.fillStyle = '#FFB800';\n188\t    this._roundRect(ctx, 8, 8, this.screenW - 16, 55, 12);\n189\t    ctx.fill();\n190\t\n191\t    // Level\n192\t    ctx.fillStyle = '#5D4037';\n193\t    ctx.font = 'bold 18px sans-serif';\n194\t    ctx.textAlign = 'left';\n195\t    ctx.fillText(`第 ${level} 关`, 20, 42);\n196\t\n197\t    // Score\n198\t    ctx.textAlign = 'center';\n199\t    ctx.fillStyle = '#FFFFFF';\n200\t    ctx.font = 'bold 20px sans-serif';\n201\t    ctx.fillText(`${score}`, this.screenW / 2, 32);\n202\t    ctx.font = '12px sans-serif';\n203\t    ctx.fillText('分数', this.screenW / 2, 48);\n204\t\n205\t    // Moves\n206\t    ctx.textAlign = 'right';\n207\t    ctx.fillStyle = moves <= 5 ? '#FF4D4D' : '#5D4037';\n208\t    ctx.font = 'bold 22px sans-serif';\n209\t    ctx.fillText(`${moves}`, this.screenW - 20, 32);\n210\t    ctx.font = '12px sans-serif';\n211\t    ctx.fillStyle = '#5D4037';\n212\t    ctx.fillText('剩余步数', this.screenW - 20, 48);\n213\t\n214\t    // Goal progress bar\n215\t    const barW = this.screenW - 40;\n216\t    const barH = 16;\n217\t    const barY = 72;\n218\t    const barX = 20;\n219\t\n220\t    ctx.fillStyle = '#E0D5C5';\n221\t    this._roundRect(ctx, barX, barY, barW, barH, 8);\n222\t    ctx.fill();\n223\t\n224\t    const progress = Math.min(goalProgress / goal, 1);\n225\t    if (progress > 0) {\n226\t      const grad = ctx.createLinearGradient(barX, barY, barX + barW * progress, barY);\n227\t      grad.addColorStop(0, '#6BCB77');\n228\t      grad.addColorStop(1, '#4DA66B');\n229\t      ctx.fillStyle = grad;\n230\t      this._roundRect(ctx, barX, barY, barW * progress, barH, 8);\n231\t      ctx.fill();\n232\t    }\n233\t\n234\t    ctx.fillStyle = '#5D4037';\n235\t    ctx.font = 'bold 11px sans-serif';\n236\t    ctx.textAlign = 'center';\n237\t    ctx.fillText(`${goalProgress} / ${goal}`, this.screenW / 2, barY + 13);\n238\t\n239\t    // Bottom hint\n240\t    ctx.fillStyle = '#8D6E63';\n241\t    ctx.font = '14px sans-serif';\n242\t    ctx.textAlign = 'center';\n243\t    ctx.fillText('滑动交换相邻方块', this.screenW / 2, this.boardY + this.tileSize * BOARD_SIZE + 30);\n244\t  }\n245\t\n246\t  drawComboText(text) {\n247\t    if (!text) return;\n248\t    const ctx = this.ctx;\n249\t    ctx.save();\n250\t    ctx.fillStyle = '#FF4D4D';\n251\t    ctx.font = 'bold 36px sans-serif';\n252\t    ctx.textAlign = 'center';\n253\t    ctx.textBaseline = 'middle';\n254\t    ctx.shadowColor = '#FFB800';\n255\t    ctx.shadowBlur = 8;\n256\t    ctx.fillText(text, this.screenW / 2, this.boardY + this.tileSize * BOARD_SIZE / 2);\n257\t    ctx.restore();\n258\t  }\n259\t\n260\t  addFloatingText(text, x, y, color = '#FF4D4D') {\n261\t    this.floatingTexts.push({ text, x, y, alpha: 1, vy: -60, life: 1.0 });\n262\t  }\n263\t\n264\t  updateAndDrawFloatingTexts(dt) {\n265\t    const ctx = this.ctx;\n266\t    this.floatingTexts = this.floatingTexts.filter(ft => {\n267\t      ft.y += ft.vy * dt;\n268\t      ft.life -= dt;\n269\t      ft.alpha = Math.max(0, ft.life);\n270\t      if (ft.life <= 0) return false;\n271\t\n272\t      ctx.globalAlpha = ft.alpha;\n273\t      ctx.fillStyle = ft.color;\n274\t      ctx.font = 'bold 18px sans-serif';\n275\t      ctx.textAlign = 'center';\n276\t      ctx.fillText(ft.text, ft.x, ft.y);\n277\t      ctx.globalAlpha = 1;\n278\t      return true;\n279\t    });\n280\t  }\n281\t\n282\t  drawResultScreen(won, score, stars, level) {\n283\t    const ctx = this.ctx;\n284\t    // Dim overlay\n285\t    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n286\t    ctx.fillRect(0, 0, this.screenW, this.screenH);\n287\t\n288\t    // Panel\n289\t    const pw = Math.min(320, this.screenW - 40);\n290\t    const ph = 260;\n291\t    const px = (this.screenW - pw) / 2;\n292\t    const py = (this.screenH - ph) / 2;\n293\t\n294\t    ctx.fillStyle = '#FFF8E7';\n295\t    this._roundRect(ctx, px, py, pw, ph, 16);\n296\t    ctx.fill();\n297\t    ctx.strokeStyle = '#FFB800';\n298\t    ctx.lineWidth = 3;\n299\t    this._roundRect(ctx, px, py, pw, ph, 16);\n300\t    ctx.stroke();\n301\t\n302\t    // Title\n303\t    ctx.fillStyle = '#5D4037';\n304\t    ctx.font = 'bold 24px sans-serif';\n305\t    ctx.textAlign = 'center';\n306\t    ctx.fillText(won ? '🎉 恭喜过关！' : '😢 挑战失败', this.screenW / 2, py + 45);\n307\t\n308\t    // Score\n309\t    ctx.font = 'bold 36px sans-serif';\n310\t    ctx.fillStyle = '#FFB800';\n311\t    ctx.fillText(score, this.screenW / 2, py + 95);\n312\t    ctx.font = '14px sans-serif';\n313\t    ctx.fillStyle = '#8D6E63';\n314\t    ctx.fillText('得分', this.screenW / 2, py + 115);\n315\t\n316\t    // Stars\n317\t    if (won) {\n318\t      for (let i = 0; i < 3; i++) {\n319\t        ctx.font = '32px sans-serif';\n320\t        ctx.fillText(i < stars ? '⭐' : '☆', this.screenW / 2 - 45 + i * 45, py + 160);\n321\t      }\n322\t    }\n323\t\n324\t    // Buttons\n325\t    const btnW = 120, btnH = 42;\n326\t    const btnY = py + ph - 60;\n327\t\n328\t    // Retry button\n329\t    ctx.fillStyle = '#6BCB77';\n330\t    this._roundRect(ctx, this.screenW / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n331\t    ctx.fill();\n332\t    ctx.fillStyle = '#FFFFFF';\n333\t    ctx.font = 'bold 16px sans-serif';\n334\t    ctx.fillText(won ? '下一关' : '重试', this.screenW / 2 - btnW / 2 - 10, btnY + 27);\n335\t\n336\t    // Menu button\n337\t    ctx.fillStyle = '#8D6E63';\n338\t    this._roundRect(ctx, this.screenW / 2 + 10, btnY, btnW, btnH, btnH / 2);\n339\t    ctx.fill();\n340\t    ctx.fillStyle = '#FFFFFF';\n341\t    ctx.fillText('菜单', this.screenW / 2 + btnW / 2 + 10, btnY + 27);\n342\t  }\n343\t\n344\t  _roundRect(ctx, x, y, w, h, r) {\n345\t    ctx.beginPath();\n346\t    ctx.moveTo(x + r, y);\n347\t    ctx.lineTo(x + w - r, y);\n348\t    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n349\t    ctx.lineTo(x + w, y + h - r);\n350\t    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n351\t    ctx.lineTo(x + r, y + h);\n352\t    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n353\t    ctx.lineTo(x, y + r);\n354\t    ctx.quadraticCurveTo(x, y, x + r, y);\n355\t    ctx.closePath();\n356\t  }\n357\t}\n358\t\n359\tif (typeof module !== 'undefined') module.exports = { Renderer };\n360\t"}]},"parent_tool_use_id":null,"session_id":"4fc1920c-0b5c-4266-b43d-05c38f749fa3","uuid":"e9fe2c42-878f-4d71-b5a6-d8bded17f721","timestamp":"2026-05-22T21:24:58.044Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-match3/src/js/Renderer.js","content":"// Renderer.js — Canvas 2D rendering engine for the match-3 board\n\nclass Renderer {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d');\n    this.tileSize = 0;\n    this.boardX = 0;\n    this.boardY = 0;\n    this.particleSystem = null;\n    this.floatingTexts = [];\n    this.resize();\n  }\n\n  resize() {\n    const dpr = window.devicePixelRatio || 1;\n    const w = window.innerWidth;\n    const h = window.innerHeight;\n    this.canvas.width = w * dpr;\n    this.canvas.height = h * dpr;\n    this.canvas.style.width = w + 'px';\n    this.canvas.style.height = h + 'px';\n    this.ctx.scale(dpr, dpr);\n    this.screenW = w;\n    this.screenH = h;\n\n    // Board layout: centered, leave room for top UI\n    this.tileSize = Math.floor(Math.min(w * 0.9, (h - 160)) / BOARD_SIZE);\n    this.boardX = (w - this.tileSize * BOARD_SIZE) / 2;\n    this.boardY = 140;\n  }\n\n  getTileCenter(row, col) {\n    return {\n      x: this.boardX + col * this.tileSize + this.tileSize / 2,\n      y: this.boardY + row * this.tileSize + this.tileSize / 2,\n    };\n  }\n\n  clear() {\n    this.ctx.clearRect(0, 0, this.screenW, this.screenH);\n  }\n\n  drawBackground() {\n    const ctx = this.ctx;\n    // Cream background\n    ctx.fillStyle = '#FFF8E7';\n    ctx.fillRect(0, 0, this.screenW, this.screenH);\n\n    // Board background\n    const bw = this.tileSize * BOARD_SIZE;\n    const bh = this.tileSize * BOARD_SIZE;\n    ctx.fillStyle = '#FFFFFFCC';\n    this._roundRect(ctx, this.boardX - 6, this.boardY - 6, bw + 12, bh + 12, 12);\n    ctx.fill();\n\n    // Grid lines (subtle)\n    ctx.strokeStyle = '#F0E6D6';\n    ctx.lineWidth = 1;\n    for (let i = 0; i <= BOARD_SIZE; i++) {\n      ctx.beginPath();\n      ctx.moveTo(this.boardX + i * this.tileSize, this.boardY);\n      ctx.lineTo(this.boardX + i * this.tileSize, this.boardY + bh);\n      ctx.stroke();\n      ctx.beginPath();\n      ctx.moveTo(this.boardX, this.boardY + i * this.tileSize);\n      ctx.lineTo(this.boardX + bw, this.boardY + i * this.tileSize);\n      ctx.stroke();\n    }\n  }\n\n  drawTile(tile) {\n    if (!tile || tile.color < 0) return;\n    const ctx = this.ctx;\n    const size = this.tileSize - 4;\n    const cx = this.boardX + tile.col * this.tileSize + this.tileSize / 2 + (tile.offsetX || 0);\n    const cy = this.boardY + tile.row * this.tileSize + this.tileSize / 2 + (tile.offsetY || 0);\n    const scale = tile.scale || 1;\n    const alpha = tile.alpha !== undefined ? tile.alpha : 1;\n\n    ctx.save();\n    ctx.translate(cx, cy);\n    ctx.scale(scale, scale);\n    ctx.globalAlpha = alpha;\n\n    const half = size / 2;\n    const color = COLOR_MAP[tile.color];\n    if (!color) { ctx.restore(); return; }\n\n    // Tile body\n    ctx.fillStyle = color.hex;\n    this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n    ctx.fill();\n\n    // Highlight\n    ctx.fillStyle = 'rgba(255,255,255,0.25)';\n    this._roundRect(ctx, -half + 3, -half + 3, size - 6, size / 2 - 3, size * 0.15);\n    ctx.fill();\n\n    // Draw fruit icon\n    this._drawFruitIcon(ctx, tile.color, half * 0.55);\n\n    // Special tile overlay\n    if (tile.special === SPECIAL_STRIPED_H) {\n      this._drawStripes(ctx, size, half, '#FFFFFF80', true);\n    } else if (tile.special === SPECIAL_STRIPED_V) {\n      this._drawStripes(ctx, size, half, '#FFFFFF80', false);\n    } else if (tile.special === SPECIAL_BOMB) {\n      this._drawCrosshair(ctx, half);\n    } else if (tile.special === SPECIAL_RAINBOW) {\n      this._drawRainbowOverlay(ctx, half);\n    }\n\n    // Selection glow\n    if (tile.selected) {\n      ctx.strokeStyle = '#FFFFFF';\n      ctx.lineWidth = 3;\n      ctx.shadowColor = '#FFB800';\n      ctx.shadowBlur = 12;\n      this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n      ctx.stroke();\n      ctx.shadowBlur = 0;\n    }\n\n    ctx.restore();\n  }\n\n  _drawFruitIcon(ctx, colorIdx, radius) {\n    ctx.fillStyle = 'rgba(255,255,255,0.6)';\n    ctx.font = `bold ${radius * 1.4}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    const icons = ['🍎', '🍌', '🫐', '🍏', '🍇', '🍊'];\n    ctx.fillText(icons[colorIdx] || '', 0, 1);\n  }\n\n  _drawStripes(ctx, size, half, color, horizontal) {\n    ctx.strokeStyle = color;\n    ctx.lineWidth = 2;\n    if (horizontal) {\n      for (let y = -half + 6; y < half; y += 8) {\n        ctx.beginPath();\n        ctx.moveTo(-half + 4, y);\n        ctx.lineTo(half - 4, y);\n        ctx.stroke();\n      }\n    } else {\n      for (let x = -half + 6; x < half; x += 8) {\n        ctx.beginPath();\n        ctx.moveTo(x, -half + 4);\n        ctx.lineTo(x, half - 4);\n        ctx.stroke();\n      }\n    }\n  }\n\n  _drawCrosshair(ctx, half) {\n    ctx.strokeStyle = '#FFFFFF99';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.moveTo(-half * 0.6, 0); ctx.lineTo(half * 0.6, 0);\n    ctx.moveTo(0, -half * 0.6); ctx.lineTo(0, half * 0.6);\n    ctx.stroke();\n    ctx.beginPath();\n    ctx.arc(0, 0, half * 0.4, 0, Math.PI * 2);\n    ctx.stroke();\n  }\n\n  _drawRainbowOverlay(ctx, half) {\n    const gradient = ctx.createLinearGradient(-half, -half, half, half);\n    gradient.addColorStop(0, '#FF000080');\n    gradient.addColorStop(0.17, '#FF880080');\n    gradient.addColorStop(0.33, '#FFFF0080');\n    gradient.addColorStop(0.5, '#00FF0080');\n    gradient.addColorStop(0.67, '#0088FF80');\n    gradient.addColorStop(0.83, '#8800FF80');\n    gradient.addColorStop(1, '#FF008880');\n    ctx.fillStyle = gradient;\n    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.4);\n    ctx.fill();\n  }\n\n  drawUI(score, moves, goal, goalProgress, level) {\n    const ctx = this.ctx;\n\n    // Top bar background\n    ctx.fillStyle = '#FFB800';\n    this._roundRect(ctx, 8, 8, this.screenW - 16, 55, 12);\n    ctx.fill();\n\n    // Level\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 18px sans-serif';\n    ctx.textAlign = 'left';\n    ctx.fillText(`第 ${level} 关`, 20, 42);\n\n    // Score\n    ctx.textAlign = 'center';\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.fillText(`${score}`, this.screenW / 2, 32);\n    ctx.font = '12px sans-serif';\n    ctx.fillText('分数', this.screenW / 2, 48);\n\n    // Moves\n    ctx.textAlign = 'right';\n    ctx.fillStyle = moves <= 5 ? '#FF4D4D' : '#5D4037';\n    ctx.font = 'bold 22px sans-serif';\n    ctx.fillText(`${moves}`, this.screenW - 20, 32);\n    ctx.font = '12px sans-serif';\n    ctx.fillStyle = '#5D4037';\n    ctx.fillText('剩余步数', this.screenW - 20, 48);\n\n    // Goal progress bar\n    const barW = this.screenW - 40;\n    const barH = 16;\n    const barY = 72;\n    const barX = 20;\n\n    ctx.fillStyle = '#E0D5C5';\n    this._roundRect(ctx, barX, barY, barW, barH, 8);\n    ctx.fill();\n\n    const progress = Math.min(goalProgress / goal, 1);\n    if (progress > 0) {\n      const grad = ctx.createLinearGradient(barX, barY, barX + barW * progress, barY);\n      grad.addColorStop(0, '#6BCB77');\n      grad.addColorStop(1, '#4DA66B');\n      ctx.fillStyle = grad;\n      this._roundRect(ctx, barX, barY, barW * progress, barH, 8);\n      ctx.fill();\n    }\n\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 11px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(`${goalProgress} / ${goal}`, this.screenW / 2, barY + 13);\n\n    // Bottom hint\n    ctx.fillStyle = '#8D6E63';\n    ctx.font = '14px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('滑动交换相邻方块', this.screenW / 2, this.boardY + this.tileSize * BOARD_SIZE + 30);\n  }\n\n  drawComboText(text) {\n    if (!text) return;\n    const ctx = this.ctx;\n    ctx.save();\n    ctx.fillStyle = '#FF4D4D';\n    ctx.font = 'bold 36px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.shadowColor = '#FFB800';\n    ctx.shadowBlur = 8;\n    ctx.fillText(text, this.screenW / 2, this.boardY + this.tileSize * BOARD_SIZE / 2);\n    ctx.restore();\n  }\n\n  addFloatingText(text, x, y, color = '#FF4D4D') {\n    this.floatingTexts.push({ text, x, y, alpha: 1, vy: -60, life: 1.0 });\n  }\n\n  updateAndDrawFloatingTexts(dt) {\n    const ctx = this.ctx;\n    this.floatingTexts = this.floatingTexts.filter(ft => {\n      ft.y += ft.vy * dt;\n      ft.life -= dt;\n      ft.alpha = Math.max(0, ft.life);\n      if (ft.life <= 0) return false;\n\n      ctx.globalAlpha = ft.alpha;\n      ctx.fillStyle = ft.color;\n      ctx.font = 'bold 18px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText(ft.text, ft.x, ft.y);\n      ctx.globalAlpha = 1;\n      return true;\n    });\n  }\n\n  drawResultScreen(won, score, stars, level) {\n    const ctx = this.ctx;\n    // Dim overlay\n    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n    ctx.fillRect(0, 0, this.screenW, this.screenH);\n\n    // Panel\n    const pw = Math.min(320, this.screenW - 40);\n    const ph = 260;\n    const px = (this.screenW - pw) / 2;\n    const py = (this.screenH - ph) / 2;\n\n    ctx.fillStyle = '#FFF8E7';\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.fill();\n    ctx.strokeStyle = '#FFB800';\n    ctx.lineWidth = 3;\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.stroke();\n\n    // Title\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 24px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(won ? '🎉 恭喜过关！' : '😢 挑战失败', this.screenW / 2, py + 45);\n\n    // Score\n    ctx.font = 'bold 36px sans-serif';\n    ctx.fillStyle = '#FFB800';\n    ctx.fillText(score, this.screenW / 2, py + 95);\n    ctx.font = '14px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText('得分', this.screenW / 2, py + 115);\n\n    // Stars\n    if (won) {\n      for (let i = 0; i < 3; i++) {\n        ctx.font = '32px sans-serif';\n        ctx.fillText(i < stars ? '⭐' : '☆', this.screenW / 2 - 45 + i * 45, py + 160);\n      }\n    }\n\n    // Buttons\n    const btnW = 120, btnH = 42;\n    const btnY = py + ph - 60;\n\n    // Retry button\n    ctx.fillStyle = '#6BCB77';\n    this._roundRect(ctx, this.screenW / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n    ctx.fill();\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = 'bold 16px sans-serif';\n    ctx.fillText(won ? '下一关' : '重试', this.screenW / 2 - btnW / 2 - 10, btnY + 27);\n\n    // Menu button\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, this.screenW / 2 + 10, btnY, btnW, btnH, btnH / 2);\n    ctx.fill();\n    ctx.fillStyle = '#FFFFFF';\n    ctx.fillText('菜单', this.screenW / 2 + btnW / 2 + 10, btnY + 27);\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Renderer };\n","numLines":360,"startLine":1,"totalLines":360}}}
