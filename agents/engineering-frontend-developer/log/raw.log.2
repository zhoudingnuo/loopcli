#0a0e1a 100%);\n      display: flex; flex-direction: column; align-items: center; justify-content: center;\n      z-index: 1000; transition: opacity 0.8s ease;\n    }\n    #loading-screen.fade-out { opacity: 0; pointer-events: none; }\n    .loading-title {\n      font-size: 36px; color: #ffd700;\n      text-shadow: 0 0 20px rgba(255,215,0,0.5), 0 0 60px rgba(255,215,0,0.2);\n      margin-bottom: 8px; letter-spacing: 4px;\n      animation: titlePulse 3s ease-in-out infinite;\n    }\n    @keyframes titlePulse {\n      0%, 100% { text-shadow: 0 0 20px rgba(255,215,0,0.5), 0 0 60px rgba(255,215,0,0.2); }\n      50% { text-shadow: 0 0 30px rgba(255,215,0,0.8), 0 0 80px rgba(255,215,0,0.4); }\n    }\n    .loading-subtitle { font-size: 14px; color: #888; margin-bottom: 40px; letter-spacing: 2px; }\n    .loading-bar-container {\n      width: 320px; height: 4px; background: rgba(255,255,255,0.1);\n      border-radius: 2px; overflow: hidden; margin-bottom: 16px;\n    }\n    .loading-bar-fill {\n      height: 100%; width: 0%; border-radius: 2px;\n      background: linear-gradient(90deg, #ffd700, #ff8c00);\n      transition: width 0.3s ease;\n    }\n    .loading-text { font-size: 12px; color: #666; }\n    .loading-particles {\n      position: absolute; width: 100%; height: 100%; pointer-events: none;\n    }\n\n    /* ==================== MAIN MENU ==================== */\n    #main-menu {\n      position: fixed; top: 0; left: 0; width: 100%; height: 100%;\n      background: radial-gradient(ellipse at center, #1e2a4a 0%, #0a0e1a 100%);\n      display: none; flex-direction: column; align-items: center; justify-content: center;\n      z-index: 900;\n    }\n    #main-menu.active { display: flex; }\n    .menu-bg {\n      position: absolute; width: 100%; height: 100%;\n      background-image:\n        radial-gradient(2px 2px at 20% 30%, rgba(255,215,0,0.3), transparent),\n        radial-gradient(2px 2px at 40% 70%, rgba(100,200,255,0.2), transparent),\n        radial-gradient(1px 1px at 60% 20%, rgba(255,255,255,0.3), transparent),\n        radial-gradient(1px 1px at 80% 60%, rgba(255,200,50,0.2), transparent),\n        radial-gradient(2px 2px at 10% 80%, rgba(200,150,255,0.2), transparent),\n        radial-gradient(1px 1px at 70% 40%, rgba(255,255,255,0.2), transparent),\n        radial-gradient(1px 1px at 90% 90%, rgba(255,215,0,0.2), transparent);\n      animation: starDrift 60s linear infinite;\n    }\n    @keyframes starDrift { from { transform: translateY(0); } to { transform: translateY(-20px); } }\n\n    .menu-content { position: relative; z-index: 1; text-align: center; }\n    .menu-logo {\n      font-size: 48px; color: #ffd700; margin-bottom: 4px;\n      text-shadow: 0 0 30px rgba(255,215,0,0.6), 0 0 60px rgba(255,215,0,0.3);\n      letter-spacing: 6px;\n    }\n    .menu-version { font-size: 12px; color: #555; margin-bottom: 48px; }\n    .menu-buttons { display: flex; flex-direction: column; gap: 12px; width: 280px; margin: 0 auto; }\n    .menu-btn {\n      background: rgba(255,255,255,0.05);\n      border: 1px solid rgba(255,215,0,0.3);\n      color: #ffd700; padding: 14px 24px; border-radius: 6px;\n      cursor: pointer; font-size: 16px; letter-spacing: 2px;\n      transition: all 0.3s ease; font-family: inherit;\n    }\n    .menu-btn:hover {\n      background: rgba(255,215,0,0.1);\n      border-color: rgba(255,215,0,0.6);\n      text-shadow: 0 0 10px rgba(255,215,0,0.5);\n      transform: translateY(-1px);\n    }\n    .menu-btn:active { transform: translateY(0); }\n    .menu-btn.primary {\n      background: linear-gradient(135deg, rgba(255,215,0,0.15), rgba(255,140,0,0.15));\n      border-color: rgba(255,215,0,0.5);\n    }\n    .menu-btn.primary:hover {\n      background: linear-gradient(135deg, rgba(255,215,0,0.25), rgba(255,140,0,0.25));\n    }\n    .menu-footer { margin-top: 40px; font-size: 11px; color: #444; }\n    .menu-footer .steam-status { color: #6a6; }\n    .menu-footer .steam-status.offline { color: #666; }\n\n    /* ==================== SETTINGS PAGE ==================== */\n    #settings-page {\n      position: fixed; top: 0; left: 0; width: 100%; height: 100%;\n      background: rgba(0,0,0,0.85); backdrop-filter: blur(8px);\n      display: none; align-items: center; justify-content: center;\n      z-index: 950;\n    }\n    #settings-page.active { display: flex; }\n    .settings-panel {\n      background: linear-gradient(145deg, #1a2040, #141830);\n      border: 1px solid rgba(255,215,0,0.2);\n      border-radius: 12px; padding: 32px; width: 480px; max-height: 80vh;\n      overflow-y: auto;\n    }\n    .settings-title {\n      font-size: 22px; color: #ffd700; margin-bottom: 24px;\n      text-align: center; letter-spacing: 2px;\n    }\n    .settings-group {\n      margin-bottom: 20px; padding-bottom: 16px;\n      border-bottom: 1px solid rgba(255,255,255,0.06);\n    }\n    .settings-group:last-child { border-bottom: none; margin-bottom: 0; }\n    .settings-group-label {\n      font-size: 11px; color: #888; text-transform: uppercase;\n      margin-bottom: 12px; letter-spacing: 1px;\n    }\n    .setting-row {\n      display: flex; align-items: center; justify-content: space-between;\n      padding: 8px 0; gap: 16px;\n    }\n    .setting-label { font-size: 13px; color: #ccc; flex-shrink: 0; min-width: 80px; }\n    .setting-value { font-size: 12px; color: #888; min-width: 40px; text-align: right; }\n    .setting-slider {\n      flex: 1; -webkit-appearance: none; height: 4px;\n      background: rgba(255,255,255,0.1); border-radius: 2px; outline: none;\n    }\n    .setting-slider::-webkit-slider-thumb {\n      -webkit-appearance: none; width: 14px; height: 14px;\n      background: #ffd700; border-radius: 50%; cursor: pointer;\n    }\n    .setting-select {\n      flex: 1; background: rgba(255,255,255,0.05);\n      border: 1px solid rgba(255,255,255,0.15);\n      color: #e0e0e0; padding: 6px 12px; border-radius: 4px;\n      font-size: 13px; font-family: inherit; cursor: pointer;\n    }\n    .setting-select option { background: #1a2040; }\n    .setting-toggle {\n      width: 44px; height: 24px; background: rgba(255,255,255,0.1);\n      border-radius: 12px; cursor: pointer; position: relative;\n      border: none; transition: background 0.2s;\n    }\n    .setting-toggle.on { background: rgba(255,215,0,0.4); }\n    .setting-toggle::after {\n      content: ''; position: absolute; top: 3px; left: 3px;\n      width: 18px; height: 18px; background: #e0e0e0;\n      border-radius: 50%; transition: transform 0.2s;\n    }\n    .setting-toggle.on::after { transform: translateX(20px); background: #ffd700; }\n    .settings-actions {\n      display: flex; gap: 12px; margin-top: 24px; justify-content: center;\n    }\n    .settings-btn {\n      background: rgba(255,255,255,0.05);\n      border: 1px solid rgba(255,255,255,0.15);\n      color: #e0e0e0; padding: 8px 24px; border-radius: 4px;\n      cursor: pointer; font-size: 13px; font-family: inherit;\n      transition: background 0.2s;\n    }\n    .settings-btn:hover { background: rgba(255,255,255,0.1); }\n    .settings-btn.save {\n      background: rgba(255,215,0,0.15); border-color: rgba(255,215,0,0.3);\n      color: #ffd700;\n    }\n    .settings-btn.save:hover { background: rgba(255,215,0,0.25); }\n\n    /* ==================== GAME UI ==================== */\n    #game-ui { display: none; }\n    #game-ui.active { display: flex; flex-direction: column; height: 100vh; }\n\n    /* Toolbar */\n    #toolbar {\n      display: flex; align-items: center; gap: 8px;\n      padding: 6px 12px;\n      background: linear-gradient(180deg, rgba(20,24,48,0.95), rgba(10,14,26,0.95));\n      border-bottom: 1px solid rgba(255,215,0,0.15);\n      min-height: 44px; flex-shrink: 0;\n    }\n    #toolbar h1 { font-size: 15px; color: #ffd700; margin-right: 12px; white-space: nowrap; text-shadow: 0 0 8px rgba(255,215,0,0.3); }\n    #toolbar .spacer { flex: 1; }\n    .toolbar-btn {\n      background: rgba(255,255,255,0.05);\n      border: 1px solid rgba(255,255,255,0.1);\n      color: #e0e0e0; padding: 4px 12px; border-radius: 4px;\n      cursor: pointer; font-size: 12px; transition: all 0.2s;\n    }\n    .toolbar-btn:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,215,0,0.3); }\n    .toolbar-btn.active { background: rgba(100,200,100,0.2); border-color: rgba(100,200,100,0.4); }\n\n    /* Main layout */\n    #main { display: flex; flex: 1; overflow: hidden; }\n\n    /* Sidebar */\n    #sidebar {\n      width: 220px;\n      background: linear-gradient(180deg, rgba(20,24,48,0.9), rgba(15,18,35,0.95));\n      border-right: 1px solid rgba(255,215,0,0.1);\n      overflow-y: auto; flex-shrink: 0;\n      display: flex; flex-direction: column;\n    }\n    .sidebar-section {\n      padding: 8px;\n      border-bottom: 1px solid rgba(255,255,255,0.04);\n    }\n    .sidebar-section h3 {\n      font-size: 11px; color: #ffd700; opacity: 0.7;\n      margin-bottom: 6px; letter-spacing: 1px;\n    }\n    .building-item {\n      display: flex; align-items: center; gap: 8px;\n      padding: 6px 8px; margin: 2px 0; border-radius: 4px;\n      cursor: pointer; transition: all 0.2s; font-size: 12px;\n      border: 1px solid transparent;\n    }\n    .building-item:hover { background: rgba(255,215,0,0.05); border-color: rgba(255,215,0,0.1); }\n    .building-item.selected { background: rgba(100,200,100,0.15); border-color: rgba(100,200,100,0.3); }\n    .building-item .icon { font-size: 18px; }\n    .building-item .info { flex: 1; }\n    .building-item .name { color: #e0e0e0; }\n    .building-item .cost { color: #777; font-size: 10px; }\n    .building-item .cost.cannot { color: #c44; }\n\n    /* Canvas */\n    #canvas-container { flex: 1; position: relative; }\n    #gameCanvas { display: block; width: 100%; height: 100%; }\n\n    /* Info panel */\n    #info-panel {\n      width: 240px;\n      background: linear-gradient(180deg, rgba(20,24,48,0.9), rgba(15,18,35,0.95));\n      border-left: 1px solid rgba(255,215,0,0.1);\n      overflow-y: auto; flex-shrink: 0; padding: 8px;\n      display: flex; flex-direction: column; gap: 8px;\n    }\n    #info-panel h3 { font-size: 11px; color: #888; margin-bottom: 4px; }\n    .info-entry { font-size: 11px; padding: 3px 0; color: #ccc; }\n\n    /* Realm panel */\n    .realm-panel {\n      background: rgba(255,215,0,0.03);\n      border: 1px solid rgba(255,215,0,0.15);\n      border-radius: 8px; padding: 10px;\n    }\n    .realm-panel .realm-name {\n      color: #ffd700; font-weight: bold; font-size: 15px;\n      text-shadow: 0 0 6px rgba(255,215,0,0.3);\n    }\n    .realm-panel .realm-exp-bar {\n      background: rgba(255,255,255,0.08);\n      border-radius: 4px; height: 16px;\n      margin: 6px 0; position: relative; overflow: hidden;\n    }\n    .realm-panel .realm-exp-fill {\n      background: linear-gradient(90deg, #ffd700, #ff8c00);\n      height: 100%; border-radius: 4px; transition: width 0.3s;\n      box-shadow: 0 0 8px rgba(255,215,0,0.3);\n    }\n    .realm-panel .realm-exp-text {\n      position: absolute; top: 0; left: 50%; transform: translateX(-50%);\n      font-size: 9px; color: #fff; line-height: 16px;\n    }\n    .breakthrough-btn {\n      background: linear-gradient(135deg, #ffd700, #ff8c00);\n      border: none; color: #1a1a2e; font-weight: bold;\n      padding: 6px 12px; border-radius: 6px; cursor: pointer;\n      font-size: 12px; width: 100%; margin-top: 6px;\n      transition: all 0.2s; letter-spacing: 1px;\n    }\n    .breakthrough-btn:hover { opacity: 0.9; box-shadow: 0 0 12px rgba(255,215,0,0.4); }\n    .breakthrough-btn:disabled {\n      background: rgba(255,255,255,0.08); color: #555;\n      cursor: not-allowed; box-shadow: none;\n    }\n    .breakthrough-req { font-size: 10px; color: #777; padding: 2px 0; }\n    .breakthrough-req.met { color: #6c6; }\n    .breakthrough-req.unmet { color: #c44; }\n\n    /* Inventory panel */\n    .inventory-panel {\n      background: rgba(255,255,255,0.02);\n      border: 1px solid rgba(255,255,255,0.08);\n      border-radius: 8px; padding: 8px;\n    }\n    .pill-item {\n      display: flex; align-items: center; gap: 6px;\n      padding: 4px 0; font-size: 11px;\n    }\n    .pill-item .pill-name { flex: 1; }\n    .pill-item .pill-count { color: #888; }\n    .pill-use-btn {\n      background: rgba(100,200,100,0.15);\n      border: 1px solid rgba(100,200,100,0.25);\n      color: #6c6; padding: 2px 8px; border-radius: 3px;\n      cursor: pointer; font-size: 10px; transition: background 0.2s;\n    }\n    .pill-use-btn:hover { background: rgba(100,200,100,0.25); }\n    .pill-use-all-btn {\n      background: rgba(255,200,50,0.15);\n      border: 1px solid rgba(255,200,50,0.25);\n      color: #ffd700; padding: 2px 6px; border-radius: 3px;\n      cursor: pointer; font-size: 10px;\n    }\n\n    /* Alchemy panel */\n    .alchemy-panel {\n      background: rgba(255,140,50,0.03);\n      border: 1px solid rgba(255,140,50,0.15);\n      border-radius: 8px; padding: 8px;\n    }\n    .recipe-item {\n      display: flex; align-items: center; gap: 6px;\n      padding: 4px 0; font-size: 11px;\n    }\n    .recipe-item .recipe-name { flex: 1; }\n    .recipe-craft-btn {\n      background: rgba(255,140,50,0.15);\n      border: 1px solid rgba(255,140,50,0.25);\n      color: #ff8c32; padding: 2px 8px; border-radius: 3px;\n      cursor: pointer; font-size: 10px; transition: background 0.2s;\n    }\n    .recipe-craft-btn:hover { background: rgba(255,140,50,0.25); }\n    .recipe-craft-btn:disabled { opacity: 0.4; cursor: not-allowed; }\n    .alchemy-progress {\n      background: rgba(255,255,255,0.08);\n      border-radius: 4px; height: 14px;\n      margin: 6px 0; position: relative; overflow: hidden;\n    }\n    .alchemy-progress-fill {\n      background: linear-gradient(90deg, #ff8c32, #ffaa00);\n      height: 100%; border-radius: 4px; transition: width 0.3s;\n      box-shadow: 0 0 6px rgba(255,140,50,0.3);\n    }\n    .alchemy-progress-text {\n      position: absolute; top: 0; left: 50%; transform: translateX(-50%);\n      font-size: 9px; color: #fff; line-height: 14px;\n    }\n    .alchemy-collect-btn {\n      background: linear-gradient(135deg, #ff8c32, #ffaa00);\n      border: none; color: #1a1a2e; font-weight: bold;\n      padding: 6px 12px; border-radius: 4px; cursor: pointer;\n      font-size: 11px; width: 100%; letter-spacing: 1px;\n    }\n\n    /* Notifications */\n    #notifications {\n      position: absolute; top: 56px; right: 12px;\n      display: flex; flex-direction: column; gap: 4px;\n      pointer-events: none; z-index: 10;\n    }\n    .notif {\n      padding: 8px 14px; border-radius: 6px;\n      font-size: 11px; opacity: 0; transition: opacity 0.3s;\n      pointer-events: auto; backdrop-filter: blur(4px);\n    }\n    .notif.show { opacity: 1; }\n    .notif.info { background: rgba(100,100,255,0.2); border: 1px solid rgba(100,100,255,0.3); }\n    .notif.success { background: rgba(100,200,100,0.2); border: 1px solid rgba(100,200,100,0.3); }\n    .notif.warning { background: rgba(255,200,50,0.2); border: 1px solid rgba(255,200,50,0.3); }\n    .notif.error { background: rgba(200,100,100,0.2); border: 1px solid rgba(200,100,100,0.3); }\n\n    /* Status bar */\n    #statusbar {\n      display: flex; align-items: center; gap: 12px;\n      padding: 4px 12px;\n      background: linear-gradient(0deg, rgba(10,14,26,0.95), rgba(20,24,48,0.95));\n      border-top: 1px solid rgba(255,215,0,0.1);\n      font-size: 11px; color: #666;\n      min-height: 28px; flex-shrink: 0;\n    }\n    #statusbar .fps { color: #6a6; }\n\n    #placement-hint {\n      position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%);\n      background: rgba(0,0,0,0.85); color: #ffd700;\n      padding: 8px 20px; border-radius: 6px; font-size: 12px;\n      pointer-events: none; display: none;\n      border: 1px solid rgba(255,215,0,0.2);\n    }\n\n    /* Region navigation */\n    .region-nav { display: flex; flex-wrap: wrap; gap: 4px; padding: 4px 0; }\n    .region-btn {\n      background: rgba(255,255,255,0.03);\n      border: 1px solid rgba(255,255,255,0.08);\n      color: #999; padding: 3px 8px; border-radius: 3px;\n      cursor: pointer; font-size: 10px; transition: all 0.2s;\n    }\n    .region-btn:hover { background: rgba(255,215,0,0.05); border-color: rgba(255,215,0,0.2); }\n    .region-btn.active { background: rgba(100,200,100,0.15); border-color: rgba(100,200,100,0.3); color: #6c6; }\n    .region-btn.locked { opacity: 0.4; cursor: not-allowed; }\n\n    /* Building category tabs */\n    .building-tabs { display: flex; gap: 2px; margin-bottom: 4px; }\n    .building-tab {\n      flex: 1; background: rgba(255,255,255,0.02);\n      border: 1px solid rgba(255,255,255,0.06);\n      color: #555; padding: 3px 0; border-radius: 3px;\n      cursor: pointer; font-size: 9px; text-align: center;\n      transition: all 0.2s;\n    }\n    .building-tab.active { background: rgba(255,215,0,0.08); color: #e0e0e0; border-color: rgba(255,215,0,0.2); }\n\n    /* Scrollbar */\n    ::-webkit-scrollbar { width: 5px; }\n    ::-webkit-scrollbar-track { background: transparent; }\n    ::-webkit-scrollbar-thumb { background: rgba(255,215,0,0.15); border-radius: 3px; }\n    ::-webkit-scrollbar-thumb:hover { background: rgba(255,215,0,0.3); }\n\n    /* Tab buttons for info panel */\n    .tab-bar { display: flex; gap: 4px; margin-bottom: 4px; }\n    .tab-btn {\n      flex: 1; background: rgba(255,255,255,0.03);\n      border: 1px solid rgba(255,255,255,0.08);\n      color: #666; padding: 4px 0; border-radius: 3px;\n      cursor: pointer; font-size: 10px; text-align: center;\n      transition: all 0.2s;\n    }\n    .tab-btn.active { background: rgba(255,255,255,0.08); color: #e0e0e0; border-color: rgba(255,215,0,0.2); }\n    .tab-content { display: none; }\n    .tab-content.active { display: block; }\n  </style>\n</head>\n<body>\n\n  <!-- ========== LOADING SCREEN ========== -->\n  <div id=\"loading-screen\">\n    <canvas id=\"loading-particles\" class=\"loading-particles\"></canvas>\n    <div class=\"loading-title\">修仙自动化工厂</div>\n    <div class=\"loading-subtitle\">CULTIVATION FACTORY</div>\n    <div class=\"loading-bar-container\">\n      <div class=\"loading-bar-fill\" id=\"loading-fill\"></div>\n    </div>\n    <div class=\"loading-text\" id=\"loading-text\">正在加载资源...</div>\n  </div>\n\n  <!-- ========== MAIN MENU ========== -->\n  <div id=\"main-menu\">\n    <div class=\"menu-bg\"></div>\n    <div class=\"menu-content\">\n      <div class=\"menu-logo\">⛰ 修仙工厂</div>\n      <div class=\"menu-version\" id=\"menu-version\">v0.5.0</div>\n      <div class=\"menu-buttons\">\n        <button class=\"menu-btn primary\" id=\"btn-continue\">继续修炼</button>\n        <button class=\"menu-btn\" id=\"btn-new-game\">新的旅程</button>\n        <button class=\"menu-btn\" id=\"btn-settings\">⚙ 系统设置</button>\n        <button class=\"menu-btn\" id=\"btn-quit\">退出游戏</button>\n      </div>\n      <div class=\"menu-footer\">\n        <span class=\"steam-status\" id=\"steam-status\"></span>\n      </div>\n    </div>\n  </div>\n\n  <!-- ========== SETTINGS PAGE ========== -->\n  <div id=\"settings-page\">\n    <div class=\"settings-panel\">\n      <div class=\"settings-title\">⚙ 系统设置</div>\n\n      <div class=\"settings-group\">\n        <div class=\"settings-group-label\">🔊 音频</div>\n        <div class=\"setting-row\">\n          <span class=\"setting-label\">主音量</span>\n          <input type=\"range\" class=\"setting-slider\" id=\"set-master-vol\" min=\"0\" max=\"100\" value=\"80\">\n          <span class=\"setting-value\" id=\"val-master-vol\">80</span>\n        </div>\n        <div class=\"setting-row\">\n          <span class=\"setting-label\">音效</span>\n          <input type=\"range\" class=\"setting-slider\" id=\"set-sfx-vol\" min=\"0\" max=\"100\" value=\"100\">\n          <span class=\"setting-value\" id=\"val-sfx-vol\">100</span>\n        </div>\n        <div class=\"setting-row\">\n          <span class=\"setting-label\">音乐</span>\n          <input type=\"range\" class=\"setting-slider\" id=\"set-music-vol\" min=\"0\" max=\"100\" value=\"70\">\n          <span class=\"setting-value\" id=\"val-music-vol\">70</span>\n        </div>\n      </div>\n\n      <div class=\"settings-group\">\n        <div class=\"settings-group-label\">🖥 显示</div>\n        <div class=\"setting-row\">\n          <span class=\"setting-label\">分辨率</span>\n          <select class=\"setting-select\" id=\"set-resolution\">\n            <option value=\"960x600\">960 × 600</option>\n            <option value=\"1280x800\" selected>1280 × 800</option>\n            <option value=\"1600x900\">1600 × 900</option>\n            <option value=\"1920x1080\">1920 × 1080</option>\n          </select>\n        </div>\n        <div class=\"setting-row\">\n          <span class=\"setting-label\">全屏</span>\n          <button class=\"setting-toggle\" id=\"set-fullscreen\"></button>\n        </div>\n        <div class=\"setting-row\">\n          <span class=\"setting-label\">画质</span>\n          <select class=\"setting-select\" id=\"set-quality\">\n            <option value=\"low\">低</option>\n            <option value=\"medium\">中</option>\n            <option value=\"high\" selected>高</option>\n          </select>\n        </div>\n        <div class=\"setting-row\">\n          <span class=\"setting-label\">显示FPS</span>\n          <button class=\"setting-toggle on\" id=\"set-showfps\"></button>\n        </div>\n      </div>\n\n      <div class=\"settings-group\">\n        <div class=\"settings-group-label\">💾 存储</div>\n        <div class=\"setting-row\">\n          <span class=\"setting-label\">自动保存</span>\n          <select class=\"setting-select\" id=\"set-autosave\">\n            <option value=\"30\">每30秒</option>\n            <option value=\"60\" selected>每60秒</option>\n            <option value=\"120\">每2分钟</option>\n            <option value=\"300\">每5分钟</option>\n          </select>\n        </div>\n      </div>\n\n      <div class=\"settings-actions\">\n        <button class=\"settings-btn\" id=\"btn-settings-cancel\">取消</button>\n        <button class=\"settings-btn save\" id=\"btn-settings-save\">保存设置</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- ========== GAME UI ========== -->\n  <div id=\"game-ui\">\n    <div id=\"toolbar\">\n      <h1>⛰ 修仙工厂</h1>\n      <div class=\"spacer\"></div>\n      <button class=\"toolbar-btn\" id=\"btn-audio\" title=\"音效开关\">🔊</button>\n      <button class=\"toolbar-btn\" id=\"btn-menu\" title=\"返回菜单\">☰ 菜单</button>\n      <button class=\"toolbar-btn\" id=\"btn-settings-ingame\" title=\"设置\">⚙ 设置</button>\n      <button class=\"toolbar-btn\" id=\"btn-save\" title=\"保存游戏\">💾 保存</button>\n      <button class=\"toolbar-btn\" id=\"btn-center\" title=\"居中视角\">◎ 居中</button>\n      <button class=\"toolbar-btn\" id=\"btn-reset\" title=\"重置游戏\">⚠ 重置</button>\n    </div>\n    <div id=\"main\">\n      <div id=\"sidebar\">\n        <div class=\"sidebar-section\">\n          <h3>🗺 区域</h3>\n          <div id=\"region-list\" class=\"region-nav\"></div>\n        </div>\n        <div class=\"sidebar-section\">\n          <h3>🏗 建筑设施</h3>\n          <div class=\"building-tabs\" id=\"building-tabs\">\n            <button class=\"building-tab active\" data-cat=\"all\">全部</button>\n            <button class=\"building-tab\" data-cat=\"mining\">⛏ 矿</button>\n            <button class=\"building-tab\" data-cat=\"farming\">🌿 田</button>\n            <button class=\"building-tab\" data-cat=\"alchemy\">🔥 炉</button>\n            <button class=\"building-tab\" data-cat=\"transport\">➡ 道</button>\n            <button class=\"building-tab\" data-cat=\"automation\">🤖 傀</button>\n          </div>\n          <div id=\"building-list\"></div>\n        </div>\n        <div class=\"sidebar-section\">\n          <h3>🔬 炼丹配方</h3>\n          <div id=\"recipe-list\"></div>\n        </div>\n      </div>\n      <div id=\"canvas-container\">\n        <canvas id=\"gameCanvas\"></canvas>\n        <div id=\"placement-hint\">点击地图放置建筑 | ESC 取消</div>\n        <div id=\"notifications\"></div>\n      </div>\n      <div id=\"info-panel\">\n        <!-- Realm panel -->\n        <div class=\"realm-panel\" id=\"realm-panel\">\n          <div class=\"realm-name\" id=\"realm-name\">凡人</div>\n          <div class=\"realm-exp-bar\">\n            <div class=\"realm-exp-fill\" id=\"realm-exp-fill\" style=\"width:0%\"></div>\n            <div class=\"realm-exp-text\" id=\"realm-exp-text\">0%</div>\n          </div>\n          <div id=\"breakthrough-reqs\"></div>\n          <button class=\"breakthrough-btn\" id=\"btn-breakthrough\" disabled>境界突破</button>\n        </div>\n\n        <!-- Tab bar -->\n        <div class=\"tab-bar\">\n          <button class=\"tab-btn active\" data-tab=\"inventory\">🎒 丹药</button>\n          <button class=\"tab-btn\" data-tab=\"info\">📊 信息</button>\n          <button class=\"tab-btn\" data-tab=\"alchemy\">🔥 炼丹</button>\n        </div>\n\n        <!-- Inventory tab -->\n        <div class=\"tab-content active\" id=\"tab-inventory\">\n          <div class=\"inventory-panel\">\n            <h3>💊 丹药背包</h3>\n            <div id=\"pill-list\"><div class=\"info-entry\">暂无丹药</div></div>\n          </div>\n        </div>\n\n        <!-- Info tab -->\n        <div class=\"tab-content\" id=\"tab-info\">\n          <div id=\"building-info\"><div class=\"info-entry\">点击建筑查看详情</div></div>\n        </div>\n\n        <!-- Alchemy tab -->\n        <div class=\"tab-content\" id=\"tab-alchemy\">\n          <div class=\"alchemy-panel\">\n            <h3>🔥 炼丹进度</h3>\n            <div id=\"alchemy-status\">\n              <div class=\"info-entry\">选择配方开始炼丹</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div id=\"statusbar\">\n      <span class=\"fps\" id=\"fps-display\">FPS: --</span>\n      <span id=\"status-text\">就绪</span>\n      <div class=\"spacer\"></div>\n      <span id=\"playtime\">游玩时间: 0:00</span>\n    </div>\n  </div>\n\n  <script type=\"module\">\n    import { App } from './src/renderer/App.ts';\n    import { loadSettings, saveSettings, updateSetting, getAvailableResolutions, getDefaultSettings } from './src/game/Settings.ts';\n\n    // ==================== LOADING SCREEN ====================\n    const loadingScreen = document.getElementById('loading-screen');\n    const loadingFill = document.getElementById('loading-fill');\n    const loadingText = document.getElementById('loading-text');\n\n    // Particle animation on loading screen\n    const loadCanvas = document.getElementById('loading-particles');\n    const loadCtx = loadCanvas.getContext('2d');\n    loadCanvas.width = window.innerWidth;\n    loadCanvas.height = window.innerHeight;\n\n    const particles = Array.from({ length: 40 }, () => ({\n      x: Math.random() * loadCanvas.width,\n      y: Math.random() * loadCanvas.height,\n      vx: (Math.random() - 0.5) * 0.3,\n      vy: -Math.random() * 0.5 - 0.2,\n      size: Math.random() * 2 + 0.5,\n      alpha: Math.random() * 0.5 + 0.1,\n    }));\n\n    let loadAnimId: number;\n    function animateLoading() {\n      loadCtx.clearRect(0, 0, loadCanvas.width, loadCanvas.height);\n      for (const p of particles) {\n        p.x += p.vx;\n        p.y += p.vy;\n        if (p.y < -10) { p.y = loadCanvas.height + 10; p.x = Math.random() * loadCanvas.width; }\n        loadCtx.fillStyle = `rgba(255, 215, 0, ${p.alpha})`;\n        loadCtx.beginPath();\n        loadCtx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\n        loadCtx.fill();\n      }\n      loadAnimId = requestAnimationFrame(animateLoading);\n    }\n    animateLoading();\n\n    // Simulate loading progress\n    let loadProgress = 0;\n    const loadMessages = ['正在加载资源...', '初始化灵脉...', '唤醒傀儡...', '点燃丹炉...', '准备就绪'];\n    const loadInterval = setInterval(() => {\n      loadProgress += Math.random() * 15 + 5;\n      if (loadProgress >= 100) loadProgress = 100;\n      loadingFill.style.width = `${loadProgress}%`;\n      loadingText.textContent = loadMessages[Math.min(4, Math.floor(loadProgress / 25))];\n      if (loadProgress >= 100) {\n        clearInterval(loadInterval);\n        setTimeout(() => {\n          cancelAnimationFrame(loadAnimId);\n          loadingScreen.classList.add('fade-out');\n          setTimeout(() => {\n            loadingScreen.style.display = 'none';\n            showMainMenu();\n          }, 800);\n        }, 300);\n      }\n    }, 200);\n\n    // ==================== MAIN MENU ====================\n    const mainMenu = document.getElementById('main-menu');\n    const steamStatus = document.getElementById('steam-status');\n    const gameUI = document.getElementById('game-ui');\n    let app: App | null = null;\n    let isGameRunning = false;\n\n    // Check Steam availability\n    const electronAPI = (window as any).electronAPI;\n    if (electronAPI) {\n      electronAPI.isSteamAvailable().then((available: boolean) => {\n        steamStatus.textContent = available ? '✓ Steam 已连接' : '— 离线模式';\n        steamStatus.className = `steam-status${available ? '' : ' offline'}`;\n        const version = document.getElementById('menu-version');\n        electronAPI.getAppVersion().then((v: string) => {\n          version.textContent = `v${v}`;\n        });\n      });\n    } else {\n      steamStatus.textContent = '— 浏览器模式';\n      steamStatus.className = 'steam-status offline';\n    }\n\n    function showMainMenu() {\n      mainMenu.classList.add('active');\n      if (isGameRunning && app) {\n        app.stop();\n        isGameRunning = false;\n      }\n    }\n\n    function startGame(newGame: boolean) {\n      mainMenu.classList.remove('active');\n      gameUI.classList.add('active');\n      isGameRunning = true;\n\n      if (!app) {\n        const canvas = document.getElementById('gameCanvas') as HTMLCanvasElement;\n        app = new App(canvas);\n        setupGameUI();\n      } else if (newGame) {\n        import('./src/game/GameState.ts').then(({ clearSave }) => {\n          clearSave();\n          location.reload();\n        });\n        return;\n      }\n\n      app.centerCamera();\n      app.start();\n    }\n\n    // Menu buttons\n    document.getElementById('btn-continue').addEventListener('click', () => startGame(false));\n    document.getElementById('btn-new-game').addEventListener('click', () => {\n      if (isGameRunning) {\n        if (confirm('开始新游戏将清除当前进度，确定吗？')) {\n          startGame(true);\n        }\n      } else {\n        startGame(true);\n      }\n    });\n    document.getElementById('btn-settings').addEventListener('click', () => showSettings());\n    document.getElementById('btn-quit').addEventListener('click', () => {\n      if (electronAPI) {\n        electronAPI.quit();\n      } else {\n        if (confirm('确定要退出游戏吗？')) {\n          window.close();\n        }\n      }\n    });\n\n    // ==================== SETTINGS PAGE ====================\n    const settingsPage = document.getElementById('settings-page');\n    let settings = loadSettings();\n    let previousPage = 'menu'; // 'menu' or 'game'\n\n    function showSettings() {\n      previousPage = mainMenu.classList.contains('active') ? 'menu' : 'game';\n      settingsPage.classList.add('active');\n      populateSettings();\n    }\n\n    function hideSettings() {\n      settingsPage.classList.remove('active');\n    }\n\n    function populateSettings() {\n      (document.getElementById('set-master-vol') as HTMLInputElement).value = String(settings.masterVolume);\n      document.getElementById('val-master-vol').textContent = String(settings.masterVolume);\n      (document.getElementById('set-sfx-vol') as HTMLInputElement).value = String(settings.sfxVolume);\n      document.getElementById('val-sfx-vol').textContent = String(settings.sfxVolume);\n      (document.getElementById('set-music-vol') as HTMLInputElement).value = String(settings.musicVolume);\n      document.getElementById('val-music-vol').textContent = String(settings.musicVolume);\n\n      const resKey = `${settings.resolution.width}x${settings.resolution.height}`;\n      (document.getElementById('set-resolution') as HTMLSelectElement).value = resKey;\n\n      const fsBtn = document.getElementById('set-fullscreen');\n      fsBtn.classList.toggle('on', settings.fullscreen);\n\n      const fpsBtn = document.getElementById('set-showfps');\n      fpsBtn.classList.toggle('on', settings.showFPS);\n\n      (document.getElementById('set-quality') as HTMLSelectElement).value = settings.particleQuality;\n      (document.getElementById('set-autosave') as HTMLSelectElement).value = String(settings.autoSaveInterval);\n    }\n\n    // Slider bindings\n    ['master-vol', 'sfx-vol', 'music-vol'].forEach(key => {\n      const slider = document.getElementById(`set-${key}`) as HTMLInputElement;\n      const label = document.getElementById(`val-${key}`);\n      slider.addEventListener('input', () => { label.textContent = slider.value; });\n    });\n\n    // Toggle bindings\n    ['set-fullscreen', 'set-showfps'].forEach(id => {\n      document.getElementById(id).addEventListener('click', function() {\n        this.classList.toggle('on');\n      });\n    });\n\n    document.getElementById('btn-settings-cancel').addEventListener('click', hideSettings);\n    document.getElementById('btn-settings-save').addEventListener('click', () => {\n      const masterVol = parseInt((document.getElementById('set-master-vol') as HTMLInputElement).value);\n      const sfxVol = parseInt((document.getElementById('set-sfx-vol') as HTMLInputElement).value);\n      const musicVol = parseInt((document.getElementById('set-music-vol') as HTMLInputElement).value);\n      const resVal = (document.getElementById('set-resolution') as HTMLSelectElement).value.split('x');\n      const fullscreen = document.getElementById('set-fullscreen').classList.contains('on');\n      const showFPS = document.getElementById('set-showfps').classList.contains('on');\n      const quality = (document.getElementById('set-quality') as HTMLSelectElement).value;\n      const autoSave = parseInt((document.getElementById('set-autosave') as HTMLSelectElement).value);\n\n      settings = {\n        masterVolume: masterVol,\n        sfxVolume: sfxVol,\n        musicVolume: musicVol,\n        resolution: { width: parseInt(resVal[0]), height: parseInt(resVal[1]) },\n        fullscreen,\n        language: 'zh-CN',\n        autoSaveInterval: autoSave,\n        showFPS,\n        particleQuality: quality as any,\n      };\n      saveSettings(settings);\n\n      // Apply Electron-level settings\n      if (electronAPI) {\n        electronAPI.setFullscreen(fullscreen);\n        electronAPI.setResolution(parseInt(resVal[0]), parseInt(resVal[1]));\n      }\n\n      hideSettings();\n    });\n\n    // Settings from toolbar\n    document.getElementById('btn-settings-ingame').addEventListener('click', showSettings);\n\n    // ==================== GAME UI SETUP ====================\n    function setupGameUI() {\n      if (!app) return;\n\n      const canvas = document.getElementById('gameCanvas') as HTMLCanvasElement;\n\n      // FPS counter\n      let frameCount = 0;\n      let fpsTime = performance.now();\n      const fpsDisplay = document.getElementById('fps-display');\n      const statusText = document.getElementById('status-text');\n      const playtimeDisplay = document.getElementById('playtime');\n\n      setInterval(() => {\n        const now = performance.now();\n        const fps = Math.round(frameCount * 1000 / (now - fpsTime));\n        fpsDisplay.textContent = `FPS: ${fps}`;\n        fpsDisplay.style.display = settings.showFPS ? '' : 'none';\n        frameCount = 0;\n        fpsTime = now;\n\n        if (app) {\n          const secs = Math.floor(app.state.totalPlaytime);\n          const mins = Math.floor(secs / 60);\n          const hrs = Math.floor(mins / 60);\n          playtimeDisplay.textContent = `游玩时间: ${hrs}:${String(mins % 60).padStart(2, '0')}`;\n        }\n      }, 1000);\n\n      const origLoop = app.loop.bind(app);\n      app.loop = (now) => { frameCount++; origLoop(now); };\n\n      // === Notifications ===\n      const notifContainer = document.getElementById('notifications');\n      app.onNotification = (notif) => {\n        const el = document.createElement('div');\n        el.className = `notif ${notif.type}`;\n        el.textContent = notif.text;\n        notifContainer.appendChild(el);\n        requestAnimationFrame(() => el.classList.add('show'));\n        setTimeout(() => {\n          el.classList.remove('show');\n          setTimeout(() => el.remove(), 300);\n        }, 3000);\n      };\n\n      // === Tabs ===\n      document.querySelectorAll('.tab-btn').forEach(btn => {\n        btn.addEventListener('click', () => {\n          document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\n          document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));\n          btn.classList.add('active');\n          document.getElementById(`tab-${(btn as HTMLElement).dataset.tab}`).classList.add('active');\n        });\n      });\n\n      // === Building sidebar ===\n      const buildingList = document.getElementById('building-list');\n      const placementHint = document.getElementById('placement-hint');\n\n      function renderBuildingList() {\n        buildingList.innerHTML = '';\n        let available = app!.getAvailableBuildings();\n        if (buildingCategoryFilter !== 'all') {\n          available = available.filter(d => d.category === buildingCategoryFilter);\n        }\n        for (const def of available) {\n          const item = document.createElement('div');\n          item.className = 'building-item';\n          if (app!.placementMode?.id === def.id) item.classList.add('selected');\n\n          const affordable = !Object.keys(def.cost).length ||\n            Object.entries(def.cost).every(([r, c]) => (app!.state.resources[r] ?? 0) >= c);\n\n          const icon = getIcon(def.category);\n          const costStr = Object.entries(def.cost).length > 0\n            ? Object.entries(def.cost).map(([r, c]) => `${getResourceName(r)}:${c}`).join(' ')\n            : '免费';\n\n          item.innerHTML = `\n            <span class=\"icon\">${icon}</span>\n            <div class=\"info\">\n              <div class=\"name\">${def.name}</div>\n              <div class=\"cost ${affordable ? '' : 'cannot'}\">${costStr}</div>\n            </div>\n          `;\n\n          item.addEventListener('click', () => {\n            if (app!.placementMode?.id === def.id) {\n              app!.placementMode = null;\n              placementHint.style.display = 'none';\n              statusText.textContent = '就绪';\n            } else {\n              app!.placementMode = def;\n              placementHint.style.display = 'block';\n              statusText.textContent = `放置模式: ${def.name}`;\n            }\n            renderBuildingList();\n          });\n\n          buildingList.appendChild(item);\n        }\n      }\n\n      function getIcon(category) {\n        const icons = { mining: '⛏', farming: '🌿', alchemy: '🔥', energy: '✨', cultivation: '🧘', transport: '➡', automation: '🤖', control: '📜', processing: '🔩' };\n        return icons[category] || '🏠';\n      }\n\n      function getResourceName(id) {\n        const names = {\n          spirit_stone: '灵石', spirit_grass: '灵草', spirit_energy: '灵气',\n          cultivation: '修为', pill_juling: '聚灵丹', pill_peiyuan: '培元丹',\n          pill_ningqi: '凝气丹', pill_zhuji: '筑基丹', pill_jindanyin: '金丹引',\n          spirit_iron: '灵铁', spirit_wood: '灵木', talisman_paper: '符纸',\n        };\n        return names[id] ?? id;\n      }\n\n      // === Building category filter ===\n      let buildingCategoryFilter = 'all';\n      document.querySelectorAll('#building-tabs .building-tab').forEach(btn => {\n        btn.addEventListener('click', () => {\n          document.querySelectorAll('.building-tab').forEach(b => b.classList.remove('active'));\n          btn.classList.add('active');\n          buildingCategoryFilter = (btn as HTMLElement).dataset.cat!;\n          renderBuildingList();\n        });\n      });\n\n      renderBuildingList();\n\n      // === Region navigation ===\n      function renderRegionList() {\n        const regionList = document.getElementById('region-list');\n        regionList.innerHTML = '';\n        const regions = app!.getUnlockedRegions();\n        for (const r of regions) {\n          const btn = document.createElement('button');\n          btn.className = 'region-btn' + (r.index === app!.currentRegionIndex ? ' active' : '');\n          btn.textContent = r.name;\n          btn.addEventListener('click', () => {\n            app!.switchRegion(r.index);\n            renderRegionList();\n          });\n          regionList.appendChild(btn);\n        }\n        const allRegions = [\n          { name: '炼气坪', unlock: 'liqi_1' },\n          { name: '灵田区', unlock: 'liqi_5' },\n          { name: '灵石矿区', unlock: 'liqi_8' },\n          { name: '筑基台', unlock: 'zhuji_1' },\n          { name: '药王谷', unlock: 'zhuji_10' },\n          { name: '丹鼎峰', unlock: 'jindan_1' },\n          { name: '矿脉山', unlock: 'jindan_5' },\n        ];\n        const unlockedNames = new Set(regions.map(r => r.name));\n        for (const ar of allRegions) {\n          if (!unlockedNames.has(ar.name)) {\n            const btn = document.createElement('button');\n            btn.className = 'region-btn locked';\n            btn.textContent = `🔒 ${ar.name}`;\n            btn.title = `需要达到 ${ar.unlock.replace('_', ' Lv')} 解锁`;\n            regionList.appendChild(btn);\n          }\n        }\n      }\n\n      renderRegionList();\n      app.onRegionChange = () => { renderRegionList(); };\n\n      // === Recipe sidebar ===\n      function renderRecipeList() {\n        const recipeList = document.getElementById('recipe-list');\n        recipeList.innerHTML = '';\n        const recipes = app!.getAvailableAlchemyRecipes();\n        for (const recipe of recipes) {\n          const item = document.createElement('div');\n          item.className = 'recipe-item';\n\n          const ingredients = Object.entries(recipe.ingredients)\n            .map(([r, c]) => `${getResourceName(r)}:${c}`).join(' ');\n          const canCraftNow = app!.state.alchemySession === null &&\n            Object.entries(recipe.ingredients).every(([r, c]) => (app!.state.resources[r] ?? 0) >= c);\n\n          item.innerHTML = `\n            <span style=\"color:${recipe.output.resource === 'pill_juling' ? '#ff8c32' : recipe.output.resource === 'pill_peiyuan' ? '#ff6699' : '#cc66ff'}\">💊</span>\n            <span class=\"recipe-name\">${recipe.name}</span>\n            <button class=\"recipe-craft-btn\" ${canCraftNow ? '' : 'disabled'}>${ingredients}</button>\n          `;\n\n          item.querySelector('.recipe-craft-btn').addEventListener('click', () => {\n            app!.startAlchemyAction(recipe.id);\n          });\n\n          recipeList.appendChild(item);\n        }\n      }\n\n      // === Realm panel ===\n      function renderRealmPanel() {\n        const c = app!.state.cultivation;\n        const nameEl = document.getElementById('realm-name');\n        const fillEl = document.getElementById('realm-exp-fill');\n        const textEl = document.getElementById('realm-exp-text');\n        const reqsEl = document.getElementById('breakthrough-reqs');\n        const btnEl = document.getElementById('btn-breakthrough');\n\n        import('./src/game/Cultivation.ts').then(({ getFullRealmName, canBreakthrough, getBreakthroughRequirements, getSubStageName }) => {\n          nameEl.textContent = getFullRealmName(c);\n          const ratio = c.exp / c.expToNext;\n          fillEl.style.width = `${Math.floor(ratio * 100)}%`;\n          textEl.textContent = `${Math.floor(ratio * 100)}%`;\n\n          const reqs = getBreakthroughRequirements(c);\n          reqsEl.innerHTML = '';\n\n          if (reqs.canAttempt || c.level >= 3) {\n            for (const [res, amount] of Object.entries(reqs.resourceCost)) {\n              const current = app!.state.resources[res] ?? 0;\n              const met = current >= amount;\n              reqsEl.innerHTML += `<div class=\"breakthrough-req ${met ? 'met' : 'unmet'}\">${met ? '✓' : '✗'} ${getResourceName(res)}: ${current}/${amount}</div>`;\n            }\n            if (reqs.needsPill && reqs.pillId) {\n              const current = app!.state.resources[reqs.pillId] ?? 0;\n              const met = current >= reqs.pillCount;\n              reqsEl.innerHTML += `<div class=\"breakthrough-req ${met ? 'met' : 'unmet'}\">${met ? '✓' : '✗'} ${getResourceName(reqs.pillId)}: ${current}/${reqs.pillCount}</div>`;\n            }\n            reqsEl.innerHTML += `<div class=\"breakthrough-req\" style=\"color:#aaa\">成功率: ${Math.floor(reqs.successRate * 100)}%</div>`;\n\n            const canAttempt = reqs.canAttempt &&\n              Object.entries(reqs.resourceCost).every(([r, a]) => (app!.state.resources[r] ?? 0) >= a) &&\n              (!reqs.needsPill || (app!.state.resources[reqs.pillId ?? ''] ?? 0) >= (reqs.pillCount ?? 0));\n\n            btnEl.disabled = !canAttempt;\n          } else {\n            reqsEl.innerHTML = `<div class=\"breakthrough-req\" style=\"color:#666\">修为满级后可突破</div>`;\n            btnEl.disabled = true;\n          }\n        });\n      }\n\n      // === Inventory panel ===\n      function renderInventory() {\n        const pillList = document.getElementById('pill-list');\n        const pills = app!.getInventoryPills();\n\n        if (pills.length === 0) {\n          pillList.innerHTML = '<div class=\"info-entry\" style=\"color:#555\">暂无丹药</div>';\n          return;\n        }\n\n        pillList.innerHTML = '';\n        for (const pill of pills) {\n          const item = document.createElement('div');\n          item.className = 'pill-item';\n          item.innerHTML = `\n            <span style=\"color:${pill.color}\">💊</span>\n            <span class=\"pill-name\">${pill.name}</span>\n            <span class=\"pill-count\">×${pill.count}</span>\n            <button class=\"pill-use-btn\" data-id=\"${pill.id}\">服用</button>\n            ${pill.count > 1 ? `<button class=\"pill-use-all-btn\" data-id=\"${pill.id}\">全部</button>` : ''}\n          `;\n          pillList.appendChild(item);\n        }\n\n        pillList.querySelectorAll('.pill-use-btn').forEach(btn => {\n          btn.addEventListener('click', () => app!.usePillAction((btn as HTMLElement).dataset.id!));\n        });\n        pillList.querySelectorAll('.pill-use-all-btn').forEach(btn => {\n          btn.addEventListener('click', () => app!.useAllPills((btn as HTMLElement).dataset.id!));\n        });\n      }\n\n      // === Alchemy status ===\n      function renderAlchemyStatus() {\n        const statusEl = document.getElementById('alchemy-status');\n        const session = app!.state.alchemySession;\n\n        if (!session) {\n          statusEl.innerHTML = '<div class=\"info-entry\">选择配方开始炼丹</div>';\n          return;\n        }\n\n        const progress = Math.floor(session.progress * 100);\n        statusEl.innerHTML = `\n          <div class=\"info-entry\" style=\"color:#ff8c32\">${session.recipeId === 'pill_juling' ? '聚灵丹' : session.recipeId === 'pill_peiyuan' ? '培元丹' : '凝气丹'}</div>\n          <div class=\"alchemy-progress\">\n            <div class=\"alchemy-progress-fill\" style=\"width:${progress}%\"></div>\n            <div class=\"alchemy-progress-text\">${progress}%</div>\n          </div>\n          ${session.complete ? '<button class=\"alchemy-collect-btn\" id=\"btn-collect-alchemy\">收取丹药</button>' : ''}\n        `;\n\n        const collectBtn = document.getElementById('btn-collect-alchemy');\n        if (collectBtn) {\n          collectBtn.addEventListener('click', () => app!.collectAlchemyAction());\n        }\n      }\n\n      // === Building info ===\n      function updateBuildingInfo(building) {\n        const infoDiv = document.getElementById('building-info');\n        if (!building) {\n          infoDiv.innerHTML = '<div class=\"info-entry\">点击建筑查看详情</div>';\n          return;\n        }\n        const def = app!.buildingDefs.get(building.buildingId);\n        if (!def) return;\n        const prod = def.production;\n        infoDiv.innerHTML = `\n          <div class=\"info-entry\" style=\"color:#ffd700;font-weight:bold\">${def.name}</div>\n          <div class=\"info-entry\">等级: ${building.level}/${def.maxLevel}</div>\n          <div class=\"info-entry\">类型: ${prod.mode === 'manual' ? '手动' : '自动'}</div>\n          <div class=\"info-entry\">产出: ${getResourceName(prod.resource)} ×${prod.amount}</div>\n          ${prod.interval > 0 ? `<div class=\"info-entry\">间隔: ${(prod.interval / 1000).toFixed(1)}s</div>` : ''}\n          ${prod.input ? `<div class=\"info-entry\">消耗: ${Object.entries(prod.input).map(([r,c]) => `${getResourceName(r)}:${c}`).join(' ')}</div>` : ''}\n          <div class=\"info-entry\">状态: ${building.isProducing ? '生产中' : '空闲'}</div>\n          ${building.progress > 0 ? `<div class=\"info-entry\">进度: ${Math.floor(building.progress * 100)}%</div>` : ''}\n        `;\n      }\n\n      // === State change handler ===\n      app.onStateChange = (state) => {\n        renderBuildingList();\n        renderRecipeList();\n        renderRealmPanel();\n        renderInventory();\n        renderAlchemyStatus();\n      };\n\n      app.onBuildingSelect = (building) => {\n        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\n        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));\n        document.querySelector('[data-tab=\"info\"]').classList.add('active');\n        document.getElementById('tab-info').classList.add('active');\n        updateBuildingInfo(building);\n      };\n\n      app.onAlchemyUpdate = (session) => {\n        renderAlchemyStatus();\n      };\n\n      // === Breakthrough ===\n      document.getElementById('btn-breakthrough').addEventListener('click', () => {\n        app!.attemptBreakthroughAction();\n      });\n\n      // === Toolbar buttons ===\n      document.getElementById('btn-save').addEventListener('click', () => {\n        import('./src/game/GameState.ts').then(({ saveGame }) => {\n          saveGame(app!.state);\n          app!.addNotification('游戏已保存', 'info');\n        });\n      });\n\n      document.getElementById('btn-center').addEventListener('click', () => {\n        app!.centerCamera();\n      });\n\n      document.getElementById('btn-reset').addEventListener('click', () => {\n        if (confirm('确定要重置游戏进度吗？此操作不可撤销！')) {\n          import('./src/game/GameState.ts').then(({ clearSave }) => {\n            clearSave();\n            location.reload();\n          });\n        }\n      });\n\n      // Back to menu\n      document.getElementById('btn-menu').addEventListener('click', () => {\n        if (confirm('返回主菜单？当前进度已自动保存。')) {\n          app!.stop();\n          gameUI.classList.remove('active');\n          showMainMenu();\n        }\n      });\n\n      // Audio toggle\n      import('./src/game/AudioManager.ts').then(({ audioManager }) => {\n        const audioBtn = document.getElementById('btn-audio');\n        audioBtn.addEventListener('click', () => {\n          audioManager.init();\n          const muted = audioManager.toggleMute();\n          audioBtn.textContent = muted ? '🔇' : '🔊';\n        });\n      });\n\n      // Initial render\n      renderRealmPanel();\n      renderInventory();\n      renderAlchemyStatus();\n      renderRecipeList();\n    }\n  </script>\n</body>\n</html>\n","structuredPatch":[{"oldStart":1136,"oldLines":9,"newStart":1136,"newLines":14,"lines":["           return;","         }"," ","+        const RECIPE_NAMES = {","+          pill_juling: '聚灵丹', pill_peiyuan: '培元丹', pill_ningqi: '凝气丹',","+          pill_zhuji: '筑基丹', pill_jindanyin: '金丹引', pill_yuanyingguo: '元婴果',","+          pill_huashenlu: '化神露', pill_jiuzhuan: '九转金丹'","+        };","         const progress = Math.floor(session.progress * 100);","         statusEl.innerHTML = `","-          <div class=\"info-entry\" style=\"color:#ff8c32\">${session.recipeId === 'pill_juling' ? '聚灵丹' : session.recipeId === 'pill_peiyuan' ? '培元丹' : '凝气丹'}</div>","+          <div class=\"info-entry\" style=\"color:#ff8c32\">${RECIPE_NAMES[session.recipeId] ?? session.recipeId}</div>","           <div class=\"alchemy-progress\">","             <div class=\"alchemy-progress-fill\" style=\"width:${progress}%\"></div>","             <div class=\"alchemy-progress-text\">${progress}%</div>"]}],"userModified":false,"replaceAll":false}}
