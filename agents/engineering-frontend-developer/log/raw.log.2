{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a95386a2360440babdcb9812","type":"tool_result","content":"1\t// MatchEngine.js — Match detection, special tile generation, cascade processing\n2\t\n3\tclass MatchResult {\n4\t  constructor() {\n5\t    this.toRemove = new Set();       // \"row,col\" strings\n6\t    this.specials = [];              // { row, col, type, color }\n7\t    this.chainCount = 0;\n8\t    this.totalScore = 0;\n9\t    this.removedByColor = {};        // color -> count for collection goals\n10\t    this.comboText = '';\n11\t  }\n12\t}\n13\t\n14\tclass MatchEngine {\n15\t  constructor(board) {\n16\t    this.board = board;\n17\t    this.onSpecialTrigger = null;    // callback(tile, type)\n18\t  }\n19\t\n20\t  // Full cascade: find matches → remove → gravity → repeat\n21\t  processCascade() {\n22\t    const result = new MatchResult();\n23\t    let chainCount = 0;\n24\t\n25\t    const process = () => {\n26\t      const matches = this.board.findAllMatches();\n27\t      if (matches.length === 0) return Promise.resolve();\n28\t\n29\t      chainCount++;\n30\t      result.chainCount = chainCount;\n31\t\n32\t      // Detect L/T shapes\n33\t      const lShapes = this.board.findLShapeMatches(matches);\n34\t\n35\t      // Determine which cells to remove and what specials to create\n36\t      const { removeCells, specials } = this._classifyMatches(matches, lShapes);\n37\t\n38\t      // Track removed tiles by color\n39\t      for (const key of removeCells) {\n40\t        const [r, c] = key.split(',').map(Number);\n41\t        const tile = this.board.getTile(r, c);\n42\t        if (tile && tile.color >= 0) {\n43\t          result.removedByColor[tile.color] = (result.removedByColor[tile.color] || 0) + 1;\n44\t        }\n45\t        result.toRemove.add(key);\n46\t      }\n47\t\n48\t      // Calculate score\n49\t      const multiplier = chainCount <= 1 ? 1 : chainCount === 2 ? 1.5 : chainCount === 3 ? 2.0 : 2.5;\n50\t      const baseScore = removeCells.size * 10;\n51\t      result.totalScore += Math.floor(baseScore * multiplier);\n52\t\n53\t      // Set combo text\n54\t      if (chainCount >= 4) result.comboText = '超赞！！';\n55\t      else if (chainCount === 3) result.comboText = '太棒了！';\n56\t      else if (chainCount === 2) result.comboText = '不错！';\n57\t\n58\t      // Mark specials to create (don't remove these cells yet)\n59\t      for (const sp of specials) {\n60\t        result.specials.push(sp);\n61\t      }\n62\t\n63\t      // Remove matched tiles (except those becoming specials)\n64\t      const specialPositions = new Set(specials.map(s => `${s.row},${s.col}`));\n65\t      for (const key of removeCells) {\n66\t        if (!specialPositions.has(key)) {\n67\t          const [r, c] = key.split(',').map(Number);\n68\t          this.board.removeTile(r, c);\n69\t        }\n70\t      }\n71\t\n72\t      // Create special tiles in place\n73\t      for (const sp of specials) {\n74\t        const tile = this.board.getTile(sp.row, sp.col);\n75\t        if (tile) {\n76\t          tile.special = sp.type;\n77\t          tile.removing = false;\n78\t        }\n79\t      }\n80\t\n81\t      return new Promise(resolve => {\n82\t        // Gravity + fill\n83\t        setTimeout(() => {\n84\t          const drops = this.board.applyGravity();\n85\t          // Clear nulls\n86\t          for (let r = 0; r < this.board.size; r++) {\n87\t            for (let c = 0; c < this.board.size; c++) {\n88\t              if (this.board.grid[r][c] && this.board.grid[r][c].removing) {\n89\t                this.board.clearCell(r, c);\n90\t              }\n91\t            }\n92\t          }\n93\t\n94\t          // Animate drops then check for more matches\n95\t          setTimeout(() => process().then(resolve), 250);\n96\t        }, 300);\n97\t      });\n98\t    };\n99\t\n100\t    return new Promise(resolve => {\n101\t      process().then(() => {\n102\t        result.chainCount = chainCount;\n103\t        resolve(result);\n104\t      });\n105\t    });\n106\t  }\n107\t\n108\t  // Synchronous version for cascade without animations\n109\t  processCascadeSync() {\n110\t    const result = new MatchResult();\n111\t    let chainCount = 0;\n112\t\n113\t    while (true) {\n114\t      const matches = this.board.findAllMatches();\n115\t      if (matches.length === 0) break;\n116\t\n117\t      chainCount++;\n118\t      const lShapes = this.board.findLShapeMatches(matches);\n119\t      const { removeCells, specials } = this._classifyMatches(matches, lShapes);\n120\t\n121\t      for (const key of removeCells) {\n122\t        const [r, c] = key.split(',').map(Number);\n123\t        const tile = this.board.getTile(r, c);\n124\t        if (tile && tile.color >= 0) {\n125\t          result.removedByColor[tile.color] = (result.removedByColor[tile.color] || 0) + 1;\n126\t        }\n127\t        result.toRemove.add(key);\n128\t      }\n129\t\n130\t      const multiplier = chainCount <= 1 ? 1 : chainCount === 2 ? 1.5 : chainCount === 3 ? 2.0 : 2.5;\n131\t      result.totalScore += Math.floor(removeCells.size * 10 * multiplier);\n132\t\n133\t      if (chainCount >= 4) result.comboText = '超赞！！';\n134\t      else if (chainCount === 3) result.comboText = '太棒了！';\n135\t      else if (chainCount === 2) result.comboText = '不错！';\n136\t\n137\t      result.specials.push(...specials);\n138\t\n139\t      const specialPositions = new Set(specials.map(s => `${s.row},${s.col}`));\n140\t      for (const key of removeCells) {\n141\t        if (!specialPositions.has(key)) {\n142\t          const [r, c] = key.split(',').map(Number);\n143\t          this.board.clearCell(r, c);\n144\t        }\n145\t      }\n146\t\n147\t      for (const sp of specials) {\n148\t        const tile = this.board.getTile(sp.row, sp.col);\n149\t        if (tile) {\n150\t          tile.special = sp.type;\n151\t          tile.removing = false;\n152\t        }\n153\t      }\n154\t\n155\t      this.board.applyGravity();\n156\t    }\n157\t\n158\t    result.chainCount = chainCount;\n159\t    return result;\n160\t  }\n161\t\n162\t  _classifyMatches(matches, lShapes) {\n163\t    const removeCells = new Set();\n164\t    const specials = [];\n165\t    const lShapeCells = new Set();\n166\t\n167\t    // L/T shapes first (highest priority)\n168\t    for (const l of lShapes) {\n169\t      const center = l.cells[Math.floor(l.cells.length / 2)];\n170\t      specials.push({ row: center.row, col: center.col, type: SPECIAL_BOMB, color: l.color });\n171\t      for (const cell of l.cells) {\n172\t        removeCells.add(`${cell.row},${cell.col}`);\n173\t        lShapeCells.add(`${cell.row},${cell.col}`);\n174\t      }\n175\t    }\n176\t\n177\t    // Process remaining matches — skip any that overlap with L-shapes\n178\t    for (const match of matches) {\n179\t      const overlapCount = match.cells.filter(c => lShapeCells.has(`${c.row},${c.col}`)).length;\n180\t      if (overlapCount > 0) {\n181\t        // Already handled by L-shape, just add cells to remove set\n182\t        for (const cell of match.cells) removeCells.add(`${cell.row},${cell.col}`);\n183\t        continue;\n184\t      }\n185\t\n186\t      for (const cell of match.cells) {\n187\t        removeCells.add(`${cell.row},${cell.col}`);\n188\t      }\n189\t\n190\t      if (match.length >= 5) {\n191\t        const center = match.cells[Math.floor(match.cells.length / 2)];\n192\t        specials.push({ row: center.row, col: center.col, type: SPECIAL_RAINBOW, color: match.color });\n193\t      } else if (match.length === 4) {\n194\t        const center = match.cells[1];\n195\t        const type = match.direction === 'horizontal' ? SPECIAL_STRIPED_V : SPECIAL_STRIPED_H;\n196\t        specials.push({ row: center.row, col: center.col, type, color: match.color });\n197\t      }\n198\t    }\n199\t\n200\t    return { removeCells, specials };\n201\t  }\n202\t\n203\t  // Trigger a special tile's effect, return list of cells to remove\n204\t  triggerSpecial(row, col) {\n205\t    const tile = this.board.getTile(row, col);\n206\t    if (!tile || tile.special === SPECIAL_NONE) return [];\n207\t\n208\t    const toRemove = [];\n209\t\n210\t    switch (tile.special) {\n211\t      case SPECIAL_STRIPED_H:\n212\t        for (let c = 0; c < this.board.size; c++) {\n213\t          if (this.board.getTile(row, c)) toRemove.push({ row, col: c });\n214\t        }\n215\t        break;\n216\t\n217\t      case SPECIAL_STRIPED_V:\n218\t        for (let r = 0; r < this.board.size; r++) {\n219\t          if (this.board.getTile(r, col)) toRemove.push({ row: r, col });\n220\t        }\n221\t        break;\n222\t\n223\t      case SPECIAL_BOMB:\n224\t        for (let dr = -1; dr <= 1; dr++) {\n225\t          for (let dc = -1; dc <= 1; dc++) {\n226\t            const nr = row + dr, nc = col + dc;\n227\t            if (this.board.isValid(nr, nc) && this.board.getTile(nr, nc)) {\n228\t              toRemove.push({ row: nr, col: nc });\n229\t            }\n230\t          }\n231\t        }\n232\t        break;\n233\t\n234\t      case SPECIAL_RAINBOW:\n235\t        // Rainbow removes all tiles of a target color — we need the swap target's color\n236\t        // This is handled externally via triggerRainbow()\n237\t        break;\n238\t    }\n239\t\n240\t    tile.special = SPECIAL_NONE;\n241\t    return toRemove;\n242\t  }\n243\t\n244\t  triggerRainbow(rainbowRow, rainbowCol, targetColor) {\n245\t    const toRemove = [];\n246\t    for (let r = 0; r < this.board.size; r++) {\n247\t      for (let c = 0; c < this.board.size; c++) {\n248\t        const tile = this.board.getTile(r, c);\n249\t        if (tile && tile.color === targetColor) {\n250\t          toRemove.push({ row: r, col: c });\n251\t        }\n252\t      }\n253\t    }\n254\t    return toRemove;\n255\t  }\n256\t\n257\t  // Check if swapping two tiles results in a valid match\n258\t  isValidSwap(r1, c1, r2, c2) {\n259\t    if (!this.board.isAdjacent(r1, c1, r2, c2)) return false;\n260\t    this.board.swap(r1, c1, r2, c2);\n261\t    const has = this.board.findAllMatches().length > 0;\n262\t    this.board.swap(r1, c1, r2, c2);\n263\t    return has;\n264\t  }\n265\t}\n266\t\n267\tif (typeof module !== 'undefined') module.exports = { MatchEngine, MatchResult };\n268\t"}]},"parent_tool_use_id":null,"session_id":"4fc1920c-0b5c-4266-b43d-05c38f749fa3","uuid":"791937bc-c492-4f6c-974e-7aa20a4b9585","timestamp":"2026-05-22T21:24:49.942Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-match3/src/js/MatchEngine.js","content":"// MatchEngine.js — Match detection, special tile generation, cascade processing\n\nclass MatchResult {\n  constructor() {\n    this.toRemove = new Set();       // \"row,col\" strings\n    this.specials = [];              // { row, col, type, color }\n    this.chainCount = 0;\n    this.totalScore = 0;\n    this.removedByColor = {};        // color -> count for collection goals\n    this.comboText = '';\n  }\n}\n\nclass MatchEngine {\n  constructor(board) {\n    this.board = board;\n    this.onSpecialTrigger = null;    // callback(tile, type)\n  }\n\n  // Full cascade: find matches → remove → gravity → repeat\n  processCascade() {\n    const result = new MatchResult();\n    let chainCount = 0;\n\n    const process = () => {\n      const matches = this.board.findAllMatches();\n      if (matches.length === 0) return Promise.resolve();\n\n      chainCount++;\n      result.chainCount = chainCount;\n\n      // Detect L/T shapes\n      const lShapes = this.board.findLShapeMatches(matches);\n\n      // Determine which cells to remove and what specials to create\n      const { removeCells, specials } = this._classifyMatches(matches, lShapes);\n\n      // Track removed tiles by color\n      for (const key of removeCells) {\n        const [r, c] = key.split(',').map(Number);\n        const tile = this.board.getTile(r, c);\n        if (tile && tile.color >= 0) {\n          result.removedByColor[tile.color] = (result.removedByColor[tile.color] || 0) + 1;\n        }\n        result.toRemove.add(key);\n      }\n\n      // Calculate score\n      const multiplier = chainCount <= 1 ? 1 : chainCount === 2 ? 1.5 : chainCount === 3 ? 2.0 : 2.5;\n      const baseScore = removeCells.size * 10;\n      result.totalScore += Math.floor(baseScore * multiplier);\n\n      // Set combo text\n      if (chainCount >= 4) result.comboText = '超赞！！';\n      else if (chainCount === 3) result.comboText = '太棒了！';\n      else if (chainCount === 2) result.comboText = '不错！';\n\n      // Mark specials to create (don't remove these cells yet)\n      for (const sp of specials) {\n        result.specials.push(sp);\n      }\n\n      // Remove matched tiles (except those becoming specials)\n      const specialPositions = new Set(specials.map(s => `${s.row},${s.col}`));\n      for (const key of removeCells) {\n        if (!specialPositions.has(key)) {\n          const [r, c] = key.split(',').map(Number);\n          this.board.removeTile(r, c);\n        }\n      }\n\n      // Create special tiles in place\n      for (const sp of specials) {\n        const tile = this.board.getTile(sp.row, sp.col);\n        if (tile) {\n          tile.special = sp.type;\n          tile.removing = false;\n        }\n      }\n\n      return new Promise(resolve => {\n        // Gravity + fill\n        setTimeout(() => {\n          const drops = this.board.applyGravity();\n          // Clear nulls\n          for (let r = 0; r < this.board.size; r++) {\n            for (let c = 0; c < this.board.size; c++) {\n              if (this.board.grid[r][c] && this.board.grid[r][c].removing) {\n                this.board.clearCell(r, c);\n              }\n            }\n          }\n\n          // Animate drops then check for more matches\n          setTimeout(() => process().then(resolve), 250);\n        }, 300);\n      });\n    };\n\n    return new Promise(resolve => {\n      process().then(() => {\n        result.chainCount = chainCount;\n        resolve(result);\n      });\n    });\n  }\n\n  // Synchronous version for cascade without animations\n  processCascadeSync() {\n    const result = new MatchResult();\n    let chainCount = 0;\n\n    while (true) {\n      const matches = this.board.findAllMatches();\n      if (matches.length === 0) break;\n\n      chainCount++;\n      const lShapes = this.board.findLShapeMatches(matches);\n      const { removeCells, specials } = this._classifyMatches(matches, lShapes);\n\n      for (const key of removeCells) {\n        const [r, c] = key.split(',').map(Number);\n        const tile = this.board.getTile(r, c);\n        if (tile && tile.color >= 0) {\n          result.removedByColor[tile.color] = (result.removedByColor[tile.color] || 0) + 1;\n        }\n        result.toRemove.add(key);\n      }\n\n      const multiplier = chainCount <= 1 ? 1 : chainCount === 2 ? 1.5 : chainCount === 3 ? 2.0 : 2.5;\n      result.totalScore += Math.floor(removeCells.size * 10 * multiplier);\n\n      if (chainCount >= 4) result.comboText = '超赞！！';\n      else if (chainCount === 3) result.comboText = '太棒了！';\n      else if (chainCount === 2) result.comboText = '不错！';\n\n      result.specials.push(...specials);\n\n      const specialPositions = new Set(specials.map(s => `${s.row},${s.col}`));\n      for (const key of removeCells) {\n        if (!specialPositions.has(key)) {\n          const [r, c] = key.split(',').map(Number);\n          this.board.clearCell(r, c);\n        }\n      }\n\n      for (const sp of specials) {\n        const tile = this.board.getTile(sp.row, sp.col);\n        if (tile) {\n          tile.special = sp.type;\n          tile.removing = false;\n        }\n      }\n\n      this.board.applyGravity();\n    }\n\n    result.chainCount = chainCount;\n    return result;\n  }\n\n  _classifyMatches(matches, lShapes) {\n    const removeCells = new Set();\n    const specials = [];\n    const lShapeCells = new Set();\n\n    // L/T shapes first (highest priority)\n    for (const l of lShapes) {\n      const center = l.cells[Math.floor(l.cells.length / 2)];\n      specials.push({ row: center.row, col: center.col, type: SPECIAL_BOMB, color: l.color });\n      for (const cell of l.cells) {\n        removeCells.add(`${cell.row},${cell.col}`);\n        lShapeCells.add(`${cell.row},${cell.col}`);\n      }\n    }\n\n    // Process remaining matches — skip any that overlap with L-shapes\n    for (const match of matches) {\n      const overlapCount = match.cells.filter(c => lShapeCells.has(`${c.row},${c.col}`)).length;\n      if (overlapCount > 0) {\n        // Already handled by L-shape, just add cells to remove set\n        for (const cell of match.cells) removeCells.add(`${cell.row},${cell.col}`);\n        continue;\n      }\n\n      for (const cell of match.cells) {\n        removeCells.add(`${cell.row},${cell.col}`);\n      }\n\n      if (match.length >= 5) {\n        const center = match.cells[Math.floor(match.cells.length / 2)];\n        specials.push({ row: center.row, col: center.col, type: SPECIAL_RAINBOW, color: match.color });\n      } else if (match.length === 4) {\n        const center = match.cells[1];\n        const type = match.direction === 'horizontal' ? SPECIAL_STRIPED_V : SPECIAL_STRIPED_H;\n        specials.push({ row: center.row, col: center.col, type, color: match.color });\n      }\n    }\n\n    return { removeCells, specials };\n  }\n\n  // Trigger a special tile's effect, return list of cells to remove\n  triggerSpecial(row, col) {\n    const tile = this.board.getTile(row, col);\n    if (!tile || tile.special === SPECIAL_NONE) return [];\n\n    const toRemove = [];\n\n    switch (tile.special) {\n      case SPECIAL_STRIPED_H:\n        for (let c = 0; c < this.board.size; c++) {\n          if (this.board.getTile(row, c)) toRemove.push({ row, col: c });\n        }\n        break;\n\n      case SPECIAL_STRIPED_V:\n        for (let r = 0; r < this.board.size; r++) {\n          if (this.board.getTile(r, col)) toRemove.push({ row: r, col });\n        }\n        break;\n\n      case SPECIAL_BOMB:\n        for (let dr = -1; dr <= 1; dr++) {\n          for (let dc = -1; dc <= 1; dc++) {\n            const nr = row + dr, nc = col + dc;\n            if (this.board.isValid(nr, nc) && this.board.getTile(nr, nc)) {\n              toRemove.push({ row: nr, col: nc });\n            }\n          }\n        }\n        break;\n\n      case SPECIAL_RAINBOW:\n        // Rainbow removes all tiles of a target color — we need the swap target's color\n        // This is handled externally via triggerRainbow()\n        break;\n    }\n\n    tile.special = SPECIAL_NONE;\n    return toRemove;\n  }\n\n  triggerRainbow(rainbowRow, rainbowCol, targetColor) {\n    const toRemove = [];\n    for (let r = 0; r < this.board.size; r++) {\n      for (let c = 0; c < this.board.size; c++) {\n        const tile = this.board.getTile(r, c);\n        if (tile && tile.color === targetColor) {\n          toRemove.push({ row: r, col: c });\n        }\n      }\n    }\n    return toRemove;\n  }\n\n  // Check if swapping two tiles results in a valid match\n  isValidSwap(r1, c1, r2, c2) {\n    if (!this.board.isAdjacent(r1, c1, r2, c2)) return false;\n    this.board.swap(r1, c1, r2, c2);\n    const has = this.board.findAllMatches().length > 0;\n    this.board.swap(r1, c1, r2, c2);\n    return has;\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { MatchEngine, MatchResult };\n","numLines":268,"startLine":1,"totalLines":268}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_55f6fbb8ea764cd8adb624cd","type":"tool_result","content":"1\t// Board.js — 8x8 grid state management\n2\tconst TILE_COLORS = 6;\n3\tconst BOARD_SIZE = 8;\n4\tconst EMPTY = -1;\n5\t\n6\tconst COLOR_MAP = {\n7\t  0: { name: 'apple',   hex: '#FF4D4D', label: '红' },\n8\t  1: { name: 'banana',  hex: '#FFD93D', label: '黄' },\n9\t  2: { name: 'blueberry', hex: '#4DA6FF', label: '蓝' },\n10\t  3: { name: 'lime',    hex: '#6BCB77', label: '绿' },\n11\t  4: { name: 'grape',   hex: '#B47AEA', label: '紫' },\n12\t  5: { name: 'orange',  hex: '#FF9A3C', label: '橙' },\n13\t};\n14\t\n15\t// Special tile types\n16\tconst SPECIAL_NONE = 0;\n17\tconst SPECIAL_STRIPED_H = 1;  // horizontal stripe bomb\n18\tconst SPECIAL_STRIPED_V = 2;  // vertical stripe bomb\n19\tconst SPECIAL_BOMB = 3;       // 3x3 area bomb\n20\tconst SPECIAL_RAINBOW = 4;    // clears all of one color\n21\t\n22\tclass Tile {\n23\t  constructor(color, row, col) {\n24\t    this.color = color;\n25\t    this.row = row;\n26\t    this.col = col;\n27\t    this.special = SPECIAL_NONE;\n28\t    this.removing = false;\n29\t    this.offsetY = 0;\n30\t    this.offsetX = 0;\n31\t    this.scale = 1;\n32\t    this.alpha = 1;\n33\t    this.selected = false;\n34\t    this.id = Tile._nextId++;\n35\t  }\n36\t  get type() { return this.color; }\n37\t}\n38\t\n39\tTile._nextId = 0;\n40\t\n41\tclass Board {\n42\t  constructor(size = BOARD_SIZE, numColors = TILE_COLORS) {\n43\t    this.size = size;\n44\t    this.numColors = numColors;\n45\t    this.grid = [];\n46\t    this.listeners = [];\n47\t  }\n48\t\n49\t  init() {\n50\t    this.grid = [];\n51\t    for (let r = 0; r < this.size; r++) {\n52\t      this.grid[r] = [];\n53\t      for (let c = 0; c < this.size; c++) {\n54\t        this.grid[r][c] = this._createTile(r, c);\n55\t      }\n56\t    }\n57\t    // Ensure no initial matches\n58\t    this._removeInitialMatches();\n59\t  }\n60\t\n61\t  _createTile(row, col) {\n62\t    return new Tile(this._randomColor(), row, col);\n63\t  }\n64\t\n65\t  _randomColor() {\n66\t    return Math.floor(Math.random() * this.numColors);\n67\t  }\n68\t\n69\t  _removeInitialMatches() {\n70\t    let maxIter = 1000;\n71\t    while (this._hasMatch() && maxIter-- > 0) {\n72\t      const matches = this.findAllMatches();\n73\t      for (const group of matches) {\n74\t        for (const { row, col } of group.cells) {\n75\t          this.grid[row][col] = this._createTile(row, col);\n76\t        }\n77\t      }\n78\t    }\n79\t  }\n80\t\n81\t  _hasMatch() {\n82\t    return this.findAllMatches().length > 0;\n83\t  }\n84\t\n85\t  getTile(r, c) {\n86\t    if (r < 0 || r >= this.size || c < 0 || c >= this.size) return null;\n87\t    return this.grid[r][c];\n88\t  }\n89\t\n90\t  setTile(r, c, tile) {\n91\t    if (r >= 0 && r < this.size && c >= 0 && c < this.size) {\n92\t      tile.row = r;\n93\t      tile.col = c;\n94\t      this.grid[r][c] = tile;\n95\t    }\n96\t  }\n97\t\n98\t  swap(r1, c1, r2, c2) {\n99\t    const a = this.grid[r1][c1];\n100\t    const b = this.grid[r2][c2];\n101\t    this.grid[r1][c1] = b;\n102\t    this.grid[r2][c2] = a;\n103\t    if (a) { a.row = r2; a.col = c2; }\n104\t    if (b) { b.row = r1; b.col = c1; }\n105\t  }\n106\t\n107\t  removeTile(r, c) {\n108\t    const tile = this.grid[r][c];\n109\t    if (tile) tile.removing = true;\n110\t    return tile;\n111\t  }\n112\t\n113\t  clearCell(r, c) {\n114\t    this.grid[r][c] = null;\n115\t  }\n116\t\n117\t  isValid(r, c) {\n118\t    return r >= 0 && r < this.size && c >= 0 && c < this.size;\n119\t  }\n120\t\n121\t  isAdjacent(r1, c1, r2, c2) {\n122\t    const dr = Math.abs(r1 - r2);\n123\t    const dc = Math.abs(c1 - c2);\n124\t    return (dr + dc) === 1;\n125\t  }\n126\t\n127\t  // Find all horizontal and vertical matches of length >= 3\n128\t  findAllMatches() {\n129\t    const matches = [];\n130\t\n131\t    // Horizontal scan\n132\t    for (let r = 0; r < this.size; r++) {\n133\t      let start = 0;\n134\t      for (let c = 1; c <= this.size; c++) {\n135\t        const cur = c < this.size ? this.grid[r][c] : null;\n136\t        const prev = this.grid[r][start];\n137\t        if (c < this.size && cur && prev && cur.color === prev.color && cur.color !== EMPTY) {\n138\t          continue;\n139\t        }\n140\t        const len = c - start;\n141\t        if (len >= 3 && prev && prev.color !== EMPTY) {\n142\t          const cells = [];\n143\t          for (let k = start; k < c; k++) cells.push({ row: r, col: k });\n144\t          matches.push({ cells, length: len, direction: 'horizontal', color: prev.color });\n145\t        }\n146\t        start = c;\n147\t      }\n148\t    }\n149\t\n150\t    // Vertical scan\n151\t    for (let c = 0; c < this.size; c++) {\n152\t      let start = 0;\n153\t      for (let r = 1; r <= this.size; r++) {\n154\t        const cur = r < this.size ? this.grid[r][c] : null;\n155\t        const prev = this.grid[start][c];\n156\t        if (r < this.size && cur && prev && cur.color === prev.color && cur.color !== EMPTY) {\n157\t          continue;\n158\t        }\n159\t        const len = r - start;\n160\t        if (len >= 3 && prev && prev.color !== EMPTY) {\n161\t          const cells = [];\n162\t          for (let k = start; k < r; k++) cells.push({ row: k, col: c });\n163\t          matches.push({ cells, length: len, direction: 'vertical', color: prev.color });\n164\t        }\n165\t        start = r;\n166\t      }\n167\t    }\n168\t\n169\t    return matches;\n170\t  }\n171\t\n172\t  // Detect L/T shape matches by finding intersections of horizontal and vertical matches\n173\t  findLShapeMatches(matches) {\n174\t    const lShapes = [];\n175\t    for (let i = 0; i < matches.length; i++) {\n176\t      for (let j = i + 1; j < matches.length; j++) {\n177\t        const a = matches[i], b = matches[j];\n178\t        if (a.direction === b.direction) continue;\n179\t        if (a.color !== b.color) continue;\n180\t        // Find intersection\n181\t        const setA = new Set(a.cells.map(c => `${c.row},${c.col}`));\n182\t        for (const cell of b.cells) {\n183\t          if (setA.has(`${cell.row},${cell.col}`)) {\n184\t            // L/T shape found — merge all cells\n185\t            const allCellsMap = {};\n186\t            for (const c of a.cells) allCellsMap[`${c.row},${c.col}`] = c;\n187\t            for (const c of b.cells) allCellsMap[`${c.row},${c.col}`] = c;\n188\t            const allCells = Object.values(allCellsMap);\n189\t            lShapes.push({ cells: allCells, color: a.color });\n190\t          }\n191\t        }\n192\t      }\n193\t    }\n194\t    return lShapes;\n195\t  }\n196\t\n197\t  // Apply gravity: move tiles down to fill empty cells\n198\t  applyGravity() {\n199\t    const drops = [];\n200\t    for (let c = 0; c < this.size; c++) {\n201\t      let writeRow = this.size - 1;\n202\t      for (let r = this.size - 1; r >= 0; r--) {\n203\t        if (this.grid[r][c] !== null) {\n204\t          if (r !== writeRow) {\n205\t            const tile = this.grid[r][c];\n206\t            const fromRow = r;\n207\t            this.grid[r][c] = null;\n208\t            this.grid[writeRow][c] = tile;\n209\t            const distance = writeRow - fromRow;\n210\t            tile.row = writeRow;\n211\t            drops.push({ tile, fromRow, toRow: writeRow, col: c, distance });\n212\t          }\n213\t          writeRow--;\n214\t        }\n215\t      }\n216\t      // Fill empty top cells\n217\t      for (let r = writeRow; r >= 0; r--) {\n218\t        const tile = this._createTile(r, c);\n219\t        tile.offsetY = -(writeRow - r + 1); // start above board\n220\t        this.grid[r][c] = tile;\n221\t        drops.push({ tile, fromRow: -(writeRow - r + 1), toRow: r, col: c, distance: r + (writeRow - r + 1) });\n222\t      }\n223\t    }\n224\t    return drops;\n225\t  }\n226\t\n227\t  // Check if any valid move exists (for deadlock detection)\n228\t  hasValidMoves() {\n229\t    for (let r = 0;