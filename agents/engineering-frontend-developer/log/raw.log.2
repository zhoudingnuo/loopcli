{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_25610328528941b69679e91a","type":"tool_result","content":"1\t// Resources.ts — Resource management with manual collection and display\n2\t\n3\timport type { GameState, Resources, BuildingInstance } from './GameState';\n4\timport { addResources, addCultivation, updateBuilding } from './GameState';\n5\timport type { BuildingDef } from './Building';\n6\t\n7\texport interface ResourceDisplay {\n8\t  id: string;\n9\t  name: string;\n10\t  amount: number;\n11\t  icon: string;\n12\t  color: string;\n13\t}\n14\t\n15\tconst RESOURCE_META: Record<string, { name: string; icon: string; color: string }> = {\n16\t  spirit_stone: { name: '灵石', icon: '💎', color: '#7cc8ff' },\n17\t  spirit_grass: { name: '灵草', icon: '🌿', color: '#6adf6a' },\n18\t  spirit_energy: { name: '灵气', icon: '✨', color: '#b480ff' },\n19\t  cultivation: { name: '修为', icon: '⚡', color: '#ffd700' },\n20\t  pill_juling: { name: '聚灵丹', icon: '💊', color: '#ff8c32' },\n21\t  pill_peiyuan: { name: '培元丹', icon: '💊', color: '#ff6699' },\n22\t  pill_ningqi: { name: '凝气丹', icon: '💊', color: '#cc66ff' },\n23\t  pill_zhuji: { name: '筑基丹', icon: '💊', color: '#ffcc00' },\n24\t  pill_jindanyin: { name: '金丹引', icon: '💊', color: '#ff4444' },\n25\t  spirit_iron: { name: '灵铁', icon: '🔩', color: '#8a8aaa' },\n26\t  spirit_wood: { name: '灵木', icon: '🪵', color: '#aa8844' },\n27\t  talisman_paper: { name: '符纸', icon: '📜', color: '#ddcc88' },\n28\t};\n29\t\n30\texport function getResourceDisplays(resources: Resources): ResourceDisplay[] {\n31\t  const displays: ResourceDisplay[] = [];\n32\t  for (const [id, meta] of Object.entries(RESOURCE_META)) {\n33\t    displays.push({\n34\t      id,\n35\t      name: meta.name,\n36\t      amount: resources[id as keyof Resources] ?? 0,\n37\t      icon: meta.icon,\n38\t      color: meta.color,\n39\t    });\n40\t  }\n41\t  return displays;\n42\t}\n43\t\n44\t// Manual collection: player clicks a building to collect\n45\texport function collectFromBuilding(\n46\t  state: GameState,\n47\t  building: BuildingInstance,\n48\t  def: BuildingDef,\n49\t  mapIndex: number,\n50\t): GameState {\n51\t  if (def.production.mode !== 'manual') return state;\n52\t\n53\t  const prod = def.production;\n54\t\n55\t  // Check if we need input resources\n56\t  if (prod.input) {\n57\t    const canAfford = Object.entries(prod.input).every(\n58\t      ([res, cost]) => (state.resources[res as keyof Resources] ?? 0) >= cost,\n59\t    );\n60\t    if (!canAfford) return state;\n61\t\n62\t    // Consume input resources\n63\t    const inputDelta: Partial<Resources> = {};\n64\t    for (const [res, cost] of Object.entries(prod.input)) {\n65\t      (inputDelta as Record<string, number>)[res] = -cost;\n66\t    }\n67\t    state = addResources(state, inputDelta);\n68\t  }\n69\t\n70\t  // For fields, check if ready for harvest\n71\t  if (def.category === 'farming') {\n72\t    if (building.progress < 1) return state;\n73\t    // Reset progress after harvest\n74\t    state = updateBuilding(state, mapIndex, building.uid, {\n75\t      progress: 0,\n76\t      isProducing: false,\n77\t    });\n78\t  }\n79\t\n80\t  // Add produced resource\n81\t  const delta: Partial<Resources> = {};\n82\t  (delta as Record<string, number>)[prod.resource] = prod.amount;\n83\t  state = addResources(state, delta);\n84\t\n85\t  // Cultivation gives exp\n86\t  if (prod.resource === 'cultivation') {\n87\t    state = addCultivation(state, prod.amount);\n88\t  }\n89\t\n90\t  return state;\n91\t}\n92\t\n93\t// Plant a field (starts growth timer)\n94\texport function plantField(\n95\t  state: GameState,\n96\t  building: BuildingInstance,\n97\t  mapIndex: number,\n98\t): GameState {\n99\t  return updateBuilding(state, mapIndex, building.uid, {\n100\t    isProducing: true,\n101\t    progress: 0,\n102\t    lastCollectTime: Date.now(),\n103\t  });\n104\t}\n105\t\n106\t// Update auto-production buildings (called every tick)\n107\texport function tickAutoProduction(\n108\t  state: GameState,\n109\t  mapIndex: number,\n110\t  now: number,\n111\t  buildingDefs: Map<string, BuildingDef>,\n112\t): GameState {\n113\t  const map = state.maps[mapIndex];\n114\t  if (!map) return state;\n115\t\n116\t  for (const building of map.buildings) {\n117\t    const def = buildingDefs.get(building.buildingId);\n118\t    if (!def || def.production.mode !== 'auto') continue;\n119\t\n120\t    if (!building.isProducing) {\n121\t      // Start production\n122\t      state = updateBuilding(state, mapIndex, building.uid, {\n123\t        isProducing: true,\n124\t        lastCollectTime: now,\n125\t        progress: 0,\n126\t      });\n127\t      continue;\n128\t    }\n129\t\n130\t    const elapsed = now - building.lastCollectTime;\n131\t    const interval = def.production.interval;\n132\t    const progress = Math.min(1, elapsed / interval);\n133\t\n134\t    if (progress >= 1) {\n135\t      // Production complete — collect and restart\n136\t      const delta: Partial<Resources> = {};\n137\t      (delta as Record<string, number>)[def.production.resource] = def.production.amount;\n138\t      state = addResources(state, delta);\n139\t\n140\t      state = updateBuilding(state, mapIndex, building.uid, {\n141\t        lastCollectTime: now,\n142\t        progress: 0,\n143\t      });\n144\t    } else {\n145\t      state = updateBuilding(state, mapIndex, building.uid, { progress });\n146\t    }\n147\t  }\n148\t\n149\t  return state;\n150\t}\n151\t\n152\t// Tick manual buildings (e.g. field growth)\n153\texport function tickManualProduction(\n154\t  state: GameState,\n155\t  mapIndex: number,\n156\t  now: number,\n157\t  buildingDefs: Map<string, BuildingDef>,\n158\t): GameState {\n159\t  const map = state.maps[mapIndex];\n160\t  if (!map) return state;\n161\t\n162\t  for (const building of map.buildings) {\n163\t    const def = buildingDefs.get(building.buildingId);\n164\t    if (!def || def.production.mode !== 'manual') continue;\n165\t    if (!building.isProducing) continue;\n166\t\n167\t    const elapsed = now - building.lastCollectTime;\n168\t    const interval = def.production.interval;\n169\t    const progress = Math.min(1, elapsed / interval);\n170\t\n171\t    state = updateBuilding(state, mapIndex, building.uid, { progress });\n172\t  }\n173\t\n174\t  return state;\n175\t}\n176\t\n177\t// Format resource amounts for display (e.g. 1200 → \"1.2K\")\n178\texport function formatAmount(amount: number): string {\n179\t  if (amount >= 1_000_000) return (amount / 1_000_000).toFixed(1) + 'M';\n180\t  if (amount >= 10_000) return (amount / 1_000).toFixed(1) + 'K';\n181\t  if (amount >= 1_000) return (amount / 1_000).toFixed(1) + 'K';\n182\t  return Math.floor(amount).toString();\n183\t}\n184\t\n185\t// Check if player can afford a cost\n186\texport function canAfford(resources: Resources, cost: Record<string, number>): boolean {\n187\t  return Object.entries(cost).every(\n188\t    ([res, amount]) => (resources[res as keyof Resources] ?? 0) >= amount,\n189\t  );\n190\t}\n191\t\n192\t// Deduct cost from resources\n193\texport function deductCost(state: GameState, cost: Record<string, number>): GameState {\n194\t  const delta: Partial<Resources> = {};\n195\t  for (const [res, amount] of Object.entries(cost)) {\n196\t    (delta as Record<string, number>)[res] = -amount;\n197\t  }\n198\t  return addResources(state, delta);\n199\t}\n200\t"}]},"parent_tool_use_id":"call_a5a9e75d09cd453897e0e9b2","session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"5c316078-139b-4195-b348-70559bcb2b58","timestamp":"2026-05-23T01:53:34.103Z","subagent_type":"Explore","task_description":"Read M3 core game files"}
