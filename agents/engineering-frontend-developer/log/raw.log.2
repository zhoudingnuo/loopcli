{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6b21be1420664aed803e45ee","type":"tool_result","content":"1\t// ConveyorBelt.ts — 灵脉通道（传送带）系统，支持 Lv1 直线 / Lv2 转弯分叉\n2\t\n3\texport interface ConveyorSegment {\n4\t  uid: string;\n5\t  gridX: number;\n6\t  gridY: number;\n7\t  level: 1 | 2; // Lv1 直线, Lv2 转弯分叉\n8\t  direction: Direction;\n9\t  /** 连接到的下一格坐标（null = 未连接） */\n10\t  nextX: number | null;\n11\t  nextY: number | null;\n12\t  /** 分叉出口（仅 Lv2） */\n13\t  branchX: number | null;\n14\t  branchY: number | null;\n15\t}\n16\t\n17\texport type Direction = 'up' | 'down' | 'left' | 'right';\n18\t\n19\texport interface ConveyorItem {\n20\t  id: string;\n21\t  resource: string;\n22\t  amount: number;\n23\t  /** 当前所在格 x */\n24\t  x: number;\n25\t  /** 当前所在格 y */\n26\t  y: number;\n27\t  /** 移动进度 0-1 */\n28\t  progress: number;\n29\t  /** 每格移动时间 ms */\n30\t  speed: number;\n31\t  /** 目标建筑 uid（终点） */\n32\t  targetBuildingUid: string | null;\n33\t}\n34\t\n35\tlet itemCounter = 0;\n36\t\n37\tconst DIR_DELTA: Record<Direction, { dx: number; dy: number }> = {\n38\t  up: { dx: 0, dy: -1 },\n39\t  down: { dx: 0, dy: 1 },\n40\t  left: { dx: -1, dy: 0 },\n41\t  right: { dx: 1, dy: 0 },\n42\t};\n43\t\n44\tconst OPPOSITE: Record<Direction, Direction> = {\n45\t  up: 'down',\n46\t  down: 'up',\n47\t  left: 'right',\n48\t  right: 'left',\n49\t};\n50\t\n51\texport function getDirDelta(dir: Direction): { dx: number; dy: number } {\n52\t  return DIR_DELTA[dir];\n53\t}\n54\t\n55\texport function oppositeDir(dir: Direction): Direction {\n56\t  return OPPOSITE[dir];\n57\t}\n58\t\n59\texport function directionFromDelta(dx: number, dy: number): Direction {\n60\t  if (Math.abs(dx) > Math.abs(dy)) return dx > 0 ? 'right' : 'left';\n61\t  return dy > 0 ? 'down' : 'up';\n62\t}\n63\t\n64\t// Create a conveyor segment\n65\texport function createSegment(\n66\t  uid: string,\n67\t  gridX: number,\n68\t  gridY: number,\n69\t  level: 1 | 2,\n70\t  direction: Direction,\n71\t): ConveyorSegment {\n72\t  return {\n73\t    uid,\n74\t    gridX,\n75\t    gridY,\n76\t    level,\n77\t    direction,\n78\t    nextX: null,\n79\t    nextY: null,\n80\t    branchX: null,\n81\t    branchY: null,\n82\t  };\n83\t}\n84\t\n85\t// Build a lookup map from grid position to segment\n86\texport function buildSegmentMap(segments: ConveyorSegment[]): Map<string, ConveyorSegment> {\n87\t  const map = new Map<string, ConveyorSegment>();\n88\t  for (const seg of segments) {\n89\t    map.set(`${seg.gridX},${seg.gridY}`, seg);\n90\t  }\n91\t  return map;\n92\t}\n93\t\n94\t// Auto-connect a segment to its neighbors\n95\texport function autoConnect(\n96\t  segment: ConveyorSegment,\n97\t  segmentMap: Map<string, ConveyorSegment>,\n98\t): ConveyorSegment {\n99\t  const updated = { ...segment };\n100\t\n101\t  // Look ahead in current direction\n102\t  const { dx, dy } = getDirDelta(segment.direction);\n103\t  const aheadKey = `${segment.gridX + dx},${segment.gridY + dy}`;\n104\t  const ahead = segmentMap.get(aheadKey);\n105\t  if (ahead && ahead.direction !== oppositeDir(segment.direction)) {\n106\t    updated.nextX = segment.gridX + dx;\n107\t    updated.nextY = segment.gridY + dy;\n108\t  } else {\n109\t    updated.nextX = null;\n110\t    updated.nextY = null;\n111\t  }\n112\t\n113\t  // Lv2: branch detection — check perpendicular directions\n114\t  if (segment.level >= 2) {\n115\t    const perpDirs: Direction[] =\n116\t      segment.direction === 'up' || segment.direction === 'down'\n117\t        ? ['left', 'right']\n118\t        : ['up', 'down'];\n119\t\n120\t    for (const pd of perpDirs) {\n121\t      const pdx = getDirDelta(pd).dx;\n122\t      const pdy = getDirDelta(pd).dy;\n123\t      const branchKey = `${segment.gridX + pdx},${segment.gridY + pdy}`;\n124\t      const branch = segmentMap.get(branchKey);\n125\t      if (branch && branch.direction !== oppositeDir(pd)) {\n126\t        updated.branchX = segment.gridX + pdx;\n127\t        updated.branchY = segment.gridY + pdy;\n128\t        break; // Only one branch\n129\t      }\n130\t    }\n131\t  }\n132\t\n133\t  return updated;\n134\t}\n135\t\n136\t// Spawn a new item on the conveyor\n137\texport function spawnItem(\n138\t  resource: string,\n139\t  amount: number,\n140\t  startX: number,\n141\t  startY: number,\n142\t  speed: number = 2000,\n143\t): ConveyorItem {\n144\t  return {\n145\t    id: `item_${Date.now()}_${++itemCounter}`,\n146\t    resource,\n147\t    amount,\n148\t    x: startX,\n149\t    y: startY,\n150\t    progress: 0,\n151\t    speed,\n152\t    targetBuildingUid: null,\n153\t  };\n154\t}\n155\t\n156\t// Tick all conveyor items — move them along segments\n157\texport function tickConveyorItems(\n158\t  items: ConveyorItem[],\n159\t  segmentMap: Map<string, ConveyorSegment>,\n160\t  dtMs: number,\n161\t): { items: ConveyorItem[]; delivered: Array<{ resource: string; amount: number; x: number; y: number }> } {\n162\t  const delivered: Array<{ resource: string; amount: number; x: number; y: number }> = [];\n163\t  const remaining: ConveyorItem[] = [];\n164\t\n165\t  for (const item of items) {\n166\t    const seg = segmentMap.get(`${item.x},${item.y}`);\n167\t    if (!seg) {\n168\t      remaining.push(item);\n169\t      continue;\n170\t    }\n171\t\n172\t    const progress = item.progress + dtMs / item.speed;\n173\t\n174\t    if (progress >= 1) {\n175\t      // Item arrived at next cell\n176\t      if (seg.nextX !== null && seg.nextY !== null) {\n177\t        remaining.push({\n178\t          ...item,\n179\t          x: seg.nextX,\n180\t          y: seg.nextY,\n181\t          progress: progress - 1,\n182\t        });\n183\t      } else {\n184\t        // End of line — deliver\n185\t        delivered.push({\n186\t          resource: item.resource,\n187\t          amount: item.amount,\n188\t          x: item.x,\n189\t          y: item.y,\n190\t        });\n191\t      }\n192\t    } else {\n193\t      remaining.push({ ...item, progress });\n194\t    }\n195\t  }\n196\t\n197\t  return { items: remaining, delivered };\n198\t}\n199\t\n200\t// Render a conveyor segment on canvas\n201\texport function renderConveyorSegment(\n202\t  ctx: CanvasRenderingContext2D,\n203\t  seg: ConveyorSegment,\n204\t  offsetX: number,\n205\t  offsetY: number,\n206\t  scale: number,\n207\t  cellSize: number,\n208\t  now: number,\n209\t): void {\n210\t  const x = offsetX + seg.gridX * cellSize * scale;\n211\t  const y = offsetY + seg.gridY * cellSize * scale;\n212\t  const s = cellSize * scale;\n213\t\n214\t  // Belt background\n215\t  const baseColor = seg.level === 1 ? 'rgba(100,150,200,0.4)' : 'rgba(150,120,220,0.4)';\n216\t  ctx.fillStyle = baseColor;\n217\t  ctx.fillRect(x + 1, y + 1, s - 2, s - 2);\n218\t\n219\t  // Direction arrow with animation\n220\t  const arrowPhase = ((now / 500) % 1);\n221\t  const { dx, dy } = getDirDelta(seg.direction);\n222\t  const cx = x + s / 2 + dx * s * 0.15 * arrowPhase;\n223\t  const cy = y + s / 2 + dy * s * 0.15 * arrowPhase;\n224\t\n225\t  ctx.fillStyle = seg.level === 1 ? '#6496c8' : '#9678dc';\n226\t  ctx.font = `${Math.max(10, Math.floor(14 * scale))}px serif`;\n227\t  ctx.textAlign = 'center';\n228\t  ctx.textBaseline = 'middle';\n229\t\n230\t  const arrows: Record<Direction, string> = { up: '↑', down: '↓', left: '←', right: '→' };\n231\t  ctx.fillText(arrows[seg.direction], cx, cy);\n232\t\n233\t  // Branch indicator for Lv2\n234\t  if (seg.level >= 2 && seg.branchX !== null) {\n235\t    ctx.fillStyle = 'rgba(180,160,255,0.5)';\n236\t    ctx.beginPath();\n237\t    ctx.arc(x + s - 4 * scale, y + s - 4 * scale, 2 * scale, 0, Math.PI * 2);\n238\t    ctx.fill();\n239\t  }\n240\t\n241\t  // Connection indicators\n242\t  ctx.strokeStyle = 'rgba(150,200,255,0.3)';\n243\t  ctx.lineWidth = 1;\n244\t  if (seg.nextX !== null && seg.nextY !== null) {\n245\t    const nx = offsetX + seg.nextX * cellSize * scale;\n246\t    const ny = offsetY + seg.nextY * cellSize * scale;\n247\t    ctx.beginPath();\n248\t    ctx.moveTo(x + s / 2, y + s / 2);\n249\t    ctx.lineTo(nx + s / 2, ny + s / 2);\n250\t    ctx.stroke();\n251\t  }\n252\t}\n253\t\n254\t// Render items moving on conveyors\n255\texport function renderConveyorItems(\n256\t  ctx: CanvasRenderingContext2D,\n257\t  items: ConveyorItem[],\n258\t  segmentMap: Map<string, ConveyorSegment>,\n259\t  offsetX: number,\n260\t  offsetY: number,\n261\t  scale: number,\n262\t  cellSize: number,\n263\t): void {\n264\t  const RESOURCE_COLORS: Record<string, string> = {\n265\t    spirit_stone: '#7cc8ff',\n266\t    spirit_grass: '#6adf6a',\n267\t    spirit_iron: '#8a8aaa',\n268\t    pill_juling: '#ff8c32',\n269\t    pill_peiyuan: '#ff6699',\n270\t    pill_zhuji: '#ffcc00',\n271\t    pill_jindanyin: '#ff4444',\n272\t  };\n273\t\n274\t  for (const item of items) {\n275\t    const seg = segmentMap.get(`${item.x},${item.y}`);\n276\t    if (!seg) continue;\n277\t\n278\t    let tx = item.x;\n279\t    let ty = item.y;\n280\t\n281\t    if (seg.nextX !== null && seg.nextY !== null) {\n282\t      tx = item.x + (seg.nextX - item.x) * item.progress;\n283\t      ty = item.y + ((seg.nextY as number) - item.y) * item.progress;\n284\t    }\n285\t\n286\t    const sx = offsetX + (tx + 0.5) * cellSize * scale;\n287\t    const sy = offsetY + (ty + 0.5) * cellSize * scale;\n288\t    const r = 4 * scale;\n289\t\n290\t    ctx.fillStyle = RESOURCE_COLORS[item.resource] ?? '#fff';\n291\t    ctx.beginPath();\n292\t    ctx.arc(sx, sy, r, 0, Math.PI * 2);\n293\t    ctx.fill();\n294\t\n295\t    // Glow\n296\t    ctx.fillStyle = (RESOURCE_COLORS[item.resource] ?? '#fff').replace(')', ',0.3)').replace('rgb', 'rgba');\n297\t    ctx.beginPath();\n298\t    ctx.arc(sx, sy, r * 1.5, 0, Math.PI * 2);\n299\t    ctx.fill();\n300\t  }\n301\t}\n302\t"}]},"parent_tool_use_id":"call_a5a9e75d09cd453897e0e9b2","session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"fcf7c05e-e6ae-48c5-b67c-07b99fd2c335","timestamp":"2026-05-23T01:53:45.132Z","subagent_type":"Explore","task_description":"Read M3 core game files"}
