{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_78c9b9fcb68b4c48acfcb834","type":"tool_result","content":"730\t    function startGame(newGame) {\n731\t      mainMenu.classList.remove('active');\n732\t      gameUI.classList.add('active');\n733\t      isGameRunning = true;\n734\t\n735\t      if (!app) {\n736\t        const canvas = document.getElementById('gameCanvas') as HTMLCanvasElement;\n737\t        app = new App(canvas);\n738\t        setupGameUI();\n739\t      } else if (newGame) {\n740\t        import('./src/game/GameState.ts').then(({ clearSave }) => {\n741\t          clearSave();\n742\t          location.reload();\n743\t        });\n744\t        return;\n745\t      }\n746\t\n747\t      app.centerCamera();\n748\t      app.start();\n749\t    }\n750\t\n751\t    // Menu buttons\n752\t    document.getElementById('btn-continue').addEventListener('click', () => startGame(false));\n753\t    document.getElementById('btn-new-game').addEventListener('click', () => {\n754\t      if (isGameRunning) {\n755\t        if (confirm('开始新游戏将清除当前进度，确定吗？')) {\n756\t          startGame(true);\n757\t        }\n758\t      } else {\n759\t        startGame(true);\n760\t      }\n761\t    });\n762\t    document.getElementById('btn-settings').addEventListener('click', () => showSettings());\n763\t    document.getElementById('btn-quit').addEventListener('click', () => {\n764\t      if (electronAPI) {\n765\t        electronAPI.quit();\n766\t      } else {\n767\t        if (confirm('确定要退出游戏吗？')) {\n768\t          window.close();\n769\t        }\n770\t      }\n771\t    });\n772\t\n773\t    // ==================== SETTINGS PAGE ====================\n774\t    const settingsPage = document.getElementById('settings-page');\n775\t    let settings = loadSettings();\n776\t    let previousPage = 'menu'; // 'menu' or 'game'\n777\t\n778\t    function showSettings() {\n779\t      previousPage = mainMenu.classList.contains('active') ? 'menu' : 'game';\n780\t      settingsPage.classList.add('active');\n781\t      populateSettings();\n782\t    }\n783\t\n784\t    function hideSettings() {\n785\t      settingsPage.classList.remove('active');\n786\t    }\n787\t\n788\t    function populateSettings() {\n789\t      (document.getElementById('set-master-vol') as HTMLInputElement).value = String(settings.masterVolume);\n790\t      document.getElementById('val-master-vol').textContent = String(settings.masterVolume);\n791\t      (document.getElementById('set-sfx-vol') as HTMLInputElement).value = String(settings.sfxVolume);\n792\t      document.getElementById('val-sfx-vol').textContent = String(settings.sfxVolume);\n793\t      (document.getElementById('set-music-vol') as HTMLInputElement).value = String(settings.musicVolume);\n794\t      document.getElementById('val-music-vol').textContent = String(settings.musicVolume);\n795\t\n796\t      const resKey = `${settings.resolution.width}x${settings.resolution.height}`;\n797\t      (document.getElementById('set-resolution') as HTMLSelectElement).value = resKey;\n798\t\n799\t      const fsBtn = document.getElementById('set-fullscreen');\n800\t      fsBtn.classList.toggle('on', settings.fullscreen);\n801\t\n802\t      const fpsBtn = document.getElementById('set-showfps');\n803\t      fpsBtn.classList.toggle('on', settings.showFPS);\n804\t\n805\t      (document.getElementById('set-quality') as HTMLSelectElement).value = settings.particleQuality;\n806\t      (document.getElementById('set-autosave') as HTMLSelectElement).value = String(settings.autoSaveInterval);\n807\t    }\n808\t\n809\t    // Slider bindings\n810\t    ['master-vol', 'sfx-vol', 'music-vol'].forEach(key => {\n811\t      const slider = document.getElementById(`set-${key}`) as HTMLInputElement;\n812\t      const label = document.getElementById(`val-${key}`);\n813\t      slider.addEventListener('input', () => { label.textContent = slider.value; });\n814\t    });\n815\t\n816\t    // Toggle bindings\n817\t    ['set-fullscreen', 'set-showfps'].forEach(