s-ingame').addEventListener('click', showSettings);\n858\t\n859\t    // ==================== GAME UI SETUP ====================\n860\t    function setupGameUI() {\n861\t      if (!app) return;\n862\t\n863\t      const canvas = document.getElementById('gameCanvas') as HTMLCanvasElement;\n864\t\n865\t      // FPS counter\n866\t      let frameCount = 0;\n867\t      let fpsTime = performance.now();\n868\t      const fpsDisplay = document.getElementById('fps-display');\n869\t      const statusText = document.getElementById('status-text');\n870\t      const playtimeDisplay = document.getElementById('playtime');\n871\t\n872\t      setInterval(() => {\n873\t        const now = performance.now();\n874\t        const fps = Math.round(frameCount * 1000 / (now - fpsTime));\n875\t        fpsDisplay.textContent = `FPS: ${fps}`;\n876\t        fpsDisplay.style.display = settings.showFPS ? '' : 'none';\n877\t        frameCount = 0;\n878\t        fpsTime = now;\n879\t\n880\t        if (app) {\n881\t          const secs = Math.floor(app.state.totalPlaytime);\n882\t          const mins = Math.floor(secs / 60);\n883\t          const hrs = Math.floor(mins / 60);\n884\t          playtimeDisplay.textContent = `游玩时间: ${hrs}:${String(mins % 60).padStart(2, '0')}`;\n885\t        }\n886\t      }, 1000);\n887\t\n888\t      const origLoop = app.loop.bind(app);\n889\t      app.loop = (now) => { frameCount++; origLoop(now); };\n890\t\n891\t      // === Notifications ===\n892\t      const notifContainer = document.getElementById('notifications');\n893\t      app.onNotification = (notif) => {\n894\t        const el = document.createElement('div');\n895\t        el.className = `notif ${notif.type}`;\n896\t        el.textContent = notif.text;\n897\t        notifContainer.appendChild(el);\n898\t        requestAnimationFrame(() => el.classList.add('show'));\n899\t        setTimeout(() => {\n900\t          el.classList.remove('show');\n901\t          setTimeout(() => el.remove(), 300);\n902\t        }, 3