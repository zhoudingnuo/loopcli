void {\n181\t    this.init();\n182\t    this.playTone(1000, 0.05, 'sine', 0.1);\n183\t  }\n184\t\n185\t  playLevelUp(): void {\n186\t    this.init();\n187\t    this.playTone(523, 0.15, 'sine', 0.2);\n188\t    setTimeout(() => this.playTone(659, 0.15, 'sine', 0.2), 120);\n189\t    setTimeout(() => this.playTone(784, 0.2, 'sine', 0.25), 240);\n190\t  }\n191\t}\n192\t\n193\t// Singleton\n194\texport const audioManager = new AudioManager();\n195\t"}]},"parent_tool_use_id":null,"session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"9dde3b02-71bb-4756-bd16-02405852fa45","timestamp":"2026-05-23T02:11:53.262Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\AudioManager.ts","content":"// AudioManager.ts — Web Audio API sound framework with procedural generation\n\nexport class AudioManager {\n  private ctx: AudioContext | null = null;\n  private masterGain: GainNode | null = null;\n  private volume = 0.5;\n  private muted = false;\n\n  init(): void {\n    if (this.ctx) return;\n    try {\n      this.ctx = new AudioContext();\n      this.masterGain = this.ctx.createGain();\n      this.masterGain.gain.value = this.volume;\n      this.masterGain.connect(this.ctx.destination);\n    } catch {\n      console.warn('AudioManager: Web Audio API not available');\n    }\n  }\n\n  resume(): void {\n    if (this.ctx?.state === 'suspended') {\n      this.ctx.resume();\n    }\n  }\n\n  setVolume(vol: number): void {\n    this.volume = Math.max(0, Math.min(1, vol));\n    if (this.masterGain) {\n      this.masterGain.gain.value = this.volume;\n    }\n  }\n\n  toggleMute(): boolean {\n    this.muted = !this.muted;\n    if (this.masterGain) {\n      this.masterGain.gain.value = this.muted ? 0 : this.volume;\n    }\n    return this.muted;\n  }\n\n  get isMuted(): boolean {\n    return this.muted;\n  }\n\n  get currentVolume(): number {\n    return this.volume;\n  }\n\n  private playTone(\n    freq: number,\n    duration: number,\n    type: OscillatorType = 'sine',\n    gainValue: number = 0.3,\n    freqEnd?: number,\n  ): void {\n    if (!this.ctx || !this.masterGain) return;\n\n    const osc = this.ctx.createOscillator();\n    const gain = this.ctx.createGain();\n\n    osc.type = type;\n    osc.frequency.setValueAtTime(freq, this.ctx.currentTime);\n    if (freqEnd) {\n      osc.frequency.linearRampToValueAtTime(freqEnd, this.ctx.currentTime + duration);\n    }\n\n    gain.gain.setValueAtTime(gainValue, this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);\n\n    osc.connect(gain);\n    gain.connect(this.masterGain);\n\n    osc.start(this.ctx.currentTime);\n    osc.stop(this.ctx.currentTime + duration);\n  }\n\n  private playNoise(duration: number, gainValue: number = 0.1): void {\n    if (!this.ctx || !this.masterGain) return;\n\n    const bufferSize = this.ctx.sampleRate * duration;\n    const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);\n    const data = buffer.getChannelData(0);\n    for (let i = 0; i < bufferSize; i++) {\n      data[i] = (Math.random() * 2 - 1) * 0.5;\n    }\n\n    const source = this.ctx.createBufferSource();\n    source.buffer = buffer;\n\n    const gain = this.ctx.createGain();\n    gain.gain.setValueAtTime(gainValue, this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);\n\n    source.connect(gain);\n    gain.connect(this.masterGain);\n    source.start();\n  }\n\n  // === Sound Effects ===\n\n  playCollect(): void {\n    this.init();\n    this.playTone(800, 0.1, 'sine', 0.2);\n    setTimeout(() => this.playTone(1200, 0.08, 'sine', 0.15), 50);\n  }\n\n  playHarvest(): void {\n    this.init();\n    this.playTone(600, 0.12, 'triangle', 0.2);\n    setTimeout(() => this.playTone(900, 0.1, 'triangle', 0.15), 80);\n  }\n\n  playBuild(): void {\n    this.init();\n    this.playTone(200, 0.15, 'square', 0.15);\n    this.playNoise(0.1, 0.05);\n  }\n\n  playAlchemyStart(): void {\n    this.init();\n    this.playTone(400, 0.2, 'sine', 0.15);\n    setTimeout(() => this.playTone(500, 0.2, 'sine', 0.15), 150);\n  }\n\n  playAlchemyComplete(): void {\n    this.init();\n    this.playTone(800, 0.15, 'sine', 0.25);\n    setTimeout(() => this.playTone(1000, 0.15, 'sine', 0.2), 100);\n    setTimeout(() => this.playTone(1200, 0.2, 'sine', 0.25), 200);\n  }\n\n  playAlchemyFail(): void {\n    this.init();\n    this.playTone(300, 0.3, 'sawtooth', 0.15);\n    setTimeout(() => this.playTone(200, 0.4, 'sawtooth', 0.1), 200);\n  }\n\n  playBreakthroughStart(): void {\n    this.init();\n    // Rising tone sequence\n    const notes = [400, 500, 600, 700, 800, 1000, 1200];\n    notes.forEach((freq, i) => {\n      setTimeout(() => this.playTone(freq, 0.3, 'sine', 0.2), i * 150);\n    });\n  }\n\n  playBreakthroughSuccess(): void {\n    this.init();\n    // Triumphant ascending scale\n    const notes = [523, 659, 784, 1047, 1319];\n    notes.forEach((freq, i) => {\n      setTimeout(() => {\n        this.playTone(freq, 0.4, 'sine', 0.3);\n        this.playTone(freq * 1.5, 0.4, 'sine', 0.15);\n      }, i * 200);\n    });\n    // Final shimmer\n    setTimeout(() => {\n      for (let i = 0; i < 5; i++) {\n        setTimeout(() => this.playTone(2000 + i * 200, 0.3, 'sine', 0.1), i * 50);\n      }\n    }, 1200);\n  }\n\n  playBreakthroughFail(): void {\n    this.init();\n    this.playTone(300, 0.5, 'sawtooth', 0.2);\n    setTimeout(() => this.playTone(200, 0.6, 'sawtooth', 0.15), 300);\n    this.playNoise(0.3, 0.08);\n  }\n\n  playUsePill(): void {\n    this.init();\n    this.playTone(600, 0.1, 'sine', 0.15);\n    setTimeout(() => this.playTone(800, 0.1, 'sine', 0.15), 80);\n    setTimeout(() => this.playTone(1000, 0.15, 'sine', 0.1), 160);\n  }\n\n  playButtonClick(): void {\n    this.init();\n    this.playTone(1000, 0.05, 'sine', 0.1);\n  }\n\n  playLevelUp(): void {\n    this.init();\n    this.playTone(523, 0.15, 'sine', 0.2);\n    setTimeout(() => this.playTone(659, 0.15, 'sine', 0.2), 120);\n    setTimeout(() => this.playTone(784, 0.2, 'sine', 0.25), 240);\n  }\n}\n\n// Singleton\nexport const audioManager = new AudioManager();\n","numLines":195,"startLine":1,"totalLines":195}}}
