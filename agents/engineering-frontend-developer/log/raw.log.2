{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_663a32a9126641db908bf015","type":"tool_result","content":"1\t// Alchemy.ts — Alchemy system with recipes, progress, and success rates\n2\t\n3\texport interface AlchemyRecipe {\n4\t  id: string;\n5\t  name: string;\n6\t  nameEn: string;\n7\t  grade: string;\n8\t  ingredients: Record<string, number>;\n9\t  output: { resource: string; amount: number; amountMax?: number };\n10\t  time: number; // ms\n11\t  successRate: number;\n12\t  expReward: number;\n13\t  unlockRealm: string;\n14\t  description: string;\n15\t}\n16\t\n17\texport interface AlchemySession {\n18\t  recipeId: string;\n19\t  startTime: number;\n20\t  progress: number;\n21\t  complete: boolean;\n22\t}\n23\t\n24\tconst RECIPES: Record<string, AlchemyRecipe> = {\n25\t  pill_juling: {\n26\t    id: 'pill_juling',\n27\t    name: '聚灵丹',\n28\t    nameEn: 'Spirit Gathering Pill',\n29\t    grade: '下品',\n30\t    ingredients: { spirit_grass: 3 },\n31\t    output: { resource: 'pill_juling', amount: 1 },\n32\t    time: 15000,\n33\t    successRate: 0.95,\n34\t    expReward: 10,\n35\t    unlockRealm: 'liqi_2',\n36\t    description: '基础丹药，修为+10',\n37\t  },\n38\t  pill_peiyuan: {\n39\t    id: 'pill_peiyuan',\n40\t    name: '培元丹',\n41\t    nameEn: 'Foundation Pill',\n42\t    grade: '下品',\n43\t    ingredients: { spirit_grass: 5, spirit_stone: 2 },\n44\t    output: { resource: 'pill_peiyuan', amount: 1 },\n45\t    time: 20000,\n46\t    successRate: 0.90,\n47\t    expReward: 30,\n48\t    unlockRealm: 'liqi_6',\n49\t    description: '中级丹药，修为+30',\n50\t  },\n51\t  pill_ningqi: {\n52\t    id: 'pill_ningqi',\n53\t    name: '凝气丹',\n54\t    nameEn: 'Qi Condensing Pill',\n55\t    grade: '下品',\n56\t    ingredients: { spirit_grass: 5, spirit_stone: 2 },\n57\t    output: { resource: 'pill_ningqi', amount: 1, amountMax: 2 },\n58\t    time: 25000,\n59\t    successRate: 0.85,\n60\t    expReward: 50,\n61\t    unlockRealm: 'liqi_8',\n62\t    description: '凝练灵气，修为+50',\n63\t  },\n64\t  pill_zhuji: {\n65\t    id: 'pill_zhuji',\n66\t    name: '筑基丹',\n67\t    nameEn: 'Foundation Pill',\n68\t    grade: '中品',\n69\t    ingredients: { spirit_grass: 8, spirit_stone: 5, spirit_iron: 1 },\n70\t    output: { resource: 'pill_zhuji', amount: 1, amountMax: 3 },\n71\t    time: 30000,\n72\t    successRate: 0.80,\n73\t    expReward: 100,\n74\t    unlockRealm: 'zhuji_1',\n75\t    description: '筑基必需丹药，修为+100',\n76\t  },\n77\t  pill_jindanyin: {\n78\t    id: 'pill_jindanyin',\n79\t    name: '金丹引',\n80\t    nameEn: 'Golden Core Catalyst',\n81\t    grade: '中品',\n82\t    ingredients: { spirit_grass: 12, spirit_stone: 8, spirit_iron: 3 },\n83\t    output: { resource: 'pill_jindanyin', amount: 1, amountMax: 2 },\n84\t    time: 45000,\n85\t    successRate: 0.70,\n86\t    expReward: 500,\n87\t    unlockRealm: 'jindan_1',\n88\t    description: '金丹期必需丹药，修为+500',\n89\t  },\n90\t};\n91\t\n92\texport function getRecipe(id: string): AlchemyRecipe | undefined {\n93\t  return RECIPES[id];\n94\t}\n95\t\n96\texport function getAllRecipes(): AlchemyRecipe[] {\n97\t  return Object.values(RECIPES);\n98\t}\n99\t\n100\texport function getAvailableRecipes(unlockCheck: (realm: string) => boolean): AlchemyRecipe[] {\n101\t  return getAllRecipes().filter(r => unlockCheck(r.unlockRealm));\n102\t}\n103\t\n104\t// Check if player can start crafting a recipe\n105\texport function canCraft(recipe: AlchemyRecipe, resources: Record<string, number>): boolean {\n106\t  return Object.entries(recipe.ingredients).every(\n107\t    ([res, cost]) => (resources[res] ?? 0) >= cost,\n108\t  );\n109\t}\n110\t\n111\t// Start crafting: deduct ingredients, return session\n112\texport function startCrafting(\n113\t  recipeId: string,\n114\t  resources: Record<string, number>,\n115\t): { session: AlchemySession; resources: Record<string, number> } | null {\n116\t  const recipe = RECIPES[recipeId];\n117\t  if (!recipe) return null;\n118\t  if (!canCraft(recipe, resources)) return null;\n119\t\n120\t  // Deduct ingredients\n121\t  const newResources = { ...resources };\n122\t  for (const [res, cost] of Object.entries(recipe.ingredients)) {\n123\t    newResources[res] = (newResources[res] ?? 0) - cost;\n124\t  }\n125\t\n126\t  return {\n127\t    session: {\n128\t      recipeId,\n129\t      startTime: Date.now(),\n130\t      progress: 0,\n131\t      complete: false,\n132\t    },\n133\t    resources: newResources,\n134\t  };\n135\t}\n136\t\n137\t// Tick alchemy progress\n138\texport function tickAlchemy(session: AlchemySession | null, now: number): AlchemySession | null {\n139\t  if (!session || session.complete) return session;\n140\t\n141\t  const recipe = RECIPES[session.recipeId];\n142\t  if (!recipe) return null;\n143\t\n144\t  const elapsed = now - session.startTime;\n145\t  const progress = Math.min(1, elapsed / recipe.time);\n146\t\n147\t  return {\n148\t    ...session,\n149\t    progress,\n150\t    complete: progress >= 1,\n151\t  };\n152\t}\n153\t\n154\t// Collect result from completed alchemy\n155\texport function collectAlchemy(\n156\t  session: AlchemySession,\n157\t  resources: Record<string, number>,\n158\t): { resources: Record<string, number>; expReward: number; amount: number; success: boolean } | null {\n159\t  if (!session.complete) return null;\n160\t\n161\t  const recipe = RECIPES[session.recipeId];\n162\t  if (!recipe) return null;\n163\t\n164\t  // Roll for success\n165\t  const roll = Math.random();\n166\t  const success = roll < recipe.successRate;\n167\t\n168\t  if (!success) {\n169\t    return { resources, expReward: 0, amount: 0, success: false };\n170\t  }\n171\t\n172\t  // Calculate output amount\n173\t  const amount = recipe.output.amountMax\n174\t    ? recipe.output.amount + Math.floor(Math.random() * (recipe.output.amountMax - recipe.output.amount + 1))\n175\t    : recipe.output.amount;\n176\t\n177\t  const newResources = { ...resources };\n178\t  newResources[recipe.output.resource] = (newResources[recipe.output.resource] ?? 0) + amount;\n179\t\n180\t  return { resources: newResources, expReward: recipe.expReward, amount, success: true };\n181\t}\n182\t\n183\t// Get remaining time string\n184\texport function getRemainingTime(session: AlchemySession | null): string {\n185\t  if (!session) return '';\n186\t  const recipe = RECIPES[session.recipeId];\n187\t  if (!recipe) return '';\n188\t\n189\t  const elapsed = Date.now() - session.startTime;\n190\t  const remaining = Math.max(0, recipe.time - elapsed);\n191\t  const secs = Math.ceil(remaining / 1000);\n192\t  return `${secs}s`;\n193\t}\n194\t"}]},"parent_tool_use_id":null,"session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"86627fd6-1c1c-424c-9e04-342d74bd35c1","timestamp":"2026-05-23T02:11:14.720Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Alchemy.ts","content":"// Alchemy.ts — Alchemy system with recipes, progress, and success rates\n\nexport interface AlchemyRecipe {\n  id: string;\n  name: string;\n  nameEn: string;\n  grade: string;\n  ingredients: Record<string, number>;\n  output: { resource: string; amount: number; amountMax?: number };\n  time: number; // ms\n  successRate: number;\n  expReward: number;\n  unlockRealm: string;\n  description: string;\n}\n\nexport interface AlchemySession {\n  recipeId: string;\n  startTime: number;\n  progress: number;\n  complete: boolean;\n}\n\nconst RECIPES: Record<string, AlchemyRecipe> = {\n  pill_juling: {\n    id: 'pill_juling',\n    name: '聚灵丹',\n    nameEn: 'Spirit Gathering Pill',\n    grade: '下品',\n    ingredients: { spirit_grass: 3 },\n    output: { resource: 'pill_juling', amount: 1 },\n    time: 15000,\n    successRate: 0.95,\n    expReward: 10,\n    unlockRealm: 'liqi_2',\n    description: '基础丹药，修为+10',\n  },\n  pill_peiyuan: {\n    id: 'pill_peiyuan',\n    name: '培元丹',\n    nameEn: 'Foundation Pill',\n    grade: '下品',\n    ingredients: { spirit_grass: 5, spirit_stone: 2 },\n    output: { resource: 'pill_peiyuan', amount: 1 },\n    time: 20000,\n    successRate: 0.90,\n    expReward: 30,\n    unlockRealm: 'liqi_6',\n    description: '中级丹药，修为+30',\n  },\n  pill_ningqi: {\n    id: 'pill_ningqi',\n    name: '凝气丹',\n    nameEn: 'Qi Condensing Pill',\n    grade: '下品',\n    ingredients: { spirit_grass: 5, spirit_stone: 2 },\n    output: { resource: 'pill_ningqi', amount: 1, amountMax: 2 },\n    time: 25000,\n    successRate: 0.85,\n    expReward: 50,\n    unlockRealm: 'liqi_8',\n    description: '凝练灵气，修为+50',\n  },\n  pill_zhuji: {\n    id: 'pill_zhuji',\n    name: '筑基丹',\n    nameEn: 'Foundation Pill',\n    grade: '中品',\n    ingredients: { spirit_grass: 8, spirit_stone: 5, spirit_iron: 1 },\n    output: { resource: 'pill_zhuji', amount: 1, amountMax: 3 },\n    time: 30000,\n    successRate: 0.80,\n    expReward: 100,\n    unlockRealm: 'zhuji_1',\n    description: '筑基必需丹药，修为+100',\n  },\n  pill_jindanyin: {\n    id: 'pill_jindanyin',\n    name: '金丹引',\n    nameEn: 'Golden Core Catalyst',\n    grade: '中品',\n    ingredients: { spirit_grass: 12, spirit_stone: 8, spirit_iron: 3 },\n    output: { resource: 'pill_jindanyin', amount: 1, amountMax: 2 },\n    time: 45000,\n    successRate: 0.70,\n    expReward: 500,\n    unlockRealm: 'jindan_1',\n    description: '金丹期必需丹药，修为+500',\n  },\n};\n\nexport function getRecipe(id: string): AlchemyRecipe | undefined {\n  return RECIPES[id];\n}\n\nexport function getAllRecipes(): AlchemyRecipe[] {\n  return Object.values(RECIPES);\n}\n\nexport function getAvailableRecipes(unlockCheck: (realm: string) => boolean): AlchemyRecipe[] {\n  return getAllRecipes().filter(r => unlockCheck(r.unlockRealm));\n}\n\n// Check if player can start crafting a recipe\nexport function canCraft(recipe: AlchemyRecipe, resources: Record<string, number>): boolean {\n  return Object.entries(recipe.ingredients).every(\n    ([res, cost]) => (resources[res] ?? 0) >= cost,\n  );\n}\n\n// Start crafting: deduct ingredients, return session\nexport function startCrafting(\n  recipeId: string,\n  resources: Record<string, number>,\n): { session: AlchemySession; resources: Record<string, number> } | null {\n  const recipe = RECIPES[recipeId];\n  if (!recipe) return null;\n  if (!canCraft(recipe, resources)) return null;\n\n  // Deduct ingredients\n  const newResources = { ...resources };\n  for (const [res, cost] of Object.entries(recipe.ingredients)) {\n    newResources[res] = (newResources[res] ?? 0) - cost;\n  }\n\n  return {\n    session: {\n      recipeId,\n      startTime: Date.now(),\n      progress: 0,\n      complete: false,\n    },\n    resources: newResources,\n  };\n}\n\n// Tick alchemy progress\nexport function tickAlchemy(session: AlchemySession | null, now: number): AlchemySession | null {\n  if (!session || session.complete) return session;\n\n  const recipe = RECIPES[session.recipeId];\n  if (!recipe) return null;\n\n  const elapsed = now - session.startTime;\n  const progress = Math.min(1, elapsed / recipe.time);\n\n  return {\n    ...session,\n    progress,\n    complete: progress >= 1,\n  };\n}\n\n// Collect result from completed alchemy\nexport function collectAlchemy(\n  session: AlchemySession,\n  resources: Record<string, number>,\n): { resources: Record<string, number>; expReward: number; amount: number; success: boolean } | null {\n  if (!session.complete) return null;\n\n  const recipe = RECIPES[session.recipeId];\n  if (!recipe) return null;\n\n  // Roll for success\n  const roll = Math.random();\n  const success = roll < recipe.successRate;\n\n  if (!success) {\n    return { resources, expReward: 0, amount: 0, success: false };\n  }\n\n  // Calculate output amount\n  const amount = recipe.output.amountMax\n    ? recipe.output.amount + Math.floor(Math.random() * (recipe.output.amountMax - recipe.output.amount + 1))\n    : recipe.output.amount;\n\n  const newResources = { ...resources };\n  newResources[recipe.output.resource] = (newResources[recipe.output.resource] ?? 0) + amount;\n\n  return { resources: newResources, expReward: recipe.expReward, amount, success: true };\n}\n\n// Get remaining time string\nexport function getRemainingTime(session: AlchemySession | null): string {\n  if (!session) return '';\n  const recipe = RECIPES[session.recipeId];\n  if (!recipe) return '';\n\n  const elapsed = Date.now() - session.startTime;\n  const remaining = Math.max(0, recipe.time - elapsed);\n  const secs = Math.ceil(remaining / 1000);\n  return `${secs}s`;\n}\n","numLines":194,"startLine":1,"totalLines":194}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_9749b30711144c678daaf043","type":"tool_result","content":"1\t// Resources.ts — Resource management with manual collection and display\n2\t\n3\timport type { GameState, Resources, BuildingInstance } from './GameState';\n4\timport { addResources, addCultivation, updateBuilding } from './GameState';\n5\timport type { BuildingDef } from './Building';\n6\t\n7\texport interface ResourceDisplay {\n8\t  id: string;\n9\t  name: string;\n10\t  amount: number;\n11\t  icon: string;\n12\t  color: string;\n13\t}\n14\t\n15\tconst RESOURCE_META: Record<string, { name: string; icon: string; color: string }> = {\n16\t  spirit_stone: { name: '灵石', icon: '💎', color: '#7cc8ff' },\n17\t  spirit_grass: { name: '灵草', icon: '🌿', color: '#6adf6a' },\n18\t  spirit_energy: { name: '灵气', icon: '✨', color: '#b480ff' },\n19\t  cultivation: { name: '修为', icon: '⚡', color: '#ffd700' },\n20\t  pill_juling: { name: '聚灵丹', icon: '💊', color: '#ff8c32' },\n21\t  pill_peiyuan: { name: '培元丹', icon: '💊', color: '#ff6699' },\n22\t  pill_ningqi: { name: '凝气丹', icon: '💊', color: '#cc66ff' },\n23\t  pill_zhuji: { name: '筑基丹', icon: '💊', color: '#ffcc00' },\n24\t  pill_jindanyin: { name: '金丹引', icon: '💊', color: '#ff4444' },\n25\t  spirit_iron: { name: '灵铁', icon: '🔩', color: '#8a8aaa' },\n26\t  spirit_wood: { name: '灵木', icon: '🪵', color: '#aa8844' },\n27\t  talisman_paper: { name: '符纸', icon: '📜', color: '#ddcc88' },\n28\t};\n29\t\n30\texport function getResourceDisplays(resources: Resources): ResourceDisplay[] {\n31\t  const displays: ResourceDisplay[] = [];\n32\t  for (const [id, meta] of Object.entries(RESOURCE_META)) {\n33\t    displays.push({\n34\t      id,\n35\t      name: meta.name,\n36\t      amount: resources[id as keyof Resources] ?? 0,\n37\t      icon: meta.icon,\n38\t      color: meta.color,\n39\t    });\n40\t  }\n41\t  return displays;\n42\t}\n43\t\n44\t// Manual collection: player clicks a building to collect\n45\texport function collectFromBuilding(\n46\t  state: GameState,\n47\t  building: BuildingInstance,\n48\t  def: BuildingDef,\n49\t  mapIndex: number,\n50\t): GameState {\n51\t  if (def.production.mode !== 'manual') return state;\n52\t\n53\t  const prod = def.production;\n54\t\n55\t  // Check if we need input resources\n56\t  if (prod.input) {\n57\t    const canAfford = Object.entries(prod.input).every(\n58\t      ([res, cost]) => (state.resources[res as keyof Resources] ?? 0) >= cost,\n59\t    );\n60\t    if (!canAfford) return state;\n61\t\n62\t    // Consume input resources\n63\t    const inputDelta: Partial<Resources> = {};\n64\t    for (const [res, cost] of Object.entries(prod.input)) {\n65\t      (inputDelta as Record<string, number>)[res] = -cost;\n66\t    }\n67\t    state = addResources(state, inputDelta);\n68\t  }\n69\t\n70\t  // For fields, check if ready for harvest\n71\t  if (def.category === 'farming') {\n72\t    if (building.progress < 1) return state;\n73\t    // Reset progress after harvest\n74\t    state = updateBuilding(state, mapIndex, building.uid, {\n75\t      progress: 0,\n76\t      isProducing: false,\n77\t    });\n78\t  }\n79\t\n80\t  // Add produced resource\n81\t  const delta: Partial<Resources> = {};\n82\t  (delta as Record<string, number>)[prod.resource] = prod.amount;\n83\t  state = addResources(state, delta);\n84\t\n85\t  // Cultivation gives exp\n86\t  if (prod.resource === 'cultivation') {\n87\t    state = addCultivation(state, prod.amount);\n88\t  }\n89\t\n90\t  return state;\n91\t}\n92\t\n93\t// Plant a field (starts growth timer)\n94\texport function plantField(\n95\t  state: GameState,\n96\t  building: BuildingInstance,\n97\t  mapIndex: number,\n98\t): GameState {\n99\t  return updateBuilding(state, mapIndex, building.uid, {\n100\t    isProducing: true,\n101\t    progress: 0,\n102\t    lastCollectTime: Date.now(),\n103\t  });\n104\t}\n105\t\n106\t// Update auto-production buildings (called every tick)\n107\texport function tickAutoProduction(\n108\t  state: GameState,\n109\t  mapIndex: number,\n110\t  now: number,\n111\t  buildingDefs: Map<string, BuildingDef>,\n112\t): GameState {\n113\t  const map = state.maps[mapIndex];\n114\t  if (!map) return state;\n115\t\n116\t  for (const building of map.buildings) {\n117\t    const def = buildingDefs.get(building.buildingId);\n118\t    if (!def || def.production.mode !== 'auto') continue;\n119\t\n120\t    if (!building.isProducing) {\n121\t      // Start production\n122\t      state = updateBuilding(state, mapIndex, building.uid, {\n123\t        isProducing: true,\n124\t        lastCollectTime: now,\n125\t        progress: 0,\n126\t      });\n127\t      continue;\n128\t    }\n129\t\n130\t    const elapsed = now - building.lastCollectTime;\n131\t    const interval = def.production.interval;\n132\t    const progress = Math.min(1, elapsed / interval);\n133\t\n134\t    if (progress >= 1) {\n135\t      // Production complete — collect and restart\n136\t      const delta: Partial<Resources> = {};\n137\t      (delta as Record<string, number>)[def.production.resource] = def.production.amount;\n138\t      state = addResources(state, delta);\n139\t\n140\t      state = updateBuilding(state, mapIndex, building.uid, {\n141\t        lastCollectTime: now,\n142\t        progress: 0,\n143\t      });\n144\t    } else {\n145\t      state = updateBuilding(state, mapIndex, building.uid, { progress });\n146\t    }\n147\t  }\n148\t\n149\t  return state;\n150\t}\n151\t\n152\t// Tick manual buildings (e.g. field growth)\n153\texport function tickManualProduction(\n154\t  state: GameState,\n155\t  mapIndex: number,\n156\t  now: number,\n157\t  buildingDefs: Map<string, BuildingDef>,\n158\t): GameState {\n159\t  const map = state.maps[mapIndex];\n160\t  if (!map) return state;\n161\t\n162\t  for (const building of map.buildings) {\n163\t    const def = buildingDefs.get(building.buildingId);\n164\t    if (!def || def.production.mode !== 'manual') continue;\n165\t    if (!building.isProducing) continue;\n166\t\n167\t    const elapsed = now - building.lastCollectTime;\n168\t    const interval = def.production.interval;\n169\t    const progress = Math.min(1, elapsed / interval);\n170\t\n171\t    state = updateBuilding(state, mapIndex, building.uid, { progress });\n172\t  }\n173\t\n174\t  return state;\n175\t}\n176\t\n177\t// Format resource amounts for display (e.g. 1200 → \"1.2K\")\n178\texport function formatAmount(amount: number): string {\n179\t  if (amount >= 1_000_000) return (amount / 1_000_000).toFixed(1) + 'M';\n180\t  if (amount >= 10_000) return (amount / 1_000).toFixed(1) + 'K';\n181\t  if (amount >= 1_000) return (amount / 1_000).toFixed(1) + 'K';\n182\t  return Math.floor(amount).toString();\n183\t}\n184\t\n185\t// Check if player can afford a cost\n186\texport function canAfford(resources: Resources, cost: Record<string, number>): boolean {\n187\t  return Object.entries(cost).every(\n188\t    ([res, amount]) => (resources[res as keyof Resources] ?? 0) >= amount,\n189\t  );\n190\t}\n191\t\n192\t// Deduct cost from resources\n193\texport function deductCost(state: GameState, cost: Record<string, number>): GameState {\n194\t  const delta: Partial<Resources> = {};\n195\t  for (const [res, amount] of Object.entries(cost)) {\n196\t    (delta as Record<string, number>)[res] = -amount;\n197\t  }\n198\t  return addResources(state, delta);\n199\t}\n200\t"}]},"parent_tool_use_id":null,"session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"5654a509-8207-418c-a33e-cf7eaf2ffb4a","timestamp":"2026-05-23T02:11:15.131Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Resources.ts","content":"// Resources.ts — Resource management with manual collection and display\n\nimport type { GameState, Resources, BuildingInstance } from './GameState';\nimport { addResources, addCultivation, updateBuilding } from './GameState';\nimport type { BuildingDef } from './Building';\n\nexport interface ResourceDisplay {\n  id: string;\n  name: string;\n  amount: number;\n  icon: string;\n  color: string;\n}\n\nconst RESOURCE_META: Record<string, { name: string; icon: string; color: string }> = {\n  spirit_stone: { name: '灵石', icon: '💎', color: '#7cc8ff' },\n  spirit_grass: { name: '灵草', icon: '🌿', color: '#6adf6a' },\n  spirit_energy: { name: '灵气', icon: '✨', color: '#b480ff' },\n  cultivation: { name: '修为', icon: '⚡', color: '#ffd700' },\n  pill_juling: { name: '聚灵丹', icon: '💊', color: '#ff8c32' },\n  pill_peiyuan: { name: '培元丹', icon: '💊', color: '#ff6699' },\n  pill_ningqi: { name: '凝气丹', icon: '💊', color: '#cc66ff' },\n  pill_zhuji: { name: '筑基丹', icon: '💊', color: '#ffcc00' },\n  pill_jindanyin: { name: '金丹引', icon: '💊', color: '#ff4444' },\n  spirit_iron: { name: '灵铁', icon: '🔩', color: '#8a8aaa' },\n  spirit_wood: { name: '灵木', icon: '🪵', color: '#aa8844' },\n  talisman_paper: { name: '符纸', icon: '📜', color: '#ddcc88' },\n};\n\nexport function getResourceDisplays(resources: Resources): ResourceDisplay[] {\n  const displays: ResourceDisplay[] = [];\n  for (const [id, meta] of Object.entries(RESOURCE_META)) {\n    displays.push({\n      id,\n      name: meta.name,\n      amount: resources[id as keyof Resources] ?? 0,\n      icon: meta.icon,\n      color: meta.color,\n    });\n  }\n  return displays;\n}\n\n// Manual collection: player clicks a building to collect\nexport function collectFromBuilding(\n  state: GameState,\n  building: BuildingInstance,\n  def: BuildingDef,\n  mapIndex: number,\n): GameState {\n  if (def.production.mode !== 'manual') return state;\n\n  const prod = def.production;\n\n  // Check if we need input resources\n  if (prod.input) {\n    const canAfford = Object.entries(prod.input).every(\n      ([res, cost]) => (state.resources[res as keyof Resources] ?? 0) >= cost,\n    );\n    if (!canAfford) return state;\n\n    // Consume input resources\n    const inputDelta: Partial<Resources> = {};\n    for (const [res, cost] of Object.entries(prod.input)) {\n      (inputDelta as Record<string, number>)[res] = -cost;\n    }\n    state = addResources(state, inputDelta);\n  }\n\n  // For fields, check if ready for harvest\n  if (def.category === 'farming') {\n    if (building.progress < 1) return state;\n    // Reset progress after harvest\n    state = updateBuilding(state, mapIndex, building.uid, {\n      progress: 0,\n      isProducing: false,\n    });\n  }\n\n  // Add produced resource\n  const delta: Partial<Resources> = {};\n  (delta as Record<string, number>)[prod.resource] = prod.amount;\n  state = addResources(state, delta);\n\n  // Cultivation gives exp\n  if (prod.resource === 'cultivation') {\n    state = addCultivation(state, prod.amount);\n  }\n\n  return state;\n}\n\n// Plant a field (starts growth timer)\nexport function plantField(\n  state: GameState,\n  building: BuildingInstance,\n  mapIndex: number,\n): GameState {\n  return updateBuilding(state, mapIndex, building.uid, {\n    isProducing: true,\n    progress: 0,\n    lastCollectTime: Date.now(),\n  });\n}\n\n// Update auto-production buildings (called every tick)\nexport function tickAutoProduction(\n  state: GameState,\n  mapIndex: number,\n  now: number,\n  buildingDefs: Map<string, BuildingDef>,\n): GameState {\n  const map = state.maps[mapIndex];\n  if (!map) return state;\n\n  for (const building of map.buildings) {\n    const def = buildingDefs.get(building.buildingId);\n    if (!def || def.production.mode !== 'auto') continue;\n\n    if (!building.isProducing) {\n      // Start production\n      state = updateBuilding(state, mapIndex, building.uid, {\n        isProducing: true,\n        lastCollectTime: now,\n        progress: 0,\n      });\n      continue;\n    }\n\n    const elapsed = now - building.lastCollectTime;\n    const interval = def.production.interval;\n    const progress = Math.min(1, elapsed / interval);\n\n    if (progress >= 1) {\n      // Production complete — collect and restart\n      const delta: Partial<Resources> = {};\n      (delta as Record<string, number>)[def.production.resource] = def.production.amount;\n      state = addResources(state, delta);\n\n      state = updateBuilding(state, mapIndex, building.uid, {\n        lastCollectTime: now,\n        progress: 0,\n      });\n    } else {\n      state = updateBuilding(state, mapIndex, building.uid, { progress });\n    }\n  }\n\n  return state;\n}\n\n// Tick manual buildings (e.g. field growth)\nexport function tickManualProduction(\n  state: GameState,\n  mapIndex: number,\n  now: number,\n  buildingDefs: Map<string, BuildingDef>,\n): GameState {\n  const map = state.maps[mapIndex];\n  if (!map) return state;\n\n  for (const building of map.buildings) {\n    const def = buildingDefs.get(building.buildingId);\n    if (!def || def.production.mode !== 'manual') continue;\n    if (!building.isProducing) continue;\n\n    const elapsed = now - building.lastCollectTime;\n    const interval = def.production.interval;\n    const progress = Math.min(1, elapsed / interval);\n\n    state = updateBuilding(state, mapIndex, building.uid, { progress });\n  }\n\n  return state;\n}\n\n// Format resource amounts for display (e.g. 1200 → \"1.2K\")\nexport function formatAmount(amount: number): string {\n  if (amount >= 1_000_000) return (amount / 1_000_000).toFixed(1) + 'M';\n  if (amount >= 10_000) return (amount / 1_000).toFixed(1) + 'K';\n  if (amount >= 1_000) return (amount / 1_000).toFixed(1) + 'K';\n  return Math.floor(amount).toString();\n}\n\n// Check if player can afford a cost\nexport function canAfford(resources: Resources, cost: Record<string, number>): boolean {\n  return Object.entries(cost).every(\n    ([res, amount]) => (resources[res as keyof Resources] ?? 0) >= amount,\n  );\n}\n\n// Deduct cost from resources\nexport function deductCost(state: GameState, cost: Record<string, number>): GameState {\n  const delta: Partial<Resources> = {};\n  for (const [res, amount] of Object.entries(cost)) {\n    (delta as Record<string, number>)[res] = -amount;\n  }\n  return addResources(state, delta);\n}\n","numLines":200,"startLine":1,"totalLines":200}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_05edcffcf1d641c8aeaad84c","type":"tool_result","content":"1\t// Map.ts — Grid-based map system with terrain and area rendering\n2\t\n3\texport enum Terrain {\n4\t  Grass = 0,\n5\t  Rock = 1,\n6\t  Water = 2,\n7\t  RichSoil = 3,\n8\t  Mountain = 4,\n9\t  Path = 5,\n10\t  SpiritVein = 6,\n11\t}\n12\t\n13\texport interface MapConfig {\n14\t  width: number;\n15\t  height: number;\n16\t  bgColor: string;\n17\t  gridColor: string;\n18\t  cellSize: number;\n19\t}\n20\t\n21\texport const DEFAULT_CELL_SIZE = 32;\n22\t\n23\texport class GameMap {\n24\t  width: number;\n25\t  height: number;\n26\t  cellSize: number;\n27\t  terrain: Terrain[];\n28\t  bgColor: string;\n29\t  gridColor: string;\n30\t\n31\t  constructor(\n32\t    width: number,\n33\t    height: number,\n34\t    bgColor: string = '#2a3a1a',\n35\t    gridColor: string = '#3a4a2a',\n36\t    cellSize: number = DEFAULT_CELL_SIZE,\n37\t  ) {\n38\t    this.width = width;\n39\t    this.height = height;\n40\t    this.cellSize = cellSize;\n41\t    this.bgColor = bgColor;\n42\t    this.gridColor = gridColor;\n43\t    this.terrain = new Array(width * height).fill(Terrain.Grass);\n44\t  }\n45\t\n46\t  get indexSize(): number {\n47\t    return this.width * this.height;\n48\t  }\n49\t\n50\t  inBounds(gx: number, gy: number): boolean {\n51\t    return gx >= 0 && gx < this.width && gy >= 0 && gy < this.height;\n52\t  }\n53\t\n54\t  getTerrain(gx: number, gy: number): Terrain {\n55\t    if (!this.inBounds(gx, gy)) return Terrain.Mountain;\n56\t    return this.terrain[gy * this.width + gx];\n57\t  }\n58\t\n59\t  setTerrain(gx: number, gy: number, t: Terrain): void {\n60\t    if (!this.inBounds(gx, gy)) return;\n61\t    this.terrain[gy * this.width + gx] = t;\n62\t  }\n63\t\n64\t  // Check if a rect of cells is free for placement\n65\t  isAreaFree(gx: number, gy: number, w: number, h: number, occupied: Set<string>): boolean {\n66\t    for (let dy = 0; dy < h; dy++) {\n67\t      for (let dx = 0; dx < w; dx++) {\n68\t        const cx = gx + dx;\n69\t        const cy = gy + dy;\n70\t        if (!this.inBounds(cx, cy)) return false;\n71\t        const t = this.getTerrain(cx, cy);\n72\t        if (t === Terrain.Water || t === Terrain.Mountain) return false;\n73\t        const key = `${cx},${cy}`;\n74\t        if (occupied.has(key)) return false;\n75\t      }\n76\t    }\n77\t    return true;\n78\t  }\n79\t\n80\t  // Generate terrain for the starting area (炼气坪)\n81\t  generateStartingArea(): void {\n82\t    // Add some spirit veins (矿脉)\n83\t    const veinPositions = [\n84\t      [3, 2], [4, 2], [3, 3],\n85\t      [14, 10], [15, 10], [15, 11],\n86\t      [8, 7], [8, 8],\n87\t    ];\n88\t    for (const [x, y] of veinPositions) {\n89\t      this.setTerrain(x, y, Terrain.SpiritVein);\n90\t    }\n91\t\n92\t    // Add some water features\n93\t    const waterPositions = [\n94\t      [10, 1], [11, 1], [10, 2],\n95\t      [1, 12], [2, 12], [1, 11],\n96\t    ];\n97\t    for (const [x, y] of waterPositions) {\n98\t      this.setTerrain(x, y, Terrain.Water);\n99\t    }\n100\t\n101\t    // Add path\n102\t    for (let x = 5; x < 15; x++) {\n103\t      this.setTerrain(x, 7, Terrain.Path);\n104\t    }\n105\t    for (let y = 3; y < 12; y++) {\n106\t      this.setTerrain(10, y, Terrain.Path);\n107\t    }\n108\t\n109\t    // Rich soil near center\n110\t    for (let y = 5; y < 8; y++) {\n111\t      for (let x = 6; x < 9; x++) {\n112\t        this.setTerrain(x, y, Terrain.RichSoil);\n113\t      }\n114\t    }\n115\t  }\n116\t\n117\t  // Generate terrain for a specific region type\n118\t  generateRegionTerrain(regionId: string): void {\n119\t    switch (regionId) {\n120\t      case 'zhuji_platform':\n121\t        this.generateZhujiPlatform();\n122\t        break;\n123\t      case 'medicine_valley':\n124\t        this.generateMedicineValley();\n125\t        break;\n126\t      case 'core_peak':\n127\t        this.generateCorePeak();\n128\t        break;\n129\t      case 'ore_mountain':\n130\t        this.generateOreMountain();\n131\t        break;\n132\t      case 'spirit_field_area':\n133\t        this.generateSpiritFieldArea();\n134\t        break;\n135\t      case 'mine_area':\n136\t        this.generateMineArea();\n137\t        break;\n138\t      default:\n139\t        this.generateStartingArea();\n140\t    }\n141\t  }\n142\t\n143\t  private generateZhujiPlatform(): void {\n144\t    // 筑基台：灵铁+灵木丰富，中等大小\n145\t    const veinPositions = [\n146\t      [5, 3], [6, 3], [5, 4],\n147\t      [20, 15], [21, 15], [21, 16],\n148\t      [12, 10], [13, 10],\n149\t    ];\n150\t    for (const [x, y] of veinPositions) {\n151\t      this.setTerrain(x, y, Terrain.SpiritVein);\n152\t    }\n153\t\n154\t    // Rich soil patches\n155\t    for (let y = 6; y < 12; y++) {\n156\t      for (let x = 8; x < 14; x++) {\n157\t        this.setTerrain(x, y, Terrain.RichSoil);\n158\t      }\n159\t    }\n160\t\n161\t    // Paths\n162\t    for (let x = 4; x < 26; x++) {\n163\t      this.setTerrain(x, 12, Terrain.Path);\n164\t    }\n165\t    for (let y = 4; y < 22; y++) {\n166\t      this.setTerrain(15, y, Terrain.Path);\n167\t    }\n168\t\n169\t    // Water features\n170\t    this.setTerrain(2, 2, Terrain.Water);\n171\t    this.setTerrain(3, 2, Terrain.Water);\n172\t    this.setTerrain(2, 3, Terrain.Water);\n173\t  }\n174\t\n175\t  private generateMedicineValley(): void {\n176\t    // 药王谷：大量灵田，稀有灵草\n177\t    for (let y = 3; y < 22; y++) {\n178\t      for (let x = 3; x < 32; x++) {\n179\t        if (Math.random() < 0.6) {\n180\t          this.setTerrain(x, y, Terrain.RichSoil);\n181\t        }\n182\t      }\n183\t    }\n184\t\n185\t    // Spirit veins at edges\n186\t    const veinPositions = [\n187\t      [1, 1], [33, 1], [1, 23], [33, 23],\n188\t      [17, 12],\n189\t    ];\n190\t    for (const [x, y] of veinPositions) {\n191\t      this.setTerrain(x, y, Terrain.SpiritVein);\n192\t    }\n193\t\n194\t    // Central path\n195\t    for (let x = 5; x < 30; x++) {\n196\t      this.setTerrain(x, 12, Terrain.Path);\n197\t    }\n198\t  }\n199\t\n200\t  private generateCorePeak(): void {\n201\t    // 丹鼎峰：炼丹圣地，岩石地形多\n202\t    const veinPositions = [\n203\t      [5, 5], [6, 5], [5, 6],\n204\t      [28, 22], [29, 22], [29, 23],\n205\t      [17, 14], [18, 14],\n206\t      [10, 20], [24, 8],\n207\t    ];\n208\t    for (const [x, y] of veinPositions) {\n209\t      this.setTerrain(x, y, Terrain.SpiritVein);\n210\t    }\n211\t\n212\t    // Rocky terrain\n213\t    for (let y = 2; y < 28; y += 4) {\n214\t      for (let x = 2; x < 33; x += 5) {\n215\t        if (Math.random() < 0.3) {\n216\t          this.setTerrain(x, y, Terrain.Rock);\n217\t        }\n218\t      }\n219\t    }\n220\t\n221\t    // Paths\n222\t    for (let x = 3; x < 32; x++) {\n223\t      this.setTerrain(x, 15, Terrain.Path);\n224\t    }\n225\t    for (let y = 3; y < 28; y++) {\n226\t      this.setTerrain(17, y, Terrain.Path);\n227\t    }\n228\t  }\n229\t\n230\t  private generateOreMountain(): void {\n231\t    // 矿脉山：大量矿脉，灵石/灵铁高产\n232\t    const veinPositions = [\n233\t      [4, 4], [5, 4], [4, 5],\n234\t      [20, 5], [21, 5], [21, 6],\n235\t      [35, 15], [36, 15], [36, 16],\n236\t      [10, 20], [11, 20], [11, 21],\n237\t      [28, 25], [29, 25], [29, 26],\n238\t    ];\n239\t    for (const [x, y] of veinPositions) {\n240\t      this.setTerrain(x, y, Terrain.SpiritVein);\n241\t    }\n242\t\n243\t    // Mountain terrain\n244\t    for (let y = 0; y < 5; y++) {\n245\t      for (let x = 0; x < this.width; x++) {\n246\t        if (Math.random() < 0.4) this.setTerrain(x, y, Terrain.Mountain);\n247\t      }\n248\t    }\n249\t\n250\t    // Paths\n251\t    for (let x = 5; x < 35; x++) {\n252\t      this.setTerrain(x, 15, Terrain.Path);\n253\t    }\n254\t    for (let y = 5; y < 25; y++) {\n255\t      this.setTerrain(20, y, Terrain.Path);\n256\t    }\n257\t  }\n258\t\n259\t  private generateSpiritFieldArea(): void {\n260\t    // 灵田区：大量灵田资源\n261\t    for (let y = 4; y < 16; y++) {\n262\t      for (let x = 4; x < 21; x++) {\n263\t        if (Math.random() < 0.5) {\n264\t          this.setTerrain(x, y, Terrain.RichSoil);\n265\t        }\n266\t      }\n267\t    }\n268\t\n269\t    const veinPositions = [\n270\t      [2, 2], [22, 18],\n271\t    ];\n272\t    for (const [x, y] of veinPositions) {\n273\t      this.setTerrain(x, y, Terrain.SpiritVein);\n274\t    }\n275\t\n276\t    for (let x = 3; x < 22; x++) {\n277\t      this.setTerrain(x, 10, Terrain.Path);\n278\t    }\n279\t  }\n280\t\n281\t  private generateMineArea(): void {\n282\t    // 灵石矿区：大量矿脉\n283\t    const veinPositions = [\n284\t      [3, 3], [4, 3], [3, 4],\n285\t      [15, 8], [16, 8], [16, 9],\n286\t      [25, 15], [26, 15], [26, 16],\n287\t    ];\n288\t    for (const [x, y] of veinPositions) {\n289\t      this.setTerrain(x, y, Terrain.SpiritVein);\n290\t    }\n291\t\n292\t    for (let x = 5; x < 25; x++) {\n293\t      this.setTerrain(x, 10, Terrain.Path);\n294\t    }\n295\t  }\n296\t\n297\t  // Render map terrain to canvas\n298\t  render(\n299\t    ctx: CanvasRenderingContext2D,\n300\t    offsetX: number,\n301\t    offsetY: number,\n302\t    viewportW: number,\n303\t    viewportH: number,\n304\t    scale: number,\n305\t  ): void {\n306\t    const invScale = 1 / scale;\n307\t    const startCol = Math.max(0, Math.floor(-offsetX * invScale / this.cellSize));\n308\t    const startRow = Math.max(0, Math.floor(-offsetY * invScale / this.cellSize));\n309\t    const endCol = Math.min(this.width, Math.ceil((-offsetX + viewportW) * invScale / this.cellSize) + 1);\n310\t    const endRow = Math.min(this.height, Math.ceil((-offsetY + viewportH) * invScale / this.cellSize) + 1);\n311\t\n312\t    // Draw terrain cells\n313\t    for (let row = startRow; row < endRow; row++) {\n314\t      for (let col = startCol; col < endCol; col++) {\n315\t        const x = offsetX + col * this.cellSize * scale;\n316\t        const y = offsetY + row * this.cellSize * scale;\n317\t        const size = this.cellSize * scale;\n318\t\n319\t        ctx.fillStyle = this.getTerrainColor(this.getTerrain(col, row));\n320\t        ctx.fillRect(x, y, size, size);\n321\t\n322\t        // Draw grid line\n323\t        ctx.strokeStyle = this.gridColor;\n324\t        ctx.lineWidth = 0.5;\n325\t        ctx.strokeRect(x, y, size, size);\n326\t      }\n327\t    }\n328\t  }\n329\t\n330\t  private getTerrainColor(t: Terrain): string {\n331\t    switch (t) {\n332\t      case Terrain.Grass: return this.bgColor;\n333\t      case Terrain.Rock: return '#3a3a4a';\n334\t      case Terrain.Water: return '#1a3a5a';\n335\t      case Terrain.RichSoil: return '#2a4a1a';\n336\t      case Terrain.Mountain: return '#4a4a4a';\n337\t      case Terrain.Path: return '#4a3a2a';\n338\t      case Terrain.SpiritVein: return '#2a4a5a';\n339\t      default: return this.bgColor;\n340\t    }\n341\t  }\n342\t\n343\t  // Screen coordinates to grid cell\n344\t  screenToGrid(\n345\t    screenX: number,\n346\t    screenY: number,\n347\t    offsetX: number,\n348\t    offsetY: number,\n349\t    scale: number,\n350\t  ): { gx: number; gy: number } {\n351\t    const invScale = 1 / scale;\n352\t    const gx = Math.floor((screenX - offsetX) * invScale / this.cellSize);\n353\t    const gy = Math.floor((screenY - offsetY) * invScale / this.cellSize);\n354\t    return { gx, gy };\n355\t  }\n356\t\n357\t  // Grid cell center to screen coordinates\n358\t  gridToScreen(\n359\t    gx: number,\n360\t    gy: number,\n361\t    offsetX: number,\n362\t    offsetY: number,\n363\t    scale: number,\n364\t  ): { x: number; y: number } {\n365\t    return {\n366\t      x: offsetX + (gx + 0.5) * this.cellSize * scale,\n367\t      y: offsetY + (gy + 0.5) * this.cellSize * scale,\n368\t    };\n369\t  }\n370\t}\n371\t"}]},"parent_tool_use_id":null,"session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"fd4ba813-8197-487b-bccb-f929e4de2ef4","timestamp":"2026-05-23T02:11:15.164Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Map.ts","content":"// Map.ts — Grid-based map system with terrain and area rendering\n\nexport enum Terrain {\n  Grass = 0,\n  Rock = 1,\n  Water = 2,\n  RichSoil = 3,\n  Mountain = 4,\n  Path = 5,\n  SpiritVein = 6,\n}\n\nexport interface MapConfig {\n  width: number;\n  height: number;\n  bgColor: string;\n  gridColor: string;\n  cellSize: number;\n}\n\nexport const DEFAULT_CELL_SIZE = 32;\n\nexport class GameMap {\n  width: number;\n  height: number;\n  cellSize: number;\n  terrain: Terrain[];\n  bgColor: string;\n  gridColor: string;\n\n  constructor(\n    width: number,\n    height: number,\n    bgColor: string = '#2a3a1a',\n    gridColor: string = '#3a4a2a',\n    cellSize: number = DEFAULT_CELL_SIZE,\n  ) {\n    this.width = width;\n    this.height = height;\n    this.cellSize = cellSize;\n    this.bgColor = bgColor;\n    this.gridColor = gridColor;\n    this.terrain = new Array(width * height).fill(Terrain.Grass);\n  }\n\n  get indexSize(): number {\n    return this.width * this.height;\n  }\n\n  inBounds(gx: number, gy: number): boolean {\n    return gx >= 0 && gx < this.width && gy >= 0 && gy < this.height;\n  }\n\n  getTerrain(gx: number, gy: number): Terrain {\n    if (!this.inBounds(gx, gy)) return Terrain.Mountain;\n    return this.terrain[gy * this.width + gx];\n  }\n\n  setTerrain(gx: number, gy: number, t: Terrain): void {\n    if (!this.inBounds(gx, gy)) return;\n    this.terrain[gy * this.width + gx] = t;\n  }\n\n  // Check if a rect of cells is free for placement\n  isAreaFree(gx: number, gy: number, w: number, h: number, occupied: Set<string>): boolean {\n    for (let dy = 0; dy < h; dy++) {\n      for (let dx = 0; dx < w; dx++) {\n        const cx = gx + dx;\n        const cy = gy + dy;\n        if (!this.inBounds(cx, cy)) return false;\n        const t = this.getTerrain(cx, cy);\n        if (t === Terrain.Water || t === Terrain.Mountain) return false;\n        const key = `${cx},${cy}`;\n        if (occupied.has(key)) return false;\n      }\n    }\n    return true;\n  }\n\n  // Generate terrain for the starting area (炼气坪)\n  generateStartingArea(): void {\n    // Add some spirit veins (矿脉)\n    const veinPositions = [\n      [3, 2], [4, 2], [3, 3],\n      [14, 10], [15, 10], [15, 11],\n      [8, 7], [8, 8],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    // Add some water features\n    const waterPositions = [\n      [10, 1], [11, 1], [10, 2],\n      [1, 12], [2, 12], [1, 11],\n    ];\n    for (const [x, y] of waterPositions) {\n      this.setTerrain(x, y, Terrain.Water);\n    }\n\n    // Add path\n    for (let x = 5; x < 15; x++) {\n      this.setTerrain(x, 7, Terrain.Path);\n    }\n    for (let y = 3; y < 12; y++) {\n      this.setTerrain(10, y, Terrain.Path);\n    }\n\n    // Rich soil near center\n    for (let y = 5; y < 8; y++) {\n      for (let x = 6; x < 9; x++) {\n        this.setTerrain(x, y, Terrain.RichSoil);\n      }\n    }\n  }\n\n  // Generate terrain for a specific region type\n  generateRegionTerrain(regionId: string): void {\n    switch (regionId) {\n      case 'zhuji_platform':\n        this.generateZhujiPlatform();\n        break;\n      case 'medicine_valley':\n        this.generateMedicineValley();\n        break;\n      case 'core_peak':\n        this.generateCorePeak();\n        break;\n      case 'ore_mountain':\n        this.generateOreMountain();\n        break;\n      case 'spirit_field_area':\n        this.generateSpiritFieldArea();\n        break;\n      case 'mine_area':\n        this.generateMineArea();\n        break;\n      default:\n        this.generateStartingArea();\n    }\n  }\n\n  private generateZhujiPlatform(): void {\n    // 筑基台：灵铁+灵木丰富，中等大小\n    const veinPositions = [\n      [5, 3], [6, 3], [5, 4],\n      [20, 15], [21, 15], [21, 16],\n      [12, 10], [13, 10],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    // Rich soil patches\n    for (let y = 6; y < 12; y++) {\n      for (let x = 8; x < 14; x++) {\n        this.setTerrain(x, y, Terrain.RichSoil);\n      }\n    }\n\n    // Paths\n    for (let x = 4; x < 26; x++) {\n      this.setTerrain(x, 12, Terrain.Path);\n    }\n    for (let y = 4; y < 22; y++) {\n      this.setTerrain(15, y, Terrain.Path);\n    }\n\n    // Water features\n    this.setTerrain(2, 2, Terrain.Water);\n    this.setTerrain(3, 2, Terrain.Water);\n    this.setTerrain(2, 3, Terrain.Water);\n  }\n\n  private generateMedicineValley(): void {\n    // 药王谷：大量灵田，稀有灵草\n    for (let y = 3; y < 22; y++) {\n      for (let x = 3; x < 32; x++) {\n        if (Math.random() < 0.6) {\n          this.setTerrain(x, y, Terrain.RichSoil);\n        }\n      }\n    }\n\n    // Spirit veins at edges\n    const veinPositions = [\n      [1, 1], [33, 1], [1, 23], [33, 23],\n      [17, 12],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    // Central path\n    for (let x = 5; x < 30; x++) {\n      this.setTerrain(x, 12, Terrain.Path);\n    }\n  }\n\n  private generateCorePeak(): void {\n    // 丹鼎峰：炼丹圣地，岩石地形多\n    const veinPositions = [\n      [5, 5], [6, 5], [5, 6],\n      [28, 22], [29, 22], [29, 23],\n      [17, 14], [18, 14],\n      [10, 20], [24, 8],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    // Rocky terrain\n    for (let y = 2; y < 28; y += 4) {\n      for (let x = 2; x < 33; x += 5) {\n        if (Math.random() < 0.3) {\n          this.setTerrain(x, y, Terrain.Rock);\n        }\n      }\n    }\n\n    // Paths\n    for (let x = 3; x < 32; x++) {\n      this.setTerrain(x, 15, Terrain.Path);\n    }\n    for (let y = 3; y < 28; y++) {\n      this.setTerrain(17, y, Terrain.Path);\n    }\n  }\n\n  private generateOreMountain(): void {\n    // 矿脉山：大量矿脉，灵石/灵铁高产\n    const veinPositions = [\n      [4, 4], [5, 4], [4, 5],\n      [20, 5], [21, 5], [21, 6],\n      [35, 15], [36, 15], [36, 16],\n      [10, 20], [11, 20], [11, 21],\n      [28, 25], [29, 25], [29, 26],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    // Mountain terrain\n    for (let y = 0; y < 5; y++) {\n      for (let x = 0; x < this.width; x++) {\n        if (Math.random() < 0.4) this.setTerrain(x, y, Terrain.Mountain);\n      }\n    }\n\n    // Paths\n    for (let x = 5; x < 35; x++) {\n      this.setTerrain(x, 15, Terrain.Path);\n    }\n    for (let y = 5; y < 25; y++) {\n      this.setTerrain(20, y, Terrain.Path);\n    }\n  }\n\n  private generateSpiritFieldArea(): void {\n    // 灵田区：大量灵田资源\n    for (let y = 4; y < 16; y++) {\n      for (let x = 4; x < 21; x++) {\n        if (Math.random() < 0.5) {\n          this.setTerrain(x, y, Terrain.RichSoil);\n        }\n      }\n    }\n\n    const veinPositions = [\n      [2, 2], [22, 18],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    for (let x = 3; x < 22; x++) {\n      this.setTerrain(x, 10, Terrain.Path);\n    }\n  }\n\n  private generateMineArea(): void {\n    // 灵石矿区：大量矿脉\n    const veinPositions = [\n      [3, 3], [4, 3], [3, 4],\n      [15, 8], [16, 8], [16, 9],\n      [25, 15], [26, 15], [26, 16],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    for (let x = 5; x < 25; x++) {\n      this.setTerrain(x, 10, Terrain.Path);\n    }\n  }\n\n  // Render map terrain to canvas\n  render(\n    ctx: CanvasRenderingContext2D,\n    offsetX: number,\n    offsetY: number,\n    viewportW: number,\n    viewportH: number,\n    scale: number,\n  ): void {\n    const invScale = 1 / scale;\n    const startCol = Math.max(0, Math.floor(-offsetX * invScale / this.cellSize));\n    const startRow = Math.max(0, Math.floor(-offsetY * invScale / this.cellSize));\n    const endCol = Math.min(this.width, Math.ceil((-offsetX + viewportW) * invScale / this.cellSize) + 1);\n    const endRow = Math.min(this.height, Math.ceil((-offsetY + viewportH) * invScale / this.cellSize) + 1);\n\n    // Draw terrain cells\n    for (let row = startRow; row < endRow; row++) {\n      for (let col = startCol; col < endCol; col++) {\n        const x = offsetX + col * this.cellSize * scale;\n        const y = offsetY + row * this.cellSize * scale;\n        const size = this.cellSize * scale;\n\n        ctx.fillStyle = this.getTerrainColor(this.getTerrain(col, row));\n        ctx.fillRect(x, y, size, size);\n\n        // Draw grid line\n        ctx.strokeStyle = this.gridColor;\n        ctx.lineWidth = 0.5;\n        ctx.strokeRect(x, y, size, size);\n      }\n    }\n  }\n\n  private getTerrainColor(t: Terrain): string {\n    switch (t) {\n      case Terrain.Grass: return this.bgColor;\n      case Terrain.Rock: return '#3a3a4a';\n      case Terrain.Water: return '#1a3a5a';\n      case Terrain.RichSoil: return '#2a4a1a';\n      case Terrain.Mountain: return '#4a4a4a';\n      case Terrain.Path: return '#4a3a2a';\n      case Terrain.SpiritVein: return '#2a4a5a';\n      default: return this.bgColor;\n    }\n  }\n\n  // Screen coordinates to grid cell\n  screenToGrid(\n    screenX: number,\n    screenY: number,\n    offsetX: number,\n    offsetY: number,\n    scale: number,\n  ): { gx: number; gy: number } {\n    const invScale = 1 / scale;\n    const gx = Math.floor((screenX - offsetX) * invScale / this.cellSize);\n    const gy = Math.floor((screenY - offsetY) * invScale / this.cellSize);\n    return { gx, gy };\n  }\n\n  // Grid cell center to screen coordinates\n  gridToScreen(\n    gx: number,\n    gy: number,\n    offsetX: number,\n    offsetY: number,\n    scale: number,\n  ): { x: number; y: number } {\n    return {\n      x: offsetX + (gx + 0.5) * this.cellSize * scale,\n      y: offsetY + (gy + 0.5) * this.cellSize * scale,\n    };\n  }\n}\n","numLines":371,"startLine":1,"totalLines":371}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f613fc9e0a6b4839a885397f","type":"tool_result","content":"1\t// Cultivation.ts — Realm breakthrough and cultivation progression system\n2\t\n3\texport interface RealmDef {\n4\t  id: string;\n5\t  name: string;\n6\t  nameEn: string;\n7\t  subStages: string[];\n8\t  levelsPerStage: number;\n9\t  expBase: number;\n10\t  expGrowth: number;\n11\t  cultivationBaseRate: number;\n12\t  breakthroughCost: Record<string, number>;\n13\t  breakthroughPill?: string;\n14\t  breakthroughPillCount?: number;\n15\t  breakthroughSuccessRate: number;\n16\t  failPenaltyPercent: number;\n17\t  unlockContent: string[];\n18\t}\n19\t\n20\texport interface CultivationState {\n21\t  realmId: string;\n22\t  subStage: number;\n23\t  level: number;\n24\t  exp: number;\n25\t  expToNext: number;\n26\t  totalCultivation: number;\n27\t  cultivationRate: number;\n28\t  isAutoCultivating: boolean;\n29\t}\n30\t\n31\texport interface BreakthroughResult {\n32\t  success: boolean;\n33\t  oldRealm: string;\n34\t  newRealm: string;\n35\t  oldSubStage: number;\n36\t  newSubStage: number;\n37\t  penalty: number;\n38\t}\n39\t\n40\tconst REALM_ORDER = ['fanren', 'liqi', 'zhuji', 'jindan', 'yuanying', 'huashen'];\n41\t\n42\t// Total level calculation: subStage * levelsPerStage + level\n43\t// liqi: 3 stages × 4 levels = 1-12 (realm total 1-12)\n44\t// zhuji: 3 stages × 5 levels = 1-15 (realm total 13-27, game level 13-27)\n45\t// jindan: 4 stages × 5 levels = 1-20 (realm total 28-47, game level 28-47)\n46\t\n47\tconst REALM_DEFS: Record<string, RealmDef> = {\n48\t  fanren: {\n49\t    id: 'fanren',\n50\t    name: '凡人',\n51\t    nameEn: 'Mortal',\n52\t    subStages: ['凡人'],\n53\t    levelsPerStage: 1,\n54\t    expBase: 50,\n55\t    expGrowth: 1.0,\n56\t    cultivationBaseRate: 0,\n57\t    breakthroughCost: { spirit_stone: 10 },\n58\t    breakthroughSuccessRate: 1.0,\n59\t    failPenaltyPercent: 0,\n60\t    unlockContent: [],\n61\t  },\n62\t  liqi: {\n63\t    id: 'liqi',\n64\t    name: '炼气期',\n65\t    nameEn: 'Qi Refining',\n66\t    subStages: ['初期', '中期', '后期'],\n67\t    levelsPerStage: 4,\n68\t    expBase: 100,\n69\t    expGrowth: 1.8,\n70\t    cultivationBaseRate: 0.5,\n71\t    breakthroughCost: { spirit_stone: 200 },\n72\t    breakthroughPill: 'pill_juling',\n73\t    breakthroughPillCount: 5,\n74\t    breakthroughSuccessRate: 0.85,\n75\t    failPenaltyPercent: 0.2,\n76\t    unlockContent: ['灵石矿机', '灵田', '丹炉', '聚灵丹'],\n77\t  },\n78\t  zhuji: {\n79\t    id: 'zhuji',\n80\t    name: '筑基期',\n81\t    nameEn: 'Foundation Building',\n82\t    subStages: ['初期', '中期', '后期'],\n83\t    levelsPerStage: 5,\n84\t    expBase: 1000,\n85\t    expGrowth: 1.8,\n86\t    cultivationBaseRate: 2.0,\n87\t    breakthroughCost: { spirit_stone: 500 },\n88\t    breakthroughPill: 'pill_zhuji',\n89\t    breakthroughPillCount: 5,\n90\t    breakthroughSuccessRate: 0.75,\n91\t    failPenaltyPercent: 0.25,\n92\t    unlockContent: ['灵脉通道', '传送带', '筑基丹'],\n93\t  },\n94\t  jindan: {\n95\t    id: 'jindan',\n96\t    name: '金丹期',\n97\t    nameEn: 'Golden Core',\n98\t    subStages: ['初期', '中期', '后期', '圆满'],\n99\t    levelsPerStage: 5,\n100\t    expBase: 10000,\n101\t    expGrowth: 1.8,\n102\t    cultivationBaseRate: 10.0,\n103\t    breakthroughCost: { spirit_stone: 5000, spirit_iron: 10 },\n104\t    breakthroughPill: 'pill_jindanyin',\n105\t    breakthroughPillCount: 10,\n106\t    breakthroughSuccessRate: 0.70,\n107\t    failPenaltyPercent: 0.3,\n108\t    unlockContent: ['傀儡工人', '分拣器', '金丹引', '精炼炉', '传送阵'],\n109\t  },\n110\t};\n111\t\n112\texport function getRealmDef(realmId: string): RealmDef | undefined {\n113\t  return REALM_DEFS[realmId];\n114\t}\n115\t\n116\texport function getRealmOrder(): string[] {\n117\t  return REALM_ORDER;\n118\t}\n119\t\n120\texport function createInitialCultivationState(): CultivationState {\n121\t  return {\n122\t    realmId: 'fanren',\n123\t    subStage: 0,\n124\t    level: 1,\n125\t    exp: 0,\n126\t    expToNext: 50,\n127\t    totalCultivation: 0,\n128\t    cultivationRate: 0,\n129\t    isAutoCultivating: false,\n130\t  };\n131\t}\n132\t\n133\texport function getSubStageName(realmId: string, subStage: number): string {\n134\t  const def = REALM_DEFS[realmId];\n135\t  if (!def) return '';\n136\t  return def.subStages[subStage] ?? '';\n137\t}\n138\t\n139\texport function getFullRealmName(state: CultivationState): string {\n140\t  const def = REALM_DEFS[state.realmId];\n141\t  if (!def) return state.realmId;\n142\t  if (def.subStages.length === 1) return def.name;\n143\t  return `${def.name} ${def.subStages[state.subStage] ?? ''} Lv${state.level}`;\n144\t}\n145\t\n146\texport function getShortRealmName(state: CultivationState): string {\n147\t  const def = REALM_DEFS[state.realmId];\n148\t  if (!def) return state.realmId;\n149\t  return def.name;\n150\t}\n151\t\n152\t// Calculate exp needed for next level within current sub-stage\n153\texport function calcExpToNext(realmId: string, level: number): number {\n154\t  const def = REALM_DEFS[realmId];\n155\t  if (!def) return 100;\n156\t  return Math.floor(def.expBase * Math.pow(def.expGrowth, level - 1));\n157\t}\n158\t\n159\t// Add cultivation exp, handle level-ups within sub-stage\n160\texport function addCultivationExp(state: CultivationState, amount: number): CultivationState {\n161\t  const next = { ...state };\n162\t  next.exp += amount;\n163\t  next.totalCultivation += amount;\n164\t\n165\t  const def = REALM_DEFS[next.realmId];\n166\t  if (!def) return next;\n167\t\n168\t  while (next.exp >= next.expToNext) {\n169\t    next.exp -= next.expToNext;\n170\t    next.level += 1;\n171\t\n172\t    if (next.level > def.levelsPerStage) {\n173\t      // Can't auto-advance past sub-stage boundary — needs breakthrough\n174\t      next.level = def.levelsPerStage;\n175\t      next.exp = next.expToNext;\n176\t      break;\n177\t    }\n178\t\n179\t    next.expToNext = calcExpToNext(next.realmId, next.level);\n180\t  }\n181\t\n182\t  // Update cultivation rate based on realm\n183\t  next.cultivationRate = def.cultivationBaseRate;\n184\t\n185\t  return next;\n186\t}\n187\t\n188\t// Check if ready for sub-stage breakthrough\n189\texport function canBreakthrough(state: CultivationState): boolean {\n190\t  const def = REALM_DEFS[state.realmId];\n191\t  if (!def) return false;\n192\t\n193\t  // Must be at max level of current sub-stage\n194\t  if (state.level < def.levelsPerStage) return false;\n195\t  if (state.exp < state.expToNext) return false;\n196\t\n197\t  return true;\n198\t}\n199\t\n200\t// Check if can break through to next major realm\n201\texport function isRealmTransition(state: CultivationState): boolean {\n202\t  const def = REALM_DEFS[state.realmId];\n203\t  if (!def) return false;\n204\t  return state.subStage >= def.subStages.length - 1;\n205\t}\n206\t\n207\t// Get what's needed for breakthrough\n208\texport function getBreakthroughRequirements(state: CultivationState): {\n209\t  canAttempt: boolean;\n210\t  needsPill: boolean;\n211\t  pillId: string | null;\n212\t  pillCount: number;\n213\t  resourceCost: Record<string, number>;\n214\t  successRate: number;\n215\t} {\n216\t  const def = REALM_DEFS[state.realmId];\n217\t  if (!def) return { canAttempt: false, needsPill: false, pillId: null, pillCount: 0, resourceCost: {}, successRate: 0 };\n218\t\n219\t  const atMax = state.level >= def.levelsPerStage && state.exp >= state.expToNext;\n220\t\n221\t  return {\n222\t    canAttempt: atMax,\n223\t    needsPill: !!def.breakthroughPill,\n224\t    pillId: def.breakthroughPill ?? null,\n225\t    pillCount: def.breakthroughPillCount ?? 0,\n226\t    resourceCost: def.breakthroughCost,\n227\t    successRate: def.breakthroughSuccessRate,\n228\t  };\n229\t}\n230\t\n231\t// Attempt breakthrough. Pass in resources for cost check and deduction.\n232\texport function attemptBreakthrough(\n233\t  state: CultivationState,\n234\t  resources: Record<string, number>,\n235\t): { result: BreakthroughResult; newState: CultivationState; newResources: Record<string, number> } | null {\n236\t  const def = REALM_DEFS[state.realmId];\n237\t  if (!def) return null;\n238\t\n239\t  if (!canBreakthrough(state)) return null;\n240\t\n241\t  // Check resources\n242\t  const costs = def.breakthroughCost;\n243\t  for (const [res, amount] of Object.entries(costs)) {\n244\t    if ((resources[res] ?? 0) < amount) return null;\n245\t  }\n246\t\n247\t  // Check pill requirement\n248\t  if (def.breakthroughPill && def.breakthroughPillCount) {\n249\t    if ((resources[def.breakthroughPill] ?? 0) < def.breakthroughPillCount) return null;\n250\t  }\n251\t\n252\t  // Deduct costs\n253\t  const newResources = { ...resources };\n254\t  for (const [res, amount] of Object.entries(costs)) {\n255\t    newResources[res] = (newResources[res] ?? 0) - amount;\n256\t  }\n257\t  if (def.breakthroughPill && def.breakthroughPillCount) {\n258\t    newResources[def.breakthroughPill] = (newResources[def.breakthroughPill] ?? 0) - def.breakthroughPillCount;\n259\t  }\n260\t\n261\t  // Roll for success\n262\t  const roll = Math.random();\n263\t  const success = roll < def.breakthroughSuccessRate;\n264\t\n265\t  const newState = { ...state };\n266\t\n267\t  if (success) {\n268\t    const isTransition = isRealmTransition(state);\n269\t\n270\t    if (isTransition) {\n271\t      // Move to next major realm\n272\t      const currentIdx = REALM_ORDER.indexOf(state.realmId);\n273\t      const nextRealmId = REALM_ORDER[currentIdx + 1] ?? state.realmId;\n274\t      const nextDef = REALM_DEFS[nextRealmId];\n275\t\n276\t      newState.realmId = nextRealmId;\n277\t      newState.subStage = 0;\n278\t      newState.level = 1;\n279\t      newState.exp = 0;\n280\t      newState.expToNext = nextDef ? nextDef.expBase : 100;\n281\t      newState.cultivationRate = nextDef?.cultivationBaseRate ?? 0;\n282\t    } else {\n283\t      // Advance sub-stage within same realm\n284\t      newState.subStage = state.subStage + 1;\n285\t      newState.level = 1;\n286\t      newState.exp = 0;\n287\t      newState.expToNext = calcExpToNext(state.realmId, 1);\n288\t    }\n289\t\n290\t    return {\n291\t      result: {\n292\t        success: true,\n293\t        oldRealm: state.realmId,\n294\t        newRealm: newState.realmId,\n295\t        oldSubStage: state.subStage,\n296\t        newSubStage: newState.subStage,\n297\t        penalty: 0,\n298\t      },\n299\t      newState,\n300\t      newResources,\n301\t    };\n302\t  } else {\n303\t    // Failure: reduce exp by penalty\n304\t    const penalty = def.failPenaltyPercent;\n305\t    const expLoss = Math.floor(newState.totalCultivation * penalty);\n306\t    newState.exp = Math.max(0, newState.exp - expLoss);\n307\t    newState.totalCultivation = Math.max(0, newState.totalCultivation - expLoss);\n308\t\n309\t    return {\n310\t      result: {\n311\t        success: false,\n312\t        oldRealm: state.realmId,\n313\t        newRealm: state.realmId,\n314\t        oldSubStage: state.subStage,\n315\t        newSubStage: state.subStage,\n316\t        penalty: penalty,\n317\t      },\n318\t      newState,\n319\t      newResources,\n320\t    };\n321\t  }\n322\t}\n323\t\n324\t// Auto-cultivation tick (called each game tick)\n325\texport function tickAutoCultivation(state: CultivationState, dtMs: number): CultivationState {\n326\t  if (state.cultivationRate <= 0) return state;\n327\t\n328\t  const amount = state.cultivationRate * (dtMs / 1000);\n329\t  return addCultivationExp(state, amount);\n330\t}\n331\t\n332\t// Convert from old RealmProgress format to new CultivationState\n333\texport function migrateFromOldRealm(oldRealm: {\n334\t  realmId: string;\n335\t  level: number;\n336\t  exp: number;\n337\t  expToNext: number;\n338\t}): CultivationState {\n339\t  // Map old 'liqi' level to sub-stage + level\n340\t  let subStage = 0;\n341\t  let level = oldRealm.level;\n342\t  const levelsPerStage = 4;\n343\t\n344\t  if (level > levelsPerStage) {\n345\t    subStage = Math.floor((level - 1) / levelsPerStage);\n346\t    level = ((level - 1) % levelsPerStage) + 1;\n347\t  }\n348\t\n349\t  return {\n350\t    realmId: oldRealm.realmId,\n351\t    subStage: Math.min(subStage, 2),\n352\t    level,\n353\t    exp: oldRealm.exp,\n354\t    expToNext: oldRealm.expToNext,\n355\t    totalCultivation: oldRealm.exp,\n356\t    cultivationRate: oldRealm.realmId === 'liqi' ? 0.5 : 0,\n357\t    isAutoCultivating: false,\n358\t  };\n359\t}\n360\t\n361\t// Get realm index for comparison\n362\texport function getRealmIndex(realmId: string): number {\n363\t  return REALM_ORDER.indexOf(realmId);\n364\t}\n365\t\n366\t// Compare realm requirements: e.g. \"liqi_5\" vs \"liqi_3\" → true\n367\texport function isRealmUnlocked(required: string, cultivation: CultivationState): boolean {\n368\t  const [rRealm, rLevel] = required.split('_');\n369\t  const rRealmIdx = REALM_ORDER.indexOf(rRealm);\n370\t  const cRealmIdx = REALM_ORDER.indexOf(cultivation.realmId);\n371\t\n372\t  if (cRealmIdx > rRealmIdx) return true;\n373\t  if (cRealmIdx < rRealmIdx) return false;\n374\t\n375\t  // Same realm: compare total level\n376\t  const def = REALM_DEFS[cultivation.realmId];\n377\t  const totalLevel = cultivation.subStage * (def?.levelsPerStage ?? 4) + cultivation.level;\n378\t  return totalLevel >= parseInt(rLevel);\n379\t}\n380\t"}]},"parent_tool_use_id":null,"session_id":"b5917fbe-2c6f-4545-ae5f-396daf206080","uuid":"4a41a294-e5d9-4db6-9a2e-9aa1a5c72d5a","timestamp":"2026-05-23T02:11:15.169Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Cultivation.ts","content":"// Cultivation.ts — Realm breakthrough and cultivation progression system\n\nexport interface RealmDef {\n  id: string;\n  name: string;\n  nameEn: string;\n  subStages: string[];\n  levelsPerStage: number;\n  expBase: number;\n  expGrowth: number;\n  cultivationBaseRate: number;\n  breakthroughCost: Record<string, number>;\n  breakthroughPill?: string;\n  breakthroughPillCount?: number;\n  breakthroughSuccessRate: number;\n  failPenaltyPercent: number;\n  unlockContent: string[];\n}\n\nexport interface CultivationState {\n  realmId: string;\n  subStage: number;\n  level: number;\n  exp: number;\n  expToNext: number;\n  totalCultivation: number;\n  cultivationRate: number;\n  isAutoCultivating: boolean;\n}\n\nexport interface BreakthroughResult {\n  success: boolean;\n  oldRealm: string;\n  newRealm: string;\n  oldSubStage: number;\n  newSubStage: number;\n  penalty: number;\n}\n\nconst REALM_ORDER = ['fanren', 'liqi', 'zhuji', 'jindan', 'yuanying', 'huashen'];\n\n// Total level calculation: subStage * levelsPerStage + level\n// liqi: 3 stages × 4 levels = 1-12 (realm total 1-12)\n// zhuji: 3 stages × 5 levels = 1-15 (realm total 13-27, game level 13-27)\n// jindan: 4 stages × 5 levels = 1-20 (realm total 28-47, game level 28-47)\n\nconst REALM_DEFS: Record<string, RealmDef> = {\n  fanren: {\n    id: 'fanren',\n    name: '凡人',\n    nameEn: 'Mortal',\n    subStages: ['凡人'],\n    levelsPerStage: 1,\n    expBase: 50,\n    expGrowth: 1.0,\n    cultivationBaseRate: 0,\n    breakthroughCost: { spirit_stone: 10 },\n    breakthroughSuccessRate: 1.0,\n    failPenaltyPercent: 0,\n    unlockContent: [],\n  },\n  liqi: {\n    id: 'liqi',\n    name: '炼气期',\n    nameEn: 'Qi Refining',\n    subStages: ['初期', '中期', '后期'],\n    levelsPerStage: 4,\n    expBase: 100,\n    expGrowth: 1.8,\n    cultivationBaseRate: 0.5,\n    breakthroughCost: { spirit_stone: 200 },\n    breakthroughPill: 'pill_juling',\n    breakthroughPillCount: 5,\n    breakthroughSuccessRate: 0.85,\n    failPenaltyPercent: 0.2,\n    unlockContent: ['灵石矿机', '灵田', '丹炉', '聚灵丹'],\n  },\n  zhuji: {\n    id: 'zhuji',\n    name: '筑基期',\n    nameEn: 'Foundation Building',\n    subStages: ['初期', '中期', '后期'],\n    levelsPerStage: 5,\n    expBase: 1000,\n    expGrowth: 1.8,\n    cultivationBaseRate: 2.0,\n    breakthroughCost: { spirit_stone: 500 },\n    breakthroughPill: 'pill_zhuji',\n    breakthroughPillCount: 5,\n    breakthroughSuccessRate: 0.75,\n    failPenaltyPercent: 0.25,\n    unlockContent: ['灵脉通道', '传送带', '筑基丹'],\n  },\n  jindan: {\n    id: 'jindan',\n    name: '金丹期',\n    nameEn: 'Golden Core',\n    subStages: ['初期', '中期', '后期', '圆满'],\n    levelsPerStage: 5,\n    expBase: 10000,\n    expGrowth: 1.8,\n    cultivationBaseRate: 10.0,\n    breakthroughCost: { spirit_stone: 5000, spirit_iron: 10 },\n    breakthroughPill: 'pill_jindanyin',\n    breakthroughPillCount: 10,\n    breakthroughSuccessRate: 0.70,\n    failPenaltyPercent: 0.3,\n    unlockContent: ['傀儡工人', '分拣器', '金丹引', '精炼炉', '传送阵'],\n  },\n};\n\nexport function getRealmDef(realmId: string): RealmDef | undefined {\n  return REALM_DEFS[realmId];\n}\n\nexport function getRealmOrder(): string[] {\n  return REALM_ORDER;\n}\n\nexport function createInitialCultivationState(): CultivationState {\n  return {\n    realmId: 'fanren',\n    subStage: 0,\n    level: 1,\n    exp: 0,\n    expToNext: 50,\n    totalCultivation: 0,\n    cultivationRate: 0,\n    isAutoCultivating: false,\n  };\n}\n\nexport function getSubStageName(realmId: string, subStage: number): string {\n  const def = REALM_DEFS[realmId];\n  if (!def) return '';\n  return def.subStages[subStage] ?? '';\n}\n\nexport function getFullRealmName(state: CultivationState): string {\n  const def = REALM_DEFS[state.realmId];\n  if (!def) return state.realmId;\n  if (def.subStages.length === 1) return def.name;\n  return `${def.name} ${def.subStages[state.subStage] ?? ''} Lv${state.level}`;\n}\n\nexport function getShortRealmName(state: CultivationState): string {\n  const def = REALM_DEFS[state.realmId];\n  if (!def) return state.realmId;\n  return def.name;\n}\n\n// Calculate exp needed for next level within current sub-stage\nexport function calcExpToNext(realmId: string, level: number): number {\n  const def = REALM_DEFS[realmId];\n  if (!def) return 100;\n  return Math.floor(def.expBase * Math.pow(def.expGrowth, level - 1));\n}\n\n// Add cultivation exp, handle level-ups within sub-stage\nexport function addCultivationExp(state: CultivationState, amount: number): CultivationState {\n  const next = { ...state };\n  next.exp += amount;\n  next.totalCultivation += amount;\n\n  const def = REALM_DEFS[next.realmId];\n  if (!def) return next;\n\n  while (next.exp >= next.expToNext) {\n    next.exp -= next.expToNext;\n    next.level += 1;\n\n    if (next.level > def.levelsPerStage) {\n      // Can't auto-advance past sub-stage boundary — needs breakthrough\n      next.level = def.levelsPerStage;\n      next.exp = next.expToNext;\n      break;\n    }\n\n    next.expToNext = calcExpToNext(next.realmId, next.level);\n  }\n\n  // Update cultivation rate based on realm\n  next.cultivationRate = def.cultivationBaseRate;\n\n  return next;\n}\n\n// Check if ready for sub-stage breakthrough\nexport function canBreakthrough(state: CultivationState): boolean {\n  const def = REALM_DEFS[state.realmId];\n  if (!def) return false;\n\n  // Must be at max level of current sub-stage\n  if (state.level < def.levelsPerStage) return false;\n  if (state.exp < state.expToNext) return false;\n\n  return true;\n}\n\n// Check if can break through to next major realm\nexport function isRealmTransition(state: CultivationState): boolean {\n  const def = REALM_DEFS[state.realmId];\n  if (!def) return false;\n  return state.subStage >= def.subStages.length - 1;\n}\n\n// Get what's needed for breakthrough\nexport function getBreakthroughRequirements(state: CultivationState): {\n  canAttempt: boolean;\n  needsPill: boolean;\n  pillId: string | null;\n  pillCount: number;\n  resourceCost: Record<string, number>;\n  successRate: number;\n} {\n  const def = REALM_DEFS[state.realmId];\n  if (!def) return { canAttempt: false, needsPill: false, pillId: null, pillCount: 0, resourceCost: {}, successRate: 0 };\n\n  const atMax = state.level >= def.levelsPerStage && state.exp >= state.expToNext;\n\n  return {\n    canAttempt: atMax,\n    needsPill: !!def.breakthroughPill,\n    pillId: def.breakthroughPill ?? null,\n    pillCount: def.breakthroughPillCount ?? 0,\n    resourceCost: def.breakthroughCost,\n    successRate: def.breakthroughSuccessRate,\n  };\n}\n\n// Attempt breakthrough. Pass in resources for cost check and deduction.\nexport function attemptBreakthrough(\n  state: CultivationState,\n  resources: Record<string, number>,\n): { result: BreakthroughResult; newState: CultivationState; newResources: Record<string, number> } | null {\n  const def = REALM_DEFS[state.realmId];\n  if (!def) return null;\n\n  if (!canBreakthrough(state)) return null;\n\n  // Check resources\n  const costs = def.breakthroughCost;\n  for (const [res, amount] of Object.entries(costs)) {\n    if ((resources[res] ?? 0) < amount) return null;\n  }\n\n  // Check pill requirement\n  if (def.breakthroughPill && def.breakthroughPillCount) {\n    if ((resources[def.breakthroughPill] ?? 0) < def.breakthroughPillCount) return null;\n  }\n\n  // Deduct costs\n  const newResources = { ...resources };\n  for (const [res, amount] of Object.entries(costs)) {\n    newResources[res] = (newResources[res] ?? 0) - amount;\n  }\n  if (def.breakthroughPill && def.breakthroughPillCount) {\n    newResources[def.breakthroughPill] = (newResources[def.breakthroughPill] ?? 0) - def.breakthroughPillCount;\n  }\n\n  // Roll for success\n  const roll = Math.random();\n  const success = roll < def.breakthroughSuccessRate;\n\n  const newState = { ...state };\n\n  if (success) {\n    const isTransition = isRealmTransition(state);\n\n    if (isTransition) {\n      // Move to next major realm\n      const currentIdx = REALM_ORDER.indexOf(state.realmId);\n      const nextRealmId = REALM_ORDER[currentIdx + 1] ?? state.realmId;\n      const nextDef = REALM_DEFS[nextRealmId];\n\n      newState.realmId = nextRealmId;\n      newState.subStage = 0;\n      newState.level = 1;\n      newState.exp = 0;\n      newState.expToNext = nextDef ? nextDef.expBase : 100;\n      newState.cultivationRate = nextDef?.cultivationBaseRate ?? 0;\n    } else {\n      // Advance sub-stage within same realm\n      newState.subStage = state.subStage + 1;\n      newState.level = 1;\n      newState.exp = 0;\n      newState.expToNext = calcExpToNext(state.realmId, 1);\n    }\n\n    return {\n      result: {\n        success: true,\n        oldRealm: state.realmId,\n        newRealm: newState.realmId,\n        oldSubStage: state.subStage,\n        newSubStage: newState.subStage,\n        penalty: 0,\n      },\n      newState,\n      newResources,\n    };\n  } else {\n    // Failure: reduce exp by penalty\n    const penalty = def.failPenaltyPercent;\n    const expLoss = Math.floor(newState.totalCultivation * penalty);\n    newState.exp = Math.max(0, newState.exp - expLoss);\n    newState.totalCultivation = Math.max(0, newState.totalCultivation - expLoss);\n\n    return {\n      result: {\n        success: false,\n        oldRealm: state.realmId,\n        newRealm: state.realmId,\n        oldSubStage: state.subStage,\n        newSubStage: state.subStage,\n        penalty: penalty,\n      },\n      newState,\n      newResources,\n    };\n  }\n}\n\n// Auto-cultivation tick (called each game tick)\nexport function tickAutoCultivation(state: CultivationState, dtMs: number): CultivationState {\n  if (state.cultivationRate <= 0) return state;\n\n  const amount = state.cultivationRate * (dtMs / 1000);\n  return addCultivationExp(state, amount);\n}\n\n// Convert from old RealmProgress format to new CultivationState\nexport function migrateFromOldRealm(oldRealm: {\n  realmId: string;\n  level: number;\n  exp: number;\n  expToNext: number;\n}): CultivationState {\n  // Map old 'liqi' level to sub-stage + level\n  let subStage = 0;\n  let level = oldRealm.level;\n  const levelsPerStage = 4;\n\n  if (level > levelsPerStage) {\n    subStage = Math.floor((level - 1) / levelsPerStage);\n    level = ((level - 1) % levelsPerStage) + 1;\n  }\n\n  return {\n    realmId: oldRealm.realmId,\n    subStage: Math.min(subStage, 2),\n    level,\n    exp: oldRealm.exp,\n    expToNext: oldRealm.expToNext,\n    totalCultivation: oldRealm.exp,\n    cultivationRate: oldRealm.realmId === 'liqi' ? 0.5 : 0,\n    isAutoCultivating: false,\n  };\n}\n\n// Get realm index for comparison\nexport function getRealmIndex(realmId: string): number {\n  return REALM_ORDER.indexOf(realmId);\n}\n\n// Compare realm requirements: e.g. \"liqi_5\" vs \"liqi_3\" → true\nexport function isRealmUnlocked(required: string, cultivation: CultivationState): boolean {\n  const [rRealm, rLevel] = required.split('_');\n  const rRealmIdx = REALM_ORDER.indexOf(rRealm);\n  const cRealmIdx = REALM_ORDER.indexOf(cultivation.realmId);\n\n  if (cRealmIdx > rRealmIdx) return true;\n  if (cRealmIdx < rRealmIdx) return false;\n\n  // Same realm: compare total level\n  const def = REALM_DEFS[cultivation.realmId];\n  const totalLevel = cultivation.subStage * (def?.levelsPerStage ?? 4) + cultivation.level;\n  return totalLevel >= parseInt(rLevel);\n}\n","numLines":380,"startLine":1,"totalLines":380}}}
