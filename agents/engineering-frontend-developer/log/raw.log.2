text","file":{"filePath":"D:/game-projects/douyin-match3/src/js/Board.js","content":"// Board.js — 8x8 grid state management\nconst TILE_COLORS = 6;\nconst BOARD_SIZE = 8;\nconst EMPTY = -1;\n\nconst COLOR_MAP = {\n  0: { name: 'apple',   hex: '#FF4D4D', label: '红' },\n  1: { name: 'banana',  hex: '#FFD93D', label: '黄' },\n  2: { name: 'blueberry', hex: '#4DA6FF', label: '蓝' },\n  3: { name: 'lime',    hex: '#6BCB77', label: '绿' },\n  4: { name: 'grape',   hex: '#B47AEA', label: '紫' },\n  5: { name: 'orange',  hex: '#FF9A3C', label: '橙' },\n};\n\n// Special tile types\nconst SPECIAL_NONE = 0;\nconst SPECIAL_STRIPED_H = 1;  // horizontal stripe bomb\nconst SPECIAL_STRIPED_V = 2;  // vertical stripe bomb\nconst SPECIAL_BOMB = 3;       // 3x3 area bomb\nconst SPECIAL_RAINBOW = 4;    // clears all of one color\n\nclass Tile {\n  constructor(color, row, col) {\n    this.color = color;\n    this.row = row;\n    this.col = col;\n    this.special = SPECIAL_NONE;\n    this.removing = false;\n    this.offsetY = 0;\n    this.offsetX = 0;\n    this.scale = 1;\n    this.alpha = 1;\n    this.selected = false;\n    this.id = Tile._nextId++;\n  }\n  get type() { return this.color; }\n}\n\nTile._nextId = 0;\n\nclass Board {\n  constructor(size = BOARD_SIZE, numColors = TILE_COLORS) {\n    this.size = size;\n    this.numColors = numColors;\n    this.grid = [];\n    this.listeners = [];\n  }\n\n  init() {\n    this.grid = [];\n    for (let r = 0; r < this.size; r++) {\n      this.grid[r] = [];\n      for (let c = 0; c < this.size; c++) {\n        this.grid[r][c] = this._createTile(r, c);\n      }\n    }\n    // Ensure no initial matches\n    this._removeInitialMatches();\n  }\n\n  _createTile(row, col) {\n    return new Tile(this._randomColor(), row, col);\n  }\n\n  _randomColor() {\n    return Math.floor(Math.random() * this.numColors);\n  }\n\n  _removeInitialMatches() {\n    let maxIter = 1000;\n    while (this._hasMatch() && maxIter-- > 0) {\n      const matches = this.findAllMatches();\n      for (const group of matches) {\n        for (const { row, col } of group.cells) {\n          this.grid[row][col] = this._createTile(row, col);\n        }\n      }\n    }\n  }\n\n  _hasMatch() {\n    return this.findAllMatches().length > 0;\n  }\n\n  getTile(r, c) {\n    if (r < 0 || r >= this.size || c < 0 || c >= this.size) return null;\n    return this.grid[r][c];\n  }\n\n  setTile(r, c, tile) {\n    if (r >= 0 && r < this.size && c >= 0 && c < this.size) {\n      tile.row = r;\n      tile.col = c;\n      this.grid[r][c] = tile;\n    }\n  }\n\n  swap(r1, c1, r2, c2) {\n    const a = this.grid[r1][c1];\n    const b = this.grid[r2][c2];\n    this.grid[r1][c1] = b;\n    this.grid[r2][c2] = a;\n    if (a) { a.row = r2; a.col = c2; }\n    if (b) { b.row = r1; b.col = c1; }\n  }\n\n  removeTile(r, c) {\n    const tile = this.grid[r][c];\n    if (tile) tile.removing = true;\n    return tile;\n  }\n\n  clearCell(r, c) {\n    this.grid[r][c] = null;\n  }\n\n  isValid(r, c) {\n    return r >= 0 && r < this.size && c >= 0 && c < this.size;\n  }\n\n  isAdjacent(r1, c1, r2, c2) {\n    const dr = Math.abs(r1 - r2);\n    const dc = Math.abs(c1 - c2);\n    return (dr + dc) === 1;\n  }\n\n  // Find all horizontal and vertical matches of length >= 3\n  findAllMatches() {\n    const matches = [];\n\n    // Horizontal scan\n    for (let r = 0; r < this.size; r++) {\n      let start = 0;\n      for (let c = 1; c <= this.size; c++) {\n        const cur = c < this.size ? this.grid[r][c] : null;\n        const prev = this.grid[r][start];\n        if (c < this.size && cur && prev && cur.color === prev.color && cur.color !== EMPTY) {\n          continue;\n        }\n        const len = c - start;\n        if (len >= 3 && prev && prev.color !== EMPTY) {\n          const cells = [];\n          for (let k = start; k < c; k++) cells.push({ row: r, col: k });\n          matches.push({ cells, length: len, direction: 'horizontal', color: prev.color });\n        }\n        start = c;\n      }\n    }\n\n    // Vertical scan\n    for (let c = 0; c < this.size; c++) {\n      let start = 0;\n      for (let r = 1; r <= this.size; r++) {\n        const cur = r < this.size ? this.grid[r][c] : null;\n        const prev = this.grid[start][c];\n        if (r < this.size && cur && prev && cur.color === prev.color && cur.color !== EMPTY) {\n          continue;\n        }\n        const len = r - start;\n        if (len >= 3 && prev && prev.color !== EMPTY) {\n          const cells = [];\n          for (let k = start; k < r; k++) cells.push({ row: k, col: c });\n          matches.push({ cells, length: len, direction: 'vertical', color: prev.color });\n        }\n        start = r;\n      }\n    }\n\n    return matches;\n  }\n\n  // Detect L/T shape matches by finding intersections of horizontal and vertical matches\n  findLShapeMatches(matches) {\n    const lShapes = [];\n    for (let i = 0; i < matches.length; i++) {\n      for (let j = i + 1; j < matches.length; j++) {\n        const a = matches[i], b = matches[j];\n        if (a.direction === b.direction) continue;\n        if (a.color !== b.color) continue;\n        // Find intersection\n        const setA = new Set(a.cells.map(c => `${c.row},${c.col}`));\n        for (const cell of b.cells) {\n          if (setA.has(`${cell.row},${cell.col}`)) {\n            // L/T shape found — merge all cells\n            const allCellsMap = {};\n            for (const c of a.cells) allCellsMap[`${c.row},${c.col}`] = c;\n            for (const c of b.cells) allCellsMap[`${c.row},${c.col}`] = c;\n            const allCells = Object.values(allCellsMap);\n            lShapes.push({ cells: allCells, color: a.color });\n          }\n        }\n      }\n    }\n    return lShapes;\n  }\n\n  // Apply gravity: move tiles down to fill empty cells\n  applyGravity() {\n    const drops = [];\n    for (let c = 0; c < this.size; c++) {\n      let writeRow = this.size - 1;\n      for (let r = this.size - 1; r >= 0; r--) {\n        if (this.grid[r][c] !== null) {\n          if (r !== writeRow) {\n            const tile = this.grid[r][c];\n            const fromRow = r;\n            this.grid[r][c] = null;\n            this.grid[writeRow][c] = tile;\n            const distance = writeRow - fromRow;\n            tile.row = writeRow;\n            drops.push({ tile, fromRow, toRow: writeRow, col: c, distance });\n          }\n          writeRow--;\n        }\n      }\n      // Fill empty top cells\n      for (let r = writeRow; r >= 0; r--) {\n        const tile = this._createTile(r, c);\n        tile.offsetY = -(writeRow - r + 1); // start above board\n        this.grid[r][c] = tile;\n        drops.push({ tile, fromRow: -(writeRow - r + 1), toRow: r, col: c, distance: r + (writeRow - r + 1) });\n      }\n    }\n    return drops;\n  }\n\n  // Check if any valid move exists (for deadlock detection)\n  hasValidMoves() {\n    for (let r = 0; r < this.size; r++) {\n      for (let c = 0; c < this.size; c++) {\n        // Try swap right\n        if (c + 1 < this.size) {\n          this.swap(r, c, r, c + 1);\n          const has = this.findAllMatches().length > 0;\n          this.swap(r, c, r, c + 1);\n          if (has) return true;\n        }\n        // Try swap down\n        if (r + 1 < this.size) {\n          this.swap(r, c, r + 1, c);\n          const has = this.findAllMatches().length > 0;\n          this.swap(r, c, r + 1, c);\n          if (has) return true;\n        }\n      }\n    }\n    return false;\n  }\n\n  // Shuffle board if no valid moves\n  shuffle() {\n    const tiles = [];\n    for (let r = 0; r < this.size; r++) {\n      for (let c = 0; c < this.size; c++) {\n        tiles.push(this.grid[r][c].color);\n      }\n    }\n    // Fisher-Yates shuffle\n    for (let i = tiles.length - 1; i > 0; i--) {\n      const j = Math.floor(Math.random() * (i + 1));\n      [tiles[i], tiles[j]] = [tiles[j], tiles[i]];\n    }\n    let idx = 0;\n    for (let r = 0; r < this.size; r++) {\n      for (let c = 0; c < this.size; c++) {\n        this.grid[r][c].color = tiles[idx++];\n      }\n    }\n    // Remove any initial matches from shuffle\n    this._removeInitialMatches();\n    // If still no valid moves, re-init\n    if (!this.hasValidMoves()) {\n      this.init();\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Board, Tile, BOARD_SIZE, TILE_COLORS, SPECIAL_NONE, SPECIAL_STRIPED_H, SPECIAL_STRIPED_V, SPECIAL_BOMB, SPECIAL_RAINBOW, COLOR_MAP };\n","numLines":279,"startLine":1,"totalLines":279}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_544ca20daa724e6b82d66298","type":"tool_result","content":"1\t// Game.js — Main game loop, state machine, ties all modules together\n2\t\n3\tconst STATES = {\n4\t  MENU: 'menu',\n5\t  IDLE: 'idle',\n6\t  SWAPPING: 'swapping',\n7\t  MATCHING: 'matching',\n8\t  REMOVING: 'removing',\n9\t  DROPPING: 'dropping',\n10\t  RESULT: 'result',\n11\t};\n12\t\n13\tclass Game {\n14\t  constructor(canvas) {\n15\t    this.canvas = canvas;\n16\t    this.board = new Board();\n17\t    this.matchEngine = new MatchEngine(this.board);\n18\t    this.renderer = new Renderer(canvas);\n19\t    this.input = new InputHandler(canvas, this.board);\n20\t    this.scoreSystem = new ScoreSystem();\n21\t    this.tweens = new TweenManager();\n22\t    this.particles = new ParticleSystem();\n23\t    this.levels = generateLevels();\n24\t    this.currentLevel = 0;\n25\t    this.state = STATES.MENU;\n26\t    this.comboText = '';\n27\t    this.comboTimer = 0;\n28\t    this.lastTime = 0;\n29\t    this.animationQueue = [];\n30\t\n31\t    this.renderer.particleSystem = this.particles;\n32\t\n33\t    this._setupInput();\n34\t    this._setupScoreCallbacks();\n35\t  }\n36\t\n37\t  _setupInput() {\n38\t    this.input.onSwap = (r1, c1, r2, c2) => this._handleSwap(r1, c1, r2, c2);\n39\t    this.input.onTap = (row, col) => this._handleTap(row, col);\n40\t  }\n41\t\n42\t  _setupScoreCallbacks() {\n43\t    this.scoreSystem.onLevelComplete = (score, stars) => {\n44\t      this.state = STATES.RESULT;\n45\t      this.resultData = { won: true, score, stars, level: this.currentLevel + 1 };\n46\t    };\n47\t    this.scoreSystem.onLevelFail = (score) => {\n48\t      this.state = STATES.RESULT;\n49\t      this.resultData = { won: false, score, stars: 0, level: this.currentLevel + 1 };\n50\t    };\n51\t  }\n52\t\n53\t  start() {\n54\t    this._loadLevel(0);\n55\t    this.state = STATES.IDLE;\n56\t    this.lastTime = performance.now();\n57\t    this._loop();\n58\t  }\n59\t\n60\t  _loadLevel(idx) {\n61\t    this.currentLevel = idx;\n62\t    const config = this.levels[idx] || this.levels[0];\n63\t    this.board.init();\n64\t    this.scoreSystem.reset(idx + 1);\n65\t    this.scoreSystem.configure(config);\n66\t    this.input.updateLayout(\n67\t      this.renderer.tileSize,\n68\t      this.renderer.boardX,\n69\t      this.renderer.boardY,\n70\t    );\n71\t    this.tweens.clear();\n72\t    this.particles.particles = [];\n73\t    this.renderer.floatingTexts = [];\n74\t    this.comboText = '';\n75\t    this.resultData = null;\n76\t  }\n77\t\n78\t  _handleTap(row, col) {\n79\t    if (this.state !== STATES.IDLE) return;\n80\t    const tile = this.board.getTile(row, col);\n81\t    if (!tile) return;\n82\t\n83\t    // Rainbow special: tap to activate\n84\t    if (tile.special !== SPECIAL_NONE) {\n85\t      // For now, rainbow on tap picks a random color\n86\t      // In full game, this would be from the swapped tile's color\n87\t      return;\n88\t    }\n89\t  }\n90\t\n91\t  _handleSwap(r1, c1, r2, c2) {\n92\t    if (this.state !== STATES.IDLE) return;\n93\t\n94\t    // Check if any special tile combination\n95\t    const tileA = this.board.getTile(r1, c1);\n96\t    const tileB = this.board.getTile(r2, c2);\n97\t\n98\t    if (tileA && tileA.special === SPECIAL_RAINBOW) {\n99\t      this._activateRainbow(r1, c1, tileB ? tileB.color : 0, r2, c2);\n100\t      return;\n101\t    }\n102\t    if (tileB && tileB.special === SPECIAL_RAINBOW) {\n103\t      this._activateRainbow(r2, c2, tileA ? tileA.color : 0, r1, c1);\n104\t      return;\n105\t    }\n106\t\n107\t    if (!this.matchEngine.isValidSwap(r1, c1, r2, c2)) return;\n108\t    if (!this.scoreSystem.useMove()) return;\n109\t\n110\t    this.state = STATES.SWAPPING;\n111\t    this.board.swap(r1, c1, r2, c2);\n112\t\n113\t    // Animate swap\n114\t    this._animateSwap(r1, c1, r2, c2, () => {\n115\t      this._processMatches();\n116\t    });\n117\t  }\n118\t\n119\t  _animateSwap(r1, c1, r2, c2, callback) {\n120\t    const tileSize = this.renderer.tileSize;\n121\t    const tileA = this.board.getTile(r2, c2); // After swap, tileA is at (r2,c2)\n122\t    const tileB = this.board.getTile(r1, c1);\n123\t\n124\t    const dx = (c2 - c1) * tileSize;\n125\t    const dy = (r2 - r1) * tileSize;\n126\t\n127\t    if (tileA) {\n128\t      tileA.offsetX = -dx;\n129\t      tileA.offsetY = -dy;\n130\t      this.tweens.add(tileA, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n131\t    }\n132\t    if (tileB) {\n133\t      tileB.offsetX = dx;\n134\t      tileB.offsetY = dy;\n135\t      this.tweens.add(tileB, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n136\t    }\n137\t\n138\t    setTimeout(callback, 160);\n139\t  }\n140\t\n141\t  _activateRainbow(rainbowRow, rainbowCol, targetColor, otherRow, otherCol) {\n142\t    if (!this.scoreSystem.useMove()) return;\n143\t    this.state = STATES.MATCHING;\n144\t\n145\t    // Remove the rainbow tile and the other tile\n146\t    const toRemove = this.matchEngine.triggerRainbow(rainbowRow, rainbowCol, targetColor);\n147\t    toRemove.push({ row: rainbowRow, col: rainbowCol });\n148\t    if (this.board.getTile(otherRow, otherCol)) {\n149\t      toRemove.push({ row: otherRow, col: otherCol });\n150\t    }\n151\t\n152\t    this._removeAndCascade(toRemove, 10);\n153\t  }\n154\t\n155\t  _processMatches() {\n156\t    this.state = STATES.MATCHING;\n157\t    const matches = this.board.findAllMatches();\n158\t\n159\t    if (matches.length === 0) {\n160\t      this.state = STATES.IDLE;\n161\t      this.scoreSystem.checkState();\n162\t      return;\n163\t    }\n164\t\n165\t    let chainCount = 0;\n166\t    this._processChain(chainCount);\n167\t  }\n168\t\n169\t  _processChain(chainCount) {\n170\t    chainCount++;\n171\t    const matches = this.board.findAllMatches();\n172\t    if (matches.length === 0) {\n173\t      // Check for special tiles to trigger\n174\t      this.state = STATES.IDLE;\n175\t\n176\t      // Check deadlock\n177\t      if (!this.board.hasValidMoves()) {\n178\t        this.board.shuffle();\n179\t      }\n180\t\n181\t      const result = this.scoreSystem.checkState();\n182\t      if (result === 'playing') {\n183\t        // All done for this move\n184\t      }\n185\t      return;\n186\t    }\n187\t\n188\t    const lShapes = this.board.findLShapeMatches(matches);\n189\t    const { removeCells, specials } = this.matchEngine._classifyMatches(matches, lShapes);\n190\t\n191\t    // Score\n192\t    const multiplier = chainCount <= 1 ? 1 : chainCount === 2 ? 1.5 : chainCount === 3 ? 2.0 : 2.5;\n193\t    const baseScore = removeCells.size * 10;\n194\t    const points = Math.floor(baseScore * multiplier);\n195\t    this.scoreSystem.addScore(points);\n196\t\n197\t    // Combo text\n198\t    if (chainCount >= 4) { this.comboText = '超赞！！'; }\n199\t    else if (chainCount === 3) { this.comboText = '太棒了！'; }\n200\t    else if (chainCount === 2) { this.comboText = '不错！'; }\n201\t    this.comboTimer = 0.8;\n202\t\n203\t    // Track collected colors\n204\t    for (const key of removeCells) {\n205\t      const [r, c] = key.split(',').map(Number);\n206\t      const tile = this.board.getTile(r, c);\n207\t      if (tile && tile.color >= 0) {\n208\t        this.scoreSystem.addCollected(tile.color, 1);\n209\t      }\n210\t    }\n211\t\n212\t    // Create specials\n213\t    const specialPositions = new Set(specials.map(s => `${s.row},${s.col}`));\n214\t    for (const sp of specials) {\n215\t      const tile = this.board.getTile(sp.row, sp.col);\n216\t      if (tile) {\n217\t        tile.special = sp.type;\n218\t        tile.removing = false;\n219\t      }\n220\t    }\n221\t\n222\t    // Animate removal\n223\t    this.state = STATES.REMOVING;\n224\t    const toAnimate = [];\n225\t    for (const key of removeCells) {\n226\t      if (specialPositions.has(key)) continue;\n227\t      const [r, c] = key.split(',').map(Number);\n228\t      const tile = this.board.getTile(r, c);\n229\t      if (tile) {\n230\t        // Particle effect\n231\t        const pos = this.renderer.getTileCenter(r, c);\n232\t        const color = COLOR_MAP[tile.color];\n233\t        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 8);\n234\t\n235\t        // Score float\n236\t        this.renderer.addFloatingText(`+${points}`, pos.x, pos.y);\n237\t\n238\t        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n239\t        toAnimate.push(tile);\n240\t      }\n241\t    }\n242\t\n243\t    setTimeout(() => {\n244\t      // Actually remove tiles\n245\t      for (const key of removeCells) {\n246\t        if (specialPositions.has(key)) continue;\n247\t        const [r, c] = key.split(',').map(Number);\n248\t        this.board.clearCell(r, c);\n249\t      }\n250\t\n251\t      // Trigger specials in removed cells\n252\t      for (const sp of specials) {\n253\t        this._triggerSpecialEffects(sp.row, sp.col, sp.type);\n254\t      }\n255\t\n256\t      // Apply gravity\n257\t      this.state = STATES.DROPPING;\n258\t      const drops = this.board.applyGravity();\n259\t\n260\t      // Animate drops\n261\t      for (const drop of drops) {\n262\t        const tile = drop.tile;\n263\t        const fromY = drop.fromRow * this.renderer.tileSize;\n264\t        const toY = drop.toRow * this.renderer.tileSize;\n265\t        tile.offsetY = fromY - toY;\n266\t        this.tweens.add(tile, { offsetY: 0 }, 0.2 + drop.distance * 0.03, 'easeOutBounce');\n267\t      }\n268\t\n269\t      setTimeout(() => {\n270\t        this._processChain(chainCount);\n271\t      }, 350);\n272\t    }, 280);\n273\t  }\n274\t\n275\t  _triggerSpecialEffects(row, col, type) {\n276\t    const pos = this.renderer.getTileCenter(row, col);\n277\t    const tile = this.board.getTile(row, col);\n278\t    const color = tile ? COLOR_MAP[tile.color]?.hex : '#FFB800';\n279\t\n280\t    switch (type) {\n281\t      case 1: // STRIPED_H\n282\t      case 2: // STRIPED_V\n283\t        this.particles.emitExplosion(pos.x, pos.y, color || '#FFB800', 20);\n284\t        break;\n285\t      case 3: // BOMB\n286\t        this.particles.emitExplosion(pos.x, pos.y, '#FF9A3C', 30);\n287\t        break;\n288\t      case 4: // RAINBOW\n289\t        for (let i = 0; i < 40; i++) {\n290\t          this.particles.emitExplosion(pos.x, pos.y, '#FFB800', 2);\n291\t        }\n292\t        break;\n293\t    }\n294\t  }\n295\t\n296\t  _removeAndCascade(cells, scorePerCell) {\n297\t    this.state = STATES.REMOVING;\n298\t    const points = cells.length * scorePerCell;\n299\t    this.scoreSystem.addScore(points);\n300\t\n301\t    for (const { row, col } of cells) {\n302\t      const tile = this.board.getTile(row, col);\n303\t      if (tile) {\n304\t        const pos = this.renderer.getTileCenter(row, col);\n305\t        const color = COLOR_MAP[tile.color];\n306\t        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 6);\n307\t        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n308\t      }\n309\t    }\n310\t\n311\t    setTimeout(() => {\n312\t      for (const { row, col } of cells) {\n313\t        this.board.clearCell(row, col);\n314\t      }\n315\t      this.board.applyGravity();\n316\t\n317\t      this.state = STATES.IDLE;\n318\t      // Check for more cascades\n319\t      setTimeout(() => this._processMatches(), 200);\n320\t    }, 300);\n321\t  }\n322\t\n323\t  _loop() {\n324\t    const now = performance.now();\n325\t    const dt = Math.min((now - this.lastTime) / 1000, 0.05);\n326\t    this.lastTime = now;\n327\t\n328\t    this.update(dt);\n329\t    this.render();\n330\t    requestAnimationFrame(() => this._loop());\n331\t  }\n332\t\n333\t  update(dt) {\n334\t    this.tweens.update(dt);\n335\t    this.particles.update(dt);\n336\t\n337\t    if (this.comboTimer > 0) {\n338\t      this.comboTimer -= dt;\n339\t      if (this.comboTimer <= 0) this.comboText = '';\n340\t    }\n341\t\n342\t    this.input.enabled = this.state === STATES.IDLE;\n343\t  }\n344\t\n345\t  render() {\n346\t    this.renderer.clear();\n347\t    this.renderer.drawBackground();\n348\t\n349\t    // Draw tiles\n350\t    for (let r = 0; r < this.board.size; r++) {\n351\t      for (let c = 0; c < this.board.size; c++) {\n352\t        const tile = this.board.getTile(r, c);\n353\t        if (tile) this.renderer.drawTile(tile);\n354\t      }\n355\t    }\n356\t\n357\t    // Particles\n358\t    this.particles.draw(this.renderer.ctx);\n359\t\n360\t    // Floating texts\n361\t    this.renderer.updateAndDrawFloatingTexts(1 / 60);\n362\t\n363\t    // UI\n364\t    this.renderer.drawUI(\n365\t      this.scoreSystem.score,\n366\t      this.scoreSystem.getRemainingMoves(),\n367\t      this.scoreSystem.goalTarget,\n368\t      this.scoreSystem.goalProgress,\n369\t      this.currentLevel + 1,\n370\t    );\n371\t\n372\t    // Combo text\n373\t    if (this.comboText) {\n374\t      this.renderer.drawComboText(this.comboText);\n375\t    }\n376\t\n377\t    // Result screen\n378\t    if (this.resultData) {\n379\t      this.renderer.drawResultScreen(\n380\t        this.resultData.won,\n381\t        this.resultData.score,\n382\t        this.resultData.stars,\n383\t        this.resultData.level,\n384\t      );\n385\t    }\n386\t  }\n387\t\n388\t  // Public methods for UI interaction\n389\t  retry() {\n390\t    this._loadLevel(this.currentLevel);\n391\t    this.state = STATES.IDLE;\n392\t  }\n393\t\n394\t  nextLevel() {\n395\t    const next = this.currentLevel + 1;\n396\t    if (next < this.levels.length) {\n397\t      this._loadLevel(next);\n398\t      this.state = STATES.IDLE;\n399\t    } else {\n400\t      this._loadLevel(0);\n401\t      this.state = STATES.IDLE;\n402\t    }\n403\t  }\n404\t}\n405\t\n406\tif (typeof module !== 'undefined') module.exports = { Game, STATES };\n407\t"}]},"parent_tool_use_id":null,"session_id":"4fc1920c-0b5c-4266-b43d-05c38f749fa3","uuid":"b9c9d572-c0c5-4b75-ab37-6a049eed5648","timestamp":"2026-05-22T21:24:49.951Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-match3/src/js/Game.js","content":"// Game.js — Main game loop, state machine, ties all modules together\n\nconst STATES = {\n  MENU: 'menu',\n  IDLE: 'idle',\n  SWAPPING: 'swapping',\n  MATCHING: 'matching',\n  REMOVING: 'removing',\n  DROPPING: 'dropping',\n  RESULT: 'result',\n};\n\nclass Game {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.board = new Board();\n    this.matchEngine = new MatchEngine(this.board);\n    this.renderer = new Renderer(canvas);\n    this.input = new InputHandler(canvas, this.board);\n    this.scoreSystem = new ScoreSystem();\n    this.tweens = new TweenManager();\n    this.particles = new ParticleSystem();\n    this.levels = generateLevels();\n    this.currentLevel = 0;\n    this.state = STATES.MENU;\n    this.comboText = '';\n    this.comboTimer = 0;\n    this.lastTime = 0;\n    this.animationQueue = [];\n\n    this.renderer.particleSystem = this.particles;\n\n    this._setupInput();\n    this._setupScoreCallbacks();\n  }\n\n  _setupInput() {\n    this.input.onSwap = (r1, c1, r2, c2) => this._handleSwap(r1, c1, r2, c2);\n    this.input.onTap = (row, col) => this._handleTap(row, col);\n  }\n\n  _setupScoreCallbacks() {\n    this.scoreSystem.onLevelComplete = (score, stars) => {\n      this.state = STATES.RESULT;\n      this.resultData = { won: true, score, stars, level: this.currentLevel + 1 };\n    };\n    this.scoreSystem.onLevelFail = (score) => {\n      this.state = STATES.RESULT;\n      this.resultData = { won: false, score, stars: 0, level: this.currentLevel + 1 };\n    };\n  }\n\n  start() {\n    this._loadLevel(0);\n    this.state = STATES.IDLE;\n    this.lastTime = performance.now();\n    this._loop();\n  }\n\n  _loadLevel(idx) {\n    this.currentLevel = idx;\n    const config = this.levels[idx] || this.levels[0];\n    this.board.init();\n    this.scoreSystem.reset(idx + 1);\n    this.scoreSystem.configure(config);\n    this.input.updateLayout(\n      this.renderer.tileSize,\n      this.renderer.boardX,\n      this.renderer.boardY,\n    );\n    this.tweens.clear();\n    this.particles.particles = [];\n    this.renderer.floatingTexts = [];\n    this.comboText = '';\n    this.resultData = null;\n  }\n\n  _handleTap(row, col) {\n    if (this.state !== STATES.IDLE) return;\n    const tile = this.board.getTile(row, col);\n    if (!tile) return;\n\n    // Rainbow special: tap to activate\n    if (tile.special !== SPECIAL_NONE) {\n      // For now, rainbow on tap picks a random color\n      // In full game, this would be from the swapped tile's color\n      return;\n    }\n  }\n\n  _handleSwap(r1, c1, r2, c2) {\n    if (this.state !== STATES.IDLE) return;\n\n    // Check if any special tile combination\n    const tileA = this.board.getTile(r1, c1);\n    const tileB = this.board.getTile(r2, c2);\n\n    if (tileA && tileA.special === SPECIAL_RAINBOW) {\n      this._activateRainbow(r1, c1, tileB ? tileB.color : 0, r2, c2);\n      return;\n    }\n    if (tileB && tileB.special === SPECIAL_RAINBOW) {\n      this._activateRainbow(r2, c2, tileA ? tileA.color : 0, r1, c1);\n      return;\n    }\n\n    if (!this.matchEngine.isValidSwap(r1, c1, r2, c2)) return;\n    if (!this.scoreSystem.useMove()) return;\n\n    this.state = STATES.SWAPPING;\n    this.board.swap(r1, c1, r2, c2);\n\n    // Animate swap\n    this._animateSwap(r1, c1, r2, c2, () => {\n      this._processMatches();\n    });\n  }\n\n  _animateSwap(r1, c1, r2, c2, callback) {\n    const tileSize = this.renderer.tileSize;\n    const tileA = this.board.getTile(r2, c2); // After swap, tileA is at (r2,c2)\n    const tileB = this.board.getTile(r1, c1);\n\n    const dx = (c2 - c1) * tileSize;\n    const dy = (r2 - r1) * tileSize;\n\n    if (tileA) {\n      tileA.offsetX = -dx;\n      tileA.offsetY = -dy;\n      this.tweens.add(tileA, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n    }\n    if (tileB) {\n      tileB.offsetX = dx;\n      tileB.offsetY = dy;\n      this.tweens.add(tileB, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n    }\n\n    setTimeout(callback, 160);\n  }\n\n  _activateRainbow(rainbowRow, rainbowCol, targetColor, otherRow, otherCol) {\n    if (!this.scoreSystem.useMove()) return;\n    this.state = STATES.MATCHING;\n\n    // Remove the rainbow tile and the other tile\n    const toRemove = this.matchEngine.triggerRainbow(rainbowRow, rainbowCol, targetColor);\n    toRemove.push({ row: rainbowRow, col: rainbowCol });\n    if (this.board.getTile(otherRow, otherCol)) {\n      toRemove.push({ row: otherRow, col: otherCol });\n    }\n\n    this._removeAndCascade(toRemove, 10);\n  }\n\n  _processMatches() {\n    this.state = STATES.MATCHING;\n    const matches = this.board.findAllMatches();\n\n    if (matches.length === 0) {\n      this.state = STATES.IDLE;\n      this.scoreSystem.checkState();\n      return;\n    }\n\n    let chainCount = 0;\n    this._processChain(chainCount);\n  }\n\n  _processChain(chainCount) {\n    chainCount++;\n    const matches = this.board.findAllMatches();\n    if (matches.length === 0) {\n      // Check for special tiles to trigger\n      this.state = STATES.IDLE;\n\n      // Check deadlock\n      if (!this.board.hasValidMoves()) {\n        this.board.shuffle();\n      }\n\n      const result = this.scoreSystem.checkState();\n      if (result === 'playing') {\n        // All done for this move\n      }\n      return;\n    }\n\n    const lShapes = this.board.findLShapeMatches(matches);\n    const { removeCells, specials } = this.matchEngine._classifyMatches(matches, lShapes);\n\n    // Score\n    const multiplier = chainCount <= 1 ? 1 : chainCount === 2 ? 1.5 : chainCount === 3 ? 2.0 : 2.5;\n    const baseScore = removeCells.size * 10;\n    const points = Math.floor(baseScore * multiplier);\n    this.scoreSystem.addScore(points);\n\n    // Combo text\n    if (chainCount >= 4) { this.comboText = '超赞！！'; }\n    else if (chainCount === 3) { this.comboText = '太棒了！'; }\n    else if (chainCount === 2) { this.comboText = '不错！'; }\n    this.comboTimer = 0.8;\n\n    // Track collected colors\n    for (const key of removeCells) {\n      const [r, c] = key.split(',').map(Number);\n      const tile = this.board.getTile(r, c);\n      if (tile && tile.color >= 0) {\n        this.scoreSystem.addCollected(tile.color, 1);\n      }\n    }\n\n    // Create specials\n    const specialPositions = new Set(specials.map(s => `${s.row},${s.col}`));\n    for (const sp of specials) {\n      const tile = this.board.getTile(sp.row, sp.col);\n      if (tile) {\n        tile.special = sp.type;\n        tile.removing = false;\n      }\n    }\n\n    // Animate removal\n    this.state = STATES.REMOVING;\n    const toAnimate = [];\n    for (const key of removeCells) {\n      if (specialPositions.has(key)) continue;\n      const [r, c] = key.split(',').map(Number);\n      const tile = this.board.getTile(r, c);\n      if (tile) {\n        // Particle effect\n        const pos = this.renderer.getTileCenter(r, c);\n        const color = COLOR_MAP[tile.color];\n        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 8);\n\n        // Score float\n        this.renderer.addFloatingText(`+${points}`, pos.x, pos.y);\n\n        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n        toAnimate.push(tile);\n      }\n    }\n\n    setTimeout(() => {\n      // Actually remove tiles\n      for (const key of removeCells) {\n        if (specialPositions.has(key)) continue;\n        const [r, c] = key.split(',').map(Number);\n        this.board.clearCell(r, c);\n      }\n\n      // Trigger specials in removed cells\n      for (const sp of specials) {\n        this._triggerSpecialEffects(sp.row, sp.col, sp.type);\n      }\n\n      // Apply gravity\n      this.state = STATES.DROPPING;\n      const drops = this.board.applyGravity();\n\n      // Animate drops\n      for (const drop of drops) {\n        const tile = drop.tile;\n        const fromY = drop.fromRow * this.renderer.tileSize;\n        const toY = drop.toRow * this.renderer.tileSize;\n        tile.offsetY = fromY - toY;\n        this.tweens.add(tile, { offsetY: 0 }, 0.2 + drop.distance * 0.03, 'easeOutBounce');\n      }\n\n      setTimeout(() => {\n        this._processChain(chainCount);\n      }, 350);\n    }, 280);\n  }\n\n  _triggerSpecialEffects(row, col, type) {\n    const pos = this.renderer.getTileCenter(row, col);\n    const tile = this.board.getTile(row, col);\n    const color = tile ? COLOR_MAP[tile.color]?.hex : '#FFB800';\n\n    switch (type) {\n      case 1: // STRIPED_H\n      case 2: // STRIPED_V\n        this.particles.emitExplosion(pos.x, pos.y, color || '#FFB800', 20);\n        break;\n      case 3: // BOMB\n        this.particles.emitExplosion(pos.x, pos.y, '#FF9A3C', 30);\n        break;\n      case 4: // RAINBOW\n        for (let i = 0; i < 40; i++) {\n          this.particles.emitExplosion(pos.x, pos.y, '#FFB800', 2);\n        }\n        break;\n    }\n  }\n\n  _removeAndCascade(cells, scorePerCell) {\n    this.state = STATES.REMOVING;\n    const points = cells.length * scorePerCell;\n    this.scoreSystem.addScore(points);\n\n    for (const { row, col } of cells) {\n      const tile = this.board.getTile(row, col);\n      if (tile) {\n        const pos = this.renderer.getTileCenter(row, col);\n        const color = COLOR_MAP[tile.color];\n        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 6);\n        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n      }\n    }\n\n    setTimeout(() => {\n      for (const { row, col } of cells) {\n        this.board.clearCell(row, col);\n      }\n      this.board.applyGravity();\n\n      this.state = STATES.IDLE;\n      // Check for more cascades\n      setTimeout(() => this._processMatches(), 200);\n    }, 300);\n  }\n\n  _loop() {\n    const now = performance.now();\n    const dt = Math.min((now - this.lastTime) / 1000, 0.05);\n    this.lastTime = now;\n\n    this.update(dt);\n    this.render();\n    requestAnimationFrame(() => this._loop());\n  }\n\n  update(dt) {\n    this.tweens.update(dt);\n    this.particles.update(dt);\n\n    if (this.comboTimer > 0) {\n      this.comboTimer -= dt;\n      if (this.comboTimer <= 0) this.comboText = '';\n    }\n\n    this.input.enabled = this.state === STATES.IDLE;\n  }\n\n  render() {\n    this.renderer.clear();\n    this.renderer.drawBackground();\n\n    // Draw tiles\n    for (let r = 0; r < this.board.size; r++) {\n      for (let c = 0; c < this.board.size; c++) {\n        const tile = this.board.getTile(r, c);\n        if (tile) this.renderer.drawTile(tile);\n      }\n    }\n\n    // Particles\n    this.particles.draw(this.renderer.ctx);\n\n    // Floating texts\n    this.renderer.updateAndDrawFloatingTexts(1 / 60);\n\n    // UI\n    this.renderer.drawUI(\n      this.scoreSystem.score,\n      this.scoreSystem.getRemainingMoves(),\n      this.scoreSystem.goalTarget,\n      this.scoreSystem.goalProgress,\n      this.currentLevel + 1,\n    );\n\n    // Combo text\n    if (this.comboText) {\n      this.renderer.drawComboText(this.comboText);\n    }\n\n    // Result screen\n    if (this.resultData) {\n      this.renderer.drawResultScreen(\n        this.resultData.won,\n        this.resultData.score,\n        this.resultData.stars,\n        this.resultData.level,\n      );\n    }\n  }\n\n  // Public methods for UI interaction\n  retry() {\n    this._loadLevel(this.currentLevel);\n    this.state = STATES.IDLE;\n  }\n\n  nextLevel() {\n    const next = this.currentLevel + 1;\n    if (next < this.levels.length) {\n      this._loadLevel(next);\n      this.state = STATES.IDLE;\n    } else {\n      this._loadLevel(0);\n      this.state = STATES.IDLE;\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Game, STATES };\n","numLines":407,"startLine":1,"totalLines":407}}}
