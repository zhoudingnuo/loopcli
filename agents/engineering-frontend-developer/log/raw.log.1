rs);","+    }","   }"," ","+  private renderNotifications(","+    c: CanvasRenderingContext2D,","+    w: number,","+    h: number,","+    state: GameState,","+  ): void {","+    const recent = state.notifications.slice(-5);","+    if (recent.length === 0) return;","+","+    c.textAlign = 'right';","+    c.font = '10px monospace';","+    for (let i = 0; i < recent.length; i++) {","+      const alpha = 0.3 + (i / recent.length) * 0.5;","+      c.fillStyle = `rgba(200, 220, 255, ${alpha})`;","+      c.fillText(recent[i], w - 12, h - 30 - (recent.length - 1 - i) * 14);","+    }","+  }","+","+  private renderRegisterStatus(","+    c: CanvasRenderingContext2D,","+    canvasW: number,","+    registers: CashRegister[],","+  ): void {","+    let x = 12;","+    const y = 48;","+    for (const reg of registers) {","+      const stateLabels: Record<string, string> = {","+        idle: '空闲',","+        scanning: '扫描中...',","+        payment: '付款中',","+        giving_change: '找零中',","+        receipt: '打印收据',","+        anomaly: '异常!',","+      };","+      const stateColors: Record<string, string> = {","+        idle: '#666',","+        scanning: '#6a6',","+        payment: '#aa6',","+        giving_change: '#6aa',","+        receipt: '#66a',","+        anomaly: '#a44',","+      };","+      const label = stateLabels[reg.state] ?? reg.state;","+      const color = stateColors[reg.state] ?? '#666';","+","+      c.fillStyle = 'rgba(0,0,0,0.6)';","+      c.fillRect(x, y, 80, 16);","+      c.fillStyle = color;","+      c.font = '9px monospace';","+      c.textAlign = 'left';","+      c.textBaseline = 'middle';","+      c.fillText(`${reg.registerId}: ${label}`, x + 4, y + 8);","+      x += 84;","+    }","+  }","+","+  private renderPanel(","+    c: CanvasRenderingContext2D,","+    w: number,","+    h: number,","+    state: GameState,","+    ctx: RenderContext,","+  ): void {","+    // Darken background","+    c.fillStyle = 'rgba(0,0,0,0.5)';","+    c.fillRect(0, 0, w, h);","+","+    const panelW = Math.min(500, w - 40);","+    const panelH = Math.min(400, h - 80);","+    const px = (w - panelW) / 2;","+    const py = (h - panelH) / 2;","+","+    // Panel background","+    c.fillStyle = 'rgba(20, 20, 35, 0.95)';","+    c.fillRect(px, py, panelW, panelH);","+    c.strokeStyle = 'rgba(100, 120, 160, 0.5)';","+    c.lineWidth = 1;","+    c.strokeRect(px, py, panelW, panelH);","+","+    // Title bar","+    c.fillStyle = 'rgba(40, 40, 60, 0.9)';","+    c.fillRect(px, py, panelW, 30);","+","+    switch (state.activePanel) {","+      case UIPanel.SHELF:","+        this.renderShelfPanel(c, px, py, panelW, panelH, ctx);","+        break;","+      case UIPanel.INVENTORY:","+        this.renderInventoryPanel(c, px, py, panelW, panelH, ctx);","+        break;","+      case UIPanel.PRICING:","+        this.renderPricingPanel(c, px, py, panelW, panelH, ctx);","+        break;","+      case UIPanel.SHOP:","+        this.renderShopPanel(c, px, py, panelW, panelH, ctx);","+        break;","+      case UIPanel.SUPPLIER:","+        this.renderSupplierPanel(c, px, py, panelW, panelH, state, ctx);","+        break;","+    }","+","+    // Close button hint","+    c.fillStyle = 'rgba(255,255,255,0.4)';","+    c.font = '10px monospace';","+    c.textAlign = 'center';","+    c.fillText('按 ESC 或 E 关闭', w / 2, py + panelH + 15);","+  }","+","+  private renderShelfPanel(","+    c: CanvasRenderingContext2D,","+    px: number, py: number,","+    pw: number, ph: number,","+    ctx: RenderContext,","+  ): void {","+    const shelf = ctx.shelfInteraction;","+    if (!shelf.currentShelfId) return;","+","+    c.fillStyle = '#e0d0b0';","+    c.font = 'bold 14px monospace';","+    c.textAlign = 'left';","+    c.textBaseline = 'top';","+    c.fillText('货架管理', px + 10, py + 8);","+","+    const slot = ctx.productManager.shelfSlots.get(shelf.currentShelfId);","+    if (!slot) return;","+","+    let y = py + 40;","+","+    if (slot.productId && slot.quantity > 0) {","+      const product = ctx.productManager.getProduct(slot.productId);","+      c.fillStyle = '#aac';","+      c.font = '12px monospace';","+      c.fillText(`商品: ${product?.name ?? slot.productId}`, px + 10, y);","+      y += 18;","+      c.fillText(`库存: ${slot.quantity}/${slot.maxQuantity}`, px + 10, y);","+      y += 18;","+      const price = ctx.pricing.getPrice(slot.productId);","+      c.fillText(`售价: ¥${price.toFixed(2)}`, px + 10, y);","+      y += 30;","+    } else {","+      c.fillStyle = '#888';","+      c.font = '12px monospace';","+      c.fillText('空货架', px + 10, y);","+      y += 30;","+    }","+","+    // Available products to stock","+    c.fillStyle = '#ccc';","+    c.font = '11px monospace';","+    c.fillText('可上架商品:', px + 10, y);","+    y += 18;","+","+    const available = shelf.getAvailableProductsForShelf(shelf.currentShelfId, ctx.productManager);","+    for (let i = 0; i < Math.min(available.length, 8); i++) {","+      const item = available[i];","+      c.fillStyle = '#aab8cc';","+      c.font = '11px monospace';","+      c.fillText(`  ${item.name} x${item.quantity}`, px + 10, y);","+      y += 16;","+    }","+","+    if (available.length === 0) {","+      c.fillStyle = '#666';","+      c.fillText('  (无库存)', px + 10, y);","+    }","+  }","+","+  private renderInventoryPanel(","+    c: CanvasRenderingContext2D,","+    px: number, py: number,","+    pw: number, ph: number,","+    ctx: RenderContext,","+  ): void {","+    c.fillStyle = '#e0d0b0';","+    c.font = 'bold 14px monospace';","+    c.textAlign = 'left';","+    c.textBaseline = 'top';","+    c.fillText('库存管理', px + 10, py + 8);","+","+    let y = py + 40;","+    c.fillStyle = '#aaa';","+    c.font = '10px monospace';","+    c.fillText(`仓库容量: ${ctx.productManager.storageUsed}/${ctx.productManager.storageCapacity}`, px + 10, y);","+    y += 20;","+","+    for (const [id, item] of ctx.productManager.inventory) {","+      if (item.quantity <= 0) continue;","+      const product = ctx.productManager.getProduct(id);","+      const price = ctx.pricing.getPrice(id);","+      c.fillStyle = '#bbb';","+      c.font = '11px monospace';","+      c.fillText(`${product?.name ?? id}  x${item.quantity}  ¥${price.toFixed(2)}/个`, px + 10, y);","+      y += 16;","+      if (y > py + ph - 30) break;","+    }","+  }","+","+  private renderPricingPanel(","+    c: CanvasRenderingContext2D,","+    px: number, py: number,","+    pw: number, ph: number,","+    ctx: RenderContext,","+  ): void {","+    c.fillStyle = '#e0d0b0';","+    c.font = 'bold 14px monospace';","+    c.textAlign = 'left';","+    c.textBaseline = 'top';","+    c.fillText('定价管理', px + 10, py + 8);","+","+    let y = py + 40;","+    const prices = ctx.pricing.getAllPrices();","+","+    c.fillStyle = '#888';","+    c.font = '10px monospace';","+    c.fillText('商品           基价      现价      范围', px + 10, y);","+    y += 16;","+","+    for (const entry of prices) {","+      const product = ctx.productManager.getProduct(entry.productId);","+      if (!product) continue;","+      c.fillStyle = '#bbb';","+      c.font = '10px monospace';","+      const name = product.name.padEnd(8, '　');","+      c.fillText(","+        `${name}  ¥${entry.basePrice.toFixed(0).padStart(3)}   ¥${entry.currentPrice.toFixed(0).padStart(3)}   ${entry.minPrice.toFixed(0)}-${entry.maxPrice.toFixed(0)}`,","+        px + 10, y,","+      );","+      y += 14;","+      if (y > py + ph - 30) break;","+    }","+  }","+","+  private renderShopPanel(","+    c: CanvasRenderingContext2D,","+    px: number, py: number,","+    pw: number, ph: number,","+    ctx: RenderContext,","+  ): void {","+    c.fillStyle = '#e0d0b0';","+    c.font = 'bold 14px monospace';","+    c.textAlign = 'left';","+    c.textBaseline = 'top';","+    c.fillText('店铺升级', px + 10, py + 8);","+","+    let y = py + 40;","+    const upgrades = ctx.economy.getUpgrades();","+","+    for (const upgrade of upgrades) {","+      const owned = ctx.economy.hasUpgrade(upgrade.id);","+      c.fillStyle = owned ? '#5a7a5a' : '#bbb';","+      c.font = '11px monospace';","+      c.fillText(","+        `${owned ? '[已购]' : `¥${upgrade.cost}`.padStart(6)} ${upgrade.name} — ${upgrade.description}`,","+        px + 10, y,","+      );","+      y += 16;","+      c.fillStyle = '#777';","+      c.font = '9px monospace';","+      c.fillText(`  ${upgrade.horrorLink}`, px + 10, y);","+      y += 14;","+      if (y > py + ph - 30) break;","+    }","+  }","+","+  private renderSupplierPanel(","+    c: CanvasRenderingContext2D,","+    px: number, py: number,","+    pw: number, ph: number,","+    state: GameState,","+    ctx: RenderContext,","+  ): void {","+    c.fillStyle = '#e0d0b0';","+    c.font = 'bold 14px monospace';","+    c.textAlign = 'left';","+    c.textBaseline = 'top';","+    c.fillText('进货管理', px + 10, py + 8);","+","+    let y = py + 40;","+","+    // Show suppliers","+    const isNight = isNightTime(state.phase);","+    const suppliers = ctx.productManager.getUnlockedSuppliers(state.day, isNight);","+    c.fillStyle = '#888';","+    c.font = '10px monospace';","+    c.fillText('可用供应商:', px + 10, y);","+    y += 16;","+","+    for (const supplier of suppliers) {","+      c.fillStyle = '#aab8cc';","+      c.font = '11px monospace';","+      c.fillText(`${supplier.name} — ${supplier.description}`, px + 10, y);","+      y += 14;","+      c.fillStyle = '#777';","+      c.font = '9px monospace';","+      c.fillText(`  价格x${supplier.priceMultiplier} 可靠度${Math.round(supplier.reliability * 100)}%`, px + 10, y);","+      y += 16;","+    }","+","+    y += 10;","+","+    // Pending orders","+    if (ctx.productManager.pendingOrders.length > 0) {","+      c.fillStyle = '#888';","+      c.font = '10px monospace';","+      c.fillText('待到货订单:', px + 10, y);","+      y += 16;","+","+      for (const order of ctx.productManager.pendingOrders) {","+        const product = ctx.productManager.getProduct(order.productId);","+        c.fillStyle = '#cc9';","+        c.font = '10px monospace';","+        c.fillText(`${product?.name ?? order.productId} x${order.quantity} — ¥${order.totalCost} (Day ${order.arrivalDay}到)`, px + 10, y);","+        y += 14;","+        if (y > py + ph - 30) break;","+      }","+    }","+  }","+","   destroy(): void {}"," }"]}],"originalFile":"// Renderer.ts — Canvas 2D rendering system for the convenience store\n\nimport { Camera } from './Camera';\nimport { StoreMap, T } from '../game/StoreMap';\nimport { Player } from '../game/Player';\nimport { Lighting } from './Lighting';\nimport type { GameState, GamePhase, LightSource, Interactable } from '../game/GameState';\nimport { getTimeString, isNightTime } from '../game/GameState';\n\nexport class Renderer {\n  canvas: HTMLCanvasElement;\n  ctx: CanvasRenderingContext2D;\n  camera: Camera;\n  lighting: Lighting;\n\n  constructor(canvas: HTMLCanvasElement) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d')!;\n    this.camera = new Camera(canvas);\n    this.lighting = new Lighting();\n    this.resize();\n    this.camera.setupZoom(canvas);\n  }\n\n  resize(): void {\n    const dpr = window.devicePixelRatio || 1;\n    const rect = this.canvas.getBoundingClientRect();\n    this.canvas.width = rect.width * dpr;\n    this.canvas.height = rect.height * dpr;\n    this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n  }\n\n  render(\n    map: StoreMap,\n    player: Player,\n    state: GameState,\n    now: number,\n  ): void {\n    const ctx = this.ctx;\n    const w = this.canvas.getBoundingClientRect().width;\n    const h = this.canvas.getBoundingClientRect().height;\n\n    // Background\n    const bgPhase = state.phase;\n    if (bgPhase === 'danger') {\n      ctx.fillStyle = '#0a0a15';\n    } else if (isNightTime(bgPhase)) {\n      ctx.fillStyle = '#0f1020';\n    } else {\n      ctx.fillStyle = '#1a1520';\n    }\n    ctx.fillRect(0, 0, w, h);\n\n    const { offsetX, offsetY, scale } = this.camera.getTransform();\n\n    // Render map tiles\n    map.render(ctx, offsetX, offsetY, w, h, scale);\n\n    // Render interactable highlights\n    this.renderInteractables(ctx, state.interactables, offsetX, offsetY, scale, player, now);\n\n    // Render player\n    player.render(ctx, offsetX, offsetY, scale);\n\n    // Render lighting overlay\n    this.lighting.render(ctx, w, h, state.lights, state.phase, offsetX, offsetY, scale, now);\n\n    // Render HUD\n    this.renderHUD(ctx, w, h, state, player);\n  }\n\n  private renderInteractables(\n    ctx: CanvasRenderingContext2D,\n    interactables: Interactable[],\n    offsetX: number,\n    offsetY: number,\n    scale: number,\n    player: Player,\n    now: number,\n  ): void {\n    const facing = player.getFacingTile();\n\n    for (const obj of interactables) {\n      const px = offsetX + obj.x * scale;\n      const py = offsetY + obj.y * scale;\n      const pw = obj.width * scale;\n      const ph = obj.height * scale;\n\n      // Check if player is facing this interactable\n      const objGX = Math.floor(obj.x / 32);\n      const objGY = Math.floor(obj.y / 32);\n      const isFacing = facing.gx >= objGX && facing.gx <= objGX + Math.ceil(obj.width / 32) - 1 &&\n        facing.gy >= objGY && facing.gy <= objGY + Math.ceil(obj.height / 32) - 1;\n\n      if (isFacing) {\n        // Highlight glow\n        const pulse = 0.3 + Math.sin(now * 0.005) * 0.1;\n        ctx.strokeStyle = `rgba(255, 255, 100, ${pulse})`;\n        ctx.lineWidth = 2;\n        ctx.strokeRect(px - 2, py - 2, pw + 4, ph + 4);\n\n        // Label\n        ctx.fillStyle = 'rgba(0,0,0,0.7)';\n        const labelW = ctx.measureText(obj.label).width + 12;\n        ctx.fillRect(px + pw / 2 - labelW / 2, py - 22, labelW, 18);\n        ctx.fillStyle = '#ffdd66';\n        ctx.font = `${Math.round(11)}px monospace`;\n        ctx.textAlign = 'center';\n        ctx.textBaseline = 'middle';\n        ctx.fillText(obj.label, px + pw / 2, py - 13);\n      }\n    }\n  }\n\n  private renderHUD(\n    ctx: CanvasRenderingContext2D,\n    canvasW: number,\n    canvasH: number,\n    state: GameState,\n    player: Player,\n  ): void {\n    // Top bar\n    ctx.fillStyle = 'rgba(0,0,0,0.75)';\n    ctx.fillRect(0, 0, canvasW, 40);\n\n    // Day counter\n    ctx.fillStyle = '#e0d0b0';\n    ctx.font = 'bold 13px monospace';\n    ctx.textAlign = 'left';\n    ctx.textBaseline = 'middle';\n    ctx.fillText(`Day ${state.day}`, 12, 20);\n\n    // Time\n    ctx.fillStyle = isNightTime(state.phase) ? '#8888cc' : '#ccaa66';\n    ctx.font = '13px monospace';\n    ctx.fillText(getTimeString(state.timeOfDay), 80, 20);\n\n    // Phase indicator\n    const phaseLabels: Record<string, string> = {\n      daytime: '☀ 营业中',\n      night_transition: '🌆 准备打烊',\n      night: '🌙 深夜营业',\n      danger: '⚠ 危险时段',\n      dawn: '🌅 黎明',\n    };\n    ctx.fillStyle = state.phase === 'danger' ? '#ff4444' : '#aaa';\n    ctx.font = '11px monospace';\n    ctx.fillText(phaseLabels[state.phase] ?? state.phase, 160, 20);\n\n    // Money\n    ctx.fillStyle = '#66cc66';\n    ctx.font = '12px monospace';\n    ctx.textAlign = 'right';\n    ctx.fillText(`¥${state.player.money.toLocaleString()}`, canvasW - 12, 14);\n\n    // Debt\n    ctx.fillStyle = '#cc6666';\n    ctx.font = '10px monospace';\n    ctx.fillText(`债务: ¥${state.player.debt.toLocaleString()}`, canvasW - 12, 28);\n\n    // Health bar\n    ctx.textAlign = 'left';\n    const hbX = 300;\n    const hbY = 10;\n    const hbW = 80;\n    const hbH = 8;\n    ctx.fillStyle = 'rgba(255,255,255,0.1)';\n    ctx.fillRect(hbX, hbY, hbW, hbH);\n    ctx.fillStyle = '#cc3333';\n    ctx.fillRect(hbX, hbY, hbW * (state.player.health / 100), hbH);\n    ctx.strokeStyle = 'rgba(255,255,255,0.2)';\n    ctx.lineWidth = 1;\n    ctx.strokeRect(hbX, hbY, hbW, hbH);\n    ctx.fillStyle = '#aaa';\n    ctx.font = '8px monospace';\n    ctx.fillText('HP', hbX - 18, hbY + 7);\n\n    // Sanity bar\n    const sbY = 22;\n    ctx.fillStyle = 'rgba(255,255,255,0.1)';\n    ctx.fillRect(hbX, sbY, hbW, hbH);\n    ctx.fillStyle = '#6666cc';\n    ctx.fillRect(hbX, sbY, hbW * (state.player.sanity / 100), hbH);\n    ctx.strokeStyle = 'rgba(255,255,255,0.2)';\n    ctx.strokeRect(hbX, sbY, hbW, hbH);\n    ctx.fillStyle = '#aaa';\n    ctx.fillText('SAN', hbX - 22, sbY + 7);\n\n    // Interaction hint\n    ctx.fillStyle = 'rgba(255,255,255,0.4)';\n    ctx.font = '10px monospace';\n    ctx.textAlign = 'center';\n    ctx.fillText('WASD 移动 | E 交互 | 滚轮 缩放', canvasW / 2, canvasH - 12);\n  }\n\n  destroy(): void {}\n}\n","userModified":false}}
