\",\"而\",\"废\"],pinyin:\"bàn tú ér fèi\",meaning:\"做事不能坚持到底中途停顿\",difficulty:3,category:[\"常用\"],frequency:22},\n{id:\"h119\",idiom:\"功败垂成\",chars:[\"功\",\"败\",\"垂\",\"成\"],pinyin:\"gōng bài chuí chéng\",meaning:\"事情在快要成功的时候遭到了失败\",difficulty:3,category:[\"常用\"],frequency:21},\n{id:\"h120\",idiom:\"前功尽弃\",chars:[\"前\",\"功\",\"尽\",\"弃\"],pinyin:\"qián gōng jìn qì\",meaning:\"以前的功劳全部废弃努力完全白费\",difficulty:3,category:[\"常用\"],frequency:20},\n\n// ===== MASTER (difficulty: 4) — 150 idioms =====\n{id:\"s001\",idiom:\"沆瀣一气\",chars:[\"沆\",\"瀣\",\"一\",\"气\"],pinyin:\"hàng xiè yī qì\",meaning:\"比喻臭味相投的人结合在一起\",difficulty:4,category:[\"人物\"],frequency:19},\n{id:\"s002\",idiom:\"越俎代庖\",chars:[\"越\",\"俎\",\"代\",\"庖\"],pinyin:\"yuè zǔ dài páo\",meaning:\"比喻超出自己职责去处理别人的事\",difficulty:4,category:[\"常用\"],frequency:18},\n{id:\"s003\",idiom:\"噤若寒蝉\",chars:[\"噤\",\"若\",\"寒\",\"蝉\"],pinyin:\"jìn ruò hán chán\",meaning:\"比喻因为害怕有所顾虑而不敢说话\",difficulty:4,category:[\"动物\"],frequency:17},\n{id:\"s004\",idiom:\"如丧考妣\",chars:[\"如\",\"丧\",\"考\",\"妣\"],pinyin:\"rú sàng kǎo bǐ\",meaning:\"好像死了父母那样悲痛\",difficulty:4,category:[\"人物\"],frequency:16},\n{id:\"s005\",idiom:\"沐猴而冠\",chars:[\"沐\",\"猴\",\"而\",\"冠\"],pinyin:\"mù hóu ér guàn\",meaning:\"比喻虚有其表形同傀儡\",difficulty:4,category:[\"动物\"],frequency:15},\n{id:\"s006\",idiom:\"怙恶不悛\",chars:[\"怙\",\"恶\",\"不\",\"悛\"],pinyin:\"hù è bù quān\",meaning:\"坚持作恶不肯悔改\",difficulty:4,category:[\"常用\"],frequency:14},\n{id:\"s007\",idiom:\"暴殄天物\",chars:[\"暴\",\"殄\",\"天\",\"物\"],pinyin:\"bào tiǎn tiān wù\",meaning:\"任意糟蹋东西不知爱惜\",difficulty:4,category:[\"自然\"],frequency:13},\n{id:\"s008\",idiom:\"茕茕孑立\",chars:[\"茕\",\"茕\",\"孑\",\"立\"],pinyin:\"qióng qióng jié lì\",meaning:\"孤零零地独自站着形容无依无靠非常孤单\",difficulty:4,category:[\"人物\"],frequency:12},\n{id:\"s009\",idiom:\"踽踽独行\",chars:[\"踽\",\"踽\",\"独\",\"行\"],pinyin:\"jǔ jǔ dú xíng\",meaning:\"孤零零地独自走着形容非常孤独\",difficulty:4,category:[\"人物\"],frequency:11},\n{id:\"s010\",idiom:\"魑魅魍魉\",chars:[\"魑\",\"魅\",\"魍\",\"魉\"],pinyin:\"chī