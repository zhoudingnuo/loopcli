ground: linear-gradient(135deg, #C84B31 0%, #A63A22 100%);","-  color: white;","-  font-size: 24px;","-  font-weight: bold;","-  cursor: pointer;","-  transition: transform 0.1s;","+.candidates-container {","+  display: flex; flex-wrap: wrap; gap: 8px;","+  justify-content: center; max-width: 340px; margin-top: 8px;"," }"," ","-.candidate:active {","-  transform: scale(0.9);","+.candidate {","+  width: 48px; height: 48px; border: none; border-radius: 10px;","+  background: linear-gradient(135deg, #C84B31, #A63A22);","+  color: white; font-size: 22px; font-weight: bold;","+  cursor: pointer; transition: all 0.15s;","+  display: flex; align-items: center; justify-content: center;"," }","-","+.candidate:active { transform: scale(0.9); }"," .candidate.used {","-  opacity: 0.3;","-  pointer-events: none;","+  opacity: 0.25; pointer-events: none; transform: scale(0.9);"," }","+.candidate.removed {","+  opacity: 0.1; pointer-events: none;","+}"," ","-.tools {","-  display: flex;","-  gap: 10px;","+.game-footer {","+  display: flex; justify-content: center; gap: 12px;","+  padding: 12px 16px; background: rgba(255,255,255,0.9);","+  border-top: 1px solid #E8DED0;"," }"," "," .tool-btn {","-  width: 80px;","-  height: 50px;","-  border: none;","-  border-radius: 10px;","-  background: #2D6A4F;","-  color: white;","-  font-size: 14px;","-  cursor: pointer;","+  padding: 8px 16px; border: 2px solid #2D6A4F;","+  border-radius: 20px; background: white;","+  color: #2D6A4F; font-size: 14px; cursor: pointer;","+  transition: all 0.15s;"," }","+.tool-btn:active { background: #2D6A4F; color: white; }"," ","-/* 结算界面 */","+/* ===== 教学覆盖层 ===== */","+.tutorial-overlay {","+  position: absolute; bottom: 0; left: 0; right: 0;","+  background: rgba(0,0,0,0.7); padding: 20px;","+  display: flex; align-items: center; justify-content: center;","+  z-index: 100;","+}","+.tutorial-text {","+  color: white; font-size: 16px; text-align: center;","+  line-height: 1.5; max-width: 80%;","+}","+","+/* ===== 结算界面 ===== */","+.result-card {","+  flex: 1; display: flex; flex-direction: column;","+  align-items: center; justify-content: center;","+  background: linear-gradient(180deg, #FFFDF7, #F5F0E8);","+  padding: 40px 20px;","+}","+"," .result-title {","-  font-size: 36px;","-  font-weight: bold;","-  color: #C84B31;","-  margin-bottom: 20px;","+  font-size: 36px; color: #C84B31; margin-bottom: 16px;"," }"," ","-.stars {","-  display: flex;","-  gap: 10px;","-  margin-bottom: 20px;","+.result-stars {","+  font-size: 40px; color: #D4A843; margin-bottom: 20px;","+  display: flex; gap: 8px;"," }"," ","-.star {","-  font-size: 40px;","-  color: #D4A843;","+.result-stats {","+  text-align: center; margin-bottom: 24px; line-height: 2;","+  font-size: 16px;"," }","+.coins-earned {","+  font-size: 20px; font-weight: bold; color: #D4A843;","+  margin-top: 8px;","+}"," ","-.star.empty {","-  color: #ccc;","+.result-buttons {","+  display: flex; flex-direction: column; gap: 10px; width: 220px;"," }"," ","-.result-score, .result-coins {","-  font-size: 20px;","-  color: #2C2C2C;","-  margin: 10px 0;","+/* ===== 模态框 ===== */","+.modal {","+  position: absolute; top: 0; left: 0; right: 0; bottom: 0;","+  background: rgba(0,0,0,0.6); display: flex;","+  align-items: center; justify-content: center; z-index: 200;"," }","+.modal-content {","+  background: #FFFDF7; border-radius: 20px; padding: 30px;","+  text-align: center; max-width: 320px; width: 90%;","+}","+.modal-content h3 { font-size: 22px; color: #C84B31; margin-bottom: 12px; }","+.modal-content p { margin-bottom: 20px; color: #8B7355; }","+.modal-buttons { display: flex; gap: 12px; justify-content: center; }"]}],"originalFile":"/* 成语大闯关 - 国风主题样式 */\n\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n  user-select: none;\n  -webkit-user-select: none;\n}\n\nbody {\n  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;\n  background: linear-gradient(135deg, #F5F0E8 0%, #E8DED0 100%);\n  min-height: 100vh;\n  overflow: hidden;\n}\n\n#app {\n  width: 100%;\n  height: 100vh;\n  max-width: 600px;\n  margin: 0 auto;\n  position: relative;\n}\n\n.screen {\n  display: none;\n  width: 100%;\n  height: 100%;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 20px;\n}\n\n.screen.active {\n  display: flex;\n}\n\n/* 主菜单 */\n.title {\n  font-size: 48px;\n  font-weight: bold;\n  color: #C84B31;\n  margin-bottom: 10px;\n  text-shadow: 2px 2px 4px rgba(0,0,0,0.1);\n}\n\n.subtitle {\n  font-size: 24px;\n  color: #8B7355;\n  margin-bottom: 40px;\n}\n\n.btn-primary, .btn-secondary {\n  width: 200px;\n  padding: 15px 30px;\n  margin: 10px;\n  border: none;\n  border-radius: 25px;\n  font-size: 18px;\n  cursor: pointer;\n  transition: transform 0.1s;\n}\n\n.btn-primary {\n  background: linear-gradient(135deg, #C84B31 0%, #A63A22 100%);\n  color: white;\n}\n\n.btn-secondary {\n  background: linear-gradient(135deg, #2D6A4F 0%, #1E4D33 100%);\n  color: white;\n}\n\n.btn-primary:active, .btn-secondary:active {\n  transform: scale(0.95);\n}\n\n/* 游戏界面 */\n.game-header {\n  display: flex;\n  justify-content: space-between;\n  width: 100%;\n  padding: 10px;\n  background: rgba(255,255,255,0.8);\n  border-radius: 10px;\n  margin-bottom: 20px;\n}\n\n.level-info, .lives, .score {\n  font-size: 16px;\n  color: #2C2C2C;\n}\n\n.question-area {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n}\n\n.combo {\n  font-size: 24px;\n  color: #D4A843;\n  font-weight: bold;\n  height: 30px;\n  margin-bottom: 10px;\n}\n\n.meaning {\n  font-size: 18px;\n  color: #2C2C2C;\n  text-align: center;\n  padding: 15px;\n  background: white;\n  border-radius: 10px;\n  margin-bottom: 20px;\n  max-width: 90%;\n}\n\n.slots {\n  display: flex;\n  gap: 10px;\n  margin-bottom: 30px;\n}\n\n.slot {\n  width: 60px;\n  height: 60px;\n  border: 3px solid #8B7355;\n  border-radius: 10px;\n  background: white;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 28px;\n  font-weight: bold;\n  color: #2C2C2C;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.slot.filled {\n  background: #FFFDF7;\n  border-color: #C84B31;\n}\n\n.slot.correct {\n  background: #27AE60;\n  border-color: #27AE60;\n  color: white;\n  animation: correctPulse 0.4s;\n}\n\n.slot.wrong {\n  background: #E74C3C;\n  border-color: #E74C3C;\n  color: white;\n  animation: wrongShake 0.5s;\n}\n\n@keyframes correctPulse {\n  0%, 100% { transform: scale(1); }\n  50% { transform: scale(1.1); }\n}\n\n@keyframes wrongShake {\n  0%, 100% { transform: translateX(0); }\n  25% { transform: translateX(-10px); }\n  75% { transform: translateX(10px); }\n}\n\n.candidates {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  justify-content: center;\n  max-width: 100%;\n  margin-bottom: 20px;\n}\n\n.candidate {\n  width: 50px;\n  height: 50px;\n  border: none;\n  border-radius: 10px;\n  background: linear-gradient(135deg, #C84B31 0%, #A63A22 100%);\n  color: white;\n  font-size: 24px;\n  font-weight: bold;\n  cursor: pointer;\n  transition: transform 0.1s;\n}\n\n.candidate:active {\n  transform: scale(0.9);\n}\n\n.candidate.used {\n  opacity: 0.3;\n  pointer-events: none;\n}\n\n.tools {\n  display: flex;\n  gap: 10px;\n}\n\n.tool-btn {\n  width: 80px;\n  height: 50px;\n  border: none;\n  border-radius: 10px;\n  background: #2D6A4F;\n  color: white;\n  font-size: 14px;\n  cursor: pointer;\n}\n\n/* 结算界面 */\n.result-title {\n  font-size: 36px;\n  font-weight: bold;\n  color: #C84B31;\n  margin-bottom: 20px;\n}\n\n.stars {\n  display: flex;\n  gap: 10px;\n  margin-bottom: 20px;\n}\n\n.star {\n  font-size: 40px;\n  color: #D4A843;\n}\n\n.star.empty {\n  color: #ccc;\n}\n\n.result-score, .result-coins {\n  font-size: 20px;\n  color: #2C2C2C;\n  margin: 10px 0;\n}\n","userModified":false}}
