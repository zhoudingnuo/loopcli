, v), this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + dur);\n    osc.connect(gain);\n    gain.connect(this.ctx.destination);\n    osc.start(this.ctx.currentTime);\n    osc.stop(this.ctx.currentTime + dur);\n  }\n\n  _noise(dur, vol = null) {\n    if (!this.enabled || !this.ctx) return;\n    this._ensure();\n    if (!this.ctx) return;\n    const size = Math.floor(this.ctx.sampleRate * dur);\n    const buffer = this.ctx.createBuffer(1, size, this.ctx.sampleRate);\n    const data = buffer.getChannelData(0);\n    for (let i = 0; i < size; i++) data[i] = (Math.random() * 2 - 1) * 0.5;\n    const source = this.ctx.createBufferSource();\n    source.buffer = buffer;\n    const gain = this.ctx.createGain();\n    const v = (vol !== null ? vol : this.volume) * 0.15;\n    gain.gain.setValueAtTime(Math.max(0.001, v), this.ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + dur);\n    const filter = this.ctx.createBiquadFilter();\n    filter.type = 'highpass';\n    filter.frequency.setValueAtTime(2000, this.ctx.currentTime);\n    source.connect(filter);\n    filter.connect(gain);\n    gain.connect(this.ctx.destination);\n    source.start(this.ctx.currentTime);\n  }\n\n  playMatch(chain = 1) {\n    const base = 440 + (chain - 1) * 80;\n    this._tone(base, 0.12);\n    setTimeout(() => this._tone(base * 1.25, 0.1), 40);\n  }\n\n  playSwap() { this._tone(330, 0.08); }\n\n  playSpecial() {\n    this._tone(523, 0.08, 'square');\n    setTimeout(() => this._tone(659, 0.08, 'square'), 60);\n    setTimeout(() => this._tone(784, 0.12, 'square'), 120);\n  }\n\n  playCombo(level) {\n    const freqs = [523, 659, 784, 1047];\n    for (let i = 0; i < Math.min(level, freqs.length); i++) {\n      setTimeout(() => this._tone(freqs[i], 0.12), i * 80);\n    }\n  }\n\n  playObstacleBreak() {\n    this._noise(0.15);\n    this._tone(200, 0.12, 'sawtooth');\n  }\n\n  playBossHit() {\n    this._tone(150, 0.15, 'sawtooth', 0.6);\n    this._noise(0.1, 0.5);\n  }\n\n  playBossAbility() {\n    this._tone(100, 0.3, 'sawtooth', 0.5);\n    this._noise(0.2, 0.4);\n  }\n\n  playBossDefeat() {\n    [523, 659, 784, 1047, 1319].forEach((f, i) => {\n      setTimeout(() => this._tone(f, 0.25, 'square'), i * 100);\n    });\n  }\n\n  playLevelWin() {\n    [523, 659, 784, 1047].forEach((f, i) => {\n      setTimeout(() => this._tone(f, 0.2), i * 120);\n    });\n  }\n\n  playLevelFail() {\n    [440, 349, 294, 262].forEach((f, i) => {\n      setTimeout(() => this._tone(f, 0.25), i * 180);\n    });\n  }\n\n  playInvalid() {\n    this._tone(200, 0.1, 'square');\n    setTimeout(() => this._tone(180, 0.1, 'square'), 80);\n  }\n\n  toggle() {\n    this.enabled = !this.enabled;\n    return this.enabled;\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { AudioManager };\n","numLines":138,"startLine":1,"totalLines":138}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_dfbdf7dee2c146ad830361b7","type":"tool_result","content":"1\t# 成语大闯关（Idiom Master）— 详细立项文档\n2\t\n3\t> **版本**：1.0 | **日期**：2026-05-23 | **设计师**：游戏设计师 Agent\n4\t> **状态**：立项 — 待开发评审\n5\t> **关联文档**：[[douyin-mini-games-blueprint.md]] — 平台调研与初始概念；[[../douyin-match3/GDD.md]] — 三消游戏框架（可复用组件）\n6\t\n7\t---\n8\t\n9\t## 一、项目概览\n10\t\n11\t| 字段 | 值 |\n12\t|------|-----|\n13\t| 游戏名称 | 成语大闯关（Idiom Master） |\n14\t| 品类 | 文字益智（Word Puzzle） |\n15\t| 目标平台 | 抖音小游戏（优先）→ 微信小游戏 → H5 |\n16\t| 核心差异化 | 中文成语专项（蓝海品类）+ 抖音社交竞赛 + 轻量社交裂变 |\n17\t| 开发周期 | 3 周（单人全栈，含提审） |\n18\t| 目标 DAU | 首发 3K → 3 个月 30K |\n19\t| 变现模式 | IAA 为主（激励视频 + 插屏），后续叠加 IAP（皮肤/道具） |\n20\t| 包体目标 | < 2MB（纯文字 + 少量图标，极轻量） |\n21\t| 软著申请 | 与三消游戏同步，复用同一主体 |\n22\t\n23\t### 设计支柱（不可妥协）\n24\t\n25\t1. **15 秒内上手** — 看一眼就知道怎么玩，答题 = 点击选字，零解释\n26\t2. **每题都是微成就感** — 正确动画 + 连击 + 释义弹出，持续刺激\"我很聪明\"的满足感\n27\t3. **知识 = 社交货币** — 成绩可炫耀，PK 可分享，失败可求助，天然传播动力\n28\t4. **极低开发成本** — 纯文字渲染，无美术依赖，复用三消游戏的广告/社交/经济框架\n29\t\n30\t---\n31\t\n32\t## 二、竞品分析\n33\t\n34\t### 2.1 抖音热门成语游戏\n35\t\n36\t| 竞品 | 品类 | 核心玩法 | 日活估算 | 优势 | 短板 |\n37\t|------|------|----------|----------|------|------|\n38\t| **成语小秀才** | 文字益智 | 选字组词 + 官职升级 | 50K+ | 官职系统驱动长期留存 | 美术简陋，社交弱 |\n39\t| **成语大挑战** | 文字益智 | 看图猜成语 | 30K+ | 图文结合有新意 | 图片包体大，题库有限 |\n40\t| **疯狂猜成语** | 问答 | 图片/emoji 猜成语 | 20K+ | 短视频传播力强 | 题目质量参差不齐 |\n41\t| **成语消消乐** | 混合 | 三消 + 成语 | 10K+ | 创新融合 | 两套系统互相干扰 |\n42\t\n43\t### 2.2 竞品共性问题\n44\t\n45\t1. **社交裂变浅** — 大多只有分享领金币，缺乏深度互动\n46\t2. **内容运营弱** — 题库静态不更新，老玩家很快刷完\n47\t3. **变现设计粗暴** — 广告弹出频繁，严重影响体验\n48\t4. **视觉风格统一差** — 大多采用模板化 UI，无品牌辨识度\n49\t\n50\t### 2.3 我们的差异化策略\n51\t\n52\t| 维度 | 竞品做法 | 我们的做法 |\n53\t|------|----------|-----------|\n54\t| 核心玩法 | 单一模式 | 闯关 + 限时 + PK 三模式 |\n55\t| 社交 | 分享领金币 | 好友 PK + 求助 + 每日挑战排行 |\n56\t| 内容运营 | 固定题库 | 每周更新 + 玩家投稿 + AI 扩充 |\n57\t| 变现 | 强制广告 | 70%+ 激励视频（用户主动选择） |\n58\t| 视觉 | 模板 UI | 国风主题 + 角色皮肤系统 |\n59\t| 长期留存 | 无 | 成语图鉴收集 + 称号系统 + 角色养成 |\n60\t\n61\t---\n62\t\n63\t## 三、核心玩法机制设计\n64\t\n65\t### 3.1 基本规则\n66\t\n67\t- 屏幕上方显示成语的**释义**（如\"形容非常开心\"）\n68\t- 中间显示 **4 个空位**（组成完整成语）\n69\t- 下方显示 **8-12 个候选字**（含 4 个正确字 + 干扰字）\n70\t- 玩家**依次点击** 4 个正确字，按正确顺序填入空位\n71\t- 答对 → 绿色闪光 + 释义弹出 + 连击 +1 → 下一题\n72\t- 答错 → 红色抖动 + 字飞回 + 失去 1 条命（初始 5 条命）\n73\t\n74\t### 3.2 出题引擎规格\n75\t\n76\t```\n77\t输入：成语数据库（idioms.json）+ 难度等级 + 关卡配置\n78\t输出：一道完整的成语题\n79\t\n80\t算法：\n81\t1. 根据关卡难度等级，从题库中随机选取一个成语\n82\t2. 生成干扰字池：\n83\t   a. 优先从同类别成语中取字（如动物类成语取动物相关字）\n84\t   b. 补充形近字（如\"己\"/\"已\"/\"巳\"）\n85\t   c. 补充音近字（如\"画\"/\"话\"）\n86\t   d. 确保干扰字与正确字不重复\n87\t3. 将正确字 + 干扰字随机排列（8-12 个）\n88\t4. 记录正确答案的索引顺序（用于判定）\n89\t\n90\t干扰字数量规则：\n91\t- ★ 简单：4 正确 + 4 干扰 = 8 候选\n92\t- ★★ 中等：4 正确 + 6 干扰 = 10 候选\n93\t- ★★★ 困难：4 正确 + 8 干扰 = 12 候选\n94\t- ★★★★ 大师：4 正确 + 8 干扰 = 12 候选（干扰字更相似）\n95\t\n96\t性能要求：出题 < 10ms（纯内存操作）\n97\t```\n98\t\n99\t### 3.3 答题判定逻辑\n100\t\n101\t```\n102\t状态：4 个空位 slot[0..3]，当前已填 fillCount\n103\t玩家点击候选字 candidate[i]：\n104\t  → 候选字飞入 slot[fillCount]\n105\t  → fillCount++\n106\t  → 如果 fillCount == 4：\n107\t      → 检查 slot[0..3] 是否等于 idiom.chars[0..3]\n108\t      → 正确：触发\"正确\"动画链\n109\t      → 错误：触发\"错误\"动画链，slot 清空，fillCount = 0\n110\t  → 如果 fillCount < 4：\n111\t      → 等待继续点击\n112\t\n113\t撤销机制：\n114\t  → 点击已填入的 slot[i]：该字飞回候选区，后续 slot 自动左移\n115\t  → 仅在\"撤销提示\"道具激活时可用（默认不可撤销已填字）\n116\t```\n117\t\n118\t### 3.4 三种游戏模式\n119\t\n120\t#### 模式一：闯关模式（核心进度）\n121\t\n122\t| 规则 | 说明 |\n123\t|------|------|\n124\t| 每关题数 | 10 题 |\n125\t| 生命值 | 初始 5 条命 |\n126\t| 通关条件 | 答完 10 题（允许使用提示/跳过） |\n127\t| 星级评定 | 按正确率：≥9 对 = 3 星，≥7 对 = 2 星，≥5 对 = 1 星 |\n128\t| 失败条件 | 生命值归零 |\n129\t| 难度递进 | 每 10 关提升一个难度等级 |\n130\t\n131\t#### 模式二：限时挑战\n132\t\n133\t| 规则 | 说明 |\n134\t|------|------|\n135\t| 时间 | 60 秒倒计时 |\n136\t| 题目 | 无限出题，难度随机（偏中等） |\n137\t| 得分 | 每题基础 100 分 + 连击加成（连击数 × 20） |\n138\t| 结束 | 倒计时结束 → 结算 |\n139\t| 排行榜 | 全局 + 好友 |\n140\t\n141\t#### 模式三：好友 PK\n142\t\n143\t| 规则 | 说明 |\n144\t|------|------|\n145\t| 题数 | 5 题 |\n146\t| 机制 | 双方答相同题目，互不知对方进度 |\n147\t| 胜负 | 正确率高者胜；相同则比用时 |\n148\t| 奖励 | 胜者 +50 金币 + 1 PK 积分 |\n149\t| 裂变 | PK 结果页 → 一键分享到抖音 |\n150\t\n151\t### 3.5 连击系统（核心爽感来源）\n152\t\n153\t```\n154\t连续答对触发连击：\n155\t- 3 连击：+60 分加成 → \"不错！\" 文字弹出 + 音效升调\n156\t- 5 连击：+100 分加成 → \"厉害了！\" + 屏幕微震 + 粒子特效\n157\t- 8 连击：+160 分加成 → \"学霸！\" + 全屏金色光效\n158\t- 10+ 连击：+200+ 分加成 → \"成语大师！！\" + 烟花特效 + 额外 1 金币\n159\t\n160\t连击断裂：\n161\t- 答错或使用跳过 → 连击归零\n162\t- 使用提示答对 → 连击继续，但本题不计加分\n163\t\n164\t动画时间预算（单题交互总时间不超过 1.5 秒）：\n165\t- 点击填字：0.15s\n166\t- 正确动画：0.4s（绿色闪光 + 释义弹出）\n167\t- 错误动画：0.5s（红色抖动 + 字飞回）\n168\t- 连击特效：0.3s（叠加在正确动画上）\n169\t```\n170\t\n171\t### 3.6 失败与续命\n172\t\n173\t| 事件 | 玩家选择 | 结果 |\n174\t|------|----------|------|\n175\t| 生命值归零 | 看激励视频（30s） | 恢复 3 条命，可续命 1 次 |\n176\t| 生命值归零 | 使用 10 金币购买 | 恢复 3 条命 |\n177\t| 生命值归零 | 放弃 | 回到关卡地图，保留已获星星 |\n178\t\n179\t---\n180\t\n181\t## 四、关卡系统设计（首发 50 关）\n182\t\n183\t### 4.1 关卡数据结构\n184\t\n185\t```json\n186\t{\n187\t  \"id\": 1,\n188\t  \"chapter\": 1,\n189\t  \"difficulty\": 1,\n190\t  \"questions\": 10,\n191\t  \"lives\": 5,\n192\t  \"stars\": [5, 7, 9],\n193\t  \"reward\": { \"coins\": 20, \"exp\": 10 },\n194\t  \"idiom_pool\": [\"easy_01\", \"easy_02\"],\n195\t  \"category\": [\"常用\", \"动物\"],\n196\t  \"tutorial_step\": \"T1\"\n197\t}\n198\t```\n199\t\n200\t| 字段 | 类型 | 说明 |\n201\t|------|------|------|\n202\t| id | int | 关卡编号 |\n203\t| chapter | int | 章节编号 |\n204\t| difficulty | int | 难度等级（1-4） |\n205\t| questions | int | 题目数量 |\n206\t| lives | int | 初始生命 |\n207\t| stars | int[3] | 1/2/3 星正确数阈值 |\n208\t| reward | object | 通关奖励（金币 + 经验） |\n209\t| idiom_pool | string[] | 本关出题池（可选，为空则按难度随机） |\n210\t| category | string[] | 成语类别限制 |\n211\t| tutorial_step | string/null | 关联教学步骤 |\n212\t\n213\t### 4.2 前 50 关详细设计\n214\t\n215\t#### 第 1-5 关：新手教学（零失败区）\n216\t\n217\t| 关卡 | 难度 | 生命 | 星级阈值 | 候选字数 | 教学内容 |\n218\t|------|------|------|----------|----------|----------|\n219\t| 1 | ★ | 5 | [3, 4, 5] | 8 | 强制引导：高亮正确字，引导逐字点击 |\n220\t| 2 | ★ | 5 | [3, 4, 5] | 8 | 半引导：只提示第一个字 |\n221\t| 3 | ★ | 5 | [4, 5, 5] | 8 | 自由作答，成语极简（一心一意、画蛇添足等） |\n222\t| 4 | ★ | 5 | [4, 5, 5] | 8 | 引入释义提示按钮（免费） |\n223\t| 5 | ★ | 5 | [4, 5, 5] | 8 | 引入连击概念，连对 3 题触发特效 |\n224\t\n225\t**设计原则**：\n226\t- 前 5 关保证所有玩家都能 3 星通关\n227\t- 成语选取最常见的日常用语\n228\t- 释义用白话文，不用文言原文\n229\t- 每关第 1 题必是最简单的成语（如\"心花怒放\"）\n230\t\n231\t#### 第 6-15 关：简单进阶（建立习惯）\n232\t\n233\t| 关卡 | 难度 | 生命 | 星级阈值 | 新元素 |\n234\t|------|------|------|----------|--------|\n235\t| 6 | ★ | 5 | [5, 7, 9] | 标准规则 |\n236\t| 7 | ★ | 5 | [5, 7, 9] | 引入\"去干扰\"道具（首次免费） |\n237\t| 8 | ★ | 5 | [5, 7, 9] | 引入\"跳过\"功能 |\n238\t| 9 | ★ | 5 | [5, 7, 9] | — |\n239\t| 10 | ★ | 5 | [5, 7, 9] | Boss 关：10 题全对额外奖励 50 金币 |\n240\t| 11 | ★ | 4 | [5, 7, 9] | 生命值降至 4 |\n241\t| 12 | ★ | 4 | [5, 7, 9] | — |\n242\t| 13 | ★ | 4 | [5, 7, 9] | 引入双类别混合（动物+数字） |\n243\t| 14 | ★ | 4 | [5, 7, 9] | — |\n244\t| 15 | ★ | 4 | [5, 7, 9] | Boss 关：正确率 ≥80% 通关 |\n245\t\n246\t#### 第 16-30 关：中等难度（策略性增强）\n247\t\n248\t| 关卡段 | 难度 | 生命 | 候选字数 | 新元素 |\n249\t|--------|------|------|----------|--------|\n250\t| 16-20 | ★★ | 4 | 10 | 中等成语（望梅止渴、纸上谈兵等） |\n251\t| 21-25 | ★★ | 3 | 10 | 生命降至 3，需要更谨慎 |\n252\t| 26-30 | ★★ | 3 | 10 | 引入形近干扰（己/已、蓝/篮等） |\n253\t\n254\t#### 第 31-45 关：困难挑战（硬核考验）\n255\t\n256\t| 关卡段 | 难度 | 生命 | 候选字数 | 新元素 |\n257\t|--------|------|------|----------|--------|\n258\t| 31-35 | ★★★ | 3 | 12 | 困难成语（沆瀣一气、韦编三绝等） |\n259\t| 36-40 | ★★★ | 3 | 12 | 音近干扰（画/话、故/顾等） |\n260\t| 41-45 | ★★★ | 3 | 12 | 混合干扰（形近 + 音近） |\n261\t\n262\t#### 第 46-50 关：大师挑战（里程碑）\n263\t\n264\t| 关卡 | 难度 | 生命 | 特殊规则 |\n265\t|------|------|------|----------|\n266\t| 46-49 | ★★★★ | 3 | 生僻成语 + 最大干扰 + 无释义提示 |\n267\t| 50 | ★★★★ | 3 | Boss 关：12 题全对 = 传说称号 + 200 金币 |\n268\t\n269\t### 4.3 章节结构（每 10 关一个章节）\n270\t\n271\t| 章节 | 主题 | 关卡 | 视觉风格 |\n272\t|------|------|------|----------|\n273\t| 第一章 | 初学启蒙 | 1-10 | 书院·晨光（浅黄暖色） |\n274\t| 第二章 | 蒙学进阶 | 11-20 | 书院·午后（橙色暖调） |\n275\t| 第三章 | 经典成语 | 21-30 | 书院·夕阳（深橙红） |\n276\t| 第四章 | 典故深处 | 31-40 | 书院·月夜（深蓝紫） |\n277\t| 第五章 | 博学大师 | 41-50 | 书院·星辰（星空金黑） |\n278\t\n279\t### 4.4 关卡验证规则\n280\t\n281\t- 每关题池至少 15 个成语（10 个必答 + 5 个备用）\n282\t- 所有成语必须经过人工审核：释义准确、出处可查\n283\t- ★ 简单关成语必须在《新华字典》常用词表中\n284\t- 干扰字不能组成其他有效成语（避免歧义）\n285\t- Boss 关题目从固定池中选取（保证公平性）\n286\t\n287\t---\n288\t\n289\t## 五、角色/皮肤系统\n290\t\n291\t### 5.1 角色（导师系统）\n292\t\n293\t| 角色 | 主题 | 技能 | 获取方式 |\n294\t|------|------|------|----------|\n295\t| **书童小明** | 基础 | 答错时有 20% 概率不扣命 | 初始角色 |\n296\t| **才女小红** | 中等 | 每关首次使用提示不消耗次数 | 通过 20 关解锁 |\n297\t| **状元先生** | 高级 | 连击加分 ×1.5 倍 | 收集 80 碎片兑换 |\n298\t| **诗仙李白** | 稀有 | 答对时额外获得 1 经验 | 月卡/活动限定 |\n299\t\n300\t### 5.2 角色皮肤（视觉自定义）\n301\t\n302\t| 皮肤 | 风格 | 获取方式 | 价格 |\n303\t|------|------|----------|------|\n304\t| 经典蓝袍 | 默认 | 初始 | 免费 |\n305\t| 红色喜庆 | 节日风 | 春节活动 | 限时 |\n306\t| 青绿山水 | 国风 | 图鉴收集 100 个成语 | 100 金币 |\n307\t| 金色荣耀 | 奢华 | PK 积分达到 100 | 200 金币 |\n308\t| Q版萌趣 | 可爱 | 首次充值（后续） | ¥6 |\n309\t\n310\t### 5.3 背景皮肤（答题界面背景）\n311\t\n312\t| 背景 | 风格 | 获取 |\n313\t|------|------|------|\n314\t| 水墨竹影 | 国风淡雅 | 初始 |\n315\t| 春日桃林 | 花开满屏 | 通关第 2 章 |\n316\t| 秋月寒江 | 冷色调 | 通关第 3 章 |\n317\t| 星河夜空 | 梦幻 | 通关第 4 章 |\n318\t| 古典书斋 | 木质纹理 | 收集 200 个成语 |\n319\t\n320\t---\n321\t\n322\t## 六、社交裂变机制\n323\t\n324\t### 6.1 好友 PK 挑战（核心裂变）\n325\t\n326\t```\n327\t流程：\n328\t1. 玩家 A 在 PK 模式中选择好友 → 生成挑战链接\n329\t2. 分享到抖音（视频/消息）\n330\t3. 玩家 B 点击链接 → 进入游戏 → 答相同 5 题\n331\t4. 双方各答完 → 揭晓结果\n332\t5. 结果页：\n333\t   - 胜方：胜利动画 + 奖杯 + \"+50 金币\"\n334\t   - 败方：鼓励文字 + \"不服？再来一局\" → 分享按钮\n335\t6. 核心裂变：不服输 → 再来 → 分享给更多人\n336\t\n337\tPK 积分系统：\n338\t- 胜 +3 分，平 +1 分，负 +0 分\n339\t- 每周重置排行\n340\t- 前 10 名获得称号 + 金币奖励\n341\t```\n342\t\n343\t### 6.2 \"你能全对吗？\" 短视频分享\n344\t\n345\t```\n346\t触发条件：连对 5+ 题 / 通关 Boss 关 / PK 胜利\n347\t自动生成 15 秒短视频：\n348\t  - 答题过程回放（加速 ×2）\n349\t  - 连击特效叠加\n350\t  - 最终得分 + \"你能超越我吗？\"\n351\t一键分享到抖音 → 带游戏入口链接\n352\t```\n353\t\n354\t### 6.3 求助好友\n355\t\n356\t```\n357\t触发条件：答错且只剩 1 条命\n358\t选项：\"求助好友\" → 生成分享卡片\n359\t好友点击 → 好友获得 10 金币 + 玩家恢复 1 条命\n360\t每日求助上限：3 次\n361\t```\n362\t\n363\t### 6.4 每日成语挑战\n364\t\n365\t```\n366\t每天 1 道特殊题（全平台统一）：\n367\t  - 成语 + 图片提示（如一张画了蛇和脚的图 → 画蛇添足）\n368\t  - 或：emoji 组合猜成语\n369\t  - 难度偏中高\n370\t  - 全平台排行榜：\"今日全对率：23%\"\n371\t  - FOMO 驱动：\"只有 12% 的人答对了今天的题目\"\n372\t\n373\t奖励：\n374\t  - 答对：50 金币 + 1 碎片\n375\t  - 分享答题结果到抖音：额外 20 金币\n376\t```\n377\t\n378\t### 6.5 好友排行榜\n379\t\n380\t```\n381\t维度：\n382\t  - 闯关进度（已通关数）\n383\t  - 限时挑战最高分\n384\t  - PK 积分\n385\t  - 图鉴收集数\n386\t使用 tt.getFriendCloudStorage() 实时获取好友数据\n387\t```\n388\t\n389\t---\n390\t\n391\t## 七、变现方案\n392\t\n393\t### 7.1 广告收入（IAA — 主力）\n394\t\n395\t#### 广告位详细设计\n396\t\n397\t**广告位 1：揭示 1 字（激励视频）**\n398\t\n399\t| 属性 | 值 |\n400\t|------|-----|\n401\t| 触发条件 | 答题中，玩家点击\"揭示\"按钮 |\n402\t| 广告类型 | 激励视频（穿山甲 rewardedVideoAd） |\n403\t| 视频时长 | 15-30 秒 |\n404\t| 用户奖励 | 自动填入第 1 个正确字 |\n405\t| UI 设计 | 答题区上方小按钮：\"揭示 1 字 📖\" + 播放图标 |\n406\t| 预估触发率 | 每关使用 1-2 次，约 60-70% 玩家会使用 |\n407\t\n408\t**广告位 2：去干扰（激励视频）**\n409\t\n410\t| 属性 | 值 |\n411\t|------|-----|\n412\t| 触发条件 | 答题中，玩家点击\"去干扰\"按钮 |\n413\t| 广告类型 | 激励视频 |\n414\t| 用户奖励 | 移除 2 个错误候选字 |\n415\t| UI 设计 | 候选字区下方按钮：\"去掉 2 个 ✂️\" |\n416\t| 预估触发率 | 每关 1-2 次，约 50% 玩家使用 |\n417\t\n418\t**广告位 3：双倍结算（激励视频）**\n419\t\n420\t| 属性 | 值 |\n421\t|------|-----|\n422\t| 触发条件 | 关卡结算页 |\n423\t| 广告类型 | 激励视频 |\n424\t| 用户奖励 | 本关金币奖励翻倍 |\n425\t| UI 设计 | 结算页底部：\"领取 ×1\" vs \"看视频领取 ×2\" |\n426\t| 预估触发率 | 55-65%（成功心情好，接受度高） |\n427\t\n428\t**广告位 4：额外生命（激励视频）**\n429\t\n430\t| 属性 | 值 |\n431\t|------|-----|\n432\t| 触发条件 | 生命值归零，游戏结束 |\n433\t| 广告类型 | 激励视频 |\n434\t| 用户奖励 | 恢复 3 条命，继续答题 |\n435\t| UI 设计 | 失败弹窗：左侧\"结束\"，右侧\"看视频继续\"（金色高亮） |\n436\t| 预估触发率 | 70-80%（沉没成本高，续命意愿强） |\n437\t\n438\t**广告位 5：关卡间插屏**\n439\t\n440\t| 属性 | 值 |\n441\t|------|-----|\n442\t| 触发条件 | 每通过 2 关后，结算页 → 返回地图时 |\n443\t| 广告类型 | 插屏广告（5 秒后可关闭） |\n444\t| 用户奖励 | 无 |\n445\t| UI 设计 | 全屏展示，右上角 5 秒倒计时 |\n446\t| 预估频率 | 2-3 次/天 |\n447\t\n448\t**广告位 6：每日签到翻倍**\n449\t\n450\t| 属性 | 值 |\n451\t|------|-----|\n452\t| 触发条件 | 每日登录签到时 |\n453\t| 广告类型 | 激励视频 |\n454\t| 用户奖励 | 今日签到奖励翻倍 |\n455\t\n456\t### 7.2 广告频率控制（防骚扰）\n457\t\n458\t```\n459\t规则：\n460\t- 同一广告位两次触发最小间隔：90 秒\n461\t- 激励视频每日总上限：15 次\n462\t- 插屏广告每日总上限：8 次\n463\t- 连续 2 次失败后暂停插屏展示\n464\t- 新用户前 3 关不展示任何广告\n465\t- 限时挑战模式不展示插屏（沉浸体验）\n466\t```\n467\t\n468\t### 7.3 收入预估\n469\t\n470\t| DAU | 激励视频/DAU | 插屏/DAU | 激励 eCPM | 插屏 eCPM | 日收入 | 月收入 |\n471\t|-----|-------------|----------|-----------|-----------|--------|--------|\n472\t| 3K | 4 次 | 2 次 | ¥80 | ¥35 | ¥1,020 | ¥30,600 |\n473\t| 10K | 4 次 | 2 次 | ¥80 | ¥35 | ¥3,400 | ¥102,000 |\n474\t| 30K | 4 次 | 2 次 | ¥80 | ¥35 | ¥10,200 | ¥306,000 |\n475\t\n476\t> ARPU ≈ ¥0.34/天\n477\t\n478\t**扣除平台分成（40%）后开发者实得：月 ¥18,360（3K DAU）/ ¥61,200（10K DAU）/ ¥183,600（30K DAU）**\n479\t\n480\t### 7.4 内购道具（V1.1 迭代）\n481\t\n482\t| 道具 | 价格（¥） | 效果 | 上线时机 |\n483\t|------|-----------|------|----------|\n484\t| 去广告 | 8 | 永久移除插屏，激励视频按钮变为金币购买 | V1.1 |\n485\t| 金币包 S | 3 | 200 金币 | V1.1 |\n486\t| 金币包 M | 12 | 1000 金币（+10% 赠送） | V1.1 |\n487\t| 金币包 L | 25 | 2500 金币（+20% 赠送） | V1.1 |\n488\t| 月卡 | 15/月 | 每日 100 金币 + 专属皮肤 + 去广告 | V1.2 |\n489\t\n490\t### 7.5 盈利关键假设 [待测试]\n491\t\n492\t| 假设 | 基础值 | 依据 |\n493\t|------|--------|------|\n494\t| 激励视频 eCPM | ¥80/千次 | 文字益智品类中位数 |\n495\t| 留存率 | 次日 35%，7 日 18%，30 日 6% | 文字游戏品类平均 |\n496\t| 人均广告次数 | 6 次/天 | 与调研数据一致 |\n497\t| 视频完成率 | 90% | 教育类用户观看意愿高 |\n498\t| 限时挑战参与率 | 40% DAU | 基于竞品数据估算 |\n499\t| PK 裂变系数 | 1.3（每个用户带来 0.3 个新用户） | 文字游戏社交传播效率 |\n500\t\n501\t---\n502\t\n503\t## 八、技术方案\n504\t\n505\t### 8.1 技术栈选型\n506\t\n507\t| 组件 | 选型 | 理由 |\n508\t|------|------|------|\n509\t| 渲染引擎 | **TTML + TTSS**（抖音小程序原生） | 纯文字游戏，DOM 渲染更快开发，无需 Canvas |\n510\t| 编程语言 | **原生 JavaScript**（ES6+） | 最小依赖，最快开发 |\n511\t| 动画 | CSS Animation + JS 补间 | 文字飞入/弹出效果用 CSS 足够 |\n512\t| 音频 | `tt.createInnerAudioContext()` | 抖音原生 API |\n513\t| 广告 | 穿山甲 SDK（csjplatform.com） | 抖音官方广告平台 |\n514\t| 数据存储 | `tt.setStorageSync()` + 云开发 | 本地进度 + 云端排行/PK |\n515\t| 社交 | `tt.shareAppMessage()` + `tt.getFriendCloudStorage()` | 抖音好友关系链 |\n516\t| 构建工具 | 无 | 小程序直接上传开发者工具 |\n517\t\n518\t**选择 TTML（DOM）而非 Canvas 的理由**：\n519\t- 成语游戏无复杂图形，文字 + 按钮 = DOM 更高效\n520\t- CSS 动画性能足够（文字飞入、缩放、抖动）\n521\t- 开发效率比 Canvas 高 30-40%\n522\t- 可复用三消游戏的广告管理、社交、经济模块\n523\t\n524\t### 8.2 项目文件结构\n525\t\n526\t```\n527\tidiom-master/\n528\t├── app.js                    # 小程序入口（App 生命周期）\n529\t├── app.json                  # 页面路由 + 全局配置\n530\t├── app.ttss                  # 全局样式（国风主题）\n531\t├── project.config.json       # 抖音开发者工具配置\n532\t│\n533\t├── pages/\n534\t│   ├── home/                 # 主页\n535\t│   │   ├── index.js          # 模式选择 + 每日入口 + 角色/地图入口\n536\t│   │   ├── index.ttml\n537\t│   │   └── index.ttss\n538\t│   ├── play/                 # 答题页\n539\t│   │   ├── index.js          # 出题逻辑 + 答题判定 + 连击系统\n540\t│   │   ├── index.ttml\n541\t│   │   └── index.ttss\n542\t│   ├── result/               # 结算页\n543\t│   │   ├── index.js          # 星级 + 奖励 + 广告（双倍）+ 分享\n544\t│   │   ├── index.ttml\n545\t│   │   └── index.ttss\n546\t│   ├── timed/                # 限时挑战\n547\t│   │   ├── index.js          # 60s 倒计时 + 无限出题 + 排行榜提交\n548\t│   │   ├── index.ttml\n549\t│   │   └── index.ttss\n550\t│   ├── pk/                   # 好友 PK\n551\t│   │   ├── index.js          # 5 题 PK + 结果揭晓\n552\t│   │   ├── index.ttml\n553\t│   │   └── index.ttss\n554\t│   ├── collection/           # 成语图鉴\n555\t│   │   ├── index.js          # 分类浏览 + 搜索 + 详情\n556\t│   │   ├── index.ttml\n557\t│   │   └── index.ttss\n558\t│   ├── leaderboard/          # 排行榜\n559\t│   │   ├── index.js          # 好友排行 + 全局排行\n560\t│   │   ├── index.ttml\n561\t│   │   └── index.ttss\n562\t│   ├── characters/           # 角色选择\n563\t│   │   ├── index.js          # 角色列表 + 技能 + 皮肤\n564\t│   │   ├── index.ttml\n565\t│   │   └── index.ttss\n566\t│   └── daily/                # 每日挑战\n567\t│       ├── index.js          # 每日 1 题 + 统计\n568\t│       ├── index.ttml\n569\t│       └── index.ttss\n570\t│\n571\t├── components/\n572\t│   ├── tile-char/            # 候选字组件（点击 + 飞入动画）\n573\t│   │   ├── index.js\n574\t│   │   ├── index.ttml\n575\t│   │   └── index.ttss\n576\t│   ├── idiom-slot/           # 成语填空组件（4 个空位）\n577\t│   │   ├── index.js\n578\t│   │   ├── index.ttml\n579\t│   │   └── index.ttss\n580\t│   ├── ad-modal/             # 广告弹窗组件（激励视频/插屏通用）\n581\t│   │   ├── index.js\n582\t│   │   ├── index.ttml\n583\t│   │   └── index.ttss\n584\t│   ├── combo-display/        # 连击显示组件（数字 + 特效）\n585\t│   ├── star-rating/          # 星级评定组件\n586\t│   └── share-card/           # 分享卡片生成组件\n587\t│\n588\t├── utils/\n589\t│   ├── idiom-engine.js       # 出题引擎（选题 + 干扰字生成）\n590\t│   ├── judge.js              # 答题判定（正确/错误/撤销）\n591\t│   ├── combo.js              # 连击计算与特效触发\n592\t│   ├── pk-logic.js           # PK 匹配、出题同步、结算\n593\t│   ├── ad-manager.js         # 穿山甲广告管理（从三消项目复用）\n594\t│   ├── social.js             # 分享 + 好友关系链（从三消项目复用）\n595\t│   ├── economy.js            # 金币/提示经济系统（从三消项目复用）\n596\t│   ├── storage.js            # 持久化封装（从三消项目复用）\n597\t│   ├── daily.js              # 每日挑战 + 每日任务\n598\t│   └── cloud.js              # 云开发封装（排行榜 + PK 数据）\n599\t│\n600\t├── data/\n601\t│   ├── idioms/               # 成语数据库（按难度分文件）\n602\t│   │   ├── easy.json         # ★ 简单（500 个）\n603\t│   │   ├── medium.json       # ★★ 中等（500 个）\n604\t│   │   ├── hard.json         # ★★★ 困难（500 个）\n605\t│   │   └── master.json       # ★★★★ 大师（500 个）\n606\t│   ├── levels.json           # 关卡配置（50 关）\n607\t│   ├── characters.json       # 角色配置\n608\t│   ├── skins.json            # 皮肤配置\n609\t│   ├── daily-tasks.json      # 每日任务模板\n610\t│   └── economy.json          # 经济数值配置\n611\t│\n612\t├── assets/\n613\t│   ├── icons/                # 分类图标（动物/数字/历史等，< 50KB）\n614\t│   ├── characters/           # 角色头像（4 个 × 16KB = 64KB）\n615\t│   ├── backgrounds/          # 答题背景（5 个 × 30KB = 150KB）\n616\t│   ├── effects/              # 特效帧（连击/正确/错误，< 100KB）\n617\t│   └── audio/                # 音效（< 200KB 总计）\n618\t│       ├── sfx/              # 短音效\n619\t│       └── bgm/              # 背景音乐\n620\t│\n621\t└── README.md\n622\t```\n623\t\n624\t### 8.3 可复用三消游戏框架的模块\n625\t\n626\t| 模块 | 三消项目文件 | 复用程度 | 修改内容 |\n627\t|------|-------------|----------|----------|\n628\t| 广告管理 | `ad-manager.js` | **90%** | 调整广告位配置 |\n629\t| 社交分享 | `social.js` | **80%** | 改分享文案和图片 |\n630\t| 经济系统 | `economy.js` | **70%** | 调整金币数值 |\n631\t| 数据存储 | `storage.js` | **95%** | 几乎直接复用 |\n632\t| 云开发 | `cloud.js` | **80%** | 调整排行榜字段 |\n633\t| 平台适配 | `platform/` | **100%** | 完全复用 |\n634\t\n635\t**预估框架复用可节省 40-50% 开发时间。**\n636\t\n637\t### 8.4 成语数据库设计\n638\t\n639\t```json\n640\t{\n641\t  \"id\": \"idiom_00001\",\n642\t  \"idiom\": \"画蛇添足\",\n643\t  \"chars\": [\"画\", \"蛇\", \"添\", \"足\"],\n644\t  \"pinyin\": \"huà shé tiān zú\",\n645\t  \"meaning\": \"比喻做了多余的事，反而不恰当\",\n646\t  \"origin\": \"《战国策·齐策二》\",\n647\t  \"example\": \"你已经写得很好了，再修改就是画蛇添足。\",\n648\t  \"difficulty\": 1,\n649\t  \"category\": [\"动物\", \"寓言\"],\n650\t  \"tags\": [\"小学\", \"常用\"],\n651\t  \"distractors_easy\": [\"龙\", \"虎\", \"飞\", \"跑\"],\n652\t  \"distractors_hard\": [\"化\", \"它\", \"捻\", \"促\"],\n653\t  \"frequency\": 95\n654\t}\n655\t```\n656\t\n657\t**数据库字段说明**：\n658\t\n659\t| 字段 | 类型 | 说明 |\n660\t|------|------|------|\n661\t| id | string | 唯一标识 |\n662\t| idiom | string | 成语原文 |\n663\t| chars | string[4] | 四个字（有序） |\n664\t| pinyin | string | 拼音（带声调） |\n665\t| meaning | string | 白话文释义 |\n666\t| origin | string | 出处 |\n667\t| example | string | 例句 |\n668\t| difficulty | int | 难度等级（1-4） |\n669\t| category | string[] | 类别标签 |\n670\t| tags | string[] | 附加标签 |\n671\t| distractors_easy | string[] | 简单干扰字（形音差异大） |\n672\t| distractors_hard | string[] | 困难干扰字（形近/音近） |\n673\t| frequency | int | 使用频率（1-100，100 最常用） |\n674\t\n675\t### 8.5 数据获取策略\n676\t\n677\t| 阶段 | 方式 | 数量 | 时间 |\n678\t|------|------|------|------|\n679\t| **首发** | AI 辅助生成 + 人工审核 | 2,000 条 | W1-W2 |\n680\t| **V1.1** | 公开成语词典数据（合规抓取） | +3,000 条 | 上线后 2 周 |\n681\t| **持续** | 每周新增 50 条 + 玩家投稿 | +200 条/月 | 持续 |\n682\t\n683\t**AI 生成流程**：\n684\t1. 从《汉语成语大词典》提取成语列表（公开数据）\n685\t2. AI 批量生成释义、拼音、例句、干扰字\n686\t3. 人工审核：释义准确性、例句自然度、干扰字合理性\n687\t4. 按难度分类 + 打标签\n688\t5. 导入 JSON 数据库\n689\t\n690\t### 8.6 抖音小游戏 SDK 集成要点\n691\t\n692\t#### 入口文件 app.js\n693\t\n694\t```javascript\n695\tApp({\n696\t  onLaunch() {\n697\t    // 初始化广告\n698\t    this.adManager = new AdManager();\n699\t    this.adManager.init();\n700\t\n701\t    // 初始化存储\n702\t    this.storage = new Storage();\n703\t    this.storage.init();\n704\t\n705\t    // 获取用户信息\n706\t    tt.login({\n707\t      success: (res) => {\n708\t        this.userId = res.code;\n709\t      }\n710\t    });\n711\t  },\n712\t  globalData: {\n713\t    userId: null,\n714\t    adManager: null,\n715\t    storage: null\n716\t  }\n717\t});\n718\t```\n719\t\n720\t#### 出题引擎核心\n721\t\n722\t```javascript\n723\t// idiom-engine.js\n724\tclass IdiomEngine {\n725\t  constructor(idiomDB) {\n726\t    this.db = idiomDB; // 按难度分组的成语数据\n727\t    this.history = [];  // 已出题目（避免重复）\n728\t  }\n729\t\n730\t  generateQuestion(difficulty) {\n731\t    const pool = this.db.getByDifficulty(difficulty);\n732\t    const idiom = this.pickRandom(pool, this.history);\n733\t    this.history.push(idiom.id);\n734\t\n735\t    const distractorCount = [0, 4, 6, 8, 8][difficulty];\n736\t    const distractors = idiom.distractors_hard\n737\t      ? idiom.distractors_hard.slice(0, distractorCount)\n738\t      : this.generateDistractors(idiom, distractorCount);\n739\t\n740\t    return {\n741\t      idiom: idiom,\n742\t      slots: [null, null, null, null],\n743\t      candidates: this.shuffle([...idiom.chars, ...distractors]),\n744\t      answered: false\n745\t    };\n746\t  }\n747\t}\n748\t```\n749\t\n750\t---\n751\t\n752\t## 九、美术风格定义\n753\t\n754\t### 9.1 主题\n755\t\n756\t**\"国风书斋\"** — 中国传统文化气息，水墨淡雅，有书卷气但不老气\n757\t\n758\t### 9.2 色彩规范\n759\t\n760\t| 用途 | 颜色 | HEX | 说明 |\n761\t|------|------|-----|------|\n762\t| 主背景 | 宣纸色 | #F5F0E8 | 温暖米色，有纸质感 |\n763\t| 卡片/面板 | 白色微黄 | #FFFDF7 | 比背景稍亮 |\n764\t| 主色调 | 朱砂红 | #C84B31 | 按钮/高亮/正确 |\n765\t| 辅助色 | 墨绿 | #2D6A4F | 进度条/成功 |\n766\t| 金色强调 | 金箔色 | #D4A843 | 星星/奖励/高级 |\n767\t| 文字主色 | 墨黑 | #2C2C2C | 正文 |\n768\t| 文字副色 | 灰棕 | #8B7355 | 次要信息 |\n769\t| 正确反馈 | 翠绿 | #27AE60 | 答对 |\n770\t| 错误反馈 | 朱红 | #E74C3C | 答错 |\n771\t| 连击特效 | 金色渐变 | #FFD700→#FFA500 | 连击高光 |\n772\t\n773\t### 9.3 字体规范\n774\t\n775\t| 用途 | 字体 | 说明 |\n776\t|------|------|------|\n777\t| 成语填空 | 思源宋体 / 系统宋体 | 正式感，有文化氛围 |\n778\t| 候选字 | 系统默认圆体 | 清晰易辨认 |\n779\t| 释义/正文 | 系统默认 | 可读性优先 |\n780\t| 数字/分数 | DIN / 等宽 | 对齐美观 |\n781\t\n782\t### 9.4 UI 设计规范\n783\t\n784\t| 元素 | 规范 |\n785\t|------|------|\n786\t| 成语空位 | 4 个正方形，深色边框，底部有浅色横线，尺寸 60×60px |\n787\t| 候选字按钮 | 圆角正方形（圆角 12px），朱砂红底 + 白字，按压缩小 5% |\n788\t| 正确动画 | 空位变绿 + 对勾弹出 + 候选字位置出现绿色勾 |\n789\t| 错误动画 | 空位变红 + 左右抖动 + 字飞回候选位置 |\n790\t| 按钮 | 圆角矩形，朱砂红渐变，白色文字，按压缩小 5% |\n791\t| 弹窗 | 白色圆角面板 + 半透明遮罩，底部滑入 |\n792\t| 星星 | 金色五角星，从左到右依次弹出 |\n793\t| 连击文字 | 从小到大弹出，金色描边，0.3s 淡出 |\n794\t\n795\t### 9.5 章节视觉\n796\t\n797\t| 章节 | 背景元素 | 色调 |\n798\t|------|----------|------|\n799\t| 初学启蒙 | 竹简 + 晨光 | 浅黄暖色 |\n800\t| 蒙学进阶 | 书桌 + 茶杯 | 橙色暖调 |\n801\t| 经典成语 | 窗外夕阳 + 书架 | 深橙红 |\n802\t| 典故深处 | 月光 + 古书 | 深蓝紫 |\n803\t| 博学大师 | 星空 + 卷轴 | 星空金黑 |\n804\t\n805\t---\n806\t\n807\t## 十、新手引导流程\n808\t\n809\t### 10.1 引导序列\n810\t\n811\t| 步骤 | 时间 | 触发条件 | 引导动作 | UI 表现 |\n812\t|------|------|----------|----------|---------|\n813\t| T1 | 0-3s | 第 1 关第 1 题 | 显示成语释义 + 高亮第 1 个正确候选字 | 半透明遮罩 + 箭头 + 手指动画 |\n814\t| T2 | 3-6s | 玩家点击第 1 个字 | 字飞入空位 + 自动高亮第 2 个正确字 | 继续引导 |\n815\t| T3 | 6-10s | 4 字填完（引导完成） | 正确动画 + 释义弹出 | \"心花怒放：形容非常开心！\" |\n816\t| T4 | 10-15s | 第 2 题出现 | 高亮第 1 个字，其余自由操作 | 逐步减少引导 |\n817\t| T5 | 15-25s | 第 3-5 题 | 无引导，自由作答 | — |\n818\t| T6 | 25-30s | 连对 3 题 | 连击特效触发 | \"连击 ×3！太棒了！\" |\n819\t| T7 | 30-35s | 第 7 题出错 | 红色抖动 + 引导使用提示按钮 | \"卡住了？试试揭示一个字\" |\n820\t| T8 | 35-40s | 第 1 关完成 | 星级评定 + 结算页 | \"完美通关！\" |\n821\t\n822\t### 10.2 引导设计原则\n823\t\n824\t- 第 1 关完全引导，确保成功体验\n825\t- 第 2-3 关逐步放手，只在关键新功能出现时引导\n826\t- 第 4 关起无引导\n827\t- 智能跳过：如果检测到玩家已理解操作（如 3 秒内自主答题），跳过后续引导\n828\t\n829\t---\n830\t\n831\t## 十一、开发排期（3 周里程碑）\n832\t\n833\t### Week 1：核心玩法（MVP）\n834\t\n835\t| 天 | 任务 | 交付物 |\n836\t|----|------|--------|\n837\t| D1 | 项目搭建 + TTML 页面结构 + 全局样式 | 可运行的小程序框架 |\n838\t| D1 | 成语数据库设计 + AI 生成 500 条初始数据 | idioms/easy.json |\n839\t| D2 | 出题引擎（选题 + 干扰字 + 随机排列） | 可生成完整题目 |\n840\t| D2 | 答题界面（空位 + 候选字 + 点击交互） | 可交互的答题页 |\n841\t| D3 | 答题判定（正确/错误动画 + 生命系统） | 完整的单题循环 |\n842\t| D3 | 连击系统（计算 + 特效 + 加分） | 连击反馈完整 |\n843\t| D4 | 关卡配置系统 + JSON 加载 | 可配置不同关卡 |\n844\t| D4 | 前 20 关数据制作 + 关卡地图页面 | 20 个可玩关卡 |\n845\t| D5 | 新手引导序列 + W1 内测 | 稳定可玩的 20 关 Demo |\n846\t\n847\t**W1 里程碑验收**：20 关完整可玩，含教学引导、连击系统、生命值、音效。\n848\t\n849\t### Week 2：完整体验 + 社交\n850\t\n851\t| 天 | 任务 | 交付物 |\n852\t|----|------|--------|\n853\t| D6 | 限时挑战模式 + 倒计时 + 排行 | 限时模式可玩 |\n854\t| D6 | 成语图鉴系统（收集 + 分类 + 详情） | 图鉴页完成 |\n855\t| D7 | 提示系统（揭示/去干扰/跳过）+ 金币消耗 | 所有道具就绪 |\n856\t| D7 | 每日系统（登录/任务/挑战） | 每日内容 |\n857\t| D8 | 好友 PK 模式 + 云端数据同步 | PK 可玩 |\n858\t| D8 | 抖音分享集成 + 短视频分享 | 社交分享就绪 |\n859\t| D9 | 角色系统 + 皮肤系统 | 4 角色 + 3 皮肤 |\n860\t| D9 | 关卡 21-50 数据制作 | 50 关完整 |\n861\t| D10 | W2 内测 + Bug 修复 | 稳定可玩的 50 关 + 社交 |\n862\t\n863\t**W2 里程碑验收**：50 关 + 三模式 + 图鉴 + 角色 + 社交分享。\n864\t\n865\t### Week 3：变现 + 上线\n866\t\n867\t| 天 | 任务 | 交付物 |\n868\t|----|------|--------|\n869\t| D11 | 穿山甲 SDK 集成（复用三消广告管理） | 广告可展示 |\n870\t| D11 | 6 个广告位 UI + 频率控制 | 广告系统完成 |\n871\t| D12 | 数据埋点（复用三消埋点框架） | 关键事件全覆盖 |\n872\t| D12 | 包体优化 + 资源压缩 | < 2MB |\n873\t| D13 | 全量测试 + Bug 修复 | 无阻塞性 Bug |\n874\t| D13 | 软著材料提交 | 提审准备 |\n875\t| D14 | 抖音提审 | 提交审核 |\n876\t| D14 | 备用：修复审核反馈 | 快速迭代 |\n877\t| D15 | 上线 + 监控首日数据 | 正式发布 |\n878\t\n879\t**W3 里程碑验收**：游戏上架抖音小游戏平台，广告变现运行正常。\n880\t\n881\t### 11.1 关键依赖\n882\t\n883\t| 依赖项 | 来源 | 截止时间 | 风险 |\n884\t|--------|------|----------|------|\n885\t| 抖音开发者账号 | 复用三消项目 | 已有 | 无 |\n886\t| 穿山甲广告账号 | 复用三消项目 | 已有 | 无 |\n887\t| 软著 | 复用三消项目主体 | 提审前 | 低 |\n888\t| 成语数据库 2000 条 | AI 生成 + 人工审核 | D2-D5 | 中（需人工审核） |\n889\t| 角色头像 4 张 | AI 绘制 | W1 结束 | 低 |\n890\t| 背景图 5 张 | AI 绘制 | W2 结束 | 低 |\n891\t| 音效 10-15 个 | AI 生成 | W1 结束 | 低 |\n892\t\n893\t---\n894\t\n895\t## 十二、数据埋点与运营\n896\t\n897\t### 12.1 关键指标\n898\t\n899\t| 指标 | 定义 | 目标值 | 告警阈值 |\n900\t|------|------|--------|----------|\n901\t| 次日留存 | D1/D0 | 35%+ | < 25% |\n902\t| 7 日留存 | D7/D0 | 18%+ | < 10% |\n903\t| 平均会话时长 | — | 6+ 分钟 | < 3 分钟 |\n904\t| 人均广告次数/天 | — | 6+ 次 | < 3 次 |\n905\t| 激励视频完成率 | — | 90%+ | < 75% |\n906\t| 新手引导完成率 | 完成教学关卡比例 | 95%+ | < 80% |\n907\t| 关卡通过率（前 10 关） | 单关通过比例 | 85%+ | < 70% |\n908\t| PK 参与率 | DAU 中参与 PK 比例 | 30%+ | < 15% |\n909\t| 图鉴收集率 | 人均收集成语数 | 50+/周 | < 20/周 |\n910\t| ARPU | 日收入/DAU | ¥0.34+ | < ¥0.15 |\n911\t\n912\t### 12.2 埋点事件\n913\t\n914\t```javascript\n915\tconst EVENTS = {\n916\t  GAME_START: 'game_start',           // 游戏启动\n917\t  TUTORIAL_STEP: 'tutorial_step',     // 引导步骤\n918\t  LEVEL_START: 'level_start',         // 关卡开始\n919\t  QUESTION_ANSWER: 'question_answer', // 答题结果（正确/错误/用时/是否用提示）\n920\t  LEVEL_COMPLETE: 'level_complete',   // 关卡完成（正确率/星级/金币）\n921\t  LEVEL_FAIL: 'level_fail',           // 关卡失败（剩余生命/第几题失败）\n922\t  COMBO_HIT: 'combo_hit',             // 连击数（N 连击触发）\n923\t  HINT_USE: 'hint_use',               // 使用提示（类型：揭示/去干扰/跳过）\n924\t  AD_SHOW: 'ad_show',                 // 广告展示（广告位/是否完成）\n925\t  SHARE: 'share',                     // 分享（类型：PK/求助/成绩/每日挑战）\n926\t  PK_START: 'pk_start',               // PK 开始\n927\t  PK_RESULT: 'pk_result',             // PK 结果（胜/负/平）\n928\t  TIMED_START: 'timed_start',         // 限时挑战开始\n929\t  TIMED_END: 'timed_end',             // 限时挑战结束（分数/答题数）\n930\t  COLLECTION_UNLOCK: 'collection_unlock', // 解锁新成语\n931\t  CHARACTER_USE: 'character_use',     // 角色使用\n932\t};\n933\t```\n934\t\n935\t---\n936\t\n937\t## 十三、风险与缓解\n938\t\n939\t| 风险 | 概率 | 影响 | 缓解措施 |\n940\t|------|------|------|----------|\n941\t| 成语数据质量差 | 中 | 玩家信任度下降 | AI 生成后必须人工审核释义准确性 |\n942\t| 成语歧义（多组成语） | 中 | 玩家困惑 | 出题时排除有歧义的成语；提供释义辅助 |\n943\t| 互动性不如三消 | 中 | 留存偏低 | 用 PK、限时、排行弥补；加快节奏 |\n944\t| 题库消耗过快 | 中 | 内容枯竭 | 首发 2000 条 + 每周更新；按频率分配保证 50 关不重复 |\n945\t| 广告 eCPM 偏低 | 中 | 收入不足 | 增加激励视频比重；优化提示触发点 |\n946\t| 文字游戏天花板低 | 中 | DAU 上限低 | 作为矩阵第二产品，不追求单一爆款 |\n947\t\n948\t---\n949\t\n950\t## 十四、版本规划\n951\t\n952\t| 版本 | 时间 | 内容 |\n953\t|------|------|------|\n954\t| **V1.0** | 第 3 周末 | 50 关 + IAA 广告 + 基础社交 + 4 角色 + 图鉴 |\n955\t| V1.1 | 上线后 2 周 | 内购道具 + 题库扩充至 5000 + 新章节 51-80 关 |\n956\t| V1.2 | 上线后 4 周 | 月卡系统 + 每周挑战赛 + 新角色 + 皮肤商店 |\n957\t| V1.3 | 上线后 6 周 | 微信小游戏版本上线 |\n958\t| V2.0 | 上线后 2 月 | Emoji 猜成语模式 + 看图猜成语 + 成语接龙模式 |\n959\t\n960\t---\n961\t\n962\t## 附录 A：调参表\n963\t\n964\t```\n965\t变量                       | 基础值   | 最小值 | 最大值 | 调参备注\n966\t---------------------------|---------|--------|--------|---------------------------\n967\t初始生命值                   | 5       | 3      | 8      | ★ 简单关 5，★★★ 关 3 [待测试]\n968\t每关题数                     | 10      | 8      | 15     | Boss 关可增加\n969\t候选字数（★ 简单）           | 8       | 6      | 10     | [待测试] 8 是否太容易\n970\t候选字数（★★★★ 大师）      | 12      | 10     | 16     | [待测试]\n971\t答错扣命数                   | 1       | 1      | 2      | 保持 1，降低挫败感\n972\t续命恢复命数                 | 3       | 2      | 5      | [待测试]\n973\t揭示提示金币价格              | 5       | 3      | 10     | [待测试]\n974\t去干扰金币价格                | 8       | 5      | 15     | [待测试]\n975\t连击加分倍率                  | 1+0.2×n | 1+0.1×n| 1+0.5×n| [待测试] 是否激励足够\n976\t限时挑战时长                  | 60s     | 30s    | 120s   | [待测试]\n977\t插屏广告间隔（关数）          | 2       | 1      | 4      | [待测试] 2 是否太频繁\n978\t激励视频每日上限              | 15      | 10     | 25     | [待测试]\n979\t```\n980\t\n981\t## 附录 B：音效列表\n982\t\n983\t| ID | 音效名 | 触发时机 | 时长 | 风格 |\n984\t|----|--------|----------|------|------|\n985\t| S01 | char_place | 字填入空位 | 0.1s | 清脆 click |\n986\t| S02 | answer_correct | 答对整题 | 0.3s | 上升音阶叮 |\n987\t| S03 | answer_wrong | 答错 | 0.3s | 低沉 buzz |\n988\t| S04 | combo_3 | 3 连击 | 0.3s | 快乐升调 |\n989\t| S05 | combo_5 | 5 连击 | 0.5s | 激动弦乐 |\n990\t| S06 | combo_8 | 8+ 连击 | 0.6s | 欢呼 + 管弦 |\n991\t| S07 | level_complete | 通关 | 1.0s | 古风 fanfare |\n992\t| S08 | level_fail | 失败 | 0.8s | 柔和叹息 |\n993\t| S09 | star_earned | 获得星星 | 0.2s | 叮—— |\n994\t| S10 | hint_reveal | 使用揭示 | 0.2s | 翻书声 |\n995\t| S11 | hint_remove | 使用去干扰 | 0.2s | 消散声 |\n996\t| S12 | pk_win | PK 胜利 | 0.8s | 胜利鼓点 |\n997\t| S13 | pk_lose | PK 失败 | 0.5s | 鼓励音 |\n998\t| S14 | button_click | 按钮点击 | 0.08s | 轻触 |\n999\t| S15 | timed_tick | 倒计时最后 10 秒 | 0.1s | 滴答 |\n1000\t\n1001\t## 附录 C：成语图鉴分类设计\n1002\t\n1003\t| 类别 | 数量（首发） | 图标 | 解锁条件 |\n1004\t|------|-------------|------|----------|\n1005\t| 动物世界 | 300 | 🐉 | 初始解锁 |\n1006\t| 数字密码 | 150 | 🔢 | 通关第 2 章 |\n1007\t| 历史典故 | 250 | 📜 | 通关第 3 章 |\n1008\t| 自然风光 | 150 | 🏔️ | 通关第 4 章 |\n1009\t| 人物描写 | 200 | 👤 | 收集 100 个成语 |\n1010\t| 寓言哲理 | 200 | 💡 | 收集 150 个成语 |\n1011\t| 军事谋略 | 150 | ⚔️ | 收集 200 个成语 |\n1012\t| 情感表达 | 150 | ❤️ | 收集 300 个成语 |\n1013\t| 四季时令 | 100 | 🌸 | 收集 400 个成语 |\n1014\t| 美食文化 | 100 | 🍜 | 收集 500 个成语 |\n1015\t\n1016\t每类收集满 → 解锁该类专属背景皮肤\n1017\t\n1018\t## 附录 D：变更日志\n1019\t\n1020\t| 版本 | 日期 | 变更内容 |\n1021\t|------|------|----------|\n1022\t| 1.0 | 2026-05-23 | 初始立项文档 |\n1023\t"}]},"parent_tool_use_id":null,"session_id":"930c8880-e9f5-4f41-8841-d1efd19066ee","uuid":"a7d937fe-a8e5-4d0d-852e-c561ead5697a","timestamp":"2026-05-22T22:54:32.852Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/GDD.md","content":"# 成语大闯关（Idiom Master）— 详细立项文档\n\n> **版本**：1.0 | **日期**：2026-05-23 | **设计师**：游戏设计师 Agent\n> **状态**：立项 — 待开发评审\n> **关联文档**：[[douyin-mini-games-blueprint.md]] — 平台调研与初始概念；[[../douyin-match3/GDD.md]] — 三消游戏框架（可复用组件）\n\n---\n\n## 一、项目概览\n\n| 字段 | 值 |\n|------|-----|\n| 游戏名称 | 成语大闯关（Idiom Master） |\n| 品类 | 文字益智（Word Puzzle） |\n| 目标平台 | 抖音小游戏（优先）→ 微信小游戏 → H5 |\n| 核心差异化 | 中文成语专项（蓝海品类）+ 抖音社交竞赛 + 轻量社交裂变 |\n| 开发周期 | 3 周（单人全栈，含提审） |\n| 目标 DAU | 首发 3K → 3 个月 30K |\n| 变现模式 | IAA 为主（激励视频 + 插屏），后续叠加 IAP（皮肤/道具） |\n| 包体目标 | < 2MB（纯文字 + 少量图标，极轻量） |\n| 软著申请 | 与三消游戏同步，复用同一主体 |\n\n### 设计支柱（不可妥协）\n\n1. **15 秒内上手** — 看一眼就知道怎么玩，答题 = 点击选字，零解释\n2. **每题都是微成就感** — 正确动画 + 连击 + 释义弹出，持续刺激\"我很聪明\"的满足感\n3. **知识 = 社交货币** — 成绩可炫耀，PK 可分享，失败可求助，天然传播动力\n4. **极低开发成本** — 纯文字渲染，无美术依赖，复用三消游戏的广告/社交/经济框架\n\n---\n\n## 二、竞品分析\n\n### 2.1 抖音热门成语游戏\n\n| 竞品 | 品类 | 核心玩法 | 日活估算 | 优势 | 短板 |\n|------|------|----------|----------|------|------|\n| **成语小秀才** | 文字益智 | 选字组词 + 官职升级 | 50K+ | 官职系统驱动长期留存 | 美术简陋，社交弱 |\n| **成语大挑战** | 文字益智 | 看图猜成语 | 30K+ | 图文结合有新意 | 图片包体大，题库有限 |\n| **疯狂猜成语** | 问答 | 图片/emoji 猜成语 | 20K+ | 短视频传播力强 | 题目质量参差不齐 |\n| **成语消消乐** | 混合 | 三消 + 成语 | 10K+ | 创新融合 | 两套系统互相干扰 |\n\n### 2.2 竞品共性问题\n\n1. **社交裂变浅** — 大多只有分享领金币，缺乏深度互动\n2. **内容运营弱** — 题库静态不更新，老玩家很快刷完\n3. **变现设计粗暴** — 广告弹出频繁，严重影响体验\n4. **视觉风格统一差** — 大多采用模板化 UI，无品牌辨识度\n\n### 2.3 我们的差异化策略\n\n| 维度 | 竞品做法 | 我们的做法 |\n|------|----------|-----------|\n| 核心玩法 | 单一模式 | 闯关 + 限时 + PK 三模式 |\n| 社交 | 分享领金币 | 好友 PK + 求助 + 每日挑战排行 |\n| 内容运营 | 固定题库 | 每周更新 + 玩家投稿 + AI 扩充 |\n| 变现 | 强制广告 | 70%+ 激励视频（用户主动选择） |\n| 视觉 | 模板 UI | 国风主题 + 角色皮肤系统 |\n| 长期留存 | 无 | 成语图鉴收集 + 称号系统 + 角色养成 |\n\n---\n\n## 三、核心玩法机制设计\n\n### 3.1 基本规则\n\n- 屏幕上方显示成语的**释义**（如\"形容非常开心\"）\n- 中间显示 **4 个空位**（组成完整成语）\n- 下方显示 **8-12 个候选字**（含 4 个正确字 + 干扰字）\n- 玩家**依次点击** 4 个正确字，按正确顺序填入空位\n- 答对 → 绿色闪光 + 释义弹出 + 连击 +1 → 下一题\n- 答错 → 红色抖动 + 字飞回 + 失去 1 条命（初始 5 条命）\n\n### 3.2 出题引擎规格\n\n```\n输入：成语数据库（idioms.json）+ 难度等级 + 关卡配置\n输出：一道完整的成语题\n\n算法：\n1. 根据关卡难度等级，从题库中随机选取一个成语\n2. 生成干扰字池：\n   a. 优先从同类别成语中取字（如动物类成语取动物相关字）\n   b. 补充形近字（如\"己\"/\"已\"/\"巳\"）\n   c. 补充音近字（如\"画\"/\"话\"）\n   d. 确保干扰字与正确字不重复\n3. 将正确字 + 干扰字随机排列（8-12 个）\n4. 记录正确答案的索引顺序（用于判定）\n\n干扰字数量规则：\n- ★ 简单：4 正确 + 4 干扰 = 8 候选\n- ★★ 中等：4 正确 + 6 干扰 = 10 候选\n- ★★★ 困难：4 正确 + 8 干扰 = 12 候选\n- ★★★★ 大师：4 正确 + 8 干扰 = 12 候选（干扰字更相似）\n\n性能要求：出题 < 10ms（纯内存操作）\n```\n\n### 3.3 答题判定逻辑\n\n```\n状态：4 个空位 slot[0..3]，当前已填 fillCount\n玩家点击候选字 candidate[i]：\n  → 候选字飞入 slot[fillCount]\n  → fillCount++\n  → 如果 fillCount == 4：\n      → 检查 slot[0..3] 是否等于 idiom.chars[0..3]\n      → 正确：触发\"正确\"动画链\n      → 错误：触发\"错误\"动画链，slot 清空，fillCount = 0\n  → 如果 fillCount < 4：\n      → 等待继续点击\n\n撤销机制：\n  → 点击已填入的 slot[i]：该字飞回候选区，后续 slot 自动左移\n  → 仅在\"撤销提示\"道具激活时可用（默认不可撤销已填字）\n```\n\n### 3.4 三种游戏模式\n\n#### 模式一：闯关模式（核心进度）\n\n| 规则 | 说明 |\n|------|------|\n| 每关题数 | 10 题 |\n| 生命值 | 初始 5 条命 |\n| 通关条件 | 答完 10 题（允许使用提示/跳过） |\n| 星级评定 | 按正确率：≥9 对 = 3 星，≥7 对 = 2 星，≥5 对 = 1 星 |\n| 失败条件 | 生命值归零 |\n| 难度递进 | 每 10 关提升一个难度等级 |\n\n#### 模式二：限时挑战\n\n| 规则 | 说明 |\n|------|------|\n| 时间 | 60 秒倒计时 |\n| 题目 | 无限出题，难度随机（偏中等） |\n| 得分 | 每题基础 100 分 + 连击加成（连击数 × 20） |\n| 结束 | 倒计时结束 → 结算 |\n| 排行榜 | 全局 + 好友 |\n\n#### 模式三：好友 PK\n\n| 规则 | 说明 |\n|------|------|\n| 题数 | 5 题 |\n| 机制 | 双方答相同题目，互不知对方进度 |\n| 胜负 | 正确率高者胜；相同则比用时 |\n| 奖励 | 胜者 +50 金币 + 1 PK 积分 |\n| 裂变 | PK 结果页 → 一键分享到抖音 |\n\n### 3.5 连击系统（核心爽感来源）\n\n```\n连续答对触发连击：\n- 3 连击：+60 分加成 → \"不错！\" 文字弹出 + 音效升调\n- 5 连击：+100 分加成 → \"厉害了！\" + 屏幕微震 + 粒子特效\n- 8 连击：+160 分加成 → \"学霸！\" + 全屏金色光效\n- 10+ 连击：+200+ 分加成 → \"成语大师！！\" + 烟花特效 + 额外 1 金币\n\n连击断裂：\n- 答错或使用跳过 → 连击归零\n- 使用提示答对 → 连击继续，但本题不计加分\n\n动画时间预算（单题交互总时间不超过 1.5 秒）：\n- 点击填字：0.15s\n- 正确动画：0.4s（绿色闪光 + 释义弹出）\n- 错误动画：0.5s（红色抖动 + 字飞回）\n- 连击特效：0.3s（叠加在正确动画上）\n```\n\n### 3.6 失败与续命\n\n| 事件 | 玩家选择 | 结果 |\n|------|----------|------|\n| 生命值归零 | 看激励视频（30s） | 恢复 3 条命，可续命 1 次 |\n| 生命值归零 | 使用 10 金币购买 | 恢复 3 条命 |\n| 生命值归零 | 放弃 | 回到关卡地图，保留已获星星 |\n\n---\n\n## 四、关卡系统设计（首发 50 关）\n\n### 4.1 关卡数据结构\n\n```json\n{\n  \"id\": 1,\n  \"chapter\": 1,\n  \"difficulty\": 1,\n  \"questions\": 10,\n  \"lives\": 5,\n  \"stars\": [5, 7, 9],\n  \"reward\": { \"coins\": 20, \"exp\": 10 },\n  \"idiom_pool\": [\"easy_01\", \"easy_02\"],\n  \"category\": [\"常用\", \"动物\"],\n  \"tutorial_step\": \"T1\"\n}\n```\n\n| 字段 | 类型 | 说明 |\n|------|------|------|\n| id | int | 关卡编号 |\n| chapter | int | 章节编号 |\n| difficulty | int | 难度等级（1-4） |\n| questions | int | 题目数量 |\n| lives | int | 初始生命 |\n| stars | int[3] | 1/2/3 星正确数阈值 |\n| reward | object | 通关奖励（金币 + 经验） |\n| idiom_pool | string[] | 本关出题池（可选，为空则按难度随机） |\n| category | string[] | 成语类别限制 |\n| tutorial_step | string/null | 关联教学步骤 |\n\n### 4.2 前 50 关详细设计\n\n#### 第 1-5 关：新手教学（零失败区）\n\n| 关卡 | 难度 | 生命 | 星级阈值 | 候选字数 | 教学内容 |\n|------|------|------|----------|----------|----------|\n| 1 | ★ | 5 | [3, 4, 5] | 8 | 强制引导：高亮正确字，引导逐字点击 |\n| 2 | ★ | 5 | [3, 4, 5] | 8 | 半引导：只提示第一个字 |\n| 3 | ★ | 5 | [4, 5, 5] | 8 | 自由作答，成语极简（一心一意、画蛇添足等） |\n| 4 | ★ | 5 | [4, 5, 5] | 8 | 引入释义提示按钮（免费） |\n| 5 | ★ | 5 | [4, 5, 5] | 8 | 引入连击概念，连对 3 题触发特效 |\n\n**设计原则**：\n- 前 5 关保证所有玩家都能 3 星通关\n- 成语选取最常见的日常用语\n- 释义用白话文，不用文言原文\n- 每关第 1 题必是最简单的成语（如\"心花怒放\"）\n\n#### 第 6-15 关：简单进阶（建立习惯）\n\n| 关卡 | 难度 | 生命 | 星级阈值 | 新元素 |\n|------|------|------|----------|--------|\n| 6 | ★ | 5 | [5, 7, 9] | 标准规则 |\n| 7 | ★ | 5 | [5, 7, 9] | 引入\"去干扰\"道具（首次免费） |\n| 8 | ★ | 5 | [5, 7, 9] | 引入\"跳过\"功能 |\n| 9 | ★ | 5 | [5, 7, 9] | — |\n| 10 | ★ | 5 | [5, 7, 9] | Boss 关：10 题全对额外奖励 50 金币 |\n| 11 | ★ | 4 | [5, 7, 9] | 生命值降至 4 |\n| 12 | ★ | 4 | [5, 7, 9] | — |\n| 13 | ★ | 4 | [5, 7, 9] | 引入双类别混合（动物+数字） |\n| 14 | ★ | 4 | [5, 7, 9] | — |\n| 15 | ★ | 4 | [5, 7, 9] | Boss 关：正确率 ≥80% 通关 |\n\n#### 第 16-30 关：中等难度（策略性增强）\n\n| 关卡段 | 难度 | 生命 | 候选字数 | 新元素 |\n|--------|------|------|----------|--------|\n| 16-20 | ★★ | 4 | 10 | 中等成语（望梅止渴、纸上谈兵等） |\n| 21-25 | ★★ | 3 | 10 | 生命降至 3，需要更谨慎 |\n| 26-30 | ★★ | 3 | 10 | 引入形近干扰（己/已、蓝/篮等） |\n\n#### 第 31-45 关：困难挑战（硬核考验）\n\n| 关卡段 | 难度 | 生命 | 候选字数 | 新元素 |\n|--------|------|------|----------|--------|\n| 31-35 | ★★★ | 3 | 12 | 困难成语（沆瀣一气、韦编三绝等） |\n| 36-40 | ★★★ | 3 | 12 | 音近干扰（画/话、故/顾等） |\n| 41-45 | ★★★ | 3 | 12 | 混合干扰（形近 + 音近） |\n\n#### 第 46-50 关：大师挑战（里程碑）\n\n| 关卡 | 难度 | 生命 | 特殊规则 |\n|------|------|------|----------|\n| 46-49 | ★★★★ | 3 | 生僻成语 + 最大干扰 + 无释义提示 |\n| 50 | ★★★★ | 3 | Boss 关：12 题全对 = 传说称号 + 200 金币 |\n\n### 4.3 章节结构（每 10 关一个章节）\n\n| 章节 | 主题 | 关卡 | 视觉风格 |\n|------|------|------|----------|\n| 第一章 | 初学启蒙 | 1-10 | 书院·晨光（浅黄暖色） |\n| 第二章 | 蒙学进阶 | 11-20 | 书院·午后（橙色暖调） |\n| 第三章 | 经典成语 | 21-30 | 书院·夕阳（深橙红） |\n| 第四章 | 典故深处 | 31-40 | 书院·月夜（深蓝紫） |\n| 第五章 | 博学大师 | 41-50 | 书院·星辰（星空金黑） |\n\n### 4.4 关卡验证规则\n\n- 每关题池至少 15 个成语（10 个必答 + 5 个备用）\n- 所有成语必须经过人工审核：释义准确、出处可查\n- ★ 简单关成语必须在《新华字典》常用词表中\n- 干扰字不能组成其他有效成语（避免歧义）\n- Boss 关题目从固定池中选取（保证公平性）\n\n---\n\n## 五、角色/皮肤系统\n\n### 5.1 角色（导师系统）\n\n| 角色 | 主题 | 技能 | 获取方式 |\n|------|------|------|----------|\n| **书童小明** | 基础 | 答错时有 20% 概率不扣命 | 初始角色 |\n| **才女小红** | 中等 | 每关首次使用提示不消耗次数 | 通过 20 关解锁 |\n| **状元先生** | 高级 | 连击加分 ×1.5 倍 | 收集 80 碎片兑换 |\n| **诗仙李白** | 稀有 | 答对时额外获得 1 经验 | 月卡/活动限定 |\n\n### 5.2 角色皮肤（视觉自定义）\n\n| 皮肤 | 风格 | 获取方式 | 价格 |\n|------|------|----------|------|\n| 经典蓝袍 | 默认 | 初始 | 免费 |\n| 红色喜庆 | 节日风 | 春节活动 | 限时 |\n| 青绿山水 | 国风 | 图鉴收集 100 个成语 | 100 金币 |\n| 金色荣耀 | 奢华 | PK 积分达到 100 | 200 金币 |\n| Q版萌趣 | 可爱 | 首次充值（后续） | ¥6 |\n\n### 5.3 背景皮肤（答题界面背景）\n\n| 背景 | 风格 | 获取 |\n|------|------|------|\n| 水墨竹影 | 国风淡雅 | 初始 |\n| 春日桃林 | 花开满屏 | 通关第 2 章 |\n| 秋月寒江 | 冷色调 | 通关第 3 章 |\n| 星河夜空 | 梦幻 | 通关第 4 章 |\n| 古典书斋 | 木质纹理 | 收集 200 个成语 |\n\n---\n\n## 六、社交裂变机制\n\n### 6.1 好友 PK 挑战（核心裂变）\n\n```\n流程：\n1. 玩家 A 在 PK 模式中选择好友 → 生成挑战链接\n2. 分享到抖音（视频/消息）\n3. 玩家 B 点击链接 → 进入游戏 → 答相同 5 题\n4. 双方各答完 → 揭晓结果\n5. 结果页：\n   - 胜方：胜利动画 + 奖杯 + \"+50 金币\"\n   - 败方：鼓励文字 + \"不服？再来一局\" → 分享按钮\n6. 核心裂变：不服输 → 再来 → 分享给更多人\n\nPK 积分系统：\n- 胜 +3 分，平 +1 分，负 +0 分\n- 每周重置排行\n- 前 10 名获得称号 + 金币奖励\n```\n\n### 6.2 \"你能全对吗？\" 短视频分享\n\n```\n触发条件：连对 5+ 题 / 通关 Boss 关 / PK 胜利\n自动生成 15 秒短视频：\n  - 答题过程回放（加速 ×2）\n  - 连击特效叠加\n  - 最终得分 + \"你能超越我吗？\"\n一键分享到抖音 → 带游戏入口链接\n```\n\n### 6.3 求助好友\n\n```\n触发条件：答错且只剩 1 条命\n选项：\"求助好友\" → 生成分享卡片\n好友点击 → 好友获得 10 金币 + 玩家恢复 1 条命\n每日求助上限：3 次\n```\n\n### 6.4 每日成语挑战\n\n```\n每天 1 道特殊题（全平台统一）：\n  - 成语 + 图片提示（如一张画了蛇和脚的图 → 画蛇添足）\n  - 或：emoji 组合猜成语\n  - 难度偏中高\n  - 全平台排行榜：\"今日全对率：23%\"\n  - FOMO 驱动：\"只有 12% 的人答对了今天的题目\"\n\n奖励：\n  - 答对：50 金币 + 1 碎片\n  - 分享答题结果到抖音：额外 20 金币\n```\n\n### 6.5 好友排行榜\n\n```\n维度：\n  - 闯关进度（已通关数）\n  - 限时挑战最高分\n  - PK 积分\n  - 图鉴收集数\n使用 tt.getFriendCloudStorage() 实时获取好友数据\n```\n\n---\n\n## 七、变现方案\n\n### 7.1 广告收入（IAA — 主力）\n\n#### 广告位详细设计\n\n**广告位 1：揭示 1 字（激励视频）**\n\n| 属性 | 值 |\n|------|-----|\n| 触发条件 | 答题中，玩家点击\"揭示\"按钮 |\n| 广告类型 | 激励视频（穿山甲 rewardedVideoAd） |\n| 视频时长 | 15-30 秒 |\n| 用户奖励 | 自动填入第 1 个正确字 |\n| UI 设计 | 答题区上方小按钮：\"揭示 1 字 📖\" + 播放图标 |\n| 预估触发率 | 每关使用 1-2 次，约 60-70% 玩家会使用 |\n\n**广告位 2：去干扰（激励视频）**\n\n| 属性 | 值 |\n|------|-----|\n| 触发条件 | 答题中，玩家点击\"去干扰\"按钮 |\n| 广告类型 | 激励视频 |\n| 用户奖励 | 移除 2 个错误候选字 |\n| UI 设计 | 候选字区下方按钮：\"去掉 2 个 ✂️\" |\n| 预估触发率 | 每关 1-2 次，约 50% 玩家使用 |\n\n**广告位 3：双倍结算（激励视频）**\n\n| 属性 | 值 |\n|------|-----|\n| 触发条件 | 关卡结算页 |\n| 广告类型 | 激励视频 |\n| 用户奖励 | 本关金币奖励翻倍 |\n| UI 设计 | 结算页底部：\"领取 ×1\" vs \"看视频领取 ×2\" |\n| 预估触发率 | 55-65%（成功心情好，接受度高） |\n\n**广告位 4：额外生命（激励视频）**\n\n| 属性 | 值 |\n|------|-----|\n| 触发条件 | 生命值归零，游戏结束 |\n| 广告类型 | 激励视频 |\n| 用户奖励 | 恢复 3 条命，继续答题 |\n| UI 设计 | 失败弹窗：左侧\"结束\"，右侧\"看视频继续\"（金色高亮） |\n| 预估触发率 | 70-80%（沉没成本高，续命意愿强） |\n\n**广告位 5：关卡间插屏**\n\n| 属性 | 值 |\n|------|-----|\n| 触发条件 | 每通过 2 关后，结算页 → 返回地图时 |\n| 广告类型 | 插屏广告（5 秒后可关闭） |\n| 用户奖励 | 无 |\n| UI 设计 | 全屏展示，右上角 5 秒倒计时 |\n| 预估频率 | 2-3 次/天 |\n\n**广告位 6：每日签到翻倍**\n\n| 属性 | 值 |\n|------|-----|\n| 触发条件 | 每日登录签到时 |\n| 广告类型 | 激励视频 |\n| 用户奖励 | 今日签到奖励翻倍 |\n\n### 7.2 广告频率控制（防骚扰）\n\n```\n规则：\n- 同一广告位两次触发最小间隔：90 秒\n- 激励视频每日总上限：15 次\n- 插屏广告每日总上限：8 次\n- 连续 2 次失败后暂停插屏展示\n- 新用户前 3 关不展示任何广告\n- 限时挑战模式不展示插屏（沉浸体验）\n```\n\n### 7.3 收入预估\n\n| DAU | 激励视频/DAU | 插屏/DAU | 激励 eCPM | 插屏 eCPM | 日收入 | 月收入 |\n|-----|-------------|----------|-----------|-----------|--------|--------|\n| 3K | 4 次 | 2 次 | ¥80 | ¥35 | ¥1,020 | ¥30,600 |\n| 10K | 4 次 | 2 次 | ¥80 | ¥35 | ¥3,400 | ¥102,000 |\n| 30K | 4 次 | 2 次 | ¥80 | ¥35 | ¥10,200 | ¥306,000 |\n\n> ARPU ≈ ¥0.34/天\n\n**扣除平台分成（40%）后开发者实得：月 ¥18,360（3K DAU）/ ¥61,200（10K DAU）/ ¥183,600（30K DAU）**\n\n### 7.4 内购道具（V1.1 迭代）\n\n| 道具 | 价格（¥） | 效果 | 上线时机 |\n|------|-----------|------|----------|\n| 去广告 | 8 | 永久移除插屏，激励视频按钮变为金币购买 | V1.1 |\n| 金币包 S | 3 | 200 金币 | V1.1 |\n| 金币包 M | 12 | 1000 金币（+10% 赠送） | V1.1 |\n| 金币包 L | 25 | 2500 金币（+20% 赠送） | V1.1 |\n| 月卡 | 15/月 | 每日 100 金币 + 专属皮肤 + 去广告 | V1.2 |\n\n### 7.5 盈利关键假设 [待测试]\n\n| 假设 | 基础值 | 依据 |\n|------|--------|------|\n| 激励视频 eCPM | ¥80/千次 | 文字益智品类中位数 |\n| 留存率 | 次日 35%，7 日 18%，30 日 6% | 文字游戏品类平均 |\n| 人均广告次数 | 6 次/天 | 与调研数据一致 |\n| 视频完成率 | 90% | 教育类用户观看意愿高 |\n| 限时挑战参与率 | 40% DAU | 基于竞品数据估算 |\n| PK 裂变系数 | 1.3（每个用户带来 0.3 个新用户） | 文字游戏社交传播效率 |\n\n---\n\n## 八、技术方案\n\n### 8.1 技术栈选型\n\n| 组件 | 选型 | 理由 |\n|------|------|------|\n| 渲染引擎 | **TTML + TTSS**（抖音小程序原生） | 纯文字游戏，DOM 渲染更快开发，无需 Canvas |\n| 编程语言 | **原生 JavaScript**（ES6+） | 最小依赖，最快开发 |\n| 动画 | CSS Animation + JS 补间 | 文字飞入/弹出效果用 CSS 足够 |\n| 音频 | `tt.createInnerAudioContext()` | 抖音原生 API |\n| 广告 | 穿山甲 SDK（csjplatform.com） | 抖音官方广告平台 |\n| 数据存储 | `tt.setStorageSync()` + 云开发 | 本地进度 + 云端排行/PK |\n| 社交 | `tt.shareAppMessage()` + `tt.getFriendCloudStorage()` | 抖音好友关系链 |\n| 构建工具 | 无 | 小程序直接上传开发者工具 |\n\n**选择 TTML（DOM）而非 Canvas 的理由**：\n- 成语游戏无复杂图形，文字 + 按钮 = DOM 更高效\n- CSS 动画性能足够（文字飞入、缩放、抖动）\n- 开发效率比 Canvas 高 30-40%\n- 可复用三消游戏的广告管理、社交、经济模块\n\n### 8.2 项目文件结构\n\n```\nidiom-master/\n├── app.js                    # 小程序入口（App 生命周期）\n├── app.json                  # 页面路由 + 全局配置\n├── app.ttss                  # 全局样式（国风主题）\n├── project.config.json       # 抖音开发者工具配置\n│\n├── pages/\n│   ├── home/                 # 主页\n│   │   ├── index.js          # 模式选择 + 每日入口 + 角色/地图入口\n│   │   ├── index.ttml\n│   │   └── index.ttss\n│   ├── play/                 # 答题页\n│   │   ├── index.js          # 出题逻辑 + 答题判定 + 连击系统\n│   │   ├── index.ttml\n│   │   └── index.ttss\n│   ├── result/               # 结算页\n│   │   ├── index.js          # 星级 + 奖励 + 广告（双倍）+ 分享\n│   │   ├── index.ttml\n│   │   └── index.ttss\n│   ├── timed/                # 限时挑战\n│   │   ├── index.js          # 60s 倒计时 + 无限出题 + 排行榜提交\n│   │   ├── index.ttml\n│   │   └── index.ttss\n│   ├── pk/                   # 好友 PK\n│   │   ├── index.js          # 5 题 PK + 结果揭晓\n│   │   ├── index.ttml\n│   │   └── index.ttss\n│   ├── collection/           # 成语图鉴\n│   │   ├── index.js          # 分类浏览 + 搜索 + 详情\n│   │   ├── index.ttml\n│   │   └── index.ttss\n│   ├── leaderboard/          # 排行榜\n│   │   ├── index.js          # 好友排行 + 全局排行\n│   │   ├── index.ttml\n│   │   └── index.ttss\n│   ├── characters/           # 角色选择\n│   │   ├── index.js          # 角色列表 + 技能 + 皮肤\n│   │   ├── index.ttml\n│   │   └── index.ttss\n│   └── daily/                # 每日挑战\n│       ├── index.js          # 每日 1 题 + 统计\n│       ├── index.ttml\n│       └── index.ttss\n│\n├── components/\n│   ├── tile-char/            # 候选字组件（点击 + 飞入动画）\n│   │   ├── index.js\n│   │   ├── index.ttml\n│   │   └── index.ttss\n│   ├── idiom-slot/           # 成语填空组件（4 个空位）\n│   │   ├── index.js\n│   │   ├── index.ttml\n│   │   └── index.ttss\n│   ├── ad-modal/             # 广告弹窗组件（激励视频/插屏通用）\n│   │   ├── index.js\n│   │   ├── index.ttml\n│   │   └── index.ttss\n│   ├── combo-display/        # 连击显示组件（数字 + 特效）\n│   ├── star-rating/          # 星级评定组件\n│   └── share-card/           # 分享卡片生成组件\n│\n├── utils/\n│   ├── idiom-engine.js       # 出题引擎（选题 + 干扰字生成）\n│   ├── judge.js              # 答题判定（正确/错误/撤销）\n│   ├── combo.js              # 连击计算与特效触发\n│   ├── pk-logic.js           # PK 匹配、出题同步、结算\n│   ├── ad-manager.js         # 穿山甲广告管理（从三消项目复用）\n│   ├── social.js             # 分享 + 好友关系链（从三消项目复用）\n│   ├── economy.js            # 金币/提示经济系统（从三消项目复用）\n│   ├── storage.js            # 持久化封装（从三消项目复用）\n│   ├── daily.js              # 每日挑战 + 每日任务\n│   └── cloud.js              # 云开发封装（排行榜 + PK 数据）\n│\n├── data/\n│   ├── idioms/               # 成语数据库（按难度分文件）\n│   │   ├── easy.json         # ★ 简单（500 个）\n│   │   ├── medium.json       # ★★ 中等（500 个）\n│   │   ├── hard.json         # ★★★ 困难（500 个）\n│   │   └── master.json       # ★★★★ 大师（500 个）\n│   ├── levels.json           # 关卡配置（50 关）\n│   ├── characters.json       # 角色配置\n│   ├── skins.json            # 皮肤配置\n│   ├── daily-tasks.json      # 每日任务模板\n│   └── economy.json          # 经济数值配置\n│\n├── assets/\n│   ├── icons/                # 分类图标（动物/数字/历史等，< 50KB）\n│   ├── characters/           # 角色头像（4 个 × 16KB = 64KB）\n│   ├── backgrounds/          # 答题背景（5 个 × 30KB = 150KB）\n│   ├── effects/              # 特效帧（连击/正确/错误，< 100KB）\n│   └── audio/                # 音效（< 200KB 总计）\n│       ├── sfx/              # 短音效\n│       └── bgm/              # 背景音乐\n│\n└── README.md\n```\n\n### 8.3 可复用三消游戏框架的模块\n\n| 模块 | 三消项目文件 | 复用程度 | 修改内容 |\n|------|-------------|----------|----------|\n| 广告管理 | `ad-manager.js` | **90%** | 调整广告位配置 |\n| 社交分享 | `social.js` | **80%** | 改分享文案和图片 |\n| 经济系统 | `economy.js` | **70%** | 调整金币数值 |\n| 数据存储 | `storage.js` | **95%** | 几乎直接复用 |\n| 云开发 | `cloud.js` | **80%** | 调整排行榜字段 |\n| 平台适配 | `platform/` | **100%** | 完全复用 |\n\n**预估框架复用可节省 40-50% 开发时间。**\n\n### 8.4 成语数据库设计\n\n```json\n{\n  \"id\": \"idiom_00001\",\n  \"idiom\": \"画蛇添足\",\n  \"chars\": [\"画\", \"蛇\", \"添\", \"足\"],\n  \"pinyin\": \"huà shé tiān zú\",\n  \"meaning\": \"比喻做了多余的事，反而不恰当\",\n  \"origin\": \"《战国策·齐策二》\",\n  \"example\": \"你已经写得很好了，再修改就是画蛇添足。\",\n  \"difficulty\": 1,\n  \"category\": [\"动物\", \"寓言\"],\n  \"tags\": [\"小学\", \"常用\"],\n  \"distractors_easy\": [\"龙\", \"虎\", \"飞\", \"跑\"],\n  \"distractors_hard\": [\"化\", \"它\", \"捻\", \"促\"],\n  \"frequency\": 95\n}\n```\n\n**数据库字段说明**：\n\n| 字段 | 类型 | 说明 |\n|------|------|------|\n| id | string | 唯一标识 |\n| idiom | string | 成语原文 |\n| chars | string[4] | 四个字（有序） |\n| pinyin | string | 拼音（带声调） |\n| meaning | string | 白话文释义 |\n| origin | string | 出处 |\n| example | string | 例句 |\n| difficulty | int | 难度等级（1-4） |\n| category | string[] | 类别标签 |\n| tags | string[] | 附加标签 |\n| distractors_easy | string[] | 简单干扰字（形音差异大） |\n| distractors_hard | string[] | 困难干扰字（形近/音近） |\n| frequency | int | 使用频率（1-100，100 最常用） |\n\n### 8.5 数据获取策略\n\n| 阶段 | 方式 | 数量 | 时间 |\n|------|------|------|------|\n| **首发** | AI 辅助生成 + 人工审核 | 2,000 条 | W1-W2 |\n| **V1.1** | 公开成语词典数据（合规抓取） | +3,000 条 | 上线后 2 周 |\n| **持续** | 每周新增 50 条 + 玩家投稿 | +200 条/月 | 持续 |\n\n**AI 生成流程**：\n1. 从《汉语成语大词典》提取成语列表（公开数据）\n2. AI 批量生成释义、拼音、例句、干扰字\n3. 人工审核：释义准确性、例句自然度、干扰字合理性\n4. 按难度分类 + 打标签\n5. 导入 JSON 数据库\n\n### 8.6 抖音小游戏 SDK 集成要点\n\n#### 入口文件 app.js\n\n```javascript\nApp({\n  onLaunch() {\n    // 初始化广告\n    this.adManager = new AdManager();\n    this.adManager.init();\n\n    // 初始化存储\n    this.storage = new Storage();\n    this.storage.init();\n\n    // 获取用户信息\n    tt.login({\n      success: (res) => {\n        this.userId = res.code;\n      }\n    });\n  },\n  globalData: {\n    userId: null,\n    adManager: null,\n    storage: null\n  }\n});\n```\n\n#### 出题引擎核心\n\n```javascript\n// idiom-engine.js\nclass IdiomEngine {\n  constructor(idiomDB) {\n    this.db = idiomDB; // 按难度分组的成语数据\n    this.history = [];  // 已出题目（避免重复）\n  }\n\n  generateQuestion(difficulty) {\n    const pool = this.db.getByDifficulty(difficulty);\n    const idiom = this.pickRandom(pool, this.history);\n    this.history.push(idiom.id);\n\n    const distractorCount = [0, 4, 6, 8, 8][difficulty];\n    const distractors = idiom.distractors_hard\n      ? idiom.distractors_hard.slice(0, distractorCount)\n      : this.generateDistractors(idiom, distractorCount);\n\n    return {\n      idiom: idiom,\n      slots: [null, null, null, null],\n      candidates: this.shuffle([...idiom.chars, ...distractors]),\n      answered: false\n    };\n  }\n}\n```\n\n---\n\n## 九、美术风格定义\n\n### 9.1 主题\n\n**\"国风书斋\"** — 中国传统文化气息，水墨淡雅，有书卷气但不老气\n\n### 9.2 色彩规范\n\n| 用途 | 颜色 | HEX | 说明 |\n|------|------|-----|------|\n| 主背景 | 宣纸色 | #F5F0E8 | 温暖米色，有纸质感 |\n| 卡片/面板 | 白色微黄 | #FFFDF7 | 比背景稍亮 |\n| 主色调 | 朱砂红 | #C84B31 | 按钮/高亮/正确 |\n| 辅助色 | 墨绿 | #2D6A4F | 进度条/成功 |\n| 金色强调 | 金箔色 | #D4A843 | 星星/奖励/高级 |\n| 文字主色 | 墨黑 | #2C2C2C | 正文 |\n| 文字副色 | 灰棕 | #8B7355 | 次要信息 |\n| 正确反馈 | 翠绿 | #27AE60 | 答对 |\n| 错误反馈 | 朱红 | #E74C3C | 答错 |\n| 连击特效 | 金色渐变 | #FFD700→#FFA500 | 连击高光 |\n\n### 9.3 字体规范\n\n| 用途 | 字体 | 说明 |\n|------|------|------|\n| 成语填空 | 思源宋体 / 系统宋体 | 正式感，有文化氛围 |\n| 候选字 | 系统默认圆体 | 清晰易辨认 |\n| 释义/正文 | 系统默认 | 可读性优先 |\n| 数字/分数 | DIN / 等宽 | 对齐美观 |\n\n### 9.4 UI 设计规范\n\n| 元素 | 规范 |\n|------|------|\n| 成语空位 | 4 个正方形，深色边框，底部有浅色横线，尺寸 60×60px |\n| 候选字按钮 | 圆角正方形（圆角 12px），朱砂红底 + 白字，按压缩小 5% |\n| 正确动画 | 空位变绿 + 对勾弹出 + 候选字位置出现绿色勾 |\n| 错误动画 | 空位变红 + 左右抖动 + 字飞回候选位置 |\n| 按钮 | 圆角矩形，朱砂红渐变，白色文字，按压缩小 5% |\n| 弹窗 | 白色圆角面板 + 半透明遮罩，底部滑入 |\n| 星星 | 金色五角星，从左到右依次弹出 |\n| 连击文字 | 从小到大弹出，金色描边，0.3s 淡出 |\n\n### 9.5 章节视觉\n\n| 章节 | 背景元素 | 色调 |\n|------|----------|------|\n| 初学启蒙 | 竹简 + 晨光 | 浅黄暖色 |\n| 蒙学进阶 | 书桌 + 茶杯 | 橙色暖调 |\n| 经典成语 | 窗外夕阳 + 书架 | 深橙红 |\n| 典故深处 | 月光 + 古书 | 深蓝紫 |\n| 博学大师 | 星空 + 卷轴 | 星空金黑 |\n\n---\n\n## 十、新手引导流程\n\n### 10.1 引导序列\n\n| 步骤 | 时间 | 触发条件 | 引导动作 | UI 表现 |\n|------|------|----------|----------|---------|\n| T1 | 0-3s | 第 1 关第 1 题 | 显示成语释义 + 高亮第 1 个正确候选字 | 半透明遮罩 + 箭头 + 手指动画 |\n| T2 | 3-6s | 玩家点击第 1 个字 | 字飞入空位 + 自动高亮第 2 个正确字 | 继续引导 |\n| T3 | 6-10s | 4 字填完（引导完成） | 正确动画 + 释义弹出 | \"心花怒放：形容非常开心！\" |\n| T4 | 10-15s | 第 2 题出现 | 高亮第 1 个字，其余自由操作 | 逐步减少引导 |\n| T5 | 15-25s | 第 3-5 题 | 无引导，自由作答 | — |\n| T6 | 25-30s | 连对 3 题 | 连击特效触发 | \"连击 ×3！太棒了！\" |\n| T7 | 30-35s | 第 7 题出错 | 红色抖动 + 引导使用提示按钮 | \"卡住了？试试揭示一个字\" |\n| T8 | 35-40s | 第 1 关完成 | 星级评定 + 结算页 | \"完美通关！\" |\n\n### 10.2 引导设计原则\n\n- 第 1 关完全引导，确保成功体验\n- 第 2-3 关逐步放手，只在关键新功能出现时引导\n- 第 4 关起无引导\n- 智能跳过：如果检测到玩家已理解操作（如 3 秒内自主答题），跳过后续引导\n\n---\n\n## 十一、开发排期（3 周里程碑）\n\n### Week 1：核心玩法（MVP）\n\n| 天 | 任务 | 交付物 |\n|----|------|--------|\n| D1 | 项目搭建 + TTML 页面结构 + 全局样式 | 可运行的小程序框架 |\n| D1 | 成语数据库设计 + AI 生成 500 条初始数据 | idioms/easy.json |\n| D2 | 出题引擎（选题 + 干扰字 + 随机排列） | 可生成完整题目 |\n| D2 | 答题界面（空位 + 候选字 + 点击交互） | 可交互的答题页 |\n| D3 | 答题判定（正确/错误动画 + 生命系统） | 完整的单题循环 |\n| D3 | 连击系统（计算 + 特效 + 加分） | 连击反馈完整 |\n| D4 | 关卡配置系统 + JSON 加载 | 可配置不同关卡 |\n| D4 | 前 20 关数据制作 + 关卡地图页面 | 20 个可玩关卡 |\n| D5 | 新手引导序列 + W1 内测 | 稳定可玩的 20 关 Demo |\n\n**W1 里程碑验收**：20 关完整可玩，含教学引导、连击系统、生命值、音效。\n\n### Week 2：完整体验 + 社交\n\n| 天 | 任务 | 交付物 |\n|----|------|--------|\n| D6 | 限时挑战模式 + 倒计时 + 排行 | 限时模式可玩 |\n| D6 | 成语图鉴系统（收集 + 分类 + 详情） | 图鉴页完成 |\n| D7 | 提示系统（揭示/去干扰/跳过）+ 金币消耗 | 所有道具就绪 |\n| D7 | 每日系统（登录/任务/挑战） | 每日内容 |\n| D8 | 好友 PK 模式 + 云端数据同步 | PK 可玩 |\n| D8 | 抖音分享集成 + 短视频分享 | 社交分享就绪 |\n| D9 | 角色系统 + 皮肤系统 | 4 角色 + 3 皮肤 |\n| D9 | 关卡 21-50 数据制作 | 50 关完整 |\n| D10 | W2 内测 + Bug 修复 | 稳定可玩的 50 关 + 社交 |\n\n**W2 里程碑验收**：50 关 + 三模式 + 图鉴 + 角色 + 社交分享。\n\n### Week 3：变现 + 上线\n\n| 天 | 任务 | 交付物 |\n|----|------|--------|\n| D11 | 穿山甲 SDK 集成（复用三消广告管理） | 广告可展示 |\n| D11 | 6 个广告位 UI + 频率控制 | 广告系统完成 |\n| D12 | 数据埋点（复用三消埋点框架） | 关键事件全覆盖 |\n| D12 | 包体优化 + 资源压缩 | < 2MB |\n| D13 | 全量测试 + Bug 修复 | 无阻塞性 Bug |\n| D13 | 软著材料提交 | 提审准备 |\n| D14 | 抖音提审 | 提交审核 |\n| D14 | 备用：修复审核反馈 | 快速迭代 |\n| D15 | 上线 + 监控首日数据 | 正式发布 |\n\n**W3 里程碑验收**：游戏上架抖音小游戏平台，广告变现运行正常。\n\n### 11.1 关键依赖\n\n| 依赖项 | 来源 | 截止时间 | 风险 |\n|--------|------|----------|------|\n| 抖音开发者账号 | 复用三消项目 | 已有 | 无 |\n| 穿山甲广告账号 | 复用三消项目 | 已有 | 无 |\n| 软著 | 复用三消项目主体 | 提审前 | 低 |\n| 成语数据库 2000 条 | AI 生成 + 人工审核 | D2-D5 | 中（需人工审核） |\n| 角色头像 4 张 | AI 绘制 | W1 结束 | 低 |\n| 背景图 5 张 | AI 绘制 | W2 结束 | 低 |\n| 音效 10-15 个 | AI 生成 | W1 结束 | 低 |\n\n---\n\n## 十二、数据埋点与运营\n\n### 12.1 关键指标\n\n| 指标 | 定义 | 目标值 | 告警阈值 |\n|------|------|--------|----------|\n| 次日留存 | D1/D0 | 35%+ | < 25% |\n| 7 日留存 | D7/D0 | 18%+ | < 10% |\n| 平均会话时长 | — | 6+ 分钟 | < 3 分钟 |\n| 人均广告次数/天 | — | 6+ 次 | < 3 次 |\n| 激励视频完成率 | — | 90%+ | < 75% |\n| 新手引导完成率 | 完成教学关卡比例 | 95%+ | < 80% |\n| 关卡通过率（前 10 关） | 单关通过比例 | 85%+ | < 70% |\n| PK 参与率 | DAU 中参与 PK 比例 | 30%+ | < 15% |\n| 图鉴收集率 | 人均收集成语数 | 50+/周 | < 20/周 |\n| ARPU | 日收入/DAU | ¥0.34+ | < ¥0.15 |\n\n### 12.2 埋点事件\n\n```javascript\nconst EVENTS = {\n  GAME_START: 'game_start',           // 游戏启动\n  TUTORIAL_STEP: 'tutorial_step',     // 引导步骤\n  LEVEL_START: 'level_start',         // 关卡开始\n  QUESTION_ANSWER: 'question_answer', // 答题结果（正确/错误/用时/是否用提示）\n  LEVEL_COMPLETE: 'level_complete',   // 关卡完成（正确率/星级/金币）\n  LEVEL_FAIL: 'level_fail',           // 关卡失败（剩余生命/第几题失败）\n  COMBO_HIT: 'combo_hit',             // 连击数（N 连击触发）\n  HINT_USE: 'hint_use',               // 使用提示（类型：揭示/去干扰/跳过）\n  AD_SHOW: 'ad_show',                 // 广告展示（广告位/是否完成）\n  SHARE: 'share',                     // 分享（类型：PK/求助/成绩/每日挑战）\n  PK_START: 'pk_start',               // PK 开始\n  PK_RESULT: 'pk_result',             // PK 结果（胜/负/平）\n  TIMED_START: 'timed_start',         // 限时挑战开始\n  TIMED_END: 'timed_end',             // 限时挑战结束（分数/答题数）\n  COLLECTION_UNLOCK: 'collection_unlock', // 解锁新成语\n  CHARACTER_USE: 'character_use',     // 角色使用\n};\n```\n\n---\n\n## 十三、风险与缓解\n\n| 风险 | 概率 | 影响 | 缓解措施 |\n|------|------|------|----------|\n| 成语数据质量差 | 中 | 玩家信任度下降 | AI 生成后必须人工审核释义准确性 |\n| 成语歧义（多组成语） | 中 | 玩家困惑 | 出题时排除有歧义的成语；提供释义辅助 |\n| 互动性不如三消 | 中 | 留存偏低 | 用 PK、限时、排行弥补；加快节奏 |\n| 题库消耗过快 | 中 | 内容枯竭 | 首发 2000 条 + 每周更新；按频率分配保证 50 关不重复 |\n| 广告 eCPM 偏低 | 中 | 收入不足 | 增加激励视频比重；优化提示触发点 |\n| 文字游戏天花板低 | 中 | DAU 上限低 | 作为矩阵第二产品，不追求单一爆款 |\n\n---\n\n## 十四、版本规划\n\n| 版本 | 时间 | 内容 |\n|------|------|------|\n| **V1.0** | 第 3 周末 | 50 关 + IAA 广告 + 基础社交 + 4 角色 + 图鉴 |\n| V1.1 | 上线后 2 周 | 内购道具 + 题库扩充至 5000 + 新章节 51-80 关 |\n| V1.2 | 上线后 4 周 | 月卡系统 + 每周挑战赛 + 新角色 + 皮肤商店 |\n| V1.3 | 上线后 6 周 | 微信小游戏版本上线 |\n| V2.0 | 上线后 2 月 | Emoji 猜成语模式 + 看图猜成语 + 成语接龙模式 |\n\n---\n\n## 附录 A：调参表\n\n```\n变量                       | 基础值   | 最小值 | 最大值 | 调参备注\n---------------------------|---------|--------|--------|---------------------------\n初始生命值                   | 5       | 3      | 8      | ★ 简单关 5，★★★ 关 3 [待测试]\n每关题数                     | 10      | 8      | 15     | Boss 关可增加\n候选字数（★ 简单）           | 8       | 6      | 10     | [待测试] 8 是否太容易\n候选字数（★★★★ 大师）      | 12      | 10     | 16     | [待测试]\n答错扣命数                   | 1       | 1      | 2      | 保持 1，降低挫败感\n续命恢复命数                 | 3       | 2      | 5      | [待测试]\n揭示提示金币价格              | 5       | 3      | 10     | [待测试]\n去干扰金币价格                | 8       | 5      | 15     | [待测试]\n连击加分倍率                  | 1+0.2×n | 1+0.1×n| 1+0.5×n| [待测试] 是否激励足够\n限时挑战时长                  | 60s     | 30s    | 120s   | [待测试]\n插屏广告间隔（关数）          | 2       | 1      | 4      | [待测试] 2 是否太频繁\n激励视频每日上限              | 15      | 10     | 25     | [待测试]\n```\n\n## 附录 B：音效列表\n\n| ID | 音效名 | 触发时机 | 时长 | 风格 |\n|----|--------|----------|------|------|\n| S01 | char_place | 字填入空位 | 0.1s | 清脆 click |\n| S02 | answer_correct | 答对整题 | 0.3s | 上升音阶叮 |\n| S03 | answer_wrong | 答错 | 0.3s | 低沉 buzz |\n| S04 | combo_3 | 3 连击 | 0.3s | 快乐升调 |\n| S05 | combo_5 | 5 连击 | 0.5s | 激动弦乐 |\n| S06 | combo_8 | 8+ 连击 | 0.6s | 欢呼 + 管弦 |\n| S07 | level_complete | 通关 | 1.0s | 古风 fanfare |\n| S08 | level_fail | 失败 | 0.8s | 柔和叹息 |\n| S09 | star_earned | 获得星星 | 0.2s | 叮—— |\n| S10 | hint_reveal | 使用揭示 | 0.2s | 翻书声 |\n| S11 | hint_remove | 使用去干扰 | 0.2s | 消散声 |\n| S12 | pk_win | PK 胜利 | 0.8s | 胜利鼓点 |\n| S13 | pk_lose | PK 失败 | 0.5s | 鼓励音 |\n| S14 | button_click | 按钮点击 | 0.08s | 轻触 |\n| S15 | timed_tick | 倒计时最后 10 秒 | 0.1s | 滴答 |\n\n## 附录 C：成语图鉴分类设计\n\n| 类别 | 数量（首发） | 图标 | 解锁条件 |\n|------|-------------|------|----------|\n| 动物世界 | 300 | 🐉 | 初始解锁 |\n| 数字密码 | 150 | 🔢 | 通关第 2 章 |\n| 历史典故 | 250 | 📜 | 通关第 3 章 |\n| 自然风光 | 150 | 🏔️ | 通关第 4 章 |\n| 人物描写 | 200 | 👤 | 收集 100 个成语 |\n| 寓言哲理 | 200 | 💡 | 收集 150 个成语 |\n| 军事谋略 | 150 | ⚔️ | 收集 200 个成语 |\n| 情感表达 | 150 | ❤️ | 收集 300 个成语 |\n| 四季时令 | 100 | 🌸 | 收集 400 个成语 |\n| 美食文化 | 100 | 🍜 | 收集 500 个成语 |\n\n每类收集满 → 解锁该类专属背景皮肤\n\n## 附录 D：变更日志\n\n| 版本 | 日期 | 变更内容 |\n|------|------|----------|\n| 1.0 | 2026-05-23 | 初始立项文档 |\n","numLines":1023,"startLine":1,"totalLines":1023}}}
