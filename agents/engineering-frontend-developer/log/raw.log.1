{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f3fb00886d0b4110aee7d691","type":"tool_result","content":"2316\tasync function loadSystemInfo() {\n2317\t  try {\n2318\t    const resp = await fetch(`${API_BASE}/health`);\n2319\t    if (!resp.ok) throw new Error('health API failed');\n2320\t    const data = await resp.json();\n2321\t\n2322\t    document.getElementById('server-status').textContent =\n2323\t      data.status === 'healthy' ? '运行中' : data.status;\n2324\t\n2325\t    if (data.uptime_seconds != null) {\n2326\t      const s = Math.floor(data.uptime_seconds);\n2327\t      const h = Math.floor(s / 3600);\n2328\t      const m = Math.floor((s % 3600) / 60);\n2329\t      const sec = s % 60;\n2330\t      document.getElementById('server-uptime').textContent = `${h}小时 ${m}分钟 ${sec}秒`;\n2331\t    }\n2332\t\n2333\t    if (data.agents) {\n2334\t      document.getElementById('agent-stats').textContent =\n2335\t        `总计 ${data.agents.total} 个，活跃 ${data.agents.active} 个，禁用 ${data.agents.disabled} 个`;\n2336\t    }\n2337\t\n2338\t    if (data.system) {\n2339\t      const sys = data.system;\n2340\t      const item = document.getElementById('sys-resource-item');\n2341\t      const desc = document.getElementById('sys-resource');\n2342\t      item.style.display = '';\n2343\t      desc.textContent = `CPU ${sys.cpu_percent}% | 内存 ${sys.memory_percent}% (可用 ${sys.memory_available_gb}GB) | 磁盘 ${sys.disk_percent}% (剩余 ${sys.disk_free_gb}GB)`;\n2344\t    }\n2345\t  } catch (e) {\n2346\t    document.getElementById('server-status').textContent = '连接失败';\n2347\t  }\n2348\t}\n2349\t\n2350\t// 启用 agent\n2351\tasync function enableAgent(id) {\n2352\t  try {\n2353\t    const response = await fetch(`${API_BASE}/agents/${id}/enable`, { method: 'POST' });\n2354\t    if (response.ok) {\n2355\t      showNotification('Agent 已启用', 'success');\n2356\t      setTimeout(() => loadAgents(), 1000);\n2357\t    }\n2358\t  } catch (error) {\n2359\t    showNotification('启用失败: ' + error.message, 'error');\n2360\t  }\n2361\t}\n2362\t\n2363\t// 禁用 agent\n2364\tasync function disableAgent(id) {\n2365\t  try {\n2366\t    const response = await fetch(`${API_BASE}/agents/${id}/disable`, { method: 'POST' });\n2367\t    if (response.ok) {\n2368\t      showNotification('Agent 已禁用', 'success');\n2369\t      setTimeout(() => loadAgents(), 1000);\n2370\t    }\n2371\t  } catch (error) {\n2372\t    showNotification('禁用失败: ' + error.message, 'error');\n2373\t  }\n2374\t}\n2375\t\n2376\t// 清空日志\n2377\tfunction clearLogs() {\n2378\t  document.getElementById('logs-content').innerHTML = '<div style=\"text-align: center; color: var(--text2);\">日志已清空</div>';\n2379\t  showNotification('日志已清空', 'success');\n2380\t}\n2381\t\n2382\t// 长期任务相关函数\n2383\tasync function loadLongTask() {\n2384\t  try {\n2385\t    const response = await fetch(`${API_BASE}/longtask`);\n2386\t    if (!response.ok) throw new Error('API 请求失败');\n2387\t    const data = await response.json();\n2388\t\n2389\t    // 更新主页卡片\n2390\t    const mainStatusEl = document.getElementById('longtask-status-main');\n2391\t    const mainContentEl = document.getElementById('longtask-content-main');\n2392\t    const mainTextEl = document.getElementById('longtask-content-main');\n2393\t    const mainBadgeEl = document.getElementById('longtask-badge');\n2394\t    const mainEditBtn = document.getElementById('edit-longtask-btn-main');\n2395\t    const mainCancelBtn = document.getElementById('cancel-longtask-btn-main');\n2396\t\n2397\t    if (data.exists) {\n2398\t      // 主页更新\n2399\t      if (mainStatusEl) mainStatusEl.innerHTML = `<strong style=\"color: var(--accent);\">进行中</strong>`;\n2400\t      if (mainTextEl) mainTextEl.textContent = data.content;\n2401\t      if (mainContentEl) mainContentEl.style.display = 'block';\n2402\t      if (mainBadgeEl) mainBadgeEl.style.display = 'inline-block';\n2403\t      if (mainEditBtn) mainEditBtn.style.display = 'block';\n2404\t      if (mainCancelBtn) mainCancelBtn.style.display = 'block';\n2405\t    } else {\n2406\t      // 主页更新 - 无任务\n2407\t      if (mainStatusEl) mainStatusEl.textContent = '暂无长期任务';\n2408\t      if (mainContentEl) mainContentEl.style.display = 'none';\n2409\t      if (mainBadgeEl) mainBadgeEl.style.display = 'none';\n2410\t      if (mainEditBtn) mainEditBtn.style.display = 'none';\n2411\t      if (mainCancelBtn) mainCancelBtn.style.display = 'none';\n2412\t    }\n2413\t\n2414\t    // 更新设置页面（保持兼容）\n2415\t    const statusEl = document.getElementById('longtask-status');\n2416\t    const contentEl = document.getElementById('longtask-content');\n2417\t    const textEl = document.getElementById('longtask-text');\n2418\t    const cancelBtn = document.getElementById('cancel-longtask-btn');\n2419\t\n2420\t    if (data.exists) {\n2421\t      if (statusEl) statusEl.textContent = '有活动任务';\n2422\t      if (textEl) textEl.textContent = data.content;\n2423\t      if (contentEl) contentEl.style.display = 'block';\n2424\t      if (cancelBtn) cancelBtn.style.display = 'block';\n2425\t      const editBtn = document.getElementById('edit-longtask-btn');\n2426\t      if (editBtn) editBtn.style.display = 'block';\n2427\t    } else {\n2428\t      if (statusEl) statusEl.textContent = '无长期任务';\n2429\t      if (contentEl) contentEl.style.display = 'none';\n2430\t      if (cancelBtn) cancelBtn.style.display = 'none';\n2431\t    }\n2432\t  } catch (error) {\n2433\t    console.error('加载长期任务失败:', error);\n2434\t    const mainStatusEl = document.getElementById('longtask-status-main');\n2435\t    const statusEl = document.getElementById('longtask-status');\n2436\t    if (mainStatusEl) mainStatusEl.textContent = '加载失败';\n2437\t    if (statusEl) statusEl.textContent = '加载失败';\n2438\t  }\n2439\t}\n2440\t\n2441\tasync function cancelLongTask() {\n2442\t  if (!confirm('确定要取消长期任务吗？此操作不可恢复。')) return;\n2443\t\n2444\t  try {\n2445\t    const response = await fetch(`${API_BASE}/longtask/clear`, { method: 'POST' });\n2446\t    if (!response.ok) throw new Error('API 请求失败');\n2447\t    const data = await response.json();\n2448\t\n2449\t    showNotification(data.message || '长期任务已取消', 'success');\n2450\t    await loadLongTask();\n2451\t  } catch (error) {\n2452\t    console.error('取消长期任务失败:', error);\n2453\t    showNotification('取消失败: ' + error.message, 'error');\n2454\t  }\n2455\t}\n2456\t\n2457\t// 通知系统\n2458\t\n2459\tasync function startEditLongTask() {\n2460\t  const contentEl = document.getElementById('longtask-content');\n2461\t  const editEl = document.getElementById('longtask-edit');\n2462\t  const editorEl = document.getElementById('longtask-editor');\n2463\t  const textEl = document.getElementById('longtask-text');\n2464\t  \n2465\t  editorEl.value = textEl.textContent || '';\n2466\t  contentEl.style.display = 'none';\n2467\t  editEl.style.display = 'block';\n2468\t  showNotification('进入编辑模式', 'info');\n2469\t}\n2470\t\n2471\tasync function saveLongTask() {\n2472\t  const editorEl = document.getElementById('longtask-editor');\n2473\t  const content = editorEl.value;\n2474\t  \n2475\t  try {\n2476\t    const response = await fetch(`${API_BASE}/longtask/update`, {\n2477\t      method: 'POST',\n2478\t      headers: { 'Content-Type': 'application/json' },\n2479\t      body: JSON.stringify({ content })\n2480\t    });\n2481\t    if (!response.ok) throw new Error('API 请求失败');\n2482\t    const data = await response.json();\n2483\t    \n2484\t    showNotification(data.message || '长期任务已更新', 'success');\n2485\t    document.getElementById('longtask-edit').style.display = 'none';\n2486\t    await loadLongTask();\n2487\t  } catch (error) {\n2488\t    console.error('保存长期任务失败:', error);\n2489\t    showNotification('保存失败: ' + error.message, 'error');\n2490\t  }\n2491\t}\n2492\t\n2493\tfunction cancelEditLongTask() {\n2494\t  document.getElementById('longtask-edit').style.display = 'none';\n2495\t  document.getElementById('longtask-content').style.display = 'block';\n2496\t  showNotification('已取消编辑', 'info');\n2497\t}\n2498\t\n2499\t// 主页长期任务编辑函数\n2500\tasync function startEditLongTaskMain() {\n2501\t  const contentEl = document.getElementById('longtask-content-main');\n2502\t  const editEl = document.getElementById('longtask-edit-main');\n2503\t  const editorEl = document.getElementById('longtask-editor-main');\n2504\t\n2505\t  editorEl.value = contentEl.textContent || '';\n2506\t  contentEl.style.display = 'none';\n2507\t  editEl.style.display = 'block';\n2508\t  showNotification('进入编辑模式', 'info');\n2509\t}\n2510\t\n2511\tasync function saveLongTaskMain() {\n2512\t  const editorEl = document.getElementById('longtask-editor-main');\n2513\t  const content = editorEl.value;\n2514\t\n2515\t  try {\n2516\t    const response = await fetch(`${API_BASE}/longtask/update`, {\n2517\t      method: 'POST',\n2518\t      headers: { 'Content-Type': 'application/json' },\n2519\t      body: JSON.stringify({ content })\n2520\t    });\n2521\t    if (!response.ok) throw new Error('API 请求失败');\n2522\t    const data = await response.json();\n2523\t\n2524\t    showNotification(data.message || '长期任务已更新', 'success');\n2525\t    document.getElementById('longtask-edit-main').style.display = 'none';\n2526\t    await loadLongTask();\n2527\t  } catch (error) {\n2528\t    console.error('保存长期任务失败:', error);\n2529\t    showNotification('保存失败: ' + error.message, 'error');\n2530\t  }\n2531\t}\n2532\t\n2533\tfunction cancelEditLongTaskMain() {\n2534\t  document.getElementById('longtask-edit-main').style.display = 'none';\n2535\t  document.getElementById('longtask-content-main').style.display = 'block';\n2536\t  showNotification('已取消编辑', 'info');\n2537\t}\n2538\t\n2539\tasync function cancelLongTaskMain() {\n2540\t  if (!confirm('确定要取消长期任务吗？此操作不可恢复。')) return;\n2541\t\n2542\t  try {\n2543\t    const response = await fetch(`${API_BASE}/longtask/clear`, { method: 'POST' });\n2544\t    if (!response.ok) throw new Error('API 请求失败');\n2545\t    const data = await response.json();\n2546\t\n2547\t    showNotification(data.message || '长期任务已取消', 'success');\n2548\t    await loadLongTask();\n2549\t  } catch (error) {\n2550\t    console.error('取消长期任务失败:', error);\n2551\t    showNotification('取消失败: ' + error.message, 'error');\n2552\t  }\n2553\t}\n2554\t\n2555\t// 导航切换事件\n2556\tdocument.querySelectorAll('.nav-item').forEach(item => {\n2557\t  item.addEventListener('click', () => {\n2558\t    const pageId = item.dataset.page;\n2559\t    if (pageId) {\n2560\t      navigateTo(pageId);\n2561\t    }\n2562\t  });\n2563\t});\n2564\t\n2565\t// 自动刷新\n2566\tlet autoRefreshTimer = null;\n2567\t\n2568\tfunction startAutoRefresh(interval = 10000) {\n2569\t  stopAutoRefresh();\n2570\t  autoRefreshTimer = setInterval(async () => {\n2571\t    const activePage = document.querySelector('.page.active');\n2572\t    if (activePage) {\n2573\t      const pageId = activePage.id.replace('page-', '');\n2574\t      await loadPageData(pageId);\n2575\t    }\n2576\t  }, interval);\n2577\t  updateRefreshIndicator(true, interval);\n2578\t  console.log(`自动刷新已启动 (${interval}ms)`);\n2579\t}\n2580\t\n2581\tfunction stopAutoRefresh() {\n2582\t  if (autoRefreshTimer) {\n2583\t    clearInterval(autoRefreshTimer);\n2584\t    autoRefreshTimer = null;\n2585\t    updateRefreshIndicator(false, 0);\n2586\t    console.log('自动刷新已停止');\n2587\t  }\n2588\t}\n2589\t\n2590\t// 键盘快捷键\n2591\tconst keyboardShortcuts = {\n2592\t  '1': 'dashboard',\n2593\t  '2': 'agents',\n2594\t  '3': 'tasks',\n2595\t  '4': 'performance',\n2596\t  '5': 'logs',\n2597\t  '6': 'screenshots',\n2598\t  '7': 'settings',\n2599\t  'r': 'refresh',\n2600\t  'h': 'help'\n2601\t};\n2602\t\n2603\t// 显示快捷键帮助\n2604\tfunction showKeyboardHelp() {\n2605\t  const helpHTML = `\n2606\t    <div style=\"position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);\n2607\t                background: var(--surface); border: 1px solid var(--border);\n2608\t                border-radius: var(--radius); padding: 24px; z-index: 2000;\n2609\t                box-shadow: var(--shadow); min-width: 300px;\">\n2610\t      <h3 style=\"margin-bottom: 16px; color: var(--text);\">键盘快捷键</h3>\n2611\t      <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 13px;\">\n2612\t        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">1</kbd></div>\n2613\t        <div style=\"color: var(--text);\">Agents 页面</div>\n2614\t        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">2</kbd></div>\n2615\t        <div style=\"color: var(--text);\">Tasks 页面</div>\n2616\t        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">3</kbd></div>\n2617\t        <div style=\"color: var(--text);\">Performance 页面</div>\n2618\t        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">4</kbd></div>\n2619\t        <div style=\"color: var(--text);\">Logs 页面</div>\n2620\t        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">5</kbd></div>\n2621\t        <div style=\"color: var(--text);\">Settings 页面</div>\n2622\t        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">R</kbd></div>\n2623\t        <div style=\"color: var(--text);\">刷新当前页面</div>\n2624\t        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">H</kbd></div>\n2625\t        <div style=\"color: var(--text);\">显示帮助</div>\n2626\t        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">ESC</kbd></div>\n2627\t        <div style=\"color: var(--text);\">关闭弹窗</div>\n2628\t      </div>\n2629\t      <button onclick=\"this.parentElement.remove()\"\n2630\t              style=\"margin-top: 16px; width: 100%; padding: 8px; background: var(--accent-gradient);\n2631\t                     color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;\">\n2632\t        关闭\n2633\t      </button>\n2634\t    </div>\n2635\t  `;\n2636\t\n2637\t  // 移除已存在的帮助\n2638\t  const existingHelp = document.querySelector('[data-keyboard-help]');\n2639\t  if (existingHelp) existingHelp.remove();\n2640\t\n2641\t  // 添加新帮助\n2642\t  const helpContainer = document.createElement('div');\n2643\t  helpContainer.innerHTML = helpHTML;\n2644\t  helpContainer.firstElementChild.setAttribute('data-keyboard-help', 'true');\n2645\t  document.body.appendChild(helpContainer.firstElementChild);\n2646\t}\n2647\t\n2648\t// 键盘事件监听\n2649\tdocument.addEventListener('keydown', (e) => {\n2650\t  // ESC 关闭弹窗（无论是否在输入框中）\n2651\t  if (e.key === 'Escape') {\n2652\t    const createModal = document.getElementById('create-agent-modal');\n2653\t    if (createModal) { closeCreateAgentModal(); e.preventDefault(); return; }\n2654\t    closeShortcutsPanel();\n2655\t    const help = document.querySelector('[data-keyboard-help]');\n2656\t    if (help) help.remove();\n2657\t    return;\n2658\t  }\n2659\t\n2660\t  // 如果在输入框中，不处理其他快捷键\n2661\t  if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;\n2662\t\n2663\t  const key = e.key.toLowerCase();\n2664\t\n2665\t  // 处理其他快捷键\n2666\t  if (keyboardShortcuts[key]) {\n2667\t    e.preventDefault();\n2668\t    const action = keyboardShortcuts[key];\n2669\t\n2670\t    if (action === 'refresh') {\n2671\t      const activePage = document.querySelector('.page.active');\n2672\t      if (activePage) {\n2673\t        const pageId = activePage.id.replace('page-', '');\n2674\t        loadPageData(pageId);\n2675\t        showNotification('页面已刷新', 'success');\n2676\t      }\n2677\t    } else if (action === 'help') {\n2678\t      openShortcutsPanel();\n2679\t    } else {\n2680\t      navigateTo(action);\n2681\t    }\n2682\t  }\n2683\t});\n2684\t\n2685\t// 用量统计\n2686\tasync function loadUsageStats() {\n2687\t  const el = document.getElementById('usage-content');\n2688\t  const timeEl = document.getElementById('usage-refresh-time');\n2689\t  try {\n2690\t    const resp = await fetch(`${API_BASE}/usage`);\n2691\t    const data = await resp.json();\n2692\t    if (data.error) { el.innerHTML = `<span style=\"color:var(--red)\">加载失败: ${data.error}</span>`; return; }\n2693\t\n2694\t    const fmt = n => typeof n === 'number' ? n.toLocaleString() : n;\n2695\t    const pctColor = p => p > 80 ? 'var(--red)' : p > 50 ? 'var(--yellow)' : 'var(--green)';\n2696\t    const pctBadge = (label, pct) => `<span style=\"display:inline-flex;align-items:center;gap:6px;padding:6px 14px;background:var(--surface2);border-radius:8px;font-size:13px;\"><span style=\"color:var(--text2)\">${label}</span><span style=\"font-weight:700;color:${pctColor(pct)}\">${pct}%</span></span>`;\n2697\t\n2698\t    // 额度进度条组件\n2699\t    const barColor = p => p > 80 ? '#ef4444' : p > 50 ? '#f59e0b' : '#22c55e';\n2700\t    const quotaBar = (label, pct, detail) => {\n2701\t      const c = barColor(pct);\n2702\t      return `<div style=\"margin-bottom:12px;\">\n2703\t        <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;\">\n2704\t          <span style=\"font-size:13px;font-weight:600;color:var(--text2)\">${label}</span>\n2705\t          <span style=\"font-size:13px;font-weight:700;color:${c}\">${pct}%${detail ? ` (${detail})` : ''}</span>\n2706\t        </div>\n2707\t        <div style=\"height:10px;background:rgba(128,128,128,0.2);border-radius:5px;overflow:hidden;\">\n2708\t          <div style=\"height:100%;width:${Math.min(pct,100)}%;background:${c};border-radius:5px;transition:width .6s ease;\"></div>\n2709\t        </div>\n2710\t      </div>`;\n2711\t    };\n2712\t\n2713\t    let html = `<div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:20px;\">\n2714\t      <div style=\"padding:14px 16px;background:var(--surface2);border-radius:12px;text-align:center;\">\n2715\t        <div style=\"font-size:12px;color:var(--text3);margin-bottom:4px;\">24h 调用</div>\n2716\t        <div style=\"font-size:20px;font-weight:800;color:var(--text);font-family:system-ui,sans-serif;\">${fmt(data.call_count)}</div>\n2717\t      </div>\n2718\t      <div style=\"padding:14px 16px;background:var(--surface2);border-radius:12px;text-align:center;\">\n2719\t        <div style=\"font-size:12px;color:var(--text3);margin-bottom:4px;\">24h Token</div>\n2720\t        <div style=\"font-size:20px;font-weight:800;color:var(--text);font-family:system-ui,sans-serif;\">${fmt(data.total_tokens)}</div>\n2721\t      </div>\n2722\t      ${data.weekly && data.weekly.tokens ? `<div style=\"padding:14px 16px;background:var(--surface2);border-radius:12px;text-align:center;\">\n2723\t        <div style=\"font-size:12px;color:var(--text3);margin-bottom:4px;\">7天 Token</div>\n2724\t        <div style=\"font-size:20px;font-weight:800;color:var(--text);font-family:system-ui,sans-serif;\">${fmt(data.weekly.tokens)}</div>\n2725\t      </div>\n2726\t      <div style=\"padding:14px 16px;background:var(--surface2);border-radius:12px;text-align:center;\">\n2727\t        <div style=\"font-size:12px;color:var(--text3);margin-bottom:4px;\">7天调用</div>\n2728\t        <div style=\"font-size:20px;font-weight:800;color:var(--text);font-family:system-ui,sans-serif;\">${fmt(data.weekly.calls)}</div>\n2729\t      </div>` : ''}\n2730\t    </div>`;\n2731\t\n2732\t    // 额度面板（卡片式）\n2733\t    if (data.quotas && data.quotas.length > 0) {\n2734\t      html += `<div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;margin-bottom:20px;\">`;\n2735\t      (data.quotas).forEach(q => {\n2736\t        let detail = '';\n2737\t        if (q.type === 'mcp_month' && q.current !== undefined && q.total !== undefined) {\n2738\t          detail = `${q.current}/${q.total} 分钟`;\n2739\t        }\n2740\t        const c = barColor(q.percentage);\n2741\t        html += `<div style=\"padding:16px;background:var(--surface2);border-radius:12px;border-left:3px solid ${c};\">\n2742\t          <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;\">\n2743\t            <span style=\"font-size:13px;font-weight:600;color:var(--text2)\">${q.label}</span>\n2744\t            <span style=\"font-size:15px;font-weight:800;color:${c};font-family:system-ui,sans-serif;\">${q.percentage}%</span>\n2745\t          </div>\n2746\t          <div style=\"height:6px;background:rgba(128,128,128,0.15);border-radius:3px;overflow:hidden;\">\n2747\t            <div style=\"height:100%;width:${Math.min(q.percentage,100)}%;background:${c};border-radius:3px;transition:width .6s ease;box-shadow:0 0 8px ${c}40;\"></div>\n2748\t          </div>\n2749\t          ${detail ? `<div style=\"font-size:11px;color:var(--text3);margin-top:6px;\">${detail}</div>` : ''}\n2750\t        </div>`;\n2751\t      });\n2752\t      html += `</div>`;\n2753\t    }\n2754\t\n2755\t    // 模型明细（紧凑列表）\n2756\t    if (data.models && data.models.length > 0) {\n2757\t      html += `<div style=\"font-size:12px;color:var(--text3);margin-bottom:8px;text-transform:uppercase;letter-spacing:1px;\">模型用量</div>`;\n2758\t      html += `<div style=\"display:flex;flex-wrap:wrap;gap:8px;\">` + data.models.map(m => `<div style=\"display:flex;align-items:center;gap:6px;padding:6px 12px;background:var(--surface2);border-radius:8px;font-size:13px;\"><span style=\"color:var(--accent);font-weight:600;\">${m.name}</span><span style=\"color:var(--text2)\">${fmt(m.tokens)} tokens</span></div>`).join('') + `</div>`;\n2759\t    }\n2760\t\n2761\t    el.innerHTML = html;\n2762\t    timeEl.textContent = `更新于 ${new Date().toLocaleTimeString('zh-CN')} (每5分钟刷新)`;\n2763\t  } catch (e) {\n2764\t    el.innerHTML = `<span style=\"color:var(--red)\">加载失败</span>`;\n2765\t  }\n2766\t}\n2767\t\n2768\t// 初始化\n2769\tasync function init() {\n2770\t  // 初始化主题\n2771\t  initTheme();\n2772\t\n2773\t  // 加载初始页面（dashboard）\n2774\t  await loadDashboard();\n2775\t\n2776\t  // 初始化搜索功能\n2777\t  initSearch();\n2778\t\n2779\t  // 定期刷新用量统计\n2780\t  setInterval(loadUsageStats, 5 * 60 * 1000);\n2781\t\n2782\t  // 启动自动刷新（10秒）\n2783\t  startAutoRefresh(10000);\n2784\t\n2785\t  // 设置刷新间隔监听\n2786\t  document.getElementById('refresh-interval')?.addEventListener('change', (e) => {\n2787\t    const interval = parseInt(e.target.value) * 1000;\n2788\t    startAutoRefresh(interval);\n2789\t    showNotification(`刷新间隔已更新为 ${e.target.value} 秒`, 'success');\n2790\t  });\n2791\t\n2792\t  // 主题切换按钮\n2793\t  document.getElementById('theme-toggle')?.addEventListener('click', () => {\n2794\t    cycleTheme();\n2795\t    showNotification(`已切换到 ${themes[currentThemeIndex]} 主题`, 'success');\n2796\t  });\n2797\t\n2798\t  // 帮助按钮\n2799\t  document.getElementById('help-toggle')?.addEventListener('click', openShortcutsPanel);\n2800\t  document.getElementById('shortcuts-overlay')?.addEventListener('click', closeShortcutsPanel);\n2801\t\n2802\t  // 显示快捷键提示（首次访问）\n2803\t  if (!localStorage.getItem('webui_keyboard_help_shown')) {\n2804\t    setTimeout(() => {\n2805\t      showNotification('按 H 查看键盘快捷键', 'info', 5000);\n2806\t      localStorage.setItem('webui_keyboard_help_shown', 'true');\n2807\t    }, 2000);\n2808\t  }\n2809\t}\n2810\t\n2811\tinit();\n2812\t</script>\n2813\t</body>\n2814\t</html>\n2815\t"}]},"parent_tool_use_id":null,"session_id":"d64e1a9d-08e5-4edf-9a30-2c526c5dbaf6","uuid":"1eb1783d-c6c3-4e9b-b6fa-dbd4a46fdf72","timestamp":"2026-05-22T20:21:37.788Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\loopcli\\main\\webui\\index.html","content":"async function loadSystemInfo() {\n  try {\n    const resp = await fetch(`${API_BASE}/health`);\n    if (!resp.ok) throw new Error('health API failed');\n    const data = await resp.json();\n\n    document.getElementById('server-status').textContent =\n      data.status === 'healthy' ? '运行中' : data.status;\n\n    if (data.uptime_seconds != null) {\n      const s = Math.floor(data.uptime_seconds);\n      const h = Math.floor(s / 3600);\n      const m = Math.floor((s % 3600) / 60);\n      const sec = s % 60;\n      document.getElementById('server-uptime').textContent = `${h}小时 ${m}分钟 ${sec}秒`;\n    }\n\n    if (data.agents) {\n      document.getElementById('agent-stats').textContent =\n        `总计 ${data.agents.total} 个，活跃 ${data.agents.active} 个，禁用 ${data.agents.disabled} 个`;\n    }\n\n    if (data.system) {\n      const sys = data.system;\n      const item = document.getElementById('sys-resource-item');\n      const desc = document.getElementById('sys-resource');\n      item.style.display = '';\n      desc.textContent = `CPU ${sys.cpu_percent}% | 内存 ${sys.memory_percent}% (可用 ${sys.memory_available_gb}GB) | 磁盘 ${sys.disk_percent}% (剩余 ${sys.disk_free_gb}GB)`;\n    }\n  } catch (e) {\n    document.getElementById('server-status').textContent = '连接失败';\n  }\n}\n\n// 启用 agent\nasync function enableAgent(id) {\n  try {\n    const response = await fetch(`${API_BASE}/agents/${id}/enable`, { method: 'POST' });\n    if (response.ok) {\n      showNotification('Agent 已启用', 'success');\n      setTimeout(() => loadAgents(), 1000);\n    }\n  } catch (error) {\n    showNotification('启用失败: ' + error.message, 'error');\n  }\n}\n\n// 禁用 agent\nasync function disableAgent(id) {\n  try {\n    const response = await fetch(`${API_BASE}/agents/${id}/disable`, { method: 'POST' });\n    if (response.ok) {\n      showNotification('Agent 已禁用', 'success');\n      setTimeout(() => loadAgents(), 1000);\n    }\n  } catch (error) {\n    showNotification('禁用失败: ' + error.message, 'error');\n  }\n}\n\n// 清空日志\nfunction clearLogs() {\n  document.getElementById('logs-content').innerHTML = '<div style=\"text-align: center; color: var(--text2);\">日志已清空</div>';\n  showNotification('日志已清空', 'success');\n}\n\n// 长期任务相关函数\nasync function loadLongTask() {\n  try {\n    const response = await fetch(`${API_BASE}/longtask`);\n    if (!response.ok) throw new Error('API 请求失败');\n    const data = await response.json();\n\n    // 更新主页卡片\n    const mainStatusEl = document.getElementById('longtask-status-main');\n    const mainContentEl = document.getElementById('longtask-content-main');\n    const mainTextEl = document.getElementById('longtask-content-main');\n    const mainBadgeEl = document.getElementById('longtask-badge');\n    const mainEditBtn = document.getElementById('edit-longtask-btn-main');\n    const mainCancelBtn = document.getElementById('cancel-longtask-btn-main');\n\n    if (data.exists) {\n      // 主页更新\n      if (mainStatusEl) mainStatusEl.innerHTML = `<strong style=\"color: var(--accent);\">进行中</strong>`;\n      if (mainTextEl) mainTextEl.textContent = data.content;\n      if (mainContentEl) mainContentEl.style.display = 'block';\n      if (mainBadgeEl) mainBadgeEl.style.display = 'inline-block';\n      if (mainEditBtn) mainEditBtn.style.display = 'block';\n      if (mainCancelBtn) mainCancelBtn.style.display = 'block';\n    } else {\n      // 主页更新 - 无任务\n      if (mainStatusEl) mainStatusEl.textContent = '暂无长期任务';\n      if (mainContentEl) mainContentEl.style.display = 'none';\n      if (mainBadgeEl) mainBadgeEl.style.display = 'none';\n      if (mainEditBtn) mainEditBtn.style.display = 'none';\n      if (mainCancelBtn) mainCancelBtn.style.display = 'none';\n    }\n\n    // 更新设置页面（保持兼容）\n    const statusEl = document.getElementById('longtask-status');\n    const contentEl = document.getElementById('longtask-content');\n    const textEl = document.getElementById('longtask-text');\n    const cancelBtn = document.getElementById('cancel-longtask-btn');\n\n    if (data.exists) {\n      if (statusEl) statusEl.textContent = '有活动任务';\n      if (textEl) textEl.textContent = data.content;\n      if (contentEl) contentEl.style.display = 'block';\n      if (cancelBtn) cancelBtn.style.display = 'block';\n      const editBtn = document.getElementById('edit-longtask-btn');\n      if (editBtn) editBtn.style.display = 'block';\n    } else {\n      if (statusEl) statusEl.textContent = '无长期任务';\n      if (contentEl) contentEl.style.display = 'none';\n      if (cancelBtn) cancelBtn.style.display = 'none';\n    }\n  } catch (error) {\n    console.error('加载长期任务失败:', error);\n    const mainStatusEl = document.getElementById('longtask-status-main');\n    const statusEl = document.getElementById('longtask-status');\n    if (mainStatusEl) mainStatusEl.textContent = '加载失败';\n    if (statusEl) statusEl.textContent = '加载失败';\n  }\n}\n\nasync function cancelLongTask() {\n  if (!confirm('确定要取消长期任务吗？此操作不可恢复。')) return;\n\n  try {\n    const response = await fetch(`${API_BASE}/longtask/clear`, { method: 'POST' });\n    if (!response.ok) throw new Error('API 请求失败');\n    const data = await response.json();\n\n    showNotification(data.message || '长期任务已取消', 'success');\n    await loadLongTask();\n  } catch (error) {\n    console.error('取消长期任务失败:', error);\n    showNotification('取消失败: ' + error.message, 'error');\n  }\n}\n\n// 通知系统\n\nasync function startEditLongTask() {\n  const contentEl = document.getElementById('longtask-content');\n  const editEl = document.getElementById('longtask-edit');\n  const editorEl = document.getElementById('longtask-editor');\n  const textEl = document.getElementById('longtask-text');\n  \n  editorEl.value = textEl.textContent || '';\n  contentEl.style.display = 'none';\n  editEl.style.display = 'block';\n  showNotification('进入编辑模式', 'info');\n}\n\nasync function saveLongTask() {\n  const editorEl = document.getElementById('longtask-editor');\n  const content = editorEl.value;\n  \n  try {\n    const response = await fetch(`${API_BASE}/longtask/update`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ content })\n    });\n    if (!response.ok) throw new Error('API 请求失败');\n    const data = await response.json();\n    \n    showNotification(data.message || '长期任务已更新', 'success');\n    document.getElementById('longtask-edit').style.display = 'none';\n    await loadLongTask();\n  } catch (error) {\n    console.error('保存长期任务失败:', error);\n    showNotification('保存失败: ' + error.message, 'error');\n  }\n}\n\nfunction cancelEditLongTask() {\n  document.getElementById('longtask-edit').style.display = 'none';\n  document.getElementById('longtask-content').style.display = 'block';\n  showNotification('已取消编辑', 'info');\n}\n\n// 主页长期任务编辑函数\nasync function startEditLongTaskMain() {\n  const contentEl = document.getElementById('longtask-content-main');\n  const editEl = document.getElementById('longtask-edit-main');\n  const editorEl = document.getElementById('longtask-editor-main');\n\n  editorEl.value = contentEl.textContent || '';\n  contentEl.style.display = 'none';\n  editEl.style.display = 'block';\n  showNotification('进入编辑模式', 'info');\n}\n\nasync function saveLongTaskMain() {\n  const editorEl = document.getElementById('longtask-editor-main');\n  const content = editorEl.value;\n\n  try {\n    const response = await fetch(`${API_BASE}/longtask/update`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ content })\n    });\n    if (!response.ok) throw new Error('API 请求失败');\n    const data = await response.json();\n\n    showNotification(data.message || '长期任务已更新', 'success');\n    document.getElementById('longtask-edit-main').style.display = 'none';\n    await loadLongTask();\n  } catch (error) {\n    console.error('保存长期任务失败:', error);\n    showNotification('保存失败: ' + error.message, 'error');\n  }\n}\n\nfunction cancelEditLongTaskMain() {\n  document.getElementById('longtask-edit-main').style.display = 'none';\n  document.getElementById('longtask-content-main').style.display = 'block';\n  showNotification('已取消编辑', 'info');\n}\n\nasync function cancelLongTaskMain() {\n  if (!confirm('确定要取消长期任务吗？此操作不可恢复。')) return;\n\n  try {\n    const response = await fetch(`${API_BASE}/longtask/clear`, { method: 'POST' });\n    if (!response.ok) throw new Error('API 请求失败');\n    const data = await response.json();\n\n    showNotification(data.message || '长期任务已取消', 'success');\n    await loadLongTask();\n  } catch (error) {\n    console.error('取消长期任务失败:', error);\n    showNotification('取消失败: ' + error.message, 'error');\n  }\n}\n\n// 导航切换事件\ndocument.querySelectorAll('.nav-item').forEach(item => {\n  item.addEventListener('click', () => {\n    const pageId = item.dataset.page;\n    if (pageId) {\n      navigateTo(pageId);\n    }\n  });\n});\n\n// 自动刷新\nlet autoRefreshTimer = null;\n\nfunction startAutoRefresh(interval = 10000) {\n  stopAutoRefresh();\n  autoRefreshTimer = setInterval(async () => {\n    const activePage = document.querySelector('.page.active');\n    if (activePage) {\n      const pageId = activePage.id.replace('page-', '');\n      await loadPageData(pageId);\n    }\n  }, interval);\n  updateRefreshIndicator(true, interval);\n  console.log(`自动刷新已启动 (${interval}ms)`);\n}\n\nfunction stopAutoRefresh() {\n  if (autoRefreshTimer) {\n    clearInterval(autoRefreshTimer);\n    autoRefreshTimer = null;\n    updateRefreshIndicator(false, 0);\n    console.log('自动刷新已停止');\n  }\n}\n\n// 键盘快捷键\nconst keyboardShortcuts = {\n  '1': 'dashboard',\n  '2': 'agents',\n  '3': 'tasks',\n  '4': 'performance',\n  '5': 'logs',\n  '6': 'screenshots',\n  '7': 'settings',\n  'r': 'refresh',\n  'h': 'help'\n};\n\n// 显示快捷键帮助\nfunction showKeyboardHelp() {\n  const helpHTML = `\n    <div style=\"position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);\n                background: var(--surface); border: 1px solid var(--border);\n                border-radius: var(--radius); padding: 24px; z-index: 2000;\n                box-shadow: var(--shadow); min-width: 300px;\">\n      <h3 style=\"margin-bottom: 16px; color: var(--text);\">键盘快捷键</h3>\n      <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 13px;\">\n        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">1</kbd></div>\n        <div style=\"color: var(--text);\">Agents 页面</div>\n        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">2</kbd></div>\n        <div style=\"color: var(--text);\">Tasks 页面</div>\n        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">3</kbd></div>\n        <div style=\"color: var(--text);\">Performance 页面</div>\n        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">4</kbd></div>\n        <div style=\"color: var(--text);\">Logs 页面</div>\n        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">5</kbd></div>\n        <div style=\"color: var(--text);\">Settings 页面</div>\n        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">R</kbd></div>\n        <div style=\"color: var(--text);\">刷新当前页面</div>\n        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">H</kbd></div>\n        <div style=\"color: var(--text);\">显示帮助</div>\n        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">ESC</kbd></div>\n        <div style=\"color: var(--text);\">关闭弹窗</div>\n      </div>\n      <button onclick=\"this.parentElement.remove()\"\n              style=\"margin-top: 16px; width: 100%; padding: 8px; background: var(--accent-gradient);\n                     color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;\">\n        关闭\n      </button>\n    </div>\n  `;\n\n  // 移除已存在的帮助\n  const existingHelp = document.querySelector('[data-keyboard-help]');\n  if (existingHelp) existingHelp.remove();\n\n  // 添加新帮助\n  const helpContainer = document.createElement('div');\n  helpContainer.innerHTML = helpHTML;\n  helpContainer.firstElementChild.setAttribute('data-keyboard-help', 'true');\n  document.body.appendChild(helpContainer.firstElementChild);\n}\n\n// 键盘事件监听\ndocument.addEventListener('keydown', (e) => {\n  // ESC 关闭弹窗（无论是否在输入框中）\n  if (e.key === 'Escape') {\n    const createModal = document.getElementById('create-agent-modal');\n    if (createModal) { closeCreateAgentModal(); e.preventDefault(); return; }\n    closeShortcutsPanel();\n    const help = document.querySelector('[data-keyboard-help]');\n    if (help) help.remove();\n    return;\n  }\n\n  // 如果在输入框中，不处理其他快捷键\n  if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;\n\n  const key = e.key.toLowerCase();\n\n  // 处理其他快捷键\n  if (keyboardShortcuts[key]) {\n    e.preventDefault();\n    const action = keyboardShortcuts[key];\n\n    if (action === 'refresh') {\n      const activePage = document.querySelector('.page.active');\n      if (activePage) {\n        const pageId = activePage.id.replace('page-', '');\n        loadPageData(pageId);\n        showNotification('页面已刷新', 'success');\n      }\n    } else if (action === 'help') {\n      openShortcutsPanel();\n    } else {\n      navigateTo(action);\n    }\n  }\n});\n\n// 用量统计\nasync function loadUsageStats() {\n  const el = document.getElementById('usage-content');\n  const timeEl = document.getElementById('usage-refresh-time');\n  try {\n    const resp = await fetch(`${API_BASE}/usage`);\n    const data = await resp.json();\n    if (data.error) { el.innerHTML = `<span style=\"color:var(--red)\">加载失败: ${data.error}</span>`; return; }\n\n    const fmt = n => typeof n === 'number' ? n.toLocaleString() : n;\n    const pctColor = p => p > 80 ? 'var(--red)' : p > 50 ? 'var(--yellow)' : 'var(--green)';\n    const pctBadge = (label, pct) => `<span style=\"display:inline-flex;align-items:center;gap:6px;padding:6px 14px;background:var(--surface2);border-radius:8px;font-size:13px;\"><span style=\"color:var(--text2)\">${label}</span><span style=\"font-weight:700;color:${pctColor(pct)}\">${pct}%</span></span>`;\n\n    // 额度进度条组件\n    const barColor = p => p > 80 ? '#ef4444' : p > 50 ? '#f59e0b' : '#22c55e';\n    const quotaBar = (label, pct, detail) => {\n      const c = barColor(pct);\n      return `<div style=\"margin-bottom:12px;\">\n        <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;\">\n          <span style=\"font-size:13px;font-weight:600;color:var(--text2)\">${label}</span>\n          <span style=\"font-size:13px;font-weight:700;color:${c}\">${pct}%${detail ? ` (${detail})` : ''}</span>\n        </div>\n        <div style=\"height:10px;background:rgba(128,128,128,0.2);border-radius:5px;overflow:hidden;\">\n          <div style=\"height:100%;width:${Math.min(pct,100)}%;background:${c};border-radius:5px;transition:width .6s ease;\"></div>\n        </div>\n      </div>`;\n    };\n\n    let html = `<div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:20px;\">\n      <div style=\"padding:14px 16px;background:var(--surface2);border-radius:12px;text-align:center;\">\n        <div style=\"font-size:12px;color:var(--text3);margin-bottom:4px;\">24h 调用</div>\n        <div style=\"font-size:20px;font-weight:800;color:var(--text);font-family:system-ui,sans-serif;\">${fmt(data.call_count)}</div>\n      </div>\n      <div style=\"padding:14px 16px;background:var(--surface2);border-radius:12px;text-align:center;\">\n        <div style=\"font-size:12px;color:var(--text3);margin-bottom:4px;\">24h Token</div>\n        <div style=\"font-size:20px;font-weight:800;color:var(--text);font-family:system-ui,sans-serif;\">${fmt(data.total_tokens)}</div>\n      </div>\n      ${data.weekly && data.weekly.tokens ? `<div style=\"padding:14px 16px;background:var(--surface2);border-radius:12px;text-align:center;\">\n        <div style=\"font-size:12px;color:var(--text3);margin-bottom:4px;\">7天 Token</div>\n        <div style=\"font-size:20px;font-weight:800;color:var(--text);font-family:system-ui,sans-serif;\">${fmt(data.weekly.tokens)}</div>\n      </div>\n      <div style=\"padding:14px 16px;background:var(--surface2);border-radius:12px;text-align:center;\">\n        <div style=\"font-size:12px;color:var(--text3);margin-bottom:4px;\">7天调用</div>\n        <div style=\"font-size:20px;font-weight:800;color:var(--text);font-family:system-ui,sans-serif;\">${fmt(data.weekly.calls)}</div>\n      </div>` : ''}\n    </div>`;\n\n    // 额度面板（卡片式）\n    if (data.quotas && data.quotas.length > 0) {\n      html += `<div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;margin-bottom:20px;\">`;\n      (data.quotas).forEach(q => {\n        let detail = '';\n        if (q.type === 'mcp_month' && q.current !== undefined && q.total !== undefined) {\n          detail = `${q.current}/${q.total} 分钟`;\n        }\n        const c = barColor(q.percentage);\n        html += `<div style=\"padding:16px;background:var(--surface2);border-radius:12px;border-left:3px solid ${c};\">\n          <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;\">\n            <span style=\"font-size:13px;font-weight:600;color:var(--text2)\">${q.label}</span>\n            <span style=\"font-size:15px;font-weight:800;color:${c};font-family:system-ui,sans-serif;\">${q.percentage}%</span>\n          </div>\n          <div style=\"height:6px;background:rgba(128,128,128,0.15);border-radius:3px;overflow:hidden;\">\n            <div style=\"height:100%;width:${Math.min(q.percentage,100)}%;background:${c};border-radius:3px;transition:width .6s ease;box-shadow:0 0 8px ${c}40;\"></div>\n          </div>\n          ${detail ? `<div style=\"font-size:11px;color:var(--text3);margin-top:6px;\">${detail}</div>` : ''}\n        </div>`;\n      });\n      html += `</div>`;\n    }\n\n    // 模型明细（紧凑列表）\n    if (data.models && data.models.length > 0) {\n      html += `<div style=\"font-size:12px;color:var(--text3);margin-bottom:8px;text-transform:uppercase;letter-spacing:1px;\">模型用量</div>`;\n      html += `<div style=\"display:flex;flex-wrap:wrap;gap:8px;\">` + data.models.map(m => `<div style=\"display:flex;align-items:center;gap:6px;padding:6px 12px;background:var(--surface2);border-radius:8px;font-size:13px;\"><span style=\"color:var(--accent);font-weight:600;\">${m.name}</span><span style=\"color:var(--text2)\">${fmt(m.tokens)} tokens</span></div>`).join('') + `</div>`;\n    }\n\n    el.innerHTML = html;\n    timeEl.textContent = `更新于 ${new Date().toLocaleTimeString('zh-CN')} (每5分钟刷新)`;\n  } catch (e) {\n    el.innerHTML = `<span style=\"color:var(--red)\">加载失败</span>`;\n  }\n}\n\n// 初始化\nasync function init() {\n  // 初始化主题\n  initTheme();\n\n  // 加载初始页面（dashboard）\n  await loadDashboard();\n\n  // 初始化搜索功能\n  initSearch();\n\n  // 定期刷新用量统计\n  setInterval(loadUsageStats, 5 * 60 * 1000);\n\n  // 启动自动刷新（10秒）\n  startAutoRefresh(10000);\n\n  // 设置刷新间隔监听\n  document.getElementById('refresh-interval')?.addEventListener('change', (e) => {\n    const interval = parseInt(e.target.value) * 1000;\n    startAutoRefresh(interval);\n    showNotification(`刷新间隔已更新为 ${e.target.value} 秒`, 'success');\n  });\n\n  // 主题切换按钮\n  document.getElementById('theme-toggle')?.addEventListener('click', () => {\n    cycleTheme();\n    showNotification(`已切换到 ${themes[currentThemeIndex]} 主题`, 'success');\n  });\n\n  // 帮助按钮\n  document.getElementById('help-toggle')?.addEventListener('click', openShortcutsPanel);\n  document.getElementById('shortcuts-overlay')?.addEventListener('click', closeShortcutsPanel);\n\n  // 显示快捷键提示（首次访问）\n  if (!localStorage.getItem('webui_keyboard_help_shown')) {\n    setTimeout(() => {\n      showNotification('按 H 查看键盘快捷键', 'info', 5000);\n      localStorage.setItem('webui_keyboard_help_shown', 'true');\n    }, 2000);\n  }\n}\n\ninit();\n</script>\n</body>\n</html>\n","numLines":500,"startLine":2316,"totalLines":2815}}}
