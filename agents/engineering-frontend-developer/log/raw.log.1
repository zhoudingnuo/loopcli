{"type":"assistant","message":{"id":"msg_202605231204332e10b50b31b34d61","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_383fed3547c34ab6a9ed7a8b","name":"Write","input":{"file_path":"D:\\game-projects\\steam-horror-sim\\src\\game\\EconomySystem.ts","content":"// EconomySystem.ts — Daily income/expenses, debt, and upgrades (M2)\n\nimport upgradesData from '../data/upgrades.json';\n\nexport interface UpgradeDef {\n  id: string;\n  name: string;\n  description: string;\n  cost: number;\n  effect: string;\n  value?: number;\n  horrorLink: string;\n}\n\nexport interface DayReport {\n  day: number;\n  revenue: number;\n  expenses: number;\n  rent: number;\n  electricity: number;\n  purchaseCost: number;\n  netIncome: number;\n  debtPayment: number;\n  debtRemaining: number;\n}\n\nconst ALL_UPGRADES: UpgradeDef[] = upgradesData.upgrades as UpgradeDef[];\n\nconst DAILY_RENT = 100;\nconst DAILY_ELECTRICITY = 20;\nconst DEBT_TOTAL = 300000;\nconst DEBT_DAYS = 30;\n\nexport class EconomySystem {\n  money: number = 500;\n  debt: number = DEBT_TOTAL;\n  debtDailyPayment: number = Math.ceil(DEBT_TOTAL / DEBT_DAYS);\n\n  purchasedUpgrades: Set<string> = new Set();\n  dailyRevenue = 0;\n  dailyExpenses = 0;\n  dailyPurchaseCost = 0;\n  dayReports: DayReport[] = [];\n  dayNumber = 1;\n\n  getUpgrades(): UpgradeDef[] {\n    return ALL_UPGRADES;\n  }\n\n  getAvailableUpgrades(): UpgradeDef[] {\n    return ALL_UPGRADES.filter(u => !this.purchasedUpgrades.has(u.id));\n  }\n\n  purchaseUpgrade(upgradeId: string): { success: boolean; message: string } {\n    const upgrade = ALL_UPGRADES.find(u => u.id === upgradeId);\n    if (!upgrade) return { success: false, message: '升级不存在' };\n    if (this.purchasedUpgrades.has(upgradeId)) return { success: false, message: '已购买' };\n    if (this.money < upgrade.cost) return { success: false, message: '余额不足' };\n\n    this.money -= upgrade.cost;\n    this.purchasedUpgrades.add(upgradeId);\n    return { success: true, message: `已购买: ${upgrade.name}` };\n  }\n\n  hasUpgrade(upgradeId: string): boolean {\n    return this.purchasedUpgrades.has(upgradeId);\n  }\n\n  addRevenue(amount: number): void {\n    this.dailyRevenue += amount;\n    this.money += amount;\n  }\n\n  addExpense(amount: number): void {\n    this.dailyExpenses += amount;\n    this.money -= amount;\n  }\n\n  addPurchaseCost(amount: number): void {\n    this.dailyPurchaseCost += amount;\n    this.money -= amount;\n  }\n\n  endDay(): DayReport {\n    const rent = DAILY_RENT;\n    const electricity = DAILY_ELECTRICITY;\n    const totalExpenses = this.dailyExpenses + rent + electricity + this.dailyPurchaseCost;\n    const netIncome = this.dailyRevenue - totalExpenses;\n    const debtPayment = Math.min(this.debtDailyPayment, this.debt);\n    this.debt -= debtPayment;\n    this.money -= rent + electricity;\n\n    const report: DayReport = {\n      day: this.dayNumber,\n      revenue: Math.round(this.dailyRevenue * 100) / 100,\n      expenses: Math.round(totalExpenses * 100) / 100,\n      rent,\n      electricity,\n      purchaseCost: Math.round(this.dailyPurchaseCost * 100) / 100,\n      netIncome: Math.round(netIncome * 100) / 100,\n      debtPayment,\n      debtRemaining: this.debt,\n    };\n\n    this.dayReports.push(report);\n    this.resetDaily();\n    this.dayNumber++;\n    return report;\n  }\n\n  resetDaily(): void {\n    this.dailyRevenue = 0;\n    this.dailyExpenses = 0;\n    this.dailyPurchaseCost = 0;\n  }\n\n  isGameOver(): { over: boolean; reason: string } {\n    if (this.debt <= 0) return { over: true, reason: 'debt_cleared' };\n    if (this.money < -1000) return { over: true, reason: 'bankrupt' };\n    if (this.dayNumber > DEBT_DAYS) return { over: true, reason: 'time_up' };\n    return { over: false, reason: '' };\n  }\n\n  getMoney(): number {\n    return Math.round(this.money * 100) / 100;\n  }\n\n  getSaveData(): Record<string, unknown> {\n    return {\n      money: this.money,\n      debt: this.debt,\n      purchasedUpgrades: Array.from(this.purchasedUpgrades),\n      dayNumber: this.dayNumber,\n      dailyRevenue: this.dailyRevenue,\n      dailyExpenses: this.dailyExpenses,\n      dayReports: this.dayReports.slice(-30),\n    };\n  }\n\n  loadSaveData(data: Record<string, unknown>): void {\n    this.money = (data.money as number) ?? 500;\n    this.debt = (data.debt as number) ?? DEBT_TOTAL;\n    this.purchasedUpgrades = new Set((data.purchasedUpgrades as string[]) ?? []);\n    this.dayNumber = (data.dayNumber as number) ?? 1;\n    this.dailyRevenue = (data.dailyRevenue as number) ?? 0;\n    this.dailyExpenses = (data.dailyExpenses as number) ?? 0;\n    if (data.dayReports) this.dayReports = data.dayReports as DayReport[];\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"e4781836-91b7-498e-bc35-c2b84a36028a","uuid":"100d9f62-458a-4499-b2b8-622d387aeb6c"}
