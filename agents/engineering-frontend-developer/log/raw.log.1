{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_74ae3f2e41384a02bb28eee7","type":"tool_result","content":"<system-reminder>[Truncated: PARTIAL view — showing lines 1-2315 of 2815 total (25833 tokens, cap 25000). Call Read with offset=2316 limit=2315 for the next page, or Grep to find a specific section. Do NOT answer from this page alone if the answer may be further in the file.]</system-reminder>\n\n1\t<!DOCTYPE html>\n2\t<html lang=\"zh-CN\">\n3\t<head>\n4\t<meta charset=\"UTF-8\">\n5\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n6\t<title>LoopCLI - Agent 控制台 v8.8</title>\n7\t<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css\">\n8\t<style>\n9\t.ti { font-size: 18px; vertical-align: middle; }\n10\t.nav-item .ti { font-size: 20px; }\n11\t.btn .ti { font-size: 16px; }\n12\t*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n13\t:root {\n14\t  /* v8.1 配色 - 深色主题（默认） */\n15\t  --bg: #0a0e17;\n16\t  --surface: #111827;\n17\t  --surface2: #1f2937;\n18\t  --border: #374151;\n19\t  --text: #f3f4f6;\n20\t  --text2: #b0b8c4;\n21\t  --text3: #7c8594;\n22\t\n23\t  /* 品牌色 */\n24\t  --accent: #3b82f6;\n25\t  --accent2: #8b5cf6;\n26\t  --accent3: #10b981;\n27\t  --accent-gradient: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 50%, #10b981 100%);\n28\t}\n29\t\n30\t/* 浅色主题 */\n31\t[data-theme=\"light\"] {\n32\t  --bg: #f8fafc;\n33\t  --surface: #ffffff;\n34\t  --surface2: #e2e8f0;\n35\t  --border: #cbd5e1;\n36\t  --text: #1e293b;\n37\t  --text2: #64748b;\n38\t  --text3: #94a3b8;\n39\t\n40\t  --accent: #2563eb;\n41\t  --accent2: #7c3aed;\n42\t  --accent3: #059669;\n43\t  --accent-gradient: linear-gradient(135deg, #2563eb 0%, #7c3aed 50%, #059669 100%);\n44\t}\n45\t\n46\t/* 赛博朋克主题 */\n47\t[data-theme=\"cyberpunk\"] {\n48\t  --bg: #0d0221;\n49\t  --surface: #1a0533;\n50\t  --surface2: #2d1b4e;\n51\t  --border: #ff00ff;\n52\t  --text: #00ffff;\n53\t  --text2: #ff00ff;\n54\t  --text3: #9d4edd;\n55\t\n56\t  --accent: #00ffff;\n57\t  --accent2: #ff00ff;\n58\t  --accent3: #39ff14;\n59\t  --accent-gradient: linear-gradient(135deg, #00ffff 0%, #ff00ff 50%, #39ff14 100%);\n60\t}\n61\t\n62\t/* 状态色和通用变量 - 必须在 :root 内 */\n63\t:root {\n64\t  --green: #10b981;\n65\t  --green-bg: rgba(16, 185, 129, 0.15);\n66\t  --yellow: #f59e0b;\n67\t  --yellow-bg: rgba(245, 158, 11, 0.15);\n68\t  --red: #ef4444;\n69\t  --red-bg: rgba(239, 68, 68, 0.15);\n70\t  --blue: #3b82f6;\n71\t  --blue-bg: rgba(59, 130, 246, 0.15);\n72\t  --purple: #8b5cf6;\n73\t  --purple-bg: rgba(139, 92, 246, 0.15);\n74\t\n75\t  --radius: 16px;\n76\t  --shadow: 0 10px 40px rgba(0, 0, 0, 0.5);\n77\t  --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.3);\n78\t}\n79\t\n80\thtml { background: var(--bg); }\n81\tbody {\n82\t  font-family: -apple-system, \"Segoe UI\", system-ui, sans-serif;\n83\t  background: var(--bg);\n84\t  color: var(--text);\n85\t  min-height: 100vh;\n86\t  line-height: 1.6;\n87\t  overflow: hidden;\n88\t}\n89\t\n90\t/* 布局 */\n91\t.app { display: flex; height: 100vh; overflow: hidden; }\n92\t.sidebar {\n93\t  width: 260px;\n94\t  background: var(--surface);\n95\t  border-right: 1px solid var(--border);\n96\t  display: flex;\n97\t  flex-direction: column;\n98\t  flex-shrink: 0;\n99\t}\n100\t.main {\n101\t  flex: 1;\n102\t  display: flex;\n103\t  flex-direction: column;\n104\t  overflow: hidden;\n105\t  position: relative;\n106\t  background: var(--bg);\n107\t}\n108\t\n109\t/* 侧边栏 */\n110\t.brand {\n111\t  padding: 24px 20px;\n112\t  border-bottom: 1px solid var(--border);\n113\t  background: var(--accent-gradient);\n114\t}\n115\t.brand h1 {\n116\t  font-size: 22px;\n117\t  font-weight: 800;\n118\t  color: white;\n119\t  text-shadow: 0 2px 10px rgba(0,0,0,0.3);\n120\t  display: flex;\n121\t  align-items: center;\n122\t  gap: 8px;\n123\t}\n124\t\n125\t.nav {\n126\t  flex: 1;\n127\t  padding: 20px 12px;\n128\t  overflow-y: auto;\n129\t}\n130\t.nav-item {\n131\t  display: flex;\n132\t  align-items: center;\n133\t  gap: 14px;\n134\t  padding: 14px 16px;\n135\t  border-radius: var(--radius);\n136\t  cursor: pointer;\n137\t  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);\n138\t  color: var(--text2);\n139\t  font-size: 14px;\n140\t  font-weight: 500;\n141\t  margin-bottom: 4px;\n142\t  position: relative;\n143\t  overflow: hidden;\n144\t}\n145\t.nav-item::before {\n146\t  content: '';\n147\t  position: absolute;\n148\t  inset: 0;\n149\t  background: var(--accent-gradient);\n150\t  opacity: 0;\n151\t  transition: opacity 0.25s;\n152\t}\n153\t.nav-item:hover {\n154\t  background: var(--surface2);\n155\t  color: var(--text);\n156\t  transform: translateX(4px);\n157\t}\n158\t.nav-item.active {\n159\t  background: var(--accent-gradient);\n160\t  color: white;\n161\t  box-shadow: var(--shadow-sm);\n162\t}\n163\t.nav-item.active::before { opacity: 1; }\n164\t.nav-item span {\n165\t  position: relative;\n166\t  z-index: 1;\n167\t}\n168\t\n169\t/* 侧边栏底部按钮 */\n170\t.sidebar-footer {\n171\t  margin-top: auto;\n172\t  padding: 16px;\n173\t  display: flex;\n174\t  gap: 8px;\n175\t  border-top: 1px solid var(--border);\n176\t}\n177\t.theme-toggle, .help-toggle {\n178\t  flex: 1;\n179\t  padding: 12px;\n180\t  background: var(--surface2);\n181\t  border: 1px solid var(--border);\n182\t  border-radius: 8px;\n183\t  cursor: pointer;\n184\t  transition: all 0.3s;\n185\t  font-size: 20px;\n186\t  display: flex;\n187\t  align-items: center;\n188\t  justify-content: center;\n189\t}\n190\t.theme-toggle:hover, .help-toggle:hover {\n191\t  background: var(--accent-gradient);\n192\t  transform: scale(1.05);\n193\t}\n194\t\n195\t/* 搜索框 */\n196\t.search-bar {\n197\t  margin-bottom: 24px;\n198\t  position: relative;\n199\t}\n200\t.search-input {\n201\t  width: 100%;\n202\t  padding: 14px 20px 14px 44px;\n203\t  background: var(--surface);\n204\t  border: 2px solid var(--border);\n205\t  border-radius: 12px;\n206\t  color: var(--text);\n207\t  font-size: 14px;\n208\t  transition: all 0.3s;\n209\t}\n210\t.search-input:focus {\n211\t  outline: none;\n212\t  border-color: var(--accent);\n213\t  box-shadow: 0 0 0 3px var(--blue-bg);\n214\t}\n215\t.search-input::placeholder {\n216\t  color: var(--text3);\n217\t}\n218\t\n219\t/* 自动刷新指示器 */\n220\t.auto-refresh-indicator {\n221\t  position: fixed;\n222\t  bottom: 20px;\n223\t  right: 20px;\n224\t  display: flex;\n225\t  align-items: center;\n226\t  gap: 8px;\n227\t  padding: 8px 16px;\n228\t  background: var(--surface);\n229\t  border: 1px solid var(--border);\n230\t  border-radius: 20px;\n231\t  font-size: 12px;\n232\t  z-index: 1000;\n233\t  opacity: 0.7;\n234\t  transition: opacity 0.3s;\n235\t}\n236\t.auto-refresh-indicator.active {\n237\t  border-color: var(--green);\n238\t  background: var(--green-bg);\n239\t}\n240\t.refresh-icon-ti {\n241\t  animation: spin 1s linear infinite;\n242\t}\n243\t.auto-refresh-indicator:not(.active) .refresh-icon-ti {\n244\t  animation: none;\n245\t}\n246\t\n247\t/* 快捷键帮助面板 */\n248\t.shortcuts-panel {\n249\t  position: fixed;\n250\t  top: 50%;\n251\t  left: 50%;\n252\t  transform: translate(-50%, -50%);\n253\t  background: var(--surface);\n254\t  border: 1px solid var(--border);\n255\t  border-radius: var(--radius);\n256\t  padding: 32px;\n257\t  z-index: 2000;\n258\t  max-width: 400px;\n259\t  width: 90%;\n260\t  box-shadow: var(--shadow);\n261\t  display: none;\n262\t}\n263\t.shortcuts-panel.active { display: block; }\n264\t.shortcuts-panel h3 {\n265\t  margin-bottom: 20px;\n266\t  font-size: 20px;\n267\t}\n268\t.shortcut-item {\n269\t  display: flex;\n270\t  justify-content: space-between;\n271\t  padding: 12px 0;\n272\t  border-bottom: 1px solid var(--border);\n273\t}\n274\t.shortcut-item:last-child {\n275\t  border-bottom: none;\n276\t}\n277\t.shortcut-key {\n278\t  display: inline-block;\n279\t  padding: 4px 10px;\n280\t  background: var(--surface2);\n281\t  border: 1px solid var(--border);\n282\t  border-radius: 6px;\n283\t  font-family: monospace;\n284\t  font-size: 12px;\n285\t  font-weight: 600;\n286\t}\n287\t.panel-overlay {\n288\t  position: fixed;\n289\t  inset: 0;\n290\t  background: rgba(0, 0, 0, 0.5);\n291\t  z-index: 1999;\n292\t  display: none;\n293\t  opacity: 0;\n294\t  transition: opacity 0.3s ease;\n295\t}\n296\t.panel-overlay.active {\n297\t  display: block;\n298\t  opacity: 1;\n299\t}\n300\t\n301\t/* 快捷键面板动画 */\n302\t.shortcuts-panel {\n303\t  transition: all 0.3s ease;\n304\t  transform: translate(-50%, -50%) scale(0.9);\n305\t  opacity: 0;\n306\t}\n307\t.shortcuts-panel.active {\n308\t  transform: translate(-50%, -50%) scale(1);\n309\t  opacity: 1;\n310\t}\n311\t\n312\t/* 通知系统 */\n313\t.notification-container {\n314\t  position: fixed;\n315\t  top: 80px;\n316\t  right: 20px;\n317\t  z-index: 3000;\n318\t  display: flex;\n319\t  flex-direction: column;\n320\t  gap: 12px;\n321\t  pointer-events: none;\n322\t}\n323\t.notification {\n324\t  background: var(--surface);\n325\t  border: 1px solid var(--border);\n326\t  border-radius: 12px;\n327\t  padding: 16px 20px;\n328\t  box-shadow: var(--shadow);\n329\t  display: flex;\n330\t  align-items: center;\n331\t  gap: 12px;\n332\t  min-width: 300px;\n333\t  max-width: 400px;\n334\t  pointer-events: auto;\n335\t  animation: slideIn 0.3s ease, fadeOut 0.3s ease 4.7s forwards;\n336\t  position: relative;\n337\t  overflow: hidden;\n338\t}\n339\t.notification::before {\n340\t  content: '';\n341\t  position: absolute;\n342\t  left: 0;\n343\t  top: 0;\n344\t  bottom: 0;\n345\t  width: 4px;\n346\t}\n347\t.notification.success::before { background: var(--green); }\n348\t.notification.info::before { background: var(--blue); }\n349\t.notification.warning::before { background: var(--yellow); }\n350\t.notification.error::before { background: var(--red); }\n351\t.notification-icon {\n352\t  font-size: 20px;\n353\t}\n354\t.notification-message {\n355\t  flex: 1;\n356\t  font-size: 14px;\n357\t  font-weight: 500;\n358\t}\n359\t.notification-close {\n360\t  cursor: pointer;\n361\t  color: var(--text3);\n362\t  font-size: 18px;\n363\t  line-height: 1;\n364\t  padding: 4px;\n365\t}\n366\t.notification-close:hover { color: var(--text); }\n367\t\n368\t@keyframes slideIn {\n369\t  from {\n370\t    transform: translateX(100%);\n371\t    opacity: 0;\n372\t  }\n373\t  to {\n374\t    transform: translateX(0);\n375\t    opacity: 1;\n376\t  }\n377\t}\n378\t@keyframes fadeOut {\n379\t  from { opacity: 1; }\n380\t  to { opacity: 0; }\n381\t}\n382\t\n383\t/* 主内容 */\n384\t.content {\n385\t  flex: 1;\n386\t  overflow-y: auto;\n387\t  padding: 32px;\n388\t  position: relative;\n389\t}\n390\t\n391\t/* 页面切换动画 */\n392\t.page {\n393\t  display: none;\n394\t  animation: fadeIn 0.3s ease;\n395\t}\n396\t.page.active { display: block; }\n397\t@keyframes fadeIn {\n398\t  from { opacity: 0; transform: translateY(10px); }\n399\t  to { opacity: 1; transform: translateY(0); }\n400\t}\n401\t\n402\t/* 页面标题 */\n403\t.page-header {\n404\t  margin-bottom: 32px;\n405\t}\n406\t.page-header h2 {\n407\t  font-size: 32px;\n408\t  font-weight: 700;\n409\t  background: var(--accent-gradient);\n410\t  -webkit-background-clip: text;\n411\t  -webkit-text-fill-color: transparent;\n412\t  background-clip: text;\n413\t  margin-bottom: 8px;\n414\t}\n415\t.page-header p {\n416\t  color: var(--text2);\n417\t  font-size: 15px;\n418\t}\n419\t\n420\t/* 统计卡片 */\n421\t.stats-grid {\n422\t  display: grid;\n423\t  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n424\t  gap: 20px;\n425\t  margin-bottom: 32px;\n426\t}\n427\t.stat-card {\n428\t  background: var(--surface);\n429\t  border: 1px solid var(--border);\n430\t  border-radius: var(--radius);\n431\t  padding: 24px;\n432\t  position: relative;\n433\t  overflow: hidden;\n434\t  transition: all 0.3s;\n435\t}\n436\t.stat-card::before {\n437\t  content: '';\n438\t  position: absolute;\n439\t  top: 0;\n440\t  left: 0;\n441\t  right: 0;\n442\t  height: 3px;\n443\t  background: var(--accent-gradient);\n444\t  transform: scaleX(0);\n445\t  transition: transform 0.3s;\n446\t}\n447\t.stat-card:hover {\n448\t  transform: translateY(-4px);\n449\t  box-shadow: var(--shadow-sm);\n450\t}\n451\t.stat-card:hover::before { transform: scaleX(1); }\n452\t.stat-card .label {\n453\t  color: var(--text2);\n454\t  font-size: 13px;\n455\t  font-weight: 600;\n456\t  text-transform: uppercase;\n457\t  letter-spacing: 0.5px;\n458\t  margin-bottom: 8px;\n459\t}\n460\t.stat-card .value {\n461\t  font-size: 36px;\n462\t  font-weight: 800;\n463\t  background: var(--accent-gradient);\n464\t  -webkit-background-clip: text;\n465\t  -webkit-text-fill-color: transparent;\n466\t  background-clip: text;\n467\t}\n468\t\n469\t/* Agents 网格 */\n470\t.agents-grid {\n471\t  display: grid;\n472\t  grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));\n473\t  gap: 24px;\n474\t}\n475\t.agent-card {\n476\t  background: var(--surface);\n477\t  border: 1px solid var(--border);\n478\t  border-radius: var(--radius);\n479\t  padding: 24px;\n480\t  transition: all 0.3s;\n481\t  position: relative;\n482\t  overflow: hidden;\n483\t}\n484\t.agent-card::after {\n485\t  content: '';\n486\t  position: absolute;\n487\t  top: 0;\n488\t  left: 0;\n489\t  right: 0;\n490\t  bottom: 0;\n491\t  background: var(--accent-gradient);\n492\t  opacity: 0;\n493\t  transition: opacity 0.3s;\n494\t  pointer-events: none;\n495\t}\n496\t.agent-card:hover {\n497\t  transform: translateY(-4px) scale(1.02);\n498\t  box-shadow: var(--shadow);\n499\t  border-color: var(--accent);\n500\t}\n501\t.agent-card:hover::after { opacity: 0.05; }\n502\t\n503\t.agent-header {\n504\t  display: flex;\n505\t  justify-content: space-between;\n506\t  align-items: flex-start;\n507\t  margin-bottom: 16px;\n508\t}\n509\t.agent-name {\n510\t  font-size: 18px;\n511\t  font-weight: 700;\n512\t  color: var(--text);\n513\t  margin-bottom: 4px;\n514\t}\n515\t.agent-id {\n516\t  font-size: 12px;\n517\t  color: var(--text3);\n518\t  font-family: monospace;\n519\t}\n520\t.status-badge {\n521\t  display: inline-flex;\n522\t  align-items: center;\n523\t  gap: 6px;\n524\t  padding: 6px 12px;\n525\t  border-radius: 20px;\n526\t  font-size: 12px;\n527\t  font-weight: 600;\n528\t  text-transform: uppercase;\n529\t  letter-spacing: 0.5px;\n530\t}\n531\t.status-badge.idle { background: var(--yellow-bg); color: var(--yellow); }\n532\t.status-badge.active { background: var(--green-bg); color: var(--green); }\n533\t.status-badge.disabled { background: var(--red-bg); color: var(--red); }\n534\t.status-dot {\n535\t  width: 8px;\n536\t  height: 8px;\n537\t  border-radius: 50%;\n538\t  background: currentColor;\n539\t  animation: pulse 2s infinite;\n540\t}\n541\t@keyframes pulse {\n542\t  0%, 100% { opacity: 1; }\n543\t  50% { opacity: 0.5; }\n544\t}\n545\t\n546\t.agent-description {\n547\t  color: var(--text2);\n548\t  font-size: 14px;\n549\t  margin-bottom: 20px;\n550\t  line-height: 1.5;\n551\t}\n552\t\n553\t.agent-stats {\n554\t  display: grid;\n555\t  grid-template-columns: 1fr 1fr;\n556\t  gap: 12px;\n557\t  margin-bottom: 20px;\n558\t}\n559\t.agent-stat {\n560\t  display: flex;\n561\t  justify-content: space-between;\n562\t  font-size: 13px;\n563\t}\n564\t.agent-stat .label { color: var(--text3); }\n565\t.agent-stat .value { color: var(--text); font-weight: 600; }\n566\t\n567\t.task-progress {\n568\t  margin-top: 16px;\n569\t}\n570\t.task-progress-bar {\n571\t  height: 8px;\n572\t  background: var(--surface2);\n573\t  border-radius: 4px;\n574\t  overflow: hidden;\n575\t}\n576\t.task-progress-fill {\n577\t  height: 100%;\n578\t  background: var(--accent-gradient);\n579\t  border-radius: 4px;\n580\t  transition: width 0.5s ease;\n581\t  animation: shimmer 2s infinite;\n582\t}\n583\t@keyframes shimmer {\n584\t  0% { background-position: -200% 0; }\n585\t  100% { background-position: 200% 0; }\n586\t}\n587\t\n588\t.agent-actions {\n589\t  display: flex;\n590\t  gap: 8px;\n591\t  margin-top: 16px;\n592\t  justify-content: stretch;\n593\t}\n594\t.agent-actions .btn {\n595\t  flex: 1;\n596\t  text-align: center;\n597\t}\n598\t\n599\t/* 按钮 */\n600\t.btn {\n601\t  flex: 1;\n602\t  padding: 10px 16px;\n603\t  border: none;\n604\t  border-radius: 8px;\n605\t  font-size: 13px;\n606\t  font-weight: 600;\n607\t  cursor: pointer;\n608\t  transition: all 0.2s;\n609\t  display: inline-flex;\n610\t  align-items: center;\n611\t  justify-content: center;\n612\t  gap: 6px;\n613\t}\n614\t.btn-primary {\n615\t  background: var(--accent-gradient);\n616\t  color: white;\n617\t}\n618\t.btn-primary:hover {\n619\t  transform: translateY(-2px);\n620\t  box-shadow: var(--shadow-sm);\n621\t}\n622\t.btn-secondary {\n623\t  background: var(--surface2);\n624\t  color: var(--text);\n625\t  border: 1px solid var(--border);\n626\t}\n627\t.btn-secondary:hover {\n628\t  background: var(--border);\n629\t}\n630\t\n631\t/* 通知系统 */\n632\t#notification-container {\n633\t  position: fixed;\n634\t  top: 24px;\n635\t  right: 24px;\n636\t  z-index: 1000;\n637\t  display: flex;\n638\t  flex-direction: column;\n639\t  gap: 10px;\n640\t  max-height: 40vh;\n641\t  overflow: hidden;\n642\t  max-width: 400px;\n643\t}\n644\t.notification {\n645\t  display: flex;\n646\t  align-items: center;\n647\t  gap: 12px;\n648\t  padding: 16px 20px;\n649\t  background: var(--surface);\n650\t  border: 1px solid var(--border);\n651\t  border-radius: 12px;\n652\t  box-shadow: var(--shadow);\n653\t  min-width: 300px;\n654\t  animation: slideIn 0.3s ease;\n655\t}\n656\t@keyframes slideIn {\n657\t  from { transform: translateX(100%); opacity: 0; }\n658\t  to { transform: translateX(0); opacity: 1; }\n659\t}\n660\t.notification.success { border-color: var(--green); }\n661\t.notification.error { border-color: var(--red); }\n662\t.notification.warning { border-color: var(--yellow); }\n663\t\n664\t/* 加载状态 */\n665\t.loading {\n666\t  display: flex;\n667\t  align-items: center;\n668\t  justify-content: center;\n669\t  gap: 16px;\n670\t  padding: 40px;\n671\t  color: var(--text2);\n672\t}\n673\t.spinner {\n674\t  width: 24px;\n675\t  height: 24px;\n676\t  border: 3px solid var(--border);\n677\t  border-top-color: var(--accent);\n678\t  border-radius: 50%;\n679\t  animation: spin 1s linear infinite;\n680\t}\n681\t@keyframes spin {\n682\t  to { transform: rotate(360deg); }\n683\t}\n684\t\n685\t/* Tasks 表格 */\n686\t.tasks-table {\n687\t  width: 100%;\n688\t  border-collapse: collapse;\n689\t  background: var(--surface);\n690\t  border-radius: var(--radius);\n691\t  overflow: hidden;\n692\t}\n693\t.tasks-table th,\n694\t.tasks-table td {\n695\t  padding: 16px 20px;\n696\t  text-align: left;\n697\t  border-bottom: 1px solid var(--border);\n698\t}\n699\t.tasks-table th {\n700\t  background: var(--surface2);\n701\t  font-weight: 600;\n702\t  font-size: 13px;\n703\t  color: var(--text2);\n704\t  text-transform: uppercase;\n705\t  letter-spacing: 0.5px;\n706\t}\n707\t.tasks-table tr:hover {\n708\t  background: var(--surface2);\n709\t}\n710\t.tasks-table tr:last-child td {\n711\t  border-bottom: none;\n712\t}\n713\t\n714\t/* Logs 区域 */\n715\t.logs-container {\n716\t  background: var(--surface);\n717\t  border: 1px solid var(--border);\n718\t  border-radius: var(--radius);\n719\t  overflow: hidden;\n720\t}\n721\t.logs-header {\n722\t  padding: 16px 20px;\n723\t  background: var(--surface2);\n724\t  border-bottom: 1px solid var(--border);\n725\t  display: flex;\n726\t  justify-content: space-between;\n727\t  align-items: center;\n728\t}\n729\t.logs-content {\n730\t  padding: 20px;\n731\t  font-family: 'Consolas', 'Monaco', monospace;\n732\t  font-size: 13px;\n733\t  line-height: 1.6;\n734\t  max-height: 400px;\n735\t  overflow-y: auto;\n736\t}\n737\t.log-entry {\n738\t  padding: 8px 0;\n739\t  border-bottom: 1px solid var(--border);\n740\t}\n741\t.log-time {\n742\t  color: var(--text3);\n743\t  margin-right: 12px;\n744\t}\n745\t.log-level {\n746\t  display: inline-block;\n747\t  padding: 2px 8px;\n748\t  border-radius: 4px;\n749\t  font-size: 11px;\n750\t  font-weight: 600;\n751\t  margin-right: 8px;\n752\t}\n753\t.log-level.info { background: var(--blue-bg); color: var(--blue); }\n754\t.log-level.warn { background: var(--yellow-bg); color: var(--yellow); }\n755\t.log-level.error { background: var(--red-bg); color: var(--red); }\n756\t\n757\t/* Settings 页面 */\n758\t.settings-section {\n759\t  background: var(--surface);\n760\t  border: 1px solid var(--border);\n761\t  border-radius: var(--radius);\n762\t  padding: 24px;\n763\t  margin-bottom: 20px;\n764\t}\n765\t.settings-section h3 {\n766\t  font-size: 18px;\n767\t  font-weight: 600;\n768\t  margin-bottom: 20px;\n769\t}\n770\t.setting-item {\n771\t  display: flex;\n772\t  justify-content: space-between;\n773\t  align-items: center;\n774\t  padding: 16px 0;\n775\t  border-bottom: 1px solid var(--border);\n776\t}\n777\t.setting-item:last-child {\n778\t  border-bottom: none;\n779\t}\n780\t.setting-label {\n781\t  flex: 1;\n782\t}\n783\t.setting-label .title {\n784\t  font-weight: 600;\n785\t  margin-bottom: 4px;\n786\t}\n787\t.setting-label .description {\n788\t  font-size: 13px;\n789\t  color: var(--text2);\n790\t}\n791\t.setting-control {\n792\t  display: flex;\n793\t  align-items: center;\n794\t  gap: 12px;\n795\t}\n796\t\n797\t/* 开关 */\n798\t.switch {\n799\t  position: relative;\n800\t  width: 50px;\n801\t  height: 26px;\n802\t}\n803\t.switch input {\n804\t  opacity: 0;\n805\t  width: 0;\n806\t  height: 0;\n807\t}\n808\t.switch-slider {\n809\t  position: absolute;\n810\t  cursor: pointer;\n811\t  inset: 0;\n812\t  background: var(--surface2);\n813\t  border: 1px solid var(--border);\n814\t  border-radius: 26px;\n815\t  transition: all 0.3s;\n816\t}\n817\t.switch-slider::before {\n818\t  position: absolute;\n819\t  content: \"\";\n820\t  height: 20px;\n821\t  width: 20px;\n822\t  left: 2px;\n823\t  bottom: 2px;\n824\t  background: white;\n825\t  border-radius: 50%;\n826\t  transition: all 0.3s;\n827\t}\n828\t.switch input:checked + .switch-slider {\n829\t  background: var(--accent);\n830\t  border-color: var(--accent);\n831\t}\n832\t.switch input:checked + .switch-slider::before {\n833\t  transform: translateX(24px);\n834\t}\n835\t\n836\t/* Performance 页面 */\n837\t.performance-grid {\n838\t  display: grid;\n839\t  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n840\t  gap: 24px;\n841\t  margin-bottom: 32px;\n842\t}\n843\t.performance-card {\n844\t  background: var(--surface);\n845\t  border: 1px solid var(--border);\n846\t  border-radius: var(--radius);\n847\t  padding: 24px;\n848\t}\n849\t.performance-card h4 {\n850\t  font-size: 16px;\n851\t  font-weight: 600;\n852\t  margin-bottom: 16px;\n853\t  color: var(--text2);\n854\t}\n855\t.metric-value {\n856\t  font-size: 48px;\n857\t  font-weight: 800;\n858\t  background: var(--accent-gradient);\n859\t  -webkit-background-clip: text;\n860\t  -webkit-text-fill-color: transparent;\n861\t  background-clip: text;\n862\t  line-height: 1;\n863\t  margin-bottom: 8px;\n864\t}\n865\t.metric-change {\n866\t  font-size: 14px;\n867\t  font-weight: 600;\n868\t}\n869\t.metric-change.positive { color: var(--green); }\n870\t.metric-change.negative { color: var(--red); }\n871\t\n872\t/* 圆环图自适应 */\n873\t.donut-chart-wrapper { flex-wrap: wrap; }\n874\t.donut-chart-wrapper svg { max-width: 220px; }\n875\t.donut-legend { flex: 1; min-width: 130px; }\n876\t@media (max-width: 480px) {\n877\t  .donut-chart-wrapper { flex-direction: column; gap: 16px !important; }\n878\t  .donut-chart-wrapper svg { max-width: 160px; }\n879\t  .donut-legend { min-width: 100%; }\n880\t}\n881\t\n882\t/* 响应式 */\n883\t@media (max-width: 1024px) {\n884\t  .sidebar { width: 220px; }\n885\t  .agents-grid { grid-template-columns: 1fr; }\n886\t}\n887\t@media (max-width: 768px) {\n888\t  .app { flex-direction: column; }\n889\t  .sidebar {\n890\t    width: 100%;\n891\t    height: auto;\n892\t    flex-direction: row;\n893\t    overflow-x: auto;\n894\t  }\n895\t  .brand { padding: 12px 16px; }\n896\t  .brand h1 { font-size: 16px; }\n897\t  .nav {\n898\t    display: flex;\n899\t    padding: 8px;\n900\t    overflow-x: auto;\n901\t    flex-shrink: 0;\n902\t  }\n903\t  .nav-item {\n904\t    flex-shrink: 0;\n905\t    margin-bottom: 0;\n906\t    margin-right: 8px;\n907\t    min-height: 44px;\n908\t    min-width: 44px;\n909\t  }\n910\t  button, .btn {\n911\t    min-height: 44px;\n912\t    min-width: 44px;\n913\t    padding: 12px 16px;\n914\t  }\n915\t  .content { padding: 20px; }\n916\t  .stats-grid { grid-template-columns: 1fr 1fr; }\n917\t  .agent-stats { grid-template-columns: 1fr; }\n918\t\n919\t  /* 触摸优化 */\n920\t  button:active, .btn:active {\n921\t    transform: scale(0.97);\n922\t    transition: transform 0.1s;\n923\t  }\n924\t  .nav-item:active {\n925\t    transform: scale(0.95);\n926\t  }\n927\t\n928\t  /* 更大的点击区域 */\n929\t  .stat-card {\n930\t    min-height: 100px;\n931\t  }\n932\t  .agent-card {\n933\t    min-height: 120px;\n934\t  }\n935\t\n936\t  /* 通知优化 */\n937\t  .notification {\n938\t    min-width: 260px;\n939\t    max-width: calc(100vw - 40px);\n940\t  }\n941\t\n942\t  /* 自动刷新指示器移动端 */\n943\t  .auto-refresh-indicator {\n944\t    bottom: 12px;\n945\t    right: 12px;\n946\t    font-size: 11px;\n947\t    padding: 6px 12px;\n948\t  }\n949\t\n950\t  /* 模态框优化 */\n951\t  .modal-content {\n952\t    width: 95vw;\n953\t    max-width: none;\n954\t    padding: 24px;\n955\t  }\n956\t}\n957\t\n958\t/* 触摸设备优化 */\n959\t@media (hover: none) and (pointer: coarse) {\n960\t  /* 移除hover效果，提高性能 */\n961\t  * {\n962\t    -webkit-tap-highlight-color: rgba(59, 130, 246, 0.3);\n963\t  }\n964\t\n965\t  button:hover, .btn:hover, .nav-item:hover {\n966\t    background: var(--surface2);\n967\t  }\n968\t\n969\t  /* 禁用过渡动画，提高响应速度 */\n970\t  .fast-mode * {\n971\t    transition: none !important;\n972\t    animation: none !important;\n973\t  }\n974\t}\n975\t\n976\t/* 小屏幕手机优化 */\n977\t@media (max-width: 375px) {\n978\t  .sidebar { padding: 8px; }\n979\t  .brand { font-size: 14px; padding: 12px; }\n980\t  .nav-item { padding: 10px 14px; font-size: 13px; }\n981\t  .content { padding: 16px; }\n982\t  .stats-grid { grid-template-columns: 1fr; }\n983\t  button, .btn { font-size: 14px; }\n984\t}\n985\t</style>\n986\t</head>\n987\t<body>\n988\t\n989\t<!-- 通知容器 -->\n990\t<div class=\"notification-container\" id=\"notification-container\"></div>\n991\t\n992\t<!-- 自动刷新指示器 -->\n993\t<div class=\"auto-refresh-indicator\" id=\"auto-refresh-indicator\">\n994\t  <i class=\"ti ti-refresh refresh-icon-ti\"></i>\n995\t  <span id=\"refresh-status\">自动刷新: 10s</span>\n996\t</div>\n997\t\n998\t<!-- 快捷键面板遮罩 -->\n999\t<div class=\"panel-overlay\" id=\"shortcuts-overlay\"></div>\n1000\t\n1001\t<!-- 快捷键面板 -->\n1002\t<div class=\"shortcuts-panel\" id=\"shortcuts-panel\">\n1003\t  <h3><i class=\"ti ti-keyboard\"></i> 键盘快捷键</h3>\n1004\t  <div class=\"shortcut-item\">\n1005\t    <span class=\"shortcut-key\">1-5</span>\n1006\t    <span>切换页面</span>\n1007\t  </div>\n1008\t  <div class=\"shortcut-item\">\n1009\t    <span class=\"shortcut-key\">R</span>\n1010\t    <span>刷新当前页</span>\n1011\t  </div>\n1012\t  <div class=\"shortcut-item\">\n1013\t    <span class=\"shortcut-key\">H</span>\n1014\t    <span>显示/隐藏帮助</span>\n1015\t  </div>\n1016\t  <div class=\"shortcut-item\">\n1017\t    <span class=\"shortcut-key\">ESC</span>\n1018\t    <span>关闭面板</span>\n1019\t  </div>\n1020\t  <div style=\"margin-top: 20px; text-align: center;\">\n1021\t    <button class=\"btn btn-primary\" onclick=\"closeShortcutsPanel()\"><i class=\"ti ti-x\"></i> 关闭</button>\n1022\t  </div>\n1023\t</div>\n1024\t\n1025\t<div class=\"app\">\n1026\t  <!-- 侧边栏 -->\n1027\t  <aside class=\"sidebar\">\n1028\t    <div class=\"brand\">\n1029\t      <h1>∞ LoopCLI</h1>\n1030\t    </div>\n1031\t    <nav class=\"nav\">\n1032\t      <div class=\"nav-item active\" data-page=\"dashboard\">\n1033\t        <i class=\"ti ti-dashboard\"></i>\n1034\t        <span>主页</span>\n1035\t      </div>\n1036\t      <div class=\"nav-item\" data-page=\"agents\">\n1037\t        <i class=\"ti ti-robot\"></i>\n1038\t        <span>Agents</span>\n1039\t      </div>\n1040\t      <div class=\"nav-item\" data-page=\"tasks\">\n1041\t        <i class=\"ti ti-list-check\"></i>\n1042\t        <span>任务</span>\n1043\t      </div>\n1044\t      <div class=\"nav-item\" data-page=\"performance\">\n1045\t        <i class=\"ti ti-chart-bar\"></i>\n1046\t        <span>性能</span>\n1047\t      </div>\n1048\t      <div class=\"nav-item\" data-page=\"logs\">\n1049\t        <i class=\"ti ti-file-text\"></i>\n1050\t        <span>日志</span>\n1051\t      </div>\n1052\t      <div class=\"nav-item\" data-page=\"screenshots\">\n1053\t        <i class=\"ti ti-camera\"></i>\n1054\t        <span>截图</span>\n1055\t      </div>\n1056\t      <div class=\"nav-item\" data-page=\"settings\">\n1057\t        <i class=\"ti ti-settings\"></i>\n1058\t        <span>设置</span>\n1059\t      </div>\n1060\t    </nav>\n1061\t    <div class=\"sidebar-footer\">\n1062\t      <button class=\"theme-toggle\" id=\"theme-toggle\" title=\"切换主题\">\n1063\t        <i id=\"theme-icon\" class=\"ti ti-moon\"></i>\n1064\t      </button>\n1065\t      <button class=\"help-toggle\" id=\"help-toggle\" title=\"快捷键帮助\">\n1066\t        <i class=\"ti ti-help-circle\"></i>\n1067\t      </button>\n1068\t    </div>\n1069\t  </aside>\n1070\t\n1071\t  <!-- 主内容 -->\n1072\t  <main class=\"main\">\n1073\t    <div class=\"content\">\n1074\t      <!-- 主页 Dashboard -->\n1075\t      <div class=\"page active\" id=\"page-dashboard\">\n1076\t        <div class=\"page-header\">\n1077\t          <h2>系统概览</h2>\n1078\t          <p>LoopCLI 运行状态与关键指标</p>\n1079\t        </div>\n1080\t\n1081\t        <div class=\"stats-grid\">\n1082\t          <div class=\"stat-card\">\n1083\t            <div class=\"label\">总 Agents</div>\n1084\t            <div class=\"value\" id=\"total-agents\">-</div>\n1085\t          </div>\n1086\t          <div class=\"stat-card\">\n1087\t            <div class=\"label\">运行中</div>\n1088\t            <div class=\"value\" id=\"active-agents\">-</div>\n1089\t          </div>\n1090\t          <div class=\"stat-card\">\n1091\t            <div class=\"label\">总任务数</div>\n1092\t            <div class=\"value\" id=\"total-tasks\">-</div>\n1093\t          </div>\n1094\t          <div class=\"stat-card\">\n1095\t            <div class=\"label\">已完成</div>\n1096\t            <div class=\"value\" id=\"done-tasks\">-</div>\n1097\t          </div>\n1098\t        </div>\n1099\t\n1100\t        <!-- 长期任务卡片 -->\n1101\t        <div id=\"longtask-card\" style=\"background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(139, 92, 246, 0.1) 50%, rgba(16, 185, 129, 0.1) 100%); border: 2px solid var(--accent); border-radius: var(--radius); padding: 24px; margin-bottom: 32px; position: relative; overflow: hidden;\">\n1102\t          <div style=\"position: absolute; top: -50%; right: -50%; width: 200%; height: 200%; background: radial-gradient(circle, rgba(255,255,255,0.03) 0%, transparent 70%); pointer-events: none;\"></div>\n1103\t          <div style=\"display: flex; justify-content: space-between; align-items: flex-start; position: relative; z-index: 1;\">\n1104\t            <div style=\"flex: 1;\">\n1105\t              <div style=\"display: flex; align-items: center; gap: 12px; margin-bottom: 12px;\">\n1106\t                <span style=\"font-size: 24px;\"><i class=\"ti ti-target\"></i></span>\n1107\t                <h3 style=\"font-size: 20px; font-weight: 700; background: var(--accent-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;\">长期任务</h3>\n1108\t                <span id=\"longtask-badge\" style=\"display: none; background: var(--accent); color: white; font-size: 11px; padding: 2px 8px; border-radius: 10px; font-weight: 600;\">进行中</span>\n1109\t              </div>\n1110\t              <div id=\"longtask-display\" style=\"color: var(--text); line-height: 1.7; min-width: 0; overflow-wrap: break-word;\">\n1111\t                <div id=\"longtask-status-main\" style=\"font-size: 14px; color: var(--text2);\">加载中...</div>\n1112\t                <div id=\"longtask-content-main\" style=\"display: none; margin-top: 12px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 16px; font-family: monospace; font-size: 13px; white-space: pre-wrap; word-break: break-word; color: var(--text2); max-height: 300px; overflow-y: auto;\"></div>\n1113\t                <div id=\"longtask-edit-main\" style=\"display: none; margin-top: 12px;\">\n1114\t                  <textarea id=\"longtask-editor-main\" style=\"width: 100%; min-height: 120px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 12px; font-family: monospace; font-size: 13px; color: var(--text); resize: vertical;\" placeholder=\"输入长期任务内容...\"></textarea>\n1115\t                  <div style=\"display: flex; gap: 8px; margin-top: 8px;\">\n1116\t                    <button class=\"btn btn-primary\" onclick=\"saveLongTaskMain()\"><i class=\"ti ti-device-floppy\"></i> 保存</button>\n1117\t                    <button class=\"btn btn-secondary\" onclick=\"cancelEditLongTaskMain()\">取消</button>\n1118\t                  </div>\n1119\t                </div>\n1120\t              </div>\n1121\t            </div>\n1122\t            <div style=\"display: flex; gap: 8px;\">\n1123\t              <button class=\"btn btn-primary\" id=\"edit-longtask-btn-main\" onclick=\"startEditLongTaskMain()\" style=\"display: none;\"><i class=\"ti ti-pencil\"></i> 编辑</button>\n1124\t              <button class=\"btn btn-secondary\" id=\"cancel-longtask-btn-main\" onclick=\"cancelLongTaskMain()\" style=\"display: none;\"><i class=\"ti ti-x\"></i> 取消</button>\n1125\t            </div>\n1126\t          </div>\n1127\t        </div>\n1128\t\n1129\t        <!-- 用量统计面板 -->\n1130\t        <div id=\"usage-panel\" style=\"background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 28px; margin-bottom: 32px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);\">\n1131\t          <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;\">\n1132\t            <h3 style=\"font-size: 15px; font-weight: 700; color: var(--text2); display:flex; align-items:center; gap:8px;\"><span style=\"display:inline-block;width:4px;height:18px;background:linear-gradient(180deg,#f59e0b,#fbbf24);border-radius:2px;\"></span>用量统计</h3>\n1133\t            <span id=\"usage-refresh-time\" style=\"font-size: 12px; color: var(--text3);\">每5分钟刷新</span>\n1134\t          </div>\n1135\t          <div id=\"usage-content\" style=\"color: var(--text2); font-size: 14px;\">加载中...</div>\n1136\t        </div>\n1137\t\n1138\t        <!-- 可视化图表区域 -->\n1139\t        <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-bottom: 32px;\">\n1140\t          <div style=\"background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 28px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);\">\n1141\t            <h3 style=\"font-size: 15px; font-weight: 700; margin-bottom: 20px; color: var(--text2); display:flex; align-items:center; gap:8px;\"><span style=\"display:inline-block;width:4px;height:18px;background:linear-gradient(180deg,#6366f1,#8b5cf6);border-radius:2px;\"></span>Agent 状态分布</h3>\n1142\t            <div id=\"agent-status-chart\" style=\"display:flex;align-items:center;justify-content:center;min-height:200px;width:100%;\"></div>\n1143\t          </div>\n1144\t          <div style=\"background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 28px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);\">\n1145\t            <h3 style=\"font-size: 15px; font-weight: 700; margin-bottom: 20px; color: var(--text2); display:flex; align-items:center; gap:8px;\"><span style=\"display:inline-block;width:4px;height:18px;background:linear-gradient(180deg,#10b981,#34d399);border-radius:2px;\"></span>任务完成进度</h3>\n1146\t            <div id=\"task-progress-chart\" style=\"min-height:200px;\"></div>\n1147\t          </div>\n1148\t        </div>\n1149\t      </div>\n1150\t\n1151\t      <!-- Agents 页面 -->\n1152\t      <div class=\"page\" id=\"page-agents\">\n1153\t        <div class=\"page-header\">\n1154\t          <h2>Agent 控制台</h2>\n1155\t          <p>管理和监控所有 Agent</p>\n1156\t        </div>\n1157\t\n1158\t        <div class=\"action-bar\" style=\"display: flex; gap: 12px; margin-bottom: 20px;\">\n1159\t          <button class=\"btn btn-primary\" id=\"create-agent-btn\" onclick=\"showCreateAgentModal()\" style=\"display: flex; align-items: center; gap: 8px;\">\n1160\t            <i class=\"ti ti-plus\"></i>\n1161\t            <span>创建 Agent</span>\n1162\t          </button>\n1163\t          <button class=\"btn btn-secondary\" id=\"refresh-btn\" onclick=\"refreshAgents()\" style=\"display: flex; align-items: center; gap: 8px;\">\n1164\t            <i class=\"ti ti-refresh\"></i>\n1165\t            <span>刷新</span>\n1166\t          </button>\n1167\t        </div>\n1168\t\n1169\t        <div class=\"search-bar\" style=\"display: flex; gap: 12px; align-items: center; position: relative;\">\n1170\t          <i class=\"ti ti-search\" style=\"position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text2); z-index: 1;\"></i>\n1171\t          <input type=\"text\" class=\"search-input\" id=\"agent-search\" placeholder=\"搜索 Agent (按名称、ID 或状态)...\" style=\"flex: 1; min-width: 0;\">\n1172\t          <button class=\"btn btn-secondary\" id=\"export-btn\" onclick=\"exportAgentsData()\" style=\"flex-shrink: 0; white-space: nowrap;\">\n1173\t            <i class=\"ti ti-download\"></i> 导出\n1174\t          </button>\n1175\t        </div>\n1176\t\n1177\t        <div class=\"agents-grid\" id=\"agents-grid\">\n1178\t          <div class=\"loading\">\n1179\t            <div class=\"spinner\"></div>\n1180\t            <div>加载 Agents...</div>\n1181\t          </div>\n1182\t        </div>\n1183\t      </div>\n1184\t\n1185\t      <!-- Tasks 页面 -->\n1186\t      <div class=\"page\" id=\"page-tasks\">\n1187\t        <div class=\"page-header\">\n1188\t          <h2>任务管理</h2>\n1189\t          <p>查看和管理所有任务</p>\n1190\t        </div>\n1191\t\n1192\t        <div class=\"tasks-table-container\">\n1193\t          <table class=\"tasks-table\">\n1194\t            <thead>\n1195\t              <tr>\n1196\t                <th>ID</th>\n1197\t                <th>标题</th>\n1198\t                <th>状态</th>\n1199\t                <th>Agent</th>\n1200\t                <th>创建时间</th>\n1201\t              </tr>\n1202\t            </thead>\n1203\t            <tbody id=\"tasks-table-body\">\n1204\t              <tr>\n1205\t                <td colspan=\"5\" style=\"text-align: center; color: var(--text2);\">加载中...</td>\n1206\t              </tr>\n1207\t            </tbody>\n1208\t          </table>\n1209\t        </div>\n1210\t      </div>\n1211\t\n1212\t      <!-- Performance 页面 -->\n1213\t      <div class=\"page\" id=\"page-performance\">\n1214\t        <div class=\"page-header\">\n1215\t          <h2>性能监控</h2>\n1216\t          <p>系统性能指标和趋势分析</p>\n1217\t        </div>\n1218\t\n1219\t        <div class=\"performance-grid\">\n1220\t          <div class=\"performance-card\">\n1221\t            <h4>CPU 使用率</h4>\n1222\t            <div class=\"metric-value\" id=\"cpu-usage\">-%</div>\n1223\t            <div class=\"metric-change\" id=\"cpu-change\">-</div>\n1224\t          </div>\n1225\t          <div class=\"performance-card\">\n1226\t            <h4>内存使用</h4>\n1227\t            <div class=\"metric-value\" id=\"memory-usage\">- MB</div>\n1228\t            <div class=\"metric-change\" id=\"mem-change\">-</div>\n1229\t          </div>\n1230\t          <div class=\"performance-card\">\n1231\t            <h4>响应时间</h4>\n1232\t            <div class=\"metric-value\" id=\"response-time\">- ms</div>\n1233\t            <div class=\"metric-change\" id=\"resp-change\">-</div>\n1234\t          </div>\n1235\t          <div class=\"performance-card\">\n1236\t            <h4>Token 消耗</h4>\n1237\t            <div class=\"metric-value\" id=\"token-usage\">-</div>\n1238\t            <div class=\"metric-change\" id=\"token-change\">本月累计</div>\n1239\t          </div>\n1240\t        </div>\n1241\t\n1242\t        <!-- Token 趋势图 -->\n1243\t        <div style=\"background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; margin-bottom: 32px;\">\n1244\t          <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;\">\n1245\t            <h3 style=\"font-size: 16px; font-weight: 600; color: var(--text2);\">Token 消耗趋势（最近7天）</h3>\n1246\t            <span id=\"token-trend-summary\" style=\"font-size: 13px; color: var(--text2);\"></span>\n1247\t          </div>\n1248\t          <canvas id=\"token-trend-chart\" width=\"800\" height=\"250\"></canvas>\n1249\t        </div>\n1250\t\n1251\t        <div class=\"settings-section\">\n1252\t          <h3>性能建议</h3>\n1253\t          <div id=\"performance-suggestions\">\n1254\t            <div class=\"setting-item\">\n1255\t              <div class=\"setting-label\">\n1256\t                <div class=\"title\">启用 Agent 缓存</div>\n1257\t                <div class=\"description\">缓存频繁访问的 Agent 数据，减少 API 调用</div>\n1258\t              </div>\n1259\t              <label class=\"switch\">\n1260\t                <input type=\"checkbox\" checked>\n1261\t                <span class=\"switch-slider\"></span>\n1262\t              </label>\n1263\t            </div>\n1264\t            <div class=\"setting-item\">\n1265\t              <div class=\"setting-label\">\n1266\t                <div class=\"title\">自动优化</div>\n1267\t                <div class=\"description\">自动清理空闲资源和优化配置</div>\n1268\t              </div>\n1269\t              <label class=\"switch\">\n1270\t                <input type=\"checkbox\">\n1271\t                <span class=\"switch-slider\"></span>\n1272\t              </label>\n1273\t            </div>\n1274\t          </div>\n1275\t        </div>\n1276\t      </div>\n1277\t\n1278\t      <!-- Logs 页面 -->\n1279\t      <div class=\"page\" id=\"page-logs\">\n1280\t        <div class=\"page-header\">\n1281\t          <h2>系统日志</h2>\n1282\t          <p>实时查看系统运行日志</p>\n1283\t        </div>\n1284\t\n1285\t        <div class=\"logs-container\">\n1286\t          <div class=\"logs-header\">\n1287\t            <span>最新日志</span>\n1288\t            <button class=\"btn btn-secondary\" onclick=\"clearLogs()\"><i class=\"ti ti-trash\"></i> 清空</button>\n1289\t          </div>\n1290\t          <div class=\"logs-content\" id=\"logs-content\">\n1291\t            <div class=\"loading\">\n1292\t              <div class=\"spinner\"></div>\n1293\t              <div>加载日志...</div>\n1294\t            </div>\n1295\t          </div>\n1296\t        </div>\n1297\t      </div>\n1298\t\n1299\t      <!-- Screenshots 页面 -->\n1300\t      <div class=\"page\" id=\"page-screenshots\">\n1301\t        <div class=\"page-header\">\n1302\t          <h2>测试截图</h2>\n1303\t          <p>Playwright 测试截图预览</p>\n1304\t        </div>\n1305\t\n1306\t        <div class=\"card\">\n1307\t          <div class=\"card-header\">\n1308\t            <h3>最新截图</h3>\n1309\t            <button class=\"btn btn-secondary\" onclick=\"loadScreenshots()\" style=\"margin-left: auto;\"><i class=\"ti ti-refresh\"></i> 刷新</button>\n1310\t          </div>\n1311\t          <div class=\"card-body\">\n1312\t            <div id=\"screenshots-grid\" style=\"display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px;\">\n1313\t              <div style=\"grid-column: 1/-1; text-align: center; color: var(--text2); padding: 40px;\">\n1314\t            加载中...\n1315\t              </div>\n1316\t            </div>\n1317\t          </div>\n1318\t        </div>\n1319\t      </div>\n1320\t\n1321\t      <!-- Settings 页面 -->\n1322\t      <div class=\"page\" id=\"page-settings\">\n1323\t        <div class=\"page-header\">\n1324\t          <h2>系统设置</h2>\n1325\t          <p>配置系统参数和偏好</p>\n1326\t        </div>\n1327\t\n1328\t        <div class=\"settings-section\">\n1329\t          <h3>主题设置</h3>\n1330\t          <div class=\"setting-item\">\n1331\t            <div class=\"setting-label\">\n1332\t              <div class=\"title\">颜色主题</div>\n1333\t              <div class=\"description\">选择界面主题风格</div>\n1334\t            </div>\n1335\t            <div class=\"setting-control\">\n1336\t              <select id=\"theme-selector\" style=\"padding: 8px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface2); color: var(--text); font-size: 13px;\">\n1337\t                <option value=\"dark\">深色主题</option>\n1338\t                <option value=\"light\">浅色主题</option>\n1339\t                <option value=\"cyberpunk\">赛博朋克</option>\n1340\t              </select>\n1341\t            </div>\n1342\t          </div>\n1343\t        </div>\n1344\t\n1345\t        <div class=\"settings-section\">\n1346\t          <h3>界面设置</h3>\n1347\t          <div class=\"setting-item\">\n1348\t            <div class=\"setting-label\">\n1349\t              <div class=\"title\">自动刷新</div>\n1350\t              <div class=\"description\">自动刷新数据间隔（秒）</div>\n1351\t            </div>\n1352\t            <div class=\"setting-control\">\n1353\t              <input type=\"number\" id=\"refresh-interval\" value=\"10\" min=\"1\" max=\"60\"\n1354\t                     style=\"width: 80px; padding: 8px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface2); color: var(--text);\">\n1355\t            </div>\n1356\t          </div>\n1357\t          <div class=\"setting-item\">\n1358\t            <div class=\"setting-label\">\n1359\t              <div class=\"title\">紧凑模式</div>\n1360\t              <div class=\"description\">减少间距，显示更多内容</div>\n1361\t            </div>\n1362\t            <label class=\"switch\">\n1363\t              <input type=\"checkbox\" id=\"compact-mode\">\n1364\t              <span class=\"switch-slider\"></span>\n1365\t            </label>\n1366\t          </div>\n1367\t        </div>\n1368\t\n1369\t        <div class=\"settings-section\">\n1370\t          <h3>通知设置</h3>\n1371\t          <div class=\"setting-item\">\n1372\t            <div class=\"setting-label\">\n1373\t              <div class=\"title\">启用通知</div>\n1374\t              <div class=\"description\">显示系统通知和警告</div>\n1375\t            </div>\n1376\t            <label class=\"switch\">\n1377\t              <input type=\"checkbox\" id=\"enable-notifications\" checked>\n1378\t              <span class=\"switch-slider\"></span>\n1379\t            </label>\n1380\t          </div>\n1381\t          <div class=\"setting-item\">\n1382\t            <div class=\"setting-label\">\n1383\t              <div class=\"title\">声音提醒</div>\n1384\t              <div class=\"description\">重要事件时播放提示音</div>\n1385\t            </div>\n1386\t            <label class=\"switch\">\n1387\t              <input type=\"checkbox\" id=\"sound-notifications\">\n1388\t              <span class=\"switch-slider\"></span>\n1389\t            </label>\n1390\t          </div>\n1391\t        </div>\n1392\t\n1393\t        <div class=\"settings-section\">\n1394\t          <h3>系统信息</h3>\n1395\t          <div class=\"setting-item\">\n1396\t            <div class=\"setting-label\">\n1397\t              <div class=\"title\">WebUI 版本</div>\n1398\t              <div class=\"description\">v8.6 - 深度优化：搜索栏修复、响应式改进、通知位置优化、结构修复</div>\n1399\t            </div>\n1400\t          </div>\n1401\t          <div class=\"setting-item\">\n1402\t            <div class=\"setting-label\">\n1403\t              <div class=\"title\">服务器状态</div>\n1404\t              <div class=\"description\" id=\"server-status\">检测中...</div>\n1405\t            </div>\n1406\t          </div>\n1407\t          <div class=\"setting-item\">\n1408\t            <div class=\"setting-label\">\n1409\t              <div class=\"title\">服务器运行时间</div>\n1410\t              <div class=\"description\" id=\"server-uptime\">-</div>\n1411\t            </div>\n1412\t          </div>\n1413\t          <div class=\"setting-item\">\n1414\t            <div class=\"setting-label\">\n1415\t              <div class=\"title\">Agent 统计</div>\n1416\t              <div class=\"description\" id=\"agent-stats\">-</div>\n1417\t            </div>\n1418\t          </div>\n1419\t          <div class=\"setting-item\" id=\"sys-resource-item\" style=\"display:none\">\n1420\t            <div class=\"setting-label\">\n1421\t              <div class=\"title\">系统资源</div>\n1422\t              <div class=\"description\" id=\"sys-resource\">-</div>\n1423\t            </div>\n1424\t          </div>\n1425\t        </div>\n1426\t\n1427\t        <div class=\"settings-section\">\n1428\t          <h3>长期任务</h3>\n1429\t          <div class=\"setting-item\">\n1430\t            <div class=\"setting-label\">\n1431\t              <div class=\"title\">当前长期任务</div>\n1432\t              <div class=\"description\" id=\"longtask-status\">加载中...</div>\n1433\t            </div>\n1434\t            <div class=\"setting-control\">\n1435\t              <button class=\"btn btn-secondary\" id=\"edit-longtask-btn\" onclick=\"startEditLongTask()\" style=\"display: none;\">\n1436\t                <i class=\"ti ti-pencil\"></i> 编辑\n1437\t              </button>\n1438\t              <button class=\"btn btn-secondary\" id=\"cancel-longtask-btn\" onclick=\"cancelLongTask()\" style=\"display: none;\">\n1439\t                <i class=\"ti ti-x\"></i> 取消任务\n1440\t              </button>\n1441\t            </div>\n1442\t          </div>\n1443\t          <div id=\"longtask-content\" style=\"display: none; margin-top: 16px;\">\n1444\t            <div style=\"background: var(--surface2); border: 1px solid var(--border); border-radius: 8px; padding: 16px; font-family: monospace; font-size: 13px; white-space: pre-wrap; color: var(--text2); max-height: 200px; overflow-y: auto;\" id=\"longtask-text\"></div>\n1445\t          </div>\n1446\t          <div id=\"longtask-edit\" style=\"display: none; margin-top: 16px;\">\n1447\t            <textarea id=\"longtask-editor\" style=\"width: 100%; min-height: 120px; background: var(--surface2); border: 1px solid var(--border); border-radius: 8px; padding: 12px; font-family: monospace; font-size: 13px; color: var(--text); resize: vertical;\" placeholder=\"输入长期任务内容...\"></textarea>\n1448\t            <div style=\"display: flex; gap: 8px; margin-top: 8px;\">\n1449\t              <button class=\"btn btn-primary\" onclick=\"saveLongTask()\"><i class=\"ti ti-device-floppy\"></i> 保存</button>\n1450\t              <button class=\"btn btn-secondary\" onclick=\"cancelEditLongTask()\">取消</button>\n1451\t            </div>\n1452\t          </div>\n1453\t        </div>\n1454\t      </div>\n1455\t    </div>\n1456\t  </main>\n1457\t</div>\n1458\t\n1459\t<script>\n1460\t// API 基础 URL\n1461\tconst API_BASE = '/api';\n1462\t\n1463\t// 通知系统\n1464\tfunction showNotification(message, type = 'info', duration = 5000) {\n1465\t  const container = document.getElementById('notification-container');\n1466\t  if (!container) return;\n1467\t\n1468\t  const icons = {\n1469\t    success: '<i class=\"ti ti-check\" style=\"font-size:18px\"></i>',\n1470\t    info: '<i class=\"ti ti-info-circle\" style=\"font-size:18px\"></i>',\n1471\t    warning: '<i class=\"ti ti-alert-triangle\" style=\"font-size:18px\"></i>',\n1472\t    error: '<i class=\"ti ti-x\" style=\"font-size:18px\"></i>'\n1473\t  };\n1474\t\n1475\t  const notification = document.createElement('div');\n1476\t  notification.className = `notification ${type}`;\n1477\t  notification.innerHTML = `\n1478\t    <span class=\"notification-icon\">${icons[type] || icons.info}</span>\n1479\t    <span class=\"notification-message\">${message}</span>\n1480\t    <span class=\"notification-close\" onclick=\"this.parentElement.remove()\"><i class=\"ti ti-x\" style=\"font-size:14px\"></i></span>\n1481\t  `;\n1482\t\n1483\t  container.appendChild(notification);\n1484\t\n1485\t  // 最多显示3条通知\n1486\t  while (container.children.length > 3) {\n1487\t    container.firstChild.remove();\n1488\t  }\n1489\t\n1490\t  setTimeout(() => {\n1491\t    if (notification.parentElement) {\n1492\t      notification.remove();\n1493\t    }\n1494\t  }, duration);\n1495\t}\n1496\t\n1497\t// 主题管理\n1498\tconst themes = ['dark', 'light', 'cyberpunk'];\n1499\tlet currentThemeIndex = 0;\n1500\t\n1501\tfunction initTheme() {\n1502\t  const savedTheme = localStorage.getItem('webui_theme') || 'dark';\n1503\t  currentThemeIndex = themes.indexOf(savedTheme);\n1504\t  if (currentThemeIndex === -1) currentThemeIndex = 0;\n1505\t  applyTheme(themes[currentThemeIndex]);\n1506\t}\n1507\t\n1508\tfunction applyTheme(theme) {\n1509\t  if (theme === 'dark') {\n1510\t    document.documentElement.removeAttribute('data-theme');\n1511\t  } else {\n1512\t    document.documentElement.setAttribute('data-theme', theme);\n1513\t  }\n1514\t  localStorage.setItem('webui_theme', theme);\n1515\t  updateThemeIcon(theme);\n1516\t}\n1517\t\n1518\tfunction cycleTheme() {\n1519\t  currentThemeIndex = (currentThemeIndex + 1) % themes.length;\n1520\t  applyTheme(themes[currentThemeIndex]);\n1521\t}\n1522\t\n1523\tfunction updateThemeIcon(theme) {\n1524\t  const icon = document.getElementById('theme-icon');\n1525\t  if (icon) {\n1526\t    const icons = { dark: 'ti ti-moon', light: 'ti ti-sun', cyberpunk: 'ti ti-palette' };\n1527\t    icon.className = icons[theme] || 'ti ti-moon';\n1528\t  }\n1529\t}\n1530\t\n1531\t// 快捷键面板\n1532\tfunction openShortcutsPanel() {\n1533\t  document.getElementById('shortcuts-panel').classList.add('active');\n1534\t  document.getElementById('shortcuts-overlay').classList.add('active');\n1535\t}\n1536\t\n1537\tfunction closeShortcutsPanel() {\n1538\t  document.getElementById('shortcuts-panel').classList.remove('active');\n1539\t  document.getElementById('shortcuts-overlay').classList.remove('active');\n1540\t}\n1541\t\n1542\t// 搜索功能\n1543\tfunction initSearch() {\n1544\t  const searchInput = document.getElementById('agent-search');\n1545\t  if (!searchInput) return;\n1546\t\n1547\t  searchInput.addEventListener('input', (e) => {\n1548\t    const query = e.target.value.toLowerCase();\n1549\t    const cards = document.querySelectorAll('.agent-card');\n1550\t\n1551\t    cards.forEach(card => {\n1552\t      const name = card.querySelector('.agent-name')?.textContent.toLowerCase() || '';\n1553\t      const id = card.querySelector('.agent-id')?.textContent.toLowerCase() || '';\n1554\t      const status = card.querySelector('.status-badge')?.textContent.toLowerCase() || '';\n1555\t\n1556\t      const matches = name.includes(query) || id.includes(query) || status.includes(query);\n1557\t      card.style.display = matches ? '' : 'none';\n1558\t    });\n1559\t  });\n1560\t}\n1561\t\n1562\t// 自动刷新指示器\n1563\tfunction updateRefreshIndicator(active, interval) {\n1564\t  const indicator = document.getElementById('auto-refresh-indicator');\n1565\t  const status = document.getElementById('refresh-status');\n1566\t  if (indicator && status) {\n1567\t    indicator.classList.toggle('active', active);\n1568\t    status.textContent = active ? `自动刷新: ${interval/1000}s` : '已暂停';\n1569\t  }\n1570\t}\n1571\t\n1572\t// 页面导航\n1573\tfunction navigateTo(pageId) {\n1574\t  // 更新导航状态\n1575\t  document.querySelectorAll('.nav-item').forEach(item => {\n1576\t    item.classList.remove('active');\n1577\t    if (item.dataset.page === pageId) {\n1578\t      item.classList.add('active');\n1579\t    }\n1580\t  });\n1581\t\n1582\t  // 更新页面显示\n1583\t  document.querySelectorAll('.page').forEach(page => {\n1584\t    page.classList.remove('active');\n1585\t  });\n1586\t  const targetPage = document.getElementById(`page-${pageId}`);\n1587\t  if (targetPage) {\n1588\t    targetPage.classList.add('active');\n1589\t  }\n1590\t\n1591\t  // 加载页面数据\n1592\t  loadPageData(pageId);\n1593\t}\n1594\t\n1595\t// 加载页面数据\n1596\tasync function loadPageData(pageId) {\n1597\t  switch (pageId) {\n1598\t    case 'dashboard':\n1599\t      await loadDashboard();\n1600\t      break;\n1601\t    case 'agents':\n1602\t      await loadAgents();\n1603\t      break;\n1604\t    case 'tasks':\n1605\t      await loadTasks();\n1606\t      break;\n1607\t    case 'performance':\n1608\t      await loadPerformance();\n1609\t      break;\n1610\t    case 'logs':\n1611\t      await loadLogs();\n1612\t      break;\n1613\t    case 'screenshots':\n1614\t      await loadScreenshots();\n1615\t      break;\n1616\t    case 'settings':\n1617\t      loadSettings();\n1618\t      break;\n1619\t  }\n1620\t}\n1621\t\n1622\t// 获取 agents 数据\n1623\tasync function fetchAgents() {\n1624\t  try {\n1625\t    const response = await fetch(`${API_BASE}/agents`);\n1626\t    if (!response.ok) throw new Error('API 请求失败');\n1627\t    return await response.json();\n1628\t  } catch (error) {\n1629\t    console.error('获取 agents 失败:', error);\n1630\t    return [];\n1631\t  }\n1632\t}\n1633\t\n1634\t// 导出 Agents 数据\n1635\tasync function exportAgentsData() {\n1636\t  try {\n1637\t    const agents = await fetchAgents();\n1638\t    const dataStr = JSON.stringify(agents, null, 2);\n1639\t    const blob = new Blob([dataStr], { type: 'application/json' });\n1640\t    const url = URL.createObjectURL(blob);\n1641\t    const a = document.createElement('a');\n1642\t    a.href = url;\n1643\t    a.download = `loopcli_agents_${new Date().toISOString().slice(0, 10)}.json`;\n1644\t    document.body.appendChild(a);\n1645\t    a.click();\n1646\t    document.body.removeChild(a);\n1647\t    URL.revokeObjectURL(url);\n1648\t    showNotification('数据导出成功', 'success');\n1649\t  } catch (error) {\n1650\t    console.error('导出失败:', error);\n1651\t    showNotification('导出失败', 'error');\n1652\t  }\n1653\t}\n1654\t\n1655\t// 创建 Agent 模态框\n1656\tasync function showCreateAgentModal() {\n1657\t  showNotification('正在加载模板...', 'info');\n1658\t\n1659\t  try {\n1660\t    // 获取模板列表\n1661\t    const response = await fetch(`${API_BASE}/templates`);\n1662\t    if (!response.ok) throw new Error('获取模板失败');\n1663\t    const templates = await response.json();\n1664\t\n1665\t    const modal = document.createElement('div');\n1666\t    modal.id = 'create-agent-modal';\n1667\t    modal.style.cssText = `\n1668\t      position: fixed; inset: 0; background: rgba(0, 0, 0, 0.7);\n1669\t      display: flex; align-items: center; justify-content: center;\n1670\t      z-index: 10000; animation: fadeIn 0.2s ease;\n1671\t    `;\n1672\t\n1673\t    // 按类别组织模板\n1674\t    const templatesByCategory = {};\n1675\t    templates.forEach(t => {\n1676\t      if (!templatesByCategory[t.category]) {\n1677\t        templatesByCategory[t.category] = [];\n1678\t      }\n1679\t      templatesByCategory[t.category].push(t);\n1680\t    });\n1681\t\n1682\t    // 生成模板选择HTML\n1683\t    let templatesHTML = '';\n1684\t    for (const [category, items] of Object.entries(templatesByCategory)) {\n1685\t      templatesHTML += `\n1686\t        <div style=\"margin-bottom: 20px;\">\n1687\t          <div style=\"font-size: 14px; font-weight: 600; color: var(--accent); margin-bottom: 12px; text-transform: capitalize;\">\n1688\t            ${category}\n1689\t          </div>\n1690\t          <div style=\"display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px;\">\n1691\t            ${items.map(t => `\n1692\t              <label class=\"template-option\" style=\"\n1693\t                display: flex; align-items: center; gap: 8px; padding: 12px;\n1694\t                background: var(--surface2); border: 1px solid var(--border);\n1695\t                border-radius: 8px; cursor: pointer; transition: all 0.2s;\n1696\t              \">\n1697\t                <input type=\"radio\" name=\"agent-template\" value=\"${t.id}\" style=\"margin: 0;\">\n1698\t                <div style=\"flex: 1;\">\n1699\t                  <div style=\"font-size: 13px; font-weight: 500; color: var(--text);\">${t.id}</div>\n1700\t                  <div style=\"font-size: 11px; color: var(--text3);\">${t.description || t.id}</div>\n1701\t                </div>\n1702\t              </label>\n1703\t            `).join('')}\n1704\t          </div>\n1705\t        </div>\n1706\t      `;\n1707\t    }\n1708\t\n1709\t    modal.innerHTML = `\n1710\t      <div style=\"\n1711\t        background: var(--surface); border: 1px solid var(--border);\n1712\t        border-radius: var(--radius); padding: 32px;\n1713\t        width: 700px; max-width: 90vw; max-height: 80vh; overflow-y: auto;\n1714\t        box-shadow: var(--shadow);\n1715\t      \">\n1716\t        <h3 style=\"font-size: 20px; font-weight: 700; margin-bottom: 8px; color: var(--text);\">\n1717\t          创建新 Agent\n1718\t        </h3>\n1719\t        <p style=\"font-size: 13px; color: var(--text2); margin-bottom: 24px;\">\n1720\t          从模板创建一个新的 Agent\n1721\t        </p>\n1722\t\n1723\t        <div style=\"margin-bottom: 24px;\">\n1724\t          <label style=\"display: block; font-size: 13px; color: var(--text2); margin-bottom: 8px;\">\n1725\t            Agent 名称 (可选)\n1726\t          </label>\n1727\t          <input type=\"text\" id=\"new-agent-name\" placeholder=\"留空使用模板名称\" style=\"\n1728\t            width: 100%; padding: 12px 16px; background: var(--surface2);\n1729\t            border: 1px solid var(--border); border-radius: 8px;\n1730\t            color: var(--text); font-size: 14px;\n1731\t          \">\n1732\t        </div>\n1733\t\n1734\t        <div style=\"margin-bottom: 24px;\">\n1735\t          <label style=\"display: block; font-size: 13px; color: var(--text2); margin-bottom: 12px;\">\n1736\t            选择模板\n1737\t          </label>\n1738\t          <div style=\"max-height: 400px; overflow-y: auto; padding-right: 8px;\">\n1739\t            ${templatesHTML || '<div style=\"color: var(--text2); text-align: center; padding: 20px;\">暂无可用模板</div>'}\n1740\t          </div>\n1741\t        </div>\n1742\t\n1743\t        <div style=\"display: flex; gap: 12px; justify-content: flex-end; padding-top: 16px; border-top: 1px solid var(--border);\">\n1744\t          <button onclick=\"closeCreateAgentModal()\" class=\"btn btn-secondary\"><i class=\"ti ti-x\"></i> 取消</button>\n1745\t          <button onclick=\"createNewAgent()\" class=\"btn btn-primary\"><i class=\"ti ti-plus\"></i> 创建</button>\n1746\t        </div>\n1747\t      </div>\n1748\t\n1749\t      <style>\n1750\t        .template-option:hover { background: var(--border) !important; }\n1751\t        .template-option input:checked + div { color: var(--accent); }\n1752\t      </style>\n1753\t    `;\n1754\t\n1755\t    modal.addEventListener('click', (e) => {\n1756\t      if (e.target === modal) closeCreateAgentModal();\n1757\t    });\n1758\t\n1759\t    document.body.appendChild(modal);\n1760\t\n1761\t  } catch (error) {\n1762\t    console.error('加载模板失败:', error);\n1763\t    showNotification('加载模板失败: ' + error.message, 'error');\n1764\t  }\n1765\t}\n1766\t\n1767\tfunction closeCreateAgentModal() {\n1768\t  const modal = document.getElementById('create-agent-modal');\n1769\t  if (modal) {\n1770\t    modal.style.animation = 'fadeOut 0.2s ease';\n1771\t    setTimeout(() => modal.remove(), 200);\n1772\t  }\n1773\t}\n1774\t\n1775\tasync function createNewAgent() {\n1776\t  const customName = document.getElementById('new-agent-name')?.value.trim() || '';\n1777\t  const selectedTemplate = document.querySelector('input[name=\"agent-template\"]:checked');\n1778\t\n1779\t  if (!selectedTemplate) {\n1780\t    showNotification('请选择一个模板', 'warning');\n1781\t    return;\n1782\t  }\n1783\t\n1784\t  const templateId = selectedTemplate.value;\n1785\t\n1786\t  try {\n1787\t    showNotification('正在创建 Agent...', 'info');\n1788\t\n1789\t    const response = await fetch(`${API_BASE}/agents/create`, {\n1790\t      method: 'POST',\n1791\t      headers: { 'Content-Type': 'application/json' },\n1792\t      body: JSON.stringify({\n1793\t        template: templateId,\n1794\t        name: customName || null,\n1795\t        task: ''\n1796\t      })\n1797\t    });\n1798\t\n1799\t    if (!response.ok) {\n1800\t      const errorData = await response.json();\n1801\t      throw new Error(errorData.error || '创建失败');\n1802\t    }\n1803\t\n1804\t    const data = await response.json();\n1805\t    showNotification(`Agent \"${data.name || templateId}\" 创建成功！`, 'success');\n1806\t    closeCreateAgentModal();\n1807\t\n1808\t    // 刷新 Agent 列表\n1809\t    await loadAgents();\n1810\t\n1811\t  } catch (error) {\n1812\t    console.error('创建 Agent 失败:', error);\n1813\t    showNotification('创建失败: ' + error.message, 'error');\n1814\t  }\n1815\t}\n1816\t\n1817\tasync function refreshAgents() {\n1818\t  showNotification('正在刷新...', 'info');\n1819\t  await loadAgents();\n1820\t  showNotification('刷新成功', 'success');\n1821\t}\n1822\t\n1823\t// SVG 圆环图（自适应版）\n1824\tfunction drawDonutChart(containerId, data, colors) {\n1825\t  const container = document.getElementById(containerId);\n1826\t  if (!container) return;\n1827\t  const total = data.reduce((s, d) => s + d.value, 0);\n1828\t  if (total === 0) { container.innerHTML = '<span style=\"color:var(--text3)\">暂无数据</span>'; return; }\n1829\t\n1830\t  const size = 160, cx = 80, cy = 80, r = 58, stroke = 18;\n1831\t  const circumference = 2 * Math.PI * r;\n1832\t  let offset = 0;\n1833\t  const gapAngle = data.filter(d => d.value > 0).length > 1 ? 3 : 0;\n1834\t\n1835\t  let arcs = data.map((item, i) => {\n1836\t    if (item.value === 0) return '';\n1837\t    const pct = item.value / total;\n1838\t    const dash = Math.max(0, circumference * pct - gapAngle);\n1839\t    const gap = circumference - dash;\n1840\t    const color = colors[i % colors.length];\n1841\t    const html = `<circle cx=\"${cx}\" cy=\"${cy}\" r=\"${r}\" fill=\"none\" stroke=\"${color}\" stroke-width=\"${stroke}\" stroke-dasharray=\"${dash} ${gap}\" stroke-dashoffset=\"${-offset}\" stroke-linecap=\"round\" transform=\"rotate(-90 ${cx} ${cy})\" style=\"transition:all .6s cubic-bezier(.4,0,.2,1);filter:drop-shadow(0 0 6px ${color}40);\"/>`;\n1842\t    offset += dash + gapAngle;\n1843\t    return html;\n1844\t  }).join('');\n1845\t\n1846\t  const svg = `<svg viewBox=\"0 0 ${size} ${size}\" style=\"width:100%;height:auto;max-width:220px;filter:drop-shadow(0 4px 12px rgba(0,0,0,0.15));\">${arcs}<text x=\"${cx}\" y=\"${cy - 8}\" text-anchor=\"middle\" fill=\"var(--text)\" font-size=\"28\" font-weight=\"800\" font-family=\"system-ui,sans-serif\">${total}</text><text x=\"${cx}\" y=\"${cy + 14}\" text-anchor=\"middle\" fill=\"var(--text3)\" font-size=\"11\" font-family=\"system-ui,sans-serif\">总计</text></svg>`;\n1847\t\n1848\t  const legend = data.filter(d => d.value > 0).map((item, i) => {\n1849\t    const origIdx = data.indexOf(item);\n1850\t    const color = colors[origIdx % colors.length];\n1851\t    const pct = Math.round(item.value / total * 100);\n1852\t    return `<div class=\"donut-legend-item\" style=\"display:flex;align-items:center;gap:10px;padding:6px 0;\">\n1853\t      <span style=\"width:12px;height:12px;border-radius:3px;background:${color};flex-shrink:0;box-shadow:0 2px 6px ${color}40;\"></span>\n1854\t      <span style=\"font-size:14px;color:var(--text2);min-width:50px;\">${item.label}</span>\n1855\t      <span style=\"font-size:14px;font-weight:700;color:var(--text);margin-left:auto;\">${item.value}</span>\n1856\t      <span style=\"font-size:11px;color:var(--text3);min-width:36px;text-align:right;\">${pct}%</span>\n1857\t    </div>`;\n1858\t  }).join('');\n1859\t\n1860\t  container.innerHTML = `<div class=\"donut-chart-wrapper\" style=\"display:flex;align-items:center;justify-content:center;gap:28px;flex-wrap:wrap;\">${svg}<div class=\"donut-legend\" style=\"min-width:130px;\">${legend}</div></div>`;\n1861\t}\n1862\t\n1863\t// 进度条列表（美化版）\n1864\tfunction drawProgressBars(containerId, data, maxBar) {\n1865\t  const container = document.getElementById(containerId);\n1866\t  if (!container) return;\n1867\t  if (!data || data.length === 0) { container.innerHTML = '<div style=\"color:var(--text3);text-align:center;padding:20px;\">暂无数据</div>'; return; }\n1868\t  const maxVal = maxBar || Math.max(...data.map(d => d.value), 1);\n1869\t  const barColors = ['#6366f1','#8b5cf6','#a78bfa','#c4b5fd','#7c3aed','#5b21b6'];\n1870\t  container.innerHTML = data.map((item, idx) => {\n1871\t    const pct = Math.round((item.value / maxVal) * 100);\n1872\t    const color = barColors[idx % barColors.length];\n1873\t    return `<div style=\"margin-bottom:14px;padding:10px 14px;background:var(--surface2);border-radius:10px;transition:transform .2s ease;\">\n1874\t      <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;\">\n1875\t        <span style=\"color:var(--text);font-size:13px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;max-width:60%;\">${item.label}</span>\n1876\t        <span style=\"color:${color};font-weight:700;font-size:14px;flex-shrink:0;\">${pct}%</span>\n1877\t      </div>\n1878\t      <div style=\"height:6px;background:rgba(128,128,128,0.15);border-radius:3px;overflow:hidden;\">\n1879\t        <div style=\"height:100%;width:${pct}%;background:linear-gradient(90deg,${color},${color}cc);border-radius:3px;transition:width .6s cubic-bezier(.4,0,.2,1);box-shadow:0 0 8px ${color}40;\"></div>\n1880\t      </div>\n1881\t    </div>`;\n1882\t  }).join('');\n1883\t}\n1884\t\n1885\t// 绘制折线趋势图\n1886\tfunction drawLineChart(canvasId, data, color) {\n1887\t  const canvas = document.getElementById(canvasId);\n1888\t  if (!canvas) return;\n1889\t  const ctx = canvas.getContext('2d');\n1890\t  const rect = canvas.getBoundingClientRect();\n1891\t  canvas.width = rect.width * 2;\n1892\t  canvas.height = rect.height * 2;\n1893\t  ctx.scale(2, 2);\n1894\t\n1895\t  const padding = 40;\n1896\t  const chartWidth = canvas.width / 2 - padding * 2;\n1897\t  const chartHeight = canvas.height / 2 - padding * 2;\n1898\t\n1899\t  ctx.clearRect(0, 0, canvas.width, canvas.height);\n1900\t\n1901\t  const maxValue = Math.max(...data.map(d => d.value)) * 1.1;\n1902\t  const minValue = 0;\n1903\t  const range = maxValue - minValue;\n1904\t\n1905\t  const theme = document.documentElement.dataset.theme || 'dark';\n1906\t  const gridColor = theme === 'light' ? '#e5e7eb' : '#374151';\n1907\t  const textColor = theme === 'light' ? '#374151' : '#9ca3af';\n1908\t\n1909\t  // 绘制网格线\n1910\t  ctx.strokeStyle = gridColor;\n1911\t  ctx.lineWidth = 1;\n1912\t  for (let i = 0; i <= 5; i++) {\n1913\t    const y = padding + (chartHeight / 5) * i;\n1914\t    ctx.beginPath();\n1915\t    ctx.moveTo(padding, y);\n1916\t    ctx.lineTo(padding + chartWidth, y);\n1917\t    ctx.stroke();\n1918\t\n1919\t    const value = Math.round(maxValue - (range / 5) * i);\n1920\t    ctx.fillStyle = textColor;\n1921\t    ctx.font = '11px sans-serif';\n1922\t    ctx.textAlign = 'right';\n1923\t    ctx.fillText(value.toLocaleString(), padding - 8, y + 4);\n1924\t  }\n1925\t\n1926\t  if (data.length < 2) return;\n1927\t\n1928\t  const stepX = chartWidth / (data.length - 1);\n1929\t  const points = data.map((d, i) => ({\n1930\t    x: padding + i * stepX,\n1931\t    y: padding + chartHeight - ((d.value - minValue) / range) * chartHeight\n1932\t  }));\n1933\t\n1934\t  // 绘制渐变填充\n1935\t  const gradient = ctx.createLinearGradient(0, padding, 0, padding + chartHeight);\n1936\t  gradient.addColorStop(0, color + '40');\n1937\t  gradient.addColorStop(1, color + '00');\n1938\t\n1939\t  ctx.beginPath();\n1940\t  ctx.moveTo(points[0].x, padding + chartHeight);\n1941\t  points.forEach(p => ctx.lineTo(p.x, p.y));\n1942\t  ctx.lineTo(points[points.length - 1].x, padding + chartHeight);\n1943\t  ctx.closePath();\n1944\t  ctx.fillStyle = gradient;\n1945\t  ctx.fill();\n1946\t\n1947\t  // 绘制线条\n1948\t  ctx.beginPath();\n1949\t  ctx.moveTo(points[0].x, points[0].y);\n1950\t  points.forEach(p => ctx.lineTo(p.x, p.y));\n1951\t  ctx.strokeStyle = color;\n1952\t  ctx.lineWidth = 2;\n1953\t  ctx.stroke();\n1954\t\n1955\t  // 绘制数据点和标签\n1956\t  points.forEach((p, i) => {\n1957\t    ctx.beginPath();\n1958\t    ctx.arc(p.x, p.y, 4, 0, Math.PI * 2);\n1959\t    ctx.fillStyle = color;\n1960\t    ctx.fill();\n1961\t    ctx.strokeStyle = theme === 'light' ? '#ffffff' : '#1f2937';\n1962\t    ctx.lineWidth = 2;\n1963\t    ctx.stroke();\n1964\t\n1965\t    // X轴标签\n1966\t    ctx.fillStyle = textColor;\n1967\t    ctx.font = '11px sans-serif';\n1968\t    ctx.textAlign = 'center';\n1969\t    ctx.fillText(data[i].label, p.x, padding + chartHeight + 20);\n1970\t  });\n1971\t}\n1972\t\n1973\t// 加载 Agents 页面\n1974\tasync function loadAgents() {\n1975\t  const agents = await fetchAgents();\n1976\t\n1977\t  // 按 run_count 降序排序\n1978\t  agents.sort((a, b) => (b.run_count || 0) - (a.run_count || 0));\n1979\t\n1980\t  // 更新统计（主页和Agent页共享的统计卡片）\n1981\t  const total = agents.length;\n1982\t  const active = agents.filter(a => a.status !== 'disabled').length;\n1983\t  const totalTasks = agents.reduce((sum, a) => sum + (a.task_count || 0), 0);\n1984\t  const doneTasks = agents.reduce((sum, a) => sum + (a.task_done || 0), 0);\n1985\t\n1986\t  const totalEl = document.getElementById('total-agents');\n1987\t  const activeEl = document.getElementById('active-agents');\n1988\t  const totalTasksEl = document.getElementById('total-tasks');\n1989\t  const doneTasksEl = document.getElementById('done-tasks');\n1990\t  if (totalEl) totalEl.textContent = total;\n1991\t  if (activeEl) activeEl.textContent = active;\n1992\t  if (totalTasksEl) totalTasksEl.textContent = totalTasks;\n1993\t  if (doneTasksEl) doneTasksEl.textContent = doneTasks;\n1994\t\n1995\t  // 渲染 agent cards\n1996\t  const grid = document.getElementById('agents-grid');\n1997\t  if (agents.length === 0) {\n1998\t    grid.innerHTML = '<div class=\"loading\"><div>暂无 Agents</div></div>';\n1999\t    return;\n2000\t  }\n2001\t\n2002\t  grid.innerHTML = agents.map(agent => {\n2003\t    const progress = agent.task_count > 0\n2004\t      ? Math.round((agent.task_done / agent.task_count) * 100)\n2005\t      : 0;\n2006\t\n2007\t    return `\n2008\t      <div class=\"agent-card\" data-id=\"${agent.id}\">\n2009\t        <div class=\"agent-header\">\n2010\t          <div>\n2011\t            <div class=\"agent-name\">${agent.name}</div>\n2012\t            <div class=\"agent-id\">${agent.id}</div>\n2013\t          </div>\n2014\t          <span class=\"status-badge ${agent.status}\">\n2015\t            <span class=\"status-dot\"></span>\n2016\t            <span>${agent.status === 'disabled' ? '已禁用' : agent.status === 'idle' ? '空闲' : agent.status === 'active' ? '运行中' : agent.status}</span>\n2017\t          </span>\n2018\t        </div>\n2019\t\n2020\t        <div class=\"agent-description\">\n2021\t          ${agent.description || '暂无描述'}\n2022\t        </div>\n2023\t\n2024\t        <div class=\"agent-stats\">\n2025\t          <div class=\"agent-stat\">\n2026\t            <span class=\"label\">运行次数:</span>\n2027\t            <span class=\"value\">${agent.run_count || 0}</span>\n2028\t          </div>\n2029\t          <div class=\"agent-stat\">\n2030\t            <span class=\"label\">最后运行:</span>\n2031\t            <span class=\"value\">${agent.last_run || '从未'}</span>\n2032\t          </div>\n2033\t          <div class=\"agent-stat\">\n2034\t            <span class=\"label\">任务:</span>\n2035\t            <span class=\"value\">${agent.task_done}/${agent.task_count}</span>\n2036\t          </div>\n2037\t          <div class=\"agent-stat\">\n2038\t            <span class=\"label\">当前任务:</span>\n2039\t            <span class=\"value\">${agent.current_task || '无'}</span>\n2040\t          </div>\n2041\t          ${agent.task_count > 0 ? `\n2042\t          <div class=\"task-progress\">\n2043\t            <div class=\"task-progress-bar\">\n2044\t              <div class=\"task-progress-fill\" style=\"width: ${progress}%\"></div>\n2045\t            </div>\n2046\t          </div>\n2047\t          ` : ''}\n2048\t        </div>\n2049\t\n2050\t        <div class=\"agent-actions\">\n2051\t          <button class=\"btn btn-primary\" onclick=\"enableAgent('${agent.id}')\">\n2052\t            <i class=\"ti ti-player-play\"></i> 启用\n2053\t          </button>\n2054\t          <button class=\"btn btn-secondary\" onclick=\"disableAgent('${agent.id}')\">\n2055\t            <i class=\"ti ti-player-stop\"></i> 禁用\n2056\t          </button>\n2057\t        </div>\n2058\t      </div>\n2059\t    `;\n2060\t  }).join('');\n2061\t}\n2062\t\n2063\t// 加载主页 Dashboard\n2064\tasync function loadDashboard() {\n2065\t  const agents = await fetchAgents();\n2066\t  agents.sort((a, b) => (b.run_count || 0) - (a.run_count || 0));\n2067\t\n2068\t  // 更新统计\n2069\t  const total = agents.length;\n2070\t  const active = agents.filter(a => a.status !== 'disabled').length;\n2071\t  const totalTasks = agents.reduce((sum, a) => sum + (a.task_count || 0), 0);\n2072\t  const doneTasks = agents.reduce((sum, a) => sum + (a.task_done || 0), 0);\n2073\t\n2074\t  const totalEl = document.getElementById('total-agents');\n2075\t  const activeEl = document.getElementById('active-agents');\n2076\t  const totalTasksEl = document.getElementById('total-tasks');\n2077\t  const doneTasksEl = document.getElementById('done-tasks');\n2078\t  if (totalEl) totalEl.textContent = total;\n2079\t  if (activeEl) activeEl.textContent = active;\n2080\t  if (totalTasksEl) totalTasksEl.textContent = totalTasks;\n2081\t  if (doneTasksEl) doneTasksEl.textContent = doneTasks;\n2082\t\n2083\t  // 绘制圆环图\n2084\t  const statusCounts = {};\n2085\t  agents.forEach(a => {\n2086\t    statusCounts[a.status] = (statusCounts[a.status] || 0) + 1;\n2087\t  });\n2088\t  const statusData = Object.entries(statusCounts).map(([status, count]) => ({\n2089\t    label: status,\n2090\t    value: count\n2091\t  }));\n2092\t  const statusColors = ['#10b981', '#f59e0b', '#ef4444', '#3b82f6'];\n2093\t  drawDonutChart('agent-status-chart', statusData, statusColors);\n2094\t\n2095\t  // 任务进度\n2096\t  const taskData = agents\n2097\t    .filter(a => a.task_count > 0)\n2098\t    .map(a => ({\n2099\t      label: a.name.substring(0, 12),\n2100\t      value: a.task_done,\n2101\t      max: a.task_count\n2102\t    }));\n2103\t  drawProgressBars('task-progress-chart', taskData.map(d => ({label: `${d.label} (${d.value}/${d.max})`, value: d.value})));\n2104\t\n2105\t  // 加载长期任务\n2106\t  if (typeof loadLongTask === 'function') loadLongTask();\n2107\t\n2108\t  // 加载用量统计\n2109\t  if (typeof loadUsageStats === 'function') loadUsageStats();\n2110\t}\n2111\t\n2112\t// 加载 Tasks 页面\n2113\tasync function loadTasks() {\n2114\t  try {\n2115\t    const response = await fetch(`${API_BASE}/tasks`);\n2116\t    if (!response.ok) throw new Error('API 请求失败');\n2117\t    const tasks = await response.json();\n2118\t\n2119\t    const tbody = document.getElementById('tasks-table-body');\n2120\t    if (tasks.length === 0) {\n2121\t      tbody.innerHTML = '<tr><td colspan=\"5\" style=\"text-align: center; color: var(--text2);\">暂无任务</td></tr>';\n2122\t      return;\n2123\t    }\n2124\t\n2125\t    tbody.innerHTML = tasks.map(task => `\n2126\t      <tr>\n2127\t        <td>${task.id}</td>\n2128\t        <td>${task.title || task.subject || '-'}</td>\n2129\t        <td><span class=\"status-badge ${task.status}\">${task.status}</span></td>\n2130\t        <td>${task.agent_id || '-'}</td>\n2131\t        <td>${task.created_at || '-'}</td>\n2132\t      </tr>\n2133\t    `).join('');\n2134\t  } catch (error) {\n2135\t    console.error('加载任务失败:', error);\n2136\t    document.getElementById('tasks-table-body').innerHTML =\n2137\t      '<tr><td colspan=\"5\" style=\"text-align: center; color: var(--red);\">加载失败</td></tr>';\n2138\t  }\n2139\t}\n2140\t\n2141\t// 加载 Performance 页面\n2142\tasync function loadPerformance() {\n2143\t  // 1) 系统指标 + 响应时间（测量 health API）\n2144\t  try {\n2145\t    const t0 = performance.now();\n2146\t    const healthResp = await fetch(`${API_BASE}/health`);\n2147\t    const latency = performance.now() - t0;\n2148\t    if (healthResp.ok) {\n2149\t      const health = await healthResp.json();\n2150\t      if (health.system) {\n2151\t        document.getElementById('cpu-usage').textContent = health.system.cpu_percent + '%';\n2152\t        document.getElementById('memory-usage').textContent = health.system.memory_percent + '%';\n2153\t      }\n2154\t    }\n2155\t    document.getElementById('response-time').textContent = Math.round(latency) + 'ms';\n2156\t  } catch(e) {\n2157\t    document.getElementById('response-time').textContent = '离线';\n2158\t  }\n2159\t\n2160\t  // 2) Token消耗趋势\n2161\t  try {\n2162\t    const trendResp = await fetch(`${API_BASE}/usage/trend`);\n2163\t    if (trendResp.ok) {\n2164\t      const trendRaw = await trendResp.json();\n2165\t      const trendData = Array.isArray(trendRaw) ? trendRaw : (trendRaw.data || []);\n2166\t      const total = trendData.reduce((s, d) => s + d.value, 0);\n2167\t      if (trendData.length && total > 0) {\n2168\t        drawLineChart('token-trend-chart', trendData, '#3b82f6');\n2169\t        document.getElementById('token-trend-summary').textContent =\n2170\t          trendRaw.summary || `${trendData.length}天累计 ${total} 次任务，平均 ${Math.round(total / trendData.length)} 次/天`;\n2171\t      } else {\n2172\t        drawLineChart('token-trend-chart', [], '#3b82f6');\n2173\t        document.getElementById('token-trend-summary').textContent = '近7天数据收集中';\n2174\t      }\n2175\t    }\n2176\t  } catch(e) {}\n2177\t\n2178\t  // 3) Token用量摘要\n2179\t  try {\n2180\t    const usageResp = await fetch(`${API_BASE}/usage`);\n2181\t    if (usageResp.ok) {\n2182\t      const usage = await usageResp.json();\n2183\t      if (usage.error) {\n2184\t        document.getElementById('token-usage').textContent = '暂无';\n2185\t      } else if (usage.total_tokens) {\n2186\t        document.getElementById('token-usage').textContent = Number(usage.total_tokens).toLocaleString();\n2187\t      } else if (usage.weekly) {\n2188\t        const wk = usage.weekly;\n2189\t        document.getElementById('token-usage').textContent = (wk.total_runs || 0) + '次';\n2190\t      } else {\n2191\t        document.getElementById('token-usage').textContent = '暂无';\n2192\t      }\n2193\t    }\n2194\t  } catch(e) {\n2195\t    document.getElementById('token-usage').textContent = '暂无';\n2196\t  }\n2197\t}\n2198\t\n2199\t// 加载 Logs 页面\n2200\tasync function loadLogs() {\n2201\t  try {\n2202\t    const response = await fetch(`${API_BASE}/logs`);\n2203\t    if (!response.ok) throw new Error('API 请求失败');\n2204\t    const data = await response.json();\n2205\t\n2206\t    const container = document.getElementById('logs-content');\n2207\t    const lines = Array.isArray(data) ? data : (data.lines || []);\n2208\t    if (!lines || lines.length === 0) {\n2209\t      container.innerHTML = '<div style=\"text-align: center; color: var(--text2);\">暂无日志</div>';\n2210\t      return;\n2211\t    }\n2212\t\n2213\t    // Parse table-format logs: | time | status | task | summary |\n2214\t    const logEntries = lines\n2215\t      .filter(l => l.trim().startsWith('|') && !l.trim().startsWith('|--') && !l.trim().startsWith('| 时间') && !l.trim().startsWith('| #'))\n2216\t      .slice(-50)\n2217\t      .map(line => {\n2218\t        const parts = line.split('|').map(s => s.trim()).filter(Boolean);\n2219\t        if (parts.length >= 4) {\n2220\t          return { time: parts[0], status: parts[1], task: parts[2], message: parts[3] };\n2221\t        }\n2222\t        return { time: '', status: '', task: '', message: line };\n2223\t      });\n2224\t\n2225\t    if (logEntries.length === 0) {\n2226\t      container.innerHTML = '<div style=\"text-align: center; color: var(--text2);\">暂无日志条目</div>';\n2227\t      return;\n2228\t    }\n2229\t\n2230\t    container.innerHTML = logEntries.map(log => {\n2231\t      const levelClass = log.status === 'done' ? 'success' : log.status === 'idle' ? 'warning' : 'info';\n2232\t      return `<div class=\"log-entry\">\n2233\t        <span class=\"log-time\">${log.time || '-'}</span>\n2234\t        <span class=\"log-level ${levelClass}\">${log.status || 'info'}</span>\n2235\t        <span style=\"color:var(--accent);font-weight:600;margin-right:8px;font-size:12px;\">${log.task}</span>\n2236\t        <span class=\"log-message\">${log.message || '-'}</span>\n2237\t      </div>`;\n2238\t    }).join('');\n2239\t  } catch (error) {\n2240\t    console.error('加载日志失败:', error);\n2241\t    document.getElementById('logs-content').innerHTML =\n2242\t      '<div style=\"text-align: center; color: var(--red);\">加载失败</div>';\n2243\t  }\n2244\t}\n2245\t\n2246\t// 加载 Screenshots 页面\n2247\tasync function loadScreenshots() {\n2248\t  try {\n2249\t    const response = await fetch('/api/screenshots');\n2250\t    const data = await response.json();\n2251\t\n2252\t    if (data.error) {\n2253\t      document.getElementById('screenshots-grid').innerHTML =\n2254\t        `<div style=\"grid-column: 1/-1; text-align: center; color: var(--text2); padding: 40px;\">错误: ${data.error}</div>`;\n2255\t      return;\n2256\t    }\n2257\t\n2258\t    const grid = document.getElementById('screenshots-grid');\n2259\t    if (data.screenshots.length === 0) {\n2260\t      grid.innerHTML =\n2261\t        '<div style=\"grid-column: 1/-1; text-align: center; color: var(--text2); padding: 40px;\">暂无截图</div>';\n2262\t      return;\n2263\t    }\n2264\t\n2265\t    grid.innerHTML = data.screenshots.map(screenshot => `\n2266\t      <div style=\"background: var(--surface2); border-radius: 12px; overflow: hidden; border: 1px solid var(--border);\">\n2267\t        <img src=\"${screenshot.url}\" alt=\"${screenshot.name}\"\n2268\t             style=\"width: 100%; height: 200px; object-fit: cover; cursor: pointer;\"\n2269\t             onclick=\"window.open('${screenshot.url}', '_blank')\">\n2270\t        <div style=\"padding: 12px;\">\n2271\t          <div style=\"font-size: 13px; font-weight: 500; color: var(--text); margin-bottom: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;\" title=\"${screenshot.name}\">\n2272\t            ${screenshot.name}\n2273\t          </div>\n2274\t          <div style=\"font-size: 11px; color: var(--text2); display: flex; justify-content: space-between;\">\n2275\t            <span>${screenshot.size} KB</span>\n2276\t            <span>${new Date(screenshot.modified).toLocaleString('zh-CN')}</span>\n2277\t          </div>\n2278\t        </div>\n2279\t      </div>\n2280\t    `).join('');\n2281\t  } catch (error) {\n2282\t    console.error('加载截图失败:', error);\n2283\t    document.getElementById('screenshots-grid').innerHTML =\n2284\t      '<div style=\"grid-column: 1/-1; text-align: center; color: var(--text2); padding: 40px;\">加载失败</div>';\n2285\t  }\n2286\t}\n2287\t\n2288\t// 主题选择器初始化（Settings页面专用）\n2289\tfunction initThemeSelector() {\n2290\t  const savedTheme = localStorage.getItem('webui_theme') || 'dark';\n2291\t  const themeSelector = document.getElementById('theme-selector');\n2292\t  if (themeSelector) {\n2293\t    themeSelector.value = savedTheme;\n2294\t    themeSelector.addEventListener('change', (e) => {\n2295\t      const newTheme = e.target.value;\n2296\t      if (newTheme === 'dark') {\n2297\t        document.documentElement.removeAttribute('data-theme');\n2298\t      } else {\n2299\t        document.documentElement.setAttribute('data-theme', newTheme);\n2300\t      }\n2301\t      localStorage.setItem('webui_theme', newTheme);\n2302\t      updateThemeIcon(newTheme);\n2303\t      currentThemeIndex = themes.indexOf(newTheme);\n2304\t      showNotification(`主题已切换: ${newTheme}`, 'success');\n2305\t    });\n2306\t  }\n2307\t}\n2308\t\n2309\t// 加载 Settings 页面\n2310\tasync function loadSettings() {\n2311\t  initThemeSelector();\n2312\t  await loadSystemInfo();\n2313\t  loadLongTask();\n2314\t}\n2315\t"}]},"parent_tool_use_id":null,"session_id":"d64e1a9d-08e5-4edf-9a30-2c526c5dbaf6","uuid":"54b57d1f-fd0d-4e71-afd1-5eea5d909776","timestamp":"2026-05-22T20:21:32.346Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\loopcli\\main\\webui\\index.html","content":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>LoopCLI - Agent 控制台 v8.8</title>\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css\">\n<style>\n.ti { font-size: 18px; vertical-align: middle; }\n.nav-item .ti { font-size: 20px; }\n.btn .ti { font-size: 16px; }\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n:root {\n  /* v8.1 配色 - 深色主题（默认） */\n  --bg: #0a0e17;\n  --surface: #111827;\n  --surface2: #1f2937;\n  --border: #374151;\n  --text: #f3f4f6;\n  --text2: #b0b8c4;\n  --text3: #7c8594;\n\n  /* 品牌色 */\n  --accent: #3b82f6;\n  --accent2: #8b5cf6;\n  --accent3: #10b981;\n  --accent-gradient: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 50%, #10b981 100%);\n}\n\n/* 浅色主题 */\n[data-theme=\"light\"] {\n  --bg: #f8fafc;\n  --surface: #ffffff;\n  --surface2: #e2e8f0;\n  --border: #cbd5e1;\n  --text: #1e293b;\n  --text2: #64748b;\n  --text3: #94a3b8;\n\n  --accent: #2563eb;\n  --accent2: #7c3aed;\n  --accent3: #059669;\n  --accent-gradient: linear-gradient(135deg, #2563eb 0%, #7c3aed 50%, #059669 100%);\n}\n\n/* 赛博朋克主题 */\n[data-theme=\"cyberpunk\"] {\n  --bg: #0d0221;\n  --surface: #1a0533;\n  --surface2: #2d1b4e;\n  --border: #ff00ff;\n  --text: #00ffff;\n  --text2: #ff00ff;\n  --text3: #9d4edd;\n\n  --accent: #00ffff;\n  --accent2: #ff00ff;\n  --accent3: #39ff14;\n  --accent-gradient: linear-gradient(135deg, #00ffff 0%, #ff00ff 50%, #39ff14 100%);\n}\n\n/* 状态色和通用变量 - 必须在 :root 内 */\n:root {\n  --green: #10b981;\n  --green-bg: rgba(16, 185, 129, 0.15);\n  --yellow: #f59e0b;\n  --yellow-bg: rgba(245, 158, 11, 0.15);\n  --red: #ef4444;\n  --red-bg: rgba(239, 68, 68, 0.15);\n  --blue: #3b82f6;\n  --blue-bg: rgba(59, 130, 246, 0.15);\n  --purple: #8b5cf6;\n  --purple-bg: rgba(139, 92, 246, 0.15);\n\n  --radius: 16px;\n  --shadow: 0 10px 40px rgba(0, 0, 0, 0.5);\n  --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.3);\n}\n\nhtml { background: var(--bg); }\nbody {\n  font-family: -apple-system, \"Segoe UI\", system-ui, sans-serif;\n  background: var(--bg);\n  color: var(--text);\n  min-height: 100vh;\n  line-height: 1.6;\n  overflow: hidden;\n}\n\n/* 布局 */\n.app { display: flex; height: 100vh; overflow: hidden; }\n.sidebar {\n  width: 260px;\n  background: var(--surface);\n  border-right: 1px solid var(--border);\n  display: flex;\n  flex-direction: column;\n  flex-shrink: 0;\n}\n.main {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  position: relative;\n  background: var(--bg);\n}\n\n/* 侧边栏 */\n.brand {\n  padding: 24px 20px;\n  border-bottom: 1px solid var(--border);\n  background: var(--accent-gradient);\n}\n.brand h1 {\n  font-size: 22px;\n  font-weight: 800;\n  color: white;\n  text-shadow: 0 2px 10px rgba(0,0,0,0.3);\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.nav {\n  flex: 1;\n  padding: 20px 12px;\n  overflow-y: auto;\n}\n.nav-item {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  padding: 14px 16px;\n  border-radius: var(--radius);\n  cursor: pointer;\n  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);\n  color: var(--text2);\n  font-size: 14px;\n  font-weight: 500;\n  margin-bottom: 4px;\n  position: relative;\n  overflow: hidden;\n}\n.nav-item::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: var(--accent-gradient);\n  opacity: 0;\n  transition: opacity 0.25s;\n}\n.nav-item:hover {\n  background: var(--surface2);\n  color: var(--text);\n  transform: translateX(4px);\n}\n.nav-item.active {\n  background: var(--accent-gradient);\n  color: white;\n  box-shadow: var(--shadow-sm);\n}\n.nav-item.active::before { opacity: 1; }\n.nav-item span {\n  position: relative;\n  z-index: 1;\n}\n\n/* 侧边栏底部按钮 */\n.sidebar-footer {\n  margin-top: auto;\n  padding: 16px;\n  display: flex;\n  gap: 8px;\n  border-top: 1px solid var(--border);\n}\n.theme-toggle, .help-toggle {\n  flex: 1;\n  padding: 12px;\n  background: var(--surface2);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  cursor: pointer;\n  transition: all 0.3s;\n  font-size: 20px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.theme-toggle:hover, .help-toggle:hover {\n  background: var(--accent-gradient);\n  transform: scale(1.05);\n}\n\n/* 搜索框 */\n.search-bar {\n  margin-bottom: 24px;\n  position: relative;\n}\n.search-input {\n  width: 100%;\n  padding: 14px 20px 14px 44px;\n  background: var(--surface);\n  border: 2px solid var(--border);\n  border-radius: 12px;\n  color: var(--text);\n  font-size: 14px;\n  transition: all 0.3s;\n}\n.search-input:focus {\n  outline: none;\n  border-color: var(--accent);\n  box-shadow: 0 0 0 3px var(--blue-bg);\n}\n.search-input::placeholder {\n  color: var(--text3);\n}\n\n/* 自动刷新指示器 */\n.auto-refresh-indicator {\n  position: fixed;\n  bottom: 20px;\n  right: 20px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 16px;\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 20px;\n  font-size: 12px;\n  z-index: 1000;\n  opacity: 0.7;\n  transition: opacity 0.3s;\n}\n.auto-refresh-indicator.active {\n  border-color: var(--green);\n  background: var(--green-bg);\n}\n.refresh-icon-ti {\n  animation: spin 1s linear infinite;\n}\n.auto-refresh-indicator:not(.active) .refresh-icon-ti {\n  animation: none;\n}\n\n/* 快捷键帮助面板 */\n.shortcuts-panel {\n  position: fixed;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  padding: 32px;\n  z-index: 2000;\n  max-width: 400px;\n  width: 90%;\n  box-shadow: var(--shadow);\n  display: none;\n}\n.shortcuts-panel.active { display: block; }\n.shortcuts-panel h3 {\n  margin-bottom: 20px;\n  font-size: 20px;\n}\n.shortcut-item {\n  display: flex;\n  justify-content: space-between;\n  padding: 12px 0;\n  border-bottom: 1px solid var(--border);\n}\n.shortcut-item:last-child {\n  border-bottom: none;\n}\n.shortcut-key {\n  display: inline-block;\n  padding: 4px 10px;\n  background: var(--surface2);\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  font-family: monospace;\n  font-size: 12px;\n  font-weight: 600;\n}\n.panel-overlay {\n  position: fixed;\n  inset: 0;\n  background: rgba(0, 0, 0, 0.5);\n  z-index: 1999;\n  display: none;\n  opacity: 0;\n  transition: opacity 0.3s ease;\n}\n.panel-overlay.active {\n  display: block;\n  opacity: 1;\n}\n\n/* 快捷键面板动画 */\n.shortcuts-panel {\n  transition: all 0.3s ease;\n  transform: translate(-50%, -50%) scale(0.9);\n  opacity: 0;\n}\n.shortcuts-panel.active {\n  transform: translate(-50%, -50%) scale(1);\n  opacity: 1;\n}\n\n/* 通知系统 */\n.notification-container {\n  position: fixed;\n  top: 80px;\n  right: 20px;\n  z-index: 3000;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  pointer-events: none;\n}\n.notification {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  padding: 16px 20px;\n  box-shadow: var(--shadow);\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  min-width: 300px;\n  max-width: 400px;\n  pointer-events: auto;\n  animation: slideIn 0.3s ease, fadeOut 0.3s ease 4.7s forwards;\n  position: relative;\n  overflow: hidden;\n}\n.notification::before {\n  content: '';\n  position: absolute;\n  left: 0;\n  top: 0;\n  bottom: 0;\n  width: 4px;\n}\n.notification.success::before { background: var(--green); }\n.notification.info::before { background: var(--blue); }\n.notification.warning::before { background: var(--yellow); }\n.notification.error::before { background: var(--red); }\n.notification-icon {\n  font-size: 20px;\n}\n.notification-message {\n  flex: 1;\n  font-size: 14px;\n  font-weight: 500;\n}\n.notification-close {\n  cursor: pointer;\n  color: var(--text3);\n  font-size: 18px;\n  line-height: 1;\n  padding: 4px;\n}\n.notification-close:hover { color: var(--text); }\n\n@keyframes slideIn {\n  from {\n    transform: translateX(100%);\n    opacity: 0;\n  }\n  to {\n    transform: translateX(0);\n    opacity: 1;\n  }\n}\n@keyframes fadeOut {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n/* 主内容 */\n.content {\n  flex: 1;\n  overflow-y: auto;\n  padding: 32px;\n  position: relative;\n}\n\n/* 页面切换动画 */\n.page {\n  display: none;\n  animation: fadeIn 0.3s ease;\n}\n.page.active { display: block; }\n@keyframes fadeIn {\n  from { opacity: 0; transform: translateY(10px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* 页面标题 */\n.page-header {\n  margin-bottom: 32px;\n}\n.page-header h2 {\n  font-size: 32px;\n  font-weight: 700;\n  background: var(--accent-gradient);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  margin-bottom: 8px;\n}\n.page-header p {\n  color: var(--text2);\n  font-size: 15px;\n}\n\n/* 统计卡片 */\n.stats-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 20px;\n  margin-bottom: 32px;\n}\n.stat-card {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  padding: 24px;\n  position: relative;\n  overflow: hidden;\n  transition: all 0.3s;\n}\n.stat-card::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 3px;\n  background: var(--accent-gradient);\n  transform: scaleX(0);\n  transition: transform 0.3s;\n}\n.stat-card:hover {\n  transform: translateY(-4px);\n  box-shadow: var(--shadow-sm);\n}\n.stat-card:hover::before { transform: scaleX(1); }\n.stat-card .label {\n  color: var(--text2);\n  font-size: 13px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  margin-bottom: 8px;\n}\n.stat-card .value {\n  font-size: 36px;\n  font-weight: 800;\n  background: var(--accent-gradient);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n}\n\n/* Agents 网格 */\n.agents-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));\n  gap: 24px;\n}\n.agent-card {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  padding: 24px;\n  transition: all 0.3s;\n  position: relative;\n  overflow: hidden;\n}\n.agent-card::after {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: var(--accent-gradient);\n  opacity: 0;\n  transition: opacity 0.3s;\n  pointer-events: none;\n}\n.agent-card:hover {\n  transform: translateY(-4px) scale(1.02);\n  box-shadow: var(--shadow);\n  border-color: var(--accent);\n}\n.agent-card:hover::after { opacity: 0.05; }\n\n.agent-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  margin-bottom: 16px;\n}\n.agent-name {\n  font-size: 18px;\n  font-weight: 700;\n  color: var(--text);\n  margin-bottom: 4px;\n}\n.agent-id {\n  font-size: 12px;\n  color: var(--text3);\n  font-family: monospace;\n}\n.status-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 6px 12px;\n  border-radius: 20px;\n  font-size: 12px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n.status-badge.idle { background: var(--yellow-bg); color: var(--yellow); }\n.status-badge.active { background: var(--green-bg); color: var(--green); }\n.status-badge.disabled { background: var(--red-bg); color: var(--red); }\n.status-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: currentColor;\n  animation: pulse 2s infinite;\n}\n@keyframes pulse {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 0.5; }\n}\n\n.agent-description {\n  color: var(--text2);\n  font-size: 14px;\n  margin-bottom: 20px;\n  line-height: 1.5;\n}\n\n.agent-stats {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 12px;\n  margin-bottom: 20px;\n}\n.agent-stat {\n  display: flex;\n  justify-content: space-between;\n  font-size: 13px;\n}\n.agent-stat .label { color: var(--text3); }\n.agent-stat .value { color: var(--text); font-weight: 600; }\n\n.task-progress {\n  margin-top: 16px;\n}\n.task-progress-bar {\n  height: 8px;\n  background: var(--surface2);\n  border-radius: 4px;\n  overflow: hidden;\n}\n.task-progress-fill {\n  height: 100%;\n  background: var(--accent-gradient);\n  border-radius: 4px;\n  transition: width 0.5s ease;\n  animation: shimmer 2s infinite;\n}\n@keyframes shimmer {\n  0% { background-position: -200% 0; }\n  100% { background-position: 200% 0; }\n}\n\n.agent-actions {\n  display: flex;\n  gap: 8px;\n  margin-top: 16px;\n  justify-content: stretch;\n}\n.agent-actions .btn {\n  flex: 1;\n  text-align: center;\n}\n\n/* 按钮 */\n.btn {\n  flex: 1;\n  padding: 10px 16px;\n  border: none;\n  border-radius: 8px;\n  font-size: 13px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.2s;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n}\n.btn-primary {\n  background: var(--accent-gradient);\n  color: white;\n}\n.btn-primary:hover {\n  transform: translateY(-2px);\n  box-shadow: var(--shadow-sm);\n}\n.btn-secondary {\n  background: var(--surface2);\n  color: var(--text);\n  border: 1px solid var(--border);\n}\n.btn-secondary:hover {\n  background: var(--border);\n}\n\n/* 通知系统 */\n#notification-container {\n  position: fixed;\n  top: 24px;\n  right: 24px;\n  z-index: 1000;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  max-height: 40vh;\n  overflow: hidden;\n  max-width: 400px;\n}\n.notification {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 16px 20px;\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  box-shadow: var(--shadow);\n  min-width: 300px;\n  animation: slideIn 0.3s ease;\n}\n@keyframes slideIn {\n  from { transform: translateX(100%); opacity: 0; }\n  to { transform: translateX(0); opacity: 1; }\n}\n.notification.success { border-color: var(--green); }\n.notification.error { border-color: var(--red); }\n.notification.warning { border-color: var(--yellow); }\n\n/* 加载状态 */\n.loading {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 16px;\n  padding: 40px;\n  color: var(--text2);\n}\n.spinner {\n  width: 24px;\n  height: 24px;\n  border: 3px solid var(--border);\n  border-top-color: var(--accent);\n  border-radius: 50%;\n  animation: spin 1s linear infinite;\n}\n@keyframes spin {\n  to { transform: rotate(360deg); }\n}\n\n/* Tasks 表格 */\n.tasks-table {\n  width: 100%;\n  border-collapse: collapse;\n  background: var(--surface);\n  border-radius: var(--radius);\n  overflow: hidden;\n}\n.tasks-table th,\n.tasks-table td {\n  padding: 16px 20px;\n  text-align: left;\n  border-bottom: 1px solid var(--border);\n}\n.tasks-table th {\n  background: var(--surface2);\n  font-weight: 600;\n  font-size: 13px;\n  color: var(--text2);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n.tasks-table tr:hover {\n  background: var(--surface2);\n}\n.tasks-table tr:last-child td {\n  border-bottom: none;\n}\n\n/* Logs 区域 */\n.logs-container {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  overflow: hidden;\n}\n.logs-header {\n  padding: 16px 20px;\n  background: var(--surface2);\n  border-bottom: 1px solid var(--border);\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.logs-content {\n  padding: 20px;\n  font-family: 'Consolas', 'Monaco', monospace;\n  font-size: 13px;\n  line-height: 1.6;\n  max-height: 400px;\n  overflow-y: auto;\n}\n.log-entry {\n  padding: 8px 0;\n  border-bottom: 1px solid var(--border);\n}\n.log-time {\n  color: var(--text3);\n  margin-right: 12px;\n}\n.log-level {\n  display: inline-block;\n  padding: 2px 8px;\n  border-radius: 4px;\n  font-size: 11px;\n  font-weight: 600;\n  margin-right: 8px;\n}\n.log-level.info { background: var(--blue-bg); color: var(--blue); }\n.log-level.warn { background: var(--yellow-bg); color: var(--yellow); }\n.log-level.error { background: var(--red-bg); color: var(--red); }\n\n/* Settings 页面 */\n.settings-section {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  padding: 24px;\n  margin-bottom: 20px;\n}\n.settings-section h3 {\n  font-size: 18px;\n  font-weight: 600;\n  margin-bottom: 20px;\n}\n.setting-item {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 16px 0;\n  border-bottom: 1px solid var(--border);\n}\n.setting-item:last-child {\n  border-bottom: none;\n}\n.setting-label {\n  flex: 1;\n}\n.setting-label .title {\n  font-weight: 600;\n  margin-bottom: 4px;\n}\n.setting-label .description {\n  font-size: 13px;\n  color: var(--text2);\n}\n.setting-control {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n/* 开关 */\n.switch {\n  position: relative;\n  width: 50px;\n  height: 26px;\n}\n.switch input {\n  opacity: 0;\n  width: 0;\n  height: 0;\n}\n.switch-slider {\n  position: absolute;\n  cursor: pointer;\n  inset: 0;\n  background: var(--surface2);\n  border: 1px solid var(--border);\n  border-radius: 26px;\n  transition: all 0.3s;\n}\n.switch-slider::before {\n  position: absolute;\n  content: \"\";\n  height: 20px;\n  width: 20px;\n  left: 2px;\n  bottom: 2px;\n  background: white;\n  border-radius: 50%;\n  transition: all 0.3s;\n}\n.switch input:checked + .switch-slider {\n  background: var(--accent);\n  border-color: var(--accent);\n}\n.switch input:checked + .switch-slider::before {\n  transform: translateX(24px);\n}\n\n/* Performance 页面 */\n.performance-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n  gap: 24px;\n  margin-bottom: 32px;\n}\n.performance-card {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  padding: 24px;\n}\n.performance-card h4 {\n  font-size: 16px;\n  font-weight: 600;\n  margin-bottom: 16px;\n  color: var(--text2);\n}\n.metric-value {\n  font-size: 48px;\n  font-weight: 800;\n  background: var(--accent-gradient);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  line-height: 1;\n  margin-bottom: 8px;\n}\n.metric-change {\n  font-size: 14px;\n  font-weight: 600;\n}\n.metric-change.positive { color: var(--green); }\n.metric-change.negative { color: var(--red); }\n\n/* 圆环图自适应 */\n.donut-chart-wrapper { flex-wrap: wrap; }\n.donut-chart-wrapper svg { max-width: 220px; }\n.donut-legend { flex: 1; min-width: 130px; }\n@media (max-width: 480px) {\n  .donut-chart-wrapper { flex-direction: column; gap: 16px !important; }\n  .donut-chart-wrapper svg { max-width: 160px; }\n  .donut-legend { min-width: 100%; }\n}\n\n/* 响应式 */\n@media (max-width: 1024px) {\n  .sidebar { width: 220px; }\n  .agents-grid { grid-template-columns: 1fr; }\n}\n@media (max-width: 768px) {\n  .app { flex-direction: column; }\n  .sidebar {\n    width: 100%;\n    height: auto;\n    flex-direction: row;\n    overflow-x: auto;\n  }\n  .brand { padding: 12px 16px; }\n  .brand h1 { font-size: 16px; }\n  .nav {\n    display: flex;\n    padding: 8px;\n    overflow-x: auto;\n    flex-shrink: 0;\n  }\n  .nav-item {\n    flex-shrink: 0;\n    margin-bottom: 0;\n    margin-right: 8px;\n    min-height: 44px;\n    min-width: 44px;\n  }\n  button, .btn {\n    min-height: 44px;\n    min-width: 44px;\n    padding: 12px 16px;\n  }\n  .content { padding: 20px; }\n  .stats-grid { grid-template-columns: 1fr 1fr; }\n  .agent-stats { grid-template-columns: 1fr; }\n\n  /* 触摸优化 */\n  button:active, .btn:active {\n    transform: scale(0.97);\n    transition: transform 0.1s;\n  }\n  .nav-item:active {\n    transform: scale(0.95);\n  }\n\n  /* 更大的点击区域 */\n  .stat-card {\n    min-height: 100px;\n  }\n  .agent-card {\n    min-height: 120px;\n  }\n\n  /* 通知优化 */\n  .notification {\n    min-width: 260px;\n    max-width: calc(100vw - 40px);\n  }\n\n  /* 自动刷新指示器移动端 */\n  .auto-refresh-indicator {\n    bottom: 12px;\n    right: 12px;\n    font-size: 11px;\n    padding: 6px 12px;\n  }\n\n  /* 模态框优化 */\n  .modal-content {\n    width: 95vw;\n    max-width: none;\n    padding: 24px;\n  }\n}\n\n/* 触摸设备优化 */\n@media (hover: none) and (pointer: coarse) {\n  /* 移除hover效果，提高性能 */\n  * {\n    -webkit-tap-highlight-color: rgba(59, 130, 246, 0.3);\n  }\n\n  button:hover, .btn:hover, .nav-item:hover {\n    background: var(--surface2);\n  }\n\n  /* 禁用过渡动画，提高响应速度 */\n  .fast-mode * {\n    transition: none !important;\n    animation: none !important;\n  }\n}\n\n/* 小屏幕手机优化 */\n@media (max-width: 375px) {\n  .sidebar { padding: 8px; }\n  .brand { font-size: 14px; padding: 12px; }\n  .nav-item { padding: 10px 14px; font-size: 13px; }\n  .content { padding: 16px; }\n  .stats-grid { grid-template-columns: 1fr; }\n  button, .btn { font-size: 14px; }\n}\n</style>\n</head>\n<body>\n\n<!-- 通知容器 -->\n<div class=\"notification-container\" id=\"notification-container\"></div>\n\n<!-- 自动刷新指示器 -->\n<div class=\"auto-refresh-indicator\" id=\"auto-refresh-indicator\">\n  <i class=\"ti ti-refresh refresh-icon-ti\"></i>\n  <span id=\"refresh-status\">自动刷新: 10s</span>\n</div>\n\n<!-- 快捷键面板遮罩 -->\n<div class=\"panel-overlay\" id=\"shortcuts-overlay\"></div>\n\n<!-- 快捷键面板 -->\n<div class=\"shortcuts-panel\" id=\"shortcuts-panel\">\n  <h3><i class=\"ti ti-keyboard\"></i> 键盘快捷键</h3>\n  <div class=\"shortcut-item\">\n    <span class=\"shortcut-key\">1-5</span>\n    <span>切换页面</span>\n  </div>\n  <div class=\"shortcut-item\">\n    <span class=\"shortcut-key\">R</span>\n    <span>刷新当前页</span>\n  </div>\n  <div class=\"shortcut-item\">\n    <span class=\"shortcut-key\">H</span>\n    <span>显示/隐藏帮助</span>\n  </div>\n  <div class=\"shortcut-item\">\n    <span class=\"shortcut-key\">ESC</span>\n    <span>关闭面板</span>\n  </div>\n  <div style=\"margin-top: 20px; text-align: center;\">\n    <button class=\"btn btn-primary\" onclick=\"closeShortcutsPanel()\"><i class=\"ti ti-x\"></i> 关闭</button>\n  </div>\n</div>\n\n<div class=\"app\">\n  <!-- 侧边栏 -->\n  <aside class=\"sidebar\">\n    <div class=\"brand\">\n      <h1>∞ LoopCLI</h1>\n    </div>\n    <nav class=\"nav\">\n      <div class=\"nav-item active\" data-page=\"dashboard\">\n        <i class=\"ti ti-dashboard\"></i>\n        <span>主页</span>\n      </div>\n      <div class=\"nav-item\" data-page=\"agents\">\n        <i class=\"ti ti-robot\"></i>\n        <span>Agents</span>\n      </div>\n      <div class=\"nav-item\" data-page=\"tasks\">\n        <i class=\"ti ti-list-check\"></i>\n        <span>任务</span>\n      </div>\n      <div class=\"nav-item\" data-page=\"performance\">\n        <i class=\"ti ti-chart-bar\"></i>\n        <span>性能</span>\n      </div>\n      <div class=\"nav-item\" data-page=\"logs\">\n        <i class=\"ti ti-file-text\"></i>\n        <span>日志</span>\n      </div>\n      <div class=\"nav-item\" data-page=\"screenshots\">\n        <i class=\"ti ti-camera\"></i>\n        <span>截图</span>\n      </div>\n      <div class=\"nav-item\" data-page=\"settings\">\n        <i class=\"ti ti-settings\"></i>\n        <span>设置</span>\n      </div>\n    </nav>\n    <div class=\"sidebar-footer\">\n      <button class=\"theme-toggle\" id=\"theme-toggle\" title=\"切换主题\">\n        <i id=\"theme-icon\" class=\"ti ti-moon\"></i>\n      </button>\n      <button class=\"help-toggle\" id=\"help-toggle\" title=\"快捷键帮助\">\n        <i class=\"ti ti-help-circle\"></i>\n      </button>\n    </div>\n  </aside>\n\n  <!-- 主内容 -->\n  <main class=\"main\">\n    <div class=\"content\">\n      <!-- 主页 Dashboard -->\n      <div class=\"page active\" id=\"page-dashboard\">\n        <div class=\"page-header\">\n          <h2>系统概览</h2>\n          <p>LoopCLI 运行状态与关键指标</p>\n        </div>\n\n        <div class=\"stats-grid\">\n          <div class=\"stat-card\">\n            <div class=\"label\">总 Agents</div>\n            <div class=\"value\" id=\"total-agents\">-</div>\n          </div>\n          <div class=\"stat-card\">\n            <div class=\"label\">运行中</div>\n            <div class=\"value\" id=\"active-agents\">-</div>\n          </div>\n          <div class=\"stat-card\">\n            <div class=\"label\">总任务数</div>\n            <div class=\"value\" id=\"total-tasks\">-</div>\n          </div>\n          <div class=\"stat-card\">\n            <div class=\"label\">已完成</div>\n            <div class=\"value\" id=\"done-tasks\">-</div>\n          </div>\n        </div>\n\n        <!-- 长期任务卡片 -->\n        <div id=\"longtask-card\" style=\"background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(139, 92, 246, 0.1) 50%, rgba(16, 185, 129, 0.1) 100%); border: 2px solid var(--accent); border-radius: var(--radius); padding: 24px; margin-bottom: 32px; position: relative; overflow: hidden;\">\n          <div style=\"position: absolute; top: -50%; right: -50%; width: 200%; height: 200%; background: radial-gradient(circle, rgba(255,255,255,0.03) 0%, transparent 70%); pointer-events: none;\"></div>\n          <div style=\"display: flex; justify-content: space-between; align-items: flex-start; position: relative; z-index: 1;\">\n            <div style=\"flex: 1;\">\n              <div style=\"display: flex; align-items: center; gap: 12px; margin-bottom: 12px;\">\n                <span style=\"font-size: 24px;\"><i class=\"ti ti-target\"></i></span>\n                <h3 style=\"font-size: 20px; font-weight: 700; background: var(--accent-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;\">长期任务</h3>\n                <span id=\"longtask-badge\" style=\"display: none; background: var(--accent); color: white; font-size: 11px; padding: 2px 8px; border-radius: 10px; font-weight: 600;\">进行中</span>\n              </div>\n              <div id=\"longtask-display\" style=\"color: var(--text); line-height: 1.7; min-width: 0; overflow-wrap: break-word;\">\n                <div id=\"longtask-status-main\" style=\"font-size: 14px; color: var(--text2);\">加载中...</div>\n                <div id=\"longtask-content-main\" style=\"display: none; margin-top: 12px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 16px; font-family: monospace; font-size: 13px; white-space: pre-wrap; word-break: break-word; color: var(--text2); max-height: 300px; overflow-y: auto;\"></div>\n                <div id=\"longtask-edit-main\" style=\"display: none; margin-top: 12px;\">\n                  <textarea id=\"longtask-editor-main\" style=\"width: 100%; min-height: 120px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 12px; font-family: monospace; font-size: 13px; color: var(--text); resize: vertical;\" placeholder=\"输入长期任务内容...\"></textarea>\n                  <div style=\"display: flex; gap: 8px; margin-top: 8px;\">\n                    <button class=\"btn btn-primary\" onclick=\"saveLongTaskMain()\"><i class=\"ti ti-device-floppy\"></i> 保存</button>\n                    <button class=\"btn btn-secondary\" onclick=\"cancelEditLongTaskMain()\">取消</button>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div style=\"display: flex; gap: 8px;\">\n              <button class=\"btn btn-primary\" id=\"edit-longtask-btn-main\" onclick=\"startEditLongTaskMain()\" style=\"display: none;\"><i class=\"ti ti-pencil\"></i> 编辑</button>\n              <button class=\"btn btn-secondary\" id=\"cancel-longtask-btn-main\" onclick=\"cancelLongTaskMain()\" style=\"display: none;\"><i class=\"ti ti-x\"></i> 取消</button>\n            </div>\n          </div>\n        </div>\n\n        <!-- 用量统计面板 -->\n        <div id=\"usage-panel\" style=\"background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 28px; margin-bottom: 32px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);\">\n          <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;\">\n            <h3 style=\"font-size: 15px; font-weight: 700; color: var(--text2); display:flex; align-items:center; gap:8px;\"><span style=\"display:inline-block;width:4px;height:18px;background:linear-gradient(180deg,#f59e0b,#fbbf24);border-radius:2px;\"></span>用量统计</h3>\n            <span id=\"usage-refresh-time\" style=\"font-size: 12px; color: var(--text3);\">每5分钟刷新</span>\n          </div>\n          <div id=\"usage-content\" style=\"color: var(--text2); font-size: 14px;\">加载中...</div>\n        </div>\n\n        <!-- 可视化图表区域 -->\n        <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-bottom: 32px;\">\n          <div style=\"background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 28px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);\">\n            <h3 style=\"font-size: 15px; font-weight: 700; margin-bottom: 20px; color: var(--text2); display:flex; align-items:center; gap:8px;\"><span style=\"display:inline-block;width:4px;height:18px;background:linear-gradient(180deg,#6366f1,#8b5cf6);border-radius:2px;\"></span>Agent 状态分布</h3>\n            <div id=\"agent-status-chart\" style=\"display:flex;align-items:center;justify-content:center;min-height:200px;width:100%;\"></div>\n          </div>\n          <div style=\"background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 28px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);\">\n            <h3 style=\"font-size: 15px; font-weight: 700; margin-bottom: 20px; color: var(--text2); display:flex; align-items:center; gap:8px;\"><span style=\"display:inline-block;width:4px;height:18px;background:linear-gradient(180deg,#10b981,#34d399);border-radius:2px;\"></span>任务完成进度</h3>\n            <div id=\"task-progress-chart\" style=\"min-height:200px;\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Agents 页面 -->\n      <div class=\"page\" id=\"page-agents\">\n        <div class=\"page-header\">\n          <h2>Agent 控制台</h2>\n          <p>管理和监控所有 Agent</p>\n        </div>\n\n        <div class=\"action-bar\" style=\"display: flex; gap: 12px; margin-bottom: 20px;\">\n          <button class=\"btn btn-primary\" id=\"create-agent-btn\" onclick=\"showCreateAgentModal()\" style=\"display: flex; align-items: center; gap: 8px;\">\n            <i class=\"ti ti-plus\"></i>\n            <span>创建 Agent</span>\n          </button>\n          <button class=\"btn btn-secondary\" id=\"refresh-btn\" onclick=\"refreshAgents()\" style=\"display: flex; align-items: center; gap: 8px;\">\n            <i class=\"ti ti-refresh\"></i>\n            <span>刷新</span>\n          </button>\n        </div>\n\n        <div class=\"search-bar\" style=\"display: flex; gap: 12px; align-items: center; position: relative;\">\n          <i class=\"ti ti-search\" style=\"position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text2); z-index: 1;\"></i>\n          <input type=\"text\" class=\"search-input\" id=\"agent-search\" placeholder=\"搜索 Agent (按名称、ID 或状态)...\" style=\"flex: 1; min-width: 0;\">\n          <button class=\"btn btn-secondary\" id=\"export-btn\" onclick=\"exportAgentsData()\" style=\"flex-shrink: 0; white-space: nowrap;\">\n            <i class=\"ti ti-download\"></i> 导出\n          </button>\n        </div>\n\n        <div class=\"agents-grid\" id=\"agents-grid\">\n          <div class=\"loading\">\n            <div class=\"spinner\"></div>\n            <div>加载 Agents...</div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Tasks 页面 -->\n      <div class=\"page\" id=\"page-tasks\">\n        <div class=\"page-header\">\n          <h2>任务管理</h2>\n          <p>查看和管理所有任务</p>\n        </div>\n\n        <div class=\"tasks-table-container\">\n          <table class=\"tasks-table\">\n            <thead>\n              <tr>\n                <th>ID</th>\n                <th>标题</th>\n                <th>状态</th>\n                <th>Agent</th>\n                <th>创建时间</th>\n              </tr>\n            </thead>\n            <tbody id=\"tasks-table-body\">\n              <tr>\n                <td colspan=\"5\" style=\"text-align: center; color: var(--text2);\">加载中...</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      <!-- Performance 页面 -->\n      <div class=\"page\" id=\"page-performance\">\n        <div class=\"page-header\">\n          <h2>性能监控</h2>\n          <p>系统性能指标和趋势分析</p>\n        </div>\n\n        <div class=\"performance-grid\">\n          <div class=\"performance-card\">\n            <h4>CPU 使用率</h4>\n            <div class=\"metric-value\" id=\"cpu-usage\">-%</div>\n            <div class=\"metric-change\" id=\"cpu-change\">-</div>\n          </div>\n          <div class=\"performance-card\">\n            <h4>内存使用</h4>\n            <div class=\"metric-value\" id=\"memory-usage\">- MB</div>\n            <div class=\"metric-change\" id=\"mem-change\">-</div>\n          </div>\n          <div class=\"performance-card\">\n            <h4>响应时间</h4>\n            <div class=\"metric-value\" id=\"response-time\">- ms</div>\n            <div class=\"metric-change\" id=\"resp-change\">-</div>\n          </div>\n          <div class=\"performance-card\">\n            <h4>Token 消耗</h4>\n            <div class=\"metric-value\" id=\"token-usage\">-</div>\n            <div class=\"metric-change\" id=\"token-change\">本月累计</div>\n          </div>\n        </div>\n\n        <!-- Token 趋势图 -->\n        <div style=\"background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; margin-bottom: 32px;\">\n          <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;\">\n            <h3 style=\"font-size: 16px; font-weight: 600; color: var(--text2);\">Token 消耗趋势（最近7天）</h3>\n            <span id=\"token-trend-summary\" style=\"font-size: 13px; color: var(--text2);\"></span>\n          </div>\n          <canvas id=\"token-trend-chart\" width=\"800\" height=\"250\"></canvas>\n        </div>\n\n        <div class=\"settings-section\">\n          <h3>性能建议</h3>\n          <div id=\"performance-suggestions\">\n            <div class=\"setting-item\">\n              <div class=\"setting-label\">\n                <div class=\"title\">启用 Agent 缓存</div>\n                <div class=\"description\">缓存频繁访问的 Agent 数据，减少 API 调用</div>\n              </div>\n              <label class=\"switch\">\n                <input type=\"checkbox\" checked>\n                <span class=\"switch-slider\"></span>\n              </label>\n            </div>\n            <div class=\"setting-item\">\n              <div class=\"setting-label\">\n                <div class=\"title\">自动优化</div>\n                <div class=\"description\">自动清理空闲资源和优化配置</div>\n              </div>\n              <label class=\"switch\">\n                <input type=\"checkbox\">\n                <span class=\"switch-slider\"></span>\n              </label>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Logs 页面 -->\n      <div class=\"page\" id=\"page-logs\">\n        <div class=\"page-header\">\n          <h2>系统日志</h2>\n          <p>实时查看系统运行日志</p>\n        </div>\n\n        <div class=\"logs-container\">\n          <div class=\"logs-header\">\n            <span>最新日志</span>\n            <button class=\"btn btn-secondary\" onclick=\"clearLogs()\"><i class=\"ti ti-trash\"></i> 清空</button>\n          </div>\n          <div class=\"logs-content\" id=\"logs-content\">\n            <div class=\"loading\">\n              <div class=\"spinner\"></div>\n              <div>加载日志...</div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Screenshots 页面 -->\n      <div class=\"page\" id=\"page-screenshots\">\n        <div class=\"page-header\">\n          <h2>测试截图</h2>\n          <p>Playwright 测试截图预览</p>\n        </div>\n\n        <div class=\"card\">\n          <div class=\"card-header\">\n            <h3>最新截图</h3>\n            <button class=\"btn btn-secondary\" onclick=\"loadScreenshots()\" style=\"margin-left: auto;\"><i class=\"ti ti-refresh\"></i> 刷新</button>\n          </div>\n          <div class=\"card-body\">\n            <div id=\"screenshots-grid\" style=\"display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px;\">\n              <div style=\"grid-column: 1/-1; text-align: center; color: var(--text2); padding: 40px;\">\n            加载中...\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Settings 页面 -->\n      <div class=\"page\" id=\"page-settings\">\n        <div class=\"page-header\">\n          <h2>系统设置</h2>\n          <p>配置系统参数和偏好</p>\n        </div>\n\n        <div class=\"settings-section\">\n          <h3>主题设置</h3>\n          <div class=\"setting-item\">\n            <div class=\"setting-label\">\n              <div class=\"title\">颜色主题</div>\n              <div class=\"description\">选择界面主题风格</div>\n            </div>\n            <div class=\"setting-control\">\n              <select id=\"theme-selector\" style=\"padding: 8px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface2); color: var(--text); font-size: 13px;\">\n                <option value=\"dark\">深色主题</option>\n                <option value=\"light\">浅色主题</option>\n                <option value=\"cyberpunk\">赛博朋克</option>\n              </select>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"settings-section\">\n          <h3>界面设置</h3>\n          <div class=\"setting-item\">\n            <div class=\"setting-label\">\n              <div class=\"title\">自动刷新</div>\n              <div class=\"description\">自动刷新数据间隔（秒）</div>\n            </div>\n            <div class=\"setting-control\">\n              <input type=\"number\" id=\"refresh-interval\" value=\"10\" min=\"1\" max=\"60\"\n                     style=\"width: 80px; padding: 8px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface2); color: var(--text);\">\n            </div>\n          </div>\n          <div class=\"setting-item\">\n            <div class=\"setting-label\">\n              <div class=\"title\">紧凑模式</div>\n              <div class=\"description\">减少间距，显示更多内容</div>\n            </div>\n            <label class=\"switch\">\n              <input type=\"checkbox\" id=\"compact-mode\">\n              <span class=\"switch-slider\"></span>\n            </label>\n          </div>\n        </div>\n\n        <div class=\"settings-section\">\n          <h3>通知设置</h3>\n          <div class=\"setting-item\">\n            <div class=\"setting-label\">\n              <div class=\"title\">启用通知</div>\n              <div class=\"description\">显示系统通知和警告</div>\n            </div>\n            <label class=\"switch\">\n              <input type=\"checkbox\" id=\"enable-notifications\" checked>\n              <span class=\"switch-slider\"></span>\n            </label>\n          </div>\n          <div class=\"setting-item\">\n            <div class=\"setting-label\">\n              <div class=\"title\">声音提醒</div>\n              <div class=\"description\">重要事件时播放提示音</div>\n            </div>\n            <label class=\"switch\">\n              <input type=\"checkbox\" id=\"sound-notifications\">\n              <span class=\"switch-slider\"></span>\n            </label>\n          </div>\n        </div>\n\n        <div class=\"settings-section\">\n          <h3>系统信息</h3>\n          <div class=\"setting-item\">\n            <div class=\"setting-label\">\n              <div class=\"title\">WebUI 版本</div>\n              <div class=\"description\">v8.6 - 深度优化：搜索栏修复、响应式改进、通知位置优化、结构修复</div>\n            </div>\n          </div>\n          <div class=\"setting-item\">\n            <div class=\"setting-label\">\n              <div class=\"title\">服务器状态</div>\n              <div class=\"description\" id=\"server-status\">检测中...</div>\n            </div>\n          </div>\n          <div class=\"setting-item\">\n            <div class=\"setting-label\">\n              <div class=\"title\">服务器运行时间</div>\n              <div class=\"description\" id=\"server-uptime\">-</div>\n            </div>\n          </div>\n          <div class=\"setting-item\">\n            <div class=\"setting-label\">\n              <div class=\"title\">Agent 统计</div>\n              <div class=\"description\" id=\"agent-stats\">-</div>\n            </div>\n          </div>\n          <div class=\"setting-item\" id=\"sys-resource-item\" style=\"display:none\">\n            <div class=\"setting-label\">\n              <div class=\"title\">系统资源</div>\n              <div class=\"description\" id=\"sys-resource\">-</div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"settings-section\">\n          <h3>长期任务</h3>\n          <div class=\"setting-item\">\n            <div class=\"setting-label\">\n              <div class=\"title\">当前长期任务</div>\n              <div class=\"description\" id=\"longtask-status\">加载中...</div>\n            </div>\n            <div class=\"setting-control\">\n              <button class=\"btn btn-secondary\" id=\"edit-longtask-btn\" onclick=\"startEditLongTask()\" style=\"display: none;\">\n                <i class=\"ti ti-pencil\"></i> 编辑\n              </button>\n              <button class=\"btn btn-secondary\" id=\"cancel-longtask-btn\" onclick=\"cancelLongTask()\" style=\"display: none;\">\n                <i class=\"ti ti-x\"></i> 取消任务\n              </button>\n            </div>\n          </div>\n          <div id=\"longtask-content\" style=\"display: none; margin-top: 16px;\">\n            <div style=\"background: var(--surface2); border: 1px solid var(--border); border-radius: 8px; padding: 16px; font-family: monospace; font-size: 13px; white-space: pre-wrap; color: var(--text2); max-height: 200px; overflow-y: auto;\" id=\"longtask-text\"></div>\n          </div>\n          <div id=\"longtask-edit\" style=\"display: none; margin-top: 16px;\">\n            <textarea id=\"longtask-editor\" style=\"width: 100%; min-height: 120px; background: var(--surface2); border: 1px solid var(--border); border-radius: 8px; padding: 12px; font-family: monospace; font-size: 13px; color: var(--text); resize: vertical;\" placeholder=\"输入长期任务内容...\"></textarea>\n            <div style=\"display: flex; gap: 8px; margin-top: 8px;\">\n              <button class=\"btn btn-primary\" onclick=\"saveLongTask()\"><i class=\"ti ti-device-floppy\"></i> 保存</button>\n              <button class=\"btn btn-secondary\" onclick=\"cancelEditLongTask()\">取消</button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </main>\n</div>\n\n<script>\n// API 基础 URL\nconst API_BASE = '/api';\n\n// 通知系统\nfunction showNotification(message, type = 'info', duration = 5000) {\n  const container = document.getElementById('notification-container');\n  if (!container) return;\n\n  const icons = {\n    success: '<i class=\"ti ti-check\" style=\"font-size:18px\"></i>',\n    info: '<i class=\"ti ti-info-circle\" style=\"font-size:18px\"></i>',\n    warning: '<i class=\"ti ti-alert-triangle\" style=\"font-size:18px\"></i>',\n    error: '<i class=\"ti ti-x\" style=\"font-size:18px\"></i>'\n  };\n\n  const notification = document.createElement('div');\n  notification.className = `notification ${type}`;\n  notification.innerHTML = `\n    <span class=\"notification-icon\">${icons[type] || icons.info}</span>\n    <span class=\"notification-message\">${message}</span>\n    <span class=\"notification-close\" onclick=\"this.parentElement.remove()\"><i class=\"ti ti-x\" style=\"font-size:14px\"></i></span>\n  `;\n\n  container.appendChild(notification);\n\n  // 最多显示3条通知\n  while (container.children.length > 3) {\n    container.firstChild.remove();\n  }\n\n  setTimeout(() => {\n    if (notification.parentElement) {\n      notification.remove();\n    }\n  }, duration);\n}\n\n// 主题管理\nconst themes = ['dark', 'light', 'cyberpunk'];\nlet currentThemeIndex = 0;\n\nfunction initTheme() {\n  const savedTheme = localStorage.getItem('webui_theme') || 'dark';\n  currentThemeIndex = themes.indexOf(savedTheme);\n  if (currentThemeIndex === -1) currentThemeIndex = 0;\n  applyTheme(themes[currentThemeIndex]);\n}\n\nfunction applyTheme(theme) {\n  if (theme === 'dark') {\n    document.documentElement.removeAttribute('data-theme');\n  } else {\n    document.documentElement.setAttribute('data-theme', theme);\n  }\n  localStorage.setItem('webui_theme', theme);\n  updateThemeIcon(theme);\n}\n\nfunction cycleTheme() {\n  currentThemeIndex = (currentThemeIndex + 1) % themes.length;\n  applyTheme(themes[currentThemeIndex]);\n}\n\nfunction updateThemeIcon(theme) {\n  const icon = document.getElementById('theme-icon');\n  if (icon) {\n    const icons = { dark: 'ti ti-moon', light: 'ti ti-sun', cyberpunk: 'ti ti-palette' };\n    icon.className = icons[theme] || 'ti ti-moon';\n  }\n}\n\n// 快捷键面板\nfunction openShortcutsPanel() {\n  document.getElementById('shortcuts-panel').classList.add('active');\n  document.getElementById('shortcuts-overlay').classList.add('active');\n}\n\nfunction closeShortcutsPanel() {\n  document.getElementById('shortcuts-panel').classList.remove('active');\n  document.getElementById('shortcuts-overlay').classList.remove('active');\n}\n\n// 搜索功能\nfunction initSearch() {\n  const searchInput = document.getElementById('agent-search');\n  if (!searchInput) return;\n\n  searchInput.addEventListener('input', (e) => {\n    const query = e.target.value.toLowerCase();\n    const cards = document.querySelectorAll('.agent-card');\n\n    cards.forEach(card => {\n      const name = card.querySelector('.agent-name')?.textContent.toLowerCase() || '';\n      const id = card.querySelector('.agent-id')?.textContent.toLowerCase() || '';\n      const status = card.querySelector('.status-badge')?.textContent.toLowerCase() || '';\n\n      const matches = name.includes(query) || id.includes(query) || status.includes(query);\n      card.style.display = matches ? '' : 'none';\n    });\n  });\n}\n\n// 自动刷新指示器\nfunction updateRefreshIndicator(active, interval) {\n  const indicator = document.getElementById('auto-refresh-indicator');\n  const status = document.getElementById('refresh-status');\n  if (indicator && status) {\n    indicator.classList.toggle('active', active);\n    status.textContent = active ? `自动刷新: ${interval/1000}s` : '已暂停';\n  }\n}\n\n// 页面导航\nfunction navigateTo(pageId) {\n  // 更新导航状态\n  document.querySelectorAll('.nav-item').forEach(item => {\n    item.classList.remove('active');\n    if (item.dataset.page === pageId) {\n      item.classList.add('active');\n    }\n  });\n\n  // 更新页面显示\n  document.querySelectorAll('.page').forEach(page => {\n    page.classList.remove('active');\n  });\n  const targetPage = document.getElementById(`page-${pageId}`);\n  if (targetPage) {\n    targetPage.classList.add('active');\n  }\n\n  // 加载页面数据\n  loadPageData(pageId);\n}\n\n// 加载页面数据\nasync function loadPageData(pageId) {\n  switch (pageId) {\n    case 'dashboard':\n      await loadDashboard();\n      break;\n    case 'agents':\n      await loadAgents();\n      break;\n    case 'tasks':\n      await loadTasks();\n      break;\n    case 'performance':\n      await loadPerformance();\n      break;\n    case 'logs':\n      await loadLogs();\n      break;\n    case 'screenshots':\n      await loadScreenshots();\n      break;\n    case 'settings':\n      loadSettings();\n      break;\n  }\n}\n\n// 获取 agents 数据\nasync function fetchAgents() {\n  try {\n    const response = await fetch(`${API_BASE}/agents`);\n    if (!response.ok) throw new Error('API 请求失败');\n    return await response.json();\n  } catch (error) {\n    console.error('获取 agents 失败:', error);\n    return [];\n  }\n}\n\n// 导出 Agents 数据\nasync function exportAgentsData() {\n  try {\n    const agents = await fetchAgents();\n    const dataStr = JSON.stringify(agents, null, 2);\n    const blob = new Blob([dataStr], { type: 'application/json' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement('a');\n    a.href = url;\n    a.download = `loopcli_agents_${new Date().toISOString().slice(0, 10)}.json`;\n    document.body.appendChild(a);\n    a.click();\n    document.body.removeChild(a);\n    URL.revokeObjectURL(url);\n    showNotification('数据导出成功', 'success');\n  } catch (error) {\n    console.error('导出失败:', error);\n    showNotification('导出失败', 'error');\n  }\n}\n\n// 创建 Agent 模态框\nasync function showCreateAgentModal() {\n  showNotification('正在加载模板...', 'info');\n\n  try {\n    // 获取模板列表\n    const response = await fetch(`${API_BASE}/templates`);\n    if (!response.ok) throw new Error('获取模板失败');\n    const templates = await response.json();\n\n    const modal = document.createElement('div');\n    modal.id = 'create-agent-modal';\n    modal.style.cssText = `\n      position: fixed; inset: 0; background: rgba(0, 0, 0, 0.7);\n      display: flex; align-items: center; justify-content: center;\n      z-index: 10000; animation: fadeIn 0.2s ease;\n    `;\n\n    // 按类别组织模板\n    const templatesByCategory = {};\n    templates.forEach(t => {\n      if (!templatesByCategory[t.category]) {\n        templatesByCategory[t.category] = [];\n      }\n      templatesByCategory[t.category].push(t);\n    });\n\n    // 生成模板选择HTML\n    let templatesHTML = '';\n    for (const [category, items] of Object.entries(templatesByCategory)) {\n      templatesHTML += `\n        <div style=\"margin-bottom: 20px;\">\n          <div style=\"font-size: 14px; font-weight: 600; color: var(--accent); margin-bottom: 12px; text-transform: capitalize;\">\n            ${category}\n          </div>\n          <div style=\"display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px;\">\n            ${items.map(t => `\n              <label class=\"template-option\" style=\"\n                display: flex; align-items: center; gap: 8px; padding: 12px;\n                background: var(--surface2); border: 1px solid var(--border);\n                border-radius: 8px; cursor: pointer; transition: all 0.2s;\n              \">\n                <input type=\"radio\" name=\"agent-template\" value=\"${t.id}\" style=\"margin: 0;\">\n                <div style=\"flex: 1;\">\n                  <div style=\"font-size: 13px; font-weight: 500; color: var(--text);\">${t.id}</div>\n                  <div style=\"font-size: 11px; color: var(--text3);\">${t.description || t.id}</div>\n                </div>\n              </label>\n            `).join('')}\n          </div>\n        </div>\n      `;\n    }\n\n    modal.innerHTML = `\n      <div style=\"\n        background: var(--surface); border: 1px solid var(--border);\n        border-radius: var(--radius); padding: 32px;\n        width: 700px; max-width: 90vw; max-height: 80vh; overflow-y: auto;\n        box-shadow: var(--shadow);\n      \">\n        <h3 style=\"font-size: 20px; font-weight: 700; margin-bottom: 8px; color: var(--text);\">\n          创建新 Agent\n        </h3>\n        <p style=\"font-size: 13px; color: var(--text2); margin-bottom: 24px;\">\n          从模板创建一个新的 Agent\n        </p>\n\n        <div style=\"margin-bottom: 24px;\">\n          <label style=\"display: block; font-size: 13px; color: var(--text2); margin-bottom: 8px;\">\n            Agent 名称 (可选)\n          </label>\n          <input type=\"text\" id=\"new-agent-name\" placeholder=\"留空使用模板名称\" style=\"\n            width: 100%; padding: 12px 16px; background: var(--surface2);\n            border: 1px solid var(--border); border-radius: 8px;\n            color: var(--text); font-size: 14px;\n          \">\n        </div>\n\n        <div style=\"margin-bottom: 24px;\">\n          <label style=\"display: block; font-size: 13px; color: var(--text2); margin-bottom: 12px;\">\n            选择模板\n          </label>\n          <div style=\"max-height: 400px; overflow-y: auto; padding-right: 8px;\">\n            ${templatesHTML || '<div style=\"color: var(--text2); text-align: center; padding: 20px;\">暂无可用模板</div>'}\n          </div>\n        </div>\n\n        <div style=\"display: flex; gap: 12px; justify-content: flex-end; padding-top: 16px; border-top: 1px solid var(--border);\">\n          <button onclick=\"closeCreateAgentModal()\" class=\"btn btn-secondary\"><i class=\"ti ti-x\"></i> 取消</button>\n          <button onclick=\"createNewAgent()\" class=\"btn btn-primary\"><i class=\"ti ti-plus\"></i> 创建</button>\n        </div>\n      </div>\n\n      <style>\n        .template-option:hover { background: var(--border) !important; }\n        .template-option input:checked + div { color: var(--accent); }\n      </style>\n    `;\n\n    modal.addEventListener('click', (e) => {\n      if (e.target === modal) closeCreateAgentModal();\n    });\n\n    document.body.appendChild(modal);\n\n  } catch (error) {\n    console.error('加载模板失败:', error);\n    showNotification('加载模板失败: ' + error.message, 'error');\n  }\n}\n\nfunction closeCreateAgentModal() {\n  const modal = document.getElementById('create-agent-modal');\n  if (modal) {\n    modal.style.animation = 'fadeOut 0.2s ease';\n    setTimeout(() => modal.remove(), 200);\n  }\n}\n\nasync function createNewAgent() {\n  const customName = document.getElementById('new-agent-name')?.value.trim() || '';\n  const selectedTemplate = document.querySelector('input[name=\"agent-template\"]:checked');\n\n  if (!selectedTemplate) {\n    showNotification('请选择一个模板', 'warning');\n    return;\n  }\n\n  const templateId = selectedTemplate.value;\n\n  try {\n    showNotification('正在创建 Agent...', 'info');\n\n    const response = await fetch(`${API_BASE}/agents/create`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({\n        template: templateId,\n        name: customName || null,\n        task: ''\n      })\n    });\n\n    if (!response.ok) {\n      const errorData = await response.json();\n      throw new Error(errorData.error || '创建失败');\n    }\n\n    const data = await response.json();\n    showNotification(`Agent \"${data.name || templateId}\" 创建成功！`, 'success');\n    closeCreateAgentModal();\n\n    // 刷新 Agent 列表\n    await loadAgents();\n\n  } catch (error) {\n    console.error('创建 Agent 失败:', error);\n    showNotification('创建失败: ' + error.message, 'error');\n  }\n}\n\nasync function refreshAgents() {\n  showNotification('正在刷新...', 'info');\n  await loadAgents();\n  showNotification('刷新成功', 'success');\n}\n\n// SVG 圆环图（自适应版）\nfunction drawDonutChart(containerId, data, colors) {\n  const container = document.getElementById(containerId);\n  if (!container) return;\n  const total = data.reduce((s, d) => s + d.value, 0);\n  if (total === 0) { container.innerHTML = '<span style=\"color:var(--text3)\">暂无数据</span>'; return; }\n\n  const size = 160, cx = 80, cy = 80, r = 58, stroke = 18;\n  const circumference = 2 * Math.PI * r;\n  let offset = 0;\n  const gapAngle = data.filter(d => d.value > 0).length > 1 ? 3 : 0;\n\n  let arcs = data.map((item, i) => {\n    if (item.value === 0) return '';\n    const pct = item.value / total;\n    const dash = Math.max(0, circumference * pct - gapAngle);\n    const gap = circumference - dash;\n    const color = colors[i % colors.length];\n    const html = `<circle cx=\"${cx}\" cy=\"${cy}\" r=\"${r}\" fill=\"none\" stroke=\"${color}\" stroke-width=\"${stroke}\" stroke-dasharray=\"${dash} ${gap}\" stroke-dashoffset=\"${-offset}\" stroke-linecap=\"round\" transform=\"rotate(-90 ${cx} ${cy})\" style=\"transition:all .6s cubic-bezier(.4,0,.2,1);filter:drop-shadow(0 0 6px ${color}40);\"/>`;\n    offset += dash + gapAngle;\n    return html;\n  }).join('');\n\n  const svg = `<svg viewBox=\"0 0 ${size} ${size}\" style=\"width:100%;height:auto;max-width:220px;filter:drop-shadow(0 4px 12px rgba(0,0,0,0.15));\">${arcs}<text x=\"${cx}\" y=\"${cy - 8}\" text-anchor=\"middle\" fill=\"var(--text)\" font-size=\"28\" font-weight=\"800\" font-family=\"system-ui,sans-serif\">${total}</text><text x=\"${cx}\" y=\"${cy + 14}\" text-anchor=\"middle\" fill=\"var(--text3)\" font-size=\"11\" font-family=\"system-ui,sans-serif\">总计</text></svg>`;\n\n  const legend = data.filter(d => d.value > 0).map((item, i) => {\n    const origIdx = data.indexOf(item);\n    const color = colors[origIdx % colors.length];\n    const pct = Math.round(item.value / total * 100);\n    return `<div class=\"donut-legend-item\" style=\"display:flex;align-items:center;gap:10px;padding:6px 0;\">\n      <span style=\"width:12px;height:12px;border-radius:3px;background:${color};flex-shrink:0;box-shadow:0 2px 6px ${color}40;\"></span>\n      <span style=\"font-size:14px;color:var(--text2);min-width:50px;\">${item.label}</span>\n      <span style=\"font-size:14px;font-weight:700;color:var(--text);margin-left:auto;\">${item.value}</span>\n      <span style=\"font-size:11px;color:var(--text3);min-width:36px;text-align:right;\">${pct}%</span>\n    </div>`;\n  }).join('');\n\n  container.innerHTML = `<div class=\"donut-chart-wrapper\" style=\"display:flex;align-items:center;justify-content:center;gap:28px;flex-wrap:wrap;\">${svg}<div class=\"donut-legend\" style=\"min-width:130px;\">${legend}</div></div>`;\n}\n\n// 进度条列表（美化版）\nfunction drawProgressBars(containerId, data, maxBar) {\n  const container = document.getElementById(containerId);\n  if (!container) return;\n  if (!data || data.length === 0) { container.innerHTML = '<div style=\"color:var(--text3);text-align:center;padding:20px;\">暂无数据</div>'; return; }\n  const maxVal = maxBar || Math.max(...data.map(d => d.value), 1);\n  const barColors = ['#6366f1','#8b5cf6','#a78bfa','#c4b5fd','#7c3aed','#5b21b6'];\n  container.innerHTML = data.map((item, idx) => {\n    const pct = Math.round((item.value / maxVal) * 100);\n    const color = barColors[idx % barColors.length];\n    return `<div style=\"margin-bottom:14px;padding:10px 14px;background:var(--surface2);border-radius:10px;transition:transform .2s ease;\">\n      <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;\">\n        <span style=\"color:var(--text);font-size:13px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;max-width:60%;\">${item.label}</span>\n        <span style=\"color:${color};font-weight:700;font-size:14px;flex-shrink:0;\">${pct}%</span>\n      </div>\n      <div style=\"height:6px;background:rgba(128,128,128,0.15);border-radius:3px;overflow:hidden;\">\n        <div style=\"height:100%;width:${pct}%;background:linear-gradient(90deg,${color},${color}cc);border-radius:3px;transition:width .6s cubic-bezier(.4,0,.2,1);box-shadow:0 0 8px ${color}40;\"></div>\n      </div>\n    </div>`;\n  }).join('');\n}\n\n// 绘制折线趋势图\nfunction drawLineChart(canvasId, data, color) {\n  const canvas = document.getElementById(canvasId);\n  if (!canvas) return;\n  const ctx = canvas.getContext('2d');\n  const rect = canvas.getBoundingClientRect();\n  canvas.width = rect.width * 2;\n  canvas.height = rect.height * 2;\n  ctx.scale(2, 2);\n\n  const padding = 40;\n  const chartWidth = canvas.width / 2 - padding * 2;\n  const chartHeight = canvas.height / 2 - padding * 2;\n\n  ctx.clearRect(0, 0, canvas.width, canvas.height);\n\n  const maxValue = Math.max(...data.map(d => d.value)) * 1.1;\n  const minValue = 0;\n  const range = maxValue - minValue;\n\n  const theme = document.documentElement.dataset.theme || 'dark';\n  const gridColor = theme === 'light' ? '#e5e7eb' : '#374151';\n  const textColor = theme === 'light' ? '#374151' : '#9ca3af';\n\n  // 绘制网格线\n  ctx.strokeStyle = gridColor;\n  ctx.lineWidth = 1;\n  for (let i = 0; i <= 5; i++) {\n    const y = padding + (chartHeight / 5) * i;\n    ctx.beginPath();\n    ctx.moveTo(padding, y);\n    ctx.lineTo(padding + chartWidth, y);\n    ctx.stroke();\n\n    const value = Math.round(maxValue - (range / 5) * i);\n    ctx.fillStyle = textColor;\n    ctx.font = '11px sans-serif';\n    ctx.textAlign = 'right';\n    ctx.fillText(value.toLocaleString(), padding - 8, y + 4);\n  }\n\n  if (data.length < 2) return;\n\n  const stepX = chartWidth / (data.length - 1);\n  const points = data.map((d, i) => ({\n    x: padding + i * stepX,\n    y: padding + chartHeight - ((d.value - minValue) / range) * chartHeight\n  }));\n\n  // 绘制渐变填充\n  const gradient = ctx.createLinearGradient(0, padding, 0, padding + chartHeight);\n  gradient.addColorStop(0, color + '40');\n  gradient.addColorStop(1, color + '00');\n\n  ctx.beginPath();\n  ctx.moveTo(points[0].x, padding + chartHeight);\n  points.forEach(p => ctx.lineTo(p.x, p.y));\n  ctx.lineTo(points[points.length - 1].x, padding + chartHeight);\n  ctx.closePath();\n  ctx.fillStyle = gradient;\n  ctx.fill();\n\n  // 绘制线条\n  ctx.beginPath();\n  ctx.moveTo(points[0].x, points[0].y);\n  points.forEach(p => ctx.lineTo(p.x, p.y));\n  ctx.strokeStyle = color;\n  ctx.lineWidth = 2;\n  ctx.stroke();\n\n  // 绘制数据点和标签\n  points.forEach((p, i) => {\n    ctx.beginPath();\n    ctx.arc(p.x, p.y, 4, 0, Math.PI * 2);\n    ctx.fillStyle = color;\n    ctx.fill();\n    ctx.strokeStyle = theme === 'light' ? '#ffffff' : '#1f2937';\n    ctx.lineWidth = 2;\n    ctx.stroke();\n\n    // X轴标签\n    ctx.fillStyle = textColor;\n    ctx.font = '11px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(data[i].label, p.x, padding + chartHeight + 20);\n  });\n}\n\n// 加载 Agents 页面\nasync function loadAgents() {\n  const agents = await fetchAgents();\n\n  // 按 run_count 降序排序\n  agents.sort((a, b) => (b.run_count || 0) - (a.run_count || 0));\n\n  // 更新统计（主页和Agent页共享的统计卡片）\n  const total = agents.length;\n  const active = agents.filter(a => a.status !== 'disabled').length;\n  const totalTasks = agents.reduce((sum, a) => sum + (a.task_count || 0), 0);\n  const doneTasks = agents.reduce((sum, a) => sum + (a.task_done || 0), 0);\n\n  const totalEl = document.getElementById('total-agents');\n  const activeEl = document.getElementById('active-agents');\n  const totalTasksEl = document.getElementById('total-tasks');\n  const doneTasksEl = document.getElementById('done-tasks');\n  if (totalEl) totalEl.textContent = total;\n  if (activeEl) activeEl.textContent = active;\n  if (totalTasksEl) totalTasksEl.textContent = totalTasks;\n  if (doneTasksEl) doneTasksEl.textContent = doneTasks;\n\n  // 渲染 agent cards\n  const grid = document.getElementById('agents-grid');\n  if (agents.length === 0) {\n    grid.innerHTML = '<div class=\"loading\"><div>暂无 Agents</div></div>';\n    return;\n  }\n\n  grid.innerHTML = agents.map(agent => {\n    const progress = agent.task_count > 0\n      ? Math.round((agent.task_done / agent.task_count) * 100)\n      : 0;\n\n    return `\n      <div class=\"agent-card\" data-id=\"${agent.id}\">\n        <div class=\"agent-header\">\n          <div>\n            <div class=\"agent-name\">${agent.name}</div>\n            <div class=\"agent-id\">${agent.id}</div>\n          </div>\n          <span class=\"status-badge ${agent.status}\">\n            <span class=\"status-dot\"></span>\n            <span>${agent.status === 'disabled' ? '已禁用' : agent.status === 'idle' ? '空闲' : agent.status === 'active' ? '运行中' : agent.status}</span>\n          </span>\n        </div>\n\n        <div class=\"agent-description\">\n          ${agent.description || '暂无描述'}\n        </div>\n\n        <div class=\"agent-stats\">\n          <div class=\"agent-stat\">\n            <span class=\"label\">运行次数:</span>\n            <span class=\"value\">${agent.run_count || 0}</span>\n          </div>\n          <div class=\"agent-stat\">\n            <span class=\"label\">最后运行:</span>\n            <span class=\"value\">${agent.last_run || '从未'}</span>\n          </div>\n          <div class=\"agent-stat\">\n            <span class=\"label\">任务:</span>\n            <span class=\"value\">${agent.task_done}/${agent.task_count}</span>\n          </div>\n          <div class=\"agent-stat\">\n            <span class=\"label\">当前任务:</span>\n            <span class=\"value\">${agent.current_task || '无'}</span>\n          </div>\n          ${agent.task_count > 0 ? `\n          <div class=\"task-progress\">\n            <div class=\"task-progress-bar\">\n              <div class=\"task-progress-fill\" style=\"width: ${progress}%\"></div>\n            </div>\n          </div>\n          ` : ''}\n        </div>\n\n        <div class=\"agent-actions\">\n          <button class=\"btn btn-primary\" onclick=\"enableAgent('${agent.id}')\">\n            <i class=\"ti ti-player-play\"></i> 启用\n          </button>\n          <button class=\"btn btn-secondary\" onclick=\"disableAgent('${agent.id}')\">\n            <i class=\"ti ti-player-stop\"></i> 禁用\n          </button>\n        </div>\n      </div>\n    `;\n  }).join('');\n}\n\n// 加载主页 Dashboard\nasync function loadDashboard() {\n  const agents = await fetchAgents();\n  agents.sort((a, b) => (b.run_count || 0) - (a.run_count || 0));\n\n  // 更新统计\n  const total = agents.length;\n  const active = agents.filter(a => a.status !== 'disabled').length;\n  const totalTasks = agents.reduce((sum, a) => sum + (a.task_count || 0), 0);\n  const doneTasks = agents.reduce((sum, a) => sum + (a.task_done || 0), 0);\n\n  const totalEl = document.getElementById('total-agents');\n  const activeEl = document.getElementById('active-agents');\n  const totalTasksEl = document.getElementById('total-tasks');\n  const doneTasksEl = document.getElementById('done-tasks');\n  if (totalEl) totalEl.textContent = total;\n  if (activeEl) activeEl.textContent = active;\n  if (totalTasksEl) totalTasksEl.textContent = totalTasks;\n  if (doneTasksEl) doneTasksEl.textContent = doneTasks;\n\n  // 绘制圆环图\n  const statusCounts = {};\n  agents.forEach(a => {\n    statusCounts[a.status] = (statusCounts[a.status] || 0) + 1;\n  });\n  const statusData = Object.entries(statusCounts).map(([status, count]) => ({\n    label: status,\n    value: count\n  }));\n  const statusColors = ['#10b981', '#f59e0b', '#ef4444', '#3b82f6'];\n  drawDonutChart('agent-status-chart', statusData, statusColors);\n\n  // 任务进度\n  const taskData = agents\n    .filter(a => a.task_count > 0)\n    .map(a => ({\n      label: a.name.substring(0, 12),\n      value: a.task_done,\n      max: a.task_count\n    }));\n  drawProgressBars('task-progress-chart', taskData.map(d => ({label: `${d.label} (${d.value}/${d.max})`, value: d.value})));\n\n  // 加载长期任务\n  if (typeof loadLongTask === 'function') loadLongTask();\n\n  // 加载用量统计\n  if (typeof loadUsageStats === 'function') loadUsageStats();\n}\n\n// 加载 Tasks 页面\nasync function loadTasks() {\n  try {\n    const response = await fetch(`${API_BASE}/tasks`);\n    if (!response.ok) throw new Error('API 请求失败');\n    const tasks = await response.json();\n\n    const tbody = document.getElementById('tasks-table-body');\n    if (tasks.length === 0) {\n      tbody.innerHTML = '<tr><td colspan=\"5\" style=\"text-align: center; color: var(--text2);\">暂无任务</td></tr>';\n      return;\n    }\n\n    tbody.innerHTML = tasks.map(task => `\n      <tr>\n        <td>${task.id}</td>\n        <td>${task.title || task.subject || '-'}</td>\n        <td><span class=\"status-badge ${task.status}\">${task.status}</span></td>\n        <td>${task.agent_id || '-'}</td>\n        <td>${task.created_at || '-'}</td>\n      </tr>\n    `).join('');\n  } catch (error) {\n    console.error('加载任务失败:', error);\n    document.getElementById('tasks-table-body').innerHTML =\n      '<tr><td colspan=\"5\" style=\"text-align: center; color: var(--red);\">加载失败</td></tr>';\n  }\n}\n\n// 加载 Performance 页面\nasync function loadPerformance() {\n  // 1) 系统指标 + 响应时间（测量 health API）\n  try {\n    const t0 = performance.now();\n    const healthResp = await fetch(`${API_BASE}/health`);\n    const latency = performance.now() - t0;\n    if (healthResp.ok) {\n      const health = await healthResp.json();\n      if (health.system) {\n        document.getElementById('cpu-usage').textContent = health.system.cpu_percent + '%';\n        document.getElementById('memory-usage').textContent = health.system.memory_percent + '%';\n      }\n    }\n    document.getElementById('response-time').textContent = Math.round(latency) + 'ms';\n  } catch(e) {\n    document.getElementById('response-time').textContent = '离线';\n  }\n\n  // 2) Token消耗趋势\n  try {\n    const trendResp = await fetch(`${API_BASE}/usage/trend`);\n    if (trendResp.ok) {\n      const trendRaw = await trendResp.json();\n      const trendData = Array.isArray(trendRaw) ? trendRaw : (trendRaw.data || []);\n      const total = trendData.reduce((s, d) => s + d.value, 0);\n      if (trendData.length && total > 0) {\n        drawLineChart('token-trend-chart', trendData, '#3b82f6');\n        document.getElementById('token-trend-summary').textContent =\n          trendRaw.summary || `${trendData.length}天累计 ${total} 次任务，平均 ${Math.round(total / trendData.length)} 次/天`;\n      } else {\n        drawLineChart('token-trend-chart', [], '#3b82f6');\n        document.getElementById('token-trend-summary').textContent = '近7天数据收集中';\n      }\n    }\n  } catch(e) {}\n\n  // 3) Token用量摘要\n  try {\n    const usageResp = await fetch(`${API_BASE}/usage`);\n    if (usageResp.ok) {\n      const usage = await usageResp.json();\n      if (usage.error) {\n        document.getElementById('token-usage').textContent = '暂无';\n      } else if (usage.total_tokens) {\n        document.getElementById('token-usage').textContent = Number(usage.total_tokens).toLocaleString();\n      } else if (usage.weekly) {\n        const wk = usage.weekly;\n        document.getElementById('token-usage').textContent = (wk.total_runs || 0) + '次';\n      } else {\n        document.getElementById('token-usage').textContent = '暂无';\n      }\n    }\n  } catch(e) {\n    document.getElementById('token-usage').textContent = '暂无';\n  }\n}\n\n// 加载 Logs 页面\nasync function loadLogs() {\n  try {\n    const response = await fetch(`${API_BASE}/logs`);\n    if (!response.ok) throw new Error('API 请求失败');\n    const data = await response.json();\n\n    const container = document.getElementById('logs-content');\n    const lines = Array.isArray(data) ? data : (data.lines || []);\n    if (!lines || lines.length === 0) {\n      container.innerHTML = '<div style=\"text-align: center; color: var(--text2);\">暂无日志</div>';\n      return;\n    }\n\n    // Parse table-format logs: | time | status | task | summary |\n    const logEntries = lines\n      .filter(l => l.trim().startsWith('|') && !l.trim().startsWith('|--') && !l.trim().startsWith('| 时间') && !l.trim().startsWith('| #'))\n      .slice(-50)\n      .map(line => {\n        const parts = line.split('|').map(s => s.trim()).filter(Boolean);\n        if (parts.length >= 4) {\n          return { time: parts[0], status: parts[1], task: parts[2], message: parts[3] };\n        }\n        return { time: '', status: '', task: '', message: line };\n      });\n\n    if (logEntries.length === 0) {\n      container.innerHTML = '<div style=\"text-align: center; color: var(--text2);\">暂无日志条目</div>';\n      return;\n    }\n\n    container.innerHTML = logEntries.map(log => {\n      const levelClass = log.status === 'done' ? 'success' : log.status === 'idle' ? 'warning' : 'info';\n      return `<div class=\"log-entry\">\n        <span class=\"log-time\">${log.time || '-'}</span>\n        <span class=\"log-level ${levelClass}\">${log.status || 'info'}</span>\n        <span style=\"color:var(--accent);font-weight:600;margin-right:8px;font-size:12px;\">${log.task}</span>\n        <span class=\"log-message\">${log.message || '-'}</span>\n      </div>`;\n    }).join('');\n  } catch (error) {\n    console.error('加载日志失败:', error);\n    document.getElementById('logs-content').innerHTML =\n      '<div style=\"text-align: center; color: var(--red);\">加载失败</div>';\n  }\n}\n\n// 加载 Screenshots 页面\nasync function loadScreenshots() {\n  try {\n    const response = await fetch('/api/screenshots');\n    const data = await response.json();\n\n    if (data.error) {\n      document.getElementById('screenshots-grid').innerHTML =\n        `<div style=\"grid-column: 1/-1; text-align: center; color: var(--text2); padding: 40px;\">错误: ${data.error}</div>`;\n      return;\n    }\n\n    const grid = document.getElementById('screenshots-grid');\n    if (data.screenshots.length === 0) {\n      grid.innerHTML =\n        '<div style=\"grid-column: 1/-1; text-align: center; color: var(--text2); padding: 40px;\">暂无截图</div>';\n      return;\n    }\n\n    grid.innerHTML = data.screenshots.map(screenshot => `\n      <div style=\"background: var(--surface2); border-radius: 12px; overflow: hidden; border: 1px solid var(--border);\">\n        <img src=\"${screenshot.url}\" alt=\"${screenshot.name}\"\n             style=\"width: 100%; height: 200px; object-fit: cover; cursor: pointer;\"\n             onclick=\"window.open('${screenshot.url}', '_blank')\">\n        <div style=\"padding: 12px;\">\n          <div style=\"font-size: 13px; font-weight: 500; color: var(--text); margin-bottom: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;\" title=\"${screenshot.name}\">\n            ${screenshot.name}\n          </div>\n          <div style=\"font-size: 11px; color: var(--text2); display: flex; justify-content: space-between;\">\n            <span>${screenshot.size} KB</span>\n            <span>${new Date(screenshot.modified).toLocaleString('zh-CN')}</span>\n          </div>\n        </div>\n      </div>\n    `).join('');\n  } catch (error) {\n    console.error('加载截图失败:', error);\n    document.getElementById('screenshots-grid').innerHTML =\n      '<div style=\"grid-column: 1/-1; text-align: center; color: var(--text2); padding: 40px;\">加载失败</div>';\n  }\n}\n\n// 主题选择器初始化（Settings页面专用）\nfunction initThemeSelector() {\n  const savedTheme = localStorage.getItem('webui_theme') || 'dark';\n  const themeSelector = document.getElementById('theme-selector');\n  if (themeSelector) {\n    themeSelector.value = savedTheme;\n    themeSelector.addEventListener('change', (e) => {\n      const newTheme = e.target.value;\n      if (newTheme === 'dark') {\n        document.documentElement.removeAttribute('data-theme');\n      } else {\n        document.documentElement.setAttribute('data-theme', newTheme);\n      }\n      localStorage.setItem('webui_theme', newTheme);\n      updateThemeIcon(newTheme);\n      currentThemeIndex = themes.indexOf(newTheme);\n      showNotification(`主题已切换: ${newTheme}`, 'success');\n    });\n  }\n}\n\n// 加载 Settings 页面\nasync function loadSettings() {\n  initThemeSelector();\n  await loadSystemInfo();\n  loadLongTask();\n}\n","numLines":2315,"startLine":1,"totalLines":2815,"truncatedByTokenCap":true}}}
