{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_3bf3b651c93f4c569350688a","type":"tool_result","content":"The file D:\\game-projects\\steam-cultivation-factory\\index.html has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"c0e01ba0-5708-46af-9590-e43af2395006","uuid":"a01066a3-ef68-4ad9-b97d-339ff19644bb","timestamp":"2026-05-23T01:44:39.677Z","tool_use_result":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\index.html","oldString":"      <div id=\"sidebar\">\n        <div class=\"sidebar-section\">\n          <h3>🏗 建筑设施</h3>\n          <div id=\"building-list\"></div>\n        </div>\n        <div class=\"sidebar-section\">\n          <h3>🔬 炼丹配方</h3>\n          <div id=\"recipe-list\"></div>\n        </div>\n      </div>","newString":"      <div id=\"sidebar\">\n        <div class=\"sidebar-section\">\n          <h3>🗺 区域</h3>\n          <div id=\"region-list\" class=\"region-nav\"></div>\n        </div>\n        <div class=\"sidebar-section\">\n          <h3>🏗 建筑设施</h3>\n          <div class=\"building-tabs\" id=\"building-tabs\">\n            <button class=\"building-tab active\" data-cat=\"all\">全部</button>\n            <button class=\"building-tab\" data-cat=\"mining\">⛏ 矿</button>\n            <button class=\"building-tab\" data-cat=\"farming\">🌿 田</button>\n            <button class=\"building-tab\" data-cat=\"alchemy\">🔥 炉</button>\n            <button class=\"building-tab\" data-cat=\"transport\">➡ 道</button>\n            <button class=\"building-tab\" data-cat=\"automation\">🤖 傀</button>\n          </div>\n          <div id=\"building-list\"></div>\n        </div>\n        <div class=\"sidebar-section\">\n          <h3>🔬 炼丹配方</h3>\n          <div id=\"recipe-list\"></div>\n        </div>\n      </div>","originalFile":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>修仙自动化工厂 — Cultivation Factory</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body {\n      background: #1a1a2e;\n      color: #e0e0e0;\n      font-family: 'Segoe UI', system-ui, monospace;\n      overflow: hidden;\n      height: 100vh;\n      width: 100vw;\n    }\n    #app { display: flex; flex-direction: column; height: 100vh; }\n\n    /* Toolbar */\n    #toolbar {\n      display: flex; align-items: center; gap: 8px;\n      padding: 6px 12px;\n      background: rgba(0,0,0,0.6);\n      border-bottom: 1px solid rgba(255,255,255,0.1);\n      min-height: 44px; flex-shrink: 0;\n    }\n    #toolbar h1 { font-size: 16px; color: #ffd700; margin-right: 12px; white-space: nowrap; }\n    #toolbar .spacer { flex: 1; }\n    .toolbar-btn {\n      background: rgba(255,255,255,0.08);\n      border: 1px solid rgba(255,255,255,0.15);\n      color: #e0e0e0; padding: 4px 12px; border-radius: 4px;\n      cursor: pointer; font-size: 12px; transition: background 0.2s;\n    }\n    .toolbar-btn:hover { background: rgba(255,255,255,0.15); }\n    .toolbar-btn.active { background: rgba(100,200,100,0.3); border-color: #6c6; }\n\n    /* Main layout */\n    #main { display: flex; flex: 1; overflow: hidden; }\n\n    /* Sidebar */\n    #sidebar {\n      width: 220px;\n      background: rgba(0,0,0,0.5);\n      border-right: 1px solid rgba(255,255,255,0.1);\n      overflow-y: auto; flex-shrink: 0;\n      display: flex; flex-direction: column;\n    }\n    .sidebar-section {\n      padding: 8px;\n      border-bottom: 1px solid rgba(255,255,255,0.05);\n    }\n    .sidebar-section h3 {\n      font-size: 12px; color: #aaa;\n      margin-bottom: 6px; text-transform: uppercase;\n    }\n    .building-item {\n      display: flex; align-items: center; gap: 8px;\n      padding: 6px 8px; margin: 2px 0; border-radius: 4px;\n      cursor: pointer; transition: background 0.2s; font-size: 12px;\n    }\n    .building-item:hover { background: rgba(255,255,255,0.1); }\n    .building-item.selected { background: rgba(100,200,100,0.2); border: 1px solid rgba(100,200,100,0.4); }\n    .building-item .icon { font-size: 18px; }\n    .building-item .info { flex: 1; }\n    .building-item .name { color: #e0e0e0; }\n    .building-item .cost { color: #888; font-size: 10px; }\n    .building-item .cost.cannot { color: #c44; }\n\n    /* Canvas */\n    #canvas-container { flex: 1; position: relative; }\n    #gameCanvas { display: block; width: 100%; height: 100%; }\n\n    /* Info panel */\n    #info-panel {\n      width: 240px;\n      background: rgba(0,0,0,0.5);\n      border-left: 1px solid rgba(255,255,255,0.1);\n      overflow-y: auto; flex-shrink: 0; padding: 8px;\n      display: flex; flex-direction: column; gap: 8px;\n    }\n    #info-panel h3 { font-size: 12px; color: #aaa; margin-bottom: 4px; }\n    .info-entry { font-size: 11px; padding: 3px 0; color: #ccc; }\n\n    /* Realm panel */\n    .realm-panel {\n      background: rgba(255,215,0,0.05);\n      border: 1px solid rgba(255,215,0,0.2);\n      border-radius: 6px; padding: 8px;\n    }\n    .realm-panel .realm-name {\n      color: #ffd700; font-weight: bold; font-size: 14px;\n    }\n    .realm-panel .realm-exp-bar {\n      background: rgba(255,255,255,0.1);\n      border-radius: 3px; height: 14px;\n      margin: 4px 0; position: relative; overflow: hidden;\n    }\n    .realm-panel .realm-exp-fill {\n      background: linear-gradient(90deg, #ffd700, #ffaa00);\n      height: 100%; border-radius: 3px; transition: width 0.3s;\n    }\n    .realm-panel .realm-exp-text {\n      position: absolute; top: 0; left: 50%; transform: translateX(-50%);\n      font-size: 9px; color: #fff; line-height: 14px;\n    }\n    .breakthrough-btn {\n      background: linear-gradient(135deg, #ffd700, #ff8c00);\n      border: none; color: #1a1a2e; font-weight: bold;\n      padding: 6px 12px; border-radius: 4px; cursor: pointer;\n      font-size: 12px; width: 100%; margin-top: 4px;\n      transition: opacity 0.2s;\n    }\n    .breakthrough-btn:hover { opacity: 0.9; }\n    .breakthrough-btn:disabled {\n      background: rgba(255,255,255,0.1); color: #666;\n      cursor: not-allowed;\n    }\n    .breakthrough-req {\n      font-size: 10px; color: #888; padding: 2px 0;\n    }\n    .breakthrough-req.met { color: #6c6; }\n    .breakthrough-req.unmet { color: #c44; }\n\n    /* Inventory panel */\n    .inventory-panel {\n      background: rgba(255,255,255,0.03);\n      border: 1px solid rgba(255,255,255,0.1);\n      border-radius: 6px; padding: 8px;\n    }\n    .pill-item {\n      display: flex; align-items: center; gap: 6px;\n      padding: 4px 0; font-size: 11px;\n    }\n    .pill-item .pill-name { flex: 1; }\n    .pill-item .pill-count { color: #aaa; }\n    .pill-use-btn {\n      background: rgba(100,200,100,0.2);\n      border: 1px solid rgba(100,200,100,0.3);\n      color: #6c6; padding: 2px 8px; border-radius: 3px;\n      cursor: pointer; font-size: 10px;\n    }\n    .pill-use-btn:hover { background: rgba(100,200,100,0.3); }\n    .pill-use-all-btn {\n      background: rgba(255,200,50,0.2);\n      border: 1px solid rgba(255,200,50,0.3);\n      color: #ffd700; padding: 2px 6px; border-radius: 3px;\n      cursor: pointer; font-size: 10px;\n    }\n\n    /* Alchemy panel */\n    .alchemy-panel {\n      background: rgba(255,140,50,0.05);\n      border: 1px solid rgba(255,140,50,0.2);\n      border-radius: 6px; padding: 8px;\n    }\n    .recipe-item {\n      display: flex; align-items: center; gap: 6px;\n      padding: 4px 0; font-size: 11px;\n    }\n    .recipe-item .recipe-name { flex: 1; }\n    .recipe-craft-btn {\n      background: rgba(255,140,50,0.2);\n      border: 1px solid rgba(255,140,50,0.3);\n      color: #ff8c32; padding: 2px 8px; border-radius: 3px;\n      cursor: pointer; font-size: 10px;\n    }\n    .recipe-craft-btn:hover { background: rgba(255,140,50,0.3); }\n    .recipe-craft-btn:disabled { opacity: 0.4; cursor: not-allowed; }\n    .alchemy-progress {\n      background: rgba(255,255,255,0.1);\n      border-radius: 3px; height: 12px;\n      margin: 4px 0; position: relative; overflow: hidden;\n    }\n    .alchemy-progress-fill {\n      background: linear-gradient(90deg, #ff8c32, #ffaa00);\n      height: 100%; border-radius: 3px; transition: width 0.3s;\n    }\n    .alchemy-progress-text {\n      position: absolute; top: 0; left: 50%; transform: translateX(-50%);\n      font-size: 9px; color: #fff; line-height: 12px;\n    }\n    .alchemy-collect-btn {\n      background: linear-gradient(135deg, #ff8c32, #ffaa00);\n      border: none; color: #1a1a2e; font-weight: bold;\n      padding: 4px 12px; border-radius: 3px; cursor: pointer;\n      font-size: 11px; width: 100%;\n    }\n\n    /* Notifications */\n    #notifications {\n      position: absolute; top: 56px; right: 12px;\n      display: flex; flex-direction: column; gap: 4px;\n      pointer-events: none; z-index: 10;\n    }\n    .notif {\n      padding: 6px 12px; border-radius: 4px;\n      font-size: 11px; opacity: 0; transition: opacity 0.3s;\n      pointer-events: auto;\n    }\n    .notif.show { opacity: 1; }\n    .notif.info { background: rgba(100,100,255,0.3); border: 1px solid rgba(100,100,255,0.5); }\n    .notif.success { background: rgba(100,200,100,0.3); border: 1px solid rgba(100,200,100,0.5); }\n    .notif.warning { background: rgba(255,200,50,0.3); border: 1px solid rgba(255,200,50,0.5); }\n    .notif.error { background: rgba(200,100,100,0.3); border: 1px solid rgba(200,100,100,0.5); }\n\n    /* Status bar */\n    #statusbar {\n      display: flex; align-items: center; gap: 12px;\n      padding: 4px 12px;\n      background: rgba(0,0,0,0.6);\n      border-top: 1px solid rgba(255,255,255,0.1);\n      font-size: 11px; color: #888;\n      min-height: 28px; flex-shrink: 0;\n    }\n    #statusbar .fps { color: #6a6; }\n\n    #placement-hint {\n      position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%);\n      background: rgba(0,0,0,0.8); color: #ffd700;\n      padding: 6px 16px; border-radius: 4px; font-size: 12px;\n      pointer-events: none; display: none;\n    }\n\n    /* Region navigation */\n    .region-nav {\n      display: flex; flex-wrap: wrap; gap: 4px; padding: 4px 0;\n    }\n    .region-btn {\n      background: rgba(255,255,255,0.05);\n      border: 1px solid rgba(255,255,255,0.1);\n      color: #aaa; padding: 3px 8px; border-radius: 3px;\n      cursor: pointer; font-size: 10px; transition: all 0.2s;\n    }\n    .region-btn:hover { background: rgba(255,255,255,0.1); }\n    .region-btn.active { background: rgba(100,200,100,0.2); border-color: rgba(100,200,100,0.4); color: #6c6; }\n    .region-btn.locked { opacity: 0.4; cursor: not-allowed; }\n\n    /* Building category tabs */\n    .building-tabs {\n      display: flex; gap: 2px; margin-bottom: 4px;\n    }\n    .building-tab {\n      flex: 1; background: rgba(255,255,255,0.03);\n      border: 1px solid rgba(255,255,255,0.08);\n      color: #666; padding: 3px 0; border-radius: 3px;\n      cursor: pointer; font-size: 9px; text-align: center;\n    }\n    .building-tab.active { background: rgba(255,255,255,0.1); color: #e0e0e0; border-color: rgba(255,255,255,0.2); }\n\n    /* Scrollbar */\n    ::-webkit-scrollbar { width: 6px; }\n    ::-webkit-scrollbar-track { background: transparent; }\n    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 3px; }\n\n    /* Tab buttons for info panel */\n    .tab-bar {\n      display: flex; gap: 4px; margin-bottom: 4px;\n    }\n    .tab-btn {\n      flex: 1; background: rgba(255,255,255,0.05);\n      border: 1px solid rgba(255,255,255,0.1);\n      color: #888; padding: 4px 0; border-radius: 3px;\n      cursor: pointer; font-size: 10px; text-align: center;\n    }\n    .tab-btn.active { background: rgba(255,255,255,0.1); color: #e0e0e0; border-color: rgba(255,255,255,0.3); }\n    .tab-content { display: none; }\n    .tab-content.active { display: block; }\n  </style>\n</head>\n<body>\n  <div id=\"app\">\n    <div id=\"toolbar\">\n      <h1>⛰ 修仙工厂</h1>\n      <div class=\"spacer\"></div>\n      <button class=\"toolbar-btn\" id=\"btn-audio\" title=\"音效开关\">🔊</button>\n      <button class=\"toolbar-btn\" id=\"btn-save\" title=\"保存游戏\">💾 保存</button>\n      <button class=\"toolbar-btn\" id=\"btn-center\" title=\"居中视角\">◎ 居中</button>\n      <button class=\"toolbar-btn\" id=\"btn-reset\" title=\"重置游戏\">⚠ 重置</button>\n    </div>\n    <div id=\"main\">\n      <div id=\"sidebar\">\n        <div class=\"sidebar-section\">\n          <h3>🏗 建筑设施</h3>\n          <div id=\"building-list\"></div>\n        </div>\n        <div class=\"sidebar-section\">\n          <h3>🔬 炼丹配方</h3>\n          <div id=\"recipe-list\"></div>\n        </div>\n      </div>\n      <div id=\"canvas-container\">\n        <canvas id=\"gameCanvas\"></canvas>\n        <div id=\"placement-hint\">点击地图放置建筑 | ESC 取消</div>\n        <div id=\"notifications\"></div>\n      </div>\n      <div id=\"info-panel\">\n        <!-- Realm panel -->\n        <div class=\"realm-panel\" id=\"realm-panel\">\n          <div class=\"realm-name\" id=\"realm-name\">凡人</div>\n          <div class=\"realm-exp-bar\">\n            <div class=\"realm-exp-fill\" id=\"realm-exp-fill\" style=\"width:0%\"></div>\n            <div class=\"realm-exp-text\" id=\"realm-exp-text\">0%</div>\n          </div>\n          <div id=\"breakthrough-reqs\"></div>\n          <button class=\"breakthrough-btn\" id=\"btn-breakthrough\" disabled>境界突破</button>\n        </div>\n\n        <!-- Tab bar -->\n        <div class=\"tab-bar\">\n          <button class=\"tab-btn active\" data-tab=\"inventory\">🎒 丹药</button>\n          <button class=\"tab-btn\" data-tab=\"info\">📊 信息</button>\n          <button class=\"tab-btn\" data-tab=\"alchemy\">🔥 炼丹</button>\n        </div>\n\n        <!-- Inventory tab -->\n        <div class=\"tab-content active\" id=\"tab-inventory\">\n          <div class=\"inventory-panel\">\n            <h3>💊 丹药背包</h3>\n            <div id=\"pill-list\"><div class=\"info-entry\">暂无丹药</div></div>\n          </div>\n        </div>\n\n        <!-- Info tab -->\n        <div class=\"tab-content\" id=\"tab-info\">\n          <div id=\"building-info\"><div class=\"info-entry\">点击建筑查看详情</div></div>\n        </div>\n\n        <!-- Alchemy tab -->\n        <div class=\"tab-content\" id=\"tab-alchemy\">\n          <div class=\"alchemy-panel\">\n            <h3>🔥 炼丹进度</h3>\n            <div id=\"alchemy-status\">\n              <div class=\"info-entry\">选择配方开始炼丹</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div id=\"statusbar\">\n      <span class=\"fps\" id=\"fps-display\">FPS: --</span>\n      <span id=\"status-text\">就绪</span>\n      <div class=\"spacer\"></div>\n      <span id=\"playtime\">游玩时间: 0:00</span>\n    </div>\n  </div>\n\n  <script type=\"module\">\n    import { App } from './src/renderer/App.ts';\n\n    const canvas = document.getElementById('gameCanvas');\n    const app = new App(canvas);\n    app.centerCamera();\n\n    // FPS counter\n    let frameCount = 0;\n    let fpsTime = performance.now();\n    const fpsDisplay = document.getElementById('fps-display');\n    const statusText = document.getElementById('status-text');\n    const playtimeDisplay = document.getElementById('playtime');\n\n    setInterval(() => {\n      const now = performance.now();\n      const fps = Math.round(frameCount * 1000 / (now - fpsTime));\n      fpsDisplay.textContent = `FPS: ${fps}`;\n      frameCount = 0;\n      fpsTime = now;\n\n      const secs = Math.floor(app.state.totalPlaytime);\n      const mins = Math.floor(secs / 60);\n      const hrs = Math.floor(mins / 60);\n      playtimeDisplay.textContent = `游玩时间: ${hrs}:${String(mins % 60).padStart(2, '0')}`;\n    }, 1000);\n\n    const origLoop = app.loop.bind(app);\n    app.loop = (now) => { frameCount++; origLoop(now); };\n    app.start();\n\n    // === Notifications ===\n    const notifContainer = document.getElementById('notifications');\n    app.onNotification = (notif) => {\n      const el = document.createElement('div');\n      el.className = `notif ${notif.type}`;\n      el.textContent = notif.text;\n      notifContainer.appendChild(el);\n      requestAnimationFrame(() => el.classList.add('show'));\n      setTimeout(() => {\n        el.classList.remove('show');\n        setTimeout(() => el.remove(), 300);\n      }, 3000);\n    };\n\n    // === Tabs ===\n    document.querySelectorAll('.tab-btn').forEach(btn => {\n      btn.addEventListener('click', () => {\n        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\n        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));\n        btn.classList.add('active');\n        document.getElementById(`tab-${btn.dataset.tab}`).classList.add('active');\n      });\n    });\n\n    // === Building sidebar ===\n    const buildingList = document.getElementById('building-list');\n    const placementHint = document.getElementById('placement-hint');\n\n    function renderBuildingList() {\n      buildingList.innerHTML = '';\n      const available = app.getAvailableBuildings();\n      for (const def of available) {\n        const item = document.createElement('div');\n        item.className = 'building-item';\n        if (app.placementMode?.id === def.id) item.classList.add('selected');\n\n        const affordable = !Object.keys(def.cost).length ||\n          Object.entries(def.cost).every(([r, c]) => (app.state.resources[r] ?? 0) >= c);\n\n        const icon = getIcon(def.category);\n        const costStr = Object.entries(def.cost).length > 0\n          ? Object.entries(def.cost).map(([r, c]) => `${getResourceName(r)}:${c}`).join(' ')\n          : '免费';\n\n        item.innerHTML = `\n          <span class=\"icon\">${icon}</span>\n          <div class=\"info\">\n            <div class=\"name\">${def.name}</div>\n            <div class=\"cost ${affordable ? '' : 'cannot'}\">${costStr}</div>\n          </div>\n        `;\n\n        item.addEventListener('click', () => {\n          if (app.placementMode?.id === def.id) {\n            app.placementMode = null;\n            placementHint.style.display = 'none';\n            statusText.textContent = '就绪';\n          } else {\n            app.placementMode = def;\n            placementHint.style.display = 'block';\n            statusText.textContent = `放置模式: ${def.name}`;\n          }\n          renderBuildingList();\n        });\n\n        buildingList.appendChild(item);\n      }\n    }\n\n    function getIcon(category) {\n      const icons = { mining: '⛏', farming: '🌿', alchemy: '🔥', energy: '✨', cultivation: '🧘' };\n      return icons[category] || '🏠';\n    }\n\n    function getResourceName(id) {\n      const names = {\n        spirit_stone: '灵石', spirit_grass: '灵草', spirit_energy: '灵气',\n        cultivation: '修为', pill_juling: '聚灵丹', pill_peiyuan: '培元丹',\n        pill_ningqi: '凝气丹', spirit_iron: '灵铁',\n      };\n      return names[id] ?? id;\n    }\n\n    renderBuildingList();\n\n    // === Recipe sidebar ===\n    function renderRecipeList() {\n      const recipeList = document.getElementById('recipe-list');\n      recipeList.innerHTML = '';\n      const recipes = app.getAvailableAlchemyRecipes();\n      for (const recipe of recipes) {\n        const item = document.createElement('div');\n        item.className = 'recipe-item';\n\n        const ingredients = Object.entries(recipe.ingredients)\n          .map(([r, c]) => `${getResourceName(r)}:${c}`).join(' ');\n        const canCraftNow = app.state.alchemySession === null &&\n          Object.entries(recipe.ingredients).every(([r, c]) => (app.state.resources[r] ?? 0) >= c);\n\n        item.innerHTML = `\n          <span style=\"color:${recipe.output.resource === 'pill_juling' ? '#ff8c32' : recipe.output.resource === 'pill_peiyuan' ? '#ff6699' : '#cc66ff'}\">💊</span>\n          <span class=\"recipe-name\">${recipe.name}</span>\n          <button class=\"recipe-craft-btn\" ${canCraftNow ? '' : 'disabled'}>${ingredients}</button>\n        `;\n\n        item.querySelector('.recipe-craft-btn').addEventListener('click', () => {\n          app.startAlchemyAction(recipe.id);\n        });\n\n        recipeList.appendChild(item);\n      }\n    }\n\n    // === Realm panel ===\n    function renderRealmPanel() {\n      const c = app.state.cultivation;\n      const nameEl = document.getElementById('realm-name');\n      const fillEl = document.getElementById('realm-exp-fill');\n      const textEl = document.getElementById('realm-exp-text');\n      const reqsEl = document.getElementById('breakthrough-reqs');\n      const btnEl = document.getElementById('btn-breakthrough');\n\n      // Import getFullRealmName\n      import('./src/game/Cultivation.ts').then(({ getFullRealmName, canBreakthrough, getBreakthroughRequirements, getSubStageName }) => {\n        nameEl.textContent = getFullRealmName(c);\n        const ratio = c.exp / c.expToNext;\n        fillEl.style.width = `${Math.floor(ratio * 100)}%`;\n        textEl.textContent = `${Math.floor(ratio * 100)}%`;\n\n        const reqs = getBreakthroughRequirements(c);\n        reqsEl.innerHTML = '';\n\n        if (reqs.canAttempt || c.level >= 3) {\n          // Show breakthrough requirements\n          for (const [res, amount] of Object.entries(reqs.resourceCost)) {\n            const current = app.state.resources[res] ?? 0;\n            const met = current >= amount;\n            reqsEl.innerHTML += `<div class=\"breakthrough-req ${met ? 'met' : 'unmet'}\">${met ? '✓' : '✗'} ${getResourceName(res)}: ${current}/${amount}</div>`;\n          }\n          if (reqs.needsPill && reqs.pillId) {\n            const current = app.state.resources[reqs.pillId] ?? 0;\n            const met = current >= reqs.pillCount;\n            reqsEl.innerHTML += `<div class=\"breakthrough-req ${met ? 'met' : 'unmet'}\">${met ? '✓' : '✗'} ${getResourceName(reqs.pillId)}: ${current}/${reqs.pillCount}</div>`;\n          }\n          reqsEl.innerHTML += `<div class=\"breakthrough-req\" style=\"color:#aaa\">成功率: ${Math.floor(reqs.successRate * 100)}%</div>`;\n\n          const canAttempt = reqs.canAttempt &&\n            Object.entries(reqs.resourceCost).every(([r, a]) => (app.state.resources[r] ?? 0) >= a) &&\n            (!reqs.needsPill || (app.state.resources[reqs.pillId ?? ''] ?? 0) >= (reqs.pillCount ?? 0));\n\n          btnEl.disabled = !canAttempt;\n        } else {\n          reqsEl.innerHTML = `<div class=\"breakthrough-req\" style=\"color:#888\">修为满级后可突破</div>`;\n          btnEl.disabled = true;\n        }\n      });\n    }\n\n    // === Inventory panel ===\n    function renderInventory() {\n      const pillList = document.getElementById('pill-list');\n      const pills = app.getInventoryPills();\n\n      if (pills.length === 0) {\n        pillList.innerHTML = '<div class=\"info-entry\" style=\"color:#888\">暂无丹药</div>';\n        return;\n      }\n\n      pillList.innerHTML = '';\n      for (const pill of pills) {\n        const item = document.createElement('div');\n        item.className = 'pill-item';\n        item.innerHTML = `\n          <span style=\"color:${pill.color}\">💊</span>\n          <span class=\"pill-name\">${pill.name}</span>\n          <span class=\"pill-count\">×${pill.count}</span>\n          <button class=\"pill-use-btn\" data-id=\"${pill.id}\">服用</button>\n          ${pill.count > 1 ? `<button class=\"pill-use-all-btn\" data-id=\"${pill.id}\">全部</button>` : ''}\n        `;\n        pillList.appendChild(item);\n      }\n\n      // Bind pill use buttons\n      pillList.querySelectorAll('.pill-use-btn').forEach(btn => {\n        btn.addEventListener('click', () => app.usePillAction(btn.dataset.id));\n      });\n      pillList.querySelectorAll('.pill-use-all-btn').forEach(btn => {\n        btn.addEventListener('click', () => app.useAllPills(btn.dataset.id));\n      });\n    }\n\n    // === Alchemy status ===\n    function renderAlchemyStatus() {\n      const statusEl = document.getElementById('alchemy-status');\n      const session = app.state.alchemySession;\n\n      if (!session) {\n        statusEl.innerHTML = '<div class=\"info-entry\">选择配方开始炼丹</div>';\n        return;\n      }\n\n      const progress = Math.floor(session.progress * 100);\n      statusEl.innerHTML = `\n        <div class=\"info-entry\" style=\"color:#ff8c32\">${session.recipeId === 'pill_juling' ? '聚灵丹' : session.recipeId === 'pill_peiyuan' ? '培元丹' : '凝气丹'}</div>\n        <div class=\"alchemy-progress\">\n          <div class=\"alchemy-progress-fill\" style=\"width:${progress}%\"></div>\n          <div class=\"alchemy-progress-text\">${progress}%</div>\n        </div>\n        ${session.complete ? '<button class=\"alchemy-collect-btn\" id=\"btn-collect-alchemy\">收取丹药</button>' : ''}\n      `;\n\n      const collectBtn = document.getElementById('btn-collect-alchemy');\n      if (collectBtn) {\n        collectBtn.addEventListener('click', () => app.collectAlchemyAction());\n      }\n    }\n\n    // === Building info ===\n    function updateBuildingInfo(building) {\n      const infoDiv = document.getElementById('building-info');\n      if (!building) {\n        infoDiv.innerHTML = '<div class=\"info-entry\">点击建筑查看详情</div>';\n        return;\n      }\n      const def = app.buildingDefs.get(building.buildingId);\n      if (!def) return;\n      const prod = def.production;\n      infoDiv.innerHTML = `\n        <div class=\"info-entry\" style=\"color:#ffd700;font-weight:bold\">${def.name}</div>\n        <div class=\"info-entry\">等级: ${building.level}/${def.maxLevel}</div>\n        <div class=\"info-entry\">类型: ${prod.mode === 'manual' ? '手动' : '自动'}</div>\n        <div class=\"info-entry\">产出: ${getResourceName(prod.resource)} ×${prod.amount}</div>\n        ${prod.interval > 0 ? `<div class=\"info-entry\">间隔: ${(prod.interval / 1000).toFixed(1)}s</div>` : ''}\n        ${prod.input ? `<div class=\"info-entry\">消耗: ${Object.entries(prod.input).map(([r,c]) => `${getResourceName(r)}:${c}`).join(' ')}</div>` : ''}\n        <div class=\"info-entry\">状态: ${building.isProducing ? '生产中' : '空闲'}</div>\n        ${building.progress > 0 ? `<div class=\"info-entry\">进度: ${Math.floor(building.progress * 100)}%</div>` : ''}\n      `;\n    }\n\n    // === State change handler ===\n    app.onStateChange = (state) => {\n      renderBuildingList();\n      renderRecipeList();\n      renderRealmPanel();\n      renderInventory();\n      renderAlchemyStatus();\n    };\n\n    app.onBuildingSelect = (building) => {\n      // Switch to info tab\n      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\n      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));\n      document.querySelector('[data-tab=\"info\"]').classList.add('active');\n      document.getElementById('tab-info').classList.add('active');\n      updateBuildingInfo(building);\n    };\n\n    app.onAlchemyUpdate = (session) => {\n      renderAlchemyStatus();\n    };\n\n    // === Breakthrough ===\n    document.getElementById('btn-breakthrough').addEventListener('click', () => {\n      app.attemptBreakthroughAction();\n    });\n\n    // === Toolbar buttons ===\n    document.getElementById('btn-save').addEventListener('click', () => {\n      import('./src/game/GameState.ts').then(({ saveGame }) => {\n        saveGame(app.state);\n        app.addNotification('游戏已保存', 'info');\n      });\n    });\n\n    document.getElementById('btn-center').addEventListener('click', () => {\n      app.centerCamera();\n    });\n\n    document.getElementById('btn-reset').addEventListener('click', () => {\n      if (confirm('确定要重置游戏进度吗？此操作不可撤销！')) {\n        import('./src/game/GameState.ts').then(({ clearSave }) => {\n          clearSave();\n          location.reload();\n        });\n      }\n    });\n\n    // Audio toggle\n    import('./src/game/AudioManager.ts').then(({ audioManager }) => {\n      const audioBtn = document.getElementById('btn-audio');\n      audioBtn.addEventListener('click', () => {\n        audioManager.init();\n        const muted = audioManager.toggleMute();\n        audioBtn.textContent = muted ? '🔇' : '🔊';\n      });\n    });\n\n    // Initial render\n    renderRealmPanel();\n    renderInventory();\n    renderAlchemyStatus();\n    renderRecipeList();\n  </script>\n</body>\n</html>\n","structuredPatch":[{"oldStart":281,"oldLines":7,"newStart":281,"newLines":19,"lines":["     <div id=\"main\">","       <div id=\"sidebar\">","         <div class=\"sidebar-section\">","+          <h3>🗺 区域</h3>","+          <div id=\"region-list\" class=\"region-nav\"></div>","+        </div>","+        <div class=\"sidebar-section\">","           <h3>🏗 建筑设施</h3>","+          <div class=\"building-tabs\" id=\"building-tabs\">","+            <button class=\"building-tab active\" data-cat=\"all\">全部</button>","+            <button class=\"building-tab\" data-cat=\"mining\">⛏ 矿</button>","+            <button class=\"building-tab\" data-cat=\"farming\">🌿 田</button>","+            <button class=\"building-tab\" data-cat=\"alchemy\">🔥 炉</button>","+            <button class=\"building-tab\" data-cat=\"transport\">➡ 道</button>","+            <button class=\"building-tab\" data-cat=\"automation\">🤖 傀</button>","+          </div>","           <div id=\"building-list\"></div>","         </div>","         <div class=\"sidebar-section\">"]}],"userModified":false,"replaceAll":false}}
