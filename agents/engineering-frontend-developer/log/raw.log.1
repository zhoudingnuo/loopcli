{"type":"assistant","message":{"id":"msg_20260523075654be49e3a2b6844920","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_eeba512fae62452f985fc689","name":"Write","input":{"file_path":"D:/game-projects/douyin-idiom/src/js/Game.js","content":"// Game.js — Main game controller\n\nclass Game {\n  constructor() {\n    this.engine = new IdiomEngine(IDIOM_DB);\n    this.judge = new Judge();\n    this.combo = new ComboSystem();\n    this.data = new DataManager();\n    this.audio = new AudioManager();\n    this.tutorial = new Tutorial();\n\n    this.currentLevel = null;\n    this.questions = [];\n    this.questionIndex = 0;\n    this.lives = 5;\n    this.state = 'menu'; // menu, playing, result\n    this.usedHintThisQuestion = false;\n    this.hintsUsed = 0;\n    this.continuedOnce = false;\n  }\n\n  startLevel(levelId) {\n    const level = LEVELS.find(l => l.id === levelId);\n    if (!level) return;\n\n    this.currentLevel = level;\n    this.lives = level.lives;\n    this.questions = this.engine.generateForLevel(level);\n    this.questionIndex = 0;\n    this.combo.reset();\n    this.continuedOnce = false;\n    this.hintsUsed = 0;\n    this.engine.reset();\n    this.state = 'playing';\n\n    if (level.tutorial) {\n      this.tutorial.start(level.tutorial);\n    } else {\n      this.tutorial.end();\n    }\n\n    this.startQuestion();\n  }\n\n  startQuestion() {\n    if (this.questionIndex >= this.questions.length) {\n      this.finishLevel();\n      return;\n    }\n    const q = this.questions[this.questionIndex];\n    this.judge.startQuestion(q);\n    this.usedHintThisQuestion = false;\n  }\n\n  pickChar(candidateIndex) {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n\n    const result = this.judge.placeChar(candidateIndex);\n    if (result.action === 'placed') {\n      this.audio.playPlace();\n      if (result.fillCount === 4) {\n        setTimeout(() => this.handleFullAnswer(result), 400);\n      }\n    } else if (result.action === 'full') {\n      setTimeout(() => this.handleFullAnswer(result), 200);\n    }\n    return result;\n  }\n\n  handleFullAnswer(result) {\n    const q = this.questions[this.questionIndex];\n    q.answered = true;\n    q.correct = result.isCorrect;\n\n    if (result.isCorrect) {\n      this.audio.playCorrect();\n      const comboResult = this.combo.onCorrect(this.usedHintThisQuestion);\n      if (comboResult.combo >= 3) this.audio.playCombo(comboResult.combo);\n      this.data.collectIdiom(q.idiom.id);\n      q.comboResult = comboResult;\n\n      setTimeout(() => {\n        this.questionIndex++;\n        this.startQuestion();\n        this.render();\n      }, 800);\n    } else {\n      this.audio.playWrong();\n      this.combo.onWrong();\n      this.lives--;\n\n      if (this.lives <= 0) {\n        setTimeout(() => this.finishLevel(), 600);\n      } else {\n        setTimeout(() => {\n          q.answered = false;\n          q.correct = null;\n          this.judge.startQuestion(q);\n          this.render();\n        }, 500);\n      }\n    }\n    this.render();\n  }\n\n  removeSlot(slotIndex) {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const result = this.judge.removeSlot(slotIndex);\n    if (result.action === 'removed') {\n      this.audio.playPlace();\n    }\n    return result;\n  }\n\n  useHintReveal() {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n\n    const fillCount = this.judge.getFillCount();\n    const targetIdx = fillCount;\n    const correctChar = this.judge.currentIdiom.chars[targetIdx];\n\n    const candidate = q.candidates.find(c => c.char === correctChar && !c.used);\n    if (!candidate) return null;\n\n    this.usedHintThisQuestion = true;\n    this.hintsUsed++;\n    this.audio.playHint();\n\n    return this.judge.placeChar(candidate.index);\n  }\n\n  useHintRemove() {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n\n    const wrongCandidates = q.candidates.filter(c => {\n      if (c.used) return false;\n      return !this.judge.currentIdiom.chars.includes(c.char);\n    });\n\n    const removed = [];\n    const count = Math.min(2, wrongCandidates.length);\n    for (let i = 0; i < count; i++) {\n      const idx = Math.floor(Math.random() * wrongCandidates.length);\n      const c = wrongCandidates.splice(idx, 1)[0];\n      c.removed = true;\n      removed.push(c);\n    }\n\n    this.audio.playRemove();\n    return { action: 'removed_distractors', removed };\n  }\n\n  skipQuestion() {\n    if (this.state !== 'playing') return;\n    const q = this.questions[this.questionIndex];\n    if (q) {\n      q.answered = true;\n      q.correct = false;\n      q.skipped = true;\n    }\n    this.combo.onSkip();\n    this.questionIndex++;\n    this.startQuestion();\n    this.render();\n  }\n\n  continueWithAd() {\n    if (this.continuedOnce) return false;\n    this.lives = 3;\n    this.continuedOnce = true;\n    return true;\n  }\n\n  finishLevel() {\n    this.state = 'result';\n    const stats = this.combo.getStats();\n    const totalQuestions = this.questions.length;\n    const correctCount = stats.correctCount;\n    const stars = this.combo.getStarRating(correctCount, totalQuestions);\n\n    if (stars > 0 && this.currentLevel) {\n      this.data.setLevelStars(this.currentLevel.id, stars);\n      this.data.addCoins(this.currentLevel.reward.coins);\n      this.data.addScore(stats.score);\n      this.data.updateBestCombo(stats.maxCombo);\n    }\n\n    this.levelResult = {\n      stars,\n      correctCount,\n      totalQuestions,\n      score: stats.score,\n      maxCombo: stats.maxCombo,\n      coins: stars > 0 ? this.currentLevel.reward.coins : 0\n    };\n\n    if (stars > 0) this.audio.playLevelWin();\n    else this.audio.playLevelFail();\n\n    this.render();\n  }\n\n  render() {\n    if (typeof renderUI === 'function') renderUI(this);\n  }\n\n  getCurrentQuestion() {\n    return this.questions[this.questionIndex];\n  }\n\n  getState() {\n    return {\n      state: this.state,\n      currentLevel: this.currentLevel,\n      question: this.getCurrentQuestion(),\n      questionIndex: this.questionIndex,\n      totalQuestions: this.questions.length,\n      lives: this.lives,\n      combo: this.combo.combo,\n      score: this.combo.score,\n      slots: this.judge.getSlots(),\n      fillCount: this.judge.getFillCount(),\n      stats: this.combo.getStats(),\n      levelResult: this.levelResult,\n      tutorial: this.tutorial\n    };\n  }\n\n  goToMenu() {\n    this.state = 'menu';\n    this.tutorial.end();\n    this.render();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Game };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"930c8880-e9f5-4f41-8841-d1efd19066ee","uuid":"0e978228-c97e-43c9-bb92-aa8be358e5cd"}
