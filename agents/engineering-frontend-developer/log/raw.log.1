egion(index: number): boolean {","+    if (index < 0 || index >= this.state.maps.length) return false;","+    if (index === this.currentRegionIndex) return false;","+","+    this.currentRegionIndex = index;","+    this.state.currentRegionIndex = index;","+    this.loadRegionMap(index);","+","+    const regionDef = this.regionDefs.find(r => r.id === this.state.maps[index]?.regionId);","+    if (regionDef) {","+      this.onRegionChange?.(index, regionDef);","+    }","+","+    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);","+    this.onStateChange?.(this.state);","+    return true;","+  }","+","+  // Get unlocked regions","+  getUnlockedRegions(): Array<RegionDef & { index: number }> {","+    return this.regionDefs","+      .map((r, i) => {","+        if (cultivationIsRealmUnlocked(r.unlockRealm, this.state.cultivation)) {","+          // Ensure region is initialized","+          const mapIndex = this.state.maps.findIndex(m => m.regionId === r.id);","+          if (mapIndex < 0) {","+            this.initRegion(r);","+          }","+          const actualIndex = Math.max(0, this.state.maps.findIndex(m => m.regionId === r.id));","+          return { ...r, index: actualIndex };","+        }","+        return null;","+      })","+      .filter((r): r is RegionDef & { index: number } => r !== null);","+  }","+","   start(): void {","     if (this.running) return;","     this.running = true;"]},{"oldStart":176,"oldLines":8,"newStart":300,"newLines":8,"lines":["   };"," ","   private tickProduction(now: number): void {","-    this.state = tickAutoProduction(this.state, 0, now, this.buildingDefs);","-    this.state = tickManualProduction(this.state, 0, now, this.buildingDefs);","+    this.state = tickAutoProduction(this.state, this.currentRegionIndex, now, this.buildingDefs);","+    this.state = tickManualProduction(this.state, this.currentRegionIndex, now, this.buildingDefs);"," ","     // M2: Auto-cultivation tick","     this.state.c