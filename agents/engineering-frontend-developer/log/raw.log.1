{"type":"assistant","message":{"id":"msg_20260523093651d76a33df0f874e6a","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_565c88772a0c4a5e8fed7063","name":"Write","input":{"file_path":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Puppet.ts","content":"// Puppet.ts — 傀儡分拣系统：自动分类灵草到丹炉，按类型路由资源\n\nexport interface PuppetInstance {\n  uid: string;\n  gridX: number;\n  gridY: number;\n  level: number;\n  /** 分拣规则：资源类型 → 目标方向 */\n  rules: PuppetRule[];\n  /** 当前持有的物品 */\n  heldItem: HeldItem | null;\n  /** 工作状态 */\n  state: 'idle' | 'picking' | 'delivering';\n  /** 动作进度 0-1 */\n  actionProgress: number;\n  /** 动作速度 ms */\n  actionSpeed: number;\n}\n\nexport interface PuppetRule {\n  resourceType: string;\n  targetDx: number;\n  targetDy: number;\n  /** 优先级 */\n  priority: number;\n}\n\nexport interface HeldItem {\n  resource: string;\n  amount: number;\n}\n\n// Default routing rules: map resource types to directions\nconst DEFAULT_RULES: PuppetRule[] = [\n  { resourceType: 'spirit_grass', targetDx: 0, targetDy: -1, priority: 1 },\n  { resourceType: 'spirit_stone', targetDx: 1, targetDy: 0, priority: 2 },\n  { resourceType: 'pill_juling', targetDx: 0, targetDy: 1, priority: 3 },\n  { resourceType: 'pill_peiyuan', targetDx: -1, targetDy: 0, priority: 4 },\n  { resourceType: 'spirit_iron', targetDx: -1, targetDy: 0, priority: 5 },\n];\n\nexport function createPuppet(\n  uid: string,\n  gridX: number,\n  gridY: number,\n  level: number = 1,\n): PuppetInstance {\n  return {\n    uid,\n    gridX,\n    gridY,\n    level,\n    rules: [...DEFAULT_RULES],\n    heldItem: null,\n    state: 'idle',\n    actionProgress: 0,\n    actionSpeed: 3000, // 3 seconds per action\n  };\n}\n\n// Get sorting rule for a resource type\nexport function getRuleForResource(puppet: PuppetInstance, resourceType: string): PuppetRule | undefined {\n  return puppet.rules\n    .filter(r => r.resourceType === resourceType)\n    .sort((a, b) => a.priority - b.priority)[0];\n}\n\n// Add or update a routing rule\nexport function setRule(\n  puppet: PuppetInstance,\n  resourceType: string,\n  targetDx: number,\n  targetDy: number,\n  priority: number = 0,\n): PuppetInstance {\n  const existing = puppet.rules.findIndex(r => r.resourceType === resourceType);\n  const newRule: PuppetRule = { resourceType, targetDx, targetDy, priority };\n\n  const newRules = [...puppet.rules];\n  if (existing >= 0) {\n    newRules[existing] = newRule;\n  } else {\n    newRules.push(newRule);\n  }\n\n  return { ...puppet, rules: newRules };\n}\n\n// Puppet picks up an item from an adjacent source\nexport function puppetPickup(\n  puppet: PuppetInstance,\n  resource: string,\n  amount: number,\n): PuppetInstance {\n  return {\n    ...puppet,\n    heldItem: { resource, amount },\n    state: 'delivering',\n    actionProgress: 0,\n  };\n}\n\n// Puppet delivers held item — returns the delivery info and cleared puppet\nexport function puppetDeliver(puppet: PuppetInstance): {\n  puppet: PuppetInstance;\n  delivery: { resource: string; amount: number; targetDx: number; targetDy: number } | null;\n} {\n  if (!puppet.heldItem) {\n    return { puppet: { ...puppet, state: 'idle' }, delivery: null };\n  }\n\n  const rule = getRuleForResource(puppet, puppet.heldItem.resource);\n  const delivery = rule\n    ? {\n        resource: puppet.heldItem.resource,\n        amount: puppet.heldItem.amount,\n        targetDx: rule.targetDx,\n        targetDy: rule.targetDy,\n      }\n    : null;\n\n  return {\n    puppet: {\n      ...puppet,\n      heldItem: null,\n      state: 'idle',\n      actionProgress: 0,\n    },\n    delivery,\n  };\n}\n\n// Tick puppet progress\nexport function tickPuppet(\n  puppet: PuppetInstance,\n  dtMs: number,\n): PuppetInstance {\n  if (puppet.state === 'idle') return puppet;\n\n  const progress = puppet.actionProgress + dtMs / puppet.actionSpeed;\n  if (progress >= 1) {\n    // Action complete\n    return { ...puppet, actionProgress: 1 };\n  }\n  return { ...puppet, actionProgress: progress };\n}\n\n// Render a puppet on canvas\nexport function renderPuppet(\n  ctx: CanvasRenderingContext2D,\n  puppet: PuppetInstance,\n  offsetX: number,\n  offsetY: number,\n  scale: number,\n  cellSize: number,\n  now: number,\n): void {\n  const x = offsetX + puppet.gridX * cellSize * scale;\n  const y = offsetY + puppet.gridY * cellSize * scale;\n  const s = cellSize * scale;\n\n  // Puppet body\n  const bodyColor = puppet.state === 'idle' ? 'rgba(200,180,100,0.7)' : 'rgba(255,200,50,0.8)';\n  ctx.fillStyle = bodyColor;\n  ctx.beginPath();\n  ctx.arc(x + s / 2, y + s / 2, s * 0.35, 0, Math.PI * 2);\n  ctx.fill();\n\n  // Face icon\n  ctx.fillStyle = '#fff';\n  ctx.font = `${Math.max(10, Math.floor(14 * scale))}px serif`;\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n  ctx.fillText('🤖', x + s / 2, y + s / 2);\n\n  // Level badge\n  ctx.font = `bold ${Math.max(6, Math.floor(8 * scale))}px monospace`;\n  ctx.fillStyle = '#ffd700';\n  ctx.fillText(`Lv${puppet.level}`, x + s / 2, y + s - 4 * scale);\n\n  // Action progress ring\n  if (puppet.state !== 'idle') {\n    ctx.strokeStyle = '#ffd700';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.arc(x + s / 2, y + s / 2, s * 0.4, -Math.PI / 2, -Math.PI / 2 + puppet.actionProgress * Math.PI * 2);\n    ctx.stroke();\n  }\n\n  // Held item indicator\n  if (puppet.heldItem) {\n    const RESOURCE_COLORS: Record<string, string> = {\n      spirit_stone: '#7cc8ff',\n      spirit_grass: '#6adf6a',\n      spirit_iron: '#8a8aaa',\n    };\n    ctx.fillStyle = RESOURCE_COLORS[puppet.heldItem.resource] ?? '#fff';\n    ctx.beginPath();\n    ctx.arc(x + s - 4 * scale, y + 4 * scale, 3 * scale, 0, Math.PI * 2);\n    ctx.fill();\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"c0e01ba0-5708-46af-9590-e43af2395006","uuid":"04affd77-18db-4ac2-8d07-0cc509a286b9"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_565c88772a0c4a5e8fed7063","type":"tool_result","content":"File created successfully at: D:\\game-projects\\steam-cultivation-factory\\src\\game\\Puppet.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"c0e01ba0-5708-46af-9590-e43af2395006","uuid":"29be8719-1fce-453e-8060-eb07531e157a","timestamp":"2026-05-23T01:37:23.418Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Puppet.ts","content":"// Puppet.ts — 傀儡分拣系统：自动分类灵草到丹炉，按类型路由资源\n\nexport interface PuppetInstance {\n  uid: string;\n  gridX: number;\n  gridY: number;\n  level: number;\n  /** 分拣规则：资源类型 → 目标方向 */\n  rules: PuppetRule[];\n  /** 当前持有的物品 */\n  heldItem: HeldItem | null;\n  /** 工作状态 */\n  state: 'idle' | 'picking' | 'delivering';\n  /** 动作进度 0-1 */\n  actionProgress: number;\n  /** 动作速度 ms */\n  actionSpeed: number;\n}\n\nexport interface PuppetRule {\n  resourceType: string;\n  targetDx: number;\n  targetDy: number;\n  /** 优先级 */\n  priority: number;\n}\n\nexport interface HeldItem {\n  resource: string;\n  amount: number;\n}\n\n// Default routing rules: map resource types to directions\nconst DEFAULT_RULES: PuppetRule[] = [\n  { resourceType: 'spirit_grass', targetDx: 0, targetDy: -1, priority: 1 },\n  { resourceType: 'spirit_stone', targetDx: 1, targetDy: 0, priority: 2 },\n  { resourceType: 'pill_juling', targetDx: 0, targetDy: 1, priority: 3 },\n  { resourceType: 'pill_peiyuan', targetDx: -1, targetDy: 0, priority: 4 },\n  { resourceType: 'spirit_iron', targetDx: -1, targetDy: 0, priority: 5 },\n];\n\nexport function createPuppet(\n  uid: string,\n  gridX: number,\n  gridY: number,\n  level: number = 1,\n): PuppetInstance {\n  return {\n    uid,\n    gridX,\n    gridY,\n    level,\n    rules: [...DEFAULT_RULES],\n    heldItem: null,\n    state: 'idle',\n    actionProgress: 0,\n    actionSpeed: 3000, // 3 seconds per action\n  };\n}\n\n// Get sorting rule for a resource type\nexport function getRuleForResource(puppet: PuppetInstance, resourceType: string): PuppetRule | undefined {\n  return puppet.rules\n    .filter(r => r.resourceType === resourceType)\n    .sort((a, b) => a.priority - b.priority)[0];\n}\n\n// Add or update a routing rule\nexport function setRule(\n  puppet: PuppetInstance,\n  resourceType: string,\n  targetDx: number,\n  targetDy: number,\n  priority: number = 0,\n): PuppetInstance {\n  const existing = puppet.rules.findIndex(r => r.resourceType === resourceType);\n  const newRule: PuppetRule = { resourceType, targetDx, targetDy, priority };\n\n  const newRules = [...puppet.rules];\n  if (existing >= 0) {\n    newRules[existing] = newRule;\n  } else {\n    newRules.push(newRule);\n  }\n\n  return { ...puppet, rules: newRules };\n}\n\n// Puppet picks up an item from an adjacent source\nexport function puppetPickup(\n  puppet: PuppetInstance,\n  resource: string,\n  amount: number,\n): PuppetInstance {\n  return {\n    ...puppet,\n    heldItem: { resource, amount },\n    state: 'delivering',\n    actionProgress: 0,\n  };\n}\n\n// Puppet delivers held item — returns the delivery info and cleared puppet\nexport function puppetDeliver(puppet: PuppetInstance): {\n  puppet: PuppetInstance;\n  delivery: { resource: string; amount: number; targetDx: number; targetDy: number } | null;\n} {\n  if (!puppet.heldItem) {\n    return { puppet: { ...puppet, state: 'idle' }, delivery: null };\n  }\n\n  const rule = getRuleForResource(puppet, puppet.heldItem.resource);\n  const delivery = rule\n    ? {\n        resource: puppet.heldItem.resource,\n        amount: puppet.heldItem.amount,\n        targetDx: rule.targetDx,\n        targetDy: rule.targetDy,\n      }\n    : null;\n\n  return {\n    puppet: {\n      ...puppet,\n      heldItem: null,\n      state: 'idle',\n      actionProgress: 0,\n    },\n    delivery,\n  };\n}\n\n// Tick puppet progress\nexport function tickPuppet(\n  puppet: PuppetInstance,\n  dtMs: number,\n): PuppetInstance {\n  if (puppet.state === 'idle') return puppet;\n\n  const progress = puppet.actionProgress + dtMs / puppet.actionSpeed;\n  if (progress >= 1) {\n    // Action complete\n    return { ...puppet, actionProgress: 1 };\n  }\n  return { ...puppet, actionProgress: progress };\n}\n\n// Render a puppet on canvas\nexport function renderPuppet(\n  ctx: CanvasRenderingContext2D,\n  puppet: PuppetInstance,\n  offsetX: number,\n  offsetY: number,\n  scale: number,\n  cellSize: number,\n  now: number,\n): void {\n  const x = offsetX + puppet.gridX * cellSize * scale;\n  const y = offsetY + puppet.gridY * cellSize * scale;\n  const s = cellSize * scale;\n\n  // Puppet body\n  const bodyColor = puppet.state === 'idle' ? 'rgba(200,180,100,0.7)' : 'rgba(255,200,50,0.8)';\n  ctx.fillStyle = bodyColor;\n  ctx.beginPath();\n  ctx.arc(x + s / 2, y + s / 2, s * 0.35, 0, Math.PI * 2);\n  ctx.fill();\n\n  // Face icon\n  ctx.fillStyle = '#fff';\n  ctx.font = `${Math.max(10, Math.floor(14 * scale))}px serif`;\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n  ctx.fillText('🤖', x + s / 2, y + s / 2);\n\n  // Level badge\n  ctx.font = `bold ${Math.max(6, Math.floor(8 * scale))}px monospace`;\n  ctx.fillStyle = '#ffd700';\n  ctx.fillText(`Lv${puppet.level}`, x + s / 2, y + s - 4 * scale);\n\n  // Action progress ring\n  if (puppet.state !== 'idle') {\n    ctx.strokeStyle = '#ffd700';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.arc(x + s / 2, y + s / 2, s * 0.4, -Math.PI / 2, -Math.PI / 2 + puppet.actionProgress * Math.PI * 2);\n    ctx.stroke();\n  }\n\n  // Held item indicator\n  if (puppet.heldItem) {\n    const RESOURCE_COLORS: Record<string, string> = {\n      spirit_stone: '#7cc8ff',\n      spirit_grass: '#6adf6a',\n      spirit_iron: '#8a8aaa',\n    };\n    ctx.fillStyle = RESOURCE_COLORS[puppet.heldItem.resource] ?? '#fff';\n    ctx.beginPath();\n    ctx.arc(x + s - 4 * scale, y + 4 * scale, 3 * scale, 0, Math.PI * 2);\n    ctx.fill();\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
