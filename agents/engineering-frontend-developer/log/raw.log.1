akthroughPill: 'pill_juling',\n68\t    breakthroughPillCount: 5,\n69\t    breakthroughSuccessRate: 0.85,\n70\t    failPenaltyPercent: 0.2,\n71\t    unlockContent: ['灵石矿机', '灵田', '丹炉', '聚灵丹'],\n72\t  },\n73\t  zhuji: {\n74\t    id: 'zhuji',\n75\t    name: '筑基期',\n76\t    nameEn: 'Foundation Building',\n77\t    subStages: ['初期', '中期', '后期'],\n78\t    levelsPerStage: 5,\n79\t    expBase: 1000,\n80\t    expGrowth: 1.8,\n81\t    cultivationBaseRate: 2.0,\n82\t    breakthroughCost: { spirit_stone: 500 },\n83\t    breakthroughPill: 'pill_peiyuan',\n84\t    breakthroughPillCount: 5,\n85\t    breakthroughSuccessRate: 0.75,\n86\t    failPenaltyPercent: 0.25,\n87\t    unlockContent: ['灵脉通道', '传送带', '培元丹'],\n88\t  },\n89\t  jindan: {\n90\t    id: 'jindan',\n91\t    name: '金丹期',\n92\t    nameEn: 'Golden Core',\n93\t    subStages: ['初期', '中期', '后期', '圆满'],\n94\t    levelsPerStage: 5,\n95\t    expBase: 10000,\n96\t    expGrowth: 1.8,\n97\t    cultivationBaseRate: 10.0,\n98\t    breakthroughCost: { spirit_stone: 5000 },\n99\t    breakthroughPill: 'pill_jindanyin',\n100\t    breakthroughPillCount: 10,\n101\t    breakthroughSuccessRate: 0.70,\n102\t    failPenaltyPercent: 0.3,\n103\t    unlockContent: ['傀儡工人', '分拣器', '中级丹方'],\n104\t  },\n105\t};\n106\t\n107\texport function getRealmDef(realmId: string): RealmDef | undefined {\n108\t  return REALM_DEFS[realmId];\n109\t}\n110\t\n111\texport function getRealmOrder(): string[] {\n112\t  return REALM_ORDER;\n113\t}\n114\t\n115\texport function createInitialCultivationState(): CultivationState {\n116\t  return {\n117\t    realmId: 'fanren',\n118\t    subStage: 0,\n119\t    level: 1,\n120\t    exp: 0,\n121\t    expToNext: 50,\n122\t    totalCultivation: 0,\n123\t    cultivationRate: 0,\n124\t    isAutoCultivating: false,\n125\t  };\n126\t}\n127\t\n128\texport function getSubStageName(realmId: string, subStage: number): string {\n129\t  const def = REALM_DEFS[realmId];\n130\t  if (!def) return '';\n131\t  return def.subStages[subStage] ?? '';\n132\t}\n133\t\n134\texport function getFullRealmName(state: CultivationState): string {\n135\t  const def = REALM_DEFS[state.realmId];\n136\t  if (!def) return state.realmId;\n137\t  if (def.subStages.length === 1) return def.name;\n138\t  return `${def.name} ${def.subStages[state.subStage] ?? ''} Lv${state.level}`;\n139\t}\n140\t\n141\texport function getShortRealmName(state: CultivationState): string {\n142\t  const def = REALM_DEFS[state.realmId];\n143\t  if (!def) return state.realmId;\n144\t  return def.name;\n145\t}\n146\t\n147\t// Calculate exp needed for next level within current sub-stage\n148\texport function calcExpToNext(realmId: string, level: number): number {\n149\t  const def = REALM_DEFS[realmId];\n150\t  if (!def) return 100;\n151\t  return Math.floor(def.expBase * Math.pow(def.expGrowth, level - 1));\n152\t}\n153\t\n154\t// Add cultivation exp, handle level-ups within sub-stage\n155\texport function addCultivationExp(state: CultivationState, amount: number): CultivationState {\n156\t  const next = { ...state };\n157\t  next.exp += amount;\n158\t  next.totalCultivation += amount;\n159\t\n160\t  const def = REALM_DEFS[next.realmId];\n161\t  if (!def) return next;\n162\t\n163\t  while (next.exp >= next.expToNext) {\n164\t    next.exp -= next.expToNext;\n165\t    next.level += 1;\n166\t\n167\t    if (next.level > def.levelsPerStage) {\n168\t      // Can't auto-advance past sub-stage boundary — needs breakthrough\n169\t      next.level = def.levelsPerStage;\n170\t      next.exp = next.expToNext;\n171\t      break;\n172\t    }\n173\t\n174\t    next.expToNext = calcExpToNext(next.realmId, next.level);\n175\t  }\n176\t\n177\t  // Update cultivation rate based on realm\n178\t  next.cultivationRate = def.cultivationBaseRate;\n179\t\n180\t  return next;\n181\t}\n182\t\n183\t// Check if ready for sub-stage breakthrough\n184\texport function canBreakthrough(state: CultivationState): boolean {\n185\t  const def = REALM_DEFS[state.realmId];\n186\t  if (!def) return false;\n187\t\n188\t  // Must be at max level of current sub-stage\n189\t  if (state.level < def.levelsPerStage) return false;\n190\t  if (state.exp < state.expToNext) return false;\n191\t\n192\t  return true;\n193\t}\n194\t\n195\t// Check if can break through to next major realm\n196\texport function isRealmTransition(state: CultivationState): boolean {\n197\t  const def = REALM_DEFS[state.realmId];\n198\t  if (!def) return false;\n199\t  return state.subStage >= def.subStages.length - 1;\n200\t}\n201\t\n202\t// Get what's needed for breakthrough\n203\texport function getBreakthroughRequirements(state: CultivationState): {\n204\t  canAttempt: boolean;\n205\t  needsPill: boolean;\n206\t  pillId: string | null;\n207\t  pillCount: number;\n208\t  resourceCost: Record<string, number>;\n209\t  successRate: number;\n210\t} {\n211\t  const def = REALM_DEFS[state.realmId];\n212\t  if (!def) return { canAttempt: false, needsPill: false, pillId: null, pillCount: 0, resourceCost: {}, successRate: 0 };\n213\t\n214\t  const atMax = state.level >= def.levelsPerStage && state.exp >= state.expToNext;\n215\t\n216\t  return {\n217\t    canAttempt: atMax,\n218\t    needsPill: !!def.breakthroughPill,\n219\t    pillId: def.breakthroughPill ?? null,\n220\t    pillCount: def.breakthroughPillCount ?? 0,\n221\t    resourceCost: def.breakthroughCost,\n222\t    successRate: def.breakthroughSuccessRate,\n223\t  };\n224\t}\n225\t\n226\t// Attempt breakthrough. Pass in resources for cost check and deduction.\n227\texport function attemptBreakthrough(\n228\t  state: CultivationState,\n229\t  resources: Record<string, number>,\n230\t): { result: BreakthroughResult; newState: CultivationState; newResources: Record<string, number> } | null {\n231\t  const def = REALM_DEFS[state.realmId];\n232\t  if (!def) return null;\n233\t\n234\t  if (!canBreakthrough(state)) return null;\n235\t\n236\t  // Check resources\n237\t  const costs = def.breakthroughCost;\n238\t  for (const [res, amount] of Object.entries(costs)) {\n239\t    if ((resources[res] ?? 0) < amount) return null;\n240\t  }\n241\t\n242\t  // Check pill requirement\n243\t  if (def.breakthroughPill && def.breakthroughPillCount) {\n244\t    if ((resources[def.breakthroughPill] ?? 0) < def.breakthroughPillCount) return null;\n245\t  }\n246\t\n247\t  // Deduct costs\n248\t  const newResources = { ...resources };\n249\t  for (const [res, amount] of Object.entries(costs)) {\n250\t    newResources[res] = (newResources[res] ?? 0) - amount;\n251\t  }\n252\t  if (def.breakthroughPill && def.breakthroughPillCount) {\n253\t    newResources[def.breakthroughPill] = (newResources[def.breakthroughPill] ?? 0) - def.breakthroughPillCount;\n254\t  }\n255\t\n256\t  // Roll for success\n257\t  const roll = Math.random();\n258\t  const success = roll < def.breakthroughSuccessRate;\n259\t\n260\t  const newState = { ...state };\n261\t\n262\t  if (success) {\n263\t    const isTransition = isRealmTransition(state);\n264\t\n265\t    if (isTransition) {\n266\t      // Move to next major realm\n267\t      const currentIdx = REALM_ORDER.indexOf(state.realmId);\n268\t      const nextRealmId = REALM_ORDER[currentIdx + 1] ?? state.realmId;\n269\t      const nextDef = REALM_DEFS[nextRealmId];\n270\t\n271\t      newState.realmId = nextRealmId;\n272\t      newState.subStage = 0;\n273\t      newState.level = 1;\n274\t      newState.exp = 0;\n275\t      newState.expToNext = nextDef ? nextDef.expBase : 100;\n276\t      newState.cultivationRate = nextDef?.cultivationBaseRate ?? 0;\n277\t    } else {\n278\t      // Advance sub-stage within same realm\n279\t      newState.subStage = state.subStage + 1;\n280\t      newState.level = 1;\n281\t      newState.exp = 0;\n282\t      newState.expToNext = calcExpToNext(state.realmId, 1);\n283\t    }\n284\t\n285\t    return {\n286\t      result: {\n287\t        success: true,\n288\t        oldRealm: state.realmId,\n289\t        newRealm: newState.realmId,\n290\t        oldSubStage: state.subStage,\n29