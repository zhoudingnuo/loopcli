{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_15abcd005582431eb293842b","type":"tool_result","content":"1\t// Resources.ts — Resource management with manual collection and display\n2\t\n3\timport type { GameState, Resources, BuildingInstance } from './GameState';\n4\timport { addResources, addCultivation, updateBuilding } from './GameState';\n5\timport type { BuildingDef } from './Building';\n6\t\n7\texport interface ResourceDisplay {\n8\t  id: string;\n9\t  name: string;\n10\t  amount: number;\n11\t  icon: string;\n12\t  color: string;\n13\t}\n14\t\n15\tconst RESOURCE_META: Record<string, { name: string; icon: string; color: string }> = {\n16\t  spirit_stone: { name: '灵石', icon: '💎', color: '#7cc8ff' },\n17\t  spirit_grass: { name: '灵草', icon: '🌿', color: '#6adf6a' },\n18\t  spirit_energy: { name: '灵气', icon: '✨', color: '#b480ff' },\n19\t  cultivation: { name: '修为', icon: '⚡', color: '#ffd700' },\n20\t  pill_juling: { name: '聚灵丹', icon: '💊', color: '#ff8c32' },\n21\t  pill_peiyuan: { name: '培元丹', icon: '💊', color: '#ff6699' },\n22\t  pill_ningqi: { name: '凝气丹', icon: '💊', color: '#cc66ff' },\n23\t  spirit_iron: { name: '灵铁', icon: '🔩', color: '#8a8aaa' },\n24\t};\n25\t\n26\texport function getResourceDisplays(resources: Resources): ResourceDisplay[] {\n27\t  const displays: ResourceDisplay[] = [];\n28\t  for (const [id, meta] of Object.entries(RESOURCE_META)) {\n29\t    displays.push({\n30\t      id,\n31\t      name: meta.name,\n32\t      amount: resources[id as keyof Resources] ?? 0,\n33\t      icon: meta.icon,\n34\t      color: meta.color,\n35\t    });\n36\t  }\n37\t  return displays;\n38\t}\n39\t\n40\t// Manual collection: player clicks a building to collect\n41\texport function collectFromBuilding(\n42\t  state: GameState,\n43\t  building: BuildingInstance,\n44\t  def: BuildingDef,\n45\t  mapIndex: number,\n46\t): GameState {\n47\t  if (def.production.mode !== 'manual') return state;\n48\t\n49\t  const prod = def.production;\n50\t\n51\t  // Check if we need input resources\n52\t  if (prod.input) {\n53\t    const canAfford = Object.entries(prod.input).every(\n54\t      ([res, cost]) => (state.resources[res as keyof Resources] ?? 0) >= cost,\n55\t    );\n56\t    if (!canAfford) return state;\n57\t\n58\t    // Consume input resources\n59\t    const inputDelta: Partial<Resources> = {};\n60\t    for (const [res, cost] of Object.entries(prod.input)) {\n61\t      (inputDelta as Record<string, number>)[res] = -cost;\n62\t    }\n63\t    state = addResources(state, inputDelta);\n64\t  }\n65\t\n66\t  // For fields, check if ready for harvest\n67\t  if (def.category === 'farming') {\n68\t    if (building.progress < 1) return state;\n69\t    // Reset progress after harvest\n70\t    state = updateBuilding(state, mapIndex, building.uid, {\n71\t      progress: 0,\n72\t      isProducing: false,\n73\t    });\n74\t  }\n75\t\n76\t  // Add produced resource\n77\t  const delta: Partial<Resources> = {};\n78\t  (delta as Record<string, number>)[prod.resource] = prod.amount;\n79\t  state = addResources(state, delta);\n80\t\n81\t  // Cultivation gives exp\n82\t  if (prod.resource === 'cultivation') {\n83\t    state = addCultivation(state, prod.amount);\n84\t  }\n85\t\n86\t  return state;\n87\t}\n88\t\n89\t// Plant a field (starts growth timer)\n90\texport function plantField(\n91\t  state: GameState,\n92\t  building: BuildingInstance,\n93\t  mapIndex: number,\n94\t): GameState {\n95\t  return updateBuilding(state, mapIndex, building.uid, {\n96\t    isProducing: true,\n97\t    progress: 0,\n98\t    lastCollectTime: Date.now(),\n99\t  });\n100\t}\n101\t\n102\t// Update auto-production buildings (called every tick)\n103\texport function tickAutoProduction(\n104\t  state: GameState,\n105\t  mapIndex: number,\n106\t  now: number,\n107\t  buildingDefs: Map<string, BuildingDef>,\n108\t): GameState {\n109\t  const map = state.maps[mapIndex];\n110\t  if (!map) return state;\n111\t\n112\t  for (const building of map.buildings) {\n113\t    const def = buildingDefs.get(building.buildingId);\n114\t    if (!def || def.production.mode !== 'auto') continue;\n115\t\n116\t    if (!building.isProducing) {\n117\t      // Start production\n118\t      state = updateBuilding(state, mapIndex, building.uid, {\n119\t        isProducing: true,\n120\t        lastCollectTime: now,\n121\t        progress: 0,\n122\t      });\n123\t      continue;\n124\t    }\n125\t\n126\t    const elapsed = now - building.lastCollectTime;\n127\t    const interval = def.production.interval;\n128\t    const progress = Math.min(1, elapsed / interval);\n129\t\n130\t    if (progress >= 1) {\n131\t      // Production complete — collect and restart\n132\t      const delta: Partial<Resources> = {};\n133\t      (delta as Record<string, number>)[def.production.resource] = def.production.amount;\n134\t      state = addResources(state, delta);\n135\t\n136\t      state = updateBuilding(state, mapIndex, building.uid, {\n137\t        lastCollectTime: now,\n138\t        progress: 0,\n139\t      });\n140\t    } else {\n141\t      state = updateBuilding(state, mapIndex, building.uid, { progress });\n142\t    }\n143\t  }\n144\t\n145\t  return state;\n146\t}\n147\t\n148\t// Tick manual buildings (e.g. field growth)\n149\texport function tickManualProduction(\n150\t  state: GameState,\n151\t  mapIndex: number,\n152\t  now: number,\n153\t  buildingDefs: Map<string, BuildingDef>,\n154\t): GameState {\n155\t  const map = state.maps[mapIndex];\n156\t  if (!map) return state;\n157\t\n158\t  for (const building of map.buildings) {\n159\t    const def = buildingDefs.get(building.buildingId);\n160\t    if (!def || def.production.mode !== 'manual') continue;\n161\t    if (!building.isProducing) continue;\n162\t\n163\t    const elapsed = now - building.lastCollectTime;\n164\t    const interval = def.production.interval;\n165\t    const progress = Math.min(1, elapsed / interval);\n166\t\n167\t    state = updateBuilding(state, mapIndex, building.uid, { progress });\n168\t  }\n169\t\n170\t  return state;\n171\t}\n172\t\n173\t// Format resource amounts for display (e.g. 1200 → \"1.2K\")\n174\texport function formatAmount(amount: number): string {\n175\t  if (amount >= 1_000_000) return (amount / 1_000_000).toFixed(1) + 'M';\n176\t  if (amount >= 10_000) return (amount / 1_000).toFixed(1) + 'K';\n177\t  if (amount >= 1_000) return (amount / 1_000).toFixed(1) + 'K';\n178\t  return Math.floor(amount).toString();\n179\t}\n180\t\n181\t// Check if player can afford a cost\n182\texport function canAfford(resources: Resources, cost: Record<string, number>): boolean {\n183\t  return Object.entries(cost).every(\n184\t    ([res, amount]) => (resources[res as keyof Resources] ?? 0) >= amount,\n185\t  );\n186\t}\n187\t\n188\t// Deduct cost from resources\n189\texport function deductCost(state: GameState, cost: Record<string, number>): GameState {\n190\t  const delta: Partial<Resources> = {};\n191\t  for (const [res, amount] of Object.entries(cost)) {\n192\t    (delta as Record<string, number>)[res] = -amount;\n193\t  }\n194\t  return addResources(state, delta);\n195\t}\n196\t"}]},"parent_tool_use_id":null,"session_id":"c0e01ba0-5708-46af-9590-e43af2395006","uuid":"50478c4c-b565-4178-9f4d-20fa0f852822","timestamp":"2026-05-23T01:34:47.927Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Resources.ts","content":"// Resources.ts — Resource management with manual collection and display\n\nimport type { GameState, Resources, BuildingInstance } from './GameState';\nimport { addResources, addCultivation, updateBuilding } from './GameState';\nimport type { BuildingDef } from './Building';\n\nexport interface ResourceDisplay {\n  id: string;\n  name: string;\n  amount: number;\n  icon: string;\n  color: string;\n}\n\nconst RESOURCE_META: Record<string, { name: string; icon: string; color: string }> = {\n  spirit_stone: { name: '灵石', icon: '💎', color: '#7cc8ff' },\n  spirit_grass: { name: '灵草', icon: '🌿', color: '#6adf6a' },\n  spirit_energy: { name: '灵气', icon: '✨', color: '#b480ff' },\n  cultivation: { name: '修为', icon: '⚡', color: '#ffd700' },\n  pill_juling: { name: '聚灵丹', icon: '💊', color: '#ff8c32' },\n  pill_peiyuan: { name: '培元丹', icon: '💊', color: '#ff6699' },\n  pill_ningqi: { name: '凝气丹', icon: '💊', color: '#cc66ff' },\n  spirit_iron: { name: '灵铁', icon: '🔩', color: '#8a8aaa' },\n};\n\nexport function getResourceDisplays(resources: Resources): ResourceDisplay[] {\n  const displays: ResourceDisplay[] = [];\n  for (const [id, meta] of Object.entries(RESOURCE_META)) {\n    displays.push({\n      id,\n      name: meta.name,\n      amount: resources[id as keyof Resources] ?? 0,\n      icon: meta.icon,\n      color: meta.color,\n    });\n  }\n  return displays;\n}\n\n// Manual collection: player clicks a building to collect\nexport function collectFromBuilding(\n  state: GameState,\n  building: BuildingInstance,\n  def: BuildingDef,\n  mapIndex: number,\n): GameState {\n  if (def.production.mode !== 'manual') return state;\n\n  const prod = def.production;\n\n  // Check if we need input resources\n  if (prod.input) {\n    const canAfford = Object.entries(prod.input).every(\n      ([res, cost]) => (state.resources[res as keyof Resources] ?? 0) >= cost,\n    );\n    if (!canAfford) return state;\n\n    // Consume input resources\n    const inputDelta: Partial<Resources> = {};\n    for (const [res, cost] of Object.entries(prod.input)) {\n      (inputDelta as Record<string, number>)[res] = -cost;\n    }\n    state = addResources(state, inputDelta);\n  }\n\n  // For fields, check if ready for harvest\n  if (def.category === 'farming') {\n    if (building.progress < 1) return state;\n    // Reset progress after harvest\n    state = updateBuilding(state, mapIndex, building.uid, {\n      progress: 0,\n      isProducing: false,\n    });\n  }\n\n  // Add produced resource\n  const delta: Partial<Resources> = {};\n  (delta as Record<string, number>)[prod.resource] = prod.amount;\n  state = addResources(state, delta);\n\n  // Cultivation gives exp\n  if (prod.resource === 'cultivation') {\n    state = addCultivation(state, prod.amount);\n  }\n\n  return state;\n}\n\n// Plant a field (starts growth timer)\nexport function plantField(\n  state: GameState,\n  building: BuildingInstance,\n  mapIndex: number,\n): GameState {\n  return updateBuilding(state, mapIndex, building.uid, {\n    isProducing: true,\n    progress: 0,\n    lastCollectTime: Date.now(),\n  });\n}\n\n// Update auto-production buildings (called every tick)\nexport function tickAutoProduction(\n  state: GameState,\n  mapIndex: number,\n  now: number,\n  buildingDefs: Map<string, BuildingDef>,\n): GameState {\n  const map = state.maps[mapIndex];\n  if (!map) return state;\n\n  for (const building of map.buildings) {\n    const def = buildingDefs.get(building.buildingId);\n    if (!def || def.production.mode !== 'auto') continue;\n\n    if (!building.isProducing) {\n      // Start production\n      state = updateBuilding(state, mapIndex, building.uid, {\n        isProducing: true,\n        lastCollectTime: now,\n        progress: 0,\n      });\n      continue;\n    }\n\n    const elapsed = now - building.lastCollectTime;\n    const interval = def.production.interval;\n    const progress = Math.min(1, elapsed / interval);\n\n    if (progress >= 1) {\n      // Production complete — collect and restart\n      const delta: Partial<Resources> = {};\n      (delta as Record<string, number>)[def.production.resource] = def.production.amount;\n      state = addResources(state, delta);\n\n      state = updateBuilding(state, mapIndex, building.uid, {\n        lastCollectTime: now,\n        progress: 0,\n      });\n    } else {\n      state = updateBuilding(state, mapIndex, building.uid, { progress });\n    }\n  }\n\n  return state;\n}\n\n// Tick manual buildings (e.g. field growth)\nexport function tickManualProduction(\n  state: GameState,\n  mapIndex: number,\n  now: number,\n  buildingDefs: Map<string, BuildingDef>,\n): GameState {\n  const map = state.maps[mapIndex];\n  if (!map) return state;\n\n  for (const building of map.buildings) {\n    const def = buildingDefs.get(building.buildingId);\n    if (!def || def.production.mode !== 'manual') continue;\n    if (!building.isProducing) continue;\n\n    const elapsed = now - building.lastCollectTime;\n    const interval = def.production.interval;\n    const progress = Math.min(1, elapsed / interval);\n\n    state = updateBuilding(state, mapIndex, building.uid, { progress });\n  }\n\n  return state;\n}\n\n// Format resource amounts for display (e.g. 1200 → \"1.2K\")\nexport function formatAmount(amount: number): string {\n  if (amount >= 1_000_000) return (amount / 1_000_000).toFixed(1) + 'M';\n  if (amount >= 10_000) return (amount / 1_000).toFixed(1) + 'K';\n  if (amount >= 1_000) return (amount / 1_000).toFixed(1) + 'K';\n  return Math.floor(amount).toString();\n}\n\n// Check if player can afford a cost\nexport function canAfford(resources: Resources, cost: Record<string, number>): boolean {\n  return Object.entries(cost).every(\n    ([res, amount]) => (resources[res as keyof Resources] ?? 0) >= amount,\n  );\n}\n\n// Deduct cost from resources\nexport function deductCost(state: GameState, cost: Record<string, number>): GameState {\n  const delta: Partial<Resources> = {};\n  for (const [res, amount] of Object.entries(cost)) {\n    (delta as Record<string, number>)[res] = -amount;\n  }\n  return addResources(state, delta);\n}\n","numLines":196,"startLine":1,"totalLines":196}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_c0e098f76cf0416bb519401b","type":"tool_result","content":"1\t// Building.ts — Building placement system with grid validation\n2\t\n3\timport type { BuildingInstance } from './GameState';\n4\timport { GameMap, Terrain } from './Map';\n5\t\n6\texport interface BuildingDef {\n7\t  id: string;\n8\t  name: string;\n9\t  nameEn: string;\n10\t  type: string;\n11\t  category: string;\n12\t  cost: Record<string, number>;\n13\t  size: { w: number; h: number };\n14\t  production: {\n15\t    resource: string;\n16\t    amount: number;\n17\t    interval: number;\n18\t    mode: string;\n19\t    input?: Record<string, number>;\n20\t  };\n21\t  description: string;\n22\t  unlockRealm: string;\n23\t  maxLevel: number;\n24\t  color: { r: number; g: number; b: number; a: number };\n25\t}\n26\t\n27\tlet uidCounter = 0;\n28\t\n29\texport function generateUid(): string {\n30\t  return `b_${Date.now()}_${++uidCounter}`;\n31\t}\n32\t\n33\texport function createBuildingInstance(\n34\t  buildingId: string,\n35\t  gridX: number,\n36\t  gridY: number,\n37\t): BuildingInstance {\n38\t  return {\n39\t    uid: generateUid(),\n40\t    buildingId,\n41\t    gridX,\n42\t    gridY,\n43\t    level: 1,\n44\t    lastCollectTime: 0,\n45\t    isProducing: false,\n46\t    progress: 0,\n47\t  };\n48\t}\n49\t\n50\t// Check if a building can be placed at the given position\n51\texport function canPlace(\n52\t  map: GameMap,\n53\t  def: BuildingDef,\n54\t  gridX: number,\n55\t  gridY: number,\n56\t  existingBuildings: BuildingInstance[],\n57\t): boolean {\n58\t  // Build occupied set from existing buildings\n59\t  const occupied = buildOccupiedSet(existingBuildings);\n60\t\n61\t  // Check the area is free\n62\t  if (!map.isAreaFree(gridX, gridY, def.size.w, def.size.h, occupied)) {\n63\t    return false;\n64\t  }\n65\t\n66\t  // Spirit vein buildings should be near spirit veins\n67\t  if (def.category === 'mining') {\n68\t    let nearVein = false;\n69\t    for (let dy = -1; dy <= def.size.h && !nearVein; dy++) {\n70\t      for (let dx = -1; dx <= def.size.w && !nearVein; dx++) {\n71\t        const t = map.getTerrain(gridX + dx, gridY + dy);\n72\t        if (t === Terrain.SpiritVein) nearVein = true;\n73\t      }\n74\t    }\n75\t    // Allow placement anywhere for now (relaxed constraint for M1)\n76\t  }\n77\t\n78\t  return true;\n79\t}\n80\t\n81\t// Get all grid cells occupied by a building\n82\texport function getBuildingCells(building: BuildingInstance, def: BuildingDef): string[] {\n83\t  const cells: string[] = [];\n84\t  for (let dy = 0; dy < def.size.h; dy++) {\n85\t    for (let dx = 0; dx < def.size.w; dx++) {\n86\t      cells.push(`${building.gridX + dx},${building.gridY + dy}`);\n87\t    }\n88\t  }\n89\t  return cells;\n90\t}\n91\t\n92\t// Build a set of occupied grid positions\n93\texport function buildOccupiedSet(buildings: BuildingInstance[], defs?: Map<string, BuildingDef>): Set<string> {\n94\t  const occupied = new Set<string>();\n95\t  for (const b of buildings) {\n96\t    const size = defs?.get(b.buildingId)?.size ?? { w: 1, h: 1 };\n97\t    for (let dy = 0; dy < size.h; dy++) {\n98\t      for (let dx = 0; dx < size.w; dx++) {\n99\t        occupied.add(`${b.gridX + dx},${b.gridY + dy}`);\n100\t      }\n101\t    }\n102\t  }\n103\t  return occupied;\n104\t}\n105\t\n106\t// Render a building on canvas\n107\texport function renderBuilding(\n108\t  ctx: CanvasRenderingContext2D,\n109\t  building: BuildingInstance,\n110\t  def: BuildingDef,\n111\t  offsetX: number,\n112\t  offsetY: number,\n113\t  scale: number,\n114\t  cellSize: number,\n115\t  now: number,\n116\t): void {\n117\t  const x = offsetX + building.gridX * cellSize * scale;\n118\t  const y = offsetY + building.gridY * cellSize * scale;\n119\t  const w = def.size.w * cellSize * scale;\n120\t  const h = def.size.h * cellSize * scale;\n121\t\n122\t  const { r, g, b, a } = def.color;\n123\t\n124\t  // Building body\n125\t  ctx.fillStyle = `rgba(${r},${g},${b},${a})`;\n126\t  ctx.fillRect(x + 2, y + 2, w - 4, h - 4);\n127\t\n128\t  // Border\n129\t  ctx.strokeStyle = `rgba(${Math.min(255, r + 40)},${Math.min(255, g + 40)},${Math.min(255, b + 40)},0.8)`;\n130\t  ctx.lineWidth = 1.5;\n131\t  ctx.strokeRect(x + 2, y + 2, w - 4, h - 4);\n132\t\n133\t  // Icon/label\n134\t  const fontSize = Math.max(8, Math.floor(10 * scale));\n135\t  ctx.fillStyle = '#fff';\n136\t  ctx.font = `bold ${fontSize}px monospace`;\n137\t  ctx.textAlign = 'center';\n138\t  ctx.textBaseline = 'middle';\n139\t\n140\t  const centerX = x + w / 2;\n141\t  const centerY = y + h / 2;\n142\t\n143\t  // Draw icon based on category\n144\t  const icon = getCategoryIcon(def.category);\n145\t  ctx.font = `${Math.max(12, Math.floor(16 * scale))}px serif`;\n146\t  ctx.fillText(icon, centerX, centerY - 4 * scale);\n147\t\n148\t  // Draw level\n149\t  ctx.font = `bold ${Math.max(6, Math.floor(8 * scale))}px monospace`;\n150\t  ctx.fillStyle = '#ffd700';\n151\t  ctx.fillText(`Lv${building.level}`, centerX, centerY + 10 * scale);\n152\t\n153\t  // Progress bar for auto-production\n154\t  if (def.production.mode === 'auto' && building.isProducing) {\n155\t    const barW = w - 8;\n156\t    const barH = 3 * scale;\n157\t    const barY = y + h - 6 * scale;\n158\t    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n159\t    ctx.fillRect(x + 4, barY, barW, barH);\n160\t    ctx.fillStyle = '#4f4';\n161\t    ctx.fillRect(x + 4, barY, barW * building.progress, barH);\n162\t  }\n163\t\n164\t  // Production ready indicator (for manual buildings)\n165\t  if (def.production.mode === 'manual' && building.progress >= 1) {\n166\t    ctx.fillStyle = '#ff0';\n167\t    ctx.beginPath();\n168\t    ctx.arc(x + w - 6 * scale, y + 6 * scale, 3 * scale, 0, Math.PI * 2);\n169\t    ctx.fill();\n170\t  }\n171\t}\n172\t\n173\tfunction getCategoryIcon(category: string): string {\n174\t  const icons: Record<string, string> = {\n175\t    mining: '⛏',\n176\t    farming: '🌿',\n177\t    alchemy: '🔥',\n178\t    energy: '✨',\n179\t    transport: '➡',\n180\t    control: '📜',\n181\t  };\n182\t  return icons[category] || '🏠';\n183\t}\n184\t\n185\t// Parse building definitions from JSON\n186\texport function loadBuildingDefs(data: { buildings: BuildingDef[] }): Map<string, BuildingDef> {\n187\t  const map = new Map<string, BuildingDef>();\n188\t  for (const b of data.buildings) {\n189\t    map.set(b.id, b);\n190\t  }\n191\t  return map;\n192\t}\n193\t"}]},"parent_tool_use_id":null,"session_id":"c0e01ba0-5708-46af-9590-e43af2395006","uuid":"1b0f65f6-925d-4712-abaa-ff024d0825de","timestamp":"2026-05-23T01:34:47.930Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Building.ts","content":"// Building.ts — Building placement system with grid validation\n\nimport type { BuildingInstance } from './GameState';\nimport { GameMap, Terrain } from './Map';\n\nexport interface BuildingDef {\n  id: string;\n  name: string;\n  nameEn: string;\n  type: string;\n  category: string;\n  cost: Record<string, number>;\n  size: { w: number; h: number };\n  production: {\n    resource: string;\n    amount: number;\n    interval: number;\n    mode: string;\n    input?: Record<string, number>;\n  };\n  description: string;\n  unlockRealm: string;\n  maxLevel: number;\n  color: { r: number; g: number; b: number; a: number };\n}\n\nlet uidCounter = 0;\n\nexport function generateUid(): string {\n  return `b_${Date.now()}_${++uidCounter}`;\n}\n\nexport function createBuildingInstance(\n  buildingId: string,\n  gridX: number,\n  gridY: number,\n): BuildingInstance {\n  return {\n    uid: generateUid(),\n    buildingId,\n    gridX,\n    gridY,\n    level: 1,\n    lastCollectTime: 0,\n    isProducing: false,\n    progress: 0,\n  };\n}\n\n// Check if a building can be placed at the given position\nexport function canPlace(\n  map: GameMap,\n  def: BuildingDef,\n  gridX: number,\n  gridY: number,\n  existingBuildings: BuildingInstance[],\n): boolean {\n  // Build occupied set from existing buildings\n  const occupied = buildOccupiedSet(existingBuildings);\n\n  // Check the area is free\n  if (!map.isAreaFree(gridX, gridY, def.size.w, def.size.h, occupied)) {\n    return false;\n  }\n\n  // Spirit vein buildings should be near spirit veins\n  if (def.category === 'mining') {\n    let nearVein = false;\n    for (let dy = -1; dy <= def.size.h && !nearVein; dy++) {\n      for (let dx = -1; dx <= def.size.w && !nearVein; dx++) {\n        const t = map.getTerrain(gridX + dx, gridY + dy);\n        if (t === Terrain.SpiritVein) nearVein = true;\n      }\n    }\n    // Allow placement anywhere for now (relaxed constraint for M1)\n  }\n\n  return true;\n}\n\n// Get all grid cells occupied by a building\nexport function getBuildingCells(building: BuildingInstance, def: BuildingDef): string[] {\n  const cells: string[] = [];\n  for (let dy = 0; dy < def.size.h; dy++) {\n    for (let dx = 0; dx < def.size.w; dx++) {\n      cells.push(`${building.gridX + dx},${building.gridY + dy}`);\n    }\n  }\n  return cells;\n}\n\n// Build a set of occupied grid positions\nexport function buildOccupiedSet(buildings: BuildingInstance[], defs?: Map<string, BuildingDef>): Set<string> {\n  const occupied = new Set<string>();\n  for (const b of buildings) {\n    const size = defs?.get(b.buildingId)?.size ?? { w: 1, h: 1 };\n    for (let dy = 0; dy < size.h; dy++) {\n      for (let dx = 0; dx < size.w; dx++) {\n        occupied.add(`${b.gridX + dx},${b.gridY + dy}`);\n      }\n    }\n  }\n  return occupied;\n}\n\n// Render a building on canvas\nexport function renderBuilding(\n  ctx: CanvasRenderingContext2D,\n  building: BuildingInstance,\n  def: BuildingDef,\n  offsetX: number,\n  offsetY: number,\n  scale: number,\n  cellSize: number,\n  now: number,\n): void {\n  const x = offsetX + building.gridX * cellSize * scale;\n  const y = offsetY + building.gridY * cellSize * scale;\n  const w = def.size.w * cellSize * scale;\n  const h = def.size.h * cellSize * scale;\n\n  const { r, g, b, a } = def.color;\n\n  // Building body\n  ctx.fillStyle = `rgba(${r},${g},${b},${a})`;\n  ctx.fillRect(x + 2, y + 2, w - 4, h - 4);\n\n  // Border\n  ctx.strokeStyle = `rgba(${Math.min(255, r + 40)},${Math.min(255, g + 40)},${Math.min(255, b + 40)},0.8)`;\n  ctx.lineWidth = 1.5;\n  ctx.strokeRect(x + 2, y + 2, w - 4, h - 4);\n\n  // Icon/label\n  const fontSize = Math.max(8, Math.floor(10 * scale));\n  ctx.fillStyle = '#fff';\n  ctx.font = `bold ${fontSize}px monospace`;\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n\n  const centerX = x + w / 2;\n  const centerY = y + h / 2;\n\n  // Draw icon based on category\n  const icon = getCategoryIcon(def.category);\n  ctx.font = `${Math.max(12, Math.floor(16 * scale))}px serif`;\n  ctx.fillText(icon, centerX, centerY - 4 * scale);\n\n  // Draw level\n  ctx.font = `bold ${Math.max(6, Math.floor(8 * scale))}px monospace`;\n  ctx.fillStyle = '#ffd700';\n  ctx.fillText(`Lv${building.level}`, centerX, centerY + 10 * scale);\n\n  // Progress bar for auto-production\n  if (def.production.mode === 'auto' && building.isProducing) {\n    const barW = w - 8;\n    const barH = 3 * scale;\n    const barY = y + h - 6 * scale;\n    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n    ctx.fillRect(x + 4, barY, barW, barH);\n    ctx.fillStyle = '#4f4';\n    ctx.fillRect(x + 4, barY, barW * building.progress, barH);\n  }\n\n  // Production ready indicator (for manual buildings)\n  if (def.production.mode === 'manual' && building.progress >= 1) {\n    ctx.fillStyle = '#ff0';\n    ctx.beginPath();\n    ctx.arc(x + w - 6 * scale, y + 6 * scale, 3 * scale, 0, Math.PI * 2);\n    ctx.fill();\n  }\n}\n\nfunction getCategoryIcon(category: string): string {\n  const icons: Record<string, string> = {\n    mining: '⛏',\n    farming: '🌿',\n    alchemy: '🔥',\n    energy: '✨',\n    transport: '➡',\n    control: '📜',\n  };\n  return icons[category] || '🏠';\n}\n\n// Parse building definitions from JSON\nexport function loadBuildingDefs(data: { buildings: BuildingDef[] }): Map<string, BuildingDef> {\n  const map = new Map<string, BuildingDef>();\n  for (const b of data.buildings) {\n    map.set(b.id, b);\n  }\n  return map;\n}\n","numLines":193,"startLine":1,"totalLines":193}}}
