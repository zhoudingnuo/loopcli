{"type":"assistant","message":{"id":"msg_2026052312032918373841ce7743a6","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_6f1b76775cb84252bbb0b803","name":"Write","input":{"file_path":"D:\\game-projects\\steam-horror-sim\\src\\game\\CashRegister.ts","content":"// CashRegister.ts — Checkout system with change-giving and anomaly events (M2)\n\nimport { Customer, CustomerState, CartItem } from './Customer';\nimport { ProductManager } from './ProductManager';\nimport { PricingSystem } from './PricingSystem';\n\nexport enum RegisterState {\n  IDLE = 'idle',\n  SCANNING = 'scanning',\n  PAYMENT = 'payment',\n  GIVING_CHANGE = 'giving_change',\n  RECEIPT = 'receipt',\n  ANOMALY = 'anomaly',\n}\n\nexport interface Transaction {\n  customerId: string;\n  items: CartItem[];\n  subtotal: number;\n  tax: number;\n  total: number;\n  paid: number;\n  change: number;\n  timestamp: number;\n  isAnomalous: boolean;\n}\n\nexport class CashRegister {\n  state: RegisterState = RegisterState.IDLE;\n  currentCustomer: Customer | null = null;\n  currentTransaction: Transaction | null = null;\n\n  scanIndex = 0;\n  scanTimer = 0;\n  paymentTimer = 0;\n  changeTimer = 0;\n  receiptTimer = 0;\n  anomalyTimer = 0;\n  anomalyMessage: string | null = null;\n\n  registerId: string;\n  speedMultiplier = 1.0;\n\n  transactionHistory: Transaction[] = [];\n  dailyTotal = 0;\n  dailyTransactions = 0;\n\n  constructor(registerId: string) {\n    this.registerId = registerId;\n  }\n\n  canAcceptCustomer(): boolean {\n    return this.state === RegisterState.IDLE;\n  }\n\n  startCheckout(customer: Customer, productManager: ProductManager, pricing: PricingSystem): boolean {\n    if (this.state !== RegisterState.IDLE) return false;\n    if (customer.cart.length === 0) {\n      customer.finishCheckout();\n      return false;\n    }\n\n    this.currentCustomer = customer;\n    customer.startCheckout();\n    this.state = RegisterState.SCANNING;\n    this.scanIndex = 0;\n    this.scanTimer = 0;\n\n    // Calculate prices\n    const items: CartItem[] = [];\n    let subtotal = 0;\n    for (const item of customer.cart) {\n      const price = pricing.getPrice(item.productId);\n      items.push({ productId: item.productId, price });\n      subtotal += price;\n\n      // Take from shelf\n      const shelfId = this.findProductShelf(item.productId, productManager);\n      if (shelfId) {\n        productManager.takeFromShelf(shelfId);\n      }\n    }\n\n    const tax = Math.round(subtotal * 0.06 * 100) / 100;\n    const total = Math.round((subtotal + tax) * 100) / 100;\n    const isAnomalous = customer.type === 'night' || items.some(i => {\n      const p = productManager.getProduct(i.productId);\n      return p?.isAnomalous;\n    });\n\n    this.currentTransaction = {\n      customerId: customer.id,\n      items,\n      subtotal,\n      tax,\n      total,\n      paid: 0,\n      change: 0,\n      timestamp: Date.now(),\n      isAnomalous,\n    };\n\n    return true;\n  }\n\n  update(dt: number): Transaction | null {\n    const dtSec = dt / 1000 * this.speedMultiplier;\n\n    switch (this.state) {\n      case RegisterState.SCANNING:\n        this.scanTimer += dtSec;\n        if (this.scanTimer > 0.5) {\n          this.scanTimer = 0;\n          this.scanIndex++;\n          if (this.scanIndex >= (this.currentTransaction?.items.length ?? 0)) {\n            this.state = RegisterState.PAYMENT;\n            this.paymentTimer = 0;\n          }\n        }\n        break;\n\n      case RegisterState.PAYMENT:\n        this.paymentTimer += dtSec;\n        if (this.paymentTimer > 1.0) {\n          if (this.currentTransaction) {\n            this.currentTransaction.paid = Math.ceil(this.currentTransaction.total);\n            this.currentTransaction.change = Math.round(\n              (this.currentTransaction.paid - this.currentTransaction.total) * 100\n            ) / 100;\n          }\n          this.state = RegisterState.GIVING_CHANGE;\n          this.changeTimer = 0;\n        }\n        break;\n\n      case RegisterState.GIVING_CHANGE:\n        this.changeTimer += dtSec;\n        if (this.changeTimer > 0.8) {\n          this.state = RegisterState.RECEIPT;\n          this.receiptTimer = 0;\n        }\n        break;\n\n      case RegisterState.RECEIPT:\n        this.receiptTimer += dtSec;\n        if (this.receiptTimer > 0.5) {\n          return this.completeTransaction();\n        }\n        break;\n\n      case RegisterState.ANOMALY:\n        this.anomalyTimer += dtSec;\n        if (this.anomalyTimer > 2.0) {\n          this.reset();\n        }\n        break;\n    }\n\n    return null;\n  }\n\n  private completeTransaction(): Transaction | null {\n    if (!this.currentTransaction) {\n      this.reset();\n      return null;\n    }\n\n    const txn = { ...this.currentTransaction };\n    this.transactionHistory.push(txn);\n    this.dailyTotal += txn.total;\n    this.dailyTransactions++;\n\n    if (txn.isAnomalous && Math.random() < 0.3) {\n      this.triggerAnomaly(txn);\n      return txn;\n    }\n\n    if (this.currentCustomer) {\n      this.currentCustomer.totalSpent = txn.total;\n    }\n\n    this.reset();\n    return txn;\n  }\n\n  private triggerAnomaly(txn: Transaction): void {\n    const anomalies = [\n      '收银机自动打开...金额显示异常',\n      '收据打印出不属于今天的日期',\n      '收银机里多出了不该存在的硬币',\n      '找零的纸币上写着奇怪的数字',\n    ];\n    this.anomalyMessage = anomalies[Math.floor(Math.random() * anomalies.length)];\n    this.state = RegisterState.ANOMALY;\n    this.anomalyTimer = 0;\n  }\n\n  private reset(): void {\n    this.currentCustomer = null;\n    this.currentTransaction = null;\n    this.scanIndex = 0;\n    this.state = RegisterState.IDLE;\n    this.anomalyMessage = null;\n  }\n\n  private findProductShelf(productId: string, pm: ProductManager): string | null {\n    for (const [shelfId, slot] of pm.shelfSlots) {\n      if (slot.productId === productId && slot.quantity > 0) {\n        return shelfId;\n      }\n    }\n    return null;\n  }\n\n  resetDaily(): void {\n    this.dailyTotal = 0;\n    this.dailyTransactions = 0;\n  }\n\n  applySpeedUpgrade(multiplier: number): void {\n    this.speedMultiplier = 1 + multiplier;\n  }\n\n  getSaveData(): Record<string, unknown> {\n    return {\n      dailyTotal: this.dailyTotal,\n      dailyTransactions: this.dailyTransactions,\n      transactionHistory: this.transactionHistory.slice(-50),\n      speedMultiplier: this.speedMultiplier,\n    };\n  }\n\n  loadSaveData(data: Record<string, unknown>): void {\n    this.dailyTotal = (data.dailyTotal as number) ?? 0;\n    this.dailyTransactions = (data.dailyTransactions as number) ?? 0;\n    if (data.transactionHistory) this.transactionHistory = data.transactionHistory as Transaction[];\n    if (data.speedMultiplier) this.speedMultiplier = data.speedMultiplier as number;\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"e4781836-91b7-498e-bc35-c2b84a36028a","uuid":"a0fdff98-024d-4296-b93d-2be50ecf8928"}
