{"type":"assistant","message":{"id":"msg_202605231204061ee4e38450c84c3a","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_c0d166d6b3114b5db02f835c","name":"Write","input":{"file_path":"D:\\game-projects\\steam-horror-sim\\src\\game\\PricingSystem.ts","content":"// PricingSystem.ts — Dynamic pricing with demand sensitivity (M2)\n\nimport { ProductManager } from './ProductManager';\n\nexport interface PriceEntry {\n  productId: string;\n  currentPrice: number;\n  basePrice: number;\n  minPrice: number;\n  maxPrice: number;\n  demandMultiplier: number;\n}\n\nexport class PricingSystem {\n  prices: Map<string, PriceEntry> = new Map();\n  globalMarkup = 1.0;\n  salesVelocity: Map<string, number> = new Map();\n\n  constructor(productManager: ProductManager) {\n    for (const product of productManager.products) {\n      const base = product.basePrice;\n      this.prices.set(product.id, {\n        productId: product.id,\n        currentPrice: base,\n        basePrice: base,\n        minPrice: Math.round(base * 0.5 * 100) / 100,\n        maxPrice: Math.round(base * 2.0 * 100) / 100,\n        demandMultiplier: 1.0,\n      });\n      this.salesVelocity.set(product.id, 0);\n    }\n  }\n\n  getPrice(productId: string): number {\n    const entry = this.prices.get(productId);\n    if (!entry) return 0;\n    return Math.round(entry.currentPrice * this.globalMarkup * 100) / 100;\n  }\n\n  setPrice(productId: string, price: number): boolean {\n    const entry = this.prices.get(productId);\n    if (!entry) return false;\n    entry.currentPrice = Math.max(entry.minPrice, Math.min(entry.maxPrice, price));\n    return true;\n  }\n\n  adjustPriceByPercent(productId: string, percent: number): boolean {\n    const entry = this.prices.get(productId);\n    if (!entry) return false;\n    const newPrice = entry.currentPrice * (1 + percent / 100);\n    return this.setPrice(productId, Math.round(newPrice * 100) / 100);\n  }\n\n  recordSale(productId: string): void {\n    const current = this.salesVelocity.get(productId) ?? 0;\n    this.salesVelocity.set(productId, current + 1);\n  }\n\n  updateDemand(timeOfDay: number): void {\n    for (const [id, entry] of this.prices) {\n      let demand = 1.0;\n\n      // Time-based demand modifiers\n      if (timeOfDay >= 7 && timeOfDay < 9) {\n        // Morning: beverages and snacks up\n        if (id.includes('water') || id.includes('milk') || id.includes('bread') || id.includes('biscuit')) {\n          demand = 1.3;\n        }\n      } else if (timeOfDay >= 11.5 && timeOfDay < 13) {\n        // Lunch: bentos up\n        if (id.includes('bento') || id.includes('drink')) {\n          demand = 1.4;\n        }\n      } else if (timeOfDay >= 15 && timeOfDay < 18) {\n        // Afternoon: snacks up\n        if (id.includes('chip') || id.includes('candy') || id.includes('chocolate')) {\n          demand = 1.2;\n        }\n      } else if (timeOfDay >= 23 || timeOfDay < 2) {\n        // Night: everything slightly down except anomalous\n        if (id.includes('strange') || id.includes('photo') || id.includes('envelope')) {\n          demand = 2.0;\n        } else {\n          demand = 0.7;\n        }\n      }\n\n      // Price sensitivity: higher price = lower demand\n      const priceRatio = entry.currentPrice / entry.basePrice;\n      if (priceRatio > 1.5) {\n        demand *= 0.5;\n      } else if (priceRatio > 1.2) {\n        demand *= 0.8;\n      } else if (priceRatio < 0.8) {\n        demand *= 1.3;\n      }\n\n      entry.demandMultiplier = Math.round(demand * 100) / 100;\n    }\n  }\n\n  getDemandMultiplier(productId: string): number {\n    return this.prices.get(productId)?.demandMultiplier ?? 1.0;\n  }\n\n  willCustomerBuy(productId: string, customerSensitivity: number): boolean {\n    const entry = this.prices.get(productId);\n    if (!entry) return false;\n\n    const priceRatio = entry.currentPrice / entry.basePrice;\n    // Higher sensitivity = less tolerant of markup\n    const tolerance = 1.0 + (1 - customerSensitivity) * 1.0;\n    return priceRatio <= tolerance && Math.random() < entry.demandMultiplier * 0.7;\n  }\n\n  resetDailyVelocity(): void {\n    for (const [id] of this.salesVelocity) {\n      this.salesVelocity.set(id, 0);\n    }\n  }\n\n  getAllPrices(): PriceEntry[] {\n    return Array.from(this.prices.values());\n  }\n\n  getSaveData(): Record<string, unknown> {\n    return {\n      prices: Array.from(this.prices.entries()),\n      globalMarkup: this.globalMarkup,\n    };\n  }\n\n  loadSaveData(data: Record<string, unknown>): void {\n    if (data.prices) this.prices = new Map(data.prices as [string, PriceEntry][]);\n    if (data.globalMarkup !== undefined) this.globalMarkup = data.globalMarkup as number;\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"e4781836-91b7-498e-bc35-c2b84a36028a","uuid":"e8d2a220-b4ad-406f-aed3-aba9966e9d45"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_c0d166d6b3114b5db02f835c","type":"tool_result","content":"File created successfully at: D:\\game-projects\\steam-horror-sim\\src\\game\\PricingSystem.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"e4781836-91b7-498e-bc35-c2b84a36028a","uuid":"d73e9a9c-eca0-49a8-b1bc-b6b6014191b6","timestamp":"2026-05-23T04:04:28.896Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\steam-horror-sim\\src\\game\\PricingSystem.ts","content":"// PricingSystem.ts — Dynamic pricing with demand sensitivity (M2)\n\nimport { ProductManager } from './ProductManager';\n\nexport interface PriceEntry {\n  productId: string;\n  currentPrice: number;\n  basePrice: number;\n  minPrice: number;\n  maxPrice: number;\n  demandMultiplier: number;\n}\n\nexport class PricingSystem {\n  prices: Map<string, PriceEntry> = new Map();\n  globalMarkup = 1.0;\n  salesVelocity: Map<string, number> = new Map();\n\n  constructor(productManager: ProductManager) {\n    for (const product of productManager.products) {\n      const base = product.basePrice;\n      this.prices.set(product.id, {\n        productId: product.id,\n        currentPrice: base,\n        basePrice: base,\n        minPrice: Math.round(base * 0.5 * 100) / 100,\n        maxPrice: Math.round(base * 2.0 * 100) / 100,\n        demandMultiplier: 1.0,\n      });\n      this.salesVelocity.set(product.id, 0);\n    }\n  }\n\n  getPrice(productId: string): number {\n    const entry = this.prices.get(productId);\n    if (!entry) return 0;\n    return Math.round(entry.currentPrice * this.globalMarkup * 100) / 100;\n  }\n\n  setPrice(productId: string, price: number): boolean {\n    const entry = this.prices.get(productId);\n    if (!entry) return false;\n    entry.currentPrice = Math.max(entry.minPrice, Math.min(entry.maxPrice, price));\n    return true;\n  }\n\n  adjustPriceByPercent(productId: string, percent: number): boolean {\n    const entry = this.prices.get(productId);\n    if (!entry) return false;\n    const newPrice = entry.currentPrice * (1 + percent / 100);\n    return this.setPrice(productId, Math.round(newPrice * 100) / 100);\n  }\n\n  recordSale(productId: string): void {\n    const current = this.salesVelocity.get(productId) ?? 0;\n    this.salesVelocity.set(productId, current + 1);\n  }\n\n  updateDemand(timeOfDay: number): void {\n    for (const [id, entry] of this.prices) {\n      let demand = 1.0;\n\n      // Time-based demand modifiers\n      if (timeOfDay >= 7 && timeOfDay < 9) {\n        // Morning: beverages and snacks up\n        if (id.includes('water') || id.includes('milk') || id.includes('bread') || id.includes('biscuit')) {\n          demand = 1.3;\n        }\n      } else if (timeOfDay >= 11.5 && timeOfDay < 13) {\n        // Lunch: bentos up\n        if (id.includes('bento') || id.includes('drink')) {\n          demand = 1.4;\n        }\n      } else if (timeOfDay >= 15 && timeOfDay < 18) {\n        // Afternoon: snacks up\n        if (id.includes('chip') || id.includes('candy') || id.includes('chocolate')) {\n          demand = 1.2;\n        }\n      } else if (timeOfDay >= 23 || timeOfDay < 2) {\n        // Night: everything slightly down except anomalous\n        if (id.includes('strange') || id.includes('photo') || id.includes('envelope')) {\n          demand = 2.0;\n        } else {\n          demand = 0.7;\n        }\n      }\n\n      // Price sensitivity: higher price = lower demand\n      const priceRatio = entry.currentPrice / entry.basePrice;\n      if (priceRatio > 1.5) {\n        demand *= 0.5;\n      } else if (priceRatio > 1.2) {\n        demand *= 0.8;\n      } else if (priceRatio < 0.8) {\n        demand *= 1.3;\n      }\n\n      entry.demandMultiplier = Math.round(demand * 100) / 100;\n    }\n  }\n\n  getDemandMultiplier(productId: string): number {\n    return this.prices.get(productId)?.demandMultiplier ?? 1.0;\n  }\n\n  willCustomerBuy(productId: string, customerSensitivity: number): boolean {\n    const entry = this.prices.get(productId);\n    if (!entry) return false;\n\n    const priceRatio = entry.currentPrice / entry.basePrice;\n    // Higher sensitivity = less tolerant of markup\n    const tolerance = 1.0 + (1 - customerSensitivity) * 1.0;\n    return priceRatio <= tolerance && Math.random() < entry.demandMultiplier * 0.7;\n  }\n\n  resetDailyVelocity(): void {\n    for (const [id] of this.salesVelocity) {\n      this.salesVelocity.set(id, 0);\n    }\n  }\n\n  getAllPrices(): PriceEntry[] {\n    return Array.from(this.prices.values());\n  }\n\n  getSaveData(): Record<string, unknown> {\n    return {\n      prices: Array.from(this.prices.entries()),\n      globalMarkup: this.globalMarkup,\n    };\n  }\n\n  loadSaveData(data: Record<string, unknown>): void {\n    if (data.prices) this.prices = new Map(data.prices as [string, PriceEntry][]);\n    if (data.globalMarkup !== undefined) this.globalMarkup = data.globalMarkup as number;\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
