n    this.currentLevel = levelNum;\n    const levelConfig = LEVELS.find(l => l.id === levelNum) || LEVELS[0];\n\n    this.lives = levelConfig.lives;\n    this.score = 0;\n    this.correctCount = 0;\n    this.questionCount = 0;\n    this.idiomEngine.reset();\n    this.combo.reset();\n\n    this.updateUI();\n    this.showScreen('game-screen');\n    this.nextQuestion();\n  }\n\n  nextQuestion() {\n    const levelConfig = LEVELS.find(l => l.id === this.currentLevel) || LEVELS[0];\n\n    if (this.questionCount >= levelConfig.questions) {\n      this.completeLevel();\n      return;\n    }\n\n    this.currentQuestion = this.idiomEngine.generateQuestion(levelConfig);\n    this.judge.reset();\n    this.usedCandidates = [];\n\n    this.renderQuestion();\n  }\n\n  renderQuestion() {\n    const q = this.currentQuestion;\n\n    // 显示释义\n    document.getElementById('meaning').textContent = q.idiom.meaning;\n\n    // 显示空位\n    const slotsContainer = document.getElementById('slots');\n    slotsContainer.innerHTML = '';\n    for (let i = 0; i < 4; i++) {\n      const slot = document.createElement('div');\n      slot.className = 'slot';\n      slot.onclick = () => this.onSlotClick(i);\n      slotsContainer.appendChild(slot);\n    }\n\n    // 显示候选字\n    const candidatesContainer = document.getElementById('candidates');\n    candidatesContainer.innerHTML = '';\n    q.candidates.forEach((char, index) => {\n      const btn = document.createElement('button');\n      btn.className = 'candidate';\n      btn.textContent = char;\n      btn.onclick = () => this.onCandidateClick(char, index, btn);\n      candidatesContainer.appendChild(btn);\n    });\n\n    document.getElementById('level-num').textContent = this.currentLevel;\n  }\n\n  onCandidateClick(char, index, btn) {\n    if (this.usedCandidates.includes(index)) return;\n\n    const fillCount = this.judge.getFillCount();\n    if (fillCount >= 4) return;\n\n    this.judge.fillSlot(char, fillCount);\n    this.usedCandidates.push(index);\n    btn.classList.add('used');\n\n    this.audio.play('click');\n    this.updateSlotsDisplay();\n\n    if (fillCount + 1 === 4) {\n      this.checkAnswer();\n    }\n  }\n\n  onSlotClick(index) {\n    const fillCount = this.judge.getFillCount();\n    if (index >= fillCount) return;\n\n    // 找到对应候选字并恢复\n    this.judge.clearSlot(index);\n    this.usedCandidates.pop();\n    this.restoreCandidateButtons();\n\n    this.updateSlotsDisplay();\n    this.audio.play('click');\n  }\n\n  restoreCandidateButtons() {\n    const candidates = document.querySelectorAll('.candidate');\n    candidates.forEach((btn, i) => {\n      if (!this.usedCandidates.includes(i)) {\n        btn.classList.remove('used');\n      }\n    });\n  }\n\n  updateSlotsDisplay() {\n    const slots = document.querySelectorAll('.slot');\n    const currentSlots = this.judge.getSlots();\n\n    slots.forEach((slot, i) => {\n      slot.textContent = currentSlots[i] || '';\n      slot.className = 'slot' + (currentSlots[i] ? ' filled' : '');\n    });\n  }\n\n  checkAnswer() {\n    const q = this.currentQuestion;\n    const result = this.judge.checkAnswer(q.correctAnswer);\n\n    if (result.correct) {\n      this.onCorrectAnswer();\n    } else {\n      this.onWrongAnswer();\n    }\n  }\n\n  onCorrectAnswer() {\n    this.correctCount++;\n    this.questionCount++;\n    this.score += 100 + this.combo.increment();\n\n    const slots = document.querySelectorAll('.slot');\n    slots.forEach(s => s.classList.add('correct'));\n\n    this.audio.play('correct');\n\n    setTimeout(() => {\n      this.updateUI();\n      this.nextQuestion();\n    }, 1000);\n  }\n\n  onWrongAnswer() {\n    this.lives--;\n    this.combo.reset();\n    this.questionCount++;\n\n    const slots = document.querySelectorAll('.slot');\n    slots.forEach(s => s.classList.add('wrong'));\n\n    this.audio.play('wrong');\n\n    setTimeout(() => {\n      this.judge.reset();\n      this.usedCandidates = [];\n      this.restoreCandidateButtons();\n      this.updateSlotsDisplay();\n\n      if (this.lives <= 0) {\n        this.failLevel();\n      } else {\n        this.updateUI();\n        this.nextQuestion();\n      }\n    }, 800);\n  }\n\n  updateUI() {\n    document.getElementById('lives-count').textContent = this.lives;\n    document.getElementById('score').textContent = this.score;\n  }\n\n  completeLevel() {\n    const levelConfig = LEVELS.find(l => l.id === this.currentLevel) || LEVELS[0];\n\n    // 计算星级\n    let stars = 0;\n    if (this.correctCount >= levelConfig.stars[2]) stars = 3;\n    else if (this.correctCount >= levelConfig.stars[1]) stars = 2;\n    else if (this.correctCount >= levelConfig.stars[0]) stars = 1;\n\n    // 显示结算\n    document.getElementById('result-text').textContent = stars > 0 ? '通关!' : '失败';\n    document.getElementById('final-score').textContent = this.score;\n    document.getElementById('coins-earned').textContent = levelConfig.reward.coins * stars;\n\n    const starsContainer = document.getElementById('stars');\n    starsContainer.innerHTML = '';\n    for (let i = 0; i < 3; i++) {\n      const star = document.createElement('span');\n      star.className = 'star' + (i < stars ? '' : ' empty');\n      star.textContent = '★';\n      starsContainer.appendChild(star);\n    }\n\n    this.audio.play('levelComplete');\n    this.showScreen('result-screen');\n  }\n\n  failLevel() {\n    document.getElementById('result-text').textContent = '失败';\n    document.getElementById('final-score').textContent = this.score;\n    document.getElementById('coins-earned').textContent = '0';\n\n    const starsContainer = document.getElementById('stars');\n    starsContainer.innerHTML = '<span class=\"star empty\">★</span><span class=\"star empty\">★</span><span class=\"star empty\">★</span>';\n\n    this.audio.play('wrong');\n    this.showScreen('result-screen');\n  }\n\n  nextLevel() {\n    if (this.currentLevel < LEVELS.length) {\n      this.startLevel(this.currentLevel + 1);\n    } else {\n      this.goHome();\n    }\n  }\n\n  goHome() {\n    this.showScreen('home-screen');\n  }\n\n  hintReveal() {\n    // TODO: 实现揭示提示\n    console.log('Hint: Reveal');\n  }\n\n  hintRemove() {\n    // TODO: 实现去干扰提示\n    console.log('Hint: Remove distractors');\n  }\n\n  skip() {\n    // TODO: 实现跳过功能\n    console.log('Skip question');\n    this.onWrongAnswer();\n  }\n\n  startTimed() {\n    // TODO: 实现限时模式\n    console.log('Timed mode');\n  }\n\n  showCollection() {\n    // TODO: 实现图鉴系统\n    console.log('Collection');\n  }\n}\n","numLines":278,"startLine":1,"totalLines":278}}}
