{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_89c75b81d6c24c15bae83fe4","type":"tool_result","content":"The file D:\\game-projects\\steam-cultivation-factory\\src\\game\\GameState.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"c0e01ba0-5708-46af-9590-e43af2395006","uuid":"0f08de9c-3d67-4b0b-8a8e-562cddf3491d","timestamp":"2026-05-23T01:38:59.438Z","tool_use_result":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\GameState.ts","oldString":"export interface Resources {\n  [key: string]: number;\n  spirit_stone: number;\n  spirit_grass: number;\n  spirit_energy: number;\n  cultivation: number;\n  pill_juling: number;\n  pill_peiyuan: number;\n  pill_ningqi: number;\n  spirit_iron: number;\n}","newString":"export interface Resources {\n  [key: string]: number;\n  spirit_stone: number;\n  spirit_grass: number;\n  spirit_energy: number;\n  cultivation: number;\n  pill_juling: number;\n  pill_peiyuan: number;\n  pill_ningqi: number;\n  pill_zhuji: number;\n  pill_jindanyin: number;\n  spirit_iron: number;\n  spirit_wood: number;\n  talisman_paper: number;\n}","originalFile":"// GameState.ts — Immutable game state with save/load interface\n\nimport { type CultivationState, createInitialCultivationState, migrateFromOldRealm } from './Cultivation';\n\nexport interface Resources {\n  [key: string]: number;\n  spirit_stone: number;\n  spirit_grass: number;\n  spirit_energy: number;\n  cultivation: number;\n  pill_juling: number;\n  pill_peiyuan: number;\n  pill_ningqi: number;\n  spirit_iron: number;\n}\n\nexport interface BuildingInstance {\n  uid: string;\n  buildingId: string;\n  gridX: number;\n  gridY: number;\n  level: number;\n  lastCollectTime: number;\n  isProducing: boolean;\n  progress: number;\n}\n\nexport interface RealmProgress {\n  realmId: string;\n  level: number;\n  exp: number;\n  expToNext: number;\n}\n\nexport interface AlchemySessionData {\n  recipeId: string;\n  startTime: number;\n  progress: number;\n  complete: boolean;\n}\n\nexport interface GameMap {\n  regionId: string;\n  width: number;\n  height: number;\n  terrain: number[];\n  buildings: BuildingInstance[];\n}\n\nexport interface GameState {\n  resources: Resources;\n  realm: RealmProgress;\n  cultivation: CultivationState;\n  alchemySession: AlchemySessionData | null;\n  maps: GameMap[];\n  currentRegionIndex: number;\n  totalPlaytime: number;\n  lastSaveTime: number;\n  lastOnlineTime: number;\n  version: string;\n}\n\nexport interface SaveData {\n  version: string;\n  timestamp: number;\n  playtime: number;\n  gameState: GameState;\n}\n\nconst SAVE_KEY = 'cultivation_factory_save';\nconst CURRENT_VERSION = '0.2.0';\n\nfunction initialResources(): Resources {\n  return {\n    spirit_stone: 0,\n    spirit_grass: 0,\n    spirit_energy: 0,\n    cultivation: 0,\n    pill_juling: 0,\n    pill_peiyuan: 0,\n    pill_ningqi: 0,\n    spirit_iron: 0,\n  };\n}\n\nfunction initialRealm(): RealmProgress {\n  return {\n    realmId: 'liqi',\n    level: 1,\n    exp: 0,\n    expToNext: 100,\n  };\n}\n\nexport function createInitialState(): GameState {\n  return {\n    resources: initialResources(),\n    realm: initialRealm(),\n    cultivation: createInitialCultivationState(),\n    alchemySession: null,\n    maps: [],\n    currentRegionIndex: 0,\n    totalPlaytime: 0,\n    lastSaveTime: Date.now(),\n    lastOnlineTime: Date.now(),\n    version: CURRENT_VERSION,\n  };\n}\n\nexport function cloneState(state: GameState): GameState {\n  return JSON.parse(JSON.stringify(state));\n}\n\n// Produce a new state with resource delta applied\nexport function addResources(state: GameState, delta: Partial<Resources>): GameState {\n  const next = cloneState(state);\n  for (const key of Object.keys(delta) as (keyof Resources)[]) {\n    next.resources[key] = Math.max(0, next.resources[key] + (delta[key] ?? 0));\n  }\n  return next;\n}\n\n// Add cultivation exp and check for level-up\nexport function addCultivation(state: GameState, amount: number): GameState {\n  const next = cloneState(state);\n  next.realm.exp += amount;\n  while (next.realm.exp >= next.realm.expToNext) {\n    next.realm.exp -= next.realm.expToNext;\n    next.realm.level += 1;\n    next.realm.expToNext = Math.floor(next.realm.expToNext * 1.8);\n  }\n  return next;\n}\n\n// Add a building to a map\nexport function placeBuilding(state: GameState, mapIndex: number, building: BuildingInstance): GameState {\n  const next = cloneState(state);\n  next.maps[mapIndex].buildings.push(building);\n  return next;\n}\n\n// Remove a building from a map\nexport function removeBuilding(state: GameState, mapIndex: number, buildingUid: string): GameState {\n  const next = cloneState(state);\n  const map = next.maps[mapIndex];\n  map.buildings = map.buildings.filter(b => b.uid !== buildingUid);\n  return next;\n}\n\n// Update a specific building\nexport function updateBuilding(\n  state: GameState,\n  mapIndex: number,\n  buildingUid: string,\n  patch: Partial<BuildingInstance>,\n): GameState {\n  const next = cloneState(state);\n  const building = next.maps[mapIndex].buildings.find(b => b.uid === buildingUid);\n  if (building) {\n    Object.assign(building, patch);\n  }\n  return next;\n}\n\n// Set a map on the state\nexport function setMap(state: GameState, index: number, map: GameMap): GameState {\n  const next = cloneState(state);\n  next.maps[index] = map;\n  return next;\n}\n\n// Save to localStorage\nexport function saveGame(state: GameState): void {\n  const data: SaveData = {\n    version: CURRENT_VERSION,\n    timestamp: Date.now(),\n    playtime: state.totalPlaytime,\n    gameState: state,\n  };\n  try {\n    localStorage.setItem(SAVE_KEY, JSON.stringify(data));\n  } catch {\n    console.warn('Save failed: storage quota exceeded');\n  }\n}\n\n// Load from localStorage\nexport function loadGame(): GameState | null {\n  try {\n    const raw = localStorage.getItem(SAVE_KEY);\n    if (!raw) return null;\n    const data: SaveData = JSON.parse(raw);\n    const state = data.gameState ?? null;\n\n    // Migration: add new fields for v0.2.0\n    if (state && !state.cultivation) {\n      state.cultivation = state.realm\n        ? migrateFromOldRealm(state.realm)\n        : createInitialCultivationState();\n    }\n    if (state && !state.alchemySession) {\n      state.alchemySession = null;\n    }\n    // Add new resource fields\n    if (state) {\n      const res = state.resources as Record<string, number>;\n      if (res.pill_peiyuan === undefined) res.pill_peiyuan = 0;\n      if (res.pill_ningqi === undefined) res.pill_ningqi = 0;\n    }\n\n    return state;\n  } catch {\n    return null;\n  }\n}\n\nexport function clearSave(): void {\n  localStorage.removeItem(SAVE_KEY);\n}\n\nlet autoSaveTimer = 0;\n\nexport function startAutoSave(getState: () => GameState, intervalMs: number = 300000): void {\n  stopAutoSave();\n  autoSaveTimer = window.setInterval(() => {\n    saveGame(getState());\n  }, intervalMs);\n}\n\nexport function stopAutoSave(): void {\n  if (autoSaveTimer) {\n    clearInterval(autoSaveTimer);\n    autoSaveTimer = 0;\n  }\n}\n","structuredPatch":[{"oldStart":11,"oldLines":7,"newStart":11,"newLines":11,"lines":["   pill_juling: number;","   pill_peiyuan: number;","   pill_ningqi: number;","+  pill_zhuji: number;","+  pill_jindanyin: number;","   spirit_iron: number;","+  spirit_wood: number;","+  talisman_paper: number;"," }"," "," export interface BuildingInstance {"]}],"userModified":false,"replaceAll":false}}
