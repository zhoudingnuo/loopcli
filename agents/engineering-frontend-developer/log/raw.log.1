], [2, 12], [1, 11],\n    ];\n    for (const [x, y] of waterPositions) {\n      this.setTerrain(x, y, Terrain.Water);\n    }\n\n    // Add path\n    for (let x = 5; x < 15; x++) {\n      this.setTerrain(x, 7, Terrain.Path);\n    }\n    for (let y = 3; y < 12; y++) {\n      this.setTerrain(10, y, Terrain.Path);\n    }\n\n    // Rich soil near center\n    for (let y = 5; y < 8; y++) {\n      for (let x = 6; x < 9; x++) {\n        this.setTerrain(x, y, Terrain.RichSoil);\n      }\n    }\n  }\n\n  // Generate terrain for a specific region type\n  generateRegionTerrain(regionId: string): void {\n    switch (regionId) {\n      case 'zhuji_platform':\n        this.generateZhujiPlatform();\n        break;\n      case 'medicine_valley':\n        this.generateMedicineValley();\n        break;\n      case 'core_peak':\n        this.generateCorePeak();\n        break;\n      case 'ore_mountain':\n        this.generateOreMountain();\n        break;\n      case 'spirit_field_area':\n        this.generateSpiritFieldArea();\n        break;\n      case 'mine_area':\n        this.generateMineArea();\n        break;\n      default:\n        this.generateStartingArea();\n    }\n  }\n\n  private generateZhujiPlatform(): void {\n    // 筑基台：灵铁+灵木丰富，中等大小\n    const veinPositions = [\n      [5, 3], [6, 3], [5, 4],\n      [20, 15], [21, 15], [21, 16],\n      [12, 10], [13, 10],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    // Rich soil patches\n    for (let y = 6; y < 12; y++) {\n      for (let x = 8; x < 14; x++) {\n        this.setTerrain(x, y, Terrain.RichSoil);\n      }\n    }\n\n    // Paths\n    for (let x = 4; x < 26; x++) {\n      this.setTerrain(x, 12, Terrain.Path);\n    }\n    for (let y = 4; y < 22; y++) {\n      this.setTerrain(15, y, Terrain.Path);\n    }\n\n    // Water features\n    this.setTerrain(2, 2, Terrain.Water);\n    this.setTerrain(3, 2, Terrain.Water);\n    this.setTerrain(2, 3, Terrain.Water);\n  }\n\n  private generateMedicineValley(): void {\n    // 药王谷：大量灵田，稀有灵草\n    for (let y = 3; y < 22; y++) {\n      for (let x = 3; x < 32; x++) {\n        if (Math.random() < 0.6) {\n          this.setTerrain(x, y, Terrain.RichSoil);\n        }\n      }\n    }\n\n    // Spirit veins at edges\n    const veinPositions = [\n      [1, 1], [33, 1], [1, 23], [33, 23],\n      [17, 12],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    // Central path\n    for (let x = 5; x < 30; x++) {\n      this.setTerrain(x, 12, Terrain.Path);\n    }\n  }\n\n  private generateCorePeak(): void {\n    // 丹鼎峰：炼丹圣地，岩石地形多\n    const veinPositions = [\n      [5, 5], [6, 5], [5, 6],\n      [28, 22], [29, 22], [29, 23],\n      [17, 14], [18, 14],\n      [10, 20], [24, 8],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    // Rocky terrain\n    for (let y = 2; y < 28; y += 4) {\n      for (let x = 2; x < 33; x += 5) {\n        if (Math.random() < 0.3) {\n          this.setTerrain(x, y, Terrain.Rock);\n        }\n      }\n    }\n\n    // Paths\n    for (let x = 3; x < 32; x++) {\n      this.setTerrain(x, 15, Terrain.Path);\n    }\n    for (let y = 3; y < 28; y++) {\n      this.setTerrain(17, y, Terrain.Path);\n    }\n  }\n\n  private generateOreMountain(): void {\n    // 矿脉山：大量矿脉，灵石/灵铁高产\n    const veinPositions = [\n      [4, 4], [5, 4], [4, 5],\n      [20, 5], [21, 5], [21, 6],\n      [35, 15], [36, 15], [36, 16],\n      [10, 20], [11, 20], [11, 21],\n      [28, 25], [29, 25], [29, 26],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    // Mountain terrain\n    for (let y = 0; y < 5; y++) {\n      for (let x = 0; x < this.width; x++) {\n        if (Math.random() < 0.4) this.setTerrain(x, y, Terrain.Mountain);\n      }\n    }\n\n    // Paths\n    for (let x = 5; x < 35; x++) {\n      this.setTerrain(x, 15, Terrain.Path);\n    }\n    for (let y = 5; y < 25; y++) {\n      this.setTerrain(20, y, Terrain.Path);\n    }\n  }\n\n  private generateSpiritFieldArea(): void {\n    // 灵田区：大量灵田资源\n    for (let y = 4; y < 16; y++) {\n      for (let x = 4; x < 21; x++) {\n        if (Math.random() < 0.5) {\n          this.setTerrain(x, y, Terrain.RichSoil);\n        }\n      }\n    }\n\n    const veinPositions = [\n      [2, 2], [22, 18],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    for (let x = 3; x < 22; x++) {\n      this.setTerrain(x, 10, Terrain.Path);\n    }\n  }\n\n  private generateMineArea(): void {\n    // 灵石矿区：大量矿脉\n    const veinPositions = [\n      [3, 3], [4, 3], [3, 4],\n      [15, 8], [16, 8], [16, 9],\n      [25, 15], [26, 15], [26, 16],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    for (let x = 5; x < 25; x++) {\n      this.setTerrain(x, 10, Terrain.Path);\n    }\n  }","originalFile":"// Map.ts — Grid-based map system with terrain and area rendering\n\nexport enum Terrain {\n  Grass = 0,\n  Rock = 1,\n  Water = 2,\n  RichSoil = 3,\n  Mountain = 4,\n  Path = 5,\n  SpiritVein = 6,\n}\n\nexport interface MapConfig {\n  width: number;\n  height: number;\n  bgColor: string;\n  gridColor: string;\n  cellSize: number;\n}\n\nexport const DEFAULT_CELL_SIZE = 32;\n\nexport class GameMap {\n  width: number;\n  height: number;\n  cellSize: number;\n  terrain: Terrain[];\n  bgColor: string;\n  gridColor: string;\n\n  constructor(\n    width: number,\n    height: number,\n    bgColor: string = '#2a3a1a',\n    gridColor: string = '#3a4a2a',\n    cellSize: number = DEFAULT_CELL_SIZE,\n  ) {\n    this.width = width;\n    this.height = height;\n    this.cellSize = cellSize;\n    this.bgColor = bgColor;\n    this.gridColor = gridColor;\n    this.terrain = new Array(width * height).fill(Terrain.Grass);\n  }\n\n  get indexSize(): number {\n    return this.width * this.height;\n  }\n\n  inBounds(gx: number, gy: number): boolean {\n    return gx >= 0 && gx < this.width && gy >= 0 && gy < this.height;\n  }\n\n  getTerrain(gx: number, gy: number): Terrain {\n    if (!this.inBounds(gx, gy)) return Terrain.Mountain;\n    return this.terrain[gy * this.width + gx];\n  }\n\n  setTerrain(gx: number, gy: number, t: Terrain): void {\n    if (!this.inBounds(gx, gy)) return;\n    this.terrain[gy * this.width + gx] = t;\n  }\n\n  // Check if a rect of cells is free for placement\n  isAreaFree(gx: number, gy: number, w: number, h: number, occupied: Set<string>): boolean {\n    for (let dy = 0; dy < h; dy++) {\n      for (let dx = 0; dx < w; dx++) {\n        const cx = gx + dx;\n        const cy = gy + dy;\n        if (!this.inBounds(cx, cy)) return false;\n        const t = this.getTerrain(cx, cy);\n        if (t === Terrain.Water || t === Terrain.Mountain) return false;\n        const key = `${cx},${cy}`;\n        if (occupied.has(key)) return false;\n      }\n    }\n    return true;\n  }\n\n  // Generate terrain for the starting area (炼气坪)\n  generateStartingArea(): void {\n    // Add some spirit veins (矿脉)\n    const veinPositions = [\n      [3, 2], [4, 2], [3, 3],\n      [14, 10], [15, 10], [15, 11],\n      [8, 7], [8, 8],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    // Add some water features\n    const waterPositions = [\n      [10, 1], [11, 1], [10, 2],\n      [1, 12], [2, 12], [1, 11],\n    ];\n    for (const [x, y] of waterPositions) {\n      this.setTerrain(x, y, Terrain.Water);\n    }\n\n    // Add path\n    for (let x = 5; x < 15; x++) {\n      this.setTerrain(x, 7, Terrain.Path);\n    }\n    for (let y = 3; y < 12; y++) {\n      this.setTerrain(10, y, Terrain.Path);\n    }\n\n    // Rich soil near center\n    for (let y = 5; y < 8; y++) {\n      for (let x = 6; x < 9; x++) {\n        this.setTerrain(x, y, Terrain.RichSoil);\n      }\n    }\n  }\n\n  // Render map terrain to canvas\n  render(\n    ctx: CanvasRenderingContext2D,\n    offsetX: number,\n    offsetY: number,\n    viewportW: number,\n    viewportH: number,\n    scale: number,\n  ): void {\n    const invScale = 1 / scale;\n    const startCol = Math.max(0, Math.floor(-offsetX * invScale / this.cellSize));\n    const startRow = Math.max(0, Math.floor(-offsetY * invScale / this.cellSize));\n    const endCol = Math.min(this.width, Math.ceil((-offsetX + viewportW) * invScale / this.cellSize) + 1);\n    const endRow = Math.min(this.height, Math.ceil((-offsetY + viewportH) * invScale / this.cellSize) + 1);\n\n    // Draw terrain cells\n    for (let row = startRow; row < endRow; row++) {\n      for (let col = startCol; col < endCol; col++) {\n        const x = offsetX + col * this.cellSize * scale;\n        const y = offsetY + row * this.cellSize * scale;\n        const size = this.cellSize * scale;\n\n        ctx.fillStyle = this.getTerrainColor(this.getTerrain(col, row));\n        ctx.fillRect(x, y, size, size);\n\n        // Draw grid line\n        ctx.strokeStyle = this.gridColor;\n        ctx.lineWidth = 0.5;\n        ctx.strokeRect(x, y, size, size);\n      }\n    }\n  }\n\n  private getTerrainColor(t: Terrain): string {\n    switch (t) {\n      case Terrain.Grass: return this.bgColor;\n      case Terrain.Rock: return '#3a3a4a';\n      case Terrain.Water: return '#1a3a5a';\n      case Terrain.RichSoil: return '#2a4a1a';\n      case Terrain.Mountain: return '#4a4a4a';\n      case Terrain.Path: return '#4a3a2a';\n      case Terrain.SpiritVein: return '#2a4a5a';\n      default: return this.bgColor;\n    }\n  }\n\n  // Screen coordinates to grid cell\n  screenToGrid(\n    screenX: number,\n    screenY: number,\n    offsetX: number,\n    offsetY: number,\n    scale: number,\n  ): { gx: number; gy: number } {\n    const invScale = 1 / scale;\n    const gx = Math.floor((screenX - offsetX) * invScale / this.cellSize);\n    const gy = Math.floor((screenY - offsetY) * invScale / this.cellSize);\n    return { gx, gy };\n  }\n\n  // Grid cell center to screen coordinates\n  gridToScreen(\n    gx: number,\n    gy: number,\n    offsetX: number,\n    offsetY: number,\n    scale: number,\n  ): { x: number; y: number } {\n    return {\n      x: offsetX + (gx + 0.5) * this.cellSize * scale,\n      y: offsetY + (gy + 0.5) * this.cellSize * scale,\n    };\n  }\n}\n","structuredPatch":[{"oldStart":114,"oldLines":6,"newStart":114,"newLines":186,"lines":["     }","   }"," ","+  // Generate terrain for a specific region type","+  generateRegionTerrain(regionId: string): void {","+    switch (regionId) {","+      case 'zhuji_platform':","+        this.generateZhujiPlatform();","+        break;","+      case 'medicine_valley':","+        this.generateMedicineValley();","+        break;","+      case 'core_peak':","+        this.generateCorePeak();","+        break;","+      case 'ore_mountain':","+        this.generateOreMountain();","+        break;","+      case 'spirit_field_area':","+        this.generateSpiritFieldArea();","+        break;","+      case 'mine_area':","+        this.generateMineArea();","+        break;","+      default:","+        this.generateStartingArea();","+    }","+  }","+","+  private generateZhujiPlatform(): void {","+    // 筑基台：灵铁+灵木丰富，中等大小","+    const veinPositions = [","+      [5, 3], [6, 3], [5, 4],","+      [20, 15], [21, 15], [21, 16],","+      [12, 10], [13, 10],","+    ];","+    for (const [x, y] of veinPositions) {","+      this.setTerrain(x, y, Terrain.SpiritVein);","+    }","+","+    // Rich soil patches","+    for (let y = 6; y < 12; y++) {","+      for (let x = 8; x < 14; x++) {","+        this.setTerrain(x, y, Terrain.RichSoil);","+      }","+    }","+","+    // Paths","+    for (let x = 4; x < 26; x++) {","+      this.setTerrain(x, 12, Terrain.Path);","+    }","+    for (let y = 4; y < 22; y++) {","+      this.setTerrain(15, y, Terrain.Path);","+    }","+","+    // Water features","+    th