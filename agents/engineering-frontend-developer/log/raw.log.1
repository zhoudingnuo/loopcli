\",idiom:\"振振有词\",chars:[\"振\",\"振\",\"有\",\"词\"],pinyin:\"zhèn zhèn yǒu cí\",meaning:\"形容自以为理由充分说个不停\",difficulty:3,category:[\"常用\"],frequency:2},\n{id:\"h109\",idiom:\"信口雌黄\",chars:[\"信\",\"口\",\"雌\",\"黄\"],pinyin:\"xìn kǒu cí huáng\",meaning:\"比喻不顾事实随口乱说\",difficulty:3,category:[\"常用\"],frequency:1},\n{id:\"h110\",idiom:\"强词夺理\",chars:[\"强\",\"词\",\"夺\",\"理\"],pinyin:\"qiǎng cí duó lǐ\",meaning:\"本来没有理硬说得似乎有理\",difficulty:3,category:[\"常用\"],frequency:30},\n{id:\"h111\",idiom:\"理所当然\",chars:[\"理\",\"所\",\"当\",\"然\"],pinyin:\"lǐ suǒ dāng rán\",meaning:\"从道理上讲应当这样\",difficulty:3,category:[\"常用\"],frequency:29},\n{id:\"h112\",idiom:\"天经地义\",chars:[\"天\",\"经\",\"地\",\"义\"],pinyin:\"tiān jīng dì yì\",meaning:\"非常正确不容置疑的道理\",difficulty:3,category:[\"自然\"],frequency:28},\n{id:\"h113\",idiom:\"名正言顺\",chars:[\"名\",\"正\",\"言\",\"顺\"],pinyin:\"míng zhèng yán shùn\",meaning:\"名义正当道理也讲得通\",difficulty:3,category:[\"常用\"],frequency:27},\n{id:\"h114\",idiom:\"顺理成章\",chars:[\"顺\",\"理\",\"成\",\"章\"],pinyin:\"shùn lǐ chéng zhāng\",meaning:\"某种情况合乎情理自然产生某种结果\",difficulty:3,category:[\"常用\"],frequency:26},\n{id:\"h115\",idiom:\"水到渠成\",chars:[\"水\",\"到\",\"渠\",\"成\"],pinyin:\"shuǐ dào qú chéng\",meaning:\"水流到的地方自然形成一条渠比喻条件成熟事情自然会成功\",difficulty:3,category:[\"自然\"],frequency:25},\n{id:\"h116\",idiom:\"瓜熟蒂落\",chars:[\"瓜\",\"熟\",\"蒂\",\"落\"],pinyin:\"guā shú dì luò\",meaning:\"瓜熟了瓜蒂自然脱落比喻条件成熟事情自然会成功\",difficulty:3,category:[\"自然\"],frequency:24},\n{id:\"h117\",idiom:\"功亏一篑\",chars:[\"功\",\"亏\",\"一\",\"篑\"],pinyin:\"gōng kuī yī kuì\",meaning:\"比喻做事情只差最后一点没能完成\",difficulty:3,category:[\"数字\"],frequency:23},\n{id:\"h118\",idiom:\"半途而废\",chars:[\"半\",\"途\",\"而\",\"废\"],pinyin:\"bàn tú ér fèi\",meaning:\"做事不能坚持到底中途停顿\",difficulty:3,category:[\"常用\"],frequency:22},\n{id:\"h119\",idiom:\"功败垂成\",chars:[\"功\",\"败\",\"垂\",\"成\"],pinyin:\"gōng bài chuí chéng\",meaning:\"事情在快要成功的时候遭到了失败\",difficulty:3,category:[\"常用\"],frequency:21},\n{id:\"h120\",idiom:\"前功尽弃\",chars:[\"前\",\"功\",\"尽\",\"弃\"],pinyin:\"qián gōng jìn qì\",meaning:\"以前的功劳全部废弃努力完全白费\",difficulty:3,category:[\"常用\"],frequency:20},\n\n// ===== MASTER (difficulty: 4) — 150 idioms =====\n{id:\"s001\",idiom:\"沆瀣一气\",chars:[\"沆\",\"瀣\",\"一\",\"气\"],pinyin:\"hàng xiè yī qì\",meaning:\"比喻臭味相投的人结合在一起\",difficulty:4,category:[\"人物\"],frequency:19},\n{id:\"s002\",idiom:\"越俎代庖\",chars:[\"越\",\"俎\",\"代\",\"庖\"],pinyin:\"yuè zǔ dài páo\",meaning:\"比喻超出自己职责去处理别人的事\",difficulty:4,category:[\"常用\"],frequency:18},\n{id:\"s003\",idiom:\"噤若寒蝉\",chars:[\"噤\",\"若\",\"寒\",\"蝉\"],pinyin:\"jìn ruò hán chán\",meaning:\"比喻因为害怕有所顾虑而不敢说话\",difficulty:4,category:[\"动物\"],frequency:17},\n{id:\"s004\",idiom:\"如丧考妣\",chars:[\"如\",\"丧\",\"考\",\"妣\"],pinyin:\"rú sàng kǎo bǐ\",meaning:\"好像死了父母那样悲痛\",difficulty:4,category:[\"人物\"],frequency:16},\n{id:\"s005\",idiom:\"沐猴而冠\",chars:[\"沐\",\"猴\",\"而\",\"冠\"],pinyin:\"mù hóu ér guàn\",meaning:\"比喻虚有其表形同傀儡\",difficulty:4,category:[\"动物\"],frequency:15},\n{id:\"s006\",idiom:\"怙恶不悛\",chars:[\"怙\",\"恶\",\"不\",\"悛\"],pinyin:\"hù è bù quān\",meaning:\"坚持作恶不肯悔改\",difficulty:4,category:[\"常用\"],frequency:14},\n{id:\"s007\",idiom:\"暴殄天物\",chars:[\"暴\",\"殄\",\"天\",\"物\"],pinyin:\"bào tiǎn tiān wù\",meaning:\"任意糟蹋东西不知爱惜\",difficulty:4,category:[\"自然\"],frequency:13},\n{id:\"s008\",idiom:\"茕茕孑立\",chars:[\"茕\",\"茕\",\"孑\",\"立\"],pinyin:\"qióng qióng jié lì\",meaning:\"孤零零地独自站着形容无依无靠非常孤单\",difficulty:4,category:[\"人物\"],frequency:12},\n{id:\"s009\",idiom:\"踽踽独行\",chars:[\"踽\",\"踽\",\"独\",\"行\"],pinyin:\"jǔ jǔ dú xíng\",meaning:\"孤零零地独自走着形容非常孤独\",difficulty:4,category:[\"人物\"],frequency:11},\n{id:\"s010\",idiom:\"魑魅魍魉\",chars:[\"魑\",\"魅\",\"魍\",\"魉\"],pinyin:\"chī mèi wǎng liǎng\",meaning:\"比喻形形色色的坏人\",difficulty:4,category:[\"人物\"],frequency:10},\n{id:\"s011\",idiom:\"纵横捭阖\",chars:[\"纵\",\"横\",\"捭\",\"阖\"],pinyin:\"zòng héng bǎi hé\",meaning:\"指在政治或外交上运用手段进行分化或拉拢\",difficulty:4,category:[\"军事\"],frequency:9},\n{id:\"s012\",idiom:\"纵横驰骋\",chars:[\"纵\",\"横\",\"驰\",\"骋\"],pinyin:\"zòng héng chí chěng\"