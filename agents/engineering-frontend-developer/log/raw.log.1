,difficulty:1,category:[\"情感\"],frequency:76},\n{id:\"e045\",idiom:\"冰天雪地\",chars:[\"冰\",\"天\",\"雪\",\"地\"],pinyin:\"bīng tiān xuě dì\",meaning:\"形容冰雪漫天盖地\",difficulty:1,category:[\"自然\",\"四季\"],frequency:76},\n{id:\"e046\",idiom:\"顶天立地\",chars:[\"顶\",\"天\",\"立\",\"地\"],pinyin:\"dǐng tiān lì dì\",meaning:\"形容形象高大气概豪迈\",difficulty:1,category:[\"人物\"],frequency:75},\n{id:\"e047\",idiom:\"铺天盖地\",chars:[\"铺\",\"天\",\"盖\",\"地\"],pinyin:\"pū tiān gài dì\",meaning:\"形容来势猛声势大\",difficulty:1,category:[\"自然\"],frequency:75},\n{id:\"e048\",idiom:\"漫不经心\",chars:[\"漫\",\"不\",\"经\",\"心\"],pinyin:\"màn bù jīng xīn\",meaning:\"形容随随便便不放在心上\",difficulty:1,category:[\"常用\"],frequency:74},\n{id:\"e049\",idiom:\"异想天开\",chars:[\"异\",\"想\",\"天\",\"开\"],pinyin:\"yì xiǎng tiān kāi\",meaning:\"形容想法离奇不切实际\",difficulty:1,category:[\"常用\"],frequency:74},\n{id:\"e050\",idiom:\"一鸣惊人\",chars:[\"一\",\"鸣\",\"惊\",\"人\"],pinyin:\"yī míng jīng rén\",meaning:\"比喻平时没有表现突然做出惊人的成绩\",difficulty:1,category:[\"数字\"],frequency:73},\n{id:\"e051\",idiom:\"一帆风顺\",chars:[\"一\",\"帆\",\"风\",\"顺\"],pinyin:\"yī fān fēng shùn\",meaning:\"比喻非常顺利没有阻碍\",difficulty:1,category:[\"自然\"],frequency:73},\n{id:\"e052\",idiom:\"一目了然\",chars:[\"一\",\"目\",\"了\",\"然\"],pinyin:\"yī mù liǎo rán\",meaning:\"一眼看去就清楚明白\",difficulty:1,category:[\"常用\"],frequency:72},\n{id:\"e053\",idiom:\"一言为定\",chars:[\"一\",\"言\",\"为\",\"定\"],pinyin:\"yī yán wéi dìng\",meaning:\"一句话说定不再更改\",difficulty:1,category:[\"常用\"],frequency:72},\n{id:\"e054\",idiom:\"一诺千金\",chars:[\"一\",\"诺\",\"千\",\"金\"],pinyin:\"yī nuò qiān jīn\",meaning:\"形容说话算数极有信用\",difficulty:1,category:[\"数字\"],frequency:71},\n{id:\"e055\",idiom:\"一丝不苟\",chars:[\"一\",\"丝\",\"不\",\"苟\"],pinyin:\"yī sī bù gǒu\",meaning:\"形容做事认真仔细一点不马虎\",difficulty:1,category:[\"常用\"],frequency:71},\n{id:\"e056\",idiom:\"一视同仁\",chars:[\"一\",\"视\",\"同\",\"仁\"],pinyin:\"yī shì tóng rén\",meaning:\"平等对待不分厚薄\",difficulty:1,category:[\"常用\"],frequency:70},\n{id:\"e057\",idiom:\"一见钟情\",chars:[\"一\",\"见\",\"钟\",\"情\"