);\n123\t  }\n124\t\n125\t  restoreCandidateButtons() {\n126\t    const candidates = document.querySelectorAll('.candidate');\n127\t    candidates.forEach((btn, i) => {\n128\t      if (!this.usedCandidates.includes(i)) {\n129\t        btn.classList.remove('used');\n130\t      }\n131\t    });\n132\t  }\n133\t\n134\t  updateSlotsDisplay() {\n135\t    const slots = document.querySelectorAll('.slot');\n136\t    const currentSlots = this.judge.getSlots();\n137\t\n138\t    slots.forEach((slot, i) => {\n139\t      slot.textContent = currentSlots[i] || '';\n140\t      slot.className = 'slot' + (currentSlots[i] ? ' filled' : '');\n141\t    });\n142\t  }\n143\t\n144\t  checkAnswer() {\n145\t    const q = this.currentQuestion;\n146\t    const result = this.judge.checkAnswer(q.correctAnswer);\n147\t\n148\t    if (result.correct) {\n149\t      this.onCorrectAnswer();\n150\t    } else {\n151\t      this.onWrongAnswer();\n152\t    }\n153\t  }\n154\t\n155\t  onCorrectAnswer() {\n156\t    this.correctCount++;\n157\t    this.questionCount++;\n158\t    this.score += 100 + this.combo.increment();\n159\t\n160\t    const slots = document.querySelectorAll('.slot');\n161\t    slots.forEach(s => s.classList.add('correct'));\n162\t\n163\t    this.audio.play('correct');\n164\t\n165\t    setTimeout(() => {\n166\t      this.updateUI();\n167\t      this.nextQuestion();\n168\t    }, 1000);\n169\t  }\n170\t\n171\t  onWrongAnswer() {\n172\t    this.lives--;\n173\t    this.combo.reset();\n174\t    this.questionCount++;\n175\t\n176\t    const slots = document.querySelectorAll('.slot');\n177\t    slots.forEach(s => s.classList.add('wrong'));\n178\t\n179\t    this.audio.play('wrong');\n180\t\n181\t    setTimeout(() => {\n182\t      this.judge.reset();\n183\t      this.usedCandidates = [];\n184\t      this.restoreCandidateButtons();\n185\t      this.updateSlotsDisplay();\n186\t\n187\t      if (this.lives <= 0) {\n188\t        this.failLevel();\n189\t      } else {\n190\t        this.updateUI();\n191\t  