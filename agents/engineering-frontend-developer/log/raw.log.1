:[\"人物\"],frequency:10},\n{id:\"s011\",idiom:\"纵横捭阖\",chars:[\"纵\",\"横\",\"捭\",\"阖\"],pinyin:\"zòng héng bǎi hé\",meaning:\"指在政治或外交上运用手段进行分化或拉拢\",difficulty:4,category:[\"军事\"],frequency:9},\n{id:\"s012\",idiom:\"纵横驰骋\",chars:[\"纵\",\"横\",\"驰\",\"骋\"],pinyin:\"zòng héng chí chěng\",meaning:\"形容奔驰自如毫无阻挡\",difficulty:4,category:[\"常用\"],frequency:8},\n{id:\"s013\",idiom:\"踌躇满志\",chars:[\"踌\",\"躇\",\"满\",\"志\"],pinyin:\"chóu chú mǎn zhì\",meaning:\"形容对自己的现状或取得的成就非常得意\",difficulty:4,category:[\"情感\"],frequency:7},\n{id:\"s014\",idiom:\"锱铢必较\",chars:[\"锱\",\"铢\",\"必\",\"较\"],pinyin:\"zī zhū bì jiào\",meaning:\"形容非常小气很少的钱也要计较\",difficulty:4,category:[\"常用\"],frequency:6},\n{id:\"s015\",idiom:\"呼天抢地\",chars:[\"呼\",\"天\",\"抢\",\"地\"],pinyin:\"hū tiān qiǎng dì\",meaning:\"大声叫天用头撞地形容极度悲伤\",difficulty:4,category:[\"自然\",\"情感\"],frequency:5},\n{id:\"s016\",idiom:\"焚膏继晷\",chars:[\"焚\",\"膏\",\"继\",\"晷\"],pinyin:\"fén gāo jì guǐ\",meaning:\"点上油灯接续日光形容勤奋地工作或读书\",difficulty:4,category:[\"常用\"],frequency:4},\n{id:\"s017\",idiom:\"胶柱鼓瑟\",chars:[\"胶\",\"柱\",\"鼓\",\"瑟\"],pinyin:\"jiāo zhù gǔ sè\",meaning:\"比喻拘泥固执不知变通\",difficulty:4,category:[\"常用\"],frequency:3},\n{id:\"s018\",idiom:\"风声鹤唳\",chars:[\"风\",\"声\",\"鹤\",\"唳\"],pinyin:\"fēng shēng hè lì\",meaning:\"形容惊慌失措或自相惊扰\",difficulty:4,category:[\"自然\",\"动物\"],frequency:2},\n{id:\"s019\",idiom:\"首鼠两端\",chars:[\"首\",\"鼠\",\"两\",\"端\"],pinyin:\"shǒu shǔ liǎng duān\",meaning:\"形容犹豫不决动摇不定\",difficulty:4,category:[\"动物\"],frequency:1},\n{id:\"s020\",idiom:\"邯郸学步\",chars:[\"邯\",\"郸\",\"学\",\"步\"],pinyin:\"hán dān xué bù\",meaning:\"比喻模仿别人不成反而丢了自己本来的技能\",difficulty:4,category:[\"历史\"],frequency:30},\n{id:\"s021\",idiom:\"买椟还珠\",chars:[\"买\",\"椟\",\"还\",\"珠\"],pinyin:\"mǎi dú huán zhū\",meaning:\"比喻没有眼光取舍不当\",difficulty:4,category:[\"寓言\"],frequency:29},\n{id:\"s022\",idiom:\"南柯一梦\",chars:[\"南\",\"柯\",\"一\",\"梦\"],pinyin:\"nán kē yī mèng\",meaning:\"形容一场大梦或比喻一场空欢喜\",difficulty:4,category:[\"寓言\"],frequency:28},\n{id:\"s023\",idiom:\"黄粱一梦\",cha