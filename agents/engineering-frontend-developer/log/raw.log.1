{"type":"assistant","message":{"id":"msg_20260523093731227ab9ba40fa4b86","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_e1c33eb4fd064fa9b1e3e57a","name":"Write","input":{"file_path":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Talisman.ts","content":"// Talisman.ts — 基础灵符条件触发系统\n\nexport type TalismanCondition =\n  | { type: 'resource_above'; resource: string; threshold: number }\n  | { type: 'resource_below'; resource: string; threshold: number }\n  | { type: 'building_count_above'; buildingId: string; threshold: number }\n  | { type: 'realm_level_above'; level: number };\n\nexport type TalismanAction =\n  | { type: 'stop_building'; buildingUid: string }\n  | { type: 'start_building'; buildingUid: string }\n  | { type: 'set_production_rate'; buildingUid: string; multiplier: number }\n  | { type: 'notify'; message: string };\n\nexport interface TalismanInstance {\n  uid: string;\n  gridX: number;\n  gridY: number;\n  name: string;\n  condition: TalismanCondition;\n  action: TalismanAction;\n  enabled: boolean;\n  /** Cooldown between triggers (ms) */\n  cooldown: number;\n  /** Last trigger time */\n  lastTriggered: number;\n}\n\n// Evaluate a condition against current game state\nexport function evaluateCondition(\n  condition: TalismanCondition,\n  resources: Record<string, number>,\n  buildingCounts: Record<string, number>,\n  realmLevel: number,\n): boolean {\n  switch (condition.type) {\n    case 'resource_above':\n      return (resources[condition.resource] ?? 0) > condition.threshold;\n    case 'resource_below':\n      return (resources[condition.resource] ?? 0) < condition.threshold;\n    case 'building_count_above':\n      return (buildingCounts[condition.buildingId] ?? 0) > condition.threshold;\n    case 'realm_level_above':\n      return realmLevel >= condition.level;\n  }\n}\n\n// Create a talisman instance\nexport function createTalisman(\n  uid: string,\n  gridX: number,\n  gridY: number,\n  name: string,\n  condition: TalismanCondition,\n  action: TalismanAction,\n): TalismanInstance {\n  return {\n    uid,\n    gridX,\n    gridY,\n    name,\n    condition,\n    action,\n    enabled: true,\n    cooldown: 5000,\n    lastTriggered: 0,\n  };\n}\n\n// Process all talismans and return triggered actions\nexport function processTalismans(\n  talismans: TalismanInstance[],\n  resources: Record<string, number>,\n  buildingCounts: Record<string, number>,\n  realmLevel: number,\n  now: number,\n): { talismans: TalismanInstance[]; actions: TalismanAction[] } {\n  const updated: TalismanInstance[] = [];\n  const actions: TalismanAction[] = [];\n\n  for (const t of talismans) {\n    if (!t.enabled) {\n      updated.push(t);\n      continue;\n    }\n\n    if (now - t.lastTriggered < t.cooldown) {\n      updated.push(t);\n      continue;\n    }\n\n    const triggered = evaluateCondition(t.condition, resources, buildingCounts, realmLevel);\n\n    if (triggered) {\n      actions.push(t.action);\n      updated.push({ ...t, lastTriggered: now });\n    } else {\n      updated.push(t);\n    }\n  }\n\n  return { talismans: updated, actions };\n}\n\n// Preset talisman templates\nexport const TALISMAN_PRESETS: Array<{\n  id: string;\n  name: string;\n  description: string;\n  condition: TalismanCondition;\n  action: TalismanAction;\n}> = [\n  {\n    id: 'auto_stop_field',\n    name: '灵田自停符',\n    description: '灵草超过50时停止灵田',\n    condition: { type: 'resource_above', resource: 'spirit_grass', threshold: 50 },\n    action: { type: 'notify', message: '灵草充足，灵田已暂停' },\n  },\n  {\n    id: 'auto_stop_miner',\n    name: '矿机自停符',\n    description: '灵石超过200时停止矿机',\n    condition: { type: 'resource_above', resource: 'spirit_stone', threshold: 200 },\n    action: { type: 'notify', message: '灵石充足，矿机已暂停' },\n  },\n  {\n    id: 'speed_boost',\n    name: '加速灵符',\n    description: '修为达到要求时加速生产',\n    condition: { type: 'realm_level_above', level: 15 },\n    action: { type: 'notify', message: '灵符激活，生产加速！' },\n  },\n];\n\n// Render a talisman on canvas\nexport function renderTalisman(\n  ctx: CanvasRenderingContext2D,\n  talisman: TalismanInstance,\n  offsetX: number,\n  offsetY: number,\n  scale: number,\n  cellSize: number,\n  now: number,\n): void {\n  const x = offsetX + talisman.gridX * cellSize * scale;\n  const y = offsetY + talisman.gridY * cellSize * scale;\n  const s = cellSize * scale;\n\n  // Scroll background\n  ctx.fillStyle = talisman.enabled ? 'rgba(200,180,100,0.3)' : 'rgba(100,100,100,0.3)';\n  ctx.fillRect(x + 2, y + 2, s - 4, s - 4);\n\n  // Scroll icon\n  ctx.fillStyle = talisman.enabled ? '#ffd700' : '#666';\n  ctx.font = `${Math.max(10, Math.floor(14 * scale))}px serif`;\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n  ctx.fillText('📜', x + s / 2, y + s / 2);\n\n  // Active glow\n  if (talisman.enabled && now - talisman.lastTriggered < 1000) {\n    ctx.fillStyle = 'rgba(255,215,0,0.2)';\n    ctx.fillRect(x + 2, y + 2, s - 4, s - 4);\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"c0e01ba0-5708-46af-9590-e43af2395006","uuid":"b02a834d-ffb8-4b3d-86ee-4744b08587dd"}
