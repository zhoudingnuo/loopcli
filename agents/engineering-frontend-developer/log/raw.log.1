",\"初\",\"醒\"],pinyin:\"rú mèng chū xǐng\",meaning:\"好像刚从梦中醒来比喻从糊涂错误中刚刚醒悟过来\",difficulty:4,category:[\"常用\"],frequency:28},\n{id:\"s113\",idiom:\"茅塞顿开\",chars:[\"茅\",\"塞\",\"顿\",\"开\"],pinyin:\"máo sè dùn kāi\",meaning:\"形容思想忽然开窍立刻明白了某个道理\",difficulty:4,category:[\"常用\"],frequency:27},\n{id:\"s114\",idiom:\"醍醐灌顶\",chars:[\"醍\",\"醐\",\"灌\",\"顶\"],pinyin:\"tí hú guàn dǐng\",meaning:\"比喻灌输智慧使人彻底觉悟\",difficulty:4,category:[\"人物\"],frequency:26},\n{id:\"s115\",idiom:\"拨云见日\",chars:[\"拨\",\"云\",\"见\",\"日\"],pinyin:\"bō yún jiàn rì\",meaning:\"比喻冲破黑暗见到光明\",difficulty:4,category:[\"自然\"],frequency:25},\n{id:\"s116\",idiom:\"柳暗花明\",chars:[\"柳\",\"暗\",\"花\",\"明\"],pinyin:\"liǔ àn huā míng\",meaning:\"比喻在困难中遇到转机\",difficulty:4,category:[\"自然\"],frequency:24},\n{id:\"s117\",idiom:\"峰回路转\",chars:[\"峰\",\"回\",\"路\",\"转\"],pinyin:\"fēng huí lù zhuǎn\",meaning:\"形容事情经历曲折后出现新的转机\",difficulty:4,category:[\"自然\"],frequency:23},\n{id:\"s118\",idiom:\"否极泰来\",chars:[\"否\",\"极\",\"泰\",\"来\"],pinyin:\"pǐ jí tài lái\",meaning:\"逆境达到极点就会向顺境转化\",difficulty:4,category:[\"常用\"],frequency:22},\n{id:\"s119\",idiom:\"苦尽甘来\",chars:[\"苦\",\"尽\",\"甘\",\"来\"],pinyin:\"kǔ jìn gān lái\",meaning:\"艰苦的日子过完了美好的日子来到了\",difficulty:4,category:[\"情感\"],frequency:21},\n{id:\"s120\",idiom:\"破茧成蝶\",chars:[\"破\",\"茧\",\"成\",\"蝶\"],pinyin:\"pò jiǎn chéng dié\",meaning:\"比喻经过痛苦的磨练最终获得成功\",difficulty:4,category:[\"动物\"],frequency:20},\n{id:\"s121\",idiom:\"涅槃重生\",chars:[\"涅\",\"槃\",\"重\",\"生\"],pinyin:\"niè pán chóng shēng\",meaning:\"比喻经历痛苦后获得新生\",difficulty:4,category:[\"常用\"],frequency:19},\n{id:\"s122\",idiom:\"脱胎换骨\",chars:[\"脱\",\"胎\",\"换\",\"骨\"],pinyin:\"tuō tāi huàn gǔ\",meaning:\"比喻彻底改变立场观点\",difficulty:4,category:[\"人物\"],frequency:18},\n{id:\"s123\",idiom:\"浴火重生\",chars:[\"浴\",\"火\",\"重\",\"生\"],pinyin:\"yù huǒ chóng shēng\",meaning:\"比喻经历烈火般的磨难后获得新生\",difficulty:4,category:[\"自然\"],frequency:17},\n{id:\"s124\",idiom:\"返璞归真\",chars:[\"返\",\"璞\",\"归\",\"真\"],pinyin:\"fǎn pú guī zhēn\",meaning:\"去掉外饰还其本质比喻回