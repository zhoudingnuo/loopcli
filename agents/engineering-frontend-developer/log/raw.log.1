{"type":"assistant","message":{"id":"msg_20260523120537ae153e5b6b7644d8","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_d58cb34a0a5d46f18f3a554c","name":"Write","input":{"file_path":"D:\\game-projects\\steam-horror-sim\\src\\game\\GameState.ts","content":"// GameState.ts — Game state with save/load interface (v0.2.0 — M2)\n\nexport enum GamePhase {\n  MENU = 'menu',\n  DAYTIME = 'daytime',\n  NIGHT_TRANSITION = 'night_transition',\n  NIGHT = 'night',\n  DANGER = 'danger',\n  DAWN = 'dawn',\n  PAUSED = 'paused',\n}\n\nexport enum UIPanel {\n  NONE = 'none',\n  INVENTORY = 'inventory',\n  SHELF = 'shelf',\n  PRICING = 'pricing',\n  SHOP = 'shop',\n  SUPPLIER = 'supplier',\n  REGISTER = 'register',\n}\n\nexport interface Position {\n  x: number;\n  y: number;\n}\n\nexport interface PlayerState {\n  x: number;\n  y: number;\n  speed: number;\n  direction: 'up' | 'down' | 'left' | 'right';\n  money: number;\n  debt: number;\n  day: number;\n  health: number;\n  sanity: number;\n}\n\nexport interface LightSource {\n  x: number;\n  y: number;\n  radius: number;\n  color: string;\n  intensity: number;\n  flicker: boolean;\n  flickerSpeed: number;\n}\n\nexport interface Interactable {\n  id: string;\n  type: 'shelf' | 'register' | 'door' | 'fridge' | 'storage' | 'phone' | 'radio' | 'note';\n  x: number;\n  y: number;\n  width: number;\n  height: number;\n  label: string;\n  active: boolean;\n}\n\nexport interface DaySummary {\n  day: number;\n  revenue: number;\n  expenses: number;\n  customersServed: number;\n  customersLost: number;\n  debtRemaining: number;\n}\n\nexport interface GameState {\n  phase: GamePhase;\n  activePanel: UIPanel;\n  player: PlayerState;\n  day: number;\n  timeOfDay: number; // 0-24 hours (6=6am, 23=11pm etc)\n  timeSpeed: number;\n  lights: LightSource[];\n  interactables: Interactable[];\n  totalPlaytime: number;\n  lastSaveTime: number;\n  version: string;\n\n  // M2: Economy\n  money: number;\n  debt: number;\n  dailyRevenue: number;\n  dailyExpenses: number;\n\n  // M2: Notifications\n  notifications: string[];\n  daySummaries: DaySummary[];\n}\n\nexport interface SaveData {\n  version: string;\n  timestamp: number;\n  playtime: number;\n  gameState: GameState;\n  productManager: Record<string, unknown>;\n  economy: Record<string, unknown>;\n  pricing: Record<string, unknown>;\n  customerStats: Record<string, unknown>;\n  registers: Record<string, unknown>[];\n}\n\nconst SAVE_KEY = 'midnight_store_save';\nconst CURRENT_VERSION = '0.2.0';\n\nexport function createInitialState(): GameState {\n  const TILE = 32;\n  return {\n    phase: GamePhase.DAYTIME,\n    activePanel: UIPanel.NONE,\n    player: {\n      x: 15 * TILE,\n      y: 5 * TILE,\n      speed: 150,\n      direction: 'down',\n      money: 500,\n      debt: 300000,\n      day: 1,\n      health: 100,\n      sanity: 100,\n    },\n    day: 1,\n    timeOfDay: 6,\n    timeSpeed: 1,\n    lights: [],\n    interactables: [],\n    totalPlaytime: 0,\n    lastSaveTime: Date.now(),\n    version: CURRENT_VERSION,\n\n    money: 500,\n    debt: 300000,\n    dailyRevenue: 0,\n    dailyExpenses: 0,\n    notifications: [],\n    daySummaries: [],\n  };\n}\n\nexport function cloneState(state: GameState): GameState {\n  return JSON.parse(JSON.stringify(state));\n}\n\nexport function saveGame(\n  state: GameState,\n  pm?: Record<string, unknown>,\n  eco?: Record<string, unknown>,\n  prc?: Record<string, unknown>,\n  cust?: Record<string, unknown>,\n  regs?: Record<string, unknown>[],\n): void {\n  const data: SaveData = {\n    version: CURRENT_VERSION,\n    timestamp: Date.now(),\n    playtime: state.totalPlaytime,\n    gameState: state,\n    productManager: pm ?? {},\n    economy: eco ?? {},\n    pricing: prc ?? {},\n    customerStats: cust ?? {},\n    registers: regs ?? [],\n  };\n  try {\n    localStorage.setItem(SAVE_KEY, JSON.stringify(data));\n  } catch {\n    console.warn('Save failed: storage quota exceeded');\n  }\n}\n\nexport function loadGame(): SaveData | null {\n  try {\n    const raw = localStorage.getItem(SAVE_KEY);\n    if (!raw) return null;\n    return JSON.parse(raw) as SaveData;\n  } catch {\n    return null;\n  }\n}\n\nexport function clearSave(): void {\n  localStorage.removeItem(SAVE_KEY);\n}\n\nlet autoSaveTimer = 0;\n\nexport function startAutoSave(\n  getState: () => GameState,\n  getExtra?: () => {\n    pm?: Record<string, unknown>;\n    eco?: Record<string, unknown>;\n    prc?: Record<string, unknown>;\n    cust?: Record<string, unknown>;\n    regs?: Record<string, unknown>[];\n  },\n  intervalMs: number = 300000,\n): void {\n  stopAutoSave();\n  autoSaveTimer = window.setInterval(() => {\n    const extra = getExtra?.();\n    saveGame(\n      getState(),\n      extra?.pm,\n      extra?.eco,\n      extra?.prc,\n      extra?.cust,\n      extra?.regs,\n    );\n  }, intervalMs);\n}\n\nexport function stopAutoSave(): void {\n  if (autoSaveTimer) {\n    clearInterval(autoSaveTimer);\n    autoSaveTimer = 0;\n  }\n}\n\nexport function getTimeString(timeOfDay: number): string {\n  const hours = Math.floor(timeOfDay) % 24;\n  const minutes = Math.floor((timeOfDay % 1) * 60);\n  return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;\n}\n\nexport function getPhaseFromTime(timeOfDay: number): GamePhase {\n  if (timeOfDay >= 6 && timeOfDay < 22) return GamePhase.DAYTIME;\n  if (timeOfDay >= 22 && timeOfDay < 23) return GamePhase.NIGHT_TRANSITION;\n  if (timeOfDay >= 23 || timeOfDay < 2) return GamePhase.NIGHT;\n  if (timeOfDay >= 2 && timeOfDay < 5) return GamePhase.DANGER;\n  return GamePhase.DAWN;\n}\n\nexport function isNightTime(phase: GamePhase): boolean {\n  return phase === GamePhase.NIGHT_TRANSITION ||\n    phase === GamePhase.NIGHT ||\n    phase === GamePhase.DANGER;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"e4781836-91b7-498e-bc35-c2b84a36028a","uuid":"51f46cd9-2532-4ee3-8960-24428a766af8"}
