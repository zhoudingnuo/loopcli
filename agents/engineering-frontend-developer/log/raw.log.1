{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_cbb1f75023e34ba88dfd0d71","type":"tool_result","content":"1\t// Camera.ts — Camera system with zoom, pan, and coordinate transformation\n2\t\n3\texport class Camera {\n4\t  x: number = 0;\n5\t  y: number = 0;\n6\t  zoom: number = 1;\n7\t  minZoom: number = 0.25;\n8\t  maxZoom: number = 4;\n9\t  targetZoom: number = 1;\n10\t\n11\t  private isDragging: boolean = false;\n12\t  private dragStartX: number = 0;\n13\t  private dragStartY: number = 0;\n14\t  private camStartX: number = 0;\n15\t  private camStartY: number = 0;\n16\t  private canvas: HTMLCanvasElement;\n17\t\n18\t  constructor(canvas: HTMLCanvasElement) {\n19\t    this.canvas = canvas;\n20\t    this.setupInput(canvas);\n21\t  }\n22\t\n23\t  // Center the camera on a map position\n24\t  centerOnMap(mapWidth: number, mapHeight: number, cellSize: number): void {\n25\t    const mapPixelW = mapWidth * cellSize * this.zoom;\n26\t    const mapPixelH = mapHeight * cellSize * this.zoom;\n27\t    this.x = (this.canvas.width - mapPixelW) / 2;\n28\t    this.y = (this.canvas.height - mapPixelH) / 2;\n29\t  }\n30\t\n31\t  // Convert screen coords to world coords\n32\t  screenToWorld(sx: number, sy: number): { wx: number; wy: number } {\n33\t    return {\n34\t      wx: (sx - this.x) / this.zoom,\n35\t      wy: (sy - this.y) / this.zoom,\n36\t    };\n37\t  }\n38\t\n39\t  // Convert world coords to screen coords\n40\t  worldToScreen(wx: number, wy: number): { sx: number; sy: number } {\n41\t    return {\n42\t      sx: wx * this.zoom + this.x,\n43\t      sy: wy * this.zoom + this.y,\n44\t    };\n45\t  }\n46\t\n47\t  // Get the offset and scale for rendering\n48\t  getTransform(): { offsetX: number; offsetY: number; scale: number } {\n49\t    return {\n50\t      offsetX: this.x,\n51\t      offsetY: this.y,\n52\t      scale: this.zoom,\n53\t    };\n54\t  }\n55\t\n56\t  // Zoom toward a point (usually mouse position)\n57\t  zoomAt(delta: number, screenX: number, screenY: number): void {\n58\t    const oldZoom = this.zoom;\n59\t    this.targetZoom = Math.max(this.minZoom, Math.min(this.maxZoom, this.targetZoom * (1 - delta * 0.001)));\n60\t    this.zoom = this.targetZoom;\n61\t\n62\t    // Adjust position to zoom toward the cursor\n63\t    const zoomRatio = this.zoom / oldZoom;\n64\t    this.x = screenX - (screenX - this.x) * zoomRatio;\n65\t    this.y = screenY - (screenY - this.y) * zoomRatio;\n66\t  }\n67\t\n68\t  private setupInput(canvas: HTMLCanvasElement): void {\n69\t    // Mouse drag for panning\n70\t    canvas.addEventListener('mousedown', (e) => {\n71\t      if (e.button === 0 || e.button === 1) { // left or middle button\n72\t        this.isDragging = true;\n73\t        this.dragStartX = e.clientX;\n74\t        this.dragStartY = e.clientY;\n75\t        this.camStartX = this.x;\n76\t        this.camStartY = this.y;\n77\t      }\n78\t    });\n79\t\n80\t    canvas.addEventListener('mousemove', (e) => {\n81\t      if (!this.isDragging) return;\n82\t      this.x = this.camStartX + (e.clientX - this.dragStartX);\n83\t      this.y = this.camStartY + (e.clientY - this.dragStartY);\n84\t    });\n85\t\n86\t    canvas.addEventListener('mouseup', () => {\n87\t      this.isDragging = false;\n88\t    });\n89\t\n90\t    canvas.addEventListener('mouseleave', () => {\n91\t      this.isDragging = false;\n92\t    });\n93\t\n94\t    // Mouse wheel for zooming\n95\t    canvas.addEventListener('wheel', (e) => {\n96\t      e.preventDefault();\n97\t      this.zoomAt(e.deltaY, e.offsetX, e.offsetY);\n98\t    }, { passive: false });\n99\t\n100\t    // Touch support\n101\t    let lastTouchDist = 0;\n102\t    let lastTouchCenter = { x: 0, y: 0 };\n103\t\n104\t    canvas.addEventListener('touchstart', (e) => {\n105\t      if (e.touches.length === 1) {\n106\t        this.isDragging = true;\n107\t        this.dragStartX = e.touches[0].clientX;\n108\t        this.dragStartY = e.touches[0].clientY;\n109\t        this.camStartX = this.x;\n110\t        this.camStartY = this.y;\n111\t      } else if (e.touches.length === 2) {\n112\t        this.isDragging = false;\n113\t        lastTouchDist = this.getTouchDistance(e.touches);\n114\t        lastTouchCenter = this.getTouchCenter(e.touches);\n115\t      }\n116\t      e.preventDefault();\n117\t    }, { passive: false });\n118\t\n119\t    canvas.addEventListener('touchmove', (e) => {\n120\t      if (e.touches.length === 1 && this.isDragging) {\n121\t        this.x = this.camStartX + (e.touches[0].clientX - this.dragStartX);\n122\t        this.y = this.camStartY + (e.touches[0].clientY - this.dragStartY);\n123\t      } else if (e.touches.length === 2) {\n124\t        const dist = this.getTouchDistance(e.touches);\n125\t        const center = this.getTouchCenter(e.touches);\n126\t        const delta = lastTouchDist - dist;\n127\t        this.zoomAt(delta * 2, center.x, center.y);\n128\t        lastTouchDist = dist;\n129\t      }\n130\t      e.preventDefault();\n131\t    }, { passive: false });\n132\t\n133\t    canvas.addEventListener('touchend', () => {\n134\t      this.isDragging = false;\n135\t    });\n136\t  }\n137\t\n138\t  private getTouchDistance(touches: TouchList): number {\n139\t    const dx = touches[0].clientX - touches[1].clientX;\n140\t    const dy = touches[0].clientY - touches[1].clientY;\n141\t    return Math.sqrt(dx * dx + dy * dy);\n142\t  }\n143\t\n144\t  private getTouchCenter(touches: TouchList): { x: number; y: number } {\n145\t    return {\n146\t      x: (touches[0].clientX + touches[1].clientX) / 2,\n147\t      y: (touches[0].clientY + touches[1].clientY) / 2,\n148\t    };\n149\t  }\n150\t\n151\t  // Check if the camera was dragged (for distinguishing click vs drag)\n152\t  wasDragged(): boolean {\n153\t    return this.isDragging && (\n154\t      Math.abs(this.x - this.camStartX) > 3 ||\n155\t      Math.abs(this.y - this.camStartY) > 3\n156\t    );\n157\t  }\n158\t}\n159\t"}]},"parent_tool_use_id":null,"session_id":"c0e01ba0-5708-46af-9590-e43af2395006","uuid":"608a0700-c2c2-43f8-a344-60b58409532e","timestamp":"2026-05-23T01:35:10.754Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\renderer\\Camera.ts","content":"// Camera.ts — Camera system with zoom, pan, and coordinate transformation\n\nexport class Camera {\n  x: number = 0;\n  y: number = 0;\n  zoom: number = 1;\n  minZoom: number = 0.25;\n  maxZoom: number = 4;\n  targetZoom: number = 1;\n\n  private isDragging: boolean = false;\n  private dragStartX: number = 0;\n  private dragStartY: number = 0;\n  private camStartX: number = 0;\n  private camStartY: number = 0;\n  private canvas: HTMLCanvasElement;\n\n  constructor(canvas: HTMLCanvasElement) {\n    this.canvas = canvas;\n    this.setupInput(canvas);\n  }\n\n  // Center the camera on a map position\n  centerOnMap(mapWidth: number, mapHeight: number, cellSize: number): void {\n    const mapPixelW = mapWidth * cellSize * this.zoom;\n    const mapPixelH = mapHeight * cellSize * this.zoom;\n    this.x = (this.canvas.width - mapPixelW) / 2;\n    this.y = (this.canvas.height - mapPixelH) / 2;\n  }\n\n  // Convert screen coords to world coords\n  screenToWorld(sx: number, sy: number): { wx: number; wy: number } {\n    return {\n      wx: (sx - this.x) / this.zoom,\n      wy: (sy - this.y) / this.zoom,\n    };\n  }\n\n  // Convert world coords to screen coords\n  worldToScreen(wx: number, wy: number): { sx: number; sy: number } {\n    return {\n      sx: wx * this.zoom + this.x,\n      sy: wy * this.zoom + this.y,\n    };\n  }\n\n  // Get the offset and scale for rendering\n  getTransform(): { offsetX: number; offsetY: number; scale: number } {\n    return {\n      offsetX: this.x,\n      offsetY: this.y,\n      scale: this.zoom,\n    };\n  }\n\n  // Zoom toward a point (usually mouse position)\n  zoomAt(delta: number, screenX: number, screenY: number): void {\n    const oldZoom = this.zoom;\n    this.targetZoom = Math.max(this.minZoom, Math.min(this.maxZoom, this.targetZoom * (1 - delta * 0.001)));\n    this.zoom = this.targetZoom;\n\n    // Adjust position to zoom toward the cursor\n    const zoomRatio = this.zoom / oldZoom;\n    this.x = screenX - (screenX - this.x) * zoomRatio;\n    this.y = screenY - (screenY - this.y) * zoomRatio;\n  }\n\n  private setupInput(canvas: HTMLCanvasElement): void {\n    // Mouse drag for panning\n    canvas.addEventListener('mousedown', (e) => {\n      if (e.button === 0 || e.button === 1) { // left or middle button\n        this.isDragging = true;\n        this.dragStartX = e.clientX;\n        this.dragStartY = e.clientY;\n        this.camStartX = this.x;\n        this.camStartY = this.y;\n      }\n    });\n\n    canvas.addEventListener('mousemove', (e) => {\n      if (!this.isDragging) return;\n      this.x = this.camStartX + (e.clientX - this.dragStartX);\n      this.y = this.camStartY + (e.clientY - this.dragStartY);\n    });\n\n    canvas.addEventListener('mouseup', () => {\n      this.isDragging = false;\n    });\n\n    canvas.addEventListener('mouseleave', () => {\n      this.isDragging = false;\n    });\n\n    // Mouse wheel for zooming\n    canvas.addEventListener('wheel', (e) => {\n      e.preventDefault();\n      this.zoomAt(e.deltaY, e.offsetX, e.offsetY);\n    }, { passive: false });\n\n    // Touch support\n    let lastTouchDist = 0;\n    let lastTouchCenter = { x: 0, y: 0 };\n\n    canvas.addEventListener('touchstart', (e) => {\n      if (e.touches.length === 1) {\n        this.isDragging = true;\n        this.dragStartX = e.touches[0].clientX;\n        this.dragStartY = e.touches[0].clientY;\n        this.camStartX = this.x;\n        this.camStartY = this.y;\n      } else if (e.touches.length === 2) {\n        this.isDragging = false;\n        lastTouchDist = this.getTouchDistance(e.touches);\n        lastTouchCenter = this.getTouchCenter(e.touches);\n      }\n      e.preventDefault();\n    }, { passive: false });\n\n    canvas.addEventListener('touchmove', (e) => {\n      if (e.touches.length === 1 && this.isDragging) {\n        this.x = this.camStartX + (e.touches[0].clientX - this.dragStartX);\n        this.y = this.camStartY + (e.touches[0].clientY - this.dragStartY);\n      } else if (e.touches.length === 2) {\n        const dist = this.getTouchDistance(e.touches);\n        const center = this.getTouchCenter(e.touches);\n        const delta = lastTouchDist - dist;\n        this.zoomAt(delta * 2, center.x, center.y);\n        lastTouchDist = dist;\n      }\n      e.preventDefault();\n    }, { passive: false });\n\n    canvas.addEventListener('touchend', () => {\n      this.isDragging = false;\n    });\n  }\n\n  private getTouchDistance(touches: TouchList): number {\n    const dx = touches[0].clientX - touches[1].clientX;\n    const dy = touches[0].clientY - touches[1].clientY;\n    return Math.sqrt(dx * dx + dy * dy);\n  }\n\n  private getTouchCenter(touches: TouchList): { x: number; y: number } {\n    return {\n      x: (touches[0].clientX + touches[1].clientX) / 2,\n      y: (touches[0].clientY + touches[1].clientY) / 2,\n    };\n  }\n\n  // Check if the camera was dragged (for distinguishing click vs drag)\n  wasDragged(): boolean {\n    return this.isDragging && (\n      Math.abs(this.x - this.camStartX) > 3 ||\n      Math.abs(this.y - this.camStartY) > 3\n    );\n  }\n}\n","numLines":159,"startLine":1,"totalLines":159}}}
