{"type":"assistant","message":{"id":"msg_20260523075518e5248eee2529421f","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_53d5dfb2548041e182c840d7","name":"Write","input":{"file_path":"D:/game-projects/douyin-idiom/src/js/IdiomEngine.js","content":"// IdiomEngine.js — Question generation engine\n\nclass IdiomEngine {\n  constructor(db) {\n    this.db = db;\n    this.history = new Set();\n  }\n\n  getByDifficulty(difficulty) {\n    return this.db.filter(i => i.difficulty === difficulty);\n  }\n\n  pickRandom(pool) {\n    const available = pool.filter(i => !this.history.has(i.id));\n    if (available.length === 0) {\n      this.history.clear();\n      return pool[Math.floor(Math.random() * pool.length)];\n    }\n    return available[Math.floor(Math.random() * available.length)];\n  }\n\n  generateDistractors(idiom, count) {\n    const chars = idiom.chars;\n    const allChars = this.db.flatMap(i => i.chars);\n    const pool = [...new Set(allChars)].filter(c => !chars.includes(c));\n    const result = [];\n    const used = new Set(chars);\n    while (result.length < count && pool.length > 0) {\n      const idx = Math.floor(Math.random() * pool.length);\n      const c = pool[idx];\n      if (!used.has(c)) {\n        result.push(c);\n        used.add(c);\n      }\n      pool.splice(idx, 1);\n    }\n    return result;\n  }\n\n  generateQuestion(difficulty) {\n    const pool = this.getByDifficulty(difficulty);\n    if (pool.length === 0) return null;\n\n    const idiom = this.pickRandom(pool);\n    this.history.add(idiom.id);\n\n    const distractorCount = [0, 4, 6, 8, 8][difficulty] || 4;\n    const distractors = this.generateDistractors(idiom, distractorCount);\n\n    const candidates = this.shuffle([...idiom.chars, ...distractors]);\n\n    return {\n      idiom,\n      slots: [null, null, null, null],\n      candidates: candidates.map((char, i) => ({ char, index: i, used: false })),\n      answered: false,\n      correct: null\n    };\n  }\n\n  generateForLevel(levelConfig) {\n    const difficulty = levelConfig.difficulty || 1;\n    const count = levelConfig.questions || 10;\n    const questions = [];\n    for (let i = 0; i < count; i++) {\n      const q = this.generateQuestion(difficulty);\n      if (q) questions.push(q);\n    }\n    return questions;\n  }\n\n  shuffle(arr) {\n    const a = [...arr];\n    for (let i = a.length - 1; i > 0; i--) {\n      const j = Math.floor(Math.random() * (i + 1));\n      [a[i], a[j]] = [a[j], a[i]];\n    }\n    return a;\n  }\n\n  reset() {\n    this.history.clear();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { IdiomEngine };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"930c8880-e9f5-4f41-8841-d1efd19066ee","uuid":"41e95df8-0c77-4b31-ae70-aac4633d7c31"}
{"type":"assistant","message":{"id":"msg_20260523075518e5248eee2529421f","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_6693f4bc49f0409eb0ab385e","name":"Write","input":{"file_path":"D:/game-projects/douyin-idiom/src/js/Judge.js","content":"// Judge.js — Answer judgment logic\n\nclass Judge {\n  constructor() {\n    this.slots = [null, null, null, null];\n    this.fillCount = 0;\n    this.currentIdiom = null;\n  }\n\n  startQuestion(question) {\n    this.slots = [null, null, null, null];\n    this.fillCount = 0;\n    this.currentIdiom = question.idiom;\n    this.candidates = question.candidates;\n  }\n\n  placeChar(candidateIndex) {\n    if (this.fillCount >= 4) return { action: 'full', slot: -1 };\n    if (!this.candidates[candidateIndex] || this.candidates[candidateIndex].used) {\n      return { action: 'used', slot: -1 };\n    }\n\n    this.candidates[candidateIndex].used = true;\n    const char = this.candidates[candidateIndex].char;\n    this.slots[this.fillCount] = { char, candidateIndex };\n    this.fillCount++;\n\n    if (this.fillCount === 4) {\n      return this.checkAnswer();\n    }\n\n    return { action: 'placed', slot: this.fillCount - 1, char, fillCount: this.fillCount };\n  }\n\n  removeSlot(slotIndex) {\n    if (slotIndex < 0 || slotIndex >= this.fillCount) return { action: 'invalid' };\n    const removed = this.slots[slotIndex];\n    if (!removed) return { action: 'invalid' };\n\n    this.candidates[removed.candidateIndex].used = false;\n\n    for (let i = slotIndex; i < 3; i++) {\n      this.slots[i] = this.slots[i + 1];\n    }\n    this.slots[3] = null;\n    this.fillCount--;\n\n    return { action: 'removed', slotIndex, char: removed.char, fillCount: this.fillCount };\n  }\n\n  checkAnswer() {\n    const answer = this.slots.map(s => s ? s.char : '');\n    const correct = this.currentIdiom.chars;\n    const isCorrect = answer.every((c, i) => c === correct[i]);\n\n    return {\n      action: isCorrect ? 'correct' : 'wrong',\n      answer,\n      correct,\n      isCorrect,\n      idiom: this.currentIdiom\n    };\n  }\n\n  getSlots() { return this.slots; }\n  getFillCount() { return this.fillCount; }\n\n  reset() {\n    this.slots = [null, null, null, null];\n    this.fillCount = 0;\n    this.currentIdiom = null;\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Judge };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"930c8880-e9f5-4f41-8841-d1efd19066ee","uuid":"a0626dc8-6a68-4b17-8320-abb6eb3ecfa8"}
{"type":"assistant","message":{"id":"msg_20260523075518e5248eee2529421f","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_3d0146b87f2e4126b4ee2764","name":"Write","input":{"file_path":"D:/game-projects/douyin-idiom/src/js/ComboSystem.js","content":"// ComboSystem.js — Combo tracking and scoring\n\nclass ComboSystem {\n  constructor() {\n    this.combo = 0;\n    this.maxCombo = 0;\n    this.score = 0;\n    this.correctCount = 0;\n    this.wrongCount = 0;\n  }\n\n  onCorrect(usedHint = false) {\n    this.correctCount++;\n    this.combo++;\n    if (this.combo > this.maxCombo) this.maxCombo = this.combo;\n\n    let baseScore = 100;\n    let comboBonus = 0;\n\n    if (!usedHint) {\n      comboBonus = this.getComboBonus();\n      this.score += baseScore + comboBonus;\n    } else {\n      this.score += baseScore;\n    }\n\n    return {\n      combo: this.combo,\n      score: this.score,\n      baseScore,\n      comboBonus,\n      totalGain: baseScore + comboBonus,\n      message: this.getComboMessage(),\n      effect: this.getComboEffect()\n    };\n  }\n\n  onWrong() {\n    this.wrongCount++;\n    const prevCombo = this.combo;\n    this.combo = 0;\n    return { combo: 0, prevCombo, message: '连击中断' };\n  }\n\n  onSkip() {\n    this.combo = 0;\n    return { combo: 0, message: '跳过本题' };\n  }\n\n  getComboBonus() {\n    if (this.combo < 3) return 0;\n    if (this.combo < 5) return (this.combo - 2) * 20;\n    if (this.combo < 8) return 100 + (this.combo - 5) * 30;\n    if (this.combo < 10) return 200 + (this.combo - 8) * 40;\n    return 300 + (this.combo - 10) * 50;\n  }\n\n  getComboMessage() {\n    if (this.combo >= 10) return '成语大师！！';\n    if (this.combo >= 8) return '学霸！';\n    if (this.combo >= 5) return '厉害了！';\n    if (this.combo >= 3) return '不错！';\n    return '';\n  }\n\n  getComboEffect() {\n    if (this.combo >= 10) return 'fireworks';\n    if (this.combo >= 8) return 'golden';\n    if (this.combo >= 5) return 'shake';\n    if (this.combo >= 3) return 'text';\n    return null;\n  }\n\n  getStarRating(correctCount, totalQuestions) {\n    const rate = correctCount / totalQuestions;\n    if (rate >= 0.9) return 3;\n    if (rate >= 0.7) return 2;\n    if (rate >= 0.5) return 1;\n    return 0;\n  }\n\n  getStats() {\n    return {\n      score: this.score,\n      combo: this.combo,\n      maxCombo: this.maxCombo,\n      correctCount: this.correctCount,\n      wrongCount: this.wrongCount,\n      totalAnswered: this.correctCount + this.wrongCount\n    };\n  }\n\n  reset() {\n    this.combo = 0;\n    this.maxCombo = 0;\n    this.score = 0;\n    this.correctCount = 0;\n    this.wrongCount = 0;\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { ComboSystem };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"930c8880-e9f5-4f41-8841-d1efd19066ee","uuid":"eaa7529b-2d98-4ddf-b963-8136f18e54fa"}
{"type":"assistant","message":{"id":"msg_20260523075518e5248eee2529421f","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_1f879be65c284edb914526a6","name":"Write","input":{"file_path":"D:/game-projects/douyin-idiom/src/js/DataManager.js","content":"// DataManager.js — localStorage persistence\n\nclass DataManager {\n  constructor() {\n    this.STORAGE_KEY = 'idiom_master_save';\n    this.data = this._load();\n  }\n\n  _defaults() {\n    return {\n      levelStars: {},\n      unlockedLevel: 1,\n      coins: 0,\n      soundEnabled: true,\n      collectedIdioms: [],\n      totalScore: 0,\n      gamesPlayed: 0,\n      bestCombo: 0\n    };\n  }\n\n  _load() {\n    try {\n      const raw = localStorage.getItem(this.STORAGE_KEY);\n      if (raw) return { ...this._defaults(), ...JSON.parse(raw) };\n    } catch (e) { /* ignore */ }\n    return this._defaults();\n  }\n\n  save() {\n    try {\n      localStorage.setItem(this.STORAGE_KEY, JSON.stringify(this.data));\n    } catch (e) { /* ignore */ }\n  }\n\n  getLevelStars(id) { return this.data.levelStars[id] || 0; }\n\n  setLevelStars(id, stars) {\n    if (stars > (this.data.levelStars[id] || 0)) {\n      this.data.levelStars[id] = stars;\n    }\n    if (id >= this.data.unlockedLevel) {\n      this.data.unlockedLevel = id + 1;\n    }\n    this.save();\n  }\n\n  get unlockedLevel() { return this.data.unlockedLevel; }\n  get coins() { return this.data.coins; }\n\n  addCoins(n) { this.data.coins += n; this.save(); return this.data.coins; }\n  spendCoins(n) {\n    if (this.data.coins >= n) { this.data.coins -= n; this.save(); return true; }\n    return false;\n  }\n\n  collectIdiom(id) {\n    if (!this.data.collectedIdioms.includes(id)) {\n      this.data.collectedIdioms.push(id);\n      this.save();\n    }\n  }\n\n  get collectedCount() { return this.data.collectedIdioms.length; }\n\n  addScore(n) {\n    this.data.totalScore += n;\n    this.data.gamesPlayed++;\n    this.save();\n  }\n\n  updateBestCombo(n) {\n    if (n > this.data.bestCombo) {\n      this.data.bestCombo = n;\n      this.save();\n    }\n  }\n\n  reset() { this.data = this._defaults(); this.save(); }\n}\n\nif (typeof module !== 'undefined') module.exports = { DataManager };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"930c8880-e9f5-4f41-8841-d1efd19066ee","uuid":"a184ae6f-4dc3-438b-8fe8-9f2a7a19d5fc"}
