{"type":"assistant","message":{"id":"msg_20260523120059bfc2b950ea8b433c","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_df8d8c83b88c430a84d178b3","name":"Write","input":{"file_path":"D:\\game-projects\\steam-horror-sim\\src\\game\\ProductManager.ts","content":"// ProductManager.ts — Product catalog, inventory, supplier ordering (M2)\n\nimport productsData from '../data/products.json';\nimport suppliersData from '../data/suppliers.json';\n\nexport interface ProductDef {\n  id: string;\n  name: string;\n  cost: number;\n  basePrice: number;\n  shelfSlots: number;\n  shelfLife: number | null;\n  isAnomalous?: boolean;\n}\n\nexport interface CategoryDef {\n  id: string;\n  name: string;\n  shelfType: string;\n  products: ProductDef[];\n}\n\nexport interface SupplierDef {\n  id: string;\n  name: string;\n  description: string;\n  priceMultiplier: number;\n  reliability: number;\n  deliveryDelay: number;\n  unlockDay: number;\n  stockVariation: number;\n  nightOnly?: boolean;\n  specialOnly?: boolean;\n}\n\nexport interface InventoryItem {\n  productId: string;\n  quantity: number;\n  maxQuantity: number;\n  expiryDay: number | null;\n}\n\nexport interface OrderRequest {\n  productId: string;\n  quantity: number;\n  supplierId: string;\n  totalCost: number;\n  arrivalDay: number;\n  fulfilled: boolean;\n}\n\nexport interface ShelfSlot {\n  shelfId: string;\n  productId: string | null;\n  quantity: number;\n  maxQuantity: number;\n}\n\nconst ALL_PRODUCTS: ProductDef[] = productsData.categories.flatMap(c => c.products);\nconst ALL_CATEGORIES: CategoryDef[] = productsData.categories;\nconst ALL_SUPPLIERS: SupplierDef[] = suppliersData.suppliers;\n\nconst BASE_STORAGE = 100;\nconst SHELF_CAPACITY = 10;\n\nexport class ProductManager {\n  products: ProductDef[] = ALL_PRODUCTS;\n  categories: CategoryDef[] = ALL_CATEGORIES;\n  suppliers: SupplierDef[] = ALL_SUPPLIERS;\n\n  inventory: Map<string, InventoryItem> = new Map();\n  pendingOrders: OrderRequest[] = [];\n  shelfSlots: Map<string, ShelfSlot> = new Map();\n  storageCapacity = BASE_STORAGE;\n  storageUsed = 0;\n\n  constructor() {\n    this.initShelfSlots();\n  }\n\n  private initShelfSlots(): void {\n    const shelfIds = [\n      'shelf_1', 'shelf_2', 'shelf_3', 'shelf_4', 'shelf_5',\n      'fridge_1', 'fridge_2',\n    ];\n    for (const id of shelfIds) {\n      this.shelfSlots.set(id, {\n        shelfId: id,\n        productId: null,\n        quantity: 0,\n        maxQuantity: SHELF_CAPACITY,\n      });\n    }\n  }\n\n  getProduct(id: string): ProductDef | undefined {\n    return this.products.find(p => p.id === id);\n  }\n\n  getCategory(productId: string): CategoryDef | undefined {\n    return this.categories.find(c => c.products.some(p => p.id === productId));\n  }\n\n  getUnlockedSuppliers(day: number, isNight: boolean): SupplierDef[] {\n    return this.suppliers.filter(s => {\n      if (s.unlockDay > day) return false;\n      if (s.nightOnly && !isNight) return false;\n      return true;\n    });\n  }\n\n  orderProduct(productId: string, quantity: number, supplierId: string, currentDay: number): OrderRequest | null {\n    const product = this.getProduct(productId);\n    const supplier = this.suppliers.find(s => s.id === supplierId);\n    if (!product || !supplier) return null;\n    if (supplier.unlockDay > currentDay) return null;\n\n    const unitCost = product.cost * supplier.priceMultiplier;\n    const totalCost = Math.round(unitCost * quantity * 100) / 100;\n\n    if (supplier.stockVariation > 0 && Math.random() < supplier.stockVariation) {\n      quantity = Math.max(1, Math.floor(quantity * (0.5 + Math.random() * 0.5)));\n    }\n\n    const order: OrderRequest = {\n      productId,\n      quantity,\n      supplierId,\n      totalCost,\n      arrivalDay: currentDay + supplier.deliveryDelay,\n      fulfilled: false,\n    };\n\n    this.pendingOrders.push(order);\n    return order;\n  }\n\n  processPendingOrders(currentDay: number): OrderRequest[] {\n    const fulfilled: OrderRequest[] = [];\n    for (const order of this.pendingOrders) {\n      if (!order.fulfilled && currentDay >= order.arrivalDay) {\n        order.fulfilled = true;\n        this.addToInventory(order.productId, order.quantity, currentDay);\n        fulfilled.push(order);\n      }\n    }\n    this.pendingOrders = this.pendingOrders.filter(o => !o.fulfilled);\n    return fulfilled;\n  }\n\n  addToInventory(productId: string, quantity: number, currentDay: number): void {\n    const product = this.getProduct(productId);\n    if (!product) return;\n\n    const existing = this.inventory.get(productId);\n    const expiryDay = product.shelfLife ? currentDay + product.shelfLife : null;\n\n    if (existing) {\n      existing.quantity += quantity;\n      if (expiryDay && existing.expiryDay === null) {\n        existing.expiryDay = expiryDay;\n      }\n    } else {\n      this.inventory.set(productId, {\n        productId,\n        quantity,\n        maxQuantity: this.storageCapacity,\n        expiryDay,\n      });\n    }\n    this.recalcStorageUsed();\n  }\n\n  removeFromInventory(productId: string, quantity: number): boolean {\n    const item = this.inventory.get(productId);\n    if (!item || item.quantity < quantity) return false;\n    item.quantity -= quantity;\n    if (item.quantity <= 0) {\n      this.inventory.delete(productId);\n    }\n    this.recalcStorageUsed();\n    return true;\n  }\n\n  getInventoryQuantity(productId: string): number {\n    return this.inventory.get(productId)?.quantity ?? 0;\n  }\n\n  expireProducts(currentDay: number): string[] {\n    const expired: string[] = [];\n    for (const [id, item] of this.inventory) {\n      if (item.expiryDay !== null && currentDay > item.expiryDay) {\n        expired.push(id);\n        this.inventory.delete(id);\n      }\n    }\n    if (expired.length > 0) this.recalcStorageUsed();\n    return expired;\n  }\n\n  stockShelf(shelfId: string, productId: string, quantity: number): number {\n    const slot = this.shelfSlots.get(shelfId);\n    if (!slot) return 0;\n\n    const inv = this.inventory.get(productId);\n    if (!inv || inv.quantity < 1) return 0;\n\n    if (slot.productId && slot.productId !== productId) {\n      // Different product already on shelf\n      return 0;\n    }\n\n    const available = Math.min(quantity, inv.quantity);\n    const space = slot.maxQuantity - slot.quantity;\n    const toStock = Math.min(available, space);\n\n    if (toStock <= 0) return 0;\n\n    slot.productId = productId;\n    slot.quantity += toStock;\n    this.removeFromInventory(productId, toStock);\n    return toStock;\n  }\n\n  unstockShelf(shelfId: string, quantity: number): string | null {\n    const slot = this.shelfSlots.get(shelfId);\n    if (!slot || !slot.productId || slot.quantity < 1) return null;\n\n    const toRemove = Math.min(quantity, slot.quantity);\n    const productId = slot.productId;\n\n    slot.quantity -= toRemove;\n    this.addToInventory(productId, toRemove, 0);\n\n    if (slot.quantity <= 0) {\n      slot.productId = null;\n    }\n    return productId;\n  }\n\n  takeFromShelf(shelfId: string): string | null {\n    const slot = this.shelfSlots.get(shelfId);\n    if (!slot || !slot.productId || slot.quantity < 1) return null;\n    slot.quantity--;\n    if (slot.quantity <= 0) slot.productId = null;\n    return slot.productId;\n  }\n\n  getShelfProduct(shelfId: string): ProductDef | null {\n    const slot = this.shelfSlots.get(shelfId);\n    if (!slot?.productId) return null;\n    return this.getProduct(slot.productId) ?? null;\n  }\n\n  getShelfQuantity(shelfId: string): number {\n    return this.shelfSlots.get(shelfId)?.quantity ?? 0;\n  }\n\n  getShelfSlotsByType(type: string): ShelfSlot[] {\n    const prefix = type === 'fridge' ? 'fridge_' : 'shelf_';\n    const result: ShelfSlot[] = [];\n    for (const [id, slot] of this.shelfSlots) {\n      if (id.startsWith(prefix)) result.push(slot);\n    }\n    return result;\n  }\n\n  upgradeStorage(multiplier: number): void {\n    this.storageCapacity = Math.floor(BASE_STORAGE * (1 + multiplier));\n    for (const item of this.inventory.values()) {\n      item.maxQuantity = this.storageCapacity;\n    }\n  }\n\n  getSaveData(): Record<string, unknown> {\n    return {\n      inventory: Array.from(this.inventory.entries()),\n      pendingOrders: this.pendingOrders,\n      shelfSlots: Array.from(this.shelfSlots.entries()),\n      storageCapacity: this.storageCapacity,\n    };\n  }\n\n  loadSaveData(data: Record<string, unknown>): void {\n    if (data.inventory) this.inventory = new Map(data.inventory as [string, InventoryItem][]);\n    if (data.pendingOrders) this.pendingOrders = data.pendingOrders as OrderRequest[];\n    if (data.shelfSlots) this.shelfSlots = new Map(data.shelfSlots as [string, ShelfSlot][]);\n    if (data.storageCapacity) this.storageCapacity = data.storageCapacity as number;\n    this.recalcStorageUsed();\n  }\n\n  private recalcStorageUsed(): void {\n    let total = 0;\n    for (const item of this.inventory.values()) total += item.quantity;\n    this.storageUsed = total;\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"e4781836-91b7-498e-bc35-c2b84a36028a","uuid":"d04b693f-7c46-489d-8179-8b49b43509e5"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_df8d8c83b88c430a84d178b3","type":"tool_result","content":"File created successfully at: D:\\game-projects\\steam-horror-sim\\src\\game\\ProductManager.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"e4781836-91b7-498e-bc35-c2b84a36028a","uuid":"8f53da26-a92e-4357-b288-b0458526b9dd","timestamp":"2026-05-23T04:01:43.275Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\steam-horror-sim\\src\\game\\ProductManager.ts","content":"// ProductManager.ts — Product catalog, inventory, supplier ordering (M2)\n\nimport productsData from '../data/products.json';\nimport suppliersData from '../data/suppliers.json';\n\nexport interface ProductDef {\n  id: string;\n  name: string;\n  cost: number;\n  basePrice: number;\n  shelfSlots: number;\n  shelfLife: number | null;\n  isAnomalous?: boolean;\n}\n\nexport interface CategoryDef {\n  id: string;\n  name: string;\n  shelfType: string;\n  products: ProductDef[];\n}\n\nexport interface SupplierDef {\n  id: string;\n  name: string;\n  description: string;\n  priceMultiplier: number;\n  reliability: number;\n  deliveryDelay: number;\n  unlockDay: number;\n  stockVariation: number;\n  nightOnly?: boolean;\n  specialOnly?: boolean;\n}\n\nexport interface InventoryItem {\n  productId: string;\n  quantity: number;\n  maxQuantity: number;\n  expiryDay: number | null;\n}\n\nexport interface OrderRequest {\n  productId: string;\n  quantity: number;\n  supplierId: string;\n  totalCost: number;\n  arrivalDay: number;\n  fulfilled: boolean;\n}\n\nexport interface ShelfSlot {\n  shelfId: string;\n  productId: string | null;\n  quantity: number;\n  maxQuantity: number;\n}\n\nconst ALL_PRODUCTS: ProductDef[] = productsData.categories.flatMap(c => c.products);\nconst ALL_CATEGORIES: CategoryDef[] = productsData.categories;\nconst ALL_SUPPLIERS: SupplierDef[] = suppliersData.suppliers;\n\nconst BASE_STORAGE = 100;\nconst SHELF_CAPACITY = 10;\n\nexport class ProductManager {\n  products: ProductDef[] = ALL_PRODUCTS;\n  categories: CategoryDef[] = ALL_CATEGORIES;\n  suppliers: SupplierDef[] = ALL_SUPPLIERS;\n\n  inventory: Map<string, InventoryItem> = new Map();\n  pendingOrders: OrderRequest[] = [];\n  shelfSlots: Map<string, ShelfSlot> = new Map();\n  storageCapacity = BASE_STORAGE;\n  storageUsed = 0;\n\n  constructor() {\n    this.initShelfSlots();\n  }\n\n  private initShelfSlots(): void {\n    const shelfIds = [\n      'shelf_1', 'shelf_2', 'shelf_3', 'shelf_4', 'shelf_5',\n      'fridge_1', 'fridge_2',\n    ];\n    for (const id of shelfIds) {\n      this.shelfSlots.set(id, {\n        shelfId: id,\n        productId: null,\n        quantity: 0,\n        maxQuantity: SHELF_CAPACITY,\n      });\n    }\n  }\n\n  getProduct(id: string): ProductDef | undefined {\n    return this.products.find(p => p.id === id);\n  }\n\n  getCategory(productId: string): CategoryDef | undefined {\n    return this.categories.find(c => c.products.some(p => p.id === productId));\n  }\n\n  getUnlockedSuppliers(day: number, isNight: boolean): SupplierDef[] {\n    return this.suppliers.filter(s => {\n      if (s.unlockDay > day) return false;\n      if (s.nightOnly && !isNight) return false;\n      return true;\n    });\n  }\n\n  orderProduct(productId: string, quantity: number, supplierId: string, currentDay: number): OrderRequest | null {\n    const product = this.getProduct(productId);\n    const supplier = this.suppliers.find(s => s.id === supplierId);\n    if (!product || !supplier) return null;\n    if (supplier.unlockDay > currentDay) return null;\n\n    const unitCost = product.cost * supplier.priceMultiplier;\n    const totalCost = Math.round(unitCost * quantity * 100) / 100;\n\n    if (supplier.stockVariation > 0 && Math.random() < supplier.stockVariation) {\n      quantity = Math.max(1, Math.floor(quantity * (0.5 + Math.random() * 0.5)));\n    }\n\n    const order: OrderRequest = {\n      productId,\n      quantity,\n      supplierId,\n      totalCost,\n      arrivalDay: currentDay + supplier.deliveryDelay,\n      fulfilled: false,\n    };\n\n    this.pendingOrders.push(order);\n    return order;\n  }\n\n  processPendingOrders(currentDay: number): OrderRequest[] {\n    const fulfilled: OrderRequest[] = [];\n    for (const order of this.pendingOrders) {\n      if (!order.fulfilled && currentDay >= order.arrivalDay) {\n        order.fulfilled = true;\n        this.addToInventory(order.productId, order.quantity, currentDay);\n        fulfilled.push(order);\n      }\n    }\n    this.pendingOrders = this.pendingOrders.filter(o => !o.fulfilled);\n    return fulfilled;\n  }\n\n  addToInventory(productId: string, quantity: number, currentDay: number): void {\n    const product = this.getProduct(productId);\n    if (!product) return;\n\n    const existing = this.inventory.get(productId);\n    const expiryDay = product.shelfLife ? currentDay + product.shelfLife : null;\n\n    if (existing) {\n      existing.quantity += quantity;\n      if (expiryDay && existing.expiryDay === null) {\n        existing.expiryDay = expiryDay;\n      }\n    } else {\n      this.inventory.set(productId, {\n        productId,\n        quantity,\n        maxQuantity: this.storageCapacity,\n        expiryDay,\n      });\n    }\n    this.recalcStorageUsed();\n  }\n\n  removeFromInventory(productId: string, quantity: number): boolean {\n    const item = this.inventory.get(productId);\n    if (!item || item.quantity < quantity) return false;\n    item.quantity -= quantity;\n    if (item.quantity <= 0) {\n      this.inventory.delete(productId);\n    }\n    this.recalcStorageUsed();\n    return true;\n  }\n\n  getInventoryQuantity(productId: string): number {\n    return this.inventory.get(productId)?.quantity ?? 0;\n  }\n\n  expireProducts(currentDay: number): string[] {\n    const expired: string[] = [];\n    for (const [id, item] of this.inventory) {\n      if (item.expiryDay !== null && currentDay > item.expiryDay) {\n        expired.push(id);\n        this.inventory.delete(id);\n      }\n    }\n    if (expired.length > 0) this.recalcStorageUsed();\n    return expired;\n  }\n\n  stockShelf(shelfId: string, productId: string, quantity: number): number {\n    const slot = this.shelfSlots.get(shelfId);\n    if (!slot) return 0;\n\n    const inv = this.inventory.get(productId);\n    if (!inv || inv.quantity < 1) return 0;\n\n    if (slot.productId && slot.productId !== productId) {\n      // Different product already on shelf\n      return 0;\n    }\n\n    const available = Math.min(quantity, inv.quantity);\n    const space = slot.maxQuantity - slot.quantity;\n    const toStock = Math.min(available, space);\n\n    if (toStock <= 0) return 0;\n\n    slot.productId = productId;\n    slot.quantity += toStock;\n    this.removeFromInventory(productId, toStock);\n    return toStock;\n  }\n\n  unstockShelf(shelfId: string, quantity: number): string | null {\n    const slot = this.shelfSlots.get(shelfId);\n    if (!slot || !slot.productId || slot.quantity < 1) return null;\n\n    const toRemove = Math.min(quantity, slot.quantity);\n    const productId = slot.productId;\n\n    slot.quantity -= toRemove;\n    this.addToInventory(productId, toRemove, 0);\n\n    if (slot.quantity <= 0) {\n      slot.productId = null;\n    }\n    return productId;\n  }\n\n  takeFromShelf(shelfId: string): string | null {\n    const slot = this.shelfSlots.get(shelfId);\n    if (!slot || !slot.productId || slot.quantity < 1) return null;\n    slot.quantity--;\n    if (slot.quantity <= 0) slot.productId = null;\n    return slot.productId;\n  }\n\n  getShelfProduct(shelfId: string): ProductDef | null {\n    const slot = this.shelfSlots.get(shelfId);\n    if (!slot?.productId) return null;\n    return this.getProduct(slot.productId) ?? null;\n  }\n\n  getShelfQuantity(shelfId: string): number {\n    return this.shelfSlots.get(shelfId)?.quantity ?? 0;\n  }\n\n  getShelfSlotsByType(type: string): ShelfSlot[] {\n    const prefix = type === 'fridge' ? 'fridge_' : 'shelf_';\n    const result: ShelfSlot[] = [];\n    for (const [id, slot] of this.shelfSlots) {\n      if (id.startsWith(prefix)) result.push(slot);\n    }\n    return result;\n  }\n\n  upgradeStorage(multiplier: number): void {\n    this.storageCapacity = Math.floor(BASE_STORAGE * (1 + multiplier));\n    for (const item of this.inventory.values()) {\n      item.maxQuantity = this.storageCapacity;\n    }\n  }\n\n  getSaveData(): Record<string, unknown> {\n    return {\n      inventory: Array.from(this.inventory.entries()),\n      pendingOrders: this.pendingOrders,\n      shelfSlots: Array.from(this.shelfSlots.entries()),\n      storageCapacity: this.storageCapacity,\n    };\n  }\n\n  loadSaveData(data: Record<string, unknown>): void {\n    if (data.inventory) this.inventory = new Map(data.inventory as [string, InventoryItem][]);\n    if (data.pendingOrders) this.pendingOrders = data.pendingOrders as OrderRequest[];\n    if (data.shelfSlots) this.shelfSlots = new Map(data.shelfSlots as [string, ShelfSlot][]);\n    if (data.storageCapacity) this.storageCapacity = data.storageCapacity as number;\n    this.recalcStorageUsed();\n  }\n\n  private recalcStorageUsed(): void {\n    let total = 0;\n    for (const item of this.inventory.values()) total += item.quantity;\n    this.storageUsed = total;\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
