,idiom:\"泾渭分明\",chars:[\"泾\",\"渭\",\"分\",\"明\"],meaning:\"比喻界限清楚\",difficulty:3,category:[\"自然\"],frequency:14},\n{id:\"h127\",idiom:\"开门见山\",chars:[\"开\",\"门\",\"见\",\"山\"],meaning:\"比喻说话写文章直截了当\",difficulty:3,category:[\"自然\"],frequency:13},\n{id:\"h128\",idiom:\"两全其美\",chars:[\"两\",\"全\",\"其\",\"美\"],meaning:\"做一件事顾全到两方面使两方面都好\",difficulty:3,category:[\"常用\"],frequency:12},\n{id:\"h129\",idiom:\"妙笔生花\",chars:[\"妙\",\"笔\",\"生\",\"花\"],meaning:\"比喻杰出的写作才能\",difficulty:3,category:[\"自然\"],frequency:11},\n{id:\"h130\",idiom:\"旁征博引\",chars:[\"旁\",\"征\",\"博\",\"引\"],meaning:\"广泛引用各种材料做依据\",difficulty:3,category:[\"常用\"],frequency:10},\n{id:\"h131\",idiom:\"穷途末路\",chars:[\"穷\",\"途\",\"末\",\"路\"],meaning:\"形容到了无路可走的地步\",difficulty:3,category:[\"常用\"],frequency:9},\n{id:\"h132\",idiom:\"声名狼藉\",chars:[\"声\",\"名\",\"狼\",\"藉\"],meaning:\"形容名声坏到了极点\",difficulty:3,category:[\"人物\"],frequency:8},\n{id:\"h133\",idiom:\"无与伦比\",chars:[\"无\",\"与\",\"伦\",\"比\"],meaning:\"没有能比得上的\",difficulty:3,category:[\"常用\"],frequency:7},\n{id:\"h134\",idiom:\"兴利除弊\",chars:[\"兴\",\"利\",\"除\",\"弊\"],meaning:\"兴办有利的事业除去弊端\",difficulty:3,category:[\"常用\"],frequency:6},\n{id:\"h135\",idiom:\"一寸丹心\",chars:[\"一\",\"寸\",\"丹\",\"心\"],meaning:\"一片赤诚的心\",difficulty:3,category:[\"数字\"],frequency:5},\n{id:\"h136\",idiom:\"真知灼见\",chars:[\"真\",\"知\",\"灼\",\"见\"],meaning:\"正确而透彻的见解\",difficulty:3,category:[\"常用\"],frequency:4},\n{id:\"h137\",idiom:\"中流砥柱\",chars:[\"中\",\"流\",\"砥\",\"柱\"],meaning:\"比喻坚强的能起支柱作用的人或力量\",difficulty:3,category:[\"自然\"],frequency:3},\n{id:\"h138\",idiom:\"博闻强记\",chars:[\"博\",\"闻\",\"强\",\"记\"],meaning:\"见闻广博记忆力强\",difficulty:3,category:[\"人物\"],frequency:2},\n{id:\"h139\",idiom:\"大相径庭\",chars:[\"大\",\"相\",\"径\",\"庭\"],meaning:\"表示彼此相差很远或矛盾很大\",difficulty:3,category:[\"常用\"],frequency:1},\n{id:\"h140\",idiom:\"防微杜渐\",chars:[\"防\",\"微\",\"杜\",\"渐\"],meaning:\"在不良事物刚露头时就加以防止\",difficulty:3,category:[\"常用\"],frequency:30},\n{id:\"h141\",idiom:\"各行其是\",chars:[\"各\",\"行\",\"其\",\"是\"],meani