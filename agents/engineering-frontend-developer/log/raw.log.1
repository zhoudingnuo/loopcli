0,\n    grade: '下品',\n    color: '#ff8c32',\n  },\n  pill_peiyuan: {\n    id: 'pill_peiyuan',\n    name: '培元丹',\n    nameEn: 'Foundation Pill',\n    description: '培元固本的丹药',\n    effect: '服用获得修为+30',\n    cultivationAmount: 30,\n    grade: '下品',\n    color: '#ff6699',\n  },\n  pill_ningqi: {\n    id: 'pill_ningqi',\n    name: '凝气丹',\n    nameEn: 'Qi Condensing Pill',\n    description: '凝练灵气的高级丹药',\n    effect: '服用获得修为+50',\n    cultivationAmount: 50,\n    grade: '下品',\n    color: '#cc66ff',\n  },\n};\n\nexport function getPillDef(id: string): PillDef | undefined {\n  return PILL_DEFS[id];\n}\n\nexport function getAllPillDefs(): PillDef[] {\n  return Object.values(PILL_DEFS);\n}\n\n// Get all pills in inventory with their definitions and counts\nexport function getInventoryPills(resources: Record<string, number>): Array<PillDef & { count: number }> {\n  const result: Array<PillDef & { count: number }> = [];\n  for (const [id, def] of Object.entries(PILL_DEFS)) {\n    const count = resources[id] ?? 0;\n    if (count > 0) {\n      result.push({ ...def, count });\n    }\n  }\n  return result;\n}\n\n// Use a pill: returns cultivation amount gained\nexport function usePill(\n  pillId: string,\n  resources: Record<string, number>,\n): { cultivation: number; resources: Record<string, number> } | null {\n  const def = PILL_DEFS[pillId];\n  if (!def) return null;\n\n  const count = resources[pillId] ?? 0;\n  if (count <= 0) return null;\n\n  const newResources = { ...resources };\n  newResources[pillId] = count - 1;\n\n  return {\n    cultivation: def.cultivationAmount,\n    resources: newResources,\n  };\n}\n\n// Use multiple pills at once\nexport function useMultiplePills(\n  pillId: string,\n  amount: number,\n  resources: Record<string, number>,\n): { cultivation: number; resources: Record<string, number>; used: number } | null {\n  const def = PILL_DEFS[pillId];\n  if (!def) return null;\n\n  const count = resources[pillId] ?? 0;\n  const toUse = Math.min(count, amount);\n  if (toUse <= 0) return null;\n\n  const newResources = { ...resources };\n  newResources[pillId] = count - toUse;\n\n  return {\n    cultivation: def.cultivationAmount * toUse,\n    resources: newResources,\n    used: toUse,\n  };\n}\n","structuredPatch":[{"oldStart":42,"oldLines":6,"newStart":42,"newLines":26,"lines":["     grade: '下品',","     color: '#cc66ff',","   },","+  pill_zhuji: {","+    id: 'pill_zhuji',","+    name: '筑基丹',","+    nameEn: 'Foundation Pill',","+    description: '筑基必备丹药',","+    effect: '服用获得修为+100',","+    cultivationAmount: 100,","+    grade: '中品',","+    color: '#ffcc00',","+  },","+  pill_jindanyin: {","+    id: 'pill_jindanyin',","+    name: '金丹引',","+    nameEn: 'Golden Core Catalyst',","+    description: '金丹期必备丹药',","+    effect: '服用获得修为+500',","+    cultivationAmount: 500,","+    grade: '中品',","+    color: '#ff4444',","+  },"," };"," "," export function getPillDef(id: string): PillDef | undefined {"]}],"userModified":false,"replaceAll":false}}
