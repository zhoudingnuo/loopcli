{"type":"assistant","message":{"id":"msg_20260523120504ce695226f7b64bcc","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_64e13afa062f41b994b398aa","name":"Write","input":{"file_path":"D:\\game-projects\\steam-horror-sim\\src\\game\\ShelfInteraction.ts","content":"// ShelfInteraction.ts — Player interaction with shelves for stocking/unstocking (M2)\n\nimport { ProductManager } from './ProductManager';\nimport type { Interactable } from './GameState';\n\nexport enum ShelfAction {\n  NONE = 'none',\n  VIEW = 'view',\n  STOCK = 'stock',\n  UNSTOCK = 'unstock',\n  SELECT_PRODUCT = 'select_product',\n}\n\nexport interface ShelfInfo {\n  shelfId: string;\n  label: string;\n  productId: string | null;\n  productName: string | null;\n  quantity: number;\n  maxQuantity: number;\n  category: string | null;\n}\n\nexport class ShelfInteraction {\n  currentShelfId: string | null = null;\n  currentAction: ShelfAction = ShelfAction.NONE;\n  selectedProductIndex: number = 0;\n  stockQuantity: number = 5;\n  message: string | null = null;\n  messageTimer: number = 0;\n\n  interactWithShelf(\n    shelfId: string,\n    interactables: Interactable[],\n    productManager: ProductManager,\n  ): ShelfInfo | null {\n    const interactable = interactables.find(i => i.id === shelfId);\n    if (!interactable) return null;\n\n    const slot = productManager.shelfSlots.get(shelfId);\n    if (!slot) return null;\n\n    const product = slot.productId ? productManager.getProduct(slot.productId) : null;\n    const category = product ? productManager.getCategory(product.id) : null;\n\n    this.currentShelfId = shelfId;\n\n    if (slot.productId && slot.quantity > 0) {\n      this.currentAction = ShelfAction.VIEW;\n    } else {\n      this.currentAction = ShelfAction.STOCK;\n    }\n\n    return {\n      shelfId,\n      label: interactable.label,\n      productId: slot.productId,\n      productName: product?.name ?? null,\n      quantity: slot.quantity,\n      maxQuantity: slot.maxQuantity,\n      category: category?.name ?? null,\n    };\n  }\n\n  stockShelf(shelfId: string, productId: string, quantity: number, productManager: ProductManager): boolean {\n    const stocked = productManager.stockShelf(shelfId, productId, quantity);\n    if (stocked > 0) {\n      this.showMessage(`上架 ${stocked} 个商品`);\n      return true;\n    }\n    this.showMessage('无法上架');\n    return false;\n  }\n\n  unstockShelf(shelfId: string, quantity: number, productManager: ProductManager): boolean {\n    const productId = productManager.unstockShelf(shelfId, quantity);\n    if (productId) {\n      this.showMessage(`已下架 ${quantity} 个商品`);\n      return true;\n    }\n    this.showMessage('无法下架');\n    return false;\n  }\n\n  close(): void {\n    this.currentShelfId = null;\n    this.currentAction = ShelfAction.NONE;\n    this.selectedProductIndex = 0;\n  }\n\n  showMessage(text: string): void {\n    this.message = text;\n    this.messageTimer = 2;\n  }\n\n  update(dt: number): void {\n    if (this.messageTimer > 0) {\n      this.messageTimer -= dt / 1000;\n      if (this.messageTimer <= 0) {\n        this.message = null;\n      }\n    }\n  }\n\n  getAvailableProductsForShelf(\n    shelfId: string,\n    productManager: ProductManager,\n  ): { id: string; name: string; quantity: number }[] {\n    const interactable = productManager.shelfSlots.get(shelfId);\n    if (!interactable) return [];\n\n    const shelfType = shelfId.startsWith('fridge') ? 'fridge' : 'shelf';\n    const result: { id: string; name: string; quantity: number }[] = [];\n\n    for (const [productId, item] of productManager.inventory) {\n      const product = productManager.getProduct(productId);\n      if (!product) continue;\n      const category = productManager.getCategory(productId);\n      if (!category) continue;\n\n      // Match shelf type to product category\n      const isMatch = (shelfType === 'fridge' && category.shelfType === 'fridge') ||\n        (shelfType === 'shelf' && category.shelfType === 'shelf');\n\n      if (isMatch && item.quantity > 0) {\n        result.push({ id: productId, name: product.name, quantity: item.quantity });\n      }\n    }\n    return result;\n  }\n\n  isActive(): boolean {\n    return this.currentAction !== ShelfAction.NONE;\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"e4781836-91b7-498e-bc35-c2b84a36028a","uuid":"5a1f53c9-4e82-43f5-978a-98a851aa9204"}
