{"type":"assistant","message":{"id":"msg_20260523120150fa3dcca735244c55","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_da6d632d060648019da622dd","name":"Write","input":{"file_path":"D:\\game-projects\\steam-horror-sim\\src\\game\\Customer.ts","content":"// Customer.ts — Individual customer entity with behavior AI (M2)\n\nexport enum CustomerType {\n  COMMUTER = 'commuter',\n  LUNCH = 'lunch',\n  STUDENT = 'student',\n  RESIDENT = 'resident',\n  NIGHT = 'night',\n}\n\nexport enum CustomerState {\n  ENTERING = 'entering',\n  WALKING_TO_SHELF = 'walking_to_shelf',\n  BROWSING = 'browsing',\n  PICKING = 'picking',\n  WALKING_TO_REGISTER = 'walking_to_register',\n  WAITING_IN_LINE = 'waiting_in_line',\n  CHECKING_OUT = 'checking_out',\n  WALKING_TO_EXIT = 'walking_to_exit',\n  LEAVING = 'leaving',\n  FLED = 'fled',\n}\n\nexport interface CartItem {\n  productId: string;\n  price: number;\n}\n\nexport interface CustomerDef {\n  type: CustomerType;\n  name: string;\n  speed: number;\n  patience: number;\n  budget: number;\n  priceSensitivity: number;\n  preferredCategories: string[];\n  itemsToBuy: number;\n  stealChance: number;\n  appearance: { bodyColor: string; headColor: string; accessory?: string };\n}\n\nconst CUSTOMER_DEFS: Record<CustomerType, CustomerDef> = {\n  [CustomerType.COMMUTER]: {\n    type: CustomerType.COMMUTER,\n    name: '上班族',\n    speed: 90,\n    patience: 30,\n    budget: 15,\n    priceSensitivity: 0.3,\n    preferredCategories: ['beverage', 'snack'],\n    itemsToBuy: 2,\n    stealChance: 0,\n    appearance: { bodyColor: '#445566', headColor: '#f0d8c0', accessory: 'tie' },\n  },\n  [CustomerType.LUNCH]: {\n    type: CustomerType.LUNCH,\n    name: '白领',\n    speed: 70,\n    patience: 45,\n    budget: 25,\n    priceSensitivity: 0.2,\n    preferredCategories: ['bento', 'beverage'],\n    itemsToBuy: 2,\n    stealChance: 0,\n    appearance: { bodyColor: '#664455', headColor: '#f0d8c0' },\n  },\n  [CustomerType.STUDENT]: {\n    type: CustomerType.STUDENT,\n    name: '学生',\n    speed: 80,\n    patience: 40,\n    budget: 10,\n    priceSensitivity: 0.7,\n    preferredCategories: ['snack', 'beverage'],\n    itemsToBuy: 3,\n    stealChance: 0.05,\n    appearance: { bodyColor: '#556644', headColor: '#f0d8c0', accessory: 'cap' },\n  },\n  [CustomerType.RESIDENT]: {\n    type: CustomerType.RESIDENT,\n    name: '居民',\n    speed: 55,\n    patience: 60,\n    budget: 30,\n    priceSensitivity: 0.5,\n    preferredCategories: ['daily', 'beverage', 'snack'],\n    itemsToBuy: 2,\n    stealChance: 0,\n    appearance: { bodyColor: '#665544', headColor: '#f0d8c0' },\n  },\n  [CustomerType.NIGHT]: {\n    type: CustomerType.NIGHT,\n    name: '深夜顾客',\n    speed: 40,\n    patience: 90,\n    budget: 50,\n    priceSensitivity: 0.1,\n    preferredCategories: ['beverage', 'snack', 'special'],\n    itemsToBuy: 1,\n    stealChance: 0,\n    appearance: { bodyColor: '#222233', headColor: '#888899' },\n  },\n};\n\n// Waypoints in tile coordinates for navigation\nconst ENTRY_TILE = { gx: 14, gy: 1 };\nconst REGISTER_TILES = [{ gx: 19, gy: 3 }, { gx: 21, gy: 3 }];\nconst SHELF_TILES: Record<string, { gx: number; gy: number }[]> = {\n  shelf_1: [{ gx: 3, gy: 4 }, { gx: 4, gy: 4 }, { gx: 5, gy: 4 }],\n  shelf_2: [{ gx: 7, gy: 4 }, { gx: 8, gy: 4 }, { gx: 9, gy: 4 }],\n  shelf_3: [{ gx: 11, gy: 4 }, { gx: 12, gy: 4 }, { gx: 13, gy: 4 }],\n  shelf_4: [{ gx: 17, gy: 4 }, { gx: 18, gy: 4 }, { gx: 19, gy: 4 }],\n  shelf_5: [{ gx: 21, gy: 4 }, { gx: 22, gy: 4 }, { gx: 23, gy: 4 }],\n  fridge_1: [{ gx: 3, gy: 8 }, { gx: 4, gy: 8 }, { gx: 5, gy: 8 }],\n  fridge_2: [{ gx: 7, gy: 8 }, { gx: 8, gy: 8 }, { gx: 9, gy: 8 }],\n};\nconst EXIT_TILE = { gx: 14, gy: 1 };\n\nconst TILE_SIZE = 32;\n\nexport class Customer {\n  id: string;\n  type: CustomerType;\n  def: CustomerDef;\n  state: CustomerState = CustomerState.ENTERING;\n  x: number;\n  y: number;\n  direction: 'up' | 'down' | 'left' | 'right' = 'down';\n  cart: CartItem[] = [];\n  totalSpent: number = 0;\n  patienceTimer: number;\n  browseTimer: number = 0;\n  targetShelfId: string | null = null;\n  registerIndex: number = 0;\n\n  private waypoints: { x: number; y: number }[] = [];\n  private waypointIndex = 0;\n  private animFrame = 0;\n  private animTimer = 0;\n\n  constructor(id: string, type: CustomerType) {\n    this.id = id;\n    this.type = type;\n    this.def = { ...CUSTOMER_DEFS[type] };\n    this.x = ENTRY_TILE.gx * TILE_SIZE;\n    this.y = ENTRY_TILE.gy * TILE_SIZE;\n    this.patienceTimer = this.def.patience;\n  }\n\n  update(dt: number, availableShelves: Map<string, string[]>, registerLineSize: number): void {\n    const dtSec = dt / 1000;\n    this.patienceTimer -= dtSec;\n    this.animTimer += dt;\n\n    if (this.animTimer > 200) {\n      this.animTimer = 0;\n      this.animFrame = (this.animFrame + 1) % 4;\n    }\n\n    if (this.patienceTimer <= 0 && this.state !== CustomerState.CHECKING_OUT) {\n      this.state = CustomerState.FLED;\n      return;\n    }\n\n    switch (this.state) {\n      case CustomerState.ENTERING:\n        this.moveToWaypoint(dtSec);\n        if (this.reachedWaypoint()) {\n          this.decideWhatToBuy(availableShelves);\n        }\n        break;\n\n      case CustomerState.WALKING_TO_SHELF:\n        this.moveToWaypoint(dtSec);\n        if (this.reachedWaypoint()) {\n          this.state = CustomerState.BROWSING;\n          this.browseTimer = 2 + Math.random() * 3;\n        }\n        break;\n\n      case CustomerState.BROWSING:\n        this.browseTimer -= dtSec;\n        if (this.browseTimer <= 0) {\n          this.state = CustomerState.PICKING;\n        }\n        break;\n\n      case CustomerState.PICKING:\n        this.pickItem(availableShelves);\n        if (this.cart.length >= this.def.itemsToBuy || !this.hasMoreShelvesToVisit(availableShelves)) {\n          this.goToRegister(registerLineSize);\n        } else {\n          this.decideWhatToBuy(availableShelves);\n        }\n        break;\n\n      case CustomerState.WALKING_TO_REGISTER:\n        this.moveToWaypoint(dtSec);\n        if (this.reachedWaypoint()) {\n          this.state = CustomerState.WAITING_IN_LINE;\n        }\n        break;\n\n      case CustomerState.WAITING_IN_LINE:\n        // Waiting for player to initiate checkout\n        break;\n\n      case CustomerState.CHECKING_OUT:\n        // Handled by CashRegister\n        break;\n\n      case CustomerState.WALKING_TO_EXIT:\n        this.moveToWaypoint(dtSec);\n        if (this.reachedWaypoint()) {\n          this.state = CustomerState.LEAVING;\n        }\n        break;\n    }\n  }\n\n  private decideWhatToBuy(availableShelves: Map<string, string[]>): void {\n    // Pick a random shelf that has products in preferred categories\n    const candidates: string[] = [];\n    for (const [shelfId, productIds] of availableShelves) {\n      for (const pid of productIds) {\n        // Check if product is in preferred categories (simplified: check by shelf type)\n        candidates.push(shelfId);\n        break;\n      }\n    }\n\n    if (candidates.length === 0) {\n      this.goToRegister(0);\n      return;\n    }\n\n    this.targetShelfId = candidates[Math.floor(Math.random() * candidates.length)];\n    const tileGroup = SHELF_TILES[this.targetShelfId];\n    if (tileGroup) {\n      const tile = tileGroup[Math.floor(Math.random() * tileGroup.length)];\n      this.setWaypoints([{ x: tile.gx * TILE_SIZE, y: tile.gy * TILE_SIZE }]);\n      this.state = CustomerState.WALKING_TO_SHELF;\n    } else {\n      this.goToRegister(0);\n    }\n  }\n\n  private pickItem(availableShelves: Map<string, string[]>): void {\n    if (!this.targetShelfId) return;\n    const products = availableShelves.get(this.targetShelfId);\n    if (!products || products.length === 0) return;\n\n    const productId = products[Math.floor(Math.random() * products.length)];\n    this.cart.push({ productId, price: 0 }); // price set at checkout\n  }\n\n  private hasMoreShelvesToVisit(availableShelves: Map<string, string[]>): boolean {\n    return this.cart.length < this.def.itemsToBuy && availableShelves.size > 0;\n  }\n\n  goToRegister(lineSize: number): void {\n    this.registerIndex = Math.min(lineSize, REGISTER_TILES.length - 1);\n    const tile = REGISTER_TILES[this.registerIndex];\n    const offsetY = Math.min(lineSize, 3) * TILE_SIZE;\n    this.setWaypoints([{ x: tile.gx * TILE_SIZE, y: tile.gy * TILE_SIZE + offsetY }]);\n    this.state = CustomerState.WALKING_TO_REGISTER;\n  }\n\n  startCheckout(): void {\n    this.state = CustomerState.CHECKING_OUT;\n  }\n\n  finishCheckout(): void {\n    this.setWaypoints([{ x: EXIT_TILE.gx * TILE_SIZE, y: EXIT_TILE.gy * TILE_SIZE }]);\n    this.state = CustomerState.WALKING_TO_EXIT;\n  }\n\n  isDone(): boolean {\n    return this.state === CustomerState.LEAVING || this.state === CustomerState.FLED;\n  }\n\n  isStealing(): boolean {\n    return this.def.stealChance > 0 && Math.random() < this.def.stealChance;\n  }\n\n  // Navigation\n  private setWaypoints(points: { x: number; y: number }[]): void {\n    this.waypoints = points;\n    this.waypointIndex = 0;\n  }\n\n  private moveToWaypoint(dtSec: number): void {\n    if (this.waypointIndex >= this.waypoints.length) return;\n\n    const target = this.waypoints[this.waypointIndex];\n    const dx = target.x - this.x;\n    const dy = target.y - this.y;\n    const dist = Math.sqrt(dx * dx + dy * dy);\n\n    if (dist < 4) {\n      this.x = target.x;\n      this.y = target.y;\n      this.waypointIndex++;\n      return;\n    }\n\n    const moveAmt = this.def.speed * dtSec;\n    const ratio = Math.min(moveAmt / dist, 1);\n    const mx = dx * ratio;\n    const my = dy * ratio;\n\n    this.x += mx;\n    this.y += my;\n\n    if (Math.abs(dx) > Math.abs(dy)) {\n      this.direction = dx > 0 ? 'right' : 'left';\n    } else {\n      this.direction = dy > 0 ? 'down' : 'up';\n    }\n  }\n\n  private reachedWaypoint(): boolean {\n    return this.waypointIndex >= this.waypoints.length;\n  }\n\n  render(ctx: CanvasRenderingContext2D, offsetX: number, offsetY: number, scale: number): void {\n    const px = offsetX + this.x * scale;\n    const py = offsetY + this.y * scale;\n    const s = 16 * scale;\n\n    // Body\n    ctx.fillStyle = this.def.appearance.bodyColor;\n    ctx.fillRect(px, py + s * 0.3, s, s * 0.7);\n\n    // Head\n    ctx.fillStyle = this.def.appearance.headColor;\n    ctx.fillRect(px + s * 0.15, py, s * 0.7, s * 0.45);\n\n    // Accessory\n    if (this.def.appearance.accessory === 'tie') {\n      ctx.fillStyle = '#cc3333';\n      ctx.fillRect(px + s * 0.45, py + s * 0.4, s * 0.1, s * 0.3);\n    } else if (this.def.appearance.accessory === 'cap') {\n      ctx.fillStyle = '#4488cc';\n      ctx.fillRect(px + s * 0.05, py - s * 0.05, s * 0.9, s * 0.2);\n    }\n\n    // Walking animation for legs\n    if (this.state === CustomerState.WALKING_TO_SHELF ||\n        this.state === CustomerState.WALKING_TO_REGISTER ||\n        this.state === CustomerState.WALKING_TO_EXIT ||\n        this.state === CustomerState.ENTERING) {\n      const bob = Math.sin(this.animFrame * Math.PI / 2) * s * 0.05;\n      ctx.fillStyle = '#4a4a5a';\n      ctx.fillRect(px + s * 0.2, py + s * 0.85 + bob, s * 0.25, s * 0.15);\n      ctx.fillRect(px + s * 0.55, py + s * 0.85 - bob, s * 0.25, s * 0.15);\n    }\n\n    // Patience indicator (low patience = red)\n    if (this.patienceTimer < this.def.patience * 0.3 && this.state !== CustomerState.CHECKING_OUT) {\n      ctx.fillStyle = `rgba(255, 50, 50, ${0.5 + Math.sin(Date.now() * 0.01) * 0.3})`;\n      ctx.font = `${Math.round(8 * scale)}px monospace`;\n      ctx.textAlign = 'center';\n      ctx.fillText('!', px + s / 2, py - 6 * scale);\n    }\n\n    // Cart count indicator\n    if (this.cart.length > 0) {\n      ctx.fillStyle = 'rgba(100,200,100,0.8)';\n      ctx.font = `${Math.round(7 * scale)}px monospace`;\n      ctx.textAlign = 'center';\n      ctx.fillText(`${this.cart.length}`, px + s / 2, py - 2 * scale);\n    }\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"e4781836-91b7-498e-bc35-c2b84a36028a","uuid":"116c725b-52ea-4504-b3f2-66c5fcd1e5da"}
