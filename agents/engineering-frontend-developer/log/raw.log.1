{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f919ebc4060d412da8c5387b","type":"tool_result","content":"The file D:\\game-projects\\steam-cultivation-factory\\src\\game\\ConveyorBelt.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"c0e01ba0-5708-46af-9590-e43af2395006","uuid":"aa13dfe3-0b2c-4986-b703-ac6566826a2c","timestamp":"2026-05-23T01:46:35.000Z","tool_use_result":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\ConveyorBelt.ts","oldString":"    if (seg.nextX !== null && seg.nextY !== null) {\n      tx = item.x + (seg.nextX - item.x) * item.progress;\n      ty = item.y + (seg.nextY - item.y) * item.progress;\n    }","newString":"    if (seg.nextX !== null && seg.nextY !== null) {\n      tx = item.x + (seg.nextX - item.x) * item.progress;\n      ty = item.y + ((seg.nextY as number) - item.y) * item.progress;\n    }","originalFile":"// ConveyorBelt.ts — 灵脉通道（传送带）系统，支持 Lv1 直线 / Lv2 转弯分叉\n\nexport interface ConveyorSegment {\n  uid: string;\n  gridX: number;\n  gridY: number;\n  level: 1 | 2; // Lv1 直线, Lv2 转弯分叉\n  direction: Direction;\n  /** 连接到的下一格坐标（null = 未连接） */\n  nextX: number | null;\n  nextY: number | null;\n  /** 分叉出口（仅 Lv2） */\n  branchX: number | null;\n  branchY: number | null;\n}\n\nexport type Direction = 'up' | 'down' | 'left' | 'right';\n\nexport interface ConveyorItem {\n  id: string;\n  resource: string;\n  amount: number;\n  /** 当前所在格 x */\n  x: number;\n  /** 当前所在格 y */\n  y: number;\n  /** 移动进度 0-1 */\n  progress: number;\n  /** 每格移动时间 ms */\n  speed: number;\n  /** 目标建筑 uid（终点） */\n  targetBuildingUid: string | null;\n}\n\nlet itemCounter = 0;\n\nconst DIR_DELTA: Record<Direction, { dx: number; dy: number }> = {\n  up: { dx: 0, dy: -1 },\n  down: { dx: 0, dy: 1 },\n  left: { dx: -1, dy: 0 },\n  right: { dx: 1, dy: 0 },\n};\n\nconst OPPOSITE: Record<Direction, Direction> = {\n  up: 'down',\n  down: 'up',\n  left: 'right',\n  right: 'left',\n};\n\nexport function getDirDelta(dir: Direction): { dx: number; dy: number } {\n  return DIR_DELTA[dir];\n}\n\nexport function oppositeDir(dir: Direction): Direction {\n  return OPPOSITE[dir];\n}\n\nexport function directionFromDelta(dx: number, dy: number): Direction {\n  if (Math.abs(dx) > Math.abs(dy)) return dx > 0 ? 'right' : 'left';\n  return dy > 0 ? 'down' : 'up';\n}\n\n// Create a conveyor segment\nexport function createSegment(\n  uid: string,\n  gridX: number,\n  gridY: number,\n  level: 1 | 2,\n  direction: Direction,\n): ConveyorSegment {\n  return {\n    uid,\n    gridX,\n    gridY,\n    level,\n    direction,\n    nextX: null,\n    nextY: null,\n    branchX: null,\n    branchY: null,\n  };\n}\n\n// Build a lookup map from grid position to segment\nexport function buildSegmentMap(segments: ConveyorSegment[]): Map<string, ConveyorSegment> {\n  const map = new Map<string, ConveyorSegment>();\n  for (const seg of segments) {\n    map.set(`${seg.gridX},${seg.gridY}`, seg);\n  }\n  return map;\n}\n\n// Auto-connect a segment to its neighbors\nexport function autoConnect(\n  segment: ConveyorSegment,\n  segmentMap: Map<string, ConveyorSegment>,\n): ConveyorSegment {\n  const updated = { ...segment };\n\n  // Look ahead in current direction\n  const { dx, dy } = getDirDelta(segment.direction);\n  const aheadKey = `${segment.gridX + dx},${segment.gridY + dy}`;\n  const ahead = segmentMap.get(aheadKey);\n  if (ahead && ahead.direction !== oppositeDir(segment.direction)) {\n    updated.nextX = segment.gridX + dx;\n    updated.nextY = segment.gridY + dy;\n  } else {\n    updated.nextX = null;\n    updated.nextY = null;\n  }\n\n  // Lv2: branch detection — check perpendicular directions\n  if (segment.level >= 2) {\n    const perpDirs: Direction[] =\n      segment.direction === 'up' || segment.direction === 'down'\n        ? ['left', 'right']\n        : ['up', 'down'];\n\n    for (const pd of perpDirs) {\n      const pdx = getDirDelta(pd).dx;\n      const pdy = getDirDelta(pd).dy;\n      const branchKey = `${segment.gridX + pdx},${segment.gridY + pdy}`;\n      const branch = segmentMap.get(branchKey);\n      if (branch && branch.direction !== oppositeDir(pd)) {\n        updated.branchX = segment.gridX + pdx;\n        updated.branchY = segment.gridY + pdy;\n        break; // Only one branch\n      }\n    }\n  }\n\n  return updated;\n}\n\n// Spawn a new item on the conveyor\nexport function spawnItem(\n  resource: string,\n  amount: number,\n  startX: number,\n  startY: number,\n  speed: number = 2000,\n): ConveyorItem {\n  return {\n    id: `item_${Date.now()}_${++itemCounter}`,\n    resource,\n    amount,\n    x: startX,\n    y: startY,\n    progress: 0,\n    speed,\n    targetBuildingUid: null,\n  };\n}\n\n// Tick all conveyor items — move them along segments\nexport function tickConveyorItems(\n  items: ConveyorItem[],\n  segmentMap: Map<string, ConveyorSegment>,\n  dtMs: number,\n): { items: ConveyorItem[]; delivered: Array<{ resource: string; amount: number; x: number; y: number }> } {\n  const delivered: Array<{ resource: string; amount: number; x: number; y: number }> = [];\n  const remaining: ConveyorItem[] = [];\n\n  for (const item of items) {\n    const seg = segmentMap.get(`${item.x},${item.y}`);\n    if (!seg) {\n      remaining.push(item);\n      continue;\n    }\n\n    const progress = item.progress + dtMs / item.speed;\n\n    if (progress >= 1) {\n      // Item arrived at next cell\n      if (seg.nextX !== null && seg.nextY !== null) {\n        remaining.push({\n          ...item,\n          x: seg.nextX,\n          y: seg.nextY,\n          progress: progress - 1,\n        });\n      } else {\n        // End of line — deliver\n        delivered.push({\n          resource: item.resource,\n          amount: item.amount,\n          x: item.x,\n          y: item.y,\n        });\n      }\n    } else {\n      remaining.push({ ...item, progress });\n    }\n  }\n\n  return { items: remaining, delivered };\n}\n\n// Render a conveyor segment on canvas\nexport function renderConveyorSegment(\n  ctx: CanvasRenderingContext2D,\n  seg: ConveyorSegment,\n  offsetX: number,\n  offsetY: number,\n  scale: number,\n  cellSize: number,\n  now: number,\n): void {\n  const x = offsetX + seg.gridX * cellSize * scale;\n  const y = offsetY + seg.gridY * cellSize * scale;\n  const s = cellSize * scale;\n\n  // Belt background\n  const baseColor = seg.level === 1 ? 'rgba(100,150,200,0.4)' : 'rgba(150,120,220,0.4)';\n  ctx.fillStyle = baseColor;\n  ctx.fillRect(x + 1, y + 1, s - 2, s - 2);\n\n  // Direction arrow with animation\n  const arrowPhase = ((now / 500) % 1);\n  const { dx, dy } = getDirDelta(seg.direction);\n  const cx = x + s / 2 + dx * s * 0.15 * arrowPhase;\n  const cy = y + s / 2 + dy * s * 0.15 * arrowPhase;\n\n  ctx.fillStyle = seg.level === 1 ? '#6496c8' : '#9678dc';\n  ctx.font = `${Math.max(10, Math.floor(14 * scale))}px serif`;\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n\n  const arrows: Record<Direction, string> = { up: '↑', down: '↓', left: '←', right: '→' };\n  ctx.fillText(arrows[seg.direction], cx, cy);\n\n  // Branch indicator for Lv2\n  if (seg.level >= 2 && seg.branchX !== null) {\n    ctx.fillStyle = 'rgba(180,160,255,0.5)';\n    ctx.beginPath();\n    ctx.arc(x + s - 4 * scale, y + s - 4 * scale, 2 * scale, 0, Math.PI * 2);\n    ctx.fill();\n  }\n\n  // Connection indicators\n  ctx.strokeStyle = 'rgba(150,200,255,0.3)';\n  ctx.lineWidth = 1;\n  if (seg.nextX !== null) {\n    const nx = offsetX + seg.nextX * cellSize * scale;\n    const ny = offsetY + seg.nextY * cellSize * scale;\n    ctx.beginPath();\n    ctx.moveTo(x + s / 2, y + s / 2);\n    ctx.lineTo(nx + s / 2, ny + s / 2);\n    ctx.stroke();\n  }\n}\n\n// Render items moving on conveyors\nexport function renderConveyorItems(\n  ctx: CanvasRenderingContext2D,\n  items: ConveyorItem[],\n  segmentMap: Map<string, ConveyorSegment>,\n  offsetX: number,\n  offsetY: number,\n  scale: number,\n  cellSize: number,\n): void {\n  const RESOURCE_COLORS: Record<string, string> = {\n    spirit_stone: '#7cc8ff',\n    spirit_grass: '#6adf6a',\n    spirit_iron: '#8a8aaa',\n    pill_juling: '#ff8c32',\n    pill_peiyuan: '#ff6699',\n    pill_zhuji: '#ffcc00',\n    pill_jindanyin: '#ff4444',\n  };\n\n  for (const item of items) {\n    const seg = segmentMap.get(`${item.x},${item.y}`);\n    if (!seg) continue;\n\n    let tx = item.x;\n    let ty = item.y;\n\n    if (seg.nextX !== null && seg.nextY !== null) {\n      tx = item.x + (seg.nextX - item.x) * item.progress;\n      ty = item.y + (seg.nextY - item.y) * item.progress;\n    }\n\n    const sx = offsetX + (tx + 0.5) * cellSize * scale;\n    const sy = offsetY + (ty + 0.5) * cellSize * scale;\n    const r = 4 * scale;\n\n    ctx.fillStyle = RESOURCE_COLORS[item.resource] ?? '#fff';\n    ctx.beginPath();\n    ctx.arc(sx, sy, r, 0, Math.PI * 2);\n    ctx.fill();\n\n    // Glow\n    ctx.fillStyle = (RESOURCE_COLORS[item.resource] ?? '#fff').replace(')', ',0.3)').replace('rgb', 'rgba');\n    ctx.beginPath();\n    ctx.arc(sx, sy, r * 1.5, 0, Math.PI * 2);\n    ctx.fill();\n  }\n}\n","structuredPatch":[{"oldStart":280,"oldLines":7,"newStart":280,"newLines":7,"lines":[" ","     if (seg.nextX !== null && seg.nextY !== null) {","       tx = item.x + (seg.nextX - item.x) * item.progress;","-      ty = item.y + (seg.nextY - item.y) * item.progress;","+      ty = item.y + ((seg.nextY as number) - item.y) * item.progress;","     }"," ","     const sx = offsetX + (tx + 0.5) * cellSize * scale;"]}],"userModified":false,"replaceAll":false}}
