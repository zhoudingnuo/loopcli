rrentAction = ShelfAction.VIEW;\n    } else {\n      this.currentAction = ShelfAction.STOCK;\n    }\n\n    return {\n      shelfId,\n      label: interactable.label,\n      productId: slot.productId,\n      productName: product?.name ?? null,\n      quantity: slot.quantity,\n      maxQuantity: slot.maxQuantity,\n      category: category?.name ?? null,\n    };\n  }\n\n  stockShelf(shelfId: string, productId: string, quantity: number, productManager: ProductManager): boolean {\n    const stocked = productManager.stockShelf(shelfId, productId, quantity);\n    if (stocked > 0) {\n      this.showMessage(`上架 ${stocked} 个商品`);\n      return true;\n    }\n    this.showMessage('无法上架');\n    return false;\n  }\n\n  unstockShelf(shelfId: string, quantity: number, productManager: ProductManager): boolean {\n    const productId = productManager.unstockShelf(shelfId, quantity);\n    if (productId) {\n      this.showMessage(`已下架 ${quantity} 个商品`);\n      return true;\n    }\n    this.showMessage('无法下架');\n    return false;\n  }\n\n  close(): void {\n    this.currentShelfId = null;\n    this.currentAction = ShelfAction.NONE;\n    this.selectedProductIndex = 0;\n  }\n\n  showMessage(text: string): void {\n    this.message = text;\n    this.messageTimer = 2;\n  }\n\n  update(dt: number): void {\n    if (this.messageTimer > 0) {\n      this.messageTimer -= dt / 1000;\n      if (this.messageTimer <= 0) {\n        this.message = null;\n      }\n    }\n  }\n\n  getAvailableProductsForShelf(\n    shelfId: string,\n    productManager: ProductManager,\n  ): { id: string; name: string; quantity: number }[] {\n    const interactable = productManager.shelfSlots.get(shelfId);\n    if (!interactable) return [];\n\n    const shelfType = shelfId.startsWith('fridge') ? 'fridge' : 'shelf';\n    const result: { id: string; name: string; quantity: number }[] = [];\n\n    for (const [productId, item] of productManager.inventory) {\n      const product = productManager.getProduct(productId);\n      if (!product) continue;\n      const category = productManager.getCategory(productId);\n      if (!category) continue;\n\n      // Match shelf type to product category\n      const isMatch = (shelfType === 'fridge' && category.shelfType === 'fridge') ||\n        (shelfType === 'shelf' && category.shelfType === 'shelf');\n\n      if (isMatch && item.quantity > 0) {\n        result.push({ id: productId, name: product.name, quantity: item.quantity });\n      }\n    }\n    return result;\n  }\n\n  isActive(): boolean {\n    return this.currentAction !== ShelfAction.NONE;\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
