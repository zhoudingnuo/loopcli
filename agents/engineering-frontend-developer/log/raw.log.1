:[\"弦\",\"外\",\"之\",\"音\"],pinyin:\"xián wài zhī yīn\",meaning:\"比喻言外之意即话里间接透露而不是明说的意思\",difficulty:4,category:[\"常用\"],frequency:23},\n{id:\"s088\",idiom:\"旁敲侧击\",chars:[\"旁\",\"敲\",\"侧\",\"击\"],pinyin:\"páng qiāo cè jī\",meaning:\"比喻说话不从正面直接说明而从侧面暗中点拨\",difficulty:4,category:[\"常用\"],frequency:22},\n{id:\"s089\",idiom:\"含沙射影\",chars:[\"含\",\"沙\",\"射\",\"影\"],pinyin:\"hán shā shè yǐng\",meaning:\"比喻暗中诽谤攻击别人\",difficulty:4,category:[\"自然\"],frequency:21},\n{id:\"s090\",idiom:\"拐弯抹角\",chars:[\"拐\",\"弯\",\"抹\",\"角\"],pinyin:\"guǎi wān mò jiǎo\",meaning:\"说话不直截了当\",difficulty:4,category:[\"常用\"],frequency:20},\n{id:\"s091\",idiom:\"直言不讳\",chars:[\"直\",\"言\",\"不\",\"讳\"],pinyin:\"zhí yán bù huì\",meaning:\"直截了当地说出来没有丝毫顾忌\",difficulty:4,category:[\"常用\"],frequency:19},\n{id:\"s092\",idiom:\"开门见山\",chars:[\"开\",\"门\",\"见\",\"山\"],pinyin:\"kāi mén jiàn shān\",meaning:\"比喻说话或写文章直截了当\",difficulty:4,category:[\"自然\"],frequency:18},\n{id:\"s093\",idiom:\"单刀直入\",chars:[\"单\",\"刀\",\"直\",\"入\"],pinyin:\"dān dāo zhí rù\",meaning:\"比喻说话直截了当不绕弯子\",difficulty:4,category:[\"常用\"],frequency:17},\n{id:\"s094\",idiom:\"一针见血\",chars:[\"一\",\"针\",\"见\",\"血\"],pinyin:\"yī zhēn jiàn xiě\",meaning:\"比喻说话直截了当切中要害\",difficulty:4,category:[\"数字\"],frequency:16},\n{id:\"s095\",idiom:\"一语破的\",chars:[\"一\",\"语\",\"破\",\"的\"],pinyin:\"yī yǔ pò dì\",meaning:\"一句话就说中要害\",difficulty:4,category:[\"数字\"],frequency:15},\n{id:\"s096\",idiom:\"切中要害\",chars:[\"切\",\"中\",\"要\",\"害\"],pinyin:\"qiè zhòng yào hài\",meaning:\"形容言论或做事正好击中事物的关键\",difficulty:4,category:[\"常用\"],frequency:14},\n{id:\"s097\",idiom:\"提纲挈领\",chars:[\"提\",\"纲\",\"挈\",\"领\"],pinyin:\"tí gāng qiè lǐng\",meaning:\"比喻抓住要领简明扼要\",difficulty:4,category:[\"常用\"],frequency:13},\n{id:\"s098\",idiom:\"纲举目张\",chars:[\"纲\",\"举\",\"目\",\"张\"],pinyin:\"gāng jǔ mù zhāng\",meaning:\"比喻抓住事物的关键带动其他环节\",difficulty:4,category:[\"常用\"],frequency:12},\n{id:\"s099\",idiom:\"画龙点睛\",chars:[\"画\",\"龙\",\"点\",\"睛\"],pinyin:\"huà lóng diǎn jīng\",meaning:\"比喻在关键处加上