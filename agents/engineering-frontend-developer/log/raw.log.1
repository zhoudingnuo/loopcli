{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_add3cace2eaf408498074e2a","type":"tool_result","content":"1\t// 游戏主控制器\n2\tclass Game {\n3\t  constructor() {\n4\t    this.currentLevel = 1;\n5\t    this.lives = 5;\n6\t    this.score = 0;\n7\t    this.correctCount = 0;\n8\t    this.questionCount = 0;\n9\t    this.currentQuestion = null;\n10\t    this.usedCandidates = [];\n11\t\n12\t    this.idiomEngine = new IdiomEngine(IDIOMS_DB);\n13\t    this.judge = new Judge();\n14\t    this.combo = new Combo();\n15\t    this.audio = new AudioManager();\n16\t\n17\t    this.combo.onComboChange = (count, text) => {\n18\t      const comboDisplay = document.getElementById('combo-display');\n19\t      if (comboDisplay) {\n20\t        comboDisplay.textContent = text;\n21\t        comboDisplay.style.display = text ? 'block' : 'none';\n22\t      }\n23\t    };\n24\t\n25\t    this.audio.init();\n26\t  }\n27\t\n28\t  showScreen(screenId) {\n29\t    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));\n30\t    document.getElementById(screenId).classList.add('active');\n31\t  }\n32\t\n33\t  startLevel(levelNum) {\n34\t    this.currentLevel = levelNum;\n35\t    const levelConfig = LEVELS.find(l => l.id === levelNum) || LEVELS[0];\n36\t\n37\t    this.lives = levelConfig.lives;\n38\t    this.score = 0;\n39\t    this.correctCount = 0;\n40\t    this.questionCount = 0;\n41\t    this.idiomEngine.reset();\n42\t    this.combo.reset();\n43\t\n44\t    this.updateUI();\n45\t    this.showScreen('game-screen');\n46\t    this.nextQuestion();\n47\t  }\n48\t\n49\t  nextQuestion() {\n50\t    const levelConfig = LEVELS.find(l => l.id === this.currentLevel) || LEVELS[0];\n51\t\n52\t    if (this.questionCount >= levelConfig.questions) {\n53\t      this.completeLevel();\n54\t      return;\n55\t    }\n56\t\n57\t    this.currentQuestion = this.idiomEngine.generateQuestion(levelConfig);\n58\t    this.judge.reset();\n59\t    this.usedCandidates = [];\n60\t\n61\t    t