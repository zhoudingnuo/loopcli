ng huì guàn tōng\",meaning:\"把各方面的知识和道理融合贯穿在一起\",difficulty:3,category:[\"常用\"],frequency:22},\n{id:\"h059\",idiom:\"举一反三\",chars:[\"触\",\"类\",\"旁\",\"通\"],pinyin:\"chù lèi páng tōng\",meaning:\"掌握了某一事物的知识或规律就能推知同类的事物\",difficulty:3,category:[\"常用\"],frequency:21},\n{id:\"h060\",idiom:\"妙不可言\",chars:[\"妙\",\"不\",\"可\",\"言\"],pinyin:\"miào bù kě yán\",meaning:\"形容好得难以用文字语言表达\",difficulty:3,category:[\"常用\"],frequency:20},\n{id:\"h061\",idiom:\"脍炙人口\",chars:[\"脍\",\"炙\",\"人\",\"口\"],pinyin:\"kuài zhì rén kǒu\",meaning:\"比喻好的诗文受到人们的称赞和传颂\",difficulty:3,category:[\"人物\"],frequency:19},\n{id:\"h062\",idiom:\"珠联璧合\",chars:[\"珠\",\"联\",\"璧\",\"合\"],pinyin:\"zhū lián bì hé\",meaning:\"珍珠联串在一起美玉结合在一块比喻杰出的人才或美好的事物结合在一起\",difficulty:3,category:[\"自然\"],frequency:18},\n{id:\"h063\",idiom:\"美轮美奂\",chars:[\"美\",\"轮\",\"美\",\"奂\"],pinyin:\"měi lún měi huàn\",meaning:\"形容房屋高大华丽\",difficulty:3,category:[\"常用\"],frequency:17},\n{id:\"h064\",idiom:\"空前绝后\",chars:[\"空\",\"前\",\"绝\",\"后\"],pinyin:\"kōng qián jué hòu\",meaning:\"从前没有过今后也不会有\",difficulty:3,category:[\"常用\"],frequency:16},\n{id:\"h065\",idiom:\"登峰造极\",chars:[\"登\",\"峰\",\"造\",\"极\"],pinyin:\"dēng fēng zào jí\",meaning:\"到达最高点比喻达到极高的水平\",difficulty:3,category:[\"自然\"],frequency:15},\n{id:\"h066\",idiom:\"叹为观止\",chars:[\"叹\",\"为\",\"观\",\"止\"],pinyin:\"tàn wéi guān zhǐ\",meaning:\"赞美看到的事物好到了极点\",difficulty:3,category:[\"常用\"],frequency:14},\n{id:\"h067\",idiom:\"出类拔萃\",chars:[\"出\",\"类\",\"拔\",\"萃\"],pinyin:\"chū lèi bá cuì\",meaning:\"超出同类之上多指人的品德才能\",difficulty:3,category:[\"人物\"],frequency:13},\n{id:\"h068\",idiom:\"鹤立鸡群\",chars:[\"卓\",\"尔\",\"不\",\"群\"],pinyin:\"zhuó ěr bù qún\",meaning:\"优秀卓越超出常人\",difficulty:3,category:[\"人物\"],frequency:12},\n{id:\"h069\",idiom:\"不同凡响\",chars:[\"不\",\"同\",\"凡\",\"响\"],pinyin:\"bù tóng fán xiǎng\",meaning:\"形容事物不平凡很出色\",difficulty:3,category:[\"常用\"],frequency:11},\n{id:\"h070\",idiom:\"鹤发童颜\",chars:[\"鹤\",\"发\",\"童\",\"颜\"],pinyin:\"hè fà tóng yán\",meaning:\"白白的头发红红的面色形容老年人气色好有精神\",difficulty:3,category:[\"动物\",\"人物\"],frequency:10},\n{id:\"h071\",idiom:\"饮鸩止渴\",chars:[\"饮\",\"鸩\",\"止\",\"渴\"],pinyin:\"yǐn zhèn zhǐ kě\",meaning:\"比喻用错误的办法解决眼前的困难而不顾严重后果\",difficulty:3,category:[\"自然\"],frequency:9},\n{id:\"h072\",idiom:\"螳臂当车\",chars:[\"螳\",\"臂\",\"当\",\"车\"],pinyin:\"táng bì dāng chē\",meaning:\"比喻不自量力\",difficulty:3,category:[\"动物\"],frequency:8},\n{id:\"h073\",idiom:\"蚍蜉撼树\",chars:[\"蚍\",\"蜉\",\"撼\",\"树\"],pinyin:\"pí fú hàn shù\",meaning:\"比喻力量很小而想动摇强大的事物不自量力\",difficulty:3,category:[\"动物\"],frequency:7},\n{id:\"h074\",idiom:\"黔驴技穷\",chars:[\"黔\",\"驴\",\"技\",\"穷\"],pinyin:\"qián lǘ jì qióng\",meaning:\"比喻有限的一点本领已经用完了\",difficulty:3,category:[\"动物\"],frequency:6},\n{id:\"h075\",idiom:\"杯水车薪\",chars:[\"杯\",\"水\",\"车\",\"薪\"],pinyin:\"bēi shuǐ chē xīn\",meaning:\"用一杯水去救一车着了火的柴草比喻力量太小无济于事\",difficulty:3,category:[\"自然\"],frequency:5},\n{id:\"h076\",idiom:\"望洋兴叹\",chars:[\"望\",\"洋\",\"兴\",\"叹\"],pinyin:\"wàng yáng xīng tàn\",meaning:\"比喻做事力量不够或没有条件而感到无可奈何\",difficulty:3,category:[\"自然\"],frequency:4},\n{id:\"h077\",idiom:\"望尘莫及\",chars:[\"望\",\"尘\",\"莫\",\"及\"],pinyin:\"wàng chén mò jí\",meaning:\"比喻远远落在后面追赶不上\",difficulty:3,category:[\"自然\"],frequency:3},\n{id:\"h078\",idiom:\"鞭长莫及\",chars:[\"鞭\",\"长\",\"莫\",\"及\"],pinyin:\"biān cháng mò jí\",meaning:\"比喻相隔太远力量达不到\",difficulty:3,category:[\"常用\"],frequency:2},\n{id:\"h079\",idiom:\"无能为力\",chars:[\"无\",\"能\",\"为\",\"力\"],pinyin:\"wú néng wéi lì\",meaning:\"用不上力量帮不上忙指没有能力或力不能及\",difficulty:3,category:[\"常用\"],frequency:1},\n{id:\"h080\",idiom:\"一意孤行\",chars:[\"一\",\"意\",\"孤\",\"行\"],pinyin:\"yī yì gū xíng\",meaning:\"不接受别人的劝告顽固地按照自己的主观想法去做\",difficulty:3,category:[\"数字\"],frequency:30},\n{id:\"h081\",idiom:\"刚愎自用\",chars:[\"刚\",\"愎\",\"自\",\"用\"],pinyin:\"gāng bì zì yòng\",meaning:\"十分固执自信不考虑别人的意见\",difficulty:3,category:[\"人物\"],frequency:29},\n{id:\"h082\",idiom:\"孤芳自赏\",chars:[\"孤\",\"芳\",\"自\",\"赏\"],pinyin:\"gū fāng zì shǎng\",meaning:\"比喻自命清高自我欣赏\",difficulty:3,category:[\"自然\"],frequency:28},\n{id:\"h083\",idiom:\"故步自封\",chars:[\"故\",\"步\",\"自\",\"封\"],pinyin:\"gù bù zì fēng\",meaning:\"比喻安于现状不求进步\",difficulty:3,category:[\"常用\"],frequency:27},\n{id:\"h084\",idiom:\"墨守成规\",chars:[\"墨\",\"守\",\"成\",\"规\"],pinyin:\"mò shǒu chéng guī\",meaning:\"指思想保守守着老规矩不肯改变\",difficulty:3,category:[\"常用\"],frequency:26},\n{id:\"h085\",idiom:\"循规蹈矩\",chars:[\"循\",\"规\",\"蹈\",\"矩\"],pinyin:\"xún guī dǎo jǔ\",meaning:\"遵守规矩不敢违反也指拘守旧准则不敢稍作变动\",difficulty:3,category:[\"常用\"],frequency:25},\n{id:\"h086\",idiom:\"井然有序\",chars:[\"井\",\"然\",\"有\",\"序\"],pinyin:\"jǐng rán yǒu xù\",meaning:\"整整齐齐次序分明条理清楚\",difficulty:3,category:[\"常用\"],frequency:24},\n{id:\"h087\",idiom:\"有条不紊\",chars:[\"有\",\"条\",\"不\",\"紊\"],pinyin:\"yǒu tiáo bù wěn\",meaning:\"有条有理一点不乱\",difficulty:3,category:[\"常用\"],frequency:23},\n{id:\"h088\",idiom:\"一丝不苟\",chars:[\"一\",\"丝\",\"不\",\"苟\"],pinyin:\"yī sī bù gǒu\",meaning:\"形容做事十分认真细致一点儿不马虎\",difficulty:3,category:[\"数字\"],frequency:22},\n{id:\"h089\",idiom:\"按部就班\",chars:[\"按\",\"部\",\"就\",\"班\"],pinyin:\"àn bù jiù bān\",meaning:\"按照一定的条理遵循一定的程序\",difficulty:3,category:[\"常用\"],frequency:21},\n{id:\"h090\",idiom:\"杞人忧天\",chars:[\"杞\",\"人\",\"忧\",\"天\"],pinyin:\"qǐ rén yōu tiān\",meaning:\"比喻不必要的或缺乏根据的忧虑和担心\",difficulty:3,category:[\"寓言\"],frequency:20},\n{id:\"h091\",idiom:\"得天独厚\",chars:[\"得\",\"天\",\"独\",\"厚\"],pinyin:\"dé tiān dú hòu\",meaning:\"具备的条件特别优越或所处环境特别好\",difficulty:3,category:[\"自然\"],frequency:19},\n{id:\"h092\",idiom:\"凤毛麟角\",chars:[\"吉\",\"光\",\"片\",\"羽\"],pinyin:\"jí guāng piàn yǔ\",meaning:\"比喻残存的珍贵文物\",difficulty:3,category:[\"动物\"],frequency:18},\n{id:\"h093\",idiom:\"寥寥无几\",chars:[\"寥\",\"寥\",\"无\",\"几\"],pinyin:\"liáo liáo wú jǐ\",meaning:\"形容数量极少没有几个\",difficulty:3,category:[\"常用\"],frequency:17},\n{id:\"h094\",idiom:\"屈指可数\",chars:[\"屈\",\"指\",\"可\",\"数\"],pinyin:\"qū zhǐ kě shǔ\",meaning:\"扳着手指就可以数清楚形容数量稀少\",difficulty:3,category:[\"数字\"],frequency:16},\n{id:\"h095\",idiom:\"妄自菲薄\",chars:[\"妄\",\"自\",\"菲\",\"薄\"],pinyin:\"wàng zì