192\",idiom:\"无中生有\",chars:[\"无\",\"中\",\"生\",\"有\"],meaning:\"凭空捏造\",difficulty:1,category:[\"常用\"],frequency:8},\n{id:\"e193\",idiom:\"喜出望外\",chars:[\"喜\",\"出\",\"望\",\"外\"],meaning:\"遇到出乎意料的好事特别高兴\",difficulty:1,category:[\"情感\"],frequency:7},\n{id:\"e194\",idiom:\"勇往直前\",chars:[\"勇\",\"往\",\"直\",\"前\"],meaning:\"勇敢地一直向前\",difficulty:1,category:[\"人物\"],frequency:6},\n{id:\"e195\",idiom:\"再接再厉\",chars:[\"再\",\"接\",\"再\",\"厉\"],meaning:\"继续努力再加一把劲\",difficulty:1,category:[\"常用\"],frequency:5},\n{id:\"e196\",idiom:\"真才实学\",chars:[\"真\",\"才\",\"实\",\"学\"],meaning:\"真正的才能和学问\",difficulty:1,category:[\"人物\"],frequency:4},\n{id:\"e197\",idiom:\"志在四方\",chars:[\"志\",\"在\",\"四\",\"方\"],meaning:\"有远大志向不局限于一地\",difficulty:1,category:[\"人物\"],frequency:3},\n{id:\"e198\",idiom:\"众志成城\",chars:[\"众\",\"志\",\"成\",\"城\"],meaning:\"万众一心像坚固的城墙\",difficulty:1,category:[\"人物\"],frequency:2},\n{id:\"e199\",idiom:\"自告奋勇\",chars:[\"自\",\"告\",\"奋\",\"勇\"],meaning:\"主动要求承担某项任务\",difficulty:1,category:[\"人物\"],frequency:1},\n{id:\"e200\",idiom:\"足智多谋\",chars:[\"足\",\"智\",\"多\",\"谋\"],meaning:\"富有智慧善于谋划\",difficulty:1,category:[\"人物\"],frequency:50},\n{id:\"e201\",idiom:\"爱不释手\",chars:[\"爱\",\"不\",\"释\",\"手\"],meaning:\"非常喜爱舍不得放下\",difficulty:1,category:[\"情感\"],frequency:49},\n{id:\"e202\",idiom:\"不知不觉\",chars:[\"不\",\"知\",\"不\",\"觉\"],meaning:\"没有意识到没有察觉到\",difficulty:1,category:[\"常用\"],frequency:48},\n{id:\"e203\",idiom:\"称心如意\",chars:[\"称\",\"心\",\"如\",\"意\"],meaning:\"符合心意非常满意\",difficulty:1,category:[\"情感\"],frequency:47},\n{id:\"e204\",idiom:\"大显身手\",chars:[\"大\",\"显\",\"身\",\"手\"],meaning:\"充分展示自己的才能\",difficulty:1,category:[\"人物\"],frequency:46},\n{id:\"e205\",idiom:\"各有所长\",chars:[\"各\",\"有\",\"所\",\"长\"],meaning:\"每个人都有自己的长处\",difficulty:1,category:[\"人物\"],frequency:45},\n{id:\"e206\",idiom:\"光彩夺目\",chars:[\"光\",\"彩\",\"夺\",\"目\"],meaning:\"颜色和光泽耀眼\",difficulty:1,category:[\"自然\"],frequency:44},\n{id:\"e207\",idiom:\"交口称赞\",chars:[\"交\",\"口\",\"称\",\"赞\"],meaning:\"大家一致称赞\",dif