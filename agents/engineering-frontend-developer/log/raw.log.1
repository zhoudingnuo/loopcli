fficulty:3,category:[\"常用\"],frequency:17},\n{id:\"h094\",idiom:\"屈指可数\",chars:[\"屈\",\"指\",\"可\",\"数\"],pinyin:\"qū zhǐ kě shǔ\",meaning:\"扳着手指就可以数清楚形容数量稀少\",difficulty:3,category:[\"数字\"],frequency:16},\n{id:\"h095\",idiom:\"妄自菲薄\",chars:[\"妄\",\"自\",\"菲\",\"薄\"],pinyin:\"wàng zì fěi bó\",meaning:\"过分看轻自己形容自卑\",difficulty:3,category:[\"人物\"],frequency:15},\n{id:\"h096\",idiom:\"自惭形秽\",chars:[\"自\",\"惭\",\"形\",\"秽\"],pinyin:\"zì cán xíng huì\",meaning:\"因为自己不如别人而感到惭愧\",difficulty:3,category:[\"情感\"],frequency:14},\n{id:\"h097\",idiom:\"厚此薄彼\",chars:[\"厚\",\"此\",\"薄\",\"彼\"],pinyin:\"hòu cǐ bó bǐ\",meaning:\"重视或优待一方轻视或怠慢另一方\",difficulty:3,category:[\"常用\"],frequency:13},\n{id:\"h098\",idiom:\"吹毛求疵\",chars:[\"吹\",\"毛\",\"求\",\"疵\"],pinyin:\"chuī máo qiú cī\",meaning:\"比喻故意挑剔别人的缺点寻找差错\",difficulty:3,category:[\"常用\"],frequency:12},\n{id:\"h099\",idiom:\"求全责备\",chars:[\"求\",\"全\",\"责\",\"备\"],pinyin:\"qiú quán zé bèi\",meaning:\"对人对事物要求十全十美毫无缺点\",difficulty:3,category:[\"常用\"],frequency:11},\n{id:\"h100\",idiom:\"物极必反\",chars:[\"物\",\"极\",\"必\",\"反\"],pinyin:\"wù jí bì fǎn\",meaning:\"事物发展到极端就会向相反方向转化\",difficulty:3,category:[\"常用\"],frequency:10},\n{id:\"h101\",idiom:\"否极泰来\",chars:[\"否\",\"极\",\"泰\",\"来\"],pinyin:\"pǐ jí tài lái\",meaning:\"坏运到了头好运就来了\",difficulty:3,category:[\"常用\"],frequency:9},\n{id:\"h102\",idiom:\"乐极生悲\",chars:[\"乐\",\"极\",\"生\",\"悲\"],pinyin:\"lè jí shēng bēi\",meaning:\"高兴到极点时发生使人悲伤的事\",difficulty:3,category:[\"情感\"],frequency:8},\n{id:\"h103\",idiom:\"居安思危\",chars:[\"居\",\"安\",\"思\",\"危\"],pinyin:\"jū ān sī wēi\",meaning:\"处于安全的境域要想到可能出现的危险\",difficulty:3,category:[\"常用\"],frequency:7},\n{id:\"h104\",idiom:\"居心叵测\",chars:[\"居\",\"心\",\"叵\",\"测\"],pinyin:\"jū xīn pǒ cè\",meaning:\"形容存心险恶不可推测\",difficulty:3,category:[\"人物\"],frequency:6},\n{id:\"h105\",idiom:\"别有用心\",chars:[\"别\",\"有\",\"用\",\"心\"],pinyin:\"bié yǒu yòng xīn\",meaning:\"言论或行动中另有不可告人的企图\",difficulty:3,category:[\"常用\"],frequency:5},\n{id:\"h106\",idiom:\"弥天大谎\",chars:[\"弥\",\"天\",\"大\",\"谎\"],pinyin:\"mí tiān dà huǎng\",meaning:\"形容极大的谎话\",difficulty:3,category:[\"自然\"],frequency:4},\n{id:\"h107\",idiom:\"惊世骇俗\",chars:[\"惊\",\"世\",\"骇\",\"俗\"],pinyin:\"jīng shì hài sú\",meaning:\"因言语行动异乎寻常而使一般人感到震惊\",difficulty:3,category:[\"常用\"],frequency:3},\n{id:\"h108\",idiom:\"振振有词\",chars:[\"振\",\"振\",\"有\",\"词\"],pinyin:\"zhèn zhèn yǒu cí\",meaning:\"形容自以为理由充分说个不停\",difficulty:3,category:[\"常用\"],frequency:2},\n{id:\"h109\",idiom:\"信口雌黄\",chars:[\"信\",\"口\",\"雌\",\"黄\"],pinyin:\"xìn kǒu cí huáng\",meaning:\"比喻不顾事实随口乱说\",difficulty:3,category:[\"常用\"],frequency:1},\n{id:\"h110\",idiom:\"强词夺理\",chars:[\"强\",\"词\",\"夺\",\"理\"],pinyin:\"qiǎng cí duó lǐ\",meaning:\"本来没有理硬说得似乎有理\",difficulty:3,category:[\"常用\"],frequency:30},\n{id:\"h111\",idiom:\"理所当然\",chars:[\"理\",\"所\",\"当\",\"然\"],pinyin:\"lǐ suǒ dāng rán\",meaning:\"从道理上讲应当这样\",difficulty:3,category:[\"常用\"],frequency:29},\n{id:\"h112\",idiom:\"天经地义\",chars:[\"天\",\"经\",\"地\",\"义\"],pinyin:\"tiān jīng dì yì\",meaning:\"非常正确不容置疑的道理\",difficulty:3,category:[\"自然\"],frequency:28},\n{id:\"h113\",idiom:\"名正言顺\",chars:[\"名\",\"正\",\"言\",\"顺\"],pinyin:\"míng zhèng yán shùn\",meaning:\"名义正当道理也讲得通\",difficulty:3,category:[\"常用\"],frequency:27},\n{id:\"h114\",idiom:\"顺理成章\",chars:[\"顺\",\"理\",\"成\",\"章\"],pinyin:\"shùn lǐ chéng zhāng\",meaning:\"某种情况合乎情理自然产生某种结果\",difficulty:3,category:[\"常用\"],frequency:26},\n{id:\"h115\",idiom:\"水到渠成\",chars:[\"水\",\"到\",\"渠\",\"成\"],pinyin:\"shuǐ dào qú chéng\",meaning:\"水流到的地方自然形成一条渠比喻条件成熟事情自然会成功\",difficulty:3,category:[\"自然\"],frequency:25},\n{id:\"h116\",idiom:\"瓜熟蒂落\",chars:[\"瓜\",\"熟\",\"蒂\",\"落\"],pinyin:\"guā shú dì luò\",meaning:\"瓜熟了瓜蒂自然脱落比喻条件成熟事情自然会成功\",difficulty:3,category:[\"自然\"],frequency:24},\n{id:\"h117\",idiom:\"功亏一篑\",chars:[\"功\",\"亏\",\"一\",\"篑\"],pinyin:\"gōng kuī yī kuì\",meaning:\"比喻做事情只差最后一点没能完成\",difficulty:3,category:[\"数字\"],frequency:23},\n{id:\"h118\",idiom:\"半途而废\",chars:[\"半\",\"途\",\"而\",\"废\"],pinyin:\"bàn tú ér fèi\",meaning:\"做事不能坚持到底中途