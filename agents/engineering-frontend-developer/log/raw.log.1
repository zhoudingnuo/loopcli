3\t  },\n64\t};\n65\t\n66\texport function getRecipe(id: string): AlchemyRecipe | undefined {\n67\t  return RECIPES[id];\n68\t}\n69\t\n70\texport function getAllRecipes(): AlchemyRecipe[] {\n71\t  return Object.values(RECIPES);\n72\t}\n73\t\n74\texport function getAvailableRecipes(unlockCheck: (realm: string) => boolean): AlchemyRecipe[] {\n75\t  return getAllRecipes().filter(r => unlockCheck(r.unlockRealm));\n76\t}\n77\t\n78\t// Check if player can start crafting a recipe\n79\texport function canCraft(recipe: AlchemyRecipe, resources: Record<string, number>): boolean {\n80\t  return Object.entries(recipe.ingredients).every(\n81\t    ([res, cost]) => (resources[res] ?? 0) >= cost,\n82\t  );\n83\t}\n84\t\n85\t// Start crafting: deduct ingredients, return session\n86\texport function startCrafting(\n87\t  recipeId: string,\n88\t  resources: Record<string, number>,\n89\t): { session: AlchemySession; resources: Record<string, number> } | null {\n90\t  const recipe = RECIPES[recipeId];\n91\t  if (!recipe) return null;\n92\t  if (!canCraft(recipe, resources)) return null;\n93\t\n94\t  // Deduct ingredients\n95\t  const newResources = { ...resources };\n96\t  for (const [res, cost] of Object.entries(recipe.ingredients)) {\n97\t    newResources[res] = (newResources[res] ?? 0) - cost;\n98\t  }\n99\t\n100\t  return {\n101\t    session: {\n102\t      recipeId,\n103\t      startTime: Date.now(),\n104\t      progress: 0,\n105\t      complete: false,\n106\t    },\n107\t    resources: newResources,\n108\t  };\n109\t}\n110\t\n111\t// Tick alchemy progress\n112\texport function tickAlchemy(session: AlchemySession | null, now: number): AlchemySession | null {\n113\t  if (!session || session.complete) return session;\n114\t\n115\t  const recipe = RECIPES[session.recipeId];\n116\t  if (!recipe) return null;\n117\t\n118\t  const elapsed = now - session.startTime;\n119\t  const progress = Math.min(1, elapsed / recipe.time);\n120\t\n121\t  return {\n122\t    ...session,\n123\t    progress,\n124\t    complete: progress >= 1,\n125\t  };\n126\t}\n127\t\n128\t// Collect result from completed alchemy\n129\texport function collectAlchemy(\n130\t  session: AlchemySession,\n131\t  resources: Record<string, number>,\n132\t): { resources: Record<string, number>; expReward: number; amount: number; success: boolean } | null {\n133\t  if (!session.complete) return null;\n134\t\n135\t  const recipe = RECIPES[session.recipeId];\n136\t  if (!recipe) return null;\n137\t\n138\t  // Roll for success\n139\t  const roll = Math.random();\n140\t  const success = roll < recipe.successRate;\n141\t\n142\t  if (!success) {\n143\t    return { resources, expReward: 0, amount: 0, success: false };\n144\t  }\n145\t\n146\t  // Calculate output amount\n147\t  const amount = recipe.output.amountMax\n148\t    ? recipe.output.amount + Math.floor(Math.random() * (recipe.output.amountMax - recipe.output.amount + 1))\n149\t    : recipe.output.amount;\n150\t\n151\t  const newResources = { ...resources };\n152\t  newResources[recipe.output.resource] = (newResources[recipe.output.resource] ?? 0) + amount;\n153\t\n154\t  return { resources: newResources, expReward: recipe.expReward, amount, success: true };\n155\t}\n156\t\n157\t// Get remaining time string\n158\texport function getRemainingTime(session: AlchemySession | null): string {\n159\t  if (!session) return '';\n160\t  const recipe = RECIPES[session.recipeId];\n161\t  if (!recipe) return '';\n162\t\n163\t  const elapsed = Date.now() - session.startTime;\n164\t  const remaining = Math.max(0, recipe.time - elapsed);\n165\t  const secs = Math.ceil(remaining / 1000);\n166\t  return `${secs}s`;\n167\t}\n168\t"}]},"parent_tool_use_id":null,"session_id":"c0e01ba0-5708-46af-9590-e43af2395006","uuid":"2d7f0aa9-5016-4a5c-884b-bf4c5a97f29a","timestamp":"2026-05-23T01:34:48.063Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Alchemy.ts","content":"// Alchemy.ts — Alchemy system with recipes, progress, and success rates\n\nexport interface AlchemyRecipe {\n  id: string;\n  name: string;\n  nameEn: string;\n  grade: string;\n  ingredients: Record<string, number>;\n  output: { resource: string; amount: number; amountMax?: number };\n  time: number; // ms\n  successRate: number;\n  expReward: number;\n  unlockRealm: string;\n  description: string;\n}\n\nexport interface AlchemySession {\n  recipeId: string;\n  startTime: number;\n  progress: number;\n  complete: boolean;\n}\n\nconst RECIPES: Record<string, AlchemyRecipe> = {\n  pill_juling: {\n    id: 'pill_juling',\n    name: '聚灵丹',\n    nameEn: 'Spirit Gathering Pill',\n    grade: '下品',\n    ingredients: { spirit_grass: 3 },\n    output: { resource: 'pill_juling', amount: 1 },\n    time: 15000,\n    successRate: 0.95,\n    expReward: 10,\n    unlockRealm: 'liqi_2',\n    description: '基础丹药，修为+10',\n  },\n  pill_peiyuan: {\n    id: 'pill_peiyuan',\n    name: '培元丹',\n    nameEn: 'Foundation Pill',\n    grade: '下品',\n    ingredients: { spirit_grass: 5, spirit_stone: 2 },\n    output: { resource: 'pill_peiyuan', amount: 1 },\n    time: 20000,\n    successRate: 0.90,\n    expReward: 30,\n    unlockRealm: 'liqi_6',\n    description: '中级丹药，修为+30',\n  },\n  pill_ningqi: {\n    id: 'pill_ningqi',\n    name: '凝气丹',\n    nameEn: 'Qi Condensing Pill',\n    grade: '下品',\n    ingredients: { spirit_grass: 5, spirit_stone: 2 },\n    output: { resource: 'pill_ningqi', amount: 1, amountMax: 2 },\n    time: 25000,\n    successRate: 0.85,\n    expReward: 50,\n    unlockRealm: 'liqi_8',\n    description: '凝练灵气，修为+50',\n  },\n};\n\nexport function getRecipe(id: string): AlchemyRecipe | undefined {\n  return RECIPES[id];\n}\n\nexport function getAllRecipes(): AlchemyRecipe[] {\n  return Object.values(RECIPES);\n}\n\nexport function getAvailableRecipes(unlockCheck: (realm: string) => boolean): AlchemyRecipe[] {\n  return getAllRecipes().filter(r => unlockCheck(r.unlockRealm));\n}\n\n// Check if player can start crafting a recipe\nexport function canCraft(recipe: AlchemyRecipe, resources: Record<string, number>): boolean {\n  return Object.entries(recipe.ingredients).every(\n    ([res, cost]) => (resources[res] ?? 0) >= cost,\n  );\n}\n\n// Start crafting: deduct ingredients, return session\nexport function startCrafting(\n  recipeId: string,\n  resources: Record<string, number>,\n): { session: AlchemySession; resources: Record<string, number> } | null {\n  const recipe = RECIPES[recipeId];\n  if (!recipe) return null;\n  if (!canCraft(recipe, resources)) return null;\n\n  // Deduct ingredients\n  const newResources = { ...resources };\n  for (const [res, cost] of Object.entries(recipe.ingredients)) {\n    newResources[res] = (newResources[res] ?? 0) - cost;\n  }\n\n  return {\n    session: {\n      recipeId,\n      startTime: Date.now(),\n      progress: 0,\n      complete: false,\n    },\n    resources: newResources,\n  };\n}\n\n// Tick alchemy progress\nexport function tickAlchemy(session: AlchemySession | null, now: number): AlchemySession | null {\n  if (!session || session.complete) return session;\n\n  const recipe = RECIPES[session.recipeId];\n  if (!recipe) return null;\n\n  const elapsed = now - session.startTime;\n  const progress = Math.min(1, elapsed / recipe.time);\n\n  return {\n    ...session,\n    progress,\n    complete: progress >= 1,\n  };\n}\n\n// Collect result from completed alchemy\nexport function collectAlchemy(\n  session: AlchemySession,\n  resources: Record<string, number>,\n): { resources: Record<string, number>; expReward: number; amount: number; success: boolean } | null {\n  if (!session.complete) return null;\n\n  const recipe = RECIPES[session.recipeId];\n  if (!recipe) return null;\n\n  // Roll for success\n  const roll = Math.random();\n  const success = roll < recipe.successRate;\n\n  if (!success) {\n    return { resources, expReward: 0, amount: 0, success: false };\n  }\n\n  // Calculate output amount\n  const amount = recipe.output.amountMax\n    ? recipe.output.amount + Math.floor(Math.random() * (recipe.output.amountMax - recipe.output.amount + 1))\n    : recipe.output.amount;\n\n  const newResources = { ...resources };\n  newResources[recipe.output.resource] = (newResources[recipe.output.resource] ?? 0) + amount;\n\n  return { resources: newResources, expReward: recipe.expReward, amount, success: true };\n}\n\n// Get remaining time string\nexport function getRemainingTime(session: AlchemySession | null): string {\n  if (!session) return '';\n  const recipe = RECIPES[session.recipeId];\n  if (!recipe) return '';\n\n  const elapsed = Date.now() - session.startTime;\n  const remaining = Math.max(0, recipe.time - elapsed);\n  const secs = Math.ceil(remaining / 1000);\n  return `${secs}s`;\n}\n","numLines":168,"startLine":1,"totalLines":168}}}
