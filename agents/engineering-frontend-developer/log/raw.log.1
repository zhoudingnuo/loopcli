{"type":"assistant","message":{"id":"msg_2026052307572257240bf2ea894ba4","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_0987b9493b064d7d9fa72077","name":"Write","input":{"file_path":"D:/game-projects/douyin-idiom/src/js/Game.js","content":"// Game.js — Main game controller\n\nclass Game {\n  constructor() {\n    this.engine = new IdiomEngine(IDIOM_DB);\n    this.judge = new Judge();\n    this.combo = new ComboSystem();\n    this.data = new DataManager();\n    this.audio = new AudioManager();\n    this.tutorial = new Tutorial();\n\n    this.currentLevel = null;\n    this.questions = [];\n    this.questionIndex = 0;\n    this.lives = 5;\n    this.state = 'menu';\n    this.usedHintThisQuestion = false;\n    this.hintsUsed = 0;\n    this.continuedOnce = false;\n  }\n\n  startLevel(levelId) {\n    const level = LEVELS.find(l => l.id === levelId);\n    if (!level) return;\n    this.currentLevel = level;\n    this.lives = level.lives;\n    this.questions = this.engine.generateForLevel(level);\n    this.questionIndex = 0;\n    this.combo.reset();\n    this.continuedOnce = false;\n    this.hintsUsed = 0;\n    this.engine.reset();\n    this.state = 'playing';\n    if (level.tutorial) this.tutorial.start(level.tutorial);\n    else this.tutorial.end();\n    this.startQuestion();\n  }\n\n  startQuestion() {\n    if (this.questionIndex >= this.questions.length) { this.finishLevel(); return; }\n    const q = this.questions[this.questionIndex];\n    this.judge.startQuestion(q);\n    this.usedHintThisQuestion = false;\n  }\n\n  pickChar(candidateIndex) {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const result = this.judge.placeChar(candidateIndex);\n    if (result.action === 'placed') {\n      this.audio.playPlace();\n      if (result.fillCount === 4) setTimeout(() => this.handleFullAnswer(result), 400);\n    } else if (result.action === 'full') {\n      setTimeout(() => this.handleFullAnswer(result), 200);\n    }\n    return result;\n  }\n\n  handleFullAnswer(result) {\n    const q = this.questions[this.questionIndex];\n    q.answered = true;\n    q.correct = result.isCorrect;\n    if (result.isCorrect) {\n      this.audio.playCorrect();\n      const cr = this.combo.onCorrect(this.usedHintThisQuestion);\n      if (cr.combo >= 3) this.audio.playCombo(cr.combo);\n      this.data.collectIdiom(q.idiom.id);\n      q.comboResult = cr;\n      setTimeout(() => { this.questionIndex++; this.startQuestion(); this.render(); }, 800);\n    } else {\n      this.audio.playWrong();\n      this.combo.onWrong();\n      this.lives--;\n      if (this.lives <= 0) setTimeout(() => this.finishLevel(), 600);\n      else setTimeout(() => { q.answered = false; q.correct = null; this.judge.startQuestion(q); this.render(); }, 500);\n    }\n    this.render();\n  }\n\n  removeSlot(slotIndex) {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const result = this.judge.removeSlot(slotIndex);\n    if (result.action === 'removed') this.audio.playPlace();\n    return result;\n  }\n\n  useHintReveal() {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const fc = this.judge.getFillCount();\n    const ch = this.judge.currentIdiom.chars[fc];\n    const cand = q.candidates.find(c => c.char === ch && !c.used);\n    if (!cand) return null;\n    this.usedHintThisQuestion = true;\n    this.hintsUsed++;\n    this.audio.playHint();\n    return this.judge.placeChar(cand.index);\n  }\n\n  useHintRemove() {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const wrong = q.candidates.filter(c => !c.used && !this.judge.currentIdiom.chars.includes(c.char));\n    const removed = [];\n    const cnt = Math.min(2, wrong.length);\n    for (let i = 0; i < cnt; i++) {\n      const idx = Math.floor(Math.random() * wrong.length);\n      const c = wrong.splice(idx, 1)[0];\n      c.removed = true;\n      removed.push(c);\n    }\n    this.audio.playRemove();\n    return { action: 'removed_distractors', removed };\n  }\n\n  skipQuestion() {\n    if (this.state !== 'playing') return;\n    const q = this.questions[this.questionIndex];\n    if (q) { q.answered = true; q.correct = false; q.skipped = true; }\n    this.combo.onSkip();\n    this.questionIndex++;\n    this.startQuestion();\n    this.render();\n  }\n\n  continueWithAd() {\n    if (this.continuedOnce) return false;\n    this.lives = 3;\n    this.continuedOnce = true;\n    this.state = 'playing';\n    this.render();\n    return true;\n  }\n\n  finishLevel() {\n    this.state = 'result';\n    const s = this.combo.getStats();\n    const stars = this.combo.getStarRating(s.correctCount, this.questions.length);\n    if (stars > 0 && this.currentLevel) {\n      this.data.setLevelStars(this.currentLevel.id, stars);\n      this.data.addCoins(this.currentLevel.reward.coins);\n      this.data.addScore(s.score);\n      this.data.updateBestCombo(s.maxCombo);\n    }\n    this.levelResult = { stars, correctCount: s.correctCount, totalQuestions: this.questions.length, score: s.score, maxCombo: s.maxCombo, coins: stars > 0 ? this.currentLevel.reward.coins : 0 };\n    if (stars > 0) this.audio.playLevelWin(); else this.audio.playLevelFail();\n    this.render();\n  }\n\n  getCurrentQuestion() { return this.questions[this.questionIndex]; }\n\n  render() { if (typeof renderUI === 'function') renderUI(this); }\n\n  getState() {\n    return {\n      state: this.state, currentLevel: this.currentLevel, question: this.getCurrentQuestion(),\n      questionIndex: this.questionIndex, totalQuestions: this.questions.length, lives: this.lives,\n      combo: this.combo.combo, score: this.combo.score, slots: this.judge.getSlots(),\n      fillCount: this.judge.getFillCount(), stats: this.combo.getStats(),\n      levelResult: this.levelResult, tutorial: this.tutorial\n    };\n  }\n\n  goToMenu() { this.state = 'menu'; this.tutorial.end(); this.render(); }\n}\n\nif (typeof module !== 'undefined') module.exports = { Game };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"930c8880-e9f5-4f41-8841-d1efd19066ee","uuid":"d0ed384b-f81b-4024-9457-8a48c426a926"}
