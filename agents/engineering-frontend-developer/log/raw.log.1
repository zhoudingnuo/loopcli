nBounds(gx, gy)) return;\n    this.terrain[gy * this.width + gx] = t;\n  }\n\n  // Check if a rect of cells is free for placement\n  isAreaFree(gx: number, gy: number, w: number, h: number, occupied: Set<string>): boolean {\n    for (let dy = 0; dy < h; dy++) {\n      for (let dx = 0; dx < w; dx++) {\n        const cx = gx + dx;\n        const cy = gy + dy;\n        if (!this.inBounds(cx, cy)) return false;\n        const t = this.getTerrain(cx, cy);\n        if (t === Terrain.Water || t === Terrain.Mountain) return false;\n        const key = `${cx},${cy}`;\n        if (occupied.has(key)) return false;\n      }\n    }\n    return true;\n  }\n\n  // Generate terrain for the starting area (炼气坪)\n  generateStartingArea(): void {\n    // Add some spirit veins (矿脉)\n    const veinPositions = [\n      [3, 2], [4, 2], [3, 3],\n      [14, 10], [15, 10], [15, 11],\n      [8, 7], [8, 8],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    // Add some water features\n    const waterPositions = [\n      [10, 1], [11, 1], [10, 2],\n      [1, 12], [2, 12], [1, 11],\n    ];\n    for (const [x, y] of waterPositions) {\n      this.setTerrain(x, y, Terrain.Water);\n    }\n\n    // Add path\n    for (let x = 5; x < 15; x++) {\n      this.setTerrain(x, 7, Terrain.Path);\n    }\n    for (let y = 3; y < 12; y++) {\n      this.setTerrain(10, y, Terrain.Path);\n    }\n\n    // Rich soil near center\n    for (let y = 5; y < 8; y++) {\n      for (let x = 6; x < 9; x++) {\n        this.setTerrain(x, y, Terrain.RichSoil);\n      }\n    }\n  }\n\n  // Render map terrain to canvas\n  render(\n    ctx: CanvasRenderingContext2D,\n    offsetX: number,\n    offsetY: number,\n    viewportW: number,\n    viewportH: number,\n    scale: number,\n  ): void {\n    const invScale = 1 / scale;\n    const startCol = Math.max(0, Math.floor(-offsetX * invScale / this.cellSize));\n    const startRow = Math.max(0, Math.floor(-offsetY * invScale / this.cellSize));\n    const endCol = Math.min(this.width, Math.ceil((-offsetX + viewportW) * invScale / this.cellSize) + 1);\n    const endRow = Math.min(this.height, Math.ceil((-offsetY + viewportH) * invScale / this.cellSize) + 1);\n\n    // Draw terrain cells\n    for (let row = startRow; row < endRow; row++) {\n      for (let col = startCol; col < endCol; col++) {\n        const x = offsetX + col * this.cellSize * scale;\n        const y = offsetY + row * this.cellSize * scale;\n        const size = this.cellSize * scale;\n\n        ctx.fillStyle = this.getTerrainColor(this.getTerrain(col, row));\n        ctx.fillRect(x, y, size, size);\n\n        // Draw grid line\n        ctx.strokeStyle = this.gridColor;\n        ctx.lineWidth = 0.5;\n        ctx.strokeRect(x, y, size, size);\n      }\n    }\n  }\n\n  private getTerrainColor(t: Terrain): string {\n    switch (t) {\n      case Terrain.Grass: return this.bgColor;\n      case Terrain.Rock: return '#3a3a4a';\n      case Terrain.Water: return '#1a3a5a';\n      case Terrain.RichSoil: return '#2a4a1a';\n      case Terrain.Mountain: return '#4a4a4a';\n      case Terrain.Path: return '#4a3a2a';\n      case Terrain.SpiritVein: return '#2a4a5a';\n      default: return this.bgColor;\n    }\n  }\n\n  // Screen coordinates to grid cell\n  screenToGrid(\n    screenX: number,\n    screenY: number,\n    offsetX: number,\n    offsetY: number,\n    scale: number,\n  ): { gx: number; gy: number } {\n    const invScale = 1 / scale;\n    const gx = Math.floor((screenX - offsetX) * invScale / this.cellSize);\n    const gy = Math.floor((screenY - offsetY) * invScale / this.cellSize);\n    return { gx, gy };\n  }\n\n  // Grid cell center to screen coordinates\n  gridToScreen(\n    gx: number,\n    gy: number,\n    offsetX: number,\n    offsetY: number,\n    scale: number,\n  ): { x: number; y: number } {\n    return {\n      x: offsetX + (gx + 0.5) * this.cellSize * scale,\n      y: offsetY + (gy + 0.5) * this.cellSize * scale,\n    };