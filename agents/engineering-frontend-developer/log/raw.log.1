   \"id\": \"meditation_mat\",\n      \"name\": \"蒲团\",\n      \"nameEn\": \"Meditation Mat\",\n      \"type\": \"auto_collection\",\n      \"category\": \"cultivation\",\n      \"cost\": { \"spirit_stone\": 40 },\n      \"size\": { \"w\": 1, \"h\": 1 },\n      \"production\": {\n        \"resource\": \"cultivation\",\n        \"amount\": 1,\n        \"interval\": 5000,\n        \"mode\": \"auto\"\n      },\n      \"description\": \"自动修炼，每5秒修为+1\",\n      \"unlockRealm\": \"liqi_4\",\n      \"maxLevel\": 5,\n      \"color\": { \"r\": 255, \"g\": 215, \"b\": 0, \"a\": 1 }\n    },\n    {\n      \"id\": \"conveyor_lv1\",\n      \"name\": \"灵脉通道 Lv1\",\n      \"nameEn\": \"Spirit Channel Lv1\",\n      \"type\": \"transport\",\n      \"category\": \"transport\",\n      \"cost\": { \"spirit_stone\": 10 },\n      \"size\": { \"w\": 1, \"h\": 1 },\n      \"production\": {\n        \"resource\": \"\",\n        \"amount\": 0,\n        \"interval\": 0,\n        \"mode\": \"none\"\n      },\n      \"description\": \"直线传送资源，连接矿机与丹炉\",\n      \"unlockRealm\": \"zhuji_1\",\n      \"maxLevel\": 3,\n      \"color\": { \"r\": 100, \"g\": 150, \"b\": 200, \"a\": 0.7 }\n    },\n    {\n      \"id\": \"conveyor_lv2\",\n      \"name\": \"灵脉通道 Lv2\",\n      \"nameEn\": \"Spirit Channel Lv2\",\n      \"type\": \"transport\",\n      \"category\": \"transport\",\n      \"cost\": { \"spirit_stone\": 30 },\n      \"size\": { \"w\": 1, \"h\": 1 },\n      \"production\": {\n        \"resource\": \"\",\n        \"amount\": 0,\n        \"interval\": 0,\n        \"mode\": \"none\"\n      },\n      \"description\": \"可转弯、分叉的传送通道\",\n      \"unlockRealm\": \"zhuji_5\",\n      \"maxLevel\": 3,\n      \"color\": { \"r\": 150, \"g\": 120, \"b\": 220, \"a\": 0.7 }\n    },\n    {\n      \"id\": \"puppet_sorter\",\n      \"name\": \"分拣傀儡\",\n      \"nameEn\": \"Sorting Puppet\",\n      \"type\": \"automation\",\n      \"category\": \"automation\",\n      \"cost\": { \"spirit_stone\": 80, \"talisman_paper\":