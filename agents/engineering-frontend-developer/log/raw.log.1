  min-height: 100vh;\n  overflow: hidden;\n}\n\n#app {\n  width: 100%;\n  height: 100vh;\n  max-width: 600px;\n  margin: 0 auto;\n  position: relative;\n}\n\n.screen {\n  display: none;\n  width: 100%;\n  height: 100%;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 20px;\n}\n\n.screen.active {\n  display: flex;\n}\n\n/* 主菜单 */\n.title {\n  font-size: 48px;\n  font-weight: bold;\n  color: #C84B31;\n  margin-bottom: 10px;\n  text-shadow: 2px 2px 4px rgba(0,0,0,0.1);\n}\n\n.subtitle {\n  font-size: 24px;\n  color: #8B7355;\n  margin-bottom: 40px;\n}\n\n.btn-primary, .btn-secondary {\n  width: 200px;\n  padding: 15px 30px;\n  margin: 10px;\n  border: none;\n  border-radius: 25px;\n  font-size: 18px;\n  cursor: pointer;\n  transition: transform 0.1s;\n}\n\n.btn-primary {\n  background: linear-gradient(135deg, #C84B31 0%, #A63A22 100%);\n  color: white;\n}\n\n.btn-secondary {\n  background: linear-gradient(135deg, #2D6A4F 0%, #1E4D33 100%);\n  color: white;\n}\n\n.btn-primary:active, .btn-secondary:active {\n  transform: scale(0.95);\n}\n\n/* 游戏界面 */\n.game-header {\n  display: flex;\n  justify-content: space-between;\n  width: 100%;\n  padding: 10px;\n  background: rgba(255,255,255,0.8);\n  border-radius: 10px;\n  margin-bottom: 20px;\n}\n\n.level-info, .lives, .score {\n  font-size: 16px;\n  color: #2C2C2C;\n}\n\n.question-area {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n}\n\n.combo {\n  font-size: 24px;\n  color: #D4A843;\n  font-weight: bold;\n  height: 30px;\n  margin-bottom: 10px;\n}\n\n.meaning {\n  font-size: 18px;\n  color: #2C2C2C;\n  text-align: center;\n  padding: 15px;\n  background: white;\n  border-radius: 10px;\n  margin-bottom: 20px;\n  max-width: 90%;\n}\n\n.slots {\n  display: flex;\n  gap: 10px;\n  margin-bottom: 30px;\n}\n\n.slot {\n  width: 60px;\n  height: 60px;\n  border: 3px solid #8B7355;\n  border-radius: 10px;\n  background: white;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 28px;\n  font-weight: bold;\n  color: #2C2C2C;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.slot.filled {\n  background: #FFFDF7;\n  border-color: #C84B31;\n}\n\n.slot.correct {\n  background: #27AE60;\n  border-color: #27AE60;\n  color: white;\n  animation: correctPulse 0.4s;\n}\n\n.slot.wrong {\n  background: #E74C3C;\n  border-color: #E74C3C;\n  color: white;\n  animation: wrongShake 0.5s;\n}\n\n@keyframes correctPulse {\n  0%, 100% { transform: scale(1); }\n  50% { transform: scale(1.1); }\n}\n\n@keyframes wrongShake {\n  0%, 100% { transform: translateX(0); }\n  25% { transform: translateX(-10px); }\n  75% { transform: translateX(10px); }\n}\n\n.candidates {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  justify-content: center;\n  max-width: 100%;\n  margin-bottom: 20px;\n}\n\n.candidate {\n  width: 50px;\n  height: 50px;\n  border: none;\n  border-radius: 10px;\n  background: linear-gradient(135deg, #C84B31 0%, #A63A22 100%);\n  color: white;\n  font-size: 24px;\n  font-weight: bold;\n  cursor: pointer;\n  transition: transform 0.1s;\n}\n\n.candidate:active {\n  transform: scale(0.9);\n}\n\n.candidate.used {\n  opacity: 0.3;\n  pointer-events: none;\n}\n\n.tools {\n  display: flex;\n  gap: 10px;\n}\n\n.tool-btn {\n  width: 80px;\n  height: 50px;\n  border: none;\n  border-radius: 10px;\n  background: #2D6A4F;\n  color: white;\n  font-size: 14px;\n  cursor: pointer;\n}\n\n/* 结算界面 */\n.result-title {\n  font-size: 36px;\n  font-weight: bold;\n  color: #C84B31;\n  margin-bottom: 20px;\n}\n\n.stars {\n  display: flex;\n  gap: 10px;\n  margin-bottom: 20px;\n}\n\n.star {\n  font-size: 40px;\n  color: #D4A843;\n}\n\n.star.empty {\n  color: #ccc;\n}\n\n.result-score, .result-coins {\n  font-size: 20px;\n  color: #2C2C2C;\n  margin: 10px 0;\n}\n","numLines":251,"startLine":1,"totalLines":251}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f20183e4ebc44e27b39eaebb","type":"tool_result","content":"1\t// ComboSystem.js — Combo tracking and scoring\n2\t\n3\tclass ComboSystem {\n4\t  constructor() {\n5\t    this.combo = 0;\n6\t    this.maxCombo = 0;\n7\t    this.score = 0;\n8\t    this.correctCount = 0;\n9\t    this.wrongCount = 0;\n10\t  }\n11\t\n12\t  onCorrect(usedHint = false) {\n13\t    this.correctCount++;\n14\t    this.combo++;\n15\t    if (this.combo > this.maxCombo) this.maxCombo = this.combo;\n16\t\n17\t    let baseScore = 100;\n18\t    let comboBonus = 0;\n19\t\n20\t    if (!usedHint) {\n21\t      comboBonus = this.getComboBonus();\n22\t      this.score += baseScore + comboBonus;\n23\t    } else {\n24\t      this.score += baseScore;\n25\t    }\n26\t\n27\t    return {\n28\t      combo: this.combo,\n29\t      score: this.score,\n30\t      baseScore,\n31\t      comboBonus,\n32\t      totalGain: baseScore + comboBonus,\n33\t      message: this.getComboMessage(),\n34\t      effect: this.getComboEffect()\n35\t    };\n36\t  }\n37\t\n38\t  onWrong() {\n39\t    this.wrongCount++;\n40\t    const prevCombo = this.combo;\n41\t    this.combo = 0;\n42\t    return { combo: 0, prevCombo, message: '连击中断' };\n43\t  }\n44\t\n45\t  onSkip() {\n46\t    this.combo = 0;\n47\t    return { combo: 0, message: '跳过本题' };\n48\t  }\n49\t\n50\t  getComboBonus() {\n51\t    if (this.combo < 3) return 0;\n52\t    if (this.combo < 5) return (this.combo - 2) * 20;\n53\t    if (this.combo < 8) return 100 + (this.combo - 5) * 30;\n54\t    if (this.combo < 10) return 200 + (this.combo - 8) * 40;\n55\t    return 300 + (this.combo - 10) * 50;\n56\t  }\n57\t\n58\t  getComboMessage() {\n59\t    if (this.combo >= 10) return '成语大师！！';\n60\t    if (this.combo >= 8) return '学霸！';\n61\t    if (this.combo >= 5) return '厉害了！';\n62\t    if (this.combo >= 3) return '不错！';\n63\t    return '';\n64\t  }\n65\t\n66\t  getComboEffect() {\n67\t    if (this.combo >= 10) return 'fireworks';\n68\t    if (this.combo >= 8) return 'golden';\n69\t    if (this.combo >= 5) return 'shake';\n70\t    if (this.combo >= 3) return 'text';\n71\t    return null;\n72\t  }\n73\t\n74\t  getStarRating(correctCount, totalQuestions) {\n75\t    const rate = correctCount / totalQuestions;\n76\t    if (rate >= 0.9) return 3;\n77\t    if (rate >= 0.7) return 2;\n78\t    if (rate >= 0.5) return 1;\n79\t    return 0;\n80\t  }\n81\t\n82\t  getStats() {\n83\t    return {\n84\t      score: this.score,\n85\t      combo: this.combo,\n86\t      maxCombo: this.maxCombo,\n87\t      correctCount: this.correctCount,\n88\t      wrongCount: this.wrongCount,\n89\t      totalAnswered: this.correctCount + this.wrongCount\n90\t    };\n91\t  }\n92\t\n93\t  reset() {\n94\t    this.combo = 0;\n95\t    this.maxCombo = 0;\n96\t    this.score = 0;\n97\t    this.correctCount = 0;\n98\t    this.wrongCount = 0;\n99\t  }\n100\t}\n101\t\n102\tif (typeof module !== 'undefined') module.exports = { ComboSystem };\n103\t"}]},"parent_tool_use_id":null,"session_id":"930c8880-e9f5-4f41-8841-d1efd19066ee","uuid":"1349da02-2aca-46de-bdb3-788bf4147ced","timestamp":"2026-05-22T23:58:10.566Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/src/js/ComboSystem.js","content":"// ComboSystem.js — Combo tracking and scoring\n\nclass ComboSystem {\n  constructor() {\n    this.combo = 0;\n    this.maxCombo = 0;\n    this.score = 0;\n    this.correctCount = 0;\n    this.wrongCount = 0;\n  }\n\n  onCorrect(usedHint = false) {\n    this.correctCount++;\n    this.combo++;\n    if (this.combo > this.maxCombo) this.maxCombo = this.combo;\n\n    let baseScore = 100;\n    let comboBonus = 0;\n\n    if (!usedHint) {\n      comboBonus = this.getComboBonus();\n      this.score += baseScore + comboBonus;\n    } else {\n      this.score += baseScore;\n    }\n\n    return {\n      combo: this.combo,\n      score: this.score,\n      baseScore,\n      comboBonus,\n      totalGain: baseScore + comboBonus,\n      message: this.getComboMessage(),\n      effect: this.getComboEffect()\n    };\n  }\n\n  onWrong() {\n    this.wrongCount++;\n    const prevCombo = this.combo;\n    this.combo = 0;\n    return { combo: 0, prevCombo, message: '连击中断' };\n  }\n\n  onSkip() {\n    this.combo = 0;\n    return { combo: 0, message: '跳过本题' };\n  }\n\n  getComboBonus() {\n    if (this.combo < 3) return 0;\n    if (this.combo < 5) return (this.combo - 2) * 20;\n    if (this.combo < 8) return 100 + (this.combo - 5) * 30;\n    if (this.combo < 10) return 200 + (this.combo - 8) * 40;\n    return 300 + (this.combo - 10) * 50;\n  }\n\n  getComboMessage() {\n    if (this.combo >= 10) return '成语大师！！';\n    if (this.combo >= 8) return '学霸！';\n    if (this.combo >= 5) return '厉害了！';\n    if (this.combo >= 3) return '不错！';\n    return '';\n  }\n\n  getComboEffect() {\n    if (this.combo >= 10) return 'fireworks';\n    if (this.combo >= 8) return 'golden';\n    if (this.combo >= 5) return 'shake';\n    if (this.combo >= 3) return 'text';\n    return null;\n  }\n\n  getStarRating(correctCount, totalQuestions) {\n    const rate = correctCount / totalQuestions;\n    if (rate >= 0.9) return 3;\n    if (rate >= 0.7) return 2;\n    if (rate >= 0.5) return 1;\n    return 0;\n  }\n\n  getStats() {\n    return {\n      score: this.score,\n      combo: this.combo,\n      maxCombo: this.maxCombo,\n      correctCount: this.correctCount,\n      wrongCount: this.wrongCount,\n      totalAnswered: this.correctCount + this.wrongCount\n    };\n  }\n\n  reset() {\n    this.combo = 0;\n    this.maxCombo = 0;\n    this.score = 0;\n    this.correctCount = 0;\n    this.wrongCount = 0;\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { ComboSystem };\n","numLines":103,"startLine":1,"totalLines":103}}}
