],frequency:23},\n{id:\"m097\",idiom:\"一针见血\",chars:[\"一\",\"针\",\"见\",\"血\"],pinyin:\"yī zhēn jiàn xiě\",meaning:\"比喻说话直截了当切中要害\",difficulty:2,category:[\"数字\"],frequency:22},\n{id:\"m098\",idiom:\"欲擒故纵\",chars:[\"欲\",\"擒\",\"故\",\"纵\"],pinyin:\"yù qín gù zòng\",meaning:\"比喻为了更好地控制故意先放松一步\",difficulty:2,category:[\"军事\"],frequency:21},\n{id:\"m099\",idiom:\"一箭双雕\",chars:[\"一\",\"箭\",\"双\",\"雕\"],pinyin:\"yī jiàn shuāng diāo\",meaning:\"比喻做一件事达到两个目的\",difficulty:2,category:[\"动物\",\"数字\"],frequency:20},\n{id:\"m100\",idiom:\"三令五申\",chars:[\"三\",\"令\",\"五\",\"申\"],pinyin:\"sān lìng wǔ shēn\",meaning:\"多次命令和告诫\",difficulty:2,category:[\"数字\"],frequency:19},\n{id:\"m101\",idiom:\"鞠躬尽瘁\",chars:[\"鞠\",\"躬\",\"尽\",\"瘁\"],pinyin:\"jū gōng jìn cuì\",meaning:\"指恭敬谨慎竭尽心力\",difficulty:2,category:[\"人物\"],frequency:18},\n{id:\"m102\",idiom:\"克己奉公\",chars:[\"克\",\"己\",\"奉\",\"公\"],pinyin:\"kè jǐ fèng gōng\",meaning:\"严格要求自己一心为公\",difficulty:2,category:[\"人物\"],frequency:17},\n{id:\"m103\",idiom:\"两袖清风\",chars:[\"两\",\"袖\",\"清\",\"风\"],pinyin:\"liǎng xiù qīng fēng\",meaning:\"比喻做官廉洁\",difficulty:2,category:[\"数字\",\"人物\"],frequency:16},\n{id:\"m104\",idiom:\"德高望重\",chars:[\"德\",\"高\",\"望\",\"重\"],pinyin:\"dé gāo wàng zhòng\",meaning:\"品德高尚声望很大\",difficulty:2,category:[\"人物\"],frequency:15},\n{id:\"m105\",idiom:\"高瞻远瞩\",chars:[\"高\",\"瞻\",\"远\",\"瞩\"],pinyin:\"gāo zhān yuǎn zhǔ\",meaning:\"站得高看得远比喻眼光远大\",difficulty:2,category:[\"人物\"],frequency:14},\n{id:\"m106\",idiom:\"大智若愚\",chars:[\"大\",\"智\",\"若\",\"愚\"],pinyin:\"dà zhì ruò yú\",meaning:\"某些才智出众的人不露锋芒看来好像愚笨的样子\",difficulty:2,category:[\"人物\"],frequency:13},\n{id:\"m107\",idiom:\"韬光养晦\",chars:[\"韬\",\"光\",\"养\",\"晦\"],pinyin:\"tāo guāng yǎng huì\",meaning:\"比喻隐藏才能不使外露\",difficulty:2,category:[\"人物\"],frequency:12},\n{id:\"m108\",idiom:\"胸有成竹\",chars:[\"胸\",\"有\",\"成\",\"竹\"],pinyin:\"xiōng yǒu chéng zhú\",meaning:\"比喻做事之前已有充分考虑和把握\",difficulty:2,category:[\"自然\"],frequency:11},\n{id:\"m109\",idiom:\"运筹帷幄\",chars:[\"胸\",\"有\",\