{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_1c014580f5e14de3b1ea1494","type":"tool_result","content":"The file D:\\game-projects\\steam-cultivation-factory\\src\\game\\Resources.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"c0e01ba0-5708-46af-9590-e43af2395006","uuid":"9d067436-3230-4630-aa23-fbd4e8d63134","timestamp":"2026-05-23T01:39:32.659Z","tool_use_result":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Resources.ts","oldString":"const RESOURCE_META: Record<string, { name: string; icon: string; color: string }> = {\n  spirit_stone: { name: '灵石', icon: '💎', color: '#7cc8ff' },\n  spirit_grass: { name: '灵草', icon: '🌿', color: '#6adf6a' },\n  spirit_energy: { name: '灵气', icon: '✨', color: '#b480ff' },\n  cultivation: { name: '修为', icon: '⚡', color: '#ffd700' },\n  pill_juling: { name: '聚灵丹', icon: '💊', color: '#ff8c32' },\n  pill_peiyuan: { name: '培元丹', icon: '💊', color: '#ff6699' },\n  pill_ningqi: { name: '凝气丹', icon: '💊', color: '#cc66ff' },\n  spirit_iron: { name: '灵铁', icon: '🔩', color: '#8a8aaa' },\n};","newString":"const RESOURCE_META: Record<string, { name: string; icon: string; color: string }> = {\n  spirit_stone: { name: '灵石', icon: '💎', color: '#7cc8ff' },\n  spirit_grass: { name: '灵草', icon: '🌿', color: '#6adf6a' },\n  spirit_energy: { name: '灵气', icon: '✨', color: '#b480ff' },\n  cultivation: { name: '修为', icon: '⚡', color: '#ffd700' },\n  pill_juling: { name: '聚灵丹', icon: '💊', color: '#ff8c32' },\n  pill_peiyuan: { name: '培元丹', icon: '💊', color: '#ff6699' },\n  pill_ningqi: { name: '凝气丹', icon: '💊', color: '#cc66ff' },\n  pill_zhuji: { name: '筑基丹', icon: '💊', color: '#ffcc00' },\n  pill_jindanyin: { name: '金丹引', icon: '💊', color: '#ff4444' },\n  spirit_iron: { name: '灵铁', icon: '🔩', color: '#8a8aaa' },\n  spirit_wood: { name: '灵木', icon: '🪵', color: '#aa8844' },\n  talisman_paper: { name: '符纸', icon: '📜', color: '#ddcc88' },\n};","originalFile":"// Resources.ts — Resource management with manual collection and display\n\nimport type { GameState, Resources, BuildingInstance } from './GameState';\nimport { addResources, addCultivation, updateBuilding } from './GameState';\nimport type { BuildingDef } from './Building';\n\nexport interface ResourceDisplay {\n  id: string;\n  name: string;\n  amount: number;\n  icon: string;\n  color: string;\n}\n\nconst RESOURCE_META: Record<string, { name: string; icon: string; color: string }> = {\n  spirit_stone: { name: '灵石', icon: '💎', color: '#7cc8ff' },\n  spirit_grass: { name: '灵草', icon: '🌿', color: '#6adf6a' },\n  spirit_energy: { name: '灵气', icon: '✨', color: '#b480ff' },\n  cultivation: { name: '修为', icon: '⚡', color: '#ffd700' },\n  pill_juling: { name: '聚灵丹', icon: '💊', color: '#ff8c32' },\n  pill_peiyuan: { name: '培元丹', icon: '💊', color: '#ff6699' },\n  pill_ningqi: { name: '凝气丹', icon: '💊', color: '#cc66ff' },\n  spirit_iron: { name: '灵铁', icon: '🔩', color: '#8a8aaa' },\n};\n\nexport function getResourceDisplays(resources: Resources): ResourceDisplay[] {\n  const displays: ResourceDisplay[] = [];\n  for (const [id, meta] of Object.entries(RESOURCE_META)) {\n    displays.push({\n      id,\n      name: meta.name,\n      amount: resources[id as keyof Resources] ?? 0,\n      icon: meta.icon,\n      color: meta.color,\n    });\n  }\n  return displays;\n}\n\n// Manual collection: player clicks a building to collect\nexport function collectFromBuilding(\n  state: GameState,\n  building: BuildingInstance,\n  def: BuildingDef,\n  mapIndex: number,\n): GameState {\n  if (def.production.mode !== 'manual') return state;\n\n  const prod = def.production;\n\n  // Check if we need input resources\n  if (prod.input) {\n    const canAfford = Object.entries(prod.input).every(\n      ([res, cost]) => (state.resources[res as keyof Resources] ?? 0) >= cost,\n    );\n    if (!canAfford) return state;\n\n    // Consume input resources\n    const inputDelta: Partial<Resources> = {};\n    for (const [res, cost] of Object.entries(prod.input)) {\n      (inputDelta as Record<string, number>)[res] = -cost;\n    }\n    state = addResources(state, inputDelta);\n  }\n\n  // For fields, check if ready for harvest\n  if (def.category === 'farming') {\n    if (building.progress < 1) return state;\n    // Reset progress after harvest\n    state = updateBuilding(state, mapIndex, building.uid, {\n      progress: 0,\n      isProducing: false,\n    });\n  }\n\n  // Add produced resource\n  const delta: Partial<Resources> = {};\n  (delta as Record<string, number>)[prod.resource] = prod.amount;\n  state = addResources(state, delta);\n\n  // Cultivation gives exp\n  if (prod.resource === 'cultivation') {\n    state = addCultivation(state, prod.amount);\n  }\n\n  return state;\n}\n\n// Plant a field (starts growth timer)\nexport function plantField(\n  state: GameState,\n  building: BuildingInstance,\n  mapIndex: number,\n): GameState {\n  return updateBuilding(state, mapIndex, building.uid, {\n    isProducing: true,\n    progress: 0,\n    lastCollectTime: Date.now(),\n  });\n}\n\n// Update auto-production buildings (called every tick)\nexport function tickAutoProduction(\n  state: GameState,\n  mapIndex: number,\n  now: number,\n  buildingDefs: Map<string, BuildingDef>,\n): GameState {\n  const map = state.maps[mapIndex];\n  if (!map) return state;\n\n  for (const building of map.buildings) {\n    const def = buildingDefs.get(building.buildingId);\n    if (!def || def.production.mode !== 'auto') continue;\n\n    if (!building.isProducing) {\n      // Start production\n      state = updateBuilding(state, mapIndex, building.uid, {\n        isProducing: true,\n        lastCollectTime: now,\n        progress: 0,\n      });\n      continue;\n    }\n\n    const elapsed = now - building.lastCollectTime;\n    const interval = def.production.interval;\n    const progress = Math.min(1, elapsed / interval);\n\n    if (progress >= 1) {\n      // Production complete — collect and restart\n      const delta: Partial<Resources> = {};\n      (delta as Record<string, number>)[def.production.resource] = def.production.amount;\n      state = addResources(state, delta);\n\n      state = updateBuilding(state, mapIndex, building.uid, {\n        lastCollectTime: now,\n        progress: 0,\n      });\n    } else {\n      state = updateBuilding(state, mapIndex, building.uid, { progress });\n    }\n  }\n\n  return state;\n}\n\n// Tick manual buildings (e.g. field growth)\nexport function tickManualProduction(\n  state: GameState,\n  mapIndex: number,\n  now: number,\n  buildingDefs: Map<string, BuildingDef>,\n): GameState {\n  const map = state.maps[mapIndex];\n  if (!map) return state;\n\n  for (const building of map.buildings) {\n    const def = buildingDefs.get(building.buildingId);\n    if (!def || def.production.mode !== 'manual') continue;\n    if (!building.isProducing) continue;\n\n    const elapsed = now - building.lastCollectTime;\n    const interval = def.production.interval;\n    const progress = Math.min(1, elapsed / interval);\n\n    state = updateBuilding(state, mapIndex, building.uid, { progress });\n  }\n\n  return state;\n}\n\n// Format resource amounts for display (e.g. 1200 → \"1.2K\")\nexport function formatAmount(amount: number): string {\n  if (amount >= 1_000_000) return (amount / 1_000_000).toFixed(1) + 'M';\n  if (amount >= 10_000) return (amount / 1_000).toFixed(1) + 'K';\n  if (amount >= 1_000) return (amount / 1_000).toFixed(1) + 'K';\n  return Math.floor(amount).toString();\n}\n\n// Check if player can afford a cost\nexport function canAfford(resources: Resources, cost: Record<string, number>): boolean {\n  return Object.entries(cost).every(\n    ([res, amount]) => (resources[res as keyof Resources] ?? 0) >= amount,\n  );\n}\n\n// Deduct cost from resources\nexport function deductCost(state: GameState, cost: Record<string, number>): GameState {\n  const delta: Partial<Resources> = {};\n  for (const [res, amount] of Object.entries(cost)) {\n    (delta as Record<string, number>)[res] = -amount;\n  }\n  return addResources(state, delta);\n}\n","structuredPatch":[{"oldStart":20,"oldLines":7,"newStart":20,"newLines":11,"lines":["   pill_juling: { name: '聚灵丹', icon: '💊', color: '#ff8c32' },","   pill_peiyuan: { name: '培元丹', icon: '💊', color: '#ff6699' },","   pill_ningqi: { name: '凝气丹', icon: '💊', color: '#cc66ff' },","+  pill_zhuji: { name: '筑基丹', icon: '💊', color: '#ffcc00' },","+  pill_jindanyin: { name: '金丹引', icon: '💊', color: '#ff4444' },","   spirit_iron: { name: '灵铁', icon: '🔩', color: '#8a8aaa' },","+  spirit_wood: { name: '灵木', icon: '🪵', color: '#aa8844' },","+  talisman_paper: { name: '符纸', icon: '📜', color: '#ddcc88' },"," };"," "," export function getResourceDisplays(resources: Resources): ResourceDisplay[] {"]}],"userModified":false,"replaceAll":false}}
