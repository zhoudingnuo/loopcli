= game.data.collectedIdioms.includes(i.id);","+      detail.style.display = 'block';","+      detail.innerHTML = `","+        <div class=\"detail-header\">","+          <h3>${collected ? i.idiom : '？？？？'}</h3>","+          <button class=\"btn-back\" onclick=\"game.collection.selectIdiom(null)\">✕</button>","+        </div>","+        ${collected ? `","+          <p class=\"detail-pinyin\">${i.pinyin || ''}</p>","+          <p class=\"detail-meaning\">${i.meaning}</p>","+          ${i.origin ? `<p class=\"detail-origin\">出处：${i.origin}</p>` : ''}","+          ${i.example ? `<p class=\"detail-example\">例句：${i.example}</p>` : ''}","+        ` : '<p class=\"detail-locked\">收集此成语后可查看详情</p>'}","+      `;","+    } else {","+      detail.style.display = 'none';","+    }","+  }","+}","+","+// ===== W2: Daily =====","+function renderDaily(game) {","+  showScreen('daily-screen');","+  const ds = game.daily.getDailyState();","+","+  document.getElementById('daily-streak').textContent = ds.loginStreak;","+  document.getElementById('daily-claimed').textContent = ds.todayClaimed ? '已领取' : '未领取';","+  document.getElementById('daily-claim-btn').disabled = ds.todayClaimed;","+  document.getElementById('daily-claim-btn').textContent = ds.todayClaimed ? '已领取 ✓' : `领取签到奖励 (×${Math.min(ds.loginStreak, 7)}0🪙)`;","+","+  // Tasks","+  const tasksEl = document.getElementById('daily-tasks');","+  if (tasksEl) {","+    tasksEl.innerHTML = ds.tasks.map(t => `","+      <div class=\"task-item${t.claimed ? ' done' : ''}\">","+        <span class=\"task-desc\">${t.desc}</span>","+        <span class=\"task-progress\">${t.progress}/${t.target}</span>","+        <button class=\"task-btn${t.claimed ? ' claimed' : ''}\"","+          ${t.claimed || t.progress < t.target ? 'disabled' : ''}","+          onclick=\"handleClaimTask('${t.id}')\">","+          ${t.claimed ? '已领' : `${t.reward}🪙`}","+        </button>","+      </div>","+    `).join('');","+  }","+","+  // Challenge","+  const challengeEl = document.getElementById('daily-challenge');","+  if (challengeEl) {","+    if (ds.challengeIdiom) {","+      challengeEl.innerHTML = `","+        <div class=\"challenge-card${ds.challengeCompleted ? ' done' : ''}\">","+          <h4>今日成语挑战</h4>","+          <p class=\"challenge-meaning\">${ds.challengeIdiom.meaning}</p>","+          <p class=\"challenge-hint\">${ds.challengeCompleted ? `答案：${ds.challengeIdiom.idiom}` : '提示：' + ds.challengeIdiom.chars[0] + '？？？'}</p>","+          ${ds.challengeCompleted ?","+            '<span class=\"challenge-done\">已完成 ✓ +50🪙</span>' :","+            `<button class=\"btn btn-primary btn-sm\" onclick=\"handleDailyChallenge()\">挑战</button>`","+          }","+        </div>","+      `;","+    }","+  }","+}","+","+// ===== W2: PK =====","+function renderPK(game) {","+  showScreen('pk-screen');","+  const pk = game.pk;","+  const q = pk.currentQ;","+  if (!q) return;","+","+  document.getElementById('pk-progress').textContent = `${pk.currentIndex + 1}/5`;","+","+  const mt = document.getElementById('pk-meaning');","+  if (mt) mt.textContent = q.idiom.meaning;","+","+  const sc = document.getElementById('pk-slots');","+  if (sc) {","+    sc.innerHTML = '';","+    const slots = pk.judge.getSlots();","+    for (let i = 0; i < 4; i++) {","+      const slot = document.createElement('div');","+      slot.className = 'slot';","+      if (slots[i]) { slot.classList.add('filled'); slot.textContent = slots[i].char; slot.onclick = () => pk.removeSlot(i); }","+      if (q.answered && q.correct === true) slot.classList.add('correct');","+      if (q.answered && q.correct === false) slot.classList.add('wrong');","+      sc.appendChild(slot);","+    }","+  }","+","+  const cc = document.getElementById('pk-candidates');","+  if (cc) {","+    cc.innerHTML = '';","+    q.candidates.forEach((c, i) => {","+      const btn = document.createElement('button');","+      btn.className = 'candidate';","+      btn.textContent = c.char;","+      if (c.used) btn.classList.add('used');","+      if (c.removed) btn.classList.add('removed');","+      if (!c.used && !c.removed && !q.answered) btn.onclick = () => pk.pickChar(i);","+      cc.appendChild(btn);","+    });","+  }","+}","+","+function renderPKResult(game) {","+  showScreen('pk-result-screen');","+  const r = game.pk.getResult();","+  document.getElementById('pkr-result').textContent = r.won ? '🎉 胜利！' : '😢 惜败';","+  document.getElementById('pkr-correct').textContent = `${r.correctCount}/5`;","+  document.getElementById('pkr-time').textContent = `${(r.time / 1000).toFixed(1)}s`;","+  document.getElementById('pkr-reward').textContent = r.won ? '+50🪙' : '';","+","+  // Answers review","+  const answersEl = document.getElementById('pkr-answers');","+  if (answersEl) {","+    answersEl.innerHTML = r.answers.map((a, i) =>","+      `<div class=\"answer-item${a.correct ? ' correct' : ' wrong'}\">${i+1}. ${a.idiom} ${a.correct ? '✓' : '✗'}</div>`","+    ).join('');","+  }","+}","+","+// ===== W2: Characters =====","+function renderCharacters(game) {","+  showScreen('characters-screen');","+  const chars = game.characters.getAll();","+","+  const grid = document.getElementById('char-grid');","+  if (grid) {","+    grid.innerHTML = chars.map(c => {","+      const selected = game.data.data.characters.current === c.id;","+      return `","+        <div class=\"char-card${selected ? ' selected' : ''}${!c.unlocked ? ' locked' : ''}\"","+             onclick=\"${c.unlocked ? `game.characters.select('${c.id}'); game.render()` : ''}\">","+          <div class=\"char-avatar\">${c.unlocked ? c.avatar : '🔒'}</div>","+          <div class=\"char-name\">${c.name}</div>","+          <div class=\"char-skill\">${c.unlocked ? c.skill.name : `通关第${c.unlock.level || '?'}关解锁`}</div>","+          ${selected ? '<div class=\"char-badge\">使用中</div>' : ''}","+        </div>","+      `;","+    }).join('');","+  }","+","+  // Skill detail","+  const current = game.characters.getCurrent();","+  const detail = document.getElementById('char-detail');","+  if (detail) {","+    detail.innerHTML = `","+      <h4>${current.avatar} ${current.name}</h4>","+      <p class=\"skill-name\">${current.skill.name}</p>","+      <p class=\"skill-desc\">${current.skill.desc}</p>","+    `;","+  }","+}","+","+// ===== Global handlers =====","+function handleCategoryFilter(cat) {","+  if (cat === '全部') { game.collection.clearFilter(); }","+  else { game.collection.filterByCategory(cat); }","+  game.render();","+}","+","+function handleIdiomSelect(id) { game.collection.selectIdiom(id); game.render(); }","+","+function handleClaimTask(taskId) { game.daily.claimTask(taskId); game.render(); }","+","+function handleDailyChallenge() {","+  const ds = game.daily.getDailyState();","+  if (ds.challengeIdiom && !ds.challengeCompleted) {","+    game.daily.completeChallenge();","+    game.render();","+  }","+}","+","+function handleColSearch(val) { game.collection.search(val); game.render(); }"]}],"originalFile":"// Renderer.js — UI rendering\n\nfunction renderUI(game) {\n  const screens = ['menu-screen', 'map-screen', 'game-screen', 'result-screen'];\n  screens.forEach(id => {\n    const el = document.getElementById(id);\n    if (el) el.classList.remove('active');\n  });\n\n  switch (game.state) {\n    case 'menu': renderMenu(game); break;\n    case 'map': renderMap(game); break;\n    case 'playing': renderGame(game); break;\n    case 'result': renderResult(game); break;\n  }\n}\n\nfunction showScreen(id) {\n  const el = document.getElementById(id);\n  if (el) el.classList.add('active');\n}\n\nfunction renderMenu(game) {\n  showScreen('menu-screen');\n  const mc = document.getElementById('menu-coins');\n  const mcl = document.getElementById('menu-collected');\n  if (mc) mc.textContent = game.data.coins;\n  if (mcl) mcl.textContent = game.data.collectedCount;\n}\n\nfunction renderMap(game) {\n  showScreen('map-screen');\n  const mc = document.getElementById('map-coins');\n  if (mc) mc.textContent = game.data.coins;\n\n  const grid = document.getElementById('level-grid');\n  if (!grid) return;\n  grid.innerHTML = '';\n\n  const chapters = {};\n  LEVELS.forEach(l => {\n    if (!chapters[l.chapter]) chapters[l.chapter] = [];\n    chapters[l.chapter].push(l);\n  });\n\n  const chapInfo = document.getElementById('chapter-info');\n  if (chapInfo && CHAPTERS.length > 0) {\n    chapInfo.innerHTML = CHAPTERS.map(c =>\n      `<div class=\"chapter-badge\" style=\"background:${c.color}\">${c.name} · ${c.subtitle}</div>`\n    ).join('');\n  }\n\n  Object.keys(chapters).forEach(chId => {\n    const section = document.createElement('div');\n    section.className = 'chapter-section';\n    const chap = CHAPTERS.find(c => c.id === parseInt(chId));\n    if (chap) section.style.borderColor = chap.color;\n\n    chapters[chId].forEach(level => {\n      const btn = document.createElement('button');\n      const stars = game.data.getLevelStars(level.id);\n      const unlocked = level.id <= game.data.unlockedLevel;\n      const isBoss = level.boss;\n\n      btn.className = 'level-btn' + (isBoss ? ' boss' : '') + (!unlocked ? ' locked' : '') + (stars > 0 ? ' completed' : '');\n      btn.innerHTML = `\n        <span class=\"level-num\">${level.id}</span>\n        <span class=\"level-stars\">${'★'.repeat(stars)}${'☆'.repeat(3 - stars)}</span>\n        <span class=\"level-name\">${level.name}</span>\n      `;\n\n      if (unlocked) {\n        btn.onclick = () => game.startLevel(level.id);\n      }\n      section.appendChild(btn);\n    });\n    grid.appendChild(section);\n  });\n}\n\nfunction renderGame(game) {\n  showScreen('game-screen');\n  const q = game.getCurrentQuestion();\n  if (!q) return;\n\n  // Header\n  const ll = document.getElementById('level-label');\n  const pl = document.getElementById('progress-label');\n  const ld = document.getElementById('lives-display');\n  if (ll) ll.textContent = `第${game.currentLevel.id}关`;\n  if (pl) pl.textContent = `${game.questionIndex + 1}/${game.questions.length}`;\n  if (ld) ld.textContent = '❤️'.repeat(Math.max(0, game.lives));\n\n  // Meaning\n  const mt = document.getElementById('meaning-text');\n  if (mt) mt.textContent = q.idiom.meaning;\n\n  // Combo display\n  const cd = document.getElementById('combo-display');\n  if (cd) {\n    if (game.combo.combo >= 3) {\n      cd.textContent = `🔥 ${game.combo.combo}连击！${game.combo.getComboMessage()}`;\n      cd.style.display = 'block';\n      cd.className = 'combo-display combo-' + Math.min(game.combo.combo, 10);\n    } else {\n      cd.style.display = 'none';\n    }\n  }\n\n  // Slots\n  const sc = document.getElementById('slots-container');\n  if (sc) {\n    sc.innerHTML = '';\n    const slots = game.judge.getSlots();\n    for (let i = 0; i < 4; i++) {\n      const slot = document.createElement('div');\n      slot.className = 'slot';\n      if (slots[i]) {\n        slot.classList.add('filled');\n        slot.textContent = slots[i].char;\n        slot.onclick = () => { game.removeSlot(i); };\n      }\n      if (q.answered && q.correct === true) slot.classList.add('correct');\n      if (q.answered && q.correct === false) slot.classList.add('wrong');\n      sc.appendChild(slot);\n    }\n  }\n\n  // Idiom hint (after correct answer)\n  const ih = document.getElementById('idiom-hint');\n  if (ih) {\n    if (q.answered && q.correct) {\n      ih.innerHTML = `<strong>${q.idiom.idiom}</strong>：${q.idiom.meaning}`;\n      ih.style.display = 'block';\n    } else {\n      ih.style.display = 'none';\n    }\n  }\n\n  // Candidates\n  const cc = document.getElementById('candidates-container');\n  if (cc) {\n    cc.innerHTML = '';\n    q.candidates.forEach((c, i) => {\n      const btn = document.createElement('button');\n      btn.className = 'candidate';\n      btn.textContent = c.char;\n      if (c.used) btn.classList.add('used');\n      if (c.removed) btn.classList.add('removed');\n      if (!c.used && !c.removed && !q.answered) {\n        btn.onclick = () => game.pickChar(i);\n      }\n      cc.appendChild(btn);\n    });\n  }\n\n  // Tutorial overlay\n  const to = document.getElementById('tutorial-overlay');\n  const tt = document.getElementById('tutorial-text');\n  if (to && tt) {\n    const step = game.tutorial.getCurrentStep();\n    if (step) {\n      tt.textContent = step.msg;\n      to.style.display = 'flex';\n    } else {\n      to.style.display = 'none';\n    }\n  }\n}\n\nfunction renderResult(game) {\n  showScreen('result-screen');\n  const r = game.levelResult;\n  if (!r) return;\n\n  const rt = document.getElementById('result-title');\n  if (rt) rt.textContent = r.stars > 0 ? '🎉 通关!' : '😞 失败';\n\n  const rs = document.getElementById('result-stars');\n  if (rs) rs.innerHTML = '★'.repeat(r.stars) + '☆'.repeat(3 - r.stars);\n\n  const rc = document.getElementById('result-correct');\n  const rto = document.getElementById('result-total');\n  const rsc = document.getElementById('result-score');\n  const rco = document.getElementById('result-combo');\n  const rcoins = document.getElementById('result-coins');\n\n  if (rc) rc.textContent = r.correctCount;\n  if (rto) rto.textContent = r.totalQuestions;\n  if (rsc) rsc.textContent = r.score;\n  if (rco) rco.textContent = r.maxCombo;\n  if (rcoins) rcoins.textContent = r.coins;\n\n  const btnNext = document.getElementById('btn-next');\n  if (btnNext) {\n    const nextId = game.currentLevel.id + 1;\n    const hasNext = LEVELS.find(l => l.id === nextId);\n    btnNext.style.display = (r.stars > 0 && hasNext) ? 'inline-block' : 'none';\n  }\n\n  const btnRetry = document.getElementById('btn-retry');\n  if (btnRetry) btnRetry.style.display = r.stars > 0 ? 'none' : 'inline-block';\n}\n","userModified":false}}
