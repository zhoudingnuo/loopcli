{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_3ab62fc14aab48f096f4cf5b","type":"tool_result","content":"1\t// ComboSystem.js — Combo tracking and scoring\n2\t\n3\tclass ComboSystem {\n4\t  constructor() {\n5\t    this.combo = 0;\n6\t    this.maxCombo = 0;\n7\t    this.score = 0;\n8\t    this.correctCount = 0;\n9\t    this.wrongCount = 0;\n10\t  }\n11\t\n12\t  onCorrect(usedHint = false) {\n13\t    this.correctCount++;\n14\t    this.combo++;\n15\t    if (this.combo > this.maxCombo) this.maxCombo = this.combo;\n16\t\n17\t    let baseScore = 100;\n18\t    let comboBonus = 0;\n19\t\n20\t    if (!usedHint) {\n21\t      comboBonus = this.getComboBonus();\n22\t      this.score += baseScore + comboBonus;\n23\t    } else {\n24\t      this.score += baseScore;\n25\t    }\n26\t\n27\t    return {\n28\t      combo: this.combo,\n29\t      score: this.score,\n30\t      baseScore,\n31\t      comboBonus,\n32\t      totalGain: baseScore + comboBonus,\n33\t      message: this.getComboMessage(),\n34\t      effect: this.getComboEffect()\n35\t    };\n36\t  }\n37\t\n38\t  onWrong() {\n39\t    this.wrongCount++;\n40\t    const prevCombo = this.combo;\n41\t    this.combo = 0;\n42\t    return { combo: 0, prevCombo, message: '连击中断' };\n43\t  }\n44\t\n45\t  onSkip() {\n46\t    this.combo = 0;\n47\t    return { combo: 0, message: '跳过本题' };\n48\t  }\n49\t\n50\t  getComboBonus() {\n51\t    if (this.combo < 3) return 0;\n52\t    if (this.combo < 5) return (this.combo - 2) * 20;\n53\t    if (this.combo < 8) return 100 + (this.combo - 5) * 30;\n54\t    if (this.combo < 10) return 200 + (this.combo - 8) * 40;\n55\t    return 300 + (this.combo - 10) * 50;\n56\t  }\n57\t\n58\t  getComboMessage() {\n59\t    if (this.combo >= 10) return '成语大师！！';\n60\t    if (this.combo >= 8) return '学霸！';\n61\t    if (this.combo >= 5) return '厉害了！';\n62\t    if (this.combo >= 3) return '不错！';\n63\t    return '';\n64\t  }\n65\t\n66\t  getComboEffect() {\n67\t    if (this.combo >= 10) return 'fireworks';\n68\t    if (this.combo >= 8) return 'golden';\n69\t    if (this.combo >= 5) return 'shake';\n70\t    if (this.combo >= 3) return 'text';\n71\t    return null;\n72\t  }\n73\t\n74\t  getStarRating(correctCount, totalQuestions) {\n75\t    const rate = correctCount / totalQuestions;\n76\t    if (rate >= 0.9) return 3;\n77\t    if (rate >= 0.7) return 2;\n78\t    if (rate >= 0.5) return 1;\n79\t    return 0;\n80\t  }\n81\t\n82\t  getStats() {\n83\t    return {\n84\t      score: this.score,\n85\t      combo: this.combo,\n86\t      maxCombo: this.maxCombo,\n87\t      correctCount: this.correctCount,\n88\t      wrongCount: this.wrongCount,\n89\t      totalAnswered: this.correctCount + this.wrongCount\n90\t    };\n91\t  }\n92\t\n93\t  reset() {\n94\t    this.combo = 0;\n95\t    this.maxCombo = 0;\n96\t    this.score = 0;\n97\t    this.correctCount = 0;\n98\t    this.wrongCount = 0;\n99\t  }\n100\t}\n101\t\n102\tif (typeof module !== 'undefined') module.exports = { ComboSystem };\n103\t"}]},"parent_tool_use_id":null,"session_id":"3263718e-ff98-4b11-b648-a6d67321903d","uuid":"020953ba-d0e1-4fae-a15c-d722f7a0c7e8","timestamp":"2026-05-23T00:17:00.604Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/src/js/ComboSystem.js","content":"// ComboSystem.js — Combo tracking and scoring\n\nclass ComboSystem {\n  constructor() {\n    this.combo = 0;\n    this.maxCombo = 0;\n    this.score = 0;\n    this.correctCount = 0;\n    this.wrongCount = 0;\n  }\n\n  onCorrect(usedHint = false) {\n    this.correctCount++;\n    this.combo++;\n    if (this.combo > this.maxCombo) this.maxCombo = this.combo;\n\n    let baseScore = 100;\n    let comboBonus = 0;\n\n    if (!usedHint) {\n      comboBonus = this.getComboBonus();\n      this.score += baseScore + comboBonus;\n    } else {\n      this.score += baseScore;\n    }\n\n    return {\n      combo: this.combo,\n      score: this.score,\n      baseScore,\n      comboBonus,\n      totalGain: baseScore + comboBonus,\n      message: this.getComboMessage(),\n      effect: this.getComboEffect()\n    };\n  }\n\n  onWrong() {\n    this.wrongCount++;\n    const prevCombo = this.combo;\n    this.combo = 0;\n    return { combo: 0, prevCombo, message: '连击中断' };\n  }\n\n  onSkip() {\n    this.combo = 0;\n    return { combo: 0, message: '跳过本题' };\n  }\n\n  getComboBonus() {\n    if (this.combo < 3) return 0;\n    if (this.combo < 5) return (this.combo - 2) * 20;\n    if (this.combo < 8) return 100 + (this.combo - 5) * 30;\n    if (this.combo < 10) return 200 + (this.combo - 8) * 40;\n    return 300 + (this.combo - 10) * 50;\n  }\n\n  getComboMessage() {\n    if (this.combo >= 10) return '成语大师！！';\n    if (this.combo >= 8) return '学霸！';\n    if (this.combo >= 5) return '厉害了！';\n    if (this.combo >= 3) return '不错！';\n    return '';\n  }\n\n  getComboEffect() {\n    if (this.combo >= 10) return 'fireworks';\n    if (this.combo >= 8) return 'golden';\n    if (this.combo >= 5) return 'shake';\n    if (this.combo >= 3) return 'text';\n    return null;\n  }\n\n  getStarRating(correctCount, totalQuestions) {\n    const rate = correctCount / totalQuestions;\n    if (rate >= 0.9) return 3;\n    if (rate >= 0.7) return 2;\n    if (rate >= 0.5) return 1;\n    return 0;\n  }\n\n  getStats() {\n    return {\n      score: this.score,\n      combo: this.combo,\n      maxCombo: this.maxCombo,\n      correctCount: this.correctCount,\n      wrongCount: this.wrongCount,\n      totalAnswered: this.correctCount + this.wrongCount\n    };\n  }\n\n  reset() {\n    this.combo = 0;\n    this.maxCombo = 0;\n    this.score = 0;\n    this.correctCount = 0;\n    this.wrongCount = 0;\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { ComboSystem };\n","numLines":103,"startLine":1,"totalLines":103}}}
