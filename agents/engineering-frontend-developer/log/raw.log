{"type":"assistant","message":{"id":"msg_20260523082051a257ecc46f5a4b0f","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_e9195a12f8a64440bd800b9f","name":"Write","input":{"file_path":"D:/game-projects/douyin-idiom/src/js/Renderer.js","content":"// Renderer.js — UI rendering (W2 extended)\n\nfunction renderUI(game) {\n  const screens = ['menu-screen','map-screen','game-screen','result-screen',\n    'timed-screen','timed-result-screen','collection-screen','daily-screen',\n    'pk-screen','pk-result-screen','characters-screen'];\n  screens.forEach(id => {\n    const el = document.getElementById(id);\n    if (el) el.classList.remove('active');\n  });\n\n  switch (game.state) {\n    case 'menu': renderMenu(game); break;\n    case 'map': renderMap(game); break;\n    case 'playing': renderGame(game); break;\n    case 'result': renderResult(game); break;\n    case 'timed': renderTimed(game); break;\n    case 'timed_result': renderTimedResult(game); break;\n    case 'collection': renderCollection(game); break;\n    case 'daily': renderDaily(game); break;\n    case 'pk': renderPK(game); break;\n    case 'pk_result': renderPKResult(game); break;\n    case 'characters': renderCharacters(game); break;\n  }\n}\n\nfunction showScreen(id) {\n  const el = document.getElementById(id);\n  if (el) el.classList.add('active');\n}\n\nfunction renderMenu(game) {\n  showScreen('menu-screen');\n  const mc = document.getElementById('menu-coins');\n  const mcl = document.getElementById('menu-collected');\n  if (mc) mc.textContent = game.data.coins;\n  if (mcl) mcl.textContent = game.data.collectedCount;\n\n  const charAvatar = document.getElementById('menu-avatar');\n  if (charAvatar) {\n    const ch = game.characters.getCurrent();\n    charAvatar.textContent = ch.avatar;\n  }\n}\n\nfunction renderMap(game) {\n  showScreen('map-screen');\n  const mc = document.getElementById('map-coins');\n  if (mc) mc.textContent = game.data.coins;\n\n  const grid = document.getElementById('level-grid');\n  if (!grid) return;\n  grid.innerHTML = '';\n\n  const chapters = {};\n  LEVELS.forEach(l => {\n    if (!chapters[l.chapter]) chapters[l.chapter] = [];\n    chapters[l.chapter].push(l);\n  });\n\n  const chapInfo = document.getElementById('chapter-info');\n  if (chapInfo) {\n    chapInfo.innerHTML = CHAPTERS.map(c =>\n      `<div class=\"chapter-badge\" style=\"background:${c.color};${c.id>=4?'color:#fff':''}\">${c.name} · ${c.subtitle}</div>`\n    ).join('');\n  }\n\n  Object.keys(chapters).forEach(chId => {\n    const section = document.createElement('div');\n    section.className = 'chapter-section';\n    const chap = CHAPTERS.find(c => c.id === parseInt(chId));\n    if (chap) section.style.borderColor = chap.color;\n\n    chapters[chId].forEach(level => {\n      const btn = document.createElement('button');\n      const stars = game.data.getLevelStars(level.id);\n      const unlocked = level.id <= game.data.unlockedLevel;\n      const isBoss = level.boss;\n\n      btn.className = 'level-btn' + (isBoss ? ' boss' : '') + (!unlocked ? ' locked' : '') + (stars > 0 ? ' completed' : '');\n      btn.innerHTML = `\n        <span class=\"level-num\">${level.id}</span>\n        <span class=\"level-stars\">${'★'.repeat(stars)}${'☆'.repeat(3 - stars)}</span>\n        <span class=\"level-name\">${level.name}</span>\n      `;\n\n      if (unlocked) btn.onclick = () => game.startLevel(level.id);\n      section.appendChild(btn);\n    });\n    grid.appendChild(section);\n  });\n}\n\nfunction renderGame(game) {\n  showScreen('game-screen');\n  const q = game.getCurrentQuestion();\n  if (!q) return;\n\n  const ll = document.getElementById('level-label');\n  const pl = document.getElementById('progress-label');\n  const ld = document.getElementById('lives-display');\n  if (ll) ll.textContent = `第${game.currentLevel.id}关`;\n  if (pl) pl.textContent = `${game.questionIndex + 1}/${game.questions.length}`;\n  if (ld) ld.textContent = '❤️'.repeat(Math.max(0, game.lives));\n\n  const mt = document.getElementById('meaning-text');\n  if (mt) mt.textContent = q.idiom.meaning;\n\n  const cd = document.getElementById('combo-display');\n  if (cd) {\n    if (game.combo.combo >= 3) {\n      cd.textContent = `🔥 ${game.combo.combo}连击！${game.combo.getComboMessage()}`;\n      cd.style.display = 'block';\n      cd.className = 'combo-display combo-' + Math.min(game.combo.combo, 10);\n    } else {\n      cd.style.display = 'none';\n    }\n  }\n\n  const sc = document.getElementById('slots-container');\n  if (sc) {\n    sc.innerHTML = '';\n    const slots = game.judge.getSlots();\n    for (let i = 0; i < 4; i++) {\n      const slot = document.createElement('div');\n      slot.className = 'slot';\n      if (slots[i]) {\n        slot.classList.add('filled');\n        slot.textContent = slots[i].char;\n        slot.onclick = () => { game.removeSlot(i); };\n      }\n      if (q.answered && q.correct === true) slot.classList.add('correct');\n      if (q.answered && q.correct === false) slot.classList.add('wrong');\n      sc.appendChild(slot);\n    }\n  }\n\n  const ih = document.getElementById('idiom-hint');\n  if (ih) {\n    if (q.answered && q.correct) {\n      ih.innerHTML = `<strong>${q.idiom.idiom}</strong>：${q.idiom.meaning}`;\n      ih.style.display = 'block';\n    } else {\n      ih.style.display = 'none';\n    }\n  }\n\n  const cc = document.getElementById('candidates-container');\n  if (cc) {\n    cc.innerHTML = '';\n    q.candidates.forEach((c, i) => {\n      const btn = document.createElement('button');\n      btn.className = 'candidate';\n      btn.textContent = c.char;\n      if (c.used) btn.classList.add('used');\n      if (c.removed) btn.classList.add('removed');\n      if (!c.used && !c.removed && !q.answered) btn.onclick = () => game.pickChar(i);\n      cc.appendChild(btn);\n    });\n  }\n\n  const to = document.getElementById('tutorial-overlay');\n  const tt = document.getElementById('tutorial-text');\n  if (to && tt) {\n    const step = game.tutorial.getCurrentStep();\n    if (step) { tt.textContent = step.msg; to.style.display = 'flex'; }\n    else { to.style.display = 'none'; }\n  }\n\n  // Update tool button costs\n  const hintBtns = document.querySelectorAll('.tool-btn');\n  if (hintBtns.length >= 3) {\n    hintBtns[0].textContent = `📖 揭示 (${game.hintRevealCost}🪙)`;\n    hintBtns[1].textContent = `✂️ 去干扰 (${game.hintRemoveCost}🪙)`;\n    hintBtns[2].textContent = `⏭ 跳过 (${game.skipCost}🪙)`;\n  }\n}\n\nfunction renderResult(game) {\n  showScreen('result-screen');\n  const r = game.levelResult;\n  if (!r) return;\n\n  const rt = document.getElementById('result-title');\n  if (rt) rt.textContent = r.stars > 0 ? '🎉 通关!' : '😞 失败';\n\n  const rs = document.getElementById('result-stars');\n  if (rs) rs.innerHTML = '★'.repeat(r.stars) + '☆'.repeat(3 - r.stars);\n\n  document.getElementById('result-correct').textContent = r.correctCount;\n  document.getElementById('result-total').textContent = r.totalQuestions;\n  document.getElementById('result-score').textContent = r.score;\n  document.getElementById('result-combo').textContent = r.maxCombo;\n  document.getElementById('result-coins').textContent = r.coins;\n\n  const btnNext = document.getElementById('btn-next');\n  if (btnNext) {\n    const nextId = game.currentLevel.id + 1;\n    btnNext.style.display = (r.stars > 0 && LEVELS.find(l => l.id === nextId)) ? 'inline-block' : 'none';\n  }\n  const btnRetry = document.getElementById('btn-retry');\n  if (btnRetry) btnRetry.style.display = r.stars > 0 ? 'none' : 'inline-block';\n}\n\n// ===== W2: Timed Challenge =====\nfunction renderTimed(game) {\n  showScreen('timed-screen');\n  const tc = game.timed;\n  const q = tc.currentQ;\n  if (!q) return;\n\n  const timer = document.getElementById('timed-timer');\n  if (timer) {\n    timer.textContent = `${tc.timeLeft}s`;\n    timer.className = 'timer-display' + (tc.timeLeft <= 10 ? ' timer-warning' : '');\n  }\n\n  const score = document.getElementById('timed-score');\n  if (score) score.textContent = tc.score;\n\n  const combo = document.getElementById('timed-combo');\n  if (combo) {\n    if (game.combo.combo >= 3) {\n      combo.textContent = `🔥 ${game.combo.combo}连击！`;\n      combo.style.display = 'block';\n    } else {\n      combo.style.display = 'none';\n    }\n  }\n\n  const mt = document.getElementById('timed-meaning');\n  if (mt) mt.textContent = q.idiom.meaning;\n\n  const sc = document.getElementById('timed-slots');\n  if (sc) {\n    sc.innerHTML = '';\n    const slots = tc.judge.getSlots();\n    for (let i = 0; i < 4; i++) {\n      const slot = document.createElement('div');\n      slot.className = 'slot';\n      if (slots[i]) { slot.classList.add('filled'); slot.textContent = slots[i].char; slot.onclick = () => tc.removeSlot(i); }\n      if (q.answered && q.correct === true) slot.classList.add('correct');\n      if (q.answered && q.correct === false) slot.classList.add('wrong');\n      sc.appendChild(slot);\n    }\n  }\n\n  const cc = document.getElementById('timed-candidates');\n  if (cc) {\n    cc.innerHTML = '';\n    q.candidates.forEach((c, i) => {\n      const btn = document.createElement('button');\n      btn.className = 'candidate';\n      btn.textContent = c.char;\n      if (c.used) btn.classList.add('used');\n      if (c.removed) btn.classList.add('removed');\n      if (!c.used && !c.removed && !q.answered) btn.onclick = () => tc.pickChar(i);\n      cc.appendChild(btn);\n    });\n  }\n}\n\nfunction renderTimedResult(game) {\n  showScreen('timed-result-screen');\n  const r = game.timed.getResult();\n  document.getElementById('tr-score').textContent = r.score;\n  document.getElementById('tr-correct').textContent = r.correctCount;\n  document.getElementById('tr-total').textContent = r.answeredCount;\n  document.getElementById('tr-combo').textContent = r.maxCombo;\n  document.getElementById('tr-coins').textContent = Math.floor(r.score / 10);\n}\n\n// ===== W2: Collection =====\nfunction renderCollection(game) {\n  showScreen('collection-screen');\n  const col = game.collection;\n  const progress = col.getProgress();\n\n  document.getElementById('col-progress').textContent = `${progress.collected}/${progress.total} (${progress.percent}%)`;\n\n  const bar = document.getElementById('col-progress-bar');\n  if (bar) bar.style.width = progress.percent + '%';\n\n  // Categories\n  const catContainer = document.getElementById('col-categories');\n  if (catContainer) {\n    const cats = ['全部', ...col.getCategories()];\n    catContainer.innerHTML = cats.map(c =>\n      `<button class=\"cat-btn${col.selectedCategory === (c === '全部' ? null : c) ? ' active' : ''}\" onclick=\"handleCategoryFilter('${c}')\">${c}</button>`\n    ).join('');\n  }\n\n  // Search\n  const searchInput = document.getElementById('col-search');\n  if (searchInput && searchInput.value !== col.searchQuery) {\n    searchInput.value = col.searchQuery;\n  }\n\n  // Idiom grid\n  const grid = document.getElementById('col-grid');\n  if (grid) {\n    const idioms = col.getFilteredIdioms();\n    grid.innerHTML = idioms.slice(0, 60).map(i =>\n      `<div class=\"idiom-card${i.collected ? ' collected' : ''}\" onclick=\"handleIdiomSelect('${i.id}')\">\n        <span class=\"idiom-text\">${i.collected ? i.idiom : '？？？？'}</span>\n        <span class=\"idiom-cat\">${(i.category || [])[0] || ''}</span>\n      </div>`\n    ).join('');\n    if (idioms.length > 60) {\n      grid.innerHTML += `<div class=\"more-hint\">还有${idioms.length - 60}个...</div>`;\n    }\n  }\n\n  // Detail view\n  const detail = document.getElementById('col-detail');\n  if (detail) {\n    if (col.selectedIdiom) {\n      const i = col.selectedIdiom;\n      const collected = game.data.collectedIdioms.includes(i.id);\n      detail.style.display = 'block';\n      detail.innerHTML = `\n        <div class=\"detail-header\">\n          <h3>${collected ? i.idiom : '？？？？'}</h3>\n          <button class=\"btn-back\" onclick=\"game.collection.selectIdiom(null)\">✕</button>\n        </div>\n        ${collected ? `\n          <p class=\"detail-pinyin\">${i.pinyin || ''}</p>\n          <p class=\"detail-meaning\">${i.meaning}</p>\n          ${i.origin ? `<p class=\"detail-origin\">出处：${i.origin}</p>` : ''}\n          ${i.example ? `<p class=\"detail-example\">例句：${i.example}</p>` : ''}\n        ` : '<p class=\"detail-locked\">收集此成语后可查看详情</p>'}\n      `;\n    } else {\n      detail.style.display = 'none';\n    }\n  }\n}\n\n// ===== W2: Daily =====\nfunction renderDaily(game) {\n  showScreen('daily-screen');\n  const ds = game.daily.getDailyState();\n\n  document.getElementById('daily-streak').textContent = ds.loginStreak;\n  document.getElementById('daily-claimed').textContent = ds.todayClaimed ? '已领取' : '未领取';\n  document.getElementById('daily-claim-btn').disabled = ds.todayClaimed;\n  document.getElementById('daily-claim-btn').textContent = ds.todayClaimed ? '已领取 ✓' : `领取签到奖励 (×${Math.min(ds.loginStreak, 7)}0🪙)`;\n\n  // Tasks\n  const tasksEl = document.getElementById('daily-tasks');\n  if (tasksEl) {\n    tasksEl.innerHTML = ds.tasks.map(t => `\n      <div class=\"task-item${t.claimed ? ' done' : ''}\">\n        <span class=\"task-desc\">${t.desc}</span>\n        <span class=\"task-progress\">${t.progress}/${t.target}</span>\n        <button class=\"task-btn${t.claimed ? ' claimed' : ''}\"\n          ${t.claimed || t.progress < t.target ? 'disabled' : ''}\n          onclick=\"handleClaimTask('${t.id}')\">\n          ${t.claimed ? '已领' : `${t.reward}🪙`}\n        </button>\n      </div>\n    `).join('');\n  }\n\n  // Challenge\n  const challengeEl = document.getElementById('daily-challenge');\n  if (challengeEl) {\n    if (ds.challengeIdiom) {\n      challengeEl.innerHTML = `\n        <div class=\"challenge-card${ds.challengeCompleted ? ' done' : ''}\">\n          <h4>今日成语挑战</h4>\n          <p class=\"challenge-meaning\">${ds.challengeIdiom.meaning}</p>\n          <p class=\"challenge-hint\">${ds.challengeCompleted ? `答案：${ds.challengeIdiom.idiom}` : '提示：' + ds.challengeIdiom.chars[0] + '？？？'}</p>\n          ${ds.challengeCompleted ?\n            '<span class=\"challenge-done\">已完成 ✓ +50🪙</span>' :\n            `<button class=\"btn btn-primary btn-sm\" onclick=\"handleDailyChallenge()\">挑战</button>`\n          }\n        </div>\n      `;\n    }\n  }\n}\n\n// ===== W2: PK =====\nfunction renderPK(game) {\n  showScreen('pk-screen');\n  const pk = game.pk;\n  const q = pk.currentQ;\n  if (!q) return;\n\n  document.getElementById('pk-progress').textContent = `${pk.currentIndex + 1}/5`;\n\n  const mt = document.getElementById('pk-meaning');\n  if (mt) mt.textContent = q.idiom.meaning;\n\n  const sc = document.getElementById('pk-slots');\n  if (sc) {\n    sc.innerHTML = '';\n    const slots = pk.judge.getSlots();\n    for (let i = 0; i < 4; i++) {\n      const slot = document.createElement('div');\n      slot.className = 'slot';\n      if (slots[i]) { slot.classList.add('filled'); slot.textContent = slots[i].char; slot.onclick = () => pk.removeSlot(i); }\n      if (q.answered && q.correct === true) slot.classList.add('correct');\n      if (q.answered && q.correct === false) slot.classList.add('wrong');\n      sc.appendChild(slot);\n    }\n  }\n\n  const cc = document.getElementById('pk-candidates');\n  if (cc) {\n    cc.innerHTML = '';\n    q.candidates.forEach((c, i) => {\n      const btn = document.createElement('button');\n      btn.className = 'candidate';\n      btn.textContent = c.char;\n      if (c.used) btn.classList.add('used');\n      if (c.removed) btn.classList.add('removed');\n      if (!c.used && !c.removed && !q.answered) btn.onclick = () => pk.pickChar(i);\n      cc.appendChild(btn);\n    });\n  }\n}\n\nfunction renderPKResult(game) {\n  showScreen('pk-result-screen');\n  const r = game.pk.getResult();\n  document.getElementById('pkr-result').textContent = r.won ? '🎉 胜利！' : '😢 惜败';\n  document.getElementById('pkr-correct').textContent = `${r.correctCount}/5`;\n  document.getElementById('pkr-time').textContent = `${(r.time / 1000).toFixed(1)}s`;\n  document.getElementById('pkr-reward').textContent = r.won ? '+50🪙' : '';\n\n  // Answers review\n  const answersEl = document.getElementById('pkr-answers');\n  if (answersEl) {\n    answersEl.innerHTML = r.answers.map((a, i) =>\n      `<div class=\"answer-item${a.correct ? ' correct' : ' wrong'}\">${i+1}. ${a.idiom} ${a.correct ? '✓' : '✗'}</div>`\n    ).join('');\n  }\n}\n\n// ===== W2: Characters =====\nfunction renderCharacters(game) {\n  showScreen('characters-screen');\n  const chars = game.characters.getAll();\n\n  const grid = document.getElementById('char-grid');\n  if (grid) {\n    grid.innerHTML = chars.map(c => {\n      const selected = game.data.data.characters.current === c.id;\n      return `\n        <div class=\"char-card${selected ? ' selected' : ''}${!c.unlocked ? ' locked' : ''}\"\n             onclick=\"${c.unlocked ? `game.characters.select('${c.id}'); game.render()` : ''}\">\n          <div class=\"char-avatar\">${c.unlocked ? c.avatar : '🔒'}</div>\n          <div class=\"char-name\">${c.name}</div>\n          <div class=\"char-skill\">${c.unlocked ? c.skill.name : `通关第${c.unlock.level || '?'}关解锁`}</div>\n          ${selected ? '<div class=\"char-badge\">使用中</div>' : ''}\n        </div>\n      `;\n    }).join('');\n  }\n\n  // Skill detail\n  const current = game.characters.getCurrent();\n  const detail = document.getElementById('char-detail');\n  if (detail) {\n    detail.innerHTML = `\n      <h4>${current.avatar} ${current.name}</h4>\n      <p class=\"skill-name\">${current.skill.name}</p>\n      <p class=\"skill-desc\">${current.skill.desc}</p>\n    `;\n  }\n}\n\n// ===== Global handlers =====\nfunction handleCategoryFilter(cat) {\n  if (cat === '全部') { game.collection.clearFilter(); }\n  else { game.collection.filterByCategory(cat); }\n  game.render();\n}\n\nfunction handleIdiomSelect(id) { game.collection.selectIdiom(id); game.render(); }\n\nfunction handleClaimTask(taskId) { game.daily.claimTask(taskId); game.render(); }\n\nfunction handleDailyChallenge() {\n  const ds = game.daily.getDailyState();\n  if (ds.challengeIdiom && !ds.challengeCompleted) {\n    game.daily.completeChallenge();\n    game.render();\n  }\n}\n\nfunction handleColSearch(val) { game.collection.search(val); game.render(); }\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"3263718e-ff98-4b11-b648-a6d67321903d","uuid":"bfaaaf4e-636c-4523-a83f-338b39dae85d"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_e9195a12f8a64440bd800b9f","type":"tool_result","content":"The file D:/game-projects/douyin-idiom/src/js/Renderer.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"3263718e-ff98-4b11-b648-a6d67321903d","uuid":"82f05dac-6129-4595-97b9-9bdbdfe0b203","timestamp":"2026-05-23T00:21:55.706Z","tool_use_result":{"type":"update","filePath":"D:/game-projects/douyin-idiom/src/js/Renderer.js","content":"// Renderer.js — UI rendering (W2 extended)\n\nfunction renderUI(game) {\n  const screens = ['menu-screen','map-screen','game-screen','result-screen',\n    'timed-screen','timed-result-screen','collection-screen','daily-screen',\n    'pk-screen','pk-result-screen','characters-screen'];\n  screens.forEach(id => {\n    const el = document.getElementById(id);\n    if (el) el.classList.remove('active');\n  });\n\n  switch (game.state) {\n    case 'menu': renderMenu(game); break;\n    case 'map': renderMap(game); break;\n    case 'playing': renderGame(game); break;\n    case 'result': renderResult(game); break;\n    case 'timed': renderTimed(game); break;\n    case 'timed_result': renderTimedResult(game); break;\n    case 'collection': renderCollection(game); break;\n    case 'daily': renderDaily(game); break;\n    case 'pk': renderPK(game); break;\n    case 'pk_result': renderPKResult(game); break;\n    case 'characters': renderCharacters(game); break;\n  }\n}\n\nfunction showScreen(id) {\n  const el = document.getElementById(id);\n  if (el) el.classList.add('active');\n}\n\nfunction renderMenu(game) {\n  showScreen('menu-screen');\n  const mc = document.getElementById('menu-coins');\n  const mcl = document.getElementById('menu-collected');\n  if (mc) mc.textContent = game.data.coins;\n  if (mcl) mcl.textContent = game.data.collectedCount;\n\n  const charAvatar = document.getElementById('menu-avatar');\n  if (charAvatar) {\n    const ch = game.characters.getCurrent();\n    charAvatar.textContent = ch.avatar;\n  }\n}\n\nfunction renderMap(game) {\n  showScreen('map-screen');\n  const mc = document.getElementById('map-coins');\n  if (mc) mc.textContent = game.data.coins;\n\n  const grid = document.getElementById('level-grid');\n  if (!grid) return;\n  grid.innerHTML = '';\n\n  const chapters = {};\n  LEVELS.forEach(l => {\n    if (!chapters[l.chapter]) chapters[l.chapter] = [];\n    chapters[l.chapter].push(l);\n  });\n\n  const chapInfo = document.getElementById('chapter-info');\n  if (chapInfo) {\n    chapInfo.innerHTML = CHAPTERS.map(c =>\n      `<div class=\"chapter-badge\" style=\"background:${c.color};${c.id>=4?'color:#fff':''}\">${c.name} · ${c.subtitle}</div>`\n    ).join('');\n  }\n\n  Object.keys(chapters).forEach(chId => {\n    const section = document.createElement('div');\n    section.className = 'chapter-section';\n    const chap = CHAPTERS.find(c => c.id === parseInt(chId));\n    if (chap) section.style.borderColor = chap.color;\n\n    chapters[chId].forEach(level => {\n      const btn = document.createElement('button');\n      const stars = game.data.getLevelStars(level.id);\n      const unlocked = level.id <= game.data.unlockedLevel;\n      const isBoss = level.boss;\n\n      btn.className = 'level-btn' + (isBoss ? ' boss' : '') + (!unlocked ? ' locked' : '') + (stars > 0 ? ' completed' : '');\n      btn.innerHTML = `\n        <span class=\"level-num\">${level.id}</span>\n        <span class=\"level-stars\">${'★'.repeat(stars)}${'☆'.repeat(3 - stars)}</span>\n        <span class=\"level-name\">${level.name}</span>\n      `;\n\n      if (unlocked) btn.onclick = () => game.startLevel(level.id);\n      section.appendChild(btn);\n    });\n    grid.appendChild(section);\n  });\n}\n\nfunction renderGame(game) {\n  showScreen('game-screen');\n  const q = game.getCurrentQuestion();\n  if (!q) return;\n\n  const ll = document.getElementById('level-label');\n  const pl = document.getElementById('progress-label');\n  const ld = document.getElementById('lives-display');\n  if (ll) ll.textContent = `第${game.currentLevel.id}关`;\n  if (pl) pl.textContent = `${game.questionIndex + 1}/${game.questions.length}`;\n  if (ld) ld.textContent = '❤️'.repeat(Math.max(0, game.lives));\n\n  const mt = document.getElementById('meaning-text');\n  if (mt) mt.textContent = q.idiom.meaning;\n\n  const cd = document.getElementById('combo-display');\n  if (cd) {\n    if (game.combo.combo >= 3) {\n      cd.textContent = `🔥 ${game.combo.combo}连击！${game.combo.getComboMessage()}`;\n      cd.style.display = 'block';\n      cd.className = 'combo-display combo-' + Math.min(game.combo.combo, 10);\n    } else {\n      cd.style.display = 'none';\n    }\n  }\n\n  const sc = document.getElementById('slots-container');\n  if (sc) {\n    sc.innerHTML = '';\n    const slots = game.judge.getSlots();\n    for (let i = 0; i < 4; i++) {\n      const slot = document.createElement('div');\n      slot.className = 'slot';\n      if (slots[i]) {\n        slot.classList.add('filled');\n        slot.textContent = slots[i].char;\n        slot.onclick = () => { game.removeSlot(i); };\n      }\n      if (q.answered && q.correct === true) slot.classList.add('correct');\n      if (q.answered && q.correct === false) slot.classList.add('wrong');\n      sc.appendChild(slot);\n    }\n  }\n\n  const ih = document.getElementById('idiom-hint');\n  if (ih) {\n    if (q.answered && q.correct) {\n      ih.innerHTML = `<strong>${q.idiom.idiom}</strong>：${q.idiom.meaning}`;\n      ih.style.display = 'block';\n    } else {\n      ih.style.display = 'none';\n    }\n  }\n\n  const cc = document.getElementById('candidates-container');\n  if (cc) {\n    cc.innerHTML = '';\n    q.candidates.forEach((c, i) => {\n      const btn = document.createElement('button');\n      btn.className = 'candidate';\n      btn.textContent = c.char;\n      if (c.used) btn.classList.add('used');\n      if (c.removed) btn.classList.add('removed');\n      if (!c.used && !c.removed && !q.answered) btn.onclick = () => game.pickChar(i);\n      cc.appendChild(btn);\n    });\n  }\n\n  const to = document.getElementById('tutorial-overlay');\n  const tt = document.getElementById('tutorial-text');\n  if (to && tt) {\n    const step = game.tutorial.getCurrentStep();\n    if (step) { tt.textContent = step.msg; to.style.display = 'flex'; }\n    else { to.style.display = 'none'; }\n  }\n\n  // Update tool button costs\n  const hintBtns = document.querySelectorAll('.tool-btn');\n  if (hintBtns.length >= 3) {\n    hintBtns[0].textContent = `📖 揭示 (${game.hintRevealCost}🪙)`;\n    hintBtns[1].textContent = `✂️ 去干扰 (${game.hintRemoveCost}🪙)`;\n    hintBtns[2].textContent = `⏭ 跳过 (${game.skipCost}🪙)`;\n  }\n}\n\nfunction renderResult(game) {\n  showScreen('result-screen');\n  const r = game.levelResult;\n  if (!r) return;\n\n  const rt = document.getElementById('result-title');\n  if (rt) rt.textContent = r.stars > 0 ? '🎉 通关!' : '😞 失败';\n\n  const rs = document.getElementById('result-stars');\n  if (rs) rs.innerHTML = '★'.repeat(r.stars) + '☆'.repeat(3 - r.stars);\n\n  document.getElementById('result-correct').textContent = r.correctCount;\n  document.getElementById('result-total').textContent = r.totalQuestions;\n  document.getElementById('result-score').textContent = r.score;\n  document.getElementById('result-combo').textContent = r.maxCombo;\n  document.getElementById('result-coins').textContent = r.coins;\n\n  const btnNext = document.getElementById('btn-next');\n  if (btnNext) {\n    const nextId = game.currentLevel.id + 1;\n    btnNext.style.display = (r.stars > 0 && LEVELS.find(l => l.id === nextId)) ? 'inline-block' : 'none';\n  }\n  const btnRetry = document.getElementById('btn-retry');\n  if (btnRetry) btnRetry.style.display = r.stars > 0 ? 'none' : 'inline-block';\n}\n\n// ===== W2: Timed Challenge =====\nfunction renderTimed(game) {\n  showScreen('timed-screen');\n  const tc = game.timed;\n  const q = tc.currentQ;\n  if (!q) return;\n\n  const timer = document.getElementById('timed-timer');\n  if (timer) {\n    timer.textContent = `${tc.timeLeft}s`;\n    timer.className = 'timer-display' + (tc.timeLeft <= 10 ? ' timer-warning' : '');\n  }\n\n  const score = document.getElementById('timed-score');\n  if (score) score.textContent = tc.score;\n\n  const combo = document.getElementById('timed-combo');\n  if (combo) {\n    if (game.combo.combo >= 3) {\n      combo.textContent = `🔥 ${game.combo.combo}连击！`;\n      combo.style.display = 'block';\n    } else {\n      combo.style.display = 'none';\n    }\n  }\n\n  const mt = document.getElementById('timed-meaning');\n  if (mt) mt.textContent = q.idiom.meaning;\n\n  const sc = document.getElementById('timed-slots');\n  if (sc) {\n    sc.innerHTML = '';\n    const slots = tc.judge.getSlots();\n    for (let i = 0; i < 4; i++) {\n      const slot = document.createElement('div');\n      slot.className = 'slot';\n      if (slots[i]) { slot.classList.add('filled'); slot.textContent = slots[i].char; slot.onclick = () => tc.removeSlot(i); }\n      if (q.answered && q.correct === true) slot.classList.add('correct');\n      if (q.answered && q.correct === false) slot.classList.add('wrong');\n      sc.appendChild(slot);\n    }\n  }\n\n  const cc = document.getElementById('timed-candidates');\n  if (cc) {\n    cc.innerHTML = '';\n    q.candidates.forEach((c, i) => {\n      const btn = document.createElement('button');\n      btn.className = 'candidate';\n      btn.textContent = c.char;\n      if (c.used) btn.classList.add('used');\n      if (c.removed) btn.classList.add('removed');\n      if (!c.used && !c.removed && !q.answered) btn.onclick = () => tc.pickChar(i);\n      cc.appendChild(btn);\n    });\n  }\n}\n\nfunction renderTimedResult(game) {\n  showScreen('timed-result-screen');\n  const r = game.timed.getResult();\n  document.getElementById('tr-score').textContent = r.score;\n  document.getElementById('tr-correct').textContent = r.correctCount;\n  document.getElementById('tr-total').textContent = r.answeredCount;\n  document.getElementById('tr-combo').textContent = r.maxCombo;\n  document.getElementById('tr-coins').textContent = Math.floor(r.score / 10);\n}\n\n// ===== W2: Collection =====\nfunction renderCollection(game) {\n  showScreen('collection-screen');\n  const col = game.collection;\n  const progress = col.getProgress();\n\n  document.getElementById('col-progress').textContent = `${progress.collected}/${progress.total} (${progress.percent}%)`;\n\n  const bar = document.getElementById('col-progress-bar');\n  if (bar) bar.style.width = progress.percent + '%';\n\n  // Categories\n  const catContainer = document.getElementById('col-categories');\n  if (catContainer) {\n    const cats = ['全部', ...col.getCategories()];\n    catContainer.innerHTML = cats.map(c =>\n      `<button class=\"cat-btn${col.selectedCategory === (c === '全部' ? null : c) ? ' active' : ''}\" onclick=\"handleCategoryFilter('${c}')\">${c}</button>`\n    ).join('');\n  }\n\n  // Search\n  const searchInput = document.getElementById('col-search');\n  if (searchInput && searchInput.value !== col.searchQuery) {\n    searchInput.value = col.searchQuery;\n  }\n\n  // Idiom grid\n  const grid = document.getElementById('col-grid');\n  if (grid) {\n    const idioms = col.getFilteredIdioms();\n    grid.innerHTML = idioms.slice(0, 60).map(i =>\n      `<div class=\"idiom-card${i.collected ? ' collected' : ''}\" onclick=\"handleIdiomSelect('${i.id}')\">\n        <span class=\"idiom-text\">${i.collected ? i.idiom : '？？？？'}</span>\n        <span class=\"idiom-cat\">${(i.category || [])[0] || ''}</span>\n      </div>`\n    ).join('');\n    if (idioms.length > 60) {\n      grid.innerHTML += `<div class=\"more-hint\">还有${idioms.length - 60}个...</div>`;\n    }\n  }\n\n  // Detail view\n  const detail = document.getElementById('col-detail');\n  if (detail) {\n    if (col.selectedIdiom) {\n      const i = col.selectedIdiom;\n      const collected = game.data.collectedIdioms.includes(i.id);\n      detail.style.display = 'block';\n      detail.innerHTML = `\n        <div class=\"detail-header\">\n          <h3>${collected ? i.idiom : '？？？？'}</h3>\n          <button class=\"btn-back\" onclick=\"game.collection.selectIdiom(null)\">✕</button>\n        </div>\n        ${collected ? `\n          <p class=\"detail-pinyin\">${i.pinyin || ''}</p>\n          <p class=\"detail-meaning\">${i.meaning}</p>\n          ${i.origin ? `<p class=\"detail-origin\">出处：${i.origin}</p>` : ''}\n          ${i.example ? `<p class=\"detail-example\">例句：${i.example}</p>` : ''}\n        ` : '<p class=\"detail-locked\">收集此成语后可查看详情</p>'}\n      `;\n    } else {\n      detail.style.display = 'none';\n    }\n  }\n}\n\n// ===== W2: Daily =====\nfunction renderDaily(game) {\n  showScreen('daily-screen');\n  const ds = game.daily.getDailyState();\n\n  document.getElementById('daily-streak').textContent = ds.loginStreak;\n  document.getElementById('daily-claimed').textContent = ds.todayClaimed ? '已领取' : '未领取';\n  document.getElementById('daily-claim-btn').disabled = ds.todayClaimed;\n  document.getElementById('daily-claim-btn').textContent = ds.todayClaimed ? '已领取 ✓' : `领取签到奖励 (×${Math.min(ds.loginStreak, 7)}0🪙)`;\n\n  // Tasks\n  const tasksEl = document.getElementById('daily-tasks');\n  if (tasksEl) {\n    tasksEl.innerHTML = ds.tasks.map(t => `\n      <div class=\"task-item${t.claimed ? ' done' : ''}\">\n        <span class=\"task-desc\">${t.desc}</span>\n        <span class=\"task-progress\">${t.progress}/${t.target}</span>\n        <button class=\"task-btn${t.claimed ? ' claimed' : ''}\"\n          ${t.claimed || t.progress < t.target ? 'disabled' : ''}\n          onclick=\"handleClaimTask('${t.id}')\">\n          ${t.claimed ? '已领' : `${t.reward}🪙`}\n        </button>\n      </div>\n    `).join('');\n  }\n\n  // Challenge\n  const challengeEl = document.getElementById('daily-challenge');\n  if (challengeEl) {\n    if (ds.challengeIdiom) {\n      challengeEl.innerHTML = `\n        <div class=\"challenge-card${ds.challengeCompleted ? ' done' : ''}\">\n          <h4>今日成语挑战</h4>\n          <p class=\"challenge-meaning\">${ds.challengeIdiom.meaning}</p>\n          <p class=\"challenge-hint\">${ds.challengeCompleted ? `答案：${ds.challengeIdiom.idiom}` : '提示：' + ds.challengeIdiom.chars[0] + '？？？'}</p>\n          ${ds.challengeCompleted ?\n            '<span class=\"challenge-done\">已完成 ✓ +50🪙</span>' :\n            `<button class=\"btn btn-primary btn-sm\" onclick=\"handleDailyChallenge()\">挑战</button>`\n          }\n        </div>\n      `;\n    }\n  }\n}\n\n// ===== W2: PK =====\nfunction renderPK(game) {\n  showScreen('pk-screen');\n  const pk = game.pk;\n  const q = pk.currentQ;\n  if (!q) return;\n\n  document.getElementById('pk-progress').textContent = `${pk.currentIndex + 1}/5`;\n\n  const mt = document.getElementById('pk-meaning');\n  if (mt) mt.textContent = q.idiom.meaning;\n\n  const sc = document.getElementById('pk-slots');\n  if (sc) {\n    sc.innerHTML = '';\n    const slots = pk.judge.getSlots();\n    for (let i = 0; i < 4; i++) {\n      const slot = document.createElement('div');\n      slot.className = 'slot';\n      if (slots[i]) { slot.classList.add('filled'); slot.textContent = slots[i].char; slot.onclick = () => pk.removeSlot(i); }\n      if (q.answered && q.correct === true) slot.classList.add('correct');\n      if (q.answered && q.correct === false) slot.classList.add('wrong');\n      sc.appendChild(slot);\n    }\n  }\n\n  const cc = document.getElementById('pk-candidates');\n  if (cc) {\n    cc.innerHTML = '';\n    q.candidates.forEach((c, i) => {\n      const btn = document.createElement('button');\n      btn.className = 'candidate';\n      btn.textContent = c.char;\n      if (c.used) btn.classList.add('used');\n      if (c.removed) btn.classList.add('removed');\n      if (!c.used && !c.removed && !q.answered) btn.onclick = () => pk.pickChar(i);\n      cc.appendChild(btn);\n    });\n  }\n}\n\nfunction renderPKResult(game) {\n  showScreen('pk-result-screen');\n  const r = game.pk.getResult();\n  document.getElementById('pkr-result').textContent = r.won ? '🎉 胜利！' : '😢 惜败';\n  document.getElementById('pkr-correct').textContent = `${r.correctCount}/5`;\n  document.getElementById('pkr-time').textContent = `${(r.time / 1000).toFixed(1)}s`;\n  document.getElementById('pkr-reward').textContent = r.won ? '+50🪙' : '';\n\n  // Answers review\n  const answersEl = document.getElementById('pkr-answers');\n  if (answersEl) {\n    answersEl.innerHTML = r.answers.map((a, i) =>\n      `<div class=\"answer-item${a.correct ? ' correct' : ' wrong'}\">${i+1}. ${a.idiom} ${a.correct ? '✓' : '✗'}</div>`\n    ).join('');\n  }\n}\n\n// ===== W2: Characters =====\nfunction renderCharacters(game) {\n  showScreen('characters-screen');\n  const chars = game.characters.getAll();\n\n  const grid = document.getElementById('char-grid');\n  if (grid) {\n    grid.innerHTML = chars.map(c => {\n      const selected = game.data.data.characters.current === c.id;\n      return `\n        <div class=\"char-card${selected ? ' selected' : ''}${!c.unlocked ? ' locked' : ''}\"\n             onclick=\"${c.unlocked ? `game.characters.select('${c.id}'); game.render()` : ''}\">\n          <div class=\"char-avatar\">${c.unlocked ? c.avatar : '🔒'}</div>\n          <div class=\"char-name\">${c.name}</div>\n          <div class=\"char-skill\">${c.unlocked ? c.skill.name : `通关第${c.unlock.level || '?'}关解锁`}</div>\n          ${selected ? '<div class=\"char-badge\">使用中</div>' : ''}\n        </div>\n      `;\n    }).join('');\n  }\n\n  // Skill detail\n  const current = game.characters.getCurrent();\n  const detail = document.getElementById('char-detail');\n  if (detail) {\n    detail.innerHTML = `\n      <h4>${current.avatar} ${current.name}</h4>\n      <p class=\"skill-name\">${current.skill.name}</p>\n      <p class=\"skill-desc\">${current.skill.desc}</p>\n    `;\n  }\n}\n\n// ===== Global handlers =====\nfunction handleCategoryFilter(cat) {\n  if (cat === '全部') { game.collection.clearFilter(); }\n  else { game.collection.filterByCategory(cat); }\n  game.render();\n}\n\nfunction handleIdiomSelect(id) { game.collection.selectIdiom(id); game.render(); }\n\nfunction handleClaimTask(taskId) { game.daily.claimTask(taskId); game.render(); }\n\nfunction handleDailyChallenge() {\n  const ds = game.daily.getDailyState();\n  if (ds.challengeIdiom && !ds.challengeCompleted) {\n    game.daily.completeChallenge();\n    game.render();\n  }\n}\n\nfunction handleColSearch(val) { game.collection.search(val); game.render(); }\n","structuredPatch":[{"oldStart":1,"oldLines":7,"newStart":1,"newLines":9,"lines":["-// Renderer.js — UI rendering","+// Renderer.js — UI rendering (W2 extended)"," "," function renderUI(game) {","-  const screens = ['menu-screen', 'map-screen', 'game-screen', 'result-screen'];","+  const screens = ['menu-screen','map-screen','game-screen','result-screen',","+    'timed-screen','timed-result-screen','collection-screen','daily-screen',","+    'pk-screen','pk-result-screen','characters-screen'];","   screens.forEach(id => {","     const el = document.getElementById(id);","     if (el) el.classList.remove('active');"]},{"oldStart":12,"oldLines":6,"newStart":14,"newLines":13,"lines":["     case 'map': renderMap(game); break;","     case 'playing': renderGame(game); break;","     case 'result': renderResult(game); break;","+    case 'timed': renderTimed(game); break;","+    case 'timed_result': renderTimedResult(game); break;","+    case 'collection': renderCollection(game); break;","+    case 'daily': renderDaily(game); break;","+    case 'pk': renderPK(game); break;","+    case 'pk_result': renderPKResult(game); break;","+    case 'characters': renderCharacters(game); break;","   }"," }"," "]},{"oldStart":26,"oldLines":6,"newStart":35,"newLines":12,"lines":["   const mcl = document.getElementById('menu-collected');","   if (mc) mc.textContent = gam