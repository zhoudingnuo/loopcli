{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f82e05744b6149589b26d1f5","type":"tool_result","content":"1\t// ScoreSystem.js — Score, moves, goals (score/collect_color/clear_obstacle/boss/dual), stars\n2\t\n3\tclass ScoreSystem {\n4\t  constructor() {\n5\t    this.score = 0;\n6\t    this.moves = 0;\n7\t    this.maxMoves = 30;\n8\t    this.goalType = 'score';\n9\t    this.goalTarget = 1000;\n10\t    this.goalProgress = 0;\n11\t    this.level = 1;\n12\t    this.stars = [0, 0, 0];\n13\t    this.collected = {};\n14\t    this.obstaclesCleared = {};\n15\t    this.totalObstaclesCleared = 0;\n16\t    this.chainCount = 0;\n17\t    this.config = null;\n18\t\n19\t    // Dual goal support\n20\t    this.dualGoals = [];\n21\t\n22\t    // Collect_color specifics\n23\t    this.collectColors = [];\n24\t\n25\t    // Clear_obstacle specifics\n26\t    this.clearObstacleType = 0;\n27\t\n28\t    this.onScoreChange = null;\n29\t    this.onMovesChange = null;\n30\t    this.onLevelComplete = null;\n31\t    this.onLevelFail = null;\n32\t  }\n33\t\n34\t  reset(level = 1) {\n35\t    this.score = 0;\n36\t    this.moves = 0;\n37\t    this.goalProgress = 0;\n38\t    this.chainCount = 0;\n39\t    this.collected = {};\n40\t    this.obstaclesCleared = {};\n41\t    this.totalObstaclesCleared = 0;\n42\t    this.dualGoals = [];\n43\t    this.collectColors = [];\n44\t    this.clearObstacleType = 0;\n45\t    this.level = level;\n46\t  }\n47\t\n48\t  configure(config) {\n49\t    this.config = config;\n50\t    this.maxMoves = config.moves || 30;\n51\t    this.goalType = config.goal?.type || 'score';\n52\t    this.goalTarget = config.goal?.target || 1000;\n53\t    this.stars = config.stars || [1000, 1500, 2000];\n54\t\n55\t    if (this.goalType === 'collect_color') {\n56\t      this.collectColors = config.goal?.colors || [];\n57\t    } else if (this.goalType === 'clear_obstacle') {\n58\t      this.clearObstacleType = config.goal?.obstacleType || 0;\n59\t    } else if (this.goalType === 'dual') {\n60\t      this.dualGoals = (config.goal?.goals || []).map(g => ({\n61\t        type: g.type,\n62\t        target: g.target,\n63\t        progress: 0,\n64\t        colors: g.colors || [],\n65\t        obstacleType: g.obstacleType || 0,\n66\t      }));\n67\t    }\n68\t  }\n69\t\n70\t  useMove() {\n71\t    this.moves++;\n72\t    if (this.onMovesChange) this.onMovesChange(this.getRemainingMoves());\n73\t    return this.getRemainingMoves() >= 0;\n74\t  }\n75\t\n76\t  getRemainingMoves() {\n77\t    return this.maxMoves - this.moves;\n78\t  }\n79\t\n80\t  addScore(points) {\n81\t    this.score += points;\n82\t    if (this.goalType === 'score') {\n83\t      this.goalProgress = this.score;\n84\t    }\n85\t    // Update dual score goals\n86\t    for (const dg of this.dualGoals) {\n87\t      if (dg.type === 'score') dg.progress = this.score;\n88\t    }\n89\t    if (this.onScoreChange) this.onScoreChange(this.score);\n90\t  }\n91\t\n92\t  addChainScore(basePoints, chainLevel) {\n93\t    const multiplier = chainLevel <= 1 ? 1 : chainLevel === 2 ? 1.5 : chainLevel === 3 ? 2.0 : 2.5;\n94\t    const points = Math.floor(basePoints * multiplier);\n95\t    this.addScore(points);\n96\t    this.chainCount = Math.max(this.chainCount, chainLevel);\n97\t    return points;\n98\t  }\n99\t\n100\t  addCollected(color, count) {\n101\t    this.collected[color] = (this.collected[color] || 0) + count;\n102\t    this._updateCollectProgress();\n103\t  }\n104\t\n105\t  _updateCollectProgress() {\n106\t    if (this.goalType === 'collect_color') {\n107\t      let total = 0;\n108\t      for (const c of this.collectColors) {\n109\t        total += this.collected[c] || 0;\n110\t      }\n111\t      this.goalProgress = total;\n112\t    }\n113\t    for (const dg of this.dualGoals) {\n114\t      if (dg.type === 'collect_color') {\n115\t        let total = 0;\n116\t        for (const c of dg.colors) {\n117\t          total += this.collected[c] || 0;\n118\t        }\n119\t        dg.progress = total;\n120\t      }\n121\t    }\n122\t  }\n123\t\n124\t  addObstacleCleared(type) {\n125\t    if (!this.obstaclesCleared[type]) this.obstaclesCleared[type] = 0;\n126\t    this.obstaclesCleared[type]++;\n127\t    this.totalObstaclesCleared++;\n128\t    this._updateClearProgress();\n129\t  }\n130\t\n131\t  _updateClearProgress() {\n132\t    if (this.goalType === 'clear_obstacle') {\n133\t      if (this.clearObstacleType === 0) {\n134\t        this.goalProgress = this.totalObstaclesCleared;\n135\t      } else {\n136\t        this.goalProgress = this.obstaclesCleared[this.clearObstacleType] || 0;\n137\t      }\n138\t    }\n139\t    for (const dg of this.dualGoals) {\n140\t      if (dg.type === 'clear_obstacle') {\n141\t        if (dg.obstacleType === 0) {\n142\t          dg.progress = this.totalObstaclesCleared;\n143\t        } else {\n144\t          dg.progress = this.obstaclesCleared[dg.obstacleType] || 0;\n145\t        }\n146\t      }\n147\t    }\n148\t  }\n149\t\n150\t  getStarCount() {\n151\t    if (this.score >= this.stars[2]) return 3;\n152\t    if (this.score >= this.stars[1]) return 2;\n153\t    if (this.score >= this.stars[0]) return 1;\n154\t    return 0;\n155\t  }\n156\t\n157\t  isGoalComplete() {\n158\t    switch (this.goalType) {\n159\t      case 'score':\n160\t        return this.score >= this.goalTarget;\n161\t      case 'collect_color':\n162\t        return this.goalProgress >= this.goalTarget;\n163\t      case 'clear_obstacle':\n164\t        return this.goalProgress >= this.goalTarget;\n165\t      case 'boss':\n166\t        return false; // Handled externally\n167\t      case 'dual':\n168\t        return this.dualGoals.every(g => g.progress >= g.target);\n169\t      default:\n170\t        return false;\n171\t    }\n172\t  }\n173\t\n174\t  isBossDefeated() {\n175\t    return this.goalType === 'boss';\n176\t  }\n177\t\n178\t  isGameOver() {\n179\t    return this.getRemainingMoves() <= 0 && !this.isGoalComplete();\n180\t  }\n181\t\n182\t  getGoalDescription() {\n183\t    switch (this.goalType) {\n184\t      case 'score':\n185\t        return `分数 ${this.goalProgress}/${this.goalTarget}`;\n186\t      case 'collect_color': {\n187\t        const names = this.collectColors.map(c => COLOR_MAP[c]?.label || '?').join('+');\n188\t        return `收集${names} ${this.goalProgress}/${this.goalTarget}`;\n189\t      }\n190\t      case 'clear_obstacle': {\n191\t        const label = this.clearObstacleType === 1 ? '冰块' :\n192\t                      this.clearObstacleType === 2 ? '锁链' :\n193\t                      this.clearObstacleType === 3 ? '巧克力' : '障碍';\n194\t        return `清除${label} ${this.goalProgress}/${this.goalTarget}`;\n195\t      }\n196\t      case 'boss':\n197\t        return '击败Boss';\n198\t      case 'dual':\n199\t        return this.dualGoals.map(g => {\n200\t          if (g.type === 'score') return `分数 ${this.score}/${g.target}`;\n201\t          if (g.type === 'collect_color') {\n202\t            const names = g.colors.map(c => COLOR_MAP[c]?.label || '?').join('+');\n203\t            return `收集${names} ${g.progress}/${g.target}`;\n204\t          }\n205\t          if (g.type === 'clear_obstacle') return `清除障碍 ${g.progress}/${g.target}`;\n206\t          return '';\n207\t        }).join(' | ');\n208\t      default:\n209\t        return '';\n210\t    }\n211\t  }\n212\t\n213\t  getProgressForUI() {\n214\t    if (this.goalType === 'dual') {\n215\t      return this.dualGoals.map(g => ({\n216\t        label: g.type === 'score' ? '分数' :\n217\t               g.type === 'collect_color' ? '收集' : '清除',\n218\t        current: g.progress,\n219\t        target: g.target,\n220\t      }));\n221\t    }\n222\t    return [{ label: '', current: this.goalProgress, target: this.goalTarget }];\n223\t  }\n224\t\n225\t  checkState() {\n226\t    if (this.isGoalComplete()) {\n227\t      if (this.onLevelComplete) this.onLevelComplete(this.score, this.getStarCount());\n228\t      return 'complete';\n229\t    }\n230\t    if (this.isGameOver()) {\n231\t      if (this.onLevelFail) this.onLevelFail(this.score);\n232\t      return 'fail';\n233\t    }\n234\t    return 'playing';\n235\t  }\n236\t}\n237\t\n238\tif (typeof module !== 'undefined') module.exports = { ScoreSystem };\n239\t"}]},"parent_tool_use_id":null,"session_id":"fc99b580-aa14-4899-aa35-a732e530edf6","uuid":"23d70c58-72a1-4e9a-839c-bda268a91281","timestamp":"2026-05-22T21:41:59.085Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\douyin-match3\\src\\js\\ScoreSystem.js","content":"// ScoreSystem.js — Score, moves, goals (score/collect_color/clear_obstacle/boss/dual), stars\n\nclass ScoreSystem {\n  constructor() {\n    this.score = 0;\n    this.moves = 0;\n    this.maxMoves = 30;\n    this.goalType = 'score';\n    this.goalTarget = 1000;\n    this.goalProgress = 0;\n    this.level = 1;\n    this.stars = [0, 0, 0];\n    this.collected = {};\n    this.obstaclesCleared = {};\n    this.totalObstaclesCleared = 0;\n    this.chainCount = 0;\n    this.config = null;\n\n    // Dual goal support\n    this.dualGoals = [];\n\n    // Collect_color specifics\n    this.collectColors = [];\n\n    // Clear_obstacle specifics\n    this.clearObstacleType = 0;\n\n    this.onScoreChange = null;\n    this.onMovesChange = null;\n    this.onLevelComplete = null;\n    this.onLevelFail = null;\n  }\n\n  reset(level = 1) {\n    this.score = 0;\n    this.moves = 0;\n    this.goalProgress = 0;\n    this.chainCount = 0;\n    this.collected = {};\n    this.obstaclesCleared = {};\n    this.totalObstaclesCleared = 0;\n    this.dualGoals = [];\n    this.collectColors = [];\n    this.clearObstacleType = 0;\n    this.level = level;\n  }\n\n  configure(config) {\n    this.config = config;\n    this.maxMoves = config.moves || 30;\n    this.goalType = config.goal?.type || 'score';\n    this.goalTarget = config.goal?.target || 1000;\n    this.stars = config.stars || [1000, 1500, 2000];\n\n    if (this.goalType === 'collect_color') {\n      this.collectColors = config.goal?.colors || [];\n    } else if (this.goalType === 'clear_obstacle') {\n      this.clearObstacleType = config.goal?.obstacleType || 0;\n    } else if (this.goalType === 'dual') {\n      this.dualGoals = (config.goal?.goals || []).map(g => ({\n        type: g.type,\n        target: g.target,\n        progress: 0,\n        colors: g.colors || [],\n        obstacleType: g.obstacleType || 0,\n      }));\n    }\n  }\n\n  useMove() {\n    this.moves++;\n    if (this.onMovesChange) this.onMovesChange(this.getRemainingMoves());\n    return this.getRemainingMoves() >= 0;\n  }\n\n  getRemainingMoves() {\n    return this.maxMoves - this.moves;\n  }\n\n  addScore(points) {\n    this.score += points;\n    if (this.goalType === 'score') {\n      this.goalProgress = this.score;\n    }\n    // Update dual score goals\n    for (const dg of this.dualGoals) {\n      if (dg.type === 'score') dg.progress = this.score;\n    }\n    if (this.onScoreChange) this.onScoreChange(this.score);\n  }\n\n  addChainScore(basePoints, chainLevel) {\n    const multiplier = chainLevel <= 1 ? 1 : chainLevel === 2 ? 1.5 : chainLevel === 3 ? 2.0 : 2.5;\n    const points = Math.floor(basePoints * multiplier);\n    this.addScore(points);\n    this.chainCount = Math.max(this.chainCount, chainLevel);\n    return points;\n  }\n\n  addCollected(color, count) {\n    this.collected[color] = (this.collected[color] || 0) + count;\n    this._updateCollectProgress();\n  }\n\n  _updateCollectProgress() {\n    if (this.goalType === 'collect_color') {\n      let total = 0;\n      for (const c of this.collectColors) {\n        total += this.collected[c] || 0;\n      }\n      this.goalProgress = total;\n    }\n    for (const dg of this.dualGoals) {\n      if (dg.type === 'collect_color') {\n        let total = 0;\n        for (const c of dg.colors) {\n          total += this.collected[c] || 0;\n        }\n        dg.progress = total;\n      }\n    }\n  }\n\n  addObstacleCleared(type) {\n    if (!this.obstaclesCleared[type]) this.obstaclesCleared[type] = 0;\n    this.obstaclesCleared[type]++;\n    this.totalObstaclesCleared++;\n    this._updateClearProgress();\n  }\n\n  _updateClearProgress() {\n    if (this.goalType === 'clear_obstacle') {\n      if (this.clearObstacleType === 0) {\n        this.goalProgress = this.totalObstaclesCleared;\n      } else {\n        this.goalProgress = this.obstaclesCleared[this.clearObstacleType] || 0;\n      }\n    }\n    for (const dg of this.dualGoals) {\n      if (dg.type === 'clear_obstacle') {\n        if (dg.obstacleType === 0) {\n          dg.progress = this.totalObstaclesCleared;\n        } else {\n          dg.progress = this.obstaclesCleared[dg.obstacleType] || 0;\n        }\n      }\n    }\n  }\n\n  getStarCount() {\n    if (this.score >= this.stars[2]) return 3;\n    if (this.score >= this.stars[1]) return 2;\n    if (this.score >= this.stars[0]) return 1;\n    return 0;\n  }\n\n  isGoalComplete() {\n    switch (this.goalType) {\n      case 'score':\n        return this.score >= this.goalTarget;\n      case 'collect_color':\n        return this.goalProgress >= this.goalTarget;\n      case 'clear_obstacle':\n        return this.goalProgress >= this.goalTarget;\n      case 'boss':\n        return false; // Handled externally\n      case 'dual':\n        return this.dualGoals.every(g => g.progress >= g.target);\n      default:\n        return false;\n    }\n  }\n\n  isBossDefeated() {\n    return this.goalType === 'boss';\n  }\n\n  isGameOver() {\n    return this.getRemainingMoves() <= 0 && !this.isGoalComplete();\n  }\n\n  getGoalDescription() {\n    switch (this.goalType) {\n      case 'score':\n        return `分数 ${this.goalProgress}/${this.goalTarget}`;\n      case 'collect_color': {\n        const names = this.collectColors.map(c => COLOR_MAP[c]?.label || '?').join('+');\n        return `收集${names} ${this.goalProgress}/${this.goalTarget}`;\n      }\n      case 'clear_obstacle': {\n        const label = this.clearObstacleType === 1 ? '冰块' :\n                      this.clearObstacleType === 2 ? '锁链' :\n                      this.clearObstacleType === 3 ? '巧克力' : '障碍';\n        return `清除${label} ${this.goalProgress}/${this.goalTarget}`;\n      }\n      case 'boss':\n        return '击败Boss';\n      case 'dual':\n        return this.dualGoals.map(g => {\n          if (g.type === 'score') return `分数 ${this.score}/${g.target}`;\n          if (g.type === 'collect_color') {\n            const names = g.colors.map(c => COLOR_MAP[c]?.label || '?').join('+');\n            return `收集${names} ${g.progress}/${g.target}`;\n          }\n          if (g.type === 'clear_obstacle') return `清除障碍 ${g.progress}/${g.target}`;\n          return '';\n        }).join(' | ');\n      default:\n        return '';\n    }\n  }\n\n  getProgressForUI() {\n    if (this.goalType === 'dual') {\n      return this.dualGoals.map(g => ({\n        label: g.type === 'score' ? '分数' :\n               g.type === 'collect_color' ? '收集' : '清除',\n        current: g.progress,\n        target: g.target,\n      }));\n    }\n    return [{ label: '', current: this.goalProgress, target: this.goalTarget }];\n  }\n\n  checkState() {\n    if (this.isGoalComplete()) {\n      if (this.onLevelComplete) this.onLevelComplete(this.score, this.getStarCount());\n      return 'complete';\n    }\n    if (this.isGameOver()) {\n      if (this.onLevelFail) this.onLevelFail(this.score);\n      return 'fail';\n    }\n    return 'playing';\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { ScoreSystem };\n","numLines":239,"startLine":1,"totalLines":239}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6a13ac0046db42ada432121a","type":"tool_result","content":"1\t// Game.js — Main game loop, state machine, integrates all Phase 2 systems\n2\t\n3\tconst STATES = {\n4\t  MENU: 'menu',\n5\t  IDLE: 'idle',\n6\t  SWAPPING: 'swapping',\n7\t  MATCHING: 'matching',\n8\t  REMOVING: 'removing',\n9\t  DROPPING: 'dropping',\n10\t  RESULT: 'result',\n11\t  BOSS_SKILL: 'boss_skill',\n12\t};\n13\t\n14\tclass Game {\n15\t  constructor(canvas) {\n16\t    this.canvas = canvas;\n17\t    this.board = new Board();\n18\t    this.matchEngine = new MatchEngine(this.board);\n19\t    this.renderer = new Renderer(canvas);\n20\t    this.input = new InputHandler(canvas, this.board);\n21\t    this.scoreSystem = new ScoreSystem();\n22\t    this.tweens = new TweenManager();\n23\t    this.particles = new ParticleSystem();\n24\t    this.obstacleMgr = new ObstacleManager(this.board);\n25\t    this.audio = new AudioManager();\n26\t    this.boss = null;\n27\t    this.levels = LEVELS;\n28\t    this.currentLevel = 0;\n29\t    this.state = STATES.MENU;\n30\t    this.comboText = '';\n31\t    this.comboTimer = 0;\n32\t    this.lastTime = 0;\n33\t    this.resultData = null;\n34\t    this.moveCount = 0;\n35\t\n36\t    this.renderer.particleSystem = this.particles;\n37\t\n38\t    this._setupInput();\n39\t    this._setupScoreCallbacks();\n40\t    this._setupObstacleCallbacks();\n41\t  }\n42\t\n43\t  _setupInput() {\n44\t    this.input.onSwap = (r1, c1, r2, c2) => this._handleSwap(r1, c1, r2, c2);\n45\t    this.input.onTap = (row, col) => this._handleTap(row, col);\n46\t  }\n47\t\n48\t  _setupScoreCallbacks() {\n49\t    this.scoreSystem.onLevelComplete = (score, stars) => {\n50\t      this.state = STATES.RESULT;\n51\t      this.resultData = { won: true, score, stars, level: this.currentLevel + 1 };\n52\t      this.audio.playLevelWin();\n53\t    };\n54\t    this.scoreSystem.onLevelFail = (score) => {\n55\t      this.state = STATES.RESULT;\n56\t      this.resultData = { won: false, score, stars: 0, level: this.currentLevel + 1 };\n57\t      this.audio.playLevelFail();\n58\t    };\n59\t  }\n60\t\n61\t  _setupObstacleCallbacks() {\n62\t    this.obstacleMgr.onObstacleDestroyed = (obs) => {\n63\t      this.scoreSystem.addObstacleCleared(obs.type);\n64\t      this.audio.playObstacleBreak();\n65\t      const pos = this.renderer.getTileCenter(obs.row, obs.col);\n66\t      this.particles.emitExplosion(pos.x, pos.y, this._obstacleColor(obs.type), 12);\n67\t    };\n68\t  }\n69\t\n70\t  _obstacleColor(type) {\n71\t    switch (type) {\n72\t      case OBSTACLE_ICE: return '#88CCFF';\n73\t      case OBSTACLE_CHAIN: return '#AAAAAA';\n74\t      case OBSTACLE_CHOCOLATE: return '#8B4513';\n75\t      default: return '#FFFFFF';\n76\t    }\n77\t  }\n78\t\n79\t  start() {\n80\t    this._loadLevel(0);\n81\t    this.state = STATES.IDLE;\n82\t    this.lastTime = performance.now();\n83\t    this._loop();\n84\t  }\n85\t\n86\t  _loadLevel(idx) {\n87\t    this.currentLevel = idx;\n88\t    const config = this.levels[idx] || this.levels[0];\n89\t    this.board.init();\n90\t    this.scoreSystem.reset(idx + 1);\n91\t    this.scoreSystem.configure(config);\n92\t    this.tweens.clear();\n93\t    this.particles.particles = [];\n94\t    this.renderer.floatingTexts = [];\n95\t    this.comboText = '';\n96\t    this.resultData = null;\n97\t    this.moveCount = 0;\n98\t\n99\t    // Load obstacles\n100\t    this.obstacleMgr.loadFromConfig(config.obstacles);\n101\t\n102\t    // Clear cells with chocolate obstacles\n103\t    for (const obs of this.obstacleMgr.obstacles) {\n104\t      if (obs.type === OBSTACLE_CHOCOLATE) {\n105\t        this.board.clearCell(obs.row, obs.col);\n106\t      }\n107\t    }\n108\t\n109\t    // Load boss\n110\t    this.boss = null;\n111\t    if (config.boss) {\n112\t      this.boss = new Boss(config.boss);\n113\t      this.board.clearCell(this.boss.row, this.boss.col);\n114\t    }\n115\t\n116\t    // Apply gravity to fill gaps from chocolate/boss\n117\t    this.board.applyGravity();\n118\t\n119\t    // Remove initial matches\n120\t    this.board._removeInitialMatches();\n121\t\n122\t    this.input.updateLayout(\n123\t      this.renderer.tileSize,\n124\t      this.renderer.boardX,\n125\t      this.renderer.boardY,\n126\t    );\n127\t  }\n128\t\n129\t  _handleTap(row, col) {\n130\t    if (this.state !== STATES.IDLE) return;\n131\t    const tile = this.board.getTile(row, col);\n132\t    if (!tile) return;\n133\t\n134\t    // Initialize audio on first interaction\n135\t    this.audio.init();\n136\t\n137\t    if (tile.special === SPECIAL_RAINBOW) return;\n138\t  }\n139\t\n140\t  _handleSwap(r1, c1, r2, c2) {\n141\t    if (this.state !== STATES.IDLE) return;\n142\t\n143\t    this.audio.init();\n144\t\n145\t    const tileA = this.board.getTile(r1, c1);\n146\t    const tileB = this.board.getTile(r2, c2);\n147\t\n148\t    // Check chain lock\n149\t    if (!this.obstacleMgr.canSwap(r1, c1) || !this.obstacleMgr.canSwap(r2, c2)) {\n150\t      this.audio.playInvalid();\n151\t      return;\n152\t    }\n153\t\n154\t    // Rainbow special combinations\n155\t    if (tileA && tileA.special === SPECIAL_RAINBOW) {\n156\t      this._activateRainbow(r1, c1, tileB ? tileB.color : 0, r2, c2);\n157\t      return;\n158\t    }\n159\t    if (tileB && tileB.special === SPECIAL_RAINBOW) {\n160\t      this._activateRainbow(r2, c2, tileA ? tileA.color : 0, r1, c1);\n161\t      return;\n162\t    }\n163\t\n164\t    if (!this.matchEngine.isValidSwap(r1, c1, r2, c2)) {\n165\t      this.audio.playInvalid();\n166\t      return;\n167\t    }\n168\t    if (!this.scoreSystem.useMove()) return;\n169\t\n170\t    this.audio.playSwap();\n171\t    this.moveCount++;\n172\t    this.state = STATES.SWAPPING;\n173\t    this.board.swap(r1, c1, r2, c2);\n174\t\n175\t    this._animateSwap(r1, c1, r2, c2, () => {\n176\t      this._processMatches();\n177\t    });\n178\t  }\n179\t\n180\t  _animateSwap(r1, c1, r2, c2, callback) {\n181\t    const tileSize = this.renderer.tileSize;\n182\t    const tileA = this.board.getTile(r2, c2);\n183\t    const tileB = this.board.getTile(r1, c1);\n184\t    const dx = (c2 - c1) * tileSize;\n185\t    const dy = (r2 - r1) * tileSize;\n186\t\n187\t    if (tileA) {\n188\t      tileA.offsetX = -dx;\n189\t      tileA.offsetY = -dy;\n190\t      this.tweens.add(tileA, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n191\t    }\n192\t    if (tileB) {\n193\t      tileB.offsetX = dx;\n194\t      tileB.offsetY = dy;\n195\t      this.tweens.add(tileB, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n196\t    }\n197\t    setTimeout(callback, 160);\n198\t  }\n199\t\n200\t  _activateRainbow(rainbowRow, rainbowCol, targetColor, otherRow, otherCol) {\n201\t    if (!this.scoreSystem.useMove()) return;\n202\t    this.moveCount++;\n203\t    this.audio.playSpecial();\n204\t    this.state = STATES.MATCHING;\n205\t\n206\t    const toRemove = this.matchEngine.triggerRainbow(rainbowRow, rainbowCol, targetColor);\n207\t    toRemove.push({ row: rainbowRow, col: rainbowCol });\n208\t    if (this.board.getTile(otherRow, otherCol)) {\n209\t      toRemove.push({ row: otherRow, col: otherCol });\n210\t    }\n211\t\n212\t    this._removeAndCascade(toRemove, 10);\n213\t  }\n214\t\n215\t  _processMatches() {\n216\t    this.state = STATES.MATCHING;\n217\t    const matches = this.board.findAllMatches();\n218\t\n219\t    if (matches.length === 0) {\n220\t      this._afterMoveComplete();\n221\t      return;\n222\t    }\n223\t\n224\t    this._processChain(0);\n225\t  }\n226\t\n227\t  _processChain(chainCount) {\n228\t    chainCount++;\n229\t    const matches = this.board.findAllMatches();\n230\t    if (matches.length === 0) {\n231\t      this._afterMoveComplete();\n232\t      return;\n233\t    }\n234\t\n235\t    const lShapes = this.board.findLShapeMatches(matches);\n236\t    const { removeCells, specials } = this.matchEngine._classifyMatches(matches, lShapes);\n237\t\n238\t    const multiplier = chainCount <= 1 ? 1 : chainCount === 2 ? 1.5 : chainCount === 3 ? 2.0 : 2.5;\n239\t    const baseScore = removeCells.size * 10;\n240\t    const points = Math.floor(baseScore * multiplier);\n241\t    this.scoreSystem.addScore(points);\n242\t\n243\t    if (chainCount >= 4) this.comboText = '超赞！！';\n244\t    else if (chainCount === 3) this.comboText = '太棒了！';\n245\t    else if (chainCount === 2) this.comboText = '不错！';\n246\t    this.comboTimer = 0.8;\n247\t\n248\t    this.audio.playMatch(chainCount);\n249\t    if (chainCount >= 2) this.audio.playCombo(chainCount);\n250\t\n251\t    // Collect matched positions for obstacle/boss damage\n252\t    const matchedPositions = [];\n253\t    for (const key of removeCells) {\n254\t      const [r, c] = key.split(',').map(Number);\n255\t      const tile = this.board.getTile(r, c);\n256\t      if (tile && tile.color >= 0) {\n257\t        this.scoreSystem.addCollected(tile.color, 1);\n258\t      }\n259\t      matchedPositions.push({ row: r, col: c });\n260\t    }\n261\t\n262\t    // Create specials\n263\t    const specialPositions = new Set(specials.map(s => `${s.row},${s.col}`));\n264\t    for (const sp of specials) {\n265\t      const tile = this.board.getTile(sp.row, sp.col);\n266\t      if (tile) {\n267\t        tile.special = sp.type;\n268\t        tile.removing = false;\n269\t      }\n270\t    }\n271\t\n272\t    // Animate removal\n273\t    this.state = STATES.REMOVING;\n274\t    const toAnimate = [];\n275\t    for (const key of removeCells) {\n276\t      if (specialPositions.has(key)) continue;\n277\t      const [r, c] = key.split(',').map(Number);\n278\t      const tile = this.board.getTile(r, c);\n279\t      if (tile) {\n280\t        const pos = this.renderer.getTileCenter(r, c);\n281\t        const color = COLOR_MAP[tile.color];\n282\t        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 8);\n283\t        this.renderer.addFloatingText(`+${points}`, pos.x, pos.y);\n284\t        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n285\t        toAnimate.push(tile);\n286\t      }\n287\t    }\n288\t\n289\t    setTimeout(() => {\n290\t      // Remove tiles\n291\t      for (const key of removeCells) {\n292\t        if (specialPositions.has(key)) continue;\n293\t        const [r, c] = key.split(',').map(Number);\n294\t        this.board.clearCell(r, c);\n295\t      }\n296\t\n297\t      // Trigger specials\n298\t      for (const sp of specials) {\n299\t        this._triggerSpecialEffects(sp.row, sp.col, sp.type);\n300\t      }\n301\t\n302\t      // Damage obstacles\n303\t      this.obstacleMgr.onTilesMatched(matchedPositions);\n304\t\n305\t      // Damage boss\n306\t      if (this.boss && this.boss.active) {\n307\t        const dmg = this.boss.calculateDamage(matchedPositions);\n308\t        if (dmg > 0) {\n309\t          const defeated = this.boss.takeDamage(dmg);\n310\t          this.audio.playBossHit();\n311\t          if (defeated) {\n312\t            this.audio.playBossDefeat();\n313\t            this.scoreSystem.addScore(500);\n314\t          }\n315\t        }\n316\t      }\n317\t\n318\t      // Apply gravity\n319\t      this.state = STATES.DROPPING;\n320\t      const drops = this.board.applyGravity();\n321\t\n322\t      for (const drop of drops) {\n323\t        const tile = drop.tile;\n324\t        const fromY = drop.fromRow * this.renderer.tileSize;\n325\t        const toY = drop.toRow * this.renderer.tileSize;\n326\t        tile.offsetY = fromY - toY;\n327\t        this.tweens.add(tile, { offsetY: 0 }, 0.2 + drop.distance * 0.03, 'easeOutBounce');\n328\t      }\n329\t\n330\t      setTimeout(() => {\n331\t        this._processChain(chainCount);\n332\t      }, 350);\n333\t    }, 280);\n334\t  }\n335\t\n336\t  _afterMoveComplete() {\n337\t    // Check if boss was defeated this turn\n338\t    if (this.boss && this.boss.isDefeated() && this.scoreSystem.goalType === 'boss') {\n339\t      this.state = STATES.RESULT;\n340\t      const stars = this.scoreSystem.getStarCount();\n341\t      this.resultData = { won: true, score: this.scoreSystem.score, stars, level: this.currentLevel + 1 };\n342\t      this.audio.playLevelWin();\n343\t      return;\n344\t    }\n345\t\n346\t    // Spread chocolate\n347\t    this.obstacleMgr.spreadChocolate();\n348\t\n349\t    // Boss ability\n350\t    if (this.boss && this.boss.active) {\n351\t      const ability = this.boss.tryUseAbility();\n352\t      if (ability) {\n353\t        this._executeBossAbility(ability);\n354\t      }\n355\t    }\n356\t\n357\t    this.state = STATES.IDLE;\n358\t\n359\t    // Check deadlock\n360\t    if (!this.board.hasValidMoves(this.obstacleMgr)) {\n361\t      this.board.shuffle();\n362\t    }\n363\t\n364\t    this.scoreSystem.checkState();\n365\t  }\n366\t\n367\t  _executeBossAbility(ability) {\n368\t    this.audio.playBossAbility();\n369\t\n370\t    switch (ability) {\n371\t      case 'freeze': {\n372\t        // Add ice to 2 random empty cells (no existing obstacle)\n373\t        const candidates = [];\n374\t        for (let r = 0; r < this.board.size; r++) {\n375\t          for (let c = 0; c < this.board.size; c++) {\n376\t            if (!this.obstacleMgr.hasObstacle(r, c) && this.board.getTile(r, c)) {\n377\t              // Don't freeze boss position\n378\t              if (this.boss && r === this.boss.row && c === this.boss.col) continue;\n379\t              candidates.push({ row: r, col: c });\n380\t            }\n381\t          }\n382\t        }\n383\t        const count = Math.min(2, candidates.length);\n384\t        for (let i = 0; i < count; i++) {\n385\t          const idx = Math.floor(Math.random() * candidates.length);\n386\t          const target = candidates.splice(idx, 1)[0];\n387\t          this.obstacleMgr.addObstacle(OBSTACLE_ICE, target.row, target.col);\n388\t        }\n389\t        break;\n390\t      }\n391\t      case 'chain': {\n392\t        const candidates = [];\n393\t        for (let r = 0; r < this.board.size; r++) {\n394\t          for (let c = 0; c < this.board.size; c++) {\n395\t            if (!this.obstacleMgr.hasObstacle(r, c) && this.board.getTile(r, c)) {\n396\t              if (this.boss && r === this.boss.row && c === this.boss.col) continue;\n397\t              candidates.push({ row: r, col: c });\n398\t            }\n399\t          }\n400\t        }\n401\t        if (candidates.length > 0) {\n402\t          const idx = Math.floor(Math.random() * candidates.length);\n403\t          const target = candidates[idx];\n404\t          this.obstacleMgr.addObstacle(OBSTACLE_CHAIN, target.row, target.col);\n405\t        }\n406\t        break;\n407\t      }\n408\t      case 'chocolate': {\n409\t        // Add chocolate to 1 random empty cell\n410\t        const dirs = [[-1,0],[1,0],[0,-1],[0,1]];\n411\t        const candidates = [];\n412\t        for (const [dr, dc] of dirs) {\n413\t          const nr = this.boss.row + dr;\n414\t          const nc = this.boss.col + dc;\n415\t          if (this.board.isValid(nr, nc) && !this.obstacleMgr.hasObstacle(nr, nc)) {\n416\t            candidates.push({ row: nr, col: nc });\n417\t          }\n418\t        }\n419\t        if (candidates.length > 0) {\n420\t          const target = candidates[Math.floor(Math.random() * candidates.length)];\n421\t          this.obstacleMgr.addObstacle(OBSTACLE_CHOCOLATE, target.row, target.col);\n422\t        }\n423\t        break;\n424\t      }\n425\t    }\n426\t  }\n427\t\n428\t  _triggerSpecialEffects(row, col, type) {\n429\t    const pos = this.renderer.getTileCenter(row, col);\n430\t    const tile = this.board.getTile(row, col);\n431\t    const color = tile ? COLOR_MAP[tile.color]?.hex : '#FFB800';\n432\t\n433\t    this.audio.playSpecial();\n434\t\n435\t    switch (type) {\n436\t      case 1: case 2:\n437\t        this.particles.emitExplosion(pos.x, pos.y, color || '#FFB800', 20);\n438\t        break;\n439\t      case 3:\n440\t        this.particles.emitExplosion(pos.x, pos.y, '#FF9A3C', 30);\n441\t        break;\n442\t      case 4:\n443\t        for (let i = 0; i < 40; i++) {\n444\t          this.particles.emitExplosion(pos.x, pos.y, '#FFB800', 2);\n445\t        }\n446\t        break;\n447\t    }\n448\t  }\n449\t\n450\t  _removeAndCascade(cells, scorePerCell) {\n451\t    this.state = STATES.REMOVING;\n452\t    const points = cells.length * scorePerCell;\n453\t    this.scoreSystem.addScore(points);\n454\t\n455\t    // Collect colors\n456\t    for (const { row, col } of cells) {\n457\t      const tile = this.board.getTile(row, col);\n458\t      if (tile && tile.color >= 0) {\n459\t        this.scoreSystem.addCollected(tile.color, 1);\n460\t      }\n461\t    }\n462\t\n463\t    for (const { row, col } of cells) {\n464\t      const tile = this.board.getTile(row, col);\n465\t      if (tile) {\n466\t        const pos = this.renderer.getTileCenter(row, col);\n467\t        const color = COLOR_MAP[tile.color];\n468\t        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 6);\n469\t        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n470\t      }\n471\t    }\n472\t\n473\t    setTimeout(() => {\n474\t      for (const { row, col } of cells) {\n475\t        this.board.clearCell(row, col);\n476\t      }\n477\t\n478\t      // Damage obstacles\n479\t      this.obstacleMgr.onTilesMatched(cells);\n480\t\n481\t      // Damage boss\n482\t      if (this.boss && this.boss.active) {\n483\t        const dmg = this.boss.calculateDamage(cells);\n484\t        if (dmg > 0) {\n485\t          const defeated = this.boss.takeDamage(dmg);\n486\t          this.audio.playBossHit();\n487\t          if (defeated) {\n488\t            this.audio.playBossDefeat();\n489\t            this.scoreSystem.addScore(500);\n490\t          }\n491\t        }\n492\t      }\n493\t\n494\t      this.board.applyGravity();\n495\t\n496\t      this.state = STATES.IDLE;\n497\t      setTimeout(() => this._processMatches(), 200);\n498\t    }, 300);\n499\t  }\n500\t\n501\t  _loop() {\n502\t    const now = performance.now();\n503\t    const dt = Math.min((now - this.lastTime) / 1000, 0.05);\n504\t    this.lastTime = now;\n505\t\n506\t    this.update(dt);\n507\t    this.render();\n508\t    requestAnimationFrame(() => this._loop());\n509\t  }\n510\t\n511\t  update(dt) {\n512\t    this.tweens.update(dt);\n513\t    this.particles.update(dt);\n514\t    this.obstacleMgr.update(dt);\n515\t    if (this.boss) this.boss.update(dt);\n516\t\n517\t    if (this.comboTimer > 0) {\n518\t      this.comboTimer -= dt;\n519\t      if (this.comboTimer <= 0) this.comboText = '';\n520\t    }\n521\t\n522\t    this.input.enabled = this.state === STATES.IDLE;\n523\t  }\n524\t\n525\t  render() {\n526\t    this.renderer.clear();\n527\t    this.renderer.drawBackground();\n528\t\n529\t    // Draw tiles\n530\t    for (let r = 0; r < this.board.size; r++) {\n531\t      for (let c = 0; c < this.board.size; c++) {\n532\t        const tile = this.board.getTile(r, c);\n533\t        if (tile) this.renderer.drawTile(tile);\n534\t      }\n535\t    }\n536\t\n537\t    // Draw obstacles\n538\t    this.renderer.drawObstacles(this.obstacleMgr);\n539\t\n540\t    // Draw boss\n541\t    if (this.boss && this.boss.active) {\n542\t      this.renderer.drawBoss(this.boss, this.renderer);\n543\t    }\n544\t\n545\t    // Particles\n546\t    this.particles.draw(this.renderer.ctx);\n547\t\n548\t    // Floating texts\n549\t    this.renderer.updateAndDrawFloatingTexts(1 / 60);\n550\t\n551\t    // UI\n552\t    const config = this.levels[this.currentLevel] || this.levels[0];\n553\t    this.renderer.drawUI(\n554\t      this.scoreSystem.score,\n555\t      this.scoreSystem.getRemainingMoves(),\n556\t      config,\n557\t      this.scoreSystem,\n558\t      this.currentLevel + 1,\n559\t    );\n560\t\n561\t    // Combo text\n562\t    if (this.comboText) {\n563\t      this.renderer.drawComboText(this.comboText);\n564\t    }\n565\t\n566\t    // Boss health bar\n567\t    if (this.boss && this.boss.active) {\n568\t      this.renderer.drawBossHealthBar(this.boss);\n569\t    }\n570\t\n571\t    // Result screen\n572\t    if (this.resultData) {\n573\t      this.renderer.drawResultScreen(\n574\t        this.resultData.won,\n575\t        this.resultData.score,\n576\t        this.resultData.stars,\n577\t        this.resultData.level,\n578\t      );\n579\t    }\n580\t  }\n581\t\n582\t  retry() {\n583\t    this._loadLevel(this.currentLevel);\n584\t    this.state = STATES.IDLE;\n585\t  }\n586\t\n587\t  nextLevel() {\n588\t    const next = this.currentLevel + 1;\n589\t    if (next < this.levels.length) {\n590\t      this._loadLevel(next);\n591\t      this.state = STATES.IDLE;\n592\t    } else {\n593\t      this._loadLevel(0);\n594\t      this.state = STATES.IDLE;\n595\t    }\n596\t  }\n597\t}\n598\t\n599\tif (typeof module !== 'undefined') module.exports = { Game, STATES };\n600\t"}]},"parent_tool_use_id":null,"session_id":"fc99b580-aa14-4899-aa35-a732e530edf6","uuid":"419c312d-6bcc-46ae-ba40-50cb0a3ccf23","timestamp":"2026-05-22T21:41:59.480Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\douyin-match3\\src\\js\\Game.js","content":"// Game.js — Main game loop, state machine, integrates all Phase 2 systems\n\nconst STATES = {\n  MENU: 'menu',\n  IDLE: 'idle',\n  SWAPPING: 'swapping',\n  MATCHING: 'matching',\n  REMOVING: 'removing',\n  DROPPING: 'dropping',\n  RESULT: 'result',\n  BOSS_SKILL: 'boss_skill',\n};\n\nclass Game {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.board = new Board();\n    this.matchEngine = new MatchEngine(this.board);\n    this.renderer = new Renderer(canvas);\n    this.input = new InputHandler(canvas, this.board);\n    this.scoreSystem = new ScoreSystem();\n    this.tweens = new TweenManager();\n    this.particles = new ParticleSystem();\n    this.obstacleMgr = new ObstacleManager(this.board);\n    this.audio = new AudioManager();\n    this.boss = null;\n    this.levels = LEVELS;\n    this.currentLevel = 0;\n    this.state = STATES.MENU;\n    this.comboText = '';\n    this.comboTimer = 0;\n    this.lastTime = 0;\n    this.resultData = null;\n    this.moveCount = 0;\n\n    this.renderer.particleSystem = this.particles;\n\n    this._setupInput();\n    this._setupScoreCallbacks();\n    this._setupObstacleCallbacks();\n  }\n\n  _setupInput() {\n    this.input.onSwap = (r1, c1, r2, c2) => this._handleSwap(r1, c1, r2, c2);\n    this.input.onTap = (row, col) => this._handleTap(row, col);\n  }\n\n  _setupScoreCallbacks() {\n    this.scoreSystem.onLevelComplete = (score, stars) => {\n      this.state = STATES.RESULT;\n      this.resultData = { won: true, score, stars, level: this.currentLevel + 1 };\n      this.audio.playLevelWin();\n    };\n    this.scoreSystem.onLevelFail = (score) => {\n      this.state = STATES.RESULT;\n      this.resultData = { won: false, score, stars: 0, level: this.currentLevel + 1 };\n      this.audio.playLevelFail();\n    };\n  }\n\n  _setupObstacleCallbacks() {\n    this.obstacleMgr.onObstacleDestroyed = (obs) => {\n      this.scoreSystem.addObstacleCleared(obs.type);\n      this.audio.playObstacleBreak();\n      const pos = this.renderer.getTileCenter(obs.row, obs.col);\n      this.particles.emitExplosion(pos.x, pos.y, this._obstacleColor(obs.type), 12);\n    };\n  }\n\n  _obstacleColor(type) {\n    switch (type) {\n      case OBSTACLE_ICE: return '#88CCFF';\n      case OBSTACLE_CHAIN: return '#AAAAAA';\n      case OBSTACLE_CHOCOLATE: return '#8B4513';\n      default: return '#FFFFFF';\n    }\n  }\n\n  start() {\n    this._loadLevel(0);\n    this.state = STATES.IDLE;\n    this.lastTime = performance.now();\n    this._loop();\n  }\n\n  _loadLevel(idx) {\n    this.currentLevel = idx;\n    const config = this.levels[idx] || this.levels[0];\n    this.board.init();\n    this.scoreSystem.reset(idx + 1);\n    this.scoreSystem.configure(config);\n    this.tweens.clear();\n    this.particles.particles = [];\n    this.renderer.floatingTexts = [];\n    this.comboText = '';\n    this.resultData = null;\n    this.moveCount = 0;\n\n    // Load obstacles\n    this.obstacleMgr.loadFromConfig(config.obstacles);\n\n    // Clear cells with chocolate obstacles\n    for (const obs of this.obstacleMgr.obstacles) {\n      if (obs.type === OBSTACLE_CHOCOLATE) {\n        this.board.clearCell(obs.row, obs.col);\n      }\n    }\n\n    // Load boss\n    this.boss = null;\n    if (config.boss) {\n      this.boss = new Boss(config.boss);\n      this.board.clearCell(this.boss.row, this.boss.col);\n    }\n\n    // Apply gravity to fill gaps from chocolate/boss\n    this.board.applyGravity();\n\n    // Remove initial matches\n    this.board._removeInitialMatches();\n\n    this.input.updateLayout(\n      this.renderer.tileSize,\n      this.renderer.boardX,\n      this.renderer.boardY,\n    );\n  }\n\n  _handleTap(row, col) {\n    if (this.state !== STATES.IDLE) return;\n    const tile = this.board.getTile(row, col);\n    if (!tile) return;\n\n    // Initialize audio on first interaction\n    this.audio.init();\n\n    if (tile.special === SPECIAL_RAINBOW) return;\n  }\n\n  _handleSwap(r1, c1, r2, c2) {\n    if (this.state !== STATES.IDLE) return;\n\n    this.audio.init();\n\n    const tileA = this.board.getTile(r1, c1);\n    const tileB = this.board.getTile(r2, c2);\n\n    // Check chain lock\n    if (!this.obstacleMgr.canSwap(r1, c1) || !this.obstacleMgr.canSwap(r2, c2)) {\n      this.audio.playInvalid();\n      return;\n    }\n\n    // Rainbow special combinations\n    if (tileA && tileA.special === SPECIAL_RAINBOW) {\n      this._activateRainbow(r1, c1, tileB ? tileB.color : 0, r2, c2);\n      return;\n    }\n    if (tileB && tileB.special === SPECIAL_RAINBOW) {\n      this._activateRainbow(r2, c2, tileA ? tileA.color : 0, r1, c1);\n      return;\n    }\n\n    if (!this.matchEngine.isValidSwap(r1, c1, r2, c2)) {\n      this.audio.playInvalid();\n      return;\n    }\n    if (!this.scoreSystem.useMove()) return;\n\n    this.audio.playSwap();\n    this.moveCount++;\n    this.state = STATES.SWAPPING;\n    this.board.swap(r1, c1, r2, c2);\n\n    this._animateSwap(r1, c1, r2, c2, () => {\n      this._processMatches();\n    });\n  }\n\n  _animateSwap(r1, c1, r2, c2, callback) {\n    const tileSize = this.renderer.tileSize;\n    const tileA = this.board.getTile(r2, c2);\n    const tileB = this.board.getTile(r1, c1);\n    const dx = (c2 - c1) * tileSize;\n    const dy = (r2 - r1) * tileSize;\n\n    if (tileA) {\n      tileA.offsetX = -dx;\n      tileA.offsetY = -dy;\n      this.tweens.add(tileA, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n    }\n    if (tileB) {\n      tileB.offsetX = dx;\n      tileB.offsetY = dy;\n      this.tweens.add(tileB, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n    }\n    setTimeout(callback, 160);\n  }\n\n  _activateRainbow(rainbowRow, rainbowCol, targetColor, otherRow, otherCol) {\n    if (!this.scoreSystem.useMove()) return;\n    this.moveCount++;\n    this.audio.playSpecial();\n    this.state = STATES.MATCHING;\n\n    const toRemove = this.matchEngine.triggerRainbow(rainbowRow, rainbowCol, targetColor);\n    toRemove.push({ row: rainbowRow, col: rainbowCol });\n    if (this.board.getTile(otherRow, otherCol)) {\n      toRemove.push({ row: otherRow, col: otherCol });\n    }\n\n    this._removeAndCascade(toRemove, 10);\n  }\n\n  _processMatches() {\n    this.state = STATES.MATCHING;\n    const matches = this.board.findAllMatches();\n\n    if (matches.length === 0) {\n      this._afterMoveComplete();\n      return;\n    }\n\n    this._processChain(0);\n  }\n\n  _processChain(chainCount) {\n    chainCount++;\n    const matches = this.board.findAllMatches();\n    if (matches.length === 0) {\n      this._afterMoveComplete();\n      return;\n    }\n\n    const lShapes = this.board.findLShapeMatches(matches);\n    const { removeCells, specials } = this.matchEngine._classifyMatches(matches, lShapes);\n\n    const multiplier = chainCount <= 1 ? 1 : chainCount === 2 ? 1.5 : chainCount === 3 ? 2.0 : 2.5;\n    const baseScore = removeCells.size * 10;\n    const points = Math.floor(baseScore * multiplier);\n    this.scoreSystem.addScore(points);\n\n    if (chainCount >= 4) this.comboText = '超赞！！';\n    else if (chainCount === 3) this.comboText = '太棒了！';\n    else if (chainCount === 2) this.comboText = '不错！';\n    this.comboTimer = 0.8;\n\n    this.audio.playMatch(chainCount);\n    if (chainCount >= 2) this.audio.playCombo(chainCount);\n\n    // Collect matched positions for obstacle/boss damage\n    const matchedPositions = [];\n    for (const key of removeCells) {\n      const [r, c] = key.split(',').map(Number);\n      const tile = this.board.getTile(r, c);\n      if (tile && tile.color >= 0) {\n        this.scoreSystem.addCollected(tile.color, 1);\n      }\n      matchedPositions.push({ row: r, col: c });\n    }\n\n    // Create specials\n    const specialPositions = new Set(specials.map(s => `${s.row},${s.col}`));\n    for (const sp of specials) {\n      const tile = this.board.getTile(sp.row, sp.col);\n      if (tile) {\n        tile.special = sp.type;\n        tile.removing = false;\n      }\n    }\n\n    // Animate removal\n    this.state = STATES.REMOVING;\n    const toAnimate = [];\n    for (const key of removeCells) {\n      if (specialPositions.has(key)) continue;\n      const [r, c] = key.split(',').map(Number);\n      const tile = this.board.getTile(r, c);\n      if (tile) {\n        const pos = this.renderer.getTileCenter(r, c);\n        const color = COLOR_MAP[tile.color];\n        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 8);\n        this.renderer.addFloatingText(`+${points}`, pos.x, pos.y);\n        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n        toAnimate.push(tile);\n      }\n    }\n\n    setTimeout(() => {\n      // Remove tiles\n      for (const key of removeCells) {\n        if (specialPositions.has(key)) continue;\n        const [r, c] = key.split(',').map(Number);\n        this.board.clearCell(r, c);\n      }\n\n      // Trigger specials\n      for (const sp of specials) {\n        this._triggerSpecialEffects(sp.row, sp.col, sp.type);\n      }\n\n      // Damage obstacles\n      this.obstacleMgr.onTilesMatched(matchedPositions);\n\n      // Damage boss\n      if (this.boss && this.boss.active) {\n        const dmg = this.boss.calculateDamage(matchedPositions);\n        if (dmg > 0) {\n          const defeated = this.boss.takeDamage(dmg);\n          this.audio.playBossHit();\n          if (defeated) {\n            this.audio.playBossDefeat();\n            this.scoreSystem.addScore(500);\n          }\n        }\n      }\n\n      // Apply gravity\n      this.state = STATES.DROPPING;\n      const drops = this.board.applyGravity();\n\n      for (const drop of drops) {\n        const tile = drop.tile;\n        const fromY = drop.fromRow * this.renderer.tileSize;\n        const toY = drop.toRow * this.renderer.tileSize;\n        tile.offsetY = fromY - toY;\n        this.tweens.add(tile, { offsetY: 0 }, 0.2 + drop.distance * 0.03, 'easeOutBounce');\n      }\n\n      setTimeout(() => {\n        this._processChain(chainCount);\n      }, 350);\n    }, 280);\n  }\n\n  _afterMoveComplete() {\n    // Check if boss was defeated this turn\n    if (this.boss && this.boss.isDefeated() && this.scoreSystem.goalType === 'boss') {\n      this.state = STATES.RESULT;\n      const stars = this.scoreSystem.getStarCount();\n      this.resultData = { won: true, score: this.scoreSystem.score, stars, level: this.currentLevel + 1 };\n      this.audio.playLevelWin();\n      return;\n    }\n\n    // Spread chocolate\n    this.obstacleMgr.spreadChocolate();\n\n    // Boss ability\n    if (this.boss && this.boss.active) {\n      const ability = this.boss.tryUseAbility();\n      if (ability) {\n        this._executeBossAbility(ability);\n      }\n    }\n\n    this.state = STATES.IDLE;\n\n    // Check deadlock\n    if (!this.board.hasValidMoves(this.obstacleMgr)) {\n      this.board.shuffle();\n    }\n\n    this.scoreSystem.checkState();\n  }\n\n  _executeBossAbility(ability) {\n    this.audio.playBossAbility();\n\n    switch (ability) {\n      case 'freeze': {\n        // Add ice to 2 random empty cells (no existing obstacle)\n        const candidates = [];\n        for (let r = 0; r < this.board.size; r++) {\n          for (let c = 0; c < this.board.size; c++) {\n            if (!this.obstacleMgr.hasObstacle(r, c) && this.board.getTile(r, c)) {\n              // Don't freeze boss position\n              if (this.boss && r === this.boss.row && c === this.boss.col) continue;\n              candidates.push({ row: r, col: c });\n            }\n          }\n        }\n        const count = Math.min(2, candidates.length);\n        for (let i = 0; i < count; i++) {\n          const idx = Math.floor(Math.random() * candidates.length);\n          const target = candidates.splice(idx, 1)[0];\n          this.obstacleMgr.addObstacle(OBSTACLE_ICE, target.row, target.col);\n        }\n        break;\n      }\n      case 'chain': {\n        const candidates = [];\n        for (let r = 0; r < this.board.size; r++) {\n          for (let c = 0; c < this.board.size; c++) {\n            if (!this.obstacleMgr.hasObstacle(r, c) && this.board.getTile(r, c)) {\n              if (this.boss && r === this.boss.row && c === this.boss.col) continue;\n              candidates.push({ row: r, col: c });\n            }\n          }\n        }\n        if (candidates.length > 0) {\n          const idx = Math.floor(Math.random() * candidates.length);\n          const target = candidates[idx];\n          this.obstacleMgr.addObstacle(OBSTACLE_CHAIN, target.row, target.col);\n        }\n        break;\n      }\n      case 'chocolate': {\n        // Add chocolate to 1 random empty cell\n        const dirs = [[-1,0],[1,0],[0,-1],[0,1]];\n        const candidates = [];\n        for (const [dr, dc] of dirs) {\n          const nr = this.boss.row + dr;\n          const nc = this.boss.col + dc;\n          if (this.board.isValid(nr, nc) && !this.obstacleMgr.hasObstacle(nr, nc)) {\n            candidates.push({ row: nr, col: nc });\n          }\n        }\n        if (candidates.length > 0) {\n          const target = candidates[Math.floor(Math.random() * candidates.length)];\n          this.obstacleMgr.addObstacle(OBSTACLE_CHOCOLATE, target.row, target.col);\n        }\n        break;\n      }\n    }\n  }\n\n  _triggerSpecialEffects(row, col, type) {\n    const pos = this.renderer.getTileCenter(row, col);\n    const tile = this.board.getTile(row, col);\n    const color = tile ? COLOR_MAP[tile.color]?.hex : '#FFB800';\n\n    this.audio.playSpecial();\n\n    switch (type) {\n      case 1: case 2:\n        this.particles.emitExplosion(pos.x, pos.y, color || '#FFB800', 20);\n        break;\n      case 3:\n        this.particles.emitExplosion(pos.x, pos.y, '#FF9A3C', 30);\n        break;\n      case 4:\n        for (let i = 0; i < 40; i++) {\n          this.particles.emitExplosion(pos.x, pos.y, '#FFB800', 2);\n        }\n        break;\n    }\n  }\n\n  _removeAndCascade(cells, scorePerCell) {\n    this.state = STATES.REMOVING;\n    const points = cells.length * scorePerCell;\n    this.scoreSystem.addScore(points);\n\n    // Collect colors\n    for (const { row, col } of cells) {\n      const tile = this.board.getTile(row, col);\n      if (tile && tile.color >= 0) {\n        this.scoreSystem.addCollected(tile.color, 1);\n      }\n    }\n\n    for (const { row, col } of cells) {\n      const tile = this.board.getTile(row, col);\n      if (tile) {\n        const pos = this.renderer.getTileCenter(row, col);\n        const color = COLOR_MAP[tile.color];\n        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 6);\n        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n      }\n    }\n\n    setTimeout(() => {\n      for (const { row, col } of cells) {\n        this.board.clearCell(row, col);\n      }\n\n      // Damage obstacles\n      this.obstacleMgr.onTilesMatched(cells);\n\n      // Damage boss\n      if (this.boss && this.boss.active) {\n        const dmg = this.boss.calculateDamage(cells);\n        if (dmg > 0) {\n          const defeated = this.boss.takeDamage(dmg);\n          this.audio.playBossHit();\n          if (defeated) {\n            this.audio.playBossDefeat();\n            this.scoreSystem.addScore(500);\n          }\n        }\n      }\n\n      this.board.applyGravity();\n\n      this.state = STATES.IDLE;\n      setTimeout(() => this._processMatches(), 200);\n    }, 300);\n  }\n\n  _loop() {\n    const now = performance.now();\n    const dt = Math.min((now - this.lastTime) / 1000, 0.05);\n    this.lastTime = now;\n\n    this.update(dt);\n    this.render();\n    requestAnimationFrame(() => this._loop());\n  }\n\n  update(dt) {\n    this.tweens.update(dt);\n    this.particles.update(dt);\n    this.obstacleMgr.update(dt);\n    if (this.boss) this.boss.update(dt);\n\n    if (this.comboTimer > 0) {\n      this.comboTimer -= dt;\n      if (this.comboTimer <= 0) this.comboText = '';\n    }\n\n    this.input.enabled = this.state === STATES.IDLE;\n  }\n\n  render() {\n    this.renderer.clear();\n    this.renderer.drawBackground();\n\n    // Draw tiles\n    for (let r = 0; r < this.board.size; r++) {\n      for (let c = 0; c < this.board.size; c++) {\n        const tile = this.board.getTile(r, c);\n        if (tile) this.renderer.drawTile(tile);\n      }\n    }\n\n    // Draw obstacles\n    this.renderer.drawObstacles(this.obstacleMgr);\n\n    // Draw boss\n    if (this.boss && this.boss.active) {\n      this.renderer.drawBoss(this.boss, this.renderer);\n    }\n\n    // Particles\n    this.particles.draw(this.renderer.ctx);\n\n    // Floating texts\n    this.renderer.updateAndDrawFloatingTexts(1 / 60);\n\n    // UI\n    const config = this.levels[this.currentLevel] || this.levels[0];\n    this.renderer.drawUI(\n      this.scoreSystem.score,\n      this.scoreSystem.getRemainingMoves(),\n      config,\n      this.scoreSystem,\n      this.currentLevel + 1,\n    );\n\n    // Combo text\n    if (this.comboText) {\n      this.renderer.drawComboText(this.comboText);\n    }\n\n    // Boss health bar\n    if (this.boss && this.boss.active) {\n      this.renderer.drawBossHealthBar(this.boss);\n    }\n\n    // Result screen\n    if (this.resultData) {\n      this.renderer.drawResultScreen(\n        this.resultData.won,\n        this.resultData.score,\n        this.resultData.stars,\n        this.resultData.level,\n      );\n    }\n  }\n\n  retry() {\n    this._loadLevel(this.currentLevel);\n    this.state = STATES.IDLE;\n  }\n\n  nextLevel() {\n    const next = this.currentLevel + 1;\n    if (next < this.levels.length) {\n      this._loadLevel(next);\n      this.state = STATES.IDLE;\n    } else {\n      this._loadLevel(0);\n      this.state = STATES.IDLE;\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Game, STATES };\n","numLines":600,"startLine":1,"totalLines":600}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_72085532c23a4ea597a6a3bc","type":"tool_result","content":"1\t// levels.js — 20 level definitions for Phase 2\n2\t// Obstacle types: 1=ice, 2=chain, 3=chocolate\n3\t// Goal types: score, collect_color, clear_obstacle, boss, dual\n4\t\n5\tconst LEVELS = [\n6\t  // 1-3: Tutorial, score only\n7\t  {\n8\t    id: 1, name: '初试身手', moves: 30,\n9\t    goal: { type: 'score', target: 800 },\n10\t    stars: [800, 1200, 1800],\n11\t    obstacles: [], boss: null\n12\t  },\n13\t  {\n14\t    id: 2, name: '小试牛刀', moves: 28,\n15\t    goal: { type: 'score', target: 1200 },\n16\t    stars: [1200, 1800, 2500],\n17\t    obstacles: [], boss: null\n18\t  },\n19\t  {\n20\t    id: 3, name: '渐入佳境', moves: 25,\n21\t    goal: { type: 'score', target: 1500 },\n22\t    stars: [1500, 2200, 3000],\n23\t    obstacles: [], boss: null\n24\t  },\n25\t\n26\t  // 4: Introduce ice\n27\t  {\n28\t    id: 4, name: '冰雪初体验', moves: 28,\n29\t    goal: { type: 'score', target: 1500 },\n30\t    stars: [1500, 2200, 3000],\n31\t    obstacles: [\n32\t      {type:1, row:1, col:1}, {type:1, row:1, col:6},\n33\t      {type:1, row:6, col:1}, {type:1, row:6, col:6},\n34\t      {type:1, row:3, col:3}, {type:1, row:3, col:4},\n35\t    ],\n36\t    boss: null\n37\t  },\n38\t\n39\t  // 5: First boss\n40\t  {\n41\t    id: 5, name: '冰封守卫', moves: 25,\n42\t    goal: { type: 'boss', target: 1 },\n43\t    stars: [500, 1000, 1500],\n44\t    boss: { name: '冰霜守卫', hp: 30, row: 3, col: 4, abilities: ['freeze'], skillInterval: 3 },\n45\t    obstacles: []\n46\t  },\n47\t\n48\t  // 6-7: Introduce chains\n49\t  {\n50\t    id: 6, name: '锁链迷宫', moves: 25,\n51\t    goal: { type: 'score', target: 2000 },\n52\t    stars: [2000, 3000, 4000],\n53\t    obstacles: [\n54\t      {type:2, row:2, col:2}, {type:2, row:2, col:5},\n55\t      {type:2, row:5, col:2}, {type:2, row:5, col:5},\n56\t      {type:2, row:3, col:3}, {type:2, row:3, col:4},\n57\t    ],\n58\t    boss: null\n59\t