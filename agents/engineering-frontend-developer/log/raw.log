ld; color: #D4A843;\n277\t  margin-top: 8px;\n278\t}\n279\t\n280\t.result-buttons {\n281\t  display: flex; flex-direction: column; gap: 10px; width: 220px;\n282\t}\n283\t\n284\t/* ===== 模态框 ===== */\n285\t.modal {\n286\t  position: absolute; top: 0; left: 0; right: 0; bottom: 0;\n287\t  background: rgba(0,0,0,0.6); display: flex;\n288\t  align-items: center; justify-content: center; z-index: 200;\n289\t}\n290\t.modal-content {\n291\t  background: #FFFDF7; border-radius: 20px; padding: 30px;\n292\t  text-align: center; max-width: 320px; width: 90%;\n293\t}\n294\t.modal-content h3 { font-size: 22px; color: #C84B31; margin-bottom: 12px; }\n295\t.modal-content p { margin-bottom: 20px; color: #8B7355; }\n296\t.modal-buttons { display: flex; gap: 12px; justify-content: center; }\n297\t"}]},"parent_tool_use_id":null,"session_id":"3263718e-ff98-4b11-b648-a6d67321903d","uuid":"a93544f8-5af6-4591-9dc7-b4e70dd9fa94","timestamp":"2026-05-23T00:17:00.612Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/src/css/style.css","content":"/* 成语大闯关 — 国风主题 */\n\n* { margin: 0; padding: 0; box-sizing: border-box; user-select: none; -webkit-user-select: none; }\n\nbody {\n  font-family: 'PingFang SC', 'Microsoft YaHei', 'SimSun', serif;\n  background: linear-gradient(135deg, #F5F0E8 0%, #E8DED0 100%);\n  min-height: 100vh;\n  overflow: hidden;\n  color: #2C2C2C;\n}\n\n#app {\n  width: 100%; height: 100vh;\n  max-width: 480px; margin: 0 auto;\n  position: relative; overflow: hidden;\n}\n\n.screen {\n  display: none; width: 100%; height: 100%;\n  flex-direction: column; position: absolute; top: 0; left: 0;\n}\n.screen.active { display: flex; }\n\n/* ===== 主菜单 ===== */\n.menu-bg {\n  flex: 1; display: flex; flex-direction: column;\n  align-items: center; justify-content: center; padding: 40px 20px;\n  background: linear-gradient(180deg, #FFFDF7 0%, #F5F0E8 50%, #E8DED0 100%);\n}\n\n.title-block { text-align: center; margin-bottom: 30px; }\n.title {\n  font-size: 42px; font-weight: 900; color: #C84B31;\n  text-shadow: 2px 2px 0 #D4A843, 4px 4px 0 rgba(0,0,0,0.05);\n  letter-spacing: 8px;\n}\n.subtitle { font-size: 16px; color: #8B7355; margin-top: 8px; letter-spacing: 4px; }\n\n.menu-stats {\n  display: flex; gap: 24px; margin-bottom: 40px;\n  font-size: 16px; color: #8B7355;\n}\n.stat-item { display: flex; align-items: center; gap: 4px; }\n\n.menu-buttons { display: flex; flex-direction: column; gap: 12px; width: 240px; }\n.menu-footer { margin-top: 40px; display: flex; gap: 16px; }\n.btn-icon {\n  width: 44px; height: 44px; border: 2px solid #D4A843;\n  border-radius: 50%; background: #FFFDF7; font-size: 20px;\n  cursor: pointer; display: flex; align-items: center; justify-content: center;\n}\n.btn-icon:active { background: #F5F0E8; }\n\n/* ===== 按钮 ===== */\n.btn {\n  padding: 14px 28px; border: none; border-radius: 24px;\n  font-size: 18px; font-weight: 600; cursor: pointer;\n  transition: transform 0.1s, box-shadow 0.2s;\n  letter-spacing: 2px;\n}\n.btn:active { transform: scale(0.95); }\n.btn-primary {\n  background: linear-gradient(135deg, #C84B31, #A63A22);\n  color: white; box-shadow: 0 4px 12px rgba(200,75,49,0.3);\n}\n.btn-secondary {\n  background: linear-gradient(135deg, #2D6A4F, #1E4D33);\n  color: white; box-shadow: 0 4px 12px rgba(45,106,79,0.3);\n}\n.btn-accent {\n  background: linear-gradient(135deg, #D4A843, #B8922E);\n  color: white; box-shadow: 0 4px 12px rgba(212,168,67,0.3);\n}\n\n.btn-back {\n  background: none; border: none; font-size: 20px;\n  cursor: pointer; padding: 8px; color: #8B7355;\n}\n\n/* ===== 关卡地图 ===== */\n.map-header {\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 12px 16px; background: rgba(255,255,255,0.9);\n  border-bottom: 1px solid #E8DED0;\n}\n.map-header h2 { font-size: 18px; color: #C84B31; }\n\n.chapter-info { padding: 8px 16px; }\n.chapter-badge {\n  display: inline-block; padding: 4px 12px; border-radius: 12px;\n  font-size: 13px; color: #2C2C2C; margin-right: 8px;\n}\n\n.level-grid {\n  flex: 1; overflow-y: auto; padding: 16px;\n  -webkit-overflow-scrolling: touch;\n}\n\n.chapter-section {\n  margin-bottom: 16px; padding: 12px;\n  background: rgba(255,255,255,0.7); border-radius: 16px;\n  border-left: 4px solid #D4A843;\n  display: flex; flex-wrap: wrap; gap: 8px; justify-content: center;\n}\n\n.level-btn {\n  width: 70px; padding: 8px 4px; border: 2px solid #E8DED0;\n  border-radius: 12px; background: #FFFDF7; cursor: pointer;\n  display: flex; flex-direction: column; align-items: center;\n  gap: 2px; transition: transform 0.1s;\n}\n.level-btn:active { transform: scale(0.95); }\n.level-btn.locked { opacity: 0.5; pointer-events: none; }\n.level-btn.completed { border-color: #27AE60; }\n.level-btn.boss {\n  background: linear-gradient(135deg, #FFF5E0, #FFE0B2);\n  border-color: #D4A843;\n}\n.level-num { font-size: 18px; font-weight: bold; color: #C84B31; }\n.level-stars { font-size: 10px; color: #D4A843; }\n.level-name { font-size: 9px; color: #8B7355; }\n.level-btn.locked .level-num { color: #ccc; }\n\n/* ===== 游戏界面 ===== */\n.game-header {\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 8px 16px; background: rgba(255,255,255,0.95);\n  border-bottom: 1px solid #E8DED0;\n}\n.header-center { display: flex; gap: 12px; font-size: 14px; font-weight: 600; }\n.header-right { font-size: 14px; }\n\n.game-body {\n  flex: 1; display: flex; flex-direction: column;\n  align-items: center; justify-content: center;\n  padding: 12px 16px; gap: 16px; overflow: hidden;\n}\n\n.combo-display {\n  font-size: 20px; font-weight: 800; color: #D4A843;\n  text-shadow: 0 2px 8px rgba(212,168,67,0.5);\n  display: none; animation: comboPopIn 0.3s ease-out;\n}\n.combo-3, .combo-4 { color: #D4A843; }\n.combo-5, .combo-6, .combo-7 { color: #FF8C00; font-size: 24px; }\n.combo-8, .combo-9 { color: #FF6347; font-size: 28px; }\n.combo-10 { color: #FF4500; font-size: 32px; animation: comboShake 0.3s ease-out; }\n\n@keyframes comboPopIn {\n  0% { transform: scale(0.5); opacity: 0; }\n  100% { transform: scale(1); opacity: 1; }\n}\n@keyframes comboShake {\n  0%, 100% { transform: translateX(0); }\n  25% { transform: translateX(-5px); }\n  75% { transform: translateX(5px); }\n}\n\n.meaning-box {\n  background: #FFFDF7; border: 2px solid #E8DED0;\n  border-radius: 12px; padding: 14px 20px;\n  text-align: center; max-width: 90%; min-height: 50px;\n  box-shadow: 0 2px 8px rgba(0,0,0,0.05);\n}\n#meaning-text { font-size: 16px; line-height: 1.5; color: #2C2C2C; }\n\n.slots-container {\n  display: flex; gap: 10px; margin: 8px 0;\n}\n\n.slot {\n  width: 60px; height: 60px;\n  border: 3px solid #8B7355; border-radius: 10px;\n  background: #FFFDF7; display: flex;\n  align-items: center; justify-content: center;\n  font-size: 28px; font-weight: bold; color: #2C2C2C;\n  cursor: pointer; transition: all 0.2s;\n  position: relative;\n}\n.slot.filled { background: #FFF8E8; border-color: #C84B31; }\n.slot.correct {\n  background: #27AE60; border-color: #27AE60; color: white;\n  animation: correctPulse 0.4s;\n}\n.slot.wrong {\n  background: #E74C3C; border-color: #E74C3C; color: white;\n  animation: wrongShake 0.5s;\n}\n\n@keyframes correctPulse {\n  0%, 100% { transform: scale(1); }\n  50% { transform: scale(1.12); }\n}\n@keyframes wrongShake {\n  0%, 100% { transform: translateX(0); }\n  25% { transform: translateX(-8px); }\n  75% { transform: translateX(8px); }\n}\n\n.idiom-hint {\n  font-size: 13px; color: #8B7355; text-align: center;\n  padding: 6px 12px; background: rgba(255,255,255,0.7);\n  border-radius: 8px; display: none; max-width: 90%;\n}\n.idiom-hint strong { color: #C84B31; }\n\n.candidates-container {\n  display: flex; flex-wrap: wrap; gap: 8px;\n  justify-content: center; max-width: 340px; margin-top: 8px;\n}\n\n.candidate {\n  width: 48px; height: 48px; border: none; border-radius: 10px;\n  background: linear-gradient(135deg, #C84B31, #A63A22);\n  color: white; font-size: 22px; font-weight: bold;\n  cursor: pointer; transition: all 0.15s;\n  display: flex; align-items: center; justify-content: center;\n}\n.candidate:active { transform: scale(0.9); }\n.candidate.used {\n  opacity: 0.25; pointer-events: none; transform: scale(0.9);\n}\n.candidate.removed {\n  opacity: 0.1; pointer-events: none;\n}\n\n.game-footer {\n  display: flex; justify-content: center; gap: 12px;\n  padding: 12px 16px; background: rgba(255,255,255,0.9);\n  border-top: 1px solid #E8DED0;\n}\n\n.tool-btn {\n  padding: 8px 16px; border: 2px solid #2D6A4F;\n  border-radius: 20px; background: white;\n  color: #2D6A4F; font-size: 14px; cursor: pointer;\n  transition: all 0.15s;\n}\n.tool-btn:active { background: #2D6A4F; color: white; }\n\n/* ===== 教学覆盖层 ===== */\n.tutorial-overlay {\n  position: absolute; bottom: 0; left: 0; right: 0;\n  background: rgba(0,0,0,0.7); padding: 20px;\n  display: flex; align-items: center; justify-content: center;\n  z-index: 100;\n}\n.tutorial-text {\n  color: white; font-size: 16px; text-align: center;\n  line-height: 1.5; max-width: 80%;\n}\n\n/* ===== 结算界面 ===== */\n.result-card {\n  flex: 1; display: flex; flex-direction: column;\n  align-items: center; justify-content: center;\n  background: linear-gradient(180deg, #FFFDF7, #F5F0E8);\n  padding: 40px 20px;\n}\n\n.result-title {\n  font-size: 36px; color: #C84B31; margin-bottom: 16px;\n}\n\n.result-stars {\n  font-size: 40px; color: #D4A843; margin-bottom: 20px;\n  display: flex; gap: 8px;\n}\n\n.result-stats {\n  text-align: center; margin-bottom: 24px; line-height: 2;\n  font-size: 16px;\n}\n.coins-earned {\n  font-size: 20px; font-weight: bold; color: #D4A843;\n  margin-top: 8px;\n}\n\n.result-buttons {\n  display: flex; flex-direction: column; gap: 10px; width: 220px;\n}\n\n/* ===== 模态框 ===== */\n.modal {\n  position: absolute; top: 0; left: 0; right: 0; bottom: 0;\n  background: rgba(0,0,0,0.6); display: flex;\n  align-items: center; justify-content: center; z-index: 200;\n}\n.modal-content {\n  background: #FFFDF7; border-radius: 20px; padding: 30px;\n  text-align: center; max-width: 320px; width: 90%;\n}\n.modal-content h3 { font-size: 22px; color: #C84B31; margin-bottom: 12px; }\n.modal-content p { margin-bottom: 20px; color: #8B7355; }\n.modal-buttons { display: flex; gap: 12px; justify-content: center; }\n","numLines":297,"startLine":1,"totalLines":297}}}
