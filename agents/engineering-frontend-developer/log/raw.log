{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_653fd87e8d074588a850d18b","type":"tool_result","content":"1\t// ScoreSystem.js — Score, moves, goals (score/collect_color/clear_obstacle/boss/dual), stars\n2\t\n3\tclass ScoreSystem {\n4\t  constructor() {\n5\t    this.score = 0;\n6\t    this.moves = 0;\n7\t    this.maxMoves = 30;\n8\t    this.goalType = 'score';\n9\t    this.goalTarget = 1000;\n10\t    this.goalProgress = 0;\n11\t    this.level = 1;\n12\t    this.stars = [0, 0, 0];\n13\t    this.collected = {};\n14\t    this.obstaclesCleared = {};\n15\t    this.totalObstaclesCleared = 0;\n16\t    this.chainCount = 0;\n17\t    this.config = null;\n18\t\n19\t    // Dual goal support\n20\t    this.dualGoals = [];\n21\t\n22\t    // Collect_color specifics\n23\t    this.collectColors = [];\n24\t\n25\t    // Clear_obstacle specifics\n26\t    this.clearObstacleType = 0;\n27\t\n28\t    this.onScoreChange = null;\n29\t    this.onMovesChange = null;\n30\t    this.onLevelComplete = null;\n31\t    this.onLevelFail = null;\n32\t  }\n33\t\n34\t  reset(level = 1) {\n35\t    this.score = 0;\n36\t    this.moves = 0;\n37\t    this.goalProgress = 0;\n38\t    this.chainCount = 0;\n39\t    this.collected = {};\n40\t    this.obstaclesCleared = {};\n41\t    this.totalObstaclesCleared = 0;\n42\t    this.dualGoals = [];\n43\t    this.collectColors = [];\n44\t    this.clearObstacleType = 0;\n45\t    this.level = level;\n46\t  }\n47\t\n48\t  configure(config) {\n49\t    this.config = config;\n50\t    this.maxMoves = config.moves || 30;\n51\t    this.goalType = config.goal?.type || 'score';\n52\t    this.goalTarget = config.goal?.target || 1000;\n53\t    this.stars = config.stars || [1000, 1500, 2000];\n54\t\n55\t    if (this.goalType === 'collect_color') {\n56\t      this.collectColors = config.goal?.colors || [];\n57\t    } else if (this.goalType === 'clear_obstacle') {\n58\t      this.clearObstacleType = config.goal?.obstacleType || 0;\n59\t    } else if (this.goalType === 'dual') {\n60\t      this.dualGoals = (config.goal?.goals || []).map(g => ({\n61\t        type: g.type,\n62\t        target: g.target,\n63\t        progress: 0,\n64\t        colors: g.colors || [],\n65\t        obstacleType: g.obstacleType || 0,\n66\t      }));\n67\t    }\n68\t  }\n69\t\n70\t  useMove() {\n71\t    this.moves++;\n72\t    if (this.onMovesChange) this.onMovesChange(this.getRemainingMoves());\n73\t    return this.getRemainingMoves() >= 0;\n74\t  }\n75\t\n76\t  getRemainingMoves() {\n77\t    return this.maxMoves - this.moves;\n78\t  }\n79\t\n80\t  addScore(points) {\n81\t    this.score += points;\n82\t    if (this.goalType === 'score') {\n83\t      this.goalProgress = this.score;\n84\t    }\n85\t    // Update dual score goals\n86\t    for (const dg of this.dualGoals) {\n87\t      if (dg.type === 'score') dg.progress = this.score;\n88\t    }\n89\t    if (this.onScoreChange) this.onScoreChange(this.score);\n90\t  }\n91\t\n92\t  addChainScore(basePoints, chainLevel) {\n93\t    const multiplier = chainLevel <= 1 ? 1 : chainLevel === 2 ? 1.5 : chainLevel === 3 ? 2.0 : 2.5;\n94\t    const points = Math.floor(basePoints * multiplier);\n95\t    this.addScore(points);\n96\t    this.chainCount = Math.max(this.chainCount, chainLevel);\n97\t    return points;\n98\t  }\n99\t\n100\t  addCollected(color, count) {\n101\t    this.collected[color] = (this.collected[color] || 0) + count;\n102\t    this._updateCollectProgress();\n103\t  }\n104\t\n105\t  _updateCollectProgress() {\n106\t    if (this.goalType === 'collect_color') {\n107\t      let total = 0;\n108\t      for (const c of this.collectColors) {\n109\t        total += this.collected[c] || 0;\n110\t      }\n111\t      this.goalProgress = total;\n112\t    }\n113\t    for (const dg of this.dualGoals) {\n114\t      if (dg.type === 'collect_color') {\n115\t        let total = 0;\n116\t        for (const c of dg.colors) {\n117\t          total += this.collected[c] || 0;\n118\t        }\n119\t        dg.progress = t