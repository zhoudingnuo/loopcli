is.judge.startQuestion(q);\n          this.render();\n        }, 600);\n      }\n    }\n  }\n\n  removeSlot(slotIndex) {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const result = this.judge.removeSlot(slotIndex);\n    if (result.action === 'removed') this.audio.playPlace();\n    this.render();\n    return result;\n  }\n\n  useHintReveal() {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const fc = this.judge.getFillCount();\n    if (fc >= 4) return null;\n\n    // Character skill: free hint\n    const skillResult = this.characters.applySkill({ event: 'hint' });\n    if (!skillResult.triggered) {\n      if (this.data.coins < this.hintRevealCost) {\n        alert('金币不足');\n        return null;\n      }\n      this.data.spendCoins(this.hintRevealCost);\n    }\n\n    const ch = this.judge.currentIdiom.chars[fc];\n    const cand = q.candidates.find(c => c.char === ch && !c.used);\n    if (!cand) return null;\n    this.usedHintThisQuestion = true;\n    this.audio.playHint();\n    const result = this.judge.placeChar(cand.index);\n    if (result.fillCount === 4) setTimeout(() => this._handleFull(result), 400);\n    this.render();\n    return result;\n  }\n\n  useHintRemove() {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n\n    if (this.data.coins < this.hintRemoveCost) {\n      alert('金币不足');\n      return null;\n    }\n    this.data.spendCoins(this.hintRemoveCost);\n\n    const wrong = q.candidates.filter(c => !c.used && !this.judge.currentIdiom.chars.includes(c.char) && !c.removed);\n    const removed = [];\n    const cnt = Math.min(2, wrong.length);\n    for (let i = 0; i < cnt; i++) {\n      const idx = Math.floor(Math.random() * wrong.length);\n      wrong[idx].removed = true;\n      removed.push(wrong[idx]);\n      wrong.splice(idx, 1);\n    }\n    this.audio.playRemove();\n    this.render();\n    return { action: 'removed_distractors', removed };\n  }\n\n  skipQuestion() {\n    if (this.state !== 'playing') return;\n    if (this.data.coins < this.skipCost) {\n      alert('金币不足');\n      return;\n    }\n    this.data.spendCoins(this.skipCost);\n    const q = this.questions[this.questionIndex];\n    if (q) { q.answered = true; q.correct = false; q.skipped = true; }\n    this.combo.onSkip();\n    this.questionIndex++;\n    this._startQuestion();\n    this.render();\n  }\n\n  continueWithAd() {\n    if (this.continuedOnce) return false;\n    this.lives = 3;\n    this.continuedOnce = true;\n    const q = this.questions[this.questionIndex];\n    if (q) { q.answered = false; q.correct = null; this.judge.startQuestion(q); }\n    this.render();\n    return true;\n  }\n\n  finishLevel() {\n    this.state = 'result';\n    document.getElementById('continue-modal').style.display = 'none';\n    const s = this.combo.getStats();\n    const stars = this.combo.getStarRating(s.correctCount, this.questions.length);\n\n    if (stars > 0 && this.currentLevel) {\n      this.data.setLevelStars(this.currentLevel.id, stars);\n      this.data.addCoins(this.currentLevel.reward.coins);\n      this.data.addScore(s.score);\n      this.data.updateBestCombo(s.maxCombo);\n      this.data.addExp(this.currentLevel.reward.exp || 10);\n      this.daily.updateTaskProgress('level', 1);\n      this.daily.updateTaskProgress('collect', s.correctCount);\n    }\n\n    this.levelResult = {\n      stars, correctCount: s.correctCount, totalQuestions: this.questions.length,\n      score: s.score, maxCombo: s.maxCombo,\n      coins: stars > 0 ? this.currentLevel.reward.coins : 0\n    };\n    if (stars > 0) this.audio.playLevelWin(); else this.audio.playLevelFail();\n    this.render();\n  }\n\n  // ===== W2: Timed Challenge =====\n  startTimedChallenge() {\n    this.state = 'timed';\n    this.timed.onUpdate = (evt) => {\n      if (evt === 'end') {\n        this.state = 'timed_result';\n      }\n      this.render();\n    };\n    this.timed.start();\n  }\n\n  // ===== W2: PK Mode =====\n  startPK(opponentResult) {\n    this.state = 'pk';\n    this.pk.onUpdate = (evt) => {\n      if (evt === 'end') {\n        this.state = 'pk_result';\n      }\n      this.render();\n    };\n    this.pk.start(opponentResult);\n  }\n\n  // ===== W2: Collection =====\n  showCollection() {\n    this.state = 'collection';\n    this.render();\n  }\n\n  // ===== W2: Daily =====\n  showDaily() {\n    this.state = 'daily';\n    this.render();\n  }\n\n  // ===== W2: Characters =====\n  showCharacters() {\n    this.state = 'characters';\n    this.render();\n  }\n\n  showLevelMap() {\n    this.state = 'map';\n    this.render();\n  }\n\n  goToMenu() {\n    this.state = 'menu';\n    this.tutorial.end();\n    this.render();\n  }\n\n  getCurrentQuestion() { return this.questions[this.questionIndex]; }\n\n  render() { if (typeof renderUI === 'function') renderUI(this); }\n}\n\nfunction handleHintReveal() { game.useHintReveal(); }\nfunction handleHintRemove() { game.useHintRemove(); }\nfunction handleSkip() { game.skipQuestion(); }\n\nif (typeof module !== 'undefined') module.exports = { Game };\n","structuredPatch":[{"oldStart":143,"oldLines":6,"newStart":143,"newLines":7,"lines":["       this.audio.playWrong();","       this.combo.onWrong();","       this.lives--;","+      this.analytics.trackQuestionAnswer(false, 0, false, 0);","       this.render();","       if (this.lives <= 0) {","         if (!this.continuedOnce) {"]}],"userModified":false,"replaceAll":false}}
