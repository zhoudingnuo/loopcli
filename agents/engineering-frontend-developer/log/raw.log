{"type":"assistant","message":{"id":"msg_2026052306071559f4c3204b2e4516","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_6f8806a8b79d4da49b26601a","name":"Write","input":{"file_path":"D:\\game-projects\\douyin-match3\\src\\js\\AdManager.js","content":"// AdManager.js — 穿山甲SDK广告管理（存根模式），6个广告位，频率控制\n\nconst AD_PLACEMENTS = {\n  CONTINUE: 'continue',       // 续步激励视频（关卡失败）\n  BOOST: 'boost',             // 开局增益激励视频\n  DOUBLE: 'double',           // 双倍结算激励视频\n  INTERSTITIAL: 'interstitial', // 插屏广告\n  TREASURE: 'treasure',       // 宝箱加速激励视频\n  DAILY_DOUBLE: 'daily_double', // 每日签到翻倍\n};\n\nconst AD_LIMITS = {\n  REWARDED_DAILY: 12,\n  INTERSTITIAL_DAILY: 6,\n  COOLDOWN_MS: 60000,\n  NEW_USER_FREE_LEVELS: 3,\n  INTERSTITIAL_LEVEL_INTERVAL: 3,\n};\n\nclass AdManager {\n  constructor(dataManager) {\n    this.dm = dataManager;\n    this._initStorage();\n\n    // SDK stubs — real SDK loads only in 抖音 environment\n    this.isDouyin = typeof tt !== 'undefined' && typeof tt.createRewardedVideoAd === 'function';\n    this.rewardedAd = null;\n    this.interstitialAd = null;\n\n    if (this.isDouyin) this._initSDK();\n\n    // State\n    this._pendingResolve = null;\n    this._currentPlacement = null;\n    this._showingUI = false;\n  }\n\n  _initStorage() {\n    if (!this.dm.data.adState) {\n      this.dm.data.adState = {\n        dailyRewarded: 0,\n        dailyInterstitial: 0,\n        lastShowTime: {},\n        lastInterstitialLevel: 0,\n        date: this._todayStr(),\n        consecutiveFails: 0,\n      };\n      this.dm.save();\n    }\n    this.adState = this.dm.data.adState;\n    this._resetDaily();\n  }\n\n  _todayStr() { return new Date().toISOString().slice(0, 10); }\n\n  _resetDaily() {\n    if (this.adState.date !== this._todayStr()) {\n      this.adState.dailyRewarded = 0;\n      this.adState.dailyInterstitial = 0;\n      this.adState.date = this._todayStr();\n      this.dm.save();\n    }\n  }\n\n  _initSDK() {\n    try {\n      this.rewardedAd = tt.createRewardedVideoAd({\n        adUnitId: 'adunit-placeholder-rewarded',\n      });\n      this.rewardedAd.onError(() => {});\n      this.rewardedAd.onClose((res) => {\n        if (this._pendingResolve) {\n          this._pendingResolve(res && res.isEnded);\n          this._pendingResolve = null;\n        }\n      });\n\n      this.interstitialAd = tt.createInterstitialAd({\n        adUnitId: 'adunit-placeholder-interstitial',\n      });\n      this.interstitialAd.onError(() => {});\n    } catch (e) {\n      this.isDouyin = false;\n    }\n  }\n\n  // --- Frequency checks ---\n  isNewUser() {\n    return this.dm.unlockedLevel <= AD_LIMITS.NEW_USER_FREE_LEVELS;\n  }\n\n  canShowRewarded(placement) {\n    this._resetDaily();\n    if (this.isNewUser()) return false;\n    if (this.adState.dailyRewarded >= AD_LIMITS.REWARDED_DAILY) return false;\n    if (this._inCooldown(placement)) return false;\n    return true;\n  }\n\n  canShowInterstitial(currentLevel) {\n    this._resetDaily();\n    if (this.isNewUser()) return false;\n    if (this.adState.dailyInterstitial >= AD_LIMITS.INTERSTITIAL_DAILY) return false;\n    if (this.adState.consecutiveFails >= 2) return false;\n    const lastLevel = this.adState.lastInterstitialLevel || 0;\n    if (currentLevel - lastLevel < AD_LIMITS.INTERSTITIAL_LEVEL_INTERVAL) return false;\n    if (this._inCooldown(AD_PLACEMENTS.INTERSTITIAL)) return false;\n    return true;\n  }\n\n  _inCooldown(placement) {\n    const last = this.adState.lastShowTime[placement] || 0;\n    return Date.now() - last < AD_LIMITS.COOLDOWN_MS;\n  }\n\n  // --- Show rewarded video ---\n  showRewarded(placement) {\n    if (!this.canShowRewarded(placement)) return Promise.resolve(false);\n\n    this._currentPlacement = placement;\n\n    if (this.isDouyin && this.rewardedAd) {\n      return new Promise((resolve) => {\n        this._pendingResolve = resolve;\n        this.rewardedAd.show().catch(() => {\n          this.rewardedAd.load().then(() => {\n            this.rewardedAd.show().catch(() => resolve(false));\n          }).catch(() => resolve(false));\n        });\n      }).then((success) => {\n        if (success) this._onAdComplete(placement);\n        return success;\n      });\n    }\n\n    // Stub mode: simulate ad with a UI overlay\n    return this._showStubAd(placement);\n  }\n\n  // --- Show interstitial ---\n  showInterstitial(currentLevel) {\n    if (!this.canShowInterstitial(currentLevel)) return Promise.resolve(false);\n\n    if (this.isDouyin && this.interstitialAd) {\n      return new Promise((resolve) => {\n        this.interstitialAd.show().then(() => {\n          this.adState.dailyInterstitial++;\n          this.adState.lastInterstitialLevel = currentLevel;\n          this.adState.lastShowTime[AD_PLACEMENTS.INTERSTITIAL] = Date.now();\n          this.dm.save();\n          setTimeout(() => resolve(true), 5000);\n        }).catch(() => resolve(false));\n      });\n    }\n\n    // Stub: simulate 2s interstitial\n    return new Promise((resolve) => {\n      this._showingUI = true;\n      this._stubInterstitial = true;\n      this._stubTimer = 2;\n      this.adState.dailyInterstitial++;\n      this.adState.lastInterstitialLevel = currentLevel;\n      this.adState.lastShowTime[AD_PLACEMENTS.INTERSTITIAL] = Date.now();\n      this.dm.save();\n      setTimeout(() => {\n        this._showingUI = false;\n        this._stubInterstitial = false;\n        resolve(true);\n      }, 2000);\n    });\n  }\n\n  _onAdComplete(placement) {\n    this.adState.dailyRewarded++;\n    this.adState.lastShowTime[placement] = Date.now();\n    this.dm.save();\n  }\n\n  // --- Stub ad simulation ---\n  _showStubAd(placement) {\n    return new Promise((resolve) => {\n      this._showingUI = true;\n      this._stubPlacement = placement;\n      this._stubTimer = 3; // 3 second simulated ad\n      this._stubResolve = resolve;\n    });\n  }\n\n  _completeStubAd(watched) {\n    this._showingUI = false;\n    if (watched) this._onAdComplete(this._stubPlacement);\n    if (this._stubResolve) {\n      this._stubResolve(watched);\n      this._stubResolve = null;\n    }\n  }\n\n  // --- Fail tracking for interstitial suppression ---\n  reportFail() {\n    this.adState.consecutiveFails++;\n    this.dm.save();\n  }\n\n  reportSuccess() {\n    this.adState.consecutiveFails = 0;\n    this.dm.save();\n  }\n\n  // --- Rendering (stub ad UI) ---\n  update(dt) {\n    if (this._stubTimer > 0) {\n      this._stubTimer -= dt;\n    }\n  }\n\n  renderStubAd(ctx, w, h) {\n    if (!this._showingUI) return false;\n\n    if (this._stubInterstitial) {\n      // Interstitial overlay\n      ctx.fillStyle = 'rgba(0,0,0,0.85)';\n      ctx.fillRect(0, 0, w, h);\n\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 20px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText('📢 广告', w / 2, h / 2 - 30);\n\n      ctx.font = '14px sans-serif';\n      ctx.fillStyle = '#CCC';\n      ctx.fillText('插屏广告模拟', w / 2, h / 2);\n\n      const remaining = Math.ceil(this._stubTimer);\n      ctx.font = 'bold 24px sans-serif';\n      ctx.fillStyle = '#FFB800';\n      ctx.fillText(`${remaining}s`, w / 2, h / 2 + 40);\n      return true;\n    }\n\n    // Rewarded video stub\n    ctx.fillStyle = 'rgba(0,0,0,0.9)';\n    ctx.fillRect(0, 0, w, h);\n\n    // Fake ad content\n    ctx.fillStyle = '#FFB800';\n    ctx.font = 'bold 18px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('🎬 激励视频广告', w / 2, h / 2 - 60);\n\n    ctx.fillStyle = '#FFF';\n    ctx.font = '14px sans-serif';\n    ctx.fillText(`广告位: ${this._stubPlacement}`, w / 2, h / 2 - 30);\n    ctx.fillText('（开发模式模拟广告）', w / 2, h / 2);\n\n    // Countdown\n    const remaining = Math.ceil(this._stubTimer);\n    if (remaining > 0) {\n      ctx.font = 'bold 32px sans-serif';\n      ctx.fillStyle = '#FFB800';\n      ctx.fillText(`${remaining}s`, w / 2, h / 2 + 50);\n    }\n\n    // Close/complete button (appears after timer)\n    if (remaining <= 0) {\n      const btnW = 160, btnH = 44;\n      const btnX = (w - btnW) / 2, btnY = h / 2 + 70;\n      ctx.fillStyle = '#6BCB77';\n      this._roundRect(ctx, btnX, btnY, btnW, btnH, btnH / 2);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText('✓ 观看完成', w / 2, btnY + 28);\n\n      // Skip button\n      ctx.fillStyle = '#666';\n      ctx.font = '12px sans-serif';\n      ctx.fillText('跳过（无奖励）', w / 2, btnY + btnH + 24);\n    }\n\n    return true;\n  }\n\n  handleStubClick(x, y, w, h) {\n    if (!this._showingUI || this._stubInterstitial) return false;\n    if (this._stubTimer > 0) return true; // consume click during countdown\n\n    const btnW = 160, btnH = 44;\n    const btnX = (w - btnW) / 2, btnY = h / 2 + 70;\n\n    // Complete button\n    if (x >= btnX && x <= btnX + btnW && y >= btnY && y <= btnY + btnH) {\n      this._completeStubAd(true);\n      return true;\n    }\n\n    // Skip area\n    if (y >= btnY + btnH && y <= btnY + btnH + 40) {\n      this._completeStubAd(false);\n      return true;\n    }\n\n    return true; // consume all clicks while ad showing\n  }\n\n  // --- Ad button helper for UI ---\n  static shouldShowAdButton(adManager, placement) {\n    return adManager && adManager.canShowRewarded(placement);\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { AdManager, AD_PLACEMENTS, AD_LIMITS };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"e7014494-9372-468d-b98b-69448d1a0f88","uuid":"0143efd1-41af-4d3b-bbb7-a69262ca2c56"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6f8806a8b79d4da49b26601a","type":"tool_result","content":"File created successfully at: D:\\game-projects\\douyin-match3\\src\\js\\AdManager.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"e7014494-9372-468d-b98b-69448d1a0f88","uuid":"2157f437-a302-48b5-a045-760cf144aa7c","timestamp":"2026-05-22T22:07:53.896Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\douyin-match3\\src\\js\\AdManager.js","content":"// AdManager.js — 穿山甲SDK广告管理（存根模式），6个广告位，频率控制\n\nconst AD_PLACEMENTS = {\n  CONTINUE: 'continue',       // 续步激励视频（关卡失败）\n  BOOST: 'boost',             // 开局增益激励视频\n  DOUBLE: 'double',           // 双倍结算激励视频\n  INTERSTITIAL: 'interstitial', // 插屏广告\n  TREASURE: 'treasure',       // 宝箱加速激励视频\n  DAILY_DOUBLE: 'daily_double', // 每日签到翻倍\n};\n\nconst AD_LIMITS = {\n  REWARDED_DAILY: 12,\n  INTERSTITIAL_DAILY: 6,\n  COOLDOWN_MS: 60000,\n  NEW_USER_FREE_LEVELS: 3,\n  INTERSTITIAL_LEVEL_INTERVAL: 3,\n};\n\nclass AdManager {\n  constructor(dataManager) {\n    this.dm = dataManager;\n    this._initStorage();\n\n    // SDK stubs — real SDK loads only in 抖音 environment\n    this.isDouyin = typeof tt !== 'undefined' && typeof tt.createRewardedVideoAd === 'function';\n    this.rewardedAd = null;\n    this.interstitialAd = null;\n\n    if (this.isDouyin) this._initSDK();\n\n    // State\n    this._pendingResolve = null;\n    this._currentPlacement = null;\n    this._showingUI = false;\n  }\n\n  _initStorage() {\n    if (!this.dm.data.adState) {\n      this.dm.data.adState = {\n        dailyRewarded: 0,\n        dailyInterstitial: 0,\n        lastShowTime: {},\n        lastInterstitialLevel: 0,\n        date: this._todayStr(),\n        consecutiveFails: 0,\n      };\n      this.dm.save();\n    }\n    this.adState = this.dm.data.adState;\n    this._resetDaily();\n  }\n\n  _todayStr() { return new Date().toISOString().slice(0, 10); }\n\n  _resetDaily() {\n    if (this.adState.date !== this._todayStr()) {\n      this.adState.dailyRewarded = 0;\n      this.adState.dailyInterstitial = 0;\n      this.adState.date = this._todayStr();\n      this.dm.save();\n    }\n  }\n\n  _initSDK() {\n    try {\n      this.rewardedAd = tt.createRewardedVideoAd({\n        adUnitId: 'adunit-placeholder-rewarded',\n      });\n      this.rewardedAd.onError(() => {});\n      this.rewardedAd.onClose((res) => {\n        if (this._pendingResolve) {\n          this._pendingResolve(res && res.isEnded);\n          this._pendingResolve = null;\n        }\n      });\n\n      this.interstitialAd = tt.createInterstitialAd({\n        adUnitId: 'adunit-placeholder-interstitial',\n      });\n      this.interstitialAd.onError(() => {});\n    } catch (e) {\n      this.isDouyin = false;\n    }\n  }\n\n  // --- Frequency checks ---\n  isNewUser() {\n    return this.dm.unlockedLevel <= AD_LIMITS.NEW_USER_FREE_LEVELS;\n  }\n\n  canShowRewarded(placement) {\n    this._resetDaily();\n    if (this.isNewUser()) return false;\n    if (this.adState.dailyRewarded >= AD_LIMITS.REWARDED_DAILY) return false;\n    if (this._inCooldown(placement)) return false;\n    return true;\n  }\n\n  canShowInterstitial(currentLevel) {\n    this._resetDaily();\n    if (this.isNewUser()) return false;\n    if (this.adState.dailyInterstitial >= AD_LIMITS.INTERSTITIAL_DAILY) return false;\n    if (this.adState.consecutiveFails >= 2) return false;\n    const lastLevel = this.adState.lastInterstitialLevel || 0;\n    if (currentLevel - lastLevel < AD_LIMITS.INTERSTITIAL_LEVEL_INTERVAL) return false;\n    if (this._inCooldown(AD_PLACEMENTS.INTERSTITIAL)) return false;\n    return true;\n  }\n\n  _inCooldown(placement) {\n    const last = this.adState.lastShowTime[placement] || 0;\n    return Date.now() - last < AD_LIMITS.COOLDOWN_MS;\n  }\n\n  // --- Show rewarded video ---\n  showRewarded(placement) {\n    if (!this.canShowRewarded(placement)) return Promise.resolve(false);\n\n    this._currentPlacement = placement;\n\n    if (this.isDouyin && this.rewardedAd) {\n      return new Promise((resolve) => {\n        this._pendingResolve = resolve;\n        this.rewardedAd.show().catch(() => {\n          this.rewardedAd.load().then(() => {\n            this.rewardedAd.show().catch(() => resolve(false));\n          }).catch(() => resolve(false));\n        });\n      }).then((success) => {\n        if (success) this._onAdComplete(placement);\n        return success;\n      });\n    }\n\n    // Stub mode: simulate ad with a UI overlay\n    return this._showStubAd(placement);\n  }\n\n  // --- Show interstitial ---\n  showInterstitial(currentLevel) {\n    if (!this.canShowInterstitial(currentLevel)) return Promise.resolve(false);\n\n    if (this.isDouyin && this.interstitialAd) {\n      return new Promise((resolve) => {\n        this.interstitialAd.show().then(() => {\n          this.adState.dailyInterstitial++;\n          this.adState.lastInterstitialLevel = currentLevel;\n          this.adState.lastShowTime[AD_PLACEMENTS.INTERSTITIAL] = Date.now();\n          this.dm.save();\n          setTimeout(() => resolve(true), 5000);\n        }).catch(() => resolve(false));\n      });\n    }\n\n    // Stub: simulate 2s interstitial\n    return new Promise((resolve) => {\n      this._showingUI = true;\n      this._stubInterstitial = true;\n      this._stubTimer = 2;\n      this.adState.dailyInterstitial++;\n      this.adState.lastInterstitialLevel = currentLevel;\n      this.adState.lastShowTime[AD_PLACEMENTS.INTERSTITIAL] = Date.now();\n      this.dm.save();\n      setTimeout(() => {\n        this._showingUI = false;\n        this._stubInterstitial = false;\n        resolve(true);\n      }, 2000);\n    });\n  }\n\n  _onAdComplete(placement) {\n    this.adState.dailyRewarded++;\n    this.adState.lastShowTime[placement] = Date.now();\n    this.dm.save();\n  }\n\n  // --- Stub ad simulation ---\n  _showStubAd(placement) {\n    return new Promise((resolve) => {\n      this._showingUI = true;\n      this._stubPlacement = placement;\n      this._stubTimer = 3; // 3 second simulated ad\n      this._stubResolve = resolve;\n    });\n  }\n\n  _completeStubAd(watched) {\n    this._showingUI = false;\n    if (watched) this._onAdComplete(this._stubPlacement);\n    if (this._stubResolve) {\n      this._stubResolve(watched);\n      this._stubResolve = null;\n    }\n  }\n\n  // --- Fail tracking for interstitial suppression ---\n  reportFail() {\n    this.adState.consecutiveFails++;\n    this.dm.save();\n  }\n\n  reportSuccess() {\n    this.adState.consecutiveFails = 0;\n    this.dm.save();\n  }\n\n  // --- Rendering (stub ad UI) ---\n  update(dt) {\n    if (this._stubTimer > 0) {\n      this._stubTimer -= dt;\n    }\n  }\n\n  renderStubAd(ctx, w, h) {\n    if (!this._showingUI) return false;\n\n    if (this._stubInterstitial) {\n      // Interstitial overlay\n      ctx.fillStyle = 'rgba(0,0,0,0.85)';\n      ctx.fillRect(0, 0, w, h);\n\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 20px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText('📢 广告', w / 2, h / 2 - 30);\n\n      ctx.font = '14px sans-serif';\n      ctx.fillStyle = '#CCC';\n      ctx.fillText('插屏广告模拟', w / 2, h / 2);\n\n      const remaining = Math.ceil(this._stubTimer);\n      ctx.font = 'bold 24px sans-serif';\n      ctx.fillStyle = '#FFB800';\n      ctx.fillText(`${remaining}s`, w / 2, h / 2 + 40);\n      return true;\n    }\n\n    // Rewarded video stub\n    ctx.fillStyle = 'rgba(0,0,0,0.9)';\n    ctx.fillRect(0, 0, w, h);\n\n    // Fake ad content\n    ctx.fillStyle = '#FFB800';\n    ctx.font = 'bold 18px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('🎬 激励视频广告', w / 2, h / 2 - 60);\n\n    ctx.fillStyle = '#FFF';\n    ctx.font = '14px sans-serif';\n    ctx.fillText(`广告位: ${this._stubPlacement}`, w / 2, h / 2 - 30);\n    ctx.fillText('（开发模式模拟广告）', w / 2, h / 2);\n\n    // Countdown\n    const remaining = Math.ceil(this._stubTimer);\n    if (remaining > 0) {\n      ctx.font = 'bold 32px sans-serif';\n      ctx.fillStyle = '#FFB800';\n      ctx.fillText(`${remaining}s`, w / 2, h / 2 + 50);\n    }\n\n    // Close/complete button (appears after timer)\n    if (remaining <= 0) {\n      const btnW = 160, btnH = 44;\n      const btnX = (w - btnW) / 2, btnY = h / 2 + 70;\n      ctx.fillStyle = '#6BCB77';\n      this._roundRect(ctx, btnX, btnY, btnW, btnH, btnH / 2);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText('✓ 观看完成', w / 2, btnY + 28);\n\n      // Skip button\n      ctx.fillStyle = '#666';\n      ctx.font = '12px sans-serif';\n      ctx.fillText('跳过（无奖励）', w / 2, btnY + btnH + 24);\n    }\n\n    return true;\n  }\n\n  handleStubClick(x, y, w, h) {\n    if (!this._showingUI || this._stubInterstitial) return false;\n    if (this._stubTimer > 0) return true; // consume click during countdown\n\n    const btnW = 160, btnH = 44;\n    const btnX = (w - btnW) / 2, btnY = h / 2 + 70;\n\n    // Complete button\n    if (x >= btnX && x <= btnX + btnW && y >= btnY && y <= btnY + btnH) {\n      this._completeStubAd(true);\n      return true;\n    }\n\n    // Skip area\n    if (y >= btnY + btnH && y <= btnY + btnH + 40) {\n      this._completeStubAd(false);\n      return true;\n    }\n\n    return true; // consume all clicks while ad showing\n  }\n\n  // --- Ad button helper for UI ---\n  static shouldShowAdButton(adManager, placement) {\n    return adManager && adManager.canShowRewarded(placement);\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { AdManager, AD_PLACEMENTS, AD_LIMITS };\n","structuredPatch":[],"originalFile":null,"userModified":false}}
