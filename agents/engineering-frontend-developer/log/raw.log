,"originalFile":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>修仙自动化工厂 — Cultivation Factory</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body {\n      background: #1a1a2e;\n      color: #e0e0e0;\n      font-family: 'Segoe UI', system-ui, monospace;\n      overflow: hidden;\n      height: 100vh;\n      width: 100vw;\n    }\n    #app {\n      display: flex;\n      flex-direction: column;\n      height: 100vh;\n    }\n    #toolbar {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      padding: 6px 12px;\n      background: rgba(0,0,0,0.6);\n      border-bottom: 1px solid rgba(255,255,255,0.1);\n      min-height: 44px;\n      flex-shrink: 0;\n    }\n    #toolbar h1 {\n      font-size: 16px;\n      color: #ffd700;\n      margin-right: 12px;\n      white-space: nowrap;\n    }\n    #toolbar .spacer { flex: 1; }\n    .toolbar-btn {\n      background: rgba(255,255,255,0.08);\n      border: 1px solid rgba(255,255,255,0.15);\n      color: #e0e0e0;\n      padding: 4px 12px;\n      border-radius: 4px;\n      cursor: pointer;\n      font-size: 12px;\n      transition: background 0.2s;\n    }\n    .toolbar-btn:hover { background: rgba(255,255,255,0.15); }\n    .toolbar-btn.active { background: rgba(100,200,100,0.3); border-color: #6c6; }\n    #main {\n      display: flex;\n      flex: 1;\n      overflow: hidden;\n    }\n    #sidebar {\n      width: 220px;\n      background: rgba(0,0,0,0.5);\n      border-right: 1px solid rgba(255,255,255,0.1);\n      overflow-y: auto;\n      flex-shrink: 0;\n    }\n    .sidebar-section {\n      padding: 8px;\n      border-bottom: 1px solid rgba(255,255,255,0.05);\n    }\n    .sidebar-section h3 {\n      font-size: 12px;\n      color: #aaa;\n      margin-bottom: 6px;\n      text-transform: uppercase;\n    }\n    .building-item {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      padding: 6px 8px;\n      margin: 2px 0;\n      border-radius: 4px;\n      cursor: pointer;\n      transition: background 0.2s;\n      font-size: 12px;\n    }\n    .building-item:hover { background: rgba(255,255,255,0.1); }\n    .building-item.selected { background: rgba(100,200,100,0.2); border: 1px solid rgba(100,200,100,0.4); }\n    .building-item .icon { font-size: 18px; }\n    .building-item .info { flex: 1; }\n    .building-item .name { color: #e0e0e0; }\n    .building-item .cost { color: #888; font-size: 10px; }\n    .building-item .cost.cannot { color: #c44; }\n    #canvas-container {\n      flex: 1;\n      position: relative;\n    }\n    #gameCanvas {\n      display: block;\n      width: 100%;\n      height: 100%;\n    }\n    #info-panel {\n      width: 200px;\n      background: rgba(0,0,0,0.5);\n      border-left: 1px solid rgba(255,255,255,0.1);\n      overflow-y: auto;\n      flex-shrink: 0;\n      padding: 8px;\n    }\n    #info-panel h3 {\n      font-size: 12px;\n      color: #aaa;\n      margin-bottom: 6px;\n    }\n    .info-entry {\n      font-size: 11px;\n      padding: 3px 0;\n      color: #ccc;\n    }\n    #statusbar {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      padding: 4px 12px;\n      background: rgba(0,0,0,0.6);\n      border-top: 1px solid rgba(255,255,255,0.1);\n      font-size: 11px;\n      color: #888;\n      min-height: 28px;\n      flex-shrink: 0;\n    }\n    #statusbar .fps { color: #6a6; }\n    #placement-hint {\n      position: absolute;\n      bottom: 40px;\n      left: 50%;\n      transform: translateX(-50%);\n      background: rgba(0,0,0,0.8);\n      color: #ffd700;\n      padding: 6px 16px;\n      border-radius: 4px;\n      font-size: 12px;\n      pointer-events: none;\n      display: none;\n    }\n    /* Scrollbar styling */\n    ::-webkit-scrollbar { width: 6px; }\n    ::-webkit-scrollbar-track { background: transparent; }\n    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 3px; }\n  </style>\n</head>\n<body>\n  <div id=\"app\">\n    <div id=\"toolbar\">\n      <h1>⛰ 修仙工厂</h1>\n      <div class=\"spacer\"></div>\n      <button class=\"toolbar-btn\" id=\"btn-save\" title=\"保存游戏\">💾 保存</button>\n      <button class=\"toolbar-btn\" id=\"btn-center\" title=\"居中视角\">◎ 居中</button>\n      <button class=\"toolbar-btn\" id=\"btn-reset\" title=\"重置游戏\">⚠ 重置</button>\n    </div>\n    <div id=\"main\">\n      <div id=\"sidebar\">\n        <div class=\"sidebar-section\">\n          <h3>🏗 建筑设施</h3>\n          <div id=\"building-list\"></div>\n        </div>\n      </div>\n      <div id=\"canvas-container\">\n        <canvas id=\"gameCanvas\"></canvas>\n        <div id=\"placement-hint\">点击地图放置建筑 | ESC 取消</div>\n      </div>\n      <div id=\"info-panel\">\n        <h3>📊 信息</h3>\n        <div id=\"building-info\">点击建筑查看详情</div>\n      </div>\n    </div>\n    <div id=\"statusbar\">\n      <span class=\"fps\" id=\"fps-display\">FPS: --</span>\n      <span id=\"status-text\">就绪</span>\n      <div class=\"spacer\"></div>\n      <span id=\"playtime\">游玩时间: 0:00</span>\n    </div>\n  </div>\n\n  <script type=\"module\">\n    import { App } from './src/renderer/App.ts';\n\n    const canvas = document.getElementById('gameCanvas');\n    const app = new App(canvas);\n\n    // Center camera\n    app.centerCamera();\n\n    // FPS counter\n    let frameCount = 0;\n    let fpsTime = performance.now();\n    const fpsDisplay = document.getElementById('fps-display');\n    const statusText = document.getElementById('status-text');\n    const playtimeDisplay = document.getElementById('playtime');\n\n    setInterval(() => {\n      const now = performance.now();\n      const fps = Math.round(frameCount * 1000 / (now - fpsTime));\n      fpsDisplay.textContent = `FPS: ${fps}`;\n      frameCount = 0;\n      fpsTime = now;\n\n      // Update playtime\n      const secs = Math.floor(app.state.totalPlaytime);\n      const mins = Math.floor(secs / 60);\n      const hrs = Math.floor(mins / 60);\n      playtimeDisplay.textContent = `游玩时间: ${hrs}:${String(mins % 60).padStart(2, '0')}`;\n    }, 1000);\n\n    // Wrap the loop to count frames\n    const origLoop = app.loop.bind(app);\n    app.loop = (now) => {\n      frameCount++;\n      origLoop(now);\n    };\n\n    // Start game\n    app.start();\n\n    // === Building sidebar ===\n    const buildingList = document.getElementById('building-list');\n    const placementHint = document.getElementById('placement-hint');\n\n    function renderBuildingList() {\n      buildingList.innerHTML = '';\n      const available = app.getAvailableBuildings();\n      for (const def of available) {\n        const item = document.createElement('div');\n        item.className = 'building-item';\n        if (app.placementMode?.id === def.id) item.classList.add('selected');\n\n        const affordable = !Object.keys(def.cost).length ||\n          Object.entries(def.cost).every(([r, c]) =>\n            (app.state.resources[r] ?? 0) >= c);\n\n        const icon = getIcon(def.category);\n        const costStr = Object.entries(def.cost).length > 0\n          ? Object.entries(def.cost).map(([r, c]) => `${r}:${c}`).join(' ')\n          : '免费';\n\n        item.innerHTML = `\n          <span class=\"icon\">${icon}</span>\n          <div class=\"info\">\n            <div class=\"name\">${def.name}</div>\n            <div class=\"cost ${affordable ? '' : 'cannot'}\">${costStr}</div>\n          </div>\n        `;\n\n        item.addEventListener('click', () => {\n          if (app.placementMode?.id === def.id) {\n            app.placementMode = null;\n            placementHint.style.display = 'none';\n            statusText.textContent = '就绪';\n          } else {\n            app.placementMode = def;\n            placementHint.style.display = 'block';\n            statusText.textContent = `放置模式: ${def.name}`;\n          }\n          renderBuildingList();\n        });\n\n        buildingList.appendChild(item);\n      }\n    }\n\n    function getIcon(category) {\n      const icons = { mining: '⛏', farming: '🌿', alchemy: '🔥', energy: '✨' };\n      return icons[category] || '🏠';\n    }\n\n    renderBuildingList();\n\n    // Update sidebar on state change\n    app.onStateChange = (state) => {\n      renderBuildingList();\n      updateBuildingInfo(null);\n    };\n\n    app.onBuildingSelect = (building) => {\n      updateBuildingInfo(building);\n    };\n\n    function updateBuildingInfo(building) {\n      const infoDiv = document.getElementById('building-info');\n      if (!building) {\n        infoDiv.innerHTML = '<div class=\"info-entry\">点击建筑查看详情</div>';\n        return;\n      }\n      const def = app.buildingDefs.get(building.buildingId);\n      if (!def) return;\n      const prod = def.production;\n      infoDiv.innerHTML = `\n        <div class=\"info-entry\" style=\"color:#ffd700;font-weight:bold\">${def.name}</div>\n        <div class=\"info-entry\">等级: ${building.level}/${def.maxLevel}</div>\n        <div class=\"info-entry\">类型: ${prod.mode === 'manual' ? '手动' : '自动'}</div>\n        <div class=\"info-entry\">产出: ${prod.resource} ×${prod.amount}</div>\n        ${prod.interval > 0 ? `<div class=\"info-entry\">间隔: ${(prod.interval / 1000).toFixed(1)}s</div>` : ''}\n        ${prod.input ? `<div class=\"info-entry\">消耗: ${Object.entries(prod.input).map(([r,c]) => `${r}:${c}`).join(' ')}</div>` : ''}\n        <div class=\"info-entry\">状态: ${building.isProducing ? '生产中' : '空闲'}</div>\n        ${building.progress > 0 ? `<div class=\"info-entry\">进度: ${Math.floor(building.progress * 100)}%</div>` : ''}\n        ${prod.mode === 'manual' && def.category === 'mining' ? '<div class=\"info-entry\" style=\"color:#6c6;margin-top:4px\">点击采集灵石</div>' : ''}\n        ${prod.mode === 'manual' && def.category === 'farming' ? '<div class=\"info-entry\" style=\"color:#6c6;margin-top:4px\">点击种植/收获</div>' : ''}\n        ${prod.mode === 'manual' && def.category === 'alchemy' ? '<div class=\"info-entry\" style=\"color:#6c6;margin-top:4px\">点击炼丹</div>' : ''}\n      `;\n    }\n\n    // === Toolbar buttons ===\n    document.getElementById('btn-save').addEventListener('click', () => {\n      const { saveGame } = await import('./src/game/GameState.ts');\n      saveGame(app.state);\n      statusText.textContent = '💾 已保存';\n      setTimeout(() => { statusText.textContent = '就绪'; }, 2000);\n    });\n\n    document.getElementById('btn-center').addEventListener('click', () => {\n      app.centerCamera();\n    });\n\n    document.getElementById('btn-reset').addEventListener('click', () => {\n      if (confirm('确定要重置游戏进度吗？此操作不可撤销！')) {\n        const { clearSave } = await import('./src/game/GameState.ts');\n        clearSave();\n        location.reload();\n      }\n    });\n  </script>\n</body>\n</html>\n","structuredPatch":[{"oldStart":309,"oldLines":10,"newStart":309,"newLines":11,"lines":[" ","     // === Toolbar buttons ===","     document.getElementById('btn-save').addEventListener('click', () => {","-      const { saveGame } = await import('./src/game/GameState.ts');","-      saveGame(app.state);","-      statusText.textContent = '💾 已保存';","-      setTimeout(() => { statusText.textContent = '就绪'; }, 2000);","+      import('./src/game/GameState.ts').then(({ saveGame }) => {","+        saveGame(app.state);","+        statusText.textContent = '💾 已保存';","+        setTimeout(() => { statusText.textContent = '就绪'; }, 2000);","+      });","     });"," ","     document.getElementById('btn-center').addEventListener('click', () => {"]},{"oldStart":321,"oldLines":9,"newStart":322,"newLines":10,"lines":[" ","     document.getElementById('btn-reset').addEventListener('click', () => {","       if (confirm('确定要重置游戏进度吗？此操作不可撤销！')) {","-        const { clearSave } = await import('./src/game/GameState.ts');","-        clearSave();","-        location.reload();","+        import('./src/game/GameState.ts').then(({ clearSave }) => {","+          clearSave();","+          location.reload();","+        });","       }","     });","   </script>"]}],"userModified":false,"replaceAll":false}}
