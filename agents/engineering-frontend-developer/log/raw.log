{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f6b26db9752044eb8b63d784","type":"tool_result","content":"The file D:\\loopcli\\main\\webui\\index.html has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"55020855-5574-4a08-9f30-b9f8a07e6102","uuid":"51833d1f-bf18-4963-8d48-c1c2672c049c","timestamp":"2026-05-22T20:17:28.055Z","tool_use_result":{"filePath":"D:\\loopcli\\main\\webui\\index.html","oldString":"/* 响应式 */\n@media (max-width: 1024px) {\n  .sidebar { width: 220px; }\n  .agents-grid { grid-template-columns: 1fr; }\n}\n@media (max-width: 768px) {","newString":"/* 圆环图自适应 */\n.donut-chart-wrapper { flex-wrap: wrap; }\n.donut-chart-wrapper svg { max-width: 220px; }\n.donut-legend { flex: 1; min-width: 130px; }\n@media (max-width: 480px) {\n  .donut-chart-wrapper { flex-direction: column; gap: 16px !important; }\n  .donut-chart-wrapper svg { max-width: 160px; }\n  .donut-legend { min-width: 100%; }\n}\n\n/* 响应式 */\n@media (max-width: 1024px) {\n  .sidebar { width: 220px; }\n  .agents-grid { grid-template-columns: 1fr; }\n}\n@media (max-width: 768px) {","originalFile":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>LoopCLI - Agent 控制台 v8.8</title>\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css\">\n<style>\n.ti { font-size: 18px; vertical-align: middle; }\n.nav-item .ti { font-size: 20px; }\n.btn .ti { font-size: 16px; }\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n:root {\n  /* v8.1 配色 - 深色主题（默认） */\n  --bg: #0a0e17;\n  --surface: #111827;\n  --surface2: #1f2937;\n  --border: #374151;\n  --text: #f3f4f6;\n  --text2: #b0b8c4;\n  --text3: #7c8594;\n\n  /* 品牌色 */\n  --accent: #3b82f6;\n  --accent2: #8b5cf6;\n  --accent3: #10b981;\n  --accent-gradient: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 50%, #10b981 100%);\n}\n\n/* 浅色主题 */\n[data-theme=\"light\"] {\n  --bg: #f8fafc;\n  --surface: #ffffff;\n  --surface2: #e2e8f0;\n  --border: #cbd5e1;\n  --text: #1e293b;\n  --text2: #64748b;\n  --text3: #94a3b8;\n\n  --accent: #2563eb;\n  --accent2: #7c3aed;\n  --accent3: #059669;\n  --accent-gradient: linear-gradient(135deg, #2563eb 0%, #7c3aed 50%, #059669 100%);\n}\n\n/* 赛博朋克主题 */\n[data-theme=\"cyberpunk\"] {\n  --bg: #0d0221;\n  --surface: #1a0533;\n  --surface2: #2d1b4e;\n  --border: #ff00ff;\n  --text: #00ffff;\n  --text2: #ff00ff;\n  --text3: #9d4edd;\n\n  --accent: #00ffff;\n  --accent2: #ff00ff;\n  --accent3: #39ff14;\n  --accent-gradient: linear-gradient(135deg, #00ffff 0%, #ff00ff 50%, #39ff14 100%);\n}\n\n/* 状态色和通用变量 - 必须在 :root 内 */\n:root {\n  --green: #10b981;\n  --green-bg: rgba(16, 185, 129, 0.15);\n  --yellow: #f59e0b;\n  --yellow-bg: rgba(245, 158, 11, 0.15);\n  --red: #ef4444;\n  --red-bg: rgba(239, 68, 68, 0.15);\n  --blue: #3b82f6;\n  --blue-bg: rgba(59, 130, 246, 0.15);\n  --purple: #8b5cf6;\n  --purple-bg: rgba(139, 92, 246, 0.15);\n\n  --radius: 16px;\n  --shadow: 0 10px 40px rgba(0, 0, 0, 0.5);\n  --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.3);\n}\n\nhtml { background: var(--bg); }\nbody {\n  font-family: -apple-system, \"Segoe UI\", system-ui, sans-serif;\n  background: var(--bg);\n  color: var(--text);\n  min-height: 100vh;\n  line-height: 1.6;\n  overflow: hidden;\n}\n\n/* 布局 */\n.app { display: flex; height: 100vh; overflow: hidden; }\n.sidebar {\n  width: 260px;\n  background: var(--surface);\n  border-right: 1px solid var(--border);\n  display: flex;\n  flex-direction: column;\n  flex-shrink: 0;\n}\n.main {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  position: relative;\n  background: var(--bg);\n}\n\n/* 侧边栏 */\n.brand {\n  padding: 24px 20px;\n  border-bottom: 1px solid var(--border);\n  background: var(--accent-gradient);\n}\n.brand h1 {\n  font-size: 22px;\n  font-weight: 800;\n  color: white;\n  text-shadow: 0 2px 10px rgba(0,0,0,0.3);\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.nav {\n  flex: 1;\n  padding: 20px 12px;\n  overflow-y: auto;\n}\n.nav-item {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  padding: 14px 16px;\n  border-radius: var(--radius);\n  cursor: pointer;\n  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);\n  color: var(--text2);\n  font-size: 14px;\n  font-weight: 500;\n  margin-bottom: 4px;\n  position: relative;\n  overflow: hidden;\n}\n.nav-item::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: var(--accent-gradient);\n  opacity: 0;\n  transition: opacity 0.25s;\n}\n.nav-item:hover {\n  background: var(--surface2);\n  color: var(--text);\n  transform: translateX(4px);\n}\n.nav-item.active {\n  background: var(--accent-gradient);\n  color: white;\n  box-shadow: var(--shadow-sm);\n}\n.nav-item.active::before { opacity: 1; }\n.nav-item span {\n  position: relative;\n  z-index: 1;\n}\n\n/* 侧边栏底部按钮 */\n.sidebar-footer {\n  margin-top: auto;\n  padding: 16px;\n  display: flex;\n  gap: 8px;\n  border-top: 1px solid var(--border);\n}\n.theme-toggle, .help-toggle {\n  flex: 1;\n  padding: 12px;\n  background: var(--surface2);\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  cursor: pointer;\n  transition: all 0.3s;\n  font-size: 20px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.theme-toggle:hover, .help-toggle:hover {\n  background: var(--accent-gradient);\n  transform: scale(1.05);\n}\n\n/* 搜索框 */\n.search-bar {\n  margin-bottom: 24px;\n  position: relative;\n}\n.search-input {\n  width: 100%;\n  padding: 14px 20px 14px 44px;\n  background: var(--surface);\n  border: 2px solid var(--border);\n  border-radius: 12px;\n  color: var(--text);\n  font-size: 14px;\n  transition: all 0.3s;\n}\n.search-input:focus {\n  outline: none;\n  border-color: var(--accent);\n  box-shadow: 0 0 0 3px var(--blue-bg);\n}\n.search-input::placeholder {\n  color: var(--text3);\n}\n\n/* 自动刷新指示器 */\n.auto-refresh-indicator {\n  position: fixed;\n  bottom: 20px;\n  right: 20px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 16px;\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 20px;\n  font-size: 12px;\n  z-index: 1000;\n  opacity: 0.7;\n  transition: opacity 0.3s;\n}\n.auto-refresh-indicator.active {\n  border-color: var(--green);\n  background: var(--green-bg);\n}\n.refresh-icon-ti {\n  animation: spin 1s linear infinite;\n}\n.auto-refresh-indicator:not(.active) .refresh-icon-ti {\n  animation: none;\n}\n\n/* 快捷键帮助面板 */\n.shortcuts-panel {\n  position: fixed;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  padding: 32px;\n  z-index: 2000;\n  max-width: 400px;\n  width: 90%;\n  box-shadow: var(--shadow);\n  display: none;\n}\n.shortcuts-panel.active { display: block; }\n.shortcuts-panel h3 {\n  margin-bottom: 20px;\n  font-size: 20px;\n}\n.shortcut-item {\n  display: flex;\n  justify-content: space-between;\n  padding: 12px 0;\n  border-bottom: 1px solid var(--border);\n}\n.shortcut-item:last-child {\n  border-bottom: none;\n}\n.shortcut-key {\n  display: inline-block;\n  padding: 4px 10px;\n  background: var(--surface2);\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  font-family: monospace;\n  font-size: 12px;\n  font-weight: 600;\n}\n.panel-overlay {\n  position: fixed;\n  inset: 0;\n  background: rgba(0, 0, 0, 0.5);\n  z-index: 1999;\n  display: none;\n  opacity: 0;\n  transition: opacity 0.3s ease;\n}\n.panel-overlay.active {\n  display: block;\n  opacity: 1;\n}\n\n/* 快捷键面板动画 */\n.shortcuts-panel {\n  transition: all 0.3s ease;\n  transform: translate(-50%, -50%) scale(0.9);\n  opacity: 0;\n}\n.shortcuts-panel.active {\n  transform: translate(-50%, -50%) scale(1);\n  opacity: 1;\n}\n\n/* 通知系统 */\n.notification-container {\n  position: fixed;\n  top: 80px;\n  right: 20px;\n  z-index: 3000;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  pointer-events: none;\n}\n.notification {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  padding: 16px 20px;\n  box-shadow: var(--shadow);\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  min-width: 300px;\n  max-width: 400px;\n  pointer-events: auto;\n  animation: slideIn 0.3s ease, fadeOut 0.3s ease 4.7s forwards;\n  position: relative;\n  overflow: hidden;\n}\n.notification::before {\n  content: '';\n  position: absolute;\n  left: 0;\n  top: 0;\n  bottom: 0;\n  width: 4px;\n}\n.notification.success::before { background: var(--green); }\n.notification.info::before { background: var(--blue); }\n.notification.warning::before { background: var(--yellow); }\n.notification.error::before { background: var(--red); }\n.notification-icon {\n  font-size: 20px;\n}\n.notification-message {\n  flex: 1;\n  font-size: 14px;\n  font-weight: 500;\n}\n.notification-close {\n  cursor: pointer;\n  color: var(--text3);\n  font-size: 18px;\n  line-height: 1;\n  padding: 4px;\n}\n.notification-close:hover { color: var(--text); }\n\n@keyframes slideIn {\n  from {\n    transform: translateX(100%);\n    opacity: 0;\n  }\n  to {\n    transform: translateX(0);\n    opacity: 1;\n  }\n}\n@keyframes fadeOut {\n  from { opacity: 1; }\n  to { opacity: 0; }\n}\n\n/* 主内容 */\n.content {\n  flex: 1;\n  overflow-y: auto;\n  padding: 32px;\n  position: relative;\n}\n\n/* 页面切换动画 */\n.page {\n  display: none;\n  animation: fadeIn 0.3s ease;\n}\n.page.active { display: block; }\n@keyframes fadeIn {\n  from { opacity: 0; transform: translateY(10px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* 页面标题 */\n.page-header {\n  margin-bottom: 32px;\n}\n.page-header h2 {\n  font-size: 32px;\n  font-weight: 700;\n  background: var(--accent-gradient);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  margin-bottom: 8px;\n}\n.page-header p {\n  color: var(--text2);\n  font-size: 15px;\n}\n\n/* 统计卡片 */\n.stats-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 20px;\n  margin-bottom: 32px;\n}\n.stat-card {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  padding: 24px;\n  position: relative;\n  overflow: hidden;\n  transition: all 0.3s;\n}\n.stat-card::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 3px;\n  background: var(--accent-gradient);\n  transform: scaleX(0);\n  transition: transform 0.3s;\n}\n.stat-card:hover {\n  transform: translateY(-4px);\n  box-shadow: var(--shadow-sm);\n}\n.stat-card:hover::before { transform: scaleX(1); }\n.stat-card .label {\n  color: var(--text2);\n  font-size: 13px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  margin-bottom: 8px;\n}\n.stat-card .value {\n  font-size: 36px;\n  font-weight: 800;\n  background: var(--accent-gradient);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n}\n\n/* Agents 网格 */\n.agents-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));\n  gap: 24px;\n}\n.agent-card {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  padding: 24px;\n  transition: all 0.3s;\n  position: relative;\n  overflow: hidden;\n}\n.agent-card::after {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: var(--accent-gradient);\n  opacity: 0;\n  transition: opacity 0.3s;\n  pointer-events: none;\n}\n.agent-card:hover {\n  transform: translateY(-4px) scale(1.02);\n  box-shadow: var(--shadow);\n  border-color: var(--accent);\n}\n.agent-card:hover::after { opacity: 0.05; }\n\n.agent-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  margin-bottom: 16px;\n}\n.agent-name {\n  font-size: 18px;\n  font-weight: 700;\n  color: var(--text);\n  margin-bottom: 4px;\n}\n.agent-id {\n  font-size: 12px;\n  color: var(--text3);\n  font-family: monospace;\n}\n.status-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 6px 12px;\n  border-radius: 20px;\n  font-size: 12px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n.status-badge.idle { background: var(--yellow-bg); color: var(--yellow); }\n.status-badge.active { background: var(--green-bg); color: var(--green); }\n.status-badge.disabled { background: var(--red-bg); color: var(--red); }\n.status-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: currentColor;\n  animation: pulse 2s infinite;\n}\n@keyframes pulse {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 0.5; }\n}\n\n.agent-description {\n  color: var(--text2);\n  font-size: 14px;\n  margin-bottom: 20px;\n  line-height: 1.5;\n}\n\n.agent-stats {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 12px;\n  margin-bottom: 20px;\n}\n.agent-stat {\n  display: flex;\n  justify-content: space-between;\n  font-size: 13px;\n}\n.agent-stat .label { color: var(--text3); }\n.agent-stat .value { color: var(--text); font-weight: 600; }\n\n.task-progress {\n  margin-top: 16px;\n}\n.task-progress-bar {\n  height: 8px;\n  background: var(--surface2);\n  border-radius: 4px;\n  overflow: hidden;\n}\n.task-progress-fill {\n  height: 100%;\n  background: var(--accent-gradient);\n  border-radius: 4px;\n  transition: width 0.5s ease;\n  animation: shimmer 2s infinite;\n}\n@keyframes shimmer {\n  0% { background-position: -200% 0; }\n  100% { background-position: 200% 0; }\n}\n\n.agent-actions {\n  display: flex;\n  gap: 8px;\n  margin-top: 16px;\n  justify-content: stretch;\n}\n.agent-actions .btn {\n  flex: 1;\n  text-align: center;\n}\n\n/* 按钮 */\n.btn {\n  flex: 1;\n  padding: 10px 16px;\n  border: none;\n  border-radius: 8px;\n  font-size: 13px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.2s;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n}\n.btn-primary {\n  background: var(--accent-gradient);\n  color: white;\n}\n.btn-primary:hover {\n  transform: translateY(-2px);\n  box-shadow: var(--shadow-sm);\n}\n.btn-secondary {\n  background: var(--surface2);\n  color: var(--text);\n  border: 1px solid var(--border);\n}\n.btn-secondary:hover {\n  background: var(--border);\n}\n\n/* 通知系统 */\n#notification-container {\n  position: fixed;\n  top: 24px;\n  right: 24px;\n  z-index: 1000;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  max-height: 40vh;\n  overflow: hidden;\n  max-width: 400px;\n}\n.notification {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 16px 20px;\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  box-shadow: var(--shadow);\n  min-width: 300px;\n  animation: slideIn 0.3s ease;\n}\n@keyframes slideIn {\n  from { transform: translateX(100%); opacity: 0; }\n  to { transform: translateX(0); opacity: 1; }\n}\n.notification.success { border-color: var(--green); }\n.notification.error { border-color: var(--red); }\n.notification.warning { border-color: var(--yellow); }\n\n/* 加载状态 */\n.loading {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 16px;\n  padding: 40px;\n  color: var(--text2);\n}\n.spinner {\n  width: 24px;\n  height: 24px;\n  border: 3px solid var(--border);\n  border-top-color: var(--accent);\n  border-radius: 50%;\n  animation: spin 1s linear infinite;\n}\n@keyframes spin {\n  to { transform: rotate(360deg); }\n}\n\n/* Tasks 表格 */\n.tasks-table {\n  width: 100%;\n  border-collapse: collapse;\n  background: var(--surface);\n  border-radius: var(--radius);\n  overflow: hidden;\n}\n.tasks-table th,\n.tasks-table td {\n  padding: 16px 20px;\n  text-align: left;\n  border-bottom: 1px solid var(--border);\n}\n.tasks-table th {\n  background: var(--surface2);\n  font-weight: 600;\n  font-size: 13px;\n  color: var(--text2);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n.tasks-table tr:hover {\n  background: var(--surface2);\n}\n.tasks-table tr:last-child td {\n  border-bottom: none;\n}\n\n/* Logs 区域 */\n.logs-container {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  overflow: hidden;\n}\n.logs-header {\n  padding: 16px 20px;\n  background: var(--surface2);\n  border-bottom: 1px solid var(--border);\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.logs-content {\n  padding: 20px;\n  font-family: 'Consolas', 'Monaco', monospace;\n  font-size: 13px;\n  line-height: 1.6;\n  max-height: 400px;\n  overflow-y: auto;\n}\n.log-entry {\n  padding: 8px 0;\n  border-bottom: 1px solid var(--border);\n}\n.log-time {\n  color: var(--text3);\n  margin-right: 12px;\n}\n.log-level {\n  display: inline-block;\n  padding: 2px 8px;\n  border-radius: 4px;\n  font-size: 11px;\n  font-weight: 600;\n  margin-right: 8px;\n}\n.log-level.info { background: var(--blue-bg); color: var(--blue); }\n.log-level.warn { background: var(--yellow-bg); color: var(--yellow); }\n.log-level.error { background: var(--red-bg); color: var(--red); }\n\n/* Settings 页面 */\n.settings-section {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  padding: 24px;\n  margin-bottom: 20px;\n}\n.settings-section h3 {\n  font-size: 18px;\n  font-weight: 600;\n  margin-bottom: 20px;\n}\n.setting-item {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 16px 0;\n  border-bottom: 1px solid var(--border);\n}\n.setting-item:last-child {\n  border-bottom: none;\n}\n.setting-label {\n  flex: 1;\n}\n.setting-label .title {\n  font-weight: 600;\n  margin-bottom: 4px;\n}\n.setting-label .description {\n  font-size: 13px;\n  color: var(--text2);\n}\n.setting-control {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n/* 开关 */\n.switch {\n  position: relative;\n  width: 50px;\n  height: 26px;\n}\n.switch input {\n  opacity: 0;\n  width: 0;\n  height: 0;\n}\n.switch-slider {\n  position: absolute;\n  cursor: pointer;\n  inset: 0;\n  background: var(--surface2);\n  border: 1px solid var(--border);\n  border-radius: 26px;\n  transition: all 0.3s;\n}\n.switch-slider::before {\n  position: absolute;\n  content: \"\";\n  height: 20px;\n  width: 20px;\n  left: 2px;\n  bottom: 2px;\n  background: white;\n  border-radius: 50%;\n  transition: all 0.3s;\n}\n.switch input:checked + .switch-slider {\n  background: var(--accent);\n  border-color: var(--accent);\n}\n.switch input:checked + .switch-slider::before {\n  transform: translateX(24px);\n}\n\n/* Performance 页面 */\n.performance-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n  gap: 24px;\n  margin-bottom: 32px;\n}\n.performance-card {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  padding: 24px;\n}\n.performance-card h4 {\n  font-size: 16px;\n  font-weight: 600;\n  margin-bottom: 16px;\n  color: var(--text2);\n}\n.metric-value {\n  font-size: 48px;\n  font-weight: 800;\n  background: var(--accent-gradient);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  line-height: 1;\n  margin-bottom: 8px;\n}\n.metric-change {\n  font-size: 14px;\n  font-weight: 600;\n}\n.metric-change.positive { color: var(--green); }\n.metric-change.negative { color: var(--red); }\n\n/* 响应式 */\n@media (max-width: 1024px) {\n  .sidebar { width: 220px; }\n  .agents-grid { grid-template-columns: 1fr; }\n}\n@media (max-width: 768px) {\n  .app { flex-direction: column; }\n  .sidebar {\n    width: 100%;\n    height: auto;\n    flex-direction: row;\n    overflow-x: auto;\n  }\n  .brand { padding: 12px 16px; }\n  .brand h1 { font-size: 16px; }\n  .nav {\n    display: flex;\n    padding: 8px;\n    overflow-x: auto;\n    flex-shrink: 0;\n  }\n  .nav-item {\n    flex-shrink: 0;\n    margin-bottom: 0;\n    margin-right: 8px;\n    min-height: 44px;\n    min-width: 44px;\n  }\n  button, .btn {\n    min-height: 44px;\n    min-width: 44px;\n    padding: 12px 16px;\n  }\n  .content { padding: 20px; }\n  .stats-grid { grid-template-columns: 1fr 1fr; }\n  .agent-stats { grid-template-columns: 1fr; }\n\n  /* 触摸优化 */\n  button:active, .btn:active {\n    transform: scale(0.97);\n    transition: transform 0.1s;\n  }\n  .nav-item:active {\n    transform: scale(0.95);\n  }\n\n  /* 更大的点击区域 */\n  .stat-card {\n    min-height: 100px;\n  }\n  .agent-card {\n    min-height: 120px;\n  }\n\n  /* 通知优化 */\n  .notification {\n    min-width: 260px;\n    max-width: calc(100vw - 40px);\n  }\n\n  /* 自动刷新指示器移动端 */\n  .auto-refresh-indicator {\n    bottom: 12px;\n    right: 12px;\n    font-size: 11px;\n    padding: 6px 12px;\n  }\n\n  /* 模态框优化 */\n  .modal-content {\n    width: 95vw;\n    max-width: none;\n    padding: 24px;\n  }\n}\n\n/* 触摸设备优化 */\n@media (hover: none) and (pointer: coarse) {\n  /* 移除hover效果，提高性能 */\n  * {\n    -webkit-tap-highlight-color: rgba(59, 130, 246, 0.3);\n  }\n\n  button:hover, .btn:hover, .nav-item:hover {\n    background: var(--surface2);\n  }\n\n  /* 禁用过渡动画，提高响应速度 */\n  .fast-mode * {\n    transition: none !important;\n    animation: none !important;\n  }\n}\n\n/* 小屏幕手机优化 */\n@media (max-width: 375px) {\n  .sidebar { padding: 8px; }\n  .brand { font-size: 14px; padding: 12px; }\n  .nav-item { padding: 10px 14px; font-size: 13px; }\n  .content { padding: 16px; }\n  .stats-grid { grid-template-columns: 1fr; }\n  button, .btn { font-size: 14px; }\n}\n</style>\n</head>\n<body>\n\n<!-- 通知容器 -->\n<div class=\"notification-container\" id=\"notification-container\"></div>\n\n<!-- 自动刷新指示器 -->\n<div class=\"auto-refresh-indicator\" id=\"auto-refresh-indicator\">\n  <i class=\"ti ti-refresh refresh-icon-ti\"></i>\n  <span id=\"refresh-status\">自动刷新: 10s</span>\n</div>\n\n<!-- 快捷键面板遮罩 -->\n<div class=\"panel-overlay\" id=\"shortcuts-overlay\"></div>\n\n<!-- 快捷键面板 -->\n<div class=\"shortcuts-panel\" id=\"shortcuts-panel\">\n  <h3><i class=\"ti ti-keyboard\"></i> 键盘快捷键</h3>\n  <div class=\"shortcut-item\">\n    <span class=\"shortcut-key\">1-5</span>\n    <span>切换页面</span>\n  </div>\n  <div class=\"shortcut-item\">\n    <span class=\"shortcut-key\">R</span>\n    <span>刷新当前页</span>\n  </div>\n  <div class=\"shortcut-item\">\n    <span class=\"shortcut-key\">H</span>\n    <span>显示/隐藏帮助</span>\n  </div>\n  <div class=\"shortcut-item\">\n    <span class=\"shortcut-key\">ESC</span>\n    <span>关闭面板</span>\n  </div>\n  <div style=\"margin-top: 20px; text-align: center;\">\n    <button class=\"btn btn-primary\" onclick=\"closeShortcutsPanel()\"><i class=\"ti ti-x\"></i> 关闭</button>\n  </div>\n</div>\n\n<div class=\"app\">\n  <!-- 侧边栏 -->\n  <aside class=\"sidebar\">\n    <div class=\"brand\">\n      <h1>∞ LoopCLI</h1>\n    </div>\n    <nav class=\"nav\">\n      <div class=\"nav-item active\" data-page=\"dashboard\">\n        <i class=\"ti ti-dashboard\"></i>\n        <span>主页</span>\n      </div>\n      <div class=\"nav-item\" data-page=\"agents\">\n        <i class=\"ti ti-robot\"></i>\n        <span>Agents</span>\n      </div>\n      <div class=\"nav-item\" data-page=\"tasks\">\n        <i class=\"ti ti-list-check\"></i>\n        <span>任务</span>\n      </div>\n      <div class=\"nav-item\" data-page=\"performance\">\n        <i class=\"ti ti-chart-bar\"></i>\n        <span>性能</span>\n      </div>\n      <div class=\"nav-item\" data-page=\"logs\">\n        <i class=\"ti ti-file-text\"></i>\n        <span>日志</span>\n      </div>\n      <div class=\"nav-item\" data-page=\"screenshots\">\n        <i class=\"ti ti-camera\"></i>\n        <span>截图</span>\n      </div>\n      <div class=\"nav-item\" data-page=\"settings\">\n        <i class=\"ti ti-settings\"></i>\n        <span>设置</span>\n      </div>\n    </nav>\n    <div class=\"sidebar-footer\">\n      <button class=\"theme-toggle\" id=\"theme-toggle\" title=\"切换主题\">\n        <i id=\"theme-icon\" class=\"ti ti-moon\"></i>\n      </button>\n      <button class=\"help-toggle\" id=\"help-toggle\" title=\"快捷键帮助\">\n        <i class=\"ti ti-help-circle\"></i>\n      </button>\n    </div>\n  </aside>\n\n  <!-- 主内容 -->\n  <main class=\"main\">\n    <div class=\"content\">\n      <!-- 主页 Dashboard -->\n      <div class=\"page active\" id=\"page-dashboard\">\n        <div class=\"page-header\">\n          <h2>系统概览</h2>\n          <p>LoopCLI 运行状态与关键指标</p>\n        </div>\n\n        <div class=\"stats-grid\">\n          <div class=\"stat-card\">\n            <div class=\"label\">总 Agents</div>\n            <div class=\"value\" id=\"total-agents\">-</div>\n          </div>\n          <div class=\"stat-card\">\n            <div class=\"label\">运行中</div>\n            <div class=\"value\" id=\"active-agents\">-</div>\n          </div>\n          <div class=\"stat-card\">\n            <div class=\"label\">总任务数</div>\n            <div class=\"value\" id=\"total-tasks\">-</div>\n          </div>\n          <div class=\"stat-card\">\n            <div class=\"label\">已完成</div>\n            <div class=\"value\" id=\"done-tasks\">-</div>\n          </div>\n        </div>\n\n        <!-- 长期任务卡片 -->\n        <div id=\"longtask-card\" style=\"background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(139, 92, 246, 0.1) 50%, rgba(16, 185, 129, 0.1) 100%); border: 2px solid var(--accent); border-radius: var(--radius); padding: 24px; margin-bottom: 32px; position: relative; overflow: hidden;\">\n          <div style=\"position: absolute; top: -50%; right: -50%; width: 200%; height: 200%; background: radial-gradient(circle, rgba(255,255,255,0.03) 0%, transparent 70%); pointer-events: none;\"></div>\n          <div style=\"display: flex; justify-content: space-between; align-items: flex-start; position: relative; z-index: 1;\">\n            <div style=\"flex: 1;\">\n              <div style=\"display: flex; align-items: center; gap: 12px; margin-bottom: 12px;\">\n                <span style=\"font-size: 24px;\"><i class=\"ti ti-target\"></i></span>\n                <h3 style=\"font-size: 20px; font-weight: 700; background: var(--accent-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;\">长期任务</h3>\n                <span id=\"longtask-badge\" style=\"display: none; background: var(--accent); color: white; font-size: 11px; padding: 2px 8px; border-radius: 10px; font-weight: 600;\">进行中</span>\n              </div>\n              <div id=\"longtask-display\" style=\"color: var(--text); line-height: 1.7; min-width: 0; overflow-wrap: break-word;\">\n                <div id=\"longtask-status-main\" style=\"font-size: 14px; color: var(--text2);\">加载中...</div>\n                <div id=\"longtask-content-main\" style=\"display: none; margin-top: 12px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 16px; font-family: monospace; font-size: 13px; white-space: pre-wrap; word-break: break-word; color: var(--text2); max-height: 300px; overflow-y: auto;\"></div>\n                <div id=\"longtask-edit-main\" style=\"display: none; margin-top: 12px;\">\n                  <textarea id=\"longtask-editor-main\" style=\"width: 100%; min-height: 120px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 12px; font-family: monospace; font-size: 13px; color: var(--text); resize: vertical;\" placeholder=\"输入长期任务内容...\"></textarea>\n                  <div style=\"display: flex; gap: 8px; margin-top: 8px;\">\n                    <button class=\"btn btn-primary\" onclick=\"saveLongTaskMain()\"><i class=\"ti ti-device-floppy\"></i> 保存</button>\n                    <button class=\"btn btn-secondary\" onclick=\"cancelEditLongTaskMain()\">取消</button>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div style=\"display: flex; gap: 8px;\">\n              <button class=\"btn btn-primary\" id=\"edit-longtask-btn-main\" onclick=\"startEditLongTaskMain()\" style=\"display: none;\"><i class=\"ti ti-pencil\"></i> 编辑</button>\n              <button class=\"btn btn-secondary\" id=\"cancel-longtask-btn-main\" onclick=\"cancelLongTaskMain()\" style=\"display: none;\"><i class=\"ti ti-x\"></i> 取消</button>\n            </div>\n          </div>\n        </div>\n\n        <!-- 用量统计面板 -->\n        <div id=\"usage-panel\" style=\"background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 28px; margin-bottom: 32px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);\">\n          <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;\">\n            <h3 style=\"font-size: 15px; font-weight: 700; color: var(--text2); display:flex; align-items:center; gap:8px;\"><span style=\"display:inline-block;width:4px;height:18px;background:linear-gradient(180deg,#f59e0b,#fbbf24);border-radius:2px;\"></span>用量统计</h3>\n            <span id=\"usage-refresh-time\" style=\"font-size: 12px; color: var(--text3);\">每5分钟刷新</span>\n          </div>\n          <div id=\"usage-content\" style=\"color: var(--text2); font-size: 14px;\">加载中...</div>\n        </div>\n\n        <!-- 可视化图表区域 -->\n        <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-bottom: 32px;\">\n          <div style=\"background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 28px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);\">\n            <h3 style=\"font-size: 15px; font-weight: 700; margin-bottom: 20px; color: var(--text2); display:flex; align-items:center; gap:8px;\"><span style=\"display:inline-block;width:4px;height:18px;background:linear-gradient(180deg,#6366f1,#8b5cf6);border-radius:2px;\"></span>Agent 状态分布</h3>\n            <div id=\"agent-status-chart\" style=\"display:flex;align-items:center;justify-content:center;min-height:200px;width:100%;\"></div>\n          </div>\n          <div style=\"background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 28px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);\">\n            <h3 style=\"font-size: 15px; font-weight: 700; margin-bottom: 20px; color: var(--text2); display:flex; align-items:center; gap:8px;\"><span style=\"display:inline-block;width:4px;height:18px;background:linear-gradient(180deg,#10b981,#34d399);border-radius:2px;\"></span>任务完成进度</h3>\n            <div id=\"task-progress-chart\" style=\"min-height:200px;\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Agents 页面 -->\n      <div class=\"page\" id=\"page-agents\">\n        <div class=\"page-header\">\n          <h2>Agent 控制台</h2>\n          <p>管理和监控所有 Agent</p>\n        </div>\n\n        <div class=\"action-bar\" style=\"display: flex; gap: 12px; margin-bottom: 20px;\">\n          <button class=\"btn btn-primary\" id=\"create-agent-btn\" onclick=\"showCreateAgentModal()\" style=\"display: flex; align-items: center; gap: 8px;\">\n            <i class=\"ti ti-plus\"></i>\n            <span>创建 Agent</span>\n          </button>\n          <button class=\"btn btn-secondary\" id=\"refresh-btn\" onclick=\"refreshAgents()\" style=\"display: flex; align-items: center; gap: 8px;\">\n            <i class=\"ti ti-refresh\"></i>\n            <span>刷新</span>\n          </button>\n        </div>\n\n        <div class=\"search-bar\" style=\"display: flex; gap: 12px; align-items: center; position: relative;\">\n          <i class=\"ti ti-search\" style=\"position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text2); z-index: 1;\"></i>\n          <input type=\"text\" class=\"search-input\" id=\"agent-search\" placeholder=\"搜索 Agent (按名称、ID 或状态)...\" style=\"flex: 1; min-width: 0;\">\n          <button class=\"btn btn-secondary\" id=\"export-btn\" onclick=\"exportAgentsData()\" style=\"flex-shrink: 0; white-space: nowrap;\">\n            <i class=\"ti ti-download\"></i> 导出\n          </button>\n        </div>\n\n        <div class=\"agents-grid\" id=\"agents-grid\">\n          <div class=\"loading\">\n            <div class=\"spinner\"></div>\n            <div>加载 Agents...</div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Tasks 页面 -->\n      <div class=\"page\" id=\"page-tasks\">\n        <div class=\"page-header\">\n          <h2>任务管理</h2>\n          <p>查看和管理所有任务</p>\n        </div>\n\n        <div class=\"tasks-table-container\">\n          <table class=\"tasks-table\">\n            <thead>\n              <tr>\n                <th>ID</th>\n                <th>标题</th>\n                <th>状态</th>\n                <th>Agent</th>\n                <th>创建时间</th>\n              </tr>\n            </thead>\n            <tbody id=\"tasks-table-body\">\n              <tr>\n                <td colspan=\"5\" style=\"text-align: center; color: var(--text2);\">加载中...</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      <!-- Performance 页面 -->\n      <div class=\"page\" id=\"page-performance\">\n        <div class=\"page-header\">\n          <h2>性能监控</h2>\n          <p>系统性能指标和趋势分析</p>\n        </div>\n\n        <div class=\"performance-grid\">\n          <div class=\"performance-card\">\n            <h4>CPU 使用率</h4>\n            <div class=\"metric-value\" id=\"cpu-usage\">-%</div>\n            <div class=\"metric-change\" id=\"cpu-change\">-</div>\n          </div>\n          <div class=\"performance-card\">\n            <h4>内存使用</h4>\n            <div class=\"metric-value\" id=\"memory-usage\">- MB</div>\n            <div class=\"metric-change\" id=\"mem-change\">-</div>\n          </div>\n          <div class=\"performance-card\">\n            <h4>响应时间</h4>\n            <div class=\"metric-value\" id=\"response-time\">- ms</div>\n            <div class=\"metric-change\" id=\"resp-change\">-</div>\n          </div>\n          <div class=\"performance-card\">\n            <h4>Token 消耗</h4>\n            <div class=\"metric-value\" id=\"token-usage\">-</div>\n            <div class=\"metric-change\" id=\"token-change\">本月累计</div>\n          </div>\n        </div>\n\n        <!-- Token 趋势图 -->\n        <div style=\"background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; margin-bottom: 32px;\">\n          <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;\">\n            <h3 style=\"font-size: 16px; font-weight: 600; color: var(--text2);\">Token 消耗趋势（最近7天）</h3>\n            <span id=\"token-trend-summary\" style=\"font-size: 13px; color: var(--text2);\"></span>\n          </div>\n          <canvas id=\"token-trend-chart\" width=\"800\" height=\"250\"></canvas>\n        </div>\n\n        <div class=\"settings-section\">\n          <h3>性能建议</h3>\n          <div id=\"performance-suggestions\">\n            <div class=\"setting-item\">\n              <div class=\"setting-label\">\n                <div class=\"title\">启用 Agent 缓存</div>\n                <div class=\"description\">缓存频繁访问的 Agent 数据，减少 API 调用</div>\n              </div>\n              <label class=\"switch\">\n                <input type=\"checkbox\" checked>\n                <span class=\"switch-slider\"></span>\n              </label>\n            </div>\n            <div class=\"setting-item\">\n              <div class=\"setting-label\">\n                <div class=\"title\">自动优化</div>\n                <div class=\"description\">自动清理空闲资源和优化配置</div>\n              </div>\n              <label class=\"switch\">\n                <input type=\"checkbox\">\n                <span class=\"switch-slider\"></span>\n              </label>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Logs 页面 -->\n      <div class=\"page\" id=\"page-logs\">\n        <div class=\"page-header\">\n          <h2>系统日志</h2>\n          <p>实时查看系统运行日志</p>\n        </div>\n\n        <div class=\"logs-container\">\n          <div class=\"logs-header\">\n            <span>最新日志</span>\n            <button class=\"btn btn-secondary\" onclick=\"clearLogs()\"><i class=\"ti ti-trash\"></i> 清空</button>\n          </div>\n          <div class=\"logs-content\" id=\"logs-content\">\n            <div class=\"loading\">\n              <div class=\"spinner\"></div>\n              <div>加载日志...</div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Screenshots 页面 -->\n      <div class=\"page\" id=\"page-screenshots\">\n        <div class=\"page-header\">\n          <h2>测试截图</h2>\n          <p>Playwright 测试截图预览</p>\n        </div>\n\n        <div class=\"card\">\n          <div class=\"card-header\">\n            <h3>最新截图</h3>\n            <button class=\"btn btn-secondary\" onclick=\"loadScreenshots()\" style=\"margin-left: auto;\"><i class=\"ti ti-refresh\"></i> 刷新</button>\n          </div>\n          <div class=\"card-body\">\n            <div id=\"screenshots-grid\" style=\"display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px;\">\n              <div style=\"grid-column: 1/-1; text-align: center; color: var(--text2); padding: 40px;\">\n            加载中...\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Settings 页面 -->\n      <div class=\"page\" id=\"page-settings\">\n        <div class=\"page-header\">\n          <h2>系统设置</h2>\n          <p>配置系统参数和偏好</p>\n        </div>\n\n        <div class=\"settings-section\">\n          <h3>主题设置</h3>\n          <div class=\"setting-item\">\n            <div class=\"setting-label\">\n              <div class=\"title\">颜色主题</div>\n              <div class=\"description\">选择界面主题风格</div>\n            </div>\n            <div class=\"setting-control\">\n              <select id=\"theme-selector\" style=\"padding: 8px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface2); color: var(--text); font-size: 13px;\">\n                <option value=\"dark\">深色主题</option>\n                <option value=\"light\">浅色主题</option>\n                <option value=\"cyberpunk\">赛博朋克</option>\n              </select>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"settings-section\">\n          <h3>界面设置</h3>\n          <div class=\"setting-item\">\n            <div class=\"setting-label\">\n              <div class=\"title\">自动刷新</div>\n              <div class=\"description\">自动刷新数据间隔（秒）</div>\n            </div>\n            <div class=\"setting-control\">\n              <input type=\"number\" id=\"refresh-interval\" value=\"10\" min=\"1\" max=\"60\"\n                     style=\"width: 80px; padding: 8px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface2); color: var(--text);\">\n            </div>\n          </div>\n          <div class=\"setting-item\">\n            <div class=\"setting-label\">\n              <div class=\"title\">紧凑模式</div>\n              <div class=\"description\">减少间距，显示更多内容</div>\n            </div>\n            <label class=\"switch\">\n              <input type=\"checkbox\" id=\"compact-mode\">\n              <span class=\"switch-slider\"></span>\n            </label>\n          </div>\n        </div>\n\n        <div class=\"settings-section\">\n          <h3>通知设置</h3>\n          <div class=\"setting-item\">\n            <div class=\"setting-label\">\n              <div class=\"title\">启用通知</div>\n              <div class=\"description\">显示系统通知和警告</div>\n            </div>\n            <label class=\"switch\">\n              <input type=\"checkbox\" id=\"enable-notifications\" checked>\n              <span class=\"switch-slider\"></span>\n            </label>\n          </div>\n          <div class=\"setting-item\">\n            <div class=\"setting-label\">\n              <div class=\"title\">声音提醒</div>\n              <div class=\"description\">重要事件时播放提示音</div>\n            </div>\n            <label class=\"switch\">\n              <input type=\"checkbox\" id=\"sound-notifications\">\n              <span class=\"switch-slider\"></span>\n            </label>\n          </div>\n        </div>\n\n        <div class=\"settings-section\">\n          <h3>系统信息</h3>\n          <div class=\"setting-item\">\n            <div class=\"setting-label\">\n              <div class=\"title\">WebUI 版本</div>\n              <div class=\"description\">v8.6 - 深度优化：搜索栏修复、响应式改进、通知位置优化、结构修复</div>\n            </div>\n          </div>\n          <div class=\"setting-item\">\n            <div class=\"setting-label\">\n              <div class=\"title\">服务器状态</div>\n              <div class=\"description\" id=\"server-status\">检测中...</div>\n            </div>\n          </div>\n          <div class=\"setting-item\">\n            <div class=\"setting-label\">\n              <div class=\"title\">服务器运行时间</div>\n              <div class=\"description\" id=\"server-uptime\">-</div>\n            </div>\n          </div>\n          <div class=\"setting-item\">\n            <div class=\"setting-label\">\n              <div class=\"title\">Agent 统计</div>\n              <div class=\"description\" id=\"agent-stats\">-</div>\n            </div>\n          </div>\n          <div class=\"setting-item\" id=\"sys-resource-item\" style=\"display:none\">\n            <div class=\"setting-label\">\n              <div class=\"title\">系统资源</div>\n              <div class=\"description\" id=\"sys-resource\">-</div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"settings-section\">\n          <h3>长期任务</h3>\n          <div class=\"setting-item\">\n            <div class=\"setting-label\">\n              <div class=\"title\">当前长期任务</div>\n              <div class=\"description\" id=\"longtask-status\">加载中...</div>\n            </div>\n            <div class=\"setting-control\">\n              <button class=\"btn btn-secondary\" id=\"edit-longtask-btn\" onclick=\"startEditLongTask()\" style=\"display: none;\">\n                <i class=\"ti ti-pencil\"></i> 编辑\n              </button>\n              <button class=\"btn btn-secondary\" id=\"cancel-longtask-btn\" onclick=\"cancelLongTask()\" style=\"display: none;\">\n                <i class=\"ti ti-x\"></i> 取消任务\n              </button>\n            </div>\n          </div>\n          <div id=\"longtask-content\" style=\"display: none; margin-top: 16px;\">\n            <div style=\"background: var(--surface2); border: 1px solid var(--border); border-radius: 8px; padding: 16px; font-family: monospace; font-size: 13px; white-space: pre-wrap; color: var(--text2); max-height: 200px; overflow-y: auto;\" id=\"longtask-text\"></div>\n          </div>\n          <div id=\"longtask-edit\" style=\"display: none; margin-top: 16px;\">\n            <textarea id=\"longtask-editor\" style=\"width: 100%; min-height: 120px; background: var(--surface2); border: 1px solid var(--border); border-radius: 8px; padding: 12px; font-family: monospace; font-size: 13px; color: var(--text); resize: vertical;\" placeholder=\"输入长期任务内容...\"></textarea>\n            <div style=\"display: flex; gap: 8px; margin-top: 8px;\">\n              <button class=\"btn btn-primary\" onclick=\"saveLongTask()\"><i class=\"ti ti-device-floppy\"></i> 保存</button>\n              <button class=\"btn btn-secondary\" onclick=\"cancelEditLongTask()\">取消</button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </main>\n</div>\n\n<script>\n// API 基础 URL\nconst API_BASE = '/api';\n\n// 通知系统\nfunction showNotification(message, type = 'info', duration = 5000) {\n  const container = document.getElementById('notification-container');\n  if (!container) return;\n\n  const icons = {\n    success: '<i class=\"ti ti-check\" style=\"font-size:18px\"></i>',\n    info: '<i class=\"ti ti-info-circle\" style=\"font-size:18px\"></i>',\n    warning: '<i class=\"ti ti-alert-triangle\" style=\"font-size:18px\"></i>',\n    error: '<i class=\"ti ti-x\" style=\"font-size:18px\"></i>'\n  };\n\n  const notification = document.createElement('div');\n  notification.className = `notification ${type}`;\n  notification.innerHTML = `\n    <span class=\"notification-icon\">${icons[type] || icons.info}</span>\n    <span class=\"notification-message\">${message}</span>\n    <span class=\"notification-close\" onclick=\"this.parentElement.remove()\"><i class=\"ti ti-x\" style=\"font-size:14px\"></i></span>\n  `;\n\n  container.appendChild(notification);\n\n  // 最多显示3条通知\n  while (container.children.length > 3) {\n    container.firstChild.remove();\n  }\n\n  setTimeout(() => {\n    if (notification.parentElement) {\n      notification.remove();\n    }\n  }, duration);\n}\n\n// 主题管理\nconst themes = ['dark', 'light', 'cyberpunk'];\nlet currentThemeIndex = 0;\n\nfunction initTheme() {\n  const savedTheme = localStorage.getItem('webui_theme') || 'dark';\n  currentThemeIndex = themes.indexOf(savedTheme);\n  if (currentThemeIndex === -1) currentThemeIndex = 0;\n  applyTheme(themes[currentThemeIndex]);\n}\n\nfunction applyTheme(theme) {\n  if (theme === 'dark') {\n    document.documentElement.removeAttribute('data-theme');\n  } else {\n    document.documentElement.setAttribute('data-theme', theme);\n  }\n  localStorage.setItem('webui_theme', theme);\n  updateThemeIcon(theme);\n}\n\nfunction cycleTheme() {\n  currentThemeIndex = (currentThemeIndex + 1) % themes.length;\n  applyTheme(themes[currentThemeIndex]);\n}\n\nfunction updateThemeIcon(theme) {\n  const icon = document.getElementById('theme-icon');\n  if (icon) {\n    const icons = { dark: 'ti ti-moon', light: 'ti ti-sun', cyberpunk: 'ti ti-palette' };\n    icon.className = icons[theme] || 'ti ti-moon';\n  }\n}\n\n// 快捷键面板\nfunction openShortcutsPanel() {\n  document.getElementById('shortcuts-panel').classList.add('active');\n  document.getElementById('shortcuts-overlay').classList.add('active');\n}\n\nfunction closeShortcutsPanel() {\n  document.getElementById('shortcuts-panel').classList.remove('active');\n  document.getElementById('shortcuts-overlay').classList.remove('active');\n}\n\n// 搜索功能\nfunction initSearch() {\n  const searchInput = document.getElementById('agent-search');\n  if (!searchInput) return;\n\n  searchInput.addEventListener('input', (e) => {\n    const query = e.target.value.toLowerCase();\n    const cards = document.querySelectorAll('.agent-card');\n\n    cards.forEach(card => {\n      const name = card.querySelector('.agent-name')?.textContent.toLowerCase() || '';\n      const id = card.querySelector('.agent-id')?.textContent.toLowerCase() || '';\n      const status = card.querySelector('.status-badge')?.textContent.toLowerCase() || '';\n\n      const matches = name.includes(query) || id.includes(query) || status.includes(query);\n      card.style.display = matches ? '' : 'none';\n    });\n  });\n}\n\n// 自动刷新指示器\nfunction updateRefreshIndicator(active, interval) {\n  const indicator = document.getElementById('auto-refresh-indicator');\n  const status = document.getElementById('refresh-status');\n  if (indicator && status) {\n    indicator.classList.toggle('active', active);\n    status.textContent = active ? `自动刷新: ${interval/1000}s` : '已暂停';\n  }\n}\n\n// 页面导航\nfunction navigateTo(pageId) {\n  // 更新导航状态\n  document.querySelectorAll('.nav-item').forEach(item => {\n    item.classList.remove('active');\n    if (item.dataset.page === pageId) {\n      item.classList.add('active');\n    }\n  });\n\n  // 更新页面显示\n  document.querySelectorAll('.page').forEach(page => {\n    page.classList.remove('active');\n  });\n  const targetPage = document.getElementById(`page-${pageId}`);\n  if (targetPage) {\n    targetPage.classList.add('active');\n  }\n\n  // 加载页面数据\n  loadPageData(pageId);\n}\n\n// 加载页面数据\nasync function loadPageData(pageId) {\n  switch (pageId) {\n    case 'dashboard':\n      await loadDashboard();\n      break;\n    case 'agents':\n      await loadAgents();\n      break;\n    case 'tasks':\n      await loadTasks();\n      break;\n    case 'performance':\n      await loadPerformance();\n      break;\n    case 'logs':\n      await loadLogs();\n      break;\n    case 'screenshots':\n      await loadScreenshots();\n      break;\n    case 'settings':\n      loadSettings();\n      break;\n  }\n}\n\n// 获取 agents 数据\nasync function fetchAgents() {\n  try {\n    const response = await fetch(`${API_BASE}/agents`);\n    if (!response.ok) throw new Error('API 请求失败');\n    return await response.json();\n  } catch (error) {\n    console.error('获取 agents 失败:', error);\n    return [];\n  }\n}\n\n// 导出 Agents 数据\nasync function exportAgentsData() {\n  try {\n    const agents = await fetchAgents();\n    const dataStr = JSON.stringify(agents, null, 2);\n    const blob = new Blob([dataStr], { type: 'application/json' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement('a');\n    a.href = url;\n    a.download = `loopcli_agents_${new Date().toISOString().slice(0, 10)}.json`;\n    document.body.appendChild(a);\n    a.click();\n    document.body.removeChild(a);\n    URL.revokeObjectURL(url);\n    showNotification('数据导出成功', 'success');\n  } catch (error) {\n    console.error('导出失败:', error);\n    showNotification('导出失败', 'error');\n  }\n}\n\n// 创建 Agent 模态框\nasync function showCreateAgentModal() {\n  showNotification('正在加载模板...', 'info');\n\n  try {\n    // 获取模板列表\n    const response = await fetch(`${API_BASE}/templates`);\n    if (!response.ok) throw new Error('获取模板失败');\n    const templates = await response.json();\n\n    const modal = document.createElement('div');\n    modal.id = 'create-agent-modal';\n    modal.style.cssText = `\n      position: fixed; inset: 0; background: rgba(0, 0, 0, 0.7);\n      display: flex; align-items: center; justify-content: center;\n      z-index: 10000; animation: fadeIn 0.2s ease;\n    `;\n\n    // 按类别组织模板\n    const templatesByCategory = {};\n    templates.forEach(t => {\n      if (!templatesByCategory[t.category]) {\n        templatesByCategory[t.category] = [];\n      }\n      templatesByCategory[t.category].push(t);\n    });\n\n    // 生成模板选择HTML\n    let templatesHTML = '';\n    for (const [category, items] of Object.entries(templatesByCategory)) {\n      templatesHTML += `\n        <div style=\"margin-bottom: 20px;\">\n          <div style=\"font-size: 14px; font-weight: 600; color: var(--accent); margin-bottom: 12px; text-transform: capitalize;\">\n            ${category}\n          </div>\n          <div style=\"display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px;\">\n            ${items.map(t => `\n              <label class=\"template-option\" style=\"\n                display: flex; align-items: center; gap: 8px; padding: 12px;\n                background: var(--surface2); border: 1px solid var(--border);\n                border-radius: 8px; cursor: pointer; transition: all 0.2s;\n              \">\n                <input type=\"radio\" name=\"agent-template\" value=\"${t.id}\" style=\"margin: 0;\">\n                <div style=\"flex: 1;\">\n                  <div style=\"font-size: 13px; font-weight: 500; color: var(--text);\">${t.id}</div>\n                  <div style=\"font-size: 11px; color: var(--text3);\">${t.description || t.id}</div>\n                </div>\n              </label>\n            `).join('')}\n          </div>\n        </div>\n      `;\n    }\n\n    modal.innerHTML = `\n      <div style=\"\n        background: var(--surface); border: 1px solid var(--border);\n        border-radius: var(--radius); padding: 32px;\n        width: 700px; max-width: 90vw; max-height: 80vh; overflow-y: auto;\n        box-shadow: var(--shadow);\n      \">\n        <h3 style=\"font-size: 20px; font-weight: 700; margin-bottom: 8px; color: var(--text);\">\n          创建新 Agent\n        </h3>\n        <p style=\"font-size: 13px; color: var(--text2); margin-bottom: 24px;\">\n          从模板创建一个新的 Agent\n        </p>\n\n        <div style=\"margin-bottom: 24px;\">\n          <label style=\"display: block; font-size: 13px; color: var(--text2); margin-bottom: 8px;\">\n            Agent 名称 (可选)\n          </label>\n          <input type=\"text\" id=\"new-agent-name\" placeholder=\"留空使用模板名称\" style=\"\n            width: 100%; padding: 12px 16px; background: var(--surface2);\n            border: 1px solid var(--border); border-radius: 8px;\n            color: var(--text); font-size: 14px;\n          \">\n        </div>\n\n        <div style=\"margin-bottom: 24px;\">\n          <label style=\"display: block; font-size: 13px; color: var(--text2); margin-bottom: 12px;\">\n            选择模板\n          </label>\n          <div style=\"max-height: 400px; overflow-y: auto; padding-right: 8px;\">\n            ${templatesHTML || '<div style=\"color: var(--text2); text-align: center; padding: 20px;\">暂无可用模板</div>'}\n          </div>\n        </div>\n\n        <div style=\"display: flex; gap: 12px; justify-content: flex-end; padding-top: 16px; border-top: 1px solid var(--border);\">\n          <button onclick=\"closeCreateAgentModal()\" class=\"btn btn-secondary\"><i class=\"ti ti-x\"></i> 取消</button>\n          <button onclick=\"createNewAgent()\" class=\"btn btn-primary\"><i class=\"ti ti-plus\"></i> 创建</button>\n        </div>\n      </div>\n\n      <style>\n        .template-option:hover { background: var(--border) !important; }\n        .template-option input:checked + div { color: var(--accent); }\n      </style>\n    `;\n\n    modal.addEventListener('click', (e) => {\n      if (e.target === modal) closeCreateAgentModal();\n    });\n\n    document.body.appendChild(modal);\n\n  } catch (error) {\n    console.error('加载模板失败:', error);\n    showNotification('加载模板失败: ' + error.message, 'error');\n  }\n}\n\nfunction closeCreateAgentModal() {\n  const modal = document.getElementById('create-agent-modal');\n  if (modal) {\n    modal.style.animation = 'fadeOut 0.2s ease';\n    setTimeout(() => modal.remove(), 200);\n  }\n}\n\nasync function createNewAgent() {\n  const customName = document.getElementById('new-agent-name')?.value.trim() || '';\n  const selectedTemplate = document.querySelector('input[name=\"agent-template\"]:checked');\n\n  if (!selectedTemplate) {\n    showNotification('请选择一个模板', 'warning');\n    return;\n  }\n\n  const templateId = selectedTemplate.value;\n\n  try {\n    showNotification('正在创建 Agent...', 'info');\n\n    const response = await fetch(`${API_BASE}/agents/create`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({\n        template: templateId,\n        name: customName || null,\n        task: ''\n      })\n    });\n\n    if (!response.ok) {\n      const errorData = await response.json();\n      throw new Error(errorData.error || '创建失败');\n    }\n\n    const data = await response.json();\n    showNotification(`Agent \"${data.name || templateId}\" 创建成功！`, 'success');\n    closeCreateAgentModal();\n\n    // 刷新 Agent 列表\n    await loadAgents();\n\n  } catch (error) {\n    console.error('创建 Agent 失败:', error);\n    showNotification('创建失败: ' + error.message, 'error');\n  }\n}\n\nasync function refreshAgents() {\n  showNotification('正在刷新...', 'info');\n  await loadAgents();\n  showNotification('刷新成功', 'success');\n}\n\n// SVG 圆环图（自适应版）\nfunction drawDonutChart(containerId, data, colors) {\n  const container = document.getElementById(containerId);\n  if (!container) return;\n  const total = data.reduce((s, d) => s + d.value, 0);\n  if (total === 0) { container.innerHTML = '<span style=\"color:var(--text3)\">暂无数据</span>'; return; }\n\n  const size = 160, cx = 80, cy = 80, r = 58, stroke = 18;\n  const circumference = 2 * Math.PI * r;\n  let offset = 0;\n  const gapAngle = data.filter(d => d.value > 0).length > 1 ? 3 : 0;\n\n  let arcs = data.map((item, i) => {\n    if (item.value === 0) return '';\n    const pct = item.value / total;\n    const dash = Math.max(0, circumference * pct - gapAngle);\n    const gap = circumference - dash;\n    const color = colors[i % colors.length];\n    const html = `<circle cx=\"${cx}\" cy=\"${cy}\" r=\"${r}\" fill=\"none\" stroke=\"${color}\" stroke-width=\"${stroke}\" stroke-dasharray=\"${dash} ${gap}\" stroke-dashoffset=\"${-offset}\" stroke-linecap=\"round\" transform=\"rotate(-90 ${cx} ${cy})\" style=\"transition:all .6s cubic-bezier(.4,0,.2,1);filter:drop-shadow(0 0 6px ${color}40);\"/>`;\n    offset += dash + gapAngle;\n    return html;\n  }).join('');\n\n  const svg = `<svg viewBox=\"0 0 ${size} ${size}\" style=\"width:100%;height:auto;max-width:220px;filter:drop-shadow(0 4px 12px rgba(0,0,0,0.15));\">${arcs}<text x=\"${cx}\" y=\"${cy - 8}\" text-anchor=\"middle\" fill=\"var(--text)\" font-size=\"28\" font-weight=\"800\" font-family=\"system-ui,sans-serif\">${total}</text><text x=\"${cx}\" y=\"${cy + 14}\" text-anchor=\"middle\" fill=\"var(--text3)\" font-size=\"11\" font-family=\"system-ui,sans-serif\">总计</text></svg>`;\n\n  const legend = data.filter(d => d.value > 0).map((item, i) => {\n    const origIdx = data.indexOf(item);\n    const color = colors[origIdx % colors.length];\n    const pct = Math.round(item.value / total * 100);\n    return `<div class=\"donut-legend-item\" style=\"display:flex;align-items:center;gap:10px;padding:6px 0;\">\n      <span style=\"width:12px;height:12px;border-radius:3px;background:${color};flex-shrink:0;box-shadow:0 2px 6px ${color}40;\"></span>\n      <span style=\"font-size:14px;color:var(--text2);min-width:50px;\">${item.label}</span>\n      <span style=\"font-size:14px;font-weight:700;color:var(--text);margin-left:auto;\">${item.value}</span>\n      <span style=\"font-size:11px;color:var(--text3);min-width:36px;text-align:right;\">${pct}%</span>\n    </div>`;\n  }).join('');\n\n  container.innerHTML = `<div class=\"donut-chart-wrapper\" style=\"display:flex;align-items:center;justify-content:center;gap:28px;flex-wrap:wrap;\">${svg}<div class=\"donut-legend\" style=\"min-width:130px;\">${legend}</div></div>`;\n}\n\n// 进度条列表（美化版）\nfunction drawProgressBars(containerId, data, maxBar) {\n  const container = document.getElementById(containerId);\n  if (!container) return;\n  if (!data || data.length === 0) { container.innerHTML = '<div style=\"color:var(--text3);text-align:center;padding:20px;\">暂无数据</div>'; return; }\n  const maxVal = maxBar || Math.max(...data.map(d => d.value), 1);\n  const barColors = ['#6366f1','#8b5cf6','#a78bfa','#c4b5fd','#7c3aed','#5b21b6'];\n  container.innerHTML = data.map((item, idx) => {\n    const pct = Math.round((item.value / maxVal) * 100);\n    const color = barColors[idx % barColors.length];\n    return `<div style=\"margin-bottom:14px;padding:10px 14px;background:var(--surface2);border-radius:10px;transition:transform .2s ease;\">\n      <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;\">\n        <span style=\"color:var(--text);font-size:13px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;max-width:60%;\">${item.label}</span>\n        <span style=\"color:${color};font-weight:700;font-size:14px;flex-shrink:0;\">${pct}%</span>\n      </div>\n      <div style=\"height:6px;background:rgba(128,128,128,0.15);border-radius:3px;overflow:hidden;\">\n        <div style=\"height:100%;width:${pct}%;background:linear-gradient(90deg,${color},${color}cc);border-radius:3px;transition:width .6s cubic-bezier(.4,0,.2,1);box-shadow:0 0 8px ${color}40;\"></div>\n      </div>\n    </div>`;\n  }).join('');\n}\n\n// 绘制折线趋势图\nfunction drawLineChart(canvasId, data, color) {\n  const canvas = document.getElementById(canvasId);\n  if (!canvas) return;\n  const ctx = canvas.getContext('2d');\n  const rect = canvas.getBoundingClientRect();\n  canvas.width = rect.width * 2;\n  canvas.height = rect.height * 2;\n  ctx.scale(2, 2);\n\n  const padding = 40;\n  const chartWidth = canvas.width / 2 - padding * 2;\n  const chartHeight = canvas.height / 2 - padding * 2;\n\n  ctx.clearRect(0, 0, canvas.width, canvas.height);\n\n  const maxValue = Math.max(...data.map(d => d.value)) * 1.1;\n  const minValue = 0;\n  const range = maxValue - minValue;\n\n  const theme = document.documentElement.dataset.theme || 'dark';\n  const gridColor = theme === 'light' ? '#e5e7eb' : '#374151';\n  const textColor = theme === 'light' ? '#374151' : '#9ca3af';\n\n  // 绘制网格线\n  ctx.strokeStyle = gridColor;\n  ctx.lineWidth = 1;\n  for (let i = 0; i <= 5; i++) {\n    const y = padding + (chartHeight / 5) * i;\n    ctx.beginPath();\n    ctx.moveTo(padding, y);\n    ctx.lineTo(padding + chartWidth, y);\n    ctx.stroke();\n\n    const value = Math.round(maxValue - (range / 5) * i);\n    ctx.fillStyle = textColor;\n    ctx.font = '11px sans-serif';\n    ctx.textAlign = 'right';\n    ctx.fillText(value.toLocaleString(), padding - 8, y + 4);\n  }\n\n  if (data.length < 2) return;\n\n  const stepX = chartWidth / (data.length - 1);\n  const points = data.map((d, i) => ({\n    x: padding + i * stepX,\n    y: padding + chartHeight - ((d.value - minValue) / range) * chartHeight\n  }));\n\n  // 绘制渐变填充\n  const gradient = ctx.createLinearGradient(0, padding, 0, padding + chartHeight);\n  gradient.addColorStop(0, color + '40');\n  gradient.addColorStop(1, color + '00');\n\n  ctx.beginPath();\n  ctx.moveTo(points[0].x, padding + chartHeight);\n  points.forEach(p => ctx.lineTo(p.x, p.y));\n  ctx.lineTo(points[points.length - 1].x, padding + chartHeight);\n  ctx.closePath();\n  ctx.fillStyle = gradient;\n  ctx.fill();\n\n  // 绘制线条\n  ctx.beginPath();\n  ctx.moveTo(points[0].x, points[0].y);\n  points.forEach(p => ctx.lineTo(p.x, p.y));\n  ctx.strokeStyle = color;\n  ctx.lineWidth = 2;\n  ctx.stroke();\n\n  // 绘制数据点和标签\n  points.forEach((p, i) => {\n    ctx.beginPath();\n    ctx.arc(p.x, p.y, 4, 0, Math.PI * 2);\n    ctx.fillStyle = color;\n    ctx.fill();\n    ctx.strokeStyle = theme === 'light' ? '#ffffff' : '#1f2937';\n    ctx.lineWidth = 2;\n    ctx.stroke();\n\n    // X轴标签\n    ctx.fillStyle = textColor;\n    ctx.font = '11px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(data[i].label, p.x, padding + chartHeight + 20);\n  });\n}\n\n// 加载 Agents 页面\nasync function loadAgents() {\n  const agents = await fetchAgents();\n\n  // 按 run_count 降序排序\n  agents.sort((a, b) => (b.run_count || 0) - (a.run_count || 0));\n\n  // 更新统计（主页和Agent页共享的统计卡片）\n  const total = agents.length;\n  const active = agents.filter(a => a.status !== 'disabled').length;\n  const totalTasks = agents.reduce((sum, a) => sum + (a.task_count || 0), 0);\n  const doneTasks = agents.reduce((sum, a) => sum + (a.task_done || 0), 0);\n\n  const totalEl = document.getElementById('total-agents');\n  const activeEl = document.getElementById('active-agents');\n  const totalTasksEl = document.getElementById('total-tasks');\n  const doneTasksEl = document.getElementById('done-tasks');\n  if (totalEl) totalEl.textContent = total;\n  if (activeEl) activeEl.textContent = active;\n  if (totalTasksEl) totalTasksEl.textContent = totalTasks;\n  if (doneTasksEl) doneTasksEl.textContent = doneTasks;\n\n  // 渲染 agent cards\n  const grid = document.getElementById('agents-grid');\n  if (agents.length === 0) {\n    grid.innerHTML = '<div class=\"loading\"><div>暂无 Agents</div></div>';\n    return;\n  }\n\n  grid.innerHTML = agents.map(agent => {\n    const progress = agent.task_count > 0\n      ? Math.round((agent.task_done / agent.task_count) * 100)\n      : 0;\n\n    return `\n      <div class=\"agent-card\" data-id=\"${agent.id}\">\n        <div class=\"agent-header\">\n          <div>\n            <div class=\"agent-name\">${agent.name}</div>\n            <div class=\"agent-id\">${agent.id}</div>\n          </div>\n          <span class=\"status-badge ${agent.status}\">\n            <span class=\"status-dot\"></span>\n            <span>${agent.status === 'disabled' ? '已禁用' : agent.status === 'idle' ? '空闲' : agent.status === 'active' ? '运行中' : agent.status}</span>\n          </span>\n        </div>\n\n        <div class=\"agent-description\">\n          ${agent.description || '暂无描述'}\n        </div>\n\n        <div class=\"agent-stats\">\n          <div class=\"agent-stat\">\n            <span class=\"label\">运行次数:</span>\n            <span class=\"value\">${agent.run_count || 0}</span>\n          </div>\n          <div class=\"agent-stat\">\n            <span class=\"label\">最后运行:</span>\n            <span class=\"value\">${agent.last_run || '从未'}</span>\n          </div>\n          <div class=\"agent-stat\">\n            <span class=\"label\">任务:</span>\n            <span class=\"value\">${agent.task_done}/${agent.task_count}</span>\n          </div>\n          <div class=\"agent-stat\">\n            <span class=\"label\">当前任务:</span>\n            <span class=\"value\">${agent.current_task || '无'}</span>\n          </div>\n          ${agent.task_count > 0 ? `\n          <div class=\"task-progress\">\n            <div class=\"task-progress-bar\">\n              <div class=\"task-progress-fill\" style=\"width: ${progress}%\"></div>\n            </div>\n          </div>\n          ` : ''}\n        </div>\n\n        <div class=\"agent-actions\">\n          <button class=\"btn btn-primary\" onclick=\"enableAgent('${agent.id}')\">\n            <i class=\"ti ti-player-play\"></i> 启用\n          </button>\n          <button class=\"btn btn-secondary\" onclick=\"disableAgent('${agent.id}')\">\n            <i class=\"ti ti-player-stop\"></i> 禁用\n          </button>\n        </div>\n      </div>\n    `;\n  }).join('');\n}\n\n// 加载主页 Dashboard\nasync function loadDashboard() {\n  const agents = await fetchAgents();\n  agents.sort((a, b) => (b.run_count || 0) - (a.run_count || 0));\n\n  // 更新统计\n  const total = agents.length;\n  const active = agents.filter(a => a.status !== 'disabled').length;\n  const totalTasks = agents.reduce((sum, a) => sum + (a.task_count || 0), 0);\n  const doneTasks = agents.reduce((sum, a) => sum + (a.task_done || 0), 0);\n\n  const totalEl = document.getElementById('total-agents');\n  const activeEl = document.getElementById('active-agents');\n  const totalTasksEl = document.getElementById('total-tasks');\n  const doneTasksEl = document.getElementById('done-tasks');\n  if (totalEl) totalEl.textContent = total;\n  if (activeEl) activeEl.textContent = active;\n  if (totalTasksEl) totalTasksEl.textContent = totalTasks;\n  if (doneTasksEl) doneTasksEl.textContent = doneTasks;\n\n  // 绘制圆环图\n  const statusCounts = {};\n  agents.forEach(a => {\n    statusCounts[a.status] = (statusCounts[a.status] || 0) + 1;\n  });\n  const statusData = Object.entries(statusCounts).map(([status, count]) => ({\n    label: status,\n    value: count\n  }));\n  const statusColors = ['#10b981', '#f59e0b', '#ef4444', '#3b82f6'];\n  drawDonutChart('agent-status-chart', statusData, statusColors);\n\n  // 任务进度\n  const taskData = agents\n    .filter(a => a.task_count > 0)\n    .map(a => ({\n      label: a.name.substring(0, 12),\n      value: a.task_done,\n      max: a.task_count\n    }));\n  drawProgressBars('task-progress-chart', taskData.map(d => ({label: `${d.label} (${d.value}/${d.max})`, value: d.value})));\n\n  // 加载长期任务\n  if (typeof loadLongTask === 'function') loadLongTask();\n\n  // 加载用量统计\n  if (typeof loadUsageStats === 'function') loadUsageStats();\n}\n\n// 加载 Tasks 页面\nasync function loadTasks() {\n  try {\n    const response = await fetch(`${API_BASE}/tasks`);\n    if (!response.ok) throw new Error('API 请求失败');\n    const tasks = await response.json();\n\n    const tbody = document.getElementById('tasks-table-body');\n    if (tasks.length === 0) {\n      tbody.innerHTML = '<tr><td colspan=\"5\" style=\"text-align: center; color: var(--text2);\">暂无任务</td></tr>';\n      return;\n    }\n\n    tbody.innerHTML = tasks.map(task => `\n      <tr>\n        <td>${task.id}</td>\n        <td>${task.title || task.subject || '-'}</td>\n        <td><span class=\"status-badge ${task.status}\">${task.status}</span></td>\n        <td>${task.agent_id || '-'}</td>\n        <td>${task.created_at || '-'}</td>\n      </tr>\n    `).join('');\n  } catch (error) {\n    console.error('加载任务失败:', error);\n    document.getElementById('tasks-table-body').innerHTML =\n      '<tr><td colspan=\"5\" style=\"text-align: center; color: var(--red);\">加载失败</td></tr>';\n  }\n}\n\n// 加载 Performance 页面\nasync function loadPerformance() {\n  // 1) 系统指标 + 响应时间（测量 health API）\n  try {\n    const t0 = performance.now();\n    const healthResp = await fetch(`${API_BASE}/health`);\n    const latency = performance.now() - t0;\n    if (healthResp.ok) {\n      const health = await healthResp.json();\n      if (health.system) {\n        document.getElementById('cpu-usage').textContent = health.system.cpu_percent + '%';\n        document.getElementById('memory-usage').textContent = health.system.memory_percent + '%';\n      }\n    }\n    document.getElementById('response-time').textContent = Math.round(latency) + 'ms';\n  } catch(e) {\n    document.getElementById('response-time').textContent = '离线';\n  }\n\n  // 2) Token消耗趋势\n  try {\n    const trendResp = await fetch(`${API_BASE}/usage/trend`);\n    if (trendResp.ok) {\n      const trendRaw = await trendResp.json();\n      const trendData = Array.isArray(trendRaw) ? trendRaw : (trendRaw.data || []);\n      const total = trendData.reduce((s, d) => s + d.value, 0);\n      if (trendData.length && total > 0) {\n        drawLineChart('token-trend-chart', trendData, '#3b82f6');\n        document.getElementById('token-trend-summary').textContent =\n          trendRaw.summary || `${trendData.length}天累计 ${total} 次任务，平均 ${Math.round(total / trendData.length)} 次/天`;\n      } else {\n        drawLineChart('token-trend-chart', [], '#3b82f6');\n        document.getElementById('token-trend-summary').textContent = '近7天数据收集中';\n      }\n    }\n  } catch(e) {}\n\n  // 3) Token用量摘要\n  try {\n    const usageResp = await fetch(`${API_BASE}/usage`);\n    if (usageResp.ok) {\n      const usage = await usageResp.json();\n      if (usage.error) {\n        document.getElementById('token-usage').textContent = '暂无';\n      } else if (usage.total_tokens) {\n        document.getElementById('token-usage').textContent = Number(usage.total_tokens).toLocaleString();\n      } else if (usage.weekly) {\n        const wk = usage.weekly;\n        document.getElementById('token-usage').textContent = (wk.total_runs || 0) + '次';\n      } else {\n        document.getElementById('token-usage').textContent = '暂无';\n      }\n    }\n  } catch(e) {\n    document.getElementById('token-usage').textContent = '暂无';\n  }\n}\n\n// 加载 Logs 页面\nasync function loadLogs() {\n  try {\n    const response = await fetch(`${API_BASE}/logs`);\n    if (!response.ok) throw new Error('API 请求失败');\n    const data = await response.json();\n\n    const container = document.getElementById('logs-content');\n    const lines = Array.isArray(data) ? data : (data.lines || []);\n    if (!lines || lines.length === 0) {\n      container.innerHTML = '<div style=\"text-align: center; color: var(--text2);\">暂无日志</div>';\n      return;\n    }\n\n    // Parse table-format logs: | time | status | task | summary |\n    const logEntries = lines\n      .filter(l => l.trim().startsWith('|') && !l.trim().startsWith('|--') && !l.trim().startsWith('| 时间') && !l.trim().startsWith('| #'))\n      .slice(-50)\n      .map(line => {\n        const parts = line.split('|').map(s => s.trim()).filter(Boolean);\n        if (parts.length >= 4) {\n          return { time: parts[0], status: parts[1], task: parts[2], message: parts[3] };\n        }\n        return { time: '', status: '', task: '', message: line };\n      });\n\n    if (logEntries.length === 0) {\n      container.innerHTML = '<div style=\"text-align: center; color: var(--text2);\">暂无日志条目</div>';\n      return;\n    }\n\n    container.innerHTML = logEntries.map(log => {\n      const levelClass = log.status === 'done' ? 'success' : log.status === 'idle' ? 'warning' : 'info';\n      return `<div class=\"log-entry\">\n        <span class=\"log-time\">${log.time || '-'}</span>\n        <span class=\"log-level ${levelClass}\">${log.status || 'info'}</span>\n        <span style=\"color:var(--accent);font-weight:600;margin-right:8px;font-size:12px;\">${log.task}</span>\n        <span class=\"log-message\">${log.message || '-'}</span>\n      </div>`;\n    }).join('');\n  } catch (error) {\n    console.error('加载日志失败:', error);\n    document.getElementById('logs-content').innerHTML =\n      '<div style=\"text-align: center; color: var(--red);\">加载失败</div>';\n  }\n}\n\n// 加载 Screenshots 页面\nasync function loadScreenshots() {\n  try {\n    const response = await fetch('/api/screenshots');\n    const data = await response.json();\n\n    if (data.error) {\n      document.getElementById('screenshots-grid').innerHTML =\n        `<div style=\"grid-column: 1/-1; text-align: center; color: var(--text2); padding: 40px;\">错误: ${data.error}</div>`;\n      return;\n    }\n\n    const grid = document.getElementById('screenshots-grid');\n    if (data.screenshots.length === 0) {\n      grid.innerHTML =\n        '<div style=\"grid-column: 1/-1; text-align: center; color: var(--text2); padding: 40px;\">暂无截图</div>';\n      return;\n    }\n\n    grid.innerHTML = data.screenshots.map(screenshot => `\n      <div style=\"background: var(--surface2); border-radius: 12px; overflow: hidden; border: 1px solid var(--border);\">\n        <img src=\"${screenshot.url}\" alt=\"${screenshot.name}\"\n             style=\"width: 100%; height: 200px; object-fit: cover; cursor: pointer;\"\n             onclick=\"window.open('${screenshot.url}', '_blank')\">\n        <div style=\"padding: 12px;\">\n          <div style=\"font-size: 13px; font-weight: 500; color: var(--text); margin-bottom: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;\" title=\"${screenshot.name}\">\n            ${screenshot.name}\n          </div>\n          <div style=\"font-size: 11px; color: var(--text2); display: flex; justify-content: space-between;\">\n            <span>${screenshot.size} KB</span>\n            <span>${new Date(screenshot.modified).toLocaleString('zh-CN')}</span>\n          </div>\n        </div>\n      </div>\n    `).join('');\n  } catch (error) {\n    console.error('加载截图失败:', error);\n    document.getElementById('screenshots-grid').innerHTML =\n      '<div style=\"grid-column: 1/-1; text-align: center; color: var(--text2); padding: 40px;\">加载失败</div>';\n  }\n}\n\n// 主题选择器初始化（Settings页面专用）\nfunction initThemeSelector() {\n  const savedTheme = localStorage.getItem('webui_theme') || 'dark';\n  const themeSelector = document.getElementById('theme-selector');\n  if (themeSelector) {\n    themeSelector.value = savedTheme;\n    themeSelector.addEventListener('change', (e) => {\n      const newTheme = e.target.value;\n      if (newTheme === 'dark') {\n        document.documentElement.removeAttribute('data-theme');\n      } else {\n        document.documentElement.setAttribute('data-theme', newTheme);\n      }\n      localStorage.setItem('webui_theme', newTheme);\n      updateThemeIcon(newTheme);\n      currentThemeIndex = themes.indexOf(newTheme);\n      showNotification(`主题已切换: ${newTheme}`, 'success');\n    });\n  }\n}\n\n// 加载 Settings 页面\nasync function loadSettings() {\n  initThemeSelector();\n  await loadSystemInfo();\n  loadLongTask();\n}\n\nasync function loadSystemInfo() {\n  try {\n    const resp = await fetch(`${API_BASE}/health`);\n    if (!resp.ok) throw new Error('health API failed');\n    const data = await resp.json();\n\n    document.getElementById('server-status').textContent =\n      data.status === 'healthy' ? '运行中' : data.status;\n\n    if (data.uptime_seconds != null) {\n      const s = Math.floor(data.uptime_seconds);\n      const h = Math.floor(s / 3600);\n      const m = Math.floor((s % 3600) / 60);\n      const sec = s % 60;\n      document.getElementById('server-uptime').textContent = `${h}小时 ${m}分钟 ${sec}秒`;\n    }\n\n    if (data.agents) {\n      document.getElementById('agent-stats').textContent =\n        `总计 ${data.agents.total} 个，活跃 ${data.agents.active} 个，禁用 ${data.agents.disabled} 个`;\n    }\n\n    if (data.system) {\n      const sys = data.system;\n      const item = document.getElementById('sys-resource-item');\n      const desc = document.getElementById('sys-resource');\n      item.style.display = '';\n      desc.textContent = `CPU ${sys.cpu_percent}% | 内存 ${sys.memory_percent}% (可用 ${sys.memory_available_gb}GB) | 磁盘 ${sys.disk_percent}% (剩余 ${sys.disk_free_gb}GB)`;\n    }\n  } catch (e) {\n    document.getElementById('server-status').textContent = '连接失败';\n  }\n}\n\n// 启用 agent\nasync function enableAgent(id) {\n  try {\n    const response = await fetch(`${API_BASE}/agents/${id}/enable`, { method: 'POST' });\n    if (response.ok) {\n      showNotification('Agent 已启用', 'success');\n      setTimeout(() => loadAgents(), 1000);\n    }\n  } catch (error) {\n    showNotification('启用失败: ' + error.message, 'error');\n  }\n}\n\n// 禁用 agent\nasync function disableAgent(id) {\n  try {\n    const response = await fetch(`${API_BASE}/agents/${id}/disable`, { method: 'POST' });\n    if (response.ok) {\n      showNotification('Agent 已禁用', 'success');\n      setTimeout(() => loadAgents(), 1000);\n    }\n  } catch (error) {\n    showNotification('禁用失败: ' + error.message, 'error');\n  }\n}\n\n// 清空日志\nfunction clearLogs() {\n  document.getElementById('logs-content').innerHTML = '<div style=\"text-align: center; color: var(--text2);\">日志已清空</div>';\n  showNotification('日志已清空', 'success');\n}\n\n// 长期任务相关函数\nasync function loadLongTask() {\n  try {\n    const response = await fetch(`${API_BASE}/longtask`);\n    if (!response.ok) throw new Error('API 请求失败');\n    const data = await response.json();\n\n    // 更新主页卡片\n    const mainStatusEl = document.getElementById('longtask-status-main');\n    const mainContentEl = document.getElementById('longtask-content-main');\n    const mainTextEl = document.getElementById('longtask-content-main');\n    const mainBadgeEl = document.getElementById('longtask-badge');\n    const mainEditBtn = document.getElementById('edit-longtask-btn-main');\n    const mainCancelBtn = document.getElementById('cancel-longtask-btn-main');\n\n    if (data.exists) {\n      // 主页更新\n      if (mainStatusEl) mainStatusEl.innerHTML = `<strong style=\"color: var(--accent);\">进行中</strong>`;\n      if (mainTextEl) mainTextEl.textContent = data.content;\n      if (mainContentEl) mainContentEl.style.display = 'block';\n      if (mainBadgeEl) mainBadgeEl.style.display = 'inline-block';\n      if (mainEditBtn) mainEditBtn.style.display = 'block';\n      if (mainCancelBtn) mainCancelBtn.style.display = 'block';\n    } else {\n      // 主页更新 - 无任务\n      if (mainStatusEl) mainStatusEl.textContent = '暂无长期任务';\n      if (mainContentEl) mainContentEl.style.display = 'none';\n      if (mainBadgeEl) mainBadgeEl.style.display = 'none';\n      if (mainEditBtn) mainEditBtn.style.display = 'none';\n      if (mainCancelBtn) mainCancelBtn.style.display = 'none';\n    }\n\n    // 更新设置页面（保持兼容）\n    const statusEl = document.getElementById('longtask-status');\n    const contentEl = document.getElementById('longtask-content');\n    const textEl = document.getElementById('longtask-text');\n    const cancelBtn = document.getElementById('cancel-longtask-btn');\n\n    if (data.exists) {\n      if (statusEl) statusEl.textContent = '有活动任务';\n      if (textEl) textEl.textContent = data.content;\n      if (contentEl) contentEl.style.display = 'block';\n      if (cancelBtn) cancelBtn.style.display = 'block';\n      const editBtn = document.getElementById('edit-longtask-btn');\n      if (editBtn) editBtn.style.display = 'block';\n    } else {\n      if (statusEl) statusEl.textContent = '无长期任务';\n      if (contentEl) contentEl.style.display = 'none';\n      if (cancelBtn) cancelBtn.style.display = 'none';\n    }\n  } catch (error) {\n    console.error('加载长期任务失败:', error);\n    const mainStatusEl = document.getElementById('longtask-status-main');\n    const statusEl = document.getElementById('longtask-status');\n    if (mainStatusEl) mainStatusEl.textContent = '加载失败';\n    if (statusEl) statusEl.textContent = '加载失败';\n  }\n}\n\nasync function cancelLongTask() {\n  if (!confirm('确定要取消长期任务吗？此操作不可恢复。')) return;\n\n  try {\n    const response = await fetch(`${API_BASE}/longtask/clear`, { method: 'POST' });\n    if (!response.ok) throw new Error('API 请求失败');\n    const data = await response.json();\n\n    showNotification(data.message || '长期任务已取消', 'success');\n    await loadLongTask();\n  } catch (error) {\n    console.error('取消长期任务失败:', error);\n    showNotification('取消失败: ' + error.message, 'error');\n  }\n}\n\n// 通知系统\n\nasync function startEditLongTask() {\n  const contentEl = document.getElementById('longtask-content');\n  const editEl = document.getElementById('longtask-edit');\n  const editorEl = document.getElementById('longtask-editor');\n  const textEl = document.getElementById('longtask-text');\n  \n  editorEl.value = textEl.textContent || '';\n  contentEl.style.display = 'none';\n  editEl.style.display = 'block';\n  showNotification('进入编辑模式', 'info');\n}\n\nasync function saveLongTask() {\n  const editorEl = document.getElementById('longtask-editor');\n  const content = editorEl.value;\n  \n  try {\n    const response = await fetch(`${API_BASE}/longtask/update`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ content })\n    });\n    if (!response.ok) throw new Error('API 请求失败');\n    const data = await response.json();\n    \n    showNotification(data.message || '长期任务已更新', 'success');\n    document.getElementById('longtask-edit').style.display = 'none';\n    await loadLongTask();\n  } catch (error) {\n    console.error('保存长期任务失败:', error);\n    showNotification('保存失败: ' + error.message, 'error');\n  }\n}\n\nfunction cancelEditLongTask() {\n  document.getElementById('longtask-edit').style.display = 'none';\n  document.getElementById('longtask-content').style.display = 'block';\n  showNotification('已取消编辑', 'info');\n}\n\n// 主页长期任务编辑函数\nasync function startEditLongTaskMain() {\n  const contentEl = document.getElementById('longtask-content-main');\n  const editEl = document.getElementById('longtask-edit-main');\n  const editorEl = document.getElementById('longtask-editor-main');\n\n  editorEl.value = contentEl.textContent || '';\n  contentEl.style.display = 'none';\n  editEl.style.display = 'block';\n  showNotification('进入编辑模式', 'info');\n}\n\nasync function saveLongTaskMain() {\n  const editorEl = document.getElementById('longtask-editor-main');\n  const content = editorEl.value;\n\n  try {\n    const response = await fetch(`${API_BASE}/longtask/update`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ content })\n    });\n    if (!response.ok) throw new Error('API 请求失败');\n    const data = await response.json();\n\n    showNotification(data.message || '长期任务已更新', 'success');\n    document.getElementById('longtask-edit-main').style.display = 'none';\n    await loadLongTask();\n  } catch (error) {\n    console.error('保存长期任务失败:', error);\n    showNotification('保存失败: ' + error.message, 'error');\n  }\n}\n\nfunction cancelEditLongTaskMain() {\n  document.getElementById('longtask-edit-main').style.display = 'none';\n  document.getElementById('longtask-content-main').style.display = 'block';\n  showNotification('已取消编辑', 'info');\n}\n\nasync function cancelLongTaskMain() {\n  if (!confirm('确定要取消长期任务吗？此操作不可恢复。')) return;\n\n  try {\n    const response = await fetch(`${API_BASE}/longtask/clear`, { method: 'POST' });\n    if (!response.ok) throw new Error('API 请求失败');\n    const data = await response.json();\n\n    showNotification(data.message || '长期任务已取消', 'success');\n    await loadLongTask();\n  } catch (error) {\n    console.error('取消长期任务失败:', error);\n    showNotification('取消失败: ' + error.message, 'error');\n  }\n}\n\n// 导航切换事件\ndocument.querySelectorAll('.nav-item').forEach(item => {\n  item.addEventListener('click', () => {\n    const pageId = item.dataset.page;\n    if (pageId) {\n      navigateTo(pageId);\n    }\n  });\n});\n\n// 自动刷新\nlet autoRefreshTimer = null;\n\nfunction startAutoRefresh(interval = 10000) {\n  stopAutoRefresh();\n  autoRefreshTimer = setInterval(async () => {\n    const activePage = document.querySelector('.page.active');\n    if (activePage) {\n      const pageId = activePage.id.replace('page-', '');\n      await loadPageData(pageId);\n    }\n  }, interval);\n  updateRefreshIndicator(true, interval);\n  console.log(`自动刷新已启动 (${interval}ms)`);\n}\n\nfunction stopAutoRefresh() {\n  if (autoRefreshTimer) {\n    clearInterval(autoRefreshTimer);\n    autoRefreshTimer = null;\n    updateRefreshIndicator(false, 0);\n    console.log('自动刷新已停止');\n  }\n}\n\n// 键盘快捷键\nconst keyboardShortcuts = {\n  '1': 'dashboard',\n  '2': 'agents',\n  '3': 'tasks',\n  '4': 'performance',\n  '5': 'logs',\n  '6': 'screenshots',\n  '7': 'settings',\n  'r': 'refresh',\n  'h': 'help'\n};\n\n// 显示快捷键帮助\nfunction showKeyboardHelp() {\n  const helpHTML = `\n    <div style=\"position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);\n                background: var(--surface); border: 1px solid var(--border);\n                border-radius: var(--radius); padding: 24px; z-index: 2000;\n                box-shadow: var(--shadow); min-width: 300px;\">\n      <h3 style=\"margin-bottom: 16px; color: var(--text);\">键盘快捷键</h3>\n      <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 13px;\">\n        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">1</kbd></div>\n        <div style=\"color: var(--text);\">Agents 页面</div>\n        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">2</kbd></div>\n        <div style=\"color: var(--text);\">Tasks 页面</div>\n        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">3</kbd></div>\n        <div style=\"color: var(--text);\">Performance 页面</div>\n        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">4</kbd></div>\n        <div style=\"color: var(--text);\">Logs 页面</div>\n        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">5</kbd></div>\n        <div style=\"color: var(--text);\">Settings 页面</div>\n        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">R</kbd></div>\n        <div style=\"color: var(--text);\">刷新当前页面</div>\n        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">H</kbd></div>\n        <div style=\"color: var(--text);\">显示帮助</div>\n        <div style=\"color: var(--text2);\"><kbd style=\"background: var(--surface2); padding: 2px 6px; border-radius: 4px;\">ESC</kbd></div>\n        <div style=\"color: var(--text);\">关闭弹窗</div>\n      </div>\n      <button onclick=\"this.parentElement.remove()\"\n              style=\"margin-top: 16px; width: 100%; padding: 8px; background: var(--accent-gradient);\n                     color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;\">\n        关闭\n      </button>\n    </div>\n  `;\n\n  // 移除已存在的帮助\n  const existingHelp = document.querySelector('[data-keyboard-help]');\n  if (existingHelp) existingHelp.remove();\n\n  // 添加新帮助\n  const helpContainer = document.createElement('div');\n  helpContainer.innerHTML = helpHTML;\n  helpContainer.firstElementChild.setAttribute('data-keyboard-help', 'true');\n  document.body.appendChild(helpContainer.firstElementChild);\n}\n\n// 键盘事件监听\ndocument.addEventListener('keydown', (e) => {\n  // ESC 关闭弹窗（无论是否在输入框中）\n  if (e.key === 'Escape') {\n    const createModal = document.getElementById('create-agent-modal');\n    if (createModal) { closeCreateAgentModal(); e.preventDefault(); return; }\n    closeShortcutsPanel();\n    const help = document.querySelector('[data-keyboard-help]');\n    if (help) help.remove();\n    return;\n  }\n\n  // 如果在输入框中，不处理其他快捷键\n  if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;\n\n  const key = e.key.toLowerCase();\n\n  // 处理其他快捷键\n  if (keyboardShortcuts[key]) {\n    e.preventDefault();\n    const action = keyboardShortcuts[key];\n\n    if (action === 'refresh') {\n      const activePage = document.querySelector('.page.active');\n      if (activePage) {\n        const pageId = activePage.id.replace('page-', '');\n        loadPageData(pageId);\n        showNotification('页面已刷新', 'success');\n      }\n    } else if (action === 'help') {\n      openShortcutsPanel();\n    } else {\n      navigateTo(action);\n    }\n  }\n});\n\n// 用量统计\nasync function loadUsageStats() {\n  const el = document.getElementById('usage-content');\n  const timeEl = document.getElementById('usage-refresh-time');\n  try {\n    const resp = await fetch(`${API_BASE}/usage`);\n    const data = await resp.json();\n    if (data.error) { el.innerHTML = `<span style=\"color:var(--red)\">加载失败: ${data.error}</span>`; return; }\n\n    const fmt = n => typeof n === 'number' ? n.toLocaleString() : n;\n    const pctColor = p => p > 80 ? 'var(--red)' : p > 50 ? 'var(--yellow)' : 'var(--green)';\n    const pctBadge = (label, pct) => `<span style=\"display:inline-flex;align-items:center;gap:6px;padding:6px 14px;background:var(--surface2);border-radius:8px;font-size:13px;\"><span style=\"color:var(--text2)\">${label}</span><span style=\"font-weight:700;color:${pctColor(pct)}\">${pct}%</span></span>`;\n\n    // 额度进度条组件\n    const barColor = p => p > 80 ? '#ef4444' : p > 50 ? '#f59e0b' : '#22c55e';\n    const quotaBar = (label, pct, detail) => {\n      const c = barColor(pct);\n      return `<div style=\"margin-bottom:12px;\">\n        <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;\">\n          <span style=\"font-size:13px;font-weight:600;color:var(--text2)\">${label}</span>\n          <span style=\"font-size:13px;font-weight:700;color:${c}\">${pct}%${detail ? ` (${detail})` : ''}</span>\n        </div>\n        <div style=\"height:10px;background:rgba(128,128,128,0.2);border-radius:5px;overflow:hidden;\">\n          <div style=\"height:100%;width:${Math.min(pct,100)}%;background:${c};border-radius:5px;transition:width .6s ease;\"></div>\n        </div>\n      </div>`;\n    };\n\n    let html = `<div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:20px;\">\n      <div style=\"padding:14px 16px;background:var(--surface2);border-radius:12px;text-align:center;\">\n        <div style=\"font-size:12px;color:var(--text3);margin-bottom:4px;\">24h 调用</div>\n        <div style=\"font-size:20px;font-weight:800;color:var(--text);font-family:system-ui,sans-serif;\">${fmt(data.call_count)}</div>\n      </div>\n      <div style=\"padding:14px 16px;background:var(--surface2);border-radius:12px;text-align:center;\">\n        <div style=\"font-size:12px;color:var(--text3);margin-bottom:4px;\">24h Token</div>\n        <div style=\"font-size:20px;font-weight:800;color:var(--text);font-family:system-ui,sans-serif;\">${fmt(data.total_tokens)}</div>\n      </div>\n      ${data.weekly && data.weekly.tokens ? `<div style=\"padding:14px 16px;background:var(--surface2);border-radius:12px;text-align:center;\">\n        <div style=\"font-size:12px;color:var(--text3);margin-bottom:4px;\">7天 Token</div>\n        <div style=\"font-size:20px;font-weight:800;color:var(--text);font-family:system-ui,sans-serif;\">${fmt(data.weekly.tokens)}</div>\n      </div>\n      <div style=\"padding:14px 16px;background:var(--surface2);border-radius:12px;text-align:center;\">\n        <div style=\"font-size:12px;color:var(--text3);margin-bottom:4px;\">7天调用</div>\n        <div style=\"font-size:20px;font-weight:800;color:var(--text);font-family:system-ui,sans-serif;\">${fmt(data.weekly.calls)}</div>\n      </div>` : ''}\n    </div>`;\n\n    // 额度面板（卡片式）\n    if (data.quotas && data.quotas.length > 0) {\n      html += `<div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;margin-bottom:20px;\">`;\n      (data.quotas).forEach(q => {\n        let detail = '';\n        if (q.type === 'mcp_month' && q.current !== undefined && q.total !== undefined) {\n          detail = `${q.current}/${q.total} 分钟`;\n        }\n        const c = barColor(q.percentage);\n        html += `<div style=\"padding:16px;background:var(--surface2);border-radius:12px;border-left:3px solid ${c};\">\n          <div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;\">\n            <span style=\"font-size:13px;font-weight:600;color:var(--text2)\">${q.label}</span>\n            <span style=\"font-size:15px;font-weight:800;color:${c};font-family:system-ui,sans-serif;\">${q.percentage}%</span>\n          </div>\n          <div style=\"height:6px;background:rgba(128,128,128,0.15);border-radius:3px;overflow:hidden;\">\n            <div style=\"height:100%;width:${Math.min(q.percentage,100)}%;background:${c};border-radius:3px;transition:width .6s ease;box-shadow:0 0 8px ${c}40;\"></div>\n          </div>\n          ${detail ? `<div style=\"font-size:11px;color:var(--text3);margin-top:6px;\">${detail}</div>` : ''}\n        </div>`;\n      });\n      html += `</div>`;\n    }\n\n    // 模型明细（紧凑列表）\n    if (data.models && data.models.length > 0) {\n      html += `<div style=\"font-size:12px;color:var(--text3);margin-bottom:8px;text-transform:uppercase;letter-spacing:1px;\">模型用量</div>`;\n      html += `<div style=\"display:flex;flex-wrap:wrap;gap:8px;\">` + data.models.map(m => `<div style=\"display:flex;align-items:center;gap:6px;padding:6px 12px;background:var(--surface2);border-radius:8px;font-size:13px;\"><span style=\"color:var(--accent);font-weight:600;\">${m.name}</span><span style=\"color:var(--text2)\">${fmt(m.tokens)} tokens</span></div>`).join('') + `</div>`;\n    }\n\n    el.innerHTML = html;\n    timeEl.textContent = `更新于 ${new Date().toLocaleTimeString('zh-CN')} (每5分钟刷新)`;\n  } catch (e) {\n    el.innerHTML = `<span style=\"color:var(--red)\">加载失败</span>`;\n  }\n}\n\n// 初始化\nasync function init() {\n  // 初始化主题\n  initTheme();\n\n  // 加载初始页面（dashboard）\n  await loadDashboard();\n\n  // 初始化搜索功能\n  initSearch();\n\n  // 定期刷新用量统计\n  setInterval(loadUsageStats, 5 * 60 * 1000);\n\n  // 启动自动刷新（10秒）\n  startAutoRefresh(10000);\n\n  // 设置刷新间隔监听\n  document.getElementById('refresh-interval')?.addEventListener('change', (e) => {\n    const interval = parseInt(e.target.value) * 1000;\n    startAutoRefresh(interval);\n    showNotification(`刷新间隔已更新为 ${e.target.value} 秒`, 'success');\n  });\n\n  // 主题切换按钮\n  document.getElementById('theme-toggle')?.addEventListener('click', () => {\n    cycleTheme();\n    showNotification(`已切换到 ${themes[currentThemeIndex]} 主题`, 'success');\n  });\n\n  // 帮助按钮\n  document.getElementById('help-toggle')?.addEventListener('click', openShortcutsPanel);\n  document.getElementById('shortcuts-overlay')?.addEventListener('click', closeShortcutsPanel);\n\n  // 显示快捷键提示（首次访问）\n  if (!localStorage.getItem('webui_keyboard_help_shown')) {\n    setTimeout(() => {\n      showNotification('按 H 查看键盘快捷键', 'info', 5000);\n      localStorage.setItem('webui_keyboard_help_shown', 'true');\n    }, 2000);\n  }\n}\n\ninit();\n</script>\n</body>\n</html>\n","structuredPatch":[{"oldStart":869,"oldLines":6,"newStart":869,"newLines":16,"lines":[" .metric-change.positive { color: var(--green); }"," .metric-change.negative { color: var(--red); }"," ","+/* 圆环图自适应 */","+.donut-chart-wrapper { flex-wrap: wrap; }","+.donut-chart-wrapper svg { max-width: 220px; }","+.donut-legend { flex: 1; min-width: 130px; }","+@media (max-width: 480px) {","+  .donut-chart-wrapper { flex-direction: column; gap: 16px !important; }","+  .donut-chart-wrapper svg { max-width: 160px; }","+  .donut-legend { min-width: 100%; }","+}","+"," /* 响应式 */"," @media (max-width: 1024px) {","   .sidebar { width: 220px; }"]}],"userModified":false,"replaceAll":false}}
