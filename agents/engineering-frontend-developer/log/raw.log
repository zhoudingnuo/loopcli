{"type":"assistant","message":{"id":"msg_20260523123802930b8c78619c4476","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_d03345f19393419e9738efc9","name":"Write","input":{"file_path":"D:\\game-projects\\steam-horror-sim\\src\\game\\DayCycle.ts","content":"// DayCycle.ts — Full day loop management with phase transitions (M3)\n\nimport { GamePhase, getPhaseFromTime } from './GameState';\n\nexport interface DayPhaseConfig {\n  phase: GamePhase;\n  startHour: number;\n  endHour: number;\n  label: string;\n  timeSpeed: number;\n}\n\nexport const DAY_PHASES: DayPhaseConfig[] = [\n  { phase: GamePhase.DAYTIME, startHour: 6, endHour: 22, label: '营业中', timeSpeed: 10 },\n  { phase: GamePhase.NIGHT_TRANSITION, startHour: 22, endHour: 23, label: '准备打烊', timeSpeed: 5 },\n  { phase: GamePhase.NIGHT, startHour: 23, endHour: 26, label: '深夜营业', timeSpeed: 5 },\n  { phase: GamePhase.DANGER, startHour: 26, endHour: 29, label: '危险时段', timeSpeed: 5 },\n  { phase: GamePhase.DAWN, startHour: 29, endHour: 30, label: '黎明', timeSpeed: 5 },\n];\n\nexport type PhaseChangeListener = (phase: GamePhase, prevPhase: GamePhase, day: number, timeOfDay: number) => void;\nexport type NewDayListener = (day: number) => void;\n\nexport class DayCycle {\n  private day: number = 1;\n  private timeOfDay: number = 6;\n  private baseTimeSpeed: number = 10;\n  private phase: GamePhase = GamePhase.DAYTIME;\n  private phaseListeners: PhaseChangeListener[] = [];\n  private newDayListeners: NewDayListener[] = [];\n  private paused = false;\n\n  get currentDay(): number { return this.day; }\n  get currentTime(): number { return this.timeOfDay; }\n  get currentPhase(): GamePhase { return this.phase; }\n\n  onPhaseChange(listener: PhaseChangeListener): void {\n    this.phaseListeners.push(listener);\n  }\n\n  onNewDay(listener: NewDayListener): void {\n    this.newDayListeners.push(listener);\n  }\n\n  setTimeOfDay(t: number): void {\n    this.timeOfDay = t;\n    this.phase = getPhaseFromTime(this.timeOfDay);\n  }\n\n  setDay(d: number): void {\n    this.day = d;\n  }\n\n  setPaused(p: boolean): void {\n    this.paused = p;\n  }\n\n  getEffectiveTimeSpeed(): number {\n    const config = DAY_PHASES.find(p => p.phase === this.phase);\n    return config?.timeSpeed ?? this.baseTimeSpeed;\n  }\n\n  update(dtMs: number): void {\n    if (this.paused) return;\n\n    const dtSec = dtMs / 1000;\n    const speed = this.getEffectiveTimeSpeed();\n    this.timeOfDay += dtSec * speed * 0.05;\n\n    const prevPhase = this.phase;\n    this.phase = getPhaseFromTime(this.timeOfDay);\n\n    if (this.phase !== prevPhase) {\n      for (const listener of this.phaseListeners) {\n        listener(this.phase, prevPhase, this.day, this.timeOfDay);\n      }\n    }\n\n    if (this.timeOfDay >= 30) {\n      this.timeOfDay -= 24;\n      this.day++;\n      for (const listener of this.newDayListeners) {\n        listener(this.day);\n      }\n    }\n  }\n\n  getPhaseLabel(): string {\n    const config = DAY_PHASES.find(p => p.phase === this.phase);\n    return config?.label ?? this.phase;\n  }\n\n  getDayProgress(): number {\n    return (this.timeOfDay - 6) / 24;\n  }\n\n  getDaylight(): number {\n    if (this.timeOfDay >= 6 && this.timeOfDay < 18) {\n      if (this.timeOfDay < 7) return (this.timeOfDay - 6);\n      if (this.timeOfDay > 17) return (18 - this.timeOfDay);\n      return 1;\n    }\n    return 0;\n  }\n\n  getState(): { day: number; timeOfDay: number; phase: GamePhase } {\n    return { day: this.day, timeOfDay: this.timeOfDay, phase: this.phase };\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"e8f5bde0-4da8-4c4a-9322-50945e66ead7","uuid":"58f9e221-822a-4be3-b3c9-9db270b735d8"}
{"type":"assistant","message":{"id":"msg_20260523123802930b8c78619c4476","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_4150826402f849a7878e5cc8","name":"Write","input":{"file_path":"D:\\game-projects\\steam-horror-sim\\src\\game\\DaySummary.ts","content":"// DaySummary.ts — Daily settlement system with Canvas UI (M3)\n\nimport { type GameState } from './GameState';\nimport { type DayReport, type EconomySystem } from './EconomySystem';\nimport { type CustomerManager } from './CustomerManager';\n\nexport interface DaySummaryEntry {\n  day: number;\n  revenue: number;\n  expenses: number;\n  rent: number;\n  electricity: number;\n  purchaseCost: number;\n  netIncome: number;\n  debtPayment: number;\n  debtRemaining: number;\n  customersServed: number;\n  customersLost: number;\n  inventoryValue: number;\n}\n\nexport class DaySummaryManager {\n  private summaries: DaySummaryEntry[] = [];\n  private showSummary = false;\n  private currentSummary: DaySummaryEntry | null = null;\n  private summaryDisplayTimer = 0;\n  private readonly DISPLAY_DURATION = 8000;\n\n  get isVisible(): boolean { return this.showSummary; }\n  get current(): DaySummaryEntry | null { return this.currentSummary; }\n  get allSummaries(): DaySummaryEntry[] { return this.summaries; }\n\n  generateSummary(\n    report: DayReport,\n    customerManager: CustomerManager,\n  ): DaySummaryEntry {\n    const stats = customerManager.getStats();\n    const entry: DaySummaryEntry = {\n      day: report.day,\n      revenue: report.revenue,\n      expenses: report.expenses,\n      rent: report.rent,\n      electricity: report.electricity,\n      purchaseCost: report.purchaseCost,\n      netIncome: report.netIncome,\n      debtPayment: report.debtPayment,\n      debtRemaining: report.debtRemaining,\n      customersServed: stats.served,\n      customersLost: stats.lost,\n      inventoryValue: 0,\n    };\n    this.summaries.push(entry);\n    this.currentSummary = entry;\n    this.showSummary = true;\n    this.summaryDisplayTimer = 0;\n    return entry;\n  }\n\n  update(dt: number): void {\n    if (!this.showSummary) return;\n    this.summaryDisplayTimer += dt;\n    if (this.summaryDisplayTimer >= this.DISPLAY_DURATION) {\n      this.showSummary = false;\n    }\n  }\n\n  dismiss(): void {\n    this.showSummary = false;\n  }\n\n  render(c: CanvasRenderingContext2D, w: number, h: number): void {\n    if (!this.showSummary || !this.currentSummary) return;\n\n    const s = this.currentSummary;\n    const panelW = 320;\n    const panelH = 340;\n    const px = (w - panelW) / 2;\n    const py = (h - panelH) / 2;\n\n    c.fillStyle = 'rgba(0, 0, 0, 0.85)';\n    c.fillRect(px, py, panelW, panelH);\n    c.strokeStyle = '#8a7a60';\n    c.lineWidth = 2;\n    c.strokeRect(px, py, panelW, panelH);\n\n    let y = py + 12;\n\n    c.fillStyle = '#e0c890';\n    c.font = 'bold 16px monospace';\n    c.textAlign = 'center';\n    c.textBaseline = 'top';\n    c.fillText(`— Day ${s.day} 结算 —`, px + panelW / 2, y);\n    y += 30;\n\n    const leftX = px + 20;\n    const rightX = px + panelW - 20;\n\n    const drawRow = (label: string, value: string, color: string) => {\n      c.fillStyle = '#aaa';\n      c.font = '11px monospace';\n      c.textAlign = 'left';\n      c.fillText(label, leftX, y);\n      c.fillStyle = color;\n      c.textAlign = 'right';\n      c.fillText(value, rightX, y);\n      y += 18;\n    };\n\n    drawRow('今日收入', `¥${s.revenue.toFixed(0)}`, '#88cc88');\n    drawRow('采购成本', `¥${s.purchaseCost.toFixed(0)}`, '#cc8888');\n    drawRow('房租', `¥${s.rent}`, '#cc8888');\n    drawRow('电费', `¥${s.electricity}`, '#cc8888');\n    drawRow('今日支出', `¥${s.expenses.toFixed(0)}`, '#cc8888');\n    drawRow('债务还款', `¥${s.debtPayment}`, '#cc8866');\n\n    y += 6;\n    c.strokeStyle = 'rgba(255,255,255,0.2)';\n    c.lineWidth = 1;\n    c.beginPath();\n    c.moveTo(leftX, y);\n    c.lineTo(rightX, y);\n    c.stroke();\n    y += 10;\n\n    drawRow('净利润', `¥${s.netIncome.toFixed(0)}`, s.netIncome >= 0 ? '#88cc88' : '#ff6666');\n    drawRow('剩余债务', `¥${s.debtRemaining.toLocaleString()}`, '#cc6666');\n    drawRow('服务顾客', `${s.customersServed}`, '#88aacc');\n    drawRow('流失顾客', `${s.customersLost}`, '#aa8866');\n\n    y += 20;\n    c.fillStyle = 'rgba(255,255,255,0.3)';\n    c.font = '10px monospace';\n    c.textAlign = 'center';\n    c.fillText('按任意键关闭', px + panelW / 2, y);\n  }\n\n  getSaveData(): Record<string, unknown> {\n    return { summaries: this.summaries.slice(-30) };\n  }\n\n  loadSaveData(data: Record<string, unknown>): void {\n    if (data.summaries) {\n      this.summaries = data.summaries as DaySummaryEntry[];\n    }\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"e8f5bde0-4da8-4c4a-9322-50945e66ead7","uuid":"26f0d1af-8c43-4375-88ab-4dcd23ece6e2"}
{"type":"assistant","message":{"id":"msg_20260523123802930b8c78619c4476","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_bee11c6b1bba45bc9adb53b9","name":"Write","input":{"file_path":"D:\\game-projects\\steam-horror-sim\\src\\game\\SaveManager.ts","content":"// SaveManager.ts — Auto-save after day end + load restore (M3)\n\nimport { type GameState, type SaveData, CURRENT_VERSION } from './GameState';\n\nexport interface SaveableSystem {\n  getSaveData(): Record<string, unknown>;\n  loadSaveData(data: Record<string, unknown>): void;\n}\n\nconst SAVE_KEY = 'midnight_store_save_v3';\n\nexport class SaveManager {\n  private systems: Map<string, SaveableSystem> = new Map();\n  private lastSaveTime = 0;\n  private autoSaveInterval = 300000;\n\n  register(name: string, system: SaveableSystem): void {\n    this.systems.set(name, system);\n  }\n\n  save(state: GameState): boolean {\n    const data: Record<string, unknown> = {};\n    for (const [name, sys] of this.systems) {\n      data[name] = sys.getSaveData();\n    }\n\n    const saveData: SaveData = {\n      version: CURRENT_VERSION,\n      timestamp: Date.now(),\n      playtime: state.totalPlaytime,\n      gameState: state,\n      productManager: data['productManager'] ?? {},\n      economy: data['economy'] ?? {},\n      pricing: data['pricing'] ?? {},\n      customerStats: data['customerManager'] ?? {},\n      registers: data['registers'] as Record<string, unknown>[] ?? [],\n    };\n\n    try {\n      localStorage.setItem(SAVE_KEY, JSON.stringify(saveData));\n      this.lastSaveTime = Date.now();\n      return true;\n    } catch {\n      console.warn('Save failed: storage quota exceeded');\n      return false;\n    }\n  }\n\n  load(): SaveData | null {\n    try {\n      const raw = localStorage.getItem(SAVE_KEY);\n      if (!raw) return null;\n      return JSON.parse(raw) as SaveData;\n    } catch {\n      return null;\n    }\n  }\n\n  restore(save: SaveData, state: GameState): void {\n    const gs = save.gameState;\n    if (gs) {\n      Object.assign(state, gs);\n    }\n\n    const restoreSystem = (name: string, key: keyof SaveData) => {\n      const sys = this.systems.get(name);\n      const data = save[key] as Record<string, unknown> | undefined;\n      if (sys && data && Object.keys(data).length > 0) {\n        sys.loadSaveData(data);\n      }\n    };\n\n    restoreSystem('productManager', 'productManager');\n    restoreSystem('economy', 'economy');\n    restoreSystem('pricing', 'pricing');\n    restoreSystem('customerManager', 'customerStats');\n\n    const sys = this.systems.get('registers');\n    if (sys && save.registers) {\n      sys.loadSaveData({ registers: save.registers });\n    }\n  }\n\n  clearSave(): void {\n    localStorage.removeItem(SAVE_KEY);\n  }\n\n  hasSave(): boolean {\n    return localStorage.getItem(SAVE_KEY) !== null;\n  }\n\n  startAutoSave(getState: () => GameState): void {\n    window.setInterval(() => {\n      this.save(getState());\n    }, this.autoSaveInterval);\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"e8f5bde0-4da8-4c4a-9322-50945e66ead7","uuid":"723984fc-44a6-402a-994d-60489652084c"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_d03345f19393419e9738efc9","type":"tool_result","content":"File created successfully at: D:\\game-projects\\steam-horror-sim\\src\\game\\DayCycle.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"e8f5bde0-4da8-4c4a-9322-50945e66ead7","uuid":"20cdcab9-2255-4b23-818c-daa1bd1ec8e3","timestamp":"2026-05-23T04:38:49.810Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\steam-horror-sim\\src\\game\\DayCycle.ts","content":"// DayCycle.ts — Full day loop management with phase transitions (M3)\n\nimport { GamePhase, getPhaseFromTime } from './GameState';\n\nexport interface DayPhaseConfig {\n  phase: GamePhase;\n  startHour: number;\n  endHour: number;\n  label: string;\n  timeSpeed: number;\n}\n\nexport const DAY_PHASES: DayPhaseConfig[] = [\n  { phase: GamePhase.DAYTIME, startHour: 6, endHour: 22, label: '营业中', timeSpeed: 10 },\n  { phase: GamePhase.NIGHT_TRANSITION, startHour: 22, endHour: 23, label: '准备打烊', timeSpeed: 5 },\n  { phase: GamePhase.NIGHT, startHour: 23, endHour: 26, label: '深夜营业', timeSpeed: 5 },\n  { phase: GamePhase.DANGER, startHour: 26, endHour: 29, label: '危险时段', timeSpeed: 5 },\n  { phase: GamePhase.DAWN, startHour: 29, endHour: 30, label: '黎明', timeSpeed: 5 },\n];\n\nexport type PhaseChangeListener = (phase: GamePhase, prevPhase: GamePhase, day: number, timeOfDay: number) => void;\nexport type NewDayListener = (day: number) => void;\n\nexport class DayCycle {\n  private day: number = 1;\n  private timeOfDay: number = 6;\n  private baseTimeSpeed: number = 10;\n  private phase: GamePhase = GamePhase.DAYTIME;\n  private phaseListeners: PhaseChangeListener[] = [];\n  private newDayListeners: NewDayListener[] = [];\n  private paused = false;\n\n  get currentDay(): number { return this.day; }\n  get currentTime(): number { return this.timeOfDay; }\n  get currentPhase(): GamePhase { return this.phase; }\n\n  onPhaseChange(listener: PhaseChangeListener): void {\n    this.phaseListeners.push(listener);\n  }\n\n  onNewDay(listener: NewDayListener): void {\n    this.newDayListeners.push(listener);\n  }\n\n  setTimeOfDay(t: number): void {\n    this.timeOfDay = t;\n    this.phase = getPhaseFromTime(this.timeOfDay);\n  }\n\n  setDay(d: number): void {\n    this.day = d;\n  }\n\n  setPaused(p: boolean): void {\n    this.paused = p;\n  }\n\n  getEffectiveTimeSpeed(): number {\n    const config = DAY_PHASES.find(p => p.phase === this.phase);\n    return config?.timeSpeed ?? this.baseTimeSpeed;\n  }\n\n  update(dtMs: number): void {\n    if (this.paused) return;\n\n    const dtSec = dtMs / 1000;\n    const speed = this.getEffectiveTimeSpeed();\n    this.timeOfDay += dtSec * speed * 0.05;\n\n    const prevPhase = this.phase;\n    this.phase = getPhaseFromTime(this.timeOfDay);\n\n    if (this.phase !== prevPhase) {\n      for (const listener of this.phaseListeners) {\n        listener(this.phase, prevPhase, this.day, this.timeOfDay);\n      }\n    }\n\n    if (this.timeOfDay >= 30) {\n      this.timeOfDay -= 24;\n      this.day++;\n      for (const listener of this.newDayListeners) {\n        listener(this.day);\n      }\n    }\n  }\n\n  getPhaseLabel(): string {\n    const config = DAY_PHASES.find(p => p.phase === this.phase);\n    return config?.label ?? this.phase;\n  }\n\n  getDayProgress(): number {\n    return (this.timeOfDay - 6) / 24;\n  }\n\n  getDaylight(): number {\n    if (this.timeOfDay >= 6 && this.timeOfDay < 18) {\n      if (this.timeOfDay < 7) return (this.timeOfDay - 6);\n      if (this.timeOfDay > 17) return (18 - this.timeOfDay);\n      return 1;\n    }\n    return 0;\n  }\n\n  getState(): { day: number; timeOfDay: number; phase: GamePhase } {\n    return { day: this.day, timeOfDay: this.timeOfDay, phase: this.phase };\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
