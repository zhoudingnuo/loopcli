{ offsetX: number; offsetY: number; scale: number } {\n    return {\n      offsetX: this.x,\n      offsetY: this.y,\n      scale: this.zoom,\n    };\n  }\n\n  // Zoom toward a point (usually mouse position)\n  zoomAt(delta: number, screenX: number, screenY: number): void {\n    const oldZoom = this.zoom;\n    this.targetZoom = Math.max(this.minZoom, Math.min(this.maxZoom, this.targetZoom * (1 - delta * 0.001)));\n    this.zoom = this.targetZoom;\n\n    // Adjust position to zoom toward the cursor\n    const zoomRatio = this.zoom / oldZoom;\n    this.x = screenX - (screenX - this.x) * zoomRatio;\n    this.y = screenY - (screenY - this.y) * zoomRatio;\n  }\n\n  private setupInput(canvas: HTMLCanvasElement): void {\n    // Mouse drag for panning\n    canvas.addEventListener('mousedown', (e) => {\n      if (e.button === 0 || e.button === 1) { // left or middle button\n        this.isDragging = true;\n        this.dragStartX = e.clientX;\n        this.dragStartY = e.clientY;\n        this.camStartX = this.x;\n        this.camStartY = this.y;\n      }\n    });\n\n    canvas.addEventListener('mousemove', (e) => {\n      if (!this.isDragging) return;\n      this.x = this.camStartX + (e.clientX - this.dragStartX);\n      this.y = this.camStartY + (e.clientY - this.dragStartY);\n    });\n\n    canvas.addEventListener('mouseup', () => {\n      this.isDragging = false;\n    });\n\n    canvas.addEventListener('mouseleave', () => {\n      this.isDragging = false;\n    });\n\n    // Mouse wheel for zooming\n    canvas.addEventListener('wheel', (e) => {\n      e.preventDefault();\n      this.zoomAt(e.deltaY, e.offsetX, e.offsetY);\n    }, { passive: false });\n\n    // Touch support\n    let lastTouchDist = 0;\n    let lastTouchCenter = { x: 0, y: 0 };\n\n    canvas.addEventListener('touchstart', (e) => {\n      if (e.touches.length === 1) {\n        this.isDragging = true;\n        this.dragStartX = e.touches[0].clientX;\n        this.dragStartY = e.touches[0].clientY;\n        this.camStartX = this.x;\n        this.camStartY = this.y;\n      } else if (e.touches.length === 2) {\n        this.isDragging = false;\n        lastTouchDist = this.getTouchDistance(e.touches);\n        lastTouchCenter = this.getTouchCenter(e.touches);\n      }\n      e.preventDefault();\n    }, { passive: false });\n\n    canvas.addEventListener('touchmove', (e) => {\n      if (e.touches.length === 1 && this.isDragging) {\n        this.x = this.camStartX + (e.touches[0].clientX - this.dragStartX);\n        this.y = this.camStartY + (e.touches[0].clientY - this.dragStartY);\n      } else if (e.touches.length === 2) {\n        const dist = this.getTouchDistance(e.touches);\n        const center = this.getTouchCenter(e.touches);\n        const delta = lastTouchDist - dist;\n        this.zoomAt(delta * 2, center.x, center.y);\n        lastTouchDist = dist;\n      }\n      e.preventDefault();\n    }, { passive: false });\n\n    canvas.addEventListener('touchend', () => {\n      this.isDragging = false;\n    });\n  }\n\n  private getTouchDistance(touches: TouchList): number {\n    const dx = touches[0].clientX - touches[1].clientX;\n    const dy = touches[0].clientY - touches[1].clientY;\n    return Math.sqrt(dx * dx + dy * dy);\n  }\n\n  private getTouchCenter(touches: TouchList): { x: number; y: number } {\n    return {\n      x: (touches[0].clientX + touches[1].clientX) / 2,\n      y: (touches[0].clientY + touches[1].clientY) / 2,\n    };\n  }\n\n  // Check if the camera was dragged (for distinguishing click vs drag)\n  wasDragged(): boolean {\n    return this.isDragging && (\n      Math.abs(this.x - this.camStartX) > 3 ||\n      Math.abs(this.y - this.camStartY) > 3\n    );\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_259a2de64bca4592a285d0bf","type":"tool_result","content":"File created successfully at: D:\\game-projects\\steam-cultivation-factory\\src\\renderer\\Renderer.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"1027b7ea-a18e-4300-8be2-f33dc07a79d1","uuid":"d4233e0a-dd8c-44ec-9bdc-e609473655d2","timestamp":"2026-05-23T01:08:58.002Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\renderer\\Renderer.ts","content":"// Renderer.ts — Canvas 2D rendering system\n\nimport { Camera } from './Camera';\nimport { GameMap } from '../game/Map';\nimport type { BuildingInstance } from '../game/GameState';\nimport { renderBuilding } from '../game/Building';\nimport type { BuildingDef } from '../game/Building';\nimport { getResourceDisplays, formatAmount } from '../game/Resources';\nimport type { Resources, RealmProgress } from '../game/GameState';\n\nexport class Renderer {\n  canvas: HTMLCanvasElement;\n  ctx: CanvasRenderingContext2D;\n  camera: Camera;\n\n  constructor(canvas: HTMLCanvasElement) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d')!;\n    this.camera = new Camera(canvas);\n    this.resize();\n  }\n\n  resize(): void {\n    const dpr = window.devicePixelRatio || 1;\n    const rect = this.canvas.getBoundingClientRect();\n    this.canvas.width = rect.width * dpr;\n    this.canvas.height = rect.height * dpr;\n    this.ctx.scale(dpr, dpr);\n  }\n\n  // Main render call\n  render(\n    map: GameMap,\n    buildings: BuildingInstance[],\n    buildingDefs: Map<string, BuildingDef>,\n    resources: Resources,\n    realm: RealmProgress,\n    hoveredCell: { gx: number; gy: number } | null,\n    placementPreview: { def: BuildingDef; gx: number; gy: number; valid: boolean } | null,\n    now: number,\n  ): void {\n    const ctx = this.ctx;\n    const w = this.canvas.getBoundingClientRect().width;\n    const h = this.canvas.getBoundingClientRect().height;\n\n    // Clear\n    ctx.fillStyle = '#1a1a2e';\n    ctx.fillRect(0, 0, w, h);\n\n    const { offsetX, offsetY, scale } = this.camera.getTransform();\n\n    // Render map terrain\n    map.render(ctx, offsetX, offsetY, w, h, scale);\n\n    // Render buildings\n    for (const building of buildings) {\n      const def = buildingDefs.get(building.buildingId);\n      if (def) {\n        renderBuilding(ctx, building, def, offsetX, offsetY, scale, map.cellSize, now);\n      }\n    }\n\n    // Render placement preview\n    if (placementPreview) {\n      this.renderPlacementPreview(ctx, placementPreview, offsetX, offsetY, scale, map.cellSize);\n    }\n\n    // Render hovered cell highlight\n    if (hoveredCell && map.inBounds(hoveredCell.gx, hoveredCell.gy)) {\n      const hx = offsetX + hoveredCell.gx * map.cellSize * scale;\n      const hy = offsetY + hoveredCell.gy * map.cellSize * scale;\n      const hs = map.cellSize * scale;\n      ctx.strokeStyle = 'rgba(255,255,255,0.4)';\n      ctx.lineWidth = 1;\n      ctx.strokeRect(hx, hy, hs, hs);\n    }\n\n    // Render UI overlay\n    this.renderUI(ctx, w, h, resources, realm);\n  }\n\n  private renderPlacementPreview(\n    ctx: CanvasRenderingContext2D,\n    preview: { def: BuildingDef; gx: number; gy: number; valid: boolean },\n    offsetX: number,\n    offsetY: number,\n    scale: number,\n    cellSize: number,\n  ): void {\n    const x = offsetX + preview.gx * cellSize * scale;\n    const y = offsetY + preview.gy * cellSize * scale;\n    const w = preview.def.size.w * cellSize * scale;\n    const h = preview.def.size.h * cellSize * scale;\n\n    const { r, g, b } = preview.def.color;\n    const alpha = preview.valid ? 0.4 : 0.2;\n\n    ctx.fillStyle = preview.valid\n      ? `rgba(${r},${g},${b},${alpha})`\n      : `rgba(255,50,50,${alpha})`;\n    ctx.fillRect(x + 2, y + 2, w - 4, h - 4);\n\n    ctx.strokeStyle = preview.valid ? 'rgba(100,255,100,0.8)' : 'rgba(255,100,100,0.8)';\n    ctx.lineWidth = 2;\n    ctx.setLineDash([4, 4]);\n    ctx.strokeRect(x + 2, y + 2, w - 4, h - 4);\n    ctx.setLineDash([]);\n  }\n\n  private renderUI(\n    ctx: CanvasRenderingContext2D,\n    canvasW: number,\n    canvasH: number,\n    resources: Resources,\n    realm: RealmProgress,\n  ): void {\n    // Top bar background\n    ctx.fillStyle = 'rgba(0,0,0,0.75)';\n    ctx.fillRect(0, 0, canvasW, 48);\n\n    // Realm display\n    ctx.fillStyle = '#ffd700';\n    ctx.font = 'bold 14px monospace';\n    ctx.textAlign = 'left';\n    ctx.textBaseline = 'middle';\n    const realmNames: Record<string, string> = {\n      liqi: '炼气', zhuji: '筑基', jindan: '金丹', yuanying: '元婴', huashen: '化神',\n    };\n    ctx.fillText(`${realmNames[realm.realmId] || realm.realmId} Lv${realm.level}`, 12, 24);\n\n    // Exp bar\n    const expBarX = 110;\n    const expBarW = 100;\n    const expRatio = realm.exp / realm.expToNext;\n    ctx.fillStyle = 'rgba(255,255,255,0.1)';\n    ctx.fillRect(expBarX, 16, expBarW, 16);\n    ctx.fillStyle = '#ffd700';\n    ctx.fillRect(expBarX, 16, expBarW * expRatio, 16);\n    ctx.strokeStyle = 'rgba(255,255,255,0.3)';\n    ctx.lineWidth = 1;\n    ctx.strokeRect(expBarX, 16, expBarW, 16);\n    ctx.fillStyle = '#fff';\n    ctx.font = '10px monospace';\n    ctx.textAlign = 'center';\n    ctx.fillText(`${Math.floor(expRatio * 100)}%`, expBarX + expBarW / 2, 25);\n\n    // Resource display\n    const displays = getResourceDisplays(resources);\n    let rx = canvasW - 12;\n    ctx.textAlign = 'right';\n    for (let i = displays.length - 1; i >= 0; i--) {\n      const d = displays[i];\n      const text = `${d.icon} ${d.name}: ${formatAmount(d.amount)}`;\n      ctx.font = '12px monospace';\n      const metrics = ctx.measureText(text);\n      rx -= metrics.width + 4;\n      ctx.fillStyle = d.color;\n      ctx.fillText(text, rx + metrics.width, 24);\n      rx -= 16;\n    }\n  }\n\n  destroy(): void {\n    // Clean up event listeners are handled by Camera\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
