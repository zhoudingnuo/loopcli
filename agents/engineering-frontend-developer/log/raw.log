{"type":"assistant","message":{"id":"msg_202605230508394e26b306c0174ba4","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_40662c6cd2f54435b5ce1027","name":"Write","input":{"file_path":"D:/game-projects/douyin-match3/src/js/InputHandler.js","content":"// InputHandler.js — Touch and mouse input handling for swipe detection\n\nclass InputHandler {\n  constructor(canvas, board) {\n    this.canvas = canvas;\n    this.board = board;\n    this.tileSize = 0;\n    this.boardX = 0;\n    this.boardY = 0;\n\n    this.swipeStart = null;\n    this.selectedTile = null;\n    this.onSwap = null;         // (r1, c1, r2, c2) => void\n    this.onTap = null;          // (row, col) => void\n    this.enabled = true;\n\n    this._bindEvents();\n  }\n\n  updateLayout(tileSize, boardX, boardY) {\n    this.tileSize = tileSize;\n    this.boardX = boardX;\n    this.boardY = boardY;\n  }\n\n  _bindEvents() {\n    // Mouse events\n    this.canvas.addEventListener('mousedown', e => this._onPointerDown(e.clientX, e.clientY));\n    this.canvas.addEventListener('mousemove', e => this._onPointerMove(e.clientX, e.clientY));\n    this.canvas.addEventListener('mouseup', e => this._onPointerUp(e.clientX, e.clientY));\n\n    // Touch events\n    this.canvas.addEventListener('touchstart', e => {\n      e.preventDefault();\n      const t = e.touches[0];\n      this._onPointerDown(t.clientX, t.clientY);\n    }, { passive: false });\n\n    this.canvas.addEventListener('touchmove', e => {\n      e.preventDefault();\n      const t = e.touches[0];\n      this._onPointerMove(t.clientX, t.clientY);\n    }, { passive: false });\n\n    this.canvas.addEventListener('touchend', e => {\n      e.preventDefault();\n      const t = e.changedTouches[0];\n      this._onPointerUp(t.clientX, t.clientY);\n    }, { passive: false });\n  }\n\n  _screenToGrid(x, y) {\n    const col = Math.floor((x - this.boardX) / this.tileSize);\n    const row = Math.floor((y - this.boardY) / this.tileSize);\n    if (row >= 0 && row < this.board.size && col >= 0 && col < this.board.size) {\n      return { row, col };\n    }\n    return null;\n  }\n\n  _onPointerDown(x, y) {\n    if (!this.enabled) return;\n    const cell = this._screenToGrid(x, y);\n    if (!cell) return;\n    this.swipeStart = { x, y, row: cell.row, col: cell.col };\n  }\n\n  _onPointerMove(x, y) {\n    // Could use for drag visualization\n  }\n\n  _onPointerUp(x, y) {\n    if (!this.enabled || !this.swipeStart) return;\n    const start = this.swipeStart;\n    this.swipeStart = null;\n\n    const dx = x - start.x;\n    const dy = y - start.y;\n    const dist = Math.sqrt(dx * dx + dy * dy);\n\n    // Minimum swipe distance threshold\n    if (dist < this.tileSize * 0.2) {\n      // Tap — treat as selection or swap trigger\n      if (this.onTap) this.onTap(start.row, start.col);\n      return;\n    }\n\n    // Determine swipe direction\n    let targetRow = start.row;\n    let targetCol = start.col;\n    if (Math.abs(dx) > Math.abs(dy)) {\n      targetCol += dx > 0 ? 1 : -1;\n    } else {\n      targetRow += dy > 0 ? 1 : -1;\n    }\n\n    // Validate\n    if (this.board.isValid(targetRow, targetCol)) {\n      if (this.onSwap) {\n        this.onSwap(start.row, start.col, targetRow, targetCol);\n      }\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { InputHandler };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"ef939699-9dac-4e19-a950-f991f68c1f56","uuid":"f868d857-6f87-4101-923e-1568916787cb"}
