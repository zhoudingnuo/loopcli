egory:[\"动物\"],frequency:95},\n{id:\"e008\",idiom:\"亡羊补牢\",chars:[\"亡\",\"羊\",\"补\",\"牢\"],pinyin:\"wáng yáng bǔ láo\",meaning:\"出了问题以后想办法补救\",difficulty:1,category:[\"动物\"],frequency:94},\n{id:\"e009\",idiom:\"自相矛盾\",chars:[\"自\",\"相\",\"矛\",\"盾\"],pinyin:\"zì xiāng máo dùn\",meaning:\"比喻自己的言行前后不一致\",difficulty:1,category:[\"常用\"],frequency:94},\n{id:\"e010\",idiom:\"掩耳盗铃\",chars:[\"掩\",\"耳\",\"盗\",\"铃\"],pinyin:\"yǎn ěr dào líng\",meaning:\"比喻自己欺骗自己\",difficulty:1,category:[\"寓言\"],frequency:93},\n{id:\"e011\",idiom:\"叶公好龙\",chars:[\"叶\",\"公\",\"好\",\"龙\"],pinyin:\"yè gōng hào lóng\",meaning:\"比喻表面喜欢实际害怕\",difficulty:1,category:[\"动物\",\"寓言\"],frequency:93},\n{id:\"e012\",idiom:\"狐假虎威\",chars:[\"狐\",\"假\",\"虎\",\"威\"],pinyin:\"hú jiǎ hǔ wēi\",meaning:\"比喻仗着别人的势力欺压人\",difficulty:1,category:[\"动物\"],frequency:92},\n{id:\"e013\",idiom:\"刻舟求剑\",chars:[\"刻\",\"舟\",\"求\",\"剑\"],pinyin:\"kè zhōu qiú jiàn\",meaning:\"比喻拘泥不知变通\",difficulty:1,category:[\"寓言\"],frequency:92},\n{id:\"e014\",idiom:\"杯弓蛇影\",chars:[\"杯\",\"弓\",\"蛇\",\"影\"],pinyin:\"bēi gōng shé yǐng\",meaning:\"比喻因疑神疑鬼而自相惊扰\",difficulty:1,category:[\"动物\"],frequency:91},\n{id:\"e015\",idiom:\"望梅止渴\",chars:[\"望\",\"梅\",\"止\",\"渴\"],pinyin:\"wàng méi zhǐ kě\",meaning:\"比喻用空想安慰自己\",difficulty:1,category:[\"食物\"],frequency:91},\n{id:\"e016\",idiom:\"胸有成竹\",chars:[\"胸\",\"有\",\"成\",\"竹\"],pinyin:\"xiōng yǒu chéng zhú\",meaning:\"比喻做事之前已有充分把握\",difficulty:1,category:[\"自然\"],frequency:90},\n{id:\"e017\",idiom:\"三心二意\",chars:[\"三\",\"心\",\"二\",\"意\"],pinyin:\"sān xīn èr yì\",meaning:\"形容犹豫不决，意志不坚定\",difficulty:1,category:[\"数字\",\"常用\"],frequency:90},\n{id:\"e018\",idiom:\"四面楚歌\",chars:[\"四\",\"面\",\"楚\",\"歌\"],pinyin:\"sì miàn chǔ gē\",meaning:\"比喻四面受敌，孤立无援\",difficulty:1,category:[\"数字\",\"军事\"],frequency:89},\n{id:\"e019\",idiom:\"五颜六色\",chars:[\"五\",\"颜\",\"六\",\"色\"],pinyin:\"wǔ yán liù sè\",meaning:\"形容色彩繁多\",difficulty:1,category:[\"数字\"],frequency:89},\n{id:\"e020\",idiom:\"七上八下\",chars:[\"七\",\"上\",\"八\",\"下\"