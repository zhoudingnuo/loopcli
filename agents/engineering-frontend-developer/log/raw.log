{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_3ba40075e30c4c98a15fd36a","type":"tool_result","content":"1\t// AdManager.js — 穿山甲SDK广告管理（存根模式），6个广告位，频率控制\n2\t\n3\tconst AD_PLACEMENTS = {\n4\t  CONTINUE: 'continue',       // 续步激励视频（关卡失败）\n5\t  BOOST: 'boost',             // 开局增益激励视频\n6\t  DOUBLE: 'double',           // 双倍结算激励视频\n7\t  INTERSTITIAL: 'interstitial', // 插屏广告\n8\t  TREASURE: 'treasure',       // 宝箱加速激励视频\n9\t  DAILY_DOUBLE: 'daily_double', // 每日签到翻倍\n10\t};\n11\t\n12\tconst AD_LIMITS = {\n13\t  REWARDED_DAILY: 12,\n14\t  INTERSTITIAL_DAILY: 6,\n15\t  COOLDOWN_MS: 60000,\n16\t  NEW_USER_FREE_LEVELS: 3,\n17\t  INTERSTITIAL_LEVEL_INTERVAL: 3,\n18\t};\n19\t\n20\tclass AdManager {\n21\t  constructor(dataManager) {\n22\t    this.dm = dataManager;\n23\t    this._initStorage();\n24\t\n25\t    // SDK stubs — real SDK loads only in 抖音 environment\n26\t    this.isDouyin = typeof tt !== 'undefined' && typeof tt.createRewardedVideoAd === 'function';\n27\t    this.rewardedAd = null;\n28\t    this.interstitialAd = null;\n29\t\n30\t    if (this.isDouyin) this._initSDK();\n31\t\n32\t    // State\n33\t    this._pendingResolve = null;\n34\t    this._currentPlacement = null;\n35\t    this._showingUI = false;\n36\t  }\n37\t\n38\t  _initStorage() {\n39\t    if (!this.dm.data.adState) {\n40\t      this.dm.data.adState = {\n41\t        dailyRewarded: 0,\n42\t        dailyInterstitial: 0,\n43\t        lastShowTime: {},\n44\t        lastInterstitialLevel: 0,\n45\t        date: this._todayStr(),\n46\t        consecutiveFails: 0,\n47\t      };\n48\t      this.dm.save();\n49\t    }\n50\t    this.adState = this.dm.data.adState;\n51\t    this._resetDaily();\n52\t  }\n53\t\n54\t  _todayStr() { return new Date().toISOString().slice(0, 10); }\n55\t\n56\t  _resetDaily() {\n57\t    if (this.adState.date !== this._todayStr()) {\n58\t      this.adState.dailyRewarded = 0;\n59\t      this.adState.dailyInterstitial = 0;\n60\t      this.adState.date = this._todayStr();\n61\t      this.dm.save();\n62\t    }\n63\t  }\n64\t\n65\t  _initSDK() {\n66\t    try {\n67\t      this.rewardedAd = tt.createRewardedVideoAd({\n68\t        adUnitId: 'adunit-placeholder-rewarded',\n69\t      });\n70\t      this.rewardedAd.onError(() => {});\n71\t      this.rewardedAd.onClose((res) => {\n72\t        if (this._pendingResolve) {\n73\t          this._pendingResolve(res && res.isEnded);\n74\t          this._pendingResolve = null;\n75\t        }\n76\t      });\n77\t\n78\t      this.interstitialAd = tt.createInterstitialAd({\n79\t        adUnitId: 'adunit-placeholder-interstitial',\n80\t      });\n81\t      this.interstitialAd.onError(() => {});\n82\t    } catch (e) {\n83\t      this.isDouyin = false;\n84\t    }\n85\t  }\n86\t\n87\t  // --- Frequency checks ---\n88\t  isNewUser() {\n89\t    return this.dm.unlockedLevel <= AD_LIMITS.NEW_USER_FREE_LEVELS;\n90\t  }\n91\t\n92\t  canShowRewarded(placement) {\n93\t    this._resetDaily();\n94\t    if (this.isNewUser()) return false;\n95\t    if (this.adState.dailyRewarded >= AD_LIMITS.REWARDED_DAILY) return false;\n96\t    if (this._inCooldown(placement)) return false;\n97\t    return true;\n98\t  }\n99\t\n100\t  canShowInterstitial(currentLevel) {\n101\t    this._resetDaily();\n102\t    if (this.isNewUser()) return false;\n103\t    if (this.adState.dailyInterstitial >= AD_LIMITS.INTERSTITIAL_DAILY) return false;\n104\t    if (this.adState.consecutiveFails >= 2) return false;\n105\t    const lastLevel = this.adState.lastInterstitialLevel || 0;\n106\t    if (currentLevel - lastLevel < AD_LIMITS.INTERSTITIAL_LEVEL_INTERVAL) return false;\n107\t    if (this._inCooldown(AD_PLACEMENTS.INTERSTITIAL)) return false;\n108\t    return true;\n109\t  }\n110\t\n111\t  _inCooldown(placement) {\n112\t    const last = this.adState.lastShowTime[placement] || 0;\n113\t    return Date.now() - last < AD_LIMITS.COOLDOWN_MS;\n114\t  }\n115\t\n116\t  // --- Show rewarded video ---\n117\t  showRewarded(placement) {\n118\t    if (!this.canShowRewarded(placement)) return Promise.resolve(false);\n119\t\n120\t    this._currentPlacement = placement;\n121\t\n122\t    if (this.isDouyin && this.rewardedAd) {\n123\t      return new Promise((resolve) => {\n124\t        this._pendingResolve = resolve;\n125\t        this.rewardedAd.show().catch(() => {\n126\t          this.rewardedAd.load().then(() => {\n127\t            this.rewardedAd.show().catch(() => resolve(false));\n128\t          }).catch(() => resolve(false));\n129\t        });\n130\t      }).then((success) => {\n131\t        if (success) this._onAdComplete(placement);\n132\t        return success;\n133\t      });\n134\t    }\n135\t\n136\t    // Stub mode: simulate ad with a UI overlay\n137\t    return this._showStubAd(placement);\n138\t  }\n139\t\n140\t  // --- Show interstitial ---\n141\t  showInterstitial(currentLevel) {\n142\t    if (!this.canShowInterstitial(currentLevel)) return Promise.resolve(false);\n143\t\n144\t    if (this.isDouyin && this.interstitialAd) {\n145\t      return new Promise((resolve) => {\n146\t        this.interstitialAd.show().then(() => {\n147\t          this.adState.dailyInterstitial++;\n148\t          this.adState.lastInterstitialLevel = currentLevel;\n149\t          this.adState.lastShowTime[AD_PLACEMENTS.INTERSTITIAL] = Date.now();\n150\t          this.dm.save();\n151\t          setTimeout(() => resolve(true), 5000);\n152\t        }).catch(() => resolve(false));\n153\t      });\n154\t    }\n155\t\n156\t    // Stub: simulate 2s interstitial\n157\t    return new Promise((resolve) => {\n158\t      this._showingUI = true;\n159\t      this._stubInterstitial = true;\n160\t      this._stubTimer = 2;\n161\t      this.adState.dailyInterstitial++;\n162\t      this.adState.lastInterstitialLevel = currentLevel;\n163\t      this.adState.lastShowTime[AD_PLACEMENTS.INTERSTITIAL] = Date.now();\n164\t      this.dm.save();\n165\t      setTimeout(() => {\n166\t        this._showingUI = false;\n167\t        this._stubInterstitial = false;\