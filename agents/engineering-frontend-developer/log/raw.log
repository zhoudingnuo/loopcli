{"type":"assistant","message":{"id":"msg_202605231340132be598fa899d4d7f","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_313069b83e144d72b3686c49","name":"Edit","input":{"replace_all":false,"file_path":"D:/game-projects/steam-horror-sim/src/game/AudioManager.ts","old_string":"// AudioManager.ts — Web Audio API sound system with horror effects (M4)\n\nexport class AudioManager {\n  private ctx: AudioContext | null = null;\n  private masterGain: GainNode | null = null;\n  private bgmGain: GainNode | null = null;\n  private sfxGain: GainNode | null = null;\n  private volume = 0.7;\n  private bgmVolume = 0.3;\n  private sfxVolume = 0.5;\n  private initialized = false;\n  private currentBgm: 'daytime' | 'night' | 'danger' | 'silence' = 'silence';\n  private bgmOscillators: OscillatorNode[] = [];\n  private bgmNodes: AudioNode[] = [];\n\n  init(): void {\n    if (this.initialized) return;\n    try {\n      this.ctx = new AudioContext();\n      this.masterGain = this.ctx.createGain();\n      this.masterGain.gain.value = this.volume;\n      this.masterGain.connect(this.ctx.destination);\n\n      this.bgmGain = this.ctx.createGain();\n      this.bgmGain.gain.value = this.bgmVolume;\n      this.bgmGain.connect(this.masterGain);\n\n      this.sfxGain = this.ctx.createGain();\n      this.sfxGain.gain.value = this.sfxVolume;\n      this.sfxGain.connect(this.masterGain);\n\n      this.initialized = true;\n    } catch {\n      console.warn('AudioManager: Web Audio API not available');\n    }\n  }\n\n  private ensureCtx(): AudioContext | null {\n    if (!this.initialized) this.init();\n    if (this.ctx?.state === 'suspended') this.ctx.resume();\n    return this.ctx;\n  }\n\n  // --- SFX ---\n\n  playCollect(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(880, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(1760, ctx.currentTime + 0.1);\n    gain.gain.setValueAtTime(0.2, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.15);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.15);\n  }\n\n  playBuild(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'square';\n    osc.frequency.setValueAtTime(220, ctx.currentTime);\n    osc.frequency.setValueAtTime(330, ctx.currentTime + 0.08);\n    osc.frequency.setValueAtTime(440, ctx.currentTime + 0.16);\n    gain.gain.setValueAtTime(0.15, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.25);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.25);\n  }\n\n  playTransaction(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(660, ctx.currentTime);\n    osc.frequency.setValueAtTime(880, ctx.currentTime + 0.06);\n    gain.gain.setValueAtTime(0.15, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.12);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.12);\n  }\n\n  playBreakthrough(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Rising tone\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(200, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(1200, ctx.currentTime + 0.8);\n    gain.gain.setValueAtTime(0.3, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.0);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 1.0);\n\n    // Shimmer\n    for (let i = 0; i < 5; i++) {\n      const s = ctx.createOscillator();\n      const sg = ctx.createGain();\n      s.type = 'sine';\n      s.frequency.value = 800 + i * 200;\n      sg.gain.setValueAtTime(0, ctx.currentTime + 0.4 + i * 0.1);\n      sg.gain.linearRampToValueAtTime(0.1, ctx.currentTime + 0.5 + i * 0.1);\n      sg.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.2 + i * 0.1);\n      s.connect(sg).connect(this.sfxGain);\n      s.start(ctx.currentTime + 0.4 + i * 0.1);\n      s.stop(ctx.currentTime + 1.3 + i * 0.1);\n    }\n  }\n\n  // --- Horror SFX ---\n\n  playHorrorFlicker(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Buzzing electrical sound\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(60, ctx.currentTime);\n    osc.frequency.linearRampToValueAtTime(120, ctx.currentTime + 0.1);\n    osc.frequency.linearRampToValueAtTime(60, ctx.currentTime + 0.2);\n    gain.gain.setValueAtTime(0.08, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 0.3);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.3);\n  }\n\n  playHorrorWhisper(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Filtered noise for whisper effect\n    const bufferSize = ctx.sampleRate * 1.5;\n    const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);\n    const data = buffer.getChannelData(0);\n    for (let i = 0; i < bufferSize; i++) {\n      data[i] = (Math.random() * 2 - 1) * 0.3;\n    }\n    const source = ctx.createBufferSource();\n    source.buffer = buffer;\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'bandpass';\n    filter.frequency.value = 800;\n    filter.Q.value = 2;\n    const gain = ctx.createGain();\n    gain.gain.setValueAtTime(0, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0.15, ctx.currentTime + 0.5);\n    gain.gain.linearRampToValueAtTime(0.1, ctx.currentTime + 1.0);\n    gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 1.5);\n    source.connect(filter).connect(gain).connect(this.sfxGain);\n    source.start();\n    source.stop(ctx.currentTime + 1.5);\n  }\n\n  playHorrorDoorCreak(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Low creaking sound\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(40, ctx.currentTime);\n    osc.frequency.linearRampToValueAtTime(80, ctx.currentTime + 0.5);\n    osc.frequency.linearRampToValueAtTime(50, ctx.currentTime + 1.0);\n    gain.gain.setValueAtTime(0.1, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0.15, ctx.currentTime + 0.3);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.2);\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'lowpass';\n    filter.frequency.value = 300;\n    osc.connect(filter).connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 1.2);\n  }\n\n  playHorrorSuddenSilence(): void {\n    // The absence of sound is scarier — handled by BGM crossfade\n    this.stopBgm();\n  }\n\n  playHorrorJumpScare(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Sharp stinger\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(200, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(2000, ctx.currentTime + 0.05);\n    gain.gain.setValueAtTime(0.4, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.5);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.5);\n\n    // Sub-bass hit\n    const sub = ctx.createOscillator();\n    const subGain = ctx.createGain();\n    sub.type = 'sine';\n    sub.frequency.value = 30;\n    subGain.gain.setValueAtTime(0.5, ctx.currentTime);\n    subGain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.8);\n    sub.connect(subGain).connect(this.sfxGain);\n    sub.start();\n    sub.stop(ctx.currentTime + 0.8);\n  }\n\n  playHorrorAmbientDrone(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.value = 55;\n    gain.gain.setValueAtTime(0, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0.08, ctx.currentTime + 2);\n    gain.gain.linearRampToValueAtTime(0.05, ctx.currentTime + 4);\n    gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 6);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 6);\n  }\n\n  // --- BGM ---\n\n  playBgm(type: 'daytime' | 'night' | 'danger'): void {\n    if (type === this.currentBgm) return;\n    this.stopBgm();\n    this.currentBgm = type;\n\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.bgmGain) return;\n\n    switch (type) {\n      case 'daytime':\n        this.createDaytimeBgm(ctx);\n        break;\n      case 'night':\n        this.createNightBgm(ctx);\n        break;\n      case 'danger':\n        this.createDangerBgm(ctx);\n        break;\n    }\n  }\n\n  private createDaytimeBgm(ctx: AudioContext): void {\n    // Gentle ambient pad\n    const freqs = [220, 277, 330];\n    for (const f of freqs) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = f;\n      gain.gain.value = 0.02;\n      osc.connect(gain).connect(this.bgmGain!);\n      osc.start();\n      this.bgmOscillators.push(osc);\n      this.bgmNodes.push(gain);\n    }\n  }\n\n  private createNightBgm(ctx: AudioContext): void {\n    // Eerie drone\n    const freqs = [55, 82.5, 110];\n    for (const f of freqs) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = f;\n      // Slow LFO\n      const lfo = ctx.createOscillator();\n      const lfoGain = ctx.createGain();\n      lfo.frequency.value = 0.1 + Math.random() * 0.2;\n      lfoGain.gain.value = f * 0.02;\n      lfo.connect(lfoGain).connect(osc.frequency);\n      lfo.start();\n\n      gain.gain.value = 0.025;\n      osc.connect(gain).connect(this.bgmGain!);\n      osc.start();\n      this.bgmOscillators.push(osc, lfo);\n      this.bgmNodes.push(gain, lfoGain);\n    }\n  }\n\n  private createDangerBgm(ctx: AudioContext): void {\n    // Disturbing drone + heartbeat\n    const bass = ctx.createOscillator();\n    const bassGain = ctx.createGain();\n    bass.type = 'sawtooth';\n    bass.frequency.value = 40;\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'lowpass';\n    filter.frequency.value = 120;\n    bassGain.gain.value = 0.03;\n    bass.connect(filter).connect(bassGain).connect(this.bgmGain!);\n    bass.start();\n    this.bgmOscillators.push(bass);\n    this.bgmNodes.push(bassGain, filter);\n\n    // Heartbeat-like pulse\n    const pulse = ctx.createOscillator();\n    const pulseGain = ctx.createGain();\n    pulse.type = 'sine';\n    pulse.frequency.value = 50;\n    // Rhythmic gain modulation via LFO\n    const pulseLfo = ctx.createOscillator();\n    const pulseLfoGain = ctx.createGain();\n    pulseLfo.frequency.value = 1.2; // ~72 bpm heartbeat\n    pulseLfoGain.gain.value = 0.04;\n    pulseLfo.connect(pulseLfoGain).connect(pulseGain.gain);\n    pulseLfo.start();\n    pulseGain.gain.value = 0.03;\n    pulse.connect(pulseGain).connect(this.bgmGain!);\n    pulse.start();\n    this.bgmOscillators.push(pulse, pulseLfo);\n    this.bgmNodes.push(pulseGain, pulseLfoGain);\n  }\n\n  stopBgm(): void {\n    for (const osc of this.bgmOscillators) {\n      try { osc.stop(); } catch { /* already stopped */ }\n    }\n    this.bgmOscillators = [];\n    this.bgmNodes = [];\n    this.currentBgm = 'silence';\n  }\n\n  // --- Volume ---\n\n  setMasterVolume(v: number): void {\n    this.volume = Math.max(0, Math.min(1, v));\n    if (this.masterGain) this.masterGain.gain.value = this.volume;\n  }\n\n  setBgmVolume(v: number): void {\n    this.bgmVolume = Math.max(0, Math.min(1, v));\n    if (this.bgmGain) this.bgmGain.gain.value = this.bgmVolume;\n  }\n\n  setSfxVolume(v: number): void {\n    this.sfxVolume = Math.max(0, Math.min(1, v));\n    if (this.sfxGain) this.sfxGain.gain.value = this.sfxVolume;\n  }\n\n  get masterVolume(): number { return this.volume; }\n  get currentBgmType(): string { return this.currentBgm; }\n\n  destroy(): void {\n    this.stopBgm();\n    if (this.ctx) {\n      this.ctx.close();\n      this.ctx = null;\n    }\n    this.initialized = false;\n  }\n}","new_string":"// AudioManager.ts — Web Audio API sound system (v1.0.0 — M7: Full audio polish)\n\nexport class AudioManager {\n  private ctx: AudioContext | null = null;\n  private masterGain: GainNode | null = null;\n  private bgmGain: GainNode | null = null;\n  private sfxGain: GainNode | null = null;\n  private volume = 0.7;\n  private bgmVolume = 0.3;\n  private sfxVolume = 0.5;\n  private initialized = false;\n  private currentBgm: 'daytime' | 'night' | 'danger' | 'silence' = 'silence';\n  private bgmOscillators: OscillatorNode[] = [];\n  private bgmNodes: AudioNode[] = [];\n\n  // Ambient loop state\n  private ambientNodes: AudioNode[] = [];\n  private ambientOscillators: OscillatorNode[] = [];\n  private ambientType: string = '';\n  private lastFootstepTime = 0;\n  private footstepCooldown = 250; // ms between footsteps\n\n  init(): void {\n    if (this.initialized) return;\n    try {\n      this.ctx = new AudioContext();\n      this.masterGain = this.ctx.createGain();\n      this.masterGain.gain.value = this.volume;\n      this.masterGain.connect(this.ctx.destination);\n\n      this.bgmGain = this.ctx.createGain();\n      this.bgmGain.gain.value = this.bgmVolume;\n      this.bgmGain.connect(this.masterGain);\n\n      this.sfxGain = this.ctx.createGain();\n      this.sfxGain.gain.value = this.sfxVolume;\n      this.sfxGain.connect(this.masterGain);\n\n      this.initialized = true;\n    } catch {\n      console.warn('AudioManager: Web Audio API not available');\n    }\n  }\n\n  private ensureCtx(): AudioContext | null {\n    if (!this.initialized) this.init();\n    if (this.ctx?.state === 'suspended') this.ctx.resume();\n    return this.ctx;\n  }\n\n  // ============ ENVIRONMENT / INTERACTION SFX ============\n\n  playFootstep(): void {\n    const now = performance.now();\n    if (now - this.lastFootstepTime < this.footstepCooldown) return;\n    this.lastFootstepTime = now;\n\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Soft thud with slight randomization\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    const filter = ctx.createBiquadFilter();\n    osc.type = 'sine';\n    const baseFreq = 80 + Math.random() * 30;\n    osc.frequency.setValueAtTime(baseFreq, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(40, ctx.currentTime + 0.08);\n    filter.type = 'lowpass';\n    filter.frequency.value = 200;\n    gain.gain.setValueAtTime(0.06, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.1);\n    osc.connect(filter).connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.1);\n\n    // Noise burst for texture\n    const bufSize = Math.floor(ctx.sampleRate * 0.04);\n    const buf = ctx.createBuffer(1, bufSize, ctx.sampleRate);\n    const d = buf.getChannelData(0);\n    for (let i = 0; i < bufSize; i++) d[i] = (Math.random() * 2 - 1) * 0.15;\n    const src = ctx.createBufferSource();\n    src.buffer = buf;\n    const ng = ctx.createGain();\n    ng.gain.setValueAtTime(0.03, ctx.currentTime);\n    ng.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.05);\n    const nf = ctx.createBiquadFilter();\n    nf.type = 'lowpass';\n    nf.frequency.value = 400;\n    src.connect(nf).connect(ng).connect(this.sfxGain);\n    src.start();\n    src.stop(ctx.currentTime + 0.05);\n  }\n\n  playDoorOpen(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(150, ctx.currentTime);\n    osc.frequency.linearRampToValueAtTime(300, ctx.currentTime + 0.15);\n    osc.frequency.linearRampToValueAtTime(200, ctx.currentTime + 0.3);\n    gain.gain.setValueAtTime(0.06, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'lowpass';\n    filter.frequency.value = 600;\n    osc.connect(filter).connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.35);\n  }\n\n  playDoorClose(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Thud\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(120, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(30, ctx.currentTime + 0.15);\n    gain.gain.setValueAtTime(0.12, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.2);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.2);\n    // Click\n    const click = ctx.createOscillator();\n    const cg = ctx.createGain();\n    click.type = 'square';\n    click.frequency.value = 800;\n    cg.gain.setValueAtTime(0.04, ctx.currentTime + 0.05);\n    cg.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.08);\n    click.connect(cg).connect(this.sfxGain);\n    click.start(ctx.currentTime + 0.05);\n    click.stop(ctx.currentTime + 0.08);\n  }\n\n  playRegisterDing(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(1200, ctx.currentTime);\n    osc.frequency.setValueAtTime(1600, ctx.currentTime + 0.05);\n    gain.gain.setValueAtTime(0.12, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.4);\n  }\n\n  playShelfPlace(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Soft clunk\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'triangle';\n    osc.frequency.setValueAtTime(200, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(80, ctx.currentTime + 0.1);\n    gain.gain.setValueAtTime(0.08, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.12);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.12);\n  }\n\n  playCustomerEnter(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Chime bell (ding-dong)\n    for (let i = 0; i < 2; i++) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = i === 0 ? 880 : 1100;\n      const t = ctx.currentTime + i * 0.25;\n      gain.gain.setValueAtTime(0.1, t);\n      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.5);\n      osc.connect(gain).connect(this.sfxGain);\n      osc.start(t);\n      osc.stop(t + 0.5);\n    }\n  }\n\n  playCustomerLeave(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(660, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(440, ctx.currentTime + 0.3);\n    gain.gain.setValueAtTime(0.05, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.35);\n  }\n\n  playCoinDrop(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Metallic clink\n    for (let i = 0; i < 3; i++) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = 2500 + i * 400 + Math.random() * 200;\n      const t = ctx.currentTime + i * 0.07;\n      gain.gain.setValueAtTime(0.08, t);\n      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.15);\n      osc.connect(gain).connect(this.sfxGain);\n      osc.start(t);\n      osc.stop(t + 0.15);\n    }\n  }\n\n  playUIClick(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.value = 600;\n    gain.gain.setValueAtTime(0.06, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.06);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.06);\n  }\n\n  playUIConfirm(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(523, ctx.currentTime);\n    osc.frequency.setValueAtTime(659, ctx.currentTime + 0.06);\n    gain.gain.setValueAtTime(0.08, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.15);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.15);\n  }\n\n  playUIError(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'square';\n    osc.frequency.value = 200;\n    gain.gain.setValueAtTime(0.06, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.2);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.2);\n  }\n\n  playNewDay(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Morning bell\n    const notes = [523, 659, 784];\n    for (let i = 0; i < notes.length; i++) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = notes[i];\n      const t = ctx.currentTime + i * 0.2;\n      gain.gain.setValueAtTime(0, t);\n      gain.gain.linearRampToValueAtTime(0.08, t + 0.05);\n      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.6);\n      osc.connect(gain).connect(this.sfxGain);\n      osc.start(t);\n      osc.stop(t + 0.6);\n    }\n  }\n\n  playGameOver(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Descending sad tones\n    const notes = [440, 370, 311, 261];\n    for (let i = 0; i < notes.length; i++) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = notes[i];\n      const t = ctx.currentTime + i * 0.4;\n      gain.gain.setValueAtTime(0, t);\n      gain.gain.linearRampToValueAtTime(0.1, t + 0.05);\n      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.8);\n      osc.connect(gain).connect(this.sfxGain);\n      osc.start(t);\n      osc.stop(t + 0.8);\n    }\n  }\n\n  playAchievement(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Triumphant jingle\n    const notes = [523, 659, 784, 1047];\n    for (let i = 0; i < notes.length; i++) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = notes[i];\n      const t = ctx.currentTime + i * 0.12;\n      gain.gain.setValueAtTime(0, t);\n      gain.gain.linearRampToValueAtTime(0.1, t + 0.03);\n      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.5);\n      osc.connect(gain).connect(this.sfxGain);\n      osc.start(t);\n      osc.stop(t + 0.5);\n    }\n  }\n\n  // ============ ORIGINAL SFX (kept) ============\n\n  playCollect(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(880, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(1760, ctx.currentTime + 0.1);\n    gain.gain.setValueAtTime(0.2, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.15);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.15);\n  }\n\n  playBuild(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'square';\n    osc.frequency.setValueAtTime(220, ctx.currentTime);\n    osc.frequency.setValueAtTime(330, ctx.currentTime + 0.08);\n    osc.frequency.setValueAtTime(440, ctx.currentTime + 0.16);\n    gain.gain.setValueAtTime(0.15, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.25);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.25);\n  }\n\n  playTransaction(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Register ding + coin sound\n    this.playRegisterDing();\n    setTimeout(() => this.playCoinDrop(), 200);\n  }\n\n  playBreakthrough(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(200, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(1200, ctx.currentTime + 0.8);\n    gain.gain.setValueAtTime(0.3, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.0);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 1.0);\n\n    for (let i = 0; i < 5; i++) {\n      const s = ctx.createOscillator();\n      const sg = ctx.createGain();\n      s.type = 'sine';\n      s.frequency.value = 800 + i * 200;\n      sg.gain.setValueAtTime(0, ctx.currentTime + 0.4 + i * 0.1);\n      sg.gain.linearRampToValueAtTime(0.1, ctx.currentTime + 0.5 + i * 0.1);\n      sg.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.2 + i * 0.1);\n      s.connect(sg).connect(this.sfxGain);\n      s.start(ctx.currentTime + 0.4 + i * 0.1);\n      s.stop(ctx.currentTime + 1.3 + i * 0.1);\n    }\n  }\n\n  // ============ AMBIENT LOOPS ============\n\n  playAmbient(type: 'store_day' | 'store_night' | 'warehouse' | 'rain'): void {\n    if (type === this.ambientType) return;\n    this.stopAmbient();\n    this.ambientType = type;\n\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n\n    switch (type) {\n      case 'store_day':\n        this.createStoreDayAmbient(ctx);\n        break;\n      case 'store_night':\n        this.createStoreNightAmbient(ctx);\n        break;\n      case 'warehouse':\n        this.createWarehouseAmbient(ctx);\n        break;\n      case 'rain':\n        this.createRainAmbient(ctx);\n        break;\n    }\n  }\n\n  private createStoreDayAmbient(ctx: AudioContext): void {\n    // Humming fridge + faint traffic\n    const fridge = ctx.createOscillator();\n    const fridgeGain = ctx.createGain();\n    fridge.type = 'sine';\n    fridge.frequency.value = 120;\n    fridgeGain.gain.value = 0.015;\n    fridge.connect(fridgeGain).connect(this.sfxGain!);\n    fridge.start();\n    this.ambientOscillators.push(fridge);\n    this.ambientNodes.push(fridgeGain);\n\n    // Fan noise (filtered noise)\n    const bufSize = ctx.sampleRate * 2;\n    const buf = ctx.createBuffer(1, bufSize, ctx.sampleRate);\n    const d = buf.getChannelData(0);\n    for (let i = 0; i < bufSize; i++) d[i] = (Math.random() * 2 - 1);\n    const src = ctx.createBufferSource();\n    src.buffer = buf;\n    src.loop = true;\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'bandpass';\n    filter.frequency.value = 300;\n    filter.Q.value = 0.5;\n    const gain = ctx.createGain();\n    gain.gain.value = 0.01;\n    src.connect(filter).connect(gain).connect(this.sfxGain!);\n    src.start();\n    this.ambientNodes.push(src, filter, gain);\n  }\n\n  private createStoreNightAmbient(ctx: AudioContext): void {\n    // Quieter fridge hum + occasional creaks via drone\n    const fridge = ctx.createOscillator();\n    const fridgeGain = ctx.createGain();\n    fridge.type = 'sine';\n    fridge.frequency.value = 120;\n    fridgeGain.gain.value = 0.02;\n    fridge.connect(fridgeGain).connect(this.sfxGain!);\n    fridge.start();\n    this.ambientOscillators.push(fridge);\n    this.ambientNodes.push(fridgeGain);\n\n    // Very low ambient drone\n    const drone = ctx.createOscillator();\n    const droneGain = ctx.createGain();\n    drone.type = 'sine';\n    drone.frequency.value = 35;\n    droneGain.gain.value = 0.008;\n    drone.connect(droneGain).connect(this.sfxGain!);\n    drone.start();\n    this.ambientOscillators.push(drone);\n    this.ambientNodes.push(droneGain);\n  }\n\n  private createWarehouseAmbient(ctx: AudioContext): void {\n    // Echo-like drone\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.value = 60;\n    gain.gain.value = 0.012;\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'lowpass';\n    filter.frequency.value = 150;\n    osc.connect(filter).connect(gain).connect(this.sfxGain!);\n    osc.start();\n    this.ambientOscillators.push(osc);\n    this.ambientNodes.push(gain, filter);\n  }\n\n  private createRainAmbient(ctx: AudioContext): void {\n    // Looping noise filtered to sound like rain\n    const bufSize = ctx.sampleRate * 3;\n    const buf = ctx.createBuffer(1, bufSize, ctx.sampleRate);\n    const d = buf.getChannelData(0);\n    for (let i = 0; i < bufSize; i++) d[i] = (Math.random() * 2 - 1);\n    const src = ctx.createBufferSource();\n    src.buffer = buf;\n    src.loop = true;\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'bandpass';\n    filter.frequency.value = 2000;\n    filter.Q.value = 0.3;\n    const gain = ctx.createGain();\n    gain.gain.value = 0.03;\n    src.connect(filter).connect(gain).connect(this.sfxGain!);\n    src.start();\n    this.ambientNodes.push(src, filter, gain);\n  }\n\n  stopAmbient(): void {\n    for (const osc of this.ambientOscillators) {\n      try { osc.stop(); } catch { /* ok */ }\n    }\n    this.ambientOscillators = [];\n    this.ambientNodes = [];\n    this.ambientType = '';\n  }\n\n  // ============ HORROR SFX ============\n\n  playHorrorFlicker(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(60, ctx.currentTime);\n    osc.frequency.linearRampToValueAtTime(120, ctx.currentTime + 0.1);\n    osc.frequency.linearRampToValueAtTime(60, ctx.currentTime + 0.2);\n    gain.gain.setValueAtTime(0.08, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 0.3);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.3);\n  }\n\n  playHorrorWhisper(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const bufferSize = ctx.sampleRate * 1.5;\n    const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);\n    const data = buffer.getChannelData(0);\n    for (let i = 0; i < bufferSize; i++) {\n      data[i] = (Math.random() * 2 - 1) * 0.3;\n    }\n    const source = ctx.createBufferSource();\n    source.buffer = buffer;\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'bandpass';\n    filter.frequency.value = 800;\n    filter.Q.value = 2;\n    const gain = ctx.createGain();\n    gain.gain.setValueAtTime(0, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0.15, ctx.currentTime + 0.5);\n    gain.gain.linearRampToValueAtTime(0.1, ctx.currentTime + 1.0);\n    gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 1.5);\n    source.connect(filter).connect(gain).connect(this.sfxGain);\n    source.start();\n    source.stop(ctx.currentTime + 1.5);\n  }\n\n  playHorrorDoorCreak(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(40, ctx.currentTime);\n    osc.frequency.linearRampToValueAtTime(80, ctx.currentTime + 0.5);\n    osc.frequency.linearRampToValueAtTime(50, ctx.currentTime + 1.0);\n    gain.gain.setValueAtTime(0.1, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0.15, ctx.currentTime + 0.3);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.2);\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'lowpass';\n    filter.frequency.value = 300;\n    osc.connect(filter).connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 1.2);\n  }\n\n  playHorrorSuddenSilence(): void {\n    this.stopBgm();\n  }\n\n  playHorrorJumpScare(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(200, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(2000, ctx.currentTime + 0.05);\n    gain.gain.setValueAtTime(0.4, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.5);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.5);\n\n    const sub = ctx.createOscillator();\n    const subGain = ctx.createGain();\n    sub.type = 'sine';\n    sub.frequency.value = 30;\n    subGain.gain.setValueAtTime(0.5, ctx.currentTime);\n    subGain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.8);\n    sub.connect(subGain).connect(this.sfxGain);\n    sub.start();\n    sub.stop(ctx.currentTime + 0.8);\n  }\n\n  playHorrorAmbientDrone(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.value = 55;\n    gain.gain.setValueAtTime(0, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0.08, ctx.currentTime + 2);\n    gain.gain.linearRampToValueAtTime(0.05, ctx.currentTime + 4);\n    gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 6);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 6);\n  }\n\n  playHorrorHeartbeat(fast: boolean = false): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const bpm = fast ? 140 : 90;\n    const interval = 60 / bpm;\n    // Double-beat pattern\n    for (let b = 0; b < 2; b++) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = 50;\n      const t = ctx.currentTime + b * 0.12;\n      gain.gain.setValueAtTime(b === 0 ? 0.12 : 0.08, t);\n      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.15);\n      osc.connect(gain).connect(this.sfxGain);\n      osc.start(t);\n      osc.stop(t + 0.15);\n    }\n  }\n\n  // ============ BGM ============\n\n  playBgm(type: 'daytime' | 'night' | 'danger'): void {\n    if (type === this.currentBgm) return;\n    this.stopBgm();\n    this.currentBgm = type;\n\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.bgmGain) return;\n\n    switch (type) {\n      case 'daytime':\n        this.createDaytimeBgm(ctx);\n        break;\n      case 'night':\n        this.createNightBgm(ctx);\n        break;\n      case 'danger':\n        this.createDangerBgm(ctx);\n        break;\n    }\n  }\n\n  private createDaytimeBgm(ctx: AudioContext): void {\n    const freqs = [220, 277, 330];\n    for (const f of freqs) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = f;\n      gain.gain.value = 0.02;\n      osc.connect(gain).connect(this.bgmGain!);\n      osc.start();\n      this.bgmOscillators.push(osc);\n      this.bgmNodes.push(gain);\n    }\n  }\n\n  private createNightBgm(ctx: AudioContext): void {\n    const freqs = [55, 82.5, 110];\n    for (const f of freqs) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = f;\n      const lfo = ctx.createOscillator();\n      const lfoGain = ctx.createGain();\n      lfo.frequency.value = 0.1 + Math.random() * 0.2;\n      lfoGain.gain.value = f * 0.02;\n      lfo.connect(lfoGain).connect(osc.frequency);\n      lfo.start();\n      gain.gain.value = 0.025;\n      osc.connect(gain).connect(this.bgmGain!);\n      osc.start();\n      this.bgmOscillators.push(osc, lfo);\n      this.bgmNodes.push(gain, lfoGain);\n    }\n  }\n\n  private createDangerBgm(ctx: AudioContext): void {\n    const bass = ctx.createOscillator();\n    const bassGain = ctx.createGain();\n    bass.type = 'sawtooth';\n    bass.frequency.value = 40;\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'lowpass';\n    filter.frequency.value = 120;\n    bassGain.gain.value = 0.03;\n    bass.connect(filter).connect(bassGain).connect(this.bgmGain!);\n    bass.start();\n    this.bgmOscillators.push(bass);\n    this.bgmNodes.push(bassGain, filter);\n\n    const pulse = ctx.createOscillator();\n    const pulseGain = ctx.createGain();\n    pulse.type = 'sine';\n    pulse.frequency.value = 50;\n    const pulseLfo = ctx.createOscillator();\n    const pulseLfoGain = ctx.createGain();\n    pulseLfo.frequency.value = 1.2;\n    pulseLfoGain.gain.value = 0.04;\n    pulseLfo.connect(pulseLfoGain).connect(pulseGain.gain);\n    pulseLfo.start();\n    pulseGain.gain.value = 0.03;\n    pulse.connect(pulseGain).connect(this.bgmGain!);\n    pulse.start();\n    this.bgmOscillators.push(pulse, pulseLfo);\n    this.bgmNodes.push(pulseGain, pulseLfoGain);\n  }\n\n  stopBgm(): void {\n    for (const osc of this.bgmOscillators) {\n      try { osc.stop(); } catch { /* already stopped */ }\n    }\n    this.bgmOscillators = [];\n    this.bgmNodes = [];\n    this.currentBgm = 'silence';\n  }\n\n  // ============ VOLUME ============\n\n  setMasterVolume(v: number): void {\n    this.volume = Math.max(0, Math.min(1, v));\n    if (this.masterGain) this.masterGain.gain.value = this.volume;\n  }\n\n  setBgmVolume(v: number): void {\n    this.bgmVolume = Math.max(0, Math.min(1, v));\n    if (this.bgmGain) this.bgmGain.gain.value = this.bgmVolume;\n  }\n\n  setSfxVolume(v: number): void {\n    this.sfxVolume = Math.max(0, Math.min(1, v));\n    if (this.sfxGain) this.sfxGain.gain.value = this.sfxVolume;\n  }\n\n  get masterVolume(): number { return this.volume; }\n  get currentBgmType(): string { return this.currentBgm; }\n\n  destroy(): void {\n    this.stopBgm();\n    this.stopAmbient();\n    if (this.ctx) {\n      this.ctx.close();\n      this.ctx = null;\n    }\n    this.initialized = false;\n  }\n}"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"328f9d51-5f9c-4f63-927e-7b99009d6517","uuid":"0f329e45-400f-44b1-a23b-d79d3a8a11d6"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_313069b83e144d72b3686c49","type":"tool_result","content":"The file D:/game-projects/steam-horror-sim/src/game/AudioManager.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"328f9d51-5f9c-4f63-927e-7b99009d6517","uuid":"d02f25ab-88a8-4f52-81d1-ef407e10d260","timestamp":"2026-05-23T05:42:46.078Z","tool_use_result":{"filePath":"D:/game-projects/steam-horror-sim/src/game/AudioManager.ts","oldString":"// AudioManager.ts — Web Audio API sound system with horror effects (M4)\n\nexport class AudioManager {\n  private ctx: AudioContext | null = null;\n  private masterGain: GainNode | null = null;\n  private bgmGain: GainNode | null = null;\n  private sfxGain: GainNode | null = null;\n  private volume = 0.7;\n  private bgmVolume = 0.3;\n  private sfxVolume = 0.5;\n  private initialized = false;\n  private currentBgm: 'daytime' | 'night' | 'danger' | 'silence' = 'silence';\n  private bgmOscillators: OscillatorNode[] = [];\n  private bgmNodes: AudioNode[] = [];\n\n  init(): void {\n    if (this.initialized) return;\n    try {\n      this.ctx = new AudioContext();\n      this.masterGain = this.ctx.createGain();\n      this.masterGain.gain.value = this.volume;\n      this.masterGain.connect(this.ctx.destination);\n\n      this.bgmGain = this.ctx.createGain();\n      this.bgmGain.gain.value = this.bgmVolume;\n      this.bgmGain.connect(this.masterGain);\n\n      this.sfxGain = this.ctx.createGain();\n      this.sfxGain.gain.value = this.sfxVolume;\n      this.sfxGain.connect(this.masterGain);\n\n      this.initialized = true;\n    } catch {\n      console.warn('AudioManager: Web Audio API not available');\n    }\n  }\n\n  private ensureCtx(): AudioContext | null {\n    if (!this.initialized) this.init();\n    if (this.ctx?.state === 'suspended') this.ctx.resume();\n    return this.ctx;\n  }\n\n  // --- SFX ---\n\n  playCollect(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(880, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(1760, ctx.currentTime + 0.1);\n    gain.gain.setValueAtTime(0.2, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.15);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.15);\n  }\n\n  playBuild(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'square';\n    osc.frequency.setValueAtTime(220, ctx.currentTime);\n    osc.frequency.setValueAtTime(330, ctx.currentTime + 0.08);\n    osc.frequency.setValueAtTime(440, ctx.currentTime + 0.16);\n    gain.gain.setValueAtTime(0.15, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.25);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.25);\n  }\n\n  playTransaction(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(660, ctx.currentTime);\n    osc.frequency.setValueAtTime(880, ctx.currentTime + 0.06);\n    gain.gain.setValueAtTime(0.15, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.12);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.12);\n  }\n\n  playBreakthrough(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Rising tone\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(200, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(1200, ctx.currentTime + 0.8);\n    gain.gain.setValueAtTime(0.3, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.0);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 1.0);\n\n    // Shimmer\n    for (let i = 0; i < 5; i++) {\n      const s = ctx.createOscillator();\n      const sg = ctx.createGain();\n      s.type = 'sine';\n      s.frequency.value = 800 + i * 200;\n      sg.gain.setValueAtTime(0, ctx.currentTime + 0.4 + i * 0.1);\n      sg.gain.linearRampToValueAtTime(0.1, ctx.currentTime + 0.5 + i * 0.1);\n      sg.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.2 + i * 0.1);\n      s.connect(sg).connect(this.sfxGain);\n      s.start(ctx.currentTime + 0.4 + i * 0.1);\n      s.stop(ctx.currentTime + 1.3 + i * 0.1);\n    }\n  }\n\n  // --- Horror SFX ---\n\n  playHorrorFlicker(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Buzzing electrical sound\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(60, ctx.currentTime);\n    osc.frequency.linearRampToValueAtTime(120, ctx.currentTime + 0.1);\n    osc.frequency.linearRampToValueAtTime(60, ctx.currentTime + 0.2);\n    gain.gain.setValueAtTime(0.08, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 0.3);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.3);\n  }\n\n  playHorrorWhisper(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Filtered noise for whisper effect\n    const bufferSize = ctx.sampleRate * 1.5;\n    const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);\n    const data = buffer.getChannelData(0);\n    for (let i = 0; i < bufferSize; i++) {\n      data[i] = (Math.random() * 2 - 1) * 0.3;\n    }\n    const source = ctx.createBufferSource();\n    source.buffer = buffer;\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'bandpass';\n    filter.frequency.value = 800;\n    filter.Q.value = 2;\n    const gain = ctx.createGain();\n    gain.gain.setValueAtTime(0, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0.15, ctx.currentTime + 0.5);\n    gain.gain.linearRampToValueAtTime(0.1, ctx.currentTime + 1.0);\n    gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 1.5);\n    source.connect(filter).connect(gain).connect(this.sfxGain);\n    source.start();\n    source.stop(ctx.currentTime + 1.5);\n  }\n\n  playHorrorDoorCreak(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Low creaking sound\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(40, ctx.currentTime);\n    osc.frequency.linearRampToValueAtTime(80, ctx.currentTime + 0.5);\n    osc.frequency.linearRampToValueAtTime(50, ctx.currentTime + 1.0);\n    gain.gain.setValueAtTime(0.1, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0.15, ctx.currentTime + 0.3);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.2);\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'lowpass';\n    filter.frequency.value = 300;\n    osc.connect(filter).connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 1.2);\n  }\n\n  playHorrorSuddenSilence(): void {\n    // The absence of sound is scarier — handled by BGM crossfade\n    this.stopBgm();\n  }\n\n  playHorrorJumpScare(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Sharp stinger\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(200, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(2000, ctx.currentTime + 0.05);\n    gain.gain.setValueAtTime(0.4, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.5);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.5);\n\n    // Sub-bass hit\n    const sub = ctx.createOscillator();\n    const subGain = ctx.createGain();\n    sub.type = 'sine';\n    sub.frequency.value = 30;\n    subGain.gain.setValueAtTime(0.5, ctx.currentTime);\n    subGain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.8);\n    sub.connect(subGain).connect(this.sfxGain);\n    sub.start();\n    sub.stop(ctx.currentTime + 0.8);\n  }\n\n  playHorrorAmbientDrone(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.value = 55;\n    gain.gain.setValueAtTime(0, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0.08, ctx.currentTime + 2);\n    gain.gain.linearRampToValueAtTime(0.05, ctx.currentTime + 4);\n    gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 6);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 6);\n  }\n\n  // --- BGM ---\n\n  playBgm(type: 'daytime' | 'night' | 'danger'): void {\n    if (type === this.currentBgm) return;\n    this.stopBgm();\n    this.currentBgm = type;\n\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.bgmGain) return;\n\n    switch (type) {\n      case 'daytime':\n        this.createDaytimeBgm(ctx);\n        break;\n      case 'night':\n        this.createNightBgm(ctx);\n        break;\n      case 'danger':\n        this.createDangerBgm(ctx);\n        break;\n    }\n  }\n\n  private createDaytimeBgm(ctx: AudioContext): void {\n    // Gentle ambient pad\n    const freqs = [220, 277, 330];\n    for (const f of freqs) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = f;\n      gain.gain.value = 0.02;\n      osc.connect(gain).connect(this.bgmGain!);\n      osc.start();\n      this.bgmOscillators.push(osc);\n      this.bgmNodes.push(gain);\n    }\n  }\n\n  private createNightBgm(ctx: AudioContext): void {\n    // Eerie drone\n    const freqs = [55, 82.5, 110];\n    for (const f of freqs) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = f;\n      // Slow LFO\n      const lfo = ctx.createOscillator();\n      const lfoGain = ctx.createGain();\n      lfo.frequency.value = 0.1 + Math.random() * 0.2;\n      lfoGain.gain.value = f * 0.02;\n      lfo.connect(lfoGain).connect(osc.frequency);\n      lfo.start();\n\n      gain.gain.value = 0.025;\n      osc.connect(gain).connect(this.bgmGain!);\n      osc.start();\n      this.bgmOscillators.push(osc, lfo);\n      this.bgmNodes.push(gain, lfoGain);\n    }\n  }\n\n  private createDangerBgm(ctx: AudioContext): void {\n    // Disturbing drone + heartbeat\n    const bass = ctx.createOscillator();\n    const bassGain = ctx.createGain();\n    bass.type = 'sawtooth';\n    bass.frequency.value = 40;\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'lowpass';\n    filter.frequency.value = 120;\n    bassGain.gain.value = 0.03;\n    bass.connect(filter).connect(bassGain).connect(this.bgmGain!);\n    bass.start();\n    this.bgmOscillators.push(bass);\n    this.bgmNodes.push(bassGain, filter);\n\n    // Heartbeat-like pulse\n    const pulse = ctx.createOscillator();\n    const pulseGain = ctx.createGain();\n    pulse.type = 'sine';\n    pulse.frequency.value = 50;\n    // Rhythmic gain modulation via LFO\n    const pulseLfo = ctx.createOscillator();\n    const pulseLfoGain = ctx.createGain();\n    pulseLfo.frequency.value = 1.2; // ~72 bpm heartbeat\n    pulseLfoGain.gain.value = 0.04;\n    pulseLfo.connect(pulseLfoGain).connect(pulseGain.gain);\n    pulseLfo.start();\n    pulseGain.gain.value = 0.03;\n    pulse.connect(pulseGain).connect(this.bgmGain!);\n    pulse.start();\n    this.bgmOscillators.push(pulse, pulseLfo);\n    this.bgmNodes.push(pulseGain, pulseLfoGain);\n  }\n\n  stopBgm(): void {\n    for (const osc of this.bgmOscillators) {\n      try { osc.stop(); } catch { /* already stopped */ }\n    }\n    this.bgmOscillators = [];\n    this.bgmNodes = [];\n    this.currentBgm = 'silence';\n  }\n\n  // --- Volume ---\n\n  setMasterVolume(v: number): void {\n    this.volume = Math.max(0, Math.min(1, v));\n    if (this.masterGain) this.masterGain.gain.value = this.volume;\n  }\n\n  setBgmVolume(v: number): void {\n    this.bgmVolume = Math.max(0, Math.min(1, v));\n    if (this.bgmGain) this.bgmGain.gain.value = this.bgmVolume;\n  }\n\n  setSfxVolume(v: number): void {\n    this.sfxVolume = Math.max(0, Math.min(1, v));\n    if (this.sfxGain) this.sfxGain.gain.value = this.sfxVolume;\n  }\n\n  get masterVolume(): number { return this.volume; }\n  get currentBgmType(): string { return this.currentBgm; }\n\n  destroy(): void {\n    this.stopBgm();\n    if (this.ctx) {\n      this.ctx.close();\n      this.ctx = null;\n    }\n    this.initialized = false;\n  }\n}","newString":"// AudioManager.ts — Web Audio API sound system (v1.0.0 — M7: Full audio polish)\n\nexport class AudioManager {\n  private ctx: AudioContext | null = null;\n  private masterGain: GainNode | null = null;\n  private bgmGain: GainNode | null = null;\n  private sfxGain: GainNode | null = null;\n  private volume = 0.7;\n  private bgmVolume = 0.3;\n  private sfxVolume = 0.5;\n  private initialized = false;\n  private currentBgm: 'daytime' | 'night' | 'danger' | 'silence' = 'silence';\n  private bgmOscillators: OscillatorNode[] = [];\n  private bgmNodes: AudioNode[] = [];\n\n  // Ambient loop state\n  private ambientNodes: AudioNode[] = [];\n  private ambientOscillators: OscillatorNode[] = [];\n  private ambientType: string = '';\n  private lastFootstepTime = 0;\n  private footstepCooldown = 250; // ms between footsteps\n\n  init(): void {\n    if (this.initialized) return;\n    try {\n      this.ctx = new AudioContext();\n      this.masterGain = this.ctx.createGain();\n      this.masterGain.gain.value = this.volume;\n      this.masterGain.connect(this.ctx.destination);\n\n      this.bgmGain = this.ctx.createGain();\n      this.bgmGain.gain.value = this.bgmVolume;\n      this.bgmGain.connect(this.masterGain);\n\n      this.sfxGain = this.ctx.createGain();\n      this.sfxGain.gain.value = this.sfxVolume;\n      this.sfxGain.connect(this.masterGain);\n\n      this.initialized = true;\n    } catch {\n      console.warn('AudioManager: Web Audio API not available');\n    }\n  }\n\n  private ensureCtx(): AudioContext | null {\n    if (!this.initialized) this.init();\n    if (this.ctx?.state === 'suspended') this.ctx.resume();\n    return this.ctx;\n  }\n\n  // ============ ENVIRONMENT / INTERACTION SFX ============\n\n  playFootstep(): void {\n    const now = performance.now();\n    if (now - this.lastFootstepTime < this.footstepCooldown) return;\n    this.lastFootstepTime = now;\n\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Soft thud with slight randomization\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    const filter = ctx.createBiquadFilter();\n    osc.type = 'sine';\n    const baseFreq = 80 + Math.random() * 30;\n    osc.frequency.setValueAtTime(baseFreq, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(40, ctx.currentTime + 0.08);\n    filter.type = 'lowpass';\n    filter.frequency.value = 200;\n    gain.gain.setValueAtTime(0.06, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.1);\n    osc.connect(filter).connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.1);\n\n    // Noise burst for texture\n    const bufSize = Math.floor(ctx.sampleRate * 0.04);\n    const buf = ctx.createBuffer(1, bufSize, ctx.sampleRate);\n    const d = buf.getChannelData(0);\n    for (let i = 0; i < bufSize; i++) d[i] = (Math.random() * 2 - 1) * 0.15;\n    const src = ctx.createBufferSource();\n    src.buffer = buf;\n    const ng = ctx.createGain();\n    ng.gain.setValueAtTime(0.03, ctx.currentTime);\n    ng.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.05);\n    const nf = ctx.createBiquadFilter();\n    nf.type = 'lowpass';\n    nf.frequency.value = 400;\n    src.connect(nf).connect(ng).connect(this.sfxGain);\n    src.start();\n    src.stop(ctx.currentTime + 0.05);\n  }\n\n  playDoorOpen(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(150, ctx.currentTime);\n    osc.frequency.linearRampToValueAtTime(300, ctx.currentTime + 0.15);\n    osc.frequency.linearRampToValueAtTime(200, ctx.currentTime + 0.3);\n    gain.gain.setValueAtTime(0.06, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'lowpass';\n    filter.frequency.value = 600;\n    osc.connect(filter).connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.35);\n  }\n\n  playDoorClose(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Thud\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(120, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(30, ctx.currentTime + 0.15);\n    gain.gain.setValueAtTime(0.12, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.2);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.2);\n    // Click\n    const click = ctx.createOscillator();\n    const cg = ctx.createGain();\n    click.type = 'square';\n    click.frequency.value = 800;\n    cg.gain.setValueAtTime(0.04, ctx.currentTime + 0.05);\n    cg.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.08);\n    click.connect(cg).connect(this.sfxGain);\n    click.start(ctx.currentTime + 0.05);\n    click.stop(ctx.currentTime + 0.08);\n  }\n\n  playRegisterDing(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(1200, ctx.currentTime);\n    osc.frequency.setValueAtTime(1600, ctx.currentTime + 0.05);\n    gain.gain.setValueAtTime(0.12, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.4);\n  }\n\n  playShelfPlace(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Soft clunk\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'triangle';\n    osc.frequency.setValueAtTime(200, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(80, ctx.currentTime + 0.1);\n    gain.gain.setValueAtTime(0.08, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.12);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.12);\n  }\n\n  playCustomerEnter(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Chime bell (ding-dong)\n    for (let i = 0; i < 2; i++) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = i === 0 ? 880 : 1100;\n      const t = ctx.currentTime + i * 0.25;\n      gain.gain.setValueAtTime(0.1, t);\n      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.5);\n      osc.connect(gain).connect(this.sfxGain);\n      osc.start(t);\n      osc.stop(t + 0.5);\n    }\n  }\n\n  playCustomerLeave(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(660, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(440, ctx.currentTime + 0.3);\n    gain.gain.setValueAtTime(0.05, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.35);\n  }\n\n  playCoinDrop(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Metallic clink\n    for (let i = 0; i < 3; i++) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = 2500 + i * 400 + Math.random() * 200;\n      const t = ctx.currentTime + i * 0.07;\n      gain.gain.setValueAtTime(0.08, t);\n      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.15);\n      osc.connect(gain).connect(this.sfxGain);\n      osc.start(t);\n      osc.stop(t + 0.15);\n    }\n  }\n\n  playUIClick(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.value = 600;\n    gain.gain.setValueAtTime(0.06, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.06);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.06);\n  }\n\n  playUIConfirm(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(523, ctx.currentTime);\n    osc.frequency.setValueAtTime(659, ctx.currentTime + 0.06);\n    gain.gain.setValueAtTime(0.08, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.15);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.15);\n  }\n\n  playUIError(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'square';\n    osc.frequency.value = 200;\n    gain.gain.setValueAtTime(0.06, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.2);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.2);\n  }\n\n  playNewDay(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Morning bell\n    const notes = [523, 659, 784];\n    for (let i = 0; i < notes.length; i++) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = notes[i];\n      const t = ctx.currentTime + i * 0.2;\n      gain.gain.setValueAtTime(0, t);\n      gain.gain.linearRampToValueAtTime(0.08, t + 0.05);\n      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.6);\n      osc.connect(gain).connect(this.sfxGain);\n      osc.start(t);\n      osc.stop(t + 0.6);\n    }\n  }\n\n  playGameOver(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Descending sad tones\n    const notes = [440, 370, 311, 261];\n    for (let i = 0; i < notes.length; i++) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = notes[i];\n      const t = ctx.currentTime + i * 0.4;\n      gain.gain.setValueAtTime(0, t);\n      gain.gain.linearRampToValueAtTime(0.1, t + 0.05);\n      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.8);\n      osc.connect(gain).connect(this.sfxGain);\n      osc.start(t);\n      osc.stop(t + 0.8);\n    }\n  }\n\n  playAchievement(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Triumphant jingle\n    const notes = [523, 659, 784, 1047];\n    for (let i = 0; i < notes.length; i++) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = notes[i];\n      const t = ctx.currentTime + i * 0.12;\n      gain.gain.setValueAtTime(0, t);\n      gain.gain.linearRampToValueAtTime(0.1, t + 0.03);\n      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.5);\n      osc.connect(gain).connect(this.sfxGain);\n      osc.start(t);\n      osc.stop(t + 0.5);\n    }\n  }\n\n  // ============ ORIGINAL SFX (kept) ============\n\n  playCollect(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(880, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(1760, ctx.currentTime + 0.1);\n    gain.gain.setValueAtTime(0.2, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.15);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.15);\n  }\n\n  playBuild(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'square';\n    osc.frequency.setValueAtTime(220, ctx.currentTime);\n    osc.frequency.setValueAtTime(330, ctx.currentTime + 0.08);\n    osc.frequency.setValueAtTime(440, ctx.currentTime + 0.16);\n    gain.gain.setValueAtTime(0.15, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.25);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.25);\n  }\n\n  playTransaction(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Register ding + coin sound\n    this.playRegisterDing();\n    setTimeout(() => this.playCoinDrop(), 200);\n  }\n\n  playBreakthrough(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(200, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(1200, ctx.currentTime + 0.8);\n    gain.gain.setValueAtTime(0.3, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.0);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 1.0);\n\n    for (let i = 0; i < 5; i++) {\n      const s = ctx.createOscillator();\n      const sg = ctx.createGain();\n      s.type = 'sine';\n      s.frequency.value = 800 + i * 200;\n      sg.gain.setValueAtTime(0, ctx.currentTime + 0.4 + i * 0.1);\n      sg.gain.linearRampToValueAtTime(0.1, ctx.currentTime + 0.5 + i * 0.1);\n      sg.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.2 + i * 0.1);\n      s.connect(sg).connect(this.sfxGain);\n      s.start(ctx.currentTime + 0.4 + i * 0.1);\n      s.stop(ctx.currentTime + 1.3 + i * 0.1);\n    }\n  }\n\n  // ============ AMBIENT LOOPS ============\n\n  playAmbient(type: 'store_day' | 'store_night' | 'warehouse' | 'rain'): void {\n    if (type === this.ambientType) return;\n    this.stopAmbient();\n    this.ambientType = type;\n\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n\n    switch (type) {\n      case 'store_day':\n        this.createStoreDayAmbient(ctx);\n        break;\n      case 'store_night':\n        this.createStoreNightAmbient(ctx);\n        break;\n      case 'warehouse':\n        this.createWarehouseAmbient(ctx);\n        break;\n      case 'rain':\n        this.createRainAmbient(ctx);\n        break;\n    }\n  }\n\n  private createStoreDayAmbient(ctx: AudioContext): void {\n    // Humming fridge + faint traffic\n    const fridge = ctx.createOscillator();\n    const fridgeGain = ctx.createGain();\n    fridge.type = 'sine';\n    fridge.frequency.value = 120;\n    fridgeGain.gain.value = 0.015;\n    fridge.connect(fridgeGain).connect(this.sfxGain!);\n    fridge.start();\n    this.ambientOscillators.push(fridge);\n    this.ambientNodes.push(fridgeGain);\n\n    // Fan noise (filtered noise)\n    const bufSize = ctx.sampleRate * 2;\n    const buf = ctx.createBuffer(1, bufSize, ctx.sampleRate);\n    const d = buf.getChannelData(0);\n    for (let i = 0; i < bufSize; i++) d[i] = (Math.random() * 2 - 1);\n    const src = ctx.createBufferSource();\n    src.buffer = buf;\n    src.loop = true;\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'bandpass';\n    filter.frequency.value = 300;\n    filter.Q.value = 0.5;\n    const gain = ctx.createGain();\n    gain.gain.value = 0.01;\n    src.connect(filter).connect(gain).connect(this.sfxGain!);\n    src.start();\n    this.ambientNodes.push(src, filter, gain);\n  }\n\n  private createStoreNightAmbient(ctx: AudioContext): void {\n    // Quieter fridge hum + occasional creaks via drone\n    const fridge = ctx.createOscillator();\n    const fridgeGain = ctx.createGain();\n    fridge.type = 'sine';\n    fridge.frequency.value = 120;\n    fridgeGain.gain.value = 0.02;\n    fridge.connect(fridgeGain).connect(this.sfxGain!);\n    fridge.start();\n    this.ambientOscillators.push(fridge);\n    this.ambientNodes.push(fridgeGain);\n\n    // Very low ambient drone\n    const drone = ctx.createOscillator();\n    const droneGain = ctx.createGain();\n    drone.type = 'sine';\n    drone.frequency.value = 35;\n    droneGain.gain.value = 0.008;\n    drone.connect(droneGain).connect(this.sfxGain!);\n    drone.start();\n    this.ambientOscillators.push(drone);\n    this.ambientNodes.push(droneGain);\n  }\n\n  private createWarehouseAmbient(ctx: AudioContext): void {\n    // Echo-like drone\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.value = 60;\n    gain.gain.value = 0.012;\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'lowpass';\n    filter.frequency.value = 150;\n    osc.connect(filter).connect(gain).connect(this.sfxGain!);\n    osc.start();\n    this.ambientOscillators.push(osc);\n    this.ambientNodes.push(gain, filter);\n  }\n\n  private createRainAmbient(ctx: AudioContext): void {\n    // Looping noise filtered to sound like rain\n    const bufSize = ctx.sampleRate * 3;\n    const buf = ctx.createBuffer(1, bufSize, ctx.sampleRate);\n    const d = buf.getChannelData(0);\n    for (let i = 0; i < bufSize; i++) d[i] = (Math.random() * 2 - 1);\n    const src = ctx.createBufferSource();\n    src.buffer = buf;\n    src.loop = true;\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'bandpass';\n    filter.frequency.value = 2000;\n    filter.Q.value = 0.3;\n    const gain = ctx.createGain();\n    gain.gain.value = 0.03;\n    src.connect(filter).connect(gain).connect(this.sfxGain!);\n    src.start();\n    this.ambientNodes.push(src, filter, gain);\n  }\n\n  stopAmbient(): void {\n    for (const osc of this.ambientOscillators) {\n      try { osc.stop(); } catch { /* ok */ }\n    }\n    this.ambientOscillators = [];\n    this.ambientNodes = [];\n    this.ambientType = '';\n  }\n\n  // ============ HORROR SFX ============\n\n  playHorrorFlicker(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(60, ctx.currentTime);\n    osc.frequency.linearRampToValueAtTime(120, ctx.currentTime + 0.1);\n    osc.frequency.linearRampToValueAtTime(60, ctx.currentTime + 0.2);\n    gain.gain.setValueAtTime(0.08, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 0.3);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.3);\n  }\n\n  playHorrorWhisper(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const bufferSize = ctx.sampleRate * 1.5;\n    const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);\n    const data = buffer.getChannelData(0);\n    for (let i = 0; i < bufferSize; i++) {\n      data[i] = (Math.random() * 2 - 1) * 0.3;\n    }\n    const source = ctx.createBufferSource();\n    source.buffer = buffer;\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'bandpass';\n    filter.frequency.value = 800;\n    filter.Q.value = 2;\n    const gain = ctx.createGain();\n    gain.gain.setValueAtTime(0, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0.15, ctx.currentTime + 0.5);\n    gain.gain.linearRampToValueAtTime(0.1, ctx.currentTime + 1.0);\n    gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 1.5);\n    source.connect(filter).connect(gain).connect(this.sfxGain);\n    source.start();\n    source.stop(ctx.currentTime + 1.5);\n  }\n\n  playHorrorDoorCreak(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(40, ctx.currentTime);\n    osc.frequency.linearRampToValueAtTime(80, ctx.currentTime + 0.5);\n    osc.frequency.linearRampToValueAtTime(50, ctx.currentTime + 1.0);\n    gain.gain.setValueAtTime(0.1, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0.15, ctx.currentTime + 0.3);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.2);\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'lowpass';\n    filter.frequency.value = 300;\n    osc.connect(filter).connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 1.2);\n  }\n\n  playHorrorSuddenSilence(): void {\n    this.stopBgm();\n  }\n\n  playHorrorJumpScare(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(200, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(2000, ctx.currentTime + 0.05);\n    gain.gain.setValueAtTime(0.4, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.5);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.5);\n\n    const sub = ctx.createOscillator();\n    const subGain = ctx.createGain();\n    sub.type = 'sine';\n    sub.frequency.value = 30;\n    subGain.gain.setValueAtTime(0.5, ctx.currentTime);\n    subGain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.8);\n    sub.connect(subGain).connect(this.sfxGain);\n    sub.start();\n    sub.stop(ctx.currentTime + 0.8);\n  }\n\n  playHorrorAmbientDrone(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.value = 55;\n    gain.gain.setValueAtTime(0, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0.08, ctx.currentTime + 2);\n    gain.gain.linearRampToValueAtTime(0.05, ctx.currentTime + 4);\n    gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 6);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 6);\n  }\n\n  playHorrorHeartbeat(fast: boolean = false): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const bpm = fast ? 140 : 90;\n    const interval = 60 / bpm;\n    // Double-beat pattern\n    for (let b = 0; b < 2; b++) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = 50;\n      const t = ctx.currentTime + b * 0.12;\n      gain.gain.setValueAtTime(b === 0 ? 0.12 : 0.08, t);\n      gain.gain.exponentialRampToValueAtTime(0.001, t + 0.15);\n      osc.connect(gain).connect(this.sfxGain);\n      osc.start(t);\n      osc.stop(t + 0.15);\n    }\n  }\n\n  // ============ BGM ============\n\n  playBgm(type: 'daytime' | 'night' | 'danger'): void {\n    if (type === this.currentBgm) return;\n    this.stopBgm();\n    this.currentBgm = type;\n\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.bgmGain) return;\n\n    switch (type) {\n      case 'daytime':\n        this.createDaytimeBgm(ctx);\n        break;\n      case 'night':\n        this.createNightBgm(ctx);\n        break;\n      case 'danger':\n        this.createDangerBgm(ctx);\n        break;\n    }\n  }\n\n  private createDaytimeBgm(ctx: AudioContext): void {\n    const freqs = [220, 277, 330];\n    for (const f of freqs) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = f;\n      gain.gain.value = 0.02;\n      osc.connect(gain).connect(this.bgmGain!);\n      osc.start();\n      this.bgmOscillators.push(osc);\n      this.bgmNodes.push(gain);\n    }\n  }\n\n  private createNightBgm(ctx: AudioContext): void {\n    const freqs = [55, 82.5, 110];\n    for (const f of freqs) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = f;\n      const lfo = ctx.createOscillator();\n      const lfoGain = ctx.createGain();\n      lfo.frequency.value = 0.1 + Math.random() * 0.2;\n      lfoGain.gain.value = f * 0.02;\n      lfo.connect(lfoGain).connect(osc.frequency);\n      lfo.start();\n      gain.gain.value = 0.025;\n      osc.connect(gain).connect(this.bgmGain!);\n      osc.start();\n      this.bgmOscillators.push(osc, lfo);\n      this.bgmNodes.push(gain, lfoGain);\n    }\n  }\n\n  private createDangerBgm(ctx: AudioContext): void {\n    const bass = ctx.createOscillator();\n    const bassGain = ctx.createGain();\n    bass.type = 'sawtooth';\n    bass.frequency.value = 40;\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'lowpass';\n    filter.frequency.value = 120;\n    bassGain.gain.value = 0.03;\n    bass.connect(filter).connect(bassGain).connect(this.bgmGain!);\n    bass.start();\n    this.bgmOscillators.push(bass);\n    this.bgmNodes.push(bassGain, filter);\n\n    const pulse = ctx.createOscillator();\n    const pulseGain = ctx.createGain();\n    pulse.type = 'sine';\n    pulse.frequency.value = 50;\n    const pulseLfo = ctx.createOscillator();\n    const pulseLfoGain = ctx.createGain();\n    pulseLfo.frequency.value = 1.2;\n    pulseLfoGain.gain.value = 0.04;\n    pulseLfo.connect(pulseLfoGain).connect(pulseGain.gain);\n    pulseLfo.start();\n    pulseGain.gain.value = 0.03;\n    pulse.connect(pulseGain).connect(this.bgmGain!);\n    pulse.start();\n    this.bgmOscillators.push(pulse, pulseLfo);\n    this.bgmNodes.push(pulseGain, pulseLfoGain);\n  }\n\n  stopBgm(): void {\n    for (const osc of this.bgmOscillators) {\n      try { osc.stop(); } catch { /* already stopped */ }\n    }\n    this.bgmOscillators = [];\n    this.bgmNodes = [];\n    this.currentBgm = 'silence';\n  }\n\n  // ============ VOLUME ============\n\n  setMasterVolume(v: number): void {\n    this.volume = Math.max(0, Math.min(1, v));\n    if (this.masterGain) this.masterGain.gain.value = this.volume;\n  }\n\n  setBgmVolume(v: number): void {\n    this.bgmVolume = Math.max(0, Math.min(1, v));\n    if (this.bgmGain) this.bgmGain.gain.value = this.bgmVolume;\n  }\n\n  setSfxVolume(v: number): void {\n    this.sfxVolume = Math.max(0, Math.min(1, v));\n    if (this.sfxGain) this.sfxGain.gain.value = this.sfxVolume;\n  }\n\n  get masterVolume(): number { return this.volume; }\n  get currentBgmType(): string { return this.currentBgm; }\n\n  destroy(): void {\n    this.stopBgm();\n    this.stopAmbient();\n    if (this.ctx) {\n      this.ctx.close();\n      this.ctx = null;\n    }\n    this.initialized = false;\n  }\n}","originalFile":"// AudioManager.ts — Web Audio API sound system with horror effects (M4)\n\nexport class AudioManager {\n  private ctx: AudioContext | null = null;\n  private masterGain: GainNode | null = null;\n  private bgmGain: GainNode | null = null;\n  private sfxGain: GainNode | null = null;\n  private volume = 0.7;\n  private bgmVolume = 0.3;\n  private sfxVolume = 0.5;\n  private initialized = false;\n  private currentBgm: 'daytime' | 'night' | 'danger' | 'silence' = 'silence';\n  private bgmOscillators: OscillatorNode[] = [];\n  private bgmNodes: AudioNode[] = [];\n\n  init(): void {\n    if (this.initialized) return;\n    try {\n      this.ctx = new AudioContext();\n      this.masterGain = this.ctx.createGain();\n      this.masterGain.gain.value = this.volume;\n      this.masterGain.connect(this.ctx.destination);\n\n      this.bgmGain = this.ctx.createGain();\n      this.bgmGain.gain.value = this.bgmVolume;\n      this.bgmGain.connect(this.masterGain);\n\n      this.sfxGain = this.ctx.createGain();\n      this.sfxGain.gain.value = this.sfxVolume;\n      this.sfxGain.connect(this.masterGain);\n\n      this.initialized = true;\n    } catch {\n      console.warn('AudioManager: Web Audio API not available');\n    }\n  }\n\n  private ensureCtx(): AudioContext | null {\n    if (!this.initialized) this.init();\n    if (this.ctx?.state === 'suspended') this.ctx.resume();\n    return this.ctx;\n  }\n\n  // --- SFX ---\n\n  playCollect(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(880, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(1760, ctx.currentTime + 0.1);\n    gain.gain.setValueAtTime(0.2, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.15);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.15);\n  }\n\n  playBuild(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'square';\n    osc.frequency.setValueAtTime(220, ctx.currentTime);\n    osc.frequency.setValueAtTime(330, ctx.currentTime + 0.08);\n    osc.frequency.setValueAtTime(440, ctx.currentTime + 0.16);\n    gain.gain.setValueAtTime(0.15, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.25);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.25);\n  }\n\n  playTransaction(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(660, ctx.currentTime);\n    osc.frequency.setValueAtTime(880, ctx.currentTime + 0.06);\n    gain.gain.setValueAtTime(0.15, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.12);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.12);\n  }\n\n  playBreakthrough(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Rising tone\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(200, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(1200, ctx.currentTime + 0.8);\n    gain.gain.setValueAtTime(0.3, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.0);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 1.0);\n\n    // Shimmer\n    for (let i = 0; i < 5; i++) {\n      const s = ctx.createOscillator();\n      const sg = ctx.createGain();\n      s.type = 'sine';\n      s.frequency.value = 800 + i * 200;\n      sg.gain.setValueAtTime(0, ctx.currentTime + 0.4 + i * 0.1);\n      sg.gain.linearRampToValueAtTime(0.1, ctx.currentTime + 0.5 + i * 0.1);\n      sg.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.2 + i * 0.1);\n      s.connect(sg).connect(this.sfxGain);\n      s.start(ctx.currentTime + 0.4 + i * 0.1);\n      s.stop(ctx.currentTime + 1.3 + i * 0.1);\n    }\n  }\n\n  // --- Horror SFX ---\n\n  playHorrorFlicker(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Buzzing electrical sound\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(60, ctx.currentTime);\n    osc.frequency.linearRampToValueAtTime(120, ctx.currentTime + 0.1);\n    osc.frequency.linearRampToValueAtTime(60, ctx.currentTime + 0.2);\n    gain.gain.setValueAtTime(0.08, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 0.3);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.3);\n  }\n\n  playHorrorWhisper(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Filtered noise for whisper effect\n    const bufferSize = ctx.sampleRate * 1.5;\n    const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);\n    const data = buffer.getChannelData(0);\n    for (let i = 0; i < bufferSize; i++) {\n      data[i] = (Math.random() * 2 - 1) * 0.3;\n    }\n    const source = ctx.createBufferSource();\n    source.buffer = buffer;\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'bandpass';\n    filter.frequency.value = 800;\n    filter.Q.value = 2;\n    const gain = ctx.createGain();\n    gain.gain.setValueAtTime(0, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0.15, ctx.currentTime + 0.5);\n    gain.gain.linearRampToValueAtTime(0.1, ctx.currentTime + 1.0);\n    gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 1.5);\n    source.connect(filter).connect(gain).connect(this.sfxGain);\n    source.start();\n    source.stop(ctx.currentTime + 1.5);\n  }\n\n  playHorrorDoorCreak(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Low creaking sound\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(40, ctx.currentTime);\n    osc.frequency.linearRampToValueAtTime(80, ctx.currentTime + 0.5);\n    osc.frequency.linearRampToValueAtTime(50, ctx.currentTime + 1.0);\n    gain.gain.setValueAtTime(0.1, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0.15, ctx.currentTime + 0.3);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.2);\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'lowpass';\n    filter.frequency.value = 300;\n    osc.connect(filter).connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 1.2);\n  }\n\n  playHorrorSuddenSilence(): void {\n    // The absence of sound is scarier — handled by BGM crossfade\n    this.stopBgm();\n  }\n\n  playHorrorJumpScare(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Sharp stinger\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(200, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(2000, ctx.currentTime + 0.05);\n    gain.gain.setValueAtTime(0.4, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.5);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.5);\n\n    // Sub-bass hit\n    const sub = ctx.createOscillator();\n    const subGain = ctx.createGain();\n    sub.type = 'sine';\n    sub.frequency.value = 30;\n    subGain.gain.setValueAtTime(0.5, ctx.currentTime);\n    subGain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.8);\n    sub.connect(subGain).connect(this.sfxGain);\n    sub.start();\n    sub.stop(ctx.currentTime + 0.8);\n  }\n\n  playHorrorAmbientDrone(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.value = 55;\n    gain.gain.setValueAtTime(0, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0.08, ctx.currentTime + 2);\n    gain.gain.linearRampToValueAtTime(0.05, ctx.currentTime + 4);\n    gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 6);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 6);\n  }\n\n  // --- BGM ---\n\n  playBgm(type: 'daytime' | 'night' | 'danger'): void {\n    if (type === this.currentBgm) return;\n    this.stopBgm();\n    this.currentBgm = type;\n\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.bgmGain) return;\n\n    switch (type) {\n      case 'daytime':\n        this.createDaytimeBgm(ctx);\n        break;\n      case 'night':\n        this.createNightBgm(ctx);\n        break;\n      case 'danger':\n        this.createDangerBgm(ctx);\n        break;\n    }\n  }\n\n  private createDaytimeBgm(ctx: AudioContext): void {\n    // Gentle ambient pad\n    const freqs = [220, 277, 330];\n    for (const f of freqs) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = f;\n      gain.gain.value = 0.02;\n      osc.connect(gain).connect(this.bgmGain!);\n      osc.start();\n      this.bgmOscillators.push(osc);\n      this.bgmNodes.push(gain);\n    }\n  }\n\n  private createNightBgm(ctx: AudioContext): void {\n    // Eerie drone\n    const freqs = [55, 82.5, 110];\n    for (const f of freqs) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = f;\n      // Slow LFO\n      const lfo = ctx.createOscillator();\n      const lfoGain = ctx.createGain();\n      lfo.frequency.value = 0.1 + Math.random() * 0.2;\n      lfoGain.gain.value = f * 0.02;\n      lfo.connect(lfoGain).connect(osc.frequency);\n      lfo.start();\n\n      gain.gain.value = 0.025;\n      osc.connect(gain).connect(this.bgmGain!);\n      osc.start();\n      this.bgmOscillators.push(osc, lfo);\n      this.bgmNodes.push(gain, lfoGain);\n    }\n  }\n\n  private createDangerBgm(ctx: AudioContext): void {\n    // Disturbing drone + heartbeat\n    const bass = ctx.createOscillator();\n    const bassGain = ctx.createGain();\n    bass.type = 'sawtooth';\n    bass.frequency.value = 40;\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'lowpass';\n    filter.frequency.value = 120;\n    bassGain.gain.value = 0.03;\n    bass.connect(filter).connect(bassGain).connect(this.bgmGain!);\n    bass.start();\n    this.bgmOscillators.push(bass);\n    this.bgmNodes.push(bassGain, filter);\n\n    // Heartbeat-like pulse\n    const pulse = ctx.createOscillator();\n    const pulseGain = ctx.createGain();\n    pulse.type = 'sine';\n    pulse.frequency.value = 50;\n    // Rhythmic gain modulation via LFO\n    const pulseLfo = ctx.createOscillator();\n    const pulseLfoGain = ctx.createGain();\n    pulseLfo.frequency.value = 1.2; // ~72 bpm heartbeat\n    pulseLfoGain.gain.value = 0.04;\n    pulseLfo.connect(pulseLfoGain).connect(pulseGain.gain);\n    pulseLfo.start();\n    pulseGain.gain.value = 0.03;\n    pulse.connect(pulseGain).connect(this.bgmGain!);\n    pulse.start();\n    this.bgmOscillators.push(pulse, pulseLfo);\n    this.bgmNodes.push(pulseGain, pulseLfoGain);\n  }\n\n  stopBgm(): void {\n  