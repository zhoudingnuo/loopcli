Main.handle('steam:unlockAchievement', (_event, id: string) => {\n    return unlockAchievement(id);\n  });\n\n  ipcMain.handle('steam:cloudSave', (_event, data: string) => {\n    return saveToCloud(data);\n  });\n\n  ipcMain.handle('steam:cloudLoad', () => {\n    return loadFromCloud();\n  });\n\n  ipcMain.handle('app:version', () => {\n    return app.getVersion();\n  });\n\n  ipcMain.handle('app:quit', () => {\n    app.quit();\n  });\n}\n\n// === App Lifecycle ===\n\napp.whenReady().then(() => {\n  // Initialize Steam\n  initSteam();\n\n  // Setup IPC\n  setupIPC();\n\n  // Create window\n  createWindow();\n\n  app.on('activate', () => {\n    if (mainWindow === null) {\n      createWindow();\n    }\n  });\n});\n\napp.on('window-all-closed', () => {\n  shutdownSteam();\n  if (process.platform !== 'darwin') {\n    app.quit();\n  }\n});\n\napp.on('before-quit', () => {\n  shutdownSteam();\n});\n","structuredPatch":[{"oldStart":1,"oldLines":24,"newStart":1,"newLines":72,"lines":["-// Electron main process entry point","+// Electron main process entry point (v0.5.0 — M5: Steam + UI polish + packaging)"," ","-import { app, BrowserWindow } from 'electron';","+import { app, BrowserWindow, ipcMain, screen } from 'electron';"," import * as path from 'path';","+import * as fs from 'fs';","+import { initSteam, isSteamRunning, unlockAchievement, saveToCloud, loadFromCloud, shutdownSteam } from './SteamIntegration';"," "," let mainWindow: BrowserWindow | null = null;"," ","+const SETTINGS_PATH = path.join(app.getPath('userData'), 'settings.json');","+","+interface AppSettings {","+  masterVolume: number;","+  sfxVolume: number;","+  musicVolume: number;","+  resolution: { width: number; height: number };","+  fullscreen: boolean;","+  language: string;","+  autoSaveInterval: number;","+  showFPS: boolean;","+  particleQuality: string;","+}","+","+function loadAppSettings(): AppSettings {","+  try {","+    if (fs.existsSync(SETTINGS_PATH)) {","+      return JSON.parse(fs.readFile