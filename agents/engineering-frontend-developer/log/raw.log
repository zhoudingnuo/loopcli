-      const now = performance.now();","-      const fps = Math.round(frameCount * 1000 / (now - fpsTime));","-      fpsDisplay.textContent = `FPS: ${fps}`;","-      frameCount = 0;","-      fpsTime = now;","+    const particles = Array.from({ length: 40 }, () => ({","+      x: Math.random() * loadCanvas.width,","+      y: Math.random() * loadCanvas.height,","+      vx: (Math.random() - 0.5) * 0.3,","+      vy: -Math.random() * 0.5 - 0.2,","+      size: Math.random() * 2 + 0.5,","+      alpha: Math.random() * 0.5 + 0.1,","+    }));"," ","-      const secs = Math.floor(app.state.totalPlaytime);","-      const mins = Math.floor(secs / 60);","-      const hrs = Math.floor(mins / 60);","-      playtimeDisplay.textContent = `游玩时间: ${hrs}:${String(mins % 60).padStart(2, '0')}`;","-    }, 1000);","+    let loadAnimId: number;","+    function animateLoading() {","+      loadCtx.clearRect(0, 0, loadCanvas.width, loadCanvas.height);","+      for (const p of particles) {","+        p.x += p.vx;","+        p.y += p.vy;","+        if (p.y < -10) { p.y = loadCanvas.height + 10; p.x = Math.random() * loadCanvas.width; }","+        loadCtx.fillStyle = `rgba(255, 215, 0, ${p.alpha})`;","+        loadCtx.beginPath();","+        loadCtx.arc(p.x, p.y, p.size, 0, Math.PI * 2);","+        loadCtx.fill();","+      }","+      loadAnimId = requestAnimationFrame(animateLoading);","+    }","+    animateLoading();"," ","-    const origLoop = app.loop.bind(app);","-    app.loop = (now) => { frameCount++; origLoop(now); };","-    app.start();","+    // Simulate loading progress","+    let loadProgress = 0;","+    const loadMessages = ['正在加载资源...', '初始化灵脉...', '唤醒傀儡...', '点燃丹炉...', '准备就绪'];","+    const loadInterval = setInterval(() => {","+      loadProgress += Math.random() * 15 + 5;","+      if (loadProgress >= 100) loadProgress = 100;","+      loadingFill.style.width = `${loadProgress}%`;","+      loadingText.textContent = loadMessages[Math.min(4, Math.floor(loadProgress / 25))];","+      if 