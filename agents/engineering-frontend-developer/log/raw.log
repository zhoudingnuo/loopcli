{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f85ceb95058445d7b27484f4","type":"tool_result","content":"1\t// DataManager.js — localStorage persistence (W2 extended)\n2\t\n3\tclass DataManager {\n4\t  constructor() {\n5\t    this.STORAGE_KEY = 'idiom_master_save';\n6\t    this.data = this._load();\n7\t  }\n8\t\n9\t  _defaults() {\n10\t    return {\n11\t      levelStars: {},\n12\t      unlockedLevel: 1,\n13\t      coins: 0,\n14\t      soundEnabled: true,\n15\t      collectedIdioms: [],\n16\t      totalScore: 0,\n17\t      gamesPlayed: 0,\n18\t      bestCombo: 0,\n19\t      bestTimedScore: 0,\n20\t      timedGamesPlayed: 0,\n21\t      pkWins: 0,\n22\t      pkGames: 0,\n23\t      pkScore: 0,\n24\t      exp: 0,\n25\t      level: 1,\n26\t      daily: null,\n27\t      characters: null\n28\t    };\n29\t  }\n30\t\n31\t  _load() {\n32\t    try {\n33\t      const raw = localStorage.getItem(this.STORAGE_KEY);\n34\t      if (raw) return { ...this._defaults(), ...JSON.parse(raw) };\n35\t    } catch (e) { /* ignore */ }\n36\t    return this._defaults();\n37\t  }\n38\t\n39\t  save() {\n40\t    try {\n41\t      localStorage.setItem(this.STORAGE_KEY, JSON.stringify(this.data));\n42\t    } catch (e) { /* ignore */ }\n43\t  }\n44\t\n45\t  getLevelStars(id) { return this.data.levelStars[id] || 0; }\n46\t\n47\t  setLevelStars(id, stars) {\n48\t    if (stars > (this.data.levelStars[id] || 0)) {\n49\t      this.data.levelStars[id] = stars;\n50\t    }\n51\t    if (id >= this.data.unlockedLevel) {\n52\t      this.data.unlockedLevel = id + 1;\n53\t    }\n54\t    this.save();\n55\t  }\n56\t\n57\t  get unlockedLevel() { return this.data.unlockedLevel; }\n58\t  get coins() { return this.data.coins; }\n59\t\n60\t  addCoins(n) { this.data.coins += n; this.save(); return this.data.coins; }\n61\t  spendCoins(n) {\n62\t    if (this.data.coins >= n) { this.data.coins -= n; this.save(); return true; }\n63\t    return false;\n64\t  }\n65\t\n66\t  collectIdiom(id) {\n67\t    if