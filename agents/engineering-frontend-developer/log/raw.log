{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_1cabd0c22c03486d8cf95500","type":"tool_result","content":"1\t<!DOCTYPE html>\n2\t<html lang=\"zh-CN\">\n3\t<head>\n4\t  <meta charset=\"UTF-8\">\n5\t  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n6\t  <title>修仙自动化工厂 — Cultivation Factory</title>\n7\t  <style>\n8\t    * { margin: 0; padding: 0; box-sizing: border-box; }\n9\t    body {\n10\t      background: #1a1a2e;\n11\t      color: #e0e0e0;\n12\t      font-family: 'Segoe UI', system-ui, monospace;\n13\t      overflow: hidden;\n14\t      height: 100vh;\n15\t      width: 100vw;\n16\t    }\n17\t    #app { display: flex; flex-direction: column; height: 100vh; }\n18\t\n19\t    /* Toolbar */\n20\t    #toolbar {\n21\t      display: flex; align-items: center; gap: 8px;\n22\t      padding: 6px 12px;\n23\t      background: rgba(0,0,0,0.6);\n24\t      border-bottom: 1px solid rgba(255,255,255,0.1);\n25\t      min-height: 44px; flex-shrink: 0;\n26\t    }\n27\t    #toolbar h1 { font-size: 16px; color: #ffd700; margin-right: 12px; white-space: nowrap; }\n28\t    #toolbar .spacer { flex: 1; }\n29\t    .toolbar-btn {\n30\t      background: rgba(255,255,255,0.08);\n31\t      border: 1px solid rgba(255,255,255,0.15);\n32\t      color: #e0e0e0; padding: 4px 12px; border-radius: 4px;\n33\t      cursor: pointer; font-size: 12px; transition: background 0.2s;\n34\t    }\n35\t    .toolbar-btn:hover { background: rgba(255,255,255,0.15); }\n36\t    .toolbar-btn.active { background: rgba(100,200,100,0.3); border-color: #6c6; }\n37\t\n38\t    /* Main layout */\n39\t    #main { display: flex; flex: 1; overflow: hidden; }\n40\t\n41\t    /* Sidebar */\n42\t    #sidebar {\n43\t      width: 220px;\n44\t      background: rgba(0,0,0,0.5);\n45\t      border-right: 1px solid rgba(255,255,255,0.1);\n46\t      overflow-y: auto; flex-shrink: 0;\n47\t      display: flex; flex-direction: column;\n48\t    }\n49\t    .sidebar-section {\n50\t      padding: 8px;\n51\t      border-bottom: 1px solid rgba(255,255,255,0.05);\n52\t    }\n53\t    .sidebar-section h3 {\n54\t      font-size: 12px; color: #aaa;\n55\t      margin-bottom: 6px; text-transform: uppercase;\n56\t    }\n57\t    .building-item {\n58\t      display: flex; align-items: center; gap: 8px;\n59\t      padding: 6px 8px; margin: 2px 0; border-radius: 4px;\n60\t      cursor: pointer; transition: background 0.2s; font-size: 12px;\n61\t    }\n62\t    .building-item:hover { background: rgba(255,255,255,0.1); }\n63\t    .building-item.selected { background: rgba(100,200,100,0.2); border: 1px solid rgba(100,200,100,0.4); }\n64\t    .building-item .icon { font-size: 18px; }\n65\t    .building-item .info { flex: 1; }\n66\t    .building-item .name { color: #e0e0e0; }\n67\t    .building-item .cost { color: #888; font-size: 10px; }\n68\t    .building-item .cost.cannot { color: #c44; }\n69\t\n70\t    /* Canvas */\n71\t    #canvas-container { flex: 1; position: relative; }\n72\t    #gameCanvas { display: block; width: 100%; height: 100%; }\n73\t\n74\t    /* Info panel */\n75\t    #info-panel {\n76\t      width: 240px;\n77\t      background: rgba(0,0,0,0.5);\n78\t      border-left: 1px solid rgba(255,255,255,0.1);\n79\t      overflow-y: auto; flex-shrink: 0; padding: 8px;\n80\t      display: flex; flex-direction: column; gap: 8px;\n81\t    }\n82\t    #info-panel h3 { font-size: 12px; color: #aaa; margin-bottom: 4px; }\n83\t    .info-entry { font-size: 11px; padding: 3px 0; color: #ccc; }\n84\t\n85\t    /* Realm panel */\n86\t    .realm-panel {\n87\t      background: rgba(255,215,0,0.05);\n88\t      border: 1px solid rgba(255,215,0,0.2);\n89\t      border-radius: 6px; padding: 8px;\n90\t    }\n91\t    .realm-panel .realm-name {\n92\t      color: #ffd700; font-weight: bold; font-size: 14px;\n93\t    }\n94\t    .realm-panel .realm-exp-bar {\n95\t      background: rgba(255,255,255,0.1);\n96\t      border-radius: 3px; height: 14px;\n97\t      margin: 4px 0; position: relative; overflow: hidden;\n98\t    }\n99\t    .realm-panel .realm-exp-fill {\n100\t      background: linear-gradient(90deg, #ffd700, #ffaa00);\n101\t      height: 100%; border-radius: 3px; transition: width 0.3s;\n102\t    }\n103\t    .realm-panel .realm-exp-text {\n104\t      position: absolute; top: 0; left: 50%; transform: translateX(-50%);\n105\t      font-size: 9px; color: #fff; line-height: 14px;\n106\t    }\n107\t    .breakthrough-btn {\n108\t      background: linear-gradient(135deg, #ffd700, #ff8c00);\n109\t      border: none; color: #1a1a2e; font-weight: bold;\n110\t      padding: 6px 12px; border-radius: 4px; cursor: pointer;\n111\t      font-size: 12px; width: 100%; margin-top: 4px;\n112\t      transition: opacity 0.2s;\n113\t    }\n114\t    .breakthrough-btn:hover { opacity: 0.9; }\n115\t    .breakthrough-btn:disabled {\n116\t      background: rgba(255,255,255,0.1); color: #666;\n117\t      cursor: not-allowed;\n118\t    }\n119\t    .breakthrough-req {\n120\t      font-size: 10px; color: #888; padding: 2px 0;\n121\t    }\n122\t    .breakthrough-req.met { color: #6c6; }\n123\t    .breakthrough-req.unmet { color: #c44; }\n124\t\n125\t    /* Inventory panel */\n126\t    .inventory-panel {\n127\t      background: rgba(255,255,255,0.03);\n128\t      border: 1px solid rgba(255,255,255,0.1);\n129\t      border-radius: 6px; padding: 8px;\n130\t    }\n131\t    .pill-item {\n132\t      display: flex; align-items: center; gap: 6px;\n133\t      padding: 4px 0; font-size: 11px;\n134\t    }\n135\t    .pill-item .pill-name { flex: 1; }\n136\t    .pill-item .pill-count { color: #aaa; }\n137\t    .pill-use-btn {\n138\t      background: rgba(100,200,100,0.2);\n139\t      border: 1px solid rgba(100,200,100,0.3);\n140\t      color: #6c6; padding: 2px 8px; border-radius: 3px;\n141\t      cursor: pointer; font-size: 10px;\n142\t    }\n143\t    .pill-use-btn:hover { background: rgba(100,200,100,0.3); }\n144\t    .pill-use-all-btn {\n145\t      background: rgba(255,200,50,0.2);\n146\t      border: 1px solid rgba(255,200,50,0.3);\n147\t      color: #ffd700; padding: 2px 6px; border-radius: 3px;\n148\t      cursor: pointer; font-size: 10px;\n149\t    }\n150\t\n151\t    /* Alchemy panel */\n152\t    .alchemy-panel {\n153\t      background: rgba(255,140,50,0.05);\n154\t      border: 1px solid rgba(255,140,50,0.2);\n155\t      border-radius: 6px; padding: 8px;\n156\t    }\n157\t    .recipe-item {\n158\t      display: flex; align-items: center; gap: 6px;\n159\t      padding: 4px 0; font-size: 11px;\n160\t    }\n161\t    .recipe-item .recipe-name { flex: 1; }\n162\t    .recipe-craft-btn {\n163\t      background: rgba(255,140,50,0.2);\n164\t      border: 1px solid rgba(255,140,50,0.3);\n165\t      color: #ff8c32; padding: 2px 8px; border-radius: 3px;\n166\t      cursor: pointer; font-size: 10px;\n167\t    }\n168\t    .recipe-craft-btn:hover { background: rgba(255,140,50,0.3); }\n169\t    .recipe-craft-btn:disabled { opacity: 0.4; cursor: not-allowed; }\n170\t    .alchemy-progress {\n171\t      background: rgba(255,255,255,0.1);\n172\t      border-radius: 3px; height: 12px;\n173\t      margin: 4px 0; position: relative; overflow: hidden;\n174\t    }\n175\t    .alchemy-progress-fill {\n176\t      background: linear-gradient(90deg, #ff8c32, #ffaa00);\n177\t      height: 100%; border-radius: 3px; transition: width 0.3s;\n178\t    }\n179\t    .alchemy-progress-text {\n180\t      position: absolute; top: 0; left: 50%; transform: translateX(-50%);\n181\t      font-size: 9px; color: #fff; line-height: 12px;\n182\t    }\n183\t    .alchemy-collect-btn {\n184\t      background: linear-gradient(135deg, #ff8c32, #ffaa00);\n185\t      border: none; color: #1a1a2e; font-weight: bold;\n186\t      padding: 4px 12px; border-radius: 3px; cursor: pointer;\n187\t      font-size: 11px; width: 100%;\n188\t    }\n189\t\n190\t    /* Notifications */\n191\t    #notifications {\n192\t      position: absolute; top: 56px; right: 12px;\n193\t      display: flex; flex-direction: column; gap: 4px;\n194\t      pointer-events: none; z-index: 10;\n195\t    }\n196\t    .notif {\n197\t      padding: 6px 12px; border-radius: 4px;\n198\t      font-size: 11px; opacity: 0; transition: opacity 0.3s;\n199\t      pointer-events: auto;\n200\t    }\n201\t    .notif.show { opacity: 1; }\n202\t    .notif.info { background: rgba(100,100,255,0.3); border: 1px solid rgba(100,100,255,0.5); }\n203\t    .notif.success { background: rgba(100,200,100,0.3); border: 1px solid rgba(100,200,100,0.5); }\n204\t    .notif.warning { background: rgba(255,200,50,0.3); border: 1px solid rgba(255,200,50,0.5); }\n205\t    .notif.error { background: rgba(200,100,100,0.3); border: 1px solid rgba(200,100,100,0.5); }\n206\t\n207\t    /* Status bar */\n208\t    #statusbar {\n209\t      display: flex; align-items: center; gap: 12px;\n210\t      padding: 4px 12px;\n211\t      background: rgba(0,0,0,0.6);\n212\t      border-top: 1px solid rgba(255,255,255,0.1);\n213\t      font-size: 11px; color: #888;\n214\t      min-height: 28px; flex-shrink: 0;\n215\t    }\n216\t    #statusbar .fps { color: #6a6; }\n217\t\n218\t    #placement-hint {\n219\t      position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%);\n220\t      background: rgba(0,0,0,0.8); color: #ffd700;\n221\t      padding: 6px 16px; border-radius: 4px; font-size: 12px;\n222\t      pointer-events: none; display: none;\n223\t    }\n224\t\n225\t    /* Region navigation */\n226\t    .region-nav {\n227\t      display: flex; flex-wrap: wrap; gap: 4px; padding: 4px 0;\n228\t    }\n229\t    .region-btn {\n230\t      background: rgba(255,255,255,0.05);\n231\t      border: 1px solid rgba(255,255,255,0.1);\n232\t      color: #aaa; padding: 3px 8px; border-radius: 3px;\n233\t      cursor: pointer; font-size: 10px; transition: all 0.2s;\n234\t    }\n235\t    .region-btn:hover { background: rgba(255,255,255,0.1); }\n236\t    .region-btn.active { background: rgba(100,200,100,0.2); border-color: rgba(100,200,100,0.4); color: #6c6; }\n237\t    .region-btn.locked { opacity: 0.4; cursor: not-allowed; }\n238\t\n239\t    /* Building category tabs */\n240\t    .building-tabs {\n241\t      display: flex; gap: 2px; margin-bottom: 4px;\n242\t    }\n243\t    .building-tab {\n244\t      flex: 1; background: rgba(255,255,255,0.03);\n245\t      border: 1px solid rgba(255,255,255,0.08);\n246\t      color: #666; padding: 3px 0; border-radius: 3px;\n247\t      cursor: pointer; font-size: 9px; text-align: center;\n248\t    }\n249\t    .building-tab.active { background: rgba(255,255,255,0.1); color: #e0e0e0; border-color: rgba(255,255,255,0.2); }\n250\t\n251\t    /* Scrollbar */\n252\t    ::-webkit-scrollbar { width: 6px; }\n253\t    ::-webkit-scrollbar-track { background: transparent; }\n254\t    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 3px; }\n255\t\n256\t    /* Tab buttons for info panel */\n257\t    .tab-bar {\n258\t      display: flex; gap: 4px; margin-bottom: 4px;\n259\t    }\n260\t    .tab-btn {\n261\t      flex: 1; background: rgba(255,255,255,0.05);\n262\t      border: 1px solid rgba(255,255,255,0.1);\n263\t      color: #888; padding: 4px 0; border-radius: 3px;\n264\t      cursor: pointer; font-size: 10px; text-align: center;\n265\t    }\n266\t    .tab-btn.active { background: rgba(255,255,255,0.1); color: #e0e0e0; border-color: rgba(255,255,255,0.3); }\n267\t    .tab-content { display: none; }\n268\t    .tab-content.active { display: block; }\n269\t  </style>\n270\t</head>\n271\t<body>\n272\t  <div id=\"app\">\n273\t    <div id=\"toolbar\">\n274\t      <h1>⛰ 修仙工厂</h1>\n275\t      <div class=\"spacer\"></div>\n276\t      <button class=\"toolbar-btn\" id=\"btn-audio\" title=\"音效开关\">🔊</button>\n277\t      <button class=\"toolbar-btn\" id=\"btn-save\" title=\"保存游戏\">💾 保存</button>\n278\t      <button class=\"toolbar-btn\" id=\"btn-center\" title=\"居中视角\">◎ 居中</button>\n279\t      <button class=\"toolbar-btn\" id=\"btn-reset\" title=\"重置游戏\">⚠ 重置</button>\n280\t    </div>\n281\t    <div id=\"main\">\n282\t      <div id=\"sidebar\">\n283\t        <div class=\"sidebar-section\">\n284\t          <h3>🗺 区域</h3>\n285\t          <div id=\"region-list\" class=\"region-nav\"></div>\n286\t        </div>\n287\t        <div class=\"sidebar-section\">\n288\t          <h3>🏗 建筑设施</h3>\n289\t          <div class=\"building-tabs\" id=\"building-tabs\">\n290\t            <button class=\"building-tab active\" data-cat=\"all\">全部</button>\n291\t            <button class=\"building-tab\" data-cat=\"mining\">⛏ 矿</button>\n292\t            <button class=\"building-tab\" data-cat=\"farming\">🌿 田</button>\n293\t            <button class=\"building-tab\" data-cat=\"alchemy\">🔥 炉</button>\n294\t            <button class=\"building-tab\" data-cat=\"transport\">➡ 道</button>\n295\t            <button class=\"building-tab\" data-cat=\"automation\">🤖 傀</button>\n296\t          </div>\n297\t          <div id=\"building-list\"></div>\n298\t        </div>\n299\t        <div class=\"sidebar-section\">\n300\t          <h3>🔬 炼丹配方</h3>\n301\t          <div id=\"recipe-list\"></div>\n302\t        </div>\n303\t      </div>\n304\t      <div id=\"canvas-container\">\n305\t        <canvas id=\"gameCanvas\"></canvas>\n306\t        <div id=\"placement-hint\">点击地图放置建筑 | ESC 取消</div>\n307\t        <div id=\"notifications\"></div>\n308\t      </div>\n309\t      <div id=\"info-panel\">\n310\t        <!-- Realm panel -->\n311\t        <div class=\"realm-panel\" id=\"realm-panel\">\n312\t          <div class=\"realm-name\" id=\"realm-name\">凡人</div>\n313\t          <div class=\"realm-exp-bar\">\n314\t            <div class=\"realm-exp-fill\" id=\"realm-exp-fill\" style=\"width:0%\"></div>\n315\t            <div class=\"realm-exp-text\" id=\"realm-exp-text\">0%</div>\n316\t          </div>\n317\t          <div id=\"breakthrough-reqs\"></div>\n318\t          <button class=\"breakthrough-btn\" id=\"btn-breakthrough\" disabled>境界突破</button>\n319\t        </div>\n320\t\n321\t        <!-- Tab bar -->\n322\t        <div class=\"tab-bar\">\n323\t          <button class=\"tab-btn active\" data-tab=\"inventory\">🎒 丹药</button>\n324\t          <button class=\"tab-btn\" data-tab=\"info\">📊 信息</button>\n325\t          <button class=\"tab-btn\" data-tab=\"alchemy\">🔥 炼丹</button>\n326\t        </div>\n327\t\n328\t        <!-- Inventory tab -->\n329\t        <div class=\"tab-content active\" id=\"tab-inventory\">\n330\t          <div class=\"inventory-panel\">\n331\t            <h3>💊 丹药背包</h3>\n332\t            <div id=\"pill-list\"><div class=\"info-entry\">暂无丹药</div></div>\n333\t          </div>\n334\t        </div>\n335\t\n336\t        <!-- Info tab -->\n337\t        <div class=\"tab-content\" id=\"tab-info\">\n338\t          <div id=\"building-info\"><div class=\"info-entry\">点击建筑查看详情</div></div>\n339\t        </div>\n340\t\n341\t        <!-- Alchemy tab -->\n342\t        <div class=\"tab-content\" id=\"tab-alchemy\">\n343\t          <div class=\"alchemy-panel\">\n344\t            <h3>🔥 炼丹进度</h3>\n345\t            <div id=\"alchemy-status\">\n346\t              <div class=\"info-entry\">选择配方开始炼丹</div>\n347\t            </div>\n348\t          </div>\n349\t        </div>\n350\t      </div>\n351\t    </div>\n352\t    <div id=\"statusbar\">\n353\t      <span class=\"fps\" id=\"fps-display\">FPS: --</span>\n354\t      <span id=\"status-text\">就绪</span>\n355\t      <div class=\"spacer\"></div>\n356\t      <span id=\"playtime\">游玩时间: 0:00</span>\n357\t    </div>\n358\t  </div>\n359\t\n360\t  <script type=\"module\">\n361\t    import { App } from './src/renderer/App.ts';\n362\t\n363\t    const canvas = document.getElementById('gameCanvas');\n364\t    const app = new App(canvas);\n365\t    app.centerCamera();\n366\t\n367\t    // FPS counter\n368\t    let frameCount = 0;\n369\t    let fpsTime = performance.now();\n370\t    const fpsDisplay = document.getElementById('fps-display');\n371\t    const statusText = document.getElementById('status-text');\n372\t    const playtimeDisplay = document.getElementById('playtime');\n373\t\n374\t    setInterval(() => {\n375\t      const now = performance.now();\n376\t      const fps = Math.round(frameCount * 1000 / (now - fpsTime));\n377\t      fpsDisplay.textContent = `FPS: ${fps}`;\n378\t      frameCount = 0;\n379\t      fpsTime = now;\n380\t\n381\t      const secs = Math.floor(app.state.totalPlaytime);\n382\t      const mins = Math.floor(secs / 60);\n383\t      const hrs = Math.floor(mins / 60);\n384\t      playtimeDisplay.textContent = `游玩时间: ${hrs}:${String(mins % 60).padStart(2, '0')}`;\n385\t    }, 1000);\n386\t\n387\t    const origLoop = app.loop.bind(app);\n388\t    app.loop = (now) => { frameCount++; origLoop(now); };\n389\t    app.start();\n390\t\n391\t    // === Notifications ===\n392\t    const notifContainer = document.getElementById('notifications');\n393\t    app.onNotification = (notif) => {\n394\t      const el = document.createElement('div');\n395\t      el.className = `notif ${notif.type}`;\n396\t      el.textContent = notif.text;\n397\t      notifContainer.appendChild(el);\n398\t      requestAnimationFrame(() => el.classList.add('show'));\n399\t      setTimeout(() => {\n400\t        el.classList.remove('show');\n401\t        setTimeout(() => el.remove(), 300);\n402\t      }, 3000);\n403\t    };\n404\t\n405\t    // === Tabs ===\n406\t    document.querySelectorAll('.tab-btn').forEach(btn => {\n407\t      btn.addEventListener('click', () => {\n408\t        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\n409\t        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));\n410\t        btn.classList.add('active');\n411\t        document.getElementById(`tab-${btn.dataset.tab}`).classList.add('active');\n412\t      });\n413\t    });\n414\t\n415\t    // === Building sidebar ===\n416\t    const buildingList = document.getElementById('building-list');\n417\t    const placementHint = document.getElementById('placement-hint');\n418\t\n419\t    function renderBuildingList() {\n420\t      buildingList.innerHTML = '';\n421\t      let available = app.getAvailableBuildings();\n422\t      if (buildingCategoryFilter !== 'all') {\n423\t        available = available.filter(d => d.category === buildingCategoryFilter);\n424\t      }\n425\t      for (const def of available) {\n426\t        const item = document.createElement('div');\n427\t        item.className = 'building-item';\n428\t        if (app.placementMode?.id === def.id) item.classList.add('selected');\n429\t\n430\t        const affordable = !Object.keys(def.cost).length ||\n431\t          Object.entries(def.cost).every(([r, c]) => (app.state.resources[r] ?? 0) >= c);\n432\t\n433\t        const icon = getIcon(def.category);\n434\t        const costStr = Object.entries(def.cost).length > 0\n435\t          ? Object.entries(def.cost).map(([r, c]) => `${getResourceName(r)}:${c}`).join(' ')\n436\t          : '免费';\n437\t\n438\t        item.innerHTML = `\n439\t          <span class=\"icon\">${icon}</span>\n440\t          <div class=\"info\">\n441\t            <div class=\"name\">${def.name}</div>\n442\t            <div class=\"cost ${affordable ? '' : 'cannot'}\">${costStr}</div>\n443\t          </div>\n444\t        `;\n445\t\n446\t        item.addEventListener('click', () => {\n447\t          if (app.placementMode?.id === def.id) {\n448\t            app.placementMode = null;\n449\t            placementHint.style.display = 'none';\n450\t            statusText.textContent = '就绪';\n451\t          } else {\n452\t            app.placementMode = def;\n453\t            placementHint.style.display = 'block';\n454\t            statusText.textContent = `放置模式: ${def.name}`;\n455\t          }\n456\t          renderBuildingList();\n457\t        });\n458\t\n459\t        buildingList.appendChild(item);\n460\t      }\n461\t    }\n462\t\n463\t    function getIcon(category) {\n464\t      const icons = { mining: '⛏', farming: '🌿', alchemy: '🔥', energy: '✨', cultivation: '🧘', transport: '➡', automation: '🤖', control: '📜', processing: '🔩' };\n465\t      return icons[category] || '🏠';\n466\t    }\n467\t\n468\t    function getResourceName(id) {\n469\t      const names = {\n470\t        spirit_stone: '灵石', spirit_grass: '灵草', spirit_energy: '灵气',\n471\t        cultivation: '修为', pill_juling: '聚灵丹', pill_peiyuan: '培元丹',\n472\t        pill_ningqi: '凝气丹', pill_zhuji: '筑基丹', pill_jindanyin: '金丹引',\n473\t        spirit_iron: '灵铁', spirit_wood: '灵木', talisman_paper: '符纸',\n474\t      };\n475\t      return names[id] ?? id;\n476\t    }\n477\t\n478\t    // === Building category filter ===\n479\t    let buildingCategoryFilter = 'all';\n480\t    document.querySelectorAll('#building-tabs .building-tab').forEach(btn => {\n481\t      btn.addEventListener('click', () => {\n482\t        document.querySelectorAll('#building-tab').forEach(b => b.classList.remove('active'));\n483\t        btn.classList.add('active');\n484\t        buildingCategoryFilter = btn.dataset.cat;\n485\t        renderBuildingList();\n486\t      });\n487\t    });\n488\t\n489\t    renderBuildingList();\n490\t\n491\t    // === Region navigation ===\n492\t    function renderRegionList() {\n493\t      const regionList = document.getElementById('region-list');\n494\t      regionList.innerHTML = '';\n495\t      const regions = app.getUnlockedRegions();\n496\t      for (const r of regions) {\n497\t        const btn = document.createElement('button');\n498\t        btn.className = 'region-btn' + (r.index === app.currentRegionIndex ? ' active' : '');\n499\t        btn.textContent = r.name;\n500\t        btn.addEventListener('click', () => {\n501\t          app.switchRegion(r.index);\n502\t          renderRegionList();\n503\t        });\n504\t        regionList.appendChild(btn);\n505\t      }\n506\t      // Show locked regions\n507\t      const allRegions = [\n508\t        { name: '炼气坪', unlock: 'liqi_1' },\n509\t        { name: '灵田区', unlock: 'liqi_5' },\n510\t        { name: '灵石矿区', unlock: 'liqi_8' },\n511\t        { name: '筑基台', unlock: 'zhuji_1' },\n512\t        { name: '药王谷', unlock: 'zhuji_10' },\n513\t        { name: '丹鼎峰', unlock: 'jindan_1' },\n514\t        { name: '矿脉山', unlock: 'jindan_5' },\n515\t      ];\n516\t      const unlockedNames = new Set(regions.map(r => r.name));\n517\t      for (const ar of allRegions) {\n518\t        if (!unlockedNames.has(ar.name)) {\n519\t          const btn = document.createElement('button');\n520\t          btn.className = 'region-btn locked';\n521\t          btn.textContent = `🔒 ${ar.name}`;\n522\t          btn.title = `需要达到 ${ar.unlock.replace('_', ' Lv')} 解锁`;\n523\t          regionList.appendChild(btn);\n524\t        }\n525\t      }\n526\t    }\n527\t\n528\t    renderRegionList();\n529\t    app.onRegionChange = () => { renderRegionList(); };\n530\t\n531\t    // === Recipe sidebar ===\n532\t    function renderRecipeList() {\n533\t      const recipeList = document.getElementById('recipe-list');\n534\t      recipeList.innerHTML = '';\n535\t      const recipes = app.getAvailableAlchemyRecipes();\n536\t      for (const recipe of recipes) {\n537\t        const item = document.createElement('div');\n538\t        item.className = 'recipe-item';\n539\t\n540\t        const ingredients = Object.entries(recipe.ingredients)\n541\t          .map(([r, c]) => `${getResourceName(r)}:${c}`).join(' ');\n542\t        const canCraftNow = app.state.alchemySession === null &&\n543\t          Object.entries(recipe.ingredients).every(([r, c]) => (app.state.resources[r] ?? 0) >= c);\n544\t\n545\t        item.innerHTML = `\n546\t          <span style=\"color:${recipe.output.resource === 'pill_juling' ? '#ff8c32' : recipe.output.resource === 'pill_peiyuan' ? '#ff6699' : '#cc66ff'}\">💊</span>\n547\t          <span class=\"recipe-name\">${recipe.name}</span>\n548\t          <button class=\"recipe-craft-btn\" ${canCraftNow ? '' : 'disabled'}>${ingredients}</button>\n549\t        `;\n550\t\n551\t        item.querySelector('.recipe-craft-btn').addEventListener('click', () => {\n552\t          app.startAlchemyAction(recipe.id);\n553\t        });\n554\t\n555\t        recipeList.appendChild(item);\n556\t      }\n557\t    }\n558\t\n559\t    // === Realm panel ===\n560\t    function renderRealmPanel() {\n561\t      const c = app.state.cultivation;\n562\t      const nameEl = document.getElementById('realm-name');\n563\t      const fillEl = document.getElementById('realm-exp-fill');\n564\t      const textEl = document.getElementById('realm-exp-text');\n565\t      const reqsEl = document.getElementById('breakthrough-reqs');\n566\t      const btnEl = document.getElementById('btn-breakthrough');\n567\t\n568\t      // Import getFullRealmName\n569\t      import('./src/game/Cultivation.ts').then(({ getFullRealmName, canBreakthrough, getBreakthroughRequirements, getSubStageName }) => {\n570\t        nameEl.textContent = getFullRealmName(c);\n571\t        const ratio = c.exp / c.expToNext;\n572\t        fillEl.style.width = `${Math.floor(ratio * 100)}%`;\n573\t        textEl.textContent = `${Math.floor(ratio * 100)}%`;\n574\t\n575\t        const reqs = getBreakthroughRequirements(c);\n576\t        reqsEl.innerHTML = '';\n577\t\n578\t        if (reqs.canAttempt || c.level >= 3) {\n579\t          // Show breakthrough requirements\n580\t          for (const [res, amount] of Object.entries(reqs.resourceCost)) {\n581\t            const current = app.state.resources[res] ?? 0;\n582\t            const met = current >= amount;\n583\t            reqsEl.innerHTML += `<div class=\"breakthrough-req ${met ? 'met' : 'unmet'}\">${met ? '✓' : '✗'} ${getResourceName(res)}: ${current}/${amount}</div>`;\n584\t          }\n585\t          if (reqs.needsPill && reqs.pillId) {\n586\t            const current = app.state.resources[reqs.pillId] ?? 0;\n587\t            const met = current >= reqs.pillCount;\n588\t            reqsEl.innerHTML += `<div class=\"breakthrough-req ${met ? 'met' : 'unmet'}\">${met ? '✓' : '✗'} ${getResourceName(reqs.pillId)}: ${current}/${reqs.pillCount}</div>`;\n589\t          }\n590\t          reqsEl.innerHTML += `<div class=\"breakthrough-req\" style=\"color:#aaa\">成功率: ${Math.floor(reqs.successRate * 100)}%</div>`;\n591\t\n592\t          const canAttempt = reqs.canAttempt &&\n593\t            Object.entries(reqs.resourceCost).every(([r, a]) => (app.state.resources[r] ?? 0) >= a) &&\n594\t            (!reqs.needsPill || (app.state.resources[reqs.pillId ?? ''] ?? 0) >= (reqs.pillCount ?? 0));\n595\t\n596\t          btnEl.disabled = !canAttempt;\n597\t        } else {\n598\t          reqsEl.innerHTML = `<div class=\"breakthrough-req\" style=\"color:#888\">修为满级后可突破</div>`;\n599\t          btnEl.disabled = true;\n600\t        }\n601\t      });\n602\t    }\n603\t\n604\t    // === Inventory panel ===\n605\t    function renderInventory() {\n606\t      const pillList = document.getElementById('pill-list');\n607\t      const pills = app.getInventoryPills();\n608\t\n609\t      if (pills.length === 0) {\n610\t        pillList.innerHTML = '<div class=\"info-entry\" style=\"color:#888\">暂无丹药</div>';\n611\t        return;\n612\t      }\n613\t\n614\t      pillList.innerHTML = '';\n615\t      for (const pill of pills) {\n616\t        const item = document.createElement('div');\n617\t        item.className = 'pill-item';\n618\t        item.innerHTML = `\n619\t          <span style=\"color:${pill.color}\">💊</span>\n620\t          <span class=\"pill-name\">${pill.name}</span>\n621\t          <span class=\"pill-count\">×${pill.count}</span>\n622\t          <button class=\"pill-use-btn\" data-id=\"${pill.id}\">服用</button>\n623\t          ${pill.count > 1 ? `<button class=\"pill-use-all-btn\" data-id=\"${pill.id}\">全部</button>` : ''}\n624\t        `;\n625\t        pillList.appendChild(item);\n626\t      }\n627\t\n628\t      // Bind pill use buttons\n629\t      pillList.querySelectorAll('.pill-use-btn').forEach(btn => {\n630\t        btn.addEventListener('click', () => app.usePillAction(btn.dataset.id));\n631\t      });\n632\t      pillList.querySelectorAll('.pill-use-all-btn').forEach(btn => {\n633\t        btn.addEventListener('click', () => app.useAllPills(btn.dataset.id));\n634\t      });\n635\t    }\n636\t\n637\t    // === Alchemy status ===\n638\t    function renderAlchemyStatus() {\n639\t      const statusEl = document.getElementById('alchemy-status');\n640\t      const session = app.state.alchemySession;\n641\t\n642\t      if (!session) {\n643\t        statusEl.innerHTML = '<div class=\"info-entry\">选择配方开始炼丹</div>';\n644\t        return;\n645\t      }\n646\t\n647\t      const progress = Math.floor(session.progress * 100);\n648\t      statusEl.innerHTML = `\n649\t        <div class=\"info-entry\" style=\"color:#ff8c32\">${session.recipeId === 'pill_juling' ? '聚灵丹' : session.recipeId === 'pill_peiyuan' ? '培元丹' : '凝气丹'}</div>\n650\t        <div class=\"alchemy-progress\">\n651\t          <div class=\"alchemy-progress-fill\" style=\"width:${progress}%\"></div>\n652\t          <div class=\"alchemy-progress-text\">${progress}%</div>\n653\t        </div>\n654\t        ${session.complete ? '<button class=\"alchemy-collect-btn\" id=\"btn-collect-alchemy\">收取丹药</button>' : ''}\n655\t      `;\n656\t\n657\t      const collectBtn = document.getElementById('btn-collect-alchemy');\n658\t      if (collectBtn) {\n659\t        collectBtn.addEventListener('click', () => app.collectAlchemyAction());\n660\t      }\n661\t    }\n662\t\n663\t    // === Building info ===\n664\t    function updateBuildingInfo(building) {\n665\t      const infoDiv = document.getElementById('building-info');\n666\t      if (!building) {\n667\t        infoDiv.innerHTML = '<div class=\"info-entry\">点击建筑查看详情</div>';\n668\t        return;\n669\t      }\n670\t      const def = app.buildingDefs.get(building.buildingId);\n671\t      if (!def) return;\n672\t      const prod = def.production;\n673\t      infoDiv.innerHTML = `\n674\t        <div class=\"info-entry\" style=\"color:#ffd700;font-weight:bold\">${def.name}</div>\n675\t        <div class=\"info-entry\">等级: ${building.level}/${def.maxLevel}</div>\n676\t        <div class=\"info-entry\">类型: ${prod.mode === 'manual' ? '手动' : '自动'}</div>\n677\t        <div class=\"info-entry\">产出: ${getResourceName(prod.resource)} ×${prod.amount}</div>\n678\t        ${prod.interval > 0 ? `<div class=\"info-entry\">间隔: ${(prod.interval / 1000).toFixed(1)}s</div>` : ''}\n679\t        ${prod.input ? `<div class=\"info-entry\">消耗: ${Object.entries(prod.input).map(([r,c]) => `${getResourceName(r)}:${c}`).join(' ')}</div>` : ''}\n680\t        <div class=\"info-entry\">状态: ${building.isProducing ? '生产中' : '空闲'}</div>\n681\t        ${building.progress > 0 ? `<div class=\"info-entry\">进度: ${Math.floor(building.progress * 100)}%</div>` : ''}\n682\t      `;\n683\t    }\n684\t\n685\t    // === State change handler ===\n686\t    app.onStateChange = (state) => {\n687\t      renderBuildingList();\n688\t      renderRecipeList();\n689\t      renderRealmPanel();\n690\t      renderInventory();\n691\t      renderAlchemyStatus();\n692\t    };\n693\t\n694\t    app.onBuildingSelect = (building) => {\n695\t      // Switch to info tab\n696\t      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\n697\t      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));\n698\t      document.querySelector('[data-tab=\"info\"]').classList.add('active');\n699\t      document.getElementById('tab-info').classList.add('active');\n700\t      updateBuildingInfo(building);\n701\t    };\n702\t\n703\t    app.onAlchemyUpdate = (session) => {\n704\t      renderAlchemyStatus();\n705\t    };\n706\t\n707\t    // === Breakthrough ===\n708\t    document.getElementById('btn-breakthrough').addEventListener('click', () => {\n709\t      app.attemptBreakthroughAction();\n710\t    });\n711\t\n712\t    // === Toolbar buttons ===\n713\t    document.getElementById('btn-save').addEventListener('click', () => {\n714\t      import('./src/game/GameState.ts').then(({ saveGame }) => {\n715\t        saveGame(app.state);\n716\t        app.addNotification('游戏已保存', 'info');\n717\t      });\n718\t    });\n719\t\n720\t    document.getElementById('btn-center').addEventListener('click', () => {\n721\t      app.centerCamera();\n722\t    });\n723\t\n724\t    document.getElementById('btn-reset').addEventListener('click', () => {\n725\t      if (confirm('确定要重置游戏进度吗？此操作不可撤销！')) {\n726\t        import('./src/game/GameState.ts').then(({ clearSave }) => {\n727\t          clearSave();\n728\t          location.reload();\n729\t        });\n730\t      }\n731\t    });\n732\t\n733\t    // Audio toggle\n734\t    import('./src/game/AudioManager.ts').then(({ audioManager }) => {\n735\t      const audioBtn = document.getElementById('btn-audio');\n736\t      audioBtn.addEventListener('click', () => {\n737\t        audioManager.init();\n738\t        const muted = audioManager.toggleMute();\n739\t        audioBtn.textContent = muted ? '🔇' : '🔊';\n740\t      });\n741\t    });\n742\t\n743\t    // Initial render\n744\t    renderRealmPanel();\n745\t    renderInventory();\n746\t    renderAlchemyStatus();\n747\t    renderRecipeList();\n748\t  </script>\n749\t</body>\n750\t</html>\n751\t"}]},"parent_tool_use_id":null,"session_id":"6abd1a50-ca4f-4f48-ad3d-d0b1dc08d31a","uuid":"ab3ba807-0ac2-4764-bbdf-18c925d75837","timestamp":"2026-05-23T02:34:28.716Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\index.html","content":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>修仙自动化工厂 — Cultivation Factory</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body {\n      background: #1a1a2e;\n      color: #e0e0e0;\n      font-family: 'Segoe UI', system-ui, monospace;\n      overflow: hidden;\n      height: 100vh;\n      width: 100vw;\n    }\n    #app { display: flex; flex-direction: column; height: 100vh; }\n\n    /* Toolbar */\n    #toolbar {\n      display: flex; align-items: center; gap: 8px;\n      padding: 6px 12px;\n      background: rgba(0,0,0,0.6);\n      border-bottom: 1px solid rgba(255,255,255,0.1);\n      min-height: 44px; flex-shrink: 0;\n    }\n    #toolbar h1 { font-size: 16px; color: #ffd700; margin-right: 12px; white-space: nowrap; }\n    #toolbar .spacer { flex: 1; }\n    .toolbar-btn {\n      background: rgba(255,255,255,0.08);\n      border: 1px solid rgba(255,255,255,0.15);\n      color: #e0e0e0; padding: 4px 12px; border-radius: 4px;\n      cursor: pointer; font-size: 12px; transition: background 0.2s;\n    }\n    .toolbar-btn:hover { background: rgba(255,255,255,0.15); }\n    .toolbar-btn.active { background: rgba(100,200,100,0.3); border-color: #6c6; }\n\n    /* Main layout */\n    #main { display: flex; flex: 1; overflow: hidden; }\n\n    /* Sidebar */\n    #sidebar {\n      width: 220px;\n      background: rgba(0,0,0,0.5);\n      border-right: 1px solid rgba(255,255,255,0.1);\n      overflow-y: auto; flex-shrink: 0;\n      display: flex; flex-direction: column;\n    }\n    .sidebar-section {\n      padding: 8px;\n      border-bottom: 1px solid rgba(255,255,255,0.05);\n    }\n    .sidebar-section h3 {\n      font-size: 12px; color: #aaa;\n      margin-bottom: 6px; text-transform: uppercase;\n    }\n    .building-item {\n      display: flex; align-items: center; gap: 8px;\n      padding: 6px 8px; margin: 2px 0; border-radius: 4px;\n      cursor: pointer; transition: background 0.2s; font-size: 12px;\n    }\n    .building-item:hover { background: rgba(255,255,255,0.1); }\n    .building-item.selected { background: rgba(100,200,100,0.2); border: 1px solid rgba(100,200,100,0.4); }\n    .building-item .icon { font-size: 18px; }\n    .building-item .info { flex: 1; }\n    .building-item .name { color: #e0e0e0; }\n    .building-item .cost { color: #888; font-size: 10px; }\n    .building-item .cost.cannot { color: #c44; }\n\n    /* Canvas */\n    #canvas-container { flex: 1; position: relative; }\n    #gameCanvas { display: block; width: 100%; height: 100%; }\n\n    /* Info panel */\n    #info-panel {\n      width: 240px;\n      background: rgba(0,0,0,0.5);\n      border-left: 1px solid rgba(255,255,255,0.1);\n      overflow-y: auto; flex-shrink: 0; padding: 8px;\n      display: flex; flex-direction: column; gap: 8px;\n    }\n    #info-panel h3 { font-size: 12px; color: #aaa; margin-bottom: 4px; }\n    .info-entry { font-size: 11px; padding: 3px 0; color: #ccc; }\n\n    /* Realm panel */\n    .realm-panel {\n      background: rgba(255,215,0,0.05);\n      border: 1px solid rgba(255,215,0,0.2);\n      border-radius: 6px; padding: 8px;\n    }\n    .realm-panel .realm-name {\n      color: #ffd700; font-weight: bold; font-size: 14px;\n    }\n    .realm-panel .realm-exp-bar {\n      background: rgba(255,255,255,0.1);\n      border-radius: 3px; height: 14px;\n      margin: 4px 0; position: relative; overflow: hidden;\n    }\n    .realm-panel .realm-exp-fill {\n      background: linear-gradient(90deg, #ffd700, #ffaa00);\n      height: 100%; border-radius: 3px; transition: width 0.3s;\n    }\n    .realm-panel .realm-exp-text {\n      position: absolute; top: 0; left: 50%; transform: translateX(-50%);\n      font-size: 9px; color: #fff; line-height: 14px;\n    }\n    .breakthrough-btn {\n      background: linear-gradient(135deg, #ffd700, #ff8c00);\n      border: none; color: #1a1a2e; font-weight: bold;\n      padding: 6px 12px; border-radius: 4px; cursor: pointer;\n      font-size: 12px; width: 100%; margin-top: 4px;\n      transition: opacity 0.2s;\n    }\n    .breakthrough-btn:hover { opacity: 0.9; }\n    .breakthrough-btn:disabled {\n      background: rgba(255,255,255,0.1); color: #666;\n      cursor: not-allowed;\n    }\n    .breakthrough-req {\n      font-size: 10px; color: #888; padding: 2px 0;\n    }\n    .breakthrough-req.met { color: #6c6; }\n    .breakthrough-req.unmet { color: #c44; }\n\n    /* Inventory panel */\n    .inventory-panel {\n      background: rgba(255,255,255,0.03);\n      border: 1px solid rgba(255,255,255,0.1);\n      border-radius: 6px; padding: 8px;\n    }\n    .pill-item {\n      display: flex; align-items: center; gap: 6px;\n      padding: 4px 0; font-size: 11px;\n    }\n    .pill-item .pill-name { flex: 1; }\n    .pill-item .pill-count { color: #aaa; }\n    .pill-use-btn {\n      background: rgba(100,200,100,0.2);\n      border: 1px solid rgba(100,200,100,0.3);\n      color: #6c6; padding: 2px 8px; border-radius: 3px;\n      cursor: pointer; font-size: 10px;\n    }\n    .pill-use-btn:hover { background: rgba(100,200,100,0.3); }\n    .pill-use-all-btn {\n      background: rgba(255,200,50,0.2);\n      border: 1px solid rgba(255,200,50,0.3);\n      color: #ffd700; padding: 2px 6px; border-radius: 3px;\n      cursor: pointer; font-size: 10px;\n    }\n\n    /* Alchemy panel */\n    .alchemy-panel {\n      background: rgba(255,140,50,0.05);\n      border: 1px solid rgba(255,140,50,0.2);\n      border-radius: 6px; padding: 8px;\n    }\n    .recipe-item {\n      display: flex; align-items: center; gap: 6px;\n      padding: 4px 0; font-size: 11px;\n    }\n    .recipe-item .recipe-name { flex: 1; }\n    .recipe-craft-btn {\n      background: rgba(255,140,50,0.2);\n      border: 1px solid rgba(255,140,50,0.3);\n      color: #ff8c32; padding: 2px 8px; border-radius: 3px;\n      cursor: pointer; font-size: 10px;\n    }\n    .recipe-craft-btn:hover { background: rgba(255,140,50,0.3); }\n    .recipe-craft-btn:disabled { opacity: 0.4; cursor: not-allowed; }\n    .alchemy-progress {\n      background: rgba(255,255,255,0.1);\n      border-radius: 3px; height: 12px;\n      margin: 4px 0; position: relative; overflow: hidden;\n    }\n    .alchemy-progress-fill {\n      background: linear-gradient(90deg, #ff8c32, #ffaa00);\n      height: 100%; border-radius: 3px; transition: width 0.3s;\n    }\n    .alchemy-progress-text {\n      position: absolute; top: 0; left: 50%; transform: translateX(-50%);\n      font-size: 9px; color: #fff; line-height: 12px;\n    }\n    .alchemy-collect-btn {\n      background: linear-gradient(135deg, #ff8c32, #ffaa00);\n      border: none; color: #1a1a2e; font-weight: bold;\n      padding: 4px 12px; border-radius: 3px; cursor: pointer;\n      font-size: 11px; width: 100%;\n    }\n\n    /* Notifications */\n    #notifications {\n      position: absolute; top: 56px; right: 12px;\n      display: flex; flex-direction: column; gap: 4px;\n      pointer-events: none; z-index: 10;\n    }\n    .notif {\n      padding: 6px 12px; border-radius: 4px;\n      font-size: 11px; opacity: 0; transition: opacity 0.3s;\n      pointer-events: auto;\n    }\n    .notif.show { opacity: 1; }\n    .notif.info { background: rgba(100,100,255,0.3); border: 1px solid rgba(100,100,255,0.5); }\n    .notif.success { background: rgba(100,200,100,0.3); border: 1px solid rgba(100,200,100,0.5); }\n    .notif.warning { background: rgba(255,200,50,0.3); border: 1px solid rgba(255,200,50,0.5); }\n    .notif.error { background: rgba(200,100,100,0.3); border: 1px solid rgba(200,100,100,0.5); }\n\n    /* Status bar */\n    #statusbar {\n      display: flex; align-items: center; gap: 12px;\n      padding: 4px 12px;\n      background: rgba(0,0,0,0.6);\n      border-top: 1px solid rgba(255,255,255,0.1);\n      font-size: 11px; color: #888;\n      min-height: 28px; flex-shrink: 0;\n    }\n    #statusbar .fps { color: #6a6; }\n\n    #placement-hint {\n      position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%);\n      background: rgba(0,0,0,0.8); color: #ffd700;\n      padding: 6px 16px; border-radius: 4px; font-size: 12px;\n      pointer-events: none; display: none;\n    }\n\n    /* Region navigation */\n    .region-nav {\n      display: flex; flex-wrap: wrap; gap: 4px; padding: 4px 0;\n    }\n    .region-btn {\n      background: rgba(255,255,255,0.05);\n      border: 1px solid rgba(255,255,255,0.1);\n      color: #aaa; padding: 3px 8px; border-radius: 3px;\n      cursor: pointer; font-size: 10px; transition: all 0.2s;\n    }\n    .region-btn:hover { background: rgba(255,255,255,0.1); }\n    .region-btn.active { background: rgba(100,200,100,0.2); border-color: rgba(100,200,100,0.4); color: #6c6; }\n    .region-btn.locked { opacity: 0.4; cursor: not-allowed; }\n\n    /* Building category tabs */\n    .building-tabs {\n      display: flex; gap: 2px; margin-bottom: 4px;\n    }\n    .building-tab {\n      flex: 1; background: rgba(255,255,255,0.03);\n      border: 1px solid rgba(255,255,255,0.08);\n      color: #666; padding: 3px 0; border-radius: 3px;\n      cursor: pointer; font-size: 9px; text-align: center;\n    }\n    .building-tab.active { background: rgba(255,255,255,0.1); color: #e0e0e0; border-color: rgba(255,255,255,0.2); }\n\n    /* Scrollbar */\n    ::-webkit-scrollbar { width: 6px; }\n    ::-webkit-scrollbar-track { background: transparent; }\n    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 3px; }\n\n    /* Tab buttons for info panel */\n    .tab-bar {\n      display: flex; gap: 4px; margin-bottom: 4px;\n    }\n    .tab-btn {\n      flex: 1; background: rgba(255,255,255,0.05);\n      border: 1px solid rgba(255,255,255,0.1);\n      color: #888; padding: 4px 0; border-radius: 3px;\n      cursor: pointer; font-size: 10px; text-align: center;\n    }\n    .tab-btn.active { background: rgba(255,255,255,0.1); color: #e0e0e0; border-color: rgba(255,255,255,0.3); }\n    .tab-content { display: none; }\n    .tab-content.active { display: block; }\n  </style>\n</head>\n<body>\n  <div id=\"app\">\n    <div id=\"toolbar\">\n      <h1>⛰ 修仙工厂</h1>\n      <div class=\"spacer\"></div>\n      <button class=\"toolbar-btn\" id=\"btn-audio\" title=\"音效开关\">🔊</button>\n      <button class=\"toolbar-btn\" id=\"btn-save\" title=\"保存游戏\">💾 保存</button>\n      <button class=\"toolbar-btn\" id=\"btn-center\" title=\"居中视角\">◎ 居中</button>\n      <button class=\"toolbar-btn\" id=\"btn-reset\" title=\"重置游戏\">⚠ 重置</button>\n    </div>\n    <div id=\"main\">\n      <div id=\"sidebar\">\n        <div class=\"sidebar-section\">\n          <h3>🗺 区域</h3>\n          <div id=\"region-list\" class=\"region-nav\"></div>\n        </div>\n        <div class=\"sidebar-section\">\n          <h3>🏗 建筑设施</h3>\n          <div class=\"building-tabs\" id=\"building-tabs\">\n            <button class=\"building-tab active\" data-cat=\"all\">全部</button>\n            <button class=\"building-tab\" data-cat=\"mining\">⛏ 矿</button>\n            <button class=\"building-tab\" data-cat=\"farming\">🌿 田</button>\n            <button class=\"building-tab\" data-cat=\"alchemy\">🔥 炉</button>\n            <button class=\"building-tab\" data-cat=\"transport\">➡ 道</button>\n            <button class=\"building-tab\" data-cat=\"automation\">🤖 傀</button>\n          </div>\n          <div id=\"building-list\"></div>\n        </div>\n        <div class=\"sidebar-section\">\n          <h3>🔬 炼丹配方</h3>\n          <div id=\"recipe-list\"></div>\n        </div>\n      </div>\n      <div id=\"canvas-container\">\n        <canvas id=\"gameCanvas\"></canvas>\n        <div id=\"placement-hint\">点击地图放置建筑 | ESC 取消</div>\n        <div id=\"notifications\"></div>\n      </div>\n      <div id=\"info-panel\">\n        <!-- Realm panel -->\n        <div class=\"realm-panel\" id=\"realm-panel\">\n          <div class=\"realm-name\" id=\"realm-name\">凡人</div>\n          <div class=\"realm-exp-bar\">\n            <div class=\"realm-exp-fill\" id=\"realm-exp-fill\" style=\"width:0%\"></div>\n            <div class=\"realm-exp-text\" id=\"realm-exp-text\">0%</div>\n          </div>\n          <div id=\"breakthrough-reqs\"></div>\n          <button class=\"breakthrough-btn\" id=\"btn-breakthrough\" disabled>境界突破</button>\n        </div>\n\n        <!-- Tab bar -->\n        <div class=\"tab-bar\">\n          <button class=\"tab-btn active\" data-tab=\"inventory\">🎒 丹药</button>\n          <button class=\"tab-btn\" data-tab=\"info\">📊 信息</button>\n          <button class=\"tab-btn\" data-tab=\"alchemy\">🔥 炼丹</button>\n        </div>\n\n        <!-- Inventory tab -->\n        <div class=\"tab-content active\" id=\"tab-inventory\">\n          <div class=\"inventory-panel\">\n            <h3>💊 丹药背包</h3>\n            <div id=\"pill-list\"><div class=\"info-entry\">暂无丹药</div></div>\n          </div>\n        </div>\n\n        <!-- Info tab -->\n        <div class=\"tab-content\" id=\"tab-info\">\n          <div id=\"building-info\"><div class=\"info-entry\">点击建筑查看详情</div></div>\n        </div>\n\n        <!-- Alchemy tab -->\n        <div class=\"tab-content\" id=\"tab-alchemy\">\n          <div class=\"alchemy-panel\">\n            <h3>🔥 炼丹进度</h3>\n            <div id=\"alchemy-status\">\n              <div class=\"info-entry\">选择配方开始炼丹</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div id=\"statusbar\">\n      <span class=\"fps\" id=\"fps-display\">FPS: --</span>\n      <span id=\"status-text\">就绪</span>\n      <div class=\"spacer\"></div>\n      <span id=\"playtime\">游玩时间: 0:00</span>\n    </div>\n  </div>\n\n  <script type=\"module\">\n    import { App } from './src/renderer/App.ts';\n\n    const canvas = document.getElementById('gameCanvas');\n    const app = new App(canvas);\n    app.centerCamera();\n\n    // FPS counter\n    let frameCount = 0;\n    let fpsTime = performance.now();\n    const fpsDisplay = document.getElementById('fps-display');\n    const statusText = document.getElementById('status-text');\n    const playtimeDisplay = document.getElementById('playtime');\n\n    setInterval(() => {\n      const now = performance.now();\n      const fps = Math.round(frameCount * 1000 / (now - fpsTime));\n      fpsDisplay.textContent = `FPS: ${fps}`;\n      frameCount = 0;\n      fpsTime = now;\n\n      const secs = Math.floor(app.state.totalPlaytime);\n      const mins = Math.floor(secs / 60);\n      const hrs = Math.floor(mins / 60);\n      playtimeDisplay.textContent = `游玩时间: ${hrs}:${String(mins % 60).padStart(2, '0')}`;\n    }, 1000);\n\n    const origLoop = app.loop.bind(app);\n    app.loop = (now) => { frameCount++; origLoop(now); };\n    app.start();\n\n    // === Notifications ===\n    const notifContainer = document.getElementById('notifications');\n    app.onNotification = (notif) => {\n      const el = document.createElement('div');\n      el.className = `notif ${notif.type}`;\n      el.textContent = notif.text;\n      notifContainer.appendChild(el);\n      requestAnimationFrame(() => el.classList.add('show'));\n      setTimeout(() => {\n        el.classList.remove('show');\n        setTimeout(() => el.remove(), 300);\n      }, 3000);\n    };\n\n    // === Tabs ===\n    document.querySelectorAll('.tab-btn').forEach(btn => {\n      btn.addEventListener('click', () => {\n        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\n        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));\n        btn.classList.add('active');\n        document.getElementById(`tab-${btn.dataset.tab}`).classList.add('active');\n      });\n    });\n\n    // === Building sidebar ===\n    const buildingList = document.getElementById('building-list');\n    const placementHint = document.getElementById('placement-hint');\n\n    function renderBuildingList() {\n      buildingList.innerHTML = '';\n      let available = app.getAvailableBuildings();\n      if (buildingCategoryFilter !== 'all') {\n        available = available.filter(d => d.category === buildingCategoryFilter);\n      }\n      for (const def of available) {\n        const item = document.createElement('div');\n        item.className = 'building-item';\n        if (app.placementMode?.id === def.id) item.classList.add('selected');\n\n        const affordable = !Object.keys(def.cost).length ||\n          Object.entries(def.cost).every(([r, c]) => (app.state.resources[r] ?? 0) >= c);\n\n        const icon = getIcon(def.category);\n        const costStr = Object.entries(def.cost).length > 0\n          ? Object.entries(def.cost).map(([r, c]) => `${getResourceName(r)}:${c}`).join(' ')\n          : '免费';\n\n        item.innerHTML = `\n          <span class=\"icon\">${icon}</span>\n          <div class=\"info\">\n            <div class=\"name\">${def.name}</div>\n            <div class=\"cost ${affordable ? '' : 'cannot'}\">${costStr}</div>\n          </div>\n        `;\n\n        item.addEventListener('click', () => {\n          if (app.placementMode?.id === def.id) {\n            app.placementMode = null;\n            placementHint.style.display = 'none';\n            statusText.textContent = '就绪';\n          } else {\n            app.placementMode = def;\n            placementHint.style.display = 'block';\n            statusText.textContent = `放置模式: ${def.name}`;\n          }\n          renderBuildingList();\n        });\n\n        buildingList.appendChild(item);\n      }\n    }\n\n    function getIcon(category) {\n      const icons = { mining: '⛏', farming: '🌿', alchemy: '🔥', energy: '✨', cultivation: '🧘', transport: '➡', automation: '🤖', control: '📜', processing: '🔩' };\n      return icons[category] || '🏠';\n    }\n\n    function getResourceName(id) {\n      const names = {\n        spirit_stone: '灵石', spirit_grass: '灵草', spirit_energy: '灵气',\n        cultivation: '修为', pill_juling: '聚灵丹', pill_peiyuan: '培元丹',\n        pill_ningqi: '凝气丹', pill_zhuji: '筑基丹', pill_jindanyin: '金丹引',\n        spirit_iron: '灵铁', spirit_wood: '灵木', talisman_paper: '符纸',\n      };\n      return names[id] ?? id;\n    }\n\n    // === Building category filter ===\n    let buildingCategoryFilter = 'all';\n    document.querySelectorAll('#building-tabs .building-tab').forEach(btn => {\n      btn.addEventListener('click', () => {\n        document.querySelectorAll('#building-tab').forEach(b => b.classList.remove('active'));\n        btn.classList.add('active');\n        buildingCategoryFilter = btn.dataset.cat;\n        renderBuildingList();\n      });\n    });\n\n    renderBuildingList();\n\n    // === Region navigation ===\n    function renderRegionList() {\n      const regionList = document.getElementById('region-list');\n      regionList.innerHTML = '';\n      const regions = app.getUnlockedRegions();\n      for (const r of regions) {\n        const btn = document.createElement('button');\n        btn.className = 'region-btn' + (r.index === app.currentRegionIndex ? ' active' : '');\n        btn.textContent = r.name;\n        btn.addEventListener('click', () => {\n          app.switchRegion(r.index);\n          renderRegionList();\n        });\n        regionList.appendChild(btn);\n      }\n      // Show locked regions\n      const allRegions = [\n        { name: '炼气坪', unlock: 'liqi_1' },\n        { name: '灵田区', unlock: 'liqi_5' },\n        { name: '灵石矿区', unlock: 'liqi_8' },\n        { name: '筑基台', unlock: 'zhuji_1' },\n        { name: '药王谷', unlock: 'zhuji_10' },\n        { name: '丹鼎峰', unlock: 'jindan_1' },\n        { name: '矿脉山', unlock: 'jindan_5' },\n      ];\n      const unlockedNames = new Set(regions.map(r => r.name));\n      for (const ar of allRegions) {\n        if (!unlockedNames.has(ar.name)) {\n          const btn = document.createElement('button');\n          btn.className = 'region-btn locked';\n          btn.textContent = `🔒 ${ar.name}`;\n          btn.title = `需要达到 ${ar.unlock.replace('_', ' Lv')} 解锁`;\n          regionList.appendChild(btn);\n        }\n      }\n    }\n\n    renderRegionList();\n    app.onRegionChange = () => { renderRegionList(); };\n\n    // === Recipe sidebar ===\n    function renderRecipeList() {\n      const recipeList = document.getElementById('recipe-list');\n      recipeList.innerHTML = '';\n      const recipes = app.getAvailableAlchemyRecipes();\n      for (const recipe of recipes) {\n        const item = document.createElement('div');\n        item.className = 'recipe-item';\n\n        const ingredients = Object.entries(recipe.ingredients)\n          .map(([r, c]) => `${getResourceName(r)}:${c}`).join(' ');\n        const canCraftNow = app.state.alchemySession === null &&\n          Object.entries(recipe.ingredients).every(([r, c]) => (app.state.resources[r] ?? 0) >= c);\n\n        item.innerHTML = `\n          <span style=\"color:${recipe.output.resource === 'pill_juling' ? '#ff8c32' : recipe.output.resource === 'pill_peiyuan' ? '#ff6699' : '#cc66ff'}\">💊</span>\n          <span class=\"recipe-name\">${recipe.name}</span>\n          <button class=\"recipe-craft-btn\" ${canCraftNow ? '' : 'disabled'}>${ingredients}</button>\n        `;\n\n        item.querySelector('.recipe-craft-btn').addEventListener('click', () => {\n          app.startAlchemyAction(recipe.id);\n        });\n\n        recipeList.appendChild(item);\n      }\n    }\n\n    // === Realm panel ===\n    function renderRealmPanel() {\n      const c = app.state.cultivation;\n      const nameEl = document.getElementById('realm-name');\n      const fillEl = document.getElementById('realm-exp-fill');\n      const textEl = document.getElementById('realm-exp-text');\n      const reqsEl = document.getElementById('breakthrough-reqs');\n      const btnEl = document.getElementById('btn-breakthrough');\n\n      // Import getFullRealmName\n      import('./src/game/Cultivation.ts').then(({ getFullRealmName, canBreakthrough, getBreakthroughRequirements, getSubStageName }) => {\n        nameEl.textContent = getFullRealmName(c);\n        const ratio = c.exp / c.expToNext;\n        fillEl.style.width = `${Math.floor(ratio * 100)}%`;\n        textEl.textContent = `${Math.floor(ratio * 100)}%`;\n\n        const reqs = getBreakthroughRequirements(c);\n        reqsEl.innerHTML = '';\n\n        if (reqs.canAttempt || c.level >= 3) {\n          // Show breakthrough requirements\n          for (const [res, amount] of Object.entries(reqs.resourceCost)) {\n            const current = app.state.resources[res] ?? 0;\n            const met = current >= amount;\n            reqsEl.innerHTML += `<div class=\"breakthrough-req ${met ? 'met' : 'unmet'}\">${met ? '✓' : '✗'} ${getResourceName(res)}: ${current}/${amount}</div>`;\n          }\n          if (reqs.needsPill && reqs.pillId) {\n            const current = app.state.resources[reqs.pillId] ?? 0;\n            const met = current >= reqs.pillCount;\n            reqsEl.innerHTML += `<div class=\"breakthrough-req ${met ? 'met' : 'unmet'}\">${met ? '✓' : '✗'} ${getResourceName(reqs.pillId)}: ${current}/${reqs.pillCount}</div>`;\n          }\n          reqsEl.innerHTML += `<div class=\"breakthrough-req\" style=\"color:#aaa\">成功率: ${Math.floor(reqs.successRate * 100)}%</div>`;\n\n          const canAttempt = reqs.canAttempt &&\n            Object.entries(reqs.resourceCost).every(([r, a]) => (app.state.resources[r] ?? 0) >= a) &&\n            (!reqs.needsPill || (app.state.resources[reqs.pillId ?? ''] ?? 0) >= (reqs.pillCount ?? 0));\n\n          btnEl.disabled = !canAttempt;\n        } else {\n          reqsEl.innerHTML = `<div class=\"breakthrough-req\" style=\"color:#888\">修为满级后可突破</div>`;\n          btnEl.disabled = true;\n        }\n      });\n    }\n\n    // === Inventory panel ===\n    function renderInventory() {\n      const pillList = document.getElementById('pill-list');\n      const pills = app.getInventoryPills();\n\n      if (pills.length === 0) {\n        pillList.innerHTML = '<div class=\"info-entry\" style=\"color:#888\">暂无丹药</div>';\n        return;\n      }\n\n      pillList.innerHTML = '';\n      for (const pill of pills) {\n        const item = document.createElement('div');\n        item.className = 'pill-item';\n        item.innerHTML = `\n          <span style=\"color:${pill.color}\">💊</span>\n          <span class=\"pill-name\">${pill.name}</span>\n          <span class=\"pill-count\">×${pill.count}</span>\n          <button class=\"pill-use-btn\" data-id=\"${pill.id}\">服用</button>\n          ${pill.count > 1 ? `<button class=\"pill-use-all-btn\" data-id=\"${pill.id}\">全部</button>` : ''}\n        `;\n        pillList.appendChild(item);\n      }\n\n      // Bind pill use buttons\n      pillList.querySelectorAll('.pill-use-btn').forEach(btn => {\n        btn.addEventListener('click', () => app.usePillAction(btn.dataset.id));\n      });\n      pillList.querySelectorAll('.pill-use-all-btn').forEach(btn => {\n        btn.addEventListener('click', () => app.useAllPills(btn.dataset.id));\n      });\n    }\n\n    // === Alchemy status ===\n    function renderAlchemyStatus() {\n      const statusEl = document.getElementById('alchemy-status');\n      const session = app.state.alchemySession;\n\n      if (!session) {\n        statusEl.innerHTML = '<div class=\"info-entry\">选择配方开始炼丹</div>';\n        return;\n      }\n\n      const progress = Math.floor(session.progress * 100);\n      statusEl.innerHTML = `\n        <div class=\"info-entry\" style=\"color:#ff8c32\">${session.recipeId === 'pill_juling' ? '聚灵丹' : session.recipeId === 'pill_peiyuan' ? '培元丹' : '凝气丹'}</div>\n        <div class=\"alchemy-progress\">\n          <div class=\"alchemy-progress-fill\" style=\"width:${progress}%\"></div>\n          <div class=\"alchemy-progress-text\">${progress}%</div>\n        </div>\n        ${session.complete ? '<button class=\"alchemy-collect-btn\" id=\"btn-collect-alchemy\">收取丹药</button>' : ''}\n      `;\n\n      const collectBtn = document.getElementById('btn-collect-alchemy');\n      if (collectBtn) {\n        collectBtn.addEventListener('click', () => app.collectAlchemyAction());\n      }\n    }\n\n    // === Building info ===\n    function updateBuildingInfo(building) {\n      const infoDiv = document.getElementById('building-info');\n      if (!building) {\n        infoDiv.innerHTML = '<div class=\"info-entry\">点击建筑查看详情</div>';\n        return;\n      }\n      const def = app.buildingDefs.get(building.buildingId);\n      if (!def) return;\n      const prod = def.production;\n      infoDiv.innerHTML = `\n        <div class=\"info-entry\" style=\"color:#ffd700;font-weight:bold\">${def.name}</div>\n        <div class=\"info-entry\">等级: ${building.level}/${def.maxLevel}</div>\n        <div class=\"info-entry\">类型: ${prod.mode === 'manual' ? '手动' : '自动'}</div>\n        <div class=\"info-entry\">产出: ${getResourceName(prod.resource)} ×${prod.amount}</div>\n        ${prod.interval > 0 ? `<div class=\"info-entry\">间隔: ${(prod.interval / 1000).toFixed(1)}s</div>` : ''}\n        ${prod.input ? `<div class=\"info-entry\">消耗: ${Object.entries(prod.input).map(([r,c]) => `${getResourceName(r)}:${c}`).join(' ')}</div>` : ''}\n        <div class=\"info-entry\">状态: ${building.isProducing ? '生产中' : '空闲'}</div>\n        ${building.progress > 0 ? `<div class=\"info-entry\">进度: ${Math.floor(building.progress * 100)}%</div>` : ''}\n      `;\n    }\n\n    // === State change handler ===\n    app.onStateChange = (state) => {\n      renderBuildingList();\n      renderRecipeList();\n      renderRealmPanel();\n      renderInventory();\n      renderAlchemyStatus();\n    };\n\n    app.onBuildingSelect = (building) => {\n      // Switch to info tab\n      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\n      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));\n      document.querySelector('[data-tab=\"info\"]').classList.add('active');\n      document.getElementById('tab-info').classList.add('active');\n      updateBuildingInfo(building);\n    };\n\n    app.onAlchemyUpdate = (session) => {\n      renderAlchemyStatus();\n    };\n\n    // === Breakthrough ===\n    document.getElementById('btn-breakthrough').addEventListener('click', () => {\n      app.attemptBreakthroughAction();\n    });\n\n    // === Toolbar buttons ===\n    document.getElementById('btn-save').addEventListener('click', () => {\n      import('./src/game/GameState.ts').then(({ saveGame }) => {\n        saveGame(app.state);\n        app.addNotification('游戏已保存', 'info');\n      });\n    });\n\n    document.getElementById('btn-center').addEventListener('click', () => {\n      app.centerCamera();\n    });\n\n    document.getElementById('btn-reset').addEventListener('click', () => {\n      if (confirm('确定要重置游戏进度吗？此操作不可撤销！')) {\n        import('./src/game/GameState.ts').then(({ clearSave }) => {\n          clearSave();\n          location.reload();\n        });\n      }\n    });\n\n    // Audio toggle\n    import('./src/game/AudioManager.ts').then(({ audioManager }) => {\n      const audioBtn = document.getElementById('btn-audio');\n      audioBtn.addEventListener('click', () => {\n        audioManager.init();\n        const muted = audioManager.toggleMute();\n        audioBtn.textContent = muted ? '🔇' : '🔊';\n      });\n    });\n\n    // Initial render\n    renderRealmPanel();\n    renderInventory();\n    renderAlchemyStatus();\n    renderRecipeList();\n  </script>\n</body>\n</html>\n","numLines":751,"startLine":1,"totalLines":751}}}
