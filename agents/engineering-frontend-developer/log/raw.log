{"type":"assistant","message":{"id":"msg_20260523084332a3aa5e9846da4b55","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_a7c5a599673641a68d02cd60","name":"Write","input":{"file_path":"D:/game-projects/douyin-idiom/src/js/Analytics.js","content":"// Analytics.js — 成语大闯关数据埋点，15种事件全覆盖\n// 复用三消埋点框架，适配成语游戏场景\n\nconst ANALYTICS_EVENTS = {\n  GAME_START: 'game_start',\n  TUTORIAL_STEP: 'tutorial_step',\n  LEVEL_START: 'level_start',\n  QUESTION_ANSWER: 'question_answer',\n  LEVEL_COMPLETE: 'level_complete',\n  LEVEL_FAIL: 'level_fail',\n  COMBO_HIT: 'combo_hit',\n  HINT_USE: 'hint_use',\n  AD_SHOW: 'ad_show',\n  AD_CLICK: 'ad_click',\n  SHARE: 'share',\n  PK_START: 'pk_start',\n  PK_RESULT: 'pk_result',\n  TIMED_START: 'timed_start',\n  TIMED_END: 'timed_end',\n  COLLECTION_UNLOCK: 'collection_unlock',\n  CHARACTER_USE: 'character_use',\n  DAILY_LOGIN: 'daily_login',\n};\n\nclass Analytics {\n  constructor(dataManager) {\n    this.dm = dataManager;\n    this._initStorage();\n    this.isDouyin = typeof tt !== 'undefined';\n    this.flushInterval = 30000;\n    this.maxQueueSize = 50;\n    this._flushTimer = null;\n  }\n\n  _initStorage() {\n    if (!this.dm.data.analytics) {\n      this.dm.data.analytics = {\n        userId: 'u_' + Math.random().toString(36).slice(2, 10),\n        sessionId: this._genSessionId(),\n        queue: [],\n        totalCount: 0,\n        firstLaunch: Date.now(),\n        lastActive: Date.now(),\n      };\n      this.dm.save();\n    }\n    this.data = this.dm.data.analytics;\n  }\n\n  _genSessionId() {\n    return Date.now().toString(36) + Math.random().toString(36).slice(2, 6);\n  }\n\n  track(eventName, params) {\n    const event = {\n      event: eventName,\n      ts: Date.now(),\n      session: this.data.sessionId,\n      uid: this.data.userId,\n      appId: 'idiom-master',\n      ...(params || {}),\n    };\n    this.data.queue.push(event);\n    this.data.totalCount++;\n    this.data.lastActive = Date.now();\n    if (this.data.queue.length >= this.maxQueueSize) this.flush();\n    else this.dm.save();\n\n    if (!this.isDouyin && typeof console !== 'undefined') {\n      console.debug(`[Analytics] ${eventName}`, params || '');\n    }\n  }\n\n  trackGameStart() {\n    this.track(ANALYTICS_EVENTS.GAME_START, {\n      version: '1.0',\n      platform: this.isDouyin ? 'douyin' : 'web',\n    });\n  }\n\n  trackTutorialStep(stepId, level) {\n    this.track(ANALYTICS_EVENTS.TUTORIAL_STEP, { stepId, level });\n  }\n\n  trackLevelStart(levelNum, config) {\n    this.track(ANALYTICS_EVENTS.LEVEL_START, {\n      level: levelNum,\n      questions: config.questions,\n      difficulty: config.difficulty,\n    });\n  }\n\n  trackQuestionAnswer(correct, timeMs, usedHint, combo) {\n    this.track(ANALYTICS_EVENTS.QUESTION_ANSWER, {\n      correct, timeMs, usedHint, combo,\n    });\n  }\n\n  trackLevelComplete(levelNum, correctCount, totalQuestions, stars, coins, maxCombo) {\n    this.track(ANALYTICS_EVENTS.LEVEL_COMPLETE, {\n      level: levelNum, correctCount, totalQuestions, stars, coins, maxCombo,\n      completionTime: Date.now(),\n    });\n  }\n\n  trackLevelFail(levelNum, correctCount, livesRemaining, failQuestion) {\n    this.track(ANALYTICS_EVENTS.LEVEL_FAIL, {\n      level: levelNum, correctCount, livesRemaining, failQuestion,\n    });\n  }\n\n  trackComboHit(combo, score) {\n    if (combo >= 3) {\n      this.track(ANALYTICS_EVENTS.COMBO_HIT, { combo, score });\n    }\n  }\n\n  trackHintUse(type, cost) {\n    this.track(ANALYTICS_EVENTS.HINT_USE, { type, cost });\n  }\n\n  trackAdShow(placement, completed) {\n    this.track(ANALYTICS_EVENTS.AD_SHOW, {\n      placement, completed,\n      adType: placement === 'interstitial' ? 'interstitial' : 'rewarded',\n    });\n  }\n\n  trackAdClick(placement) {\n    this.track(ANALYTICS_EVENTS.AD_CLICK, { placement });\n  }\n\n  trackShare(type, extra) {\n    this.track(ANALYTICS_EVENTS.SHARE, { type, ...(extra || {}) });\n  }\n\n  trackPKStart() {\n    this.track(ANALYTICS_EVENTS.PK_START);\n  }\n\n  trackPKResult(result, correctCount, timeMs) {\n    this.track(ANALYTICS_EVENTS.PK_RESULT, { result, correctCount, timeMs });\n  }\n\n  trackTimedStart() {\n    this.track(ANALYTICS_EVENTS.TIMED_START);\n  }\n\n  trackTimedEnd(score, correctCount, totalQuestions, maxCombo) {\n    this.track(ANALYTICS_EVENTS.TIMED_END, {\n      score, correctCount, totalQuestions, maxCombo,\n    });\n  }\n\n  trackCollectionUnlock(idiomId, category, totalCollected) {\n    this.track(ANALYTICS_EVENTS.COLLECTION_UNLOCK, {\n      idiomId, category, totalCollected,\n    });\n  }\n\n  trackCharacterUse(characterId) {\n    this.track(ANALYTICS_EVENTS.CHARACTER_USE, { characterId });\n  }\n\n  trackDailyLogin(day, reward) {\n    this.track(ANALYTICS_EVENTS.DAILY_LOGIN, { day, reward });\n  }\n\n  flush() {\n    if (this.data.queue.length === 0) return;\n    const batch = this.data.queue.splice(0, this.maxQueueSize);\n    this.dm.save();\n\n    if (this.isDouyin) {\n      this._uploadToServer(batch);\n    } else if (typeof console !== 'undefined') {\n      console.debug(`[Analytics] Flush ${batch.length} events`, batch);\n    }\n  }\n\n  _uploadToServer(events) {\n    try {\n      const request = tt.request || fetch;\n      if (request) {\n        request({\n          url: 'https://analytics.example.com/events',\n          method: 'POST',\n          data: { events, appId: 'idiom-master' },\n        }).catch(() => {\n          this.data.queue.unshift(...events);\n          this.dm.save();\n        });\n      }\n    } catch (e) { /* analytics never blocks gameplay */ }\n  }\n\n  newSession() {\n    this.data.sessionId = this._genSessionId();\n    this.dm.save();\n  }\n\n  startFlushTimer() {\n    if (this._flushTimer) clearInterval(this._flushTimer);\n    this._flushTimer = setInterval(() => this.flush(), this.flushInterval);\n  }\n\n  stopFlushTimer() {\n    if (this._flushTimer) { clearInterval(this._flushTimer); this._flushTimer = null; }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Analytics, ANALYTICS_EVENTS };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"6be7998d-cc43-4adb-be9f-4939a8437d2d","uuid":"4321be37-bbd5-49da-a113-9058355d1d6f"}
