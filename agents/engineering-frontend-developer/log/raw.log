{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_71af66b132d146c49419f454","type":"tool_result","content":"1\t// Renderer.js — Canvas 2D rendering engine with obstacle, boss, and updated UI support\n2\t\n3\tclass Renderer {\n4\t  constructor(canvas) {\n5\t    this.canvas = canvas;\n6\t    this.ctx = canvas.getContext('2d');\n7\t    this.tileSize = 0;\n8\t    this.boardX = 0;\n9\t    this.boardY = 0;\n10\t    this.particleSystem = null;\n11\t    this.floatingTexts = [];\n12\t    this.resize();\n13\t  }\n14\t\n15\t  resize() {\n16\t    const dpr = window.devicePixelRatio || 1;\n17\t    const w = window.innerWidth;\n18\t    const h = window.innerHeight;\n19\t    this.canvas.width = w * dpr;\n20\t    this.canvas.height = h * dpr;\n21\t    this.canvas.style.width = w + 'px';\n22\t    this.canvas.style.height = h + 'px';\n23\t    this.ctx.scale(dpr, dpr);\n24\t    this.screenW = w;\n25\t    this.screenH = h;\n26\t\n27\t    this.tileSize = Math.floor(Math.min(w * 0.9, (h - 160)) / BOARD_SIZE);\n28\t    this.boardX = (w - this.tileSize * BOARD_SIZE) / 2;\n29\t    this.boardY = 140;\n30\t  }\n31\t\n32\t  getTileCenter(row, col) {\n33\t    return {\n34\t      x: this.boardX + col * this.tileSize + this.tileSize / 2,\n35\t      y: this.boardY + row * this.tileSize + this.tileSize / 2,\n36\t    };\n37\t  }\n38\t\n39\t  clear() {\n40\t    this.ctx.clearRect(0, 0, this.screenW, this.screenH);\n41\t  }\n42\t\n43\t  drawBackground() {\n44\t    const ctx = this.ctx;\n45\t    ctx.fillStyle = '#FFF8E7';\n46\t    ctx.fillRect(0, 0, this.screenW, this.screenH);\n47\t\n48\t    const bw = this.tileSize * BOARD_SIZE;\n49\t    const bh = this.tileSize * BOARD_SIZE;\n50\t    ctx.fillStyle = '#FFFFFFCC';\n51\t    this._roundRect(ctx, this.boardX - 6, this.boardY - 6, bw + 12, bh + 12, 12);\n52\t    ctx.fill();\n53\t\n54\t    ctx.strokeStyle = '#F0E6D6';\n55\t    ctx.lineWidth = 1;\n56\t    for (let i = 0; i <= BOARD_SIZE; i++) {\n57\t      ctx.beginPath();\n58\t      ctx.moveTo(this.boardX + i * this.tileSize, this.boardY);\n59\t      ctx.lineTo(this.boardX + i * this.tileSize, this.boardY + bh);\n60\t      ctx.stroke();\n61\t      ctx.beginPath();\n62\t      ctx.moveTo(this.boardX, this.boardY + i * this.tileSize);\n63\t      ctx.lineTo(this.boardX + bw, this.boardY + i * this.tileSize);\n64\t      ctx.stroke();\n65\t    }\n66\t  }\n67\t\n68\t  drawTile(tile) {\n69\t    if (!tile || tile.color < 0) return;\n70\t    const ctx = this.ctx;\n71\t    const size = this.tileSize - 4;\n72\t    const cx = this.boardX + tile.col * this.tileSize + this.tileSize / 2 + (tile.offsetX || 0);\n73\t    const cy = this.boardY + tile.row * this.tileSize + this.tileSize / 2 + (tile.offsetY || 0);\n74\t    const scale = tile.scale || 1;\n75\t    const alpha = tile.alpha !== undefined ? tile.alpha : 1;\n76\t\n77\t    ctx.save();\n78\t    ctx.translate(cx, cy);\n79\t    ctx.scale(scale, scale);\n80\t    ctx.globalAlpha = alpha;\n81\t\n82\t    const half = size / 2;\n83\t    const color = COLOR_MAP[tile.color];\n84\t    if (!color) { ctx.restore(); return; }\n85\t\n86\t    ctx.fillStyle = color.hex;\n87\t    this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n88\t    ctx.fill();\n89\t\n90\t    ctx.fillStyle = 'rgba(255,255,255,0.25)';\n91\t    this._roundRect(ctx, -half + 3, -half + 3, size - 6, size / 2 - 3, size * 0.15);\n92\t    ctx.fill();\n93\t\n94\t    this._drawFruitIcon(ctx, tile.color, half * 0.55);\n95\t\n96\t    if (tile.special === SPECIAL_STRIPED_H) {\n97\t      this._drawStripes(ctx, size, half, '#FFFFFF80', true);\n98\t    } else if (tile.special === SPECIAL_STRIPED_V) {\n99\t      this._drawStripes(ctx, size, half, '#FFFFFF80', false);\n100\t    } else if (tile.special === SPECIAL_BOMB) {\n101\t      this._drawCrosshair(ctx, half);\n102\t    } else if (tile.special === SPECIAL_RAINBOW) {\n103\t      this._drawRainbowOverlay(ctx, half);\n104\t    }\n105\t\n106\t    if (tile.selected) {\n107\t      ctx.strokeStyle = '#FFFFFF';\n108\t      ctx.lineWidth = 3;\n109\t      ctx.shadowColor = '#FFB800';\n110\t      ctx.shadowBlur = 12;\n111\t      this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n112\t      ctx.stroke();\n113\t      ctx.shadowBlur = 0;\n114\t    }\n115\t\n116\t    ctx.restore();\n117\t  }\n118\t\n119\t  _drawFruitIcon(ctx, colorIdx, radius) {\n120\t    ctx.fillStyle = 'rgba(255,255,255,0.6)';\n121\t    ctx.font = `bold ${radius * 1.4}px sans-serif`;\n122\t    ctx.textAlign = 'center';\n123\t    ctx.textBaseline = 'middle';\n124\t    const icons = ['🍎', '🍌', '🫐', '🍏', '🍇', '🍊'];\n125\t    ctx.fillText(icons[colorIdx] || '', 0, 1);\n126\t  }\n127\t\n128\t  _drawStripes(ctx, size, half, color, horizontal) {\n129\t    ctx.strokeStyle = color;\n130\t    ctx.lineWidth = 2;\n131\t    if (horizontal) {\n132\t      for (let y = -half + 6; y < half; y += 8) {\n133\t        ctx.beginPath();\n134\t        ctx.moveTo(-half + 4, y);\n135\t        ctx.lineTo(half - 4, y);\n136\t        ctx.stroke();\n137\t      }\n138\t    } else {\n139\t      for (let x = -half + 6; x < half; x += 8) {\n140\t        ctx.beginPath();\n141\t        ctx.moveTo(x, -half + 4);\n142\t        ctx.lineTo(x, half - 4);\n143\t        ctx.stroke();\n144\t      }\n145\t    }\n146\t  }\n147\t\n148\t  _drawCrosshair(ctx, half) {\n149\t    ctx.strokeStyle = '#FFFFFF99';\n150\t    ctx.lineWidth = 2;\n151\t    ctx.beginPath();\n152\t    ctx.moveTo(-half * 0.6, 0); ctx.lineTo(half * 0.6, 0);\n153\t    ctx.moveTo(0, -half * 0.6); ctx.lineTo(0, half * 0.6);\n154\t    ctx.stroke();\n155\t    ctx.beginPath();\n156\t    ctx.arc(0, 0, half * 0.4, 0, Math.PI * 2);\n157\t    ctx.stroke();\n158\t  }\n159\t\n160\t  _drawRainbowOverlay(ctx, half) {\n161\t    const gradient = ctx.createLinearGradient(-half, -half, half, half);\n162\t    gradient.addColorStop(0, '#FF000080');\n163\t    gradient.addColorStop(0.17, '#FF880080');\n164\t    gradient.addColorStop(0.33, '#FFFF0080');\n165\t    gradient.addColorStop(0.5, '#00FF0080');\n166\t    gradient.addColorStop(0.67, '#0088FF80');\n167\t    gradient.addColorStop(0.83, '#8800FF80');\n168\t    gradient.addColorStop(1, '#FF008880');\n169\t    ctx.fillStyle = gradient;\n170\t    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.4);\n171\t    ctx.fill();\n172\t  }\n173\t\n174\t  // Draw all obstacles\n175\t  drawObstacles(obstacleMgr) {\n176\t    for (const obs of obstacleMgr.obstacles) {\n177\t      if (obs.isDestroyed()) continue;\n178\t      const shake = obs.shakeTimer > 0 ? (Math.random() - 0.5) * 4 : 0;\n179\t      const pos = this.getTileCenter(obs.row, obs.col);\n180\t      const half = (this.tileSize - 4) / 2;\n181\t\n182\t      this.ctx.save();\n183\t      this.ctx.translate(pos.x + shake, pos.y);\n184\t\n185\t      switch (obs.type) {\n186\t        case OBSTACLE_ICE:\n187\t          this._drawIce(this.ctx, half);\n188\t          break;\n189\t        case OBSTACLE_CHAIN:\n190\t          this._drawChain(this.ctx, half);\n191\t          break;\n192\t        case OBSTACLE_CHOCOLATE:\n193\t          this._drawChocolate(this.ctx, half);\n194\t          break;\n195\t      }\n196\t\n197\t      this.ctx.restore();\n198\t    }\n199\t  }\n200\t\n201\t  _drawIce(ctx, half) {\n202\t    // Translucent blue overlay\n203\t    ctx.fillStyle = 'rgba(135, 206, 250, 0.45)';\n204\t    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.2);\n205\t    ctx.fill();\n206\t    // Ice crack pattern\n207\t    ctx.strokeStyle = 'rgba(255, 255, 255, 0.7)';\n208\t    ctx.lineWidth = 1.5;\n209\t    ctx.beginPath();\n210\t    ctx.moveTo(-half * 0.3, -half * 0.5);\n211\t    ctx.lineTo(half * 0.2, 0);\n212\t    ctx.lineTo(-half * 0.1, half * 0.4);\n213\t    ctx.stroke();\n214\t    ctx.beginPath();\n215\t    ctx.moveTo(half * 0.3, -half * 0.3);\n216\t    ctx.lineTo(0, half * 0.1);\n217\t    ctx.stroke();\n218\t    // Ice label\n219\t    ctx.fillStyle = 'rgba(255,255,255,0.8)';\n220\t    ctx.font = `bold ${half * 0.6}px sans-serif`;\n221\t    ctx.textAlign = 'center';\n222\t    ctx.textBaseline = 'middle';\n223\t    ctx.fillText('❄', 0, 0);\n224\t  }\n225\t\n226\t  _drawChain(ctx, half) {\n227\t    // Chain icon overlay\n228\t    ctx.fillStyle = 'rgba(100, 100, 100, 0.35)';\n229\t    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.2);\n230\t    ctx.fill();\n231\t    // Chain links\n232\t    ctx.strokeStyle = 'rgba(80, 80, 80, 0.9)';\n233\t    ctx.lineWidth = 3;\n234\t    for (let i = -1; i <= 1; i++) {\n235\t      ctx.beginPath();\n236\t      ctx.ellipse(i * half * 0.5, 0, half * 0.25, half * 0.15, 0, 0, Math.PI * 2);\n237\t      ctx.stroke();\n238\t    }\n239\t    // Lock icon\n240\t    ctx.fillStyle = 'rgba(255,255,255,0.7)';\n241\t    ctx.font = `bold ${half * 0.7}px sans-serif`;\n242\t    ctx.textAlign = 'center';\n243\t    ctx.textBaseline = 'middle';\n244\t    ctx.fillText('🔗', 0, -half * 0.6);\n245\t  }\n246\t\n247\t  _drawChocolate(ctx, half) {\n248\t    // Brown blob\n249\t    ctx.fillStyle = '#6B3410';\n250\t    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.3);\n251\t    ctx.fill();\n252\t    // Chocolate drip pattern\n253\t    ctx.fillStyle = '#8B5E3C';\n254\t    this._roundRect(ctx, -half + 3, -half + 3, half * 2 - 6, half * 2 - 6, half * 0.25);\n255\t    ctx.fill();\n256\t    // Shine\n257\t    ctx.fillStyle = 'rgba(255,255,255,0.15)';\n258\t    this._roundRect(ctx, -half + 6, -half + 6, half - 3, half * 0.6, half * 0.15);\n259\t    ctx.fill();\n260\t    // Emoji\n261\t    ctx.font = `bold ${half * 0.8}px sans-serif`;\n262\t    ctx.textAlign = 'center';\n263\t    ctx.textBaseline = 'middle';\n264\t    ctx.fillText('🍫', 0, 0);\n265\t  }\n266\t\n267\t  // Draw boss on board\n268\t  drawBoss(boss, renderer) {\n269\t    const pos = this.getTileCenter(boss.row, boss.col);\n270\t    const half = (this.tileSize - 4) / 2;\n271\t    const shake = boss.shakeTimer > 0 ? (Math.random() - 0.5) * 6 : 0;\n272\t\n273\t    this.ctx.save();\n274\t    this.ctx.translate(pos.x + shake, pos.y);\n275\t\n276\t    // Boss body\n277\t    const isUsingSkill = boss.skillAnimTimer > 0;\n278\t    const pulseScale = isUsingSkill ? 1.1 : 1;\n279\t    this.ctx.scale(pulseScale, pulseScale);\n280\t\n281\t    // Dark aura\n282\t    this.ctx.fillStyle = isUsingSkill ? 'rgba(255,0,0,0.15)' : 'rgba(80,0,80,0.1)';\n283\t    this.ctx.beginPath();\n284\t    this.ctx.arc(0, 0, half * 1.3, 0, Math.PI * 2);\n285\t    this.ctx.fill();\n286\t\n287\t    // Boss face\n288\t    this.ctx.fillStyle = '#4A0E4E';\n289\t    this._roundRect(this.ctx, -half, -half, half * 2, half * 2, half * 0.3);\n290\t    this.ctx.fill();\n291\t\n292\t    // Inner glow\n293\t    const grad = this.ctx.createRadialGradient(0, 0, 0, 0, 0, half);\n294\t    grad.addColorStop(0, 'rgba(255,100,200,0.3)');\n295\t    grad.addColorStop(1, 'rgba(80,0,120,0.1)');\n296\t    this.ctx.fillStyle = grad;\n297\t    this._roundRect(this.ctx, -half, -half, half * 2, half * 2, half * 0.3);\n298\t    this.ctx.fill();\n299\t\n300\t    // Boss emoji\n301\t    this.ctx.font = `bold ${half * 1.2}px sans-serif`;\n302\t    this.ctx.textAlign = 'center';\n303\t    this.ctx.textBaseline = 'middle';\n304\t    const hpRatio = boss.hp / boss.maxHp;\n305\t    const bossEmoji = hpRatio > 0.5 ? '👹' : hpRatio > 0.25 ? '👿' : '💀';\n306\t    this.ctx.fillText(bossEmoji, 0, 0);\n307\t\n308\t    this.ctx.restore();\n309\t  }\n310\t\n311\t  // Draw boss health bar above the board\n312\t  drawBossHealthBar(boss) {\n313\t    const ctx = this.ctx;\n314\t    const barW = Math.min(200, this.screenW - 40);\n315\t    const barH = 14;\n316\t    const barX = (this.screenW - barW) / 2;\n317\t    const barY = this.boardY + this.tileSize * BOARD_SIZE + 50;\n318\t\n319\t    // Background\n320\t    ctx.fillStyle = '#E0D5C5';\n321\t    this._roundRect(ctx, barX, barY, barW, barH, 7);\n322\t    ctx.fill();\n323\t\n324\t    // HP bar\n325\t    const hpRatio = Math.max(0, boss.hp / boss.maxHp);\n326\t    if (hpRatio > 0) {\n327\t      const grad = ctx.createLinearGradient(barX, barY, barX + barW * hpRatio, barY);\n328\t      grad.addColorStop(0, '#FF4D4D');\n329\t      grad.addColorStop(1, '#CC0000');\n330\t      ctx.fillStyle = grad;\n331\t      this._roundRect(ctx, barX, barY, barW * hpRatio, barH, 7);\n332\t      ctx.fill();\n333\t    }\n334\t\n335\t    // Boss name and HP text\n336\t    ctx.fillStyle = '#5D4037';\n337\t    ctx.font = 'bold 12px sans-serif';\n338\t    ctx.textAlign = 'center';\n339\t    ctx.fillText(`${boss.name}  ${boss.hp}/${boss.maxHp}`, this.screenW / 2, barY + barH + 14);\n340\t  }\n341\t\n342\t  // Updated drawUI to support new goal types\n343\t  drawUI(score, moves, config, scoreSystem, level) {\n344\t    const ctx = this.ctx;\n345\t\n346\t    // Top bar background\n347\t    ctx.fillStyle = '#FFB800';\n348\t    this._roundRect(ctx, 8, 8, this.screenW - 16, 55, 12);\n349\t    ctx.fill();\n350\t\n351\t    // Level\n352\t    ctx.fillStyle = '#5D4037';\n353\t    ctx.font = 'bold 18px sans-serif';\n354\t    ctx.textAlign = 'left';\n355\t    ctx.fillText(`第 ${level} 关`, 20, 42);\n356\t\n357\t    // Level name\n358\t    if (config.name) {\n359\t      ctx.font = '12px sans-serif';\n360\t      ctx.fillText(config.name, 20, 22);\n361\t    }\n362\t\n363\t    // Score\n364\t    ctx.textAlign = 'center';\n365\t    ctx.fillStyle = '#FFFFFF';\n366\t    ctx.font = 'bold 20px sans-serif';\n367\t    ctx.fillText(`${score}`, this.screenW / 2, 32);\n368\t    ctx.font = '12px sans-serif';\n369\t    ctx.fillText('分数', this.screenW / 2, 48);\n370\t\n371\t    // Moves\n372\t    ctx.textAlign = 'right';\n373\t    ctx.fillStyle = moves <= 5 ? '#FF4D4D' : '#5D4037';\n374\t    ctx.font = 'bold 22px sans-serif';\n375\t    ctx.fillText(`${moves}`, this.screenW - 20, 32);\n376\t    ctx.font = '12px sans-serif';\n377\t    ctx.fillStyle = '#5D4037';\n378\t    ctx.fillText('剩余步数', this.screenW - 20, 48);\n379\t\n380\t    // Goal progress — use the new goal description\n381\t    const goalDesc = scoreSystem.getGoalDescription();\n382\t    const progressBars = scoreSystem.getProgressForUI();\n383\t\n384\t    const barW = this.screenW - 40;\n385\t    const barH = 16;\n386\t    const barY = 72;\n387\t    const barX = 20;\n388\t\n389\t    // Goal label\n390\t    ctx.fillStyle = '#5D4037';\n391\t    ctx.font = 'bold 11px sans-serif';\n392\t    ctx.textAlign = 'center';\n393\t\n394\t    if (progressBars.length === 1) {\n395\t      // Single goal — progress bar\n396\t      const p = progressBars[0];\n397\t      ctx.fillStyle = '#E0D5C5';\n398\t      this._roundRect(ctx, barX, barY, barW, barH, 8);\n399\t      ctx.fill();\n400\t\n401\t      const progress = Math.min(p.current / p.target, 1);\n402\t      if (progress > 0) {\n403\t        const grad = ctx.createLinearGradient(barX, barY, barX + barW * progress, barY);\n404\t        grad.addColorStop(0, '#6BCB77');\n405\t        grad.addColorStop(1, '#4DA66B');\n406\t        ctx.fillStyle = grad;\n407\t        this._roundRect(ctx, barX, barY, barW * progress, barH, 8);\n408\t        ctx.fill();\n409\t      }\n410\t\n411\t      ctx.fillStyle = '#5D4037';\n412\t      ctx.font = 'bold 11px sans-serif';\n413\t      ctx.fillText(goalDesc, this.screenW / 2, barY + 13);\n414\t    } else {\n415\t      // Dual goal — two smaller bars\n416\t      const halfBarW = (barW - 10) / 2;\n417\t      for (let i = 0; i < progressBars.length; i++) {\n418\t        const p = progressBars[i];\n419\t        const bx = barX + i * (halfBarW + 10);\n420\t\n421\t        ctx.fillStyle = '#E0D5C5';\n422\t        this._roundRect(ctx, bx, barY, halfBarW, barH, 8);\n423\t        ctx.fill();\n424\t\n425\t        const progress = Math.min(p.current / p.target, 1);\n426\t        if (progress > 0) {\n427\t          const grad = ctx.createLinearGradient(bx, barY, bx + halfBarW * progress, barY);\n428\t          grad.addColorStop(0, i === 0 ? '#6BCB77' : '#4DA6FF');\n429\t          grad.addColorStop(1, i === 0 ? '#4DA66B' : '#3388DD');\n430\t          ctx.fillStyle = grad;\n431\t          this._roundRect(ctx, bx, barY, halfBarW * progress, barH, 8);\n432\t          ctx.fill();\n433\t        }\n434\t\n435\t        ctx.fillStyle = '#5D4037';\n436\t        ctx.font = 'bold 10px sans-serif';\n437\t        ctx.fillText(`${p.current}/${p.target}`, bx + halfBarW / 2, barY + 13);\n438\t      }\n439\t    }\n440\t\n441\t    // Bottom hint\n442\t    ctx.fillStyle = '#8D6E63';\n443\t    ctx.font = '14px sans-serif';\n444\t    ctx.textAlign = 'center';\n445\t    const hintY = this.boardY + this.tileSize * BOARD_SIZE + 30;\n446\t    // Don't overlap with boss health bar\n447\t    const hintOffset = scoreSystem.goalType === 'boss' ? 0 : 30;\n448\t    ctx.fillText('滑动交换相邻方块', this.screenW / 2, hintY + hintOffset);\n449\t  }\n450\t\n451\t  drawComboText(text) {\n452\t    if (!text) return;\n453\t    const ctx = this.ctx;\n454\t    ctx.save();\n455\t    ctx.fillStyle = '#FF4D4D';\n456\t    ctx.font = 'bold 36px sans-serif';\n457\t    ctx.textAlign = 'center';\n458\t    ctx.textBaseline = 'middle';\n459\t    ctx.shadowColor = '#FFB800';\n460\t    ctx.shadowBlur = 8;\n461\t    ctx.fillText(text, this.screenW / 2, this.boardY + this.tileSize * BOARD_SIZE / 2);\n462\t    ctx.restore();\n463\t  }\n464\t\n465\t  addFloatingText(text, x, y, color = '#FF4D4D') {\n466\t    this.floatingTexts.push({ text, x, y, alpha: 1, vy: -60, life: 1.0, color });\n467\t  }\n468\t\n469\t  updateAndDrawFloatingTexts(dt) {\n470\t    const ctx = this.ctx;\n471\t    this.floatingTexts = this.floatingTexts.filter(ft => {\n472\t      ft.y += ft.vy * dt;\n473\t      ft.life -= dt;\n474\t      ft.alpha = Math.max(0, ft.life);\n475\t      if (ft.life <= 0) return false;\n476\t\n477\t      ctx.globalAlpha = ft.alpha;\n478\t      ctx.fillStyle = ft.color;\n479\t      ctx.font = 'bold 18px sans-serif';\n480\t      ctx.textAlign = 'center';\n481\t      ctx.fillText(ft.text, ft.x, ft.y);\n482\t      ctx.globalAlpha = 1;\n483\t      return true;\n484\t    });\n485\t  }\n486\t\n487\t  drawResultScreen(won, score, stars, level) {\n488\t    const ctx = this.ctx;\n489\t    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n490\t    ctx.fillRect(0, 0, this.screenW, this.screenH);\n491\t\n492\t    const pw = Math.min(320, this.screenW - 40);\n493\t    const ph = 260;\n494\t    const px = (this.screenW - pw) / 2;\n495\t    const py = (this.screenH - ph) / 2;\n496\t\n497\t    ctx.fillStyle = '#FFF8E7';\n498\t    this._roundRect(ctx, px, py, pw, ph, 16);\n499\t    ctx.fill();\n500\t    ctx.strokeStyle = '#FFB800';\n501\t    ctx.lineWidth = 3;\n502\t    this._roundRect(ctx, px, py, pw, ph, 16);\n503\t    ctx.stroke();\n504\t\n505\t    ctx.fillStyle = '#5D4037';\n506\t    ctx.font = 'bold 24px sans-serif';\n507\t    ctx.textAlign = 'center';\n508\t    ctx.fillText(won ? '🎉 恭喜过关！' : '😢 挑战失败', this.screenW / 2, py + 45);\n509\t\n510\t    ctx.font = 'bold 36px sans-serif';\n511\t    ctx.fillStyle = '#FFB800';\n512\t    ctx.fillText(score, this.screenW / 2, py + 95);\n513\t    ctx.font = '14px sans-serif';\n514\t    ctx.fillStyle = '#8D6E63';\n515\t    ctx.fillText('得分', this.screenW / 2, py + 115);\n516\t\n517\t    if (won) {\n518\t      for (let i = 0; i < 3; i++) {\n519\t        ctx.font = '32px sans-serif';\n520\t        ctx.fillText(i < stars ? '⭐' : '☆', this.screenW / 2 - 45 + i * 45, py + 160);\n521\t      }\n522\t    }\n523\t\n524\t    const btnW = 120, btnH = 42;\n525\t    const btnY = py + ph - 60;\n526\t\n527\t    ctx.fillStyle = '#6BCB77';\n528\t    this._roundRect(ctx, this.screenW / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n529\t    ctx.fill();\n530\t    ctx.fillStyle = '#FFFFFF';\n531\t    ctx.font = 'bold 16px sans-serif';\n532\t    ctx.fillText(won ? '下一关' : '重试', this.screenW / 2 - btnW / 2 - 10, btnY + 27);\n533\t\n534\t    ctx.fillStyle = '#8D6E63';\n535\t    this._roundRect(ctx, this.screenW / 2 + 10, btnY, btnW, btnH, btnH / 2);\n536\t    ctx.fill();\n537\t    ctx.fillStyle = '#FFFFFF';\n538\t    ctx.fillText('菜单', this.screenW / 2 + btnW / 2 + 10, btnY + 27);\n539\t  }\n540\t\n541\t  _roundRect(ctx, x, y, w, h, r) {\n542\t    ctx.beginPath();\n543\t    ctx.moveTo(x + r, y);\n544\t    ctx.lineTo(x + w - r, y);\n545\t    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n546\t    ctx.lineTo(x + w, y + h - r);\n547\t    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n548\t    ctx.lineTo(x + r, y + h);\n549\t    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n550\t    ctx.lineTo(x, y + r);\n551\t    ctx.quadraticCurveTo(x, y, x + r, y);\n552\t    ctx.closePath();\n553\t  }\n554\t}\n555\t\n556\tif (typeof module !== 'undefined') module.exports = { Renderer };\n557\t"}]},"parent_tool_use_id":null,"session_id":"fc99b580-aa14-4899-aa35-a732e530edf6","uuid":"88d34064-1bb1-4095-8bc1-648768ea1189","timestamp":"2026-05-22T21:41:59.485Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\douyin-match3\\src\\js\\Renderer.js","content":"// Renderer.js — Canvas 2D rendering engine with obstacle, boss, and updated UI support\n\nclass Renderer {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d');\n    this.tileSize = 0;\n    this.boardX = 0;\n    this.boardY = 0;\n    this.particleSystem = null;\n    this.floatingTexts = [];\n    this.resize();\n  }\n\n  resize() {\n    const dpr = window.devicePixelRatio || 1;\n    const w = window.innerWidth;\n    const h = window.innerHeight;\n    this.canvas.width = w * dpr;\n    this.canvas.height = h * dpr;\n    this.canvas.style.width = w + 'px';\n    this.canvas.style.height = h + 'px';\n    this.ctx.scale(dpr, dpr);\n    this.screenW = w;\n    this.screenH = h;\n\n    this.tileSize = Math.floor(Math.min(w * 0.9, (h - 160)) / BOARD_SIZE);\n    this.boardX = (w - this.tileSize * BOARD_SIZE) / 2;\n    this.boardY = 140;\n  }\n\n  getTileCenter(row, col) {\n    return {\n      x: this.boardX + col * this.tileSize + this.tileSize / 2,\n      y: this.boardY + row * this.tileSize + this.tileSize / 2,\n    };\n  }\n\n  clear() {\n    this.ctx.clearRect(0, 0, this.screenW, this.screenH);\n  }\n\n  drawBackground() {\n    const ctx = this.ctx;\n    ctx.fillStyle = '#FFF8E7';\n    ctx.fillRect(0, 0, this.screenW, this.screenH);\n\n    const bw = this.tileSize * BOARD_SIZE;\n    const bh = this.tileSize * BOARD_SIZE;\n    ctx.fillStyle = '#FFFFFFCC';\n    this._roundRect(ctx, this.boardX - 6, this.boardY - 6, bw + 12, bh + 12, 12);\n    ctx.fill();\n\n    ctx.strokeStyle = '#F0E6D6';\n    ctx.lineWidth = 1;\n    for (let i = 0; i <= BOARD_SIZE; i++) {\n      ctx.beginPath();\n      ctx.moveTo(this.boardX + i * this.tileSize, this.boardY);\n      ctx.lineTo(this.boardX + i * this.tileSize, this.boardY + bh);\n      ctx.stroke();\n      ctx.beginPath();\n      ctx.moveTo(this.boardX, this.boardY + i * this.tileSize);\n      ctx.lineTo(this.boardX + bw, this.boardY + i * this.tileSize);\n      ctx.stroke();\n    }\n  }\n\n  drawTile(tile) {\n    if (!tile || tile.color < 0) return;\n    const ctx = this.ctx;\n    const size = this.tileSize - 4;\n    const cx = this.boardX + tile.col * this.tileSize + this.tileSize / 2 + (tile.offsetX || 0);\n    const cy = this.boardY + tile.row * this.tileSize + this.tileSize / 2 + (tile.offsetY || 0);\n    const scale = tile.scale || 1;\n    const alpha = tile.alpha !== undefined ? tile.alpha : 1;\n\n    ctx.save();\n    ctx.translate(cx, cy);\n    ctx.scale(scale, scale);\n    ctx.globalAlpha = alpha;\n\n    const half = size / 2;\n    const color = COLOR_MAP[tile.color];\n    if (!color) { ctx.restore(); return; }\n\n    ctx.fillStyle = color.hex;\n    this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n    ctx.fill();\n\n    ctx.fillStyle = 'rgba(255,255,255,0.25)';\n    this._roundRect(ctx, -half + 3, -half + 3, size - 6, size / 2 - 3, size * 0.15);\n    ctx.fill();\n\n    this._drawFruitIcon(ctx, tile.color, half * 0.55);\n\n    if (tile.special === SPECIAL_STRIPED_H) {\n      this._drawStripes(ctx, size, half, '#FFFFFF80', true);\n    } else if (tile.special === SPECIAL_STRIPED_V) {\n      this._drawStripes(ctx, size, half, '#FFFFFF80', false);\n    } else if (tile.special === SPECIAL_BOMB) {\n      this._drawCrosshair(ctx, half);\n    } else if (tile.special === SPECIAL_RAINBOW) {\n      this._drawRainbowOverlay(ctx, half);\n    }\n\n    if (tile.selected) {\n      ctx.strokeStyle = '#FFFFFF';\n      ctx.lineWidth = 3;\n      ctx.shadowColor = '#FFB800';\n      ctx.shadowBlur = 12;\n      this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n      ctx.stroke();\n      ctx.shadowBlur = 0;\n    }\n\n    ctx.restore();\n  }\n\n  _drawFruitIcon(ctx, colorIdx, radius) {\n    ctx.fillStyle = 'rgba(255,255,255,0.6)';\n    ctx.font = `bold ${radius * 1.4}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    const icons = ['🍎', '🍌', '🫐', '🍏', '🍇', '🍊'];\n    ctx.fillText(icons[colorIdx] || '', 0, 1);\n  }\n\n  _drawStripes(ctx, size, half, color, horizontal) {\n    ctx.strokeStyle = color;\n    ctx.lineWidth = 2;\n    if (horizontal) {\n      for (let y = -half + 6; y < half; y += 8) {\n        ctx.beginPath();\n        ctx.moveTo(-half + 4, y);\n        ctx.lineTo(half - 4, y);\n        ctx.stroke();\n      }\n    } else {\n      for (let x = -half + 6; x < half; x += 8) {\n        ctx.beginPath();\n        ctx.moveTo(x, -half + 4);\n        ctx.lineTo(x, half - 4);\n        ctx.stroke();\n      }\n    }\n  }\n\n  _drawCrosshair(ctx, half) {\n    ctx.strokeStyle = '#FFFFFF99';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.moveTo(-half * 0.6, 0); ctx.lineTo(half * 0.6, 0);\n    ctx.moveTo(0, -half * 0.6); ctx.lineTo(0, half * 0.6);\n    ctx.stroke();\n    ctx.beginPath();\n    ctx.arc(0, 0, half * 0.4, 0, Math.PI * 2);\n    ctx.stroke();\n  }\n\n  _drawRainbowOverlay(ctx, half) {\n    const gradient = ctx.createLinearGradient(-half, -half, half, half);\n    gradient.addColorStop(0, '#FF000080');\n    gradient.addColorStop(0.17, '#FF880080');\n    gradient.addColorStop(0.33, '#FFFF0080');\n    gradient.addColorStop(0.5, '#00FF0080');\n    gradient.addColorStop(0.67, '#0088FF80');\n    gradient.addColorStop(0.83, '#8800FF80');\n    gradient.addColorStop(1, '#FF008880');\n    ctx.fillStyle = gradient;\n    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.4);\n    ctx.fill();\n  }\n\n  // Draw all obstacles\n  drawObstacles(obstacleMgr) {\n    for (const obs of obstacleMgr.obstacles) {\n      if (obs.isDestroyed()) continue;\n      const shake = obs.shakeTimer > 0 ? (Math.random() - 0.5) * 4 : 0;\n      const pos = this.getTileCenter(obs.row, obs.col);\n      const half = (this.tileSize - 4) / 2;\n\n      this.ctx.save();\n      this.ctx.translate(pos.x + shake, pos.y);\n\n      switch (obs.type) {\n        case OBSTACLE_ICE:\n          this._drawIce(this.ctx, half);\n          break;\n        case OBSTACLE_CHAIN:\n          this._drawChain(this.ctx, half);\n          break;\n        case OBSTACLE_CHOCOLATE:\n          this._drawChocolate(this.ctx, half);\n          break;\n      }\n\n      this.ctx.restore();\n    }\n  }\n\n  _drawIce(ctx, half) {\n    // Translucent blue overlay\n    ctx.fillStyle = 'rgba(135, 206, 250, 0.45)';\n    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.2);\n    ctx.fill();\n    // Ice crack pattern\n    ctx.strokeStyle = 'rgba(255, 255, 255, 0.7)';\n    ctx.lineWidth = 1.5;\n    ctx.beginPath();\n    ctx.moveTo(-half * 0.3, -half * 0.5);\n    ctx.lineTo(half * 0.2, 0);\n    ctx.lineTo(-half * 0.1, half * 0.4);\n    ctx.stroke();\n    ctx.beginPath();\n    ctx.moveTo(half * 0.3, -half * 0.3);\n    ctx.lineTo(0, half * 0.1);\n    ctx.stroke();\n    // Ice label\n    ctx.fillStyle = 'rgba(255,255,255,0.8)';\n    ctx.font = `bold ${half * 0.6}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText('❄', 0, 0);\n  }\n\n  _drawChain(ctx, half) {\n    // Chain icon overlay\n    ctx.fillStyle = 'rgba(100, 100, 100, 0.35)';\n    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.2);\n    ctx.fill();\n    // Chain links\n    ctx.strokeStyle = 'rgba(80, 80, 80, 0.9)';\n    ctx.lineWidth = 3;\n    for (let i = -1; i <= 1; i++) {\n      ctx.beginPath();\n      ctx.ellipse(i * half * 0.5, 0, half * 0.25, half * 0.15, 0, 0, Math.PI * 2);\n      ctx.stroke();\n    }\n    // Lock icon\n    ctx.fillStyle = 'rgba(255,255,255,0.7)';\n    ctx.font = `bold ${half * 0.7}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText('🔗', 0, -half * 0.6);\n  }\n\n  _drawChocolate(ctx, half) {\n    // Brown blob\n    ctx.fillStyle = '#6B3410';\n    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.3);\n    ctx.fill();\n    // Chocolate drip pattern\n    ctx.fillStyle = '#8B5E3C';\n    this._roundRect(ctx, -half + 3, -half + 3, half * 2 - 6, half * 2 - 6, half * 0.25);\n    ctx.fill();\n    // Shine\n    ctx.fillStyle = 'rgba(255,255,255,0.15)';\n    this._roundRect(ctx, -half + 6, -half + 6, half - 3, half * 0.6, half * 0.15);\n    ctx.fill();\n    // Emoji\n    ctx.font = `bold ${half * 0.8}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText('🍫', 0, 0);\n  }\n\n  // Draw boss on board\n  drawBoss(boss, renderer) {\n    const pos = this.getTileCenter(boss.row, boss.col);\n    const half = (this.tileSize - 4) / 2;\n    const shake = boss.shakeTimer > 0 ? (Math.random() - 0.5) * 6 : 0;\n\n    this.ctx.save();\n    this.ctx.translate(pos.x + shake, pos.y);\n\n    // Boss body\n    const isUsingSkill = boss.skillAnimTimer > 0;\n    const pulseScale = isUsingSkill ? 1.1 : 1;\n    this.ctx.scale(pulseScale, pulseScale);\n\n    // Dark aura\n    this.ctx.fillStyle = isUsingSkill ? 'rgba(255,0,0,0.15)' : 'rgba(80,0,80,0.1)';\n    this.ctx.beginPath();\n    this.ctx.arc(0, 0, half * 1.3, 0, Math.PI * 2);\n    this.ctx.fill();\n\n    // Boss face\n    this.ctx.fillStyle = '#4A0E4E';\n    this._roundRect(this.ctx, -half, -half, half * 2, half * 2, half * 0.3);\n    this.ctx.fill();\n\n    // Inner glow\n    const grad = this.ctx.createRadialGradient(0, 0, 0, 0, 0, half);\n    grad.addColorStop(0, 'rgba(255,100,200,0.3)');\n    grad.addColorStop(1, 'rgba(80,0,120,0.1)');\n    this.ctx.fillStyle = grad;\n    this._roundRect(this.ctx, -half, -half, half * 2, half * 2, half * 0.3);\n    this.ctx.fill();\n\n    // Boss emoji\n    this.ctx.font = `bold ${half * 1.2}px sans-serif`;\n    this.ctx.textAlign = 'center';\n    this.ctx.textBaseline = 'middle';\n    const hpRatio = boss.hp / boss.maxHp;\n    const bossEmoji = hpRatio > 0.5 ? '👹' : hpRatio > 0.25 ? '👿' : '💀';\n    this.ctx.fillText(bossEmoji, 0, 0);\n\n    this.ctx.restore();\n  }\n\n  // Draw boss health bar above the board\n  drawBossHealthBar(boss) {\n    const ctx = this.ctx;\n    const barW = Math.min(200, this.screenW - 40);\n    const barH = 14;\n    const barX = (this.screenW - barW) / 2;\n    const barY = this.boardY + this.tileSize * BOARD_SIZE + 50;\n\n    // Background\n    ctx.fillStyle = '#E0D5C5';\n    this._roundRect(ctx, barX, barY, barW, barH, 7);\n    ctx.fill();\n\n    // HP bar\n    const hpRatio = Math.max(0, boss.hp / boss.maxHp);\n    if (hpRatio > 0) {\n      const grad = ctx.createLinearGradient(barX, barY, barX + barW * hpRatio, barY);\n      grad.addColorStop(0, '#FF4D4D');\n      grad.addColorStop(1, '#CC0000');\n      ctx.fillStyle = grad;\n      this._roundRect(ctx, barX, barY, barW * hpRatio, barH, 7);\n      ctx.fill();\n    }\n\n    // Boss name and HP text\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 12px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(`${boss.name}  ${boss.hp}/${boss.maxHp}`, this.screenW / 2, barY + barH + 14);\n  }\n\n  // Updated drawUI to support new goal types\n  drawUI(score, moves, config, scoreSystem, level) {\n    const ctx = this.ctx;\n\n    // Top bar background\n    ctx.fillStyle = '#FFB800';\n    this._roundRect(ctx, 8, 8, this.screenW - 16, 55, 12);\n    ctx.fill();\n\n    // Level\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 18px sans-serif';\n    ctx.textAlign = 'left';\n    ctx.fillText(`第 ${level} 关`, 20, 42);\n\n    // Level name\n    if (config.name) {\n      ctx.font = '12px sans-serif';\n      ctx.fillText(config.name, 20, 22);\n    }\n\n    // Score\n    ctx.textAlign = 'center';\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.fillText(`${score}`, this.screenW / 2, 32);\n    ctx.font = '12px sans-serif';\n    ctx.fillText('分数', this.screenW / 2, 48);\n\n    // Moves\n    ctx.textAlign = 'right';\n    ctx.fillStyle = moves <= 5 ? '#FF4D4D' : '#5D4037';\n    ctx.font = 'bold 22px sans-serif';\n    ctx.fillText(`${moves}`, this.screenW - 20, 32);\n    ctx.font = '12px sans-serif';\n    ctx.fillStyle = '#5D4037';\n    ctx.fillText('剩余步数', this.screenW - 20, 48);\n\n    // Goal progress — use the new goal description\n    const goalDesc = scoreSystem.getGoalDescription();\n    const progressBars = scoreSystem.getProgressForUI();\n\n    const barW = this.screenW - 40;\n    const barH = 16;\n    const barY = 72;\n    const barX = 20;\n\n    // Goal label\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 11px sans-serif';\n    ctx.textAlign = 'center';\n\n    if (progressBars.length === 1) {\n      // Single goal — progress bar\n      const p = progressBars[0];\n      ctx.fillStyle = '#E0D5C5';\n      this._roundRect(ctx, barX, barY, barW, barH, 8);\n      ctx.fill();\n\n      const progress = Math.min(p.current / p.target, 1);\n      if (progress > 0) {\n        const grad = ctx.createLinearGradient(barX, barY, barX + barW * progress, barY);\n        grad.addColorStop(0, '#6BCB77');\n        grad.addColorStop(1, '#4DA66B');\n        ctx.fillStyle = grad;\n        this._roundRect(ctx, barX, barY, barW * progress, barH, 8);\n        ctx.fill();\n      }\n\n      ctx.fillStyle = '#5D4037';\n      ctx.font = 'bold 11px sans-serif';\n      ctx.fillText(goalDesc, this.screenW / 2, barY + 13);\n    } else {\n      // Dual goal — two smaller bars\n      const halfBarW = (barW - 10) / 2;\n      for (let i = 0; i < progressBars.length; i++) {\n        const p = progressBars[i];\n        const bx = barX + i * (halfBarW + 10);\n\n        ctx.fillStyle = '#E0D5C5';\n        this._roundRect(ctx, bx, barY, halfBarW, barH, 8);\n        ctx.fill();\n\n        const progress = Math.min(p.current / p.target, 1);\n        if (progress > 0) {\n          const grad = ctx.createLinearGradient(bx, barY, bx + halfBarW * progress, barY);\n          grad.addColorStop(0, i === 0 ? '#6BCB77' : '#4DA6FF');\n          grad.addColorStop(1, i === 0 ? '#4DA66B' : '#3388DD');\n          ctx.fillStyle = grad;\n          this._roundRect(ctx, bx, barY, halfBarW * progress, barH, 8);\n          ctx.fill();\n        }\n\n        ctx.fillStyle = '#5D4037';\n        ctx.font = 'bold 10px sans-serif';\n        ctx.fillText(`${p.current}/${p.target}`, bx + halfBarW / 2, barY + 13);\n      }\n    }\n\n    // Bottom hint\n    ctx.fillStyle = '#8D6E63';\n    ctx.font = '14px sans-serif';\n    ctx.textAlign = 'center';\n    const hintY = this.boardY + this.tileSize * BOARD_SIZE + 30;\n    // Don't overlap with boss health bar\n    const hintOffset = scoreSystem.goalType === 'boss' ? 0 : 30;\n    ctx.fillText('滑动交换相邻方块', this.screenW / 2, hintY + hintOffset);\n  }\n\n  drawComboText(text) {\n    if (!text) return;\n    const ctx = this.ctx;\n    ctx.save();\n    ctx.fillStyle = '#FF4D4D';\n    ctx.font = 'bold 36px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.shadowColor = '#FFB800';\n    ctx.shadowBlur = 8;\n    ctx.fillText(text, this.screenW / 2, this.boardY + this.tileSize * BOARD_SIZE / 2);\n    ctx.restore();\n  }\n\n  addFloatingText(text, x, y, color = '#FF4D4D') {\n    this.floatingTexts.push({ text, x, y, alpha: 1, vy: -60, life: 1.0, color });\n  }\n\n  updateAndDrawFloatingTexts(dt) {\n    const ctx = this.ctx;\n    this.floatingTexts = this.floatingTexts.filter(ft => {\n      ft.y += ft.vy * dt;\n      ft.life -= dt;\n      ft.alpha = Math.max(0, ft.life);\n      if (ft.life <= 0) return false;\n\n      ctx.globalAlpha = ft.alpha;\n      ctx.fillStyle = ft.color;\n      ctx.font = 'bold 18px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText(ft.text, ft.x, ft.y);\n      ctx.globalAlpha = 1;\n      return true;\n    });\n  }\n\n  drawResultScreen(won, score, stars, level) {\n    const ctx = this.ctx;\n    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n    ctx.fillRect(0, 0, this.screenW, this.screenH);\n\n    const pw = Math.min(320, this.screenW - 40);\n    const ph = 260;\n    const px = (this.screenW - pw) / 2;\n    const py = (this.screenH - ph) / 2;\n\n    ctx.fillStyle = '#FFF8E7';\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.fill();\n    ctx.strokeStyle = '#FFB800';\n    ctx.lineWidth = 3;\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.stroke();\n\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 24px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(won ? '🎉 恭喜过关！' : '😢 挑战失败', this.screenW / 2, py + 45);\n\n    ctx.font = 'bold 36px sans-serif';\n    ctx.fillStyle = '#FFB800';\n    ctx.fillText(score, this.screenW / 2, py + 95);\n    ctx.font = '14px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText('得分', this.screenW / 2, py + 115);\n\n    if (won) {\n      for (let i = 0; i < 3; i++) {\n        ctx.font = '32px sans-serif';\n        ctx.fillText(i < stars ? '⭐' : '☆', this.screenW / 2 - 45 + i * 45, py + 160);\n      }\n    }\n\n    const btnW = 120, btnH = 42;\n    const btnY = py + ph - 60;\n\n    ctx.fillStyle = '#6BCB77';\n    this._roundRect(ctx, this.screenW / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n    ctx.fill();\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = 'bold 16px sans-serif';\n    ctx.fillText(won ? '下一关' : '重试', this.screenW / 2 - btnW / 2 - 10, btnY + 27);\n\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, this.screenW / 2 + 10, btnY, btnW, btnH, btnH / 2);\n    ctx.fill();\n    ctx.fillStyle = '#FFFFFF';\n    ctx.fillText('菜单', this.screenW / 2 + btnW / 2 + 10, btnY + 27);\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Renderer };\n","numLines":557,"startLine":1,"totalLines":557}}}
