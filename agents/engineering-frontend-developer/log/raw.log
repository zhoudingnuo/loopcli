{"type":"assistant","message":{"id":"msg_20260523125131145f317a03ee47fb","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_aff71d4e2aa24928b5513e66","name":"Edit","input":{"replace_all":false,"file_path":"D:\\game-projects\\steam-horror-sim\\src\\renderer\\App.ts","old_string":"    this.dayCycle.onNewDay((day) => {\n      this.onNewDay();\n    });","new_string":"    this.dayCycle.onNewDay((day) => {\n      this.onNewDay();\n    });\n\n    // M4: Horror event callbacks\n    this.horrorManager.onSanityChange = (delta) => {\n      this.state.player.sanity = Math.max(0, Math.min(100, this.state.player.sanity + delta));\n      this.state.fearLevel = Math.min(1, this.state.fearLevel + Math.abs(delta) / 100);\n    };\n    this.horrorManager.onNotification = (text) => {\n      this.addNotification(text);\n    };\n    this.horrorManager.onEventTrigger = (event) => {\n      this.state.horrorEventsTriggered++;\n      this.state.lastHorrorEventDay = this.state.day;\n      this.triggerHorrorAudio(event.type);\n    };\n\n    // M4: Phase change BGM switching\n    this.dayCycle.onPhaseChange((phase) => {\n      this.switchBgmForPhase(phase);\n    });"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"392f64db-fdde-44d3-ac09-12e89ef6a334","uuid":"904cc1bb-5147-4f7c-b640-67d05aceaddb"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_aff71d4e2aa24928b5513e66","type":"tool_result","content":"The file D:\\game-projects\\steam-horror-sim\\src\\renderer\\App.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"392f64db-fdde-44d3-ac09-12e89ef6a334","uuid":"bf3a28ab-abdc-47e0-ba5e-8ef7c87be1c0","timestamp":"2026-05-23T04:51:37.984Z","tool_use_result":{"filePath":"D:\\game-projects\\steam-horror-sim\\src\\renderer\\App.ts","oldString":"    this.dayCycle.onNewDay((day) => {\n      this.onNewDay();\n    });","newString":"    this.dayCycle.onNewDay((day) => {\n      this.onNewDay();\n    });\n\n    // M4: Horror event callbacks\n    this.horrorManager.onSanityChange = (delta) => {\n      this.state.player.sanity = Math.max(0, Math.min(100, this.state.player.sanity + delta));\n      this.state.fearLevel = Math.min(1, this.state.fearLevel + Math.abs(delta) / 100);\n    };\n    this.horrorManager.onNotification = (text) => {\n      this.addNotification(text);\n    };\n    this.horrorManager.onEventTrigger = (event) => {\n      this.state.horrorEventsTriggered++;\n      this.state.lastHorrorEventDay = this.state.day;\n      this.triggerHorrorAudio(event.type);\n    };\n\n    // M4: Phase change BGM switching\n    this.dayCycle.onPhaseChange((phase) => {\n      this.switchBgmForPhase(phase);\n    });","originalFile":"// App.ts — Game main loop + state machine (v0.4.0 — M4: Horror Events)\n\nimport { Renderer } from './Renderer';\nimport { StoreMap, TILE_SIZE, T } from '../game/StoreMap';\nimport { Player } from '../game/Player';\nimport {\n  type GameState,\n  type Interactable,\n  type LightSource,\n  GamePhase,\n  UIPanel,\n  createInitialState,\n  loadGame,\n  saveGame,\n  startAutoSave,\n  stopAutoSave,\n  getPhaseFromTime,\n  cloneState,\n  isNightTime,\n} from '../game/GameState';\nimport { ProductManager } from '../game/ProductManager';\nimport { CustomerManager } from '../game/CustomerManager';\nimport { CashRegister } from '../game/CashRegister';\nimport { PricingSystem } from '../game/PricingSystem';\nimport { EconomySystem } from '../game/EconomySystem';\nimport { ShelfInteraction, ShelfAction } from '../game/ShelfInteraction';\nimport { Customer, CustomerState } from '../game/Customer';\nimport { DayCycle } from '../game/DayCycle';\nimport { DaySummaryManager } from '../game/DaySummary';\nimport { UpgradeManager } from '../game/UpgradeManager';\nimport { SaveManager } from '../game/SaveManager';\nimport { HorrorEventManager, HorrorEventType } from '../game/HorrorEventManager';\nimport { AudioManager } from '../game/AudioManager';\n\nexport class App {\n  canvas: HTMLCanvasElement;\n  renderer: Renderer;\n  state: GameState;\n  map: StoreMap;\n  player: Player;\n\n  // M2 systems\n  productManager: ProductManager;\n  customerManager: CustomerManager;\n  registers: CashRegister[];\n  pricing: PricingSystem;\n  economy: EconomySystem;\n  shelfInteraction: ShelfInteraction;\n\n  // M3 systems\n  dayCycle: DayCycle;\n  daySummary: DaySummaryManager;\n  upgradeManager: UpgradeManager;\n  saveManager: SaveManager;\n\n  // M4 systems\n  horrorManager: HorrorEventManager;\n  audioManager: AudioManager;\n\n  private running = false;\n  private lastFrameTime = 0;\n  private animFrameId = 0;\n  private activeCustomers: Customer[] = [];\n  private lastTransactionNotification = '';\n\n  onStateChange?: (state: GameState) => void;\n  onNotification?: (text: string) => void;\n\n  constructor(canvas: HTMLCanvasElement) {\n    this.canvas = canvas;\n    this.renderer = new Renderer(canvas);\n\n    const saved = loadGame();\n    this.state = saved ? { ...createInitialState(), ...saved.gameState } : createInitialState();\n\n    this.map = new StoreMap();\n    this.player = new Player(this.state.player);\n    this.player.setupInput();\n\n    // Initialize M2 systems\n    this.productManager = new ProductManager();\n    this.customerManager = new CustomerManager();\n    this.registers = [\n      new CashRegister('register_1'),\n      new CashRegister('register_2'),\n    ];\n    this.pricing = new PricingSystem(this.productManager);\n    this.economy = new EconomySystem();\n    this.shelfInteraction = new ShelfInteraction();\n\n    // Initialize M3 systems\n    this.dayCycle = new DayCycle();\n    this.daySummary = new DaySummaryManager();\n    this.upgradeManager = new UpgradeManager();\n    this.saveManager = new SaveManager();\n\n    // Initialize M4 systems\n    this.horrorManager = new HorrorEventManager();\n    this.audioManager = new AudioManager();\n\n    // Register systems with SaveManager\n    this.saveManager.register('productManager', this.productManager);\n    this.saveManager.register('economy', this.economy);\n    this.saveManager.register('pricing', this.pricing);\n    this.saveManager.register('customerManager', this.customerManager);\n    this.saveManager.register('upgradeManager', this.upgradeManager);\n    this.saveManager.register('daySummary', this.daySummary);\n\n    // Load save data for M2 systems\n    if (saved) {\n      if (saved.productManager && Object.keys(saved.productManager).length > 0) {\n        this.productManager.loadSaveData(saved.productManager);\n      }\n      if (saved.economy && Object.keys(saved.economy).length > 0) {\n        this.economy.loadSaveData(saved.economy);\n      }\n      if (saved.pricing && Object.keys(saved.pricing).length > 0) {\n        this.pricing.loadSaveData(saved.pricing);\n      }\n      if (saved.customerStats && Object.keys(saved.customerStats).length > 0) {\n        this.customerManager.loadSaveData(saved.customerStats);\n      }\n      if (saved.registers) {\n        for (let i = 0; i < saved.registers.length && i < this.registers.length; i++) {\n          this.registers[i].loadSaveData(saved.registers[i]);\n        }\n      }\n\n      // Restore M3 day cycle state\n      this.dayCycle.setDay(this.state.day);\n      this.dayCycle.setTimeOfDay(this.state.timeOfDay);\n    }\n\n    // Apply purchased upgrades\n    this.applyUpgrades();\n\n    // Setup interactable objects\n    this.state.interactables = this.createInteractables();\n    this.state.lights = this.createLights();\n\n    // Give some starting inventory\n    if (!saved) {\n      this.setupStartingInventory();\n    }\n\n    // Setup day cycle event listeners\n    this.dayCycle.onPhaseChange((phase, prev) => {\n      this.state.phase = phase;\n      this.onStateChange?.(this.state);\n    });\n\n    this.dayCycle.onNewDay((day) => {\n      this.onNewDay();\n    });\n\n    // Snap camera to player immediately\n    this.renderer.camera.snapTo(this.player.x + 16, this.player.y + 16);\n\n    // Setup keyboard shortcuts for panels\n    this.setupPanelInput();\n\n    window.addEventListener('resize', () => {\n      this.renderer.resize();\n    });\n  }\n\n  private setupStartingInventory(): void {\n    this.productManager.addToInventory('water', 10, 1);\n    this.productManager.addToInventory('cola', 8, 1);\n    this.productManager.addToInventory('chips', 8, 1);\n    this.productManager.addToInventory('biscuit', 6, 1);\n    this.productManager.addToInventory('candy', 10, 1);\n    this.productManager.addToInventory('bento_chicken', 4, 1);\n    this.productManager.addToInventory('bento_veg', 4, 1);\n    this.productManager.addToInventory('tissue', 5, 1);\n    this.productManager.addToInventory('battery', 3, 1);\n\n    this.productManager.stockShelf('shelf_1', 'chips', 5);\n    this.productManager.stockShelf('shelf_2', 'cola', 5);\n    this.productManager.stockShelf('shelf_3', 'tissue', 5);\n    this.productManager.stockShelf('fridge_1', 'water', 5);\n    this.productManager.stockShelf('fridge_2', 'bento_chicken', 3);\n  }\n\n  private applyUpgrades(): void {\n    // M3 UpgradeManager effects\n    this.renderer.lighting.setLightBoost(this.upgradeManager.getLightBoost());\n\n    if (this.upgradeManager.isPurchased('register_upgrade')) {\n      this.registers.forEach(r => r.applySpeedUpgrade(0.3));\n    }\n    if (this.upgradeManager.isPurchased('warehouse_shelf')) {\n      this.productManager.upgradeStorage(0.5);\n    }\n\n    // Also apply economy system upgrades for backward compat\n    if (this.economy.hasUpgrade('register_upgrade')) {\n      this.registers.forEach(r => r.applySpeedUpgrade(0.3));\n    }\n    if (this.economy.hasUpgrade('warehouse_shelf')) {\n      this.productManager.upgradeStorage(0.5);\n    }\n    if (this.economy.hasUpgrade('bright_lights')) {\n      for (const light of this.state.lights) {\n        light.intensity = Math.min(1, light.intensity * 1.5);\n        light.radius *= 1.3;\n      }\n    }\n  }\n\n  private setupPanelInput(): void {\n    window.addEventListener('keydown', (e) => {\n      // Dismiss day summary on any key\n      if (this.daySummary.isVisible) {\n        this.daySummary.dismiss();\n        e.preventDefault();\n        return;\n      }\n\n      if (e.key === 'Escape') {\n        if (this.state.activePanel !== UIPanel.NONE) {\n          this.state.activePanel = UIPanel.NONE;\n          this.shelfInteraction.close();\n          e.preventDefault();\n        }\n      }\n      if (e.key === 'i' || e.key === 'I') {\n        this.togglePanel(UIPanel.INVENTORY);\n        e.preventDefault();\n      }\n      if (e.key === 'p' || e.key === 'P') {\n        this.togglePanel(UIPanel.PRICING);\n        e.preventDefault();\n      }\n      if (e.key === 'u' || e.key === 'U') {\n        this.togglePanel(UIPanel.SHOP);\n        e.preventDefault();\n      }\n      if (e.key === 'o' || e.key === 'O') {\n        this.togglePanel(UIPanel.SUPPLIER);\n        e.preventDefault();\n      }\n    });\n  }\n\n  private togglePanel(panel: UIPanel): void {\n    this.state.activePanel = this.state.activePanel === panel ? UIPanel.NONE : panel;\n    if (this.state.activePanel === UIPanel.NONE) {\n      this.shelfInteraction.close();\n    }\n  }\n\n  private createInteractables(): Interactable[] {\n    const S = TILE_SIZE;\n    return [\n      { id: 'register_1', type: 'register', x: 19 * S, y: 3 * S, width: S, height: S, label: '收银台', active: true },\n      { id: 'register_2', type: 'register', x: 21 * S, y: 3 * S, width: S, height: S, label: '收银台', active: true },\n      { id: 'shelf_1', type: 'shelf', x: 3 * S, y: 5 * S, width: 3 * S, height: S, label: '零食货架', active: true },\n      { id: 'shelf_2', type: 'shelf', x: 7 * S, y: 5 * S, width: 3 * S, height: S, label: '饮料货架', active: true },\n      { id: 'shelf_3', type: 'shelf', x: 11 * S, y: 5 * S, width: 3 * S, height: S, label: '日用品', active: true },\n      { id: 'shelf_4', type: 'shelf', x: 17 * S, y: 5 * S, width: 3 * S, height: S, label: '烟酒柜', active: true },\n      { id: 'shelf_5', type: 'shelf', x: 21 * S, y: 5 * S, width: 3 * S, height: S, label: '杂志架', active: true },\n      { id: 'fridge_1', type: 'fridge', x: 3 * S, y: 9 * S, width: 3 * S, height: S, label: '冷饮冰柜', active: true },\n      { id: 'fridge_2', type: 'fridge', x: 7 * S, y: 9 * S, width: 3 * S, height: S, label: '冷冻食品', active: true },\n      { id: 'door_front', type: 'door', x: 14 * S, y: 0, width: 2 * S, height: S, label: '前门', active: true },\n      { id: 'door_back', type: 'door', x: 9 * S, y: 24 * S, width: 2 * S, height: S, label: '后门', active: true },\n      { id: 'door_warehouse', type: 'door', x: 14 * S, y: 11 * S, width: 2 * S, height: S, label: '仓库门', active: true },\n      { id: 'note_safe', type: 'note', x: 4 * S, y: 20 * S, width: S, height: S, label: '保险柜', active: true },\n    ];\n  }\n\n  private createLights(): LightSource[] {\n    const S = TILE_SIZE;\n    return [\n      { x: 15 * S, y: 3 * S, radius: 200, color: '#fff5e0', intensity: 0.8, flicker: false, flickerSpeed: 0 },\n      { x: 8 * S, y: 6 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n      { x: 22 * S, y: 6 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n      { x: 8 * S, y: 8 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n      { x: 15 * S, y: 10 * S, radius: 150, color: '#fff5e0', intensity: 0.6, flicker: false, flickerSpeed: 0 },\n      { x: 12 * S, y: 14 * S, radius: 120, color: '#e0d0b0', intensity: 0.5, flicker: true, flickerSpeed: 3.5 },\n      { x: 22 * S, y: 20 * S, radius: 100, color: '#ffe8c0', intensity: 0.4, flicker: false, flickerSpeed: 0 },\n      { x: 20 * S, y: 3 * S, radius: 80, color: '#ffffff', intensity: 0.6, flicker: false, flickerSpeed: 0 },\n    ];\n  }\n\n  start(): void {\n    if (this.running) return;\n    this.running = true;\n    this.lastFrameTime = performance.now();\n    this.loop(this.lastFrameTime);\n    startAutoSave(\n      () => this.state,\n      () => ({\n        pm: this.productManager.getSaveData(),\n        eco: this.economy.getSaveData(),\n        prc: this.pricing.getSaveData(),\n        cust: this.customerManager.getSaveData(),\n        regs: this.registers.map(r => r.getSaveData()),\n      }),\n    );\n    this.saveManager.startAutoSave(() => this.state);\n  }\n\n  stop(): void {\n    this.running = false;\n    if (this.animFrameId) cancelAnimationFrame(this.animFrameId);\n    stopAutoSave();\n    this.saveManager.save(this.state);\n  }\n\n  private loop = (now: number): void => {\n    if (!this.running) return;\n\n    const dt = Math.min(now - this.lastFrameTime, 50);\n    this.lastFrameTime = now;\n\n    this.state.totalPlaytime += dt / 1000;\n\n    // M3: Use DayCycle for time management\n    const prevDay = this.state.day;\n    this.dayCycle.update(dt);\n    this.state.day = this.dayCycle.currentDay;\n    this.state.timeOfDay = this.dayCycle.currentTime;\n    this.state.phase = this.dayCycle.currentPhase;\n    this.state.player.day = this.state.day;\n\n    // Update player (skip if panel is open)\n    if (this.state.activePanel === UIPanel.NONE) {\n      this.player.update(dt, this.map);\n    }\n\n    // Handle interaction\n    if (this.player.consumeInteract()) {\n      this.handleInteraction();\n    }\n\n    // Update M2 systems\n    this.updateManagementSystems(dt, now);\n\n    // Update M3 day summary\n    this.daySummary.update(dt);\n\n    // Update camera\n    this.renderer.camera.follow(this.player.x + 16, this.player.y + 16);\n\n    // Update shelf interaction messages\n    this.shelfInteraction.update(dt);\n\n    // Render\n    this.renderer.render(this.map, this.player, this.state, now, {\n      customers: this.activeCustomers,\n      productManager: this.productManager,\n      shelfInteraction: this.shelfInteraction,\n      registers: this.registers,\n      economy: this.economy,\n      pricing: this.pricing,\n      lastTransaction: this.lastTransactionNotification,\n      daySummary: this.daySummary,\n      upgradeManager: this.upgradeManager,\n    });\n\n    this.animFrameId = requestAnimationFrame(this.loop);\n  };\n\n  private updateManagementSystems(dt: number, now: number): void {\n    // Process pending orders\n    const fulfilled = this.productManager.processPendingOrders(this.state.day);\n    if (fulfilled.length > 0) {\n      for (const order of fulfilled) {\n        const product = this.productManager.getProduct(order.productId);\n        this.addNotification(`到货: ${product?.name ?? order.productId} x${order.quantity}`);\n      }\n    }\n\n    // Expire products\n    const expired = this.productManager.expireProducts(this.state.day);\n    if (expired.length > 0) {\n      for (const pid of expired) {\n        const product = this.productManager.getProduct(pid);\n        this.addNotification(`过期: ${product?.name ?? pid}`);\n      }\n    }\n\n    // Update customers\n    this.activeCustomers = this.customerManager.update(dt, this.state.timeOfDay, this.state.day, this.productManager);\n\n    // Update demand\n    this.pricing.updateDemand(this.state.timeOfDay);\n\n    // Update registers\n    for (const register of this.registers) {\n      const txn = register.update(dt);\n      if (txn) {\n        this.economy.addRevenue(txn.total);\n        this.state.dailyRevenue += txn.total;\n        this.lastTransactionNotification = `交易完成: ¥${txn.total.toFixed(2)}`;\n        this.addNotification(this.lastTransactionNotification);\n\n        if (txn.isAnomalous) {\n          this.addNotification('⚠ 收银机出现异常...');\n          this.state.player.sanity = Math.max(0, this.state.player.sanity - 5);\n        }\n\n        for (const item of txn.items) {\n          this.pricing.recordSale(item.productId);\n        }\n      }\n\n      if (register.canAcceptCustomer()) {\n        const waiting = this.customerManager.getFirstWaiting();\n        if (waiting) {\n          register.startCheckout(waiting, this.productManager, this.pricing);\n        }\n      }\n    }\n\n    // Sync economy money with game state\n    this.state.money = this.economy.getMoney();\n    this.state.debt = this.economy.debt;\n  }\n\n  private handleInteraction(): void {\n    if (this.state.activePanel !== UIPanel.NONE) {\n      this.state.activePanel = UIPanel.NONE;\n      this.shelfInteraction.close();\n      return;\n    }\n\n    const facing = this.player.getFacingTile();\n\n    const obj = this.state.interactables.find(o => {\n      const oGX = Math.floor(o.x / TILE_SIZE);\n      const oGY = Math.floor(o.y / TILE_SIZE);\n      const oGW = Math.ceil(o.width / TILE_SIZE);\n      const oGH = Math.ceil(o.height / TILE_SIZE);\n      return facing.gx >= oGX && facing.gx < oGX + oGW && facing.gy >= oGY && facing.gy < oGY + oGH;\n    });\n\n    if (!obj) return;\n\n    switch (obj.type) {\n      case 'shelf':\n      case 'fridge': {\n        const info = this.shelfInteraction.interactWithShelf(obj.id, this.state.interactables, this.productManager);\n        if (info) {\n          this.state.activePanel = UIPanel.SHELF;\n          this.onNotification?.(`货架: ${info.label} — ${info.productName ?? '空'} (${info.quantity}/${info.maxQuantity})`);\n        }\n        break;\n      }\n      case 'register': {\n        const register = this.registers.find(r => r.registerId === obj.id);\n        const waiting = this.customerManager.getFirstWaiting();\n        if (register && register.canAcceptCustomer() && waiting) {\n          register.startCheckout(waiting, this.productManager, this.pricing);\n          this.onNotification?.('开始收银...');\n        } else if (register && !register.canAcceptCustomer()) {\n          this.onNotification?.('收银中...');\n        } else {\n          this.onNotification?.('收银台 — 没有顾客等待');\n        }\n        break;\n      }\n      case 'door':\n        this.onNotification?.(`交互: ${obj.label}`);\n        break;\n      default:\n        this.onNotification?.(`交互: ${obj.label}`);\n    }\n  }\n\n  private onNewDay(): void {\n    const report = this.economy.endDay();\n\n    // M3: Generate day summary with display\n    this.daySummary.generateSummary(report, this.customerManager);\n\n    // Create day summary record\n    const stats = this.customerManager.getStats();\n    this.state.daySummaries.push({\n      day: report.day,\n      revenue: report.revenue,\n      expenses: report.expenses,\n      customersServed: stats.served,\n      customersLost: stats.lost,\n      debtRemaining: report.debtRemaining,\n    });\n\n    this.state.dailyRevenue = 0;\n    this.state.dailyExpenses = 0;\n    this.customerManager.resetDailyStats();\n    this.pricing.resetDailyVelocity();\n\n    this.addNotification(`Day ${report.day} 结算: 收入¥${report.revenue} 支出¥${report.expenses} 债务¥${report.debtRemaining}`);\n\n    // M3: Auto-save after day end\n    this.saveManager.save(this.state);\n\n    // Check game over\n    const gameOver = this.economy.isGameOver();\n    if (gameOver.over) {\n      this.addNotification(`游戏结束: ${gameOver.reason}`);\n    }\n  }\n\n  private addNotification(text: string): void {\n    this.state.notifications.push(text);\n    if (this.state.notifications.length > 10) {\n      this.state.notifications.shift();\n    }\n    this.onNotification?.(text);\n  }\n\n  // Public API for UI interaction\n  stockShelf(shelfId: string, productId: string, quantity: number): void {\n    this.shelfInteraction.stockShelf(shelfId, productId, quantity, this.productManager);\n  }\n\n  unstockShelf(shelfId: string, quantity: number): void {\n    this.shelfInteraction.unstockShelf(shelfId, quantity, this.productManager);\n  }\n\n  orderProduct(productId: string, quantity: number, supplierId: string): boolean {\n    const order = this.productManager.orderProduct(productId, quantity, supplierId, this.state.day);\n    if (order) {\n      this.economy.addPurchaseCost(order.totalCost);\n      this.state.money = this.economy.getMoney();\n      const product = this.productManager.getProduct(productId);\n      this.addNotification(`下单: ${product?.name} x${quantity} — ¥${order.totalCost}`);\n      return true;\n    }\n    return false;\n  }\n\n  purchaseUpgrade(upgradeId: string): { success: boolean; message: string } {\n    const result = this.economy.purchaseUpgrade(upgradeId);\n    if (result.success) {\n      this.state.money = this.economy.getMoney();\n      this.applyUpgrades();\n      this.addNotification(result.message);\n    }\n    return result;\n  }\n\n  purchaseUpgradeM3(upgradeId: string): { success: boolean; message: string } {\n    const result = this.upgradeManager.purchase(upgradeId, this.state.money);\n    if (result.success) {\n      this.economy.addExpense(result.cost);\n      this.state.money = this.economy.getMoney();\n      this.applyUpgrades();\n      this.addNotification(result.message);\n    }\n    return { success: result.success, message: result.message };\n  }\n\n  setProductPrice(productId: string, price: number): boolean {\n    return this.pricing.setPrice(productId, price);\n  }\n\n  centerCamera(): void {\n    this.renderer.camera.snapTo(this.player.x + 16, this.player.y + 16);\n  }\n\n  setTimeSpeed(speed: number): void {\n    this.state.timeSpeed = speed;\n  }\n}\n","structuredPatch":[{"oldStart":153,"oldLines":6,"newStart":153,"newLines":25,"lines":["       this.onNewDay();","     });"," ","+    // M4: Horror event callbacks","+    this.horrorManager.onSanityChange = (delta) => {","+      this.state.player.sanity = Math.max(0, Math.min(100, this.state.player.sanity + delta));","+      this.state.fearLevel = Math.min(1, this.state.fearLevel + Math.abs(delta) / 100);","+    };","+    this.horrorManager.onNotification = (text) => {","+      this.addNotification(text);","+    };","+    this.horrorManager.onEventTrigger = (event) => {","+      this.state.horrorEventsTriggered++;","+      this.state.lastHorrorEventDay = this.state.day;","+      this.triggerHorrorAudio(event.type);","+    };","+","+    // M4: Phase change BGM switching","+    this.dayCycle.onPhaseChange((phase) => {","+      this.switchBgmForPhase(phase);","+    });","+","     // Snap camera to player immediately","     this.renderer.camera.snapTo(this.player.x + 16, this.player.y + 16);"," "]}],"userModified":false,"replaceAll":false}}
