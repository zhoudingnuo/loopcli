: PK结果 -->\n    <div id=\"pk-result-screen\" class=\"screen\">\n      <div class=\"result-card\">\n        <h2 id=\"pkr-result\" class=\"result-title\">结果</h2>\n        <div class=\"result-stats\">\n          <p>正确: <span id=\"pkr-correct\">0/5</span></p>\n          <p>用时: <span id=\"pkr-time\">0s</span></p>\n          <p class=\"coins-earned\"><span id=\"pkr-reward\"></span></p>\n        </div>\n        <div id=\"pkr-answers\" class=\"pk-answers\"></div>\n        <div class=\"result-buttons\">\n          <button class=\"btn btn-primary\" onclick=\"game.goToMenu()\">返回</button>\n          <button class=\"btn btn-secondary\" onclick=\"game.social.sharePKResult(game.pk.getResult())\">分享结果</button>\n          <button class=\"btn btn-accent\" onclick=\"game.startPK()\">再来一局</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- ===== W2: 角色 ===== -->\n    <div id=\"characters-screen\" class=\"screen\">\n      <div class=\"map-header\">\n        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n        <h2>👤 角色选择</h2>\n      </div>\n      <div id=\"char-grid\" class=\"char-grid\"></div>\n      <div id=\"char-detail\" class=\"char-detail\"></div>\n    </div>\n  </div>\n\n  <script src=\"src/js/IdiomDBExtra.js\"></script>\n  <script src=\"src/js/IdiomDB.js\"></script>\n  <script src=\"src/js/levels.js\"></script>\n  <script src=\"src/js/IdiomEngine.js\"></script>\n  <script src=\"src/js/Judge.js\"></script>\n  <script src=\"src/js/ComboSystem.js\"></script>\n  <script src=\"src/js/DataManager.js\"></script>\n  <script src=\"src/js/AudioManager.js\"></script>\n  <script src=\"src/js/Tutorial.js\"></script>\n  <!-- W2 modules -->\n  <script src=\"src/js/TimedChallenge.js\"></script>\n  <script src=\"src/js/IdiomCollection.js\"></script>\n  <script src=\"src/js/DailySystem.js\"></script>\n  <script src=\"src/js/PKMode.js\"></script>\n  <script src=\"src/js/SocialManager.js\"></script>\n  <script src=\"src/js/Characters.js\"></script>\n  <script src