 ANALYTICS_EVENTS };\n194\t"}]},"parent_tool_use_id":null,"session_id":"6be7998d-cc43-4adb-be9f-4939a8437d2d","uuid":"4cace0eb-4c63-4fcd-8a1b-dd7cc7b9c7dc","timestamp":"2026-05-23T00:42:02.138Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-match3/src/js/Analytics.js","content":"// Analytics.js — Data tracking: level events, ad events, social events, batch queue\n\nconst ANALYTICS_EVENTS = {\n  GAME_START: 'game_start',\n  TUTORIAL_STEP: 'tutorial_step',\n  LEVEL_START: 'level_start',\n  LEVEL_COMPLETE: 'level_complete',\n  LEVEL_FAIL: 'level_fail',\n  AD_SHOW: 'ad_show',\n  AD_CLICK: 'ad_click',\n  SHARE: 'share',\n  SOCIAL_PK: 'social_pk',\n  PURCHASE: 'purchase',\n  DAILY_LOGIN: 'daily_login',\n  RETENTION_D1: 'retention_d1',\n};\n\nclass Analytics {\n  constructor(dataManager) {\n    this.dm = dataManager;\n    this._initStorage();\n\n    this.isDouyin = typeof tt !== 'undefined';\n    this.flushInterval = 30000; // 30s batch flush\n    this.maxQueueSize = 50;\n    this._flushTimer = null;\n  }\n\n  _initStorage() {\n    if (!this.dm.data.analytics) {\n      this.dm.data.analytics = {\n        userId: this.dm.data.social?.userId || 'u_' + Math.random().toString(36).slice(2, 10),\n        sessionId: this._genSessionId(),\n        queue: [],\n        totalCount: 0,\n        firstLaunch: Date.now(),\n        lastActive: Date.now(),\n      };\n      this.dm.save();\n    }\n    this.data = this.dm.data.analytics;\n  }\n\n  _genSessionId() {\n    return Date.now().toString(36) + Math.random().toString(36).slice(2, 6);\n  }\n\n  // --- Core track method ---\n  track(eventName, params) {\n    const event = {\n      event: eventName,\n      ts: Date.now(),\n      session: this.data.sessionId,\n      uid: this.data.userId,\n      ...(params || {}),\n    };\n\n    this.data.queue.push(event);\n    this.data.totalCount++;\n    this.data.lastActive = Date.now();\n\n    if (this.data.queue.length >= this.maxQueueSize) {\n      this.flush();\n    } else {\n      this.dm.save();\n    }\n\n    // Console log in dev\n    if (!this.isDouyin && typeof console !== 'undefined' && console.debug) {\n      console.debug(`[Analytics] ${eventName}`, params || '');\n    }\n  }\n\n  // --- Convenience methods ---\n  trackGameStart() {\n    this.track(ANALYTICS_EVENTS.GAME_START, {\n      version: '1.0',\n      platform: this.isDouyin ? 'douyin' : 'web',\n    });\n  }\n\n  trackLevelStart(levelNum, config) {\n    this.track(ANALYTICS_EVENTS.LEVEL_START, {\n      level: levelNum,\n      moves: config.moves,\n      goalType: config.goal?.type || 'score',\n    });\n  }\n\n  trackLevelComplete(levelNum, score, stars, movesUsed) {\n    this.track(ANALYTICS_EVENTS.LEVEL_COMPLETE, {\n      level: levelNum,\n      score,\n      stars,\n      movesUsed,\n      completionTime: Date.now(),\n    });\n  }\n\n  trackLevelFail(levelNum, score, movesUsed, goalProgress) {\n    this.track(ANALYTICS_EVENTS.LEVEL_FAIL, {\n      level: levelNum,\n      score,\n      movesUsed,\n      goalProgress,\n    });\n  }\n\n  trackAdShow(placement, completed) {\n    this.track(ANALYTICS_EVENTS.AD_SHOW, {\n      placement,\n      completed,\n      adType: placement === AD_PLACEMENTS.INTERSTITIAL ? 'interstitial' : 'rewarded',\n    });\n  }\n\n  trackAdClick(placement) {\n    this.track(ANALYTICS_EVENTS.AD_CLICK, { placement });\n  }\n\n  trackShare(type, level) {\n    this.track(ANALYTICS_EVENTS.SHARE, { type, level });\n  }\n\n  trackSocialPK(result, friendId) {\n    this.track(ANALYTICS_EVENTS.SOCIAL_PK, { result, friendId });\n  }\n\n  trackDailyLogin(day) {\n    this.track(ANALYTICS_EVENTS.DAILY_LOGIN, { day });\n  }\n\n  trackTutorialStep(stepId, level) {\n    this.track(ANALYTICS_EVENTS.TUTORIAL_STEP, { stepId, level });\n  }\n\n  // --- Flush queue ---\n  flush() {\n    if (this.data.queue.length === 0) return;\n\n    const batch = this.data.queue.splice(0, this.maxQueueSize);\n    this.dm.save();\n\n    if (this.isDouyin) {\n      this._uploadToServer(batch);\n    } else {\n      // Dev mode: log batch\n      if (typeof console !== 'undefined' && console.debug) {\n        console.debug(`[Analytics] Flush ${batch.length} events`, batch);\n      }\n    }\n  }\n\n  _uploadToServer(events) {\n    try {\n      // 抖音云开发 or custom server endpoint\n      const request = tt.request || fetch;\n      if (request) {\n        request({\n          url: 'https://analytics.example.com/events',\n          method: 'POST',\n          data: { events, appId: 'match-and-blast' },\n        }).catch(() => {\n          // Re-queue on failure\n          this.data.queue.unshift(...events);\n          this.dm.save();\n        });\n      }\n    } catch (e) {\n      // Silent fail — analytics never blocks gameplay\n    }\n  }\n\n  // --- Session management ---\n  newSession() {\n    this.data.sessionId = this._genSessionId();\n    this.dm.save();\n  }\n\n  getSessionDuration() {\n    return Date.now() - (this.data.firstLaunch || Date.now());\n  }\n\n  // --- Metrics helpers ---\n  getRetentionInfo() {\n    const first = this.data.firstLaunch;\n    if (!first) return { isD1: false };\n    const daysSince = Math.floor((Date.now() - first) / 86400000);\n    return { isD1: daysSince === 1, daysSince };\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Analytics, ANALYTICS_EVENTS };\n","numLines":194,"startLine":1,"totalLines":194}}}
