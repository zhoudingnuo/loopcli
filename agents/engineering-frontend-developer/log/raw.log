{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_1b2585b6c14642718227aaaa","type":"tool_result","content":"The file D:/game-projects/steam-horror-sim/src/renderer/App.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"328f9d51-5f9c-4f63-927e-7b99009d6517","uuid":"db7e6be9-7a9b-424a-b4a5-d6ac331779ad","timestamp":"2026-05-23T05:46:39.502Z","tool_use_result":{"filePath":"D:/game-projects/steam-horror-sim/src/renderer/App.ts","oldString":"// App.ts — Game main loop + state machine (v0.6.0 — M6: Narrative System)","newString":"// App.ts — Game main loop + state machine (v1.0.0 — M7: Polish & Launch)","originalFile":"// App.ts — Game main loop + state machine (v0.6.0 — M6: Narrative System)\n\nimport { Renderer } from './Renderer';\nimport { StoreMap, TILE_SIZE, T } from '../game/StoreMap';\nimport { Player } from '../game/Player';\nimport {\n  type GameState,\n  type Interactable,\n  type LightSource,\n  GamePhase,\n  UIPanel,\n  createInitialState,\n  loadGame,\n  saveGame,\n  startAutoSave,\n  stopAutoSave,\n  getPhaseFromTime,\n  cloneState,\n  isNightTime,\n} from '../game/GameState';\nimport { ProductManager } from '../game/ProductManager';\nimport { CustomerManager } from '../game/CustomerManager';\nimport { CashRegister } from '../game/CashRegister';\nimport { PricingSystem } from '../game/PricingSystem';\nimport { EconomySystem } from '../game/EconomySystem';\nimport { ShelfInteraction, ShelfAction } from '../game/ShelfInteraction';\nimport { Customer, CustomerState } from '../game/Customer';\nimport { DayCycle } from '../game/DayCycle';\nimport { DaySummaryManager } from '../game/DaySummary';\nimport { UpgradeManager } from '../game/UpgradeManager';\nimport { SaveManager } from '../game/SaveManager';\nimport { HorrorEventManager, HorrorEventType } from '../game/HorrorEventManager';\nimport { AudioManager } from '../game/AudioManager';\nimport { NPCManager } from '../game/BehaviorTree';\nimport { JumpScareManager } from '../game/JumpScareManager';\nimport { ClueManager } from '../game/ClueManager';\nimport { StoryManager } from '../game/StoryManager';\nimport { EndingSystem } from '../game/EndingSystem';\nimport { RadioManager } from '../game/RadioManager';\nimport { NoteManager } from '../game/NoteManager';\nimport { NarrativeChoiceManager } from '../game/NarrativeChoiceManager';\n\nexport class App {\n  canvas: HTMLCanvasElement;\n  renderer: Renderer;\n  state: GameState;\n  map: StoreMap;\n  player: Player;\n\n  // M2 systems\n  productManager: ProductManager;\n  customerManager: CustomerManager;\n  registers: CashRegister[];\n  pricing: PricingSystem;\n  economy: EconomySystem;\n  shelfInteraction: ShelfInteraction;\n\n  // M3 systems\n  dayCycle: DayCycle;\n  daySummary: DaySummaryManager;\n  upgradeManager: UpgradeManager;\n  saveManager: SaveManager;\n\n  // M4 systems\n  horrorManager: HorrorEventManager;\n  audioManager: AudioManager;\n\n  // M5 systems\n  npcManager: NPCManager;\n  jumpScareManager: JumpScareManager;\n\n  // M6 systems\n  clueManager: ClueManager;\n  storyManager: StoryManager;\n  endingSystem: EndingSystem;\n  radioManager: RadioManager;\n  noteManager: NoteManager;\n  narrativeChoices: NarrativeChoiceManager;\n\n  private running = false;\n  private lastFrameTime = 0;\n  private animFrameId = 0;\n  private activeCustomers: Customer[] = [];\n  private lastTransactionNotification = '';\n\n  onStateChange?: (state: GameState) => void;\n  onNotification?: (text: string) => void;\n\n  constructor(canvas: HTMLCanvasElement) {\n    this.canvas = canvas;\n    this.renderer = new Renderer(canvas);\n\n    const saved = loadGame();\n    this.state = saved ? { ...createInitialState(), ...saved.gameState } : createInitialState();\n\n    this.map = new StoreMap();\n    this.player = new Player(this.state.player);\n    this.player.setupInput();\n\n    // Initialize M2 systems\n    this.productManager = new ProductManager();\n    this.customerManager = new CustomerManager();\n    this.registers = [\n      new CashRegister('register_1'),\n      new CashRegister('register_2'),\n    ];\n    this.pricing = new PricingSystem(this.productManager);\n    this.economy = new EconomySystem();\n    this.shelfInteraction = new ShelfInteraction();\n\n    // Initialize M3 systems\n    this.dayCycle = new DayCycle();\n    this.daySummary = new DaySummaryManager();\n    this.upgradeManager = new UpgradeManager();\n    this.saveManager = new SaveManager();\n\n    // Initialize M4 systems\n    this.horrorManager = new HorrorEventManager();\n    this.audioManager = new AudioManager();\n\n    // Initialize M5 systems\n    this.npcManager = new NPCManager();\n    this.jumpScareManager = new JumpScareManager();\n\n    // Initialize M6 systems\n    this.clueManager = new ClueManager();\n    this.storyManager = new StoryManager(this.clueManager);\n    this.endingSystem = new EndingSystem(this.storyManager, this.clueManager);\n    this.radioManager = new RadioManager();\n    this.noteManager = new NoteManager();\n    this.narrativeChoices = new NarrativeChoiceManager();\n\n    // M6: Wire up callbacks\n    this.storyManager.onNotification = (text) => this.addNotification(text);\n    this.endingSystem.onNotification = (text) => this.addNotification(text);\n    this.radioManager.onNotification = (text) => this.addNotification(text);\n    this.radioManager.onClueGrant = (clueId) => {\n      this.clueManager.discoverClue(clueId, this.state.day);\n      this.syncNarrativeState();\n    };\n    this.noteManager.onNotification = (text) => this.addNotification(text);\n    this.noteManager.onCluesGranted = (clueIds) => {\n      for (const id of clueIds) {\n        this.clueManager.discoverClue(id, this.state.day);\n      }\n      this.syncNarrativeState();\n    };\n    this.narrativeChoices.onNotification = (text) => this.addNotification(text);\n    this.narrativeChoices.onSanityCost = (amount) => {\n      this.state.player.sanity = Math.max(0, this.state.player.sanity - amount);\n    };\n    this.narrativeChoices.onClueGrant = (clueId) => {\n      this.clueManager.discoverClue(clueId, this.state.day);\n      this.syncNarrativeState();\n    };\n\n    // Register systems with SaveManager\n    this.saveManager.register('productManager', this.productManager);\n    this.saveManager.register('economy', this.economy);\n    this.saveManager.register('pricing', this.pricing);\n    this.saveManager.register('customerManager', this.customerManager);\n    this.saveManager.register('upgradeManager', this.upgradeManager);\n    this.saveManager.register('daySummary', this.daySummary);\n\n    // Load save data for M2 systems\n    if (saved) {\n      if (saved.productManager && Object.keys(saved.productManager).length > 0) {\n        this.productManager.loadSaveData(saved.productManager);\n      }\n      if (saved.economy && Object.keys(saved.economy).length > 0) {\n        this.economy.loadSaveData(saved.economy);\n      }\n      if (saved.pricing && Object.keys(saved.pricing).length > 0) {\n        this.pricing.loadSaveData(saved.pricing);\n      }\n      if (saved.customerStats && Object.keys(saved.customerStats).length > 0) {\n        this.customerManager.loadSaveData(saved.customerStats);\n      }\n      if (saved.registers) {\n        for (let i = 0; i < saved.registers.length && i < this.registers.length; i++) {\n          this.registers[i].loadSaveData(saved.registers[i]);\n        }\n      }\n\n      // Restore M3 day cycle state\n      this.dayCycle.setDay(this.state.day);\n      this.dayCycle.setTimeOfDay(this.state.timeOfDay);\n    }\n\n    // Apply purchased upgrades\n    this.applyUpgrades();\n\n    // Setup interactable objects\n    this.state.interactables = this.createInteractables();\n    this.state.lights = this.createLights();\n\n    // Give some starting inventory\n    if (!saved) {\n      this.setupStartingInventory();\n    }\n\n    // Setup day cycle event listeners\n    this.dayCycle.onPhaseChange((phase, prev) => {\n      this.state.phase = phase;\n      this.onStateChange?.(this.state);\n    });\n\n    this.dayCycle.onNewDay((day) => {\n      this.onNewDay();\n    });\n\n    // M4: Horror event callbacks\n    this.horrorManager.onSanityChange = (delta) => {\n      this.state.player.sanity = Math.max(0, Math.min(100, this.state.player.sanity + delta));\n      this.state.fearLevel = Math.min(1, this.state.fearLevel + Math.abs(delta) / 100);\n    };\n    this.horrorManager.onNotification = (text) => {\n      this.addNotification(text);\n    };\n    this.horrorManager.onEventTrigger = (event) => {\n      this.state.horrorEventsTriggered++;\n      this.state.lastHorrorEventDay = this.state.day;\n      this.triggerHorrorAudio(event.type);\n    };\n\n    // M5: Jump scare callbacks\n    this.jumpScareManager.onSanityDrain = (amount) => {\n      this.state.player.sanity = Math.max(0, this.state.player.sanity - amount);\n      this.state.fearLevel = Math.min(1, this.state.fearLevel + amount / 100);\n    };\n    this.jumpScareManager.onMoneyLoss = (percent) => {\n      const loss = this.state.dailyRevenue * percent;\n      this.state.dailyRevenue = Math.max(0, this.state.dailyRevenue - loss);\n      this.economy.addExpense(loss);\n    };\n    this.jumpScareManager.onNotification = (text) => {\n      this.addNotification(text);\n    };\n    this.jumpScareManager.onScareTrigger = (scare) => {\n      this.audioManager.playHorrorJumpScare();\n      this.state.horrorEventsTriggered++;\n    };\n\n    // M4: Phase change BGM switching\n    this.dayCycle.onPhaseChange((phase) => {\n      this.switchBgmForPhase(phase);\n    });\n\n    // Snap camera to player immediately\n    this.renderer.camera.snapTo(this.player.x + 16, this.player.y + 16);\n\n    // Setup keyboard shortcuts for panels\n    this.setupPanelInput();\n\n    window.addEventListener('resize', () => {\n      this.renderer.resize();\n    });\n  }\n\n  private setupStartingInventory(): void {\n    this.productManager.addToInventory('water', 10, 1);\n    this.productManager.addToInventory('cola', 8, 1);\n    this.productManager.addToInventory('chips', 8, 1);\n    this.productManager.addToInventory('biscuit', 6, 1);\n    this.productManager.addToInventory('candy', 10, 1);\n    this.productManager.addToInventory('bento_chicken', 4, 1);\n    this.productManager.addToInventory('bento_veg', 4, 1);\n    this.productManager.addToInventory('tissue', 5, 1);\n    this.productManager.addToInventory('battery', 3, 1);\n\n    this.productManager.stockShelf('shelf_1', 'chips', 5);\n    this.productManager.stockShelf('shelf_2', 'cola', 5);\n    this.productManager.stockShelf('shelf_3', 'tissue', 5);\n    this.productManager.stockShelf('fridge_1', 'water', 5);\n    this.productManager.stockShelf('fridge_2', 'bento_chicken', 3);\n  }\n\n  private applyUpgrades(): void {\n    // M3 UpgradeManager effects\n    this.renderer.lighting.setLightBoost(this.upgradeManager.getLightBoost());\n\n    if (this.upgradeManager.isPurchased('register_upgrade')) {\n      this.registers.forEach(r => r.applySpeedUpgrade(0.3));\n    }\n    if (this.upgradeManager.isPurchased('warehouse_shelf')) {\n      this.productManager.upgradeStorage(0.5);\n    }\n\n    // Also apply economy system upgrades for backward compat\n    if (this.economy.hasUpgrade('register_upgrade')) {\n      this.registers.forEach(r => r.applySpeedUpgrade(0.3));\n    }\n    if (this.economy.hasUpgrade('warehouse_shelf')) {\n      this.productManager.upgradeStorage(0.5);\n    }\n    if (this.economy.hasUpgrade('bright_lights')) {\n      for (const light of this.state.lights) {\n        light.intensity = Math.min(1, light.intensity * 1.5);\n        light.radius *= 1.3;\n      }\n    }\n  }\n\n  private setupPanelInput(): void {\n    window.addEventListener('keydown', (e) => {\n      // Dismiss day summary on any key\n      if (this.daySummary.isVisible) {\n        this.daySummary.dismiss();\n        e.preventDefault();\n        return;\n      }\n\n      if (e.key === 'Escape') {\n        if (this.state.activePanel !== UIPanel.NONE) {\n          this.state.activePanel = UIPanel.NONE;\n          this.shelfInteraction.close();\n          e.preventDefault();\n        }\n      }\n      if (e.key === 'i' || e.key === 'I') {\n        this.togglePanel(UIPanel.INVENTORY);\n        e.preventDefault();\n      }\n      if (e.key === 'p' || e.key === 'P') {\n        this.togglePanel(UIPanel.PRICING);\n        e.preventDefault();\n      }\n      if (e.key === 'u' || e.key === 'U') {\n        this.togglePanel(UIPanel.SHOP);\n        e.preventDefault();\n      }\n      if (e.key === 'o' || e.key === 'O') {\n        this.togglePanel(UIPanel.SUPPLIER);\n        e.preventDefault();\n      }\n    });\n  }\n\n  private togglePanel(panel: UIPanel): void {\n    this.state.activePanel = this.state.activePanel === panel ? UIPanel.NONE : panel;\n    if (this.state.activePanel === UIPanel.NONE) {\n      this.shelfInteraction.close();\n    }\n  }\n\n  private createInteractables(): Interactable[] {\n    const S = TILE_SIZE;\n    return [\n      { id: 'register_1', type: 'register', x: 19 * S, y: 3 * S, width: S, height: S, label: '收银台', active: true },\n      { id: 'register_2', type: 'register', x: 21 * S, y: 3 * S, width: S, height: S, label: '收银台', active: true },\n      { id: 'shelf_1', type: 'shelf', x: 3 * S, y: 5 * S, width: 3 * S, height: S, label: '零食货架', active: true },\n      { id: 'shelf_2', type: 'shelf', x: 7 * S, y: 5 * S, width: 3 * S, height: S, label: '饮料货架', active: true },\n      { id: 'shelf_3', type: 'shelf', x: 11 * S, y: 5 * S, width: 3 * S, height: S, label: '日用品', active: true },\n      { id: 'shelf_4', type: 'shelf', x: 17 * S, y: 5 * S, width: 3 * S, height: S, label: '烟酒柜', active: true },\n      { id: 'shelf_5', type: 'shelf', x: 21 * S, y: 5 * S, width: 3 * S, height: S, label: '杂志架', active: true },\n      { id: 'fridge_1', type: 'fridge', x: 3 * S, y: 9 * S, width: 3 * S, height: S, label: '冷饮冰柜', active: true },\n      { id: 'fridge_2', type: 'fridge', x: 7 * S, y: 9 * S, width: 3 * S, height: S, label: '冷冻食品', active: true },\n      { id: 'door_front', type: 'door', x: 14 * S, y: 0, width: 2 * S, height: S, label: '前门', active: true },\n      { id: 'door_back', type: 'door', x: 9 * S, y: 24 * S, width: 2 * S, height: S, label: '后门', active: true },\n      { id: 'door_warehouse', type: 'door', x: 14 * S, y: 11 * S, width: 2 * S, height: S, label: '仓库门', active: true },\n      { id: 'note_safe', type: 'note', x: 4 * S, y: 20 * S, width: S, height: S, label: '保险柜', active: true },\n    ];\n  }\n\n  private createLights(): LightSource[] {\n    const S = TILE_SIZE;\n    return [\n      { x: 15 * S, y: 3 * S, radius: 200, color: '#fff5e0', intensity: 0.8, flicker: false, flickerSpeed: 0 },\n      { x: 8 * S, y: 6 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n      { x: 22 * S, y: 6 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n      { x: 8 * S, y: 8 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n      { x: 15 * S, y: 10 * S, radius: 150, color: '#fff5e0', intensity: 0.6, flicker: false, flickerSpeed: 0 },\n      { x: 12 * S, y: 14 * S, radius: 120, color: '#e0d0b0', intensity: 0.5, flicker: true, flickerSpeed: 3.5 },\n      { x: 22 * S, y: 20 * S, radius: 100, color: '#ffe8c0', intensity: 0.4, flicker: false, flickerSpeed: 0 },\n      { x: 20 * S, y: 3 * S, radius: 80, color: '#ffffff', intensity: 0.6, flicker: false, flickerSpeed: 0 },\n    ];\n  }\n\n  start(): void {\n    if (this.running) return;\n    this.running = true;\n    this.lastFrameTime = performance.now();\n    this.loop(this.lastFrameTime);\n    startAutoSave(\n      () => this.state,\n      () => ({\n        pm: this.productManager.getSaveData(),\n        eco: this.economy.getSaveData(),\n        prc: this.pricing.getSaveData(),\n        cust: this.customerManager.getSaveData(),\n        regs: this.registers.map(r => r.getSaveData()),\n      }),\n    );\n    this.saveManager.startAutoSave(() => this.state);\n  }\n\n  stop(): void {\n    this.running = false;\n    if (this.animFrameId) cancelAnimationFrame(this.animFrameId);\n    stopAutoSave();\n    this.saveManager.save(this.state);\n  }\n\n  private loop = (now: number): void => {\n    if (!this.running) return;\n\n    const dt = Math.min(now - this.lastFrameTime, 50);\n    this.lastFrameTime = now;\n\n    this.state.totalPlaytime += dt / 1000;\n\n    // M3: Use DayCycle for time management\n    const prevDay = this.state.day;\n    this.dayCycle.update(dt);\n    this.state.day = this.dayCycle.currentDay;\n    this.state.timeOfDay = this.dayCycle.currentTime;\n    this.state.phase = this.dayCycle.currentPhase;\n    this.state.player.day = this.state.day;\n\n    // Update player (skip if panel is open)\n    if (this.state.activePanel === UIPanel.NONE) {\n      this.player.update(dt, this.map);\n    }\n\n    // Handle interaction\n    if (this.player.consumeInteract()) {\n      this.handleInteraction();\n    }\n\n    // Update M2 systems\n    this.updateManagementSystems(dt, now);\n\n    // Update M3 day summary\n    this.daySummary.update(dt);\n\n    // M4: Update horror events\n    const horrorVisuals = this.horrorManager.update(dt, this.state.day, this.state.phase, this.state.timeOfDay, this.state.player.sanity);\n\n    // M5: Update NPCs and jump scares\n    this.npcManager.update(dt, this.state.day, this.state.timeOfDay, this.player.x, this.player.y, this.state.player.sanity, this.state.fearLevel);\n    const scareVisuals = this.jumpScareManager.update(dt, this.state.day, this.state.phase, this.state.player.sanity);\n\n    // M6: Update narrative systems\n    this.storyManager.update(this.state.day);\n    this.radioManager.update(dt, this.state.day, this.state.timeOfDay);\n    this.noteManager.update(this.state.day);\n    this.endingSystem.evaluate(this.state.day);\n    this.syncNarrativeState();\n\n    // Update camera\n    this.renderer.camera.follow(this.player.x + 16, this.player.y + 16);\n\n    // Update shelf interaction messages\n    this.shelfInteraction.update(dt);\n\n    // Render\n    this.renderer.render(this.map, this.player, this.state, now, {\n      customers: this.activeCustomers,\n      productManager: this.productManager,\n      shelfInteraction: this.shelfInteraction,\n      registers: this.registers,\n      economy: this.economy,\n      pricing: this.pricing,\n      lastTransaction: this.lastTransactionNotification,\n      daySummary: this.daySummary,\n      upgradeManager: this.upgradeManager,\n      horrorVisuals: horrorVisuals,\n      scareVisuals: scareVisuals,\n      activeNPCs: this.npcManager.getActiveNPCs(),\n    });\n\n    this.animFrameId = requestAnimationFrame(this.loop);\n  };\n\n  private updateManagementSystems(dt: number, now: number): void {\n    // Process pending orders\n    const fulfilled = this.productManager.processPendingOrders(this.state.day);\n    if (fulfilled.length > 0) {\n      for (const order of fulfilled) {\n        const product = this.productManager.getProduct(order.productId);\n        this.addNotification(`到货: ${product?.name ?? order.productId} x${order.quantity}`);\n      }\n    }\n\n    // Expire products\n    const expired = this.productManager.expireProducts(this.state.day);\n    if (expired.length > 0) {\n      for (const pid of expired) {\n        const product = this.productManager.getProduct(pid);\n        this.addNotification(`过期: ${product?.name ?? pid}`);\n      }\n    }\n\n    // Update customers\n    this.activeCustomers = this.customerManager.update(dt, this.state.timeOfDay, this.state.day, this.productManager);\n\n    // Update demand\n    this.pricing.updateDemand(this.state.timeOfDay);\n\n    // Update registers\n    for (const register of this.registers) {\n      const txn = register.update(dt);\n      if (txn) {\n        this.economy.addRevenue(txn.total);\n        this.state.dailyRevenue += txn.total;\n        this.lastTransactionNotification = `交易完成: ¥${txn.total.toFixed(2)}`;\n        this.addNotification(this.lastTransactionNotification);\n\n        if (txn.isAnomalous) {\n          this.addNotification('⚠ 收银机出现异常...');\n          this.state.player.sanity = Math.max(0, this.state.player.sanity - 5);\n        }\n\n        for (const item of txn.items) {\n          this.pricing.recordSale(item.productId);\n        }\n      }\n\n      if (register.canAcceptCustomer()) {\n        const waiting = this.customerManager.getFirstWaiting();\n        if (waiting) {\n          register.startCheckout(waiting, this.productManager, this.pricing);\n        }\n      }\n    }\n\n    // Sync economy money with game state\n    this.state.money = this.economy.getMoney();\n    this.state.debt = this.economy.debt;\n  }\n\n  private handleInteraction(): void {\n    if (this.state.activePanel !== UIPanel.NONE) {\n      this.state.activePanel = UIPanel.NONE;\n      this.shelfInteraction.close();\n      return;\n    }\n\n    const facing = this.player.getFacingTile();\n\n    const obj = this.state.interactables.find(o => {\n      const oGX = Math.floor(o.x / TILE_SIZE);\n      const oGY = Math.floor(o.y / TILE_SIZE);\n      const oGW = Math.ceil(o.width / TILE_SIZE);\n      const oGH = Math.ceil(o.height / TILE_SIZE);\n      return facing.gx >= oGX && facing.gx < oGX + oGW && facing.gy >= oGY && facing.gy < oGY + oGH;\n    });\n\n    if (!obj) return;\n\n    switch (obj.type) {\n      case 'shelf':\n      case 'fridge': {\n        const info = this.shelfInteraction.interactWithShelf(obj.id, this.state.interactables, this.productManager);\n        if (info) {\n          this.state.activePanel = UIPanel.SHELF;\n          this.onNotification?.(`货架: ${info.label} — ${info.productName ?? '空'} (${info.quantity}/${info.maxQuantity})`);\n        }\n        break;\n      }\n      case 'register': {\n        const register = this.registers.find(r => r.registerId === obj.id);\n        const waiting = this.customerManager.getFirstWaiting();\n        if (register && register.canAcceptCustomer() && waiting) {\n          register.startCheckout(waiting, this.productManager, this.pricing);\n          this.onNotification?.('开始收银...');\n        } else if (register && !register.canAcceptCustomer()) {\n          this.onNotification?.('收银中...');\n        } else {\n          this.onNotification?.('收银台 — 没有顾客等待');\n        }\n        break;\n      }\n      case 'door':\n        this.onNotification?.(`交互: ${obj.label}`);\n        break;\n      default:\n        this.onNotification?.(`交互: ${obj.label}`);\n    }\n  }\n\n  private onNewDay(): void {\n    const report = this.economy.endDay();\n\n    // M4: Reset horror system for new day\n    this.horrorManager.resetDaily();\n    this.state.fearLevel = Math.max(0, this.state.fearLevel - 0.3);\n\n    // M5: Reset NPC and jump scare systems\n    this.npcManager.resetDaily();\n    this.jumpScareManager.resetDaily();\n\n    // M6: Auto-discover clues and update narrative\n    const newClues = this.clueManager.autoDiscoverForDay(report.day);\n    for (const clue of newClues) {\n      this.addNotification(`🔍 发现线索: ${clue.name}`);\n    }\n    this.storyManager.update(report.day);\n\n    // M6: Check for forced ending on Day 30\n    if (report.day >= 30) {\n      const ending = this.endingSystem.forceEnding(report.day);\n      this.addNotification(`🏁 ${ending.title}`);\n    }\n\n    // M3: Generate day summary with display\n    this.daySummary.generateSummary(report, this.customerManager);\n\n    // Create day summary record\n    const stats = this.customerManager.getStats();\n    this.state.daySummaries.push({\n      day: report.day,\n      revenue: report.revenue,\n      expenses: report.expenses,\n      customersServed: stats.served,\n      customersLost: stats.lost,\n      debtRemaining: report.debtRemaining,\n    });\n\n    this.state.dailyRevenue = 0;\n    this.state.dailyExpenses = 0;\n    this.customerManager.resetDailyStats();\n    this.pricing.resetDailyVelocity();\n\n    this.addNotification(`Day ${report.day} 结算: 收入¥${report.revenue} 支出¥${report.expenses} 债务¥${report.debtRemaining}`);\n\n    // M3: Auto-save after day end\n    this.saveManager.save(this.state);\n\n    // Check game over\n    const gameOver = this.economy.isGameOver();\n    if (gameOver.over) {\n      this.addNotification(`游戏结束: ${gameOver.reason}`);\n    }\n  }\n\n  private addNotification(text: string): void {\n    this.state.notifications.push(text);\n    if (this.state.notifications.length > 10) {\n      this.state.notifications.shift();\n    }\n    this.onNotification?.(text);\n  }\n\n  // Public API for UI interaction\n  stockShelf(shelfId: string, productId: string, quantity: number): void {\n    this.shelfInteraction.stockShelf(shelfId, productId, quantity, this.productManager);\n  }\n\n  unstockShelf(shelfId: string, quantity: number): void {\n    this.shelfInteraction.unstockShelf(shelfId, quantity, this.productManager);\n  }\n\n  orderProduct(productId: string, quantity: number, supplierId: string): boolean {\n    const order = this.productManager.orderProduct(productId, quantity, supplierId, this.state.day);\n    if (order) {\n      this.economy.addPurchaseCost(order.totalCost);\n      this.state.money = this.economy.getMoney();\n      const product = this.productManager.getProduct(productId);\n      this.addNotification(`下单: ${product?.name} x${quantity} — ¥${order.totalCost}`);\n      return true;\n    }\n    return false;\n  }\n\n  purchaseUpgrade(upgradeId: string): { success: boolean; message: string } {\n    const result = this.economy.purchaseUpgrade(upgradeId);\n    if (result.success) {\n      this.state.money = this.economy.getMoney();\n      this.applyUpgrades();\n      this.addNotification(result.message);\n    }\n    return result;\n  }\n\n  purchaseUpgradeM3(upgradeId: string): { success: boolean; message: string } {\n    const result = this.upgradeManager.purchase(upgradeId, this.state.money);\n    if (result.success) {\n      this.economy.addExpense(result.cost);\n      this.state.money = this.economy.getMoney();\n      this.applyUpgrades();\n      this.addNotification(result.message);\n    }\n    return { success: result.success, message: result.message };\n  }\n\n  setProductPrice(productId: string, price: number): boolean {\n    return this.pricing.setPrice(productId, price);\n  }\n\n  centerCamera(): void {\n    this.renderer.camera.snapTo(this.player.x + 16, this.player.y + 16);\n  }\n\n  setTimeSpeed(speed: number): void {\n    this.state.timeSpeed = speed;\n  }\n\n  // M4: Horror audio helpers\n  private triggerHorrorAudio(type: HorrorEventType): void {\n    switch (type) {\n      case HorrorEventType.LIGHT_FLICKER:\n        this.audioManager.playHorrorFlicker();\n        break;\n      case HorrorEventType.FRIDGE_NOISE:\n        this.audioManager.playHorrorJumpScare();\n        break;\n      case HorrorEventType.WHISPER:\n        this.audioManager.playHorrorWhisper();\n        break;\n      case HorrorEventType.DOOR_AUTO_OPEN:\n        this.audioManager.playHorrorDoorCreak();\n        break;\n      case HorrorEventType.GHOST_CUSTOMER:\n      case HorrorEventType.DUPLICATE_CUSTOMER:\n      case HorrorEventType.NONPAYING_CUSTOMER:\n        this.audioManager.playHorrorAmbientDrone();\n        break;\n      case HorrorEventType.STORE_MUTATE:\n      case HorrorEventType.TIME_GLITCH:\n      case HorrorEventType.MIRROR_STORE:\n      case HorrorEventType.HE_COMES:\n      case HorrorEventType.FINAL_CHOICE:\n        this.audioManager.playHorrorJumpScare();\n        break;\n      case HorrorEventType.STALKER:\n      case HorrorEventType.CCTV_DOUBLE:\n      case HorrorEventType.CORRIDOR_EXTEND:\n        this.audioManager.playHorrorAmbientDrone();\n        break;\n      case HorrorEventType.RADIO_VOICE:\n        this.audioManager.playHorrorWhisper();\n        break;\n      default:\n        this.audioManager.playHorrorAmbientDrone();\n        break;\n    }\n  }\n\n  private switchBgmForPhase(phase: GamePhase): void {\n    if (phase === GamePhase.DAYTIME) {\n      this.audioManager.playBgm('daytime');\n    } else if (phase === GamePhase.NIGHT || phase === GamePhase.NIGHT_TRANSITION) {\n      this.audioManager.playBgm('night');\n    } else if (phase === GamePhase.DANGER) {\n      this.audioManager.playBgm('danger');\n    } else {\n      this.audioManager.stopBgm();\n    }\n  }\n\n  // M6: Sync narrative state to game state\n  private syncNarrativeState(): void {\n    this.state.storyLayer = this.storyManager.currentLayer;\n    this.state.cluesFound = this.clueManager.foundCount;\n    this.state.choicesMade = this.narrativeChoices.madeCount;\n    if (this.endingSystem.ending) {\n      this.state.endingType = this.endingSystem.ending.type;\n    }\n  }\n\n  // M6: Public API for narrative interaction\n\n  /** Try to play the next available radio segment */\n  playRadio(): boolean {\n    const seg = this.radioManager.tryPlay(this.state.day, this.state.timeOfDay);\n    return seg !== null;\n  }\n\n  /** Read a discovered note */\n  readNote(noteId: string): boolean {\n    const note = this.noteManager.readNote(noteId, this.state.day);\n    return note !== null;\n  }\n\n  /** Find notes at current player location */\n  searchLocation(location: string): string | null {\n    const note = this.noteManager.findNoteAtLocation(location, this.state.day);\n    return note?.id ?? null;\n  }\n\n  /** Get available narrative choices */\n  getAvailableChoices(): Array<{ id: string; title: string; description: string; options: Array<{ id: string; text: string }> }> {\n    const choices = this.narrativeChoices.getAllAvailable(this.state.day, this.state.phase);\n    return choices.map(c => ({\n      id: c.id,\n      title: c.title,\n      description: c.description,\n      options: c.options.map(o => ({ id: o.id, text: o.text })),\n    }));\n  }\n\n  /** Make a narrative choice */\n  makeNarrativeChoice(choiceId: string, optionId: string): boolean {\n    return this.narrativeChoices.makeChoice(choiceId, optionId, this.state.day);\n  }\n\n  /** Get story summary for HUD */\n  getStorySummary(): string {\n    return this.storyManager.getSummary();\n  }\n\n  /** Get ending progress for HUD */\n  getEndingProgress(): Array<{ title: string; progress: number; hint: string }> {\n    return this.endingSystem.getEndingProgress();\n  }\n\n  /** Get found clues list */\n  getFoundClues(): Array<{ name: string; description: string; acquired: boolean }> {\n    return this.clueManager.getAllFound().map(c => ({\n      name: c.name,\n      description: c.description,\n      acquired: c.acquired,\n    }));\n  }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":4,"newStart":1,"newLines":4,"lines":["-// App.ts — Game main loop + state machine (v0.6.0 — M6: Narrative System)","+// App.ts — Game main loop + state machine (v1.0.0 — M7: Polish & Launch)"," "," import { Renderer } from './Renderer';"," import { StoreMap, TILE_SIZE, T } from '../game/StoreMap';"]}],"userModified":false,"replaceAll":false}}
