{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_53d4c866709c43deb0a9f4c8","type":"tool_result","content":"The file D:\\game-projects\\douyin-match3\\src\\js\\Navigation.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"e7014494-9372-468d-b98b-69448d1a0f88","uuid":"87dd2a7f-04af-4017-8073-a83b5eb76b05","timestamp":"2026-05-22T22:10:24.472Z","tool_use_result":{"filePath":"D:\\game-projects\\douyin-match3\\src\\js\\Navigation.js","oldString":"  _startLevel(levelIdx) {\n    this.game._loadLevel(levelIdx);\n    this.game.state = STATES.IDLE;\n    this.characterMgr.applySkill(\n      this.dataManager.selectedCharacter,\n      this.game, 'level_start', null,\n    );\n    this.goTo(NAV_SCREENS.GAME);\n  }","newString":"  _startLevel(levelIdx) {\n    this.game._loadLevel(levelIdx);\n    this.game.state = STATES.IDLE;\n    this.characterMgr.applySkill(\n      this.dataManager.selectedCharacter,\n      this.game, 'level_start', null,\n    );\n    this.goTo(NAV_SCREENS.GAME);\n    // Phase 4: analytics\n    this.analytics.trackLevelStart(levelIdx + 1, this.game.levels[levelIdx] || {});\n  }","originalFile":"// Navigation.js — Full screen navigation: menu → map → character → game → result\n\nconst NAV_SCREENS = {\n  MENU: 'menu',\n  MAP: 'map',\n  SHOP: 'shop',\n  CHARACTER: 'character',\n  GAME: 'game',\n  RESULT: 'result',\n  DAILY: 'daily',\n  SOCIAL: 'social',\n};\n\nclass Navigation {\n  constructor(game) {\n    this.game = game;\n    this.screen = NAV_SCREENS.MENU;\n    this.dataManager = game.dataManager;\n    this.coinSystem = game.coinSystem;\n    this.characterMgr = game.characterMgr;\n    this.mapScreen = game.mapScreen;\n    this.shopUI = game.shopUI;\n    this.adManager = game.adManager;\n    this.analytics = game.analytics;\n    this.resultCoins = 0;\n    this.resultWon = false;\n    this.resultScore = 0;\n    this.resultStars = 0;\n    this.resultLevel = 0;\n    this.resultDoubled = false;\n    this.resultUsedContinue = false;\n    this.menuAnim = 0;\n    this.showBoostPrompt = false;\n    this.boostLevel = -1;\n  }\n\n  isActive() {\n    return this.screen !== NAV_SCREENS.GAME;\n  }\n\n  goTo(screen) {\n    this.screen = screen;\n  }\n\n  render(ctx, screenW, screenH) {\n    switch (this.screen) {\n      case NAV_SCREENS.MENU:\n        this._renderMenu(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.MAP:\n        this.mapScreen.render(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.SHOP:\n        this.shopUI.render(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.CHARACTER:\n        this._renderCharacterSelect(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.RESULT:\n        this._renderResult(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.DAILY:\n        this.game.dailySystem.render(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.SOCIAL:\n        this.game.socialSystem.render(ctx, screenW, screenH);\n        break;\n    }\n  }\n\n  handleClick(x, y, screenW, screenH) {\n    switch (this.screen) {\n      case NAV_SCREENS.MENU:\n        return this._handleMenuClick(x, y, screenW, screenH);\n      case NAV_SCREENS.MAP:\n        return this._handleMapClick(x, y, screenW, screenH);\n      case NAV_SCREENS.SHOP:\n        return this._handleShopClick(x, y, screenW, screenH);\n      case NAV_SCREENS.CHARACTER:\n        return this._handleCharacterClick(x, y, screenW, screenH);\n      case NAV_SCREENS.RESULT:\n        return this._handleResultClick(x, y, screenW, screenH);\n      case NAV_SCREENS.DAILY:\n        return this._handleDailyClick(x, y, screenW, screenH);\n      case NAV_SCREENS.SOCIAL:\n        return this._handleSocialClick(x, y, screenW, screenH);\n    }\n    return null;\n  }\n\n  // --- MENU ---\n  _renderMenu(ctx, w, h) {\n    this.menuAnim += 1 / 60;\n\n    // Gradient background\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0, '#FFE8F0');\n    grad.addColorStop(0.5, '#FFF8E7');\n    grad.addColorStop(1, '#E3F2FD');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n\n    // Floating fruit emojis\n    const emojis = ['🍎', '🍌', '🫐', '🍏', '🍇', '🍊'];\n    for (let i = 0; i < 12; i++) {\n      const bx = (w * 0.08 + (i * 137.5) % (w * 0.84));\n      const by = (h * 0.08 + (i * 97.3 + Math.sin(this.menuAnim * 0.8 + i * 0.7) * 25) % (h * 0.75));\n      ctx.globalAlpha = 0.12;\n      ctx.font = `${22 + (i % 3) * 8}px sans-serif`;\n      ctx.textAlign = 'center';\n      ctx.fillText(emojis[i % emojis.length], bx, by);\n    }\n    ctx.globalAlpha = 1;\n\n    // Title\n    const titleY = h * 0.22;\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 38px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('消消消大作战', w / 2, titleY);\n\n    // Subtitle with wave animation\n    ctx.font = '18px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText('Match & Blast', w / 2, titleY + 35);\n\n    // Fruit emoji row\n    ctx.font = '30px sans-serif';\n    for (let i = 0; i < 6; i++) {\n      const fx = w / 2 - 75 + i * 30;\n      const fy = titleY + 70 + Math.sin(this.menuAnim * 2 + i * 0.8) * 5;\n      ctx.fillText(emojis[i], fx, fy);\n    }\n\n    // Start button with pulse\n    const btnW = 200, btnH = 52;\n    const btnX = (w - btnW) / 2;\n    const btnY = h * 0.52;\n    const pulse = 1 + Math.sin(this.menuAnim * 2.5) * 0.03;\n\n    ctx.save();\n    ctx.translate(w / 2, btnY + btnH / 2);\n    ctx.scale(pulse, pulse);\n    ctx.translate(-w / 2, -(btnY + btnH / 2));\n\n    ctx.fillStyle = '#FFB800';\n    ctx.shadowColor = '#FFB80088';\n    ctx.shadowBlur = 15;\n    this._roundRect(ctx, btnX, btnY, btnW, btnH, 26);\n    ctx.fill();\n    ctx.shadowBlur = 0;\n\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.fillText('🎮 开始游戏', w / 2, btnY + 34);\n    ctx.restore();\n\n    // Continue (if has progress)\n    const completed = Object.keys(this.dataManager.data.levelStars).length;\n    if (completed > 0) {\n      const cBtnY = btnY + btnH + 20;\n      ctx.fillStyle = '#6BCB77';\n      this._roundRect(ctx, btnX, cBtnY, btnW, 44, 22);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText(`继续游戏 (${completed}关)`, w / 2, cBtnY + 28);\n    }\n\n    // Version\n    ctx.fillStyle = '#C0B8A8';\n    ctx.font = '12px sans-serif';\n    ctx.fillText('Phase 3b v1.0', w / 2, h - 20);\n  }\n\n  _handleMenuClick(x, y, w, h) {\n    const btnW = 200, btnH = 52;\n    const btnX = (w - btnW) / 2;\n    const btnY = h * 0.52;\n\n    // Start button\n    if (x >= btnX && x <= btnX + btnW && y >= btnY && y <= btnY + btnH) {\n      this.goTo(NAV_SCREENS.MAP);\n      return { action: 'start' };\n    }\n\n    // Continue button\n    const completed = Object.keys(this.dataManager.data.levelStars).length;\n    if (completed > 0) {\n      const cBtnY = btnY + btnH + 20;\n      if (x >= btnX && x <= btnX + btnW && y >= cBtnY && y <= cBtnY + 44) {\n        this.goTo(NAV_SCREENS.MAP);\n        return { action: 'start' };\n      }\n    }\n    return null;\n  }\n\n  // --- MAP ---\n  _handleMapClick(x, y, w, h) {\n    const result = this.mapScreen.handleClick(x, y, w, h);\n    if (!result) return null;\n\n    if (result.action === 'play') {\n      this._startLevel(result.level);\n    } else if (result.action === 'shop') {\n      this.goTo(NAV_SCREENS.SHOP);\n    } else if (result.action === 'character') {\n      this.goTo(NAV_SCREENS.CHARACTER);\n    } else if (result.action === 'daily') {\n      this.goTo(NAV_SCREENS.DAILY);\n    } else if (result.action === 'social') {\n      this.goTo(NAV_SCREENS.SOCIAL);\n    }\n    return result;\n  }\n\n  _startLevel(levelIdx) {\n    this.game._loadLevel(levelIdx);\n    this.game.state = STATES.IDLE;\n    this.characterMgr.applySkill(\n      this.dataManager.selectedCharacter,\n      this.game, 'level_start', null,\n    );\n    this.goTo(NAV_SCREENS.GAME);\n  }\n\n  // --- SHOP ---\n  _handleShopClick(x, y, w, h) {\n    const result = this.shopUI.handleClick(x, y, w, h);\n    if (!result) return null;\n    if (result.action === 'buy') {\n      this.coinSystem.buy(result.itemId);\n    } else if (result.action === 'back') {\n      this.goTo(NAV_SCREENS.MAP);\n    }\n    return result;\n  }\n\n  // --- CHARACTER SELECT ---\n  _renderCharacterSelect(ctx, w, h) {\n    // Background\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0, '#F3E5F5');\n    grad.addColorStop(1, '#FFF8E7');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n\n    // Title bar\n    ctx.fillStyle = '#B47AEA';\n    this._roundRect(ctx, 10, 8, w - 20, 48, 12);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('👤 选择角色', w / 2, 40);\n\n    // Character cards\n    const chars = this.characterMgr.getAll();\n    const cardW = Math.min((w - 50) / 2, 160);\n    const cardH = 130;\n    const totalGridW = cardW * 2 + 16;\n    const gridStartX = (w - totalGridW) / 2;\n    const startY = 75;\n\n    for (let i = 0; i < chars.length; i++) {\n      const ch = chars[i];\n      const row = Math.floor(i / 2);\n      const col = i % 2;\n      const cx = gridStartX + col * (cardW + 16);\n      const cy = startY + row * (cardH + 12);\n      const unlocked = this.characterMgr.isUnlocked(i, this.dataManager.unlockedLevel);\n      const selected = this.dataManager.selectedCharacter === i;\n\n      // Card background\n      if (selected) {\n        ctx.fillStyle = '#FFE0B2';\n      } else if (unlocked) {\n        ctx.fillStyle = '#FFFFFFEE';\n      } else {\n        ctx.fillStyle = '#E8E0D8';\n      }\n      this._roundRect(ctx, cx, cy, cardW, cardH, 12);\n      ctx.fill();\n\n      // Selected border\n      if (selected) {\n        ctx.strokeStyle = '#FFB800';\n        ctx.lineWidth = 3;\n        this._roundRect(ctx, cx, cy, cardW, cardH, 12);\n        ctx.stroke();\n\n        // Check mark\n        ctx.fillStyle = '#FFB800';\n        ctx.font = '16px sans-serif';\n        ctx.textAlign = 'right';\n        ctx.fillText('✓', cx + cardW - 8, cy + 18);\n      }\n\n      // Emoji\n      ctx.font = '36px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText(unlocked ? ch.emoji : '🔒', cx + cardW / 2, cy + 45);\n\n      // Name\n      ctx.fillStyle = unlocked ? '#5D4037' : '#A09888';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText(ch.name, cx + cardW / 2, cy + 72);\n\n      // Title\n      ctx.font = '11px sans-serif';\n      ctx.fillStyle = unlocked ? '#B47AEA' : '#C0B8A8';\n      ctx.fillText(ch.title, cx + cardW / 2, cy + 88);\n\n      // Description or unlock requirement\n      ctx.fillStyle = unlocked ? '#8D6E63' : '#B0A898';\n      ctx.font = '10px sans-serif';\n      const desc = unlocked ? ch.desc : `通过第${ch.unlockLevel}关解锁`;\n      // Word wrap for long text\n      if (desc.length > 10) {\n        const mid = Math.ceil(desc.length / 2);\n        const spaceIdx = desc.indexOf(' ', mid - 3);\n        if (spaceIdx > 0 && spaceIdx < desc.length - 1) {\n          ctx.fillText(desc.substring(0, spaceIdx), cx + cardW / 2, cy + 104);\n          ctx.fillText(desc.substring(spaceIdx + 1), cx + cardW / 2, cy + 118);\n        } else {\n          ctx.fillText(desc.substring(0, Math.ceil(desc.length / 2)), cx + cardW / 2, cy + 104);\n          ctx.fillText(desc.substring(Math.ceil(desc.length / 2)), cx + cardW / 2, cy + 118);\n        }\n      } else {\n        ctx.fillText(desc, cx + cardW / 2, cy + 110);\n      }\n    }\n\n    // Confirm button\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, 20, h - 58, w - 40, 42, 21);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 16px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('确认返回', w / 2, h - 32);\n  }\n\n  _handleCharacterClick(x, y, w, h) {\n    const chars = this.characterMgr.getAll();\n    const cardW = Math.min((w - 50) / 2, 160);\n    const cardH = 130;\n    const totalGridW = cardW * 2 + 16;\n    const gridStartX = (w - totalGridW) / 2;\n    const startY = 75;\n\n    for (let i = 0; i < chars.length; i++) {\n      const row = Math.floor(i / 2);\n      const col = i % 2;\n      const cx = gridStartX + col * (cardW + 16);\n      const cy = startY + row * (cardH + 12);\n      if (x >= cx && x <= cx + cardW && y >= cy && y <= cy + cardH) {\n        if (this.characterMgr.isUnlocked(i, this.dataManager.unlockedLevel)) {\n          this.dataManager.selectedCharacter = i;\n        }\n        return { action: 'select_char', charId: i };\n      }\n    }\n\n    // Confirm button\n    if (y >= h - 58 && y <= h - 16 && x >= 20 && x <= w - 20) {\n      this.goTo(NAV_SCREENS.MAP);\n      return { action: 'back' };\n    }\n    return null;\n  }\n\n  // --- RESULT ---\n  showResult(won, score, stars, level) {\n    this.resultWon = won;\n    this.resultScore = score;\n    this.resultStars = stars;\n    this.resultLevel = level;\n    this.resultCoins = 0;\n    this.resultDoubled = false;\n    this.resultUsedContinue = false;\n    if (won && stars > 0) {\n      this.resultCoins = this.coinSystem.awardStars(stars);\n      this.dataManager.setLevelStars(level, stars);\n    }\n    this.goTo(NAV_SCREENS.RESULT);\n  }\n\n  _renderResult(ctx, w, h) {\n    // Dim background\n    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n    ctx.fillRect(0, 0, w, h);\n\n    const pw = Math.min(320, w - 40);\n    const ph = this.resultWon ? 380 : 400;\n    const px = (w - pw) / 2;\n    const py = (h - ph) / 2;\n\n    // Panel\n    ctx.fillStyle = '#FFF8E7';\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.fill();\n    ctx.strokeStyle = '#FFB800';\n    ctx.lineWidth = 3;\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.stroke();\n\n    ctx.textAlign = 'center';\n\n    // Title\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 24px sans-serif';\n    ctx.fillText(this.resultWon ? '🎉 恭喜过关！' : '😢 挑战失败', w / 2, py + 45);\n\n    // Level number\n    ctx.font = '14px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText(`第 ${this.resultLevel} 关`, w / 2, py + 68);\n\n    // Score\n    ctx.font = 'bold 36px sans-serif';\n    ctx.fillStyle = '#FFB800';\n    ctx.fillText(this.resultScore, w / 2, py + 110);\n    ctx.font = '14px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText('得分', w / 2, py + 130);\n\n    // Stars\n    if (this.resultWon) {\n      for (let i = 0; i < 3; i++) {\n        ctx.font = '30px sans-serif';\n        ctx.fillText(i < this.resultStars ? '⭐' : '☆', w / 2 - 40 + i * 40, py + 172);\n      }\n    }\n\n    // Coins earned\n    if (this.resultCoins > 0) {\n      const coinLabel = this.resultDoubled ? `+${this.resultCoins} 🪙 (已翻倍!)` : `+${this.resultCoins} 🪙`;\n      ctx.fillStyle = this.resultDoubled ? '#FF4D4D' : '#FFB800';\n      ctx.font = 'bold 18px sans-serif';\n      ctx.fillText(coinLabel, w / 2, py + 205);\n      ctx.fillStyle = '#8D6E63';\n      ctx.font = '12px sans-serif';\n      ctx.fillText(`余额: ${this.dataManager.coins} 🪙`, w / 2, py + 224);\n\n      // Phase 4: Double reward ad button\n      if (!this.resultDoubled && AdManager.shouldShowAdButton(this.adManager, AD_PLACEMENTS.DOUBLE)) {\n        const dBtnY = py + 235;\n        ctx.fillStyle = '#FF4D4D';\n        this._roundRect(ctx, w / 2 - 80, dBtnY, 160, 30, 15);\n        ctx.fill();\n        ctx.fillStyle = '#FFF';\n        ctx.font = 'bold 12px sans-serif';\n        ctx.fillText('🎬 看视频翻倍奖励', w / 2, dBtnY + 20);\n      }\n    }\n\n    // Phase 4: Continue via ad (fail screen)\n    if (!this.resultWon && !this.resultUsedContinue) {\n      const contBtnY = py + 250;\n      if (AdManager.shouldShowAdButton(this.adManager, AD_PLACEMENTS.CONTINUE)) {\n        ctx.fillStyle = '#6BCB77';\n        this._roundRect(ctx, w / 2 - 100, contBtnY, 200, 34, 17);\n        ctx.fill();\n        ctx.fillStyle = '#FFF';\n        ctx.font = 'bold 14px sans-serif';\n        ctx.fillText('🎬 看视频+5步继续', w / 2, contBtnY + 22);\n      } else if (this.coinSystem.canContinue()) {\n        ctx.fillStyle = '#FFB800';\n        this._roundRect(ctx, w / 2 - 80, contBtnY, 160, 30, 15);\n        ctx.fill();\n        ctx.fillStyle = '#FFF';\n        ctx.font = 'bold 12px sans-serif';\n        ctx.fillText('10🪙 购买+5步', w / 2, contBtnY + 20);\n      }\n    }\n\n    // Buttons\n    const btnW = 120, btnH = 42;\n    const btnY = py + ph - 65;\n\n    if (this.resultWon) {\n      // Next level\n      ctx.fillStyle = '#6BCB77';\n      this._roundRect(ctx, w / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText('下一关', w / 2 - btnW / 2 - 10, btnY + 27);\n    } else {\n      // Retry\n      ctx.fillStyle = '#FF9A3C';\n      this._roundRect(ctx, w / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText('重试', w / 2 - btnW / 2 - 10, btnY + 27);\n    }\n\n    // Map button\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, w / 2 + 10, btnY, btnW, btnH, btnH / 2);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.fillText('🗺️ 地图', w / 2 + btnW / 2 + 10, btnY + 27);\n  }\n\n  _handleResultClick(x, y, w, h) {\n    const pw = Math.min(320, w - 40);\n    const ph = this.resultWon ? 380 : 400;\n    const px = (w - pw) / 2;\n    const py = (h - ph) / 2;\n    const btnW = 120, btnH = 42;\n    const btnY = py + ph - 65;\n\n    // Phase 4: Double reward ad button\n    if (this.resultWon && this.resultCoins > 0 && !this.resultDoubled) {\n      if (AdManager.shouldShowAdButton(this.adManager, AD_PLACEMENTS.DOUBLE)) {\n        const dBtnY = py + 235;\n        if (x >= w / 2 - 80 && x <= w / 2 + 80 && y >= dBtnY && y <= dBtnY + 30) {\n          this.adManager.showRewarded(AD_PLACEMENTS.DOUBLE).then((success) => {\n            this.analytics.trackAdShow(AD_PLACEMENTS.DOUBLE, success);\n            if (success) {\n              this.resultDoubled = true;\n              this.dataManager.addCoins(this.resultCoins);\n            }\n          });\n          return { action: 'ad_double' };\n        }\n      }\n    }\n\n    // Phase 4: Continue via ad button\n    if (!this.resultWon && !this.resultUsedContinue) {\n      const contBtnY = py + 250;\n      if (AdManager.shouldShowAdButton(this.adManager, AD_PLACEMENTS.CONTINUE)) {\n        if (x >= w / 2 - 100 && x <= w / 2 + 100 && y >= contBtnY && y <= contBtnY + 34) {\n          this.adManager.showRewarded(AD_PLACEMENTS.CONTINUE).then((success) => {\n            this.analytics.trackAdShow(AD_PLACEMENTS.CONTINUE, success);\n            if (success) {\n              this.resultUsedContinue = true;\n              this.game.scoreSystem.addMoves(5);\n              this.game.state = STATES.IDLE;\n              this.goTo(NAV_SCREENS.GAME);\n            }\n          });\n          return { action: 'ad_continue' };\n        }\n      } else if (this.coinSystem.canContinue()) {\n        if (x >= w / 2 - 80 && x <= w / 2 + 80 && y >= contBtnY && y <= contBtnY + 30) {\n          this.coinSystem.buyContinue();\n          this.resultUsedContinue = true;\n          this.game.scoreSystem.addMoves(5);\n          this.game.state = STATES.IDLE;\n          this.goTo(NAV_SCREENS.GAME);\n          return { action: 'coin_continue' };\n        }\n      }\n    }\n\n    // Next / Retry button\n    if (x >= w / 2 - btnW - 10 && x <= w / 2 - 10 && y >= btnY && y <= btnY + btnH) {\n      if (this.resultWon) {\n        // Phase 4: show interstitial before next level\n        this._tryInterstitial(() => {\n          this.game.nextLevel();\n          this.characterMgr.applySkill(\n            this.dataManager.selectedCharacter,\n            this.game, 'level_start', null,\n          );\n          this.goTo(NAV_SCREENS.GAME);\n        });\n      } else {\n        this.game.retry();\n        this.characterMgr.applySkill(\n          this.dataManager.selectedCharacter,\n          this.game, 'level_start', null,\n        );\n        this.goTo(NAV_SCREENS.GAME);\n      }\n      return { action: this.resultWon ? 'next' : 'retry' };\n    }\n\n    // Map button\n    if (x >= w / 2 + 10 && x <= w / 2 + 10 + btnW && y >= btnY && y <= btnY + btnH) {\n      // Phase 4: show interstitial when going back to map\n      this._tryInterstitial(() => {\n        this.goTo(NAV_SCREENS.MAP);\n      });\n      return { action: 'map' };\n    }\n    return null;\n  }\n\n  // Phase 4: Interstitial helper\n  _tryInterstitial(callback) {\n    if (this.adManager.canShowInterstitial(this.resultLevel)) {\n      this.adManager.showInterstitial(this.resultLevel).then(() => {\n        this.analytics.trackAdShow(AD_PLACEMENTS.INTERSTITIAL, true);\n        callback();\n      });\n    } else {\n      callback();\n    }\n  }\n\n  // --- DAILY ---\n  _handleDailyClick(x, y, w, h) {\n    const result = this.game.dailySystem.handleClick(x, y, w, h);\n    if (!result) return null;\n    if (result.action === 'back') {\n      this.goTo(NAV_SCREENS.MAP);\n    } else if (result.action === 'play_challenge') {\n      this._startLevel(result.level);\n    }\n    return result;\n  }\n\n  // --- SOCIAL ---\n  _handleSocialClick(x, y, w, h) {\n    const result = this.game.socialSystem.handleClick(x, y, w, h);\n    if (!result) return null;\n    if (result.action === 'back') {\n      this.goTo(NAV_SCREENS.MAP);\n    } else if (result.action === 'pk') {\n      const pk = this.game.socialSystem.startPK(result.friendId);\n      if (pk) {\n        // Simulate PK result\n        const myScore = Math.floor(Math.random() * 5000) + 1000;\n        const theirScore = Math.floor(Math.random() * 5000) + 1000;\n        const pkResult = this.game.socialSystem.resolvePK(result.friendId, myScore, theirScore);\n        return { action: 'pk_result', ...pkResult, myScore, theirScore };\n      }\n    }\n    return result;\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Navigation, NAV_SCREENS };\n","structuredPatch":[{"oldStart":223,"oldLines":6,"newStart":223,"newLines":8,"lines":["       this.game, 'level_start', null,","     );","     this.goTo(NAV_SCREENS.GAME);","+    // Phase 4: analytics","+    this.analytics.trackLevelStart(levelIdx + 1, this.game.levels[levelIdx] || {});","   }"," ","   // --- SHOP ---"]}],"userModified":false,"replaceAll":false}}
