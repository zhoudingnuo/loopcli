{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_0c39f362294248edbb21ef5e","type":"tool_result","content":"1\t// App.ts — Game main loop + state machine (v0.3.0 — M3: Day Cycle)\n2\t\n3\timport { Renderer } from './Renderer';\n4\timport { StoreMap, TILE_SIZE, T } from '../game/StoreMap';\n5\timport { Player } from '../game/Player';\n6\timport {\n7\t  type GameState,\n8\t  type Interactable,\n9\t  type LightSource,\n10\t  GamePhase,\n11\t  UIPanel,\n12\t  createInitialState,\n13\t  loadGame,\n14\t  saveGame,\n15\t  startAutoSave,\n16\t  stopAutoSave,\n17\t  getPhaseFromTime,\n18\t  cloneState,\n19\t} from '../game/GameState';\n20\timport { ProductManager } from '../game/ProductManager';\n21\timport { CustomerManager } from '../game/CustomerManager';\n22\timport { CashRegister } from '../game/CashRegister';\n23\timport { PricingSystem } from '../game/PricingSystem';\n24\timport { EconomySystem } from '../game/EconomySystem';\n25\timport { ShelfInteraction, ShelfAction } from '../game/ShelfInteraction';\n26\timport { Customer, CustomerState } from '../game/Customer';\n27\timport { DayCycle } from '../game/DayCycle';\n28\timport { DaySummaryManager } from '../game/DaySummary';\n29\timport { UpgradeManager } from '../game/UpgradeManager';\n30\timport { SaveManager } from '../game/SaveManager';\n31\t\n32\texport class App {\n33\t  canvas: HTMLCanvasElement;\n34\t  renderer: Renderer;\n35\t  state: GameState;\n36\t  map: StoreMap;\n37\t  player: Player;\n38\t\n39\t  // M2 systems\n40\t  productManager: ProductManager;\n41\t  customerManager: CustomerManager;\n42\t  registers: CashRegister[];\n43\t  pricing: PricingSystem;\n44\t  economy: EconomySystem;\n45\t  shelfInteraction: ShelfInteraction;\n46\t\n47\t  // M3 systems\n48\t  dayCycle: DayCycle;\n49\t  daySummary: DaySummaryManager;\n50\t  upgradeManager: UpgradeManager;\n51\t  saveManager: SaveManager;\n52\t\n53\t  private running = false;\n54\t  private lastFrameTime = 0;\n55\t  private animFrameId = 0;\n56\t  private activeCustomers: Customer[] = [];\n57\t  private lastTransactionNotification = '';\n58\t\n59\t  onStateChange?: (state: GameState) => void;\n60\t  onNotification?: (text: string) => void;\n61\t\n62\t  constructor(canvas: HTMLCanvasElement) {\n63\t    this.canvas = canvas;\n64\t    this.renderer = new Renderer(canvas);\n65\t\n66\t    const saved = loadGame();\n67\t    this.state = saved ? { ...createInitialState(), ...saved.gameState } : createInitialState();\n68\t\n69\t    this.map = new StoreMap();\n70\t    this.player = new Player(this.state.player);\n71\t    this.player.setupInput();\n72\t\n73\t    // Initialize M2 systems\n74\t    this.productManager = new ProductManager();\n75\t    this.customerManager = new CustomerManager();\n76\t    this.registers = [\n77\t      new CashRegister('register_1'),\n78\t      new CashRegister('register_2'),\n79\t    ];\n80\t    this.pricing = new PricingSystem(this.productManager);\n81\t    this.economy = new EconomySystem();\n82\t    this.shelfInteraction = new ShelfInteraction();\n83\t\n84\t    // Initialize M3 systems\n85\t    this.dayCycle = new DayCycle();\n86\t    this.daySummary = new DaySummaryManager();\n87\t    this.upgradeManager = new UpgradeManager();\n88\t    this.saveManager = new SaveManager();\n89\t\n90\t    // Register systems with SaveManager\n91\t    this.saveManager.register('productManager', this.productManager);\n92\t    this.saveManager.register('economy', this.economy);\n93\t    this.saveManager.register('pricing', this.pricing);\n94\t    this.saveManager.register('customerManager', this.customerManager);\n95\t    this.saveManager.register('upgradeManager', this.upgradeManager);\n96\t    this.saveManager.register('daySummary', this.daySummary);\n97\t\n98\t    // Load save data for M2 systems\n99\t    if (saved) {\n100\t      if (saved.productManager && Object.keys(saved.productManager).length > 0) {\n101\t        this.productManager.loadSaveData(saved.productManager);\n102\t      }\n103\t      if (saved.economy && Object.keys(saved.economy).length > 0) {\n104\t        this.economy.loadSaveData(saved.economy);\n105\t      }\n106\t      if (saved.pricing && Object.keys(saved.pricing).length > 0) {\n107\t        this.pricing.loadSaveData(saved.pricing);\n108\t      }\n109\t      if (saved.customerStats && Object.keys(saved.customerStats).length > 0) {\n110\t        this.customerManager.loadSaveData(saved.customerStats);\n111\t      }\n112\t      if (saved.registers) {\n113\t        for (let i = 0; i < saved.registers.length && i < this.registers.length; i++) {\n114\t          this.registers[i].loadSaveData(saved.registers[i]);\n115\t        }\n116\t      }\n117\t\n118\t      // Restore M3 day cycle state\n119\t      this.dayCycle.setDay(this.state.day);\n120\t      this.dayCycle.setTimeOfDay(this.state.timeOfDay);\n121\t    }\n122\t\n123\t    // Apply purchased upgrades\n124\t    this.applyUpgrades();\n125\t\n126\t    // Setup interactable objects\n127\t    this.state.interactables = this.createInteractables();\n128\t    this.state.lights = this.createLights();\n129\t\n130\t    // Give some starting inventory\n131\t    if (!saved) {\n132\t      this.setupStartingInventory();\n133\t    }\n134\t\n135\t    // Setup day cycle event listeners\n136\t    this.dayCycle.onPhaseChange((phase, prev) => {\n137\t      this.state.phase = phase;\n138\t      this.onStateChange?.(this.state);\n139\t    });\n140\t\n141\t    this.dayCycle.onNewDay((day) => {\n142\t      this.onNewDay();\n143\t    });\n144\t\n145\t    // Snap camera to player immediately\n146\t    this.renderer.camera.snapTo(this.player.x + 16, this.player.y + 16);\n147\t\n148\t    // Setup keyboard shortcuts for panels\n149\t    this.setupPanelInput();\n150\t\n151\t    window.addEventListener('resize', () => {\n152\t      this.renderer.resize();\n153\t    });\n154\t  }\n155\t\n156\t  private setupStartingInventory(): void {\n157\t    this.productManager.addToInventory('water', 10, 1);\n158\t    this.productManager.addToInventory('cola', 8, 1);\n159\t    this.productManager.addToInventory('chips', 8, 1);\n160\t    this.productManager.addToInventory('biscuit', 6, 1);\n161\t    this.productManager.addToInventory('candy', 10, 1);\n162\t    this.productManager.addToInventory('bento_chicken', 4, 1);\n163\t    this.productManager.addToInventory('bento_veg', 4, 1);\n164\t    this.productManager.addToInventory('tissue', 5, 1);\n165\t    this.productManager.addToInventory('battery', 3, 1);\n166\t\n167\t    this.productManager.stockShelf('shelf_1', 'chips', 5);\n168\t    this.productManager.stockShelf('shelf_2', 'cola', 5);\n169\t    this.productManager.stockShelf('shelf_3', 'tissue', 5);\n170\t    this.productManager.stockShelf('fridge_1', 'water', 5);\n171\t    this.productManager.stockShelf('fridge_2', 'bento_chicken', 3);\n172\t  }\n173\t\n174\t  private applyUpgrades(): void {\n175\t    // M3 UpgradeManager effects\n176\t    this.renderer.lighting.setLightBoost(this.upgradeManager.getLightBoost());\n177\t\n178\t    if (this.upgradeManager.isPurchased('register_upgrade')) {\n179\t      this.registers.forEach(r => r.applySpeedUpgrade(0.3));\n180\t    }\n181\t    if (this.upgradeManager.isPurchased('warehouse_shelf')) {\n182\t      this.productManager.upgradeStorage(0.5);\n183\t    }\n184\t\n185\t    // Also apply economy system upgrades for backward compat\n186\t    if (this.economy.hasUpgrade('register_upgrade')) {\n187\t      this.registers.forEach(r => r.applySpeedUpgrade(0.3));\n188\t    }\n189\t    if (this.economy.hasUpgrade('warehouse_shelf')) {\n190\t      this.productManager.upgradeStorage(0.5);\n191\t    }\n192\t    if (this.economy.hasUpgrade('bright_lights')) {\n193\t      for (const light of this.state.lights) {\n194\t        light.intensity = Math.min(1, light.intensity * 1.5);\n195\t        light.radius *= 1.3;\n196\t      }\n197\t    }\n198\t  }\n199\t\n200\t  private setupPanelInput(): void {\n201\t    window.addEventListener('keydown', (e) => {\n202\t      // Dismiss day summary on any key\n203\t      if (this.daySummary.isVisible) {\n204\t        this.daySummary.dismiss();\n205\t        e.preventDefault();\n206\t        return;\n207\t      }\n208\t\n209\t      if (e.key === 'Escape') {\n210\t        if (this.state.activePanel !== UIPanel.NONE) {\n211\t          this.state.activePanel = UIPanel.NONE;\n212\t          this.shelfInteraction.close();\n213\t          e.preventDefault();\n214\t        }\n215\t      }\n216\t      if (e.key === 'i' || e.key === 'I') {\n217\t        this.togglePanel(UIPanel.INVENTORY);\n218\t        e.preventDefault();\n219\t      }\n220\t      if (e.key === 'p' || e.key === 'P') {\n221\t        this.togglePanel(UIPanel.PRICING);\n222\t        e.preventDefault();\n223\t      }\n224\t      if (e.key === 'u' || e.key === 'U') {\n225\t        this.togglePanel(UIPanel.SHOP);\n226\t        e.preventDefault();\n227\t      }\n228\t      if (e.key === 'o' || e.key === 'O') {\n229\t        this.togglePanel(UIPanel.SUPPLIER);\n230\t        e.preventDefault();\n231\t      }\n232\t    });\n233\t  }\n234\t\n235\t  private togglePanel(panel: UIPanel): void {\n236\t    this.state.activePanel = this.state.activePanel === panel ? UIPanel.NONE : panel;\n237\t    if (this.state.activePanel === UIPanel.NONE) {\n238\t      this.shelfInteraction.close();\n239\t    }\n240\t  }\n241\t\n242\t  private createInteractables(): Interactable[] {\n243\t    const S = TILE_SIZE;\n244\t    return [\n245\t      { id: 'register_1', type: 'register', x: 19 * S, y: 3 * S, width: S, height: S, label: '收银台', active: true },\n246\t      { id: 'register_2', type: 'register', x: 21 * S, y: 3 * S, width: S, height: S, label: '收银台', active: true },\n247\t      { id: 'shelf_1', type: 'shelf', x: 3 * S, y: 5 * S, width: 3 * S, height: S, label: '零食货架', active: true },\n248\t      { id: 'shelf_2', type: 'shelf', x: 7 * S, y: 5 * S, width: 3 * S, height: S, label: '饮料货架', active: true },\n249\t      { id: 'shelf_3', type: 'shelf', x: 11 * S, y: 5 * S, width: 3 * S, height: S, label: '日用品', active: true },\n250\t      { id: 'shelf_4', type: 'shelf', x: 17 * S, y: 5 * S, width: 3 * S, height: S, label: '烟酒柜', active: true },\n251\t      { id: 'shelf_5', type: 'shelf', x: 21 * S, y: 5 * S, width: 3 * S, height: S, label: '杂志架', active: true },\n252\t      { id: 'fridge_1', type: 'fridge', x: 3 * S, y: 9 * S, width: 3 * S, height: S, label: '冷饮冰柜', active: true },\n253\t      { id: 'fridge_2', type: 'fridge', x: 7 * S, y: 9 * S, width: 3 * S, height: S, label: '冷冻食品', active: true },\n254\t      { id: 'door_front', type: 'door', x: 14 * S, y: 0, width: 2 * S, height: S, label: '前门', active: true },\n255\t      { id: 'door_back', type: 'door', x: 9 * S, y: 24 * S, width: 2 * S, height: S, label: '后门', active: true },\n256\t      { id: 'door_warehouse', type: 'door', x: 14 * S, y: 11 * S, width: 2 * S, height: S, label: '仓库门', active: true },\n257\t      { id: 'note_safe', type: 'note', x: 4 * S, y: 20 * S, width: S, height: S, label: '保险柜', active: true },\n258\t    ];\n259\t  }\n260\t\n261\t  private createLights(): LightSource[] {\n262\t    const S = TILE_SIZE;\n263\t    return [\n264\t      { x: 15 * S, y: 3 * S, radius: 200, color: '#fff5e0', intensity: 0.8, flicker: false, flickerSpeed: 0 },\n265\t      { x: 8 * S, y: 6 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n266\t      { x: 22 * S, y: 6 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n267\t      { x: 8 * S, y: 8 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n268\t      { x: 15 * S, y: 10 * S, radius: 150, color: '#fff5e0', intensity: 0.6, flicker: false, flickerSpeed: 0 },\n269\t      { x: 12 * S, y: 14 * S, radius: 120, color: '#e0d0b0', intensity: 0.5, flicker: true, flickerSpeed: 3.5 },\n270\t      { x: 22 * S, y: 20 * S, radius: 100, color: '#ffe8c0', intensity: 0.4, flicker: false, flickerSpeed: 0 },\n271\t      { x: 20 * S, y: 3 * S, radius: 80, color: '#ffffff', intensity: 0.6, flicker: false, flickerSpeed: 0 },\n272\t    ];\n273\t  }\n274\t\n275\t  start(): void {\n276\t    if (this.running) return;\n277\t    this.running = true;\n278\t    this.lastFrameTime = performance.now();\n279\t    this.loop(this.lastFrameTime);\n280\t    startAutoSave(\n281\t      () => this.state,\n282\t      () => ({\n283\t        pm: this.productManager.getSaveData(),\n284\t        eco: this.economy.getSaveData(),\n285\t        prc: this.pricing.getSaveData(),\n286\t        cust: this.customerManager.getSaveData(),\n287\t        regs: this.registers.map(r => r.getSaveData()),\n288\t      }),\n289\t    );\n290\t    this.saveManager.startAutoSave(() => this.state);\n291\t  }\n292\t\n293\t  stop(): void {\n294\t    this.running = false;\n295\t    if (this.animFrameId) cancelAnimationFrame(this.animFrameId);\n296\t    stopAutoSave();\n297\t    this.saveManager.save(this.state);\n298\t  }\n299\t\n300\t  private loop = (now: number): void => {\n301\t    if (!this.running) return;\n302\t\n303\t    const dt = Math.min(now - this.lastFrameTime, 50);\n304\t    this.lastFrameTime = now;\n305\t\n306\t    this.state.totalPlaytime += dt / 1000;\n307\t\n308\t    // M3: Use DayCycle for time management\n309\t    const prevDay = this.state.day;\n310\t    this.dayCycle.update(dt);\n311\t    this.state.day = this.dayCycle.currentDay;\n312\t    this.state.timeOfDay = this.dayCycle.currentTime;\n313\t    this.state.phase = this.dayCycle.currentPhase;\n314\t    this.state.player.day = this.state.day;\n315\t\n316\t    // Update player (skip if panel is open)\n317\t    if (this.state.activePanel === UIPanel.NONE) {\n318\t      this.player.update(dt, this.map);\n319\t    }\n320\t\n321\t    // Handle interaction\n322\t    if (this.player.consumeInteract()) {\n323\t      this.handleInteraction();\n324\t    }\n325\t\n326\t    // Update M2 systems\n327\t    this.updateManagementSystems(dt, now);\n328\t\n329\t    // Update M3 day summary\n330\t    this.daySummary.update(dt);\n331\t\n332\t    // Update camera\n333\t    this.renderer.camera.follow(this.player.x + 16, this.player.y + 16);\n334\t\n335\t    // Update shelf interaction messages\n336\t    this.shelfInteraction.update(dt);\n337\t\n338\t    // Render\n339\t    this.renderer.render(this.map, this.player, this.state, now, {\n340\t      customers: this.activeCustomers,\n341\t      productManager: this.productManager,\n342\t      shelfInteraction: this.shelfInteraction,\n343\t      registers: this.registers,\n344\t      economy: this.economy,\n345\t      pricing: this.pricing,\n346\t      lastTransaction: this.lastTransactionNotification,\n347\t      daySummary: this.daySummary,\n348\t      upgradeManager: this.upgradeManager,\n349\t    });\n350\t\n351\t    this.animFrameId = requestAnimationFrame(this.loop);\n352\t  };\n353\t\n354\t  private updateManagementSystems(dt: number, now: number): void {\n355\t    // Process pending orders\n356\t    const fulfilled = this.productManager.processPendingOrders(this.state.day);\n357\t    if (fulfilled.length > 0) {\n358\t      for (const order of fulfilled) {\n359\t        const product = this.productManager.getProduct(order.productId);\n360\t        this.addNotification(`到货: ${product?.name ?? order.productId} x${order.quantity}`);\n361\t      }\n362\t    }\n363\t\n364\t    // Expire products\n365\t    const expired = this.productManager.expireProducts(this.state.day);\n366\t    if (expired.length > 0) {\n367\t      for (const pid of expired) {\n368\t        const product = this.productManager.getProduct(pid);\n369\t        this.addNotification(`过期: ${product?.name ?? pid}`);\n370\t      }\n371\t    }\n372\t\n373\t    // Update customers\n374\t    this.activeCustomers = this.customerManager.update(dt, this.state.timeOfDay, this.state.day, this.productManager);\n375\t\n376\t    // Update demand\n377\t    this.pricing.updateDemand(this.state.timeOfDay);\n378\t\n379\t    // Update registers\n380\t    for (const register of this.registers) {\n381\t      const txn = register.update(dt);\n382\t      if (txn) {\n383\t        this.economy.addRevenue(txn.total);\n384\t        this.state.dailyRevenue += txn.total;\n385\t        this.lastTransactionNotification = `交易完成: ¥${txn.total.toFixed(2)}`;\n386\t        this.addNotification(this.lastTransactionNotification);\n387\t\n388\t        if (txn.isAnomalous) {\n389\t          this.addNotification('⚠ 收银机出现异常...');\n390\t          this.state.player.sanity = Math.max(0, this.state.player.sanity - 5);\n391\t        }\n392\t\n393\t        for (const item of txn.items) {\n394\t          this.pricing.recordSale(item.productId);\n395\t        }\n396\t      }\n397\t\n398\t      if (register.canAcceptCustomer()) {\n399\t        const waiting = this.customerManager.getFirstWaiting();\n400\t        if (waiting) {\n401\t          register.startCheckout(waiting, this.productManager, this.pricing);\n402\t        }\n403\t      }\n404\t    }\n405\t\n406\t    // Sync economy money with game state\n407\t    this.state.money = this.economy.getMoney();\n408\t    this.state.debt = this.economy.debt;\n409\t  }\n410\t\n411\t  private handleInteraction(): void {\n412\t    if (this.state.activePanel !== UIPanel.NONE) {\n413\t      this.state.activePanel = UIPanel.NONE;\n414\t      this.shelfInteraction.close();\n415\t      return;\n416\t    }\n417\t\n418\t    const facing = this.player.getFacingTile();\n419\t\n420\t    const obj = this.state.interactables.find(o => {\n421\t      const oGX = Math.floor(o.x / TILE_SIZE);\n422\t      const oGY = Math.floor(o.y / TILE_SIZE);\n423\t      const oGW = Math.ceil(o.width / TILE_SIZE);\n424\t      const oGH = Math.ceil(o.height / TILE_SIZE);\n425\t      return facing.gx >= oGX && facing.gx < oGX + oGW && facing.gy >= oGY && facing.gy < oGY + oGH;\n426\t    });\n427\t\n428\t    if (!obj) return;\n429\t\n430\t    switch (obj.type) {\n431\t      case 'shelf':\n432\t      case 'fridge': {\n433\t        const info = this.shelfInteraction.interactWithShelf(obj.id, this.state.interactables, this.productManager);\n434\t        if (info) {\n435\t          this.state.activePanel = UIPanel.SHELF;\n436\t          this.onNotification?.(`货架: ${info.label} — ${info.productName ?? '空'} (${info.quantity}/${info.maxQuantity})`);\n437\t        }\n438\t        break;\n439\t      }\n440\t      case 'register': {\n441\t        const register = this.registers.find(r => r.registerId === obj.id);\n442\t        const waiting = this.customerManager.getFirstWaiting();\n443\t        if (register && register.canAcceptCustomer() && waiting) {\n444\t          register.startCheckout(waiting, this.productManager, this.pricing);\n445\t          this.onNotification?.('开始收银...');\n446\t        } else if (register && !register.canAcceptCustomer()) {\n447\t          this.onNotification?.('收银中...');\n448\t        } else {\n449\t          this.onNotification?.('收银台 — 没有顾客等待');\n450\t        }\n451\t        break;\n452\t      }\n453\t      case 'door':\n454\t        this.onNotification?.(`交互: ${obj.label}`);\n455\t        break;\n456\t      default:\n457\t        this.onNotification?.(`交互: ${obj.label}`);\n458\t    }\n459\t  }\n460\t\n461\t  private onNewDay(): void {\n462\t    const report = this.economy.endDay();\n463\t\n464\t    // M3: Generate day summary with display\n465\t    this.daySummary.generateSummary(report, this.customerManager);\n466\t\n467\t    // Create day summary record\n468\t    const stats = this.customerManager.getStats();\n469\t    this.state.daySummaries.push({\n470\t      day: report.day,\n471\t      revenue: report.revenue,\n472\t      expenses: report.expenses,\n473\t      customersServed: stats.served,\n474\t      customersLost: stats.lost,\n475\t      debtRemaining: report.debtRemaining,\n476\t    });\n477\t\n478\t    this.state.dailyRevenue = 0;\n479\t    this.state.dailyExpenses = 0;\n480\t    this.customerManager.resetDailyStats();\n481\t    this.pricing.resetDailyVelocity();\n482\t\n483\t    this.addNotification(`Day ${report.day} 结算: 收入¥${report.revenue} 支出¥${report.expenses} 债务¥${report.debtRemaining}`);\n484\t\n485\t    // M3: Auto-save after day end\n486\t    this.saveManager.save(this.state);\n487\t\n488\t    // Check game over\n489\t    const gameOver = this.economy.isGameOver();\n490\t    if (gameOver.over) {\n491\t      this.addNotification(`游戏结束: ${gameOver.reason}`);\n492\t    }\n493\t  }\n494\t\n495\t  private addNotification(text: string): void {\n496\t    this.state.notifications.push(text);\n497\t    if (this.state.notifications.length > 10) {\n498\t      this.state.notifications.shift();\n499\t    }\n500\t    this.onNotification?.(text);\n501\t  }\n502\t\n503\t  // Public API for UI interaction\n504\t  stockShelf(shelfId: string, productId: string, quantity: number): void {\n505\t    this.shelfInteraction.stockShelf(shelfId, productId, quantity, this.productManager);\n506\t  }\n507\t\n508\t  unstockShelf(shelfId: string, quantity: number): void {\n509\t    this.shelfInteraction.unstockShelf(shelfId, quantity, this.productManager);\n510\t  }\n511\t\n512\t  orderProduct(productId: string, quantity: number, supplierId: string): boolean {\n513\t    const order = this.productManager.orderProduct(productId, quantity, supplierId, this.state.day);\n514\t    if (order) {\n515\t      this.economy.addPurchaseCost(order.totalCost);\n516\t      this.state.money = this.economy.getMoney();\n517\t      const product = this.productManager.getProduct(productId);\n518\t      this.addNotification(`下单: ${product?.name} x${quantity} — ¥${order.totalCost}`);\n519\t      return true;\n520\t    }\n521\t    return false;\n522\t  }\n523\t\n524\t  purchaseUpgrade(upgradeId: string): { success: boolean; message: string } {\n525\t    const result = this.economy.purchaseUpgrade(upgradeId);\n526\t    if (result.success) {\n527\t      this.state.money = this.economy.getMoney();\n528\t      this.applyUpgrades();\n529\t      this.addNotification(result.message);\n530\t    }\n531\t    return result;\n532\t  }\n533\t\n534\t  purchaseUpgradeM3(upgradeId: string): { success: boolean; message: string } {\n535\t    const result = this.upgradeManager.purchase(upgradeId, this.state.money);\n536\t    if (result.success) {\n537\t      this.economy.addExpense(result.cost);\n538\t      this.state.money = this.economy.getMoney();\n539\t      this.applyUpgrades();\n540\t      this.addNotification(result.message);\n541\t    }\n542\t    return { success: result.success, message: result.message };\n543\t  }\n544\t\n545\t  setProductPrice(productId: string, price: number): boolean {\n546\t    return this.pricing.setPrice(productId, price);\n547\t  }\n548\t\n549\t  centerCamera(): void {\n550\t    this.renderer.camera.snapTo(this.player.x + 16, this.player.y + 16);\n551\t  }\n552\t\n553\t  setTimeSpeed(speed: number): void {\n554\t    this.state.timeSpeed = speed;\n555\t  }\n556\t}\n557\t"}]},"parent_tool_use_id":null,"session_id":"392f64db-fdde-44d3-ac09-12e89ef6a334","uuid":"cea33b9b-c863-4f53-9f93-d7f7781f8baf","timestamp":"2026-05-23T04:48:20.669Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-horror-sim\\src\\renderer\\App.ts","content":"// App.ts — Game main loop + state machine (v0.3.0 — M3: Day Cycle)\n\nimport { Renderer } from './Renderer';\nimport { StoreMap, TILE_SIZE, T } from '../game/StoreMap';\nimport { Player } from '../game/Player';\nimport {\n  type GameState,\n  type Interactable,\n  type LightSource,\n  GamePhase,\n  UIPanel,\n  createInitialState,\n  loadGame,\n  saveGame,\n  startAutoSave,\n  stopAutoSave,\n  getPhaseFromTime,\n  cloneState,\n} from '../game/GameState';\nimport { ProductManager } from '../game/ProductManager';\nimport { CustomerManager } from '../game/CustomerManager';\nimport { CashRegister } from '../game/CashRegister';\nimport { PricingSystem } from '../game/PricingSystem';\nimport { EconomySystem } from '../game/EconomySystem';\nimport { ShelfInteraction, ShelfAction } from '../game/ShelfInteraction';\nimport { Customer, CustomerState } from '../game/Customer';\nimport { DayCycle } from '../game/DayCycle';\nimport { DaySummaryManager } from '../game/DaySummary';\nimport { UpgradeManager } from '../game/UpgradeManager';\nimport { SaveManager } from '../game/SaveManager';\n\nexport class App {\n  canvas: HTMLCanvasElement;\n  renderer: Renderer;\n  state: GameState;\n  map: StoreMap;\n  player: Player;\n\n  // M2 systems\n  productManager: ProductManager;\n  customerManager: CustomerManager;\n  registers: CashRegister[];\n  pricing: PricingSystem;\n  economy: EconomySystem;\n  shelfInteraction: ShelfInteraction;\n\n  // M3 systems\n  dayCycle: DayCycle;\n  daySummary: DaySummaryManager;\n  upgradeManager: UpgradeManager;\n  saveManager: SaveManager;\n\n  private running = false;\n  private lastFrameTime = 0;\n  private animFrameId = 0;\n  private activeCustomers: Customer[] = [];\n  private lastTransactionNotification = '';\n\n  onStateChange?: (state: GameState) => void;\n  onNotification?: (text: string) => void;\n\n  constructor(canvas: HTMLCanvasElement) {\n    this.canvas = canvas;\n    this.renderer = new Renderer(canvas);\n\n    const saved = loadGame();\n    this.state = saved ? { ...createInitialState(), ...saved.gameState } : createInitialState();\n\n    this.map = new StoreMap();\n    this.player = new Player(this.state.player);\n    this.player.setupInput();\n\n    // Initialize M2 systems\n    this.productManager = new ProductManager();\n    this.customerManager = new CustomerManager();\n    this.registers = [\n      new CashRegister('register_1'),\n      new CashRegister('register_2'),\n    ];\n    this.pricing = new PricingSystem(this.productManager);\n    this.economy = new EconomySystem();\n    this.shelfInteraction = new ShelfInteraction();\n\n    // Initialize M3 systems\n    this.dayCycle = new DayCycle();\n    this.daySummary = new DaySummaryManager();\n    this.upgradeManager = new UpgradeManager();\n    this.saveManager = new SaveManager();\n\n    // Register systems with SaveManager\n    this.saveManager.register('productManager', this.productManager);\n    this.saveManager.register('economy', this.economy);\n    this.saveManager.register('pricing', this.pricing);\n    this.saveManager.register('customerManager', this.customerManager);\n    this.saveManager.register('upgradeManager', this.upgradeManager);\n    this.saveManager.register('daySummary', this.daySummary);\n\n    // Load save data for M2 systems\n    if (saved) {\n      if (saved.productManager && Object.keys(saved.productManager).length > 0) {\n        this.productManager.loadSaveData(saved.productManager);\n      }\n      if (saved.economy && Object.keys(saved.economy).length > 0) {\n        this.economy.loadSaveData(saved.economy);\n      }\n      if (saved.pricing && Object.keys(saved.pricing).length > 0) {\n        this.pricing.loadSaveData(saved.pricing);\n      }\n      if (saved.customerStats && Object.keys(saved.customerStats).length > 0) {\n        this.customerManager.loadSaveData(saved.customerStats);\n      }\n      if (saved.registers) {\n        for (let i = 0; i < saved.registers.length && i < this.registers.length; i++) {\n          this.registers[i].loadSaveData(saved.registers[i]);\n        }\n      }\n\n      // Restore M3 day cycle state\n      this.dayCycle.setDay(this.state.day);\n      this.dayCycle.setTimeOfDay(this.state.timeOfDay);\n    }\n\n    // Apply purchased upgrades\n    this.applyUpgrades();\n\n    // Setup interactable objects\n    this.state.interactables = this.createInteractables();\n    this.state.lights = this.createLights();\n\n    // Give some starting inventory\n    if (!saved) {\n      this.setupStartingInventory();\n    }\n\n    // Setup day cycle event listeners\n    this.dayCycle.onPhaseChange((phase, prev) => {\n      this.state.phase = phase;\n      this.onStateChange?.(this.state);\n    });\n\n    this.dayCycle.onNewDay((day) => {\n      this.onNewDay();\n    });\n\n    // Snap camera to player immediately\n    this.renderer.camera.snapTo(this.player.x + 16, this.player.y + 16);\n\n    // Setup keyboard shortcuts for panels\n    this.setupPanelInput();\n\n    window.addEventListener('resize', () => {\n      this.renderer.resize();\n    });\n  }\n\n  private setupStartingInventory(): void {\n    this.productManager.addToInventory('water', 10, 1);\n    this.productManager.addToInventory('cola', 8, 1);\n    this.productManager.addToInventory('chips', 8, 1);\n    this.productManager.addToInventory('biscuit', 6, 1);\n    this.productManager.addToInventory('candy', 10, 1);\n    this.productManager.addToInventory('bento_chicken', 4, 1);\n    this.productManager.addToInventory('bento_veg', 4, 1);\n    this.productManager.addToInventory('tissue', 5, 1);\n    this.productManager.addToInventory('battery', 3, 1);\n\n    this.productManager.stockShelf('shelf_1', 'chips', 5);\n    this.productManager.stockShelf('shelf_2', 'cola', 5);\n    this.productManager.stockShelf('shelf_3', 'tissue', 5);\n    this.productManager.stockShelf('fridge_1', 'water', 5);\n    this.productManager.stockShelf('fridge_2', 'bento_chicken', 3);\n  }\n\n  private applyUpgrades(): void {\n    // M3 UpgradeManager effects\n    this.renderer.lighting.setLightBoost(this.upgradeManager.getLightBoost());\n\n    if (this.upgradeManager.isPurchased('register_upgrade')) {\n      this.registers.forEach(r => r.applySpeedUpgrade(0.3));\n    }\n    if (this.upgradeManager.isPurchased('warehouse_shelf')) {\n      this.productManager.upgradeStorage(0.5);\n    }\n\n    // Also apply economy system upgrades for backward compat\n    if (this.economy.hasUpgrade('register_upgrade')) {\n      this.registers.forEach(r => r.applySpeedUpgrade(0.3));\n    }\n    if (this.economy.hasUpgrade('warehouse_shelf')) {\n      this.productManager.upgradeStorage(0.5);\n    }\n    if (this.economy.hasUpgrade('bright_lights')) {\n      for (const light of this.state.lights) {\n        light.intensity = Math.min(1, light.intensity * 1.5);\n        light.radius *= 1.3;\n      }\n    }\n  }\n\n  private setupPanelInput(): void {\n    window.addEventListener('keydown', (e) => {\n      // Dismiss day summary on any key\n      if (this.daySummary.isVisible) {\n        this.daySummary.dismiss();\n        e.preventDefault();\n        return;\n      }\n\n      if (e.key === 'Escape') {\n        if (this.state.activePanel !== UIPanel.NONE) {\n          this.state.activePanel = UIPanel.NONE;\n          this.shelfInteraction.close();\n          e.preventDefault();\n        }\n      }\n      if (e.key === 'i' || e.key === 'I') {\n        this.togglePanel(UIPanel.INVENTORY);\n        e.preventDefault();\n      }\n      if (e.key === 'p' || e.key === 'P') {\n        this.togglePanel(UIPanel.PRICING);\n        e.preventDefault();\n      }\n      if (e.key === 'u' || e.key === 'U') {\n        this.togglePanel(UIPanel.SHOP);\n        e.preventDefault();\n      }\n      if (e.key === 'o' || e.key === 'O') {\n        this.togglePanel(UIPanel.SUPPLIER);\n        e.preventDefault();\n      }\n    });\n  }\n\n  private togglePanel(panel: UIPanel): void {\n    this.state.activePanel = this.state.activePanel === panel ? UIPanel.NONE : panel;\n    if (this.state.activePanel === UIPanel.NONE) {\n      this.shelfInteraction.close();\n    }\n  }\n\n  private createInteractables(): Interactable[] {\n    const S = TILE_SIZE;\n    return [\n      { id: 'register_1', type: 'register', x: 19 * S, y: 3 * S, width: S, height: S, label: '收银台', active: true },\n      { id: 'register_2', type: 'register', x: 21 * S, y: 3 * S, width: S, height: S, label: '收银台', active: true },\n      { id: 'shelf_1', type: 'shelf', x: 3 * S, y: 5 * S, width: 3 * S, height: S, label: '零食货架', active: true },\n      { id: 'shelf_2', type: 'shelf', x: 7 * S, y: 5 * S, width: 3 * S, height: S, label: '饮料货架', active: true },\n      { id: 'shelf_3', type: 'shelf', x: 11 * S, y: 5 * S, width: 3 * S, height: S, label: '日用品', active: true },\n      { id: 'shelf_4', type: 'shelf', x: 17 * S, y: 5 * S, width: 3 * S, height: S, label: '烟酒柜', active: true },\n      { id: 'shelf_5', type: 'shelf', x: 21 * S, y: 5 * S, width: 3 * S, height: S, label: '杂志架', active: true },\n      { id: 'fridge_1', type: 'fridge', x: 3 * S, y: 9 * S, width: 3 * S, height: S, label: '冷饮冰柜', active: true },\n      { id: 'fridge_2', type: 'fridge', x: 7 * S, y: 9 * S, width: 3 * S, height: S, label: '冷冻食品', active: true },\n      { id: 'door_front', type: 'door', x: 14 * S, y: 0, width: 2 * S, height: S, label: '前门', active: true },\n      { id: 'door_back', type: 'door', x: 9 * S, y: 24 * S, width: 2 * S, height: S, label: '后门', active: true },\n      { id: 'door_warehouse', type: 'door', x: 14 * S, y: 11 * S, width: 2 * S, height: S, label: '仓库门', active: true },\n      { id: 'note_safe', type: 'note', x: 4 * S, y: 20 * S, width: S, height: S, label: '保险柜', active: true },\n    ];\n  }\n\n  private createLights(): LightSource[] {\n    const S = TILE_SIZE;\n    return [\n      { x: 15 * S, y: 3 * S, radius: 200, color: '#fff5e0', intensity: 0.8, flicker: false, flickerSpeed: 0 },\n      { x: 8 * S, y: 6 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n      { x: 22 * S, y: 6 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n      { x: 8 * S, y: 8 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n      { x: 15 * S, y: 10 * S, radius: 150, color: '#fff5e0', intensity: 0.6, flicker: false, flickerSpeed: 0 },\n      { x: 12 * S, y: 14 * S, radius: 120, color: '#e0d0b0', intensity: 0.5, flicker: true, flickerSpeed: 3.5 },\n      { x: 22 * S, y: 20 * S, radius: 100, color: '#ffe8c0', intensity: 0.4, flicker: false, flickerSpeed: 0 },\n      { x: 20 * S, y: 3 * S, radius: 80, color: '#ffffff', intensity: 0.6, flicker: false, flickerSpeed: 0 },\n    ];\n  }\n\n  start(): void {\n    if (this.running) return;\n    this.running = true;\n    this.lastFrameTime = performance.now();\n    this.loop(this.lastFrameTime);\n    startAutoSave(\n      () => this.state,\n      () => ({\n        pm: this.productManager.getSaveData(),\n        eco: this.economy.getSaveData(),\n        prc: this.pricing.getSaveData(),\n        cust: this.customerManager.getSaveData(),\n        regs: this.registers.map(r => r.getSaveData()),\n      }),\n    );\n    this.saveManager.startAutoSave(() => this.state);\n  }\n\n  stop(): void {\n    this.running = false;\n    if (this.animFrameId) cancelAnimationFrame(this.animFrameId);\n    stopAutoSave();\n    this.saveManager.save(this.state);\n  }\n\n  private loop = (now: number): void => {\n    if (!this.running) return;\n\n    const dt = Math.min(now - this.lastFrameTime, 50);\n    this.lastFrameTime = now;\n\n    this.state.totalPlaytime += dt / 1000;\n\n    // M3: Use DayCycle for time management\n    const prevDay = this.state.day;\n    this.dayCycle.update(dt);\n    this.state.day = this.dayCycle.currentDay;\n    this.state.timeOfDay = this.dayCycle.currentTime;\n    this.state.phase = this.dayCycle.currentPhase;\n    this.state.player.day = this.state.day;\n\n    // Update player (skip if panel is open)\n    if (this.state.activePanel === UIPanel.NONE) {\n      this.player.update(dt, this.map);\n    }\n\n    // Handle interaction\n    if (this.player.consumeInteract()) {\n      this.handleInteraction();\n    }\n\n    // Update M2 systems\n    this.updateManagementSystems(dt, now);\n\n    // Update M3 day summary\n    this.daySummary.update(dt);\n\n    // Update camera\n    this.renderer.camera.follow(this.player.x + 16, this.player.y + 16);\n\n    // Update shelf interaction messages\n    this.shelfInteraction.update(dt);\n\n    // Render\n    this.renderer.render(this.map, this.player, this.state, now, {\n      customers: this.activeCustomers,\n      productManager: this.productManager,\n      shelfInteraction: this.shelfInteraction,\n      registers: this.registers,\n      economy: this.economy,\n      pricing: this.pricing,\n      lastTransaction: this.lastTransactionNotification,\n      daySummary: this.daySummary,\n      upgradeManager: this.upgradeManager,\n    });\n\n    this.animFrameId = requestAnimationFrame(this.loop);\n  };\n\n  private updateManagementSystems(dt: number, now: number): void {\n    // Process pending orders\n    const fulfilled = this.productManager.processPendingOrders(this.state.day);\n    if (fulfilled.length > 0) {\n      for (const order of fulfilled) {\n        const product = this.productManager.getProduct(order.productId);\n        this.addNotification(`到货: ${product?.name ?? order.productId} x${order.quantity}`);\n      }\n    }\n\n    // Expire products\n    const expired = this.productManager.expireProducts(this.state.day);\n    if (expired.length > 0) {\n      for (const pid of expired) {\n        const product = this.productManager.getProduct(pid);\n        this.addNotification(`过期: ${product?.name ?? pid}`);\n      }\n    }\n\n    // Update customers\n    this.activeCustomers = this.customerManager.update(dt, this.state.timeOfDay, this.state.day, this.productManager);\n\n    // Update demand\n    this.pricing.updateDemand(this.state.timeOfDay);\n\n    // Update registers\n    for (const register of this.registers) {\n      const txn = register.update(dt);\n      if (txn) {\n        this.economy.addRevenue(txn.total);\n        this.state.dailyRevenue += txn.total;\n        this.lastTransactionNotification = `交易完成: ¥${txn.total.toFixed(2)}`;\n        this.addNotification(this.lastTransactionNotification);\n\n        if (txn.isAnomalous) {\n          this.addNotification('⚠ 收银机出现异常...');\n          this.state.player.sanity = Math.max(0, this.state.player.sanity - 5);\n        }\n\n        for (const item of txn.items) {\n          this.pricing.recordSale(item.productId);\n        }\n      }\n\n      if (register.canAcceptCustomer()) {\n        const waiting = this.customerManager.getFirstWaiting();\n        if (waiting) {\n          register.startCheckout(waiting, this.productManager, this.pricing);\n        }\n      }\n    }\n\n    // Sync economy money with game state\n    this.state.money = this.economy.getMoney();\n    this.state.debt = this.economy.debt;\n  }\n\n  private handleInteraction(): void {\n    if (this.state.activePanel !== UIPanel.NONE) {\n      this.state.activePanel = UIPanel.NONE;\n      this.shelfInteraction.close();\n      return;\n    }\n\n    const facing = this.player.getFacingTile();\n\n    const obj = this.state.interactables.find(o => {\n      const oGX = Math.floor(o.x / TILE_SIZE);\n      const oGY = Math.floor(o.y / TILE_SIZE);\n      const oGW = Math.ceil(o.width / TILE_SIZE);\n      const oGH = Math.ceil(o.height / TILE_SIZE);\n      return facing.gx >= oGX && facing.gx < oGX + oGW && facing.gy >= oGY && facing.gy < oGY + oGH;\n    });\n\n    if (!obj) return;\n\n    switch (obj.type) {\n      case 'shelf':\n      case 'fridge': {\n        const info = this.shelfInteraction.interactWithShelf(obj.id, this.state.interactables, this.productManager);\n        if (info) {\n          this.state.activePanel = UIPanel.SHELF;\n          this.onNotification?.(`货架: ${info.label} — ${info.productName ?? '空'} (${info.quantity}/${info.maxQuantity})`);\n        }\n        break;\n      }\n      case 'register': {\n        const register = this.registers.find(r => r.registerId === obj.id);\n        const waiting = this.customerManager.getFirstWaiting();\n        if (register && register.canAcceptCustomer() && waiting) {\n          register.startCheckout(waiting, this.productManager, this.pricing);\n          this.onNotification?.('开始收银...');\n        } else if (register && !register.canAcceptCustomer()) {\n          this.onNotification?.('收银中...');\n        } else {\n          this.onNotification?.('收银台 — 没有顾客等待');\n        }\n        break;\n      }\n      case 'door':\n        this.onNotification?.(`交互: ${obj.label}`);\n        break;\n      default:\n        this.onNotification?.(`交互: ${obj.label}`);\n    }\n  }\n\n  private onNewDay(): void {\n    const report = this.economy.endDay();\n\n    // M3: Generate day summary with display\n    this.daySummary.generateSummary(report, this.customerManager);\n\n    // Create day summary record\n    const stats = this.customerManager.getStats();\n    this.state.daySummaries.push({\n      day: report.day,\n      revenue: report.revenue,\n      expenses: report.expenses,\n      customersServed: stats.served,\n      customersLost: stats.lost,\n      debtRemaining: report.debtRemaining,\n    });\n\n    this.state.dailyRevenue = 0;\n    this.state.dailyExpenses = 0;\n    this.customerManager.resetDailyStats();\n    this.pricing.resetDailyVelocity();\n\n    this.addNotification(`Day ${report.day} 结算: 收入¥${report.revenue} 支出¥${report.expenses} 债务¥${report.debtRemaining}`);\n\n    // M3: Auto-save after day end\n    this.saveManager.save(this.state);\n\n    // Check game over\n    const gameOver = this.economy.isGameOver();\n    if (gameOver.over) {\n      this.addNotification(`游戏结束: ${gameOver.reason}`);\n    }\n  }\n\n  private addNotification(text: string): void {\n    this.state.notifications.push(text);\n    if (this.state.notifications.length > 10) {\n      this.state.notifications.shift();\n    }\n    this.onNotification?.(text);\n  }\n\n  // Public API for UI interaction\n  stockShelf(shelfId: string, productId: string, quantity: number): void {\n    this.shelfInteraction.stockShelf(shelfId, productId, quantity, this.productManager);\n  }\n\n  unstockShelf(shelfId: string, quantity: number): void {\n    this.shelfInteraction.unstockShelf(shelfId, quantity, this.productManager);\n  }\n\n  orderProduct(productId: string, quantity: number, supplierId: string): boolean {\n    const order = this.productManager.orderProduct(productId, quantity, supplierId, this.state.day);\n    if (order) {\n      this.economy.addPurchaseCost(order.totalCost);\n      this.state.money = this.economy.getMoney();\n      const product = this.productManager.getProduct(productId);\n      this.addNotification(`下单: ${product?.name} x${quantity} — ¥${order.totalCost}`);\n      return true;\n    }\n    return false;\n  }\n\n  purchaseUpgrade(upgradeId: string): { success: boolean; message: string } {\n    const result = this.economy.purchaseUpgrade(upgradeId);\n    if (result.success) {\n      this.state.money = this.economy.getMoney();\n      this.applyUpgrades();\n      this.addNotification(result.message);\n    }\n    return result;\n  }\n\n  purchaseUpgradeM3(upgradeId: string): { success: boolean; message: string } {\n    const result = this.upgradeManager.purchase(upgradeId, this.state.money);\n    if (result.success) {\n      this.economy.addExpense(result.cost);\n      this.state.money = this.economy.getMoney();\n      this.applyUpgrades();\n      this.addNotification(result.message);\n    }\n    return { success: result.success, message: result.message };\n  }\n\n  setProductPrice(productId: string, price: number): boolean {\n    return this.pricing.setPrice(productId, price);\n  }\n\n  centerCamera(): void {\n    this.renderer.camera.snapTo(this.player.x + 16, this.player.y + 16);\n  }\n\n  setTimeSpeed(speed: number): void {\n    this.state.timeSpeed = speed;\n  }\n}\n","numLines":557,"startLine":1,"totalLines":557}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01b592c19eea4983b25441b3","type":"tool_result","content":"1\t// GameState.ts — Game state with save/load interface (v0.2.0 — M2)\n2\t\n3\texport enum GamePhase {\n4\t  MENU = 'menu',\n5\t  DAYTIME = 'daytime',\n6\t  NIGHT_TRANSITION = 'night_transition',\n7\t  NIGHT = 'night',\n8\t  DANGER = 'danger',\n9\t  DAWN = 'dawn',\n10\t  PAUSED = 'paused',\n11\t}\n12\t\n13\texport enum UIPanel {\n14\t  NONE = 'none',\n15\t  INVENTORY = 'inventory',\n16\t  SHELF = 'shelf',\n17\t  PRICING = 'pricing',\n18\t  SHOP = 'shop',\n19\t  SUPPLIER = 'supplier',\n20\t  REGISTER = 'register',\n21\t}\n22\t\n23\texport interface Position {\n24\t  x: number;\n25\t  y: number;\n26\t}\n27\t\n28\texport interface PlayerState {\n29\t  x: number;\n30\t  y: number;\n31\t  speed: number;\n32\t  direction: 'up' | 'down' | 'left' | 'right';\n33\t  money: number;\n34\t  debt: number;\n35\t  day: number;\n36\t  health: number;\n37\t  sanity: number;\n38\t}\n39\t\n40\texport interface LightSource {\n41\t  x: number;\n42\t  y: number;\n43\t  radius: number;\n44\t  color: string;\n45\t  intensity: number;\n46\t  flicker: boolean;\n47\t  flickerSpeed: number;\n48\t}\n49\t\n50\texport interface Interactable {\n51\t  id: string;\n52\t  type: 'shelf' | 'register' | 'door' | 'fridge' | 'storage' | 'phone' | 'radio' | 'note';\n53\t  x: number;\n54\t  y: number;\n55\t  width: number;\n56\t  height: number;\n57\t  label: string;\n58\t  active: boolean;\n59\t}\n60\t\n61\texport interface DaySummary {\n62\t  day: number;\n63\t  revenue: number;\n64\t  expenses: number;\n65\t  customersServed: number;\n66\t  customersLost: number;\n67\t  debtRemaining: number;\n68\t}\n69\t\n70\texport interface GameState {\n71\t  phase: GamePhase;\n72\t  activePanel: UIPanel;\n73\t  player: PlayerState;\n74\t  day: number;\n75\t  timeOfDay: number; // 0-24 hours (6=6am, 23=11pm etc)\n76\t  timeSpeed: number;\n77\t  lights: LightSource[];\n78\t  interactables: Interactable[];\n79\t  totalPlaytime: number;\n80\t  lastSaveTime: number;\n81\t  version: string;\n82\t\n83\t  // M2: Economy\n84\t  money: number;\n85\t  debt: number;\n86\t  dailyRevenue: number;\n87\t  dailyExpenses: number;\n88\t\n89\t  // M2: Notifications\n90\t  notifications: string[];\n91\t  daySummaries: DaySummary[];\n92\t}\n93\t\n94\texport interface SaveData {\n95\t  version: string;\n96\t  timestamp: number;\n97\t  playtime: number;\n98\t  gameState: GameState;\n99\t  productManager: Record<string, unknown>;\n100\t  economy: Record<string, unknown>;\n101\t  pricing: Record<string, unknown>;\n102\t  customerStats: Record<string, unknown>;\n103\t  registers: Record<string, unknown>[];\n104\t}\n105\t\n106\texport const CURRENT_VERSION = '0.3.0';\n107\tconst SAVE_KEY = 'midnight_store_save';\n108\t\n109\texport function createInitialState(): GameState {\n110\t  const TILE = 32;\n111\t  return {\n112\t    phase: GamePhase.DAYTIME,\n113\t    activePanel: UIPanel.NONE,\n114\t    player: {\n115\t      x: 15 * TILE,\n116\t      y: 5 * TILE,\n117\t      speed: 150,\n118\t      direction: 'down',\n119\t      money: 500,\n120\t      debt: 300000,\n121\t      day: 1,\n122\t      health: 100,\n123\t      sanity: 100,\n124\t    },\n125\t    day: 1,\n126\t    timeOfDay: 6,\n127\t    timeSpeed: 1,\n128\t    lights: [],\n129\t    interactables: [],\n130\t    totalPlaytime: 0,\n131\t    lastSaveTime: Date.now(),\n132\t    version: CURRENT_VERSION,\n133\t\n134\t    money: 500,\n135\t    debt: 300000,\n136\t    dailyRevenue: 0,\n137\t    dailyExpenses: 0,\n138\t    notifications: [],\n139\t    daySummaries: [],\n140\t  };\n141\t}\n142\t\n143\texport function cloneState(state: GameState): GameState {\n144\t  return JSON.parse(JSON.stringify(state));\n145\t}\n146\t\n147\texport function saveGame(\n148\t  state: GameState,\n149\t  pm?: Record<string, unknown>,\n150\t  eco?: Record<string, unknown>,\n151\t  prc?: Record<string, unknown>,\n152\t  cust?: Record<string, unknown>,\n153\t  regs?: Record<string, unknown>[],\n154\t): void {\n155\t  const data: SaveData = {\n156\t    version: CURRENT_VERSION,\n157\t    timestamp: Date.now(),\n158\t    playtime: state.totalPlaytime,\n159\t    gameState: state,\n160\t    productManager: pm ?? {},\n161\t    economy: eco ?? {},\n162\t    pricing: prc ?? {},\n163\t    customerStats: cust ?? {},\n164\t    registers: regs ?? [],\n165\t  };\n166\t  try {\n167\t    localStorage.setItem(SAVE_KEY, JSON.stringify(data));\n168\t  } catch {\n169\t    console.warn('Save failed: storage quota exceeded');\n170\t  }\n171\t}\n172\t\n173\texport function loadGame(): SaveData | null {\n174\t  try {\n175\t    const raw = localStorage.getItem(SAVE_KEY);\n176\t    if (!raw) return null;\n177\t    return JSON.parse(raw) as SaveData;\n178\t  } catch {\n179\t    return null;\n180\t  }\n181\t}\n182\t\n183\texport function clearSave(): void {\n184\t  localStorage.removeItem(SAVE_KEY);\n185\t}\n186\t\n187\tlet autoSaveTimer = 0;\n188\t\n189\texport function startAutoSave(\n190\t  getState: () => GameState,\n191\t  getExtra?: () => {\n192\t    pm?: Record<string, unknown>;\n193\t    eco?: Record<string, unknown>;\n194\t    prc?: Record<string, unknown>;\n195\t    cust?: Record<string, unknown>;\n196\t    regs?: Record<string, unknown>[];\n197\t  },\n198\t  intervalMs: number = 300000,\n199\t): void {\n200\t  stopAutoSave();\n201\t  autoSaveTimer = window.setInterval(() => {\n202\t    const extra = getExtra?.();\n203\t    saveGame(\n204\t      getState(),\n205\t      extra?.pm,\n206\t      extra?.eco,\n207\t      extra?.prc,\n208\t      extra?.cust,\n209\t      extra?.regs,\n210\t    );\n211\t  }, intervalMs);\n212\t}\n213\t\n214\texport function stopAutoSave(): void {\n215\t  if (autoSaveTimer) {\n216\t    clearInterval(autoSaveTimer);\n217\t    autoSaveTimer = 0;\n218\t  }\n219\t}\n220\t\n221\texport function getTimeString(timeOfDay: number): string {\n222\t  const hours = Math.floor(timeOfDay) % 24;\n223\t  const minutes = Math.floor((timeOfDay % 1) * 60);\n224\t  return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;\n225\t}\n226\t\n227\texport function getPhaseFromTime(timeOfDay: number): GamePhase {\n228\t  if (timeOfDay >= 6 && timeOfDay < 22) return GamePhase.DAYTIME;\n229\t  if (timeOfDay >= 22 && timeOfDay < 23) return GamePhase.NIGHT_TRANSITION;\n230\t  if (timeOfDay >= 23 || timeOfDay < 2) return GamePhase.NIGHT;\n231\t  if (timeOfDay >= 2 && timeOfDay < 5) return GamePhase.DANGER;\n232\t  return GamePhase.DAWN;\n233\t}\n234\t\n235\texport function isNightTime(phase: GamePhase): boolean {\n236\t  return phase === GamePhase.NIGHT_TRANSITION ||\n237\t    phase === GamePhase.NIGHT ||\n238\t    phase === GamePhase.DANGER;\n239\t}\n240\t"}]},"parent_tool_use_id":null,"session_id":"392f64db-fdde-44d3-ac09-12e89ef6a334","uuid":"0008bbcb-36a3-400f-bf2c-b98329921705","timestamp":"2026-05-23T04:48:20.746Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-horror-sim\\src\\game\\GameState.ts","content":"// GameState.ts — Game state with save/load interface (v0.2.0 — M2)\n\nexport enum GamePhase {\n  MENU = 'menu',\n  DAYTIME = 'daytime',\n  NIGHT_TRANSITION = 'night_transition',\n  NIGHT = 'night',\n  DANGER = 'danger',\n  DAWN = 'dawn',\n  PAUSED = 'paused',\n}\n\nexport enum UIPanel {\n  NONE = 'none',\n  INVENTORY = 'inventory',\n  SHELF = 'shelf',\n  PRICING = 'pricing',\n  SHOP = 'shop',\n  SUPPLIER = 'supplier',\n  REGISTER = 'register',\n}\n\nexport interface Position {\n  x: number;\n  y: number;\n}\n\nexport interface PlayerState {\n  x: number;\n  y: number;\n  speed: number;\n  direction: 'up' | 'down' | 'left' | 'right';\n  money: number;\n  debt: number;\n  day: number;\n  health: number;\n  sanity: number;\n}\n\nexport interface LightSource {\n  x: number;\n  y: number;\n  radius: number;\n  color: string;\n  intensity: number;\n  flicker: boolean;\n  flickerSpeed: number;\n}\n\nexport interface Interactable {\n  id: string;\n  type: 'shelf' | 'register' | 'door' | 'fridge' | 'storage' | 'phone' | 'radio' | 'note';\n  x: number;\n  y: number;\n  width: number;\n  height: number;\n  label: string;\n  active: boolean;\n}\n\nexport interface DaySummary {\n  day: number;\n  revenue: number;\n  expenses: number;\n  customersServed: number;\n  customersLost: number;\n  debtRemaining: number;\n}\n\nexport interface GameState {\n  phase: GamePhase;\n  activePanel: UIPanel;\n  player: PlayerState;\n  day: number;\n  timeOfDay: number; // 0-24 hours (6=6am, 23=11pm etc)\n  timeSpeed: number;\n  lights: LightSource[];\n  interactables: Interactable[];\n  totalPlaytime: number;\n  lastSaveTime: number;\n  version: string;\n\n  // M2: Economy\n  money: number;\n  debt: number;\n  dailyRevenue: number;\n  dailyExpenses: number;\n\n  // M2: Notifications\n  notifications: string[];\n  daySummaries: DaySummary[];\n}\n\nexport interface SaveData {\n  version: string;\n  timestamp: number;\n  playtime: number;\n  gameState: GameState;\n  productManager: Record<string, unknown>;\n  economy: Record<string, unknown>;\n  pricing: Record<string, unknown>;\n  customerStats: Record<string, unknown>;\n  registers: Record<string, unknown>[];\n}\n\nexport const CURRENT_VERSION = '0.3.0';\nconst SAVE_KEY = 'midnight_store_save';\n\nexport function createInitialState(): GameState {\n  const TILE = 32;\n  return {\n    phase: GamePhase.DAYTIME,\n    activePanel: UIPanel.NONE,\n    player: {\n      x: 15 * TILE,\n      y: 5 * TILE,\n      speed: 150,\n      direction: 'down',\n      money: 500,\n      debt: 300000,\n      day: 1,\n      health: 100,\n      sanity: 100,\n    },\n    day: 1,\n    timeOfDay: 6,\n    timeSpeed: 1,\n    lights: [],\n    interactables: [],\n    totalPlaytime: 0,\n    lastSaveTime: Date.now(),\n    version: CURRENT_VERSION,\n\n    money: 500,\n    debt: 300000,\n    dailyRevenue: 0,\n    dailyExpenses: 0,\n    notifications: [],\n    daySummaries: [],\n  };\n}\n\nexport function cloneState(state: GameState): GameState {\n  return JSON.parse(JSON.stringify(state));\n}\n\nexport function saveGame(\n  state: GameState,\n  pm?: Record<string, unknown>,\n  eco?: Record<string, unknown>,\n  prc?: Record<string, unknown>,\n  cust?: Record<string, unknown>,\n  regs?: Record<string, unknown>[],\n): void {\n  const data: SaveData = {\n    version: CURRENT_VERSION,\n    timestamp: Date.now(),\n    playtime: state.totalPlaytime,\n    gameState: state,\n    productManager: pm ?? {},\n    economy: eco ?? {},\n    pricing: prc ?? {},\n    customerStats: cust ?? {},\n    registers: regs ?? [],\n  };\n  try {\n    localStorage.setItem(SAVE_KEY, JSON.stringify(data));\n  } catch {\n    console.warn('Save failed: storage quota exceeded');\n  }\n}\n\nexport function loadGame(): SaveData | null {\n  try {\n    const raw = localStorage.getItem(SAVE_KEY);\n    if (!raw) return null;\n    return JSON.parse(raw) as SaveData;\n  } catch {\n    return null;\n  }\n}\n\nexport function clearSave(): void {\n  localStorage.removeItem(SAVE_KEY);\n}\n\nlet autoSaveTimer = 0;\n\nexport function startAutoSave(\n  getState: () => GameState,\n  getExtra?: () => {\n    pm?: Record<string, unknown>;\n    eco?: Record<string, unknown>;\n    prc?: Record<string, unknown>;\n    cust?: Record<string, unknown>;\n    regs?: Record<string, unknown>[];\n  },\n  intervalMs: number = 300000,\n): void {\n  stopAutoSave();\n  autoSaveTimer = window.setInterval(() => {\n    const extra = getExtra?.();\n    saveGame(\n      getState(),\n      extra?.pm,\n      extra?.eco,\n      extra?.prc,\n      extra?.cust,\n      extra?.regs,\n    );\n  }, intervalMs);\n}\n\nexport function stopAutoSave(): void {\n  if (autoSaveTimer) {\n    clearInterval(autoSaveTimer);\n    autoSaveTimer = 0;\n  }\n}\n\nexport function getTimeString(timeOfDay: number): string {\n  const hours = Math.floor(timeOfDay) % 24;\n  const minutes = Math.floor((timeOfDay % 1) * 60);\n  return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;\n}\n\nexport function getPhaseFromTime(timeOfDay: number): GamePhase {\n  if (timeOfDay >= 6 && timeOfDay < 22) return GamePhase.DAYTIME;\n  if (timeOfDay >= 22 && timeOfDay < 23) return GamePhase.NIGHT_TRANSITION;\n  if (timeOfDay >= 23 || timeOfDay < 2) return GamePhase.NIGHT;\n  if (timeOfDay >= 2 && timeOfDay < 5) return GamePhase.DANGER;\n  return GamePhase.DAWN;\n}\n\nexport function isNightTime(phase: GamePhase): boolean {\n  return phase === GamePhase.NIGHT_TRANSITION ||\n    phase === GamePhase.NIGHT ||\n    phase === GamePhase.DANGER;\n}\n","numLines":240,"startLine":1,"totalLines":240}}}
