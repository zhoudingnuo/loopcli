Id: 'monster_hunter', count: 1 } },\n  { id: 'collect_vein_depth', name: '灵脉探险', nameEn: 'Vein Explorer', description: '在灵脉深处建造灵液提取器', category: 'collection', condition: { type: 'building_count', buildingId: 'vein_extractor', count: 1 } },\n  { id: 'collect_immortal', name: '仙石开采', nameEn: 'Immortal Mining', description: '建造仙灵矿机', category: 'collection', condition: { type: 'building_count', buildingId: 'immortal_mine', count: 1 } },\n  { id: 'collect_merit', name: '功德祭坛', nameEn: 'Merit Altar', description: '建造功德祭坛', category: 'collection', condition: { type: 'building_count', buildingId: 'merit_altar', count: 1 } },\n  { id: 'collect_yuanying_furnace', name: '元婴丹师', nameEn: 'Soul Alchemist', description: '建造元婴果炉', category: 'collection', condition: { type: 'building_count', buildingId: 'furnace_yuanyingguo', count: 1 } },\n  { id: 'collect_huashen_furnace', name: '化神炼丹', nameEn: 'Severing Alchemist', description: '建造化神露炉', category: 'collection', condition: { type: 'building_count', buildingId: 'furnace_huashenlu', count: 1 } },\n  { id: 'collect_jiuzhuan_furnace', name: '九转炉成', nameEn: 'Nine-Turn Furnace', description: '建造九转金丹炉', category: 'collection', condition: { type: 'building_count', buildingId: 'furnace_jiuzhuan', count: 1 } },\n\n  // Hidden achievements (5)\n  { id: 'hidden_playtime_10', name: '闭关七日', nameEn: 'Secluded Cultivation', description: '游玩超过10小时', category: 'hidden', condition: { type: 'playtime_hours', hours: 10 } },\n  { id: 'hidden_playtime_50', name: '修仙五十年', nameEn: 'Fifty Years', description: '游玩超过50小时', category: 'hidden', condition: { type: 'playtime_hours', hours: 50 } },\n  { id: 'hidden_all_regions', name: '踏遍灵山', nameEn: 'Mountain Walker', description: '解锁所有地图区域', category: 'hidden', condition: { type: 'region_unlocked', regionId: 'sky_peak' } },\n  { id: 'hidden_immortal_mine_5', name: '仙石大亨', nameEn: 'Immortal Baron', description: '拥有5座仙灵矿机', category: 'hidden', condition: { type: 'building_count', buildingId: 'immortal_mine', count: 5 } },\n  { id: 'hidden_10_cross_links', name: '空间大师', nameEn: 'Space Master', description: '建立10条跨区域链路', category: 'hidden', condition: { type: 'cross_region_links', count: 10 } },\n];\n\nexport function getAllAchievements(): AchievementDef[] {\n  return ACHIEVEMENT_DEFS;\n}\n\nexport function getAchievement(id: string): AchievementDef | undefined {\n  return ACHIEVEMENT_DEFS.find(a => a.id === id);\n}\n\nexport function checkAchievement(\n  def: AchievementDef,\n  context: AchievementContext,\n): boolean {\n  const cond = def.condition;\n\n  switch (cond.type) {\n    case 'realm_reached': {\n      const idx = context.realmOrder.indexOf(cond.realmId);\n      return context.realmOrder.indexOf(context.currentRealmId) >= idx;\n    }\n    case 'resource_collected':\n      return (context.totalResourcesCollected[cond.resource] ?? 0) >= cond.totalAmount;\n    case 'building_count': {\n      if (cond.buildingId === 'any_conveyor') {\n        const count = (context.buildingCounts['conveyor_lv1'] ?? 0) + (context.buildingCounts['conveyor_lv2'] ?? 0);\n        return count >= cond.count;\n      }\n      return (context.buildingCounts[cond.buildingId] ?? 0) >= cond.count;\n    }\n    case 'pill_crafted':\n      if (cond.pillId === 'any') return (context.totalPillsCrafted ?? 0) >= cond.count;\n      if (cond.pillId === 'all') return context.allPillTypesCrafted;\n      return (context.pillsCrafted[cond.pillId] ?? 0) >= cond.count;\n    case 'region_unlocked':\n      return context.unlockedRegions.includes(cond.regionId);\n    case 'ascension_completed':\n      return context.ascensionCompleted;\n    case 'total_buildings':\n      return context.totalBuildingCount >= cond.count;\n    case 'playtime_hours':\n      return context.playtimeHours >= cond.hours;\n    case 'cross_region_links':\n      return context.crossRegionLinkCount >= cond.count;\n  }\n}\n\nexport interface AchievementContext {\n  currentRealmId: string;\n  realmOrder: string[];\n  totalResourcesCollected: Record<string, number>;\n  buildingCounts: Record<string, number>;\n  totalBuildingCount: number;\n  pillsCrafted: Record<string, number>;\n  totalPillsCrafted: number;\n  allPillTypesCrafted: boolean;\n  unlockedRegions: string[];\n  ascensionCompleted: boolean;\n  playtimeHours: number;\n  crossRegionLinkCount: number;\n}\n","numLines":134,"startLine":1,"totalLines":134}}}
