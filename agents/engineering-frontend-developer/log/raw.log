 ')', result)\n    result = re.sub(r'\\[\\s+', '[', result)\n    result = re.sub(r'\\s+\\]', ']', result)\n    result = re.sub(r'\\{\\s+', '{', result)\n    result = re.sub(r'\\s+\\}', '}', result)\n\n    # Remove trailing semicolons before } (safe)\n    result = re.sub(r';\\s*}', '}', result)\n\n    # Remove leading/trailing whitespace\n    result = result.strip()\n\n    return result\n\n\ndef minify_html(source):\n    \"\"\"Basic HTML minification\"\"\"\n    result = source\n\n    # Remove HTML comments (non-conditional)\n    result = re.sub(r'<!--(?!\\[if).*?-->', '', result, flags=re.DOTALL)\n\n    # Collapse whitespace between tags\n    result = re.sub(r'>\\s+<', '><', result)\n\n    # Remove leading/trailing whitespace per line\n    lines = [line.strip() for line in result.split('\\n')]\n    result = '\\n'.join(line for line in lines if line)\n\n    return result\n\n\ndef build_js_files():\n    \"\"\"Minify all JS files from src/js to dist/src/js\"\"\"\n    js_files = [f for f in os.listdir(SRC_JS) if f.endswith('.js')]\n    total_before = 0\n    total_after = 0\n\n    for filename in js_files:\n        src_path = os.path.join(SRC_JS, filename)\n        dst_path = os.path.join(DIST, 'src', 'js', filename)\n\n        with open(src_path, 'r', encoding='utf-8') as f:\n            source = f.read()\n\n        minified = minify_js(source)\n        total_before += len(source)\n        total_after += len(minified)\n\n        with open(dst_path, 'w', encoding='utf-8') as f:\n            f.write(minified)\n\n        ratio = (1 - len(minified) / max(len(source), 1)) * 100\n        print(f'  {filename}: {len(source):>6} -> {len(minified):>6} ({ratio:.1f}% saved)')\n\n    return total_before, total_after\n\n\ndef build_index_html():\n    \"\"\"Minify index.html and update paths\"\"\"\n    src_path = os.path.join(ROOT, 'index.html')\n    dst_path = os.path.join(DIST, 'index.html')\n\n    with open(src_path, 'r', encoding='utf-8') as f:\n        source = f.read()\n\n    minified = minify_html(source)\n\n    with open(dst_path, 'w', encoding='utf-8') as f:\n        f.write(minified)\n\n    print(f'  index.html: {len(source)} -> {len(minified)} '\n          f'({(1 - len(minified) / len(source)) * 100:.1f}% saved)')\n\n\ndef copy_static_files():\n    \"\"\"Copy non-JS files to dist\"\"\"\n    for filename in ['game.json', 'project.config.json', 'package.json']:\n        src = os.path.join(ROOT, filename)\n        dst = os.path.join(DIST, filename)\n        if os.path.exists(src):\n            shutil.copy2(src, dst)\n            print(f'  Copied {filename}')\n\n\ndef check_size():\n    \"\"\"Check total dist size against 4MB limit\"\"\"\n    total = 0\n    for root, dirs, files in os.walk(DIST):\n        for f in files:\n            total += os.path.getsize(os.path.join(root, f))\n\n    mb = total / (1024 * 1024)\n    status = 'OK' if total < 4 * 1024 * 1024 else 'OVER LIMIT'\n    print(f'\\n  Total size: {mb:.2f} MB ({status}, limit: 4 MB)')\n\n\ndef main():\n    print('=== 消消消大作战 Build Script ===\\n')\n\n    print('1. Creating dist directory...')\n    ensure_dist()\n\n    print('\\n2. Minifying JS files...')\n    before, after = build_js_files()\n    print(f'  JS total: {before} -> {after} ({(1 - after / max(before, 1)) * 100:.1f}% saved)')\n\n    print('\\n3. Minifying index.html...')\n    build_index_html()\n\n    print('\\n4. Copying static files...')\n    copy_static_files()\n\n    print('\\n5. Size check...')\n    check_size()\n\n    print('\\n=== Build complete! ===')\n    print(f'Output: {DIST}')\n    print('Next: Upload dist/ contents to 抖音小游戏开发者工具 for submission')\n\n\nif __name__ == '__main__':\n    main()\n","structuredPatch":[],"originalFile":null,"userModified":false}}
