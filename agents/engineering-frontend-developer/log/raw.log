{"type":"assistant","message":{"id":"msg_20260523103606ecf0844ec3b84d1d","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_45612847d620490b854da92d","name":"Write","input":{"file_path":"D:\\game-projects\\steam-cultivation-factory\\src\\main\\SteamIntegration.ts","content":"// SteamIntegration.ts — Steam API wrapper with graceful fallback (v0.5.0)\n// Uses steamworks.js for achievement + cloud save integration\n\nlet steamworks: any = null;\nlet initialized = false;\n\nexport interface SteamAchievement {\n  id: string;\n  name: string;\n  unlocked: boolean;\n}\n\nexport function initSteam(): boolean {\n  if (initialized) return steamworks !== null;\n\n  try {\n    steamworks = require('steamworks.js');\n    const success = steamworks.init();\n    if (success) {\n      initialized = true;\n      console.log('[Steam] Initialized successfully');\n      return true;\n    }\n    console.warn('[Steam] Init returned false, running without Steam');\n    steamworks = null;\n    initialized = true;\n    return false;\n  } catch (err) {\n    console.warn('[Steam] Not available, running without Steam features:', (err as Error).message);\n    steamworks = null;\n    initialized = true;\n    return false;\n  }\n}\n\nexport function isSteamRunning(): boolean {\n  return steamworks !== null && initialized;\n}\n\n// Achievement mapping: game achievement ID -> Steam achievement API name\nconst ACHIEVEMENT_MAP: Record<string, string> = {\n  realm_liqi: 'REALM_LIQI',\n  realm_zhuji: 'REALM_ZHUJI',\n  realm_jindan: 'REALM_JINDAN',\n  realm_yuanying: 'REALM_YUANYING',\n  realm_huashen: 'REALM_HUASHEN',\n  ascension: 'ASCENSION',\n\n  prod_stone_1k: 'PROD_STONE_1K',\n  prod_stone_1m: 'PROD_STONE_1M',\n  prod_grass_500: 'PROD_GRASS_500',\n  prod_pill_100: 'PROD_PILL_100',\n  prod_pill_1000: 'PROD_PILL_1000',\n  prod_monster_core_100: 'PROD_MONSTER_CORE_100',\n  prod_liquid_50: 'PROD_LIQUID_50',\n  prod_immortal_20: 'PROD_IMMORTAL_20',\n  prod_merit_100: 'PROD_MERIT_100',\n  prod_jiuzhuan: 'PROD_JIUZHUAN',\n\n  auto_first_conveyor: 'AUTO_FIRST_CONVEYOR',\n  auto_10_conveyors: 'AUTO_10_CONVEYORS',\n  auto_first_puppet: 'AUTO_FIRST_PUPPET',\n  auto_5_puppets: 'AUTO_5_PUPPETS',\n  auto_smart_core: 'AUTO_SMART_CORE',\n  auto_cross_region: 'AUTO_CROSS_REGION',\n  auto_5_cross: 'AUTO_5_CROSS',\n  auto_space_fold: 'AUTO_SPACE_FOLD',\n  auto_50_buildings: 'AUTO_50_BUILDINGS',\n  auto_200_buildings: 'AUTO_200_BUILDINGS',\n\n  collect_all_pills: 'COLLECT_ALL_PILLS',\n  collect_monster_hunter: 'COLLECT_MONSTER_HUNTER',\n  collect_vein_depth: 'COLLECT_VEIN_DEPTH',\n  collect_immortal: 'COLLECT_IMMORTAL',\n  collect_merit: 'COLLECT_MERIT',\n  collect_yuanying_furnace: 'COLLECT_YUANYING_FURNACE',\n  collect_huashen_furnace: 'COLLECT_HUASHEN_FURNACE',\n  collect_jiuzhuan_furnace: 'COLLECT_JIUZHUAN_FURNACE',\n\n  hidden_playtime_10: 'HIDDEN_PLAYTIME_10',\n  hidden_playtime_50: 'HIDDEN_PLAYTIME_50',\n  hidden_all_regions: 'HIDDEN_ALL_REGIONS',\n  hidden_immortal_mine_5: 'HIDDEN_IMMORTAL_MINE_5',\n  hidden_10_cross_links: 'HIDDEN_10_CROSS_LINKS',\n};\n\nexport function unlockAchievement(gameAchievementId: string): boolean {\n  if (!steamworks) return false;\n\n  const steamId = ACHIEVEMENT_MAP[gameAchievementId];\n  if (!steamId) {\n    console.warn(`[Steam] No mapping for achievement: ${gameAchievementId}`);\n    return false;\n  }\n\n  try {\n    steamworks.achievement.activate(steamId);\n    console.log(`[Steam] Achievement unlocked: ${steamId}`);\n    return true;\n  } catch (err) {\n    console.warn(`[Steam] Failed to unlock ${steamId}:`, (err as Error).message);\n    return false;\n  }\n}\n\nexport function getAchievement(steamId: string): boolean {\n  if (!steamworks) return false;\n  try {\n    return steamworks.achievement.isActivated(steamId);\n  } catch {\n    return false;\n  }\n}\n\nexport function getAllAchievements(): SteamAchievement[] {\n  if (!steamworks) return [];\n  const results: SteamAchievement[] = [];\n  for (const [gameId, steamId] of Object.entries(ACHIEVEMENT_MAP)) {\n    results.push({\n      id: gameId,\n      name: steamId,\n      unlocked: getAchievement(steamId),\n    });\n  }\n  return results;\n}\n\n// Cloud save integration\nconst CLOUD_SAVE_KEY = 'cultivation_factory_save';\n\nexport function saveToCloud(data: string): boolean {\n  if (!steamworks) return false;\n  try {\n    steamworks.cloud.saveToFile(CLOUD_SAVE_KEY, data);\n    console.log('[Steam] Cloud save successful');\n    return true;\n  } catch (err) {\n    console.warn('[Steam] Cloud save failed:', (err as Error).message);\n    return false;\n  }\n}\n\nexport function loadFromCloud(): string | null {\n  if (!steamworks) return null;\n  try {\n    const exists = steamworks.cloud.isFileExists(CLOUD_SAVE_KEY);\n    if (!exists) return null;\n    const data = steamworks.cloud.readFile(CLOUD_SAVE_KEY);\n    console.log('[Steam] Cloud load successful');\n    return data;\n  } catch (err) {\n    console.warn('[Steam] Cloud load failed:', (err as Error).message);\n    return null;\n  }\n}\n\nexport function shutdownSteam(): void {\n  if (steamworks) {\n    try {\n      steamworks.shutdown();\n      console.log('[Steam] Shutdown complete');\n    } catch {\n      // Ignore shutdown errors\n    }\n    steamworks = null;\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"6abd1a50-ca4f-4f48-ad3d-d0b1dc08d31a","uuid":"2c0a5937-572e-47e1-93a1-f4faa3a782c2"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_45612847d620490b854da92d","type":"tool_result","content":"File created successfully at: D:\\game-projects\\steam-cultivation-factory\\src\\main\\SteamIntegration.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"6abd1a50-ca4f-4f48-ad3d-d0b1dc08d31a","uuid":"d064ce85-4d0f-4b6c-8722-2716da4531f3","timestamp":"2026-05-23T02:36:32.513Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\main\\SteamIntegration.ts","content":"// SteamIntegration.ts — Steam API wrapper with graceful fallback (v0.5.0)\n// Uses steamworks.js for achievement + cloud save integration\n\nlet steamworks: any = null;\nlet initialized = false;\n\nexport interface SteamAchievement {\n  id: string;\n  name: string;\n  unlocked: boolean;\n}\n\nexport function initSteam(): boolean {\n  if (initialized) return steamworks !== null;\n\n  try {\n    steamworks = require('steamworks.js');\n    const success = steamworks.init();\n    if (success) {\n      initialized = true;\n      console.log('[Steam] Initialized successfully');\n      return true;\n    }\n    console.warn('[Steam] Init returned false, running without Steam');\n    steamworks = null;\n    initialized = true;\n    return false;\n  } catch (err) {\n    console.warn('[Steam] Not available, running without Steam features:', (err as Error).message);\n    steamworks = null;\n    initialized = true;\n    return false;\n  }\n}\n\nexport function isSteamRunning(): boolean {\n  return steamworks !== null && initialized;\n}\n\n// Achievement mapping: game achievement ID -> Steam achievement API name\nconst ACHIEVEMENT_MAP: Record<string, string> = {\n  realm_liqi: 'REALM_LIQI',\n  realm_zhuji: 'REALM_ZHUJI',\n  realm_jindan: 'REALM_JINDAN',\n  realm_yuanying: 'REALM_YUANYING',\n  realm_huashen: 'REALM_HUASHEN',\n  ascension: 'ASCENSION',\n\n  prod_stone_1k: 'PROD_STONE_1K',\n  prod_stone_1m: 'PROD_STONE_1M',\n  prod_grass_500: 'PROD_GRASS_500',\n  prod_pill_100: 'PROD_PILL_100',\n  prod_pill_1000: 'PROD_PILL_1000',\n  prod_monster_core_100: 'PROD_MONSTER_CORE_100',\n  prod_liquid_50: 'PROD_LIQUID_50',\n  prod_immortal_20: 'PROD_IMMORTAL_20',\n  prod_merit_100: 'PROD_MERIT_100',\n  prod_jiuzhuan: 'PROD_JIUZHUAN',\n\n  auto_first_conveyor: 'AUTO_FIRST_CONVEYOR',\n  auto_10_conveyors: 'AUTO_10_CONVEYORS',\n  auto_first_puppet: 'AUTO_FIRST_PUPPET',\n  auto_5_puppets: 'AUTO_5_PUPPETS',\n  auto_smart_core: 'AUTO_SMART_CORE',\n  auto_cross_region: 'AUTO_CROSS_REGION',\n  auto_5_cross: 'AUTO_5_CROSS',\n  auto_space_fold: 'AUTO_SPACE_FOLD',\n  auto_50_buildings: 'AUTO_50_BUILDINGS',\n  auto_200_buildings: 'AUTO_200_BUILDINGS',\n\n  collect_all_pills: 'COLLECT_ALL_PILLS',\n  collect_monster_hunter: 'COLLECT_MONSTER_HUNTER',\n  collect_vein_depth: 'COLLECT_VEIN_DEPTH',\n  collect_immortal: 'COLLECT_IMMORTAL',\n  collect_merit: 'COLLECT_MERIT',\n  collect_yuanying_furnace: 'COLLECT_YUANYING_FURNACE',\n  collect_huashen_furnace: 'COLLECT_HUASHEN_FURNACE',\n  collect_jiuzhuan_furnace: 'COLLECT_JIUZHUAN_FURNACE',\n\n  hidden_playtime_10: 'HIDDEN_PLAYTIME_10',\n  hidden_playtime_50: 'HIDDEN_PLAYTIME_50',\n  hidden_all_regions: 'HIDDEN_ALL_REGIONS',\n  hidden_immortal_mine_5: 'HIDDEN_IMMORTAL_MINE_5',\n  hidden_10_cross_links: 'HIDDEN_10_CROSS_LINKS',\n};\n\nexport function unlockAchievement(gameAchievementId: string): boolean {\n  if (!steamworks) return false;\n\n  const steamId = ACHIEVEMENT_MAP[gameAchievementId];\n  if (!steamId) {\n    console.warn(`[Steam] No mapping for achievement: ${gameAchievementId}`);\n    return false;\n  }\n\n  try {\n    steamworks.achievement.activate(steamId);\n    console.log(`[Steam] Achievement unlocked: ${steamId}`);\n    return true;\n  } catch (err) {\n    console.warn(`[Steam] Failed to unlock ${steamId}:`, (err as Error).message);\n    return false;\n  }\n}\n\nexport function getAchievement(steamId: string): boolean {\n  if (!steamworks) return false;\n  try {\n    return steamworks.achievement.isActivated(steamId);\n  } catch {\n    return false;\n  }\n}\n\nexport function getAllAchievements(): SteamAchievement[] {\n  if (!steamworks) return [];\n  const results: SteamAchievement[] = [];\n  for (const [gameId, steamId] of Object.entries(ACHIEVEMENT_MAP)) {\n    results.push({\n      id: gameId,\n      name: steamId,\n      unlocked: getAchievement(steamId),\n    });\n  }\n  return results;\n}\n\n// Cloud save integration\nconst CLOUD_SAVE_KEY = 'cultivation_factory_save';\n\nexport function saveToCloud(data: string): boolean {\n  if (!steamworks) return false;\n  try {\n    steamworks.cloud.saveToFile(CLOUD_SAVE_KEY, data);\n    console.log('[Steam] Cloud save successful');\n    return true;\n  } catch (err) {\n    console.warn('[Steam] Cloud save failed:', (err as Error).message);\n    return false;\n  }\n}\n\nexport function loadFromCloud(): string | null {\n  if (!steamworks) return null;\n  try {\n    const exists = steamworks.cloud.isFileExists(CLOUD_SAVE_KEY);\n    if (!exists) return null;\n    const data = steamworks.cloud.readFile(CLOUD_SAVE_KEY);\n    console.log('[Steam] Cloud load successful');\n    return data;\n  } catch (err) {\n    console.warn('[Steam] Cloud load failed:', (err as Error).message);\n    return null;\n  }\n}\n\nexport function shutdownSteam(): void {\n  if (steamworks) {\n    try {\n      steamworks.shutdown();\n      console.log('[Steam] Shutdown complete');\n    } catch {\n      // Ignore shutdown errors\n    }\n    steamworks = null;\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
