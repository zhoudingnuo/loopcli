{"type":"assistant","message":{"id":"msg_202605230909002b39da0dc3804bff","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_6d105fb7100d49829f608559","name":"Write","input":{"file_path":"D:\\game-projects\\steam-cultivation-factory\\src\\renderer\\App.ts","content":"// App.ts — Game main loop (60FPS + deltaTime + state management + input handling)\n\nimport { Renderer } from './Renderer';\nimport { GameMap } from '../game/Map';\nimport {\n  type GameState,\n  type BuildingInstance,\n  createInitialState,\n  cloneState,\n  setMap,\n  placeBuilding,\n  loadGame,\n  saveGame,\n  startAutoSave,\n  stopAutoSave,\n} from '../game/GameState';\nimport {\n  type BuildingDef,\n  loadBuildingDefs,\n  createBuildingInstance,\n  canPlace,\n} from '../game/Building';\nimport {\n  collectFromBuilding,\n  plantField,\n  tickAutoProduction,\n  tickManualProduction,\n  canAfford,\n  deductCost,\n} from '../game/Resources';\nimport buildingData from '../data/buildings.json';\n\nexport type PlacementMode = BuildingDef | null;\n\nexport class App {\n  canvas: HTMLCanvasElement;\n  renderer: Renderer;\n  state: GameState;\n  buildingDefs: Map<string, BuildingDef>;\n  map: GameMap;\n\n  private running = false;\n  private lastFrameTime = 0;\n  private animFrameId = 0;\n  private lastTickTime = 0;\n  private tickInterval = 200; // ms between production ticks\n\n  // Input state\n  private hoveredCell: { gx: number; gy: number } | null = null;\n  private clickStartTime = 0;\n  private clickStartPos = { x: 0, y: 0 };\n  placementMode: PlacementMode = null;\n  private placementValid = false;\n  private placementPos = { gx: 0, gy: 0 };\n\n  // UI callbacks\n  onStateChange?: (state: GameState) => void;\n  onBuildingSelect?: (building: BuildingInstance | null) => void;\n\n  constructor(canvas: HTMLCanvasElement) {\n    this.canvas = canvas;\n    this.renderer = new Renderer(canvas);\n\n    // Load or create game state\n    const saved = loadGame();\n    this.state = saved ? saved : createInitialState();\n\n    // Load building definitions\n    this.buildingDefs = loadBuildingDefs(buildingData as { buildings: BuildingDef[] });\n\n    // Initialize starting map\n    this.map = new GameMap(20, 15, '#2a3a1a', '#3a4a2a');\n    this.map.generateStartingArea();\n\n    // Set map in state if fresh game\n    if (this.state.maps.length === 0) {\n      this.state = setMap(this.state, 0, {\n        regionId: 'liqi_flat',\n        width: 20,\n        height: 15,\n        terrain: this.map.terrain,\n        buildings: [],\n      });\n    }\n\n    // Setup input\n    this.setupInput(canvas);\n\n    // Handle resize\n    window.addEventListener('resize', () => {\n      this.renderer.resize();\n    });\n  }\n\n  start(): void {\n    if (this.running) return;\n    this.running = true;\n    this.lastFrameTime = performance.now();\n    this.lastTickTime = this.lastFrameTime;\n    this.loop(this.lastFrameTime);\n\n    // Auto-save every 5 minutes\n    startAutoSave(() => this.state);\n  }\n\n  stop(): void {\n    this.running = false;\n    if (this.animFrameId) {\n      cancelAnimationFrame(this.animFrameId);\n    }\n    stopAutoSave();\n    saveGame(this.state);\n  }\n\n  private loop = (now: number): void => {\n    if (!this.running) return;\n\n    const dt = now - this.lastFrameTime;\n    this.lastFrameTime = now;\n\n    // Update playtime\n    this.state.totalPlaytime += dt / 1000;\n\n    // Tick production\n    if (now - this.lastTickTime >= this.tickInterval) {\n      this.tickProduction(now);\n      this.lastTickTime = now;\n    }\n\n    // Render\n    this.render(now);\n\n    this.animFrameId = requestAnimationFrame(this.loop);\n  };\n\n  private tickProduction(now: number): void {\n    this.state = tickAutoProduction(this.state, 0, now, this.buildingDefs);\n    this.state = tickManualProduction(this.state, 0, now, this.buildingDefs);\n  }\n\n  private render(now: number): void {\n    const buildings = this.state.maps[0]?.buildings ?? [];\n    const preview = this.placementMode\n      ? {\n          def: this.placementMode,\n          gx: this.placementPos.gx,\n          gy: this.placementPos.gy,\n          valid: this.placementValid,\n        }\n      : null;\n\n    this.renderer.render(\n      this.map,\n      buildings,\n      this.buildingDefs,\n      this.state.resources,\n      this.state.realm,\n      this.hoveredCell,\n      preview,\n      now,\n    );\n  }\n\n  // Try to place a building at current placement position\n  placeCurrentBuilding(): boolean {\n    if (!this.placementMode) return false;\n\n    const def = this.placementMode;\n    const { gx, gy } = this.placementPos;\n\n    const buildings = this.state.maps[0]?.buildings ?? [];\n    if (!canPlace(this.map, def, gx, gy, buildings)) return false;\n    if (!canAfford(this.state.resources, def.cost)) return false;\n\n    // Deduct cost\n    this.state = deductCost(this.state, def.cost);\n\n    // Create and place building\n    const instance = createBuildingInstance(def.id, gx, gy);\n    this.state = placeBuilding(this.state, 0, instance);\n\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  // Handle click on a building\n  private handleBuildingClick(building: BuildingInstance): void {\n    const def = this.buildingDefs.get(building.buildingId);\n    if (!def) return;\n\n    if (def.production.mode === 'manual') {\n      if (def.category === 'farming') {\n        // Field: plant or harvest\n        if (!building.isProducing && building.progress < 1) {\n          this.state = plantField(this.state, building, 0);\n        } else if (building.progress >= 1) {\n          this.state = collectFromBuilding(this.state, building, def, 0);\n        }\n      } else if (def.category === 'mining') {\n        // Mine: instant collect\n        this.state = collectFromBuilding(this.state, building, def, 0);\n      } else if (def.category === 'alchemy') {\n        // Furnace: start crafting or collect\n        if (building.progress >= 1) {\n          this.state = collectFromBuilding(this.state, building, def, 0);\n        } else if (!building.isProducing) {\n          this.state = collectFromBuilding(this.state, building, def, 0);\n        }\n      }\n      this.onStateChange?.(this.state);\n    }\n\n    this.onBuildingSelect?.(building);\n  }\n\n  private setupInput(canvas: HTMLCanvasElement): void {\n    // Mouse move for hover\n    canvas.addEventListener('mousemove', (e) => {\n      const rect = canvas.getBoundingClientRect();\n      const mx = e.clientX - rect.left;\n      const my = e.clientY - rect.top;\n\n      const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n      this.hoveredCell = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n\n      // Update placement preview\n      if (this.placementMode && this.hoveredCell) {\n        this.placementPos = { gx: this.hoveredCell.gx, gy: this.hoveredCell.gy };\n        const buildings = this.state.maps[0]?.buildings ?? [];\n        this.placementValid = canPlace(\n          this.map,\n          this.placementMode,\n          this.placementPos.gx,\n          this.placementPos.gy,\n          buildings,\n        );\n      }\n    });\n\n    // Mouse click for building interaction\n    canvas.addEventListener('mousedown', (e) => {\n      if (e.button !== 0) return;\n      this.clickStartTime = performance.now();\n      this.clickStartPos = { x: e.clientX, y: e.clientY };\n    });\n\n    canvas.addEventListener('mouseup', (e) => {\n      if (e.button !== 0) return;\n      const dt = performance.now() - this.clickStartTime;\n      const dx = Math.abs(e.clientX - this.clickStartPos.x);\n      const dy = Math.abs(e.clientY - this.clickStartPos.y);\n\n      // Only treat as click if short press and not dragged\n      if (dt < 300 && dx < 5 && dy < 5) {\n        this.handleClick(e);\n      }\n    });\n\n    // Keyboard shortcuts\n    document.addEventListener('keydown', (e) => {\n      if (e.key === 'Escape') {\n        this.placementMode = null;\n      }\n    });\n  }\n\n  private handleClick(e: MouseEvent): void {\n    const rect = this.canvas.getBoundingClientRect();\n    const mx = e.clientX - rect.left;\n    const my = e.clientY - rect.top;\n    const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n    const { gx, gy } = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n\n    if (!this.map.inBounds(gx, gy)) return;\n\n    // Placement mode\n    if (this.placementMode) {\n      this.placementPos = { gx, gy };\n      const buildings = this.state.maps[0]?.buildings ?? [];\n      this.placementValid = canPlace(this.map, this.placementMode, gx, gy, buildings);\n      if (this.placementValid) {\n        this.placeCurrentBuilding();\n      }\n      return;\n    }\n\n    // Try to find and interact with a building at this cell\n    const buildings = this.state.maps[0]?.buildings ?? [];\n    const clicked = buildings.find(b => {\n      const def = this.buildingDefs.get(b.buildingId);\n      if (!def) return false;\n      return (\n        gx >= b.gridX && gx < b.gridX + def.size.w &&\n        gy >= b.gridY && gy < b.gridY + def.size.h\n      );\n    });\n\n    if (clicked) {\n      this.handleBuildingClick(clicked);\n    }\n  }\n\n  // Center camera on map\n  centerCamera(): void {\n    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);\n  }\n\n  // Get available buildings for current realm\n  getAvailableBuildings(): BuildingDef[] {\n    const realmKey = `${this.state.realm.realmId}_${this.state.realm.level}`;\n    return Array.from(this.buildingDefs.values()).filter(def => {\n      return isRealmUnlocked(def.unlockRealm, realmKey);\n    });\n  }\n}\n\n// Compare realm requirements: e.g. \"liqi_5\" vs \"liqi_3\" → true\nfunction isRealmUnlocked(required: string, current: string): boolean {\n  const [rRealm, rLevel] = required.split('_');\n  const [cRealm, cLevel] = current.split('_');\n  const realmOrder = ['liqi', 'zhuji', 'jindan', 'yuanying', 'huashen'];\n  const rIdx = realmOrder.indexOf(rRealm);\n  const cIdx = realmOrder.indexOf(cRealm);\n  if (cIdx > rIdx) return true;\n  if (cIdx < rIdx) return false;\n  return parseInt(cLevel) >= parseInt(rLevel);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"1027b7ea-a18e-4300-8be2-f33dc07a79d1","uuid":"54b18e4a-c029-4977-ae6c-11b00d6c96dc"}
{"type":"assistant","message":{"id":"msg_202605230909002b39da0dc3804bff","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_b889a6dd866344178127786a","name":"Write","input":{"file_path":"D:\\game-projects\\steam-cultivation-factory\\index.html","content":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>修仙自动化工厂 — Cultivation Factory</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body {\n      background: #1a1a2e;\n      color: #e0e0e0;\n      font-family: 'Segoe UI', system-ui, monospace;\n      overflow: hidden;\n      height: 100vh;\n      width: 100vw;\n    }\n    #app {\n      display: flex;\n      flex-direction: column;\n      height: 100vh;\n    }\n    #toolbar {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      padding: 6px 12px;\n      background: rgba(0,0,0,0.6);\n      border-bottom: 1px solid rgba(255,255,255,0.1);\n      min-height: 44px;\n      flex-shrink: 0;\n    }\n    #toolbar h1 {\n      font-size: 16px;\n      color: #ffd700;\n      margin-right: 12px;\n      white-space: nowrap;\n    }\n    #toolbar .spacer { flex: 1; }\n    .toolbar-btn {\n      background: rgba(255,255,255,0.08);\n      border: 1px solid rgba(255,255,255,0.15);\n      color: #e0e0e0;\n      padding: 4px 12px;\n      border-radius: 4px;\n      cursor: pointer;\n      font-size: 12px;\n      transition: background 0.2s;\n    }\n    .toolbar-btn:hover { background: rgba(255,255,255,0.15); }\n    .toolbar-btn.active { background: rgba(100,200,100,0.3); border-color: #6c6; }\n    #main {\n      display: flex;\n      flex: 1;\n      overflow: hidden;\n    }\n    #sidebar {\n      width: 220px;\n      background: rgba(0,0,0,0.5);\n      border-right: 1px solid rgba(255,255,255,0.1);\n      overflow-y: auto;\n      flex-shrink: 0;\n    }\n    .sidebar-section {\n      padding: 8px;\n      border-bottom: 1px solid rgba(255,255,255,0.05);\n    }\n    .sidebar-section h3 {\n      font-size: 12px;\n      color: #aaa;\n      margin-bottom: 6px;\n      text-transform: uppercase;\n    }\n    .building-item {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      padding: 6px 8px;\n      margin: 2px 0;\n      border-radius: 4px;\n      cursor: pointer;\n      transition: background 0.2s;\n      font-size: 12px;\n    }\n    .building-item:hover { background: rgba(255,255,255,0.1); }\n    .building-item.selected { background: rgba(100,200,100,0.2); border: 1px solid rgba(100,200,100,0.4); }\n    .building-item .icon { font-size: 18px; }\n    .building-item .info { flex: 1; }\n    .building-item .name { color: #e0e0e0; }\n    .building-item .cost { color: #888; font-size: 10px; }\n    .building-item .cost.cannot { color: #c44; }\n    #canvas-container {\n      flex: 1;\n      position: relative;\n    }\n    #gameCanvas {\n      display: block;\n      width: 100%;\n      height: 100%;\n    }\n    #info-panel {\n      width: 200px;\n      background: rgba(0,0,0,0.5);\n      border-left: 1px solid rgba(255,255,255,0.1);\n      overflow-y: auto;\n      flex-shrink: 0;\n      padding: 8px;\n    }\n    #info-panel h3 {\n      font-size: 12px;\n      color: #aaa;\n      margin-bottom: 6px;\n    }\n    .info-entry {\n      font-size: 11px;\n      padding: 3px 0;\n      color: #ccc;\n    }\n    #statusbar {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      padding: 4px 12px;\n      background: rgba(0,0,0,0.6);\n      border-top: 1px solid rgba(255,255,255,0.1);\n      font-size: 11px;\n      color: #888;\n      min-height: 28px;\n      flex-shrink: 0;\n    }\n    #statusbar .fps { color: #6a6; }\n    #placement-hint {\n      position: absolute;\n      bottom: 40px;\n      left: 50%;\n      transform: translateX(-50%);\n      background: rgba(0,0,0,0.8);\n      color: #ffd700;\n      padding: 6px 16px;\n      border-radius: 4px;\n      font-size: 12px;\n      pointer-events: none;\n      display: none;\n    }\n    /* Scrollbar styling */\n    ::-webkit-scrollbar { width: 6px; }\n    ::-webkit-scrollbar-track { background: transparent; }\n    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 3px; }\n  </style>\n</head>\n<body>\n  <div id=\"app\">\n    <div id=\"toolbar\">\n      <h1>⛰ 修仙工厂</h1>\n      <div class=\"spacer\"></div>\n      <button class=\"toolbar-btn\" id=\"btn-save\" title=\"保存游戏\">💾 保存</button>\n      <button class=\"toolbar-btn\" id=\"btn-center\" title=\"居中视角\">◎ 居中</button>\n      <button class=\"toolbar-btn\" id=\"btn-reset\" title=\"重置游戏\">⚠ 重置</button>\n    </div>\n    <div id=\"main\">\n      <div id=\"sidebar\">\n        <div class=\"sidebar-section\">\n          <h3>🏗 建筑设施</h3>\n          <div id=\"building-list\"></div>\n        </div>\n      </div>\n      <div id=\"canvas-container\">\n        <canvas id=\"gameCanvas\"></canvas>\n        <div id=\"placement-hint\">点击地图放置建筑 | ESC 取消</div>\n      </div>\n      <div id=\"info-panel\">\n        <h3>📊 信息</h3>\n        <div id=\"building-info\">点击建筑查看详情</div>\n      </div>\n    </div>\n    <div id=\"statusbar\">\n      <span class=\"fps\" id=\"fps-display\">FPS: --</span>\n      <span id=\"status-text\">就绪</span>\n      <div class=\"spacer\"></div>\n      <span id=\"playtime\">游玩时间: 0:00</span>\n    </div>\n  </div>\n\n  <script type=\"module\">\n    import { App } from './src/renderer/App.ts';\n\n    const canvas = document.getElementById('gameCanvas');\n    const app = new App(canvas);\n\n    // Center camera\n    app.centerCamera();\n\n    // FPS counter\n    let frameCount = 0;\n    let fpsTime = performance.now();\n    const fpsDisplay = document.getElementById('fps-display');\n    const statusText = document.getElementById('status-text');\n    const playtimeDisplay = document.getElementById('playtime');\n\n    setInterval(() => {\n      const now = performance.now();\n      const fps = Math.round(frameCount * 1000 / (now - fpsTime));\n      fpsDisplay.textContent = `FPS: ${fps}`;\n      frameCount = 0;\n      fpsTime = now;\n\n      // Update playtime\n      const secs = Math.floor(app.state.totalPlaytime);\n      const mins = Math.floor(secs / 60);\n      const hrs = Math.floor(mins / 60);\n      playtimeDisplay.textContent = `游玩时间: ${hrs}:${String(mins % 60).padStart(2, '0')}`;\n    }, 1000);\n\n    // Wrap the loop to count frames\n    const origLoop = app.loop.bind(app);\n    app.loop = (now) => {\n      frameCount++;\n      origLoop(now);\n    };\n\n    // Start game\n    app.start();\n\n    // === Building sidebar ===\n    const buildingList = document.getElementById('building-list');\n    const placementHint = document.getElementById('placement-hint');\n\n    function renderBuildingList() {\n      buildingList.innerHTML = '';\n      const available = app.getAvailableBuildings();\n      for (const def of available) {\n        const item = document.createElement('div');\n        item.className = 'building-item';\n        if (app.placementMode?.id === def.id) item.classList.add('selected');\n\n        const affordable = !Object.keys(def.cost).length ||\n          Object.entries(def.cost).every(([r, c]) =>\n            (app.state.resources[r] ?? 0) >= c);\n\n        const icon = getIcon(def.category);\n        const costStr = Object.entries(def.cost).length > 0\n          ? Object.entries(def.cost).map(([r, c]) => `${r}:${c}`).join(' ')\n          : '免费';\n\n        item.innerHTML = `\n          <span class=\"icon\">${icon}</span>\n          <div class=\"info\">\n            <div class=\"name\">${def.name}</div>\n            <div class=\"cost ${affordable ? '' : 'cannot'}\">${costStr}</div>\n          </div>\n        `;\n\n        item.addEventListener('click', () => {\n          if (app.placementMode?.id === def.id) {\n            app.placementMode = null;\n            placementHint.style.display = 'none';\n            statusText.textContent = '就绪';\n          } else {\n            app.placementMode = def;\n            placementHint.style.display = 'block';\n            statusText.textContent = `放置模式: ${def.name}`;\n          }\n          renderBuildingList();\n        });\n\n        buildingList.appendChild(item);\n      }\n    }\n\n    function getIcon(category) {\n      const icons = { mining: '⛏', farming: '🌿', alchemy: '🔥', energy: '✨' };\n      return icons[category] || '🏠';\n    }\n\n    renderBuildingList();\n\n    // Update sidebar on state change\n    app.onStateChange = (state) => {\n      renderBuildingList();\n      updateBuildingInfo(null);\n    };\n\n    app.onBuildingSelect = (building) => {\n      updateBuildingInfo(building);\n    };\n\n    function updateBuildingInfo(building) {\n      const infoDiv = document.getElementById('building-info');\n      if (!building) {\n        infoDiv.innerHTML = '<div class=\"info-entry\">点击建筑查看详情</div>';\n        return;\n      }\n      const def = app.buildingDefs.get(building.buildingId);\n      if (!def) return;\n      const prod = def.production;\n      infoDiv.innerHTML = `\n        <div class=\"info-entry\" style=\"color:#ffd700;font-weight:bold\">${def.name}</div>\n        <div class=\"info-entry\">等级: ${building.level}/${def.maxLevel}</div>\n        <div class=\"info-entry\">类型: ${prod.mode === 'manual' ? '手动' : '自动'}</div>\n        <div class=\"info-entry\">产出: ${prod.resource} ×${prod.amount}</div>\n        ${prod.interval > 0 ? `<div class=\"info-entry\">间隔: ${(prod.interval / 1000).toFixed(1)}s</div>` : ''}\n        ${prod.input ? `<div class=\"info-entry\">消耗: ${Object.entries(prod.input).map(([r,c]) => `${r}:${c}`).join(' ')}</div>` : ''}\n        <div class=\"info-entry\">状态: ${building.isProducing ? '生产中' : '空闲'}</div>\n        ${building.progress > 0 ? `<div class=\"info-entry\">进度: ${Math.floor(building.progress * 100)}%</div>` : ''}\n        ${prod.mode === 'manual' && def.category === 'mining' ? '<div class=\"info-entry\" style=\"color:#6c6;margin-top:4px\">点击采集灵石</div>' : ''}\n        ${prod.mode === 'manual' && def.category === 'farming' ? '<div class=\"info-entry\" style=\"color:#6c6;margin-top:4px\">点击种植/收获</div>' : ''}\n        ${prod.mode === 'manual' && def.category === 'alchemy' ? '<div class=\"info-entry\" style=\"color:#6c6;margin-top:4px\">点击炼丹</div>' : ''}\n      `;\n    }\n\n    // === Toolbar buttons ===\n    document.getElementById('btn-save').addEventListener('click', () => {\n      const { saveGame } = await import('./src/game/GameState.ts');\n      saveGame(app.state);\n      statusText.textContent = '💾 已保存';\n      setTimeout(() => { statusText.textContent = '就绪'; }, 2000);\n    });\n\n    document.getElementById('btn-center').addEventListener('click', () => {\n      app.centerCamera();\n    });\n\n    document.getElementById('btn-reset').addEventListener('click', () => {\n      if (confirm('确定要重置游戏进度吗？此操作不可撤销！')) {\n        const { clearSave } = await import('./src/game/GameState.ts');\n        clearSave();\n        location.reload();\n      }\n    });\n  </script>\n</body>\n</html>\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"1027b7ea-a18e-4300-8be2-f33dc07a79d1","uuid":"cf440382-9c3f-44a1-b6db-62eb6540f60c"}
{"type":"assistant","message":{"id":"msg_202605230909002b39da0dc3804bff","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_e649f5d3c6ab41a6a3bd7478","name":"Write","input":{"file_path":"D:\\game-projects\\steam-cultivation-factory\\src\\main\\main.ts","content":"// Electron main process entry point\n\nimport { app, BrowserWindow } from 'electron';\nimport * as path from 'path';\n\nlet mainWindow: BrowserWindow | null = null;\n\nfunction createWindow(): void {\n  mainWindow = new BrowserWindow({\n    width: 1280,\n    height: 800,\n    minWidth: 960,\n    minHeight: 600,\n    title: '修仙自动化工厂 — Cultivation Factory',\n    backgroundColor: '#1a1a2e',\n    webPreferences: {\n      nodeIntegration: false,\n      contextIsolation: true,\n    },\n  });\n\n  // In development, load from Vite dev server\n  const isDev = process.env.NODE_ENV === 'development';\n  if (isDev) {\n    mainWindow.loadURL('http://localhost:5173');\n    mainWindow.webContents.openDevTools();\n  } else {\n    mainWindow.loadFile(path.join(__dirname, '../renderer/index.html'));\n  }\n\n  mainWindow.on('closed', () => {\n    mainWindow = null;\n  });\n}\n\napp.whenReady().then(createWindow);\n\napp.on('window-all-closed', () => {\n  if (process.platform !== 'darwin') {\n    app.quit();\n  }\n});\n\napp.on('activate', () => {\n  if (mainWindow === null) {\n    createWindow();\n  }\n});\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"1027b7ea-a18e-4300-8be2-f33dc07a79d1","uuid":"cce74ec5-6324-43fb-b4c1-289b04a9b510"}
{"type":"assistant","message":{"id":"msg_202605230909002b39da0dc3804bff","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_758b74910a9d447c969d2518","name":"Write","input":{"file_path":"D:\\game-projects\\steam-cultivation-factory\\src\\utils\\math.ts","content":"// math.ts — Utility math functions\n\nexport function clamp(value: number, min: number, max: number): number {\n  return Math.max(min, Math.min(max, value));\n}\n\nexport function lerp(a: number, b: number, t: number): number {\n  return a + (b - a) * clamp(t, 0, 1);\n}\n\nexport function formatNumber(n: number): string {\n  if (n >= 1_000_000_000) return (n / 1_000_000_000).toFixed(1) + 'B';\n  if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';\n  if (n >= 10_000) return (n / 1_000).toFixed(1) + 'K';\n  if (n >= 1_000) return (n / 1_000).toFixed(1) + 'K';\n  return Math.floor(n).toString();\n}\n\nexport function randomInt(min: number, max: number): number {\n  return Math.floor(Math.random() * (max - min + 1)) + min;\n}\n\nexport function distance(x1: number, y1: number, x2: number, y2: number): number {\n  const dx = x2 - x1;\n  const dy = y2 - y1;\n  return Math.sqrt(dx * dx + dy * dy);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"1027b7ea-a18e-4300-8be2-f33dc07a79d1","uuid":"9d0672e5-55ca-4ab4-a6ba-7de914d5e400"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6d105fb7100d49829f608559","type":"tool_result","content":"File created successfully at: D:\\game-projects\\steam-cultivation-factory\\src\\renderer\\App.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"1027b7ea-a18e-4300-8be2-f33dc07a79d1","uuid":"74596562-8544-405d-a502-619a083cb502","timestamp":"2026-05-23T01:10:31.939Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\renderer\\App.ts","content":"// App.ts — Game main loop (60FPS + deltaTime + state management + input handling)\n\nimport { Renderer } from './Renderer';\nimport { GameMap } from '../game/Map';\nimport {\n  type GameState,\n  type BuildingInstance,\n  createInitialState,\n  cloneState,\n  setMap,\n  placeBuilding,\n  loadGame,\n  saveGame,\n  startAutoSave,\n  stopAutoSave,\n} from '../game/GameState';\nimport {\n  type BuildingDef,\n  loadBuildingDefs,\n  createBuildingInstance,\n  canPlace,\n} from '../game/Building';\nimport {\n  collectFromBuilding,\n  plantField,\n  tickAutoProduction,\n  tickManualProduction,\n  canAfford,\n  deductCost,\n} from '../game/Resources';\nimport buildingData from '../data/buildings.json';\n\nexport type PlacementMode = BuildingDef | null;\n\nexport class App {\n  canvas: HTMLCanvasElement;\n  renderer: Renderer;\n  state: GameState;\n  buildingDefs: Map<string, BuildingDef>;\n  map: GameMap;\n\n  private running = false;\n  private lastFrameTime = 0;\n  private animFrameId = 0;\n  private lastTickTime = 0;\n  private tickInterval = 200; // ms between production ticks\n\n  // Input state\n  private hoveredCell: { gx: number; gy: number } | null = null;\n  private clickStartTime = 0;\n  private clickStartPos = { x: 0, y: 0 };\n  placementMode: PlacementMode = null;\n  private placementValid = false;\n  private placementPos = { gx: 0, gy: 0 };\n\n  // UI callbacks\n  onStateChange?: (state: GameState) => void;\n  onBuildingSelect?: (building: BuildingInstance | null) => void;\n\n  constructor(canvas: HTMLCanvasElement) {\n    this.canvas = canvas;\n    this.renderer = new Renderer(canvas);\n\n    // Load or create game state\n    const saved = loadGame();\n    this.state = saved ? saved : createInitialState();\n\n    // Load building definitions\n    this.buildingDefs = loadBuildingDefs(buildingData as { buildings: BuildingDef[] });\n\n    // Initialize starting map\n    this.map = new GameMap(20, 15, '#2a3a1a', '#3a4a2a');\n    this.map.generateStartingArea();\n\n    // Set map in state if fresh game\n    if (this.state.maps.length === 0) {\n      this.state = setMap(this.state, 0, {\n        regionId: 'liqi_flat',\n        width: 20,\n        height: 15,\n        terrain: this.map.terrain,\n        buildings: [],\n      });\n    }\n\n    // Setup input\n    this.setupInput(canvas);\n\n    // Handle resize\n    window.addEventListener('resize', () => {\n      this.renderer.resize();\n    });\n  }\n\n  start(): void {\n    if (this.running) return;\n    this.running = true;\n    this.lastFrameTime = performance.now();\n    this.lastTickTime = this.lastFrameTime;\n    this.loop(this.lastFrameTime);\n\n    // Auto-save every 5 minutes\n    startAutoSave(() => this.state);\n  }\n\n  stop(): void {\n    this.running = false;\n    if (this.animFrameId) {\n      cancelAnimationFrame(this.animFrameId);\n    }\n    stopAutoSave();\n    saveGame(this.state);\n  }\n\n  private loop = (now: number): void => {\n    if (!this.running) return;\n\n    const dt = now - this.lastFrameTime;\n    this.lastFrameTime = now;\n\n    // Update playtime\n    this.state.totalPlaytime += dt / 1000;\n\n    // Tick production\n    if (now - this.lastTickTime >= this.tickInterval) {\n      this.tickProduction(now);\n      this.lastTickTime = now;\n    }\n\n    // Render\n    this.render(now);\n\n    this.animFrameId = requestAnimationFrame(this.loop);\n  };\n\n  private tickProduction(now: number): void {\n    this.state = tickAutoProduction(this.state, 0, now, this.buildingDefs);\n    this.state = tickManualProduction(this.state, 0, now, this.buildingDefs);\n  }\n\n  private render(now: number): void {\n    const buildings = this.state.maps[0]?.buildings ?? [];\n    const preview = this.placementMode\n      ? {\n          def: this.placementMode,\n          gx: this.placementPos.gx,\n          gy: this.placementPos.gy,\n          valid: this.placementValid,\n        }\n      : null;\n\n    this.renderer.render(\n      this.map,\n      buildings,\n      this.buildingDefs,\n      this.state.resources,\n      this.state.realm,\n      this.hoveredCell,\n      preview,\n      now,\n    );\n  }\n\n  // Try to place a building at current placement position\n  placeCurrentBuilding(): boolean {\n    if (!this.placementMode) return false;\n\n    const def = this.placementMode;\n    const { gx, gy } = this.placementPos;\n\n    const buildings = this.state.maps[0]?.buildings ?? [];\n    if (!canPlace(this.map, def, gx, gy, buildings)) return false;\n    if (!canAfford(this.state.resources, def.cost)) return false;\n\n    // Deduct cost\n    this.state = deductCost(this.state, def.cost);\n\n    // Create and place building\n    const instance = createBuildingInstance(def.id, gx, gy);\n    this.state = placeBuilding(this.state, 0, instance);\n\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  // Handle click on a building\n  private handleBuildingClick(building: BuildingInstance): void {\n    const def = this.buildingDefs.get(building.buildingId);\n    if (!def) return;\n\n    if (def.production.mode === 'manual') {\n      if (def.category === 'farming') {\n        // Field: plant or harvest\n        if (!building.isProducing && building.progress < 1) {\n          this.state = plantField(this.state, building, 0);\n        } else if (building.progress >= 1) {\n          this.state = collectFromBuilding(this.state, building, def, 0);\n        }\n      } else if (def.category === 'mining') {\n        // Mine: instant collect\n        this.state = collectFromBuilding(this.state, building, def, 0);\n      } else if (def.category === 'alchemy') {\n        // Furnace: start crafting or collect\n        if (building.progress >= 1) {\n          this.state = collectFromBuilding(this.state, building, def, 0);\n        } else if (!building.isProducing) {\n          this.state = collectFromBuilding(this.state, building, def, 0);\n        }\n      }\n      this.onStateChange?.(this.state);\n    }\n\n    this.onBuildingSelect?.(building);\n  }\n\n  private setupInput(canvas: HTMLCanvasElement): void {\n    // Mouse move for hover\n    canvas.addEventListener('mousemove', (e) => {\n      const rect = canvas.getBoundingClientRect();\n      const mx = e.clientX - rect.left;\n      const my = e.clientY - rect.top;\n\n      const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n      this.hoveredCell = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n\n      // Update placement preview\n      if (this.placementMode && this.hoveredCell) {\n        this.placementPos = { gx: this.hoveredCell.gx, gy: this.hoveredCell.gy };\n        const buildings = this.state.maps[0]?.buildings ?? [];\n        this.placementValid = canPlace(\n          this.map,\n          this.placementMode,\n          this.placementPos.gx,\n          this.placementPos.gy,\n          buildings,\n        );\n      }\n    });\n\n    // Mouse click for building interaction\n    canvas.addEventListener('mousedown', (e) => {\n      if (e.button !== 0) return;\n      this.clickStartTime = performance.now();\n      this.clickStartPos = { x: e.clientX, y: e.clientY };\n    });\n\n    canvas.addEventListener('mouseup', (e) => {\n      if (e.button !== 0) return;\n      const dt = performance.now() - this.clickStartTime;\n      const dx = Math.abs(e.clientX - this.clickStartPos.x);\n      const dy = Math.abs(e.clientY - this.clickStartPos.y);\n\n      // Only treat as click if short press and not dragged\n      if (dt < 300 && dx < 5 && dy < 5) {\n        this.handleClick(e);\n      }\n    });\n\n    // Keyboard shortcuts\n    document.addEventListener('keydown', (e) => {\n      if (e.key === 'Escape') {\n        this.placementMode = null;\n      }\n    });\n  }\n\n  private handleClick(e: MouseEvent): void {\n    const rect = this.canvas.getBoundingClientRect();\n    const mx = e.clientX - rect.left;\n    const my = e.clientY - rect.top;\n    const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n    const { gx, gy } = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n\n    if (!this.map.inBounds(gx, gy)) return;\n\n    // Placement mode\n    if (this.placementMode) {\n      this.placementPos = { gx, gy };\n      const buildings = this.state.maps[0]?.buildings ?? [];\n      this.placementValid = canPlace(this.map, this.placementMode, gx, gy, buildings);\n      if (this.placementValid) {\n        this.placeCurrentBuilding();\n      }\n      return;\n    }\n\n    // Try to find and interact with a building at this cell\n    const buildings = this.state.maps[0]?.buildings ?? [];\n    const clicked = buildings.find(b => {\n      const def = this.buildingDefs.get(b.buildingId);\n      if (!def) return false;\n      return (\n        gx >= b.gridX && gx < b.gridX + def.size.w &&\n        gy >= b.gridY && gy < b.gridY + def.size.h\n      );\n    });\n\n    if (clicked) {\n      this.handleBuildingClick(clicked);\n    }\n  }\n\n  // Center camera on map\n  centerCamera(): void {\n    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);\n  }\n\n  // Get available buildings for current realm\n  getAvailableBuildings(): BuildingDef[] {\n    const realmKey = `${this.state.realm.realmId}_${this.state.realm.level}`;\n    return Array.from(this.buildingDefs.values()).filter(def => {\n      return isRealmUnlocked(def.unlockRealm, realmKey);\n    });\n  }\n}\n\n// Compare realm requirements: e.g. \"liqi_5\" vs \"liqi_3\" → true\nfunction isRealmUnlocked(required: string, current: string): boolean {\n  const [rRealm, rLevel] = required.split('_');\n  const [cRealm, cLevel] = current.split('_');\n  const realmOrder = ['liqi', 'zhuji', 'jindan', 'yuanying', 'huashen'];\n  const rIdx = realmOrder.indexOf(rRealm);\n  const cIdx = realmOrder.indexOf(cRealm);\n  if (cIdx > rIdx) return true;\n  if (cIdx < rIdx) return false;\n  return parseInt(cLevel) >= parseInt(rLevel);\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_b889a6dd866344178127786a","type":"tool_result","content":"File created successfully at: D:\\game-projects\\steam-cultivation-factory\\index.html (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"1027b7ea-a18e-4300-8be2-f33dc07a79d1","uuid":"578e9a02-f8b9-47fb-8c55-7fb8a3607cf7","timestamp":"2026-05-23T01:10:32.760Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\steam-cultivation-factory\\index.html","content":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>修仙自动化工厂 — Cultivation Factory</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body {\n      background: #1a1a2e;\n      color: #e0e0e0;\n      font-family: 'Segoe UI', system-ui, monospace;\n      overflow: hidden;\n      height: 100vh;\n      width: 100vw;\n    }\n    #app {\n      display: flex;\n      flex-direction: column;\n      height: 100vh;\n    }\n    #toolbar {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      padding: 6px 12px;\n      background: rgba(0,0,0,0.6);\n      border-bottom: 1px solid rgba(255,255,255,0.1);\n      min-height: 44px;\n      flex-shrink: 0;\n    }\n    #toolbar h1 {\n      font-size: 16px;\n      color: #ffd700;\n      margin-right: 12px;\n      white-space: nowrap;\n    }\n    #toolbar .spacer { flex: 1; }\n    .toolbar-btn {\n      background: rgba(255,255,255,0.08);\n      border: 1px solid rgba(255,255,255,0.15);\n      color: #e0e0e0;\n      padding: 4px 12px;\n      border-radius: 4px;\n      cursor: pointer;\n      font-size: 12px;\n      transition: background 0.2s;\n    }\n    .toolbar-btn:hover { background: rgba(255,255,255,0.15); }\n    .toolbar-btn.active { background: rgba(100,200,100,0.3); border-color: #6c6; }\n    #main {\n      display: flex;\n      flex: 1;\n      overflow: hidden;\n    }\n    #sidebar {\n      width: 220px;\n      background: rgba(0,0,0,0.5);\n      border-right: 1px solid rgba(255,255,255,0.1);\n      overflow-y: auto;\n      flex-shrink: 0;\n    }\n    .sidebar-section {\n      padding: 8px;\n      border-bottom: 1px solid rgba(255,255,255,0.05);\n    }\n    .sidebar-section h3 {\n      font-size: 12px;\n      color: #aaa;\n      margin-bottom: 6px;\n      text-transform: uppercase;\n    }\n    .building-item {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      padding: 6px 8px;\n      margin: 2px 0;\n      border-radius: 4px;\n      cursor: pointer;\n      transition: background 0.2s;\n      font-size: 12px;\n    }\n    .building-item:hover { background: rgba(255,255,255,0.1); }\n    .building-item.selected { background: rgba(100,200,100,0.2); border: 1px solid rgba(100,200,100,0.4); }\n    .building-item .icon { font-size: 18px; }\n    .building-item .info { flex: 1; }\n    .building-item .name { color: #e0e0e0; }\n    .building-item .cost { color: #888; font-size: 10px; }\n    .building-item .cost.cannot { color: #c44; }\n    #canvas-container {\n      flex: 1;\n      position: relative;\n    }\n    #gameCanvas {\n      display: block;\n      width: 100%;\n      height: 100%;\n    }\n    #info-panel {\n      width: 200px;\n      background: rgba(0,0,0,0.5);\n      border-left: 1px solid rgba(255,255,255,0.1);\n      overflow-y: auto;\n      flex-shrink: 0;\n      padding: 8px;\n    }\n    #info-panel h3 {\n      font-size: 12px;\n      color: #aaa;\n      margin-bottom: 6px;\n    }\n    .info-entry {\n      font-size: 11px;\n      padding: 3px 0;\n      color: #ccc;\n    }\n    #statusbar {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      padding: 4px 12px;\n      background: rgba(0,0,0,0.6);\n      border-top: 1px solid rgba(255,255,255,0.1);\n      font-size: 11px;\n      color: #888;\n      min-height: 28px;\n      flex-shrink: 0;\n    }\n    #statusbar .fps { color: #6a6; }\n    #placement-hint {\n      position: absolute;\n      bottom: 40px;\n      left: 50%;\n      transform: translateX(-50%);\n      background: rgba(0,0,0,0.8);\n      color: #ffd700;\n      padding: 6px 16px;\n      border-radius: 4px;\n      font-size: 12px;\n      pointer-events: none;\n      display: none;\n    }\n    /* Scrollbar styling */\n    ::-webkit-scrollbar { width: 6px; }\n    ::-webkit-scrollbar-track { background: transparent; }\n    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 3px; }\n  </style>\n</head>\n<body>\n  <div id=\"app\">\n    <div id=\"toolbar\">\n      <h1>⛰ 修仙工厂</h1>\n      <div class=\"spacer\"></div>\n      <button class=\"toolbar-btn\" id=\"btn-save\" title=\"保存游戏\">💾 保存</button>\n      <button class=\"toolbar-btn\" id=\"btn-center\" title=\"居中视角\">◎ 居中</button>\n      <button class=\"toolbar-btn\" id=\"btn-reset\" title=\"重置游戏\">⚠ 重置</button>\n    </div>\n    <div id=\"main\">\n      <div id=\"sidebar\">\n        <div class=\"sidebar-section\">\n          <h3>🏗 建筑设施</h3>\n          <div id=\"building-list\"></div>\n        </div>\n      </div>\n      <div id=\"canvas-container\">\n        <canvas id=\"gameCanvas\"></canvas>\n        <div id=\"placement-hint\">点击地图放置建筑 | ESC 取消</div>\n      </div>\n      <div id=\"info-panel\">\n        <h3>📊 信息</h3>\n        <div id=\"building-info\">点击建筑查看详情</div>\n      </div>\n    </div>\n    <div id=\"statusbar\">\n      <span class=\"fps\" id=\"fps-display\">FPS: --</span>\n      <span id=\"status-text\">就绪</span>\n      <div class=\"spacer\"></div>\n      <span id=\"playtime\">游玩时间: 0:00</span>\n    </div>\n  </div>\n\n  <script type=\"module\">\n    import { App } from './src/renderer/App.ts';\n\n    const canvas = document.getElementById('gameCanvas');\n    const app = new App(canvas);\n\n    // Center camera\n    app.centerCamera();\n\n    // FPS counter\n    let frameCount = 0;\n    let fpsTime = performance.now();\n    const fpsDisplay = document.getElementById('fps-display');\n    const statusText = document.getElementById('status-text');\n    const playtimeDisplay = document.getElementById('playtime');\n\n    setInterval(() => {\n      const now = performance.now();\n      const fps = Math.round(frameCount * 1000 / (now - fpsTime));\n      fpsDisplay.textContent = `FPS: ${fps}`;\n      frameCount = 0;\n      fpsTime = now;\n\n      // Update playtime\n      const secs = Math.floor(app.state.totalPlaytime);\n      const mins = Math.floor(secs / 60);\n      const hrs = Math.floor(mins / 60);\n      playtimeDisplay.textContent = `游玩时间: ${hrs}:${String(mins % 60).padStart(2, '0')}`;\n    }, 1000);\n\n    // Wrap the loop to count frames\n    const origLoop = app.loop.bind(app);\n    app.loop = (now) => {\n      frameCount++;\n      origLoop(now);\n    };\n\n    // Start game\n    app.start();\n\n    // === Building sidebar ===\n    const buildingList = document.getElementById('building-list');\n    const placementHint = document.getElementById('placement-hint');\n\n    function renderBuildingList() {\n      buildingList.innerHTML = '';\n      const available = app.getAvailableBuildings();\n      for (const def of available) {\n        const item = document.createElement('div');\n        item.className = 'building-item';\n        if (app.placementMode?.id === def.id) item.classList.add('selected');\n\n        const affordable = !Object.keys(def.cost).length ||\n          Object.entries(def.cost).every(([r, c]) =>\n            (app.state.resources[r] ?? 0) >= c);\n\n        const icon = getIcon(def.category);\n        const costStr = Object.entries(def.cost).length > 0\n          ? Object.entries(def.cost).map(([r, c]) => `${r}:${c}`).join(' ')\n          : '免费';\n\n        item.innerHTML = `\n          <span class=\"icon\">${icon}</span>\n          <div class=\"info\">\n            <div class=\"name\">${def.name}</div>\n            <div class=\"cost ${affordable ? '' : 'cannot'}\">${costStr}</div>\n          </div>\n        `;\n\n        item.addEventListener('click', () => {\n          if (app.placementMode?.id === def.id) {\n            app.placementMode = null;\n            placementHint.style.display = 'none';\n            statusText.textContent = '就绪';\n          } else {\n            app.placementMode = def;\n            placementHint.style.display = 'block';\n            statusText.textContent = `放置模式: ${def.name}`;\n          }\n          renderBuildingList();\n        });\n\n        buildingList.appendChild(item);\n      }\n    }\n\n    function getIcon(category) {\n      const icons = { mining: '⛏', farming: '🌿', alchemy: '🔥', energy: '✨' };\n      return icons[category] || '🏠';\n    }\n\n    renderBuildingList();\n\n    // Update sidebar on state change\n    app.onStateChange = (state) => {\n      renderBuildingList();\n      updateBuildingInfo(null);\n    };\n\n    app.onBuildingSelect = (building) => {\n      updateBuildingInfo(building);\n    };\n\n    function updateBuildingInfo(building) {\n      const infoDiv = document.getElementById('building-info');\n      if (!building) {\n        infoDiv.innerHTML = '<div class=\"info-entry\">点击建筑查看详情</div>';\n        return;\n      }\n      const def = app.buildingDefs.get(building.buildingId);\n      if (!def) return;\n      const prod = def.production;\n      infoDiv.innerHTML = `\n        <div class=\"info-entry\" style=\"color:#ffd700;font-weight:bold\">${def.name}</div>\n        <div class=\"info-entry\">等级: ${building.level}/${def.maxLevel}</div>\n        <div class=\"info-entry\">类型: ${prod.mode === 'manual' ? '手动' : '自动'}</div>\n        <div class=\"info-entry\">产出: ${prod.resource} ×${prod.amount}</div>\n        ${prod.interval > 0 ? `<div class=\"info-entry\">间隔: ${(prod.interval / 1000).toFixed(1)}s</div>` : ''}\n        ${prod.input ? `<div class=\"info-entry\">消耗: ${Object.entries(prod.input).map(([r,c]) => `${r}:${c}`).join(' ')}</div>` : ''}\n        <div class=\"info-entry\">状态: ${building.isProducing ? '生产中' : '空闲'}</div>\n        ${building.progress > 0 ? `<div class=\"info-entry\">进度: ${Math.floor(building.progress * 100)}%</div>` : ''}\n        ${prod.mode === 'manual' && def.category === 'mining' ? '<div class=\"info-entry\" style=\"color:#6c6;margin-top:4px\">点击采集灵石</div>' : ''}\n        ${prod.mode === 'manual' && def.category === 'farming' ? '<div class=\"info-entry\" style=\"color:#6c6;margin-top:4px\">点击种植/收获</div>' : ''}\n        ${prod.mode === 'manual' && def.category === 'alchemy' ? '<div class=\"info-entry\" style=\"color:#6c6;margin-top:4px\">点击炼丹</div>' : ''}\n      `;\n    }\n\n    // === Toolbar buttons ===\n    document.getElementById('btn-save').addEventListener('click', () => {\n      const { saveGame } = await import('./src/game/GameState.ts');\n      saveGame(app.state);\n      statusText.textContent = '💾 已保存';\n      setTimeout(() => { statusText.textContent = '就绪'; }, 2000);\n    });\n\n    document.getElementById('btn-center').addEventListener('click', () => {\n      app.centerCamera();\n    });\n\n    document.getElementById('btn-reset').addEventListener('click', () => {\n      if (confirm('确定要重置游戏进度吗？此操作不可撤销！')) {\n        const { clearSave } = await import('./src/game/GameState.ts');\n        clearSave();\n        location.reload();\n      }\n    });\n  </script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null,"userModified":false}}
