{"type":"assistant","message":{"id":"msg_20260523123926c2862c9ae1c64cf1","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_8d696e6ea25f4c4da87fe683","name":"Write","input":{"file_path":"D:\\game-projects\\steam-horror-sim\\src\\game\\UpgradeManager.ts","content":"// UpgradeManager.ts — Shop upgrade management with effects (M3)\n\nexport interface UpgradeDef {\n  id: string;\n  name: string;\n  description: string;\n  cost: number;\n  effect: string;\n  value?: number;\n  horrorLink: string;\n}\n\nconst ALL_UPGRADES: UpgradeDef[] = [\n  { id: 'bright_lights', name: '更亮的灯', description: '店内照明+50%', cost: 500, effect: 'light_boost', value: 1.5, horrorLink: '暗角减少，但某些东西在亮处更清楚' },\n  { id: 'warehouse_shelf', name: '仓库货架', description: '库存+50%', cost: 800, effect: 'storage_capacity', value: 1.5, horrorLink: '仓库更深更暗...' },\n  { id: 'register_upgrade', name: '收银机升级', description: '交易速度+30%', cost: 1000, effect: 'checkout_speed', value: 0.7, horrorLink: '异常收银记录更精确' },\n  { id: 'camera', name: '监控摄像头', description: '实时查看店内各区域', cost: 2000, effect: 'enable_camera_view', horrorLink: '夜晚录像中可能看到不该看到的东西' },\n  { id: 'security_door', name: '防盗门', description: '后门加固', cost: 3000, effect: 'block_back_intrusion', horrorLink: '减少物理入侵事件，但也减少了逃跑路线' },\n  { id: 'emergency_button', name: '紧急按钮', description: '按下后...', cost: 5000, effect: 'emergency_call', horrorLink: '会有人来吗？' },\n];\n\nexport class UpgradeManager {\n  private purchased: Set<string> = new Set();\n\n  getUpgrades(): UpgradeDef[] {\n    return ALL_UPGRADES;\n  }\n\n  getAvailableUpgrades(): UpgradeDef[] {\n    return ALL_UPGRADES.filter(u => !this.purchased.has(u.id));\n  }\n\n  isPurchased(id: string): boolean {\n    return this.purchased.has(id);\n  }\n\n  canAfford(id: string, money: number): boolean {\n    const upgrade = ALL_UPGRADES.find(u => u.id === id);\n    return upgrade !== undefined && !this.purchased.has(id) && money >= upgrade.cost;\n  }\n\n  purchase(id: string, money: number): { success: boolean; cost: number; message: string } {\n    const upgrade = ALL_UPGRADES.find(u => u.id === id);\n    if (!upgrade) return { success: false, cost: 0, message: '升级不存在' };\n    if (this.purchased.has(id)) return { success: false, cost: 0, message: '已购买' };\n    if (money < upgrade.cost) return { success: false, cost: 0, message: '余额不足' };\n\n    this.purchased.add(id);\n    return { success: true, cost: upgrade.cost, message: `已购买: ${upgrade.name}` };\n  }\n\n  getLightBoost(): number {\n    if (this.purchased.has('bright_lights')) return 1.5;\n    return 1.0;\n  }\n\n  getStorageMultiplier(): number {\n    if (this.purchased.has('warehouse_shelf')) return 1.5;\n    return 1.0;\n  }\n\n  getCheckoutSpeedMultiplier(): number {\n    if (this.purchased.has('register_upgrade')) return 0.7;\n    return 1.0;\n  }\n\n  hasCamera(): boolean {\n    return this.purchased.has('camera');\n  }\n\n  hasSecurityDoor(): boolean {\n    return this.purchased.has('security_door');\n  }\n\n  hasEmergencyButton(): boolean {\n    return this.purchased.has('emergency_button');\n  }\n\n  getSaveData(): Record<string, unknown> {\n    return { purchased: Array.from(this.purchased) };\n  }\n\n  loadSaveData(data: Record<string, unknown>): void {\n    if (data.purchased) {\n      this.purchased = new Set(data.purchased as string[]);\n    }\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"e8f5bde0-4da8-4c4a-9322-50945e66ead7","uuid":"726024c4-8c40-47a0-bab3-7943db92db7b"}
