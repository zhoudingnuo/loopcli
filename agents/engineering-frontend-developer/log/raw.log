\n\nLet me do this efficiently. I'll write all 6 new files first, then update Game.js and index.html.\n\nFor the auto_obstacle skill, I need to be careful. The current code doesn't have a \"moveCount\" that's exposed... wait, actually it does. Game.js has `this.moveCount` that increments on each swap. So I can use that in the skill.\n\nFor the `after_move` event, I'll trigger it in `_afterMoveComplete()`.\n\nLet me also think about how the character \"extra_moves\" skill interacts with `_loadLevel`. Currently `_loadLevel` calls `scoreSystem.configure(config)` which sets `maxMoves`. The skill adds to `maxMoves` after that. So I need to apply the skill after `_loadLevel`.\n\nIn Navigation._handleMapClick, after calling game._loadLevel(), I apply the character skill with 'level_start' event. This should work.\n\nLet me finalize and write everything now.\n\nActually, one more consideration: the current result screen rendering in Renderer.js (drawResultScreen) is used in the original Game.render(). If Navigation handles the result screen, I need to make sure Game.render() doesn't also draw the result screen. I'll check `if (this.resultData && !this.nav.isActive())` or simply remove the result screen from Game.render().\n\nOK, I think I have a complete plan. Let me write the code now.\n\nLet me write all files in parallel using multiple Write calls.","signature":""}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"fc99b580-aa14-4899-aa35-a732e530edf6","uuid":"40fa3ee4-96cc-455f-9381-29a608221aeb"}
{"type":"assistant","message":{"id":"msg_202605230542353c3ad68e7f0442b0","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"text","text":"现在我来创建所有 Phase 3a 模块。我将并行编写 6 个新文件。"}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"fc99b580-aa14-4899-aa35-a732e530edf6","uuid":"be577073-193b-4f1f-93d1-4fd2085a92e8"}
{"type":"assistant","message":{"id":"msg_202605230542353c3ad68e7f0442b0","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_4844d7270da14ccb983e8e6f","name":"Write","input":{"file_path":"D:\\game-projects\\douyin-match3\\src\\js\\DataManager.js","content":"// DataManager.js — localStorage persistence for game progress\n\nclass DataManager {\n  constructor() {\n    this.STORAGE_KEY = 'match3_save';\n    this.data = this._load();\n  }\n\n  _defaults() {\n    return {\n      levelStars: {},\n      unlockedLevel: 1,\n      coins: 0,\n      selectedCharacter: 0,\n      ownedItems: {},\n      soundEnabled: true,\n    };\n  }\n\n  _load() {\n    try {\n      const raw = localStorage.getItem(this.STORAGE_KEY);\n      if (raw) return { ...this._defaults(), ...JSON.parse(raw) };\n    } catch (e) { /* ignore */ }\n    return this._defaults();\n  }\n\n  save() {\n    try {\n      localStorage.setItem(this.STORAGE_KEY, JSON.stringify(this.data));\n    } catch (e) { /* ignore */ }\n  }\n\n  getLevelStars(id) { return this.data.levelStars[id] || 0; }\n\n  setLevelStars(id, stars) {\n    if (stars > (this.data.levelStars[id] || 0)) {\n      this.data.levelStars[id] = stars;\n    }\n    if (id >= this.data.unlockedLevel) {\n      this.data.unlockedLevel = id + 1;\n    }\n    this.save();\n  }\n\n  get unlockedLevel() { return this.data.unlockedLevel; }\n  get coins() { return this.data.coins; }\n\n  addCoins(n) { this.data.coins += n; this.save(); return this.data.coins; }\n  spendCoins(n) {\n    if (this.data.coins >= n) { this.data.coins -= n; this.save(); return true; }\n    return false;\n  }\n\n  get selectedCharacter() { return this.data.selectedCharacter; }\n  set selectedCharacter(v) { this.data.selectedCharacter = v; this.save(); }\n\n  getItemCount(id) { return this.data.ownedItems[id] || 0; }\n  addItem(id, n = 1) { this.data.ownedItems[id] = (this.data.ownedItems[id] || 0) + n; this.save(); }\n  useItem(id) {\n    if ((this.data.ownedItems[id] || 0) > 0) { this.data.ownedItems[id]--; this.save(); return true; }\n    return false;\n  }\n\n  reset() { this.data = this._defaults(); this.save(); }\n}\n\nif (typeof module !== 'undefined') module.exports = { DataManager };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"fc99b580-aa14-4899-aa35-a732e530edf6","uuid":"31ef4f24-7059-45df-b92f-e670558e31ab"}
{"type":"assistant","message":{"id":"msg_202605230542353c3ad68e7f0442b0","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_86e896a8706d475b8c47f7e4","name":"Write","input":{"file_path":"D:\\game-projects\\douyin-match3\\src\\js\\CoinSystem.js","content":"// CoinSystem.js — Gold economy with rewards and shop\n\nclass CoinSystem {\n  constructor(dataManager) {\n    this.dm = dataManager;\n    this.STAR_REWARDS = { 1: 10, 2: 20, 3: 30 };\n    this.CONTINUE_COST = 10;\n    this.SHOP_ITEMS = [\n      { id: 'striped_bomb', name: '条纹炸弹', desc: '开局放置1个条纹炸弹', price: 5, emoji: '💥' },\n      { id: 'area_bomb', name: '区域炸弹', desc: '开局放置1个区域炸弹', price: 8, emoji: '💣' },\n      { id: 'rainbow', name: '彩虹方块', desc: '开局放置1个彩虹方块', price: 15, emoji: '🌈' },\n      { id: 'extra_moves', name: '额外步数', desc: '开局额外+5步', price: 10, emoji: '👟' },\n      { id: 'shuffle', name: '洗牌卡', desc: '重新排列棋盘方块', price: 3, emoji: '🔀' },\n    ];\n  }\n\n  awardStars(stars) {\n    const reward = this.STAR_REWARDS[stars] || 0;\n    if (reward > 0) this.dm.addCoins(reward);\n    return reward;\n  }\n\n  canContinue() { return this.dm.coins >= this.CONTINUE_COST; }\n  buyContinue() { return this.dm.spendCoins(this.CONTINUE_COST); }\n\n  canBuy(itemId) {\n    const item = this.SHOP_ITEMS.find(i => i.id === itemId);\n    return item && this.dm.coins >= item.price;\n  }\n\n  buy(itemId) {\n    const item = this.SHOP_ITEMS.find(i => i.id === itemId);\n    if (!item || !this.dm.spendCoins(item.price)) return false;\n    this.dm.addItem(itemId);\n    return true;\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { CoinSystem };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"fc99b580-aa14-4899-aa35-a732e530edf6","uuid":"5abf3b36-e12e-4bba-9758-30baf1a00a0e"}
{"type":"assistant","message":{"id":"msg_202605230542353c3ad68e7f0442b0","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_14de805b544848fab6aeaf06","name":"Write","input":{"file_path":"D:\\game-projects\\douyin-match3\\src\\js\\Characters.js","content":"// Characters.js — 4 playable characters with unique skills\n\nclass CharacterManager {\n  constructor() {\n    this.characters = [\n      {\n        id: 0, name: '小果', emoji: '🍎', title: '果实精灵',\n        desc: '开局额外+2步',\n        skill: 'extra_moves', param: 2, unlockLevel: 1,\n      },\n      {\n        id: 1, name: '冰冰', emoji: '❄️', title: '冰雪仙子',\n        desc: '每5步自动清除1个障碍',\n        skill: 'auto_obstacle', param: 5, unlockLevel: 5,\n      },\n      {\n        id: 2, name: '星星', emoji: '⭐', title: '幸运星',\n        desc: '消除时15%概率生成条纹炸弹',\n        skill: 'lucky_special', param: 0.15, unlockLevel: 10,\n      },\n      {\n        id: 3, name: '彩虹', emoji: '🌈', title: '彩虹使者',\n        desc: '连锁3+时额外+100分',\n        skill: 'chain_bonus', param: 100, unlockLevel: 15,\n      },\n    ];\n  }\n\n  getAll() { return this.characters; }\n  get(id) { return this.characters[id]; }\n  isUnlocked(id, maxLevel) { return this.characters[id].unlockLevel <= maxLevel; }\n\n  applySkill(charId, game, event, params) {\n    const ch = this.characters[charId];\n    if (!ch) return;\n\n    switch (ch.skill) {\n      case 'extra_moves':\n        if (event === 'level_start') {\n          game.scoreSystem.maxMoves += ch.param;\n        }\n        break;\n\n      case 'auto_obstacle':\n        if (event === 'after_move' && game.moveCount % ch.param === 0) {\n          const obs = game.obstacleMgr.obstacles.filter(o => !o.isDestroyed());\n          if (obs.length > 0) {\n            const t = obs[Math.floor(Math.random() * obs.length)];\n            t.hp = 0;\n            game.scoreSystem.addObstacleCleared(t.type);\n            const pos = game.renderer.getTileCenter(t.row, t.col);\n            game.particles.emitExplosion(pos.x, pos.y, '#88CCFF', 12);\n            game.audio.playObstacleBreak();\n          }\n        }\n        break;\n\n      case 'lucky_special':\n        if (event === 'match_created' && Math.random() < ch.param && params && params.cells) {\n          const cell = params.cells[Math.floor(Math.random() * params.cells.length)];\n          const tile = game.board.getTile(cell.row, cell.col);\n          if (tile && tile.special === SPECIAL_NONE) {\n            tile.special = SPECIAL_STRIPED_H;\n            game.audio.playSpecial();\n          }\n        }\n        break;\n\n      case 'chain_bonus':\n        if (event === 'chain_score' && params && params.chainCount >= 3) {\n          game.scoreSystem.addScore(ch.param);\n        }\n        break;\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { CharacterManager };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"fc99b580-aa14-4899-aa35-a732e530edf6","uuid":"88d9664e-12dc-47d5-8be8-8c3c75c47593"}
{"type":"assistant","message":{"id":"msg_202605230542353c3ad68e7f0442b0","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_95a033de3c72400e8362219b","name":"Write","input":{"file_path":"D:\\game-projects\\douyin-match3\\src\\js\\MapScreen.js","content":"// MapScreen.js — Path-style level selection map with star display and lock states\n\nclass MapScreen {\n  constructor(dataManager) {\n    this.dm = dataManager;\n    this.nodeSize = 44;\n    this.animTime = 0;\n  }\n\n  getNodePositions(screenW) {\n    const positions = [];\n    const cols = 5;\n    const rows = 4;\n    const hSpacing = Math.min((screenW - 80) / (cols - 1), 80);\n    const vSpacing = 110;\n    const startX = (screenW - hSpacing * (cols - 1)) / 2;\n    const startY = 130;\n\n    for (let r = 0; r < rows; r++) {\n      for (let c = 0; c < cols; c++) {\n        const levelIdx = r * cols + c;\n        const actualCol = r % 2 === 0 ? c : (cols - 1 - c);\n        positions.push({\n          level: levelIdx,\n          x: startX + actualCol * hSpacing,\n          y: startY + r * vSpacing,\n        });\n      }\n    }\n    return positions;\n  }\n\n  getThemeColor(levelIdx) {\n    if (levelIdx < 5) return { node: '#FF4D4D', path: '#FFB800', glow: '#FFE0EC' };\n    if (levelIdx < 10) return { node: '#4DA6FF', path: '#4DA6FF', glow: '#B3E5FC' };\n    if (levelIdx < 15) return { node: '#FF9A3C', path: '#FF9A3C', glow: '#FFE0B2' };\n    return { node: '#B47AEA', path: '#B47AEA', glow: '#D1C4E9' };\n  }\n\n  render(ctx, screenW, screenH) {\n    this.animTime += 1 / 60;\n    const positions = this.getNodePositions(screenW);\n\n    // Background gradient\n    const grad = ctx.createLinearGradient(0, 0, 0, screenH);\n    grad.addColorStop(0, '#FFE8F0');\n    grad.addColorStop(0.4, '#E8F5E9');\n    grad.addColorStop(1, '#E3F2FD');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, screenW, screenH);\n\n    // Decorative floating elements\n    const decos = ['🍬', '🍭', '🌟', '✨', '🍰'];\n    for (let i = 0; i < 8; i++) {\n      ctx.globalAlpha = 0.1;\n      ctx.font = `${16 + (i % 3) * 6}px sans-serif`;\n      ctx.textAlign = 'center';\n      const dx = (screenW * 0.15 + (i * 97) % (screenW * 0.7));\n      const dy = (50 + (i * 67 + Math.sin(this.animTime * 0.5 + i) * 15) % (screenH * 0.8));\n      ctx.fillText(decos[i % decos.length], dx, dy);\n    }\n    ctx.globalAlpha = 1;\n\n    // Title bar\n    ctx.fillStyle = '#FFB800';\n    this._roundRect(ctx, 10, 8, screenW - 20, 48, 12);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('🗺️ 关卡地图', screenW / 2, 40);\n\n    // Coins\n    ctx.textAlign = 'right';\n    ctx.font = 'bold 14px sans-serif';\n    ctx.fillStyle = '#FFF';\n    ctx.fillText(`🪙 ${this.dm.coins}`, screenW - 18, 38);\n\n    // Shop button (top-right area)\n    ctx.fillStyle = '#6BCB77';\n    this._roundRect(ctx, screenW - 82, 62, 65, 28, 14);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 12px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('🏪 商店', screenW - 50, 80);\n\n    // Character button\n    ctx.fillStyle = '#B47AEA';\n    this._roundRect(ctx, 17, 62, 65, 28, 14);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.fillText('👤 角色', 50, 80);\n\n    // Draw connecting paths\n    for (let i = 0; i < positions.length - 1; i++) {\n      const a = positions[i];\n      const b = positions[i + 1];\n      const theme = this.getThemeColor(i);\n      ctx.strokeStyle = theme.path + '60';\n      ctx.lineWidth = 4;\n      ctx.setLineDash([8, 4]);\n      ctx.beginPath();\n      ctx.moveTo(a.x, a.y);\n      ctx.lineTo(b.x, b.y);\n      ctx.stroke();\n      ctx.setLineDash([]);\n    }\n\n    // Draw level nodes\n    const unlocked = this.dm.unlockedLevel;\n    for (const pos of positions) {\n      const levelNum = pos.level + 1;\n      const stars = this.dm.getLevelStars(levelNum);\n      const isUnlocked = levelNum <= unlocked;\n      const isCurrent = levelNum === unlocked;\n      const theme = this.getThemeColor(pos.level);\n      const r = this.nodeSize / 2;\n\n      if (isUnlocked) {\n        // Pulse glow for current level\n        if (isCurrent) {\n          const glow = 6 + Math.sin(this.animTime * 3) * 4;\n          ctx.shadowColor = theme.node;\n          ctx.shadowBlur = glow;\n        }\n\n        // Node circle\n        const nodeGrad = ctx.createRadialGradient(pos.x, pos.y - 4, 2, pos.x, pos.y, r);\n        nodeGrad.addColorStop(0, theme.node + 'EE');\n        nodeGrad.addColorStop(1, theme.node);\n        ctx.fillStyle = nodeGrad;\n        ctx.beginPath();\n        ctx.arc(pos.x, pos.y, r, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.shadowBlur = 0;\n\n        // Shine\n        ctx.fillStyle = 'rgba(255,255,255,0.25)';\n        ctx.beginPath();\n        ctx.ellipse(pos.x, pos.y - r * 0.25, r * 0.6, r * 0.35, 0, 0, Math.PI * 2);\n        ctx.fill();\n\n        // Level number\n        ctx.fillStyle = '#FFF';\n        ctx.font = 'bold 18px sans-serif';\n        ctx.textAlign = 'center';\n        ctx.textBaseline = 'middle';\n        ctx.fillText(levelNum, pos.x, pos.y + 1);\n      } else {\n        // Locked node\n        ctx.fillStyle = '#D5CFC5';\n        ctx.beginPath();\n        ctx.arc(pos.x, pos.y, r, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.fillStyle = '#B0A898';\n        ctx.font = '16px sans-serif';\n        ctx.textAlign = 'center';\n        ctx.textBaseline = 'middle';\n        ctx.fillText('🔒', pos.x, pos.y);\n      }\n\n      // Stars below node\n      if (stars > 0) {\n        const starY = pos.y + r + 12;\n        ctx.font = '12px sans-serif';\n        ctx.textBaseline = 'alphabetic';\n        for (let s = 0; s < 3; s++) {\n          ctx.fillText(s < stars ? '⭐' : '☆', pos.x - 15 + s * 15, starY);\n        }\n      }\n    }\n\n    // Progress info\n    const completed = Object.keys(this.dm.data.levelStars).length;\n    ctx.fillStyle = '#8D6E63';\n    ctx.font = '12px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'alphabetic';\n    ctx.fillText(`已通关 ${completed}/20 关`, screenW / 2, screenH - 20);\n  }\n\n  handleClick(x, y, screenW, screenH) {\n    // Shop button\n    if (x >= screenW - 82 && x <= screenW - 17 && y >= 62 && y <= 90) {\n      return { action: 'shop' };\n    }\n\n    // Character button\n    if (x >= 17 && x <= 82 && y >= 62 && y <= 90) {\n      return { action: 'character' };\n    }\n\n    // Level nodes\n    const positions = this.getNodePositions(screenW);\n    const unlocked = this.dm.unlockedLevel;\n    for (const pos of positions) {\n      const dx = x - pos.x;\n      const dy = y - pos.y;\n      const hitR = this.nodeSize / 2 + 8;\n      if (dx * dx + dy * dy <= hitR * hitR) {\n        const levelNum = pos.level + 1;\n        if (levelNum <= unlocked) {\n          return { action: 'play', level: pos.level };\n        }\n        return null;\n      }\n    }\n    return null;\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { MapScreen };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"fc99b580-aa14-4899-aa35-a732e530edf6","uuid":"9ddde17c-4a89-40ff-925d-c6c737fbb3dd"}
{"type":"assistant","message":{"id":"msg_202605230542353c3ad68e7f0442b0","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_6817366687e94cf8add4cfba","name":"Write","input":{"file_path":"D:\\game-projects\\douyin-match3\\src\\js\\ShopUI.js","content":"// ShopUI.js — Item shop with coin purchasing\n\nclass ShopUI {\n  constructor(coinSystem, dataManager) {\n    this.cs = coinSystem;\n    this.dm = dataManager;\n  }\n\n  render(ctx, screenW, screenH) {\n    // Background\n    const grad = ctx.createLinearGradient(0, 0, 0, screenH);\n    grad.addColorStop(0, '#FFF8E7');\n    grad.addColorStop(1, '#FFE0B2');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, screenW, screenH);\n\n    // Title bar\n    ctx.fillStyle = '#FFB800';\n    this._roundRect(ctx, 10, 8, screenW - 20, 48, 12);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('🏪 道具商店', screenW / 2, 40);\n\n    // Coins\n    ctx.font = 'bold 14px sans-serif';\n    ctx.textAlign = 'right';\n    ctx.fillText(`🪙 ${this.dm.coins}`, screenW - 18, 38);\n\n    // Item cards\n    const items = this.cs.SHOP_ITEMS;\n    const cardW = screenW - 40;\n    const cardH = 72;\n    const startY = 75;\n    const gap = 8;\n\n    for (let i = 0; i < items.length; i++) {\n      const item = items[i];\n      const y = startY + i * (cardH + gap);\n      const owned = this.dm.getItemCount(item.id);\n      const canBuy = this.dm.coins >= item.price;\n\n      // Card bg\n      ctx.fillStyle = '#FFFFFFDD';\n      this._roundRect(ctx, 20, y, cardW, cardH, 12);\n      ctx.fill();\n      ctx.strokeStyle = '#E0D5C5';\n      ctx.lineWidth = 1;\n      this._roundRect(ctx, 20, y, cardW, cardH, 12);\n      ctx.stroke();\n\n      // Emoji icon\n      ctx.font = '30px sans-serif';\n      ctx.textAlign = 'left';\n      ctx.fillText(item.emoji, 32, y + 42);\n\n      // Name\n      ctx.fillStyle = '#5D4037';\n      ctx.font = 'bold 15px sans-serif';\n      ctx.fillText(item.name, 72, y + 28);\n\n      // Description\n      ctx.fillStyle = '#8D6E63';\n      ctx.font = '12px sans-serif';\n      ctx.fillText(item.desc, 72, y + 48);\n\n      // Owned count\n      if (owned > 0) {\n        ctx.fillStyle = '#6BCB77';\n        ctx.font = 'bold 13px sans-serif';\n        ctx.textAlign = 'right';\n        ctx.fillText(`×${owned}`, screenW - 100, y + 28);\n      }\n\n      // Buy button\n      const buyX = screenW - 90;\n      const buyY = y + 20;\n      const buyW = 68;\n      const buyH = 32;\n      ctx.fillStyle = canBuy ? '#FFB800' : '#D0C8B8';\n      this._roundRect(ctx, buyX, buyY, buyW, buyH, buyH / 2);\n      ctx.fill();\n      ctx.fillStyle = canBuy ? '#FFF' : '#A09888';\n      ctx.font = 'bold 12px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText(`${item.price}🪙`, buyX + buyW / 2, buyY + 21);\n    }\n\n    // Back button\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, 20, screenH - 58, screenW - 40, 42, 21);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 16px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('返回地图', screenW / 2, screenH - 32);\n  }\n\n  handleClick(x, y, screenW, screenH) {\n    const items = this.cs.SHOP_ITEMS;\n    const cardH = 72;\n    const startY = 75;\n    const gap = 8;\n\n    // Buy buttons\n    for (let i = 0; i < items.length; i++) {\n      const iy = startY + i * (cardH + gap);\n      const buyX = screenW - 90;\n      const buyY = iy + 20;\n      if (x >= buyX && x <= buyX + 68 && y >= buyY && y <= buyY + 32) {\n        return { action: 'buy', itemId: items[i].id };\n      }\n    }\n\n    // Back button\n    if (y >= screenH - 58 && y <= screenH - 16 && x >= 20 && x <= screenW - 20) {\n      return { action: 'back' };\n    }\n\n    return null;\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { ShopUI };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"fc99b580-aa14-4899-aa35-a732e530edf6","uuid":"a9f1bbba-57a5-46f1-aea6-6b2e4157e5cf"}
{"type":"assistant","message":{"id":"msg_202605230542353c3ad68e7f0442b0","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_52c9073f63a74b8793db432a","name":"Write","input":{"file_path":"D:\\game-projects\\douyin-match3\\src\\js\\Navigation.js","content":"// Navigation.js — Full screen navigation: menu → map → character → game → result\n\nconst NAV_SCREENS = {\n  MENU: 'menu',\n  MAP: 'map',\n  SHOP: 'shop',\n  CHARACTER: 'character',\n  GAME: 'game',\n  RESULT: 'result',\n};\n\nclass Navigation {\n  constructor(game) {\n    this.game = game;\n    this.screen = NAV_SCREENS.MENU;\n    this.dataManager = game.dataManager;\n    this.coinSystem = game.coinSystem;\n    this.characterMgr = game.characterMgr;\n    this.mapScreen = game.mapScreen;\n    this.shopUI = game.shopUI;\n    this.resultCoins = 0;\n    this.resultWon = false;\n    this.resultScore = 0;\n    this.resultStars = 0;\n    this.resultLevel = 0;\n    this.menuAnim = 0;\n  }\n\n  isActive() {\n    return this.screen !== NAV_SCREENS.GAME;\n  }\n\n  goTo(screen) {\n    this.screen = screen;\n  }\n\n  render(ctx, screenW, screenH) {\n    switch (this.screen) {\n      case NAV_SCREENS.MENU:\n        this._renderMenu(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.MAP:\n        this.mapScreen.render(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.SHOP:\n        this.shopUI.render(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.CHARACTER:\n        this._renderCharacterSelect(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.RESULT:\n        this._renderResult(ctx, screenW, screenH);\n        break;\n    }\n  }\n\n  handleClick(x, y, screenW, screenH) {\n    switch (this.screen) {\n      case NAV_SCREENS.MENU:\n        return this._handleMenuClick(x, y, screenW, screenH);\n      case NAV_SCREENS.MAP:\n        return this._handleMapClick(x, y, screenW, screenH);\n      case NAV_SCREENS.SHOP:\n        return this._handleShopClick(x, y, screenW, screenH);\n      case NAV_SCREENS.CHARACTER:\n        return this._handleCharacterClick(x, y, screenW, screenH);\n      case NAV_SCREENS.RESULT:\n        return this._handleResultClick(x, y, screenW, screenH);\n    }\n    return null;\n  }\n\n  // --- MENU ---\n  _renderMenu(ctx, w, h) {\n    this.menuAnim += 1 / 60;\n\n    // Gradient background\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0, '#FFE8F0');\n    grad.addColorStop(0.5, '#FFF8E7');\n    grad.addColorStop(1, '#E3F2FD');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n\n    // Floating fruit emojis\n    const emojis = ['🍎', '🍌', '🫐', '🍏', '🍇', '🍊'];\n    for (let i = 0; i < 12; i++) {\n      const bx = (w * 0.08 + (i * 137.5) % (w * 0.84));\n      const by = (h * 0.08 + (i * 97.3 + Math.sin(this.menuAnim * 0.8 + i * 0.7) * 25) % (h * 0.75));\n      ctx.globalAlpha = 0.12;\n      ctx.font = `${22 + (i % 3) * 8}px sans-serif`;\n      ctx.textAlign = 'center';\n      ctx.fillText(emojis[i % emojis.length], bx, by);\n    }\n    ctx.globalAlpha = 1;\n\n    // Title\n    const titleY = h * 0.22;\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 38px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('消消消大作战', w / 2, titleY);\n\n    // Subtitle with wave animation\n    ctx.font = '18px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText('Match & Blast', w / 2, titleY + 35);\n\n    // Fruit emoji row\n    ctx.font = '30px sans-serif';\n    for (let i = 0; i < 6; i++) {\n      const fx = w / 2 - 75 + i * 30;\n      const fy = titleY + 70 + Math.sin(this.menuAnim * 2 + i * 0.8) * 5;\n      ctx.fillText(emojis[i], fx, fy);\n    }\n\n    // Start button with pulse\n    const btnW = 200, btnH = 52;\n    const btnX = (w - btnW) / 2;\n    const btnY = h * 0.52;\n    const pulse = 1 + Math.sin(this.menuAnim * 2.5) * 0.03;\n\n    ctx.save();\n    ctx.translate(w / 2, btnY + btnH / 2);\n    ctx.scale(pulse, pulse);\n    ctx.translate(-w / 2, -(btnY + btnH / 2));\n\n    ctx.fillStyle = '#FFB800';\n    ctx.shadowColor = '#FFB80088';\n    ctx.shadowBlur = 15;\n    this._roundRect(ctx, btnX, btnY, btnW, btnH, 26);\n    ctx.fill();\n    ctx.shadowBlur = 0;\n\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.fillText('🎮 开始游戏', w / 2, btnY + 34);\n    ctx.restore();\n\n    // Continue (if has progress)\n    const completed = Object.keys(this.dataManager.data.levelStars).length;\n    if (completed > 0) {\n      const cBtnY = btnY + btnH + 20;\n      ctx.fillStyle = '#6BCB77';\n      this._roundRect(ctx, btnX, cBtnY, btnW, 44, 22);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText(`继续游戏 (${completed}关)`, w / 2, cBtnY + 28);\n    }\n\n    // Version\n    ctx.fillStyle = '#C0B8A8';\n    ctx.font = '12px sans-serif';\n    ctx.fillText('Phase 3a v1.0', w / 2, h - 20);\n  }\n\n  _handleMenuClick(x, y, w, h) {\n    const btnW = 200, btnH = 52;\n    const btnX = (w - btnW) / 2;\n    const btnY = h * 0.52;\n\n    // Start button\n    if (x >= btnX && x <= btnX + btnW && y >= btnY && y <= btnY + btnH) {\n      this.goTo(NAV_SCREENS.MAP);\n      return { action: 'start' };\n    }\n\n    // Continue button\n    const completed = Object.keys(this.dataManager.data.levelStars).length;\n    if (completed > 0) {\n      const cBtnY = btnY + btnH + 20;\n      if (x >= btnX && x <= btnX + btnW && y >= cBtnY && y <= cBtnY + 44) {\n        this.goTo(NAV_SCREENS.MAP);\n        return { action: 'start' };\n      }\n    }\n    return null;\n  }\n\n  // --- MAP ---\n  _handleMapClick(x, y, w, h) {\n    const result = this.mapScreen.handleClick(x, y, w, h);\n    if (!result) return null;\n\n    if (result.action === 'play') {\n      this._startLevel(result.level);\n    } else if (result.action === 'shop') {\n      this.goTo(NAV_SCREENS.SHOP);\n    } else if (result.action === 'character') {\n      this.goTo(NAV_SCREENS.CHARACTER);\n    }\n    return result;\n  }\n\n  _startLevel(levelIdx) {\n    this.game._loadLevel(levelIdx);\n    this.game.state = STATES.IDLE;\n    this.characterMgr.applySkill(\n      this.dataManager.selectedCharacter,\n      this.game, 'level_start', null,\n    );\n    this.goTo(NAV_SCREENS.GAME);\n  }\n\n  // --- SHOP ---\n  _handleShopClick(x, y, w, h) {\n    const result = this.shopUI.handleClick(x, y, w, h);\n    if (!result) return null;\n    if (result.action === 'buy') {\n      this.coinSystem.buy(result.itemId);\n    } else if (result.action === 'back') {\n      this.goTo(NAV_SCREENS.MAP);\n    }\n    return result;\n  }\n\n  // --- CHARACTER SELECT ---\n  _renderCharacterSelect(ctx, w, h) {\n    // Background\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0, '#F3E5F5');\n    grad.addColorStop(1, '#FFF8E7');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n\n    // Title bar\n    ctx.fillStyle = '#B47AEA';\n    this._roundRect(ctx, 10, 8, w - 20, 48, 12);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('👤 选择角色', w / 2, 40);\n\n    // Character cards\n    const chars = this.characterMgr.getAll();\n    const cardW = Math.min((w - 50) / 2, 160);\n    const cardH = 130;\n    const totalGridW = cardW * 2 + 16;\n    const gridStartX = (w - totalGridW) / 2;\n    const startY = 75;\n\n    for (let i = 0; i < chars.length; i++) {\n      const ch = chars[i];\n      const row = Math.floor(i / 2);\n      const col = i % 2;\n      const cx = gridStartX + col * (cardW + 16);\n      const cy = startY + row * (cardH + 12);\n      const unlocked = this.characterMgr.isUnlocked(i, this.dataManager.unlockedLevel);\n      const selected = this.dataManager.selectedCharacter === i;\n\n      // Card background\n      if (selected) {\n        ctx.fillStyle = '#FFE0B2';\n      } else if (unlocked) {\n        ctx.fillStyle = '#FFFFFFEE';\n      } else {\n        ctx.fillStyle = '#E8E0D8';\n      }\n      this._roundRect(ctx, cx, cy, cardW, cardH, 12);\n      ctx.fill();\n\n      // Selected border\n      if (selected) {\n        ctx.strokeStyle = '#FFB800';\n        ctx.lineWidth = 3;\n        this._roundRect(ctx, cx, cy, cardW, cardH, 12);\n        ctx.stroke();\n\n        // Check mark\n        ctx.fillStyle = '#FFB800';\n        ctx.font = '16px sans-serif';\n        ctx.textAlign = 'right';\n        ctx.fillText('✓', cx + cardW - 8, cy + 18);\n      }\n\n      // Emoji\n      ctx.font = '36px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText(unlocked ? ch.emoji : '🔒', cx + cardW / 2, cy + 45);\n\n      // Name\n      ctx.fillStyle = unlocked ? '#5D4037' : '#A09888';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText(ch.name, cx + cardW / 2, cy + 72);\n\n      // Title\n      ctx.font = '11px sans-serif';\n      ctx.fillStyle = unlocked ? '#B47AEA' : '#C0B8A8';\n      ctx.fillText(ch.title, cx + cardW / 2, cy + 88);\n\n      // Description or unlock requirement\n      ctx.fillStyle = unlocked ? '#8D6E63' : '#B0A898';\n      ctx.font = '10px sans-serif';\n      const desc = unlocked ? ch.desc : `通过第${ch.unlockLevel}关解锁`;\n      // Word wrap for long text\n      if (desc.length > 10) {\n        const mid = Math.ceil(desc.length / 2);\n        const spaceIdx = desc.indexOf(' ', mid - 3);\n        if (spaceIdx > 0 && spaceIdx < desc.length - 1) {\n          ctx.fillText(desc.substring(0, spaceIdx), cx + cardW / 2, cy + 104);\n          ctx.fillText(desc.substring(spaceIdx + 1), cx + cardW / 2, cy + 118);\n        } else {\n          ctx.fillText(desc.substring(0, Math.ceil(desc.length / 2)), cx + cardW / 2, cy + 104);\n          ctx.fillText(desc.substring(Math.ceil(desc.length / 2)), cx + cardW / 2, cy + 118);\n        }\n      } else {\n        ctx.fillText(desc, cx + cardW / 2, cy + 110);\n      }\n    }\n\n    // Confirm button\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, 20, h - 58, w - 40, 42, 21);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 16px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('确认返回', w / 2, h - 32);\n  }\n\n  _handleCharacterClick(x, y, w, h) {\n    const chars = this.characterMgr.getAll();\n    const cardW = Math.min((w - 50) / 2, 160);\n    const cardH = 130;\n    const totalGridW = cardW * 2 + 16;\n    const gridStartX = (w - totalGridW) / 2;\n    const startY = 75;\n\n    for (let i = 0; i < chars.length; i++) {\n      const row = Math.floor(i / 2);\n      const col = i % 2;\n      const cx = gridStartX + col * (cardW + 16);\n      const cy = startY + row * (cardH + 12);\n      if (x >= cx && x <= cx + cardW && y >= cy && y <= cy + cardH) {\n        if (this.characterMgr.isUnlocked(i, this.dataManager.unlockedLevel)) {\n          this.dataManager.selectedCharacter = i;\n        }\n        return { action: 'select_char', charId: i };\n      }\n    }\n\n    // Confirm button\n    if (y >= h - 58 && y <= h - 16 && x >= 20 && x <= w - 20) {\n      this.goTo(NAV_SCREENS.MAP);\n      return { action: 'back' };\n    }\n    return null;\n  }\n\n  // --- RESULT ---\n  showResult(won, score, stars, level) {\n    this.resultWon = won;\n    this.resultScore = score;\n    this.resultStars = stars;\n    this.resultLevel = level;\n    this.resultCoins = 0;\n    if (won && stars > 0) {\n      this.resultCoins = this.coinSystem.awardStars(stars);\n      this.dataManager.setLevelStars(level, stars);\n    }\n    this.goTo(NAV_SCREENS.RESULT);\n  }\n\n  _renderResult(ctx, w, h) {\n    // Dim background\n    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n    ctx.fillRect(0, 0, w, h);\n\n    const pw = Math.min(320, w - 40);\n    const ph = 330;\n    const px = (w - pw) / 2;\n    const py = (h - ph) / 2;\n\n    // Panel\n    ctx.fillStyle = '#FFF8E7';\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.fill();\n    ctx.strokeStyle = '#FFB800';\n    ctx.lineWidth = 3;\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.stroke();\n\n    ctx.textAlign = 'center';\n\n    // Title\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 24px sans-serif';\n    ctx.fillText(this.resultWon ? '🎉 恭喜过关！' : '😢 挑战失败', w / 2, py + 45);\n\n    // Level number\n    ctx.font = '14px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText(`第 ${this.resultLevel} 关`, w / 2, py + 68);\n\n    // Score\n    ctx.font = 'bold 36px sans-serif';\n    ctx.fillStyle = '#FFB800';\n    ctx.fillText(this.resultScore, w / 2, py + 110);\n    ctx.font = '14px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText('得分', w / 2, py + 130);\n\n    // Stars\n    if (this.resultWon) {\n      for (let i = 0; i < 3; i++) {\n        ctx.font = '30px sans-serif';\n        ctx.fillText(i < this.resultStars ? '⭐' : '☆', w / 2 - 40 + i * 40, py + 172);\n      }\n    }\n\n    // Coins earned\n    if (this.resultCoins > 0) {\n      ctx.fillStyle = '#FFB800';\n      ctx.font = 'bold 18px sans-serif';\n      ctx.fillText(`+${this.resultCoins} 🪙`, w / 2, py + 205);\n      ctx.fillStyle = '#8D6E63';\n      ctx.font = '12px sans-serif';\n      ctx.fillText(`余额: ${this.dataManager.coins} 🪙`, w / 2, py + 224);\n    }\n\n    // Buttons\n    const btnW = 120, btnH = 42;\n    const btnY = py + ph - 65;\n\n    if (this.resultWon) {\n      // Next level\n      ctx.fillStyle = '#6BCB77';\n      this._roundRect(ctx, w / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText('下一关', w / 2 - btnW / 2 - 10, btnY + 27);\n    } else {\n      // Retry\n      ctx.fillStyle = '#FF9A3C';\n      this._roundRect(ctx, w / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText('重试', w / 2 - btnW / 2 - 10, btnY + 27);\n    }\n\n    // Map button\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, w / 2 + 10, btnY, btnW, btnH, btnH / 2);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.fillText('🗺️ 地图', w / 2 + btnW / 2 + 10, btnY + 27);\n  }\n\n  _handleResultClick(x, y, w, h) {\n    const pw = Math.min(320, w - 40);\n    const ph = 330;\n    const px = (w - pw) / 2;\n    const py = (h - ph) / 2;\n    const btnW = 120, btnH = 42;\n    const btnY = py + ph - 65;\n\n    // Next / Retry button\n    if (x >= w / 2 - btnW - 10 && x <= w / 2 - 10 && y >= btnY && y <= btnY + btnH) {\n      if (this.resultWon) {\n        this.game.nextLevel();\n      } else {\n        this.game.retry();\n      }\n      this.characterMgr.applySkill(\n        this.dataManager.selectedCharacter,\n        this.game, 'level_start', null,\n      );\n      this.goTo(NAV_SCREENS.GAME);\n      return { action: this.resultWon ? 'next' : 'retry' };\n    }\n\n    // Map button\n    if (x >= w / 2 + 10 && x <= w / 2 + 10 + btnW && y >= btnY && y <= btnY + btnH) {\n      this.goTo(NAV_SCREENS.MAP);\n      return { action: 'map' };\n    }\n    return null;\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Navigation, NAV_SCREENS };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"fc99b580-aa14-4899-aa35-a732e530edf6","uuid":"c897d268-fc5a-48dc-8fa3-563184eba80d"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_4844d7270da14ccb983e8e6f","type":"tool_result","content":"File created successfully at: D:\\game-projects\\douyin-match3\\src\\js\\DataManager.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"fc99b580-aa14-4899-aa35-a732e530edf6","uuid":"785bc180-f8e8-4ae7-b05e-e7f7b6a02abd","timestamp":"2026-05-22T21:48:20.463Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\douyin-match3\\src\\js\\DataManager.js","content":"// DataManager.js — localStorage persistence for game progress\n\nclass DataManager {\n  constructor() {\n    this.STORAGE_KEY = 'match3_save';\n    this.data = this._load();\n  }\n\n  _defaults() {\n    return {\n      levelStars: {},\n      unlockedLevel: 1,\n      coins: 0,\n      selectedCharacter: 0,\n      ownedItems: {},\n      soundEnabled: true,\n    };\n  }\n\n  _load() {\n    try {\n      const raw = localStorage.getItem(this.STORAGE_KEY);\n      if (raw) return { ...this._defaults(), ...JSON.parse(raw) };\n    } catch (e) { /* ignore */ }\n    return this._defaults();\n  }\n\n  save() {\n    try {\n      localStorage.setItem(this.STORAGE_KEY, JSON.stringify(this.data));\n    } catch (e) { /* ignore */ }\n  }\n\n  getLevelStars(id) { return this.data.levelStars[id] || 0; }\n\n  setLevelStars(id, stars) {\n    if (stars > (this.data.levelStars[id] || 0)) {\n      this.data.levelStars[id] = stars;\n    }\n    if (id >= this.data.unlockedLevel) {\n      this.data.unlockedLevel = id + 1;\n    }\n    this.save();\n  }\n\n  get unlockedLevel() { return this.data.unlockedLevel; }\n  get coins() { return this.data.coins; }\n\n  addCoins(n) { this.data.coins += n; this.save(); return this.data.coins; }\n  spendCoins(n) {\n    if (this.data.coins >= n) { this.data.coins -= n; this.save(); return true; }\n    return false;\n  }\n\n  get selectedCharacter() { return this.data.selectedCharacter; }\n  set selectedCharacter(v) { this.data.selectedCharacter = v; this.save(); }\n\n  getItemCount(id) { return this.data.ownedItems[id] || 0; }\n  addItem(id, n = 1) { this.data.ownedItems[id] = (this.data.ownedItems[id] || 0) + n; this.save(); }\n  useItem(id) {\n    if ((this.data.ownedItems[id] || 0) > 0) { this.data.ownedItems[id]--; this.save(); return true; }\n    return false;\n  }\n\n  reset() { this.data = this._defaults(); this.save(); }\n}\n\nif (typeof module !== 'undefined') module.exports = { DataManager };\n","structuredPatch":[],"originalFile":null,"userModified":false}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_86e896a8706d475b8c47f7e4","type":"tool_result","content":"File created successfully at: D:\\game-projects\\douyin-match3\\src\\js\\CoinSystem.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"fc99b580-aa14-4899-aa35-a732e530edf6","uuid":"9f100a34-296a-475e-bc2f-97ff3e6ffac8","timestamp":"2026-05-22T21:48:21.181Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\douyin-match3\\src\\js\\CoinSystem.js","content":"// CoinSystem.js — Gold economy with rewards and shop\n\nclass CoinSystem {\n  constructor(dataManager) {\n    this.dm = dataManager;\n    this.STAR_REWARDS = { 1: 10, 2: 20, 3: 30 };\n    this.CONTINUE_COST = 10;\n    this.SHOP_ITEMS = [\n      { id: 'striped_bomb', name: '条纹炸弹', desc: '开局放置1个条纹炸弹', price: 5, emoji: '💥' },\n      { id: 'area_bomb', name: '区域炸弹', desc: '开局放置1个区域炸弹', price: 8, emoji: '💣' },\n      { id: 'rainbow', name: '彩虹方块', desc: '开局放置1个彩虹方块', price: 15, emoji: '🌈' },\n      { id: 'extra_moves', name: '额外步数', desc: '开局额外+5步', price: 10, emoji: '👟' },\n      { id: 'shuffle', name: '洗牌卡', desc: '重新排列棋盘方块', price: 3, emoji: '🔀' },\n    ];\n  }\n\n  awardStars(stars) {\n    const reward = this.STAR_REWARDS[stars] || 0;\n    if (reward > 0) this.dm.addCoins(reward);\n    return reward;\n  }\n\n  canContinue() { return this.dm.coins >= this.CONTINUE_COST; }\n  buyContinue() { return this.dm.spendCoins(this.CONTINUE_COST); }\n\n  canBuy(itemId) {\n    const item = this.SHOP_ITEMS.find(i => i.id === itemId);\n    return item && this.dm.coins >= item.price;\n  }\n\n  buy(itemId) {\n    const item = this.SHOP_ITEMS.find(i => i.id === itemId);\n    if (!item || !this.dm.spendCoins(item.price)) return false;\n    this.dm.addItem(itemId);\n    return true;\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { CoinSystem };\n","structuredPatch":[],"originalFile":null,"userModified":false}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_14de805b544848fab6aeaf06","type":"tool_result","content":"File created successfully at: D:\\game-projects\\douyin-match3\\src\\js\\Characters.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"fc99b580-aa14-4899-aa35-a732e530edf6","uuid":"f2e716b0-85be-482e-8522-aaafad3bea52","timestamp":"2026-05-22T21:48:22.024Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\douyin-match3\\src\\js\\Characters.js","content":"// Characters.js — 4 playable characters with unique skills\n\nclass CharacterManager {\n  constructor() {\n    this.characters = [\n      {\n        id: 0, name: '小果', emoji: '🍎', title: '果实精灵',\n        desc: '开局额外+2步',\n        skill: 'extra_moves', param: 2, unlockLevel: 1,\n      },\n      {\n        id: 1, name: '冰冰', emoji: '❄️', title: '冰雪仙子',\n        desc: '每5步自动清除1个障碍',\n        skill: 'auto_obstacle', param: 5, unlockLevel: 5,\n      },\n      {\n        id: 2, name: '星星', emoji: '⭐', title: '幸运星',\n        desc: '消除时15%概率生成条纹炸弹',\n        skill: 'lucky_special', param: 0.15, unlockLevel: 10,\n      },\n      {\n        id: 3, name: '彩虹', emoji: '🌈', title: '彩虹使者',\n        desc: '连锁3+时额外+100分',\n        skill: 'chain_bonus', param: 100, unlockLevel: 15,\n      },\n    ];\n  }\n\n  getAll() { return this.characters; }\n  get(id) { return this.characters[id]; }\n  isUnlocked(id, maxLevel) { return this.characters[id].unlockLevel <= maxLevel; }\n\n  applySkill(charId, game, event, params) {\n    const ch = this.characters[charId];\n    if (!ch) return;\n\n    switch (ch.skill) {\n      case 'extra_moves':\n        if (event === 'level_start') {\n          game.scoreSystem.maxMoves += ch.param;\n        }\n        break;\n\n      case 'auto_obstacle':\n        if (event === 'after_move' && game.moveCount % ch.param === 0) {\n          const obs = game.obstacleMgr.obstacles.filter(o => !o.isDestroyed());\n          if (obs.length > 0) {\n            const t = obs[Math.floor(Math.random() * obs.length)];\n            t.hp = 0;\n            game.scoreSystem.addObstacleCleared(t.type);\n            const pos = game.renderer.getTileCenter(t.row, t.col);\n            game.particles.emitExplosion(pos.x, pos.y, '#88CCFF', 12);\n            game.audio.playObstacleBreak();\n          }\n        }\n        break;\n\n      case 'lucky_special':\n        if (event === 'match_created' && Math.random() < ch.param && params && params.cells) {\n          const cell = params.cells[Math.floor(Math.random() * params.cells.length)];\n          const tile = game.board.getTile(cell.row, cell.col);\n          if (tile && tile.special === SPECIAL_NONE) {\n            tile.special = SPECIAL_STRIPED_H;\n            game.audio.playSpecial();\n          }\n        }\n        break;\n\n      case 'chain_bonus':\n        if (event === 'chain_score' && params && params.chainCount >= 3) {\n          game.scoreSystem.addScore(ch.param);\n        }\n        break;\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { CharacterManager };\n","structuredPatch":[],"originalFile":null,"userModified":false}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_95a033de3c72400e8362219b","type":"tool_result","content":"File created successfully at: D:\\game-projects\\douyin-match3\\src\\js\\MapScreen.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"fc99b580-aa14-4899-aa35-a732e530edf6","uuid":"499fb4fb-1b52-4a1c-b10c-c26a24f91c00","timestamp":"2026-05-22T21:48:22.735Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\douyin-match3\\src\\js\\MapScreen.js","content":"// MapScreen.js — Path-style level selection map with star display and lock states\n\nclass MapScreen {\n  constructor(dataManager) {\n    this.dm = dataManager;\n    this.nodeSize = 44;\n    this.animTime = 0;\n  }\n\n  getNodePositions(screenW) {\n    const positions = [];\n    const cols = 5;\n    const rows = 4;\n    const hSpacing = Math.min((screenW - 80) / (cols - 1), 80);\n    const vSpacing = 110;\n    const startX = (screenW - hSpacing * (cols - 1)) / 2;\n    const startY = 130;\n\n    for (let r = 0; r < rows; r++) {\n      for (let c = 0; c < cols; c++) {\n        const levelIdx = r * cols + c;\n        const actualCol = r % 2 === 0 ? c : (cols - 1 - c);\n        positions.push({\n          level: levelIdx,\n          x: startX + actualCol * hSpacing,\n          y: startY + r * vSpacing,\n        });\n      }\n    }\n    return positions;\n  }\n\n  getThemeColor(levelIdx) {\n    if (levelIdx < 5) return { node: '#FF4D4D', path: '#FFB800', glow: '#FFE0EC' };\n    if (levelIdx < 10) return { node: '#4DA6FF', path: '#4DA6FF', glow: '#B3E5FC' };\n    if (levelIdx < 15) return { node: '#FF9A3C', path: '#FF9A3C', glow: '#FFE0B2' };\n    return { node: '#B47AEA', path: '#B47AEA', glow: '#D1C4E9' };\n  }\n\n  render(ctx, screenW, screenH) {\n    this.animTime += 1 / 60;\n    const positions = this.getNodePositions(screenW);\n\n    // Background gradient\n    const grad = ctx.createLinearGradient(0, 0, 0, screenH);\n    grad.addColorStop(0, '#FFE8F0');\n    grad.addColorStop(0.4, '#E8F5E9');\n    grad.addColorStop(1, '#E3F2FD');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, screenW, screenH);\n\n    // Decorative floating elements\n    const decos = ['🍬', '🍭', '🌟', '✨', '🍰'];\n    for (let i = 0; i < 8; i++) {\n      ctx.globalAlpha = 0.1;\n      ctx.font = `${16 + (i % 3) * 6}px sans-serif`;\n      ctx.textAlign = 'center';\n      const dx = (screenW * 0.15 + (i * 97) % (screenW * 0.7));\n      const dy = (50 + (i * 67 + Math.sin(this.animTime * 0.5 + i) * 15) % (screenH * 0.8));\n      ctx.fillText(decos[i % decos.length], dx, dy);\n    }\n    ctx.globalAlpha = 1;\n\n    // Title bar\n    ctx.fillStyle = '#FFB800';\n    this._roundRect(ctx, 10, 8, screenW - 20, 48, 12);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('🗺️ 关卡地图', screenW / 2, 40);\n\n    // Coins\n    ctx.textAlign = 'right';\n    ctx.font = 'bold 14px sans-serif';\n    ctx.fillStyle = '#FFF';\n    ctx.fillText(`🪙 ${this.dm.coins}`, screenW - 18, 38);\n\n    // Shop button (top-right area)\n    ctx.fillStyle = '#6BCB77';\n    this._roundRect(ctx, screenW - 82, 62, 65, 28, 14);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 12px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('🏪 商店', screenW - 50, 80);\n\n    // Character button\n    ctx.fillStyle = '#B47AEA';\n    this._roundRect(ctx, 17, 62, 65, 28, 14);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.fillText('👤 角色', 50, 80);\n\n    // Draw connecting paths\n    for (let i = 0; i < positions.length - 1; i++) {\n      const a = positions[i];\n      const b = positions[i + 1];\n      const theme = this.getThemeColor(i);\n      ctx.strokeStyle = theme.path + '60';\n      ctx.lineWidth = 4;\n      ctx.setLineDash([8, 4]);\n      ctx.beginPath();\n      ctx.moveTo(a.x, a.y);\n      ctx.lineTo(b.x, b.y);\n      ctx.stroke();\n      ctx.setLineDash([]);\n    }\n\n    // Draw level nodes\n    const unlocked = this.dm.unlockedLevel;\n    for (const pos of positions) {\n      const levelNum = pos.level + 1;\n      const stars = this.dm.getLevelStars(levelNum);\n      const isUnlocked = levelNum <= unlocked;\n      const isCurrent = levelNum === unlocked;\n      const theme = this.getThemeColor(pos.level);\n      const r = this.nodeSize / 2;\n\n      if (isUnlocked) {\n        // Pulse glow for current level\n        if (isCurrent) {\n          const glow = 6 + Math.sin(this.animTime * 3) * 4;\n          ctx.shadowColor = theme.node;\n          ctx.shadowBlur = glow;\n        }\n\n        // Node circle\n        const nodeGrad = ctx.createRadialGradient(pos.x, pos.y - 4, 2, pos.x, pos.y, r);\n        nodeGrad.addColorStop(0, theme.node + 'EE');\n        nodeGrad.addColorStop(1, theme.node);\n        ctx.fillStyle = nodeGrad;\n        ctx.beginPath();\n        ctx.arc(pos.x, pos.y, r, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.shadowBlur = 0;\n\n        // Shine\n        ctx.fillStyle = 'rgba(255,255,255,0.25)';\n        ctx.beginPath();\n        ctx.ellipse(pos.x, pos.y - r * 0.25, r * 0.6, r * 0.35, 0, 0, Math.PI * 2);\n        ctx.fill();\n\n        // Level number\n        ctx.fillStyle = '#FFF';\n        ctx.font = 'bold 18px sans-serif';\n        ctx.textAlign = 'center';\n        ctx.textBaseline = 'middle';\n        ctx.fillText(levelNum, pos.x, pos.y + 1);\n      } else {\n        // Locked node\n        ctx.fillStyle = '#D5CFC5';\n        ctx.beginPath();\n        ctx.arc(pos.x, pos.y, r, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.fillStyle = '#B0A898';\n        ctx.font = '16px sans-serif';\n        ctx.textAlign = 'center';\n        ctx.textBaseline = 'middle';\n        ctx.fillText('🔒', pos.x, pos.y);\n      }\n\n      // Stars below node\n      if (stars > 0) {\n        const starY = pos.y + r + 12;\n        ctx.font = '12px sans-serif';\n        ctx.textBaseline = 'alphabetic';\n        for (let s = 0; s < 3; s++) {\n          ctx.fillText(s < stars ? '⭐' : '☆', pos.x - 15 + s * 15, starY);\n        }\n      }\n    }\n\n    // Progress info\n    const completed = Object.keys(this.dm.data.levelStars).length;\n    ctx.fillStyle = '#8D6E63';\n    ctx.font = '12px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'alphabetic';\n    ctx.fillText(`已通关 ${completed}/20 关`, screenW / 2, screenH - 20);\n  }\n\n  handleClick(x, y, screenW, screenH) {\n    // Shop button\n    if (x >= screenW - 82 && x <= screenW - 17 && y >= 62 && y <= 90) {\n      return { action: 'shop' };\n    }\n\n    // Character button\n    if (x >= 17 && x <= 82 && y >= 62 && y <= 90) {\n      return { action: 'character' };\n    }\n\n    // Level nodes\n    const positions = this.getNodePositions(screenW);\n    const unlocked = this.dm.unlockedLevel;\n    for (const pos of positions) {\n      const dx = x - pos.x;\n      const dy = y - pos.y;\n      const hitR = this.nodeSize / 2 + 8;\n      if (dx * dx + dy * dy <= hitR * hitR) {\n        const levelNum = pos.level + 1;\n        if (levelNum <= unlocked) {\n          return { action: 'play', level: pos.level };\n        }\n        return null;\n      }\n    }\n    return null;\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { MapScreen };\n","structuredPatch":[],"originalFile":null,"userModified":false}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6817366687e94cf8add4cfba","type":"tool_result","content":"File created successfully at: D:\\game-projects\\douyin-match3\\src\\js\\ShopUI.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"fc99b580-aa14-4899-aa35-a732e530edf6","uuid":"c39dea00-46cb-43d0-b948-3a0a7fe0bf20","timestamp":"2026-05-22T21:48:23.427Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\douyin-match3\\src\\js\\ShopUI.js","content":"// ShopUI.js — Item shop with coin purchasing\n\nclass ShopUI {\n  constructor(coinSystem, dataManager) {\n    this.cs = coinSystem;\n    this.dm = dataManager;\n  }\n\n  render(ctx, screenW, screenH) {\n    // Background\n    const grad = ctx.createLinearGradient(0, 0, 0, screenH);\n    grad.addColorStop(0, '#FFF8E7');\n    grad.addColorStop(1, '#FFE0B2');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, screenW, screenH);\n\n    // Title bar\n    ctx.fillStyle = '#FFB800';\n    this._roundRect(ctx, 10, 8, screenW - 20, 48, 12);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('🏪 道具商店', screenW / 2, 40);\n\n    // Coins\n    ctx.font = 'bold 14px sans-serif';\n    ctx.textAlign = 'right';\n    ctx.fillText(`🪙 ${this.dm.coins}`, screenW - 18, 38);\n\n    // Item cards\n    const items = this.cs.SHOP_ITEMS;\n    const cardW = screenW - 40;\n    const cardH = 72;\n    const startY = 75;\n    const gap = 8;\n\n    for (let i = 0; i < items.length; i++) {\n      const item = items[i];\n      const y = startY + i * (cardH + gap);\n      const owned = this.dm.getItemCount(item.id);\n      const canBuy = this.dm.coins >= item.price;\n\n      // Card bg\n      ctx.fillStyle = '#FFFFFFDD';\n      this._roundRect(ctx, 20, y, cardW, cardH, 12);\n      ctx.fill();\n      ctx.strokeStyle = '#E0D5C5';\n      ctx.lineWidth = 1;\n      this._roundRect(ctx, 20, y, cardW, cardH, 12);\n      ctx.stroke();\n\n      // Emoji icon\n      ctx.font = '30px sans-serif';\n      ctx.textAlign = 'left';\n      ctx.fillText(item.emoji, 32, y + 42);\n\n      // Name\n      ctx.fillStyle = '#5D4037';\n      ctx.font = 'bold 15px sans-serif';\n      ctx.fillText(item.name, 72, y + 28);\n\n      // Description\n      ctx.fillStyle = '#8D6E63';\n      ctx.font = '12px sans-serif';\n      ctx.fillText(item.desc, 72, y + 48);\n\n      // Owned count\n      if (owned > 0) {\n        ctx.fillStyle = '#6BCB77';\n        ctx.font = 'bold 13px sans-serif';\n        ctx.textAlign = 'right';\n        ctx.fillText(`×${owned}`, screenW - 100, y + 28);\n      }\n\n      // Buy button\n      const buyX = screenW - 90;\n      const buyY = y + 20;\n      const buyW = 68;\n      const buyH = 32;\n      ctx.fillStyle = canBuy ? '#FFB800' : '#D0C8B8';\n      this._roundRect(ctx, buyX, buyY, buyW, buyH, buyH / 2);\n      ctx.fill();\n      ctx.fillStyle = canBuy ? '#FFF' : '#A09888';\n      ctx.font = 'bold 12px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText(`${item.price}🪙`, buyX + buyW / 2, buyY + 21);\n    }\n\n    // Back button\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, 20, screenH - 58, screenW - 40, 42, 21);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 16px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('返回地图', screenW / 2, screenH - 32);\n  }\n\n  handleClick(x, y, screenW, screenH) {\n    const items = this.cs.SHOP_ITEMS;\n    const cardH = 72;\n    const startY = 75;\n    const gap = 8;\n\n    // Buy buttons\n    for (let i = 0; i < items.length; i++) {\n      const iy = startY + i * (cardH + gap);\n      const buyX = screenW - 90;\n      const buyY = iy + 20;\n      if (x >= buyX && x <= buyX + 68 && y >= buyY && y <= buyY + 32) {\n        return { action: 'buy', itemId: items[i].id };\n      }\n    }\n\n    // Back button\n    if (y >= screenH - 58 && y <= screenH - 16 && x >= 20 && x <= screenW - 20) {\n      return { action: 'back' };\n    }\n\n    return null;\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { ShopUI };\n","structuredPatch":[],"originalFile":null,"userModified":false}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_52c9073f63a74b8793db432a","type":"tool_result","content":"File created successfully at: D:\\game-projects\\douyin-match3\\src\\js\\Navigation.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"fc99b580-aa14-4899-aa35-a732e530edf6","uuid":"34e92442-7f96-418a-8a39-564171759c62","timestamp":"2026-05-22T21:48:24.156Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\douyin-match3\\src\\js\\Navigation.js","content":"// Navigation.js — Full screen navigation: menu → map → character → game → result\n\nconst NAV_SCREENS = {\n  MENU: 'menu',\n  MAP: 'map',\n  SHOP: 'shop',\n  CHARACTER: 'character',\n  GAME: 'game',\n  RESULT: 'result',\n};\n\nclass Navigation {\n  constructor(game) {\n    this.game = game;\n    this.screen = NAV_SCREENS.MENU;\n    this.dataManager = game.dataManager;\n    this.coinSystem = game.coinSystem;\n    this.characterMgr = game.characterMgr;\n    this.mapScreen = game.mapScreen;\n    this.shopUI = game.shopUI;\n    this.resultCoins = 0;\n    this.resultWon = false;\n    this.resultScore = 0;\n    this.resultStars = 0;\n    this.resultLevel = 0;\n    this.menuAnim = 0;\n  }\n\n  isActive() {\n    return this.screen !== NAV_SCREENS.GAME;\n  }\n\n  goTo(screen) {\n    this.screen = screen;\n  }\n\n  render(ctx, screenW, screenH) {\n    switch (this.screen) {\n      case NAV_SCREENS.MENU:\n        this._renderMenu(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.MAP:\n        this.mapScreen.render(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.SHOP:\n        this.shopUI.render(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.CHARACTER:\n        this._renderCharacterSelect(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.RESULT:\n        this._renderResult(ctx, screenW, screenH);\n        break;\n    }\n  }\n\n  handleClick(x, y, screenW, screenH) {\n    switch (this.screen) {\n      case NAV_SCREENS.MENU:\n        return this._handleMenuClick(x, y, screenW, screenH);\n      case NAV_SCREENS.MAP:\n        return this._handleMapClick(x, y, screenW, screenH);\n      case NAV_SCREENS.SHOP:\n        return this._handleShopClick(x, y, screenW, screenH);\n      case NAV_SCREENS.CHARACTER:\n        return this._handleCharacterClick(x, y, screenW, screenH);\n      case NAV_SCREENS.RESULT:\n        return this._handleResultClick(x, y, screenW, screenH);\n    }\n    return null;\n  }\n\n  // --- MENU ---\n  _renderMenu(ctx, w, h) {\n    this.menuAnim += 1 / 60;\n\n    // Gradient background\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0, '#FFE8F0');\n    grad.addColorStop(0.5, '#FFF8E7');\n    grad.addColorStop(1, '#E3F2FD');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n\n    // Floating fruit emojis\n    const emojis = ['🍎', '🍌', '🫐', '🍏', '🍇', '🍊'];\n    for (let i = 0; i < 12; i++) {\n      const bx = (w * 0.08 + (i * 137.5) % (w * 0.84));\n      const by = (h * 0.08 + (i * 97.3 + Math.sin(this.menuAnim * 0.8 + i * 0.7) * 25) % (h * 0.75));\n      ctx.globalAlpha = 0.12;\n      ctx.font = `${22 + (i % 3) * 8}px sans-serif`;\n      ctx.textAlign = 'center';\n      ctx.fillText(emojis[i % emojis.length], bx, by);\n    }\n    ctx.globalAlpha = 1;\n\n    // Title\n    const titleY = h * 0.22;\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 38px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('消消消大作战', w / 2, titleY);\n\n    // Subtitle with wave animation\n    ctx.font = '18px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText('Match & Blast', w / 2, titleY + 35);\n\n    // Fruit emoji row\n    ctx.font = '30px sans-serif';\n    for (let i = 0; i < 6; i++) {\n      const fx = w / 2 - 75 + i * 30;\n      const fy = titleY + 70 + Math.sin(this.menuAnim * 2 + i * 0.8) * 5;\n      ctx.fillText(emojis[i], fx, fy);\n    }\n\n    // Start button with pulse\n    const btnW = 200, btnH = 52;\n    const btnX = (w - btnW) / 2;\n    const btnY = h * 0.52;\n    const pulse = 1 + Math.sin(this.menuAnim * 2.5) * 0.03;\n\n    ctx.save();\n    ctx.translate(w / 2, btnY + btnH / 2);\n    ctx.scale(pulse, pulse);\n    ctx.translate(-w / 2, -(btnY + btnH / 2));\n\n    ctx.fillStyle = '#FFB800';\n    ctx.shadowColor = '#FFB80088';\n    ctx.shadowBlur = 15;\n    this._roundRect(ctx, btnX, btnY, btnW, btnH, 26);\n    ctx.fill();\n    ctx.shadowBlur = 0;\n\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.fillText('🎮 开始游戏', w / 2, btnY + 34);\n    ctx.restore();\n\n    // Continue (if has progress)\n    const completed = Object.keys(this.dataManager.data.levelStars).length;\n    if (completed > 0) {\n      const cBtnY = btnY + btnH + 20;\n      ctx.fillStyle = '#6BCB77';\n      this._roundRect(ctx, btnX, cBtnY, btnW, 44, 22);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText(`继续游戏 (${completed}关)`, w / 2, cBtnY + 28);\n    }\n\n    // Version\n    ctx.fillStyle = '#C0B8A8';\n    ctx.font = '12px sans-serif';\n    ctx.fillText('Phase 3a v1.0', w / 2, h - 20);\n  }\n\n  _handleMenuClick(x, y, w, h) {\n    const btnW = 200, btnH = 52;\n    const btnX = (w - btnW) / 2;\n    const btnY = h * 0.52;\n\n    // Start button\n    if (x >= btnX && x <= btnX + btnW && y >= btnY && y <= btnY + btnH) {\n      this.goTo(NAV_SCREENS.MAP);\n      return { action: 'start' };\n    }\n\n    // Continue button\n    const completed = Object.keys(this.dataManager.data.levelStars).length;\n    if (completed > 0) {\n      const cBtnY = btnY + btnH + 20;\n      if (x >= btnX && x <= btnX + btnW && y >= cBtnY && y <= cBtnY + 44) {\n        this.goTo(NAV_SCREENS.MAP);\n        return { action: 'start' };\n      }\n    }\n    return null;\n  }\n\n  // --- MAP ---\n  _handleMapClick(x, y, w, h) {\n    const result = this.mapScreen.handleClick(x, y, w, h);\n    if (!result) return null;\n\n    if (result.action === 'play') {\n      this._startLevel(result.level);\n    } else if (result.action === 'shop') {\n      this.goTo(NAV_SCREENS.SHOP);\n    } else if (result.action === 'character') {\n      this.goTo(NAV_SCREENS.CHARACTER);\n    }\n    return result;\n  }\n\n  _startLevel(levelIdx) {\n    this.game._loadLevel(levelIdx);\n    this.game.state = STATES.IDLE;\n    this.characterMgr.applySkill(\n      this.dataManager.selectedCharacter,\n      this.game, 'level_start', null,\n    );\n    this.goTo(NAV_SCREENS.GAME);\n  }\n\n  // --- SHOP ---\n  _handleShopClick(x, y, w, h) {\n    const result = this.shopUI.handleClick(x, y, w, h);\n    if (!result) return null;\n    if (result.action === 'buy') {\n      this.coinSystem.buy(result.itemId);\n    } else if (result.action === 'back') {\n      this.goTo(NAV_SCREENS.MAP);\n    }\n    return result;\n  }\n\n  // --- CHARACTER SELECT ---\n  _renderCharacterSelect(ctx, w, h) {\n    // Background\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0, '#F3E5F5');\n    grad.addColorStop(1, '#FFF8E7');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n\n    // Title bar\n    ctx.fillStyle = '#B47AEA';\n    this._roundRect(ctx, 10, 8, w - 20, 48, 12);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('👤 选择角色', w / 2, 40);\n\n    // Character cards\n    const chars = this.characterMgr.getAll();\n    const cardW = Math.min((w - 50) / 2, 160);\n    const cardH = 130;\n    const totalGridW = cardW * 2 + 16;\n    const gridStartX = (w - totalGridW) / 2;\n    const startY = 75;\n\n    for (let i = 0; i < chars.length; i++) {\n      const ch = chars[i];\n      const row = Math.floor(i / 2);\n      const col = i % 2;\n      const cx = gridStartX + col * (cardW + 16);\n      const cy = startY + row * (cardH + 12);\n      const unlocked = this.characterMgr.isUnlocked(i, this.dataManager.unlockedLevel);\n      const selected = this.dataManager.selectedCharacter === i;\n\n      // Card background\n      if (selected) {\n        ctx.fillStyle = '#FFE0B2';\n      } else if (unlocked) {\n        ctx.fillStyle = '#FFFFFFEE';\n      } else {\n        ctx.fillStyle = '#E8E0D8';\n      }\n      this._roundRect(ctx, cx, cy, cardW, cardH, 12);\n      ctx.fill();\n\n      // Selected border\n      if (selected) {\n        ctx.strokeStyle = '#FFB800';\n        ctx.lineWidth = 3;\n        this._roundRect(ctx, cx, cy, cardW, cardH, 12);\n        ctx.stroke();\n\n        // Check mark\n        ctx.fillStyle = '#FFB800';\n        ctx.font = '16px sans-serif';\n        ctx.textAlign = 'right';\n        ctx.fillText('✓', cx + cardW - 8, cy + 18);\n      }\n\n      // Emoji\n      ctx.font = '36px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText(unlocked ? ch.emoji : '🔒', cx + cardW / 2, cy + 45);\n\n      // Name\n      ctx.fillStyle = unlocked ? '#5D4037' : '#A09888';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText(ch.name, cx + cardW / 2, cy + 72);\n\n      // Title\n      ctx.font = '11px sans-serif';\n      ctx.fillStyle = unlocked ? '#B47AEA' : '#C0B8A8';\n      ctx.fillText(ch.title, cx + cardW / 2, cy + 88);\n\n      // Description or unlock requirement\n      ctx.fillStyle = unlocked ? '#8D6E63' : '#B0A898';\n      ctx.font = '10px sans-serif';\n      const desc = unlocked ? ch.desc : `通过第${ch.unlockLevel}关解锁`;\n      // Word wrap for long text\n      if (desc.length > 10) {\n        const mid = Math.ceil(desc.length / 2);\n        const spaceIdx = desc.indexOf(' ', mid - 3);\n        if (spaceIdx > 0 && spaceIdx < desc.length - 1) {\n          ctx.fillText(desc.substring(0, spaceIdx), cx + cardW / 2, cy + 104);\n          ctx.fillText(desc.substring(spaceIdx + 1), cx + cardW / 2, cy + 118);\n        } else {\n          ctx.fillText(desc.substring(0, Math.ceil(desc.length / 2)), cx + cardW / 2, cy + 104);\n          ctx.fillText(desc.substring(Math.ceil(desc.length / 2)), cx + cardW / 2, cy + 118);\n        }\n      } else {\n        ctx.fillText(desc, cx + cardW / 2, cy + 110);\n      }\n    }\n\n    // Confirm button\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, 20, h - 58, w - 40, 42, 21);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 16px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('确认返回', w / 2, h - 32);\n  }\n\n  _handleCharacterClick(x, y, w, h) {\n    const chars = this.characterMgr.getAll();\n    const cardW = Math.min((w - 50) / 2, 160);\n    const cardH = 130;\n    const totalGridW = cardW * 2 + 16;\n    const gridStartX = (w - totalGridW) / 2;\n    const startY = 75;\n\n    for (let i = 0; i < chars.length; i++) {\n      const row = Math.floor(i / 2);\n      const col = i % 2;\n      const cx = gridStartX + col * (cardW + 16);\n      const cy = startY + row * (cardH + 12);\n      if (x >= cx && x <= cx + cardW && y >= cy && y <= cy + cardH) {\n        if (this.characterMgr.isUnlocked(i, this.dataManager.unlockedLevel)) {\n          this.dataManager.selectedCharacter = i;\n        }\n        return { action: 'select_char', charId: i };\n      }\n    }\n\n    // Confirm button\n    if (y >= h - 58 && y <= h - 16 && x >= 20 && x <= w - 20) {\n      this.goTo(NAV_SCREENS.MAP);\n      return { action: 'back' };\n    }\n    return null;\n  }\n\n  // --- RESULT ---\n  showResult(won, score, stars, level) {\n    this.resultWon = won;\n    this.resultScore = score;\n    this.resultStars = stars;\n    this.resultLevel = level;\n    this.resultCoins = 0;\n    if (won && stars > 0) {\n      this.resultCoins = this.coinSystem.awardStars(stars);\n      this.dataManager.setLevelStars(level, stars);\n    }\n    this.goTo(NAV_SCREENS.RESULT);\n  }\n\n  _renderResult(ctx, w, h) {\n    // Dim background\n    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n    ctx.fillRect(0, 0, w, h);\n\n    const pw = Math.min(320, w - 40);\n    const ph = 330;\n    const px = (w - pw) / 2;\n    const py = (h - ph) / 2;\n\n    // Panel\n    ctx.fillStyle = '#FFF8E7';\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.fill();\n    ctx.strokeStyle = '#FFB800';\n    ctx.lineWidth = 3;\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.stroke();\n\n    ctx.textAlign = 'center';\n\n    // Title\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 24px sans-serif';\n    ctx.fillText(this.resultWon ? '🎉 恭喜过关！' : '😢 挑战失败', w / 2, py + 45);\n\n    // Level number\n    ctx.font = '14px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText(`第 ${this.resultLevel} 关`, w / 2, py + 68);\n\n    // Score\n    ctx.font = 'bold 36px sans-serif';\n    ctx.fillStyle = '#FFB800';\n    ctx.fillText(this.resultScore, w / 2, py + 110);\n    ctx.font = '14px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText('得分', w / 2, py + 130);\n\n    // Stars\n    if (this.resultWon) {\n      for (let i = 0; i < 3; i++) {\n        ctx.font = '30px sans-serif';\n        ctx.fillText(i < this.resultStars ? '⭐' : '☆', w / 2 - 40 + i * 40, py + 172);\n      }\n    }\n\n    // Coins earned\n    if (this.resultCoins > 0) {\n      ctx.fillStyle = '#FFB800';\n      ctx.font = 'bold 18px sans-serif';\n      ctx.fillText(`+${this.resultCoins} 🪙`, w / 2, py + 205);\n      ctx.fillStyle = '#8D6E63';\n      ctx.font = '12px sans-serif';\n      ctx.fillText(`余额: ${this.dataManager.coins} 🪙`, w / 2, py + 224);\n    }\n\n    // Buttons\n    const btnW = 120, btnH = 42;\n    const btnY = py + ph - 65;\n\n    if (this.resultWon) {\n      // Next level\n      ctx.fillStyle = '#6BCB77';\n      this._roundRect(ctx, w / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText('下一关', w / 2 - btnW / 2 - 10, btnY + 27);\n    } else {\n      // Retry\n      ctx.fillStyle = '#FF9A3C';\n      this._roundRect(ctx, w / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText('重试', w / 2 - btnW / 2 - 10, btnY + 27);\n    }\n\n    // Map button\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, w / 2 + 10, btnY, btnW, btnH, btnH / 2);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.fillText('🗺️ 地图', w / 2 + btnW / 2 + 10, btnY + 27);\n  }\n\n  _handleResultClick(x, y, w, h) {\n    const pw = Math.min(320, w - 40);\n    const ph = 330;\n    const px = (w - pw) / 2;\n    const py = (h - ph) / 2;\n    const btnW = 120, btnH = 42;\n    const btnY = py + ph - 65;\n\n    // Next / Retry button\n    if (x >= w / 2 - btnW - 10 && x <= w / 2 - 10 && y >= btnY && y <= btnY + btnH) {\n      if (this.resultWon) {\n        this.game.nextLevel();\n      } else {\n        this.game.retry();\n      }\n      this.characterMgr.applySkill(\n        this.dataManager.selectedCharacter,\n        this.game, 'level_start', null,\n      );\n      this.goTo(NAV_SCREENS.GAME);\n      return { action: this.resultWon ? 'next' : 'retry' };\n    }\n\n    // Map button\n    if (x >= w / 2 + 10 && x <= w / 2 + 10 + btnW && y >= btnY && y <= btnY + btnH) {\n      this.goTo(NAV_SCREENS.MAP);\n      return { action: 'map' };\n    }\n    return null;\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Navigation, NAV_SCREENS };\n","structuredPatch":[],"originalFile":null,"userModified":false}}
