{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_e0110941fd76436baf07adf4","type":"tool_result","content":"1\t// DailySystem.js — Daily login, tasks, and challenge\n2\t\n3\tclass DailySystem {\n4\t  constructor(data, engine, audio) {\n5\t    this.data = data;\n6\t    this.engine = engine;\n7\t    this.audio = audio;\n8\t    this.onUpdate = null;\n9\t    this._initDefaults();\n10\t  }\n11\t\n12\t  _initDefaults() {\n13\t    if (!this.data.data.daily) {\n14\t      this.data.data.daily = {\n15\t        lastLogin: null,\n16\t        loginStreak: 0,\n17\t        todayClaimed: false,\n18\t        tasks: [],\n19\t        challengeCompleted: false,\n20\t        challengeIdiom: null\n21\t      };\n22\t      this.data.save();\n23\t    }\n24\t    if (!this.data.data.daily.tasks || this.data.data.daily.tasks.length === 0) {\n25\t      this._generateDailyTasks();\n26\t    }\n27\t    this._checkDayReset();\n28\t  }\n29\t\n30\t  _getTodayStr() {\n31\t    const d = new Date();\n32\t    return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;\n33\t  }\n34\t\n35\t  _checkDayReset() {\n36\t    const today = this._getTodayStr();\n37\t    if (this.data.data.daily.lastLogin !== today) {\n38\t      const yesterday = new Date();\n39\t      yesterday.setDate(yesterday.getDate() - 1);\n40\t      const yStr = `${yesterday.getFullYear()}-${String(yesterday.getMonth()+1).padStart(2,'0')}-${String(yesterday.getDate()).padStart(2,'0')}`;\n41\t\n42\t      if (this.data.data.daily.lastLogin === yStr) {\n43\t        this.data.data.daily.loginStreak++;\n44\t      } else {\n45\t        this.data.data.daily.loginStreak = 1;\n46\t      }\n47\t\n48\t      this.data.data.daily.lastLogin = today;\n49\t      this.data.data.daily.todayClaimed = false;\n50\t      this.data.data.daily.challengeCompleted = false;\n51\t      this._generateDailyChallenge();\n52\t      this._generateDailyTasks();\n53\t      this.data.save();\n54\t    }\n55\t  }\n56\t\n57\t  _generateDailyChallenge() {\n58\t    const seed = this._getTodayStr();\n59\t    let hash = 0;\n60\t    for (let i = 0; i < seed.length; i++) {\n61\t      hash = ((hash << 5) - hash) + seed.charCodeAt(i);\n62\t      hash |= 0;\n63\t    }\n64\t    const pool = this.engine.getByDifficulty(2);\n65\t    if (pool.length === 0) return;\n66\t    const idx = Math.abs(hash) % pool.length;\n67\t    this.data.data.daily.challengeIdiom = pool[idx];\n68\t    this.data.save();\n69\t  }\n70\t\n71\t  _generateDailyTasks() {\n72\t    const taskTemplates = [\n73\t      { id: 'dt1', type: 'answer', desc: '答对5道题', target: 5, reward: 15 },\n74\t      { id: 'dt2', type: 'combo', desc: '达成3连击', target: 3, reward: 20 },\n75\t      { id: 'dt3', type: 'level', desc: '通过1关', target: 1, reward: 25 },\n76\t      { id: 'dt4', type: 'collect', desc: '收集3个新成语', target: 3, reward: 20 },\n77\t      { id: 'dt5', type: 'login', desc: '每日登录', target: 1, reward: 10 },\n78\t    ];\n79\t\n80\t    const shuffled = [...taskTemplates].sort(() => Math.random() - 0.5);\n81\t    const selected = shuffled.slice(0, 3);\n82\t\n83\t    this.data.data.daily.tasks = selected.map(t => ({\n84\t      ...t,\n85\t      progress: t.type === 'login' ? 1 : 0,\n86\t      claimed: t.type === 'login'\n87\t    }));\n88\t\n89\t    this.data.data.daily.loginStreak = this.data.data.daily.loginStreak || 1;\n90\t    this.data.save();\n91\t  }\n92\t\n93\t  claimLogin() {\n94\t    if (this.data.data.daily.todayClaimed) return 0;\n95\t    this.data.data.daily.todayClaimed = true;\n96\t    const streak = this.data.data.daily.loginStreak || 1;\n97\t    const bonus = Math.min(streak, 7) * 10;\n98\t    this.data.addCoins(bonus);\n99\t    if (this.onUpdate) this.onUpdate();\n100\t    return bonus;\n101\t  }\n102\t\n103\t  updateTaskProgress(type, amount = 1) {\n104\t    if (!this.data.data.daily || !this.data.data.daily.tasks) return;\n105\t    this.data.data.daily.tasks.forEach(t => {\n106\t      if (t.type === type && !t.claimed) {\n107\t        t.progress = Math.min(t.progress + amount, t.target);\n108\t      }\n109\t    });\n110\t    this.data.save();\n111\t  }\n112\t\n113\t  claimTask(taskId) {\n114\t    const task = this.data.data.daily.tasks.find(t => t.id === taskId);\n115\t    if (!task || task.claimed || task.progress < task.target) return 0;\n116\t    task.claimed = true;\n117\t    this.data.addCoins(task.reward);\n118\t    if (this.onUpdate) this.onUpdate();\n119\t    return task.reward;\n120\t  }\n121\t\n122\t  completeChallenge() {\n123\t    if (this.data.data.daily.challengeCompleted) return false;\n124\t    this.data.data.daily.challengeCompleted = true;\n125\t    this.data.addCoins(50);\n126\t    this.data.save();\n127\t    if (this.onUpdate) this.onUpdate();\n128\t    return true;\n129\t  }\n130\t\n131\t  getDailyState() {\n132\t    return {\n133\t      lastLogin: this.data.data.daily.lastLogin,\n134\t      loginStreak: this.data.data.daily.loginStreak || 1,\n135\t      todayClaimed: this.data.data.daily.todayClaimed,\n136\t      tasks: this.data.data.daily.tasks || [],\n137\t      challengeCompleted: this.data.data.daily.challengeCompleted,\n138\t      challengeIdiom: this.data.data.daily.challengeIdiom\n139\t    };\n140\t  }\n141\t}\n142\t\n143\tif (typeof module !== 'undefined') module.exports = { DailySystem };\n144\t"}]},"parent_tool_use_id":null,"session_id":"6be7998d-cc43-4adb-be9f-4939a8437d2d","uuid":"cb3a47bf-6ade-41d5-bc6c-447a32ea806b","timestamp":"2026-05-23T00:47:03.830Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/src/js/DailySystem.js","content":"// DailySystem.js — Daily login, tasks, and challenge\n\nclass DailySystem {\n  constructor(data, engine, audio) {\n    this.data = data;\n    this.engine = engine;\n    this.audio = audio;\n    this.onUpdate = null;\n    this._initDefaults();\n  }\n\n  _initDefaults() {\n    if (!this.data.data.daily) {\n      this.data.data.daily = {\n        lastLogin: null,\n        loginStreak: 0,\n        todayClaimed: false,\n        tasks: [],\n        challengeCompleted: false,\n        challengeIdiom: null\n      };\n      this.data.save();\n    }\n    if (!this.data.data.daily.tasks || this.data.data.daily.tasks.length === 0) {\n      this._generateDailyTasks();\n    }\n    this._checkDayReset();\n  }\n\n  _getTodayStr() {\n    const d = new Date();\n    return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;\n  }\n\n  _checkDayReset() {\n    const today = this._getTodayStr();\n    if (this.data.data.daily.lastLogin !== today) {\n      const yesterday = new Date();\n      yesterday.setDate(yesterday.getDate() - 1);\n      const yStr = `${yesterday.getFullYear()}-${String(yesterday.getMonth()+1).padStart(2,'0')}-${String(yesterday.getDate()).padStart(2,'0')}`;\n\n      if (this.data.data.daily.lastLogin === yStr) {\n        this.data.data.daily.loginStreak++;\n      } else {\n        this.data.data.daily.loginStreak = 1;\n      }\n\n      this.data.data.daily.lastLogin = today;\n      this.data.data.daily.todayClaimed = false;\n      this.data.data.daily.challengeCompleted = false;\n      this._generateDailyChallenge();\n      this._generateDailyTasks();\n      this.data.save();\n    }\n  }\n\n  _generateDailyChallenge() {\n    const seed = this._getTodayStr();\n    let hash = 0;\n    for (let i = 0; i < seed.length; i++) {\n      hash = ((hash << 5) - hash) + seed.charCodeAt(i);\n      hash |= 0;\n    }\n    const pool = this.engine.getByDifficulty(2);\n    if (pool.length === 0) return;\n    const idx = Math.abs(hash) % pool.length;\n    this.data.data.daily.challengeIdiom = pool[idx];\n    this.data.save();\n  }\n\n  _generateDailyTasks() {\n    const taskTemplates = [\n      { id: 'dt1', type: 'answer', desc: '答对5道题', target: 5, reward: 15 },\n      { id: 'dt2', type: 'combo', desc: '达成3连击', target: 3, reward: 20 },\n      { id: 'dt3', type: 'level', desc: '通过1关', target: 1, reward: 25 },\n      { id: 'dt4', type: 'collect', desc: '收集3个新成语', target: 3, reward: 20 },\n      { id: 'dt5', type: 'login', desc: '每日登录', target: 1, reward: 10 },\n    ];\n\n    const shuffled = [...taskTemplates].sort(() => Math.random() - 0.5);\n    const selected = shuffled.slice(0, 3);\n\n    this.data.data.daily.tasks = selected.map(t => ({\n      ...t,\n      progress: t.type === 'login' ? 1 : 0,\n      claimed: t.type === 'login'\n    }));\n\n    this.data.data.daily.loginStreak = this.data.data.daily.loginStreak || 1;\n    this.data.save();\n  }\n\n  claimLogin() {\n    if (this.data.data.daily.todayClaimed) return 0;\n    this.data.data.daily.todayClaimed = true;\n    const streak = this.data.data.daily.loginStreak || 1;\n    const bonus = Math.min(streak, 7) * 10;\n    this.data.addCoins(bonus);\n    if (this.onUpdate) this.onUpdate();\n    return bonus;\n  }\n\n  updateTaskProgress(type, amount = 1) {\n    if (!this.data.data.daily || !this.data.data.daily.tasks) return;\n    this.data.data.daily.tasks.forEach(t => {\n      if (t.type === type && !t.claimed) {\n        t.progress = Math.min(t.progress + amount, t.target);\n      }\n    });\n    this.data.save();\n  }\n\n  claimTask(taskId) {\n    const task = this.data.data.daily.tasks.find(t => t.id === taskId);\n    if (!task || task.claimed || task.progress < task.target) return 0;\n    task.claimed = true;\n    this.data.addCoins(task.reward);\n    if (this.onUpdate) this.onUpdate();\n    return task.reward;\n  }\n\n  completeChallenge() {\n    if (this.data.data.daily.challengeCompleted) return false;\n    this.data.data.daily.challengeCompleted = true;\n    this.data.addCoins(50);\n    this.data.save();\n    if (this.onUpdate) this.onUpdate();\n    return true;\n  }\n\n  getDailyState() {\n    return {\n      lastLogin: this.data.data.daily.lastLogin,\n      loginStreak: this.data.data.daily.loginStreak || 1,\n      todayClaimed: this.data.data.daily.todayClaimed,\n      tasks: this.data.data.daily.tasks || [],\n      challengeCompleted: this.data.data.daily.challengeCompleted,\n      challengeIdiom: this.data.data.daily.challengeIdiom\n    };\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { DailySystem };\n","numLines":144,"startLine":1,"totalLines":144}}}
