ue,\n      collectedIdioms: [],\n      totalScore: 0,\n      gamesPlayed: 0,\n      bestCombo: 0\n    };\n  }\n\n  _load() {\n    try {\n      const raw = localStorage.getItem(this.STORAGE_KEY);\n      if (raw) return { ...this._defaults(), ...JSON.parse(raw) };\n    } catch (e) { /* ignore */ }\n    return this._defaults();\n  }\n\n  save() {\n    try {\n      localStorage.setItem(this.STORAGE_KEY, JSON.stringify(this.data));\n    } catch (e) { /* ignore */ }\n  }\n\n  getLevelStars(id) { return this.data.levelStars[id] || 0; }\n\n  setLevelStars(id, stars) {\n    if (stars > (this.data.levelStars[id] || 0)) {\n      this.data.levelStars[id] = stars;\n    }\n    if (id >= this.data.unlockedLevel) {\n      this.data.unlockedLevel = id + 1;\n    }\n    this.save();\n  }\n\n  get unlockedLevel() { return this.data.unlockedLevel; }\n  get coins() { return this.data.coins; }\n\n  addCoins(n) { this.data.coins += n; this.save(); return this.data.coins; }\n  spendCoins(n) {\n    if (this.data.coins >= n) { this.data.coins -= n; this.save(); return true; }\n    return false;\n  }\n\n  collectIdiom(id) {\n    if (!this.data.collectedIdioms.includes(id)) {\n      this.data.collectedIdioms.push(id);\n      this.save();\n    }\n  }\n\n  get collectedCount() { return this.data.collectedIdioms.length; }\n\n  addScore(n) {\n    this.data.totalScore += n;\n    this.data.gamesPlayed++;\n    this.save();\n  }\n\n  updateBestCombo(n) {\n    if (n > this.data.bestCombo) {\n      this.data.bestCombo = n;\n      this.save();\n    }\n  }\n\n  reset() { this.data = this._defaults(); this.save(); }\n}\n\nif (typeof module !== 'undefined') module.exports = { DataManager };\n","userModified":false}}
{"type":"assistant","message":{"id":"msg_202605230820141ace504639c14200","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"text","text":"现在更新 Game.js 以集成所有 W2 系统。"}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"3263718e-ff98-4b11-b648-a6d67321903d","uuid":"fe2289cb-6793-40e8-ae61-d61b522ee433"}
{"type":"assistant","message":{"id":"msg_202605230820141ace504639c14200","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_489229a86ed44d86aa7876ae","name":"Write","input":{"file_path":"D:/game-projects/douyin-idiom/src/js/Game.js","content":"// Game.js — Main game controller (W2 extended)\n\nclass Game {\n  constructor() {\n    this.engine = new IdiomEngine(IDIOM_DB);\n    this.judge = new Judge();\n    this.combo = new ComboSystem();\n    this.data = new DataManager();\n    this.audio = new AudioManager();\n    this.tutorial = new Tutorial();\n\n    // W2 systems\n    this.timed = new TimedChallenge(this.engine, this.combo, this.audio, this.data);\n    this.collection = new IdiomCollection(IDIOM_DB, this.data);\n    this.daily = new DailySystem(this.data, this.engine, this.audio);\n    this.pk = new PKMode(this.engine, this.audio, this.data);\n    this.social = new SocialManager(this.data);\n    this.characters = new Characters(this.data);\n\n    this.currentLevel = null;\n    this.questions = [];\n    this.questionIndex = 0;\n    this.lives = 5;\n    this.state = 'menu';\n    this.usedHintThisQuestion = false;\n    this.continuedOnce = false;\n    this.levelResult = null;\n    this.hintRevealCost = 5;\n    this.hintRemoveCost = 5;\n    this.skipCost = 10;\n  }\n\n  startLevel(levelId) {\n    const level = LEVELS.find(l => l.id === levelId);\n    if (!level) { this.goToMenu(); return; }\n    if (levelId > this.data.unlockedLevel && levelId > 1) {\n      alert('关卡尚未解锁'); return;\n    }\n\n    this.currentLevel = level;\n    this.lives = level.lives;\n    this.engine.reset();\n    this.questions = this.engine.generateForLevel(level);\n    this.questionIndex = 0;\n    this.combo.reset();\n    this.continuedOnce = false;\n    this.state = 'playing';\n    this.characters.resetLevelState();\n\n    if (level.tutorial) this.tutorial.start(level.tutorial);\n    else this.tutorial.end();\n\n    this._startQuestion();\n    this.render();\n  }\n\n  _startQuestion() {\n    if (this.questionIndex >= this.questions.length) { this.finishLevel(); return; }\n    const q = this.questions[this.questionIndex];\n    this.judge.startQuestion(q);\n    this.usedHintThisQuestion = false;\n  }\n\n  pickChar(candidateIndex) {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const result = this.judge.placeChar(candidateIndex);\n    if (result.action === 'placed') {\n      this.audio.playPlace();\n      if (result.fillCount === 4) {\n        setTimeout(() => this._handleFull(result), 400);\n      }\n    } else if (result.action === 'full') {\n      setTimeout(() => this._handleFull(result), 200);\n    } else if (result.action === 'used') {\n      return null;\n    }\n    this.render();\n    return result;\n  }\n\n  _handleFull(result) {\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return;\n    q.answered = true;\n    q.correct = result.isCorrect;\n\n    if (result.isCorrect) {\n      this.audio.playCorrect();\n      const cr = this.combo.onCorrect(this.usedHintThisQuestion);\n\n      // Character skill: combo boost\n      const skillResult = this.characters.applySkill({ event: 'combo_bonus' });\n      if (skillResult.triggered && skillResult.multiplier) {\n        const bonus = Math.floor(cr.comboBonus * (skillResult.multiplier - 1));\n        cr.comboBonus += bonus;\n        this.combo.score += bonus;\n        cr.totalGain += bonus;\n      }\n\n      // Character skill: bonus exp\n      const expResult = this.characters.applySkill({ event: 'correct' });\n      if (expResult.triggered && expResult.bonus) {\n        this.data.addExp(expResult.bonus);\n      }\n\n      if (cr.combo >= 3) this.audio.playCombo(cr.combo);\n      this.data.collectIdiom(q.idiom.id);\n      this.daily.updateTaskProgress('answer', 1);\n      this.daily.updateTaskProgress('combo', cr.combo >= 3 ? 1 : 0);\n      q.comboResult = cr;\n      this.render();\n      setTimeout(() => { this.questionIndex++; this._startQuestion(); this.render(); }, 800);\n    } else {\n      // Character skill: lucky save\n      const skillResult = this.characters.applySkill({ event: 'wrong' });\n      if (skillResult.triggered) {\n        this.audio.playHint();\n        this.render();\n        setTimeout(() => {\n          q.answered = false; q.correct = null;\n          this.judge.startQuestion(q);\n          this.render();\n        }, 800);\n        return;\n      }\n\n      this.audio.playWrong();\n      this.combo.onWrong();\n      this.lives--;\n      this.render();\n      if (this.lives <= 0) {\n        if (!this.continuedOnce) {\n          document.getElementById('continue-modal').style.display = 'flex';\n        } else {\n          setTimeout(() => this.finishLevel(), 600);\n        }\n      } else {\n        setTimeout(() => {\n          q.answered = false; q.correct = null;\n          this.judge.startQuestion(q);\n          this.render();\n        }, 600);\n      }\n    }\n  }\n\n  removeSlot(slotIndex) {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const result = this.judge.removeSlot(slotIndex);\n    if (result.action === 'removed') this.audio.playPlace();\n    this.render();\n    return result;\n  }\n\n  useHintReveal() {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const fc = this.judge.getFillCount();\n    if (fc >= 4) return null;\n\n    // Character skill: free hint\n    const skillResult = this.characters.applySkill({ event: 'hint' });\n    if (!skillResult.triggered) {\n      if (this.data.coins < this.hintRevealCost) {\n        alert('金币不足');\n        return null;\n      }\n      this.data.spendCoins(this.hintRevealCost);\n    }\n\n    const ch = this.judge.currentIdiom.chars[fc];\n    const cand = q.candidates.find(c => c.char === ch && !c.used);\n    if (!cand) return null;\n    this.usedHintThisQuestion = true;\n    this.audio.playHint();\n    const result = this.judge.placeChar(cand.index);\n    if (result.fillCount === 4) setTimeout(() => this._handleFull(result), 400);\n    this.render();\n    return result;\n  }\n\n  useHintRemove() {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n\n    if (this.data.coins < this.hintRemoveCost) {\n      alert('金币不足');\n      return null;\n    }\n    this.data.spendCoins(this.hintRemoveCost);\n\n    const wrong = q.candidates.filter(c => !c.used && !this.judge.currentIdiom.chars.includes(c.char) && !c.removed);\n    const removed = [];\n    const cnt = Math.min(2, wrong.length);\n    for (let i = 0; i < cnt; i++) {\n      const idx = Math.floor(Math.random() * wrong.length);\n      wrong[idx].removed = true;\n      removed.push(wrong[idx]);\n      wrong.splice(idx, 1);\n    }\n    this.audio.playRemove();\n    this.render();\n    return { action: 'removed_distractors', removed };\n  }\n\n  skipQuestion() {\n    if (this.state !== 'playing') return;\n    if (this.data.coins < this.skipCost) {\n      alert('金币不足');\n      return;\n    }\n    this.data.spendCoins(this.skipCost);\n    const q = this.questions[this.questionIndex];\n    if (q) { q.answered = true; q.correct = false; q.skipped = true; }\n    this.combo.onSkip();\n    this.questionIndex++;\n    this._startQuestion();\n    this.render();\n  }\n\n  continueWithAd() {\n    if (this.continuedOnce) return false;\n    this.lives = 3;\n    this.continuedOnce = true;\n    const q = this.questions[this.questionIndex];\n    if (q) { q.answered = false; q.correct = null; this.judge.startQuestion(q); }\n    this.render();\n    return true;\n  }\n\n  finishLevel() {\n    this.state = 'result';\n    document.getElementById('continue-modal').style.display = 'none';\n    const s = this.combo.getStats();\n    const stars = this.combo.getStarRating(s.correctCount, this.questions.length);\n\n    if (stars > 0 && this.currentLevel) {\n      this.data.setLevelStars(this.currentLevel.id, stars);\n      this.data.addCoins(this.currentLevel.reward.coins);\n      this.data.addScore(s.score);\n      this.data.updateBestCombo(s.maxCombo);\n      this.data.addExp(this.currentLevel.reward.exp || 10);\n      this.daily.updateTaskProgress('level', 1);\n      this.daily.updateTaskProgress('collect', s.correctCount);\n    }\n\n    this.levelResult = {\n      stars, correctCount: s.correctCount, totalQuestions: this.questions.length,\n      score: s.score, maxCombo: s.maxCombo,\n      coins: stars > 0 ? this.currentLevel.reward.coins : 0\n    };\n    if (stars > 0) this.audio.playLevelWin(); else this.audio.playLevelFail();\n    this.render();\n  }\n\n  // ===== W2: Timed Challenge =====\n  startTimedChallenge() {\n    this.state = 'timed';\n    this.timed.onUpdate = (evt) => {\n      if (evt === 'end') {\n        this.state = 'timed_result';\n      }\n      this.render();\n    };\n    this.timed.start();\n  }\n\n  // ===== W2: PK Mode =====\n  startPK(opponentResult) {\n    this.state = 'pk';\n    this.pk.onUpdate = (evt) => {\n      if (evt === 'end') {\n        this.state = 'pk_result';\n      }\n      this.render();\n    };\n    this.pk.start(opponentResult);\n  }\n\n  // ===== W2: Collection =====\n  showCollection() {\n    this.state = 'collection';\n    this.render();\n  }\n\n  // ===== W2: Daily =====\n  showDaily() {\n    this.state = 'daily';\n    this.render();\n  }\n\n  // ===== W2: Characters =====\n  showCharacters() {\n    this.state = 'characters';\n    this.render();\n  }\n\n  showLevelMap() {\n    this.state = 'map';\n    this.render();\n  }\n\n  goToMenu() {\n    this.state = 'menu';\n    this.tutorial.end();\n    this.render();\n  }\n\n  getCurrentQuestion() { return this.questions[this.questionIndex]; }\n\n  render() { if (typeof renderUI === 'function') renderUI(this); }\n}\n\nfunction handleHintReveal() { game.useHintReveal(); }\nfunction handleHintRemove() { game.useHintRemove(); }\nfunction handleSkip() { game.skipQuestion(); }\n\nif (typeof module !== 'undefined') module.exports = { Game };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"3263718e-ff98-4b11-b648-a6d67321903d","uuid":"abc2ff04-57c1-4b70-9250-0b85654cd2d3"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_489229a86ed44d86aa7876ae","type":"tool_result","content":"The file D:/game-projects/douyin-idiom/src/js/Game.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"3263718e-ff98-4b11-b648-a6d67321903d","uuid":"042eacb3-519d-4340-b625-8b772161b6e6","timestamp":"2026-05-23T00:20:48.690Z","tool_use_result":{"type":"update","filePath":"D:/game-projects/douyin-idiom/src/js/Game.js","content":"// Game.js — Main game controller (W2 extended)\n\nclass Game {\n  constructor() {\n    this.engine = new IdiomEngine(IDIOM_DB);\n    this.judge = new Judge();\n    this.combo = new ComboSystem();\n    this.data = new DataManager();\n    this.audio = new AudioManager();\n    this.tutorial = new Tutorial();\n\n    // W2 systems\n    this.timed = new TimedChallenge(this.engine, this.combo, this.audio, this.data);\n    this.collection = new IdiomCollection(IDIOM_DB, this.data);\n    this.daily = new DailySystem(this.data, this.engine, this.audio);\n    this.pk = new PKMode(this.engine, this.audio, this.data);\n    this.social = new SocialManager(this.data);\n    this.characters = new Characters(this.data);\n\n    this.currentLevel = null;\n    this.questions = [];\n    this.questionIndex = 0;\n    this.lives = 5;\n    this.state = 'menu';\n    this.usedHintThisQuestion = false;\n    this.continuedOnce = false;\n    this.levelResult = null;\n    this.hintRevealCost = 5;\n    this.hintRemoveCost = 5;\n    this.skipCost = 10;\n  }\n\n  startLevel(levelId) {\n    const level = LEVELS.find(l => l.id === levelId);\n    if (!level) { this.goToMenu(); return; }\n    if (levelId > this.data.unlockedLevel && levelId > 1) {\n      alert('关卡尚未解锁'); return;\n    }\n\n    this.currentLevel = level;\n    this.lives = level.lives;\n    this.engine.reset();\n    this.questions = this.engine.generateForLevel(level);\n    this.questionIndex = 0;\n    this.combo.reset();\n    this.continuedOnce = false;\n    this.state = 'playing';\n    this.characters.resetLevelState();\n\n    if (level.tutorial) this.tutorial.start(level.tutorial);\n    else this.tutorial.end();\n\n    this._startQuestion();\n    this.render();\n  }\n\n  _startQuestion() {\n    if (this.questionIndex >= this.questions.length) { this.finishLevel(); return; }\n    const q = this.questions[this.questionIndex];\n    this.judge.startQuestion(q);\n    this.usedHintThisQuestion = false;\n  }\n\n  pickChar(candidateIndex) {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const result = this.judge.placeChar(candidateIndex);\n    if (result.action === 'placed') {\n      this.audio.playPlace();\n      if (result.fillCount === 4) {\n        setTimeout(() => this._handleFull(result), 400);\n      }\n    } else if (result.action === 'full') {\n      setTimeout(() => this._handleFull(result), 200);\n    } else if (result.action === 'used') {\n      return null;\n    }\n    this.render();\n    return result;\n  }\n\n  _handleFull(result) {\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return;\n    q.answered = true;\n    q.correct = result.isCorrect;\n\n    if (result.isCorrect) {\n      this.audio.playCorrect();\n      const cr = this.combo.onCorrect(this.usedHintThisQuestion);\n\n      // Character skill: combo boost\n      const skillResult = this.characters.applySkill({ event: 'combo_bonus' });\n      if (skillResult.triggered && skillResult.multiplier) {\n        const bonus = Math.floor(cr.comboBonus * (skillResult.multiplier - 1));\n        cr.comboBonus += bonus;\n        this.combo.score += bonus;\n        cr.totalGain += bonus;\n      }\n\n      // Character skill: bonus exp\n      const expResult = this.characters.applySkill({ event: 'correct' });\n      if (expResult.triggered && expResult.bonus) {\n        this.data.addExp(expResult.bonus);\n      }\n\n      if (cr.combo >= 3) this.audio.playCombo(cr.combo);\n      this.data.collectIdiom(q.idiom.id);\n      this.daily.updateTaskProgress('answer', 1);\n      this.daily.updateTaskProgress('combo', cr.combo >= 3 ? 1 : 0);\n      q.comboResult = cr;\n      this.render();\n      setTimeout(() => { this.questionIndex++; this._startQuestion(); this.render(); }, 800);\n    } else {\n      // Character skill: lucky save\n      const skillResult = this.characters.applySkill({ event: 'wrong' });\n      if (skillResult.triggered) {\n        this.audio.playHint();\n        this.render();\n        setTimeout(() => {\n          q.answered = false; q.correct = null;\n          this.judge.startQuestion(q);\n          this.render();\n        }, 800);\n        return;\n      }\n\n      this.audio.playWrong();\n      this.combo.onWrong();\n      this.lives--;\n      this.render();\n      if (this.lives <= 0) {\n        if (!this.continuedOnce) {\n          document.getElementById('continue-modal').style.display = 'flex';\n        } else {\n          setTimeout(() => this.finishLevel(), 600);\n        }\n      } else {\n        setTimeout(() => {\n          q.answered = false; q.correct = null;\n          this.judge.startQuestion(q);\n          this.render();\n        }, 600);\n      }\n    }\n  }\n\n  removeSlot(slotIndex) {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const result = this.judge.removeSlot(slotIndex);\n    if (result.action === 'removed') this.audio.playPlace();\n    this.render();\n    return result;\n  }\n\n  useHintReveal() {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const fc = this.judge.getFillCount();\n    if (fc >= 4) return null;\n\n    // Character skill: free hint\n    const skillResult = this.characters.applySkill({ event: 'hint' });\n    if (!skillResult.triggered) {\n      if (this.data.coins < this.hintRevealCost) {\n        alert('金币不足');\n        return null;\n      }\n      this.data.spendCoins(this.hintRevealCost);\n    }\n\n    const ch = this.judge.currentIdiom.chars[fc];\n    const cand = q.candidates.find(c => c.char === ch && !c.used);\n    if (!cand) return null;\n    this.usedHintThisQuestion = true;\n    this.audio.playHint();\n    const result = this.judge.placeChar(cand.index);\n    if (result.fillCount === 4) setTimeout(() => this._handleFull(result), 400);\n    this.render();\n    return result;\n  }\n\n  useHintRemove() {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n\n    if (this.data.coins < this.hintRemoveCost) {\n      alert('金币不足');\n      return null;\n    }\n    this.data.spendCoins(this.hintRemoveCost);\n\n    const wrong = q.candidates.filter(c => !c.used && !this.judge.currentIdiom.chars.includes(c.char) && !c.removed);\n    const removed = [];\n    const cnt = Math.min(2, wrong.length);\n    for (let i = 0; i < cnt; i++) {\n      const idx = Math.floor(Math.random() * wrong.length);\n      wrong[idx].removed = true;\n      removed.push(wrong[idx]);\n      wrong.splice(idx, 1);\n    }\n    this.audio.playRemove();\n    this.render();\n    return { action: 'removed_distractors', removed };\n  }\n\n  skipQuestion() {\n    if (this.state !== 'playing') return;\n    if (this.data.coins < this.skipCost) {\n      alert('金币不足');\n      return;\n    }\n    this.data.spendCoins(this.skipCost);\n    const q = this.questions[this.questionIndex];\n    if (q) { q.answered = true; q.correct = false; q.skipped = true; }\n    this.combo.onSkip();\n    this.questionIndex++;\n    this._startQuestion();\n    this.render();\n  }\n\n  continueWithAd() {\n    if (this.continuedOnce) return false;\n    this.lives = 3;\n    this.continuedOnce = true;\n    const q = this.questions[this.questionIndex];\n    if (q) { q.answered = false; q.correct = null; this.judge.startQuestion(q); }\n    this.render();\n    return true;\n  }\n\n  finishLevel() {\n    this.state = 'result';\n    document.getElementById('continue-modal').style.display = 'none';\n    const s = this.combo.getStats();\n    const stars = this.combo.getStarRating(s.correctCount, this.questions.length);\n\n    if (stars > 0 && this.currentLevel) {\n      this.data.setLevelStars(this.currentLevel.id, stars);\n      this.data.addCoins(this.currentLevel.reward.coins);\n      this.data.addScore(s.score);\n      this.data.updateBestCombo(s.maxCombo);\n      this.data.addExp(this.currentLevel.reward.exp || 10);\n      this.daily.updateTaskProgress('level', 1);\n      this.daily.updateTaskProgress('collect', s.correctCount);\n    }\n\n    this.levelResult = {\n      stars, correctCount: s.correctCount, totalQuestions: this.questions.length,\n      score: s.score, maxCombo: s.maxCombo,\n      coins: stars > 0 ? this.currentLevel.reward.coins : 0\n    };\n    if (stars > 0) this.audio.playLevelWin(); else this.audio.playLevelFail();\n    this.render();\n  }\n\n  // ===== W2: Timed Challenge =====\n  startTimedChallenge() {\n    this.state = 'timed';\n    this.timed.onUpdate = (evt) => {\n      if (evt === 'end') {\n        this.state = 'timed_result';\n      }\n      this.render();\n    };\n    this.timed.start();\n  }\n\n  // ===== W2: PK Mode =====\n  startPK(opponentResult) {\n    this.state = 'pk';\n    this.pk.onUpdate = (evt) => {\n      if (evt === 'end') {\n        this.state = 'pk_result';\n      }\n      this.render();\n    };\n    this.pk.start(opponentResult);\n  }\n\n  // ===== W2: Collection =====\n  showCollection() {\n    this.state = 'collection';\n    this.render();\n  }\n\n  // ===== W2: Daily =====\n  showDaily() {\n    this.state = 'daily';\n    this.render();\n  }\n\n  // ===== W2: Characters =====\n  showCharacters() {\n    this.state = 'characters';\n    this.render();\n  }\n\n  showLevelMap() {\n    this.state = 'map';\n    this.render();\n  }\n\n  goToMenu() {\n    this.state = 'menu';\n    this.tutorial.end();\n    this.render();\n  }\n\n  getCurrentQuestion() { return this.questions[this.questionIndex]; }\n\n  render() { if (typeof renderUI === 'function') renderUI(this); }\n}\n\nfunction handleHintReveal() { game.useHintReveal(); }\nfunction handleHintRemove() { game.useHintRemove(); }\nfunction handleSkip() { game.skipQuestion(); }\n\nif (typeof module !== 'undefined') module.exports = { Game };\n","structuredPatch":[{"oldStart":1,"oldLines":4,"newStart":1,"newLines":4,"lines":["-// Game.js — Main game controller","+// Game.js — Main game controller (W2 extended)"," "," class Game {","   constructor() {"]},{"oldStart":9,"oldLines":6,"newStart":9,"newLines":14,"lines":["     this.audio = new AudioManager();","     this.tutorial = new Tutorial();"," ","+    // W2 systems","+    this.timed = new TimedChallenge(this.engine, this.combo, this.audio, this.data);","+    this.collection = new IdiomCollection(IDIOM_DB, this.data);","+    this.daily = new DailySystem(this.data, this.engine, this.audio);","+    this.pk = new PKMode(this.engine, this.audio, this.data);","+    this.social = new SocialManager(this.data);","+    this.characters = new Characters(this.data);","+","     this.currentLevel = null;","     this.questions = [];","     this.questionIndex = 0;"]},{"oldStart":17,"oldLines":6,"newStart":25,"newLines":9,"lines":["     this.usedHintThisQuestion = false;","     this.continuedOnce = false;","     this.levelResult = null;","+    this.hintRevealCost = 5;","+    this.hintRemoveCost = 5;","+    this.skipCost = 10;","   }"," ","   startLevel(levelId) {"]},{"oldStart":34,"oldLines":6,"newStart":45,"newLines":7,"lines":["     this.combo.reset();","     this.continuedOnce = false;","     this.state = 'playing';","+    this.characters.resetLevelState();"," ","     if (level.tutorial) this.tutorial.start(level.tutorial);","     else thi