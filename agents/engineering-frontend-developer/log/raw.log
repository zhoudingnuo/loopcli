  this.purchasedUpgrades.add(upgradeId);\n62\t    return { success: true, message: `已购买: ${upgrade.name}` };\n63\t  }\n64\t\n65\t  hasUpgrade(upgradeId: string): boolean {\n66\t    return this.purchasedUpgrades.has(upgradeId);\n67\t  }\n68\t\n69\t  addRevenue(amount: number): void {\n70\t    this.dailyRevenue += amount;\n71\t    this.money += amount;\n72\t  }\n73\t\n74\t  addExpense(amount: number): void {\n75\t    this.dailyExpenses += amount;\n76\t    this.money -= amount;\n77\t  }\n78\t\n79\t  addPurchaseCost(amount: number): void {\n80\t    this.dailyPurchaseCost += amount;\n81\t    this.money -= amount;\n82\t  }\n83\t\n84\t  endDay(): DayReport {\n85\t    const rent = DAILY_RENT;\n86\t    const electricity = DAILY_ELECTRICITY;\n87\t    const totalExpenses = this.dailyExpenses + rent + electricity + this.dailyPurchaseCost;\n88\t    const netIncome = this.dailyRevenue - totalExpenses;\n89\t    const debtPayment = Math.min(this.debtDailyPayment, this.debt);\n90\t    this.debt -= debtPayment;\n91\t    this.money -= rent + electricity;\n92\t\n93\t    const report: DayReport = {\n94\t      day: this.dayNumber,\n95\t      revenue: Math.round(this.dailyRevenue * 100) / 100,\n96\t      expenses: Math.round(totalExpenses * 100) / 100,\n97\t      rent,\n98\t      electricity,\n99\t      purchaseCost: Math.round(this.dailyPurchaseCost * 100) / 100,\n100\t      netIncome: Math.round(netIncome * 100) / 100,\n101\t      debtPayment,\n102\t      debtRemaining: this.debt,\n103\t    };\n104\t\n105\t    this.dayReports.push(report);\n106\t    this.resetDaily();\n107\t    this.dayNumber++;\n108\t    return report;\n109\t  }\n110\t\n111\t  resetDaily(): void {\n112\t    this.dailyRevenue = 0;\n113\t    this.dailyExpenses = 0;\n114\t    this.dailyPurchaseCost = 0;\n115\t  }\n116\t\n117\t  isGameOver(): { over: boolean; reason: string } {\n118\t    if (this.debt <= 0) return { over: true, reason: 'debt_cleared' };\n119\t    if (this.money < -1000) return { over: true, reason: 'bankrupt' };\n120\t    if (this.dayNumber > DEBT_DAYS) return { over: true, reason: 'time_up' };\n121\t    return { over: false, reason: '' };\n122\t  }\n123\t\n124\t  getMoney(): number {\n125\t    return Math.round(this.money * 100) / 100;\n126\t  }\n127\t\n128\t  getSaveData(): Record<string, unknown> {\n129\t    return {\n130\t      money: this.money,\n131\t      debt: this.debt,\n132\t      purchasedUpgrades: Array.from(this.purchasedUpgrades),\n133\t      dayNumber: this.dayNumber,\n134\t      dailyRevenue: this.dailyRevenue,\n135\t      dailyExpenses: this.dailyExpenses,\n136\t      dayReports: this.dayReports.slice(-30),\n137\t    };\n138\t  }\n139\t\n140\t  loadSaveData(data: Record<string, unknown>): void {\n141\t    this.money = (data.money as number) ?? 500;\n142\t    this.debt = (data.debt as number) ?? DEBT_TOTAL;\n143\t    this.purchasedUpgrades = new Set((data.purchasedUpgrades as string[]) ?? []);\n144\t    this.dayNumber = (data.dayNumber as number) ?? 1;\n145\t    this.dailyRevenue = (data.dailyRevenue as number) ?? 0;\n146\t    this.dailyExpenses = (data.dailyExpenses as number) ?? 0;\n147\t    if (data.dayReports) this.dayReports = data.dayReports as DayReport[];\n148\t  }\n149\t}\n150\t"}]},"parent_tool_use_id":null,"session_id":"e8f5bde0-4da8-4c4a-9322-50945e66ead7","uuid":"05b70c90-a217-40b6-b6b2-a36826b1f0dc","timestamp":"2026-05-23T04:37:12.125Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-horror-sim\\src\\game\\EconomySystem.ts","content":"// EconomySystem.ts — Daily income/expenses, debt, and upgrades (M2)\n\nimport upgradesData from '../data/upgrades.json';\n\nexport interface UpgradeDef {\n  id: string;\n  name: string;\n  description: string;\n  cost: number;\n  effect: string;\n  value?: number;\n  horrorLink: string;\n}\n\nexport interface DayReport {\n  day: number;\n  revenue: number;\n  expenses: number;\n  rent: number;\n  electricity: number;\n  purchaseCost: number;\n  netIncome: number;\n  debtPayment: number;\n  debtRemaining: number;\n}\n\nconst ALL_UPGRADES: UpgradeDef[] = upgradesData.upgrades as UpgradeDef[];\n\nconst DAILY_RENT = 100;\nconst DAILY_ELECTRICITY = 20;\nconst DEBT_TOTAL = 300000;\nconst DEBT_DAYS = 30;\n\nexport class EconomySystem {\n  money: number = 500;\n  debt: number = DEBT_TOTAL;\n  debtDailyPayment: number = Math.ceil(DEBT_TOTAL / DEBT_DAYS);\n\n  purchasedUpgrades: Set<string> = new Set();\n  dailyRevenue = 0;\n  dailyExpenses = 0;\n  dailyPurchaseCost = 0;\n  dayReports: DayReport[] = [];\n  dayNumber = 1;\n\n  getUpgrades(): UpgradeDef[] {\n    return ALL_UPGRADES;\n  }\n\n  getAvailableUpgrades(): UpgradeDef[] {\n    return ALL_UPGRADES.filter(u => !this.purchasedUpgrades.has(u.id));\n  }\n\n  purchaseUpgrade(upgradeId: string): { success: boolean; message: string } {\n    const upgrade = ALL_UPGRADES.find(u => u.id === upgradeId);\n    if (!upgrade) return { success: false, message: '升级不存在' };\n    if (this.purchasedUpgrades.has(upgradeId)) return { success: false, message: '已购买' };\n    if (this.money < upgrade.cost) return { success: false, message: '余额不足' };\n\n    this.money -= upgrade.cost;\n    this.purchasedUpgrades.add(upgradeId);\n    return { success: true, message: `已购买: ${upgrade.name}` };\n  }\n\n  hasUpgrade(upgradeId: string): boolean {\n    return this.purchasedUpgrades.has(upgradeId);\n  }\n\n  addRevenue(amount: number): void {\n    this.dailyRevenue += amount;\n    this.money += amount;\n  }\n\n  addExpense(amount: number): void {\n    this.dailyExpenses += amount;\n    this.money -= amount;\n  }\n\n  addPurchaseCost(amount: number): void {\n    this.dailyPurchaseCost += amount;\n    this.money -= amount;\n  }\n\n  endDay(): DayReport {\n    const rent = DAILY_RENT;\n    const electricity = DAILY_ELECTRICITY;\n    const totalExpenses = this.dailyExpenses + rent + electricity + this.dailyPurchaseCost;\n    const netIncome = this.dailyRevenue - totalExpenses;\n    const debtPayment = Math.min(this.debtDailyPayment, this.debt);\n    this.debt -= debtPayment;\n    this.money -= rent + electricity;\n\n    const report: DayReport = {\n      day: this.dayNumber,\n      revenue: Math.round(this.dailyRevenue * 100) / 100,\n      expenses: Math.round(totalExpenses * 100) / 100,\n      rent,\n      electricity,\n      purchaseCost: Math.round(this.dailyPurchaseCost * 100) / 100,\n      netIncome: Math.round(netIncome * 100) / 100,\n      debtPayment,\n      debtRemaining: this.debt,\n    };\n\n    this.dayReports.push(report);\n    this.resetDaily();\n    this.dayNumber++;\n    return report;\n  }\n\n  resetDaily(): void {\n    this.dailyRevenue = 0;\n    this.dailyExpenses = 0;\n    this.dailyPurchaseCost = 0;\n  }\n\n  isGameOver(): { over: boolean; reason: string } {\n    if (this.debt <= 0) return { over: true, reason: 'debt_cleared' };\n    if (this.money < -1000) return { over: true, reason: 'bankrupt' };\n    if (this.dayNumber > DEBT_DAYS) return { over: true, reason: 'time_up' };\n    return { over: false, reason: '' };\n  }\n\n  getMoney(): number {\n    return Math.round(this.money * 100) / 100;\n  }\n\n  getSaveData(): Record<string, unknown> {\n    return {\n      money: this.money,\n      debt: this.debt,\n      purchasedUpgrades: Array.from(this.purchasedUpgrades),\n      dayNumber: this.dayNumber,\n      dailyRevenue: this.dailyRevenue,\n      dailyExpenses: this.dailyExpenses,\n      dayReports: this.dayReports.slice(-30),\n    };\n  }\n\n  loadSaveData(data: Record<string, unknown>): void {\n    this.money = (data.money as number) ?? 500;\n    this.debt = (data.debt as number) ?? DEBT_TOTAL;\n    this.purchasedUpgrades = new Set((data.purchasedUpgrades as string[]) ?? []);\n    this.dayNumber = (data.dayNumber as number) ?? 1;\n    this.dailyRevenue = (data.dailyRevenue as number) ?? 0;\n    this.dailyExpenses = (data.dailyExpenses as number) ?? 0;\n    if (data.dayReports) this.dayReports = data.dayReports as DayReport[];\n  }\n}\n","numLines":150,"startLine":1,"totalLines":150}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_c8e0a1c88cb34ad5856a5cfd","type":"tool_result","content":"1\t// Renderer.ts — Canvas 2D rendering system (v0.2.0 — M2)\n2\t\n3\timport { Camera } from './Camera';\n4\timport { StoreMap, T } from '../game/StoreMap';\n5\timport { Player } from '../game/Player';\n6\timport { Lighting } from './Lighting';\n7\timport {\n8\t  type GameState,\n9\t  type GamePhase,\n10\t  type LightSource,\n11\t  type Interactable,\n12\t  GamePhase as GP,\n13\t  UIPanel,\n14\t  getTimeString,\n15\t  isNightTime,\n16\t} from '../game/GameState';\n17\timport { Customer } from '../game/Customer';\n18\timport { ProductManager } from '../game/ProductManager';\n19\timport { ShelfInteraction, ShelfAction } from '../game/ShelfInteraction';\n20\timport { CashRegister, RegisterState } from '../game/CashRegister';\n21\timport { EconomySystem } from '../game/EconomySystem';\n22\timport { PricingSystem } from '../game/PricingSystem';\n23\t\n24\texport interface RenderContext {\n25\t  customers: Customer[];\n26\t  productManager: ProductManager;\n27\t  shelfInteraction: ShelfInteraction;\n28\t  registers: CashRegister[];\n29\t  economy: EconomySystem;\n30\t  pricing: PricingSystem;\n31\t  lastTransaction: string;\n32\t}\n33\t\n34\texport class Renderer {\n35\t  canvas: HTMLCanvasElement;\n36\t  ctx: CanvasRenderingContext2D;\n37\t  camera: Camera;\n38\t  lighting: Lighting;\n39\t\n40\t  constructor(canvas: HTMLCanvasElement) {\n41\t    this.canvas = canvas;\n42\t    this.ctx = canvas.getContext('2d')!;\n43\t    this.camera = new Camera(canvas);\n44\t    this.lighting = new Lighting();\n45\t    this.resize();\n46\t    this.camera.setupZoom(canvas);\n47\t  }\n48\t\n49\t  resize(): void {\n50\t    const dpr = window.devicePixelRatio || 1;\n51\t    const rect = this.canvas.getBoundingClientRect();\n52\t    this.canvas.width = rect.width * dpr;\n53\t    this.canvas.height = rect.height * dpr;\n54\t    this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n55\t  }\n56\t\n57\t  render(\n58\t    map: StoreMap,\n59\t    player: Player,\n60\t    state: GameState,\n61\t    now: number,\n62\t    ctx?: RenderContext,\n63\t  ): void {\n64\t    const c = this.ctx;\n65\t    const w = this.canvas.getBoundingClientRect().width;\n66\t    const h = this.canvas.getBoundingClientRect().height;\n67\t\n68\t    const bgPhase = state.phase;\n69\t    if (bgPhase === 'danger') {\n70\t      c.fillStyle = '#0a0a15';\n71\t    } else if (isNightTime(bgPhase)) {\n72\t      c.fillStyle = '#0f1020';\n73\t    } else {\n74\t      c.fillStyle = '#1a1520';\n75\t    }\n76\t    c.fillRect(0, 0, w, h);\n77\t\n78\t    const { offsetX, offsetY, scale } = this.camera.getTransform();\n79\t\n80\t    // Render map tiles\n81\t    map.render(c, offsetX, offsetY, w, h, scale);\n82\t\n83\t    // Render shelf product indicators\n84\t    if (ctx) {\n85\t      this.renderShelfIndicators(c, ctx.productManager, state.interactables, offsetX, offsetY, scale);\n86\t    }\n87\t\n88\t    // Render interactable highlights\n89\t    this.renderInteractables(c, state.interactables, offsetX, offsetY, scale, player, now);\n90\t\n91\t    // Render customers\n92\t    if (ctx) {\n93\t      for (const customer of ctx.customers) {\n94\t        customer.render(c, offsetX, offsetY, scale);\n95\t      }\n96\t    }\n97\t\n98\t    // Render player\n99\t    player.render(c, offsetX, offsetY, scale);\n100\t\n101\t    // Render lighting overlay\n102\t    this.lighting.render(c, w, h, state.lights, state.phase, offsetX, offsetY, scale, now);\n103\t\n104\t    // Render HUD\n105\t    this.renderHUD(c, w, h, state, player, ctx);\n106\t\n107\t    // Render active panel\n108\t    if (ctx && state.activePanel !== UIPanel.NONE) {\n109\t      this.renderPanel(c, w, h, state, ctx);\n110\t    }\n111\t  }\n112\t\n113\t  private renderShelfIndicators(\n114\t    c: CanvasRenderingContext2D,\n115\t    pm: ProductManager,\n116\t    interactables: Interactable[],\n117\t    ox: number,\n118\t    oy: number,\n119\t    scale: number,\n120\t  ): void {\n121\t    for (const inter of interactables) {\n122\t      if (inter.type !== 'shelf' && inter.type !== 'fridge') continue;\n123\t      const slot = pm.shelfSlots.get(inter.id);\n124\t      if (!slot || !slot.productId || slot.quantity <= 0) continue;\n125\t\n126\t      const product = pm.getProduct(slot.productId);\n127\t      if (!product) continue;\n128\t\n129\t      const px = ox + inter.x * scale;\n130\t      const py = oy + (inter.y - 8) * scale;\n131\t      const pw = inter.width * scale;\n132\t\n133\t      // Stock level bar\n134\t      const ratio = slot.quantity / slot.maxQuantity;\n135\t      const barColor = ratio > 0.5 ? '#66aa66' : ratio > 0.2 ? '#aaaa44' : '#aa4444';\n136\t      c.fillStyle = 'rgba(0,0,0,0.5)';\n137\t      c.fillRect(px, py, pw, 6 * scale);\n138\t      c.fillStyle = barColor;\n139\t      c.fillRect(px, py, pw * ratio, 6 * scale);\n140\t\n141\t      // Product name\n142\t      c.fillStyle = 'rgba(255,255,255,0.7)';\n143\t      c.font = `${Math.round(8 * scale)}px monospace`;\n144\t      c.textAlign = 'center';\n145\t      c.textBaseline = 'top';\n146\t      c.fillText(`${product.name}(${slot.quantity})`, px + pw / 2, py + 7 * scale);\n147\t    }\n148\t  }\n149\t\n150\t  private renderInteractables(\n151\t    c: CanvasRenderingContext2D,\n152\t    interactables: Interactable[],\n153\t    ox: number,\n154\t    oy: number,\n155\t    scale: number,\n156\t    player: Player,\n157\t    now: number,\n158\t  ): void {\n159\t    const facing = player.getFacingTile();\n160\t\n161\t    for (const obj of interactables) {\n162\t      const px = ox + obj.x * scale;\n163\t      const py = oy + obj.y * scale;\n164\t      const pw = obj.width * scale;\n165\t      const ph = obj.height * scale;\n166\t\n167\t      const objGX = Math.floor(obj.x / 32);\n168\t      const objGY = Math.floor(obj.y / 32);\n169\t      const isFacing = facing.gx >= objGX && facing.gx <= objGX + Math.ceil(obj.width / 32) - 1 &&\n170\t        facing.gy >= objGY && facing.gy <= objGY + Math.ceil(obj.height / 32) - 1;\n171\t\n172\t      if (isFacing) {\n173\t        const pulse = 0.3 + Math.sin(now * 0.005) * 0.1;\n174\t        c.strokeStyle = `rgba(255, 255, 100, ${pulse})`;\n175\t        c.lineWidth = 2;\n176\t        c.strokeRect(px - 2, py - 2, pw + 4, ph + 4);\n177\t\n178\t        c.fillStyle = 'rgba(0,0,0,0.7)';\n179\t        const labelW = c.measureText(obj.label).width + 12;\n180\t        c.fillRect(px + pw / 2 - labelW / 2, py - 22, labelW, 18);\n181\t        c.fillStyle = '#ffdd66';\n182\t        c.font = `${Math.round(11)}px monospace`;\n183\t        c.textAlign = 'center';\n184\t        c.textBaseline = 'middle';\n185\t        c.fillText(obj.label, px + pw / 2, py - 13);\n186\t      }\n187\t    }\n188\t  }\n189\t\n190\t  private renderHUD(\n191\t    c: CanvasRenderingContext2D,\n192\t    canvasW: number,\n193\t    canvasH: number,\n194\t    state: GameState,\n195\t    player: Player,\n196\t    ctx?: RenderContext,\n197\t  ): void {\n198\t    // Top bar\n199\t    c.fillStyle = 'rgba(0,0,0,0.8)';\n200\t    c.fillRect(0, 0, canvasW, 44);\n201\t\n202\t    // Day counter\n203\t    c.fillStyle = '#e0d0b0';\n204\t    c.font = 'bold 13px monospace';\n205\t    c.textAlign = 'left';\n206\t    c.textBaseline = 'middle';\n207\t    c.fillText(`Day ${state.day}`, 12, 14);\n208\t\n209\t    // Time\n210\t    c.fillStyle = isNightTime(state.phase) ? '#8888cc' : '#ccaa66';\n211\t    c.font = '13px monospace';\n212\t    c.fillText(getTimeString(state.timeOfDay), 80, 14);\n213\t\n214\t    // Phase indicator\n215\t    const phaseLabels: Record<string, string> = {\n216\t      daytime: '营业中',\n217\t      night_transition: '准备打烊',\n218\t      night: '深夜营业',\n219\t      danger: '危险时段',\n220\t      dawn: '黎明',\n221\t    };\n222\t    c.fillStyle = state.phase === 'danger' ? '#ff4444' : '#aaa';\n223\t    c.font = '11px monospace';\n224\t    c.fillText(phaseLabels[state.phase] ?? state.phase, 160, 14);\n225\t\n226\t    // Money\n227\t    c.fillStyle = '#66cc66';\n228\t    c.font = '12px monospace';\n229\t    c.textAlign = 'right';\n230\t    c.fillText(`¥${state.money.toLocaleString()}`, canvasW - 12, 12);\n231\t\n232\t    // Debt\n233\t    c.fillStyle = '#cc6666';\n234\t    c.font = '10px monospace';\n235\t    c.fillText(`债务: ¥${state.debt.toLocaleString()}`, canvasW - 12, 26);\n236\t\n237\t    // Health bar\n238\t    c.textAlign = 'left';\n239\t    const hbX = 300;\n240\t    const hbY = 6;\n241\t    const hbW = 80;\n242\t    const hbH = 8;\n243\t    c.fillStyle = 'rgba(255,255,255,0.1)';\n244\t    c.fillRect(hbX, hbY, hbW, hbH);\n245\t    c.fillStyle = '#cc3333';\n246\t    c.fillRect(hbX, hbY, hbW * (state.player.health / 100), hbH);\n247\t    c.strokeStyle = 'rgba(255,255,255,0.2)';\n248\t    c.lineWidth = 1;\n249\t    c.strokeRect(hbX, hbY, hbW, hbH);\n250\t    c.fillStyle = '#aaa';\n251\t    c.font = '8px monospace';\n252\t    c.fillText('HP', hbX - 18, hbY + 7);\n253\t\n254\t    // Sanity bar\n255\t    const sbY = 18;\n256\t    c.fillStyle = 'rgba(255,255,255,0.1)';\n257\t    c.fillRect(hbX, sbY, hbW, hbH);\n258\t    c.fillStyle = '#6666cc';\n259\t    c.fillRect(hbX, sbY, hbW * (state.player.sanity / 100), hbH);\n260\t    c.strokeStyle = 'rgba(255,255,255,0.2)';\n261\t    c.strokeRect(hbX, sbY, hbW, hbH);\n262\t    c.fillStyle = '#aaa';\n263\t    c.fillText('SAN', hbX - 22, sbY + 7);\n264\t\n265\t    // Customer count\n266\t    if (ctx) {\n267\t      const custCount = ctx.customers.length;\n268\t      c.fillStyle = '#88aacc';\n269\t      c.font = '10px monospace';\n270\t      c.textAlign = 'left';\n271\t      c.fillText(`顾客: ${custCount}`, 420, 14);\n272\t    }\n273\t\n274\t    // Daily revenue\n275\t    c.fillStyle = '#88cc88';\n276\t    c.font = '10px monospace';\n277\t    c.textAlign = 'left';\n278\t    c.fillText(`今日: ¥${state.dailyRevenue.toFixed(0)}`, 500, 14);\n279\t\n280\t    // Shortcut hints\n281\t    c.fillStyle = 'rgba(255,255,255,0.4)';\n282\t    c.font = '10px monospace';\n283\t    c.textAlign = 'center';\n284\t    c.fillText('WASD 移动 | E 交互 | I 库存 | P 定价 | U 升级 | O 进货 | ESC 关闭', canvasW / 2, canvasH - 12);\n285\t\n286\t    // Notifications\n287\t    this.renderNotifications(c, canvasW, canvasH, state);\n288\t\n289\t    // Register status\n290\t    if (ctx) {\n291\t      this.renderRegisterStatus(c, canvasW, ctx.registers);\n292\t    }\n293\t  }\n294\t\n295\t  private renderNotifications(\n296\t    c: CanvasRenderingContext2D,\n297\t    w: number,\n298\t    h: number,\n299\t    state: GameState,\n300\t  ): void {\n301\t    const recent = state.notifications.slice(-5);\n302\t    if (recent.length === 0) return;\n303\t\n304\t    c.textAlign = 'right';\n305\t    c.font = '10px monospace';\n306\t    for (let i = 0; i < recent.length; i++) {\n307\t      const alpha = 0.3 + (i / recent.length) * 0.5;\n308\t      c.fillStyle = `rgba(200, 220, 255, ${alpha})`;\n309\t      c.fillText(recent[i], w - 12, h - 30 - (recent.length - 1 - i) * 14);\n310\t    }\n311\t  }\n312\t\n313\t  private renderRegisterStatus(\n314\t    c: CanvasRenderingContext2D,\n315\t    canvasW: number,\n316\t    registers: CashRegister[],\n317\t  ): void {\n318\t    let x = 12;\n319\t    const y = 48;\n320\t    for (const reg of registers) {\n321\t      const stateLabels: Record<string, string> = {\n322\t        idle: '空闲',\n323\t        scanning: '扫描中...',\n324\t        payment: '付款中',\n325\t        giving_change: '找零中',\n326\t        receipt: '打印收据',\n327\t        anomaly: '异常!',\n328\t      };\n329\t      const stateColors: Record<string, string> = {\n330\t        idle: '#666',\n331\t        scanning: '#6a6',\n332\t        payment: '#aa6',\n333\t        giving_change: '#6aa',\n334\t        receipt: '#66a',\n335\t        anomaly: '#a44',\n336\t      };\n337\t      const label = stateLabels[reg.state] ?? reg.state;\n338\t      const color = stateColors[reg.state] ?? '#666';\n339\t\n340\t      c.fillStyle = 'rgba(0,0,0,0.6)';\n341\t      c.fillRect(x, y, 80, 16);\n342\t      c.fillStyle = color;\n343\t      c.font = '9px monospace';\n344\t      c.textAlign = 'left';\n345\t      c.textBaseline = 'middle';\n346\t      c.fillText(`${reg.registerId}: ${label}`, x + 4, y + 8);\n347\t      x += 84;\n348\t    }\n349\t  }\n350\t\n351\t  private renderPanel(\n352\t    c: CanvasRenderingContext2D,\n353\t    w: number,\n354\t    h: number,\n355\t    state: GameState,\n356\t    ctx: RenderContext,\n357\t  ): void {\n358\t    // Darken background\n359\t    c.fillStyle = 'rgba(0,0,0,0.5)';\n360\t    c.fillRect(0, 0, w, h);\n361\t\n362\t    const panelW = Math.min(500, w - 40);\n363\t    const panelH = Math.min(400, h - 80);\n364\t    const px = (w - panelW) / 2;\n365\t    const py = (h - panelH) / 2;\n366\t\n367\t    // Panel background\n368\t    c.fillStyle = 'rgba(20, 20, 35, 0.95)';\n369\t    c.fillRect(px, py, panelW, panelH);\n370\t    c.strokeStyle = 'rgba(100, 120, 160, 0.5)';\n371\t    c.lineWidth = 1;\n372\t    c.strokeRect(px, py, panelW, panelH);\n373\t\n374\t    // Title bar\n375\t    c.fillStyle = 'rgba(40, 40, 60, 0.9)';\n376\t    c.fillRect(px, py, panelW, 30);\n377\t\n378\t    switch (state.activePanel) {\n379\t      case UIPanel.SHELF:\n380\t        this.renderShelfPanel(c, px, py, panelW, panelH, ctx);\n381\t        break;\n382\t      case UIPanel.INVENTORY:\n383\t        this.renderInventoryPanel(c, px, py, panelW, panelH, ctx);\n384\t        break;\n385\t      case UIPanel.PRICING:\n386\t        this.renderPricingPanel(c, px, py, panelW, panelH, ctx);\n387\t        break;\n388\t      case UIPanel.SHOP:\n389\t        this.renderShopPanel(c, px, py, panelW, panelH, ctx);\n390\t        break;\n391\t      case UIPanel.SUPPLIER:\n392\t        this.renderSupplierPanel(c, px, py, panelW, panelH, state, ctx);\n393\t        break;\n394\t    }\n395\t\n396\t    // Close button hint\n397\t    c.fillStyle = 'rgba(255,255,255,0.4)';\n398\t    c.font = '10px monospace';\n399\t    c.textAlign = 'center';\n400\t    c.fillText('按 ESC 或 E 关闭', w / 2, py + panelH + 15);\n401\t  }\n402\t\n403\t  private renderShelfPanel(\n404\t    c: CanvasRenderingContext2D,\n405\t    px: number, py: number,\n406\t    pw: number, ph: number,\n407\t    ctx: RenderContext,\n408\t  ): void {\n409\t    const shelf = ctx.shelfInteraction;\n410\t    if (!shelf.currentShelfId) return;\n411\t\n412\t    c.fillStyle = '#e0d0b0';\n413\t    c.font = 'bold 14px monospace';\n414\t    c.textAlign = 'left';\n415\t    c.textBaseline = 'top';\n416\t    c.fillText('货架管理', px + 10, py + 8);\n417\t\n418\t    const slot = ctx.productManager.shelfSlots.get(shelf.currentShelfId);\n419\t    if (!slot) return;\n420\t\n421\t    let y = py + 40;\n422\t\n423\t    if (slot.productId && slot.quantity > 0) {\n424\t      const product = ctx.productManager.getProduct(slot.productId);\n425\t      c.fillStyle = '#aac';\n426\t      c.font = '12px monospace';\n427\t      c.fillText(`商品: ${product?.name ?? slot.productId}`, px + 10, y);\n428\t      y += 18;\n429\t      c.fillText(`库存: ${slot.quantity}/${slot.maxQuantity}`, px + 10, y);\n430\t      y += 18;\n431\t      const price = ctx.pricing.getPrice(slot.productId);\n432\t      c.fillText(`售价: ¥${price.toFixed(2)}`, px + 10, y);\n433\t      y += 30;\n434\t    } else {\n435\t      c.fillStyle = '#888';\n436\t      c.font = '12px monospace';\n437\t      c.fillText('空货架', px + 10, y);\n438\t      y += 30;\n439\t    }\n440\t\n441\t    // Available products to stock\n442\t    c.fillStyle = '#ccc';\n443\t    c.font = '11px monospace';\n444\t    c.fillText('可上架商品:', px + 10, y);\n445\t    y += 18;\n446\t\n447\t    const available = shelf.getAvailableProductsForShelf(shelf.currentShelfId, ctx.productManager);\n448\t    for (let i = 0; i < Math.min(available.length, 8); i++) {\n449\t      const item = available[i];\n450\t      c.fillStyle = '#aab8cc';\n451\t      c.font = '11px monospace';\n452\t      c.fillText(`  ${item.name} x${item.quantity}`, px + 10, y);\n453\t      y += 16;\n454\t    }\n455\t\n456\t    if (available.length === 0) {\n457\t      c.fillStyle = '#666';\n458\t      c.fillText('  (无库存)', px + 10, y);\n459\t    }\n460\t  }\n461\t\n462\t  private renderInventoryPanel(\n463\t    c: CanvasRenderingContext2D,\n464\t    px: number, py: number,\n465\t    pw: number, ph: number,\n466\t    ctx: RenderContext,\n467\t  ): void {\n468\t    c.fillStyle = '#e0d0b0';\n469\t    c.font = 'bold 14px monospace';\n470\t    c.textAlign = 'left';\n471\t    c.textBaseline = 'top';\n472\t    c.fillText('库存管理', px + 10, py + 8);\n473\t\n474\t    let y = py + 40;\n475\t    c.fillStyle = '#aaa';\n476\t    c.font = '10px monospace';\n477\t    c.fillText(`仓库容量: ${ctx.productManager.storageUsed}/${ctx.productManager.storageCapacity}`, px + 10, y);\n478\t    y += 20;\n479\t\n480\t    for (const [id, item] of ctx.productManager.inventory) {\n481\t      if (item.quantity <= 0) continue;\n482\t      const product = ctx.productManager.getProduct(id);\n483\t      const price = ctx.pricing.getPrice(id);\n484\t      c.fillStyle = '#bbb';\n485\t      c.font = '11px monospace';\n486\t      c.fillText(`${product?.name ?? id}  x${item.quantity}  ¥${price.toFixed(2)}/个`, px + 10, y);\n487\t      y += 16;\n488\t      if (y > py + ph - 30) break;\n489\t    }\n490\t  }\n491\t\n492\t  private renderPricingPanel(\n493\t    c: CanvasRenderingContext2D,\n494\t    px: number, py: number,\n495\t    pw: number, ph: number,\n496\t    ctx: RenderContext,\n497\t  ): void {\n498\t    c.fillStyle = '#e0d0b0';\n499\t    c.font = 'bold 14px monospace';\n500\t    c.textAlign = 'left';\n501\t    c.textBaseline = 'top';\n502\t    c.fillText('定价管理', px + 10, py + 8);\n503\t\n504\t    let y = py + 40;\n505\t    const prices = ctx.pricing.getAllPrices();\n506\t\n507\t    c.fillStyle = '#888';\n508\t    c.font = '10px monospace';\n509\t    c.fillText('商品           基价      现价      范围', px + 10, y);\n510\t    y += 16;\n511\t\n512\t    for (const entry of prices) {\n513\t      const product = ctx.productManager.getProduct(entry.productId);\n514\t      if (!product) continue;\n515\t      c.fillStyle = '#bbb';\n516\t      c.font = '10px monospace';\n517\t      const name = product.name.padEnd(8, '　');\n518\t      c.fillText(\n519\t        `${name}  ¥${entry.basePrice.toFixed(0).padStart(3)}   ¥${entry.currentPrice.toFixed(0).padStart(3)}   ${entry.minPrice.toFixed(0)}-${entry.maxPrice.toFixed(0)}`,\n520\t        px + 10, y,\n521\t      );\n522\t      y += 14;\n523\t      if (y > py + ph - 30) break;\n524\t    }\n525\t  }\n526\t\n527\t  private renderShopPanel(\n528\t    c: CanvasRenderingContext2D,\n529\t    px: number, py: number,\n530\t    pw: number, ph: number,\n531\t    ctx: RenderContext,\n532\t  ): void {\n533\t    c.fillStyle = '#e0d0b0';\n534\t    c.font = 'bold 14px monospace';\n535\t    c.textAlign = 'left';\n536\t    c.textBaseline = 'top';\n537\t    c.fillText('店铺升级', px + 10, py + 8);\n538\t\n539\t    let y = py + 40;\n540\t    const upgrades = ctx.economy.getUpgrades();\n541\t\n542\t    for (const upgrade of upgrades) {\n543\t      const owned = ctx.economy.hasUpgrade(upgrade.id);\n544\t      c.fillStyle = owned ? '#5a7a5a' : '#bbb';\n545\t      c.font = '11px monospace';\n546\t      c.fillText(\n547\t        `${owned ? '[已购]' : `¥${upgrade.cost}`.padStart(6)} ${upgrade.name} — ${upgrade.description}`,\n548\t        px + 10, y,\n549\t      );\n550\t      y += 16;\n551\t      c.fillStyle = '#777';\n552\t      c.font = '9px monospace';\n553\t      c.fillText(`  ${upgrade.horrorLink}`, px + 10, y);\n554\t      y += 14;\n555\t      if (y > py + ph - 30) break;\n556\t    }\n557\t  }\n558\t\n559\t  private renderSupplierPanel(\n560\t    c: CanvasRenderingContext2D,\n561\t    px: number, py: number,\n562\t    pw: number, ph: number,\n563\t    state: GameState,\n564\t    ctx: RenderContext,\n565\t  ): void {\n566\t    c.fillStyle = '#e0d0b0';\n567\t    c.font = 'bold 14px monospace';\n568\t    c.textAlign = 'left';\n569\t    c.textBaseline = 'top';\n570\t    c.fillText('进货管理', px + 10, py + 8);\n571\t\n572\t    let y = py + 40;\n573\t\n574\t    // Show suppliers\n575\t    const isNight = isNightTime(state.phase);\n576\t    const suppliers = ctx.productManager.getUnlockedSuppliers(state.day, isNight);\n577\t    c.fillStyle = '#888';\n578\t    c.font = '10px monospace';\n579\t    c.fillText('可用供应商:', px + 10, y);\n580\t    y += 16;\n581\t\n582\t    for (const supplier of suppliers) {\n583\t      c.fillStyle = '#aab8cc';\n584\t      c.font = '11px monospace';\n585\t      c.fillText(`${supplier.name} — ${supplier.description}`, px + 10, y);\n586\t      y += 14;\n587\t      c.fillStyle = '#777';\n588\t      c.font = '9px monospace';\n589\t      c.fillText(`  价格x${supplier.priceMultiplier} 可靠度${Math.round(supplier.reliability * 100)}%`, px + 10, y);\n590\t      y += 16;\n591\t    }\n592\t\n593\t    y += 10;\n594\t\n595\t    // Pending orders\n596\t    if (ctx.productManager.pendingOrders.length > 0) {\n597\t      c.fillStyle = '#888';\n598\t      c.font = '10px monospace';\n599\t      c.fillText('待到货订单:', px + 10, y);\n600\t      y += 16;\n601\t\n602\t      for (const order of ctx.productManager.pendingOrders) {\n603\t        const product = ctx.productManager.getProduct(order.productId);\n604\t        c.fillStyle = '#cc9';\n605\t        c.font = '10px monospace';\n606\t        c.fillText(`${product?.name ?? order.productId} x${order.quantity} — ¥${order.totalCost} (Day ${order.arrivalDay}到)`, px + 10, y);\n607\t        y += 14;\n608\t        if (y > py + ph - 30) break;\n609\t      }\n610\t    }\n611\t  }\n612\t\n613\t  destroy(): void {}\n614\t}\n615\t"}]},"parent_tool_use_id":null,"session_id":"e8f5bde0-4da8-4c4a-9322-50945e66ead7","uuid":"3f271450-5410-44d2-b357-9f08aa8cab76","timestamp":"2026-05-23T04:37:12.127Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-horror-sim\\src\\renderer\\Renderer.ts","content":"// Renderer.ts — Canvas 2D rendering system (v0.2.0 — M2)\n\nimport { Camera } from './Camera';\nimport { StoreMap, T } from '../game/StoreMap';\nimport { Player } from '../game/Player';\nimport { Lighting } from './Lighting';\nimport {\n  type GameState,\n  type GamePhase,\n  type LightSource,\n  type Interactable,\n  GamePhase as GP,\n  UIPanel,\n  getTimeString,\n  isNightTime,\n} from '../game/GameState';\nimport { Customer } from '../game/Customer';\nimport { ProductManager } from '../game/ProductManager';\nimport { ShelfInteraction, ShelfAction } from '../game/ShelfInteraction';\nimport { CashRegister, RegisterState } from '../game/CashRegister';\nimport { EconomySystem } from '../game/EconomySystem';\nimport { PricingSystem } from '../game/PricingSystem';\n\nexport interface RenderContext {\n  customers: Customer[];\n  productManager: ProductManager;\n  shelfInteraction: ShelfInteraction;\n  registers: CashRegister[];\n  economy: EconomySystem;\n  pricing: PricingSystem;\n  lastTransaction: string;\n}\n\nexport class Renderer {\n  canvas: HTMLCanvasElement;\n  ctx: CanvasRenderingContext2D;\n  camera: Camera;\n  lighting: Lighting;\n\n  constructor(canvas: HTMLCanvasElement) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d')!;\n    this.camera = new Camera(canvas);\n    this.lighting = new Lighting();\n    this.resize();\n    this.camera.setupZoom(canvas);\n  }\n\n  resize(): void {\n    const dpr = window.devicePixelRatio || 1;\n    const rect = this.canvas.getBoundingClientRect();\n    this.canvas.width = rect.width * dpr;\n    this.canvas.height = rect.height * dpr;\n    this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n  }\n\n  render(\n    map: StoreMap,\n    player: Player,\n    state: GameState,\n    now: number,\n    ctx?: RenderContext,\n  ): void {\n    const c = this.ctx;\n    const w = this.canvas.getBoundingClientRect().width;\n    const h = this.canvas.getBoundingClientRect().height;\n\n    const bgPhase = state.phase;\n    if (bgPhase === 'danger') {\n      c.fillStyle = '#0a0a15';\n    } else if (isNightTime(bgPhase)) {\n      c.fillStyle = '#0f1020';\n    } else {\n      c.fillStyle = '#1a1520';\n    }\n    c.fillRect(0, 0, w, h);\n\n    const { offsetX, offsetY, scale } = this.camera.getTransform();\n\n    // Render map tiles\n    map.render(c, offsetX, offsetY, w, h, scale);\n\n    // Render shelf product indicators\n    if (ctx) {\n      this.renderShelfIndicators(c, ctx.productManager, state.interactables, offsetX, offsetY, scale);\n    }\n\n    // Render interactable highlights\n    this.renderInteractables(c, state.interactables, offsetX, offsetY, scale, player, now);\n\n    // Render customers\n    if (ctx) {\n      for (const customer of ctx.customers) {\n        customer.render(c, offsetX, offsetY, scale);\n      }\n    }\n\n    // Render player\n    player.render(c, offsetX, offsetY, scale);\n\n    // Render lighting overlay\n    this.lighting.render(c, w, h, state.lights, state.phase, offsetX, offsetY, scale, now);\n\n    // Render HUD\n    this.renderHUD(c, w, h, state, player, ctx);\n\n    // Render active panel\n    if (ctx && state.activePanel !== UIPanel.NONE) {\n      this.renderPanel(c, w, h, state, ctx);\n    }\n  }\n\n  private renderShelfIndicators(\n    c: CanvasRenderingContext2D,\n    pm: ProductManager,\n    interactables: Interactable[],\n    ox: number,\n    oy: number,\n    scale: number,\n  ): void {\n    for (const inter of interactables) {\n      if (inter.type !== 'shelf' && inter.type !== 'fridge') continue;\n      const slot = pm.shelfSlots.get(inter.id);\n      if (!slot || !slot.productId || slot.quantity <= 0) continue;\n\n      const product = pm.getProduct(slot.productId);\n      if (!product) continue;\n\n      const px = ox + inter.x * scale;\n      const py = oy + (inter.y - 8) * scale;\n      const pw = inter.width * scale;\n\n      // Stock level bar\n      const ratio = slot.quantity / slot.maxQuantity;\n      const barColor = ratio > 0.5 ? '#66aa66' : ratio > 0.2 ? '#aaaa44' : '#aa4444';\n      c.fillStyle = 'rgba(0,0,0,0.5)';\n      c.fillRect(px, py, pw, 6 * scale);\n      c.fillStyle = barColor;\n      c.fillRect(px, py, pw * ratio, 6 * scale);\n\n      // Product name\n      c.fillStyle = 'rgba(255,255,255,0.7)';\n      c.font = `${Math.round(8 * scale)}px monospace`;\n      c.textAlign = 'center';\n      c.textBaseline = 'top';\n      c.fillText(`${product.name}(${slot.quantity})`, px + pw / 2, py + 7 * scale);\n    }\n  }\n\n  private renderInteractables(\n    c: CanvasRenderingContext2D,\n    interactables: Interactable[],\n    ox: number,\n    oy: number,\n    scale: number,\n    player: Player,\n    now: number,\n  ): void {\n    const facing = player.getFacingTile();\n\n    for (const obj of interactables) {\n      const px = ox + obj.x * scale;\n      const py = oy + obj.y * scale;\n      const pw = obj.width * scale;\n      const ph = obj.height * scale;\n\n      const objGX = Math.floor(obj.x / 32);\n      const objGY = Math.floor(obj.y / 32);\n      const isFacing = facing.gx >= objGX && facing.gx <= objGX + Math.ceil(obj.width / 32) - 1 &&\n        facing.gy >= objGY && facing.gy <= objGY + Math.ceil(obj.height / 32) - 1;\n\n      if (isFacing) {\n        const pulse = 0.3 + Math.sin(now * 0.005) * 0.1;\n        c.strokeStyle = `rgba(255, 255, 100, ${pulse})`;\n        c.lineWidth = 2;\n        c.strokeRect(px - 2, py - 2, pw + 4, ph + 4);\n\n        c.fillStyle = 'rgba(0,0,0,0.7)';\n        const labelW = c.measureText(obj.label).width + 12;\n        c.fillRect(px + pw / 2 - labelW / 2, py - 22, labelW, 18);\n        c.fillStyle = '#ffdd66';\n        c.font = `${Math.round(11)}px monospace`;\n        c.textAlign = 'center';\n        c.textBaseline = 'middle';\n        c.fillText(obj.label, px + pw / 2, py - 13);\n      }\n    }\n  }\n\n  private renderHUD(\n    c: CanvasRenderingContext2D,\n    canvasW: number,\n    canvasH: number,\n    state: GameState,\n    player: Player,\n    ctx?: RenderContext,\n  ): void {\n    // Top bar\n    c.fillStyle = 'rgba(0,0,0,0.8)';\n    c.fillRect(0, 0, canvasW, 44);\n\n    // Day counter\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 13px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'middle';\n    c.fillText(`Day ${state.day}`, 12, 14);\n\n    // Time\n    c.fillStyle = isNightTime(state.phase) ? '#8888cc' : '#ccaa66';\n    c.font = '13px monospace';\n    c.fillText(getTimeString(state.timeOfDay), 80, 14);\n\n    // Phase indicator\n    const phaseLabels: Record<string, string> = {\n      daytime: '营业中',\n      night_transition: '准备打烊',\n      night: '深夜营业',\n      danger: '危险时段',\n      dawn: '黎明',\n    };\n    c.fillStyle = state.phase === 'danger' ? '#ff4444' : '#aaa';\n    c.font = '11px monospace';\n    c.fillText(phaseLabels[state.phase] ?? state.phase, 160, 14);\n\n    // Money\n    c.fillStyle = '#66cc66';\n    c.font = '12px monospace';\n    c.textAlign = 'right';\n    c.fillText(`¥${state.money.toLocaleString()}`, canvasW - 12, 12);\n\n    // Debt\n    c.fillStyle = '#cc6666';\n    c.font = '10px monospace';\n    c.fillText(`债务: ¥${state.debt.toLocaleString()}`, canvasW - 12, 26);\n\n    // Health bar\n    c.textAlign = 'left';\n    const hbX = 300;\n    const hbY = 6;\n    const hbW = 80;\n    const hbH = 8;\n    c.fillStyle = 'rgba(255,255,255,0.1)';\n    c.fillRect(hbX, hbY, hbW, hbH);\n    c.fillStyle = '#cc3333';\n    c.fillRect(hbX, hbY, hbW * (state.player.health / 100), hbH);\n    c.strokeStyle = 'rgba(255,255,255,0.2)';\n    c.lineWidth = 1;\n    c.strokeRect(hbX, hbY, hbW, hbH);\n    c.fillStyle = '#aaa';\n    c.font = '8px monospace';\n    c.fillText('HP', hbX - 18, hbY + 7);\n\n    // Sanity bar\n    const sbY = 18;\n    c.fillStyle = 'rgba(255,255,255,0.1)';\n    c.fillRect(hbX, sbY, hbW, hbH);\n    c.fillStyle = '#6666cc';\n    c.fillRect(hbX, sbY, hbW * (state.player.sanity / 100), hbH);\n    c.strokeStyle = 'rgba(255,255,255,0.2)';\n    c.strokeRect(hbX, sbY, hbW, hbH);\n    c.fillStyle = '#aaa';\n    c.fillText('SAN', hbX - 22, sbY + 7);\n\n    // Customer count\n    if (ctx) {\n      const custCount = ctx.customers.length;\n      c.fillStyle = '#88aacc';\n      c.font = '10px monospace';\n      c.textAlign = 'left';\n      c.fillText(`顾客: ${custCount}`, 420, 14);\n    }\n\n    // Daily revenue\n    c.fillStyle = '#88cc88';\n    c.font = '10px monospace';\n    c.textAlign = 'left';\n    c.fillText(`今日: ¥${state.dailyRevenue.toFixed(0)}`, 500, 14);\n\n    // Shortcut hints\n    c.fillStyle = 'rgba(255,255,255,0.4)';\n    c.font = '10px monospace';\n    c.textAlign = 'center';\n    c.fillText('WASD 移动 | E 交互 | I 库存 | P 定价 | U 升级 | O 进货 | ESC 关闭', canvasW / 2, canvasH - 12);\n\n    // Notifications\n    this.renderNotifications(c, canvasW, canvasH, state);\n\n    // Register status\n    if (ctx) {\n      this.renderRegisterStatus(c, canvasW, ctx.registers);\n    }\n  }\n\n  private renderNotifications(\n    c: CanvasRenderingContext2D,\n    w: number,\n    h: number,\n    state: GameState,\n  ): void {\n    const recent = state.notifications.slice(-5);\n    if (recent.length === 0) return;\n\n    c.textAlign = 'right';\n    c.font = '10px monospace';\n    for (let i = 0; i < recent.length; i++) {\n      const alpha = 0.3 + (i / recent.length) * 0.5;\n      c.fillStyle = `rgba(200, 220, 255, ${alpha})`;\n      c.fillText(recent[i], w - 12, h - 30 - (recent.length - 1 - i) * 14);\n    }\n  }\n\n  private renderRegisterStatus(\n    c: CanvasRenderingContext2D,\n    canvasW: number,\n    registers: CashRegister[],\n  ): void {\n    let x = 12;\n    const y = 48;\n    for (const reg of registers) {\n      const stateLabels: Record<string, string> = {\n        idle: '空闲',\n        scanning: '扫描中...',\n        payment: '付款中',\n        giving_change: '找零中',\n        receipt: '打印收据',\n        anomaly: '异常!',\n      };\n      const stateColors: Record<string, string> = {\n        idle: '#666',\n        scanning: '#6a6',\n        payment: '#aa6',\n        giving_change: '#6aa',\n        receipt: '#66a',\n        anomaly: '#a44',\n      };\n      const label = stateLabels[reg.state] ?? reg.state;\n      const color = stateColors[reg.state] ?? '#666';\n\n      c.fillStyle = 'rgba(0,0,0,0.6)';\n      c.fillRect(x, y, 80, 16);\n      c.fillStyle = color;\n      c.font = '9px monospace';\n      c.textAlign = 'left';\n      c.textBaseline = 'middle';\n      c.fillText(`${reg.registerId}: ${label}`, x + 4, y + 8);\n      x += 84;\n    }\n  }\n\n  private renderPanel(\n    c: CanvasRenderingContext2D,\n    w: number,\n    h: number,\n    state: GameState,\n    ctx: RenderContext,\n  ): void {\n    // Darken background\n    c.fillStyle = 'rgba(0,0,0,0.5)';\n    c.fillRect(0, 0, w, h);\n\n    const panelW = Math.min(500, w - 40);\n    const panelH = Math.min(400, h - 80);\n    const px = (w - panelW) / 2;\n    const py = (h - panelH) / 2;\n\n    // Panel background\n    c.fillStyle = 'rgba(20, 20, 35, 0.95)';\n    c.fillRect(px, py, panelW, panelH);\n    c.strokeStyle = 'rgba(100, 120, 160, 0.5)';\n    c.lineWidth = 1;\n    c.strokeRect(px, py, panelW, panelH);\n\n    // Title bar\n    c.fillStyle = 'rgba(40, 40, 60, 0.9)';\n    c.fillRect(px, py, panelW, 30);\n\n    switch (state.activePanel) {\n      case UIPanel.SHELF:\n        this.renderShelfPanel(c, px, py, panelW, panelH, ctx);\n        break;\n      case UIPanel.INVENTORY:\n        this.renderInventoryPanel(c, px, py, panelW, panelH, ctx);\n        break;\n      case UIPanel.PRICING:\n        this.renderPricingPanel(c, px, py, panelW, panelH, ctx);\n        break;\n      case UIPanel.SHOP:\n        this.renderShopPanel(c, px, py, panelW, panelH, ctx);\n        break;\n      case UIPanel.SUPPLIER:\n        this.renderSupplierPanel(c, px, py, panelW, panelH, state, ctx);\n        break;\n    }\n\n    // Close button hint\n    c.fillStyle = 'rgba(255,255,255,0.4)';\n    c.font = '10px monospace';\n    c.textAlign = 'center';\n    c.fillText('按 ESC 或 E 关闭', w / 2, py + panelH + 15);\n  }\n\n  private renderShelfPanel(\n    c: CanvasRenderingContext2D,\n    px: number, py: number,\n    pw: number, ph: number,\n    ctx: RenderContext,\n  ): void {\n    const shelf = ctx.shelfInteraction;\n    if (!shelf.currentShelfId) return;\n\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 14px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'top';\n    c.fillText('货架管理', px + 10, py + 8);\n\n    const slot = ctx.productManager.shelfSlots.get(shelf.currentShelfId);\n    if (!slot) return;\n\n    let y = py + 40;\n\n    if (slot.productId && slot.quantity > 0) {\n      const product = ctx.productManager.getProduct(slot.productId);\n      c.fillStyle = '#aac';\n      c.font = '12px monospace';\n      c.fillText(`商品: ${product?.name ?? slot.productId}`, px + 10, y);\n      y += 18;\n      c.fillText(`库存: ${slot.quantity}/${slot.maxQuantity}`, px + 10, y);\n      y += 18;\n      const price = ctx.pricing.getPrice(slot.productId);\n      c.fillText(`售价: ¥${price.toFixed(2)}`, px + 10, y);\n      y += 30;\n    } else {\n      c.fillStyle = '#888';\n      c.font = '12px monospace';\n      c.fillText('空货架', px + 10, y);\n      y += 30;\n    }\n\n    // Available products to stock\n    c.fillStyle = '#ccc';\n    c.font = '11px monospace';\n    c.fillText('可上架商品:', px + 10, y);\n    y += 18;\n\n    const available = shelf.getAvailableProductsForShelf(shelf.currentShelfId, ctx.productManager);\n    for (let i = 0; i < Math.min(available.length, 8); i++) {\n      const item = available[i];\n      c.fillStyle = '#aab8cc';\n      c.font = '11px monospace';\n      c.fillText(`  ${item.name} x${item.quantity}`, px + 10, y);\n      y += 16;\n    }\n\n    if (available.length === 0) {\n      c.fillStyle = '#666';\n      c.fillText('  (无库存)', px + 10, y);\n    }\n  }\n\n  private renderInventoryPanel(\n    c: CanvasRenderingContext2D,\n    px: number, py: number,\n    pw: number, ph: number,\n    ctx: RenderContext,\n  ): void {\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 14px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'top';\n    c.fillText('库存管理', px + 10, py + 8);\n\n    let y = py + 40;\n    c.fillStyle = '#aaa';\n    c.font = '10px monospace';\n    c.fillText(`仓库容量: ${ctx.productManager.storageUsed}/${ctx.productManager.storageCapacity}`, px + 10, y);\n    y += 20;\n\n    for (const [id, item] of ctx.productManager.inventory) {\n      if (item.quantity <= 0) continue;\n      const product = ctx.productManager.getProduct(id);\n      const price = ctx.pricing.getPrice(id);\n      c.fillStyle = '#bbb';\n      c.font = '11px monospace';\n      c.fillText(`${product?.name ?? id}  x${item.quantity}  ¥${price.toFixed(2)}/个`, px + 10, y);\n      y += 16;\n      if (y > py + ph - 30) break;\n    }\n  }\n\n  private renderPricingPanel(\n    c: CanvasRenderingContext2D,\n    px: number, py: number,\n    pw: number, ph: number,\n    ctx: RenderContext,\n  ): void {\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 14px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'top';\n    c.fillText('定价管理', px + 10, py + 8);\n\n    let y = py + 40;\n    const prices = ctx.pricing.getAllPrices();\n\n    c.fillStyle = '#888';\n    c.font = '10px monospace';\n    c.fillText('商品           基价      现价      范围', px + 10, y);\n    y += 16;\n\n    for (const entry of prices) {\n      const product = ctx.productManager.getProduct(entry.productId);\n      if (!product) continue;\n      c.fillStyle = '#bbb';\n      c.font = '10px monospace';\n      const name = product.name.padEnd(8, '　');\n      c.fillText(\n        `${name}  ¥${entry.basePrice.toFixed(0).padStart(3)}   ¥${entry.currentPrice.toFixed(0).padStart(3)}   ${entry.minPrice.toFixed(0)}-${entry.maxPrice.toFixed(0)}`,\n        px + 10, y,\n      );\n      y += 14;\n      if (y > py + ph - 30) break;\n    }\n  }\n\n  private renderShopPanel(\n    c: CanvasRenderingContext2D,\n    px: number, py: number,\n    pw: number, ph: number,\n    ctx: RenderContext,\n  ): void {\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 14px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'top';\n    c.fillText('店铺升级', px + 10, py + 8);\n\n    let y = py + 40;\n    const upgrades = ctx.economy.getUpgrades();\n\n    for (const upgrade of upgrades) {\n      const owned = ctx.economy.hasUpgrade(upgrade.id);\n      c.fillStyle = owned ? '#5a7a5a' : '#bbb';\n      c.font = '11px monospace';\n      c.fillText(\n        `${owned ? '[已购]' : `¥${upgrade.cost}`.padStart(6)} ${upgrade.name} — ${upgrade.description}`,\n        px + 10, y,\n      );\n      y += 16;\n      c.fillStyle = '#777';\n      c.font = '9px monospace';\n      c.fillText(`  ${upgrade.horrorLink}`, px + 10, y);\n      y += 14;\n      if (y > py + ph - 30) break;\n    }\n  }\n\n  private renderSupplierPanel(\n    c: CanvasRenderingContext2D,\n    px: number, py: number,\n    pw: number, ph: number,\n    state: GameState,\n    ctx: RenderContext,\n  ): void {\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 14px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'top';\n    c.fillText('进货管理', px + 10, py + 8);\n\n    let y = py + 40;\n\n    // Show suppliers\n    const isNight = isNightTime(state.phase);\n    const suppliers = ctx.productManager.getUnlockedSuppliers(state.day, isNight);\n    c.fillStyle = '#888';\n    c.font = '10px monospace';\n    c.fillText('可用供应商:', px + 10, y);\n    y += 16;\n\n    for (const supplier of suppliers) {\n      c.fillStyle = '#aab8cc';\n      c.font = '11px monospace';\n      c.fillText(`${supplier.name} — ${supplier.description}`, px + 10, y);\n      y += 14;\n      c.fillStyle = '#777';\n      c.font = '9px monospace';\n      c.fillText(`  价格x${supplier.priceMultiplier} 可靠度${Math.round(supplier.reliability * 100)}%`, px + 10, y);\n      y += 16;\n    }\n\n    y += 10;\n\n    // Pending orders\n    if (ctx.productManager.pendingOrders.length > 0) {\n      c.fillStyle = '#888';\n      c.font = '10px monospace';\n      c.fillText('待到货订单:', px + 10, y);\n      y += 16;\n\n      for (const order of ctx.productManager.pendingOrders) {\n        const product = ctx.productManager.getProduct(order.productId);\n        c.fillStyle = '#cc9';\n        c.font = '10px monospace';\n        c.fillText(`${product?.name ?? order.productId} x${order.quantity} — ¥${order.totalCost} (Day ${order.arrivalDay}到)`, px + 10, y);\n        y += 14;\n        if (y > py + ph - 30) break;\n      }\n    }\n  }\n\n  destroy(): void {}\n}\n","numLines":615,"startLine":1,"totalLines":615}}}
