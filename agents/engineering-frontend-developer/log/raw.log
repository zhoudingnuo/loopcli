{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ee5c96991a72452f8929dc22","type":"tool_result","content":"1\t// Renderer.ts — Canvas 2D rendering system (v0.2.0 — M2)\n2\t\n3\timport { Camera } from './Camera';\n4\timport { StoreMap, T } from '../game/StoreMap';\n5\timport { Player } from '../game/Player';\n6\timport { Lighting } from './Lighting';\n7\timport {\n8\t  type GameState,\n9\t  type GamePhase,\n10\t  type LightSource,\n11\t  type Interactable,\n12\t  GamePhase as GP,\n13\t  UIPanel,\n14\t  getTimeString,\n15\t  isNightTime,\n16\t} from '../game/GameState';\n17\timport { Customer } from '../game/Customer';\n18\timport { ProductManager } from '../game/ProductManager';\n19\timport { ShelfInteraction, ShelfAction } from '../game/ShelfInteraction';\n20\timport { CashRegister, RegisterState } from '../game/CashRegister';\n21\timport { EconomySystem } from '../game/EconomySystem';\n22\timport { PricingSystem } from '../game/PricingSystem';\n23\timport { DaySummaryManager } from '../game/DaySummary';\n24\timport { UpgradeManager } from '../game/UpgradeManager';\n25\t\n26\texport interface RenderContext {\n27\t  customers: Customer[];\n28\t  productManager: ProductManager;\n29\t  shelfInteraction: ShelfInteraction;\n30\t  registers: CashRegister[];\n31\t  economy: EconomySystem;\n32\t  pricing: PricingSystem;\n33\t  lastTransaction: string;\n34\t  daySummary?: DaySummaryManager;\n35\t  upgradeManager?: UpgradeManager;\n36\t}\n37\t\n38\texport class Renderer {\n39\t  canvas: HTMLCanvasElement;\n40\t  ctx: CanvasRenderingContext2D;\n41\t  camera: Camera;\n42\t  lighting: Lighting;\n43\t\n44\t  constructor(canvas: HTMLCanvasElement) {\n45\t    this.canvas = canvas;\n46\t    this.ctx = canvas.getContext('2d')!;\n47\t    this.camera = new Camera(canvas);\n48\t    this.lighting = new Lighting();\n49\t    this.resize();\n50\t    this.camera.setupZoom(canvas);\n51\t  }\n52\t\n53\t  resize(): void {\n54\t    const dpr = window.devicePixelRatio || 1;\n55\t    const rect = this.canvas.getBoundingClientRect();\n56\t    this.canvas.width = rect.width * dpr;\n57\t    this.canvas.height = rect.height * dpr;\n58\t    this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n59\t  }\n60\t\n61\t  render(\n62\t    map: StoreMap,\n63\t    player: Player,\n64\t    state: GameState,\n65\t    now: number,\n66\t    ctx?: RenderContext,\n67\t  ): void {\n68\t    const c = this.ctx;\n69\t    const w = this.canvas.getBoundingClientRect().width;\n70\t    const h = this.canvas.getBoundingClientRect().height;\n71\t\n72\t    const bgPhase = state.phase;\n73\t    if (bgPhase === 'danger') {\n74\t      c.fillStyle = '#0a0a15';\n75\t    } else if (isNightTime(bgPhase)) {\n76\t      c.fillStyle = '#0f1020';\n77\t    } else {\n78\t      c.fillStyle = '#1a1520';\n79\t    }\n80\t    c.fillRect(0, 0, w, h);\n81\t\n82\t    const { offsetX, offsetY, scale } = this.camera.getTransform();\n83\t\n84\t    // Render map tiles\n85\t    map.render(c, offsetX, offsetY, w, h, scale);\n86\t\n87\t    // Render shelf product indicators\n88\t    if (ctx) {\n89\t      this.renderShelfIndicators(c, ctx.productManager, state.interactables, offsetX, offsetY, scale);\n90\t    }\n91\t\n92\t    // Render interactable highlights\n93\t    this.renderInteractables(c, state.interactables, offsetX, offsetY, scale, player, now);\n94\t\n95\t    // Render customers\n96\t    if (ctx) {\n97\t      for (const customer of ctx.customers) {\n98\t        customer.render(c, offsetX, offsetY, scale);\n99\t      }\n100\t    }\n101\t\n102\t    // Render player\n103\t    player.render(c, offsetX, offsetY, scale);\n104\t\n105\t    // Render lighting overlay (M3: pass timeOfDay for gradual transitions)\n106\t    this.lighting.render(c, w, h, state.lights, state.phase, offsetX, offsetY, scale, now, state.timeOfDay);\n107\t\n108\t    // Render HUD\n109\t    this.renderHUD(c, w, h, state, player, ctx);\n110\t\n111\t    // Render active panel\n112\t    if (ctx && state.activePanel !== UIPanel.NONE) {\n113\t      this.renderPanel(c, w, h, state, ctx);\n114\t    }\n115\t\n116\t    // M3: Render day summary overlay\n117\t    if (ctx?.daySummary) {\n118\t      ctx.daySummary.render(c, w, h);\n119\t    }\n120\t  }\n121\t\n122\t  private renderShelfIndicators(\n123\t    c: CanvasRenderingContext2D,\n124\t    pm: ProductManager,\n125\t    interactables: Interactable[],\n126\t    ox: number,\n127\t    oy: number,\n128\t    scale: number,\n129\t  ): void {\n130\t    for (const inter of interactables) {\n131\t      if (inter.type !== 'shelf' && inter.type !== 'fridge') continue;\n132\t      const slot = pm.shelfSlots.get(inter.id);\n133\t      if (!slot || !slot.productId || slot.quantity <= 0) continue;\n134\t\n135\t      const product = pm.getProduct(slot.productId);\n136\t      if (!product) continue;\n137\t\n138\t      const px = ox + inter.x * scale;\n139\t      const py = oy + (inter.y - 8) * scale;\n140\t      const pw = inter.width * scale;\n141\t\n142\t      // Stock level bar\n143\t      const ratio = slot.quantity / slot.maxQuantity;\n144\t      const barColor = ratio > 0.5 ? '#66aa66' : ratio > 0.2 ? '#aaaa44' : '#aa4444';\n145\t      c.fillStyle = 'rgba(0,0,0,0.5)';\n146\t      c.fillRect(px, py, pw, 6 * scale);\n147\t      c.fillStyle = barColor;\n148\t      c.fillRect(px, py, pw * ratio, 6 * scale);\n149\t\n150\t      // Product name\n151\t      c.fillStyle = 'rgba(255,255,255,0.7)';\n152\t      c.font = `${Math.round(8 * scale)}px monospace`;\n153\t      c.textAlign = 'center';\n154\t      c.textBaseline = 'top';\n155\t      c.fillText(`${product.name}(${slot.quantity})`, px + pw / 2, py + 7 * scale);\n156\t    }\n157\t  }\n158\t\n159\t  private renderInteractables(\n160\t    c: CanvasRenderingContext2D,\n161\t    interactables: Interactable[],\n162\t    ox: number,\n163\t    oy: number,\n164\t    scale: number,\n165\t    player: Player,\n166\t    now: number,\n167\t  ): void {\n168\t    const facing = player.getFacingTile();\n169\t\n170\t    for (const obj of interactables) {\n171\t      const px = ox + obj.x * scale;\n172\t      const py = oy + obj.y * scale;\n173\t      const pw = obj.width * scale;\n174\t      const ph = obj.height * scale;\n175\t\n176\t      const objGX = Math.floor(obj.x / 32);\n177\t      const objGY = Math.floor(obj.y / 32);\n178\t      const isFacing = facing.gx >= objGX && facing.gx <= objGX + Math.ceil(obj.width / 32) - 1 &&\n179\t        facing.gy >= objGY && facing.gy <= objGY + Math.ceil(obj.height / 32) - 1;\n180\t\n181\t      if (isFacing) {\n182\t        const pulse = 0.3 + Math.sin(now * 0.005) * 0.1;\n183\t        c.strokeStyle = `rgba(255, 255, 100, ${pulse})`;\n184\t        c.lineWidth = 2;\n185\t        c.strokeRect(px - 2, py - 2, pw + 4, ph + 4);\n186\t\n187\t        c.fillStyle = 'rgba(0,0,0,0.7)';\n188\t        const labelW = c.measureText(obj.label).width + 12;\n189\t        c.fillRect(px + pw / 2 - labelW / 2, py - 22, labelW, 18);\n190\t        c.fillStyle = '#ffdd66';\n191\t        c.font = `${Math.round(11)}px monospace`;\n192\t        c.textAlign = 'center';\n193\t        c.textBaseline = 'middle';\n194\t        c.fillText(obj.label, px + pw / 2, py - 13);\n195\t      }\n196\t    }\n197\t  }\n198\t\n199\t  private renderHUD(\n200\t    c: CanvasRenderingContext2D,\n201\t    canvasW: number,\n202\t    canvasH: number,\n203\t    state: GameState,\n204\t    player: Player,\n205\t    ctx?: RenderContext,\n206\t  ): void {\n207\t    // Top bar\n208\t    c.fillStyle = 'rgba(0,0,0,0.8)';\n209\t    c.fillRect(0, 0, canvasW, 44);\n210\t\n211\t    // Day counter\n212\t    c.fillStyle = '#e0d0b0';\n213\t    c.font = 'bold 13px monospace';\n214\t    c.textAlign = 'left';\n215\t    c.textBaseline = 'middle';\n216\t    c.fillText(`Day ${state.day}`, 12, 14);\n217\t\n218\t    // Time\n219\t    c.fillStyle = isNightTime(state.phase) ? '#8888cc' : '#ccaa66';\n220\t    c.font = '13px monospace';\n221\t    c.fillText(getTimeString(state.timeOfDay), 80, 14);\n222\t\n223\t    // Phase indicator\n224\t    const phaseLabels: Record<string, string> = {\n225\t      daytime: '营业中',\n226\t      night_transition: '准备打烊',\n227\t      night: '深夜营业',\n228\t      danger: '危险时段',\n229\t      dawn: '黎明',\n230\t    };\n231\t    c.fillStyle = state.phase === 'danger' ? '#ff4444' : '#aaa';\n232\t    c.font = '11px monospace';\n233\t    c.fillText(phaseLabels[state.phase] ?? state.phase, 160, 14);\n234\t\n235\t    // Money\n236\t    c.fillStyle = '#66cc66';\n237\t    c.font = '12px monospace';\n238\t    c.textAlign = 'right';\n239\t    c.fillText(`¥${state.money.toLocaleString()}`, canvasW - 12, 12);\n240\t\n241\t    // Debt\n242\t    c.fillStyle = '#cc6666';\n243\t    c.font = '10px monospace';\n244\t    c.fillText(`债务: ¥${state.debt.toLocaleString()}`, canvasW - 12, 26);\n245\t\n246\t    // Health bar\n247\t    c.textAlign = 'left';\n248\t    const hbX = 300;\n249\t    const hbY = 6;\n250\t    const hbW = 80;\n251\t    const hbH = 8;\n252\t    c.fillStyle = 'rgba(255,255,255,0.1)';\n253\t    c.fillRect(hbX, hbY, hbW, hbH);\n254\t    c.fillStyle = '#cc3333';\n255\t    c.fillRect(hbX, hbY, hbW * (state.player.health / 100), hbH);\n256\t    c.strokeStyle = 'rgba(255,255,255,0.2)';\n257\t    c.lineWidth = 1;\n258\t    c.strokeRect(hbX, hbY, hbW, hbH);\n259\t    c.fillStyle = '#aaa';\n260\t    c.font = '8px monospace';\n261\t    c.fillText('HP', hbX - 18, hbY + 7);\n262\t\n263\t    // Sanity bar\n264\t    const sbY = 18;\n265\t    c.fillStyle = 'rgba(255,255,255,0.1)';\n266\t    c.fillRect(hbX, sbY, hbW, hbH);\n267\t    c.fillStyle = '#6666cc';\n268\t    c.fillRect(hbX, sbY, hbW * (state.player.sanity / 100), hbH);\n269\t    c.strokeStyle = 'rgba(255,255,255,0.2)';\n270\t    c.strokeRect(hbX, sbY, hbW, hbH);\n271\t    c.fillStyle = '#aaa';\n272\t    c.fillText('SAN', hbX - 22, sbY + 7);\n273\t\n274\t    // Customer count\n275\t    if (ctx) {\n276\t      const custCount = ctx.customers.length;\n277\t      c.fillStyle = '#88aacc';\n278\t      c.font = '10px monospace';\n279\t      c.textAlign = 'left';\n280\t      c.fillText(`顾客: ${custCount}`, 420, 14);\n281\t    }\n282\t\n283\t    // Daily revenue\n284\t    c.fillStyle = '#88cc88';\n285\t    c.font = '10px monospace';\n286\t    c.textAlign = 'left';\n287\t    c.fillText(`今日: ¥${state.dailyRevenue.toFixed(0)}`, 500, 14);\n288\t\n289\t    // Shortcut hints\n290\t    c.fillStyle = 'rgba(255,255,255,0.4)';\n291\t    c.font = '10px monospace';\n292\t    c.textAlign = 'center';\n293\t    c.fillText('WASD 移动 | E 交互 | I 库存 | P 定价 | U 升级 | O 进货 | ESC 关闭', canvasW / 2, canvasH - 12);\n294\t\n295\t    // Notifications\n296\t    this.renderNotifications(c, canvasW, canvasH, state);\n297\t\n298\t    // Register status\n299\t    if (ctx) {\n300\t      this.renderRegisterStatus(c, canvasW, ctx.registers);\n301\t    }\n302\t  }\n303\t\n304\t  private renderNotifications(\n305\t    c: CanvasRenderingContext2D,\n306\t    w: number,\n307\t    h: number,\n308\t    state: GameState,\n309\t  ): void {\n310\t    const recent = state.notifications.slice(-5);\n311\t    if (recent.length === 0) return;\n312\t\n313\t    c.textAlign = 'right';\n314\t    c.font = '10px monospace';\n315\t    for (let i = 0; i < recent.length; i++) {\n316\t      const alpha = 0.3 + (i / recent.length) * 0.5;\n317\t      c.fillStyle = `rgba(200, 220, 255, ${alpha})`;\n318\t      c.fillText(recent[i], w - 12, h - 30 - (recent.length - 1 - i) * 14);\n319\t    }\n320\t  }\n321\t\n322\t  private renderRegisterStatus(\n323\t    c: CanvasRenderingContext2D,\n324\t    canvasW: number,\n325\t    registers: CashRegister[],\n326\t  ): void {\n327\t    let x = 12;\n328\t    const y = 48;\n329\t    for (const reg of registers) {\n330\t      const stateLabels: Record<string, string> = {\n331\t        idle: '空闲',\n332\t        scanning: '扫描中...',\n333\t        payment: '付款中',\n334\t        giving_change: '找零中',\n335\t        receipt: '打印收据',\n336\t        anomaly: '异常!',\n337\t      };\n338\t      const stateColors: Record<string, string> = {\n339\t        idle: '#666',\n340\t        scanning: '#6a6',\n341\t        payment: '#aa6',\n342\t        giving_change: '#6aa',\n343\t        receipt: '#66a',\n344\t        anomaly: '#a44',\n345\t      };\n346\t      const label = stateLabels[reg.state] ?? reg.state;\n347\t      const color = stateColors[reg.state] ?? '#666';\n348\t\n349\t      c.fillStyle = 'rgba(0,0,0,0.6)';\n350\t      c.fillRect(x, y, 80, 16);\n351\t      c.fillStyle = color;\n352\t      c.font = '9px monospace';\n353\t      c.textAlign = 'left';\n354\t      c.textBaseline = 'middle';\n355\t      c.fillText(`${reg.registerId}: ${label}`, x + 4, y + 8);\n356\t      x += 84;\n357\t    }\n358\t  }\n359\t\n360\t  private renderPanel(\n361\t    c: CanvasRenderingContext2D,\n362\t    w: number,\n363\t    h: number,\n364\t    state: GameState,\n365\t    ctx: RenderContext,\n366\t  ): void {\n367\t    // Darken background\n368\t    c.fillStyle = 'rgba(0,0,0,0.5)';\n369\t    c.fillRect(0, 0, w, h);\n370\t\n371\t    const panelW = Math.min(500, w - 40);\n372\t    const panelH = Math.min(400, h - 80);\n373\t    const px = (w - panelW) / 2;\n374\t    const py = (h - panelH) / 2;\n375\t\n376\t    // Panel background\n377\t    c.fillStyle = 'rgba(20, 20, 35, 0.95)';\n378\t    c.fillRect(px, py, panelW, panelH);\n379\t    c.strokeStyle = 'rgba(100, 120, 160, 0.5)';\n380\t    c.lineWidth = 1;\n381\t    c.strokeRect(px, py, panelW, panelH);\n382\t\n383\t    // Title bar\n384\t    c.fillStyle = 'rgba(40, 40, 60, 0.9)';\n385\t    c.fillRect(px, py, panelW, 30);\n386\t\n387\t    switch (state.activePanel) {\n388\t      case UIPanel.SHELF:\n389\t        this.renderShelfPanel(c, px, py, panelW, panelH, ctx);\n390\t        break;\n391\t      case UIPanel.INVENTORY:\n392\t        this.renderInventoryPanel(c, px, py, panelW, panelH, ctx);\n393\t        break;\n394\t      case UIPanel.PRICING:\n395\t        this.renderPricingPanel(c, px, py, panelW, panelH, ctx);\n396\t        break;\n397\t      case UIPanel.SHOP:\n398\t        this.renderShopPanel(c, px, py, panelW, panelH, ctx);\n399\t        break;\n400\t      case UIPanel.SUPPLIER:\n401\t        this.renderSupplierPanel(c, px, py, panelW, panelH, state, ctx);\n402\t        break;\n403\t    }\n404\t\n405\t    // Close button hint\n406\t    c.fillStyle = 'rgba(255,255,255,0.4)';\n407\t    c.font = '10px monospace';\n408\t    c.textAlign = 'center';\n409\t    c.fillText('按 ESC 或 E 关闭', w / 2, py + panelH + 15);\n410\t  }\n411\t\n412\t  private renderShelfPanel(\n413\t    c: CanvasRenderingContext2D,\n414\t    px: number, py: number,\n415\t    pw: number, ph: number,\n416\t    ctx: RenderContext,\n417\t  ): void {\n418\t    const shelf = ctx.shelfInteraction;\n419\t    if (!shelf.currentShelfId) return;\n420\t\n421\t    c.fillStyle = '#e0d0b0';\n422\t    c.font = 'bold 14px monospace';\n423\t    c.textAlign = 'left';\n424\t    c.textBaseline = 'top';\n425\t    c.fillText('货架管理', px + 10, py + 8);\n426\t\n427\t    const slot = ctx.productManager.shelfSlots.get(shelf.currentShelfId);\n428\t    if (!slot) return;\n429\t\n430\t    let y = py + 40;\n431\t\n432\t    if (slot.productId && slot.quantity > 0) {\n433\t      const product = ctx.productManager.getProduct(slot.productId);\n434\t      c.fillStyle = '#aac';\n435\t      c.font = '12px monospace';\n436\t      c.fillText(`商品: ${product?.name ?? slot.productId}`, px + 10, y);\n437\t      y += 18;\n438\t      c.fillText(`库存: ${slot.quantity}/${slot.maxQuantity}`, px + 10, y);\n439\t      y += 18;\n440\t      const price = ctx.pricing.getPrice(slot.productId);\n441\t      c.fillText(`售价: ¥${price.toFixed(2)}`, px + 10, y);\n442\t      y += 30;\n443\t    } else {\n444\t      c.fillStyle = '#888';\n445\t      c.font = '12px monospace';\n446\t      c.fillText('空货架', px + 10, y);\n447\t      y += 30;\n448\t    }\n449\t\n450\t    // Available products to stock\n451\t    c.fillStyle = '#ccc';\n452\t    c.font = '11px monospace';\n453\t    c.fillText('可上架商品:', px + 10, y);\n454\t    y += 18;\n455\t\n456\t    const available = shelf.getAvailableProductsForShelf(shelf.currentShelfId, ctx.productManager);\n457\t    for (let i = 0; i < Math.min(available.length, 8); i++) {\n458\t      const item = available[i];\n459\t      c.fillStyle = '#aab8cc';\n460\t      c.font = '11px monospace';\n461\t      c.fillText(`  ${item.name} x${item.quantity}`, px + 10, y);\n462\t      y += 16;\n463\t    }\n464\t\n465\t    if (available.length === 0) {\n466\t      c.fillStyle = '#666';\n467\t      c.fillText('  (无库存)', px + 10, y);\n468\t    }\n469\t  }\n470\t\n471\t  private renderInventoryPanel(\n472\t    c: CanvasRenderingContext2D,\n473\t    px: number, py: number,\n474\t    pw: number, ph: number,\n475\t    ctx: RenderContext,\n476\t  ): void {\n477\t    c.fillStyle = '#e0d0b0';\n478\t    c.font = 'bold 14px monospace';\n479\t    c.textAlign = 'left';\n480\t    c.textBaseline = 'top';\n481\t    c.fillText('库存管理', px + 10, py + 8);\n482\t\n483\t    let y = py + 40;\n484\t    c.fillStyle = '#aaa';\n485\t    c.font = '10px monospace';\n486\t    c.fillText(`仓库容量: ${ctx.productManager.storageUsed}/${ctx.productManager.storageCapacity}`, px + 10, y);\n487\t    y += 20;\n488\t\n489\t    for (const [id, item] of ctx.productManager.inventory) {\n490\t      if (item.quantity <= 0) continue;\n491\t      const product = ctx.productManager.getProduct(id);\n492\t      const price = ctx.pricing.getPrice(id);\n493\t      c.fillStyle = '#bbb';\n494\t      c.font = '11px monospace';\n495\t      c.fillText(`${product?.name ?? id}  x${item.quantity}  ¥${price.toFixed(2)}/个`, px + 10, y);\n496\t      y += 16;\n497\t      if (y > py + ph - 30) break;\n498\t    }\n499\t  }\n500\t\n501\t  private renderPricingPanel(\n502\t    c: CanvasRenderingContext2D,\n503\t    px: number, py: number,\n504\t    pw: number, ph: number,\n505\t    ctx: RenderContext,\n506\t  ): void {\n507\t    c.fillStyle = '#e0d0b0';\n508\t    c.font = 'bold 14px monospace';\n509\t    c.textAlign = 'left';\n510\t    c.textBaseline = 'top';\n511\t    c.fillText('定价管理', px + 10, py + 8);\n512\t\n513\t    let y = py + 40;\n514\t    const prices = ctx.pricing.getAllPrices();\n515\t\n516\t    c.fillStyle = '#888';\n517\t    c.font = '10px monospace';\n518\t    c.fillText('商品           基价      现价      范围', px + 10, y);\n519\t    y += 16;\n520\t\n521\t    for (const entry of prices) {\n522\t      const product = ctx.productManager.getProduct(entry.productId);\n523\t      if (!product) continue;\n524\t      c.fillStyle = '#bbb';\n525\t      c.font = '10px monospace';\n526\t      const name = product.name.padEnd(8, '　');\n527\t      c.fillText(\n528\t        `${name}  ¥${entry.basePrice.toFixed(0).padStart(3)}   ¥${entry.currentPrice.toFixed(0).padStart(3)}   ${entry.minPrice.toFixed(0)}-${entry.maxPrice.toFixed(0)}`,\n529\t        px + 10, y,\n530\t      );\n531\t      y += 14;\n532\t      if (y > py + ph - 30) break;\n533\t    }\n534\t  }\n535\t\n536\t  private renderShopPanel(\n537\t    c: CanvasRenderingContext2D,\n538\t    px: number, py: number,\n539\t    pw: number, ph: number,\n540\t    ctx: RenderContext,\n541\t  ): void {\n542\t    c.fillStyle = '#e0d0b0';\n543\t    c.font = 'bold 14px monospace';\n544\t    c.textAlign = 'left';\n545\t    c.textBaseline = 'top';\n546\t    c.fillText('店铺升级', px + 10, py + 8);\n547\t\n548\t    let y = py + 40;\n549\t    const upgrades = ctx.upgradeManager\n550\t      ? ctx.upgradeManager.getUpgrades()\n551\t      : ctx.economy.getUpgrades();\n552\t\n553\t    for (const upgrade of upgrades) {\n554\t      const owned = ctx.upgradeManager\n555\t        ? ctx.upgradeManager.isPurchased(upgrade.id)\n556\t        : ctx.economy.hasUpgrade(upgrade.id);\n557\t      c.fillStyle = owned ? '#5a7a5a' : '#bbb';\n558\t      c.font = '11px monospace';\n559\t      c.fillText(\n560\t        `${owned ? '[已购]' : `¥${upgrade.cost}`.padStart(6)} ${upgrade.name} — ${upgrade.description}`,\n561\t        px + 10, y,\n562\t      );\n563\t      y += 16;\n564\t      c.fillStyle = '#777';\n565\t      c.font = '9px monospace';\n566\t      c.fillText(`  ${upgrade.horrorLink}`, px + 10, y);\n567\t      y += 14;\n568\t      if (y > py + ph - 30) break;\n569\t    }\n570\t  }\n571\t\n572\t  private renderSupplierPanel(\n573\t    c: CanvasRenderingContext2D,\n574\t    px: number, py: number,\n575\t    pw: number, ph: number,\n576\t    state: GameState,\n577\t    ctx: RenderContext,\n578\t  ): void {\n579\t    c.fillStyle = '#e0d0b0';\n580\t    c.font = 'bold 14px monospace';\n581\t    c.textAlign = 'left';\n582\t    c.textBaseline = 'top';\n583\t    c.fillText('进货管理', px + 10, py + 8);\n584\t\n585\t    let y = py + 40;\n586\t\n587\t    // Show suppliers\n588\t    const isNight = isNightTime(state.phase);\n589\t    const suppliers = ctx.productManager.getUnlockedSuppliers(state.day, isNight);\n590\t    c.fillStyle = '#888';\n591\t    c.font = '10px monospace';\n592\t    c.fillText('可用供应商:', px + 10, y);\n593\t    y += 16;\n594\t\n595\t    for (const supplier of suppliers) {\n596\t      c.fillStyle = '#aab8cc';\n597\t      c.font = '11px monospace';\n598\t      c.fillText(`${supplier.name} — ${supplier.description}`, px + 10, y);\n599\t      y += 14;\n600\t      c.fillStyle = '#777';\n601\t      c.font = '9px monospace';\n602\t      c.fillText(`  价格x${supplier.priceMultiplier} 可靠度${Math.round(supplier.reliability * 100)}%`, px + 10, y);\n603\t      y += 16;\n604\t    }\n605\t\n606\t    y += 10;\n607\t\n608\t    // Pending orders\n609\t    if (ctx.productManager.pendingOrders.length > 0) {\n610\t      c.fillStyle = '#888';\n611\t      c.font = '10px monospace';\n612\t      c.fillText('待到货订单:', px + 10, y);\n613\t      y += 16;\n614\t\n615\t      for (const order of ctx.productManager.pendingOrders) {\n616\t        const product = ctx.productManager.getProduct(order.productId);\n617\t        c.fillStyle = '#cc9';\n618\t        c.font = '10px monospace';\n619\t        c.fillText(`${product?.name ?? order.productId} x${order.quantity} — ¥${order.totalCost} (Day ${order.arrivalDay}到)`, px + 10, y);\n620\t        y += 14;\n621\t        if (y > py + ph - 30) break;\n622\t      }\n623\t    }\n624\t  }\n625\t\n626\t  destroy(): void {}\n627\t}\n628\t"}]},"parent_tool_use_id":null,"session_id":"392f64db-fdde-44d3-ac09-12e89ef6a334","uuid":"79eaad9b-ad66-4a37-bce1-1a08f2dd08dd","timestamp":"2026-05-23T04:48:31.275Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-horror-sim\\src\\renderer\\Renderer.ts","content":"// Renderer.ts — Canvas 2D rendering system (v0.2.0 — M2)\n\nimport { Camera } from './Camera';\nimport { StoreMap, T } from '../game/StoreMap';\nimport { Player } from '../game/Player';\nimport { Lighting } from './Lighting';\nimport {\n  type GameState,\n  type GamePhase,\n  type LightSource,\n  type Interactable,\n  GamePhase as GP,\n  UIPanel,\n  getTimeString,\n  isNightTime,\n} from '../game/GameState';\nimport { Customer } from '../game/Customer';\nimport { ProductManager } from '../game/ProductManager';\nimport { ShelfInteraction, ShelfAction } from '../game/ShelfInteraction';\nimport { CashRegister, RegisterState } from '../game/CashRegister';\nimport { EconomySystem } from '../game/EconomySystem';\nimport { PricingSystem } from '../game/PricingSystem';\nimport { DaySummaryManager } from '../game/DaySummary';\nimport { UpgradeManager } from '../game/UpgradeManager';\n\nexport interface RenderContext {\n  customers: Customer[];\n  productManager: ProductManager;\n  shelfInteraction: ShelfInteraction;\n  registers: CashRegister[];\n  economy: EconomySystem;\n  pricing: PricingSystem;\n  lastTransaction: string;\n  daySummary?: DaySummaryManager;\n  upgradeManager?: UpgradeManager;\n}\n\nexport class Renderer {\n  canvas: HTMLCanvasElement;\n  ctx: CanvasRenderingContext2D;\n  camera: Camera;\n  lighting: Lighting;\n\n  constructor(canvas: HTMLCanvasElement) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d')!;\n    this.camera = new Camera(canvas);\n    this.lighting = new Lighting();\n    this.resize();\n    this.camera.setupZoom(canvas);\n  }\n\n  resize(): void {\n    const dpr = window.devicePixelRatio || 1;\n    const rect = this.canvas.getBoundingClientRect();\n    this.canvas.width = rect.width * dpr;\n    this.canvas.height = rect.height * dpr;\n    this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n  }\n\n  render(\n    map: StoreMap,\n    player: Player,\n    state: GameState,\n    now: number,\n    ctx?: RenderContext,\n  ): void {\n    const c = this.ctx;\n    const w = this.canvas.getBoundingClientRect().width;\n    const h = this.canvas.getBoundingClientRect().height;\n\n    const bgPhase = state.phase;\n    if (bgPhase === 'danger') {\n      c.fillStyle = '#0a0a15';\n    } else if (isNightTime(bgPhase)) {\n      c.fillStyle = '#0f1020';\n    } else {\n      c.fillStyle = '#1a1520';\n    }\n    c.fillRect(0, 0, w, h);\n\n    const { offsetX, offsetY, scale } = this.camera.getTransform();\n\n    // Render map tiles\n    map.render(c, offsetX, offsetY, w, h, scale);\n\n    // Render shelf product indicators\n    if (ctx) {\n      this.renderShelfIndicators(c, ctx.productManager, state.interactables, offsetX, offsetY, scale);\n    }\n\n    // Render interactable highlights\n    this.renderInteractables(c, state.interactables, offsetX, offsetY, scale, player, now);\n\n    // Render customers\n    if (ctx) {\n      for (const customer of ctx.customers) {\n        customer.render(c, offsetX, offsetY, scale);\n      }\n    }\n\n    // Render player\n    player.render(c, offsetX, offsetY, scale);\n\n    // Render lighting overlay (M3: pass timeOfDay for gradual transitions)\n    this.lighting.render(c, w, h, state.lights, state.phase, offsetX, offsetY, scale, now, state.timeOfDay);\n\n    // Render HUD\n    this.renderHUD(c, w, h, state, player, ctx);\n\n    // Render active panel\n    if (ctx && state.activePanel !== UIPanel.NONE) {\n      this.renderPanel(c, w, h, state, ctx);\n    }\n\n    // M3: Render day summary overlay\n    if (ctx?.daySummary) {\n      ctx.daySummary.render(c, w, h);\n    }\n  }\n\n  private renderShelfIndicators(\n    c: CanvasRenderingContext2D,\n    pm: ProductManager,\n    interactables: Interactable[],\n    ox: number,\n    oy: number,\n    scale: number,\n  ): void {\n    for (const inter of interactables) {\n      if (inter.type !== 'shelf' && inter.type !== 'fridge') continue;\n      const slot = pm.shelfSlots.get(inter.id);\n      if (!slot || !slot.productId || slot.quantity <= 0) continue;\n\n      const product = pm.getProduct(slot.productId);\n      if (!product) continue;\n\n      const px = ox + inter.x * scale;\n      const py = oy + (inter.y - 8) * scale;\n      const pw = inter.width * scale;\n\n      // Stock level bar\n      const ratio = slot.quantity / slot.maxQuantity;\n      const barColor = ratio > 0.5 ? '#66aa66' : ratio > 0.2 ? '#aaaa44' : '#aa4444';\n      c.fillStyle = 'rgba(0,0,0,0.5)';\n      c.fillRect(px, py, pw, 6 * scale);\n      c.fillStyle = barColor;\n      c.fillRect(px, py, pw * ratio, 6 * scale);\n\n      // Product name\n      c.fillStyle = 'rgba(255,255,255,0.7)';\n      c.font = `${Math.round(8 * scale)}px monospace`;\n      c.textAlign = 'center';\n      c.textBaseline = 'top';\n      c.fillText(`${product.name}(${slot.quantity})`, px + pw / 2, py + 7 * scale);\n    }\n  }\n\n  private renderInteractables(\n    c: CanvasRenderingContext2D,\n    interactables: Interactable[],\n    ox: number,\n    oy: number,\n    scale: number,\n    player: Player,\n    now: number,\n  ): void {\n    const facing = player.getFacingTile();\n\n    for (const obj of interactables) {\n      const px = ox + obj.x * scale;\n      const py = oy + obj.y * scale;\n      const pw = obj.width * scale;\n      const ph = obj.height * scale;\n\n      const objGX = Math.floor(obj.x / 32);\n      const objGY = Math.floor(obj.y / 32);\n      const isFacing = facing.gx >= objGX && facing.gx <= objGX + Math.ceil(obj.width / 32) - 1 &&\n        facing.gy >= objGY && facing.gy <= objGY + Math.ceil(obj.height / 32) - 1;\n\n      if (isFacing) {\n        const pulse = 0.3 + Math.sin(now * 0.005) * 0.1;\n        c.strokeStyle = `rgba(255, 255, 100, ${pulse})`;\n        c.lineWidth = 2;\n        c.strokeRect(px - 2, py - 2, pw + 4, ph + 4);\n\n        c.fillStyle = 'rgba(0,0,0,0.7)';\n        const labelW = c.measureText(obj.label).width + 12;\n        c.fillRect(px + pw / 2 - labelW / 2, py - 22, labelW, 18);\n        c.fillStyle = '#ffdd66';\n        c.font = `${Math.round(11)}px monospace`;\n        c.textAlign = 'center';\n        c.textBaseline = 'middle';\n        c.fillText(obj.label, px + pw / 2, py - 13);\n      }\n    }\n  }\n\n  private renderHUD(\n    c: CanvasRenderingContext2D,\n    canvasW: number,\n    canvasH: number,\n    state: GameState,\n    player: Player,\n    ctx?: RenderContext,\n  ): void {\n    // Top bar\n    c.fillStyle = 'rgba(0,0,0,0.8)';\n    c.fillRect(0, 0, canvasW, 44);\n\n    // Day counter\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 13px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'middle';\n    c.fillText(`Day ${state.day}`, 12, 14);\n\n    // Time\n    c.fillStyle = isNightTime(state.phase) ? '#8888cc' : '#ccaa66';\n    c.font = '13px monospace';\n    c.fillText(getTimeString(state.timeOfDay), 80, 14);\n\n    // Phase indicator\n    const phaseLabels: Record<string, string> = {\n      daytime: '营业中',\n      night_transition: '准备打烊',\n      night: '深夜营业',\n      danger: '危险时段',\n      dawn: '黎明',\n    };\n    c.fillStyle = state.phase === 'danger' ? '#ff4444' : '#aaa';\n    c.font = '11px monospace';\n    c.fillText(phaseLabels[state.phase] ?? state.phase, 160, 14);\n\n    // Money\n    c.fillStyle = '#66cc66';\n    c.font = '12px monospace';\n    c.textAlign = 'right';\n    c.fillText(`¥${state.money.toLocaleString()}`, canvasW - 12, 12);\n\n    // Debt\n    c.fillStyle = '#cc6666';\n    c.font = '10px monospace';\n    c.fillText(`债务: ¥${state.debt.toLocaleString()}`, canvasW - 12, 26);\n\n    // Health bar\n    c.textAlign = 'left';\n    const hbX = 300;\n    const hbY = 6;\n    const hbW = 80;\n    const hbH = 8;\n    c.fillStyle = 'rgba(255,255,255,0.1)';\n    c.fillRect(hbX, hbY, hbW, hbH);\n    c.fillStyle = '#cc3333';\n    c.fillRect(hbX, hbY, hbW * (state.player.health / 100), hbH);\n    c.strokeStyle = 'rgba(255,255,255,0.2)';\n    c.lineWidth = 1;\n    c.strokeRect(hbX, hbY, hbW, hbH);\n    c.fillStyle = '#aaa';\n    c.font = '8px monospace';\n    c.fillText('HP', hbX - 18, hbY + 7);\n\n    // Sanity bar\n    const sbY = 18;\n    c.fillStyle = 'rgba(255,255,255,0.1)';\n    c.fillRect(hbX, sbY, hbW, hbH);\n    c.fillStyle = '#6666cc';\n    c.fillRect(hbX, sbY, hbW * (state.player.sanity / 100), hbH);\n    c.strokeStyle = 'rgba(255,255,255,0.2)';\n    c.strokeRect(hbX, sbY, hbW, hbH);\n    c.fillStyle = '#aaa';\n    c.fillText('SAN', hbX - 22, sbY + 7);\n\n    // Customer count\n    if (ctx) {\n      const custCount = ctx.customers.length;\n      c.fillStyle = '#88aacc';\n      c.font = '10px monospace';\n      c.textAlign = 'left';\n      c.fillText(`顾客: ${custCount}`, 420, 14);\n    }\n\n    // Daily revenue\n    c.fillStyle = '#88cc88';\n    c.font = '10px monospace';\n    c.textAlign = 'left';\n    c.fillText(`今日: ¥${state.dailyRevenue.toFixed(0)}`, 500, 14);\n\n    // Shortcut hints\n    c.fillStyle = 'rgba(255,255,255,0.4)';\n    c.font = '10px monospace';\n    c.textAlign = 'center';\n    c.fillText('WASD 移动 | E 交互 | I 库存 | P 定价 | U 升级 | O 进货 | ESC 关闭', canvasW / 2, canvasH - 12);\n\n    // Notifications\n    this.renderNotifications(c, canvasW, canvasH, state);\n\n    // Register status\n    if (ctx) {\n      this.renderRegisterStatus(c, canvasW, ctx.registers);\n    }\n  }\n\n  private renderNotifications(\n    c: CanvasRenderingContext2D,\n    w: number,\n    h: number,\n    state: GameState,\n  ): void {\n    const recent = state.notifications.slice(-5);\n    if (recent.length === 0) return;\n\n    c.textAlign = 'right';\n    c.font = '10px monospace';\n    for (let i = 0; i < recent.length; i++) {\n      const alpha = 0.3 + (i / recent.length) * 0.5;\n      c.fillStyle = `rgba(200, 220, 255, ${alpha})`;\n      c.fillText(recent[i], w - 12, h - 30 - (recent.length - 1 - i) * 14);\n    }\n  }\n\n  private renderRegisterStatus(\n    c: CanvasRenderingContext2D,\n    canvasW: number,\n    registers: CashRegister[],\n  ): void {\n    let x = 12;\n    const y = 48;\n    for (const reg of registers) {\n      const stateLabels: Record<string, string> = {\n        idle: '空闲',\n        scanning: '扫描中...',\n        payment: '付款中',\n        giving_change: '找零中',\n        receipt: '打印收据',\n        anomaly: '异常!',\n      };\n      const stateColors: Record<string, string> = {\n        idle: '#666',\n        scanning: '#6a6',\n        payment: '#aa6',\n        giving_change: '#6aa',\n        receipt: '#66a',\n        anomaly: '#a44',\n      };\n      const label = stateLabels[reg.state] ?? reg.state;\n      const color = stateColors[reg.state] ?? '#666';\n\n      c.fillStyle = 'rgba(0,0,0,0.6)';\n      c.fillRect(x, y, 80, 16);\n      c.fillStyle = color;\n      c.font = '9px monospace';\n      c.textAlign = 'left';\n      c.textBaseline = 'middle';\n      c.fillText(`${reg.registerId}: ${label}`, x + 4, y + 8);\n      x += 84;\n    }\n  }\n\n  private renderPanel(\n    c: CanvasRenderingContext2D,\n    w: number,\n    h: number,\n    state: GameState,\n    ctx: RenderContext,\n  ): void {\n    // Darken background\n    c.fillStyle = 'rgba(0,0,0,0.5)';\n    c.fillRect(0, 0, w, h);\n\n    const panelW = Math.min(500, w - 40);\n    const panelH = Math.min(400, h - 80);\n    const px = (w - panelW) / 2;\n    const py = (h - panelH) / 2;\n\n    // Panel background\n    c.fillStyle = 'rgba(20, 20, 35, 0.95)';\n    c.fillRect(px, py, panelW, panelH);\n    c.strokeStyle = 'rgba(100, 120, 160, 0.5)';\n    c.lineWidth = 1;\n    c.strokeRect(px, py, panelW, panelH);\n\n    // Title bar\n    c.fillStyle = 'rgba(40, 40, 60, 0.9)';\n    c.fillRect(px, py, panelW, 30);\n\n    switch (state.activePanel) {\n      case UIPanel.SHELF:\n        this.renderShelfPanel(c, px, py, panelW, panelH, ctx);\n        break;\n      case UIPanel.INVENTORY:\n        this.renderInventoryPanel(c, px, py, panelW, panelH, ctx);\n        break;\n      case UIPanel.PRICING:\n        this.renderPricingPanel(c, px, py, panelW, panelH, ctx);\n        break;\n      case UIPanel.SHOP:\n        this.renderShopPanel(c, px, py, panelW, panelH, ctx);\n        break;\n      case UIPanel.SUPPLIER:\n        this.renderSupplierPanel(c, px, py, panelW, panelH, state, ctx);\n        break;\n    }\n\n    // Close button hint\n    c.fillStyle = 'rgba(255,255,255,0.4)';\n    c.font = '10px monospace';\n    c.textAlign = 'center';\n    c.fillText('按 ESC 或 E 关闭', w / 2, py + panelH + 15);\n  }\n\n  private renderShelfPanel(\n    c: CanvasRenderingContext2D,\n    px: number, py: number,\n    pw: number, ph: number,\n    ctx: RenderContext,\n  ): void {\n    const shelf = ctx.shelfInteraction;\n    if (!shelf.currentShelfId) return;\n\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 14px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'top';\n    c.fillText('货架管理', px + 10, py + 8);\n\n    const slot = ctx.productManager.shelfSlots.get(shelf.currentShelfId);\n    if (!slot) return;\n\n    let y = py + 40;\n\n    if (slot.productId && slot.quantity > 0) {\n      const product = ctx.productManager.getProduct(slot.productId);\n      c.fillStyle = '#aac';\n      c.font = '12px monospace';\n      c.fillText(`商品: ${product?.name ?? slot.productId}`, px + 10, y);\n      y += 18;\n      c.fillText(`库存: ${slot.quantity}/${slot.maxQuantity}`, px + 10, y);\n      y += 18;\n      const price = ctx.pricing.getPrice(slot.productId);\n      c.fillText(`售价: ¥${price.toFixed(2)}`, px + 10, y);\n      y += 30;\n    } else {\n      c.fillStyle = '#888';\n      c.font = '12px monospace';\n      c.fillText('空货架', px + 10, y);\n      y += 30;\n    }\n\n    // Available products to stock\n    c.fillStyle = '#ccc';\n    c.font = '11px monospace';\n    c.fillText('可上架商品:', px + 10, y);\n    y += 18;\n\n    const available = shelf.getAvailableProductsForShelf(shelf.currentShelfId, ctx.productManager);\n    for (let i = 0; i < Math.min(available.length, 8); i++) {\n      const item = available[i];\n      c.fillStyle = '#aab8cc';\n      c.font = '11px monospace';\n      c.fillText(`  ${item.name} x${item.quantity}`, px + 10, y);\n      y += 16;\n    }\n\n    if (available.length === 0) {\n      c.fillStyle = '#666';\n      c.fillText('  (无库存)', px + 10, y);\n    }\n  }\n\n  private renderInventoryPanel(\n    c: CanvasRenderingContext2D,\n    px: number, py: number,\n    pw: number, ph: number,\n    ctx: RenderContext,\n  ): void {\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 14px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'top';\n    c.fillText('库存管理', px + 10, py + 8);\n\n    let y = py + 40;\n    c.fillStyle = '#aaa';\n    c.font = '10px monospace';\n    c.fillText(`仓库容量: ${ctx.productManager.storageUsed}/${ctx.productManager.storageCapacity}`, px + 10, y);\n    y += 20;\n\n    for (const [id, item] of ctx.productManager.inventory) {\n      if (item.quantity <= 0) continue;\n      const product = ctx.productManager.getProduct(id);\n      const price = ctx.pricing.getPrice(id);\n      c.fillStyle = '#bbb';\n      c.font = '11px monospace';\n      c.fillText(`${product?.name ?? id}  x${item.quantity}  ¥${price.toFixed(2)}/个`, px + 10, y);\n      y += 16;\n      if (y > py + ph - 30) break;\n    }\n  }\n\n  private renderPricingPanel(\n    c: CanvasRenderingContext2D,\n    px: number, py: number,\n    pw: number, ph: number,\n    ctx: RenderContext,\n  ): void {\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 14px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'top';\n    c.fillText('定价管理', px + 10, py + 8);\n\n    let y = py + 40;\n    const prices = ctx.pricing.getAllPrices();\n\n    c.fillStyle = '#888';\n    c.font = '10px monospace';\n    c.fillText('商品           基价      现价      范围', px + 10, y);\n    y += 16;\n\n    for (const entry of prices) {\n      const product = ctx.productManager.getProduct(entry.productId);\n      if (!product) continue;\n      c.fillStyle = '#bbb';\n      c.font = '10px monospace';\n      const name = product.name.padEnd(8, '　');\n      c.fillText(\n        `${name}  ¥${entry.basePrice.toFixed(0).padStart(3)}   ¥${entry.currentPrice.toFixed(0).padStart(3)}   ${entry.minPrice.toFixed(0)}-${entry.maxPrice.toFixed(0)}`,\n        px + 10, y,\n      );\n      y += 14;\n      if (y > py + ph - 30) break;\n    }\n  }\n\n  private renderShopPanel(\n    c: CanvasRenderingContext2D,\n    px: number, py: number,\n    pw: number, ph: number,\n    ctx: RenderContext,\n  ): void {\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 14px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'top';\n    c.fillText('店铺升级', px + 10, py + 8);\n\n    let y = py + 40;\n    const upgrades = ctx.upgradeManager\n      ? ctx.upgradeManager.getUpgrades()\n      : ctx.economy.getUpgrades();\n\n    for (const upgrade of upgrades) {\n      const owned = ctx.upgradeManager\n        ? ctx.upgradeManager.isPurchased(upgrade.id)\n        : ctx.economy.hasUpgrade(upgrade.id);\n      c.fillStyle = owned ? '#5a7a5a' : '#bbb';\n      c.font = '11px monospace';\n      c.fillText(\n        `${owned ? '[已购]' : `¥${upgrade.cost}`.padStart(6)} ${upgrade.name} — ${upgrade.description}`,\n        px + 10, y,\n      );\n      y += 16;\n      c.fillStyle = '#777';\n      c.font = '9px monospace';\n      c.fillText(`  ${upgrade.horrorLink}`, px + 10, y);\n      y += 14;\n      if (y > py + ph - 30) break;\n    }\n  }\n\n  private renderSupplierPanel(\n    c: CanvasRenderingContext2D,\n    px: number, py: number,\n    pw: number, ph: number,\n    state: GameState,\n    ctx: RenderContext,\n  ): void {\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 14px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'top';\n    c.fillText('进货管理', px + 10, py + 8);\n\n    let y = py + 40;\n\n    // Show suppliers\n    const isNight = isNightTime(state.phase);\n    const suppliers = ctx.productManager.getUnlockedSuppliers(state.day, isNight);\n    c.fillStyle = '#888';\n    c.font = '10px monospace';\n    c.fillText('可用供应商:', px + 10, y);\n    y += 16;\n\n    for (const supplier of suppliers) {\n      c.fillStyle = '#aab8cc';\n      c.font = '11px monospace';\n      c.fillText(`${supplier.name} — ${supplier.description}`, px + 10, y);\n      y += 14;\n      c.fillStyle = '#777';\n      c.font = '9px monospace';\n      c.fillText(`  价格x${supplier.priceMultiplier} 可靠度${Math.round(supplier.reliability * 100)}%`, px + 10, y);\n      y += 16;\n    }\n\n    y += 10;\n\n    // Pending orders\n    if (ctx.productManager.pendingOrders.length > 0) {\n      c.fillStyle = '#888';\n      c.font = '10px monospace';\n      c.fillText('待到货订单:', px + 10, y);\n      y += 16;\n\n      for (const order of ctx.productManager.pendingOrders) {\n        const product = ctx.productManager.getProduct(order.productId);\n        c.fillStyle = '#cc9';\n        c.font = '10px monospace';\n        c.fillText(`${product?.name ?? order.productId} x${order.quantity} — ¥${order.totalCost} (Day ${order.arrivalDay}到)`, px + 10, y);\n        y += 14;\n        if (y > py + ph - 30) break;\n      }\n    }\n  }\n\n  destroy(): void {}\n}\n","numLines":628,"startLine":1,"totalLines":628}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_b093385311d1429b9ad98260","type":"tool_result","content":"1\t// Customer.ts — Individual customer entity with behavior AI (M2)\n2\t\n3\texport enum CustomerType {\n4\t  COMMUTER = 'commuter',\n5\t  LUNCH = 'lunch',\n6\t  STUDENT = 'student',\n7\t  RESIDENT = 'resident',\n8\t  NIGHT = 'night',\n9\t}\n10\t\n11\texport enum CustomerState {\n12\t  ENTERING = 'entering',\n13\t  WALKING_TO_SHELF = 'walking_to_shelf',\n14\t  BROWSING = 'browsing',\n15\t  PICKING = 'picking',\n16\t  WALKING_TO_REGISTER = 'walking_to_register',\n17\t  WAITING_IN_LINE = 'waiting_in_line',\n18\t  CHECKING_OUT = 'checking_out',\n19\t  WALKING_TO_EXIT = 'walking_to_exit',\n20\t  LEAVING = 'leaving',\n21\t  FLED = 'fled',\n22\t}\n23\t\n24\texport interface CartItem {\n25\t  productId: string;\n26\t  price: number;\n27\t}\n28\t\n29\texport interface CustomerDef {\n30\t  type: CustomerType;\n31\t  name: string;\n32\t  speed: number;\n33\t  patience: number;\n34\t  budget: number;\n35\t  priceSensitivity: number;\n36\t  preferredCategories: string[];\n37\t  itemsToBuy: number;\n38\t  stealChance: number;\n39\t  appearance: { bodyColor: string; headColor: string; accessory?: string };\n40\t}\n41\t\n42\tconst CUSTOMER_DEFS: Record<CustomerType, CustomerDef> = {\n43\t  [CustomerType.COMMUTER]: {\n44\t    type: CustomerType.COMMUTER,\n45\t    name: '上班族',\n46\t    speed: 90,\n47\t    patience: 30,\n48\t    budget: 15,\n49\t    priceSensitivity: 0.3,\n50\t    preferredCategories: ['beverage', 'snack'],\n51\t    itemsToBuy: 2,\n52\t    stealChance: 0,\n53\t    appearance: { bodyColor: '#445566', headColor: '#f0d8c0', accessory: 'tie' },\n54\t  },\n55\t  [CustomerType.LUNCH]: {\n56\t    type: CustomerType.LUNCH,\n57\t    name: '白领',\n58\t    speed: 70,\n59\t    patience: 45,\n60\t    budget: 25,\n61\t    priceSensitivity: 0.2,\n62\t    preferredCategories: ['bento', 'beverage'],\n63\t    itemsToBuy: 2,\n64\t    stealChance: 0,\n65\t    appearance: { bodyColor: '#664455', headColor: '#f0d8c0' },\n66\t  },\n67\t  [CustomerType.STUDENT]: {\n68\t    type: CustomerType.STUDENT,\n69\t    name: '学生',\n70\t    speed: 80,\n71\t    patience: 40,\n72\t    budget: 10,\n73\t    priceSensitivity: 0.7,\n74\t    preferredCategories: ['snack', 'beverage'],\n75\t    itemsToBuy: 3,\n76\t    stealChance: 0.05,\n77\t    appearance: { bodyColor: '#556644', headColor: '#f0d8c0', accessory: 'cap' },\n78\t  },\n79\t  [CustomerType.RESIDENT]: {\n80\t    type: CustomerType.RESIDENT,\n81\t    name: '居民',\n82\t    speed: 55,\n83\t    patience: 60,\n84\t    budget: 30,\n85\t    priceSensitivity: 0.5,\n86\t    preferredCategories: ['daily', 'beverage', 'snack'],\n87\t    itemsToBuy: 2,\n88\t    stealChance: 0,\n89\t    appearance: { bodyColor: '#665544', headColor: '#f0d8c0' },\n90\t  },\n91\t  [CustomerType.NIGHT]: {\n92\t    type: CustomerType.NIGHT,\n93\t    name: '深夜顾客',\n94\t    speed: 40,\n95\t    patience: 90,\n96\t    budget: 50,\n97\t    priceSensitivity: 0.1,\n98\t    preferredCategories: ['beverage', 'snack', 'special'],\n99\t    itemsToBuy: 1,\n100\t    stealChance: 0,\n101\t    appearance: { bodyColor: '#222233', headColor: '#888899' },\n102\t  },\n103\t};\n104\t\n105\t// Waypoints in tile coordinates for navigation\n106\tconst ENTRY_TILE = { gx: 14, gy: 1 };\n107\tconst REGISTER_TILES = [{ gx: 19, gy: 3 }, { gx: 21, gy: 3 }];\n108\tconst SHELF_TILES: Record<string, { gx: number; gy: number }[]> = {\n109\t  shelf_1: [{ gx: 3, gy: 4 }, { gx: 4, gy: 4 }, { gx: 5, gy: 4 }],\n110\t  shelf_2: [{ gx: 7, gy: 4 }, { gx: 8, gy: 4 }, { gx: 9, gy: 4 }],\n111\t  shelf_3: [{ gx: 11, gy: 4 }, { gx: 12, gy: 4 }, { gx: 13, gy: 4 }],\n112\t  shelf_4: [{ gx: 17, gy: 4 }, { gx: 18, gy: 4 }, { gx: 19, gy: 4 }],\n113\t  shelf_5: [{ gx: 21, gy: 4 }, { gx: 22, gy: 4 }, { gx: 23, gy: 4 }],\n114\t  fridge_1: [{ gx: 3, gy: 8 }, { gx: 4, gy: 8 }, { gx: 5, gy: 8 }],\n115\t  fridge_2: [{ gx: 7, gy: 8 }, { gx: 8, gy: 8 }, { gx: 9, gy: 8 }],\n116\t};\n117\tconst EXIT_TILE = { gx: 14, gy: 1 };\n118\t\n119\tconst TILE_SIZE = 32;\n120\t\n121\texport class Customer {\n122\t  id: string;\n123\t  type: CustomerType;\n124\t  def: CustomerDef;\n125\t  state: CustomerState = CustomerState.ENTERING;\n126\t  x: number;\n127\t  y: number;\n128\t  direction: 'up' | 'down' | 'left' | 'right' = 'down';\n129\t  cart: CartItem[] = [];\n130\t  totalSpent: number = 0;\n131\t  patienceTimer: number;\n132\t  browseTimer: number = 0;\n133\t  targetShelfId: string | null = null;\n134\t  registerIndex: number = 0;\n135\t\n136\t  private waypoints: { x: number; y: number }[] = [];\n137\t  private waypointIndex = 0;\n138\t  private animFrame = 0;\n139\t  private animTimer = 0;\n140\t\n141\t  constructor(id: string, type: CustomerType) {\n142\t    this.id = id;\n143\t    this.type = type;\n144\t    this.def = { ...CUSTOMER_DEFS[type] };\n145\t    this.x = ENTRY_TILE.gx * TILE_SIZE;\n146\t    this.y = ENTRY_TILE.gy * TILE_SIZE;\n147\t    this.patienceTimer = this.def.patience;\n148\t  }\n149\t\n150\t  update(dt: number, availableShelves: Map<string, string[]>, registerLineSize: number): void {\n151\t    const dtSec = dt / 1000;\n152\t    this.patienceTimer -= dtSec;\n153\t    this.animTimer += dt;\n154\t\n155\t    if (this.animTimer > 200) {\n156\t      this.animTimer = 0;\n157\t      this.animFrame = (this.animFrame + 1) % 4;\n158\t    }\n159\t\n160\t    if (this.patienceTimer <= 0 && this.state !== CustomerState.CHECKING_OUT) {\n161\t      this.state = CustomerState.FLED;\n162\t      return;\n163\t    }\n164\t\n165\t    switch (this.state) {\n166\t      case CustomerState.ENTERING:\n167\t        this.moveToWaypoint(dtSec);\n168\t        if (this.reachedWaypoint()) {\n169\t          this.decideWhatToBuy(availableShelves);\n170\t        }\n171\t        break;\n172\t\n173\t      case CustomerState.WALKING_TO_SHELF:\n174\t        this.moveToWaypoint(dtSec);\n175\t        if (this.reachedWaypoint()) {\n176\t          this.state = CustomerState.BROWSING;\n177\t          this.browseTimer = 2 + Math.random() * 3;\n178\t        }\n179\t        break;\n180\t\n181\t      case CustomerState.BROWSING:\n182\t        this.browseTimer -= dtSec;\n183\t        if (this.browseTimer <= 0) {\n184\t          this.state = CustomerState.PICKING;\n185\t        }\n186\t        break;\n187\t\n188\t      case CustomerState.PICKING:\n189\t        this.pickItem(availableShelves);\n190\t        if (this.cart.length >= this.def.itemsToBuy || !this.hasMoreShelvesToVisit(availableShelves)) {\n191\t          this.goToRegister(registerLineSize);\n192\t        } else {\n193\t          this.decideWhatToBuy(availableShelves);\n194\t        }\n195\t        break;\n196\t\n197\t      case CustomerState.WALKING_TO_REGISTER:\n198\t        this.moveToWaypoint(dtSec);\n199\t        if (this.reachedWaypoint()) {\n200\t          this.state = CustomerState.WAITING_IN_LINE;\n201\t        }\n202\t        break;\n203\t\n204\t      case CustomerState.WAITING_IN_LINE:\n205\t        // Waiting for player to initiate checkout\n206\t        break;\n207\t\n208\t      case CustomerState.CHECKING_OUT:\n209\t        // Handled by CashRegister\n210\t        break;\n211\t\n212\t      case CustomerState.WALKING_TO_EXIT:\n213\t        this.moveToWaypoint(dtSec);\n214\t        if (this.reachedWaypoint()) {\n215\t          this.state = CustomerState.LEAVING;\n216\t        }\n217\t        break;\n218\t    }\n219\t  }\n220\t\n221\t  private decideWhatToBuy(availableShelves: Map<string, string[]>): void {\n222\t    // Pick a random shelf that has products in preferred categories\n223\t    const candidates: string[] = [];\n224\t    for (const [shelfId, productIds] of availableShelves) {\n225\t      for (const pid of productIds) {\n226\t        // Check if product is in preferred categories (simplified: check by shelf type)\n227\t        candidates.push(shelfId);\n228\t        break;\n229\t      }\n230\t    }\n231\t\n232\t    if (candidates.length === 0) {\n233\t      this.goToRegister(0);\n234\t      return;\n235\t    }\n236\t\n237\t    this.targetShelfId = candidates[Math.floor(Math.random() * candidates.length)];\n238\t    const tileGroup = SHELF_TILES[this.targetShelfId];\n239\t    if (tileGroup) {\n240\t      const tile = tileGroup[Math.floor(Math.random() * tileGroup.length)];\n241\t      this.setWaypoints([{ x: tile.gx * TILE_SIZE, y: tile.gy * TILE_SIZE }]);\n242\t      this.state = CustomerState.WALKING_TO_SHELF;\n243\t    } else {\n244\t      this.goToRegister(0);\n245\t    }\n246\t  }\n247\t\n248\t  private pickItem(availableShelves: Map<string, string[]>): void {\n249\t    if (!this.targetShelfId) return;\n250\t    const products = availableShelves.get(this.targetShelfId);\n251\t    if (!products || products.length === 0) return;\n252\t\n253\t    const productId = products[Math.floor(Math.random() * products.length)];\n254\t    this.cart.push({ productId, price: 0 }); // price set at checkout\n255\t  }\n256\t\n257\t  private hasMoreShelvesToVisit(availableShelves: Map<string, string[]>): boolean {\n258\t    return this.cart.length < this.def.itemsToBuy && availableShelves.size > 0;\n259\t  }\n260\t\n261\t  goToRegister(lineSize: number): void {\n262\t    this.registerIndex = Math.min(lineSize, REGISTER_TILES.length - 1);\n263\t    const tile = REGISTER_TILES[this.registerIndex];\n264\t    const offsetY = Math.min(lineSize, 3) * TILE_SIZE;\n265\t    this.setWaypoints([{ x: tile.gx * TILE_SIZE, y: tile.gy * TILE_SIZE + offsetY }]);\n266\t    this.state = CustomerState.WALKING_TO_REGISTER;\n267\t  }\n268\t\n269\t  startCheckout(): void {\n270\t    this.state = CustomerState.CHECKING_OUT;\n271\t  }\n272\t\n273\t  finishCheckout(): void {\n274\t    this.setWaypoints([{ x: EXIT_TILE.gx * TILE_SIZE, y: EXIT_TILE.gy * TILE_SIZE }]);\n275\t    this.state = CustomerState.WALKING_TO_EXIT;\n276\t  }\n277\t\n278\t  isDone(): boolean {\n279\t    return this.state === CustomerState.LEAVING || this.state === CustomerState.FLED;\n280\t  }\n281\t\n282\t  isStealing(): boolean {\n283\t    return this.def.stealChance > 0 && Math.random() < this.def.stealChance;\n284\t  }\n285\t\n286\t  // Navigation\n287\t  private setWaypoints(points: { x: number; y: number }[]): void {\n288\t    this.waypoints = points;\n289\t    this.waypointIndex = 0;\n290\t  }\n291\t\n292\t  private moveToWaypoint(dtSec: number): void {\n293\t    if (this.waypointIndex >= this.waypoints.length) return;\n294\t\n295\t    const target = this.waypoints[this.waypointIndex];\n296\t    const dx = target.x - this.x;\n297\t    const dy = target.y - this.y;\n298\t    const dist = Math.sqrt(dx * dx + dy * dy);\n299\t\n300\t    if (dist < 4) {\n301\t      this.x = target.x;\n302\t      this.y = target.y;\n303\t      this.waypointIndex++;\n304\t      return;\n305\t    }\n306\t\n307\t    const moveAmt = this.def.speed * dtSec;\n308\t    const ratio = Math.min(moveAmt / dist, 1);\n309\t    const mx = dx * ratio;\n310\t    const my = dy * ratio;\n311\t\n312\t    this.x += mx;\n313\t    this.y += my;\n314\t\n315\t    if (Math.abs(dx) > Math.abs(dy)) {\n316\t      this.direction = dx > 0 ? 'right' : 'left';\n317\t    } else {\n318\t      this.direction = dy > 0 ? 'down' : 'up';\n319\t    }\n320\t  }\n321\t\n322\t  private reachedWaypoint(): boolean {\n323\t    return this.waypointIndex >= this.waypoints.length;\n324\t  }\n325\t\n326\t  render(ctx: CanvasRenderingContext2D, offsetX: number, offsetY: number, scale: number): void {\n327\t    const px = offsetX + this.x * scale;\n328\t    const py = offsetY + this.y * scale;\n329\t    const s = 16 * scale;\n330\t\n331\t    // Body\n332\t    ctx.fillStyle = this.def.appearance.bodyColor;\n333\t    ctx.fillRect(px, py + s * 0.3, s, s * 0.7);\n334\t\n335\t    // Head\n336\t    ctx.fillStyle = this.def.appearance.headColor;\n337\t    ctx.fillRect(px + s * 0.15, py, s * 0.7, s * 0.45);\n338\t\n339\t    // Accessory\n340\t    if (this.def.appearance.accessory === 'tie') {\n341\t      ctx.fillStyle = '#cc3333';\n342\t      ctx.fillRect(px + s * 0.45, py + s * 0.4, s * 0.1, s * 0.3);\n343\t    } else if (this.def.appearance.accessory === 'cap') {\n344\t      ctx.fillStyle = '#4488cc';\n345\t      ctx.fillRect(px + s * 0.05, py - s * 0.05, s * 0.9, s * 0.2);\n346\t    }\n347\t\n348\t    // Walking animation for legs\n349\t    if (this.state === CustomerState.WALKING_TO_SHELF ||\n350\t        this.state === CustomerState.WALKING_TO_REGISTER ||\n351\t        this.state === CustomerState.WALKING_TO_EXIT ||\n352\t        this.state === CustomerState.ENTERING) {\n353\t      const bob = Math.sin(this.animFrame * Math.PI / 2) * s * 0.05;\n354\t      ctx.fillStyle = '#4a4a5a';\n355\t      ctx.fillRect(px + s * 0.2, py + s * 0.85 + bob, s * 0.25, s * 0.15);\n356\t      ctx.fillRect(px + s * 0.55, py + s * 0.85 - bob, s * 0.25, s * 0.15);\n357\t    }\n358\t\n359\t    // Patience indicator (low patience = red)\n360\t    if (this.patienceTimer < this.def.patience * 0.3 && this.state !== CustomerState.CHECKING_OUT) {\n361\t      ctx.fillStyle = `rgba(255, 50, 50, ${0.5 + Math.sin(Date.now() * 0.01) * 0.3})`;\n362\t      ctx.font = `${Math.round(8 * scale)}px monospace`;\n363\t      ctx.textAlign = 'center';\n364\t      ctx.fillText('!', px + s / 2, py - 6 * scale);\n365\t    }\n366\t\n367\t    // Cart count indicator\n368\t    if (this.cart.length > 0) {\n369\t      ctx.fillStyle = 'rgba(100,200,100,0.8)';\n370\t      ctx.font = `${Math.round(7 * scale)}px monospace`;\n371\t      ctx.textAlign = 'center';\n372\t      ctx.fillText(`${this.cart.length}`, px + s / 2, py - 2 * scale);\n373\t    }\n374\t  }\n375\t}\n376\t"}]},"parent_tool_use_id":null,"session_id":"392f64db-fdde-44d3-ac09-12e89ef6a334","uuid":"a068e1b5-7a4e-468f-8322-84551a08297e","timestamp":"2026-05-23T04:48:31.386Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-horror-sim\\src\\game\\Customer.ts","content":"// Customer.ts — Individual customer entity with behavior AI (M2)\n\nexport enum CustomerType {\n  COMMUTER = 'commuter',\n  LUNCH = 'lunch',\n  STUDENT = 'student',\n  RESIDENT = 'resident',\n  NIGHT = 'night',\n}\n\nexport enum CustomerState {\n  ENTERING = 'entering',\n  WALKING_TO_SHELF = 'walking_to_shelf',\n  BROWSING = 'browsing',\n  PICKING = 'picking',\n  WALKING_TO_REGISTER = 'walking_to_register',\n  WAITING_IN_LINE = 'waiting_in_line',\n  CHECKING_OUT = 'checking_out',\n  WALKING_TO_EXIT = 'walking_to_exit',\n  LEAVING = 'leaving',\n  FLED = 'fled',\n}\n\nexport interface CartItem {\n  productId: string;\n  price: number;\n}\n\nexport interface CustomerDef {\n  type: CustomerType;\n  name: string;\n  speed: number;\n  patience: number;\n  budget: number;\n  priceSensitivity: number;\n  preferredCategories: string[];\n  itemsToBuy: number;\n  stealChance: number;\n  appearance: { bodyColor: string; headColor: string; accessory?: string };\n}\n\nconst CUSTOMER_DEFS: Record<CustomerType, CustomerDef> = {\n  [CustomerType.COMMUTER]: {\n    type: CustomerType.COMMUTER,\n    name: '上班族',\n    speed: 90,\n    patience: 30,\n    budget: 15,\n    priceSensitivity: 0.3,\n    preferredCategories: ['beverage', 'snack'],\n    itemsToBuy: 2,\n    stealChance: 0,\n    appearance: { bodyColor: '#445566', headColor: '#f0d8c0', accessory: 'tie' },\n  },\n  [CustomerType.LUNCH]: {\n    type: CustomerType.LUNCH,\n    name: '白领',\n    speed: 70,\n    patience: 45,\n    budget: 25,\n    priceSensitivity: 0.2,\n    preferredCategories: ['bento', 'beverage'],\n    itemsToBuy: 2,\n    stealChance: 0,\n    appearance: { bodyColor: '#664455', headColor: '#f0d8c0' },\n  },\n  [CustomerType.STUDENT]: {\n    type: CustomerType.STUDENT,\n    name: '学生',\n    speed: 80,\n    patience: 40,\n    budget: 10,\n    priceSensitivity: 0.7,\n    preferredCategories: ['snack', 'beverage'],\n    itemsToBuy: 3,\n    stealChance: 0.05,\n    appearance: { bodyColor: '#556644', headColor: '#f0d8c0', accessory: 'cap' },\n  },\n  [CustomerType.RESIDENT]: {\n    type: CustomerType.RESIDENT,\n    name: '居民',\n    speed: 55,\n    patience: 60,\n    budget: 30,\n    priceSensitivity: 0.5,\n    preferredCategories: ['daily', 'beverage', 'snack'],\n    itemsToBuy: 2,\n    stealChance: 0,\n    appearance: { bodyColor: '#665544', headColor: '#f0d8c0' },\n  },\n  [CustomerType.NIGHT]: {\n    type: CustomerType.NIGHT,\n    name: '深夜顾客',\n    speed: 40,\n    patience: 90,\n    budget: 50,\n    priceSensitivity: 0.1,\n    preferredCategories: ['beverage', 'snack', 'special'],\n    itemsToBuy: 1,\n    stealChance: 0,\n    appearance: { bodyColor: '#222233', headColor: '#888899' },\n  },\n};\n\n// Waypoints in tile coordinates for navigation\nconst ENTRY_TILE = { gx: 14, gy: 1 };\nconst REGISTER_TILES = [{ gx: 19, gy: 3 }, { gx: 21, gy: 3 }];\nconst SHELF_TILES: Record<string, { gx: number; gy: number }[]> = {\n  shelf_1: [{ gx: 3, gy: 4 }, { gx: 4, gy: 4 }, { gx: 5, gy: 4 }],\n  shelf_2: [{ gx: 7, gy: 4 }, { gx: 8, gy: 4 }, { gx: 9, gy: 4 }],\n  shelf_3: [{ gx: 11, gy: 4 }, { gx: 12, gy: 4 }, { gx: 13, gy: 4 }],\n  shelf_4: [{ gx: 17, gy: 4 }, { gx: 18, gy: 4 }, { gx: 19, gy: 4 }],\n  shelf_5: [{ gx: 21, gy: 4 }, { gx: 22, gy: 4 }, { gx: 23, gy: 4 }],\n  fridge_1: [{ gx: 3, gy: 8 }, { gx: 4, gy: 8 }, { gx: 5, gy: 8 }],\n  fridge_2: [{ gx: 7, gy: 8 }, { gx: 8, gy: 8 }, { gx: 9, gy: 8 }],\n};\nconst EXIT_TILE = { gx: 14, gy: 1 };\n\nconst TILE_SIZE = 32;\n\nexport class Customer {\n  id: string;\n  type: CustomerType;\n  def: CustomerDef;\n  state: CustomerState = CustomerState.ENTERING;\n  x: number;\n  y: number;\n  direction: 'up' | 'down' | 'left' | 'right' = 'down';\n  cart: CartItem[] = [];\n  totalSpent: number = 0;\n  patienceTimer: number;\n  browseTimer: number = 0;\n  targetShelfId: string | null = null;\n  registerIndex: number = 0;\n\n  private waypoints: { x: number; y: number }[] = [];\n  private waypointIndex = 0;\n  private animFrame = 0;\n  private animTimer = 0;\n\n  constructor(id: string, type: CustomerType) {\n    this.id = id;\n    this.type = type;\n    this.def = { ...CUSTOMER_DEFS[type] };\n    this.x = ENTRY_TILE.gx * TILE_SIZE;\n    this.y = ENTRY_TILE.gy * TILE_SIZE;\n    this.patienceTimer = this.def.patience;\n  }\n\n  update(dt: number, availableShelves: Map<string, string[]>, registerLineSize: number): void {\n    const dtSec = dt / 1000;\n    this.patienceTimer -= dtSec;\n    this.animTimer += dt;\n\n    if (this.animTimer > 200) {\n      this.animTimer = 0;\n      this.animFrame = (this.animFrame + 1) % 4;\n    }\n\n    if (this.patienceTimer <= 0 && this.state !== CustomerState.CHECKING_OUT) {\n      this.state = CustomerState.FLED;\n      return;\n    }\n\n    switch (this.state) {\n      case CustomerState.ENTERING:\n        this.moveToWaypoint(dtSec);\n        if (this.reachedWaypoint()) {\n          this.decideWhatToBuy(availableShelves);\n        }\n        break;\n\n      case CustomerState.WALKING_TO_SHELF:\n        this.moveToWaypoint(dtSec);\n        if (this.reachedWaypoint()) {\n          this.state = CustomerState.BROWSING;\n          this.browseTimer = 2 + Math.random() * 3;\n        }\n        break;\n\n      case CustomerState.BROWSING:\n        this.browseTimer -= dtSec;\n        if (this.browseTimer <= 0) {\n          this.state = CustomerState.PICKING;\n        }\n        break;\n\n      case CustomerState.PICKING:\n        this.pickItem(availableShelves);\n        if (this.cart.length >= this.def.itemsToBuy || !this.hasMoreShelvesToVisit(availableShelves)) {\n          this.goToRegister(registerLineSize);\n        } else {\n          this.decideWhatToBuy(availableShelves);\n        }\n        break;\n\n      case CustomerState.WALKING_TO_REGISTER:\n        this.moveToWaypoint(dtSec);\n        if (this.reachedWaypoint()) {\n          this.state = CustomerState.WAITING_IN_LINE;\n        }\n        break;\n\n      case CustomerState.WAITING_IN_LINE:\n        // Waiting for player to initiate checkout\n        break;\n\n      case CustomerState.CHECKING_OUT:\n        // Handled by CashRegister\n        break;\n\n      case CustomerState.WALKING_TO_EXIT:\n        this.moveToWaypoint(dtSec);\n        if (this.reachedWaypoint()) {\n          this.state = CustomerState.LEAVING;\n        }\n        break;\n    }\n  }\n\n  private decideWhatToBuy(availableShelves: Map<string, string[]>): void {\n    // Pick a random shelf that has products in preferred categories\n    const candidates: string[] = [];\n    for (const [shelfId, productIds] of availableShelves) {\n      for (const pid of productIds) {\n        // Check if product is in preferred categories (simplified: check by shelf type)\n        candidates.push(shelfId);\n        break;\n      }\n    }\n\n    if (candidates.length === 0) {\n      this.goToRegister(0);\n      return;\n    }\n\n    this.targetShelfId = candidates[Math.floor(Math.random() * candidates.length)];\n    const tileGroup = SHELF_TILES[this.targetShelfId];\n    if (tileGroup) {\n      const tile = tileGroup[Math.floor(Math.random() * tileGroup.length)];\n      this.setWaypoints([{ x: tile.gx * TILE_SIZE, y: tile.gy * TILE_SIZE }]);\n      this.state = CustomerState.WALKING_TO_SHELF;\n    } else {\n      this.goToRegister(0);\n    }\n  }\n\n  private pickItem(availableShelves: Map<string, string[]>): void {\n    if (!this.targetShelfId) return;\n    const products = availableShelves.get(this.targetShelfId);\n    if (!products || products.length === 0) return;\n\n    const productId = products[Math.floor(Math.random() * products.length)];\n    this.cart.push({ productId, price: 0 }); // price set at checkout\n  }\n\n  private hasMoreShelvesToVisit(availableShelves: Map<string, string[]>): boolean {\n    return this.cart.length < this.def.itemsToBuy && availableShelves.size > 0;\n  }\n\n  goToRegister(lineSize: number): void {\n    this.registerIndex = Math.min(lineSize, REGISTER_TILES.length - 1);\n    const tile = REGISTER_TILES[this.registerIndex];\n    const offsetY = Math.min(lineSize, 3) * TILE_SIZE;\n    this.setWaypoints([{ x: tile.gx * TILE_SIZE, y: tile.gy * TILE_SIZE + offsetY }]);\n    this.state = CustomerState.WALKING_TO_REGISTER;\n  }\n\n  startCheckout(): void {\n    this.state = CustomerState.CHECKING_OUT;\n  }\n\n  finishCheckout(): void {\n    this.setWaypoints([{ x: EXIT_TILE.gx * TILE_SIZE, y: EXIT_TILE.gy * TILE_SIZE }]);\n    this.state = CustomerState.WALKING_TO_EXIT;\n  }\n\n  isDone(): boolean {\n    return this.state === CustomerState.LEAVING || this.state === CustomerState.FLED;\n  }\n\n  isStealing(): boolean {\n    return this.def.stealChance > 0 && Math.random() < this.def.stealChance;\n  }\n\n  // Navigation\n  private setWaypoints(points: { x: number; y: number }[]): void {\n    this.waypoints = points;\n    this.waypointIndex = 0;\n  }\n\n  private moveToWaypoint(dtSec: number): void {\n    if (this.waypointIndex >= this.waypoints.length) return;\n\n    const target = this.waypoints[this.waypointIndex];\n    const dx = target.x - this.x;\n    const dy = target.y - this.y;\n    const dist = Math.sqrt(dx * dx + dy * dy);\n\n    if (dist < 4) {\n      this.x = target.x;\n      this.y = target.y;\n      this.waypointIndex++;\n      return;\n    }\n\n    const moveAmt = this.def.speed * dtSec;\n    const ratio = Math.min(moveAmt / dist, 1);\n    const mx = dx * ratio;\n    const my = dy * ratio;\n\n    this.x += mx;\n    this.y += my;\n\n    if (Math.abs(dx) > Math.abs(dy)) {\n      this.direction = dx > 0 ? 'right' : 'left';\n    } else {\n      this.direction = dy > 0 ? 'down' : 'up';\n    }\n  }\n\n  private reachedWaypoint(): boolean {\n    return this.waypointIndex >= this.waypoints.length;\n  }\n\n  render(ctx: CanvasRenderingContext2D, offsetX: number, offsetY: number, scale: number): void {\n    const px = offsetX + this.x * scale;\n    const py = offsetY + this.y * scale;\n    const s = 16 * scale;\n\n    // Body\n    ctx.fillStyle = this.def.appearance.bodyColor;\n    ctx.fillRect(px, py + s * 0.3, s, s * 0.7);\n\n    // Head\n    ctx.fillStyle = this.def.appearance.headColor;\n    ctx.fillRect(px + s * 0.15, py, s * 0.7, s * 0.45);\n\n    // Accessory\n    if (this.def.appearance.accessory === 'tie') {\n      ctx.fillStyle = '#cc3333';\n      ctx.fillRect(px + s * 0.45, py + s * 0.4, s * 0.1, s * 0.3);\n    } else if (this.def.appearance.accessory === 'cap') {\n      ctx.fillStyle = '#4488cc';\n      ctx.fillRect(px + s * 0.05, py - s * 0.05, s * 0.9, s * 0.2);\n    }\n\n    // Walking animation for legs\n    if (this.state === CustomerState.WALKING_TO_SHELF ||\n        this.state === CustomerState.WALKING_TO_REGISTER ||\n        this.state === CustomerState.WALKING_TO_EXIT ||\n        this.state === CustomerState.ENTERING) {\n      const bob = Math.sin(this.animFrame * Math.PI / 2) * s * 0.05;\n      ctx.fillStyle = '#4a4a5a';\n      ctx.fillRect(px + s * 0.2, py + s * 0.85 + bob, s * 0.25, s * 0.15);\n      ctx.fillRect(px + s * 0.55, py + s * 0.85 - bob, s * 0.25, s * 0.15);\n    }\n\n    // Patience indicator (low patience = red)\n    if (this.patienceTimer < this.def.patience * 0.3 && this.state !== CustomerState.CHECKING_OUT) {\n      ctx.fillStyle = `rgba(255, 50, 50, ${0.5 + Math.sin(Date.now() * 0.01) * 0.3})`;\n      ctx.font = `${Math.round(8 * scale)}px monospace`;\n      ctx.textAlign = 'center';\n      ctx.fillText('!', px + s / 2, py - 6 * scale);\n    }\n\n    // Cart count indicator\n    if (this.cart.length > 0) {\n      ctx.fillStyle = 'rgba(100,200,100,0.8)';\n      ctx.font = `${Math.round(7 * scale)}px monospace`;\n      ctx.textAlign = 'center';\n      ctx.fillText(`${this.cart.length}`, px + s / 2, py - 2 * scale);\n    }\n  }\n}\n","numLines":376,"startLine":1,"totalLines":376}}}
