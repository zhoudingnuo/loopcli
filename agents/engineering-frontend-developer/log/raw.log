{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_2f09ced2184347559075f47f","type":"tool_result","content":"1\t// ShopUI.js — Item shop with coin purchasing\n2\t\n3\tclass ShopUI {\n4\t  constructor(coinSystem, dataManager) {\n5\t    this.cs = coinSystem;\n6\t    this.dm = dataManager;\n7\t  }\n8\t\n9\t  render(ctx, screenW, screenH) {\n10\t    // Background\n11\t    const grad = ctx.createLinearGradient(0, 0, 0, screenH);\n12\t    grad.addColorStop(0, '#FFF8E7');\n13\t    grad.addColorStop(1, '#FFE0B2');\n14\t    ctx.fillStyle = grad;\n15\t    ctx.fillRect(0, 0, screenW, screenH);\n16\t\n17\t    // Title bar\n18\t    ctx.fillStyle = '#FFB800';\n19\t    this._roundRect(ctx, 10, 8, screenW - 20, 48, 12);\n20\t    ctx.fill();\n21\t    ctx.fillStyle = '#FFF';\n22\t    ctx.font = 'bold 20px sans-serif';\n23\t    ctx.textAlign = 'center';\n24\t    ctx.fillText('🏪 道具商店', screenW / 2, 40);\n25\t\n26\t    // Coins\n27\t    ctx.font = 'bold 14px sans-serif';\n28\t    ctx.textAlign = 'right';\n29\t    ctx.fillText(`🪙 ${this.dm.coins}`, screenW - 18, 38);\n30\t\n31\t    // Item cards\n32\t    const items = this.cs.SHOP_ITEMS;\n33\t    const cardW = screenW - 40;\n34\t    const cardH = 72;\n35\t    const startY = 75;\n36\t    const gap = 8;\n37\t\n38\t    for (let i = 0; i < items.length; i++) {\n39\t      const item = items[i];\n40\t      const y = startY + i * (cardH + gap);\n41\t      const owned = this.dm.getItemCount(item.id);\n42\t      const canBuy = this.dm.coins >= item.price;\n43\t\n44\t      // Card bg\n45\t      ctx.fillStyle = '#FFFFFFDD';\n46\t      this._roundRect(ctx, 20, y, cardW, cardH, 12);\n47\t      ctx.fill();\n48\t      ctx.strokeStyle = '#E0D5C5';\n49\t      ctx.lineWidth = 1;\n50\t      this._roundRect(ctx, 20, y, cardW, cardH, 12);\n51\t      ctx.stroke();\n52\t\n53\t      // Emoji icon\n54\t      ctx.font = '30px sans-serif';\n55\t      ctx.textAlign = 'left';\n56\t      ctx.fillText(item.emoji, 32, y + 42);\n57\t\n58\t      // Name\n59\t      ctx.fillStyle = '#5D4037';\n60\t      ctx.font = 'bold 15px sans-serif';\n61\t      ctx.fillText(item.name, 72, y + 28);\n62\t\n63\t      // Description\n64\t      ctx.fillStyle = '#8D6E63';\n65\t      ctx.font = '12px sans-serif';\n66\t      ctx.fillText(item.desc, 72, y + 48);\n67\t\n68\t      // Owned count\n69\t      if (owned > 0) {\n70\t        ctx.fillStyle = '#6BCB77';\n71\t        ctx.font = 'bold 13px sans-serif';\n72\t        ctx.textAlign = 'right';\n73\t        ctx.fillText(`×${owned}`, screenW - 100, y + 28);\n74\t      }\n75\t\n76\t      // Buy button\n77\t      const buyX = screenW - 90;\n78\t      const buyY = y + 20;\n79\t      const buyW = 68;\n80\t      const buyH = 32;\n81\t      ctx.fillStyle = canBuy ? '#FFB800' : '#D0C8B8';\n82\t      this._roundRect(ctx, buyX, buyY, buyW, buyH, buyH / 2);\n83\t      ctx.fill();\n84\t      ctx.fillStyle = canBuy ? '#FFF' : '#A09888';\n85\t      ctx.font = 'bold 12px sans-serif';\n86\t      ctx.textAlign = 'center';\n87\t      ctx.fillText(`${item.price}🪙`, buyX + buyW / 2, buyY + 21);\n88\t    }\n89\t\n90\t    // Back button\n91\t    ctx.fillStyle = '#8D6E63';\n92\t    this._roundRect(ctx, 20, screenH - 58, screenW - 40, 42, 21);\n93\t    ctx.fill();\n94\t    ctx.fillStyle = '#FFF';\n95\t    ctx.font = 'bold 16px sans-serif';\n96\t    ctx.textAlign = 'center';\n97\t    ctx.fillText('返回地图', screenW / 2, screenH - 32);\n98\t  }\n99\t\n100\t  handleClick(x, y, screenW, screenH) {\n101\t    const items = this.cs.SHOP_ITEMS;\n102\t    const cardH = 72;\n103\t    const startY = 75;\n104\t    const gap = 8;\n105\t\n106\t    // Buy buttons\n107\t    for (let i = 0; i < items.length; i++) {\n108\t      const iy = startY + i * (cardH + gap);\n109\t      const buyX = screenW - 90;\n110\t      const buyY = iy + 20;\n111\t      if (x >= buyX && x <= buyX + 68 && y >= buyY && y <= buyY + 32) {\n112\t        return { action: 'buy', itemId: items[i].id };\n113\t      }\n114\t    }\n115\t\n116\t    // Back button\n117\t    if (y >= screenH - 58 && y <= screenH - 16 && x >= 20 && x <= screenW - 20) {\n118\t      return { action: 'back' };\n119\t    }\n120\t\n121\t    return null;\n122\t  }\n123\t\n124\t  _roundRect(ctx, x, y, w, h, r) {\n125\t    ctx.beginPath();\n126\t    ctx.moveTo(x + r, y);\n127\t    ctx.lineTo(x + w - r, y);\n128\t    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n129\t    ctx.lineTo(x + w, y + h - r);\n130\t    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n131\t    ctx.lineTo(x + r, y + h);\n132\t    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n133\t    ctx.lineTo(x, y + r);\n134\t    ctx.quadraticCurveTo(x, y, x + r, y);\n135\t    ctx.closePath();\n136\t  }\n137\t}\n138\t\n139\tif (typeof module !== 'undefined') module.exports = { ShopUI };\n140\t"}]},"parent_tool_use_id":null,"session_id":"e7014494-9372-468d-b98b-69448d1a0f88","uuid":"2159b508-4111-444b-9dae-9632039e1901","timestamp":"2026-05-22T22:06:36.624Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\douyin-match3\\src\\js\\ShopUI.js","content":"// ShopUI.js — Item shop with coin purchasing\n\nclass ShopUI {\n  constructor(coinSystem, dataManager) {\n    this.cs = coinSystem;\n    this.dm = dataManager;\n  }\n\n  render(ctx, screenW, screenH) {\n    // Background\n    const grad = ctx.createLinearGradient(0, 0, 0, screenH);\n    grad.addColorStop(0, '#FFF8E7');\n    grad.addColorStop(1, '#FFE0B2');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, screenW, screenH);\n\n    // Title bar\n    ctx.fillStyle = '#FFB800';\n    this._roundRect(ctx, 10, 8, screenW - 20, 48, 12);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('🏪 道具商店', screenW / 2, 40);\n\n    // Coins\n    ctx.font = 'bold 14px sans-serif';\n    ctx.textAlign = 'right';\n    ctx.fillText(`🪙 ${this.dm.coins}`, screenW - 18, 38);\n\n    // Item cards\n    const items = this.cs.SHOP_ITEMS;\n    const cardW = screenW - 40;\n    const cardH = 72;\n    const startY = 75;\n    const gap = 8;\n\n    for (let i = 0; i < items.length; i++) {\n      const item = items[i];\n      const y = startY + i * (cardH + gap);\n      const owned = this.dm.getItemCount(item.id);\n      const canBuy = this.dm.coins >= item.price;\n\n      // Card bg\n      ctx.fillStyle = '#FFFFFFDD';\n      this._roundRect(ctx, 20, y, cardW, cardH, 12);\n      ctx.fill();\n      ctx.strokeStyle = '#E0D5C5';\n      ctx.lineWidth = 1;\n      this._roundRect(ctx, 20, y, cardW, cardH, 12);\n      ctx.stroke();\n\n      // Emoji icon\n      ctx.font = '30px sans-serif';\n      ctx.textAlign = 'left';\n      ctx.fillText(item.emoji, 32, y + 42);\n\n      // Name\n      ctx.fillStyle = '#5D4037';\n      ctx.font = 'bold 15px sans-serif';\n      ctx.fillText(item.name, 72, y + 28);\n\n      // Description\n      ctx.fillStyle = '#8D6E63';\n      ctx.font = '12px sans-serif';\n      ctx.fillText(item.desc, 72, y + 48);\n\n      // Owned count\n      if (owned > 0) {\n        ctx.fillStyle = '#6BCB77';\n        ctx.font = 'bold 13px sans-serif';\n        ctx.textAlign = 'right';\n        ctx.fillText(`×${owned}`, screenW - 100, y + 28);\n      }\n\n      // Buy button\n      const buyX = screenW - 90;\n      const buyY = y + 20;\n      const buyW = 68;\n      const buyH = 32;\n      ctx.fillStyle = canBuy ? '#FFB800' : '#D0C8B8';\n      this._roundRect(ctx, buyX, buyY, buyW, buyH, buyH / 2);\n      ctx.fill();\n      ctx.fillStyle = canBuy ? '#FFF' : '#A09888';\n      ctx.font = 'bold 12px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText(`${item.price}🪙`, buyX + buyW / 2, buyY + 21);\n    }\n\n    // Back button\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, 20, screenH - 58, screenW - 40, 42, 21);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 16px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('返回地图', screenW / 2, screenH - 32);\n  }\n\n  handleClick(x, y, screenW, screenH) {\n    const items = this.cs.SHOP_ITEMS;\n    const cardH = 72;\n    const startY = 75;\n    const gap = 8;\n\n    // Buy buttons\n    for (let i = 0; i < items.length; i++) {\n      const iy = startY + i * (cardH + gap);\n      const buyX = screenW - 90;\n      const buyY = iy + 20;\n      if (x >= buyX && x <= buyX + 68 && y >= buyY && y <= buyY + 32) {\n        return { action: 'buy', itemId: items[i].id };\n      }\n    }\n\n    // Back button\n    if (y >= screenH - 58 && y <= screenH - 16 && x >= 20 && x <= screenW - 20) {\n      return { action: 'back' };\n    }\n\n    return null;\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { ShopUI };\n","numLines":140,"startLine":1,"totalLines":140}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ee02d046b6924b3a8c00462b","type":"tool_result","content":"1\t// Game.js — Main game loop, state machine, integrates all Phase 2+3a systems\n2\t\n3\tconst STATES = {\n4\t  MENU: 'menu',\n5\t  IDLE: 'idle',\n6\t  SWAPPING: 'swapping',\n7\t  MATCHING: 'matching',\n8\t  REMOVING: 'removing',\n9\t  DROPPING: 'dropping',\n10\t  RESULT: 'result',\n11\t  BOSS_SKILL: 'boss_skill',\n12\t};\n13\t\n14\tclass Game {\n15\t  constructor(canvas) {\n16\t    this.canvas = canvas;\n17\t    this.board = new Board();\n18\t    this.matchEngine = new MatchEngine(this.board);\n19\t    this.renderer = new Renderer(canvas);\n20\t    this.input = new InputHandler(canvas, this.board);\n21\t    this.scoreSystem = new ScoreSystem();\n22\t    this.tweens = new TweenManager();\n23\t    this.particles = new ParticleSystem();\n24\t    this.obstacleMgr = new ObstacleManager(this.board);\n25\t    this.audio = new AudioManager();\n26\t    this.boss = null;\n27\t    this.levels = LEVELS;\n28\t    this.currentLevel = 0;\n29\t    this.state = STATES.IDLE;\n30\t    this.comboText = '';\n31\t    this.comboTimer = 0;\n32\t    this.lastTime = 0;\n33\t    this.resultData = null;\n34\t    this.moveCount = 0;\n35\t\n36\t    // Phase 3a: meta-progression systems\n37\t    this.dataManager = new DataManager();\n38\t    this.coinSystem = new CoinSystem(this.dataManager);\n39\t    this.characterMgr = new CharacterManager();\n40\t    this.mapScreen = new MapScreen(this.dataManager);\n41\t    this.shopUI = new ShopUI(this.coinSystem, this.dataManager);\n42\t    this.nav = new Navigation(this);\n43\t\n44\t    // Phase 3b: daily + social\n45\t    this.dailySystem = new DailySystem(this.dataManager, this.coinSystem);\n46\t    this.socialSystem = new SocialSystem(this.dataManager);\n47\t    this.dailySystem.checkNewDay();\n48\t\n49\t    this.renderer.particleSystem = this.particles;\n50\t\n51\t    this._setupInput();\n52\t    this._setupScoreCallbacks();\n53\t    this._setupObstacleCallbacks();\n54\t  }\n55\t\n56\t  _setupInput() {\n57\t    this.input.onSwap = (r1, c1, r2, c2) => this._handleSwap(r1, c1, r2, c2);\n58\t    this.input.onTap = (row, col) => this._handleTap(row, col);\n59\t  }\n60\t\n61\t  _setupScoreCallbacks() {\n62\t    this.scoreSystem.onLevelComplete = (score, stars) => {\n63\t      this.nav.showResult(true, score, stars, this.currentLevel + 1);\n64\t      this.audio.playLevelWin();\n65\t      // Phase 3b: daily task tracking\n66\t      this.dailySystem.reportEvent('complete_levels', 1);\n67\t      if (stars === 3) this.dailySystem.reportEvent('star3', 1);\n68\t      if (score >= 2000) this.dailySystem.reportEvent('score', score);\n69\t    };\n70\t    this.scoreSystem.onLevelFail = (score) => {\n71\t      this.nav.showResult(false, score, 0, this.currentLevel + 1);\n72\t      this.audio.playLevelFail();\n73\t    };\n74\t  }\n75\t\n76\t  _setupObstacleCallbacks() {\n77\t    this.obstacleMgr.onObstacleDestroyed = (obs) => {\n78\t      this.scoreSystem.addObstacleCleared(obs.type);\n79\t      this.audio.playObstacleBreak();\n80\t      // Phase 3b: daily obstacle tracking\n81\t      this.dailySystem.reportEvent('clear_obstacle', obs.type);\n82\t      const pos = this.renderer.getTileCenter(obs.row, obs.col);\n83\t      this.particles.emitExplosion(pos.x, pos.y, this._obstacleColor(obs.type), 12);\n84\t    };\n85\t  }\n86\t\n87\t  _obstacleColor(type) {\n88\t    switch (type) {\n89\t      case OBSTACLE_ICE: return '#88CCFF';\n90\t      case OBSTACLE_CHAIN: return '#AAAAAA';\n91\t      case OBSTACLE_CHOCOLATE: return '#8B4513';\n92\t      default: return '#FFFFFF';\n93\t    }\n94\t  }\n95\t\n96\t  start() {\n97\t    this.lastTime = performance.now();\n98\t    this._loop();\n99\t  }\n100\t\n101\t  _loadLevel(idx) {\n102\t    this.currentLevel = idx;\n103\t    const config = this.levels[idx] || this.levels[0];\n104\t    this.board.init();\n105\t    this.scoreSystem.reset(idx + 1);\n106\t    this.scoreSystem.configure(config);\n107\t    this.tweens.clear();\n108\t    this.particles.particles = [];\n109\t    this.renderer.floatingTexts = [];\n110\t    this.comboText = '';\n111\t    this.resultData = null;\n112\t    this.moveCount = 0;\n113\t\n114\t    this.obstacleMgr.loadFromConfig(config.obstacles);\n115\t\n116\t    for (const obs of this.obstacleMgr.obstacles) {\n117\t      if (obs.type === OBSTACLE_CHOCOLATE) {\n118\t        this.board.clearCell(obs.row, obs.col);\n119\t      }\n120\t    }\n121\t\n122\t    this.boss = null;\n123\t    if (config.boss) {\n124\t      this.boss = new Boss(config.boss);\n125\t      this.board.clearCell(this.boss.row, this.boss.col);\n126\t    }\n127\t\n128\t    this.board.applyGravity();\n129\t    this.board._removeInitialMatches();\n130\t\n131\t    this.input.updateLayout(\n132\t      this.renderer.tileSize,\n133\t      this.renderer.boardX,\n134\t      this.renderer.boardY,\n135\t    );\n136\t  }\n137\t\n138\t  _handleTap(row, col) {\n139\t    if (this.state !== STATES.IDLE) return;\n140\t    const tile = this.board.getTile(row, col);\n141\t    if (!tile) return;\n142\t\n143\t    this.audio.init();\n144\t\n145\t    if (tile.special === SPECIAL_RAINBOW) return;\n146\t  }\n147\t\n148\t  _handleSwap(r1, c1, r2, c2) {\n149\t    if (this.state !== STATES.IDLE) return;\n150\t\n151\t    this.audio.init();\n152\t\n153\t    const tileA = this.board.getTile(r1, c1);\n154\t    const tileB = this.board.getTile(r2, c2);\n155\t\n156\t    if (!this.obstacleMgr.canSwap(r1, c1) || !this.obstacleMgr.canSwap(r2, c2)) {\n157\t      this.audio.playInvalid();\n158\t      return;\n159\t    }\n160\t\n161\t    if (tileA && tileA.special === SPECIAL_RAINBOW) {\n162\t      this._activateRainbow(r1, c1, tileB ? tileB.color : 0, r2, c2);\n163\t      return;\n164\t    }\n165\t    if (tileB && tileB.special === SPECIAL_RAINBOW) {\n166\t      this._activateRainbow(r2, c2, tileA ? tileA.color : 0, r1, c1);\n167\t      return;\n168\t    }\n169\t\n170\t    if (!this.matchEngine.isValidSwap(r1, c1, r2, c2)) {\n171\t      this.audio.playInvalid();\n172\t      return;\n173\t    }\n174\t    if (!this.scoreSystem.useMove()) return;\n175\t\n176\t    this.audio.playSwap();\n177\t    this.moveCount++;\n178\t    this.state = STATES.SWAPPING;\n179\t    this.board.swap(r1, c1, r2, c2);\n180\t\n181\t    this._animateSwap(r1, c1, r2, c2, () => {\n182\t      this._processMatches();\n183\t    });\n184\t  }\n185\t\n186\t  _animateSwap(r1, c1, r2, c2, callback) {\n187\t    const tileSize = this.renderer.tileSize;\n188\t    const tileA = this.board.getTile(r2, c2);\n189\t    const tileB = this.board.getTile(r1, c1);\n190\t    const dx = (c2 - c1) * tileSize;\n191\t    const dy = (r2 - r1) * tileSize;\n192\t\n193\t    if (tileA) {\n194\t      tileA.offsetX = -dx;\n195\t      tileA.offsetY = -dy;\n196\t      this.tweens.add(tileA, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n197\t    }\n198\t    if (tileB) {\n199\t      tileB.offsetX = dx;\n200\t      tileB.offsetY = dy;\n201\t      this.tweens.add(tileB, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n202\t    }\n203\t    setTimeout(callback, 160);\n204\t  }\n205\t\n206\t  _activateRainbow(rainbowRow, rainbowCol, targetColor, otherRow, otherCol) {\n207\t    if (!this.scoreSystem.useMove()) return;\n208\t    this.moveCount++;\n209\t    this.audio.playSpecial();\n210\t    this.state = STATES.MATCHING;\n211\t\n212\t    const toRemove = this.matchEngine.triggerRainbow(rainbowRow, rainbowCol, targetColor);\n213\t    toRemove.push({ row: rainbowRow, col: rainbowCol });\n214\t    if (this.board.getTile(otherRow, otherCol)) {\n215\t      toRemove.push({ row: otherRow, col: otherCol });\n216\t    }\n217\t\n218\t    this._removeAndCascade(toRemove, 10);\n219\t  }\n220\t\n221\t  _processMatches() {\n222\t    this.state = STATES.MATCHING;\n223\t    const matches = this.board.findAllMatches();\n224\t\n225\t    if (matches.length === 0) {\n226\t      this._afterMoveComplete();\n227\t      return;\n228\t    }\n229\t\n230\t    this._processChain(0);\n231\t  }\n232\t\n233\t  _processChain(chainCount) {\n234\t    chainCount++;\n235\t    const matches = this.board.findAllMatches();\n236\t    if (matches.length === 0) {\n237\t      this._afterMoveComplete();\n238\t      return;\n239\t    }\n240\t\n241\t    const lShapes = this.board.findLShapeMatches(matches);\n242\t    const { removeCells, specials } = this.matchEngine._classifyMatches(matches, lShapes);\n243\t\n244\t    const multiplier = chainCount <= 1 ? 1 : chainCount === 2 ? 1.5 : chainCount === 3 ? 2.0 : 2.5;\n245\t    const baseScore = removeCells.size * 10;\n246\t    const points = Math.floor(baseScore * multiplier);\n247\t    this.scoreSystem.addScore(points);\n248\t\n249\t    // Phase 3a: character skill — chain bonus\n250\t    this.characterMgr.applySkill(\n251\t      this.dataManager.selectedCharacter,\n252\t      this, 'chain_score', { chainCount },\n253\t    );\n254\t\n255\t    if (chainCount >= 4) this.comboText = '超赞！！';\n256\t    else if (chainCount === 3) this.comboText = '太棒了！';\n257\t    else if (chainCount === 2) this.comboText = '不错！';\n258\t    this.comboTimer = 0.8;\n259\t\n260\t    // Phase 3b: daily chain tracking\n261\t    this.dailySystem.reportEvent('chain', 1);\n262\t\n263\t    this.audio.playMatch(chainCount);\n264\t    if (chainCount >= 2) this.audio.playCombo(chainCount);\n265\t\n266\t    // Collect matched positions\n267\t    const matchedPositions = [];\n268\t    for (const key of removeCells) {\n269\t      const [r, c] = key.split(',').map(Number);\n270\t      const tile = this.board.getTile(r, c);\n271\t      if (tile && tile.color >= 0) {\n272\t        this.scoreSystem.addCollected(tile.color, 1);\n273\t      }\n274\t      matchedPositions.push({ row: r, col: c });\n275\t    }\n276\t\n277\t    // Phase 3a: character skill — lucky special\n278\t    const matchCells = [];\n279\t    for (const key of removeCells) {\n280\t      const [r, c] = key.split(',').map(Number);\n281\t      matchCells.push({ row: r, col: c });\n282\t    }\n283\t    this.characterMgr.applySkill(\n284\t      this.dataManager.selectedCharacter,\n285\t      this, 'match_created', { cells: matchCells },\n286\t    );\n287\t\n288\t    // Create specials\n289\t    const specialPositions = new Set(specials.map(s => `${s.row},${s.col}`));\n290\t    for (const sp of specials) {\n291\t      const tile = this.board.getTile(sp.row, sp.col);\n292\t      if (tile) {\n293\t        tile.special = sp.type;\n294\t        tile.removing = false;\n295\t      }\n296\t    }\n297\t\n298\t    // Animate removal\n299\t    this.state = STATES.REMOVING;\n300\t    const toAnimate = [];\n301\t    for (const key of removeCells) {\n302\t      if (specialPositions.has(key)) continue;\n303\t      const [r, c] = key.split(',').map(Number);\n304\t      const tile = this.board.getTile(r, c);\n305\t      if (tile) {\n306\t        const pos = this.renderer.getTileCenter(r, c);\n307\t        const color = COLOR_MAP[tile.color];\n308\t        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 8);\n309\t        this.renderer.addFloatingText(`+${points}`, pos.x, pos.y);\n310\t        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n311\t        toAnimate.push(tile);\n312\t      }\n313\t    }\n314\t\n315\t    setTimeout(() => {\n316\t      for (const key of removeCells) {\n317\t        if (specialPositions.has(key)) continue;\n318\t        const [r, c] = key.split(',').map(Number);\n319\t        this.board.clearCell(r, c);\n320\t      }\n321\t\n322\t      for (const sp of specials) {\n323\t        this._triggerSpecialEffects(sp.row, sp.col, sp.type);\n324\t      }\n325\t\n326\t      this.obstacleMgr.onTilesMatched(matchedPositions);\n327\t\n328\t      if (this.boss && this.boss.active) {\n329\t        const dmg = this.boss.calculateDamage(matchedPositions);\n330\t        if (dmg > 0) {\n331\t          const defeated = this.boss.takeDamage(dmg);\n332\t          this.audio.playBossHit();\n333\t          if (defeated) {\n334\t            this.audio.playBossDefeat();\n335\t            this.scoreSystem.addScore(500);\n336\t          }\n337\t        }\n338\t      }\n339\t\n340\t      this.state = STATES.DROPPING;\n341\t      const drops = this.board.applyGravity();\n342\t\n343\t      for (const drop of drops) {\n344\t        const tile = drop.tile;\n345\t        const fromY = drop.fromRow * this.renderer.tileSize;\n346\t        const toY = drop.toRow * this.renderer.tileSize;\n347\t        tile.offsetY = fromY - toY;\n348\t        this.tweens.add(tile, { offsetY: 0 }, 0.2 + drop.distance * 0.03, 'easeOutBounce');\n349\t      }\n350\t\n351\t      setTimeout(() => {\n352\t        this._processChain(chainCount);\n353\t      }, 350);\n354\t    }, 280);\n355\t  }\n356\t\n357\t  _afterMoveComplete() {\n358\t    if (this.boss && this.boss.isDefeated() && this.scoreSystem.goalType === 'boss') {\n359\t      this.nav.showResult(true, this.scoreSystem.score, this.scoreSystem.getStarCount(), this.currentLevel + 1);\n360\t      this.audio.playLevelWin();\n361\t      return;\n362\t    }\n363\t\n364\t    this.obstacleMgr.spreadChocolate();\n365\t\n366\t    // Phase 3a: character skill — auto obstacle clear\n367\t    this.characterMgr.applySkill(\n368\t      this.dataManager.selectedCharacter,\n369\t      this, 'after_move', null,\n370\t    );\n371\t\n372\t    if (this.boss && this.boss.active) {\n373\t      const ability = this.boss.tryUseAbility();\n374\t      if (ability) {\n375\t        this._executeBossAbility(ability);\n376\t      }\n377\t    }\n378\t\n379\t    this.state = STATES.IDLE;\n380\t\n381\t    if (!this.board.hasValidMoves(this.obstacleMgr)) {\n382\t      this.board.shuffle();\n383\t    }\n384\t\n385\t    this.scoreSystem.checkState();\n386\t  }\n387\t\n388\t  _executeBossAbility(ability) {\n389\t    this.audio.playBossAbility();\n390\t\n391\t    switch (ability) {\n392\t      case 'freeze': {\n393\t        const candidates = [];\n394\t        for (let r = 0; r < this.board.size; r++) {\n395\t          for (let c = 0; c < this.board.size; c++) {\n396\t            if (!this.obstacleMgr.hasObstacle(r, c) && this.board.getTile(r, c)) {\n397\t              if (this.boss && r === this.boss.row && c === this.boss.col) continue;\n398\t              candidates.push({ row: r, col: c });\n399\t            }\n400\t          }\n401\t        }\n402\t        const count = Math.min(2, candidates.length);\n403\t        for (let i = 0; i < count; i++) {\n404\t          const idx = Math.floor(Math.random() * candidates.length);\n405\t          const target = candidates.splice(idx, 1)[0];\n406\t          this.obstacleMgr.addObstacle(OBSTACLE_ICE, target.row, target.col);\n407\t        }\n408\t        break;\n409\t      }\n410\t      case 'chain': {\n411\t        const candidates = [];\n412\t        for (let r = 0; r < this.board.size; r++) {\n413\t          for (let c = 0; c < this.board.size; c++) {\n414\t            if (!this.obstacleMgr.hasObstacle(r, c) && this.board.getTile(r, c)) {\n415\t              if (this.boss && r === this.boss.row && c === this.boss.col) continue;\n416\t              candidates.push({ row: r, col: c });\n417\t            }\n418\t          }\n419\t        }\n420\t        if (candidates.length > 0) {\n421\t          const idx = Math.floor(Math.random() * candidates.length);\n422\t          const target = candidates[idx];\n423\t          this.obstacleMgr.addObstacle(OBSTACLE_CHAIN, target.row, target.col);\n424\t        }\n425\t        break;\n426\t      }\n427\t      case 'chocolate': {\n428\t        const dirs = [[-1,0],[1,0],[0,-1],[0,1]];\n429\t        const candidates = [];\n430\t        for (const [dr, dc] of dirs) {\n431\t          const nr = this.boss.row + dr;\n432\t          const nc = this.boss.col + dc;\n433\t          if (this.board.isValid(nr, nc) && !this.obstacleMgr.hasObstacle(nr, nc)) {\n434\t            candidates.push({ row: nr, col: nc });\n435\t          }\n436\t        }\n437\t        if (candidates.length > 0) {\n438\t          const target = candidates[Math.floor(Math.random() * candidates.length)];\n439\t          this.obstacleMgr.addObstacle(OBSTACLE_CHOCOLATE, target.row, target.col);\n440\t        }\n441\t        break;\n442\t      }\n443\t    }\n444\t  }\n445\t\n446\t  _triggerSpecialEffects(row, col, type) {\n447\t    const pos = this.renderer.getTileCenter(row, col);\n448\t    const tile = this.board.getTile(row, col);\n449\t    const color = tile ? COLOR_MAP[tile.color]?.hex : '#FFB800';\n450\t\n451\t    this.audio.playSpecial();\n452\t\n453\t    switch (type) {\n454\t      case 1: case 2:\n455\t        this.particles.emitExplosion(pos.x, pos.y, color || '#FFB800', 20);\n456\t        break;\n457\t      case 3:\n458\t        this.particles.emitExplosion(pos.x, pos.y, '#FF9A3C', 30);\n459\t        break;\n460\t      case 4:\n461\t        for (let i = 0; i < 40; i++) {\n462\t          this.particles.emitExplosion(pos.x, pos.y, '#FFB800', 2);\n463\t        }\n464\t        break;\n465\t    }\n466\t  }\n467\t\n468\t  _removeAndCascade(cells, scorePerCell) {\n469\t    this.state = STATES.REMOVING;\n470\t    const points = cells.length * scorePerCell;\n471\t    this.scoreSystem.addScore(points);\n472\t\n473\t    for (const { row, col } of cells) {\n474\t      const tile = this.board.getTile(row, col);\n475\t      if (tile && tile.color >= 0) {\n476\t        this.scoreSystem.addCollected(tile.color, 1);\n477\t      }\n478\t    }\n479\t\n480\t    for (const { row, col } of cells) {\n481\t      const tile = this.board.getTile(row, col);\n482\t      if (tile) {\n483\t        const pos = this.renderer.getTileCenter(row, col);\n484\t        const color = COLOR_MAP[tile.color];\n485\t        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 6);\n486\t        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n487\t      }\n488\t    }\n489\t\n490\t    setTimeout(() => {\n491\t      for (const { row, col } of cells) {\n492\t        this.board.clearCell(row, col);\n493\t      }\n494\t\n495\t      this.obstacleMgr.onTilesMatched(cells);\n496\t\n497\t      if (this.boss && this.boss.active) {\n498\t        const dmg = this.boss.calculateDamage(cells);\n499\t        if (dmg > 0) {\n500\t          const defeated = this.boss.takeDamage(dmg);\n501\t          this.audio.playBossHit();\n502\t          if (defeated) {\n503\t            this.audio.playBossDefeat();\n504\t            this.scoreSystem.addScore(500);\n505\t          }\n506\t        }\n507\t      }\n508\t\n509\t      this.board.applyGravity();\n510\t\n511\t      this.state = STATES.IDLE;\n512\t      setTimeout(() => this._processMatches(), 200);\n513\t    }, 300);\n514\t  }\n515\t\n516\t  _loop() {\n517\t    const now = performance.now();\n518\t    const dt = Math.min((now - this.lastTime) / 1000, 0.05);\n519\t    this.lastTime = now;\n520\t\n521\t    // Phase 3a: Navigation screens take priority\n522\t    if (this.nav.isActive()) {\n523\t      this.nav.render(this.renderer.ctx, this.renderer.screenW, this.renderer.screenH);\n524\t      requestAnimationFrame(() => this._loop());\n525\t      return;\n526\t    }\n527\t\n528\t    this.update(dt);\n529\t    this.render();\n530\t    requestAnimationFrame(() => this._loop());\n531\t  }\n532\t\n533\t  update(dt) {\n534\t    this.tweens.update(dt);\n535\t    this.particles.update(dt);\n536\t    this.obstacleMgr.update(dt);\n537\t    if (this.boss) this.boss.update(dt);\n538\t\n539\t    if (this.comboTimer > 0) {\n540\t      this.comboTimer -= dt;\n541\t      if (this.comboTimer <= 0) this.comboText = '';\n542\t    }\n543\t\n544\t    this.input.enabled = this.state === STATES.IDLE;\n545\t  }\n546\t\n547\t  render() {\n548\t    this.renderer.clear();\n549\t    this.renderer.drawBackground();\n550\t\n551\t    for (let r = 0; r < this.board.size; r++) {\n552\t      for (let c = 0; c < this.board.size; c++) {\n553\t        const tile = this.board.getTile(r, c);\n554\t        if (tile) this.renderer.drawTile(tile);\n555\t      }\n556\t    }\n557\t\n558\t    this.renderer.drawObstacles(this.obstacleMgr);\n559\t\n560\t    if (this.boss && this.boss.active) {\n561\t      this.renderer.drawBoss(this.boss, this.renderer);\n562\t    }\n563\t\n564\t    this.particles.draw(this.renderer.ctx);\n565\t    this.renderer.updateAndDrawFloatingTexts(1 / 60);\n566\t\n567\t    const config = this.levels[this.currentLevel] || this.levels[0];\n568\t    this.renderer.drawUI(\n569\t      this.scoreSystem.score,\n570\t      this.scoreSystem.getRemainingMoves(),\n571\t      config,\n572\t      this.scoreSystem,\n573\t      this.currentLevel + 1,\n574\t    );\n575\t\n576\t    if (this.comboText) {\n577\t      this.renderer.drawComboText(this.comboText);\n578\t    }\n579\t\n580\t    if (this.boss && this.boss.active) {\n581\t      this.renderer.drawBossHealthBar(this.boss);\n582\t    }\n583\t\n584\t    // Phase 3a: back-to-map button during gameplay\n585\t    this._drawBackButton();\n586\t\n587\t    // Result screen is now handled by Navigation\n588\t  }\n589\t\n590\t  _drawBackButton() {\n591\t    const ctx = this.renderer.ctx;\n592\t    const w = this.renderer.screenW;\n593\t    ctx.fillStyle = '#8D6E6399';\n594\t    this.renderer._roundRect(ctx, w - 50, this.renderer.boardY + this.renderer.tileSize * BOARD_SIZE + 25, 40, 28, 14);\n595\t    ctx.fill();\n596\t    ctx.fillStyle = '#FFF';\n597\t    ctx.font = 'bold 12px sans-serif';\n598\t    ctx.textAlign = 'center';\n599\t    ctx.fillText('地图', w - 30, this.renderer.boardY + this.renderer.tileSize * BOARD_SIZE + 44);\n600\t  }\n601\t\n602\t  retry() {\n603\t    this._loadLevel(this.currentLevel);\n604\t    this.state = STATES.IDLE;\n605\t  }\n606\t\n607\t  nextLevel() {\n608\t    const next = this.currentLevel + 1;\n609\t    if (next < this.levels.length) {\n610\t      this._loadLevel(next);\n611\t      this.state = STATES.IDLE;\n612\t    } else {\n613\t      this._loadLevel(0);\n614\t      this.state = STATES.IDLE;\n615\t    }\n616\t  }\n617\t}\n618\t\n619\tif (typeof module !== 'undefined') module.exports = { Game, STATES };\n620\t"}]},"parent_tool_use_id":null,"session_id":"e7014494-9372-468d-b98b-69448d1a0f88","uuid":"b9094944-622b-4d3a-9241-7c49b84fe7b8","timestamp":"2026-05-22T22:06:37.083Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\douyin-match3\\src\\js\\Game.js","content":"// Game.js — Main game loop, state machine, integrates all Phase 2+3a systems\n\nconst STATES = {\n  MENU: 'menu',\n  IDLE: 'idle',\n  SWAPPING: 'swapping',\n  MATCHING: 'matching',\n  REMOVING: 'removing',\n  DROPPING: 'dropping',\n  RESULT: 'result',\n  BOSS_SKILL: 'boss_skill',\n};\n\nclass Game {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.board = new Board();\n    this.matchEngine = new MatchEngine(this.board);\n    this.renderer = new Renderer(canvas);\n    this.input = new InputHandler(canvas, this.board);\n    this.scoreSystem = new ScoreSystem();\n    this.tweens = new TweenManager();\n    this.particles = new ParticleSystem();\n    this.obstacleMgr = new ObstacleManager(this.board);\n    this.audio = new AudioManager();\n    this.boss = null;\n    this.levels = LEVELS;\n    this.currentLevel = 0;\n    this.state = STATES.IDLE;\n    this.comboText = '';\n    this.comboTimer = 0;\n    this.lastTime = 0;\n    this.resultData = null;\n    this.moveCount = 0;\n\n    // Phase 3a: meta-progression systems\n    this.dataManager = new DataManager();\n    this.coinSystem = new CoinSystem(this.dataManager);\n    this.characterMgr = new CharacterManager();\n    this.mapScreen = new MapScreen(this.dataManager);\n    this.shopUI = new ShopUI(this.coinSystem, this.dataManager);\n    this.nav = new Navigation(this);\n\n    // Phase 3b: daily + social\n    this.dailySystem = new DailySystem(this.dataManager, this.coinSystem);\n    this.socialSystem = new SocialSystem(this.dataManager);\n    this.dailySystem.checkNewDay();\n\n    this.renderer.particleSystem = this.particles;\n\n    this._setupInput();\n    this._setupScoreCallbacks();\n    this._setupObstacleCallbacks();\n  }\n\n  _setupInput() {\n    this.input.onSwap = (r1, c1, r2, c2) => this._handleSwap(r1, c1, r2, c2);\n    this.input.onTap = (row, col) => this._handleTap(row, col);\n  }\n\n  _setupScoreCallbacks() {\n    this.scoreSystem.onLevelComplete = (score, stars) => {\n      this.nav.showResult(true, score, stars, this.currentLevel + 1);\n      this.audio.playLevelWin();\n      // Phase 3b: daily task tracking\n      this.dailySystem.reportEvent('complete_levels', 1);\n      if (stars === 3) this.dailySystem.reportEvent('star3', 1);\n      if (score >= 2000) this.dailySystem.reportEvent('score', score);\n    };\n    this.scoreSystem.onLevelFail = (score) => {\n      this.nav.showResult(false, score, 0, this.currentLevel + 1);\n      this.audio.playLevelFail();\n    };\n  }\n\n  _setupObstacleCallbacks() {\n    this.obstacleMgr.onObstacleDestroyed = (obs) => {\n      this.scoreSystem.addObstacleCleared(obs.type);\n      this.audio.playObstacleBreak();\n      // Phase 3b: daily obstacle tracking\n      this.dailySystem.reportEvent('clear_obstacle', obs.type);\n      const pos = this.renderer.getTileCenter(obs.row, obs.col);\n      this.particles.emitExplosion(pos.x, pos.y, this._obstacleColor(obs.type), 12);\n    };\n  }\n\n  _obstacleColor(type) {\n    switch (type) {\n      case OBSTACLE_ICE: return '#88CCFF';\n      case OBSTACLE_CHAIN: return '#AAAAAA';\n      case OBSTACLE_CHOCOLATE: return '#8B4513';\n      default: return '#FFFFFF';\n    }\n  }\n\n  start() {\n    this.lastTime = performance.now();\n    this._loop();\n  }\n\n  _loadLevel(idx) {\n    this.currentLevel = idx;\n    const config = this.levels[idx] || this.levels[0];\n    this.board.init();\n    this.scoreSystem.reset(idx + 1);\n    this.scoreSystem.configure(config);\n    this.tweens.clear();\n    this.particles.particles = [];\n    this.renderer.floatingTexts = [];\n    this.comboText = '';\n    this.resultData = null;\n    this.moveCount = 0;\n\n    this.obstacleMgr.loadFromConfig(config.obstacles);\n\n    for (const obs of this.obstacleMgr.obstacles) {\n      if (obs.type === OBSTACLE_CHOCOLATE) {\n        this.board.clearCell(obs.row, obs.col);\n      }\n    }\n\n    this.boss = null;\n    if (config.boss) {\n      this.boss = new Boss(config.boss);\n      this.board.clearCell(this.boss.row, this.boss.col);\n    }\n\n    this.board.applyGravity();\n    this.board._removeInitialMatches();\n\n    this.input.updateLayout(\n      this.renderer.tileSize,\n      this.renderer.boardX,\n      this.renderer.boardY,\n    );\n  }\n\n  _handleTap(row, col) {\n    if (this.state !== STATES.IDLE) return;\n    const tile = this.board.getTile(row, col);\n    if (!tile) return;\n\n    this.audio.init();\n\n    if (tile.special === SPECIAL_RAINBOW) return;\n  }\n\n  _handleSwap(r1, c1, r2, c2) {\n    if (this.state !== STATES.IDLE) return;\n\n    this.audio.init();\n\n    const tileA = this.board.getTile(r1, c1);\n    const tileB = this.board.getTile(r2, c2);\n\n    if (!this.obstacleMgr.canSwap(r1, c1) || !this.obstacleMgr.canSwap(r2, c2)) {\n      this.audio.playInvalid();\n      return;\n    }\n\n    if (tileA && tileA.special === SPECIAL_RAINBOW) {\n      this._activateRainbow(r1, c1, tileB ? tileB.color : 0, r2, c2);\n      return;\n    }\n    if (tileB && tileB.special === SPECIAL_RAINBOW) {\n      this._activateRainbow(r2, c2, tileA ? tileA.color : 0, r1, c1);\n      return;\n    }\n\n    if (!this.matchEngine.isValidSwap(r1, c1, r2, c2)) {\n      this.audio.playInvalid();\n      return;\n    }\n    if (!this.scoreSystem.useMove()) return;\n\n    this.audio.playSwap();\n    this.moveCount++;\n    this.state = STATES.SWAPPING;\n    this.board.swap(r1, c1, r2, c2);\n\n    this._animateSwap(r1, c1, r2, c2, () => {\n      this._processMatches();\n    });\n  }\n\n  _animateSwap(r1, c1, r2, c2, callback) {\n    const tileSize = this.renderer.tileSize;\n    const tileA = this.board.getTile(r2, c2);\n    const tileB = this.board.getTile(r1, c1);\n    const dx = (c2 - c1) * tileSize;\n    const dy = (r2 - r1) * tileSize;\n\n    if (tileA) {\n      tileA.offsetX = -dx;\n      tileA.offsetY = -dy;\n      this.tweens.add(tileA, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n    }\n    if (tileB) {\n      tileB.offsetX = dx;\n      tileB.offsetY = dy;\n      this.tweens.add(tileB, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n    }\n    setTimeout(callback, 160);\n  }\n\n  _activateRainbow(rainbowRow, rainbowCol, targetColor, otherRow, otherCol) {\n    if (!this.scoreSystem.useMove()) return;\n    this.moveCount++;\n    this.audio.playSpecial();\n    this.state = STATES.MATCHING;\n\n    const toRemove = this.matchEngine.triggerRainbow(rainbowRow, rainbowCol, targetColor);\n    toRemove.push({ row: rainbowRow, col: rainbowCol });\n    if (this.board.getTile(otherRow, otherCol)) {\n      toRemove.push({ row: otherRow, col: otherCol });\n    }\n\n    this._removeAndCascade(toRemove, 10);\n  }\n\n  _processMatches() {\n    this.state = STATES.MATCHING;\n    const matches = this.board.findAllMatches();\n\n    if (matches.length === 0) {\n      this._afterMoveComplete();\n      return;\n    }\n\n    this._processChain(0);\n  }\n\n  _processChain(chainCount) {\n    chainCount++;\n    const matches = this.board.findAllMatches();\n    if (matches.length === 0) {\n      this._afterMoveComplete();\n      return;\n    }\n\n    const lShapes = this.board.findLShapeMatches(matches);\n    const { removeCells, specials } = this.matchEngine._classifyMatches(matches, lShapes);\n\n    const multiplier = chainCount <= 1 ? 1 : chainCount === 2 ? 1.5 : chainCount === 3 ? 2.0 : 2.5;\n    const baseScore = removeCells.size * 10;\n    const points = Math.floor(baseScore * multiplier);\n    this.scoreSystem.addScore(points);\n\n    // Phase 3a: character skill — chain bonus\n    this.characterMgr.applySkill(\n      this.dataManager.selectedCharacter,\n      this, 'chain_score', { chainCount },\n    );\n\n    if (chainCount >= 4) this.comboText = '超赞！！';\n    else if (chainCount === 3) this.comboText = '太棒了！';\n    else if (chainCount === 2) this.comboText = '不错！';\n    this.comboTimer = 0.8;\n\n    // Phase 3b: daily chain tracking\n    this.dailySystem.reportEvent('chain', 1);\n\n    this.audio.playMatch(chainCount);\n    if (chainCount >= 2) this.audio.playCombo(chainCount);\n\n    // Collect matched positions\n    const matchedPositions = [];\n    for (const key of removeCells) {\n      const [r, c] = key.split(',').map(Number);\n      const tile = this.board.getTile(r, c);\n      if (tile && tile.color >= 0) {\n        this.scoreSystem.addCollected(tile.color, 1);\n      }\n      matchedPositions.push({ row: r, col: c });\n    }\n\n    // Phase 3a: character skill — lucky special\n    const matchCells = [];\n    for (const key of removeCells) {\n      const [r, c] = key.split(',').map(Number);\n      matchCells.push({ row: r, col: c });\n    }\n    this.characterMgr.applySkill(\n      this.dataManager.selectedCharacter,\n      this, 'match_created', { cells: matchCells },\n    );\n\n    // Create specials\n    const specialPositions = new Set(specials.map(s => `${s.row},${s.col}`));\n    for (const sp of specials) {\n      const tile = this.board.getTile(sp.row, sp.col);\n      if (tile) {\n        tile.special = sp.type;\n        tile.removing = false;\n      }\n    }\n\n    // Animate removal\n    this.state = STATES.REMOVING;\n    const toAnimate = [];\n    for (const key of removeCells) {\n      if (specialPositions.has(key)) continue;\n      const [r, c] = key.split(',').map(Number);\n      const tile = this.board.getTile(r, c);\n      if (tile) {\n        const pos = this.renderer.getTileCenter(r, c);\n        const color = COLOR_MAP[tile.color];\n        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 8);\n        this.renderer.addFloatingText(`+${points}`, pos.x, pos.y);\n        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n        toAnimate.push(tile);\n      }\n    }\n\n    setTimeout(() => {\n      for (const key of removeCells) {\n        if (specialPositions.has(key)) continue;\n        const [r, c] = key.split(',').map(Number);\n        this.board.clearCell(r, c);\n      }\n\n      for (const sp of specials) {\n        this._triggerSpecialEffects(sp.row, sp.col, sp.type);\n      }\n\n      this.obstacleMgr.onTilesMatched(matchedPositions);\n\n      if (this.boss && this.boss.active) {\n        const dmg = this.boss.calculateDamage(matchedPositions);\n        if (dmg > 0) {\n          const defeated = this.boss.takeDamage(dmg);\n          this.audio.playBossHit();\n          if (defeated) {\n            this.audio.playBossDefeat();\n            this.scoreSystem.addScore(500);\n          }\n        }\n      }\n\n      this.state = STATES.DROPPING;\n      const drops = this.board.applyGravity();\n\n      for (const drop of drops) {\n        const tile = drop.tile;\n        const fromY = drop.fromRow * this.renderer.tileSize;\n        const toY = drop.toRow * this.renderer.tileSize;\n        tile.offsetY = fromY - toY;\n        this.tweens.add(tile, { offsetY: 0 }, 0.2 + drop.distance * 0.03, 'easeOutBounce');\n      }\n\n      setTimeout(() => {\n        this._processChain(chainCount);\n      }, 350);\n    }, 280);\n  }\n\n  _afterMoveComplete() {\n    if (this.boss && this.boss.isDefeated() && this.scoreSystem.goalType === 'boss') {\n      this.nav.showResult(true, this.scoreSystem.score, this.scoreSystem.getStarCount(), this.currentLevel + 1);\n      this.audio.playLevelWin();\n      return;\n    }\n\n    this.obstacleMgr.spreadChocolate();\n\n    // Phase 3a: character skill — auto obstacle clear\n    this.characterMgr.applySkill(\n      this.dataManager.selectedCharacter,\n      this, 'after_move', null,\n    );\n\n    if (this.boss && this.boss.active) {\n      const ability = this.boss.tryUseAbility();\n      if (ability) {\n        this._executeBossAbility(ability);\n      }\n    }\n\n    this.state = STATES.IDLE;\n\n    if (!this.board.hasValidMoves(this.obstacleMgr)) {\n      this.board.shuffle();\n    }\n\n    this.scoreSystem.checkState();\n  }\n\n  _executeBossAbility(ability) {\n    this.audio.playBossAbility();\n\n    switch (ability) {\n      case 'freeze': {\n        const candidates = [];\n        for (let r = 0; r < this.board.size; r++) {\n          for (let c = 0; c < this.board.size; c++) {\n            if (!this.obstacleMgr.hasObstacle(r, c) && this.board.getTile(r, c)) {\n              if (this.boss && r === this.boss.row && c === this.boss.col) continue;\n              candidates.push({ row: r, col: c });\n            }\n          }\n        }\n        const count = Math.min(2, candidates.length);\n        for (let i = 0; i < count; i++) {\n          const idx = Math.floor(Math.random() * candidates.length);\n          const target = candidates.splice(idx, 1)[0];\n          this.obstacleMgr.addObstacle(OBSTACLE_ICE, target.row, target.col);\n        }\n        break;\n      }\n      case 'chain': {\n        const candidates = [];\n        for (let r = 0; r < this.board.size; r++) {\n          for (let c = 0; c < this.board.size; c++) {\n            if (!this.obstacleMgr.hasObstacle(r, c) && this.board.getTile(r, c)) {\n              if (this.boss && r === this.boss.row && c === this.boss.col) continue;\n              candidates.push({ row: r, col: c });\n            }\n          }\n        }\n        if (candidates.length > 0) {\n          const idx = Math.floor(Math.random() * candidates.length);\n          const target = candidates[idx];\n          this.obstacleMgr.addObstacle(OBSTACLE_CHAIN, target.row, target.col);\n        }\n        break;\n      }\n      case 'chocolate': {\n        const dirs = [[-1,0],[1,0],[0,-1],[0,1]];\n        const candidates = [];\n        for (const [dr, dc] of dirs) {\n          const nr = this.boss.row + dr;\n          const nc = this.boss.col + dc;\n          if (this.board.isValid(nr, nc) && !this.obstacleMgr.hasObstacle(nr, nc)) {\n            candidates.push({ row: nr, col: nc });\n          }\n        }\n        if (candidates.length > 0) {\n          const target = candidates[Math.floor(Math.random() * candidates.length)];\n          this.obstacleMgr.addObstacle(OBSTACLE_CHOCOLATE, target.row, target.col);\n        }\n        break;\n      }\n    }\n  }\n\n  _triggerSpecialEffects(row, col, type) {\n    const pos = this.renderer.getTileCenter(row, col);\n    const tile = this.board.getTile(row, col);\n    const color = tile ? COLOR_MAP[tile.color]?.hex : '#FFB800';\n\n    this.audio.playSpecial();\n\n    switch (type) {\n      case 1: case 2:\n        this.particles.emitExplosion(pos.x, pos.y, color || '#FFB800', 20);\n        break;\n      case 3:\n        this.particles.emitExplosion(pos.x, pos.y, '#FF9A3C', 30);\n        break;\n      case 4:\n        for (let i = 0; i < 40; i++) {\n          this.particles.emitExplosion(pos.x, pos.y, '#FFB800', 2);\n        }\n        break;\n    }\n  }\n\n  _removeAndCascade(cells, scorePerCell) {\n    this.state = STATES.REMOVING;\n    const points = cells.length * scorePerCell;\n    this.scoreSystem.addScore(points);\n\n    for (const { row, col } of cells) {\n      const tile = this.board.getTile(row, col);\n      if (tile && tile.color >= 0) {\n        this.scoreSystem.addCollected(tile.color, 1);\n      }\n    }\n\n    for (const { row, col } of cells) {\n      const tile = this.board.getTile(row, col);\n      if (tile) {\n        const pos = this.renderer.getTileCenter(row, col);\n        const color = COLOR_MAP[tile.color];\n        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 6);\n        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n      }\n    }\n\n    setTimeout(() => {\n      for (const { row, col } of cells) {\n        this.board.clearCell(row, col);\n      }\n\n      this.obstacleMgr.onTilesMatched(cells);\n\n      if (this.boss && this.boss.active) {\n        const dmg = this.boss.calculateDamage(cells);\n        if (dmg > 0) {\n          const defeated = this.boss.takeDamage(dmg);\n          this.audio.playBossHit();\n          if (defeated) {\n            this.audio.playBossDefeat();\n            this.scoreSystem.addScore(500);\n          }\n        }\n      }\n\n      this.board.applyGravity();\n\n      this.state = STATES.IDLE;\n      setTimeout(() => this._processMatches(), 200);\n    }, 300);\n  }\n\n  _loop() {\n    const now = performance.now();\n    const dt = Math.min((now - this.lastTime) / 1000, 0.05);\n    this.lastTime = now;\n\n    // Phase 3a: Navigation screens take priority\n    if (this.nav.isActive()) {\n      this.nav.render(this.renderer.ctx, this.renderer.screenW, this.renderer.screenH);\n      requestAnimationFrame(() => this._loop());\n      return;\n    }\n\n    this.update(dt);\n    this.render();\n    requestAnimationFrame(() => this._loop());\n  }\n\n  update(dt) {\n    this.tweens.update(dt);\n    this.particles.update(dt);\n    this.obstacleMgr.update(dt);\n    if (this.boss) this.boss.update(dt);\n\n    if (this.comboTimer > 0) {\n      this.comboTimer -= dt;\n      if (this.comboTimer <= 0) this.comboText = '';\n    }\n\n    this.input.enabled = this.state === STATES.IDLE;\n  }\n\n  render() {\n    this.renderer.clear();\n    this.renderer.drawBackground();\n\n    for (let r = 0; r < this.board.size; r++) {\n      for (let c = 0; c < this.board.size; c++) {\n        const tile = this.board.getTile(r, c);\n        if (tile) this.renderer.drawTile(tile);\n      }\n    }\n\n    this.renderer.drawObstacles(this.obstacleMgr);\n\n    if (this.boss && this.boss.active) {\n      this.renderer.drawBoss(this.boss, this.renderer);\n    }\n\n    this.particles.draw(this.renderer.ctx);\n    this.renderer.updateAndDrawFloatingTexts(1 / 60);\n\n    const config = this.levels[this.currentLevel] || this.levels[0];\n    this.renderer.drawUI(\n      this.scoreSystem.score,\n      this.scoreSystem.getRemainingMoves(),\n      config,\n      this.scoreSystem,\n      this.currentLevel + 1,\n    );\n\n    if (this.comboText) {\n      this.renderer.drawComboText(this.comboText);\n    }\n\n    if (this.boss && this.boss.active) {\n      this.renderer.drawBossHealthBar(this.boss);\n    }\n\n    // Phase 3a: back-to-map button during gameplay\n    this._drawBackButton();\n\n    // Result screen is now handled by Navigation\n  }\n\n  _drawBackButton() {\n    const ctx = this.renderer.ctx;\n    const w = this.renderer.screenW;\n    ctx.fillStyle = '#8D6E6399';\n    this.renderer._roundRect(ctx, w - 50, this.renderer.boardY + this.renderer.tileSize * BOARD_SIZE + 25, 40, 28, 14);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 12px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('地图', w - 30, this.renderer.boardY + this.renderer.tileSize * BOARD_SIZE + 44);\n  }\n\n  retry() {\n    this._loadLevel(this.currentLevel);\n    this.state = STATES.IDLE;\n  }\n\n  nextLevel() {\n    const next = this.currentLevel + 1;\n    if (next < this.levels.length) {\n      this._loadLevel(next);\n      this.state = STATES.IDLE;\n    } else {\n      this._loadLevel(0);\n      this.state = STATES.IDLE;\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Game, STATES };\n","numLines":620,"startLine":1,"totalLines":620}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_77de838f98614c2bb62000d2","type":"tool_result","content":"1\t// CoinSystem.js — Gold economy with rewards and shop\n2\t\n3\tclass CoinSystem {\n4\t  constructor(dataManager) {\n5\t    this.dm = dataManager;\n6\t    this.STAR_REWARDS = { 1: 10, 2: 20, 3: 30 };\n7\t    this.CONTINUE_COST = 10;\n8\t    this.SHOP_ITEMS = [\n9\t      { id: 'striped_bomb', name: '条纹炸弹', desc: '开局放置1个条纹炸弹', price: 5, emoji: '💥' },\n10\t      { id: 'area_bomb', name: '区域炸弹', desc: '开局放置1个区域炸弹', price: 8, emoji: '💣' },\n11\t      { id: 'rainbow', name: '彩虹方块', desc: '开局放置1个彩虹方块', price: 15, emoji: '🌈' },\n12\t      { id: 'extra_moves', name: '额外步数', desc: '开局额外+5步', price: 10, emoji: '👟' },\n13\t      { id: 'shuffle', name: '洗牌卡', desc: '重新排列棋盘方块', price: 3, emoji: '🔀' },\n14\t    ];\n15\t  }\n16\t\n17\t  awardStars(stars) {\n18\t    const reward = this.STAR_REWARDS[stars] || 0;\n19\t    if (reward > 0) this.dm.addCoins(reward);\n20\t    return reward;\n21\t  }\n22\t\n23\t  canContinue() { return this.dm.coins >= this.CONTINUE_COST; }\n24\t  buyContinue() { return this.dm.spendCoins(this.CONTINUE_COST); }\n25\t\n26\t  canBuy(itemId) {\n27\t    const item = this.SHOP_ITEMS.find(i => i.id === itemId);\n28\t    return item && this.dm.coins >= item.price;\n29\t  }\n30\t\n31\t  buy(itemId) {\n32\t    const item = this.SHOP_ITEMS.find(i => i.id === itemId);\n33\t    if (!item || !this.dm.spendCoins(item.price)) return false;\n34\t    this.dm.addItem(itemId);\n35\t    return true;\n36\t  }\n37\t}\n38\t\n39\tif (typeof module !== 'undefined') module.exports = { CoinSystem };\n40\t"}]},"parent_tool_use_id":null,"session_id":"e7014494-9372-468d-b98b-69448d1a0f88","uuid":"be19bdf4-90f8-4ab6-a595-8fe769ba352f","timestamp":"2026-05-22T22:06:37.087Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\douyin-match3\\src\\js\\CoinSystem.js","content":"// CoinSystem.js — Gold economy with rewards and shop\n\nclass CoinSystem {\n  constructor(dataManager) {\n    this.dm = dataManager;\n    this.STAR_REWARDS = { 1: 10, 2: 20, 3: 30 };\n    this.CONTINUE_COST = 10;\n    this.SHOP_ITEMS = [\n      { id: 'striped_bomb', name: '条纹炸弹', desc: '开局放置1个条纹炸弹', price: 5, emoji: '💥' },\n      { id: 'area_bomb', name: '区域炸弹', desc: '开局放置1个区域炸弹', price: 8, emoji: '💣' },\n      { id: 'rainbow', name: '彩虹方块', desc: '开局放置1个彩虹方块', price: 15, emoji: '🌈' },\n      { id: 'extra_moves', name: '额外步数', desc: '开局额外+5步', price: 10, emoji: '👟' },\n      { id: 'shuffle', name: '洗牌卡', desc: '重新排列棋盘方块', price: 3, emoji: '🔀' },\n    ];\n  }\n\n  awardStars(stars) {\n    const reward = this.STAR_REWARDS[stars] || 0;\n    if (reward > 0) this.dm.addCoins(reward);\n    return reward;\n  }\n\n  canContinue() { return this.dm.coins >= this.CONTINUE_COST; }\n  buyContinue() { return this.dm.spendCoins(this.CONTINUE_COST); }\n\n  canBuy(itemId) {\n    const item = this.SHOP_ITEMS.find(i => i.id === itemId);\n    return item && this.dm.coins >= item.price;\n  }\n\n  buy(itemId) {\n    const item = this.SHOP_ITEMS.find(i => i.id === itemId);\n    if (!item || !this.dm.spendCoins(item.price)) return false;\n    this.dm.addItem(itemId);\n    return true;\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { CoinSystem };\n","numLines":40,"startLine":1,"totalLines":40}}}
