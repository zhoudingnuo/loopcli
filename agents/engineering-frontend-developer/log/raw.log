{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_afdf24af5ff54099b7b2658b","type":"tool_result","content":"The file D:\\game-projects\\steam-horror-sim\\src\\renderer\\Renderer.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"e8f5bde0-4da8-4c4a-9322-50945e66ead7","uuid":"d66f312d-0992-41ea-96e6-51191264c6eb","timestamp":"2026-05-23T04:42:05.631Z","tool_use_result":{"filePath":"D:\\game-projects\\steam-horror-sim\\src\\renderer\\Renderer.ts","oldString":"    // Render active panel\n    if (ctx && state.activePanel !== UIPanel.NONE) {\n      this.renderPanel(c, w, h, state, ctx);\n    }","newString":"    // Render active panel\n    if (ctx && state.activePanel !== UIPanel.NONE) {\n      this.renderPanel(c, w, h, state, ctx);\n    }\n\n    // M3: Render day summary overlay\n    if (ctx?.daySummary) {\n      ctx.daySummary.render(c, w, h);\n    }","originalFile":"// Renderer.ts — Canvas 2D rendering system (v0.2.0 — M2)\n\nimport { Camera } from './Camera';\nimport { StoreMap, T } from '../game/StoreMap';\nimport { Player } from '../game/Player';\nimport { Lighting } from './Lighting';\nimport {\n  type GameState,\n  type GamePhase,\n  type LightSource,\n  type Interactable,\n  GamePhase as GP,\n  UIPanel,\n  getTimeString,\n  isNightTime,\n} from '../game/GameState';\nimport { Customer } from '../game/Customer';\nimport { ProductManager } from '../game/ProductManager';\nimport { ShelfInteraction, ShelfAction } from '../game/ShelfInteraction';\nimport { CashRegister, RegisterState } from '../game/CashRegister';\nimport { EconomySystem } from '../game/EconomySystem';\nimport { PricingSystem } from '../game/PricingSystem';\nimport { DaySummaryManager } from '../game/DaySummary';\nimport { UpgradeManager } from '../game/UpgradeManager';\n\nexport interface RenderContext {\n  customers: Customer[];\n  productManager: ProductManager;\n  shelfInteraction: ShelfInteraction;\n  registers: CashRegister[];\n  economy: EconomySystem;\n  pricing: PricingSystem;\n  lastTransaction: string;\n  daySummary?: DaySummaryManager;\n  upgradeManager?: UpgradeManager;\n}\n\nexport class Renderer {\n  canvas: HTMLCanvasElement;\n  ctx: CanvasRenderingContext2D;\n  camera: Camera;\n  lighting: Lighting;\n\n  constructor(canvas: HTMLCanvasElement) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d')!;\n    this.camera = new Camera(canvas);\n    this.lighting = new Lighting();\n    this.resize();\n    this.camera.setupZoom(canvas);\n  }\n\n  resize(): void {\n    const dpr = window.devicePixelRatio || 1;\n    const rect = this.canvas.getBoundingClientRect();\n    this.canvas.width = rect.width * dpr;\n    this.canvas.height = rect.height * dpr;\n    this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n  }\n\n  render(\n    map: StoreMap,\n    player: Player,\n    state: GameState,\n    now: number,\n    ctx?: RenderContext,\n  ): void {\n    const c = this.ctx;\n    const w = this.canvas.getBoundingClientRect().width;\n    const h = this.canvas.getBoundingClientRect().height;\n\n    const bgPhase = state.phase;\n    if (bgPhase === 'danger') {\n      c.fillStyle = '#0a0a15';\n    } else if (isNightTime(bgPhase)) {\n      c.fillStyle = '#0f1020';\n    } else {\n      c.fillStyle = '#1a1520';\n    }\n    c.fillRect(0, 0, w, h);\n\n    const { offsetX, offsetY, scale } = this.camera.getTransform();\n\n    // Render map tiles\n    map.render(c, offsetX, offsetY, w, h, scale);\n\n    // Render shelf product indicators\n    if (ctx) {\n      this.renderShelfIndicators(c, ctx.productManager, state.interactables, offsetX, offsetY, scale);\n    }\n\n    // Render interactable highlights\n    this.renderInteractables(c, state.interactables, offsetX, offsetY, scale, player, now);\n\n    // Render customers\n    if (ctx) {\n      for (const customer of ctx.customers) {\n        customer.render(c, offsetX, offsetY, scale);\n      }\n    }\n\n    // Render player\n    player.render(c, offsetX, offsetY, scale);\n\n    // Render lighting overlay (M3: pass timeOfDay for gradual transitions)\n    this.lighting.render(c, w, h, state.lights, state.phase, offsetX, offsetY, scale, now, state.timeOfDay);\n\n    // Render HUD\n    this.renderHUD(c, w, h, state, player, ctx);\n\n    // Render active panel\n    if (ctx && state.activePanel !== UIPanel.NONE) {\n      this.renderPanel(c, w, h, state, ctx);\n    }\n  }\n\n  private renderShelfIndicators(\n    c: CanvasRenderingContext2D,\n    pm: ProductManager,\n    interactables: Interactable[],\n    ox: number,\n    oy: number,\n    scale: number,\n  ): void {\n    for (const inter of interactables) {\n      if (inter.type !== 'shelf' && inter.type !== 'fridge') continue;\n      const slot = pm.shelfSlots.get(inter.id);\n      if (!slot || !slot.productId || slot.quantity <= 0) continue;\n\n      const product = pm.getProduct(slot.productId);\n      if (!product) continue;\n\n      const px = ox + inter.x * scale;\n      const py = oy + (inter.y - 8) * scale;\n      const pw = inter.width * scale;\n\n      // Stock level bar\n      const ratio = slot.quantity / slot.maxQuantity;\n      const barColor = ratio > 0.5 ? '#66aa66' : ratio > 0.2 ? '#aaaa44' : '#aa4444';\n      c.fillStyle = 'rgba(0,0,0,0.5)';\n      c.fillRect(px, py, pw, 6 * scale);\n      c.fillStyle = barColor;\n      c.fillRect(px, py, pw * ratio, 6 * scale);\n\n      // Product name\n      c.fillStyle = 'rgba(255,255,255,0.7)';\n      c.font = `${Math.round(8 * scale)}px monospace`;\n      c.textAlign = 'center';\n      c.textBaseline = 'top';\n      c.fillText(`${product.name}(${slot.quantity})`, px + pw / 2, py + 7 * scale);\n    }\n  }\n\n  private renderInteractables(\n    c: CanvasRenderingContext2D,\n    interactables: Interactable[],\n    ox: number,\n    oy: number,\n    scale: number,\n    player: Player,\n    now: number,\n  ): void {\n    const facing = player.getFacingTile();\n\n    for (const obj of interactables) {\n      const px = ox + obj.x * scale;\n      const py = oy + obj.y * scale;\n      const pw = obj.width * scale;\n      const ph = obj.height * scale;\n\n      const objGX = Math.floor(obj.x / 32);\n      const objGY = Math.floor(obj.y / 32);\n      const isFacing = facing.gx >= objGX && facing.gx <= objGX + Math.ceil(obj.width / 32) - 1 &&\n        facing.gy >= objGY && facing.gy <= objGY + Math.ceil(obj.height / 32) - 1;\n\n      if (isFacing) {\n        const pulse = 0.3 + Math.sin(now * 0.005) * 0.1;\n        c.strokeStyle = `rgba(255, 255, 100, ${pulse})`;\n        c.lineWidth = 2;\n        c.strokeRect(px - 2, py - 2, pw + 4, ph + 4);\n\n        c.fillStyle = 'rgba(0,0,0,0.7)';\n        const labelW = c.measureText(obj.label).width + 12;\n        c.fillRect(px + pw / 2 - labelW / 2, py - 22, labelW, 18);\n        c.fillStyle = '#ffdd66';\n        c.font = `${Math.round(11)}px monospace`;\n        c.textAlign = 'center';\n        c.textBaseline = 'middle';\n        c.fillText(obj.label, px + pw / 2, py - 13);\n      }\n    }\n  }\n\n  private renderHUD(\n    c: CanvasRenderingContext2D,\n    canvasW: number,\n    canvasH: number,\n    state: GameState,\n    player: Player,\n    ctx?: RenderContext,\n  ): void {\n    // Top bar\n    c.fillStyle = 'rgba(0,0,0,0.8)';\n    c.fillRect(0, 0, canvasW, 44);\n\n    // Day counter\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 13px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'middle';\n    c.fillText(`Day ${state.day}`, 12, 14);\n\n    // Time\n    c.fillStyle = isNightTime(state.phase) ? '#8888cc' : '#ccaa66';\n    c.font = '13px monospace';\n    c.fillText(getTimeString(state.timeOfDay), 80, 14);\n\n    // Phase indicator\n    const phaseLabels: Record<string, string> = {\n      daytime: '营业中',\n      night_transition: '准备打烊',\n      night: '深夜营业',\n      danger: '危险时段',\n      dawn: '黎明',\n    };\n    c.fillStyle = state.phase === 'danger' ? '#ff4444' : '#aaa';\n    c.font = '11px monospace';\n    c.fillText(phaseLabels[state.phase] ?? state.phase, 160, 14);\n\n    // Money\n    c.fillStyle = '#66cc66';\n    c.font = '12px monospace';\n    c.textAlign = 'right';\n    c.fillText(`¥${state.money.toLocaleString()}`, canvasW - 12, 12);\n\n    // Debt\n    c.fillStyle = '#cc6666';\n    c.font = '10px monospace';\n    c.fillText(`债务: ¥${state.debt.toLocaleString()}`, canvasW - 12, 26);\n\n    // Health bar\n    c.textAlign = 'left';\n    const hbX = 300;\n    const hbY = 6;\n    const hbW = 80;\n    const hbH = 8;\n    c.fillStyle = 'rgba(255,255,255,0.1)';\n    c.fillRect(hbX, hbY, hbW, hbH);\n    c.fillStyle = '#cc3333';\n    c.fillRect(hbX, hbY, hbW * (state.player.health / 100), hbH);\n    c.strokeStyle = 'rgba(255,255,255,0.2)';\n    c.lineWidth = 1;\n    c.strokeRect(hbX, hbY, hbW, hbH);\n    c.fillStyle = '#aaa';\n    c.font = '8px monospace';\n    c.fillText('HP', hbX - 18, hbY + 7);\n\n    // Sanity bar\n    const sbY = 18;\n    c.fillStyle = 'rgba(255,255,255,0.1)';\n    c.fillRect(hbX, sbY, hbW, hbH);\n    c.fillStyle = '#6666cc';\n    c.fillRect(hbX, sbY, hbW * (state.player.sanity / 100), hbH);\n    c.strokeStyle = 'rgba(255,255,255,0.2)';\n    c.strokeRect(hbX, sbY, hbW, hbH);\n    c.fillStyle = '#aaa';\n    c.fillText('SAN', hbX - 22, sbY + 7);\n\n    // Customer count\n    if (ctx) {\n      const custCount = ctx.customers.length;\n      c.fillStyle = '#88aacc';\n      c.font = '10px monospace';\n      c.textAlign = 'left';\n      c.fillText(`顾客: ${custCount}`, 420, 14);\n    }\n\n    // Daily revenue\n    c.fillStyle = '#88cc88';\n    c.font = '10px monospace';\n    c.textAlign = 'left';\n    c.fillText(`今日: ¥${state.dailyRevenue.toFixed(0)}`, 500, 14);\n\n    // Shortcut hints\n    c.fillStyle = 'rgba(255,255,255,0.4)';\n    c.font = '10px monospace';\n    c.textAlign = 'center';\n    c.fillText('WASD 移动 | E 交互 | I 库存 | P 定价 | U 升级 | O 进货 | ESC 关闭', canvasW / 2, canvasH - 12);\n\n    // Notifications\n    this.renderNotifications(c, canvasW, canvasH, state);\n\n    // Register status\n    if (ctx) {\n      this.renderRegisterStatus(c, canvasW, ctx.registers);\n    }\n  }\n\n  private renderNotifications(\n    c: CanvasRenderingContext2D,\n    w: number,\n    h: number,\n    state: GameState,\n  ): void {\n    const recent = state.notifications.slice(-5);\n    if (recent.length === 0) return;\n\n    c.textAlign = 'right';\n    c.font = '10px monospace';\n    for (let i = 0; i < recent.length; i++) {\n      const alpha = 0.3 + (i / recent.length) * 0.5;\n      c.fillStyle = `rgba(200, 220, 255, ${alpha})`;\n      c.fillText(recent[i], w - 12, h - 30 - (recent.length - 1 - i) * 14);\n    }\n  }\n\n  private renderRegisterStatus(\n    c: CanvasRenderingContext2D,\n    canvasW: number,\n    registers: CashRegister[],\n  ): void {\n    let x = 12;\n    const y = 48;\n    for (const reg of registers) {\n      const stateLabels: Record<string, string> = {\n        idle: '空闲',\n        scanning: '扫描中...',\n        payment: '付款中',\n        giving_change: '找零中',\n        receipt: '打印收据',\n        anomaly: '异常!',\n      };\n      const stateColors: Record<string, string> = {\n        idle: '#666',\n        scanning: '#6a6',\n        payment: '#aa6',\n        giving_change: '#6aa',\n        receipt: '#66a',\n        anomaly: '#a44',\n      };\n      const label = stateLabels[reg.state] ?? reg.state;\n      const color = stateColors[reg.state] ?? '#666';\n\n      c.fillStyle = 'rgba(0,0,0,0.6)';\n      c.fillRect(x, y, 80, 16);\n      c.fillStyle = color;\n      c.font = '9px monospace';\n      c.textAlign = 'left';\n      c.textBaseline = 'middle';\n      c.fillText(`${reg.registerId}: ${label}`, x + 4, y + 8);\n      x += 84;\n    }\n  }\n\n  private renderPanel(\n    c: CanvasRenderingContext2D,\n    w: number,\n    h: number,\n    state: GameState,\n    ctx: RenderContext,\n  ): void {\n    // Darken background\n    c.fillStyle = 'rgba(0,0,0,0.5)';\n    c.fillRect(0, 0, w, h);\n\n    const panelW = Math.min(500, w - 40);\n    const panelH = Math.min(400, h - 80);\n    const px = (w - panelW) / 2;\n    const py = (h - panelH) / 2;\n\n    // Panel background\n    c.fillStyle = 'rgba(20, 20, 35, 0.95)';\n    c.fillRect(px, py, panelW, panelH);\n    c.strokeStyle = 'rgba(100, 120, 160, 0.5)';\n    c.lineWidth = 1;\n    c.strokeRect(px, py, panelW, panelH);\n\n    // Title bar\n    c.fillStyle = 'rgba(40, 40, 60, 0.9)';\n    c.fillRect(px, py, panelW, 30);\n\n    switch (state.activePanel) {\n      case UIPanel.SHELF:\n        this.renderShelfPanel(c, px, py, panelW, panelH, ctx);\n        break;\n      case UIPanel.INVENTORY:\n        this.renderInventoryPanel(c, px, py, panelW, panelH, ctx);\n        break;\n      case UIPanel.PRICING:\n        this.renderPricingPanel(c, px, py, panelW, panelH, ctx);\n        break;\n      case UIPanel.SHOP:\n        this.renderShopPanel(c, px, py, panelW, panelH, ctx);\n        break;\n      case UIPanel.SUPPLIER:\n        this.renderSupplierPanel(c, px, py, panelW, panelH, state, ctx);\n        break;\n    }\n\n    // Close button hint\n    c.fillStyle = 'rgba(255,255,255,0.4)';\n    c.font = '10px monospace';\n    c.textAlign = 'center';\n    c.fillText('按 ESC 或 E 关闭', w / 2, py + panelH + 15);\n  }\n\n  private renderShelfPanel(\n    c: CanvasRenderingContext2D,\n    px: number, py: number,\n    pw: number, ph: number,\n    ctx: RenderContext,\n  ): void {\n    const shelf = ctx.shelfInteraction;\n    if (!shelf.currentShelfId) return;\n\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 14px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'top';\n    c.fillText('货架管理', px + 10, py + 8);\n\n    const slot = ctx.productManager.shelfSlots.get(shelf.currentShelfId);\n    if (!slot) return;\n\n    let y = py + 40;\n\n    if (slot.productId && slot.quantity > 0) {\n      const product = ctx.productManager.getProduct(slot.productId);\n      c.fillStyle = '#aac';\n      c.font = '12px monospace';\n      c.fillText(`商品: ${product?.name ?? slot.productId}`, px + 10, y);\n      y += 18;\n      c.fillText(`库存: ${slot.quantity}/${slot.maxQuantity}`, px + 10, y);\n      y += 18;\n      const price = ctx.pricing.getPrice(slot.productId);\n      c.fillText(`售价: ¥${price.toFixed(2)}`, px + 10, y);\n      y += 30;\n    } else {\n      c.fillStyle = '#888';\n      c.font = '12px monospace';\n      c.fillText('空货架', px + 10, y);\n      y += 30;\n    }\n\n    // Available products to stock\n    c.fillStyle = '#ccc';\n    c.font = '11px monospace';\n    c.fillText('可上架商品:', px + 10, y);\n    y += 18;\n\n    const available = shelf.getAvailableProductsForShelf(shelf.currentShelfId, ctx.productManager);\n    for (let i = 0; i < Math.min(available.length, 8); i++) {\n      const item = available[i];\n      c.fillStyle = '#aab8cc';\n      c.font = '11px monospace';\n      c.fillText(`  ${item.name} x${item.quantity}`, px + 10, y);\n      y += 16;\n    }\n\n    if (available.length === 0) {\n      c.fillStyle = '#666';\n      c.fillText('  (无库存)', px + 10, y);\n    }\n  }\n\n  private renderInventoryPanel(\n    c: CanvasRenderingContext2D,\n    px: number, py: number,\n    pw: number, ph: number,\n    ctx: RenderContext,\n  ): void {\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 14px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'top';\n    c.fillText('库存管理', px + 10, py + 8);\n\n    let y = py + 40;\n    c.fillStyle = '#aaa';\n    c.font = '10px monospace';\n    c.fillText(`仓库容量: ${ctx.productManager.storageUsed}/${ctx.productManager.storageCapacity}`, px + 10, y);\n    y += 20;\n\n    for (const [id, item] of ctx.productManager.inventory) {\n      if (item.quantity <= 0) continue;\n      const product = ctx.productManager.getProduct(id);\n      const price = ctx.pricing.getPrice(id);\n      c.fillStyle = '#bbb';\n      c.font = '11px monospace';\n      c.fillText(`${product?.name ?? id}  x${item.quantity}  ¥${price.toFixed(2)}/个`, px + 10, y);\n      y += 16;\n      if (y > py + ph - 30) break;\n    }\n  }\n\n  private renderPricingPanel(\n    c: CanvasRenderingContext2D,\n    px: number, py: number,\n    pw: number, ph: number,\n    ctx: RenderContext,\n  ): void {\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 14px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'top';\n    c.fillText('定价管理', px + 10, py + 8);\n\n    let y = py + 40;\n    const prices = ctx.pricing.getAllPrices();\n\n    c.fillStyle = '#888';\n    c.font = '10px monospace';\n    c.fillText('商品           基价      现价      范围', px + 10, y);\n    y += 16;\n\n    for (const entry of prices) {\n      const product = ctx.productManager.getProduct(entry.productId);\n      if (!product) continue;\n      c.fillStyle = '#bbb';\n      c.font = '10px monospace';\n      const name = product.name.padEnd(8, '　');\n      c.fillText(\n        `${name}  ¥${entry.basePrice.toFixed(0).padStart(3)}   ¥${entry.currentPrice.toFixed(0).padStart(3)}   ${entry.minPrice.toFixed(0)}-${entry.maxPrice.toFixed(0)}`,\n        px + 10, y,\n      );\n      y += 14;\n      if (y > py + ph - 30) break;\n    }\n  }\n\n  private renderShopPanel(\n    c: CanvasRenderingContext2D,\n    px: number, py: number,\n    pw: number, ph: number,\n    ctx: RenderContext,\n  ): void {\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 14px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'top';\n    c.fillText('店铺升级', px + 10, py + 8);\n\n    let y = py + 40;\n    const upgrades = ctx.economy.getUpgrades();\n\n    for (const upgrade of upgrades) {\n      const owned = ctx.economy.hasUpgrade(upgrade.id);\n      c.fillStyle = owned ? '#5a7a5a' : '#bbb';\n      c.font = '11px monospace';\n      c.fillText(\n        `${owned ? '[已购]' : `¥${upgrade.cost}`.padStart(6)} ${upgrade.name} — ${upgrade.description}`,\n        px + 10, y,\n      );\n      y += 16;\n      c.fillStyle = '#777';\n      c.font = '9px monospace';\n      c.fillText(`  ${upgrade.horrorLink}`, px + 10, y);\n      y += 14;\n      if (y > py + ph - 30) break;\n    }\n  }\n\n  private renderSupplierPanel(\n    c: CanvasRenderingContext2D,\n    px: number, py: number,\n    pw: number, ph: number,\n    state: GameState,\n    ctx: RenderContext,\n  ): void {\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 14px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'top';\n    c.fillText('进货管理', px + 10, py + 8);\n\n    let y = py + 40;\n\n    // Show suppliers\n    const isNight = isNightTime(state.phase);\n    const suppliers = ctx.productManager.getUnlockedSuppliers(state.day, isNight);\n    c.fillStyle = '#888';\n    c.font = '10px monospace';\n    c.fillText('可用供应商:', px + 10, y);\n    y += 16;\n\n    for (const supplier of suppliers) {\n      c.fillStyle = '#aab8cc';\n      c.font = '11px monospace';\n      c.fillText(`${supplier.name} — ${supplier.description}`, px + 10, y);\n      y += 14;\n      c.fillStyle = '#777';\n      c.font = '9px monospace';\n      c.fillText(`  价格x${supplier.priceMultiplier} 可靠度${Math.round(supplier.reliability * 100)}%`, px + 10, y);\n      y += 16;\n    }\n\n    y += 10;\n\n    // Pending orders\n    if (ctx.productManager.pendingOrders.length > 0) {\n      c.fillStyle = '#888';\n      c.font = '10px monospace';\n      c.fillText('待到货订单:', px + 10, y);\n      y += 16;\n\n      for (const order of ctx.productManager.pendingOrders) {\n        const product = ctx.productManager.getProduct(order.productId);\n        c.fillStyle = '#cc9';\n        c.font = '10px monospace';\n        c.fillText(`${product?.name ?? order.productId} x${order.quantity} — ¥${order.totalCost} (Day ${order.arrivalDay}到)`, px + 10, y);\n        y += 14;\n        if (y > py + ph - 30) break;\n      }\n    }\n  }\n\n  destroy(): void {}\n}\n","structuredPatch":[{"oldStart":112,"oldLines":6,"newStart":112,"newLines":11,"lines":["     if (ctx && state.activePanel !== UIPanel.NONE) {","       this.renderPanel(c, w, h, state, ctx);","     }","+","+    // M3: Render day summary overlay","+    if (ctx?.daySummary) {","+      ctx.daySummary.render(c, w, h);","+    }","   }"," ","   private renderShelfIndicators("]}],"userModified":false,"replaceAll":false}}
