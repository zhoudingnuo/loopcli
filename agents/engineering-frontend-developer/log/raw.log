itial' ? 'interstitial' : 'rewarded',\n    });\n  }\n\n  trackAdClick(placement) {\n    this.track(ANALYTICS_EVENTS.AD_CLICK, { placement });\n  }\n\n  trackShare(type, extra) {\n    this.track(ANALYTICS_EVENTS.SHARE, { type, ...(extra || {}) });\n  }\n\n  trackPKStart() {\n    this.track(ANALYTICS_EVENTS.PK_START);\n  }\n\n  trackPKResult(result, correctCount, timeMs) {\n    this.track(ANALYTICS_EVENTS.PK_RESULT, { result, correctCount, timeMs });\n  }\n\n  trackTimedStart() {\n    this.track(ANALYTICS_EVENTS.TIMED_START);\n  }\n\n  trackTimedEnd(score, correctCount, totalQuestions, maxCombo) {\n    this.track(ANALYTICS_EVENTS.TIMED_END, {\n      score, correctCount, totalQuestions, maxCombo,\n    });\n  }\n\n  trackCollectionUnlock(idiomId, category, totalCollected) {\n    this.track(ANALYTICS_EVENTS.COLLECTION_UNLOCK, {\n      idiomId, category, totalCollected,\n    });\n  }\n\n  trackCharacterUse(characterId) {\n    this.track(ANALYTICS_EVENTS.CHARACTER_USE, { characterId });\n  }\n\n  trackDailyLogin(day, reward) {\n    this.track(ANALYTICS_EVENTS.DAILY_LOGIN, { day, reward });\n  }\n\n  flush() {\n    if (this.data.queue.length === 0) return;\n    const batch = this.data.queue.splice(0, this.maxQueueSize);\n    this.dm.save();\n\n    if (this.isDouyin) {\n      this._uploadToServer(batch);\n    } else if (typeof console !== 'undefined') {\n      console.debug(`[Analytics] Flush ${batch.length} events`, batch);\n    }\n  }\n\n  _uploadToServer(events) {\n    try {\n      const request = tt.request || fetch;\n      if (request) {\n        request({\n          url: 'https://analytics.example.com/events',\n          method: 'POST',\n          data: { events, appId: 'idiom-master' },\n        }).catch(() => {\n          this.data.queue.unshift(...events);\n          this.dm.save();\n        });\n      }\n    } catch (e) { /* analytics never blocks gameplay */ }\n  }\n\n  newSession() {\n    this.data.sessionId = this._genSessionId();\n    this.dm.save();\n  }\n\n  startFlushTimer() {\n    if (this._flushTimer) clearInterval(this._flushTimer);\n    this._flushTimer = setInterval(() => this.flush(), this.flushInterval);\n  }\n\n  stopFlushTimer() {\n    if (this._flushTimer) { clearInterval(this._flushTimer); this._flushTimer = null; }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Analytics, ANALYTICS_EVENTS };\n","structuredPatch":[],"originalFile":null,"userModified":false}}
