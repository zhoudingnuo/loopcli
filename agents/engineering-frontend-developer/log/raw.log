9\t    if (type === this.currentBgm) return;\n240\t    this.stopBgm();\n241\t    this.currentBgm = type;\n242\t\n243\t    const ctx = this.ensureCtx();\n244\t    if (!ctx || !this.bgmGain) return;\n245\t\n246\t    switch (type) {\n247\t      case 'daytime':\n248\t        this.createDaytimeBgm(ctx);\n249\t        break;\n250\t      case 'night':\n251\t        this.createNightBgm(ctx);\n252\t        break;\n253\t      case 'danger':\n254\t        this.createDangerBgm(ctx);\n255\t        break;\n256\t    }\n257\t  }\n258\t\n259\t  private createDaytimeBgm(ctx: AudioContext): void {\n260\t    // Gentle ambient pad\n261\t    const freqs = [220, 277, 330];\n262\t    for (const f of freqs) {\n263\t      const osc = ctx.createOscillator();\n264\t      const gain = ctx.createGain();\n265\t      osc.type = 'sine';\n266\t      osc.frequency.value = f;\n267\t      gain.gain.value = 0.02;\n268\t      osc.connect(gain).connect(this.bgmGain!);\n269\t      osc.start();\n270\t      this.bgmOscillators.push(osc);\n271\t      this.bgmNodes.push(gain);\n272\t    }\n273\t  }\n274\t\n275\t  private createNightBgm(ctx: AudioContext): void {\n276\t    // Eerie drone\n277\t    const freqs = [55, 82.5, 110];\n278\t    for (const f of freqs) {\n279\t      const osc = ctx.createOscillator();\n280\t      const gain = ctx.createGain();\n281\t      osc.type = 'sine';\n282\t      osc.frequency.value = f;\n283\t      // Slow LFO\n284\t      const lfo = ctx.createOscillator();\n285\t      const lfoGain = ctx.createGain();\n286\t      lfo.frequency.value = 0.1 + Math.random() * 0.2;\n287\t      lfoGain.gain.value = f * 0.02;\n288\t      lfo.connect(lfoGain).connect(osc.frequency);\n289\t      lfo.start();\n290\t\n291\t      gain.gain.value = 0.025;\n292\t      osc.connect(gain).connect(this.bgmGain!);\n293\t      osc.start();\n294\t      this.bgmOscillators.push(osc, lfo);\n295\t      this.bgmNodes.push(gain, lfoGain);\n296\t    }\n297\t  }\n298\t\n299\t  private createDangerBgm(ctx: AudioContext): void {\n300\t    // Disturbing drone + heartbeat\n301\t    const bass = ctx.createOscillator();\n302\t    const bassGain = ctx.createGain();\n303\t    bass.type = 'sawtooth';\n304\t    bass.frequency.value = 40;\n305\t    const filter = ctx.createBiquadFilter();\n306\t    filter.type = 'lowpass';\n307\t    filter.frequency.value = 120;\n308\t    bassGain.gain.value = 0.03;\n309\t    bass.connect(filter).connect(bassGain).connect(this.bgmGain!);\n310\t    bass.start();\n311\t    this.bgmOscillators.push(bass);\n312\t    this.bgmNodes.push(bassGain, filter);\n313\t\n314\t    // Heartbeat-like pulse\n315\t    const pulse = ctx.createOscillator();\n316\t    const pulseGain = ctx.createGain();\n317\t    pulse.type = 'sine';\n318\t    pulse.frequency.value = 50;\n319\t    // Rhythmic gain modulation via LFO\n320\t    const pulseLfo = ctx.createOscillator();\n321\t    const pulseLfoGain = ctx.createGain();\n322\t    pulseLfo.frequency.value = 1.2; // ~72 bpm heartbeat\n323\t    pulseLfoGain.gain.value = 0.04;\n324\t    pulseLfo.connect(pulseLfoGain).connect(pulseGain.gain);\n325\t    pulseLfo.start();\n326\t    pulseGain.gain.value = 0.03;\n327\t    pulse.connect(pulseGain).connect(this.bgmGain!);\n328\t    pulse.start();\n329\t    this.bgmOscillators.push(pulse, pulseLfo);\n330\t    this.bgmNodes.push(pulseGain, pulseLfoGain);\n331\t  }\n332\t\n333\t  stopBgm(): void {\n334\t    for (const osc of this.bgmOscillators) {\n335\t      try { osc.stop(); } catch { /* already stopped */ }\n336\t    }\n337\t    this.bgmOscillators = [];\n338\t    this.bgmNodes = [];\n339\t    this.currentBgm = 'silence';\n340\t  }\n341\t\n342\t  // --- Volume ---\n343\t\n344\t  setMasterVolume(v: number): void {\n345\t    this.volume = Math.max(0, Math.min(1, v));\n346\t    if (this.masterGain) this.masterGain.gain.value = this.volume;\n347\t  }\n348\t\n349\t  setBgmVolume(v: number): void {\n350\t    this.bgmVolume = Math.max(0, Math.min(1, v));\n351\t    if (this.bgmGain) this.bgmGain.gain.value = this.bgmVolume;\n352\t  }\n353\t\n354\t  setSfxVolume(v: number): void {\n355\t    this.sfxVolume = Math.max(0, Math.min(1, v));\n356\t    if (this.sfxGain) this.sfxGain.gain.value = this.sfxVolume;\n357\t  }\n358\t\n359\t  get masterVolume(): number { return this.volume; }\n360\t  get currentBgmType(): string { return this.currentBgm; }\n361\t\n362\t  destroy(): void {\n363\t    this.stopBgm();\n364\t    if (this.ctx) {\n365\t      this.ctx.close();\n366\t      this.ctx = null;\n367\t    }\n368\t    this.initialized = false;\n369\t  }\n370\t}\n371\t"}]},"parent_tool_use_id":null,"session_id":"328f9d51-5f9c-4f63-927e-7b99009d6517","uuid":"eddab25b-7866-41ca-83a7-2093bfe7af72","timestamp":"2026-05-23T05:39:25.288Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/steam-horror-sim/src/game/AudioManager.ts","content":"// AudioManager.ts — Web Audio API sound system with horror effects (M4)\n\nexport class AudioManager {\n  private ctx: AudioContext | null = null;\n  private masterGain: GainNode | null = null;\n  private bgmGain: GainNode | null = null;\n  private sfxGain: GainNode | null = null;\n  private volume = 0.7;\n  private bgmVolume = 0.3;\n  private sfxVolume = 0.5;\n  private initialized = false;\n  private currentBgm: 'daytime' | 'night' | 'danger' | 'silence' = 'silence';\n  private bgmOscillators: OscillatorNode[] = [];\n  private bgmNodes: AudioNode[] = [];\n\n  init(): void {\n    if (this.initialized) return;\n    try {\n      this.ctx = new AudioContext();\n      this.masterGain = this.ctx.createGain();\n      this.masterGain.gain.value = this.volume;\n      this.masterGain.connect(this.ctx.destination);\n\n      this.bgmGain = this.ctx.createGain();\n      this.bgmGain.gain.value = this.bgmVolume;\n      this.bgmGain.connect(this.masterGain);\n\n      this.sfxGain = this.ctx.createGain();\n      this.sfxGain.gain.value = this.sfxVolume;\n      this.sfxGain.connect(this.masterGain);\n\n      this.initialized = true;\n    } catch {\n      console.warn('AudioManager: Web Audio API not available');\n    }\n  }\n\n  private ensureCtx(): AudioContext | null {\n    if (!this.initialized) this.init();\n    if (this.ctx?.state === 'suspended') this.ctx.resume();\n    return this.ctx;\n  }\n\n  // --- SFX ---\n\n  playCollect(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(880, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(1760, ctx.currentTime + 0.1);\n    gain.gain.setValueAtTime(0.2, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.15);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.15);\n  }\n\n  playBuild(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'square';\n    osc.frequency.setValueAtTime(220, ctx.currentTime);\n    osc.frequency.setValueAtTime(330, ctx.currentTime + 0.08);\n    osc.frequency.setValueAtTime(440, ctx.currentTime + 0.16);\n    gain.gain.setValueAtTime(0.15, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.25);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.25);\n  }\n\n  playTransaction(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(660, ctx.currentTime);\n    osc.frequency.setValueAtTime(880, ctx.currentTime + 0.06);\n    gain.gain.setValueAtTime(0.15, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.12);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.12);\n  }\n\n  playBreakthrough(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Rising tone\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.setValueAtTime(200, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(1200, ctx.currentTime + 0.8);\n    gain.gain.setValueAtTime(0.3, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.0);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 1.0);\n\n    // Shimmer\n    for (let i = 0; i < 5; i++) {\n      const s = ctx.createOscillator();\n      const sg = ctx.createGain();\n      s.type = 'sine';\n      s.frequency.value = 800 + i * 200;\n      sg.gain.setValueAtTime(0, ctx.currentTime + 0.4 + i * 0.1);\n      sg.gain.linearRampToValueAtTime(0.1, ctx.currentTime + 0.5 + i * 0.1);\n      sg.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.2 + i * 0.1);\n      s.connect(sg).connect(this.sfxGain);\n      s.start(ctx.currentTime + 0.4 + i * 0.1);\n      s.stop(ctx.currentTime + 1.3 + i * 0.1);\n    }\n  }\n\n  // --- Horror SFX ---\n\n  playHorrorFlicker(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Buzzing electrical sound\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(60, ctx.currentTime);\n    osc.frequency.linearRampToValueAtTime(120, ctx.currentTime + 0.1);\n    osc.frequency.linearRampToValueAtTime(60, ctx.currentTime + 0.2);\n    gain.gain.setValueAtTime(0.08, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 0.3);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.3);\n  }\n\n  playHorrorWhisper(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Filtered noise for whisper effect\n    const bufferSize = ctx.sampleRate * 1.5;\n    const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);\n    const data = buffer.getChannelData(0);\n    for (let i = 0; i < bufferSize; i++) {\n      data[i] = (Math.random() * 2 - 1) * 0.3;\n    }\n    const source = ctx.createBufferSource();\n    source.buffer = buffer;\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'bandpass';\n    filter.frequency.value = 800;\n    filter.Q.value = 2;\n    const gain = ctx.createGain();\n    gain.gain.setValueAtTime(0, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0.15, ctx.currentTime + 0.5);\n    gain.gain.linearRampToValueAtTime(0.1, ctx.currentTime + 1.0);\n    gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 1.5);\n    source.connect(filter).connect(gain).connect(this.sfxGain);\n    source.start();\n    source.stop(ctx.currentTime + 1.5);\n  }\n\n  playHorrorDoorCreak(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Low creaking sound\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(40, ctx.currentTime);\n    osc.frequency.linearRampToValueAtTime(80, ctx.currentTime + 0.5);\n    osc.frequency.linearRampToValueAtTime(50, ctx.currentTime + 1.0);\n    gain.gain.setValueAtTime(0.1, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0.15, ctx.currentTime + 0.3);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.2);\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'lowpass';\n    filter.frequency.value = 300;\n    osc.connect(filter).connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 1.2);\n  }\n\n  playHorrorSuddenSilence(): void {\n    // The absence of sound is scarier — handled by BGM crossfade\n    this.stopBgm();\n  }\n\n  playHorrorJumpScare(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    // Sharp stinger\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(200, ctx.currentTime);\n    osc.frequency.exponentialRampToValueAtTime(2000, ctx.currentTime + 0.05);\n    gain.gain.setValueAtTime(0.4, ctx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.5);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 0.5);\n\n    // Sub-bass hit\n    const sub = ctx.createOscillator();\n    const subGain = ctx.createGain();\n    sub.type = 'sine';\n    sub.frequency.value = 30;\n    subGain.gain.setValueAtTime(0.5, ctx.currentTime);\n    subGain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.8);\n    sub.connect(subGain).connect(this.sfxGain);\n    sub.start();\n    sub.stop(ctx.currentTime + 0.8);\n  }\n\n  playHorrorAmbientDrone(): void {\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.sfxGain) return;\n    const osc = ctx.createOscillator();\n    const gain = ctx.createGain();\n    osc.type = 'sine';\n    osc.frequency.value = 55;\n    gain.gain.setValueAtTime(0, ctx.currentTime);\n    gain.gain.linearRampToValueAtTime(0.08, ctx.currentTime + 2);\n    gain.gain.linearRampToValueAtTime(0.05, ctx.currentTime + 4);\n    gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 6);\n    osc.connect(gain).connect(this.sfxGain);\n    osc.start();\n    osc.stop(ctx.currentTime + 6);\n  }\n\n  // --- BGM ---\n\n  playBgm(type: 'daytime' | 'night' | 'danger'): void {\n    if (type === this.currentBgm) return;\n    this.stopBgm();\n    this.currentBgm = type;\n\n    const ctx = this.ensureCtx();\n    if (!ctx || !this.bgmGain) return;\n\n    switch (type) {\n      case 'daytime':\n        this.createDaytimeBgm(ctx);\n        break;\n      case 'night':\n        this.createNightBgm(ctx);\n        break;\n      case 'danger':\n        this.createDangerBgm(ctx);\n        break;\n    }\n  }\n\n  private createDaytimeBgm(ctx: AudioContext): void {\n    // Gentle ambient pad\n    const freqs = [220, 277, 330];\n    for (const f of freqs) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = f;\n      gain.gain.value = 0.02;\n      osc.connect(gain).connect(this.bgmGain!);\n      osc.start();\n      this.bgmOscillators.push(osc);\n      this.bgmNodes.push(gain);\n    }\n  }\n\n  private createNightBgm(ctx: AudioContext): void {\n    // Eerie drone\n    const freqs = [55, 82.5, 110];\n    for (const f of freqs) {\n      const osc = ctx.createOscillator();\n      const gain = ctx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = f;\n      // Slow LFO\n      const lfo = ctx.createOscillator();\n      const lfoGain = ctx.createGain();\n      lfo.frequency.value = 0.1 + Math.random() * 0.2;\n      lfoGain.gain.value = f * 0.02;\n      lfo.connect(lfoGain).connect(osc.frequency);\n      lfo.start();\n\n      gain.gain.value = 0.025;\n      osc.connect(gain).connect(this.bgmGain!);\n      osc.start();\n      this.bgmOscillators.push(osc, lfo);\n      this.bgmNodes.push(gain, lfoGain);\n    }\n  }\n\n  private createDangerBgm(ctx: AudioContext): void {\n    // Disturbing drone + heartbeat\n    const bass = ctx.createOscillator();\n    const bassGain = ctx.createGain();\n    bass.type = 'sawtooth';\n    bass.frequency.value = 40;\n    const filter = ctx.createBiquadFilter();\n    filter.type = 'lowpass';\n    filter.frequency.value = 120;\n    bassGain.gain.value = 0.03;\n    bass.connect(filter).connect(bassGain).connect(this.bgmGain!);\n    bass.start();\n    this.bgmOscillators.push(bass);\n    this.bgmNodes.push(bassGain, filter);\n\n    // Heartbeat-like pulse\n    const pulse = ctx.createOscillator();\n    const pulseGain = ctx.createGain();\n    pulse.type = 'sine';\n    pulse.frequency.value = 50;\n    // Rhythmic gain modulation via LFO\n    const pulseLfo = ctx.createOscillator();\n    const pulseLfoGain = ctx.createGain();\n    pulseLfo.frequency.value = 1.2; // ~72 bpm heartbeat\n    pulseLfoGain.gain.value = 0.04;\n    pulseLfo.connect(pulseLfoGain).connect(pulseGain.gain);\n    pulseLfo.start();\n    pulseGain.gain.value = 0.03;\n    pulse.connect(pulseGain).connect(this.bgmGain!);\n    pulse.start();\n    this.bgmOscillators.push(pulse, pulseLfo);\n    this.bgmNodes.push(pulseGain, pulseLfoGain);\n  }\n\n  stopBgm(): void {\n    for (const osc of this.bgmOscillators) {\n      try { osc.stop(); } catch { /* already stopped */ }\n    }\n    this.bgmOscillators = [];\n    this.bgmNodes = [];\n    this.currentBgm = 'silence';\n  }\n\n  // --- Volume ---\n\n  setMasterVolume(v: number): void {\n    this.volume = Math.max(0, Math.min(1, v));\n    if (this.masterGain) this.masterGain.gain.value = this.volume;\n  }\n\n  setBgmVolume(v: number): void {\n    this.bgmVolume = Math.max(0, Math.min(1, v));\n    if (this.bgmGain) this.bgmGain.gain.value = this.bgmVolume;\n  }\n\n  setSfxVolume(v: number): void {\n    this.sfxVolume = Math.max(0, Math.min(1, v));\n    if (this.sfxGain) this.sfxGain.gain.value = this.sfxVolume;\n  }\n\n  get masterVolume(): number { return this.volume; }\n  get currentBgmType(): string { return this.currentBgm; }\n\n  destroy(): void {\n    this.stopBgm();\n    if (this.ctx) {\n      this.ctx.close();\n      this.ctx = null;\n    }\n    this.initialized = false;\n  }\n}\n","numLines":371,"startLine":1,"totalLines":371}}}
