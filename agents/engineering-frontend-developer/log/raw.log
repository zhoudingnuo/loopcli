 translateX(5px); }\n158\t}\n159\t\n160\t.meaning-box {\n161\t  background: #FFFDF7; border: 2px solid #E8DED0;\n162\t  border-radius: 12px; padding: 14px 20px;\n163\t  text-align: center; max-width: 90%; min-height: 50px;\n164\t  box-shadow: 0 2px 8px rgba(0,0,0,0.05);\n165\t}\n166\t#meaning-text { font-size: 16px; line-height: 1.5; color: #2C2C2C; }\n167\t\n168\t.slots-container {\n169\t  display: flex; gap: 10px; margin: 8px 0;\n170\t}\n171\t\n172\t.slot {\n173\t  width: 60px; height: 60px;\n174\t  border: 3px solid #8B7355; border-radius: 10px;\n175\t  background: #FFFDF7; display: flex;\n176\t  align-items: center; justify-content: center;\n177\t  font-size: 28px; font-weight: bold; color: #2C2C2C;\n178\t  cursor: pointer; transition: all 0.2s;\n179\t  position: relative;\n180\t}\n181\t.slot.filled { background: #FFF8E8; border-color: #C84B31; }\n182\t.slot.correct {\n183\t  background: #27AE60; border-color: #27AE60; color: white;\n184\t  animation: correctPulse 0.4s;\n185\t}\n186\t.slot.wrong {\n187\t  background: #E74C3C; border-color: #E74C3C; color: white;\n188\t  animation: wrongShake 0.5s;\n189\t}\n190\t\n191\t@keyframes correctPulse {\n192\t  0%, 100% { transform: scale(1); }\n193\t  50% { transform: scale(1.12); }\n194\t}\n195\t@keyframes wrongShake {\n196\t  0%, 100% { transform: translateX(0); }\n197\t  25% { transform: translateX(-8px); }\n198\t  75% { transform: translateX(8px); }\n199\t}\n200\t\n201\t.idiom-hint {\n202\t  font-size: 13px; color: #8B7355; text-align: center;\n203\t  padding: 6px 12px; background: rgba(255,255,255,0.7);\n204\t  border-radius: 8px; display: none; max-width: 90%;\n205\t}\n206\t.idiom-hint strong { color: #C84B31; }\n207\t\n208\t.candidates-container {\n209\t  display: flex; flex-wrap: wrap; gap: 8px;\n210\t  justify-content: center; max-width: 340px; margin-top: 8px;\n211\t}\n212\t\n213\t.candidate {\n214\t  width: 48px; height: 48px; border: none; border-radius: 10px;\n215\t  background: linear-gradient(135deg, #C84B