{"type":"assistant","message":{"id":"msg_2026052310364137079840d02444c7","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_cf8a268524f44178ae57355c","name":"Write","input":{"file_path":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Settings.ts","content":"// Settings.ts — Game settings management (v0.5.0)\n\nexport interface GameSettings {\n  masterVolume: number;       // 0-100\n  sfxVolume: number;          // 0-100\n  musicVolume: number;        // 0-100\n  resolution: { width: number; height: number };\n  fullscreen: boolean;\n  language: 'zh-CN' | 'en';\n  autoSaveInterval: number;   // seconds\n  showFPS: boolean;\n  particleQuality: 'low' | 'medium' | 'high';\n}\n\nconst SETTINGS_KEY = 'cultivation_factory_settings';\n\nconst DEFAULT_SETTINGS: GameSettings = {\n  masterVolume: 80,\n  sfxVolume: 100,\n  musicVolume: 70,\n  resolution: { width: 1280, height: 800 },\n  fullscreen: false,\n  language: 'zh-CN',\n  autoSaveInterval: 60,\n  showFPS: true,\n  particleQuality: 'high',\n};\n\nconst AVAILABLE_RESOLUTIONS = [\n  { width: 960, height: 600 },\n  { width: 1280, height: 800 },\n  { width: 1600, height: 900 },\n  { width: 1920, height: 1080 },\n];\n\nexport function getAvailableResolutions() {\n  return AVAILABLE_RESOLUTIONS;\n}\n\nexport function loadSettings(): GameSettings {\n  try {\n    const raw = localStorage.getItem(SETTINGS_KEY);\n    if (!raw) return { ...DEFAULT_SETTINGS };\n    const parsed = JSON.parse(raw);\n    return { ...DEFAULT_SETTINGS, ...parsed };\n  } catch {\n    return { ...DEFAULT_SETTINGS };\n  }\n}\n\nexport function saveSettings(settings: GameSettings): void {\n  try {\n    localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));\n  } catch {\n    // Storage full or unavailable\n  }\n}\n\nexport function updateSetting<K extends keyof GameSettings>(\n  settings: GameSettings,\n  key: K,\n  value: GameSettings[K],\n): GameSettings {\n  const next = { ...settings, [key]: value };\n  saveSettings(next);\n  return next;\n}\n\nexport function getDefaultSettings(): GameSettings {\n  return { ...DEFAULT_SETTINGS };\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"6abd1a50-ca4f-4f48-ad3d-d0b1dc08d31a","uuid":"9aae2f27-0d83-4a32-8fbc-9667a51ab3f6"}
{"type":"assistant","message":{"id":"msg_2026052310364137079840d02444c7","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_d134da509575470ba56632e8","name":"Write","input":{"file_path":"D:\\game-projects\\steam-cultivation-factory\\src\\main\\preload.ts","content":"// preload.ts — Electron preload script for IPC bridge (v0.5.0)\n\nimport { contextBridge, ipcRenderer } from 'electron';\n\ncontextBridge.exposeInMainWorld('electronAPI', {\n  // Settings\n  getSettings: () => ipcRenderer.invoke('settings:get'),\n  setSettings: (settings: any) => ipcRenderer.invoke('settings:set', settings),\n  setFullscreen: (fullscreen: boolean) => ipcRenderer.invoke('window:fullscreen', fullscreen),\n  setResolution: (w: number, h: number) => ipcRenderer.invoke('window:resolution', w, h),\n\n  // Steam\n  isSteamAvailable: () => ipcRenderer.invoke('steam:isAvailable'),\n  unlockAchievement: (id: string) => ipcRenderer.invoke('steam:unlockAchievement', id),\n  cloudSave: (data: string) => ipcRenderer.invoke('steam:cloudSave', data),\n  cloudLoad: () => ipcRenderer.invoke('steam:cloudLoad'),\n\n  // App\n  getAppVersion: () => ipcRenderer.invoke('app:version'),\n  quit: () => ipcRenderer.invoke('app:quit'),\n});\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"6abd1a50-ca4f-4f48-ad3d-d0b1dc08d31a","uuid":"7a9cc9e8-a113-4dc5-966d-73055622cacd"}
