{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f323462d7b264b40a387592d","type":"tool_result","content":"1\t// CustomerManager.ts — Spawns and manages customers throughout the day (M2)\n2\t\n3\timport { Customer, CustomerType, CustomerState } from './Customer';\n4\timport { ProductManager } from './ProductManager';\n5\t\n6\texport interface SpawnSchedule {\n7\t  type: CustomerType;\n8\t  startHour: number;\n9\t  endHour: number;\n10\t  spawnRate: number; // customers per game-hour\n11\t  maxConcurrent: number;\n12\t}\n13\t\n14\tconst SPAWN_SCHEDULES: SpawnSchedule[] = [\n15\t  { type: CustomerType.COMMUTER, startHour: 7, endHour: 9, spawnRate: 4, maxConcurrent: 3 },\n16\t  { type: CustomerType.LUNCH, startHour: 11.5, endHour: 13, spawnRate: 3, maxConcurrent: 2 },\n17\t  { type: CustomerType.STUDENT, startHour: 15, endHour: 18, spawnRate: 5, maxConcurrent: 4 },\n18\t  { type: CustomerType.RESIDENT, startHour: 18, endHour: 21, spawnRate: 3, maxConcurrent: 2 },\n19\t  { type: CustomerType.NIGHT, startHour: 23, endHour: 2, spawnRate: 1, maxConcurrent: 1 },\n20\t];\n21\t\n22\tlet customerCounter = 0;\n23\t\n24\texport class CustomerManager {\n25\t  customers: Customer[] = new Map() as unknown as Customer[];\n26\t  private activeCustomers: Map<string, Customer> = new Map();\n27\t  private spawnAccumulators: Map<string, number> = new Map();\n28\t  private totalServed = 0;\n29\t  private totalLost = 0;\n30\t  private totalRevenue = 0;\n31\t\n32\t  constructor() {\n33\t    for (const sched of SPAWN_SCHEDULES) {\n34\t      this.spawnAccumulators.set(sched.type, 0);\n35\t    }\n36\t  }\n37\t\n38\t  update(dt: number, timeOfDay: number, day: number, productManager: ProductManager): Customer[] {\n39\t    const dtSec = dt / 1000;\n40\t    const dtHours = dtSec * 0.05; // approximate game-hour conversion\n41\t\n42\t    // Spawn new customers based on schedule\n43\t    for (const sched of SPAWN_SCHEDULES) {\n44\t      const inRange = this.isInTimeRange(timeOfDay, sched.startHour, sched.endHour);\n45\t      if (!inRange) continue;\n46\t      if (sched.type === CustomerType.NIGHT && day < 2) continue;\n47\t\n48\t      const current = this.getCustomerCountByType(sched.type);\n49\t      if (current >= sched.maxConcurrent) continue;\n50\t"}]},"parent_tool_use_id":null,"session_id":"e8f5bde0-4da8-4c4a-9322-50945e66ead7","uuid":"a15f3378-189f-4b01-aa6d-4400032a416b","timestamp":"2026-05-23T04:37:23.213Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-horror-sim\\src\\game\\CustomerManager.ts","content":"// CustomerManager.ts — Spawns and manages customers throughout the day (M2)\n\nimport { Customer, CustomerType, CustomerState } from './Customer';\nimport { ProductManager } from './ProductManager';\n\nexport interface SpawnSchedule {\n  type: CustomerType;\n  startHour: number;\n  endHour: number;\n  spawnRate: number; // customers per game-hour\n  maxConcurrent: number;\n}\n\nconst SPAWN_SCHEDULES: SpawnSchedule[] = [\n  { type: CustomerType.COMMUTER, startHour: 7, endHour: 9, spawnRate: 4, maxConcurrent: 3 },\n  { type: CustomerType.LUNCH, startHour: 11.5, endHour: 13, spawnRate: 3, maxConcurrent: 2 },\n  { type: CustomerType.STUDENT, startHour: 15, endHour: 18, spawnRate: 5, maxConcurrent: 4 },\n  { type: CustomerType.RESIDENT, startHour: 18, endHour: 21, spawnRate: 3, maxConcurrent: 2 },\n  { type: CustomerType.NIGHT, startHour: 23, endHour: 2, spawnRate: 1, maxConcurrent: 1 },\n];\n\nlet customerCounter = 0;\n\nexport class CustomerManager {\n  customers: Customer[] = new Map() as unknown as Customer[];\n  private activeCustomers: Map<string, Customer> = new Map();\n  private spawnAccumulators: Map<string, number> = new Map();\n  private totalServed = 0;\n  private totalLost = 0;\n  private totalRevenue = 0;\n\n  constructor() {\n    for (const sched of SPAWN_SCHEDULES) {\n      this.spawnAccumulators.set(sched.type, 0);\n    }\n  }\n\n  update(dt: number, timeOfDay: number, day: number, productManager: ProductManager): Customer[] {\n    const dtSec = dt / 1000;\n    const dtHours = dtSec * 0.05; // approximate game-hour conversion\n\n    // Spawn new customers based on schedule\n    for (const sched of SPAWN_SCHEDULES) {\n      const inRange = this.isInTimeRange(timeOfDay, sched.startHour, sched.endHour);\n      if (!inRange) continue;\n      if (sched.type === CustomerType.NIGHT && day < 2) continue;\n\n      const current = this.getCustomerCountByType(sched.type);\n      if (current >= sched.maxConcurrent) continue;\n","numLines":50,"startLine":1,"totalLines":176}}}
