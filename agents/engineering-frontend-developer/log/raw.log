{"type":"assistant","message":{"id":"msg_2026052308425327873e525c8f4549","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_b96bbd972f684f588c83bac6","name":"Write","input":{"file_path":"D:/game-projects/douyin-idiom/src/js/AdManager.js","content":"// AdManager.js — 成语大闯关穿山甲SDK广告管理，适配DOM渲染\n// 广告位ID配置在 ad-config.js 中，提审前替换为真实ID\n\nconst AD_PLACEMENTS = {\n  HINT_REVEAL: 'hint_reveal',       // 揭示1字（激励视频）\n  HINT_REMOVE: 'hint_remove',       // 去干扰（激励视频）\n  DOUBLE_REWARD: 'double_reward',   // 双倍结算（激励视频）\n  CONTINUE: 'continue',             // 续命（激励视频）\n  INTERSTITIAL: 'interstitial',     // 关卡间插屏\n  DAILY_DOUBLE: 'daily_double',     // 每日签到翻倍（激励视频）\n};\n\nconst AD_LIMITS = {\n  REWARDED_DAILY: 15,\n  INTERSTITIAL_DAILY: 8,\n  COOLDOWN_MS: 90000,\n  NEW_USER_FREE_LEVELS: 3,\n  INTERSTITIAL_LEVEL_INTERVAL: 2,\n};\n\nclass AdManager {\n  constructor(dataManager) {\n    this.dm = dataManager;\n    this._initStorage();\n\n    const config = (typeof AD_CONFIG !== 'undefined') ? AD_CONFIG : null;\n    this.isDouyin = config ? !config.devMode\n      : (typeof tt !== 'undefined' && typeof tt.createRewardedVideoAd === 'function');\n    this.rewardedAd = null;\n    this.interstitialAd = null;\n    this._loadRetry = 0;\n    this._maxRetry = config ? config.loadRetryCount : 2;\n    this._loadTimeout = config ? config.loadTimeout : 10000;\n\n    if (this.isDouyin) this._initSDK();\n\n    this._pendingResolve = null;\n    this._currentPlacement = null;\n    this._showingUI = false;\n    this._stubTimer = 0;\n    this._stubResolve = null;\n    this._stubPlacement = null;\n    this._stubInterstitial = false;\n  }\n\n  _initStorage() {\n    if (!this.dm.data.adState) {\n      this.dm.data.adState = {\n        dailyRewarded: 0,\n        dailyInterstitial: 0,\n        lastShowTime: {},\n        lastInterstitialLevel: 0,\n        date: this._todayStr(),\n        consecutiveFails: 0,\n      };\n      this.dm.save();\n    }\n    this.adState = this.dm.data.adState;\n    this._resetDaily();\n  }\n\n  _todayStr() { return new Date().toISOString().slice(0, 10); }\n\n  _resetDaily() {\n    if (this.adState.date !== this._todayStr()) {\n      this.adState.dailyRewarded = 0;\n      this.adState.dailyInterstitial = 0;\n      this.adState.date = this._todayStr();\n      this.dm.save();\n    }\n  }\n\n  _getAdUnitId(type) {\n    const config = (typeof AD_CONFIG !== 'undefined') ? AD_CONFIG : null;\n    if (config && config.adUnitIds && config.adUnitIds[type]) return config.adUnitIds[type];\n    return `adunit-placeholder-${type}`;\n  }\n\n  _initSDK() {\n    try {\n      const rewardedId = this._getAdUnitId('rewarded');\n      this.rewardedAd = tt.createRewardedVideoAd({ adUnitId: rewardedId });\n      this.rewardedAd.onLoad(() => { this._loadRetry = 0; });\n      this.rewardedAd.onError((err) => {\n        console.warn('[AdManager] Rewarded ad error:', err);\n        if (this._loadRetry < this._maxRetry) {\n          this._loadRetry++;\n          setTimeout(() => this.rewardedAd.load(), 1000 * this._loadRetry);\n        }\n      });\n      this.rewardedAd.onClose((res) => {\n        if (this._pendingResolve) {\n          this._pendingResolve(res && res.isEnded);\n          this._pendingResolve = null;\n        }\n      });\n      this.rewardedAd.load();\n\n      const interstitialId = this._getAdUnitId('interstitial');\n      this.interstitialAd = tt.createInterstitialAd({ adUnitId: interstitialId });\n      this.interstitialAd.onLoad(() => {});\n      this.interstitialAd.onError((err) => { console.warn('[AdManager] Interstitial ad error:', err); });\n    } catch (e) {\n      console.warn('[AdManager] SDK init failed, falling back to stub:', e);\n      this.isDouyin = false;\n    }\n  }\n\n  isNewUser() { return this.dm.unlockedLevel <= AD_LIMITS.NEW_USER_FREE_LEVELS; }\n\n  canShowRewarded(placement) {\n    this._resetDaily();\n    if (this.isNewUser()) return false;\n    if (this.adState.dailyRewarded >= AD_LIMITS.REWARDED_DAILY) return false;\n    if (this._inCooldown(placement)) return false;\n    return true;\n  }\n\n  canShowInterstitial(currentLevel) {\n    this._resetDaily();\n    if (this.isNewUser()) return false;\n    if (this.adState.dailyInterstitial >= AD_LIMITS.INTERSTITIAL_DAILY) return false;\n    if (this.adState.consecutiveFails >= 2) return false;\n    const lastLevel = this.adState.lastInterstitialLevel || 0;\n    if (currentLevel - lastLevel < AD_LIMITS.INTERSTITIAL_LEVEL_INTERVAL) return false;\n    if (this._inCooldown(AD_PLACEMENTS.INTERSTITIAL)) return false;\n    return true;\n  }\n\n  _inCooldown(placement) {\n    const last = this.adState.lastShowTime[placement] || 0;\n    return Date.now() - last < AD_LIMITS.COOLDOWN_MS;\n  }\n\n  showRewarded(placement) {\n    if (!this.canShowRewarded(placement)) return Promise.resolve(false);\n    this._currentPlacement = placement;\n\n    if (this.isDouyin && this.rewardedAd) {\n      return new Promise((resolve) => {\n        this._pendingResolve = resolve;\n        this.rewardedAd.show().catch(() => {\n          this.rewardedAd.load().then(() => {\n            this.rewardedAd.show().catch(() => resolve(false));\n          }).catch(() => resolve(false));\n        });\n      }).then((success) => {\n        if (success) this._onAdComplete(placement);\n        return success;\n      });\n    }\n\n    return this._showStubAd(placement);\n  }\n\n  showInterstitial(currentLevel) {\n    if (!this.canShowInterstitial(currentLevel)) return Promise.resolve(false);\n\n    if (this.isDouyin && this.interstitialAd) {\n      return new Promise((resolve) => {\n        this.interstitialAd.show().then(() => {\n          this.adState.dailyInterstitial++;\n          this.adState.lastInterstitialLevel = currentLevel;\n          this.adState.lastShowTime[AD_PLACEMENTS.INTERSTITIAL] = Date.now();\n          this.dm.save();\n          setTimeout(() => resolve(true), 5000);\n        }).catch(() => resolve(false));\n      });\n    }\n\n    return new Promise((resolve) => {\n      this._showingUI = true;\n      this._stubInterstitial = true;\n      this._stubTimer = 3;\n      this.adState.dailyInterstitial++;\n      this.adState.lastInterstitialLevel = currentLevel;\n      this.adState.lastShowTime[AD_PLACEMENTS.INTERSTITIAL] = Date.now();\n      this.dm.save();\n      this._renderStubUI();\n      setTimeout(() => {\n        this._showingUI = false;\n        this._stubInterstitial = false;\n        this._removeStubUI();\n        resolve(true);\n      }, 3000);\n    });\n  }\n\n  _onAdComplete(placement) {\n    this.adState.dailyRewarded++;\n    this.adState.lastShowTime[placement] = Date.now();\n    this.dm.save();\n  }\n\n  _showStubAd(placement) {\n    return new Promise((resolve) => {\n      this._showingUI = true;\n      this._stubPlacement = placement;\n      this._stubTimer = 3;\n      this._stubResolve = resolve;\n      this._renderStubUI();\n    });\n  }\n\n  _completeStubAd(watched) {\n    this._showingUI = false;\n    if (watched) this._onAdComplete(this._stubPlacement);\n    this._removeStubUI();\n    if (this._stubResolve) {\n      this._stubResolve(watched);\n      this._stubResolve = null;\n    }\n  }\n\n  reportFail() { this.adState.consecutiveFails++; this.dm.save(); }\n  reportSuccess() { this.adState.consecutiveFails = 0; this.dm.save(); }\n\n  // DOM-based stub ad rendering (适配成语游戏的HTML渲染)\n  _renderStubUI() {\n    if (document.getElementById('stub-ad-overlay')) return;\n    const overlay = document.createElement('div');\n    overlay.id = 'stub-ad-overlay';\n    overlay.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.9);z-index:10000;display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:sans-serif;';\n\n    if (this._stubInterstitial) {\n      overlay.innerHTML = `\n        <div style=\"color:#FFB800;font-size:20px;font-weight:bold;margin-bottom:10px\">📢 广告</div>\n        <div style=\"color:#CCC;font-size:14px\">插屏广告模拟</div>\n        <div id=\"stub-timer\" style=\"color:#FFB800;font-size:28px;font-weight:bold;margin-top:20px\">3s</div>`;\n    } else {\n      overlay.innerHTML = `\n        <div style=\"color:#FFB800;font-size:18px;font-weight:bold;margin-bottom:10px\">🎬 激励视频广告</div>\n        <div style=\"color:#FFF;font-size:14px\">广告位: ${this._stubPlacement || ''}</div>\n        <div style=\"color:#999;font-size:12px;margin-top:5px\">（开发模式模拟广告）</div>\n        <div id=\"stub-timer\" style=\"color:#FFB800;font-size:32px;font-weight:bold;margin-top:20px\">3s</div>\n        <button id=\"stub-complete-btn\" style=\"display:none;margin-top:20px;padding:12px 40px;background:#6BCB77;color:#fff;border:none;border-radius:22px;font-size:16px;font-weight:bold;cursor:pointer\">✓ 观看完成</button>\n        <button id=\"stub-skip-btn\" style=\"display:none;margin-top:10px;padding:8px 20px;background:transparent;color:#888;border:none;font-size:12px;cursor:pointer\">跳过（无奖励）</button>`;\n    }\n    document.body.appendChild(overlay);\n\n    const timerEl = document.getElementById('stub-timer');\n    const interval = setInterval(() => {\n      this._stubTimer--;\n      if (timerEl) timerEl.textContent = this._stubTimer > 0 ? `${this._stubTimer}s` : '';\n      if (this._stubTimer <= 0) {\n        clearInterval(interval);\n        const completeBtn = document.getElementById('stub-complete-btn');\n        const skipBtn = document.getElementById('stub-skip-btn');\n        if (completeBtn) {\n          completeBtn.style.display = 'block';\n          completeBtn.onclick = () => this._completeStubAd(true);\n        }\n        if (skipBtn) {\n          skipBtn.style.display = 'block';\n          skipBtn.onclick = () => this._completeStubAd(false);\n        }\n      }\n    }, 1000);\n  }\n\n  _removeStubUI() {\n    const overlay = document.getElementById('stub-ad-overlay');\n    if (overlay) overlay.remove();\n  }\n\n  // Ad button visibility helper\n  static shouldShowAdButton(adManager, placement) {\n    return adManager && adManager.canShowRewarded(placement);\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { AdManager, AD_PLACEMENTS, AD_LIMITS };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"6be7998d-cc43-4adb-be9f-4939a8437d2d","uuid":"62371e93-e854-4cad-a996-6b5d734c0ace"}
