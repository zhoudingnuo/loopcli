 }","originalFile":"// Game.js — Main game controller (W2 extended)\n\nclass Game {\n  constructor() {\n    this.engine = new IdiomEngine(IDIOM_DB);\n    this.judge = new Judge();\n    this.combo = new ComboSystem();\n    this.data = new DataManager();\n    this.audio = new AudioManager();\n    this.tutorial = new Tutorial();\n\n    // W2 systems\n    this.timed = new TimedChallenge(this.engine, this.combo, this.audio, this.data);\n    this.collection = new IdiomCollection(IDIOM_DB, this.data);\n    this.daily = new DailySystem(this.data, this.engine, this.audio);\n    this.pk = new PKMode(this.engine, this.audio, this.data);\n    this.social = new SocialManager(this.data);\n    this.characters = new Characters(this.data);\n\n    // W3 systems\n    this.adManager = new AdManager(this.data);\n    this.analytics = new Analytics(this.data);\n\n    this.currentLevel = null;\n    this.questions = [];\n    this.questionIndex = 0;\n    this.lives = 5;\n    this.state = 'menu';\n    this.usedHintThisQuestion = false;\n    this.continuedOnce = false;\n    this.levelResult = null;\n    this.hintRevealCost = 5;\n    this.hintRemoveCost = 5;\n    this.skipCost = 10;\n    this._doubledReward = false;\n\n    this.analytics.trackGameStart();\n    this.analytics.startFlushTimer();\n  }\n\n  startLevel(levelId) {\n    const level = LEVELS.find(l => l.id === levelId);\n    if (!level) { this.goToMenu(); return; }\n    if (levelId > this.data.unlockedLevel && levelId > 1) {\n      alert('关卡尚未解锁'); return;\n    }\n\n    this.currentLevel = level;\n    this.lives = level.lives;\n    this.engine.reset();\n    this.questions = this.engine.generateForLevel(level);\n    this.questionIndex = 0;\n    this.combo.reset();\n    this.continuedOnce = false;\n    this.state = 'playing';\n    this.characters.resetLevelState();\n\n    if (level.tutorial) this.tutorial.start(level.tutorial);\n    else this.tutorial.end();\n\n    this._startQuestion();\n    this.render();\n  }\n\n  _startQuestion() {\n    if (this.questionIndex >= this.questions.length) { this.finishLevel(); return; }\n    const q = this.questions[this.questionIndex];\n    this.judge.startQuestion(q);\n    this.usedHintThisQuestion = false;\n  }\n\n  pickChar(candidateIndex) {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const result = this.judge.placeChar(candidateIndex);\n    if (result.action === 'placed') {\n      this.audio.playPlace();\n      if (result.fillCount === 4) {\n        setTimeout(() => this._handleFull(result), 400);\n      }\n    } else if (result.action === 'full') {\n      setTimeout(() => this._handleFull(result), 200);\n    } else if (result.action === 'used') {\n      return null;\n    }\n    this.render();\n    return result;\n  }\n\n  _handleFull(result) {\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return;\n    q.answered = true;\n    q.correct = result.isCorrect;\n\n    if (result.isCorrect) {\n      this.audio.playCorrect();\n      const cr = this.combo.onCorrect(this.usedHintThisQuestion);\n\n      // Character skill: combo boost\n      const skillResult = this.characters.applySkill({ event: 'combo_bonus' });\n      if (skillResult.triggered && skillResult.multiplier) {\n        const bonus = Math.floor(cr.comboBonus * (skillResult.multiplier - 1));\n        cr.comboBonus += bonus;\n        this.combo.score += bonus;\n        cr.totalGain += bonus;\n      }\n\n      // Character skill: bonus exp\n      const expResult = this.characters.applySkill({ event: 'correct' });\n      if (expResult.triggered && expResult.bonus) {\n        this.data.addExp(expResult.bonus);\n      }\n\n      if (cr.combo >= 3) this.audio.playCombo(cr.combo);\n      this.data.collectIdiom(q.idiom.id);\n      this.daily.updateTaskProgress('answer', 1);\n      this.daily.updateTaskProgress('combo', cr.combo >= 3 ? 1 : 0);\n      q.comboResult = cr;\n      this.render();\n      setTimeout(() => { this.questionIndex++; this._startQuestion(); this.render(); }, 800);\n    } else {\n      // Character skill: lucky save\n      const skillResult = this.characters.applySkill({ event: 'wrong' });\n      if (skillResult.triggered) {\n        this.audio.playHint();\n        this.render();\n        setTimeout(() => {\n          q.answered = false; q.correct = null;\n          this.judge.startQuestion(q);\n          this.render();\n        }, 800);\n        return;\n      }\n\n      this.audio.playWrong();\n      this.combo.onWrong();\n      this.lives--;\n      this.render();\n      if (this.lives <= 0) {\n        if (!this.continuedOnce) {\n          document.getElementById('continue-modal').style.display = 'flex';\n        } else {\n          setTimeout(() => this.finishLevel(), 600);\n        }\n      } else {\n        setTimeout(() => {\n          q.answered = false; q.correct = null;\n          this.judge.startQuestion(q);\n          this.render();\n        }, 600);\n      }\n    }\n  }\n\n  removeSlot(slotIndex) {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const result = this.judge.removeSlot(slotIndex);\n    if (result.action === 'removed') this.audio.playPlace();\n    this.render();\n    return result;\n  }\n\n  useHintReveal() {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const fc = this.judge.getFillCount();\n    if (fc >= 4) return null;\n\n    // Character skill: free hint\n    const skillResult = this.characters.applySkill({ event: 'hint' });\n    if (!skillResult.triggered) {\n      if (this.data.coins < this.hintRevealCost) {\n        alert('金币不足');\n        return null;\n      }\n      this.data.spendCoins(this.hintRevealCost);\n    }\n\n    const ch = this.judge.currentIdiom.chars[fc];\n    const cand = q.candidates.find(c => c.char === ch && !c.used);\n    if (!cand) return null;\n    this.usedHintThisQuestion = true;\n    this.audio.playHint();\n    const result = this.judge.placeChar(cand.index);\n    if (result.fillCount === 4) setTimeout(() => this._handleFull(result), 400);\n    this.render();\n    return result;\n  }\n\n  useHintRemove() {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n\n    if (this.data.coins < this.hintRemoveCost) {\n      alert('金币不足');\n      return null;\n    }\n    this.data.spendCoins(this.hintRemoveCost);\n\n    const wrong = q.candidates.filter(c => !c.used && !this.judge.currentIdiom.chars.includes(c.char) && !c.removed);\n    const removed = [];\n    const cnt = Math.min(2, wrong.length);\n    for (let i = 0; i < cnt; i++) {\n      const idx = Math.floor(Math.random() * wrong.length);\n      wrong[idx].removed = true;\n      removed.push(wrong[idx]);\n      wrong.splice(idx, 1);\n    }\n    this.audio.playRemove();\n    this.render();\n    return { action: 'removed_distractors', removed };\n  }\n\n  skipQuestion() {\n    if (this.state !== 'playing') return;\n    if (this.data.coins < this.skipCost) {\n      alert('金币不足');\n      return;\n    }\n    this.data.spendCoins(this.skipCost);\n    const q = this.questions[this.questionIndex];\n    if (q) { q.answered = true; q.correct = false; q.skipped = true; }\n    this.combo.onSkip();\n    this.questionIndex++;\n    this._startQuestion();\n    this.render();\n  }\n\n  continueWithAd() {\n    if (this.continuedOnce) return false;\n    this.lives = 3;\n    this.continuedOnce = true;\n    const q = this.questions[this.questionIndex];\n    if (q) { q.answered = false; q.correct = null; this.judge.startQuestion(q); }\n    this.render();\n    return true;\n  }\n\n  finishLevel() {\n    this.state = 'result';\n    document.getElementById('continue-modal').style.display = 'none';\n    const s = this.combo.getStats();\n    const stars = this.combo.getStarRating(s.correctCount, this.questions.length);\n\n    if (stars > 0 && this.currentLevel) {\n      this.data.setLevelStars(this.currentLevel.id, stars);\n      this.data.addCoins(this.currentLevel.reward.coins);\n      this.data.addScore(s.score);\n      this.data.updateBestCombo(s.maxCombo);\n      this.data.addExp(this.currentLevel.reward.exp || 10);\n      this.daily.updateTaskProgress('level', 1);\n      this.daily.updateTaskProgress('collect', s.correctCount);\n    }\n\n    this.levelResult = {\n      stars, correctCount: s.correctCount, totalQuestions: this.questions.length,\n      score: s.score, maxCombo: s.maxCombo,\n      coins: stars > 0 ? this.currentLevel.reward.coins : 0\n    };\n    if (stars > 0) this.audio.playLevelWin(); else this.audio.playLevelFail();\n    this.render();\n  }\n\n  // ===== W2: Timed Challenge =====\n  startTimedChallenge() {\n    this.state = 'timed';\n    this.timed.onUpdate = (evt) => {\n      if (evt === 'end') {\n        this.state = 'timed_result';\n      }\n      this.render();\n    };\n    this.timed.start();\n  }\n\n  // ===== W2: PK Mode =====\n  startPK(opponentResult) {\n    this.state = 'pk';\n    this.pk.onUpdate = (evt) => {\n      if (evt === 'end') {\n        this.state = 'pk_result';\n      }\n      this.render();\n    };\n    this.pk.start(opponentResult);\n  }\n\n  // ===== W2: Collection =====\n  showCollection() {\n    this.state = 'collection';\n    this.render();\n  }\n\n  // ===== W2: Daily =====\n  showDaily() {\n    this.state = 'daily';\n    this.render();\n  }\n\n  // ===== W2: Characters =====\n  showCharacters() {\n    this.state = 'characters';\n    this.render();\n  }\n\n  showLevelMap() {\n    this.state = 'map';\n    this.render();\n  }\n\n  goToMenu() {\n    this.state = 'menu';\n    this.tutorial.end();\n    this.render();\n  }\n\n  getCurrentQuestion() { return this.questions[this.questionIndex]; }\n\n  render() { if (typeof renderUI === 'function') renderUI(