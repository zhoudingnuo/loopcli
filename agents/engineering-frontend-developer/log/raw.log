{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_0a2f00db37e745f28f272027","type":"tool_result","content":"1\t// DataManager.js — localStorage persistence\n2\t\n3\tclass DataManager {\n4\t  constructor() {\n5\t    this.STORAGE_KEY = 'idiom_master_save';\n6\t    this.data = this._load();\n7\t  }\n8\t\n9\t  _defaults() {\n10\t    return {\n11\t      levelStars: {},\n12\t      unlockedLevel: 1,\n13\t      coins: 0,\n14\t      soundEnabled: true,\n15\t      collectedIdioms: [],\n16\t      totalScore: 0,\n17\t      gamesPlayed: 0,\n18\t      bestCombo: 0\n19\t    };\n20\t  }\n21\t\n22\t  _load() {\n23\t    try {\n24\t      const raw = localStorage.getItem(this.STORAGE_KEY);\n25\t      if (raw) return { ...this._defaults(), ...JSON.parse(raw) };\n26\t    } catch (e) { /* ignore */ }\n27\t    return this._defaults();\n28\t  }\n29\t\n30\t  save() {\n31\t    try {\n32\t      localStorage.setItem(this.STORAGE_KEY, JSON.stringify(this.data));\n33\t    } catch (e) { /* ignore */ }\n34\t  }\n35\t\n36\t  getLevelStars(id) { return this.data.levelStars[id] || 0; }\n37\t\n38\t  setLevelStars(id, stars) {\n39\t    if (stars > (this.data.levelStars[id] || 0)) {\n40\t      this.data.levelStars[id] = stars;\n41\t    }\n42\t    if (id >= this.data.unlockedLevel) {\n43\t      this.data.unlockedLevel = id + 1;\n44\t    }\n45\t    this.save();\n46\t  }\n47\t\n48\t  get unlockedLevel() { return this.data.unlockedLevel; }\n49\t  get coins() { return this.data.coins; }\n50\t\n51\t  addCoins(n) { this.data.coins += n; this.save(); return this.data.coins; }\n52\t  spendCoins(n) {\n53\t    if (this.data.coins >= n) { this.data.coins -= n; this.save(); return true; }\n54\t    return false;\n55\t  }\n56\t\n57\t  collectIdiom(id) {\n58\t    if (!this.data.collectedIdioms.includes(id)) {\n59\t      this.data.collectedIdioms.push(id);\n60\t      this.save();\n61\t    }\n62\t  }\n63\t\n64\t  get collectedCount() { return this.data.collectedIdioms.length; }\n65\t\n66\t  addScore(n) {\n67\t    this.data.totalScore += n;\n68\t    this.data.gamesPlayed++;\n69\t    this.save();\n70\t  }\n71\t\n72\t  updateBestCombo(n) {\n73\t    if (n > this.data.bestCombo) {\n74\t      this.data.bestCombo = n;\n75\t      this.save();\n76\t    }\n77\t  }\n78\t\n79\t  reset() { this.data = this._defaults(); this.save(); }\n80\t}\n81\t\n82\tif (typeof module !== 'undefined') module.exports = { DataManager };\n83\t"}]},"parent_tool_use_id":null,"session_id":"3263718e-ff98-4b11-b648-a6d67321903d","uuid":"3b2d9f6e-959a-48ae-b74e-ed2ba1977a70","timestamp":"2026-05-23T00:16:40.593Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/src/js/DataManager.js","content":"// DataManager.js — localStorage persistence\n\nclass DataManager {\n  constructor() {\n    this.STORAGE_KEY = 'idiom_master_save';\n    this.data = this._load();\n  }\n\n  _defaults() {\n    return {\n      levelStars: {},\n      unlockedLevel: 1,\n      coins: 0,\n      soundEnabled: true,\n      collectedIdioms: [],\n      totalScore: 0,\n      gamesPlayed: 0,\n      bestCombo: 0\n    };\n  }\n\n  _load() {\n    try {\n      const raw = localStorage.getItem(this.STORAGE_KEY);\n      if (raw) return { ...this._defaults(), ...JSON.parse(raw) };\n    } catch (e) { /* ignore */ }\n    return this._defaults();\n  }\n\n  save() {\n    try {\n      localStorage.setItem(this.STORAGE_KEY, JSON.stringify(this.data));\n    } catch (e) { /* ignore */ }\n  }\n\n  getLevelStars(id) { return this.data.levelStars[id] || 0; }\n\n  setLevelStars(id, stars) {\n    if (stars > (this.data.levelStars[id] || 0)) {\n      this.data.levelStars[id] = stars;\n    }\n    if (id >= this.data.unlockedLevel) {\n      this.data.unlockedLevel = id + 1;\n    }\n    this.save();\n  }\n\n  get unlockedLevel() { return this.data.unlockedLevel; }\n  get coins() { return this.data.coins; }\n\n  addCoins(n) { this.data.coins += n; this.save(); return this.data.coins; }\n  spendCoins(n) {\n    if (this.data.coins >= n) { this.data.coins -= n; this.save(); return true; }\n    return false;\n  }\n\n  collectIdiom(id) {\n    if (!this.data.collectedIdioms.includes(id)) {\n      this.data.collectedIdioms.push(id);\n      this.save();\n    }\n  }\n\n  get collectedCount() { return this.data.collectedIdioms.length; }\n\n  addScore(n) {\n    this.data.totalScore += n;\n    this.data.gamesPlayed++;\n    this.save();\n  }\n\n  updateBestCombo(n) {\n    if (n > this.data.bestCombo) {\n      this.data.bestCombo = n;\n      this.save();\n    }\n  }\n\n  reset() { this.data = this._defaults(); this.save(); }\n}\n\nif (typeof module !== 'undefined') module.exports = { DataManager };\n","numLines":83,"startLine":1,"totalLines":83}}}
