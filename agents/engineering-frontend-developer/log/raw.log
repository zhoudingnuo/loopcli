obalCompositeOperation = 'source-atop';\n    const tintAlpha = darkness * 0.15;\n    lctx.fillStyle = `rgba(20, 40, 80, ${tintAlpha})`;\n    lctx.fillRect(0, 0, width, height);\n    lctx.globalCompositeOperation = 'source-over';\n\n    ctx.drawImage(this.lightCanvas, 0, 0);\n  }\n\n  private renderDayOverlay(ctx: CanvasRenderingContext2D, w: number, h: number): void {\n    ctx.fillStyle = 'rgba(255, 240, 200, 0.04)';\n    ctx.fillRect(0, 0, w, h);\n  }\n\n  private renderTransitionOverlay(ctx: CanvasRenderingContext2D, w: number, h: number, daylight: number): void {\n    const alpha = (1 - daylight) * 0.1;\n    ctx.fillStyle = `rgba(20, 20, 40, ${alpha})`;\n    ctx.fillRect(0, 0, w, h);\n  }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":4,"newStart":1,"newLines":4,"lines":["-// Lighting.ts — 2D lighting system using offscreen Canvas compositing","+// Lighting.ts — 2D lighting with day/night gradual transitions (v0.3.0 — M3)"," "," import type { LightSource, GamePhase } from '../game/GameState';"," import { isNightTime } from '../game/GameState';"]},{"oldStart":6,"oldLines":12,"newStart":6,"newLines":41,"lines":[" export class Lighting {","   private lightCanvas: HTMLCanvasElement;","   private lightCtx: CanvasRenderingContext2D;","+  private lightBoost = 1.0;"," ","   constructor() {","     this.lightCanvas = document.createElement('canvas');","     this.lightCtx = this.lightCanvas.getContext('2d')!;","   }"," ","+  setLightBoost(boost: number): void {","+    this.lightBoost = boost;","+  }","+","+  private getDaylightFactor(timeOfDay: number): number {","+    if (timeOfDay >= 6 && timeOfDay < 7) return timeOfDay - 6;","+    if (timeOfDay >= 7 && timeOfDay < 17) return 1;","+    if (timeOfDay >= 17 && timeOfDay < 18) return 18 - timeOfDay;","+    return 0;","+  }","+","+  private getDarknessLevel(phase: GamePhase, timeOfDay: number): number {","+    const daylight = this.getDaylightFactor(timeOfDay);","+    if (daylight >= 1) return 0;","+","+    let nightDarkne