{"type":"assistant","message":{"id":"msg_20260523134301c7f026c70b6c45a8","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_199fbdf24c9241b4b8591dbb","name":"Write","input":{"file_path":"D:/game-projects/steam-horror-sim/index.html","content":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>深夜便利店 — Midnight Store</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body {\n      background: #0a0a15;\n      color: #e0e0e0;\n      font-family: 'Segoe UI', system-ui, -apple-system, monospace;\n      overflow: hidden;\n      height: 100vh;\n      width: 100vw;\n      user-select: none;\n    }\n\n    /* ===== MAIN MENU ===== */\n    #main-menu {\n      position: fixed; top: 0; left: 0; width: 100%; height: 100%;\n      background: radial-gradient(ellipse at 50% 40%, #1a0a0a 0%, #050208 60%, #000 100%);\n      display: flex; flex-direction: column; align-items: center; justify-content: center;\n      z-index: 2000;\n    }\n    #main-menu.hidden { display: none; }\n\n    .menu-bg-effect {\n      position: absolute; top: 0; left: 0; width: 100%; height: 100%;\n      pointer-events: none; opacity: 0.15;\n    }\n    .menu-bg-effect::before {\n      content: ''; position: absolute; top: 30%; left: 50%;\n      width: 400px; height: 300px;\n      background: radial-gradient(ellipse, rgba(200,50,50,0.3), transparent 70%);\n      transform: translate(-50%, -50%);\n      animation: menu-pulse 8s ease-in-out infinite;\n    }\n    @keyframes menu-pulse {\n      0%, 100% { opacity: 0.3; transform: translate(-50%, -50%) scale(1); }\n      50% { opacity: 0.6; transform: translate(-50%, -50%) scale(1.2); }\n    }\n\n    .menu-title {\n      font-size: 56px; color: #cc4444; letter-spacing: 8px;\n      text-shadow: 0 0 40px rgba(200,50,50,0.6), 0 0 100px rgba(200,50,50,0.2), 0 2px 4px rgba(0,0,0,0.8);\n      margin-bottom: 4px; position: relative; z-index: 1;\n      animation: title-flicker 6s ease-in-out infinite;\n    }\n    @keyframes title-flicker {\n      0%, 100% { opacity: 1; }\n      93% { opacity: 1; }\n      94% { opacity: 0.5; }\n      95% { opacity: 1; }\n      97% { opacity: 0.7; }\n      98% { opacity: 1; }\n    }\n    .menu-subtitle {\n      font-size: 14px; color: #553333; letter-spacing: 6px; margin-bottom: 60px;\n      position: relative; z-index: 1;\n    }\n    .menu-version {\n      position: absolute; top: 16px; right: 20px;\n      font-size: 11px; color: #333; z-index: 1;\n    }\n    .menu-buttons {\n      display: flex; flex-direction: column; gap: 12px; position: relative; z-index: 1;\n    }\n    .menu-btn {\n      background: transparent; border: 1px solid rgba(200,80,80,0.3);\n      color: #cc8888; padding: 12px 48px; font-size: 15px;\n      font-family: inherit; cursor: pointer; letter-spacing: 3px;\n      transition: all 0.3s; border-radius: 2px;\n    }\n    .menu-btn:hover {\n      background: rgba(200,50,50,0.1); border-color: rgba(200,80,80,0.6);\n      color: #ee9999; text-shadow: 0 0 10px rgba(200,50,50,0.3);\n    }\n    .menu-btn:active { transform: scale(0.97); }\n    .menu-footer {\n      position: absolute; bottom: 20px;\n      font-size: 10px; color: #2a2a2a; letter-spacing: 1px;\n    }\n\n    /* ===== LOADING SCREEN ===== */\n    #loading-screen {\n      position: fixed; top: 0; left: 0; width: 100%; height: 100%;\n      background: radial-gradient(ellipse at center, #0f1025 0%, #050510 100%);\n      display: flex; flex-direction: column; align-items: center; justify-content: center;\n      z-index: 1500; transition: opacity 1s ease;\n    }\n    #loading-screen.hidden { display: none; }\n    #loading-screen.fade-out { opacity: 0; pointer-events: none; }\n    .loading-title {\n      font-size: 42px; color: #cc4444;\n      text-shadow: 0 0 30px rgba(200,50,50,0.5), 0 0 80px rgba(200,50,50,0.2);\n      margin-bottom: 6px; letter-spacing: 6px;\n      animation: flicker 4s ease-in-out infinite;\n    }\n    @keyframes flicker {\n      0%, 100% { opacity: 1; }\n      92% { opacity: 1; }\n      93% { opacity: 0.4; }\n      94% { opacity: 1; }\n      97% { opacity: 0.6; }\n      98% { opacity: 1; }\n    }\n    .loading-subtitle { font-size: 13px; color: #555; margin-bottom: 48px; letter-spacing: 3px; }\n    .loading-bar-container {\n      width: 280px; height: 3px; background: rgba(255,255,255,0.06);\n      border-radius: 2px; overflow: hidden; margin-bottom: 16px;\n    }\n    .loading-bar-fill {\n      height: 100%; width: 0%; border-radius: 2px;\n      background: linear-gradient(90deg, #882222, #cc4444);\n      transition: width 0.3s ease;\n    }\n    .loading-text { font-size: 11px; color: #444; }\n\n    /* ===== GAME UI ===== */\n    #game-ui { display: none; width: 100vw; height: 100vh; }\n    #game-ui.active { display: block; }\n    #canvas-container { width: 100%; height: 100%; position: relative; }\n    #gameCanvas { display: block; width: 100%; height: 100%; cursor: crosshair; }\n\n    /* Notification overlay */\n    #notifications {\n      position: absolute; top: 48px; right: 12px;\n      display: flex; flex-direction: column; gap: 4px;\n      pointer-events: none; z-index: 10; max-width: 320px;\n    }\n    .notif {\n      padding: 6px 14px; border-radius: 4px;\n      font-size: 11px; opacity: 0; transition: opacity 0.3s;\n      pointer-events: auto; backdrop-filter: blur(4px);\n      background: rgba(200,50,50,0.15); border: 1px solid rgba(200,50,50,0.3);\n      color: #dda;\n    }\n    .notif.show { opacity: 1; }\n    .notif.horror { background: rgba(150,0,0,0.25); border-color: rgba(200,0,0,0.5); color: #faa; }\n\n    /* Time speed controls */\n    #speed-controls {\n      position: absolute; bottom: 24px; right: 12px;\n      display: flex; gap: 4px; z-index: 10;\n    }\n    .speed-btn {\n      background: rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.15);\n      color: #aaa; padding: 4px 10px; border-radius: 3px;\n      cursor: pointer; font-size: 11px; font-family: inherit;\n      transition: all 0.2s;\n    }\n    .speed-btn:hover { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.25); }\n    .speed-btn.active { background: rgba(200,60,60,0.2); border-color: rgba(200,60,60,0.4); color: #cc8888; }\n\n    /* ===== PAUSE MENU ===== */\n    #pause-overlay {\n      position: fixed; top: 0; left: 0; width: 100%; height: 100%;\n      background: rgba(0,0,5,0.85); backdrop-filter: blur(6px);\n      display: none; flex-direction: column; align-items: center; justify-content: center;\n      z-index: 100;\n    }\n    #pause-overlay.active { display: flex; }\n    .pause-title {\n      font-size: 32px; color: #cc6666; letter-spacing: 4px; margin-bottom: 36px;\n      text-shadow: 0 0 20px rgba(200,50,50,0.3);\n    }\n    .pause-buttons { display: flex; flex-direction: column; gap: 10px; }\n    .pause-btn {\n      background: rgba(30,20,20,0.8); border: 1px solid rgba(200,80,80,0.25);\n      color: #cc9999; padding: 10px 40px; font-size: 14px;\n      font-family: inherit; cursor: pointer; letter-spacing: 2px;\n      transition: all 0.2s; border-radius: 2px; min-width: 200px; text-align: center;\n    }\n    .pause-btn:hover {\n      background: rgba(200,50,50,0.12); border-color: rgba(200,80,80,0.5);\n      color: #eeaaaa;\n    }\n\n    /* ===== SETTINGS PANEL ===== */\n    #settings-panel {\n      position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);\n      background: rgba(15,10,15,0.95); border: 1px solid rgba(200,80,80,0.3);\n      border-radius: 4px; padding: 28px 36px; min-width: 360px;\n      z-index: 110; display: none;\n    }\n    #settings-panel.active { display: block; }\n    .settings-title {\n      font-size: 18px; color: #cc8888; letter-spacing: 2px;\n      margin-bottom: 20px; text-align: center;\n    }\n    .setting-row {\n      display: flex; justify-content: space-between; align-items: center;\n      margin-bottom: 14px;\n    }\n    .setting-label { font-size: 13px; color: #998888; }\n    .setting-slider {\n      -webkit-appearance: none; appearance: none; width: 140px; height: 4px;\n      background: rgba(255,255,255,0.1); border-radius: 2px; outline: none;\n    }\n    .setting-slider::-webkit-slider-thumb {\n      -webkit-appearance: none; appearance: none; width: 14px; height: 14px;\n      background: #cc6666; border-radius: 50%; cursor: pointer;\n    }\n    .setting-close {\n      display: block; margin: 20px auto 0;\n      background: transparent; border: 1px solid rgba(200,80,80,0.3);\n      color: #aa7777; padding: 6px 24px; font-size: 12px;\n      font-family: inherit; cursor: pointer; border-radius: 2px;\n      transition: all 0.2s;\n    }\n    .setting-close:hover { border-color: rgba(200,80,80,0.5); color: #cc9999; }\n\n    /* Scrollbar */\n    ::-webkit-scrollbar { width: 5px; }\n    ::-webkit-scrollbar-track { background: transparent; }\n    ::-webkit-scrollbar-thumb { background: rgba(200,50,50,0.15); border-radius: 3px; }\n  </style>\n</head>\n<body>\n\n  <!-- ===== MAIN MENU ===== -->\n  <div id=\"main-menu\">\n    <div class=\"menu-bg-effect\"></div>\n    <div class=\"menu-title\">深夜便利店</div>\n    <div class=\"menu-subtitle\">MIDNIGHT STORE</div>\n    <div class=\"menu-version\">v1.0.0 Early Access</div>\n    <div class=\"menu-buttons\">\n      <button class=\"menu-btn\" id=\"btn-new-game\">开始新游戏</button>\n      <button class=\"menu-btn\" id=\"btn-continue\">继续游戏</button>\n      <button class=\"menu-btn\" id=\"btn-settings-menu\">设置</button>\n      <button class=\"menu-btn\" id=\"btn-quit\">退出</button>\n    </div>\n    <div class=\"menu-footer\">WASD 移动 / E 交互 / ESC 暂停</div>\n  </div>\n\n  <!-- ===== LOADING SCREEN ===== -->\n  <div id=\"loading-screen\" class=\"hidden\">\n    <div class=\"loading-title\">深夜便利店</div>\n    <div class=\"loading-subtitle\">MIDNIGHT STORE</div>\n    <div class=\"loading-bar-container\">\n      <div class=\"loading-bar-fill\" id=\"loading-fill\"></div>\n    </div>\n    <div class=\"loading-text\" id=\"loading-text\">正在加载...</div>\n  </div>\n\n  <!-- ===== GAME UI ===== -->\n  <div id=\"game-ui\">\n    <div id=\"canvas-container\">\n      <canvas id=\"gameCanvas\"></canvas>\n      <div id=\"notifications\"></div>\n      <div id=\"speed-controls\">\n        <button class=\"speed-btn\" data-speed=\"0\">⏸</button>\n        <button class=\"speed-btn active\" data-speed=\"1\">1x</button>\n        <button class=\"speed-btn\" data-speed=\"3\">3x</button>\n        <button class=\"speed-btn\" data-speed=\"10\">10x</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- ===== PAUSE OVERLAY ===== -->\n  <div id=\"pause-overlay\">\n    <div class=\"pause-title\">暂停</div>\n    <div class=\"pause-buttons\">\n      <button class=\"pause-btn\" id=\"btn-resume\">继续游戏</button>\n      <button class=\"pause-btn\" id=\"btn-settings-pause\">设置</button>\n      <button class=\"pause-btn\" id=\"btn-main-menu\">返回主菜单</button>\n    </div>\n  </div>\n\n  <!-- ===== SETTINGS PANEL ===== -->\n  <div id=\"settings-panel\">\n    <div class=\"settings-title\">设置</div>\n    <div class=\"setting-row\">\n      <span class=\"setting-label\">主音量</span>\n      <input type=\"range\" class=\"setting-slider\" id=\"vol-master\" min=\"0\" max=\"100\" value=\"70\">\n    </div>\n    <div class=\"setting-row\">\n      <span class=\"setting-label\">背景音乐</span>\n      <input type=\"range\" class=\"setting-slider\" id=\"vol-bgm\" min=\"0\" max=\"100\" value=\"30\">\n    </div>\n    <div class=\"setting-row\">\n      <span class=\"setting-label\">音效</span>\n      <input type=\"range\" class=\"setting-slider\" id=\"vol-sfx\" min=\"0\" max=\"100\" value=\"50\">\n    </div>\n    <button class=\"setting-close\" id=\"btn-settings-close\">确定</button>\n  </div>\n\n  <script type=\"module\">\n    import { App } from './src/renderer/App.ts';\n\n    // ===== DOM REFS =====\n    const mainMenu = document.getElementById('main-menu');\n    const loadingScreen = document.getElementById('loading-screen');\n    const loadingFill = document.getElementById('loading-fill');\n    const loadingText = document.getElementById('loading-text');\n    const gameUI = document.getElementById('game-ui');\n    const notifContainer = document.getElementById('notifications');\n    const pauseOverlay = document.getElementById('pause-overlay');\n    const settingsPanel = document.getElementById('settings-panel');\n\n    let app = null;\n    let gamePaused = false;\n    let hasSave = false;\n\n    // Check for existing save\n    try { hasSave = !!localStorage.getItem('midnight_store_save'); } catch { hasSave = false; }\n    if (!hasSave) {\n      document.getElementById('btn-continue').style.opacity = '0.3';\n      document.getElementById('btn-continue').style.pointerEvents = 'none';\n    }\n\n    // ===== MAIN MENU =====\n    document.getElementById('btn-new-game').addEventListener('click', () => {\n      try { localStorage.removeItem('midnight_store_save'); } catch {}\n      mainMenu.classList.add('hidden');\n      showLoading();\n    });\n\n    document.getElementById('btn-continue').addEventListener('click', () => {\n      if (!hasSave) return;\n      mainMenu.classList.add('hidden');\n      showLoading();\n    });\n\n    document.getElementById('btn-settings-menu').addEventListener('click', () => {\n      settingsPanel.classList.add('active');\n    });\n\n    document.getElementById('btn-quit').addEventListener('click', () => {\n      if (window.confirm('确定要退出游戏吗？')) window.close();\n    });\n\n    // ===== LOADING =====\n    function showLoading() {\n      loadingScreen.classList.remove('hidden');\n      let progress = 0;\n      const messages = ['正在加载...', '检查店铺...', '开灯...', '整理货架...', '准备营业'];\n      const interval = setInterval(() => {\n        progress += Math.random() * 20 + 8;\n        if (progress >= 100) progress = 100;\n        loadingFill.style.width = `${progress}%`;\n        loadingText.textContent = messages[Math.min(4, Math.floor(progress / 25))];\n        if (progress >= 100) {\n          clearInterval(interval);\n          setTimeout(() => {\n            loadingScreen.classList.add('fade-out');\n            setTimeout(() => {\n              loadingScreen.classList.add('hidden');\n              loadingScreen.classList.remove('fade-out');\n              loadingFill.style.width = '0%';\n              startGame();\n            }, 1000);\n          }, 400);\n        }\n      }, 250);\n    }\n\n    // ===== GAME =====\n    function startGame() {\n      gameUI.classList.add('active');\n      const canvas = document.getElementById('gameCanvas');\n      app = new App(canvas);\n\n      app.onNotification = (text) => {\n        const el = document.createElement('div');\n        el.className = 'notif' + (text.includes('⚠') || text.includes('恐惧') || text.includes('恐怖') ? ' horror' : '');\n        el.textContent = text;\n        notifContainer.appendChild(el);\n        requestAnimationFrame(() => el.classList.add('show'));\n        setTimeout(() => {\n          el.classList.remove('show');\n          setTimeout(() => el.remove(), 300);\n        }, 3000);\n      };\n\n      app.start();\n\n      // Speed controls\n      document.querySelectorAll('.speed-btn').forEach(btn => {\n        btn.addEventListener('click', () => {\n          document.querySelectorAll('.speed-btn').forEach(b => b.classList.remove('active'));\n          btn.classList.add('active');\n          app.setTimeSpeed(parseInt(btn.dataset.speed));\n        });\n      });\n\n      // FPS counter (debug)\n      let frameCount = 0;\n      let fpsTime = performance.now();\n      setInterval(() => {\n        const now = performance.now();\n        const fps = Math.round(frameCount * 1000 / (now - fpsTime));\n        frameCount = 0;\n        fpsTime = now;\n      }, 1000);\n\n      const origLoop = app.loop.bind(app);\n      app.loop = (now) => { frameCount++; origLoop(now); };\n    }\n\n    // ===== PAUSE =====\n    function togglePause() {\n      if (!app) return;\n      gamePaused = !gamePaused;\n      if (gamePaused) {\n        pauseOverlay.classList.add('active');\n        app.setTimeSpeed(0);\n        // Update speed button state\n        document.querySelectorAll('.speed-btn').forEach(b => b.classList.remove('active'));\n        document.querySelector('.speed-btn[data-speed=\"0\"]').classList.add('active');\n      } else {\n        pauseOverlay.classList.remove('active');\n        settingsPanel.classList.remove('active');\n        app.setTimeSpeed(1);\n        document.querySelectorAll('.speed-btn').forEach(b => b.classList.remove('active'));\n        document.querySelector('.speed-btn[data-speed=\"1\"]').classList.add('active');\n      }\n    }\n\n    document.getElementById('btn-resume').addEventListener('click', togglePause);\n    document.getElementById('btn-main-menu').addEventListener('click', () => {\n      if (app) { app.stop(); app = null; }\n      gamePaused = false;\n      pauseOverlay.classList.remove('active');\n      settingsPanel.classList.remove('active');\n      gameUI.classList.remove('active');\n      mainMenu.classList.remove('hidden');\n      try { hasSave = !!localStorage.getItem('midnight_store_save'); } catch { hasSave = false; }\n      if (!hasSave) {\n        document.getElementById('btn-continue').style.opacity = '0.3';\n        document.getElementById('btn-continue').style.pointerEvents = 'none';\n      } else {\n        document.getElementById('btn-continue').style.opacity = '1';\n        document.getElementById('btn-continue').style.pointerEvents = 'auto';\n      }\n    });\n\n    // ===== SETTINGS =====\n    function openSettings() { settingsPanel.classList.add('active'); }\n    function closeSettings() { settingsPanel.classList.remove('active'); }\n\n    document.getElementById('btn-settings-pause').addEventListener('click', openSettings);\n    document.getElementById('btn-settings-close').addEventListener('click', closeSettings);\n\n    document.getElementById('vol-master').addEventListener('input', (e) => {\n      if (app) app.audioManager.setMasterVolume(parseInt(e.target.value) / 100);\n    });\n    document.getElementById('vol-bgm').addEventListener('input', (e) => {\n      if (app) app.audioManager.setBgmVolume(parseInt(e.target.value) / 100);\n    });\n    document.getElementById('vol-sfx').addEventListener('input', (e) => {\n      if (app) app.audioManager.setSfxVolume(parseInt(e.target.value) / 100);\n    });\n\n    // ===== KEYBOARD =====\n    window.addEventListener('keydown', (e) => {\n      if (e.key === 'Escape') {\n        if (settingsPanel.classList.contains('active')) {\n          closeSettings();\n        } else if (gameUI.classList.contains('active')) {\n          togglePause();\n        }\n      }\n    });\n  </script>\n</body>\n</html>\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"328f9d51-5f9c-4f63-927e-7b99009d6517","uuid":"09d14400-9c56-4894-8653-b93362381e64"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_199fbdf24c9241b4b8591dbb","type":"tool_result","content":"The file D:/game-projects/steam-horror-sim/index.html has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"328f9d51-5f9c-4f63-927e-7b99009d6517","uuid":"ddd74c43-d68f-4892-9bd4-2a126891d489","timestamp":"2026-05-23T05:44:19.586Z","tool_use_result":{"type":"update","filePath":"D:/game-projects/steam-horror-sim/index.html","content":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>深夜便利店 — Midnight Store</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body {\n      background: #0a0a15;\n      color: #e0e0e0;\n      font-family: 'Segoe UI', system-ui, -apple-system, monospace;\n      overflow: hidden;\n      height: 100vh;\n      width: 100vw;\n      user-select: none;\n    }\n\n    /* ===== MAIN MENU ===== */\n    #main-menu {\n      position: fixed; top: 0; left: 0; width: 100%; height: 100%;\n      background: radial-gradient(ellipse at 50% 40%, #1a0a0a 0%, #050208 60%, #000 100%);\n      display: flex; flex-direction: column; align-items: center; justify-content: center;\n      z-index: 2000;\n    }\n    #main-menu.hidden { display: none; }\n\n    .menu-bg-effect {\n      position: absolute; top: 0; left: 0; width: 100%; height: 100%;\n      pointer-events: none; opacity: 0.15;\n    }\n    .menu-bg-effect::before {\n      content: ''; position: absolute; top: 30%; left: 50%;\n      width: 400px; height: 300px;\n      background: radial-gradient(ellipse, rgba(200,50,50,0.3), transparent 70%);\n      transform: translate(-50%, -50%);\n      animation: menu-pulse 8s ease-in-out infinite;\n    }\n    @keyframes menu-pulse {\n      0%, 100% { opacity: 0.3; transform: translate(-50%, -50%) scale(1); }\n      50% { opacity: 0.6; transform: translate(-50%, -50%) scale(1.2); }\n    }\n\n    .menu-title {\n      font-size: 56px; color: #cc4444; letter-spacing: 8px;\n      text-shadow: 0 0 40px rgba(200,50,50,0.6), 0 0 100px rgba(200,50,50,0.2), 0 2px 4px rgba(0,0,0,0.8);\n      margin-bottom: 4px; position: relative; z-index: 1;\n      animation: title-flicker 6s ease-in-out infinite;\n    }\n    @keyframes title-flicker {\n      0%, 100% { opacity: 1; }\n      93% { opacity: 1; }\n      94% { opacity: 0.5; }\n      95% { opacity: 1; }\n      97% { opacity: 0.7; }\n      98% { opacity: 1; }\n    }\n    .menu-subtitle {\n      font-size: 14px; color: #553333; letter-spacing: 6px; margin-bottom: 60px;\n      position: relative; z-index: 1;\n    }\n    .menu-version {\n      position: absolute; top: 16px; right: 20px;\n      font-size: 11px; color: #333; z-index: 1;\n    }\n    .menu-buttons {\n      display: flex; flex-direction: column; gap: 12px; position: relative; z-index: 1;\n    }\n    .menu-btn {\n      background: transparent; border: 1px solid rgba(200,80,80,0.3);\n      color: #cc8888; padding: 12px 48px; font-size: 15px;\n      font-family: inherit; cursor: pointer; letter-spacing: 3px;\n      transition: all 0.3s; border-radius: 2px;\n    }\n    .menu-btn:hover {\n      background: rgba(200,50,50,0.1); border-color: rgba(200,80,80,0.6);\n      color: #ee9999; text-shadow: 0 0 10px rgba(200,50,50,0.3);\n    }\n    .menu-btn:active { transform: scale(0.97); }\n    .menu-footer {\n      position: absolute; bottom: 20px;\n      font-size: 10px; color: #2a2a2a; letter-spacing: 1px;\n    }\n\n    /* ===== LOADING SCREEN ===== */\n    #loading-screen {\n      position: fixed; top: 0; left: 0; width: 100%; height: 100%;\n      background: radial-gradient(ellipse at center, #0f1025 0%, #050510 100%);\n      display: flex; flex-direction: column; align-items: center; justify-content: center;\n      z-index: 1500; transition: opacity 1s ease;\n    }\n    #loading-screen.hidden { display: none; }\n    #loading-screen.fade-out { opacity: 0; pointer-events: none; }\n    .loading-title {\n      font-size: 42px; color: #cc4444;\n      text-shadow: 0 0 30px rgba(200,50,50,0.5), 0 0 80px rgba(200,50,50,0.2);\n      margin-bottom: 6px; letter-spacing: 6px;\n      animation: flicker 4s ease-in-out infinite;\n    }\n    @keyframes flicker {\n      0%, 100% { opacity: 1; }\n      92% { opacity: 1; }\n      93% { opacity: 0.4; }\n      94% { opacity: 1; }\n      97% { opacity: 0.6; }\n      98% { opacity: 1; }\n    }\n    .loading-subtitle { font-size: 13px; color: #555; margin-bottom: 48px; letter-spacing: 3px; }\n    .loading-bar-container {\n      width: 280px; height: 3px; background: rgba(255,255,255,0.06);\n      border-radius: 2px; overflow: hidden; margin-bottom: 16px;\n    }\n    .loading-bar-fill {\n      height: 100%; width: 0%; border-radius: 2px;\n      background: linear-gradient(90deg, #882222, #cc4444);\n      transition: width 0.3s ease;\n    }\n    .loading-text { font-size: 11px; color: #444; }\n\n    /* ===== GAME UI ===== */\n    #game-ui { display: none; width: 100vw; height: 100vh; }\n    #game-ui.active { display: block; }\n    #canvas-container { width: 100%; height: 100%; position: relative; }\n    #gameCanvas { display: block; width: 100%; height: 100%; cursor: crosshair; }\n\n    /* Notification overlay */\n    #notifications {\n      position: absolute; top: 48px; right: 12px;\n      display: flex; flex-direction: column; gap: 4px;\n      pointer-events: none; z-index: 10; max-width: 320px;\n    }\n    .notif {\n      padding: 6px 14px; border-radius: 4px;\n      font-size: 11px; opacity: 0; transition: opacity 0.3s;\n      pointer-events: auto; backdrop-filter: blur(4px);\n      background: rgba(200,50,50,0.15); border: 1px solid rgba(200,50,50,0.3);\n      color: #dda;\n    }\n    .notif.show { opacity: 1; }\n    .notif.horror { background: rgba(150,0,0,0.25); border-color: rgba(200,0,0,0.5); color: #faa; }\n\n    /* Time speed controls */\n    #speed-controls {\n      position: absolute; bottom: 24px; right: 12px;\n      display: flex; gap: 4px; z-index: 10;\n    }\n    .speed-btn {\n      background: rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.15);\n      color: #aaa; padding: 4px 10px; border-radius: 3px;\n      cursor: pointer; font-size: 11px; font-family: inherit;\n      transition: all 0.2s;\n    }\n    .speed-btn:hover { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.25); }\n    .speed-btn.active { background: rgba(200,60,60,0.2); border-color: rgba(200,60,60,0.4); color: #cc8888; }\n\n    /* ===== PAUSE MENU ===== */\n    #pause-overlay {\n      position: fixed; top: 0; left: 0; width: 100%; height: 100%;\n      background: rgba(0,0,5,0.85); backdrop-filter: blur(6px);\n      display: none; flex-direction: column; align-items: center; justify-content: center;\n      z-index: 100;\n    }\n    #pause-overlay.active { display: flex; }\n    .pause-title {\n      font-size: 32px; color: #cc6666; letter-spacing: 4px; margin-bottom: 36px;\n      text-shadow: 0 0 20px rgba(200,50,50,0.3);\n    }\n    .pause-buttons { display: flex; flex-direction: column; gap: 10px; }\n    .pause-btn {\n      background: rgba(30,20,20,0.8); border: 1px solid rgba(200,80,80,0.25);\n      color: #cc9999; padding: 10px 40px; font-size: 14px;\n      font-family: inherit; cursor: pointer; letter-spacing: 2px;\n      transition: all 0.2s; border-radius: 2px; min-width: 200px; text-align: center;\n    }\n    .pause-btn:hover {\n      background: rgba(200,50,50,0.12); border-color: rgba(200,80,80,0.5);\n      color: #eeaaaa;\n    }\n\n    /* ===== SETTINGS PANEL ===== */\n    #settings-panel {\n      position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);\n      background: rgba(15,10,15,0.95); border: 1px solid rgba(200,80,80,0.3);\n      border-radius: 4px; padding: 28px 36px; min-width: 360px;\n      z-index: 110; display: none;\n    }\n    #settings-panel.active { display: block; }\n    .settings-title {\n      font-size: 18px; color: #cc8888; letter-spacing: 2px;\n      margin-bottom: 20px; text-align: center;\n    }\n    .setting-row {\n      display: flex; justify-content: space-between; align-items: center;\n      margin-bottom: 14px;\n    }\n    .setting-label { font-size: 13px; color: #998888; }\n    .setting-slider {\n      -webkit-appearance: none; appearance: none; width: 140px; height: 4px;\n      background: rgba(255,255,255,0.1); border-radius: 2px; outline: none;\n    }\n    .setting-slider::-webkit-slider-thumb {\n      -webkit-appearance: none; appearance: none; width: 14px; height: 14px;\n      background: #cc6666; border-radius: 50%; cursor: pointer;\n    }\n    .setting-close {\n      display: block; margin: 20px auto 0;\n      background: transparent; border: 1px solid rgba(200,80,80,0.3);\n      color: #aa7777; padding: 6px 24px; font-size: 12px;\n      font-family: inherit; cursor: pointer; border-radius: 2px;\n      transition: all 0.2s;\n    }\n    .setting-close:hover { border-color: rgba(200,80,80,0.5); color: #cc9999; }\n\n    /* Scrollbar */\n    ::-webkit-scrollbar { width: 5px; }\n    ::-webkit-scrollbar-track { background: transparent; }\n    ::-webkit-scrollbar-thumb { background: rgba(200,50,50,0.15); border-radius: 3px; }\n  </style>\n</head>\n<body>\n\n  <!-- ===== MAIN MENU ===== -->\n  <div id=\"main-menu\">\n    <div class=\"menu-bg-effect\"></div>\n    <div class=\"menu-title\">深夜便利店</div>\n    <div class=\"menu-subtitle\">MIDNIGHT STORE</div>\n    <div class=\"menu-version\">v1.0.0 Early Access</div>\n    <div class=\"menu-buttons\">\n      <button class=\"menu-btn\" id=\"btn-new-game\">开始新游戏</button>\n      <button class=\"menu-btn\" id=\"btn-continue\">继续游戏</button>\n      <button class=\"menu-btn\" id=\"btn-settings-menu\">设置</button>\n      <button class=\"menu-btn\" id=\"btn-quit\">退出</button>\n    </div>\n    <div class=\"menu-footer\">WASD 移动 / E 交互 / ESC 暂停</div>\n  </div>\n\n  <!-- ===== LOADING SCREEN ===== -->\n  <div id=\"loading-screen\" class=\"hidden\">\n    <div class=\"loading-title\">深夜便利店</div>\n    <div class=\"loading-subtitle\">MIDNIGHT STORE</div>\n    <div class=\"loading-bar-container\">\n      <div class=\"loading-bar-fill\" id=\"loading-fill\"></div>\n    </div>\n    <div class=\"loading-text\" id=\"loading-text\">正在加载...</div>\n  </div>\n\n  <!-- ===== GAME UI ===== -->\n  <div id=\"game-ui\">\n    <div id=\"canvas-container\">\n      <canvas id=\"gameCanvas\"></canvas>\n      <div id=\"notifications\"></div>\n      <div id=\"speed-controls\">\n        <button class=\"speed-btn\" data-speed=\"0\">⏸</button>\n        <button class=\"speed-btn active\" data-speed=\"1\">1x</button>\n        <button class=\"speed-btn\" data-speed=\"3\">3x</button>\n        <button class=\"speed-btn\" data-speed=\"10\">10x</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- ===== PAUSE OVERLAY ===== -->\n  <div id=\"pause-overlay\">\n    <div class=\"pause-title\">暂停</div>\n    <div class=\"pause-buttons\">\n      <button class=\"pause-btn\" id=\"btn-resume\">继续游戏</button>\n      <button class=\"pause-btn\" id=\"btn-settings-pause\">设置</button>\n      <button class=\"pause-btn\" id=\"btn-main-menu\">返回主菜单</button>\n    </div>\n  </div>\n\n  <!-- ===== SETTINGS PANEL ===== -->\n  <div id=\"settings-panel\">\n    <div class=\"settings-title\">设置</div>\n    <div class=\"setting-row\">\n      <span class=\"setting-label\">主音量</span>\n      <input type=\"range\" class=\"setting-slider\" id=\"vol-master\" min=\"0\" max=\"100\" value=\"70\">\n    </div>\n    <div class=\"setting-row\">\n      <span class=\"setting-label\">背景音乐</span>\n      <input type=\"range\" class=\"setting-slider\" id=\"vol-bgm\" min=\"0\" max=\"100\" value=\"30\">\n    </div>\n    <div class=\"setting-row\">\n      <span class=\"setting-label\">音效</span>\n      <input type=\"range\" class=\"setting-slider\" id=\"vol-sfx\" min=\"0\" max=\"100\" value=\"50\">\n    </div>\n    <button class=\"setting-close\" id=\"btn-settings-close\">确定</button>\n  </div>\n\n  <script type=\"module\">\n    import { App } from './src/renderer/App.ts';\n\n    // ===== DOM REFS =====\n    const mainMenu = document.getElementById('main-menu');\n    const loadingScreen = document.getElementById('loading-screen');\n    const loadingFill = document.getElementById('loading-fill');\n    const loadingText = document.getElementById('loading-text');\n    const gameUI = document.getElementById('game-ui');\n    const notifContainer = document.getElementById('notifications');\n    const pauseOverlay = document.getElementById('pause-overlay');\n    const settingsPanel = document.getElementById('settings-panel');\n\n    let app = null;\n    let gamePaused = false;\n    let hasSave = false;\n\n    // Check for existing save\n    try { hasSave = !!localStorage.getItem('midnight_store_save'); } catch { hasSave = false; }\n    if (!hasSave) {\n      document.getElementById('btn-continue').style.opacity = '0.3';\n      document.getElementById('btn-continue').style.pointerEvents = 'none';\n    }\n\n    // ===== MAIN MENU =====\n    document.getElementById('btn-new-game').addEventListener('click', () => {\n      try { localStorage.removeItem('midnight_store_save'); } catch {}\n      mainMenu.classList.add('hidden');\n      showLoading();\n    });\n\n    document.getElementById('btn-continue').addEventListener('click', () => {\n      if (!hasSave) return;\n      mainMenu.classList.add('hidden');\n      showLoading();\n    });\n\n    document.getElementById('btn-settings-menu').addEventListener('click', () => {\n      settingsPanel.classList.add('active');\n    });\n\n    document.getElementById('btn-quit').addEventListener('click', () => {\n      if (window.confirm('确定要退出游戏吗？')) window.close();\n    });\n\n    // ===== LOADING =====\n    function showLoading() {\n      loadingScreen.classList.remove('hidden');\n      let progress = 0;\n      const messages = ['正在加载...', '检查店铺...', '开灯...', '整理货架...', '准备营业'];\n      const interval = setInterval(() => {\n        progress += Math.random() * 20 + 8;\n        if (progress >= 100) progress = 100;\n        loadingFill.style.width = `${progress}%`;\n        loadingText.textContent = messages[Math.min(4, Math.floor(progress / 25))];\n        if (progress >= 100) {\n          clearInterval(interval);\n          setTimeout(() => {\n            loadingScreen.classList.add('fade-out');\n            setTimeout(() => {\n              loadingScreen.classList.add('hidden');\n              loadingScreen.classList.remove('fade-out');\n              loadingFill.style.width = '0%';\n              startGame();\n            }, 1000);\n          }, 400);\n        }\n      }, 250);\n    }\n\n    // ===== GAME =====\n    function startGame() {\n      gameUI.classList.add('active');\n      const canvas = document.getElementById('gameCanvas');\n      app = new App(canvas);\n\n      app.onNotification = (text) => {\n        const el = document.createElement('div');\n        el.className = 'notif' + (text.includes('⚠') || text.includes('恐惧') || text.includes('恐怖') ? ' horror' : '');\n        el.textContent = text;\n        notifContainer.appendChild(el);\n        requestAnimationFrame(() => el.classList.add('show'));\n        setTimeout(() => {\n          el.classList.remove('show');\n          setTimeout(() => el.remove(), 300);\n        }, 3000);\n      };\n\n      app.start();\n\n      // Speed controls\n      document.querySelectorAll('.speed-btn').forEach(btn => {\n        btn.addEventListener('click', () => {\n          document.querySelectorAll('.speed-btn').forEach(b => b.classList.remove('active'));\n          btn.classList.add('active');\n          app.setTimeSpeed(parseInt(btn.dataset.speed));\n        });\n      });\n\n      // FPS counter (debug)\n      let frameCount = 0;\n      let fpsTime = performance.now();\n      setInterval(() => {\n        const now = performance.now();\n        const fps = Math.round(frameCount * 1000 / (now - fpsTime));\n        frameCount = 0;\n        fpsTime = now;\n      }, 1000);\n\n      const origLoop = app.loop.bind(app);\n      app.loop = (now) => { frameCount++; origLoop(now); };\n    }\n\n    // ===== PAUSE =====\n    function togglePause() {\n      if (!app) return;\n      gamePaused = !gamePaused;\n      if (gamePaused) {\n        pauseOverlay.classList.add('active');\n        app.setTimeSpeed(0);\n        // Update speed button state\n        document.querySelectorAll('.speed-btn').forEach(b => b.classList.remove('active'));\n        document.querySelector('.speed-btn[data-speed=\"0\"]').classList.add('active');\n      } else {\n        pauseOverlay.classList.remove('active');\n        settingsPanel.classList.remove('active');\n        app.setTimeSpeed(1);\n        document.querySelectorAll('.speed-btn').forEach(b => b.classList.remove('active'));\n        document.querySelector('.speed-btn[data-speed=\"1\"]').classList.add('active');\n      }\n    }\n\n    document.getElementById('btn-resume').addEventListener('click', togglePause);\n    document.getElementById('btn-main-menu').addEventListener('click', () => {\n      if (app) { app.stop(); app = null; }\n      gamePaused = false;\n      pauseOverlay.classList.remove('active');\n      settingsPanel.classList.remove('active');\n      gameUI.classList.remove('active');\n      mainMenu.classList.remove('hidden');\n      try { hasSave = !!localStorage.getItem('midnight_store_save'); } catch { hasSave = false; }\n      if (!hasSave) {\n        document.getElementById('btn-continue').style.opacity = '0.3';\n        document.getElementById('btn-continue').style.pointerEvents = 'none';\n      } else {\n        document.getElementById('btn-continue').style.opacity = '1';\n        document.getElementById('btn-continue').style.pointerEvents = 'auto';\n      }\n    });\n\n    // ===== SETTINGS =====\n    function openSettings() { settingsPanel.classList.add('active'); }\n    function closeSettings() { settingsPanel.classList.remove('active'); }\n\n    document.getElementById('btn-settings-pause').addEventListener('click', openSettings);\n    document.getElementById('btn-settings-close').addEventListener('click', closeSettings);\n\n    document.getElementById('vol-master').addEventListener('input', (e) => {\n      if (app) app.audioManager.setMasterVolume(parseInt(e.target.value) / 100);\n    });\n    document.getElementById('vol-bgm').addEventListener('input', (e) => {\n      if (app) app.audioManager.setBgmVolume(parseInt(e.target.value) / 100);\n    });\n    document.getElementById('vol-sfx').addEventListener('input', (e) => {\n      if (app) app.audioManager.setSfxVolume(parseInt(e.target.value) / 100);\n    });\n\n    // ===== KEYBOARD =====\n    window.addEventListener('keydown', (e) => {\n      if (e.key === 'Escape') {\n        if (settingsPanel.classList.contains('active')) {\n          closeSettings();\n        } else if (gameUI.classList.contains('active')) {\n          togglePause();\n        }\n      }\n    });\n  </script>\n</body>\n</html>\n","structuredPatch":[{"oldStart":9,"oldLines":19,"newStart":9,"newLines":87,"lines":["     body {","       background: #0a0a15;","       color: #e0e0e0;","-      font-family: 'Segoe UI', system-ui, monospace;","+      font-family: 'Segoe UI', system-ui, -apple-system, monospace;","       overflow: hidden;","       height: 100vh;","       width: 100vw;","+      user-select: none;","     }"," ","+    /* ===== MAIN MENU ===== */","+    #main-menu {","+      position: fixed; top: 0; left: 0; width: 100%; height: 100%;","+      background: radial-gradient(ellipse at 50% 40%, #1a0a0a 0%, #050208 60%, #000 100%);","+      display: flex; flex-direction: column; align-items: center; justify-content: center;","+      z-index: 2000;","+    }","+    #main-menu.hidden { display: none; }","+","+    .menu-bg-effect {","+      position: absolute; top: 0; left: 0; width: 100%; height: 100%;","+      po