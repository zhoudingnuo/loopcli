size();\n      game.input.updateLayout(\n        game.renderer.tileSize,\n        game.renderer.boardX,\n        game.renderer.boardY,\n      );\n    }\n\n    window.addEventListener('resize', onResize);\n    window.addEventListener('orientationchange', () => setTimeout(onResize, 100));\n\n    // Handle result screen clicks (retry / next level / menu)\n    canvas.addEventListener('click', (e) => {\n      if (!game.resultData) return;\n      const rect = canvas.getBoundingClientRect();\n      const x = e.clientX - rect.left;\n      const y = e.clientY - rect.top;\n\n      const pw = Math.min(320, game.renderer.screenW - 40);\n      const ph = 260;\n      const px = (game.renderer.screenW - pw) / 2;\n      const py = (game.renderer.screenH - ph) / 2;\n      const btnW = 120, btnH = 42;\n      const btnY = py + ph - 60;\n\n      // Retry/Next button\n      if (x >= game.renderer.screenW / 2 - btnW - 10 && x <= game.renderer.screenW / 2 - 10 &&\n          y >= btnY && y <= btnY + btnH) {\n        if (game.resultData.won) {\n          game.nextLevel();\n        } else {\n          game.retry();\n        }\n      }\n      // Menu button — restart from level 1\n      if (x >= game.renderer.screenW / 2 + 10 && x <= game.renderer.screenW / 2 + 10 + btnW &&\n          y >= btnY && y <= btnY + btnH) {\n        game._loadLevel(0);\n        game.state = 'idle';\n      }\n    });\n\n    // Start the game\n    game.start();\n  </script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null,"userModified":false}}
