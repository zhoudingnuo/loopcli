{"type":"assistant","message":{"id":"msg_20260523103703ac05a3ab0cb740ec","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_c66405a2bb7f4c628511114d","name":"Write","input":{"file_path":"D:\\game-projects\\steam-cultivation-factory\\src\\main\\main.ts","content":"// Electron main process entry point (v0.5.0 — M5: Steam + UI polish + packaging)\n\nimport { app, BrowserWindow, ipcMain, screen } from 'electron';\nimport * as path from 'path';\nimport * as fs from 'fs';\nimport { initSteam, isSteamRunning, unlockAchievement, saveToCloud, loadFromCloud, shutdownSteam } from './SteamIntegration';\n\nlet mainWindow: BrowserWindow | null = null;\n\nconst SETTINGS_PATH = path.join(app.getPath('userData'), 'settings.json');\n\ninterface AppSettings {\n  masterVolume: number;\n  sfxVolume: number;\n  musicVolume: number;\n  resolution: { width: number; height: number };\n  fullscreen: boolean;\n  language: string;\n  autoSaveInterval: number;\n  showFPS: boolean;\n  particleQuality: string;\n}\n\nfunction loadAppSettings(): AppSettings {\n  try {\n    if (fs.existsSync(SETTINGS_PATH)) {\n      return JSON.parse(fs.readFileSync(SETTINGS_PATH, 'utf-8'));\n    }\n  } catch { /* use defaults */ }\n  return {\n    masterVolume: 80, sfxVolume: 100, musicVolume: 70,\n    resolution: { width: 1280, height: 800 },\n    fullscreen: false, language: 'zh-CN',\n    autoSaveInterval: 60, showFPS: true, particleQuality: 'high',\n  };\n}\n\nfunction saveAppSettings(settings: AppSettings): void {\n  try {\n    fs.writeFileSync(SETTINGS_PATH, JSON.stringify(settings, null, 2));\n  } catch { /* ignore */ }\n}\n\nfunction createWindow(): void {\n  const settings = loadAppSettings();\n  const { width, height } = settings.resolution;\n\n  mainWindow = new BrowserWindow({\n    width,\n    height,\n    minWidth: 960,\n    minHeight: 600,\n    title: '修仙自动化工厂 — Cultivation Factory',\n    backgroundColor: '#1a1a2e',\n    fullscreen: settings.fullscreen,\n    show: false,\n    icon: path.join(__dirname, '../../assets/icons/icon.ico'),\n    webPreferences: {\n      nodeIntegration: false,\n      contextIsolation: true,\n      preload: path.join(__dirname, 'preload.js'),\n    },\n  });\n\n  // Show window when ready (avoids white flash)\n  mainWindow.once('ready-to-show', () => {\n    mainWindow?.show();\n  });\n\n  // In development, load from Vite dev server\n  const isDev = process.env.NODE_ENV === 'development';\n  if (isDev) {\n    mainWindow.loadURL('http://localhost:5173');\n    mainWindow.webContents.openDevTools();\n  } else {\n    mainWindow.loadFile(path.join(__dirname, '../renderer/index.html'));\n  }\n\n  mainWindow.on('closed', () => {\n    mainWindow = null;\n  });\n}\n\n// === IPC Handlers ===\n\nfunction setupIPC(): void {\n  ipcMain.handle('settings:get', () => {\n    return loadAppSettings();\n  });\n\n  ipcMain.handle('settings:set', (_event, settings: AppSettings) => {\n    saveAppSettings(settings);\n    return true;\n  });\n\n  ipcMain.handle('window:fullscreen', (_event, fullscreen: boolean) => {\n    if (mainWindow) {\n      mainWindow.setFullScreen(fullscreen);\n      const settings = loadAppSettings();\n      settings.fullscreen = fullscreen;\n      saveAppSettings(settings);\n    }\n    return true;\n  });\n\n  ipcMain.handle('window:resolution', (_event, w: number, h: number) => {\n    if (mainWindow) {\n      mainWindow.setSize(w, h);\n      mainWindow.center();\n      const settings = loadAppSettings();\n      settings.resolution = { width: w, height: h };\n      saveAppSettings(settings);\n    }\n    return true;\n  });\n\n  ipcMain.handle('steam:isAvailable', () => {\n    return isSteamRunning();\n  });\n\n  ipcMain.handle('steam:unlockAchievement', (_event, id: string) => {\n    return unlockAchievement(id);\n  });\n\n  ipcMain.handle('steam:cloudSave', (_event, data: string) => {\n    return saveToCloud(data);\n  });\n\n  ipcMain.handle('steam:cloudLoad', () => {\n    return loadFromCloud();\n  });\n\n  ipcMain.handle('app:version', () => {\n    return app.getVersion();\n  });\n\n  ipcMain.handle('app:quit', () => {\n    app.quit();\n  });\n}\n\n// === App Lifecycle ===\n\napp.whenReady().then(() => {\n  // Initialize Steam\n  initSteam();\n\n  // Setup IPC\n  setupIPC();\n\n  // Create window\n  createWindow();\n\n  app.on('activate', () => {\n    if (mainWindow === null) {\n      createWindow();\n    }\n  });\n});\n\napp.on('window-all-closed', () => {\n  shutdownSteam();\n  if (process.platform !== 'darwin') {\n    app.quit();\n  }\n});\n\napp.on('before-quit', () => {\n  shutdownSteam();\n});\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"6abd1a50-ca4f-4f48-ad3d-d0b1dc08d31a","uuid":"cb718422-aba1-47cc-8406-3e32eb9968d8"}
