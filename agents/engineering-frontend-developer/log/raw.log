{"type":"assistant","message":{"id":"msg_20260523134545e5454dcff3564b76","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_cbbec3ec4faf489ea1fd0830","name":"Write","input":{"file_path":"D:/game-projects/steam-horror-sim/src/main/main.ts","content":"// Electron main process (v1.0.0 — M7: Steam integration + Polish)\n\nimport { app, BrowserWindow, ipcMain, fullscreen } from 'electron';\nimport * as path from 'path';\n\nlet mainWindow: BrowserWindow | null = null;\n\n// Steamworks stub — will be replaced with real SDK in production\ninterface SteamAPI {\n  init: () => boolean;\n  achievement: (id: string) => void;\n  shutdown: () => void;\n}\n\nconst steamStub: SteamAPI = {\n  init: () => { console.log('[Steam] Stub initialized'); return true; },\n  achievement: (id: string) => { console.log(`[Steam] Achievement unlocked: ${id}`); },\n  shutdown: () => { console.log('[Steam] Stub shutdown'); },\n};\n\nlet steam: SteamAPI = steamStub;\n\n// Try to load real steamworks.js\ntry {\n  const steamworks = require('steamworks.js');\n  if (steamworks && steamworks.init) {\n    steam = {\n      init: () => steamworks.init(),\n      achievement: (id: string) => {\n        try {\n          const stats = steamworks.SteamUserStats;\n          if (stats) stats.achieve(id);\n        } catch { steamStub.achievement(id); }\n      },\n      shutdown: () => { try { steamworks.shutdown(); } catch { /* ok */ } },\n    };\n    console.log('[Steam] Real SDK loaded');\n  }\n} catch {\n  console.log('[Steam] SDK not found, using stub');\n}\n\nfunction createWindow(): void {\n  mainWindow = new BrowserWindow({\n    width: 1280,\n    height: 800,\n    minWidth: 960,\n    minHeight: 600,\n    title: '深夜便利店 — Midnight Store',\n    backgroundColor: '#0a0a15',\n    show: false,\n    autoHideMenuBar: true,\n    webPreferences: {\n      nodeIntegration: false,\n      contextIsolation: true,\n      preload: path.join(__dirname, 'preload.js'),\n    },\n  });\n\n  mainWindow.once('ready-to-show', () => {\n    mainWindow?.show();\n  });\n\n  const isDev = process.env.NODE_ENV === 'development';\n  if (isDev) {\n    mainWindow.loadURL('http://localhost:5173');\n    mainWindow.webContents.openDevTools();\n  } else {\n    mainWindow.loadFile(path.join(__dirname, '../renderer/index.html'));\n  }\n\n  mainWindow.on('closed', () => {\n    mainWindow = null;\n  });\n\n  // Notify renderer of fullscreen changes\n  mainWindow.on('enter-full-screen', () => {\n    mainWindow?.webContents.send('fullscreen-change', true);\n  });\n  mainWindow.on('leave-full-screen', () => {\n    mainWindow?.webContents.send('fullscreen-change', false);\n  });\n}\n\n// IPC handlers\nipcMain.handle('quit', () => {\n  app.quit();\n});\n\nipcMain.handle('achieve', (_event, id: string) => {\n  steam.achievement(id);\n});\n\nipcMain.handle('save-cloud', (_event, _data: string) => {\n  // Steam cloud save stub\n  return true;\n});\n\nipcMain.handle('load-cloud', () => {\n  // Steam cloud load stub\n  return null;\n});\n\napp.whenReady().then(() => {\n  steam.init();\n  createWindow();\n\n  app.on('activate', () => {\n    if (mainWindow === null) {\n      createWindow();\n    }\n  });\n});\n\napp.on('window-all-closed', () => {\n  steam.shutdown();\n  if (process.platform !== 'darwin') {\n    app.quit();\n  }\n});\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"328f9d51-5f9c-4f63-927e-7b99009d6517","uuid":"c9be466b-96cc-4c48-b6b6-f7e7341f624a"}
