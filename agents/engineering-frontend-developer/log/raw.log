{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_c60655a451be4b54829ad622","type":"tool_result","content":"1\t// Lighting.ts — 2D lighting system using offscreen Canvas compositing\n2\t\n3\timport type { LightSource, GamePhase } from '../game/GameState';\n4\timport { isNightTime } from '../game/GameState';\n5\t\n6\texport class Lighting {\n7\t  private lightCanvas: HTMLCanvasElement;\n8\t  private lightCtx: CanvasRenderingContext2D;\n9\t\n10\t  constructor() {\n11\t    this.lightCanvas = document.createElement('canvas');\n12\t    this.lightCtx = this.lightCanvas.getContext('2d')!;\n13\t  }\n14\t\n15\t  render(\n16\t    ctx: CanvasRenderingContext2D,\n17\t    width: number,\n18\t    height: number,\n19\t    lights: LightSource[],\n20\t    phase: GamePhase,\n21\t    offsetX: number,\n22\t    offsetY: number,\n23\t    scale: number,\n24\t    now: number,\n25\t  ): void {\n26\t    if (!isNightTime(phase)) return;\n27\t\n28\t    this.lightCanvas.width = width;\n29\t    this.lightCanvas.height = height;\n30\t    const lctx = this.lightCtx;\n31\t\n32\t    // Calculate darkness intensity based on phase\n33\t    let darkness = 0;\n34\t    if (phase === 'night_transition') darkness = 0.3;\n35\t    else if (phase === 'night') darkness = 0.6;\n36\t    else if (phase === 'danger') darkness = 0.85;\n37\t\n38\t    // Fill with darkness\n39\t    lctx.fillStyle = `rgba(5, 5, 20, ${darkness})`;\n40\t    lctx.fillRect(0, 0, width, height);\n41\t\n42\t    // Cut out light circles using 'destination-out' compositing\n43\t    lctx.globalCompositeOperation = 'destination-out';\n44\t\n45\t    for (const light of lights) {\n46\t      const screenX = offsetX + light.x * scale;\n47\t      const screenY = offsetY + light.y * scale;\n48\t      const radius = light.radius * scale;\n49\t\n50\t      let intensity = light.intensity;\n51\t      if (light.flicker) {\n52\t        const flicker = Math.sin(now * light.flickerSpeed * 0.001) * 0.1 +\n53\t          Math.sin(now * light.flickerSpeed * 0.003) * 0.05;\n54\t        intensity = Math.max(0.3, Math.min(1, intensity + flicker));\n55\t      }\n56\t\n57\t      const gradient = lctx.createRadialGradient(screenX, screenY, 0, screenX, screenY, radius);\n58\t      gradient.addColorStop(0, `rgba(0, 0, 0, ${intensity})`);\n59\t      gradient.addColorStop(0.4, `rgba(0, 0, 0, ${intensity * 0.6})`);\n60\t      gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');\n61\t\n62\t      lctx.fillStyle = gradient;\n63\t      lctx.beginPath();\n64\t      lctx.arc(screenX, screenY, radius, 0, Math.PI * 2);\n65\t      lctx.fill();\n66\t    }\n67\t\n68\t    lctx.globalCompositeOperation = 'source-over';\n69\t\n70\t    // Apply colored tint for night atmosphere\n71\t    lctx.globalCompositeOperation = 'source-atop';\n72\t    const tintAlpha = darkness * 0.15;\n73\t    lctx.fillStyle = `rgba(20, 40, 80, ${tintAlpha})`;\n74\t    lctx.fillRect(0, 0, width, height);\n75\t    lctx.globalCompositeOperation = 'source-over';\n76\t\n77\t    // Composite the lighting layer onto the main canvas\n78\t    ctx.drawImage(this.lightCanvas, 0, 0);\n79\t  }\n80\t}\n81\t"}]},"parent_tool_use_id":null,"session_id":"e8f5bde0-4da8-4c4a-9322-50945e66ead7","uuid":"bf30138b-37fa-4bdb-805b-019637c370a0","timestamp":"2026-05-23T04:37:11.350Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-horror-sim\\src\\renderer\\Lighting.ts","content":"// Lighting.ts — 2D lighting system using offscreen Canvas compositing\n\nimport type { LightSource, GamePhase } from '../game/GameState';\nimport { isNightTime } from '../game/GameState';\n\nexport class Lighting {\n  private lightCanvas: HTMLCanvasElement;\n  private lightCtx: CanvasRenderingContext2D;\n\n  constructor() {\n    this.lightCanvas = document.createElement('canvas');\n    this.lightCtx = this.lightCanvas.getContext('2d')!;\n  }\n\n  render(\n    ctx: CanvasRenderingContext2D,\n    width: number,\n    height: number,\n    lights: LightSource[],\n    phase: GamePhase,\n    offsetX: number,\n    offsetY: number,\n    scale: number,\n    now: number,\n  ): void {\n    if (!isNightTime(phase)) return;\n\n    this.lightCanvas.width = width;\n    this.lightCanvas.height = height;\n    const lctx = this.lightCtx;\n\n    // Calculate darkness intensity based on phase\n    let darkness = 0;\n    if (phase === 'night_transition') darkness = 0.3;\n    else if (phase === 'night') darkness = 0.6;\n    else if (phase === 'danger') darkness = 0.85;\n\n    // Fill with darkness\n    lctx.fillStyle = `rgba(5, 5, 20, ${darkness})`;\n    lctx.fillRect(0, 0, width, height);\n\n    // Cut out light circles using 'destination-out' compositing\n    lctx.globalCompositeOperation = 'destination-out';\n\n    for (const light of lights) {\n      const screenX = offsetX + light.x * scale;\n      const screenY = offsetY + light.y * scale;\n      const radius = light.radius * scale;\n\n      let intensity = light.intensity;\n      if (light.flicker) {\n        const flicker = Math.sin(now * light.flickerSpeed * 0.001) * 0.1 +\n          Math.sin(now * light.flickerSpeed * 0.003) * 0.05;\n        intensity = Math.max(0.3, Math.min(1, intensity + flicker));\n      }\n\n      const gradient = lctx.createRadialGradient(screenX, screenY, 0, screenX, screenY, radius);\n      gradient.addColorStop(0, `rgba(0, 0, 0, ${intensity})`);\n      gradient.addColorStop(0.4, `rgba(0, 0, 0, ${intensity * 0.6})`);\n      gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');\n\n      lctx.fillStyle = gradient;\n      lctx.beginPath();\n      lctx.arc(screenX, screenY, radius, 0, Math.PI * 2);\n      lctx.fill();\n    }\n\n    lctx.globalCompositeOperation = 'source-over';\n\n    // Apply colored tint for night atmosphere\n    lctx.globalCompositeOperation = 'source-atop';\n    const tintAlpha = darkness * 0.15;\n    lctx.fillStyle = `rgba(20, 40, 80, ${tintAlpha})`;\n    lctx.fillRect(0, 0, width, height);\n    lctx.globalCompositeOperation = 'source-over';\n\n    // Composite the lighting layer onto the main canvas\n    ctx.drawImage(this.lightCanvas, 0, 0);\n  }\n}\n","numLines":81,"startLine":1,"totalLines":81}}}
