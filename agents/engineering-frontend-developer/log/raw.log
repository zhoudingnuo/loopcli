{"type":"assistant","message":{"id":"msg_20260523081958497c1cda00d9498f","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_9c2fa0025b0c4fca99db7b40","name":"Write","input":{"file_path":"D:/game-projects/douyin-idiom/src/js/DataManager.js","content":"// DataManager.js — localStorage persistence (W2 extended)\n\nclass DataManager {\n  constructor() {\n    this.STORAGE_KEY = 'idiom_master_save';\n    this.data = this._load();\n  }\n\n  _defaults() {\n    return {\n      levelStars: {},\n      unlockedLevel: 1,\n      coins: 0,\n      soundEnabled: true,\n      collectedIdioms: [],\n      totalScore: 0,\n      gamesPlayed: 0,\n      bestCombo: 0,\n      bestTimedScore: 0,\n      timedGamesPlayed: 0,\n      pkWins: 0,\n      pkGames: 0,\n      pkScore: 0,\n      exp: 0,\n      level: 1,\n      daily: null,\n      characters: null\n    };\n  }\n\n  _load() {\n    try {\n      const raw = localStorage.getItem(this.STORAGE_KEY);\n      if (raw) return { ...this._defaults(), ...JSON.parse(raw) };\n    } catch (e) { /* ignore */ }\n    return this._defaults();\n  }\n\n  save() {\n    try {\n      localStorage.setItem(this.STORAGE_KEY, JSON.stringify(this.data));\n    } catch (e) { /* ignore */ }\n  }\n\n  getLevelStars(id) { return this.data.levelStars[id] || 0; }\n\n  setLevelStars(id, stars) {\n    if (stars > (this.data.levelStars[id] || 0)) {\n      this.data.levelStars[id] = stars;\n    }\n    if (id >= this.data.unlockedLevel) {\n      this.data.unlockedLevel = id + 1;\n    }\n    this.save();\n  }\n\n  get unlockedLevel() { return this.data.unlockedLevel; }\n  get coins() { return this.data.coins; }\n\n  addCoins(n) { this.data.coins += n; this.save(); return this.data.coins; }\n  spendCoins(n) {\n    if (this.data.coins >= n) { this.data.coins -= n; this.save(); return true; }\n    return false;\n  }\n\n  collectIdiom(id) {\n    if (!this.data.collectedIdioms.includes(id)) {\n      this.data.collectedIdioms.push(id);\n      this.save();\n    }\n  }\n\n  get collectedCount() { return this.data.collectedIdioms.length; }\n  get collectedIdioms() { return this.data.collectedIdioms; }\n\n  addScore(n) {\n    this.data.totalScore += n;\n    this.data.gamesPlayed++;\n    this.save();\n  }\n\n  updateBestCombo(n) {\n    if (n > this.data.bestCombo) {\n      this.data.bestCombo = n;\n      this.save();\n    }\n  }\n\n  addTimedScore(score) {\n    this.data.timedGamesPlayed = (this.data.timedGamesPlayed || 0) + 1;\n    if (score > (this.data.bestTimedScore || 0)) {\n      this.data.bestTimedScore = score;\n    }\n    this.save();\n  }\n\n  get bestTimedScore() { return this.data.bestTimedScore || 0; }\n\n  addPKWin() {\n    this.data.pkWins = (this.data.pkWins || 0) + 1;\n    this.data.pkGames = (this.data.pkGames || 0) + 1;\n    this.data.pkScore = (this.data.pkScore || 0) + 3;\n    this.save();\n  }\n\n  addPKLoss() {\n    this.data.pkGames = (this.data.pkGames || 0) + 1;\n    this.save();\n  }\n\n  get pkRecord() {\n    return { wins: this.data.pkWins || 0, games: this.data.pkGames || 0, score: this.data.pkScore || 0 };\n  }\n\n  addExp(n) {\n    this.data.exp = (this.data.exp || 0) + n;\n    this.data.level = Math.floor(this.data.exp / 100) + 1;\n    this.save();\n  }\n\n  reset() { this.data = this._defaults(); this.save(); }\n}\n\nif (typeof module !== 'undefined') module.exports = { DataManager };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"3263718e-ff98-4b11-b648-a6d67321903d","uuid":"1d6ac018-befe-4a86-a75b-94fc97ac5472"}
