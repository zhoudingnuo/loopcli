{"type":"assistant","message":{"id":"msg_20260523050717b260d19bb5944d11","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_eb496598e7934c928a1f5bb9","name":"Write","input":{"file_path":"D:/game-projects/douyin-match3/src/js/Animation.js","content":"// Animation.js — Easing functions, tween system, particle effects\n\n// Easing functions\nconst Easing = {\n  linear: t => t,\n  easeInQuad: t => t * t,\n  easeOutQuad: t => t * (2 - t),\n  easeInOutQuad: t => t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t,\n  easeOutBack: t => {\n    const s = 1.70158;\n    return (t -= 1) * t * ((s + 1) * t + s) + 1;\n  },\n  easeOutBounce: t => {\n    if (t < 1 / 2.75) return 7.5625 * t * t;\n    if (t < 2 / 2.75) return 7.5625 * (t -= 1.5 / 2.75) * t + 0.75;\n    if (t < 2.5 / 2.75) return 7.5625 * (t -= 2.25 / 2.75) * t + 0.9375;\n    return 7.5625 * (t -= 2.625 / 2.75) * t + 0.984375;\n  },\n  easeOutElastic: t => {\n    if (t === 0 || t === 1) return t;\n    return Math.pow(2, -10 * t) * Math.sin((t - 0.075) * (2 * Math.PI) / 0.3) + 1;\n  },\n};\n\nclass Tween {\n  constructor(target, props, duration, easing = 'easeOutQuad', onComplete = null) {\n    this.target = target;\n    this.startProps = {};\n    this.endProps = props;\n    this.duration = duration;\n    this.easingFn = Easing[easing] || Easing.easeOutQuad;\n    this.onComplete = onComplete;\n    this.elapsed = 0;\n    this.done = false;\n\n    for (const key in props) {\n      this.startProps[key] = target[key];\n    }\n  }\n\n  update(dt) {\n    if (this.done) return true;\n    this.elapsed += dt;\n    let t = Math.min(this.elapsed / this.duration, 1);\n    const easedT = this.easingFn(t);\n\n    for (const key in this.endProps) {\n      this.target[key] = this.startProps[key] + (this.endProps[key] - this.startProps[key]) * easedT;\n    }\n\n    if (t >= 1) {\n      this.done = true;\n      if (this.onComplete) this.onComplete();\n      return true;\n    }\n    return false;\n  }\n}\n\nclass TweenManager {\n  constructor() {\n    this.tweens = [];\n  }\n\n  add(target, props, duration, easing, onComplete) {\n    const tween = new Tween(target, props, duration, easing, onComplete);\n    this.tweens.push(tween);\n    return tween;\n  }\n\n  update(dt) {\n    this.tweens = this.tweens.filter(t => !t.update(dt));\n  }\n\n  clear() {\n    this.tweens = [];\n  }\n\n  get activeCount() {\n    return this.tweens.length;\n  }\n}\n\n// Particle system for match effects\nclass Particle {\n  constructor(x, y, vx, vy, color, life, size) {\n    this.x = x;\n    this.y = y;\n    this.vx = vx;\n    this.vy = vy;\n    this.color = color;\n    this.life = life;\n    this.maxLife = life;\n    this.size = size;\n    this.alpha = 1;\n  }\n\n  update(dt) {\n    this.x += this.vx * dt;\n    this.y += this.vy * dt;\n    this.vy += 200 * dt; // gravity\n    this.life -= dt;\n    this.alpha = Math.max(0, this.life / this.maxLife);\n    return this.life <= 0;\n  }\n}\n\nclass ParticleSystem {\n  constructor() {\n    this.particles = [];\n  }\n\n  emit(x, y, color, count = 8) {\n    for (let i = 0; i < count; i++) {\n      const angle = (Math.PI * 2 / count) * i + Math.random() * 0.5;\n      const speed = 80 + Math.random() * 120;\n      const vx = Math.cos(angle) * speed;\n      const vy = Math.sin(angle) * speed - 50;\n      const life = 0.3 + Math.random() * 0.4;\n      const size = 3 + Math.random() * 4;\n      this.particles.push(new Particle(x, y, vx, vy, color, life, size));\n    }\n  }\n\n  emitExplosion(x, y, color, count = 16) {\n    for (let i = 0; i < count; i++) {\n      const angle = Math.random() * Math.PI * 2;\n      const speed = 50 + Math.random() * 200;\n      const vx = Math.cos(angle) * speed;\n      const vy = Math.sin(angle) * speed - 100;\n      const life = 0.4 + Math.random() * 0.6;\n      const size = 2 + Math.random() * 6;\n      this.particles.push(new Particle(x, y, vx, vy, color, life, size));\n    }\n  }\n\n  update(dt) {\n    this.particles = this.particles.filter(p => !p.update(dt));\n  }\n\n  draw(ctx) {\n    for (const p of this.particles) {\n      ctx.globalAlpha = p.alpha;\n      ctx.fillStyle = p.color;\n      ctx.beginPath();\n      ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);\n      ctx.fill();\n    }\n    ctx.globalAlpha = 1;\n  }\n\n  get activeCount() {\n    return this.particles.length;\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Easing, Tween, TweenManager, Particle, ParticleSystem };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"ef939699-9dac-4e19-a950-f991f68c1f56","uuid":"e5ed230b-1be5-464d-a8f2-3d7be63bedb6"}
