{"type":"assistant","message":{"id":"msg_2026052308475171350cd44fe84559","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_cda88c43045946c4a211c90b","name":"Write","input":{"file_path":"D:/game-projects/douyin-idiom/build.py","content":"#!/usr/bin/env python3\n\"\"\"Build script for 成语大闯关 — minify JS/CSS for production\"\"\"\n\nimport os\nimport re\nimport json\n\nROOT = os.path.dirname(os.path.abspath(__file__))\nDIST = os.path.join(ROOT, 'dist')\n\ndef minify_js(code):\n    \"\"\"Basic JS minification: strip comments and collapse whitespace\"\"\"\n    # Remove single-line comments (but not URLs like http://)\n    code = re.sub(r'(?<!:)//.*$', '', code, flags=re.MULTILINE)\n    # Remove multi-line comments\n    code = re.sub(r'/\\*.*?\\*/', '', code, flags=re.DOTALL)\n    # Collapse multiple spaces/newlines\n    code = re.sub(r'\\s+', ' ', code)\n    # Remove spaces around operators\n    for op in ['=', '==', '===', '!=', '!==', '+=', '-=', '||', '&&', '+', '-', '*', '/', '>', '<', '>=', '<=']:\n        code = code.replace(f' {op} ', op)\n    return code.strip()\n\ndef minify_css(code):\n    \"\"\"Basic CSS minification\"\"\"\n    # Remove comments\n    code = re.sub(r'/\\*.*?\\*/', '', code, flags=re.DOTALL)\n    # Collapse whitespace\n    code = re.sub(r'\\s+', ' ', code)\n    # Remove spaces around certain chars\n    code = code.replace('{ ', '{').replace(' }', '}')\n    code = code.replace('; ', ';').replace(': ', ':')\n    return code.strip()\n\ndef copy_file(src, dst):\n    with open(src, 'r', encoding='utf-8') as f:\n        content = f.read()\n    with open(dst, 'w', encoding='utf-8') as f:\n        f.write(content)\n\ndef build():\n    os.makedirs(DIST, exist_ok=True)\n    os.makedirs(os.path.join(DIST, 'src', 'js'), exist_ok=True)\n    os.makedirs(os.path.join(DIST, 'src', 'css'), exist_ok=True)\n    os.makedirs(os.path.join(DIST, 'src', 'data'), exist_ok=True)\n\n    total_size = 0\n\n    # Minify JS files\n    js_dir = os.path.join(ROOT, 'src', 'js')\n    for fname in os.listdir(js_dir):\n        if fname.endswith('.js'):\n            with open(os.path.join(js_dir, fname), 'r', encoding='utf-8') as f:\n                code = f.read()\n            mini = minify_js(code)\n            out_path = os.path.join(DIST, 'src', 'js', fname)\n            with open(out_path, 'w', encoding='utf-8') as f:\n                f.write(mini)\n            sz = os.path.getsize(out_path)\n            total_size += sz\n            print(f'  JS: {fname} ({sz:,} bytes)')\n\n    # Minify CSS\n    css_path = os.path.join(ROOT, 'src', 'css', 'style.css')\n    if os.path.exists(css_path):\n        with open(css_path, 'r', encoding='utf-8') as f:\n            code = f.read()\n        mini = minify_css(code)\n        out_path = os.path.join(DIST, 'src', 'css', 'style.css')\n        with open(out_path, 'w', encoding='utf-8') as f:\n            f.write(mini)\n        sz = os.path.getsize(out_path)\n        total_size += sz\n        print(f'  CSS: style.css ({sz:,} bytes)')\n\n    # Copy data files\n    data_dir = os.path.join(ROOT, 'src', 'data')\n    if os.path.exists(data_dir):\n        for fname in os.listdir(data_dir):\n            src = os.path.join(data_dir, fname)\n            dst = os.path.join(DIST, 'src', 'data', fname)\n            copy_file(src, dst)\n            sz = os.path.getsize(dst)\n            total_size += sz\n            print(f'  Data: {fname} ({sz:,} bytes)')\n\n    # Copy index.html (update script/css paths)\n    with open(os.path.join(ROOT, 'index.html'), 'r', encoding='utf-8') as f:\n        html = f.read()\n    with open(os.path.join(DIST, 'index.html'), 'w', encoding='utf-8') as f:\n        f.write(html)\n    sz = os.path.getsize(os.path.join(DIST, 'index.html'))\n    total_size += sz\n    print(f'  HTML: index.html ({sz:,} bytes)')\n\n    # Copy config files\n    for cfg in ['game.json', 'project.config.json', 'privacy.html']:\n        src = os.path.join(ROOT, cfg)\n        if os.path.exists(src):\n            copy_file(src, os.path.join(DIST, cfg))\n            sz = os.path.getsize(os.path.join(DIST, cfg))\n            total_size += sz\n            print(f'  Config: {cfg} ({sz:,} bytes)')\n\n    mb = total_size / (1024 * 1024)\n    print(f'\\nTotal dist size: {total_size:,} bytes ({mb:.2f} MB)')\n    if mb > 2:\n        print('WARNING: Package exceeds 2MB target!')\n    else:\n        print('OK: Package within 2MB target.')\n\nif __name__ == '__main__':\n    print('Building 成语大闯关 dist...')\n    build()\n    print('Done.')\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"6be7998d-cc43-4adb-be9f-4939a8437d2d","uuid":"72cbf094-6394-4aee-a4ab-cabe9c3adfd5"}
