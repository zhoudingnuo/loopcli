!-- Main game -->\n53\t  <script src=\"src/js/Game.js\"></script>\n54\t\n55\t  <script>\n56\t    const canvas = document.getElementById('gameCanvas');\n57\t    const game = new Game(canvas);\n58\t\n59\t    // Handle resize\n60\t    function onResize() {\n61\t      game.renderer.resize();\n62\t      game.input.updateLayout(\n63\t        game.renderer.tileSize,\n64\t        game.renderer.boardX,\n65\t        game.renderer.boardY,\n66\t      );\n67\t    }\n68\t\n69\t    window.addEventListener('resize', onResize);\n70\t    window.addEventListener('orientationchange', () => setTimeout(onResize, 100));\n71\t\n72\t    // Unified click handler — routes through Navigation\n73\t    canvas.addEventListener('click', (e) => {\n74\t      const rect = canvas.getBoundingClientRect();\n75\t      const x = e.clientX - rect.left;\n76\t      const y = e.clientY - rect.top;\n77\t      const w = game.renderer.screenW;\n78\t      const h = game.renderer.screenH;\n79\t\n80\t      // Navigation screens\n81\t      if (game.nav.isActive()) {\n82\t        game.nav.handleClick(x, y, w, h);\n83\t        return;\n84\t      }\n85\t\n86\t      // In-game: check back-to-map button\n87\t      const backX = w - 50;\n88\t      const backY = game.renderer.boardY + game.renderer.tileSize * BOARD_SIZE + 25;\n89\t      if (x >= backX && x <= backX + 40 && y >= backY && y <= backY + 28) {\n90\t        game.nav.goTo('map');\n91\t        return;\n92\t      }\n93\t    });\n94\t\n95\t    // Start the game (shows main menu)\n96\t    game.start();\n97\t  </script>\n98\t</body>\n99\t</html>\n100\t"}]},"parent_tool_use_id":null,"session_id":"e7014494-9372-468d-b98b-69448d1a0f88","uuid":"1b943686-d124-4a9b-8a5c-41a08ebc3928","timestamp":"2026-05-22T22:06:37.090Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\douyin-match3\\index.html","content":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no, maximum-scale=1.0\">\n  <title>消消消大作战 - Match & Blast</title>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    html, body {\n      width: 100%; height: 100%;\n      overflow: hidden;\n      background: #FFF8E7;\n      touch-action: none;\n      -webkit-user-select: none;\n      user-select: none;\n    }\n    canvas {\n      display: block;\n      width: 100%;\n      height: 100%;\n    }\n  </style>\n</head>\n<body>\n  <canvas id=\"gameCanvas\"></canvas>\n\n  <!-- Phase 1+2: Core modules -->\n  <script src=\"src/js/Board.js\"></script>\n  <script src=\"src/js/MatchEngine.js\"></script>\n  <script src=\"src/js/Animation.js\"></script>\n  <script src=\"src/js/Obstacle.js\"></script>\n  <script src=\"src/js/AudioManager.js\"></script>\n  <script src=\"src/js/Boss.js\"></script>\n  <script src=\"src/js/levels.js\"></script>\n  <script src=\"src/js/Renderer.js\"></script>\n  <script src=\"src/js/InputHandler.js\"></script>\n  <script src=\"src/js/ScoreSystem.js\"></script>\n\n  <!-- Phase 3a: Meta-progression modules -->\n  <script src=\"src/js/DataManager.js\"></script>\n  <script src=\"src/js/CoinSystem.js\"></script>\n  <script src=\"src/js/Characters.js\"></script>\n  <script src=\"src/js/MapScreen.js\"></script>\n  <script src=\"src/js/ShopUI.js\"></script>\n\n  <!-- Phase 3b: Daily + Social -->\n  <script src=\"src/js/DailySystem.js\"></script>\n  <script src=\"src/js/SocialSystem.js\"></script>\n\n  <script src=\"src/js/Navigation.js\"></script>\n\n  <!-- Main game -->\n  <script src=\"src/js/Game.js\"></script>\n\n  <script>\n    const canvas = document.getElementById('gameCanvas');\n    const game = new Game(canvas);\n\n    // Handle resize\n    function onResize() {\n      game.renderer.resize();\n      game.input.updateLayout(\n        game.renderer.tileSize,\n        game.renderer.boardX,\n        game.renderer.boardY,\n      );\n    }\n\n    window.addEventListener('resize', onResize);\n    window.addEventListener('orientationchange', () => setTimeout(onResize, 100));\n\n    // Unified click handler — routes through Navigation\n    canvas.addEventListener('click', (e) => {\n      const rect = canvas.getBoundingClientRect();\n      const x = e.clientX - rect.left;\n      const y = e.clientY - rect.top;\n      const w = game.renderer.screenW;\n      const h = game.renderer.screenH;\n\n      // Navigation screens\n      if (game.nav.isActive()) {\n        game.nav.handleClick(x, y, w, h);\n        return;\n      }\n\n      // In-game: check back-to-map button\n      const backX = w - 50;\n      const backY = game.renderer.boardY + game.renderer.tileSize * BOARD_SIZE + 25;\n      if (x >= backX && x <= backX + 40 && y >= backY && y <= backY + 28) {\n        game.nav.goTo('map');\n        return;\n      }\n    });\n\n    // Start the game (shows main menu)\n    game.start();\n  </script>\n</body>\n</html>\n","numLines":100,"startLine":1,"totalLines":100}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_fd6cbcd3e1d9439ea3a46a8b","type":"tool_result","content":"1\t// Navigation.js — Full screen navigation: menu → map → character → game → result\n2\t\n3\tconst NAV_SCREENS = {\n4\t  MENU: 'menu',\n5\t  MAP: 'map',\n6\t  SHOP: 'shop',\n7\t  CHARACTER: 'character',\n8\t  GAME: 'game',\n9\t  RESULT: 'result',\n10\t  DAILY: 'daily',\n11\t  SOCIAL: 'social',\n12\t};\n13\t\n14\tclass Navigation {\n15\t  constructor(game) {\n16\t    this.game = game;\n17\t    this.screen = NAV_SCREENS.MENU;\n18\t    this.dataManager = game.dataManager;\n19\t    this.coinSystem = game.coinSystem;\n20\t    this.characterMgr = game.characterMgr;\n21\t    this.mapScreen = game.mapScreen;\n22\t    this.shopUI = game.shopUI;\n23\t    this.resultCoins = 0;\n24\t    this.resultWon = false;\n25\t    this.resultScore = 0;\n26\t    this.resultStars = 0;\n27\t    this.resultLevel = 0;\n28\t    this.menuAnim = 0;\n29\t  }\n30\t\n31\t  isActive() {\n32\t    return this.screen !== NAV_SCREENS.GAME;\n33\t  }\n34\t\n35\t  goTo(screen) {\n36\t    this.screen = screen;\n37\t  }\n38\t\n39\t  render(ctx, screenW, screenH) {\n40\t    switch (this.screen) {\n41\t      case NAV_SCREENS.MENU:\n42\t        this._renderMenu(ctx, screenW, screenH);\n43\t        break;\n44\t      case NAV_SCREENS.MAP:\n45\t        this.mapScreen.render(ctx, screenW, screenH);\n46\t        break;\n47\t      case NAV_SCREENS.SHOP:\n48\t        this.shopUI.render(ctx, screenW, screenH);\n49\t        break;\n50\t      case NAV_SCREENS.CHARACTER:\n51\t        this._renderCharacterSelect(ctx, screenW, screenH);\n52\t        break;\n53\t      case NAV_SCREENS.RESULT:\n54\t        this._renderResult(ctx, screenW, screenH);\n55\t        break;\n56\t      case NAV_SCREENS.DAILY:\n57\t        this.game.dailySystem.render(ctx, screenW, screenH);\n58\t        break;\n59\t      case NAV_SCREENS.SOCIAL:\n60\t        this.game.socialSystem.render(ctx, screenW, screenH);\n61\t        break;\n62\t    }\n63\t  }\n64\t\n65\t  handleClick(x, y, screenW, screenH) {\n66\t    switch (this.screen) {\n67\t      case NAV_SCREENS.MENU:\n68\t        return this._handleMenuClick(x, y, screenW, screenH);\n69\t      case NAV_SCREENS.MAP:\n70\t        return this._handleMapClick(x, y, screenW, screenH);\n71\t      case NAV_SCREENS.SHOP:\n72\t        return this._handleShopClick(x, y, screenW, screenH);\n73\t      case NAV_SCREENS.CHARACTER:\n74\t        return this._handleCharacterClick(x, y, screenW, screenH);\n75\t      case NAV_SCREENS.RESULT:\n76\t        return this._handleResultClick(x, y, screenW, screenH);\n77\t      case NAV_SCREENS.DAILY:\n78\t        return this._handleDailyClick(x, y, screenW, screenH);\n79\t      case NAV_SCREENS.SOCIAL:\n80\t        return this._handleSocialClick(x, y, screenW, screenH);\n81\t    }\n82\t    return null;\n83\t  }\n84\t\n85\t  // --- MENU ---\n86\t  _renderMenu(ctx, w, h) {\n87\t    this.menuAnim += 1 / 60;\n88\t\n89\t    // Gradient background\n90\t    const grad = ctx.createLinearGradient(0, 0, 0, h);\n91\t    grad.addColorStop(0, '#FFE8F0');\n92\t    grad.addColorStop(0.5, '#FFF8E7');\n93\t    grad.addColorStop(1, '#E3F2FD');\n94\t    ctx.fillStyle = grad;\n95\t    ctx.fillRect(0, 0, w, h);\n96\t\n97\t    // Floating fruit emojis\n98\t    const emojis = ['🍎', '🍌', '🫐', '🍏', '🍇', '🍊'];\n99\t    for (let i = 0; i < 12; i++) {\n100\t      const bx = (w * 0.08 + (i * 137.5) % (w * 0.84));\n101\t      const by = (h * 0.08 + (i * 97.3 + Math.sin(this.menuAnim * 0.8 + i * 0.7) * 25) % (h * 0.75));\n102\t      ctx.globalAlpha = 0.12;\n103\t      ctx.font = `${22 + (i % 3) * 8}px sans-serif`;\n104\t      ctx.textAlign = 'center';\n105\t      ctx.fillText(emojis[i % emojis.length], bx, by);\n106\t    }\n107\t    ctx.globalAlpha = 1;\n108\t\n109\t    // Title\n110\t    const titleY = h * 0.22;\n111\t    ctx.fillStyle = '#5D4037';\n112\t    ctx.font = 'bold 38px sans-serif';\n113\t    ctx.textAlign = 'center';\n114\t    ctx.fillText('消消消大作战', w / 2, titleY);\n115\t\n116\t    // Subtitle with wave animation\n117\t    ctx.font = '18px sans-serif';\n118\t    ctx.fillStyle = '#8D6E63';\n119\t    ctx.fillText('Match & Blast', w / 2, titleY + 35);\n120\t\n121\t    // Fruit emoji row\n122\t    ctx.font = '30px sans-serif';\n123\t    for (let i = 0; i < 6; i++) {\n124\t      const fx = w / 2 - 75 + i * 30;\n125\t      const fy = titleY + 70 + Math.sin(this.menuAnim * 2 + i * 0.8) * 5;\n126\t      ctx.fillText(emojis[i], fx, fy);\n127\t    }\n128\t\n129\t    // Start button with pulse\n130\t    const btnW = 200, btnH = 52;\n131\t    const btnX = (w - btnW) / 2;\n132\t    const btnY = h * 0.52;\n133\t    const pulse = 1 + Math.sin(this.menuAnim * 2.5) * 0.03;\n134\t\n135\t    ctx.save();\n136\t    ctx.translate(w / 2, btnY + btnH / 2);\n137\t    ctx.scale(pulse, pulse);\n138\t    ctx.translate(-w / 2, -(btnY + btnH / 2));\n139\t\n140\t    ctx.fillStyle = '#FFB800';\n141\t    ctx.shadowColor = '#FFB80088';\n142\t    ctx.shadowBlur = 15;\n143\t    this._roundRect(ctx, btnX, btnY, btnW, btnH, 26);\n144\t    ctx.fill();\n145\t    ctx.shadowBlur = 0;\n146\t\n147\t    ctx.fillStyle = '#FFF';\n148\t    ctx.font = 'bold 20px sans-serif';\n149\t    ctx.fillText('🎮 开始游戏', w / 2, btnY + 34);\n150\t    ctx.restore();\n151\t\n152\t    // Continue (if has progress)\n153\t    const completed = Object.keys(this.dataManager.data.levelStars).length;\n154\t    if (completed > 0) {\n155\t      const cBtnY = btnY + btnH + 20;\n156\t      ctx.fillStyle = '#6BCB77';\n157\t      this._roundRect(ctx, btnX, cBtnY, btnW, 44, 22);\n158\t      ctx.fill();\n159\t      ctx.fillStyle = '#FFF';\n160\t      ctx.font = 'bold 16px sans-serif';\n161\t      ctx.fillText(`继续游戏 (${completed}关)`, w / 2, cBtnY + 28);\n162\t    }\n163\t\n164\t    // Version\n165\t    ctx.fillStyle = '#C0B8A8';\n166\t    ctx.font = '12px sans-serif';\n167\t    ctx.fillText('Phase 3b v1.0', w / 2, h - 20);\n168\t  }\n169\t\n170\t  _handleMenuClick(x, y, w, h) {\n171\t    const btnW = 200, btnH = 52;\n172\t    const btnX = (w - btnW) / 2;\n173\t    const btnY = h * 0.52;\n174\t\n175\t    // Start button\n176\t    if (x >= btnX && x <= btnX + btnW && y >= btnY && y <= btnY + btnH) {\n177\t      this.goTo(NAV_SCREENS.MAP);\n178\t      return { action: 'start' };\n179\t    }\n180\t\n181\t    // Continue button\n182\t    const completed = Object.keys(this.dataManager.data.levelStars).length;\n183\t    if (completed > 0) {\n184\t      const cBtnY = btnY + btnH + 20;\n185\t      if (x >= btnX && x <= btnX + btnW && y >= cBtnY && y <= cBtnY + 44) {\n186\t        this.goTo(NAV_SCREENS.MAP);\n187\t        return { action: 'start' };\n188\t      }\n189\t    }\n190\t    return null;\n191\t  }\n192\t\n193\t  // --- MAP ---\n194\t  _handleMapClick(x, y, w, h) {\n195\t    const result = this.mapScreen.handleClick(x, y, w, h);\n196\t    if (!result) return null;\n197\t\n198\t    if (result.action === 'play') {\n199\t      this._startLevel(result.level);\n200\t    } else if (result.action === 'shop') {\n201\t      this.goTo(NAV_SCREENS.SHOP);\n202\t    } else if (result.action === 'character') {\n203\t      this.goTo(NAV_SCREENS.CHARACTER);\n204\t    } else if (result.action === 'daily') {\n205\t      this.goTo(NAV_SCREENS.DAILY);\n206\t    } else if (result.action === 'social') {\n207\t      this.goTo(NAV_SCREENS.SOCIAL);\n208\t    }\n209\t    return result;\n210\t  }\n211\t\n212\t  _startLevel(levelIdx) {\n213\t    this.game._loadLevel(levelIdx);\n214\t    this.game.state = STATES.IDLE;\n215\t    this.characterMgr.applySkill(\n216\t      this.dataManager.selectedCharacter,\n217\t      this.game, 'level_start', null,\n218\t    );\n219\t    this.goTo(NAV_SCREENS.GAME);\n220\t  }\n221\t\n222\t  // --- SHOP ---\n223\t  _handleShopClick(x, y, w, h) {\n224\t    const result = this.shopUI.handleClick(x, y, w, h);\n225\t    if (!result) return null;\n226\t    if (result.action === 'buy') {\n227\t      this.coinSystem.buy(result.itemId);\n228\t    } else if (result.action === 'back') {\n229\t      this.goTo(NAV_SCREENS.MAP);\n230\t    }\n231\t    return result;\n232\t  }\n233\t\n234\t  // --- CHARACTER SELECT ---\n235\t  _renderCharacterSelect(ctx, w, h) {\n236\t    // Background\n237\t    const grad = ctx.createLinearGradient(0, 0, 0, h);\n238\t    grad.addColorStop(0, '#F3E5F5');\n239\t    grad.addColorStop(1, '#FFF8E7');\n240\t    ctx.fillStyle = grad;\n241\t    ctx.fillRect(0, 0, w, h);\n242\t\n243\t    // Title bar\n244\t    ctx.fillStyle = '#B47AEA';\n245\t    this._roundRect(ctx, 10, 8, w - 20, 48, 12);\n246\t    ctx.fill();\n247\t    ctx.fillStyle = '#FFF';\n248\t    ctx.font = 'bold 20px sans-serif';\n249\t    ctx.textAlign = 'center';\n250\t    ctx.fillText('👤 选择角色', w / 2, 40);\n251\t\n252\t    // Character cards\n253\t    const chars = this.characterMgr.getAll();\n254\t    const cardW = Math.min((w - 50) / 2, 160);\n255\t    const cardH = 130;\n256\t    const totalGridW = cardW * 2 + 16;\n257\t    const gridStartX = (w - totalGridW) / 2;\n258\t    const startY = 75;\n259\t\n260\t    for (let i = 0; i < chars.length; i++) {\n261\t      const ch = chars[i];\n262\t      const row = Math.floor(i / 2);\n263\t      const col = i % 2;\n264\t      const cx = gridStartX + col * (cardW + 16);\n265\t      const cy = startY + row * (cardH + 12);\n266\t      const unlocked = this.characterMgr.isUnlocked(i, this.dataManager.unlockedLevel);\n267\t      const selected = this.dataManager.selectedCharacter === i;\n268\t\n269\t      // Card background\n270\t      if (selected) {\n271\t        ctx.fillStyle = '#FFE0B2';\n272\t      } else if (unlocked) {\n273\t        ctx.fillStyle = '#FFFFFFEE';\n274\t      } else {\n275\t        ctx.fillStyle = '#E8E0D8';\n276\t      }\n277\t      this._roundRect(ctx, cx, cy, cardW, cardH, 12);\n278\t      ctx.fill();\n279\t\n280\t      // Selected border\n281\t      if (selected) {\n282\t        ctx.strokeStyle = '#FFB800';\n283\t        ctx.lineWidth = 3;\n284\t        this._roundRect(ctx, cx, cy, cardW, cardH, 12);\n285\t        ctx.stroke();\n286\t\n287\t        // Check mark\n288\t        ctx.fillStyle = '#FFB800';\n289\t        ctx.font = '16px sans-serif';\n290\t        ctx.textAlign = 'right';\n291\t        ctx.fillText('✓', cx + cardW - 8, cy + 18);\n292\t      }\n293\t\n294\t      // Emoji\n295\t      ctx.font = '36px sans-serif';\n296\t      ctx.textAlign = 'center';\n297\t      ctx.fillText(unlocked ? ch.emoji : '🔒', cx + cardW / 2, cy + 45);\n298\t\n299\t      // Name\n300\t      ctx.fillStyle = unlocked ? '#5D4037' : '#A09888';\n301\t      ctx.font = 'bold 16px sans-serif';\n302\t      ctx.fillText(ch.name, cx + cardW / 2, cy + 72);\n303\t\n304\t      // Title\n305\t      ctx.font = '11px sans-serif';\n306\t      ctx.fillStyle = unlocked ? '#B47AEA' : '#C0B8A8';\n307\t      ctx.fillText(ch.title, cx + cardW / 2, cy + 88);\n308\t\n309\t      // Description or unlock requirement\n310\t      ctx.fillStyle = unlocked ? '#8D6E63' : '#B0A898';\n311\t      ctx.font = '10px sans-serif';\n312\t      const desc = unlocked ? ch.desc : `通过第${ch.unlockLevel}关解锁`;\n313\t      // Word wrap for long text\n314\t      if (desc.length > 10) {\n315\t        const mid = Math.ceil(desc.length / 2);\n316\t        const spaceIdx = desc.indexOf(' ', mid - 3);\n317\t        if (spaceIdx > 0 && spaceIdx < desc.length - 1) {\n318\t          ctx.fillText(desc.substring(0, spaceIdx), cx + cardW / 2, cy + 104);\n319\t          ctx.fillText(desc.substring(spaceIdx + 1), cx + cardW / 2, cy + 118);\n320\t        } else {\n321\t          ctx.fillText(desc.substring(0, Math.ceil(desc.length / 2)), cx + cardW / 2, cy + 104);\n322\t          ctx.fillText(desc.substring(Math.ceil(desc.length / 2)), cx + cardW / 2, cy + 118);\n323\t        }\n324\t      } else {\n325\t        ctx.fillText(desc, cx + cardW / 2, cy + 110);\n326\t      }\n327\t    }\n328\t\n329\t    // Confirm button\n330\t    ctx.fillStyle = '#8D6E63';\n331\t    this._roundRect(ctx, 20, h - 58, w - 40, 42, 21);\n332\t    ctx.fill();\n333\t    ctx.fillStyle = '#FFF';\n334\t    ctx.font = 'bold 16px sans-serif';\n335\t    ctx.textAlign = 'center';\n336\t    ctx.fillText('确认返回', w / 2, h - 32);\n337\t  }\n338\t\n339\t  _handleCharacterClick(x, y, w, h) {\n340\t    const chars = this.characterMgr.getAll();\n341\t    const cardW = Math.min((w - 50) / 2, 160);\n342\t    const cardH = 130;\n343\t    const totalGridW = cardW * 2 + 16;\n344\t    const gridStartX = (w - totalGridW) / 2;\n345\t    const startY = 75;\n346\t\n347\t    for (let i = 0; i < chars.length; i++) {\n348\t      const row = Math.floor(i / 2);\n349\t      const col = i % 2;\n350\t      const cx = gridStartX + col * (cardW + 16);\n351\t      const cy = startY + row * (cardH + 12);\n352\t      if (x >= cx && x <= cx + cardW && y >= cy && y <= cy + cardH) {\n353\t        if (this.characterMgr.isUnlocked(i, this.dataManager.unlockedLevel)) {\n354\t          this.dataManager.selectedCharacter = i;\n355\t        }\n356\t        return { action: 'select_char', charId: i };\n357\t      }\n358\t    }\n359\t\n360\t    // Confirm button\n361\t    if (y >= h - 58 && y <= h - 16 && x >= 20 && x <= w - 20) {\n362\t      this.goTo(NAV_SCREENS.MAP);\n363\t      return { action: 'back' };\n364\t    }\n365\t    return null;\n366\t  }\n367\t\n368\t  // --- RESULT ---\n369\t  showResult(won, score, stars, level) {\n370\t    this.resultWon = won;\n371\t    this.resultScore = score;\n372\t    this.resultStars = stars;\n373\t    this.resultLevel = level;\n374\t    this.resultCoins = 0;\n375\t    if (won && stars > 0) {\n376\t      this.resultCoins = this.coinSystem.awardStars(stars);\n377\t      this.dataManager.setLevelStars(level, stars);\n378\t    }\n379\t    this.goTo(NAV_SCREENS.RESULT);\n380\t  }\n381\t\n382\t  _renderResult(ctx, w, h) {\n383\t    // Dim background\n384\t    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n385\t    ctx.fillRect(0, 0, w, h);\n386\t\n387\t    const pw = Math.min(320, w - 40);\n388\t    const ph = 330;\n389\t    const px = (w - pw) / 2;\n390\t    const py = (h - ph) / 2;\n391\t\n392\t    // Panel\n393\t    ctx.fillStyle = '#FFF8E7';\n394\t    this._roundRect(ctx, px, py, pw, ph, 16);\n395\t    ctx.fill();\n396\t    ctx.strokeStyle = '#FFB800';\n397\t    ctx.lineWidth = 3;\n398\t    this._roundRect(ctx, px, py, pw, ph, 16);\n399\t    ctx.stroke();\n400\t\n401\t    ctx.textAlign = 'center';\n402\t\n403\t    // Title\n404\t    ctx.fillStyle = '#5D4037';\n405\t    ctx.font = 'bold 24px sans-serif';\n406\t    ctx.fillText(this.resultWon ? '🎉 恭喜过关！' : '😢 挑战失败', w / 2, py + 45);\n407\t\n408\t    // Level number\n409\t    ctx.font = '14px sans-serif';\n410\t    ctx.fillStyle = '#8D6E63';\n411\t    ctx.fillText(`第 ${this.resultLevel} 关`, w / 2, py + 68);\n412\t\n413\t    // Score\n414\t    ctx.font = 'bold 36px sans-serif';\n415\t    ctx.fillStyle = '#FFB800';\n416\t    ctx.fillText(this.resultScore, w / 2, py + 110);\n417\t    ctx.font = '14px sans-serif';\n418\t    ctx.fillStyle = '#8D6E63';\n419\t    ctx.fillText('得分', w / 2, py + 130);\n420\t\n421\t    // Stars\n422\t    if (this.resultWon) {\n423\t      for (let i = 0; i < 3; i++) {\n424\t        ctx.font = '30px sans-serif';\n425\t        ctx.fillText(i < this.resultStars ? '⭐' : '☆', w / 2 - 40 + i * 40, py + 172);\n426\t      }\n427\t    }\n428\t\n429\t    // Coins earned\n430\t    if (this.resultCoins > 0) {\n431\t      ctx.fillStyle = '#FFB800';\n432\t      ctx.font = 'bold 18px sans-serif';\n433\t      ctx.fillText(`+${this.resultCoins} 🪙`, w / 2, py + 205);\n434\t      ctx.fillStyle = '#8D6E63';\n435\t      ctx.font = '12px sans-serif';\n436\t      ctx.fillText(`余额: ${this.dataManager.coins} 🪙`, w / 2, py + 224);\n437\t    }\n438\t\n439\t    // Buttons\n440\t    const btnW = 120, btnH = 42;\n441\t    const btnY = py + ph - 65;\n442\t\n443\t    if (this.resultWon) {\n444\t      // Next level\n445\t      ctx.fillStyle = '#6BCB77';\n446\t      this._roundRect(ctx, w / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n447\t      ctx.fill();\n448\t      ctx.fillStyle = '#FFF';\n449\t      ctx.font = 'bold 16px sans-serif';\n450\t      ctx.fillText('下一关', w / 2 - btnW / 2 - 10, btnY + 27);\n451\t    } else {\n452\t      // Retry\n453\t      ctx.fillStyle = '#FF9A3C';\n454\t      this._roundRect(ctx, w / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n455\t      ctx.fill();\n456\t      ctx.fillStyle = '#FFF';\n457\t      ctx.font = 'bold 16px sans-serif';\n458\t      ctx.fillText('重试', w / 2 - btnW / 2 - 10, btnY + 27);\n459\t    }\n460\t\n461\t    // Map button\n462\t    ctx.fillStyle = '#8D6E63';\n463\t    this._roundRect(ctx, w / 2 + 10, btnY, btnW, btnH, btnH / 2);\n464\t    ctx.fill();\n465\t    ctx.fillStyle = '#FFF';\n466\t    ctx.fillText('🗺️ 地图', w / 2 + btnW / 2 + 10, btnY + 27);\n467\t  }\n468\t\n469\t  _handleResultClick(x, y, w, h) {\n470\t    const pw = Math.min(320, w - 40);\n471\t    const ph = 330;\n472\t    const px = (w - pw) / 2;\n473\t    const py = (h - ph) / 2;\n474\t    const btnW = 120, btnH = 42;\n475\t    const btnY = py + ph - 65;\n476\t\n477\t    // Next / Retry button\n478\t    if (x >= w / 2 - btnW - 10 && x <= w / 2 - 10 && y >= btnY && y <= btnY + btnH) {\n479\t      if (this.resultWon) {\n480\t        this.game.nextLevel();\n481\t      } else {\n482\t        this.game.retry();\n483\t      }\n484\t      this.characterMgr.applySkill(\n485\t        this.dataManager.selectedCharacter,\n486\t        this.game, 'level_start', null,\n487\t      );\n488\t      this.goTo(NAV_SCREENS.GAME);\n489\t      return { action: this.resultWon ? 'next' : 'retry' };\n490\t    }\n491\t\n492\t    // Map button\n493\t    if (x >= w / 2 + 10 && x <= w / 2 + 10 + btnW && y >= btnY && y <= btnY + btnH) {\n494\t      this.goTo(NAV_SCREENS.MAP);\n495\t      return { action: 'map' };\n496\t    }\n497\t    return null;\n498\t  }\n499\t\n500\t  // --- DAILY ---\n501\t  _handleDailyClick(x, y, w, h) {\n502\t    const result = this.game.dailySystem.handleClick(x, y, w, h);\n503\t    if (!result) return null;\n504\t    if (result.action === 'back') {\n505\t      this.goTo(NAV_SCREENS.MAP);\n506\t    } else if (result.action === 'play_challenge') {\n507\t      this._startLevel(result.level);\n508\t    }\n509\t    return result;\n510\t  }\n511\t\n512\t  // --- SOCIAL ---\n513\t  _handleSocialClick(x, y, w, h) {\n514\t    const result = this.game.socialSystem.handleClick(x, y, w, h);\n515\t    if (!result) return null;\n516\t    if (result.action === 'back') {\n517\t      this.goTo(NAV_SCREENS.MAP);\n518\t    } else if (result.action === 'pk') {\n519\t      const pk = this.game.socialSystem.startPK(result.friendId);\n520\t      if (pk) {\n521\t        // Simulate PK result\n522\t        const myScore = Math.floor(Math.random() * 5000) + 1000;\n523\t        const theirScore = Math.floor(Math.random() * 5000) + 1000;\n524\t        const pkResult = this.game.socialSystem.resolvePK(result.friendId, myScore, theirScore);\n525\t        return { action: 'pk_result', ...pkResult, myScore, theirScore };\n526\t      }\n527\t    }\n528\t    return result;\n529\t  }\n530\t\n531\t  _roundRect(ctx, x, y, w, h, r) {\n532\t    ctx.beginPath();\n533\t    ctx.moveTo(x + r, y);\n534\t    ctx.lineTo(x + w - r, y);\n535\t    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n536\t    ctx.lineTo(x + w, y + h - r);\n537\t    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n538\t    ctx.lineTo(x + r, y + h);\n539\t    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n540\t    ctx.lineTo(x, y + r);\n541\t    ctx.quadraticCurveTo(x, y, x + r, y);\n542\t    ctx.closePath();\n543\t  }\n544\t}\n545\t\n546\tif (typeof module !== 'undefined') module.exports = { Navigation, NAV_SCREENS };\n547\t"}]},"parent_tool_use_id":null,"session_id":"e7014494-9372-468d-b98b-69448d1a0f88","uuid":"060b44b1-000a-423a-b95e-e6e9074f7c83","timestamp":"2026-05-22T22:06:37.092Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\douyin-match3\\src\\js\\Navigation.js","content":"// Navigation.js — Full screen navigation: menu → map → character → game → result\n\nconst NAV_SCREENS = {\n  MENU: 'menu',\n  MAP: 'map',\n  SHOP: 'shop',\n  CHARACTER: 'character',\n  GAME: 'game',\n  RESULT: 'result',\n  DAILY: 'daily',\n  SOCIAL: 'social',\n};\n\nclass Navigation {\n  constructor(game) {\n    this.game = game;\n    this.screen = NAV_SCREENS.MENU;\n    this.dataManager = game.dataManager;\n    this.coinSystem = game.coinSystem;\n    this.characterMgr = game.characterMgr;\n    this.mapScreen = game.mapScreen;\n    this.shopUI = game.shopUI;\n    this.resultCoins = 0;\n    this.resultWon = false;\n    this.resultScore = 0;\n    this.resultStars = 0;\n    this.resultLevel = 0;\n    this.menuAnim = 0;\n  }\n\n  isActive() {\n    return this.screen !== NAV_SCREENS.GAME;\n  }\n\n  goTo(screen) {\n    this.screen = screen;\n  }\n\n  render(ctx, screenW, screenH) {\n    switch (this.screen) {\n      case NAV_SCREENS.MENU:\n        this._renderMenu(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.MAP:\n        this.mapScreen.render(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.SHOP:\n        this.shopUI.render(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.CHARACTER:\n        this._renderCharacterSelect(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.RESULT:\n        this._renderResult(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.DAILY:\n        this.game.dailySystem.render(ctx, screenW, screenH);\n        break;\n      case NAV_SCREENS.SOCIAL:\n        this.game.socialSystem.render(ctx, screenW, screenH);\n        break;\n    }\n  }\n\n  handleClick(x, y, screenW, screenH) {\n    switch (this.screen) {\n      case NAV_SCREENS.MENU:\n        return this._handleMenuClick(x, y, screenW, screenH);\n      case NAV_SCREENS.MAP:\n        return this._handleMapClick(x, y, screenW, screenH);\n      case NAV_SCREENS.SHOP:\n        return this._handleShopClick(x, y, screenW, screenH);\n      case NAV_SCREENS.CHARACTER:\n        return this._handleCharacterClick(x, y, screenW, screenH);\n      case NAV_SCREENS.RESULT:\n        return this._handleResultClick(x, y, screenW, screenH);\n      case NAV_SCREENS.DAILY:\n        return this._handleDailyClick(x, y, screenW, screenH);\n      case NAV_SCREENS.SOCIAL:\n        return this._handleSocialClick(x, y, screenW, screenH);\n    }\n    return null;\n  }\n\n  // --- MENU ---\n  _renderMenu(ctx, w, h) {\n    this.menuAnim += 1 / 60;\n\n    // Gradient background\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0, '#FFE8F0');\n    grad.addColorStop(0.5, '#FFF8E7');\n    grad.addColorStop(1, '#E3F2FD');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n\n    // Floating fruit emojis\n    const emojis = ['🍎', '🍌', '🫐', '🍏', '🍇', '🍊'];\n    for (let i = 0; i < 12; i++) {\n      const bx = (w * 0.08 + (i * 137.5) % (w * 0.84));\n      const by = (h * 0.08 + (i * 97.3 + Math.sin(this.menuAnim * 0.8 + i * 0.7) * 25) % (h * 0.75));\n      ctx.globalAlpha = 0.12;\n      ctx.font = `${22 + (i % 3) * 8}px sans-serif`;\n      ctx.textAlign = 'center';\n      ctx.fillText(emojis[i % emojis.length], bx, by);\n    }\n    ctx.globalAlpha = 1;\n\n    // Title\n    const titleY = h * 0.22;\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 38px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('消消消大作战', w / 2, titleY);\n\n    // Subtitle with wave animation\n    ctx.font = '18px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText('Match & Blast', w / 2, titleY + 35);\n\n    // Fruit emoji row\n    ctx.font = '30px sans-serif';\n    for (let i = 0; i < 6; i++) {\n      const fx = w / 2 - 75 + i * 30;\n      const fy = titleY + 70 + Math.sin(this.menuAnim * 2 + i * 0.8) * 5;\n      ctx.fillText(emojis[i], fx, fy);\n    }\n\n    // Start button with pulse\n    const btnW = 200, btnH = 52;\n    const btnX = (w - btnW) / 2;\n    const btnY = h * 0.52;\n    const pulse = 1 + Math.sin(this.menuAnim * 2.5) * 0.03;\n\n    ctx.save();\n    ctx.translate(w / 2, btnY + btnH / 2);\n    ctx.scale(pulse, pulse);\n    ctx.translate(-w / 2, -(btnY + btnH / 2));\n\n    ctx.fillStyle = '#FFB800';\n    ctx.shadowColor = '#FFB80088';\n    ctx.shadowBlur = 15;\n    this._roundRect(ctx, btnX, btnY, btnW, btnH, 26);\n    ctx.fill();\n    ctx.shadowBlur = 0;\n\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.fillText('🎮 开始游戏', w / 2, btnY + 34);\n    ctx.restore();\n\n    // Continue (if has progress)\n    const completed = Object.keys(this.dataManager.data.levelStars).length;\n    if (completed > 0) {\n      const cBtnY = btnY + btnH + 20;\n      ctx.fillStyle = '#6BCB77';\n      this._roundRect(ctx, btnX, cBtnY, btnW, 44, 22);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText(`继续游戏 (${completed}关)`, w / 2, cBtnY + 28);\n    }\n\n    // Version\n    ctx.fillStyle = '#C0B8A8';\n    ctx.font = '12px sans-serif';\n    ctx.fillText('Phase 3b v1.0', w / 2, h - 20);\n  }\n\n  _handleMenuClick(x, y, w, h) {\n    const btnW = 200, btnH = 52;\n    const btnX = (w - btnW) / 2;\n    const btnY = h * 0.52;\n\n    // Start button\n    if (x >= btnX && x <= btnX + btnW && y >= btnY && y <= btnY + btnH) {\n      this.goTo(NAV_SCREENS.MAP);\n      return { action: 'start' };\n    }\n\n    // Continue button\n    const completed = Object.keys(this.dataManager.data.levelStars).length;\n    if (completed > 0) {\n      const cBtnY = btnY + btnH + 20;\n      if (x >= btnX && x <= btnX + btnW && y >= cBtnY && y <= cBtnY + 44) {\n        this.goTo(NAV_SCREENS.MAP);\n        return { action: 'start' };\n      }\n    }\n    return null;\n  }\n\n  // --- MAP ---\n  _handleMapClick(x, y, w, h) {\n    const result = this.mapScreen.handleClick(x, y, w, h);\n    if (!result) return null;\n\n    if (result.action === 'play') {\n      this._startLevel(result.level);\n    } else if (result.action === 'shop') {\n      this.goTo(NAV_SCREENS.SHOP);\n    } else if (result.action === 'character') {\n      this.goTo(NAV_SCREENS.CHARACTER);\n    } else if (result.action === 'daily') {\n      this.goTo(NAV_SCREENS.DAILY);\n    } else if (result.action === 'social') {\n      this.goTo(NAV_SCREENS.SOCIAL);\n    }\n    return result;\n  }\n\n  _startLevel(levelIdx) {\n    this.game._loadLevel(levelIdx);\n    this.game.state = STATES.IDLE;\n    this.characterMgr.applySkill(\n      this.dataManager.selectedCharacter,\n      this.game, 'level_start', null,\n    );\n    this.goTo(NAV_SCREENS.GAME);\n  }\n\n  // --- SHOP ---\n  _handleShopClick(x, y, w, h) {\n    const result = this.shopUI.handleClick(x, y, w, h);\n    if (!result) return null;\n    if (result.action === 'buy') {\n      this.coinSystem.buy(result.itemId);\n    } else if (result.action === 'back') {\n      this.goTo(NAV_SCREENS.MAP);\n    }\n    return result;\n  }\n\n  // --- CHARACTER SELECT ---\n  _renderCharacterSelect(ctx, w, h) {\n    // Background\n    const grad = ctx.createLinearGradient(0, 0, 0, h);\n    grad.addColorStop(0, '#F3E5F5');\n    grad.addColorStop(1, '#FFF8E7');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, w, h);\n\n    // Title bar\n    ctx.fillStyle = '#B47AEA';\n    this._roundRect(ctx, 10, 8, w - 20, 48, 12);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('👤 选择角色', w / 2, 40);\n\n    // Character cards\n    const chars = this.characterMgr.getAll();\n    const cardW = Math.min((w - 50) / 2, 160);\n    const cardH = 130;\n    const totalGridW = cardW * 2 + 16;\n    const gridStartX = (w - totalGridW) / 2;\n    const startY = 75;\n\n    for (let i = 0; i < chars.length; i++) {\n      const ch = chars[i];\n      const row = Math.floor(i / 2);\n      const col = i % 2;\n      const cx = gridStartX + col * (cardW + 16);\n      const cy = startY + row * (cardH + 12);\n      const unlocked = this.characterMgr.isUnlocked(i, this.dataManager.unlockedLevel);\n      const selected = this.dataManager.selectedCharacter === i;\n\n      // Card background\n      if (selected) {\n        ctx.fillStyle = '#FFE0B2';\n      } else if (unlocked) {\n        ctx.fillStyle = '#FFFFFFEE';\n      } else {\n        ctx.fillStyle = '#E8E0D8';\n      }\n      this._roundRect(ctx, cx, cy, cardW, cardH, 12);\n      ctx.fill();\n\n      // Selected border\n      if (selected) {\n        ctx.strokeStyle = '#FFB800';\n        ctx.lineWidth = 3;\n        this._roundRect(ctx, cx, cy, cardW, cardH, 12);\n        ctx.stroke();\n\n        // Check mark\n        ctx.fillStyle = '#FFB800';\n        ctx.font = '16px sans-serif';\n        ctx.textAlign = 'right';\n        ctx.fillText('✓', cx + cardW - 8, cy + 18);\n      }\n\n      // Emoji\n      ctx.font = '36px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText(unlocked ? ch.emoji : '🔒', cx + cardW / 2, cy + 45);\n\n      // Name\n      ctx.fillStyle = unlocked ? '#5D4037' : '#A09888';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText(ch.name, cx + cardW / 2, cy + 72);\n\n      // Title\n      ctx.font = '11px sans-serif';\n      ctx.fillStyle = unlocked ? '#B47AEA' : '#C0B8A8';\n      ctx.fillText(ch.title, cx + cardW / 2, cy + 88);\n\n      // Description or unlock requirement\n      ctx.fillStyle = unlocked ? '#8D6E63' : '#B0A898';\n      ctx.font = '10px sans-serif';\n      const desc = unlocked ? ch.desc : `通过第${ch.unlockLevel}关解锁`;\n      // Word wrap for long text\n      if (desc.length > 10) {\n        const mid = Math.ceil(desc.length / 2);\n        const spaceIdx = desc.indexOf(' ', mid - 3);\n        if (spaceIdx > 0 && spaceIdx < desc.length - 1) {\n          ctx.fillText(desc.substring(0, spaceIdx), cx + cardW / 2, cy + 104);\n          ctx.fillText(desc.substring(spaceIdx + 1), cx + cardW / 2, cy + 118);\n        } else {\n          ctx.fillText(desc.substring(0, Math.ceil(desc.length / 2)), cx + cardW / 2, cy + 104);\n          ctx.fillText(desc.substring(Math.ceil(desc.length / 2)), cx + cardW / 2, cy + 118);\n        }\n      } else {\n        ctx.fillText(desc, cx + cardW / 2, cy + 110);\n      }\n    }\n\n    // Confirm button\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, 20, h - 58, w - 40, 42, 21);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 16px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('确认返回', w / 2, h - 32);\n  }\n\n  _handleCharacterClick(x, y, w, h) {\n    const chars = this.characterMgr.getAll();\n    const cardW = Math.min((w - 50) / 2, 160);\n    const cardH = 130;\n    const totalGridW = cardW * 2 + 16;\n    const gridStartX = (w - totalGridW) / 2;\n    const startY = 75;\n\n    for (let i = 0; i < chars.length; i++) {\n      const row = Math.floor(i / 2);\n      const col = i % 2;\n      const cx = gridStartX + col * (cardW + 16);\n      const cy = startY + row * (cardH + 12);\n      if (x >= cx && x <= cx + cardW && y >= cy && y <= cy + cardH) {\n        if (this.characterMgr.isUnlocked(i, this.dataManager.unlockedLevel)) {\n          this.dataManager.selectedCharacter = i;\n        }\n        return { action: 'select_char', charId: i };\n      }\n    }\n\n    // Confirm button\n    if (y >= h - 58 && y <= h - 16 && x >= 20 && x <= w - 20) {\n      this.goTo(NAV_SCREENS.MAP);\n      return { action: 'back' };\n    }\n    return null;\n  }\n\n  // --- RESULT ---\n  showResult(won, score, stars, level) {\n    this.resultWon = won;\n    this.resultScore = score;\n    this.resultStars = stars;\n    this.resultLevel = level;\n    this.resultCoins = 0;\n    if (won && stars > 0) {\n      this.resultCoins = this.coinSystem.awardStars(stars);\n      this.dataManager.setLevelStars(level, stars);\n    }\n    this.goTo(NAV_SCREENS.RESULT);\n  }\n\n  _renderResult(ctx, w, h) {\n    // Dim background\n    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n    ctx.fillRect(0, 0, w, h);\n\n    const pw = Math.min(320, w - 40);\n    const ph = 330;\n    const px = (w - pw) / 2;\n    const py = (h - ph) / 2;\n\n    // Panel\n    ctx.fillStyle = '#FFF8E7';\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.fill();\n    ctx.strokeStyle = '#FFB800';\n    ctx.lineWidth = 3;\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.stroke();\n\n    ctx.textAlign = 'center';\n\n    // Title\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 24px sans-serif';\n    ctx.fillText(this.resultWon ? '🎉 恭喜过关！' : '😢 挑战失败', w / 2, py + 45);\n\n    // Level number\n    ctx.font = '14px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText(`第 ${this.resultLevel} 关`, w / 2, py + 68);\n\n    // Score\n    ctx.font = 'bold 36px sans-serif';\n    ctx.fillStyle = '#FFB800';\n    ctx.fillText(this.resultScore, w / 2, py + 110);\n    ctx.font = '14px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText('得分', w / 2, py + 130);\n\n    // Stars\n    if (this.resultWon) {\n      for (let i = 0; i < 3; i++) {\n        ctx.font = '30px sans-serif';\n        ctx.fillText(i < this.resultStars ? '⭐' : '☆', w / 2 - 40 + i * 40, py + 172);\n      }\n    }\n\n    // Coins earned\n    if (this.resultCoins > 0) {\n      ctx.fillStyle = '#FFB800';\n      ctx.font = 'bold 18px sans-serif';\n      ctx.fillText(`+${this.resultCoins} 🪙`, w / 2, py + 205);\n      ctx.fillStyle = '#8D6E63';\n      ctx.font = '12px sans-serif';\n      ctx.fillText(`余额: ${this.dataManager.coins} 🪙`, w / 2, py + 224);\n    }\n\n    // Buttons\n    const btnW = 120, btnH = 42;\n    const btnY = py + ph - 65;\n\n    if (this.resultWon) {\n      // Next level\n      ctx.fillStyle = '#6BCB77';\n      this._roundRect(ctx, w / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText('下一关', w / 2 - btnW / 2 - 10, btnY + 27);\n    } else {\n      // Retry\n      ctx.fillStyle = '#FF9A3C';\n      this._roundRect(ctx, w / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 16px sans-serif';\n      ctx.fillText('重试', w / 2 - btnW / 2 - 10, btnY + 27);\n    }\n\n    // Map button\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, w / 2 + 10, btnY, btnW, btnH, btnH / 2);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.fillText('🗺️ 地图', w / 2 + btnW / 2 + 10, btnY + 27);\n  }\n\n  _handleResultClick(x, y, w, h) {\n    const pw = Math.min(320, w - 40);\n    const ph = 330;\n    const px = (w - pw) / 2;\n    const py = (h - ph) / 2;\n    const btnW = 120, btnH = 42;\n    const btnY = py + ph - 65;\n\n    // Next / Retry button\n    if (x >= w / 2 - btnW - 10 && x <= w / 2 - 10 && y >= btnY && y <= btnY + btnH) {\n      if (this.resultWon) {\n        this.game.nextLevel();\n      } else {\n        this.game.retry();\n      }\n      this.characterMgr.applySkill(\n        this.dataManager.selectedCharacter,\n        this.game, 'level_start', null,\n      );\n      this.goTo(NAV_SCREENS.GAME);\n      return { action: this.resultWon ? 'next' : 'retry' };\n    }\n\n    // Map button\n    if (x >= w / 2 + 10 && x <= w / 2 + 10 + btnW && y >= btnY && y <= btnY + btnH) {\n      this.goTo(NAV_SCREENS.MAP);\n      return { action: 'map' };\n    }\n    return null;\n  }\n\n  // --- DAILY ---\n  _handleDailyClick(x, y, w, h) {\n    const result = this.game.dailySystem.handleClick(x, y, w, h);\n    if (!result) return null;\n    if (result.action === 'back') {\n      this.goTo(NAV_SCREENS.MAP);\n    } else if (result.action === 'play_challenge') {\n      this._startLevel(result.level);\n    }\n    return result;\n  }\n\n  // --- SOCIAL ---\n  _handleSocialClick(x, y, w, h) {\n    const result = this.game.socialSystem.handleClick(x, y, w, h);\n    if (!result) return null;\n    if (result.action === 'back') {\n      this.goTo(NAV_SCREENS.MAP);\n    } else if (result.action === 'pk') {\n      const pk = this.game.socialSystem.startPK(result.friendId);\n      if (pk) {\n        // Simulate PK result\n        const myScore = Math.floor(Math.random() * 5000) + 1000;\n        const theirScore = Math.floor(Math.random() * 5000) + 1000;\n        const pkResult = this.game.socialSystem.resolvePK(result.friendId, myScore, theirScore);\n        return { action: 'pk_result', ...pkResult, myScore, theirScore };\n      }\n    }\n    return result;\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Navigation, NAV_SCREENS };\n","numLines":547,"startLine":1,"totalLines":547}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_beb02c3562f54be78b7d3316","type":"tool_result","content":"1\t// DailySystem.js — Daily login rewards, daily tasks, daily challenge\n2\t\n3\tclass DailySystem {\n4\t  constructor(dataManager, coinSystem) {\n5\t    this.dm = dataManager;\n6\t    this.cs = coinSystem;\n7\t    this.LOGIN_REWARDS = [10, 20, 40, 80, 150, 300, 500];\n8\t    this.TASK_TEMPLATES = [\n9\t      { id: 'clear_ice', name: '消除冰块达人', desc: '消除 {n} 个冰块', type: 'clear_obstacle', subType: 1, targets: [5, 8, 10] },\n10\t      { id: 'clear_chain', name: '破链专家', desc: '消除 {n} 个锁链', type: 'clear_obstacle', subType: 2, targets: [4, 6, 8] },\n11\t      { id: 'score_high', name: '高分挑战', desc: '单局获得 {n} 分', type: 'score', targets: [2000, 3000, 4000] },\n12\t      { id: 'chain_3', name: '连锁之王', desc: '达成 {n} 次连锁', type: 'chain', targets: [3, 5, 8] },\n13\t      { id: 'play_levels', name: '闯关达人', desc: '完成 {n} 关', type: 'complete_levels', targets: [2, 3, 5] },\n14\t      { id: 'star_3', name: '完美三星', desc: '获得 {n} 次三星', type: 'star3', targets: [1, 2, 3] },\n15\t      { id: 'use_special', name: '特效大师', desc: '使用 {n} 次特殊方块', type: 'special', targets: [3, 5, 8] },\n16\t      { id: 'collect_color', name: '色彩收集者', desc: '收集 {n} 个同色方块', type: 'collect_single', targets: [20, 30, 40] },\n17\t    ];\n18\t    this._initDaily();\n19\t  }\n20\t\n21\t  _initDaily() {\n22\t    if (!this.dm.data.daily) {\n23\t      this.dm.data.daily = {\n24\t        loginDay: 0,\n25\t        lastLoginDate: null,\n26\t        todayClaimed: false,\n27\t        tasks: [],\n28\t        challengeLevel: -1,\n29\t        challengeCompleted: false,\n30\t        taskProgress: {},\n31\t        weekStart: null,\n32\t      };\n33\t      this.dm.save();\n34\t    }\n35\t    this.daily = this.dm.data.daily;\n36\t  }\n37\t\n38\t  _todayStr() {\n39\t    return new Date().toISOString().slice(0, 10);\n40\t  }\n41\t\n42\t  _isSameDay(d1, d2) {\n43\t    if (!d1 || !d2) return false;\n44\t    return d1.slice(0, 10) === d2.slice(0, 10);\n45\t  }\n46\t\n47\t  checkNewDay() {\n48\t    const today = this._todayStr();\n49\t    if (!this._isSameDay(this.daily.lastLoginDate, today)) {\n50\t      const lastDate = this.daily.lastLoginDate ? new Date(this.daily.lastLoginDate) : null;\n51\t      const todayDate = new Date(today);\n52\t      const diffDays = lastDate ? Math.floor((todayDate - lastDate) / 86400000) : 99;\n53\t\n54\t      if (diffDays === 1) {\n55\t        this.daily.loginDay = Math.min(this.daily.loginDay + 1, 6);\n56\t      } else if (diffDays > 1) {\n57\t        this.daily.loginDay = 0;\n58\t      }\n59\t\n60\t      this.daily.todayClaimed = false;\n61\t      this.daily.lastLoginDate = today;\n62\t      this.daily.challengeCompleted = false;\n63\t      this._generateTasks();\n64\t      this._generateChallenge();\n65\t      this.dm.save();\n66\t    }\n67\t  }\n68\t\n69\t  claimLoginReward() {\n70\t    if (this.daily.todayClaimed) return 0;\n71\t    this.daily.todayClaimed = true;\n72\t    const reward = this.LOGIN_REWARDS[this.daily.loginDay] || 10;\n73\t    this.dm.addCoins(reward);\n74\t    this.dm.save();\n75\t    return reward;\n76\t  }\n77\t\n78\t  getLoginDay() { return this.daily.loginDay; }\n79\t  getLoginReward() { return this.LOGIN_REWARDS[this.daily.loginDay] || 10; }\n80\t  isLoginClaimed() { return this.daily.todayClaimed; }\n81\t\n82\t  _generateTasks() {\n83\t    const shuffled = [...this.TASK_TEMPLATES].sort(() => Math.random() - 0.5);\n84\t    const selected = shuffled.slice(0, 3);\n85\t    this.daily.tasks = selected.map((t, i) => {\n86\t      const diff = Math.min(i, t.targets.length - 1);\n87\t      return {\n88\t        id: t.id + '_' + i,\n89\t        templateId: t.id,\n90\t        name: t.name,\n91\t        desc: t.desc.replace('{n}', t.targets[diff]),\n92\t        type: t.type,\n93\t        subType: t.subType || 0,\n94\t        target: t.targets[diff],\n95\t        reward: [20, 50, 100][i],\n96\t        progress: 0,\n97\t        completed: false,\n98\t        claimed: false,\n99\t      };\n100\t    });\n101\t    this.daily.taskProgress = {};\n102\t    this.dm.save();\n103\t  }\n104\t\n105\t  getTasks() { return this.daily.tasks || []; }\n106\t\n107\t  reportEvent(eventType, value) {\n108\t    for (const task of this.daily.tasks) {\n109\t      if (task.completed) continue;\n110\t      if (task.type === eventType) {\n111\t        task.progress = Math.min(task.progress + (value || 1), task.target);\n112\t        if (task.progress >= task.target) task.completed = true;\n113\t      }\n114\t      if (task.type === 'clear_obstacle' && eventType === 'clear_obstacle') {\n115\t        if (task.subType === 0 || task.subType === value) {\n116\t          task.progress = Math.min(task.progress + 1, task.target);\n117\t          if (task.progress >= task.target) task.completed = true;\n118\t        }\n119\t      }\n120\t    }\n121\t    this.dm.save();\n122\t  }\n123\t\n124\t  claimTaskReward(taskId) {\n125\t    const task = this.daily.tasks.find(t => t.id === taskId);\n126\t    if (!task || !task.completed || task.claimed) return 0;\n127\t    task.claimed = true;\n128\t    this.dm.addCoins(task.reward);\n129\t    this.dm.save();\n130\t    return task.reward;\n131\t  }\n132\t\n133\t  _generateChallenge() {\n134\t    const dayOfWeek = new Date().getDay();\n135\t    const seed = Math.floor(Date.now() / 86400000);\n136\t    const levelPool = [];\n137\t    for (let i = 5; i < 50; i++) levelPool.push(i);\n138\t    const idx = (seed * 7 + dayOfWeek * 13) % levelPool.length;\n139\t    this.daily.challengeLevel = levelPool[idx];\n140\t    this.daily.challengeCompleted = false;\n141\t    this.dm.save();\n142\t  }\n143\t\n144\t  getChallengeLevel() { return this.daily.challengeLevel; }\n145\t  isChallengeDone() { return this.daily.challengeCompleted; }\n146\t  completeChallenge() {\n147\t    if (this.daily.challengeCompleted) return 0;\n148\t    this.daily.challengeCompleted = true;\n149\t    this.dm.addCoins(50);\n150\t    this.dm.save();\n151\t    return 50;\n152\t  }\n153\t\n154\t  render(ctx, screenW, screenH) {\n155\t    this.checkNewDay();\n156\t    const grad = ctx.createLinearGradient(0, 0, 0, screenH);\n157\t    grad.addColorStop(0, '#FFF8E7');\n158\t    grad.addColorStop(0.5, '#E8F5E9');\n159\t    grad.addColorStop(1, '#E3F2FD');\n160\t    ctx.fillStyle = grad;\n161\t    ctx.fillRect(0, 0, screenW, screenH);\n162\t\n163\t    // Title bar\n164\t    ctx.fillStyle = '#FF9A3C';\n165\t    this._roundRect(ctx, 10, 8, screenW - 20, 48, 12);\n166\t    ctx.fill();\n167\t    ctx.fillStyle = '#FFF';\n168\t    ctx.font = 'bold 20px sans-serif';\n169\t    ctx.textAlign = 'center';\n170\t    ctx.fillText('📅 每日任务', screenW / 2, 40);\n171\t\n172\t    // Login reward section\n173\t    const loginY = 70;\n174\t    ctx.fillStyle = '#5D4037';\n175\t    ctx.font = 'bold 16px sans-serif';\n176\t    ctx.textAlign = 'center';\n177\t    ctx.fillText(`连续登录第 ${this.daily.loginDay + 1} 天`, screenW / 2, loginY);\n178\t\n179\t    // 7-day login boxes\n180\t    const boxSize = Math.min(40, (screenW - 60) / 7);\n181\t    const boxStartX = (screenW - boxSize * 7 - 6 * 4) / 2;\n182\t    for (let i = 0; i < 7; i++) {\n183\t      const bx = boxStartX + i * (boxSize + 4);\n184\t      const by = loginY + 10;\n185\t      const isCurrent = i === this.daily.loginDay;\n186\t      const isPast = i < this.daily.loginDay;\n187\t\n188\t      ctx.fillStyle = isCurrent ? '#FFB800' : isPast ? '#6BCB77' : '#E8E0D8';\n189\t      this._roundRect(ctx, bx, by, boxSize, boxSize + 8, 6);\n190\t      ctx.fill();\n191\t\n192\t      ctx.fillStyle = isPast || isCurrent ? '#FFF' : '#A09888';\n193\t      ctx.font = 'bold 11px sans-serif';\n194\t      ctx.fillText(`D${i + 1}`, bx + boxSize / 2, by + 14);\n195\t      ctx.font = '10px sans-serif';\n196\t      ctx.fillText(`${this.LOGIN_REWARDS[i]}🪙`, bx + boxSize / 2, by + 30);\n197\t\n198\t      if (isCurrent && !this.daily.todayClaimed) {\n199\t        ctx.fillStyle = '#FF4D4D';\n200\t        ctx.font = 'bold 10px sans-serif';\n201\t        ctx.fillText('领取', bx + boxSize / 2, by + boxSize + 2);\n202\t      }\n203\t    }\n204\t\n205\t    // Claim button\n206\t    const claimBtnY = loginY + boxSize + 30;\n207\t    if (!this.daily.todayClaimed) {\n208\t      const pulse = 1 + Math.sin(Date.now() / 300) * 0.05;\n209\t      ctx.save();\n210\t      ctx.translate(screenW / 2, claimBtnY + 16);\n211\t      ctx.scale(pulse, pulse);\n212\t      ctx.translate(-screenW / 2, -(claimBtnY + 16));\n213\t      ctx.fillStyle = '#FF4D4D';\n214\t      this._roundRect(ctx, screenW / 2 - 70, claimBtnY, 140, 32, 16);\n215\t      ctx.fill();\n216\t      ctx.fillStyle = '#FFF';\n217\t      ctx.font = 'bold 14px sans-serif';\n218\t      ctx.fillText(`领取 ${this.getLoginReward()}🪙`, screenW / 2, claimBtnY + 22);\n219\t      ctx.restore();\n220\t    } else {\n221\t      ctx.fillStyle = '#8D6E63';\n222\t      ctx.font = '14px sans-serif';\n223\t      ctx.fillText('今日已领取 ✓', screenW / 2, claimBtnY + 20);\n224\t    }\n225\t\n226\t    // Daily tasks\n227\t    const taskStartY = claimBtnY + 50;\n228\t    ctx.fillStyle = '#5D4037';\n229\t    ctx.font = 'bold 16px sans-serif';\n230\t    ctx.fillText('今日任务', screenW / 2, taskStartY);\n231\t\n232\t    const tasks = this.getTasks();\n233\t    const taskH = 58;\n234\t    for (let i = 0; i < tasks.length; i++) {\n235\t      const t = tasks[i];\n236\t      const ty = taskStartY + 14 + i * (taskH + 6);\n237\t      const tw = screenW - 40;\n238\t      const tx = 20;\n239\t\n240\t      ctx.fillStyle = t.claimed ? '#F5F5F5' : '#FFFFFFEE';\n241\t      this._roundRect(ctx, tx, ty, tw, taskH, 10);\n242\t      ctx.fill();\n243\t\n244\t      if (t.completed && !t.claimed) {\n245\t        ctx.strokeStyle = '#FFB800';\n246\t        ctx.lineWidth = 2;\n247\t        this._roundRect(ctx, tx, ty, tw, taskH, 10);\n248\t        ctx.stroke();\n249\t      }\n250\t\n251\t      ctx.textAlign = 'left';\n252\t      ctx.fillStyle = t.claimed ? '#B0A898' : '#5D4037';\n253\t      ctx.font = 'bold 13px sans-serif';\n254\t      ctx.fillText(t.name, tx + 12, ty + 20);\n255\t\n256\t      ctx.font = '11px sans-serif';\n257\t      ctx.fillStyle = '#8D6E63';\n258\t      ctx.fillText(t.desc, tx + 12, ty + 36);\n259\t\n260\t      // Progress bar\n261\t      const pbX = tx + 12;\n262\t      const pbY = ty + 42;\n263\t      const pbW = tw - 100;\n264\t      const pbH = 8;\n265\t      ctx.fillStyle = '#E8E0D8';\n266\t      this._roundRect(ctx, pbX, pbY, pbW, pbH, 4);\n267\t      ctx.fill();\n268\t      const progress = Math.min(t.progress / t.target, 1);\n269\t      ctx.fillStyle = t.completed ? '#6BCB77' : '#4DA6FF';\n270\t      this._roundRect(ctx, pbX, pbY, Math.max(pbW * progress, 4), pbH, 4);\n271\t      ctx.fill();\n272\t\n273\t      ctx.textAlign = 'center';\n274\t      ctx.fillStyle = '#8D6E63';\n275\t      ctx.font = '10px sans-serif';\n276\t      ctx.fillText(`${Math.min(t.progress, t.target)}/${t.target}`, pbX + pbW / 2, pbY + 7);\n277\t\n278\t      // Reward / claim button\n279\t      const rbX = tx + tw - 80;\n280\t      if (t.completed && !t.claimed) {\n281\t        ctx.fillStyle = '#FFB800';\n282\t        this._roundRect(ctx, rbX, ty + 10, 68, 28, 14);\n283\t        ctx.fill();\n284\t        ctx.fillStyle = '#FFF';\n285\t        ctx.font = 'bold 12px sans-serif';\n286\t        ctx.fillText(`领${t.reward}🪙`, rbX + 34, ty + 29);\n287\t      } else if (t.claimed) {\n288\t        ctx.fillStyle = '#B0A898';\n289\t        ctx.font = '12px sans-serif';\n290\t        ctx.fillText('已领 ✓', rbX + 34, ty + 28);\n291\t      } else {\n292\t        ctx.fillStyle = '#8D6E63';\n293\t        ctx.font = 'bold 12px sans-serif';\n294\t        ctx.fillText(`${t.reward}🪙`, rbX + 34, ty + 28);\n295\t      }\n296\t    }\n297\t\n298\t    // Daily challenge\n299\t    const chalY = taskStartY + 14 + tasks.length * (taskH + 6) + 10;\n300\t    ctx.textAlign = 'center';\n301\t    ctx.fillStyle = '#5D4037';\n302\t    ctx.font = 'bold 16px sans-serif';\n303\t    ctx.fillText('🏆 每日挑战', screenW / 2, chalY);\n304\t\n305\t    const chalBoxY = chalY + 10;\n306\t    ctx.fillStyle = '#FFF8E7';\n307\t    this._roundRect(ctx, 20, chalBoxY, screenW - 40, 50, 10);\n308\t    ctx.fill();\n309\t    ctx.strokeStyle = '#FF9A3C';\n310\t    ctx.lineWidth = 2;\n311\t    this._roundRect(ctx, 20, chalBoxY, screenW - 40, 50, 10);\n312\t    ctx.stroke();\n313\t\n314\t    ctx.fillStyle = '#5D4037';\n315\t    ctx.font = 'bold 13px sans-serif';\n316\t    ctx.fillText(`挑战关卡 ${this.daily.challengeLevel + 1}`, screenW / 2, chalBoxY + 20);\n317\t    ctx.font = '11px sans-serif';\n318\t    ctx.fillStyle = '#8D6E63';\n319\t    ctx.fillText('完成获得 50🪙 + 荣誉', screenW / 2, chalBoxY + 38);\n320\t\n321\t    if (this.daily.challengeCompleted) {\n322\t      ctx.fillStyle = '#6BCB77';\n323\t      ctx.font = 'bold 12px sans-serif';\n324\t      ctx.fillText('已完成 ✓', screenW / 2, chalBoxY + 38);\n325\t    }\n326\t\n327\t    // Back button\n328\t    ctx.fillStyle = '#8D6E63';\n329\t    this._roundRect(ctx, 20, screenH - 50, screenW - 40, 38, 19);\n330\t    ctx.fill();\n331\t    ctx.fillStyle = '#FFF';\n332\t    ctx.font = 'bold 14px sans-serif';\n333\t    ctx.fillText('返回地图', screenW / 2, screenH - 27);\n334\t  }\n335\t\n336\t  handleClick(x, y, screenW, screenH) {\n337\t    this.checkNewDay();\n338\t\n339\t    // Login claim button\n340\t    const claimBtnY = 70 + 40 + 30;\n341\t    if (!this.daily.todayClaimed) {\n342\t      if (x >= screenW / 2 - 70 && x <= screenW / 2 + 70 && y >= claimBtnY && y <= claimBtnY + 32) {\n343\t        const reward = this.claimLoginReward();\n344\t        if (reward > 0) return { action: 'claim_login', reward };\n345\t      }\n346\t    }\n347\t\n348\t    // Task claim buttons\n349\t    const tasks = this.getTasks();\n350\t    const taskStartY = claimBtnY + 50;\n351\t    const taskH = 58;\n352\t    for (let i = 0; i < tasks.length; i++) {\n353\t      const t = tasks[i];\n354\t      if (t.completed && !t.claimed) {\n355\t        const ty = taskStartY + 14 + i * (taskH + 6);\n356\t        const rbX = screenW - 40 - 80 + 20;\n357\t        if (x >= rbX && x <= rbX + 68 && y >= ty + 10 && y <= ty + 38) {\n358\t          const reward = this.claimTaskReward(t.id);\n359\t          if (reward > 0) return { action: 'claim_task', taskId: t.id, reward };\n360\t        }\n361\t      }\n362\t    }\n363\t\n364\t    // Challenge click\n365\t    const chalY = taskStartY + 14 + tasks.length * (taskH + 6) + 10;\n366\t    const chalBoxY = chalY + 10;\n367\t    if (x >= 20 && x <= screenW - 20 && y >= chalBoxY && y <= chalBoxY + 50) {\n368\t      if (!this.daily.challengeCompleted) {\n369\t        return { action: 'play_challenge', level: this.daily.challengeLevel };\n370\t      }\n371\t    }\n372\t\n373\t    // Back button\n374\t    if (y >= screenH - 50 && y <= screenH - 12 && x >= 20 && x <= screenW - 20) {\n375\t      return { action: 'back' };\n376\t    }\n377\t\n378\t    return null;\n379\t  }\n380\t\n381\t  _roundRect(ctx, x, y, w, h, r) {\n382\t    ctx.beginPath();\n383\t    ctx.moveTo(x + r, y);\n384\t    ctx.lineTo(x + w - r, y);\n385\t    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n386\t    ctx.lineTo(x + w, y + h - r);\n387\t    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n388\t    ctx.lineTo(x + r, y + h);\n389\t    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n390\t    ctx.lineTo(x, y + r);\n391\t    ctx.quadraticCurveTo(x, y, x + r, y);\n392\t    ctx.closePath();\n393\t  }\n394\t}\n395\t\n396\tif (typeof module !== 'undefined') module.exports = { DailySystem };\n397\t"}]},"parent_tool_use_id":null,"session_id":"e7014494-9372-468d-b98b-69448d1a0f88","uuid":"cc541815-cd3a-4296-ba71-74cd14bc7491","timestamp":"2026-05-22T22:06:37.136Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\douyin-match3\\src\\js\\DailySystem.js","content":"// DailySystem.js — Daily login rewards, daily tasks, daily challenge\n\nclass DailySystem {\n  constructor(dataManager, coinSystem) {\n    this.dm = dataManager;\n    this.cs = coinSystem;\n    this.LOGIN_REWARDS = [10, 20, 40, 80, 150, 300, 500];\n    this.TASK_TEMPLATES = [\n      { id: 'clear_ice', name: '消除冰块达人', desc: '消除 {n} 个冰块', type: 'clear_obstacle', subType: 1, targets: [5, 8, 10] },\n      { id: 'clear_chain', name: '破链专家', desc: '消除 {n} 个锁链', type: 'clear_obstacle', subType: 2, targets: [4, 6, 8] },\n      { id: 'score_high', name: '高分挑战', desc: '单局获得 {n} 分', type: 'score', targets: [2000, 3000, 4000] },\n      { id: 'chain_3', name: '连锁之王', desc: '达成 {n} 次连锁', type: 'chain', targets: [3, 5, 8] },\n      { id: 'play_levels', name: '闯关达人', desc: '完成 {n} 关', type: 'complete_levels', targets: [2, 3, 5] },\n      { id: 'star_3', name: '完美三星', desc: '获得 {n} 次三星', type: 'star3', targets: [1, 2, 3] },\n      { id: 'use_special', name: '特效大师', desc: '使用 {n} 次特殊方块', type: 'special', targets: [3, 5, 8] },\n      { id: 'collect_color', name: '色彩收集者', desc: '收集 {n} 个同色方块', type: 'collect_single', targets: [20, 30, 40] },\n    ];\n    this._initDaily();\n  }\n\n  _initDaily() {\n    if (!this.dm.data.daily) {\n      this.dm.data.daily = {\n        loginDay: 0,\n        lastLoginDate: null,\n        todayClaimed: false,\n        tasks: [],\n        challengeLevel: -1,\n        challengeCompleted: false,\n        taskProgress: {},\n        weekStart: null,\n      };\n      this.dm.save();\n    }\n    this.daily = this.dm.data.daily;\n  }\n\n  _todayStr() {\n    return new Date().toISOString().slice(0, 10);\n  }\n\n  _isSameDay(d1, d2) {\n    if (!d1 || !d2) return false;\n    return d1.slice(0, 10) === d2.slice(0, 10);\n  }\n\n  checkNewDay() {\n    const today = this._todayStr();\n    if (!this._isSameDay(this.daily.lastLoginDate, today)) {\n      const lastDate = this.daily.lastLoginDate ? new Date(this.daily.lastLoginDate) : null;\n      const todayDate = new Date(today);\n      const diffDays = lastDate ? Math.floor((todayDate - lastDate) / 86400000) : 99;\n\n      if (diffDays === 1) {\n        this.daily.loginDay = Math.min(this.daily.loginDay + 1, 6);\n      } else if (diffDays > 1) {\n        this.daily.loginDay = 0;\n      }\n\n      this.daily.todayClaimed = false;\n      this.daily.lastLoginDate = today;\n      this.daily.challengeCompleted = false;\n      this._generateTasks();\n      this._generateChallenge();\n      this.dm.save();\n    }\n  }\n\n  claimLoginReward() {\n    if (this.daily.todayClaimed) return 0;\n    this.daily.todayClaimed = true;\n    const reward = this.LOGIN_REWARDS[this.daily.loginDay] || 10;\n    this.dm.addCoins(reward);\n    this.dm.save();\n    return reward;\n  }\n\n  getLoginDay() { return this.daily.loginDay; }\n  getLoginReward() { return this.LOGIN_REWARDS[this.daily.loginDay] || 10; }\n  isLoginClaimed() { return this.daily.todayClaimed; }\n\n  _generateTasks() {\n    const shuffled = [...this.TASK_TEMPLATES].sort(() => Math.random() - 0.5);\n    const selected = shuffled.slice(0, 3);\n    this.daily.tasks = selected.map((t, i) => {\n      const diff = Math.min(i, t.targets.length - 1);\n      return {\n        id: t.id + '_' + i,\n        templateId: t.id,\n        name: t.name,\n        desc: t.desc.replace('{n}', t.targets[diff]),\n        type: t.type,\n        subType: t.subType || 0,\n        target: t.targets[diff],\n        reward: [20, 50, 100][i],\n        progress: 0,\n        completed: false,\n        claimed: false,\n      };\n    });\n    this.daily.taskProgress = {};\n    this.dm.save();\n  }\n\n  getTasks() { return this.daily.tasks || []; }\n\n  reportEvent(eventType, value) {\n    for (const task of this.daily.tasks) {\n      if (task.completed) continue;\n      if (task.type === eventType) {\n        task.progress = Math.min(task.progress + (value || 1), task.target);\n        if (task.progress >= task.target) task.completed = true;\n      }\n      if (task.type === 'clear_obstacle' && eventType === 'clear_obstacle') {\n        if (task.subType === 0 || task.subType === value) {\n          task.progress = Math.min(task.progress + 1, task.target);\n          if (task.progress >= task.target) task.completed = true;\n        }\n      }\n    }\n    this.dm.save();\n  }\n\n  claimTaskReward(taskId) {\n    const task = this.daily.tasks.find(t => t.id === taskId);\n    if (!task || !task.completed || task.claimed) return 0;\n    task.claimed = true;\n    this.dm.addCoins(task.reward);\n    this.dm.save();\n    return task.reward;\n  }\n\n  _generateChallenge() {\n    const dayOfWeek = new Date().getDay();\n    const seed = Math.floor(Date.now() / 86400000);\n    const levelPool = [];\n    for (let i = 5; i < 50; i++) levelPool.push(i);\n    const idx = (seed * 7 + dayOfWeek * 13) % levelPool.length;\n    this.daily.challengeLevel = levelPool[idx];\n    this.daily.challengeCompleted = false;\n    this.dm.save();\n  }\n\n  getChallengeLevel() { return this.daily.challengeLevel; }\n  isChallengeDone() { return this.daily.challengeCompleted; }\n  completeChallenge() {\n    if (this.daily.challengeCompleted) return 0;\n    this.daily.challengeCompleted = true;\n    this.dm.addCoins(50);\n    this.dm.save();\n    return 50;\n  }\n\n  render(ctx, screenW, screenH) {\n    this.checkNewDay();\n    const grad = ctx.createLinearGradient(0, 0, 0, screenH);\n    grad.addColorStop(0, '#FFF8E7');\n    grad.addColorStop(0.5, '#E8F5E9');\n    grad.addColorStop(1, '#E3F2FD');\n    ctx.fillStyle = grad;\n    ctx.fillRect(0, 0, screenW, screenH);\n\n    // Title bar\n    ctx.fillStyle = '#FF9A3C';\n    this._roundRect(ctx, 10, 8, screenW - 20, 48, 12);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('📅 每日任务', screenW / 2, 40);\n\n    // Login reward section\n    const loginY = 70;\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 16px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(`连续登录第 ${this.daily.loginDay + 1} 天`, screenW / 2, loginY);\n\n    // 7-day login boxes\n    const boxSize = Math.min(40, (screenW - 60) / 7);\n    const boxStartX = (screenW - boxSize * 7 - 6 * 4) / 2;\n    for (let i = 0; i < 7; i++) {\n      const bx = boxStartX + i * (boxSize + 4);\n      const by = loginY + 10;\n      const isCurrent = i === this.daily.loginDay;\n      const isPast = i < this.daily.loginDay;\n\n      ctx.fillStyle = isCurrent ? '#FFB800' : isPast ? '#6BCB77' : '#E8E0D8';\n      this._roundRect(ctx, bx, by, boxSize, boxSize + 8, 6);\n      ctx.fill();\n\n      ctx.fillStyle = isPast || isCurrent ? '#FFF' : '#A09888';\n      ctx.font = 'bold 11px sans-serif';\n      ctx.fillText(`D${i + 1}`, bx + boxSize / 2, by + 14);\n      ctx.font = '10px sans-serif';\n      ctx.fillText(`${this.LOGIN_REWARDS[i]}🪙`, bx + boxSize / 2, by + 30);\n\n      if (isCurrent && !this.daily.todayClaimed) {\n        ctx.fillStyle = '#FF4D4D';\n        ctx.font = 'bold 10px sans-serif';\n        ctx.fillText('领取', bx + boxSize / 2, by + boxSize + 2);\n      }\n    }\n\n    // Claim button\n    const claimBtnY = loginY + boxSize + 30;\n    if (!this.daily.todayClaimed) {\n      const pulse = 1 + Math.sin(Date.now() / 300) * 0.05;\n      ctx.save();\n      ctx.translate(screenW / 2, claimBtnY + 16);\n      ctx.scale(pulse, pulse);\n      ctx.translate(-screenW / 2, -(claimBtnY + 16));\n      ctx.fillStyle = '#FF4D4D';\n      this._roundRect(ctx, screenW / 2 - 70, claimBtnY, 140, 32, 16);\n      ctx.fill();\n      ctx.fillStyle = '#FFF';\n      ctx.font = 'bold 14px sans-serif';\n      ctx.fillText(`领取 ${this.getLoginReward()}🪙`, screenW / 2, claimBtnY + 22);\n      ctx.restore();\n    } else {\n      ctx.fillStyle = '#8D6E63';\n      ctx.font = '14px sans-serif';\n      ctx.fillText('今日已领取 ✓', screenW / 2, claimBtnY + 20);\n    }\n\n    // Daily tasks\n    const taskStartY = claimBtnY + 50;\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 16px sans-serif';\n    ctx.fillText('今日任务', screenW / 2, taskStartY);\n\n    const tasks = this.getTasks();\n    const taskH = 58;\n    for (let i = 0; i < tasks.length; i++) {\n      const t = tasks[i];\n      const ty = taskStartY + 14 + i * (taskH + 6);\n      const tw = screenW - 40;\n      const tx = 20;\n\n      ctx.fillStyle = t.claimed ? '#F5F5F5' : '#FFFFFFEE';\n      this._roundRect(ctx, tx, ty, tw, taskH, 10);\n      ctx.fill();\n\n      if (t.completed && !t.claimed) {\n        ctx.strokeStyle = '#FFB800';\n        ctx.lineWidth = 2;\n        this._roundRect(ctx, tx, ty, tw, taskH, 10);\n        ctx.stroke();\n      }\n\n      ctx.textAlign = 'left';\n      ctx.fillStyle = t.claimed ? '#B0A898' : '#5D4037';\n      ctx.font = 'bold 13px sans-serif';\n      ctx.fillText(t.name, tx + 12, ty + 20);\n\n      ctx.font = '11px sans-serif';\n      ctx.fillStyle = '#8D6E63';\n      ctx.fillText(t.desc, tx + 12, ty + 36);\n\n      // Progress bar\n      const pbX = tx + 12;\n      const pbY = ty + 42;\n      const pbW = tw - 100;\n      const pbH = 8;\n      ctx.fillStyle = '#E8E0D8';\n      this._roundRect(ctx, pbX, pbY, pbW, pbH, 4);\n      ctx.fill();\n      const progress = Math.min(t.progress / t.target, 1);\n      ctx.fillStyle = t.completed ? '#6BCB77' : '#4DA6FF';\n      this._roundRect(ctx, pbX, pbY, Math.max(pbW * progress, 4), pbH, 4);\n      ctx.fill();\n\n      ctx.textAlign = 'center';\n      ctx.fillStyle = '#8D6E63';\n      ctx.font = '10px sans-serif';\n      ctx.fillText(`${Math.min(t.progress, t.target)}/${t.target}`, pbX + pbW / 2, pbY + 7);\n\n      // Reward / claim button\n      const rbX = tx + tw - 80;\n      if (t.completed && !t.claimed) {\n        ctx.fillStyle = '#FFB800';\n        this._roundRect(ctx, rbX, ty + 10, 68, 28, 14);\n        ctx.fill();\n        ctx.fillStyle = '#FFF';\n        ctx.font = 'bold 12px sans-serif';\n        ctx.fillText(`领${t.reward}🪙`, rbX + 34, ty + 29);\n      } else if (t.claimed) {\n        ctx.fillStyle = '#B0A898';\n        ctx.font = '12px sans-serif';\n        ctx.fillText('已领 ✓', rbX + 34, ty + 28);\n      } else {\n        ctx.fillStyle = '#8D6E63';\n        ctx.font = 'bold 12px sans-serif';\n        ctx.fillText(`${t.reward}🪙`, rbX + 34, ty + 28);\n      }\n    }\n\n    // Daily challenge\n    const chalY = taskStartY + 14 + tasks.length * (taskH + 6) + 10;\n    ctx.textAlign = 'center';\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 16px sans-serif';\n    ctx.fillText('🏆 每日挑战', screenW / 2, chalY);\n\n    const chalBoxY = chalY + 10;\n    ctx.fillStyle = '#FFF8E7';\n    this._roundRect(ctx, 20, chalBoxY, screenW - 40, 50, 10);\n    ctx.fill();\n    ctx.strokeStyle = '#FF9A3C';\n    ctx.lineWidth = 2;\n    this._roundRect(ctx, 20, chalBoxY, screenW - 40, 50, 10);\n    ctx.stroke();\n\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 13px sans-serif';\n    ctx.fillText(`挑战关卡 ${this.daily.challengeLevel + 1}`, screenW / 2, chalBoxY + 20);\n    ctx.font = '11px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText('完成获得 50🪙 + 荣誉', screenW / 2, chalBoxY + 38);\n\n    if (this.daily.challengeCompleted) {\n      ctx.fillStyle = '#6BCB77';\n      ctx.font = 'bold 12px sans-serif';\n      ctx.fillText('已完成 ✓', screenW / 2, chalBoxY + 38);\n    }\n\n    // Back button\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, 20, screenH - 50, screenW - 40, 38, 19);\n    ctx.fill();\n    ctx.fillStyle = '#FFF';\n    ctx.font = 'bold 14px sans-serif';\n    ctx.fillText('返回地图', screenW / 2, screenH - 27);\n  }\n\n  handleClick(x, y, screenW, screenH) {\n    this.checkNewDay();\n\n    // Login claim button\n    const claimBtnY = 70 + 40 + 30;\n    if (!this.daily.todayClaimed) {\n      if (x >= screenW / 2 - 70 && x <= screenW / 2 + 70 && y >= claimBtnY && y <= claimBtnY + 32) {\n        const reward = this.claimLoginReward();\n        if (reward > 0) return { action: 'claim_login', reward };\n      }\n    }\n\n    // Task claim buttons\n    const tasks = this.getTasks();\n    const taskStartY = claimBtnY + 50;\n    const taskH = 58;\n    for (let i = 0; i < tasks.length; i++) {\n      const t = tasks[i];\n      if (t.completed && !t.claimed) {\n        const ty = taskStartY + 14 + i * (taskH + 6);\n        const rbX = screenW - 40 - 80 + 20;\n        if (x >= rbX && x <= rbX + 68 && y >= ty + 10 && y <= ty + 38) {\n          const reward = this.claimTaskReward(t.id);\n          if (reward > 0) return { action: 'claim_task', taskId: t.id, reward };\n        }\n      }\n    }\n\n    // Challenge click\n    const chalY = taskStartY + 14 + tasks.length * (taskH + 6) + 10;\n    const chalBoxY = chalY + 10;\n    if (x >= 20 && x <= screenW - 20 && y >= chalBoxY && y <= chalBoxY + 50) {\n      if (!this.daily.challengeCompleted) {\n        return { action: 'play_challenge', level: this.daily.challengeLevel };\n      }\n    }\n\n    // Back button\n    if (y >= screenH - 50 && y <= screenH - 12 && x >= 20 && x <= screenW - 20) {\n      return { action: 'back' };\n    }\n\n    return null;\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { DailySystem };\n","numLines":397,"startLine":1,"totalLines":397}}}
