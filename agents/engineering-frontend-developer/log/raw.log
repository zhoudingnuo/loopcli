{"type":"assistant","message":{"id":"msg_202605230509287069df9261b64f52","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_05e64ca6a43d44a1be5f257f","name":"Write","input":{"file_path":"D:/game-projects/douyin-match3/src/js/Game.js","content":"// Game.js — Main game loop, state machine, ties all modules together\nconst { Board, BOARD_SIZE, SPECIAL_NONE, SPECIAL_RAINBOW, COLOR_MAP } = typeof require !== 'undefined' ? require('./Board.js') : {};\nconst { MatchEngine } = typeof require !== 'undefined' ? require('./MatchEngine.js') : {};\nconst { Renderer } = typeof require !== 'undefined' ? require('./Renderer.js') : {};\nconst { InputHandler } = typeof require !== 'undefined' ? require('./InputHandler.js') : {};\nconst { ScoreSystem, generateLevels } = typeof require !== 'undefined' ? require('./ScoreSystem.js') : {};\nconst { TweenManager, ParticleSystem } = typeof require !== 'undefined' ? require('./Animation.js') : {};\n\nconst STATES = {\n  MENU: 'menu',\n  IDLE: 'idle',\n  SWAPPING: 'swapping',\n  MATCHING: 'matching',\n  REMOVING: 'removing',\n  DROPPING: 'dropping',\n  RESULT: 'result',\n};\n\nclass Game {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.board = new Board();\n    this.matchEngine = new MatchEngine(this.board);\n    this.renderer = new Renderer(canvas);\n    this.input = new InputHandler(canvas, this.board);\n    this.scoreSystem = new ScoreSystem();\n    this.tweens = new TweenManager();\n    this.particles = new ParticleSystem();\n    this.levels = generateLevels();\n    this.currentLevel = 0;\n    this.state = STATES.MENU;\n    this.comboText = '';\n    this.comboTimer = 0;\n    this.lastTime = 0;\n    this.animationQueue = [];\n\n    this.renderer.particleSystem = this.particles;\n\n    this._setupInput();\n    this._setupScoreCallbacks();\n  }\n\n  _setupInput() {\n    this.input.onSwap = (r1, c1, r2, c2) => this._handleSwap(r1, c1, r2, c2);\n    this.input.onTap = (row, col) => this._handleTap(row, col);\n  }\n\n  _setupScoreCallbacks() {\n    this.scoreSystem.onLevelComplete = (score, stars) => {\n      this.state = STATES.RESULT;\n      this.resultData = { won: true, score, stars, level: this.currentLevel + 1 };\n    };\n    this.scoreSystem.onLevelFail = (score) => {\n      this.state = STATES.RESULT;\n      this.resultData = { won: false, score, stars: 0, level: this.currentLevel + 1 };\n    };\n  }\n\n  start() {\n    this._loadLevel(0);\n    this.state = STATES.IDLE;\n    this.lastTime = performance.now();\n    this._loop();\n  }\n\n  _loadLevel(idx) {\n    this.currentLevel = idx;\n    const config = this.levels[idx] || this.levels[0];\n    this.board.init();\n    this.scoreSystem.reset(idx + 1);\n    this.scoreSystem.configure(config);\n    this.input.updateLayout(\n      this.renderer.tileSize,\n      this.renderer.boardX,\n      this.renderer.boardY,\n    );\n    this.tweens.clear();\n    this.particles.particles = [];\n    this.renderer.floatingTexts = [];\n    this.comboText = '';\n    this.resultData = null;\n  }\n\n  _handleTap(row, col) {\n    if (this.state !== STATES.IDLE) return;\n    const tile = this.board.getTile(row, col);\n    if (!tile) return;\n\n    // Rainbow special: tap to activate\n    if (tile.special !== SPECIAL_NONE) {\n      // For now, rainbow on tap picks a random color\n      // In full game, this would be from the swapped tile's color\n      return;\n    }\n  }\n\n  _handleSwap(r1, c1, r2, c2) {\n    if (this.state !== STATES.IDLE) return;\n\n    // Check if any special tile combination\n    const tileA = this.board.getTile(r1, c1);\n    const tileB = this.board.getTile(r2, c2);\n\n    if (tileA && tileA.special === SPECIAL_RAINBOW) {\n      this._activateRainbow(r1, c1, tileB ? tileB.color : 0, r2, c2);\n      return;\n    }\n    if (tileB && tileB.special === SPECIAL_RAINBOW) {\n      this._activateRainbow(r2, c2, tileA ? tileA.color : 0, r1, c1);\n      return;\n    }\n\n    if (!this.matchEngine.isValidSwap(r1, c1, r2, c2)) return;\n    if (!this.scoreSystem.useMove()) return;\n\n    this.state = STATES.SWAPPING;\n    this.board.swap(r1, c1, r2, c2);\n\n    // Animate swap\n    this._animateSwap(r1, c1, r2, c2, () => {\n      this._processMatches();\n    });\n  }\n\n  _animateSwap(r1, c1, r2, c2, callback) {\n    const tileSize = this.renderer.tileSize;\n    const tileA = this.board.getTile(r2, c2); // After swap, tileA is at (r2,c2)\n    const tileB = this.board.getTile(r1, c1);\n\n    const dx = (c2 - c1) * tileSize;\n    const dy = (r2 - r1) * tileSize;\n\n    if (tileA) {\n      tileA.offsetX = -dx;\n      tileA.offsetY = -dy;\n      this.tweens.add(tileA, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n    }\n    if (tileB) {\n      tileB.offsetX = dx;\n      tileB.offsetY = dy;\n      this.tweens.add(tileB, { offsetX: 0, offsetY: 0 }, 0.15, 'easeOutQuad');\n    }\n\n    setTimeout(callback, 160);\n  }\n\n  _activateRainbow(rainbowRow, rainbowCol, targetColor, otherRow, otherCol) {\n    if (!this.scoreSystem.useMove()) return;\n    this.state = STATES.MATCHING;\n\n    // Remove the rainbow tile and the other tile\n    const toRemove = this.matchEngine.triggerRainbow(rainbowRow, rainbowCol, targetColor);\n    toRemove.push({ row: rainbowRow, col: rainbowCol });\n    if (this.board.getTile(otherRow, otherCol)) {\n      toRemove.push({ row: otherRow, col: otherCol });\n    }\n\n    this._removeAndCascade(toRemove, 10);\n  }\n\n  _processMatches() {\n    this.state = STATES.MATCHING;\n    const matches = this.board.findAllMatches();\n\n    if (matches.length === 0) {\n      this.state = STATES.IDLE;\n      this.scoreSystem.checkState();\n      return;\n    }\n\n    let chainCount = 0;\n    this._processChain(chainCount);\n  }\n\n  _processChain(chainCount) {\n    chainCount++;\n    const matches = this.board.findAllMatches();\n    if (matches.length === 0) {\n      // Check for special tiles to trigger\n      this.state = STATES.IDLE;\n\n      // Check deadlock\n      if (!this.board.hasValidMoves()) {\n        this.board.shuffle();\n      }\n\n      const result = this.scoreSystem.checkState();\n      if (result === 'playing') {\n        // All done for this move\n      }\n      return;\n    }\n\n    const lShapes = this.board.findLShapeMatches(matches);\n    const { removeCells, specials } = this.matchEngine._classifyMatches(matches, lShapes);\n\n    // Score\n    const multiplier = chainCount <= 1 ? 1 : chainCount === 2 ? 1.5 : chainCount === 3 ? 2.0 : 2.5;\n    const baseScore = removeCells.size * 10;\n    const points = Math.floor(baseScore * multiplier);\n    this.scoreSystem.addScore(points);\n\n    // Combo text\n    if (chainCount >= 4) { this.comboText = '超赞！！'; }\n    else if (chainCount === 3) { this.comboText = '太棒了！'; }\n    else if (chainCount === 2) { this.comboText = '不错！'; }\n    this.comboTimer = 0.8;\n\n    // Track collected colors\n    for (const key of removeCells) {\n      const [r, c] = key.split(',').map(Number);\n      const tile = this.board.getTile(r, c);\n      if (tile && tile.color >= 0) {\n        this.scoreSystem.addCollected(tile.color, 1);\n      }\n    }\n\n    // Create specials\n    const specialPositions = new Set(specials.map(s => `${s.row},${s.col}`));\n    for (const sp of specials) {\n      const tile = this.board.getTile(sp.row, sp.col);\n      if (tile) {\n        tile.special = sp.type;\n        tile.removing = false;\n      }\n    }\n\n    // Animate removal\n    this.state = STATES.REMOVING;\n    const toAnimate = [];\n    for (const key of removeCells) {\n      if (specialPositions.has(key)) continue;\n      const [r, c] = key.split(',').map(Number);\n      const tile = this.board.getTile(r, c);\n      if (tile) {\n        // Particle effect\n        const pos = this.renderer.getTileCenter(r, c);\n        const color = COLOR_MAP[tile.color];\n        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 8);\n\n        // Score float\n        this.renderer.addFloatingText(`+${points}`, pos.x, pos.y);\n\n        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n        toAnimate.push(tile);\n      }\n    }\n\n    setTimeout(() => {\n      // Actually remove tiles\n      for (const key of removeCells) {\n        if (specialPositions.has(key)) continue;\n        const [r, c] = key.split(',').map(Number);\n        this.board.clearCell(r, c);\n      }\n\n      // Trigger specials in removed cells\n      for (const sp of specials) {\n        this._triggerSpecialEffects(sp.row, sp.col, sp.type);\n      }\n\n      // Apply gravity\n      this.state = STATES.DROPPING;\n      const drops = this.board.applyGravity();\n\n      // Animate drops\n      for (const drop of drops) {\n        const tile = drop.tile;\n        const fromY = drop.fromRow * this.renderer.tileSize;\n        const toY = drop.toRow * this.renderer.tileSize;\n        tile.offsetY = fromY - toY;\n        this.tweens.add(tile, { offsetY: 0 }, 0.2 + drop.distance * 0.03, 'easeOutBounce');\n      }\n\n      setTimeout(() => {\n        this._processChain(chainCount);\n      }, 350);\n    }, 280);\n  }\n\n  _triggerSpecialEffects(row, col, type) {\n    const pos = this.renderer.getTileCenter(row, col);\n    const tile = this.board.getTile(row, col);\n    const color = tile ? COLOR_MAP[tile.color]?.hex : '#FFB800';\n\n    switch (type) {\n      case 1: // STRIPED_H\n      case 2: // STRIPED_V\n        this.particles.emitExplosion(pos.x, pos.y, color || '#FFB800', 20);\n        break;\n      case 3: // BOMB\n        this.particles.emitExplosion(pos.x, pos.y, '#FF9A3C', 30);\n        break;\n      case 4: // RAINBOW\n        for (let i = 0; i < 40; i++) {\n          this.particles.emitExplosion(pos.x, pos.y, '#FFB800', 2);\n        }\n        break;\n    }\n  }\n\n  _removeAndCascade(cells, scorePerCell) {\n    this.state = STATES.REMOVING;\n    const points = cells.length * scorePerCell;\n    this.scoreSystem.addScore(points);\n\n    for (const { row, col } of cells) {\n      const tile = this.board.getTile(row, col);\n      if (tile) {\n        const pos = this.renderer.getTileCenter(row, col);\n        const color = COLOR_MAP[tile.color];\n        if (color) this.particles.emitExplosion(pos.x, pos.y, color.hex, 6);\n        this.tweens.add(tile, { scale: 0, alpha: 0 }, 0.25, 'easeInQuad');\n      }\n    }\n\n    setTimeout(() => {\n      for (const { row, col } of cells) {\n        this.board.clearCell(row, col);\n      }\n      this.board.applyGravity();\n\n      this.state = STATES.IDLE;\n      // Check for more cascades\n      setTimeout(() => this._processMatches(), 200);\n    }, 300);\n  }\n\n  _loop() {\n    const now = performance.now();\n    const dt = Math.min((now - this.lastTime) / 1000, 0.05);\n    this.lastTime = now;\n\n    this.update(dt);\n    this.render();\n    requestAnimationFrame(() => this._loop());\n  }\n\n  update(dt) {\n    this.tweens.update(dt);\n    this.particles.update(dt);\n\n    if (this.comboTimer > 0) {\n      this.comboTimer -= dt;\n      if (this.comboTimer <= 0) this.comboText = '';\n    }\n\n    this.input.enabled = this.state === STATES.IDLE;\n  }\n\n  render() {\n    this.renderer.clear();\n    this.renderer.drawBackground();\n\n    // Draw tiles\n    for (let r = 0; r < this.board.size; r++) {\n      for (let c = 0; c < this.board.size; c++) {\n        const tile = this.board.getTile(r, c);\n        if (tile) this.renderer.drawTile(tile);\n      }\n    }\n\n    // Particles\n    this.particles.draw(this.renderer.ctx);\n\n    // Floating texts\n    this.renderer.updateAndDrawFloatingTexts(1 / 60);\n\n    // UI\n    this.renderer.drawUI(\n      this.scoreSystem.score,\n      this.scoreSystem.getRemainingMoves(),\n      this.scoreSystem.goalTarget,\n      this.scoreSystem.goalProgress,\n      this.currentLevel + 1,\n    );\n\n    // Combo text\n    if (this.comboText) {\n      this.renderer.drawComboText(this.comboText);\n    }\n\n    // Result screen\n    if (this.resultData) {\n      this.renderer.drawResultScreen(\n        this.resultData.won,\n        this.resultData.score,\n        this.resultData.stars,\n        this.resultData.level,\n      );\n    }\n  }\n\n  // Public methods for UI interaction\n  retry() {\n    this._loadLevel(this.currentLevel);\n    this.state = STATES.IDLE;\n  }\n\n  nextLevel() {\n    const next = this.currentLevel + 1;\n    if (next < this.levels.length) {\n      this._loadLevel(next);\n      this.state = STATES.IDLE;\n    } else {\n      this._loadLevel(0);\n      this.state = STATES.IDLE;\n    }\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Game, STATES };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"ef939699-9dac-4e19-a950-f991f68c1f56","uuid":"fbe5c04d-bf14-406b-9c4d-03f273c5561c"}
