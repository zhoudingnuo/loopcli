.min(this.maxZoom, this.targetZoom * (1 - delta * 0.001)));\n    this.zoom = this.targetZoom;\n\n    // Adjust position to zoom toward the cursor\n    const zoomRatio = this.zoom / oldZoom;\n    this.x = screenX - (screenX - this.x) * zoomRatio;\n    this.y = screenY - (screenY - this.y) * zoomRatio;\n  }\n\n  private setupInput(canvas: HTMLCanvasElement): void {\n    // Mouse drag for panning\n    canvas.addEventListener('mousedown', (e) => {\n      if (e.button === 0 || e.button === 1) { // left or middle button\n        this.isDragging = true;\n        this.dragStartX = e.clientX;\n        this.dragStartY = e.clientY;\n        this.camStartX = this.x;\n        this.camStartY = this.y;\n      }\n    });\n\n    canvas.addEventListener('mousemove', (e) => {\n      if (!this.isDragging) return;\n      this.x = this.camStartX + (e.clientX - this.dragStartX);\n      this.y = this.camStartY + (e.clientY - this.dragStartY);\n    });\n\n    canvas.addEventListener('mouseup', () => {\n      this.isDragging = false;\n    });\n\n    canvas.addEventListener('mouseleave', () => {\n      this.isDragging = false;\n    });\n\n    // Mouse wheel for zooming\n    canvas.addEventListener('wheel', (e) => {\n      e.preventDefault();\n      this.zoomAt(e.deltaY, e.offsetX, e.offsetY);\n    }, { passive: false });\n\n    // Touch support\n    let lastTouchDist = 0;\n    let lastTouchCenter = { x: 0, y: 0 };\n\n    canvas.addEventListener('touchstart', (e) => {\n      if (e.touches.length === 1) {\n        this.isDragging = true;\n        this.dragStartX = e.touches[0].clientX;\n        this.dragStartY = e.touches[0].clientY;\n        this.camStartX = this.x;\n        this.camStartY = this.y;\n      } else if (e.touches.length === 2) {\n        this.isDragging = false;\n        lastTouchDist = this.getTouchDistance(e.touches);\n        lastTouchCenter = this.getTouchCenter(e.touches);\n      }\n      e.preventDefault();\n    }, { passive: false });\n\n    canvas.addEventListener('touchmove', (e) => {\n      if (e.touches.length === 1 && this.isDragging) {\n        this.x = this.camStartX + (e.touches[0].clientX - this.dragStartX);\n        this.y = this.camStartY + (e.touches[0].clientY - this.dragStartY);\n      } else if (e.touches.length === 2) {\n        const dist = this.getTouchDistance(e.touches);\n        const center = this.getTouchCenter(e.touches);\n        const delta = lastTouchDist - dist;\n        this.zoomAt(delta * 2, center.x, center.y);\n        lastTouchDist = dist;\n      }\n      e.preventDefault();\n    }, { passive: false });\n\n    canvas.addEventListener('touchend', () => {\n      this.isDragging = false;\n    });\n  }\n\n  private getTouchDistance(touches: TouchList): number {\n    const dx = touches[0].clientX - touches[1].clientX;\n    const dy = touches[0].clientY - touches[1].clientY;\n    return Math.sqrt(dx * dx + dy * dy);\n  }\n\n  private getTouchCenter(touches: TouchList): { x: number; y: number } {\n    return {\n      x: (touches[0].clientX + touches[1].clientX) / 2,\n      y: (touches[0].clientY + touches[1].clientY) / 2,\n    };\n  }\n\n  // Check if the camera was dragged (for distinguishing click vs drag)\n  wasDragged(): boolean {\n    return this.isDragging && (\n      Math.abs(this.x - this.camStartX) > 3 ||\n      Math.abs(this.y - this.camStartY) > 3\n    );\n  }\n}\n","numLines":159,"startLine":1,"totalLines":159}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_8b3774ec7c1b4e5c9dbe0296","type":"tool_result","content":"1\t// GameState.ts — Immutable game state with save/load interface (v0.4.0)\n2\t\n3\timport { type CultivationState, createInitialCultivationState, migrateFromOldRealm } from './Cultivation';\n4\t\n5\texport interface Resources {\n6\t  [key: string]: number;\n7\t  spirit_stone: number;\n8\t  spirit_grass: number;\n9\t  spirit_energy: number;\n10\t  cultivation: number;\n11\t  pill_juling: number;\n12\t  pill_peiyuan: number;\n13\t  pill_ningqi: number;\n14\t  pill_zhuji: number;\n15\t  pill_jindanyin: number;\n16\t  pill_yuanyingguo: number;\n17\t  pill_huashenlu: number;\n18\t  pill_jiuzhuan: number;\n19\t  spirit_iron: number;\n20\t  spirit_wood: number;\n21\t  talisman_paper: number;\n22\t  monster_core: number;\n23\t  heaven_earth_liquid: number;\n24\t  immortal_stone: number;\n25\t  merit: number;\n26\t}\n27\t\n28\texport interface BuildingInstance {\n29\t  uid: string;\n30\t  buildingId: string;\n31\t  gridX: number;\n32\t  gridY: number;\n33\t  level: number;\n34\t  lastCollectTime: number;\n35\t  isProducing: boolean;\n36\t  progress: number;\n37\t}\n38\t\n39\texport interface RealmProgress {\n40\t  realmId: string;\n41\t  level: number;\n42\t  exp: number;\n43\t  expToNext: number;\n44\t}\n45\t\n46\texport interface AlchemySessionData {\n47\t  recipeId: string;\n48\t  startTime: number;\n49\t  progress: number;\n50\t  complete: boolean;\n51\t}\n52\t\n53\texport interface GameMap {\n54\t  regionId: string;\n55\t  width: number;\n56\t  height: number;\n57\t  terrain: number[];\n58\t  buildings: BuildingInstance[];\n59\t}\n60\t\n61\texport interface GameState {\n62\t  resources: Resources;\n63\t  realm: RealmProgress;\n64\t  cultivation: CultivationState;\n65\t  alchemySession: AlchemySessionData | null;\n66\t  maps: GameMap[];\n67\t  currentRegionIndex: number;\n68\t  totalPlaytime: number;\n69\t  lastSaveTime: number;\n70\t  lastOnlineTime: number;\n71\t  version: string;\n72\t  achievements: string[];\n73\t  ascensionCompleted: boolean;\n74\t  crossRegionLinks: CrossRegionLink[];\n75\t  totalCollected: Record<string, number>;\n76\t  savedConveyors: any[];\n77\t  savedPuppets: any[];\n78\t  savedTalismans: any[];\n79\t}\n80\t\n81\texport interface CrossRegionLink {\n82\t  id: string;\n83\t  fromRegionIndex: number;\n84\t  fromX: number;\n85\t  fromY: number;\n86\t  toRegionIndex: number;\n87\t  toX: number;\n88\t  toY: number;\n89\t  resource: string;\n90\t  amount: number;\n91\t  interval: number;\n92\t  lastTransfer: number;\n93\t}\n94\t\n95\texport interface SaveData {\n96\t  version: string;\n97\t  timestamp: number;\n98\t  playtime: number;\n99\t  gameState: GameState;\n100\t}\n101\t\n102\tconst SAVE_KEY = 'cultivation_factory_save';\n103\tconst CURRENT_VERSION = '1.0.0';\n104\t\n105\tfunction initialResources(): Resources {\n106\t  return {\n107\t    spirit_stone: 0,\n108\t    spirit_grass: 0,\n109\t    spirit_energy: 0,\n110\t    cultivation: 0,\n111\t    pill_juling: 0,\n112\t    pill_peiyuan: 0,\n113\t    pill_ningqi: 0,\n114\t    pill_zhuji: 0,\n115\t    pill_jindanyin: 0,\n116\t    pill_yuanyingguo: 0,\n117\t    pill_huashenlu: 0,\n118\t    pill_jiuzhuan: 0,\n119\t    spirit_iron: 0,\n120\t    spirit_wood: 0,\n121\t    talisman_paper: 0,\n122\t    monster_core: 0,\n123\t    heaven_earth_liquid: 0,\n124\t    immortal_stone: 0,\n125\t    merit: 0,\n126\t  };\n127\t}\n128\t\n129\tfunction initialRealm(): RealmProgress {\n130\t  return {\n131\t    realmId: 'liqi',\n132\t    level: 1,\n133\t    exp: 0,\n134\t    expToNext: 100,\n135\t  };\n136\t}\n137\t\n138\texport function createInitialState(): GameState {\n139\t  return {\n140\t    resources: initialResources(),\n141\t    realm: initialRealm(),\n142\t    cultivation: createInitialCultivationState(),\n143\t    alchemySession: null,\n144\t    maps: [],\n145\t    currentRegionIndex: 0,\n146\t    totalPlaytime: 0,\n147\t    lastSaveTime: Date.now(),\n148\t    lastOnlineTime: Date.now(),\n149\t    version: CURRENT_VERSION,\n150\t    achievements: [],\n151\t    ascensionCompleted: false,\n152\t    crossRegionLinks: [],\n153\t    totalCollected: {},\n154\t    savedConveyors: [],\n155\t    savedPuppets: [],\n156\t    savedTalismans: [],\n157\t  };\n158\t}\n159\t\n160\texport function cloneState(state: GameState): GameState {\n161\t  return JSON.parse(JSON.stringify(state));\n162\t}\n163\t\n164\texport function addResources(state: GameState, delta: Partial<Resources>): GameState {\n165\t  const next = cloneState(state);\n166\t  for (const key of Object.keys(delta) as (keyof Resources)[]) {\n167\t    const amount = delta[key] ?? 0;\n168\t    next.resources[key] = Math.max(0, next.resources[key] + amount);\n169\t    if (amount > 0) {\n170\t      next.totalCollected[key] = (next.totalCollected[key] ?? 0) + amount;\n171\t    }\n172\t  }\n173\t  return next;\n174\t}\n175\t\n176\texport function addCultivation(state: GameState, amount: number): GameState {\n177\t  const next = cloneState(state);\n178\t  next.realm.exp += amount;\n179\t  next.cultivation = { ...next.cultivation };\n180\t  next.cultivation.exp += amount;\n181\t  next.cultivation.totalCultivation += amount;\n182\t  while (next.realm.exp >= next.realm.expToNext) {\n183\t    next.realm.exp -= next.realm.expToNext;\n184\t    next.realm.level += 1;\n185\t    next.realm.expToNext = Math.floor(next.realm.expToNext * 1.8);\n186\t  }\n187\t  return next;\n188\t}\n189\t\n190\texport function placeBuilding(state: GameState, mapIndex: number, building: BuildingInstance): GameState {\n191\t  const next = cloneState(state);\n192\t  next.maps[mapIndex].buildings.push(building);\n193\t  return next;\n194\t}\n195\t\n196\texport function removeBuilding(state: GameState, mapIndex: number, buildingUid: string): GameState {\n197\t  const next = cloneState(state);\n198\t  const map = next.maps[mapIndex];\n199\t  map.buildings = map.buildings.filter(b => b.uid !== buildingUid);\n200\t  return next;\n201\t}\n202\t\n203\texport function updateBuilding(\n204\t  state: GameState,\n205\t  mapIndex: number,\n206\t  buildingUid: string,\n207\t  patch: Partial<BuildingInstance>,\n208\t): GameState {\n209\t  const next = cloneState(state);\n210\t  const building = next.maps[mapIndex].buildings.find(b => b.uid === buildingUid);\n211\t  if (building) {\n212\t    Object.assign(building, patch);\n213\t  }\n214\t  return next;\n215\t}\n216\t\n217\texport function setMap(state: GameState, index: number, map: GameMap): GameState {\n218\t  const next = cloneState(state);\n219\t  next.maps[index] = map;\n220\t  return next;\n221\t}\n222\t\n223\texport function addAchievement(state: GameState, achievementId: string): GameState {\n224\t  if (state.achievements.includes(achievementId)) return state;\n225\t  const next = cloneState(state);\n226\t  next.achievements.push(achievementId);\n227\t  return next;\n228\t}\n229\t\n230\texport function addCrossRegionLink(state: GameState, link: CrossRegionLink): GameState {\n231\t  const next = cloneState(state);\n232\t  next.crossRegionLinks.push(link);\n233\t  return next;\n234\t}\n235\t\n236\texport function removeCrossRegionLink(state: GameState, linkId: string): GameState {\n237\t  const next = cloneState(state);\n238\t  next.crossRegionLinks = next.crossRegionLinks.filter(l => l.id !== linkId);\n239\t  return next;\n240\t}\n241\t\n242\texport function saveGame(state: GameState): void {\n243\t  const data: SaveData = {\n244\t    version: CURRENT_VERSION,\n245\t    timestamp: Date.now(),\n246\t    playtime: state.totalPlaytime,\n247\t    gameState: state,\n248\t  };\n249\t  try {\n250\t    localStorage.setItem(SAVE_KEY, JSON.stringify(data));\n251\t  } catch {\n252\t    console.warn('Save failed: storage quota exceeded');\n253\t  }\n254\t}\n255\t\n256\texport function loadGame(): GameState | null {\n257\t  try {\n258\t    const raw = localStorage.getItem(SAVE_KEY);\n259\t    if (!raw) return null;\n260\t    const data: SaveData = JSON.parse(raw);\n261\t    const state = data.gameState ?? null;\n262\t\n263\t    // Migration: add cultivation (v0.2.0)\n264\t    if (state && !state.cultivation) {\n265\t      state.cultivation = state.realm\n266\t        ? migrateFromOldRealm(state.realm)\n267\t        : createInitialCultivationState();\n268\t    }\n269\t    if (state && !state.alchemySession) {\n270\t      state.alchemySession = null;\n271\t    }\n272\t    // Add new resource fields progressively\n273\t    if (state) {\n274\t      const res = state.resources as Record<string, number>;\n275\t      if (res.pill_peiyuan === undefined) res.pill_peiyuan = 0;\n276\t      if (res.pill_ningqi === undefined) res.pill_ningqi = 0;\n277\t      if (res.pill_zhuji === undefined) res.pill_zhuji = 0;\n278\t      if (res.pill_jindanyin === undefined) res.pill_jindanyin = 0;\n279\t      if (res.spirit_wood === undefined) res.spirit_wood = 0;\n280\t      if (res.talisman_paper === undefined) res.talisman_paper = 0;\n281\t      // v0.4.0 new resources\n282\t      if (res.pill_yuanyingguo === undefined) res.pill_yuanyingguo = 0;\n283\t      if (res.pill_huashenlu === undefined) res.pill_huashenlu = 0;\n284\t      if (res.pill_jiuzhuan === undefined) res.pill_jiuzhuan = 0;\n285\t      if (res.monster_core === undefined) res.monster_core = 0;\n286\t      if (res.heaven_earth_liquid === undefined) res.heaven_earth_liquid = 0;\n287\t      if (res.immortal_stone === undefined) res.immortal_stone = 0;\n288\t      if (res.merit === undefined) res.merit = 0;\n289\t      // Fix potential typo from migration\n290\t      if (res.pill_jiuzhuran !== undefined) {\n291\t        res.pill_jiuzhuan = res.pill_jiuzhuran;\n292\t        delete res.pill_jiuzhuran;\n293\t      }\n294\t    }\n295\t    // v0.4.0 new fields\n296\t    if (state) {\n297\t      if (!state.achievements) state.achievements = [];\n298\t      if (state.ascensionCompleted === undefined) state.ascensionCompleted = false;\n299\t      if (!state.crossRegionLinks) state.crossRegionLinks = [];\n300\t      if (!state.totalCollected) state.totalCollected = {};\n301\t      if (!state.savedConveyors) state.savedConveyors = [];\n302\t      if (!state.savedPuppets) state.savedPuppets = [];\n303\t      if (!state.savedTalismans) state.savedTalismans = [];\n304\t    }\n305\t\n306\t    return state;\n307\t  } catch {\n308\t    return null;\n309\t  }\n310\t}\n311\t\n312\texport function clearSave(): void {\n313\t  localStorage.removeItem(SAVE_KEY);\n314\t}\n315\t\n316\tlet autoSaveTimer = 0;\n317\t\n318\texport function startAutoSave(getState: () => GameState, intervalMs: number = 300000): void {\n319\t  stopAutoSave();\n320\t  autoSaveTimer = window.setInterval(() => {\n321\t    saveGame(getState());\n322\t  }, intervalMs);\n323\t}\n324\t\n325\texport function stopAutoSave(): void {\n326\t  if (autoSaveTimer) {\n327\t    clearInterval(autoSaveTimer);\n328\t    autoSaveTimer = 0;\n329\t  }\n330\t}\n331\t"}]},"parent_tool_use_id":null,"session_id":"93695823-6434-4d3f-8f7c-d2b2fb5d45a1","uuid":"6bcad630-1930-46a7-a478-ffb1fb72740d","timestamp":"2026-05-23T03:36:41.837Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\GameState.ts","content":"// GameState.ts — Immutable game state with save/load interface (v0.4.0)\n\nimport { type CultivationState, createInitialCultivationState, migrateFromOldRealm } from './Cultivation';\n\nexport interface Resources {\n  [key: string]: number;\n  spirit_stone: number;\n  spirit_grass: number;\n  spirit_energy: number;\n  cultivation: number;\n  pill_juling: number;\n  pill_peiyuan: number;\n  pill_ningqi: number;\n  pill_zhuji: number;\n  pill_jindanyin: number;\n  pill_yuanyingguo: number;\n  pill_huashenlu: number;\n  pill_jiuzhuan: number;\n  spirit_iron: number;\n  spirit_wood: number;\n  talisman_paper: number;\n  monster_core: number;\n  heaven_earth_liquid: number;\n  immortal_stone: number;\n  merit: number;\n}\n\nexport interface BuildingInstance {\n  uid: string;\n  buildingId: string;\n  gridX: number;\n  gridY: number;\n  level: number;\n  lastCollectTime: number;\n  isProducing: boolean;\n  progress: number;\n}\n\nexport interface RealmProgress {\n  realmId: string;\n  level: number;\n  exp: number;\n  expToNext: number;\n}\n\nexport interface AlchemySessionData {\n  recipeId: string;\n  startTime: number;\n  progress: number;\n  complete: boolean;\n}\n\nexport interface GameMap {\n  regionId: string;\n  width: number;\n  height: number;\n  terrain: number[];\n  buildings: BuildingInstance[];\n}\n\nexport interface GameState {\n  resources: Resources;\n  realm: RealmProgress;\n  cultivation: CultivationState;\n  alchemySession: AlchemySessionData | null;\n  maps: GameMap[];\n  currentRegionIndex: number;\n  totalPlaytime: number;\n  lastSaveTime: number;\n  lastOnlineTime: number;\n  version: string;\n  achievements: string[];\n  ascensionCompleted: boolean;\n  crossRegionLinks: CrossRegionLink[];\n  totalCollected: Record<string, number>;\n  savedConveyors: any[];\n  savedPuppets: any[];\n  savedTalismans: any[];\n}\n\nexport interface CrossRegionLink {\n  id: string;\n  fromRegionIndex: number;\n  fromX: number;\n  fromY: number;\n  toRegionIndex: number;\n  toX: number;\n  toY: number;\n  resource: string;\n  amount: number;\n  interval: number;\n  lastTransfer: number;\n}\n\nexport interface SaveData {\n  version: string;\n  timestamp: number;\n  playtime: number;\n  gameState: GameState;\n}\n\nconst SAVE_KEY = 'cultivation_factory_save';\nconst CURRENT_VERSION = '1.0.0';\n\nfunction initialResources(): Resources {\n  return {\n    spirit_stone: 0,\n    spirit_grass: 0,\n    spirit_energy: 0,\n    cultivation: 0,\n    pill_juling: 0,\n    pill_peiyuan: 0,\n    pill_ningqi: 0,\n    pill_zhuji: 0,\n    pill_jindanyin: 0,\n    pill_yuanyingguo: 0,\n    pill_huashenlu: 0,\n    pill_jiuzhuan: 0,\n    spirit_iron: 0,\n    spirit_wood: 0,\n    talisman_paper: 0,\n    monster_core: 0,\n    heaven_earth_liquid: 0,\n    immortal_stone: 0,\n    merit: 0,\n  };\n}\n\nfunction initialRealm(): RealmProgress {\n  return {\n    realmId: 'liqi',\n    level: 1,\n    exp: 0,\n    expToNext: 100,\n  };\n}\n\nexport function createInitialState(): GameState {\n  return {\n    resources: initialResources(),\n    realm: initialRealm(),\n    cultivation: createInitialCultivationState(),\n    alchemySession: null,\n    maps: [],\n    currentRegionIndex: 0,\n    totalPlaytime: 0,\n    lastSaveTime: Date.now(),\n    lastOnlineTime: Date.now(),\n    version: CURRENT_VERSION,\n    achievements: [],\n    ascensionCompleted: false,\n    crossRegionLinks: [],\n    totalCollected: {},\n    savedConveyors: [],\n    savedPuppets: [],\n    savedTalismans: [],\n  };\n}\n\nexport function cloneState(state: GameState): GameState {\n  return JSON.parse(JSON.stringify(state));\n}\n\nexport function addResources(state: GameState, delta: Partial<Resources>): GameState {\n  const next = cloneState(state);\n  for (const key of Object.keys(delta) as (keyof Resources)[]) {\n    const amount = delta[key] ?? 0;\n    next.resources[key] = Math.max(0, next.resources[key] + amount);\n    if (amount > 0) {\n      next.totalCollected[key] = (next.totalCollected[key] ?? 0) + amount;\n    }\n  }\n  return next;\n}\n\nexport function addCultivation(state: GameState, amount: number): GameState {\n  const next = cloneState(state);\n  next.realm.exp += amount;\n  next.cultivation = { ...next.cultivation };\n  next.cultivation.exp += amount;\n  next.cultivation.totalCultivation += amount;\n  while (next.realm.exp >= next.realm.expToNext) {\n    next.realm.exp -= next.realm.expToNext;\n    next.realm.level += 1;\n    next.realm.expToNext = Math.floor(next.realm.expToNext * 1.8);\n  }\n  return next;\n}\n\nexport function placeBuilding(state: GameState, mapIndex: number, building: BuildingInstance): GameState {\n  const next = cloneState(state);\n  next.maps[mapIndex].buildings.push(building);\n  return next;\n}\n\nexport function removeBuilding(state: GameState, mapIndex: number, buildingUid: string): GameState {\n  const next = cloneState(state);\n  const map = next.maps[mapIndex];\n  map.buildings = map.buildings.filter(b => b.uid !== buildingUid);\n  return next;\n}\n\nexport function updateBuilding(\n  state: GameState,\n  mapIndex: number,\n  buildingUid: string,\n  patch: Partial<BuildingInstance>,\n): GameState {\n  const next = cloneState(state);\n  const building = next.maps[mapIndex].buildings.find(b => b.uid === buildingUid);\n  if (building) {\n    Object.assign(building, patch);\n  }\n  return next;\n}\n\nexport function setMap(state: GameState, index: number, map: GameMap): GameState {\n  const next = cloneState(state);\n  next.maps[index] = map;\n  return next;\n}\n\nexport function addAchievement(state: GameState, achievementId: string): GameState {\n  if (state.achievements.includes(achievementId)) return state;\n  const next = cloneState(state);\n  next.achievements.push(achievementId);\n  return next;\n}\n\nexport function addCrossRegionLink(state: GameState, link: CrossRegionLink): GameState {\n  const next = cloneState(state);\n  next.crossRegionLinks.push(link);\n  return next;\n}\n\nexport function removeCrossRegionLink(state: GameState, linkId: string): GameState {\n  const next = cloneState(state);\n  next.crossRegionLinks = next.crossRegionLinks.filter(l => l.id !== linkId);\n  return next;\n}\n\nexport function saveGame(state: GameState): void {\n  const data: SaveData = {\n    version: CURRENT_VERSION,\n    timestamp: Date.now(),\n    playtime: state.totalPlaytime,\n    gameState: state,\n  };\n  try {\n    localStorage.setItem(SAVE_KEY, JSON.stringify(data));\n  } catch {\n    console.warn('Save failed: storage quota exceeded');\n  }\n}\n\nexport function loadGame(): GameState | null {\n  try {\n    const raw = localStorage.getItem(SAVE_KEY);\n    if (!raw) return null;\n    const data: SaveData = JSON.parse(raw);\n    const state = data.gameState ?? null;\n\n    // Migration: add cultivation (v0.2.0)\n    if (state && !state.cultivation) {\n      state.cultivation = state.realm\n        ? migrateFromOldRealm(state.realm)\n        : createInitialCultivationState();\n    }\n    if (state && !state.alchemySession) {\n      state.alchemySession = null;\n    }\n    // Add new resource fields progressively\n    if (state) {\n      const res = state.resources as Record<string, number>;\n      if (res.pill_peiyuan === undefined) res.pill_peiyuan = 0;\n      if (res.pill_ningqi === undefined) res.pill_ningqi = 0;\n      if (res.pill_zhuji === undefined) res.pill_zhuji = 0;\n      if (res.pill_jindanyin === undefined) res.pill_jindanyin = 0;\n      if (res.spirit_wood === undefined) res.spirit_wood = 0;\n      if (res.talisman_paper === undefined) res.talisman_paper = 0;\n      // v0.4.0 new resources\n      if (res.pill_yuanyingguo === undefined) res.pill_yuanyingguo = 0;\n      if (res.pill_huashenlu === undefined) res.pill_huashenlu = 0;\n      if (res.pill_jiuzhuan === undefined) res.pill_jiuzhuan = 0;\n      if (res.monster_core === undefined) res.monster_core = 0;\n      if (res.heaven_earth_liquid === undefined) res.heaven_earth_liquid = 0;\n      if (res.immortal_stone === undefined) res.immortal_stone = 0;\n      if (res.merit === undefined) res.merit = 0;\n      // Fix potential typo from migration\n      if (res.pill_jiuzhuran !== undefined) {\n        res.pill_jiuzhuan = res.pill_jiuzhuran;\n        delete res.pill_jiuzhuran;\n      }\n    }\n    // v0.4.0 new fields\n    if (state) {\n      if (!state.achievements) state.achievements = [];\n      if (state.ascensionCompleted === undefined) state.ascensionCompleted = false;\n      if (!state.crossRegionLinks) state.crossRegionLinks = [];\n      if (!state.totalCollected) state.totalCollected = {};\n      if (!state.savedConveyors) state.savedConveyors = [];\n      if (!state.savedPuppets) state.savedPuppets = [];\n      if (!state.savedTalismans) state.savedTalismans = [];\n    }\n\n    return state;\n  } catch {\n    return null;\n  }\n}\n\nexport function clearSave(): void {\n  localStorage.removeItem(SAVE_KEY);\n}\n\nlet autoSaveTimer = 0;\n\nexport function startAutoSave(getState: () => GameState, intervalMs: number = 300000): void {\n  stopAutoSave();\n  autoSaveTimer = window.setInterval(() => {\n    saveGame(getState());\n  }, intervalMs);\n}\n\nexport function stopAutoSave(): void {\n  if (autoSaveTimer) {\n    clearInterval(autoSaveTimer);\n    autoSaveTimer = 0;\n  }\n}\n","numLines":331,"startLine":1,"totalLines":331}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_78492a831d0e4e1e97565f48","type":"tool_result","content":"1\t// Renderer.ts — Canvas 2D rendering system\n2\t\n3\timport { Camera } from './Camera';\n4\timport { GameMap } from '../game/Map';\n5\timport type { BuildingInstance } from '../game/GameState';\n6\timport { renderBuilding } from '../game/Building';\n7\timport type { BuildingDef } from '../game/Building';\n8\timport { getResourceDisplays, formatAmount } from '../game/Resources';\n9\timport type { Resources, RealmProgress } from '../game/GameState';\n10\timport { type CultivationState, getFullRealmName, getShortRealmName } from '../game/Cultivation';\n11\t\n12\texport class Renderer {\n13\t  canvas: HTMLCanvasElement;\n14\t  ctx: CanvasRenderingContext2D;\n15\t  camera: Camera;\n16\t\n17\t  constructor(canvas: HTMLCanvasElement) {\n18\t    this.canvas = canvas;\n19\t    this.ctx = canvas.getContext('2d')!;\n20\t    this.camera = new Camera(canvas);\n21\t    this.resize();\n22\t  }\n23\t\n24\t  resize(): void {\n25\t    const dpr = window.devicePixelRatio || 1;\n26\t    const rect = this.canvas.getBoundingClientRect();\n27\t    this.canvas.width = rect.width * dpr;\n28\t    this.canvas.height = rect.height * dpr;\n29\t    this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n30\t  }\n31\t\n32\t  render(\n33\t    map: GameMap,\n34\t    buildings: BuildingInstance[],\n35\t    buildingDefs: Map<string, BuildingDef>,\n36\t    resources: Resources,\n37\t    realm: RealmProgress,\n38\t    cultivation: CultivationState,\n39\t    hoveredCell: { gx: number; gy: number } | null,\n40\t    placementPreview: { def: BuildingDef; gx: number; gy: number; valid: boolean } | null,\n41\t    now: number,\n42\t  ): void {\n43\t    const ctx = this.ctx;\n44\t    const w = this.canvas.getBoundingClientRect().width;\n45\t    const h = this.canvas.getBoundingClientRect().height;\n46\t\n47\t    ctx.fillStyle = '#1a1a2e';\n48\t    ctx.fillRect(0, 0, w, h);\n49\t\n50\t    const { offsetX, offsetY, scale } = this.camera.getTransform();\n51\t\n52\t    map.render(ctx, offsetX, offsetY, w, h, scale);\n53\t\n54\t    for (const building of buildings) {\n55\t      const def = buildingDefs.get(building.buildingId);\n56\t      if (def) {\n57\t        renderBuilding(ctx, building, def, offsetX, offsetY, scale, map.cellSize, now);\n58\t      }\n59\t    }\n60\t\n61\t    if (placementPreview) {\n62\t      this.renderPlacementPreview(ctx, placementPreview, offsetX, offsetY, scale, map.cellSize);\n63\t    }\n64\t\n65\t    if (hoveredCell && map.inBounds(hoveredCell.gx, hoveredCell.gy)) {\n66\t      const hx = offsetX + hoveredCell.gx * map.cellSize * scale;\n67\t      const hy = offsetY + hoveredCell.gy * map.cellSize * scale;\n68\t      const hs = map.cellSize * scale;\n69\t      ctx.strokeStyle = 'rgba(255,255,255,0.4)';\n70\t      ctx.lineWidth = 1;\n71\t      ctx.strokeRect(hx, hy, hs, hs);\n72\t    }\n73\t\n74\t    this.renderUI(ctx, w, h, resources, realm, cultivation);\n75\t  }\n76\t\n77\t  private renderPlacementPreview(\n78\t    ctx: CanvasRenderingContext2D,\n79\t    preview: { def: BuildingDef; gx: number; gy: number; valid: boolean },\n80\t    offsetX: number,\n81\t    offsetY: number,\n82\t    scale: number,\n83\t    cellSize: number,\n84\t  ): void {\n85\t    const x = offsetX + preview.gx * cellSize * scale;\n86\t    const y = offsetY + preview.gy * cellSize * scale;\n87\t    const w = preview.def.size.w * cellSize * scale;\n88\t    const h = preview.def.size.h * cellSize * scale;\n89\t\n90\t    const { r, g, b } = preview.def.color;\n91\t    const alpha = preview.valid ? 0.4 : 0.2;\n92\t\n93\t    ctx.fillStyle = preview.valid\n94\t      ? `rgba(${r},${g},${b},${alpha})`\n95\t      : `rgba(255,50,50,${alpha})`;\n96\t    ctx.fillRect(x + 2, y + 2, w - 4, h - 4);\n97\t\n98\t    ctx.strokeStyle = preview.valid ? 'rgba(100,255,100,0.8)' : 'rgba(255,100,100,0.8)';\n99\t    ctx.lineWidth = 2;\n100\t    ctx.setLineDash([4, 4]);\n101\t    ctx.strokeRect(x + 2, y + 2, w - 4, h - 4);\n102\t    ctx.setLineDash([]);\n103\t  }\n104\t\n105\t  private renderUI(\n106\t    ctx: CanvasRenderingContext2D,\n107\t    canvasW: number,\n108\t    canvasH: number,\n109\t    resources: Resources,\n110\t    realm: RealmProgress,\n111\t    cultivation: CultivationState,\n112\t  ): void {\n113\t    // Top bar background\n114\t    ctx.fillStyle = 'rgba(0,0,0,0.8)';\n115\t    ctx.fillRect(0, 0, canvasW, 52);\n116\t\n117\t    // Realm display using cultivation system\n118\t    const realmName = getFullRealmName(cultivation);\n119\t    ctx.fillStyle = '#ffd700';\n120\t    ctx.font = 'bold 14px monospace';\n121\t    ctx.textAlign = 'left';\n122\t    ctx.textBaseline = 'middle';\n123\t    ctx.fillText(realmName, 12, 18);\n124\t\n125\t    // Cultivation exp bar\n126\t    const expBarX = 12;\n127\t    const expBarY = 32;\n128\t    const expBarW = 140;\n129\t    const expBarH = 12;\n130\t    const expRatio = cultivation.exp / cultivation.expToNext;\n131\t    ctx.fillStyle = 'rgba(255,255,255,0.1)';\n132\t    ctx.fillRect(expBarX, expBarY, expBarW, expBarH);\n133\t    ctx.fillStyle = '#ffd700';\n134\t    ctx.fillRect(expBarX, expBarY, expBarW * expRatio, expBarH);\n135\t    ctx.strokeStyle = 'rgba(255,255,255,0.3)';\n136\t    ctx.lineWidth = 1;\n137\t    ctx.strokeRect(expBarX, expBarY, expBarW, expBarH);\n138\t    ctx.fillStyle = '#fff';\n139\t    ctx.font = '9px monospace';\n140\t    ctx.textAlign = 'center';\n141\t    ctx.fillText(`${Math.floor(expRatio * 100)}%`, expBarX + expBarW / 2, expBarY + 7);\n142\t\n143\t    // Resource display\n144\t    const displays = getResourceDisplays(resources);\n145\t    let rx = canvasW - 12;\n146\t    ctx.textAlign = 'right';\n147\t    for (let i = displays.length - 1; i >= 0; i--) {\n148\t      const d = displays[i];\n149\t      if (d.amount === 0) continue;\n150\t      const text = `${d.icon} ${formatAmount(d.amount)}`;\n151\t      ctx.font = '11px monospace';\n152\t      const metrics = ctx.measureText(text);\n153\t      rx -= metrics.width + 4;\n154\t      ctx.fillStyle = d.color;\n155\t      ctx.fillText(text, rx + metrics.width, 24);\n156\t      rx -= 14;\n157\t    }\n158\t\n159\t    // Cultivation rate indicator\n160\t    if (cultivation.cultivationRate > 0) {\n161\t      ctx.fillStyle = 'rgba(255,215,0,0.6)';\n162\t      ctx.font = '10px monospace';\n163\t      ctx.textAlign = 'left';\n164\t      ctx.fillText(`⚡${cultivation.cultivationRate.toFixed(1)}/s`, 160, 18);\n165\t    }\n166\t  }\n167\t\n168\t  destroy(): void {\n169\t    // Clean up\n170\t  }\n171\t}\n172\t"}]},"parent_tool_use_id":null,"session_id":"93695823-6434-4d3f-8f7c-d2b2fb5d45a1","uuid":"228dcae0-9129-4274-979e-555bcc72dde0","timestamp":"2026-05-23T03:36:41.839Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\renderer\\Renderer.ts","content":"// Renderer.ts — Canvas 2D rendering system\n\nimport { Camera } from './Camera';\nimport { GameMap } from '../game/Map';\nimport type { BuildingInstance } from '../game/GameState';\nimport { renderBuilding } from '../game/Building';\nimport type { BuildingDef } from '../game/Building';\nimport { getResourceDisplays, formatAmount } from '../game/Resources';\nimport type { Resources, RealmProgress } from '../game/GameState';\nimport { type CultivationState, getFullRealmName, getShortRealmName } from '../game/Cultivation';\n\nexport class Renderer {\n  canvas: HTMLCanvasElement;\n  ctx: CanvasRenderingContext2D;\n  camera: Camera;\n\n  constructor(canvas: HTMLCanvasElement) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d')!;\n    this.camera = new Camera(canvas);\n    this.resize();\n  }\n\n  resize(): void {\n    const dpr = window.devicePixelRatio || 1;\n    const rect = this.canvas.getBoundingClientRect();\n    this.canvas.width = rect.width * dpr;\n    this.canvas.height = rect.height * dpr;\n    this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n  }\n\n  render(\n    map: GameMap,\n    buildings: BuildingInstance[],\n    buildingDefs: Map<string, BuildingDef>,\n    resources: Resources,\n    realm: RealmProgress,\n    cultivation: CultivationState,\n    hoveredCell: { gx: number; gy: number } | null,\n    placementPreview: { def: BuildingDef; gx: number; gy: number; valid: boolean } | null,\n    now: number,\n  ): void {\n    const ctx = this.ctx;\n    const w = this.canvas.getBoundingClientRect().width;\n    const h = this.canvas.getBoundingClientRect().height;\n\n    ctx.fillStyle = '#1a1a2e';\n    ctx.fillRect(0, 0, w, h);\n\n    const { offsetX, offsetY, scale } = this.camera.getTransform();\n\n    map.render(ctx, offsetX, offsetY, w, h, scale);\n\n    for (const building of buildings) {\n      const def = buildingDefs.get(building.buildingId);\n      if (def) {\n        renderBuilding(ctx, building, def, offsetX, offsetY, scale, map.cellSize, now);\n      }\n    }\n\n    if (placementPreview) {\n      this.renderPlacementPreview(ctx, placementPreview, offsetX, offsetY, scale, map.cellSize);\n    }\n\n    if (hoveredCell && map.inBounds(hoveredCell.gx, hoveredCell.gy)) {\n      const hx = offsetX + hoveredCell.gx * map.cellSize * scale;\n      const hy = offsetY + hoveredCell.gy * map.cellSize * scale;\n      const hs = map.cellSize * scale;\n      ctx.strokeStyle = 'rgba(255,255,255,0.4)';\n      ctx.lineWidth = 1;\n      ctx.strokeRect(hx, hy, hs, hs);\n    }\n\n    this.renderUI(ctx, w, h, resources, realm, cultivation);\n  }\n\n  private renderPlacementPreview(\n    ctx: CanvasRenderingContext2D,\n    preview: { def: BuildingDef; gx: number; gy: number; valid: boolean },\n    offsetX: number,\n    offsetY: number,\n    scale: number,\n    cellSize: number,\n  ): void {\n    const x = offsetX + preview.gx * cellSize * scale;\n    const y = offsetY + preview.gy * cellSize * scale;\n    const w = preview.def.size.w * cellSize * scale;\n    const h = preview.def.size.h * cellSize * scale;\n\n    const { r, g, b } = preview.def.color;\n    const alpha = preview.valid ? 0.4 : 0.2;\n\n    ctx.fillStyle = preview.valid\n      ? `rgba(${r},${g},${b},${alpha})`\n      : `rgba(255,50,50,${alpha})`;\n    ctx.fillRect(x + 2, y + 2, w - 4, h - 4);\n\n    ctx.strokeStyle = preview.valid ? 'rgba(100,255,100,0.8)' : 'rgba(255,100,100,0.8)';\n    ctx.lineWidth = 2;\n    ctx.setLineDash([4, 4]);\n    ctx.strokeRect(x + 2, y + 2, w - 4, h - 4);\n    ctx.setLineDash([]);\n  }\n\n  private renderUI(\n    ctx: CanvasRenderingContext2D,\n    canvasW: number,\n    canvasH: number,\n    resources: Resources,\n    realm: RealmProgress,\n    cultivation: CultivationState,\n  ): void {\n    // Top bar background\n    ctx.fillStyle = 'rgba(0,0,0,0.8)';\n    ctx.fillRect(0, 0, canvasW, 52);\n\n    // Realm display using cultivation system\n    const realmName = getFullRealmName(cultivation);\n    ctx.fillStyle = '#ffd700';\n    ctx.font = 'bold 14px monospace';\n    ctx.textAlign = 'left';\n    ctx.textBaseline = 'middle';\n    ctx.fillText(realmName, 12, 18);\n\n    // Cultivation exp bar\n    const expBarX = 12;\n    const expBarY = 32;\n    const expBarW = 140;\n    const expBarH = 12;\n    const expRatio = cultivation.exp / cultivation.expToNext;\n    ctx.fillStyle = 'rgba(255,255,255,0.1)';\n    ctx.fillRect(expBarX, expBarY, expBarW, expBarH);\n    ctx.fillStyle = '#ffd700';\n    ctx.fillRect(expBarX, expBarY, expBarW * expRatio, expBarH);\n    ctx.strokeStyle = 'rgba(255,255,255,0.3)';\n    ctx.lineWidth = 1;\n    ctx.strokeRect(expBarX, expBarY, expBarW, expBarH);\n    ctx.fillStyle = '#fff';\n    ctx.font = '9px monospace';\n    ctx.textAlign = 'center';\n    ctx.fillText(`${Math.floor(expRatio * 100)}%`, expBarX + expBarW / 2, expBarY + 7);\n\n    // Resource display\n    const displays = getResourceDisplays(resources);\n    let rx = canvasW - 12;\n    ctx.textAlign = 'right';\n    for (let i = displays.length - 1; i >= 0; i--) {\n      const d = displays[i];\n      if (d.amount === 0) continue;\n      const text = `${d.icon} ${formatAmount(d.amount)}`;\n      ctx.font = '11px monospace';\n      const metrics = ctx.measureText(text);\n      rx -= metrics.width + 4;\n      ctx.fillStyle = d.color;\n      ctx.fillText(text, rx + metrics.width, 24);\n      rx -= 14;\n    }\n\n    // Cultivation rate indicator\n    if (cultivation.cultivationRate > 0) {\n      ctx.fillStyle = 'rgba(255,215,0,0.6)';\n      ctx.font = '10px monospace';\n      ctx.textAlign = 'left';\n      ctx.fillText(`⚡${cultivation.cultivationRate.toFixed(1)}/s`, 160, 18);\n    }\n  }\n\n  destroy(): void {\n    // Clean up\n  }\n}\n","numLines":172,"startLine":1,"totalLines":172}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_5e8750f23a5a41ec858a09d2","type":"tool_result","content":"1\t// App.ts — Game main loop (v0.4.0 — M4: 元婴+化神, 跨区域传送, 高级丹方, 终局内容)\n2\t\n3\timport { Renderer } from './Renderer';\n4\timport { GameMap } from '../game/Map';\n5\timport {\n6\t  type GameState,\n7\t  type BuildingInstance,\n8\t  type AlchemySessionData,\n9\t  type GameMap as GameMapData,\n10\t  type CrossRegionLink,\n11\t  createInitialState,\n12\t  cloneState,\n13\t  setMap,\n14\t  placeBuilding,\n15\t  loadGame,\n16\t  saveGame,\n17\t  startAutoSave,\n18\t  stopAutoSave,\n19\t  addAchievement,\n20\t  addCrossRegionLink,\n21\t} from '../game/GameState';\n22\timport {\n23\t  type BuildingDef,\n24\t  loadBuildingDefs,\n25\t  createBuildingInstance,\n26\t  canPlace,\n27\t} from '../game/Building';\n28\timport {\n29\t  collectFromBuilding,\n30\t  plantField,\n31\t  tickAutoProduction,\n32\t  tickManualProduction,\n33\t  canAfford,\n34\t  deductCost,\n35\t} from '../game/Resources';\n36\timport {\n37\t  type CultivationState,\n38\t  type BreakthroughResult,\n39\t  addCultivationExp,\n40\t  canBreakthrough,\n41\t  attemptBreakthrough,\n42\t  getBreakthroughRequirements,\n43\t  getFullRealmName,\n44\t  isRealmUnlocked as cultivationIsRealmUnlocked,\n45\t  tickAutoCultivation,\n46\t} from '../game/Cultivation';\n47\timport {\n48\t  type AlchemyRecipe,\n49\t  getAvailableRecipes,\n50\t  canCraft,\n51\t  startCrafting,\n52\t  tickAlchemy,\n53\t  collectAlchemy,\n54\t  getRemainingTime,\n55\t} from '../game/Alchemy';\n56\timport {\n57\t  usePill,\n58\t  useMultiplePills,\n59\t  getAllPillDefs,\n60\t  type PillDef,\n61\t} from '../game/Inventory';\n62\timport { audioManager } from '../game/AudioManager';\n63\timport { getAllAchievements, checkAchievement, type AchievementContext } from '../game/Achievement';\n64\timport { getAscensionChallenge, checkAscensionRequirements, attemptAscension } from '../game/Ascension';\n65\timport { tickCrossRegionLinks, createCrossRegionLink, renderCrossRegionPortal } from '../game/CrossRegionTeleport';\n66\timport { processTalismans, renderTalisman, type TalismanInstance } from '../game/Talisman';\n67\timport type { Resources } from '../game/GameState';\n68\timport buildingData from '../data/buildings.json';\n69\timport regionData from '../data/regions.json';\n70\timport {\n71\t  type ConveyorSegment,\n72\t  type ConveyorItem,\n73\t  createSegment,\n74\t  buildSegmentMap,\n75\t  autoConnect,\n76\t  tickConveyorItems,\n77\t  renderConveyorSegment,\n78\t  renderConveyorItems,\n79\t} from '../game/ConveyorBelt';\n80\timport {\n81\t  type PuppetInstance,\n82\t  createPuppet,\n83\t  tickPuppet,\n84\t  renderPuppet,\n85\t} from '../game/Puppet';\n86\t\n87\texport type PlacementMode = BuildingDef | null;\n88\t\n89\texport interface GameNotification {\n90\t  id: number;\n91\t  text: string;\n92\t  type: 'info' | 'success' | 'warning' | 'error';\n93\t  time: number;\n94\t}\n95\t\n96\tinterface RegionDef {\n97\t  id: string;\n98\t  name: string;\n99\t  nameEn: string;\n100\t  width: number;\n101\t  height: number;\n102\t  unlockRealm: string;\n103\t  maxBuildings: number;\n104\t  specialResources: string[];\n105\t  terrainBase: string;\n106\t  color: { bg: string; grid: string };\n107\t}\n108\t\n109\tlet notifIdCounter = 0;\n110\t\n111\texport class App {\n112\t  canvas: HTMLCanvasElement;\n113\t  renderer: Renderer;\n114\t  state: GameState;\n115\t  buildingDefs: Map<string, BuildingDef>;\n116\t  regionDefs: RegionDef[];\n117\t  map: GameMap;\n118\t  currentRegionIndex = 0;\n119\t\n120\t  conveyorSegments: ConveyorSegment[] = [];\n121\t  conveyorItems: ConveyorItem[] = [];\n122\t  puppets: PuppetInstance[] = [];\n123\t  talismans: TalismanInstance[] = [];\n124\t\n125\t  private running = false;\n126\t  private lastFrameTime = 0;\n127\t  private animFrameId = 0;\n128\t  private lastTickTime = 0;\n129\t  private tickInterval = 200;\n130\t\n131\t  private hoveredCell: { gx: number; gy: number } | null = null;\n132\t  private clickStartTime = 0;\n133\t  private clickStartPos = { x: 0, y: 0 };\n134\t  placementMode: PlacementMode = null;\n135\t  private placementValid = false;\n136\t  private placementPos = { gx: 0, gy: 0 };\n137\t\n138\t  breakthroughAnim: { active: boolean; result: BreakthroughResult | null; startTime: number; duration: number } = {\n139\t    active: false,\n140\t    result: null,\n141\t    startTime: 0,\n142\t    duration: 3000,\n143\t  };\n144\t\n145\t  notifications: GameNotification[] = [];\n146\t\n147\t  // M4: Ascension animation\n148\t  ascensionAnim: { active: boolean; startTime: number; duration: number } = {\n149\t    active: false,\n150\t    startTime: 0,\n151\t    duration: 5000,\n152\t  };\n153\t\n154\t  onStateChange?: (state: GameState) => void;\n155\t  onBuildingSelect?: (building: BuildingInstance | null) => void;\n156\t  onNotification?: (notif: GameNotification) => void;\n157\t  onBreakthroughAnim?: (active: boolean, result: BreakthroughResult | null) => void;\n158\t  onAlchemyUpdate?: (session: AlchemySessionData | null) => void;\n159\t  onRegionChange?: (regionIndex: number, region: RegionDef) => void;\n160\t  onAchievementUnlocked?: (achievementId: string) => void;\n161\t\n162\t  constructor(canvas: HTMLCanvasElement) {\n163\t    this.canvas = canvas;\n164\t    this.renderer = new Renderer(canvas);\n165\t\n166\t    const saved = loadGame();\n167\t    this.state = saved ? saved : createInitialState();\n168\t\n169\t    this.buildingDefs = loadBuildingDefs(buildingData as unknown as { buildings: BuildingDef[] });\n170\t    this.regionDefs = (regionData as { regions: RegionDef[] }).regions;\n171\t\n172\t    this.map = new GameMap(20, 15, '#2a3a1a', '#3a4a2a');\n173\t    this.map.generateStartingArea();\n174\t\n175\t    if (this.state.maps.length === 0) {\n176\t      this.state = setMap(this.state, 0, {\n177\t        regionId: 'liqi_flat',\n178\t        width: 20,\n179\t        height: 15,\n180\t        terrain: this.map.terrain,\n181\t        buildings: [],\n182\t      });\n183\t    } else {\n184\t      const mapData = this.state.maps[this.state.currentRegionIndex];\n185\t      if (mapData) {\n186\t        this.currentRegionIndex = this.state.currentRegionIndex;\n187\t        this.loadRegionMap(this.currentRegionIndex);\n188\t      }\n189\t    }\n190\t\n191\t    this.setupInput(canvas);\n192\t\n193\t    window.addEventListener('resize', () => {\n194\t      this.renderer.resize();\n195\t    });\n196\t  }\n197\t\n198\t  private loadRegionMap(index: number): void {\n199\t    const mapData = this.state.maps[index];\n200\t    if (!mapData) return;\n201\t\n202\t    const regionDef = this.regionDefs.find(r => r.id === mapData.regionId);\n203\t    const bg = regionDef?.color.bg ?? '#2a3a1a';\n204\t    const grid = regionDef?.color.grid ?? '#3a4a2a';\n205\t\n206\t    this.map = new GameMap(mapData.width, mapData.height, bg, grid);\n207\t    this.map.terrain = mapData.terrain;\n208\t    this.currentRegionIndex = index;\n209\t  }\n210\t\n211\t  initRegion(regionDef: RegionDef): number {\n212\t    const existing = this.state.maps.findIndex(m => m.regionId === regionDef.id);\n213\t    if (existing >= 0) return existing;\n214\t\n215\t    const newMap = new GameMap(regionDef.width, regionDef.height, regionDef.color.bg, regionDef.color.grid);\n216\t    newMap.generateRegionTerrain(regionDef.id);\n217\t\n218\t    const index = this.state.maps.length;\n219\t    this.state = setMap(this.state, index, {\n220\t      regionId: regionDef.id,\n221\t      width: regionDef.width,\n222\t      height: regionDef.height,\n223\t      terrain: newMap.terrain,\n224\t      buildings: [],\n225\t    });\n226\t\n227\t    return index;\n228\t  }\n229\t\n230\t  switchRegion(index: number): boolean {\n231\t    if (index < 0 || index >= this.state.maps.length) return false;\n232\t    if (index === this.currentRegionIndex) return false;\n233\t\n234\t    this.currentRegionIndex = index;\n235\t    this.state.currentRegionIndex = index;\n236\t    this.loadRegionMap(index);\n237\t\n238\t    const regionDef = this.regionDefs.find(r => r.id === this.state.maps[index]?.regionId);\n239\t    if (regionDef) {\n240\t      this.onRegionChange?.(index, regionDef);\n241\t    }\n242\t\n243\t    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);\n244\t    this.onStateChange?.(this.state);\n245\t    return true;\n246\t  }\n247\t\n248\t  getUnlockedRegions(): Array<RegionDef & { index: number }> {\n249\t    return this.regionDefs\n250\t      .map((r) => {\n251\t        if (cultivationIsRealmUnlocked(r.unlockRealm, this.state.cultivation)) {\n252\t          const mapIndex = this.state.maps.findIndex(m => m.regionId === r.id);\n253\t          if (mapIndex < 0) {\n254\t            this.initRegion(r);\n255\t          }\n256\t          const actualIndex = Math.max(0, this.state.maps.findIndex(m => m.regionId === r.id));\n257\t          return { ...r, index: actualIndex };\n258\t        }\n259\t        return null;\n260\t      })\n261\t      .filter((r): r is RegionDef & { index: number } => r !== null);\n262\t  }\n263\t\n264\t  start(): void {\n265\t    if (this.running) return;\n266\t    this.running = true;\n267\t    this.lastFrameTime = performance.now();\n268\t    this.lastTickTime = this.lastFrameTime;\n269\t\n270\t    // Restore persisted conveyors/puppets/talismans\n271\t    if (this.state.savedConveyors?.length) {\n272\t      this.conveyorSegments = this.state.savedConveyors;\n273\t    }\n274\t    if (this.state.savedPuppets?.length) {\n275\t      this.puppets = this.state.savedPuppets;\n276\t    }\n277\t    if (this.state.savedTalismans?.length) {\n278\t      this.talismans = this.state.savedTalismans;\n279\t    }\n280\t\n281\t    this.loop(this.lastFrameTime);\n282\t\n283\t    startAutoSave(() => this.getSaveableState());\n284\t  }\n285\t\n286\t  private getSaveableState(): GameState {\n287\t    const state = cloneState(this.state);\n288\t    state.savedConveyors = this.conveyorSegments;\n289\t    state.savedPuppets = this.puppets;\n290\t    state.savedTalismans = this.talismans;\n291\t    return state;\n292\t  }\n293\t\n294\t  stop(): void {\n295\t    this.running = false;\n296\t    if (this.animFrameId) {\n297\t      cancelAnimationFrame(this.animFrameId);\n298\t    }\n299\t    stopAutoSave();\n300\t    saveGame(this.getSaveableState());\n301\t  }\n302\t\n303\t  private loop = (now: number): void => {\n304\t    if (!this.running) return;\n305\t\n306\t    const dt = now - this.lastFrameTime;\n307\t    this.lastFrameTime = now;\n308\t\n309\t    this.state.totalPlaytime += dt / 1000;\n310\t\n311\t    if (now - this.lastTickTime >= this.tickInterval) {\n312\t      this.tickProduction(now);\n313\t      this.lastTickTime = now;\n314\t    }\n315\t\n316\t    this.render(now);\n317\t\n318\t    this.animFrameId = requestAnimationFrame(this.loop);\n319\t  };\n320\t\n321\t  private tickProduction(now: number): void {\n322\t    this.state = tickAutoProduction(this.state, this.currentRegionIndex, now, this.buildingDefs);\n323\t    this.state = tickManualProduction(this.state, this.currentRegionIndex, now, this.buildingDefs);\n324\t\n325\t    this.state.cultivation = tickAutoCultivation(this.state.cultivation, this.tickInterval);\n326\t\n327\t    if (this.state.alchemySession) {\n328\t      this.state.alchemySession = tickAlchemy(this.state.alchemySession, now);\n329\t      this.onAlchemyUpdate?.(this.state.alchemySession);\n330\t    }\n331\t\n332\t    // M3: Conveyor items tick\n333\t    if (this.conveyorSegments.length > 0) {\n334\t      const segMap = buildSegmentMap(this.conveyorSegments);\n335\t      const result = tickConveyorItems(this.conveyorItems, segMap, this.tickInterval);\n336\t      this.conveyorItems = result.items;\n337\t\n338\t      for (const d of result.delivered) {\n339\t        const delta: Partial<Resources> = {};\n340\t        (delta as Record<string, number>)[d.resource] = d.amount;\n341\t        this.state = { ...this.state, resources: { ...this.state.resources, [d.resource]: (this.state.resources[d.resource] ?? 0) + d.amount } };\n342\t      }\n343\t    }\n344\t\n345\t    // M3: Puppet tick\n346\t    for (let i = 0; i < this.puppets.length; i++) {\n347\t      this.puppets[i] = tickPuppet(this.puppets[i], this.tickInterval);\n348\t    }\n349\t\n350\t    // M4: Cross-region teleport tick\n351\t    if (this.state.crossRegionLinks.length > 0) {\n352\t      const crResult = tickCrossRegionLinks(this.state.crossRegionLinks, this.state.resources, now);\n353\t      this.state.crossRegionLinks = crResult.links;\n354\t\n355\t      for (const t of crResult.transferred) {\n356\t        this.state = { ...this.state, resources: { ...this.state.resources, [t.resource]: (this.state.resources[t.resource] ?? 0) + t.amount } };\n357\t      }\n358\t    }\n359\t\n360\t    // M4: Achievement check (every 5 seconds)\n361\t    if (Math.floor(now / 5000) !== Math.floor((now - this.tickInterval) / 5000)) {\n362\t      this.checkAchievements();\n363\t    }\n364\t\n365\t    // Talisman processing\n366\t    if (this.talismans.length > 0) {\n367\t      const buildingCounts: Record<string, number> = {};\n368\t      for (const map of this.state.maps) {\n369\t        for (const b of map.buildings) {\n370\t          buildingCounts[b.buildingId] = (buildingCounts[b.buildingId] ?? 0) + 1;\n371\t        }\n372\t      }\n373\t      const talResult = processTalismans(\n374\t        this.talismans,\n375\t        this.state.resources,\n376\t        buildingCounts,\n377\t        this.state.realm.level,\n378\t        now,\n379\t      );\n380\t      this.talismans = talResult.talismans;\n381\t      for (const action of talResult.actions) {\n382\t        if (action.type === 'notify') {\n383\t          this.addNotification(action.message, 'info');\n384\t        } else if (action.type === 'stop_building') {\n385\t          const bld = this.state.maps[this.currentRegionIndex]?.buildings.find(b => b.uid === action.buildingUid);\n386\t          if (bld) bld.isProducing = false;\n387\t        } else if (action.type === 'start_building') {\n388\t          const bld = this.state.maps[this.currentRegionIndex]?.buildings.find(b => b.uid === action.buildingUid);\n389\t          if (bld) bld.isProducing = true;\n390\t        }\n391\t      }\n392\t    }\n393\t\n394\t    this.onStateChange?.(this.state);\n395\t  }\n396\t\n397\t  // M4: Achievement checking\n398\t  private checkAchievements(): void {\n399\t    const buildingCounts: Record<string, number> = {};\n400\t    let totalBuildingCount = 0;\n401\t    for (const map of this.state.maps) {\n402\t      for (const b of map.buildings) {\n403\t        buildingCounts[b.buildingId] = (buildingCounts[b.buildingId] ?? 0) + 1;\n404\t        totalBuildingCount++;\n405\t      }\n406\t    }\n407\t\n408\t    const unlockedRegions = this.regionDefs\n409\t      .filter(r => cultivationIsRealmUnlocked(r.unlockRealm, this.state.cultivation))\n410\t      .map(r => r.id);\n411\t\n412\t    const context: AchievementContext = {\n413\t      currentRealmId: this.state.cultivation.realmId,\n414\t      realmOrder: ['fanren', 'liqi', 'zhuji', 'jindan', 'yuanying', 'huashen'],\n415\t      totalResourcesCollected: this.state.totalCollected as Record<string, number>,\n416\t      buildingCounts,\n417\t      totalBuildingCount,\n418\t      pillsCrafted: {},\n419\t      totalPillsCrafted: 0,\n420\t      allPillTypesCrafted: false,\n421\t      unlockedRegions,\n422\t      ascensionCompleted: this.state.ascensionCompleted,\n423\t      playtimeHours: this.state.totalPlaytime / 3600,\n424\t      crossRegionLinkCount: this.state.crossRegionLinks.length,\n425\t    };\n426\t\n427\t    for (const ach of getAllAchievements()) {\n428\t      if (this.state.achievements.includes(ach.id)) continue;\n429\t      if (checkAchievement(ach, context)) {\n430\t        this.state = addAchievement(this.state, ach.id);\n431\t        this.addNotification(`🏆 成就解锁: ${ach.name}`, 'success');\n432\t        this.onAchievementUnlocked?.(ach.id);\n433\t      }\n434\t    }\n435\t  }\n436\t\n437\t  private render(now: number): void {\n438\t    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n439\t    const preview = this.placementMode\n440\t      ? { def: this.placementMode, gx: this.placementPos.gx, gy: this.placementPos.gy, valid: this.placementValid }\n441\t      : null;\n442\t\n443\t    this.renderer.render(\n444\t      this.map,\n445\t      buildings,\n446\t      this.buildingDefs,\n447\t      this.state.resources,\n448\t      this.state.realm,\n449\t      this.state.cultivation,\n450\t      this.hoveredCell,\n451\t      preview,\n452\t      now,\n453\t    );\n454\t\n455\t    const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n456\t    const segMap = buildSegmentMap(this.conveyorSegments);\n457\t    for (const seg of this.conveyorSegments) {\n458\t      renderConveyorSegment(this.renderer.ctx, seg, offsetX, offsetY, scale, this.map.cellSize, now);\n459\t    }\n460\t    renderConveyorItems(this.renderer.ctx, this.conveyorItems, segMap, offsetX, offsetY, scale, this.map.cellSize);\n461\t\n462\t    for (const puppet of this.puppets) {\n463\t      renderPuppet(this.renderer.ctx, puppet, offsetX, offsetY, scale, this.map.cellSize, now);\n464\t    }\n465\t\n466\t    for (const talisman of this.talismans) {\n467\t      renderTalisman(this.renderer.ctx, talisman, offsetX, offsetY, scale, this.map.cellSize, now);\n468\t    }\n469\t\n470\t    // M4: Render cross-region portals in current map\n471\t    for (const link of this.state.crossRegionLinks) {\n472\t      if (link.fromRegionIndex === this.currentRegionIndex) {\n473\t        renderCrossRegionPortal(this.renderer.ctx, link.fromX, link.fromY, offsetX, offsetY, scale, this.map.cellSize, now);\n474\t      }\n475\t    }\n476\t\n477\t    if (this.breakthroughAnim.active) {\n478\t      this.renderBreakthroughOverlay(now);\n479\t    }\n480\t\n481\t    if (this.ascensionAnim.active) {\n482\t      this.renderAscensionOverlay(now);\n483\t    }\n484\t  }\n485\t\n486\t  private renderBreakthroughOverlay(now: number): void {\n487\t    const ctx = this.renderer.ctx;\n488\t    const w = this.canvas.getBoundingClientRect().width;\n489\t    const h = this.canvas.getBoundingClientRect().height;\n490\t\n491\t    const elapsed = now - this.breakthroughAnim.startTime;\n492\t    const progress = Math.min(1, elapsed / this.breakthroughAnim.duration);\n493\t\n494\t    let alpha = 0;\n495\t    if (progress < 0.2) alpha = progress / 0.2;\n496\t    else if (progress > 0.8) alpha = (1 - progress) / 0.2;\n497\t    else alpha = 1;\n498\t\n499\t    const result = this.breakthroughAnim.result;\n500\t\n501\t    if (result?.success) {\n502\t      ctx.fillStyle = `rgba(255, 215, 0, ${alpha * 0.15})`;\n503\t      ctx.fillRect(0, 0, w, h);\n504\t\n505\t      ctx.fillStyle = `rgba(255, 215, 0, ${alpha})`;\n506\t      ctx.font = `bold ${24 + Math.sin(progress * Math.PI * 4) * 4}px serif`;\n507\t      ctx.textAlign = 'center';\n508\t      ctx.textBaseline = 'middle';\n509\t      ctx.fillText('⚡ 境界突破成功 ⚡', w / 2, h / 2 - 20);\n510\t\n511\t      ctx.font = '16px serif';\n512\t      ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;\n513\t      const realmName = getFullRealmName(this.state.cultivation);\n514\t      ctx.fillText(`进入 ${realmName}`, w / 2, h / 2 + 20);\n515\t    } else if (result) {\n516\t      ctx.fillStyle = `rgba(200, 50, 50, ${alpha * 0.15})`;\n517\t      ctx.fillRect(0, 0, w, h);\n518\t\n519\t      ctx.fillStyle = `rgba(255, 100, 100, ${alpha})`;\n520\t      ctx.font = 'bold 24px serif';\n521\t      ctx.textAlign = 'center';\n522\t      ctx.textBaseline = 'middle';\n523\t      ctx.fillText('突破失败...', w / 2, h / 2 - 20);\n524\t\n525\t      ctx.font = '14px serif';\n526\t      ctx.fillStyle = `rgba(255, 200, 200, ${alpha})`;\n527\t      ctx.fillText(`修为损失 ${Math.floor(result.penalty * 100)}%`, w / 2, h / 2 + 20);\n528\t    }\n529\t\n530\t    if (progress >= 1) {\n531\t      this.breakthroughAnim.active = false;\n532\t      this.breakthroughAnim.result = null;\n533\t      this.onBreakthroughAnim?.(false, null);\n534\t    }\n535\t  }\n536\t\n537\t  // M4: Ascension animation overlay\n538\t  private renderAscensionOverlay(now: number): void {\n539\t    const ctx = this.renderer.ctx;\n540\t    const w = this.canvas.getBoundingClientRect().width;\n541\t    const h = this.canvas.getBoundingClientRect().height;\n542\t\n543\t    const elapsed = now - this.ascensionAnim.startTime;\n544\t    const progress = Math.min(1, elapsed / this.ascensionAnim.duration);\n545\t\n546\t    // Golden-white gradient overlay\n547\t    let alpha = 0;\n548\t    if (progress < 0.15) alpha = progress / 0.15;\n549\t    else if (progress > 0.85) alpha = (1 - progress) / 0.15;\n550\t    else alpha = 1;\n551\t\n552\t    ctx.fillStyle = `rgba(255, 255, 200, ${alpha * 0.2})`;\n553\t    ctx.fillRect(0, 0, w, h);\n554\t\n555\t    // Radiating lines\n556\t    const centerX = w / 2;\n557\t    const centerY = h / 2;\n558\t    const lineCount = 12;\n559\t    for (let i = 0; i < lineCount; i++) {\n560\t      const angle = (i / lineCount) * Math.PI * 2 + progress * Math.PI;\n561\t      const len = 200 + Math.sin(progress * Math.PI * 6 + i) * 100;\n562\t      ctx.strokeStyle = `rgba(255, 215, 0, ${alpha * 0.3})`;\n563\t      ctx.lineWidth = 2;\n564\t      ctx.beginPath();\n565\t      ctx.moveTo(centerX, centerY);\n566\t      ctx.lineTo(centerX + Math.cos(angle) * len, centerY + Math.sin(angle) * len);\n567\t      ctx.stroke();\n568\t    }\n569\t\n570\t    ctx.fillStyle = `rgba(255, 215, 0, ${alpha})`;\n571\t    ctx.font = `bold ${28 + Math.sin(progress * Math.PI * 3) * 6}px serif`;\n572\t    ctx.textAlign = 'center';\n573\t    ctx.textBaseline = 'middle';\n574\t    ctx.fillText('🌟 飞升成功 🌟', w / 2, h / 2 - 30);\n575\t\n576\t    ctx.font = '18px serif';\n577\t    ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;\n578\t    ctx.fillText('飞升仙尊 — 全局效率×10', w / 2, h / 2 + 15);\n579\t\n580\t    ctx.font = '14px serif';\n581\t    ctx.fillStyle = `rgba(200, 200, 255, ${alpha})`;\n582\t    ctx.fillText('恭喜完成飞升挑战！', w / 2, h / 2 + 50);\n583\t\n584\t    if (progress >= 1) {\n585\t      this.ascensionAnim.active = false;\n586\t    }\n587\t  }\n588\t\n589\t  placeCurrentBuilding(): boolean {\n590\t    if (!this.placementMode) return false;\n591\t\n592\t    const def = this.placementMode;\n593\t    const { gx, gy } = this.placementPos;\n594\t\n595\t    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n596\t    if (!canPlace(this.map, def, gx, gy, buildings)) return false;\n597\t    if (!canAfford(this.state.resources, def.cost)) return false;\n598\t\n599\t    this.state = deductCost(this.state, def.cost);\n600\t\n601\t    // Handle conveyor/puppet placement\n602\t    if (def.category === 'transport' && (def.id === 'conveyor_lv1' || def.id === 'conveyor_lv2')) {\n603\t      const seg = createSegment(\n604\t        `seg_${Date.now()}_${Math.random().toString(36).slice(2)}`,\n605\t        gx, gy,\n606\t        def.id === 'conveyor_lv1' ? 1 : 2,\n607\t        'right',\n608\t      );\n609\t      const segMap = buildSegmentMap(this.conveyorSegments);\n610\t      this.conveyorSegments.push(autoConnect(seg, segMap));\n611\t      audioManager.playBuild();\n612\t      this.addNotification(`放置了 ${def.name}`, 'success');\n613\t      this.onStateChange?.(this.state);\n614\t      return true;\n615\t    }\n616\t\n617\t    if (def.category === 'automation' && def.id === 'puppet_sorter') {\n618\t      const puppet = createPuppet(\n619\t        `pup_${Date.now()}_${Math.random().toString(36).slice(2)}`,\n620\t        gx, gy, 1,\n621\t      );\n622\t      this.puppets.push(puppet);\n623\t      audioManager.playBuild();\n624\t      this.addNotification(`放置了 ${def.name}`, 'success');\n625\t      this.onStateChange?.(this.state);\n626\t      return true;\n627\t    }\n628\t\n629\t    const instance = createBuildingInstance(def.id, gx, gy);\n630\t    this.state = placeBuilding(this.state, this.currentRegionIndex, instance);\n631\t\n632\t    audioManager.playBuild();\n633\t    this.addNotification(`建造了 ${def.name}`, 'success');\n634\t    this.onStateChange?.(this.state);\n635\t    return true;\n636\t  }\n637\t\n638\t  private handleBuildingClick(building: BuildingInstance): void {\n639\t    const def = this.buildingDefs.get(building.buildingId);\n640\t    if (!def) return;\n641\t\n642\t    if (def.production.mode === 'manual') {\n643\t      if (def.category === 'farming') {\n644\t        if (!building.isProducing && building.progress < 1) {\n645\t          this.state = plantField(this.state, building, this.currentRegionIndex);\n646\t          audioManager.playCollect();\n647\t        } else if (building.progress >= 1) {\n648\t          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n649\t          audioManager.playHarvest();\n650\t          this.addNotification(`收获 ${def.production.amount} ${this.getResourceName(def.production.resource)}`, 'success');\n651\t        }\n652\t      } else if (def.category === 'mining') {\n653\t        this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n654\t        audioManager.playCollect();\n655\t      } else if (def.category === 'alchemy') {\n656\t        if (building.progress >= 1) {\n657\t          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n658\t          audioManager.playAlchemyComplete();\n659\t          this.addNotification(`获得 ${def.production.amount} ${this.getResourceName(def.production.resource)}`, 'success');\n660\t        } else if (!building.isProducing) {\n661\t          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n662\t          audioManager.playAlchemyStart();\n663\t        }\n664\t      } else if (def.category === 'cultivation') {\n665\t        if (!building.isProducing) {\n666\t          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n667\t        }\n668\t      }\n669\t      this.onStateChange?.(this.state);\n670\t    }\n671\t\n672\t    this.onBuildingSelect?.(building);\n673\t  }\n674\t\n675\t  usePillAction(pillId: string): boolean {\n676\t    const result = usePill(pillId, this.state.resources);\n677\t    if (!result) return false;\n678\t\n679\t    this.state.resources = result.resources as Resources;\n680\t    this.state.cultivation = addCultivationExp(this.state.cultivation, result.cultivation);\n681\t    this.state = this.addCultivationToRealm(result.cultivation);\n682\t\n683\t    audioManager.playUsePill();\n684\t    const pillName = this.getResourceName(pillId);\n685\t    this.addNotification(`服用 ${pillName}，修为+${result.cultivation}`, 'success');\n686\t    this.onStateChange?.(this.state);\n687\t    return true;\n688\t  }\n689\t\n690\t  useAllPills(pillId: string): boolean {\n691\t    const count = this.state.resources[pillId as keyof typeof this.state.resources] ?? 0;\n692\t    if (count <= 0) return false;\n693\t\n694\t    const result = useMultiplePills(pillId, count, this.state.resources);\n695\t    if (!result) return false;\n696\t\n697\t    this.state.resources = result.resources as Resources;\n698\t    this.state.cultivation = addCultivationExp(this.state.cultivation, result.cultivation);\n699\t    this.state = this.addCultivationToRealm(result.cultivation);\n700\t\n701\t    audioManager.playUsePill();\n702\t    this.addNotification(`服用 ${result.used} ${this.getResourceName(pillId)}，修为+${result.cultivation}`, 'success');\n703\t    this.onStateChange?.(this.state);\n704\t    return true;\n705\t  }\n706\t\n707\t  private addCultivationToRealm(amount: number): GameState {\n708\t    const next = cloneState(this.state);\n709\t    next.realm.exp += amount;\n710\t    while (next.realm.exp >= next.realm.expToNext) {\n711\t      next.realm.exp -= next.realm.expToNext;\n712\t      next.realm.level += 1;\n713\t      next.realm.expToNext = Math.floor(next.realm.expToNext * 1.8);\n714\t    }\n715\t    return next;\n716\t  }\n717\t\n718\t  attemptBreakthroughAction(): boolean {\n719\t    if (!canBreakthrough(this.state.cultivation)) {\n720\t      this.addNotification('修为不足，无法突破', 'warning');\n721\t      return false;\n722\t    }\n723\t\n724\t    const result = attemptBreakthrough(this.state.cultivation, this.state.resources);\n725\t    if (!result) {\n726\t      this.addNotification('材料不足，无法突破', 'warning');\n727\t      return false;\n728\t    }\n729\t\n730\t    this.state.cultivation = result.newState;\n731\t    this.state.resources = result.newResources as Resources;\n732\t\n733\t    if (result.result.success) {\n734\t      this.state.realm.realmId = result.newState.realmId;\n735\t      this.state.realm.level = result.newState.level;\n736\t      this.state.realm.exp = result.newState.exp;\n737\t      this.state.realm.expToNext = result.newState.expToNext;\n738\t    }\n739\t\n740\t    this.breakthroughAnim = {\n741\t      active: true,\n742\t      result: result.result,\n743\t      startTime: performance.now(),\n744\t      duration: 3000,\n745\t    };\n746\t\n747\t    if (result.result.success) {\n748\t      audioManager.playBreakthroughSuccess();\n749\t      this.addNotification(`突破成功！进入 ${getFullRealmName(this.state.cultivation)}`, 'success');\n750\t    } else {\n751\t      audioManager.playBreakthroughFail();\n752\t      this.addNotification(`突破失败，修为损失 ${Math.floor(result.result.penalty * 100)}%`, 'error');\n753\t    }\n754\t\n755\t    this.onBreakthroughAnim?.(true, result.result);\n756\t    this.onStateChange?.(this.state);\n757\t    return true;\n758\t  }\n759\t\n760\t  getBreakthroughInfo() {\n761\t    return getBreakthroughRequirements(this.state.cultivation);\n762\t  }\n763\t\n764\t  // === M4: Ascension Actions ===\n765\t\n766\t  getAscensionInfo() {\n767\t    return checkAscensionRequirements(this.state.resources, this.state.cultivation.totalCultivation);\n768\t  }\n769\t\n770\t  attemptAscensionAction(): boolean {\n771\t    const result = attemptAscension(this.state.resources, this.state.cultivation.totalCultivation);\n772\t    if (!result.success) {\n773\t      this.addNotification('飞升条件不满足', 'warning');\n774\t      return false;\n775\t    }\n776\t\n777\t    this.state.resources = result.newResources as Resources;\n778\t    this.state.ascensionCompleted = true;\n779\t\n780\t    this.ascensionAnim = {\n781\t      active: true,\n782\t      startTime: performance.now(),\n783\t      duration: 5000,\n784\t    };\n785\t\n786\t    audioManager.playBreakthroughSuccess();\n787\t    this.addNotification('🌟 飞升成功！获得称号：飞升仙尊', 'success');\n788\t    this.onStateChange?.(this.state);\n789\t    return true;\n790\t  }\n791\t\n792\t  // === M4: Cross-Region Link ===\n793\t\n794\t  createCrossRegionLinkAction(\n795\t    fromRegionIndex: number,\n796\t    fromX: number,\n797\t    fromY: number,\n798\t    toRegionIndex: number,\n799\t    toX: number,\n800\t    toY: number,\n801\t    resource: string,\n802\t    amount: number,\n803\t    interval: number,\n804\t  ): boolean {\n805\t    const id = `crl_${Date.now()}_${Math.random().toString(36).slice(2)}`;\n806\t    const link = createCrossRegionLink(id, fromRegionIndex, fromX, fromY, toRegionIndex, toX, toY, resource, amount, interval);\n807\t    this.state = addCrossRegionLink(this.state, link);\n808\t    this.addNotification(`建立跨区域传送链路`, 'success');\n809\t    this.onStateChange?.(this.state);\n810\t    return true;\n811\t  }\n812\t\n813\t  // === Alchemy Actions ===\n814\t\n815\t  getAvailableAlchemyRecipes(): AlchemyRecipe[] {\n816\t    return getAvailableRecipes((realm) => cultivationIsRealmUnlocked(realm, this.state.cultivation));\n817\t  }\n818\t\n819\t  startAlchemyAction(recipeId: string): boolean {\n820\t    const crafting = startCrafting(recipeId, this.state.resources);\n821\t    if (!crafting) return false;\n822\t\n823\t    this.state.resources = crafting.resources as Resources;\n824\t    this.state.alchemySession = crafting.session;\n825\t    audioManager.playAlchemyStart();\n826\t    this.addNotification(`开始炼丹`, 'info');\n827\t    this.onStateChange?.(this.state);\n828\t    this.onAlchemyUpdate?.(this.state.alchemySession);\n829\t    return true;\n830\t  }\n831\t\n832\t  collectAlchemyAction(): boolean {\n833\t    if (!this.state.alchemySession?.complete) return false;\n834\t\n835\t    const result = collectAlchemy(this.state.alchemySession, this.state.resources);\n836\t    if (!result) return false;\n837\t\n838\t    this.state.resources = result.resources as Resources;\n839\t    this.state.alchemySession = null;\n840\t\n841\t    if (result.success) {\n842\t      this.state.cultivation = addCultivationExp(this.state.cultivation, result.expReward);\n843\t      audioManager.playAlchemyComplete();\n844\t      this.addNotification(`炼丹成功！获得 ${result.amount} 颗丹药`, 'success');\n845\t    } else {\n846\t      audioManager.playAlchemyFail();\n847\t      this.addNotification('炼丹失败...', 'error');\n848\t    }\n849\t\n850\t    this.onStateChange?.(this.state);\n851\t    this.onAlchemyUpdate?.(null);\n852\t    return true;\n853\t  }\n854\t\n855\t  // === Notifications ===\n856\t\n857\t  addNotification(text: string, type: GameNotification['type'] = 'info'): void {\n858\t    const notif: GameNotification = {\n859\t      id: ++notifIdCounter,\n860\t      text,\n861\t      type,\n862\t      time: Date.now(),\n863\t    };\n864\t    this.notifications.push(notif);\n865\t    if (this.notifications.length > 10) {\n866\t      this.notifications = this.notifications.slice(-10);\n867\t    }\n868\t    this.onNotification?.(notif);\n869\t  }\n870\t\n871\t  // === Utility ===\n872\t\n873\t  private getResourceName(id: string): string {\n874\t    const names: Record<string, string> = {\n875\t      spirit_stone: '灵石',\n876\t      spirit_grass: '灵草',\n877\t      spirit_energy: '灵气',\n878\t      cultivation: '修为',\n879\t      pill_juling: '聚灵丹',\n880\t      pill_peiyuan: '培元丹',\n881\t      pill_ningqi: '凝气丹',\n882\t      pill_zhuji: '筑基丹',\n883\t      pill_jindanyin: '金丹引',\n884\t      pill_yuanyingguo: '元婴果',\n885\t      pill_huashenlu: '化神露',\n886\t      pill_jiuzhuan: '九转金丹',\n887\t      spirit_iron: '灵铁',\n888\t      spirit_wood: '灵木',\n889\t      talisman_paper: '符纸',\n890\t      monster_core: '妖丹',\n891\t      heaven_earth_liquid: '天地灵液',\n892\t      immortal_stone: '仙灵石',\n893\t      merit: '功德值',\n894\t    };\n895\t    return names[id] ?? id;\n896\t  }\n897\t\n898\t  centerCamera(): void {\n899\t    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);\n900\t  }\n901\t\n902\t  getAvailableBuildings(): BuildingDef[] {\n903\t    return Array.from(this.buildingDefs.values()).filter(def => {\n904\t      return cultivationIsRealmUnlocked(def.unlockRealm, this.state.cultivation);\n905\t    });\n906\t  }\n907\t\n908\t  getInventoryPills(): Array<PillDef & { count: number }> {\n909\t    const result: Array<PillDef & { count: number }> = [];\n910\t    for (const def of getAllPillDefs()) {\n911\t      const count = this.state.resources[def.id as keyof typeof this.state.resources] ?? 0;\n912\t      if (count > 0) {\n913\t        result.push({ ...def, count });\n914\t      }\n915\t    }\n916\t    return result;\n917\t  }\n918\t\n919\t  private setupInput(canvas: HTMLCanvasElement): void {\n920\t    canvas.addEventListener('mousemove', (e) => {\n921\t      const rect = canvas.getBoundingClientRect();\n922\t      const mx = e.clientX - rect.left;\n923\t      const my = e.clientY - rect.top;\n924\t\n925\t      const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n926\t      this.hoveredCell = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n927\t\n928\t      if (this.placementMode && this.hoveredCell) {\n929\t        this.placementPos = { gx: this.hoveredCell.gx, gy: this.hoveredCell.gy };\n930\t        const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n931\t        this.placementValid = canPlace(\n932\t          this.map,\n933\t          this.placementMode,\n934\t          this.placementPos.gx,\n935\t          this.placementPos.gy,\n936\t          buildings,\n937\t        );\n938\t      }\n939\t    });\n940\t\n941\t    canvas.addEventListener('mousedown', (e) => {\n942\t      if (e.button !== 0) return;\n943\t      this.clickStartTime = performance.now();\n944\t      this.clickStartPos = { x: e.clientX, y: e.clientY };\n945\t    });\n946\t\n947\t    canvas.addEventListener('mouseup', (e) => {\n948\t      if (e.button !== 0) return;\n949\t      const dt = performance.now() - this.clickStartTime;\n950\t      const dx = Math.abs(e.clientX - this.clickStartPos.x);\n951\t      const dy = Math.abs(e.clientY - this.clickStartPos.y);\n952\t\n953\t      if (dt < 300 && dx < 5 && dy < 5) {\n954\t        audioManager.init();\n955\t        audioManager.resume();\n956\t        this.handleClick(e);\n957\t      }\n958\t    });\n959\t\n960\t    document.addEventListener('keydown', (e) => {\n961\t      if (e.key === 'Escape') {\n962\t        this.placementMode = null;\n963\t      }\n964\t    });\n965\t  }\n966\t\n967\t  private handleClick(e: MouseEvent): void {\n968\t    const rect = this.canvas.getBoundingClientRect();\n969\t    const mx = e.clientX - rect.left;\n970\t    const my = e.clientY - rect.top;\n971\t    const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n972\t    const { gx, gy } = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n973\t\n974\t    if (!this.map.inBounds(gx, gy)) return;\n975\t\n976\t    if (this.placementMode) {\n977\t      this.placementPos = { gx, gy };\n978\t      const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n979\t      this.placementValid = canPlace(this.map, this.placementMode, gx, gy, buildings);\n980\t      if (this.placementValid) {\n981\t        this.placeCurrentBuilding();\n982\t      }\n983\t      return;\n984\t    }\n985\t\n986\t    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n987\t    const clicked = buildings.find(b => {\n988\t      const def = this.buildingDefs.get(b.buildingId);\n989\t      if (!def) return false;\n990\t      return (\n991\t        gx >= b.gridX && gx < b.gridX + def.size.w &&\n992\t        gy >= b.gridY && gy < b.gridY + def.size.h\n993\t      );\n994\t    });\n995\t\n996\t    if (clicked) {\n997\t      this.handleBuildingClick(clicked);\n998\t    }\n999\t  }\n1000\t}\n1001\t"}]},"parent_tool_use_id":null,"session_id":"93695823-6434-4d3f-8f7c-d2b2fb5d45a1","uuid":"f3a21b62-0f94-432c-9d74-cd554de6fca5","timestamp":"2026-05-23T03:36:41.858Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\renderer\\App.ts","content":"// App.ts — Game main loop (v0.4.0 — M4: 元婴+化神, 跨区域传送, 高级丹方, 终局内容)\n\nimport { Renderer } from './Renderer';\nimport { GameMap } from '../game/Map';\nimport {\n  type GameState,\n  type BuildingInstance,\n  type AlchemySessionData,\n  type GameMap as GameMapData,\n  type CrossRegionLink,\n  createInitialState,\n  cloneState,\n  setMap,\n  placeBuilding,\n  loadGame,\n  saveGame,\n  startAutoSave,\n  stopAutoSave,\n  addAchievement,\n  addCrossRegionLink,\n} from '../game/GameState';\nimport {\n  type BuildingDef,\n  loadBuildingDefs,\n  createBuildingInstance,\n  canPlace,\n} from '../game/Building';\nimport {\n  collectFromBuilding,\n  plantField,\n  tickAutoProduction,\n  tickManualProduction,\n  canAfford,\n  deductCost,\n} from '../game/Resources';\nimport {\n  type CultivationState,\n  type BreakthroughResult,\n  addCultivationExp,\n  canBreakthrough,\n  attemptBreakthrough,\n  getBreakthroughRequirements,\n  getFullRealmName,\n  isRealmUnlocked as cultivationIsRealmUnlocked,\n  tickAutoCultivation,\n} from '../game/Cultivation';\nimport {\n  type AlchemyRecipe,\n  getAvailableRecipes,\n  canCraft,\n  startCrafting,\n  tickAlchemy,\n  collectAlchemy,\n  getRemainingTime,\n} from '../game/Alchemy';\nimport {\n  usePill,\n  useMultiplePills,\n  getAllPillDefs,\n  type PillDef,\n} from '../game/Inventory';\nimport { audioManager } from '../game/AudioManager';\nimport { getAllAchievements, checkAchievement, type AchievementContext } from '../game/Achievement';\nimport { getAscensionChallenge, checkAscensionRequirements, attemptAscension } from '../game/Ascension';\nimport { tickCrossRegionLinks, createCrossRegionLink, renderCrossRegionPortal } from '../game/CrossRegionTeleport';\nimport { processTalismans, renderTalisman, type TalismanInstance } from '../game/Talisman';\nimport type { Resources } from '../game/GameState';\nimport buildingData from '../data/buildings.json';\nimport regionData from '../data/regions.json';\nimport {\n  type ConveyorSegment,\n  type ConveyorItem,\n  createSegment,\n  buildSegmentMap,\n  autoConnect,\n  tickConveyorItems,\n  renderConveyorSegment,\n  renderConveyorItems,\n} from '../game/ConveyorBelt';\nimport {\n  type PuppetInstance,\n  createPuppet,\n  tickPuppet,\n  renderPuppet,\n} from '../game/Puppet';\n\nexport type PlacementMode = BuildingDef | null;\n\nexport interface GameNotification {\n  id: number;\n  text: string;\n  type: 'info' | 'success' | 'warning' | 'error';\n  time: number;\n}\n\ninterface RegionDef {\n  id: string;\n  name: string;\n  nameEn: string;\n  width: number;\n  height: number;\n  unlockRealm: string;\n  maxBuildings: number;\n  specialResources: string[];\n  terrainBase: string;\n  color: { bg: string; grid: string };\n}\n\nlet notifIdCounter = 0;\n\nexport class App {\n  canvas: HTMLCanvasElement;\n  renderer: Renderer;\n  state: GameState;\n  buildingDefs: Map<string, BuildingDef>;\n  regionDefs: RegionDef[];\n  map: GameMap;\n  currentRegionIndex = 0;\n\n  conveyorSegments: ConveyorSegment[] = [];\n  conveyorItems: ConveyorItem[] = [];\n  puppets: PuppetInstance[] = [];\n  talismans: TalismanInstance[] = [];\n\n  private running = false;\n  private lastFrameTime = 0;\n  private animFrameId = 0;\n  private lastTickTime = 0;\n  private tickInterval = 200;\n\n  private hoveredCell: { gx: number; gy: number } | null = null;\n  private clickStartTime = 0;\n  private clickStartPos = { x: 0, y: 0 };\n  placementMode: PlacementMode = null;\n  private placementValid = false;\n  private placementPos = { gx: 0, gy: 0 };\n\n  breakthroughAnim: { active: boolean; result: BreakthroughResult | null; startTime: number; duration: number } = {\n    active: false,\n    result: null,\n    startTime: 0,\n    duration: 3000,\n  };\n\n  notifications: GameNotification[] = [];\n\n  // M4: Ascension animation\n  ascensionAnim: { active: boolean; startTime: number; duration: number } = {\n    active: false,\n    startTime: 0,\n    duration: 5000,\n  };\n\n  onStateChange?: (state: GameState) => void;\n  onBuildingSelect?: (building: BuildingInstance | null) => void;\n  onNotification?: (notif: GameNotification) => void;\n  onBreakthroughAnim?: (active: boolean, result: BreakthroughResult | null) => void;\n  onAlchemyUpdate?: (session: AlchemySessionData | null) => void;\n  onRegionChange?: (regionIndex: number, region: RegionDef) => void;\n  onAchievementUnlocked?: (achievementId: string) => void;\n\n  constructor(canvas: HTMLCanvasElement) {\n    this.canvas = canvas;\n    this.renderer = new Renderer(canvas);\n\n    const saved = loadGame();\n    this.state = saved ? saved : createInitialState();\n\n    this.buildingDefs = loadBuildingDefs(buildingData as unknown as { buildings: BuildingDef[] });\n    this.regionDefs = (regionData as { regions: RegionDef[] }).regions;\n\n    this.map = new GameMap(20, 15, '#2a3a1a', '#3a4a2a');\n    this.map.generateStartingArea();\n\n    if (this.state.maps.length === 0) {\n      this.state = setMap(this.state, 0, {\n        regionId: 'liqi_flat',\n        width: 20,\n        height: 15,\n        terrain: this.map.terrain,\n        buildings: [],\n      });\n    } else {\n      const mapData = this.state.maps[this.state.currentRegionIndex];\n      if (mapData) {\n        this.currentRegionIndex = this.state.currentRegionIndex;\n        this.loadRegionMap(this.currentRegionIndex);\n      }\n    }\n\n    this.setupInput(canvas);\n\n    window.addEventListener('resize', () => {\n      this.renderer.resize();\n    });\n  }\n\n  private loadRegionMap(index: number): void {\n    const mapData = this.state.maps[index];\n    if (!mapData) return;\n\n    const regionDef = this.regionDefs.find(r => r.id === mapData.regionId);\n    const bg = regionDef?.color.bg ?? '#2a3a1a';\n    const grid = regionDef?.color.grid ?? '#3a4a2a';\n\n    this.map = new GameMap(mapData.width, mapData.height, bg, grid);\n    this.map.terrain = mapData.terrain;\n    this.currentRegionIndex = index;\n  }\n\n  initRegion(regionDef: RegionDef): number {\n    const existing = this.state.maps.findIndex(m => m.regionId === regionDef.id);\n    if (existing >= 0) return existing;\n\n    const newMap = new GameMap(regionDef.width, regionDef.height, regionDef.color.bg, regionDef.color.grid);\n    newMap.generateRegionTerrain(regionDef.id);\n\n    const index = this.state.maps.length;\n    this.state = setMap(this.state, index, {\n      regionId: regionDef.id,\n      width: regionDef.width,\n      height: regionDef.height,\n      terrain: newMap.terrain,\n      buildings: [],\n    });\n\n    return index;\n  }\n\n  switchRegion(index: number): boolean {\n    if (index < 0 || index >= this.state.maps.length) return false;\n    if (index === this.currentRegionIndex) return false;\n\n    this.currentRegionIndex = index;\n    this.state.currentRegionIndex = index;\n    this.loadRegionMap(index);\n\n    const regionDef = this.regionDefs.find(r => r.id === this.state.maps[index]?.regionId);\n    if (regionDef) {\n      this.onRegionChange?.(index, regionDef);\n    }\n\n    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  getUnlockedRegions(): Array<RegionDef & { index: number }> {\n    return this.regionDefs\n      .map((r) => {\n        if (cultivationIsRealmUnlocked(r.unlockRealm, this.state.cultivation)) {\n          const mapIndex = this.state.maps.findIndex(m => m.regionId === r.id);\n          if (mapIndex < 0) {\n            this.initRegion(r);\n          }\n          const actualIndex = Math.max(0, this.state.maps.findIndex(m => m.regionId === r.id));\n          return { ...r, index: actualIndex };\n        }\n        return null;\n      })\n      .filter((r): r is RegionDef & { index: number } => r !== null);\n  }\n\n  start(): void {\n    if (this.running) return;\n    this.running = true;\n    this.lastFrameTime = performance.now();\n    this.lastTickTime = this.lastFrameTime;\n\n    // Restore persisted conveyors/puppets/talismans\n    if (this.state.savedConveyors?.length) {\n      this.conveyorSegments = this.state.savedConveyors;\n    }\n    if (this.state.savedPuppets?.length) {\n      this.puppets = this.state.savedPuppets;\n    }\n    if (this.state.savedTalismans?.length) {\n      this.talismans = this.state.savedTalismans;\n    }\n\n    this.loop(this.lastFrameTime);\n\n    startAutoSave(() => this.getSaveableState());\n  }\n\n  private getSaveableState(): GameState {\n    const state = cloneState(this.state);\n    state.savedConveyors = this.conveyorSegments;\n    state.savedPuppets = this.puppets;\n    state.savedTalismans = this.talismans;\n    return state;\n  }\n\n  stop(): void {\n    this.running = false;\n    if (this.animFrameId) {\n      cancelAnimationFrame(this.animFrameId);\n    }\n    stopAutoSave();\n    saveGame(this.getSaveableState());\n  }\n\n  private loop = (now: number): void => {\n    if (!this.running) return;\n\n    const dt = now - this.lastFrameTime;\n    this.lastFrameTime = now;\n\n    this.state.totalPlaytime += dt / 1000;\n\n    if (now - this.lastTickTime >= this.tickInterval) {\n      this.tickProduction(now);\n      this.lastTickTime = now;\n    }\n\n    this.render(now);\n\n    this.animFrameId = requestAnimationFrame(this.loop);\n  };\n\n  private tickProduction(now: number): void {\n    this.state = tickAutoProduction(this.state, this.currentRegionIndex, now, this.buildingDefs);\n    this.state = tickManualProduction(this.state, this.currentRegionIndex, now, this.buildingDefs);\n\n    this.state.cultivation = tickAutoCultivation(this.state.cultivation, this.tickInterval);\n\n    if (this.state.alchemySession) {\n      this.state.alchemySession = tickAlchemy(this.state.alchemySession, now);\n      this.onAlchemyUpdate?.(this.state.alchemySession);\n    }\n\n    // M3: Conveyor items tick\n    if (this.conveyorSegments.length > 0) {\n      const segMap = buildSegmentMap(this.conveyorSegments);\n      const result = tickConveyorItems(this.conveyorItems, segMap, this.tickInterval);\n      this.conveyorItems = result.items;\n\n      for (const d of result.delivered) {\n        const delta: Partial<Resources> = {};\n        (delta as Record<string, number>)[d.resource] = d.amount;\n        this.state = { ...this.state, resources: { ...this.state.resources, [d.resource]: (this.state.resources[d.resource] ?? 0) + d.amount } };\n      }\n    }\n\n    // M3: Puppet tick\n    for (let i = 0; i < this.puppets.length; i++) {\n      this.puppets[i] = tickPuppet(this.puppets[i], this.tickInterval);\n    }\n\n    // M4: Cross-region teleport tick\n    if (this.state.crossRegionLinks.length > 0) {\n      const crResult = tickCrossRegionLinks(this.state.crossRegionLinks, this.state.resources, now);\n      this.state.crossRegionLinks = crResult.links;\n\n      for (const t of crResult.transferred) {\n        this.state = { ...this.state, resources: { ...this.state.resources, [t.resource]: (this.state.resources[t.resource] ?? 0) + t.amount } };\n      }\n    }\n\n    // M4: Achievement check (every 5 seconds)\n    if (Math.floor(now / 5000) !== Math.floor((now - this.tickInterval) / 5000)) {\n      this.checkAchievements();\n    }\n\n    // Talisman processing\n    if (this.talismans.length > 0) {\n      const buildingCounts: Record<string, number> = {};\n      for (const map of this.state.maps) {\n        for (const b of map.buildings) {\n          buildingCounts[b.buildingId] = (buildingCounts[b.buildingId] ?? 0) + 1;\n        }\n      }\n      const talResult = processTalismans(\n        this.talismans,\n        this.state.resources,\n        buildingCounts,\n        this.state.realm.level,\n        now,\n      );\n      this.talismans = talResult.talismans;\n      for (const action of talResult.actions) {\n        if (action.type === 'notify') {\n          this.addNotification(action.message, 'info');\n        } else if (action.type === 'stop_building') {\n          const bld = this.state.maps[this.currentRegionIndex]?.buildings.find(b => b.uid === action.buildingUid);\n          if (bld) bld.isProducing = false;\n        } else if (action.type === 'start_building') {\n          const bld = this.state.maps[this.currentRegionIndex]?.buildings.find(b => b.uid === action.buildingUid);\n          if (bld) bld.isProducing = true;\n        }\n      }\n    }\n\n    this.onStateChange?.(this.state);\n  }\n\n  // M4: Achievement checking\n  private checkAchievements(): void {\n    const buildingCounts: Record<string, number> = {};\n    let totalBuildingCount = 0;\n    for (const map of this.state.maps) {\n      for (const b of map.buildings) {\n        buildingCounts[b.buildingId] = (buildingCounts[b.buildingId] ?? 0) + 1;\n        totalBuildingCount++;\n      }\n    }\n\n    const unlockedRegions = this.regionDefs\n      .filter(r => cultivationIsRealmUnlocked(r.unlockRealm, this.state.cultivation))\n      .map(r => r.id);\n\n    const context: AchievementContext = {\n      currentRealmId: this.state.cultivation.realmId,\n      realmOrder: ['fanren', 'liqi', 'zhuji', 'jindan', 'yuanying', 'huashen'],\n      totalResourcesCollected: this.state.totalCollected as Record<string, number>,\n      buildingCounts,\n      totalBuildingCount,\n      pillsCrafted: {},\n      totalPillsCrafted: 0,\n      allPillTypesCrafted: false,\n      unlockedRegions,\n      ascensionCompleted: this.state.ascensionCompleted,\n      playtimeHours: this.state.totalPlaytime / 3600,\n      crossRegionLinkCount: this.state.crossRegionLinks.length,\n    };\n\n    for (const ach of getAllAchievements()) {\n      if (this.state.achievements.includes(ach.id)) continue;\n      if (checkAchievement(ach, context)) {\n        this.state = addAchievement(this.state, ach.id);\n        this.addNotification(`🏆 成就解锁: ${ach.name}`, 'success');\n        this.onAchievementUnlocked?.(ach.id);\n      }\n    }\n  }\n\n  private render(now: number): void {\n    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n    const preview = this.placementMode\n      ? { def: this.placementMode, gx: this.placementPos.gx, gy: this.placementPos.gy, valid: this.placementValid }\n      : null;\n\n    this.renderer.render(\n      this.map,\n      buildings,\n      this.buildingDefs,\n      this.state.resources,\n      this.state.realm,\n      this.state.cultivation,\n      this.hoveredCell,\n      preview,\n      now,\n    );\n\n    const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n    const segMap = buildSegmentMap(this.conveyorSegments);\n    for (const seg of this.conveyorSegments) {\n      renderConveyorSegment(this.renderer.ctx, seg, offsetX, offsetY, scale, this.map.cellSize, now);\n    }\n    renderConveyorItems(this.renderer.ctx, this.conveyorItems, segMap, offsetX, offsetY, scale, this.map.cellSize);\n\n    for (const puppet of this.puppets) {\n      renderPuppet(this.renderer.ctx, puppet, offsetX, offsetY, scale, this.map.cellSize, now);\n    }\n\n    for (const talisman of this.talismans) {\n      renderTalisman(this.renderer.ctx, talisman, offsetX, offsetY, scale, this.map.cellSize, now);\n    }\n\n    // M4: Render cross-region portals in current map\n    for (const link of this.state.crossRegionLinks) {\n      if (link.fromRegionIndex === this.currentRegionIndex) {\n        renderCrossRegionPortal(this.renderer.ctx, link.fromX, link.fromY, offsetX, offsetY, scale, this.map.cellSize, now);\n      }\n    }\n\n    if (this.breakthroughAnim.active) {\n      this.renderBreakthroughOverlay(now);\n    }\n\n    if (this.ascensionAnim.active) {\n      this.renderAscensionOverlay(now);\n    }\n  }\n\n  private renderBreakthroughOverlay(now: number): void {\n    const ctx = this.renderer.ctx;\n    const w = this.canvas.getBoundingClientRect().width;\n    const h = this.canvas.getBoundingClientRect().height;\n\n    const elapsed = now - this.breakthroughAnim.startTime;\n    const progress = Math.min(1, elapsed / this.breakthroughAnim.duration);\n\n    let alpha = 0;\n    if (progress < 0.2) alpha = progress / 0.2;\n    else if (progress > 0.8) alpha = (1 - progress) / 0.2;\n    else alpha = 1;\n\n    const result = this.breakthroughAnim.result;\n\n    if (result?.success) {\n      ctx.fillStyle = `rgba(255, 215, 0, ${alpha * 0.15})`;\n      ctx.fillRect(0, 0, w, h);\n\n      ctx.fillStyle = `rgba(255, 215, 0, ${alpha})`;\n      ctx.font = `bold ${24 + Math.sin(progress * Math.PI * 4) * 4}px serif`;\n      ctx.textAlign = 'center';\n      ctx.textBaseline = 'middle';\n      ctx.fillText('⚡ 境界突破成功 ⚡', w / 2, h / 2 - 20);\n\n      ctx.font = '16px serif';\n      ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;\n      const realmName = getFullRealmName(this.state.cultivation);\n      ctx.fillText(`进入 ${realmName}`, w / 2, h / 2 + 20);\n    } else if (result) {\n      ctx.fillStyle = `rgba(200, 50, 50, ${alpha * 0.15})`;\n      ctx.fillRect(0, 0, w, h);\n\n      ctx.fillStyle = `rgba(255, 100, 100, ${alpha})`;\n      ctx.font = 'bold 24px serif';\n      ctx.textAlign = 'center';\n      ctx.textBaseline = 'middle';\n      ctx.fillText('突破失败...', w / 2, h / 2 - 20);\n\n      ctx.font = '14px serif';\n      ctx.fillStyle = `rgba(255, 200, 200, ${alpha})`;\n      ctx.fillText(`修为损失 ${Math.floor(result.penalty * 100)}%`, w / 2, h / 2 + 20);\n    }\n\n    if (progress >= 1) {\n      this.breakthroughAnim.active = false;\n      this.breakthroughAnim.result = null;\n      this.onBreakthroughAnim?.(false, null);\n    }\n  }\n\n  // M4: Ascension animation overlay\n  private renderAscensionOverlay(now: number): void {\n    const ctx = this.renderer.ctx;\n    const w = this.canvas.getBoundingClientRect().width;\n    const h = this.canvas.getBoundingClientRect().height;\n\n    const elapsed = now - this.ascensionAnim.startTime;\n    const progress = Math.min(1, elapsed / this.ascensionAnim.duration);\n\n    // Golden-white gradient overlay\n    let alpha = 0;\n    if (progress < 0.15) alpha = progress / 0.15;\n    else if (progress > 0.85) alpha = (1 - progress) / 0.15;\n    else alpha = 1;\n\n    ctx.fillStyle = `rgba(255, 255, 200, ${alpha * 0.2})`;\n    ctx.fillRect(0, 0, w, h);\n\n    // Radiating lines\n    const centerX = w / 2;\n    const centerY = h / 2;\n    const lineCount = 12;\n    for (let i = 0; i < lineCount; i++) {\n      const angle = (i / lineCount) * Math.PI * 2 + progress * Math.PI;\n      const len = 200 + Math.sin(progress * Math.PI * 6 + i) * 100;\n      ctx.strokeStyle = `rgba(255, 215, 0, ${alpha * 0.3})`;\n      ctx.lineWidth = 2;\n      ctx.beginPath();\n      ctx.moveTo(centerX, centerY);\n      ctx.lineTo(centerX + Math.cos(angle) * len, centerY + Math.sin(angle) * len);\n      ctx.stroke();\n    }\n\n    ctx.fillStyle = `rgba(255, 215, 0, ${alpha})`;\n    ctx.font = `bold ${28 + Math.sin(progress * Math.PI * 3) * 6}px serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText('🌟 飞升成功 🌟', w / 2, h / 2 - 30);\n\n    ctx.font = '18px serif';\n    ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;\n    ctx.fillText('飞升仙尊 — 全局效率×10', w / 2, h / 2 + 15);\n\n    ctx.font = '14px serif';\n    ctx.fillStyle = `rgba(200, 200, 255, ${alpha})`;\n    ctx.fillText('恭喜完成飞升挑战！', w / 2, h / 2 + 50);\n\n    if (progress >= 1) {\n      this.ascensionAnim.active = false;\n    }\n  }\n\n  placeCurrentBuilding(): boolean {\n    if (!this.placementMode) return false;\n\n    const def = this.placementMode;\n    const { gx, gy } = this.placementPos;\n\n    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n    if (!canPlace(this.map, def, gx, gy, buildings)) return false;\n    if (!canAfford(this.state.resources, def.cost)) return false;\n\n    this.state = deductCost(this.state, def.cost);\n\n    // Handle conveyor/puppet placement\n    if (def.category === 'transport' && (def.id === 'conveyor_lv1' || def.id === 'conveyor_lv2')) {\n      const seg = createSegment(\n        `seg_${Date.now()}_${Math.random().toString(36).slice(2)}`,\n        gx, gy,\n        def.id === 'conveyor_lv1' ? 1 : 2,\n        'right',\n      );\n      const segMap = buildSegmentMap(this.conveyorSegments);\n      this.conveyorSegments.push(autoConnect(seg, segMap));\n      audioManager.playBuild();\n      this.addNotification(`放置了 ${def.name}`, 'success');\n      this.onStateChange?.(this.state);\n      return true;\n    }\n\n    if (def.category === 'automation' && def.id === 'puppet_sorter') {\n      const puppet = createPuppet(\n        `pup_${Date.now()}_${Math.random().toString(36).slice(2)}`,\n        gx, gy, 1,\n      );\n      this.puppets.push(puppet);\n      audioManager.playBuild();\n      this.addNotification(`放置了 ${def.name}`, 'success');\n      this.onStateChange?.(this.state);\n      return true;\n    }\n\n    const instance = createBuildingInstance(def.id, gx, gy);\n    this.state = placeBuilding(this.state, this.currentRegionIndex, instance);\n\n    audioManager.playBuild();\n    this.addNotification(`建造了 ${def.name}`, 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  private handleBuildingClick(building: BuildingInstance): void {\n    const def = this.buildingDefs.get(building.buildingId);\n    if (!def) return;\n\n    if (def.production.mode === 'manual') {\n      if (def.category === 'farming') {\n        if (!building.isProducing && building.progress < 1) {\n          this.state = plantField(this.state, building, this.currentRegionIndex);\n          audioManager.playCollect();\n        } else if (building.progress >= 1) {\n          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n          audioManager.playHarvest();\n          this.addNotification(`收获 ${def.production.amount} ${this.getResourceName(def.production.resource)}`, 'success');\n        }\n      } else if (def.category === 'mining') {\n        this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n        audioManager.playCollect();\n      } else if (def.category === 'alchemy') {\n        if (building.progress >= 1) {\n          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n          audioManager.playAlchemyComplete();\n          this.addNotification(`获得 ${def.production.amount} ${this.getResourceName(def.production.resource)}`, 'success');\n        } else if (!building.isProducing) {\n          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n          audioManager.playAlchemyStart();\n        }\n      } else if (def.category === 'cultivation') {\n        if (!building.isProducing) {\n          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n        }\n      }\n      this.onStateChange?.(this.state);\n    }\n\n    this.onBuildingSelect?.(building);\n  }\n\n  usePillAction(pillId: string): boolean {\n    const result = usePill(pillId, this.state.resources);\n    if (!result) return false;\n\n    this.state.resources = result.resources as Resources;\n    this.state.cultivation = addCultivationExp(this.state.cultivation, result.cultivation);\n    this.state = this.addCultivationToRealm(result.cultivation);\n\n    audioManager.playUsePill();\n    const pillName = this.getResourceName(pillId);\n    this.addNotification(`服用 ${pillName}，修为+${result.cultivation}`, 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  useAllPills(pillId: string): boolean {\n    const count = this.state.resources[pillId as keyof typeof this.state.resources] ?? 0;\n    if (count <= 0) return false;\n\n    const result = useMultiplePills(pillId, count, this.state.resources);\n    if (!result) return false;\n\n    this.state.resources = result.resources as Resources;\n    this.state.cultivation = addCultivationExp(this.state.cultivation, result.cultivation);\n    this.state = this.addCultivationToRealm(result.cultivation);\n\n    audioManager.playUsePill();\n    this.addNotification(`服用 ${result.used} ${this.getResourceName(pillId)}，修为+${result.cultivation}`, 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  private addCultivationToRealm(amount: number): GameState {\n    const next = cloneState(this.state);\n    next.realm.exp += amount;\n    while (next.realm.exp >= next.realm.expToNext) {\n      next.realm.exp -= next.realm.expToNext;\n      next.realm.level += 1;\n      next.realm.expToNext = Math.floor(next.realm.expToNext * 1.8);\n    }\n    return next;\n  }\n\n  attemptBreakthroughAction(): boolean {\n    if (!canBreakthrough(this.state.cultivation)) {\n      this.addNotification('修为不足，无法突破', 'warning');\n      return false;\n    }\n\n    const result = attemptBreakthrough(this.state.cultivation, this.state.resources);\n    if (!result) {\n      this.addNotification('材料不足，无法突破', 'warning');\n      return false;\n    }\n\n    this.state.cultivation = result.newState;\n    this.state.resources = result.newResources as Resources;\n\n    if (result.result.success) {\n      this.state.realm.realmId = result.newState.realmId;\n      this.state.realm.level = result.newState.level;\n      this.state.realm.exp = result.newState.exp;\n      this.state.realm.expToNext = result.newState.expToNext;\n    }\n\n    this.breakthroughAnim = {\n      active: true,\n      result: result.result,\n      startTime: performance.now(),\n      duration: 3000,\n    };\n\n    if (result.result.success) {\n      audioManager.playBreakthroughSuccess();\n      this.addNotification(`突破成功！进入 ${getFullRealmName(this.state.cultivation)}`, 'success');\n    } else {\n      audioManager.playBreakthroughFail();\n      this.addNotification(`突破失败，修为损失 ${Math.floor(result.result.penalty * 100)}%`, 'error');\n    }\n\n    this.onBreakthroughAnim?.(true, result.result);\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  getBreakthroughInfo() {\n    return getBreakthroughRequirements(this.state.cultivation);\n  }\n\n  // === M4: Ascension Actions ===\n\n  getAscensionInfo() {\n    return checkAscensionRequirements(this.state.resources, this.state.cultivation.totalCultivation);\n  }\n\n  attemptAscensionAction(): boolean {\n    const result = attemptAscension(this.state.resources, this.state.cultivation.totalCultivation);\n    if (!result.success) {\n      this.addNotification('飞升条件不满足', 'warning');\n      return false;\n    }\n\n    this.state.resources = result.newResources as Resources;\n    this.state.ascensionCompleted = true;\n\n    this.ascensionAnim = {\n      active: true,\n      startTime: performance.now(),\n      duration: 5000,\n    };\n\n    audioManager.playBreakthroughSuccess();\n    this.addNotification('🌟 飞升成功！获得称号：飞升仙尊', 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  // === M4: Cross-Region Link ===\n\n  createCrossRegionLinkAction(\n    fromRegionIndex: number,\n    fromX: number,\n    fromY: number,\n    toRegionIndex: number,\n    toX: number,\n    toY: number,\n    resource: string,\n    amount: number,\n    interval: number,\n  ): boolean {\n    const id = `crl_${Date.now()}_${Math.random().toString(36).slice(2)}`;\n    const link = createCrossRegionLink(id, fromRegionIndex, fromX, fromY, toRegionIndex, toX, toY, resource, amount, interval);\n    this.state = addCrossRegionLink(this.state, link);\n    this.addNotification(`建立跨区域传送链路`, 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  // === Alchemy Actions ===\n\n  getAvailableAlchemyRecipes(): AlchemyRecipe[] {\n    return getAvailableRecipes((realm) => cultivationIsRealmUnlocked(realm, this.state.cultivation));\n  }\n\n  startAlchemyAction(recipeId: string): boolean {\n    const crafting = startCrafting(recipeId, this.state.resources);\n    if (!crafting) return false;\n\n    this.state.resources = crafting.resources as Resources;\n    this.state.alchemySession = crafting.session;\n    audioManager.playAlchemyStart();\n    this.addNotification(`开始炼丹`, 'info');\n    this.onStateChange?.(this.state);\n    this.onAlchemyUpdate?.(this.state.alchemySession);\n    return true;\n  }\n\n  collectAlchemyAction(): boolean {\n    if (!this.state.alchemySession?.complete) return false;\n\n    const result = collectAlchemy(this.state.alchemySession, this.state.resources);\n    if (!result) return false;\n\n    this.state.resources = result.resources as Resources;\n    this.state.alchemySession = null;\n\n    if (result.success) {\n      this.state.cultivation = addCultivationExp(this.state.cultivation, result.expReward);\n      audioManager.playAlchemyComplete();\n      this.addNotification(`炼丹成功！获得 ${result.amount} 颗丹药`, 'success');\n    } else {\n      audioManager.playAlchemyFail();\n      this.addNotification('炼丹失败...', 'error');\n    }\n\n    this.onStateChange?.(this.state);\n    this.onAlchemyUpdate?.(null);\n    return true;\n  }\n\n  // === Notifications ===\n\n  addNotification(text: string, type: GameNotification['type'] = 'info'): void {\n    const notif: GameNotification = {\n      id: ++notifIdCounter,\n      text,\n      type,\n      time: Date.now(),\n    };\n    this.notifications.push(notif);\n    if (this.notifications.length > 10) {\n      this.notifications = this.notifications.slice(-10);\n    }\n    this.onNotification?.(notif);\n  }\n\n  // === Utility ===\n\n  private getResourceName(id: string): string {\n    const names: Record<string, string> = {\n      spirit_stone: '灵石',\n      spirit_grass: '灵草',\n      spirit_energy: '灵气',\n      cultivation: '修为',\n      pill_juling: '聚灵丹',\n      pill_peiyuan: '培元丹',\n      pill_ningqi: '凝气丹',\n      pill_zhuji: '筑基丹',\n      pill_jindanyin: '金丹引',\n      pill_yuanyingguo: '元婴果',\n      pill_huashenlu: '化神露',\n      pill_jiuzhuan: '九转金丹',\n      spirit_iron: '灵铁',\n      spirit_wood: '灵木',\n      talisman_paper: '符纸',\n      monster_core: '妖丹',\n      heaven_earth_liquid: '天地灵液',\n      immortal_stone: '仙灵石',\n      merit: '功德值',\n    };\n    return names[id] ?? id;\n  }\n\n  centerCamera(): void {\n    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);\n  }\n\n  getAvailableBuildings(): BuildingDef[] {\n    return Array.from(this.buildingDefs.values()).filter(def => {\n      return cultivationIsRealmUnlocked(def.unlockRealm, this.state.cultivation);\n    });\n  }\n\n  getInventoryPills(): Array<PillDef & { count: number }> {\n    const result: Array<PillDef & { count: number }> = [];\n    for (const def of getAllPillDefs()) {\n      const count = this.state.resources[def.id as keyof typeof this.state.resources] ?? 0;\n      if (count > 0) {\n        result.push({ ...def, count });\n      }\n    }\n    return result;\n  }\n\n  private setupInput(canvas: HTMLCanvasElement): void {\n    canvas.addEventListener('mousemove', (e) => {\n      const rect = canvas.getBoundingClientRect();\n      const mx = e.clientX - rect.left;\n      const my = e.clientY - rect.top;\n\n      const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n      this.hoveredCell = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n\n      if (this.placementMode && this.hoveredCell) {\n        this.placementPos = { gx: this.hoveredCell.gx, gy: this.hoveredCell.gy };\n        const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n        this.placementValid = canPlace(\n          this.map,\n          this.placementMode,\n          this.placementPos.gx,\n          this.placementPos.gy,\n          buildings,\n        );\n      }\n    });\n\n    canvas.addEventListener('mousedown', (e) => {\n      if (e.button !== 0) return;\n      this.clickStartTime = performance.now();\n      this.clickStartPos = { x: e.clientX, y: e.clientY };\n    });\n\n    canvas.addEventListener('mouseup', (e) => {\n      if (e.button !== 0) return;\n      const dt = performance.now() - this.clickStartTime;\n      const dx = Math.abs(e.clientX - this.clickStartPos.x);\n      const dy = Math.abs(e.clientY - this.clickStartPos.y);\n\n      if (dt < 300 && dx < 5 && dy < 5) {\n        audioManager.init();\n        audioManager.resume();\n        this.handleClick(e);\n      }\n    });\n\n    document.addEventListener('keydown', (e) => {\n      if (e.key === 'Escape') {\n        this.placementMode = null;\n      }\n    });\n  }\n\n  private handleClick(e: MouseEvent): void {\n    const rect = this.canvas.getBoundingClientRect();\n    const mx = e.clientX - rect.left;\n    const my = e.clientY - rect.top;\n    const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n    const { gx, gy } = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n\n    if (!this.map.inBounds(gx, gy)) return;\n\n    if (this.placementMode) {\n      this.placementPos = { gx, gy };\n      const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n      this.placementValid = canPlace(this.map, this.placementMode, gx, gy, buildings);\n      if (this.placementValid) {\n        this.placeCurrentBuilding();\n      }\n      return;\n    }\n\n    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n    const clicked = buildings.find(b => {\n      const def = this.buildingDefs.get(b.buildingId);\n      if (!def) return false;\n      return (\n        gx >= b.gridX && gx < b.gridX + def.size.w &&\n        gy >= b.gridY && gy < b.gridY + def.size.h\n      );\n    });\n\n    if (clicked) {\n      this.handleBuildingClick(clicked);\n    }\n  }\n}\n","numLines":1001,"startLine":1,"totalLines":1001}}}
