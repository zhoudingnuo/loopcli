ect[i]);\n55\t\n56\t    return {\n57\t      action: isCorrect ? 'correct' : 'wrong',\n58\t      answer,\n59\t      correct,\n60\t      isCorrect,\n61\t      idiom: this.currentIdiom\n62\t    };\n63\t  }\n64\t\n65\t  getSlots() { return this.slots; }\n66\t  getFillCount() { return this.fillCount; }\n67\t\n68\t  reset() {\n69\t    this.slots = [null, null, null, null];\n70\t    this.fillCount = 0;\n71\t    this.currentIdiom = null;\n72\t  }\n73\t}\n74\t\n75\tif (typeof module !== 'undefined') module.exports = { Judge };\n76\t"}]},"parent_tool_use_id":null,"session_id":"3263718e-ff98-4b11-b648-a6d67321903d","uuid":"663c7bae-5bdd-438b-9b72-15b471c491c9","timestamp":"2026-05-23T00:17:00.609Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/src/js/Judge.js","content":"// Judge.js — Answer judgment logic\n\nclass Judge {\n  constructor() {\n    this.slots = [null, null, null, null];\n    this.fillCount = 0;\n    this.currentIdiom = null;\n  }\n\n  startQuestion(question) {\n    this.slots = [null, null, null, null];\n    this.fillCount = 0;\n    this.currentIdiom = question.idiom;\n    this.candidates = question.candidates;\n  }\n\n  placeChar(candidateIndex) {\n    if (this.fillCount >= 4) return { action: 'full', slot: -1 };\n    if (!this.candidates[candidateIndex] || this.candidates[candidateIndex].used) {\n      return { action: 'used', slot: -1 };\n    }\n\n    this.candidates[candidateIndex].used = true;\n    const char = this.candidates[candidateIndex].char;\n    this.slots[this.fillCount] = { char, candidateIndex };\n    this.fillCount++;\n\n    if (this.fillCount === 4) {\n      return this.checkAnswer();\n    }\n\n    return { action: 'placed', slot: this.fillCount - 1, char, fillCount: this.fillCount };\n  }\n\n  removeSlot(slotIndex) {\n    if (slotIndex < 0 || slotIndex >= this.fillCount) return { action: 'invalid' };\n    const removed = this.slots[slotIndex];\n    if (!removed) return { action: 'invalid' };\n\n    this.candidates[removed.candidateIndex].used = false;\n\n    for (let i = slotIndex; i < 3; i++) {\n      this.slots[i] = this.slots[i + 1];\n    }\n    this.slots[3] = null;\n    this.fillCount--;\n\n    return { action: 'removed', slotIndex, char: removed.char, fillCount: this.fillCount };\n  }\n\n  checkAnswer() {\n    const answer = this.slots.map(s => s ? s.char : '');\n    const correct = this.currentIdiom.chars;\n    const isCorrect = answer.every((c, i) => c === correct[i]);\n\n    return {\n      action: isCorrect ? 'correct' : 'wrong',\n      answer,\n      correct,\n      isCorrect,\n      idiom: this.currentIdiom\n    };\n  }\n\n  getSlots() { return this.slots; }\n  getFillCount() { return this.fillCount; }\n\n  reset() {\n    this.slots = [null, null, null, null];\n    this.fillCount = 0;\n    this.currentIdiom = null;\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Judge };\n","numLines":76,"startLine":1,"totalLines":76}}}
