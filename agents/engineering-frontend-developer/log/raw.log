equency:82},\n{id:\"e033\",idiom:\"鸡犬不宁\",chars:[\"鸡\",\"犬\",\"不\",\"宁\"],pinyin:\"jī quǎn bù níng\",meaning:\"形容骚扰得厉害，连鸡狗都不得安宁\",difficulty:1,category:[\"动物\"],frequency:82},\n{id:\"e034\",idiom:\"虎头蛇尾\",chars:[\"虎\",\"头\",\"蛇\",\"尾\"],pinyin:\"hǔ tóu shé wěi\",meaning:\"比喻做事有始无终\",difficulty:1,category:[\"动物\"],frequency:81},\n{id:\"e035\",idiom:\"鹤立鸡群\",chars:[\"鹤\",\"立\",\"鸡\",\"群\"],pinyin:\"hè lì jī qún\",meaning:\"比喻才能出众，与众不同\",difficulty:1,category:[\"动物\"],frequency:81},\n{id:\"e036\",idiom:\"鱼目混珠\",chars:[\"鱼\",\"目\",\"混\",\"珠\"],pinyin:\"yú mù hùn zhū\",meaning:\"比喻以假充真\",difficulty:1,category:[\"动物\"],frequency:80},\n{id:\"e037\",idiom:\"龙马精神\",chars:[\"龙\",\"马\",\"精\",\"神\"],pinyin:\"lóng mǎ jīng shén\",meaning:\"比喻精神旺盛\",difficulty:1,category:[\"动物\"],frequency:80},\n{id:\"e038\",idiom:\"画龙点睛\",chars:[\"画\",\"龙\",\"点\",\"睛\"],pinyin:\"huà lóng diǎn jīng\",meaning:\"比喻在关键处加上精辟的话使内容更加生动\",difficulty:1,category:[\"动物\"],frequency:79},\n{id:\"e039\",idiom:\"骑虎难下\",chars:[\"骑\",\"虎\",\"难\",\"下\"],pinyin:\"qí hǔ nán xià\",meaning:\"比喻做事中途遇到困难但不能停止\",difficulty:1,category:[\"动物\"],frequency:79},\n{id:\"e040\",idiom:\"指鹿为马\",chars:[\"指\",\"鹿\",\"为\",\"马\"],pinyin:\"zhǐ lù wéi mǎ\",meaning:\"比喻故意颠倒黑白混淆是非\",difficulty:1,category:[\"动物\"],frequency:78},\n{id:\"e041\",idiom:\"鹏程万里\",chars:[\"鹏\",\"程\",\"万\",\"里\"],pinyin:\"péng chéng wàn lǐ\",meaning:\"比喻前程远大\",difficulty:1,category:[\"动物\",\"数字\"],frequency:78},\n{id:\"e042\",idiom:\"开天辟地\",chars:[\"开\",\"天\",\"辟\",\"地\"],pinyin:\"kāi tiān pì dì\",meaning:\"比喻前所未有的伟大事业\",difficulty:1,category:[\"自然\"],frequency:77},\n{id:\"e043\",idiom:\"惊天动地\",chars:[\"惊\",\"天\",\"动\",\"地\"],pinyin:\"jīng tiān dòng dì\",meaning:\"形容声势浩大或影响深远\",difficulty:1,category:[\"自然\"],frequency:77},\n{id:\"e044\",idiom:\"欢天喜地\",chars:[\"欢\",\"天\",\"喜\",\"地\"],pinyin:\"huān tiān xǐ dì\",meaning:\"形容非常高兴\",difficulty:1,category:[\"情感\"],frequency:76},\n{id:\"e045\",idiom:\"冰天雪地\",chars:[\"冰\",\"天\",\"雪\",\"地\"],pinyin:\"bīng tiān xuě dì\",meaning:\"形容冰雪漫天盖地\",difficulty:1,category:[\"自然\",\"四季\"],frequency:76},\n{id:\"e046\",idiom:\"顶天立地\",chars:[\"顶\",\"天\",\"立\",\"地\"],pinyin:\"dǐng tiān lì dì\",meaning:\"形容形象高大气概豪迈\",difficulty:1,category:[\"人物\"],frequency:75},\n{id:\"e047\",idiom:\"铺天盖地\",chars:[\"铺\",\"天\",\"盖\",\"地\"],pinyin:\"pū tiān gài dì\",meaning:\"形容来势猛声势大\",difficulty:1,category:[\"自然\"],frequency:75},\n{id:\"e048\",idiom:\"漫不经心\",chars:[\"漫\",\"不\",\"经\",\"心\"],pinyin:\"màn bù jīng xīn\",meaning:\"形容随随便便不放在心上\",difficulty:1,category:[\"常用\"],frequency:74},\n{id:\"e049\",idiom:\"异想天开\",chars:[\"异\",\"想\",\"天\",\"开\"],pinyin:\"yì xiǎng tiān kāi\",meaning:\"形容想法离奇不切实际\",difficulty:1,category:[\"常用\"],frequency:74},\n{id:\"e050\",idiom:\"一鸣惊人\",chars:[\"一\",\"鸣\",\"惊\",\"人\"],pinyin:\"yī míng jīng rén\",meaning:\"比喻平时没有表现突然做出惊人的成绩\",difficulty:1,category:[\"数字\"],frequency:73},\n{id:\"e051\",idiom:\"一帆风顺\",chars:[\"一\",\"帆\",\"风\",\"顺\"],pinyin:\"yī fān fēng shùn\",meaning:\"比喻非常顺利没有阻碍\",difficulty:1,category:[\"自然\"],frequency:73},\n{id:\"e052\",idiom:\"一目了然\",chars:[\"一\",\"目\",\"了\",\"然\"],pinyin:\"yī mù liǎo rán\",meaning:\"一眼看去就清楚明白\",difficulty:1,category:[\"常用\"],frequency:72},\n{id:\"e053\",idiom:\"一言为定\",chars:[\"一\",\"言\",\"为\",\"定\"],pinyin:\"yī yán wéi dìng\",meaning:\"一句话说定不再更改\",difficulty:1,category:[\"常用\"],frequency:72},\n{id:\"e054\",idiom:\"一诺千金\",chars:[\"一\",\"诺\",\"千\",\"金\"],pinyin:\"yī nuò qiān jīn\",meaning:\"形容说话算数极有信用\",difficulty:1,category:[\"数字\"],frequency:71},\n{id:\"e055\",idiom:\"一丝不苟\",chars:[\"一\",\"丝\",\"不\",\"苟\"],pinyin:\"yī sī bù gǒu\",meaning:\"形容做事认真仔细一点不马虎\",difficulty:1,category:[\"常用\"],frequency:71},\n{id:\"e056\",idiom:\"一视同仁\",chars:[\"一\",\"视\",\"同\",\"仁\"],pinyin:\"yī shì tóng rén\",meaning:\"平等对待不分厚薄\",difficulty:1,category:[\"常用\"],frequency:70},\n{id:\"e057\",idiom:\"一见钟情\",chars:[\"一\",\"见\",\"钟\",\"情\"],pinyin:\"yī jiàn zhōng qíng\",meaning:\"第一次见面就产生了爱情\",difficulty:1,category:[\"情感\"],frequency:70},\n{id:\"e058\",idiom:\"半途而废\",chars:[\"半\",\"途\",\"而\",\"废\"],pinyin:\"bàn tú ér fèi\",meaning:\"做事中途停止没有坚持到底\",difficulty:1,category:[\"常用\"],frequency:69},\n{id:\"e059\",idiom:\"大名鼎鼎\",chars:[\"大\",\"名\",\"鼎\",\"鼎\"],pinyin:\"dà míng dǐng dǐng\",meaning:\"形容名声很大\",difficulty:1,category:[\"人物\"],frequency:69},\n{id:\"e060\",idiom:\"有名无实\",chars:[\"有\",\"名\",\"无\",\"实\"],pinyin:\"yǒu míng wú shí\",meaning:\"空有名义而实际上没有\",difficulty:1,category:[\"常用\"],frequency:68},\n{id:\"e061\",idiom:\"不可思议\",chars:[\"不\",\"可\",\"思\",\"议\"],pinyin:\"bù kě sī yì\",meaning:\"无法想象难以理解\",difficulty:1,category:[\"常用\"],frequency:68},\n{id:\"e062\",idiom:\"不务正业\",chars:[\"不\",\"务\",\"正\",\"业\"],pinyin:\"bù wù zhèng yè\",meaning:\"不从事正当的工作\",difficulty:1,category:[\"常用\"],frequency:67},\n{id:\"e063\",idiom:\"不约而同\",chars:[\"不\",\"约\",\"而\",\"同\"],pinyin:\"bù yuē ér tóng\",meaning:\"没有事先商量而彼此行动一致\",difficulty:1,category:[\"常用\"],frequency:67},\n{id:\"e064\",idiom:\"不知所措\",chars:[\"不\",\"知\",\"所\",\"措\"],pinyin:\"bù zhī suǒ cuò\",meaning:\"不知道怎么办才好\",difficulty:1,category:[\"常用\"],frequency:66},\n{id:\"e065\",idiom:\"与众不同\",chars:[\"与\",\"众\",\"不\",\"同\"],pinyin:\"yǔ zhòng bù tóng\",meaning:\"跟众人不一样\",difficulty:1,category:[\"常用\"],frequency:66},\n{id:\"e066\",idiom:\"两全其美\",chars:[\"两\",\"全\",\"其\",\"美\"],pinyin:\"liǎng quán qí měi\",meaning:\"做一件事顾全双方都得到好处\",difficulty:1,category:[\"数字\"],frequency:65},\n{id:\"e067\",idiom:\"入木三分\",chars:[\"入\",\"木\",\"三\",\"分\"],pinyin:\"rù mù sān fēn\",meaning:\"形容分析问题深刻透彻\",difficulty:1,category:[\"数字\"],frequency:65},\n{id:\"e068\",idiom:\"十全十美\",chars:[\"十\",\"全\",\"十\",\"美\"],pinyin:\"shí quán shí měi\",meaning:\"形容非常完美毫无缺陷\",difficulty:1,category:[\"数字\"],frequency:64},\n{id:\"e069\",idiom:\"百里挑一\",chars:[\"百\",\"里\",\"挑\",\"一\"],pinyin:\"bǎi lǐ tiāo yī\",meaning:\"形容极其优秀出众\",difficulty:1,category:[\"数字\"],frequency:64},\n{id:\"e070\",idiom:\"千变万化\",chars:[\"千\",\"变\",\"万\",\"化\"],pinyin:\"qiān biàn wàn huà\",meaning:\"形容变化极多\",difficulty:1,category:[\"数字\"],frequency:63},\n{id:\"e071\",idiom:\"独一无二\",chars:[\"独\",\"一\",\"无\",\"二\"],pinyin:\"dú yī wú èr\",meaning:\"形容非常独特没有相同的\",difficulty:1,category:[\"数字\"],frequency:63},\n{id:\"e072\",idiom:\"心旷神怡\",chars:[\"心\",\"旷\",\"神\",\"怡\"],pinyin:\"xīn kuàng shén yí\",meaning:\"心情开朗精神愉快\",difficulty:1,category:[\"情感\"],frequency:62},\n{id:\"e073\",idiom:\"心安理得\",chars:[\"心\",\"安\",\"理\",\"得\"],pinyin:\"xīn ān lǐ dé\",meaning:\"自以为所做的事合乎道理心里很坦然\",difficulty:1,category:[\"情感\"],frequency:62},\n{id:\"e074\",idiom:\"心直口快\",chars:[\"心\",\"直\",\"口\",\"快\"],pinyin:\"xīn zhí kǒu kuài\",meaning:\"性情直爽有话就说\",difficulty:1,category:[\"人物\"],frequency:61},\n{id:\"e075\",idiom:\"手忙脚乱\",chars:[\"手\",\"忙\",\"脚\",\"乱\"],pinyin:\"shǒu máng jiǎo luàn\",meaning:\"形容做事慌张没有条理\",difficulty:1,category:[\"人物\"],frequency:61},","numLines":80,"startLine":1,"totalLines":540}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6c71640ac24b406e9fe9f7d8","type":"tool_result","content":"1\t// IdiomEngine.js — Question generation engine\n2\t\n3\tclass IdiomEngine {\n4\t  constructor(db) {\n5\t    this.db = db;\n6\t    this.history = new Set();\n7\t  }\n8\t\n9\t  getByDifficulty(difficulty) {\n10\t    return this.db.filter(i => i.difficulty === difficulty);\n11\t  }\n12\t\n13\t  pickRandom(pool) {\n14\t    const available = pool.filter(i => !this.history.has(i.id));\n15\t    if (available.length === 0) {\n16\t      this.history.clear();\n17\t      return pool[Math.floor(Math.random() * pool.length)];\n18\t    }\n19\t    return available[Math.floor(Math.random() * available.length)];\n20\t  }\n21\t\n22\t  generateDistractors(idiom, count) {\n23\t    const chars = idiom.chars;\n24\t    const allChars = this.db.flatMap(i => i.chars);\n25\t    const pool = [...new Set(allChars)].filter(c => !chars.includes(c));\n26\t    const result = [];\n27\t    const used = new Set(chars);\n28\t    while (result.length < count && pool.length > 0) {\n29\t      const idx = Math.floor(Math.random() * pool.length);\n30\t      const c = pool[idx];\n31\t      if (!used.has(c)) {\n32\t        result.push(c);\n33\t        used.add(c);\n34\t      }\n35\t      pool.splice(idx, 1);\n36\t    }\n37\t    return result;\n38\t  }\n39\t\n40\t  generateQuestion(difficulty) {\n41\t    const pool = this.getByDifficulty(difficulty);\n42\t    if (pool.length === 0) return null;\n43\t\n44\t    const idiom = this.pickRandom(pool);\n45\t    this.history.add(idiom.id);\n46\t\n47\t    const distractorCount = [0, 4, 6, 8, 8][difficulty] || 4;\n48\t    const distractors = this.generateDistractors(idiom, distractorCount);\n49\t\n50\t    const candidates = this.shuffle([...idiom.chars, ...distractors]);\n51\t\n52\t    return {\n53\t      idiom,\n54\t      slots: [null, null, null, null],\n55\t      candidates: candidates.map((char, i) => ({ char, index: i, used: false })),\n56\t      answered: false,\n57\t      correct: null\n58\t    };\n59\t  }\n60\t\n61\t  generateForLevel(levelConfig) {\n62\t    const difficulty = levelConfig.difficulty || 1;\n63\t    const count = levelConfig.questions || 10;\n64\t    const questions = [];\n65\t    for (let i = 0; i < count; i++) {\n66\t      const q = this.generateQuestion(difficulty);\n67\t      if (q) questions.push(q);\n68\t    }\n69\t    return questions;\n70\t  }\n71\t\n72\t  shuffle(arr) {\n73\t    const a = [...arr];\n74\t    for (let i = a.length - 1; i > 0; i--) {\n75\t      const j = Math.floor(Math.random() * (i + 1));\n76\t      [a[i], a[j]] = [a[j], a[i]];\n77\t    }\n78\t    return a;\n79\t  }\n80\t\n81\t  reset() {\n82\t    this.history.clear();\n83\t  }\n84\t}\n85\t\n86\tif (typeof module !== 'undefined') module.exports = { IdiomEngine };\n87\t"}]},"parent_tool_use_id":null,"session_id":"3263718e-ff98-4b11-b648-a6d67321903d","uuid":"90e81fda-e9ed-44a7-9c82-7c6e47c19276","timestamp":"2026-05-23T00:16:48.701Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/src/js/IdiomEngine.js","content":"// IdiomEngine.js — Question generation engine\n\nclass IdiomEngine {\n  constructor(db) {\n    this.db = db;\n    this.history = new Set();\n  }\n\n  getByDifficulty(difficulty) {\n    return this.db.filter(i => i.difficulty === difficulty);\n  }\n\n  pickRandom(pool) {\n    const available = pool.filter(i => !this.history.has(i.id));\n    if (available.length === 0) {\n      this.history.clear();\n      return pool[Math.floor(Math.random() * pool.length)];\n    }\n    return available[Math.floor(Math.random() * available.length)];\n  }\n\n  generateDistractors(idiom, count) {\n    const chars = idiom.chars;\n    const allChars = this.db.flatMap(i => i.chars);\n    const pool = [...new Set(allChars)].filter(c => !chars.includes(c));\n    const result = [];\n    const used = new Set(chars);\n    while (result.length < count && pool.length > 0) {\n      const idx = Math.floor(Math.random() * pool.length);\n      const c = pool[idx];\n      if (!used.has(c)) {\n        result.push(c);\n        used.add(c);\n      }\n      pool.splice(idx, 1);\n    }\n    return result;\n  }\n\n  generateQuestion(difficulty) {\n    const pool = this.getByDifficulty(difficulty);\n    if (pool.length === 0) return null;\n\n    const idiom = this.pickRandom(pool);\n    this.history.add(idiom.id);\n\n    const distractorCount = [0, 4, 6, 8, 8][difficulty] || 4;\n    const distractors = this.generateDistractors(idiom, distractorCount);\n\n    const candidates = this.shuffle([...idiom.chars, ...distractors]);\n\n    return {\n      idiom,\n      slots: [null, null, null, null],\n      candidates: candidates.map((char, i) => ({ char, index: i, used: false })),\n      answered: false,\n      correct: null\n    };\n  }\n\n  generateForLevel(levelConfig) {\n    const difficulty = levelConfig.difficulty || 1;\n    const count = levelConfig.questions || 10;\n    const questions = [];\n    for (let i = 0; i < count; i++) {\n      const q = this.generateQuestion(difficulty);\n      if (q) questions.push(q);\n    }\n    return questions;\n  }\n\n  shuffle(arr) {\n    const a = [...arr];\n    for (let i = a.length - 1; i > 0; i--) {\n      const j = Math.floor(Math.random() * (i + 1));\n      [a[i], a[j]] = [a[j], a[i]];\n    }\n    return a;\n  }\n\n  reset() {\n    this.history.clear();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { IdiomEngine };\n","numLines":87,"startLine":1,"totalLines":87}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_f88f6e96fbcc4c00bab3065b","type":"tool_result","content":"1\t// Renderer.js — UI rendering\n2\t\n3\tfunction renderUI(game) {\n4\t  const screens = ['menu-screen', 'map-screen', 'game-screen', 'result-screen'];\n5\t  screens.forEach(id => {\n6\t    const el = document.getElementById(id);\n7\t    if (el) el.classList.remove('active');\n8\t  });\n9\t\n10\t  switch (game.state) {\n11\t    case 'menu': renderMenu(game); break;\n12\t    case 'map': renderMap(game); break;\n13\t    case 'playing': renderGame(game); break;\n14\t    case 'result': renderResult(game); break;\n15\t  }\n16\t}\n17\t\n18\tfunction showScreen(id) {\n19\t  const el = document.getElementById(id);\n20\t  if (el) el.classList.add('active');\n21\t}\n22\t\n23\tfunction renderMenu(game) {\n24\t  showScreen('menu-screen');\n25\t  const mc = document.getElementById('menu-coins');\n26\t  const mcl = document.getElementById('menu-collected');\n27\t  if (mc) mc.textContent = game.data.coins;\n28\t  if (mcl) mcl.textContent = game.data.collectedCount;\n29\t}\n30\t\n31\tfunction renderMap(game) {\n32\t  showScreen('map-screen');\n33\t  const mc = document.getElementById('map-coins');\n34\t  if (mc) mc.textContent = game.data.coins;\n35\t\n36\t  const grid = document.getElementById('level-grid');\n37\t  if (!grid) return;\n38\t  grid.innerHTML = '';\n39\t\n40\t  const chapters = {};\n41\t  LEVELS.forEach(l => {\n42\t    if (!chapters[l.chapter]) chapters[l.chapter] = [];\n43\t    chapters[l.chapter].push(l);\n44\t  });\n45\t\n46\t  const chapInfo = document.getElementById('chapter-info');\n47\t  if (chapInfo && CHAPTERS.length > 0) {\n48\t    chapInfo.innerHTML = CHAPTERS.map(c =>\n49\t      `<div class=\"chapter-badge\" style=\"background:${c.color}\">${c.name} · ${c.subtitle}</div>`\n50\t    ).join('');\n51\t  }\n52\t\n53\t  Object.keys(chapters).forEach(chId => {\n54\t    const section = document.createElement('div');\n55\t    section.className = 'chapter-section';\n56\t    const chap = CHAPTERS.find(c => c.id === parseInt(chId));\n57\t    if (chap) section.style.borderColor = chap.color;\n58\t\n59\t    chapters[chId].forEach(level => {\n60\t      const btn = document.createElement('button');\n61\t      const stars = game.data.getLevelStars(level.id);\n62\t      const unlocked = level.id <= game.data.unlockedLevel;\n63\t      const isBoss = level.boss;\n64\t\n65\t      btn.className = 'level-btn' + (isBoss ? ' boss' : '') + (!unlocked ? ' locked' : '') + (stars > 0 ? ' completed' : '');\n66\t      btn.innerHTML = `\n67\t        <span class=\"level-num\">${level.id}</span>\n68\t        <span class=\"level-stars\">${'★'.repeat(stars)}${'☆'.repeat(3 - stars)}</span>\n69\t        <span class=\"level-name\">${level.name}</span>\n70\t      `;\n71\t\n72\t      if (unlocked) {\n73\t        btn.onclick = () => game.startLevel(level.id);\n74\t      }\n75\t      section.appendChild(btn);\n76\t    });\n77\t    grid.appendChild(section);\n78\t  });\n79\t}\n80\t\n81\tfunction renderGame(game) {\n82\t  showScreen('game-screen');\n83\t  const q = game.getCurrentQuestion();\n84\t  if (!q) return;\n85\t\n86\t  // Header\n87\t  const ll = document.getElementById('level-label');\n88\t  const pl = document.getElementById('progress-label');\n89\t  const ld = document.getElementById('lives-display');\n90\t  if (ll) ll.textContent = `第${game.currentLevel.id}关`;\n91\t  if (pl) pl.textContent = `${game.questionIndex + 1}/${game.questions.length}`;\n92\t  if (ld) ld.textContent = '❤️'.repeat(Math.max(0, game.lives));\n93\t\n94\t  // Meaning\n95\t  const mt = document.getElementById('meaning-text');\n96\t  if (mt) mt.textContent = q.idiom.meaning;\n97\t\n98\t  // Combo display\n99\t  const cd = document.getElementById('combo-display');\n100\t  if (cd) {\n101\t    if (game.combo.combo >= 3) {\n102\t      cd.textContent = `🔥 ${game.combo.combo}连击！${game.combo.getComboMessage()}`;\n103\t      cd.style.display = 'block';\n104\t      cd.className = 'combo-display combo-' + Math.min(game.combo.combo, 10);\n105\t    } else {\n106\t      cd.style.display = 'none';\n107\t    }\n108\t  }\n109\t\n110\t  // Slots\n111\t  const sc = document.getElementById('slots-container');\n112\t  if (sc) {\n113\t    sc.innerHTML = '';\n114\t    const slots = game.judge.getSlots();\n115\t    for (let i = 0; i < 4; i++) {\n116\t      const slot = document.createElement('div');\n117\t      slot.className = 'slot';\n118\t      if (slots[i]) {\n119\t        slot.classList.add('filled');\n120\t        slot.textContent = slots[i].char;\n121\t        slot.onclick = () => { game.removeSlot(i); };\n122\t      }\n123\t      if (q.answered && q.correct === true) slot.classList.add('correct');\n124\t      if (q.answered && q.correct === false) slot.classList.add('wrong');\n125\t      sc.appendChild(slot);\n126\t    }\n127\t  }\n128\t\n129\t  // Idiom hint (after correct answer)\n130\t  const ih = document.getElementById('idiom-hint');\n131\t  if (ih) {\n132\t    if (q.answered && q.correct) {\n133\t      ih.innerHTML = `<strong>${q.idiom.idiom}</strong>：${q.idiom.meaning}`;\n134\t      ih.style.display = 'block';\n135\t    } else {\n136\t      ih.style.display = 'none';\n137\t    }\n138\t  }\n139\t\n140\t  // Candidates\n141\t  const cc = document.getElementById('candidates-container');\n142\t  if (cc) {\n143\t    cc.innerHTML = '';\n144\t    q.candidates.forEach((c, i) => {\n145\t      const btn = document.createElement('button');\n146\t      btn.className = 'candidate';\n147\t      btn.textContent = c.char;\n148\t      if (c.used) btn.classList.add('used');\n149\t      if (c.removed) btn.classList.add('removed');\n150\t      if (!c.used && !c.removed && !q.answered) {\n151\t        btn.onclick = () => game.pickChar(i);\n152\t      }\n153\t      cc.appendChild(btn);\n154\t    });\n155\t  }\n156\t\n157\t  // Tutorial overlay\n158\t  const to = document.getElementById('tutorial-overlay');\n159\t  const tt = document.getElementById('tutorial-text');\n160\t  if (to && tt) {\n161\t    const step = game.tutorial.getCurrentStep();\n162\t    if (step) {\n163\t      tt.textContent = step.msg;\n164\t      to.style.display = 'flex';\n165\t    } else {\n166\t      to.style.display = 'none';\n167\t    }\n168\t  }\n169\t}\n170\t\n171\tfunction renderResult(game) {\n172\t  showScreen('result-screen');\n173\t  const r = game.levelResult;\n174\t  if (!r) return;\n175\t\n176\t  const rt = document.getElementById('result-title');\n177\t  if (rt) rt.textContent = r.stars > 0 ? '🎉 通关!' : '😞 失败';\n178\t\n179\t  const rs = document.getElementById('result-stars');\n180\t  if (rs) rs.innerHTML = '★'.repeat(r.stars) + '☆'.repeat(3 - r.stars);\n181\t\n182\t  const rc = document.getElementById('result-correct');\n183\t  const rto = document.getElementById('result-total');\n184\t  const rsc = document.getElementById('result-score');\n185\t  const rco = document.getElementById('result-combo');\n186\t  const rcoins = document.getElementById('result-coins');\n187\t\n188\t  if (rc) rc.textContent = r.correctCount;\n189\t  if (rto) rto.textContent = r.totalQuestions;\n190\t  if (rsc) rsc.textContent = r.score;\n191\t  if (rco) rco.textContent = r.maxCombo;\n192\t  if (rcoins) rcoins.textContent = r.coins;\n193\t\n194\t  const btnNext = document.getElementById('btn-next');\n195\t  if (btnNext) {\n196\t    const nextId = game.currentLevel.id + 1;\n197\t    const hasNext = LEVELS.find(l => l.id === nextId);\n198\t    btnNext.style.display = (r.stars > 0 && hasNext) ? 'inline-block' : 'none';\n199\t  }\n200\t\n201\t  const btnRetry = document.getElementById('btn-retry');\n202\t  if (btnRetry) btnRetry.style.display = r.stars > 0 ? 'none' : 'inline-block';\n203\t}\n204\t"}]},"parent_tool_use_id":null,"session_id":"3263718e-ff98-4b11-b648-a6d67321903d","uuid":"a7efd41c-5d28-43fc-b7a4-cc2ef8617147","timestamp":"2026-05-23T00:16:48.703Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/src/js/Renderer.js","content":"// Renderer.js — UI rendering\n\nfunction renderUI(game) {\n  const screens = ['menu-screen', 'map-screen', 'game-screen', 'result-screen'];\n  screens.forEach(id => {\n    const el = document.getElementById(id);\n    if (el) el.classList.remove('active');\n  });\n\n  switch (game.state) {\n    case 'menu': renderMenu(game); break;\n    case 'map': renderMap(game); break;\n    case 'playing': renderGame(game); break;\n    case 'result': renderResult(game); break;\n  }\n}\n\nfunction showScreen(id) {\n  const el = document.getElementById(id);\n  if (el) el.classList.add('active');\n}\n\nfunction renderMenu(game) {\n  showScreen('menu-screen');\n  const mc = document.getElementById('menu-coins');\n  const mcl = document.getElementById('menu-collected');\n  if (mc) mc.textContent = game.data.coins;\n  if (mcl) mcl.textContent = game.data.collectedCount;\n}\n\nfunction renderMap(game) {\n  showScreen('map-screen');\n  const mc = document.getElementById('map-coins');\n  if (mc) mc.textContent = game.data.coins;\n\n  const grid = document.getElementById('level-grid');\n  if (!grid) return;\n  grid.innerHTML = '';\n\n  const chapters = {};\n  LEVELS.forEach(l => {\n    if (!chapters[l.chapter]) chapters[l.chapter] = [];\n    chapters[l.chapter].push(l);\n  });\n\n  const chapInfo = document.getElementById('chapter-info');\n  if (chapInfo && CHAPTERS.length > 0) {\n    chapInfo.innerHTML = CHAPTERS.map(c =>\n      `<div class=\"chapter-badge\" style=\"background:${c.color}\">${c.name} · ${c.subtitle}</div>`\n    ).join('');\n  }\n\n  Object.keys(chapters).forEach(chId => {\n    const section = document.createElement('div');\n    section.className = 'chapter-section';\n    const chap = CHAPTERS.find(c => c.id === parseInt(chId));\n    if (chap) section.style.borderColor = chap.color;\n\n    chapters[chId].forEach(level => {\n      const btn = document.createElement('button');\n      const stars = game.data.getLevelStars(level.id);\n      const unlocked = level.id <= game.data.unlockedLevel;\n      const isBoss = level.boss;\n\n      btn.className = 'level-btn' + (isBoss ? ' boss' : '') + (!unlocked ? ' locked' : '') + (stars > 0 ? ' completed' : '');\n      btn.innerHTML = `\n        <span class=\"level-num\">${level.id}</span>\n        <span class=\"level-stars\">${'★'.repeat(stars)}${'☆'.repeat(3 - stars)}</span>\n        <span class=\"level-name\">${level.name}</span>\n      `;\n\n      if (unlocked) {\n        btn.onclick = () => game.startLevel(level.id);\n      }\n      section.appendChild(btn);\n    });\n    grid.appendChild(section);\n  });\n}\n\nfunction renderGame(game) {\n  showScreen('game-screen');\n  const q = game.getCurrentQuestion();\n  if (!q) return;\n\n  // Header\n  const ll = document.getElementById('level-label');\n  const pl = document.getElementById('progress-label');\n  const ld = document.getElementById('lives-display');\n  if (ll) ll.textContent = `第${game.currentLevel.id}关`;\n  if (pl) pl.textContent = `${game.questionIndex + 1}/${game.questions.length}`;\n  if (ld) ld.textContent = '❤️'.repeat(Math.max(0, game.lives));\n\n  // Meaning\n  const mt = document.getElementById('meaning-text');\n  if (mt) mt.textContent = q.idiom.meaning;\n\n  // Combo display\n  const cd = document.getElementById('combo-display');\n  if (cd) {\n    if (game.combo.combo >= 3) {\n      cd.textContent = `🔥 ${game.combo.combo}连击！${game.combo.getComboMessage()}`;\n      cd.style.display = 'block';\n      cd.className = 'combo-display combo-' + Math.min(game.combo.combo, 10);\n    } else {\n      cd.style.display = 'none';\n    }\n  }\n\n  // Slots\n  const sc = document.getElementById('slots-container');\n  if (sc) {\n    sc.innerHTML = '';\n    const slots = game.judge.getSlots();\n    for (let i = 0; i < 4; i++) {\n      const slot = document.createElement('div');\n      slot.className = 'slot';\n      if (slots[i]) {\n        slot.classList.add('filled');\n        slot.textContent = slots[i].char;\n        slot.onclick = () => { game.removeSlot(i); };\n      }\n      if (q.answered && q.correct === true) slot.classList.add('correct');\n      if (q.answered && q.correct === false) slot.classList.add('wrong');\n      sc.appendChild(slot);\n    }\n  }\n\n  // Idiom hint (after correct answer)\n  const ih = document.getElementById('idiom-hint');\n  if (ih) {\n    if (q.answered && q.correct) {\n      ih.innerHTML = `<strong>${q.idiom.idiom}</strong>：${q.idiom.meaning}`;\n      ih.style.display = 'block';\n    } else {\n      ih.style.display = 'none';\n    }\n  }\n\n  // Candidates\n  const cc = document.getElementById('candidates-container');\n  if (cc) {\n    cc.innerHTML = '';\n    q.candidates.forEach((c, i) => {\n      const btn = document.createElement('button');\n      btn.className = 'candidate';\n      btn.textContent = c.char;\n      if (c.used) btn.classList.add('used');\n      if (c.removed) btn.classList.add('removed');\n      if (!c.used && !c.removed && !q.answered) {\n        btn.onclick = () => game.pickChar(i);\n      }\n      cc.appendChild(btn);\n    });\n  }\n\n  // Tutorial overlay\n  const to = document.getElementById('tutorial-overlay');\n  const tt = document.getElementById('tutorial-text');\n  if (to && tt) {\n    const step = game.tutorial.getCurrentStep();\n    if (step) {\n      tt.textContent = step.msg;\n      to.style.display = 'flex';\n    } else {\n      to.style.display = 'none';\n    }\n  }\n}\n\nfunction renderResult(game) {\n  showScreen('result-screen');\n  const r = game.levelResult;\n  if (!r) return;\n\n  const rt = document.getElementById('result-title');\n  if (rt) rt.textContent = r.stars > 0 ? '🎉 通关!' : '😞 失败';\n\n  const rs = document.getElementById('result-stars');\n  if (rs) rs.innerHTML = '★'.repeat(r.stars) + '☆'.repeat(3 - r.stars);\n\n  const rc = document.getElementById('result-correct');\n  const rto = document.getElementById('result-total');\n  const rsc = document.getElementById('result-score');\n  const rco = document.getElementById('result-combo');\n  const rcoins = document.getElementById('result-coins');\n\n  if (rc) rc.textContent = r.correctCount;\n  if (rto) rto.textContent = r.totalQuestions;\n  if (rsc) rsc.textContent = r.score;\n  if (rco) rco.textContent = r.maxCombo;\n  if (rcoins) rcoins.textContent = r.coins;\n\n  const btnNext = document.getElementById('btn-next');\n  if (btnNext) {\n    const nextId = game.currentLevel.id + 1;\n    const hasNext = LEVELS.find(l => l.id === nextId);\n    btnNext.style.display = (r.stars > 0 && hasNext) ? 'inline-block' : 'none';\n  }\n\n  const btnRetry = document.getElementById('btn-retry');\n  if (btnRetry) btnRetry.style.display = r.stars > 0 ? 'none' : 'inline-block';\n}\n","numLines":204,"startLine":1,"totalLines":204}}}
