creen: settings.fullscreen,\n56\t    show: false,\n57\t    icon: path.join(__dirname, '../../assets/icons/icon.ico'),\n58\t    webPreferences: {\n59\t      nodeIntegration: false,\n60\t      contextIsolation: true,\n61\t      preload: path.join(__dirname, 'preload.js'),\n62\t    },\n63\t  });\n64\t\n65\t  // Show window when ready (avoids white flash)\n66\t  mainWindow.once('ready-to-show', () => {\n67\t    mainWindow?.show();\n68\t  });\n69\t\n70\t  // In development, load from Vite dev server\n71\t  const isDev = process.env.NODE_ENV === 'development';\n72\t  if (isDev) {\n73\t    mainWindow.loadURL('http://localhost:5173');\n74\t    mainWindow.webContents.openDevTools();\n75\t  } else {\n76\t    mainWindow.loadFile(path.join(__dirname, '../renderer/index.html'));\n77\t  }\n78\t\n79\t  mainWindow.on('closed', () => {\n80\t    mainWindow = null;\n81\t  });\n82\t}\n83\t\n84\t// === IPC Handlers ===\n85\t\n86\tfunction setupIPC(): void {\n87\t  ipcMain.handle('settings:get', () => {\n88\t    return loadAppSettings();\n89\t  });\n90\t\n91\t  ipcMain.handle('settings:set', (_event, settings: AppSettings) => {\n92\t    saveAppSettings(settings);\n93\t    return true;\n94\t  });\n95\t\n96\t  ipcMain.handle('window:fullscreen', (_event, fullscreen: boolean) => {\n97\t    if (mainWindow) {\n98\t      mainWindow.setFullScreen(fullscreen);\n99\t      const settings = loadAppSettings();\n100\t      settings.fullscreen = fullscreen;\n101\t      saveAppSettings(settings);\n102\t    }\n103\t    return true;\n104\t  });\n105\t\n106\t  ipcMain.handle('window:resolution', (_event, w: number, h: number) => {\n107\t    if (mainWindow) {\n108\t      mainWindow.setSize(w, h);\n109\t      mainWindow.center();\n110\t      const settings = loadAppSettings();\n111\t      settings.resolution = { width: w, height: h };\n112\t      saveAppSettings(settings);\n113\t    }\n114\t    return true;\n115\t  });\n116\t\n117\t  ipcMain.handle('steam:isAvailable', () => {\n118\t    return isSteamRunning();\n119\t  });\n120\t\n121\t  ipcMain.handle('steam:unlockAchievement', (_event, id: string) => {\n122\t    return unlockAchievement(id);\n123\t  });\n124\t\n125\t  ipcMain.handle('steam:cloudSave', (_event, data: string) => {\n126\t    return saveToCloud(data);\n127\t  });\n128\t\n129\t  ipcMain.handle('steam:cloudLoad', () => {\n130\t    return loadFromCloud();\n131\t  });\n132\t\n133\t  ipcMain.handle('app:version', () => {\n134\t    return app.getVersion();\n135\t  });\n136\t\n137\t  ipcMain.handle('app:quit', () => {\n138\t    app.quit();\n139\t  });\n140\t}\n141\t\n142\t// === App Lifecycle ===\n143\t\n144\tapp.whenReady().then(() => {\n145\t  // Initialize Steam\n146\t  initSteam();\n147\t\n148\t  // Setup IPC\n149\t  setupIPC();\n150\t\n151\t  // Create window\n152\t  createWindow();\n153\t\n154\t  app.on('activate', () => {\n155\t    if (mainWindow === null) {\n156\t      createWindow();\n157\t    }\n158\t  });\n159\t});\n160\t\n161\tapp.on('window-all-closed', () => {\n162\t  shutdownSteam();\n163\t  if (process.platform !== 'darwin') {\n164\t    app.quit();\n165\t  }\n166\t});\n167\t\n168\tapp.on('before-quit', () => {\n169\t  shutdownSteam();\n170\t});\n171\t"}]},"parent_tool_use_id":null,"session_id":"93695823-6434-4d3f-8f7c-d2b2fb5d45a1","uuid":"63da1346-108a-413c-b629-095ac7fa53d3","timestamp":"2026-05-23T03:36:54.259Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\main\\main.ts","content":"// Electron main process entry point (v0.5.0 — M5: Steam + UI polish + packaging)\n\nimport { app, BrowserWindow, ipcMain, screen } from 'electron';\nimport * as path from 'path';\nimport * as fs from 'fs';\nimport { initSteam, isSteamRunning, unlockAchievement, saveToCloud, loadFromCloud, shutdownSteam } from './SteamIntegration';\n\nlet mainWindow: BrowserWindow | null = null;\n\nconst SETTINGS_PATH = path.join(app.getPath('userData'), 'settings.json');\n\ninterface AppSettings {\n  masterVolume: number;\n  sfxVolume: number;\n  musicVolume: number;\n  resolution: { width: number; height: number };\n  fullscreen: boolean;\n  language: string;\n  autoSaveInterval: number;\n  showFPS: boolean;\n  particleQuality: string;\n}\n\nfunction loadAppSettings(): AppSettings {\n  try {\n    if (fs.existsSync(SETTINGS_PATH)) {\n      return JSON.parse(fs.readFileSync(SETTINGS_PATH, 'utf-8'));\n    }\n  } catch { /* use defaults */ }\n  return {\n    masterVolume: 80, sfxVolume: 100, musicVolume: 70,\n    resolution: { width: 1280, height: 800 },\n    fullscreen: false, language: 'zh-CN',\n    autoSaveInterval: 60, showFPS: true, particleQuality: 'high',\n  };\n}\n\nfunction saveAppSettings(settings: AppSettings): void {\n  try {\n    fs.writeFileSync(SETTINGS_PATH, JSON.stringify(settings, null, 2));\n  } catch { /* ignore */ }\n}\n\nfunction createWindow(): void {\n  const settings = loadAppSettings();\n  const { width, height } = settings.resolution;\n\n  mainWindow = new BrowserWindow({\n    width,\n    height,\n    minWidth: 960,\n    minHeight: 600,\n    title: '修仙自动化工厂 — Cultivation Factory',\n    backgroundColor: '#1a1a2e',\n    fullscreen: settings.fullscreen,\n    show: false,\n    icon: path.join(__dirname, '../../assets/icons/icon.ico'),\n    webPreferences: {\n      nodeIntegration: false,\n      contextIsolation: true,\n      preload: path.join(__dirname, 'preload.js'),\n    },\n  });\n\n  // Show window when ready (avoids white flash)\n  mainWindow.once('ready-to-show', () => {\n    mainWindow?.show();\n  });\n\n  // In development, load from Vite dev server\n  const isDev = process.env.NODE_ENV === 'development';\n  if (isDev) {\n    mainWindow.loadURL('http://localhost:5173');\n    mainWindow.webContents.openDevTools();\n  } else {\n    mainWindow.loadFile(path.join(__dirname, '../renderer/index.html'));\n  }\n\n  mainWindow.on('closed', () => {\n    mainWindow = null;\n  });\n}\n\n// === IPC Handlers ===\n\nfunction setupIPC(): void {\n  ipcMain.handle('settings:get', () => {\n    return loadAppSettings();\n  });\n\n  ipcMain.handle('settings:set', (_event, settings: AppSettings) => {\n    saveAppSettings(settings);\n    return true;\n  });\n\n  ipcMain.handle('window:fullscreen', (_event, fullscreen: boolean) => {\n    if (mainWindow) {\n      mainWindow.setFullScreen(fullscreen);\n      const settings = loadAppSettings();\n      settings.fullscreen = fullscreen;\n      saveAppSettings(settings);\n    }\n    return true;\n  });\n\n  ipcMain.handle('window:resolution', (_event, w: number, h: number) => {\n    if (mainWindow) {\n      mainWindow.setSize(w, h);\n      mainWindow.center();\n      const settings = loadAppSettings();\n      settings.resolution = { width: w, height: h };\n      saveAppSettings(settings);\n    }\n    return true;\n  });\n\n  ipcMain.handle('steam:isAvailable', () => {\n    return isSteamRunning();\n  });\n\n  ipcMain.handle('steam:unlockAchievement', (_event, id: string) => {\n    return unlockAchievement(id);\n  });\n\n  ipcMain.handle('steam:cloudSave', (_event, data: string) => {\n    return saveToCloud(data);\n  });\n\n  ipcMain.handle('steam:cloudLoad', () => {\n    return loadFromCloud();\n  });\n\n  ipcMain.handle('app:version', () => {\n    return app.getVersion();\n  });\n\n  ipcMain.handle('app:quit', () => {\n    app.quit();\n  });\n}\n\n// === App Lifecycle ===\n\napp.whenReady().then(() => {\n  // Initialize Steam\n  initSteam();\n\n  // Setup IPC\n  setupIPC();\n\n  // Create window\n  createWindow();\n\n  app.on('activate', () => {\n    if (mainWindow === null) {\n      createWindow();\n    }\n  });\n});\n\napp.on('window-all-closed', () => {\n  shutdownSteam();\n  if (process.platform !== 'darwin') {\n    app.quit();\n  }\n});\n\napp.on('before-quit', () => {\n  shutdownSteam();\n});\n","numLines":171,"startLine":1,"totalLines":171}}}
