{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6d78a1ae03f44daea0dde423","type":"tool_result","content":"The file D:/game-projects/douyin-match3/src/js/Renderer.js has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"ef939699-9dac-4e19-a950-f991f68c1f56","uuid":"ea070c33-030c-4630-9e2a-628f49c9a5e1","timestamp":"2026-05-22T21:11:00.504Z","tool_use_result":{"filePath":"D:/game-projects/douyin-match3/src/js/Renderer.js","oldString":"// Renderer.js — Canvas 2D rendering engine for the match-3 board\nconst { COLOR_MAP, BOARD_SIZE, SPECIAL_STRIPED_H, SPECIAL_STRIPED_V, SPECIAL_BOMB, SPECIAL_RAINBOW } =\n  typeof require !== 'undefined' ? require('./Board.js') : {};","newString":"// Renderer.js — Canvas 2D rendering engine for the match-3 board","originalFile":"// Renderer.js — Canvas 2D rendering engine for the match-3 board\nconst { COLOR_MAP, BOARD_SIZE, SPECIAL_STRIPED_H, SPECIAL_STRIPED_V, SPECIAL_BOMB, SPECIAL_RAINBOW } =\n  typeof require !== 'undefined' ? require('./Board.js') : {};\n\nclass Renderer {\n  constructor(canvas) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d');\n    this.tileSize = 0;\n    this.boardX = 0;\n    this.boardY = 0;\n    this.particleSystem = null;\n    this.floatingTexts = [];\n    this.resize();\n  }\n\n  resize() {\n    const dpr = window.devicePixelRatio || 1;\n    const w = window.innerWidth;\n    const h = window.innerHeight;\n    this.canvas.width = w * dpr;\n    this.canvas.height = h * dpr;\n    this.canvas.style.width = w + 'px';\n    this.canvas.style.height = h + 'px';\n    this.ctx.scale(dpr, dpr);\n    this.screenW = w;\n    this.screenH = h;\n\n    // Board layout: centered, leave room for top UI\n    this.tileSize = Math.floor(Math.min(w * 0.9, (h - 160)) / BOARD_SIZE);\n    this.boardX = (w - this.tileSize * BOARD_SIZE) / 2;\n    this.boardY = 140;\n  }\n\n  getTileCenter(row, col) {\n    return {\n      x: this.boardX + col * this.tileSize + this.tileSize / 2,\n      y: this.boardY + row * this.tileSize + this.tileSize / 2,\n    };\n  }\n\n  clear() {\n    this.ctx.clearRect(0, 0, this.screenW, this.screenH);\n  }\n\n  drawBackground() {\n    const ctx = this.ctx;\n    // Cream background\n    ctx.fillStyle = '#FFF8E7';\n    ctx.fillRect(0, 0, this.screenW, this.screenH);\n\n    // Board background\n    const bw = this.tileSize * BOARD_SIZE;\n    const bh = this.tileSize * BOARD_SIZE;\n    ctx.fillStyle = '#FFFFFFCC';\n    this._roundRect(ctx, this.boardX - 6, this.boardY - 6, bw + 12, bh + 12, 12);\n    ctx.fill();\n\n    // Grid lines (subtle)\n    ctx.strokeStyle = '#F0E6D6';\n    ctx.lineWidth = 1;\n    for (let i = 0; i <= BOARD_SIZE; i++) {\n      ctx.beginPath();\n      ctx.moveTo(this.boardX + i * this.tileSize, this.boardY);\n      ctx.lineTo(this.boardX + i * this.tileSize, this.boardY + bh);\n      ctx.stroke();\n      ctx.beginPath();\n      ctx.moveTo(this.boardX, this.boardY + i * this.tileSize);\n      ctx.lineTo(this.boardX + bw, this.boardY + i * this.tileSize);\n      ctx.stroke();\n    }\n  }\n\n  drawTile(tile) {\n    if (!tile || tile.color < 0) return;\n    const ctx = this.ctx;\n    const size = this.tileSize - 4;\n    const cx = this.boardX + tile.col * this.tileSize + this.tileSize / 2 + (tile.offsetX || 0);\n    const cy = this.boardY + tile.row * this.tileSize + this.tileSize / 2 + (tile.offsetY || 0);\n    const scale = tile.scale || 1;\n    const alpha = tile.alpha !== undefined ? tile.alpha : 1;\n\n    ctx.save();\n    ctx.translate(cx, cy);\n    ctx.scale(scale, scale);\n    ctx.globalAlpha = alpha;\n\n    const half = size / 2;\n    const color = COLOR_MAP[tile.color];\n    if (!color) { ctx.restore(); return; }\n\n    // Tile body\n    ctx.fillStyle = color.hex;\n    this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n    ctx.fill();\n\n    // Highlight\n    ctx.fillStyle = 'rgba(255,255,255,0.25)';\n    this._roundRect(ctx, -half + 3, -half + 3, size - 6, size / 2 - 3, size * 0.15);\n    ctx.fill();\n\n    // Draw fruit icon\n    this._drawFruitIcon(ctx, tile.color, half * 0.55);\n\n    // Special tile overlay\n    if (tile.special === SPECIAL_STRIPED_H) {\n      this._drawStripes(ctx, size, half, '#FFFFFF80', true);\n    } else if (tile.special === SPECIAL_STRIPED_V) {\n      this._drawStripes(ctx, size, half, '#FFFFFF80', false);\n    } else if (tile.special === SPECIAL_BOMB) {\n      this._drawCrosshair(ctx, half);\n    } else if (tile.special === SPECIAL_RAINBOW) {\n      this._drawRainbowOverlay(ctx, half);\n    }\n\n    // Selection glow\n    if (tile.selected) {\n      ctx.strokeStyle = '#FFFFFF';\n      ctx.lineWidth = 3;\n      ctx.shadowColor = '#FFB800';\n      ctx.shadowBlur = 12;\n      this._roundRect(ctx, -half, -half, size, size, size * 0.2);\n      ctx.stroke();\n      ctx.shadowBlur = 0;\n    }\n\n    ctx.restore();\n  }\n\n  _drawFruitIcon(ctx, colorIdx, radius) {\n    ctx.fillStyle = 'rgba(255,255,255,0.6)';\n    ctx.font = `bold ${radius * 1.4}px sans-serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    const icons = ['🍎', '🍌', '🫐', '🍏', '🍇', '🍊'];\n    ctx.fillText(icons[colorIdx] || '', 0, 1);\n  }\n\n  _drawStripes(ctx, size, half, color, horizontal) {\n    ctx.strokeStyle = color;\n    ctx.lineWidth = 2;\n    if (horizontal) {\n      for (let y = -half + 6; y < half; y += 8) {\n        ctx.beginPath();\n        ctx.moveTo(-half + 4, y);\n        ctx.lineTo(half - 4, y);\n        ctx.stroke();\n      }\n    } else {\n      for (let x = -half + 6; x < half; x += 8) {\n        ctx.beginPath();\n        ctx.moveTo(x, -half + 4);\n        ctx.lineTo(x, half - 4);\n        ctx.stroke();\n      }\n    }\n  }\n\n  _drawCrosshair(ctx, half) {\n    ctx.strokeStyle = '#FFFFFF99';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.moveTo(-half * 0.6, 0); ctx.lineTo(half * 0.6, 0);\n    ctx.moveTo(0, -half * 0.6); ctx.lineTo(0, half * 0.6);\n    ctx.stroke();\n    ctx.beginPath();\n    ctx.arc(0, 0, half * 0.4, 0, Math.PI * 2);\n    ctx.stroke();\n  }\n\n  _drawRainbowOverlay(ctx, half) {\n    const gradient = ctx.createLinearGradient(-half, -half, half, half);\n    gradient.addColorStop(0, '#FF000080');\n    gradient.addColorStop(0.17, '#FF880080');\n    gradient.addColorStop(0.33, '#FFFF0080');\n    gradient.addColorStop(0.5, '#00FF0080');\n    gradient.addColorStop(0.67, '#0088FF80');\n    gradient.addColorStop(0.83, '#8800FF80');\n    gradient.addColorStop(1, '#FF008880');\n    ctx.fillStyle = gradient;\n    this._roundRect(ctx, -half, -half, half * 2, half * 2, half * 0.4);\n    ctx.fill();\n  }\n\n  drawUI(score, moves, goal, goalProgress, level) {\n    const ctx = this.ctx;\n\n    // Top bar background\n    ctx.fillStyle = '#FFB800';\n    this._roundRect(ctx, 8, 8, this.screenW - 16, 55, 12);\n    ctx.fill();\n\n    // Level\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 18px sans-serif';\n    ctx.textAlign = 'left';\n    ctx.fillText(`第 ${level} 关`, 20, 42);\n\n    // Score\n    ctx.textAlign = 'center';\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = 'bold 20px sans-serif';\n    ctx.fillText(`${score}`, this.screenW / 2, 32);\n    ctx.font = '12px sans-serif';\n    ctx.fillText('分数', this.screenW / 2, 48);\n\n    // Moves\n    ctx.textAlign = 'right';\n    ctx.fillStyle = moves <= 5 ? '#FF4D4D' : '#5D4037';\n    ctx.font = 'bold 22px sans-serif';\n    ctx.fillText(`${moves}`, this.screenW - 20, 32);\n    ctx.font = '12px sans-serif';\n    ctx.fillStyle = '#5D4037';\n    ctx.fillText('剩余步数', this.screenW - 20, 48);\n\n    // Goal progress bar\n    const barW = this.screenW - 40;\n    const barH = 16;\n    const barY = 72;\n    const barX = 20;\n\n    ctx.fillStyle = '#E0D5C5';\n    this._roundRect(ctx, barX, barY, barW, barH, 8);\n    ctx.fill();\n\n    const progress = Math.min(goalProgress / goal, 1);\n    if (progress > 0) {\n      const grad = ctx.createLinearGradient(barX, barY, barX + barW * progress, barY);\n      grad.addColorStop(0, '#6BCB77');\n      grad.addColorStop(1, '#4DA66B');\n      ctx.fillStyle = grad;\n      this._roundRect(ctx, barX, barY, barW * progress, barH, 8);\n      ctx.fill();\n    }\n\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 11px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(`${goalProgress} / ${goal}`, this.screenW / 2, barY + 13);\n\n    // Bottom hint\n    ctx.fillStyle = '#8D6E63';\n    ctx.font = '14px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText('滑动交换相邻方块', this.screenW / 2, this.boardY + this.tileSize * BOARD_SIZE + 30);\n  }\n\n  drawComboText(text) {\n    if (!text) return;\n    const ctx = this.ctx;\n    ctx.save();\n    ctx.fillStyle = '#FF4D4D';\n    ctx.font = 'bold 36px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.shadowColor = '#FFB800';\n    ctx.shadowBlur = 8;\n    ctx.fillText(text, this.screenW / 2, this.boardY + this.tileSize * BOARD_SIZE / 2);\n    ctx.restore();\n  }\n\n  addFloatingText(text, x, y, color = '#FF4D4D') {\n    this.floatingTexts.push({ text, x, y, alpha: 1, vy: -60, life: 1.0 });\n  }\n\n  updateAndDrawFloatingTexts(dt) {\n    const ctx = this.ctx;\n    this.floatingTexts = this.floatingTexts.filter(ft => {\n      ft.y += ft.vy * dt;\n      ft.life -= dt;\n      ft.alpha = Math.max(0, ft.life);\n      if (ft.life <= 0) return false;\n\n      ctx.globalAlpha = ft.alpha;\n      ctx.fillStyle = ft.color;\n      ctx.font = 'bold 18px sans-serif';\n      ctx.textAlign = 'center';\n      ctx.fillText(ft.text, ft.x, ft.y);\n      ctx.globalAlpha = 1;\n      return true;\n    });\n  }\n\n  drawResultScreen(won, score, stars, level) {\n    const ctx = this.ctx;\n    // Dim overlay\n    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n    ctx.fillRect(0, 0, this.screenW, this.screenH);\n\n    // Panel\n    const pw = Math.min(320, this.screenW - 40);\n    const ph = 260;\n    const px = (this.screenW - pw) / 2;\n    const py = (this.screenH - ph) / 2;\n\n    ctx.fillStyle = '#FFF8E7';\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.fill();\n    ctx.strokeStyle = '#FFB800';\n    ctx.lineWidth = 3;\n    this._roundRect(ctx, px, py, pw, ph, 16);\n    ctx.stroke();\n\n    // Title\n    ctx.fillStyle = '#5D4037';\n    ctx.font = 'bold 24px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(won ? '🎉 恭喜过关！' : '😢 挑战失败', this.screenW / 2, py + 45);\n\n    // Score\n    ctx.font = 'bold 36px sans-serif';\n    ctx.fillStyle = '#FFB800';\n    ctx.fillText(score, this.screenW / 2, py + 95);\n    ctx.font = '14px sans-serif';\n    ctx.fillStyle = '#8D6E63';\n    ctx.fillText('得分', this.screenW / 2, py + 115);\n\n    // Stars\n    if (won) {\n      for (let i = 0; i < 3; i++) {\n        ctx.font = '32px sans-serif';\n        ctx.fillText(i < stars ? '⭐' : '☆', this.screenW / 2 - 45 + i * 45, py + 160);\n      }\n    }\n\n    // Buttons\n    const btnW = 120, btnH = 42;\n    const btnY = py + ph - 60;\n\n    // Retry button\n    ctx.fillStyle = '#6BCB77';\n    this._roundRect(ctx, this.screenW / 2 - btnW - 10, btnY, btnW, btnH, btnH / 2);\n    ctx.fill();\n    ctx.fillStyle = '#FFFFFF';\n    ctx.font = 'bold 16px sans-serif';\n    ctx.fillText(won ? '下一关' : '重试', this.screenW / 2 - btnW / 2 - 10, btnY + 27);\n\n    // Menu button\n    ctx.fillStyle = '#8D6E63';\n    this._roundRect(ctx, this.screenW / 2 + 10, btnY, btnW, btnH, btnH / 2);\n    ctx.fill();\n    ctx.fillStyle = '#FFFFFF';\n    ctx.fillText('菜单', this.screenW / 2 + btnW / 2 + 10, btnY + 27);\n  }\n\n  _roundRect(ctx, x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.lineTo(x + w - r, y);\n    ctx.quadraticCurveTo(x + w, y, x + w, y + r);\n    ctx.lineTo(x + w, y + h - r);\n    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);\n    ctx.lineTo(x + r, y + h);\n    ctx.quadraticCurveTo(x, y + h, x, y + h - r);\n    ctx.lineTo(x, y + r);\n    ctx.quadraticCurveTo(x, y, x + r, y);\n    ctx.closePath();\n  }\n}\n\nif (typeof module !== 'undefined') module.exports = { Renderer };\n","structuredPatch":[{"oldStart":1,"oldLines":6,"newStart":1,"newLines":4,"lines":[" // Renderer.js — Canvas 2D rendering engine for the match-3 board","-const { COLOR_MAP, BOARD_SIZE, SPECIAL_STRIPED_H, SPECIAL_STRIPED_V, SPECIAL_BOMB, SPECIAL_RAINBOW } =","-  typeof require !== 'undefined' ? require('./Board.js') : {};"," "," class Renderer {","   constructor(canvas) {"]}],"userModified":false,"replaceAll":false}}
