{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_8ebe02a6117e4ec8b4da591b","type":"tool_result","content":"1\t// App.ts — Game main loop (v0.4.0 — M4: 元婴+化神, 跨区域传送, 高级丹方, 终局内容)\n2\t\n3\timport { Renderer } from './Renderer';\n4\timport { GameMap } from '../game/Map';\n5\timport {\n6\t  type GameState,\n7\t  type BuildingInstance,\n8\t  type AlchemySessionData,\n9\t  type GameMap as GameMapData,\n10\t  type CrossRegionLink,\n11\t  createInitialState,\n12\t  cloneState,\n13\t  setMap,\n14\t  placeBuilding,\n15\t  loadGame,\n16\t  saveGame,\n17\t  startAutoSave,\n18\t  stopAutoSave,\n19\t  addAchievement,\n20\t  addCrossRegionLink,\n21\t} from '../game/GameState';\n22\timport {\n23\t  type BuildingDef,\n24\t  loadBuildingDefs,\n25\t  createBuildingInstance,\n26\t  canPlace,\n27\t} from '../game/Building';\n28\timport {\n29\t  collectFromBuilding,\n30\t  plantField,\n31\t  tickAutoProduction,\n32\t  tickManualProduction,\n33\t  canAfford,\n34\t  deductCost,\n35\t} from '../game/Resources';\n36\timport {\n37\t  type CultivationState,\n38\t  type BreakthroughResult,\n39\t  addCultivationExp,\n40\t  canBreakthrough,\n41\t  attemptBreakthrough,\n42\t  getBreakthroughRequirements,\n43\t  getFullRealmName,\n44\t  isRealmUnlocked as cultivationIsRealmUnlocked,\n45\t  tickAutoCultivation,\n46\t} from '../game/Cultivation';\n47\timport {\n48\t  type AlchemyRecipe,\n49\t  getAvailableRecipes,\n50\t  canCraft,\n51\t  startCrafting,\n52\t  tickAlchemy,\n53\t  collectAlchemy,\n54\t  getRemainingTime,\n55\t} from '../game/Alchemy';\n56\timport {\n57\t  usePill,\n58\t  useMultiplePills,\n59\t  getAllPillDefs,\n60\t  type PillDef,\n61\t} from '../game/Inventory';\n62\timport { audioManager } from '../game/AudioManager';\n63\timport { getAllAchievements, checkAchievement, type AchievementContext } from '../game/Achievement';\n64\timport { getAscensionChallenge, checkAscensionRequirements, attemptAscension } from '../game/Ascension';\n65\timport { tickCrossRegionLinks, createCrossRegionLink, renderCrossRegionPortal } from '../game/CrossRegionTeleport';\n66\timport type { Resources } from '../game/GameState';\n67\timport buildingData from '../data/buildings.json';\n68\timport regionData from '../data/regions.json';\n69\timport {\n70\t  type ConveyorSegment,\n71\t  type ConveyorItem,\n72\t  createSegment,\n73\t  buildSegmentMap,\n74\t  autoConnect,\n75\t  tickConveyorItems,\n76\t  renderConveyorSegment,\n77\t  renderConveyorItems,\n78\t} from '../game/ConveyorBelt';\n79\timport {\n80\t  type PuppetInstance,\n81\t  createPuppet,\n82\t  tickPuppet,\n83\t  renderPuppet,\n84\t} from '../game/Puppet';\n85\t\n86\texport type PlacementMode = BuildingDef | null;\n87\t\n88\texport interface GameNotification {\n89\t  id: number;\n90\t  text: string;\n91\t  type: 'info' | 'success' | 'warning' | 'error';\n92\t  time: number;\n93\t}\n94\t\n95\tinterface RegionDef {\n96\t  id: string;\n97\t  name: string;\n98\t  nameEn: string;\n99\t  width: number;\n100\t  height: number;\n101\t  unlockRealm: string;\n102\t  maxBuildings: number;\n103\t  specialResources: string[];\n104\t  terrainBase: string;\n105\t  color: { bg: string; grid: string };\n106\t}\n107\t\n108\tlet notifIdCounter = 0;\n109\t\n110\texport class App {\n111\t  canvas: HTMLCanvasElement;\n112\t  renderer: Renderer;\n113\t  state: GameState;\n114\t  buildingDefs: Map<string, BuildingDef>;\n115\t  regionDefs: RegionDef[];\n116\t  map: GameMap;\n117\t  currentRegionIndex = 0;\n118\t\n119\t  conveyorSegments: ConveyorSegment[] = [];\n120\t  conveyorItems: ConveyorItem[] = [];\n121\t  puppets: PuppetInstance[] = [];\n122\t\n123\t  private running = false;\n124\t  private lastFrameTime = 0;\n125\t  private animFrameId = 0;\n126\t  private lastTickTime = 0;\n127\t  private tickInterval = 200;\n128\t\n129\t  private hoveredCell: { gx: number; gy: number } | null = null;\n130\t  private clickStartTime = 0;\n131\t  private clickStartPos = { x: 0, y: 0 };\n132\t  placementMode: PlacementMode = null;\n133\t  private placementValid = false;\n134\t  private placementPos = { gx: 0, gy: 0 };\n135\t\n136\t  breakthroughAnim: { active: boolean; result: BreakthroughResult | null; startTime: number; duration: number } = {\n137\t    active: false,\n138\t    result: null,\n139\t    startTime: 0,\n140\t    duration: 3000,\n141\t  };\n142\t\n143\t  notifications: GameNotification[] = [];\n144\t\n145\t  // M4: Ascension animation\n146\t  ascensionAnim: { active: boolean; startTime: number; duration: number } = {\n147\t    active: false,\n148\t    startTime: 0,\n149\t    duration: 5000,\n150\t  };\n151\t\n152\t  onStateChange?: (state: GameState) => void;\n153\t  onBuildingSelect?: (building: BuildingInstance | null) => void;\n154\t  onNotification?: (notif: GameNotification) => void;\n155\t  onBreakthroughAnim?: (active: boolean, result: BreakthroughResult | null) => void;\n156\t  onAlchemyUpdate?: (session: AlchemySessionData | null) => void;\n157\t  onRegionChange?: (regionIndex: number, region: RegionDef) => void;\n158\t  onAchievementUnlocked?: (achievementId: string) => void;\n159\t\n160\t  constructor(canvas: HTMLCanvasElement) {\n161\t    this.canvas = canvas;\n162\t    this.renderer = new Renderer(canvas);\n163\t\n164\t    const saved = loadGame();\n165\t    this.state = saved ? saved : createInitialState();\n166\t\n167\t    this.buildingDefs = loadBuildingDefs(buildingData as unknown as { buildings: BuildingDef[] });\n168\t    this.regionDefs = (regionData as { regions: RegionDef[] }).regions;\n169\t\n170\t    this.map = new GameMap(20, 15, '#2a3a1a', '#3a4a2a');\n171\t    this.map.generateStartingArea();\n172\t\n173\t    if (this.state.maps.length === 0) {\n174\t      this.state = setMap(this.state, 0, {\n175\t        regionId: 'liqi_flat',\n176\t        width: 20,\n177\t        height: 15,\n178\t        terrain: this.map.terrain,\n179\t        buildings: [],\n180\t      });\n181\t    } else {\n182\t      const mapData = this.state.maps[this.state.currentRegionIndex];\n183\t      if (mapData) {\n184\t        this.currentRegionIndex = this.state.currentRegionIndex;\n185\t        this.loadRegionMap(this.currentRegionIndex);\n186\t      }\n187\t    }\n188\t\n189\t    this.setupInput(canvas);\n190\t\n191\t    window.addEventListener('resize', () => {\n192\t      this.renderer.resize();\n193\t    });\n194\t  }\n195\t\n196\t  private loadRegionMap(index: number): void {\n197\t    const mapData = this.state.maps[index];\n198\t    if (!mapData) return;\n199\t\n200\t    const regionDef = this.regionDefs.find(r => r.id === mapData.regionId);\n201\t    const bg = regionDef?.color.bg ?? '#2a3a1a';\n202\t    const grid = regionDef?.color.grid ?? '#3a4a2a';\n203\t\n204\t    this.map = new GameMap(mapData.width, mapData.height, bg, grid);\n205\t    this.map.terrain = mapData.terrain;\n206\t    this.currentRegionIndex = index;\n207\t  }\n208\t\n209\t  initRegion(regionDef: RegionDef): number {\n210\t    const existing = this.state.maps.findIndex(m => m.regionId === regionDef.id);\n211\t    if (existing >= 0) return existing;\n212\t\n213\t    const newMap = new GameMap(regionDef.width, regionDef.height, regionDef.color.bg, regionDef.color.grid);\n214\t    newMap.generateRegionTerrain(regionDef.id);\n215\t\n216\t    const index = this.state.maps.length;\n217\t    this.state = setMap(this.state, index, {\n218\t      regionId: regionDef.id,\n219\t      width: regionDef.width,\n220\t      height: regionDef.height,\n221\t      terrain: newMap.terrain,\n222\t      buildings: [],\n223\t    });\n224\t\n225\t    return index;\n226\t  }\n227\t\n228\t  switchRegion(index: number): boolean {\n229\t    if (index < 0 || index >= this.state.maps.length) return false;\n230\t    if (index === this.currentRegionIndex) return false;\n231\t\n232\t    this.currentRegionIndex = index;\n233\t    this.state.currentRegionIndex = index;\n234\t    this.loadRegionMap(index);\n235\t\n236\t    const regionDef = this.regionDefs.find(r => r.id === this.state.maps[index]?.regionId);\n237\t    if (regionDef) {\n238\t      this.onRegionChange?.(index, regionDef);\n239\t    }\n240\t\n241\t    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);\n242\t    this.onStateChange?.(this.state);\n243\t    return true;\n244\t  }\n245\t\n246\t  getUnlockedRegions(): Array<RegionDef & { index: number }> {\n247\t    return this.regionDefs\n248\t      .map((r) => {\n249\t        if (cultivationIsRealmUnlocked(r.unlockRealm, this.state.cultivation)) {\n250\t          const mapIndex = this.state.maps.findIndex(m => m.regionId === r.id);\n251\t          if (mapIndex < 0) {\n252\t            this.initRegion(r);\n253\t          }\n254\t          const actualIndex = Math.max(0, this.state.maps.findIndex(m => m.regionId === r.id));\n255\t          return { ...r, index: actualIndex };\n256\t        }\n257\t        return null;\n258\t      })\n259\t      .filter((r): r is RegionDef & { index: number } => r !== null);\n260\t  }\n261\t\n262\t  start(): void {\n263\t    if (this.running) return;\n264\t    this.running = true;\n265\t    this.lastFrameTime = performance.now();\n266\t    this.lastTickTime = this.lastFrameTime;\n267\t    this.loop(this.lastFrameTime);\n268\t\n269\t    startAutoSave(() => this.state);\n270\t  }\n271\t\n272\t  stop(): void {\n273\t    this.running = false;\n274\t    if (this.animFrameId) {\n275\t      cancelAnimationFrame(this.animFrameId);\n276\t    }\n277\t    stopAutoSave();\n278\t    saveGame(this.state);\n279\t  }\n280\t\n281\t  private loop = (now: number): void => {\n282\t    if (!this.running) return;\n283\t\n284\t    const dt = now - this.lastFrameTime;\n285\t    this.lastFrameTime = now;\n286\t\n287\t    this.state.totalPlaytime += dt / 1000;\n288\t\n289\t    if (now - this.lastTickTime >= this.tickInterval) {\n290\t      this.tickProduction(now);\n291\t      this.lastTickTime = now;\n292\t    }\n293\t\n294\t    this.render(now);\n295\t\n296\t    this.animFrameId = requestAnimationFrame(this.loop);\n297\t  };\n298\t\n299\t  private tickProduction(now: number): void {\n300\t    this.state = tickAutoProduction(this.state, this.currentRegionIndex, now, this.buildingDefs);\n301\t    this.state = tickManualProduction(this.state, this.currentRegionIndex, now, this.buildingDefs);\n302\t\n303\t    this.state.cultivation = tickAutoCultivation(this.state.cultivation, this.tickInterval);\n304\t\n305\t    if (this.state.alchemySession) {\n306\t      this.state.alchemySession = tickAlchemy(this.state.alchemySession, now);\n307\t      this.onAlchemyUpdate?.(this.state.alchemySession);\n308\t    }\n309\t\n310\t    // M3: Conveyor items tick\n311\t    if (this.conveyorSegments.length > 0) {\n312\t      const segMap = buildSegmentMap(this.conveyorSegments);\n313\t      const result = tickConveyorItems(this.conveyorItems, segMap, this.tickInterval);\n314\t      this.conveyorItems = result.items;\n315\t\n316\t      for (const d of result.delivered) {\n317\t        const delta: Partial<Resources> = {};\n318\t        (delta as Record<string, number>)[d.resource] = d.amount;\n319\t        this.state = { ...this.state, resources: { ...this.state.resources, [d.resource]: (this.state.resources[d.resource] ?? 0) + d.amount } };\n320\t      }\n321\t    }\n322\t\n323\t    // M3: Puppet tick\n324\t    for (let i = 0; i < this.puppets.length; i++) {\n325\t      this.puppets[i] = tickPuppet(this.puppets[i], this.tickInterval);\n326\t    }\n327\t\n328\t    // M4: Cross-region teleport tick\n329\t    if (this.state.crossRegionLinks.length > 0) {\n330\t      const crResult = tickCrossRegionLinks(this.state.crossRegionLinks, this.state.resources, now);\n331\t      this.state.crossRegionLinks = crResult.links;\n332\t\n333\t      for (const t of crResult.transferred) {\n334\t        this.state = { ...this.state, resources: { ...this.state.resources, [t.resource]: (this.state.resources[t.resource] ?? 0) + t.amount } };\n335\t      }\n336\t    }\n337\t\n338\t    // M4: Achievement check (every 5 seconds)\n339\t    if (Math.floor(now / 5000) !== Math.floor((now - this.tickInterval) / 5000)) {\n340\t      this.checkAchievements();\n341\t    }\n342\t\n343\t    this.onStateChange?.(this.state);\n344\t  }\n345\t\n346\t  // M4: Achievement checking\n347\t  private checkAchievements(): void {\n348\t    const buildingCounts: Record<string, number> = {};\n349\t    let totalBuildingCount = 0;\n350\t    for (const map of this.state.maps) {\n351\t      for (const b of map.buildings) {\n352\t        buildingCounts[b.buildingId] = (buildingCounts[b.buildingId] ?? 0) + 1;\n353\t        totalBuildingCount++;\n354\t      }\n355\t    }\n356\t\n357\t    const unlockedRegions = this.regionDefs\n358\t      .filter(r => cultivationIsRealmUnlocked(r.unlockRealm, this.state.cultivation))\n359\t      .map(r => r.id);\n360\t\n361\t    const context: AchievementContext = {\n362\t      currentRealmId: this.state.cultivation.realmId,\n363\t      realmOrder: ['fanren', 'liqi', 'zhuji', 'jindan', 'yuanying', 'huashen'],\n364\t      totalResourcesCollected: this.state.resources as Record<string, number>,\n365\t      buildingCounts,\n366\t      totalBuildingCount,\n367\t      pillsCrafted: {},\n368\t      totalPillsCrafted: 0,\n369\t      allPillTypesCrafted: false,\n370\t      unlockedRegions,\n371\t      ascensionCompleted: this.state.ascensionCompleted,\n372\t      playtimeHours: this.state.totalPlaytime / 3600,\n373\t      crossRegionLinkCount: this.state.crossRegionLinks.length,\n374\t    };\n375\t\n376\t    for (const ach of getAllAchievements()) {\n377\t      if (this.state.achievements.includes(ach.id)) continue;\n378\t      if (checkAchievement(ach, context)) {\n379\t        this.state = addAchievement(this.state, ach.id);\n380\t        this.addNotification(`🏆 成就解锁: ${ach.name}`, 'success');\n381\t        this.onAchievementUnlocked?.(ach.id);\n382\t      }\n383\t    }\n384\t  }\n385\t\n386\t  private render(now: number): void {\n387\t    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n388\t    const preview = this.placementMode\n389\t      ? { def: this.placementMode, gx: this.placementPos.gx, gy: this.placementPos.gy, valid: this.placementValid }\n390\t      : null;\n391\t\n392\t    this.renderer.render(\n393\t      this.map,\n394\t      buildings,\n395\t      this.buildingDefs,\n396\t      this.state.resources,\n397\t      this.state.realm,\n398\t      this.state.cultivation,\n399\t      this.hoveredCell,\n400\t      preview,\n401\t      now,\n402\t    );\n403\t\n404\t    const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n405\t    const segMap = buildSegmentMap(this.conveyorSegments);\n406\t    for (const seg of this.conveyorSegments) {\n407\t      renderConveyorSegment(this.renderer.ctx, seg, offsetX, offsetY, scale, this.map.cellSize, now);\n408\t    }\n409\t    renderConveyorItems(this.renderer.ctx, this.conveyorItems, segMap, offsetX, offsetY, scale, this.map.cellSize);\n410\t\n411\t    for (const puppet of this.puppets) {\n412\t      renderPuppet(this.renderer.ctx, puppet, offsetX, offsetY, scale, this.map.cellSize, now);\n413\t    }\n414\t\n415\t    // M4: Render cross-region portals in current map\n416\t    for (const link of this.state.crossRegionLinks) {\n417\t      if (link.fromRegionIndex === this.currentRegionIndex) {\n418\t        renderCrossRegionPortal(this.renderer.ctx, link.fromX, link.fromY, offsetX, offsetY, scale, this.map.cellSize, now);\n419\t      }\n420\t    }\n421\t\n422\t    if (this.breakthroughAnim.active) {\n423\t      this.renderBreakthroughOverlay(now);\n424\t    }\n425\t\n426\t    if (this.ascensionAnim.active) {\n427\t      this.renderAscensionOverlay(now);\n428\t    }\n429\t  }\n430\t\n431\t  private renderBreakthroughOverlay(now: number): void {\n432\t    const ctx = this.renderer.ctx;\n433\t    const w = this.canvas.getBoundingClientRect().width;\n434\t    const h = this.canvas.getBoundingClientRect().height;\n435\t\n436\t    const elapsed = now - this.breakthroughAnim.startTime;\n437\t    const progress = Math.min(1, elapsed / this.breakthroughAnim.duration);\n438\t\n439\t    let alpha = 0;\n440\t    if (progress < 0.2) alpha = progress / 0.2;\n441\t    else if (progress > 0.8) alpha = (1 - progress) / 0.2;\n442\t    else alpha = 1;\n443\t\n444\t    const result = this.breakthroughAnim.result;\n445\t\n446\t    if (result?.success) {\n447\t      ctx.fillStyle = `rgba(255, 215, 0, ${alpha * 0.15})`;\n448\t      ctx.fillRect(0, 0, w, h);\n449\t\n450\t      ctx.fillStyle = `rgba(255, 215, 0, ${alpha})`;\n451\t      ctx.font = `bold ${24 + Math.sin(progress * Math.PI * 4) * 4}px serif`;\n452\t      ctx.textAlign = 'center';\n453\t      ctx.textBaseline = 'middle';\n454\t      ctx.fillText('⚡ 境界突破成功 ⚡', w / 2, h / 2 - 20);\n455\t\n456\t      ctx.font = '16px serif';\n457\t      ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;\n458\t      const realmName = getFullRealmName(this.state.cultivation);\n459\t      ctx.fillText(`进入 ${realmName}`, w / 2, h / 2 + 20);\n460\t    } else if (result) {\n461\t      ctx.fillStyle = `rgba(200, 50, 50, ${alpha * 0.15})`;\n462\t      ctx.fillRect(0, 0, w, h);\n463\t\n464\t      ctx.fillStyle = `rgba(255, 100, 100, ${alpha})`;\n465\t      ctx.font = 'bold 24px serif';\n466\t      ctx.textAlign = 'center';\n467\t      ctx.textBaseline = 'middle';\n468\t      ctx.fillText('突破失败...', w / 2, h / 2 - 20);\n469\t\n470\t      ctx.font = '14px serif';\n471\t      ctx.fillStyle = `rgba(255, 200, 200, ${alpha})`;\n472\t      ctx.fillText(`修为损失 ${Math.floor(result.penalty * 100)}%`, w / 2, h / 2 + 20);\n473\t    }\n474\t\n475\t    if (progress >= 1) {\n476\t      this.breakthroughAnim.active = false;\n477\t      this.breakthroughAnim.result = null;\n478\t      this.onBreakthroughAnim?.(false, null);\n479\t    }\n480\t  }\n481\t\n482\t  // M4: Ascension animation overlay\n483\t  private renderAscensionOverlay(now: number): void {\n484\t    const ctx = this.renderer.ctx;\n485\t    const w = this.canvas.getBoundingClientRect().width;\n486\t    const h = this.canvas.getBoundingClientRect().height;\n487\t\n488\t    const elapsed = now - this.ascensionAnim.startTime;\n489\t    const progress = Math.min(1, elapsed / this.ascensionAnim.duration);\n490\t\n491\t    // Golden-white gradient overlay\n492\t    let alpha = 0;\n493\t    if (progress < 0.15) alpha = progress / 0.15;\n494\t    else if (progress > 0.85) alpha = (1 - progress) / 0.15;\n495\t    else alpha = 1;\n496\t\n497\t    ctx.fillStyle = `rgba(255, 255, 200, ${alpha * 0.2})`;\n498\t    ctx.fillRect(0, 0, w, h);\n499\t\n500\t    // Radiating lines\n501\t    const centerX = w / 2;\n502\t    const centerY = h / 2;\n503\t    const lineCount = 12;\n504\t    for (let i = 0; i < lineCount; i++) {\n505\t      const angle = (i / lineCount) * Math.PI * 2 + progress * Math.PI;\n506\t      const len = 200 + Math.sin(progress * Math.PI * 6 + i) * 100;\n507\t      ctx.strokeStyle = `rgba(255, 215, 0, ${alpha * 0.3})`;\n508\t      ctx.lineWidth = 2;\n509\t      ctx.beginPath();\n510\t      ctx.moveTo(centerX, centerY);\n511\t      ctx.lineTo(centerX + Math.cos(angle) * len, centerY + Math.sin(angle) * len);\n512\t      ctx.stroke();\n513\t    }\n514\t\n515\t    ctx.fillStyle = `rgba(255, 215, 0, ${alpha})`;\n516\t    ctx.font = `bold ${28 + Math.sin(progress * Math.PI * 3) * 6}px serif`;\n517\t    ctx.textAlign = 'center';\n518\t    ctx.textBaseline = 'middle';\n519\t    ctx.fillText('🌟 飞升成功 🌟', w / 2, h / 2 - 30);\n520\t\n521\t    ctx.font = '18px serif';\n522\t    ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;\n523\t    ctx.fillText('飞升仙尊 — 全局效率×10', w / 2, h / 2 + 15);\n524\t\n525\t    ctx.font = '14px serif';\n526\t    ctx.fillStyle = `rgba(200, 200, 255, ${alpha})`;\n527\t    ctx.fillText('恭喜完成飞升挑战！', w / 2, h / 2 + 50);\n528\t\n529\t    if (progress >= 1) {\n530\t      this.ascensionAnim.active = false;\n531\t    }\n532\t  }\n533\t\n534\t  placeCurrentBuilding(): boolean {\n535\t    if (!this.placementMode) return false;\n536\t\n537\t    const def = this.placementMode;\n538\t    const { gx, gy } = this.placementPos;\n539\t\n540\t    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n541\t    if (!canPlace(this.map, def, gx, gy, buildings)) return false;\n542\t    if (!canAfford(this.state.resources, def.cost)) return false;\n543\t\n544\t    this.state = deductCost(this.state, def.cost);\n545\t\n546\t    // Handle conveyor/puppet placement\n547\t    if (def.category === 'transport' && (def.id === 'conveyor_lv1' || def.id === 'conveyor_lv2')) {\n548\t      const seg = createSegment(\n549\t        `seg_${Date.now()}_${Math.random().toString(36).slice(2)}`,\n550\t        gx, gy,\n551\t        def.id === 'conveyor_lv1' ? 1 : 2,\n552\t        'right',\n553\t      );\n554\t      const segMap = buildSegmentMap(this.conveyorSegments);\n555\t      this.conveyorSegments.push(autoConnect(seg, segMap));\n556\t      audioManager.playBuild();\n557\t      this.addNotification(`放置了 ${def.name}`, 'success');\n558\t      this.onStateChange?.(this.state);\n559\t      return true;\n560\t    }\n561\t\n562\t    if (def.category === 'automation' && def.id === 'puppet_sorter') {\n563\t      const puppet = createPuppet(\n564\t        `pup_${Date.now()}_${Math.random().toString(36).slice(2)}`,\n565\t        gx, gy, 1,\n566\t      );\n567\t      this.puppets.push(puppet);\n568\t      audioManager.playBuild();\n569\t      this.addNotification(`放置了 ${def.name}`, 'success');\n570\t      this.onStateChange?.(this.state);\n571\t      return true;\n572\t    }\n573\t\n574\t    const instance = createBuildingInstance(def.id, gx, gy);\n575\t    this.state = placeBuilding(this.state, this.currentRegionIndex, instance);\n576\t\n577\t    audioManager.playBuild();\n578\t    this.addNotification(`建造了 ${def.name}`, 'success');\n579\t    this.onStateChange?.(this.state);\n580\t    return true;\n581\t  }\n582\t\n583\t  private handleBuildingClick(building: BuildingInstance): void {\n584\t    const def = this.buildingDefs.get(building.buildingId);\n585\t    if (!def) return;\n586\t\n587\t    if (def.production.mode === 'manual') {\n588\t      if (def.category === 'farming') {\n589\t        if (!building.isProducing && building.progress < 1) {\n590\t          this.state = plantField(this.state, building, this.currentRegionIndex);\n591\t          audioManager.playCollect();\n592\t        } else if (building.progress >= 1) {\n593\t          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n594\t          audioManager.playHarvest();\n595\t          this.addNotification(`收获 ${def.production.amount} ${this.getResourceName(def.production.resource)}`, 'success');\n596\t        }\n597\t      } else if (def.category === 'mining') {\n598\t        this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n599\t        audioManager.playCollect();\n600\t      } else if (def.category === 'alchemy') {\n601\t        if (building.progress >= 1) {\n602\t          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n603\t          audioManager.playAlchemyComplete();\n604\t          this.addNotification(`获得 ${def.production.amount} ${this.getResourceName(def.production.resource)}`, 'success');\n605\t        } else if (!building.isProducing) {\n606\t          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n607\t          audioManager.playAlchemyStart();\n608\t        }\n609\t      } else if (def.category === 'cultivation') {\n610\t        if (!building.isProducing) {\n611\t          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n612\t        }\n613\t      }\n614\t      this.onStateChange?.(this.state);\n615\t    }\n616\t\n617\t    this.onBuildingSelect?.(building);\n618\t  }\n619\t\n620\t  usePillAction(pillId: string): boolean {\n621\t    const result = usePill(pillId, this.state.resources);\n622\t    if (!result) return false;\n623\t\n624\t    this.state.resources = result.resources as Resources;\n625\t    this.state.cultivation = addCultivationExp(this.state.cultivation, result.cultivation);\n626\t    this.state = this.addCultivationToRealm(result.cultivation);\n627\t\n628\t    audioManager.playUsePill();\n629\t    const pillName = this.getResourceName(pillId);\n630\t    this.addNotification(`服用 ${pillName}，修为+${result.cultivation}`, 'success');\n631\t    this.onStateChange?.(this.state);\n632\t    return true;\n633\t  }\n634\t\n635\t  useAllPills(pillId: string): boolean {\n636\t    const count = this.state.resources[pillId as keyof typeof this.state.resources] ?? 0;\n637\t    if (count <= 0) return false;\n638\t\n639\t    const result = useMultiplePills(pillId, count, this.state.resources);\n640\t    if (!result) return false;\n641\t\n642\t    this.state.resources = result.resources as Resources;\n643\t    this.state.cultivation = addCultivationExp(this.state.cultivation, result.cultivation);\n644\t    this.state = this.addCultivationToRealm(result.cultivation);\n645\t\n646\t    audioManager.playUsePill();\n647\t    this.addNotification(`服用 ${result.used} ${this.getResourceName(pillId)}，修为+${result.cultivation}`, 'success');\n648\t    this.onStateChange?.(this.state);\n649\t    return true;\n650\t  }\n651\t\n652\t  private addCultivationToRealm(amount: number): GameState {\n653\t    const next = cloneState(this.state);\n654\t    next.realm.exp += amount;\n655\t    while (next.realm.exp >= next.realm.expToNext) {\n656\t      next.realm.exp -= next.realm.expToNext;\n657\t      next.realm.level += 1;\n658\t      next.realm.expToNext = Math.floor(next.realm.expToNext * 1.8);\n659\t    }\n660\t    return next;\n661\t  }\n662\t\n663\t  attemptBreakthroughAction(): boolean {\n664\t    if (!canBreakthrough(this.state.cultivation)) {\n665\t      this.addNotification('修为不足，无法突破', 'warning');\n666\t      return false;\n667\t    }\n668\t\n669\t    const result = attemptBreakthrough(this.state.cultivation, this.state.resources);\n670\t    if (!result) {\n671\t      this.addNotification('材料不足，无法突破', 'warning');\n672\t      return false;\n673\t    }\n674\t\n675\t    this.state.cultivation = result.newState;\n676\t    this.state.resources = result.newResources as Resources;\n677\t\n678\t    if (result.result.success) {\n679\t      this.state.realm.realmId = result.newState.realmId;\n680\t      this.state.realm.level = result.newState.level;\n681\t      this.state.realm.exp = result.newState.exp;\n682\t      this.state.realm.expToNext = result.newState.expToNext;\n683\t    }\n684\t\n685\t    this.breakthroughAnim = {\n686\t      active: true,\n687\t      result: result.result,\n688\t      startTime: performance.now(),\n689\t      duration: 3000,\n690\t    };\n691\t\n692\t    if (result.result.success) {\n693\t      audioManager.playBreakthroughSuccess();\n694\t      this.addNotification(`突破成功！进入 ${getFullRealmName(this.state.cultivation)}`, 'success');\n695\t    } else {\n696\t      audioManager.playBreakthroughFail();\n697\t      this.addNotification(`突破失败，修为损失 ${Math.floor(result.result.penalty * 100)}%`, 'error');\n698\t    }\n699\t\n700\t    this.onBreakthroughAnim?.(true, result.result);\n701\t    this.onStateChange?.(this.state);\n702\t    return true;\n703\t  }\n704\t\n705\t  getBreakthroughInfo() {\n706\t    return getBreakthroughRequirements(this.state.cultivation);\n707\t  }\n708\t\n709\t  // === M4: Ascension Actions ===\n710\t\n711\t  getAscensionInfo() {\n712\t    return checkAscensionRequirements(this.state.resources, this.state.cultivation.totalCultivation);\n713\t  }\n714\t\n715\t  attemptAscensionAction(): boolean {\n716\t    const result = attemptAscension(this.state.resources, this.state.cultivation.totalCultivation);\n717\t    if (!result.success) {\n718\t      this.addNotification('飞升条件不满足', 'warning');\n719\t      return false;\n720\t    }\n721\t\n722\t    this.state.resources = result.newResources as Resources;\n723\t    this.state.ascensionCompleted = true;\n724\t\n725\t    this.ascensionAnim = {\n726\t      active: true,\n727\t      startTime: performance.now(),\n728\t      duration: 5000,\n729\t    };\n730\t\n731\t    audioManager.playBreakthroughSuccess();\n732\t    this.addNotification('🌟 飞升成功！获得称号：飞升仙尊', 'success');\n733\t    this.onStateChange?.(this.state);\n734\t    return true;\n735\t  }\n736\t\n737\t  // === M4: Cross-Region Link ===\n738\t\n739\t  createCrossRegionLinkAction(\n740\t    fromRegionIndex: number,\n741\t    fromX: number,\n742\t    fromY: number,\n743\t    toRegionIndex: number,\n744\t    toX: number,\n745\t    toY: number,\n746\t    resource: string,\n747\t    amount: number,\n748\t    interval: number,\n749\t  ): boolean {\n750\t    const id = `crl_${Date.now()}_${Math.random().toString(36).slice(2)}`;\n751\t    const link = createCrossRegionLink(id, fromRegionIndex, fromX, fromY, toRegionIndex, toX, toY, resource, amount, interval);\n752\t    this.state = addCrossRegionLink(this.state, link);\n753\t    this.addNotification(`建立跨区域传送链路`, 'success');\n754\t    this.onStateChange?.(this.state);\n755\t    return true;\n756\t  }\n757\t\n758\t  // === Alchemy Actions ===\n759\t\n760\t  getAvailableAlchemyRecipes(): AlchemyRecipe[] {\n761\t    return getAvailableRecipes((realm) => cultivationIsRealmUnlocked(realm, this.state.cultivation));\n762\t  }\n763\t\n764\t  startAlchemyAction(recipeId: string): boolean {\n765\t    const crafting = startCrafting(recipeId, this.state.resources);\n766\t    if (!crafting) return false;\n767\t\n768\t    this.state.resources = crafting.resources as Resources;\n769\t    this.state.alchemySession = crafting.session;\n770\t    audioManager.playAlchemyStart();\n771\t    this.addNotification(`开始炼丹`, 'info');\n772\t    this.onStateChange?.(this.state);\n773\t    this.onAlchemyUpdate?.(this.state.alchemySession);\n774\t    return true;\n775\t  }\n776\t\n777\t  collectAlchemyAction(): boolean {\n778\t    if (!this.state.alchemySession?.complete) return false;\n779\t\n780\t    const result = collectAlchemy(this.state.alchemySession, this.state.resources);\n781\t    if (!result) return false;\n782\t\n783\t    this.state.resources = result.resources as Resources;\n784\t    this.state.alchemySession = null;\n785\t\n786\t    if (result.success) {\n787\t      this.state.cultivation = addCultivationExp(this.state.cultivation, result.expReward);\n788\t      audioManager.playAlchemyComplete();\n789\t      this.addNotification(`炼丹成功！获得 ${result.amount} 颗丹药`, 'success');\n790\t    } else {\n791\t      audioManager.playAlchemyFail();\n792\t      this.addNotification('炼丹失败...', 'error');\n793\t    }\n794\t\n795\t    this.onStateChange?.(this.state);\n796\t    this.onAlchemyUpdate?.(null);\n797\t    return true;\n798\t  }\n799\t\n800\t  // === Notifications ===\n801\t\n802\t  addNotification(text: string, type: GameNotification['type'] = 'info'): void {\n803\t    const notif: GameNotification = {\n804\t      id: ++notifIdCounter,\n805\t      text,\n806\t      type,\n807\t      time: Date.now(),\n808\t    };\n809\t    this.notifications.push(notif);\n810\t    if (this.notifications.length > 10) {\n811\t      this.notifications = this.notifications.slice(-10);\n812\t    }\n813\t    this.onNotification?.(notif);\n814\t  }\n815\t\n816\t  // === Utility ===\n817\t\n818\t  private getResourceName(id: string): string {\n819\t    const names: Record<string, string> = {\n820\t      spirit_stone: '灵石',\n821\t      spirit_grass: '灵草',\n822\t      spirit_energy: '灵气',\n823\t      cultivation: '修为',\n824\t      pill_juling: '聚灵丹',\n825\t      pill_peiyuan: '培元丹',\n826\t      pill_ningqi: '凝气丹',\n827\t      pill_zhuji: '筑基丹',\n828\t      pill_jindanyin: '金丹引',\n829\t      pill_yuanyingguo: '元婴果',\n830\t      pill_huashenlu: '化神露',\n831\t      pill_jiuzhuan: '九转金丹',\n832\t      spirit_iron: '灵铁',\n833\t      spirit_wood: '灵木',\n834\t      talisman_paper: '符纸',\n835\t      monster_core: '妖丹',\n836\t      heaven_earth_liquid: '天地灵液',\n837\t      immortal_stone: '仙灵石',\n838\t      merit: '功德值',\n839\t    };\n840\t    return names[id] ?? id;\n841\t  }\n842\t\n843\t  centerCamera(): void {\n844\t    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);\n845\t  }\n846\t\n847\t  getAvailableBuildings(): BuildingDef[] {\n848\t    return Array.from(this.buildingDefs.values()).filter(def => {\n849\t      return cultivationIsRealmUnlocked(def.unlockRealm, this.state.cultivation);\n850\t    });\n851\t  }\n852\t\n853\t  getInventoryPills(): Array<PillDef & { count: number }> {\n854\t    const result: Array<PillDef & { count: number }> = [];\n855\t    for (const def of getAllPillDefs()) {\n856\t      const count = this.state.resources[def.id as keyof typeof this.state.resources] ?? 0;\n857\t      if (count > 0) {\n858\t        result.push({ ...def, count });\n859\t      }\n860\t    }\n861\t    return result;\n862\t  }\n863\t\n864\t  private setupInput(canvas: HTMLCanvasElement): void {\n865\t    canvas.addEventListener('mousemove', (e) => {\n866\t      const rect = canvas.getBoundingClientRect();\n867\t      const mx = e.clientX - rect.left;\n868\t      const my = e.clientY - rect.top;\n869\t\n870\t      const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n871\t      this.hoveredCell = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n872\t\n873\t      if (this.placementMode && this.hoveredCell) {\n874\t        this.placementPos = { gx: this.hoveredCell.gx, gy: this.hoveredCell.gy };\n875\t        const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n876\t        this.placementValid = canPlace(\n877\t          this.map,\n878\t          this.placementMode,\n879\t          this.placementPos.gx,\n880\t          this.placementPos.gy,\n881\t          buildings,\n882\t        );\n883\t      }\n884\t    });\n885\t\n886\t    canvas.addEventListener('mousedown', (e) => {\n887\t      if (e.button !== 0) return;\n888\t      this.clickStartTime = performance.now();\n889\t      this.clickStartPos = { x: e.clientX, y: e.clientY };\n890\t    });\n891\t\n892\t    canvas.addEventListener('mouseup', (e) => {\n893\t      if (e.button !== 0) return;\n894\t      const dt = performance.now() - this.clickStartTime;\n895\t      const dx = Math.abs(e.clientX - this.clickStartPos.x);\n896\t      const dy = Math.abs(e.clientY - this.clickStartPos.y);\n897\t\n898\t      if (dt < 300 && dx < 5 && dy < 5) {\n899\t        audioManager.init();\n900\t        audioManager.resume();\n901\t        this.handleClick(e);\n902\t      }\n903\t    });\n904\t\n905\t    document.addEventListener('keydown', (e) => {\n906\t      if (e.key === 'Escape') {\n907\t        this.placementMode = null;\n908\t      }\n909\t    });\n910\t  }\n911\t\n912\t  private handleClick(e: MouseEvent): void {\n913\t    const rect = this.canvas.getBoundingClientRect();\n914\t    const mx = e.clientX - rect.left;\n915\t    const my = e.clientY - rect.top;\n916\t    const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n917\t    const { gx, gy } = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n918\t\n919\t    if (!this.map.inBounds(gx, gy)) return;\n920\t\n921\t    if (this.placementMode) {\n922\t      this.placementPos = { gx, gy };\n923\t      const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n924\t      this.placementValid = canPlace(this.map, this.placementMode, gx, gy, buildings);\n925\t      if (this.placementValid) {\n926\t        this.placeCurrentBuilding();\n927\t      }\n928\t      return;\n929\t    }\n930\t\n931\t    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n932\t    const clicked = buildings.find(b => {\n933\t      const def = this.buildingDefs.get(b.buildingId);\n934\t      if (!def) return false;\n935\t      return (\n936\t        gx >= b.gridX && gx < b.gridX + def.size.w &&\n937\t        gy >= b.gridY && gy < b.gridY + def.size.h\n938\t      );\n939\t    });\n940\t\n941\t    if (clicked) {\n942\t      this.handleBuildingClick(clicked);\n943\t    }\n944\t  }\n945\t}\n946\t"}]},"parent_tool_use_id":null,"session_id":"6abd1a50-ca4f-4f48-ad3d-d0b1dc08d31a","uuid":"d329c0ad-ed83-44aa-ba1e-ac121068be70","timestamp":"2026-05-23T02:34:46.369Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\renderer\\App.ts","content":"// App.ts — Game main loop (v0.4.0 — M4: 元婴+化神, 跨区域传送, 高级丹方, 终局内容)\n\nimport { Renderer } from './Renderer';\nimport { GameMap } from '../game/Map';\nimport {\n  type GameState,\n  type BuildingInstance,\n  type AlchemySessionData,\n  type GameMap as GameMapData,\n  type CrossRegionLink,\n  createInitialState,\n  cloneState,\n  setMap,\n  placeBuilding,\n  loadGame,\n  saveGame,\n  startAutoSave,\n  stopAutoSave,\n  addAchievement,\n  addCrossRegionLink,\n} from '../game/GameState';\nimport {\n  type BuildingDef,\n  loadBuildingDefs,\n  createBuildingInstance,\n  canPlace,\n} from '../game/Building';\nimport {\n  collectFromBuilding,\n  plantField,\n  tickAutoProduction,\n  tickManualProduction,\n  canAfford,\n  deductCost,\n} from '../game/Resources';\nimport {\n  type CultivationState,\n  type BreakthroughResult,\n  addCultivationExp,\n  canBreakthrough,\n  attemptBreakthrough,\n  getBreakthroughRequirements,\n  getFullRealmName,\n  isRealmUnlocked as cultivationIsRealmUnlocked,\n  tickAutoCultivation,\n} from '../game/Cultivation';\nimport {\n  type AlchemyRecipe,\n  getAvailableRecipes,\n  canCraft,\n  startCrafting,\n  tickAlchemy,\n  collectAlchemy,\n  getRemainingTime,\n} from '../game/Alchemy';\nimport {\n  usePill,\n  useMultiplePills,\n  getAllPillDefs,\n  type PillDef,\n} from '../game/Inventory';\nimport { audioManager } from '../game/AudioManager';\nimport { getAllAchievements, checkAchievement, type AchievementContext } from '../game/Achievement';\nimport { getAscensionChallenge, checkAscensionRequirements, attemptAscension } from '../game/Ascension';\nimport { tickCrossRegionLinks, createCrossRegionLink, renderCrossRegionPortal } from '../game/CrossRegionTeleport';\nimport type { Resources } from '../game/GameState';\nimport buildingData from '../data/buildings.json';\nimport regionData from '../data/regions.json';\nimport {\n  type ConveyorSegment,\n  type ConveyorItem,\n  createSegment,\n  buildSegmentMap,\n  autoConnect,\n  tickConveyorItems,\n  renderConveyorSegment,\n  renderConveyorItems,\n} from '../game/ConveyorBelt';\nimport {\n  type PuppetInstance,\n  createPuppet,\n  tickPuppet,\n  renderPuppet,\n} from '../game/Puppet';\n\nexport type PlacementMode = BuildingDef | null;\n\nexport interface GameNotification {\n  id: number;\n  text: string;\n  type: 'info' | 'success' | 'warning' | 'error';\n  time: number;\n}\n\ninterface RegionDef {\n  id: string;\n  name: string;\n  nameEn: string;\n  width: number;\n  height: number;\n  unlockRealm: string;\n  maxBuildings: number;\n  specialResources: string[];\n  terrainBase: string;\n  color: { bg: string; grid: string };\n}\n\nlet notifIdCounter = 0;\n\nexport class App {\n  canvas: HTMLCanvasElement;\n  renderer: Renderer;\n  state: GameState;\n  buildingDefs: Map<string, BuildingDef>;\n  regionDefs: RegionDef[];\n  map: GameMap;\n  currentRegionIndex = 0;\n\n  conveyorSegments: ConveyorSegment[] = [];\n  conveyorItems: ConveyorItem[] = [];\n  puppets: PuppetInstance[] = [];\n\n  private running = false;\n  private lastFrameTime = 0;\n  private animFrameId = 0;\n  private lastTickTime = 0;\n  private tickInterval = 200;\n\n  private hoveredCell: { gx: number; gy: number } | null = null;\n  private clickStartTime = 0;\n  private clickStartPos = { x: 0, y: 0 };\n  placementMode: PlacementMode = null;\n  private placementValid = false;\n  private placementPos = { gx: 0, gy: 0 };\n\n  breakthroughAnim: { active: boolean; result: BreakthroughResult | null; startTime: number; duration: number } = {\n    active: false,\n    result: null,\n    startTime: 0,\n    duration: 3000,\n  };\n\n  notifications: GameNotification[] = [];\n\n  // M4: Ascension animation\n  ascensionAnim: { active: boolean; startTime: number; duration: number } = {\n    active: false,\n    startTime: 0,\n    duration: 5000,\n  };\n\n  onStateChange?: (state: GameState) => void;\n  onBuildingSelect?: (building: BuildingInstance | null) => void;\n  onNotification?: (notif: GameNotification) => void;\n  onBreakthroughAnim?: (active: boolean, result: BreakthroughResult | null) => void;\n  onAlchemyUpdate?: (session: AlchemySessionData | null) => void;\n  onRegionChange?: (regionIndex: number, region: RegionDef) => void;\n  onAchievementUnlocked?: (achievementId: string) => void;\n\n  constructor(canvas: HTMLCanvasElement) {\n    this.canvas = canvas;\n    this.renderer = new Renderer(canvas);\n\n    const saved = loadGame();\n    this.state = saved ? saved : createInitialState();\n\n    this.buildingDefs = loadBuildingDefs(buildingData as unknown as { buildings: BuildingDef[] });\n    this.regionDefs = (regionData as { regions: RegionDef[] }).regions;\n\n    this.map = new GameMap(20, 15, '#2a3a1a', '#3a4a2a');\n    this.map.generateStartingArea();\n\n    if (this.state.maps.length === 0) {\n      this.state = setMap(this.state, 0, {\n        regionId: 'liqi_flat',\n        width: 20,\n        height: 15,\n        terrain: this.map.terrain,\n        buildings: [],\n      });\n    } else {\n      const mapData = this.state.maps[this.state.currentRegionIndex];\n      if (mapData) {\n        this.currentRegionIndex = this.state.currentRegionIndex;\n        this.loadRegionMap(this.currentRegionIndex);\n      }\n    }\n\n    this.setupInput(canvas);\n\n    window.addEventListener('resize', () => {\n      this.renderer.resize();\n    });\n  }\n\n  private loadRegionMap(index: number): void {\n    const mapData = this.state.maps[index];\n    if (!mapData) return;\n\n    const regionDef = this.regionDefs.find(r => r.id === mapData.regionId);\n    const bg = regionDef?.color.bg ?? '#2a3a1a';\n    const grid = regionDef?.color.grid ?? '#3a4a2a';\n\n    this.map = new GameMap(mapData.width, mapData.height, bg, grid);\n    this.map.terrain = mapData.terrain;\n    this.currentRegionIndex = index;\n  }\n\n  initRegion(regionDef: RegionDef): number {\n    const existing = this.state.maps.findIndex(m => m.regionId === regionDef.id);\n    if (existing >= 0) return existing;\n\n    const newMap = new GameMap(regionDef.width, regionDef.height, regionDef.color.bg, regionDef.color.grid);\n    newMap.generateRegionTerrain(regionDef.id);\n\n    const index = this.state.maps.length;\n    this.state = setMap(this.state, index, {\n      regionId: regionDef.id,\n      width: regionDef.width,\n      height: regionDef.height,\n      terrain: newMap.terrain,\n      buildings: [],\n    });\n\n    return index;\n  }\n\n  switchRegion(index: number): boolean {\n    if (index < 0 || index >= this.state.maps.length) return false;\n    if (index === this.currentRegionIndex) return false;\n\n    this.currentRegionIndex = index;\n    this.state.currentRegionIndex = index;\n    this.loadRegionMap(index);\n\n    const regionDef = this.regionDefs.find(r => r.id === this.state.maps[index]?.regionId);\n    if (regionDef) {\n      this.onRegionChange?.(index, regionDef);\n    }\n\n    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  getUnlockedRegions(): Array<RegionDef & { index: number }> {\n    return this.regionDefs\n      .map((r) => {\n        if (cultivationIsRealmUnlocked(r.unlockRealm, this.state.cultivation)) {\n          const mapIndex = this.state.maps.findIndex(m => m.regionId === r.id);\n          if (mapIndex < 0) {\n            this.initRegion(r);\n          }\n          const actualIndex = Math.max(0, this.state.maps.findIndex(m => m.regionId === r.id));\n          return { ...r, index: actualIndex };\n        }\n        return null;\n      })\n      .filter((r): r is RegionDef & { index: number } => r !== null);\n  }\n\n  start(): void {\n    if (this.running) return;\n    this.running = true;\n    this.lastFrameTime = performance.now();\n    this.lastTickTime = this.lastFrameTime;\n    this.loop(this.lastFrameTime);\n\n    startAutoSave(() => this.state);\n  }\n\n  stop(): void {\n    this.running = false;\n    if (this.animFrameId) {\n      cancelAnimationFrame(this.animFrameId);\n    }\n    stopAutoSave();\n    saveGame(this.state);\n  }\n\n  private loop = (now: number): void => {\n    if (!this.running) return;\n\n    const dt = now - this.lastFrameTime;\n    this.lastFrameTime = now;\n\n    this.state.totalPlaytime += dt / 1000;\n\n    if (now - this.lastTickTime >= this.tickInterval) {\n      this.tickProduction(now);\n      this.lastTickTime = now;\n    }\n\n    this.render(now);\n\n    this.animFrameId = requestAnimationFrame(this.loop);\n  };\n\n  private tickProduction(now: number): void {\n    this.state = tickAutoProduction(this.state, this.currentRegionIndex, now, this.buildingDefs);\n    this.state = tickManualProduction(this.state, this.currentRegionIndex, now, this.buildingDefs);\n\n    this.state.cultivation = tickAutoCultivation(this.state.cultivation, this.tickInterval);\n\n    if (this.state.alchemySession) {\n      this.state.alchemySession = tickAlchemy(this.state.alchemySession, now);\n      this.onAlchemyUpdate?.(this.state.alchemySession);\n    }\n\n    // M3: Conveyor items tick\n    if (this.conveyorSegments.length > 0) {\n      const segMap = buildSegmentMap(this.conveyorSegments);\n      const result = tickConveyorItems(this.conveyorItems, segMap, this.tickInterval);\n      this.conveyorItems = result.items;\n\n      for (const d of result.delivered) {\n        const delta: Partial<Resources> = {};\n        (delta as Record<string, number>)[d.resource] = d.amount;\n        this.state = { ...this.state, resources: { ...this.state.resources, [d.resource]: (this.state.resources[d.resource] ?? 0) + d.amount } };\n      }\n    }\n\n    // M3: Puppet tick\n    for (let i = 0; i < this.puppets.length; i++) {\n      this.puppets[i] = tickPuppet(this.puppets[i], this.tickInterval);\n    }\n\n    // M4: Cross-region teleport tick\n    if (this.state.crossRegionLinks.length > 0) {\n      const crResult = tickCrossRegionLinks(this.state.crossRegionLinks, this.state.resources, now);\n      this.state.crossRegionLinks = crResult.links;\n\n      for (const t of crResult.transferred) {\n        this.state = { ...this.state, resources: { ...this.state.resources, [t.resource]: (this.state.resources[t.resource] ?? 0) + t.amount } };\n      }\n    }\n\n    // M4: Achievement check (every 5 seconds)\n    if (Math.floor(now / 5000) !== Math.floor((now - this.tickInterval) / 5000)) {\n      this.checkAchievements();\n    }\n\n    this.onStateChange?.(this.state);\n  }\n\n  // M4: Achievement checking\n  private checkAchievements(): void {\n    const buildingCounts: Record<string, number> = {};\n    let totalBuildingCount = 0;\n    for (const map of this.state.maps) {\n      for (const b of map.buildings) {\n        buildingCounts[b.buildingId] = (buildingCounts[b.buildingId] ?? 0) + 1;\n        totalBuildingCount++;\n      }\n    }\n\n    const unlockedRegions = this.regionDefs\n      .filter(r => cultivationIsRealmUnlocked(r.unlockRealm, this.state.cultivation))\n      .map(r => r.id);\n\n    const context: AchievementContext = {\n      currentRealmId: this.state.cultivation.realmId,\n      realmOrder: ['fanren', 'liqi', 'zhuji', 'jindan', 'yuanying', 'huashen'],\n      totalResourcesCollected: this.state.resources as Record<string, number>,\n      buildingCounts,\n      totalBuildingCount,\n      pillsCrafted: {},\n      totalPillsCrafted: 0,\n      allPillTypesCrafted: false,\n      unlockedRegions,\n      ascensionCompleted: this.state.ascensionCompleted,\n      playtimeHours: this.state.totalPlaytime / 3600,\n      crossRegionLinkCount: this.state.crossRegionLinks.length,\n    };\n\n    for (const ach of getAllAchievements()) {\n      if (this.state.achievements.includes(ach.id)) continue;\n      if (checkAchievement(ach, context)) {\n        this.state = addAchievement(this.state, ach.id);\n        this.addNotification(`🏆 成就解锁: ${ach.name}`, 'success');\n        this.onAchievementUnlocked?.(ach.id);\n      }\n    }\n  }\n\n  private render(now: number): void {\n    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n    const preview = this.placementMode\n      ? { def: this.placementMode, gx: this.placementPos.gx, gy: this.placementPos.gy, valid: this.placementValid }\n      : null;\n\n    this.renderer.render(\n      this.map,\n      buildings,\n      this.buildingDefs,\n      this.state.resources,\n      this.state.realm,\n      this.state.cultivation,\n      this.hoveredCell,\n      preview,\n      now,\n    );\n\n    const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n    const segMap = buildSegmentMap(this.conveyorSegments);\n    for (const seg of this.conveyorSegments) {\n      renderConveyorSegment(this.renderer.ctx, seg, offsetX, offsetY, scale, this.map.cellSize, now);\n    }\n    renderConveyorItems(this.renderer.ctx, this.conveyorItems, segMap, offsetX, offsetY, scale, this.map.cellSize);\n\n    for (const puppet of this.puppets) {\n      renderPuppet(this.renderer.ctx, puppet, offsetX, offsetY, scale, this.map.cellSize, now);\n    }\n\n    // M4: Render cross-region portals in current map\n    for (const link of this.state.crossRegionLinks) {\n      if (link.fromRegionIndex === this.currentRegionIndex) {\n        renderCrossRegionPortal(this.renderer.ctx, link.fromX, link.fromY, offsetX, offsetY, scale, this.map.cellSize, now);\n      }\n    }\n\n    if (this.breakthroughAnim.active) {\n      this.renderBreakthroughOverlay(now);\n    }\n\n    if (this.ascensionAnim.active) {\n      this.renderAscensionOverlay(now);\n    }\n  }\n\n  private renderBreakthroughOverlay(now: number): void {\n    const ctx = this.renderer.ctx;\n    const w = this.canvas.getBoundingClientRect().width;\n    const h = this.canvas.getBoundingClientRect().height;\n\n    const elapsed = now - this.breakthroughAnim.startTime;\n    const progress = Math.min(1, elapsed / this.breakthroughAnim.duration);\n\n    let alpha = 0;\n    if (progress < 0.2) alpha = progress / 0.2;\n    else if (progress > 0.8) alpha = (1 - progress) / 0.2;\n    else alpha = 1;\n\n    const result = this.breakthroughAnim.result;\n\n    if (result?.success) {\n      ctx.fillStyle = `rgba(255, 215, 0, ${alpha * 0.15})`;\n      ctx.fillRect(0, 0, w, h);\n\n      ctx.fillStyle = `rgba(255, 215, 0, ${alpha})`;\n      ctx.font = `bold ${24 + Math.sin(progress * Math.PI * 4) * 4}px serif`;\n      ctx.textAlign = 'center';\n      ctx.textBaseline = 'middle';\n      ctx.fillText('⚡ 境界突破成功 ⚡', w / 2, h / 2 - 20);\n\n      ctx.font = '16px serif';\n      ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;\n      const realmName = getFullRealmName(this.state.cultivation);\n      ctx.fillText(`进入 ${realmName}`, w / 2, h / 2 + 20);\n    } else if (result) {\n      ctx.fillStyle = `rgba(200, 50, 50, ${alpha * 0.15})`;\n      ctx.fillRect(0, 0, w, h);\n\n      ctx.fillStyle = `rgba(255, 100, 100, ${alpha})`;\n      ctx.font = 'bold 24px serif';\n      ctx.textAlign = 'center';\n      ctx.textBaseline = 'middle';\n      ctx.fillText('突破失败...', w / 2, h / 2 - 20);\n\n      ctx.font = '14px serif';\n      ctx.fillStyle = `rgba(255, 200, 200, ${alpha})`;\n      ctx.fillText(`修为损失 ${Math.floor(result.penalty * 100)}%`, w / 2, h / 2 + 20);\n    }\n\n    if (progress >= 1) {\n      this.breakthroughAnim.active = false;\n      this.breakthroughAnim.result = null;\n      this.onBreakthroughAnim?.(false, null);\n    }\n  }\n\n  // M4: Ascension animation overlay\n  private renderAscensionOverlay(now: number): void {\n    const ctx = this.renderer.ctx;\n    const w = this.canvas.getBoundingClientRect().width;\n    const h = this.canvas.getBoundingClientRect().height;\n\n    const elapsed = now - this.ascensionAnim.startTime;\n    const progress = Math.min(1, elapsed / this.ascensionAnim.duration);\n\n    // Golden-white gradient overlay\n    let alpha = 0;\n    if (progress < 0.15) alpha = progress / 0.15;\n    else if (progress > 0.85) alpha = (1 - progress) / 0.15;\n    else alpha = 1;\n\n    ctx.fillStyle = `rgba(255, 255, 200, ${alpha * 0.2})`;\n    ctx.fillRect(0, 0, w, h);\n\n    // Radiating lines\n    const centerX = w / 2;\n    const centerY = h / 2;\n    const lineCount = 12;\n    for (let i = 0; i < lineCount; i++) {\n      const angle = (i / lineCount) * Math.PI * 2 + progress * Math.PI;\n      const len = 200 + Math.sin(progress * Math.PI * 6 + i) * 100;\n      ctx.strokeStyle = `rgba(255, 215, 0, ${alpha * 0.3})`;\n      ctx.lineWidth = 2;\n      ctx.beginPath();\n      ctx.moveTo(centerX, centerY);\n      ctx.lineTo(centerX + Math.cos(angle) * len, centerY + Math.sin(angle) * len);\n      ctx.stroke();\n    }\n\n    ctx.fillStyle = `rgba(255, 215, 0, ${alpha})`;\n    ctx.font = `bold ${28 + Math.sin(progress * Math.PI * 3) * 6}px serif`;\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText('🌟 飞升成功 🌟', w / 2, h / 2 - 30);\n\n    ctx.font = '18px serif';\n    ctx.fillStyle = `rgba(255, 255, 255, ${alpha})`;\n    ctx.fillText('飞升仙尊 — 全局效率×10', w / 2, h / 2 + 15);\n\n    ctx.font = '14px serif';\n    ctx.fillStyle = `rgba(200, 200, 255, ${alpha})`;\n    ctx.fillText('恭喜完成飞升挑战！', w / 2, h / 2 + 50);\n\n    if (progress >= 1) {\n      this.ascensionAnim.active = false;\n    }\n  }\n\n  placeCurrentBuilding(): boolean {\n    if (!this.placementMode) return false;\n\n    const def = this.placementMode;\n    const { gx, gy } = this.placementPos;\n\n    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n    if (!canPlace(this.map, def, gx, gy, buildings)) return false;\n    if (!canAfford(this.state.resources, def.cost)) return false;\n\n    this.state = deductCost(this.state, def.cost);\n\n    // Handle conveyor/puppet placement\n    if (def.category === 'transport' && (def.id === 'conveyor_lv1' || def.id === 'conveyor_lv2')) {\n      const seg = createSegment(\n        `seg_${Date.now()}_${Math.random().toString(36).slice(2)}`,\n        gx, gy,\n        def.id === 'conveyor_lv1' ? 1 : 2,\n        'right',\n      );\n      const segMap = buildSegmentMap(this.conveyorSegments);\n      this.conveyorSegments.push(autoConnect(seg, segMap));\n      audioManager.playBuild();\n      this.addNotification(`放置了 ${def.name}`, 'success');\n      this.onStateChange?.(this.state);\n      return true;\n    }\n\n    if (def.category === 'automation' && def.id === 'puppet_sorter') {\n      const puppet = createPuppet(\n        `pup_${Date.now()}_${Math.random().toString(36).slice(2)}`,\n        gx, gy, 1,\n      );\n      this.puppets.push(puppet);\n      audioManager.playBuild();\n      this.addNotification(`放置了 ${def.name}`, 'success');\n      this.onStateChange?.(this.state);\n      return true;\n    }\n\n    const instance = createBuildingInstance(def.id, gx, gy);\n    this.state = placeBuilding(this.state, this.currentRegionIndex, instance);\n\n    audioManager.playBuild();\n    this.addNotification(`建造了 ${def.name}`, 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  private handleBuildingClick(building: BuildingInstance): void {\n    const def = this.buildingDefs.get(building.buildingId);\n    if (!def) return;\n\n    if (def.production.mode === 'manual') {\n      if (def.category === 'farming') {\n        if (!building.isProducing && building.progress < 1) {\n          this.state = plantField(this.state, building, this.currentRegionIndex);\n          audioManager.playCollect();\n        } else if (building.progress >= 1) {\n          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n          audioManager.playHarvest();\n          this.addNotification(`收获 ${def.production.amount} ${this.getResourceName(def.production.resource)}`, 'success');\n        }\n      } else if (def.category === 'mining') {\n        this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n        audioManager.playCollect();\n      } else if (def.category === 'alchemy') {\n        if (building.progress >= 1) {\n          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n          audioManager.playAlchemyComplete();\n          this.addNotification(`获得 ${def.production.amount} ${this.getResourceName(def.production.resource)}`, 'success');\n        } else if (!building.isProducing) {\n          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n          audioManager.playAlchemyStart();\n        }\n      } else if (def.category === 'cultivation') {\n        if (!building.isProducing) {\n          this.state = collectFromBuilding(this.state, building, def, this.currentRegionIndex);\n        }\n      }\n      this.onStateChange?.(this.state);\n    }\n\n    this.onBuildingSelect?.(building);\n  }\n\n  usePillAction(pillId: string): boolean {\n    const result = usePill(pillId, this.state.resources);\n    if (!result) return false;\n\n    this.state.resources = result.resources as Resources;\n    this.state.cultivation = addCultivationExp(this.state.cultivation, result.cultivation);\n    this.state = this.addCultivationToRealm(result.cultivation);\n\n    audioManager.playUsePill();\n    const pillName = this.getResourceName(pillId);\n    this.addNotification(`服用 ${pillName}，修为+${result.cultivation}`, 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  useAllPills(pillId: string): boolean {\n    const count = this.state.resources[pillId as keyof typeof this.state.resources] ?? 0;\n    if (count <= 0) return false;\n\n    const result = useMultiplePills(pillId, count, this.state.resources);\n    if (!result) return false;\n\n    this.state.resources = result.resources as Resources;\n    this.state.cultivation = addCultivationExp(this.state.cultivation, result.cultivation);\n    this.state = this.addCultivationToRealm(result.cultivation);\n\n    audioManager.playUsePill();\n    this.addNotification(`服用 ${result.used} ${this.getResourceName(pillId)}，修为+${result.cultivation}`, 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  private addCultivationToRealm(amount: number): GameState {\n    const next = cloneState(this.state);\n    next.realm.exp += amount;\n    while (next.realm.exp >= next.realm.expToNext) {\n      next.realm.exp -= next.realm.expToNext;\n      next.realm.level += 1;\n      next.realm.expToNext = Math.floor(next.realm.expToNext * 1.8);\n    }\n    return next;\n  }\n\n  attemptBreakthroughAction(): boolean {\n    if (!canBreakthrough(this.state.cultivation)) {\n      this.addNotification('修为不足，无法突破', 'warning');\n      return false;\n    }\n\n    const result = attemptBreakthrough(this.state.cultivation, this.state.resources);\n    if (!result) {\n      this.addNotification('材料不足，无法突破', 'warning');\n      return false;\n    }\n\n    this.state.cultivation = result.newState;\n    this.state.resources = result.newResources as Resources;\n\n    if (result.result.success) {\n      this.state.realm.realmId = result.newState.realmId;\n      this.state.realm.level = result.newState.level;\n      this.state.realm.exp = result.newState.exp;\n      this.state.realm.expToNext = result.newState.expToNext;\n    }\n\n    this.breakthroughAnim = {\n      active: true,\n      result: result.result,\n      startTime: performance.now(),\n      duration: 3000,\n    };\n\n    if (result.result.success) {\n      audioManager.playBreakthroughSuccess();\n      this.addNotification(`突破成功！进入 ${getFullRealmName(this.state.cultivation)}`, 'success');\n    } else {\n      audioManager.playBreakthroughFail();\n      this.addNotification(`突破失败，修为损失 ${Math.floor(result.result.penalty * 100)}%`, 'error');\n    }\n\n    this.onBreakthroughAnim?.(true, result.result);\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  getBreakthroughInfo() {\n    return getBreakthroughRequirements(this.state.cultivation);\n  }\n\n  // === M4: Ascension Actions ===\n\n  getAscensionInfo() {\n    return checkAscensionRequirements(this.state.resources, this.state.cultivation.totalCultivation);\n  }\n\n  attemptAscensionAction(): boolean {\n    const result = attemptAscension(this.state.resources, this.state.cultivation.totalCultivation);\n    if (!result.success) {\n      this.addNotification('飞升条件不满足', 'warning');\n      return false;\n    }\n\n    this.state.resources = result.newResources as Resources;\n    this.state.ascensionCompleted = true;\n\n    this.ascensionAnim = {\n      active: true,\n      startTime: performance.now(),\n      duration: 5000,\n    };\n\n    audioManager.playBreakthroughSuccess();\n    this.addNotification('🌟 飞升成功！获得称号：飞升仙尊', 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  // === M4: Cross-Region Link ===\n\n  createCrossRegionLinkAction(\n    fromRegionIndex: number,\n    fromX: number,\n    fromY: number,\n    toRegionIndex: number,\n    toX: number,\n    toY: number,\n    resource: string,\n    amount: number,\n    interval: number,\n  ): boolean {\n    const id = `crl_${Date.now()}_${Math.random().toString(36).slice(2)}`;\n    const link = createCrossRegionLink(id, fromRegionIndex, fromX, fromY, toRegionIndex, toX, toY, resource, amount, interval);\n    this.state = addCrossRegionLink(this.state, link);\n    this.addNotification(`建立跨区域传送链路`, 'success');\n    this.onStateChange?.(this.state);\n    return true;\n  }\n\n  // === Alchemy Actions ===\n\n  getAvailableAlchemyRecipes(): AlchemyRecipe[] {\n    return getAvailableRecipes((realm) => cultivationIsRealmUnlocked(realm, this.state.cultivation));\n  }\n\n  startAlchemyAction(recipeId: string): boolean {\n    const crafting = startCrafting(recipeId, this.state.resources);\n    if (!crafting) return false;\n\n    this.state.resources = crafting.resources as Resources;\n    this.state.alchemySession = crafting.session;\n    audioManager.playAlchemyStart();\n    this.addNotification(`开始炼丹`, 'info');\n    this.onStateChange?.(this.state);\n    this.onAlchemyUpdate?.(this.state.alchemySession);\n    return true;\n  }\n\n  collectAlchemyAction(): boolean {\n    if (!this.state.alchemySession?.complete) return false;\n\n    const result = collectAlchemy(this.state.alchemySession, this.state.resources);\n    if (!result) return false;\n\n    this.state.resources = result.resources as Resources;\n    this.state.alchemySession = null;\n\n    if (result.success) {\n      this.state.cultivation = addCultivationExp(this.state.cultivation, result.expReward);\n      audioManager.playAlchemyComplete();\n      this.addNotification(`炼丹成功！获得 ${result.amount} 颗丹药`, 'success');\n    } else {\n      audioManager.playAlchemyFail();\n      this.addNotification('炼丹失败...', 'error');\n    }\n\n    this.onStateChange?.(this.state);\n    this.onAlchemyUpdate?.(null);\n    return true;\n  }\n\n  // === Notifications ===\n\n  addNotification(text: string, type: GameNotification['type'] = 'info'): void {\n    const notif: GameNotification = {\n      id: ++notifIdCounter,\n      text,\n      type,\n      time: Date.now(),\n    };\n    this.notifications.push(notif);\n    if (this.notifications.length > 10) {\n      this.notifications = this.notifications.slice(-10);\n    }\n    this.onNotification?.(notif);\n  }\n\n  // === Utility ===\n\n  private getResourceName(id: string): string {\n    const names: Record<string, string> = {\n      spirit_stone: '灵石',\n      spirit_grass: '灵草',\n      spirit_energy: '灵气',\n      cultivation: '修为',\n      pill_juling: '聚灵丹',\n      pill_peiyuan: '培元丹',\n      pill_ningqi: '凝气丹',\n      pill_zhuji: '筑基丹',\n      pill_jindanyin: '金丹引',\n      pill_yuanyingguo: '元婴果',\n      pill_huashenlu: '化神露',\n      pill_jiuzhuan: '九转金丹',\n      spirit_iron: '灵铁',\n      spirit_wood: '灵木',\n      talisman_paper: '符纸',\n      monster_core: '妖丹',\n      heaven_earth_liquid: '天地灵液',\n      immortal_stone: '仙灵石',\n      merit: '功德值',\n    };\n    return names[id] ?? id;\n  }\n\n  centerCamera(): void {\n    this.renderer.camera.centerOnMap(this.map.width, this.map.height, this.map.cellSize);\n  }\n\n  getAvailableBuildings(): BuildingDef[] {\n    return Array.from(this.buildingDefs.values()).filter(def => {\n      return cultivationIsRealmUnlocked(def.unlockRealm, this.state.cultivation);\n    });\n  }\n\n  getInventoryPills(): Array<PillDef & { count: number }> {\n    const result: Array<PillDef & { count: number }> = [];\n    for (const def of getAllPillDefs()) {\n      const count = this.state.resources[def.id as keyof typeof this.state.resources] ?? 0;\n      if (count > 0) {\n        result.push({ ...def, count });\n      }\n    }\n    return result;\n  }\n\n  private setupInput(canvas: HTMLCanvasElement): void {\n    canvas.addEventListener('mousemove', (e) => {\n      const rect = canvas.getBoundingClientRect();\n      const mx = e.clientX - rect.left;\n      const my = e.clientY - rect.top;\n\n      const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n      this.hoveredCell = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n\n      if (this.placementMode && this.hoveredCell) {\n        this.placementPos = { gx: this.hoveredCell.gx, gy: this.hoveredCell.gy };\n        const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n        this.placementValid = canPlace(\n          this.map,\n          this.placementMode,\n          this.placementPos.gx,\n          this.placementPos.gy,\n          buildings,\n        );\n      }\n    });\n\n    canvas.addEventListener('mousedown', (e) => {\n      if (e.button !== 0) return;\n      this.clickStartTime = performance.now();\n      this.clickStartPos = { x: e.clientX, y: e.clientY };\n    });\n\n    canvas.addEventListener('mouseup', (e) => {\n      if (e.button !== 0) return;\n      const dt = performance.now() - this.clickStartTime;\n      const dx = Math.abs(e.clientX - this.clickStartPos.x);\n      const dy = Math.abs(e.clientY - this.clickStartPos.y);\n\n      if (dt < 300 && dx < 5 && dy < 5) {\n        audioManager.init();\n        audioManager.resume();\n        this.handleClick(e);\n      }\n    });\n\n    document.addEventListener('keydown', (e) => {\n      if (e.key === 'Escape') {\n        this.placementMode = null;\n      }\n    });\n  }\n\n  private handleClick(e: MouseEvent): void {\n    const rect = this.canvas.getBoundingClientRect();\n    const mx = e.clientX - rect.left;\n    const my = e.clientY - rect.top;\n    const { offsetX, offsetY, scale } = this.renderer.camera.getTransform();\n    const { gx, gy } = this.map.screenToGrid(mx, my, offsetX, offsetY, scale);\n\n    if (!this.map.inBounds(gx, gy)) return;\n\n    if (this.placementMode) {\n      this.placementPos = { gx, gy };\n      const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n      this.placementValid = canPlace(this.map, this.placementMode, gx, gy, buildings);\n      if (this.placementValid) {\n        this.placeCurrentBuilding();\n      }\n      return;\n    }\n\n    const buildings = this.state.maps[this.currentRegionIndex]?.buildings ?? [];\n    const clicked = buildings.find(b => {\n      const def = this.buildingDefs.get(b.buildingId);\n      if (!def) return false;\n      return (\n        gx >= b.gridX && gx < b.gridX + def.size.w &&\n        gy >= b.gridY && gy < b.gridY + def.size.h\n      );\n    });\n\n    if (clicked) {\n      this.handleBuildingClick(clicked);\n    }\n  }\n}\n","numLines":946,"startLine":1,"totalLines":946}}}
