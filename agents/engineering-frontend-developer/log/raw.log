{"type":"assistant","message":{"id":"msg_20260523123857e8be17475be2490a","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_ff04c8ebf35c4ac1a056da6f","name":"Write","input":{"file_path":"D:\\game-projects\\steam-horror-sim\\src\\renderer\\Lighting.ts","content":"// Lighting.ts — 2D lighting with day/night gradual transitions (v0.3.0 — M3)\n\nimport type { LightSource, GamePhase } from '../game/GameState';\nimport { isNightTime } from '../game/GameState';\n\nexport class Lighting {\n  private lightCanvas: HTMLCanvasElement;\n  private lightCtx: CanvasRenderingContext2D;\n  private lightBoost = 1.0;\n\n  constructor() {\n    this.lightCanvas = document.createElement('canvas');\n    this.lightCtx = this.lightCanvas.getContext('2d')!;\n  }\n\n  setLightBoost(boost: number): void {\n    this.lightBoost = boost;\n  }\n\n  private getDaylightFactor(timeOfDay: number): number {\n    if (timeOfDay >= 6 && timeOfDay < 7) return timeOfDay - 6;\n    if (timeOfDay >= 7 && timeOfDay < 17) return 1;\n    if (timeOfDay >= 17 && timeOfDay < 18) return 18 - timeOfDay;\n    return 0;\n  }\n\n  private getDarknessLevel(phase: GamePhase, timeOfDay: number): number {\n    const daylight = this.getDaylightFactor(timeOfDay);\n    if (daylight >= 1) return 0;\n\n    let nightDarkness = 0;\n    if (phase === 'night_transition') nightDarkness = 0.3;\n    else if (phase === 'night') nightDarkness = 0.6;\n    else if (phase === 'danger') nightDarkness = 0.85;\n    else if (phase === 'dawn') {\n      if (timeOfDay >= 29) nightDarkness = Math.max(0, 0.4 * (30 - timeOfDay));\n      else nightDarkness = 0.4;\n    }\n\n    if (daylight > 0) return nightDarkness * (1 - daylight);\n    return nightDarkness;\n  }\n\n  render(\n    ctx: CanvasRenderingContext2D,\n    width: number,\n    height: number,\n    lights: LightSource[],\n    phase: GamePhase,\n    offsetX: number,\n    offsetY: number,\n    scale: number,\n    now: number,\n    timeOfDay?: number,\n  ): void {\n    const tod = timeOfDay ?? 12;\n    const daylight = this.getDaylightFactor(tod);\n\n    if (daylight >= 1) {\n      this.renderDayOverlay(ctx, width, height);\n      return;\n    }\n\n    const darkness = this.getDarknessLevel(phase, tod);\n    if (darkness <= 0 && daylight > 0) {\n      this.renderTransitionOverlay(ctx, width, height, daylight);\n      return;\n    }\n\n    this.lightCanvas.width = width;\n    this.lightCanvas.height = height;\n    const lctx = this.lightCtx;\n\n    lctx.fillStyle = `rgba(5, 5, 20, ${darkness})`;\n    lctx.fillRect(0, 0, width, height);\n\n    lctx.globalCompositeOperation = 'destination-out';\n\n    for (const light of lights) {\n      const screenX = offsetX + light.x * scale;\n      const screenY = offsetY + light.y * scale;\n      const radius = light.radius * scale * this.lightBoost;\n      let intensity = light.intensity;\n\n      if (daylight > 0) {\n        intensity *= (1 - daylight);\n      }\n\n      if (light.flicker) {\n        const flicker = Math.sin(now * light.flickerSpeed * 0.001) * 0.1 +\n          Math.sin(now * light.flickerSpeed * 0.003) * 0.05;\n        intensity = Math.max(0.3, Math.min(1, intensity + flicker));\n      }\n\n      const gradient = lctx.createRadialGradient(screenX, screenY, 0, screenX, screenY, radius);\n      gradient.addColorStop(0, `rgba(0, 0, 0, ${intensity})`);\n      gradient.addColorStop(0.4, `rgba(0, 0, 0, ${intensity * 0.6})`);\n      gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');\n\n      lctx.fillStyle = gradient;\n      lctx.beginPath();\n      lctx.arc(screenX, screenY, radius, 0, Math.PI * 2);\n      lctx.fill();\n    }\n\n    lctx.globalCompositeOperation = 'source-over';\n\n    lctx.globalCompositeOperation = 'source-atop';\n    const tintAlpha = darkness * 0.15;\n    lctx.fillStyle = `rgba(20, 40, 80, ${tintAlpha})`;\n    lctx.fillRect(0, 0, width, height);\n    lctx.globalCompositeOperation = 'source-over';\n\n    ctx.drawImage(this.lightCanvas, 0, 0);\n  }\n\n  private renderDayOverlay(ctx: CanvasRenderingContext2D, w: number, h: number): void {\n    ctx.fillStyle = 'rgba(255, 240, 200, 0.04)';\n    ctx.fillRect(0, 0, w, h);\n  }\n\n  private renderTransitionOverlay(ctx: CanvasRenderingContext2D, w: number, h: number, daylight: number): void {\n    const alpha = (1 - daylight) * 0.1;\n    ctx.fillStyle = `rgba(20, 20, 40, ${alpha})`;\n    ctx.fillRect(0, 0, w, h);\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"e8f5bde0-4da8-4c4a-9322-50945e66ead7","uuid":"8941517e-1e57-4490-bc70-04ec20b09118"}
