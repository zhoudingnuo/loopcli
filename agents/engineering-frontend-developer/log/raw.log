{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_08f60af1d472458ab1fe618d","type":"tool_result","content":"The file D:\\game-projects\\steam-horror-sim\\src\\game\\SaveManager.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"e8f5bde0-4da8-4c4a-9322-50945e66ead7","uuid":"a8cbf7c6-2922-4bbe-bbd8-c69b2afdd9b6","timestamp":"2026-05-23T04:42:34.919Z","tool_use_result":{"filePath":"D:\\game-projects\\steam-horror-sim\\src\\game\\SaveManager.ts","oldString":"      productManager: data['productManager'] ?? {},\n      economy: data['economy'] ?? {},\n      pricing: data['pricing'] ?? {},\n      customerStats: data['customerManager'] ?? {},","newString":"      productManager: data['productManager'] ?? {} as Record<string, unknown>,\n      economy: data['economy'] ?? {} as Record<string, unknown>,\n      pricing: data['pricing'] ?? {} as Record<string, unknown>,\n      customerStats: data['customerManager'] ?? {} as Record<string, unknown>,","originalFile":"// SaveManager.ts — Auto-save after day end + load restore (M3)\n\nimport { type GameState, type SaveData, CURRENT_VERSION } from './GameState';\n\nexport interface SaveableSystem {\n  getSaveData(): Record<string, unknown>;\n  loadSaveData(data: Record<string, unknown>): void;\n}\n\nconst SAVE_KEY = 'midnight_store_save_v3';\n\nexport class SaveManager {\n  private systems: Map<string, SaveableSystem> = new Map();\n  private lastSaveTime = 0;\n  private autoSaveInterval = 300000;\n\n  register(name: string, system: SaveableSystem): void {\n    this.systems.set(name, system);\n  }\n\n  save(state: GameState): boolean {\n    const data: Record<string, unknown> = {};\n    for (const [name, sys] of this.systems) {\n      data[name] = sys.getSaveData();\n    }\n\n    const saveData: SaveData = {\n      version: CURRENT_VERSION,\n      timestamp: Date.now(),\n      playtime: state.totalPlaytime,\n      gameState: state,\n      productManager: data['productManager'] ?? {},\n      economy: data['economy'] ?? {},\n      pricing: data['pricing'] ?? {},\n      customerStats: data['customerManager'] ?? {},\n      registers: data['registers'] as Record<string, unknown>[] ?? [],\n    };\n\n    try {\n      localStorage.setItem(SAVE_KEY, JSON.stringify(saveData));\n      this.lastSaveTime = Date.now();\n      return true;\n    } catch {\n      console.warn('Save failed: storage quota exceeded');\n      return false;\n    }\n  }\n\n  load(): SaveData | null {\n    try {\n      const raw = localStorage.getItem(SAVE_KEY);\n      if (!raw) return null;\n      return JSON.parse(raw) as SaveData;\n    } catch {\n      return null;\n    }\n  }\n\n  restore(save: SaveData, state: GameState): void {\n    const gs = save.gameState;\n    if (gs) {\n      Object.assign(state, gs);\n    }\n\n    const restoreSystem = (name: string, key: keyof SaveData) => {\n      const sys = this.systems.get(name);\n      const data = save[key] as Record<string, unknown> | undefined;\n      if (sys && data && Object.keys(data).length > 0) {\n        sys.loadSaveData(data);\n      }\n    };\n\n    restoreSystem('productManager', 'productManager');\n    restoreSystem('economy', 'economy');\n    restoreSystem('pricing', 'pricing');\n    restoreSystem('customerManager', 'customerStats');\n\n    const sys = this.systems.get('registers');\n    if (sys && save.registers) {\n      sys.loadSaveData({ registers: save.registers });\n    }\n  }\n\n  clearSave(): void {\n    localStorage.removeItem(SAVE_KEY);\n  }\n\n  hasSave(): boolean {\n    return localStorage.getItem(SAVE_KEY) !== null;\n  }\n\n  startAutoSave(getState: () => GameState): void {\n    window.setInterval(() => {\n      this.save(getState());\n    }, this.autoSaveInterval);\n  }\n}\n","structuredPatch":[{"oldStart":29,"oldLines":10,"newStart":29,"newLines":10,"lines":["       timestamp: Date.now(),","       playtime: state.totalPlaytime,","       gameState: state,","-      productManager: data['productManager'] ?? {},","-      economy: data['economy'] ?? {},","-      pricing: data['pricing'] ?? {},","-      customerStats: data['customerManager'] ?? {},","+      productManager: data['productManager'] ?? {} as Record<string, unknown>,","+      economy: data['economy'] ?? {} as Record<string, unknown>,","+      pricing: data['pricing'] ?? {} as Record<string, unknown>,","+      customerStats: data['customerManager'] ?? {} as Record<string, unknown>,","       registers: data['registers'] as Record<string, unknown>[] ?? [],","     };"," "]}],"userModified":false,"replaceAll":false}}
