; border: 2px solid #E8DED0; border-radius: 16px;\n  padding: 16px; text-align: center; cursor: pointer; transition: all 0.15s;\n}\n.char-card.selected { border-color: #D4A843; background: #FFF8E8; box-shadow: 0 2px 12px rgba(212,168,67,0.3); }\n.char-card.locked { opacity: 0.5; cursor: default; }\n.char-card:active:not(.locked) { transform: scale(0.97); }\n.char-avatar { font-size: 40px; margin-bottom: 8px; }\n.char-name { font-size: 15px; font-weight: bold; color: #2C2C2C; margin-bottom: 4px; }\n.char-skill { font-size: 12px; color: #8B7355; }\n.char-badge {\n  margin-top: 8px; padding: 2px 10px; background: #D4A843; color: white;\n  border-radius: 10px; font-size: 11px; display: inline-block;\n}\n.char-detail {\n  padding: 16px; background: #FFFDF7; border-top: 1px solid #E8DED0;\n  text-align: center;\n}\n.char-detail h4 { font-size: 18px; color: #C84B31; margin-bottom: 8px; }\n.skill-name { font-weight: bold; color: #2D6A4F; margin-bottom: 4px; }\n.skill-desc { font-size: 14px; color: #8B7355; }\n","numLines":28,"startLine":425,"totalLines":452}}}
