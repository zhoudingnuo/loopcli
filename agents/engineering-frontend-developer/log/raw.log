{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6c88dd0dae864d4bb5c760be","type":"tool_result","content":"1\t// Renderer.js — UI rendering (W2 extended)\n2\t\n3\tfunction renderUI(game) {\n4\t  const screens = ['menu-screen','map-screen','game-screen','result-screen',\n5\t    'timed-screen','timed-result-screen','collection-screen','daily-screen',\n6\t    'pk-screen','pk-result-screen','characters-screen'];\n7\t  screens.forEach(id => {\n8\t    const el = document.getElementById(id);\n9\t    if (el) el.classList.remove('active');\n10\t  });\n11\t\n12\t  switch (game.state) {\n13\t    case 'menu': renderMenu(game); break;\n14\t    case 'map': renderMap(game); break;\n15\t    case 'playing': renderGame(game); break;\n16\t    case 'result': renderResult(game); break;\n17\t    case 'timed': renderTimed(game); break;\n18\t    case 'timed_result': renderTimedResult(game); break;\n19\t    case 'collection': renderCollection(game); break;\n20\t    case 'daily': renderDaily(game); break;\n21\t    case 'pk': renderPK(game); break;\n22\t    case 'pk_result': renderPKResult(game); break;\n23\t    case 'characters': renderCharacters(game); break;\n24\t  }\n25\t}\n26\t\n27\tfunction showScreen(id) {\n28\t  const el = document.getElementById(id);\n29\t  if (el) el.classList.add('active');\n30\t}\n31\t\n32\tfunction renderMenu(game) {\n33\t  showScreen('menu-screen');\n34\t  const mc = document.getElementById('menu-coins');\n35\t  const mcl = document.getElementById('menu-collected');\n36\t  if (mc) mc.textContent = game.data.coins;\n37\t  if (mcl) mcl.textContent = game.data.collectedCount;\n38\t\n39\t  const charAvatar = document.getElementById('menu-avatar');\n40\t  if (charAvatar) {\n41\t    const ch = game.characters.getCurrent();\n42\t    charAvatar.textContent = ch.avatar;\n43\t  }\n44\t}\n45\t\n46\tfunction renderMap(game) {\n47\t  showScreen('map-screen');\n48\t  const mc = document.getElementById('map-coins');\n49\t  if (mc) mc.textContent = game.data.coins;\n50\t\n51\t  const grid = document.getElementById('level-grid');\n52\t  if (!grid) return;\n53\t  grid.innerHTML = '';\n54\t\n55\t  const chapters = {};\n56\t  LEVELS.forEach(l => {\n57\t    if (!chapters[l.chapter]) chapters[l.chapter] = [];\n58\t    chapters[l.chapter].push(l);\n59\t  });\n60\t\n61\t  const chapInfo = document.getElementById('chapter-info');\n62\t  if (chapInfo) {\n63\t    chapInfo.innerHTML = CHAPTERS.map(c =>\n64\t      `<div class=\"chapter-badge\" style=\"background:${c.color};${c.id>=4?'color:#fff':''}\">${c.name} · ${c.subtitle}</div>`\n65\t    ).join('');\n66\t  }\n67\t\n68\t  Object.keys(chapters).forEach(chId => {\n69\t    const section = document.createElement('div');\n70\t    section.className = 'chapter-section';\n71\t    const chap = CHAPTERS.find(c => c.id === parseInt(chId));\n72\t    if (chap) section.style.borderColor = chap.color;\n73\t\n74\t    chapters[chId].forEach(level => {\n75\t      const btn = document.createElement('button');\n76\t      const stars = game.data.getLevelStars(level.id);\n77\t      const unlocked = level.id <= game.data.unlockedLevel;\n78\t      const isBoss = level.boss;\n79\t\n80\t      btn.className = 'level-btn' + (isBoss ? ' boss' : '') + (!unlocked ? ' locked' : '') + (stars > 0 ? ' completed' : '');\n81\t      btn.innerHTML = `\n82\t        <span class=\"level-num\">${level.id}</span>\n83\t        <span class=\"level-stars\">${'★'.repeat(stars)}${'☆'.repeat(3 - stars)}</span>\n84\t        <span class=\"level-name\">${level.name}</span>\n85\t      `;\n86\t\n87\t      if (unlocked) btn.onclick = () => game.startLevel(level.id);\n88\t      section.appendChild(btn);\n89\t    });\n90\t    grid.appendChild(section);\n91\t  });\n92\t}\n93\t\n94\tfunction renderGame(game) {\n95\t  showScreen('game-screen');\n96\t  const q = game.getCurrentQuestion();\n97\t  if (!q) return;\n98\t\n99\t  const ll = document.getElementById('level-label');\n100\t  const pl = document.getElementById('progress-label');\n101\t  const ld = document.getElementById('lives-display');\n102\t  if (ll) ll.textContent = `第${game.currentLevel.id}关`;\n103\t  if (pl) pl.textContent = `${game.questionIndex + 1}/${game.questions.length}`;\n104\t  if (ld) ld.textContent = '❤️'.repeat(Math.max(0, game.lives));\n105\t\n106\t  const mt = document.getElementById('meaning-text');\n107\t  if (mt) mt.textContent = q.idiom.meaning;\n108\t\n109\t  const cd = document.getElementById('combo-display');\n110\t  if (cd) {\n111\t    if (game.combo.combo >= 3) {\n112\t      cd.textContent = `🔥 ${game.combo.combo}连击！${game.combo.getComboMessage()}`;\n113\t      cd.style.display = 'block';\n114\t      cd.className = 'combo-display combo-' + Math.min(game.combo.combo, 10);\n115\t    } else {\n116\t      cd.style.display = 'none';\n117\t    }\n118\t  }\n119\t\n120\t  const sc = document.getElementById('slots-container');\n121\t  if (sc) {\n122\t    sc.innerHTML = '';\n123\t    const slots = game.judge.getSlots();\n124\t    for (let i = 0; i < 4; i++) {\n125\t      const slot = document.createElement('div');\n126\t      slot.className = 'slot';\n127\t      if (slots[i]) {\n128\t        slot.classList.add('filled');\n129\t        slot.textContent = slots[i].char;\n130\t        slot.onclick = () => { game.removeSlot(i); };\n131\t      }\n132\t      if (q.answered && q.correct === true) slot.classList.add('correct');\n133\t      if (q.answered && q.correct === false) slot.classList.add('wrong');\n134\t      sc.appendChild(slot);\n135\t    }\n136\t  }\n137\t\n138\t  const ih = document.getElementById('idiom-hint');\n139\t  if (ih) {\n140\t    if (q.answered && q.correct) {\n141\t      ih.innerHTML = `<strong>${q.idiom.idiom}</strong>：${q.idiom.meaning}`;\n142\t      ih.style.display = 'block';\n143\t    } else {\n144\t      ih.style.display = 'none';\n145\t    }\n146\t  }\n147\t\n148\t  const cc = document.getElementById('candidates-container');\n149\t  if (cc) {\n150\t    cc.innerHTML = '';\n151\t    q.candidates.forEach((c, i) => {\n152\t      const btn = document.createElement('button');\n153\t      btn.className = 'candidate';\n154\t      btn.textContent = c.char;\n155\t      if (c.used) btn.classList.add('used');\n156\t      if (c.removed) btn.classList.add('removed');\n157\t      if (!c.used && !c.removed && !q.answered) btn.onclick = () => game.pickChar(i);\n158\t      cc.appendChild(btn);\n159\t    });\n160\t  }\n161\t\n162\t  const to = document.getElementById('tutorial-overlay');\n163\t  const tt = document.getElementById('tutorial-text');\n164\t  if (to && tt) {\n165\t    const step = game.tutorial.getCurrentStep();\n166\t    if (step) { tt.textContent = step.msg; to.style.display = 'flex'; }\n167\t    else { to.style.display = 'none'; }\n168\t  }\n169\t\n170\t  // Update tool button costs\n171\t  const hintBtns = document.querySelectorAll('.tool-btn');\n172\t  if (hintBtns.length >= 3) {\n173\t    hintBtns[0].textContent = `📖 揭示 (${game.hintRevealCost}🪙)`;\n174\t    hintBtns[1].textContent = `✂️ 去干扰 (${game.hintRemoveCost}🪙)`;\n175\t    hintBtns[2].textContent = `⏭ 跳过 (${game.skipCost}🪙)`;\n176\t  }\n177\t}\n178\t\n179\tfunction renderResult(game) {\n180\t  showScreen('result-screen');\n181\t  const r = game.levelResult;\n182\t  if (!r) return;\n183\t\n184\t  const rt = document.getElementById('result-title');\n185\t  if (rt) rt.textContent = r.stars > 0 ? '🎉 通关!' : '😞 失败';\n186\t\n187\t  const rs = document.getElementById('result-stars');\n188\t  if (rs) rs.innerHTML = '★'.repeat(r.stars) + '☆'.repeat(3 - r.stars);\n189\t\n190\t  document.getElementById('result-correct').textContent = r.correctCount;\n191\t  document.getElementById('result-total').textContent = r.totalQuestions;\n192\t  document.getElementById('result-score').textContent = r.score;\n193\t  document.getElementById('result-combo').textContent = r.maxCombo;\n194\t  document.getElementById('result-coins').textContent = r.coins;\n195\t\n196\t  const btnNext = document.getElementById('btn-next');\n197\t  if (btnNext) {\n198\t    const nextId = game.currentLevel.id + 1;\n199\t    btnNext.style.display = (r.stars > 0 && LEVELS.find(l => l.id === nextId)) ? 'inline-block' : 'none';\n200\t  }\n201\t  const btnRetry = document.getElementById('btn-retry');\n202\t  if (btnRetry) btnRetry.style.display = r.stars > 0 ? 'none' : 'inline-block';\n203\t}\n204\t\n205\t// ===== W2: Timed Challenge =====\n206\tfunction renderTimed(game) {\n207\t  showScreen('timed-screen');\n208\t  const tc = game.timed;\n209\t  const q = tc.currentQ;\n210\t  if (!q) return;\n211\t\n212\t  const timer = document.getElementById('timed-timer');\n213\t  if (timer) {\n214\t    timer.textContent = `${tc.timeLeft}s`;\n215\t    timer.className = 'timer-display' + (tc.timeLeft <= 10 ? ' timer-warning' : '');\n216\t  }\n217\t\n218\t  const score = document.getElementById('timed-score');\n219\t  if (score) score.textContent = tc.score;\n220\t\n221\t  const combo = document.getElementById('timed-combo');\n222\t  if (combo) {\n223\t    if (game.combo.combo >= 3) {\n224\t      combo.textContent = `🔥 ${game.combo.combo}连击！`;\n225\t      combo.style.display = 'block';\n226\t    } else {\n227\t      combo.style.display = 'none';\n228\t    }\n229\t  }\n230\t\n231\t  const mt = document.getElementById('timed-meaning');\n232\t  if (mt) mt.textContent = q.idiom.meaning;\n233\t\n234\t  const sc = document.getElementById('timed-slots');\n235\t  if (sc) {\n236\t    sc.innerHTML = '';\n237\t    const slots = tc.judge.getSlots();\n238\t    for (let i = 0; i < 4; i++) {\n239\t      const slot = document.createElement('div');\n240\t      slot.className = 'slot';\n241\t      if (slots[i]) { slot.classList.add('filled'); slot.textContent = slots[i].char; slot.onclick = () => tc.removeSlot(i); }\n242\t      if (q.answered && q.correct === true) slot.classList.add('correct');\n243\t      if (q.answered && q.correct === false) slot.classList.add('wrong');\n244\t      sc.appendChild(slot);\n245\t    }\n246\t  }\n247\t\n248\t  const cc = document.getElementById('timed-candidates');\n249\t  if (cc) {\n250\t    cc.innerHTML = '';\n251\t    q.candidates.forEach((c, i) => {\n252\t      const btn = document.createElement('button');\n253\t      btn.className = 'candidate';\n254\t      btn.textContent = c.char;\n255\t      if (c.used) btn.classList.add('used');\n256\t      if (c.removed) btn.classList.add('removed');\n257\t      if (!c.used && !c.removed && !q.answered) btn.onclick = () => tc.pickChar(i);\n258\t      cc.appendChild(btn);\n259\t    });\n260\t  }\n261\t}\n262\t\n263\tfunction renderTimedResult(game) {\n264\t  showScreen('timed-result-screen');\n265\t  const r = game.timed.getResult();\n266\t  document.getElementById('tr-score').textContent = r.score;\n267\t  document.getElementById('tr-correct').textContent = r.correctCount;\n268\t  document.getElementById('tr-total').textContent = r.answeredCount;\n269\t  document.getElementById('tr-combo').textContent = r.maxCombo;\n270\t  document.getElementById('tr-coins').textContent = Math.floor(r.score / 10);\n271\t}\n272\t\n273\t// ===== W2: Collection =====\n274\tfunction renderCollection(game) {\n275\t  showScreen('collection-screen');\n276\t  const col = game.collection;\n277\t  const progress = col.getProgress();\n278\t\n279\t  document.getElementById('col-progress').textContent = `${progress.collected}/${progress.total} (${progress.percent}%)`;\n280\t\n281\t  const bar = document.getElementById('col-progress-bar');\n282\t  if (bar) bar.style.width = progress.percent + '%';\n283\t\n284\t  // Categories\n285\t  const catContainer = document.getElementById('col-categories');\n286\t  if (catContainer) {\n287\t    const cats = ['全部', ...col.getCategories()];\n288\t    catContainer.innerHTML = cats.map(c =>\n289\t      `<button class=\"cat-btn${col.selectedCategory === (c === '全部' ? null : c) ? ' active' : ''}\" onclick=\"handleCategoryFilter('${c}')\">${c}</button>`\n290\t    ).join('');\n291\t  }\n292\t\n293\t  // Search\n294\t  const searchInput = document.getElementById('col-search');\n295\t  if (searchInput && searchInput.value !== col.searchQuery) {\n296\t    searchInput.value = col.searchQuery;\n297\t  }\n298\t\n299\t  // Idiom grid\n300\t  const grid = document.getElementById('col-grid');\n301\t  if (grid) {\n302\t    const idioms = col.getFilteredIdioms();\n303\t    grid.innerHTML = idioms.slice(0, 60).map(i =>\n304\t      `<div class=\"idiom-card${i.collected ? ' collected' : ''}\" onclick=\"handleIdiomSelect('${i.id}')\">\n305\t        <span class=\"idiom-text\">${i.collected ? i.idiom : '？？？？'}</span>\n306\t        <span class=\"idiom-cat\">${(i.category || [])[0] || ''}</span>\n307\t      </div>`\n308\t    ).join('');\n309\t    if (idioms.length > 60) {\n310\t      grid.innerHTML += `<div class=\"more-hint\">还有${idioms.length - 60}个...</div>`;\n311\t    }\n312\t  }\n313\t\n314\t  // Detail view\n315\t  const detail = document.getElementById('col-detail');\n316\t  if (detail) {\n317\t    if (col.selectedIdiom) {\n318\t      const i = col.selectedIdiom;\n319\t      const collected = game.data.collectedIdioms.includes(i.id);\n320\t      detail.style.display = 'block';\n321\t      detail.innerHTML = `\n322\t        <div class=\"detail-header\">\n323\t          <h3>${collected ? i.idiom : '？？？？'}</h3>\n324\t          <button class=\"btn-back\" onclick=\"game.collection.selectIdiom(null)\">✕</button>\n325\t        </div>\n326\t        ${collected ? `\n327\t          <p class=\"detail-pinyin\">${i.pinyin || ''}</p>\n328\t          <p class=\"detail-meaning\">${i.meaning}</p>\n329\t          ${i.origin ? `<p class=\"detail-origin\">出处：${i.origin}</p>` : ''}\n330\t          ${i.example ? `<p class=\"detail-example\">例句：${i.example}</p>` : ''}\n331\t        ` : '<p class=\"detail-locked\">收集此成语后可查看详情</p>'}\n332\t      `;\n333\t    } else {\n334\t      detail.style.display = 'none';\n335\t    }\n336\t  }\n337\t}\n338\t\n339\t// ===== W2: Daily =====\n340\tfunction renderDaily(game) {\n341\t  showScreen('daily-screen');\n342\t  const ds = game.daily.getDailyState();\n343\t\n344\t  document.getElementById('daily-streak').textContent = ds.loginStreak;\n345\t  document.getElementById('daily-claimed').textContent = ds.todayClaimed ? '已领取' : '未领取';\n346\t  document.getElementById('daily-claim-btn').disabled = ds.todayClaimed;\n347\t  document.getElementById('daily-claim-btn').textContent = ds.todayClaimed ? '已领取 ✓' : `领取签到奖励 (×${Math.min(ds.loginStreak, 7)}0🪙)`;\n348\t\n349\t  // Tasks\n350\t  const tasksEl = document.getElementById('daily-tasks');\n351\t  if (tasksEl) {\n352\t    tasksEl.innerHTML = ds.tasks.map(t => `\n353\t      <div class=\"task-item${t.claimed ? ' done' : ''}\">\n354\t        <span class=\"task-desc\">${t.desc}</span>\n355\t        <span class=\"task-progress\">${t.progress}/${t.target}</span>\n356\t        <button class=\"task-btn${t.claimed ? ' claimed' : ''}\"\n357\t          ${t.claimed || t.progress < t.target ? 'disabled' : ''}\n358\t          onclick=\"handleClaimTask('${t.id}')\">\n359\t          ${t.claimed ? '已领' : `${t.reward}🪙`}\n360\t        </button>\n361\t      </div>\n362\t    `).join('');\n363\t  }\n364\t\n365\t  // Challenge\n366\t  const challengeEl = document.getElementById('daily-challenge');\n367\t  if (challengeEl) {\n368\t    if (ds.challengeIdiom) {\n369\t      challengeEl.innerHTML = `\n370\t        <div class=\"challenge-card${ds.challengeCompleted ? ' done' : ''}\">\n371\t          <h4>今日成语挑战</h4>\n372\t          <p class=\"challenge-meaning\">${ds.challengeIdiom.meaning}</p>\n373\t          <p class=\"challenge-hint\">${ds.challengeCompleted ? `答案：${ds.challengeIdiom.idiom}` : '提示：' + ds.challengeIdiom.chars[0] + '？？？'}</p>\n374\t          ${ds.challengeCompleted ?\n375\t            '<span class=\"challenge-done\">已完成 ✓ +50🪙</span>' :\n376\t            `<button class=\"btn btn-primary btn-sm\" onclick=\"handleDailyChallenge()\">挑战</button>`\n377\t          }\n378\t        </div>\n379\t      `;\n380\t    }\n381\t  }\n382\t}\n383\t\n384\t// ===== W2: PK =====\n385\tfunction renderPK(game) {\n386\t  showScreen('pk-screen');\n387\t  const pk = game.pk;\n388\t  const q = pk.currentQ;\n389\t  if (!q) return;\n390\t\n391\t  document.getElementById('pk-progress').textContent = `${pk.currentIndex + 1}/5`;\n392\t\n393\t  const mt = document.getElementById('pk-meaning');\n394\t  if (mt) mt.textContent = q.idiom.meaning;\n395\t\n396\t  const sc = document.getElementById('pk-slots');\n397\t  if (sc) {\n398\t    sc.innerHTML = '';\n399\t    const slots = pk.judge.getSlots();\n400\t    for (let i = 0; i < 4; i++) {\n401\t      const slot = document.createElement('div');\n402\t      slot.className = 'slot';\n403\t      if (slots[i]) { slot.classList.add('filled'); slot.textContent = slots[i].char; slot.onclick = () => pk.removeSlot(i); }\n404\t      if (q.answered && q.correct === true) slot.classList.add('correct');\n405\t      if (q.answered && q.correct === false) slot.classList.add('wrong');\n406\t      sc.appendChild(slot);\n407\t    }\n408\t  }\n409\t\n410\t  const cc = document.getElementById('pk-candidates');\n411\t  if (cc) {\n412\t    cc.innerHTML = '';\n413\t    q.candidates.forEach((c, i) => {\n414\t      const btn = document.createElement('button');\n415\t      btn.className = 'candidate';\n416\t      btn.textContent = c.char;\n417\t      if (c.used) btn.classList.add('used');\n418\t      if (c.removed) btn.classList.add('removed');\n419\t      if (!c.used && !c.removed && !q.answered) btn.onclick = () => pk.pickChar(i);\n420\t      cc.appendChild(btn);\n421\t    });\n422\t  }\n423\t}\n424\t\n425\tfunction renderPKResult(game) {\n426\t  showScreen('pk-result-screen');\n427\t  const r = game.pk.getResult();\n428\t  document.getElementById('pkr-result').textContent = r.won ? '🎉 胜利！' : '😢 惜败';\n429\t  document.getElementById('pkr-correct').textContent = `${r.correctCount}/5`;\n430\t  document.getElementById('pkr-time').textContent = `${(r.time / 1000).toFixed(1)}s`;\n431\t  document.getElementById('pkr-reward').textContent = r.won ? '+50🪙' : '';\n432\t\n433\t  // Answers review\n434\t  const answersEl = document.getElementById('pkr-answers');\n435\t  if (answersEl) {\n436\t    answersEl.innerHTML = r.answers.map((a, i) =>\n437\t      `<div class=\"answer-item${a.correct ? ' correct' : ' wrong'}\">${i+1}. ${a.idiom} ${a.correct ? '✓' : '✗'}</div>`\n438\t    ).join('');\n439\t  }\n440\t}\n441\t\n442\t// ===== W2: Characters =====\n443\tfunction renderCharacters(game) {\n444\t  showScreen('characters-screen');\n445\t  const chars = game.characters.getAll();\n446\t\n447\t  const grid = document.getElementById('char-grid');\n448\t  if (grid) {\n449\t    grid.innerHTML = chars.map(c => {\n450\t      const selected = game.data.data.characters.current === c.id;\n451\t      return `\n452\t        <div class=\"char-card${selected ? ' selected' : ''}${!c.unlocked ? ' locked' : ''}\"\n453\t             onclick=\"${c.unlocked ? `game.characters.select('${c.id}'); game.render()` : ''}\">\n454\t          <div class=\"char-avatar\">${c.unlocked ? c.avatar : '🔒'}</div>\n455\t          <div class=\"char-name\">${c.name}</div>\n456\t          <div class=\"char-skill\">${c.unlocked ? c.skill.name : `通关第${c.unlock.level || '?'}关解锁`}</div>\n457\t          ${selected ? '<div class=\"char-badge\">使用中</div>' : ''}\n458\t        </div>\n459\t      `;\n460\t    }).join('');\n461\t  }\n462\t\n463\t  // Skill detail\n464\t  const current = game.characters.getCurrent();\n465\t  const detail = document.getElementById('char-detail');\n466\t  if (detail) {\n467\t    detail.innerHTML = `\n468\t      <h4>${current.avatar} ${current.name}</h4>\n469\t      <p class=\"skill-name\">${current.skill.name}</p>\n470\t      <p class=\"skill-desc\">${current.skill.desc}</p>\n471\t    `;\n472\t  }\n473\t}\n474\t\n475\t// ===== Global handlers =====\n476\tfunction handleCategoryFilter(cat) {\n477\t  if (cat === '全部') { game.collection.clearFilter(); }\n478\t  else { game.collection.filterByCategory(cat); }\n479\t  game.render();\n480\t}\n481\t\n482\tfunction handleIdiomSelect(id) { game.collection.selectIdiom(id); game.render(); }\n483\t\n484\tfunction handleClaimTask(taskId) { game.daily.claimTask(taskId); game.render(); }\n485\t\n486\tfunction handleDailyChallenge() {\n487\t  const ds = game.daily.getDailyState();\n488\t  if (ds.challengeIdiom && !ds.challengeCompleted) {\n489\t    game.daily.completeChallenge();\n490\t    game.render();\n491\t  }\n492\t}\n493\t\n494\tfunction handleColSearch(val) { game.collection.search(val); game.render(); }\n495\t"}]},"parent_tool_use_id":null,"session_id":"6be7998d-cc43-4adb-be9f-4939a8437d2d","uuid":"76ba984e-d573-46cf-8dfb-185674ad502e","timestamp":"2026-05-23T00:44:03.757Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/src/js/Renderer.js","content":"// Renderer.js — UI rendering (W2 extended)\n\nfunction renderUI(game) {\n  const screens = ['menu-screen','map-screen','game-screen','result-screen',\n    'timed-screen','timed-result-screen','collection-screen','daily-screen',\n    'pk-screen','pk-result-screen','characters-screen'];\n  screens.forEach(id => {\n    const el = document.getElementById(id);\n    if (el) el.classList.remove('active');\n  });\n\n  switch (game.state) {\n    case 'menu': renderMenu(game); break;\n    case 'map': renderMap(game); break;\n    case 'playing': renderGame(game); break;\n    case 'result': renderResult(game); break;\n    case 'timed': renderTimed(game); break;\n    case 'timed_result': renderTimedResult(game); break;\n    case 'collection': renderCollection(game); break;\n    case 'daily': renderDaily(game); break;\n    case 'pk': renderPK(game); break;\n    case 'pk_result': renderPKResult(game); break;\n    case 'characters': renderCharacters(game); break;\n  }\n}\n\nfunction showScreen(id) {\n  const el = document.getElementById(id);\n  if (el) el.classList.add('active');\n}\n\nfunction renderMenu(game) {\n  showScreen('menu-screen');\n  const mc = document.getElementById('menu-coins');\n  const mcl = document.getElementById('menu-collected');\n  if (mc) mc.textContent = game.data.coins;\n  if (mcl) mcl.textContent = game.data.collectedCount;\n\n  const charAvatar = document.getElementById('menu-avatar');\n  if (charAvatar) {\n    const ch = game.characters.getCurrent();\n    charAvatar.textContent = ch.avatar;\n  }\n}\n\nfunction renderMap(game) {\n  showScreen('map-screen');\n  const mc = document.getElementById('map-coins');\n  if (mc) mc.textContent = game.data.coins;\n\n  const grid = document.getElementById('level-grid');\n  if (!grid) return;\n  grid.innerHTML = '';\n\n  const chapters = {};\n  LEVELS.forEach(l => {\n    if (!chapters[l.chapter]) chapters[l.chapter] = [];\n    chapters[l.chapter].push(l);\n  });\n\n  const chapInfo = document.getElementById('chapter-info');\n  if (chapInfo) {\n    chapInfo.innerHTML = CHAPTERS.map(c =>\n      `<div class=\"chapter-badge\" style=\"background:${c.color};${c.id>=4?'color:#fff':''}\">${c.name} · ${c.subtitle}</div>`\n    ).join('');\n  }\n\n  Object.keys(chapters).forEach(chId => {\n    const section = document.createElement('div');\n    section.className = 'chapter-section';\n    const chap = CHAPTERS.find(c => c.id === parseInt(chId));\n    if (chap) section.style.borderColor = chap.color;\n\n    chapters[chId].forEach(level => {\n      const btn = document.createElement('button');\n      const stars = game.data.getLevelStars(level.id);\n      const unlocked = level.id <= game.data.unlockedLevel;\n      const isBoss = level.boss;\n\n      btn.className = 'level-btn' + (isBoss ? ' boss' : '') + (!unlocked ? ' locked' : '') + (stars > 0 ? ' completed' : '');\n      btn.innerHTML = `\n        <span class=\"level-num\">${level.id}</span>\n        <span class=\"level-stars\">${'★'.repeat(stars)}${'☆'.repeat(3 - stars)}</span>\n        <span class=\"level-name\">${level.name}</span>\n      `;\n\n      if (unlocked) btn.onclick = () => game.startLevel(level.id);\n      section.appendChild(btn);\n    });\n    grid.appendChild(section);\n  });\n}\n\nfunction renderGame(game) {\n  showScreen('game-screen');\n  const q = game.getCurrentQuestion();\n  if (!q) return;\n\n  const ll = document.getElementById('level-label');\n  const pl = document.getElementById('progress-label');\n  const ld = document.getElementById('lives-display');\n  if (ll) ll.textContent = `第${game.currentLevel.id}关`;\n  if (pl) pl.textContent = `${game.questionIndex + 1}/${game.questions.length}`;\n  if (ld) ld.textContent = '❤️'.repeat(Math.max(0, game.lives));\n\n  const mt = document.getElementById('meaning-text');\n  if (mt) mt.textContent = q.idiom.meaning;\n\n  const cd = document.getElementById('combo-display');\n  if (cd) {\n    if (game.combo.combo >= 3) {\n      cd.textContent = `🔥 ${game.combo.combo}连击！${game.combo.getComboMessage()}`;\n      cd.style.display = 'block';\n      cd.className = 'combo-display combo-' + Math.min(game.combo.combo, 10);\n    } else {\n      cd.style.display = 'none';\n    }\n  }\n\n  const sc = document.getElementById('slots-container');\n  if (sc) {\n    sc.innerHTML = '';\n    const slots = game.judge.getSlots();\n    for (let i = 0; i < 4; i++) {\n      const slot = document.createElement('div');\n      slot.className = 'slot';\n      if (slots[i]) {\n        slot.classList.add('filled');\n        slot.textContent = slots[i].char;\n        slot.onclick = () => { game.removeSlot(i); };\n      }\n      if (q.answered && q.correct === true) slot.classList.add('correct');\n      if (q.answered && q.correct === false) slot.classList.add('wrong');\n      sc.appendChild(slot);\n    }\n  }\n\n  const ih = document.getElementById('idiom-hint');\n  if (ih) {\n    if (q.answered && q.correct) {\n      ih.innerHTML = `<strong>${q.idiom.idiom}</strong>：${q.idiom.meaning}`;\n      ih.style.display = 'block';\n    } else {\n      ih.style.display = 'none';\n    }\n  }\n\n  const cc = document.getElementById('candidates-container');\n  if (cc) {\n    cc.innerHTML = '';\n    q.candidates.forEach((c, i) => {\n      const btn = document.createElement('button');\n      btn.className = 'candidate';\n      btn.textContent = c.char;\n      if (c.used) btn.classList.add('used');\n      if (c.removed) btn.classList.add('removed');\n      if (!c.used && !c.removed && !q.answered) btn.onclick = () => game.pickChar(i);\n      cc.appendChild(btn);\n    });\n  }\n\n  const to = document.getElementById('tutorial-overlay');\n  const tt = document.getElementById('tutorial-text');\n  if (to && tt) {\n    const step = game.tutorial.getCurrentStep();\n    if (step) { tt.textContent = step.msg; to.style.display = 'flex'; }\n    else { to.style.display = 'none'; }\n  }\n\n  // Update tool button costs\n  const hintBtns = document.querySelectorAll('.tool-btn');\n  if (hintBtns.length >= 3) {\n    hintBtns[0].textContent = `📖 揭示 (${game.hintRevealCost}🪙)`;\n    hintBtns[1].textContent = `✂️ 去干扰 (${game.hintRemoveCost}🪙)`;\n    hintBtns[2].textContent = `⏭ 跳过 (${game.skipCost}🪙)`;\n  }\n}\n\nfunction renderResult(game) {\n  showScreen('result-screen');\n  const r = game.levelResult;\n  if (!r) return;\n\n  const rt = document.getElementById('result-title');\n  if (rt) rt.textContent = r.stars > 0 ? '🎉 通关!' : '😞 失败';\n\n  const rs = document.getElementById('result-stars');\n  if (rs) rs.innerHTML = '★'.repeat(r.stars) + '☆'.repeat(3 - r.stars);\n\n  document.getElementById('result-correct').textContent = r.correctCount;\n  document.getElementById('result-total').textContent = r.totalQuestions;\n  document.getElementById('result-score').textContent = r.score;\n  document.getElementById('result-combo').textContent = r.maxCombo;\n  document.getElementById('result-coins').textContent = r.coins;\n\n  const btnNext = document.getElementById('btn-next');\n  if (btnNext) {\n    const nextId = game.currentLevel.id + 1;\n    btnNext.style.display = (r.stars > 0 && LEVELS.find(l => l.id === nextId)) ? 'inline-block' : 'none';\n  }\n  const btnRetry = document.getElementById('btn-retry');\n  if (btnRetry) btnRetry.style.display = r.stars > 0 ? 'none' : 'inline-block';\n}\n\n// ===== W2: Timed Challenge =====\nfunction renderTimed(game) {\n  showScreen('timed-screen');\n  const tc = game.timed;\n  const q = tc.currentQ;\n  if (!q) return;\n\n  const timer = document.getElementById('timed-timer');\n  if (timer) {\n    timer.textContent = `${tc.timeLeft}s`;\n    timer.className = 'timer-display' + (tc.timeLeft <= 10 ? ' timer-warning' : '');\n  }\n\n  const score = document.getElementById('timed-score');\n  if (score) score.textContent = tc.score;\n\n  const combo = document.getElementById('timed-combo');\n  if (combo) {\n    if (game.combo.combo >= 3) {\n      combo.textContent = `🔥 ${game.combo.combo}连击！`;\n      combo.style.display = 'block';\n    } else {\n      combo.style.display = 'none';\n    }\n  }\n\n  const mt = document.getElementById('timed-meaning');\n  if (mt) mt.textContent = q.idiom.meaning;\n\n  const sc = document.getElementById('timed-slots');\n  if (sc) {\n    sc.innerHTML = '';\n    const slots = tc.judge.getSlots();\n    for (let i = 0; i < 4; i++) {\n      const slot = document.createElement('div');\n      slot.className = 'slot';\n      if (slots[i]) { slot.classList.add('filled'); slot.textContent = slots[i].char; slot.onclick = () => tc.removeSlot(i); }\n      if (q.answered && q.correct === true) slot.classList.add('correct');\n      if (q.answered && q.correct === false) slot.classList.add('wrong');\n      sc.appendChild(slot);\n    }\n  }\n\n  const cc = document.getElementById('timed-candidates');\n  if (cc) {\n    cc.innerHTML = '';\n    q.candidates.forEach((c, i) => {\n      const btn = document.createElement('button');\n      btn.className = 'candidate';\n      btn.textContent = c.char;\n      if (c.used) btn.classList.add('used');\n      if (c.removed) btn.classList.add('removed');\n      if (!c.used && !c.removed && !q.answered) btn.onclick = () => tc.pickChar(i);\n      cc.appendChild(btn);\n    });\n  }\n}\n\nfunction renderTimedResult(game) {\n  showScreen('timed-result-screen');\n  const r = game.timed.getResult();\n  document.getElementById('tr-score').textContent = r.score;\n  document.getElementById('tr-correct').textContent = r.correctCount;\n  document.getElementById('tr-total').textContent = r.answeredCount;\n  document.getElementById('tr-combo').textContent = r.maxCombo;\n  document.getElementById('tr-coins').textContent = Math.floor(r.score / 10);\n}\n\n// ===== W2: Collection =====\nfunction renderCollection(game) {\n  showScreen('collection-screen');\n  const col = game.collection;\n  const progress = col.getProgress();\n\n  document.getElementById('col-progress').textContent = `${progress.collected}/${progress.total} (${progress.percent}%)`;\n\n  const bar = document.getElementById('col-progress-bar');\n  if (bar) bar.style.width = progress.percent + '%';\n\n  // Categories\n  const catContainer = document.getElementById('col-categories');\n  if (catContainer) {\n    const cats = ['全部', ...col.getCategories()];\n    catContainer.innerHTML = cats.map(c =>\n      `<button class=\"cat-btn${col.selectedCategory === (c === '全部' ? null : c) ? ' active' : ''}\" onclick=\"handleCategoryFilter('${c}')\">${c}</button>`\n    ).join('');\n  }\n\n  // Search\n  const searchInput = document.getElementById('col-search');\n  if (searchInput && searchInput.value !== col.searchQuery) {\n    searchInput.value = col.searchQuery;\n  }\n\n  // Idiom grid\n  const grid = document.getElementById('col-grid');\n  if (grid) {\n    const idioms = col.getFilteredIdioms();\n    grid.innerHTML = idioms.slice(0, 60).map(i =>\n      `<div class=\"idiom-card${i.collected ? ' collected' : ''}\" onclick=\"handleIdiomSelect('${i.id}')\">\n        <span class=\"idiom-text\">${i.collected ? i.idiom : '？？？？'}</span>\n        <span class=\"idiom-cat\">${(i.category || [])[0] || ''}</span>\n      </div>`\n    ).join('');\n    if (idioms.length > 60) {\n      grid.innerHTML += `<div class=\"more-hint\">还有${idioms.length - 60}个...</div>`;\n    }\n  }\n\n  // Detail view\n  const detail = document.getElementById('col-detail');\n  if (detail) {\n    if (col.selectedIdiom) {\n      const i = col.selectedIdiom;\n      const collected = game.data.collectedIdioms.includes(i.id);\n      detail.style.display = 'block';\n      detail.innerHTML = `\n        <div class=\"detail-header\">\n          <h3>${collected ? i.idiom : '？？？？'}</h3>\n          <button class=\"btn-back\" onclick=\"game.collection.selectIdiom(null)\">✕</button>\n        </div>\n        ${collected ? `\n          <p class=\"detail-pinyin\">${i.pinyin || ''}</p>\n          <p class=\"detail-meaning\">${i.meaning}</p>\n          ${i.origin ? `<p class=\"detail-origin\">出处：${i.origin}</p>` : ''}\n          ${i.example ? `<p class=\"detail-example\">例句：${i.example}</p>` : ''}\n        ` : '<p class=\"detail-locked\">收集此成语后可查看详情</p>'}\n      `;\n    } else {\n      detail.style.display = 'none';\n    }\n  }\n}\n\n// ===== W2: Daily =====\nfunction renderDaily(game) {\n  showScreen('daily-screen');\n  const ds = game.daily.getDailyState();\n\n  document.getElementById('daily-streak').textContent = ds.loginStreak;\n  document.getElementById('daily-claimed').textContent = ds.todayClaimed ? '已领取' : '未领取';\n  document.getElementById('daily-claim-btn').disabled = ds.todayClaimed;\n  document.getElementById('daily-claim-btn').textContent = ds.todayClaimed ? '已领取 ✓' : `领取签到奖励 (×${Math.min(ds.loginStreak, 7)}0🪙)`;\n\n  // Tasks\n  const tasksEl = document.getElementById('daily-tasks');\n  if (tasksEl) {\n    tasksEl.innerHTML = ds.tasks.map(t => `\n      <div class=\"task-item${t.claimed ? ' done' : ''}\">\n        <span class=\"task-desc\">${t.desc}</span>\n        <span class=\"task-progress\">${t.progress}/${t.target}</span>\n        <button class=\"task-btn${t.claimed ? ' claimed' : ''}\"\n          ${t.claimed || t.progress < t.target ? 'disabled' : ''}\n          onclick=\"handleClaimTask('${t.id}')\">\n          ${t.claimed ? '已领' : `${t.reward}🪙`}\n        </button>\n      </div>\n    `).join('');\n  }\n\n  // Challenge\n  const challengeEl = document.getElementById('daily-challenge');\n  if (challengeEl) {\n    if (ds.challengeIdiom) {\n      challengeEl.innerHTML = `\n        <div class=\"challenge-card${ds.challengeCompleted ? ' done' : ''}\">\n          <h4>今日成语挑战</h4>\n          <p class=\"challenge-meaning\">${ds.challengeIdiom.meaning}</p>\n          <p class=\"challenge-hint\">${ds.challengeCompleted ? `答案：${ds.challengeIdiom.idiom}` : '提示：' + ds.challengeIdiom.chars[0] + '？？？'}</p>\n          ${ds.challengeCompleted ?\n            '<span class=\"challenge-done\">已完成 ✓ +50🪙</span>' :\n            `<button class=\"btn btn-primary btn-sm\" onclick=\"handleDailyChallenge()\">挑战</button>`\n          }\n        </div>\n      `;\n    }\n  }\n}\n\n// ===== W2: PK =====\nfunction renderPK(game) {\n  showScreen('pk-screen');\n  const pk = game.pk;\n  const q = pk.currentQ;\n  if (!q) return;\n\n  document.getElementById('pk-progress').textContent = `${pk.currentIndex + 1}/5`;\n\n  const mt = document.getElementById('pk-meaning');\n  if (mt) mt.textContent = q.idiom.meaning;\n\n  const sc = document.getElementById('pk-slots');\n  if (sc) {\n    sc.innerHTML = '';\n    const slots = pk.judge.getSlots();\n    for (let i = 0; i < 4; i++) {\n      const slot = document.createElement('div');\n      slot.className = 'slot';\n      if (slots[i]) { slot.classList.add('filled'); slot.textContent = slots[i].char; slot.onclick = () => pk.removeSlot(i); }\n      if (q.answered && q.correct === true) slot.classList.add('correct');\n      if (q.answered && q.correct === false) slot.classList.add('wrong');\n      sc.appendChild(slot);\n    }\n  }\n\n  const cc = document.getElementById('pk-candidates');\n  if (cc) {\n    cc.innerHTML = '';\n    q.candidates.forEach((c, i) => {\n      const btn = document.createElement('button');\n      btn.className = 'candidate';\n      btn.textContent = c.char;\n      if (c.used) btn.classList.add('used');\n      if (c.removed) btn.classList.add('removed');\n      if (!c.used && !c.removed && !q.answered) btn.onclick = () => pk.pickChar(i);\n      cc.appendChild(btn);\n    });\n  }\n}\n\nfunction renderPKResult(game) {\n  showScreen('pk-result-screen');\n  const r = game.pk.getResult();\n  document.getElementById('pkr-result').textContent = r.won ? '🎉 胜利！' : '😢 惜败';\n  document.getElementById('pkr-correct').textContent = `${r.correctCount}/5`;\n  document.getElementById('pkr-time').textContent = `${(r.time / 1000).toFixed(1)}s`;\n  document.getElementById('pkr-reward').textContent = r.won ? '+50🪙' : '';\n\n  // Answers review\n  const answersEl = document.getElementById('pkr-answers');\n  if (answersEl) {\n    answersEl.innerHTML = r.answers.map((a, i) =>\n      `<div class=\"answer-item${a.correct ? ' correct' : ' wrong'}\">${i+1}. ${a.idiom} ${a.correct ? '✓' : '✗'}</div>`\n    ).join('');\n  }\n}\n\n// ===== W2: Characters =====\nfunction renderCharacters(game) {\n  showScreen('characters-screen');\n  const chars = game.characters.getAll();\n\n  const grid = document.getElementById('char-grid');\n  if (grid) {\n    grid.innerHTML = chars.map(c => {\n      const selected = game.data.data.characters.current === c.id;\n      return `\n        <div class=\"char-card${selected ? ' selected' : ''}${!c.unlocked ? ' locked' : ''}\"\n             onclick=\"${c.unlocked ? `game.characters.select('${c.id}'); game.render()` : ''}\">\n          <div class=\"char-avatar\">${c.unlocked ? c.avatar : '🔒'}</div>\n          <div class=\"char-name\">${c.name}</div>\n          <div class=\"char-skill\">${c.unlocked ? c.skill.name : `通关第${c.unlock.level || '?'}关解锁`}</div>\n          ${selected ? '<div class=\"char-badge\">使用中</div>' : ''}\n        </div>\n      `;\n    }).join('');\n  }\n\n  // Skill detail\n  const current = game.characters.getCurrent();\n  const detail = document.getElementById('char-detail');\n  if (detail) {\n    detail.innerHTML = `\n      <h4>${current.avatar} ${current.name}</h4>\n      <p class=\"skill-name\">${current.skill.name}</p>\n      <p class=\"skill-desc\">${current.skill.desc}</p>\n    `;\n  }\n}\n\n// ===== Global handlers =====\nfunction handleCategoryFilter(cat) {\n  if (cat === '全部') { game.collection.clearFilter(); }\n  else { game.collection.filterByCategory(cat); }\n  game.render();\n}\n\nfunction handleIdiomSelect(id) { game.collection.selectIdiom(id); game.render(); }\n\nfunction handleClaimTask(taskId) { game.daily.claimTask(taskId); game.render(); }\n\nfunction handleDailyChallenge() {\n  const ds = game.daily.getDailyState();\n  if (ds.challengeIdiom && !ds.challengeCompleted) {\n    game.daily.completeChallenge();\n    game.render();\n  }\n}\n\nfunction handleColSearch(val) { game.collection.search(val); game.render(); }\n","numLines":495,"startLine":1,"totalLines":495}}}
