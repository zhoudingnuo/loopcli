{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_123ab637d8d2413b91ef2429","type":"tool_result","content":"1\t// Renderer.ts — Canvas 2D rendering system (v0.2.0 — M2)\n2\t\n3\timport { Camera } from './Camera';\n4\timport { StoreMap, T } from '../game/StoreMap';\n5\timport { Player } from '../game/Player';\n6\timport { Lighting } from './Lighting';\n7\timport {\n8\t  type GameState,\n9\t  type GamePhase,\n10\t  type LightSource,\n11\t  type Interactable,\n12\t  GamePhase as GP,\n13\t  UIPanel,\n14\t  getTimeString,\n15\t  isNightTime,\n16\t} from '../game/GameState';\n17\timport { Customer } from '../game/Customer';\n18\timport { ProductManager } from '../game/ProductManager';\n19\timport { ShelfInteraction, ShelfAction } from '../game/ShelfInteraction';\n20\timport { CashRegister, RegisterState } from '../game/CashRegister';\n21\timport { EconomySystem } from '../game/EconomySystem';\n22\timport { PricingSystem } from '../game/PricingSystem';\n23\timport { DaySummaryManager } from '../game/DaySummary';\n24\timport { UpgradeManager } from '../game/UpgradeManager';\n25\timport { type HorrorVisualState } from '../game/HorrorEventManager';\n26\timport { type JumpScareVisualState } from '../game/JumpScareManager';\n27\timport { type HorrorNPC } from '../game/BehaviorTree';\n28\t\n29\texport interface RenderContext {\n30\t  customers: Customer[];\n31\t  productManager: ProductManager;\n32\t  shelfInteraction: ShelfInteraction;\n33\t  registers: CashRegister[];\n34\t  economy: EconomySystem;\n35\t  pricing: PricingSystem;\n36\t  lastTransaction: string;\n37\t  daySummary?: DaySummaryManager;\n38\t  upgradeManager?: UpgradeManager;\n39\t  horrorVisuals?: HorrorVisualState;\n40\t  scareVisuals?: JumpScareVisualState;\n41\t  activeNPCs?: ReadonlyArray<HorrorNPC>;\n42\t}\n43\t\n44\texport class Renderer {\n45\t  canvas: HTMLCanvasElement;\n46\t  ctx: CanvasRenderingContext2D;\n47\t  camera: Camera;\n48\t  lighting: Lighting;\n49\t\n50\t  constructor(canvas: HTMLCanvasElement) {\n51\t    this.canvas = canvas;\n52\t    this.ctx = canvas.getContext('2d')!;\n53\t    this.camera = new Camera(canvas);\n54\t    this.lighting = new Lighting();\n55\t    this.resize();\n56\t    this.camera.setupZoom(canvas);\n57\t  }\n58\t\n59\t  resize(): void {\n60\t    const dpr = window.devicePixelRatio || 1;\n61\t    const rect = this.canvas.getBoundingClientRect();\n62\t    this.canvas.width = rect.width * dpr;\n63\t    this.canvas.height = rect.height * dpr;\n64\t    this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n65\t  }\n66\t\n67\t  render(\n68\t    map: StoreMap,\n69\t    player: Player,\n70\t    state: GameState,\n71\t    now: number,\n72\t    ctx?: RenderContext,\n73\t  ): void {\n74\t    const c = this.ctx;\n75\t    const w = this.canvas.getBoundingClientRect().width;\n76\t    const h = this.canvas.getBoundingClientRect().height;\n77\t\n78\t    const bgPhase = state.phase;\n79\t    if (bgPhase === 'danger') {\n80\t      c.fillStyle = '#0a0a15';\n81\t    } else if (isNightTime(bgPhase)) {\n82\t      c.fillStyle = '#0f1020';\n83\t    } else {\n84\t      c.fillStyle = '#1a1520';\n85\t    }\n86\t    c.fillRect(0, 0, w, h);\n87\t\n88\t    const { offsetX, offsetY, scale } = this.camera.getTransform();\n89\t\n90\t    // Render map tiles\n91\t    map.render(c, offsetX, offsetY, w, h, scale);\n92\t\n93\t    // Render shelf product indicators\n94\t    if (ctx) {\n95\t      this.renderShelfIndicators(c, ctx.productManager, state.interactables, offsetX, offsetY, scale);\n96\t    }\n97\t\n98\t    // Render interactable highlights\n99\t    this.renderInteractables(c, state.interactables, offsetX, offsetY, scale, player, now);\n100\t\n101\t    // Render customers\n102\t    if (ctx) {\n103\t      for (const customer of ctx.customers) {\n104\t        customer.render(c, offsetX, offsetY, scale);\n105\t      }\n106\t    }\n107\t\n108\t    // Render player\n109\t    player.render(c, offsetX, offsetY, scale);\n110\t\n111\t    // Render lighting overlay (M3: pass timeOfDay for gradual transitions)\n112\t    this.lighting.render(c, w, h, state.lights, state.phase, offsetX, offsetY, scale, now, state.timeOfDay);\n113\t\n114\t    // Render HUD\n115\t    this.renderHUD(c, w, h, state, player, ctx);\n116\t\n117\t    // Render active panel\n118\t    if (ctx && state.activePanel !== UIPanel.NONE) {\n119\t      this.renderPanel(c, w, h, state, ctx);\n120\t    }\n121\t\n122\t    // M3: Render day summary overlay\n123\t    if (ctx?.daySummary) {\n124\t      ctx.daySummary.render(c, w, h);\n125\t    }\n126\t\n127\t    // M4: Render horror visual effects\n128\t    if (ctx?.horrorVisuals) {\n129\t      this.renderHorrorEffects(c, w, h, ctx.horrorVisuals, now, state);\n130\t    }\n131\t  }\n132\t\n133\t  private renderShelfIndicators(\n134\t    c: CanvasRenderingContext2D,\n135\t    pm: ProductManager,\n136\t    interactables: Interactable[],\n137\t    ox: number,\n138\t    oy: number,\n139\t    scale: number,\n140\t  ): void {\n141\t    for (const inter of interactables) {\n142\t      if (inter.type !== 'shelf' && inter.type !== 'fridge') continue;\n143\t      const slot = pm.shelfSlots.get(inter.id);\n144\t      if (!slot || !slot.productId || slot.quantity <= 0) continue;\n145\t\n146\t      const product = pm.getProduct(slot.productId);\n147\t      if (!product) continue;\n148\t\n149\t      const px = ox + inter.x * scale;\n150\t      const py = oy + (inter.y - 8) * scale;\n151\t      const pw = inter.width * scale;\n152\t\n153\t      // Stock level bar\n154\t      const ratio = slot.quantity / slot.maxQuantity;\n155\t      const barColor = ratio > 0.5 ? '#66aa66' : ratio > 0.2 ? '#aaaa44' : '#aa4444';\n156\t      c.fillStyle = 'rgba(0,0,0,0.5)';\n157\t      c.fillRect(px, py, pw, 6 * scale);\n158\t      c.fillStyle = barColor;\n159\t      c.fillRect(px, py, pw * ratio, 6 * scale);\n160\t\n161\t      // Product name\n162\t      c.fillStyle = 'rgba(255,255,255,0.7)';\n163\t      c.font = `${Math.round(8 * scale)}px monospace`;\n164\t      c.textAlign = 'center';\n165\t      c.textBaseline = 'top';\n166\t      c.fillText(`${product.name}(${slot.quantity})`, px + pw / 2, py + 7 * scale);\n167\t    }\n168\t  }\n169\t\n170\t  private renderInteractables(\n171\t    c: CanvasRenderingContext2D,\n172\t    interactables: Interactable[],\n173\t    ox: number,\n174\t    oy: number,\n175\t    scale: number,\n176\t    player: Player,\n177\t    now: number,\n178\t  ): void {\n179\t    const facing = player.getFacingTile();\n180\t\n181\t    for (const obj of interactables) {\n182\t      const px = ox + obj.x * scale;\n183\t      const py = oy + obj.y * scale;\n184\t      const pw = obj.width * scale;\n185\t      const ph = obj.height * scale;\n186\t\n187\t      const objGX = Math.floor(obj.x / 32);\n188\t      const objGY = Math.floor(obj.y / 32);\n189\t      const isFacing = facing.gx >= objGX && facing.gx <= objGX + Math.ceil(obj.width / 32) - 1 &&\n190\t        facing.gy >= objGY && facing.gy <= objGY + Math.ceil(obj.height / 32) - 1;\n191\t\n192\t      if (isFacing) {\n193\t        const pulse = 0.3 + Math.sin(now * 0.005) * 0.1;\n194\t        c.strokeStyle = `rgba(255, 255, 100, ${pulse})`;\n195\t        c.lineWidth = 2;\n196\t        c.strokeRect(px - 2, py - 2, pw + 4, ph + 4);\n197\t\n198\t        c.fillStyle = 'rgba(0,0,0,0.7)';\n199\t        const labelW = c.measureText(obj.label).width + 12;\n200\t        c.fillRect(px + pw / 2 - labelW / 2, py - 22, labelW, 18);\n201\t        c.fillStyle = '#ffdd66';\n202\t        c.font = `${Math.round(11)}px monospace`;\n203\t        c.textAlign = 'center';\n204\t        c.textBaseline = 'middle';\n205\t        c.fillText(obj.label, px + pw / 2, py - 13);\n206\t      }\n207\t    }\n208\t  }\n209\t\n210\t  private renderHUD(\n211\t    c: CanvasRenderingContext2D,\n212\t    canvasW: number,\n213\t    canvasH: number,\n214\t    state: GameState,\n215\t    player: Player,\n216\t    ctx?: RenderContext,\n217\t  ): void {\n218\t    // Top bar\n219\t    c.fillStyle = 'rgba(0,0,0,0.8)';\n220\t    c.fillRect(0, 0, canvasW, 44);\n221\t\n222\t    // Day counter\n223\t    c.fillStyle = '#e0d0b0';\n224\t    c.font = 'bold 13px monospace';\n225\t    c.textAlign = 'left';\n226\t    c.textBaseline = 'middle';\n227\t    c.fillText(`Day ${state.day}`, 12, 14);\n228\t\n229\t    // Time\n230\t    c.fillStyle = isNightTime(state.phase) ? '#8888cc' : '#ccaa66';\n231\t    c.font = '13px monospace';\n232\t    c.fillText(getTimeString(state.timeOfDay), 80, 14);\n233\t\n234\t    // Phase indicator\n235\t    const phaseLabels: Record<string, string> = {\n236\t      daytime: '营业中',\n237\t      night_transition: '准备打烊',\n238\t      night: '深夜营业',\n239\t      danger: '危险时段',\n240\t      dawn: '黎明',\n241\t    };\n242\t    c.fillStyle = state.phase === 'danger' ? '#ff4444' : '#aaa';\n243\t    c.font = '11px monospace';\n244\t    c.fillText(phaseLabels[state.phase] ?? state.phase, 160, 14);\n245\t\n246\t    // Money\n247\t    c.fillStyle = '#66cc66';\n248\t    c.font = '12px monospace';\n249\t    c.textAlign = 'right';\n250\t    c.fillText(`¥${state.money.toLocaleString()}`, canvasW - 12, 12);\n251\t\n252\t    // Debt\n253\t    c.fillStyle = '#cc6666';\n254\t    c.font = '10px monospace';\n255\t    c.fillText(`债务: ¥${state.debt.toLocaleString()}`, canvasW - 12, 26);\n256\t\n257\t    // Health bar\n258\t    c.textAlign = 'left';\n259\t    const hbX = 300;\n260\t    const hbY = 6;\n261\t    const hbW = 80;\n262\t    const hbH = 8;\n263\t    c.fillStyle = 'rgba(255,255,255,0.1)';\n264\t    c.fillRect(hbX, hbY, hbW, hbH);\n265\t    c.fillStyle = '#cc3333';\n266\t    c.fillRect(hbX, hbY, hbW * (state.player.health / 100), hbH);\n267\t    c.strokeStyle = 'rgba(255,255,255,0.2)';\n268\t    c.lineWidth = 1;\n269\t    c.strokeRect(hbX, hbY, hbW, hbH);\n270\t    c.fillStyle = '#aaa';\n271\t    c.font = '8px monospace';\n272\t    c.fillText('HP', hbX - 18, hbY + 7);\n273\t\n274\t    // Sanity bar\n275\t    const sbY = 18;\n276\t    c.fillStyle = 'rgba(255,255,255,0.1)';\n277\t    c.fillRect(hbX, sbY, hbW, hbH);\n278\t    c.fillStyle = '#6666cc';\n279\t    c.fillRect(hbX, sbY, hbW * (state.player.sanity / 100), hbH);\n280\t    c.strokeStyle = 'rgba(255,255,255,0.2)';\n281\t    c.strokeRect(hbX, sbY, hbW, hbH);\n282\t    c.fillStyle = '#aaa';\n283\t    c.fillText('SAN', hbX - 22, sbY + 7);\n284\t\n285\t    // Customer count\n286\t    if (ctx) {\n287\t      const custCount = ctx.customers.length;\n288\t      c.fillStyle = '#88aacc';\n289\t      c.font = '10px monospace';\n290\t      c.textAlign = 'left';\n291\t      c.fillText(`顾客: ${custCount}`, 420, 14);\n292\t    }\n293\t\n294\t    // Daily revenue\n295\t    c.fillStyle = '#88cc88';\n296\t    c.font = '10px monospace';\n297\t    c.textAlign = 'left';\n298\t    c.fillText(`今日: ¥${state.dailyRevenue.toFixed(0)}`, 500, 14);\n299\t\n300\t    // Shortcut hints\n301\t    c.fillStyle = 'rgba(255,255,255,0.4)';\n302\t    c.font = '10px monospace';\n303\t    c.textAlign = 'center';\n304\t    c.fillText('WASD 移动 | E 交互 | I 库存 | P 定价 | U 升级 | O 进货 | ESC 关闭', canvasW / 2, canvasH - 12);\n305\t\n306\t    // Notifications\n307\t    this.renderNotifications(c, canvasW, canvasH, state);\n308\t\n309\t    // Register status\n310\t    if (ctx) {\n311\t      this.renderRegisterStatus(c, canvasW, ctx.registers);\n312\t    }\n313\t  }\n314\t\n315\t  private renderNotifications(\n316\t    c: CanvasRenderingContext2D,\n317\t    w: number,\n318\t    h: number,\n319\t    state: GameState,\n320\t  ): void {\n321\t    const recent = state.notifications.slice(-5);\n322\t    if (recent.length === 0) return;\n323\t\n324\t    c.textAlign = 'right';\n325\t    c.font = '10px monospace';\n326\t    for (let i = 0; i < recent.length; i++) {\n327\t      const alpha = 0.3 + (i / recent.length) * 0.5;\n328\t      c.fillStyle = `rgba(200, 220, 255, ${alpha})`;\n329\t      c.fillText(recent[i], w - 12, h - 30 - (recent.length - 1 - i) * 14);\n330\t    }\n331\t  }\n332\t\n333\t  private renderRegisterStatus(\n334\t    c: CanvasRenderingContext2D,\n335\t    canvasW: number,\n336\t    registers: CashRegister[],\n337\t  ): void {\n338\t    let x = 12;\n339\t    const y = 48;\n340\t    for (const reg of registers) {\n341\t      const stateLabels: Record<string, string> = {\n342\t        idle: '空闲',\n343\t        scanning: '扫描中...',\n344\t        payment: '付款中',\n345\t        giving_change: '找零中',\n346\t        receipt: '打印收据',\n347\t        anomaly: '异常!',\n348\t      };\n349\t      const stateColors: Record<string, string> = {\n350\t        idle: '#666',\n351\t        scanning: '#6a6',\n352\t        payment: '#aa6',\n353\t        giving_change: '#6aa',\n354\t        receipt: '#66a',\n355\t        anomaly: '#a44',\n356\t      };\n357\t      const label = stateLabels[reg.state] ?? reg.state;\n358\t      const color = stateColors[reg.state] ?? '#666';\n359\t\n360\t      c.fillStyle = 'rgba(0,0,0,0.6)';\n361\t      c.fillRect(x, y, 80, 16);\n362\t      c.fillStyle = color;\n363\t      c.font = '9px monospace';\n364\t      c.textAlign = 'left';\n365\t      c.textBaseline = 'middle';\n366\t      c.fillText(`${reg.registerId}: ${label}`, x + 4, y + 8);\n367\t      x += 84;\n368\t    }\n369\t  }\n370\t\n371\t  private renderPanel(\n372\t    c: CanvasRenderingContext2D,\n373\t    w: number,\n374\t    h: number,\n375\t    state: GameState,\n376\t    ctx: RenderContext,\n377\t  ): void {\n378\t    // Darken background\n379\t    c.fillStyle = 'rgba(0,0,0,0.5)';\n380\t    c.fillRect(0, 0, w, h);\n381\t\n382\t    const panelW = Math.min(500, w - 40);\n383\t    const panelH = Math.min(400, h - 80);\n384\t    const px = (w - panelW) / 2;\n385\t    const py = (h - panelH) / 2;\n386\t\n387\t    // Panel background\n388\t    c.fillStyle = 'rgba(20, 20, 35, 0.95)';\n389\t    c.fillRect(px, py, panelW, panelH);\n390\t    c.strokeStyle = 'rgba(100, 120, 160, 0.5)';\n391\t    c.lineWidth = 1;\n392\t    c.strokeRect(px, py, panelW, panelH);\n393\t\n394\t    // Title bar\n395\t    c.fillStyle = 'rgba(40, 40, 60, 0.9)';\n396\t    c.fillRect(px, py, panelW, 30);\n397\t\n398\t    switch (state.activePanel) {\n399\t      case UIPanel.SHELF:\n400\t        this.renderShelfPanel(c, px, py, panelW, panelH, ctx);\n401\t        break;\n402\t      case UIPanel.INVENTORY:\n403\t        this.renderInventoryPanel(c, px, py, panelW, panelH, ctx);\n404\t        break;\n405\t      case UIPanel.PRICING:\n406\t        this.renderPricingPanel(c, px, py, panelW, panelH, ctx);\n407\t        break;\n408\t      case UIPanel.SHOP:\n409\t        this.renderShopPanel(c, px, py, panelW, panelH, ctx);\n410\t        break;\n411\t      case UIPanel.SUPPLIER:\n412\t        this.renderSupplierPanel(c, px, py, panelW, panelH, state, ctx);\n413\t        break;\n414\t    }\n415\t\n416\t    // Close button hint\n417\t    c.fillStyle = 'rgba(255,255,255,0.4)';\n418\t    c.font = '10px monospace';\n419\t    c.textAlign = 'center';\n420\t    c.fillText('按 ESC 或 E 关闭', w / 2, py + panelH + 15);\n421\t  }\n422\t\n423\t  private renderShelfPanel(\n424\t    c: CanvasRenderingContext2D,\n425\t    px: number, py: number,\n426\t    pw: number, ph: number,\n427\t    ctx: RenderContext,\n428\t  ): void {\n429\t    const shelf = ctx.shelfInteraction;\n430\t    if (!shelf.currentShelfId) return;\n431\t\n432\t    c.fillStyle = '#e0d0b0';\n433\t    c.font = 'bold 14px monospace';\n434\t    c.textAlign = 'left';\n435\t    c.textBaseline = 'top';\n436\t    c.fillText('货架管理', px + 10, py + 8);\n437\t\n438\t    const slot = ctx.productManager.shelfSlots.get(shelf.currentShelfId);\n439\t    if (!slot) return;\n440\t\n441\t    let y = py + 40;\n442\t\n443\t    if (slot.productId && slot.quantity > 0) {\n444\t      const product = ctx.productManager.getProduct(slot.productId);\n445\t      c.fillStyle = '#aac';\n446\t      c.font = '12px monospace';\n447\t      c.fillText(`商品: ${product?.name ?? slot.productId}`, px + 10, y);\n448\t      y += 18;\n449\t      c.fillText(`库存: ${slot.quantity}/${slot.maxQuantity}`, px + 10, y);\n450\t      y += 18;\n451\t      const price = ctx.pricing.getPrice(slot.productId);\n452\t      c.fillText(`售价: ¥${price.toFixed(2)}`, px + 10, y);\n453\t      y += 30;\n454\t    } else {\n455\t      c.fillStyle = '#888';\n456\t      c.font = '12px monospace';\n457\t      c.fillText('空货架', px + 10, y);\n458\t      y += 30;\n459\t    }\n460\t\n461\t    // Available products to stock\n462\t    c.fillStyle = '#ccc';\n463\t    c.font = '11px monospace';\n464\t    c.fillText('可上架商品:', px + 10, y);\n465\t    y += 18;\n466\t\n467\t    const available = shelf.getAvailableProductsForShelf(shelf.currentShelfId, ctx.productManager);\n468\t    for (let i = 0; i < Math.min(available.length, 8); i++) {\n469\t      const item = available[i];\n470\t      c.fillStyle = '#aab8cc';\n471\t      c.font = '11px monospace';\n472\t      c.fillText(`  ${item.name} x${item.quantity}`, px + 10, y);\n473\t      y += 16;\n474\t    }\n475\t\n476\t    if (available.length === 0) {\n477\t      c.fillStyle = '#666';\n478\t      c.fillText('  (无库存)', px + 10, y);\n479\t    }\n480\t  }\n481\t\n482\t  private renderInventoryPanel(\n483\t    c: CanvasRenderingContext2D,\n484\t    px: number, py: number,\n485\t    pw: number, ph: number,\n486\t    ctx: RenderContext,\n487\t  ): void {\n488\t    c.fillStyle = '#e0d0b0';\n489\t    c.font = 'bold 14px monospace';\n490\t    c.textAlign = 'left';\n491\t    c.textBaseline = 'top';\n492\t    c.fillText('库存管理', px + 10, py + 8);\n493\t\n494\t    let y = py + 40;\n495\t    c.fillStyle = '#aaa';\n496\t    c.font = '10px monospace';\n497\t    c.fillText(`仓库容量: ${ctx.productManager.storageUsed}/${ctx.productManager.storageCapacity}`, px + 10, y);\n498\t    y += 20;\n499\t\n500\t    for (const [id, item] of ctx.productManager.inventory) {\n501\t      if (item.quantity <= 0) continue;\n502\t      const product = ctx.productManager.getProduct(id);\n503\t      const price = ctx.pricing.getPrice(id);\n504\t      c.fillStyle = '#bbb';\n505\t      c.font = '11px monospace';\n506\t      c.fillText(`${product?.name ?? id}  x${item.quantity}  ¥${price.toFixed(2)}/个`, px + 10, y);\n507\t      y += 16;\n508\t      if (y > py + ph - 30) break;\n509\t    }\n510\t  }\n511\t\n512\t  private renderPricingPanel(\n513\t    c: CanvasRenderingContext2D,\n514\t    px: number, py: number,\n515\t    pw: number, ph: number,\n516\t    ctx: RenderContext,\n517\t  ): void {\n518\t    c.fillStyle = '#e0d0b0';\n519\t    c.font = 'bold 14px monospace';\n520\t    c.textAlign = 'left';\n521\t    c.textBaseline = 'top';\n522\t    c.fillText('定价管理', px + 10, py + 8);\n523\t\n524\t    let y = py + 40;\n525\t    const prices = ctx.pricing.getAllPrices();\n526\t\n527\t    c.fillStyle = '#888';\n528\t    c.font = '10px monospace';\n529\t    c.fillText('商品           基价      现价      范围', px + 10, y);\n530\t    y += 16;\n531\t\n532\t    for (const entry of prices) {\n533\t      const product = ctx.productManager.getProduct(entry.productId);\n534\t      if (!product) continue;\n535\t      c.fillStyle = '#bbb';\n536\t      c.font = '10px monospace';\n537\t      const name = product.name.padEnd(8, '　');\n538\t      c.fillText(\n539\t        `${name}  ¥${entry.basePrice.toFixed(0).padStart(3)}   ¥${entry.currentPrice.toFixed(0).padStart(3)}   ${entry.minPrice.toFixed(0)}-${entry.maxPrice.toFixed(0)}`,\n540\t        px + 10, y,\n541\t      );\n542\t      y += 14;\n543\t      if (y > py + ph - 30) break;\n544\t    }\n545\t  }\n546\t\n547\t  private renderShopPanel(\n548\t    c: CanvasRenderingContext2D,\n549\t    px: number, py: number,\n550\t    pw: number, ph: number,\n551\t    ctx: RenderContext,\n552\t  ): void {\n553\t    c.fillStyle = '#e0d0b0';\n554\t    c.font = 'bold 14px monospace';\n555\t    c.textAlign = 'left';\n556\t    c.textBaseline = 'top';\n557\t    c.fillText('店铺升级', px + 10, py + 8);\n558\t\n559\t    let y = py + 40;\n560\t    const upgrades = ctx.upgradeManager\n561\t      ? ctx.upgradeManager.getUpgrades()\n562\t      : ctx.economy.getUpgrades();\n563\t\n564\t    for (const upgrade of upgrades) {\n565\t      const owned = ctx.upgradeManager\n566\t        ? ctx.upgradeManager.isPurchased(upgrade.id)\n567\t        : ctx.economy.hasUpgrade(upgrade.id);\n568\t      c.fillStyle = owned ? '#5a7a5a' : '#bbb';\n569\t      c.font = '11px monospace';\n570\t      c.fillText(\n571\t        `${owned ? '[已购]' : `¥${upgrade.cost}`.padStart(6)} ${upgrade.name} — ${upgrade.description}`,\n572\t        px + 10, y,\n573\t      );\n574\t      y += 16;\n575\t      c.fillStyle = '#777';\n576\t      c.font = '9px monospace';\n577\t      c.fillText(`  ${upgrade.horrorLink}`, px + 10, y);\n578\t      y += 14;\n579\t      if (y > py + ph - 30) break;\n580\t    }\n581\t  }\n582\t\n583\t  private renderSupplierPanel(\n584\t    c: CanvasRenderingContext2D,\n585\t    px: number, py: number,\n586\t    pw: number, ph: number,\n587\t    state: GameState,\n588\t    ctx: RenderContext,\n589\t  ): void {\n590\t    c.fillStyle = '#e0d0b0';\n591\t    c.font = 'bold 14px monospace';\n592\t    c.textAlign = 'left';\n593\t    c.textBaseline = 'top';\n594\t    c.fillText('进货管理', px + 10, py + 8);\n595\t\n596\t    let y = py + 40;\n597\t\n598\t    // Show suppliers\n599\t    const isNight = isNightTime(state.phase);\n600\t    const suppliers = ctx.productManager.getUnlockedSuppliers(state.day, isNight);\n601\t    c.fillStyle = '#888';\n602\t    c.font = '10px monospace';\n603\t    c.fillText('可用供应商:', px + 10, y);\n604\t    y += 16;\n605\t\n606\t    for (const supplier of suppliers) {\n607\t      c.fillStyle = '#aab8cc';\n608\t      c.font = '11px monospace';\n609\t      c.fillText(`${supplier.name} — ${supplier.description}`, px + 10, y);\n610\t      y += 14;\n611\t      c.fillStyle = '#777';\n612\t      c.font = '9px monospace';\n613\t      c.fillText(`  价格x${supplier.priceMultiplier} 可靠度${Math.round(supplier.reliability * 100)}%`, px + 10, y);\n614\t      y += 16;\n615\t    }\n616\t\n617\t    y += 10;\n618\t\n619\t    // Pending orders\n620\t    if (ctx.productManager.pendingOrders.length > 0) {\n621\t      c.fillStyle = '#888';\n622\t      c.font = '10px monospace';\n623\t      c.fillText('待到货订单:', px + 10, y);\n624\t      y += 16;\n625\t\n626\t      for (const order of ctx.productManager.pendingOrders) {\n627\t        const product = ctx.productManager.getProduct(order.productId);\n628\t        c.fillStyle = '#cc9';\n629\t        c.font = '10px monospace';\n630\t        c.fillText(`${product?.name ?? order.productId} x${order.quantity} — ¥${order.totalCost} (Day ${order.arrivalDay}到)`, px + 10, y);\n631\t        y += 14;\n632\t        if (y > py + ph - 30) break;\n633\t      }\n634\t    }\n635\t  }\n636\t\n637\t  // M4: Horror visual effects rendering\n638\t  private renderHorrorEffects(\n639\t    c: CanvasRenderingContext2D,\n640\t    w: number,\n641\t    h: number,\n642\t    vs: HorrorVisualState,\n643\t    now: number,\n644\t    state: GameState,\n645\t  ): void {\n646\t    // Vignette (always present at night, stronger during horror)\n647\t    if (vs.vignetteIntensity > 0) {\n648\t      const vigGrad = c.createRadialGradient(w / 2, h / 2, w * 0.3, w / 2, h / 2, w * 0.7);\n649\t      vigGrad.addColorStop(0, 'rgba(0,0,0,0)');\n650\t      vigGrad.addColorStop(1, `rgba(0,0,0,${vs.vignetteIntensity})`);\n651\t      c.fillStyle = vigGrad;\n652\t      c.fillRect(0, 0, w, h);\n653\t    }\n654\t\n655\t    // Frost effect (temp drop)\n656\t    if (vs.frostIntensity > 0) {\n657\t      const fi = vs.frostIntensity;\n658\t      const frostGrad = c.createRadialGradient(w / 2, h / 2, w * 0.35, w / 2, h / 2, w * 0.6);\n659\t      frostGrad.addColorStop(0, 'rgba(0,0,0,0)');\n660\t      frostGrad.addColorStop(0.7, `rgba(180,210,240,${fi * 0.15})`);\n661\t      frostGrad.addColorStop(1, `rgba(200,220,255,${fi * 0.4})`);\n662\t      c.fillStyle = frostGrad;\n663\t      c.fillRect(0, 0, w, h);\n664\t\n665\t      c.fillStyle = `rgba(220,240,255,${fi * 0.6})`;\n666\t      const seed = Math.floor(now * 0.001);\n667\t      for (let i = 0; i < 30; i++) {\n668\t        const px = ((seed * 7 + i * 131) % w);\n669\t        const py = ((seed * 13 + i * 97) % h);\n670\t        const size = 1 + ((seed + i * 17) % 3);\n671\t        c.fillRect(px, py, size, size);\n672\t      }\n673\t    }\n674\t\n675\t    // Extra darkness\n676\t    if (vs.darknessBoost > 0) {\n677\t      c.fillStyle = `rgba(0,0,5,${vs.darknessBoost})`;\n678\t      c.fillRect(0, 0, w, h);\n679\t    }\n680\t\n681\t    // Screen shake\n682\t    if (vs.screenShake > 0) {\n683\t      const shakeX = (Math.random() - 0.5) * vs.screenShake * 6;\n684\t      const shakeY = (Math.random() - 0.5) * vs.screenShake * 6;\n685\t      c.drawImage(c.canvas, shakeX, shakeY);\n686\t    }\n687\t\n688\t    // Chromatic aberration\n689\t    if (vs.chromaticAberration > 0) {\n690\t      const ca = vs.chromaticAberration;\n691\t      c.globalCompositeOperation = 'lighter';\n692\t      c.globalAlpha = ca * 0.08;\n693\t      c.fillStyle = '#ff0000';\n694\t      c.fillRect(ca * -3, 0, w, h);\n695\t      c.fillStyle = '#0000ff';\n696\t      c.fillRect(ca * 3, 0, w, h);\n697\t      c.globalAlpha = 1;\n698\t      c.globalCompositeOperation = 'source-over';\n699\t    }\n700\t\n701\t    // Blood on shelves\n702\t    for (const blood of vs.bloodPositions) {\n703\t      c.fillStyle = `rgba(120, 10, 10, ${blood.alpha})`;\n704\t      c.beginPath();\n705\t      c.ellipse(blood.x, blood.y, blood.size, blood.size * 0.7, 0, 0, Math.PI * 2);\n706\t      c.fill();\n707\t      c.fillStyle = `rgba(100, 5, 5, ${blood.alpha * 0.7})`;\n708\t      c.fillRect(blood.x - 2, blood.y, 4, blood.size * 1.5);\n709\t    }\n710\t\n711\t    // Ghost entities\n712\t    if (vs.ghostEntity && vs.ghostEntity.active && vs.ghostEntity.opacity > 0.01) {\n713\t      const ge = vs.ghostEntity;\n714\t      c.globalAlpha = ge.opacity;\n715\t\n716\t      switch (ge.type) {\n717\t        case 'ghost_customer':\n718\t          c.fillStyle = '#8899aa';\n719\t          c.fillRect(ge.x, ge.y + 16, 16, 24);\n720\t          c.fillStyle = '#aabbcc';\n721\t          c.beginPath();\n722\t          c.arc(ge.x + 8, ge.y + 8, 8, 0, Math.PI * 2);\n723\t          c.fill();\n724\t          break;\n725\t        case 'duplicate':\n726\t          c.fillStyle = '#444455';\n727\t          c.fillRect(ge.x, ge.y + 8, 16, 28);\n728\t          c.fillStyle = '#888899';\n729\t          c.fillRect(ge.x + 2, ge.y, 12, 10);\n730\t          c.fillStyle = '#ff0000';\n731\t          c.fillRect(ge.x + 4, ge.y + 3, 3, 2);\n732\t          c.fillRect(ge.x + 10, ge.y + 3, 3, 2);\n733\t          break;\n734\t        case 'nonpaying':\n735\t          c.fillStyle = '#1a1a22';\n736\t          c.fillRect(ge.x, ge.y + 8, 16, 28);\n737\t          c.fillStyle = '#777788';\n738\t          c.fillRect(ge.x + 2, ge.y, 12, 10);\n739\t          c.fillStyle = '#ccddff';\n740\t          c.fillRect(ge.x + 4, ge.y + 3, 2, 3);\n741\t          c.fillRect(ge.x + 10, ge.y + 3, 2, 3);\n742\t          break;\n743\t      }\n744\t      c.globalAlpha = 1;\n745\t    }\n746\t\n747\t    // Door open darkness\n748\t    if (vs.doorState.frontOpen || vs.doorState.backOpen) {\n749\t      c.fillStyle = 'rgba(0,0,0,0.9)';\n750\t      c.fillRect(0, 0, w, h * 0.15);\n751\t      c.fillRect(0, h * 0.85, w, h * 0.15);\n752\t    }\n753\t\n754\t    // Time glitch\n755\t    if (vs.timeGlitchActive) {\n756\t      c.fillStyle = 'rgba(255,0,0,0.05)';\n757\t      c.fillRect(0, 0, w, h);\n758\t      for (let i = 0; i < 8; i++) {\n759\t        const y = (now * 0.1 + i * 67) % h;\n760\t        c.fillStyle = `rgba(${Math.random() > 0.5 ? '255,0,0' : '0,0,255'},0.1)`;\n761\t        c.fillRect(0, y, w, 2);\n762\t      }\n763\t    }\n764\t\n765\t    // Whisper overlay\n766\t    if (vs.whisperActive) {\n767\t      c.fillStyle = `rgba(150, 130, 200, ${0.1 + Math.sin(now * 0.005) * 0.05})`;\n768\t      c.fillRect(0, 0, w, h);\n769\t    }\n770\t\n771\t    // Ambient fear tint\n772\t    if (vs.ambientFear > 0.2) {\n773\t      const fearPulse = Math.sin(now * 0.002) * 0.03;\n774\t      c.fillStyle = `rgba(30, 0, 0, ${(vs.ambientFear - 0.2) * 0.1 + fearPulse})`;\n775\t      c.fillRect(0, 0, w, h);\n776\t    }\n777\t\n778\t    // Fear HUD\n779\t    if (isNightTime(state.phase) && vs.ambientFear > 0.3) {\n780\t      c.fillStyle = `rgba(255, 50, 50, ${0.4 + Math.sin(now * 0.003) * 0.2})`;\n781\t      c.font = 'bold 11px monospace';\n782\t      c.textAlign = 'left';\n783\t      c.textBaseline = 'top';\n784\t      c.fillText(`⚠ 恐惧: ${Math.round(vs.ambientFear * 100)}%`, 12, 32);\n785\t    }\n786\t  }\n787\t\n788\t  destroy(): void {}\n789\t}\n790\t"}]},"parent_tool_use_id":null,"session_id":"328f9d51-5f9c-4f63-927e-7b99009d6517","uuid":"5a0d491b-c1a6-40c3-8a0e-070a968e7dea","timestamp":"2026-05-23T05:39:37.536Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/steam-horror-sim/src/renderer/Renderer.ts","content":"// Renderer.ts — Canvas 2D rendering system (v0.2.0 — M2)\n\nimport { Camera } from './Camera';\nimport { StoreMap, T } from '../game/StoreMap';\nimport { Player } from '../game/Player';\nimport { Lighting } from './Lighting';\nimport {\n  type GameState,\n  type GamePhase,\n  type LightSource,\n  type Interactable,\n  GamePhase as GP,\n  UIPanel,\n  getTimeString,\n  isNightTime,\n} from '../game/GameState';\nimport { Customer } from '../game/Customer';\nimport { ProductManager } from '../game/ProductManager';\nimport { ShelfInteraction, ShelfAction } from '../game/ShelfInteraction';\nimport { CashRegister, RegisterState } from '../game/CashRegister';\nimport { EconomySystem } from '../game/EconomySystem';\nimport { PricingSystem } from '../game/PricingSystem';\nimport { DaySummaryManager } from '../game/DaySummary';\nimport { UpgradeManager } from '../game/UpgradeManager';\nimport { type HorrorVisualState } from '../game/HorrorEventManager';\nimport { type JumpScareVisualState } from '../game/JumpScareManager';\nimport { type HorrorNPC } from '../game/BehaviorTree';\n\nexport interface RenderContext {\n  customers: Customer[];\n  productManager: ProductManager;\n  shelfInteraction: ShelfInteraction;\n  registers: CashRegister[];\n  economy: EconomySystem;\n  pricing: PricingSystem;\n  lastTransaction: string;\n  daySummary?: DaySummaryManager;\n  upgradeManager?: UpgradeManager;\n  horrorVisuals?: HorrorVisualState;\n  scareVisuals?: JumpScareVisualState;\n  activeNPCs?: ReadonlyArray<HorrorNPC>;\n}\n\nexport class Renderer {\n  canvas: HTMLCanvasElement;\n  ctx: CanvasRenderingContext2D;\n  camera: Camera;\n  lighting: Lighting;\n\n  constructor(canvas: HTMLCanvasElement) {\n    this.canvas = canvas;\n    this.ctx = canvas.getContext('2d')!;\n    this.camera = new Camera(canvas);\n    this.lighting = new Lighting();\n    this.resize();\n    this.camera.setupZoom(canvas);\n  }\n\n  resize(): void {\n    const dpr = window.devicePixelRatio || 1;\n    const rect = this.canvas.getBoundingClientRect();\n    this.canvas.width = rect.width * dpr;\n    this.canvas.height = rect.height * dpr;\n    this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n  }\n\n  render(\n    map: StoreMap,\n    player: Player,\n    state: GameState,\n    now: number,\n    ctx?: RenderContext,\n  ): void {\n    const c = this.ctx;\n    const w = this.canvas.getBoundingClientRect().width;\n    const h = this.canvas.getBoundingClientRect().height;\n\n    const bgPhase = state.phase;\n    if (bgPhase === 'danger') {\n      c.fillStyle = '#0a0a15';\n    } else if (isNightTime(bgPhase)) {\n      c.fillStyle = '#0f1020';\n    } else {\n      c.fillStyle = '#1a1520';\n    }\n    c.fillRect(0, 0, w, h);\n\n    const { offsetX, offsetY, scale } = this.camera.getTransform();\n\n    // Render map tiles\n    map.render(c, offsetX, offsetY, w, h, scale);\n\n    // Render shelf product indicators\n    if (ctx) {\n      this.renderShelfIndicators(c, ctx.productManager, state.interactables, offsetX, offsetY, scale);\n    }\n\n    // Render interactable highlights\n    this.renderInteractables(c, state.interactables, offsetX, offsetY, scale, player, now);\n\n    // Render customers\n    if (ctx) {\n      for (const customer of ctx.customers) {\n        customer.render(c, offsetX, offsetY, scale);\n      }\n    }\n\n    // Render player\n    player.render(c, offsetX, offsetY, scale);\n\n    // Render lighting overlay (M3: pass timeOfDay for gradual transitions)\n    this.lighting.render(c, w, h, state.lights, state.phase, offsetX, offsetY, scale, now, state.timeOfDay);\n\n    // Render HUD\n    this.renderHUD(c, w, h, state, player, ctx);\n\n    // Render active panel\n    if (ctx && state.activePanel !== UIPanel.NONE) {\n      this.renderPanel(c, w, h, state, ctx);\n    }\n\n    // M3: Render day summary overlay\n    if (ctx?.daySummary) {\n      ctx.daySummary.render(c, w, h);\n    }\n\n    // M4: Render horror visual effects\n    if (ctx?.horrorVisuals) {\n      this.renderHorrorEffects(c, w, h, ctx.horrorVisuals, now, state);\n    }\n  }\n\n  private renderShelfIndicators(\n    c: CanvasRenderingContext2D,\n    pm: ProductManager,\n    interactables: Interactable[],\n    ox: number,\n    oy: number,\n    scale: number,\n  ): void {\n    for (const inter of interactables) {\n      if (inter.type !== 'shelf' && inter.type !== 'fridge') continue;\n      const slot = pm.shelfSlots.get(inter.id);\n      if (!slot || !slot.productId || slot.quantity <= 0) continue;\n\n      const product = pm.getProduct(slot.productId);\n      if (!product) continue;\n\n      const px = ox + inter.x * scale;\n      const py = oy + (inter.y - 8) * scale;\n      const pw = inter.width * scale;\n\n      // Stock level bar\n      const ratio = slot.quantity / slot.maxQuantity;\n      const barColor = ratio > 0.5 ? '#66aa66' : ratio > 0.2 ? '#aaaa44' : '#aa4444';\n      c.fillStyle = 'rgba(0,0,0,0.5)';\n      c.fillRect(px, py, pw, 6 * scale);\n      c.fillStyle = barColor;\n      c.fillRect(px, py, pw * ratio, 6 * scale);\n\n      // Product name\n      c.fillStyle = 'rgba(255,255,255,0.7)';\n      c.font = `${Math.round(8 * scale)}px monospace`;\n      c.textAlign = 'center';\n      c.textBaseline = 'top';\n      c.fillText(`${product.name}(${slot.quantity})`, px + pw / 2, py + 7 * scale);\n    }\n  }\n\n  private renderInteractables(\n    c: CanvasRenderingContext2D,\n    interactables: Interactable[],\n    ox: number,\n    oy: number,\n    scale: number,\n    player: Player,\n    now: number,\n  ): void {\n    const facing = player.getFacingTile();\n\n    for (const obj of interactables) {\n      const px = ox + obj.x * scale;\n      const py = oy + obj.y * scale;\n      const pw = obj.width * scale;\n      const ph = obj.height * scale;\n\n      const objGX = Math.floor(obj.x / 32);\n      const objGY = Math.floor(obj.y / 32);\n      const isFacing = facing.gx >= objGX && facing.gx <= objGX + Math.ceil(obj.width / 32) - 1 &&\n        facing.gy >= objGY && facing.gy <= objGY + Math.ceil(obj.height / 32) - 1;\n\n      if (isFacing) {\n        const pulse = 0.3 + Math.sin(now * 0.005) * 0.1;\n        c.strokeStyle = `rgba(255, 255, 100, ${pulse})`;\n        c.lineWidth = 2;\n        c.strokeRect(px - 2, py - 2, pw + 4, ph + 4);\n\n        c.fillStyle = 'rgba(0,0,0,0.7)';\n        const labelW = c.measureText(obj.label).width + 12;\n        c.fillRect(px + pw / 2 - labelW / 2, py - 22, labelW, 18);\n        c.fillStyle = '#ffdd66';\n        c.font = `${Math.round(11)}px monospace`;\n        c.textAlign = 'center';\n        c.textBaseline = 'middle';\n        c.fillText(obj.label, px + pw / 2, py - 13);\n      }\n    }\n  }\n\n  private renderHUD(\n    c: CanvasRenderingContext2D,\n    canvasW: number,\n    canvasH: number,\n    state: GameState,\n    player: Player,\n    ctx?: RenderContext,\n  ): void {\n    // Top bar\n    c.fillStyle = 'rgba(0,0,0,0.8)';\n    c.fillRect(0, 0, canvasW, 44);\n\n    // Day counter\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 13px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'middle';\n    c.fillText(`Day ${state.day}`, 12, 14);\n\n    // Time\n    c.fillStyle = isNightTime(state.phase) ? '#8888cc' : '#ccaa66';\n    c.font = '13px monospace';\n    c.fillText(getTimeString(state.timeOfDay), 80, 14);\n\n    // Phase indicator\n    const phaseLabels: Record<string, string> = {\n      daytime: '营业中',\n      night_transition: '准备打烊',\n      night: '深夜营业',\n      danger: '危险时段',\n      dawn: '黎明',\n    };\n    c.fillStyle = state.phase === 'danger' ? '#ff4444' : '#aaa';\n    c.font = '11px monospace';\n    c.fillText(phaseLabels[state.phase] ?? state.phase, 160, 14);\n\n    // Money\n    c.fillStyle = '#66cc66';\n    c.font = '12px monospace';\n    c.textAlign = 'right';\n    c.fillText(`¥${state.money.toLocaleString()}`, canvasW - 12, 12);\n\n    // Debt\n    c.fillStyle = '#cc6666';\n    c.font = '10px monospace';\n    c.fillText(`债务: ¥${state.debt.toLocaleString()}`, canvasW - 12, 26);\n\n    // Health bar\n    c.textAlign = 'left';\n    const hbX = 300;\n    const hbY = 6;\n    const hbW = 80;\n    const hbH = 8;\n    c.fillStyle = 'rgba(255,255,255,0.1)';\n    c.fillRect(hbX, hbY, hbW, hbH);\n    c.fillStyle = '#cc3333';\n    c.fillRect(hbX, hbY, hbW * (state.player.health / 100), hbH);\n    c.strokeStyle = 'rgba(255,255,255,0.2)';\n    c.lineWidth = 1;\n    c.strokeRect(hbX, hbY, hbW, hbH);\n    c.fillStyle = '#aaa';\n    c.font = '8px monospace';\n    c.fillText('HP', hbX - 18, hbY + 7);\n\n    // Sanity bar\n    const sbY = 18;\n    c.fillStyle = 'rgba(255,255,255,0.1)';\n    c.fillRect(hbX, sbY, hbW, hbH);\n    c.fillStyle = '#6666cc';\n    c.fillRect(hbX, sbY, hbW * (state.player.sanity / 100), hbH);\n    c.strokeStyle = 'rgba(255,255,255,0.2)';\n    c.strokeRect(hbX, sbY, hbW, hbH);\n    c.fillStyle = '#aaa';\n    c.fillText('SAN', hbX - 22, sbY + 7);\n\n    // Customer count\n    if (ctx) {\n      const custCount = ctx.customers.length;\n      c.fillStyle = '#88aacc';\n      c.font = '10px monospace';\n      c.textAlign = 'left';\n      c.fillText(`顾客: ${custCount}`, 420, 14);\n    }\n\n    // Daily revenue\n    c.fillStyle = '#88cc88';\n    c.font = '10px monospace';\n    c.textAlign = 'left';\n    c.fillText(`今日: ¥${state.dailyRevenue.toFixed(0)}`, 500, 14);\n\n    // Shortcut hints\n    c.fillStyle = 'rgba(255,255,255,0.4)';\n    c.font = '10px monospace';\n    c.textAlign = 'center';\n    c.fillText('WASD 移动 | E 交互 | I 库存 | P 定价 | U 升级 | O 进货 | ESC 关闭', canvasW / 2, canvasH - 12);\n\n    // Notifications\n    this.renderNotifications(c, canvasW, canvasH, state);\n\n    // Register status\n    if (ctx) {\n      this.renderRegisterStatus(c, canvasW, ctx.registers);\n    }\n  }\n\n  private renderNotifications(\n    c: CanvasRenderingContext2D,\n    w: number,\n    h: number,\n    state: GameState,\n  ): void {\n    const recent = state.notifications.slice(-5);\n    if (recent.length === 0) return;\n\n    c.textAlign = 'right';\n    c.font = '10px monospace';\n    for (let i = 0; i < recent.length; i++) {\n      const alpha = 0.3 + (i / recent.length) * 0.5;\n      c.fillStyle = `rgba(200, 220, 255, ${alpha})`;\n      c.fillText(recent[i], w - 12, h - 30 - (recent.length - 1 - i) * 14);\n    }\n  }\n\n  private renderRegisterStatus(\n    c: CanvasRenderingContext2D,\n    canvasW: number,\n    registers: CashRegister[],\n  ): void {\n    let x = 12;\n    const y = 48;\n    for (const reg of registers) {\n      const stateLabels: Record<string, string> = {\n        idle: '空闲',\n        scanning: '扫描中...',\n        payment: '付款中',\n        giving_change: '找零中',\n        receipt: '打印收据',\n        anomaly: '异常!',\n      };\n      const stateColors: Record<string, string> = {\n        idle: '#666',\n        scanning: '#6a6',\n        payment: '#aa6',\n        giving_change: '#6aa',\n        receipt: '#66a',\n        anomaly: '#a44',\n      };\n      const label = stateLabels[reg.state] ?? reg.state;\n      const color = stateColors[reg.state] ?? '#666';\n\n      c.fillStyle = 'rgba(0,0,0,0.6)';\n      c.fillRect(x, y, 80, 16);\n      c.fillStyle = color;\n      c.font = '9px monospace';\n      c.textAlign = 'left';\n      c.textBaseline = 'middle';\n      c.fillText(`${reg.registerId}: ${label}`, x + 4, y + 8);\n      x += 84;\n    }\n  }\n\n  private renderPanel(\n    c: CanvasRenderingContext2D,\n    w: number,\n    h: number,\n    state: GameState,\n    ctx: RenderContext,\n  ): void {\n    // Darken background\n    c.fillStyle = 'rgba(0,0,0,0.5)';\n    c.fillRect(0, 0, w, h);\n\n    const panelW = Math.min(500, w - 40);\n    const panelH = Math.min(400, h - 80);\n    const px = (w - panelW) / 2;\n    const py = (h - panelH) / 2;\n\n    // Panel background\n    c.fillStyle = 'rgba(20, 20, 35, 0.95)';\n    c.fillRect(px, py, panelW, panelH);\n    c.strokeStyle = 'rgba(100, 120, 160, 0.5)';\n    c.lineWidth = 1;\n    c.strokeRect(px, py, panelW, panelH);\n\n    // Title bar\n    c.fillStyle = 'rgba(40, 40, 60, 0.9)';\n    c.fillRect(px, py, panelW, 30);\n\n    switch (state.activePanel) {\n      case UIPanel.SHELF:\n        this.renderShelfPanel(c, px, py, panelW, panelH, ctx);\n        break;\n      case UIPanel.INVENTORY:\n        this.renderInventoryPanel(c, px, py, panelW, panelH, ctx);\n        break;\n      case UIPanel.PRICING:\n        this.renderPricingPanel(c, px, py, panelW, panelH, ctx);\n        break;\n      case UIPanel.SHOP:\n        this.renderShopPanel(c, px, py, panelW, panelH, ctx);\n        break;\n      case UIPanel.SUPPLIER:\n        this.renderSupplierPanel(c, px, py, panelW, panelH, state, ctx);\n        break;\n    }\n\n    // Close button hint\n    c.fillStyle = 'rgba(255,255,255,0.4)';\n    c.font = '10px monospace';\n    c.textAlign = 'center';\n    c.fillText('按 ESC 或 E 关闭', w / 2, py + panelH + 15);\n  }\n\n  private renderShelfPanel(\n    c: CanvasRenderingContext2D,\n    px: number, py: number,\n    pw: number, ph: number,\n    ctx: RenderContext,\n  ): void {\n    const shelf = ctx.shelfInteraction;\n    if (!shelf.currentShelfId) return;\n\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 14px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'top';\n    c.fillText('货架管理', px + 10, py + 8);\n\n    const slot = ctx.productManager.shelfSlots.get(shelf.currentShelfId);\n    if (!slot) return;\n\n    let y = py + 40;\n\n    if (slot.productId && slot.quantity > 0) {\n      const product = ctx.productManager.getProduct(slot.productId);\n      c.fillStyle = '#aac';\n      c.font = '12px monospace';\n      c.fillText(`商品: ${product?.name ?? slot.productId}`, px + 10, y);\n      y += 18;\n      c.fillText(`库存: ${slot.quantity}/${slot.maxQuantity}`, px + 10, y);\n      y += 18;\n      const price = ctx.pricing.getPrice(slot.productId);\n      c.fillText(`售价: ¥${price.toFixed(2)}`, px + 10, y);\n      y += 30;\n    } else {\n      c.fillStyle = '#888';\n      c.font = '12px monospace';\n      c.fillText('空货架', px + 10, y);\n      y += 30;\n    }\n\n    // Available products to stock\n    c.fillStyle = '#ccc';\n    c.font = '11px monospace';\n    c.fillText('可上架商品:', px + 10, y);\n    y += 18;\n\n    const available = shelf.getAvailableProductsForShelf(shelf.currentShelfId, ctx.productManager);\n    for (let i = 0; i < Math.min(available.length, 8); i++) {\n      const item = available[i];\n      c.fillStyle = '#aab8cc';\n      c.font = '11px monospace';\n      c.fillText(`  ${item.name} x${item.quantity}`, px + 10, y);\n      y += 16;\n    }\n\n    if (available.length === 0) {\n      c.fillStyle = '#666';\n      c.fillText('  (无库存)', px + 10, y);\n    }\n  }\n\n  private renderInventoryPanel(\n    c: CanvasRenderingContext2D,\n    px: number, py: number,\n    pw: number, ph: number,\n    ctx: RenderContext,\n  ): void {\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 14px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'top';\n    c.fillText('库存管理', px + 10, py + 8);\n\n    let y = py + 40;\n    c.fillStyle = '#aaa';\n    c.font = '10px monospace';\n    c.fillText(`仓库容量: ${ctx.productManager.storageUsed}/${ctx.productManager.storageCapacity}`, px + 10, y);\n    y += 20;\n\n    for (const [id, item] of ctx.productManager.inventory) {\n      if (item.quantity <= 0) continue;\n      const product = ctx.productManager.getProduct(id);\n      const price = ctx.pricing.getPrice(id);\n      c.fillStyle = '#bbb';\n      c.font = '11px monospace';\n      c.fillText(`${product?.name ?? id}  x${item.quantity}  ¥${price.toFixed(2)}/个`, px + 10, y);\n      y += 16;\n      if (y > py + ph - 30) break;\n    }\n  }\n\n  private renderPricingPanel(\n    c: CanvasRenderingContext2D,\n    px: number, py: number,\n    pw: number, ph: number,\n    ctx: RenderContext,\n  ): void {\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 14px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'top';\n    c.fillText('定价管理', px + 10, py + 8);\n\n    let y = py + 40;\n    const prices = ctx.pricing.getAllPrices();\n\n    c.fillStyle = '#888';\n    c.font = '10px monospace';\n    c.fillText('商品           基价      现价      范围', px + 10, y);\n    y += 16;\n\n    for (const entry of prices) {\n      const product = ctx.productManager.getProduct(entry.productId);\n      if (!product) continue;\n      c.fillStyle = '#bbb';\n      c.font = '10px monospace';\n      const name = product.name.padEnd(8, '　');\n      c.fillText(\n        `${name}  ¥${entry.basePrice.toFixed(0).padStart(3)}   ¥${entry.currentPrice.toFixed(0).padStart(3)}   ${entry.minPrice.toFixed(0)}-${entry.maxPrice.toFixed(0)}`,\n        px + 10, y,\n      );\n      y += 14;\n      if (y > py + ph - 30) break;\n    }\n  }\n\n  private renderShopPanel(\n    c: CanvasRenderingContext2D,\n    px: number, py: number,\n    pw: number, ph: number,\n    ctx: RenderContext,\n  ): void {\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 14px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'top';\n    c.fillText('店铺升级', px + 10, py + 8);\n\n    let y = py + 40;\n    const upgrades = ctx.upgradeManager\n      ? ctx.upgradeManager.getUpgrades()\n      : ctx.economy.getUpgrades();\n\n    for (const upgrade of upgrades) {\n      const owned = ctx.upgradeManager\n        ? ctx.upgradeManager.isPurchased(upgrade.id)\n        : ctx.economy.hasUpgrade(upgrade.id);\n      c.fillStyle = owned ? '#5a7a5a' : '#bbb';\n      c.font = '11px monospace';\n      c.fillText(\n        `${owned ? '[已购]' : `¥${upgrade.cost}`.padStart(6)} ${upgrade.name} — ${upgrade.description}`,\n        px + 10, y,\n      );\n      y += 16;\n      c.fillStyle = '#777';\n      c.font = '9px monospace';\n      c.fillText(`  ${upgrade.horrorLink}`, px + 10, y);\n      y += 14;\n      if (y > py + ph - 30) break;\n    }\n  }\n\n  private renderSupplierPanel(\n    c: CanvasRenderingContext2D,\n    px: number, py: number,\n    pw: number, ph: number,\n    state: GameState,\n    ctx: RenderContext,\n  ): void {\n    c.fillStyle = '#e0d0b0';\n    c.font = 'bold 14px monospace';\n    c.textAlign = 'left';\n    c.textBaseline = 'top';\n    c.fillText('进货管理', px + 10, py + 8);\n\n    let y = py + 40;\n\n    // Show suppliers\n    const isNight = isNightTime(state.phase);\n    const suppliers = ctx.productManager.getUnlockedSuppliers(state.day, isNight);\n    c.fillStyle = '#888';\n    c.font = '10px monospace';\n    c.fillText('可用供应商:', px + 10, y);\n    y += 16;\n\n    for (const supplier of suppliers) {\n      c.fillStyle = '#aab8cc';\n      c.font = '11px monospace';\n      c.fillText(`${supplier.name} — ${supplier.description}`, px + 10, y);\n      y += 14;\n      c.fillStyle = '#777';\n      c.font = '9px monospace';\n      c.fillText(`  价格x${supplier.priceMultiplier} 可靠度${Math.round(supplier.reliability * 100)}%`, px + 10, y);\n      y += 16;\n    }\n\n    y += 10;\n\n    // Pending orders\n    if (ctx.productManager.pendingOrders.length > 0) {\n      c.fillStyle = '#888';\n      c.font = '10px monospace';\n      c.fillText('待到货订单:', px + 10, y);\n      y += 16;\n\n      for (const order of ctx.productManager.pendingOrders) {\n        const product = ctx.productManager.getProduct(order.productId);\n        c.fillStyle = '#cc9';\n        c.font = '10px monospace';\n        c.fillText(`${product?.name ?? order.productId} x${order.quantity} — ¥${order.totalCost} (Day ${order.arrivalDay}到)`, px + 10, y);\n        y += 14;\n        if (y > py + ph - 30) break;\n      }\n    }\n  }\n\n  // M4: Horror visual effects rendering\n  private renderHorrorEffects(\n    c: CanvasRenderingContext2D,\n    w: number,\n    h: number,\n    vs: HorrorVisualState,\n    now: number,\n    state: GameState,\n  ): void {\n    // Vignette (always present at night, stronger during horror)\n    if (vs.vignetteIntensity > 0) {\n      const vigGrad = c.createRadialGradient(w / 2, h / 2, w * 0.3, w / 2, h / 2, w * 0.7);\n      vigGrad.addColorStop(0, 'rgba(0,0,0,0)');\n      vigGrad.addColorStop(1, `rgba(0,0,0,${vs.vignetteIntensity})`);\n      c.fillStyle = vigGrad;\n      c.fillRect(0, 0, w, h);\n    }\n\n    // Frost effect (temp drop)\n    if (vs.frostIntensity > 0) {\n      const fi = vs.frostIntensity;\n      const frostGrad = c.createRadialGradient(w / 2, h / 2, w * 0.35, w / 2, h / 2, w * 0.6);\n      frostGrad.addColorStop(0, 'rgba(0,0,0,0)');\n      frostGrad.addColorStop(0.7, `rgba(180,210,240,${fi * 0.15})`);\n      frostGrad.addColorStop(1, `rgba(200,220,255,${fi * 0.4})`);\n      c.fillStyle = frostGrad;\n      c.fillRect(0, 0, w, h);\n\n      c.fillStyle = `rgba(220,240,255,${fi * 0.6})`;\n      const seed = Math.floor(now * 0.001);\n      for (let i = 0; i < 30; i++) {\n        const px = ((seed * 7 + i * 131) % w);\n        const py = ((seed * 13 + i * 97) % h);\n        const size = 1 + ((seed + i * 17) % 3);\n        c.fillRect(px, py, size, size);\n      }\n    }\n\n    // Extra darkness\n    if (vs.darknessBoost > 0) {\n      c.fillStyle = `rgba(0,0,5,${vs.darknessBoost})`;\n      c.fillRect(0, 0, w, h);\n    }\n\n    // Screen shake\n    if (vs.screenShake > 0) {\n      const shakeX = (Math.random() - 0.5) * vs.screenShake * 6;\n      const shakeY = (Math.random() - 0.5) * vs.screenShake * 6;\n      c.drawImage(c.canvas, shakeX, shakeY);\n    }\n\n    // Chromatic aberration\n    if (vs.chromaticAberration > 0) {\n      const ca = vs.chromaticAberration;\n      c.globalCompositeOperation = 'lighter';\n      c.globalAlpha = ca * 0.08;\n      c.fillStyle = '#ff0000';\n      c.fillRect(ca * -3, 0, w, h);\n      c.fillStyle = '#0000ff';\n      c.fillRect(ca * 3, 0, w, h);\n      c.globalAlpha = 1;\n      c.globalCompositeOperation = 'source-over';\n    }\n\n    // Blood on shelves\n    for (const blood of vs.bloodPositions) {\n      c.fillStyle = `rgba(120, 10, 10, ${blood.alpha})`;\n      c.beginPath();\n      c.ellipse(blood.x, blood.y, blood.size, blood.size * 0.7, 0, 0, Math.PI * 2);\n      c.fill();\n      c.fillStyle = `rgba(100, 5, 5, ${blood.alpha * 0.7})`;\n      c.fillRect(blood.x - 2, blood.y, 4, blood.size * 1.5);\n    }\n\n    // Ghost entities\n    if (vs.ghostEntity && vs.ghostEntity.active && vs.ghostEntity.opacity > 0.01) {\n      const ge = vs.ghostEntity;\n      c.globalAlpha = ge.opacity;\n\n      switch (ge.type) {\n        case 'ghost_customer':\n          c.fillStyle = '#8899aa';\n          c.fillRect(ge.x, ge.y + 16, 16, 24);\n          c.fillStyle = '#aabbcc';\n          c.beginPath();\n          c.arc(ge.x + 8, ge.y + 8, 8, 0, Math.PI * 2);\n          c.fill();\n          break;\n        case 'duplicate':\n          c.fillStyle = '#444455';\n          c.fillRect(ge.x, ge.y + 8, 16, 28);\n          c.fillStyle = '#888899';\n          c.fillRect(ge.x + 2, ge.y, 12, 10);\n          c.fillStyle = '#ff0000';\n          c.fillRect(ge.x + 4, ge.y + 3, 3, 2);\n          c.fillRect(ge.x + 10, ge.y + 3, 3, 2);\n          break;\n        case 'nonpaying':\n          c.fillStyle = '#1a1a22';\n          c.fillRect(ge.x, ge.y + 8, 16, 28);\n          c.fillStyle = '#777788';\n          c.fillRect(ge.x + 2, ge.y, 12, 10);\n          c.fillStyle = '#ccddff';\n          c.fillRect(ge.x + 4, ge.y + 3, 2, 3);\n          c.fillRect(ge.x + 10, ge.y + 3, 2, 3);\n          break;\n      }\n      c.globalAlpha = 1;\n    }\n\n    // Door open darkness\n    if (vs.doorState.frontOpen || vs.doorState.backOpen) {\n      c.fillStyle = 'rgba(0,0,0,0.9)';\n      c.fillRect(0, 0, w, h * 0.15);\n      c.fillRect(0, h * 0.85, w, h * 0.15);\n    }\n\n    // Time glitch\n    if (vs.timeGlitchActive) {\n      c.fillStyle = 'rgba(255,0,0,0.05)';\n      c.fillRect(0, 0, w, h);\n      for (let i = 0; i < 8; i++) {\n        const y = (now * 0.1 + i * 67) % h;\n        c.fillStyle = `rgba(${Math.random() > 0.5 ? '255,0,0' : '0,0,255'},0.1)`;\n        c.fillRect(0, y, w, 2);\n      }\n    }\n\n    // Whisper overlay\n    if (vs.whisperActive) {\n      c.fillStyle = `rgba(150, 130, 200, ${0.1 + Math.sin(now * 0.005) * 0.05})`;\n      c.fillRect(0, 0, w, h);\n    }\n\n    // Ambient fear tint\n    if (vs.ambientFear > 0.2) {\n      const fearPulse = Math.sin(now * 0.002) * 0.03;\n      c.fillStyle = `rgba(30, 0, 0, ${(vs.ambientFear - 0.2) * 0.1 + fearPulse})`;\n      c.fillRect(0, 0, w, h);\n    }\n\n    // Fear HUD\n    if (isNightTime(state.phase) && vs.ambientFear > 0.3) {\n      c.fillStyle = `rgba(255, 50, 50, ${0.4 + Math.sin(now * 0.003) * 0.2})`;\n      c.font = 'bold 11px monospace';\n      c.textAlign = 'left';\n      c.textBaseline = 'top';\n      c.fillText(`⚠ 恐惧: ${Math.round(vs.ambientFear * 100)}%`, 12, 32);\n    }\n  }\n\n  destroy(): void {}\n}\n","numLines":790,"startLine":1,"totalLines":790}}}
