{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_4437bda747c34a32b1aa5614","type":"tool_result","content":"1\t// Game.js — Main game controller (W2 extended)\n2\t\n3\tclass Game {\n4\t  constructor() {\n5\t    this.engine = new IdiomEngine(IDIOM_DB);\n6\t    this.judge = new Judge();\n7\t    this.combo = new ComboSystem();\n8\t    this.data = new DataManager();\n9\t    this.audio = new AudioManager();\n10\t    this.tutorial = new Tutorial();\n11\t\n12\t    // W2 systems\n13\t    this.timed = new TimedChallenge(this.engine, this.combo, this.audio, this.data);\n14\t    this.collection = new IdiomCollection(IDIOM_DB, this.data);\n15\t    this.daily = new DailySystem(this.data, this.engine, this.audio);\n16\t    this.pk = new PKMode(this.engine, this.audio, this.data);\n17\t    this.social = new SocialManager(this.data);\n18\t    this.characters = new Characters(this.data);\n19\t\n20\t    this.currentLevel = null;\n21\t    this.questions = [];\n22\t    this.questionIndex = 0;\n23\t    this.lives = 5;\n24\t    this.state = 'menu';\n25\t    this.usedHintThisQuestion = false;\n26\t    this.continuedOnce = false;\n27\t    this.levelResult = null;\n28\t    this.hintRevealCost = 5;\n29\t    this.hintRemoveCost = 5;\n30\t    this.skipCost = 10;\n31\t  }\n32\t\n33\t  startLevel(levelId) {\n34\t    const level = LEVELS.find(l => l.id === levelId);\n35\t    if (!level) { this.goToMenu(); return; }\n36\t    if (levelId > this.data.unlockedLevel && levelId > 1) {\n37\t      alert('关卡尚未解锁'); return;\n38\t    }\n39\t\n40\t    this.currentLevel = level;\n41\t    this.lives = level.lives;\n42\t    this.engine.reset();\n43\t    this.questions = this.engine.generateForLevel(level);\n44\t    this.questionIndex = 0;\n45\t    this.combo.reset();\n46\t    this.continuedOnce = false;\n47\t    this.state = 'playing';\n48\t    this.characters.resetLevelState();\n49\t\n50\t    if (level.tutorial) this.tutorial.start(level.tutorial);\n51\t    else this.tutorial.end();\n52\t\n53\t    this._startQuestion();\n54\t    this.render();\n55\t  }\n56\t\n57\t  _startQuestion() {\n58\t    if (this.questionIndex >= this.questions.length) { this.finishLevel(); return; }\n59\t    const q = this.questions[this.questionIndex];\n60\t    this.judge.startQuestion(q);\n61\t    this.usedHintThisQuestion = false;\n62\t  }\n63\t\n64\t  pickChar(candidateIndex) {\n65\t    if (this.state !== 'playing') return null;\n66\t    const q = this.questions[this.questionIndex];\n67\t    if (!q || q.answered) return null;\n68\t    const result = this.judge.placeChar(candidateIndex);\n69\t    if (result.action === 'placed') {\n70\t      this.audio.playPlace();\n71\t      if (result.fillCount === 4) {\n72\t        setTimeout(() => this._handleFull(result), 400);\n73\t      }\n74\t    } else if (result.action === 'full') {\n75\t      setTimeout(() => this._handleFull(result), 200);\n76\t    } else if (result.action === 'used') {\n77\t      return null;\n78\t    }\n79\t    this.render();\n80\t    return result;\n81\t  }\n82\t\n83\t  _handleFull(result) {\n84\t    const q = this.questions[this.questionIndex];\n85\t    if (!q || q.answered) return;\n86\t    q.answered = true;\n87\t    q.correct = result.isCorrect;\n88\t\n89\t    if (result.isCorrect) {\n90\t      this.audio.playCorrect();\n91\t      const cr = this.combo.onCorrect(this.usedHintThisQuestion);\n92\t\n93\t      // Character skill: combo boost\n94\t      const skillResult = this.characters.applySkill({ event: 'combo_bonus' });\n95\t      if (skillResult.triggered && skillResult.multiplier) {\n96\t        const bonus = Math.floor(cr.comboBonus * (skillResult.multiplier - 1));\n97\t        cr.comboBonus += bonus;\n98\t        this.combo.score += bonus;\n99\t        cr.totalGain += bonus;\n100\t      }\n101\t\n102\t      // Character skill: bonus exp\n103\t      const expResult = this.characters.applySkill({ event: 'correct' });\n104\t      if (expResult.triggered && expResult.bonus) {\n105\t        this.data.addExp(expResult.bonus);\n106\t      }\n107\t\n108\t      if (cr.combo >= 3) this.audio.playCombo(cr.combo);\n109\t      this.data.collectIdiom(q.idiom.id);\n110\t      this.daily.updateTaskProgress('answer', 1);\n111\t      this.daily.updateTaskProgress('combo', cr.combo >= 3 ? 1 : 0);\n112\t      q.comboResult = cr;\n113\t      this.render();\n114\t      setTimeout(() => { this.questionIndex++; this._startQuestion(); this.render(); }, 800);\n115\t    } else {\n116\t      // Character skill: lucky save\n117\t      const skillResult = this.characters.applySkill({ event: 'wrong' });\n118\t      if (skillResult.triggered) {\n119\t        this.audio.playHint();\n120\t        this.render();\n121\t        setTimeout(() => {\n122\t          q.answered = false; q.correct = null;\n123\t          this.judge.startQuestion(q);\n124\t          this.render();\n125\t        }, 800);\n126\t        return;\n127\t      }\n128\t\n129\t      this.audio.playWrong();\n130\t      this.combo.onWrong();\n131\t      this.lives--;\n132\t      this.render();\n133\t      if (this.lives <= 0) {\n134\t        if (!this.continuedOnce) {\n135\t          document.getElementById('continue-modal').style.display = 'flex';\n136\t        } else {\n137\t          setTimeout(() => this.finishLevel(), 600);\n138\t        }\n139\t      } else {\n140\t        setTimeout(() => {\n141\t          q.answered = false; q.correct = null;\n142\t          this.judge.startQuestion(q);\n143\t          this.render();\n144\t        }, 600);\n145\t      }\n146\t    }\n147\t  }\n148\t\n149\t  removeSlot(slotIndex) {\n150\t    if (this.state !== 'playing') return null;\n151\t    const q = this.questions[this.questionIndex];\n152\t    if (!q || q.answered) return null;\n153\t    const result = this.judge.removeSlot(slotIndex);\n154\t    if (result.action === 'removed') this.audio.playPlace();\n155\t    this.render();\n156\t    return result;\n157\t  }\n158\t\n159\t  useHintReveal() {\n160\t    if (this.state !== 'playing') return null;\n161\t    const q = this.questions[this.questionIndex];\n162\t    if (!q || q.answered) return null;\n163\t    const fc = this.judge.getFillCount();\n164\t    if (fc >= 4) return null;\n165\t\n166\t    // Character skill: free hint\n167\t    const skillResult = this.characters.applySkill({ event: 'hint' });\n168\t    if (!skillResult.triggered) {\n169\t      if (this.data.coins < this.hintRevealCost) {\n170\t        alert('金币不足');\n171\t        return null;\n172\t      }\n173\t      this.data.spendCoins(this.hintRevealCost);\n174\t    }\n175\t\n176\t    const ch = this.judge.currentIdiom.chars[fc];\n177\t    const cand = q.candidates.find(c => c.char === ch && !c.used);\n178\t    if (!cand) return null;\n179\t    this.usedHintThisQuestion = true;\n180\t    this.audio.playHint();\n181\t    const result = this.judge.placeChar(cand.index);\n182\t    if (result.fillCount === 4) setTimeout(() => this._handleFull(result), 400);\n183\t    this.render();\n184\t    return result;\n185\t  }\n186\t\n187\t  useHintRemove() {\n188\t    if (this.state !== 'playing') return null;\n189\t    const q = this.questions[this.questionIndex];\n190\t    if (!q || q.answered) return null;\n191\t\n192\t    if (this.data.coins < this.hintRemoveCost) {\n193\t      alert('金币不足');\n194\t      return null;\n195\t    }\n196\t    this.data.spendCoins(this.hintRemoveCost);\n197\t\n198\t    const wrong = q.candidates.filter(c => !c.used && !this.judge.currentIdiom.chars.includes(c.char) && !c.removed);\n199\t    const removed = [];\n200\t    const cnt = Math.min(2, wrong.length);\n201\t    for (let i = 0; i < cnt; i++) {\n202\t      const idx = Math.floor(Math.random() * wrong.length);\n203\t      wrong[idx].removed = true;\n204\t      removed.push(wrong[idx]);\n205\t      wrong.splice(idx, 1);\n206\t    }\n207\t    this.audio.playRemove();\n208\t    this.render();\n209\t    return { action: 'removed_distractors', removed };\n210\t  }\n211\t\n212\t  skipQuestion() {\n213\t    if (this.state !== 'playing') return;\n214\t    if (this.data.coins < this.skipCost) {\n215\t      alert('金币不足');\n216\t      return;\n217\t    }\n218\t    this.data.spendCoins(this.skipCost);\n219\t    const q = this.questions[this.questionIndex];\n220\t    if (q) { q.answered = true; q.correct = false; q.skipped = true; }\n221\t    this.combo.onSkip();\n222\t    this.questionIndex++;\n223\t    this._startQuestion();\n224\t    this.render();\n225\t  }\n226\t\n227\t  continueWithAd() {\n228\t    if (this.continuedOnce) return false;\n229\t    this.lives = 3;\n230\t    this.continuedOnce = true;\n231\t    const q = this.questions[this.questionIndex];\n232\t    if (q) { q.answered = false; q.correct = null; this.judge.startQuestion(q); }\n233\t    this.render();\n234\t    return true;\n235\t  }\n236\t\n237\t  finishLevel() {\n238\t    this.state = 'result';\n239\t    document.getElementById('continue-modal').style.display = 'none';\n240\t    const s = this.combo.getStats();\n241\t    const stars = this.combo.getStarRating(s.correctCount, this.questions.length);\n242\t\n243\t    if (stars > 0 && this.currentLevel) {\n244\t      this.data.setLevelStars(this.currentLevel.id, stars);\n245\t      this.data.addCoins(this.currentLevel.reward.coins);\n246\t      this.data.addScore(s.score);\n247\t      this.data.updateBestCombo(s.maxCombo);\n248\t      this.data.addExp(this.currentLevel.reward.exp || 10);\n249\t      this.daily.updateTaskProgress('level', 1);\n250\t      this.daily.updateTaskProgress('collect', s.correctCount);\n251\t    }\n252\t\n253\t    this.levelResult = {\n254\t      stars, correctCount: s.correctCount, totalQuestions: this.questions.length,\n255\t      score: s.score, maxCombo: s.maxCombo,\n256\t      coins: stars > 0 ? this.currentLevel.reward.coins : 0\n257\t    };\n258\t    if (stars > 0) this.audio.playLevelWin(); else this.audio.playLevelFail();\n259\t    this.render();\n260\t  }\n261\t\n262\t  // ===== W2: Timed Challenge =====\n263\t  startTimedChallenge() {\n264\t    this.state = 'timed';\n265\t    this.timed.onUpdate = (evt) => {\n266\t      if (evt === 'end') {\n267\t        this.state = 'timed_result';\n268\t      }\n269\t      this.render();\n270\t    };\n271\t    this.timed.start();\n272\t  }\n273\t\n274\t  // ===== W2: PK Mode =====\n275\t  startPK(opponentResult) {\n276\t    this.state = 'pk';\n277\t    this.pk.onUpdate = (evt) => {\n278\t      if (evt === 'end') {\n279\t        this.state = 'pk_result';\n280\t      }\n281\t      this.render();\n282\t    };\n283\t    this.pk.start(opponentResult);\n284\t  }\n285\t\n286\t  // ===== W2: Collection =====\n287\t  showCollection() {\n288\t    this.state = 'collection';\n289\t    this.render();\n290\t  }\n291\t\n292\t  // ===== W2: Daily =====\n293\t  showDaily() {\n294\t    this.state = 'daily';\n295\t    this.render();\n296\t  }\n297\t\n298\t  // ===== W2: Characters =====\n299\t  showCharacters() {\n300\t    this.state = 'characters';\n301\t    this.render();\n302\t  }\n303\t\n304\t  showLevelMap() {\n305\t    this.state = 'map';\n306\t    this.render();\n307\t  }\n308\t\n309\t  goToMenu() {\n310\t    this.state = 'menu';\n311\t    this.tutorial.end();\n312\t    this.render();\n313\t  }\n314\t\n315\t  getCurrentQuestion() { return this.questions[this.questionIndex]; }\n316\t\n317\t  render() { if (typeof renderUI === 'function') renderUI(this); }\n318\t}\n319\t\n320\tfunction handleHintReveal() { game.useHintReveal(); }\n321\tfunction handleHintRemove() { game.useHintRemove(); }\n322\tfunction handleSkip() { game.skipQuestion(); }\n323\t\n324\tif (typeof module !== 'undefined') module.exports = { Game };\n325\t"}]},"parent_tool_use_id":null,"session_id":"6be7998d-cc43-4adb-be9f-4939a8437d2d","uuid":"a930af39-aeb8-49ff-8ae9-594e77896f76","timestamp":"2026-05-23T00:41:51.583Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/douyin-idiom/src/js/Game.js","content":"// Game.js — Main game controller (W2 extended)\n\nclass Game {\n  constructor() {\n    this.engine = new IdiomEngine(IDIOM_DB);\n    this.judge = new Judge();\n    this.combo = new ComboSystem();\n    this.data = new DataManager();\n    this.audio = new AudioManager();\n    this.tutorial = new Tutorial();\n\n    // W2 systems\n    this.timed = new TimedChallenge(this.engine, this.combo, this.audio, this.data);\n    this.collection = new IdiomCollection(IDIOM_DB, this.data);\n    this.daily = new DailySystem(this.data, this.engine, this.audio);\n    this.pk = new PKMode(this.engine, this.audio, this.data);\n    this.social = new SocialManager(this.data);\n    this.characters = new Characters(this.data);\n\n    this.currentLevel = null;\n    this.questions = [];\n    this.questionIndex = 0;\n    this.lives = 5;\n    this.state = 'menu';\n    this.usedHintThisQuestion = false;\n    this.continuedOnce = false;\n    this.levelResult = null;\n    this.hintRevealCost = 5;\n    this.hintRemoveCost = 5;\n    this.skipCost = 10;\n  }\n\n  startLevel(levelId) {\n    const level = LEVELS.find(l => l.id === levelId);\n    if (!level) { this.goToMenu(); return; }\n    if (levelId > this.data.unlockedLevel && levelId > 1) {\n      alert('关卡尚未解锁'); return;\n    }\n\n    this.currentLevel = level;\n    this.lives = level.lives;\n    this.engine.reset();\n    this.questions = this.engine.generateForLevel(level);\n    this.questionIndex = 0;\n    this.combo.reset();\n    this.continuedOnce = false;\n    this.state = 'playing';\n    this.characters.resetLevelState();\n\n    if (level.tutorial) this.tutorial.start(level.tutorial);\n    else this.tutorial.end();\n\n    this._startQuestion();\n    this.render();\n  }\n\n  _startQuestion() {\n    if (this.questionIndex >= this.questions.length) { this.finishLevel(); return; }\n    const q = this.questions[this.questionIndex];\n    this.judge.startQuestion(q);\n    this.usedHintThisQuestion = false;\n  }\n\n  pickChar(candidateIndex) {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const result = this.judge.placeChar(candidateIndex);\n    if (result.action === 'placed') {\n      this.audio.playPlace();\n      if (result.fillCount === 4) {\n        setTimeout(() => this._handleFull(result), 400);\n      }\n    } else if (result.action === 'full') {\n      setTimeout(() => this._handleFull(result), 200);\n    } else if (result.action === 'used') {\n      return null;\n    }\n    this.render();\n    return result;\n  }\n\n  _handleFull(result) {\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return;\n    q.answered = true;\n    q.correct = result.isCorrect;\n\n    if (result.isCorrect) {\n      this.audio.playCorrect();\n      const cr = this.combo.onCorrect(this.usedHintThisQuestion);\n\n      // Character skill: combo boost\n      const skillResult = this.characters.applySkill({ event: 'combo_bonus' });\n      if (skillResult.triggered && skillResult.multiplier) {\n        const bonus = Math.floor(cr.comboBonus * (skillResult.multiplier - 1));\n        cr.comboBonus += bonus;\n        this.combo.score += bonus;\n        cr.totalGain += bonus;\n      }\n\n      // Character skill: bonus exp\n      const expResult = this.characters.applySkill({ event: 'correct' });\n      if (expResult.triggered && expResult.bonus) {\n        this.data.addExp(expResult.bonus);\n      }\n\n      if (cr.combo >= 3) this.audio.playCombo(cr.combo);\n      this.data.collectIdiom(q.idiom.id);\n      this.daily.updateTaskProgress('answer', 1);\n      this.daily.updateTaskProgress('combo', cr.combo >= 3 ? 1 : 0);\n      q.comboResult = cr;\n      this.render();\n      setTimeout(() => { this.questionIndex++; this._startQuestion(); this.render(); }, 800);\n    } else {\n      // Character skill: lucky save\n      const skillResult = this.characters.applySkill({ event: 'wrong' });\n      if (skillResult.triggered) {\n        this.audio.playHint();\n        this.render();\n        setTimeout(() => {\n          q.answered = false; q.correct = null;\n          this.judge.startQuestion(q);\n          this.render();\n        }, 800);\n        return;\n      }\n\n      this.audio.playWrong();\n      this.combo.onWrong();\n      this.lives--;\n      this.render();\n      if (this.lives <= 0) {\n        if (!this.continuedOnce) {\n          document.getElementById('continue-modal').style.display = 'flex';\n        } else {\n          setTimeout(() => this.finishLevel(), 600);\n        }\n      } else {\n        setTimeout(() => {\n          q.answered = false; q.correct = null;\n          this.judge.startQuestion(q);\n          this.render();\n        }, 600);\n      }\n    }\n  }\n\n  removeSlot(slotIndex) {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const result = this.judge.removeSlot(slotIndex);\n    if (result.action === 'removed') this.audio.playPlace();\n    this.render();\n    return result;\n  }\n\n  useHintReveal() {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n    const fc = this.judge.getFillCount();\n    if (fc >= 4) return null;\n\n    // Character skill: free hint\n    const skillResult = this.characters.applySkill({ event: 'hint' });\n    if (!skillResult.triggered) {\n      if (this.data.coins < this.hintRevealCost) {\n        alert('金币不足');\n        return null;\n      }\n      this.data.spendCoins(this.hintRevealCost);\n    }\n\n    const ch = this.judge.currentIdiom.chars[fc];\n    const cand = q.candidates.find(c => c.char === ch && !c.used);\n    if (!cand) return null;\n    this.usedHintThisQuestion = true;\n    this.audio.playHint();\n    const result = this.judge.placeChar(cand.index);\n    if (result.fillCount === 4) setTimeout(() => this._handleFull(result), 400);\n    this.render();\n    return result;\n  }\n\n  useHintRemove() {\n    if (this.state !== 'playing') return null;\n    const q = this.questions[this.questionIndex];\n    if (!q || q.answered) return null;\n\n    if (this.data.coins < this.hintRemoveCost) {\n      alert('金币不足');\n      return null;\n    }\n    this.data.spendCoins(this.hintRemoveCost);\n\n    const wrong = q.candidates.filter(c => !c.used && !this.judge.currentIdiom.chars.includes(c.char) && !c.removed);\n    const removed = [];\n    const cnt = Math.min(2, wrong.length);\n    for (let i = 0; i < cnt; i++) {\n      const idx = Math.floor(Math.random() * wrong.length);\n      wrong[idx].removed = true;\n      removed.push(wrong[idx]);\n      wrong.splice(idx, 1);\n    }\n    this.audio.playRemove();\n    this.render();\n    return { action: 'removed_distractors', removed };\n  }\n\n  skipQuestion() {\n    if (this.state !== 'playing') return;\n    if (this.data.coins < this.skipCost) {\n      alert('金币不足');\n      return;\n    }\n    this.data.spendCoins(this.skipCost);\n    const q = this.questions[this.questionIndex];\n    if (q) { q.answered = true; q.correct = false; q.skipped = true; }\n    this.combo.onSkip();\n    this.questionIndex++;\n    this._startQuestion();\n    this.render();\n  }\n\n  continueWithAd() {\n    if (this.continuedOnce) return false;\n    this.lives = 3;\n    this.continuedOnce = true;\n    const q = this.questions[this.questionIndex];\n    if (q) { q.answered = false; q.correct = null; this.judge.startQuestion(q); }\n    this.render();\n    return true;\n  }\n\n  finishLevel() {\n    this.state = 'result';\n    document.getElementById('continue-modal').style.display = 'none';\n    const s = this.combo.getStats();\n    const stars = this.combo.getStarRating(s.correctCount, this.questions.length);\n\n    if (stars > 0 && this.currentLevel) {\n      this.data.setLevelStars(this.currentLevel.id, stars);\n      this.data.addCoins(this.currentLevel.reward.coins);\n      this.data.addScore(s.score);\n      this.data.updateBestCombo(s.maxCombo);\n      this.data.addExp(this.currentLevel.reward.exp || 10);\n      this.daily.updateTaskProgress('level', 1);\n      this.daily.updateTaskProgress('collect', s.correctCount);\n    }\n\n    this.levelResult = {\n      stars, correctCount: s.correctCount, totalQuestions: this.questions.length,\n      score: s.score, maxCombo: s.maxCombo,\n      coins: stars > 0 ? this.currentLevel.reward.coins : 0\n    };\n    if (stars > 0) this.audio.playLevelWin(); else this.audio.playLevelFail();\n    this.render();\n  }\n\n  // ===== W2: Timed Challenge =====\n  startTimedChallenge() {\n    this.state = 'timed';\n    this.timed.onUpdate = (evt) => {\n      if (evt === 'end') {\n        this.state = 'timed_result';\n      }\n      this.render();\n    };\n    this.timed.start();\n  }\n\n  // ===== W2: PK Mode =====\n  startPK(opponentResult) {\n    this.state = 'pk';\n    this.pk.onUpdate = (evt) => {\n      if (evt === 'end') {\n        this.state = 'pk_result';\n      }\n      this.render();\n    };\n    this.pk.start(opponentResult);\n  }\n\n  // ===== W2: Collection =====\n  showCollection() {\n    this.state = 'collection';\n    this.render();\n  }\n\n  // ===== W2: Daily =====\n  showDaily() {\n    this.state = 'daily';\n    this.render();\n  }\n\n  // ===== W2: Characters =====\n  showCharacters() {\n    this.state = 'characters';\n    this.render();\n  }\n\n  showLevelMap() {\n    this.state = 'map';\n    this.render();\n  }\n\n  goToMenu() {\n    this.state = 'menu';\n    this.tutorial.end();\n    this.render();\n  }\n\n  getCurrentQuestion() { return this.questions[this.questionIndex]; }\n\n  render() { if (typeof renderUI === 'function') renderUI(this); }\n}\n\nfunction handleHintReveal() { game.useHintReveal(); }\nfunction handleHintRemove() { game.useHintRemove(); }\nfunction handleSkip() { game.skipQuestion(); }\n\nif (typeof module !== 'undefined') module.exports = { Game };\n","numLines":325,"startLine":1,"totalLines":325}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_78b652e57d4f463ebbee43b3","type":"tool_result","content":"1\t<!DOCTYPE html>\n2\t<html lang=\"zh-CN\">\n3\t<head>\n4\t  <meta charset=\"UTF-8\">\n5\t  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n6\t  <title>成语大闯关 - Idiom Master</title>\n7\t  <link rel=\"stylesheet\" href=\"src/css/style.css\">\n8\t</head>\n9\t<body>\n10\t  <div id=\"app\">\n11\t    <!-- 主菜单 -->\n12\t    <div id=\"menu-screen\" class=\"screen active\">\n13\t      <div class=\"menu-bg\">\n14\t        <div class=\"title-block\">\n15\t          <h1 class=\"title\">成语大闯关</h1>\n16\t          <p class=\"subtitle\">Idiom Master</p>\n17\t        </div>\n18\t        <div class=\"menu-stats\">\n19\t          <span class=\"stat-item\" id=\"menu-avatar\">👦</span>\n20\t          <span class=\"stat-item\">🪙 <span id=\"menu-coins\">0</span></span>\n21\t          <span class=\"stat-item\">📖 <span id=\"menu-collected\">0</span>成语</span>\n22\t        </div>\n23\t        <div class=\"menu-buttons\">\n24\t          <button class=\"btn btn-primary\" onclick=\"game.showLevelMap()\">闯关模式</button>\n25\t          <button class=\"btn btn-secondary\" onclick=\"game.startTimedChallenge()\">限时挑战</button>\n26\t          <button class=\"btn btn-accent\" onclick=\"game.startPK()\">好友PK</button>\n27\t        </div>\n28\t        <div class=\"menu-row\">\n29\t          <button class=\"btn btn-outline\" onclick=\"game.showCollection()\">📖 成语图鉴</button>\n30\t          <button class=\"btn btn-outline\" onclick=\"game.showDaily()\">📅 每日</button>\n31\t          <button class=\"btn btn-outline\" onclick=\"game.showCharacters()\">👤 角色</button>\n32\t        </div>\n33\t        <div class=\"menu-footer\">\n34\t          <button class=\"btn-icon\" onclick=\"game.audio.toggle(); this.textContent = game.audio.enabled ? '🔊' : '🔇'\">🔊</button>\n35\t          <button class=\"btn-icon\" onclick=\"game.data.reset(); location.reload()\">🔄</button>\n36\t        </div>\n37\t      </div>\n38\t    </div>\n39\t\n40\t    <!-- 关卡地图 -->\n41\t    <div id=\"map-screen\" class=\"screen\">\n42\t      <div class=\"map-header\">\n43\t        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n44\t        <h2>选择关卡</h2>\n45\t        <span>🪙 <span id=\"map-coins\">0</span></span>\n46\t      </div>\n47\t      <div id=\"chapter-info\" class=\"chapter-info\"></div>\n48\t      <div id=\"level-grid\" class=\"level-grid\"></div>\n49\t    </div>\n50\t\n51\t    <!-- 游戏界面 -->\n52\t    <div id=\"game-screen\" class=\"screen\">\n53\t      <div class=\"game-header\">\n54\t        <button class=\"btn-back\" onclick=\"if(confirm('确定退出？')) game.goToMenu()\">✕</button>\n55\t        <div class=\"header-center\">\n56\t          <span id=\"level-label\">第1关</span>\n57\t          <span id=\"progress-label\">1/10</span>\n58\t        </div>\n59\t        <div class=\"header-right\">\n60\t          <span id=\"lives-display\">❤️❤️❤️❤️❤️</span>\n61\t        </div>\n62\t      </div>\n63\t\n64\t      <div class=\"game-body\">\n65\t        <div id=\"combo-display\" class=\"combo-display\"></div>\n66\t        <div id=\"meaning-box\" class=\"meaning-box\">\n67\t          <span id=\"meaning-text\"></span>\n68\t        </div>\n69\t        <div id=\"slots-container\" class=\"slots-container\"></div>\n70\t        <div id=\"idiom-hint\" class=\"idiom-hint\"></div>\n71\t        <div id=\"candidates-container\" class=\"candidates-container\"></div>\n72\t      </div>\n73\t\n74\t      <div class=\"game-footer\">\n75\t        <button class=\"tool-btn\" onclick=\"handleHintReveal()\">📖 揭示 (5🪙)</button>\n76\t        <button class=\"tool-btn\" onclick=\"handleHintRemove()\">✂️ 去干扰 (5🪙)</button>\n77\t        <button class=\"tool-btn\" onclick=\"handleSkip()\">⏭ 跳过 (10🪙)</button>\n78\t      </div>\n79\t\n80\t      <!-- 教学覆盖层 -->\n81\t      <div id=\"tutorial-overlay\" class=\"tutorial-overlay\" style=\"display:none\">\n82\t        <div class=\"tutorial-arrow\"></div>\n83\t        <div id=\"tutorial-text\" class=\"tutorial-text\"></div>\n84\t      </div>\n85\t    </div>\n86\t\n87\t    <!-- 结算界面 -->\n88\t    <div id=\"result-screen\" class=\"screen\">\n89\t      <div class=\"result-card\">\n90\t        <h2 id=\"result-title\" class=\"result-title\">通关!</h2>\n91\t        <div id=\"result-stars\" class=\"result-stars\"></div>\n92\t        <div class=\"result-stats\">\n93\t          <p>正确: <span id=\"result-correct\">0</span> / <span id=\"result-total\">10</span></p>\n94\t          <p>得分: <span id=\"result-score\">0</span></p>\n95\t          <p>最大连击: <span id=\"result-combo\">0</span></p>\n96\t          <p class=\"coins-earned\">🪙 +<span id=\"result-coins\">0</span></p>\n97\t        </div>\n98\t        <div class=\"result-buttons\">\n99\t          <button class=\"btn btn-primary\" onclick=\"game.goToMenu()\">返回地图</button>\n100\t          <button class=\"btn btn-secondary\" id=\"btn-retry\" onclick=\"game.startLevel(game.currentLevel.id)\">重新挑战</button>\n101\t          <button class=\"btn btn-accent\" id=\"btn-next\" onclick=\"game.startLevel(game.currentLevel.id + 1)\">下一关</button>\n102\t        </div>\n103\t      </div>\n104\t    </div>\n105\t\n106\t    <!-- 续命弹窗 -->\n107\t    <div id=\"continue-modal\" class=\"modal\" style=\"display:none\">\n108\t      <div class=\"modal-content\">\n109\t        <h3>挑战失败</h3>\n110\t        <p>生命值耗尽了！</p>\n111\t        <div class=\"modal-buttons\">\n112\t          <button class=\"btn btn-secondary\" onclick=\"game.finishLevel(); document.getElementById('continue-modal').style.display='none'\">放弃</button>\n113\t          <button class=\"btn btn-primary\" onclick=\"game.continueWithAd(); document.getElementById('continue-modal').style.display='none'\">看视频续命 ❤️×3</button>\n114\t        </div>\n115\t      </div>\n116\t    </div>\n117\t\n118\t    <!-- ===== W2: 限时挑战 ===== -->\n119\t    <div id=\"timed-screen\" class=\"screen\">\n120\t      <div class=\"game-header\">\n121\t        <button class=\"btn-back\" onclick=\"if(confirm('确定退出？')){game.timed.end();game.goToMenu()}\">✕</button>\n122\t        <div class=\"header-center\">\n123\t          <span id=\"timed-timer\" class=\"timer-display\">60s</span>\n124\t        </div>\n125\t        <div class=\"header-right\">\n126\t          <span>得分: <span id=\"timed-score\">0</span></span>\n127\t        </div>\n128\t      </div>\n129\t      <div class=\"game-body\">\n130\t        <div id=\"timed-combo\" class=\"combo-display\"></div>\n131\t        <div class=\"meaning-box\"><span id=\"timed-meaning\"></span></div>\n132\t        <div id=\"timed-slots\" class=\"slots-container\"></div>\n133\t        <div id=\"timed-candidates\" class=\"candidates-container\"></div>\n134\t      </div>\n135\t      <div class=\"game-footer\">\n136\t        <button class=\"tool-btn\" onclick=\"game.timed.useHintReveal()\">📖 揭示</button>\n137\t        <button class=\"tool-btn\" onclick=\"game.timed.useHintRemove()\">✂️ 去干扰</button>\n138\t      </div>\n139\t    </div>\n140\t\n141\t    <!-- W2: 限时挑战结算 -->\n142\t    <div id=\"timed-result-screen\" class=\"screen\">\n143\t      <div class=\"result-card\">\n144\t        <h2 class=\"result-title\">⏱ 限时挑战结束</h2>\n145\t        <div class=\"result-stats\">\n146\t          <p>得分: <span id=\"tr-score\">0</span></p>\n147\t          <p>正确: <span id=\"tr-correct\">0</span> / <span id=\"tr-total\">0</span></p>\n148\t          <p>最大连击: <span id=\"tr-combo\">0</span></p>\n149\t          <p class=\"coins-earned\">🪙 +<span id=\"tr-coins\">0</span></p>\n150\t        </div>\n151\t        <div class=\"result-buttons\">\n152\t          <button class=\"btn btn-primary\" onclick=\"game.goToMenu()\">返回</button>\n153\t          <button class=\"btn btn-accent\" onclick=\"game.startTimedChallenge()\">再来一次</button>\n154\t        </div>\n155\t      </div>\n156\t    </div>\n157\t\n158\t    <!-- ===== W2: 成语图鉴 ===== -->\n159\t    <div id=\"collection-screen\" class=\"screen\">\n160\t      <div class=\"map-header\">\n161\t        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n162\t        <h2>成语图鉴</h2>\n163\t        <span id=\"col-progress\">0/0</span>\n164\t      </div>\n165\t      <div class=\"col-bar-wrap\">\n166\t        <div class=\"col-bar\"><div id=\"col-progress-bar\" class=\"col-bar-fill\"></div></div>\n167\t      </div>\n168\t      <input type=\"text\" id=\"col-search\" class=\"col-search\" placeholder=\"搜索成语/释义...\" oninput=\"handleColSearch(this.value)\">\n169\t      <div id=\"col-categories\" class=\"col-categories\"></div>\n170\t      <div id=\"col-grid\" class=\"col-grid\"></div>\n171\t      <div id=\"col-detail\" class=\"col-detail\" style=\"display:none\"></div>\n172\t    </div>\n173\t\n174\t    <!-- ===== W2: 每日系统 ===== -->\n175\t    <div id=\"daily-screen\" class=\"screen\">\n176\t      <div class=\"map-header\">\n177\t        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n178\t        <h2>📅 每日</h2>\n179\t      </div>\n180\t      <div class=\"daily-content\">\n181\t        <div class=\"daily-login\">\n182\t          <h3>每日签到</h3>\n183\t          <p>连续签到: <span id=\"daily-streak\" class=\"streak-num\">1</span> 天</p>\n184\t          <p>状态: <span id=\"daily-claimed\">未领取</span></p>\n185\t          <button id=\"daily-claim-btn\" class=\"btn btn-accent\" onclick=\"game.daily.claimLogin(); game.render()\">领取签到奖励</button>\n186\t        </div>\n187\t\n188\t        <div class=\"daily-section\">\n189\t          <h3>每日任务</h3>\n190\t          <div id=\"daily-tasks\" class=\"task-list\"></div>\n191\t        </div>\n192\t\n193\t        <div class=\"daily-section\">\n194\t          <h3>今日挑战</h3>\n195\t          <div id=\"daily-challenge\"></div>\n196\t        </div>\n197\t      </div>\n198\t    </div>\n199\t\n200\t    <!-- ===== W2: 好友PK ===== -->\n201\t    <div id=\"pk-screen\" class=\"screen\">\n202\t      <div class=\"game-header\">\n203\t        <button class=\"btn-back\" onclick=\"game.goToMenu()\">✕</button>\n204\t        <div class=\"header-center\">\n205\t          <span>好友PK</span>\n206\t          <span id=\"pk-progress\">1/5</span>\n207\t        </div>\n208\t        <div class=\"header-right\"></div>\n209\t      </div>\n210\t      <div class=\"game-body\">\n211\t        <div class=\"meaning-box\"><span id=\"pk-meaning\"></span></div>\n212\t        <div id=\"pk-slots\" class=\"slots-container\"></div>\n213\t        <div id=\"pk-candidates\" class=\"candidates-container\"></div>\n214\t      </div>\n215\t    </div>\n216\t\n217\t    <!-- W2: PK结果 -->\n218\t    <div id=\"pk-result-screen\" class=\"screen\">\n219\t      <div class=\"result-card\">\n220\t        <h2 id=\"pkr-result\" class=\"result-title\">结果</h2>\n221\t        <div class=\"result-stats\">\n222\t          <p>正确: <span id=\"pkr-correct\">0/5</span></p>\n223\t          <p>用时: <span id=\"pkr-time\">0s</span></p>\n224\t          <p class=\"coins-earned\"><span id=\"pkr-reward\"></span></p>\n225\t        </div>\n226\t        <div id=\"pkr-answers\" class=\"pk-answers\"></div>\n227\t        <div class=\"result-buttons\">\n228\t          <button class=\"btn btn-primary\" onclick=\"game.goToMenu()\">返回</button>\n229\t          <button class=\"btn btn-secondary\" onclick=\"game.social.sharePKResult(game.pk.getResult())\">分享结果</button>\n230\t          <button class=\"btn btn-accent\" onclick=\"game.startPK()\">再来一局</button>\n231\t        </div>\n232\t      </div>\n233\t    </div>\n234\t\n235\t    <!-- ===== W2: 角色 ===== -->\n236\t    <div id=\"characters-screen\" class=\"screen\">\n237\t      <div class=\"map-header\">\n238\t        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n239\t        <h2>👤 角色选择</h2>\n240\t      </div>\n241\t      <div id=\"char-grid\" class=\"char-grid\"></div>\n242\t      <div id=\"char-detail\" class=\"char-detail\"></div>\n243\t    </div>\n244\t  </div>\n245\t\n246\t  <script src=\"src/js/IdiomDBExtra.js\"></script>\n247\t  <script src=\"src/js/