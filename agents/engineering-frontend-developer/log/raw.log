   buildupDuration: 3000, resolveDuration: 5000,\n304\t    sanityCost: 28, cooldownSec: 600,\n305\t    description: '你进入了镜像便利店，一切左右翻转',\n306\t  },\n307\t  {\n308\t    type: HorrorEventType.HE_COMES,\n309\t    level: HorrorLevel.EXISTENTIAL,\n310\t    baseProbability: 0.05,\n311\t    minDay: 26, maxDay: 30,\n312\t    phaseRequired: [GamePhase.DANGER],\n313\t    minActiveDuration: 30000, maxActiveDuration: 30000,\n314\t    buildupDuration: 5000, resolveDuration: 3000,\n315\t    sanityCost: 30, cooldownSec: 600,\n316\t    description: '\"他\"来了——30秒不可阻挡的缓慢接近',\n317\t  },\n318\t  {\n319\t    type: HorrorEventType.FINAL_CHOICE,\n320\t    level: HorrorLevel.EXISTENTIAL,\n321\t    baseProbability: 0.03,\n322\t    minDay: 29, maxDay: 30,\n323\t    phaseRequired: [GamePhase.DANGER],\n324\t    minActiveDuration: 0, maxActiveDuration: 0,\n325\t    buildupDuration: 3000, resolveDuration: 5000,\n326\t    sanityCost: 25, cooldownSec: 9999,\n327\t    description: '基于之前选择的最终决定时刻',\n328\t  },\n329\t];\n330\t\n331\t// --- Visual Effect State ---\n332\t\n333\texport interface HorrorVisualState {\n334\t  // Global\n335\t  frostIntensity: number;      // 0-1, frost on edges\n336\t  darknessBoost: number;       // 0-0.5, extra darkness\n337\t  screenShake: number;         // shake intensity\n338\t  chromaticAberration: number; // 0-1\n339\t  vignetteIntensity: number;   // 0-1\n340\t\n341\t  // Specific\n342\t  flickeringLightIndex: number; // which light is flickering (-1 = none)\n343\t  flickerIntensity: number;     // 0-1\n344\t\n345\t  bloodPositions: Array<{ x: number; y: number; size: number; alpha: number }>;\n346\t  ghostEntity: {\n347\t    active: boolean;\n348\t    x: number;\n349\t    y: number;\n350\t    opacity: number;\n351\t    type: 'ghost_customer' | 'duplicate' | 'nonpaying' | 'shadow';\n352\t  } | null;\n353\t  doorState: {\n354\t    frontOpen: boolean;\n355\t    backOpen: boolean;\n356\t  };\n357\t  timeGlitchActive: boolean;\n358\t  storeMutateOffset: { x: number; y: number };\n359\t  whisperActive: boolean;\n360\t\n361\t  // Level 3 new\n362\t  stalkerPosition: { x: number; y: number; distance: number } | null;\n363\t  cctvGlitchActive: boolean;\n364\t  corridorStretch: number; // 0-1 how much the corridor extends\n365\t  radioDistortion: number; // 0-1\n366\t\n367\t  // Level 4 new\n368\t  mirrorActive: boolean;\n369\t  mirrorFlipX: boolean;\n370\t  heComesActive: boolean;\n371\t  heComesProgress: number; // 0-1 how close \"he\" is\n372\t  finalChoiceActive: boolean;\n373\t\n374\t  // Atmosphere\n375\t  ambientFear: number; // 0-1 overall fear level\n376\t  recentHighFearCount: number; // for fear regulation\n377\t}\n378\t\n379\texport function createDefaultVisualState(): HorrorVisualState {\n380\t  return {\n381\t    frostIntensity: 0,\n382\t    darknessBoost: 0,\n383\t    screenShake: 0,\n384\t    chromaticAberration: 0,\n385\t    vignetteIntensity: 0.3,\n386\t    flickeringLightIndex: -1,\n387\t    flickerIntensity: 0,\n388\t    bloodPositions: [],\n389\t    ghostEntity: null,\n390\t    doorState: { frontOpen: false, backOpen: false },\n391\t    timeGlitchActive: false,\n392\t    storeMutateOffset: { x: 0, y: 0 },\n393\t    whisperActive: false,\n394\t    stalkerPosition: null,\n395\t    cctvGlitchActive: false,\n396\t    corridorStretch: 0,\n397\t    radioDistortion: 0,\n398\t    mirrorActive: false,\n399\t    mirrorFlipX: false,\n400\t    heComesActive: false,\n401\t    heComesProgress: 0,\n402\t    finalChoiceActive: false,\n403\t    ambientFear: 0,\n404\t    recentHighFearCount: 0,\n405\t  };\n406\t}\n407\t\n408\t// --- Manager ---\n409\t\n410\texport class HorrorEventManager {\n411\t  private activeEvents: HorrorEventInstance[] = [];\n412\t  private cooldowns: Map<HorrorEventType, number> = new Map();\n413\t  private visual: HorrorVisualState = createDefaultVisualState();\n414\t  private checkInterval = 5000; // check every 5 seconds\n415\t  private checkTimer = 0;\n416\t  private dayAccumulatedSanityCost = 0;\n417\t  private maxSanityCostPerNight = 40;\n418\t  private eventCounter = 0;\n419\t  private maxConcurrentEvents = 3;\n420\t\n421\t  // Callbacks\n422\t  onEventTrigger?: (event: HorrorEventInstance) => void;\n423\t  onSanityChange?: (delta: number) => void;\n424\t  onNotification?: (text: string) => void;\n425\t\n426\t  get visuals(): HorrorVisualState { return this.visual; }\n427\t  get activeEventCount(): number { return this.activeEvents.length; }\n428\t\n429\t  update(dt: number, day: number, phase: GamePhase, timeOfDay: number, sanity: number): HorrorVisualState {\n430\t    const dtSec = dt / 1000;\n431\t\n432\t    // Update cooldowns\n433\t    for (const [type, cd] of this.cooldowns) {\n434\t      if (cd > 0) this.cooldowns.set(type, Math.max(0, cd - dtSec));\n435\t    }\n436\t\n437\t    // Check for new events only at night\n438\t    if (isNightTime(phase) && this.activeEvents.length < this.maxConcurrentEvents) {\n439\t      this.checkTimer += dt;\n440\t      if (this.checkTimer >= this.checkInterval) {\n441\t        this.checkTimer = 0;\n442\t        this.tryTriggerEvents(day, phase, sanity);\n443\t      }\n444\t    }\n445\t\n446\t    // Update active events\n447\t    this.updateActiveEvents(dt);\n448\t\n449\t    // Decay visual effects toward baseline\n450\t    this.decayVisuals(dtSec);\n451\t\n452\t    // Calculate ambient fear\n453\t    this.updateAmbientFear(day, phase, timeOfDay);\n454\t\n455\t    return this.visual;\n456\t  }\n457\t\n458\t  private tryTriggerEvents(day: number, phase: GamePhase, sanity: number): void {\n459\t    for (const def of EVENT_DEFS) {\n460\t      if (this.activeEvents.length >= this.maxConcurrentEvents) break;\n461\t      if (this.activeEvents.some(e => e.type === def.type)) continue;\n462\t      if (day < def.minDay || day > def.maxDay) continue;\n463\t      if (!def.phaseRequired.includes(phase)) continue;\n464\t\n465\t      const cd = this.cooldowns.get(def.type) ?? 0;\n466\t      if (cd > 0) continue;\n467\t\n468\t      // Fear regulation: reduce probability if recent high fear\n469\t      let probabilityMod = 1;\n470\t      if (this.visual.recentHighFearCount >= 2 && def.level >= HorrorLevel.THREAT) {\n471\t        probabilityMod = 0.2; // big reduction after consecutive high fear\n472\t      }\n473\t\n474\t      // Sanity affects: lower sanity = slightly less events (overwhelmed player)\n475\t      if (sanity < 30) probabilityMod *= 0.5;\n476\t\n477\t      // Night depth increases probability\n478\t      const nightDepth = phase === GamePhase.DANGER ? 1.5 : 1;\n479\t      probabilityMod *= nightDepth;\n480\t\n481\t      // Day progression increases probability\n482\t      const dayProgress = Math.min(day / 15, 2);\n483\t      probabilityMod *= dayProgress;\n484\t\n485\t      const roll = Math.random();\n486\t      if (roll < def.baseProbability * probabilityMod) {\n487\t        this.triggerEvent(def);\n488\t      }\n489\t    }\n490\t  }\n491\t\n492\t  private triggerEvent(def: HorrorEventDef): void {\n493\t    const id = `horror_${++this.eventCounter}_${Date.now()}`;\n494\t    const event: HorrorEventInstance = {\n495\t      id,\n496\t      type: def.type,\n497\t      level: def.level,\n498\t      state: HorrorEventState.BUILDUP,\n499\t      timer: 0,\n500\t      duration: def.minActiveDuration + Math.random() * (def.maxActiveDuration - def.minActiveDuration),\n501\t      buildupDuration: def.buildupDuration,\n502\t      resolveDuration: def.resolveDuration,\n503\t      data: {},\n504\t      sanityCost: def.sanityCost,\n505\t    };\n506\t\n507\t    // Randomize specific data\n508\t    event.data = this.generateEventData(def);\n509\t\n510\t    this.activeEvents.push(event);\n511\t    this.cooldowns.set(def.type, def.cooldownSec);\n512\t\n513\t    if (def.level >= HorrorLevel.THREAT) {\n514\t      this.visual.recentHighFearCount++;\n515\t    }\n516\t\n517\t    this.onEventTrigger?.(event);\n518\t    this.onNotification?.(`⚠ ${def.description}`);\n519\t  }\n520\t\n521\t  private generateEventData(def: HorrorEventDef): Record<string, unknown> {\n522\t    switch (def.type) {\n523\t      case HorrorEventType.SHELF_SHIFT:\n524\t        return { shelfIndex: Math.floor(Math.random() * 5) };\n525\t      case HorrorEventType.LIGHT_FLICKER:\n526\t        return { lightIndex: Math.floor(Math.random() * 8) };\n527\t      case HorrorEventType.REGISTER_ANOMALY:\n528\t        return { registerIndex: Math.floor(Math.random() * 2), anomalyAmount: Math.floor(Math.random() * 9999) };\n529\t      case HorrorEventType.BLOOD_ON_SHELF: {\n530\t        const positions = [];\n531\t        const count = 2 + Math.floor(Math.random() * 4);\n532\t        for (let i = 0; i < count; i++) {\n533\t          positions.push({\n534\t            x: 100 + Math.random() * 600,\n535\t            y: 100 + Math.random() * 400,\n536\t            size: 8 + Math.random() * 20,\n537\t            alpha: 0.3 + Math.random() * 0.5,\n538\t          });\n539\t        }\n540\t        return { positions };\n541\t      }\n542\t      case HorrorEventType.GHOST_CUSTOMER:\n543\t        return { startX: Math.random() * 400 + 100, startY: 50, opacity: 0 };\n544\t      case HorrorEventType.DUPLICATE_CUSTOMER:\n545\t        return { x1: 200 + Math.random() * 200, x2: 400 + Math.random() * 200, y: 200 + Math.random() * 100 };\n546\t      case HorrorEventType.NONPAYING_CUSTOMER:\n547\t        return { x: 300 + Math.random() * 200, y: 150 + Math.random() * 100 };\n548\t      case HorrorEventType.DOOR_AUTO_OPEN:\n549\t        return { door: Math.random() < 0.5 ? 'front' : 'back' };\n550\t      case HorrorEventType.STALKER:\n551\t        return { startX: 400 + Math.random() * 200, startY: 200, distance: 300 + Math.random() * 200, checkCount: 0 };\n552\t      case HorrorEventType.CCTV_DOUBLE:\n553\t        return { glitchX: 200 + Math.random() * 400, glitchY: 100 + Math.random() * 200 };\n554\t      case HorrorEventType.CORRIDOR_EXTEND:\n555\t        return { extraDoors: 1 + Math.floor(Math.random() * 2), stretchAmount: 1.5 + Math.random() };\n556\t      case HorrorEventType.RADIO_VOICE:\n557\t        return { frequency: 88 + Math.random() * 20, voiceType: Math.floor(Math.random() * 3) };\n558\t      case HorrorEventType.MIRROR_STORE:\n559\t        return { flipAxis: 'x' as const };\n560\t      case HorrorEventType.HE_COMES:\n561\t        return { startX: 450, startY: 24 * 32, speed: 0.7 + Math.random() * 0.3 };\n562\t      case HorrorEventType.FINAL_CHOICE:\n563\t        return { choiceType: Math.floor(Math.random() * 3) };\n564\t      default:\n565\t        return {};\n566\t    }\n567\t  }\n568\t\n569\t  private updateActiveEvents(dt: number): void {\n570\t    const completed: string[] = [];\n571\t\n572\t    for (const event of this.activeEvents) {\n573\t      event.timer += dt;\n574\t\n575\t      switch (event.state) {\n576\t        case HorrorEventState.BUILDUP:\n577\t          this.applyBuildupEffect(event, event.timer / event.buildupDuration);\n578\t          if (event.timer >= event.buildupDuration) {\n579\t            event.state = HorrorEventState.ACTIVE;\n580\t            event.timer = 0;\n581\t            this.applyActiveEffect(event);\n582\t            this.onSanityChange?.(-event.sanityCost);\n583\t            this.dayAccumulatedSanityCost += event.sanityCost;\n584\t          }\n585\t          break;\n586\t\n587\t        case HorrorEventState.ACTIVE:\n588\t          this.sustainActiveEffect(event, event.timer / event.duration);\n589\t          if (event.timer >= event.duration) {\n590\t            event.state = HorrorEventState.RESOLVING;\n591\t            event.timer = 0;\n592\t            this.beginResolve(event);\n593\t          }\n594\t          break;\n595\t\n596\t        case HorrorEventState.RESOLVING:\n597\t          this.applyResolveEffect(event, event.timer / event.resolveDuration);\n598\t          if (event.timer >= event.resolveDuration) {\n599\t            event.state = HorrorEventState.COMPLETE;\n600\t            completed.push(event.id);\n601\t            this.clearEventEffects(event);\n602\t          }\n603\t          break;\n604\t      }\n605\t    }\n606\t\n607\t    for (const id of completed) {\n608\t      this.activeEvents = this.activeEvents.filter(e => e.id !== id);\n609\t    }\n610\t  }\n611\t\n612\t  // --- Buildup Effects (预兆) ---\n613\t\n614\t  private applyBuildupEffect(event: HorrorEventInstance, progress: number): void {\n615\t    const p = Math.min(1, progress);\n616\t    switch (event.type) {\n617\t      case HorrorEventType.LIGHT_FLICKER:\n618\t        this.visual.flickeringLightIndex = (event.data.lightIndex as number) ?? 0;\n619\t        this.visual.flickerIntensity = p * 0.3;\n620\t        break;\n621\t      case HorrorEventType.TEMP_DROP:\n622\t        this.visual.frostIntensity = p * 0.2;\n623\t        break;\n624\t      case HorrorEventType.BLOOD_ON_SHELF:\n625\t        this.visual.darknessBoost = p * 0.1;\n626\t        break;\n627\t      case HorrorEventType.WHISPER:\n628\t        this.visual.whisperActive = true;\n629\t        break;\n630\t      case HorrorEventType.GHOST_CUSTOMER:\n631\t      case HorrorEventType.DUPLICATE_CUSTOMER:\n632\t      case HorrorEventType.NONPAYING_CUSTOMER:\n633\t        this.visual.vignetteIntensity = Math.min(1, 0.3 + p * 0.3);\n634\t        break;\n635\t      case HorrorEventType.DOOR_AUTO_OPEN:\n636\t        this.visual.screenShake = p * 0.3;\n637\t        break;\n638\t      case HorrorEventType.STALKER:\n639\t        this.visual.vignetteIntensity = Math.min(1, 0.3 + p * 0.4);\n640\t        break;\n641\t      case HorrorEventType.CCTV_DOUBLE:\n642\t        this.visual.chromaticAberration = p * 0.2;\n643\t        break;\n644\t      case HorrorEventType.CORRIDOR_EXTEND:\n645\t        this.visual.corridorStretch = p * 0.3;\n646\t        break;\n647\t      case HorrorEventType.RADIO_VOICE:\n648\t        this.visual.radioDistortion = p * 0.3;\n649\t        break;\n650\t      case HorrorEventType.MIRROR_STORE:\n651\t        this.visual.chromaticAberration = p * 0.4;\n652\t        break;\n653\t      case HorrorEventType.HE_COMES:\n654\t        this.visual.vignetteIntensity = Math.min(1, 0.4 + p * 0.5);\n655\t        this.visual.darknessBoost = p * 0.2;\n656\t        break;\n657\t      case HorrorEventType.FINAL_CHOICE:\n658\t        this.visual.chromaticAberration = p * 0.5;\n659\t        this.visual.vignetteIntensity = Math.min(1, 0.5 + p * 0.5);\n660\t        break;\n661\t      case HorrorEventType.STORE_MUTATE:\n662\t        this.visual.chromaticAberration = p * 0.3;\n663\t        break;\n664\t      default:\n665\t        this.visual.darknessBoost = p * 0.05;\n666\t        break;\n667\t    }\n668\t  }\n669\t\n670\t  // --- Active Effects ---\n671\t\n672\t  private applyActiveEffect(event: HorrorEventInstance): void {\n673\t    switch (event.type) {\n674\t      case HorrorEventType.LIGHT_FLICKER:\n675\t        this.visual.flickerIntensity = 0.8;\n676\t        break;\n677\t      case HorrorEventType.TEMP_DROP:\n678\t        this.visual.frostIntensity = 0.6;\n679\t        this.visual.vignetteIntensity = 0.7;\n680\t        break;\n681\t      case HorrorEventType.FRIDGE_NOISE:\n682\t        this.visual.screenShake = 0.5;\n683\t        break;\n684\t      case HorrorEventType.BLOOD_ON_SHELF:\n685\t        this.visual.bloodPositions = (event.data.positions as Array<{ x: number; y: number; size: number; alpha: number }>) ?? [];\n686\t        break;\n687\t      case HorrorEventType.GHOST_CUSTOMER:\n688\t        this.visual.ghostEntity = {\n689\t          active: true,\n690\t          x: (event.data.startX as number) ?? 300,\n691\t          y: (event.data.startY as number) ?? 50,\n692\t          opacity: 0.4,\n693\t          type: 'ghost_customer',\n694\t        };\n695\t        break;\n696\t      case HorrorEventType.DUPLICATE_CUSTOMER:\n697\t        this.visual.ghostEntity = {\n698\t          active: true,\n699\t          x: (event.data.x1 as number) ?? 200,\n700\t          y: (event.data.y as number) ?? 200,\n701\t          opacity: 0.8,\n702\t          type: 'duplicate',\n703\t        };\n704\t        break;\n705\t      case HorrorEventType.NONPAYING_CUSTOMER:\n706\t        this.visual.ghostEntity = {\n707\t          active: true,\n708\t          x: (event.data.x as number) ?? 300,\n709\t          y: (event.data.y as number) ?? 150,\n710\t          opacity: 0.9,\n711\t          type: 'nonpaying',\n712\t        };\n713\t        break;\n714\t      case HorrorEventType.DOOR_AUTO_OPEN:\n715\t        if ((event.data.door as string) === 'front') {\n716\t          this.visual.doorState.frontOpen = true;\n717\t        } else {\n718\t          this.visual.doorState.backOpen = true;\n719\t        }\n720\t        this.visual.darknessBoost = 0.3;\n721\t        this.visual.screenShake = 0.8;\n722\t        break;\n723\t      case HorrorEventType.WHISPER:\n724\t        this.visual.whisperActive = true;\n725\t        this.visual.vignetteIntensity = 0.8;\n726\t        break;\n727\t      case HorrorEventType.STORE_MUTATE:\n728\t        this.visual.storeMutateOffset = { x: (Math.random() - 0.5) * 10, y: (Math.random() - 0.5) * 10 };\n729\t        this.visual.chromaticAberration = 0.8;\n730\t        this.visual.screenShake = 0.4;\n731\t        break;\n732\t      case HorrorEventType.TIME_GLITCH:\n733\t        this.visual.timeGlitchActive = true;\n734\t        this.visual.chromaticAberration = 0.6;\n735\t        break;\n736\t      case HorrorEventType.STALKER:\n737\t        this.visual.stalkerPosition = {\n738\t          x: (event.data.startX as number) ?? 400,\n739\t          y: (event.data.startY as number) ?? 200,\n740\t          distance: (event.data.distance as number) ?? 300,\n741\t        };\n742\t        this.visual.vignetteIntensity = 0.8;\n743\t        break;\n744\t      case HorrorEventType.CCTV_DOUBLE:\n745\t        this.visual.cctvGlitchActive = true;\n746\t        this.visual.chromaticAberration = 0.5;\n747\t        this.visual.screenShake = 0.3;\n748\t        break;\n749\t      case HorrorEventType.CORRIDOR_EXTEND:\n750\t        this.visual.corridorStretch = 1;\n751\t        this.visual.darknessBoost = 0.3;\n752\t        this.visual.screenShake = 0.2;\n753\t        break;\n754\t      case HorrorEventType.RADIO_VOICE:\n755\t        this.visual.radioDistortion = 1;\n756\t        this.visual.whisperActive = true;\n757\t        break;\n758\t      case HorrorEventType.MIRROR_STORE:\n759\t        this.visual.mirrorActive = true;\n760\t        this.visual.mirrorFlipX = true;\n761\t        this.visual.chromaticAberration = 0.8;\n762\t        this.visual.screenShake = 0.4;\n763\t        break;\n764\t      case HorrorEventType.HE_COMES:\n765\t        this.visual.heComesActive = true;\n766\t        this.visual.heComesProgress = 0;\n767\t        this.visual.darknessBoost = 0.5;\n768\t        this.visual.vignetteIntensity = 1;\n769\t        this.visual.screenShake = 0.6;\n770\t        break;\n771\t      case HorrorEventType.FINAL_CHOICE:\n772\t        this.visual.finalChoiceActive = true;\n773\t        this.visual.chromaticAberration = 1;\n774\t        this.visual.vignetteIntensity = 1;\n775\t        break;\n776\t      default:\n777\t        this.visual.darknessBoost = 0.15;\n778\t        break;\n779\t    }\n780\t  }\n781\t\n782\t  private sustainActiveEffect(event: HorrorEventInstance, progress: number): void {\n783\t    // Pulsing effects during sustain\n784\t    const pulse = Math.sin(progress * Math.PI * 4) * 0.5 + 0.5;\n785\t\n786\t    switch (event.type) {\n787\t      case HorrorEventType.LIGHT_FLICKER:\n788\t        this.visual.flickerIntensity = 0.4 + pulse * 0.5;\n789\t        break;\n790\t      case HorrorEventType.FRIDGE_NOISE:\n791\t        this.visual.screenShake = 0.2 + pulse * 0.3;\n792\t        break;\n793\t      case HorrorEventType.GHOST_CUSTOMER:\n794\t        if (this.visual.ghostEntity) {\n795\t          this.visual.ghostEntity.opacity = 0.2 + pulse * 0.4;\n796\t          this.visual.ghostEntity.y += 0.1;\n797\t        }\n798\t        break;\n799\t      case HorrorEventType.STORE_MUTATE: {\n800\t        const t = performance.now() * 0.001;\n801\t        this.visual.storeMutateOffset = {\n802\t          x: Math.sin(t * 0.5) * 8,\n803\t          y: Math.cos(t * 0.7) * 5,\n804\t        };\n805\t        break;\n806\t      }\n807\t      case HorrorEventType.TIME_GLITCH:\n808\t        this.visual.chromaticAberration = 0.3 + pulse * 0.5;\n809\t        break;\n810\t      case HorrorEventType.STALKER:\n811\t        if (this.visual.stalkerPosition) {\n812\t          this.visual.stalkerPosition.distance = Math.max(50, (this.visual.stalkerPosition.distance ?? 300) - 0.5);\n813\t        }\n814\t        break;\n815\t      case HorrorEventType.CCTV_DOUBLE:\n816\t        this.visual.chromaticAberration = 0.3 + pulse * 0.4;\n817\t        break;\n818\t      case HorrorEventType.CORRIDOR_EXTEND:\n819\t        this.visual.corridorStretch = 0.8 + pulse * 0.2;\n820\t        break;\n821\t      case HorrorEventType.HE_COMES:\n822\t        this.visual.heComesProgress = Math.min(1, progress);\n823\t        this.visual.darknessBoost = 0.3 + progress * 0.4;\n824\t        this.visual.screenShake = 0.3 + progress * 0.5;\n825\t        break;\n826\t      case HorrorEventType.FINAL_CHOICE:\n827\t        this.visual.chromaticAberration = 0.5 + pulse * 0.5;\n828\t        break;\n829\t      default:\n830\t        break;\n831\t    }\n832\t  }\n833\t\n834\t  // --- Resolve Effects ---\n835\t\n836\t  private beginResolve(event: HorrorEventInstance): void {\n837\t    switch (event.type) {\n838\t      case HorrorEventType.FRIDGE_NOISE:\n839\t        // Sudden silence is scarier\n840\t        this.visual.screenShake = 0;\n841\t        break;\n842\t      default:\n843\t        break;\n844\t    }\n845\t  }\n846\t\n847\t  private applyResolveEffect(event: HorrorEventInstance, progress: number): void {\n848\t    const p = Math.min(1, progress);\n849\t    switch (event.type) {\n850\t      case HorrorEventType.TEMP_DROP:\n851\t        this.visual.frostIntensity *= (1 - p);\n852\t        break;\n853\t      case HorrorEventType.LIGHT_FLICKER:\n854\t        this.visual.flickerIntensity *= (1 - p);\n855\t        if (p >= 1) this.visual.flickeringLightIndex = -1;\n856\t        break;\n857\t      case HorrorEventType.BLOOD_ON_SHELF:\n858\t        this.visual.bloodPositions = this.visual.bloodPositions.map(b => ({\n859\t          ...b, alpha: b.alpha * (1 - p),\n860\t        }));\n861\t        break;\n862\t      case HorrorEventType.GHOST_CUSTOMER:\n863\t      case HorrorEventType.DUPLICATE_CUSTOMER:\n864\t      case HorrorEventType.NONPAYING_CUSTOMER:\n865\t        if (this.visual.ghostEntity) {\n866\t          this.visual.ghostEntity.opacity *= (1 - p);\n867\t        }\n868\t        break;\n869\t      case HorrorEventType.DOOR_AUTO_OPEN:\n870\t        this.visual.doorState.frontOpen = false;\n871\t        this.visual.doorState.backOpen = false;\n872\t        this.visual.darknessBoost *= (1 - p);\n873\t        break;\n874\t      case HorrorEventType.STORE_MUTATE:\n875\t        this.visual.storeMutateOffset.x *= (1 - p);\n876\t        this.visual.storeMutateOffset.y *= (1 - p);\n877\t        this.visual.chromaticAberration *= (1 - p);\n878\t        break;\n879\t      case HorrorEventType.TIME_GLITCH:\n880\t        if (p >= 0.8) this.visual.timeGlitchActive = false;\n881\t        this.visual.chromaticAberration *= (1 - p);\n882\t        break;\n883\t      case HorrorEventType.STALKER:\n884\t        if (this.visual.stalkerPosition) {\n885\t          this.visual.stalkerPosition.distance *= (1 - p * 0.5);\n886\t        }\n887\t        if (p >= 1) this.visual.stalkerPosition = null;\n888\t        break;\n889\t      case HorrorEventType.CCTV_DOUBLE:\n890\t        this.visual.chromaticAberration *= (1 - p);\n891\t        if (p >= 1) this.visual.cctvGlitchActive = false;\n892\t        break;\n893\t      case HorrorEventType.CORRIDOR_EXTEND:\n894\t        this.visual.corridorStretch *= (1 - p);\n895\t        break;\n896\t      case HorrorEventType.RADIO_VOICE:\n897\t        this.visual.radioDistortion *= (1 - p);\n898\t        if (p >= 0.5) this.visual.whisperActive = false;\n899\t        break;\n900\t      case HorrorEventType.MIRROR_STORE:\n901\t        this.visual.chromaticAberration *= (1 - p);\n902\t        if (p >= 1) {\n903\t          this.visual.mirrorActive = false;\n904\t          this.visual.mirrorFlipX = false;\n905\t        }\n906\t        break;\n907\t      case HorrorEventType.HE_COMES:\n908\t        this.visual.darknessBoost *= (1 - p);\n909\t        this.visual.screenShake *= (1 - p);\n910\t        if (p >= 1) {\n911\t          this.visual.heComesActive = false;\n912\t          this.visual.heComesProgress = 0;\n913\t        }\n914\t        break;\n915\t      case HorrorEventType.FINAL_CHOICE:\n916\t        this.visual.chromaticAberration *= (1 - p);\n917\t        if (p >= 1) this.visual.finalChoiceActive = false;\n918\t        break;\n919\t      default:\n920\t        break;\n921\t    }\n922\t  }\n923\t\n924\t  private clearEventEffects(event: HorrorEventInstance): void {\n925\t    switch (event.type) {\n926\t      case HorrorEventType.GHOST_CUSTOMER:\n927\t      case HorrorEventType.DUPLICATE_CUSTOMER:\n928\t      case HorrorEventType.NONPAYING_CUSTOMER:\n929\t        this.visual.ghostEntity = null;\n930\t        break;\n931\t      case HorrorEventType.BLOOD_ON_SHELF:\n932\t        this.visual.bloodPositions = [];\n933\t        break;\n934\t      case HorrorEventType.WHISPER:\n935\t        this.visual.whisperActive = false;\n936\t        break;\n937\t      case HorrorEventType.TIME_GLITCH:\n938\t        this.visual.timeGlitchActive = false;\n939\t        break;\n940\t      case HorrorEventType.STALKER:\n941\t        this.visual.stalkerPosition = null;\n942\t        break;\n943\t      case HorrorEventType.CCTV_DOUBLE:\n944\t        this.visual.cctvGlitchActive = false;\n945\t        break;\n946\t      case HorrorEventType.CORRIDOR_EXTEND:\n947\t        this.visual.corridorStretch = 0;\n948\t        break;\n949\t      case HorrorEventType.RADIO_VOICE:\n950\t        this.visual.radioDistortion = 0;\n951\t        this.visual.whisperActive = false;\n952\t        break;\n953\t      case HorrorEventType.MIRROR_STORE:\n954\t        this.visual.mirrorActive = false;\n955\t        this.visual.mirrorFlipX = false;\n956\t        break;\n957\t      case HorrorEventType.HE_COMES:\n958\t        this.visual.heComesActive = false;\n959\t        this.visual.heComesProgress = 0;\n960\t        break;\n961\t      case HorrorEventType.FINAL_CHOICE:\n962\t        this.visual.finalChoiceActive = false;\n963\t        break;\n964\t      default:\n965\t        break;\n966\t    }\n967\t  }\n968\t\n969\t  private decayVisuals(dtSec: number): void {\n970\t    const decay = dtSec * 0.5;\n971\t    this.visual.screenShake = Math.max(0, this.visual.screenShake - decay);\n972\t    this.visual.darknessBoost = Math.max(0, this.visual.darknessBoost - decay * 0.1);\n973\t    if (this.visual.flickeringLightIndex === -1) {\n974\t      this.visual.flickerIntensity = Math.max(0, this.visual.flickerIntensity - decay * 0.2);\n975\t    }\n976\t  }\n977\t\n978\t  private updateAmbientFear(day: number, phase: GamePhase, timeOfDay: number): void {\n979\t    let target = 0;\n980\t\n981\t    if (isNightTime(phase)) {\n982\t      target = 0.3;\n983\t      if (phase === GamePhase.NIGHT) target = 0.5;\n984\t      if (phase === GamePhase.DANGER) target = 0.8;\n985\t\n986\t      // Day progression\n987\t      target *= Math.min(1 + (day - 1) * 0.05, 2);\n988\t\n989\t      // Active events boost fear\n990\t      target += this.activeEvents.length * 0.1;\n991\t    }\n992\t\n993\t    this.visual.ambientFear += (target - this.visual.ambientFear) * 0.02;\n994\t  }\n995\t\n996\t  // --- Public API ---\n997\t\n998\t  /** Reset daily state when new day begins */\n999\t  resetDaily(): void {\n1000\t    this.dayAccumulatedSanityCost = 0;\n1001\t    this.visual.recentHighFearCount = 0;\n1002\t    this.activeEvents = [];\n1003\t    this.visual = createDefaultVisualState();\n1004\t  }\n1005\t\n1006\t  /** Get the maximum event level available for current day */\n1007\t  getMaxLevel(day: number): HorrorLevel {\n1008\t    if (day >= 26) return HorrorLevel.EXISTENTIAL;\n1009\t    if (day >= 16) return HorrorLevel.THREAT;\n1010\t    if (day >= 6) return HorrorLevel.ENTITY;\n1011\t    return HorrorLevel.ENVIRONMENT;\n1012\t  }\n1013\t\n1014\t  /** Get active events for display */\n1015\t  getActiveEvents(): ReadonlyArray<HorrorEventInstance> {\n1016\t    return this.activeEvents;\n1017\t  }\n1018\t\n1019\t  /** Get save data */\n1020\t  getSaveData(): Record<string, unknown> {\n1021\t    return {\n1022\t      eventCounter: this.eventCounter,\n1023\t      dayAccumulatedSanityCost: this.dayAccumulatedSanityCost,\n1024\t    };\n1025\t  }\n1026\t\n1027\t  /** Load save data */\n1028\t  loadSaveData(data: Record<string, unknown>): void {\n1029\t    this.eventCounter = (data.eventCounter as number) ?? 0;\n1030\t    this.dayAccumulatedSanityCost = (data.dayAccumulatedSanityCost as number) ?? 0;\n1031\t  }\n1032\t}\n1033\t"}]},"parent_tool_use_id":null,"session_id":"328f9d51-5f9c-4f63-927e-7b99009d6517","uuid":"cadbff71-1a9d-4d9c-9419-b8bce28b6408","timestamp":"2026-05-23T05:39:24.882Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/steam-horror-sim/src/game/HorrorEventManager.ts","content":"// HorrorEventManager.ts — Event trigger engine with atmosphere escalation (M4)\n\nimport { GamePhase, isNightTime } from './GameState';\n\n// --- Event Definitions ---\n\nexport enum HorrorLevel {\n  ENVIRONMENT = 1,   // Level 1: 微恐 (Day 1-5)\n  ENTITY = 2,        // Level 2: 中恐 (Day 6-15)\n  THREAT = 3,        // Level 3: 高恐 (Day 16-25)\n  EXISTENTIAL = 4,   // Level 4: 极高恐 (Day 26-30)\n}\n\nexport enum HorrorEventType {\n  // Level 1: Environment\n  SHELF_SHIFT = 'shelf_shift',           // 商品位移\n  REGISTER_ANOMALY = 'register_anomaly', // 收银机异常\n  LIGHT_FLICKER = 'light_flicker',       // 灯光闪烁\n  TEMP_DROP = 'temp_drop',               // 温度骤降\n  FRIDGE_NOISE = 'fridge_noise',         // 冰箱异响\n  // Level 2: Entity\n  GHOST_CUSTOMER = 'ghost_customer',     // 透明顾客\n  DUPLICATE_CUSTOMER = 'duplicate_customer', // 重复脸顾客\n  SHADOW_MISALIGN = 'shadow_misalign',   // 影子错位\n  NEW_PRODUCT = 'new_product',           // 诡异新商品\n  // Level 3: Threat (Day 16-25)\n  DOOR_AUTO_OPEN = 'door_auto_open',     // 门自动开\n  BLOOD_ON_SHELF = 'blood_on_shelf',     // 货架流血\n  NONPAYING_CUSTOMER = 'nonpaying_customer', // 不付款顾客\n  WHISPER = 'whisper',                   // 低语声\n  STALKER = 'stalker',                   // E-301: 尾随者\n  CCTV_DOUBLE = 'cctv_double',           // E-302: 闭路电视中出现\"你\"\n  CORRIDOR_EXTEND = 'corridor_extend',   // E-304: 走廊延伸\n  RADIO_VOICE = 'radio_voice',           // E-305: 收音机播放前任店员声音\n  // Level 4: Existential (Day 26-30)\n  STORE_MUTATE = 'store_mutate',         // E-404: 店铺异变（墙壁移动）\n  TIME_GLITCH = 'time_glitch',           // E-402: 时间循环\n  MIRROR_STORE = 'mirror_store',         // E-401: 平行店（镜像便利店）\n  HE_COMES = 'he_comes',                 // E-403: \"他\"来了\n  FINAL_CHOICE = 'final_choice',         // E-405: 终局选择\n}\n\nexport enum HorrorEventState {\n  INACTIVE = 'inactive',\n  BUILDUP = 'buildup',       // 预兆阶段 (1-3秒)\n  ACTIVE = 'active',         // 活跃阶段\n  RESOLVING = 'resolving',   // 消退阶段\n  COMPLETE = 'complete',\n}\n\nexport interface HorrorEventInstance {\n  id: string;\n  type: HorrorEventType;\n  level: HorrorLevel;\n  state: HorrorEventState;\n  timer: number;          // ms elapsed in current state\n  duration: number;       // total active duration ms\n  buildupDuration: number;\n  resolveDuration: number;\n  data: Record<string, unknown>;\n  sanityCost: number;\n}\n\ninterface HorrorEventDef {\n  type: HorrorEventType;\n  level: HorrorLevel;\n  baseProbability: number;   // per check (0-1)\n  minDay: number;\n  maxDay: number;\n  phaseRequired: GamePhase[];\n  minActiveDuration: number; // ms\n  maxActiveDuration: number;\n  buildupDuration: number;\n  resolveDuration: number;\n  sanityCost: number;\n  cooldownSec: number;       // min seconds between same event type\n  description: string;\n}\n\nconst EVENT_DEFS: HorrorEventDef[] = [\n  // Level 1: Environment\n  {\n    type: HorrorEventType.SHELF_SHIFT,\n    level: HorrorLevel.ENVIRONMENT,\n    baseProbability: 0.15,\n    minDay: 1, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 3000, maxActiveDuration: 6000,\n    buildupDuration: 1500, resolveDuration: 1000,\n    sanityCost: 3, cooldownSec: 60,\n    description: '某个货架上的商品在你不注意时换了位置',\n  },\n  {\n    type: HorrorEventType.REGISTER_ANOMALY,\n    level: HorrorLevel.ENVIRONMENT,\n    baseProbability: 0.10,\n    minDay: 1, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 4000, maxActiveDuration: 8000,\n    buildupDuration: 800, resolveDuration: 1500,\n    sanityCost: 5, cooldownSec: 90,\n    description: '收银机自动打开/关上，或显示异常金额',\n  },\n  {\n    type: HorrorEventType.LIGHT_FLICKER,\n    level: HorrorLevel.ENVIRONMENT,\n    baseProbability: 0.20,\n    minDay: 1, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT_TRANSITION, GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 2000, maxActiveDuration: 5000,\n    buildupDuration: 500, resolveDuration: 800,\n    sanityCost: 4, cooldownSec: 45,\n    description: '某盏灯间歇性闪烁，频率逐渐加快',\n  },\n  {\n    type: HorrorEventType.TEMP_DROP,\n    level: HorrorLevel.ENVIRONMENT,\n    baseProbability: 0.12,\n    minDay: 1, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 5000, maxActiveDuration: 10000,\n    buildupDuration: 2000, resolveDuration: 1500,\n    sanityCost: 4, cooldownSec: 120,\n    description: '画面边缘出现霜冻效果，呼吸可见',\n  },\n  {\n    type: HorrorEventType.FRIDGE_NOISE,\n    level: HorrorLevel.ENVIRONMENT,\n    baseProbability: 0.15,\n    minDay: 1, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 2000, maxActiveDuration: 4000,\n    buildupDuration: 300, resolveDuration: 500,\n    sanityCost: 3, cooldownSec: 60,\n    description: '冰箱突然发出很大的嗡鸣，然后瞬间安静',\n  },\n  // Level 2: Entity\n  {\n    type: HorrorEventType.GHOST_CUSTOMER,\n    level: HorrorLevel.ENTITY,\n    baseProbability: 0.12,\n    minDay: 6, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 8000, maxActiveDuration: 15000,\n    buildupDuration: 3000, resolveDuration: 2000,\n    sanityCost: 10, cooldownSec: 180,\n    description: '一位半透明的顾客走进店里，若隐若现',\n  },\n  {\n    type: HorrorEventType.DUPLICATE_CUSTOMER,\n    level: HorrorLevel.ENTITY,\n    baseProbability: 0.08,\n    minDay: 8, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 10000, maxActiveDuration: 18000,\n    buildupDuration: 2000, resolveDuration: 3000,\n    sanityCost: 12, cooldownSec: 240,\n    description: '两个完全一样的顾客同时出现在店里',\n  },\n  {\n    type: HorrorEventType.SHADOW_MISALIGN,\n    level: HorrorLevel.ENTITY,\n    baseProbability: 0.10,\n    minDay: 6, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 6000, maxActiveDuration: 12000,\n    buildupDuration: 1500, resolveDuration: 1000,\n    sanityCost: 8, cooldownSec: 150,\n    description: '你的影子角度不对，或者有自己的动作',\n  },\n  {\n    type: HorrorEventType.NEW_PRODUCT,\n    level: HorrorLevel.ENTITY,\n    baseProbability: 0.08,\n    minDay: 7, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 6000, maxActiveDuration: 10000,\n    buildupDuration: 0, resolveDuration: 500,\n    sanityCost: 7, cooldownSec: 200,\n    description: '货架上出现了你没进过货的商品，包装文字无法辨认',\n  },\n  // Level 3: Threat\n  {\n    type: HorrorEventType.DOOR_AUTO_OPEN,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.10,\n    minDay: 16, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 5000, maxActiveDuration: 8000,\n    buildupDuration: 1000, resolveDuration: 2000,\n    sanityCost: 15, cooldownSec: 180,\n    description: '前门或后门自己打开，外面是完全的黑暗',\n  },\n  {\n    type: HorrorEventType.BLOOD_ON_SHELF,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.08,\n    minDay: 18, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 8000, maxActiveDuration: 12000,\n    buildupDuration: 2000, resolveDuration: 3000,\n    sanityCost: 18, cooldownSec: 240,\n    description: '某个货架上出现暗红色液体缓缓渗出',\n  },\n  {\n    type: HorrorEventType.NONPAYING_CUSTOMER,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.10,\n    minDay: 16, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 10000, maxActiveDuration: 20000,\n    buildupDuration: 3000, resolveDuration: 1000,\n    sanityCost: 14, cooldownSec: 200,\n    description: '一个顾客拿了东西不走，也不付钱，只是盯着你看',\n  },\n  {\n    type: HorrorEventType.WHISPER,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.12,\n    minDay: 16, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 4000, maxActiveDuration: 8000,\n    buildupDuration: 2000, resolveDuration: 500,\n    sanityCost: 12, cooldownSec: 120,\n    description: '耳边传来低语声，听不清在说什么',\n  },\n  // Level 4: Existential\n  {\n    type: HorrorEventType.STORE_MUTATE,\n    level: HorrorLevel.EXISTENTIAL,\n    baseProbability: 0.06,\n    minDay: 26, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 10000, maxActiveDuration: 20000,\n    buildupDuration: 3000, resolveDuration: 5000,\n    sanityCost: 25, cooldownSec: 300,\n    description: '店铺结构开始改变，墙壁在移动',\n  },\n  {\n    type: HorrorEventType.TIME_GLITCH,\n    level: HorrorLevel.EXISTENTIAL,\n    baseProbability: 0.05,\n    minDay: 26, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 5000, maxActiveDuration: 8000,\n    buildupDuration: 1000, resolveDuration: 2000,\n    sanityCost: 20, cooldownSec: 300,\n    description: '时钟突然倒转，时间出现异常',\n  },\n  // Level 3: Threat (new M5 events)\n  {\n    type: HorrorEventType.STALKER,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.08,\n    minDay: 16, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 12000, maxActiveDuration: 20000,\n    buildupDuration: 2000, resolveDuration: 3000,\n    sanityCost: 16, cooldownSec: 240,\n    description: '后巷监控中有个身影，每次查看都更近了',\n  },\n  {\n    type: HorrorEventType.CCTV_DOUBLE,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.07,\n    minDay: 18, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 8000, maxActiveDuration: 15000,\n    buildupDuration: 1500, resolveDuration: 2000,\n    sanityCost: 18, cooldownSec: 300,\n    description: '监控画面出现了\"你\"，但你不在那个位置',\n  },\n  {\n    type: HorrorEventType.CORRIDOR_EXTEND,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.06,\n    minDay: 20, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 10000, maxActiveDuration: 18000,\n    buildupDuration: 3000, resolveDuration: 4000,\n    sanityCost: 20, cooldownSec: 360,\n    description: '通向仓库的走廊变长了，尽头多了一扇门',\n  },\n  {\n    type: HorrorEventType.RADIO_VOICE,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.07,\n    minDay: 16, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 8000, maxActiveDuration: 12000,\n    buildupDuration: 1500, resolveDuration: 1000,\n    sanityCost: 14, cooldownSec: 180,\n    description: '收音机里传出前任店员的声音',\n  },\n  // Level 4: Existential (new M5 events)\n  {\n    type: HorrorEventType.MIRROR_STORE,\n    level: HorrorLevel.EXISTENTIAL,\n    baseProbability: 0.04,\n    minDay: 26, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 15000, maxActiveDuration: 25000,\n    buildupDuration: 3000, resolveDuration: 5000,\n    sanityCost: 28, cooldownSec: 600,\n    description: '你进入了镜像便利店，一切左右翻转',\n  },\n  {\n    type: HorrorEventType.HE_COMES,\n    level: HorrorLevel.EXISTENTIAL,\n    baseProbability: 0.05,\n    minDay: 26, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 30000, maxActiveDuration: 30000,\n    buildupDuration: 5000, resolveDuration: 3000,\n    sanityCost: 30, cooldownSec: 600,\n    description: '\"他\"来了——30秒不可阻挡的缓慢接近',\n  },\n  {\n    type: HorrorEventType.FINAL_CHOICE,\n    level: HorrorLevel.EXISTENTIAL,\n    baseProbability: 0.03,\n    minDay: 29, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 0, maxActiveDuration: 0,\n    buildupDuration: 3000, resolveDuration: 5000,\n    sanityCost: 25, cooldownSec: 9999,\n    description: '基于之前选择的最终决定时刻',\n  },\n];\n\n// --- Visual Effect State ---\n\nexport interface HorrorVisualState {\n  // Global\n  frostIntensity: number;      // 0-1, frost on edges\n  darknessBoost: number;       // 0-0.5, extra darkness\n  screenShake: number;         // shake intensity\n  chromaticAberration: number; // 0-1\n  vignetteIntensity: number;   // 0-1\n\n  // Specific\n  flickeringLightIndex: number; // which light is flickering (-1 = none)\n  flickerIntensity: number;     // 0-1\n\n  bloodPositions: Array<{ x: number; y: number; size: number; alpha: number }>;\n  ghostEntity: {\n    active: boolean;\n    x: number;\n    y: number;\n    opacity: number;\n    type: 'ghost_customer' | 'duplicate' | 'nonpaying' | 'shadow';\n  } | null;\n  doorState: {\n    frontOpen: boolean;\n    backOpen: boolean;\n  };\n  timeGlitchActive: boolean;\n  storeMutateOffset: { x: number; y: number };\n  whisperActive: boolean;\n\n  // Level 3 new\n  stalkerPosition: { x: number; y: number; distance: number } | null;\n  cctvGlitchActive: boolean;\n  corridorStretch: number; // 0-1 how much the corridor extends\n  radioDistortion: number; // 0-1\n\n  // Level 4 new\n  mirrorActive: boolean;\n  mirrorFlipX: boolean;\n  heComesActive: boolean;\n  heComesProgress: number; // 0-1 how close \"he\" is\n  finalChoiceActive: boolean;\n\n  // Atmosphere\n  ambientFear: number; // 0-1 overall fear level\n  recentHighFearCount: number; // for fear regulation\n}\n\nexport function createDefaultVisualState(): HorrorVisualState {\n  return {\n    frostIntensity: 0,\n    darknessBoost: 0,\n    screenShake: 0,\n    chromaticAberration: 0,\n    vignetteIntensity: 0.3,\n    flickeringLightIndex: -1,\n    flickerIntensity: 0,\n    bloodPositions: [],\n    ghostEntity: null,\n    doorState: { frontOpen: false, backOpen: false },\n    timeGlitchActive: false,\n    storeMutateOffset: { x: 0, y: 0 },\n    whisperActive: false,\n    stalkerPosition: null,\n    cctvGlitchActive: false,\n    corridorStretch: 0,\n    radioDistortion: 0,\n    mirrorActive: false,\n    mirrorFlipX: false,\n    heComesActive: false,\n    heComesProgress: 0,\n    finalChoiceActive: false,\n    ambientFear: 0,\n    recentHighFearCount: 0,\n  };\n}\n\n// --- Manager ---\n\nexport class HorrorEventManager {\n  private activeEvents: HorrorEventInstance[] = [];\n  private cooldowns: Map<HorrorEventType, number> = new Map();\n  private visual: HorrorVisualState = createDefaultVisualState();\n  private checkInterval = 5000; // check every 5 seconds\n  private checkTimer = 0;\n  private dayAccumulatedSanityCost = 0;\n  private maxSanityCostPerNight = 40;\n  private eventCounter = 0;\n  private maxConcurrentEvents = 3;\n\n  // Callbacks\n  onEventTrigger?: (event: HorrorEventInstance) => void;\n  onSanityChange?: (delta: number) => void;\n  onNotification?: (text: string) => void;\n\n  get visuals(): HorrorVisualState { return this.visual; }\n  get activeEventCount(): number { return this.activeEvents.length; }\n\n  update(dt: number, day: number, phase: GamePhase, timeOfDay: number, sanity: number): HorrorVisualState {\n    const dtSec = dt / 1000;\n\n    // Update cooldowns\n    for (const [type, cd] of this.cooldowns) {\n      if (cd > 0) this.cooldowns.set(type, Math.max(0, cd - dtSec));\n    }\n\n    // Check for new events only at night\n    if (isNightTime(phase) && this.activeEvents.length < this.maxConcurrentEvents) {\n      this.checkTimer += dt;\n      if (this.checkTimer >= this.checkInterval) {\n        this.checkTimer = 0;\n        this.tryTriggerEvents(day, phase, sanity);\n      }\n    }\n\n    // Update active events\n    this.updateActiveEvents(dt);\n\n    // Decay visual effects toward baseline\n    this.decayVisuals(dtSec);\n\n    // Calculate ambient fear\n    this.updateAmbientFear(day, phase, timeOfDay);\n\n    return this.visual;\n  }\n\n  private tryTriggerEvents(day: number, phase: GamePhase, sanity: number): void {\n    for (const def of EVENT_DEFS) {\n      if (this.activeEvents.length >= this.maxConcurrentEvents) break;\n      if (this.activeEvents.some(e => e.type === def.type)) continue;\n      if (day < def.minDay || day > def.maxDay) continue;\n      if (!def.phaseRequired.includes(phase)) continue;\n\n      const cd = this.cooldowns.get(def.type) ?? 0;\n      if (cd > 0) continue;\n\n      // Fear regulation: reduce probability if recent high fear\n      let probabilityMod = 1;\n      if (this.visual.recentHighFearCount >= 2 && def.level >= HorrorLevel.THREAT) {\n        probabilityMod = 0.2; // big reduction after consecutive high fear\n      }\n\n      // Sanity affects: lower sanity = slightly less events (overwhelmed player)\n      if (sanity < 30) probabilityMod *= 0.5;\n\n      // Night depth increases probability\n      const nightDepth = phase === GamePhase.DANGER ? 1.5 : 1;\n      probabilityMod *= nightDepth;\n\n      // Day progression increases probability\n      const dayProgress = Math.min(day / 15, 2);\n      probabilityMod *= dayProgress;\n\n      const roll = Math.random();\n      if (roll < def.baseProbability * probabilityMod) {\n        this.triggerEvent(def);\n      }\n    }\n  }\n\n  private triggerEvent(def: HorrorEventDef): void {\n    const id = `horror_${++this.eventCounter}_${Date.now()}`;\n    const event: HorrorEventInstance = {\n      id,\n      type: def.type,\n      level: def.level,\n      state: HorrorEventState.BUILDUP,\n      timer: 0,\n      duration: def.minActiveDuration + Math.random() * (def.maxActiveDuration - def.minActiveDuration),\n      buildupDuration: def.buildupDuration,\n      resolveDuration: def.resolveDuration,\n      data: {},\n      sanityCost: def.sanityCost,\n    };\n\n    // Randomize specific data\n    event.data = this.generateEventData(def);\n\n    this.activeEvents.push(event);\n    this.cooldowns.set(def.type, def.cooldownSec);\n\n    if (def.level >= HorrorLevel.THREAT) {\n      this.visual.recentHighFearCount++;\n    }\n\n    this.onEventTrigger?.(event);\n    this.onNotification?.(`⚠ ${def.description}`);\n  }\n\n  private generateEventData(def: HorrorEventDef): Record<string, unknown> {\n    switch (def.type) {\n      case HorrorEventType.SHELF_SHIFT:\n        return { shelfIndex: Math.floor(Math.random() * 5) };\n      case HorrorEventType.LIGHT_FLICKER:\n        return { lightIndex: Math.floor(Math.random() * 8) };\n      case HorrorEventType.REGISTER_ANOMALY:\n        return { registerIndex: Math.floor(Math.random() * 2), anomalyAmount: Math.floor(Math.random() * 9999) };\n      case HorrorEventType.BLOOD_ON_SHELF: {\n        const positions = [];\n        const count = 2 + Math.floor(Math.random() * 4);\n        for (let i = 0; i < count; i++) {\n          positions.push({\n            x: 100 + Math.random() * 600,\n            y: 100 + Math.random() * 400,\n            size: 8 + Math.random() * 20,\n            alpha: 0.3 + Math.random() * 0.5,\n          });\n        }\n        return { positions };\n      }\n      case HorrorEventType.GHOST_CUSTOMER:\n        return { startX: Math.random() * 400 + 100, startY: 50, opacity: 0 };\n      case HorrorEventType.DUPLICATE_CUSTOMER:\n        return { x1: 200 + Math.random() * 200, x2: 400 + Math.random() * 200, y: 200 + Math.random() * 100 };\n      case HorrorEventType.NONPAYING_CUSTOMER:\n        return { x: 300 + Math.random() * 200, y: 150 + Math.random() * 100 };\n      case HorrorEventType.DOOR_AUTO_OPEN:\n        return { door: Math.random() < 0.5 ? 'front' : 'back' };\n      case HorrorEventType.STALKER:\n        return { startX: 400 + Math.random() * 200, startY: 200, distance: 300 + Math.random() * 200, checkCount: 0 };\n      case HorrorEventType.CCTV_DOUBLE:\n        return { glitchX: 200 + Math.random() * 400, glitchY: 100 + Math.random() * 200 };\n      case HorrorEventType.CORRIDOR_EXTEND:\n        return { extraDoors: 1 + Math.floor(Math.random() * 2), stretchAmount: 1.5 + Math.random() };\n      case HorrorEventType.RADIO_VOICE:\n        return { frequency: 88 + Math.random() * 20, voiceType: Math.floor(Math.random() * 3) };\n      case HorrorEventType.MIRROR_STORE:\n        return { flipAxis: 'x' as const };\n      case HorrorEventType.HE_COMES:\n        return { startX: 450, startY: 24 * 32, speed: 0.7 + Math.random() * 0.3 };\n      case HorrorEventType.FINAL_CHOICE:\n        return { choiceType: Math.floor(Math.random() * 3) };\n      default:\n        return {};\n    }\n  }\n\n  private updateActiveEvents(dt: number): void {\n    const completed: string[] = [];\n\n    for (const event of this.activeEvents) {\n      event.timer += dt;\n\n      switch (event.state) {\n        case HorrorEventState.BUILDUP:\n          this.applyBuildupEffect(event, event.timer / event.buildupDuration);\n          if (event.timer >= event.buildupDuration) {\n            event.state = HorrorEventState.ACTIVE;\n            event.timer = 0;\n            this.applyActiveEffect(event);\n            this.onSanityChange?.(-event.sanityCost);\n            this.dayAccumulatedSanityCost += event.sanityCost;\n          }\n          break;\n\n        case HorrorEventState.ACTIVE:\n          this.sustainActiveEffect(event, event.timer / event.duration);\n          if (event.timer >= event.duration) {\n            event.state = HorrorEventState.RESOLVING;\n            event.timer = 0;\n            this.beginResolve(event);\n          }\n          break;\n\n        case HorrorEventState.RESOLVING:\n          this.applyResolveEffect(event, event.timer / event.resolveDuration);\n          if (event.timer >= event.resolveDuration) {\n            event.state = HorrorEventState.COMPLETE;\n            completed.push(event.id);\n            this.clearEventEffects(event);\n          }\n          break;\n      }\n    }\n\n    for (const id of completed) {\n      this.activeEvents = this.activeEvents.filter(e => e.id !== id);\n    }\n  }\n\n  // --- Buildup Effects (预兆) ---\n\n  private applyBuildupEffect(event: HorrorEventInstance, progress: number): void {\n    const p = Math.min(1, progress);\n    switch (event.type) {\n      case HorrorEventType.LIGHT_FLICKER:\n        this.visual.flickeringLightIndex = (event.data.lightIndex as number) ?? 0;\n        this.visual.flickerIntensity = p * 0.3;\n        break;\n      case HorrorEventType.TEMP_DROP:\n        this.visual.frostIntensity = p * 0.2;\n        break;\n      case HorrorEventType.BLOOD_ON_SHELF:\n        this.visual.darknessBoost = p * 0.1;\n        break;\n      case HorrorEventType.WHISPER:\n        this.visual.whisperActive = true;\n        break;\n      case HorrorEventType.GHOST_CUSTOMER:\n      case HorrorEventType.DUPLICATE_CUSTOMER:\n      case HorrorEventType.NONPAYING_CUSTOMER:\n        this.visual.vignetteIntensity = Math.min(1, 0.3 + p * 0.3);\n        break;\n      case HorrorEventType.DOOR_AUTO_OPEN:\n        this.visual.screenShake = p * 0.3;\n        break;\n      case HorrorEventType.STALKER:\n        this.visual.vignetteIntensity = Math.min(1, 0.3 + p * 0.4);\n        break;\n      case HorrorEventType.CCTV_DOUBLE:\n        this.visual.chromaticAberration = p * 0.2;\n        break;\n      case HorrorEventType.CORRIDOR_EXTEND:\n        this.visual.corridorStretch = p * 0.3;\n        break;\n      case HorrorEventType.RADIO_VOICE:\n        this.visual.radioDistortion = p * 0.3;\n        break;\n      case HorrorEventType.MIRROR_STORE:\n        this.visual.chromaticAberration = p * 0.4;\n        break;\n      case HorrorEventType.HE_COMES:\n        this.visual.vignetteIntensity = Math.min(1, 0.4 + p * 0.5);\n        this.visual.darknessBoost = p * 0.2;\n        break;\n      case HorrorEventType.FINAL_CHOICE:\n        this.visual.chromaticAberration = p * 0.5;\n        this.visual.vignetteIntensity = Math.min(1, 0.5 + p * 0.5);\n        break;\n      case HorrorEventType.STORE_MUTATE:\n        this.visual.chromaticAberration = p * 0.3;\n        break;\n      default:\n        this.visual.darknessBoost = p * 0.05;\n        break;\n    }\n  }\n\n  // --- Active Effects ---\n\n  private applyActiveEffect(event: HorrorEventInstance): void {\n    switch (event.type) {\n      case HorrorEventType.LIGHT_FLICKER:\n        this.visual.flickerIntensity = 0.8;\n        break;\n      case HorrorEventType.TEMP_DROP:\n        this.visual.frostIntensity = 0.6;\n        this.visual.vignetteIntensity = 0.7;\n        break;\n      case HorrorEventType.FRIDGE_NOISE:\n        this.visual.screenShake = 0.5;\n        break;\n      case HorrorEventType.BLOOD_ON_SHELF:\n        this.visual.bloodPositions = (event.data.positions as Array<{ x: number; y: number; size: number; alpha: number }>) ?? [];\n        break;\n      case HorrorEventType.GHOST_CUSTOMER:\n        this.visual.ghostEntity = {\n          active: true,\n          x: (event.data.startX as number) ?? 300,\n          y: (event.data.startY as number) ?? 50,\n          opacity: 0.4,\n          type: 'ghost_customer',\n        };\n        break;\n      case HorrorEventType.DUPLICATE_CUSTOMER:\n        this.visual.ghostEntity = {\n          active: true,\n          x: (event.data.x1 as number) ?? 200,\n          y: (event.data.y as number) ?? 200,\n          opacity: 0.8,\n          type: 'duplicate',\n        };\n        break;\n      case HorrorEventType.NONPAYING_CUSTOMER:\n        this.visual.ghostEntity = {\n          active: true,\n          x: (event.data.x as number) ?? 300,\n          y: (event.data.y as number) ?? 150,\n          opacity: 0.9,\n          type: 'nonpaying',\n        };\n        break;\n      case HorrorEventType.DOOR_AUTO_OPEN:\n        if ((event.data.door as string) === 'front') {\n          this.visual.doorState.frontOpen = true;\n        } else {\n          this.visual.doorState.backOpen = true;\n        }\n        this.visual.darknessBoost = 0.3;\n        this.visual.screenShake = 0.8;\n        break;\n      case HorrorEventType.WHISPER:\n        this.visual.whisperActive = true;\n        this.visual.vignetteIntensity = 0.8;\n        break;\n      case HorrorEventType.STORE_MUTATE:\n        this.visual.storeMutateOffset = { x: (Math.random() - 0.5) * 10, y: (Math.random() - 0.5) * 10 };\n        this.visual.chromaticAberration = 0.8;\n        this.visual.screenShake = 0.4;\n        break;\n      case HorrorEventType.TIME_GLITCH:\n        this.visual.timeGlitchActive = true;\n        this.visual.chromaticAberration = 0.6;\n        break;\n      case HorrorEventType.STALKER:\n        this.visual.stalkerPosition = {\n          x: (event.data.startX as number) ?? 400,\n          y: (event.data.startY as number) ?? 200,\n          distance: (event.data.distance as number) ?? 300,\n        };\n        this.visual.vignetteIntensity = 0.8;\n        break;\n      case HorrorEventType.CCTV_DOUBLE:\n        this.visual.cctvGlitchActive = true;\n        this.visual.chromaticAberration = 0.5;\n        this.visual.screenShake = 0.3;\n        break;\n      case HorrorEventType.CORRIDOR_EXTEND:\n        this.visual.corridorStretch = 1;\n        this.visual.darknessBoost = 0.3;\n        this.visual.screenShake = 0.2;\n        break;\n      case HorrorEventType.RADIO_VOICE:\n        this.visual.radioDistortion = 1;\n        this.visual.whisperActive = true;\n        break;\n      case HorrorEventType.MIRROR_STORE:\n        this.visual.mirrorActive = true;\n        this.visual.mirrorFlipX = true;\n        this.visual.chromaticAberration = 0.8;\n        this.visual.screenShake = 0.4;\n        break;\n      case HorrorEventType.HE_COMES:\n        this.visual.heComesActive = true;\n        this.visual.heComesProgress = 0;\n        this.visual.darknessBoost = 0.5;\n        this.visual.vignetteIntensity = 1;\n        this.visual.screenShake = 0.6;\n        break;\n      case HorrorEventType.FINAL_CHOICE:\n        this.visual.finalChoiceActive = true;\n        this.visual.chromaticAberration = 1;\n        this.visual.vignetteIntensity = 1;\n        break;\n      default:\n        this.visual.darknessBoost = 0.15;\n        break;\n    }\n  }\n\n  private sustainActiveEffect(event: HorrorEventInstance, progress: number): void {\n    // Pulsing effects during sustain\n    const pulse = Math.sin(progress * Math.PI * 4) * 0.5 + 0.5;\n\n    switch (event.type) {\n      case HorrorEventType.LIGHT_FLICKER:\n        this.visual.flickerIntensity = 0.4 + pulse * 0.5;\n        break;\n      case HorrorEventType.FRIDGE_NOISE:\n        this.visual.screenShake = 0.2 + pulse * 0.3;\n        break;\n      case HorrorEventType.GHOST_CUSTOMER:\n        if (this.visual.ghostEntity) {\n          this.visual.ghostEntity.opacity = 0.2 + pulse * 0.4;\n          this.visual.ghostEntity.y += 0.1;\n        }\n        break;\n      case HorrorEventType.STORE_MUTATE: {\n        const t = performance.now() * 0.001;\n        this.visual.storeMutateOffset = {\n          x: Math.sin(t * 0.5) * 8,\n          y: Math.cos(t * 0.7) * 5,\n        };\n        break;\n      }\n      case HorrorEventType.TIME_GLITCH:\n        this.visual.chromaticAberration = 0.3 + pulse * 0.5;\n        break;\n      case HorrorEventType.STALKER:\n        if (this.visual.stalkerPosition) {\n          this.visual.stalkerPosition.distance = Math.max(50, (this.visual.stalkerPosition.distance ?? 300) - 0.5);\n        }\n        break;\n      case HorrorEventType.CCTV_DOUBLE:\n        this.visual.chromaticAberration = 0.3 + pulse * 0.4;\n        break;\n      case HorrorEventType.CORRIDOR_EXTEND:\n        this.visual.corridorStretch = 0.8 + pulse * 0.2;\n        break;\n      case HorrorEventType.HE_COMES:\n        this.visual.heComesProgress = Math.min(1, progress);\n        this.visual.darknessBoost = 0.3 + progress * 0.4;\n        this.visual.screenShake = 0.3 + progress * 0.5;\n        break;\n      case HorrorEventType.FINAL_CHOICE:\n        this.visual.chromaticAberration = 0.5 + pulse * 0.5;\n        break;\n      default:\n        break;\n    }\n  }\n\n  // --- Resolve Effects ---\n\n  private beginResolve(event: HorrorEventInstance): void {\n    switch (event.type) {\n      case HorrorEventType.FRIDGE_NOISE:\n        // Sudden silence is scarier\n        this.visual.screenShake = 0;\n        break;\n      default:\n        break;\n    }\n  }\n\n  private applyResolveEffect(event: HorrorEventInstance, progress: number): void {\n    const p = Math.min(1, progress);\n    switch (event.type) {\n      case HorrorEventType.TEMP_DROP:\n        this.visual.frostIntensity *= (1 - p);\n        break;\n      case HorrorEventType.LIGHT_FLICKER:\n        this.visual.flickerIntensity *= (1 - p);\n        if (p >= 1) this.visual.flickeringLightIndex = -1;\n        break;\n      case HorrorEventType.BLOOD_ON_SHELF:\n        this.visual.bloodPositions = this.visual.bloodPositions.map(b => ({\n          ...b, alpha: b.alpha * (1 - p),\n        }));\n        break;\n      case HorrorEventType.GHOST_CUSTOMER:\n      case HorrorEventType.DUPLICATE_CUSTOMER:\n      case HorrorEventType.NONPAYING_CUSTOMER:\n        if (this.visual.ghostEntity) {\n          this.visual.ghostEntity.opacity *= (1 - p);\n        }\n        break;\n      case HorrorEventType.DOOR_AUTO_OPEN:\n        this.visual.doorState.frontOpen = false;\n        this.visual.doorState.backOpen = false;\n        this.visual.darknessBoost *= (1 - p);\n        break;\n      case HorrorEventType.STORE_MUTATE:\n        this.visual.storeMutateOffset.x *= (1 - p);\n        this.visual.storeMutateOffset.y *= (1 - p);\n        this.visual.chromaticAberration *= (1 - p);\n        break;\n      case HorrorEventType.TIME_GLITCH:\n        if (p >= 0.8) this.visual.timeGlitchActive = false;\n        this.visual.chromaticAberration *= (1 - p);\n        break;\n      case HorrorEventType.STALKER:\n        if (this.visual.stalkerPosition) {\n          this.visual.stalkerPosition.distance *= (1 - p * 0.5);\n        }\n        if (p >= 1) this.visual.stalkerPosition = null;\n        break;\n      case HorrorEventType.CCTV_DOUBLE:\n        this.visual.chromaticAberration *= (1 - p);\n        if (p >= 1) this.visual.cctvGlitchActive = false;\n        break;\n      case HorrorEventType.CORRIDOR_EXTEND:\n        this.visual.corridorStretch *= (1 - p);\n        break;\n      case HorrorEventType.RADIO_VOICE:\n        this.visual.radioDistortion *= (1 - p);\n        if (p >= 0.5) this.visual.whisperActive = false;\n        break;\n      case HorrorEventType.MIRROR_STORE:\n        this.visual.chromaticAberration *= (1 - p);\n        if (p >= 1) {\n          this.visual.mirrorActive = false;\n          this.visual.mirrorFlipX = false;\n        }\n        break;\n      case HorrorEventType.HE_COMES:\n        this.visual.darknessBoost *= (1 - p);\n        this.visual.screenShake *= (1 - p);\n        if (p >= 1) {\n          this.visual.heComesActive = false;\n          this.visual.heComesProgress = 0;\n        }\n        break;\n      case HorrorEventType.FINAL_CHOICE:\n        this.visual.chromaticAberration *= (1 - p);\n        if (p >= 1) this.visual.finalChoiceActive = false;\n        break;\n      default:\n        break;\n    }\n  }\n\n  private clearEventEffects(event: HorrorEventInstance): void {\n    switch (event.type) {\n      case HorrorEventType.GHOST_CUSTOMER:\n      case HorrorEventType.DUPLICATE_CUSTOMER:\n      case HorrorEventType.NONPAYING_CUSTOMER:\n        this.visual.ghostEntity = null;\n        break;\n      case HorrorEventType.BLOOD_ON_SHELF:\n        this.visual.bloodPositions = [];\n        break;\n      case HorrorEventType.WHISPER:\n        this.visual.whisperActive = false;\n        break;\n      case HorrorEventType.TIME_GLITCH:\n        this.visual.timeGlitchActive = false;\n        break;\n      case HorrorEventType.STALKER:\n        this.visual.stalkerPosition = null;\n        break;\n      case HorrorEventType.CCTV_DOUBLE:\n        this.visual.cctvGlitchActive = false;\n        break;\n      case HorrorEventType.CORRIDOR_EXTEND:\n        this.visual.corridorStretch = 0;\n        break;\n      case HorrorEventType.RADIO_VOICE:\n        this.visual.radioDistortion = 0;\n        this.visual.whisperActive = false;\n        break;\n      case HorrorEventType.MIRROR_STORE:\n        this.visual.mirrorActive = false;\n        this.visual.mirrorFlipX = false;\n        break;\n      case HorrorEventType.HE_COMES:\n        this.visual.heComesActive = false;\n        this.visual.heComesProgress = 0;\n        break;\n      case HorrorEventType.FINAL_CHOICE:\n        this.visual.finalChoiceActive = false;\n        break;\n      default:\n        break;\n    }\n  }\n\n  private decayVisuals(dtSec: number): void {\n    const decay = dtSec * 0.5;\n    this.visual.screenShake = Math.max(0, this.visual.screenShake - decay);\n    this.visual.darknessBoost = Math.max(0, this.visual.darknessBoost - decay * 0.1);\n    if (this.visual.flickeringLightIndex === -1) {\n      this.visual.flickerIntensity = Math.max(0, this.visual.flickerIntensity - decay * 0.2);\n    }\n  }\n\n  private updateAmbientFear(day: number, phase: GamePhase, timeOfDay: number): void {\n    let target = 0;\n\n    if (isNightTime(phase)) {\n      target = 0.3;\n      if (phase === GamePhase.NIGHT) target = 0.5;\n      if (phase === GamePhase.DANGER) target = 0.8;\n\n      // Day progression\n      target *= Math.min(1 + (day - 1) * 0.05, 2);\n\n      // Active events boost fear\n      target += this.activeEvents.length * 0.1;\n    }\n\n    this.visual.ambientFear += (target - this.visual.ambientFear) * 0.02;\n  }\n\n  // --- Public API ---\n\n  /** Reset daily state when new day begins */\n  resetDaily(): void {\n    this.dayAccumulatedSanityCost = 0;\n    this.visual.recentHighFearCount = 0;\n    this.activeEvents = [];\n    this.visual = createDefaultVisualState();\n  }\n\n  /** Get the maximum event level available for current day */\n  getMaxLevel(day: number): HorrorLevel {\n    if (day >= 26) return HorrorLevel.EXISTENTIAL;\n    if (day >= 16) return HorrorLevel.THREAT;\n    if (day >= 6) return HorrorLevel.ENTITY;\n    return HorrorLevel.ENVIRONMENT;\n  }\n\n  /** Get active events for display */\n  getActiveEvents(): ReadonlyArray<HorrorEventInstance> {\n    return this.activeEvents;\n  }\n\n  /** Get save data */\n  getSaveData(): Record<string, unknown> {\n    return {\n      eventCounter: this.eventCounter,\n      dayAccumulatedSanityCost: this.dayAccumulatedSanityCost,\n    };\n  }\n\n  /** Load save data */\n  loadSaveData(data: Record<string, unknown>): void {\n    this.eventCounter = (data.eventCounter as number) ?? 0;\n    this.dayAccumulatedSanityCost = (data.dayAccumulatedSanityCost as number) ?? 0;\n  }\n}\n","numLines":1033,"startLine":1,"totalLines":1033}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_d9dbaa9996d34241b505f608","type":"tool_result","content":"1\t// App.ts — Game main loop + state machine (v0.6.0 — M6: Narrative System)\n2\t\n3\timport { Renderer } from './Renderer';\n4\timport { StoreMap, TILE_SIZE, T } from '../game/StoreMap';\n5\timport { Player } from '../game/Player';\n6\timport {\n7\t  type GameState,\n8\t  type Interactable,\n9\t  type LightSource,\n10\t  GamePhase,\n11\t  UIPanel,\n12\t  createInitialState,\n13\t  loadGame,\n14\t  saveGame,\n15\t  startAutoSave,\n16\t  stopAutoSave,\n17\t  getPhaseFromTime,\n18\t  cloneState,\n19\t  isNightTime,\n20\t} from '../game/GameState';\n21\timport { ProductManager } from '../game/ProductManager';\n22\timport { CustomerManager } from '../game/CustomerManager';\n23\timport { CashRegister } from '../game/CashRegister';\n24\timport { PricingSystem } from '../game/PricingSystem';\n25\timport { EconomySystem } from '../game/EconomySystem';\n26\timport { ShelfInteraction, ShelfAction } from '../game/ShelfInteraction';\n27\timport { Customer, CustomerState } from '../game/Customer';\n28\timport { DayCycle } from '../game/DayCycle';\n29\timport { DaySummaryManager } from '../game/DaySummary';\n30\timport { UpgradeManager } from '../game/UpgradeManager';\n31\timport { SaveManager } from '../game/SaveManager';\n32\timport { HorrorEventManager, HorrorEventType } from '../game/HorrorEventManager';\n33\timport { AudioManager } from '../game/AudioManager';\n34\timport { NPCManager } from '../game/BehaviorTree';\n35\timport { JumpScareManager } from '../game/JumpScareManager';\n36\timport { ClueManager } from '../game/ClueManager';\n37\timport { StoryManager } from '../game/StoryManager';\n38\timport { EndingSystem } from '../game/EndingSystem';\n39\timport { RadioManager } from '../game/RadioManager';\n40\timport { NoteManager } from '../game/NoteManager';\n41\timport { NarrativeChoiceManager } from '../game/NarrativeChoiceManager';\n42\t\n43\texport class App {\n44\t  canvas: HTMLCanvasElement;\n45\t  renderer: Renderer;\n46\t  state: GameState;\n47\t  map: StoreMap;\n48\t  player: Player;\n49\t\n50\t  // M2 systems\n51\t  productManager: ProductManager;\n52\t  customerManager: CustomerManager;\n53\t  registers: CashRegister[];\n54\t  pricing: PricingSystem;\n55\t  economy: EconomySystem;\n56\t  shelfInteraction: ShelfInteraction;\n57\t\n58\t  // M3 systems\n59\t  dayCycle: DayCycle;\n60\t  daySummary: DaySummaryManager;\n61\t  upgradeManager: UpgradeManager;\n62\t  saveManager: SaveManager;\n63\t\n64\t  // M4 systems\n65\t  horrorManager: HorrorEventManager;\n66\t  audioManager: AudioManager;\n67\t\n68\t  // M5 systems\n69\t  npcManager: NPCManager;\n70\t  jumpScareManager: JumpScareManager;\n71\t\n72\t  // M6 systems\n73\t  clueManager: ClueManager;\n74\t  storyManager: StoryManager;\n75\t  endingSystem: EndingSystem;\n76\t  radioManager: RadioManager;\n77\t  noteManager: NoteManager;\n78\t  narrativeChoices: NarrativeChoiceManager;\n79\t\n80\t  private running = false;\n81\t  private lastFrameTime = 0;\n82\t  private animFrameId = 0;\n83\t  private activeCustomers: Customer[] = [];\n84\t  private lastTransactionNotification = '';\n85\t\n86\t  onStateChange?: (state: GameState) => void;\n87\t  onNotification?: (text: string) => void;\n88\t\n89\t  constructor(canvas: HTMLCanvasElement) {\n90\t    this.canvas = canvas;\n91\t    this.renderer = new Renderer(canvas);\n92\t\n93\t    const saved = loadGame();\n94\t    this.state = saved ? { ...createInitialState(), ...saved.gameState } : createInitialState();\n95\t\n96\t    this.map = new StoreMap();\n97\t    this.player = new Player(this.state.player);\n98\t    this.player.setupInput();\n99\t\n100\t    // Initialize M2 systems\n101\t    this.productManager = new ProductManager();\n102\t    this.customerManager = new CustomerManager();\n103\t    this.registers = [\n104\t      new CashRegister('register_1'),\n105\t      new CashRegister('register_2'),\n106\t    ];\n107\t    this.pricing = new PricingSystem(this.productManager);\n108\t    this.economy = new EconomySystem();\n109\t    this.shelfInteraction = new ShelfInteraction();\n110\t\n111\t    // Initialize M3 systems\n112\t    this.dayCycle = new DayCycle();\n113\t    this.daySummary = new DaySummaryManager();\n114\t    this.upgradeManager = new UpgradeManager();\n115\t    this.saveManager = new SaveManager();\n116\t\n117\t    // Initialize M4 systems\n118\t    this.horrorManager = new HorrorEventManager();\n119\t    this.audioManager = new AudioManager();\n120\t\n121\t    // Initialize M5 systems\n122\t    this.npcManager = new NPCManager();\n123\t    this.jumpScareManager = new JumpScareManager();\n124\t\n125\t    // Initialize M6 systems\n126\t    this.clueManager = new ClueManager();\n127\t    this.storyManager = new StoryManager(this.clueManager);\n128\t    this.endingSystem = new EndingSystem(this.storyManager, this.clueManager);\n129\t    this.radioManager = new RadioManager();\n130\t    this.noteManager = new NoteManager();\n131\t    this.narrativeChoices = new NarrativeChoiceManager();\n132\t\n133\t    // M6: Wire up callbacks\n134\t    this.storyManager.onNotification = (text) => this.addNotification(text);\n135\t    this.endingSystem.onNotification = (text) => this.addNotification(text);\n136\t    this.radioManager.onNotification = (text) => this.addNotification(text);\n137\t    this.radioManager.onClueGrant = (clueId) => {\n138\t      this.clueManager.discoverClue(clueId, this.state.day);\n139\t      this.syncNarrativeState();\n140\t    };\n141\t    this.noteManager.onNotification = (text) => this.addNotification(text);\n142\t    this.noteManager.onCluesGranted = (clueIds) => {\n143\t      for (const id of clueIds) {\n144\t        this.clueManager.discoverClue(id, this.state.day);\n145\t      }\n146\t      this.syncNarrativeState();\n147\t    };\n148\t    this.narrativeChoices.onNotification = (text) => this.addNotification(text);\n149\t    this.narrativeChoices.onSanityCost = (amount) => {\n150\t      this.state.player.sanity = Math.max(0, this.state.player.sanity - amount);\n151\t    };\n152\t    this.narrativeChoices.onClueGrant = (clueId) => {\n153\t      this.clueManager.discoverClue(clueId, this.state.day);\n154\t      this.syncNarrativeState();\n155\t    };\n156\t\n157\t    // Register systems with SaveManager\n158\t    this.saveManager.register('productManager', this.productManager);\n159\t    this.saveManager.register('economy', this.economy);\n160\t    this.saveManager.register('pricing', this.pricing);\n161\t    this.saveManager.register('customerManager', this.customerManager);\n162\t    this.saveManager.register('upgradeManager', this.upgradeManager);\n163\t    this.saveManager.register('daySummary', this.daySummary);\n164\t\n165\t    // Load save data for M2 systems\n166\t    if (saved) {\n167\t      if (saved.productManager && Object.keys(saved.productManager).length > 0) {\n168\t        this.productManager.loadSaveData(saved.productManager);\n169\t      }\n170\t      if (saved.economy && Object.keys(saved.economy).length > 0) {\n171\t        this.economy.loadSaveData(saved.economy);\n172\t      }\n173\t      if (saved.pricing && Object.keys(saved.pricing).length > 0) {\n174\t        this.pricing.loadSaveData(saved.pricing);\n175\t      }\n176\t      if (saved.customerStats && Object.keys(saved.customerStats).length > 0) {\n177\t        this.customerManager.loadSaveData(saved.customerStats);\n178\t      }\n179\t      if (saved.registers) {\n180\t        for (let i = 0; i < saved.registers.length && i < this.registers.length; i++) {\n181\t          this.registers[i].loadSaveData(saved.registers[i]);\n182\t        }\n183\t      }\n184\t\n185\t      // Restore M3 day cycle state\n186\t      this.dayCycle.setDay(this.state.day);\n187\t      this.dayCycle.setTimeOfDay(this.state.timeOfDay);\n188\t    }\n189\t\n190\t    // Apply purchased upgrades\n191\t    this.applyUpgrades();\n192\t\n193\t    // Setup interactable objects\n194\t    this.state.interactables = this.createInteractables();\n195\t    this.state.lights = this.createLights();\n196\t\n197\t    // Give some starting inventory\n198\t    if (!saved) {\n199\t      this.setupStartingInventory();\n200\t    }\n201\t\n202\t    // Setup day cycle event listeners\n203\t    this.dayCycle.onPhaseChange((phase, prev) => {\n204\t      this.state.phase = phase;\n205\t      this.onStateChange?.(this.state);\n206\t    });\n207\t\n208\t    this.dayCycle.onNewDay((day) => {\n209\t      this.onNewDay();\n210\t    });\n211\t\n212\t    // M4: Horror event callbacks\n213\t    this.horrorManager.onSanityChange = (delta) => {\n214\t      this.state.player.sanity = Math.max(0, Math.min(100, this.state.player.sanity + delta));\n215\t      this.state.fearLevel = Math.min(1, this.state.fearLevel + Math.abs(delta) / 100);\n216\t    };\n217\t    this.horrorManager.onNotification = (text) => {\n218\t      this.addNotification(text);\n219\t    };\n220\t    this.horrorManager.onEventTrigger = (event) => {\n221\t      this.state.horrorEventsTriggered++;\n222\t      this.state.lastHorrorEventDay = this.state.day;\n223\t      this.triggerHorrorAudio(event.type);\n224\t    };\n225\t\n226\t    // M5: Jump scare callbacks\n227\t    this.jumpScareManager.onSanityDrain = (amount) => {\n228\t      this.state.player.sanity = Math.max(0, this.state.player.sanity - amount);\n229\t      this.state.fearLevel = Math.min(1, this.state.fearLevel + amount / 100);\n230\t    };\n231\t    this.jumpScareManager.onMoneyLoss = (percent) => {\n232\t      const loss = this.state.dailyRevenue * percent;\n233\t      this.state.dailyRevenue = Math.max(0, this.state.dailyRevenue - loss);\n234\t      this.economy.addExpense(loss);\n235\t    };\n236\t    this.jumpScareManager.onNotification = (text) => {\n237\t      this.addNotification(text);\n238\t    };\n239\t    this.jumpScareManager.onScareTrigger = (scare) => {\n240\t      this.audioManager.playHorrorJumpScare();\n241\t      this.state.horrorEventsTriggered++;\n242\t    };\n243\t\n244\t    // M4: Phase change BGM switching\n245\t    this.dayCycle.onPhaseChange((phase) => {\n246\t      this.switchBgmForPhase(phase);\n247\t    });\n248\t\n249\t    // Snap camera to player immediately\n250\t    this.renderer.camera.snapTo(this.player.x + 16, this.player.y + 16);\n251\t\n252\t    // Setup keyboard shortcuts for panels\n253\t    this.setupPanelInput();\n254\t\n255\t    window.addEventListener('resize', () => {\n256\t      this.renderer.resize();\n257\t    });\n258\t  }\n259\t\n260\t  private setupStartingInventory(): void {\n261\t    this.productManager.addToInventory('water', 10, 1);\n262\t    this.productManager.addToInventory('cola', 8, 1);\n263\t    this.productManager.addToInventory('chips', 8, 1);\n264\t    this.productManager.addToInventory('biscuit', 6, 1);\n265\t    this.productManager.addToInventory('candy', 10, 1);\n266\t    this.productManager.addToInventory('bento_chicken', 4, 1);\n267\t    this.productManager.addToInventory('bento_veg', 4, 1);\n268\t    this.productManager.addToInventory('tissue', 5, 1);\n269\t    this.productManager.addToInventory('battery', 3, 1);\n270\t\n271\t    this.productManager.stockShelf('shelf_1', 'chips', 5);\n272\t    this.productManager.stockShelf('shelf_2', 'cola', 5);\n273\t    this.productManager.stockShelf('shelf_3', 'tissue', 5);\n274\t    this.productManager.stockShelf('fridge_1', 'water', 5);\n275\t    this.productManager.stockShelf('fridge_2', 'bento_chicken', 3);\n276\t  }\n277\t\n278\t  private applyUpgrades(): void {\n279\t    // M3 UpgradeManager effects\n280\t    this.renderer.lighting.setLightBoost(this.upgradeManager.getLightBoost());\n281\t\n282\t    if (this.upgradeManager.isPurchased('register_upgrade')) {\n283\t      this.registers.forEach(r => r.applySpeedUpgrade(0.3));\n284\t    }\n285\t    if (this.upgradeManager.isPurchased('warehouse_shelf')) {\n286\t      this.productManager.upgradeStorage(0.5);\n287\t    }\n288\t\n289\t    // Also apply economy system upgrades for backward compat\n290\t    if (this.economy.hasUpgrade('register_upgrade')) {\n291\t      this.registers.forEach(r => r.applySpeedUpgrade(0.3));\n292\t    }\n293\t    if (this.economy.hasUpgrade('warehouse_shelf')) {\n294\t      this.productManager.upgradeStorage(0.5);\n295\t    }\n296\t    if (this.economy.hasUpgrade('bright_lights')) {\n297\t      for (const light of this.state.lights) {\n298\t        light.intensity = Math.min(1, light.intensity * 1.5);\n299\t        light.radius *= 1.3;\n300\t      }\n301\t    }\n302\t  }\n303\t\n304\t  private setupPanelInput(): void {\n305\t    window.addEventListener('keydown', (e) => {\n306\t      // Dismiss day summary on any key\n307\t      if (this.daySummary.isVisible) {\n308\t        this.daySummary.dismiss();\n309\t        e.preventDefault();\n310\t        return;\n311\t      }\n312\t\n313\t      if (e.key === 'Escape') {\n314\t        if (this.state.activePanel !== UIPanel.NONE) {\n315\t          this.state.activePanel = UIPanel.NONE;\n316\t          this.shelfInteraction.close();\n317\t          e.preventDefault();\n318\t        }\n319\t      }\n320\t      if (e.key === 'i' || e.key === 'I') {\n321\t        this.togglePanel(UIPanel.INVENTORY);\n322\t        e.preventDefault();\n323\t      }\n324\t      if (e.key === 'p' || e.key === 'P') {\n325\t        this.togglePanel(UIPanel.PRICING);\n326\t        e.preventDefault();\n327\t      }\n328\t      if (e.key === 'u' || e.key === 'U') {\n329\t        this.togglePanel(UIPanel.SHOP);\n330\t        e.preventDefault();\n331\t      }\n332\t      if (e.key === 'o' || e.key === 'O') {\n333\t        this.togglePanel(UIPanel.SUPPLIER);\n334\t        e.preventDefault();\n335\t      }\n336\t    });\n337\t  }\n338\t\n339\t  private togglePanel(panel: UIPanel): void {\n340\t    this.state.activePanel = this.state.activePanel === panel ? UIPanel.NONE : panel;\n341\t    if (this.state.activePanel === UIPanel.NONE) {\n342\t      this.shelfInteraction.close();\n343\t    }\n344\t  }\n345\t\n346\t  private createInteractables(): Interactable[] {\n347\t    const S = TILE_SIZE;\n348\t    return [\n349\t      { id: 'register_1', type: 'register', x: 19 * S, y: 3 * S, width: S, height: S, label: '收银台', active: true },\n350\t      { id: 'register_2', type: 'register', x: 21 * S, y: 3 * S, width: S, height: S, label: '收银台', active: true },\n351\t      { id: 'shelf_1', type: 'shelf', x: 3 * S, y: 5 * S, width: 3 * S, height: S, label: '零食货架', active: true },\n352\t      { id: 'shelf_2', type: 'shelf', x: 7 * S, y: 5 * S, width: 3 * S, height: S, label: '饮料货架', active: true },\n353\t      { id: 'shelf_3', type: 'shelf', x: 11 * S, y: 5 * S, width: 3 * S, height: S, label: '日用品', active: true },\n354\t      { id: 'shelf_4', type: 'shelf', x: 17 * S, y: 5 * S, width: 3 * S, height: S, label: '烟酒柜', active: true },\n355\t      { id: 'shelf_5', type: 'shelf', x: 21 * S, y: 5 * S, width: 3 * S, height: S, label: '杂志架', active: true },\n356\t      { id: 'fridge_1', type: 'fridge', x: 3 * S, y: 9 * S, width: 3 * S, height: S, label: '冷饮冰柜', active: true },\n357\t      { id: 'fridge_2', type: 'fridge', x: 7 * S, y: 9 * S, width: 3 * S, height: S, label: '冷冻食品', active: true },\n358\t      { id: 'door_front', type: 'door', x: 14 * S, y: 0, width: 2 * S, height: S, label: '前门', active: true },\n359\t      { id: 'door_back', type: 'door', x: 9 * S, y: 24 * S, width: 2 * S, height: S, label: '后门', active: true },\n360\t      { id: 'door_warehouse', type: 'door', x: 14 * S, y: 11 * S, width: 2 * S, height: S, label: '仓库门', active: true },\n361\t      { id: 'note_safe', type: 'note', x: 4 * S, y: 20 * S, width: S, height: S, label: '保险柜', active: true },\n362\t    ];\n363\t  }\n364\t\n365\t  private createLights(): LightSource[] {\n366\t    const S = TILE_SIZE;\n367\t    return [\n368\t      { x: 15 * S, y: 3 * S, radius: 200, color: '#fff5e0', intensity: 0.8, flicker: false, flickerSpeed: 0 },\n369\t      { x: 8 * S, y: 6 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n370\t      { x: 22 * S, y: 6 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n371\t      { x: 8 * S, y: 8 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n372\t      { x: 15 * S, y: 10 * S, radius: 150, color: '#fff5e0', intensity: 0.6, flicker: false, flickerSpeed: 0 },\n373\t      { x: 12 * S, y: 14 * S, radius: 120, color: '#e0d0b0', intensity: 0.5, flicker: true, flickerSpeed: 3.5 },\n374\t      { x: 22 * S, y: 20 * S, radius: 100, color: '#ffe8c0', intensity: 0.4, flicker: false, flickerSpeed: 0 },\n375\t      { x: 20 * S, y: 3 * S, radius: 80, color: '#ffffff', intensity: 0.6, flicker: false, flickerSpeed: 0 },\n376\t    ];\n377\t  }\n378\t\n379\t  start(): void {\n380\t    if (this.running) return;\n381\t    this.running = true;\n382\t    this.lastFrameTime = performance.now();\n383\t    this.loop(this.lastFrameTime);\n384\t    startAutoSave(\n385\t      () => this.state,\n386\t      () => ({\n387\t        pm: this.productManager.getSaveData(),\n388\t        eco: this.economy.getSaveData(),\n389\t        prc: this.pricing.getSaveData(),\n390\t        cust: this.customerManager.getSaveData(),\n391\t        regs: this.registers.map(r => r.getSaveData()),\n392\t      }),\n393\t    );\n394\t    this.saveManager.startAutoSave(() => this.state);\n395\t  }\n396\t\n397\t  stop(): void {\n398\t    this.running = false;\n399\t    if (this.animFrameId) cancelAnimationFrame(this.animFrameId);\n400\t    stopAutoSave();\n401\t    this.saveManager.save(this.state);\n402\t  }\n403\t\n404\t  private loop = (now: number): void => {\n405\t    if (!this.running) return;\n406\t\n407\t    const dt = Math.min(now - this.lastFrameTime, 50);\n408\t    this.lastFrameTime = now;\n409\t\n410\t    this.state.totalPlaytime += dt / 1000;\n411\t\n412\t    // M3: Use DayCycle for time management\n413\t    const prevDay = this.state.day;\n414\t    this.dayCycle.update(dt);\n415\t    this.state.day = this.dayCycle.currentDay;\n416\t    this.state.timeOfDay = this.dayCycle.currentTime;\n417\t    this.state.phase = this.dayCycle.currentPhase;\n418\t    this.state.player.day = this.state.day;\n419\t\n420\t    // Update player (skip if panel is open)\n421\t    if (this.state.activePanel === UIPanel.NONE) {\n422\t      this.player.update(dt, this.map);\n423\t    }\n424\t\n425\t    // Handle interaction\n426\t    if (this.player.consumeInteract()) {\n427\t      this.handleInteraction();\n428\t    }\n429\t\n430\t    // Update M2 systems\n431\t    this.updateManagementSystems(dt, now);\n432\t\n433\t    // Update M3 day summary\n434\t    this.daySummary.update(dt);\n435\t\n436\t    // M4: Update horror events\n437\t    const horrorVisuals = this.horrorManager.update(dt, this.state.day, this.state.phase, this.state.timeOfDay, this.state.player.sanity);\n438\t\n439\t    // M5: Update NPCs and jump scares\n440\t    this.npcManager.update(dt, this.state.day, this.state.timeOfDay, this.player.x, this.player.y, this.state.player.sanity, this.state.fearLevel);\n441\t    const scareVisuals = this.jumpScareManager.update(dt, this.state.day, this.state.phase, this.state.player.sanity);\n442\t\n443\t    // M6: Update narrative systems\n444\t    this.storyManager.update(this.state.day);\n445\t    this.radioManager.update(dt, this.state.day, this.state.timeOfDay);\n446\t    this.noteManager.update(this.state.day);\n447\t    this.endingSystem.evaluate(this.state.day);\n448\t    this.syncNarrativeState();\n449\t\n450\t    // Update camera\n451\t    this.renderer.camera.follow(this.player.x + 16, this.player.y + 16);\n452\t\n453\t    // Update shelf interaction messages\n454\t    this.shelfInteraction.update(dt);\n455\t\n456\t    // Render\n457\t    this.renderer.render(this.map, this.player, this.state, now, {\n458\t      customers: this.activeCustomers,\n459\t      productManager: this.productManager,\n460\t      shelfInteraction: this.shelfInteraction,\n461\t      registers: this.registers,\n462\t      economy: this.economy,\n463\t      pricing: this.pricing,\n464\t      lastTransaction: this.lastTransactionNotification,\n465\t      daySummary: this.daySummary,\n466\t      upgradeManager: this.upgradeManager,\n467\t      horrorVisuals: horrorVisuals,\n468\t      scareVisuals: scareVisuals,\n469\t      activeNPCs: this.npcManager.getActiveNPCs(),\n470\t    });\n471\t\n472\t    this.animFrameId = requestAnimationFrame(this.loop);\n473\t  };\n474\t\n475\t  private updateManagementSystems(dt: number, now: number): void {\n476\t    // Process pending orders\n477\t    const fulfilled = this.productManager.processPendingOrders(this.state.day);\n478\t    if (fulfilled.length > 0) {\n479\t      for (const order of fulfilled) {\n480\t        const product = this.productManager.getProduct(order.productId);\n481\t        this.addNotification(`到货: ${product?.name ?? order.productId} x${order.quantity}`);\n482\t      }\n483\t    }\n484\t\n485\t    // Expire products\n486\t    const expired = this.productManager.expireProducts(this.state.day);\n487\t    if (expired.length > 0) {\n488\t      for (const pid of expired) {\n489\t        const product = this.productManager.getProduct(pid);\n490\t        this.addNotification(`过期: ${product?.name ?? pid}`);\n491\t      }\n492\t    }\n493\t\n494\t    // Update customers\n495\t    this.activeCustomers = this.customerManager.update(dt, this.state.timeOfDay, this.state.day, this.productManager);\n496\t\n497\t    // Update demand\n498\t    this.pricing.updateDemand(this.state.timeOfDay);\n499\t\n500\t    // Update registers\n501\t    for (const register of this.registers) {\n502\t      const txn = register.update(dt);\n503\t      if (txn) {\n504\t        this.economy.addRevenue(txn.total);\n505\t        this.state.dailyRevenue += txn.total;\n506\t        this.lastTransactionNotification = `交易完成: ¥${txn.total.toFixed(2)}`;\n507\t        this.addNotification(this.lastTransactionNotification);\n508\t\n509\t        if (txn.isAnomalous) {\n510\t          this.addNotification('⚠ 收银机出现异常...');\n511\t          this.state.player.sanity = Math.max(0, this.state.player.sanity - 5);\n512\t        }\n513\t\n514\t        for (const item of txn.items) {\n515\t          this.pricing.recordSale(item.productId);\n516\t        }\n517\t      }\n518\t\n519\t      if (register.canAcceptCustomer()) {\n520\t        const waiting = this.customerManager.getFirstWaiting();\n521\t        if (waiting) {\n522\t          register.startCheckout(waiting, this.productManager, this.pricing);\n523\t        }\n524\t      }\n525\t    }\n526\t\n527\t    // Sync economy money with game state\n528\t    this.state.money = this.economy.getMoney();\n529\t    this.state.debt = this.economy.debt;\n530\t  }\n531\t\n532\t  private handleInteraction(): void {\n533\t    if (this.state.activePanel !== UIPanel.NONE) {\n534\t      this.state.activePanel = UIPanel.NONE;\n535\t      this.shelfInteraction.close();\n536\t      return;\n537\t    }\n538\t\n539\t    const facing = this.player.getFacingTile();\n540\t\n541\t    const obj = this.state.interactables.find(o => {\n542\t      const oGX = Math.floor(o.x / TILE_SIZE);\n543\t      const oGY = Math.floor(o.y / TILE_SIZE);\n544\t      const oGW = Math.ceil(o.width / TILE_SIZE);\n545\t      const oGH = Math.ceil(o.height / TILE_SIZE);\n546\t      return facing.gx >= oGX && facing.gx < oGX + oGW && facing.gy >= oGY && facing.gy < oGY + oGH;\n547\t    });\n548\t\n549\t    if (!obj) return;\n550\t\n551\t    switch (obj.type) {\n552\t      case 'shelf':\n553\t      case 'fridge': {\n554\t        const info = this.shelfInteraction.interactWithShelf(obj.id, this.state.interactables, this.productManager);\n555\t        if (info) {\n556\t          this.state.activePanel = UIPanel.SHELF;\n557\t          this.onNotification?.(`货架: ${info.label} — ${info.productName ?? '空'} (${info.quantity}/${info.maxQuantity})`);\n558\t        }\n559\t        break;\n560\t      }\n561\t      case 'register': {\n562\t        const register = this.registers.find(r => r.registerId === obj.id);\n563\t        const waiting = this.customerManager.getFirstWaiting();\n564\t        if (register && register.canAcceptCustomer() && waiting) {\n565\t          register.startCheckout(waiting, this.productManager, this.pricing);\n566\t          this.onNotification?.('开始收银...');\n567\t        } else if (register && !register.canAcceptCustomer()) {\n568\t          this.onNotification?.('收银中...');\n569\t        } else {\n570\t          this.onNotification?.('收银台 — 没有顾客等待');\n571\t        }\n572\t        break;\n573\t      }\n574\t      case 'door':\n575\t        this.onNotification?.(`交互: ${obj.label}`);\n576\t        break;\n577\t      default:\n578\t        this.onNotification?.(`交互: ${obj.label}`);\n579\t    }\n580\t  }\n581\t\n582\t  private onNewDay(): void {\n583\t    const report = this.economy.endDay();\n584\t\n585\t    // M4: Reset horror system for new day\n586\t    this.horrorManager.resetDaily();\n587\t    this.state.fearLevel = Math.max(0, this.state.fearLevel - 0.3);\n588\t\n589\t    // M5: Reset NPC and jump scare systems\n590\t    this.npcManager.resetDaily();\n591\t    this.jumpScareManager.resetDaily();\n592\t\n593\t    // M6: Auto-discover clues and update narrative\n594\t    const newClues = this.clueManager.autoDiscoverForDay(report.day);\n595\t    for (const clue of newClues) {\n596\t      this.addNotification(`🔍 发现线索: ${clue.name}`);\n597\t    }\n598\t    this.storyManager.update(report.day);\n599\t\n600\t    // M6: Check for forced ending on Day 30\n601\t    if (report.day >= 30) {\n602\t      const ending = this.endingSystem.forceEnding(report.day);\n603\t      this.addNotification(`🏁 ${ending.title}`);\n604\t    }\n605\t\n606\t    // M3: Generate day summary with display\n607\t    this.daySummary.generateSummary(report, this.customerManager);\n608\t\n609\t    // Create day summary record\n610\t    const stats = this.customerManager.getStats();\n611\t    this.state.daySummaries.push({\n612\t      day: report.day,\n613\t      revenue: report.revenue,\n614\t      expenses: report.expenses,\n615\t      customersServed: stats.served,\n616\t      customersLost: stats.lost,\n617\t      debtRemaining: report.debtRemaining,\n618\t    });\n619\t\n620\t    this.state.dailyRevenue = 0;\n621\t    this.state.dailyExpenses = 0;\n622\t    this.customerManager.resetDailyStats();\n623\t    this.pricing.resetDailyVelocity();\n624\t\n625\t    this.addNotification(`Day ${report.day} 结算: 收入¥${report.revenue} 支出¥${report.expenses} 债务¥${report.debtRemaining}`);\n626\t\n627\t    // M3: Auto-save after day end\n628\t    this.saveManager.save(this.state);\n629\t\n630\t    // Check game over\n631\t    const gameOver = this.economy.isGameOver();\n632\t    if (gameOver.over) {\n633\t      this.addNotification(`游戏结束: ${gameOver.reason}`);\n634\t    }\n635\t  }\n636\t\n637\t  private addNotification(text: string): void {\n638\t    this.state.notifications.push(text);\n639\t    if (this.state.notifications.length > 10) {\n640\t      this.state.notifications.shift();\n641\t    }\n642\t    this.onNotification?.(text);\n643\t  }\n644\t\n645\t  // Public API for UI interaction\n646\t  stockShelf(shelfId: string, productId: string, quantity: number): void {\n647\t    this.shelfInteraction.stockShelf(shelfId, productId, quantity, this.productManager);\n648\t  }\n649\t\n650\t  unstockShelf(shelfId: string, quantity: number): void {\n651\t    this.shelfInteraction.unstockShelf(shelfId, quantity, this.productManager);\n652\t  }\n653\t\n654\t  orderProduct(productId: string, quantity: number, supplierId: string): boolean {\n655\t    const order = this.productManager.orderProduct(productId, quantity, supplierId, this.state.day);\n656\t    if (order) {\n657\t      this.economy.addPurchaseCost(order.totalCost);\n658\t      this.state.money = this.economy.getMoney();\n659\t      const product = this.productManager.getProduct(productId);\n660\t      this.addNotification(`下单: ${product?.name} x${quantity} — ¥${order.totalCost}`);\n661\t      return true;\n662\t    }\n663\t    return false;\n664\t  }\n665\t\n666\t  purchaseUpgrade(upgradeId: string): { success: boolean; message: string } {\n667\t    const result = this.economy.purchaseUpgrade(upgradeId);\n668\t    if (result.success) {\n669\t      this.state.money = this.economy.getMoney();\n670\t      this.applyUpgrades();\n671\t      this.addNotification(result.message);\n672\t    }\n673\t    return result;\n674\t  }\n675\t\n676\t  purchaseUpgradeM3(upgradeId: string): { success: boolean; message: string } {\n677\t    const result = this.upgradeManager.purchase(upgradeId, this.state.money);\n678\t    if (result.success) {\n679\t      this.economy.addExpense(result.cost);\n680\t      this.state.money = this.economy.getMoney();\n681\t      this.applyUpgrades();\n682\t      this.addNotification(result.message);\n683\t    }\n684\t    return { success: result.success, message: result.message };\n685\t  }\n686\t\n687\t  setProductPrice(productId: string, price: number): boolean {\n688\t    return this.pricing.setPrice(productId, price);\n689\t  }\n690\t\n691\t  centerCamera(): void {\n692\t    this.renderer.camera.snapTo(this.player.x + 16, this.player.y + 16);\n693\t  }\n694\t\n695\t  setTimeSpeed(speed: number): void {\n696\t    this.state.timeSpeed = speed;\n697\t  }\n698\t\n699\t  // M4: Horror audio helpers\n700\t  private triggerHorrorAudio(type: HorrorEventType): void {\n701\t    switch (type) {\n702\t      case HorrorEventType.LIGHT_FLICKER:\n703\t        this.audioManager.playHorrorFlicker();\n704\t        break;\n705\t      case HorrorEventType.FRIDGE_NOISE:\n706\t        this.audioManager.playHorrorJumpScare();\n707\t        break;\n708\t      case HorrorEventType.WHISPER:\n709\t        this.audioManager.playHorrorWhisper();\n710\t        break;\n711\t      case HorrorEventType.DOOR_AUTO_OPEN:\n712\t        this.audioManager.playHorrorDoorCreak();\n713\t        break;\n714\t      case HorrorEventType.GHOST_CUSTOMER:\n715\t      case HorrorEventType.DUPLICATE_CUSTOMER:\n716\t      case HorrorEventType.NONPAYING_CUSTOMER:\n717\t        this.audioManager.playHorrorAmbientDrone();\n718\t        break;\n719\t      case HorrorEventType.STORE_MUTATE:\n720\t      case HorrorEventType.TIME_GLITCH:\n721\t      case HorrorEventType.MIRROR_STORE:\n722\t      case HorrorEventType.HE_COMES:\n723\t      case HorrorEventType.FINAL_CHOICE:\n724\t        this.audioManager.playHorrorJumpScare();\n725\t        break;\n726\t      case HorrorEventType.STALKER:\n727\t      case HorrorEventType.CCTV_DOUBLE:\n728\t      case HorrorEventType.CORRIDOR_EXTEND:\n729\t        this.audioManager.playHorrorAmbientDrone();\n730\t        break;\n731\t      case HorrorEventType.RADIO_VOICE:\n732\t        this.audioManager.playHorrorWhisper();\n733\t        break;\n734\t      default:\n735\t        this.audioManager.playHorrorAmbientDrone();\n736\t        break;\n737\t    }\n738\t  }\n739\t\n740\t  private switchBgmForPhase(phase: GamePhase): void {\n741\t    if (phase === GamePhase.DAYTIME) {\n742\t      this.audioManager.playBgm('daytime');\n743\t    } else if (phase === GamePhase.NIGHT || phase === GamePhase.NIGHT_TRANSITION) {\n744\t      this.audioManager.playBgm('night');\n745\t    } else if (phase === GamePhase.DANGER) {\n746\t      this.audioManager.playBgm('danger');\n747\t    } else {\n748\t      this.audioManager.stopBgm();\n749\t    }\n750\t  }\n751\t\n752\t  // M6: Sync narrative state to game state\n753\t  private syncNarrativeState(): void {\n754\t    this.state.storyLayer = this.storyManager.currentLayer;\n755\t    this.state.cluesFound = this.clueManager.foundCount;\n756\t    this.state.choicesMade = this.narrativeChoices.madeCount;\n757\t    if (this.endingSystem.ending) {\n758\t      this.state.endingType = this.endingSystem.ending.type;\n759\t    }\n760\t  }\n761\t\n762\t  // M6: Public API for narrative interaction\n763\t\n764\t  /** Try to play the next available radio segment */\n765\t  playRadio(): boolean {\n766\t    const seg = this.radioManager.tryPlay(this.state.day, this.state.timeOfDay);\n767\t    return seg !== null;\n768\t  }\n769\t\n770\t  /** Read a discovered note */\n771\t  readNote(noteId: string): boolean {\n772\t    const note = this.noteManager.readNote(noteId, this.state.day);\n773\t    return note !== null;\n774\t  }\n775\t\n776\t  /** Find notes at current player location */\n777\t  searchLocation(location: string): string | null {\n778\t    const note = this.noteManager.findNoteAtLocation(location, this.state.day);\n779\t    return note?.id ?? null;\n780\t  }\n781\t\n782\t  /** Get available narrative choices */\n783\t  getAvailableChoices(): Array<{ id: string; title: string; description: string; options: Array<{ id: string; text: string }> }> {\n784\t    const choices = this.narrativeChoices.getAllAvailable(this.state.day, this.state.phase);\n785\t    return choices.map(c => ({\n786\t      id: c.id,\n787\t      title: c.title,\n788\t      description: c.description,\n789\t      options: c.options.map(o => ({ id: o.id, text: o.text })),\n790\t    }));\n791\t  }\n792\t\n793\t  /** Make a narrative choice */\n794\t  makeNarrativeChoice(choiceId: string, optionId: string): boolean {\n795\t    return this.narrativeChoices.makeChoice(choiceId, optionId, this.state.day);\n796\t  }\n797\t\n798\t  /** Get story summary for HUD */\n799\t  getStorySummary(): string {\n800\t    return this.storyManager.getSummary();\n801\t  }\n802\t\n803\t  /** Get ending progress for HUD */\n804\t  getEndingProgress(): Array<{ title: string; progress: number; hint: string }> {\n805\t    return this.endingSystem.getEndingProgress();\n806\t  }\n807\t\n808\t  /** Get found clues list */\n809\t  getFoundClues(): Array<{ name: string; description: string; acquired: boolean }> {\n810\t    return this.clueManager.getAllFound().map(c => ({\n811\t      name: c.name,\n812\t      description: c.description,\n813\t      acquired: c.acquired,\n814\t    }));\n815\t  }\n816\t}\n817\t"}]},"parent_tool_use_id":null,"session_id":"328f9d51-5f9c-4f63-927e-7b99009d6517","uuid":"462629b6-7490-41a0-8515-a65d75be1dc9","timestamp":"2026-05-23T05:39:25.240Z","tool_use_result":{"type":"text","file":{"filePath":"D:/game-projects/steam-horror-sim/src/renderer/App.ts","content":"// App.ts — Game main loop + state machine (v0.6.0 — M6: Narrative System)\n\nimport { Renderer } from './Renderer';\nimport { StoreMap, TILE_SIZE, T } from '../game/StoreMap';\nimport { Player } from '../game/Player';\nimport {\n  type GameState,\n  type Interactable,\n  type LightSource,\n  GamePhase,\n  UIPanel,\n  createInitialState,\n  loadGame,\n  saveGame,\n  startAutoSave,\n  stopAutoSave,\n  getPhaseFromTime,\n  cloneState,\n  isNightTime,\n} from '../game/GameState';\nimport { ProductManager } from '../game/ProductManager';\nimport { CustomerManager } from '../game/CustomerManager';\nimport { CashRegister } from '../game/CashRegister';\nimport { PricingSystem } from '../game/PricingSystem';\nimport { EconomySystem } from '../game/EconomySystem';\nimport { ShelfInteraction, ShelfAction } from '../game/ShelfInteraction';\nimport { Customer, CustomerState } from '../game/Customer';\nimport { DayCycle } from '../game/DayCycle';\nimport { DaySummaryManager } from '../game/DaySummary';\nimport { UpgradeManager } from '../game/UpgradeManager';\nimport { SaveManager } from '../game/SaveManager';\nimport { HorrorEventManager, HorrorEventType } from '../game/HorrorEventManager';\nimport { AudioManager } from '../game/AudioManager';\nimport { NPCManager } from '../game/BehaviorTree';\nimport { JumpScareManager } from '../game/JumpScareManager';\nimport { ClueManager } from '../game/ClueManager';\nimport { StoryManager } from '../game/StoryManager';\nimport { EndingSystem } from '../game/EndingSystem';\nimport { RadioManager } from '../game/RadioManager';\nimport { NoteManager } from '../game/NoteManager';\nimport { NarrativeChoiceManager } from '../game/NarrativeChoiceManager';\n\nexport class App {\n  canvas: HTMLCanvasElement;\n  renderer: Renderer;\n  state: GameState;\n  map: StoreMap;\n  player: Player;\n\n  // M2 systems\n  productManager: ProductManager;\n  customerManager: CustomerManager;\n  registers: CashRegister[];\n  pricing: PricingSystem;\n  economy: EconomySystem;\n  shelfInteraction: ShelfInteraction;\n\n  // M3 systems\n  dayCycle: DayCycle;\n  daySummary: DaySummaryManager;\n  upgradeManager: UpgradeManager;\n  saveManager: SaveManager;\n\n  // M4 systems\n  horrorManager: HorrorEventManager;\n  audioManager: AudioManager;\n\n  // M5 systems\n  npcManager: NPCManager;\n  jumpScareManager: JumpScareManager;\n\n  // M6 systems\n  clueManager: ClueManager;\n  storyManager: StoryManager;\n  endingSystem: EndingSystem;\n  radioManager: RadioManager;\n  noteManager: NoteManager;\n  narrativeChoices: NarrativeChoiceManager;\n\n  private running = false;\n  private lastFrameTime = 0;\n  private animFrameId = 0;\n  private activeCustomers: Customer[] = [];\n  private lastTransactionNotification = '';\n\n  onStateChange?: (state: GameState) => void;\n  onNotification?: (text: string) => void;\n\n  constructor(canvas: HTMLCanvasElement) {\n    this.canvas = canvas;\n    this.renderer = new Renderer(canvas);\n\n    const saved = loadGame();\n    this.state = saved ? { ...createInitialState(), ...saved.gameState } : createInitialState();\n\n    this.map = new StoreMap();\n    this.player = new Player(this.state.player);\n    this.player.setupInput();\n\n    // Initialize M2 systems\n    this.productManager = new ProductManager();\n    this.customerManager = new CustomerManager();\n    this.registers = [\n      new CashRegister('register_1'),\n      new CashRegister('register_2'),\n    ];\n    this.pricing = new PricingSystem(this.productManager);\n    this.economy = new EconomySystem();\n    this.shelfInteraction = new ShelfInteraction();\n\n    // Initialize M3 systems\n    this.dayCycle = new DayCycle();\n    this.daySummary = new DaySummaryManager();\n    this.upgradeManager = new UpgradeManager();\n    this.saveManager = new SaveManager();\n\n    // Initialize M4 systems\n    this.horrorManager = new HorrorEventManager();\n    this.audioManager = new AudioManager();\n\n    // Initialize M5 systems\n    this.npcManager = new NPCManager();\n    this.jumpScareManager = new JumpScareManager();\n\n    // Initialize M6 systems\n    this.clueManager = new ClueManager();\n    this.storyManager = new StoryManager(this.clueManager);\n    this.endingSystem = new EndingSystem(this.storyManager, this.clueManager);\n    this.radioManager = new RadioManager();\n    this.noteManager = new NoteManager();\n    this.narrativeChoices = new NarrativeChoiceManager();\n\n    // M6: Wire up callbacks\n    this.storyManager.onNotification = (text) => this.addNotification(text);\n    this.endingSystem.onNotification = (text) => this.addNotification(text);\n    this.radioManager.onNotification = (text) => this.addNotification(text);\n    this.radioManager.onClueGrant = (clueId) => {\n      this.clueManager.discoverClue(clueId, this.state.day);\n      this.syncNarrativeState();\n    };\n    this.noteManager.onNotification = (text) => this.addNotification(text);\n    this.noteManager.onCluesGranted = (clueIds) => {\n      for (const id of clueIds) {\n        this.clueManager.discoverClue(id, this.state.day);\n      }\n      this.syncNarrativeState();\n    };\n    this.narrativeChoices.onNotification = (text) => this.addNotification(text);\n    this.narrativeChoices.onSanityCost = (amount) => {\n      this.state.player.sanity = Math.max(0, this.state.player.sanity - amount);\n    };\n    this.narrativeChoices.onClueGrant = (clueId) => {\n      this.clueManager.discoverClue(clueId, this.state.day);\n      this.syncNarrativeState();\n    };\n\n    // Register systems with SaveManager\n    this.saveManager.register('productManager', this.productManager);\n    this.saveManager.register('economy', this.economy);\n    this.saveManager.register('pricing', this.pricing);\n    this.saveManager.register('customerManager', this.customerManager);\n    this.saveManager.register('upgradeManager', this.upgradeManager);\n    this.saveManager.register('daySummary', this.daySummary);\n\n    // Load save data for M2 systems\n    if (saved) {\n      if (saved.productManager && Object.keys(saved.productManager).length > 0) {\n        this.productManager.loadSaveData(saved.productManager);\n      }\n      if (saved.economy && Object.keys(saved.economy).length > 0) {\n        this.economy.loadSaveData(saved.economy);\n      }\n      if (saved.pricing && Object.keys(saved.pricing).length > 0) {\n        this.pricing.loadSaveData(saved.pricing);\n      }\n      if (saved.customerStats && Object.keys(saved.customerStats).length > 0) {\n        this.customerManager.loadSaveData(saved.customerStats);\n      }\n      if (saved.registers) {\n        for (let i = 0; i < saved.registers.length && i < this.registers.length; i++) {\n          this.registers[i].loadSaveData(saved.registers[i]);\n        }\n      }\n\n      // Restore M3 day cycle state\n      this.dayCycle.setDay(this.state.day);\n      this.dayCycle.setTimeOfDay(this.state.timeOfDay);\n    }\n\n    // Apply purchased upgrades\n    this.applyUpgrades();\n\n    // Setup interactable objects\n    this.state.interactables = this.createInteractables();\n    this.state.lights = this.createLights();\n\n    // Give some starting inventory\n    if (!saved) {\n      this.setupStartingInventory();\n    }\n\n    // Setup day cycle event listeners\n    this.dayCycle.onPhaseChange((phase, prev) => {\n      this.state.phase = phase;\n      this.onStateChange?.(this.state);\n    });\n\n    this.dayCycle.onNewDay((day) => {\n      this.onNewDay();\n    });\n\n    // M4: Horror event callbacks\n    this.horrorManager.onSanityChange = (delta) => {\n      this.state.player.sanity = Math.max(0, Math.min(100, this.state.player.sanity + delta));\n      this.state.fearLevel = Math.min(1, this.state.fearLevel + Math.abs(delta) / 100);\n    };\n    this.horrorManager.onNotification = (text) => {\n      this.addNotification(text);\n    };\n    this.horrorManager.onEventTrigger = (event) => {\n      this.state.horrorEventsTriggered++;\n      this.state.lastHorrorEventDay = this.state.day;\n      this.triggerHorrorAudio(event.type);\n    };\n\n    // M5: Jump scare callbacks\n    this.jumpScareManager.onSanityDrain = (amount) => {\n      this.state.player.sanity = Math.max(0, this.state.player.sanity - amount);\n      this.state.fearLevel = Math.min(1, this.state.fearLevel + amount / 100);\n    };\n    this.jumpScareManager.onMoneyLoss = (percent) => {\n      const loss = this.state.dailyRevenue * percent;\n      this.state.dailyRevenue = Math.max(0, this.state.dailyRevenue - loss);\n      this.economy.addExpense(loss);\n    };\n    this.jumpScareManager.onNotification = (text) => {\n      this.addNotification(text);\n    };\n    this.jumpScareManager.onScareTrigger = (scare) => {\n      this.audioManager.playHorrorJumpScare();\n      this.state.horrorEventsTriggered++;\n    };\n\n    // M4: Phase change BGM switching\n    this.dayCycle.onPhaseChange((phase) => {\n      this.switchBgmForPhase(phase);\n    });\n\n    // Snap camera to player immediately\n    this.renderer.camera.snapTo(this.player.x + 16, this.player.y + 16);\n\n    // Setup keyboard shortcuts for panels\n    this.setupPanelInput();\n\n    window.addEventListener('resize', () => {\n      this.renderer.resize();\n    });\n  }\n\n  private setupStartingInventory(): void {\n    this.productManager.addToInventory('water', 10, 1);\n    this.productManager.addToInventory('cola', 8, 1);\n    this.productManager.addToInventory('chips', 8, 1);\n    this.productManager.addToInventory('biscuit', 6, 1);\n    this.productManager.addToInventory('candy', 10, 1);\n    this.productManager.addToInventory('bento_chicken', 4, 1);\n    this.productManager.addToInventory('bento_veg', 4, 1);\n    this.productManager.addToInventory('tissue', 5, 1);\n    this.productManager.addToInventory('battery', 3, 1);\n\n    this.productManager.stockShelf('shelf_1', 'chips', 5);\n    this.productManager.stockShelf('shelf_2', 'cola', 5);\n    this.productManager.stockShelf('shelf_3', 'tissue', 5);\n    this.productManager.stockShelf('fridge_1', 'water', 5);\n    this.productManager.stockShelf('fridge_2', 'bento_chicken', 3);\n  }\n\n  private applyUpgrades(): void {\n    // M3 UpgradeManager effects\n    this.renderer.lighting.setLightBoost(this.upgradeManager.getLightBoost());\n\n    if (this.upgradeManager.isPurchased('register_upgrade')) {\n      this.registers.forEach(r => r.applySpeedUpgrade(0.3));\n    }\n    if (this.upgradeManager.isPurchased('warehouse_shelf')) {\n      this.productManager.upgradeStorage(0.5);\n    }\n\n    // Also apply economy system upgrades for backward compat\n    if (this.economy.hasUpgrade('register_upgrade')) {\n      this.registers.forEach(r => r.applySpeedUpgrade(0.3));\n    }\n    if (this.economy.hasUpgrade('warehouse_shelf')) {\n      this.productManager.upgradeStorage(0.5);\n    }\n    if (this.economy.hasUpgrade('bright_lights')) {\n      for (const light of this.state.lights) {\n        light.intensity = Math.min(1, light.intensity * 1.5);\n        light.radius *= 1.3;\n      }\n    }\n  }\n\n  private setupPanelInput(): void {\n    window.addEventListener('keydown', (e) => {\n      // Dismiss day summary on any key\n      if (this.daySummary.isVisible) {\n        this.daySummary.dismiss();\n        e.preventDefault();\n        return;\n      }\n\n      if (e.key === 'Escape') {\n        if (this.state.activePanel !== UIPanel.NONE) {\n          this.state.activePanel = UIPanel.NONE;\n          this.shelfInteraction.close();\n          e.preventDefault();\n        }\n      }\n      if (e.key === 'i' || e.key === 'I') {\n        this.togglePanel(UIPanel.INVENTORY);\n        e.preventDefault();\n      }\n      if (e.key === 'p' || e.key === 'P') {\n        this.togglePanel(UIPanel.PRICING);\n        e.preventDefault();\n      }\n      if (e.key === 'u' || e.key === 'U') {\n        this.togglePanel(UIPanel.SHOP);\n        e.preventDefault();\n      }\n      if (e.key === 'o' || e.key === 'O') {\n        this.togglePanel(UIPanel.SUPPLIER);\n        e.preventDefault();\n      }\n    });\n  }\n\n  private togglePanel(panel: UIPanel): void {\n    this.state.activePanel = this.state.activePanel === panel ? UIPanel.NONE : panel;\n    if (this.state.activePanel === UIPanel.NONE) {\n      this.shelfInteraction.close();\n    }\n  }\n\n  private createInteractables(): Interactable[] {\n    const S = TILE_SIZE;\n    return [\n      { id: 'register_1', type: 'register', x: 19 * S, y: 3 * S, width: S, height: S, label: '收银台', active: true },\n      { id: 'register_2', type: 'register', x: 21 * S, y: 3 * S, width: S, height: S, label: '收银台', active: true },\n      { id: 'shelf_1', type: 'shelf', x: 3 * S, y: 5 * S, width: 3 * S, height: S, label: '零食货架', active: true },\n      { id: 'shelf_2', type: 'shelf', x: 7 * S, y: 5 * S, width: 3 * S, height: S, label: '饮料货架', active: true },\n      { id: 'shelf_3', type: 'shelf', x: 11 * S, y: 5 * S, width: 3 * S, height: S, label: '日用品', active: true },\n      { id: 'shelf_4', type: 'shelf', x: 17 * S, y: 5 * S, width: 3 * S, height: S, label: '烟酒柜', active: true },\n      { id: 'shelf_5', type: 'shelf', x: 21 * S, y: 5 * S, width: 3 * S, height: S, label: '杂志架', active: true },\n      { id: 'fridge_1', type: 'fridge', x: 3 * S, y: 9 * S, width: 3 * S, height: S, label: '冷饮冰柜', active: true },\n      { id: 'fridge_2', type: 'fridge', x: 7 * S, y: 9 * S, width: 3 * S, height: S, label: '冷冻食品', active: true },\n      { id: 'door_front', type: 'door', x: 14 * S, y: 0, width: 2 * S, height: S, label: '前门', active: true },\n      { id: 'door_back', type: 'door', x: 9 * S, y: 24 * S, width: 2 * S, height: S, label: '后门', active: true },\n      { id: 'door_warehouse', type: 'door', x: 14 * S, y: 11 * S, width: 2 * S, height: S, label: '仓库门', active: true },\n      { id: 'note_safe', type: 'note', x: 4 * S, y: 20 * S, width: S, height: S, label: '保险柜', active: true },\n    ];\n  }\n\n  private createLights(): LightSource[] {\n    const S = TILE_SIZE;\n    return [\n      { x: 15 * S, y: 3 * S, radius: 200, color: '#fff5e0', intensity: 0.8, flicker: false, flickerSpeed: 0 },\n      { x: 8 * S, y: 6 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n      { x: 22 * S, y: 6 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n      { x: 8 * S, y: 8 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n      { x: 15 * S, y: 10 * S, radius: 150, color: '#fff5e0', intensity: 0.6, flicker: false, flickerSpeed: 0 },\n      { x: 12 * S, y: 14 * S, radius: 120, color: '#e0d0b0', intensity: 0.5, flicker: true, flickerSpeed: 3.5 },\n      { x: 22 * S, y: 20 * S, radius: 100, color: '#ffe8c0', intensity: 0.4, flicker: false, flickerSpeed: 0 },\n      { x: 20 * S, y: 3 * S, radius: 80, color: '#ffffff', intensity: 0.6, flicker: false, flickerSpeed: 0 },\n    ];\n  }\n\n  start(): void {\n    if (this.running) return;\n    this.running = true;\n    this.lastFrameTime = performance.now();\n    this.loop(this.lastFrameTime);\n    startAutoSave(\n      () => this.state,\n      () => ({\n        pm: this.productManager.getSaveData(),\n        eco: this.economy.getSaveData(),\n        prc: this.pricing.getSaveData(),\n        cust: this.customerManager.getSaveData(),\n        regs: this.registers.map(r => r.getSaveData()),\n      }),\n    );\n    this.saveManager.startAutoSave(() => this.state);\n  }\n\n  stop(): void {\n    this.running = false;\n    if (this.animFrameId) cancelAnimationFrame(this.animFrameId);\n    stopAutoSave();\n    this.saveManager.save(this.state);\n  }\n\n  private loop = (now: number): void => {\n    if (!this.running) return;\n\n    const dt = Math.min(now - this.lastFrameTime, 50);\n    this.lastFrameTime = now;\n\n    this.state.totalPlaytime += dt / 1000;\n\n    // M3: Use DayCycle for time management\n    const prevDay = this.state.day;\n    this.dayCycle.update(dt);\n    this.state.day = this.dayCycle.currentDay;\n    this.state.timeOfDay = this.dayCycle.currentTime;\n    this.state.phase = this.dayCycle.currentPhase;\n    this.state.player.day = this.state.day;\n\n    // Update player (skip if panel is open)\n    if (this.state.activePanel === UIPanel.NONE) {\n      this.player.update(dt, this.map);\n    }\n\n    // Handle interaction\n    if (this.player.consumeInteract()) {\n      this.handleInteraction();\n    }\n\n    // Update M2 systems\n    this.updateManagementSystems(dt, now);\n\n    // Update M3 day summary\n    this.daySummary.update(dt);\n\n    // M4: Update horror events\n    const horrorVisuals = this.horrorManager.update(dt, this.state.day, this.state.phase, this.state.timeOfDay, this.state.player.sanity);\n\n    // M5: Update NPCs and jump scares\n    this.npcManager.update(dt, this.state.day, this.state.timeOfDay, this.player.x, this.player.y, this.state.player.sanity, this.state.fearLevel);\n    const scareVisuals = this.jumpScareManager.update(dt, this.state.day, this.state.phase, this.state.player.sanity);\n\n    // M6: Update narrative systems\n    this.storyManager.update(this.state.day);\n    this.radioManager.update(dt, this.state.day, this.state.timeOfDay);\n    this.noteManager.update(this.state.day);\n    this.endingSystem.evaluate(this.state.day);\n    this.syncNarrativeState();\n\n    // Update camera\n    this.renderer.camera.follow(this.player.x + 16, this.player.y + 16);\n\n    // Update shelf interaction messages\n    this.shelfInteraction.update(dt);\n\n    // Render\n    this.renderer.render(this.map, this.player, this.state, now, {\n      customers: this.activeCustomers,\n      productManager: this.productManager,\n      shelfInteraction: this.shelfInteraction,\n      registers: this.registers,\n      economy: this.economy,\n      pricing: this.pricing,\n      lastTransaction: this.lastTransactionNotification,\n      daySummary: this.daySummary,\n      upgradeManager: this.upgradeManager,\n      horrorVisuals: horrorVisuals,\n      scareVisuals: scareVisuals,\n      activeNPCs: this.npcManager.getActiveNPCs(),\n    });\n\n    this.animFrameId = requestAnimationFrame(this.loop);\n  };\n\n  private updateManagementSystems(dt: number, now: number): void {\n    // Process pending orders\n    const fulfilled = this.productManager.processPendingOrders(this.state.day);\n    if (fulfilled.length > 0) {\n      for (const order of fulfilled) {\n        const product = this.productManager.getProduct(order.productId);\n        this.addNotification(`到货: ${product?.name ?? order.productId} x${order.quantity}`);\n      }\n    }\n\n    // Expire products\n    const expired = this.productManager.expireProducts(this.state.day);\n    if (expired.length > 0) {\n      for (const pid of expired) {\n        const product = this.productManager.getProduct(pid);\n        this.addNotification(`过期: ${product?.name ?? pid}`);\n      }\n    }\n\n    // Update customers\n    this.activeCustomers = this.customerManager.update(dt, this.state.timeOfDay, this.state.day, this.productManager);\n\n    // Update demand\n    this.pricing.updateDemand(this.state.timeOfDay);\n\n    // Update registers\n    for (const register of this.registers) {\n      const txn = register.update(dt);\n      if (txn) {\n        this.economy.addRevenue(txn.total);\n        this.state.dailyRevenue += txn.total;\n        this.lastTransactionNotification = `交易完成: ¥${txn.total.toFixed(2)}`;\n        this.addNotification(this.lastTransactionNotification);\n\n        if (txn.isAnomalous) {\n          this.addNotification('⚠ 收银机出现异常...');\n          this.state.player.sanity = Math.max(0, this.state.player.sanity - 5);\n        }\n\n        for (const item of txn.items) {\n          this.pricing.recordSale(item.productId);\n        }\n      }\n\n      if (register.canAcceptCustomer()) {\n        const waiting = this.customerManager.getFirstWaiting();\n        if (waiting) {\n          register.startCheckout(waiting, this.productManager, this.pricing);\n        }\n      }\n    }\n\n    // Sync economy money with game state\n    this.state.money = this.economy.getMoney();\n    this.state.debt = this.economy.debt;\n  }\n\n  private handleInteraction(): void {\n    if (this.state.activePanel !== UIPanel.NONE) {\n      this.state.activePanel = UIPanel.NONE;\n      this.shelfInteraction.close();\n      return;\n    }\n\n    const facing = this.player.getFacingTile();\n\n    const obj = this.state.interactables.find(o => {\n      const oGX = Math.floor(o.x / TILE_SIZE);\n      const oGY = Math.floor(o.y / TILE_SIZE);\n      const oGW = Math.ceil(o.width / TILE_SIZE);\n      const oGH = Math.ceil(o.height / TILE_SIZE);\n      return facing.gx >= oGX && facing.gx < oGX + oGW && facing.gy >= oGY && facing.gy < oGY + oGH;\n    });\n\n    if (!obj) return;\n\n    switch (obj.type) {\n      case 'shelf':\n      case 'fridge': {\n        const info = this.shelfInteraction.interactWithShelf(obj.id, this.state.interactables, this.productManager);\n        if (info) {\n          this.state.activePanel = UIPanel.SHELF;\n          this.onNotification?.(`货架: ${info.label} — ${info.productName ?? '空'} (${info.quantity}/${info.maxQuantity})`);\n        }\n        break;\n      }\n      case 'register': {\n        const register = this.registers.find(r => r.registerId === obj.id);\n        const waiting = this.customerManager.getFirstWaiting();\n        if (register && register.canAcceptCustomer() && waiting) {\n          register.startCheckout(waiting, this.productManager, this.pricing);\n          this.onNotification?.('开始收银...');\n        } else if (register && !register.canAcceptCustomer()) {\n          this.onNotification?.('收银中...');\n        } else {\n          this.onNotification?.('收银台 — 没有顾客等待');\n        }\n        break;\n      }\n      case 'door':\n        this.onNotification?.(`交互: ${obj.label}`);\n        break;\n      default:\n        this.onNotification?.(`交互: ${obj.label}`);\n    }\n  }\n\n  private onNewDay(): void {\n    const report = this.economy.endDay();\n\n    // M4: Reset horror system for new day\n    this.horrorManager.resetDaily();\n    this.state.fearLevel = Math.max(0, this.state.fearLevel - 0.3);\n\n    // M5: Reset NPC and jump scare systems\n    this.npcManager.resetDaily();\n    this.jumpScareManager.resetDaily();\n\n    // M6: Auto-discover clues and update narrative\n    const newClues = this.clueManager.autoDiscoverForDay(report.day);\n    for (const clue of newClues) {\n      this.addNotification(`🔍 发现线索: ${clue.name}`);\n    }\n    this.storyManager.update(report.day);\n\n    // M6: Check for forced ending on Day 30\n    if (report.day >= 30) {\n      const ending = this.endingSystem.forceEnding(report.day);\n      this.addNotification(`🏁 ${ending.title}`);\n    }\n\n    // M3: Generate day summary with display\n    this.daySummary.generateSummary(report, this.customerManager);\n\n    // Create day summary record\n    const stats = this.customerManager.getStats();\n    this.state.daySummaries.push({\n      day: report.day,\n      revenue: report.revenue,\n      expenses: report.expenses,\n      customersServed: stats.served,\n      customersLost: stats.lost,\n      debtRemaining: report.debtRemaining,\n    });\n\n    this.state.dailyRevenue = 0;\n    this.state.dailyExpenses = 0;\n    this.customerManager.resetDailyStats();\n    this.pricing.resetDailyVelocity();\n\n    this.addNotification(`Day ${report.day} 结算: 收入¥${report.revenue} 支出¥${report.expenses} 债务¥${report.debtRemaining}`);\n\n    // M3: Auto-save after day end\n    this.saveManager.save(this.state);\n\n    // Check game over\n    const gameOver = this.economy.isGameOver();\n    if (gameOver.over) {\n      this.addNotification(`游戏结束: ${gameOver.reason}`);\n    }\n  }\n\n  private addNotification(text: string): void {\n    this.state.notifications.push(text);\n    if (this.state.notifications.length > 10) {\n      this.state.notifications.shift();\n    }\n    this.onNotification?.(text);\n  }\n\n  // Public API for UI interaction\n  stockShelf(shelfId: string, productId: string, quantity: number): void {\n    this.shelfInteraction.stockShelf(shelfId, productId, quantity, this.productManager);\n  }\n\n  unstockShelf(shelfId: string, quantity: number): void {\n    this.shelfInteraction.unstockShelf(shelfId, quantity, this.productManager);\n  }\n\n  orderProduct(productId: string, quantity: number, supplierId: string): boolean {\n    const order = this.productManager.orderProduct(productId, quantity, supplierId, this.state.day);\n    if (order) {\n      this.economy.addPurchaseCost(order.totalCost);\n      this.state.money = this.economy.getMoney();\n      const product = this.productManager.getProduct(productId);\n      this.addNotification(`下单: ${product?.name} x${quantity} — ¥${order.totalCost}`);\n      return true;\n    }\n    return false;\n  }\n\n  purchaseUpgrade(upgradeId: string): { success: boolean; message: string } {\n    const result = this.economy.purchaseUpgrade(upgradeId);\n    if (result.success) {\n      this.state.money = this.economy.getMoney();\n      this.applyUpgrades();\n      this.addNotification(result.message);\n    }\n    return result;\n  }\n\n  purchaseUpgradeM3(upgradeId: string): { success: boolean; message: string } {\n    const result = this.upgradeManager.purchase(upgradeId, this.state.money);\n    if (result.success) {\n      this.economy.addExpense(result.cost);\n      this.state.money = this.economy.getMoney();\n      this.applyUpgrades();\n      this.addNotification(result.message);\n    }\n    return { success: result.success, message: result.message };\n  }\n\n  setProductPrice(productId: string, price: number): boolean {\n    return this.pricing.setPrice(productId, price);\n  }\n\n  centerCamera(): void {\n    this.renderer.camera.snapTo(this.player.x + 16, this.player.y + 16);\n  }\n\n  setTimeSpeed(speed: number): void {\n    this.state.timeSpeed = speed;\n  }\n\n  // M4: Horror audio helpers\n  private triggerHorrorAudio(type: HorrorEventType): void {\n    switch (type) {\n      case HorrorEventType.LIGHT_FLICKER:\n        this.audioManager.playHorrorFlicker();\n        break;\n      case HorrorEventType.FRIDGE_NOISE:\n        this.audioManager.playHorrorJumpScare();\n        break;\n      case HorrorEventType.WHISPER:\n        this.audioManager.playHorrorWhisper();\n        break;\n      case HorrorEventType.DOOR_AUTO_OPEN:\n        this.audioManager.playHorrorDoorCreak();\n        break;\n      case HorrorEventType.GHOST_CUSTOMER:\n      case HorrorEventType.DUPLICATE_CUSTOMER:\n      case HorrorEventType.NONPAYING_CUSTOMER:\n        this.audioManager.playHorrorAmbientDrone();\n        break;\n      case HorrorEventType.STORE_MUTATE:\n      case HorrorEventType.TIME_GLITCH:\n      case HorrorEventType.MIRROR_STORE:\n      case HorrorEventType.HE_COMES:\n      case HorrorEventType.FINAL_CHOICE:\n        this.audioManager.playHorrorJumpScare();\n        break;\n      case HorrorEventType.STALKER:\n      case HorrorEventType.CCTV_DOUBLE:\n      case HorrorEventType.CORRIDOR_EXTEND:\n        this.audioManager.playHorrorAmbientDrone();\n        break;\n      case HorrorEventType.RADIO_VOICE:\n        this.audioManager.playHorrorWhisper();\n        break;\n      default:\n        this.audioManager.playHorrorAmbientDrone();\n        break;\n    }\n  }\n\n  private switchBgmForPhase(phase: GamePhase): void {\n    if (phase === GamePhase.DAYTIME) {\n      this.audioManager.playBgm('daytime');\n    } else if (phase === GamePhase.NIGHT || phase === GamePhase.NIGHT_TRANSITION) {\n      this.audioManager.playBgm('night');\n    } else if (phase === GamePhase.DANGER) {\n      this.audioManager.playBgm('danger');\n    } else {\n      this.audioManager.stopBgm();\n    }\n  }\n\n  // M6: Sync narrative state to game state\n  private syncNarrativeState(): void {\n    this.state.storyLayer = this.storyManager.currentLayer;\n    this.state.cluesFound = this.clueManager.foundCount;\n    this.state.choicesMade = this.narrativeChoices.madeCount;\n    if (this.endingSystem.ending) {\n      this.state.endingType = this.endingSystem.ending.type;\n    }\n  }\n\n  // M6: Public API for narrative interaction\n\n  /** Try to play the next available radio segment */\n  playRadio(): boolean {\n    const seg = this.radioManager.tryPlay(this.state.day, this.state.timeOfDay);\n    return seg !== null;\n  }\n\n  /** Read a discovered note */\n  readNote(noteId: string): boolean {\n    const note = this.noteManager.readNote(noteId, this.state.day);\n    return note !== null;\n  }\n\n  /** Find notes at current player location */\n  searchLocation(location: string): string | null {\n    const note = this.noteManager.findNoteAtLocation(location, this.state.day);\n    return note?.id ?? null;\n  }\n\n  /** Get available narrative choices */\n  getAvailableChoices(): Array<{ id: string; title: string; description: string; options: Array<{ id: string; text: string }> }> {\n    const choices = this.narrativeChoices.getAllAvailable(this.state.day, this.state.phase);\n    return choices.map(c => ({\n      id: c.id,\n      title: c.title,\n      description: c.description,\n      options: c.options.map(o => ({ id: o.id, text: o.text })),\n    }));\n  }\n\n  /** Make a narrative choice */\n  makeNarrativeChoice(choiceId: string, optionId: string): boolean {\n    return this.narrativeChoices.makeChoice(choiceId, optionId, this.state.day);\n  }\n\n  /** Get story summary for HUD */\n  getStorySummary(): string {\n    return this.storyManager.getSummary();\n  }\n\n  /** Get ending progress for HUD */\n  getEndingProgress(): Array<{ title: string; progress: number; hint: string }> {\n    return this.endingSystem.getEndingProgress();\n  }\n\n  /** Get found clues list */\n  getFoundClues(): Array<{ name: string; description: string; acquired: boolean }> {\n    return this.clueManager.getAllFound().map(c => ({\n      name: c.name,\n      description: c.description,\n      acquired: c.acquired,\n    }));\n  }\n}\n","numLines":817,"startLine":1,"totalLines":817}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_b4b3e765d00f466aa46eebb5","type":"tool_result","content":"1\t// AudioManager.ts — Web Audio API sound system with horror effects (M4)\n2\t\n3\texport class AudioManager {\n4\t  private ctx: AudioContext | null = null;\n5\t  private masterGain: GainNode | null = null;\n6\t  private bgmGain: GainNode | null = null;\n7\t  private sfxGain: GainNode | null = null;\n8\t  private volume = 0.7;\n9\t  private bgmVolume = 0.3;\n10\t  private sfxVolume = 0.5;\n11\t  private initialized = false;\n12\t  private currentBgm: 'daytime' | 'night' | 'danger' | 'silence' = 'silence';\n13\t  private bgmOscillators: OscillatorNode[] = [];\n14\t  private bgmNodes: AudioNode[] = [];\n15\t\n16\t  init(): void {\n17\t    if (this.initialized) return;\n18\t    try {\n19\t      this.ctx = new AudioContext();\n20\t      this.masterGain = this.ctx.createGain();\n21\t      this.masterGain.gain.value = this.volume;\n22\t      this.masterGain.connect(this.ctx.destination);\n23\t\n24\t      this.bgmGain = this.ctx.createGain();\n25\t      this.bgmGain.gain.value = this.bgmVolume;\n26\t      this.bgmGain.connect(this.masterGain);\n27\t\n28\t      this.sfxGain = this.ctx.createGain();\n29\t      this.sfxGain.gain.value = this.sfxVolume;\n30\t      this.sfxGain.connect(this.masterGain);\n31\t\n32\t      this.initialized = true;\n33\t    } catch {\n34\t      console.warn('AudioManager: Web Audio API not available');\n35\t    }\n36\t  }\n37\t\n38\t  private ensureCtx(): AudioContext | null {\n39\t    if (!this.initialized) this.init();\n40\t    if (this.ctx?.state === 'suspended') this.ctx.resume();\n41\t    return this.ctx;\n42\t  }\n43\t\n44\t  // --- SFX ---\n45\t\n46\t  playCollect(): void {\n47\t    const ctx = this.ensureCtx();\n48\t    if (!ctx || !this.sfxGain) return;\n49\t    const osc = ctx.createOscillator();\n50\t    const gain = ctx.createGain();\n51\t    osc.type = 'sine';\n52\t    osc.frequency.setValueAtTime(880, ctx.currentTime);\n53\t    osc.frequency.exponentialRampToValueAtTime(1760, ctx.currentTime + 0.1);\n54\t    gain.gain.setValueAtTime(0.2, ctx.currentTime);\n55\t    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.15);\n56\t    osc.connect(gain).connect(this.sfxGain);\n57\t    osc.start();\n58\t    osc.stop(ctx.currentTime + 0.15);\n59\t  }\n60\t\n61\t  playBuild(): void {\n62\t    const ctx = this.ensureCtx();\n63\t    if (!ctx || !this.sfxGain) return;\n64\t    const osc = ctx.createOscillator();\n65\t    const gain = ctx.createGain();\n66\t    osc.type = 'square';\n67\t    osc.frequency.setValueAtTime(220, ctx.currentTime);\n68\t    osc.frequency.setValueAtTime(330, ctx.currentTime + 0.08);\n69\t    osc.frequency.setValueAtTime(440, ctx.currentTime + 0.16);\n70\t    gain.gain.setValueAtTime(0.15, ctx.currentTime);\n71\t    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.25);\n72\t    osc.connect(gain).connect(this.sfxGain);\n73\t    osc.start();\n74\t    osc.stop(ctx.currentTime + 0.25);\n75\t  }\n76\t\n77\t  playTransaction(): void {\n78\t    const ctx = this.ensureCtx();\n79\t    if (!ctx || !this.sfxGain) return;\n80\t    const osc = ctx.createOscillator();\n81\t    const gain = ctx.createGain();\n82\t    osc.type = 'sine';\n83\t    osc.frequency.setValueAtTime(660, ctx.currentTime);\n84\t    osc.frequency.setValueAtTime(880, ctx.currentTime + 0.06);\n85\t    gain.gain.setValueAtTime(0.15, ctx.currentTime);\n86\t    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.12);\n87\t    osc.connect(gain).connect(this.sfxGain);\n88\t    osc.start();\n89\t    osc.stop(ctx.currentTime + 0.12);\n90\t  }\n91\t\n92\t  playBreakthrough(): void {\n93\t    const ctx = this.ensureCtx();\n94\t    if (!ctx || !this.sfxGain) return;\n95\t    // Rising tone\n96\t    const osc = ctx.createOscillator();\n97\t    const gain = ctx.createGain();\n98\t    osc.type = 'sine';\n99\t    osc.frequency.setValueAtTime(200, ctx.currentTime);\n100\t    osc.frequency.exponentialRampToValueAtTime(1200, ctx.currentTime + 0.8);\n101\t    gain.gain.setValueAtTime(0.3, ctx.currentTime);\n102\t    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.0);\n103\t    osc.connect(gain).connect(this.sfxGain);\n104\t    osc.start();\n105\t    osc.stop(ctx.currentTime + 1.0);\n106\t\n107\t    // Shimmer\n108\t    for (let i = 0; i < 5; i++) {\n109\t      const s = ctx.createOscillator();\n110\t      const sg = ctx.createGain();\n111\t      s.type = 'sine';\n112\t      s.frequency.value = 800 + i * 200;\n113\t      sg.gain.setValueAtTime(0, ctx.currentTime + 0.4 + i * 0.1);\n114\t      sg.gain.linearRampToValueAtTime(0.1, ctx.currentTime + 0.5 + i * 0.1);\n115\t      sg.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.2 + i * 0.1);\n116\t      s.connect(sg).connect(this.sfxGain);\n117\t      s.start(ctx.currentTime + 0.4 + i * 0.1);\n118\t      s.stop(ctx.currentTime + 1.3 + i * 0.1);\n119\t    }\n120\t  }\n121\t\n122\t  // --- Horror SFX ---\n123\t\n124\t  playHorrorFlicker(): void {\n125\t    const ctx = this.ensureCtx();\n126\t    if (!ctx || !this.sfxGain) return;\n127\t    // Buzzing electrical sound\n128\t    const osc = ctx.createOscillator();\n129\t    const gain = ctx.createGain();\n130\t    osc.type = 'sawtooth';\n131\t    osc.frequency.setValueAtTime(60, ctx.currentTime);\n132\t    osc.frequency.linearRampToValueAtTime(120, ctx.currentTime + 0.1);\n133\t    osc.frequency.linearRampToValueAtTime(60, ctx.currentTime + 0.2);\n134\t    gain.gain.setValueAtTime(0.08, ctx.currentTime);\n135\t    gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 0.3);\n136\t    osc.connect(gain).connect(this.sfxGain);\n137\t    osc.start();\n138\t    osc.stop(ctx.currentTime + 0.3);\n139\t  }\n140\t\n141\t  playHorrorWhisper(): void {\n142\t    const ctx = this.ensureCtx();\n143\t    if (!ctx || !this.sfxGain) return;\n144\t    // Filtered noise for whisper effect\n145\t    const bufferSize = ctx.sampleRate * 1.5;\n146\t    const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);\n147\t    const data = buffer.getChannelData(0);\n148\t    for (let i = 0; i < bufferSize; i++) {\n149\t      data[i] = (Math.random() * 2 - 1) * 0.3;\n150\t    }\n151\t    const source = ctx.createBufferSource();\n152\t    source.buffer = buffer;\n153\t    const filter = ctx.createBiquadFilter();\n154\t    filter.type = 'bandpass';\n155\t    filter.frequency.value = 800;\n156\t    filter.Q.value = 2;\n157\t    const gain = ctx.createGain();\n158\t    gain.gain.setValueAtTime(0, ctx.currentTime);\n159\t    gain.gain.linearRampToValueAtTime(0.15, ctx.currentTime + 0.5);\n160\t    gain.gain.linearRampToValueAtTime(0.1, ctx.currentTime + 1.0);\n161\t    gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 1.5);\n162\t    source.connect(filter).connect(gain).connect(this.sfxGain);\n163\t    source.start();\n164\t    source.stop(ctx.currentTime + 1.5);\n165\t  }\n166\t\n167\t  playHorrorDoorCreak(): void {\n168\t    const ctx = this.ensureCtx();\n169\t    if (!ctx || !this.sfxGain) return;\n170\t    // Low creaking sound\n171\t    const osc = ctx.createOscillator();\n172\t    const gain = ctx.createGain();\n173\t    osc.type = 'sawtooth';\n174\t    osc.frequency.setValueAtTime(40, ctx.currentTime);\n175\t    osc.frequency.linearRampToValueAtTime(80, ctx.currentTime + 0.5);\n176\t    osc.frequency.linearRampToValueAtTime(50, ctx.currentTime + 1.0);\n177\t    gain.gain.setValueAtTime(0.1, ctx.currentTime);\n178\t    gain.gain.linearRampToValueAtTime(0.15, ctx.currentTime + 0.3);\n179\t    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.2);\n180\t    const filter = ctx.createBiquadFilter();\n181\t    filter.type = 'lowpass';\n182\t    filter.frequency.value = 300;\n183\t    osc.connect(filter).connect(gain).connect(this.sfxGain);\n184\t    osc.start();\n185\t    osc.stop(ctx.currentTime + 1.2);\n186\t  }\n187\t\n188\t  playHorrorSuddenSilence(): void {\n189\t    // The absence of