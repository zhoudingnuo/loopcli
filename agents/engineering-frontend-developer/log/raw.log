on() {\n183\t    switch (this.goalType) {\n184\t      case 'score':\n185\t        return `分数 ${this.goalProgress}/${this.goalTarget}`;\n186\t      case 'collect_color': {\n187\t        const names = this.collectColors.map(c => COLOR_MAP[c]?.label || '?').join('+');\n188\t        return `收集${names} ${this.goalProgress}/${this.goalTarget}`;\n189\t      }\n190\t      case 'clear_obstacle': {\n191\t        const label = this.clearObstacleType === 1 ? '冰块' :\n192\t                      this.clearObstacleType === 2 ? '锁链' :\n193\t                      this.clearObstacleType === 3 ? '巧克力' : '障碍';\n194\t        return `清除${label} ${this.goalProgress}/${this.goalTarget}`;\n195\t      }\n196\t      case 'boss':\n197\t        return '击败Boss';\n198\t      case 'dual':\n199\t        return this.dualGoals.map(g => {\n200\t          if (g.type === 'score') return `分数 ${this.score}/${g.target}`;\n201\t          if (g.type === 'collect_color') {\n202\t            const names = g.colors.map(c => COLOR_MAP[c]?.label || '?').join('+');\n203\t            return `收集${names} ${g.progress}/${g.target}`;\n204\t          }\n205\t          if (g.type === 'clear_obstacle') return `清除障碍 ${g.progress}/${g.target}`;\n206\t          return '';\n207\t        }).join(' | ');\n208\t      default:\n209\t        return '';\n210\t    }\n211\t  }\n212\t\n213\t  getProgressForUI() {\n214\t    if (this.goalType === 'dual') {\n215\t      return this.dualGoals.map(g => ({\n216\t        label: g.type === 'score' ? '分数' :\n217\t               g.type === 'collect_color' ? '收集' : '清除',\n218\t        current: g.progress,\n219\t        target: g.target,\n220\t      }));\n221\t    }\n222\t    return [{ label: '', current: this.goalProgress, target: this.goalTarget }];\n223\t  }\n224\t\n225\t  checkState() {\n226\t    if (this.isGoalComplete()) {\n227\t      if (this.onLevelComplete) this.onLevelComplete(this.score, this.getStarCount());\n228\t      return 'complete';\n229\t    }\n230\t    if (this.isGameOver()) {\n