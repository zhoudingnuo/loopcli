used = p;\n  }\n\n  getEffectiveTimeSpeed(): number {\n    const config = DAY_PHASES.find(p => p.phase === this.phase);\n    return config?.timeSpeed ?? this.baseTimeSpeed;\n  }\n\n  update(dtMs: number): void {\n    if (this.paused) return;\n\n    const dtSec = dtMs / 1000;\n    const speed = this.getEffectiveTimeSpeed();\n    this.timeOfDay += dtSec * speed * 0.05;\n\n    const prevPhase = this.phase;\n    this.phase = getPhaseFromTime(this.timeOfDay);\n\n    if (this.phase !== prevPhase) {\n      for (const listener of this.phaseListeners) {\n        listener(this.phase, prevPhase, this.day, this.timeOfDay);\n      }\n    }\n\n    if (this.timeOfDay >= 30) {\n      this.timeOfDay -= 24;\n      this.day++;\n      for (const listener of this.newDayListeners) {\n        listener(this.day);\n      }\n    }\n  }\n\n  getPhaseLabel(): string {\n    const config = DAY_PHASES.find(p => p.phase === this.phase);\n    return config?.label ?? this.phase;\n  }\n\n  getDayProgress(): number {\n    return (this.timeOfDay - 6) / 24;\n  }\n\n  getDaylight(): number {\n    if (this.timeOfDay >= 6 && this.timeOfDay < 18) {\n      if (this.timeOfDay < 7) return (this.timeOfDay - 6);\n      if (this.timeOfDay > 17) return (18 - this.timeOfDay);\n      return 1;\n    }\n    return 0;\n  }\n\n  getState(): { day: number; timeOfDay: number; phase: GamePhase } {\n    return { day: this.day, timeOfDay: this.timeOfDay, phase: this.phase };\n  }\n}\n","numLines":110,"startLine":1,"totalLines":110}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_cc93fb61ac8e4f34b20be73a","type":"tool_result","content":"1\t// Lighting.ts — 2D lighting with day/night gradual transitions (v0.3.0 — M3)\n2\t\n3\timport type { LightSource, GamePhase } from '../game/GameState';\n4\timport { isNightTime } from '../game/GameState';\n5\t\n6\texport class Lighting {\n7\t  private lightCanvas: HTMLCanvasElement;\n8\t  private lightCtx: CanvasRenderingContext2D;\n9\t  private lightBoost = 1.0;\n10\t\n11\t  constructor() {\n12\t    this.lightCanvas = document.createElement('canvas');\n13\t    this.lightCtx = this.lightCanvas.getContext('2d')!;\n14\t  }\n15\t\n16\t  setLightBoost(boost: number): void {\n17\t    this.lightBoost = boost;\n18\t  }\n19\t\n20\t  private getDaylightFactor(timeOfDay: number): number {\n21\t    if (timeOfDay >= 6 && timeOfDay < 7) return timeOfDay - 6;\n22\t    if (timeOfDay >= 7 && timeOfDay < 17) return 1;\n23\t    if (timeOfDay >= 17 && timeOfDay < 18) return 18 - timeOfDay;\n24\t    return 0;\n25\t  }\n26\t\n27\t  private getDarknessLevel(phase: GamePhase, timeOfDay: number): number {\n28\t    const daylight = this.getDaylightFactor(timeOfDay);\n29\t    if (daylight >= 1) return 0;\n30\t\n31\t    let nightDarkness = 0;\n32\t    if (phase === 'night_transition') nightDarkness = 0.3;\n33\t    else if (phase === 'night') nightDarkness = 0.6;\n34\t    else if (phase === 'danger') nightDarkness = 0.85;\n35\t    else if (phase === 'dawn') {\n36\t      if (timeOfDay >= 29) nightDarkness = Math.max(0, 0.4 * (30 - timeOfDay));\n37\t      else nightDarkness = 0.4;\n38\t    }\n39\t\n40\t    if (daylight > 0) return nightDarkness * (1 - daylight);\n41\t    return nightDarkness;\n42\t  }\n43\t\n44\t  render(\n45\t    ctx: CanvasRenderingContext2D,\n46\t    width: number,\n47\t    height: number,\n48\t    lights: LightSource[],\n49\t    phase: GamePhase,\n50\t    offsetX: number,\n51\t    offsetY: number,\n52\t    scale: number,\n53\t    now: number,\n54\t    timeOfDay?: number,\n55\t  ): void {\n56\t    const tod = timeOfDay ?? 12;\n57\t    const daylight = this.getDaylightFactor(tod);\n58\t\n59\t    if (daylight >= 1) {\n60\t      this.renderDayOverlay(ctx, width, height);\n61\t      return;\n62\t    }\n63\t\n64\t    const darkness = this.getDarknessLevel(phase, tod);\n65\t    if (darkness <= 0 && daylight > 0) {\n66\t      this.renderTransitionOverlay(ctx, width, height, daylight);\n67\t      return;\n68\t    }\n69\t\n70\t    this.lightCanvas.width = width;\n71\t    this.lightCanvas.height = height;\n72\t    const lctx = this.lightCtx;\n73\t\n74\t    lctx.fillStyle = `rgba(5, 5, 20, ${darkness})`;\n75\t    lctx.fillRect(0, 0, width, height);\n76\t\n77\t    lctx.globalCompositeOperation = 'destination-out';\n78\t\n79\t    for (const light of lights) {\n80\t      const screenX = offsetX + light.x * scale;\n81\t      const screenY = offsetY + light.y * scale;\n82\t      const radius = light.radius * scale * this.lightBoost;\n83\t      let intensity = light.intensity;\n84\t\n85\t      if (daylight > 0) {\n86\t        intensity *= (1 - daylight);\n87\t      }\n88\t\n89\t      if (light.flicker) {\n90\t        const flicker = Math.sin(now * light.flickerSpeed * 0.001) * 0.1 +\n91\t          Math.sin(now * light.flickerSpeed * 0.003) * 0.05;\n92\t        intensity = Math.max(0.3, Math.min(1, intensity + flicker));\n93\t      }\n94\t\n95\t      const gradient = lctx.createRadialGradient(screenX, screenY, 0, screenX, screenY, radius);\n96\t      gradient.addColorStop(0, `rgba(0, 0, 0, ${intensity})`);\n97\t      gradient.addColorStop(0.4, `rgba(0, 0, 0, ${intensity * 0.6})`);\n98\t      gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');\n99\t\n100\t      lctx.fillStyle = gradient;\n101\t      lctx.beginPath();\n102\t      lctx.arc(screenX, screenY, radius, 0, Math.PI * 2);\n103\t      lctx.fill();\n104\t    }\n105\t\n106\t    lctx.globalCompositeOperation = 'source-over';\n107\t\n108\t    lctx.globalCompositeOperation = 'source-atop';\n109\t    const tintAlpha = darkness * 0.15;\n110\t    lctx.fillStyle = `rgba(20, 40, 80, ${tintAlpha})`;\n111\t    lctx.fillRect(0, 0, width, height);\n112\t    lctx.globalCompositeOperation = 'source-over';\n113\t\n114\t    ctx.drawImage(this.lightCanvas, 0, 0);\n115\t  }\n116\t\n117\t  private renderDayOverlay(ctx: CanvasRenderingContext2D, w: number, h: number): void {\n118\t    ctx.fillStyle = 'rgba(255, 240, 200, 0.04)';\n119\t    ctx.fillRect(0, 0, w, h);\n120\t  }\n121\t\n122\t  private renderTransitionOverlay(ctx: CanvasRenderingContext2D, w: number, h: number, daylight: number): void {\n123\t    const alpha = (1 - daylight) * 0.1;\n124\t    ctx.fillStyle = `rgba(20, 20, 40, ${alpha})`;\n125\t    ctx.fillRect(0, 0, w, h);\n126\t  }\n127\t}\n128\t"}]},"parent_tool_use_id":null,"session_id":"392f64db-fdde-44d3-ac09-12e89ef6a334","uuid":"cc0fd9f7-d77a-40ee-81f8-d8dbc79da52f","timestamp":"2026-05-23T04:48:20.788Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-horror-sim\\src\\renderer\\Lighting.ts","content":"// Lighting.ts — 2D lighting with day/night gradual transitions (v0.3.0 — M3)\n\nimport type { LightSource, GamePhase } from '../game/GameState';\nimport { isNightTime } from '../game/GameState';\n\nexport class Lighting {\n  private lightCanvas: HTMLCanvasElement;\n  private lightCtx: CanvasRenderingContext2D;\n  private lightBoost = 1.0;\n\n  constructor() {\n    this.lightCanvas = document.createElement('canvas');\n    this.lightCtx = this.lightCanvas.getContext('2d')!;\n  }\n\n  setLightBoost(boost: number): void {\n    this.lightBoost = boost;\n  }\n\n  private getDaylightFactor(timeOfDay: number): number {\n    if (timeOfDay >= 6 && timeOfDay < 7) return timeOfDay - 6;\n    if (timeOfDay >= 7 && timeOfDay < 17) return 1;\n    if (timeOfDay >= 17 && timeOfDay < 18) return 18 - timeOfDay;\n    return 0;\n  }\n\n  private getDarknessLevel(phase: GamePhase, timeOfDay: number): number {\n    const daylight = this.getDaylightFactor(timeOfDay);\n    if (daylight >= 1) return 0;\n\n    let nightDarkness = 0;\n    if (phase === 'night_transition') nightDarkness = 0.3;\n    else if (phase === 'night') nightDarkness = 0.6;\n    else if (phase === 'danger') nightDarkness = 0.85;\n    else if (phase === 'dawn') {\n      if (timeOfDay >= 29) nightDarkness = Math.max(0, 0.4 * (30 - timeOfDay));\n      else nightDarkness = 0.4;\n    }\n\n    if (daylight > 0) return nightDarkness * (1 - daylight);\n    return nightDarkness;\n  }\n\n  render(\n    ctx: CanvasRenderingContext2D,\n    width: number,\n    height: number,\n    lights: LightSource[],\n    phase: GamePhase,\n    offsetX: number,\n    offsetY: number,\n    scale: number,\n    now: number,\n    timeOfDay?: number,\n  ): void {\n    const tod = timeOfDay ?? 12;\n    const daylight = this.getDaylightFactor(tod);\n\n    if (daylight >= 1) {\n      this.renderDayOverlay(ctx, width, height);\n      return;\n    }\n\n    const darkness = this.getDarknessLevel(phase, tod);\n    if (darkness <= 0 && daylight > 0) {\n      this.renderTransitionOverlay(ctx, width, height, daylight);\n      return;\n    }\n\n    this.lightCanvas.width = width;\n    this.lightCanvas.height = height;\n    const lctx = this.lightCtx;\n\n    lctx.fillStyle = `rgba(5, 5, 20, ${darkness})`;\n    lctx.fillRect(0, 0, width, height);\n\n    lctx.globalCompositeOperation = 'destination-out';\n\n    for (const light of lights) {\n      const screenX = offsetX + light.x * scale;\n      const screenY = offsetY + light.y * scale;\n      const radius = light.radius * scale * this.lightBoost;\n      let intensity = light.intensity;\n\n      if (daylight > 0) {\n        intensity *= (1 - daylight);\n      }\n\n      if (light.flicker) {\n        const flicker = Math.sin(now * light.flickerSpeed * 0.001) * 0.1 +\n          Math.sin(now * light.flickerSpeed * 0.003) * 0.05;\n        intensity = Math.max(0.3, Math.min(1, intensity + flicker));\n      }\n\n      const gradient = lctx.createRadialGradient(screenX, screenY, 0, screenX, screenY, radius);\n      gradient.addColorStop(0, `rgba(0, 0, 0, ${intensity})`);\n      gradient.addColorStop(0.4, `rgba(0, 0, 0, ${intensity * 0.6})`);\n      gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');\n\n      lctx.fillStyle = gradient;\n      lctx.beginPath();\n      lctx.arc(screenX, screenY, radius, 0, Math.PI * 2);\n      lctx.fill();\n    }\n\n    lctx.globalCompositeOperation = 'source-over';\n\n    lctx.globalCompositeOperation = 'source-atop';\n    const tintAlpha = darkness * 0.15;\n    lctx.fillStyle = `rgba(20, 40, 80, ${tintAlpha})`;\n    lctx.fillRect(0, 0, width, height);\n    lctx.globalCompositeOperation = 'source-over';\n\n    ctx.drawImage(this.lightCanvas, 0, 0);\n  }\n\n  private renderDayOverlay(ctx: CanvasRenderingContext2D, w: number, h: number): void {\n    ctx.fillStyle = 'rgba(255, 240, 200, 0.04)';\n    ctx.fillRect(0, 0, w, h);\n  }\n\n  private renderTransitionOverlay(ctx: CanvasRenderingContext2D, w: number, h: number, daylight: number): void {\n    const alpha = (1 - daylight) * 0.1;\n    ctx.fillStyle = `rgba(20, 20, 40, ${alpha})`;\n    ctx.fillRect(0, 0, w, h);\n  }\n}\n","numLines":128,"startLine":1,"totalLines":128}}}
