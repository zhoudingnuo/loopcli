)){game.timed.end();game.goToMenu()}\">✕</button>\n        <div class=\"header-center\">\n          <span id=\"timed-timer\" class=\"timer-display\">60s</span>\n        </div>\n        <div class=\"header-right\">\n          <span>得分: <span id=\"timed-score\">0</span></span>\n        </div>\n      </div>\n      <div class=\"game-body\">\n        <div id=\"timed-combo\" class=\"combo-display\"></div>\n        <div class=\"meaning-box\"><span id=\"timed-meaning\"></span></div>\n        <div id=\"timed-slots\" class=\"slots-container\"></div>\n        <div id=\"timed-candidates\" class=\"candidates-container\"></div>\n      </div>\n      <div class=\"game-footer\">\n        <button class=\"tool-btn\" onclick=\"game.timed.useHintReveal()\">📖 揭示</button>\n        <button class=\"tool-btn\" onclick=\"game.timed.useHintRemove()\">✂️ 去干扰</button>\n      </div>\n    </div>\n\n    <!-- W2: 限时挑战结算 -->\n    <div id=\"timed-result-screen\" class=\"screen\">\n      <div class=\"result-card\">\n        <h2 class=\"result-title\">⏱ 限时挑战结束</h2>\n        <div class=\"result-stats\">\n          <p>得分: <span id=\"tr-score\">0</span></p>\n          <p>正确: <span id=\"tr-correct\">0</span> / <span id=\"tr-total\">0</span></p>\n          <p>最大连击: <span id=\"tr-combo\">0</span></p>\n          <p class=\"coins-earned\">🪙 +<span id=\"tr-coins\">0</span></p>\n        </div>\n        <div class=\"result-buttons\">\n          <button class=\"btn btn-primary\" onclick=\"game.goToMenu()\">返回</button>\n          <button class=\"btn btn-accent\" onclick=\"game.startTimedChallenge()\">再来一次</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- ===== W2: 成语图鉴 ===== -->\n    <div id=\"collection-screen\" class=\"screen\">\n      <div class=\"map-header\">\n        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n        <h2>成语图鉴</h2>\n        <span id=\"col-progress\">0/0</span>\n      </div>\n      <div class=\"col-bar-wrap\">\n        <div class=\"col-bar\"><div id=\"col-