{"type":"assistant","message":{"id":"msg_20260523050858f9ccb5e83d76445c","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_569ce59e0f4a4fcbaea069ab","name":"Write","input":{"file_path":"D:/game-projects/douyin-match3/src/js/ScoreSystem.js","content":"// ScoreSystem.js — Score calculation, move tracking, level goals, star rating\n\nclass ScoreSystem {\n  constructor() {\n    this.score = 0;\n    this.moves = 0;\n    this.maxMoves = 30;\n    this.goalType = 'score';    // 'score' | 'collect' | 'clear'\n    this.goalTarget = 1000;\n    this.goalProgress = 0;\n    this.level = 1;\n    this.stars = [0, 0, 0];    // 1/2/3 star thresholds\n    this.collected = {};        // color -> count for collect goals\n    this.chainCount = 0;\n    this.onScoreChange = null;\n    this.onMovesChange = null;\n    this.onLevelComplete = null;\n    this.onLevelFail = null;\n  }\n\n  reset(level = 1) {\n    this.score = 0;\n    this.moves = 0;\n    this.goalProgress = 0;\n    this.chainCount = 0;\n    this.collected = {};\n    this.level = level;\n  }\n\n  configure(config) {\n    this.maxMoves = config.moves || 30;\n    this.goalType = config.goal?.type || 'score';\n    this.goalTarget = config.goal?.target || 1000;\n    this.stars = config.stars || [1000, 1500, 2000];\n  }\n\n  useMove() {\n    this.moves++;\n    if (this.onMovesChange) this.onMovesChange(this.getRemainingMoves());\n    return this.getRemainingMoves() >= 0;\n  }\n\n  getRemainingMoves() {\n    return this.maxMoves - this.moves;\n  }\n\n  addScore(points) {\n    this.score += points;\n    if (this.goalType === 'score') {\n      this.goalProgress = this.score;\n    }\n    if (this.onScoreChange) this.onScoreChange(this.score);\n  }\n\n  addChainScore(basePoints, chainLevel) {\n    const multiplier = chainLevel <= 1 ? 1 : chainLevel === 2 ? 1.5 : chainLevel === 3 ? 2.0 : 2.5;\n    const points = Math.floor(basePoints * multiplier);\n    this.addScore(points);\n    this.chainCount = Math.max(this.chainCount, chainLevel);\n    return points;\n  }\n\n  addCollected(color, count) {\n    this.collected[color] = (this.collected[color] || 0) + count;\n    if (this.goalType === 'collect') {\n      this.goalProgress = Object.values(this.collected).reduce((a, b) => a + b, 0);\n    }\n  }\n\n  getStarCount() {\n    if (this.score >= this.stars[2]) return 3;\n    if (this.score >= this.stars[1]) return 2;\n    if (this.score >= this.stars[0]) return 1;\n    return 0;\n  }\n\n  isGoalComplete() {\n    switch (this.goalType) {\n      case 'score': return this.score >= this.goalTarget;\n      case 'collect': return this.goalProgress >= this.goalTarget;\n      default: return false;\n    }\n  }\n\n  isGameOver() {\n    return this.getRemainingMoves() <= 0 && !this.isGoalComplete();\n  }\n\n  checkState() {\n    if (this.isGoalComplete()) {\n      if (this.onLevelComplete) this.onLevelComplete(this.score, this.getStarCount());\n      return 'complete';\n    }\n    if (this.isGameOver()) {\n      if (this.onLevelFail) this.onLevelFail(this.score);\n      return 'fail';\n    }\n    return 'playing';\n  }\n}\n\n// Level data generator for first 10 levels\nfunction generateLevels() {\n  return [\n    { id: 1, goal: { type: 'score', target: 1000 }, moves: 30, stars: [1000, 1500, 2000] },\n    { id: 2, goal: { type: 'score', target: 1500 }, moves: 28, stars: [1500, 2200, 3000] },\n    { id: 3, goal: { type: 'score', target: 2000 }, moves: 25, stars: [2000, 3000, 4000] },\n    { id: 4, goal: { type: 'score', target: 2000 }, moves: 25, stars: [2000, 3000, 4000] },\n    { id: 5, goal: { type: 'score', target: 2500 }, moves: 25, stars: [2500, 3500, 4500] },\n    { id: 6, goal: { type: 'score', target: 2500 }, moves: 25, stars: [2500, 3500, 4500] },\n    { id: 7, goal: { type: 'score', target: 3000 }, moves: 22, stars: [3000, 4000, 5500] },\n    { id: 8, goal: { type: 'score', target: 3000 }, moves: 22, stars: [3000, 4000, 5500] },\n    { id: 9, goal: { type: 'score', target: 3500 }, moves: 25, stars: [3500, 5000, 6500] },\n    { id: 10, goal: { type: 'score', target: 3500 }, moves: 20, stars: [3500, 5000, 6500] },\n  ];\n}\n\nif (typeof module !== 'undefined') module.exports = { ScoreSystem, generateLevels };\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"ef939699-9dac-4e19-a950-f991f68c1f56","uuid":"7eecadfa-277a-4795-801b-b3ebc6276b07"}
