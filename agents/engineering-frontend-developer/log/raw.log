click=\"alert('限时挑战即将开放')\">限时挑战</button>\n        </div>\n        <div class=\"menu-footer\">\n          <button class=\"btn-icon\" onclick=\"game.audio.toggle(); this.textContent = game.audio.enabled ? '🔊' : '🔇'\">🔊</button>\n          <button class=\"btn-icon\" onclick=\"game.data.reset(); location.reload()\">🔄</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- 关卡地图 -->\n    <div id=\"map-screen\" class=\"screen\">\n      <div class=\"map-header\">\n        <button class=\"btn-back\" onclick=\"game.goToMenu()\">← 返回</button>\n        <h2>选择关卡</h2>\n        <span>🪙 <span id=\"map-coins\">0</span></span>\n      </div>\n      <div id=\"chapter-info\" class=\"chapter-info\"></div>\n      <div id=\"level-grid\" class=\"level-grid\"></div>\n    </div>\n\n    <!-- 游戏界面 -->\n    <div id=\"game-screen\" class=\"screen\">\n      <div class=\"game-header\">\n        <button class=\"btn-back\" onclick=\"if(confirm('确定退出？')) game.goToMenu()\">✕</button>\n        <div class=\"header-center\">\n          <span id=\"level-label\">第1关</span>\n          <span id=\"progress-label\">1/10</span>\n        </div>\n        <div class=\"header-right\">\n          <span id=\"lives-display\">❤️❤️❤️❤️❤️</span>\n        </div>\n      </div>\n\n      <div class=\"game-body\">\n        <div id=\"combo-display\" class=\"combo-display\"></div>\n        <div id=\"meaning-box\" class=\"meaning-box\">\n          <span id=\"meaning-text\"></span>\n        </div>\n        <div id=\"slots-container\" class=\"slots-container\"></div>\n        <div id=\"idiom-hint\" class=\"idiom-hint\"></div>\n        <div id=\"candidates-container\" class=\"candidates-container\"></div>\n      </div>\n\n      <div class=\"game-footer\">\n        <button class=\"tool-btn\" onclick=\"handleHintReveal()\">📖 揭示</button>\n        <button class=\"tool-btn\" onclick=\"handleHintRemove()\">✂️ 去干扰</button>\n        <button class=\"tool-btn\" onclick=\"handleSkip()\">⏭ 跳过</button>\n      </div>\n\n      <!-- 教学覆盖层 -->\n      <div id=\"tutorial-overlay\" class=\"tutorial-overlay\" style=\"display:none\">\n        <div class=\"tutorial-arrow\"></div>\n        <div id=\"tutorial-text\" class=\"tutorial-text\"></div>\n      </div>\n    </div>\n\n    <!-- 结算界面 -->\n    <div id=\"result-screen\" class=\"screen\">\n      <div class=\"result-card\">\n        <h2 id=\"result-title\" class=\"result-title\">通关!</h2>\n        <div id=\"result-stars\" class=\"result-stars\"></div>\n        <div class=\"result-stats\">\n          <p>正确: <span id=\"result-correct\">0</span> / <span id=\"result-total\">10</span></p>\n          <p>得分: <span id=\"result-score\">0</span></p>\n          <p>最大连击: <span id=\"result-combo\">0</span></p>\n          <p class=\"coins-earned\">🪙 +<span id=\"result-coins\">0</span></p>\n        </div>\n        <div class=\"result-buttons\">\n          <button class=\"btn btn-primary\" onclick=\"game.goToMenu()\">返回地图</button>\n          <button class=\"btn btn-secondary\" id=\"btn-retry\" onclick=\"game.startLevel(game.currentLevel.id)\">重新挑战</button>\n          <button class=\"btn btn-accent\" id=\"btn-next\" onclick=\"game.startLevel(game.currentLevel.id + 1)\">下一关</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- 续命弹窗 -->\n    <div id=\"continue-modal\" class=\"modal\" style=\"display:none\">\n      <div class=\"modal-content\">\n        <h3>挑战失败</h3>\n        <p>生命值耗尽了！</p>\n        <div class=\"modal-buttons\">\n          <button class=\"btn btn-secondary\" onclick=\"game.finishLevel(); document.getElementById('continue-modal').style.display='none'\">放弃</button>\n          <button class=\"btn btn-primary\" onclick=\"game.continueWithAd(); document.getElementById('continue-modal').style.display='none'\">看视频续命 ❤️×3</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <script src=\"src/js/IdiomDBExtra.js\"></script>\n  <script src=\"src/js/IdiomDB.js\"></script>\n  <script src=\"src/js/levels.js\"></script>\n  <script src=\"src/js/IdiomEngine.js\"></script>\n  <script src=\"src/js/Judge.js\"></script>\n  <script src=\"src/js/ComboSystem.js\"></script>\n  <script src=\"src/js/DataManager.js\"></script>\n  <script src=\"src/js/Tutorial.js\"></script>\n  <script src=\"src/js/AudioManager.js\"></script>\n  <script src=\"src/js/Game.js\"></script>\n  <script src=\"src/js/Renderer.js\"></script>\n  <script>\n    const game = new Game();\n    game.audio.init();\n    renderUI(game);\n  </script>\n</body>\n</html>\n","userModified":false}}
