or((timeOfDay % 1) * 60);\n224\t  return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;\n225\t}\n226\t\n227\texport function getPhaseFromTime(timeOfDay: number): GamePhase {\n228\t  if (timeOfDay >= 6 && timeOfDay < 22) return GamePhase.DAYTIME;\n229\t  if (timeOfDay >= 22 && timeOfDay < 23) return GamePhase.NIGHT_TRANSITION;\n230\t  if (timeOfDay >= 23 || timeOfDay < 2) return GamePhase.NIGHT;\n231\t  if (timeOfDay >= 2 && timeOfDay < 5) return GamePhase.DANGER;\n232\t  return GamePhase.DAWN;\n233\t}\n234\t\n235\texport function isNightTime(phase: GamePhase): boolean {\n236\t  return phase === GamePhase.NIGHT_TRANSITION ||\n237\t    phase === GamePhase.NIGHT ||\n238\t    phase === GamePhase.DANGER;\n239\t}\n240\t"}]},"parent_tool_use_id":null,"session_id":"e8f5bde0-4da8-4c4a-9322-50945e66ead7","uuid":"42786c19-6e1d-4b76-abb9-b2f5cdac4520","timestamp":"2026-05-23T04:37:11.584Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-horror-sim\\src\\game\\GameState.ts","content":"// GameState.ts — Game state with save/load interface (v0.2.0 — M2)\n\nexport enum GamePhase {\n  MENU = 'menu',\n  DAYTIME = 'daytime',\n  NIGHT_TRANSITION = 'night_transition',\n  NIGHT = 'night',\n  DANGER = 'danger',\n  DAWN = 'dawn',\n  PAUSED = 'paused',\n}\n\nexport enum UIPanel {\n  NONE = 'none',\n  INVENTORY = 'inventory',\n  SHELF = 'shelf',\n  PRICING = 'pricing',\n  SHOP = 'shop',\n  SUPPLIER = 'supplier',\n  REGISTER = 'register',\n}\n\nexport interface Position {\n  x: number;\n  y: number;\n}\n\nexport interface PlayerState {\n  x: number;\n  y: number;\n  speed: number;\n  direction: 'up' | 'down' | 'left' | 'right';\n  money: number;\n  debt: number;\n  day: number;\n  health: number;\n  sanity: number;\n}\n\nexport interface LightSource {\n  x: number;\n  y: number;\n  radius: number;\n  color: string;\n  intensity: number;\n  flicker: boolean;\n  flickerSpeed: number;\n}\n\nexport interface Interactable {\n  id: string;\n  type: 'shelf' | 'register' | 'door' | 'fridge' | 'storage' | 'phone' | 'radio' | 'note';\n  x: number;\n  y: number;\n  width: number;\n  height: number;\n  label: string;\n  active: boolean;\n}\n\nexport interface DaySummary {\n  day: number;\n  revenue: number;\n  expenses: number;\n  customersServed: number;\n  customersLost: number;\n  debtRemaining: number;\n}\n\nexport interface GameState {\n  phase: GamePhase;\n  activePanel: UIPanel;\n  player: PlayerState;\n  day: number;\n  timeOfDay: number; // 0-24 hours (6=6am, 23=11pm etc)\n  timeSpeed: number;\n  lights: LightSource[];\n  interactables: Interactable[];\n  totalPlaytime: number;\n  lastSaveTime: number;\n  version: string;\n\n  // M2: Economy\n  money: number;\n  debt: number;\n  dailyRevenue: number;\n  dailyExpenses: number;\n\n  // M2: Notifications\n  notifications: string[];\n  daySummaries: DaySummary[];\n}\n\nexport interface SaveData {\n  version: string;\n  timestamp: number;\n  playtime: number;\n  gameState: GameState;\n  productManager: Record<string, unknown>;\n  economy: Record<string, unknown>;\n  pricing: Record<string, unknown>;\n  customerStats: Record<string, unknown>;\n  registers: Record<string, unknown>[];\n}\n\nconst SAVE_KEY = 'midnight_store_save';\nconst CURRENT_VERSION = '0.2.0';\n\nexport function createInitialState(): GameState {\n  const TILE = 32;\n  return {\n    phase: GamePhase.DAYTIME,\n    activePanel: UIPanel.NONE,\n    player: {\n      x: 15 * TILE,\n      y: 5 * TILE,\n      speed: 150,\n      direction: 'down',\n      money: 500,\n      debt: 300000,\n      day: 1,\n      health: 100,\n      sanity: 100,\n    },\n    day: 1,\n    timeOfDay: 6,\n    timeSpeed: 1,\n    lights: [],\n    interactables: [],\n    totalPlaytime: 0,\n    lastSaveTime: Date.now(),\n    version: CURRENT_VERSION,\n\n    money: 500,\n    debt: 300000,\n    dailyRevenue: 0,\n    dailyExpenses: 0,\n    notifications: [],\n    daySummaries: [],\n  };\n}\n\nexport function cloneState(state: GameState): GameState {\n  return JSON.parse(JSON.stringify(state));\n}\n\nexport function saveGame(\n  state: GameState,\n  pm?: Record<string, unknown>,\n  eco?: Record<string, unknown>,\n  prc?: Record<string, unknown>,\n  cust?: Record<string, unknown>,\n  regs?: Record<string, unknown>[],\n): void {\n  const data: SaveData = {\n    version: CURRENT_VERSION,\n    timestamp: Date.now(),\n    playtime: state.totalPlaytime,\n    gameState: state,\n    productManager: pm ?? {},\n    economy: eco ?? {},\n    pricing: prc ?? {},\n    customerStats: cust ?? {},\n    registers: regs ?? [],\n  };\n  try {\n    localStorage.setItem(SAVE_KEY, JSON.stringify(data));\n  } catch {\n    console.warn('Save failed: storage quota exceeded');\n  }\n}\n\nexport function loadGame(): SaveData | null {\n  try {\n    const raw = localStorage.getItem(SAVE_KEY);\n    if (!raw) return null;\n    return JSON.parse(raw) as SaveData;\n  } catch {\n    return null;\n  }\n}\n\nexport function clearSave(): void {\n  localStorage.removeItem(SAVE_KEY);\n}\n\nlet autoSaveTimer = 0;\n\nexport function startAutoSave(\n  getState: () => GameState,\n  getExtra?: () => {\n    pm?: Record<string, unknown>;\n    eco?: Record<string, unknown>;\n    prc?: Record<string, unknown>;\n    cust?: Record<string, unknown>;\n    regs?: Record<string, unknown>[];\n  },\n  intervalMs: number = 300000,\n): void {\n  stopAutoSave();\n  autoSaveTimer = window.setInterval(() => {\n    const extra = getExtra?.();\n    saveGame(\n      getState(),\n      extra?.pm,\n      extra?.eco,\n      extra?.prc,\n      extra?.cust,\n      extra?.regs,\n    );\n  }, intervalMs);\n}\n\nexport function stopAutoSave(): void {\n  if (autoSaveTimer) {\n    clearInterval(autoSaveTimer);\n    autoSaveTimer = 0;\n  }\n}\n\nexport function getTimeString(timeOfDay: number): string {\n  const hours = Math.floor(timeOfDay) % 24;\n  const minutes = Math.floor((timeOfDay % 1) * 60);\n  return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;\n}\n\nexport function getPhaseFromTime(timeOfDay: number): GamePhase {\n  if (timeOfDay >= 6 && timeOfDay < 22) return GamePhase.DAYTIME;\n  if (timeOfDay >= 22 && timeOfDay < 23) return GamePhase.NIGHT_TRANSITION;\n  if (timeOfDay >= 23 || timeOfDay < 2) return GamePhase.NIGHT;\n  if (timeOfDay >= 2 && timeOfDay < 5) return GamePhase.DANGER;\n  return GamePhase.DAWN;\n}\n\nexport function isNightTime(phase: GamePhase): boolean {\n  return phase === GamePhase.NIGHT_TRANSITION ||\n    phase === GamePhase.NIGHT ||\n    phase === GamePhase.DANGER;\n}\n","numLines":240,"startLine":1,"totalLines":240}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_7b0874b62394493da0a5481b","type":"tool_result","content":"1\t// App.ts — Game main loop + state machine (v0.2.0 — M2: Management System)\n2\t\n3\timport { Renderer } from './Renderer';\n4\timport { StoreMap, TILE_SIZE, T } from '../game/StoreMap';\n5\timport { Player } from '../game/Player';\n6\timport {\n7\t  type GameState,\n8\t  type Interactable,\n9\t  type LightSource,\n10\t  GamePhase,\n11\t  UIPanel,\n12\t  createInitialState,\n13\t  loadGame,\n14\t  saveGame,\n15\t  startAutoSave,\n16\t  stopAutoSave,\n17\t  getPhaseFromTime,\n18\t  cloneState,\n19\t} from '../game/GameState';\n20\timport { ProductManager } from '../game/ProductManager';\n21\timport { CustomerManager } from '../game/CustomerManager';\n22\timport { CashRegister } from '../game/CashRegister';\n23\timport { PricingSystem } from '../game/PricingSystem';\n24\timport { EconomySystem } from '../game/EconomySystem';\n25\timport { ShelfInteraction, ShelfAction } from '../game/ShelfInteraction';\n26\timport { Customer, CustomerState } from '../game/Customer';\n27\t\n28\texport class App {\n29\t  canvas: HTMLCanvasElement;\n30\t  renderer: Renderer;\n31\t  state: GameState;\n32\t  map: StoreMap;\n33\t  player: Player;\n34\t\n35\t  // M2 systems\n36\t  productManager: ProductManager;\n37\t  customerManager: CustomerManager;\n38\t  registers: CashRegister[];\n39\t  pricing: PricingSystem;\n40\t  economy: EconomySystem;\n41\t  shelfInteraction: ShelfInteraction;\n42\t\n43\t  private running = false;\n44\t  private lastFrameTime = 0;\n45\t  private animFrameId = 0;\n46\t  private activeCustomers: Customer[] = [];\n47\t  private lastTransactionNotification = '';\n48\t\n49\t  onStateChange?: (state: GameState) => void;\n50\t  onNotification?: (text: string) => void;\n51\t\n52\t  constructor(canvas: HTMLCanvasElement) {\n53\t    this.canvas = canvas;\n54\t    this.renderer = new Renderer(canvas);\n55\t\n56\t    const saved = loadGame();\n57\t    this.state = saved ? { ...createInitialState(), ...saved.gameState } : createInitialState();\n58\t\n59\t    this.map = new StoreMap();\n60\t    this.player = new Player(this.state.player);\n61\t    this.player.setupInput();\n62\t\n63\t    // Initialize M2 systems\n64\t    this.productManager = new ProductManager();\n65\t    this.customerManager = new CustomerManager();\n66\t    this.registers = [\n67\t      new CashRegister('register_1'),\n68\t      new CashRegister('register_2'),\n69\t    ];\n70\t    this.pricing = new PricingSystem(this.productManager);\n71\t    this.economy = new EconomySystem();\n72\t    this.shelfInteraction = new ShelfInteraction();\n73\t\n74\t    // Load save data for M2 systems\n75\t    if (saved) {\n76\t      if (saved.productManager && Object.keys(saved.productManager).length > 0) {\n77\t        this.productManager.loadSaveData(saved.productManager);\n78\t      }\n79\t      if (saved.economy && Object.keys(saved.economy).length > 0) {\n80\t        this.economy.loadSaveData(saved.economy);\n81\t      }\n82\t      if (saved.pricing && Object.keys(saved.pricing).length > 0) {\n83\t        this.pricing.loadSaveData(saved.pricing);\n84\t      }\n85\t      if (saved.customerStats && Object.keys(saved.customerStats).length > 0) {\n86\t        this.customerManager.loadSaveData(saved.customerStats);\n87\t      }\n88\t      if (saved.registers) {\n89\t        for (let i = 0; i < saved.registers.length && i < this.registers.length; i++) {\n90\t          this.registers[i].loadSaveData(saved.registers[i]);\n91\t        }\n92\t      }\n93\t    }\n94\t\n95\t    // Apply purchased upgrades\n96\t    this.applyUpgrades();\n97\t\n98\t    // Setup interactable objects\n99\t    this.state.interactables = this.createInteractables();\n100\t    this.state.lights = this.createLights();\n101\t\n102\t    // Give some starting inventory\n103\t    if (!saved) {\n104\t      this.setupStartingInventory();\n105\t    }\n106\t\n107\t    // Snap camera to player immediately\n108\t    this.renderer.camera.snapTo(this.player.x + 16, this.player.y + 16);\n109\t\n110\t    // Setup keyboard shortcuts for panels\n111\t    this.setupPanelInput();\n112\t\n113\t    window.addEventListener('resize', () => {\n114\t      this.renderer.resize();\n115\t    });\n116\t  }\n117\t\n118\t  private setupStartingInventory(): void {\n119\t    // Stock initial products\n120\t    this.productManager.addToInventory('water', 10, 1);\n121\t    this.productManager.addToInventory('cola', 8, 1);\n122\t    this.productManager.addToInventory('chips', 8, 1);\n123\t    this.productManager.addToInventory('biscuit', 6, 1);\n124\t    this.productManager.addToInventory('candy', 10, 1);\n125\t    this.productManager.addToInventory('bento_chicken', 4, 1);\n126\t    this.productManager.addToInventory('bento_veg', 4, 1);\n127\t    this.productManager.addToInventory('tissue', 5, 1);\n128\t    this.productManager.addToInventory('battery', 3, 1);\n129\t\n130\t    // Pre-stock some shelves\n131\t    this.productManager.stockShelf('shelf_1', 'chips', 5);\n132\t    this.productManager.stockShelf('shelf_2', 'cola', 5);\n133\t    this.productManager.stockShelf('shelf_3', 'tissue', 5);\n134\t    this.productManager.stockShelf('fridge_1', 'water', 5);\n135\t    this.productManager.stockShelf('fridge_2', 'bento_chicken', 3);\n136\t  }\n137\t\n138\t  private applyUpgrades(): void {\n139\t    if (this.economy.hasUpgrade('register_upgrade')) {\n140\t      this.registers.forEach(r => r.applySpeedUpgrade(0.3));\n141\t    }\n142\t    if (this.economy.hasUpgrade('warehouse_shelf')) {\n143\t      this.productManager.upgradeStorage(0.5);\n144\t    }\n145\t    if (this.economy.hasUpgrade('bright_lights')) {\n146\t      for (const light of this.state.lights) {\n147\t        light.intensity = Math.min(1, light.intensity * 1.5);\n148\t        light.radius *= 1.3;\n149\t      }\n150\t    }\n151\t  }\n152\t\n153\t  private setupPanelInput(): void {\n154\t    window.addEventListener('keydown', (e) => {\n155\t      if (e.key === 'Escape') {\n156\t        if (this.state.activePanel !== UIPanel.NONE) {\n157\t          this.state.activePanel = UIPanel.NONE;\n158\t          this.shelfInteraction.close();\n159\t          e.preventDefault();\n160\t        }\n161\t      }\n162\t      if (e.key === 'i' || e.key === 'I') {\n163\t        this.togglePanel(UIPanel.INVENTORY);\n164\t        e.preventDefault();\n165\t      }\n166\t      if (e.key === 'p' || e.key === 'P') {\n167\t        this.togglePanel(UIPanel.PRICING);\n168\t        e.preventDefault();\n169\t      }\n170\t      if (e.key === 'u' || e.key === 'U') {\n171\t        this.togglePanel(UIPanel.SHOP);\n172\t        e.preventDefault();\n173\t      }\n174\t      if (e.key === 'o' || e.key === 'O') {\n175\t        this.togglePanel(UIPanel.SUPPLIER);\n176\t        e.preventDefault();\n177\t      }\n178\t    });\n179\t  }\n180\t\n181\t  private togglePanel(panel: UIPanel): void {\n182\t    this.state.activePanel = this.state.activePanel === panel ? UIPanel.NONE : panel;\n183\t    if (this.state.activePanel === UIPanel.NONE) {\n184\t      this.shelfInteraction.close();\n185\t    }\n186\t  }\n187\t\n188\t  private createInteractables(): Interactable[] {\n189\t    const S = TILE_SIZE;\n190\t    return [\n191\t      { id: 'register_1', type: 'register', x: 19 * S, y: 3 * S, width: S, height: S, label: '收银台', active: true },\n192\t      { id: 'register_2', type: 'register', x: 21 * S, y: 3 * S, width: S, height: S, label: '收银台', active: true },\n193\t      { id: 'shelf_1', type: 'shelf', x: 3 * S, y: 5 * S, width: 3 * S, height: S, label: '零食货架', active: true },\n194\t      { id: 'shelf_2', type: 'shelf', x: 7 * S, y: 5 * S, width: 3 * S, height: S, label: '饮料货架', active: true },\n195\t      { id: 'shelf_3', type: 'shelf', x: 11 * S, y: 5 * S, width: 3 * S, height: S, label: '日用品', active: true },\n196\t      { id: 'shelf_4', type: 'shelf', x: 17 * S, y: 5 * S, width: 3 * S, height: S, label: '烟酒柜', active: true },\n197\t      { id: 'shelf_5', type: 'shelf', x: 21 * S, y: 5 * S, width: 3 * S, height: S, label: '杂志架', active: true },\n198\t      { id: 'fridge_1', type: 'fridge', x: 3 * S, y: 9 * S, width: 3 * S, height: S, label: '冷饮冰柜', active: true },\n199\t      { id: 'fridge_2', type: 'fridge', x: 7 * S, y: 9 * S, width: 3 * S, height: S, label: '冷冻食品', active: true },\n200\t      { id: 'door_front', type: 'door', x: 14 * S, y: 0, width: 2 * S, height: S, label: '前门', active: true },\n201\t      { id: 'door_back', type: 'door', x: 9 * S, y: 24 * S, width: 2 * S, height: S, label: '后门', active: true },\n202\t      { id: 'door_warehouse', type: 'door', x: 14 * S, y: 11 * S, width: 2 * S, height: S, label: '仓库门', active: true },\n203\t      { id: 'note_safe', type: 'note', x: 4 * S, y: 20 * S, width: S, height: S, label: '保险柜', active: true },\n204\t    ];\n205\t  }\n206\t\n207\t  private createLights(): LightSource[] {\n208\t    const S = TILE_SIZE;\n209\t    return [\n210\t      { x: 15 * S, y: 3 * S, radius: 200, color: '#fff5e0', intensity: 0.8, flicker: false, flickerSpeed: 0 },\n211\t      { x: 8 * S, y: 6 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n212\t      { x: 22 * S, y: 6 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n213\t      { x: 8 * S, y: 8 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n214\t      { x: 15 * S, y: 10 * S, radius: 150, color: '#fff5e0', intensity: 0.6, flicker: false, flickerSpeed: 0 },\n215\t      { x: 12 * S, y: 14 * S, radius: 120, color: '#e0d0b0', intensity: 0.5, flicker: true, flickerSpeed: 3.5 },\n216\t      { x: 22 * S, y: 20 * S, radius: 100, color: '#ffe8c0', intensity: 0.4, flicker: false, flickerSpeed: 0 },\n217\t      { x: 20 * S, y: 3 * S, radius: 80, color: '#ffffff', intensity: 0.6, flicker: false, flickerSpeed: 0 },\n218\t    ];\n219\t  }\n220\t\n221\t  start(): void {\n222\t    if (this.running) return;\n223\t    this.running = true;\n224\t    this.lastFrameTime = performance.now();\n225\t    this.loop(this.lastFrameTime);\n226\t    startAutoSave(\n227\t      () => this.state,\n228\t      () => ({\n229\t        pm: this.productManager.getSaveData(),\n230\t        eco: this.economy.getSaveData(),\n231\t        prc: this.pricing.getSaveData(),\n232\t        cust: this.customerManager.getSaveData(),\n233\t        regs: this.registers.map(r => r.getSaveData()),\n234\t      }),\n235\t    );\n236\t  }\n237\t\n238\t  stop(): void {\n239\t    this.running = false;\n240\t    if (this.animFrameId) cancelAnimationFrame(this.animFrameId);\n241\t    stopAutoSave();\n242\t    saveGame(\n243\t      this.state,\n244\t      this.productManager.getSaveData(),\n245\t      this.economy.getSaveData(),\n246\t      this.pricing.getSaveData(),\n247\t      this.customerManager.getSaveData(),\n248\t      this.registers.map(r => r.getSaveData()),\n249\t    );\n250\t  }\n251\t\n252\t  private loop = (now: number): void => {\n253\t    if (!this.running) return;\n254\t\n255\t    const dt = Math.min(now - this.lastFrameTime, 50);\n256\t    this.lastFrameTime = now;\n257\t\n258\t    this.state.totalPlaytime += dt / 1000;\n259\t\n260\t    // Update time of day\n261\t    const prevDay = this.state.day;\n262\t    this.state.timeOfDay += (dt / 1000) * this.state.timeSpeed * 0.05;\n263\t    if (this.state.timeOfDay >= 30) {\n264\t      this.state.timeOfDay -= 24;\n265\t      this.state.day++;\n266\t      this.state.player.day = this.state.day;\n267\t    }\n268\t\n269\t    // Day transition\n270\t    if (this.state.day > prevDay) {\n271\t      this.onNewDay();\n272\t    }\n273\t\n274\t    // Update game phase\n275\t    const newPhase = getPhaseFromTime(this.state.timeOfDay);\n276\t    if (newPhase !== this.state.phase) {\n277\t      this.state.phase = newPhase;\n278\t      this.onStateChange?.(this.state);\n279\t    }\n280\t\n281\t    // Update player (skip if panel is open)\n282\t    if (this.state.activePanel === UIPanel.NONE) {\n283\t      this.player.update(dt, this.map);\n284\t    }\n285\t\n286\t    // Handle interaction\n287\t    if (this.player.consumeInteract()) {\n288\t      this.handleInteraction();\n289\t    }\n290\t\n291\t    // Update M2 systems\n292\t    this.updateManagementSystems(dt, now);\n293\t\n294\t    // Update camera\n295\t    this.renderer.camera.follow(this.player.x + 16, this.player.y + 16);\n296\t\n297\t    // Update shelf interaction messages\n298\t    this.shelfInteraction.update(dt);\n299\t\n300\t    // Render\n301\t    this.renderer.render(this.map, this.player, this.state, now, {\n302\t      customers: this.activeCustomers,\n303\t      productManager: this.productManager,\n304\t      shelfInteraction: this.shelfInteraction,\n305\t      registers: this.registers,\n306\t      economy: this.economy,\n307\t      pricing: this.pricing,\n308\t      lastTransaction: this.lastTransactionNotification,\n309\t    });\n310\t\n311\t    this.animFrameId = requestAnimationFrame(this.loop);\n312\t  };\n313\t\n314\t  private updateManagementSystems(dt: number, now: number): void {\n315\t    // Process pending orders\n316\t    const fulfilled = this.productManager.processPendingOrders(this.state.day);\n317\t    if (fulfilled.length > 0) {\n318\t      for (const order of fulfilled) {\n319\t        const product = this.productManager.getProduct(order.productId);\n320\t        this.addNotification(`到货: ${product?.name ?? order.productId} x${order.quantity}`);\n321\t      }\n322\t    }\n323\t\n324\t    // Expire products\n325\t    const expired = this.productManager.expireProducts(this.state.day);\n326\t    if (expired.length > 0) {\n327\t      for (const pid of expired) {\n328\t        const product = this.productManager.getProduct(pid);\n329\t        this.addNotification(`过期: ${product?.name ?? pid}`);\n330\t      }\n331\t    }\n332\t\n333\t    // Update customers\n334\t    this.activeCustomers = this.customerManager.update(dt, this.state.timeOfDay, this.state.day, this.productManager);\n335\t\n336\t    // Update demand\n337\t    this.pricing.updateDemand(this.state.timeOfDay);\n338\t\n339\t    // Update registers\n340\t    for (const register of this.registers) {\n341\t      const txn = register.update(dt);\n342\t      if (txn) {\n343\t        this.economy.addRevenue(txn.total);\n344\t        this.state.dailyRevenue += txn.total;\n345\t        this.lastTransactionNotification = `交易完成: ¥${txn.total.toFixed(2)}`;\n346\t        this.addNotification(this.lastTransactionNotification);\n347\t\n348\t        if (txn.isAnomalous) {\n349\t          this.addNotification('⚠ 收银机出现异常...');\n350\t          this.state.player.sanity = Math.max(0, this.state.player.sanity - 5);\n351\t        }\n352\t\n353\t        for (const item of txn.items) {\n354\t          this.pricing.recordSale(item.productId);\n355\t        }\n356\t      }\n357\t\n358\t      // Auto-serve waiting customers at idle registers\n359\t      if (register.canAcceptCustomer()) {\n360\t        const waiting = this.customerManager.getFirstWaiting();\n361\t        if (waiting) {\n362\t          register.startCheckout(waiting, this.productManager, this.pricing);\n363\t        }\n364\t      }\n365\t    }\n366\t\n367\t    // Sync economy money with game state\n368\t    this.state.money = this.economy.getMoney();\n369\t    this.state.debt = this.economy.debt;\n370\t  }\n371\t\n372\t  private handleInteraction(): void {\n373\t    if (this.state.activePanel !== UIPanel.NONE) {\n374\t      // Close panel on interact\n375\t      this.state.activePanel = UIPanel.NONE;\n376\t      this.shelfInteraction.close();\n377\t      return;\n378\t    }\n379\t\n380\t    const facing = this.player.getFacingTile();\n381\t\n382\t    const obj = this.state.interactables.find(o => {\n383\t      const oGX = Math.floor(o.x / TILE_SIZE);\n384\t      const oGY = Math.floor(o.y / TILE_SIZE);\n385\t      const oGW = Math.ceil(o.width / TILE_SIZE);\n386\t      const oGH = Math.ceil(o.height / TILE_SIZE);\n387\t      return facing.gx >= oGX && facing.gx < oGX + oGW && facing.gy >= oGY && facing.gy < oGY + oGH;\n388\t    });\n389\t\n390\t    if (!obj) return;\n391\t\n392\t    switch (obj.type) {\n393\t      case 'shelf':\n394\t      case 'fridge': {\n395\t        const info = this.shelfInteraction.interactWithShelf(obj.id, this.state.interactables, this.productManager);\n396\t        if (info) {\n397\t          this.state.activePanel = UIPanel.SHELF;\n398\t          this.onNotification?.(`货架: ${info.label} — ${info.productName ?? '空'} (${info.quantity}/${info.maxQuantity})`);\n399\t        }\n400\t        break;\n401\t      }\n402\t      case 'register': {\n403\t        const register = this.registers.find(r => r.registerId === obj.id);\n404\t        const waiting = this.customerManager.getFirstWaiting();\n405\t        if (register && register.canAcceptCustomer() && waiting) {\n406\t          register.startCheckout(waiting, this.productManager, this.pricing);\n407\t          this.onNotification?.('开始收银...');\n408\t        } else if (register && !register.canAcceptCustomer()) {\n409\t          this.onNotification?.('收银中...');\n410\t        } else {\n411\t          this.onNotification?.('收银台 — 没有顾客等待');\n412\t        }\n413\t        break;\n414\t      }\n415\t      case 'door':\n416\t        this.onNotification?.(`交互: ${obj.label}`);\n417\t        break;\n418\t      default:\n419\t        this.onNotification?.(`交互: ${obj.label}`);\n420\t    }\n421\t  }\n422\t\n423\t  private onNewDay(): void {\n424\t    const report = this.economy.endDay();\n425\t\n426\t    // Create day summary\n427\t    const stats = this.customerManager.getStats();\n428\t    this.state.daySummaries.push({\n429\t      day: report.day,\n430\t      revenue: report.revenue,\n431\t      expenses: report.expenses,\n432\t      customersServed: stats.served,\n433\t      customersLost: stats.lost,\n434\t      debtRemaining: report.debtRemaining,\n435\t    });\n436\t\n437\t    this.state.dailyRevenue = 0;\n438\t    this.state.dailyExpenses = 0;\n439\t    this.customerManager.resetDailyStats();\n440\t    this.pricing.resetDailyVelocity();\n441\t\n442\t    this.addNotification(`Day ${report.day} 结算: 收入¥${report.revenue} 支出¥${report.expenses} 债务¥${report.debtRemaining}`);\n443\t\n444\t    // Check game over\n445\t    const gameOver = this.economy.isGameOver();\n446\t    if (gameOver.over) {\n447\t      this.addNotification(`游戏结束: ${gameOver.reason}`);\n448\t    }\n449\t  }\n450\t\n451\t  private addNotification(text: string): void {\n452\t    this.state.notifications.push(text);\n453\t    if (this.state.notifications.length > 10) {\n454\t      this.state.notifications.shift();\n455\t    }\n456\t    this.onNotification?.(text);\n457\t  }\n458\t\n459\t  // Public API for UI interaction\n460\t  stockShelf(shelfId: string, productId: string, quantity: number): void {\n461\t    this.shelfInteraction.stockShelf(shelfId, productId, quantity, this.productManager);\n462\t  }\n463\t\n464\t  unstockShelf(shelfId: string, quantity: number): void {\n465\t    this.shelfInteraction.unstockShelf(shelfId, quantity, this.productManager);\n466\t  }\n467\t\n468\t  orderProduct(productId: string, quantity: number, supplierId: string): boolean {\n469\t    const order = this.productManager.orderProduct(productId, quantity, supplierId, this.state.day);\n470\t    if (order) {\n471\t      this.economy.addPurchaseCost(order.totalCost);\n472\t      this.state.money = this.economy.getMoney();\n473\t      const product = this.productManager.getProduct(productId);\n474\t      this.addNotification(`下单: ${product?.name} x${quantity} — ¥${order.totalCost}`);\n475\t      return true;\n476\t    }\n477\t    return false;\n478\t  }\n479\t\n480\t  purchaseUpgrade(upgradeId: string): { success: boolean; message: string } {\n481\t    const result = this.economy.purchaseUpgrade(upgradeId);\n482\t    if (result.success) {\n483\t      this.state.money = this.economy.getMoney();\n484\t      this.applyUpgrades();\n485\t      this.addNotification(result.message);\n486\t    }\n487\t    return result;\n488\t  }\n489\t\n490\t  setProductPrice(productId: string, price: number): boolean {\n491\t    return this.pricing.setPrice(productId, price);\n492\t  }\n493\t\n494\t  centerCamera(): void {\n495\t    this.renderer.camera.snapTo(this.player.x + 16, this.player.y + 16);\n496\t  }\n497\t\n498\t  setTimeSpeed(speed: number): void {\n499\t    this.state.timeSpeed = speed;\n500\t  }\n501\t}\n502\t"}]},"parent_tool_use_id":null,"session_id":"e8f5bde0-4da8-4c4a-9322-50945e66ead7","uuid":"0e2aa1d8-f744-4998-b34f-5de46948ef37","timestamp":"2026-05-23T04:37:11.817Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-horror-sim\\src\\renderer\\App.ts","content":"// App.ts — Game main loop + state machine (v0.2.0 — M2: Management System)\n\nimport { Renderer } from './Renderer';\nimport { StoreMap, TILE_SIZE, T } from '../game/StoreMap';\nimport { Player } from '../game/Player';\nimport {\n  type GameState,\n  type Interactable,\n  type LightSource,\n  GamePhase,\n  UIPanel,\n  createInitialState,\n  loadGame,\n  saveGame,\n  startAutoSave,\n  stopAutoSave,\n  getPhaseFromTime,\n  cloneState,\n} from '../game/GameState';\nimport { ProductManager } from '../game/ProductManager';\nimport { CustomerManager } from '../game/CustomerManager';\nimport { CashRegister } from '../game/CashRegister';\nimport { PricingSystem } from '../game/PricingSystem';\nimport { EconomySystem } from '../game/EconomySystem';\nimport { ShelfInteraction, ShelfAction } from '../game/ShelfInteraction';\nimport { Customer, CustomerState } from '../game/Customer';\n\nexport class App {\n  canvas: HTMLCanvasElement;\n  renderer: Renderer;\n  state: GameState;\n  map: StoreMap;\n  player: Player;\n\n  // M2 systems\n  productManager: ProductManager;\n  customerManager: CustomerManager;\n  registers: CashRegister[];\n  pricing: PricingSystem;\n  economy: EconomySystem;\n  shelfInteraction: ShelfInteraction;\n\n  private running = false;\n  private lastFrameTime = 0;\n  private animFrameId = 0;\n  private activeCustomers: Customer[] = [];\n  private lastTransactionNotification = '';\n\n  onStateChange?: (state: GameState) => void;\n  onNotification?: (text: string) => void;\n\n  constructor(canvas: HTMLCanvasElement) {\n    this.canvas = canvas;\n    this.renderer = new Renderer(canvas);\n\n    const saved = loadGame();\n    this.state = saved ? { ...createInitialState(), ...saved.gameState } : createInitialState();\n\n    this.map = new StoreMap();\n    this.player = new Player(this.state.player);\n    this.player.setupInput();\n\n    // Initialize M2 systems\n    this.productManager = new ProductManager();\n    this.customerManager = new CustomerManager();\n    this.registers = [\n      new CashRegister('register_1'),\n      new CashRegister('register_2'),\n    ];\n    this.pricing = new PricingSystem(this.productManager);\n    this.economy = new EconomySystem();\n    this.shelfInteraction = new ShelfInteraction();\n\n    // Load save data for M2 systems\n    if (saved) {\n      if (saved.productManager && Object.keys(saved.productManager).length > 0) {\n        this.productManager.loadSaveData(saved.productManager);\n      }\n      if (saved.economy && Object.keys(saved.economy).length > 0) {\n        this.economy.loadSaveData(saved.economy);\n      }\n      if (saved.pricing && Object.keys(saved.pricing).length > 0) {\n        this.pricing.loadSaveData(saved.pricing);\n      }\n      if (saved.customerStats && Object.keys(saved.customerStats).length > 0) {\n        this.customerManager.loadSaveData(saved.customerStats);\n      }\n      if (saved.registers) {\n        for (let i = 0; i < saved.registers.length && i < this.registers.length; i++) {\n          this.registers[i].loadSaveData(saved.registers[i]);\n        }\n      }\n    }\n\n    // Apply purchased upgrades\n    this.applyUpgrades();\n\n    // Setup interactable objects\n    this.state.interactables = this.createInteractables();\n    this.state.lights = this.createLights();\n\n    // Give some starting inventory\n    if (!saved) {\n      this.setupStartingInventory();\n    }\n\n    // Snap camera to player immediately\n    this.renderer.camera.snapTo(this.player.x + 16, this.player.y + 16);\n\n    // Setup keyboard shortcuts for panels\n    this.setupPanelInput();\n\n    window.addEventListener('resize', () => {\n      this.renderer.resize();\n    });\n  }\n\n  private setupStartingInventory(): void {\n    // Stock initial products\n    this.productManager.addToInventory('water', 10, 1);\n    this.productManager.addToInventory('cola', 8, 1);\n    this.productManager.addToInventory('chips', 8, 1);\n    this.productManager.addToInventory('biscuit', 6, 1);\n    this.productManager.addToInventory('candy', 10, 1);\n    this.productManager.addToInventory('bento_chicken', 4, 1);\n    this.productManager.addToInventory('bento_veg', 4, 1);\n    this.productManager.addToInventory('tissue', 5, 1);\n    this.productManager.addToInventory('battery', 3, 1);\n\n    // Pre-stock some shelves\n    this.productManager.stockShelf('shelf_1', 'chips', 5);\n    this.productManager.stockShelf('shelf_2', 'cola', 5);\n    this.productManager.stockShelf('shelf_3', 'tissue', 5);\n    this.productManager.stockShelf('fridge_1', 'water', 5);\n    this.productManager.stockShelf('fridge_2', 'bento_chicken', 3);\n  }\n\n  private applyUpgrades(): void {\n    if (this.economy.hasUpgrade('register_upgrade')) {\n      this.registers.forEach(r => r.applySpeedUpgrade(0.3));\n    }\n    if (this.economy.hasUpgrade('warehouse_shelf')) {\n      this.productManager.upgradeStorage(0.5);\n    }\n    if (this.economy.hasUpgrade('bright_lights')) {\n      for (const light of this.state.lights) {\n        light.intensity = Math.min(1, light.intensity * 1.5);\n        light.radius *= 1.3;\n      }\n    }\n  }\n\n  private setupPanelInput(): void {\n    window.addEventListener('keydown', (e) => {\n      if (e.key === 'Escape') {\n        if (this.state.activePanel !== UIPanel.NONE) {\n          this.state.activePanel = UIPanel.NONE;\n          this.shelfInteraction.close();\n          e.preventDefault();\n        }\n      }\n      if (e.key === 'i' || e.key === 'I') {\n        this.togglePanel(UIPanel.INVENTORY);\n        e.preventDefault();\n      }\n      if (e.key === 'p' || e.key === 'P') {\n        this.togglePanel(UIPanel.PRICING);\n        e.preventDefault();\n      }\n      if (e.key === 'u' || e.key === 'U') {\n        this.togglePanel(UIPanel.SHOP);\n        e.preventDefault();\n      }\n      if (e.key === 'o' || e.key === 'O') {\n        this.togglePanel(UIPanel.SUPPLIER);\n        e.preventDefault();\n      }\n    });\n  }\n\n  private togglePanel(panel: UIPanel): void {\n    this.state.activePanel = this.state.activePanel === panel ? UIPanel.NONE : panel;\n    if (this.state.activePanel === UIPanel.NONE) {\n      this.shelfInteraction.close();\n    }\n  }\n\n  private createInteractables(): Interactable[] {\n    const S = TILE_SIZE;\n    return [\n      { id: 'register_1', type: 'register', x: 19 * S, y: 3 * S, width: S, height: S, label: '收银台', active: true },\n      { id: 'register_2', type: 'register', x: 21 * S, y: 3 * S, width: S, height: S, label: '收银台', active: true },\n      { id: 'shelf_1', type: 'shelf', x: 3 * S, y: 5 * S, width: 3 * S, height: S, label: '零食货架', active: true },\n      { id: 'shelf_2', type: 'shelf', x: 7 * S, y: 5 * S, width: 3 * S, height: S, label: '饮料货架', active: true },\n      { id: 'shelf_3', type: 'shelf', x: 11 * S, y: 5 * S, width: 3 * S, height: S, label: '日用品', active: true },\n      { id: 'shelf_4', type: 'shelf', x: 17 * S, y: 5 * S, width: 3 * S, height: S, label: '烟酒柜', active: true },\n      { id: 'shelf_5', type: 'shelf', x: 21 * S, y: 5 * S, width: 3 * S, height: S, label: '杂志架', active: true },\n      { id: 'fridge_1', type: 'fridge', x: 3 * S, y: 9 * S, width: 3 * S, height: S, label: '冷饮冰柜', active: true },\n      { id: 'fridge_2', type: 'fridge', x: 7 * S, y: 9 * S, width: 3 * S, height: S, label: '冷冻食品', active: true },\n      { id: 'door_front', type: 'door', x: 14 * S, y: 0, width: 2 * S, height: S, label: '前门', active: true },\n      { id: 'door_back', type: 'door', x: 9 * S, y: 24 * S, width: 2 * S, height: S, label: '后门', active: true },\n      { id: 'door_warehouse', type: 'door', x: 14 * S, y: 11 * S, width: 2 * S, height: S, label: '仓库门', active: true },\n      { id: 'note_safe', type: 'note', x: 4 * S, y: 20 * S, width: S, height: S, label: '保险柜', active: true },\n    ];\n  }\n\n  private createLights(): LightSource[] {\n    const S = TILE_SIZE;\n    return [\n      { x: 15 * S, y: 3 * S, radius: 200, color: '#fff5e0', intensity: 0.8, flicker: false, flickerSpeed: 0 },\n      { x: 8 * S, y: 6 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n      { x: 22 * S, y: 6 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n      { x: 8 * S, y: 8 * S, radius: 150, color: '#fff5e0', intensity: 0.7, flicker: false, flickerSpeed: 0 },\n      { x: 15 * S, y: 10 * S, radius: 150, color: '#fff5e0', intensity: 0.6, flicker: false, flickerSpeed: 0 },\n      { x: 12 * S, y: 14 * S, radius: 120, color: '#e0d0b0', intensity: 0.5, flicker: true, flickerSpeed: 3.5 },\n      { x: 22 * S, y: 20 * S, radius: 100, color: '#ffe8c0', intensity: 0.4, flicker: false, flickerSpeed: 0 },\n      { x: 20 * S, y: 3 * S, radius: 80, color: '#ffffff', intensity: 0.6, flicker: false, flickerSpeed: 0 },\n    ];\n  }\n\n  start(): void {\n    if (this.running) return;\n    this.running = true;\n    this.lastFrameTime = performance.now();\n    this.loop(this.lastFrameTime);\n    startAutoSave(\n      () => this.state,\n      () => ({\n        pm: this.productManager.getSaveData(),\n        eco: this.economy.getSaveData(),\n        prc: this.pricing.getSaveData(),\n        cust: this.customerManager.getSaveData(),\n        regs: this.registers.map(r => r.getSaveData()),\n      }),\n    );\n  }\n\n  stop(): void {\n    this.running = false;\n    if (this.animFrameId) cancelAnimationFrame(this.animFrameId);\n    stopAutoSave();\n    saveGame(\n      this.state,\n      this.productManager.getSaveData(),\n      this.economy.getSaveData(),\n      this.pricing.getSaveData(),\n      this.customerManager.getSaveData(),\n      this.registers.map(r => r.getSaveData()),\n    );\n  }\n\n  private loop = (now: number): void => {\n    if (!this.running) return;\n\n    const dt = Math.min(now - this.lastFrameTime, 50);\n    this.lastFrameTime = now;\n\n    this.state.totalPlaytime += dt / 1000;\n\n    // Update time of day\n    const prevDay = this.state.day;\n    this.state.timeOfDay += (dt / 1000) * this.state.timeSpeed * 0.05;\n    if (this.state.timeOfDay >= 30) {\n      this.state.timeOfDay -= 24;\n      this.state.day++;\n      this.state.player.day = this.state.day;\n    }\n\n    // Day transition\n    if (this.state.day > prevDay) {\n      this.onNewDay();\n    }\n\n    // Update game phase\n    const newPhase = getPhaseFromTime(this.state.timeOfDay);\n    if (newPhase !== this.state.phase) {\n      this.state.phase = newPhase;\n      this.onStateChange?.(this.state);\n    }\n\n    // Update player (skip if panel is open)\n    if (this.state.activePanel === UIPanel.NONE) {\n      this.player.update(dt, this.map);\n    }\n\n    // Handle interaction\n    if (this.player.consumeInteract()) {\n      this.handleInteraction();\n    }\n\n    // Update M2 systems\n    this.updateManagementSystems(dt, now);\n\n    // Update camera\n    this.renderer.camera.follow(this.player.x + 16, this.player.y + 16);\n\n    // Update shelf interaction messages\n    this.shelfInteraction.update(dt);\n\n    // Render\n    this.renderer.render(this.map, this.player, this.state, now, {\n      customers: this.activeCustomers,\n      productManager: this.productManager,\n      shelfInteraction: this.shelfInteraction,\n      registers: this.registers,\n      economy: this.economy,\n      pricing: this.pricing,\n      lastTransaction: this.lastTransactionNotification,\n    });\n\n    this.animFrameId = requestAnimationFrame(this.loop);\n  };\n\n  private updateManagementSystems(dt: number, now: number): void {\n    // Process pending orders\n    const fulfilled = this.productManager.processPendingOrders(this.state.day);\n    if (fulfilled.length > 0) {\n      for (const order of fulfilled) {\n        const product = this.productManager.getProduct(order.productId);\n        this.addNotification(`到货: ${product?.name ?? order.productId} x${order.quantity}`);\n      }\n    }\n\n    // Expire products\n    const expired = this.productManager.expireProducts(this.state.day);\n    if (expired.length > 0) {\n      for (const pid of expired) {\n        const product = this.productManager.getProduct(pid);\n        this.addNotification(`过期: ${product?.name ?? pid}`);\n      }\n    }\n\n    // Update customers\n    this.activeCustomers = this.customerManager.update(dt, this.state.timeOfDay, this.state.day, this.productManager);\n\n    // Update demand\n    this.pricing.updateDemand(this.state.timeOfDay);\n\n    // Update registers\n    for (const register of this.registers) {\n      const txn = register.update(dt);\n      if (txn) {\n        this.economy.addRevenue(txn.total);\n        this.state.dailyRevenue += txn.total;\n        this.lastTransactionNotification = `交易完成: ¥${txn.total.toFixed(2)}`;\n        this.addNotification(this.lastTransactionNotification);\n\n        if (txn.isAnomalous) {\n          this.addNotification('⚠ 收银机出现异常...');\n          this.state.player.sanity = Math.max(0, this.state.player.sanity - 5);\n        }\n\n        for (const item of txn.items) {\n          this.pricing.recordSale(item.productId);\n        }\n      }\n\n      // Auto-serve waiting customers at idle registers\n      if (register.canAcceptCustomer()) {\n        const waiting = this.customerManager.getFirstWaiting();\n        if (waiting) {\n          register.startCheckout(waiting, this.productManager, this.pricing);\n        }\n      }\n    }\n\n    // Sync economy money with game state\n    this.state.money = this.economy.getMoney();\n    this.state.debt = this.economy.debt;\n  }\n\n  private handleInteraction(): void {\n    if (this.state.activePanel !== UIPanel.NONE) {\n      // Close panel on interact\n      this.state.activePanel = UIPanel.NONE;\n      this.shelfInteraction.close();\n      return;\n    }\n\n    const facing = this.player.getFacingTile();\n\n    const obj = this.state.interactables.find(o => {\n      const oGX = Math.floor(o.x / TILE_SIZE);\n      const oGY = Math.floor(o.y / TILE_SIZE);\n      const oGW = Math.ceil(o.width / TILE_SIZE);\n      const oGH = Math.ceil(o.height / TILE_SIZE);\n      return facing.gx >= oGX && facing.gx < oGX + oGW && facing.gy >= oGY && facing.gy < oGY + oGH;\n    });\n\n    if (!obj) return;\n\n    switch (obj.type) {\n      case 'shelf':\n      case 'fridge': {\n        const info = this.shelfInteraction.interactWithShelf(obj.id, this.state.interactables, this.productManager);\n        if (info) {\n          this.state.activePanel = UIPanel.SHELF;\n          this.onNotification?.(`货架: ${info.label} — ${info.productName ?? '空'} (${info.quantity}/${info.maxQuantity})`);\n        }\n        break;\n      }\n      case 'register': {\n        const register = this.registers.find(r => r.registerId === obj.id);\n        const waiting = this.customerManager.getFirstWaiting();\n        if (register && register.canAcceptCustomer() && waiting) {\n          register.startCheckout(waiting, this.productManager, this.pricing);\n          this.onNotification?.('开始收银...');\n        } else if (register && !register.canAcceptCustomer()) {\n          this.onNotification?.('收银中...');\n        } else {\n          this.onNotification?.('收银台 — 没有顾客等待');\n        }\n        break;\n      }\n      case 'door':\n        this.onNotification?.(`交互: ${obj.label}`);\n        break;\n      default:\n        this.onNotification?.(`交互: ${obj.label}`);\n    }\n  }\n\n  private onNewDay(): void {\n    const report = this.economy.endDay();\n\n    // Create day summary\n    const stats = this.customerManager.getStats();\n    this.state.daySummaries.push({\n      day: report.day,\n      revenue: report.revenue,\n      expenses: report.expenses,\n      customersServed: stats.served,\n      customersLost: stats.lost,\n      debtRemaining: report.debtRemaining,\n    });\n\n    this.state.dailyRevenue = 0;\n    this.state.dailyExpenses = 0;\n    this.customerManager.resetDailyStats();\n    this.pricing.resetDailyVelocity();\n\n    this.addNotification(`Day ${report.day} 结算: 收入¥${report.revenue} 支出¥${report.expenses} 债务¥${report.debtRemaining}`);\n\n    // Check game over\n    const gameOver = this.economy.isGameOver();\n    if (gameOver.over) {\n      this.addNotification(`游戏结束: ${gameOver.reason}`);\n    }\n  }\n\n  private addNotification(text: string): void {\n    this.state.notifications.push(text);\n    if (this.state.notifications.length > 10) {\n      this.state.notifications.shift();\n    }\n    this.onNotification?.(text);\n  }\n\n  // Public API for UI interaction\n  stockShelf(shelfId: string, productId: string, quantity: number): void {\n    this.shelfInteraction.stockShelf(shelfId, productId, quantity, this.productManager);\n  }\n\n  unstockShelf(shelfId: string, quantity: number): void {\n    this.shelfInteraction.unstockShelf(shelfId, quantity, this.productManager);\n  }\n\n  orderProduct(productId: string, quantity: number, supplierId: string): boolean {\n    const order = this.productManager.orderProduct(productId, quantity, supplierId, this.state.day);\n    if (order) {\n      this.economy.addPurchaseCost(order.totalCost);\n      this.state.money = this.economy.getMoney();\n      const product = this.productManager.getProduct(productId);\n      this.addNotification(`下单: ${product?.name} x${quantity} — ¥${order.totalCost}`);\n      return true;\n    }\n    return false;\n  }\n\n  purchaseUpgrade(upgradeId: string): { success: boolean; message: string } {\n    const result = this.economy.purchaseUpgrade(upgradeId);\n    if (result.success) {\n      this.state.money = this.economy.getMoney();\n      this.applyUpgrades();\n      this.addNotification(result.message);\n    }\n    return result;\n  }\n\n  setProductPrice(productId: string, price: number): boolean {\n    return this.pricing.setPrice(productId, price);\n  }\n\n  centerCamera(): void {\n    this.renderer.camera.snapTo(this.player.x + 16, this.player.y + 16);\n  }\n\n  setTimeSpeed(speed: number): void {\n    this.state.timeSpeed = speed;\n  }\n}\n","numLines":502,"startLine":1,"totalLines":502}}}
