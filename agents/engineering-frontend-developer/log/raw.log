ildingCounts[cond.buildingId] ?? 0) >= cond.count;\n102\t    }\n103\t    case 'pill_crafted':\n104\t      if (cond.pillId === 'any') return (context.totalPillsCrafted ?? 0) >= cond.count;\n105\t      if (cond.pillId === 'all') return context.allPillTypesCrafted;\n106\t      return (context.pillsCrafted[cond.pillId] ?? 0) >= cond.count;\n107\t    case 'region_unlocked':\n108\t      return context.unlockedRegions.includes(cond.regionId);\n109\t    case 'ascension_completed':\n110\t      return context.ascensionCompleted;\n111\t    case 'total_buildings':\n112\t      return context.totalBuildingCount >= cond.count;\n113\t    case 'playtime_hours':\n114\t      return context.playtimeHours >= cond.hours;\n115\t    case 'cross_region_links':\n116\t      return context.crossRegionLinkCount >= cond.count;\n117\t  }\n118\t}\n119\t\n120\texport interface AchievementContext {\n121\t  currentRealmId: string;\n122\t  realmOrder: string[];\n123\t  totalResourcesCollected: Record<string, number>;\n124\t  buildingCounts: Record<string, number>;\n125\t  totalBuildingCount: number;\n126\t  pillsCrafted: Record<string, number>;\n127\t  totalPillsCrafted: number;\n128\t  allPillTypesCrafted: boolean;\n129\t  unlockedRegions: string[];\n130\t  ascensionCompleted: boolean;\n131\t  playtimeHours: number;\n132\t  crossRegionLinkCount: number;\n133\t}\n134\t"}]},"parent_tool_use_id":null,"session_id":"6abd1a50-ca4f-4f48-ad3d-d0b1dc08d31a","uuid":"8134461f-cda8-46af-bb28-740a959b7c47","timestamp":"2026-05-23T02:34:54.986Z","tool_use_result":{"type":"text","file":{"filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Achievement.ts","content":"// Achievement.ts — Achievement system with realm, production, automation, collection, and hidden achievements (v0.4.0)\n\nexport interface AchievementDef {\n  id: string;\n  name: string;\n  nameEn: string;\n  description: string;\n  category: 'realm' | 'production' | 'automation' | 'collection' | 'hidden';\n  condition: AchievementCondi