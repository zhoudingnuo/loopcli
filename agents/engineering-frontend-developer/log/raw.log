{"type":"assistant","message":{"id":"msg_202605230906341b779baf517d4da9","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_0dbc7e68c7c640c7805679e6","name":"Write","input":{"file_path":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\GameState.ts","content":"// GameState.ts — Immutable game state with save/load interface\n\nexport interface Resources {\n  spirit_stone: number;\n  spirit_grass: number;\n  spirit_energy: number;\n  cultivation: number;\n  pill_juling: number;\n  spirit_iron: number;\n}\n\nexport interface BuildingInstance {\n  uid: string;\n  buildingId: string;\n  gridX: number;\n  gridY: number;\n  level: number;\n  lastCollectTime: number;\n  isProducing: boolean;\n  progress: number;\n}\n\nexport interface RealmProgress {\n  realmId: string;\n  level: number;\n  exp: number;\n  expToNext: number;\n}\n\nexport interface GameMap {\n  regionId: string;\n  width: number;\n  height: number;\n  terrain: number[];\n  buildings: BuildingInstance[];\n}\n\nexport interface GameState {\n  resources: Resources;\n  realm: RealmProgress;\n  maps: GameMap[];\n  currentRegionIndex: number;\n  totalPlaytime: number;\n  lastSaveTime: number;\n  lastOnlineTime: number;\n  version: string;\n}\n\nexport interface SaveData {\n  version: string;\n  timestamp: number;\n  playtime: number;\n  gameState: GameState;\n}\n\nconst SAVE_KEY = 'cultivation_factory_save';\nconst CURRENT_VERSION = '0.1.0';\n\nfunction initialResources(): Resources {\n  return {\n    spirit_stone: 0,\n    spirit_grass: 0,\n    spirit_energy: 0,\n    cultivation: 0,\n    pill_juling: 0,\n    spirit_iron: 0,\n  };\n}\n\nfunction initialRealm(): RealmProgress {\n  return {\n    realmId: 'liqi',\n    level: 1,\n    exp: 0,\n    expToNext: 100,\n  };\n}\n\nexport function createInitialState(): GameState {\n  return {\n    resources: initialResources(),\n    realm: initialRealm(),\n    maps: [],\n    currentRegionIndex: 0,\n    totalPlaytime: 0,\n    lastSaveTime: Date.now(),\n    lastOnlineTime: Date.now(),\n    version: CURRENT_VERSION,\n  };\n}\n\nexport function cloneState(state: GameState): GameState {\n  return JSON.parse(JSON.stringify(state));\n}\n\n// Produce a new state with resource delta applied\nexport function addResources(state: GameState, delta: Partial<Resources>): GameState {\n  const next = cloneState(state);\n  for (const key of Object.keys(delta) as (keyof Resources)[]) {\n    next.resources[key] = Math.max(0, next.resources[key] + (delta[key] ?? 0));\n  }\n  return next;\n}\n\n// Add cultivation exp and check for level-up\nexport function addCultivation(state: GameState, amount: number): GameState {\n  const next = cloneState(state);\n  next.realm.exp += amount;\n  while (next.realm.exp >= next.realm.expToNext) {\n    next.realm.exp -= next.realm.expToNext;\n    next.realm.level += 1;\n    next.realm.expToNext = Math.floor(next.realm.expToNext * 1.8);\n  }\n  return next;\n}\n\n// Add a building to a map\nexport function placeBuilding(state: GameState, mapIndex: number, building: BuildingInstance): GameState {\n  const next = cloneState(state);\n  next.maps[mapIndex].buildings.push(building);\n  return next;\n}\n\n// Remove a building from a map\nexport function removeBuilding(state: GameState, mapIndex: number, buildingUid: string): GameState {\n  const next = cloneState(state);\n  const map = next.maps[mapIndex];\n  map.buildings = map.buildings.filter(b => b.uid !== buildingUid);\n  return next;\n}\n\n// Update a specific building\nexport function updateBuilding(\n  state: GameState,\n  mapIndex: number,\n  buildingUid: string,\n  patch: Partial<BuildingInstance>,\n): GameState {\n  const next = cloneState(state);\n  const building = next.maps[mapIndex].buildings.find(b => b.uid === buildingUid);\n  if (building) {\n    Object.assign(building, patch);\n  }\n  return next;\n}\n\n// Set a map on the state\nexport function setMap(state: GameState, index: number, map: GameMap): GameState {\n  const next = cloneState(state);\n  next.maps[index] = map;\n  return next;\n}\n\n// Save to localStorage\nexport function saveGame(state: GameState): void {\n  const data: SaveData = {\n    version: CURRENT_VERSION,\n    timestamp: Date.now(),\n    playtime: state.totalPlaytime,\n    gameState: state,\n  };\n  try {\n    localStorage.setItem(SAVE_KEY, JSON.stringify(data));\n  } catch {\n    console.warn('Save failed: storage quota exceeded');\n  }\n}\n\n// Load from localStorage\nexport function loadGame(): GameState | null {\n  try {\n    const raw = localStorage.getItem(SAVE_KEY);\n    if (!raw) return null;\n    const data: SaveData = JSON.parse(raw);\n    return data.gameState ?? null;\n  } catch {\n    return null;\n  }\n}\n\nexport function clearSave(): void {\n  localStorage.removeItem(SAVE_KEY);\n}\n\nlet autoSaveTimer = 0;\n\nexport function startAutoSave(getState: () => GameState, intervalMs: number = 300000): void {\n  stopAutoSave();\n  autoSaveTimer = window.setInterval(() => {\n    saveGame(getState());\n  }, intervalMs);\n}\n\nexport function stopAutoSave(): void {\n  if (autoSaveTimer) {\n    clearInterval(autoSaveTimer);\n    autoSaveTimer = 0;\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"1027b7ea-a18e-4300-8be2-f33dc07a79d1","uuid":"1c57694d-b65f-49ee-8d50-618fe86f51c0"}
{"type":"assistant","message":{"id":"msg_202605230906341b779baf517d4da9","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_bbcd6d390cb147a39cbaff41","name":"Write","input":{"file_path":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Map.ts","content":"// Map.ts — Grid-based map system with terrain and area rendering\n\nexport enum Terrain {\n  Grass = 0,\n  Rock = 1,\n  Water = 2,\n  RichSoil = 3,\n  Mountain = 4,\n  Path = 5,\n  SpiritVein = 6,\n}\n\nexport interface MapConfig {\n  width: number;\n  height: number;\n  bgColor: string;\n  gridColor: string;\n  cellSize: number;\n}\n\nexport const DEFAULT_CELL_SIZE = 32;\n\nexport class GameMap {\n  width: number;\n  height: number;\n  cellSize: number;\n  terrain: Terrain[];\n  bgColor: string;\n  gridColor: string;\n\n  constructor(\n    width: number,\n    height: number,\n    bgColor: string = '#2a3a1a',\n    gridColor: string = '#3a4a2a',\n    cellSize: number = DEFAULT_CELL_SIZE,\n  ) {\n    this.width = width;\n    this.height = height;\n    this.cellSize = cellSize;\n    this.bgColor = bgColor;\n    this.gridColor = gridColor;\n    this.terrain = new Array(width * height).fill(Terrain.Grass);\n  }\n\n  get indexSize(): number {\n    return this.width * this.height;\n  }\n\n  inBounds(gx: number, gy: number): boolean {\n    return gx >= 0 && gx < this.width && gy >= 0 && gy < this.height;\n  }\n\n  getTerrain(gx: number, gy: number): Terrain {\n    if (!this.inBounds(gx, gy)) return Terrain.Mountain;\n    return this.terrain[gy * this.width + gx];\n  }\n\n  setTerrain(gx: number, gy: number, t: Terrain): void {\n    if (!this.inBounds(gx, gy)) return;\n    this.terrain[gy * this.width + gx] = t;\n  }\n\n  // Check if a rect of cells is free for placement\n  isAreaFree(gx: number, gy: number, w: number, h: number, occupied: Set<string>): boolean {\n    for (let dy = 0; dy < h; dy++) {\n      for (let dx = 0; dx < w; dx++) {\n        const cx = gx + dx;\n        const cy = gy + dy;\n        if (!this.inBounds(cx, cy)) return false;\n        const t = this.getTerrain(cx, cy);\n        if (t === Terrain.Water || t === Terrain.Mountain) return false;\n        const key = `${cx},${cy}`;\n        if (occupied.has(key)) return false;\n      }\n    }\n    return true;\n  }\n\n  // Generate terrain for the starting area (炼气坪)\n  generateStartingArea(): void {\n    // Add some spirit veins (矿脉)\n    const veinPositions = [\n      [3, 2], [4, 2], [3, 3],\n      [14, 10], [15, 10], [15, 11],\n      [8, 7], [8, 8],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    // Add some water features\n    const waterPositions = [\n      [10, 1], [11, 1], [10, 2],\n      [1, 12], [2, 12], [1, 11],\n    ];\n    for (const [x, y] of waterPositions) {\n      this.setTerrain(x, y, Terrain.Water);\n    }\n\n    // Add path\n    for (let x = 5; x < 15; x++) {\n      this.setTerrain(x, 7, Terrain.Path);\n    }\n    for (let y = 3; y < 12; y++) {\n      this.setTerrain(10, y, Terrain.Path);\n    }\n\n    // Rich soil near center\n    for (let y = 5; y < 8; y++) {\n      for (let x = 6; x < 9; x++) {\n        this.setTerrain(x, y, Terrain.RichSoil);\n      }\n    }\n  }\n\n  // Render map terrain to canvas\n  render(\n    ctx: CanvasRenderingContext2D,\n    offsetX: number,\n    offsetY: number,\n    viewportW: number,\n    viewportH: number,\n    scale: number,\n  ): void {\n    const invScale = 1 / scale;\n    const startCol = Math.max(0, Math.floor(-offsetX * invScale / this.cellSize));\n    const startRow = Math.max(0, Math.floor(-offsetY * invScale / this.cellSize));\n    const endCol = Math.min(this.width, Math.ceil((-offsetX + viewportW) * invScale / this.cellSize) + 1);\n    const endRow = Math.min(this.height, Math.ceil((-offsetY + viewportH) * invScale / this.cellSize) + 1);\n\n    // Draw terrain cells\n    for (let row = startRow; row < endRow; row++) {\n      for (let col = startCol; col < endCol; col++) {\n        const x = offsetX + col * this.cellSize * scale;\n        const y = offsetY + row * this.cellSize * scale;\n        const size = this.cellSize * scale;\n\n        ctx.fillStyle = this.getTerrainColor(this.getTerrain(col, row));\n        ctx.fillRect(x, y, size, size);\n\n        // Draw grid line\n        ctx.strokeStyle = this.gridColor;\n        ctx.lineWidth = 0.5;\n        ctx.strokeRect(x, y, size, size);\n      }\n    }\n  }\n\n  private getTerrainColor(t: Terrain): string {\n    switch (t) {\n      case Terrain.Grass: return this.bgColor;\n      case Terrain.Rock: return '#3a3a4a';\n      case Terrain.Water: return '#1a3a5a';\n      case Terrain.RichSoil: return '#2a4a1a';\n      case Terrain.Mountain: return '#4a4a4a';\n      case Terrain.Path: return '#4a3a2a';\n      case Terrain.SpiritVein: return '#2a4a5a';\n      default: return this.bgColor;\n    }\n  }\n\n  // Screen coordinates to grid cell\n  screenToGrid(\n    screenX: number,\n    screenY: number,\n    offsetX: number,\n    offsetY: number,\n    scale: number,\n  ): { gx: number; gy: number } {\n    const invScale = 1 / scale;\n    const gx = Math.floor((screenX - offsetX) * invScale / this.cellSize);\n    const gy = Math.floor((screenY - offsetY) * invScale / this.cellSize);\n    return { gx, gy };\n  }\n\n  // Grid cell center to screen coordinates\n  gridToScreen(\n    gx: number,\n    gy: number,\n    offsetX: number,\n    offsetY: number,\n    scale: number,\n  ): { x: number; y: number } {\n    return {\n      x: offsetX + (gx + 0.5) * this.cellSize * scale,\n      y: offsetY + (gy + 0.5) * this.cellSize * scale,\n    };\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"1027b7ea-a18e-4300-8be2-f33dc07a79d1","uuid":"6b536ef2-44ab-43d2-9b37-32b9c15c3d03"}
{"type":"assistant","message":{"id":"msg_202605230906341b779baf517d4da9","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_7116b6053dea401f924c5f40","name":"Write","input":{"file_path":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Building.ts","content":"// Building.ts — Building placement system with grid validation\n\nimport type { BuildingInstance } from './GameState';\nimport { GameMap, Terrain } from './Map';\n\nexport interface BuildingDef {\n  id: string;\n  name: string;\n  nameEn: string;\n  type: string;\n  category: string;\n  cost: Record<string, number>;\n  size: { w: number; h: number };\n  production: {\n    resource: string;\n    amount: number;\n    interval: number;\n    mode: string;\n    input?: Record<string, number>;\n  };\n  description: string;\n  unlockRealm: string;\n  maxLevel: number;\n  color: { r: number; g: number; b: number; a: number };\n}\n\nlet uidCounter = 0;\n\nexport function generateUid(): string {\n  return `b_${Date.now()}_${++uidCounter}`;\n}\n\nexport function createBuildingInstance(\n  buildingId: string,\n  gridX: number,\n  gridY: number,\n): BuildingInstance {\n  return {\n    uid: generateUid(),\n    buildingId,\n    gridX,\n    gridY,\n    level: 1,\n    lastCollectTime: 0,\n    isProducing: false,\n    progress: 0,\n  };\n}\n\n// Check if a building can be placed at the given position\nexport function canPlace(\n  map: GameMap,\n  def: BuildingDef,\n  gridX: number,\n  gridY: number,\n  existingBuildings: BuildingInstance[],\n): boolean {\n  // Build occupied set from existing buildings\n  const occupied = buildOccupiedSet(existingBuildings);\n\n  // Check the area is free\n  if (!map.isAreaFree(gridX, gridY, def.size.w, def.size.h, occupied)) {\n    return false;\n  }\n\n  // Spirit vein buildings should be near spirit veins\n  if (def.category === 'mining') {\n    let nearVein = false;\n    for (let dy = -1; dy <= def.size.h && !nearVein; dy++) {\n      for (let dx = -1; dx <= def.size.w && !nearVein; dx++) {\n        const t = map.getTerrain(gridX + dx, gridY + dy);\n        if (t === Terrain.SpiritVein) nearVein = true;\n      }\n    }\n    // Allow placement anywhere for now (relaxed constraint for M1)\n  }\n\n  return true;\n}\n\n// Get all grid cells occupied by a building\nexport function getBuildingCells(building: BuildingInstance, def: BuildingDef): string[] {\n  const cells: string[] = [];\n  for (let dy = 0; dy < def.size.h; dy++) {\n    for (let dx = 0; dx < def.size.w; dx++) {\n      cells.push(`${building.gridX + dx},${building.gridY + dy}`);\n    }\n  }\n  return cells;\n}\n\n// Build a set of occupied grid positions\nexport function buildOccupiedSet(buildings: BuildingInstance[], defs?: Map<string, BuildingDef>): Set<string> {\n  const occupied = new Set<string>();\n  for (const b of buildings) {\n    const size = defs?.get(b.buildingId)?.size ?? { w: 1, h: 1 };\n    for (let dy = 0; dy < size.h; dy++) {\n      for (let dx = 0; dx < size.w; dx++) {\n        occupied.add(`${b.gridX + dx},${b.gridY + dy}`);\n      }\n    }\n  }\n  return occupied;\n}\n\n// Render a building on canvas\nexport function renderBuilding(\n  ctx: CanvasRenderingContext2D,\n  building: BuildingInstance,\n  def: BuildingDef,\n  offsetX: number,\n  offsetY: number,\n  scale: number,\n  cellSize: number,\n  now: number,\n): void {\n  const x = offsetX + building.gridX * cellSize * scale;\n  const y = offsetY + building.gridY * cellSize * scale;\n  const w = def.size.w * cellSize * scale;\n  const h = def.size.h * cellSize * scale;\n\n  const { r, g, b, a } = def.color;\n\n  // Building body\n  ctx.fillStyle = `rgba(${r},${g},${b},${a})`;\n  ctx.fillRect(x + 2, y + 2, w - 4, h - 4);\n\n  // Border\n  ctx.strokeStyle = `rgba(${Math.min(255, r + 40)},${Math.min(255, g + 40)},${Math.min(255, b + 40)},0.8)`;\n  ctx.lineWidth = 1.5;\n  ctx.strokeRect(x + 2, y + 2, w - 4, h - 4);\n\n  // Icon/label\n  const fontSize = Math.max(8, Math.floor(10 * scale));\n  ctx.fillStyle = '#fff';\n  ctx.font = `bold ${fontSize}px monospace`;\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n\n  const centerX = x + w / 2;\n  const centerY = y + h / 2;\n\n  // Draw icon based on category\n  const icon = getCategoryIcon(def.category);\n  ctx.font = `${Math.max(12, Math.floor(16 * scale))}px serif`;\n  ctx.fillText(icon, centerX, centerY - 4 * scale);\n\n  // Draw level\n  ctx.font = `bold ${Math.max(6, Math.floor(8 * scale))}px monospace`;\n  ctx.fillStyle = '#ffd700';\n  ctx.fillText(`Lv${building.level}`, centerX, centerY + 10 * scale);\n\n  // Progress bar for auto-production\n  if (def.production.mode === 'auto' && building.isProducing) {\n    const barW = w - 8;\n    const barH = 3 * scale;\n    const barY = y + h - 6 * scale;\n    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n    ctx.fillRect(x + 4, barY, barW, barH);\n    ctx.fillStyle = '#4f4';\n    ctx.fillRect(x + 4, barY, barW * building.progress, barH);\n  }\n\n  // Production ready indicator (for manual buildings)\n  if (def.production.mode === 'manual' && building.progress >= 1) {\n    ctx.fillStyle = '#ff0';\n    ctx.beginPath();\n    ctx.arc(x + w - 6 * scale, y + 6 * scale, 3 * scale, 0, Math.PI * 2);\n    ctx.fill();\n  }\n}\n\nfunction getCategoryIcon(category: string): string {\n  const icons: Record<string, string> = {\n    mining: '⛏',\n    farming: '🌿',\n    alchemy: '🔥',\n    energy: '✨',\n    transport: '➡',\n    control: '📜',\n  };\n  return icons[category] || '🏠';\n}\n\n// Parse building definitions from JSON\nexport function loadBuildingDefs(data: { buildings: BuildingDef[] }): Map<string, BuildingDef> {\n  const map = new Map<string, BuildingDef>();\n  for (const b of data.buildings) {\n    map.set(b.id, b);\n  }\n  return map;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"1027b7ea-a18e-4300-8be2-f33dc07a79d1","uuid":"7299fd4f-2bda-402c-b369-a84af644a5ce"}
{"type":"assistant","message":{"id":"msg_202605230906341b779baf517d4da9","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_d0179e6f2cba4608adcc8981","name":"Write","input":{"file_path":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Resources.ts","content":"// Resources.ts — Resource management with manual collection and display\n\nimport type { GameState, Resources, BuildingInstance } from './GameState';\nimport { addResources, addCultivation, updateBuilding } from './GameState';\nimport type { BuildingDef } from './Building';\n\nexport interface ResourceDisplay {\n  id: string;\n  name: string;\n  amount: number;\n  icon: string;\n  color: string;\n}\n\nconst RESOURCE_META: Record<string, { name: string; icon: string; color: string }> = {\n  spirit_stone: { name: '灵石', icon: '💎', color: '#7cc8ff' },\n  spirit_grass: { name: '灵草', icon: '🌿', color: '#6adf6a' },\n  spirit_energy: { name: '灵气', icon: '✨', color: '#b480ff' },\n  cultivation: { name: '修为', icon: '⚡', color: '#ffd700' },\n  pill_juling: { name: '聚灵丹', icon: '💊', color: '#ff8c32' },\n  spirit_iron: { name: '灵铁', icon: '🔩', color: '#8a8aaa' },\n};\n\nexport function getResourceDisplays(resources: Resources): ResourceDisplay[] {\n  const displays: ResourceDisplay[] = [];\n  for (const [id, meta] of Object.entries(RESOURCE_META)) {\n    displays.push({\n      id,\n      name: meta.name,\n      amount: resources[id as keyof Resources] ?? 0,\n      icon: meta.icon,\n      color: meta.color,\n    });\n  }\n  return displays;\n}\n\n// Manual collection: player clicks a building to collect\nexport function collectFromBuilding(\n  state: GameState,\n  building: BuildingInstance,\n  def: BuildingDef,\n  mapIndex: number,\n): GameState {\n  if (def.production.mode !== 'manual') return state;\n\n  const prod = def.production;\n\n  // Check if we need input resources\n  if (prod.input) {\n    const canAfford = Object.entries(prod.input).every(\n      ([res, cost]) => (state.resources[res as keyof Resources] ?? 0) >= cost,\n    );\n    if (!canAfford) return state;\n\n    // Consume input resources\n    const inputDelta: Partial<Resources> = {};\n    for (const [res, cost] of Object.entries(prod.input)) {\n      (inputDelta as Record<string, number>)[res] = -cost;\n    }\n    state = addResources(state, inputDelta);\n  }\n\n  // For fields, check if ready for harvest\n  if (def.category === 'farming') {\n    if (building.progress < 1) return state;\n    // Reset progress after harvest\n    state = updateBuilding(state, mapIndex, building.uid, {\n      progress: 0,\n      isProducing: false,\n    });\n  }\n\n  // Add produced resource\n  const delta: Partial<Resources> = {};\n  (delta as Record<string, number>)[prod.resource] = prod.amount;\n  state = addResources(state, delta);\n\n  // Cultivation gives exp\n  if (prod.resource === 'cultivation') {\n    state = addCultivation(state, prod.amount);\n  }\n\n  return state;\n}\n\n// Plant a field (starts growth timer)\nexport function plantField(\n  state: GameState,\n  building: BuildingInstance,\n  mapIndex: number,\n): GameState {\n  return updateBuilding(state, mapIndex, building.uid, {\n    isProducing: true,\n    progress: 0,\n    lastCollectTime: Date.now(),\n  });\n}\n\n// Update auto-production buildings (called every tick)\nexport function tickAutoProduction(\n  state: GameState,\n  mapIndex: number,\n  now: number,\n  buildingDefs: Map<string, BuildingDef>,\n): GameState {\n  const map = state.maps[mapIndex];\n  if (!map) return state;\n\n  for (const building of map.buildings) {\n    const def = buildingDefs.get(building.buildingId);\n    if (!def || def.production.mode !== 'auto') continue;\n\n    if (!building.isProducing) {\n      // Start production\n      state = updateBuilding(state, mapIndex, building.uid, {\n        isProducing: true,\n        lastCollectTime: now,\n        progress: 0,\n      });\n      continue;\n    }\n\n    const elapsed = now - building.lastCollectTime;\n    const interval = def.production.interval;\n    const progress = Math.min(1, elapsed / interval);\n\n    if (progress >= 1) {\n      // Production complete — collect and restart\n      const delta: Partial<Resources> = {};\n      (delta as Record<string, number>)[def.production.resource] = def.production.amount;\n      state = addResources(state, delta);\n\n      state = updateBuilding(state, mapIndex, building.uid, {\n        lastCollectTime: now,\n        progress: 0,\n      });\n    } else {\n      state = updateBuilding(state, mapIndex, building.uid, { progress });\n    }\n  }\n\n  return state;\n}\n\n// Tick manual buildings (e.g. field growth)\nexport function tickManualProduction(\n  state: GameState,\n  mapIndex: number,\n  now: number,\n  buildingDefs: Map<string, BuildingDef>,\n): GameState {\n  const map = state.maps[mapIndex];\n  if (!map) return state;\n\n  for (const building of map.buildings) {\n    const def = buildingDefs.get(building.buildingId);\n    if (!def || def.production.mode !== 'manual') continue;\n    if (!building.isProducing) continue;\n\n    const elapsed = now - building.lastCollectTime;\n    const interval = def.production.interval;\n    const progress = Math.min(1, elapsed / interval);\n\n    state = updateBuilding(state, mapIndex, building.uid, { progress });\n  }\n\n  return state;\n}\n\n// Format resource amounts for display (e.g. 1200 → \"1.2K\")\nexport function formatAmount(amount: number): string {\n  if (amount >= 1_000_000) return (amount / 1_000_000).toFixed(1) + 'M';\n  if (amount >= 10_000) return (amount / 1_000).toFixed(1) + 'K';\n  if (amount >= 1_000) return (amount / 1_000).toFixed(1) + 'K';\n  return Math.floor(amount).toString();\n}\n\n// Check if player can afford a cost\nexport function canAfford(resources: Resources, cost: Record<string, number>): boolean {\n  return Object.entries(cost).every(\n    ([res, amount]) => (resources[res as keyof Resources] ?? 0) >= amount,\n  );\n}\n\n// Deduct cost from resources\nexport function deductCost(state: GameState, cost: Record<string, number>): GameState {\n  const delta: Partial<Resources> = {};\n  for (const [res, amount] of Object.entries(cost)) {\n    (delta as Record<string, number>)[res] = -amount;\n  }\n  return addResources(state, delta);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"1027b7ea-a18e-4300-8be2-f33dc07a79d1","uuid":"54598c09-6724-4a1c-acea-ceb98f46d8c2"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_0dbc7e68c7c640c7805679e6","type":"tool_result","content":"File created successfully at: D:\\game-projects\\steam-cultivation-factory\\src\\game\\GameState.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"1027b7ea-a18e-4300-8be2-f33dc07a79d1","uuid":"06f4756f-3842-49d2-959d-829a027e4181","timestamp":"2026-05-23T01:08:06.463Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\GameState.ts","content":"// GameState.ts — Immutable game state with save/load interface\n\nexport interface Resources {\n  spirit_stone: number;\n  spirit_grass: number;\n  spirit_energy: number;\n  cultivation: number;\n  pill_juling: number;\n  spirit_iron: number;\n}\n\nexport interface BuildingInstance {\n  uid: string;\n  buildingId: string;\n  gridX: number;\n  gridY: number;\n  level: number;\n  lastCollectTime: number;\n  isProducing: boolean;\n  progress: number;\n}\n\nexport interface RealmProgress {\n  realmId: string;\n  level: number;\n  exp: number;\n  expToNext: number;\n}\n\nexport interface GameMap {\n  regionId: string;\n  width: number;\n  height: number;\n  terrain: number[];\n  buildings: BuildingInstance[];\n}\n\nexport interface GameState {\n  resources: Resources;\n  realm: RealmProgress;\n  maps: GameMap[];\n  currentRegionIndex: number;\n  totalPlaytime: number;\n  lastSaveTime: number;\n  lastOnlineTime: number;\n  version: string;\n}\n\nexport interface SaveData {\n  version: string;\n  timestamp: number;\n  playtime: number;\n  gameState: GameState;\n}\n\nconst SAVE_KEY = 'cultivation_factory_save';\nconst CURRENT_VERSION = '0.1.0';\n\nfunction initialResources(): Resources {\n  return {\n    spirit_stone: 0,\n    spirit_grass: 0,\n    spirit_energy: 0,\n    cultivation: 0,\n    pill_juling: 0,\n    spirit_iron: 0,\n  };\n}\n\nfunction initialRealm(): RealmProgress {\n  return {\n    realmId: 'liqi',\n    level: 1,\n    exp: 0,\n    expToNext: 100,\n  };\n}\n\nexport function createInitialState(): GameState {\n  return {\n    resources: initialResources(),\n    realm: initialRealm(),\n    maps: [],\n    currentRegionIndex: 0,\n    totalPlaytime: 0,\n    lastSaveTime: Date.now(),\n    lastOnlineTime: Date.now(),\n    version: CURRENT_VERSION,\n  };\n}\n\nexport function cloneState(state: GameState): GameState {\n  return JSON.parse(JSON.stringify(state));\n}\n\n// Produce a new state with resource delta applied\nexport function addResources(state: GameState, delta: Partial<Resources>): GameState {\n  const next = cloneState(state);\n  for (const key of Object.keys(delta) as (keyof Resources)[]) {\n    next.resources[key] = Math.max(0, next.resources[key] + (delta[key] ?? 0));\n  }\n  return next;\n}\n\n// Add cultivation exp and check for level-up\nexport function addCultivation(state: GameState, amount: number): GameState {\n  const next = cloneState(state);\n  next.realm.exp += amount;\n  while (next.realm.exp >= next.realm.expToNext) {\n    next.realm.exp -= next.realm.expToNext;\n    next.realm.level += 1;\n    next.realm.expToNext = Math.floor(next.realm.expToNext * 1.8);\n  }\n  return next;\n}\n\n// Add a building to a map\nexport function placeBuilding(state: GameState, mapIndex: number, building: BuildingInstance): GameState {\n  const next = cloneState(state);\n  next.maps[mapIndex].buildings.push(building);\n  return next;\n}\n\n// Remove a building from a map\nexport function removeBuilding(state: GameState, mapIndex: number, buildingUid: string): GameState {\n  const next = cloneState(state);\n  const map = next.maps[mapIndex];\n  map.buildings = map.buildings.filter(b => b.uid !== buildingUid);\n  return next;\n}\n\n// Update a specific building\nexport function updateBuilding(\n  state: GameState,\n  mapIndex: number,\n  buildingUid: string,\n  patch: Partial<BuildingInstance>,\n): GameState {\n  const next = cloneState(state);\n  const building = next.maps[mapIndex].buildings.find(b => b.uid === buildingUid);\n  if (building) {\n    Object.assign(building, patch);\n  }\n  return next;\n}\n\n// Set a map on the state\nexport function setMap(state: GameState, index: number, map: GameMap): GameState {\n  const next = cloneState(state);\n  next.maps[index] = map;\n  return next;\n}\n\n// Save to localStorage\nexport function saveGame(state: GameState): void {\n  const data: SaveData = {\n    version: CURRENT_VERSION,\n    timestamp: Date.now(),\n    playtime: state.totalPlaytime,\n    gameState: state,\n  };\n  try {\n    localStorage.setItem(SAVE_KEY, JSON.stringify(data));\n  } catch {\n    console.warn('Save failed: storage quota exceeded');\n  }\n}\n\n// Load from localStorage\nexport function loadGame(): GameState | null {\n  try {\n    const raw = localStorage.getItem(SAVE_KEY);\n    if (!raw) return null;\n    const data: SaveData = JSON.parse(raw);\n    return data.gameState ?? null;\n  } catch {\n    return null;\n  }\n}\n\nexport function clearSave(): void {\n  localStorage.removeItem(SAVE_KEY);\n}\n\nlet autoSaveTimer = 0;\n\nexport function startAutoSave(getState: () => GameState, intervalMs: number = 300000): void {\n  stopAutoSave();\n  autoSaveTimer = window.setInterval(() => {\n    saveGame(getState());\n  }, intervalMs);\n}\n\nexport function stopAutoSave(): void {\n  if (autoSaveTimer) {\n    clearInterval(autoSaveTimer);\n    autoSaveTimer = 0;\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_bbcd6d390cb147a39cbaff41","type":"tool_result","content":"File created successfully at: D:\\game-projects\\steam-cultivation-factory\\src\\game\\Map.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"1027b7ea-a18e-4300-8be2-f33dc07a79d1","uuid":"5809e5e5-0d96-4f5b-b73a-86e71659ba42","timestamp":"2026-05-23T01:08:07.249Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Map.ts","content":"// Map.ts — Grid-based map system with terrain and area rendering\n\nexport enum Terrain {\n  Grass = 0,\n  Rock = 1,\n  Water = 2,\n  RichSoil = 3,\n  Mountain = 4,\n  Path = 5,\n  SpiritVein = 6,\n}\n\nexport interface MapConfig {\n  width: number;\n  height: number;\n  bgColor: string;\n  gridColor: string;\n  cellSize: number;\n}\n\nexport const DEFAULT_CELL_SIZE = 32;\n\nexport class GameMap {\n  width: number;\n  height: number;\n  cellSize: number;\n  terrain: Terrain[];\n  bgColor: string;\n  gridColor: string;\n\n  constructor(\n    width: number,\n    height: number,\n    bgColor: string = '#2a3a1a',\n    gridColor: string = '#3a4a2a',\n    cellSize: number = DEFAULT_CELL_SIZE,\n  ) {\n    this.width = width;\n    this.height = height;\n    this.cellSize = cellSize;\n    this.bgColor = bgColor;\n    this.gridColor = gridColor;\n    this.terrain = new Array(width * height).fill(Terrain.Grass);\n  }\n\n  get indexSize(): number {\n    return this.width * this.height;\n  }\n\n  inBounds(gx: number, gy: number): boolean {\n    return gx >= 0 && gx < this.width && gy >= 0 && gy < this.height;\n  }\n\n  getTerrain(gx: number, gy: number): Terrain {\n    if (!this.inBounds(gx, gy)) return Terrain.Mountain;\n    return this.terrain[gy * this.width + gx];\n  }\n\n  setTerrain(gx: number, gy: number, t: Terrain): void {\n    if (!this.inBounds(gx, gy)) return;\n    this.terrain[gy * this.width + gx] = t;\n  }\n\n  // Check if a rect of cells is free for placement\n  isAreaFree(gx: number, gy: number, w: number, h: number, occupied: Set<string>): boolean {\n    for (let dy = 0; dy < h; dy++) {\n      for (let dx = 0; dx < w; dx++) {\n        const cx = gx + dx;\n        const cy = gy + dy;\n        if (!this.inBounds(cx, cy)) return false;\n        const t = this.getTerrain(cx, cy);\n        if (t === Terrain.Water || t === Terrain.Mountain) return false;\n        const key = `${cx},${cy}`;\n        if (occupied.has(key)) return false;\n      }\n    }\n    return true;\n  }\n\n  // Generate terrain for the starting area (炼气坪)\n  generateStartingArea(): void {\n    // Add some spirit veins (矿脉)\n    const veinPositions = [\n      [3, 2], [4, 2], [3, 3],\n      [14, 10], [15, 10], [15, 11],\n      [8, 7], [8, 8],\n    ];\n    for (const [x, y] of veinPositions) {\n      this.setTerrain(x, y, Terrain.SpiritVein);\n    }\n\n    // Add some water features\n    const waterPositions = [\n      [10, 1], [11, 1], [10, 2],\n      [1, 12], [2, 12], [1, 11],\n    ];\n    for (const [x, y] of waterPositions) {\n      this.setTerrain(x, y, Terrain.Water);\n    }\n\n    // Add path\n    for (let x = 5; x < 15; x++) {\n      this.setTerrain(x, 7, Terrain.Path);\n    }\n    for (let y = 3; y < 12; y++) {\n      this.setTerrain(10, y, Terrain.Path);\n    }\n\n    // Rich soil near center\n    for (let y = 5; y < 8; y++) {\n      for (let x = 6; x < 9; x++) {\n        this.setTerrain(x, y, Terrain.RichSoil);\n      }\n    }\n  }\n\n  // Render map terrain to canvas\n  render(\n    ctx: CanvasRenderingContext2D,\n    offsetX: number,\n    offsetY: number,\n    viewportW: number,\n    viewportH: number,\n    scale: number,\n  ): void {\n    const invScale = 1 / scale;\n    const startCol = Math.max(0, Math.floor(-offsetX * invScale / this.cellSize));\n    const startRow = Math.max(0, Math.floor(-offsetY * invScale / this.cellSize));\n    const endCol = Math.min(this.width, Math.ceil((-offsetX + viewportW) * invScale / this.cellSize) + 1);\n    const endRow = Math.min(this.height, Math.ceil((-offsetY + viewportH) * invScale / this.cellSize) + 1);\n\n    // Draw terrain cells\n    for (let row = startRow; row < endRow; row++) {\n      for (let col = startCol; col < endCol; col++) {\n        const x = offsetX + col * this.cellSize * scale;\n        const y = offsetY + row * this.cellSize * scale;\n        const size = this.cellSize * scale;\n\n        ctx.fillStyle = this.getTerrainColor(this.getTerrain(col, row));\n        ctx.fillRect(x, y, size, size);\n\n        // Draw grid line\n        ctx.strokeStyle = this.gridColor;\n        ctx.lineWidth = 0.5;\n        ctx.strokeRect(x, y, size, size);\n      }\n    }\n  }\n\n  private getTerrainColor(t: Terrain): string {\n    switch (t) {\n      case Terrain.Grass: return this.bgColor;\n      case Terrain.Rock: return '#3a3a4a';\n      case Terrain.Water: return '#1a3a5a';\n      case Terrain.RichSoil: return '#2a4a1a';\n      case Terrain.Mountain: return '#4a4a4a';\n      case Terrain.Path: return '#4a3a2a';\n      case Terrain.SpiritVein: return '#2a4a5a';\n      default: return this.bgColor;\n    }\n  }\n\n  // Screen coordinates to grid cell\n  screenToGrid(\n    screenX: number,\n    screenY: number,\n    offsetX: number,\n    offsetY: number,\n    scale: number,\n  ): { gx: number; gy: number } {\n    const invScale = 1 / scale;\n    const gx = Math.floor((screenX - offsetX) * invScale / this.cellSize);\n    const gy = Math.floor((screenY - offsetY) * invScale / this.cellSize);\n    return { gx, gy };\n  }\n\n  // Grid cell center to screen coordinates\n  gridToScreen(\n    gx: number,\n    gy: number,\n    offsetX: number,\n    offsetY: number,\n    scale: number,\n  ): { x: number; y: number } {\n    return {\n      x: offsetX + (gx + 0.5) * this.cellSize * scale,\n      y: offsetY + (gy + 0.5) * this.cellSize * scale,\n    };\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_7116b6053dea401f924c5f40","type":"tool_result","content":"File created successfully at: D:\\game-projects\\steam-cultivation-factory\\src\\game\\Building.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"1027b7ea-a18e-4300-8be2-f33dc07a79d1","uuid":"193122f6-6c86-47ac-b1a3-82301e02da6f","timestamp":"2026-05-23T01:08:08.077Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Building.ts","content":"// Building.ts — Building placement system with grid validation\n\nimport type { BuildingInstance } from './GameState';\nimport { GameMap, Terrain } from './Map';\n\nexport interface BuildingDef {\n  id: string;\n  name: string;\n  nameEn: string;\n  type: string;\n  category: string;\n  cost: Record<string, number>;\n  size: { w: number; h: number };\n  production: {\n    resource: string;\n    amount: number;\n    interval: number;\n    mode: string;\n    input?: Record<string, number>;\n  };\n  description: string;\n  unlockRealm: string;\n  maxLevel: number;\n  color: { r: number; g: number; b: number; a: number };\n}\n\nlet uidCounter = 0;\n\nexport function generateUid(): string {\n  return `b_${Date.now()}_${++uidCounter}`;\n}\n\nexport function createBuildingInstance(\n  buildingId: string,\n  gridX: number,\n  gridY: number,\n): BuildingInstance {\n  return {\n    uid: generateUid(),\n    buildingId,\n    gridX,\n    gridY,\n    level: 1,\n    lastCollectTime: 0,\n    isProducing: false,\n    progress: 0,\n  };\n}\n\n// Check if a building can be placed at the given position\nexport function canPlace(\n  map: GameMap,\n  def: BuildingDef,\n  gridX: number,\n  gridY: number,\n  existingBuildings: BuildingInstance[],\n): boolean {\n  // Build occupied set from existing buildings\n  const occupied = buildOccupiedSet(existingBuildings);\n\n  // Check the area is free\n  if (!map.isAreaFree(gridX, gridY, def.size.w, def.size.h, occupied)) {\n    return false;\n  }\n\n  // Spirit vein buildings should be near spirit veins\n  if (def.category === 'mining') {\n    let nearVein = false;\n    for (let dy = -1; dy <= def.size.h && !nearVein; dy++) {\n      for (let dx = -1; dx <= def.size.w && !nearVein; dx++) {\n        const t = map.getTerrain(gridX + dx, gridY + dy);\n        if (t === Terrain.SpiritVein) nearVein = true;\n      }\n    }\n    // Allow placement anywhere for now (relaxed constraint for M1)\n  }\n\n  return true;\n}\n\n// Get all grid cells occupied by a building\nexport function getBuildingCells(building: BuildingInstance, def: BuildingDef): string[] {\n  const cells: string[] = [];\n  for (let dy = 0; dy < def.size.h; dy++) {\n    for (let dx = 0; dx < def.size.w; dx++) {\n      cells.push(`${building.gridX + dx},${building.gridY + dy}`);\n    }\n  }\n  return cells;\n}\n\n// Build a set of occupied grid positions\nexport function buildOccupiedSet(buildings: BuildingInstance[], defs?: Map<string, BuildingDef>): Set<string> {\n  const occupied = new Set<string>();\n  for (const b of buildings) {\n    const size = defs?.get(b.buildingId)?.size ?? { w: 1, h: 1 };\n    for (let dy = 0; dy < size.h; dy++) {\n      for (let dx = 0; dx < size.w; dx++) {\n        occupied.add(`${b.gridX + dx},${b.gridY + dy}`);\n      }\n    }\n  }\n  return occupied;\n}\n\n// Render a building on canvas\nexport function renderBuilding(\n  ctx: CanvasRenderingContext2D,\n  building: BuildingInstance,\n  def: BuildingDef,\n  offsetX: number,\n  offsetY: number,\n  scale: number,\n  cellSize: number,\n  now: number,\n): void {\n  const x = offsetX + building.gridX * cellSize * scale;\n  const y = offsetY + building.gridY * cellSize * scale;\n  const w = def.size.w * cellSize * scale;\n  const h = def.size.h * cellSize * scale;\n\n  const { r, g, b, a } = def.color;\n\n  // Building body\n  ctx.fillStyle = `rgba(${r},${g},${b},${a})`;\n  ctx.fillRect(x + 2, y + 2, w - 4, h - 4);\n\n  // Border\n  ctx.strokeStyle = `rgba(${Math.min(255, r + 40)},${Math.min(255, g + 40)},${Math.min(255, b + 40)},0.8)`;\n  ctx.lineWidth = 1.5;\n  ctx.strokeRect(x + 2, y + 2, w - 4, h - 4);\n\n  // Icon/label\n  const fontSize = Math.max(8, Math.floor(10 * scale));\n  ctx.fillStyle = '#fff';\n  ctx.font = `bold ${fontSize}px monospace`;\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n\n  const centerX = x + w / 2;\n  const centerY = y + h / 2;\n\n  // Draw icon based on category\n  const icon = getCategoryIcon(def.category);\n  ctx.font = `${Math.max(12, Math.floor(16 * scale))}px serif`;\n  ctx.fillText(icon, centerX, centerY - 4 * scale);\n\n  // Draw level\n  ctx.font = `bold ${Math.max(6, Math.floor(8 * scale))}px monospace`;\n  ctx.fillStyle = '#ffd700';\n  ctx.fillText(`Lv${building.level}`, centerX, centerY + 10 * scale);\n\n  // Progress bar for auto-production\n  if (def.production.mode === 'auto' && building.isProducing) {\n    const barW = w - 8;\n    const barH = 3 * scale;\n    const barY = y + h - 6 * scale;\n    ctx.fillStyle = 'rgba(0,0,0,0.5)';\n    ctx.fillRect(x + 4, barY, barW, barH);\n    ctx.fillStyle = '#4f4';\n    ctx.fillRect(x + 4, barY, barW * building.progress, barH);\n  }\n\n  // Production ready indicator (for manual buildings)\n  if (def.production.mode === 'manual' && building.progress >= 1) {\n    ctx.fillStyle = '#ff0';\n    ctx.beginPath();\n    ctx.arc(x + w - 6 * scale, y + 6 * scale, 3 * scale, 0, Math.PI * 2);\n    ctx.fill();\n  }\n}\n\nfunction getCategoryIcon(category: string): string {\n  const icons: Record<string, string> = {\n    mining: '⛏',\n    farming: '🌿',\n    alchemy: '🔥',\n    energy: '✨',\n    transport: '➡',\n    control: '📜',\n  };\n  return icons[category] || '🏠';\n}\n\n// Parse building definitions from JSON\nexport function loadBuildingDefs(data: { buildings: BuildingDef[] }): Map<string, BuildingDef> {\n  const map = new Map<string, BuildingDef>();\n  for (const b of data.buildings) {\n    map.set(b.id, b);\n  }\n  return map;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_d0179e6f2cba4608adcc8981","type":"tool_result","content":"File created successfully at: D:\\game-projects\\steam-cultivation-factory\\src\\game\\Resources.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"1027b7ea-a18e-4300-8be2-f33dc07a79d1","uuid":"6f2e5b23-4fef-4377-b1bf-ab5da706f537","timestamp":"2026-05-23T01:08:08.896Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\steam-cultivation-factory\\src\\game\\Resources.ts","content":"// Resources.ts — Resource management with manual collection and display\n\nimport type { GameState, Resources, BuildingInstance } from './GameState';\nimport { addResources, addCultivation, updateBuilding } from './GameState';\nimport type { BuildingDef } from './Building';\n\nexport interface ResourceDisplay {\n  id: string;\n  name: string;\n  amount: number;\n  icon: string;\n  color: string;\n}\n\nconst RESOURCE_META: Record<string, { name: string; icon: string; color: string }> = {\n  spirit_stone: { name: '灵石', icon: '💎', color: '#7cc8ff' },\n  spirit_grass: { name: '灵草', icon: '🌿', color: '#6adf6a' },\n  spirit_energy: { name: '灵气', icon: '✨', color: '#b480ff' },\n  cultivation: { name: '修为', icon: '⚡', color: '#ffd700' },\n  pill_juling: { name: '聚灵丹', icon: '💊', color: '#ff8c32' },\n  spirit_iron: { name: '灵铁', icon: '🔩', color: '#8a8aaa' },\n};\n\nexport function getResourceDisplays(resources: Resources): ResourceDisplay[] {\n  const displays: ResourceDisplay[] = [];\n  for (const [id, meta] of Object.entries(RESOURCE_META)) {\n    displays.push({\n      id,\n      name: meta.name,\n      amount: resources[id as keyof Resources] ?? 0,\n      icon: meta.icon,\n      color: meta.color,\n    });\n  }\n  return displays;\n}\n\n// Manual collection: player clicks a building to collect\nexport function collectFromBuilding(\n  state: GameState,\n  building: BuildingInstance,\n  def: BuildingDef,\n  mapIndex: number,\n): GameState {\n  if (def.production.mode !== 'manual') return state;\n\n  const prod = def.production;\n\n  // Check if we need input resources\n  if (prod.input) {\n    const canAfford = Object.entries(prod.input).every(\n      ([res, cost]) => (state.resources[res as keyof Resources] ?? 0) >= cost,\n    );\n    if (!canAfford) return state;\n\n    // Consume input resources\n    const inputDelta: Partial<Resources> = {};\n    for (const [res, cost] of Object.entries(prod.input)) {\n      (inputDelta as Record<string, number>)[res] = -cost;\n    }\n    state = addResources(state, inputDelta);\n  }\n\n  // For fields, check if ready for harvest\n  if (def.category === 'farming') {\n    if (building.progress < 1) return state;\n    // Reset progress after harvest\n    state = updateBuilding(state, mapIndex, building.uid, {\n      progress: 0,\n      isProducing: false,\n    });\n  }\n\n  // Add produced resource\n  const delta: Partial<Resources> = {};\n  (delta as Record<string, number>)[prod.resource] = prod.amount;\n  state = addResources(state, delta);\n\n  // Cultivation gives exp\n  if (prod.resource === 'cultivation') {\n    state = addCultivation(state, prod.amount);\n  }\n\n  return state;\n}\n\n// Plant a field (starts growth timer)\nexport function plantField(\n  state: GameState,\n  building: BuildingInstance,\n  mapIndex: number,\n): GameState {\n  return updateBuilding(state, mapIndex, building.uid, {\n    isProducing: true,\n    progress: 0,\n    lastCollectTime: Date.now(),\n  });\n}\n\n// Update auto-production buildings (called every tick)\nexport function tickAutoProduction(\n  state: GameState,\n  mapIndex: number,\n  now: number,\n  buildingDefs: Map<string, BuildingDef>,\n): GameState {\n  const map = state.maps[mapIndex];\n  if (!map) return state;\n\n  for (const building of map.buildings) {\n    const def = buildingDefs.get(building.buildingId);\n    if (!def || def.production.mode !== 'auto') continue;\n\n    if (!building.isProducing) {\n      // Start production\n      state = updateBuilding(state, mapIndex, building.uid, {\n        isProducing: true,\n        lastCollectTime: now,\n        progress: 0,\n      });\n      continue;\n    }\n\n    const elapsed = now - building.lastCollectTime;\n    const interval = def.production.interval;\n    const progress = Math.min(1, elapsed / interval);\n\n    if (progress >= 1) {\n      // Production complete — collect and restart\n      const delta: Partial<Resources> = {};\n      (delta as Record<string, number>)[def.production.resource] = def.production.amount;\n      state = addResources(state, delta);\n\n      state = updateBuilding(state, mapIndex, building.uid, {\n        lastCollectTime: now,\n        progress: 0,\n      });\n    } else {\n      state = updateBuilding(state, mapIndex, building.uid, { progress });\n    }\n  }\n\n  return state;\n}\n\n// Tick manual buildings (e.g. field growth)\nexport function tickManualProduction(\n  state: GameState,\n  mapIndex: number,\n  now: number,\n  buildingDefs: Map<string, BuildingDef>,\n): GameState {\n  const map = state.maps[mapIndex];\n  if (!map) return state;\n\n  for (const building of map.buildings) {\n    const def = buildingDefs.get(building.buildingId);\n    if (!def || def.production.mode !== 'manual') continue;\n    if (!building.isProducing) continue;\n\n    const elapsed = now - building.lastCollectTime;\n    const interval = def.production.interval;\n    const progress = Math.min(1, elapsed / interval);\n\n    state = updateBuilding(state, mapIndex, building.uid, { progress });\n  }\n\n  return state;\n}\n\n// Format resource amounts for display (e.g. 1200 → \"1.2K\")\nexport function formatAmount(amount: number): string {\n  if (amount >= 1_000_000) return (amount / 1_000_000).toFixed(1) + 'M';\n  if (amount >= 10_000) return (amount / 1_000).toFixed(1) + 'K';\n  if (amount >= 1_000) return (amount / 1_000).toFixed(1) + 'K';\n  return Math.floor(amount).toString();\n}\n\n// Check if player can afford a cost\nexport function canAfford(resources: Resources, cost: Record<string, number>): boolean {\n  return Object.entries(cost).every(\n    ([res, amount]) => (resources[res as keyof Resources] ?? 0) >= amount,\n  );\n}\n\n// Deduct cost from resources\nexport function deductCost(state: GameState, cost: Record<string, number>): GameState {\n  const delta: Partial<Resources> = {};\n  for (const [res, amount] of Object.entries(cost)) {\n    (delta as Record<string, number>)[res] = -amount;\n  }\n  return addResources(state, delta);\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
