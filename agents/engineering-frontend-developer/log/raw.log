{"type":"assistant","message":{"id":"msg_20260523124837f09723b2d48c458c","type":"message","role":"assistant","model":"glm-5.1","content":[{"type":"tool_use","id":"call_86ce500039a04f7bb2366d23","name":"Write","input":{"file_path":"D:\\game-projects\\steam-horror-sim\\src\\game\\HorrorEventManager.ts","content":"// HorrorEventManager.ts — Event trigger engine with atmosphere escalation (M4)\n\nimport { GamePhase, isNightTime } from './GameState';\n\n// --- Event Definitions ---\n\nexport enum HorrorLevel {\n  ENVIRONMENT = 1,   // Level 1: 微恐 (Day 1-5)\n  ENTITY = 2,        // Level 2: 中恐 (Day 6-15)\n  THREAT = 3,        // Level 3: 高恐 (Day 16-25)\n  EXISTENTIAL = 4,   // Level 4: 极高恐 (Day 26-30)\n}\n\nexport enum HorrorEventType {\n  // Level 1: Environment\n  SHELF_SHIFT = 'shelf_shift',           // 商品位移\n  REGISTER_ANOMALY = 'register_anomaly', // 收银机异常\n  LIGHT_FLICKER = 'light_flicker',       // 灯光闪烁\n  TEMP_DROP = 'temp_drop',               // 温度骤降\n  FRIDGE_NOISE = 'fridge_noise',         // 冰箱异响\n  // Level 2: Entity\n  GHOST_CUSTOMER = 'ghost_customer',     // 透明顾客\n  DUPLICATE_CUSTOMER = 'duplicate_customer', // 重复脸顾客\n  SHADOW_MISALIGN = 'shadow_misalign',   // 影子错位\n  NEW_PRODUCT = 'new_product',           // 诡异新商品\n  // Level 3: Threat\n  DOOR_AUTO_OPEN = 'door_auto_open',     // 门自动开\n  BLOOD_ON_SHELF = 'blood_on_shelf',     // 货架流血\n  NONPAYING_CUSTOMER = 'nonpaying_customer', // 不付款顾客\n  WHISPER = 'whisper',                   // 低语声\n  // Level 4: Existential\n  STORE_MUTATE = 'store_mutate',         // 店铺异变\n  TIME_GLITCH = 'time_glitch',           // 时间异常\n}\n\nexport enum HorrorEventState {\n  INACTIVE = 'inactive',\n  BUILDUP = 'buildup',       // 预兆阶段 (1-3秒)\n  ACTIVE = 'active',         // 活跃阶段\n  RESOLVING = 'resolving',   // 消退阶段\n  COMPLETE = 'complete',\n}\n\nexport interface HorrorEventInstance {\n  id: string;\n  type: HorrorEventType;\n  level: HorrorLevel;\n  state: HorrorEventState;\n  timer: number;          // ms elapsed in current state\n  duration: number;       // total active duration ms\n  buildupDuration: number;\n  resolveDuration: number;\n  data: Record<string, unknown>;\n  sanityCost: number;\n}\n\ninterface HorrorEventDef {\n  type: HorrorEventType;\n  level: HorrorLevel;\n  baseProbability: number;   // per check (0-1)\n  minDay: number;\n  maxDay: number;\n  phaseRequired: GamePhase[];\n  minActiveDuration: number; // ms\n  maxActiveDuration: number;\n  buildupDuration: number;\n  resolveDuration: number;\n  sanityCost: number;\n  cooldownSec: number;       // min seconds between same event type\n  description: string;\n}\n\nconst EVENT_DEFS: HorrorEventDef[] = [\n  // Level 1: Environment\n  {\n    type: HorrorEventType.SHELF_SHIFT,\n    level: HorrorLevel.ENVIRONMENT,\n    baseProbability: 0.15,\n    minDay: 1, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 3000, maxActiveDuration: 6000,\n    buildupDuration: 1500, resolveDuration: 1000,\n    sanityCost: 3, cooldownSec: 60,\n    description: '某个货架上的商品在你不注意时换了位置',\n  },\n  {\n    type: HorrorEventType.REGISTER_ANOMALY,\n    level: HorrorLevel.ENVIRONMENT,\n    baseProbability: 0.10,\n    minDay: 1, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 4000, maxActiveDuration: 8000,\n    buildupDuration: 800, resolveDuration: 1500,\n    sanityCost: 5, cooldownSec: 90,\n    description: '收银机自动打开/关上，或显示异常金额',\n  },\n  {\n    type: HorrorEventType.LIGHT_FLICKER,\n    level: HorrorLevel.ENVIRONMENT,\n    baseProbability: 0.20,\n    minDay: 1, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT_TRANSITION, GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 2000, maxActiveDuration: 5000,\n    buildupDuration: 500, resolveDuration: 800,\n    sanityCost: 4, cooldownSec: 45,\n    description: '某盏灯间歇性闪烁，频率逐渐加快',\n  },\n  {\n    type: HorrorEventType.TEMP_DROP,\n    level: HorrorLevel.ENVIRONMENT,\n    baseProbability: 0.12,\n    minDay: 1, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 5000, maxActiveDuration: 10000,\n    buildupDuration: 2000, resolveDuration: 1500,\n    sanityCost: 4, cooldownSec: 120,\n    description: '画面边缘出现霜冻效果，呼吸可见',\n  },\n  {\n    type: HorrorEventType.FRIDGE_NOISE,\n    level: HorrorLevel.ENVIRONMENT,\n    baseProbability: 0.15,\n    minDay: 1, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 2000, maxActiveDuration: 4000,\n    buildupDuration: 300, resolveDuration: 500,\n    sanityCost: 3, cooldownSec: 60,\n    description: '冰箱突然发出很大的嗡鸣，然后瞬间安静',\n  },\n  // Level 2: Entity\n  {\n    type: HorrorEventType.GHOST_CUSTOMER,\n    level: HorrorLevel.ENTITY,\n    baseProbability: 0.12,\n    minDay: 6, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 8000, maxActiveDuration: 15000,\n    buildupDuration: 3000, resolveDuration: 2000,\n    sanityCost: 10, cooldownSec: 180,\n    description: '一位半透明的顾客走进店里，若隐若现',\n  },\n  {\n    type: HorrorEventType.DUPLICATE_CUSTOMER,\n    level: HorrorLevel.ENTITY,\n    baseProbability: 0.08,\n    minDay: 8, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 10000, maxActiveDuration: 18000,\n    buildupDuration: 2000, resolveDuration: 3000,\n    sanityCost: 12, cooldownSec: 240,\n    description: '两个完全一样的顾客同时出现在店里',\n  },\n  {\n    type: HorrorEventType.SHADOW_MISALIGN,\n    level: HorrorLevel.ENTITY,\n    baseProbability: 0.10,\n    minDay: 6, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 6000, maxActiveDuration: 12000,\n    buildupDuration: 1500, resolveDuration: 1000,\n    sanityCost: 8, cooldownSec: 150,\n    description: '你的影子角度不对，或者有自己的动作',\n  },\n  {\n    type: HorrorEventType.NEW_PRODUCT,\n    level: HorrorLevel.ENTITY,\n    baseProbability: 0.08,\n    minDay: 7, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 6000, maxActiveDuration: 10000,\n    buildupDuration: 0, resolveDuration: 500,\n    sanityCost: 7, cooldownSec: 200,\n    description: '货架上出现了你没进过货的商品，包装文字无法辨认',\n  },\n  // Level 3: Threat\n  {\n    type: HorrorEventType.DOOR_AUTO_OPEN,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.10,\n    minDay: 16, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 5000, maxActiveDuration: 8000,\n    buildupDuration: 1000, resolveDuration: 2000,\n    sanityCost: 15, cooldownSec: 180,\n    description: '前门或后门自己打开，外面是完全的黑暗',\n  },\n  {\n    type: HorrorEventType.BLOOD_ON_SHELF,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.08,\n    minDay: 18, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 8000, maxActiveDuration: 12000,\n    buildupDuration: 2000, resolveDuration: 3000,\n    sanityCost: 18, cooldownSec: 240,\n    description: '某个货架上出现暗红色液体缓缓渗出',\n  },\n  {\n    type: HorrorEventType.NONPAYING_CUSTOMER,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.10,\n    minDay: 16, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 10000, maxActiveDuration: 20000,\n    buildupDuration: 3000, resolveDuration: 1000,\n    sanityCost: 14, cooldownSec: 200,\n    description: '一个顾客拿了东西不走，也不付钱，只是盯着你看',\n  },\n  {\n    type: HorrorEventType.WHISPER,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.12,\n    minDay: 16, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 4000, maxActiveDuration: 8000,\n    buildupDuration: 2000, resolveDuration: 500,\n    sanityCost: 12, cooldownSec: 120,\n    description: '耳边传来低语声，听不清在说什么',\n  },\n  // Level 4: Existential\n  {\n    type: HorrorEventType.STORE_MUTATE,\n    level: HorrorLevel.EXISTENTIAL,\n    baseProbability: 0.06,\n    minDay: 26, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 10000, maxActiveDuration: 20000,\n    buildupDuration: 3000, resolveDuration: 5000,\n    sanityCost: 25, cooldownSec: 300,\n    description: '店铺结构开始改变，墙壁在移动',\n  },\n  {\n    type: HorrorEventType.TIME_GLITCH,\n    level: HorrorLevel.EXISTENTIAL,\n    baseProbability: 0.05,\n    minDay: 26, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 5000, maxActiveDuration: 8000,\n    buildupDuration: 1000, resolveDuration: 2000,\n    sanityCost: 20, cooldownSec: 300,\n    description: '时钟突然倒转，时间出现异常',\n  },\n];\n\n// --- Visual Effect State ---\n\nexport interface HorrorVisualState {\n  // Global\n  frostIntensity: number;      // 0-1, frost on edges\n  darknessBoost: number;       // 0-0.5, extra darkness\n  screenShake: number;         // shake intensity\n  chromaticAberration: number; // 0-1\n  vignetteIntensity: number;   // 0-1\n\n  // Specific\n  flickeringLightIndex: number; // which light is flickering (-1 = none)\n  flickerIntensity: number;     // 0-1\n\n  bloodPositions: Array<{ x: number; y: number; size: number; alpha: number }>;\n  ghostEntity: {\n    active: boolean;\n    x: number;\n    y: number;\n    opacity: number;\n    type: 'ghost_customer' | 'duplicate' | 'nonpaying' | 'shadow';\n  } | null;\n  doorState: {\n    frontOpen: boolean;\n    backOpen: boolean;\n  };\n  timeGlitchActive: boolean;\n  storeMutateOffset: { x: number; y: number };\n  whisperActive: boolean;\n\n  // Atmosphere\n  ambientFear: number; // 0-1 overall fear level\n  recentHighFearCount: number; // for fear regulation\n}\n\nexport function createDefaultVisualState(): HorrorVisualState {\n  return {\n    frostIntensity: 0,\n    darknessBoost: 0,\n    screenShake: 0,\n    chromaticAberration: 0,\n    vignetteIntensity: 0.3,\n    flickeringLightIndex: -1,\n    flickerIntensity: 0,\n    bloodPositions: [],\n    ghostEntity: null,\n    doorState: { frontOpen: false, backOpen: false },\n    timeGlitchActive: false,\n    storeMutateOffset: { x: 0, y: 0 },\n    whisperActive: false,\n    ambientFear: 0,\n    recentHighFearCount: 0,\n  };\n}\n\n// --- Manager ---\n\nexport class HorrorEventManager {\n  private activeEvents: HorrorEventInstance[] = [];\n  private cooldowns: Map<HorrorEventType, number> = new Map();\n  private visual: HorrorVisualState = createDefaultVisualState();\n  private checkInterval = 5000; // check every 5 seconds\n  private checkTimer = 0;\n  private dayAccumulatedSanityCost = 0;\n  private maxSanityCostPerNight = 40;\n  private eventCounter = 0;\n  private maxConcurrentEvents = 3;\n\n  // Callbacks\n  onEventTrigger?: (event: HorrorEventInstance) => void;\n  onSanityChange?: (delta: number) => void;\n  onNotification?: (text: string) => void;\n\n  get visuals(): HorrorVisualState { return this.visual; }\n  get activeEventCount(): number { return this.activeEvents.length; }\n\n  update(dt: number, day: number, phase: GamePhase, timeOfDay: number, sanity: number): HorrorVisualState {\n    const dtSec = dt / 1000;\n\n    // Update cooldowns\n    for (const [type, cd] of this.cooldowns) {\n      if (cd > 0) this.cooldowns.set(type, Math.max(0, cd - dtSec));\n    }\n\n    // Check for new events only at night\n    if (isNightTime(phase) && this.activeEvents.length < this.maxConcurrentEvents) {\n      this.checkTimer += dt;\n      if (this.checkTimer >= this.checkInterval) {\n        this.checkTimer = 0;\n        this.tryTriggerEvents(day, phase, sanity);\n      }\n    }\n\n    // Update active events\n    this.updateActiveEvents(dt);\n\n    // Decay visual effects toward baseline\n    this.decayVisuals(dtSec);\n\n    // Calculate ambient fear\n    this.updateAmbientFear(day, phase, timeOfDay);\n\n    return this.visual;\n  }\n\n  private tryTriggerEvents(day: number, phase: GamePhase, sanity: number): void {\n    for (const def of EVENT_DEFS) {\n      if (this.activeEvents.length >= this.maxConcurrentEvents) break;\n      if (this.activeEvents.some(e => e.type === def.type)) continue;\n      if (day < def.minDay || day > def.maxDay) continue;\n      if (!def.phaseRequired.includes(phase)) continue;\n\n      const cd = this.cooldowns.get(def.type) ?? 0;\n      if (cd > 0) continue;\n\n      // Fear regulation: reduce probability if recent high fear\n      let probabilityMod = 1;\n      if (this.visual.recentHighFearCount >= 2 && def.level >= HorrorLevel.THREAT) {\n        probabilityMod = 0.2; // big reduction after consecutive high fear\n      }\n\n      // Sanity affects: lower sanity = slightly less events (overwhelmed player)\n      if (sanity < 30) probabilityMod *= 0.5;\n\n      // Night depth increases probability\n      const nightDepth = phase === GamePhase.DANGER ? 1.5 : 1;\n      probabilityMod *= nightDepth;\n\n      // Day progression increases probability\n      const dayProgress = Math.min(day / 15, 2);\n      probabilityMod *= dayProgress;\n\n      const roll = Math.random();\n      if (roll < def.baseProbability * probabilityMod) {\n        this.triggerEvent(def);\n      }\n    }\n  }\n\n  private triggerEvent(def: HorrorEventDef): void {\n    const id = `horror_${++this.eventCounter}_${Date.now()}`;\n    const event: HorrorEventInstance = {\n      id,\n      type: def.type,\n      level: def.level,\n      state: HorrorEventState.BUILDUP,\n      timer: 0,\n      duration: def.minActiveDuration + Math.random() * (def.maxActiveDuration - def.minActiveDuration),\n      buildupDuration: def.buildupDuration,\n      resolveDuration: def.resolveDuration,\n      data: {},\n      sanityCost: def.sanityCost,\n    };\n\n    // Randomize specific data\n    event.data = this.generateEventData(def);\n\n    this.activeEvents.push(event);\n    this.cooldowns.set(def.type, def.cooldownSec);\n\n    if (def.level >= HorrorLevel.THREAT) {\n      this.visual.recentHighFearCount++;\n    }\n\n    this.onEventTrigger?.(event);\n    this.onNotification?.(`⚠ ${def.description}`);\n  }\n\n  private generateEventData(def: HorrorEventDef): Record<string, unknown> {\n    switch (def.type) {\n      case HorrorEventType.SHELF_SHIFT:\n        return { shelfIndex: Math.floor(Math.random() * 5) };\n      case HorrorEventType.LIGHT_FLICKER:\n        return { lightIndex: Math.floor(Math.random() * 8) };\n      case HorrorEventType.REGISTER_ANOMALY:\n        return { registerIndex: Math.floor(Math.random() * 2), anomalyAmount: Math.floor(Math.random() * 9999) };\n      case HorrorEventType.BLOOD_ON_SHELF: {\n        const positions = [];\n        const count = 2 + Math.floor(Math.random() * 4);\n        for (let i = 0; i < count; i++) {\n          positions.push({\n            x: 100 + Math.random() * 600,\n            y: 100 + Math.random() * 400,\n            size: 8 + Math.random() * 20,\n            alpha: 0.3 + Math.random() * 0.5,\n          });\n        }\n        return { positions };\n      }\n      case HorrorEventType.GHOST_CUSTOMER:\n        return { startX: Math.random() * 400 + 100, startY: 50, opacity: 0 };\n      case HorrorEventType.DUPLICATE_CUSTOMER:\n        return { x1: 200 + Math.random() * 200, x2: 400 + Math.random() * 200, y: 200 + Math.random() * 100 };\n      case HorrorEventType.NONPAYING_CUSTOMER:\n        return { x: 300 + Math.random() * 200, y: 150 + Math.random() * 100 };\n      case HorrorEventType.DOOR_AUTO_OPEN:\n        return { door: Math.random() < 0.5 ? 'front' : 'back' };\n      default:\n        return {};\n    }\n  }\n\n  private updateActiveEvents(dt: number): void {\n    const completed: string[] = [];\n\n    for (const event of this.activeEvents) {\n      event.timer += dt;\n\n      switch (event.state) {\n        case HorrorEventState.BUILDUP:\n          this.applyBuildupEffect(event, event.timer / event.buildupDuration);\n          if (event.timer >= event.buildupDuration) {\n            event.state = HorrorEventState.ACTIVE;\n            event.timer = 0;\n            this.applyActiveEffect(event);\n            this.onSanityChange?.(-event.sanityCost);\n            this.dayAccumulatedSanityCost += event.sanityCost;\n          }\n          break;\n\n        case HorrorEventState.ACTIVE:\n          this.sustainActiveEffect(event, event.timer / event.duration);\n          if (event.timer >= event.duration) {\n            event.state = HorrorEventState.RESOLVING;\n            event.timer = 0;\n            this.beginResolve(event);\n          }\n          break;\n\n        case HorrorEventState.RESOLVING:\n          this.applyResolveEffect(event, event.timer / event.resolveDuration);\n          if (event.timer >= event.resolveDuration) {\n            event.state = HorrorEventState.COMPLETE;\n            completed.push(event.id);\n            this.clearEventEffects(event);\n          }\n          break;\n      }\n    }\n\n    for (const id of completed) {\n      this.activeEvents = this.activeEvents.filter(e => e.id !== id);\n    }\n  }\n\n  // --- Buildup Effects (预兆) ---\n\n  private applyBuildupEffect(event: HorrorEventInstance, progress: number): void {\n    const p = Math.min(1, progress);\n    switch (event.type) {\n      case HorrorEventType.LIGHT_FLICKER:\n        this.visual.flickeringLightIndex = (event.data.lightIndex as number) ?? 0;\n        this.visual.flickerIntensity = p * 0.3;\n        break;\n      case HorrorEventType.TEMP_DROP:\n        this.visual.frostIntensity = p * 0.2;\n        break;\n      case HorrorEventType.BLOOD_ON_SHELF:\n        this.visual.darknessBoost = p * 0.1;\n        break;\n      case HorrorEventType.WHISPER:\n        this.visual.whisperActive = true;\n        break;\n      case HorrorEventType.GHOST_CUSTOMER:\n      case HorrorEventType.DUPLICATE_CUSTOMER:\n      case HorrorEventType.NONPAYING_CUSTOMER:\n        this.visual.vignetteIntensity = Math.min(1, 0.3 + p * 0.3);\n        break;\n      case HorrorEventType.DOOR_AUTO_OPEN:\n        this.visual.screenShake = p * 0.3;\n        break;\n      case HorrorEventType.STORE_MUTATE:\n        this.visual.chromaticAberration = p * 0.3;\n        break;\n      default:\n        this.visual.darknessBoost = p * 0.05;\n        break;\n    }\n  }\n\n  // --- Active Effects ---\n\n  private applyActiveEffect(event: HorrorEventInstance): void {\n    switch (event.type) {\n      case HorrorEventType.LIGHT_FLICKER:\n        this.visual.flickerIntensity = 0.8;\n        break;\n      case HorrorEventType.TEMP_DROP:\n        this.visual.frostIntensity = 0.6;\n        this.visual.vignetteIntensity = 0.7;\n        break;\n      case HorrorEventType.FRIDGE_NOISE:\n        this.visual.screenShake = 0.5;\n        break;\n      case HorrorEventType.BLOOD_ON_SHELF:\n        this.visual.bloodPositions = (event.data.positions as Array<{ x: number; y: number; size: number; alpha: number }>) ?? [];\n        break;\n      case HorrorEventType.GHOST_CUSTOMER:\n        this.visual.ghostEntity = {\n          active: true,\n          x: (event.data.startX as number) ?? 300,\n          y: (event.data.startY as number) ?? 50,\n          opacity: 0.4,\n          type: 'ghost_customer',\n        };\n        break;\n      case HorrorEventType.DUPLICATE_CUSTOMER:\n        this.visual.ghostEntity = {\n          active: true,\n          x: (event.data.x1 as number) ?? 200,\n          y: (event.data.y as number) ?? 200,\n          opacity: 0.8,\n          type: 'duplicate',\n        };\n        break;\n      case HorrorEventType.NONPAYING_CUSTOMER:\n        this.visual.ghostEntity = {\n          active: true,\n          x: (event.data.x as number) ?? 300,\n          y: (event.data.y as number) ?? 150,\n          opacity: 0.9,\n          type: 'nonpaying',\n        };\n        break;\n      case HorrorEventType.DOOR_AUTO_OPEN:\n        if ((event.data.door as string) === 'front') {\n          this.visual.doorState.frontOpen = true;\n        } else {\n          this.visual.doorState.backOpen = true;\n        }\n        this.visual.darknessBoost = 0.3;\n        this.visual.screenShake = 0.8;\n        break;\n      case HorrorEventType.WHISPER:\n        this.visual.whisperActive = true;\n        this.visual.vignetteIntensity = 0.8;\n        break;\n      case HorrorEventType.STORE_MUTATE:\n        this.visual.storeMutateOffset = { x: (Math.random() - 0.5) * 10, y: (Math.random() - 0.5) * 10 };\n        this.visual.chromaticAberration = 0.8;\n        this.visual.screenShake = 0.4;\n        break;\n      case HorrorEventType.TIME_GLITCH:\n        this.visual.timeGlitchActive = true;\n        this.visual.chromaticAberration = 0.6;\n        break;\n      default:\n        this.visual.darknessBoost = 0.15;\n        break;\n    }\n  }\n\n  private sustainActiveEffect(event: HorrorEventInstance, progress: number): void {\n    // Pulsing effects during sustain\n    const pulse = Math.sin(progress * Math.PI * 4) * 0.5 + 0.5;\n\n    switch (event.type) {\n      case HorrorEventType.LIGHT_FLICKER:\n        this.visual.flickerIntensity = 0.4 + pulse * 0.5;\n        break;\n      case HorrorEventType.FRIDGE_NOISE:\n        this.visual.screenShake = 0.2 + pulse * 0.3;\n        break;\n      case HorrorEventType.GHOST_CUSTOMER:\n        if (this.visual.ghostEntity) {\n          this.visual.ghostEntity.opacity = 0.2 + pulse * 0.4;\n          this.visual.ghostEntity.y += 0.1;\n        }\n        break;\n      case HorrorEventType.STORE_MUTATE: {\n        const t = performance.now() * 0.001;\n        this.visual.storeMutateOffset = {\n          x: Math.sin(t * 0.5) * 8,\n          y: Math.cos(t * 0.7) * 5,\n        };\n        break;\n      }\n      case HorrorEventType.TIME_GLITCH:\n        this.visual.chromaticAberration = 0.3 + pulse * 0.5;\n        break;\n      default:\n        break;\n    }\n  }\n\n  // --- Resolve Effects ---\n\n  private beginResolve(event: HorrorEventInstance): void {\n    switch (event.type) {\n      case HorrorEventType.FRIDGE_NOISE:\n        // Sudden silence is scarier\n        this.visual.screenShake = 0;\n        break;\n      default:\n        break;\n    }\n  }\n\n  private applyResolveEffect(event: HorrorEventInstance, progress: number): void {\n    const p = Math.min(1, progress);\n    switch (event.type) {\n      case HorrorEventType.TEMP_DROP:\n        this.visual.frostIntensity *= (1 - p);\n        break;\n      case HorrorEventType.LIGHT_FLICKER:\n        this.visual.flickerIntensity *= (1 - p);\n        if (p >= 1) this.visual.flickeringLightIndex = -1;\n        break;\n      case HorrorEventType.BLOOD_ON_SHELF:\n        this.visual.bloodPositions = this.visual.bloodPositions.map(b => ({\n          ...b, alpha: b.alpha * (1 - p),\n        }));\n        break;\n      case HorrorEventType.GHOST_CUSTOMER:\n      case HorrorEventType.DUPLICATE_CUSTOMER:\n      case HorrorEventType.NONPAYING_CUSTOMER:\n        if (this.visual.ghostEntity) {\n          this.visual.ghostEntity.opacity *= (1 - p);\n        }\n        break;\n      case HorrorEventType.DOOR_AUTO_OPEN:\n        this.visual.doorState.frontOpen = false;\n        this.visual.doorState.backOpen = false;\n        this.visual.darknessBoost *= (1 - p);\n        break;\n      case HorrorEventType.STORE_MUTATE:\n        this.visual.storeMutateOffset.x *= (1 - p);\n        this.visual.storeMutateOffset.y *= (1 - p);\n        this.visual.chromaticAberration *= (1 - p);\n        break;\n      case HorrorEventType.TIME_GLITCH:\n        if (p >= 0.8) this.visual.timeGlitchActive = false;\n        this.visual.chromaticAberration *= (1 - p);\n        break;\n      default:\n        break;\n    }\n  }\n\n  private clearEventEffects(event: HorrorEventInstance): void {\n    switch (event.type) {\n      case HorrorEventType.GHOST_CUSTOMER:\n      case HorrorEventType.DUPLICATE_CUSTOMER:\n      case HorrorEventType.NONPAYING_CUSTOMER:\n        this.visual.ghostEntity = null;\n        break;\n      case HorrorEventType.BLOOD_ON_SHELF:\n        this.visual.bloodPositions = [];\n        break;\n      case HorrorEventType.WHISPER:\n        this.visual.whisperActive = false;\n        break;\n      case HorrorEventType.TIME_GLITCH:\n        this.visual.timeGlitchActive = false;\n        break;\n      default:\n        break;\n    }\n  }\n\n  private decayVisuals(dtSec: number): void {\n    const decay = dtSec * 0.5;\n    this.visual.screenShake = Math.max(0, this.visual.screenShake - decay);\n    this.visual.darknessBoost = Math.max(0, this.visual.darknessBoost - decay * 0.1);\n    if (this.visual.flickeringLightIndex === -1) {\n      this.visual.flickerIntensity = Math.max(0, this.visual.flickerIntensity - decay * 0.2);\n    }\n  }\n\n  private updateAmbientFear(day: number, phase: GamePhase, timeOfDay: number): void {\n    let target = 0;\n\n    if (isNightTime(phase)) {\n      target = 0.3;\n      if (phase === GamePhase.NIGHT) target = 0.5;\n      if (phase === GamePhase.DANGER) target = 0.8;\n\n      // Day progression\n      target *= Math.min(1 + (day - 1) * 0.05, 2);\n\n      // Active events boost fear\n      target += this.activeEvents.length * 0.1;\n    }\n\n    this.visual.ambientFear += (target - this.visual.ambientFear) * 0.02;\n  }\n\n  // --- Public API ---\n\n  /** Reset daily state when new day begins */\n  resetDaily(): void {\n    this.dayAccumulatedSanityCost = 0;\n    this.visual.recentHighFearCount = 0;\n    this.activeEvents = [];\n    this.visual = createDefaultVisualState();\n  }\n\n  /** Get the maximum event level available for current day */\n  getMaxLevel(day: number): HorrorLevel {\n    if (day >= 26) return HorrorLevel.EXISTENTIAL;\n    if (day >= 16) return HorrorLevel.THREAT;\n    if (day >= 6) return HorrorLevel.ENTITY;\n    return HorrorLevel.ENVIRONMENT;\n  }\n\n  /** Get active events for display */\n  getActiveEvents(): ReadonlyArray<HorrorEventInstance> {\n    return this.activeEvents;\n  }\n\n  /** Get save data */\n  getSaveData(): Record<string, unknown> {\n    return {\n      eventCounter: this.eventCounter,\n      dayAccumulatedSanityCost: this.dayAccumulatedSanityCost,\n    };\n  }\n\n  /** Load save data */\n  loadSaveData(data: Record<string, unknown>): void {\n    this.eventCounter = (data.eventCounter as number) ?? 0;\n    this.dayAccumulatedSanityCost = (data.dayAccumulatedSanityCost as number) ?? 0;\n  }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"392f64db-fdde-44d3-ac09-12e89ef6a334","uuid":"a2ad8797-516a-493e-a247-59e22584d8f6"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_86ce500039a04f7bb2366d23","type":"tool_result","content":"File created successfully at: D:\\game-projects\\steam-horror-sim\\src\\game\\HorrorEventManager.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"392f64db-fdde-44d3-ac09-12e89ef6a334","uuid":"3c6b373b-c648-4461-a3f9-de51f8e5dcd3","timestamp":"2026-05-23T04:50:10.947Z","tool_use_result":{"type":"create","filePath":"D:\\game-projects\\steam-horror-sim\\src\\game\\HorrorEventManager.ts","content":"// HorrorEventManager.ts — Event trigger engine with atmosphere escalation (M4)\n\nimport { GamePhase, isNightTime } from './GameState';\n\n// --- Event Definitions ---\n\nexport enum HorrorLevel {\n  ENVIRONMENT = 1,   // Level 1: 微恐 (Day 1-5)\n  ENTITY = 2,        // Level 2: 中恐 (Day 6-15)\n  THREAT = 3,        // Level 3: 高恐 (Day 16-25)\n  EXISTENTIAL = 4,   // Level 4: 极高恐 (Day 26-30)\n}\n\nexport enum HorrorEventType {\n  // Level 1: Environment\n  SHELF_SHIFT = 'shelf_shift',           // 商品位移\n  REGISTER_ANOMALY = 'register_anomaly', // 收银机异常\n  LIGHT_FLICKER = 'light_flicker',       // 灯光闪烁\n  TEMP_DROP = 'temp_drop',               // 温度骤降\n  FRIDGE_NOISE = 'fridge_noise',         // 冰箱异响\n  // Level 2: Entity\n  GHOST_CUSTOMER = 'ghost_customer',     // 透明顾客\n  DUPLICATE_CUSTOMER = 'duplicate_customer', // 重复脸顾客\n  SHADOW_MISALIGN = 'shadow_misalign',   // 影子错位\n  NEW_PRODUCT = 'new_product',           // 诡异新商品\n  // Level 3: Threat\n  DOOR_AUTO_OPEN = 'door_auto_open',     // 门自动开\n  BLOOD_ON_SHELF = 'blood_on_shelf',     // 货架流血\n  NONPAYING_CUSTOMER = 'nonpaying_customer', // 不付款顾客\n  WHISPER = 'whisper',                   // 低语声\n  // Level 4: Existential\n  STORE_MUTATE = 'store_mutate',         // 店铺异变\n  TIME_GLITCH = 'time_glitch',           // 时间异常\n}\n\nexport enum HorrorEventState {\n  INACTIVE = 'inactive',\n  BUILDUP = 'buildup',       // 预兆阶段 (1-3秒)\n  ACTIVE = 'active',         // 活跃阶段\n  RESOLVING = 'resolving',   // 消退阶段\n  COMPLETE = 'complete',\n}\n\nexport interface HorrorEventInstance {\n  id: string;\n  type: HorrorEventType;\n  level: HorrorLevel;\n  state: HorrorEventState;\n  timer: number;          // ms elapsed in current state\n  duration: number;       // total active duration ms\n  buildupDuration: number;\n  resolveDuration: number;\n  data: Record<string, unknown>;\n  sanityCost: number;\n}\n\ninterface HorrorEventDef {\n  type: HorrorEventType;\n  level: HorrorLevel;\n  baseProbability: number;   // per check (0-1)\n  minDay: number;\n  maxDay: number;\n  phaseRequired: GamePhase[];\n  minActiveDuration: number; // ms\n  maxActiveDuration: number;\n  buildupDuration: number;\n  resolveDuration: number;\n  sanityCost: number;\n  cooldownSec: number;       // min seconds between same event type\n  description: string;\n}\n\nconst EVENT_DEFS: HorrorEventDef[] = [\n  // Level 1: Environment\n  {\n    type: HorrorEventType.SHELF_SHIFT,\n    level: HorrorLevel.ENVIRONMENT,\n    baseProbability: 0.15,\n    minDay: 1, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 3000, maxActiveDuration: 6000,\n    buildupDuration: 1500, resolveDuration: 1000,\n    sanityCost: 3, cooldownSec: 60,\n    description: '某个货架上的商品在你不注意时换了位置',\n  },\n  {\n    type: HorrorEventType.REGISTER_ANOMALY,\n    level: HorrorLevel.ENVIRONMENT,\n    baseProbability: 0.10,\n    minDay: 1, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 4000, maxActiveDuration: 8000,\n    buildupDuration: 800, resolveDuration: 1500,\n    sanityCost: 5, cooldownSec: 90,\n    description: '收银机自动打开/关上，或显示异常金额',\n  },\n  {\n    type: HorrorEventType.LIGHT_FLICKER,\n    level: HorrorLevel.ENVIRONMENT,\n    baseProbability: 0.20,\n    minDay: 1, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT_TRANSITION, GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 2000, maxActiveDuration: 5000,\n    buildupDuration: 500, resolveDuration: 800,\n    sanityCost: 4, cooldownSec: 45,\n    description: '某盏灯间歇性闪烁，频率逐渐加快',\n  },\n  {\n    type: HorrorEventType.TEMP_DROP,\n    level: HorrorLevel.ENVIRONMENT,\n    baseProbability: 0.12,\n    minDay: 1, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 5000, maxActiveDuration: 10000,\n    buildupDuration: 2000, resolveDuration: 1500,\n    sanityCost: 4, cooldownSec: 120,\n    description: '画面边缘出现霜冻效果，呼吸可见',\n  },\n  {\n    type: HorrorEventType.FRIDGE_NOISE,\n    level: HorrorLevel.ENVIRONMENT,\n    baseProbability: 0.15,\n    minDay: 1, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 2000, maxActiveDuration: 4000,\n    buildupDuration: 300, resolveDuration: 500,\n    sanityCost: 3, cooldownSec: 60,\n    description: '冰箱突然发出很大的嗡鸣，然后瞬间安静',\n  },\n  // Level 2: Entity\n  {\n    type: HorrorEventType.GHOST_CUSTOMER,\n    level: HorrorLevel.ENTITY,\n    baseProbability: 0.12,\n    minDay: 6, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 8000, maxActiveDuration: 15000,\n    buildupDuration: 3000, resolveDuration: 2000,\n    sanityCost: 10, cooldownSec: 180,\n    description: '一位半透明的顾客走进店里，若隐若现',\n  },\n  {\n    type: HorrorEventType.DUPLICATE_CUSTOMER,\n    level: HorrorLevel.ENTITY,\n    baseProbability: 0.08,\n    minDay: 8, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 10000, maxActiveDuration: 18000,\n    buildupDuration: 2000, resolveDuration: 3000,\n    sanityCost: 12, cooldownSec: 240,\n    description: '两个完全一样的顾客同时出现在店里',\n  },\n  {\n    type: HorrorEventType.SHADOW_MISALIGN,\n    level: HorrorLevel.ENTITY,\n    baseProbability: 0.10,\n    minDay: 6, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 6000, maxActiveDuration: 12000,\n    buildupDuration: 1500, resolveDuration: 1000,\n    sanityCost: 8, cooldownSec: 150,\n    description: '你的影子角度不对，或者有自己的动作',\n  },\n  {\n    type: HorrorEventType.NEW_PRODUCT,\n    level: HorrorLevel.ENTITY,\n    baseProbability: 0.08,\n    minDay: 7, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 6000, maxActiveDuration: 10000,\n    buildupDuration: 0, resolveDuration: 500,\n    sanityCost: 7, cooldownSec: 200,\n    description: '货架上出现了你没进过货的商品，包装文字无法辨认',\n  },\n  // Level 3: Threat\n  {\n    type: HorrorEventType.DOOR_AUTO_OPEN,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.10,\n    minDay: 16, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 5000, maxActiveDuration: 8000,\n    buildupDuration: 1000, resolveDuration: 2000,\n    sanityCost: 15, cooldownSec: 180,\n    description: '前门或后门自己打开，外面是完全的黑暗',\n  },\n  {\n    type: HorrorEventType.BLOOD_ON_SHELF,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.08,\n    minDay: 18, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 8000, maxActiveDuration: 12000,\n    buildupDuration: 2000, resolveDuration: 3000,\n    sanityCost: 18, cooldownSec: 240,\n    description: '某个货架上出现暗红色液体缓缓渗出',\n  },\n  {\n    type: HorrorEventType.NONPAYING_CUSTOMER,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.10,\n    minDay: 16, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 10000, maxActiveDuration: 20000,\n    buildupDuration: 3000, resolveDuration: 1000,\n    sanityCost: 14, cooldownSec: 200,\n    description: '一个顾客拿了东西不走，也不付钱，只是盯着你看',\n  },\n  {\n    type: HorrorEventType.WHISPER,\n    level: HorrorLevel.THREAT,\n    baseProbability: 0.12,\n    minDay: 16, maxDay: 30,\n    phaseRequired: [GamePhase.NIGHT, GamePhase.DANGER],\n    minActiveDuration: 4000, maxActiveDuration: 8000,\n    buildupDuration: 2000, resolveDuration: 500,\n    sanityCost: 12, cooldownSec: 120,\n    description: '耳边传来低语声，听不清在说什么',\n  },\n  // Level 4: Existential\n  {\n    type: HorrorEventType.STORE_MUTATE,\n    level: HorrorLevel.EXISTENTIAL,\n    baseProbability: 0.06,\n    minDay: 26, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 10000, maxActiveDuration: 20000,\n    buildupDuration: 3000, resolveDuration: 5000,\n    sanityCost: 25, cooldownSec: 300,\n    description: '店铺结构开始改变，墙壁在移动',\n  },\n  {\n    type: HorrorEventType.TIME_GLITCH,\n    level: HorrorLevel.EXISTENTIAL,\n    baseProbability: 0.05,\n    minDay: 26, maxDay: 30,\n    phaseRequired: [GamePhase.DANGER],\n    minActiveDuration: 5000, maxActiveDuration: 8000,\n    buildupDuration: 1000, resolveDuration: 2000,\n    sanityCost: 20, cooldownSec: 300,\n    description: '时钟突然倒转，时间出现异常',\n  },\n];\n\n// --- Visual Effect State ---\n\nexport interface HorrorVisualState {\n  // Global\n  frostIntensity: number;      // 0-1, frost on edges\n  darknessBoost: number;       // 0-0.5, extra darkness\n  screenShake: number;         // shake intensity\n  chromaticAberration: number; // 0-1\n  vignetteIntensity: number;   // 0-1\n\n  // Specific\n  flickeringLightIndex: number; // which light is flickering (-1 = none)\n  flickerIntensity: number;     // 0-1\n\n  bloodPositions: Array<{ x: number; y: number; size: number; alpha: number }>;\n  ghostEntity: {\n    active: boolean;\n    x: number;\n    y: number;\n    opacity: number;\n    type: 'ghost_customer' | 'duplicate' | 'nonpaying' | 'shadow';\n  } | null;\n  doorState: {\n    frontOpen: boolean;\n    backOpen: boolean;\n  };\n  timeGlitchActive: boolean;\n  storeMutateOffset: { x: number; y: number };\n  whisperActive: boolean;\n\n  // Atmosphere\n  ambientFear: number; // 0-1 overall fear level\n  recentHighFearCount: number; // for fear regulation\n}\n\nexport function createDefaultVisualState(): HorrorVisualState {\n  return {\n    frostIntensity: 0,\n    darknessBoost: 0,\n    screenShake: 0,\n    chromaticAberration: 0,\n    vignetteIntensity: 0.3,\n    flickeringLightIndex: -1,\n    flickerIntensity: 0,\n    bloodPositions: [],\n    ghostEntity: null,\n    doorState: { frontOpen: false, backOpen: false },\n    timeGlitchActive: false,\n    storeMutateOffset: { x: 0, y: 0 },\n    whisperActive: false,\n    ambientFear: 0,\n    recentHighFearCount: 0,\n  };\n}\n\n// --- Manager ---\n\nexport class HorrorEventManager {\n  private activeEvents: HorrorEventInstance[] = [];\n  private cooldowns: Map<HorrorEventType, number> = new Map();\n  private visual: HorrorVisualState = createDefaultVisualState();\n  private checkInterval = 5000; // check every 5 seconds\n  private checkTimer = 0;\n  private dayAccumulatedSanityCost = 0;\n  private maxSanityCostPerNight = 40;\n  private eventCounter = 0;\n  private maxConcurrentEvents = 3;\n\n  // Callbacks\n  onEventTrigger?: (event: HorrorEventInstance) => void;\n  onSanityChange?: (delta: number) => void;\n  onNotification?: (text: string) => void;\n\n  get visuals(): HorrorVisualState { return this.visual; }\n  get activeEventCount(): number { return this.activeEvents.length; }\n\n  update(dt: number, day: number, phase: GamePhase, timeOfDay: number, sanity: number): HorrorVisualState {\n    const dtSec = dt / 1000;\n\n    // Update cooldowns\n    for (const [type, cd] of this.cooldowns) {\n      if (cd > 0) this.cooldowns.set(type, Math.max(0, cd - dtSec));\n    }\n\n    // Check for new events only at night\n    if (isNightTime(phase) && this.activeEvents.length < this.maxConcurrentEvents) {\n      this.checkTimer += dt;\n      if (this.checkTimer >= this.checkInterval) {\n        this.checkTimer = 0;\n        this.tryTriggerEvents(day, phase, sanity);\n      }\n    }\n\n    // Update active events\n    this.updateActiveEvents(dt);\n\n    // Decay visual effects toward baseline\n    this.decayVisuals(dtSec);\n\n    // Calculate ambient fear\n    this.updateAmbientFear(day, phase, timeOfDay);\n\n    return this.visual;\n  }\n\n  private tryTriggerEvents(day: number, phase: GamePhase, sanity: number): void {\n    for (const def of EVENT_DEFS) {\n      if (this.activeEvents.length >= this.maxConcurrentEvents) break;\n      if (this.activeEvents.some(e => e.type === def.type)) continue;\n      if (day < def.minDay || day > def.maxDay) continue;\n      if (!def.phaseRequired.includes(phase)) continue;\n\n      const cd = this.cooldowns.get(def.type) ?? 0;\n      if (cd > 0) continue;\n\n      // Fear regulation: reduce probability if recent high fear\n      let probabilityMod = 1;\n      if (this.visual.recentHighFearCount >= 2 && def.level >= HorrorLevel.THREAT) {\n        probabilityMod = 0.2; // big reduction after consecutive high fear\n      }\n\n      // Sanity affects: lower sanity = slightly less events (overwhelmed player)\n      if (sanity < 30) probabilityMod *= 0.5;\n\n      // Night depth increases probability\n      const nightDepth = phase === GamePhase.DANGER ? 1.5 : 1;\n      probabilityMod *= nightDepth;\n\n      // Day progression increases probability\n      const dayProgress = Math.min(day / 15, 2);\n      probabilityMod *= dayProgress;\n\n      const roll = Math.random();\n      if (roll < def.baseProbability * probabilityMod) {\n        this.triggerEvent(def);\n      }\n    }\n  }\n\n  private triggerEvent(def: HorrorEventDef): void {\n    const id = `horror_${++this.eventCounter}_${Date.now()}`;\n    const event: HorrorEventInstance = {\n      id,\n      type: def.type,\n      level: def.level,\n      state: HorrorEventState.BUILDUP,\n      timer: 0,\n      duration: def.minActiveDuration + Math.random() * (def.maxActiveDuration - def.minActiveDuration),\n      buildupDuration: def.buildupDuration,\n      resolveDuration: def.resolveDuration,\n      data: {},\n      sanityCost: def.sanityCost,\n    };\n\n    // Randomize specific data\n    event.data = this.generateEventData(def);\n\n    this.activeEvents.push(event);\n    this.cooldowns.set(def.type, def.cooldownSec);\n\n    if (def.level >= HorrorLevel.THREAT) {\n      this.visual.recentHighFearCount++;\n    }\n\n    this.onEventTrigger?.(event);\n    this.onNotification?.(`⚠ ${def.description}`);\n  }\n\n  private generateEventData(def: HorrorEventDef): Record<string, unknown> {\n    switch (def.type) {\n      case HorrorEventType.SHELF_SHIFT:\n        return { shelfIndex: Math.floor(Math.random() * 5) };\n      case HorrorEventType.LIGHT_FLICKER:\n        return { lightIndex: Math.floor(Math.random() * 8) };\n      case HorrorEventType.REGISTER_ANOMALY:\n        return { registerIndex: Math.floor(Math.random() * 2), anomalyAmount: Math.floor(Math.random() * 9999) };\n      case HorrorEventType.BLOOD_ON_SHELF: {\n        const positions = [];\n        const count = 2 + Math.floor(Math.random() * 4);\n        for (let i = 0; i < count; i++) {\n          positions.push({\n            x: 100 + Math.random() * 600,\n            y: 100 + Math.random() * 400,\n            size: 8 + Math.random() * 20,\n            alpha: 0.3 + Math.random() * 0.5,\n          });\n        }\n        return { positions };\n      }\n      case HorrorEventType.GHOST_CUSTOMER:\n        return { startX: Math.random() * 400 + 100, startY: 50, opacity: 0 };\n      case HorrorEventType.DUPLICATE_CUSTOMER:\n        return { x1: 200 + Math.random() * 200, x2: 400 + Math.random() * 200, y: 200 + Math.random() * 100 };\n      case HorrorEventType.NONPAYING_CUSTOMER:\n        return { x: 300 + Math.random() * 200, y: 150 + Math.random() * 100 };\n      case HorrorEventType.DOOR_AUTO_OPEN:\n        return { door: Math.random() < 0.5 ? 'front' : 'back' };\n      default:\n        return {};\n    }\n  }\n\n  private updateActiveEvents(dt: number): void {\n    const completed: string[] = [];\n\n    for (const event of this.activeEvents) {\n      event.timer += dt;\n\n      switch (event.state) {\n        case HorrorEventState.BUILDUP:\n          this.applyBuildupEffect(event, event.timer / event.buildupDuration);\n          if (event.timer >= event.buildupDuration) {\n            event.state = HorrorEventState.ACTIVE;\n            event.timer = 0;\n            this.applyActiveEffect(event);\n            this.onSanityChange?.(-event.sanityCost);\n            this.dayAccumulatedSanityCost += event.sanityCost;\n          }\n          break;\n\n        case HorrorEventState.ACTIVE:\n          this.sustainActiveEffect(event, event.timer / event.duration);\n          if (event.timer >= event.duration) {\n            event.state = HorrorEventState.RESOLVING;\n            event.timer = 0;\n            this.beginResolve(event);\n          }\n          break;\n\n        case HorrorEventState.RESOLVING:\n          this.applyResolveEffect(event, event.timer / event.resolveDuration);\n          if (event.timer >= event.resolveDuration) {\n            event.state = HorrorEventState.COMPLETE;\n            completed.push(event.id);\n            this.clearEventEffects(event);\n          }\n          break;\n      }\n    }\n\n    for (const id of completed) {\n      this.activeEvents = this.activeEvents.filter(e => e.id !== id);\n    }\n  }\n\n  // --- Buildup Effects (预兆) ---\n\n  private applyBuildupEffect(event: HorrorEventInstance, progress: number): void {\n    const p = Math.min(1, progress);\n    switch (event.type) {\n      case HorrorEventType.LIGHT_FLICKER:\n        this.visual.flickeringLightIndex = (event.data.lightIndex as number) ?? 0;\n        this.visual.flickerIntensity = p * 0.3;\n        break;\n      case HorrorEventType.TEMP_DROP:\n        this.visual.frostIntensity = p * 0.2;\n        break;\n      case HorrorEventType.BLOOD_ON_SHELF:\n        this.visual.darknessBoost = p * 0.1;\n        break;\n      case HorrorEventType.WHISPER:\n        this.visual.whisperActive = true;\n        break;\n      case HorrorEventType.GHOST_CUSTOMER:\n      case HorrorEventType.DUPLICATE_CUSTOMER:\n      case HorrorEventType.NONPAYING_CUSTOMER:\n        this.visual.vignetteIntensity = Math.min(1, 0.3 + p * 0.3);\n        break;\n      case HorrorEventType.DOOR_AUTO_OPEN:\n        this.visual.screenShake = p * 0.3;\n        break;\n      case HorrorEventType.STORE_MUTATE:\n        this.visual.chromaticAberration = p * 0.3;\n        break;\n      default:\n        this.visual.darknessBoost = p * 0.05;\n        break;\n    }\n  }\n\n  // --- Active Effects ---\n\n  private applyActiveEffect(event: HorrorEventInstance): void {\n    switch (event.type) {\n      case HorrorEventType.LIGHT_FLICKER:\n        this.visual.flickerIntensity = 0.8;\n        break;\n      case HorrorEventType.TEMP_DROP:\n        this.visual.frostIntensity = 0.6;\n        this.visual.vignetteIntensity = 0.7;\n        break;\n      case HorrorEventType.FRIDGE_NOISE:\n        this.visual.screenShake = 0.5;\n        break;\n      case HorrorEventType.BLOOD_ON_SHELF:\n        this.visual.bloodPositions = (event.data.positions as Array<{ x: number; y: number; size: number; alpha: number }>) ?? [];\n        break;\n      case HorrorEventType.GHOST_CUSTOMER:\n        this.visual.ghostEntity = {\n          active: true,\n          x: (event.data.startX as number) ?? 300,\n          y: (event.data.startY as number) ?? 50,\n          opacity: 0.4,\n          type: 'ghost_customer',\n        };\n        break;\n      case HorrorEventType.DUPLICATE_CUSTOMER:\n        this.visual.ghostEntity = {\n          active: true,\n          x: (event.data.x1 as number) ?? 200,\n          y: (event.data.y as number) ?? 200,\n          opacity: 0.8,\n          type: 'duplicate',\n        };\n        break;\n      case HorrorEventType.NONPAYING_CUSTOMER:\n        this.visual.ghostEntity = {\n          active: true,\n          x: (event.data.x as number) ?? 300,\n          y: (event.data.y as number) ?? 150,\n          opacity: 0.9,\n          type: 'nonpaying',\n        };\n        break;\n      case HorrorEventType.DOOR_AUTO_OPEN:\n        if ((event.data.door as string) === 'front') {\n          this.visual.doorState.frontOpen = true;\n        } else {\n          this.visual.doorState.backOpen = true;\n        }\n        this.visual.darknessBoost = 0.3;\n        this.visual.screenShake = 0.8;\n        break;\n      case HorrorEventType.WHISPER:\n        this.visual.whisperActive = true;\n        this.visual.vignetteIntensity = 0.8;\n        break;\n      case HorrorEventType.STORE_MUTATE:\n        this.visual.storeMutateOffset = { x: (Math.random() - 0.5) * 10, y: (Math.random() - 0.5) * 10 };\n        this.visual.chromaticAberration = 0.8;\n        this.visual.screenShake = 0.4;\n        break;\n      case HorrorEventType.TIME_GLITCH:\n        this.visual.timeGlitchActive = true;\n        this.visual.chromaticAberration = 0.6;\n        break;\n      default:\n        this.visual.darknessBoost = 0.15;\n        break;\n    }\n  }\n\n  private sustainActiveEffect(event: HorrorEventInstance, progress: number): void {\n    // Pulsing effects during sustain\n    const pulse = Math.sin(progress * Math.PI * 4) * 0.5 + 0.5;\n\n    switch (event.type) {\n      case HorrorEventType.LIGHT_FLICKER:\n        this.visual.flickerIntensity = 0.4 + pulse * 0.5;\n        break;\n      case HorrorEventType.FRIDGE_NOISE:\n        this.visual.screenShake = 0.2 + pulse * 0.3;\n        break;\n      case HorrorEventType.GHOST_CUSTOMER:\n        if (this.visual.ghostEntity) {\n          this.visual.ghostEntity.opacity = 0.2 + pulse * 0.4;\n          this.visual.ghostEntity.y += 0.1;\n        }\n        break;\n      case HorrorEventType.STORE_MUTATE: {\n        const t = performance.now() * 0.001;\n        this.visual.storeMutateOffset = {\n          x: Math.sin(t * 0.5) * 8,\n          y: Math.cos(t * 0.7) * 5,\n        };\n        break;\n      }\n      case HorrorEventType.TIME_GLITCH:\n        this.visual.chromaticAberration = 0.3 + pulse * 0.5;\n        break;\n      default:\n        break;\n    }\n  }\n\n  // --- Resolve Effects ---\n\n  private beginResolve(event: HorrorEventInstance): void {\n    switch (event.type) {\n      case HorrorEventType.FRIDGE_NOISE:\n        // Sudden silence is scarier\n        this.visual.screenShake = 0;\n        break;\n      default:\n        break;\n    }\n  }\n\n  private applyResolveEffect(event: HorrorEventInstance, progress: number): void {\n    const p = Math.min(1, progress);\n    switch (event.type) {\n      case HorrorEventType.TEMP_DROP:\n        this.visual.frostIntensity *= (1 - p);\n        break;\n      case HorrorEventType.LIGHT_FLICKER:\n        this.visual.flickerIntensity *= (1 - p);\n        if (p >= 1) this.visual.flickeringLightIndex = -1;\n        break;\n      case HorrorEventType.BLOOD_ON_SHELF:\n        this.visual.bloodPositions = this.visual.bloodPositions.map(b => ({\n          ...b, alpha: b.alpha * (1 - p),\n        }));\n        break;\n      case HorrorEventType.GHOST_CUSTOMER:\n      case HorrorEventType.DUPLICATE_CUSTOMER:\n      case HorrorEventType.NONPAYING_CUSTOMER:\n        if (this.visual.ghostEntity) {\n          this.visual.ghostEntity.opacity *= (1 - p);\n        }\n        break;\n      case HorrorEventType.DOOR_AUTO_OPEN:\n        this.visual.doorState.frontOpen = false;\n        this.visual.doorState.backOpen = false;\n        this.visual.darknessBoost *= (1 - p);\n        break;\n      case HorrorEventType.STORE_MUTATE:\n        this.visual.storeMutateOffset.x *= (1 - p);\n        this.visual.storeMutateOffset.y *= (1 - p);\n        this.visual.chromaticAberration *= (1 - p);\n        break;\n      case HorrorEventType.TIME_GLITCH:\n        if (p >= 0.8) this.visual.timeGlitchActive = false;\n        this.visual.chromaticAberration *= (1 - p);\n        break;\n      default:\n        break;\n    }\n  }\n\n  private clearEventEffects(event: HorrorEventInstance): void {\n    switch (event.type) {\n      case HorrorEventType.GHOST_CUSTOMER:\n      case HorrorEventType.DUPLICATE_CUSTOMER:\n      case HorrorEventType.NONPAYING_CUSTOMER:\n        this.visual.ghostEntity = null;\n        break;\n      case HorrorEventType.BLOOD_ON_SHELF:\n        this.visual.bloodPositions = [];\n        break;\n      case HorrorEventType.WHISPER:\n        this.visual.whisperActive = false;\n        break;\n      case HorrorEventType.TIME_GLITCH:\n        this.visual.timeGlitchActive = false;\n        break;\n      default:\n        break;\n    }\n  }\n\n  private decayVisuals(dtSec: number): void {\n    const decay = dtSec * 0.5;\n    this.visual.screenShake = Math.max(0, this.visual.screenShake - decay);\n    this.visual.darknessBoost = Math.max(0, this.visual.darknessBoost - decay * 0.1);\n    if (this.visual.flickeringLightIndex === -1) {\n      this.visual.flickerIntensity = Math.max(0, this.visual.flickerIntensity - decay * 0.2);\n    }\n  }\n\n  private updateAmbientFear(day: number, phase: GamePhase, timeOfDay: number): void {\n    let target = 0;\n\n    if (isNightTime(phase)) {\n      target = 0.3;\n      if (phase === GamePhase.NIGHT) target = 0.5;\n      if (phase === GamePhase.DANGER) target = 0.8;\n\n      // Day progression\n      target *= Math.min(1 + (day - 1) * 0.05, 2);\n\n      // Active events boost fear\n      target += this.activeEvents.length * 0.1;\n    }\n\n    this.visual.ambientFear += (target - this.visual.ambientFear) * 0.02;\n  }\n\n  // --- Public API ---\n\n  /** Reset daily state when new day begins */\n  resetDaily(): void {\n    this.dayAccumulatedSanityCost = 0;\n    this.visual.recentHighFearCount = 0;\n    this.activeEvents = [];\n    this.visual = createDefaultVisualState();\n  }\n\n  /** Get the maximum event level available for current day */\n  getMaxLevel(day: number): HorrorLevel {\n    if (day >= 26) return HorrorLevel.EXISTENTIAL;\n    if (day >= 16) return HorrorLevel.THREAT;\n    if (day >= 6) return HorrorLevel.ENTITY;\n    return HorrorLevel.ENVIRONMENT;\n  }\n\n  /** Get active events for display */\n  getActiveEvents(): ReadonlyArray<HorrorEventInstance> {\n    return this.activeEvents;\n  }\n\n  /** Get save data */\n  getSaveData(): Record<string, unknown> {\n    return {\n      eventCounter: this.eventCounter,\n      dayAccumulatedSanityCost: this.dayAccumulatedSanityCost,\n    };\n  }\n\n  /** Load save data */\n  loadSaveData(data: Record<string, unknown>): void {\n    this.eventCounter = (data.eventCounter as number) ?? 0;\n    this.dayAccumulatedSanityCost = (data.dayAccumulatedSanityCost as number) ?? 0;\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
