dStart":1,"oldLines":6,"newStart":1,"newLines":6,"lines":[" {","   \"name\": \"midnight-store\",","-  \"version\": \"0.6.0\",","+  \"version\": \"1.0.0\",","   \"description\": \"深夜便利店 — Midnight Store (Horror Simulation Management)\",","   \"main\": \"dist/main/main.js\",","   \"scripts\": {"]},{"oldStart":13,"oldLines":6,"newStart":13,"newLines":28,"lines":["     \"test\": \"vitest\",","     \"typecheck\": \"tsc --noEmit\"","   },","+  \"build\": {","+    \"appId\": \"com.midnightstore.game\",","+    \"productName\": \"深夜便利店 — Midnight Store\",","+    \"directories\": {","+      \"output\": \"release\"","+    },","+    \"files\": [","+      \"dist/**/*\",","+      \"src/data/**/*\"","+    ],","+    \"win\": {","+      \"target\": [\"nsis\"],","+      \"icon\": \"assets/icon.ico\"","+    },","+    \"nsis\": {","+      \"oneClick\": false,","+      \"allowToChangeInstallationDirectory\": true,","+      \"createDesktopShortcut\": true,","+      \"createStartMenuShortcut\": true,","+      \"shortcutName\": \"深夜便利店\"","+    }","+  },","   \"dependencies\": {},","   \"devDependencies\": {","     \"typescript\": \"^5.4.0\","]}],"userModified":false,"replaceAll":false}}
